{
  "name": "hacecuentas",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "og": "node --experimental-strip-types scripts/generate-og-images.ts",
    "related": "node --experimental-strip-types scripts/compute-related.ts",
    "embeddings": "node --experimental-strip-types scripts/build-calc-embeddings.ts",
    "validate:data": "node --experimental-strip-types scripts/validate-data-updates.ts",
    "lint:calcs": "node scripts/lint-calc-quality.mjs",
    "lint:calcs:gate": "node scripts/lint-calc-quality.mjs --gate",
    "validate:freshness": "node --experimental-strip-types scripts/check-stale-data.ts --strict --threshold=20",
    "validate:sanity": "node --experimental-strip-types scripts/validate-data-sanity.ts",
    "validate:sources": "node --experimental-strip-types scripts/lint-source-urls.ts",
    "new-calc": "node --experimental-strip-types scripts/new-calc.ts",
    "seo:audit": "node --experimental-strip-types scripts/seo-audit.ts",
    "seo:render-check": "node --experimental-strip-types scripts/seo-render-check.ts",
    "seo:structured-data": "node --experimental-strip-types scripts/seo-structured-data.ts",
    "audit:ymyl": "node --experimental-strip-types scripts/audit-ymyl-risk.ts",
    "audit:ymyl:check": "node --experimental-strip-types scripts/audit-ymyl-risk.ts --check",
    "audit:sitemap": "node scripts/audit-sitemap-coverage.mjs",
    "audit:sitemap:check": "node scripts/audit-sitemap-coverage.mjs --check",
    "audit:links": "node --experimental-strip-types scripts/audit-restricted-links.ts",
    "audit:links:check": "node --experimental-strip-types scripts/audit-restricted-links.ts --check",
    "audit:cannibalization": "node --experimental-strip-types scripts/audit-cannibalization.ts",
    "sitemap": "node --experimental-strip-types scripts/generate-sitemap.ts",
    "ics": "node --experimental-strip-types scripts/generate-ics.ts",
    "page-feed": "node --experimental-strip-types scripts/generate-page-feed.ts",
    "bump-lastmod": "node --experimental-strip-types scripts/bump-lastmod.ts",
    "llms-full": "python3 scripts/generate-llms-full.py",
    "refresh-popular": "python3 scripts/refresh-home-popular.py",
    "bcra:update-icl": "node scripts/update-icl.mjs",
    "og-manifest": "node --experimental-strip-types scripts/generate-og-manifest.ts",
    "stamp-sw": "node --experimental-strip-types scripts/stamp-sw.ts",
    "cf:purge": "bash scripts/cf-purge-cache.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "node --experimental-strip-types scripts/prebuild.ts",
    "build": "bash scripts/build-guard.sh",
    "build:raw": "NODE_OPTIONS=--max-old-space-size=8192 astro build && node scripts/optimize-css-loading.mjs && node scripts/strip-pruned-html.mjs && node scripts/strip-html-comments.mjs && node scripts/generate-worker-wrapper.mjs && node scripts/amp-clean-historias.mjs",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "bash scripts/deploy-local.sh",
    "deploy:ci": "npm run build && wrangler deploy",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "audit:adsense": "node --experimental-strip-types scripts/audit-adsense.ts",
    "audit:adsense:gate": "node --experimental-strip-types scripts/audit-adsense.ts --gate"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.10",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@sentry/astro": "^10.50.0",
    "astro": "^6.1.6",
    "astro-compressor": "^1.3.0",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.83.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
