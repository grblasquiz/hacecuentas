  Cache-Control: public, max-age=2592000
/logo-64.png
  ! Cache-Control
  Cache-Control: public, max-age=2592000
/logo-128.png
  ! Cache-Control
  Cache-Control: public, max-age=2592000
/logo-512.png
  ! Cache-Control
