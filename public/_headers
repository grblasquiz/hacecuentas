# OG images (regeneradas con build, no cambian día a día): 30 días
/og/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

# Imágenes en /img/ o similar: cachear 1 semana
/img/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

# Sitemap y RSS: usan el cache-control global (max-age=0, must-revalidate).
# Reglas específicas eliminadas porque CF Pages CONCATENA headers entre /* y
# las reglas específicas → el header en prod queda con valores duplicados
# y en el caso de rss.xml el segundo max-age=3600 ganaba, violando la regla
# "no cache>0 para archivos que cambian con deploys".

# robots.txt y ads.txt: cachear 1 día
/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400
/ads.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Plugin de WordPress (.zip): descarga directa + carga automática en WordPress
# Playground (fetch cross-origin desde el navegador), que necesita CORS.
/hacecuentas-calculadoras.zip
  ! Cache-Control
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# Google Ads page feed (Búsqueda Dinámica / DSA): CSV con todas las URLs del
# sitio para que Google Ads las use como landing pages. NO debe indexarse en
# Google Search → X-Robots-Tag: noindex. Además no está en ningún sitemap ni
# linkeado, así que el header es defensa adicional (no se bloquea en robots.txt
# para que Google Ads lo pueda descargar vía fetch programado).
/google-page-feed.csv
  ! Cache-Control
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex
  Content-Type: text/csv; charset=utf-8

# Índices livianos para agentes/IA y para el fetch client-side del 404.
# 1h en browser (el contenido solo cambia con deploy; el etag revalida después).
# El edge de CF sigue heredando CDN-Cache-Control: no-store de /* → no hay
# riesgo de servir versión vieja post-deploy.
/api/calcs-slim.json
  ! Cache-Control
  Cache-Control: public, max-age=3600
  # CORS: data pública read-only. La necesita el editor del plugin de WordPress
  # (selector de calcs en el bloque Gutenberg, fetch cross-origin desde wp-admin).
  Access-Control-Allow-Origin: *
/api/calcs-top.json
  ! Cache-Control
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
/api/calcs-index.json
  ! Cache-Control
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

# Página offline: cacheable a largo plazo
/offline.html
  ! Cache-Control
  Cache-Control: public, max-age=3600

# Search-index: SWR edge — 10 min fresh + 24h stale-while-revalidate.
# El JSON se invalida en cada deploy via CF Pages purge automático;
# entre deploys el SWR sirve la versión vieja al instante mientras
# revalida en background, evitando que el modal de búsqueda se sienta lento.
# IMPORTANTE: usar ! para borrar el Cache-Control + CDN-Cache-Control heredados.
/search-index.json
  ! Cache-Control
  ! CDN-Cache-Control
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=600, stale-while-revalidate=86400

# Embed widget: HABILITAR cross-origin iframes para que /embed/* se pueda
# poner en blogs, medios, fintech (plugin WP, /embeber, oEmbed).
# CLAVE: CF Pages CONCATENA los headers de /* y /embed/*, así que el navegador
# recibe DOS Content-Security-Policy y aplica la INTERSECCIÓN → el
# `frame-ancestors 'self'` del CSP global GANABA sobre `frame-ancestors *` y
# bloqueaba el iframe en cualquier dominio externo (Playground, blogs, etc.).
# Fix: BORRAR el CSP y XFO heredados con `!` (igual que /search-index.json borra
# Cache-Control) y recién setear el del embed. Sin el `!` el widget NO carga
# cross-origin — el caso de uso entero del plugin/oEmbed depende de esto.
/embed/*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://dolarapi.com https://api.argentinadatos.com https://region1.google-analytics.com https://open.er-api.com https://api.coingecko.com; frame-ancestors *
  # CORP/COOP override para /embed/*: aplicado en src/middleware.ts (ver arriba).
