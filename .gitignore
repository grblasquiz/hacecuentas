# build output
dist/

# OG images derivadas (regeneradas en prebuild — idempotente)
public/og/*.webp
public/og/*.avif
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# claude code preview config
.claude/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
scripts/.indexing-api-state.json
scripts/__pycache__/
scripts/.backfill-faqs/
scripts/.helps-backfill/
scripts/.tables-backfill/

# Bing performance monitoring + auditorías locales (output de scripts, no se commitea)
/data/

# Daily audit cache (los .md sí se commitean, el cache no)
audits/.cache/
.last-deploy-sha

# YouTube pipeline: artefactos pesados que NO deben servirse como assets web
# (el .zip de 38MB supera el límite de 25MiB de Cloudflare y rompe el deploy)
public/yt-videos/*.zip
yt-artifacts/
.worker-cache/
dist-static/
