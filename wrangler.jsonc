{
	// IMPORTANTE: el deploy en GH Actions usa `dist/server/wrangler.json`
	// (ver .github/workflows/deploy.yml — `--config dist/server/wrangler.json`).
	// Ese config lo genera @astrojs/cloudflare en cada build con los bindings
	// correctos (entrypoint, assets, KV SESSION, D1 DB, etc.).
	//
	// ESTE wrangler.jsonc root es solo fuente de verdad para que el adapter
	// sepa qué bindings incluir al generar el server config. Los únicos campos
	// relevantes acá son los bindings (D1, KV custom, env vars, secrets).
	"compatibility_date": "2026-04-18",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "hacecuentas",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Forzar al Worker (middleware) a correr ANTES que static assets.
		// Sin esto, CF sirve dist/client/foo.html directo y el middleware nunca
		// corre — necesario para:
		//   1) trailing slash 307→308 (sino CF intercepta antes del Worker)
		//   2) gone-410 URLs (si el HTML existe, no se devuelve 410)
		//   3) www→apex 410 sitemaps
		// El overhead es minimo: el middleware solo hace lookups en Maps O(1)
		// antes de delegar a ASSETS via next(). Verificado 2026-05-20.
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	// Worker Route para 410 Gone del sitemap del subdomain `www` se configura
	// MANUALMENTE en CF Dashboard (no acá), porque el API token no tiene
	// permisos sobre la zona `www.hacecuentas.com` (zona separada del apex).
	//
	// Setup manual:
	//   CF Dashboard → www.hacecuentas.com → Workers Routes
	//   Add: pattern = `www.hacecuentas.com/sitemap*`  → Worker = `hacecuentas`
	//
	// El middleware en `src/middleware.ts` devuelve 410 cuando esos requests
	// llegan al Worker. Sin la route, el Edge de CF redirige 301 al apex
	// antes que el Worker los vea.
	// D1 database para formularios (newsletter, votes, error reports).
	// Setup inicial (una vez):
	//   1. npx wrangler d1 create hacecuentas-forms
	//   2. Pegar database_id que te da el output en el campo de abajo
	//   3. npx wrangler d1 execute hacecuentas-forms --remote --file=db/schema.sql
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hacecuentas-forms",
			"database_id": "73216cf9-dba3-4c16-875c-4073d8184bcd"
		}
	],
	// Cloudflare Email Sending — manda el código OTP de login (Mi Hacé Cuentas).
	// Mismo mecanismo que el newsletter (workers/mailing-cron). El dominio
	// hacecuentas.com ya está onboardeado en Email > Email Sending. En `astro
	// dev` el binding no existe → request-code cae al fallback con devCode.
	"send_email": [
		{ "name": "EMAIL" }
	],
	// Google Sign-In (Google Identity Services, flujo de ID token). El Client ID
	// es PÚBLICO (va embebido en el cliente) — por eso vive acá como var y no
	// como secret. Sin client secret: el ID token se verifica contra el JWKS de
	// Google. Si queda vacío, /mi-hacecuentas no muestra el botón de Google.
	//
	// Setup (una vez, Martin):
	//   1. Google Cloud Console → APIs & Services → Credentials
	//   2. Create credentials → OAuth client ID → Web application
	//   3. Authorized JavaScript origins: https://hacecuentas.com
	//      (para dev: http://localhost:4321)
	//   4. Pegar el "Client ID" (termina en .apps.googleusercontent.com) abajo.
	"vars": {
		"GOOGLE_CLIENT_ID": "485989896682-esgtatvfcnbbu83emnhqspjvu6abfqv0.apps.googleusercontent.com"
	}
}