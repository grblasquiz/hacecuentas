---
// @incremental-standalone — landing NBA aislada; habilita deploy incremental.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SportsLiveNav from '../components/SportsLiveNav.astro';
import data from '../data/live/nba.json';
import weekClient from '../scripts/nba-week-client.js?raw';
import { eventTicketOffer } from '../lib/offer-schema';

const AR = 'America/Argentina/Buenos_Aires';
const fmtDay = (iso: string) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(iso));
const fmtShortDay = (iso: string) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, weekday: 'short', day: 'numeric' }).format(new Date(iso)).replace('.', '');
const fmtTime = (iso: string) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(iso));
const games = [...(data.games || [])].sort((a: any, b: any) => new Date(a.date).getTime() - new Date(b.date).getTime());
const dateKey = (value: string | Date) => new Intl.DateTimeFormat('en-CA', { timeZone: AR, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(value));
const now = new Date();
const todayKey = dateKey(now);
const featured = games.find((g: any) => g.state === 'pre' && new Date(g.date) >= now) || [...games].reverse().find((g: any) => g.state === 'post');
const upcoming = games.filter((g: any) => g.state === 'pre' && new Date(g.date) >= now).slice(0, 3);
const weekStart = data.weekStart || todayKey;
const weekEnd = data.weekEnd || todayKey;
const weekDates = Array.from({ length: 7 }, (_, index) => { const value = new Date(`${weekStart}T12:00:00Z`); value.setUTCDate(value.getUTCDate() + index); return value.toISOString().slice(0, 10); });
const activeDay = weekDates.includes(todayKey) ? todayKey : weekDates.find((key) => games.some((game: any) => dateKey(game.date) === key)) || weekDates[0];
const weekLabel = `${new Intl.DateTimeFormat('es-AR', { timeZone: AR, day: 'numeric', month: 'short' }).format(new Date(`${weekStart}T12:00:00Z`))} — ${new Intl.DateTimeFormat('es-AR', { timeZone: AR, day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(`${weekEnd}T12:00:00Z`))}`;
const relativeGameDay = (iso: string) => dateKey(iso) === todayKey ? 'Hoy' : fmtShortDay(iso);
const conferenceTable = (conference: 'East' | 'West') => (data.standings || [])
  .filter((team: any) => String(team.conference).startsWith(conference))
  .sort((a: any, b: any) => Number(a.rank) - Number(b.rank))
  .slice(0, 10);
const eastStandings = conferenceTable('East');
const westStandings = conferenceTable('West');
const leaders = data.leaders || [];
const fetchedLabel = data.fetchedAt ? new Intl.DateTimeFormat('es-AR', { timeZone: AR, day:'numeric', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' }).format(new Date(data.fetchedAt)) : 'hoy';
const weekSnapshot = JSON.stringify({ weekStart, weekEnd, games }).replaceAll('<', '\\u003c');
const gameName=(game:any)=>`${game.away.name} - ${game.home.name}`;
const gameFragment=(game:any)=>`partido-${gameName(game).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')}-${game.id}`;
// ── SEO ──────────────────────────────────────────────────────────────────────
const PAGE_URL = 'https://hacecuentas.com/nba-2026';
const title = 'NBA hoy: partidos, resultados, posiciones y calendario | Hacé Cuentas';
const description = 'Calendario semanal de la NBA, horarios, resultados finales y tabla de posiciones, actualizado automáticamente al terminar cada partido.';
const ogTitle = 'NBA esta semana: partidos, resultados y posiciones';
const keywords = ['nba hoy','partidos nba hoy','resultados nba','posiciones nba','tabla nba','calendario nba','nba 2026','nba en vivo','conferencia oeste nba','líderes nba'];
const newsKeywords = ['NBA','partidos NBA','resultados NBA','posiciones NBA','NBA hoy'];
const leadersLabel = leaders.length ? leaders.map((l: any) => `${l.name} en ${l.label} (${l.value})`).join(', ') : '';

const faqs = [
  {
    q: '¿Qué partidos de la NBA hay hoy?',
    a: 'En "Calendario de la semana" ves las siete fechas, de lunes a domingo, con horarios en Argentina. La agenda se renueva una vez por semana y los marcadores aparecen únicamente cuando ESPN confirma que el partido terminó.',
  },
  {
    q: '¿A qué hora se juegan los partidos de la NBA en Argentina y Latinoamérica?',
    a: 'Los horarios se muestran en hora de Argentina (GMT-3). Como la mayoría de los partidos se juegan de noche en Estados Unidos, en Sudamérica suelen caer entre la noche y la madrugada. Fijate el horario exacto de cada cruce en el calendario y la lista de próximos partidos.',
  },
  {
    q: '¿Cómo funcionan las posiciones y las conferencias en la NBA?',
    a: 'La NBA tiene 30 equipos divididos en dos conferencias de 15: Este (East) y Oeste (West). Cada equipo juega 82 partidos en la temporada regular. Los 6 mejores de cada conferencia clasifican directo a playoffs; los que terminan del 7.º al 10.º disputan el play-in por los dos lugares restantes. Arriba mostramos la tabla del Oeste; con "Tabla completa" ves las dos conferencias.',
  },
  {
    q: '¿Qué jugadores lideran la temporada de la NBA?',
    a: leadersLabel
      ? `Según las estadísticas más recientes, los líderes de la temporada son ${leadersLabel}. El módulo "Líderes de la temporada" se actualiza junto con el resto de los datos.`
      : 'En el módulo "Líderes de la temporada" mostramos a los jugadores que encabezan puntos, rebotes y asistencias, actualizados con las estadísticas más recientes.',
  },
  {
    q: '¿Cuándo empieza la temporada 2026-27 de la NBA?',
    a: 'La temporada regular de la NBA suele arrancar a mediados de octubre y terminar en abril; después vienen el play-in, los playoffs y las Finales en junio. Durante el verano boreal (julio) se juega la Summer League en Las Vegas, donde debutan rookies y jóvenes promesas.',
  },
  {
    q: '¿Qué es la Summer League de la NBA?',
    a: 'La Summer League es un torneo de pretemporada que se juega en julio, sobre todo en Las Vegas. Ahí los equipos prueban a los novatos elegidos en el draft y a jugadores jóvenes. No cuenta para la temporada regular, pero es la primera vista oficial de las promesas del año.',
  },
  {
    q: '¿De dónde salen los datos y cada cuánto se actualizan?',
    a: 'Los partidos, las posiciones y los líderes vienen de ESPN. La agenda se consulta una vez al comenzar cada semana. No mostramos marcadores parciales: cada resultado se consulta recién después del horario estimado de finalización y aparece cuando ESPN lo confirma como final.',
  },
];

const breadcrumb = {
  '@type':'BreadcrumbList',
  itemListElement: [
    { '@type':'ListItem', position:1, name:'Inicio', item:'https://hacecuentas.com/' },
    { '@type':'ListItem', position:2, name:'Deportes', item:'https://hacecuentas.com/deportes' },
    { '@type':'ListItem', position:3, name:'NBA 2026', item:PAGE_URL },
  ],
};
// performer = los 30 equipos reales (de standings, no hardcodeados); image +
// offers para que el nodo SportsEvent no quede sin los campos recomendados que
// Search Console marca en el resto de las páginas de deportes.
const nbaPerformers = (data.standings || []).map((t: any) => ({ '@type':'SportsTeam', name:t.team }));
const sportsEvent = {
  '@type':'SportsEvent',
  name:'Temporada de la NBA 2025-26',
  sport:'Basketball',
  description:'Partidos, resultados, calendario y posiciones de la NBA (National Basketball Association), con las conferencias Este y Oeste y los líderes estadísticos de la temporada.',
  startDate:'2025-10-21', endDate:'2026-06-21',
  eventStatus:'https://schema.org/EventScheduled',
  image:['https://hacecuentas.com/og-default.png'],
  organizer:{ '@type':'Organization', name:'NBA', url:'https://www.nba.com' },
  location:{ '@type':'Place', name:'Estados Unidos y Canadá', address:{ '@type':'PostalAddress', addressCountry:'US' } },
  performer:nbaPerformers,
  offers:eventTicketOffer({ url:'https://www.nba.com/tickets' }),
  url:PAGE_URL,
};
const dataset = {
  '@type':'Dataset',
  name:'NBA: resultados, calendario y posiciones',
  description:'Resultados en vivo, calendario, tabla de posiciones (Este y Oeste) y líderes de la temporada de la NBA, actualizados automáticamente.',
  license:'https://creativecommons.org/licenses/by/4.0/',
  creator:{ '@type':'Organization', name:'Hacé Cuentas', url:'https://hacecuentas.com' },
  isBasedOn:'https://www.espn.com/nba/',
  dateModified:data.fetchedAt,
  url:PAGE_URL,
};
const faqSchema = {
  '@type':'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a } })),
};
const gameEvents={'@type':'ItemList',name:'Partidos de la NBA',itemListElement:games.map((game:any,index:number)=>({'@type':'ListItem',position:index+1,item:{'@type':'SportsEvent',name:gameName(game),startDate:game.date,eventStatus:game.state==='post'?'https://schema.org/EventCompleted':'https://schema.org/EventScheduled',homeTeam:{'@type':'SportsTeam',name:game.home.name},awayTeam:{'@type':'SportsTeam',name:game.away.name},url:`${PAGE_URL}#${gameFragment(game)}`}}))};
const schema = { '@context':'https://schema.org', '@graph':[breadcrumb, sportsEvent, gameEvents, dataset, faqSchema] };
---
<Layout title={title} description={description} canonical="/nba-2026" audience="AR" domain="life" pageType="data" schema={schema} keywords={keywords} newsKeywords={newsKeywords} ogTitle={ogTitle} noAds={true}>
  <Header slot="header" />
  <SportsLiveNav />
  <main class="nba" data-nba data-week-start={weekStart} data-week-end={weekEnd} data-api="/api/nba.json?kind=scoreboard" data-summer-api="/api/nba.json?kind=summer" data-standings-api="/api/nba.json?kind=standings">
    <nav class="nba-crumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/deportes">Deportes</a><span>/</span><strong>NBA</strong></nav>
    <nav class="nba-nav" aria-label="Navegación NBA">
      <a class="brand" href="/nba-2026" aria-label="NBA Hoy, inicio"><svg aria-hidden="true" viewBox="0 0 36 36"><circle cx="18" cy="18" r="17" fill="currentColor"/><path d="M2 18h32M18 1c-7 7-7 27 0 34M18 1c7 7 7 27 0 34M5 8c8 3 18 3 26 0M5 28c8-3 18-3 26 0" fill="none" stroke="#07111d" stroke-width="1.8"/></svg> NBA HOY</a>
      <div class="nav-links"><a class="active" href="#partidos">Partidos</a><a href="#calendario">Calendario</a><a href="#posiciones">Posiciones</a><a href="#noticias">Noticias</a><a href="/deportes">Deportes</a></div>
      <div class="nav-actions"><a class="nba-search" href="https://www.nba.com/search" target="_blank" rel="noopener" aria-label="Buscar en NBA"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg></a><a class="follow" href="#seguir-nba"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span>Seguir NBA</span></a></div>
    </nav>

    <section class="hero" id="partidos">
      <div><h1>NBA hoy: partidos, resultados<br/>y toda la temporada</h1><div class="chips"><span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 2v3M17 2v3M3 9h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"/></svg><b data-today>Hoy</b></span><span class="live-chip"><i></i><b data-status>SEMANA ACTUALIZADA</b></span></div></div>
    </section>

    <section class="top-grid" aria-label="Partidos destacados">
      <article class="game-hero" data-primary-game>
        {featured ? <>
          <h2 class="match-seo" id={gameFragment(featured)}>{gameName(featured)}</h2>
          <div class="game-tag"><span>{featured.state === 'post' ? 'ÚLTIMO RESULTADO' : 'PRÓXIMO PARTIDO'}</span><b>{featured.league || 'NBA'} · {featured.state === 'pre' ? `${relativeGameDay(featured.date)}, ${fmtTime(featured.date)}` : featured.detail || featured.status}</b></div>
          <div class="duel">
            <div class="team"><img src={featured.away.logo} alt="" loading="lazy"/><strong>{featured.away.name}</strong><em>{featured.state === 'pre' ? '—' : featured.away.score ?? '—'}</em></div>
            <div class="middle"><span>{fmtTime(featured.date)}</span><b>{featured.state === 'post' ? 'FINAL' : 'VS'}</b></div>
            <div class="team"><img src={featured.home.logo} alt="" loading="lazy"/><strong>{featured.home.name}</strong><em>{featured.state === 'pre' ? '—' : featured.home.score ?? '—'}</em></div>
          </div>
          <a class="orange-button" href={featured.href} target="_blank" rel="noopener">{featured.state === 'pre' ? 'Ver previa' : 'Ver resultado'} <b>›</b></a>
        </> : <div class="empty-game"><span>◒</span><h2>No hay partidos programados ahora</h2><p>El calendario y los resultados se actualizan automáticamente cuando vuelve la acción.</p><a class="orange-button" href="#calendario">Ver calendario</a></div>}
      </article>
      <aside class="next-card"><h2>Próximos partidos</h2><div data-upcoming>{upcoming.length ? upcoming.map((game: any) => <a href={game.href} target="_blank" rel="noopener" class="next-row"><b>{relativeGameDay(game.date)}<small>{fmtTime(game.date)}</small></b><span><img src={game.away.logo} alt=""/>{game.away.abbr} <small>vs</small> <img src={game.home.logo} alt=""/>{game.home.abbr}</span><i>›</i></a>) : <p class="muted">No quedan partidos programados esta semana.</p>}</div><a class="more" href="#calendario">Ver semana completa <b>›</b></a></aside>
    </section>

    <section class="section nba-now" aria-labelledby="nba-now-title"><span>NBA HOY · RESPUESTA RÁPIDA</span><h2 id="nba-now-title">{games.length ? `${games.length} partidos en la agenda semanal` : 'No hay partidos programados: la NBA está entre temporadas'}</h2><p>Acá encontrás el próximo partido apenas se publica, horarios en Argentina, resultados, líderes y las posiciones completas del <strong>Este y el Oeste</strong>. Última sincronización: <time datetime={data.fetchedAt}>{fetchedLabel}</time>.</p><nav><a href="#calendario">Partidos de hoy</a><a href="#posiciones">Posiciones NBA</a><a href="#nba-faq-title">Preguntas frecuentes</a><a href="https://www.nba.com/schedule" target="_blank" rel="noopener">Calendario oficial ↗</a></nav></section>

    <section class="section conference-grid" id="posiciones">{[['Conferencia Este',eastStandings],['Conferencia Oeste',westStandings]].map(([label,teams]:any)=><article class="standings"><header><h2>{label}</h2><a href="https://www.nba.com/standings" target="_blank" rel="noopener">Tabla completa ›</a></header><div class="table-head"><span>#</span><span>Equipo</span><span>P</span><span>G</span><span>PCT</span></div><div>{teams.map((team:any,i:number)=><a href={`https://www.nba.com/team/${team.abbr?.toLowerCase()}`} target="_blank" rel="noopener" class="standing"><b>{team.rank||i+1}</b><span><img src={team.logo} alt=""/>{team.team}</span><em>{Number(team.wins)+Number(team.losses)}</em><em>{team.wins}</em><em>{team.pct}</em></a>)}</div></article>)}</section>
    <section class="section leaders-wide"><article class="leaders"><header><h2>Líderes de la temporada NBA</h2><a href="https://www.nba.com/stats/leaders" target="_blank" rel="noopener">Estadísticas oficiales ›</a></header>{leaders.length ? <div class="leader-list">{leaders.map((leader:any) => <a class="leader-row" href="https://www.nba.com/stats/leaders" target="_blank" rel="noopener"><img src={leader.headshot} alt={leader.fullName}/><span><small>{leader.label}</small><strong>{leader.value}</strong></span><b>{leader.name}<em>{leader.team}</em></b><i>›</i></a>)}</div> : <div class="leaders-empty"><span>★</span><h3>Los líderes aparecerán acá</h3></div>}</article></section>

    <section class="section schedule" id="calendario"><header><div><h2>Calendario de la semana</h2><p data-date-label>{weekLabel}</p></div><a href="https://www.nba.com/2026-summer-league-vegas-schedule" target="_blank" rel="noopener">Calendario oficial <b>›</b></a></header><div class="week-calendar" data-schedule>
      <div class="week-tabs" role="tablist" aria-label="Fechas de la semana">
        {weekDates.map((key) => { const dayGames = games.filter((game: any) => dateKey(game.date) === key); return <button type="button" role="tab" aria-selected={key === activeDay ? 'true' : 'false'} class:list={{active:key === activeDay}} data-week-day={key}><small>{new Intl.DateTimeFormat('es-AR', { weekday:'short', timeZone:AR }).format(new Date(`${key}T12:00:00Z`)).replace('.', '')}</small><strong>{key.slice(-2)}</strong><em>{dayGames.length} {dayGames.length === 1 ? 'partido' : 'partidos'}</em></button>; })}
      </div>
      <div class="week-panels">
        {weekDates.map((key) => { const dayGames = games.filter((game: any) => dateKey(game.date) === key); return <section class="week-panel" data-week-panel={key} hidden={key !== activeDay}><header><h3>{fmtDay(`${key}T12:00:00Z`)}</h3><span>{dayGames.length} {dayGames.length === 1 ? 'partido' : 'partidos'}</span></header>{dayGames.length ? dayGames.map((game:any) => <article class="schedule-game" id={gameFragment(game)}><h3 class="match-seo">{gameName(game)}</h3><a href={game.href} target="_blank" rel="noopener" class="schedule-row"><span>{game.state === 'post' ? 'FINAL' : fmtTime(game.date)}<small>{game.league || 'NBA'} · {game.state === 'post' ? game.detail || 'Finalizado' : 'Programado'}</small></span><b><img src={game.away.logo} alt=""/>{game.away.name}</b><strong>{game.state === 'pre' ? <i>vs</i> : <>{game.away.score ?? '—'} <i>—</i> {game.home.score ?? '—'}</>}</strong><b><img src={game.home.logo} alt=""/>{game.home.name}</b><em>{game.state === 'pre' ? 'Ver previa' : 'Ver resultado'} ›</em></a></article>) : <div class="empty-schedule"><strong>Sin partidos en esta fecha.</strong><span>Elegí otro día de la semana.</span></div>}</section>; })}
      </div>
    </div></section>
    <section class="nba-network" aria-labelledby="nba-network-title"><header><div><span>SEGUÍ HACIENDO CUENTAS</span><h2 id="nba-network-title">Más deporte, sin salir de Hacé Cuentas</h2></div><p>Saltá a otra cobertura o usá una calculadora para llevar los números a tu propio entrenamiento.</p></header><div><a class="featured" href="/deportes"><small>PORTADA</small><strong>Mundial, NBA y F1</strong><span>Ver todos los deportes →</span></a><a href="/formula-1-2026"><small>FÓRMULA 1</small><strong>Próximo GP y campeonato</strong><span>Seguir la temporada →</span></a><a href="/mundial-2026"><small>MUNDIAL 2026</small><strong>Fixture, llave y resultados</strong><span>Entrar al Mundial →</span></a><a href="/calculadora-calorias-quemadas-deporte"><small>CALCULADORA</small><strong>Calorías por actividad deportiva</strong><span>Hacer la cuenta →</span></a></div></section>
    <section class="nba-seo" aria-label="NBA: resumen y preguntas frecuentes">
      <p class="nba-answer">Acá seguís la <strong>NBA</strong> al día: las <strong>siete fechas de la semana</strong> con horario en tu país, los <strong>resultados finales</strong>, la <strong>tabla de posiciones</strong> del Este y el Oeste, el <strong>calendario</strong> y los <strong>líderes de la temporada</strong>. La agenda se renueva cada lunes y cada marcador aparece cuando el partido termina.</p>
      <section class="nba-faq" aria-labelledby="nba-faq-title">
        <h2 id="nba-faq-title">Preguntas frecuentes sobre la NBA</h2>
        {faqs.map((f) => (
          <details class="nba-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    </section>

    <section class="follow-banner" id="seguir-nba"><div><span>◒</span><h2>Seguí la NBA sin perderte nada</h2><p>Guardá esta página: la agenda se renueva cada semana y los resultados aparecen al finalizar cada partido.</p></div><a class="orange-button" href="/nba-2026">Actualizar ahora</a></section>
    <p class="source">Fuente de partidos, posiciones y líderes: ESPN. Agenda semanal sincronizada: <time datetime={data.fetchedAt}>{new Date(data.fetchedAt).toLocaleString('es-AR', { timeZone: AR })}</time>. Los resultados se consultan únicamente después de cada partido. Foto de hero: <a href="https://unsplash.com/photos/ayQEv3R6sPE" target="_blank" rel="noopener">Taylor Smith / Unsplash</a>.</p>
    <script id="nba-week-snapshot" type="application/json" set:html={weekSnapshot}></script>
  </main>
  <Footer slot="footer" />
</Layout>

<script is:inline type="application/x-nba-legacy-disabled">
  const root = document.querySelector('[data-nba]');
  if (false && root) {
    const api = root.dataset.api;
    const summerApi = root.dataset.summerApi;
    const standingsApi = root.dataset.standingsApi;
    const day = (offset=0) => { const d=new Date(); d.setDate(d.getDate()+offset); return d.toISOString().slice(0,10).replaceAll('-',''); };
    const today = new Intl.DateTimeFormat('es-AR',{weekday:'long',day:'numeric',month:'long'}).format(new Date());
    root.querySelector('[data-today]').textContent=today.charAt(0).toUpperCase()+today.slice(1);
    const esc = (s='') => String(s).replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    const norm = e => { const c=e.competitions?.[0]||{}, ts=c.competitors||[], away=ts.find(t=>t.homeAway==='away')||ts[0]||{}, home=ts.find(t=>t.homeAway==='home')||ts[1]||{}; const team=t=>({name:t.team?.displayName||'Por confirmar',abbr:t.team?.abbreviation||'—',score:t.score??'—',logo:t.team?.logo||'',}); return {id:e.id,league:e._league||'NBA',date:e.date,state:c.status?.type?.state||'pre',detail:c.status?.type?.detail||'',clock:c.status?.displayClock||'',period:c.status?.period||0,away:team(away),home:team(home),href:e.links?.find(l=>l.text==='Gamecast')?.href||`https://www.espn.com/nba/game/_/gameId/${e.id}`}; };
    const time = iso => new Intl.DateTimeFormat('es-AR',{hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(iso));
    const dateKey = value => new Intl.DateTimeFormat('en-CA',{timeZone:'America/Argentina/Buenos_Aires',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(value));
    const gameUrl = g => `<a href="${g.href}" target="_blank" rel="noopener">`;
    const render = events => { const games=events.map(norm).filter((g,i,all)=>all.findIndex(x=>x.id===g.id)===i).sort((a,b)=>new Date(a.date)-new Date(b.date)), live=games.find(g=>g.state==='in')||games.find(g=>g.state==='pre')||[...games].reverse().find(g=>g.state==='post'), upcoming=games.filter(g=>g.state==='pre').slice(0,3), scheduleGames=games.filter(g=>dateKey(g.date)===dateKey(new Date())); root.querySelector('[data-status]').textContent=games.some(g=>g.state==='in')?'EN VIVO AHORA':'DATOS ACTUALIZADOS'; if(live){const state=live.state==='in'?'EN VIVO':live.state==='post'?'FINALIZADO':'PRÓXIMO PARTIDO'; const middle=live.state==='in'?`CUARTO ${live.period}<b>${esc(live.clock)}</b>`:live.state==='post'?'FINAL':time(live.date), score=value=>live.state==='pre'?'—':esc(value); root.querySelector('[data-primary-game]').innerHTML=`<div class="game-tag"><span class="${live.state==='in'?'dot':''}">${state}</span><b>${esc(live.league)} · ${live.state==='pre'?`Hoy, ${time(live.date)}`:esc(live.detail)}</b></div><div class="duel"><div class="team"><img src="${live.away.logo}" alt=""/><strong>${esc(live.away.name)}</strong><em>${score(live.away.score)}</em></div><div class="middle"><span>${middle}</span></div><div class="team"><img src="${live.home.logo}" alt=""/><strong>${esc(live.home.name)}</strong><em>${score(live.home.score)}</em></div></div>${gameUrl(live)}<span class="orange-button">${live.state==='pre'?'Ver previa':'Ver detalles'} <b>›</b></span></a>`; } const next=root.querySelector('[data-upcoming]'); if(next) next.innerHTML=upcoming.length?upcoming.map(g=>`${gameUrl(g)}<span class="next-row"><b>${time(g.date)}</b><span><img src="${g.away.logo}" alt=""/>${esc(g.away.abbr)} <small>vs</small> <img src="${g.home.logo}" alt=""/>${esc(g.home.abbr)}</span><i>›</i></span></a>`).join(''):'<p class="muted">No hay partidos en las próximas 48 horas.</p>'; const sched=root.querySelector('[data-schedule]'); if(sched) sched.innerHTML=scheduleGames.length?scheduleGames.map(g=>`${gameUrl(g)}<span class="schedule-row"><span class="${g.state==='in'?'playing':''}">${g.state==='in'?'EN VIVO':g.state==='post'?'FINAL':time(g.date)}<small>${esc(g.league)} · ${g.state==='pre'?'Programado':esc(g.state==='in'?g.clock:g.detail)}</small></span><b><img src="${g.away.logo}" alt=""/>${esc(g.away.name)}</b><strong>${g.state==='pre'?'<i>vs</i>':`${esc(g.away.score)} <i>—</i> ${esc(g.home.score)}`}</strong><b><img src="${g.home.logo}" alt=""/>${esc(g.home.name)}</b><em>${g.state==='pre'?'Ver previa':'Ver detalles'} ›</em></span></a>`).join(''):'<div class="empty-schedule"><strong>No hay partidos programados para hoy.</strong><span>La agenda se actualiza automáticamente cuando ESPN publica nuevos cruces.</span></div>'; };
    const renderStandings = payload => { const west=(payload.children||[]).find(g=>g.abbreviation==='West'||g.name==='Western Conference'), entries=(west?.standings?.entries||[]).map(entry=>{const stat=n=>entry.stats?.find(s=>s.name===n), rank=stat('playoffSeed')?.value||stat('rank')?.value||0, wins=stat('wins')?.value||0, losses=stat('losses')?.value||0; return {rank,team:entry.team?.displayName||'',abbr:entry.team?.abbreviation||'',logo:entry.team?.logos?.[0]?.href||'',wins,losses,pct:stat('winPercent')?.displayValue||'—'};}).sort((a,b)=>a.rank-b.rank).slice(0,8), table=root.querySelector('[data-standings]'); if(table&&entries.length)table.innerHTML=entries.map(t=>`<a href="https://www.espn.com/nba/team/_/name/${esc(t.abbr.toLowerCase())}" target="_blank" rel="noopener" class="standing"><b>${esc(t.rank)}</b><span><img src="${t.logo}" alt=""/>${esc(t.team)}</span><em>${Number(t.wins)+Number(t.losses)}</em><em>${esc(t.wins)}</em><em>${esc(t.pct)}</em></a>`).join(''); };
    const hydrate = async () => { try { const [scoreboards,summerScoreboards,standings]=await Promise.all([Promise.all([-1,0,1].map(o=>fetch(`${api}?dates=${day(o)}`).then(r=>r.json()))),Promise.all([-1,0,1].map(o=>fetch(`${summerApi}?dates=${day(o)}`).then(r=>r.json()))),fetch(standingsApi).then(r=>r.json())]); const regular=scoreboards.flatMap(x=>x.events||[]).map(e=>({...e,_league:'NBA'})), summer=summerScoreboards.flatMap(x=>x.events||[]).map(e=>({...e,_league:'Summer League'})); render([...regular,...summer]); renderStandings(standings); } catch (_) { root.querySelector('[data-status]').textContent='ÚLTIMO SNAPSHOT'; } };
    hydrate(); setInterval(hydrate,60000);
    root.querySelectorAll('.nav-links a').forEach(a=>a.addEventListener('click',()=>root.querySelectorAll('.nav-links a').forEach(x=>x.classList.toggle('active',x===a))));
  }
</script>
