---
// @incremental-standalone — landing NBA aislada; habilita deploy incremental.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/live/nba.json';

const AR = 'America/Argentina/Buenos_Aires';
const fmtDay = (iso: string) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(iso));
const fmtTime = (iso: string) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(iso));
const games = data.games || [];
const live = games.find((g: any) => g.state === 'in') || games.find((g: any) => g.state === 'post') || games[0];
const upcoming = games.filter((g: any) => g.state === 'pre').slice(0, 3);
const standings = (data.standings || []).sort((a: any, b: any) => Number(a.rank) - Number(b.rank)).slice(0, 8);
const title = 'NBA hoy: partidos, resultados, posiciones y calendario | Hacé Cuentas';
const description = 'Partidos NBA de hoy, resultados en vivo, calendario y posiciones. Datos actualizados automáticamente al terminar cada partido.';
const schema = { '@context':'https://schema.org', '@graph': [{ '@type':'SportsEvent', name:'NBA 2025-26', sport:'Basketball', url:'https://hacecuentas.com/nba-2026' }, { '@type':'Dataset', name:'NBA: resultados, calendario y posiciones', isBasedOn:'https://www.espn.com/nba/', dateModified:data.fetchedAt, url:'https://hacecuentas.com/nba-2026' }] };
---
<Layout title={title} description={description} canonical="/nba-2026" audience="AR" domain="life" pageType="data" schema={schema} noAds={true}>
  <Header slot="header" />
  <main class="nba" data-nba data-api="https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard">
    <nav class="nba-nav" aria-label="Navegación NBA">
      <a class="brand" href="/nba-2026" aria-label="NBA Hoy, inicio"><span>◒</span> NBA HOY</a>
      <div class="nav-links"><a class="active" href="#partidos">Partidos</a><a href="#calendario">Calendario</a><a href="#posiciones">Posiciones</a><a href="https://www.espn.com/nba/teams" target="_blank" rel="noopener">Equipos</a><a href="#noticias">Noticias</a></div>
      <a class="follow" href="#seguir-nba">♧ <span>Seguir NBA</span></a>
    </nav>

    <section class="hero" id="partidos">
      <div><p class="eyebrow">BÁSQUET EN VIVO</p><h1>NBA hoy: partidos, resultados<br/>y toda la temporada</h1><div class="chips"><span>▣ <b data-today>Hoy</b></span><span class="live-chip"><i></i><b data-status>ACTUALIZANDO</b></span></div></div>
      <div class="hero-hoop" aria-hidden="true"><div class="backboard"></div><div class="rim"></div><div class="net"></div></div>
    </section>

    <section class="top-grid" aria-label="Partidos destacados">
      <article class="game-hero" data-primary-game>
        {live ? <>
          <div class="game-tag"><span class:list={{dot:live.state === 'in'}}>{live.state === 'in' ? 'EN VIVO' : live.state === 'post' ? 'FINALIZADO' : 'PRÓXIMO PARTIDO'}</span><b>{live.detail || live.status}</b></div>
          <div class="duel">
            <div class="team"><img src={live.away.logo} alt="" loading="lazy"/><strong>{live.away.name}</strong><em>{live.away.score ?? '—'}</em></div>
            <div class="middle"><span>{live.state === 'in' ? `CUARTO ${live.period}` : fmtTime(live.date)}</span><b>{live.state === 'in' ? live.clock : live.state === 'post' ? 'FINAL' : 'VS'}</b></div>
            <div class="team"><img src={live.home.logo} alt="" loading="lazy"/><strong>{live.home.name}</strong><em>{live.home.score ?? '—'}</em></div>
          </div>
          <a class="orange-button" href={live.href} target="_blank" rel="noopener">{live.state === 'pre' ? 'Ver previa' : 'Ver detalles'} <b>›</b></a>
        </> : <div class="empty-game"><span>◒</span><h2>No hay partidos programados ahora</h2><p>El calendario y los resultados se actualizan automáticamente cuando vuelve la acción.</p><a class="orange-button" href="#calendario">Ver calendario</a></div>}
      </article>
      <aside class="next-card"><h2>Próximos partidos</h2><div data-upcoming>{upcoming.length ? upcoming.map((game: any) => <a href={game.href} target="_blank" rel="noopener" class="next-row"><b>{fmtTime(game.date)}</b><span><img src={game.away.logo} alt=""/>{game.away.abbr} <small>vs</small> <img src={game.home.logo} alt=""/>{game.home.abbr}</span><i>›</i></a>) : <p class="muted">No hay partidos en las próximas 48 horas.</p>}</div><a class="more" href="#calendario">Ver calendario completo <b>›</b></a></aside>
    </section>

    <section class="section stories" id="noticias"><header><h2>Lo que no te podés perder</h2><a href="https://www.nba.com/news" target="_blank" rel="noopener">Ver todas las noticias <b>›</b></a></header><div class="story-grid"><a class="story s1" href="https://www.nba.com/news" target="_blank" rel="noopener"><span>ANÁLISIS</span><strong>Las claves que definen la recta final de la temporada</strong><small>Actualizado hoy</small></a><a class="story s2" href="https://www.nba.com/news" target="_blank" rel="noopener"><span>NBA HOY</span><strong>Todo lo que tenés que mirar esta semana</strong><small>Agenda y resultados</small></a><a class="story s3" href="https://www.nba.com/news" target="_blank" rel="noopener"><span>HISTORIAS</span><strong>Las figuras que están marcando la liga</strong><small>Seguimiento de temporada</small></a></div></section>

    <section class="section data-grid" id="posiciones"><article class="standings"><header><h2>Conferencia Oeste</h2><a href="https://www.espn.com/nba/standings" target="_blank" rel="noopener">Tabla completa ›</a></header><div class="table-head"><span>#</span><span>Equipo</span><span>P</span><span>G</span><span>PCT</span></div><div data-standings>{standings.length ? standings.map((team:any, i:number) => <a href={`https://www.espn.com/nba/team/_/name/${team.abbr?.toLowerCase()}`} target="_blank" rel="noopener" class="standing"><b>{team.rank || i + 1}</b><span><img src={team.logo} alt=""/>{team.team}</span><em>{Number(team.wins) + Number(team.losses)}</em><em>{team.wins}</em><em>{team.pct}</em></a>) : <p class="muted">La tabla se carga al iniciar la temporada.</p>}</div></article><article class="leaders"><header><h2>Líderes de la noche</h2><a href="https://www.espn.com/nba/stats" target="_blank" rel="noopener">Estadísticas ›</a></header><div class="leaders-empty"><span>★</span><h3>Las figuras del día aparecerán acá</h3><p>Este módulo se actualiza junto con el scoreboard cuando hay partidos en curso.</p></div></article></section>

    <section class="section schedule" id="calendario"><header><div><h2>Calendario de hoy</h2><p data-date-label>{games[0] ? fmtDay(games[0].date) : 'Próxima jornada NBA'}</p></div><a href="https://www.espn.com/nba/schedule" target="_blank" rel="noopener">Ver calendario completo <b>›</b></a></header><div class="schedule-list" data-schedule>{games.length ? games.map((game:any) => <a href={game.href} target="_blank" rel="noopener" class="schedule-row"><span class:list={{playing:game.state === 'in'}}>{game.state === 'in' ? 'EN VIVO' : game.state === 'post' ? 'FINAL' : fmtTime(game.date)}<small>{game.state === 'in' ? game.clock : game.detail}</small></span><b><img src={game.away.logo} alt=""/>{game.away.name}</b><strong>{game.away.score ?? '—'} <i>—</i> {game.home.score ?? '—'}</strong><b><img src={game.home.logo} alt=""/>{game.home.name}</b><em>{game.state === 'pre' ? 'Ver previa' : 'Ver detalles'} ›</em></a>) : <div class="empty-schedule"><strong>La NBA está entre temporadas.</strong><span>Cuando haya una nueva jornada, los partidos y resultados aparecerán acá automáticamente.</span></div>}</div></section>
    <section class="follow-banner" id="seguir-nba"><div><span>◒</span><h2>Seguí la NBA sin perderte nada</h2><p>Guardá esta página: el fixture, resultados y tabla se refrescan en cada jornada.</p></div><a class="orange-button" href="/nba-2026">Actualizar ahora</a></section>
    <p class="source">Fuente de partidos y posiciones: ESPN. Última sincronización: <time datetime={data.fetchedAt}>{new Date(data.fetchedAt).toLocaleString('es-AR', { timeZone: AR })}</time>. La página consulta resultados nuevamente cada 60 segundos durante una jornada.</p>
  </main>
  <Footer slot="footer" />
</Layout>

<script is:inline>
  const root = document.querySelector('[data-nba]');
  if (root) {
    const api = root.dataset.api;
    const day = (offset=0) => { const d=new Date(); d.setDate(d.getDate()+offset); return d.toISOString().slice(0,10).replaceAll('-',''); };
    const today = new Intl.DateTimeFormat('es-AR',{weekday:'long',day:'numeric',month:'long'}).format(new Date());
    root.querySelector('[data-today]').textContent=today.charAt(0).toUpperCase()+today.slice(1);
    const esc = (s='') => String(s).replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    const norm = e => { const c=e.competitions?.[0]||{}, ts=c.competitors||[], away=ts.find(t=>t.homeAway==='away')||ts[0]||{}, home=ts.find(t=>t.homeAway==='home')||ts[1]||{}; const team=t=>({name:t.team?.displayName||'Por confirmar',abbr:t.team?.abbreviation||'—',score:t.score??'—',logo:t.team?.logo||'',}); return {id:e.id,date:e.date,state:c.status?.type?.state||'pre',detail:c.status?.type?.detail||'',clock:c.status?.displayClock||'',period:c.status?.period||0,away:team(away),home:team(home),href:`https://www.espn.com/nba/game/_/gameId/${e.id}`}; };
    const time = iso => new Intl.DateTimeFormat('es-AR',{hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(iso));
    const gameUrl = g => `<a href="${g.href}" target="_blank" rel="noopener">`;
    const render = events => { const games=events.map(norm), live=games.find(g=>g.state==='in')||games.find(g=>g.state==='post')||games[0], upcoming=games.filter(g=>g.state==='pre').slice(0,3); root.querySelector('[data-status]').textContent=games.some(g=>g.state==='in')?'EN VIVO AHORA':'DATOS ACTUALIZADOS'; if(live){const state=live.state==='in'?'EN VIVO':live.state==='post'?'FINALIZADO':'PRÓXIMO PARTIDO'; const middle=live.state==='in'?`CUARTO ${live.period}<b>${esc(live.clock)}</b>`:live.state==='post'?'FINAL':time(live.date); root.querySelector('[data-primary-game]').innerHTML=`<div class="game-tag"><span class="${live.state==='in'?'dot':''}">${state}</span><b>${esc(live.detail)}</b></div><div class="duel"><div class="team"><img src="${live.away.logo}" alt=""/><strong>${esc(live.away.name)}</strong><em>${esc(live.away.score)}</em></div><div class="middle"><span>${middle}</span></div><div class="team"><img src="${live.home.logo}" alt=""/><strong>${esc(live.home.name)}</strong><em>${esc(live.home.score)}</em></div></div>${gameUrl(live)}<span class="orange-button">${live.state==='pre'?'Ver previa':'Ver detalles'} <b>›</b></span></a>`; } const next=root.querySelector('[data-upcoming]'); if(next) next.innerHTML=upcoming.length?upcoming.map(g=>`${gameUrl(g)}<span class="next-row"><b>${time(g.date)}</b><span><img src="${g.away.logo}" alt=""/>${esc(g.away.abbr)} <small>vs</small> <img src="${g.home.logo}" alt=""/>${esc(g.home.abbr)}</span><i>›</i></span></a>`).join(''):'<p class="muted">No hay partidos en las próximas 48 horas.</p>'; const sched=root.querySelector('[data-schedule]'); if(sched) sched.innerHTML=games.length?games.map(g=>`${gameUrl(g)}<span class="schedule-row"><span class="${g.state==='in'?'playing':''}">${g.state==='in'?'EN VIVO':g.state==='post'?'FINAL':time(g.date)}<small>${esc(g.state==='in'?g.clock:g.detail)}</small></span><b><img src="${g.away.logo}" alt=""/>${esc(g.away.name)}</b><strong>${esc(g.away.score)} <i>—</i> ${esc(g.home.score)}</strong><b><img src="${g.home.logo}" alt=""/>${esc(g.home.name)}</b><em>${g.state==='pre'?'Ver previa':'Ver detalles'} ›</em></span></a>`).join(''):'<div class="empty-schedule"><strong>La NBA está entre temporadas.</strong><span>Cuando haya una nueva jornada, los partidos y resultados aparecerán acá automáticamente.</span></div>'; };
    const hydrate = async () => { try { const res = await Promise.all([-1,0,1].map(o=>fetch(`${api}?dates=${day(o)}`).then(r=>r.json()))); render(res.flatMap(x=>x.events||[])); } catch (_) { root.querySelector('[data-status]').textContent='ÚLTIMO SNAPSHOT'; } };
    hydrate(); setInterval(hydrate,60000);
    root.querySelectorAll('.nav-links a').forEach(a=>a.addEventListener('click',()=>root.querySelectorAll('.nav-links a').forEach(x=>x.classList.toggle('active',x===a))));
  }
</script>

<style>
.nba{--ink:#f5f7fb;--muted:#a6b2c5;--line:#273447;--panel:#101d2c;--navy:#07111d;--orange:#ff5a1f;--blue:#52a0ff;background:var(--navy);color:var(--ink);font-family:var(--font-body,Inter,system-ui);margin:0 auto;max-width:1180px;min-height:100vh;padding:0 24px 70px}.nba *{box-sizing:border-box}.nba a{color:inherit}.nba h1,.nba h2,.nba h3,.nba h4,.nba strong,.nba b,.nba em{color:var(--ink)}.nba p{color:var(--muted)}.nba-nav{align-items:center;border-bottom:1px solid #1d2a3a;display:flex;height:74px;justify-content:space-between;gap:24px}.brand{color:var(--ink)!important;font-size:25px;font-weight:900;letter-spacing:-1px;text-decoration:none;white-space:nowrap}.brand span{color:var(--orange);font-size:32px;vertical-align:-3px}.nav-links{display:flex;align-self:stretch;gap:28px}.nav-links a{color:#d4dae4;display:grid;font-size:14px;font-weight:700;place-items:center;text-decoration:none;border-bottom:3px solid transparent}.nav-links a.active,.nav-links a:hover{border-color:var(--orange);color:var(--orange)}.follow,.orange-button{background:var(--orange);border-radius:7px;color:#fff!important;display:inline-flex;font-size:14px;font-weight:800;gap:7px;justify-content:center;padding:12px 18px;text-decoration:none}.hero{background:radial-gradient(circle at 80% 30%,rgba(42,100,180,.36),transparent 30%),linear-gradient(90deg,#07111d 45%,rgba(7,17,29,.26)),url('/nba-2026/editorial-triptych.png') right 38%/700px auto no-repeat;min-height:285px;padding:42px 0;position:relative}.eyebrow{color:var(--orange)!important;font-size:12px;font-weight:900;letter-spacing:1.5px;margin:0 0 12px}.hero h1{color:var(--ink)!important;font-size:clamp(35px,4.5vw,58px);letter-spacing:-2.5px;line-height:1.02;margin:0;max-width:740px}.chips{display:flex;gap:10px;margin-top:24px}.chips span{background:#101d2c;border:1px solid #36455a;border-radius:7px;color:#dde5ef;font-size:14px;padding:10px 13px}.chips b{color:inherit}.live-chip{color:#35d59c!important}.live-chip i,.dot::before{background:#23d592;border-radius:50%;content:'';display:inline-block;height:8px;margin-right:7px;width:8px}.top-grid{display:grid;gap:18px;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);margin-top:-12px}.game-hero,.next-card,.standings,.leaders{background:linear-gradient(135deg,#122237,#0d1827);border:1px solid #2b3b50;border-radius:10px;padding:25px}.game-tag{display:flex;gap:8px;color:#ff8c68;font-size:13px}.game-tag b{color:var(--muted);font-weight:600}.dot::before{background:var(--orange)}.duel{align-items:center;display:grid;grid-template-columns:1fr 110px 1fr;margin:27px 0 20px;text-align:center}.team{align-items:center;display:flex;flex-direction:column;gap:9px}.team img{height:78px;object-fit:contain;width:78px}.team strong{font-size:16px}.team em{font-size:57px;font-style:normal;font-weight:900;line-height:1}.middle{border-left:1px solid #34455b;border-right:1px solid #34455b;color:var(--muted);display:grid;gap:8px}.middle b{color:var(--orange);font-size:24px}.orange-button{border:0;cursor:pointer;margin:auto}.orange-button b{color:#fff;font-size:20px;line-height:12px}.next-card h2,.section h2{color:var(--ink)!important;font-size:22px;letter-spacing:-.6px;margin:0}.next-row{align-items:center;border:1px solid #2b3b50;border-radius:7px;display:grid;grid-template-columns:48px 1fr 12px;margin:12px 0;padding:13px;text-decoration:none}.next-row>b{font-size:13px}.next-row span{align-items:center;display:flex;gap:7px;font-size:13px;font-weight:800}.next-row img,.schedule-row img,.standing img{height:22px;object-fit:contain;width:22px}.next-row small{color:var(--muted);font-size:10px}.next-row i{font-size:22px;font-style:normal}.more,.section header>a{color:var(--blue)!important;display:block;font-size:13px;margin-top:20px;text-decoration:none}.more b,.section header>a b{color:inherit;font-size:19px}.section{margin-top:34px}.section>header{align-items:center;display:flex;justify-content:space-between;margin-bottom:15px}.section>header>a{margin:0}.story-grid{display:grid;gap:16px;grid-template-columns:repeat(3,1fr)}.story{background-image:linear-gradient(0deg,#07111d 3%,transparent 70%),url('/nba-2026/editorial-triptych.png');background-size:300% auto;border:1px solid #2b3b50;border-radius:8px;display:flex;flex-direction:column;height:260px;justify-content:flex-end;overflow:hidden;padding:18px;text-decoration:none}.s1{background-position:0 center}.s2{background-position:50% center}.s3{background-position:100% center}.story span{color:#ffab7e;font-size:11px;font-weight:900;margin-bottom:10px}.story strong{color:#fff;font-size:19px;line-height:1.17}.story small{color:#b5c0cf;margin-top:12px}.data-grid{display:grid;gap:18px;grid-template-columns:1fr 1fr}.standings header,.leaders header{align-items:center;display:flex;justify-content:space-between;margin-bottom:20px}.standings header a,.leaders header a{color:var(--blue)!important;font-size:12px;text-decoration:none}.table-head,.standing{align-items:center;border-bottom:1px solid #29394c;display:grid;grid-template-columns:32px 1fr 34px 34px 46px;min-height:40px}.table-head{color:var(--muted);font-size:11px;text-transform:uppercase}.standing{text-decoration:none}.standing>b{font-size:13px}.standing span{align-items:center;display:flex;font-size:14px;font-weight:700;gap:9px}.standing em{font-size:13px;font-style:normal;text-align:right}.leaders-empty{align-items:center;border:1px dashed #3a506a;border-radius:8px;color:var(--muted);display:flex;flex-direction:column;justify-content:center;min-height:280px;padding:30px;text-align:center}.leaders-empty span{color:var(--orange);font-size:36px}.leaders-empty h3{color:var(--ink)!important;font-size:18px;margin:12px 0 0}.leaders-empty p{font-size:13px;line-height:1.5;margin:7px 0}.schedule{scroll-margin-top:18px}.schedule header>div p{color:var(--muted);font-size:14px;margin:5px 0 0;text-transform:capitalize}.schedule-list{border:1px solid #2b3b50;border-radius:9px;overflow:hidden}.schedule-row{align-items:center;border-bottom:1px solid #2b3b50;display:grid;grid-template-columns:100px 1fr 120px 1fr 100px;gap:12px;min-height:64px;padding:10px 16px;text-decoration:none}.schedule-row:last-child{border:0}.schedule-row>span{font-size:14px;font-weight:800}.schedule-row>span small{color:var(--muted);display:block;font-size:10px;font-weight:500;margin-top:3px}.schedule-row>span.playing{color:var(--orange)}.schedule-row>b{align-items:center;display:flex;font-size:14px;gap:8px}.schedule-row strong{text-align:center}.schedule-row strong i{color:var(--muted);font-style:normal;padding:0 6px}.schedule-row em{border:1px solid #42566e;border-radius:5px;color:var(--blue);font-size:12px;font-style:normal;padding:8px;text-align:center}.empty-game{text-align:center;padding:35px 20px}.empty-game>span{color:var(--orange);font-size:45px}.empty-game h2{color:var(--ink)!important;font-size:23px;margin:5px 0}.empty-game p,.muted{color:var(--muted);font-size:14px;line-height:1.5}.empty-schedule{color:var(--muted);display:grid;gap:5px;padding:30px;text-align:center}.empty-schedule strong{color:var(--ink)}.follow-banner{align-items:center;background:linear-gradient(100deg,#1b2e47,#0c1624);border:1px solid #2b3b50;border-radius:9px;display:flex;justify-content:space-between;margin-top:35px;padding:25px}.follow-banner>div{position:relative;padding-left:44px}.follow-banner span{color:var(--orange);font-size:32px;left:0;position:absolute;top:0}.follow-banner h2{color:var(--ink)!important;font-size:21px;margin:0}.follow-banner p{color:var(--muted);font-size:14px;margin:6px 0 0}.source{color:#8796a9!important;font-size:11px;margin:22px 0;text-align:center}.source time{font-variant-numeric:tabular-nums}@media(max-width:760px){.nba{padding:0 14px 45px}.nba-nav{height:62px}.brand{font-size:20px}.nav-links{display:none}.follow{padding:9px 11px}.hero{background-position:85% center;min-height:245px;padding:33px 0}.hero h1{font-size:37px}.top-grid,.data-grid{grid-template-columns:1fr}.next-card{padding:20px}.story-grid{grid-template-columns:1fr;overflow:auto}.story{height:220px}.duel{grid-template-columns:1fr 75px 1fr}.team img{height:54px;width:54px}.team strong{font-size:12px}.team em{font-size:42px}.schedule-row{grid-template-columns:64px 1fr 65px;gap:7px;padding:10px}.schedule-row>b:nth-of-type(2),.schedule-row em{display:none}.schedule-row>b{font-size:12px}.schedule-row strong{font-size:13px}.follow-banner{align-items:flex-start;flex-direction:column;gap:16px}.follow-banner .orange-button{margin:0}.section>header{align-items:flex-start}.section>header>a{max-width:120px;text-align:right}.follow span{display:none}}
</style>
