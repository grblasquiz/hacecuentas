---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Top 10 calcs por tráfico Bing (data/bing-perf-latest.json, sección pages),
// filtradas a slugs con URL viva, JSON en content/calcs/ y embed habilitado
// (canEmbedCalc: sin draft/restricted/ymyl-high sin revisor, sin 301/410/pruning).
const topCalcs = [
  { slug: 'conversor-numero-a-letras-cantidad', name: 'Conversor de número a letras (cantidades a texto)' },
  { slug: 'calculadora-actualizacion-inflacion-ipc', name: 'Calculadora de actualización por inflación (IPC)' },
  { slug: 'calculadora-generacion-perteneces', name: 'Calculadora: ¿a qué generación pertenecés?' },
  { slug: 'calculadora-millas-avianca-lifemiles', name: 'Millas Avianca LifeMiles por destino' },
  { slug: 'calculadora-conversor-metros-lineales-a-metros-cuadrados', name: 'Conversor de metros lineales a metros cuadrados' },
  { slug: 'calculadora-impuesto-ganancias-sueldo', name: 'Calculadora de Impuesto a las Ganancias (sueldo)' },
  { slug: 'calculadora-retencion-ganancias-rg-830', name: 'Retenciones de Ganancias RG 830 (AFIP/ARCA)' },
  { slug: 'calculadora-interes-judicial-tasa', name: 'Calculadora de interés judicial (tasa activa BNA)' },
  { slug: 'calculadora-semanas-gestacion-ecografia', name: 'Edad gestacional por ecografía' },
  { slug: 'calculadora-ladrillos-por-m2-construccion', name: '¿Cuántos ladrillos necesito por m²?' },
];

function snippetFor(c: { slug: string; name: string }): string {
  return `<iframe src="https://hacecuentas.com/embed/${c.slug}" width="100%" height="620" style="border:0;border-radius:12px" loading="lazy" title="${c.name}"></iframe>\n<p>Calculadora de <a href="https://hacecuentas.com/${c.slug}">hacecuentas.com</a></p>`;
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Embebé estas calculadoras en tu web — Hacé Cuentas',
  description:
    'Insertá gratis nuestras calculadoras en tu sitio con un iframe. Snippets listos para copiar y pegar de las 10 calculadoras más usadas.',
  url: 'https://hacecuentas.com/embeds',
  inLanguage: 'es-AR',
  isPartOf: { '@id': 'https://hacecuentas.com/#website' },
  publisher: { '@id': 'https://hacecuentas.com/#organization' },
};
---

<Layout
  noAds={true}
  title="Embebé estas calculadoras en tu web (gratis) — Hacé Cuentas"
  description="Insertá nuestras calculadoras en tu sitio o blog con un simple iframe. Gratis, sin registro: copiá el snippet y pegalo. Snippets listos de las 10 calcs más usadas."
  schema={schema}
>
  <Header slot="header" />

  <article class="legal">
    <h1>Embebé estas calculadoras en tu web</h1>
    <p class="intro">
      ¿Tenés un blog, un sitio profesional o un medio y querés sumar una calculadora que
      funciona de verdad? Podés insertar cualquiera de nuestras calculadoras en tu página
      con un simple <code>&lt;iframe&gt;</code>. Es gratis y no necesitás registrarte.
    </p>

    <h2>Cómo funciona</h2>
    <p>
      Cada calculadora tiene una versión embebible en
      <code>https://hacecuentas.com/embed/&lt;slug&gt;</code>: una página liviana, sin
      menús ni publicidad, pensada para vivir dentro de un iframe. Copiá el snippet de la
      calculadora que quieras, pegalo en el HTML de tu página y listo. El iframe carga en
      modo <code>lazy</code> (no frena tu página) y la calculadora se adapta al ancho del
      contenedor.
    </p>

    <h2>Condición de uso: el link de atribución</h2>
    <p>
      El embed es <strong>gratis a cambio de mantener visible el link de atribución</strong>
      a hacecuentas.com que viene debajo de cada snippet. Ese link le dice a tus lectores
      (y a los buscadores) de dónde sale la herramienta, y es lo que nos permite seguir
      manteniendo las calculadoras actualizadas y gratuitas. Si lo sacás o lo escondés,
      podemos deshabilitar el embed para tu dominio. Si necesitás una versión sin
      atribución o con tu propio branding, escribinos a
      <a href="mailto:contacto@hacecuentas.com">contacto@hacecuentas.com</a>.
    </p>

    <h2>Las 10 calculadoras más usadas, listas para copiar</h2>
    <p>
      Estos son los snippets de nuestras calculadoras con más tráfico. Tocá
      <strong>Copiar</strong> y pegá el código en tu página.
    </p>

    <div class="embed-list">
      {topCalcs.map((c) => (
        <section class="embed-item">
          <h3>
            <a href={`/${c.slug}`}>{c.name}</a>
          </h3>
          <pre class="embed-code"><code>{snippetFor(c)}</code></pre>
          <button type="button" class="copy-btn" data-snippet={snippetFor(c)}>Copiar</button>
        </section>
      ))}
    </div>

    <h2>¿Querés embeber otra calculadora?</h2>
    <p>
      Cualquier calculadora del sitio (salvo algunas de temas sensibles) se puede embeber
      con el mismo patrón: reemplazá el slug en la URL del iframe por el de la página que
      quieras. También tenemos un <a href="/wordpress">plugin de WordPress</a> y una
      sección <a href="/desarrolladores">para desarrolladores</a> con el web component y
      opciones de personalización (color, título, logo y CTA propios).
    </p>

    <script is:inline>
      (function () {
        document.querySelectorAll('.copy-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var text = btn.getAttribute('data-snippet') || '';
            function done() {
              var prev = btn.textContent;
              btn.textContent = '¡Copiado!';
              setTimeout(function () { btn.textContent = prev; }, 1800);
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(done);
            } else {
              var ta = document.createElement('textarea');
              ta.value = text;
              document.body.appendChild(ta);
              ta.select();
              try { document.execCommand('copy'); done(); } catch (e) {}
              document.body.removeChild(ta);
            }
          });
        });
      })();
    </script>
  </article>

  <Footer slot="footer" />
</Layout>

<style>
  .legal {
    max-width: 720px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .legal h1 {
    margin-bottom: 1rem;
  }
  .intro {
    color: var(--text-muted);
    font-size: 1.0625rem;
    margin-bottom: 2rem;
  }
  .legal h2 {
    margin-top: 3rem;
    color: var(--text);
  }
  .legal p {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .legal strong {
    color: var(--text);
  }
  .legal code {
    background: var(--bg-muted);
    border-radius: 4px;
    padding: 0.1em 0.35em;
    font-size: 0.875em;
  }

  .embed-list {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .embed-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }
  .embed-item h3 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }
  .embed-item h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .embed-item h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .embed-code {
    background: var(--bg-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.875rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-all;
    margin: 0 0 0.75rem;
  }
  .embed-code code {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .copy-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }
  .copy-btn:hover {
    background: var(--accent-strong);
  }
</style>
