---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PRODUCTS, getProduct } from '../../lib/products/manifest';
import { PROFILE_FIELDS } from '../../lib/profile/schema';
import { DECISION_MANIFEST } from '../../lib/decisions/manifest';
import { DASH, TOOL_META, SALA_EYEBROW, TAB_ICON, TAB_ORDER, ICONS } from '../../lib/products/dashboard';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { producto: p.slug } }));
}

const { producto } = Astro.params;
const product = getProduct(producto!)!;
const dash = DASH[product.id];

// Familia visual del vertical (money es default → sólo mapeamos los que difieren).
const productDomain = ({ casa: 'home', familia: 'health' } as const)[producto as string];

const fieldByKey = new Map(PROFILE_FIELDS.map((f) => [f.key, f]));
const salaBySlug = new Map(DECISION_MANIFEST.map((r) => [r.slug, r]));

// Campos del perfil de este vertical (sidebar "Datos de…" + precarga de herramientas).
const estadoFields = product.profileKeys
  .map((k) => fieldByKey.get(k))
  .filter(Boolean)
  .map((f) => ({
    key: f!.key,
    label: f!.label,
    type: f!.type,
    unit: f!.unit || '',
    sensitive: !!f!.sensitive,
    options: f!.options || null,
  }));

const keyMetricFields = product.keyMetrics
  .map((k) => fieldByKey.get(k))
  .filter(Boolean)
  .map((f) => ({ key: f!.key, label: f!.label, unit: f!.unit || '', type: f!.type, options: f!.options || null }));

// Herramientas con metadata visual (ícono + descripción). El grid muestra hasta 6.
const toolsAll = product.tools.map((t) => ({
  ...t,
  desc: TOOL_META[t.slug]?.desc || '',
  icon: TOOL_META[t.slug]?.icon || 'list',
}));
const toolsShown = toolsAll.slice(0, 6);

// Salas resueltas a metadata real; el grid muestra hasta 4 (2×2 como el mockup).
const salas = product.salas
  .map((s) => salaBySlug.get(s))
  .filter(Boolean)
  .slice(0, 4) as typeof DECISION_MANIFEST;

const canonical = `/mi/${product.slug}`;
const editHref = `/mi-hacecuentas?next=${encodeURIComponent(canonical)}`;

// Tabs en orden fijo (Casa · Plata · Trabajo · Familia), no el del manifest.
const tabProducts = TAB_ORDER.map((id) => PRODUCTS.find((p) => p.id === id)!).filter(Boolean);

// Config que consume el script inline del cliente.
const clientConfig = JSON.stringify({
  id: product.id,
  slug: product.slug,
  name: product.name,
  profileKeys: estadoFields,
  keyMetrics: keyMetricFields,
  tools: product.tools,
  toolsCount: product.tools.length,
  alertSlugs: product.alertSlugs,
  milestones: product.milestones,
  stats: dash.stats.map((s) => ({ kind: s.kind, metricKey: s.metricKey || null })),
  situation: { primaryKey: dash.situation.primaryKey || null, primaryFallback: dash.situation.primaryFallback },
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${product.name} — Hacé Cuentas`,
  description: product.description,
  url: `https://hacecuentas.com${canonical}`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'es-AR',
  isPartOf: { '@id': 'https://hacecuentas.com/#website' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'ARS' },
};
---

<Layout
  noAds={true}
  title={`${product.name} — ${product.tagline} | Hacé Cuentas`}
  description={product.description}
  canonical={canonical}
  schema={schema}
  domain={productDomain}
  pageType="hub"
>
  <Fragment slot="header">
    <!-- Barra de estado (encima del header, como el mockup) -->
    <div class="mi-topbar" data-product={product.id}>
      <div class="mi-wrap mi-topbar-in">
        <span class="mi-tb-left"><span class="mi-tb-dot" aria-hidden="true"></span><strong>{dash.topbarLeft}</strong><span class="mi-tb-sub"> · {dash.topbarLeftSub}</span></span>
        <span class="mi-tb-right">{dash.topbarRight}</span>
      </div>
    </div>
    <Header />
  </Fragment>

  <div
    class="mi-dash"
    data-product={product.id}
    style={`--p-accent:${product.accent}; --p-hero:${dash.hero}; --p-glow:${dash.glow};`}
  >
    <!-- ───────── Tabs: Mis productos ───────── -->
    <nav class="mi-tabs" aria-label="Mis productos">
      <div class="mi-wrap mi-tabs-in">
        <span class="mi-tabs-label">Mis productos</span>
        <div class="mi-tabs-list">
          {tabProducts.map((p) => (
            <a
              class="mi-tab"
              href={`/mi/${p.slug}`}
              aria-current={p.id === product.id ? 'page' : undefined}
              style={`--t-accent:${p.accent}`}
            >
              <span class="mi-tab-ic" aria-hidden="true" set:html={ICONS[TAB_ICON[p.id]]} />
              <span>{p.name}</span>
            </a>
          ))}
        </div>
      </div>
    </nav>

    <div class="mi-wrap mi-body">
      <nav class="mi-crumb" aria-label="Migas">
        <a href="/mi">Mis productos</a> <span aria-hidden="true">/</span> <span>{product.name}</span>
      </nav>

      <!-- ───────── Hero ───────── -->
      <header class="mi-hero">
        <div class="mi-hero-main">
          <span class="mi-hero-eyebrow">{dash.eyebrow}</span>
          <h1>{product.name}</h1>
          <p class="mi-hero-desc">{dash.heroDesc}</p>
          <div class="mi-hero-pills">
            <span class="mi-hpill" data-pill-perfil><span class="mi-hpill-dot" aria-hidden="true"></span><span data-pill-perfil-txt>Perfil completo</span></span>
            <span class="mi-hpill" data-pill-alertas>✓ Alertas activas</span>
            <span class="mi-hpill">↻ Actualizado hoy</span>
          </div>
        </div>
        <aside class="mi-hero-card">
          <span class="mi-hc-label">{dash.situation.label}</span>
          <div class="mi-hc-row">
            <span class="mi-hc-ic" aria-hidden="true" set:html={ICONS[dash.situation.icon]} />
            <span class="mi-hc-txt">
              <strong data-sit-primary>{dash.situation.primaryFallback}</strong>
              <small>{dash.situation.secondary}</small>
            </span>
          </div>
          {dash.situation.bar && (
            <div class="mi-hc-bar">
              <div class="mi-hc-bar-track">
                {dash.situation.bar.map((seg) => (
                  <span style={`width:${seg.pct}%; background:${seg.color}`}></span>
                ))}
              </div>
              <div class="mi-hc-bar-legend">
                {dash.situation.bar.map((seg) => (
                  <span><i style={`background:${seg.color}`} aria-hidden="true"></i>{seg.label}</span>
                ))}
              </div>
            </div>
          )}
        </aside>
      </header>

      <!-- ───────── Números destacados ───────── -->
      <div class="mi-stats">
        {dash.stats.map((s, i) => (
          <div class="mi-stat" data-stat-idx={i} data-stat-kind={s.kind} data-stat-key={s.metricKey || ''}>
            <div class="mi-stat-top">
              <span class="mi-stat-label">{s.label}</span>
              <a class="mi-stat-act" data-stat-act href={s.kind === 'tools' ? '#mi-tools' : editHref}>{s.action}</a>
            </div>
            <span class="mi-stat-val" data-stat-val>{s.kind === 'tools' ? product.tools.length : '—'}</span>
            <span class="mi-stat-sub" data-stat-sub>{s.sub}</span>
          </div>
        ))}
      </div>

      <!-- ───────── Grid 2 columnas ───────── -->
      <div class="mi-grid">
        <div class="mi-col-main">
          <!-- Próximo hito -->
          <section class="mi-card mi-next">
            <div class="mi-card-head">
              <div><h2>Próximo hito</h2><p class="mi-card-sub">{dash.nextSub}</p></div>
              <a class="mi-see" href="/mi">Ver calendario →</a>
            </div>
            <div class="mi-next-box" data-next-box hidden>
              <span class="mi-next-date"><b data-next-mon>—</b><b data-next-day>—</b></span>
              <div class="mi-next-body">
                <b data-next-title>—</b>
                <p data-next-detail>—</p>
              </div>
              <a class="mi-next-cta" data-next-cta href="#">Calcular →</a>
            </div>
            <p class="mi-empty" data-next-empty hidden>No hay hitos próximos en este producto.</p>
          </section>

          <!-- Herramientas -->
          <section class="mi-card" id="mi-tools">
            <div class="mi-card-head">
              <div><h2>{dash.toolsTitle}</h2><p class="mi-card-sub">{dash.toolsSub}</p></div>
              <a class="mi-see" href="/calculadoras">Ver todas →</a>
            </div>
            <div class="mi-tools">
              {toolsShown.map((t) => (
                <a class="mi-tool" href={`/${t.slug}`}>
                  <span class="mi-tool-ic" aria-hidden="true" set:html={ICONS[t.icon]} />
                  <b>{t.label}</b>
                  {t.desc && <small>{t.desc}</small>}
                  <span class="mi-tool-cta">Calcular →</span>
                </a>
              ))}
            </div>
          </section>

          <!-- Decisiones (superficie oscura) -->
          {salas.length > 0 && (
            <section class="mi-card mi-decisions">
              <div class="mi-card-head">
                <div><h2>{dash.decisionsTitle}</h2><p class="mi-card-sub">{dash.decisionsSub}</p></div>
                <a class="mi-see" href="/decidir">Ver todas →</a>
              </div>
              <div class="mi-dec-grid">
                {salas.map((r) => (
                  <a class="mi-dec" href={`/decidir/${r.slug}`}>
                    <span class="mi-dec-eyebrow">{SALA_EYEBROW[r.slug] || r.category}</span>
                    <b>{r.h1}</b>
                    <span class="mi-dec-cta">Entrar a la sala →</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- Actividad reciente -->
          <section class="mi-card mi-activity">
            <div class="mi-card-head">
              <div><h2>Actividad reciente</h2><p class="mi-card-sub">Resultados guardados en este producto.</p></div>
              <a class="mi-see" href="/mi">Ver historial →</a>
            </div>
            <ul class="mi-act-list" data-history-list hidden></ul>
            <p class="mi-empty" data-history-empty>Todavía no calculaste nada en este producto. Abrí una herramienta y tu resultado va a aparecer acá.</p>
            <div class="mi-act-foot">
              <span>Exportá tus datos o llevate un resumen.</span>
              <div class="mi-act-btns">
                <button type="button" class="mi-btn" data-export-json>Descargar JSON</button>
                <button type="button" class="mi-btn" data-export-print>Imprimir / PDF</button>
              </div>
            </div>
          </section>
        </div>

        <aside class="mi-col-side">
          <!-- Datos / perfil -->
          <section class="mi-card mi-profile">
            <div class="mi-side-head">
              <div>
                <h2>{dash.profileTitle}</h2>
                <span class="mi-side-sub" data-estado-progress>0 de {estadoFields.length} completos</span>
              </div>
              <span class="mi-ring" data-ring aria-hidden="true">
                <svg viewBox="0 0 44 44">
                  <circle class="mi-ring-bg" cx="22" cy="22" r="19" />
                  <circle class="mi-ring-fg" cx="22" cy="22" r="19" data-ring-fg />
                </svg>
                <b data-ring-pct>0%</b>
              </span>
            </div>
            <ul class="mi-fields" data-estado-list>
              {estadoFields.map((f) => (
                <li class="mi-field" data-estado-key={f.key}>
                  <span class="mi-field-label">{f.label}</span>
                  <a class="mi-field-edit" href={editHref}>Editar</a>
                  <span class="mi-field-val" data-estado-value>—</span>
                </li>
              ))}
            </ul>
            <a class="mi-side-cta" href={editHref}>Editar perfil de {product.name} →</a>
          </section>

          <!-- Alertas -->
          <section class="mi-card mi-alerts">
            <div class="mi-side-head">
              <h2>Tus alertas</h2>
              <a class="mi-see" href="/alertas">Configurar</a>
            </div>
            <p class="mi-side-sub2">Avisos que realmente importan.</p>
            <div class="mi-alert-authed" data-alerts-authed hidden>
              <ul class="mi-alert-list" data-alerts-list></ul>
              <p class="mi-empty" data-alerts-empty hidden>Todavía no tenés alertas acá. Activá una desde cualquier herramienta, después de calcular.</p>
            </div>
            <div class="mi-alert-preview" data-alerts-preview>
              <span class="mi-alert-ic" aria-hidden="true" set:html={ICONS[dash.alertPreview.icon]} />
              <span class="mi-alert-txt"><strong>{dash.alertPreview.title}</strong><small>{dash.alertPreview.sub}</small></span>
            </div>
            <label class="mi-toggle">
              <span>Recibir por email</span>
              <input type="checkbox" data-email-toggle checked />
              <span class="mi-toggle-track" aria-hidden="true"></span>
            </label>
          </section>

          <!-- Privacidad -->
          <section class="mi-card mi-privacy">
            <h2>Privacidad</h2>
            <p class="mi-side-sub2">{dash.privacyNote}</p>
            <div class="mi-priv-rows">
              <div class="mi-priv-row"><span>Sincronización</span><b>Cuenta + dispositivo</b></div>
              <div class="mi-priv-row"><span>Montos en analytics</span><b>No se envían</b></div>
            </div>
            <a class="mi-side-cta" href={editHref}>Administrar mis datos →</a>
          </section>
        </aside>
      </div>
    </div>
  </div>

  <script type="application/json" data-product-config set:html={clientConfig}></script>

  <script is:inline>
  (function () {
    var cfgEl = document.querySelector('[data-product-config]');
    if (!cfgEl) return;
    var CFG;
    try { CFG = JSON.parse(cfgEl.textContent || '{}'); } catch (e) { return; }
    var root = document.querySelector('.mi-dash');
    if (!root) return;

    var MONTHS = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    var MONTHS_ABBR = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];

    function isAuthed() { return /(^|;)\s*hc_authed=1(;|$)/.test(document.cookie); }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function cssEsc(s) { return String(s).replace(/[^a-zA-Z0-9_.-]/g, '\\$&'); }

    function fmtNumber(v) {
      var n = typeof v === 'number' ? v : Number(String(v).replace(/\./g, '').replace(',', '.'));
      if (!isNaN(n) && String(v).trim() !== '') return n.toLocaleString('es-AR');
      return String(v);
    }
    function fmtField(f, raw) {
      if (raw === undefined || raw === null || raw === '') return null;
      if (f.options) {
        for (var i = 0; i < f.options.length; i++) if (String(f.options[i].value) === String(raw)) return f.options[i].label;
      }
      if (f.type === 'boolean') return (raw === true || raw === 'true' || raw === 'si') ? 'Sí' : 'No';
      if (f.type === 'number') return (f.unit === '$' ? '$ ' : '') + fmtNumber(raw) + (f.unit && f.unit !== '$' ? ' ' + f.unit : '');
      return String(raw);
    }
    function profileGet(key) {
      try { return window.HCProfile ? window.HCProfile.get(key) : undefined; } catch (e) { return undefined; }
    }
    function metricByKey(key) {
      var arr = CFG.keyMetrics || [];
      for (var i = 0; i < arr.length; i++) if (arr[i].key === key) return arr[i];
      return null;
    }

    // ── Próximos hitos ───────────────────────────────────────
    function stripTime(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
    function daysUntil(d, now) { return Math.round((stripTime(d) - stripTime(now)) / 86400000); }
    function nextOccurrence(rule, now) {
      var y = now.getFullYear();
      function mk(yy, mm, dd) { return new Date(yy, mm, dd); }
      function lastDay(yy, mm) { return new Date(yy, mm + 1, 0); }
      if (rule.type === 'monthly-last') {
        var d = lastDay(now.getFullYear(), now.getMonth());
        if (d < stripTime(now)) d = lastDay(now.getFullYear(), now.getMonth() + 1);
        return d;
      }
      if (rule.type === 'monthly-day') {
        var d2 = mk(now.getFullYear(), now.getMonth(), rule.day);
        if (d2 < stripTime(now)) d2 = mk(now.getFullYear(), now.getMonth() + 1, rule.day);
        return d2;
      }
      if (rule.type === 'yearly') {
        var d3 = mk(y, rule.month - 1, rule.day);
        if (d3 < stripTime(now)) d3 = mk(y + 1, rule.month - 1, rule.day);
        return d3;
      }
      if (rule.type === 'biyearly') {
        var cands = [mk(y, rule.month1 - 1, rule.day), mk(y, rule.month2 - 1, rule.day), mk(y + 1, rule.month1 - 1, rule.day)];
        var t = stripTime(now);
        for (var i = 0; i < cands.length; i++) if (cands[i] >= t) return cands[i];
        return cands[cands.length - 1];
      }
      return now;
    }
    function nearestMilestone() {
      var now = new Date();
      var items = (CFG.milestones || []).map(function (m) {
        var d = nextOccurrence(m.rule, now);
        return { m: m, d: d, days: daysUntil(d, now) };
      }).sort(function (a, b) { return a.d - b.d; });
      return items.length ? items[0] : null;
    }
    function renderNext() {
      var box = root.querySelector('[data-next-box]');
      var empty = root.querySelector('[data-next-empty]');
      var it = nearestMilestone();
      if (!it) { if (box) box.hidden = true; if (empty) empty.hidden = false; return; }
      if (empty) empty.hidden = true;
      if (!box) return;
      box.hidden = false;
      root.querySelector('[data-next-mon]').textContent = MONTHS_ABBR[it.d.getMonth()];
      root.querySelector('[data-next-day]').textContent = String(it.d.getDate()).padStart(2, '0');
      root.querySelector('[data-next-title]').textContent = it.m.label;
      var countdown = it.days === 0 ? 'Es hoy.' : it.days === 1 ? 'Falta 1 día.' : 'Faltan ' + it.days + ' días.';
      root.querySelector('[data-next-detail]').textContent = countdown + ' ' + it.m.detail;
      var cta = root.querySelector('[data-next-cta]');
      if (cta) { if (it.m.toolSlug) { cta.href = '/' + it.m.toolSlug; cta.hidden = false; } else { cta.hidden = true; } }
      return it;
    }

    // ── Stat cards + hero situación ──────────────────────────
    function renderStats(nearest) {
      var cards = root.querySelectorAll('.mi-stat');
      (CFG.stats || []).forEach(function (s, i) {
        var card = cards[i];
        if (!card) return;
        var valEl = card.querySelector('[data-stat-val]');
        var actEl = card.querySelector('[data-stat-act]');
        if (s.kind === 'metric') {
          var m = metricByKey(s.metricKey);
          var raw = profileGet(s.metricKey);
          if (m && raw !== undefined && raw !== null && raw !== '') {
            valEl.textContent = fmtField({ type: m.type, unit: m.unit, options: m.options }, raw);
            valEl.classList.add('is-set');
          } else { valEl.textContent = '—'; valEl.classList.remove('is-set'); }
        } else if (s.kind === 'milestone') {
          if (nearest) {
            valEl.textContent = String(nearest.d.getDate()) + ' ' + MONTHS_ABBR[nearest.d.getMonth()].toLowerCase();
            valEl.classList.add('is-set');
            var sub = card.querySelector('[data-stat-sub]');
            if (sub) sub.textContent = nearest.m.label;
            if (actEl && nearest.m.toolSlug) actEl.href = '/' + nearest.m.toolSlug;
          } else { valEl.textContent = '—'; }
        }
        // 'tools' ya viene renderizado server-side (count fijo).
      });
    }
    function renderSituation() {
      var el = root.querySelector('[data-sit-primary]');
      if (!el || !CFG.situation || !CFG.situation.primaryKey) return;
      var f = null, ks = CFG.profileKeys || [];
      for (var i = 0; i < ks.length; i++) if (ks[i].key === CFG.situation.primaryKey) { f = ks[i]; break; }
      var raw = profileGet(CFG.situation.primaryKey);
      var disp = f ? fmtField(f, raw) : (raw != null ? String(raw) : null);
      if (disp) el.textContent = disp;
    }

    // ── Sidebar: perfil (rows + ring) ────────────────────────
    function renderEstado() {
      var loaded = 0, total = (CFG.profileKeys || []).length;
      (CFG.profileKeys || []).forEach(function (f) {
        var raw = profileGet(f.key);
        var disp = fmtField(f, raw);
        var row = root.querySelector('[data-estado-key="' + cssEsc(f.key) + '"] [data-estado-value]');
        if (row) {
          if (disp !== null) { row.textContent = disp; row.classList.add('is-set'); loaded++; }
          else { row.textContent = 'Sin cargar'; row.classList.remove('is-set'); }
        }
      });
      var prog = root.querySelector('[data-estado-progress]');
      if (prog) prog.textContent = loaded + ' de ' + total + ' completos';
      var pct = total ? Math.round((loaded / total) * 100) : 0;
      var ringPct = root.querySelector('[data-ring-pct]');
      if (ringPct) ringPct.textContent = pct + '%';
      var fg = root.querySelector('[data-ring-fg]');
      if (fg) { var C = 2 * Math.PI * 19; fg.style.strokeDasharray = C.toFixed(1); fg.style.strokeDashoffset = (C * (1 - pct / 100)).toFixed(1); }
      // Pill "Perfil completo/incompleto"
      var pill = root.querySelector('[data-pill-perfil-txt]');
      if (pill) pill.textContent = (pct >= 100 ? 'Perfil completo' : pct > 0 ? 'Perfil ' + pct + '%' : 'Perfil por completar');
    }

    // ── Alertas ──────────────────────────────────────────────
    async function loadAlerts() {
      var authedBox = root.querySelector('[data-alerts-authed]');
      var preview = root.querySelector('[data-alerts-preview]');
      var pillAl = root.querySelector('[data-pill-alertas]');
      if (!isAuthed()) return; // desloguéado: se muestra la preview estática
      try {
        var res = await fetch('/api/alerts/mine', { credentials: 'same-origin' });
        if (!res.ok) return;
        var data = await res.json();
        var setSlugs = {};
        (CFG.alertSlugs || []).forEach(function (s) { setSlugs[s] = 1; });
        var mine = (data.alerts || []).filter(function (a) { return setSlugs[a.slug]; });
        if (mine.length === 0) return; // sin alertas propias: dejamos la preview
        if (authedBox) authedBox.hidden = false;
        if (preview) preview.hidden = true;
        var list = root.querySelector('[data-alerts-list]');
        var empty = root.querySelector('[data-alerts-empty]');
        if (empty) empty.hidden = true;
        if (list) list.innerHTML = '';
        mine.forEach(function (a) {
          var li = document.createElement('li');
          li.className = 'mi-alert-item';
          var changed = a.last_changed_at ? 'changed' : 'stable';
          li.innerHTML =
            '<span class="mi-alert-txt"><a class="mi-alert-link" href="/' + esc(a.slug) + '">' + esc(a.headline_label || 'Resultado') + '</a>' +
            '<small>' + esc(a.last_headline || '') + '</small></span>' +
            '<span class="mi-alert-state mi-alert-state--' + changed + '">' + (a.last_changed_at ? 'cambió' : 'sin cambios') + '</span>';
          if (list) list.appendChild(li);
        });
        if (pillAl) pillAl.hidden = false;
      } catch (e) { /* dejamos la preview */ }
    }

    // ── Actividad reciente (localStorage hc-history-<slug>) ──
    function relTime(ts) {
      var s = Math.floor((Date.now() - ts) / 1000);
      if (s < 60) return 'recién';
      var m = Math.floor(s / 60); if (m < 60) return 'hace ' + m + ' min';
      var h = Math.floor(m / 60); if (h < 24) return 'hace ' + h + ' h';
      var d = Math.floor(h / 24); if (d < 30) return 'hace ' + d + (d === 1 ? ' día' : ' días');
      return 'hace tiempo';
    }
    function renderHistory() {
      var list = root.querySelector('[data-history-list]');
      var empty = root.querySelector('[data-history-empty]');
      if (!list) return;
      var all = [];
      (CFG.tools || []).forEach(function (t) {
        var arr = [];
        try { arr = JSON.parse(localStorage.getItem('hc-history-' + t.slug) || '[]'); } catch (e) {}
        arr.forEach(function (e2) { all.push({ slug: t.slug, label: t.label, primary: e2.primary, sub: e2.label, ts: e2.ts }); });
      });
      all.sort(function (a, b) { return b.ts - a.ts; });
      all = all.slice(0, 6);
      if (all.length === 0) { list.hidden = true; if (empty) empty.hidden = false; return; }
      if (empty) empty.hidden = true;
      list.hidden = false;
      list.innerHTML = '';
      all.forEach(function (e2) {
        var li = document.createElement('li');
        li.className = 'mi-act-item';
        li.innerHTML =
          '<span class="mi-act-ic" aria-hidden="true">↗</span>' +
          '<span class="mi-act-body"><a class="mi-act-tool" href="/' + esc(e2.slug) + '">' + esc(e2.label) + '</a>' +
          '<small>' + relTime(e2.ts) + (e2.sub ? ' · ' + esc(e2.sub) : '') + '</small></span>' +
          '<span class="mi-act-val">' + esc(e2.primary) + '</span>';
        list.appendChild(li);
      });
    }

    // ── Exportación ──────────────────────────────────────────
    function collectExport() {
      var profile = {};
      (CFG.profileKeys || []).forEach(function (f) { var v = profileGet(f.key); if (v !== undefined && v !== '') profile[f.key] = v; });
      var history = {};
      (CFG.tools || []).forEach(function (t) {
        try { var arr = JSON.parse(localStorage.getItem('hc-history-' + t.slug) || '[]'); if (arr.length) history[t.slug] = arr; } catch (e) {}
      });
      return { producto: CFG.name, slug: CFG.slug, exportadoEl: new Date().toISOString(), perfil: profile, historial: history };
    }
    function wireExport() {
      var jb = root.querySelector('[data-export-json]');
      if (jb) jb.addEventListener('click', function () {
        var blob = new Blob([JSON.stringify(collectExport(), null, 2)], { type: 'application/json' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url; a.download = 'mi-' + CFG.slug + '-hacecuentas.json';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      });
      var pb = root.querySelector('[data-export-print]');
      if (pb) pb.addEventListener('click', function () { window.print(); });
    }

    // ── Toggle "Recibir por email" (preferencia local) ───────
    function wireToggle() {
      var t = root.querySelector('[data-email-toggle]');
      if (!t) return;
      var KEY = 'hc-alert-email-' + CFG.slug;
      try { var saved = localStorage.getItem(KEY); if (saved !== null) t.checked = saved === '1'; } catch (e) {}
      t.addEventListener('change', function () { try { localStorage.setItem(KEY, t.checked ? '1' : '0'); } catch (e) {} });
    }

    function renderProfileBits() {
      renderEstado();
      var nearest = renderNext();
      renderStats(nearest);
      renderSituation();
    }

    function init() {
      renderProfileBits();
      renderHistory();
      wireExport();
      wireToggle();
      loadAlerts();
      if (isAuthed()) {
        fetch('/api/profile', { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (data) {
          if (data && data.profile && window.HCProfile) {
            Object.keys(data.profile).forEach(function (k) { try { window.HCProfile.set(k, data.profile[k], 'profile'); } catch (e) {} });
            renderProfileBits();
          }
        }).catch(function () {});
      }
      window.addEventListener('hc-profile-change', renderProfileBits);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
  </script>

  <Footer slot="footer" />
</Layout>

<style>
