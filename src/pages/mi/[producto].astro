  .mi-side-cta { display: inline-block; font-size: 0.875rem; font-weight: 600; color: var(--p-accent); text-decoration: none; }
  .mi-side-cta:hover { text-decoration: underline; }

  /* Alertas */
  .mi-alert-preview, .mi-alert-item { display: flex; align-items: flex-start; gap: 0.7rem; padding: 0.85rem; border-radius: 11px; background: color-mix(in srgb, var(--success) 9%, var(--bg-card)); border: 1px solid color-mix(in srgb, var(--success) 22%, var(--border)); }
  .mi-alert-ic { width: 32px; height: 32px; flex-shrink: 0; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--success) 16%, var(--bg-card)); color: var(--success-text); }
  .mi-alert-ic :global(svg) { width: 17px; height: 17px; }
  .mi-alert-txt { display: flex; flex-direction: column; min-width: 0; gap: 0.1rem; }
  .mi-alert-txt strong, .mi-alert-link { font-size: 0.875rem; font-weight: 600; color: var(--text); text-decoration: none; }
  .mi-alert-txt small { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.4; }
  .mi-alert-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .mi-alert-state { margin-left: auto; align-self: center; font-size: 0.6875rem; font-weight: 600; padding: 0.1rem 0.45rem; border-radius: 999px; }
  .mi-alert-state--stable { background: var(--bg-muted); color: var(--text-muted); }
  .mi-alert-state--changed { background: color-mix(in srgb, var(--p-accent) 18%, transparent); color: var(--p-accent); }

