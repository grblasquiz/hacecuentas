---
export const prerender = true;
import FeriadosLanding from '../components/FeriadosLanding.astro';
import { FERIADOS_LATAM_2027 } from '../lib/data/feriados-latam-2027';

const related = [
  { href: '/dias-entre-dos-fechas', label: 'Días entre dos fechas' },
  { href: '/calculadora-cuenta-regresiva-dias-faltan', label: 'Cuenta regresiva: cuántos días faltan' },
  { href: '/fechas/feriados', label: 'Días hábiles que quedan en el año (Argentina)' },
  { href: '/trabajo/vacaciones', label: 'Armá tu puente óptimo con tus vacaciones' },

  // Cluster de feriados 2027 ↔ 2026: la versión vigente le pasa autoridad a la
  // del año siguiente y viceversa (mismo patrón que el cluster 2026).
  { href: '/fechas/feriados', label: 'Feriados Argentina 2026' },
  { href: '/feriados-2027', label: 'Feriados 2027 en todos los países' },
];

const title = 'Feriados Argentina 2027: calendario y puentes';
const description = 'Feriados de Argentina 2027 según la normativa vigente, Carnaval, fines de semana largos y puentes. Días turísticos y traslados pendientes de definición oficial.';
---
<FeriadosLanding data={FERIADOS_LATAM_2027.argentina} related={related} title={title} description={description} anio={2027} />
