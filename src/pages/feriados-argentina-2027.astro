---
export const prerender = true;
import FeriadosLanding from '../components/FeriadosLanding.astro';
import { FERIADOS_LATAM_2027 } from '../lib/data/feriados-latam-2027';

const related = [
  { href: '/fechas/dias-entre-fechas', label: 'Días entre dos fechas' },
  { href: '/fechas/cuenta-regresiva', label: 'Cuenta regresiva: cuántos días faltan' },
  { href: '/fechas/feriados', label: 'Días hábiles que quedan en el año (Argentina)' },
  { href: '/trabajo/vacaciones', label: 'Armá tu puente óptimo con tus vacaciones' },

  // Cluster de feriados 2027 ↔ 2026: la versión vigente le pasa autoridad a la
  // del año siguiente y viceversa (mismo patrón que el cluster 2026).
  { href: '/fechas/feriados', label: 'Feriados Argentina 2026' },
  { href: '/feriados-2027', label: 'Feriados 2027 en todos los países' },
];

const title = 'Feriados Argentina 2027: Carnaval y fines de semana largos';
const description = 'Carnaval 2027: lunes 8 y martes 9 de febrero. Consultá el calendario de feriados de Argentina, fines de semana largos y días turísticos aún pendientes.';
const extraFaq = [
  { q: '¿Cuándo es Carnaval 2027 en Argentina?', a: 'Carnaval es el lunes 8 y el martes 9 de febrero de 2027. Son feriados nacionales inamovibles por la Ley 27.399. Junto al sábado 6 y domingo 7 forman cuatro días seguidos para quienes descansan esos días, sin pedir un día de vacaciones.' },
  { q: '¿Cuándo cae Semana Santa 2027 y qué días son feriados?', a: 'El Viernes Santo cae el 26 de marzo de 2027 y es feriado nacional. El Jueves Santo, 25 de marzo, es día no laborable: no tiene el mismo régimen que un feriado. El domingo de Pascua es el 28 de marzo.' },
  { q: '¿El calendario de feriados 2027 ya incluye los puentes turísticos oficiales?', a: 'La tabla distingue los feriados establecidos por ley de los días con fines turísticos. Estos últimos solo se incorporan cuando se publica la norma correspondiente; pedir licencia para unir un martes o jueves con el fin de semana no convierte ese día en feriado oficial. Revisá las fuentes y la fecha de actualización de esta página.' },
];
---
<FeriadosLanding data={FERIADOS_LATAM_2027.argentina} related={related} title={title} description={description} anio={2027} extraFaq={extraFaq} />
