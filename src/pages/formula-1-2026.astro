---
// @incremental-standalone — landing estática aislada; habilita deploy incremental.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/live/formula-1-2026.json';

const AR = 'America/Argentina/Buenos_Aires';
const now = new Date();
const races = data.races || [];
const nextRace = races.find((r: any) => !r.cancelled && new Date(r.end) >= now) || races[races.length - 1];
const weekend = (data.weekendSessions || []).filter((s: any) => s.meetingKey === nextRace?.meetingKey).sort((a: any, b: any) => a.start.localeCompare(b.start));
const nextSession = weekend.find((s: any) => new Date(s.end) >= now) || weekend[weekend.length - 1];
const upcomingRaces = races.filter((r: any) => !r.cancelled && new Date(r.end) >= now).slice(0, 5);
const fmt = (iso: string, options: Intl.DateTimeFormatOptions = {}) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, ...options }).format(new Date(iso));
const day = (iso: string) => fmt(iso, { weekday: 'short', day: 'numeric', month: 'short' }).replace('.', '').toUpperCase();
const fullDate = (iso: string) => fmt(iso, { weekday: 'long', day: 'numeric', month: 'long' });
const time = (iso: string) => fmt(iso, { hour: '2-digit', minute: '2-digit', hour12: false });
const flag = (code: string) => ({ AUS:'🇦🇺', CHN:'🇨🇳', JPN:'🇯🇵', BRN:'🇧🇭', KSA:'🇸🇦', USA:'🇺🇸', CAN:'🇨🇦', MON:'🇲🇨', ESP:'🇪🇸', AUT:'🇦🇹', GBR:'🇬🇧', BEL:'🇧🇪', HUN:'🇭🇺', NED:'🇳🇱', ITA:'🇮🇹', AZE:'🇦🇿', SGP:'🇸🇬', MEX:'🇲🇽', BRA:'🇧🇷', QAT:'🇶🇦', ARE:'🇦🇪' } as Record<string, string>)[code] || '🏁';
const country = (name: string) => ({ 'United Kingdom':'Reino Unido', 'United States':'Estados Unidos', Belgium:'Bélgica', Spain:'España', Netherlands:'Países Bajos', Hungary:'Hungría', Austria:'Austria', Italy:'Italia', Azerbaijan:'Azerbaiyán', Singapore:'Singapur', Mexico:'México', Brazil:'Brasil', Canada:'Canadá', Australia:'Australia', China:'China', Japan:'Japón', Bahrain:'Baréin', 'Saudi Arabia':'Arabia Saudita', Qatar:'Qatar', 'United Arab Emirates':'Emiratos Árabes Unidos', Monaco:'Mónaco' } as Record<string, string>)[name] || name;
const sessionLabel = (name: string) => name === 'Qualifying' ? 'Clasificación' : name === 'Sprint' ? 'Sprint' : 'Carrera';
const sessionIcon = (name: string) => name === 'Qualifying' ? '⌁' : name === 'Sprint' ? '◉' : '⚑';
const title = 'Fórmula 1 2026: calendario, próximos GP y resultados | Hacé Cuentas';
const description = 'SeguÍ cada fin de semana de Fórmula 1: clasificación, sprint, carrera, horarios y tabla de pilotos actualizada.';
const schema = { '@context':'https://schema.org', '@graph': [
  { '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem', position:1, name:'Inicio', item:'https://hacecuentas.com/' }, { '@type':'ListItem', position:2, name:'Fórmula 1 2026', item:'https://hacecuentas.com/formula-1-2026' }] },
  { '@type':'SportsEvent', name:'Campeonato Mundial de Fórmula 1 2026', sport:'Formula 1', startDate:races[0]?.start, endDate:races.at(-1)?.end, organizer:{'@type':'Organization',name:'FIA'}, url:'https://hacecuentas.com/formula-1-2026' },
  { '@type':'Dataset', name:'Calendario y resultados Fórmula 1 2026', creator:{'@type':'Organization',name:'Hacé Cuentas'}, isBasedOn:'https://openf1.org/', dateModified:data.fetchedAt, url:'https://hacecuentas.com/formula-1-2026' },
] };
---
<Layout title={title} description={description} canonical="/formula-1-2026" audience="global" schema={schema} domain="life">
  <Header />
  <main class="article-main"><article class="f1" data-f1>
    <header class="f1-head"><a href="/formula-1-2026" class="f1-kicker"><i></i> Fórmula 1 2026</a><div class="f1-head-row"><div><h1>GP de {country(nextRace?.country || 'F1')}</h1><p>{nextRace?.circuit} <span>•</span> {fmt(nextRace?.start, { day:'numeric', month:'long' })} al {fmt(nextRace?.end, { day:'numeric', month:'long' })}</p></div><label class="f1-zone"><span>HORARIO</span> 🇦🇷 <select data-zone><option value="America/Argentina/Buenos_Aires">Argentina (GMT-3)</option><option value="America/Mexico_City">México</option><option value="America/Bogota">Colombia</option><option value="America/Santiago">Chile</option><option value="Europe/Madrid">España</option></select></label></div></header>

    <div class="f1-grid">
      <section class="f1-weekend"><div class="f1-title"><h2>Race Weekend</h2><span>Todos los horarios en tu zona</span></div><div class="f1-track">{weekend.map((s: any) => <article class:list={['f1-session', { active: s.sessionKey === nextSession?.sessionKey, done: new Date(s.end) < now }]}><time>{day(s.start)}</time><span class="f1-dot">{sessionIcon(s.name)}</span><div><strong>{sessionLabel(s.name)}</strong><small>{s.sessionKey === nextSession?.sessionKey ? 'Próxima sesión' : new Date(s.end) < now ? 'Sesión completada' : 'Próximamente'}</small></div><div class="f1-session-time"><small>INICIO</small><b data-datetime={s.start}>{time(s.start)}</b></div></article>)}</div></section>
      <aside class="f1-next" data-session={nextSession?.sessionKey}><span>PRÓXIMA SESIÓN</span><h2>{sessionLabel(nextSession?.name || 'Carrera')}</h2><p data-datetime={nextSession?.start}>{fullDate(nextSession?.start)} · {time(nextSession?.start)}</p><hr /><small>FALTAN</small><strong data-countdown={nextSession?.start}></strong><div class="f1-circuit" aria-hidden="true"><i></i><i></i><i></i></div><a href="#calendario">Ver calendario completo <b>→</b></a></aside>
    </div>

    <div class="f1-lower">
      <section class="f1-table"><div class="f1-title"><h2>Tabla de pilotos</h2><a href="#pilotos">Ver campeonato completo <b>→</b></a></div><div class="f1-table-head"><span>POS</span><span>PILOTO</span><span>EQUIPO</span><span>PTS</span></div>{data.standings.slice(0,5).map((r: any, i: number) => <div class="f1-driver"><b>{i+1}</b><strong>{r.name || `#${r.driverNumber}`}</strong><span>{r.team}</span><em>{r.points}</em></div>)}</section>
      <section id="calendario" class="f1-calendar"><div class="f1-title"><h2>Calendario</h2><button data-show-calendar>Ver calendario completo <b>→</b></button></div><div class="f1-calendar-list">{upcomingRaces.map((r: any) => <article class:list={{active:r.meetingKey === nextRace?.meetingKey}}><b>{r.countryCode}</b><small>{fmt(r.start,{day:'numeric',month:'short'}).replace('.','')} – {fmt(r.end,{day:'numeric',month:'short'}).replace('.','')}</small><span>{flag(r.countryCode)}</span><em>{r.circuit}</em></article>)}</div></section>
    </div>

    <section id="pilotos" class="f1-details"><details><summary>Calendario completo y horarios <span>⌄</span></summary>{races.map((r: any, i: number) => <p><b>{String(i+1).padStart(2,'0')}</b> {flag(r.countryCode)} GP de {country(r.country)} <time data-datetime={r.start}>{fullDate(r.start)} · {time(r.start)}</time></p>)}</details><details><summary>Resultados, clasificaciones y sprints <span>⌄</span></summary>{[...(data.sessions || [])].reverse().slice(0,15).map((s: any) => { const r = races.find((x: any) => x.meetingKey === s.meetingKey); return <p>{flag(r?.countryCode)} <b>{sessionLabel(s.name)}</b> · GP de {country(r?.country || 'F1')}</p>})}</details></section>
  </article></main>
  <Footer />
</Layout>
<script is:inline>
  const root = document.querySelector('[data-f1]'); if (root) {
    let tz = 'America/Argentina/Buenos_Aires'; const zone = root.querySelector('[data-zone]');
    const renderDates = () => root.querySelectorAll('[data-datetime]').forEach(el => { const d = new Date(el.dataset.datetime); el.textContent = new Intl.DateTimeFormat('es-AR',{timeZone:tz,weekday:'short',day:'numeric',month:'short',hour:'2-digit',minute:'2-digit',hour12:false}).format(d).replace('.',''); });
    zone?.addEventListener('change', () => { tz = zone.value; renderDates(); });
    root.querySelectorAll('[data-countdown]').forEach(el => { const tick=()=>{ const x=Math.max(0,new Date(el.dataset.countdown)-Date.now()), d=Math.floor(x/864e5),h=Math.floor(x%864e5/36e5),m=Math.floor(x%36e5/6e4); el.textContent=x?d+' d '+h+' h '+m+' min':'En curso'; }; tick(); setInterval(tick,60000); });
    root.querySelector('[data-show-calendar]')?.addEventListener('click', () => root.querySelector('#pilotos details')?.setAttribute('open',''));
    renderDates();
  }
</script>
<style>
  .f1{max-width:1180px;margin:auto;padding:34px 20px 76px;color:#141414;font-family:Arial,sans-serif}.f1-head{border-bottom:1px solid #d4d4d4;padding-bottom:27px}.f1-kicker{align-items:center;color:#e10600;display:inline-flex;font-size:12px;font-weight:900;gap:8px;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.f1-kicker i{background:#e10600;border-radius:50%;height:8px;width:8px}.f1-head-row{align-items:end;display:flex;gap:24px;justify-content:space-between}.f1 h1{font-size:clamp(48px,6vw,78px);font-weight:900;letter-spacing:-.075em;line-height:.86;margin:13px 0 13px}.f1-head p{color:#676767;font-size:16px;margin:0}.f1-head p span{color:#aaa;padding:0 9px}.f1-zone{align-items:center;border:1px solid #d6d6d6;display:flex;font-size:13px;gap:7px;padding:11px 12px;white-space:nowrap}.f1-zone span{color:#8a8a8a;font-size:9px;font-weight:900;letter-spacing:.08em}.f1-zone select{appearance:none;background:transparent;border:0;font:700 13px Arial,sans-serif;max-width:160px}.f1-grid{display:grid;gap:30px;grid-template-columns:minmax(0,1.72fr) minmax(310px,.88fr);padding-top:31px}.f1-title{align-items:end;border-bottom:1px solid #d8d8d8;display:flex;gap:14px;justify-content:space-between;padding-bottom:11px}.f1-title h2{font-size:22px;font-weight:900;letter-spacing:-.05em;margin:0}.f1-title span{color:#777;font-size:11px}.f1-title a,.f1-title button{background:none;border:0;color:#e10600;cursor:pointer;font:900 10px Arial,sans-serif;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;white-space:nowrap}.f1-title b{font-size:16px;margin-left:5px}.f1-track{background:#181818;margin-top:18px;overflow:hidden}.f1-session{align-items:center;border-bottom:1px solid #414141;color:#fff;display:grid;grid-template-columns:112px 78px 1fr 100px;min-height:107px;position:relative}.f1-session:last-child{border:0}.f1-session time{color:#bfbfbf;font-size:11px;font-weight:900;padding-left:21px}.f1-dot{border:2px solid #7b7b7b;border-radius:50%;color:#ddd;display:grid;font-size:21px;height:50px;place-items:center;position:relative;width:50px}.f1-dot:after{background:#777;content:'';height:57px;left:23px;position:absolute;top:48px;width:1px}.f1-session:last-child .f1-dot:after{display:none}.f1-session strong{display:block;font-size:27px;font-weight:900;letter-spacing:-.055em;line-height:1}.f1-session small{color:#aaa;display:block;font-size:11px;margin-top:6px}.f1-session-time{padding-right:21px;text-align:right}.f1-session-time small{font-size:9px;font-weight:900;letter-spacing:.08em;margin:0}.f1-session-time b{font-size:25px;letter-spacing:-.06em}.f1-session.active{background:linear-gradient(90deg,#4a0808 0%,#251212 45%,#1b1b1b 100%);box-shadow:inset 6px 0 #e10600}.f1-session.active time,.f1-session.active strong,.f1-session.active .f1-session-time b{color:#ff312a}.f1-session.active .f1-dot{background:#e10600;border-color:#f53730;box-shadow:0 0 0 8px rgba(225,6,0,.19);color:#fff}.f1-session.done{opacity:.62}.f1-next{background:#181818;border-left:6px solid #e10600;color:white;display:flex;flex-direction:column;min-height:408px;padding:28px 27px 24px}.f1-next>span,.f1-next>small{color:#ff302a;font-size:10px;font-weight:900;letter-spacing:.12em}.f1-next h2{font-size:54px;font-weight:900;letter-spacing:-.08em;line-height:.85;margin:15px 0 14px}.f1-next p{color:#bbb;font-size:12px;font-weight:700;margin:0;text-transform:uppercase}.f1-next hr{border:0;border-top:1px solid #484848;margin:31px 0 22px;width:100%}.f1-next>strong{color:#f12620;font-size:43px;font-weight:900;letter-spacing:-.09em;line-height:.95;margin-top:10px;white-space:nowrap}.f1-circuit{height:92px;margin:auto 0 17px;position:relative;width:190px}.f1-circuit:before,.f1-circuit:after,.f1-circuit i{border:2px solid #ededed;border-radius:50%;content:'';display:block;opacity:.9;position:absolute}.f1-circuit:before{height:35px;left:17px;top:29px;width:118px}.f1-circuit:after{border-left:0;border-top:0;height:49px;left:90px;top:10px;width:71px}.f1-circuit i:nth-child(1){border-right:0;height:20px;left:0;top:42px;width:29px}.f1-circuit i:nth-child(2){border-bottom:0;height:25px;left:133px;top:48px;width:41px}.f1-circuit i:nth-child(3){border-left:0;height:21px;left:38px;top:9px;width:41px}.f1-next a{border:1px solid #e10600;color:#fff;font-size:10px;font-weight:900;letter-spacing:.07em;padding:15px;text-align:left;text-decoration:none;text-transform:uppercase}.f1-next a b{float:right;font-size:17px;line-height:.5}.f1-lower{display:grid;gap:20px;grid-template-columns:.94fr 1.5fr;margin-top:29px}.f1-table,.f1-calendar{border:1px solid #d8d8d8;padding:20px}.f1-table-head,.f1-driver{align-items:center;display:grid;gap:8px;grid-template-columns:39px 1.5fr 1.1fr 38px}.f1-table-head{color:#818181;font-size:9px;font-weight:900;letter-spacing:.06em;padding:17px 0 8px}.f1-driver{border-top:1px solid #e8e8e8;font-size:12px;padding:12px 0}.f1-driver>b{border-left:3px solid #e10600;font-size:13px;padding-left:8px}.f1-driver strong{font-size:12px}.f1-driver span{color:#656565}.f1-driver em{font-size:13px;font-style:normal;font-weight:900;text-align:right}.f1-calendar-list{display:grid;gap:8px;grid-template-columns:repeat(5,1fr);margin-top:19px}.f1-calendar-list article{border:1px solid #dcdcdc;display:flex;flex-direction:column;min-height:153px;padding:12px 7px;text-align:center}.f1-calendar-list article.active{border:2px solid #e10600;box-shadow:inset 0 0 0 1px #e10600;color:#e10600}.f1-calendar-list b{font-size:13px;font-weight:900}.f1-calendar-list small{font-size:9px;margin:4px 0}.f1-calendar-list span{font-size:28px;line-height:1;margin:auto 0 9px}.f1-calendar-list em{color:#555;font-size:9px;font-style:normal;line-height:1.2}.f1-calendar-list article.active em{color:#e10600}.f1-details{margin-top:24px}.f1-details details{border-top:1px solid #d8d8d8;padding:16px 2px}.f1-details summary{cursor:pointer;display:flex;font-size:14px;font-weight:900;justify-content:space-between}.f1-details p{align-items:center;border-top:1px solid #eee;display:flex;font-size:12px;gap:10px;margin:12px 0 0;padding:10px 0}.f1-details p>b,.f1-details span{color:#e10600}.f1-details time{color:#666;font-size:11px;margin-left:auto}@media(max-width:800px){.f1-head-row{align-items:start;flex-direction:column}.f1-grid,.f1-lower{grid-template-columns:1fr}.f1-next{min-height:375px}.f1-calendar-list{grid-template-columns:repeat(3,1fr)}.f1-calendar-list article:nth-child(n+4){display:none}}@media(max-width:540px){.f1{padding:24px 14px 55px}.f1 h1{font-size:47px}.f1-head p{font-size:13px}.f1-session{grid-template-columns:71px 51px 1fr 64px;min-height:92px}.f1-session time{font-size:9px;padding-left:10px}.f1-dot{font-size:15px;height:38px;width:38px}.f1-dot:after{height:54px;left:17px;top:36px}.f1-session strong{font-size:18px}.f1-session small{font-size:9px}.f1-session-time{padding-right:9px}.f1-session-time b{font-size:17px}.f1-next h2{font-size:48px}.f1-table-head,.f1-driver{font-size:10px;grid-template-columns:30px 1.4fr .85fr 30px}.f1-driver strong{font-size:10px}.f1-calendar{padding:15px}.f1-details time{display:none}}
</style>
