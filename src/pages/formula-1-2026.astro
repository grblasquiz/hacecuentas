---
// @incremental-standalone — landing estática aislada; habilita deploy incremental.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/live/formula-1-2026.json';

const AR = 'America/Argentina/Buenos_Aires';
const now = new Date();
const races = data.races || [];
const nextRaceIndex = races.findIndex((race: any) => !race.cancelled && new Date(race.end) >= now);
const nextRace = races[nextRaceIndex >= 0 ? nextRaceIndex : races.length - 1];
const calendarRaces = nextRaceIndex > 0 ? [...races.slice(nextRaceIndex), ...races.slice(0, nextRaceIndex)] : races;
const weekend = (data.weekendSessions || []).filter((session: any) => session.meetingKey === nextRace?.meetingKey).sort((a: any, b: any) => a.start.localeCompare(b.start));
const nextSession = weekend.find((session: any) => new Date(session.end) >= now) || weekend.at(-1);
const lastRace = races.slice(0, Math.max(0, nextRaceIndex)).reverse().find((race: any) => race.results?.some((result: any) => result.position));
const lastPodium = (lastRace?.results || []).filter((result: any) => result.position > 0 && result.position <= 3).sort((a: any, b: any) => a.position - b.position).map((result: any) => ({ ...result, ...(data.drivers?.[String(result.driverNumber)] || {}) }));
const standings = data.standings || [];
const constructorMap = new Map<string, number>();
for (const driver of standings) constructorMap.set(driver.team, (constructorMap.get(driver.team) || 0) + Number(driver.points || 0));
const constructors = [...constructorMap.entries()].map(([team, points]) => ({ team, points })).sort((a, b) => b.points - a.points);
const maxConstructorPoints = constructors[0]?.points || 1;
const weekendEnd = new Date(nextRace?.start || Date.now());
const weekendStart = new Date(weekendEnd); weekendStart.setUTCDate(weekendStart.getUTCDate() - 2);

const fmt = (iso: string | Date, options: Intl.DateTimeFormatOptions = {}) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, ...options }).format(new Date(iso));
const time = (iso: string) => fmt(iso, { hour: '2-digit', minute: '2-digit', hour12: false });
const shortDay = (iso: string) => `${fmt(iso, { weekday:'short' }).replace('.','').toUpperCase()} ${fmt(iso, { day:'numeric', month:'short' }).replace('.','').toUpperCase()}`;
const fullDate = (iso: string) => fmt(iso, { weekday:'long', day:'numeric', month:'long' }).toUpperCase();
const weekendRange = `${fmt(weekendStart, { day:'numeric' })}–${fmt(weekendEnd, { day:'numeric', month:'short' }).replace('.','').toUpperCase()}`;
const raceRange = (race: any) => { const end = new Date(race.start); const start = new Date(end); start.setUTCDate(start.getUTCDate() - 2); return `${fmt(start,{day:'numeric'})}–${fmt(end,{day:'numeric',month:'short'}).replace('.','').toUpperCase()}`; };
const country = (name: string) => ({ 'United Kingdom':'Reino Unido', 'United States':'Estados Unidos', Belgium:'Bélgica', Spain:'España', Netherlands:'Países Bajos', Hungary:'Hungría', Austria:'Austria', Italy:'Italia', Azerbaijan:'Azerbaiyán', Singapore:'Singapur', Mexico:'México', Brazil:'Brasil', Canada:'Canadá', Australia:'Australia', China:'China', Japan:'Japón', Bahrain:'Baréin', 'Saudi Arabia':'Arabia Saudita', Qatar:'Qatar', 'United Arab Emirates':'Emiratos Árabes Unidos', Monaco:'Mónaco' } as Record<string,string>)[name] || name;
const flag = (code: string) => ({ AUS:'🇦🇺', CHN:'🇨🇳', JPN:'🇯🇵', BRN:'🇧🇭', KSA:'🇸🇦', USA:'🇺🇸', CAN:'🇨🇦', MON:'🇲🇨', ESP:'🇪🇸', AUT:'🇦🇹', GBR:'🇬🇧', BEL:'🇧🇪', HUN:'🇭🇺', NED:'🇳🇱', ITA:'🇮🇹', AZE:'🇦🇿', SGP:'🇸🇬', MEX:'🇲🇽', BRA:'🇧🇷', QAT:'🇶🇦', ARE:'🇦🇪' } as Record<string,string>)[code] || '🏁';
const sessionLabel = (name: string) => name === 'Qualifying' ? 'Clasificación' : name === 'Sprint' ? 'Sprint' : 'Carrera';
const teamColor = (team: string) => team?.includes('McLaren') ? '#ff8000' : team?.includes('Ferrari') ? '#e10600' : team?.includes('Red Bull') ? '#1e41ff' : team?.includes('Mercedes') ? '#00a19c' : team?.includes('Sauber') ? '#18a558' : '#777';
const trackAsset = (race: any) => {
  const circuit = String(race?.circuit || '').toLowerCase();
  const asset = circuit.includes('melbourne') ? 'melbourne' : circuit.includes('shanghai') ? 'shanghai' : circuit.includes('suzuka') ? 'suzuka' : circuit.includes('sakhir') ? 'sakhir' : circuit.includes('jeddah') ? 'jeddah' : circuit.includes('miami') ? 'miami' : circuit.includes('montreal') ? 'montreal' : circuit.includes('monte carlo') ? 'monaco' : circuit.includes('catalunya') ? 'catalunya' : circuit.includes('spielberg') ? 'spielberg' : circuit.includes('silverstone') ? 'silverstone' : circuit.includes('spa') ? 'spa' : circuit.includes('hungaroring') ? 'hungaroring' : circuit.includes('zandvoort') ? 'zandvoort' : circuit.includes('monza') ? 'monza' : circuit.includes('madring') ? 'madring' : circuit.includes('baku') ? 'baku' : circuit.includes('singapore') ? 'singapore' : circuit.includes('austin') ? 'austin' : circuit.includes('mexico') ? 'mexico-city' : circuit.includes('interlagos') ? 'interlagos' : circuit.includes('las vegas') ? 'las-vegas' : circuit.includes('lusail') ? 'lusail' : circuit.includes('yas marina') ? 'yas-marina' : 'spa';
  return `/f1-2026/circuits/${asset}.svg`;
};
const portraitPosition = (index: number) => `${['0%','33.333%','66.667%','100%'][index % 4]} ${index % 8 < 4 ? '0%' : '100%'}`;
// Fichas técnicas por circuito (longitud km, curvas, vueltas). Datos oficiales
// estables (no cambian de año a año); la distancia se deriva (km × vueltas).
// Antes: hardcodeado sólo a Bélgica → el resto de las carreras mostraba "—".
// Clave = mismo slug que trackAsset().
const CIRCUIT_SPECS: Record<string, { km: number; corners: number; laps: number }> = {
  melbourne:{km:5.278,corners:14,laps:58}, shanghai:{km:5.451,corners:16,laps:56},
  suzuka:{km:5.807,corners:18,laps:53}, sakhir:{km:5.412,corners:15,laps:57},
  jeddah:{km:6.174,corners:27,laps:50}, miami:{km:5.412,corners:19,laps:57},
  montreal:{km:4.361,corners:14,laps:70}, monaco:{km:3.337,corners:19,laps:78},
  catalunya:{km:4.657,corners:14,laps:66}, spielberg:{km:4.318,corners:10,laps:71},
  silverstone:{km:5.891,corners:18,laps:52}, spa:{km:7.004,corners:19,laps:44},
  hungaroring:{km:4.381,corners:14,laps:70}, zandvoort:{km:4.259,corners:14,laps:72},
  monza:{km:5.793,corners:11,laps:53}, baku:{km:6.003,corners:20,laps:51},
  singapore:{km:4.940,corners:19,laps:62}, austin:{km:5.513,corners:20,laps:56},
  'mexico-city':{km:4.304,corners:17,laps:71}, interlagos:{km:4.309,corners:15,laps:71},
  'las-vegas':{km:6.201,corners:17,laps:50}, lusail:{km:5.419,corners:16,laps:57},
  'yas-marina':{km:5.281,corners:16,laps:58},
};
const circuitKey = (race: any) => trackAsset(race).split('/').pop()!.replace('.svg', '');
const fmtKm = (n: number) => `${n.toFixed(3).replace('.', ',')} km`;
const nextSpec = CIRCUIT_SPECS[circuitKey(nextRace)] || null;
const circuitFacts = nextSpec
  ? [fmtKm(nextSpec.km), String(nextSpec.corners), String(nextSpec.laps), `${Math.round(nextSpec.km * nextSpec.laps)} km`]
  : ['—','—','—','—'];
const nextLaps = nextSpec?.laps ?? null;
const calDate = (iso: string) => new Date(iso).toISOString().replace(/[-:]/g,'').replace(/\.\d{3}Z$/,'Z');
const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(`GP de ${country(nextRace?.country || 'F1')}`)}&dates=${calDate(nextRace?.start)}/${calDate(nextRace?.end)}&details=${encodeURIComponent(`Fórmula 1 2026 · ${nextRace?.circuit}`)}`;
const updatedShort = `${fmt(data.fetchedAt, { day:'numeric', month:'short' }).replace('.','')} · ${time(data.fetchedAt)} hs`;

// ── SEO ──────────────────────────────────────────────────────────────────────
const PAGE_URL = 'https://hacecuentas.com/formula-1-2026';
const title = 'Fórmula 1 2026: calendario, próximos GP y resultados | Hacé Cuentas';
const description = `Calendario completo de la Fórmula 1 2026: los ${races.length} Grandes Premios con horarios en tu país, resultados en vivo y posiciones de pilotos y constructores, actualizados automáticamente al terminar cada sesión.`;
const ogTitle = 'Fórmula 1 2026: próximo GP, horarios y posiciones en vivo';
const keywords = ['fórmula 1 2026','f1 2026','calendario f1 2026','próximo gran premio','resultados f1','posiciones f1 2026','campeonato f1 pilotos','horarios f1','f1 hoy','constructores f1 2026'];
const newsKeywords = ['Fórmula 1','F1 2026','Gran Premio','resultados F1','calendario F1','campeonato de pilotos'];

const seasonStart = fmt(races[0]?.start, { day:'numeric', month:'long' });
const seasonEnd = fmt(races.at(-1)?.start, { day:'numeric', month:'long' });
const firstCountry = country(races[0]?.country || '');
const lastCountry = country(races.at(-1)?.country || '');
const leader = standings[0];

const faqs = [
  {
    q: '¿Cuándo empieza y termina la temporada 2026 de Fórmula 1?',
    a: `El campeonato 2026 tiene ${races.length} Grandes Premios. Arranca el ${seasonStart} en ${firstCountry} (${races[0]?.circuit}) y termina el ${seasonEnd} en ${lastCountry} (${races.at(-1)?.circuit}). Entre medio se corre casi cada dos fines de semana, con la novedad del debut del circuito urbano de Madrid.`,
  },
  {
    q: '¿Cuál es el próximo Gran Premio de Fórmula 1?',
    a: `El próximo es el GP de ${country(nextRace?.country || '')}, en ${nextRace?.circuit}, el fin de semana del ${weekendRange}. Es la ronda ${nextRaceIndex + 1} de ${races.length}. Arriba tenés los horarios de cada sesión (práctica, clasificación, sprint si lo hay, y carrera) en tu hora local.`,
  },
  {
    q: '¿Cómo funciona el sistema de puntos de la F1 2026?',
    a: 'En cada carrera los primeros diez suman 25, 18, 15, 12, 10, 8, 6, 4, 2 y 1 punto. En los fines de semana con Sprint, los primeros ocho de esa carrera corta suman 8, 7, 6, 5, 4, 3, 2 y 1 punto extra. Los puntos de los dos pilotos se suman por equipo para el campeonato de constructores.',
  },
  {
    q: '¿Qué es un fin de semana Sprint y en qué se diferencia?',
    a: 'En un fin de semana Sprint hay dos carreras: la Sprint (unos 100 km, el sábado) y el Gran Premio del domingo, cada una con su clasificación. Reparte más puntos en total y suele cambiar la estrategia, porque los equipos tienen menos práctica libre para poner a punto el auto.',
  },
  {
    q: '¿A qué hora se corre cada Gran Premio en mi país?',
    a: 'Con el selector de zona horaria (arriba de "Fin de semana") ves todos los horarios en tu hora local: Argentina (GMT-3), México, Colombia, Chile y España. Por defecto se muestran en hora de Argentina. Como muchos circuitos están en Europa, Asia u Oceanía, varias carreras se corren de mañana o mediodía en Sudamérica.',
  },
  {
    q: '¿Cómo van las posiciones del campeonato de pilotos y constructores?',
    a: `La tabla de arriba muestra el campeonato de pilotos y el de constructores actualizados con el último resultado.${leader ? ` En este momento el líder del campeonato de pilotos es ${leader.name} (${leader.team}) con ${leader.points} puntos.` : ''} Se recalcula solo al terminar cada carrera.`,
  },
  {
    q: '¿De dónde salen los datos y cada cuánto se actualizan?',
    a: 'El calendario, los horarios, los resultados y las posiciones vienen de OpenF1 y F1DB, proyectos de datos abiertos de Fórmula 1. Se actualizan automáticamente al finalizar cada sesión, así que no hace falta refrescar a mano: la página siempre muestra el estado más reciente del campeonato.',
  },
  {
    q: '¿Cuántas carreras tiene el calendario 2026 y qué cambió?',
    a: `El calendario 2026 tiene ${races.length} Grandes Premios en cinco continentes. La temporada estrena el reglamento técnico 2026 (nuevas unidades de potencia con más energía eléctrica y aerodinámica activa) e incorpora el circuito de Madrid. Podés ver las ${races.length} carreras completas en la sección "Calendario 2026" de esta página.`,
  },
];

const breadcrumb = {
  '@type':'BreadcrumbList',
  itemListElement: [
    { '@type':'ListItem', position:1, name:'Inicio', item:'https://hacecuentas.com/' },
    { '@type':'ListItem', position:2, name:'Deportes', item:'https://hacecuentas.com/deportes' },
    { '@type':'ListItem', position:3, name:'Fórmula 1 2026', item:PAGE_URL },
  ],
};
const sportsEvent = {
  '@type':'SportsEvent',
  name:'Campeonato Mundial de Fórmula 1 2026',
  sport:'Formula 1',
  description:`Temporada 2026 de la Fórmula 1: ${races.length} Grandes Premios entre ${firstCountry} (${seasonStart}) y ${lastCountry} (${seasonEnd}).`,
  startDate:races[0]?.start, endDate:races.at(-1)?.end,
  eventStatus:'https://schema.org/EventScheduled',
  eventAttendanceMode:'https://schema.org/OfflineEventAttendanceMode',
  organizer:{ '@type':'Organization', name:'FIA — Formula 1', url:'https://www.formula1.com' },
  url:PAGE_URL,
  subEvent: races.map((race: any) => ({
    '@type':'SportsEvent',
    name:`GP de ${country(race.country)} 2026`,
    startDate:race.start, endDate:race.end,
    eventStatus:'https://schema.org/EventScheduled',
    location:{ '@type':'Place', name:race.circuit, address:{ '@type':'PostalAddress', addressCountry:country(race.country) } },
  })),
};
const dataset = {
  '@type':'Dataset',
  name:'Calendario y resultados de la Fórmula 1 2026',
  description:'Calendario completo, horarios, resultados y posiciones de pilotos y constructores de la temporada 2026 de Fórmula 1, actualizado durante todo el campeonato.',
  license:'https://creativecommons.org/licenses/by/4.0/',
  creator:{ '@type':'Organization', name:'Hacé Cuentas', url:'https://hacecuentas.com' },
  isBasedOn:['https://openf1.org/','https://github.com/f1db/f1db'],
  temporalCoverage:`${String(races[0]?.start).slice(0,10)}/${String(races.at(-1)?.end).slice(0,10)}`,
  dateModified:data.fetchedAt,
  url:PAGE_URL,
};
const faqSchema = {
  '@type':'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a } })),
};
const schema = { '@context':'https://schema.org', '@graph':[breadcrumb, sportsEvent, dataset, faqSchema] };
---
<Layout title={title} description={description} canonical="/formula-1-2026" audience="global" schema={schema} domain="life" pageType="data" keywords={keywords} newsKeywords={newsKeywords} ogTitle={ogTitle}>
  <Header slot="header" />
  <div class="f1-app" data-f1>
    <nav class="sports-crumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/deportes">Deportes</a><span>/</span><strong>Fórmula 1</strong></nav>
    <section class="hero-grid">
      <div class="hero-copy">
        <h1><span class="kicker">Fórmula 1 2026 · Próximo Gran Premio</span>GP DE {country(nextRace?.country || 'F1').toUpperCase()}</h1>
        <p>{nextRace?.circuit} <i>·</i> {weekendRange}</p>
        <div class="hero-facts"><b>Ronda {nextRaceIndex + 1} de {races.length}</b><b>{circuitFacts[0]}</b><b>{nextLaps ? `${nextLaps} vueltas` : `${races.length} carreras`}</b></div>
        <div class="hero-actions"><a class="primary" href="#fin-de-semana"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 3.5 16 10 6 16.5Z"/></svg> SEGUIR EN VIVO</a><a class="secondary" href={googleCalendarUrl} target="_blank" rel="noopener"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12.5" rx="1.5"/><path d="M6 2.5v4M14 2.5v4M3 8h14"/></svg> AGREGAR AL CALENDARIO</a></div>
      </div>
      <figure class="hero-track" aria-label={`Trazado del circuito ${nextRace?.circuit}`}><img src={trackAsset(nextRace)} alt={`Trazado del circuito ${nextRace?.circuit}`} loading="lazy"/></figure>
      <aside class="count-card"><small>CARRERA EN</small><strong data-countdown={nextSession?.start}><span data-days-unit hidden><b data-count-days>0</b><i>d</i></span><b data-count-hours>00</b><i>h</i><b data-count-minutes>00</b><i>m</i></strong><hr/><p><svg viewBox="0 0 18 18" aria-hidden="true"><path d="M14.5 6.5A6 6 0 1 0 15 11"/><path d="m12 3.5 2.8 3.2 2.2-3.2"/></svg> Actualizado {updatedShort}</p></aside>
    </section>

    <section class="weekend-grid" id="fin-de-semana">
      <div class="weekend-card card">
        <header><h2>FIN DE SEMANA</h2><label>Horarios locales <select data-zone><option value="America/Argentina/Buenos_Aires">GMT-3</option><option value="America/Mexico_City">México</option><option value="America/Bogota">Colombia</option><option value="America/Santiago">Chile</option><option value="Europe/Madrid">España</option></select> <span class="info-icon">i</span></label></header>
        {weekend.map((session: any) => <article class:list={['weekend-row',{active:session.sessionKey===nextSession?.sessionKey}]}><span class="event-icon">{session.name === 'Sprint' ? <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="17" r="10"/><path d="M12 3h8M16 3v4M22.5 9.5 25 7M16 11v7l4 3"/></svg> : <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M9 27V6m1 2c5-4 8 4 14 0v11c-6 4-9-4-14 0z"/><path class="checks" d="M10 8h4v4h-4zm8 0h4v4h-4zm-4 4h4v4h-4zm8 4h2v3h-2zm-12 4h4v-4h-4z"/></svg>}</span><div><strong>{sessionLabel(session.name)}</strong><small>{shortDay(session.start)}</small></div><div><small>Inicio</small><b data-time={session.start}>{time(session.start)}</b></div><button type="button" class="reminder" data-reminder aria-label={`Recordar ${sessionLabel(session.name)}`}>{new Date(session.end) < now ? 'COMPLETADA' : <><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 14h10l-1.2-1.7V8a3.8 3.8 0 0 0-7.6 0v4.3zM8.5 16a1.7 1.7 0 0 0 3 0"/></svg> RECORDAR</>}</button></article>)}
        <p class="weekend-note">Activá recordatorios para no perderte ninguna sesión.</p>
      </div>
      <div class="circuit-card card">
        <header><h2>GUÍA DEL CIRCUITO</h2><p class="circuit-loc">{flag(nextRace?.countryCode)} {country(nextRace?.country || '')}</p></header>
        <figure class="circuit-visual" aria-label={`Trazado del circuito ${nextRace?.circuit}`}><img src={trackAsset(nextRace)} alt={`Trazado del circuito ${nextRace?.circuit}`} loading="lazy"/><figcaption>{nextRace?.circuit}</figcaption></figure>
        <div class="circuit-stats"><span>Longitud<b>{circuitFacts[0]}</b></span><span>Curvas<b>{circuitFacts[1]}</b></span><span>Vueltas<b>{circuitFacts[2]}</b></span><span>Distancia<b>{circuitFacts[3]}</b></span></div>
      </div>
    </section>

    <section class="last-result">
      <div><span><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M10 5h12v7c0 5-2.5 8-6 8s-6-3-6-8zM10 8H6c0 5 2 7 6 7M22 8h4c0 5-2 7-6 7M16 20v5M11 27h10"/></svg></span><small>ÚLTIMO RESULTADO<br/>GP DE {country(lastRace?.country || 'F1').toUpperCase()}</small></div>
      {lastPodium.map((driver: any) => <p><b>{driver.position}</b><strong>{driver.name?.split(' ').at(-1)}</strong><small>{driver.team}</small></p>)}
      <a href="#latest-results" data-open-results>VER RESULTADOS <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m5 2 6 6-6 6"/></svg></a>
    </section>

    <section class="championship-grid" id="campeonato">
      <div class="standings-card card">
        <h2>CAMPEONATO DE PILOTOS</h2>
        <div class="tabs" role="tablist" aria-label="Clasificación del campeonato"><button type="button" role="tab" aria-selected="true" class="active" data-tab="drivers">PILOTOS</button><button type="button" role="tab" aria-selected="false" data-tab="teams">CONSTRUCTORES</button></div>
        <div data-panel="drivers"><div class="table-head"><span>POS.</span><span>PILOTO</span><span>EQUIPO</span><span>PTS.</span></div>{standings.map((driver:any,index:number)=><div class:list={['standing-row',{extra:index>7}]}><b>{index+1}</b><i style={`--team:${teamColor(driver.team)}`}></i><span class="avatar" aria-hidden="true" style={`background-position:${portraitPosition(index)}`}></span><strong>{driver.name}</strong><span>{driver.team}</span><em>{driver.points}</em></div>)}</div>
        <div data-panel="teams" hidden>{constructors.map((team:any,index:number)=><div class="team-tab-row"><b>{index+1}</b><i style={`--team:${teamColor(team.team)}`}></i><strong>{team.team}</strong><em>{team.points}</em></div>)}</div>
        <button class="text-action" data-show-standings>VER CAMPEONATO COMPLETO ›</button>
      </div>
      <div class="constructors-card card"><h2>CAMPEONATO DE CONSTRUCTORES</h2><div class="constructors-head"><span>POS.</span><span>CONSTRUCTOR</span><span>PTS.</span></div>{constructors.map((team:any,index:number)=><article class:list={{extra:index>3}}><div><b>{index+1}</b><i style={`--team:${teamColor(team.team)}`}></i><strong>{team.team}</strong><em>{team.points}</em></div><span><i style={`--w:${team.points/maxConstructorPoints*100}%;--team:${teamColor(team.team)}`}></i></span></article>)}<button class="text-action" data-show-constructors>VER CAMPEONATO COMPLETO ›</button></div>
    </section>

    <section class="season" id="calendario">
      <header><h2>CALENDARIO 2026</h2><div class="filters" aria-label="Filtrar calendario"><button type="button" class="active" data-filter="all">Todos</button><button type="button" data-filter="next">Próximos</button><button type="button" data-filter="done">Finalizados</button><button type="button" data-filter="sprint">Sprint</button></div><button type="button" class="show-all" data-show-all><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12.5" rx="1.5"/><path d="M6 2.5v4M14 2.5v4M3 8h14"/></svg> VER LAS {races.length} CARRERAS</button></header>
