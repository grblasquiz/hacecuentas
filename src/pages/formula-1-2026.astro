---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/live/formula-1-2026.json';

const AR = 'America/Argentina/Buenos_Aires';
const now = new Date();
const races = data.races || [];
const nextRace = races.find((r: any) => !r.cancelled && new Date(r.end) >= now) || races[races.length - 1];
const weekend = (data.weekendSessions || []).filter((s: any) => s.meetingKey === nextRace?.meetingKey).sort((a: any, b: any) => a.start.localeCompare(b.start));
const nextSession = weekend.find((s: any) => new Date(s.end) >= now) || weekend[weekend.length - 1];
const upcomingRaces = races.filter((r: any) => !r.cancelled && new Date(r.end) >= now).slice(0, 5);
const fmt = (iso: string, options: Intl.DateTimeFormatOptions = {}) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, ...options }).format(new Date(iso));
const day = (iso: string) => fmt(iso, { weekday: 'short', day: 'numeric', month: 'short' }).replace('.', '').toUpperCase();
const fullDate = (iso: string) => fmt(iso, { weekday: 'long', day: 'numeric', month: 'long' });
const time = (iso: string) => fmt(iso, { hour: '2-digit', minute: '2-digit', hour12: false });
const flag = (code: string) => ({ AUS:'🇦🇺', CHN:'🇨🇳', JPN:'🇯🇵', BRN:'🇧🇭', KSA:'🇸🇦', USA:'🇺🇸', CAN:'🇨🇦', MON:'🇲🇨', ESP:'🇪🇸', AUT:'🇦🇹', GBR:'🇬🇧', BEL:'🇧🇪', HUN:'🇭🇺', NED:'🇳🇱', ITA:'🇮🇹', AZE:'🇦🇿', SGP:'🇸🇬', MEX:'🇲🇽', BRA:'🇧🇷', QAT:'🇶🇦', ARE:'🇦🇪' } as Record<string, string>)[code] || '🏁';
const country = (name: string) => ({ 'United Kingdom':'Reino Unido', 'United States':'Estados Unidos', Belgium:'Bélgica', Spain:'España', Netherlands:'Países Bajos', Hungary:'Hungría', Austria:'Austria', Italy:'Italia', Azerbaijan:'Azerbaiyán', Singapore:'Singapur', Mexico:'México', Brazil:'Brasil', Canada:'Canadá', Australia:'Australia', China:'China', Japan:'Japón', Bahrain:'Baréin', 'Saudi Arabia':'Arabia Saudita', Qatar:'Qatar', 'United Arab Emirates':'Emiratos Árabes Unidos', Monaco:'Mónaco' } as Record<string, string>)[name] || name;
const sessionLabel = (name: string) => name === 'Qualifying' ? 'Clasificación' : name === 'Sprint' ? 'Sprint' : 'Carrera';
const sessionIcon = (name: string) => name === 'Qualifying' ? '⌁' : name === 'Sprint' ? '◉' : '⚑';
const title = 'Fórmula 1 2026: calendario, próximos GP y resultados | Hacé Cuentas';
const description = 'SeguÍ cada fin de semana de Fórmula 1: clasificación, sprint, carrera, horarios y tabla de pilotos actualizada.';
const schema = { '@context':'https://schema.org', '@graph': [
  { '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem', position:1, name:'Inicio', item:'https://hacecuentas.com/' }, { '@type':'ListItem', position:2, name:'Fórmula 1 2026', item:'https://hacecuentas.com/formula-1-2026' }] },
  { '@type':'SportsEvent', name:'Campeonato Mundial de Fórmula 1 2026', sport:'Formula 1', startDate:races[0]?.start, endDate:races.at(-1)?.end, organizer:{'@type':'Organization',name:'FIA'}, url:'https://hacecuentas.com/formula-1-2026' },
  { '@type':'Dataset', name:'Calendario y resultados Fórmula 1 2026', creator:{'@type':'Organization',name:'Hacé Cuentas'}, isBasedOn:'https://openf1.org/', dateModified:data.fetchedAt, url:'https://hacecuentas.com/formula-1-2026' },
] };
---
<Layout title={title} description={description} canonical="/formula-1-2026" audience="global" schema={schema} domain="life">
  <Header />
  <main class="article-main"><article class="f1" data-f1>
    <header class="f1-head"><a href="/formula-1-2026" class="f1-kicker"><i></i> Fórmula 1 2026</a><div class="f1-head-row"><div><h1>GP de {country(nextRace?.country || 'F1')}</h1><p>{nextRace?.circuit} <span>•</span> {fmt(nextRace?.start, { day:'numeric', month:'long' })} al {fmt(nextRace?.end, { day:'numeric', month:'long' })}</p></div><label class="f1-zone">🇦🇷 <select data-zone><option value="America/Argentina/Buenos_Aires">Argentina (GMT-3)</option><option value="America/Mexico_City">México</option><option value="America/Bogota">Colombia</option><option value="America/Santiago">Chile</option><option value="Europe/Madrid">España</option></select></label></div></header>

    <div class="f1-grid">
      <section class="f1-weekend"><div class="f1-title"><h2>Race Weekend</h2><span>Todos los horarios en tu zona</span></div><div class="f1-track">{weekend.map((s: any) => <article class:list={['f1-session', { active: s.sessionKey === nextSession?.sessionKey, done: new Date(s.end) < now }]}><time>{day(s.start)}</time><span class="f1-dot">{sessionIcon(s.name)}</span><div><strong>{sessionLabel(s.name)}</strong><small>{s.sessionKey === nextSession?.sessionKey ? 'Próxima sesión' : new Date(s.end) < now ? 'Sesión completada' : 'Próximamente'}</small></div><div class="f1-session-time"><small>INICIO</small><b data-datetime={s.start}>{time(s.start)}</b></div></article>)}</div></section>
      <aside class="f1-next" data-session={nextSession?.sessionKey}><span>PRÓXIMA SESIÓN</span><h2>{sessionLabel(nextSession?.name || 'Carrera')}</h2><p data-datetime={nextSession?.start}>{fullDate(nextSession?.start)} · {time(nextSession?.start)}</p><hr /><small>FALTAN</small><strong data-countdown={nextSession?.start}></strong><div class="f1-circuit">⌁</div><a href="#calendario">Ver calendario completo <b>→</b></a></aside>
    </div>

    <div class="f1-lower">
      <section class="f1-table"><div class="f1-title"><h2>Tabla de pilotos</h2><a href="#pilotos">Ver campeonato completo <b>→</b></a></div><div class="f1-table-head"><span>POS</span><span>PILOTO</span><span>EQUIPO</span><span>PTS</span></div>{data.standings.slice(0,5).map((r: any, i: number) => <div class="f1-driver"><b>{i+1}</b><strong>{r.name || `#${r.driverNumber}`}</strong><span>{r.team}</span><em>{r.points}</em></div>)}</section>
      <section id="calendario" class="f1-calendar"><div class="f1-title"><h2>Calendario</h2><button data-show-calendar>Ver calendario completo <b>→</b></button></div><div class="f1-calendar-list">{upcomingRaces.map((r: any) => <article class:list={{active:r.meetingKey === nextRace?.meetingKey}}><b>{r.countryCode}</b><small>{fmt(r.start,{day:'numeric',month:'short'}).replace('.','')} – {fmt(r.end,{day:'numeric',month:'short'}).replace('.','')}</small><span>{flag(r.countryCode)}</span><em>{r.circuit}</em></article>)}</div></section>
    </div>

    <section id="pilotos" class="f1-details"><details><summary>Calendario completo y horarios <span>⌄</span></summary>{races.map((r: any, i: number) => <p><b>{String(i+1).padStart(2,'0')}</b> {flag(r.countryCode)} GP de {country(r.country)} <time data-datetime={r.start}>{fullDate(r.start)} · {time(r.start)}</time></p>)}</details><details><summary>Resultados, clasificaciones y sprints <span>⌄</span></summary>{[...(data.sessions || [])].reverse().slice(0,15).map((s: any) => { const r = races.find((x: any) => x.meetingKey === s.meetingKey); return <p>{flag(r?.countryCode)} <b>{sessionLabel(s.name)}</b> · GP de {country(r?.country || 'F1')}</p>})}</details></section>
  </article></main>
  <Footer />
</Layout>
<script is:inline>
  const root = document.querySelector('[data-f1]'); if (root) {
    let tz = 'America/Argentina/Buenos_Aires'; const zone = root.querySelector('[data-zone]');
    const renderDates = () => root.querySelectorAll('[data-datetime]').forEach(el => { const d = new Date(el.dataset.datetime); el.textContent = new Intl.DateTimeFormat('es-AR',{timeZone:tz,weekday:'short',day:'numeric',month:'short',hour:'2-digit',minute:'2-digit',hour12:false}).format(d).replace('.',''); });
    zone?.addEventListener('change', () => { tz = zone.value; renderDates(); });
    root.querySelectorAll('[data-countdown]').forEach(el => { const tick=()=>{ const x=Math.max(0,new Date(el.dataset.countdown)-Date.now()), d=Math.floor(x/864e5),h=Math.floor(x%864e5/36e5),m=Math.floor(x%36e5/6e4); el.textContent=x?d+' d '+h+' h '+m+' min':'En curso'; }; tick(); setInterval(tick,60000); });
    root.querySelector('[data-show-calendar]')?.addEventListener('click', () => root.querySelector('#pilotos details')?.setAttribute('open',''));
    renderDates();
  }
</script>
<style>
  .f1{max-width:1180px;margin:auto;padding:30px 18px 68px;color:#111}.f1-head{border-bottom:1px solid #d8d8d8;padding-bottom:25px}.f1-kicker{display:inline-flex;gap:8px;align-items:center;color:#e10600;font-size:.86rem;font-weight:800;text-decoration:none;text-transform:uppercase;letter-spacing:.04em}.f1-kicker i{width:8px;height:8px;border-radius:50%;background:#e10600}.f1-head-row{display:flex;justify-content:space-between;align-items:end;gap:24px}.f1 h1{font-size:clamp(2.6rem,6vw,5.2rem);letter-spacing:-.075em;line-height:.9;margin:10px 0}.f1-head p{margin:0;color:#525252;font-size:1.03rem}.f1-head p span{padding:0 8px;color:#aaa}.f1-zone{border:1px solid #ddd;border-radius:7px;padding:10px 12px;white-space:nowrap;font-size:.9rem}.f1-zone select{border:0;background:transparent;font:inherit;font-weight:650}.f1-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(310px,.88fr);gap:25px;padding-top:28px}.f1-title{display:flex;align-items:end;justify-content:space-between;gap:15px;border-bottom:1px solid #ddd;padding-bottom:10px}.f1-title h2{font-size:1.45rem;letter-spacing:-.04em;margin:0}.f1-title span{font-size:.76rem;color:#777}.f1-title a,.f1-title button{border:0;background:transparent;color:#e10600;font:inherit;font-size:.78rem;font-weight:800;text-decoration:none;text-transform:uppercase;white-space:nowrap;cursor:pointer}.f1-title b{font-size:1.2rem;padding-left:5px}.f1-track{margin-top:18px;background:#181818;border-radius:8px;overflow:hidden;box-shadow:0 12px 24px -20px #000}.f1-session{display:grid;grid-template-columns:118px 82px 1fr 105px;align-items:center;min-height:102px;color:#fff;border-bottom:1px solid #434343;position:relative}.f1-session:last-child{border:0}.f1-session time{font-size:.78rem;color:#bcbcbc;font-weight:800;padding-left:20px}.f1-dot{width:50px;height:50px;display:grid;place-items:center;border:2px solid #777;border-radius:50%;font-size:1.5rem;color:#ddd;position:relative}.f1-dot:after{content:'';position:absolute;width:1px;height:52px;background:#777;top:48px}.f1-session:last-child .f1-dot:after{display:none}.f1-session strong{display:block;font-size:1.65rem;letter-spacing:-.04em}.f1-session small{display:block;color:#a8a8a8;margin-top:3px}.f1-session-time{padding-right:20px;text-align:right}.f1-session-time small{font-size:.66rem;letter-spacing:.06em;margin:0}.f1-session-time b{font-size:1.65rem}.f1-session.active{background:linear-gradient(90deg,#280707,#1d1d1d);box-shadow:inset 6px 0 #e10600}.f1-session.active time,.f1-session.active strong,.f1-session.active .f1-session-time b{color:#ff2d25}.f1-session.active .f1-dot{background:#e10600;border-color:#ff332b;color:#fff;box-shadow:0 0 0 8px rgba(225,6,0,.18)}.f1-session.done{opacity:.72}.f1-next{align-self:stretch;background:linear-gradient(145deg,#161616,#292929);color:#fff;border-radius:8px;padding:25px;display:flex;flex-direction:column;box-shadow:0 12px 24px -20px #000}.f1-next>span,.f1-next>small{color:#ff2c26;font-size:.78rem;letter-spacing:.07em;font-weight:850}.f1-next h2{font-size:clamp(2.2rem,4vw,3.6rem);letter-spacing:-.065em;line-height:.9;margin:12px 0}.f1-next p{margin:0;color:#bbb;font-weight:700;text-transform:uppercase}.f1-next hr{border:0;border-top:1px solid #484848;width:100%;margin:30px 0 23px}.f1-next>strong{color:#f21c14;font-size:clamp(2.4rem,5vw,4.5rem);letter-spacing:-.08em;line-height:1;margin-top:8px;white-space:nowrap}.f1-circuit{font-size:5.5rem;color:#eee;opacity:.9;line-height:1;margin:auto 0 18px;transform:rotate(-12deg)}.f1-next a{border:1px solid #e10600;color:#fff;padding:14px 15px;border-radius:7px;text-transform:uppercase;text-decoration:none;font-size:.78rem;font-weight:850;text-align:center}.f1-next a b{float:right;font-size:1.25rem;line-height:.7}.f1-lower{display:grid;grid-template-columns:.9fr 1.5fr;gap:18px;margin-top:23px}.f1-table,.f1-calendar{border:1px solid #ddd;border-radius:8px;padding:20px}.f1-table-head,.f1-driver{display:grid;grid-template-columns:42px 1.5fr 1.1fr 38px;align-items:center;gap:8px}.f1-table-head{padding:15px 0 7px;font-size:.62rem;color:#777;font-weight:850}.f1-driver{padding:10px 0;border-top:1px solid #e5e5e5;font-size:.86rem}.f1-driver>b{border-left:4px solid #e10600;padding-left:8px}.f1-driver strong{font-size:.85rem}.f1-driver span{color:#555}.f1-driver em{font-style:normal;text-align:right;font-weight:850}.f1-calendar-list{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-top:18px}.f1-calendar-list article{min-height:150px;border:1px solid #ddd;border-radius:7px;padding:13px 8px;display:flex;flex-direction:column;text-align:center}.f1-calendar-list article.active{border:2px solid #e10600;color:#e10600}.f1-calendar-list b{font-size:1rem}.f1-calendar-list small{font-size:.68rem;margin:3px 0}.f1-calendar-list span{font-size:2.5rem;margin:auto 0 8px}.f1-calendar-list em{font-size:.68rem;font-style:normal;color:#555}.f1-calendar-list article.active em{color:#e10600}.f1-details{margin-top:20px}.f1-details details{border-top:1px solid #ddd;padding:14px 4px}.f1-details summary{display:flex;justify-content:space-between;cursor:pointer;font-weight:800}.f1-details p{display:flex;gap:10px;align-items:center;border-top:1px solid #eee;padding:9px 0;margin:10px 0 0;font-size:.86rem}.f1-details p>b{color:#e10600}.f1-details time{margin-left:auto;color:#666;font-size:.78rem}.f1-details span{color:#e10600}@media(max-width:800px){.f1-head-row{align-items:start;flex-direction:column}.f1-grid,.f1-lower{grid-template-columns:1fr}.f1-next{min-height:360px}.f1-calendar-list{grid-template-columns:repeat(3,1fr)}.f1-calendar-list article:nth-child(n+4){display:none}}@media(max-width:540px){.f1{padding:20px 14px 50px}.f1 h1{font-size:3rem}.f1-head p{font-size:.86rem}.f1-session{grid-template-columns:74px 52px 1fr 67px;min-height:90px}.f1-session time{padding-left:10px;font-size:.65rem}.f1-dot{width:38px;height:38px;font-size:1rem}.f1-dot:after{height:52px;top:37px}.f1-session strong{font-size:1.15rem}.f1-session small{font-size:.67rem}.f1-session-time{padding-right:10px}.f1-session-time b{font-size:1.05rem}.f1-table-head,.f1-driver{grid-template-columns:32px 1.4fr .85fr 32px;font-size:.75rem}.f1-driver strong{font-size:.75rem}.f1-calendar-list{grid-template-columns:repeat(3,1fr);gap:5px}.f1-calendar{padding:15px}.f1-calendar-list article{min-height:125px;padding:9px 4px}.f1-details time{display:none}}
</style>
