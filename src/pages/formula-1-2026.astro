.session-icon:after{background:#777;content:'';height:48px;left:26px;position:absolute;top:53px;width:1px}.session-row:nth-last-of-type(1) .session-icon:after{display:none}.session-icon svg{fill:none;height:35px;stroke:#fff;stroke-linecap:round;stroke-linejoin:round;stroke-width:2.2;width:35px}.session-name strong{display:block;font-size:30px;font-weight:900;letter-spacing:-.04em}.session-name small{color:#aaa;display:block;font-size:13px;margin-top:3px}.session-time small{color:#aaa;display:block;font-size:11px}.session-time b{display:block;font-size:32px;letter-spacing:-.04em}.session-arrow{font-size:39px}.session-row.active{background:linear-gradient(90deg,#270101,#2b1010 65%,#1c1c1e);box-shadow:inset 6px 0 #e10600}.session-row.active time,.session-row.active .session-name strong,.session-row.active .session-name small,.session-row.active .session-time small,.session-row.active .session-time b{color:#f20d0d}.session-row.active .session-icon{background:#ed1010;border-color:#ff2929;box-shadow:0 0 0 8px rgba(225,6,0,.16)}.session-row.done{opacity:.8}.session-foot{color:#aaa;font-size:11px;margin:0;padding:12px 29px}.next-panel{background:linear-gradient(145deg,#111,#202124);border-radius:6px;box-sizing:border-box;color:#fff;display:flex;flex-direction:column;grid-column:2;grid-row:1;height:535px;margin-top:14px;padding:22px 20px 18px}.next-head{border-left:3px solid #e10600;padding:2px 0 12px 17px}.next-head span,.next-count>small{color:#f10d12;font-size:13px;font-weight:900}.next-head h2{color:#fff!important;font-size:54px;font-weight:900;letter-spacing:-.045em;line-height:1;margin:7px 0 10px}.next-head p{color:#bbb;font-size:14px;font-weight:700;margin:0}.next-count{border-top:1px solid #464646;margin-top:9px;padding:22px 10px 0}.next-count strong{align-items:baseline;color:#ef0c12;display:flex;margin-top:7px;white-space:nowrap}.next-count b{font-size:70px;font-weight:900;letter-spacing:-.07em}.next-count i{font-size:30px;font-style:normal;font-weight:900;margin:0 10px 0 5px}.next-track{height:125px;margin:4px auto 7px;width:210px}.next-track path,.calendar-list svg path{fill:none;stroke:#e4e4e4;stroke-linecap:round;stroke-linejoin:round;stroke-width:3}.next-track .track-hot{stroke:#e10600;stroke-width:4}.next-track circle{fill:#fff}.next-panel>a{border:1px solid #e10600;border-radius:6px;color:#fff;font-size:13px;font-weight:900;margin-top:auto;padding:15px;text-align:center;text-decoration:none}.next-panel>a b{float:right;font-size:25px;line-height:.5}.race-lower{display:grid;gap:20px;grid-template-columns:38% 1fr;margin-top:20px}.drivers-card,.calendar-card{border:1px solid #ddd;border-radius:6px;padding:17px 24px 20px}.drivers-head,.driver-row{align-items:center;display:grid;grid-template-columns:28px 18px 1.5fr 1.25fr 42px}.drivers-head{color:#555;font-size:10px;margin-top:13px}.drivers-head span:nth-child(2){grid-column:2/4}.driver-row{border-top:1px solid #ddd;font-size:13px;min-height:32px}.driver-row>b{font-weight:700;text-align:center}.driver-row>i{background:var(--team);border-radius:2px;height:20px;justify-self:center;width:4px}.driver-row strong{font-size:13px}.driver-row span{color:#444}.driver-row em{font-style:normal;font-weight:900;text-align:right}.drivers-card>a,.calendar-card>a{color:#e10600;display:inline-block;font-size:11px;font-weight:900;margin-top:20px;text-decoration:none}.drivers-card>a b,.calendar-card>a b{font-size:22px;margin-left:12px}.calendar-list{align-items:stretch;display:grid;gap:22px;grid-template-columns:repeat(5,1fr) 48px;margin-top:17px}.calendar-list article{align-items:center;border:1px solid #ddd;border-radius:6px;display:flex;flex-direction:column;min-height:181px;padding:14px 7px 9px}.calendar-list article.active{border:2px solid #e10600;color:#e10600}.calendar-list article>b{font-size:16px}.calendar-list article>small{font-size:10px;margin-top:3px}.calendar-list svg{height:86px;margin:auto;width:126px}.calendar-list svg path{stroke:#777;stroke-width:3}.calendar-list article.active svg path{stroke:#111}.calendar-list article em{color:#555;font-size:11px;font-style:normal;text-align:center}.calendar-list article.active em{color:#e10600}.calendar-list button{align-self:center;background:#fff;border:1px solid #ddd;border-radius:50%;color:#111;font-size:37px;height:48px;width:48px}.race-details{margin-top:23px}.race-details details{border-top:1px solid #ddd;padding:14px 2px}.race-details summary{color:#111;cursor:pointer;display:flex;font-size:14px;font-weight:900;justify-content:space-between}.race-details summary span,.race-details p>b{color:#e10600}.race-details p{border-top:1px solid #eee;color:#222;display:flex;font-size:12px;gap:10px;margin:10px 0 0;padding:10px 0}.race-details time{color:#666;margin-left:auto}@media(max-width:900px){.race-nav{padding:0 18px}.race-nav nav{display:none}.race-page{padding:22px 16px 50px}.race-stage{grid-template-columns:1fr}.race-hero{height:auto;margin-bottom:25px}.race-hero h1{font-size:50px}.next-panel{grid-column:1;grid-row:auto;height:auto;margin-top:0;min-height:430px}.race-lower{grid-template-columns:1fr}.calendar-list{gap:8px;grid-template-columns:repeat(3,1fr)}.calendar-list article:nth-child(n+4),.calendar-list button{display:none}}@media(max-width:560px){.race-brand{font-size:17px}.race-zone{padding:8px}.race-zone select{font-size:12px;min-width:125px}.race-hero h1{font-size:43px}.race-hero p{font-size:17px}.session-row{grid-template-columns:82px 50px 1fr 72px 16px;min-height:91px}.session-row time{font-size:9px;padding-left:10px}.session-icon{height:37px;width:37px}.session-icon:after{height:54px;left:17px;top:35px}.session-icon svg{height:24px;width:24px}.session-name strong{font-size:19px}.session-name small{font-size:10px}.session-time b{font-size:20px}.session-time small{font-size:9px}.next-count b{font-size:55px}.next-count i{font-size:23px}.drivers-card,.calendar-card{padding:16px 12px}.calendar-list svg{height:70px;width:100px}}
</style>
<style is:global>
  main.race-page { width: 100% !important; max-width: 1536px !important; }
  @media (min-width: 901px) {
    .session-list { display: flex; flex-direction: column; height: 344px; }
    .session-row { flex: 1; }
    .session-icon::after { height: calc(309px / var(--sessions) - 53px); }
  }
  @media (max-width: 900px) {
    .drivers-card, .calendar-card { box-sizing: border-box; min-width: 0; width: 100%; }
    .calendar-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .calendar-list article { box-sizing: border-box; min-width: 0; }
    .calendar-list svg { max-width: 100%; }
  }
</style>
