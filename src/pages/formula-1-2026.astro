---
// @incremental-standalone — landing estática aislada; habilita deploy incremental.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import data from '../data/live/formula-1-2026.json';

const AR = 'America/Argentina/Buenos_Aires';
const now = new Date();
const races = data.races || [];
const nextRace = races.find((race: any) => !race.cancelled && new Date(race.end) >= now) || races.at(-1);
const weekend = (data.weekendSessions || [])
  .filter((session: any) => session.meetingKey === nextRace?.meetingKey)
  .sort((a: any, b: any) => a.start.localeCompare(b.start));
const nextSession = weekend.find((session: any) => new Date(session.end) >= now) || weekend.at(-1);
const upcomingRaces = races.filter((race: any) => !race.cancelled && new Date(race.end) >= now).slice(0, 5);
const weekendEnd = new Date(nextRace?.start || Date.now());
const weekendStart = new Date(weekendEnd);
weekendStart.setUTCDate(weekendStart.getUTCDate() - 2);

const fmt = (iso: string | Date, options: Intl.DateTimeFormatOptions = {}) =>
  new Intl.DateTimeFormat('es-AR', { timeZone: AR, ...options }).format(new Date(iso));
const shortDay = (iso: string) => `${fmt(iso, { weekday: 'short' }).replace('.', '').toUpperCase()} ${fmt(iso, { day: 'numeric', month: 'short' }).replace('.', '').toUpperCase()}`;
const fullDate = (iso: string) => fmt(iso, { weekday: 'long', day: 'numeric', month: 'long' }).toUpperCase();
const time = (iso: string) => fmt(iso, { hour: '2-digit', minute: '2-digit', hour12: false });
const monthRange = `${fmt(weekendStart, { day: 'numeric' })} – ${fmt(weekendEnd, { day: 'numeric', month: 'long' })}`;
const compactRange = (race: any) => {
  const end = new Date(race.start);
  const start = new Date(end);
  start.setUTCDate(start.getUTCDate() - 2);
  return `${fmt(start, { day: 'numeric' })} – ${fmt(end, { day: 'numeric', month: 'short' }).replace('.', '')}`.toUpperCase();
};
const country = (name: string) => ({ 'United Kingdom':'Reino Unido', 'United States':'Estados Unidos', Belgium:'Bélgica', Spain:'España', Netherlands:'Países Bajos', Hungary:'Hungría', Austria:'Austria', Italy:'Italia', Azerbaijan:'Azerbaiyán', Singapore:'Singapur', Mexico:'México', Brazil:'Brasil', Canada:'Canadá', Australia:'Australia', China:'China', Japan:'Japón', Bahrain:'Baréin', 'Saudi Arabia':'Arabia Saudita', Qatar:'Qatar', 'United Arab Emirates':'Emiratos Árabes Unidos', Monaco:'Mónaco' } as Record<string, string>)[name] || name;
const sessionLabel = (name: string) => name === 'Qualifying' ? 'Clasificación' : name === 'Sprint' ? 'Sprint' : 'Carrera';
const sessionNote = (session: any) => session.name === 'Race' ? `${nextRace?.laps || 57} vueltas` : new Date(session.end) < now ? 'Sesión completada' : session.sessionKey === nextSession?.sessionKey ? 'Próxima sesión' : 'Próximamente';
const teamColor = (team: string) => team?.includes('McLaren') ? '#ff8000' : team?.includes('Ferrari') ? '#00c7ae' : team?.includes('Red Bull') ? '#1e41ff' : team?.includes('Mercedes') ? '#00a19c' : '#e10600';
const trackPath = (code: string) => ({
  BEL:'M22 67 C34 47 51 34 72 28 L99 18 L118 25 L128 18 L140 24 L148 39 L141 45 L129 32 L112 35 L103 48 L109 60 L132 65 L143 76 L131 91 L118 86 L105 74 L87 69 L72 76 L54 89 L38 92 L46 75 Z',
  HUN:'M18 45 L31 25 L51 33 L67 46 L88 47 L102 64 L119 61 L130 74 L123 91 L104 97 L90 87 L75 94 L55 83 L39 87 L26 72 Z',
  NED:'M20 75 C29 47 51 31 74 21 C88 15 99 19 95 29 C90 40 65 43 58 57 C50 73 70 82 90 72 C108 61 119 43 136 48 C152 53 143 71 129 80 C106 95 81 101 57 96 C35 92 16 87 20 75 Z',
  ITA:'M17 25 C27 19 36 28 41 41 L55 82 C60 96 74 101 87 91 L123 61 C132 54 143 57 145 67 C147 78 139 83 129 85 L100 96 C75 106 51 103 42 82 L17 35 Z',
  AZE:'M17 85 L29 39 L42 28 L48 43 L58 50 L78 46 L88 25 L98 38 L136 31 L143 42 L104 55 L95 70 L73 72 L64 91 L42 96 Z',
  ESP:'M16 70 C25 35 48 20 73 24 L92 38 L120 32 L142 47 L134 67 L112 62 L101 80 L75 91 L47 88 Z',
  GBR:'M17 65 L31 40 L52 45 L68 25 L88 36 L101 27 L116 42 L139 44 L144 60 L128 71 L115 65 L102 88 L78 77 L58 91 L43 75 Z',
  ITA2:'M17 25 C27 19 36 28 41 41 L55 82 C60 96 74 101 87 91 L123 61 C132 54 143 57 145 67 C147 78 139 83 129 85 L100 96 C75 106 51 103 42 82 L17 35 Z'
} as Record<string, string>)[code] || 'M19 69 C32 36 63 20 88 32 C105 41 116 24 136 38 L143 55 C126 66 117 84 95 88 C72 93 45 89 19 69 Z';

const title = 'Fórmula 1 2026: calendario, próximos GP y resultados | Hacé Cuentas';
const description = 'Seguí cada fin de semana de Fórmula 1: clasificación, sprint, carrera, horarios y tabla de pilotos actualizada.';
const schema = { '@context':'https://schema.org', '@graph': [
  { '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem', position:1, name:'Inicio', item:'https://hacecuentas.com/' }, { '@type':'ListItem', position:2, name:'Fórmula 1 2026', item:'https://hacecuentas.com/formula-1-2026' }] },
  { '@type':'SportsEvent', name:'Campeonato Mundial de Fórmula 1 2026', sport:'Formula 1', startDate:races[0]?.start, endDate:races.at(-1)?.end, organizer:{'@type':'Organization',name:'FIA'}, url:'https://hacecuentas.com/formula-1-2026' },
  { '@type':'Dataset', name:'Calendario y resultados Fórmula 1 2026', creator:{'@type':'Organization',name:'Hacé Cuentas'}, isBasedOn:'https://openf1.org/', dateModified:data.fetchedAt, url:'https://hacecuentas.com/formula-1-2026' }
] };
---
<Layout title={title} description={description} canonical="/formula-1-2026" audience="global" schema={schema} domain="life">
  <header class="race-nav">
    <a class="race-brand" href="/">Hacé <strong>Cuentas</strong></a>
    <nav aria-label="Navegación principal"><a href="/calculadoras">Calculadoras</a><a href="/finanzas-personales">Finanzas</a><a href="/cotizaciones">Cotizaciones</a><a href="/herramientas">Herramientas</a></nav>
    <label class="race-zone">🇦🇷 <select data-zone aria-label="Zona horaria"><option value="America/Argentina/Buenos_Aires">Argentina (GMT-3)</option><option value="America/Mexico_City">México</option><option value="America/Bogota">Colombia</option><option value="America/Santiago">Chile</option><option value="Europe/Madrid">España</option></select></label>
  </header>

  <main class="race-page" data-f1>
    <div class="race-stage">
      <div class="race-left">
        <section class="race-hero">
          <p>Fórmula 1 2026</p>
          <h1>GP de {country(nextRace?.country || 'F1')}</h1>
          <div>{nextRace?.circuit} <i>•</i> {monthRange}</div>
        </section>

        <section class="race-weekend">
          <h2>Race Weekend</h2>
          <div class="session-list" style={`--sessions:${Math.max(weekend.length, 1)}`}>
            {weekend.map((session: any) => <article class:list={['session-row', { active: session.sessionKey === nextSession?.sessionKey, done: new Date(session.end) < now }]}>
              <time>{shortDay(session.start)}</time>
              <span class="session-icon" aria-hidden="true">
                {session.name === 'Sprint' ? <svg viewBox="0 0 40 40"><circle cx="20" cy="22" r="11"/><path d="M20 11V6M15 6h10M29 12l3-3M20 17v6l4 3"/></svg> : <svg viewBox="0 0 40 40"><path d="M11 31V9M12 10c7-4 9 5 16 1v12c-7 4-9-5-16-1M17 9v14M23 11v14M12 16h16"/></svg>}
              </span>
              <div class="session-name"><strong>{sessionLabel(session.name)}</strong><small>{sessionNote(session)}</small></div>
              <div class="session-time"><small>INICIO</small><b data-time={session.start}>{time(session.start)}</b></div>
              {session.sessionKey === nextSession?.sessionKey && <span class="session-arrow">›</span>}
            </article>)}
            <p class="session-foot">Todos los horarios corresponden a <span data-zone-label>Argentina (GMT-3)</span></p>
          </div>
        </section>
      </div>

      <aside class="next-panel">
        <div class="next-head"><span>PRÓXIMA SESIÓN</span><h2>{sessionLabel(nextSession?.name || 'Carrera')}</h2><p data-full-date={nextSession?.start}>{fullDate(nextSession?.start)}</p></div>
        <div class="next-count"><small>FALTAN</small><strong data-countdown={nextSession?.start}><b data-count-hours>00</b><i>h</i><b data-count-minutes>00</b><i>min</i></strong></div>
        <svg class="next-track" viewBox="0 0 160 112" aria-label={`Circuito de ${nextRace?.circuit}`}><path d={trackPath(nextRace?.countryCode)} /><circle cx="119" cy="84" r="3"/><path class="track-hot" d="M111 72 C116 81 123 89 135 94"/></svg>
        <a href="#calendario">VER TIEMPOS EN VIVO <b>›</b></a>
      </aside>
    </div>

    <div class="race-lower">
      <section class="drivers-card" id="pilotos">
        <h2>Tabla de pilotos</h2>
        <div class="drivers-head"><span>POS</span><span>PILOTO</span><span>EQUIPO</span><span>PTS</span></div>
        {data.standings.slice(0, 5).map((driver: any, index: number) => <div class="driver-row"><b>{index + 1}</b><i style={`--team:${teamColor(driver.team)}`}></i><strong>{driver.name || `#${driver.driverNumber}`}</strong><span>{driver.team}</span><em>{driver.points}</em></div>)}
        <a href="#resultados">VER CAMPEONATO COMPLETO <b>›</b></a>
      </section>

      <section class="calendar-card" id="calendario">
        <h2>Calendario</h2>
        <div class="calendar-list">
          {upcomingRaces.map((race: any) => <article class:list={{ active: race.meetingKey === nextRace?.meetingKey }}><b>{race.countryCode}</b><small>{compactRange(race)}</small><svg viewBox="0 0 160 112" aria-label={`Circuito de ${race.circuit}`}><path d={trackPath(race.countryCode)} /></svg><em>{race.circuit}</em></article>)}
          <button aria-label="Ver próximas carreras">›</button>
        </div>
        <a href="#resultados">VER CALENDARIO COMPLETO <b>›</b></a>
      </section>
    </div>

    <section class="race-details" id="resultados">
      <details><summary>Calendario completo y horarios <span>⌄</span></summary>{races.map((race: any, index: number) => <p><b>{String(index + 1).padStart(2, '0')}</b> GP de {country(race.country)} <time>{fullDate(race.start)} · <span data-time={race.start}>{time(race.start)}</span></time></p>)}</details>
      <details><summary>Resultados, clasificaciones y sprints <span>⌄</span></summary>{[...(data.sessions || [])].reverse().slice(0, 15).map((session: any) => { const race = races.find((item: any) => item.meetingKey === session.meetingKey); return <p><b>{sessionLabel(session.name)}</b> · GP de {country(race?.country || 'F1')}</p>})}</details>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline>
  const root = document.querySelector('[data-f1]');
  const zone = document.querySelector('[data-zone]');
  if (root && zone) {
    let tz = zone.value;
    const zoneNames = { 'America/Argentina/Buenos_Aires':'Argentina (GMT-3)', 'America/Mexico_City':'México', 'America/Bogota':'Colombia', 'America/Santiago':'Chile', 'Europe/Madrid':'España' };
    const render = () => {
      root.querySelectorAll('[data-time]').forEach(el => { el.textContent = new Intl.DateTimeFormat('es-AR', { timeZone:tz, hour:'2-digit', minute:'2-digit', hour12:false }).format(new Date(el.dataset.time)); });
      root.querySelectorAll('[data-full-date]').forEach(el => { el.textContent = new Intl.DateTimeFormat('es-AR', { timeZone:tz, weekday:'long', day:'numeric', month:'long' }).format(new Date(el.dataset.fullDate)).toUpperCase(); });
      root.querySelectorAll('[data-zone-label]').forEach(el => { el.textContent = zoneNames[tz] || zone.options[zone.selectedIndex].text; });
    };
    zone.addEventListener('change', () => { tz = zone.value; render(); });
    root.querySelectorAll('[data-countdown]').forEach(el => {
      const tick = () => { const left = Math.max(0, new Date(el.dataset.countdown) - Date.now()); const hours = Math.floor(left / 36e5); const minutes = Math.floor(left % 36e5 / 6e4); el.querySelector('[data-count-hours]').textContent = String(hours); el.querySelector('[data-count-minutes]').textContent = String(minutes).padStart(2,'0'); };
      tick(); setInterval(tick, 60000);
    });
    render();
  }
</script>

<style>
