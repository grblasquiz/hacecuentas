---
// @incremental-standalone — landing estática aislada; habilita deploy incremental.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/live/formula-1-2026.json';

const AR = 'America/Argentina/Buenos_Aires';
const now = new Date();
const races = data.races || [];
const nextRaceIndex = races.findIndex((race: any) => !race.cancelled && new Date(race.end) >= now);
const nextRace = races[nextRaceIndex >= 0 ? nextRaceIndex : races.length - 1];
const calendarRaces = nextRaceIndex > 0 ? [...races.slice(nextRaceIndex), ...races.slice(0, nextRaceIndex)] : races;
const weekend = (data.weekendSessions || []).filter((session: any) => session.meetingKey === nextRace?.meetingKey).sort((a: any, b: any) => a.start.localeCompare(b.start));
const nextSession = weekend.find((session: any) => new Date(session.end) >= now) || weekend.at(-1);
const lastRace = races.slice(0, Math.max(0, nextRaceIndex)).reverse().find((race: any) => race.results?.some((result: any) => result.position));
const lastPodium = (lastRace?.results || []).filter((result: any) => result.position > 0 && result.position <= 3).sort((a: any, b: any) => a.position - b.position).map((result: any) => ({ ...result, ...(data.drivers?.[String(result.driverNumber)] || {}) }));
const standings = data.standings || [];
const constructorMap = new Map<string, number>();
for (const driver of standings) constructorMap.set(driver.team, (constructorMap.get(driver.team) || 0) + Number(driver.points || 0));
const constructors = [...constructorMap.entries()].map(([team, points]) => ({ team, points })).sort((a, b) => b.points - a.points);
const maxConstructorPoints = constructors[0]?.points || 1;
const weekendEnd = new Date(nextRace?.start || Date.now());
const weekendStart = new Date(weekendEnd); weekendStart.setUTCDate(weekendStart.getUTCDate() - 2);

const fmt = (iso: string | Date, options: Intl.DateTimeFormatOptions = {}) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, ...options }).format(new Date(iso));
const time = (iso: string) => fmt(iso, { hour: '2-digit', minute: '2-digit', hour12: false });
const shortDay = (iso: string) => `${fmt(iso, { weekday:'short' }).replace('.','').toUpperCase()} ${fmt(iso, { day:'numeric', month:'short' }).replace('.','').toUpperCase()}`;
const fullDate = (iso: string) => fmt(iso, { weekday:'long', day:'numeric', month:'long' }).toUpperCase();
const weekendRange = `${fmt(weekendStart, { day:'numeric' })}–${fmt(weekendEnd, { day:'numeric', month:'short' }).replace('.','').toUpperCase()}`;
const raceRange = (race: any) => { const end = new Date(race.start); const start = new Date(end); start.setUTCDate(start.getUTCDate() - 2); return `${fmt(start,{day:'numeric'})}–${fmt(end,{day:'numeric',month:'short'}).replace('.','').toUpperCase()}`; };
const country = (name: string) => ({ 'United Kingdom':'Reino Unido', 'United States':'Estados Unidos', Belgium:'Bélgica', Spain:'España', Netherlands:'Países Bajos', Hungary:'Hungría', Austria:'Austria', Italy:'Italia', Azerbaijan:'Azerbaiyán', Singapore:'Singapur', Mexico:'México', Brazil:'Brasil', Canada:'Canadá', Australia:'Australia', China:'China', Japan:'Japón', Bahrain:'Baréin', 'Saudi Arabia':'Arabia Saudita', Qatar:'Qatar', 'United Arab Emirates':'Emiratos Árabes Unidos', Monaco:'Mónaco' } as Record<string,string>)[name] || name;
const flag = (code: string) => ({ AUS:'🇦🇺', CHN:'🇨🇳', JPN:'🇯🇵', BRN:'🇧🇭', KSA:'🇸🇦', USA:'🇺🇸', CAN:'🇨🇦', MON:'🇲🇨', ESP:'🇪🇸', AUT:'🇦🇹', GBR:'🇬🇧', BEL:'🇧🇪', HUN:'🇭🇺', NED:'🇳🇱', ITA:'🇮🇹', AZE:'🇦🇿', SGP:'🇸🇬', MEX:'🇲🇽', BRA:'🇧🇷', QAT:'🇶🇦', ARE:'🇦🇪' } as Record<string,string>)[code] || '🏁';
const sessionLabel = (name: string) => name === 'Qualifying' ? 'Clasificación' : name === 'Sprint' ? 'Sprint' : 'Carrera';
const teamColor = (team: string) => team?.includes('McLaren') ? '#ff8000' : team?.includes('Ferrari') ? '#e10600' : team?.includes('Red Bull') ? '#1e41ff' : team?.includes('Mercedes') ? '#00a19c' : team?.includes('Sauber') ? '#18a558' : '#777';
const trackAsset = (race: any) => {
  const circuit = String(race?.circuit || '').toLowerCase();
  const asset = circuit.includes('melbourne') ? 'melbourne' : circuit.includes('shanghai') ? 'shanghai' : circuit.includes('suzuka') ? 'suzuka' : circuit.includes('sakhir') ? 'sakhir' : circuit.includes('jeddah') ? 'jeddah' : circuit.includes('miami') ? 'miami' : circuit.includes('montreal') ? 'montreal' : circuit.includes('monte carlo') ? 'monaco' : circuit.includes('catalunya') ? 'catalunya' : circuit.includes('spielberg') ? 'spielberg' : circuit.includes('silverstone') ? 'silverstone' : circuit.includes('spa') ? 'spa' : circuit.includes('hungaroring') ? 'hungaroring' : circuit.includes('zandvoort') ? 'zandvoort' : circuit.includes('monza') ? 'monza' : circuit.includes('madring') ? 'madring' : circuit.includes('baku') ? 'baku' : circuit.includes('singapore') ? 'singapore' : circuit.includes('austin') ? 'austin' : circuit.includes('mexico') ? 'mexico-city' : circuit.includes('interlagos') ? 'interlagos' : circuit.includes('las vegas') ? 'las-vegas' : circuit.includes('lusail') ? 'lusail' : circuit.includes('yas marina') ? 'yas-marina' : 'spa';
  return `/f1-2026/circuits/${asset}.svg`;
};
const portraitPosition = (index: number) => `${['0%','33.333%','66.667%','100%'][index % 4]} ${index % 8 < 4 ? '0%' : '100%'}`;
const circuitFacts = nextRace?.countryCode === 'BEL' ? ['7,004 km','19','1:46.286','308 km'] : ['—','—','—','—'];
const calDate = (iso: string) => new Date(iso).toISOString().replace(/[-:]/g,'').replace(/\.\d{3}Z$/,'Z');
const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(`GP de ${country(nextRace?.country || 'F1')}`)}&dates=${calDate(nextRace?.start)}/${calDate(nextRace?.end)}&details=${encodeURIComponent(`Fórmula 1 2026 · ${nextRace?.circuit}`)}`;
const title = 'Fórmula 1 2026: calendario, próximos GP y resultados | Hacé Cuentas';
const description = 'Calendario, horarios, resultados, posiciones de pilotos y constructores de la Fórmula 1 2026, actualizados automáticamente.';
const schema = { '@context':'https://schema.org', '@graph': [{ '@type':'SportsEvent', name:'Campeonato Mundial de Fórmula 1 2026', sport:'Formula 1', startDate:races[0]?.start, endDate:races.at(-1)?.end, url:'https://hacecuentas.com/formula-1-2026' }, { '@type':'Dataset', name:'Calendario y resultados Fórmula 1 2026', isBasedOn:'https://openf1.org/', dateModified:data.fetchedAt, url:'https://hacecuentas.com/formula-1-2026' }] };
---
<Layout title={title} description={description} canonical="/formula-1-2026" audience="global" schema={schema} domain="life">
  <Header slot="header" />
  <div class="f1-app" data-f1>
    <section class="hero-grid">
      <div class="hero-copy">
        <span>PRÓXIMO GRAN PREMIO</span>
        <h1>GP DE {country(nextRace?.country || 'F1').toUpperCase()}</h1>
        <p>{nextRace?.circuit} <i>·</i> {weekendRange}</p>
        <div class="hero-facts"><b>Ronda {nextRaceIndex + 1} de {races.length}</b><b>{circuitFacts[0]}</b><b>44 vueltas</b></div>
        <div class="hero-actions"><a class="primary" href="#fin-de-semana"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 3.5 16 10 6 16.5Z"/></svg> SEGUIR EN VIVO</a><a class="secondary" href={googleCalendarUrl} target="_blank" rel="noopener"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12.5" rx="1.5"/><path d="M6 2.5v4M14 2.5v4M3 8h14"/></svg> AGREGAR AL CALENDARIO</a></div>
      </div>
      <figure class="hero-track" aria-label={`Circuito de ${nextRace?.circuit}`}><img src={trackAsset(nextRace)} alt=""/><img class="track-sector" src={trackAsset(nextRace)} alt=""/><span class="finish-flag" aria-hidden="true"><i></i><i></i><i></i><i></i></span></figure>
      <aside class="count-card"><small>CARRERA EN</small><strong data-countdown={nextSession?.start}><b data-count-hours>00</b><i>h</i><b data-count-minutes>00</b><i>min</i></strong><hr/><p><svg viewBox="0 0 18 18" aria-hidden="true"><path d="M14.5 6.5A6 6 0 1 0 15 11"/><path d="m12 3.5 2.8 3.2 2.2-3.2"/></svg> Datos actualizados hace 2 min</p></aside>
    </section>

    <section class="weekend-grid" id="fin-de-semana">
      <div class="weekend-card card">
        <header><h2>FIN DE SEMANA</h2><label>Horarios locales <select data-zone><option value="America/Argentina/Buenos_Aires">GMT-3</option><option value="America/Mexico_City">México</option><option value="America/Bogota">Colombia</option><option value="America/Santiago">Chile</option><option value="Europe/Madrid">España</option></select> <span class="info-icon">i</span></label></header>
        {weekend.map((session: any) => <article class:list={['weekend-row',{active:session.sessionKey===nextSession?.sessionKey}]}><span class="event-icon">{session.name === 'Sprint' ? <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="17" r="10"/><path d="M12 3h8M16 3v4M22.5 9.5 25 7M16 11v7l4 3"/></svg> : <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M9 27V6m1 2c5-4 8 4 14 0v11c-6 4-9-4-14 0z"/><path class="checks" d="M10 8h4v4h-4zm8 0h4v4h-4zm-4 4h4v4h-4zm8 4h2v3h-2zm-12 4h4v-4h-4z"/></svg>}</span><div><strong>{sessionLabel(session.name)}</strong><small>{shortDay(session.start)}</small></div><div><small>Inicio</small><b data-time={session.start}>{time(session.start)}</b></div><button type="button" class="reminder" data-reminder aria-label={`Recordar ${sessionLabel(session.name)}`}>{new Date(session.end) < now ? 'COMPLETADA' : <><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 14h10l-1.2-1.7V8a3.8 3.8 0 0 0-7.6 0v4.3zM8.5 16a1.7 1.7 0 0 0 3 0"/></svg> RECORDAR</>}</button></article>)}
        <p class="weekend-note">Activá recordatorios para no perderte ninguna sesión.</p>
      </div>
      <div class="circuit-card card">
        <header><h2>GUÍA DEL CIRCUITO</h2><p><i></i> Sector 1 <i></i> Sector 2 <i class="red"></i> Sector 3</p></header>
        <figure class="circuit-visual" aria-label={`Guía del circuito ${nextRace?.circuit}`}><img src={trackAsset(nextRace)} alt=""/><img class="track-sector" src={trackAsset(nextRace)} alt=""/><span class="drs drs-one"><i></i>DRS 1</span><span class="drs drs-two"><i></i>DRS 2</span><span class="finish-flag" aria-hidden="true"><i></i><i></i><i></i><i></i></span></figure>
        <div class="circuit-stats"><span>Longitud<b>{circuitFacts[0]}</b></span><span>Curvas<b>{circuitFacts[1]}</b></span><span>Récord<b>{circuitFacts[2]}</b></span><span>Distancia<b>{circuitFacts[3]}</b></span></div>
      </div>
    </section>

    <section class="last-result">
      <div><span><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M10 5h12v7c0 5-2.5 8-6 8s-6-3-6-8zM10 8H6c0 5 2 7 6 7M22 8h4c0 5-2 7-6 7M16 20v5M11 27h10"/></svg></span><small>ÚLTIMO RESULTADO<br/>GP DE {country(lastRace?.country || 'F1').toUpperCase()}</small></div>
      {lastPodium.map((driver: any) => <p><b>{driver.position}</b><strong>{driver.name?.split(' ').at(-1)}</strong><small>{driver.team}</small></p>)}
      <a href="#latest-results" data-open-results>VER RESULTADOS <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m5 2 6 6-6 6"/></svg></a>
    </section>

    <section class="championship-grid" id="campeonato">
      <div class="standings-card card">
        <h2>CAMPEONATO DE PILOTOS</h2>
        <div class="tabs" role="tablist" aria-label="Clasificación del campeonato"><button type="button" role="tab" aria-selected="true" class="active" data-tab="drivers">PILOTOS</button><button type="button" role="tab" aria-selected="false" data-tab="teams">CONSTRUCTORES</button></div>
        <div data-panel="drivers"><div class="table-head"><span>POS.</span><span>PILOTO</span><span>EQUIPO</span><span>PTS.</span><span>TEND.</span></div>{standings.map((driver:any,index:number)=><div class:list={['standing-row',{extra:index>7}]}><b>{index+1}</b><i style={`--team:${teamColor(driver.team)}`}></i><span class="avatar" aria-hidden="true" style={`background-position:${portraitPosition(index)}`}></span><strong>{driver.name}</strong><span>{driver.team}</span><em>{driver.points}</em><mark>{index<2?'↑':index===2?'↓':'–'}</mark></div>)}</div>
        <div data-panel="teams" hidden>{constructors.map((team:any,index:number)=><div class="team-tab-row"><b>{index+1}</b><i style={`--team:${teamColor(team.team)}`}></i><strong>{team.team}</strong><em>{team.points}</em></div>)}</div>
        <button class="text-action" data-show-standings>VER CAMPEONATO COMPLETO ›</button>
      </div>
      <div class="constructors-card card"><h2>CAMPEONATO DE CONSTRUCTORES</h2><div class="constructors-head"><span>POS.</span><span>CONSTRUCTOR</span><span>PTS.</span></div>{constructors.map((team:any,index:number)=><article class:list={{extra:index>3}}><div><b>{index+1}</b><i style={`--team:${teamColor(team.team)}`}></i><strong>{team.team}</strong><em>{team.points}</em></div><span><i style={`--w:${team.points/maxConstructorPoints*100}%;--team:${teamColor(team.team)}`}></i></span></article>)}<button class="text-action" data-show-constructors>VER CAMPEONATO COMPLETO ›</button></div>
    </section>

    <section class="season" id="calendario">
      <header><h2>CALENDARIO 2026</h2><div class="filters" aria-label="Filtrar calendario"><button type="button" class="active" data-filter="all">Todos</button><button type="button" data-filter="next">Próximos</button><button type="button" data-filter="done">Finalizados</button><button type="button" data-filter="sprint">Sprint</button></div><button type="button" class="show-all" data-show-all><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12.5" rx="1.5"/><path d="M6 2.5v4M14 2.5v4M3 8h14"/></svg> VER LAS {races.length} CARRERAS</button></header>
      <div class="season-grid">{calendarRaces.map((race:any,index:number)=>{const done=new Date(race.end) < now;const hasSprint=(data.weekendSessions||[]).some((session:any)=>session.meetingKey===race.meetingKey&&session.name==='Sprint');const round=races.findIndex((item:any)=>item.meetingKey===race.meetingKey)+1;return <article class:list={['race-card',{current:race.meetingKey===nextRace?.meetingKey,extra:index>7}]} data-state={done?'done':'next'} data-sprint={hasSprint?'true':'false'}><b>{round}<small>{raceRange(race)}</small></b><span>{flag(race.countryCode)}</span><div><strong>GP DE {country(race.country).toUpperCase()}</strong><small>{race.circuit}</small></div><img class="race-track" src={trackAsset(race)} alt={`Trazado de ${race.circuit}`} loading="lazy"/>{race.meetingKey===nextRace?.meetingKey&&<em>PRÓXIMO</em>}</article>})}</div>
    </section>

    <section class="learn"><h2>LO QUE TENÉS QUE SABER</h2><div><a href="/calculadora-formula-1#f1"><span class="cars"><img src="/f1-2026/sprint-cars.png" alt="Tres autos de Fórmula 1 en formato Sprint" loading="lazy"/></span><p><strong>Cómo funciona un<br/>fin de semana Sprint</strong><small>Qué cambia entre el formato Sprint y el fin de semana tradicional.</small></p><b>›</b></a><a href="/calculadora-formula-1#f1"><span class="bars"><svg viewBox="0 0 120 78" aria-hidden="true"><path d="M8 9h13v61H8zm17 12h13v49H25zm17 19h13v30H42zm17 8h13v22H59zm17 8h13v14H76zm17 7h13v7H93z"/><g><text x="10" y="7">25</text><text x="28" y="19">18</text><text x="45" y="38">12</text><text x="62" y="46">10</text><text x="79" y="54">6</text><text x="96" y="61">2</text></g></svg></span><p><strong>Sistema de<br/>puntos 2026</strong><small>Así se reparten los puntos en cada carrera y en el Sprint.</small></p><b>›</b></a><a href="/calculadora-formula-1#f1"><span class="gauge"><svg viewBox="0 0 120 78" aria-hidden="true"><path class="dial" d="M10 69a50 50 0 0 1 100 0"/><path class="hot" d="M88 27a50 50 0 0 1 22 42"/><path d="M55 42h10v10c0 9-4 14-10 14S45 61 45 52V42h10m0 24v7m-9 0h18"/></svg></span><p><strong>Qué necesita cada<br/>piloto para ser campeón</strong><small>Escenarios, cálculos y posibilidades según la posición actual.</small></p><b>›</b></a></div></section>

    <p class="source">Fuente: OpenF1 · Actualización automática al finalizar cada sesión · Trazados: <a href="https://github.com/f1db/f1db" target="_blank" rel="noopener">F1DB (CC BY 4.0)</a> <span class="info-icon">i</span></p>
    <section id="resultados" class="hidden-results"><details id="latest-results"><summary>Últimos resultados</summary>{[...(data.sessions||[])].reverse().slice(0,10).map((session:any)=><p>{sessionLabel(session.name)} · {fullDate(session.start)}</p>)}</details></section>
  </div>
  <Footer slot="footer" />
</Layout>

<script is:inline>
  const root = document.querySelector('[data-f1]');
  if (root) {
    let storage = null;
    try { storage = window.localStorage; } catch (_) { /* Privacy mode: reminders still work for this visit. */ }
    const zone = root.querySelector('[data-zone]');
    let tz = zone?.value || 'America/Argentina/Buenos_Aires';
    const render = () => root.querySelectorAll('[data-time]').forEach(el => {
      el.textContent = new Intl.DateTimeFormat('es-AR', { timeZone:tz, hour:'2-digit', minute:'2-digit', hour12:false }).format(new Date(el.dataset.time));
    });
    zone?.addEventListener('change', () => { tz = zone.value; render(); });
    root.querySelectorAll('[data-countdown]').forEach(el => {
      const tick = () => { const left=Math.max(0,new Date(el.dataset.countdown)-Date.now()); el.querySelector('[data-count-hours]').textContent=String(Math.floor(left/36e5)); el.querySelector('[data-count-minutes]').textContent=String(Math.floor(left%36e5/6e4)).padStart(2,'0'); };
      tick(); setInterval(tick, 60000);
    });
    root.querySelectorAll('[data-reminder]').forEach(btn => {
      const key = `f1-reminder-${btn.getAttribute('aria-label')}`;
      if (storage?.getItem(key) === '1') { btn.classList.add('set'); btn.textContent='✓ RECORDATORIO'; }
      btn.addEventListener('click', () => { if(btn.textContent.includes('COMPLETADA')) return; btn.classList.toggle('set'); const set=btn.classList.contains('set'); btn.textContent=set?'✓ RECORDATORIO':'♧ RECORDAR'; storage?.setItem(key,set?'1':'0'); });
    });
    root.querySelectorAll('[data-tab]').forEach(btn => btn.addEventListener('click', () => {
      root.querySelectorAll('[data-tab]').forEach(item => { const active=item===btn; item.classList.toggle('active',active); item.setAttribute('aria-selected',String(active)); });
      root.querySelectorAll('[data-panel]').forEach(panel => panel.hidden=panel.dataset.panel!==btn.dataset.tab);
    }));
    root.querySelectorAll('[data-filter]').forEach(btn => btn.addEventListener('click', () => {
      root.querySelectorAll('[data-filter]').forEach(item => item.classList.toggle('active',item===btn));
      const filter=btn.dataset.filter;
      root.querySelectorAll('.race-card').forEach(card => { card.classList.remove('extra'); card.hidden=filter==='sprint'?card.dataset.sprint!=='true':filter==='all'?false:card.dataset.state!==filter; });
    }));
    root.querySelector('[data-show-all]')?.addEventListener('click', event => { root.querySelectorAll('.race-card.extra').forEach(card=>card.classList.remove('extra')); event.currentTarget.hidden=true; });
    root.querySelector('[data-show-standings]')?.addEventListener('click', event => { root.querySelectorAll('.standing-row.extra').forEach(row=>row.classList.remove('extra')); event.currentTarget.hidden=true; });
    root.querySelector('[data-show-constructors]')?.addEventListener('click', event => { root.querySelectorAll('.constructors-card article.extra').forEach(row=>row.classList.remove('extra')); event.currentTarget.hidden=true; });
    root.querySelector('[data-open-results]')?.addEventListener('click', () => { root.querySelector('#latest-results').open=true; });
    render();
  }
</script>

<style>
  .f1-app{--red:#e10600;--black:#111;--line:#ddd;color:#151515;font-family:Arial,Helvetica,sans-serif}.f1-app *{box-sizing:border-box}.hero-grid{display:grid;grid-template-columns:1.45fr .8fr .9fr;gap:24px;min-height:300px;padding:12px 0 26px}.hero-copy>span{color:var(--red);font-size:12px;font-weight:900}.hero-copy h1{color:#050505;font-family:Impact,'Arial Narrow',sans-serif;font-size:clamp(54px,6vw,88px);font-weight:900;letter-spacing:.005em;line-height:.92;margin:14px 0 9px}.hero-copy>p{color:#666;font-size:17px;margin:0}.hero-copy>p i{font-style:normal;margin:0 8px}.hero-facts{display:flex;gap:10px;margin-top:22px}.hero-facts b{border:1px solid #ddd;border-radius:4px;font-size:12px;font-weight:500;padding:9px 13px}.hero-actions{display:flex;gap:12px;margin-top:23px}.hero-actions a{border-radius:4px;font-size:12px;font-weight:900;padding:14px 18px;text-decoration:none}.hero-actions .primary{background:var(--red);color:white}.hero-actions .secondary{border:1px solid #555;color:#222}.hero-track{align-self:center;height:210px;width:100%}.hero-track path,.circuit-card svg>path,.race-card svg path{fill:none;stroke:#151515;stroke-linecap:round;stroke-linejoin:round;stroke-width:3}.hero-track .hot,.circuit-card svg .sector{stroke:var(--red);stroke-width:4}.hero-track text{font-size:12px}.count-card{align-self:center;background:#151515;border-radius:6px;color:white;height:235px;padding:28px 24px}.count-card>small{font-size:12px;font-weight:900}.count-card strong{align-items:baseline;color:var(--red);display:flex;margin:20px 0}.count-card strong b{font-size:57px;letter-spacing:-.07em}.count-card strong i{font-size:22px;font-style:normal;font-weight:900;margin:0 6px}.count-card hr{border:0;border-top:1px solid #555}.count-card p{color:#bbb;font-size:10px;margin-top:25px}.weekend-grid{display:grid;gap:20px;grid-template-columns:1fr 1fr}.card{border:1px solid var(--line);border-radius:5px;overflow:hidden}.card>header,.weekend-card>header,.circuit-card>header{align-items:cen