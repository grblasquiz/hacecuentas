---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/live/formula-1-2026.json';

const AR = 'America/Argentina/Buenos_Aires';
const now = new Date();
const races = data.races || [];
const next = races.find((r: any) => !r.cancelled && new Date(r.end) >= now) || races[races.length - 1];
const last = [...races].reverse().find((r: any) => !r.cancelled && new Date(r.end) < now);
const done = races.filter((r: any) => !r.cancelled && new Date(r.end) < now).length;
const date = (iso: string, options: Intl.DateTimeFormatOptions = {}) => new Intl.DateTimeFormat('es-AR', { timeZone: AR, ...options }).format(new Date(iso));
const fullDate = (iso: string) => date(iso, { weekday: 'long', day: 'numeric', month: 'long' });
const time = (iso: string) => date(iso, { hour: '2-digit', minute: '2-digit', hour12: false });
const flag = (code: string) => ({ AUS:'🇦🇺', CHN:'🇨🇳', JPN:'🇯🇵', BRN:'🇧🇭', KSA:'🇸🇦', USA:'🇺🇸', CAN:'🇨🇦', MON:'🇲🇨', ESP:'🇪🇸', AUT:'🇦🇹', GBR:'🇬🇧', BEL:'🇧🇪', HUN:'🇭🇺', NED:'🇳🇱', ITA:'🇮🇹', AZE:'🇦🇿', SGP:'🇸🇬', MEX:'🇲🇽', BRA:'🇧🇷', QAT:'🇶🇦', ARE:'🇦🇪' } as Record<string, string>)[code] || '🏁';
const country = (name: string) => ({ 'United Kingdom':'Reino Unido', 'United States':'Estados Unidos', Belgium:'Bélgica', Spain:'España', Netherlands:'Países Bajos', Hungary:'Hungría', Austria:'Austria', Italy:'Italia', Germany:'Alemania', Azerbaijan:'Azerbaiyán', Singapore:'Singapur', Mexico:'México', Brazil:'Brasil', Canada:'Canadá', Australia:'Australia', China:'China', Japan:'Japón', Bahrain:'Baréin', 'Saudi Arabia':'Arabia Saudita', Qatar:'Qatar', 'United Arab Emirates':'Emiratos Árabes Unidos', Monaco:'Mónaco' } as Record<string, string>)[name] || name;
const title = 'Fórmula 1 2026: calendario, próximos GP y resultados | Hacé Cuentas';
const description = 'Calendario de Fórmula 1 2026 con el próximo Gran Premio, horarios en Argentina, resultados y tabla de pilotos actualizada.';
const faq = [
  ['¿Cuándo es el próximo Gran Premio de Fórmula 1?', next ? `El próximo GP es el de ${next.country}, en ${next.circuit}, el ${fullDate(next.start)} a las ${time(next.start)} (hora argentina).` : 'El calendario se actualiza automáticamente.'],
  ['¿A qué hora son las carreras de F1 en Argentina?', 'Esta página muestra todas las largadas en hora de Argentina (UTC−3). Podés elegir otra zona horaria desde el selector.'],
  ['¿De dónde salen los resultados?', 'Los horarios, resultados de carrera y puntos provienen de OpenF1, una API pública de datos de Fórmula 1. La página conserva un snapshot indexable y refresca el calendario al abrirla.'],
];
const schema = { '@context':'https://schema.org', '@graph': [
  { '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem', position:1, name:'Inicio', item:'https://hacecuentas.com/' }, { '@type':'ListItem', position:2, name:'Fórmula 1 2026', item:'https://hacecuentas.com/formula-1-2026' }] },
  { '@type':'SportsEvent', name:'Campeonato Mundial de Fórmula 1 2026', sport:'Formula 1', startDate:races[0]?.start, endDate:races.at(-1)?.end, organizer:{'@type':'Organization',name:'FIA'}, url:'https://hacecuentas.com/formula-1-2026' },
  { '@type':'Dataset', name:'Calendario y resultados Fórmula 1 2026', creator:{'@type':'Organization',name:'Hacé Cuentas'}, isBasedOn:'https://openf1.org/', dateModified:data.fetchedAt, url:'https://hacecuentas.com/formula-1-2026' },
  { '@type':'FAQPage', mainEntity:faq.map(([name, text]) => ({ '@type':'Question', name, acceptedAnswer:{'@type':'Answer',text} })) },
] };
---
<Layout title={title} description={description} canonical="/formula-1-2026" audience="global" schema={schema} domain="life">
  <Header />
  <main class="article-main"><article class="f1fx" data-f1fx>
    <header class="f1fx-intro"><div><span class="f1fx-live"><i></i> Temporada 2026 · en vivo</span><h1>Fórmula 1</h1></div><p>{done} de {races.length} Grandes Premios disputados <span>·</span> Datos actualizados automáticamente</p></header>
    <div class="f1fx-bar"><div class="f1fx-tabs" role="tablist"><button class="active" data-tab="proximo">En vivo</button><button data-tab="calendario">Calendario</button><button data-tab="resultados">Resultados</button><button data-tab="pilotos">Tabla</button></div><label class="f1fx-zone"><span>🕐</span><select data-zone><option value="America/Argentina/Buenos_Aires">Argentina</option><option value="America/Mexico_City">México</option><option value="America/Bogota">Colombia</option><option value="America/Santiago">Chile</option><option value="Europe/Madrid">España</option></select></label></div>
    <section data-panel="proximo" class="f1fx-panel">
      {next && <><p class="eyebrow">{new Date(next.start).toDateString() === new Date().toDateString() ? 'HOY CORREN' : 'PRÓXIMO GRAN PREMIO'}</p><div class="f1fx-next" data-session={next.sessionKey}><div class="f1fx-next-top"><span class="f1fx-flag">{flag(next.countryCode)}</span><div><h2>GP de {country(next.country)}</h2><p>{next.circuit} <span>·</span> {next.location}</p></div><span class="f1fx-live-tag">EN VIVO</span></div><div class="f1fx-next-bottom"><div><small>LARGADA</small><strong data-datetime={next.start}>{fullDate(next.start)} · {time(next.start)}</strong></div><div class="f1fx-count"><small>FALTA</small><strong data-countdown={next.start}></strong></div></div></div></>}
      <div class="f1fx-actions"><a class="f1fx-action primary" href="#calendario" data-goto="calendario">Ver calendario completo <span>→</span></a><a class="f1fx-action" href="/calculadora-formula-1">Calculadora de puntos <span>→</span></a></div>
      {last?.results && <section class="f1fx-last"><div class="f1fx-section-head"><div><span>ÚLTIMA CARRERA</span><h2>GP de {country(last.country)}</h2></div><button data-goto="resultados">Ver resultado</button></div><ol>{[...last.results].sort((a: any, b: any) => a.position - b.position).slice(0,3).map((r: any) => <li><b>{r.position}</b><span>{data.drivers[r.driverNumber]?.name || `Piloto #${r.driverNumber}`}</span><em>{r.points} pts</em></li>)}</ol></section>}
    </section>
    <section id="calendario" data-panel="calendario" class="f1fx-panel" hidden><div class="f1fx-panel-title"><div><span>24 FECHAS</span><h2>Calendario 2026</h2></div><p>Horario en tu zona</p></div><div class="f1fx-list">{races.map((r: any, i: number) => <article data-session={r.sessionKey} class:list={['f1fx-race', { cancelled:r.cancelled, done:new Date(r.end) < now }]}><b class="round">{String(i+1).padStart(2,'0')}</b><span class="flag">{flag(r.countryCode)}</span><div><strong>GP de {country(r.country)}</strong><small>{r.circuit}</small></div><time data-datetime={r.start}>{fullDate(r.start)} · {time(r.start)}</time><em>{r.cancelled ? 'Cancelado' : new Date(r.end) < now ? 'Finalizado' : 'Próximo'}</em></article>)}</div></section>
    <section data-panel="resultados" class="f1fx-panel" hidden><div class="f1fx-panel-title"><div><span>SESIÓN POR SESIÓN</span><h2>Resultados</h2></div><p>Carreras, sprints y quali</p></div>{[...(data.sessions || [])].reverse().map((s: any) => { const race = races.find((r: any) => r.meetingKey === s.meetingKey); return <details><summary><span>{flag(race?.countryCode)} <b>{s.name}</b> · GP de {country(race?.country || 'F1')}</span><time>{fullDate(s.start)}</time></summary><ol class="f1fx-results">{[...s.results].sort((a: any,b: any) => a.position-b.position).map((x: any) => <li><b>{x.position}</b><span>{data.drivers[x.driverNumber]?.name || `#${x.driverNumber}`}</span><em>{x.dnf ? 'DNF' : x.dsq ? 'DSQ' : s.name === 'Qualifying' || s.name === 'Sprint Qualifying' ? 'TIEMPO' : `${x.points} pts`}</em></li>)}</ol></details>})}</section>
    <section data-panel="pilotos" class="f1fx-panel" hidden><h2>Campeonato de pilotos</h2><p class="f1fx-note">Puntos acumulados de las carreras disputadas disponibles en OpenF1.</p><div class="f1fx-standing"><div class="head"><span>#</span><span>Piloto</span><span>Equipo</span><span>Pts</span></div>{data.standings.map((r: any, i: number) => <div><span>{i+1}</span><b>{r.name || `#${r.driverNumber}`}</b><small>{r.team}</small><strong>{r.points}</strong></div>)}</div></section>
    <section class="f1fx-info"><h2>Fórmula 1 2026: todo el calendario, en tu hora</h2><p>SeguÍ la temporada carrera por carrera: el próximo GP, la hora de largada, los resultados y la tabla de pilotos. El horario se adapta a tu país sin esconder el contenido principal que necesitan los buscadores.</p><h2>Preguntas frecuentes</h2>{faq.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</section>
    <script type="application/json" id="f1fx-data" set:html={JSON.stringify({ source:data.source, races })} />
  </article></main>
  <Footer />
</Layout>
<script is:inline>
  const root = document.querySelector('[data-f1fx]'); if (root) {
    const zone = root.querySelector('[data-zone]'); let tz = 'America/Argentina/Buenos_Aires';
    const fmt = () => root.querySelectorAll('[data-datetime]').forEach(el => { const d = new Date(el.dataset.datetime); el.textContent = new Intl.DateTimeFormat('es-AR',{timeZone:tz,weekday:'long',day:'numeric',month:'long',hour:'2-digit',minute:'2-digit',hour12:false}).format(d); });
    zone?.addEventListener('change', () => { tz = zone.value; fmt(); });
    root.querySelectorAll('[data-tab]').forEach(btn => btn.addEventListener('click', () => { root.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===btn)); root.querySelectorAll('[data-panel]').forEach(x=>x.hidden=x.dataset.panel!==btn.dataset.tab); history.replaceState(null,'','#'+btn.dataset.tab); }));
    root.querySelectorAll('[data-countdown]').forEach(el => { const tick=()=>{const s=Math.max(0,new Date(el.dataset.countdown)-Date.now()); const d=Math.floor(s/864e5),h=Math.floor(s%864e5/36e5),m=Math.floor(s%36e5/6e4);el.textContent=s?'Faltan '+d+'d '+h+'h '+m+'m':'En curso';}; tick(); setInterval(tick,60000); });
    if (['proximo','calendario','resultados','pilotos'].includes(location.hash.slice(1))) root.querySelector('[data-tab="'+location.hash.slice(1)+'"]')?.click(); fmt();
    fetch('https://api.openf1.org/v1/sessions?year=2026&session_name=Race').then(r=>r.ok?r.json():[]).then(live=>live.forEach(r=>{const card=root.querySelectorAll('[data-session="'+r.session_key+'"]');card.forEach(c=>c.querySelectorAll('[data-datetime]').forEach(el=>{el.dataset.datetime=r.date_start;}));})).then(fmt).catch(()=>{});
  }
</script>
<style>
  .f1fx{max-width:880px;margin:auto;padding:26px 16px 64px;color:#111827}.f1fx-intro{display:flex;align-items:end;justify-content:space-between;gap:24px;padding:0 2px 22px}.f1fx-intro h1{font-size:clamp(2.2rem,6vw,3.5rem);line-height:.92;letter-spacing:-.07em;margin:7px 0 0}.f1fx-intro>p{color:#64748b;font-size:.84rem;margin:0 0 4px;text-align:right}.f1fx-intro>p span{color:#cbd5e1;padding:0 4px}.f1fx-live,.eyebrow,.f1fx-panel-title span,.f1fx-last .f1fx-section-head>div>span{font-size:.69rem;letter-spacing:.1em;font-weight:850;color:#dc2626;text-transform:uppercase}.f1fx-live i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#ef4444;margin-right:5px;box-shadow:0 0 0 4px #fee2e2}.f1fx-bar{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;align-items:center;background:color-mix(in srgb,var(--surface,#fff) 94%,transparent);backdrop-filter:blur(12px);border-block:1px solid #e5e7eb;padding:9px 0}.f1fx-tabs{display:flex;gap:3px;overflow:auto}.f1fx-tabs button{border:0;border-radius:8px;background:transparent;color:#64748b;padding:9px 12px;font-size:.86rem;font-weight:750;cursor:pointer;white-space:nowrap}.f1fx-tabs button.active{background:#111827;color:#fff}.f1fx-zone{display:flex;align-items:center;gap:4px;font-size:.82rem;color:#64748b}.f1fx-zone select{appearance:none;border:0;background:transparent;color:#334155;font:inherit;font-weight:700;cursor:pointer}.f1fx-panel{padding:29px 0}.eyebrow{margin:0 0 9px}.f1fx-next{overflow:hidden;border-radius:20px;background:#111827;color:#fff;box-shadow:0 16px 30px -20px rgba(15,23,42,.9)}.f1fx-next-top{display:flex;align-items:center;gap:15px;padding:24px 23px 19px;border-bottom:1px solid rgba(255,255,255,.12)}.f1fx-flag{font-size:3rem;line-height:1}.f1fx-next h2{font-size:clamp(1.45rem,4vw,2rem);letter-spacing:-.04em;margin:0}.f1fx-next p{margin:4px 0 0;color:#cbd5e1;font-size:.9rem}.f1fx-next p span{color:#64748b;padding:0 3px}.f1fx-live-tag{margin-left:auto;color:#fca5a5;font-weight:850;font-size:.67rem;letter-spacing:.11em}.f1fx-next-bottom{display:grid;grid-template-columns:1fr auto;gap:18px;padding:17px 23px 20px}.f1fx-next small{display:block;color:#94a3b8;font-size:.65rem;letter-spacing:.1em;font-weight:800;margin-bottom:4px}.f1fx-next-bottom strong{font-size:.98rem}.f1fx-count{text-align:right}.f1fx-count strong{color:#fca5a5}.f1fx-actions{display:grid;grid-template-columns:1.2fr 1fr;gap:9px;margin:11px 0 30px}.f1fx-action{display:flex;justify-content:space-between;align-items:center;padding:13px 15px;border:1px solid #e2e8f0;border-radius:11px;text-decoration:none;color:#334155;font-size:.87rem;font-weight:760}.f1fx-action span{font-size:1.1rem}.f1fx-action.primary{border-color:#dc2626;background:#dc2626;color:#fff}.f1fx-last{border-top:1px solid #e5e7eb;padding-top:21px}.f1fx-section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:10px}.f1fx-section-head h2{font-size:1.17rem;letter-spacing:-.025em;margin:4px 0 0}.f1fx-section-head button{border:0;background:transparent;color:#dc2626;font:inherit;font-weight:750;cursor:pointer}.f1fx-last ol{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0;padding:0;list-style:none}.f1fx-last li{display:flex;flex-direction:column;gap:7px;padding:12px;border:1px solid #e5e7eb;border-radius:11px;font-size:.79rem}.f1fx-last li b{font-size:1rem;color:#dc2626}.f1fx-last li span{font-weight:750;line-height:1.2}.f1fx-last li em{font-style:normal;color:#64748b}.f1fx-panel-title{display:flex;align-items:end;justify-content:space-between;margin-bottom:13px}.f1fx-panel-title h2,.f1fx-info h2{font-size:1.4rem;letter-spacing:-.035em;margin:4px 0 0}.f1fx-panel-title p{font-size:.8rem;color:#64748b;margin:0}.f1fx-list{display:grid;gap:4px}.f1fx-race{display:grid;grid-template-columns:32px 32px 1fr auto 72px;align-items:center;gap:10px;border:1px solid #e5e7eb;border-radius:10px;padding:11px 12px;background:var(--surface,#fff)}.f1fx-race .round{font-size:.72rem;color:#94a3b8}.f1fx-race .flag{font-size:1.25rem}.f1fx-race small{display:block;color:#64748b;font-size:.76rem;margin-top:2px}.f1fx-race time{font-size:.78rem;color:#475569;text-align:right}.f1fx-race em{font-style:normal;font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;font-weight:850;color:#dc2626;text-align:right}.f1fx-race.done{opacity:.7}.f1fx-race.done em{color:#64748b}.f1fx-race.cancelled{opacity:.45}.f1fx-panel details,.f1fx-info details{border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;margin:6px 0;background:var(--surface,#fff)}.f1fx-panel summary,.f1fx-info summary{display:flex;justify-content:space-between;gap:12px;cursor:pointer;font-size:.86rem}.f1fx-panel summary time{color:#64748b;font-weight:500;white-space:nowrap}.f1fx-results{margin:11px 0 0;padding:0;list-style:none}.f1fx-results li{display:grid;grid-template-columns:28px 1fr auto;gap:9px;padding:8px 0;border-top:1px solid #eef2f7;font-size:.85rem}.f1fx-results b{color:#dc2626}.f1fx-results em{font-style:normal;color:#64748b;font-weight:750}.f1fx-standing{border:1px solid #e5e7eb;border-radius:10px;overflow:hidden}.f1fx-standing>div{display:grid;grid-template-columns:36px 1fr 1fr 54px;gap:8px;padding:11px 13px;border-top:1px solid #e5e7eb;align-items:center}.f1fx-standing .head{background:#f8fafc;border:0;font-size:.68rem;font-weight:850;text-transform:uppercase;color:#64748b}.f1fx-standing small{color:#64748b}.f1fx-standing strong{text-align:right}.f1fx-note{color:#64748b;font-size:.84rem}.f1fx-info{border-top:1px solid #e5e7eb;padding-top:32px;line-height:1.65}.f1fx-info p{color:#475569}@media(max-width:620px){.f1fx{padding-top:18px}.f1fx-intro{align-items:start;flex-direction:column;gap:12px}.f1fx-intro>p{text-align:left}.f1fx-bar{margin-inline:-16px;padding-inline:16px}.f1fx-zone span{display:none}.f1fx-tabs button{padding-inline:9px}.f1fx-next-top{padding:20px 17px 16px}.f1fx-next-bottom{padding:14px 17px 17px}.f1fx-live-tag{display:none}.f1fx-actions{grid-template-columns:1fr}.f1fx-last ol{grid-template-columns:repeat(3,1fr);gap:5px}.f1fx-last li{padding:10px 8px;font-size:.7rem}.f1fx-race{grid-template-columns:26px 30px 1fr 62px}.f1fx-race time{display:none}.f1fx-panel-title p{display:none}.f1fx-standing>div{grid-template-columns:28px 1fr 52px}.f1fx-standing small{display:none}.f1fx-panel summary time{font-size:.7rem}.f1fx-info{font-size:.94rem}}
</style>
