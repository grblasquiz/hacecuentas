---
// @incremental-standalone — página de estadísticas citables de inflación argentina.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import dataset from '../../public/datasets/inflacion-argentina-historica-mensual.json';

const URL = 'https://hacecuentas.com/estadisticas-inflacion-argentina';
const rows = (dataset.data as { fecha: string; inflacion_mensual_pct: number }[]).slice().sort((a, b) => a.fecha.localeCompare(b.fecha));
const nf = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 1 });
const pct = (v: number) => `${nf.format(v)}%`;
const monthName = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('es-AR', { month: 'long', year: 'numeric', timeZone: 'UTC' });

const first = rows[0], last = rows[rows.length - 1];
const maxMonth = rows.reduce((a, b) => (b.inflacion_mensual_pct > a.inflacion_mensual_pct ? b : a));
const minMonth = rows.reduce((a, b) => (b.inflacion_mensual_pct < a.inflacion_mensual_pct ? b : a));
const deflationMonths = rows.filter((r) => r.inflacion_mensual_pct < 0).length;
const over10 = rows.filter((r) => r.inflacion_mensual_pct >= 10).length;

const byYear = new Map<string, number[]>();
for (const r of rows) {
  const y = r.fecha.slice(0, 4);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(r.inflacion_mensual_pct);
}
const compound = (vs: number[]) => (vs.reduce((p, v) => p * (1 + v / 100), 1) - 1) * 100;
const annual = [...byYear.entries()].filter(([, vs]) => vs.length === 12).map(([year, vs]) => ({ year, value: compound(vs) }));
const topYears = annual.slice().sort((a, b) => b.value - a.value).slice(0, 10);
const lowYears = annual.slice().sort((a, b) => a.value - b.value).slice(0, 5);
const lastYears = annual.slice(-12).reverse();
const currentYear = last.fecha.slice(0, 4);
const ytd = compound(byYear.get(currentYear) || []);
const ytdMonths = (byYear.get(currentYear) || []).length;
const last12 = compound(rows.slice(-12).map((r) => r.inflacion_mensual_pct));
const decades = new Map<string, number[]>();
for (const { year, value } of annual) {
  const d = `${year.slice(0, 3)}0`;
  if (!decades.has(d)) decades.set(d, []);
  decades.get(d)!.push(value);
}
const decadeRows = [...decades.entries()].filter(([, vs]) => vs.length >= 5).map(([decade, vs]) => ({ decade: `Años ${decade}`, median: vs.slice().sort((a, b) => a - b)[Math.floor(vs.length / 2)], max: Math.max(...vs) })).reverse();
const recentMonths = rows.slice(-13).reverse();

const faqs = [
  { q: '¿Cuál fue la inflación de Argentina en los últimos 12 meses?', a: `Con datos del INDEC hasta ${monthName(last.fecha)}, la inflación acumulada de los últimos 12 meses es ${pct(last12)}. El último dato mensual fue ${pct(last.inflacion_mensual_pct)}.` },
  { q: `¿Cuánta inflación acumula Argentina en ${currentYear}?`, a: `En los primeros ${ytdMonths} meses de ${currentYear} la inflación acumulada es ${pct(ytd)}.` },
  { q: '¿Cuál fue el mes de mayor inflación en la historia argentina?', a: `${monthName(maxMonth.fecha)}, con ${pct(maxMonth.inflacion_mensual_pct)} mensual, en plena hiperinflación.` },
  { q: '¿Cuál fue el peor año de inflación en Argentina?', a: `${topYears[0].year}, con una inflación anual de ${pct(topYears[0].value)}. Le siguen ${topYears[1].year} (${pct(topYears[1].value)}) y ${topYears[2].year} (${pct(topYears[2].value)}).` },
  { q: '¿Argentina tuvo alguna vez deflación?', a: `Sí: de los ${rows.length} meses de la serie, ${deflationMonths} registraron variación negativa de precios. El récord es ${monthName(minMonth.fecha)}, con ${pct(minMonth.inflacion_mensual_pct)}.` },
  { q: '¿Cuántos meses superaron el 10% de inflación mensual?', a: `${over10} meses desde ${first.fecha.slice(0, 4)} tuvieron inflación mensual de dos dígitos (10% o más).` },
  { q: '¿De dónde salen estos datos?', a: `La serie combina el IPC oficial del INDEC con las series históricas empalmadas que publican los organismos estadísticos. Cubre desde ${monthName(first.fecha)} hasta ${monthName(last.fecha)}: ${rows.length} observaciones mensuales.` },
  { q: '¿Puedo descargar y reutilizar la serie completa?', a: 'Sí. El dataset está disponible en CSV y JSON bajo licencia CC BY 4.0: se puede citar y reutilizar con atribución y enlace a Hacé Cuentas.' },
];
const schema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'Article', headline: `Estadísticas de inflación en Argentina: ${rows.length} meses de datos`, description: `Serie histórica mensual de inflación argentina desde ${first.fecha.slice(0, 4)}: récords, hiperinflaciones, deflación y datos ${currentYear}.`, url: URL, datePublished: '2026-08-19', dateModified: dataset.generatedAt, author: { '@type': 'Person', name: 'Martín Rodríguez', url: 'https://hacecuentas.com/autores/martin-rodriguez' }, publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' } },
    { '@type': 'Dataset', name: 'Inflación mensual histórica de Argentina', description: `Serie mensual de inflación argentina: ${rows.length} observaciones desde ${first.fecha} hasta ${last.fecha}.`, url: URL, license: 'https://creativecommons.org/licenses/by/4.0/', temporalCoverage: `${first.fecha}/${last.fecha}`, spatialCoverage: 'Argentina', creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' }, isBasedOn: dataset.sourceUrl, distribution: [
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datasets/inflacion-argentina-historica-mensual.csv' },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datasets/inflacion-argentina-historica-mensual.json' },
    ] },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' }, { '@type': 'ListItem', position: 2, name: 'Estadísticas de inflación en Argentina', item: URL }] },
  ],
};
---

<Layout title={`Estadísticas de inflación en Argentina: ${rows.length} meses de datos (${first.fecha.slice(0, 4)}–${currentYear})`} description={`Inflación argentina en cifras: acumulada ${currentYear} ${pct(ytd)}, últimos 12 meses ${pct(last12)}, récord mensual ${pct(maxMonth.inflacion_mensual_pct)} en 1989. Serie completa descargable en CSV y JSON.`} canonical={URL} schema={schema} lang="es" audience="AR" ogType="article" articlePublishedTime="2026-08-19" articleModifiedTime={dataset.generatedAt} domain="data">
  <Header />
  <main class="stats-page">
    <article>
      <nav aria-label="Migas de pan"><a href="/">Inicio</a><span>›</span><span>Estadísticas de inflación</span></nav>
      <header class="hero">
        <p class="eyebrow">Investigación propia · Datos hasta {monthName(last.fecha)}</p>
        <h1>Estadísticas de inflación en Argentina: {rows.length} meses de historia</h1>
        <p class="lede">La serie mensual completa desde {monthName(first.fecha)}: hiperinflaciones, los pocos meses de deflación, los récords por década y los datos frescos de {currentYear}. Todos los números se recalculan automáticamente con cada actualización del INDEC.</p>
        <p class="scope"><strong>Fuente:</strong> IPC del INDEC y series históricas oficiales empalmadas. Dataset completo descargable más abajo (CC BY 4.0).</p>
      </header>

      <section aria-labelledby="resumen"><h2 id="resumen">Los números principales</h2><div class="metric-grid">
        <div><strong>{pct(last.inflacion_mensual_pct)}</strong><span>último dato mensual ({monthName(last.fecha)})</span></div>
        <div><strong>{pct(last12)}</strong><span>acumulada últimos 12 meses</span></div>
        <div><strong>{pct(ytd)}</strong><span>acumulada en {currentYear} ({ytdMonths} meses)</span></div>
        <div><strong>{pct(maxMonth.inflacion_mensual_pct)}</strong><span>récord mensual histórico ({monthName(maxMonth.fecha)})</span></div>
        <div><strong>{deflationMonths}</strong><span>meses con deflación desde {first.fecha.slice(0, 4)}</span></div>
        <div><strong>{over10}</strong><span>meses con inflación de dos dígitos</span></div>
      </div></section>

      <section><h2>Los 10 peores años de inflación</h2><p>Inflación anual compuesta a partir de los datos mensuales. La hiperinflación de 1989–1990 domina el ranking histórico.</p><ol class="ranking">{topYears.map((r) => <li><span>{r.year}</span><strong>{pct(r.value)}</strong></li>)}</ol></section>

      <section><h2>Los años de menor inflación</h2><ol class="ranking">{lowYears.map((r) => <li><span>{r.year}</span><strong>{pct(r.value)}</strong></li>)}</ol></section>

      <section><h2>Inflación anual reciente</h2><div class="table-wrap"><table><thead><tr><th>Año</th><th>Inflación anual</th></tr></thead><tbody>{lastYears.map((r) => <tr><th>{r.year}</th><td><strong>{pct(r.value)}</strong></td></tr>)}</tbody></table></div></section>

      <section><h2>Último año, mes a mes</h2><div class="table-wrap"><table><thead><tr><th>Mes</th><th>Inflación mensual</th></tr></thead><tbody>{recentMonths.map((r) => <tr><th>{monthName(r.fecha)}</th><td>{pct(r.inflacion_mensual_pct)}</td></tr>)}</tbody></table></div></section>

      <section><h2>Mediana y récord por década</h2><div class="table-wrap"><table><thead><tr><th>Década</th><th>Mediana anual</th><th>Peor año</th></tr></thead><tbody>{decadeRows.map((r) => <tr><th>{r.decade}</th><td>{pct(r.median)}</td><td>{pct(r.max)}</td></tr>)}</tbody></table></div></section>

      <section class="method"><h2>Metodología y límites</h2><p>La serie empalma el IPC nacional del INDEC con los índices históricos oficiales anteriores. La inflación anual se calcula componiendo los datos mensuales (no sumándolos). Los años incompletos no entran en los rankings anuales.</p><p><a href="/metodologia">Leé la metodología editorial completa</a>.</p></section>

      <section class="downloads"><h2>Descargar la serie completa</h2><p>{rows.length} observaciones mensuales, licencia CC BY 4.0: reutilizala con atribución y enlace a esta página.</p><div><a href="/datasets/inflacion-argentina-historica-mensual.csv" download>Descargar CSV</a><a href="/datasets/inflacion-argentina-historica-mensual.json" download>Descargar JSON</a></div></section>

      <section><h2>Cómo citar</h2><blockquote>Hacé Cuentas ({currentYear}). “Estadísticas de inflación en Argentina”. Serie mensual {first.fecha.slice(0, 4)}–{currentYear}, {rows.length} observaciones. {URL}</blockquote></section>

      <section><h2>Herramientas relacionadas</h2><ol class="ranking">
        <li><a href="/calculadora-actualizacion-inflacion-ipc">Actualizar un monto por inflación (IPC)</a><strong>Calculadora</strong></li>
        <li><a href="/inflacion-argentina">Inflación argentina hoy: dato vigente y evolución</a><strong>Datos</strong></li>
        <li><a href="/estadisticas-dolar-argentina">Estadísticas del dólar en Argentina</a><strong>Informe</strong></li>
        <li><a href="/estadisticas-plazo-fijo-uva-argentina">Estadísticas de plazo fijo y UVA</a><strong>Informe</strong></li>
      </ol></section>

      <section><h2>Preguntas frecuentes</h2>{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .stats-page{max-width:1080px;margin:0 auto;padding:clamp(1rem,3vw,2rem);color:var(--text,#18283a)}article>nav{display:flex;gap:.5rem;color:var(--text-muted,#64748b);font-size:.85rem}.hero{padding:clamp(2rem,6vw,4rem) 0}.eyebrow{color:var(--accent,#23648d);font-size:.78rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}h1{max-width:850px;margin:.4rem 0;font-size:clamp(2.3rem,7vw,4.4rem);line-height:1.02}.lede{max-width:820px;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.65}.scope{max-width:820px;padding:1rem;border-left:4px solid #2e7ca7;background:var(--bg-soft,#eef6fa)}section{margin:clamp(2.5rem,6vw,5rem) 0}h2{font-size:clamp(1.5rem,3vw,2.2rem)}.metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem}.metric-grid>div{display:flex;flex-direction:column;padding:1.2rem;border:1px solid var(--border,#dce3e9);border-radius:15px;background:var(--bg-card,#fff)}.metric-grid strong{font-size:clamp(1.7rem,4vw,2.6rem);color:var(--accent,#173c5d)}.metric-grid span{color:var(--text-muted,#526477);font-size:.85rem}.table-wrap{overflow-x:auto;border:1px solid var(--border,#dce3e9);border-radius:14px}table{width:100%;border-collapse:collapse}th,td{padding:.8rem 1rem;border-bottom:1px solid var(--border,#e5e7eb);text-align:right}th:first-child{text-align:left}.ranking{display:grid;gap:.55rem;padding:0;list-style:none}.ranking li{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-bottom:1px solid var(--border,#e5e7eb)}.ranking a{color:var(--accent,#23648d);font-weight:700}.method,.downloads{padding:clamp(1.25rem,3vw,2rem);border-radius:18px;background:var(--bg-soft,#f4f7f9)}.downloads div{display:flex;flex-wrap:wrap;gap:.75rem}.downloads a{padding:.8rem 1rem;border-radius:10px;background:#176b91;color:#fff;font-weight:800;text-decoration:none}blockquote{margin:0;padding:1.25rem;border-left:4px solid #2e7ca7;background:var(--bg-soft,#eef6fa);line-height:1.6}details{padding:1rem 0;border-bottom:1px solid var(--border,#dce3e9)}summary{cursor:pointer;font-weight:800}details p{line-height:1.65}@media(max-width:600px){th,td{padding:.65rem .55rem;font-size:.8rem}.ranking li{align-items:flex-start;flex-direction:column}}
</style>
