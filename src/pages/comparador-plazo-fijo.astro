---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { freeOfferSchema } from '../lib/offer-schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPlazoFijoTop, bancoColor } from '../lib/plazo-fijo';

const title = 'Comparador de Plazo Fijo Bancos Argentina 2026 | Hacé Cuentas';
const description = 'Compará la TNA de plazo fijo de los principales bancos argentinos en vivo. Ingresá capital y días y mirá cuánto rinde en cada banco, ordenado de mayor a menor.';

// Tasas en vivo (BCRA vía argentinadatos). Fallback de referencia si la API
// no responde en build. Sincronizado con /valores-bcra (misma fuente).
const liveBancos = await getPlazoFijoTop(14);
const FALLBACK = [
  { banco: 'Hipotecario', tna: 22.5 }, { banco: 'Macro', tna: 21.5 }, { banco: 'Provincia BA', tna: 21.5 },
  { banco: 'BBVA', tna: 20.5 }, { banco: 'ICBC', tna: 19.75 }, { banco: 'Credicoop', tna: 19.5 },
  { banco: 'Nación', tna: 19.0 }, { banco: 'Ciudad', tna: 19.0 }, { banco: 'Galicia', tna: 18.25 },
  { banco: 'Patagonia', tna: 18.0 }, { banco: 'Santander', tna: 16.5 },
];
const usandoLive = liveBancos.length > 0;
const bancos = (usandoLive ? liveBancos : FALLBACK).map((b) => ({ nombre: b.banco, tna: b.tna, color: bancoColor(b.banco) }));

const fmtArs = (n: number) => new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(n);
const pct = (n: number) => String(n).replace('.', ',');
const buildDate = new Date().toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' });
const builtAtISO = new Date().toISOString();

// Resultados por defecto ($1.000.000 a 30 días) server-rendered → la comparación
// es crawleable (antes el HTML mostraba "—" hasta que corría el JS). El JS los
// recalcula al cambiar capital/plazo.
const DEF_CAP = 1000000, DEF_DIAS = 30;
const ranked = bancos
  .map((b) => {
    const interes = DEF_CAP * (b.tna / 100) * (DEF_DIAS / 365);
    return { ...b, interes, total: DEF_CAP + interes, rend: (interes / DEF_CAP) * 100 };
  })
  .sort((a, b) => b.interes - a.interes);
const mejor = ranked[0];

const resumen = mejor
  ? `Hoy el plazo fijo que más paga es ${mejor.nombre}, con ${pct(mejor.tna)}% de TNA a 30 días. En $1.000.000 rinde ${fmtArs(Math.round(mejor.interes))} de interés (total ${fmtArs(Math.round(mejor.total))} al vencimiento). Tasas actualizadas al ${buildDate}.`
  : '';

const faqs: { q: string; a: string }[] = [
  {
    q: '¿Qué banco paga más por un plazo fijo hoy?',
    a: mejor
      ? `Según las tasas a 30 días, hoy el que más paga es <strong>${mejor.nombre}</strong> con <strong>${pct(mejor.tna)}% de TNA</strong>. Las entidades financieras más chicas suelen ofrecer tasas algo más altas que los bancos grandes para captar depósitos. Compará el rendimiento exacto para tu capital en la tabla de arriba, que se ordena sola de mayor a menor.`
      : 'Mirá la tabla de arriba: se ordena automáticamente de mayor a menor rendimiento según el capital y los días que ingreses.',
  },
  {
    q: '¿Cómo se calcula el interés de un plazo fijo?',
    a: 'Con la fórmula de <strong>interés simple</strong>: <code>Interés = Capital × (TNA / 100) × (días / 365)</code>. Por ejemplo, $1.000.000 a una TNA del 20% por 30 días genera 1.000.000 × 0,20 × 30/365 = <strong>$16.438</strong>. Al vencimiento cobrás el capital más ese interés. El plazo fijo tradicional no capitaliza: el interés se calcula una sola vez sobre el capital inicial.',
  },
  {
    q: '¿Qué diferencia hay entre TNA, TEM y TEA?',
    a: 'La <strong>TNA</strong> (Tasa Nominal Anual) es la que publica el banco y la base del cálculo. La <strong>TEM</strong> (Tasa Efectiva Mensual) es lo que rinde en 30 días (TNA × 30/365). La <strong>TEA</strong> (Tasa Efectiva Anual) asume que renovás el plazo fijo todo el año reinvirtiendo los intereses (capitalización compuesta), por lo que siempre es mayor que la TNA. Para comparar entre bancos a un mismo plazo alcanza con mirar la TNA.',
  },
  {
    q: '¿El plazo fijo le gana a la inflación en 2026?',
    a: 'Depende del mes. Si la inflación mensual es del 2% y tu plazo fijo a 30 días rinde una TEM del 1,6%, perdés contra la inflación; si rinde 2,5%, ganás en términos reales. Conviene comparar la TEM del banco contra la inflación esperada del mes. Para el cálculo de tasa real podés usar la <a href="/calculadora-interes-compuesto">calculadora de interés compuesto</a> y la <a href="/calculadora-inflacion-acumulada-periodo">calculadora de inflación acumulada</a>.',
  },
  {
    q: '¿Cuál es el monto y el plazo mínimo de un plazo fijo?',
    a: 'El <strong>plazo mínimo legal es de 30 días</strong>. No hay un monto mínimo regulado: muchos bancos y billeteras permiten constituir plazos fijos desde $1.000, aunque algunos piden montos mayores para acceder a la mejor tasa. Cuanto más largo el plazo, mayor suele ser la TNA ofrecida.',
  },
  {
    q: '¿Conviene un plazo fijo tradicional o uno UVA?',
    a: 'El <strong>tradicional</strong> paga una tasa fija conocida de antemano (la TNA del comparador) y tiene plazo mínimo de 30 días. El <strong>UVA</strong> ajusta el capital por inflación (índice CER) más un interés pequeño, con plazo mínimo de 180 días (o 90 con opción de precancelación). El UVA conviene si esperás inflación alta y podés inmovilizar la plata más tiempo; el tradicional, si necesitás liquidez en 30 días o esperás que la inflación baje.',
  },
  {
    q: '¿Puedo hacer un plazo fijo en un banco donde no soy cliente?',
    a: 'Sí. Desde 2019 cualquier persona puede constituir un <strong>plazo fijo online</strong> en un banco donde no tiene cuenta, transfiriendo el dinero por CBU/CVU desde su homebanking o billetera. El banco te devuelve el capital más los intereses a la misma cuenta de origen al vencimiento. Esto permite buscar la mejor tasa sin cambiar de banco.',
  },
  {
    q: '¿Las tasas de plazo fijo están reguladas por el BCRA?',
    a: 'Ya no. Hasta 2024 el BCRA fijaba una <strong>tasa mínima obligatoria</strong> para los plazos fijos minoristas. Esa regulación se eliminó, así que hoy cada banco define su propia TNA libremente y por eso hay diferencias de varios puntos entre entidades. Las tasas que ves acá se toman de los datos que las entidades reportan al BCRA.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Comparador de Plazo Fijo',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description,
  offers: freeOfferSchema(),
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
    { '@type': 'ListItem', position: 2, name: 'Finanzas', item: 'https://hacecuentas.com/categoria/finanzas' },
    { '@type': 'ListItem', position: 3, name: 'Comparador de plazo fijo', item: 'https://hacecuentas.com/comparador-plazo-fijo' },
  ],
};

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---
<Layout title={title} description={description} schema={schema} domain="data">
  <Header slot="header" />

  <article class="compare-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/categoria/finanzas">Finanzas</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Comparador de plazo fijo</span>
    </nav>

    <h1>Comparador de plazo fijo: bancos Argentina 2026</h1>
    <p class="lead">
      Ingresá <strong>capital</strong> y <strong>plazo en días</strong> y mirá en tiempo real cuánto rinde tu plazo fijo en cada banco, ordenado de mayor a menor.
    </p>

    {resumen && <p class="cmp-resumen">{resumen}</p>}

    <div class="compare-controls">
      <div class="control">
        <label for="capital">Capital a invertir</label>
        <div class="input-wrap">
          <span class="prefix">$</span>
          <input id="capital" type="text" inputmode="decimal" value="1000000" autocomplete="off" />
        </div>
      </div>
      <div class="control">
        <label for="dias">Plazo (días)</label>
        <div class="input-wrap">
          <input id="dias" type="number" min="30" max="365" step="1" value="30" />
          <span class="suffix">días</span>
        </div>
      </div>
    </div>

    <div class="results-table" role="table" aria-label="Resultados de plazo fijo por banco">
      <div class="tr head" role="row">
        <div role="columnheader">Banco</div>
        <div role="columnheader">TNA</div>
        <div role="columnheader">Interés ganado</div>
        <div role="columnheader">Total a recibir</div>
        <div role="columnheader">Rendimiento %</div>
      </div>
      {ranked.map((b, i) => (
        <div class={`tr body${i === 0 ? ' winner' : ''}`} role="row" data-tna={b.tna}>
          <div role="cell" class="bank-name"><span class="bank-dot" style={`background:${b.color}`}></span>{b.nombre}</div>
          <div role="cell" class="tna" data-label="TNA" data-tna-cell>{pct(b.tna)}%</div>
          <div role="cell" data-label="Interés ganado" data-interes>{fmtArs(Math.round(b.interes))}</div>
          <div role="cell" class="total" data-label="Total a recibir" data-total>{fmtArs(Math.round(b.total))}</div>
          <div role="cell" data-label="Rendimiento" data-rendimiento>{b.rend.toFixed(2).replace('.', ',')}%</div>
        </div>
      ))}
    </div>

    <p class="compare-note">
      <strong>Datos {usandoLive ? 'en vivo' : 'de referencia'}</strong> — TNA de plazo fijo tradicional a 30 días que las entidades reportan al BCRA{usandoLive ? '' : ' (valores de referencia)'}, actualizadas al <time datetime={builtAtISO}>{buildDate}</time>. Verificá con tu banco antes de invertir: las tasas pueden variar día a día. Los resultados son estimativos (interés simple).
    </p>

    <section class="compare-extra">
      <h2>Cómo funciona el comparador</h2>
      <p>
        El rendimiento de un plazo fijo tradicional en Argentina se calcula con la fórmula de <strong>interés simple</strong>: <code>Interés = Capital × (TNA/100) × (días/365)</code>. La TNA (Tasa Nominal Anual) es la que publica cada banco; en 2026 la mayoría de las entidades ofrece entre <strong>16% y 23% anual</strong> para plazos a 30 días, muy por debajo de la tasa de política monetaria del BCRA tras la eliminación de la tasa mínima obligatoria en 2024.
      </p>
      <p>
        <strong>Ganarle a la inflación</strong> es el desafío real: si la inflación mensual es 2% y el plazo fijo te paga una TEM de 2,5%, ganás medio punto real. Para el cálculo de tasa real usá la <a href="/calculadora-interes-compuesto">calculadora de interés compuesto</a> o la <a href="/calculadora-inflacion-acumulada-periodo">calculadora de inflación</a>. Para un análisis individual, la <a href="/calculadora-plazo-fijo">calculadora de plazo fijo</a> te da TEA, interés diario y mensual equivalente. Y para ver el contexto de tasas, dólar e inflación, mirá el panel de <a href="/valores-bcra">valores BCRA hoy</a>.
      </p>
      <h2>¿Qué banco elegir?</h2>
      <p>
        La diferencia de TNA entre el banco que más paga y el que menos paga suele ser de <strong>4 a 6 puntos</strong>. En $1.000.000 a 30 días eso representa entre $3.000 y $5.000 de diferencia. Acá listamos los <strong>bancos más reconocidos</strong> para que compares entre entidades donde probablemente ya operás; algunas compañías financieras más chicas ofrecen tasas algo más altas, pero implican abrir cuenta en una entidad menos conocida. Si ya tenés cuenta en un banco conviene comparar antes de mover plata, porque muchas veces no vale la pena el trámite por pocos pesos. Varios bancos ofrecen además <strong>TNA preferencial</strong> para clientes con sueldo depositado, jubilados o montos altos (+$10M).
      </p>
    </section>

    <section class="faq-section">
      <h2>Preguntas frecuentes sobre plazo fijo</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <div class="faq-answer" set:html={f.a}></div>
          </details>
        ))}
      </div>
    </section>

    <div class="compare-cta">
      <h3>¿Querés más detalle de un banco en particular?</h3>
      <p>Usá la <a href="/calculadora-plazo-fijo">calculadora de plazo fijo</a> individual para ver TEA, interés diario y mensual equivalente.</p>
    </div>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaFaq)}></script>

  <Footer slot="footer" />
</Layout>

<script>
  const capitalEl = document.getElementById('capital') as HTMLInputElement;
  const diasEl = document.getElementById('dias') as HTMLInputElement;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.tr.body'));
  const tableContainer = document.querySelector<HTMLElement>('.results-table')!;

  function parseThousands(v: string): number {
    return Number(v.replace(/\./g, '').replace(/,/g, '.'));
  }
  function formatThousands(v: string): string {
    const clean = v.replace(/[^\d]/g, '');
    if (!clean) return '';
    return new Intl.NumberFormat('es-AR').format(Number(clean));
  }
  function fmtAr(n: number): string {
    return new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(n);
  }

  capitalEl.addEventListener('input', () => {
    const cursor = capitalEl.selectionStart || 0;
    const prev = capitalEl.value.length;
    capitalEl.value = formatThousands(capitalEl.value);
    const diff = capitalEl.value.length - prev;
    capitalEl.setSelectionRange(cursor + diff, cursor + diff);
    recalc();
  });
  diasEl.addEventListener('input', recalc);
  capitalEl.value = formatThousands(capitalEl.value);

  function recalc() {
    const capital = parseThousands(capitalEl.value);
    const dias = Number(diasEl.value);
    if (!capital || !dias) return;

    const results = rows.map((row) => {
      const tna = Number(row.dataset.tna);
      const interes = capital * (tna / 100) * (dias / 365);
      const total = capital + interes;
      const rend = (interes / capital) * 100;
      return { row, tna, interes, total, rend };
    });

    results.sort((a, b) => b.interes - a.interes);
    results.forEach((r) => tableContainer.appendChild(r.row));

    results.forEach((r, idx) => {
      r.row.querySelector('[data-interes]')!.textContent = fmtAr(Math.round(r.interes));
      r.row.querySelector('[data-total]')!.textContent = fmtAr(Math.round(r.total));
      r.row.querySelector('[data-rendimiento]')!.textContent = r.rend.toFixed(2).replace('.', ',') + '%';
      r.row.classList.toggle('winner', idx === 0);
    });
  }

  recalc();
</script>

<style>
  .compare-page { max-width: 960px; margin: 0 auto; padding: 0 0 3rem; }
  .breadcrumbs { font-size: 0.875rem; color: var(--text-subtle); margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .breadcrumbs a { color: var(--text-muted); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }
  .breadcrumbs .sep { color: var(--border-strong); }

  h1 { margin-bottom: 0.75rem; }
  .lead { font-size: 1.0625rem; color: var(--text-muted); margin-bottom: 1.25rem; max-width: 720px; }
  .cmp-resumen {
    margin: 0 0 1.75rem;
    padding: 0.9rem 1.1rem;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 760px;
  }

  .compare-controls {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow);
  }
  .control { display: flex; flex-direction: column; gap: 0.4375rem; }
  .control label { font-weight: 500; font-size: 0.875rem; }

  .input-wrap {
    display: flex;
    align-items: stretch;
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .input-wrap:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .input-wrap input {
    flex: 1; padding: 0.6875rem 0.875rem; background: transparent; border: none; outline: none;
    font-size: 0.9375rem; font-feature-settings: 'tnum'; color: var(--text); min-width: 0;
  }
  .prefix, .suffix {
    padding: 0 0.75rem; background: var(--bg-muted); color: var(--text-subtle);
    font-size: 0.875rem; font-weight: 500; display: flex; align-items: center;
  }
  .prefix { border-right: 1px solid var(--border); }
  .suffix { border-left: 1px solid var(--border); }

  .results-table {
    display: grid;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
    box-shadow: var(--shadow);
    margin-bottom: 1.25rem;
  }
  .tr {
    display: grid;
    grid-template-columns: 1.6fr 0.8fr 1.5fr 1.5fr 1fr;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    font-size: 0.9375rem;
    border-bottom: 1px solid var(--border);
  }
  .tr:last-child { border-bottom: none; }
  .tr.head {
    background: var(--bg-soft);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tr.body { transition: background 0.2s; font-feature-settings: 'tnum'; position: relative; }
  .tr.body:hover { background: var(--bg-soft); }
  .tr.body.winner { background: var(--success-soft); font-weight: 600; }
  .tr.body.winner .total { color: var(--success); }
  .tr.body [role="cell"]::before { display: none; } /* labels solo en mobile */

  .bank-name { display: flex; align-items: center; gap: 0.5rem; font-weight: 500; }
  .bank-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .tna { font-weight: 600; color: var(--accent-strong); }
  .total { font-weight: 600; }

  .compare-note {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    padding: 0.875rem 1rem;
    background: var(--bg-soft);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    margin-bottom: 2rem;
  }

  .compare-extra { padding: 1.5rem 0; border-top: 1px solid var(--border); }
  .compare-extra h2 { margin-top: 1.5rem; font-size: 1.375rem; }
  .compare-extra h2:first-child { margin-top: 0; }
  .compare-extra p { margin-bottom: 0.875rem; color: var(--text-muted); }
  .compare-extra code {
    background: var(--bg-soft); padding: 0.125rem 0.375rem; border-radius: 4px;
    font-family: var(--font-mono); font-size: 0.875rem;
  }

  /* FAQ */
  .faq-section { padding: 1.5rem 0; border-top: 1px solid var(--border); }
  .faq-section h2 { font-size: 1.375rem; margin-bottom: 1rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-card); }
  .faq-item summary {
    padding: 0.875rem 1.125rem; cursor: pointer; font-weight: 600; font-size: 0.9375rem;
    color: var(--text); list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] summary { border-bottom: 1px solid var(--border); }
  .faq-answer { padding: 0.875rem 1.125rem; font-size: 0.9375rem; color: var(--text-muted); line-height: 1.65; }
  .faq-answer code { background: var(--bg-soft); padding: 0.1rem 0.35rem; border-radius: 4px; font-family: var(--font-mono); font-size: 0.85em; }
  .faq-answer a { color: var(--accent); }

  .compare-cta {
    margin-top: 2rem; padding: 1.5rem; background: var(--accent-soft);
    border: 1px solid var(--accent); border-radius: var(--radius-lg); text-align: center;
  }
  .compare-cta h3 { color: var(--accent-strong); margin-bottom: 0.5rem; }

  /* ── Mobile: la tabla de 5 columnas se transforma en tarjetas apiladas ── */
  @media (max-width: 640px) {
    .compare-controls { grid-template-columns: 1fr; padding: 1rem; }

    .results-table {
      display: flex; flex-direction: column; gap: 0.75rem;
      border: none; background: transparent; box-shadow: none; border-radius: 0; overflow: visible;
    }
    .tr.head { display: none; }
    .tr.body {
      display: block;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-card);
      padding: 0.875rem 1rem;
      font-size: 0.9375rem;
    }
    .tr.body.winner { border-color: var(--success); box-shadow: 0 0 0 1px var(--success); }
    .tr.body.winner::before {
      content: '🏆 Mejor tasa';
      position: absolute; top: -0.65rem; right: 0.75rem;
      background: var(--success); color: #fff;
      font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.02em;
      padding: 0.15rem 0.5rem; border-radius: 99px;
    }
    .tr.body .bank-name {
      font-size: 1.0625rem; font-weight: 700;
      padding-bottom: 0.5rem; margin-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    .tr.body [role="cell"]:not(.bank-name) {
      display: flex; align-items: baseline; justify-content: space-between;
      padding: 0.3rem 0;
    }
    .tr.body [role="cell"]:not(.bank-name)::before {
      display: block;
      content: attr(data-label);
      color: var(--text-muted); font-size: 0.8125rem; font-weight: 500;
    }
    .tr.body .tna { color: var(--accent-strong); }
  }
</style>
