---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { categoryDomain } from '../../lib/category-colors';
import { freeOfferSchema } from '../../lib/offer-schema';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Calculator from '../../components/Calculator.astro';
import RelatedCalcs from '../../components/RelatedCalcs.astro';
import CalcLayoutV2 from '../../components/CalcLayoutV2.astro';
import ReferenceTables from '../../components/ReferenceTables.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import LiveData from '../../components/LiveData.astro';
import { md, mdInline } from '../../lib/markdown';
import ogManifest from '../../lib/og-manifest.json';
import { findMentions, findPrimaryAbout } from '../../lib/wikidata-entities';
import { filterByIncremental } from '../../lib/incremental';
import { buildHreflangCluster, findVersionByEsSlug } from '../../lib/hreflang';

export async function getStaticPaths() {
  const calcs = import.meta.glob<any>('../../content/calcs-py/*.json', { eager: true });
  const all = Object.values(calcs).map((mod: any) => mod.default || mod);
  return filterByIncremental(all, 'calcs', 'py').map((c: any) => ({
    params: { slug: c.slug },
    props: { calc: c },
  }));
}

const { calc } = Astro.props;

const categoryLabels: Record<string, string> = {
  finanzas: 'Finanzas',
  impuestos: 'Impuestos',
  familia: 'Familia',
  negocios: 'Negocios',
  negocio: 'Negocios',
  salud: 'Salud',
  marketing: 'Marketing',
  deportes: 'Deportes',
  viajes: 'Viajes',
  vida: 'Vida cotidiana',
  mascotas: 'Mascotas',
  matematica: 'Matemáticas',
  construccion: 'Construcción',
  cocina: 'Cocina',
  educacion: 'Educación',
  automotor: 'Automotriz',
  tecnologia: 'Tecnología',
  'medio-ambiente': 'Medio Ambiente',
  electronica: 'Electrónica',
};

// OG image: manifest pre-build. output:'server' corre el frontmatter en Workers
// runtime sin node:fs — usar fs directo rompe HTMLs con "Illegal invocation"
// de miniflare bajo carga durante prerender.
let ogImage = '/og-default.png';
if ((ogManifest as Record<string, boolean>)[calc.slug]) {
  ogImage = `/og/${calc.slug}.png`;
}

// dateModified: lastReviewed > dataUpdate.lastUpdated > build date.
let dateModified: string;
let lastReviewedLabel: string;
const _dataUpdateLast = calc.dataUpdate?.lastUpdated;
if (calc.lastReviewed && /^\d{4}-\d{2}-\d{2}$/.test(calc.lastReviewed)) {
  dateModified = new Date(calc.lastReviewed + 'T00:00:00Z').toISOString();
} else if (_dataUpdateLast && /^\d{4}-\d{2}-\d{2}$/.test(_dataUpdateLast)) {
  dateModified = new Date(_dataUpdateLast + 'T00:00:00Z').toISOString();
} else {
  dateModified = new Date().toISOString();
}
lastReviewedLabel = new Date(dateModified).toLocaleDateString('es-PY', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
// datePublished opcional: viene de calc.datePublished si está declarada.
// Si no, omitimos el campo del schema (JSON.stringify ignora undefined).
const _rawDatePub = calc.datePublished;
const datePublished: string | undefined = typeof _rawDatePub === 'string' && /^\d{4}-\d{2}-\d{2}(T.*)?$/.test(_rawDatePub)
  ? (_rawDatePub.length === 10 ? new Date(_rawDatePub + 'T00:00:00Z').toISOString() : _rawDatePub)
  : undefined;

// audience: 'PY' (país-específico) o 'global' (aplica a cualquier país).
const audience: 'PY' | 'global' = calc.audience === 'PY' ? 'PY' : 'global';

const schemaHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: calc.h1,
  description: calc.description,
  totalTime: 'PT1M',
  inLanguage: 'es-PY',
  step: calc.fields.map((f: any, i: number) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: f.label,
    text: f.help || `Enter ${f.label.toLowerCase()}`,
    url: `https://hacecuentas.com/py/${calc.slug}#paso-${i + 1}`,
    ...(ogImage !== '/og-default.png' ? { image: `https://hacecuentas.com${ogImage}` } : {}),
  })),
};

const schemaFAQ = calc.faq && calc.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.faq-list summary', '.faq-list details > div'],
  },
  mainEntity: calc.faq.map((f: any) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
} : null;

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/py/' },
    { '@type': 'ListItem', position: 2, name: categoryLabels[calc.category] || calc.category, item: 'https://hacecuentas.com/py/' },
    { '@type': 'ListItem', position: 3, name: calc.h1 },
  ],
};

// SoftwareApplication + WebApplication
const schemaApp = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'WebApplication'],
  name: calc.h1,
  description: calc.description,
  url: `https://hacecuentas.com/py/${calc.slug}`,
  mainEntityOfPage: `https://hacecuentas.com/py/${calc.slug}`,
  applicationCategory: 'UtilitiesApplication',
  applicationSubCategory: 'Calculator',
  operatingSystem: 'Any (Web)',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  inLanguage: 'es-PY',
  isAccessibleForFree: true,
  datePublished,
  dateModified,
  offers: freeOfferSchema({ priceCurrency: 'USD', validFrom: datePublished || dateModified }),
  image: {
    '@type': 'ImageObject',
    url: `https://hacecuentas.com${ogImage}`,
    width: 1200,
    height: 630,
  },
  screenshot: `https://hacecuentas.com${ogImage}`,
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
  },
  mentions: findMentions(`${calc.h1 || ''} ${(Array.isArray(calc.seoKeywords) ? calc.seoKeywords : []).join(' ')}`),
  ...(findPrimaryAbout(calc.h1 || '') ? { about: findPrimaryAbout(calc.h1 || '') } : {}),
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: [
      '.answer-snippet',
      '.aeo-quick-answer', '.calc-intro', '.calc-key-takeaway',
      '#como-funciona p:first-of-type',
      '#faq dt', '#faq dd',
      '.use-cases li', '#cuando-usar p',
    ],
  },
  citation: calc.sources?.map((s: any) => s.url || s.name).filter(Boolean) || [],
};

// Article schema for YMYL categories
const isYMYL = ['finanzas', 'salud', 'negocios', 'mascotas'].includes(calc.category);
const schemaArticle = (isYMYL || (calc.explanation && calc.explanation.length > 1500)) ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: calc.h1,
  description: calc.description,
  url: `https://hacecuentas.com/py/${calc.slug}`,
  mainEntityOfPage: `https://hacecuentas.com/py/${calc.slug}`,
  image: `https://hacecuentas.com${ogImage}`,
  inLanguage: 'es-PY',
  datePublished,
  dateModified,
  author: {
    '@type': 'Person',
    '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person',
    name: 'Martín Rodríguez',
    url: 'https://hacecuentas.com/autores/martin-rodriguez',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://hacecuentas.com/og-default.png',
    },
  },
  about: categoryLabels[calc.category] || calc.category,
  articleSection: categoryLabels[calc.category] || calc.category,
  wordCount: calc.explanation ? calc.explanation.split(/\s+/).filter(Boolean).length : 0,
  isAccessibleForFree: true,
  citation: calc.sources?.map((s: any) => s.url || s.name).filter(Boolean) || [],
} : null;

const schemaGraph: any[] = [schemaHowTo, schemaBreadcrumb, schemaApp];
if (schemaFAQ) schemaGraph.push(schemaFAQ);
if (schemaArticle) schemaGraph.push(schemaArticle);

// MedicalWebPage / LearningResource — categoría 'salud' / 'educacion'.
// Bing y Copilot priorizan schema médico/educativo para esos queries.

const schemaDescription = (calc.description || calc.h1 || '').slice(0, 500);

if (calc.category === 'medio-ambiente') {
  schemaGraph.push({
    '@type': 'CreativeWork',
    name: calc.h1,
    description: schemaDescription,
    url: `https://hacecuentas.com/py/${calc.slug}`,
    inLanguage: 'es-PY',
    about: [
      { '@type': 'Thing', name: 'Climate change', sameAs: 'https://www.wikidata.org/wiki/Q7942' },
      { '@type': 'Thing', name: 'Sustainability', sameAs: 'https://www.wikidata.org/wiki/Q219416' },
      { '@type': 'Thing', name: 'Carbon footprint', sameAs: 'https://www.wikidata.org/wiki/Q1054116' },
    ],
    keywords: 'huella carbono, sostenibilidad, medio ambiente, CO2, emisiones',
    datePublished: (datePublished || dateModified).split('T')[0],
    dateModified: dateModified.split('T')[0],
    publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by/4.0/',
  });
}

if (calc.category === 'salud') {
  schemaGraph.push({
    '@type': 'MedicalWebPage',
    name: calc.h1,
    description: schemaDescription,
    url: `https://hacecuentas.com/py/${calc.slug}`,
    inLanguage: 'es-PY',
    datePublished: (datePublished || dateModified).split('T')[0],
    dateModified: dateModified.split('T')[0],
    lastReviewed: (calc.lastReviewed || dateModified.split('T')[0]),
    audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
    medicalAudience: 'Patient',
    publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
    specialty: { '@type': 'MedicalSpecialty', name: 'General medicine' },
  });
}
if (calc.category === 'educacion') {
  schemaGraph.push({
    '@type': 'LearningResource',
    name: calc.h1,
    description: schemaDescription,
    url: `https://hacecuentas.com/py/${calc.slug}`,
    inLanguage: 'es-PY',
    learningResourceType: 'Calculator',
    educationalUse: 'Practice',
    audience: { '@type': 'EducationalAudience', educationalRole: 'student' },
    datePublished: (datePublished || dateModified).split('T')[0],
    dateModified: dateModified.split('T')[0],
    publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
    isAccessibleForFree: true,
  });
}

const schema = { '@context': 'https://schema.org', '@graph': schemaGraph };

const updated = lastReviewedLabel;

// Tiempo de lectura: ~250 palabras/minuto en español
const wordCount = calc.explanation ? calc.explanation.split(/\s+/).length : 0;
const readingMin = Math.max(1, Math.round(wordCount / 250));

// Optional SEO fields
const sources: Array<{ name: string; url?: string }> = calc.sources || [];
const useCases: string[] = calc.useCases || [];
const example: { title?: string; steps?: string[]; result?: string } | null = calc.example || null;
const keyTakeaway: string = calc.keyTakeaway || '';
const relatedSlugs: string[] = calc.relatedSlugs || [];

// Lookup for related links — cargar calcs mexicanas
const allCalcsModules = import.meta.glob<any>('../../content/calcs-py/*.json', { eager: true });
const allCalcs = Object.values(allCalcsModules).map((m: any) => m.default || m);
const relatedContextual = relatedSlugs
  .map((s) => allCalcs.find((c) => c.slug === s))
  .filter(Boolean);

// TOC: top-level rendered sections (in order of appearance)
const tocSections: Array<{ id: string; label: string }> = [
  { id: 'calculator', label: 'Calculadora' },
];
if (keyTakeaway) tocSections.push({ id: 'summary', label: 'En pocas palabras' });
if (useCases.length > 0) tocSections.push({ id: 'when-to-use', label: 'Cuándo usar' });
if (example && example.steps) tocSections.push({ id: 'example', label: 'Ejemplo paso a paso' });
if (calc.explanation) tocSections.push({ id: 'how-it-works', label: 'Cómo funciona' });
if (calc.faq && calc.faq.length > 0) tocSections.push({ id: 'faq', label: 'Preguntas frecuentes' });
if (sources.length > 0) tocSections.push({ id: 'sources', label: 'Fuentes' });

// Heuristic LaTeX detection in explanation (to conditionally load KaTeX)
const hasMath = calc.explanation && /(\$[^$\n]+\$|\\frac|\\sqrt|\\sum|\\times|\\cdot)/.test(calc.explanation);

// Pre-filled subject for "Report error"
const reportSubject = encodeURIComponent(`Error en /py/${calc.slug}`);
const reportBody = encodeURIComponent(
  `Hi Martín,\n\nI found an error in the calculator "${calc.h1}":\n\nURL: https://hacecuentas.com/py/${calc.slug}\nInput data: \nExpected result: \nActual result: \nSource / reference: \n\nThank you.`
);

// hreflang unificado: resolver TODO el cluster vía esSlug compartido
// (ES raíz + EN + PT + verticales) para declarar un set IDÉNTICO al de la
// página ES raíz, con UN solo x-default → versión ES. Ver src/lib/hreflang.ts.
// Calc EC-specific (sin esSlug) → undefined → fallback del Layout (es-PY + x-default self).
const esSlug = calc.esSlug;
const enModulesHreflang = import.meta.glob<any>('../../content/calcs-en/*.json', { eager: true });
const enCalcHreflang: any = findVersionByEsSlug(Object.values(enModulesHreflang).map((m: any) => m.default || m), esSlug);
const ptModulesHreflang = import.meta.glob<any>('../../content/calcs-pt/*.json', { eager: true });
const ptCalcHreflang: any = findVersionByEsSlug(Object.values(ptModulesHreflang).map((m: any) => m.default || m), esSlug);
const mxModulesHreflang = import.meta.glob<any>('../../content/calcs-mx/*.json', { eager: true });
const mxCalcHreflang: any = findVersionByEsSlug(Object.values(mxModulesHreflang).map((m: any) => m.default || m), esSlug, true);
const esModulesHreflang = import.meta.glob<any>('../../content/calcs-es/*.json', { eager: true });
const esCalcHreflang: any = findVersionByEsSlug(Object.values(esModulesHreflang).map((m: any) => m.default || m), esSlug, true);
const coModulesHreflang = import.meta.glob<any>('../../content/calcs-co/*.json', { eager: true });
const coCalcHreflang: any = findVersionByEsSlug(Object.values(coModulesHreflang).map((m: any) => m.default || m), esSlug, true);
const clModulesHreflang = import.meta.glob<any>('../../content/calcs-cl/*.json', { eager: true });
const clCalcHreflang: any = findVersionByEsSlug(Object.values(clModulesHreflang).map((m: any) => m.default || m), esSlug, true);
const peModulesHreflang = import.meta.glob<any>('../../content/calcs-pe/*.json', { eager: true });
const peCalcHreflang: any = findVersionByEsSlug(Object.values(peModulesHreflang).map((m: any) => m.default || m), esSlug);
const hreflangTags = buildHreflangCluster({
  es: esSlug,
  en: enCalcHreflang?.slug,
  pt: ptCalcHreflang?.slug,
  mx: mxCalcHreflang?.slug,
  esEs: esCalcHreflang?.slug,
  co: coCalcHreflang?.slug,
  cl: clCalcHreflang?.slug,
  pe: peCalcHreflang?.slug,
  py: calc.slug,
});
---

<Layout
  title={calc.title}
  description={calc.description}
  schema={schema}
  image={ogImage}
  lang="es"
  audience="PY"
  hreflang={hreflangTags}
  noindex={calc.noindex === true}
  domain={categoryDomain(calc.category)}
>
  <Header slot="header" />

  <CalcLayoutV2 calc={calc} lang="py" />

  <ScrollToTop />

  <Footer slot="footer" />
</Layout>
