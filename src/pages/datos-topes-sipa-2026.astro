---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE_IMPONIBLE_MAXIMA_APORTES } from '../lib/formulas/sueldo-ar';

// Página-dato enlazable: tope de la base imponible de aportes SIPA (Ley 24.241 art. 9).
// La constante viene de la fuente única src/lib/formulas/sueldo-ar.ts — la misma que
// usan las ~18 calcs de sueldo/aguinaldo del sitio → un solo lugar a actualizar por mes.
// Patrón espejado de /datos-monotributo-2026: tabla server-rendered + schema Dataset +
// CC-BY 4.0 + bloque "Cómo citar".

const ULTIMA_REVISION = '2026-07-09';
const VIGENCIA = 'junio 2026 (Resolución ANSES 139/2026)';

const TOPE = BASE_IMPONIBLE_MAXIMA_APORTES; // $4.414.652,38 — jun-2026
const TOPE_SAC = TOPE / 2; // el aguinaldo (media remuneración) topea a media base

const fmtARS = (n: number, dec = 0) =>
  '$' + n.toLocaleString('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec });

// Aportes personales y su valor máximo mensual (sobre la base topeada).
const APORTES = [
  { concepto: 'Jubilación (SIPA)', tasa: 0.11 },
  { concepto: 'Obra social', tasa: 0.03 },
  { concepto: 'PAMI (INSSJP)', tasa: 0.03 },
];
const TASA_TOTAL = APORTES.reduce((a, b) => a + b.tasa, 0); // 17%
const aporteMaxTotal = TOPE * TASA_TOTAL;

// Ejemplos: cómo opera el tope según el bruto.
const EJEMPLOS_BRUTOS = [2_000_000, 3_000_000, 4_000_000, TOPE, 5_000_000, 7_000_000, 12_000_000];
const ejemplos = EJEMPLOS_BRUTOS.map((bruto) => {
  const base = Math.min(bruto, TOPE);
  const aportes = base * TASA_TOTAL;
  return {
    bruto,
    base,
    aportes,
    pctEfectivo: (aportes / bruto) * 100,
    topeado: bruto > TOPE,
  };
});

const title =
  'Datos topes SIPA 2026: base imponible máxima de aportes (jubilación, obra social, PAMI) | Hacé Cuentas';
const description =
  `Base imponible máxima de aportes personales en Argentina (Ley 24.241 art. 9): ${fmtARS(TOPE, 2)} en junio 2026. Tabla con el aporte máximo de jubilación (11%), obra social (3%) y PAMI (3%), cómo opera el tope en sueldos altos y en el aguinaldo. Uso libre con atribución (CC-BY 4.0).`;

const PAGE_URL = 'https://hacecuentas.com/datos-topes-sipa-2026';

const faq = [
  {
    q: '¿Cuál es la base imponible máxima de aportes en 2026?',
    a: `${fmtARS(TOPE, 2)} mensuales en junio 2026 (Resolución ANSES 139/2026, conforme Ley 24.241 art. 9). Por encima de ese bruto, los aportes personales se calculan sobre el tope, no sobre el sueldo completo.`,
  },
  {
    q: '¿Qué significa que los aportes "topean"?',
    a: `Que jubilación (11%), obra social (3%) y PAMI (3%) se descuentan sobre el sueldo bruto SOLO hasta ${fmtARS(TOPE, 2)}. Si ganás más, el excedente no paga aportes: el descuento máximo posible por estos tres conceptos es ${fmtARS(aporteMaxTotal, 2)} por mes, gane lo que gane el trabajador.`,
  },
  {
    q: '¿Desde qué sueldo deja de aplicar el 17% pleno?',
    a: `Exactamente desde ${fmtARS(TOPE, 2)} de bruto mensual. Debajo de ese valor, el descuento de aportes es el 17% del bruto; arriba, el porcentaje efectivo baja: con un bruto de ${fmtARS(12_000_000)}, los aportes son ${fmtARS(TOPE * TASA_TOTAL)} (un ${((TOPE * TASA_TOTAL / 12_000_000) * 100).toFixed(1)}% del bruto, no 17%).`,
  },
  {
    q: '¿El tope aplica también al aguinaldo?',
    a: `Sí, a media base: como el SAC es media remuneración, su base imponible máxima es ${fmtARS(TOPE_SAC, 2)} (la mitad del tope mensual). Un aguinaldo mayor a ese monto paga aportes sólo hasta ahí.`,
  },
  {
    q: '¿El Impuesto a las Ganancias también topea?',
    a: `No. El tope de la Ley 24.241 aplica únicamente a los aportes de seguridad social (jubilación, obra social, PAMI). Ganancias se calcula sobre toda la remuneración (neta de aportes y deducciones), sin techo: para sueldos altos, Ganancias pasa a ser el descuento dominante.`,
  },
  {
    q: '¿Cada cuánto se actualiza el tope?',
    a: `Todos los meses, por la movilidad previsional atada al IPC (Decreto 274/2024). El valor de esta página corresponde a ${VIGENCIA}; ANSES publica el del mes siguiente junto con los haberes previsionales.`,
  },
  {
    q: '¿A quiénes NO les aplica este tope?',
    a: `A los regímenes que no aportan al SIPA con estas reglas: personal militar y de fuerzas de seguridad, empleados públicos provinciales o municipales con cajas propias, casas particulares (régimen especial con valores fijos) y monotributistas (componente previsional fijo en la cuota). En esos casos, el cálculo es distinto.`,
  },
  {
    q: '¿Existe también una base imponible mínima?',
    a: `Sí, la Ley 24.241 fija además una base mínima (cercana al haber mínimo del sistema), relevante para aportes voluntarios y trabajadores de muy baja remuneración. Esta página documenta la máxima, que es la que cambia el cálculo del neto en sueldos altos.`,
  },
  {
    q: '¿Puedo usar estos datos en mi web, nota o trabajo?',
    a: `Sí. Se publican bajo licencia Creative Commons CC-BY 4.0: podés reproducirlos libremente citando la fuente con un enlace a hacecuentas.com. Más abajo está el bloque "Cómo citar".`,
  },
];

const datasetSchema = {
  '@type': 'Dataset',
  '@id': `${PAGE_URL}#dataset`,
  name: 'Base imponible máxima de aportes SIPA — Argentina, junio 2026',
  description:
    `Tope de la base imponible para aportes personales (jubilación 11%, obra social 3%, PAMI 3%) según Ley 24.241 art. 9: ${fmtARS(TOPE, 2)} mensuales en junio 2026, con aporte máximo por concepto y ejemplos de aplicación. Fuente: ANSES.`,
  url: PAGE_URL,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  inLanguage: 'es-AR',
  dateModified: ULTIMA_REVISION,
  temporalCoverage: '2026-06',
  spatialCoverage: { '@type': 'Place', name: 'Argentina' },
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  sourceOrganization: {
    '@type': 'GovernmentOrganization',
    name: 'ANSES',
    url: 'https://www.argentina.gob.ar/trabajo/seguridadsocial/imss',
  },
  keywords: ['SIPA', 'Base imponible máxima', 'Aportes', 'Ley 24.241', 'ANSES', 'Argentina', '2026'],
  variableMeasured: [
    'Base imponible máxima mensual (ARS)', 'Tasa de aporte por concepto',
    'Aporte máximo mensual por concepto (ARS)',
  ],
  identifier: 'https://hacecuentas.com/datos/topes-sipa-2026.json',
  version: '2026',
  distribution: [
    { '@type': 'DataDownload', name: 'Topes SIPA 2026 (JSON)', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datos/topes-sipa-2026.json' },
    { '@type': 'DataDownload', name: 'Topes SIPA 2026 (CSV)', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datos/topes-sipa-2026.csv' },
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${PAGE_URL}#webpage`,
      name: title,
      description,
      url: PAGE_URL,
      inLanguage: 'es-AR',
      dateModified: ULTIMA_REVISION,
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
      mainEntity: { '@id': `${PAGE_URL}#dataset` },
    },
    datasetSchema,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Datos topes SIPA 2026', item: PAGE_URL },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="/datos-topes-sipa-2026"
  audience="AR"
  schema={schema}
  domain="data"
>
  <Header slot="header" />

  <main class="article-main">
    <article class="page-content datos-page">
      <header class="article-header">
        <nav class="crumbs" aria-label="Migas de pan">
          <a href="/">Inicio</a> <span>›</span> <span>Datos topes SIPA 2026</span>
        </nav>
        <h1>Topes SIPA 2026: base imponible máxima de aportes</h1>
        <p class="lede">
          En Argentina, los aportes personales (jubilación 11% + obra social 3% + PAMI 3%) no se
          calculan sobre todo el sueldo: la <strong>Ley 24.241 (art. 9)</strong> fija una
          <strong> base imponible máxima</strong> de <strong>{fmtARS(TOPE, 2)}</strong> mensuales
          (junio 2026). Arriba de ese bruto, el descuento se congela y el neto real es mayor que
          "bruto − 17%".
        </p>
        <p class="updated">
          Última revisión: <time datetime={ULTIMA_REVISION}>{new Date(ULTIMA_REVISION).toLocaleDateString('es-AR')}</time> ·
          Datos al: {VIGENCIA} · se actualiza todos los meses por IPC ·
          Licencia <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC-BY 4.0</a>
        </p>
      </header>

      <section class="stats-callout" aria-label="Datos destacados">
        <div class="stat">
          <span class="stat-num">{fmtARS(TOPE, 2)}</span>
          <span class="stat-label">base máxima mensual (jun. 2026)</span>
        </div>
        <div class="stat">
          <span class="stat-num">{fmtARS(aporteMaxTotal, 2)}</span>
          <span class="stat-label">aporte máximo total (17%)</span>
        </div>
        <div class="stat">
          <span class="stat-num">{fmtARS(TOPE_SAC, 2)}</span>
          <span class="stat-label">base máxima del aguinaldo (½)</span>
        </div>
        <div class="stat">
          <span class="stat-num">17%</span>
          <span class="stat-label">aportes (11 + 3 + 3)</span>
        </div>
      </section>

      <section>
        <h2>Aporte máximo por concepto (junio 2026)</h2>
        <p>
          Los tres aportes personales usan la <strong>misma</strong> base máxima. Esto es lo máximo
          que puede descontarse por cada concepto en un mes:
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Concepto</th>
                <th>Alícuota</th>
                <th>Aporte máximo mensual</th>
              </tr>
            </thead>
            <tbody>
              {APORTES.map((a) => (
                <tr>
                  <td data-label="Concepto">{a.concepto}</td>
                  <td data-label="Alícuota">{(a.tasa * 100).toLocaleString('es-AR')}%</td>
                  <td data-label="Máximo">{fmtARS(TOPE * a.tasa, 2)}</td>
                </tr>
              ))}
              <tr>
                <td data-label="Concepto"><strong>Total aportes</strong></td>
                <td data-label="Alícuota"><strong>{(TASA_TOTAL * 100).toLocaleString('es-AR')}%</strong></td>
                <td data-label="Máximo"><strong>{fmtARS(aporteMaxTotal, 2)}</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="note">
          Máximos = alícuota × base imponible máxima ({fmtARS(TOPE, 2)}). No incluye cuota
          sindical (varía por gremio) ni el Impuesto a las Ganancias, que no tiene tope.
        </p>
      </section>

      <section>
        <h2>Cómo opera el tope según tu sueldo bruto</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Sueldo bruto</th>
                <th>Base de aportes</th>
                <th>Aportes (17%)</th>
                <th>% efectivo del bruto</th>
              </tr>
            </thead>
            <tbody>
              {ejemplos.map((e) => (
                <tr>
                  <td data-label="Bruto"><strong>{fmtARS(e.bruto, e.bruto === TOPE ? 2 : 0)}</strong>{e.bruto === TOPE ? ' (tope)' : ''}</td>
                  <td data-label="Base">{fmtARS(e.base, e.topeado || e.bruto === TOPE ? 2 : 0)}</td>
                  <td data-label="Aportes">{fmtARS(e.aportes)}</td>
                  <td data-label="% efectivo">{e.pctEfectivo.toLocaleString('es-AR', { maximumFractionDigits: 1 })}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          Debajo del tope, el % efectivo es siempre 17%. Arriba, baja porque el aporte queda fijo
          en {fmtARS(aporteMaxTotal, 2)} mientras el bruto sigue subiendo.
        </p>
      </section>

      <section>
        <h2>Qué hay que saber del tope</h2>
        <ul class="cambios">
          <li>
            <strong>Se actualiza todos los meses.</strong> La base máxima sigue la movilidad
            previsional por IPC (Decreto 274/2024). El valor de esta página es el de {VIGENCIA}.
          </li>
          <li>
            <strong>El aguinaldo topea a media base.</strong> Como el SAC es media remuneración,
            su base de aportes máxima es {fmtARS(TOPE_SAC, 2)}.
          </li>
          <li>
            <strong>Ganancias no topea.</strong> El impuesto se calcula sobre toda la remuneración
            neta de aportes; en sueldos muy altos, es el descuento dominante.
          </li>
          <li>
            <strong>No aplica a regímenes especiales.</strong> Militares y fuerzas de seguridad,
            cajas provinciales/municipales, casas particulares y monotributo tienen reglas propias.
          </li>
        </ul>
      </section>

      <section>
        <h2>Aportes que topean y contribuciones que no</h2>
        <p>
          Un punto que confunde a muchos: el tope de {fmtARS(TOPE, 2)} limita los
          <strong>aportes personales</strong> del trabajador (el 17% que aparece descontado en el
          recibo), pero <strong>no</strong> las <strong>contribuciones patronales</strong> que paga
          el empleador. Esas contribuciones se calculan sobre la remuneración completa, sin techo.
          Por eso el tope tiene dos efectos distintos según de qué lado se mire: para el trabajador,
          el descuento por seguridad social se congela en {fmtARS(aporteMaxTotal, 2)}; para la
          empresa, el costo laboral sigue creciendo con cada peso de sueldo bruto.
        </p>
        <p>
          La consecuencia práctica es la que más importa a la hora de negociar un sueldo: superado
          el tope, cada aumento de bruto se traduce casi íntegramente en más neto de bolsillo por el
          lado previsional, porque los aportes ya no crecen. Lo único que sigue subiendo es el
          Impuesto a las Ganancias, que no tiene tope. Por eso el neto real de un sueldo alto casi
          nunca es "bruto − 17%": termina siendo mayor de lo que sugiere la cuenta rápida.
        </p>
      </section>

      <section>
        <h2>Un solo tope por recibo: qué pasa con el pluriempleo</h2>
        <p>
          La base imponible máxima se aplica <strong>por cada relación laboral</strong>, es decir,
          por cada recibo de sueldo. Con un solo empleo, nadie paga aportes sobre una base mayor a
          {fmtARS(TOPE, 2)} en el mes. Pero quien tiene <strong>dos o más empleos en relación de
          dependencia</strong> (pluriempleo) puede encontrarse con que cada empleador le retiene
          aportes hasta el tope por separado, de modo que la suma retenida supere el máximo que le
          correspondería como una sola persona.
        </p>
        <p>
          Para esos casos, la normativa previsional prevé un mecanismo de <strong>reconocimiento y
          ajuste</strong> de los aportes retenidos en exceso: el trabajador puede informar su
          situación de pluriempleo para que la retención combinada se limite al tope único. Si es tu
          caso, conviene revisar ambos recibos y consultar con el área de liquidación de sueldos o
          con ANSES antes de dar por perdido lo retenido de más.
        </p>
      </section>

      <section>
        <h2>Calculá tu caso</h2>
        <p>
          Las calculadoras de sueldo de este sitio ya aplican este tope automáticamente:
        </p>
        <ul class="calc-links">
          <li><a href="/sueldo-en-mano-argentina">Sueldo en mano (neto) Argentina</a></li>
          <li><a href="/simulador-recibo-de-sueldo-argentina">Simulador de recibo de sueldo</a></li>
          <li><a href="/calculadora-sueldo-bruto-desde-neto">Sueldo bruto desde el neto</a></li>
          <li><a href="/calculadora-aguinaldo-sac">Calculadora de aguinaldo (SAC)</a></li>
        </ul>
        <p>
          Más tablas de datos: <a href="/datos-ganancias-2026">escala de Ganancias 2026</a> ·
          <a href="/datos-aguinaldo-2026">aguinaldo (SAC) 2026</a> ·
          <a href="/datos-monotributo-2026">monotributo 2026</a>.
        </p>
      </section>

      <section class="cite-instructions" aria-label="Descargar datos">
        <h2>Descargar estos datos</h2>
        <p>Datos abiertos (CC-BY 4.0), listos para usar en tu app, planilla o análisis:</p>
        <p>
          <a href="/datos/topes-sipa-2026.json" download>⬇ Descargar JSON</a> ·
          <a href="/datos/topes-sipa-2026.csv" download>⬇ Descargar CSV</a>
        </p>
      </section>

      <section class="cite-instructions">
        <h2>Cómo citar este dato</h2>
        <p>¿Usás estos datos en una nota, trabajo, app o web? La atribución pedida es:</p>
        <pre><code>Fuente: Hacé Cuentas — https://hacecuentas.com/datos-topes-sipa-2026
Base imponible máxima ANSES · Licencia CC-BY 4.0</code></pre>
        <p>
          Si publicás online, te agradecemos el enlace a
          <a href="https://hacecuentas.com/datos-topes-sipa-2026">hacecuentas.com/datos-topes-sipa-2026</a>.
        </p>
      </section>

      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <section class="fuentes">
        <h2>Fuentes</h2>
        <ul>
          <li>
            <a href="https://www.argentina.gob.ar/trabajo/seguridadsocial/imss" rel="nofollow noopener" target="_blank">ANSES — Bases imponibles mínima y máxima</a> (Resolución ANSES 139/2026, vigencia junio 2026)
          </li>
          <li>Ley 24.241, art. 9 (base imponible de aportes) · Decreto 274/2024 (movilidad mensual por IPC).</li>
        </ul>
      </section>
    </article>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .datos-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem 1rem 4rem;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-bottom: 0.75rem;
  }
  .crumbs a { color: var(--accent, #2563eb); text-decoration: none; }
  .datos-page h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text, #222);
  }
  .updated {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-top: 0.5rem;
  }
  .datos-page h2 {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .stats-callout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin: 1.75rem 0;
  }
  .stat {
    background: var(--bg-soft, #f4f6f9);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 0.6rem;
    padding: 0.9rem 1rem;
    text-align: center;
  }
  .stat-num {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent, #2563eb);
    line-height: 1.2;
  }
  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted, #666);
    margin-top: 0.25rem;
  }
  .table-wrap { overflow-x: auto; margin: 1.25rem 0; }
  .datos-page table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    min-width: 540px;
  }
  .datos-page th {
    background: var(--bg-soft, #f1f5f9);
    padding: 0.6rem 0.7rem;
    text-align: right;
    font-weight: 600;
    border-bottom: 2px solid var(--border, #e5e7eb);
    white-space: nowrap;
  }
  .datos-page th:first-child { text-align: left; }
  .datos-page td {
    padding: 0.55rem 0.7rem;
    text-align: right;
    border-bottom: 1px solid var(--border, #eee);
    white-space: nowrap;
  }
  .datos-page td:first-child { text-align: left; }
  .datos-page tbody tr:nth-child(odd) { background: var(--bg-card, #fafafa); }
  .note {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-top: 0.5rem;
  }
  .cambios li, .calc-links li, .fuentes li { line-height: 1.7; margin-bottom: 0.5rem; }
  .cambios, .calc-links, .fuentes ul { margin-left: 1.25rem; }
  .calc-links a, .fuentes a { color: var(--accent, #2563eb); }
  .cite-instructions {
    margin-top: 2.5rem;
    padding: 1.1rem;
    background: var(--bg-soft, #f4f6f9);
    border-radius: 0.6rem;
  }
  .cite-instructions pre {
    background: var(--code-bg, #eaeef3);
    padding: 0.75rem;
    border-radius: 0.4rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }
