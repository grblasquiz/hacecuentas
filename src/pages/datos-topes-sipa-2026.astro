---
export const prerender = true;
import { SIPA_PERIODS, SIPA_CURRENT } from '../lib/data/sipa-2026';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TopesSipaExperience from '../components/generated/TopesSipaExperience.astro';
const current = SIPA_PERIODS[SIPA_CURRENT];
const description = `Base imponible máxima SIPA de $${current.cap.toLocaleString('es-AR')} (${current.label}, ${current.rule}). Consultá el aporte máximo y el tope del aguinaldo con datos de ANSES.`;
const canonical = 'https://hacecuentas.com/datos-topes-sipa-2026';
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:'Topes SIPA 2026',url:canonical,applicationCategory:'FinanceApplication',operatingSystem:'Web'};
---
<Layout title="Topes SIPA 2026: base imponible máxima y aportes al tope" description={description} canonical={canonical} schema={schema} audience="AR" lang="es" ogType="article" articleSection="Datos">
  <Header />
  <TopesSipaExperience />
  <Footer />
</Layout>
