---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const calcModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
const allCalcs = Object.values(calcModules).map((m: any) => m.default || m);
const bySlug = new Map(allCalcs.map((c: any) => [c.slug, c]));

const groups: Array<{ title: string; icon: string; intro: string; slugs: string[] }> = [
  {
    title: 'Clasificación y formato 48 selecciones',
    icon: '🏆',
    intro: 'El Mundial 2026 estrena formato 48 selecciones y 12 grupos. Estas calculadoras te explican el reglamento nuevo, los puntos que necesita tu selección y cómo se ordenan los mejores terceros.',
    slugs: [
      'calculadora-mundial-2026-puntos-clasificar-octavos',
      'calculadora-mundial-2026-cupos-confederacion',
      'calculadora-mundial-2026-grupo-muerte-detector',
      'calculadora-mundial-2026-diferencia-gol-desempate',
      'calculadora-mundial-2026-fixture-octavos-posicion-grupo',
      'calculadora-mundial-2026-puntaje-historico-fase-grupos',
    ],
  },
  {
    title: 'Probabilidades y predicciones',
    icon: '📊',
    intro: 'Calculá las chances reales de tu selección de pasar la fase de grupos, llegar a la final o ganar el Mundial — basado en ranking FIFA, sorteo, histórico y ELO.',
    slugs: [
      'calculadora-mundial-2026-predictor-campeon-ranking',
      'calculadora-mundial-2026-probabilidad-clasificacion-ranking-fifa',
      'calculadora-mundial-2026-probabilidad-bicampeon',
      'calculadora-mundial-2026-probabilidad-ganar-penales',
      'calculadora-mundial-2026-comparador-selecciones-ranking',
      'calculadora-mundial-2026-goles-argentina-repetir-titulo',
    ],
  },
  {
    title: 'Reglas del juego',
    icon: '⚽',
    intro: 'Amarillas, suspensiones, prórroga, tiempo añadido y todo lo que define un partido del Mundial.',
    slugs: [
      'calculadora-mundial-2026-tarjetas-suspension',
      'calculadora-mundial-2026-descanso-entre-partidos',
      'calculadora-mundial-2026-goles-prorroga-promedio',
      'calculadora-tiempo-anadido-promedio-mundial-2026-liga',
    ],
  },
  {
    title: 'Plata, premios y bonus',
    icon: '💰',
    intro: 'Cuánto reparte FIFA por cada fase, cuánto cobra cada jugador, cuánto vale un viaje completo y cuántos dólares se mueven en derechos de TV.',
    slugs: [
      'calculadora-premios-mundial-2026-seleccion-por-fase',
      'calculadora-mundial-2026-bonus-jugador-fase',
      'calculadora-derechos-tv-mundial-2026-argentina-espana-mexico-brasil',
      'calculadora-mundial-2026-presupuesto-hincha-total',
    ],
  },
  {
    title: 'Viaje, entradas y experiencia',
    icon: '✈️',
    intro: 'Si vas al Mundial, estas calcs te ayudan a presupuestar todo: vuelos, entradas, estadios, comida en la cancha y horarios de partidos.',
    slugs: [
      'calculadora-mundial-2026-costo-viaje-miami-toronto-cdmx',
      'calculadora-mundial-2026-costo-entrada-fase',
      'calculadora-mundial-2026-estadios-comparador',
      'calculadora-mundial-2026-cerveza-comida-estadio-precio',
      'calculadora-mundial-2026-horario-partido-zona-horaria',
      'calculadora-mundial-2026-dias-hasta-debut-seleccion',
      'calculadora-mundial-2026-partidos-faltantes-seleccion',
    ],
  },
  {
    title: 'Fan, quinielas y fantasy',
    icon: '🎯',
    intro: 'Si lo vivís de hincha o lo apostás con amigos, estas son las calculadoras para vos.',
    slugs: [
      'calculadora-mundial-2026-quiniela-pool-probabilidad',
      'calculadora-fantasy-mundial-2026-mejor-once',
      'calculadora-mundial-2026-dream-team-once-combinaciones',
      'calculadora-mundial-2026-horas-tv-cronograma-fan',
      'calculadora-mundial-2026-camiseta-precio-comparador',
    ],
  },
  {
    title: 'Jugadores, goleadores y récords',
    icon: '⭐',
    intro: 'Messi, el botín de oro, los récords históricos y cuántos goles te imaginás que vas a ver.',
    slugs: [
      'calculadora-mundial-2026-record-messi-goles-minutos',
      'calculadora-mundial-2026-botin-oro-goleador-estimador',
      'calculadora-top-10-goleadores-historico-mundial-fifa',
      'cuanto-falta-mundial-fifa-2026-2030',
    ],
  },
];

// Resolver y filtrar
const resolvedGroups = groups.map((g) => ({
  ...g,
  items: g.slugs.map((s) => bySlug.get(s)).filter(Boolean),
}));
const totalItems = resolvedGroups.reduce((acc, g) => acc + g.items.length, 0);

const title = `Mundial 2026 — ${totalItems}+ calculadoras: probabilidades, puntos, viaje, premios | Hacé Cuentas`;
const description = `Todas las calculadoras del Mundial 2026 en un solo lugar: clasificación, probabilidades de tu selección, reglas del juego, presupuesto de viaje, entradas, fantasy, jugadores y récords. Actualizadas a 2026 con formato 48 selecciones.`;
const canonical = '/mundial-2026';

// ItemList schema con todas las calcs
const allItems = resolvedGroups.flatMap((g) => g.items);
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Calculadoras Mundial 2026',
  description,
  numberOfItems: allItems.length,
  itemListElement: allItems.map((c: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://hacecuentas.com/${c.slug}`,
    name: c.h1,
  })),
};

// CollectionPage schema
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Calculadoras Mundial 2026',
  description,
  url: `https://hacecuentas.com${canonical}`,
  inLanguage: 'es-AR',
  about: {
    '@type': 'SportsEvent',
    name: 'Copa Mundial de la FIFA 2026',
    startDate: '2026-06-11',
    endDate: '2026-07-19',
    location: [
      { '@type': 'Country', name: 'Estados Unidos' },
      { '@type': 'Country', name: 'México' },
      { '@type': 'Country', name: 'Canadá' },
    ],
    organizer: { '@type': 'Organization', name: 'FIFA' },
  },
  isPartOf: { '@type': 'WebSite', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
};

const schema = { '@context': 'https://schema.org', '@graph': [itemListSchema, collectionSchema] };

// Countdown info
const debut = new Date('2026-06-11T00:00:00Z');
const today = new Date();
const daysToDebut = Math.max(0, Math.ceil((debut.getTime() - today.getTime()) / (1000 * 60 * 60 * 24)));
---

<Layout title={title} description={description} canonical={canonical} audience="global" schema={schema}>
  <Header />
  <main class="wc-page">
    <section class="wc-hero">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> ARCHIVO FINAL · MUNDIAL 2026</p>
        <h1>El Mundial terminó.<br /><em>Las cuentas quedaron.</em></h1>
        <p class="lede">Resultados, estadísticas y <strong>{totalItems} calculadoras</strong> para entender todo lo que dejó el primer Mundial de 48 selecciones.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/fixture-mundial-2026">Ver todos los resultados <b>→</b></a>
          <a class="button button-secondary" href="#herramientas">Explorar herramientas</a>
        </div>
        <dl class="facts">
          <div><dt>104</dt><dd>partidos</dd></div>
          <div><dt>48</dt><dd>selecciones</dd></div>
          <div><dt>16</dt><dd>ciudades sede</dd></div>
        </dl>
      </div>
      <aside class="archive-card">
        <div class="archive-top"><span>EL TORNEO EN NÚMEROS</span><span>2026</span></div>
        <div class="ball" aria-hidden="true">⚽</div>
        <strong>Todo el Mundial.<br />Sin vueltas.</strong>
        <p>Resultados, tabla, goleadores y la llave completa.</p>
        <nav aria-label="Resumen del torneo">
          <a href="/campeon-mundial-2026"><span>Campeón y palmarés</span><b>→</b></a>
          <a href="/goleadores-mundial-2026"><span>Tabla de goleadores</span><b>→</b></a>
          <a href="/llave-mundial-2026"><span>Llave final</span><b>→</b></a>
        </nav>
      </aside>
    </section>

    <nav class="score-strip" aria-label="Accesos rápidos">
      <span>ASÍ TERMINÓ</span>
      <a href="/fixture-mundial-2026"><small>RESULTADOS</small><b>Los 104 partidos</b></a>
      <a href="/posiciones-mundial-2026"><small>POSICIONES</small><b>Tabla final</b></a>
      <a href="/campeon-mundial-2026"><small>HISTORIA</small><b>Campeón y palmarés</b></a>
    </nav>

    <section class="wc-section intentions">
      <header class="section-head">
        <div><p class="kicker">TODO EN UN LUGAR</p><h2>¿Qué querés saber?</h2></div>
        <p>Entrá por lo que necesitás. Sin recorrer listas interminables.</p>
      </header>
      <div class="intent-grid">
        <a class="intent dark" href="/fixture-mundial-2026"><small>01</small><i>✓</i><h3>Cómo terminó</h3><p>Resultados, posiciones, llave final y campeón.</p><b>Ver resultados <span>→</span></b></a>
        <a class="intent lime" href="#herramientas"><small>02</small><i>=</i><h3>Hacer una cuenta</h3><p>Viaje, premios, probabilidades y reglas.</p><b>Usar calculadoras <span>→</span></b></a>
        <a class="intent sand" href="/goleadores-mundial-2026"><small>03</small><i>↗</i><h3>Descubrir datos</h3><p>Goleadores, récords y números curiosos.</p><b>Explorar estadísticas <span>→</span></b></a>
      </div>
    </section>

    <section class="wc-results">
      <div class="results-inner">
        <header class="section-head">
          <div><p class="kicker">EL TORNEO COMPLETO</p><h2>Resultados y selecciones</h2></div>
          <a href="/fixture-mundial-2026">Ver los 104 partidos →</a>
        </header>
        <div class="result-links">
          <a href="/posiciones-mundial-2026"><span class="result-icon">#</span><div><small>FASE DE GRUPOS</small><strong>Posiciones finales</strong></div><b>→</b></a>
          <a href="/llave-mundial-2026"><span class="result-icon">8</span><div><small>ELIMINACIÓN DIRECTA</small><strong>La llave completa</strong></div><b>→</b></a>
          <a href="/cuando-juega-argentina-mundial-2026"><span class="result-icon">AR</span><div><small>SELECCIONES</small><strong>El camino de Argentina</strong></div><b>→</b></a>
        </div>
      </div>
    </section>

    <section class="wc-section tools" id="herramientas">
      <header class="section-head">
        <div><p class="kicker">HACÉ TUS CUENTAS</p><h2>Herramientas del Mundial</h2></div>
        <p>Explicadas simple, con fuentes y sin registro.</p>
      </header>
      <nav class="tool-nav" aria-label="Categorías de herramientas">
        {resolvedGroups.map((g, i) => <a class:list={{ active: i === 0 }} href={`#${g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{g.title.replace(' 48 selecciones', '')}</a>)}
      </nav>
      {resolvedGroups.map((g) => {
        const id = g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        return g.items.length > 0 && (
          <section class="tool-group" id={id}>
            <header><div><span>{g.icon}</span><h3>{g.title}</h3></div><p>{g.intro}</p></header>
            <ul class="tool-grid">
              {g.items.map((c: any) => (
                <li><a href={`/${c.slug}`}><div class="tool-top"><span>{c.icon || '⚽'}</span><small>CALCULADORA</small></div><strong>{c.h1}</strong><p>{c.description}</p><b>Abrir herramienta →</b></a></li>
              ))}
            </ul>
          </section>
        );
      })}
      <aside class="suggest"><div><p class="kicker">¿FALTA UNA CUENTA?</p><h2>Pedinos la próxima herramienta</h2></div><p>Contanos qué querés calcular y la sumamos al sitio.</p><a href="mailto:ideas@hacecuentas.com?subject=Calculadora Mundial 2026">Sugerir calculadora →</a></aside>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  :global(body){background:#f5f5ef}.wc-page{--ink:#121a2d;--blue:#173fdb;--lime:#d8ff5f;--paper:#f5f5ef;--muted:#697083;--line:#dcddd7;color:var(--ink);background:var(--paper)}
  .wc-hero{max-width:1180px;margin:auto;display:grid;grid-template-columns:1.35fr .65fr;gap:76px;padding:76px 20px 70px;align-items:center}.eyebrow,.kicker{font-size:11px;font-weight:800;letter-spacing:.13em;color:var(--blue);margin:0}.eyebrow span{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--blue);margin-right:8px}.wc-hero h1{font-size:clamp(48px,6vw,78px);letter-spacing:-.065em;line-height:.95;margin:22px 0 24px;color:var(--ink)}.wc-hero h1 em{font-style:normal;color:var(--blue)}.lede{font-size:19px;line-height:1.55;color:#596174;max-width:680px}.hero-actions{display:flex;gap:12px;margin:32px 0}.button{padding:14px 18px;border-radius:10px;font-weight:750;font-size:14px;text-decoration:none}.button-primary{background:var(--blue);color:white}.button-primary b{margin-left:18px}.button-secondary{background:white;border:1px solid var(--line);color:var(--ink)}.facts{display:flex;margin:46px 0 0;border-top:1px solid var(--line);padding-top:22px;max-width:600px}.facts div{padding-right:34px;margin-right:34px;border-right:1px solid var(--line)}.facts div:last-child{border:0}.facts dt{font-size:24px;font-weight:800;letter-spacing:-.04em}.facts dd{margin:0;font-size:12px;color:var(--muted)}
  .archive-card{background:var(--ink);color:white;min-height:450px;border-radius:18px;padding:24px;box-shadow:15px 15px 0 var(--lime);position:relative;overflow:hidden}.archive-card:before{content:"";position:absolute;width:260px;height:260px;border:1px solid #ffffff18;border-radius:50%;right:-60px;top:40px}.archive-top{display:flex;justify-content:space-between;font-size:10px;font-weight:800;letter-spacing:.12em;color:#b8bfce}.ball{font-size:54px;margin:48px 0 24px}.archive-card>strong{display:block;font-size:32px;line-height:1.05;letter-spacing:-.04em}.archive-card>p{font-size:13px;color:#aeb6c7;margin:12px 0 28px}.archive-card nav{border-top:1px solid #ffffff20}.archive-card nav a{display:flex;justify-content:space-between;color:white;text-decoration:none;padding:13px 0;border-bottom:1px solid #ffffff20;font-size:12px;font-weight:700}
  .score-strip{min-height:74px;background:var(--blue);color:white;display:flex;align-items:center;justify-content:center;padding:0 20px}.score-strip>span,.score-strip>a{padding:0 30px;border-right:1px solid #ffffff30}.score-strip>span{font-size:10px;font-weight:800;letter-spacing:.13em}.score-strip a{display:flex;gap:9px;text-decoration:none;color:white}.score-strip small{color:#b7c6ff;font-size:9px;letter-spacing:.08em}.score-strip b{font-size:12px}
  .wc-section,.results-inner{max-width:1140px;margin:auto;padding:96px 20px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:38px}.section-head h2{font-size:42px;letter-spacing:-.05em;margin:7px 0 0;color:var(--ink)}.section-head>p{max-width:320px;margin:0;color:var(--muted);font-size:14px;line-height:1.5}.section-head>a{font-size:13px;color:var(--blue);font-weight:700;text-decoration:none}.intent-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.intent{min-height:300px;border-radius:14px;padding:24px;display:flex;flex-direction:column;color:var(--ink);text-decoration:none;transition:transform .18s}.intent:hover,.tool-grid a:hover{transform:translateY(-3px)}.intent.dark{background:var(--ink);color:white}.intent.lime{background:var(--lime)}.intent.sand{background:#ece5d8}.intent small{font-size:10px;opacity:.55;font-weight:800}.intent i{width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:#ffffff26;border:1px solid #ffffff32;font-size:23px;font-style:normal;margin:34px 0 25px}.lime i,.sand i{background:#ffffff77;border-color:#00000012}.intent h3{font-size:25px;letter-spacing:-.04em;margin:0 0 8px}.intent p{font-size:14px;line-height:1.5;opacity:.7;max-width:230px}.intent>b{font-size:12px;margin-top:auto}.intent>b span{float:right}
  .wc-results{background:white}.results-inner{padding-top:72px;padding-bottom:80px}.result-links{border-top:2px solid var(--ink)}.result-links>a{display:grid;grid-template-columns:70px 1fr 40px;align-items:center;border-bottom:1px solid var(--line);min-height:82px;text-decoration:none;color:var(--ink)}.result-icon{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#eef1ff;color:var(--blue);font-size:12px;font-weight:800}.result-links div{display:flex;justify-content:space-between;align-items:center}.result-links small{font-size:9px;color:var(--muted);letter-spacing:.1em;font-weight:800}.result-links strong{font-size:17px}.result-links>b{color:var(--blue)}
  .tool-nav{display:flex;gap:7px;overflow:auto;margin:-10px 0 42px;padding-bottom:2px}.tool-nav a{border:1px solid var(--line);border-radius:30px;padding:8px 14px;white-space:nowrap;text-decoration:none;color:var(--muted);font-size:12px}.tool-nav a.active{background:var(--ink);border-color:var(--ink);color:white}.tool-group{scroll-margin-top:20px;margin:0 0 72px}.tool-group>header{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;border-bottom:1px solid var(--line);padding-bottom:18px;margin-bottom:18px}.tool-group>header>div{display:flex;align-items:center;gap:12px}.tool-group>header span{font-size:22px}.tool-group h3{font-size:25px;letter-spacing:-.035em;margin:0}.tool-group>header p{font-size:13px;line-height:1.45;color:var(--muted);margin:0}.tool-grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tool-grid li{margin:0}.tool-grid a{background:white;border:1px solid #e4e5df;border-radius:13px;padding:22px;min-height:240px;display:flex;flex-direction:column;text-decoration:none;color:var(--ink);transition:transform .18s;height:100%}.tool-top{display:flex;justify-content:space-between;align-items:center}.tool-top>span{width:42px;height:42px;border-radius:10px;background:#eef1ff;display:grid;place-items:center}.tool-top small{font-size:9px;letter-spacing:.12em;color:#8b91a0;font-weight:800}.tool-grid strong{font-size:18px;line-height:1.25;letter-spacing:-.025em;margin:26px 0 8px}.tool-grid p{font-size:13px;line-height:1.45;color:var(--muted);margin:0 0 18px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.tool-grid b{font-size:12px;color:var(--blue);margin-top:auto}.suggest{background:var(--blue);color:white;border-radius:17px;padding:42px;display:grid;grid-template-columns:1fr 1fr auto;gap:35px;align-items:center}.suggest .kicker{color:var(--lime)}.suggest h2{color:white;font-size:27px;letter-spacing:-.04em;margin:7px 0 0}.suggest>p{font-size:13px;color:#bdc9f7}.suggest>a{background:var(--lime);color:var(--ink);padding:13px 17px;border-radius:9px;font-size:12px;font-weight:800;text-decoration:none}
  @media(max-width:800px){.wc-hero{grid-template-columns:1fr;padding-top:48px;gap:42px}.wc-hero h1{font-size:49px}.lede{font-size:16px}.hero-actions{flex-direction:column}.button{text-align:center}.facts div{padding-right:18px;margin-right:18px}.archive-card{min-height:420px;box-shadow:8px 8px 0 var(--lime)}.score-strip{justify-content:flex-start;overflow:auto}.score-strip>span,.score-strip>a{white-space:nowrap;padding:0 18px}.score-strip a{display:block}.score-strip small,.score-strip b{display:block}.wc-section,.results-inner{padding:68px 20px}.section-head{display:block}.section-head h2{font-size:34px}.section-head>p,.section-head>a{display:block;margin-top:12px}.intent-grid,.tool-grid{grid-template-columns:1fr}.intent{min-height:260px}.result-links>a{grid-template-columns:58px 1fr 28px}.result-links div{display:block}.result-links small,.result-links strong{display:block}.tool-group>header{grid-template-columns:1fr;gap:10px}.suggest{grid-template-columns:1fr;padding:30px 24px}.suggest>p{margin:0}}
</style>
