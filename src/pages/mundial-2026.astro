---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SportsLiveNav from '../components/SportsLiveNav.astro';
import { fixture, teamLabel, WORLD_CUP_EVENT } from '../lib/data/mundial-2026.ts';

export const prerender = true;

const canonical = '/mundial-2026';
const final = fixture.matches.find((match) => match.round === 'Final');
const thirdPlace = fixture.matches.find((match) => match.round === 'Match for third place');

function decisiveScore(match: typeof final): [number, number] | null {
  if (!match?.score?.ft) return null;
  return match.score.et || match.score.ft;
}

function winnerName(match: typeof final): string {
  if (!match) return 'España';
  const score = decisiveScore(match);
  if (!score) return teamLabel(match.team1).es;
  return teamLabel(score[0] > score[1] ? match.team1 : match.team2).es;
}

function loserName(match: typeof final): string {
  if (!match) return 'Argentina';
  const score = decisiveScore(match);
  if (!score) return teamLabel(match.team2).es;
  return teamLabel(score[0] > score[1] ? match.team2 : match.team1).es;
}

function scoreText(match: typeof final): string {
  const score = decisiveScore(match);
  if (!match || !score) return 'resultado final';
  return `${teamLabel(match.team1).es} ${score[0]}–${score[1]} ${teamLabel(match.team2).es}`;
}

const champion = winnerName(final);
const runnerUp = loserName(final);
const third = winnerName(thirdPlace);
const fourth = loserName(thirdPlace);
const title = `Quién ganó el Mundial 2026: ${champion} campeón`;
const description = `${champion} ganó el Mundial 2026 tras vencer a ${runnerUp} en la final. Resultado, podio, cuadro y los 104 partidos del torneo.`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `https://hacecuentas.com${canonical}#webpage`,
      url: `https://hacecuentas.com${canonical}`,
      name: title,
      description,
      inLanguage: 'es',
      dateModified: fixture.fetchedAt,
      about: WORLD_CUP_EVENT,
    },
    {
      '@type': 'SportsEvent',
      name: 'Final del Mundial 2026',
      startDate: final?.date,
      location: { '@type': 'Place', name: final?.ground || 'New York/New Jersey' },
      homeTeam: { '@type': 'SportsTeam', name: final ? teamLabel(final.team1).es : 'España' },
      awayTeam: { '@type': 'SportsTeam', name: final ? teamLabel(final.team2).es : 'Argentina' },
      description: scoreText(final),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Mundial 2026', item: `https://hacecuentas.com${canonical}` },
      ],
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} audience="global" schema={schema} domain="life">
  <Header />
  <SportsLiveNav />
  <main class="wc-page">
    <nav class="wc-crumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>›</span><span>Mundial 2026</span></nav>

    <header class="wc-hero">
      <p class="wc-kicker">🏆 Torneo finalizado · 19 de julio de 2026</p>
      <h1>{champion} ganó el Mundial 2026</h1>
      <p class="wc-lead"><strong>{champion} es campeón del mundo.</strong> Venció a {runnerUp} en la final disputada en Nueva York/Nueva Jersey. Acá podés consultar el resultado, el podio y los 104 partidos.</p>
      <div class="wc-final" aria-label="Resultado de la final del Mundial 2026">
        <div><span>{final ? teamLabel(final.team1).flag : '🇪🇸'}</span><strong>{final ? teamLabel(final.team1).es : champion}</strong></div>
        <p><b>{decisiveScore(final)?.[0] ?? 1} – {decisiveScore(final)?.[1] ?? 0}</b><small>Final · tras alargue</small></p>
        <div><span>{final ? teamLabel(final.team2).flag : '🇦🇷'}</span><strong>{final ? teamLabel(final.team2).es : runnerUp}</strong></div>
      </div>
      <a class="wc-primary" href="/fixture-mundial-2026">Ver los 104 resultados del Mundial 2026 →</a>
    </header>

    <section class="wc-section" aria-labelledby="podio-title">
      <p class="wc-eyebrow">Clasificación final</p>
      <h2 id="podio-title">Podio del Mundial 2026</h2>
      <div class="wc-podium">
        <article class="wc-place wc-place--first"><span>1</span><div><b>🥇 {champion}</b><small>Campeón</small></div></article>
        <article class="wc-place"><span>2</span><div><b>🥈 {runnerUp}</b><small>Subcampeón</small></div></article>
        <article class="wc-place"><span>3</span><div><b>🥉 {third}</b><small>Tercer puesto · venció {thirdPlace ? scoreText(thirdPlace) : fourth}</small></div></article>
        <article class="wc-place"><span>4</span><div><b>{fourth}</b><small>Cuarto puesto</small></div></article>
      </div>
    </section>

    <section class="wc-section" aria-labelledby="resumen-title">
      <p class="wc-eyebrow">Resumen del torneo</p>
      <h2 id="resumen-title">Mundial 2026 en números</h2>
      <div class="wc-stats">
        <article><b>48</b><span>selecciones</span></article>
        <article><b>104</b><span>partidos jugados</span></article>
        <article><b>12</b><span>grupos</span></article>
        <article><b>3</b><span>países sede</span></article>
      </div>
      <p>Fue el primer Mundial con 48 selecciones y se disputó en Estados Unidos, México y Canadá entre el 11 de junio y el 19 de julio. España eliminó a Francia en semifinales; Argentina venció a Inglaterra y llegó a la final.</p>
    </section>

    <section class="wc-section" aria-labelledby="archivo-title">
      <p class="wc-eyebrow">Archivo completo</p>
      <h2 id="archivo-title">Resultados, goleadores y recorrido</h2>
      <div class="wc-links">
        <a href="/fixture-mundial-2026"><b>📅 Fixture y resultados completos</b><span>Los 104 partidos, fecha por fecha, con grupos y cruces.</span></a>
        <a href="/goleadores-mundial-2026"><b>⚽ Tabla final de goleadores</b><span>Goles, partidos y posiciones definitivas.</span></a>
        <a href="/fixture-mundial-2026"><b>🗂️ Cuadro y fases eliminatorias</b><span>Dieciseisavos, octavos, cuartos, semifinales y final.</span></a>
        <a href="/fixture-mundial-2026"><b>📊 Posiciones de los 12 grupos</b><span>Cómo terminó cada grupo del nuevo formato de 48 equipos.</span></a>
      </div>
    </section>

    <aside class="wc-note"><strong>Fuente y actualización</strong><p>Resultados consolidados desde el fixture completo del torneo. Última actualización del archivo: {new Date(fixture.fetchedAt).toLocaleDateString('es-AR')}.</p></aside>
  </main>
  <Footer />
</Layout>

<style>
  .wc-page{max-width:960px;margin:0 auto;padding:1rem 1.1rem 4rem;color:var(--text,#172033)}
  .wc-crumb{display:flex;gap:.55rem;align-items:center;font-size:.88rem;color:var(--text-subtle,#667085);margin:.3rem 0 1.2rem}.wc-crumb a{color:inherit}
  .wc-hero{padding:clamp(1.5rem,4vw,3rem);border-radius:24px;background:linear-gradient(145deg,#11395e,#174b7a);color:#fff;text-align:center;box-shadow:0 18px 44px #0b294326}
  .wc-kicker,.wc-eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.78rem;font-weight:800}.wc-kicker{color:#bce3ff;margin:0 0 .7rem}.wc-hero h1{font-size:clamp(2rem,6vw,3.5rem);line-height:1.04;margin:0}.wc-lead{max-width:710px;margin:1rem auto 1.5rem;line-height:1.6;color:#e6f2fb}
  .wc-final{max-width:620px;margin:0 auto 1.4rem;padding:1.15rem;display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:center;background:#ffffff12;border:1px solid #ffffff38;border-radius:18px}.wc-final div{display:flex;align-items:center;justify-content:center;gap:.55rem;font-size:1.1rem}.wc-final div span{font-size:2rem}.wc-final p{margin:0}.wc-final p b{display:block;font-size:2rem}.wc-final p small{display:block;color:#bce3ff;margin-top:.15rem}
  .wc-primary{display:inline-flex;padding:.82rem 1.15rem;border-radius:999px;background:#fff;color:#11395e;text-decoration:none;font-weight:800}
  .wc-section{padding:2.25rem 0;border-bottom:1px solid var(--border,#e4e7ec)}.wc-section h2{font-size:clamp(1.45rem,3vw,2rem);margin:.3rem 0 1.1rem}.wc-eyebrow{color:#174b7a;margin:0}.wc-section>p:last-child{line-height:1.65;color:var(--text-subtle,#526071)}
  .wc-podium{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.wc-place{display:flex;gap:.85rem;align-items:center;padding:1rem;border:1px solid var(--border,#e4e7ec);border-radius:14px;background:var(--surface,#fff)}.wc-place>span{width:2.15rem;height:2.15rem;display:grid;place-items:center;border-radius:50%;background:#edf4fa;color:#174b7a;font-weight:900}.wc-place div{display:grid;gap:.2rem}.wc-place small{color:var(--text-subtle,#667085)}.wc-place--first{border-color:#e2b431;background:#fff9df}
  .wc-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem}.wc-stats article{padding:1.2rem;text-align:center;border-radius:14px;background:#edf4fa}.wc-stats b{display:block;font-size:1.8rem;color:#174b7a}.wc-stats span{font-size:.85rem;color:#526071}
  .wc-links{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.wc-links a{display:grid;gap:.35rem;padding:1rem;border:1px solid var(--border,#e4e7ec);border-radius:14px;color:inherit;text-decoration:none}.wc-links a:hover{border-color:#174b7a}.wc-links span{color:var(--text-subtle,#667085);line-height:1.4}
  .wc-note{margin-top:2rem;padding:1rem 1.15rem;border-radius:14px;background:#f7f8fa}.wc-note p{margin:.35rem 0 0;color:var(--text-subtle,#667085)}
  @media(max-width:640px){.wc-final{grid-template-columns:1fr;gap:.45rem}.wc-final p{order:-1}.wc-podium,.wc-links{grid-template-columns:1fr}.wc-stats{grid-template-columns:repeat(2,1fr)}}
</style>
