---
/**
 * Hub de decisión — "¿Cómo opero con fracciones?"
 * Reemplaza 3 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de matematica/regla-de-tres.astro: la página sólo aporta los
 * datos (src/lib/hubs/fracciones.ts) y su compute(). El chrome, el CSS y el
 * runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/fracciones';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * No hay plata en ninguna rama y el default de HubRow es 'ars'. Toda fila
     * declara su formato explícito.
     */
    const PLAIN = { format: 'plain', decimals: 2 };
    const PLAIN4 = { format: 'plain', decimals: 4 };
    const ENTERO = { format: 'plain', decimals: 0 };

    /** Redondeo anti-artefacto de punto flotante (y mata el −0). */
    const R = (n) => {
      if (!isFinite(n)) return n;
      const r = Math.round(n);
      return Math.abs(n - r) < 1e-10 ? (r === 0 ? 0 : r) : n;
    };

    const fmt = (n) => {
      n = R(n);
      if (!isFinite(n)) return '—';
      return Number(n.toFixed(6)).toLocaleString('es-AR', { maximumFractionDigits: 6 });
    };

    const err = (msg, k, v) => ({
      total: '—',
      sub: msg,
      rows: [{ k: k, v: v || 0, ...PLAIN }],
      chart: [],
      format: 'plain',
      decimals: 2,
    });

    // --- aritmética de fracciones ---------------------------------------
    function mcd(x, y) {
      x = Math.abs(x); y = Math.abs(y);
      while (y) { const t = y; y = x % y; x = t; }
      return x || 1;
    }
    const mcm = (x, y) => Math.abs(x * y) / mcd(x, y);

    /** Normaliza el signo al numerador y divide por el mcd. */
    function simplificar(num, den) {
      if (den < 0) { num = -num; den = -den; }
      const g = mcd(num, den);
      return { n: num / g, d: den / g, g: g };
    }

    const frac = (n, d) => (d === 1 ? String(n) : n + '/' + d);

    // --- redondeo (port de la fórmula original) --------------------------
    const NIVELES = {
      d4: { n: 4, label: '4 decimales' },
      d3: { n: 3, label: '3 decimales' },
      d2: { n: 2, label: '2 decimales' },
      d1: { n: 1, label: '1 decimal' },
      unidad: { n: 0, label: 'la unidad (entero)' },
      decena: { n: -1, label: 'la decena' },
      centena: { n: -2, label: 'la centena' },
      mil: { n: -3, label: 'el millar' },
    };

    function limpiar(x, n) {
      return n > 0 ? Number(x.toFixed(n)) : Number(x.toFixed(0));
    }

    function redondear(numero, nivel) {
      const n = nivel.n;
      const abs = Math.abs(numero);
      const signo = numero < 0 ? -1 : 1;
      let redAbs, truncAbs, ceilAbs, floorAbs;
      if (n >= 0) {
        const f = Math.pow(10, n);
        const val = Number((abs * f).toPrecision(12));
        redAbs = Math.round(val) / f;
        truncAbs = Math.trunc(val) / f;
        ceilAbs = Math.ceil(val) / f;
        floorAbs = Math.floor(val) / f;
      } else {
        const paso = Math.pow(10, -n);
        const val = Number((abs / paso).toPrecision(12));
        redAbs = Math.round(val) * paso;
        truncAbs = Math.trunc(val) * paso;
        ceilAbs = Math.ceil(val) * paso;
        floorAbs = Math.floor(val) * paso;
      }
      const pasoDigito = Math.pow(10, n + 1);
      const digito = Math.floor(Number((abs * pasoDigito).toPrecision(12))) % 10;
      return {
        redondeado: limpiar(signo * redAbs, n),
        truncado: limpiar(signo * truncAbs, n),
        haciaArriba: limpiar(signo > 0 ? ceilAbs : -floorAbs, n),
        haciaAbajo: limpiar(signo > 0 ? floorAbs : -ceilAbs, n),
        digito: digito,
        sube: digito >= 5,
      };
    }

    H.onCompute(function (v, kase) {
      const a = Math.trunc(H.num(v.a));
      const b = Math.trunc(H.num(v.b));
      const c = Math.trunc(H.num(v.c));
      const d = Math.trunc(H.num(v.d));
      const ent = Math.trunc(H.num(v.ent));
      const id = (kase && kase.id) || 'suma-resta';

      if (!b) return err('El denominador de la primera fracción no puede ser 0: no se puede dividir por cero.', 'Denominador cargado', 0);

      const dec1 = a / b;

      // ---- 1) Suma y resta con mcm --------------------------------------
      if (id === 'suma-resta') {
        if (!d) return err('El denominador de la segunda fracción no puede ser 0.', 'Segundo denominador', 0);
        const resta = String(v.ops || 'suma') === 'resta';
        const signo = resta ? '−' : '+';
        const comun = mcm(b, d);
        const f1 = comun / b;
        const f2 = comun / d;
        const n1 = a * f1;
        const n2 = c * f2;
        const num = resta ? n1 - n2 : n1 + n2;
        const s = simplificar(num, comun);
        const dec2 = c / d;
        const decR = s.n / s.d;

        return {
          total: frac(s.n, s.d),
          sub:
            frac(a, b) + ' ' + signo + ' ' + frac(c, d) + ' = ' + frac(n1, comun) + ' ' + signo + ' ' + frac(n2, comun) +
            ' = ' + frac(num, comun) + (s.g > 1 ? ' = ' + frac(s.n, s.d) + ' (simplificada ÷' + s.g + ')' : '') +
            ' ≈ ' + fmt(decR),
          rows: [
            { k: 'Primera fracción ' + frac(a, b) + ' en decimal', v: R(dec1), ...PLAIN4 },
            { k: 'Segunda fracción ' + frac(c, d) + ' en decimal', v: R(dec2), ...PLAIN4 },
            { k: 'mcm(' + b + ', ' + d + ') → denominador común', ref: 'paso 1', v: comun, extra: true, ...ENTERO },
            { k: 'Factor de la primera: ' + comun + ' ÷ ' + b, ref: 'paso 2', v: f1, ...ENTERO },
            { k: 'Factor de la segunda: ' + comun + ' ÷ ' + d, ref: 'paso 2', v: f2, ...ENTERO },
            { k: 'Numerador reescrito de la primera (' + a + ' × ' + f1 + ')', ref: 'paso 2: ampliar', v: n1, ...ENTERO },
            { k: 'Numerador reescrito de la segunda (' + c + ' × ' + f2 + ')', ref: 'paso 2: ampliar', v: n2, ...ENTERO },
            { k: (resta ? 'Resta' : 'Suma') + ' de numeradores → ' + frac(num, comun), ref: 'paso 3: el denominador no se toca', v: num, extra: true, ...ENTERO },
            { k: 'mcd(' + Math.abs(num) + ', ' + comun + ') → factor de simplificación', ref: 'paso 4', v: s.g, ...ENTERO },
            { k: 'Resultado simplificado ' + frac(s.n, s.d) + ' — numerador', ref: 'paso 4', v: s.n, extra: true, ...ENTERO },
            { k: 'Resultado simplificado — denominador', ref: 'paso 4', v: s.d, ...ENTERO },
            { k: 'Verificación en decimal', ref: fmt(dec1) + ' ' + signo + ' ' + fmt(dec2) + ' = ' + fmt(resta ? dec1 - dec2 : dec1 + dec2), v: R(decR), ...PLAIN4 },
          ],
          format: 'plain',
          decimals: 4,
          chart: [
            { label: frac(a, b) + ' = ' + fmt(dec1), value: Math.abs(dec1) || 0.001, tone: 'prop' },
            { label: frac(c, d) + ' = ' + fmt(dec2), value: Math.abs(dec2) || 0.001, tone: 'exit' },
            { label: frac(s.n, s.d) + ' = ' + fmt(decR), value: Math.abs(decR) || 0.001, tone: 'main' },
          ],
        };
      }

      // ---- 2) Multiplicación y división ----------------------------------
      if (id === 'mult-div') {
        if (!d) return err('El denominador de la segunda fracción no puede ser 0.', 'Segundo denominador', 0);
        const dividir = String(v.opm || 'multiplicacion') === 'division';
        if (dividir && c === 0) return err('No se puede dividir por una fracción con numerador 0.', 'Numerador de la segunda', 0);
        const num = dividir ? a * d : a * c;
        const den = dividir ? b * c : b * d;
        const s = simplificar(num, den);
        const dec2 = c / d;
        const decR = s.n / s.d;

        return {
          total: frac(s.n, s.d),
          sub:
            frac(a, b) + (dividir ? ' ÷ ' : ' × ') + frac(c, d) +
            (dividir ? ' = ' + frac(a, b) + ' × ' + frac(d, c) + ' (se da vuelta la segunda)' : '') +
            ' = ' + frac(num, den) + (s.g > 1 ? ' = ' + frac(s.n, s.d) + ' (simplificada ÷' + s.g + ')' : '') +
            ' ≈ ' + fmt(decR),
          rows: [
            { k: 'Primera fracción ' + frac(a, b) + ' en decimal', v: R(dec1), ...PLAIN4 },
            { k: 'Segunda fracción ' + frac(c, d) + ' en decimal', v: R(dec2), ...PLAIN4 },
            dividir
              ? { k: 'Recíproco de la segunda: ' + frac(d, c), ref: 'paso 1: dividir = multiplicar por el recíproco', v: R(d / c), ...PLAIN4 }
              : { k: 'No hace falta denominador común', ref: 'paso 1: se multiplica en línea recta', v: 0, ...ENTERO },
            { k: 'Numerador: ' + (dividir ? a + ' × ' + d : a + ' × ' + c), ref: 'paso 2', v: num, ...ENTERO },
            { k: 'Denominador: ' + (dividir ? b + ' × ' + c : b + ' × ' + d), ref: 'paso 2', v: den, ...ENTERO },
            { k: 'Resultado sin simplificar: ' + frac(num, den), ref: 'paso 2', v: num, extra: true, ...ENTERO },
            { k: 'mcd(' + Math.abs(num) + ', ' + Math.abs(den) + ') → factor de simplificación', ref: 'paso 3', v: s.g, ...ENTERO },
            { k: 'Resultado simplificado ' + frac(s.n, s.d) + ' — numerador', ref: 'paso 3', v: s.n, extra: true, ...ENTERO },
            { k: 'Resultado simplificado — denominador', ref: 'paso 3', v: s.d, ...ENTERO },
            { k: 'Verificación en decimal', ref: fmt(dec1) + (dividir ? ' ÷ ' : ' × ') + fmt(dec2) + ' = ' + fmt(dividir ? dec1 / dec2 : dec1 * dec2), v: R(decR), ...PLAIN4 },
          ],
          format: 'plain',
          decimals: 4,
          chart: [
            { label: frac(a, b) + ' = ' + fmt(dec1), value: Math.abs(dec1) || 0.001, tone: 'prop' },
            { label: frac(c, d) + ' = ' + fmt(dec2), value: Math.abs(dec2) || 0.001, tone: 'exit' },
            { label: frac(s.n, s.d) + ' = ' + fmt(decR), value: Math.abs(decR) || 0.001, tone: 'main' },
          ],
        };
      }

      // ---- 3) Simplificar a irreducible ----------------------------------
      if (id === 'simplificar') {
        const s = simplificar(a, b);
        const yaEstaba = s.g === 1;
        return {
          total: frac(s.n, s.d),
          sub:
            frac(a, b) + (yaEstaba
              ? ' ya era irreducible: el mcd de numerador y denominador es 1.'
              : ' ÷ ' + s.g + ' arriba y abajo = ' + frac(s.n, s.d) + ', que ya no se puede simplificar más.') +
            ' En decimal vale ' + fmt(s.n / s.d) + '.',
          rows: [
            { k: 'Numerador cargado', v: a, ...ENTERO },
            { k: 'Denominador cargado', v: b, ...ENTERO },
            { k: 'mcd(' + Math.abs(a) + ', ' + Math.abs(b) + ') por el algoritmo de Euclides', ref: 'paso 1', v: s.g, extra: true, ...ENTERO },
            { k: 'Numerador ÷ mcd', ref: 'paso 2', v: s.n, extra: true, ...ENTERO },
            { k: 'Denominador ÷ mcd', ref: 'paso 2', v: s.d, extra: true, ...ENTERO },
            { k: 'Verificación: decimal de la fracción original', ref: 'tiene que ser idéntico al de la simplificada', v: R(dec1), ...PLAIN4 },
            { k: 'Verificación: decimal de la simplificada', v: R(s.n / s.d), ...PLAIN4 },
            { k: s.d === 1 ? 'El denominador quedó en 1: era un número entero' : 'Fracción irreducible: mcd(n, d) = 1', ref: 'control final', v: mcd(s.n, s.d), ...ENTERO },
          ],
          format: 'plain',
          decimals: 4,
          chart: [
            { label: 'Numerador original ' + a, value: Math.abs(a) || 0.001, tone: 'prop' },
            { label: 'Denominador original ' + b, value: Math.abs(b) || 0.001, tone: 'exit' },
            { label: 'Irreducible ' + frac(s.n, s.d), value: Math.abs(s.n / s.d) || 0.001, tone: 'main' },
          ],
        };
      }

      // ---- 4) Impropia → número mixto ------------------------------------
      if (id === 'impropia-mixto') {
        if (a < 0 || b < 0) return err('Esta conversión trabaja con valores positivos, que es como se enseña.', 'Numerador cargado', a);
        const s = simplificar(a, b);
        const parteEntera = Math.floor(s.n / s.d);
        const resto = s.n % s.d;
        const mixto = resto === 0 ? String(parteEntera) : parteEntera === 0 ? frac(s.n, s.d) : parteEntera + ' ' + frac(resto, s.d);

        return {
          total: mixto,
          sub:
            resto === 0
              ? frac(a, b) + ' no deja resto: es exactamente el entero ' + parteEntera + '.'
              : parteEntera === 0
                ? frac(a, b) + ' es una fracción PROPIA (el numerador es menor que el denominador): no tiene parte entera. Simplificada queda ' + frac(s.n, s.d) + ' ≈ ' + fmt(dec1) + '.'
                : frac(a, b) + ' = ' + s.n + ' ÷ ' + s.d + ' = ' + parteEntera + ' con resto ' + resto + ' → ' + mixto + ' ≈ ' + fmt(dec1) + '.',
          rows: [
            { k: 'Numerador cargado', v: a, ...ENTERO },
            { k: 'Denominador cargado', v: b, ...ENTERO },
            { k: 'mcd → se simplifica primero', ref: 'paso 1', v: s.g, ...ENTERO },
            { k: 'Fracción simplificada ' + frac(s.n, s.d) + ' — numerador', ref: 'paso 1', v: s.n, ...ENTERO },
            { k: 'Fracción simplificada — denominador', ref: 'paso 1', v: s.d, ...ENTERO },
            { k: 'Cociente entero de ' + s.n + ' ÷ ' + s.d + ' → parte entera', ref: 'paso 2', v: parteEntera, extra: true, ...ENTERO },
            { k: 'Resto de la división → nuevo numerador', ref: 'paso 3: el denominador no cambia', v: resto, extra: true, ...ENTERO },
            { k: 'Verificación: parte entera × denominador + resto', ref: 'tiene que dar ' + s.n, v: parteEntera * s.d + resto, ...ENTERO },
            { k: 'Verificación en decimal', ref: 'el mixto y la impropia valen lo mismo', v: R(dec1), ...PLAIN4 },
          ],
          format: 'plain',
          decimals: 4,
          chart: [
            { label: 'Parte entera: ' + parteEntera, value: Math.abs(parteEntera) || 0.001, tone: 'main' },
            { label: 'Parte fraccionaria: ' + frac(resto, s.d), value: Math.abs(resto / s.d) || 0.001, tone: 'prop' },
            { label: 'Total = ' + fmt(dec1), value: Math.abs(dec1) || 0.001, tone: 'exit' },
          ],
        };
      }

      // ---- 5) Número mixto → impropia -------------------------------------
      if (id === 'mixto-impropia') {
        if (a < 0 || b < 0 || ent < 0) return err('Esta conversión trabaja con valores positivos, que es como se enseña.', 'Parte entera cargada', ent);
        const producto = ent * b;
        const numImpropio = producto + a;
        const s = simplificar(numImpropio, b);

        return {
          // Si la impropia se simplifica a un entero, se muestran las dos formas:
          // la impropia es lo que se pidió, pero esconder el entero confunde.
          total: s.d === 1 ? frac(numImpropio, b) + ' = ' + s.n : frac(numImpropio, b),
          sub:
            ent + ' ' + frac(a, b) + ' = (' + ent + ' × ' + b + ' + ' + a + ') ÷ ' + b + ' = ' + frac(numImpropio, b) +
            (s.g > 1 ? ', que simplificada por el mcd ' + s.g + ' queda ' + frac(s.n, s.d) : '') +
            ' ≈ ' + fmt(numImpropio / b) + '.',
          rows: [
            { k: 'Parte entera', v: ent, ...ENTERO },
            { k: 'Numerador de la parte fraccionaria', v: a, ...ENTERO },
            { k: 'Denominador', ref: 'no se toca en ningún paso', v: b, ...ENTERO },
            { k: 'Parte entera × denominador (' + ent + ' × ' + b + ')', ref: 'paso 1: las unidades en esa fracción', v: producto, ...ENTERO },
            { k: 'Más el numerador (' + producto + ' + ' + a + ')', ref: 'paso 2', v: numImpropio, extra: true, ...ENTERO },
            { k: 'Fracción impropia ' + frac(numImpropio, b), ref: 'paso 3: el denominador queda igual', v: numImpropio, extra: true, ...ENTERO },
            { k: 'mcd → simplificación posible', ref: s.g > 1 ? 'queda ' + frac(s.n, s.d) : 'ya es irreducible', v: s.g, ...ENTERO },
            { k: 'Verificación: la impropia dividida da de vuelta el mixto', ref: numImpropio + ' ÷ ' + b + ' = ' + ent + ' con resto ' + a, v: R(numImpropio / b), ...PLAIN4 },
          ],
          format: 'plain',
          decimals: 4,
          chart: [
            { label: 'Parte entera pasada a ' + producto + '/' + b, value: Math.abs(ent) || 0.001, tone: 'main' },
            { label: 'Parte fraccionaria ' + frac(a, b), value: Math.abs(a / b) || 0.001, tone: 'prop' },
            { label: 'Impropia ' + frac(numImpropio, b) + ' = ' + fmt(numImpropio / b), value: Math.abs(numImpropio / b) || 0.001, tone: 'exit' },
          ],
        };
      }

      // ---- 6) A decimal y redondeo -----------------------------------------
      const nivel = NIVELES[String(v.niv || 'd2')] || NIVELES.d2;
      const rr = redondear(dec1, nivel);
      const s6 = simplificar(a, b);
      // Decimal exacto si el denominador irreducible sólo tiene factores 2 y 5.
      let resto5 = Math.abs(s6.d);
      while (resto5 % 2 === 0) resto5 /= 2;
      while (resto5 % 5 === 0) resto5 /= 5;
      const exacto = resto5 === 1;

      return {
        total: fmt(rr.redondeado),
        sub:
          frac(a, b) + ' = ' + a + ' ÷ ' + b + ' = ' + fmt(dec1) + (exacto ? ' (decimal exacto)' : ' (decimal periódico)') +
          '. Redondeado a ' + nivel.label + ' da ' + fmt(rr.redondeado) + ': el primer dígito descartado es ' + rr.digito +
          ', y como es ' + (rr.sube ? '5 o más, la última cifra sube 1.' : 'menor que 5, la última cifra queda igual.'),
        rows: [
          { k: 'Numerador ÷ denominador', ref: 'paso 1: la barra de fracción es una división', v: R(dec1), extra: true, ...PLAIN4 },
          { k: 'Fracción irreducible ' + frac(s6.n, s6.d) + ' — denominador', ref: exacto ? 'sólo factores 2 y 5 → decimal exacto' : 'tiene otro factor primo → decimal periódico', v: s6.d, ...ENTERO },
          { k: 'Primer dígito descartado', ref: 'paso 2: el que decide la regla del 5', v: rr.digito, ...ENTERO },
          { k: 'Redondeado a ' + nivel.label, ref: rr.sube ? 'sube 1: el dígito era ≥ 5' : 'queda igual: el dígito era < 5', v: rr.redondeado, extra: true, ...PLAIN4 },
          { k: 'Truncado (cortado sin mirar el siguiente)', ref: 'no es lo mismo que redondear', v: rr.truncado, ...PLAIN4 },
          { k: 'Redondeo hacia arriba (techo)', ref: 'siempre al alza', v: rr.haciaArriba, ...PLAIN4 },
          { k: 'Redondeo hacia abajo (piso)', ref: 'siempre a la baja', v: rr.haciaAbajo, ...PLAIN4 },
          { k: 'Error del redondeo (exacto − redondeado)', ref: 'nunca puede pasar de media unidad de la precisión', v: R(dec1 - rr.redondeado), ...PLAIN4 },
        ],
        format: 'plain',
        decimals: 4,
        chart: [
          { label: 'Valor exacto = ' + fmt(dec1), value: Math.abs(dec1) || 0.001, tone: 'prop' },
          { label: 'Redondeado = ' + fmt(rr.redondeado), value: Math.abs(rr.redondeado) || 0.001, tone: 'main' },
          { label: 'Truncado = ' + fmt(rr.truncado), value: Math.abs(rr.truncado) || 0.001, tone: 'exit' },
        ],
      };
    });
  })();
</script>
