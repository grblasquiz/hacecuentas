---
/**
 * Hub de decisión — "¿Cómo calculo un porcentaje?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de trabajo/indemnizacion-por-despido.astro: la página sólo
 * aporta los datos (src/lib/hubs/porcentajes.ts) y su compute(). El chrome, el
 * CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PorcentajesExperience from '../../components/generated/PorcentajesExperience.astro';
import { hub } from '../../lib/hubs/porcentajes';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PorcentajesExperience data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * Formateo local para `total`, `sub` y `positionLabel`, que el runtime toma
     * como strings ya armados.
     *
     * Las FILAS del desglose y la leyenda del gráfico las formatea el runtime a
     * partir de `format`/`unit`/`decimals` (HubRow/HubResult en types.ts). Acá
     * los valores casi nunca son pesos, así que:
     *   - cantidades  → format 'plain'
     *   - porcentajes → format 'unit' + unit '%'
     *   - pesos       → format 'ars' (SOLO la rama de descuento)
     * y siempre con `decimals`: el default es 0 y aplastaría un 0,25 a "0".
     */
    const PLAIN = { format: 'plain', decimals: 2 };
    const PCT = { format: 'unit', unit: '%', decimals: 2 };
    const RATIO = { format: 'plain', decimals: 4 };

    const fmt = (n) => {
      if (!isFinite(n)) return '—';
      const abs = Math.abs(n);
      const dec = abs >= 1000 ? 0 : abs >= 1 ? 2 : 4;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };
    const pctTxt = (n) => fmt(n) + '%';
    const clamp = (n) => Math.max(0, Math.min(100, isFinite(n) ? n : 0));

    function gcd(a, b) {
      a = Math.abs(Math.round(a)); b = Math.abs(Math.round(b));
      while (b) { const t = b; b = a % b; a = t; }
      return a || 1;
    }

    /** P/100 simplificada a fracción, tolerando decimales en P. */
    function fraccion(p) {
      const decimals = (String(p).split('.')[1] || '').length;
      const factor = Math.pow(10, decimals);
      const num = Math.round(p * factor);
      const den = 100 * factor;
      const d = gcd(num, den);
      const fn = num / d, fd = den / d;
      return fd === 1 ? String(fn) : fn + '/' + fd;
    }

    H.onCompute(function (v, kase) {
      const p = H.num(v.pct);
      const a = v.a;
      const b = v.b;
      const id = (kase && kase.id) || 'pct-de-n';

      // ---- 1) Cuánto es el X% de un número -----------------------------
      if (id === 'pct-de-n') {
        const parte = (a * p) / 100;
        const resto = a - parte;
        return {
          total: fmt(parte),
          sub: 'El ' + pctTxt(p) + ' de ' + fmt(a) + ' es ' + fmt(parte) + ' · fórmula: A × P ÷ 100',
          rows: [
            { k: 'Número de partida (A)', v: a, ...PLAIN },
            { k: 'Porcentaje aplicado (P)', v: p, ...PCT },
            { k: 'A × P', ref: 'paso 1', v: a * p, ...PLAIN },
            { k: 'Dividido 100 → resultado', v: parte, extra: true, ...PLAIN },
            { k: 'Lo que queda del total', v: Math.max(0, resto), ...PLAIN },
          ],
          format: 'plain', decimals: 2,
          chart: [
            { label: 'El ' + pctTxt(p), value: Math.max(0, parte), tone: 'main' },
            { label: 'El resto', value: Math.max(0, resto), tone: 'prop' },
          ],
          position: clamp(p),
          positionLabel: fmt(parte) + ' es el ' + pctTxt(p) + ' de ' + fmt(a),
        };
      }

      // ---- 2) Qué porcentaje es A de B ---------------------------------
      if (id === 'a-de-b') {
        if (!b) {
          return {
            total: '—', sub: 'El total (B) no puede ser 0: no se puede dividir por cero.',
            rows: [{ k: 'Total (B)', v: 0, ...PLAIN }], chart: [],
            format: 'plain', decimals: 2,
          };
        }
        const res = (a / b) * 100;
        return {
          total: pctTxt(res),
          sub: fmt(a) + ' es el ' + pctTxt(res) + ' de ' + fmt(b) + ' · fórmula: A ÷ B × 100',
          rows: [
            { k: 'La parte (A)', v: a, ...PLAIN },
            { k: 'El total (B)', v: b, ...PLAIN },
            { k: 'A ÷ B', ref: 'proporción', v: a / b, ...RATIO },
            { k: 'Por 100 → porcentaje', v: res, extra: true, ...PCT },
            { k: 'Lo que falta para el total', v: Math.max(0, b - a), ...PLAIN },
          ],
          format: 'plain', decimals: 2,
          chart: [
            { label: 'La parte (' + pctTxt(res) + ')', value: Math.max(0, a), tone: 'main' },
            { label: 'El resto del total', value: Math.max(0, b - a), tone: 'prop' },
          ],
          position: clamp(res),
          positionLabel: fmt(a) + ' es el ' + pctTxt(res) + ' de ' + fmt(b),
        };
      }

      // ---- 3) De cuánto aumentó o bajó ---------------------------------
      if (id === 'variacion') {
        if (!a) {
          return {
            total: '—', sub: 'El valor inicial (A) no puede ser 0: no hay base sobre la cual variar.',
            rows: [{ k: 'Valor inicial (A)', v: 0, ...PLAIN }], chart: [],
            format: 'plain', decimals: 2,
          };
        }
        const dif = b - a;
        const varPct = (dif / a) * 100;
        const sube = dif >= 0;
        return {
          total: (sube ? '+' : '−') + pctTxt(Math.abs(varPct)),
          sub:
            (sube ? 'Aumentó ' : 'Bajó ') + pctTxt(Math.abs(varPct)) +
            ' al pasar de ' + fmt(a) + ' a ' + fmt(b) + ' · fórmula: (B − A) ÷ A × 100',
          rows: [
            { k: 'Valor inicial (A)', v: a, ...PLAIN },
            { k: 'Valor final (B)', v: b, ...PLAIN },
            { k: 'Diferencia B − A', v: dif, ...PLAIN },
            { k: 'Dividido A y por 100 → variación', v: varPct, extra: true, ...PCT },
            { k: 'El final es este % del inicial', v: (b / a) * 100, ...PCT },
          ],
          format: 'plain', decimals: 2,
          chart: [
            { label: 'Valor inicial', value: Math.max(0, a), tone: 'main' },
            { label: sube ? 'Lo que subió' : 'Lo que bajó', value: Math.abs(dif), tone: sube ? 'good' : 'warn' },
          ],
          position: clamp(Math.abs(varPct)),
          positionLabel: 'De ' + fmt(a) + ' a ' + fmt(b) + ': ' + (sube ? '+' : '−') + pctTxt(Math.abs(varPct)),
        };
      }

      // ---- 4) Precio con descuento aplicado ----------------------------
      if (id === 'descuento') {
        const ahorro = (a * p) / 100;
        const final = a - ahorro;
        return {
          total: '$' + fmt(final),
          sub:
            'Pagás $' + fmt(final) + ' y ahorrás $' + fmt(ahorro) +
            ' · con ' + pctTxt(p) + ' off pagás el ' + pctTxt(100 - p),
          // Única rama donde los valores SÍ son plata: acá 'ars' es correcto.
          rows: [
            { k: 'Precio de lista (A)', v: a, format: 'ars' },
            { k: 'Descuento del ' + pctTxt(p), v: ahorro, format: 'ars' },
            { k: 'Precio final que pagás', v: final, extra: true, format: 'ars' },
            { k: 'Porcentaje que terminás pagando', v: Math.max(0, 100 - p), ...PCT },
          ],
          format: 'ars', decimals: 0,
          chart: [
            { label: 'Pagás', value: Math.max(0, final), tone: 'main' },
            { label: 'Ahorrás', value: Math.max(0, ahorro), tone: 'good' },
          ],
          position: clamp(p),
          positionLabel: 'Con ' + pctTxt(p) + ' off, $' + fmt(a) + ' queda en $' + fmt(final),
        };
      }

      // ---- 5) El número original antes del porcentaje -------------------
      if (id === 'inverso') {
        if (!p) {
          return {
            total: '—', sub: 'Con P = 0 no hay solución: el 0% de cualquier número da 0.',
            rows: [{ k: 'Porcentaje (P)', v: 0, ...PCT }], chart: [],
            format: 'plain', decimals: 2,
          };
        }
        const totalN = (a * 100) / p;
        return {
          total: fmt(totalN),
          sub: fmt(a) + ' es el ' + pctTxt(p) + ' de ' + fmt(totalN) + ' · fórmula: A × 100 ÷ P',
          rows: [
            { k: 'La parte que conocés (A)', v: a, ...PLAIN },
            { k: 'Porcentaje que representa (P)', v: p, ...PCT },
            { k: 'A × 100', ref: 'paso 1', v: a * 100, ...PLAIN },
            { k: 'Dividido P → número original', v: totalN, extra: true, ...PLAIN },
            { k: 'Verificación: el ' + pctTxt(p) + ' del resultado', v: (totalN * p) / 100, ...PLAIN },
          ],
          format: 'plain', decimals: 2,
          chart: [
            { label: 'La parte (' + pctTxt(p) + ')', value: Math.max(0, a), tone: 'main' },
            { label: 'El resto hasta el total', value: Math.max(0, totalN - a), tone: 'prop' },
          ],
          position: clamp(p),
          positionLabel: fmt(a) + ' es el ' + pctTxt(p) + ' de ' + fmt(totalN),
        };
      }

      // ---- 6) Porcentaje a fracción y decimal --------------------------
      const dec = p / 100;
      return {
        total: fmt(dec) + ' = ' + fraccion(p),
        sub: pctTxt(p) + ' = ' + fmt(dec) + ' en decimal = ' + fraccion(p) + ' en fracción',
        // 4 decimales no son un lujo: con el default (0) un 0,25 se vería "0".
        rows: [
          { k: 'Porcentaje de partida (P)', v: p, ...PCT },
          { k: 'P ÷ 100 → decimal', ref: 'decimal', v: dec, ...RATIO },
          { k: 'Fracción P/100 simplificada: ' + fraccion(p), ref: 'fracción', v: dec, ...RATIO },
          { k: 'Sobre 100 partes, te quedás con', ref: 'partes de 100', v: p, extra: true, ...PLAIN },
        ],
        chart: [
          { label: 'La fracción ' + fraccion(p), value: clamp(p), tone: 'main' },
          { label: 'Lo que falta para el entero', value: Math.max(0, 100 - clamp(p)), tone: 'prop' },
        ],
        format: 'plain', decimals: 2,
        position: clamp(p),
        positionLabel: pctTxt(p) + ' = ' + fmt(dec) + ' = ' + fraccion(p),
      };
    });
  })();
</script>
