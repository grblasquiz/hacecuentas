---
/**
 * Hub de decisión — "Potencias, raíces, logaritmos y factorización"
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cuatro ramas (potencias · logaritmos · MCD/MCM y
 * primos · notación científica). Los mismos campos cambian de significado
 * según la rama, así que esta página los renombra y oculta los que sobran.
 *
 * La página sólo aporta datos (src/lib/hubs/potencias.ts) y compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  CASE_FIELDS,
  CASE_LABELS,
  PREFIJOS_SI,
  MAG_RANGE,
  EPS_ENTERO,
} from '../../lib/hubs/potencias';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const BANDS = hub.chart.bands ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ CASE_FIELDS, CASE_LABELS, PREFIJOS_SI, MAG_RANGE, EPS_ENTERO, BANDS }}
>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay plata: TODA fila lleva format:'plain' o 'unit'. El default del
    // contrato es 'ars' y Object.assign copia undefined, así que una fila sin
    // format propio se imprimiría con "$" adelante.

    // ---------- utilidades numéricas ----------

    /**
     * Ajuste anti punto flotante.
     * Math.log(8)/Math.log(2) da 2.9999999999999996 porque ni ln(8) ni ln(2)
     * son exactos en binario. Si el valor queda a menos de EPS_ENTERO (relativo)
     * de un entero, devolvemos el entero.
     */
    function snap(n) {
      if (!isFinite(n)) return n;
      const r = Math.round(n);
      return Math.abs(n - r) <= EPS_ENTERO * Math.max(1, Math.abs(n)) ? r : n;
    }

    /** Parser es-AR: acepta "-1,5", "-1.5" y "1.200,5". Devuelve null si no hay número. */
    function numLocal(s) {
      if (typeof s === 'number') return isFinite(s) ? s : null;
      let t = String(s == null ? '' : s).trim().replace(/\s/g, '');
      if (!t) return null;
      const neg = /^[-−]/.test(t);
      t = t.replace(/[^\d.,]/g, '');
      if (!t) return null;
      if (t.indexOf(',') > -1) t = t.replace(/\./g, '').replace(',', '.');
      else if ((t.match(/\./g) || []).length > 1) t = t.replace(/\./g, '');
      const n = Number(t);
      if (!isFinite(n)) return null;
      return neg ? -n : n;
    }

    /** Igual que numLocal pero además entiende 3,2e8 y 3,2×10^8. */
    function numCientifico(s) {
      const raw = String(s == null ? '' : s).trim().replace(/\s/g, '');
      if (!raw) return null;
      let m = raw.match(/^([+-]?[\d.,]+)[×xX*]10\^?([+-]?\d+)$/);
      if (m) {
        const mant = numLocal(m[1]);
        return mant === null ? null : mant * Math.pow(10, parseInt(m[2], 10));
      }
      m = raw.match(/^([+-]?[\d.,]+)[eE]([+-]?\d+)$/);
      if (m) {
        const mant = numLocal(m[1]);
        return mant === null ? null : mant * Math.pow(10, parseInt(m[2], 10));
      }
      return numLocal(raw);
    }

    function decOf(n) {
      if (!isFinite(n)) return 0;
      if (Number.isInteger(n)) return 0;
      const abs = Math.abs(n);
      if (abs >= 1e6) return 2;
      return 6;
    }

    // Sin `d` explícito formatea "lindo" (sin ceros de relleno): es el que se
    // usa dentro de las frases. Las filas del desglose siempre pasan decimales.
    function fmt(n, d) {
      if (!isFinite(n)) return '∞';
      if (d === undefined) return fmtTrim(n);
      return n.toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });
    }

    /** Formato "lindo": hasta 6 decimales, sin ceros de relleno. Para totales y subtítulos. */
    function fmtTrim(n) {
      if (!isFinite(n)) return '∞';
      return n.toLocaleString('es-AR', { maximumFractionDigits: 6 });
    }

    /** Exponente en superíndice: 10³ en vez de 10^3. */
    const SUP = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
    function sup(e) {
      const s = String(Math.abs(e)).split('').map((d) => SUP[Number(d)]).join('');
      return (e < 0 ? '⁻' : '') + s;
    }

    /** Texto del número grande del panel: cae a notación científica cuando corresponde. */
    function fmtTotal(n) {
      if (!isFinite(n)) return '∞';
      const abs = Math.abs(n);
      if (abs !== 0 && (abs >= 1e15 || abs < 1e-5)) {
        const e = Math.floor(Math.log10(abs));
        const mant = n / Math.pow(10, e);
        return fmtTrim(snap(mant)) + ' × 10' + sup(e);
      }
      return fmtTrim(n);
    }

    const row = (k, v, opt) =>
      Object.assign({ k: k, v: v, format: 'plain', decimals: decOf(v) }, opt || {});

    // ---------- teoría de números ----------

    function gcd(a, b) {
      a = Math.abs(a); b = Math.abs(b);
      while (b) { const t = a % b; a = b; b = t; }
      return a;
    }

    /** Pasos del algoritmo de Euclides: [{a, b, q, r}] */
    function euclides(a, b) {
      a = Math.abs(a); b = Math.abs(b);
      if (a < b) { const t = a; a = b; b = t; }
      const pasos = [];
      let guard = 0;
      while (b && guard++ < 60) {
        const q = Math.floor(a / b);
        const r = a - q * b;
        pasos.push({ a: a, b: b, q: q, r: r });
        a = b; b = r;
      }
      return pasos;
    }

    /** Factorización en primos agrupada: {texto, factores:[[p,e]]} */
    function factorizar(n) {
      let x = Math.abs(Math.floor(n));
      const f = [];
      if (x < 2) return { texto: x === 1 ? '1 (no se factoriza)' : String(x), factores: [] };
      for (let p = 2; p * p <= x; p += p === 2 ? 1 : 2) {
        let e = 0;
        while (x % p === 0) { x /= p; e++; }
        if (e) f.push([p, e]);
      }
      if (x > 1) f.push([x, 1]);
      const sup = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
      const supDe = (e) => String(e).split('').map((d) => sup[Number(d)]).join('');
      return {
        texto: f.map((p) => (p[1] === 1 ? String(p[0]) : p[0] + supDe(p[1]))).join(' × '),
        factores: f,
      };
    }

    function esPrimo(n) {
      n = Math.abs(Math.floor(n));
      if (n < 2) return false;
      if (n < 4) return true;
      if (n % 2 === 0) return false;
      for (let i = 3; i * i <= n; i += 2) if (n % i === 0) return false;
      return true;
    }

    function primoSiguiente(n) { let x = Math.floor(n) + 1; while (!esPrimo(x)) x++; return x; }
    function primoAnterior(n) { let x = Math.floor(n) - 1; while (x >= 2 && !esPrimo(x)) x--; return x >= 2 ? x : null; }

    /** Cantidad de divisores a partir de la factorización: ∏(eᵢ+1). */
    function cantDivisores(fac) {
      if (!fac.factores.length) return 1;
      return fac.factores.reduce((a, p) => a * (p[1] + 1), 1);
    }

    // ---------- UI: los campos cambian de sentido según la rama ----------

    function syncFields(caseId) {
      const visibles = CASE_FIELDS[caseId] || CASE_FIELDS.potencias;
      const labels = CASE_LABELS[caseId] || {};
      ['op', 'x', 'y', 'lista'].forEach(function (id) {
        const el = document.getElementById(id);
        if (!el) return;
        const box = el.closest('.f');
        if (box) box.hidden = visibles.indexOf(id) === -1;
        const lab = document.querySelector('label[for="' + id + '"]');
        if (lab && labels[id]) lab.textContent = labels[id];
      });
    }

    // ---------- ramas ----------

    function ramaPotencias(v) {
      const base = numLocal(v.x);
      const exp = numLocal(v.y);
      const op = String(v.op || 'potencia');
      if (base === null || exp === null) return err('Completá los dos números.');

      const rows = [];
      let r, titulo, sub;

      if (op === 'raiz') {
        if (exp === 0) return err('El índice de la raíz no puede ser 0: no existe la raíz cero-ésima.');
        if (base < 0 && Number.isInteger(exp) && exp % 2 === 0) {
          return err(
            'No existe raíz de índice par de un número negativo dentro de los reales: ningún número real elevado a ' +
            fmt(exp) + ' da ' + fmt(base) + '. Haría falta la unidad imaginaria i.'
          );
        }
        r = snap(base < 0 ? -Math.pow(-base, 1 / exp) : Math.pow(base, 1 / exp));
        const redondeada = Math.round(r);
        const exacta = Math.abs(Math.pow(redondeada, exp) - base) < 1e-9;
        titulo = fmtTotal(r);
        sub =
          'Raíz de índice ' + fmt(exp) + ' de ' + fmt(base) + ' = ' + fmt(base) + '^(1/' + fmt(exp) + ') = ' +
          fmtTotal(r) + (exacta ? ' · es exacta' : ' · es irracional, lo que ves es un redondeo');
        rows.push(row('Paso 1 — la raíz es una potencia: ' + fmt(base) + '^(1/' + fmt(exp) + ')', r, { extra: true }));
        rows.push(row('Paso 2 — comprobación: ' + fmt(redondeada) + ' elevado a ' + fmt(exp), Math.pow(redondeada, exp), { ref: exacta ? 'exacta' : 'aproximada' }));
        if (base >= 0) {
          rows.push(row('Raíz cuadrada de ' + fmt(base), snap(Math.sqrt(base))));
          const rc = Math.round(Math.sqrt(base));
          rows.push(row('Cuadrado perfecto más cercano — ' + rc + '²', rc * rc));
        }
        rows.push(row('Raíz cúbica de ' + fmt(base), snap(Math.cbrt(base))));
      } else {
        r = snap(Math.pow(base, exp));
        titulo = fmtTotal(r);
        let expansion = '';
        if (Number.isInteger(exp) && exp > 1 && exp <= 8) {
          expansion = new Array(exp).fill(fmt(base)).join(' × ');
        } else if (exp === 0) {
          expansion = 'cualquier base distinta de 0 elevada a 0 da 1';
        } else if (exp === 1) {
          expansion = 'elevar a 1 deja la base igual';
        } else if (exp < 0) {
          expansion = '1 / ' + fmt(base) + '^' + fmt(-exp) + ' — el exponente negativo invierte';
        } else if (Number.isInteger(exp)) {
          expansion = 'multiplicar ' + fmt(base) + ' por sí mismo ' + fmt(exp) + ' veces';
        } else {
          expansion = 'exponente fraccionario: ' + fmt(base) + ' elevado a ' + fmt(exp) + ' es una raíz';
        }
        sub = fmt(base) + '^' + fmt(exp) + ' = ' + expansion + ' = ' + fmtTotal(r);
        rows.push(row('Paso 1 — desarrollo: ' + expansion, r, { extra: true }));
        rows.push(row('Cuadrado de la base — ' + fmt(base) + '²', snap(base * base)));
        rows.push(row('Cubo de la base — ' + fmt(base) + '³', snap(base * base * base)));
        if (base >= 0) rows.push(row('Raíz cuadrada de la base', snap(Math.sqrt(base))));
        rows.push(row('Raíz cúbica de la base', snap(Math.cbrt(base))));
      }

      const abs = Math.abs(r);
      rows.push({
        k: 'Orden de magnitud del resultado',
        ref: 'exponente de 10',
        v: abs > 0 && isFinite(abs) ? Math.floor(Math.log10(abs)) : 0,
        format: 'plain',
        decimals: 0,
      });

      return { total: titulo, sub: sub, rows: rows, magnitud: r };
    }

    function ramaLogaritmos(v) {
      const x = numLocal(v.x);
      const b = numLocal(v.y);
      if (x === null) return err('Escribí el número del que querés el logaritmo.');
      if (x <= 0) return err('El logaritmo sólo existe para números mayores que cero: no hay log de 0 ni de negativos en los reales.');
      const base = b === null || b === 0 ? 10 : b;
      if (base <= 0 || base === 1) return err('La base tiene que ser mayor que 0 y distinta de 1: con base 1 ningún exponente da otra cosa que 1.');

      const lnX = Math.log(x);
      const lnB = Math.log(base);
      const logb = snap(lnX / lnB);
      const log10 = snap(Math.log10(x));
      const ln = snap(lnX);
      const log2 = snap(Math.log2(x));
      const comprobacion = snap(Math.pow(base, logb));

      const rows = [
        row('Paso 1 — numerador del cambio de base: ln(' + fmt(x) + ')', ln),
        row('Paso 2 — denominador: ln(' + fmt(base) + ')', snap(lnB)),
        row('Paso 3 — cociente: log en base ' + fmt(base) + ' de ' + fmt(x), logb, { extra: true, ref: 'cambio de base' }),
        row('Comprobación — ' + fmt(base) + ' elevado a ' + fmt(logb), comprobacion, { ref: 'vuelve a ' + fmt(x) }),
        row('Logaritmo decimal — log₁₀(' + fmt(x) + ')', log10),
        row('Logaritmo natural — ln(' + fmt(x) + ')', ln),
        row('Logaritmo binario — log₂(' + fmt(x) + ')', log2),
      ];

      return {
        total: fmtTotal(logb),
        sub:
          'log en base ' + fmt(base) + ' de ' + fmt(x) + ' = ln(' + fmt(x) + ') / ln(' + fmt(base) + ') = ' +
          fmtTotal(logb) + ' · o sea que ' + fmt(base) + ' elevado a ' + fmtTotal(logb) + ' da ' + fmt(x) + '.',
        rows: rows,
        magnitud: x,
      };
    }

    function ramaDivisores(v) {
      const extras = String(v.lista || '')
        .split(/[,;\s]+/)
        .map(numLocal)
        .filter((n) => n !== null);
      const nums = [numLocal(v.x), numLocal(v.y)]
        .concat(extras)
        .filter((n) => n !== null)
        .map((n) => Math.abs(Math.trunc(n)))
        .filter((n) => n > 0);

      if (nums.length < 2) return err('Hacen falta al menos dos números enteros distintos de cero.');

      const mcd = nums.reduce(gcd);
      const mcm = nums.reduce((a, b) => (a / gcd(a, b)) * b);
      const lista = nums.join(', ');

      const rows = [];
      // El paso a paso de Euclides se muestra sobre el primer par: es el que se
      // escribe en la carpeta. Con más números, el MCD se arrastra de a pares.
      euclides(nums[0], nums[1]).slice(0, 8).forEach(function (p, i) {
        rows.push(
          row(
            'Euclides ' + (i + 1) + ' — ' + p.a + ' = ' + p.q + ' × ' + p.b + ' + ' + p.r,
            p.r,
            { ref: 'resto', decimals: 0 }
          )
        );
      });
      rows.push(row('MCD(' + lista + ') — el último resto distinto de cero', mcd, { extra: true, decimals: 0 }));
      rows.push(row('MCM(' + lista + ') — producto dividido el MCD', mcm, { extra: true, decimals: 0 }));

      nums.slice(0, 4).forEach(function (n) {
        const f = factorizar(n);
        rows.push(row('Factorización — ' + n + ' = ' + f.texto, n, { ref: 'primos', decimals: 0 }));
      });

      const primero = nums[0];
      const fac = factorizar(primero);
      rows.push({
        k: 'Divisores de ' + primero + ' — (exponente + 1) multiplicados',
        v: cantDivisores(fac),
        format: 'unit',
        unit: 'divisores',
        decimals: 0,
      });
      const primo = esPrimo(primero);
      rows.push(row(primo ? primero + ' es primo' : primero + ' es compuesto', primero, {
        ref: primo ? 'sólo 1 y él mismo' : 'tiene divisores propios',
        decimals: 0,
      }));
      const ant = primoAnterior(primero);
      if (ant !== null) rows.push(row('Primo anterior a ' + primero, ant, { decimals: 0 }));
      rows.push(row('Primo siguiente a ' + primero, primoSiguiente(primero), { decimals: 0 }));

      return {
        total: fmt(mcd, 0),
        sub:
          'MCD(' + lista + ') = ' + fmt(mcd, 0) + ' · MCM = ' + fmt(mcm, 0) +
          (mcd === 1 ? ' · son coprimos: no comparten ningún factor primo, así que el MCM es el producto.' : ' · se cumple que MCD × MCM = ' + fmt(mcd * mcm, 0) + '.'),
        rows: rows,
        magnitud: mcm,
      };
    }

    function ramaCientifica(v) {
      const n = numCientifico(v.x);
      if (n === null) return err('Escribí un número. Vale también en notación científica: 3,2e8 o 3,2×10^8.');
      if (n === 0) {
        return {
          total: '0',
          sub: 'El 0 es la única excepción: no tiene notación científica, porque no se puede escribir como una mantisa por una potencia de 10.',
          rows: [row('Número ingresado', 0, { decimals: 0 })],
          magnitud: 1,
        };
      }
      const abs = Math.abs(n);
      const signo = n < 0 ? -1 : 1;
      const exponente = Math.floor(Math.log10(abs));
      const mantisa = snap((signo * abs) / Math.pow(10, exponente));
      const expIng = Math.floor(exponente / 3) * 3;
      const mantIng = snap((signo * abs) / Math.pow(10, expIng));
      const prefijo = PREFIJOS_SI[String(expIng)] || 'sin prefijo del SI (10^' + expIng + ')';

      const rows = [
        row('Paso 1 — mantisa: una sola cifra antes de la coma', mantisa, { extra: true }),
        {
          k: 'Paso 2 — exponente: lugares que se corrió la coma',
          ref: exponente >= 0 ? 'a la izquierda' : 'a la derecha',
          v: exponente,
          format: 'plain',
          decimals: 0,
        },
        row('Notación de ingeniería — mantisa', mantIng),
        {
          k: 'Notación de ingeniería — exponente (múltiplo de 3)',
          ref: prefijo,
          v: expIng,
          format: 'plain',
          decimals: 0,
        },
        row('Número expandido', n),
      ];

      return {
        total: fmt(mantisa) + ' × 10' + sup(exponente),
        sub:
          fmt(n) + ' = ' + fmt(mantisa) + ' × 10' + sup(exponente) +
          ' · en ingeniería, ' + fmt(mantIng) + ' × 10' + sup(expIng) + ' (' + prefijo + ')',
        rows: rows,
        magnitud: n,
      };
    }

    function err(msg) {
      return { total: '—', sub: msg, rows: [], magnitud: null };
    }

    // ---------- compute ----------

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'potencias';
      syncFields(id);

      const out =
        id === 'logaritmos' ? ramaLogaritmos(v)
        : id === 'divisores' ? ramaDivisores(v)
        : id === 'cientifica' ? ramaCientifica(v)
        : ramaPotencias(v);

      if (!out.rows.length && out.total === '—') {
        return { total: out.total, sub: out.sub, rows: [], chart: [] };
      }

      // Regla de órdenes de magnitud: logarítmica, de 10⁻⁹ a 10¹⁵.
      const m = Math.abs(out.magnitud || 0);
      const e = m > 0 && isFinite(m) ? Math.log10(m) : MAG_RANGE.min;
      const pos = Math.max(0, Math.min(100, ((e - MAG_RANGE.min) / (MAG_RANGE.max - MAG_RANGE.min)) * 100));

      const chart = BANDS.map(function (b) {
        return {
          label: b.label,
          value: b.to - b.from,
          from: b.from,
          to: b.to,
          tone: b.tone === 'good' ? 'good' : b.tone === 'bad' ? 'bad' : b.tone === 'warn' ? 'warn' : 'main',
        };
      });

      const fuera = e < MAG_RANGE.min ? ' (por debajo de la regla)' : e > MAG_RANGE.max ? ' (por encima de la regla)' : '';

      return {
        total: out.total,
        sub: out.sub,
        rows: out.rows,
        chart: chart,
        // Las franjas del gráfico valen décadas (exponentes de 10), no pesos.
        // Cada fila del desglose pisa el formato con el suyo.
        format: 'unit',
        unit: 'décadas',
        decimals: 0,
        position: Number(pos.toFixed(1)),
        positionLabel: 'Orden de magnitud 10' + sup(Math.floor(e)) + fuera,
      };
    });

    syncFields('potencias');
  })();
</script>
