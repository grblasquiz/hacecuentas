---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PotenciasRaicesExperience from '../../components/generated/PotenciasRaicesExperience.astro';
import DecisionRelatedLinks from '../../components/DecisionRelatedLinks.astro';
import { hub } from '../../lib/hubs/potencias';
const canonical='https://hacecuentas.com/matematica/potencias-y-raices';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,description:hub.description,url:canonical,applicationCategory:'EducationalApplication',operatingSystem:'Web',dateModified:hub.lastReviewed,offers:{'@type':'Offer',price:'0',priceCurrency:'ARS'}};
import HubCitableStats from '../../components/hub/HubCitableStats.astro';
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <PotenciasRaicesExperience />
  <DecisionRelatedLinks items={[
    { href: '/matematica/ecuaciones-y-polinomios', title: 'Ecuaciones y polinomios', description: 'Resolvé expresiones con incógnitas paso a paso.', icon: '∑' },
    { href: '/matematica/fracciones', title: 'Fracciones', description: 'Simplificá, sumá y compará fracciones.', icon: '½' },
    { href: '/matematica/porcentajes', title: 'Porcentajes', description: 'Aplicá aumentos, descuentos y proporciones.', icon: '%' },
  ]} />
  <HubCitableStats data={hub} />
  <Footer />
</Layout>
