---
/**
 * Hub de decisión — "¿Cómo resuelvo este triángulo?"
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de matematica/regla-de-tres.astro: la página sólo aporta los
 * datos (src/lib/hubs/triangulos-y-trigonometria.ts) y su compute(). El chrome,
 * el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/triangulos-y-trigonometria';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * No hay plata en ninguna rama y el default de HubRow es 'ars'. Toda fila
     * declara su formato: 'unit' para longitudes, superficies, grados,
     * radianes, gradianes, cm y pulgadas; 'plain' para las razones
     * trigonométricas y los cuadrados, que son adimensionales.
     */
    const U = { format: 'unit', unit: 'u', decimals: 2 };
    const U2 = { format: 'unit', unit: 'u²', decimals: 2 };
    const GRA = { format: 'unit', unit: '°', decimals: 2 };
    const GRA4 = { format: 'unit', unit: '°', decimals: 4 };
    const RAD = { format: 'unit', unit: 'rad', decimals: 6 };
    const GON = { format: 'unit', unit: 'grad', decimals: 4 };
    const CM = { format: 'unit', unit: 'cm', decimals: 2 };
    const PULG = { format: 'unit', unit: '"', decimals: 2 };
    const PLAIN = { format: 'plain', decimals: 2 };
    const PLAIN4 = { format: 'plain', decimals: 4 };

    /**
     * Redondeo anti ruido de punto flotante: si el número quedó a menos de
     * 1e-10 de un entero, es ese entero. Sin esto sen(180°) devuelve 1,22e-16
     * y la hipotenusa de 3-4-5 sale 4,999999999999999.
     */
    const S = (n) => (isFinite(n) && Math.abs(n - Math.round(n)) < 1e-10 ? Math.round(n) : n);
    /** Igual pero para razones trigonométricas: además engancha ±0,5. */
    const ST = (n) => {
      const r = S(n);
      if (Math.abs(Math.abs(r) - 0.5) < 1e-12) return Math.sign(r) * 0.5;
      return r;
    };

    const D2R = Math.PI / 180;
    const R2D = 180 / Math.PI;

    const fmt = (n) => {
      if (!isFinite(n)) return '—';
      const abs = Math.abs(n);
      const dec = abs >= 1000 ? 0 : abs >= 1 ? 2 : 4;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };

    const err = (msg, k, v) => ({
      total: '—',
      sub: msg,
      rows: [{ k: k, v: v, ...PLAIN }],
      chart: [],
      format: 'plain',
      decimals: 2,
    });

    /** sen/cos/tan con snap: sen(180°) = 0, cos(90°) = 0, sen(30°) = 0,5. */
    const sinD = (deg) => ST(Math.sin(deg * D2R));
    const cosD = (deg) => ST(Math.cos(deg * D2R));

    H.onCompute(function (v, kase) {
      const a = H.num(v.a);
      const b = H.num(v.b);
      const c = H.num(v.c);
      const ang = H.num(v.ang);
      const ang2 = H.num(v.ang2);
      const pulg = H.num(v.pulg);
      const uAng = String(v.unidadAng || 'grados');
      const id = (kase && kase.id) || 'pit-hipotenusa';

      const CM_POR_PULGADA = 2.54;
      const RAIZ_337 = Math.sqrt(16 * 16 + 9 * 9); // diagonal en "unidades 16:9"

      // ---- 1) PITÁGORAS: falta la hipotenusa -----------------------------
      // c = √(a² + b²)
      if (id === 'pit-hipotenusa') {
        if (a <= 0 || b <= 0) return err('Cargá los dos catetos en los campos A y B (mayores que cero).', 'Cateto más chico', Math.min(a, b));
        const a2 = S(a * a), b2 = S(b * b);
        const hip = S(Math.sqrt(a2 + b2));
        const area = S((a * b) / 2);
        const angA = S(Math.atan2(a, b) * R2D);
        const angB = S(90 - angA);
        return {
          total: fmt(hip) + ' u',
          sub:
            'Catetos ' + fmt(a) + ' y ' + fmt(b) + ' → hipotenusa ' + fmt(hip) +
            ' · c = √(a² + b²) = √' + fmt(a2 + b2),
          rows: [
            { k: 'Cateto a (campo A)', v: a, ...U },
            { k: 'Cateto b (campo B)', v: b, ...U },
            { k: 'a² — primer cateto al cuadrado', ref: 'paso 1', v: a2, ...PLAIN },
            { k: 'b² — segundo cateto al cuadrado', ref: 'paso 1', v: b2, ...PLAIN },
            { k: 'a² + b² — la suma bajo la raíz', ref: 'paso 2', v: S(a2 + b2), ...PLAIN },
            { k: 'Raíz cuadrada → hipotenusa', ref: 'paso 3: el resultado', v: hip, extra: true, ...U },
            { k: 'Área del triángulo = a × b ÷ 2', ref: 'dato derivado', v: area, ...U2 },
            { k: 'Perímetro = a + b + c', ref: 'dato derivado', v: S(a + b + hip), ...U },
            { k: 'Ángulo opuesto al cateto a (en grados)', ref: 'arcotangente de a ÷ b', v: angA, ...GRA },
            { k: 'Ángulo opuesto al cateto b (en grados)', ref: 'los dos agudos suman 90°', v: angB, ...GRA },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Cateto a = ' + fmt(a), value: Math.abs(a), tone: 'prop' },
            { label: 'Cateto b = ' + fmt(b), value: Math.abs(b), tone: 'prop' },
            { label: 'Hipotenusa = ' + fmt(hip), value: Math.abs(hip), tone: 'main' },
          ],
        };
      }

      // ---- 2) PITÁGORAS: falta un cateto ---------------------------------
      // b = √(c² − a²)
      if (id === 'pit-cateto') {
        if (c <= 0 || a <= 0) return err('Cargá la hipotenusa en el campo C y el cateto que conocés en el campo A.', 'Hipotenusa', c);
        if (c <= a) return err('La hipotenusa tiene que ser mayor que el cateto: revisá si los cargaste al revés.', 'Diferencia c − a', S(c - a));
        const c2 = S(c * c), a2 = S(a * a);
        const cat = S(Math.sqrt(c2 - a2));
        const area = S((a * cat) / 2);
        const angA = S(Math.asin(Math.min(1, a / c)) * R2D);
        return {
          total: fmt(cat) + ' u',
          sub:
            'Hipotenusa ' + fmt(c) + ' y cateto ' + fmt(a) + ' → el otro cateto mide ' + fmt(cat) +
            ' · b = √(c² − a²) = √' + fmt(c2 - a2),
          rows: [
            { k: 'Hipotenusa c (campo C)', v: c, ...U },
            { k: 'Cateto conocido a (campo A)', v: a, ...U },
            { k: 'c² — hipotenusa al cuadrado', ref: 'paso 1', v: c2, ...PLAIN },
            { k: 'a² — cateto al cuadrado', ref: 'paso 1', v: a2, ...PLAIN },
            { k: 'c² − a² — acá se RESTA', ref: 'paso 2', v: S(c2 - a2), ...PLAIN },
            { k: 'Raíz cuadrada → el cateto que faltaba', ref: 'paso 3: el resultado', v: cat, extra: true, ...U },
            { k: 'Área del triángulo = a × b ÷ 2', ref: 'dato derivado', v: area, ...U2 },
            { k: 'Perímetro = a + b + c', ref: 'dato derivado', v: S(a + cat + c), ...U },
            { k: 'Ángulo opuesto al cateto conocido (en grados)', ref: 'arcoseno de a ÷ c', v: angA, ...GRA },
            { k: 'Verificación: a² + b² (tiene que dar c²)', ref: 'chequeo', v: S(a2 + cat * cat), ...PLAIN },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Cateto conocido = ' + fmt(a), value: Math.abs(a), tone: 'prop' },
            { label: 'Cateto que faltaba = ' + fmt(cat), value: Math.abs(cat), tone: 'main' },
            { label: 'Hipotenusa = ' + fmt(c), value: Math.abs(c), tone: 'good' },
          ],
        };
      }

      // ---- 3) RAZONES trigonométricas de un ángulo ------------------------
      if (id === 'razones') {
        // El ángulo entra en la unidad elegida y se lleva a grados.
        const grados =
          uAng === 'radianes' ? ang * R2D : uAng === 'gradianes' ? (ang * 360) / 400 : ang;
        const rad = grados * D2R;
        const sen = sinD(grados);
        const cos = cosD(grados);
        const norm = ((grados % 360) + 360) % 360;
        const cuad =
          norm === 0 || norm === 90 || norm === 180 || norm === 270
            ? 'sobre un eje (ángulo cuadrantal)'
            : norm < 90
              ? 'en el cuadrante I (seno y coseno positivos)'
              : norm < 180
                ? 'en el cuadrante II (seno positivo, coseno negativo)'
                : norm < 270
                  ? 'en el cuadrante III (seno y coseno negativos)'
                  : 'en el cuadrante IV (seno negativo, coseno positivo)';
        const rows = [
          { k: 'Ángulo cargado (en grados)', ref: 'unidad de entrada: ' + uAng, v: S(grados), ...GRA4 },
          { k: 'El mismo ángulo en radianes', ref: 'grados × π ÷ 180', v: S(rad), ...RAD },
          { k: 'Seno', ref: 'opuesto ÷ hipotenusa', v: sen, extra: true, ...PLAIN4 },
          { k: 'Coseno', ref: 'adyacente ÷ hipotenusa', v: cos, extra: true, ...PLAIN4 },
        ];
        if (cos !== 0) rows.push({ k: 'Tangente = seno ÷ coseno', ref: 'opuesto ÷ adyacente', v: ST(sen / cos), extra: true, ...PLAIN4 });
        if (sen !== 0) rows.push({ k: 'Cotangente = coseno ÷ seno', ref: 'la recíproca de la tangente', v: ST(cos / sen), ...PLAIN4 });
        if (cos !== 0) rows.push({ k: 'Secante = 1 ÷ coseno', ref: 'la recíproca del coseno', v: ST(1 / cos), ...PLAIN4 });
        if (sen !== 0) rows.push({ k: 'Cosecante = 1 ÷ seno', ref: 'la recíproca del seno', v: ST(1 / sen), ...PLAIN4 });
        rows.push({ k: 'Verificación: sen² + cos² (tiene que dar 1)', ref: 'identidad fundamental', v: S(sen * sen + cos * cos), ...PLAIN4 });
        const indef = [];
        if (cos === 0) indef.push('la tangente y la secante son indefinidas (el coseno vale 0)');
        if (sen === 0) indef.push('la cotangente y la cosecante son indefinidas (el seno vale 0)');
        return {
          total: fmt(sen),
          sub:
            'Para ' + fmt(grados) + '°: sen = ' + fmt(sen) + ', cos = ' + fmt(cos) +
            (cos !== 0 ? ', tan = ' + fmt(sen / cos) : '') + ' · el ángulo cae ' + cuad +
            (indef.length ? ' · ' + indef.join(' y ') : ''),
          rows: rows,
          format: 'plain',
          decimals: 4,
          chart: [
            { label: 'Seno = ' + fmt(sen), value: Math.abs(sen), tone: 'main' },
            { label: 'Coseno = ' + fmt(cos), value: Math.abs(cos), tone: 'prop' },
            { label: cos !== 0 ? 'Tangente = ' + fmt(sen / cos) : 'Tangente indefinida', value: cos !== 0 ? Math.min(10, Math.abs(sen / cos)) : 0, tone: 'good' },
          ],
        };
      }

      // ---- 4) RESOLVER un triángulo rectángulo con trigonometría ----------
      // opuesto = c·sen(θ) · adyacente = c·cos(θ)
      if (id === 'rectangulo-trig') {
        if (c <= 0) return err('Cargá la hipotenusa en el campo C (mayor que cero).', 'Hipotenusa', c);
        if (ang <= 0 || ang >= 90) return err('El ángulo tiene que ser agudo: entre 0° y 90°. Se lee siempre en GRADOS en esta rama.', 'Ángulo cargado (en grados)', ang);
        const sen = sinD(ang);
        const cos = cosD(ang);
        const op = S(c * sen);
        const ady = S(c * cos);
        const otro = S(90 - ang);
        const area = S((op * ady) / 2);
        return {
          total: fmt(op) + ' u',
          sub:
            'Hipotenusa ' + fmt(c) + ' con ángulo ' + fmt(ang) + '°: cateto opuesto ' + fmt(op) +
            ' y cateto adyacente ' + fmt(ady) + ' · el otro ángulo agudo mide ' + fmt(otro) + '°',
          rows: [
            { k: 'Hipotenusa (campo C)', v: c, ...U },
            { k: 'Ángulo agudo cargado (en grados)', ref: 'esta rama lee siempre grados', v: ang, ...GRA },
            { k: 'Seno del ángulo', ref: 'paso 1', v: sen, ...PLAIN4 },
            { k: 'Coseno del ángulo', ref: 'paso 1', v: cos, ...PLAIN4 },
            { k: 'Cateto opuesto = hipotenusa × sen', ref: 'paso 2: SOH', v: op, extra: true, ...U },
            { k: 'Cateto adyacente = hipotenusa × cos', ref: 'paso 2: CAH', v: ady, extra: true, ...U },
            { k: 'El otro ángulo agudo (en grados)', ref: '90° − el ángulo cargado', v: otro, ...GRA },
            { k: 'Área = opuesto × adyacente ÷ 2', ref: 'dato derivado', v: area, ...U2 },
            { k: 'Perímetro', ref: 'dato derivado', v: S(op + ady + c), ...U },
            { k: 'Verificación: opuesto² + adyacente² (tiene que dar la hipotenusa²)', ref: 'chequeo por Pitágoras', v: S(op * op + ady * ady), ...PLAIN },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Cateto opuesto = ' + fmt(op), value: Math.abs(op), tone: 'main' },
            { label: 'Cateto adyacente = ' + fmt(ady), value: Math.abs(ady), tone: 'prop' },
            { label: 'Hipotenusa = ' + fmt(c), value: Math.abs(c), tone: 'good' },
          ],
        };
      }

      // ---- 5) LEY DE SENOS (dos ángulos y el lado opuesto al primero) -----
      // C = 180 − A − B · b = a·senB/senA · c = a·senC/senA
      if (id === 'ley-senos') {
        const A = ang, B = ang2;
        if (A <= 0 || B <= 0) return err('Cargá los dos ángulos (campo de ángulo y segundo ángulo), en grados y mayores que cero.', 'Suma de los dos ángulos (en grados)', S(A + B));
        if (A + B >= 180) return err('Los dos ángulos tienen que sumar menos de 180°: si no, el tercero no existe.', 'Suma cargada (en grados)', S(A + B));
        if (a <= 0) return err('Cargá en el campo A el lado opuesto al ángulo A (mayor que cero).', 'Lado a', a);
        const C = S(180 - A - B);
        const senA = sinD(A), senB = sinD(B), senC = sinD(C);
        const k = a / senA;
        const lb = S(k * senB);
        const lc = S(k * senC);
        const per = S(a + lb + lc);
        const area = S(0.5 * a * lb * senC);
        return {
          total: fmt(lb) + ' u',
          sub:
            'Con A = ' + fmt(A) + '°, B = ' + fmt(B) + '° y a = ' + fmt(a) + ': C = ' + fmt(C) +
            '°, b = ' + fmt(lb) + ' y c = ' + fmt(lc) + ' · a/sen A = ' + fmt(k),
          rows: [
            { k: 'Ángulo A (en grados)', v: A, ...GRA },
            { k: 'Ángulo B (en grados)', v: B, ...GRA },
            { k: 'Ángulo C = 180° − A − B', ref: 'paso 1: el tercer ángulo', v: C, ...GRA },
            { k: 'Lado a (opuesto a A)', v: a, ...U },
            { k: 'sen A', ref: 'paso 2', v: senA, ...PLAIN4 },
            { k: 'Constante k = a ÷ sen A', ref: 'paso 3: la razón que comparten los tres lados', v: S(k), ...PLAIN4 },
            { k: 'sen B', ref: 'paso 4', v: senB, ...PLAIN4 },
            { k: 'Lado b = k × sen B', ref: 'paso 5: el resultado', v: lb, extra: true, ...U },
            { k: 'sen C', ref: 'paso 6', v: senC, ...PLAIN4 },
            { k: 'Lado c = k × sen C', ref: 'paso 7', v: lc, extra: true, ...U },
            { k: 'Perímetro = a + b + c', ref: 'dato derivado', v: per, ...U },
            { k: 'Área = ½ · a · b · sen C', ref: 'dato derivado', v: area, ...U2 },
            { k: 'Verificación: b ÷ sen B (tiene que dar la misma k)', ref: 'chequeo', v: senB ? S(lb / senB) : 0, ...PLAIN4 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Lado a = ' + fmt(a), value: Math.abs(a), tone: 'prop' },
            { label: 'Lado b = ' + fmt(lb), value: Math.abs(lb), tone: 'main' },
            { label: 'Lado c = ' + fmt(lc), value: Math.abs(lc), tone: 'good' },
          ],
        };
      }

      // ---- 6) LEY DE COSENOS ---------------------------------------------
      // LLL: cos A = (b² + c² − a²)/(2bc) · LAL: c² = a² + b² − 2ab·cos C
      if (id === 'ley-cosenos') {
        if (a > 0 && b > 0 && c > 0) {
          // Modo LLL: tres lados → tres ángulos
          if (a + b <= c || a + c <= b || b + c <= a) {
            return err(
              'Esos tres lados no forman triángulo: cada lado tiene que ser menor que la suma de los otros dos.',
              'Perímetro cargado', S(a + b + c)
            );
          }
          const cosA = (b * b + c * c - a * a) / (2 * b * c);
          const cosB = (a * a + c * c - b * b) / (2 * a * c);
          const A = S(Math.acos(Math.max(-1, Math.min(1, cosA))) * R2D);
          const B = S(Math.acos(Math.max(-1, Math.min(1, cosB))) * R2D);
          const C = S(180 - A - B);
          const s = (a + b + c) / 2;
          const area = S(Math.sqrt(Math.max(0, s * (s - a) * (s - b) * (s - c))));
          return {
            total: fmt(C) + '°',
            sub:
              'Modo tres lados: ' + fmt(a) + ', ' + fmt(b) + ' y ' + fmt(c) + ' → ángulos ' + fmt(A) + '°, ' +
              fmt(B) + '° y ' + fmt(C) + '° (suman 180°)',
            rows: [
              { k: 'Lado a (campo A)', v: a, ...U },
              { k: 'Lado b (campo B)', v: b, ...U },
              { k: 'Lado c (campo C)', v: c, ...U },
              { k: 'cos A = (b² + c² − a²) ÷ (2·b·c)', ref: 'paso 1: la ley despejada', v: ST(cosA), ...PLAIN4 },
              { k: 'Ángulo A = arcocoseno (en grados)', ref: 'paso 2', v: A, extra: true, ...GRA },
              { k: 'cos B = (a² + c² − b²) ÷ (2·a·c)', ref: 'paso 3', v: ST(cosB), ...PLAIN4 },
              { k: 'Ángulo B = arcocoseno (en grados)', ref: 'paso 4', v: B, extra: true, ...GRA },
              { k: 'Ángulo C = 180° − A − B', ref: 'paso 5: el que queda', v: C, extra: true, ...GRA },
              { k: 'Área por Herón', ref: 'dato derivado', v: area, ...U2 },
              { k: 'Verificación: A + B + C (tiene que dar 180)', ref: 'chequeo', v: S(A + B + C), ...GRA },
            ],
            format: 'plain',
            decimals: 2,
            chart: [
              { label: 'Ángulo A = ' + fmt(A) + '°', value: Math.abs(A), tone: 'prop' },
              { label: 'Ángulo B = ' + fmt(B) + '°', value: Math.abs(B), tone: 'good' },
              { label: 'Ángulo C = ' + fmt(C) + '°', value: Math.abs(C), tone: 'main' },
            ],
          };
        }
        // Modo LAL: dos lados y el ángulo comprendido
        if (a <= 0 || b <= 0) return err('Cargá los lados a y b (campos A y B) mayores que cero. Dejá el campo C en 0 si querés el modo dos lados + ángulo.', 'Lado más chico', Math.min(a, b));
        if (ang <= 0 || ang >= 180) return err('El ángulo comprendido tiene que estar entre 0° y 180°. Se lee en GRADOS.', 'Ángulo cargado (en grados)', ang);
        const cosC = cosD(ang);
        const c2 = a * a + b * b - 2 * a * b * cosC;
        const lc = S(Math.sqrt(Math.max(0, c2)));
        const area = S(0.5 * a * b * sinD(ang));
        const cosA = lc ? (b * b + lc * lc - a * a) / (2 * b * lc) : 1;
        const A = S(Math.acos(Math.max(-1, Math.min(1, cosA))) * R2D);
        const B = S(180 - A - ang);
        return {
          total: fmt(lc) + ' u',
          sub:
            'Modo dos lados + ángulo: ' + fmt(a) + ' y ' + fmt(b) + ' con ' + fmt(ang) + '° entre ellos → el tercer lado mide ' +
            fmt(lc) + ' · c² = a² + b² − 2ab·cos C',
          rows: [
            { k: 'Lado a (campo A)', v: a, ...U },
            { k: 'Lado b (campo B)', v: b, ...U },
            { k: 'Ángulo C entre a y b (en grados)', v: ang, ...GRA },
            { k: 'a² + b²', ref: 'paso 1: la parte de Pitágoras', v: S(a * a + b * b), ...PLAIN },
            { k: 'cos C', ref: 'paso 2', v: cosC, ...PLAIN4 },
            { k: '2·a·b·cos C — el término de corrección', ref: 'paso 3: si C = 90° vale 0', v: S(2 * a * b * cosC), ...PLAIN },
            { k: 'c² = a² + b² − 2ab·cos C', ref: 'paso 4', v: S(c2), ...PLAIN },
            { k: 'Raíz cuadrada → lado c', ref: 'paso 5: el resultado', v: lc, extra: true, ...U },
            { k: 'Ángulo A (en grados)', ref: 'por la ley de cosenos despejada', v: A, ...GRA },
            { k: 'Ángulo B = 180° − A − C', ref: 'el que queda', v: B, ...GRA },
            { k: 'Área = ½ · a · b · sen C', ref: 'dato derivado', v: area, ...U2 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Lado a = ' + fmt(a), value: Math.abs(a), tone: 'prop' },
            { label: 'Lado b = ' + fmt(b), value: Math.abs(b), tone: 'good' },
            { label: 'Lado c = ' + fmt(lc), value: Math.abs(lc), tone: 'main' },
          ],
        };
      }

      // ---- 7) TALES / triángulos semejantes -------------------------------
      // a/b = c/x  →  x = b·c ÷ a
      if (id === 'tales') {
        if (a <= 0 || b <= 0 || c <= 0) return err('Cargá los tres segmentos conocidos (campos A, B y C) con valores mayores que cero.', 'Segmento a', a);
        const x = S((b * c) / a);
        const razon = S(a / b);
        return {
          total: fmt(x) + ' u',
          sub:
            fmt(a) + ' es a ' + fmt(b) + ' como ' + fmt(c) + ' es a ' + fmt(x) +
            ' · x = b × c ÷ a · razón de semejanza ' + fmt(razon),
          rows: [
            { k: 'Segmento a (campo A)', ref: 'en el caso sombra: la sombra de la persona', v: a, ...U },
            { k: 'Segmento b (campo B)', ref: 'en el caso sombra: la altura de la persona', v: b, ...U },
            { k: 'Segmento c (campo C)', ref: 'en el caso sombra: la sombra del objeto', v: c, ...U },
            { k: 'b × c', ref: 'paso 1: multiplicar en cruz', v: S(b * c), ...PLAIN },
            { k: 'Dividido a → x', ref: 'paso 2: el cuarto proporcional', v: x, extra: true, ...U },
            { k: 'Razón de semejanza a ÷ b', ref: 'paso 3', v: razon, ...PLAIN4 },
            { k: 'Verificación: c ÷ x (tiene que dar la misma razón)', ref: 'chequeo', v: x ? S(c / x) : 0, ...PLAIN4 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'a = ' + fmt(a), value: Math.abs(a), tone: 'prop' },
            { label: 'b = ' + fmt(b), value: Math.abs(b), tone: 'prop' },
            { label: 'c = ' + fmt(c), value: Math.abs(c), tone: 'good' },
            { label: 'x = ' + fmt(x), value: Math.abs(x), tone: 'main' },
          ],
        };
      }

      // ---- 8) DIAGONAL de rectángulo o caja, y pulgadas de TV -------------
      if (id === 'diagonal') {
        if (a <= 0 || b <= 0) return err('Cargá el ancho y el alto en los campos A y B (mayores que cero).', 'Medida más chica', Math.min(a, b));
        const es3d = c > 0;
        const suma = S(a * a + b * b + (es3d ? c * c : 0));
        const diag = S(Math.sqrt(suma));
        // Lectura de pantalla: los campos A y B se leen como el hueco en cm.
        const diagPorAncho = (a * RAIZ_337) / 16;
        const diagPorAlto = (b * RAIZ_337) / 9;
        const diagTvCm = Math.min(diagPorAncho, diagPorAlto);
        const limita = diagPorAncho <= diagPorAlto ? 'el ancho' : 'el alto';
        const tvMax = S(diagTvCm / CM_POR_PULGADA);
        const rows = [
          { k: 'Lado a — ancho (campo A)', v: a, ...U },
          { k: 'Lado b — alto (campo B)', v: b, ...U },
        ];
        if (es3d) rows.push({ k: 'Lado c — profundidad (campo C)', v: c, ...U });
        rows.push({ k: 'a²', ref: 'paso 1', v: S(a * a), ...PLAIN });
        rows.push({ k: 'b²', ref: 'paso 1', v: S(b * b), ...PLAIN });
        if (es3d) rows.push({ k: 'c²', ref: 'paso 1', v: S(c * c), ...PLAIN });
        rows.push({ k: es3d ? 'a² + b² + c²' : 'a² + b²', ref: 'paso 2: bajo la raíz', v: suma, ...PLAIN });
        rows.push({ k: 'Raíz cuadrada → la diagonal', ref: 'paso 3: el resultado', v: diag, extra: true, ...U });
        rows.push({ k: 'Esa diagonal en pulgadas', ref: 'si los lados están en cm: ÷ 2,54', v: S(diag / CM_POR_PULGADA), ...PULG });
        rows.push({ k: 'TV 16:9 máxima que entra (limita ' + limita + ')', ref: 'leyendo A y B como el hueco en cm', v: tvMax, extra: true, ...PULG });
        if (pulg > 0) {
          const diagCm = pulg * CM_POR_PULGADA;
          rows.push({ k: 'Diagonal de una TV de ' + fmt(pulg) + '"', ref: 'pulgadas × 2,54', v: S(diagCm), ...CM });
          rows.push({ k: 'Ancho del panel de esa TV', ref: 'diagonal × 16 ÷ √337', v: S((diagCm * 16) / RAIZ_337), ...CM });
          rows.push({ k: 'Alto del panel de esa TV', ref: 'diagonal × 9 ÷ √337', v: S((diagCm * 9) / RAIZ_337), ...CM });
        }
        return {
          total: fmt(diag) + ' u',
          sub:
            (es3d ? 'Diagonal interna de la caja ' + fmt(a) + ' × ' + fmt(b) + ' × ' + fmt(c) : 'Diagonal del rectángulo ' + fmt(a) + ' × ' + fmt(b)) +
            ': ' + fmt(diag) + ' · si son centímetros, en ese hueco entra como máximo una TV 16:9 de ' + fmt(tvMax) + '"',
          rows: rows,
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Ancho = ' + fmt(a), value: Math.abs(a), tone: 'prop' },
            { label: 'Alto = ' + fmt(b), value: Math.abs(b), tone: 'good' },
            { label: 'Diagonal = ' + fmt(diag), value: Math.abs(diag), tone: 'main' },
          ],
        };
      }

      // ---- 9) CONVERSIÓN de ángulo ----------------------------------------
      // 180° = π rad = 200 grad
      let grados, radianes, gradianes;
      if (uAng === 'radianes') {
        radianes = ang;
        grados = S(ang * R2D);
        gradianes = S((ang * 200) / Math.PI);
      } else if (uAng === 'gradianes') {
        gradianes = ang;
        grados = S((ang * 360) / 400);
        radianes = S((ang * Math.PI) / 200);
      } else {
        grados = ang;
        radianes = S(ang * D2R);
        gradianes = S((ang * 400) / 360);
      }
      const enPi = S(grados / 180);
      const vueltas = S(grados / 360);
      const absG = Math.abs(grados) % 360;
      const tipo =
        Math.abs(absG) < 1e-9 ? 'nulo o de vuelta completa'
        : Math.abs(absG - 90) < 1e-9 ? 'recto (90°)'
        : Math.abs(absG - 180) < 1e-9 ? 'llano (180°)'
        : absG < 90 ? 'agudo'
        : absG < 180 ? 'obtuso'
        : 'cóncavo (más de 180°)';
      return {
        total: fmt(grados) + '°',
        sub:
          fmt(ang) + ' ' + uAng + ' = ' + fmt(grados) + '° = ' + fmt(radianes) + ' rad = ' + fmt(gradianes) +
          ' grad · es un ángulo ' + tipo,
        rows: [
          { k: 'En grados sexagesimales', ref: 'la vuelta son 360', v: grados, extra: true, ...GRA4 },
          { k: 'En radianes', ref: 'grados × π ÷ 180', v: radianes, extra: true, ...RAD },
          { k: 'En gradianes (centesimales)', ref: 'la vuelta son 400', v: gradianes, extra: true, ...GON },
          { k: 'Expresado como múltiplo de π', ref: 'grados ÷ 180 · el coeficiente que acompaña a π', v: enPi, ...PLAIN4 },
          { k: 'Vueltas completas', ref: 'grados ÷ 360', v: vueltas, ...PLAIN4 },
          { k: 'Cuánto vale 1 radián en grados', ref: 'la constante 180 ÷ π', v: S(R2D), ...GRA4 },
          { k: 'Verificación: radianes × 180 ÷ π (tiene que volver a los grados)', ref: 'chequeo', v: S(radianes * R2D), ...GRA4 },
        ],
        format: 'plain',
        decimals: 4,
        chart: [
          { label: 'Grados = ' + fmt(grados), value: Math.abs(grados), tone: 'main' },
          { label: 'Gradianes = ' + fmt(gradianes), value: Math.abs(gradianes), tone: 'prop' },
          { label: 'Radianes = ' + fmt(radianes), value: Math.abs(radianes), tone: 'good' },
        ],
      };
    });
  })();
</script>
