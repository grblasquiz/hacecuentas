---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TriangulosExperience from '../../components/generated/TriangulosExperience.astro';
import { hub } from '../../lib/hubs/triangulos-y-trigonometria';
const canonical='https://hacecuentas.com/matematica/triangulos-y-trigonometria';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <TriangulosExperience />
  <Footer />
</Layout>
