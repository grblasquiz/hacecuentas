---
/**
 * Hub de decisión — "¿Cuál es la probabilidad?"
 * Reemplaza 11 URLs de calculadora suelta (ver hub.replaces); 9 tienen rama
 * propia y 2 se absorben sólo por URL.
 *
 * Arquetipo ramificado: la rama activa llega como segundo argumento de
 * compute() y decide qué campos se leen. La rama por defecto es el sorteo /
 * tirada de dado, que es la de más tráfico.
 *
 * La página sólo aporta datos (src/lib/hubs/probabilidad.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProbabilidadExperience from '../../components/generated/ProbabilidadExperience.astro';
import {
  hub,
  CANTIDAD_MAXIMA,
  RANGO_MAXIMO,
  N_MAXIMO,
  TIPOS_SORTEO,
  CONTEO_LABEL,
  ERF_A,
  ERF_P,
} from '../../lib/hubs/probabilidad';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ProbabilidadExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ CANTIDAD_MAXIMA, RANGO_MAXIMO, N_MAXIMO, TIPOS_SORTEO, CONTEO_LABEL, ERF_A, ERF_P }}
>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay pesos: TODAS las filas declaran su formato y su unidad.
    const PORC = { format: 'unit', unit: '%', decimals: 2 };
    const PORC4 = { format: 'unit', unit: '%', decimals: 4 };
    const INTENTOS = { format: 'unit', unit: 'intentos', decimals: 0 };
    const FORMAS = { format: 'unit', unit: 'formas', decimals: 0 };
    const VECES = { format: 'unit', unit: 'veces', decimals: 0 };
    const PLAIN = { format: 'plain', decimals: 0 };
    const PLAIN2 = { format: 'plain', decimals: 2 };
    const PLAIN4 = { format: 'plain', decimals: 4 };

    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    const dec = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    const vacio = (msg) => ({ total: '—', sub: msg, rows: [], chart: [] });

    /** Separador de miles es-AR sobre el string decimal de un BigInt. */
    function fmtBig(b) {
      const neg = b < 0n;
      const s = (neg ? -b : b).toString();
      return (neg ? '-' : '') + s.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    /** Porcentaje legible: usa notación científica cuando es diminuto. */
    function pct(p) {
      const v = p * 100;
      if (v > 0 && v < 0.0001) return v.toExponential(2) + '%';
      if (v < 1) return dec(v, 6) + '%';
      return dec(v, 2) + '%';
    }

    // ─────────────────────── RAMA: sorteo / tirar un dado ───────────────────────
    // Calcado de `aleatorio-numero-dado.ts` + `generador-numeros-aleatorios.ts`.
    // OJO: el resultado es ALEATORIO, cambia en cada click. Es lo esperado.
    function calcSorteo(v) {
      const tipo = String(v.tipoSorteo || 'dado6');
      const fijo = TIPOS_SORTEO[tipo];
      let min, max;
      if (fijo) {
        min = fijo.min;
        max = fijo.max;
      } else {
        min = Math.trunc(Number(v.minimo));
        max = Math.trunc(Number(v.maximo));
        if (!isFinite(min) || !isFinite(max)) return vacio('Ingresá un mínimo y un máximo válidos.');
        if (min >= max) return vacio('El mínimo tiene que ser menor que el máximo.');
        if (max - min > RANGO_MAXIMO) return vacio('El rango no puede superar el millón de valores.');
      }

      let cantidad = Math.trunc(Number(v.cantidad) || 1);
      if (cantidad < 1) return vacio('Pedí al menos un resultado.');
      if (cantidad > CANTIDAD_MAXIMA) return vacio('Podés sortear hasta ' + CANTIDAD_MAXIMA + ' números por vez.');

      const sinRepetir = String(v.sinRepetir || 'no') === 'si';
      const posibles = max - min + 1;
      if (sinRepetir && cantidad > posibles) {
        return vacio(
          'No se pueden sortear ' + cantidad + ' valores distintos entre ' + min + ' y ' + max +
            ': en ese rango hay ' + posibles + '. Ampliá el rango o permití repetidos.',
        );
      }

      const res = [];
      if (sinRepetir) {
        // Fisher–Yates parcial sobre el conjunto de valores posibles.
        const pool = [];
        for (let x = min; x <= max; x++) pool.push(x);
        for (let i = 0; i < cantidad; i++) {
          const j = i + Math.floor(Math.random() * (pool.length - i));
          const tmp = pool[i];
          pool[i] = pool[j];
          pool[j] = tmp;
          res.push(pool[i]);
        }
      } else {
        for (let i = 0; i < cantidad; i++) res.push(Math.floor(Math.random() * posibles) + min);
      }

      const esMoneda = tipo === 'moneda';
      const etiqueta = (x) => (esMoneda ? (x === 0 ? 'Cara' : 'Cruz') : String(x));
      const lista = res.map(etiqueta).join(', ');
      const suma = res.reduce((a, b) => a + b, 0);
      const promedio = suma / res.length;
      const esperado = (min + max) / 2;
      const pUno = 1 / posibles;
      const nombre = fijo ? fijo.label : 'rango ' + min + ' a ' + max;

      const rows = [
        row('Probabilidad de cada valor', pUno * 100, PORC4, true, '1 entre ' + dec(posibles, 0)),
        row('Valores posibles del rango', posibles, PLAIN, false, 'inclusive'),
        row('Resultados sorteados', cantidad, PLAIN, false, sinRepetir ? 'sin repetir' : 'con repetidos'),
      ];
      if (!esMoneda) {
        rows.push(row('Suma de los resultados', suma, PLAIN, false, 'de esta tanda'));
        rows.push(row('Promedio obtenido', promedio, PLAIN2, false, 'esta tanda'));
        rows.push(row('Promedio teórico del rango', esperado, PLAIN2, false, '(mín + máx) ÷ 2'));
        rows.push(row('Valor más alto sorteado', Math.max.apply(null, res), PLAIN, false, 'de esta tanda'));
        rows.push(row('Valor más bajo sorteado', Math.min.apply(null, res), PLAIN, false, 'de esta tanda'));
      } else {
        const caras = res.filter((x) => x === 0).length;
        rows.push(row('Cara', caras, VECES, false, 'de ' + cantidad));
        rows.push(row('Cruz', cantidad - caras, VECES, false, 'de ' + cantidad));
        rows.push(row('Proporción de caras', (caras / cantidad) * 100, PORC, false, 'teórico 50%'));
      }
      rows.push(row('Chance de repetir un valor puntual', pUno * 100, PORC4, false, 'en la próxima tirada'));

      // Gráfico: si hay pocos valores posibles y varias tiradas, frecuencia
      // observada por valor; si no, los propios números sorteados.
      let chart;
      let unidad = 'veces';
      if (posibles <= 20 && cantidad >= 2) {
        chart = [];
        for (let x = min; x <= max; x++) {
          chart.push({
            label: etiqueta(x),
            value: res.filter((y) => y === x).length,
            tone: 'main',
          });
        }
      } else {
        unidad = '';
        chart = res.slice(0, 20).map((x, i) => ({
          label: esMoneda ? etiqueta(x) : 'Nº ' + (i + 1),
          value: x,
          tone: 'main',
        }));
      }

      return {
        total: cantidad === 1 ? etiqueta(res[0]) : lista,
        sub:
          'Sorteo sobre ' + nombre + ': cada uno de los ' + dec(posibles, 0) +
          ' valores posibles tenía la misma chance (' + pct(pUno) + '). ' +
          (cantidad === 1 ? 'Volvé a apretar el botón para sortear de nuevo.' : cantidad + ' resultados' + (sinRepetir ? ' sin repetir' : '') + ' · apretá de nuevo para otra tanda.'),
        rows: rows,
        chart: chart,
        format: unidad ? 'unit' : 'plain',
        unit: unidad,
        decimals: 0,
      };
    }

    // ──────────────── RAMA: probabilidad de un evento (y al menos una vez) ────────────────
    // Calcado de `probabilidad-evento.ts` y `probabilidad-drop-loot.ts`.
    function calcEvento(v) {
      const directa = Number(v.probPct) || 0;
      const fav = Number(v.casosFavorables);
      const tot = Number(v.casosPosibles);
      const n = Math.trunc(Number(v.intentos) || 1);

      let p, origen;
      if (directa > 0) {
        if (directa > 100) return vacio('La probabilidad por intento no puede superar el 100%.');
        p = directa / 100;
        origen = 'probabilidad cargada directo';
      } else {
        if (!(tot > 0)) return vacio('Los casos posibles tienen que ser mayores a 0.');
        if (!(fav >= 0) || fav > tot) return vacio('Los casos favorables tienen que estar entre 0 y los casos posibles.');
        p = fav / tot;
        origen = dec(fav, 0) + ' de ' + dec(tot, 0);
      }
      if (n < 1) return vacio('Ingresá al menos 1 intento.');
      if (p <= 0) return vacio('Con probabilidad 0 el evento no puede ocurrir nunca.');

      const ninguna = Math.pow(1 - p, n);
      const alguna = 1 - ninguna;
      const unaEn = 1 / p;

      const rows = [
        row('Probabilidad en un solo intento', p * 100, PORC4, true, origen),
        row('Al menos una vez en ' + dec(n, 0) + ' intentos', alguna * 100, PORC, true, '1 − (1 − p)^n'),
        row('Que no ocurra ninguna vez', ninguna * 100, PORC, false, 'el complemento'),
        row('Es 1 entre', unaEn, PLAIN2, false, 'chance individual'),
        row('Veces que se espera que ocurra en ' + dec(n, 0) + ' intentos', n * p, PLAIN2, false, 'n × p'),
      ];
      if (p < 1) {
        const i50 = Math.ceil(Math.log(0.5) / Math.log(1 - p));
        const i90 = Math.ceil(Math.log(0.1) / Math.log(1 - p));
        const i99 = Math.ceil(Math.log(0.01) / Math.log(1 - p));
        rows.push(row('Intentos para llegar al 50%', i50, INTENTOS, false, 'la mediana'));
        rows.push(row('Intentos para llegar al 90%', i90, INTENTOS, false, 'sería raro fallar'));
        rows.push(row('Intentos para llegar al 99%', i99, INTENTOS, false, 'nunca es 100%'));
      } else {
        rows.push(row('Intentos para llegar al 50%', 1, INTENTOS, false, 'evento seguro'));
      }

      return {
        total: pct(alguna),
        sub:
          'Con ' + pct(p) + ' por intento, en ' + dec(n, 0) + ' intentos independientes tenés ' +
          pct(alguna) + ' de chance de que ocurra al menos una vez, y ' + pct(ninguna) +
          ' de que no ocurra nunca. Cada intento nuevo sigue arrancando en ' + pct(p) + '.',
        rows: rows,
        chart: [
          { label: 'Ocurre al menos una vez', value: Number((alguna * 100).toFixed(2)), tone: 'good' },
          { label: 'No ocurre nunca', value: Number((ninguna * 100).toFixed(2)), tone: 'warn' },
        ],
        format: 'unit',
        unit: '%',
        decimals: 2,
      };
    }

    // ─────────────────────── RAMA: combinatoria ───────────────────────
    // Calcado de `combinatoria-permutaciones.ts` (BigInt exacto) + `factorial-numero-n.ts`.
    function combBig(n, r) {
      if (r < 0 || r > n) return 0n;
      r = Math.min(r, n - r);
      let num = 1n;
      let den = 1n;
      for (let k = 0; k < r; k++) {
        num *= BigInt(n - k);
        den *= BigInt(k + 1);
      }
      return num / den;
    }

    function permBig(n, r) {
      if (r < 0 || r > n) return 0n;
      let p = 1n;
      for (let k = 0; k < r; k++) p *= BigInt(n - k);
      return p;
    }

    function factBig(n) {
      let f = 1n;
      for (let k = 2; k <= n; k++) f *= BigInt(k);
      return f;
    }

    function calcCombinatoria(v) {
      const n = Math.floor(Number(v.n));
      const r = Math.floor(Number(v.r));
      const tipo = String(v.tipoConteo || 'combinacion');

      if (!isFinite(n) || n < 0) return vacio('Ingresá un valor válido para n (0 o más).');
      if (!isFinite(r) || r < 0) return vacio('Ingresá un valor válido para r (0 o más).');
      if (n > N_MAXIMO) return vacio('n no puede ser mayor a ' + N_MAXIMO + ': el factorial desborda.');

      let big, formula, ordena, repite;
      if (tipo === 'factorial') {
        big = factBig(n);
        formula = n + '!';
        ordena = true;
        repite = false;
      } else if (tipo === 'permutacion-repeticion') {
        const digitos = r * Math.log10(Math.max(n, 1));
        if (digitos > 1000) return vacio('El resultado supera el límite de dígitos de esta calculadora.');
        big = BigInt(n) ** BigInt(r);
        formula = n + '^' + r;
        ordena = true;
        repite = true;
      } else if (tipo === 'combinacion-repeticion') {
        if (n < 1) return vacio('En combinación con repetición n tiene que ser al menos 1.');
        big = combBig(n + r - 1, r);
        formula = 'CR(' + n + ',' + r + ') = C(' + (n + r - 1) + ',' + r + ')';
        ordena = false;
        repite = true;
      } else if (tipo === 'permutacion') {
        if (r > n) return vacio('En permutaciones sin repetición r no puede ser mayor que n.');
        big = permBig(n, r);
        formula = 'P(' + n + ',' + r + ') = ' + n + '! / ' + (n - r) + '!';
        ordena = true;
        repite = false;
      } else {
        if (r > n) return vacio('En combinaciones sin repetición r no puede ser mayor que n.');
        big = combBig(n, r);
        formula = 'C(' + n + ',' + r + ') = ' + n + '! / (' + r + '! × ' + (n - r) + '!)';
        ordena = false;
        repite = false;
      }

      const exacto = fmtBig(big);
      const num = Number(big);
      const aprox = num > Number.MAX_SAFE_INTEGER;
      const probUna = num > 0 ? 1 / num : 0;
      const nombre = CONTEO_LABEL[tipo] || 'conteo';

      const rows = [
        row('Formas posibles', num, FORMAS, true, aprox ? 'aproximado — el exacto está arriba' : formula),
        row('Probabilidad de acertar una al azar', probUna * 100, PORC4, true, '1 entre ' + exacto),
        row('n — elementos disponibles', n, PLAIN, false, 'el conjunto'),
        row('r — elementos que elegís', tipo === 'factorial' ? n : r, PLAIN, false, tipo === 'factorial' ? 'todos' : 'la muestra'),
        row('Cantidad de dígitos del resultado', exacto.replace(/\./g, '').length, PLAIN, false, 'escala'),
      ];
      if (tipo === 'combinacion' && r <= n) {
        rows.push(row('La permutación equivalente daría', Number(permBig(n, r)), FORMAS, false, 'r! veces más'));
        rows.push(row('Factor entre permutación y combinación', Number(factBig(r)), PLAIN, false, r + '!'));
      }
      if (tipo === 'permutacion' && r <= n) {
        rows.push(row('La combinación equivalente daría', Number(combBig(n, r)), FORMAS, false, 'r! veces menos'));
      }

      return {
        total: exacto,
        sub:
          nombre + ': hay ' + exacto + ' formas distintas de ' + (ordena ? 'ordenar' : 'elegir') + ' ' +
          (tipo === 'factorial' ? n : r) + ' elemento' + ((tipo === 'factorial' ? n : r) === 1 ? '' : 's') + ' ' +
          (repite ? 'pudiendo repetir' : 'sin repetir') + ' de un conjunto de ' + n + '. ' +
          (ordena ? 'Como el orden importa, cambiar la secuencia cuenta como un caso nuevo.' : 'Como el orden no importa, sólo cuenta qué elementos entran.') +
          ' Una jugada al azar acierta con ' + pct(probUna) + '.',
        rows: rows,
        chart: [
          { label: ordena ? 'Ordenaciones posibles' : 'Combinaciones posibles', value: num, tone: 'main' },
          { label: 'La jugada que elegís vos', value: 1, tone: 'good' },
        ],
        format: 'plain',
        decimals: 0,
      };
    }

    // ─────────────────────── RAMA: binomial ───────────────────────
    // Calcado de `probabilidad-binomial.ts` (PMF en escala logarítmica).
    function logComb(n, k) {
      if (k > n) return -Infinity;
      if (k === 0 || k === n) return 0;
      if (k > n - k) k = n - k;
      let res = 0;
      for (let i = 0; i < k; i++) res += Math.log(n - i) - Math.log(i + 1);
      return res;
    }

    function binomPmf(n, k, p) {
      if (k > n || k < 0) return 0;
      if (p === 0) return k === 0 ? 1 : 0;
      if (p === 1) return k === n ? 1 : 0;
      return Math.exp(logComb(n, k) + k * Math.log(p) + (n - k) * Math.log(1 - p));
    }

    function calcBinomial(v) {
      const n = Math.round(Number(v.ensayos));
      const k = Math.round(Number(v.exitos));
      const p = Number(v.pExito) / 100;

      if (!isFinite(n) || n < 1) return vacio('n tiene que ser al menos 1.');
      if (!isFinite(k) || k < 0 || k > n) return vacio('k tiene que estar entre 0 y n.');
      if (!isFinite(p) || p < 0 || p > 1) return vacio('La probabilidad de éxito tiene que estar entre 0% y 100%.');

      const prob = binomPmf(n, k, p);
      let acum = 0;
      for (let j = 0; j <= k; j++) acum += binomPmf(n, j, p);
      const alMenosK = 1 - acum + prob;
      const mu = n * p;
      const sigma = Math.sqrt(n * p * (1 - p));

      const rows = [
        row('Probabilidad de exactamente ' + dec(k, 0) + ' éxitos', prob * 100, PORC4, true, 'C(n,k)·p^k·(1−p)^(n−k)'),
        row('Probabilidad de ' + dec(k, 0) + ' o menos', acum * 100, PORC4, true, 'acumulada'),
        row('Probabilidad de ' + dec(k, 0) + ' o más', alMenosK * 100, PORC4, false, 'la otra cola'),
        row('Probabilidad de más de ' + dec(k, 0), (1 - acum) * 100, PORC4, false, 'estrictamente mayor'),
        row('Éxitos esperados en promedio', mu, PLAIN2, false, 'n × p'),
        row('Desvío estándar', sigma, PLAIN2, false, '√(n·p·(1−p))'),
        row('Ensayos cargados', n, PLAIN, false, 'independientes'),
        row('Probabilidad por ensayo', p * 100, PORC, false, 'constante'),
      ];

      return {
        total: pct(prob),
        sub:
          'Con ' + dec(n, 0) + ' ensayos al ' + dec(p * 100, 2) + '% cada uno, sacar exactamente ' +
          dec(k, 0) + ' éxitos tiene ' + pct(prob) + ' de probabilidad, y ' + dec(k, 0) + ' o menos acumula ' +
          pct(acum) + '. Lo más esperable ronda los ' + dec(mu, 1) + ' éxitos (± ' + dec(sigma, 1) + ').',
        rows: rows,
        chart: [
          { label: 'Exactamente ' + dec(k, 0), value: Number((prob * 100).toFixed(4)), tone: 'main' },
          { label: 'Menos de ' + dec(k, 0), value: Number(((acum - prob) * 100).toFixed(4)), tone: 'prop' },
          { label: 'Más de ' + dec(k, 0), value: Number(((1 - acum) * 100).toFixed(4)), tone: 'warn' },
        ],
        format: 'unit',
        unit: '%',
        decimals: 2,
      };
    }

    // ─────────────────────── RAMA: distribución normal ───────────────────────
    // Calcado de `distribucion-normal-area.ts` (Abramowitz & Stegun 7.1.26).
    function normalCDF(z) {
      if (z < -8) return 0;
      if (z > 8) return 1;
      const sign = z < 0 ? -1 : 1;
      const x = Math.abs(z) / Math.sqrt(2);
      const t = 1 / (1 + ERF_P * x);
      const y =
        1 -
        (((((ERF_A[4] * t + ERF_A[3]) * t + ERF_A[2]) * t + ERF_A[1]) * t + ERF_A[0]) * t) *
          Math.exp(-x * x);
      return 0.5 * (1 + sign * y);
    }

    function calcNormal(v) {
      const mu = Number(v.media);
      const sigma = Number(v.desvio);
      const a = Number(v.limiteA);
      const b = Number(v.limiteB);

      if (!isFinite(mu)) return vacio('Ingresá la media (μ).');
      if (!isFinite(sigma) || sigma <= 0) return vacio('El desvío estándar (σ) tiene que ser mayor a 0.');
      if (!isFinite(a) || !isFinite(b)) return vacio('Ingresá los dos límites del intervalo.');
      if (a >= b) return vacio('El límite inferior tiene que ser menor que el superior.');

      const zA = (a - mu) / sigma;
      const zB = (b - mu) / sigma;
      const pA = normalCDF(zA);
      const pB = normalCDF(zB);
      const dentro = pB - pA;
      const abajo = pA;
      const arriba = 1 - pB;
      const anchoSigmas = (b - a) / sigma;

      const rows = [
        row('Probabilidad dentro del intervalo', dentro * 100, PORC4, true, 'Φ(z_b) − Φ(z_a)'),
        row('Por debajo del límite inferior', abajo * 100, PORC4, false, 'cola izquierda'),
        row('Por encima del límite superior', arriba * 100, PORC4, false, 'cola derecha'),
        row('z del límite inferior', zA, PLAIN4, false, '(a − μ) ÷ σ'),
        row('z del límite superior', zB, PLAIN4, false, '(b − μ) ÷ σ'),
        row('Ancho del intervalo en desvíos', anchoSigmas, PLAIN2, false, 'σ que abarca'),
        row('Media (μ)', mu, PLAIN2, false, 'centro de la campana'),
        row('Desvío estándar (σ)', sigma, PLAIN2, false, 'dispersión'),
        row('De cada 1.000 casos, caen dentro', dentro * 1000, PLAIN, false, 'traducción práctica'),
      ];

      return {
        total: dec(dentro * 100, 2) + '%',
        sub:
          'El ' + dec(dentro * 100, 2) + '% del área bajo la curva cae entre ' + dec(a, 2) + ' y ' +
          dec(b, 2) + ' (z de ' + dec(zA, 2) + ' a ' + dec(zB, 2) + '). El resto se reparte en las colas: ' +
          dec(abajo * 100, 2) + '% por debajo y ' + dec(arriba * 100, 2) + '% por encima.',
        rows: rows,
        chart: [
          { label: 'Por debajo de ' + dec(a, 2), value: Number((abajo * 100).toFixed(2)), tone: 'warn' },
          { label: 'Dentro del intervalo', value: Number((dentro * 100).toFixed(2)), tone: 'main' },
          { label: 'Por encima de ' + dec(b, 2), value: Number((arriba * 100).toFixed(2)), tone: 'warn' },
        ],
        format: 'unit',
        unit: '%',
        decimals: 2,
      };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'sorteo';
      if (id === 'evento') return calcEvento(v);
      if (id === 'combinatoria') return calcCombinatoria(v);
      if (id === 'binomial') return calcBinomial(v);
      if (id === 'normal') return calcNormal(v);
      return calcSorteo(v);
    });
  })();
</script>
