---
/**
 * Hub de decisión — "¿Cuál es la probabilidad?"
 * Reemplaza 11 URLs de calculadora suelta (ver hub.replaces); 9 tienen rama
 * propia y 2 se absorben sólo por URL.
 *
 * Arquetipo ramificado: la rama activa llega como segundo argumento de
 * compute() y decide qué campos se leen. La rama por defecto es el sorteo /
 * tirada de dado, que es la de más tráfico.
 *
 * La página sólo aporta datos (src/lib/hubs/probabilidad.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import ProbabilidadExperience from '../../components/generated/ProbabilidadExperience.astro';
import {
  hub,
  CANTIDAD_MAXIMA,
  RANGO_MAXIMO,
  N_MAXIMO,
  TIPOS_SORTEO,
  CONTEO_LABEL,
  ERF_A,
  ERF_P,
} from '../../lib/hubs/probabilidad';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ProbabilidadExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

