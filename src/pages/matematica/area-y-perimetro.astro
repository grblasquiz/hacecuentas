---
/**
 * Hub de decisión — "¿Cuál es el área y el perímetro de esta figura?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de matematica/regla-de-tres.astro: la página sólo aporta los
 * datos (src/lib/hubs/area-y-perimetro.ts) y su compute(). El chrome, el CSS y
 * el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/area-y-perimetro';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * Acá no hay plata en ninguna rama y el default de HubRow es 'ars'. Toda
     * fila declara su formato: 'plain' para cantidades adimensionales y 'unit'
     * para longitudes (u), superficies (u²), grados y cantidad de lados.
     */
    const U = { format: 'unit', unit: 'u', decimals: 2 };
    const U2 = { format: 'unit', unit: 'u²', decimals: 2 };
    const GRA = { format: 'unit', unit: '°', decimals: 2 };
    const LADOS = { format: 'unit', unit: 'lados', decimals: 0 };
    const PLAIN = { format: 'plain', decimals: 2 };
    const PLAIN4 = { format: 'plain', decimals: 4 };

    /**
     * Redondeo anti ruido de punto flotante: si el número quedó a menos de
     * 1e-10 de un entero, es ese entero. Sin esto, Herón sobre 3-4-5 devuelve
     * 5,999999999999999 y el polígono de 4 lados da apotemas con basura.
     */
    const S = (n) => (isFinite(n) && Math.abs(n - Math.round(n)) < 1e-10 ? Math.round(n) : n);

    const fmt = (n) => {
      if (!isFinite(n)) return '—';
      const abs = Math.abs(n);
      const dec = abs >= 1000 ? 0 : abs >= 1 ? 2 : 4;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };

    const err = (msg, k, v) => ({
      total: '—',
      sub: msg,
      rows: [{ k: k, v: v, ...PLAIN }],
      chart: [],
      format: 'plain',
      decimals: 2,
    });

    const dist = (x1, y1, x2, y2) => Math.sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));

    H.onCompute(function (v, kase) {
      const a = H.num(v.a);
      const b = H.num(v.b);
      const c = H.num(v.c);
      const d = H.num(v.d);
      const e = H.num(v.e);
      const nIn = H.num(v.n);
      const ang = H.num(v.ang);
      const x1 = H.num(v.x1), y1 = H.num(v.y1);
      const x2 = H.num(v.x2), y2 = H.num(v.y2);
      const x3 = H.num(v.x3), y3 = H.num(v.y3);
      const id = (kase && kase.id) || 'circulo';

      // ---- 1) CÍRCULO por el radio -------------------------------------
      // A = π·r²  ·  P = 2·π·r
      if (id === 'circulo') {
        const r = a;
        if (r <= 0) return err('El radio tiene que ser mayor que cero (campo A).', 'Radio', 0);
        const area = S(Math.PI * r * r);
        const per = S(2 * Math.PI * r);
        return {
          total: fmt(area) + ' u²',
          sub:
            'Círculo de radio ' + fmt(r) + ': área ' + fmt(area) + ' u² y perímetro ' + fmt(per) +
            ' u · A = π·r², P = 2·π·r',
          rows: [
            { k: 'Radio (campo A)', v: r, ...U },
            { k: 'Diámetro = 2 × r', ref: 'dato derivado', v: S(2 * r), ...U },
            { k: 'r² — el radio al cuadrado', ref: 'paso 1', v: S(r * r), ...PLAIN },
            { k: 'π × r² → área', ref: 'paso 2: el área', v: area, extra: true, ...U2 },
            { k: '2 × π × r → perímetro', ref: 'la circunferencia', v: per, extra: true, ...U },
            { k: 'Verificación: área ÷ perímetro (tiene que dar r ÷ 2)', ref: 'chequeo', v: per ? area / per : 0, ...PLAIN4 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Área (u²) = ' + fmt(area), value: Math.abs(area), tone: 'main' },
            { label: 'Perímetro (u) = ' + fmt(per), value: Math.abs(per), tone: 'prop' },
            { label: 'Diámetro (u) = ' + fmt(2 * r), value: Math.abs(2 * r), tone: 'good' },
          ],
        };
      }

      // ---- 2) SECTOR CIRCULAR ------------------------------------------
      // f = ángulo/360 · A = π·r²·f · arco = 2·π·r·f
      if (id === 'sector') {
        const r = a;
        if (r <= 0) return err('El radio tiene que ser mayor que cero (campo A).', 'Radio', 0);
        if (ang <= 0 || ang > 360) return err('El ángulo del sector va entre 0 y 360 grados.', 'Ángulo cargado', ang);
        const areaTotal = S(Math.PI * r * r);
        const perTotal = S(2 * Math.PI * r);
        const f = ang / 360;
        const areaSector = S(areaTotal * f);
        const arco = S(perTotal * f);
        const perSector = S(arco + 2 * r);
        return {
          total: fmt(areaSector) + ' u²',
          sub:
            'El sector de ' + fmt(ang) + '° se lleva el ' + fmt(f * 100) + '% del disco: área ' +
            fmt(areaSector) + ' u² y arco ' + fmt(arco) + ' u',
          rows: [
            { k: 'Radio (campo A)', v: r, ...U },
            { k: 'Ángulo del sector', ref: 'en grados', v: ang, ...GRA },
            { k: 'Fracción del disco = ángulo ÷ 360', ref: 'paso 1', v: f, ...PLAIN4 },
            { k: 'Área del círculo completo (π·r²)', ref: 'paso 2', v: areaTotal, ...U2 },
            { k: 'Área del sector = área × fracción', ref: 'paso 3: el resultado', v: areaSector, extra: true, ...U2 },
            { k: 'Perímetro del círculo completo (2·π·r)', ref: 'paso 4', v: perTotal, ...U },
            { k: 'Longitud del arco = perímetro × fracción', ref: 'paso 5', v: arco, extra: true, ...U },
            { k: 'Perímetro del sector = arco + 2 radios', ref: 'el contorno cerrado', v: perSector, ...U },
            { k: 'Resto del disco (lo que queda afuera)', ref: 'chequeo: sector + resto = total', v: S(areaTotal - areaSector), ...U2 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Sector de ' + fmt(ang) + '°', value: Math.abs(areaSector), tone: 'main' },
            { label: 'Resto del círculo', value: Math.max(0, areaTotal - areaSector), tone: 'prop' },
          ],
        };
      }

      // ---- 3) TRIÁNGULO por tres lados (Herón) --------------------------
      // s = (a+b+c)/2 · A = √(s(s−a)(s−b)(s−c))
      if (id === 'heron') {
        if (a <= 0 || b <= 0 || c <= 0) return err('Los tres lados tienen que ser mayores que cero (campos A, B y C).', 'Lado más chico', Math.min(a, b, c));
        if (a + b <= c || a + c <= b || b + c <= a) {
          return err(
            'Esos lados no cumplen la desigualdad triangular: cada lado tiene que ser menor que la suma de los otros dos. No forman triángulo.',
            'Perímetro cargado', a + b + c
          );
        }
        const per = S(a + b + c);
        const s = S(per / 2);
        const prod = s * (s - a) * (s - b) * (s - c);
        const area = S(Math.sqrt(Math.max(0, prod)));
        return {
          total: fmt(area) + ' u²',
          sub:
            'Triángulo de lados ' + fmt(a) + ', ' + fmt(b) + ' y ' + fmt(c) + ': semiperímetro ' +
            fmt(s) + ' y área ' + fmt(area) + ' u² · A = √(s(s−a)(s−b)(s−c))',
          rows: [
            { k: 'Lado a', v: a, ...U },
            { k: 'Lado b', v: b, ...U },
            { k: 'Lado c', v: c, ...U },
            { k: 'Perímetro = a + b + c', ref: 'paso 1', v: per, extra: true, ...U },
            { k: 'Semiperímetro s = perímetro ÷ 2', ref: 'paso 2', v: s, ...U },
            { k: 's − a', ref: 'paso 3: los tres factores', v: S(s - a), ...U },
            { k: 's − b', ref: 'paso 3', v: S(s - b), ...U },
            { k: 's − c', ref: 'paso 3', v: S(s - c), ...U },
            { k: 's × (s−a) × (s−b) × (s−c)', ref: 'paso 4: lo que va bajo la raíz', v: S(prod), ...PLAIN },
            { k: 'Raíz cuadrada → área', ref: 'paso 5: el resultado', v: area, extra: true, ...U2 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Área = ' + fmt(area), value: Math.abs(area), tone: 'main' },
            { label: 'Perímetro = ' + fmt(per), value: Math.abs(per), tone: 'prop' },
            { label: 'Semiperímetro = ' + fmt(s), value: Math.abs(s), tone: 'good' },
          ],
        };
      }

      // ---- 4) TRIÁNGULO por coordenadas (shoelace) ----------------------
      // A = ½·|x₁(y₂−y₃) + x₂(y₃−y₁) + x₃(y₁−y₂)|
      if (id === 'coordenadas') {
        const det = x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2);
        const area = S(Math.abs(det) / 2);
        if (area === 0) {
          return err('Los tres puntos son colineales: están sobre la misma recta y no forman triángulo.', 'Determinante', 0);
        }
        const ab = S(dist(x1, y1, x2, y2));
        const bc = S(dist(x2, y2, x3, y3));
        const ca = S(dist(x3, y3, x1, y1));
        const per = S(ab + bc + ca);
        const lados = [Number(ab.toFixed(6)), Number(bc.toFixed(6)), Number(ca.toFixed(6))];
        let tipo = 'escaleno';
        if (lados[0] === lados[1] && lados[1] === lados[2]) tipo = 'equilátero';
        else if (lados[0] === lados[1] || lados[1] === lados[2] || lados[0] === lados[2]) tipo = 'isósceles';
        return {
          total: fmt(area) + ' u²',
          sub:
            'A(' + fmt(x1) + ', ' + fmt(y1) + '), B(' + fmt(x2) + ', ' + fmt(y2) + '), C(' + fmt(x3) + ', ' + fmt(y3) +
            '): área ' + fmt(area) + ' u², perímetro ' + fmt(per) + ' u, triángulo ' + tipo,
          rows: [
            { k: 'x₁(y₂ − y₃)', ref: 'paso 1: el determinante, término 1', v: S(x1 * (y2 - y3)), ...PLAIN },
            { k: 'x₂(y₃ − y₁)', ref: 'paso 1: término 2', v: S(x2 * (y3 - y1)), ...PLAIN },
            { k: 'x₃(y₁ − y₂)', ref: 'paso 1: término 3', v: S(x3 * (y1 - y2)), ...PLAIN },
            { k: 'Suma de los tres términos', ref: 'paso 2: el determinante', v: S(det), ...PLAIN },
            { k: 'Valor absoluto ÷ 2 → área', ref: 'paso 3: el resultado', v: area, extra: true, ...U2 },
            { k: 'Lado AB = √(Δx² + Δy²)', ref: 'distancia entre puntos', v: ab, ...U },
            { k: 'Lado BC', ref: 'distancia entre puntos', v: bc, ...U },
            { k: 'Lado CA', ref: 'distancia entre puntos', v: ca, ...U },
            { k: 'Perímetro = AB + BC + CA', ref: 'la suma de los tres lados', v: per, extra: true, ...U },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Lado AB = ' + fmt(ab), value: Math.abs(ab), tone: 'prop' },
            { label: 'Lado BC = ' + fmt(bc), value: Math.abs(bc), tone: 'prop' },
            { label: 'Lado CA = ' + fmt(ca), value: Math.abs(ca), tone: 'prop' },
            { label: 'Área = ' + fmt(area), value: Math.abs(area), tone: 'main' },
          ],
        };
      }

      // ---- 5) TRAPECIO --------------------------------------------------
      // mediana = (B+b)/2 · A = mediana·h · P = B+b+l1+l2
      if (id === 'trapecio') {
        const B = a, bMenor = b, h = c;
        if (B <= 0 || bMenor <= 0) return err('Cargá las dos bases del trapecio (campos A y B), mayores que cero.', 'Base mayor', B);
        if (h <= 0) return err('Cargá la altura del trapecio en el campo C (la distancia perpendicular entre las bases).', 'Altura', h);
        const mediana = S((B + bMenor) / 2);
        const area = S(mediana * h);
        const tienePer = d > 0 && e > 0;
        const per = tienePer ? S(B + bMenor + d + e) : 0;
        const rows = [
          { k: 'Base mayor (campo A)', v: B, ...U },
          { k: 'Base menor (campo B)', v: bMenor, ...U },
          { k: 'Altura (campo C)', ref: 'perpendicular entre las bases', v: h, ...U },
          { k: 'Mediana = (B + b) ÷ 2', ref: 'paso 1: el promedio de las bases', v: mediana, ...U },
          { k: 'Mediana × altura → área', ref: 'paso 2: el resultado', v: area, extra: true, ...U2 },
        ];
        if (tienePer) {
          rows.push({ k: 'Lado no paralelo 1 (campo D)', v: d, ...U });
          rows.push({ k: 'Lado no paralelo 2 (campo E)', v: e, ...U });
          rows.push({ k: 'Perímetro = B + b + lado1 + lado2', ref: 'la suma de los cuatro lados', v: per, extra: true, ...U });
        }
        return {
          total: fmt(area) + ' u²',
          sub:
            'Trapecio de bases ' + fmt(B) + ' y ' + fmt(bMenor) + ' con altura ' + fmt(h) + ': mediana ' +
            fmt(mediana) + ' y área ' + fmt(area) + ' u²' +
            (tienePer ? ' · perímetro ' + fmt(per) + ' u' : ' · cargá los dos lados no paralelos (D y E) para el perímetro'),
          rows: rows,
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Área = ' + fmt(area), value: Math.abs(area), tone: 'main' },
            { label: 'Mediana = ' + fmt(mediana), value: Math.abs(mediana), tone: 'good' },
            { label: tienePer ? 'Perímetro = ' + fmt(per) : 'Suma de las bases', value: tienePer ? Math.abs(per) : Math.abs(B + bMenor), tone: 'prop' },
          ],
        };
      }

      // ---- 6) ROMBO por diagonales --------------------------------------
      // A = (D·d)/2 · lado = √((D/2)² + (d/2)²) · P = 4·lado
      if (id === 'rombo') {
        const D = a, dMenor = b;
        if (D <= 0 || dMenor <= 0) return err('Cargá las dos diagonales del rombo (campos A y B), mayores que cero.', 'Diagonal mayor', D);
        const area = S((D * dMenor) / 2);
        const semiD = S(D / 2);
        const semid = S(dMenor / 2);
        const lado = S(Math.sqrt(semiD * semiD + semid * semid));
        const per = S(4 * lado);
        return {
          total: fmt(area) + ' u²',
          sub:
            'Rombo de diagonales ' + fmt(D) + ' y ' + fmt(dMenor) + ': área ' + fmt(area) + ' u², lado ' +
            fmt(lado) + ' u y perímetro ' + fmt(per) + ' u',
          rows: [
            { k: 'Diagonal mayor D (campo A)', v: D, ...U },
            { k: 'Diagonal menor d (campo B)', v: dMenor, ...U },
            { k: 'D × d', ref: 'paso 1', v: S(D * dMenor), ...PLAIN },
            { k: 'Dividido 2 → área', ref: 'paso 2: el resultado', v: area, extra: true, ...U2 },
            { k: 'Semidiagonal D ÷ 2', ref: 'paso 3: primer cateto', v: semiD, ...U },
            { k: 'Semidiagonal d ÷ 2', ref: 'paso 3: segundo cateto', v: semid, ...U },
            { k: 'Lado = √((D/2)² + (d/2)²)', ref: 'paso 4: Pitágoras', v: lado, extra: true, ...U },
            { k: 'Perímetro = 4 × lado', ref: 'los cuatro lados son iguales', v: per, extra: true, ...U },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Área = ' + fmt(area), value: Math.abs(area), tone: 'main' },
            { label: 'Perímetro = ' + fmt(per), value: Math.abs(per), tone: 'prop' },
            { label: 'Lado = ' + fmt(lado), value: Math.abs(lado), tone: 'good' },
          ],
        };
      }

      // ---- 7) POLÍGONO REGULAR ------------------------------------------
      // ap = L / (2·tan(π/n)) · P = n·L · A = P·ap/2
      const n = Math.round(nIn);
      const L = a;
      if (!(n >= 3)) return err('Un polígono regular necesita 3 lados o más (campo "cantidad de lados").', 'Lados cargados', n);
      if (L <= 0) return err('Cargá la longitud del lado en el campo A (mayor que cero).', 'Longitud del lado', L);
      const apo = S(L / (2 * Math.tan(Math.PI / n)));
      const perP = S(n * L);
      const areaP = S((perP * apo) / 2);
      const angInt = S(((n - 2) * 180) / n);
      const sumaAng = S((n - 2) * 180);
      return {
        total: fmt(areaP) + ' u²',
        sub:
          'Polígono regular de ' + n + ' lados de ' + fmt(L) + ': apotema ' + fmt(apo) + ', perímetro ' +
          fmt(perP) + ' y área ' + fmt(areaP) + ' u² · cada ángulo interior mide ' + fmt(angInt) + '°',
        rows: [
          { k: 'Cantidad de lados (n)', v: n, ...LADOS },
          { k: 'Longitud de cada lado (campo A)', v: L, ...U },
          { k: 'Ángulo central = 180° ÷ n', ref: 'paso 1: el medio ángulo del triángulo central', v: S(180 / n), ...GRA },
          { k: 'Apotema = L ÷ (2 · tan(180°/n))', ref: 'paso 2: del centro al medio del lado', v: apo, extra: true, ...U },
          { k: 'Perímetro = n × L', ref: 'paso 3', v: perP, extra: true, ...U },
          { k: 'Área = perímetro × apotema ÷ 2', ref: 'paso 4: el resultado', v: areaP, extra: true, ...U2 },
          { k: 'Ángulo interior de cada vértice', ref: '(n − 2) · 180 ÷ n', v: angInt, ...GRA },
          { k: 'Suma de los ángulos interiores', ref: '(n − 2) · 180', v: sumaAng, ...GRA },
        ],
        format: 'plain',
        decimals: 2,
        chart: [
          { label: 'Área = ' + fmt(areaP), value: Math.abs(areaP), tone: 'main' },
          { label: 'Perímetro = ' + fmt(perP), value: Math.abs(perP), tone: 'prop' },
          { label: 'Apotema = ' + fmt(apo), value: Math.abs(apo), tone: 'good' },
        ],
      };
    });
  })();
</script>
