---
/**
 * Hub de decisión — "¿Cómo derivo esta función?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de matematica/regla-de-tres.astro: la página sólo aporta
 * los datos (src/lib/hubs/derivadas.ts) y su compute(). El chrome, el CSS y
 * el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/derivadas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /* ------------------------------------------------------------------
       Mini-CAS vanilla: parser + derivada simbólica + primitiva + evaluación.
       Las fórmulas viejas usaban mathjs, que no se puede importar dentro de
       un <script is:inline>. Este motor se verificó término a término contra
       mathjs y contra las fórmulas originales antes de publicarse.
       ------------------------------------------------------------------ */
    function MK() {
      const N = (v) => ({ t: 'n', v: v });
      const V = (n) => ({ t: 'v', n: n });
      const OP = (o, a, b) => ({ t: 'o', o: o, a: a, b: b });
      const FN = (f, a) => ({ t: 'f', f: f, a: a });

      const FNS = {
        sin: Math.sin, cos: Math.cos, tan: Math.tan,
        exp: Math.exp, ln: Math.log, log: Math.log, sqrt: Math.sqrt,
        abs: Math.abs, asin: Math.asin, acos: Math.acos, atan: Math.atan,
        sinh: Math.sinh, cosh: Math.cosh, tanh: Math.tanh,
      };

      /* ---------- tokenizer ---------- */
      function tok(src) {
        const s = String(src == null ? '' : src)
          .replace(/−/g, '-').replace(/[·×]/g, '*').replace(/÷/g, '/')
          .replace(/,/g, '.').replace(/\s+/g, '');
        const out = [];
        let i = 0;
        while (i < s.length) {
          const c = s[i];
          if (/[0-9.]/.test(c)) {
            let j = i;
            while (j < s.length && /[0-9.]/.test(s[j])) j++;
            out.push({ k: 'n', v: Number(s.slice(i, j)) });
            i = j;
          } else if (/[a-zA-Z_]/.test(c)) {
            let j = i;
            while (j < s.length && /[a-zA-Z_0-9]/.test(s[j])) j++;
            let id = s.slice(i, j);
            // "3xy" viene como un solo identificador "xy": lo partimos en variables
            if (!FNS[id] && id !== 'pi' && id !== 'e' && id.length > 1 && /^[xyz]+$/.test(id)) {
              for (let k = 0; k < id.length; k++) out.push({ k: 'id', v: id[k] });
              i = j; continue;
            }
            out.push({ k: 'id', v: id });
            i = j;
          } else if ('+-*/^()'.indexOf(c) >= 0) {
            out.push({ k: c });
            i++;
          } else {
            throw new Error('Caracter no reconocido: "' + c + '"');
          }
        }
        return out;
      }

      /* ---------- parser ---------- */
      function parse(src) {
        const ts = tok(src);
        let p = 0;
        const peek = () => ts[p];
        const eat = (k) => { if (ts[p] && ts[p].k === k) { p++; return true; } return false; };

        function atom() {
          const t = ts[p];
          if (!t) throw new Error('Expresión incompleta');
          if (t.k === 'n') { p++; return N(t.v); }
          if (t.k === 'id') {
            p++;
            if (FNS[t.v]) {
              if (!eat('(')) throw new Error('Falta "(" después de ' + t.v);
              const a = expr();
              if (!eat(')')) throw new Error('Falta ")" en ' + t.v);
              return FN(t.v === 'log' ? 'ln' : t.v, a);
            }
            if (t.v === 'pi') return N(Math.PI);
            if (t.v === 'e') return N(Math.E);
            return V(t.v);
          }
          if (t.k === '(') { p++; const a = expr(); if (!eat(')')) throw new Error('Falta ")"'); return a; }
          throw new Error('No esperaba "' + t.k + '"');
        }

        function power() {
          const base = atom();
          if (peek() && peek().k === '^') { p++; return OP('^', base, unary()); }
          return base;
        }

        function unary() {
          if (peek() && peek().k === '-') { p++; return OP('*', N(-1), unary()); }
          if (peek() && peek().k === '+') { p++; return unary(); }
          return power();
        }

        function term() {
          let a = unary();
          for (;;) {
            const t = peek();
            if (!t) break;
            if (t.k === '*') { p++; a = OP('*', a, unary()); continue; }
            if (t.k === '/') { p++; a = OP('/', a, unary()); continue; }
            // multiplicación implícita: 2x, 3(x+1), x y, (x+1)(x-1)
            if (t.k === 'n' || t.k === 'id' || t.k === '(') { a = OP('*', a, unary()); continue; }
            break;
          }
          return a;
        }

        function expr() {
          let a = term();
          for (;;) {
            const t = peek();
            if (t && t.k === '+') { p++; a = OP('+', a, term()); continue; }
            if (t && t.k === '-') { p++; a = OP('-', a, term()); continue; }
            break;
          }
          return a;
        }

        const r = expr();
        if (p < ts.length) throw new Error('Sobra texto en la expresión');
        return r;
      }

      /* ---------- evaluación ---------- */
      function ev(n, sc) {
        sc = sc || {};
        if (n.t === 'n') return n.v;
        if (n.t === 'v') return sc[n.n] === undefined ? NaN : sc[n.n];
        if (n.t === 'f') return FNS[n.f](ev(n.a, sc));
        const a = ev(n.a, sc), b = ev(n.b, sc);
        return n.o === '+' ? a + b : n.o === '-' ? a - b : n.o === '*' ? a * b
          : n.o === '/' ? a / b : Math.pow(a, b);
      }

      /* ---------- simplificación ---------- */
      const isN = (n, v) => n.t === 'n' && Math.abs(n.v - v) < 1e-12;
      function simp(n) {
        if (n.t === 'n' || n.t === 'v') return n;
        if (n.t === 'f') {
          const a = simp(n.a);
          if (a.t === 'n') { const r = FNS[n.f](a.v); if (isFinite(r)) return N(r); }
          return FN(n.f, a);
        }
        const a = simp(n.a), b = simp(n.b), o = n.o;
        if (a.t === 'n' && b.t === 'n') {
          const r = ev(OP(o, a, b), {});
          if (isFinite(r)) return N(Math.abs(r - Math.round(r)) < 1e-12 ? Math.round(r) : r);
        }
        if (o === '+') { if (isN(a, 0)) return b; if (isN(b, 0)) return a; }
        if (o === '-') { if (isN(b, 0)) return a; if (isN(a, 0)) return simp(OP('*', N(-1), b)); }
        if (o === '*') {
          if (isN(a, 0) || isN(b, 0)) return N(0);
          if (isN(a, 1)) return b; if (isN(b, 1)) return a;
          if (b.t === 'n' && a.t !== 'n') return simp(OP('*', b, a)); // constante adelante
          // asociatividad: 5·(4·x) → 20·x
          if (a.t === 'n' && b.t === 'o' && b.o === '*' && b.a.t === 'n') return simp(OP('*', N(a.v * b.a.v), b.b));
          if (a.t === 'n' && b.t === 'o' && b.o === '/' && b.a.t === 'n') return simp(OP('/', N(a.v * b.a.v), b.b));
        }
        if (o === '/') {
          if (isN(a, 0)) return N(0);
          if (isN(b, 1)) return a;
          // (c·u)/k → (c/k)·u  y  c/k cuando ambos son números
          if (b.t === 'n' && a.t === 'o' && a.o === '*' && a.a.t === 'n') return simp(OP('*', N(a.a.v / b.v), a.b));
          if (b.t === 'n' && isN(b, -1)) return simp(OP('*', N(-1), a));
        }
        if (o === '^') { if (isN(b, 1)) return a; if (isN(b, 0)) return N(1); if (isN(a, 1)) return N(1); }
        return OP(o, a, b);
      }

      /* ---------- derivada simbólica ---------- */
      function d(n, v) {
        v = v || 'x';
        if (n.t === 'n') return N(0);
        if (n.t === 'v') return N(n.n === v ? 1 : 0);
        if (n.t === 'f') {
          const u = n.a, du = d(u, v);
          let g;
          switch (n.f) {
            case 'sin': g = FN('cos', u); break;
            case 'cos': g = OP('*', N(-1), FN('sin', u)); break;
            case 'tan': g = OP('/', N(1), OP('^', FN('cos', u), N(2))); break;
            case 'exp': g = FN('exp', u); break;
            case 'ln': g = OP('/', N(1), u); break;
            case 'sqrt': g = OP('/', N(1), OP('*', N(2), FN('sqrt', u))); break;
            case 'asin': g = OP('/', N(1), FN('sqrt', OP('-', N(1), OP('^', u, N(2))))); break;
            case 'acos': g = OP('*', N(-1), OP('/', N(1), FN('sqrt', OP('-', N(1), OP('^', u, N(2)))))); break;
            case 'atan': g = OP('/', N(1), OP('+', N(1), OP('^', u, N(2)))); break;
            case 'sinh': g = FN('cosh', u); break;
            case 'cosh': g = FN('sinh', u); break;
            case 'tanh': g = OP('/', N(1), OP('^', FN('cosh', u), N(2))); break;
            default: throw new Error('No sé derivar ' + n.f + '()');
          }
          return OP('*', g, du);
        }
        const a = n.a, b = n.b;
        if (n.o === '+') return OP('+', d(a, v), d(b, v));
        if (n.o === '-') return OP('-', d(a, v), d(b, v));
        if (n.o === '*') return OP('+', OP('*', d(a, v), b), OP('*', a, d(b, v)));
        if (n.o === '/') return OP('/', OP('-', OP('*', d(a, v), b), OP('*', a, d(b, v))), OP('^', b, N(2)));
        // potencia
        if (b.t === 'n') return OP('*', OP('*', b, OP('^', a, N(b.v - 1))), d(a, v));
        return OP('*', OP('^', a, b),
          OP('+', OP('*', d(b, v), FN('ln', a)), OP('/', OP('*', b, d(a, v)), a)));
      }
      const der = (n, v) => simp(simp(d(n, v)));

      /* ---------- primitiva (Barrow) ---------- */
      const hasVar = (n, v) => n.t === 'v' ? n.n === v : n.t === 'f' ? hasVar(n.a, v)
        : n.t === 'o' ? (hasVar(n.a, v) || hasVar(n.b, v)) : false;
      /** Devuelve {m,b} si el nodo es m*x+b, o null. */
      function lin(n, v) {
        if (!hasVar(n, v)) { const c = ev(n, {}); return isFinite(c) ? { m: 0, b: c } : null; }
        if (n.t === 'v') return { m: 1, b: 0 };
        if (n.t === 'o') {
          const A = lin(n.a, v), B = lin(n.b, v);
          if (!A || !B) return null;
          if (n.o === '+') return { m: A.m + B.m, b: A.b + B.b };
          if (n.o === '-') return { m: A.m - B.m, b: A.b - B.b };
          if (n.o === '*') { if (A.m === 0) return { m: A.b * B.m, b: A.b * B.b }; if (B.m === 0) return { m: A.m * B.b, b: A.b * B.b }; return null; }
          if (n.o === '/') { if (B.m === 0 && B.b !== 0) return { m: A.m / B.b, b: A.b / B.b }; return null; }
        }
        return null;
      }
      /** Primitiva simbólica para un subconjunto útil. null = no soportada. */
      function anti(n, v) {
        v = v || 'x';
        if (!hasVar(n, v)) return OP('*', n, V(v));
        if (n.t === 'v') return OP('/', OP('^', V(v), N(2)), N(2));
        if (n.t === 'f') {
          const L = lin(n.a, v);
          if (!L || L.m === 0) return null;
          const k = N(L.m), u = n.a;
          if (n.f === 'sin') return OP('/', OP('*', N(-1), FN('cos', u)), k);
          if (n.f === 'cos') return OP('/', FN('sin', u), k);
          if (n.f === 'exp') return OP('/', FN('exp', u), k);
          return null;
        }
        if (n.o === '+' || n.o === '-') {
          const A = anti(n.a, v), B = anti(n.b, v);
          return A && B ? OP(n.o, A, B) : null;
        }
        if (n.o === '*') {
          if (!hasVar(n.a, v)) { const B = anti(n.b, v); return B ? OP('*', n.a, B) : null; }
          if (!hasVar(n.b, v)) { const A = anti(n.a, v); return A ? OP('*', n.b, A) : null; }
          return null;
        }
        if (n.o === '/') {
          if (!hasVar(n.b, v)) { const A = anti(n.a, v); return A ? OP('/', A, n.b) : null; }
          if (!hasVar(n.a, v)) { // c / x^k  →  c * x^(-k)
            const den = n.b;
            if (den.t === 'v') return null; // ln|x|: fuera de alcance
            if (den.t === 'o' && den.o === '^' && den.a.t === 'v' && den.a.n === v && den.b.t === 'n' && den.b.v !== 1)
              return anti(OP('*', n.a, OP('^', V(v), N(-den.b.v))), v);
          }
          return null;
        }
        if (n.o === '^') {
          if (n.a.t === 'v' && n.a.n === v && n.b.t === 'n') {
            if (Math.abs(n.b.v + 1) < 1e-12) return null; // ln|x|
            return OP('/', OP('^', V(v), N(n.b.v + 1)), N(n.b.v + 1));
          }
          // a^(m x + b) con a constante
          if (!hasVar(n.a, v)) {
            const L = lin(n.b, v);
            if (L && L.m !== 0) return OP('/', n, OP('*', N(L.m), FN('ln', n.a)));
          }
          return null;
        }
        return null;
      }

      /* ---------- impresión ---------- */
      const PR = { '+': 1, '-': 1, '*': 2, '/': 2, '^': 3 };
      function num2s(v) {
        if (Math.abs(v - Math.round(v)) < 1e-10) v = Math.round(v);
        return String(Number(v.toFixed(6)));
      }
      function str(n, parent, right) {
        if (n.t === 'n') return num2s(n.v);
        if (n.t === 'v') return n.n;
        if (n.t === 'f') return n.f + '(' + str(n.a) + ')';
        const p = PR[n.o];
        const negOf = (m) => m.t === 'n' && m.v < 0 ? N(-m.v)
          : (m.t === 'o' && m.o === '*' && m.a.t === 'n' && m.a.v === -1) ? m.b
          : (m.t === 'o' && m.o === '*' && m.a.t === 'n' && m.a.v < 0) ? OP('*', N(-m.a.v), m.b)
          : (m.t === 'o' && m.o === '/' && m.a.t === 'n' && m.a.v < 0) ? OP('/', N(-m.a.v), m.b) : null;
        let s;
        if (n.o === '*' && n.a.t === 'n' && n.a.v === -1) s = '-' + str(n.b, '*', true);
        else if (n.o === '+' && negOf(n.b)) s = str(n.a, '-', false) + ' - ' + str(negOf(n.b), '-', true);
        else s = str(n.a, n.o, false) + ' ' + (n.o === '*' ? '·' : n.o) + ' ' + str(n.b, n.o, true);
        if (n.o === '^') s = str(n.a, '^', false) + '^' + str(n.b, '^', true);
        if (!parent) return s;
        const pp = PR[parent];
        if (p < pp || (p === pp && right && (parent === '-' || parent === '/' || parent === '^'))) return '(' + s + ')';
        return s;
      }

      /* ---------- utilidades numéricas ---------- */
      /** Redondea a entero lo que esté a menos de 1e-10, y mata el "-0". */
      function snap(v) {
        if (!isFinite(v)) return v;
        const r = Math.round(v);
        if (Math.abs(v - r) < 1e-10) v = r;
        return v === 0 ? 0 : v;
      }
      function simpson(fn, a, b, m) {
        m = m || 800; if (m % 2) m++;
        const h = (b - a) / m;
        let s = 0;
        for (let k = 0; k <= m; k++) {
          const y = fn(a + k * h);
          if (!isFinite(y)) throw new Error('La función no es continua en el intervalo');
          s += (k === 0 || k === m ? 1 : k % 2 ? 4 : 2) * y;
        }
        return (s * h) / 3;
      }
      function bisect(f, a, b) {
        let fa = f(a);
        for (let k = 0; k < 70; k++) {
          const m = (a + b) / 2, fm = f(m);
          if (Math.abs(fm) < 1e-10) return m;
          if (fa * fm <= 0) b = m; else { a = m; fa = fm; }
        }
        return (a + b) / 2;
      }
      /** Ceros de f en [min,max] — mismo barrido que la fórmula original. */
      function scanRoots(f, min, max) {
        const out = [];
        let a = min, fa = f(a);
        for (let k = 1; k <= 1600; k++) {
          const b = min + ((max - min) * k) / 1600, fb = f(b);
          if (isFinite(fa) && isFinite(fb) && fa * fb < 0) {
            const r = bisect(f, a, b);
            if (!out.some((v) => Math.abs(v - r) < 1e-4)) out.push(r);
          }
          if (Math.abs(fb) < 1e-6 && !out.some((v) => Math.abs(v - b) < 1e-3)) out.push(b);
          a = b; fa = fb;
        }
        return out;
      }

      return { parse: parse, ev: ev, der: der, simp: simp, anti: anti, str: str,
        snap: snap, simpson: simpson, scanRoots: scanRoots, hasVar: hasVar, N: N, V: V, OP: OP };
    }

    const M = MK();

    /**
     * Acá NO hay plata en ninguna rama y el default de HubRow es 'ars'.
     * Toda fila declara su formato explícito.
     */
    const P0 = { format: 'plain', decimals: 0 };
    const P2 = { format: 'plain', decimals: 2 };
    const P4 = { format: 'plain', decimals: 4 };
    const P6 = { format: 'plain', decimals: 6 };

    const snap = M.snap;
    const fmt = (n) => {
      if (n === undefined || n === null || !isFinite(n)) return '—';
      n = snap(n);
      const abs = Math.abs(n);
      const dec = abs >= 1000 ? 0 : abs >= 1 ? 2 : 4;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };

    const err = (msg) => ({
      total: '—', sub: msg,
      rows: [{ k: 'Revisá los datos y volvé a calcular', v: 0, ...P2 }],
      chart: [], format: 'plain', decimals: 2,
    });

    /** Derivada numérica por diferencia central: la verificación independiente. */
    const numDer = (f, x) => {
      const h = Math.max(1e-6, Math.abs(x) * 1e-6);
      return (f(x + h) - f(x - h)) / (2 * h);
    };

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'basica';
      try {
        const x0 = H.num(v.punto);
        const y0 = H.num(v.yv);
        const z0 = H.num(v.zv);

        // ---- 1) Derivada de una función (potencia, producto, cociente, cadena)
        if (id === 'basica') {
          const f = M.parse(v.funcion);
          const d1 = M.der(f, 'x');
          const d2 = M.der(d1, 'x');
          const fx = snap(M.ev(f, { x: x0 }));
          const m = snap(M.ev(d1, { x: x0 }));
          const c = snap(M.ev(d2, { x: x0 }));
          if (!isFinite(fx)) return err('La función no está definida en x₀ = ' + fmt(x0) + '. Probá con otro punto.');
          const chk = snap(numDer((x) => M.ev(f, { x }), x0));
          return {
            total: fmt(m),
            sub: "f(x) = " + M.str(f) + "  →  f′(x) = " + M.str(d1) + "  →  f′(" + fmt(x0) + ") = " + fmt(m),
            rows: [
              { k: 'f(x₀) — el valor de la función en el punto', ref: 'f(x) = ' + M.str(f), v: fx, ...P4 },
              { k: "f′(x₀) — la derivada, o sea la pendiente", ref: "f′(x) = " + M.str(d1), v: m, extra: true, ...P4 },
              { k: 'f″(x₀) — la curvatura', ref: 'f″(x) = ' + M.str(d2), v: c, ...P4 },
              { k: 'Verificación numérica por diferencia central', ref: 'otro camino: (f(x₀+h) − f(x₀−h)) ÷ 2h', v: chk, ...P4 },
              { k: 'Diferencia entre la simbólica y la numérica', ref: 'si no es casi 0, revisá el planteo', v: Math.abs(m - chk), ...P6 },
            ],
            format: 'plain', decimals: 4,
            chart: [
              { label: '|f(x₀)| = ' + fmt(Math.abs(fx)), value: Math.abs(fx), tone: 'prop' },
              { label: "|f′(x₀)| = " + fmt(Math.abs(m)), value: Math.abs(m), tone: 'main' },
              { label: '|f″(x₀)| = ' + fmt(Math.abs(c)), value: Math.abs(c), tone: 'good' },
            ],
          };
        }

        // ---- 2) Polinomio cargando los coeficientes -----------------------
        if (id === 'polinomio') {
          const cs = String(v.coefs || '').split(/[;,\s]+/).filter(Boolean).map(Number);
          if (cs.length < 2 || cs.some((n) => !isFinite(n))) {
            return err('Cargá al menos dos coeficientes válidos, del mayor grado al término independiente.');
          }
          const n = cs.length - 1;
          const dc = [];
          for (let k = 0; k < n; k++) dc.push(cs[k] * (n - k));
          const src = cs.map((a, k) => '(' + a + ')*x^' + (n - k)).join('+');
          const f = M.parse(src);
          const d1 = M.simp(M.der(f, 'x'));
          const fx = snap(M.ev(f, { x: x0 }));
          const m = snap(dc.reduce((a, b) => a * x0 + b, 0));
          const chk = snap(numDer((x) => M.ev(f, { x }), x0));
          return {
            total: fmt(m),
            sub: "f′(x) = " + M.str(d1) + "  ·  coeficientes de la derivada: " + dc.join(', ') + "  ·  f′(" + fmt(x0) + ") = " + fmt(m),
            rows: [
              { k: 'Grado del polinomio', ref: 'cantidad de coeficientes − 1', v: n, ...P0 },
              { k: 'f(x₀) — el polinomio evaluado', ref: 'f(x) = ' + M.str(M.simp(f)), v: fx, ...P4 },
              { k: 'Primer coeficiente × su exponente: ' + cs[0] + ' × ' + n, ref: 'paso 1 — regla de la potencia en el término líder', v: dc[0], ...P2 },
              { k: 'Término independiente (' + cs[n] + ') → se anula', ref: 'la derivada de una constante es 0', v: 0, ...P0 },
              { k: 'Grado de la derivada', ref: 'siempre uno menos', v: Math.max(0, n - 1), ...P0 },
              { k: "f′(x₀) — la derivada en el punto", ref: "f′(x) = " + M.str(d1), v: m, extra: true, ...P4 },
              { k: 'Verificación numérica por diferencia central', ref: "tiene que coincidir con f′(x₀)", v: chk, ...P4 },
            ],
            format: 'plain', decimals: 4,
            chart: [
              { label: '|f(x₀)| = ' + fmt(Math.abs(fx)), value: Math.abs(fx), tone: 'prop' },
              { label: "|f′(x₀)| = " + fmt(Math.abs(m)), value: Math.abs(m), tone: 'main' },
            ],
          };
        }

        // ---- 3) Derivadas parciales --------------------------------------
        if (id === 'parciales') {
          const f = M.parse(v.funcion);
          const w = String(v.variable || 'x');
          const sc = { x: x0, y: y0, z: z0 };
          const dx = M.der(f, 'x'), dy = M.der(f, 'y'), dz = M.der(f, 'z');
          const own = w === 'y' ? dy : w === 'z' ? dz : dx;
          const seg = M.der(own, w);
          const mxy = M.der(dx, 'y'), myx = M.der(dy, 'x');
          const gx = snap(M.ev(dx, sc)), gy = snap(M.ev(dy, sc)), gz = snap(M.ev(dz, sc));
          const val = snap(M.ev(own, sc));
          if (!isFinite(val)) return err('La parcial no está definida en el punto (' + fmt(x0) + ', ' + fmt(y0) + ', ' + fmt(z0) + ').');
          const modulo = Math.hypot(isFinite(gx) ? gx : 0, isFinite(gy) ? gy : 0, isFinite(gz) ? gz : 0);
          return {
            total: fmt(val),
            sub: '∂f/∂' + w + ' = ' + M.str(own) + '  ·  evaluada en (' + fmt(x0) + ', ' + fmt(y0) + ', ' + fmt(z0) + ') = ' + fmt(val),
            rows: [
              { k: 'f evaluada en el punto', ref: 'f = ' + M.str(f), v: snap(M.ev(f, sc)), ...P4 },
              { k: '∂f/∂x — se derivó tratando y, z como constantes', ref: '∂f/∂x = ' + M.str(dx), v: gx, extra: w === 'x', ...P4 },
              { k: '∂f/∂y — se derivó tratando x, z como constantes', ref: '∂f/∂y = ' + M.str(dy), v: gy, extra: w === 'y', ...P4 },
              { k: '∂f/∂z — se derivó tratando x, y como constantes', ref: '∂f/∂z = ' + M.str(dz), v: gz, extra: w === 'z', ...P4 },
              { k: '|∇f| — módulo del gradiente en el punto', ref: 'si da 0, el punto es crítico', v: snap(modulo), ...P4 },
              { k: '∂²f/∂' + w + '² — la segunda parcial', ref: '= ' + M.str(seg), v: snap(M.ev(seg, sc)), ...P4 },
              { k: 'Verificación de Schwarz: ∂²f/∂x∂y − ∂²f/∂y∂x', ref: 'en funciones suaves tiene que dar 0', v: snap(M.ev(mxy, sc) - M.ev(myx, sc)), ...P6 },
            ],
            format: 'plain', decimals: 4,
            chart: [
              { label: '|∂f/∂x| = ' + fmt(Math.abs(gx)), value: Math.abs(isFinite(gx) ? gx : 0), tone: w === 'x' ? 'main' : 'prop' },
              { label: '|∂f/∂y| = ' + fmt(Math.abs(gy)), value: Math.abs(isFinite(gy) ? gy : 0), tone: w === 'y' ? 'main' : 'prop' },
              { label: '|∂f/∂z| = ' + fmt(Math.abs(gz)), value: Math.abs(isFinite(gz) ? gz : 0), tone: w === 'z' ? 'main' : 'good' },
            ],
          };
        }

        // ---- 4) Derivación implícita -------------------------------------
        if (id === 'implicita') {
          const raw = String(v.ecuacion || '');
          const parts = raw.split('=');
          if (parts.length !== 2) return err('Escribí una igualdad con un solo signo =, por ejemplo x^2+y^2=25.');
          const F = M.OP('-', M.parse(parts[0]), M.parse(parts[1]));
          const Fx = M.der(F, 'x'), Fy = M.der(F, 'y');
          const sc = { x: x0, y: y0, z: 0 };
          const fxv = snap(M.ev(Fx, sc)), fyv = snap(M.ev(Fy, sc));
          const fv = snap(M.ev(F, sc));
          if (Math.abs(fyv) < 1e-12) {
            return {
              total: 'vertical',
              sub: 'Fy = 0 en el punto: la tangente es vertical y dy/dx no existe ahí. Mirá dx/dy en su lugar.',
              rows: [
                { k: 'F(x₀, y₀) — tiene que dar 0 si el punto está en la curva', ref: 'F = ' + M.str(F), v: fv, ...P6 },
                { k: 'Fx en el punto', ref: 'Fx = ' + M.str(Fx), v: fxv, ...P4 },
                { k: 'Fy en el punto', ref: 'Fy = ' + M.str(Fy), v: fyv, ...P4 },
              ],
              format: 'plain', decimals: 4,
              chart: [
                { label: '|Fx| = ' + fmt(Math.abs(fxv)), value: Math.abs(fxv), tone: 'prop' },
                { label: '|Fy| = 0', value: 0, tone: 'warn' },
              ],
            };
          }
          const m = snap(-fxv / fyv);
          return {
            total: fmt(m),
            sub: 'dy/dx = −Fx ÷ Fy = −(' + fmt(fxv) + ') ÷ (' + fmt(fyv) + ') = ' + fmt(m) +
              (Math.abs(fv) > 1e-6 ? '  ⚠ ojo: el punto no cumple la ecuación' : ''),
            rows: [
              { k: 'F(x₀, y₀) — verificación de que el punto está en la curva', ref: 'F = ' + M.str(F) + ' (tiene que dar 0)', v: fv, ...P6 },
              { k: 'Fx — parcial respecto de x, con y fija', ref: 'Fx = ' + M.str(Fx), v: fxv, ...P4 },
              { k: 'Fy — parcial respecto de y, con x fija', ref: 'Fy = ' + M.str(Fy), v: fyv, ...P4 },
              { k: 'dy/dx = −Fx ÷ Fy', ref: 'el despeje: la pendiente de la curva en el punto', v: m, extra: true, ...P4 },
              { k: 'Ordenada al origen de esa tangente (b = y₀ − m·x₀)', ref: 'y = m·x + b', v: snap(y0 - m * x0), ...P4 },
              { k: 'Pendiente de la recta normal (−1 ÷ m)', ref: 'la perpendicular en el mismo punto', v: Math.abs(m) < 1e-12 ? Infinity : snap(-1 / m), ...P4 },
            ],
            format: 'plain', decimals: 4,
            chart: [
              { label: '|Fx| = ' + fmt(Math.abs(fxv)), value: Math.abs(fxv), tone: 'prop' },
              { label: '|Fy| = ' + fmt(Math.abs(fyv)), value: Math.abs(fyv), tone: 'good' },
              { label: '|dy/dx| = ' + fmt(Math.abs(m)), value: Math.abs(m), tone: 'main' },
            ],
          };
        }

        // ---- 5) Recta tangente y normal ----------------------------------
        if (id === 'tangente') {
          const f = M.parse(v.funcion);
          const d1 = M.der(f, 'x');
          const fx = snap(M.ev(f, { x: x0 }));
          const m = snap(M.ev(d1, { x: x0 }));
          if (!isFinite(fx) || !isFinite(m)) return err('La función o su derivada no están definidas en x₀ = ' + fmt(x0) + '.');
          const b = snap(fx - m * x0);
          const vertical = Math.abs(m) < 1e-12;
          const mn = vertical ? Infinity : snap(-1 / m);
          return {
            total: fmt(m),
            sub: 'Tangente: y = ' + fmt(m) + '·x ' + (b >= 0 ? '+ ' : '− ') + fmt(Math.abs(b)) +
              '  ·  Normal: ' + (vertical ? 'x = ' + fmt(x0) + ' (vertical)' : 'y = ' + fmt(mn) + '·(x − ' + fmt(x0) + ') + ' + fmt(fx)),
            rows: [
              { k: 'x₀ — abscisa del punto de contacto', ref: 'el dato que cargaste', v: x0, ...P4 },
              { k: 'f(x₀) — ordenada del punto de contacto', ref: 'f(x) = ' + M.str(f), v: fx, ...P4 },
              { k: 'm = f′(x₀) — pendiente de la tangente', ref: "f′(x) = " + M.str(d1), v: m, extra: true, ...P4 },
              { k: 'b = f(x₀) − m·x₀ — ordenada al origen', ref: 'forma explícita y = m·x + b', v: b, ...P4 },
              { k: 'Pendiente de la normal (−1 ÷ m)', ref: vertical ? 'm = 0 → la normal es la vertical x = x₀' : 'perpendicular a la tangente', v: vertical ? Infinity : mn, ...P4 },
              { k: 'Verificación: m·x₀ + b', ref: 'tiene que devolver f(x₀)', v: snap(m * x0 + b), ...P4 },
            ],
            format: 'plain', decimals: 4,
            chart: [
              { label: '|f(x₀)| = ' + fmt(Math.abs(fx)), value: Math.abs(fx), tone: 'prop' },
              { label: '|m tangente| = ' + fmt(Math.abs(m)), value: Math.abs(m), tone: 'main' },
              { label: '|m normal| = ' + (vertical ? '∞' : fmt(Math.abs(mn))), value: vertical ? 0 : Math.abs(mn), tone: 'good' },
            ],
          };
        }

        // ---- 6) Máximos, mínimos y puntos críticos -----------------------
        const f = M.parse(v.funcion);
        const d1 = M.der(f, 'x');
        const d2 = M.der(d1, 'x');
        let lo = H.num(v.min), hi = H.num(v.max);
        if (!(hi > lo)) { lo = -10; hi = 10; }
        const rs = M.scanRoots((x) => M.ev(d1, { x }), lo, hi);
        const infl = M.scanRoots((x) => M.ev(d2, { x }), lo, hi);
        if (!rs.length) {
          return {
            total: '0',
            sub: "f′(x) = " + M.str(d1) + ' no se anula en [' + fmt(lo) + ', ' + fmt(hi) + ']: la función es monótona en ese tramo. Ampliá el intervalo si esperabas encontrar algo.',
            rows: [
              { k: 'Puntos críticos hallados en el intervalo', ref: "ceros de f′(x)", v: 0, ...P0 },
              { k: "f′ en el extremo izquierdo del intervalo", ref: 'su signo dice si crece o decrece', v: snap(M.ev(d1, { x: lo })), ...P4 },
              { k: "f′ en el extremo derecho del intervalo", ref: 'mismo signo = sin cambio de sentido', v: snap(M.ev(d1, { x: hi })), ...P4 },
              { k: 'Puntos de inflexión detectados', ref: 'ceros de f″(x)', v: infl.length, ...P0 },
            ],
            format: 'plain', decimals: 4,
            chart: [
              { label: 'f(' + fmt(lo) + ') = ' + fmt(M.ev(f, { x: lo })), value: Math.abs(M.ev(f, { x: lo })), tone: 'prop' },
              { label: 'f(' + fmt(hi) + ') = ' + fmt(M.ev(f, { x: hi })), value: Math.abs(M.ev(f, { x: hi })), tone: 'main' },
            ],
          };
        }
        const pts = rs.slice(0, 6).map((x) => {
          const xs = snap(Number(x.toFixed(8)));
          const fv = snap(Number(M.ev(f, { x: xs }).toFixed(8)));
          const s = M.ev(d2, { x: xs });
          const tipo = s > 1e-9 ? 'Mínimo local' : s < -1e-9 ? 'Máximo local' : 'Punto crítico sin decidir (f″ = 0)';
          return { x: xs, y: fv, s: snap(s), tipo: tipo };
        });
        const rows = [
          { k: 'Puntos críticos hallados en [' + fmt(lo) + ', ' + fmt(hi) + ']', ref: "ceros de f′(x) = " + M.str(d1), v: rs.length, ...P0 },
        ];
        pts.forEach((p) => {
          rows.push({ k: p.tipo + ' en x = ' + fmt(p.x) + ' → f(x) vale', ref: 'f″(' + fmt(p.x) + ') = ' + fmt(p.s) + (p.s > 0 ? ' > 0, abre hacia arriba' : p.s < 0 ? ' < 0, abre hacia abajo' : ', el criterio no decide'), v: p.y, extra: true, ...P4 });
        });
        rows.push({ k: 'Puntos de inflexión detectados', ref: 'ceros de f″(x) = ' + M.str(d2), v: infl.length, ...P0 });
        rows.push({ k: "Verificación: f′ en el primer punto crítico", ref: 'tiene que ser prácticamente 0', v: snap(M.ev(d1, { x: pts[0].x })), ...P6 });
        return {
          total: fmt(pts[0].x),
          sub: pts.map((p) => p.tipo.toLowerCase() + ' en (' + fmt(p.x) + ', ' + fmt(p.y) + ')').join(' · ') +
            "  ·  f′(x) = " + M.str(d1),
          rows: rows,
          format: 'plain', decimals: 4,
          chart: pts.map((p, k) => ({
            label: 'f(' + fmt(p.x) + ') = ' + fmt(p.y),
            value: Math.abs(p.y) || 0.0001,
            tone: p.s < 0 ? 'main' : k === 0 ? 'good' : 'prop',
          })),
        };
      } catch (e) {
        return err('No pude leer la expresión: ' + (e && e.message ? e.message : 'revisá los paréntesis y los operadores') + '.');
      }
    });
  })();
</script>
