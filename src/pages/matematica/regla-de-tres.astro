---
/**
 * Hub de decisión — "¿Cómo hago una regla de tres?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de matematica/porcentajes.astro: la página sólo aporta los
 * datos (src/lib/hubs/regla-de-tres.ts) y su compute(). El chrome, el CSS y el
 * runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/regla-de-tres';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * Acá NO hay plata en ninguna rama, y el default de HubRow es 'ars'. Toda
     * fila declara su formato explícito: 'plain' para cantidades y 'unit' para
     * metros, centímetros, días y horas-hombre.
     */
    const PLAIN = { format: 'plain', decimals: 2 };
    const PLAIN4 = { format: 'plain', decimals: 4 };
    const DIAS = { format: 'unit', unit: 'días', decimals: 2 };
    const HH = { format: 'unit', unit: 'h-hombre', decimals: 2 };
    const CM = { format: 'unit', unit: 'cm', decimals: 2 };
    const M = { format: 'unit', unit: 'm', decimals: 2 };

    const fmt = (n) => {
      if (!isFinite(n)) return '—';
      const abs = Math.abs(n);
      const dec = abs >= 1000 ? 0 : abs >= 1 ? 2 : 4;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };

    const err = (msg, k, v) => ({
      total: '—',
      sub: msg,
      rows: [{ k: k, v: v, ...PLAIN }],
      chart: [],
      format: 'plain',
      decimals: 2,
    });

    H.onCompute(function (v, kase) {
      const a = H.num(v.a);
      const b = H.num(v.b);
      const c = H.num(v.c);
      const d = H.num(v.d);
      const e = H.num(v.e);
      const xIn = H.num(v.x);
      const esc = H.num(v.esc);
      const id = (kase && kase.id) || 'directa';

      // ---- 1) Regla de tres simple DIRECTA -----------------------------
      // Planteo: A/B = C/X  →  X = B × C ÷ A
      if (id === 'directa') {
        if (!a) return err('En la directa, A no puede ser 0: no se puede dividir por cero.', 'Valor A', 0);
        const x = (b * c) / a;
        return {
          total: fmt(x),
          sub:
            fmt(a) + ' es a ' + fmt(b) + ' como ' + fmt(c) + ' es a ' + fmt(x) +
            ' · despeje: X = B × C ÷ A',
          rows: [
            { k: 'A — primer dato', v: a, ...PLAIN },
            { k: 'B — lo que le corresponde a A', v: b, ...PLAIN },
            { k: 'C — el dato nuevo', v: c, ...PLAIN },
            { k: 'B × C', ref: 'paso 1: multiplicar en cruz', v: b * c, ...PLAIN },
            { k: 'Dividido A → X', ref: 'paso 2: el despeje', v: x, extra: true, ...PLAIN },
            { k: 'Verificación: A ÷ B (tiene que dar igual que C ÷ X)', ref: 'la razón constante', v: b ? a / b : 0, ...PLAIN4 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'A = ' + fmt(a), value: Math.abs(a), tone: 'prop' },
            { label: 'B = ' + fmt(b), value: Math.abs(b), tone: 'prop' },
            { label: 'C = ' + fmt(c), value: Math.abs(c), tone: 'good' },
            { label: 'X = ' + fmt(x), value: Math.abs(x), tone: 'main' },
          ],
        };
      }

      // ---- 2) Regla de tres simple INVERSA -----------------------------
      // Planteo: A × B = C × X  →  X = A × B ÷ C
      if (id === 'inversa') {
        if (!c) return err('En la inversa, C no puede ser 0: no se puede dividir por cero.', 'Valor C', 0);
        const x = (a * b) / c;
        return {
          total: fmt(x),
          sub:
            'A más ' + fmt(c) + ', menos X: ' + fmt(b) + ' pasa a ' + fmt(x) +
            ' · despeje: X = A × B ÷ C',
          rows: [
            { k: 'A — primer dato', v: a, ...PLAIN },
            { k: 'B — lo que le corresponde a A', v: b, ...PLAIN },
            { k: 'C — el dato nuevo', v: c, ...PLAIN },
            { k: 'A × B', ref: 'paso 1: el producto se mantiene', v: a * b, ...PLAIN },
            { k: 'Dividido C → X', ref: 'paso 2: el despeje', v: x, extra: true, ...PLAIN },
            { k: 'Verificación: C × X (tiene que dar igual que A × B)', ref: 'el producto constante', v: c * x, ...PLAIN },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'A = ' + fmt(a), value: Math.abs(a), tone: 'prop' },
            { label: 'B = ' + fmt(b), value: Math.abs(b), tone: 'prop' },
            { label: 'C = ' + fmt(c), value: Math.abs(c), tone: 'good' },
            { label: 'X = ' + fmt(x), value: Math.abs(x), tone: 'main' },
          ],
        };
      }

      // ---- 3) Regla de tres COMPUESTA (obra) ---------------------------
      // horas-hombre = personas × días × horas/día; días nuevos = total ÷ (personas × horas)
      if (id === 'compuesta') {
        const p1 = Math.max(1, a);
        const dias1 = Math.max(0, b);
        const h1 = Math.max(0, c);
        const p2 = Math.max(1, d);
        const h2 = Math.max(0, e);
        const total = p1 * dias1 * h1;
        if (!total || !h2) {
          return err(
            'Cargá la situación conocida (personas, días y horas) y las horas por día del nuevo equipo.',
            'Horas-hombre totales', total
          );
        }
        const dias2 = total / (p2 * h2);
        return {
          total: fmt(dias2),
          sub:
            'El trabajo son ' + fmt(total) + ' horas-hombre. Con ' + fmt(p2) + ' persona(s) a ' +
            fmt(h2) + ' h por día se termina en ' + fmt(dias2) + ' días.',
          rows: [
            { k: 'Personas de la situación conocida (A)', v: p1, ...PLAIN },
            { k: 'Días que tardaban (B)', v: dias1, ...DIAS },
            { k: 'Horas por día (C)', v: h1, format: 'unit', unit: 'h', decimals: 2 },
            { k: 'A × B × C → trabajo total', ref: 'paso 1: reducir a la unidad', v: total, extra: true, ...HH },
            { k: 'Personas del nuevo equipo (D)', v: p2, ...PLAIN },
            { k: 'Horas por día del nuevo equipo (E)', v: h2, format: 'unit', unit: 'h', decimals: 2 },
            { k: 'D × E → horas-hombre por día', ref: 'paso 2', v: p2 * h2, ...HH },
            { k: 'Total ÷ (D × E) → días necesarios', ref: 'paso 3: el despeje', v: dias2, extra: true, ...DIAS },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Días con el equipo original', value: Math.abs(dias1), tone: 'prop' },
            { label: 'Días con el nuevo equipo', value: Math.abs(dias2), tone: 'main' },
          ],
        };
      }

      // ---- 4) Del plano a la realidad ----------------------------------
      // reales (cm) = medida del plano (cm) × N  →  metros = /100
      if (id === 'escala-real') {
        const n = Math.max(1, esc);
        const plano = Math.max(0, b);
        const realCm = plano * n;
        const realM = realCm / 100;
        return {
          total: fmt(realM) + ' m',
          sub:
            fmt(plano) + ' cm en un plano a escala 1:' + fmt(n) + ' son ' + fmt(realM) +
            ' m en la realidad · despeje: real = plano × N',
          rows: [
            { k: 'Medida en el plano (campo B)', v: plano, ...CM },
            { k: 'Denominador de la escala (N)', ref: '1:' + fmt(n), v: n, ...PLAIN },
            { k: 'Plano × N → medida real', ref: 'paso 1', v: realCm, ...CM },
            { k: 'Dividido 100 → metros', ref: 'paso 2', v: realM, extra: true, ...M },
            { k: 'Lo que representa 1 cm del plano', ref: 'la regla de lectura', v: n / 100, ...M },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'En el plano (' + fmt(plano) + ' cm)', value: Math.max(0, plano), tone: 'prop' },
            { label: 'En la realidad (' + fmt(realCm) + ' cm)', value: Math.max(0, realCm), tone: 'main' },
          ],
        };
      }

      // ---- 5) De la realidad al plano ----------------------------------
      // plano (cm) = medida real (m) × 100 ÷ N
      if (id === 'escala-plano') {
        const n = Math.max(1, esc);
        const real = Math.max(0, b);
        const planoCm = (real * 100) / n;
        return {
          total: fmt(planoCm) + ' cm',
          sub:
            fmt(real) + ' m reales, a escala 1:' + fmt(n) + ', se dibujan como ' + fmt(planoCm) +
            ' cm · despeje: plano = real × 100 ÷ N',
          rows: [
            { k: 'Medida real (campo B)', v: real, ...M },
            { k: 'Pasada a centímetros', ref: 'paso 1: × 100', v: real * 100, ...CM },
            { k: 'Denominador de la escala (N)', ref: '1:' + fmt(n), v: n, ...PLAIN },
            { k: 'Dividido N → medida del dibujo', ref: 'paso 2: el despeje', v: planoCm, extra: true, ...CM },
            { k: 'Verificación: dibujo × N', ref: 'tiene que volver a los cm reales', v: planoCm * n, ...CM },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'En la realidad (' + fmt(real * 100) + ' cm)', value: Math.max(0, real * 100), tone: 'prop' },
            { label: 'En el plano (' + fmt(planoCm) + ' cm)', value: Math.max(0, planoCm), tone: 'main' },
          ],
        };
      }

      // ---- 6) Interpolación lineal -------------------------------------
      // t = (x − x0) / (x1 − x0);  y = y0 + t × (y1 − y0)
      const x0 = a, y0 = b, x1 = c, y1 = d;
      if (x0 === x1) {
        return err('x₀ y x₁ no pueden ser iguales: el tramo tendría ancho cero.', 'Ancho del tramo (x₁ − x₀)', 0);
      }
      const t = (xIn - x0) / (x1 - x0);
      const y = y0 + t * (y1 - y0);
      const extrap = t < 0 || t > 1;
      return {
        total: fmt(y),
        sub:
          (extrap
            ? '⚠ x = ' + fmt(xIn) + ' cae FUERA del tramo [' + fmt(Math.min(x0, x1)) + ', ' + fmt(Math.max(x0, x1)) + ']: estás extrapolando. '
            : 'x = ' + fmt(xIn) + ' está al ' + fmt(t * 100) + '% del tramo. ') +
          'y = y₀ + t × (y₁ − y₀) = ' + fmt(y),
        rows: [
          { k: 'Primer punto x₀ (campo A)', v: x0, ...PLAIN },
          { k: 'Primer punto y₀ (campo B)', v: y0, ...PLAIN },
          { k: 'Segundo punto x₁ (campo C)', v: x1, ...PLAIN },
          { k: 'Segundo punto y₁ (campo D)', v: y1, ...PLAIN },
          { k: 'El x que querés leer', v: xIn, ...PLAIN },
          { k: 't = (x − x₀) ÷ (x₁ − x₀)', ref: 'paso 1: la fracción del tramo', v: t, ...PLAIN4 },
          { k: 'y₁ − y₀', ref: 'paso 2: el salto de valores', v: y1 - y0, ...PLAIN },
          { k: 'y₀ + t × (y₁ − y₀) → resultado', ref: 'paso 3: el despeje', v: y, extra: true, ...PLAIN4 },
        ],
        format: 'plain',
        decimals: 2,
        chart: [
          { label: 'y₀ = ' + fmt(y0), value: Math.abs(y0), tone: 'prop' },
          { label: 'y interpolado = ' + fmt(y), value: Math.abs(y), tone: extrap ? 'warn' : 'main' },
          { label: 'y₁ = ' + fmt(y1), value: Math.abs(y1), tone: 'prop' },
        ],
      };
    });
  })();
</script>
