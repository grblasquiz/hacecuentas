---
/**
 * Hub de decisión — "¿Cómo calculo este límite o esta integral?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces); la transformada
 * de Laplace se absorbe sólo por URL, sin rama propia.
 *
 * Sigue el patrón de matematica/regla-de-tres.astro: la página sólo aporta
 * los datos (src/lib/hubs/limites-e-integrales.ts) y su compute(). El chrome,
 * el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LimitesIntegralesExperience from '../../components/generated/LimitesIntegralesExperience.astro';
import { hub } from '../../lib/hubs/limites-e-integrales';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <LimitesIntegralesExperience data={hub} />
  <Footer />
</Layout>

