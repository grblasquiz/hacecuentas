---
/**
 * Hub de decisión — "¿Cómo calculo este límite o esta integral?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces); la transformada
 * de Laplace se absorbe sólo por URL, sin rama propia.
 *
 * Sigue el patrón de matematica/regla-de-tres.astro: la página sólo aporta
 * los datos (src/lib/hubs/limites-e-integrales.ts) y su compute(). El chrome,
 * el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/limites-e-integrales';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /* ------------------------------------------------------------------
       Mini-CAS vanilla: parser + derivada simbólica + primitiva + evaluación.
       Las fórmulas viejas usaban mathjs, que no se puede importar dentro de
       un <script is:inline>. Este motor se verificó término a término contra
       mathjs y contra las fórmulas originales antes de publicarse.
       ------------------------------------------------------------------ */
    function MK() {
      const N = (v) => ({ t: 'n', v: v });
      const V = (n) => ({ t: 'v', n: n });
      const OP = (o, a, b) => ({ t: 'o', o: o, a: a, b: b });
      const FN = (f, a) => ({ t: 'f', f: f, a: a });

      const FNS = {
        sin: Math.sin, cos: Math.cos, tan: Math.tan,
        exp: Math.exp, ln: Math.log, log: Math.log, sqrt: Math.sqrt,
        abs: Math.abs, asin: Math.asin, acos: Math.acos, atan: Math.atan,
        sinh: Math.sinh, cosh: Math.cosh, tanh: Math.tanh,
      };

      /* ---------- tokenizer ---------- */
      function tok(src) {
        const s = String(src == null ? '' : src)
          .replace(/−/g, '-').replace(/[·×]/g, '*').replace(/÷/g, '/')
          .replace(/,/g, '.').replace(/\s+/g, '');
        const out = [];
        let i = 0;
        while (i < s.length) {
          const c = s[i];
          if (/[0-9.]/.test(c)) {
            let j = i;
            while (j < s.length && /[0-9.]/.test(s[j])) j++;
            out.push({ k: 'n', v: Number(s.slice(i, j)) });
            i = j;
          } else if (/[a-zA-Z_]/.test(c)) {
            let j = i;
            while (j < s.length && /[a-zA-Z_0-9]/.test(s[j])) j++;
            let id = s.slice(i, j);
            // "3xy" viene como un solo identificador "xy": lo partimos en variables
            if (!FNS[id] && id !== 'pi' && id !== 'e' && id.length > 1 && /^[xyz]+$/.test(id)) {
              for (let k = 0; k < id.length; k++) out.push({ k: 'id', v: id[k] });
              i = j; continue;
            }
            out.push({ k: 'id', v: id });
            i = j;
          } else if ('+-*/^()'.indexOf(c) >= 0) {
            out.push({ k: c });
            i++;
          } else {
            throw new Error('Caracter no reconocido: "' + c + '"');
          }
        }
        return out;
      }

      /* ---------- parser ---------- */
      function parse(src) {
        const ts = tok(src);
        let p = 0;
        const peek = () => ts[p];
        const eat = (k) => { if (ts[p] && ts[p].k === k) { p++; return true; } return false; };

        function atom() {
          const t = ts[p];
          if (!t) throw new Error('Expresión incompleta');
          if (t.k === 'n') { p++; return N(t.v); }
          if (t.k === 'id') {
            p++;
            if (FNS[t.v]) {
              if (!eat('(')) throw new Error('Falta "(" después de ' + t.v);
              const a = expr();
              if (!eat(')')) throw new Error('Falta ")" en ' + t.v);
              return FN(t.v === 'log' ? 'ln' : t.v, a);
            }
            if (t.v === 'pi') return N(Math.PI);
            if (t.v === 'e') return N(Math.E);
            return V(t.v);
          }
          if (t.k === '(') { p++; const a = expr(); if (!eat(')')) throw new Error('Falta ")"'); return a; }
          throw new Error('No esperaba "' + t.k + '"');
        }

        function power() {
          const base = atom();
          if (peek() && peek().k === '^') { p++; return OP('^', base, unary()); }
          return base;
        }

        function unary() {
          if (peek() && peek().k === '-') { p++; return OP('*', N(-1), unary()); }
          if (peek() && peek().k === '+') { p++; return unary(); }
          return power();
        }

        function term() {
          let a = unary();
          for (;;) {
            const t = peek();
            if (!t) break;
            if (t.k === '*') { p++; a = OP('*', a, unary()); continue; }
            if (t.k === '/') { p++; a = OP('/', a, unary()); continue; }
            // multiplicación implícita: 2x, 3(x+1), x y, (x+1)(x-1)
            if (t.k === 'n' || t.k === 'id' || t.k === '(') { a = OP('*', a, unary()); continue; }
            break;
          }
          return a;
        }

        function expr() {
          let a = term();
          for (;;) {
            const t = peek();
            if (t && t.k === '+') { p++; a = OP('+', a, term()); continue; }
            if (t && t.k === '-') { p++; a = OP('-', a, term()); continue; }
            break;
          }
          return a;
        }

        const r = expr();
        if (p < ts.length) throw new Error('Sobra texto en la expresión');
        return r;
      }

      /* ---------- evaluación ---------- */
      function ev(n, sc) {
        sc = sc || {};
        if (n.t === 'n') return n.v;
        if (n.t === 'v') return sc[n.n] === undefined ? NaN : sc[n.n];
        if (n.t === 'f') return FNS[n.f](ev(n.a, sc));
        const a = ev(n.a, sc), b = ev(n.b, sc);
        return n.o === '+' ? a + b : n.o === '-' ? a - b : n.o === '*' ? a * b
          : n.o === '/' ? a / b : Math.pow(a, b);
      }

      /* ---------- simplificación ---------- */
      const isN = (n, v) => n.t === 'n' && Math.abs(n.v - v) < 1e-12;
      function simp(n) {
        if (n.t === 'n' || n.t === 'v') return n;
        if (n.t === 'f') {
          const a = simp(n.a);
          if (a.t === 'n') { const r = FNS[n.f](a.v); if (isFinite(r)) return N(r); }
          return FN(n.f, a);
        }
        const a = simp(n.a), b = simp(n.b), o = n.o;
        if (a.t === 'n' && b.t === 'n') {
          const r = ev(OP(o, a, b), {});
          if (isFinite(r)) return N(Math.abs(r - Math.round(r)) < 1e-12 ? Math.round(r) : r);
        }
        if (o === '+') { if (isN(a, 0)) return b; if (isN(b, 0)) return a; }
        if (o === '-') { if (isN(b, 0)) return a; if (isN(a, 0)) return simp(OP('*', N(-1), b)); }
        if (o === '*') {
          if (isN(a, 0) || isN(b, 0)) return N(0);
          if (isN(a, 1)) return b; if (isN(b, 1)) return a;
          if (b.t === 'n' && a.t !== 'n') return simp(OP('*', b, a)); // constante adelante
          // asociatividad: 5·(4·x) → 20·x
          if (a.t === 'n' && b.t === 'o' && b.o === '*' && b.a.t === 'n') return simp(OP('*', N(a.v * b.a.v), b.b));
          if (a.t === 'n' && b.t === 'o' && b.o === '/' && b.a.t === 'n') return simp(OP('/', N(a.v * b.a.v), b.b));
        }
        if (o === '/') {
          if (isN(a, 0)) return N(0);
          if (isN(b, 1)) return a;
          // (c·u)/k → (c/k)·u  y  c/k cuando ambos son números
          if (b.t === 'n' && a.t === 'o' && a.o === '*' && a.a.t === 'n') return simp(OP('*', N(a.a.v / b.v), a.b));
          if (b.t === 'n' && isN(b, -1)) return simp(OP('*', N(-1), a));
        }
        if (o === '^') { if (isN(b, 1)) return a; if (isN(b, 0)) return N(1); if (isN(a, 1)) return N(1); }
        return OP(o, a, b);
      }

      /* ---------- derivada simbólica ---------- */
      function d(n, v) {
        v = v || 'x';
        if (n.t === 'n') return N(0);
        if (n.t === 'v') return N(n.n === v ? 1 : 0);
        if (n.t === 'f') {
          const u = n.a, du = d(u, v);
          let g;
          switch (n.f) {
            case 'sin': g = FN('cos', u); break;
            case 'cos': g = OP('*', N(-1), FN('sin', u)); break;
            case 'tan': g = OP('/', N(1), OP('^', FN('cos', u), N(2))); break;
            case 'exp': g = FN('exp', u); break;
            case 'ln': g = OP('/', N(1), u); break;
            case 'sqrt': g = OP('/', N(1), OP('*', N(2), FN('sqrt', u))); break;
            case 'asin': g = OP('/', N(1), FN('sqrt', OP('-', N(1), OP('^', u, N(2))))); break;
            case 'acos': g = OP('*', N(-1), OP('/', N(1), FN('sqrt', OP('-', N(1), OP('^', u, N(2)))))); break;
            case 'atan': g = OP('/', N(1), OP('+', N(1), OP('^', u, N(2)))); break;
            case 'sinh': g = FN('cosh', u); break;
            case 'cosh': g = FN('sinh', u); break;
            case 'tanh': g = OP('/', N(1), OP('^', FN('cosh', u), N(2))); break;
            default: throw new Error('No sé derivar ' + n.f + '()');
          }
          return OP('*', g, du);
        }
        const a = n.a, b = n.b;
        if (n.o === '+') return OP('+', d(a, v), d(b, v));
        if (n.o === '-') return OP('-', d(a, v), d(b, v));
        if (n.o === '*') return OP('+', OP('*', d(a, v), b), OP('*', a, d(b, v)));
        if (n.o === '/') return OP('/', OP('-', OP('*', d(a, v), b), OP('*', a, d(b, v))), OP('^', b, N(2)));
        // potencia
        if (b.t === 'n') return OP('*', OP('*', b, OP('^', a, N(b.v - 1))), d(a, v));
        return OP('*', OP('^', a, b),
          OP('+', OP('*', d(b, v), FN('ln', a)), OP('/', OP('*', b, d(a, v)), a)));
      }
      const der = (n, v) => simp(simp(d(n, v)));

      /* ---------- primitiva (Barrow) ---------- */
      const hasVar = (n, v) => n.t === 'v' ? n.n === v : n.t === 'f' ? hasVar(n.a, v)
        : n.t === 'o' ? (hasVar(n.a, v) || hasVar(n.b, v)) : false;
      /** Devuelve {m,b} si el nodo es m*x+b, o null. */
      function lin(n, v) {
        if (!hasVar(n, v)) { const c = ev(n, {}); return isFinite(c) ? { m: 0, b: c } : null; }
        if (n.t === 'v') return { m: 1, b: 0 };
        if (n.t === 'o') {
          const A = lin(n.a, v), B = lin(n.b, v);
          if (!A || !B) return null;
          if (n.o === '+') return { m: A.m + B.m, b: A.b + B.b };
          if (n.o === '-') return { m: A.m - B.m, b: A.b - B.b };
          if (n.o === '*') { if (A.m === 0) return { m: A.b * B.m, b: A.b * B.b }; if (B.m === 0) return { m: A.m * B.b, b: A.b * B.b }; return null; }
          if (n.o === '/') { if (B.m === 0 && B.b !== 0) return { m: A.m / B.b, b: A.b / B.b }; return null; }
        }
        return null;
      }
      /** Primitiva simbólica para un subconjunto útil. null = no soportada. */
      function anti(n, v) {
        v = v || 'x';
        if (!hasVar(n, v)) return OP('*', n, V(v));
        if (n.t === 'v') return OP('/', OP('^', V(v), N(2)), N(2));
        if (n.t === 'f') {
          const L = lin(n.a, v);
          if (!L || L.m === 0) return null;
          const k = N(L.m), u = n.a;
          if (n.f === 'sin') return OP('/', OP('*', N(-1), FN('cos', u)), k);
          if (n.f === 'cos') return OP('/', FN('sin', u), k);
          if (n.f === 'exp') return OP('/', FN('exp', u), k);
          return null;
        }
        if (n.o === '+' || n.o === '-') {
          const A = anti(n.a, v), B = anti(n.b, v);
          return A && B ? OP(n.o, A, B) : null;
        }
        if (n.o === '*') {
          if (!hasVar(n.a, v)) { const B = anti(n.b, v); return B ? OP('*', n.a, B) : null; }
          if (!hasVar(n.b, v)) { const A = anti(n.a, v); return A ? OP('*', n.b, A) : null; }
          return null;
        }
        if (n.o === '/') {
          if (!hasVar(n.b, v)) { const A = anti(n.a, v); return A ? OP('/', A, n.b) : null; }
          if (!hasVar(n.a, v)) { // c / x^k  →  c * x^(-k)
            const den = n.b;
            if (den.t === 'v') return null; // ln|x|: fuera de alcance
            if (den.t === 'o' && den.o === '^' && den.a.t === 'v' && den.a.n === v && den.b.t === 'n' && den.b.v !== 1)
              return anti(OP('*', n.a, OP('^', V(v), N(-den.b.v))), v);
          }
          return null;
        }
        if (n.o === '^') {
          if (n.a.t === 'v' && n.a.n === v && n.b.t === 'n') {
            if (Math.abs(n.b.v + 1) < 1e-12) return null; // ln|x|
            return OP('/', OP('^', V(v), N(n.b.v + 1)), N(n.b.v + 1));
          }
          // a^(m x + b) con a constante
          if (!hasVar(n.a, v)) {
            const L = lin(n.b, v);
            if (L && L.m !== 0) return OP('/', n, OP('*', N(L.m), FN('ln', n.a)));
          }
          return null;
        }
        return null;
      }

      /* ---------- impresión ---------- */
      const PR = { '+': 1, '-': 1, '*': 2, '/': 2, '^': 3 };
      function num2s(v) {
        if (Math.abs(v - Math.round(v)) < 1e-10) v = Math.round(v);
        return String(Number(v.toFixed(6)));
      }
      function str(n, parent, right) {
        if (n.t === 'n') return num2s(n.v);
        if (n.t === 'v') return n.n;
        if (n.t === 'f') return n.f + '(' + str(n.a) + ')';
        const p = PR[n.o];
        const negOf = (m) => m.t === 'n' && m.v < 0 ? N(-m.v)
          : (m.t === 'o' && m.o === '*' && m.a.t === 'n' && m.a.v === -1) ? m.b
          : (m.t === 'o' && m.o === '*' && m.a.t === 'n' && m.a.v < 0) ? OP('*', N(-m.a.v), m.b)
          : (m.t === 'o' && m.o === '/' && m.a.t === 'n' && m.a.v < 0) ? OP('/', N(-m.a.v), m.b) : null;
        let s;
        if (n.o === '*' && n.a.t === 'n' && n.a.v === -1) s = '-' + str(n.b, '*', true);
        else if (n.o === '+' && negOf(n.b)) s = str(n.a, '-', false) + ' - ' + str(negOf(n.b), '-', true);
        else s = str(n.a, n.o, false) + ' ' + (n.o === '*' ? '·' : n.o) + ' ' + str(n.b, n.o, true);
        if (n.o === '^') s = str(n.a, '^', false) + '^' + str(n.b, '^', true);
        if (!parent) return s;
        const pp = PR[parent];
        if (p < pp || (p === pp && right && (parent === '-' || parent === '/' || parent === '^'))) return '(' + s + ')';
        return s;
      }

      /* ---------- utilidades numéricas ---------- */
      /** Redondea a entero lo que esté a menos de 1e-10, y mata el "-0". */
      function snap(v) {
        if (!isFinite(v)) return v;
        const r = Math.round(v);
        if (Math.abs(v - r) < 1e-10) v = r;
        return v === 0 ? 0 : v;
      }
      function simpson(fn, a, b, m) {
        m = m || 800; if (m % 2) m++;
        const h = (b - a) / m;
        let s = 0;
        for (let k = 0; k <= m; k++) {
          const y = fn(a + k * h);
          if (!isFinite(y)) throw new Error('La función no es continua en el intervalo');
          s += (k === 0 || k === m ? 1 : k % 2 ? 4 : 2) * y;
        }
        return (s * h) / 3;
      }
      function bisect(f, a, b) {
        let fa = f(a);
        for (let k = 0; k < 70; k++) {
          const m = (a + b) / 2, fm = f(m);
          if (Math.abs(fm) < 1e-10) return m;
          if (fa * fm <= 0) b = m; else { a = m; fa = fm; }
        }
        return (a + b) / 2;
      }
      /** Ceros de f en [min,max] — mismo barrido que la fórmula original. */
      function scanRoots(f, min, max) {
        const out = [];
        let a = min, fa = f(a);
        for (let k = 1; k <= 1600; k++) {
          const b = min + ((max - min) * k) / 1600, fb = f(b);
          if (isFinite(fa) && isFinite(fb) && fa * fb < 0) {
            const r = bisect(f, a, b);
            if (!out.some((v) => Math.abs(v - r) < 1e-4)) out.push(r);
          }
          if (Math.abs(fb) < 1e-6 && !out.some((v) => Math.abs(v - b) < 1e-3)) out.push(b);
          a = b; fa = fb;
        }
        return out;
      }

      return { parse: parse, ev: ev, der: der, simp: simp, anti: anti, str: str,
        snap: snap, simpson: simpson, scanRoots: scanRoots, hasVar: hasVar, N: N, V: V, OP: OP };
    }

    const M = MK();

    /** Ninguna rama es plata: TODA fila declara su formato explícito. */
    const P0 = { format: 'plain', decimals: 0 };
    const P2 = { format: 'plain', decimals: 2 };
    const P4 = { format: 'plain', decimals: 4 };
    const P6 = { format: 'plain', decimals: 6 };
    const U2 = { format: 'unit', unit: 'u²', decimals: 4 };

    const snap = M.snap;
    const fmt = (n) => {
      if (n === undefined || n === null || !isFinite(n)) return n === Infinity ? '+∞' : n === -Infinity ? '−∞' : '—';
      n = snap(n);
      const abs = Math.abs(n);
      const dec = abs >= 1000 ? 0 : abs >= 1 ? 2 : 4;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };

    const err = (msg) => ({
      total: '—', sub: msg,
      rows: [{ k: 'Revisá los datos y volvé a calcular', v: 0, ...P2 }],
      chart: [], format: 'plain', decimals: 2,
    });

    const coefs = (s) => String(s || '').split(/[;,\s]+/).filter(Boolean).map(Number);
    const polyAt = (c, x) => c.reduce((a, b) => a * x + b, 0);
    /** Texto del polinomio a partir de sus coeficientes. */
    const polyTxt = (c) => {
      const d = c.length - 1;
      const s = c.map((a, k) => ({ a: a, p: d - k })).filter((t) => Math.abs(t.a) > 1e-12)
        .map((t, k) => (k && t.a > 0 ? ' + ' : k ? ' − ' : t.a < 0 ? '−' : '') +
          (Math.abs(t.a) === 1 && t.p ? '' : fmt(Math.abs(t.a))) + (t.p ? 'x' : '') + (t.p > 1 ? '^' + t.p : ''))
        .join('');
      return s || '0';
    };
    /** División de polinomios: devuelve cociente y resto. */
    const divide = (a, b) => {
      const q = new Array(Math.max(1, a.length - b.length + 1)).fill(0);
      const r = a.slice();
      for (let i = 0; i <= a.length - b.length; i++) {
        const f = r[i] / b[0];
        q[i] = f;
        for (let j = 0; j < b.length; j++) r[i + j] -= f * b[j];
      }
      return { q: q.map((x) => (Math.abs(x) < 1e-10 ? 0 : x)), r: r.slice(q.length) };
    };
    /** Raíces reales: exactas hasta grado 2, barrido numérico de ahí en más. */
    const realRoots = (c) => {
      const d = c.length - 1;
      if (d === 1) return [-c[1] / c[0]];
      if (d === 2) {
        const disc = c[1] * c[1] - 4 * c[0] * c[2];
        if (disc < 0) return [];
        const s = Math.sqrt(disc);
        return disc === 0 ? [-c[1] / (2 * c[0])] : [(-c[1] - s) / (2 * c[0]), (-c[1] + s) / (2 * c[0])].sort((p, q) => p - q);
      }
      return M.scanRoots((x) => polyAt(c, x), -100, 100).map((x) => snap(Number(x.toFixed(8))));
    };

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'limite';
      try {
        // ---- 1) Límite en un punto o en el infinito ---------------------
        if (id === 'limite') {
          const f = M.parse(v.funcion);
          const raw = String(v.punto || '0').toLowerCase();
          const inf = /inf|∞/.test(raw);
          const neg = /^\s*-|menos/.test(raw);
          const a = inf ? (neg ? -1e7 : 1e7) : H.num(v.punto);
          const at = (x) => M.ev(f, { x: x });
          const direct = at(a);
          const h = inf ? Math.abs(a) * 1e-3 : 1e-6;
          const left = at(a - h), right = at(a + h);
          // En el infinito todo es aproximación: redondeamos a 6 decimales para
          // no mostrar "0,50000015" donde el límite vale exactamente 1/2.
          const round = (x) => snap(Number(x.toFixed(inf ? 6 : 10)));

          // L'Hôpital: sólo para 0/0 e ∞/∞, derivando arriba y abajo por separado.
          let lh = null, veces = 0, lhTxt = '';
          if (f.t === 'o' && f.o === '/') {
            let nu = f.a, de = f.b;
            for (let k = 0; k < 6; k++) {
              const nv = M.ev(nu, { x: a }), dv = M.ev(de, { x: a });
              const cero = Math.abs(nv) < 1e-9 && Math.abs(dv) < 1e-9;
              const infs = (!isFinite(nv) || Math.abs(nv) > 1e8) && (!isFinite(dv) || Math.abs(dv) > 1e8);
              if (!cero && !infs) break;
              nu = M.der(nu, 'x'); de = M.der(de, 'x');
              veces++;
              const r = M.ev(nu, { x: a }) / M.ev(de, { x: a });
              if (isFinite(r)) { lh = round(r); lhTxt = M.str(M.simp(nu)) + '  ÷  ' + M.str(M.simp(de)); }
            }
          }

          const coinciden = isFinite(left) && isFinite(right) && Math.abs(left - right) < 1e-4;
          let res, nota;
          if (lh !== null) { res = lh; nota = "resuelto con L'Hôpital aplicada " + veces + (veces === 1 ? ' vez' : ' veces'); }
          else if (isFinite(direct)) { res = round(direct); nota = 'salió por sustitución directa'; }
          else if (coinciden) { res = round((left + right) / 2); nota = 'los dos laterales coinciden'; }
          else if (Math.abs(left) > 1e8 && Math.abs(right) > 1e8 && left * right > 0) { res = left > 0 ? Infinity : -Infinity; nota = 'la función se va al infinito por los dos lados'; }
          else { res = NaN; nota = 'los laterales no coinciden: el límite bilateral NO existe'; }

          const rows = [
            { k: 'Sustitución directa: f(' + (inf ? (neg ? '−∞' : '+∞') : fmt(a)) + ')', ref: !isFinite(direct) ? 'dio una indeterminación: hay que trabajar más' : inf ? 'evaluada en x = ±10⁷, así que es una aproximación' : 'dio un número, sirve como límite', v: isFinite(direct) ? round(direct) : 0, ...P4 },
          ];
          if (f.t === 'o' && f.o === '/') {
            rows.push({ k: 'Numerador evaluado en el punto', ref: M.str(f.a), v: snap(M.ev(f.a, { x: a })), ...P4 });
            rows.push({ k: 'Denominador evaluado en el punto', ref: M.str(f.b), v: snap(M.ev(f.b, { x: a })), ...P4 });
          }
          if (lh !== null) {
            rows.push({ k: "L'Hôpital aplicada " + veces + (veces === 1 ? ' vez' : ' veces'), ref: 'se derivó arriba y abajo por separado: ' + lhTxt, v: lh, extra: true, ...P4 });
          }
          rows.push({ k: 'Límite por izquierda', ref: 'evaluada en x = punto − h', v: isFinite(left) ? snap(Number(left.toFixed(6))) : (left > 0 ? Infinity : -Infinity), ...P4 });
          rows.push({ k: 'Límite por derecha', ref: 'evaluada en x = punto + h', v: isFinite(right) ? snap(Number(right.toFixed(6))) : (right > 0 ? Infinity : -Infinity), ...P4 });
          rows.push({ k: 'Verificación: diferencia entre los dos laterales', ref: 'si no es casi 0, el límite no existe', v: isFinite(left) && isFinite(right) ? Math.abs(left - right) : Infinity, ...P6 });

          return {
            total: isNaN(res) ? 'No existe' : fmt(res),
            sub: 'lím ' + M.str(f) + ' cuando x → ' + (inf ? (neg ? '−∞' : '+∞') : fmt(a)) + ' · ' + nota,
            rows: rows,
            format: 'plain', decimals: 4,
            chart: [
              { label: 'Por izquierda: ' + fmt(left), value: Math.min(1e9, Math.abs(isFinite(left) ? left : 0)), tone: 'prop' },
              { label: 'Por derecha: ' + fmt(right), value: Math.min(1e9, Math.abs(isFinite(right) ? right : 0)), tone: 'good' },
              { label: 'Límite: ' + (isNaN(res) ? 'no existe' : fmt(res)), value: Math.min(1e9, Math.abs(isFinite(res) ? res : 0)), tone: isNaN(res) ? 'warn' : 'main' },
            ],
          };
        }

        // ---- 2) Dominio y rango ------------------------------------------
        if (id === 'dominio') {
          const f = M.parse(v.funcion);
          const src = String(v.funcion || '');
          const restric = [];
          if (/\//.test(src)) restric.push('denominador ≠ 0');
          if (/sqrt\s*\(/i.test(src)) restric.push('radicando ≥ 0');
          if (/\b(ln|log)\s*\(/i.test(src)) restric.push('argumento del logaritmo > 0');
          const ys = [], huecos = [];
          for (let k = 0; k <= 4000; k++) {
            const x = -100 + (200 * k) / 4000;
            const y = M.ev(f, { x: x });
            if (isFinite(y)) ys.push(y); else if (huecos.length < 40) huecos.push(x);
          }
          if (!ys.length) return err('No encontré ningún valor real de la función en x ∈ [−100, 100]. Revisá la expresión.');
          const mn = snap(Math.min.apply(null, ys)), mx = snap(Math.max.apply(null, ys));
          const en0 = M.ev(f, { x: 0 });
          return {
            total: '[' + fmt(mn) + ' ; ' + fmt(mx) + ']',
            sub: 'f(x) = ' + M.str(f) + ' · dominio: los reales' + (restric.length ? ' con ' + restric.join(' y ') : ' sin restricciones algebraicas') +
              ' · rango estimado barriendo x ∈ [−100, 100]',
            rows: [
              { k: 'Restricciones de dominio detectadas', ref: restric.length ? restric.join(' · ') : 'ninguna: polinomio o exponencial', v: restric.length, ...P0 },
              { k: 'Puntos del barrido donde la función NO está definida', ref: 'de 4.001 puntos explorados entre −100 y 100', v: huecos.length, ...P0 },
              { k: 'Valor mínimo alcanzado en el barrido', ref: 'piso del rango estimado', v: mn, extra: true, ...P4 },
              { k: 'Valor máximo alcanzado en el barrido', ref: 'techo del rango estimado', v: mx, extra: true, ...P4 },
              { k: 'Amplitud del rango (máximo − mínimo)', ref: 'cuánto abarca la imagen', v: snap(mx - mn), ...P4 },
              { k: 'f(0) — la función en el origen', ref: isFinite(en0) ? 'el 0 está en el dominio' : 'el 0 NO está en el dominio', v: isFinite(en0) ? snap(en0) : 0, ...P4 },
            ],
            format: 'plain', decimals: 4,
            chart: [
              { label: 'Mínimo: ' + fmt(mn), value: Math.abs(mn) || 0.0001, tone: 'prop' },
              { label: 'Máximo: ' + fmt(mx), value: Math.abs(mx) || 0.0001, tone: 'main' },
            ],
          };
        }

        // ---- 3) Asíntotas de una función racional ------------------------
        if (id === 'asintotas') {
          const nu = coefs(v.numerador), de = coefs(v.denominador);
          if (nu.length < 1 || de.length < 2 || nu.some((x) => !isFinite(x)) || de.some((x) => !isFinite(x)) || de[0] === 0) {
            return err('Cargá los coeficientes del numerador y del denominador, del mayor grado al independiente. El denominador tiene que ser al menos de grado 1.');
          }
          const gn = nu.length - 1, gd = de.length - 1;
          const rr = realRoots(de);
          const huecos = rr.filter((x) => Math.abs(polyAt(nu, x)) < 1e-6);
          const vert = rr.filter((x) => Math.abs(polyAt(nu, x)) >= 1e-6);
          const dif = gn - gd;
          let tipo, hy = 0, m = 0, b = 0;
          if (dif < 0) { tipo = 'horizontal y = 0'; hy = 0; }
          else if (dif === 0) { hy = nu[0] / de[0]; tipo = 'horizontal y = ' + fmt(hy); }
          else if (dif === 1) { const q = divide(nu, de); m = q.q[0]; b = q.q[1] || 0; tipo = 'oblicua y = ' + polyTxt(q.q); }
          else tipo = 'ninguna recta: la rama crece como un polinomio de grado ' + dif;
          const rows = [
            { k: 'Grado del numerador', ref: polyTxt(nu), v: gn, ...P0 },
            { k: 'Grado del denominador', ref: polyTxt(de), v: gd, ...P0 },
            { k: 'Diferencia de grados — es la que decide', ref: 'menor a 0 → y = 0 · igual a 0 → horizontal · igual a 1 → oblicua', v: dif, extra: true, ...P0 },
            { k: 'Asíntotas verticales encontradas', ref: vert.length ? 'en x = ' + vert.map(fmt).join(', ') : 'el denominador no tiene raíces reales', v: vert.length, ...P0 },
            { k: 'Huecos (discontinuidades evitables)', ref: huecos.length ? 'en x = ' + huecos.map(fmt).join(', ') + ': ahí se anulan los dos' : 'ninguno: ninguna raíz anula también al numerador', v: huecos.length, ...P0 },
          ];
          if (dif <= 0) rows.push({ k: 'Altura de la asíntota horizontal (y =)', ref: dif === 0 ? 'cociente de los coeficientes principales' : 'el denominador crece más rápido', v: snap(hy), extra: true, ...P4 });
          if (dif === 1) {
            rows.push({ k: 'Pendiente m de la asíntota oblicua', ref: 'primer término del cociente de la división', v: snap(m), extra: true, ...P4 });
            rows.push({ k: 'Ordenada al origen b de la oblicua', ref: 'segundo término del cociente', v: snap(b), ...P4 });
          }
          if (vert.length) rows.push({ k: 'Verificación: el denominador en la primera vertical', ref: 'tiene que dar 0', v: snap(Number(polyAt(de, vert[0]).toFixed(8))), ...P6 });
          return {
            total: dif === 1 ? 'y = ' + polyTxt(divide(nu, de).q) : dif <= 0 ? 'y = ' + fmt(hy) : 'sin asíntota recta',
            sub: 'Comportamiento en el infinito: ' + tipo + ' · verticales: ' + (vert.length ? 'x = ' + vert.map(fmt).join(', ') : 'ninguna'),
            rows: rows,
            format: 'plain', decimals: 4,
            chart: [
              { label: 'Grado del numerador: ' + gn, value: Math.max(gn, 0.0001), tone: 'prop' },
              { label: 'Grado del denominador: ' + gd, value: Math.max(gd, 0.0001), tone: 'main' },
              { label: 'Asíntotas verticales: ' + vert.length, value: Math.max(vert.length, 0.0001), tone: 'good' },
            ],
          };
        }

        // ---- 4) Integral definida (Barrow) -------------------------------
        if (id === 'integral') {
          const f = M.parse(v.funcion);
          const a = H.num(v.desde), b = H.num(v.hasta);
          if (a === b) return err('Los dos límites de integración son iguales: la integral vale 0 por definición.');
          const at = (x) => M.ev(f, { x: x });
          const F = M.anti(f, 'x');
          let barrow = null, Fb = null, Fa = null;
          if (F) {
            Fb = M.ev(F, { x: b }); Fa = M.ev(F, { x: a });
            if (isFinite(Fb) && isFinite(Fa)) barrow = snap(Number((Fb - Fa).toFixed(8)));
          }
          const simp = snap(Number(M.simpson(at, Math.min(a, b), Math.max(a, b)).toFixed(8))) * (b < a ? -1 : 1);
          // Partición por signo: cuánto suma lo de arriba del eje y cuánto resta lo de abajo.
          const lo = Math.min(a, b), hi = Math.max(a, b);
          const cortes = [lo].concat(M.scanRoots(at, lo, hi).filter((x) => x > lo + 1e-9 && x < hi - 1e-9)).concat([hi]).sort((p, q) => p - q);
          let arriba = 0, abajo = 0;
          for (let k = 0; k < cortes.length - 1; k++) {
            const s = M.simpson(at, cortes[k], cortes[k + 1], 200);
            if (s >= 0) arriba += s; else abajo += -s;
          }
          const res = barrow !== null ? barrow : simp;
          const rows = [];
          if (F) {
            rows.push({ k: 'Primitiva F(x) evaluada en el límite superior', ref: 'F(x) = ' + M.str(M.simp(F)), v: snap(Number(Fb.toFixed(8))), ...P4 });
            rows.push({ k: 'Primitiva F(x) evaluada en el límite inferior', ref: 'la constante C se cancela en la resta', v: snap(Number(Fa.toFixed(8))), ...P4 });
            rows.push({ k: 'F(b) − F(a) → la integral por la regla de Barrow', ref: 'teorema fundamental del cálculo', v: barrow, extra: true, ...P4 });
          } else {
            rows.push({ k: 'Primitiva elemental', ref: 'no la encontré para esta función: se resuelve por método numérico', v: 0, ...P0 });
          }
          rows.push({ k: 'Método numérico de Simpson', ref: F ? 'camino independiente para controlar Barrow' : 'el resultado sale por acá', v: simp, extra: !F, ...P4 });
          if (F) rows.push({ k: 'Verificación: diferencia entre Barrow y Simpson', ref: 'si no es casi 0, hay algo raro en el intervalo', v: Math.abs(barrow - simp), ...P6 });
          rows.push({ k: 'Área por encima del eje x (suma)', ref: 'los tramos donde f(x) > 0', v: snap(Number(arriba.toFixed(6))), ...U2 });
          rows.push({ k: 'Área por debajo del eje x (resta)', ref: 'los tramos donde f(x) < 0', v: snap(Number(abajo.toFixed(6))), ...U2 });
          rows.push({ k: 'Área geométrica total (sin signo)', ref: 'lo que medirías con una regla, no lo que da la integral', v: snap(Number((arriba + abajo).toFixed(6))), ...U2 });
          return {
            total: fmt(res),
            sub: '∫ ' + M.str(f) + ' dx entre ' + fmt(a) + ' y ' + fmt(b) + ' = ' + fmt(res) +
              (Math.abs(arriba + abajo - Math.abs(res)) > 1e-4 ? ' · ojo: el área neta no coincide con la geométrica porque la curva cruza el eje' : ''),
            rows: rows,
            format: 'plain', decimals: 4,
            chart: [
              { label: 'Área sobre el eje: ' + fmt(arriba), value: arriba, tone: 'main' },
              { label: 'Área bajo el eje: ' + fmt(abajo), value: abajo, tone: 'warn' },
            ],
          };
        }

        // ---- 5) Área entre dos curvas ------------------------------------
        const f = M.parse(v.funcion);
        const g = M.parse(v.funcion2);
        const a = H.num(v.desde), b = H.num(v.hasta);
        if (!(b > a)) return err('El límite superior tiene que ser mayor que el inferior.');
        const dif = (x) => M.ev(f, { x: x }) - M.ev(g, { x: x });
        const cruces = M.scanRoots(dif, a, b).filter((x) => x > a + 1e-6 && x < b - 1e-6).map((x) => snap(Number(x.toFixed(8))));
        const cortes = [a].concat(cruces).concat([b]).sort((p, q) => p - q);
        let area = 0, firmada = 0;
        const tramos = [];
        for (let k = 0; k < cortes.length - 1; k++) {
          const s = M.simpson(dif, cortes[k], cortes[k + 1]);
          area += Math.abs(s); firmada += s;
          tramos.push({ x1: cortes[k], x2: cortes[k + 1], s: s });
        }
        const rows = [
          { k: 'Cruces entre las dos curvas dentro del intervalo', ref: cruces.length ? 'en x = ' + cruces.map(fmt).join(', ') + ': ahí hay que cortar' : 'ninguno: la diferencia no cambia de signo', v: cruces.length, ...P0 },
        ];
        tramos.slice(0, 5).forEach((t, k) => {
          rows.push({
            k: 'Tramo ' + (k + 1) + ': de x = ' + fmt(t.x1) + ' a x = ' + fmt(t.x2),
            ref: (t.s >= 0 ? 'acá f(x) va por arriba de g(x)' : 'acá g(x) va por arriba de f(x)') + ' — se toma el valor absoluto',
            v: snap(Number(Math.abs(t.s).toFixed(6))), ...U2,
          });
        });
        rows.push({ k: 'Área total entre las curvas', ref: 'suma de los valores absolutos de cada tramo', v: snap(Number(area.toFixed(6))), extra: true, ...U2 });
        rows.push({ k: 'Integral firmada sin cortar en los cruces', ref: 'el error clásico: los tramos se cancelan entre sí', v: snap(Number(firmada.toFixed(6))), ...P4 });
        rows.push({ k: 'Verificación: cuánto se habría perdido sin cortar', ref: 'si da 0, no hacía falta partir el intervalo', v: snap(Number((area - Math.abs(firmada)).toFixed(6))), ...U2 });
        return {
          total: fmt(area),
          sub: 'Área entre ' + M.str(f) + ' y ' + M.str(g) + ' de ' + fmt(a) + ' a ' + fmt(b) + ' = ' + fmt(area) +
            ' · ' + tramos.length + (tramos.length === 1 ? ' tramo' : ' tramos'),
          rows: rows,
          format: 'plain', decimals: 4, unit: 'u²',
          chart: tramos.slice(0, 6).map((t, k) => ({
            label: 'Tramo ' + (k + 1) + ' [' + fmt(t.x1) + ', ' + fmt(t.x2) + ']: ' + fmt(Math.abs(t.s)),
            value: Math.abs(t.s) || 0.0001,
            tone: k === 0 ? 'main' : t.s >= 0 ? 'prop' : 'good',
          })),
        };
      } catch (e) {
        return err('No pude resolverlo: ' + (e && e.message ? e.message : 'revisá la expresión, los paréntesis y el intervalo') + '.');
      }
    });
  })();
</script>
