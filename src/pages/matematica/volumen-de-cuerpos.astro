---
/**
 * Hub de decisión — "¿Cuánto volumen tiene este cuerpo?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de matematica/regla-de-tres.astro: la página sólo aporta los
 * datos (src/lib/hubs/volumen-de-cuerpos.ts) y su compute(). El chrome, el CSS
 * y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VolumenCuerposExperience from '../../components/generated/VolumenCuerposExperience.astro';
import { hub } from '../../lib/hubs/volumen-de-cuerpos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <VolumenCuerposExperience data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * No hay plata en ninguna rama y el default de HubRow es 'ars'. Toda fila
     * declara su formato: 'unit' con la unidad real (cm, cm³, L, m²…) o
     * 'plain' para factores adimensionales.
     */
    const PLAIN = { format: 'plain', decimals: 2 };
    const LITROS = { format: 'unit', unit: 'L', decimals: 2 };

    /**
     * Redondeo anti ruido de punto flotante: si el número quedó a menos de
     * 1e-10 de un entero, es ese entero. Sin esto una caja de 10×10×10 puede
     * devolver 999,9999999999.
     */
    const S = (n) => (isFinite(n) && Math.abs(n - Math.round(n)) < 1e-10 ? Math.round(n) : n);

    const fmt = (n) => {
      if (!isFinite(n)) return '—';
      const abs = Math.abs(n);
      const dec = abs >= 1000 ? 0 : abs >= 1 ? 2 : 4;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };

    const err = (msg, k, v) => ({
      total: '—',
      sub: msg,
      rows: [{ k: k, v: v, ...PLAIN }],
      chart: [],
      format: 'plain',
      decimals: 2,
    });

    H.onCompute(function (v, kase) {
      const a = H.num(v.a);
      const b = H.num(v.b);
      const h = H.num(v.h);
      const uni = String(v.unidad || 'cm') === 'm' ? 'm' : 'cm';
      const id = (kase && kase.id) || 'caja';

      // Unidades derivadas y conversión a litros.
      // 1.000 cm³ = 1 dm³ = 1 L · 1 m³ = 1.000 L
      const U = { format: 'unit', unit: uni, decimals: 2 };
      const U2 = { format: 'unit', unit: uni + '²', decimals: 2 };
      const U3 = { format: 'unit', unit: uni + '³', decimals: 2 };
      const aLitros = (vol) => (uni === 'cm' ? vol / 1000 : vol * 1000);
      const factorTxt = uni === 'cm' ? '÷ 1.000 (1.000 cm³ = 1 L)' : '× 1.000 (1 m³ = 1.000 L)';

      // ---- 1) PRISMA RECTANGULAR (caja) ---------------------------------
      // V = l·a·h · S = 2(la + lh + ah) · D = √(l² + a² + h²)
      if (id === 'caja') {
        if (a <= 0 || b <= 0 || h <= 0) return err('Cargá largo, ancho y alto con valores mayores que cero (campos A, B y H).', 'Medida más chica', Math.min(a, b, h));
        const vol = S(a * b * h);
        const sup = S(2 * (a * b + a * h + b * h));
        const diag = S(Math.sqrt(a * a + b * b + h * h));
        const lit = S(aLitros(vol));
        return {
          total: fmt(vol) + ' ' + uni + '³',
          sub:
            'Caja de ' + fmt(a) + ' × ' + fmt(b) + ' × ' + fmt(h) + ' ' + uni + ': ' + fmt(vol) + ' ' + uni +
            '³ = ' + fmt(lit) + ' litros de capacidad · superficie ' + fmt(sup) + ' ' + uni + '²',
          rows: [
            { k: 'Largo (campo A)', v: a, ...U },
            { k: 'Ancho (campo B)', v: b, ...U },
            { k: 'Alto (campo H)', v: h, ...U },
            { k: 'Largo × ancho → área de la base', ref: 'paso 1', v: S(a * b), ...U2 },
            { k: 'Base × alto → volumen', ref: 'paso 2: el resultado', v: vol, extra: true, ...U3 },
            { k: 'Capacidad en litros', ref: factorTxt, v: lit, extra: true, ...LITROS },
            { k: 'Superficie total = 2·(la + lh + ah)', ref: 'las seis caras', v: sup, ...U2 },
            { k: 'Diagonal interna = √(l² + a² + h²)', ref: 'lo más largo que entra', v: diag, ...U },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Volumen (' + uni + '³) = ' + fmt(vol), value: Math.abs(vol), tone: 'main' },
            { label: 'Superficie (' + uni + '²) = ' + fmt(sup), value: Math.abs(sup), tone: 'prop' },
          ],
        };
      }

      // ---- 2) CILINDRO ---------------------------------------------------
      // V = π·r²·h · S = 2·π·r·(r + h)
      if (id === 'cilindro') {
        const r = a;
        if (r <= 0 || h <= 0) return err('Cargá el radio (campo A) y la altura (campo H) con valores mayores que cero.', 'Radio', r);
        const base = S(Math.PI * r * r);
        const vol = S(base * h);
        const lateral = S(2 * Math.PI * r * h);
        const sup = S(2 * Math.PI * r * (r + h));
        const lit = S(aLitros(vol));
        return {
          total: fmt(vol) + ' ' + uni + '³',
          sub:
            'Cilindro de radio ' + fmt(r) + ' y altura ' + fmt(h) + ' ' + uni + ': ' + fmt(vol) + ' ' + uni +
            '³ = ' + fmt(lit) + ' litros · superficie total ' + fmt(sup) + ' ' + uni + '²',
          rows: [
            { k: 'Radio (campo A)', v: r, ...U },
            { k: 'Altura (campo H)', v: h, ...U },
            { k: 'Diámetro = 2 × r', ref: 'dato derivado', v: S(2 * r), ...U },
            { k: 'Área de la base = π · r²', ref: 'paso 1', v: base, ...U2 },
            { k: 'Base × altura → volumen', ref: 'paso 2: el resultado', v: vol, extra: true, ...U3 },
            { k: 'Capacidad en litros', ref: factorTxt, v: lit, extra: true, ...LITROS },
            { k: 'Superficie lateral = 2·π·r·h', ref: 'el rectángulo desenrollado', v: lateral, ...U2 },
            { k: 'Superficie total = 2·π·r·(r + h)', ref: 'lateral + las dos tapas', v: sup, ...U2 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Volumen (' + uni + '³) = ' + fmt(vol), value: Math.abs(vol), tone: 'main' },
            { label: 'Superficie total (' + uni + '²) = ' + fmt(sup), value: Math.abs(sup), tone: 'prop' },
            { label: 'Sólo el lateral (' + uni + '²)', value: Math.abs(lateral), tone: 'good' },
          ],
        };
      }

      // ---- 3) CONO --------------------------------------------------------
      // V = (1/3)·π·r²·h · g = √(r² + h²) · S = π·r·(r + g)
      if (id === 'cono') {
        const r = a;
        if (r <= 0 || h <= 0) return err('Cargá el radio (campo A) y la altura (campo H) con valores mayores que cero.', 'Radio', r);
        const base = S(Math.PI * r * r);
        const volCil = S(base * h);
        const vol = S(volCil / 3);
        const g = S(Math.sqrt(r * r + h * h));
        const lateral = S(Math.PI * r * g);
        const sup = S(Math.PI * r * (r + g));
        const lit = S(aLitros(vol));
        return {
          total: fmt(vol) + ' ' + uni + '³',
          sub:
            'Cono de radio ' + fmt(r) + ' y altura ' + fmt(h) + ' ' + uni + ': ' + fmt(vol) + ' ' + uni +
            '³ = ' + fmt(lit) + ' litros · generatriz ' + fmt(g) + ' ' + uni,
          rows: [
            { k: 'Radio (campo A)', v: r, ...U },
            { k: 'Altura (campo H)', ref: 'la vertical, no la inclinada', v: h, ...U },
            { k: 'Área de la base = π · r²', ref: 'paso 1', v: base, ...U2 },
            { k: 'Volumen del cilindro de igual base y altura', ref: 'paso 2: la referencia', v: volCil, ...U3 },
            { k: 'Dividido 3 → volumen del cono', ref: 'paso 3: el resultado', v: vol, extra: true, ...U3 },
            { k: 'Capacidad en litros', ref: factorTxt, v: lit, extra: true, ...LITROS },
            { k: 'Generatriz = √(r² + h²)', ref: 'Pitágoras sobre el lado inclinado', v: g, ...U },
            { k: 'Superficie lateral = π · r · g', ref: 'la cara curva', v: lateral, ...U2 },
            { k: 'Superficie total = π · r · (r + g)', ref: 'lateral + base', v: sup, ...U2 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Volumen del cono (' + uni + '³)', value: Math.abs(vol), tone: 'main' },
            { label: 'Los otros dos tercios del cilindro', value: Math.max(0, volCil - vol), tone: 'prop' },
          ],
        };
      }

      // ---- 4) ESFERA -------------------------------------------------------
      // V = (4/3)·π·r³ · S = 4·π·r²
      if (id === 'esfera') {
        const r = a;
        if (r <= 0) return err('Cargá el radio de la esfera en el campo A (mayor que cero).', 'Radio', r);
        const vol = S((4 / 3) * Math.PI * r * r * r);
        const sup = S(4 * Math.PI * r * r);
        const lit = S(aLitros(vol));
        return {
          total: fmt(vol) + ' ' + uni + '³',
          sub:
            'Esfera de radio ' + fmt(r) + ' ' + uni + ': volumen ' + fmt(vol) + ' ' + uni + '³ = ' + fmt(lit) +
            ' litros y superficie ' + fmt(sup) + ' ' + uni + '²',
          rows: [
            { k: 'Radio (campo A)', v: r, ...U },
            { k: 'Diámetro = 2 × r', ref: 'dato derivado', v: S(2 * r), ...U },
            { k: 'r³ — el radio al cubo', ref: 'paso 1', v: S(r * r * r), ...PLAIN },
            { k: '(4/3) × π × r³ → volumen', ref: 'paso 2: el resultado', v: vol, extra: true, ...U3 },
            { k: 'Capacidad en litros', ref: factorTxt, v: lit, extra: true, ...LITROS },
            { k: '4 × π × r² → superficie', ref: 'cuatro veces el área del círculo', v: sup, extra: true, ...U2 },
            { k: 'Verificación: 3 × volumen ÷ radio (tiene que dar la superficie)', ref: 'chequeo', v: S((3 * vol) / r), ...U2 },
          ],
          format: 'plain',
          decimals: 2,
          chart: [
            { label: 'Volumen (' + uni + '³) = ' + fmt(vol), value: Math.abs(vol), tone: 'main' },
            { label: 'Superficie (' + uni + '²) = ' + fmt(sup), value: Math.abs(sup), tone: 'prop' },
          ],
        };
      }

      // ---- 5) PIRÁMIDE de base rectangular o cuadrada ----------------------
      // V = (área base · h)/3 · apotemas laterales por Pitágoras
      const largo = a;
      const ancho = b > 0 ? b : a; // base cuadrada si el campo B queda en 0
      if (largo <= 0 || h <= 0) return err('Cargá el lado de la base (campo A) y la altura (campo H) con valores mayores que cero.', 'Lado de la base', largo);
      const areaBase = S(largo * ancho);
      const volPrisma = S(areaBase * h);
      const volPir = S(volPrisma / 3);
      const ap1 = S(Math.sqrt(h * h + (ancho / 2) * (ancho / 2))); // caras apoyadas en el lado "largo"
      const ap2 = S(Math.sqrt(h * h + (largo / 2) * (largo / 2))); // caras apoyadas en el lado "ancho"
      const lateral = S(largo * ap1 + ancho * ap2);
      const supTotal = S(areaBase + lateral);
      const litPir = S(aLitros(volPir));
      const esCuadrada = Math.abs(largo - ancho) < 1e-12;
      return {
        total: fmt(volPir) + ' ' + uni + '³',
        sub:
          'Pirámide de base ' + (esCuadrada ? 'cuadrada de lado ' + fmt(largo) : fmt(largo) + ' × ' + fmt(ancho)) +
          ' y altura ' + fmt(h) + ' ' + uni + ': volumen ' + fmt(volPir) + ' ' + uni + '³ · superficie total ' +
          fmt(supTotal) + ' ' + uni + '²',
        rows: [
          { k: 'Largo de la base (campo A)', v: largo, ...U },
          { k: esCuadrada ? 'Ancho de la base (igual al largo: base cuadrada)' : 'Ancho de la base (campo B)', v: ancho, ...U },
          { k: 'Altura (campo H)', ref: 'del vértice al centro de la base', v: h, ...U },
          { k: 'Área de la base = largo × ancho', ref: 'paso 1', v: areaBase, ...U2 },
          { k: 'Volumen del prisma de igual base y altura', ref: 'paso 2: la referencia', v: volPrisma, ...U3 },
          { k: 'Dividido 3 → volumen de la pirámide', ref: 'paso 3: el resultado', v: volPir, extra: true, ...U3 },
          { k: 'Capacidad en litros', ref: factorTxt, v: litPir, ...LITROS },
          { k: 'Apotema lateral 1 = √(h² + (ancho/2)²)', ref: 'altura de las caras sobre el largo', v: ap1, ...U },
          { k: 'Apotema lateral 2 = √(h² + (largo/2)²)', ref: 'altura de las caras sobre el ancho', v: ap2, ...U },
          { k: 'Superficie lateral = largo·ap1 + ancho·ap2', ref: 'las cuatro caras triangulares', v: lateral, ...U2 },
          { k: 'Superficie total = base + caras', ref: 'lo que hay que cubrir', v: supTotal, extra: true, ...U2 },
        ],
        format: 'plain',
        decimals: 2,
        chart: [
          { label: 'Volumen de la pirámide (' + uni + '³)', value: Math.abs(volPir), tone: 'main' },
          { label: 'Los otros dos tercios del prisma', value: Math.max(0, volPrisma - volPir), tone: 'prop' },
        ],
      };
    });
  })();
</script>
