---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArithmeticSteps from '../../components/hub/ArithmeticSteps.astro';
import { hub } from '../../lib/hubs/operaciones-paso-a-paso';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebApplication', name: 'División larga y multiplicación paso a paso', url: canonical, applicationCategory: 'EducationalApplication', operatingSystem: 'Web', offers: { '@type':'Offer', price: '0', priceCurrency:'USD' } },
  { '@type': 'FAQPage', mainEntity: hub.faq.map(f=>({ '@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a} })) },
  { '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem',position:1,name:'Inicio',item:'https://hacecuentas.com/' },{ '@type':'ListItem',position:2,name:'Matemática',item:'https://hacecuentas.com/matematica' },{ '@type':'ListItem',position:3,name:'Operaciones paso a paso',item:canonical }] }
] };
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="global" lang="es" articleSection={hub.silo}>
  <Header /><ArithmeticSteps /><Footer />
</Layout>
