---
/**
 * Hub de decisión — "¿Cómo sigue esta sucesión y cuánto suma?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de matematica/regla-de-tres.astro: la página sólo aporta los
 * datos (src/lib/hubs/sucesiones-y-series.ts) y su compute(). El chrome, el CSS
 * y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/sucesiones-y-series';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    // Acá no hay plata en ninguna rama y el default de HubRow es 'ars':
    // TODA fila declara su formato explícito.
    const PLAIN = { format: 'plain', decimals: 2 };
    const PLAIN0 = { format: 'plain', decimals: 0 };
    const PLAIN6 = { format: 'plain', decimals: 6 };

    /** Mata el ruido de punto flotante: 4.999999999999999 → 5, -0 → 0. */
    const snap = (n) => {
      if (!isFinite(n)) return n;
      const r = Math.round(n);
      if (Math.abs(n - r) < 1e-10) return r === 0 ? 0 : r;
      return n;
    };

    const fmt = (n) => {
      if (!isFinite(n)) return '—';
      const v = snap(n);
      const abs = Math.abs(v);
      const dec = Number.isInteger(v) ? 0 : abs >= 1000 ? 2 : abs >= 1 ? 4 : 6;
      return Number(v.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };

    const err = (msg, k, v) => ({
      total: '—',
      sub: msg,
      rows: [{ k: k, v: v, ...PLAIN }],
      chart: [],
      format: 'plain',
      decimals: 2,
    });

    /** Primeros términos, para el gráfico de barras. */
    const barras = (terms, etiqueta) =>
      terms.slice(0, 8).map((t, idx) => ({
        label: etiqueta + (idx + 1) + ' = ' + fmt(t),
        value: Math.abs(snap(t)),
        tone: idx === terms.length - 1 ? 'main' : 'prop',
      }));

    // Coeficientes de las cinco series de Maclaurin clásicas. Devuelve el
    // coeficiente del término k (el que multiplica a x^k) y el valor exacto.
    const SERIES = {
      exp: {
        nombre: 'eˣ',
        coef: (k) => {
          let f = 1;
          for (let j = 2; j <= k; j++) f *= j;
          return 1 / f;
        },
        exacto: (x) => Math.exp(x),
        general: 'xᵏ ÷ k!',
        radio: 'converge para todo x',
      },
      sin: {
        nombre: 'sen x',
        coef: (k) => {
          if (k % 2 === 0) return 0;
          let f = 1;
          for (let j = 2; j <= k; j++) f *= j;
          return (k % 4 === 1 ? 1 : -1) / f;
        },
        exacto: (x) => Math.sin(x),
        general: '(−1)ⁿ x^(2n+1) ÷ (2n+1)!',
        radio: 'converge para todo x (en radianes)',
      },
      cos: {
        nombre: 'cos x',
        coef: (k) => {
          if (k % 2 !== 0) return 0;
          let f = 1;
          for (let j = 2; j <= k; j++) f *= j;
          return (k % 4 === 0 ? 1 : -1) / f;
        },
        exacto: (x) => Math.cos(x),
        general: '(−1)ⁿ x^(2n) ÷ (2n)!',
        radio: 'converge para todo x (en radianes)',
      },
      ln1x: {
        nombre: 'ln(1 + x)',
        coef: (k) => (k === 0 ? 0 : (k % 2 === 1 ? 1 : -1) / k),
        exacto: (x) => Math.log(1 + x),
        general: '(−1)^(k+1) xᵏ ÷ k',
        radio: 'converge sólo para −1 < x ≤ 1',
      },
      geo: {
        nombre: '1 / (1 − x)',
        coef: () => 1,
        exacto: (x) => 1 / (1 - x),
        general: 'xᵏ',
        radio: 'converge sólo para |x| < 1',
      },
    };

    H.onCompute(function (v, kase) {
      const a1 = H.num(v.a1);
      const dr = H.num(v.dr);
      const nRaw = H.num(v.n);
      const x = H.num(v.x);
      const id = (kase && kase.id) || 'aritmetica';

      // ---- 1) Progresión ARITMÉTICA ------------------------------------
      // aₙ = a₁ + (n−1)·d ;  Sₙ = n·(a₁ + aₙ)/2
      if (id === 'aritmetica') {
        const n = Math.floor(nRaw);
        if (!n || n < 1) return err('n tiene que ser un entero mayor o igual a 1.', 'Valor de n', nRaw);
        if (n > 100000) return err('n demasiado grande: el máximo es 100.000 términos.', 'Valor de n', n);
        const an = snap(a1 + (n - 1) * dr);
        const sn = snap((n * (a1 + an)) / 2);
        const terms = [];
        for (let k = 0; k < Math.min(n, 8); k++) terms.push(a1 + k * dr);
        return {
          total: fmt(an),
          sub:
            'a' + n + ' = ' + fmt(a1) + ' + (' + n + ' − 1) × ' + fmt(dr) + ' = ' + fmt(an) +
            ' · la suma de los ' + n + ' primeros da ' + fmt(sn),
          rows: [
            { k: 'a₁ — primer término', v: a1, ...PLAIN },
            { k: 'd — diferencia entre términos consecutivos', v: dr, ...PLAIN },
            { k: 'n — posición y cantidad de términos', v: n, ...PLAIN0 },
            { k: 'n − 1 → cantidad de saltos', ref: 'paso 1: el error clásico es usar n', v: n - 1, ...PLAIN0 },
            { k: '(n − 1) × d', ref: 'paso 2: lo que se acumuló', v: snap((n - 1) * dr), ...PLAIN },
            { k: 'a₁ + (n − 1) × d → aₙ', ref: 'paso 3: el término general', v: an, extra: true, ...PLAIN },
            { k: 'a₁ + aₙ', ref: 'paso 4: la pareja de Gauss', v: snap(a1 + an), ...PLAIN },
            { k: 'n × (a₁ + aₙ) ÷ 2 → Sₙ', ref: 'paso 5: la suma de los n primeros', v: sn, extra: true, ...PLAIN },
            { k: 'Verificación: 2 × Sₙ ÷ n (tiene que dar a₁ + aₙ)', ref: 'el chequeo', v: n ? snap((2 * sn) / n) : 0, ...PLAIN },
          ],
          format: 'plain',
          decimals: 2,
          chart: barras(terms, 'a'),
        };
      }

      // ---- 2) Progresión GEOMÉTRICA -------------------------------------
      // aₙ = a₁·r^(n−1) ;  Sₙ = a₁·(rⁿ − 1)/(r − 1)   [r = 1 → n·a₁]
      if (id === 'geometrica') {
        const n = Math.floor(nRaw);
        const r = dr;
        if (!n || n < 1) return err('n tiene que ser un entero mayor o igual a 1.', 'Valor de n', nRaw);
        if (n > 10000) return err('n demasiado grande: el máximo es 10.000 términos.', 'Valor de n', n);
        const an = snap(a1 * Math.pow(r, n - 1));
        const rn = Math.pow(r, n);
        const sn = snap(r === 1 ? n * a1 : (a1 * (rn - 1)) / (r - 1));
        const terms = [];
        for (let k = 0; k < Math.min(n, 8); k++) terms.push(a1 * Math.pow(r, k));
        return {
          total: fmt(an),
          sub:
            'a' + n + ' = ' + fmt(a1) + ' × ' + fmt(r) + '^' + (n - 1) + ' = ' + fmt(an) +
            ' · la suma de los ' + n + ' primeros da ' + fmt(sn),
          rows: [
            { k: 'a₁ — primer término', v: a1, ...PLAIN },
            { k: 'r — razón (cada término ÷ el anterior)', v: r, ...PLAIN },
            { k: 'n — posición y cantidad de términos', v: n, ...PLAIN0 },
            { k: 'r^(n − 1)', ref: 'paso 1: el factor acumulado', v: snap(Math.pow(r, n - 1)), ...PLAIN6 },
            { k: 'a₁ × r^(n − 1) → aₙ', ref: 'paso 2: el término general', v: an, extra: true, ...PLAIN },
            { k: 'rⁿ', ref: 'paso 3: para la suma', v: snap(rn), ...PLAIN6 },
            {
              k: r === 1 ? 'n × a₁ → Sₙ (caso r = 1)' : 'a₁ × (rⁿ − 1) ÷ (r − 1) → Sₙ',
              ref: 'paso 4: la suma de los n primeros',
              v: sn,
              extra: true,
              ...PLAIN,
            },
            { k: 'Verificación: aₙ ÷ aₙ₋₁ (tiene que dar r)', ref: 'el chequeo', v: n > 1 && a1 ? snap(an / (a1 * Math.pow(r, n - 2))) : r, ...PLAIN },
          ],
          format: 'plain',
          decimals: 2,
          chart: barras(terms, 'a'),
        };
      }

      // ---- 3) Serie geométrica INFINITA ---------------------------------
      // |r| < 1  →  S = a₁ / (1 − r)
      if (id === 'geometrica-infinita') {
        const r = dr;
        const n = Math.max(1, Math.min(Math.floor(nRaw) || 10, 10000));
        if (Math.abs(r) >= 1) {
          return {
            total: '∞ — diverge',
            sub:
              'Con |r| = ' + fmt(Math.abs(r)) + ' ≥ 1 la serie DIVERGE: los términos no se achican lo suficiente y la suma crece sin límite. No hay resultado finito.',
            rows: [
              { k: 'a₁ — primer término', v: a1, ...PLAIN },
              { k: 'r — razón', v: r, ...PLAIN },
              { k: '|r| — condición de convergencia (tiene que ser < 1)', ref: 'acá falla', v: Math.abs(r), ...PLAIN },
              { k: 'Suma de los primeros ' + n + ' términos (parcial)', ref: 'crece sin techo', v: snap(r === 1 ? n * a1 : (a1 * (Math.pow(r, n) - 1)) / (r - 1)), ...PLAIN },
            ],
            format: 'plain',
            decimals: 2,
            chart: [],
          };
        }
        const s = snap(a1 / (1 - r));
        const parcial = snap((a1 * (Math.pow(r, n) - 1)) / (r - 1));
        const terms = [];
        for (let k = 0; k < 8; k++) terms.push(a1 * Math.pow(r, k));
        return {
          total: fmt(s),
          sub:
            'Con |r| = ' + fmt(Math.abs(r)) + ' < 1 la serie converge: S = a₁ ÷ (1 − r) = ' +
            fmt(a1) + ' ÷ ' + fmt(1 - r) + ' = ' + fmt(s),
          rows: [
            { k: 'a₁ — primer término', v: a1, ...PLAIN },
            { k: 'r — razón', v: r, ...PLAIN },
            { k: '|r| — condición de convergencia (< 1)', ref: 'paso 1: acá se decide todo', v: Math.abs(r), ...PLAIN },
            { k: '1 − r', ref: 'paso 2: el denominador', v: snap(1 - r), ...PLAIN },
            { k: 'a₁ ÷ (1 − r) → S infinita', ref: 'paso 3: el límite', v: s, extra: true, ...PLAIN6 },
            { k: 'Suma parcial de los primeros ' + n + ' términos', ref: 'se acerca pero no llega', v: parcial, ...PLAIN6 },
            { k: 'Lo que falta para el límite', ref: 'la cola de la serie', v: snap(s - parcial), ...PLAIN6 },
          ],
          format: 'plain',
          decimals: 2,
          chart: barras(terms, 'a'),
        };
      }

      // ---- 4) FIBONACCI --------------------------------------------------
      // F(n) = F(n−1) + F(n−2), F(0)=0, F(1)=1
      if (id === 'fibonacci') {
        const n = Math.floor(nRaw);
        if (isNaN(n) || n < 0) return err('La posición n tiene que ser un entero mayor o igual a 0.', 'Valor de n', nRaw);
        if (n > 78) return err('n máximo = 78: más allá, los términos superan el entero exacto de JavaScript.', 'Valor de n', n);
        const seq = [];
        let p = 0;
        let q = 1;
        for (let k = 0; k <= n; k++) {
          seq.push(p);
          const t = p + q;
          p = q;
          q = t;
        }
        const fn = seq[n];
        const f1 = n >= 1 ? seq[n - 1] : 0;
        const f2 = n >= 2 ? seq[n - 2] : 0;
        const ratio = f1 > 0 ? fn / f1 : 0;
        const primeros = seq.slice(0, 8);
        return {
          total: fmt(fn),
          sub:
            'F(' + n + ') = ' + fmt(fn) +
            (f1 > 0
              ? ' · el cociente F(' + n + ') ÷ F(' + (n - 1) + ') da ' + ratio.toFixed(6).replace('.', ',') + ', que tiende al número áureo φ ≈ 1,618034'
              : ' · estás en el arranque de la sucesión (0, 1, 1, 2, 3, 5…)'),
          rows: [
            { k: 'n — posición pedida', v: n, ...PLAIN0 },
            { k: 'F(n−2)', ref: 'paso 1: dos atrás', v: f2, ...PLAIN0 },
            { k: 'F(n−1)', ref: 'paso 2: uno atrás', v: f1, ...PLAIN0 },
            { k: 'F(n−1) + F(n−2) → F(n)', ref: 'paso 3: la regla recursiva', v: fn, extra: true, ...PLAIN0 },
            { k: 'F(n) ÷ F(n−1) → aproximación a φ', ref: 'φ = 1,618034', v: snap(ratio), ...PLAIN6 },
            { k: 'Distancia a φ', ref: 'se achica al crecer n', v: ratio ? Math.abs(ratio - 1.6180339887) : 0, ...PLAIN6 },
          ],
          format: 'plain',
          decimals: 0,
          chart: primeros.map((t, idx) => ({
            label: 'F(' + idx + ') = ' + fmt(t),
            value: Math.abs(t),
            tone: idx === n ? 'main' : 'prop',
          })),
        };
      }

      // ---- 5) TAYLOR / MACLAURIN -----------------------------------------
      // f(x) ≈ Σ cₖ · xᵏ, centrado en 0, con los coeficientes clásicos.
      const key = (v.func || 'exp');
      const S = SERIES[key] || SERIES.exp;
      const orden = Math.max(0, Math.min(12, Math.floor(nRaw) || 4));
      if ((key === 'ln1x' || key === 'geo') && Math.abs(x) >= 1) {
        return err(
          'La serie de ' + S.nombre + ' ' + S.radio + '. Con x = ' + fmt(x) + ' estás fuera del radio de convergencia: el polinomio no aproxima nada.',
          'Valor de x',
          x
        );
      }
      let suma = 0;
      const rows = [
        { k: 'Función elegida: ' + S.nombre, ref: S.radio, v: orden, format: 'unit', unit: 'orden', decimals: 0 },
        { k: 'x — punto donde evaluás', ref: 'centro de la serie: 0 (Maclaurin)', v: x, ...PLAIN },
        { k: 'Término general', ref: S.general, v: orden + 1, format: 'unit', unit: 'términos', decimals: 0 },
      ];
      for (let k = 0; k <= orden; k++) {
        const c = S.coef(k);
        const t = c * Math.pow(x, k);
        suma += t;
        if (c !== 0) {
          rows.push({
            k: 'Término k = ' + k + ':  ' + fmt(c) + ' × x^' + k,
            ref: 'suma acumulada: ' + fmt(suma),
            v: snap(t),
            ...PLAIN6,
          });
        }
      }
      const exacto = S.exacto(x);
      const errAbs = Math.abs(exacto - suma);
      rows.push({ k: 'Polinomio de Taylor evaluado en x', ref: 'la aproximación', v: snap(suma), extra: true, ...PLAIN6 });
      rows.push({ k: 'Valor exacto de ' + S.nombre, ref: 'para comparar', v: snap(exacto), ...PLAIN6 });
      rows.push({ k: 'Error absoluto', ref: 'si es grande, subí el orden', v: errAbs, ...PLAIN6 });
      return {
        total: fmt(suma),
        sub:
          S.nombre + ' en x = ' + fmt(x) + ', aproximado con un polinomio de orden ' + orden +
          ': ' + fmt(suma) + ' contra el valor exacto ' + fmt(exacto) + ' (error ' + errAbs.toExponential(2).replace('.', ',') + ')',
        rows: rows,
        format: 'plain',
        decimals: 6,
        chart: [
          { label: 'Aproximación de Taylor', value: Math.abs(snap(suma)), tone: 'main' },
          { label: 'Valor exacto', value: Math.abs(snap(exacto)), tone: 'good' },
        ],
      };
    });
  })();
</script>
