---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MundialFinalLive from '../components/MundialFinalLive.astro';
import WeekendPackCapture from '../components/WeekendPackCapture.astro';
import '../styles/calc-flagship.css';
import { fixture, LIVE_FIXTURE_URL, TEAMS } from '../lib/data/mundial-2026';
import { topScorers } from '../lib/mundial-live';
import { allTimeScorers, WC_HISTORIC_SCORERS } from '../lib/data/mundial-goleadores-historicos';

// ────────────────────────────────────────────────────────────────────────────
// TODO lo numérico de esta página sale del feed abierto de openfootball
// (src/lib/data/mundial-2026.ts → fixture.matches) vía src/lib/mundial-live.ts.
// NO hay goles, jugadores ni resultados hardcodeados: si el dato no está en el
// feed, la pieza no se renderiza. El script de refresh recalcula lo mismo en el
// cliente con el JSON vivo, así la página no queda stale entre deploys.
// ────────────────────────────────────────────────────────────────────────────

// Sin tope: las pestañas ("Argentina", "Siguen en competencia") y los totales por
// selección sólo son correctos con la lista COMPLETA. Un slice acá subcontaba
// (p. ej. Argentina quedaba 3ª con 10 goles en lugar de 1ª con 16).
const scorers = topScorers(fixture.matches, Number.MAX_SAFE_INTEGER);
const allTime = allTimeScorers(fixture.matches, 12);

// Placeholders del bracket ("W101", "L102"): no son selecciones reales.
const PLACEHOLDER = /^[WL]\d+$/;

/** Selecciones que siguen en competencia = aparecen en un partido sin resultado. */
const aliveTeams = [
  ...new Set(
    fixture.matches
      .filter((m) => !m.score?.ft)
      .flatMap((m) => [m.team1, m.team2])
      .filter((t): t is string => !!t && !PLACEHOLDER.test(t))
  ),
];

/** Ranking denso: los empatados en goles comparten posición (1, 1, 3…). */
function withRank<T extends { goles: number }>(rows: T[]): (T & { rank: number })[] {
  let rank = 0;
  let prev: number | null = null;
  return rows.map((s, i) => {
    if (prev === null || s.goles !== prev) { rank = i + 1; prev = s.goles; }
    return { ...s, rank };
  });
}

const ranked = withRank(scorers);
const podium = ranked.slice(0, 3);
const leader = ranked[0] || null;
const tied = leader ? ranked.filter((s) => s.goles === leader.goles) : [];

/** Recorrido real de un goleador: en qué fase marcó cada gol. */
function routeOf(name: string, team: string) {
  let grupos = 0, ko = 0, penales = 0;
  const partidos = new Set<number>();
  for (const m of fixture.matches) {
    const sides: Array<[string | null, typeof m.goals1]> = [[m.team1, m.goals1], [m.team2, m.goals2]];
    for (const [side, goals] of sides) {
      if (side !== team) continue;
      for (const g of goals || []) {
        if (g.owngoal || g.name !== name) continue;
        if (m.group) grupos++; else ko++;
        if (g.penalty) penales++;
        partidos.add(m.num);
      }
    }
  }
  return { grupos, ko, penales, partidos: partidos.size };
}

const route = leader ? routeOf(leader.name, leader.team) : null;

/** Plusmarquista histórico ANTES de 2026 (derivado de la tabla, no hardcodeado). */
const preRecord = [...WC_HISTORIC_SCORERS].sort((a, b) => b.pre2026 - a.pre2026)[0];

// Totales del torneo (misma regla que topScorers: los autogoles no cuentan).
const totalGoles = fixture.matches.reduce(
  (n, m) => n + (m.goals1 || []).filter((g) => !g.owngoal).length + (m.goals2 || []).filter((g) => !g.owngoal).length,
  0
);
const jugados = fixture.matches.filter((m) => m.score?.ft).length;
const totalPenales = scorers.reduce((n, s) => n + s.penales, 0);
const argentinos = ranked.filter((s) => s.team === 'Argentina');

/** Agrupado por selección (para la pestaña "Por selección"). */
const bySelection = [
  ...scorers
    .reduce((map, s) => {
      const cur = map.get(s.team) || { team: s.team, es: s.es, flag: s.flag, players: [] as typeof scorers, goles: 0 };
      cur.players.push(s);
      cur.goles += s.goles;
      map.set(s.team, cur);
      return map;
    }, new Map<string, { team: string; es: string; flag: string; players: typeof scorers; goles: number }>())
    .values(),
].sort((a, b) => b.goles - a.goles || a.es.localeCompare(b.es));

// Nombre de ronda del feed → castellano (traducción de etiquetas, no de datos).
const ROUND_ES: Record<string, string> = {
  'Round of 32': '16avos', 'Round of 16': 'Octavos', 'Quarter-final': 'Cuartos',
  'Quarter-finals': 'Cuartos', 'Semi-final': 'Semis', 'Semi-finals': 'Semis',
  'Match for third place': '3er puesto', 'Final': 'Final',
};

const SITE = 'https://hacecuentas.com';
const URL = `${SITE}/goleadores-mundial-2026`;
const title = 'Goleadores del Mundial 2026 EN VIVO — tabla del Botín de Oro | Hacé Cuentas';
const description = 'Goleadores del Mundial 2026 en vivo (carrera por el Botín de Oro) + el ranking histórico de todos los Mundiales: Messi ya es el máximo goleador de la historia. Se actualiza con cada gol.';
const updated = new Intl.DateTimeFormat('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(fixture.fetchedAt));

const plural = (n: number, s: string, p: string) => (n === 1 ? s : p);

const faq = [
  { q: '¿Quién es el goleador del Mundial 2026?', a: scorers.length ? (tied.length > 1
      ? `Por ahora comparten la punta ${tied.map((s) => `${s.es === 'Argentina' ? '' : ''}${s.name} (${s.flag})`).join(' y ')} con ${leader!.goles} goles cada uno. La tabla se actualiza con cada partido.`
      : `Por ahora va puntero ${scorers[0].name} (${scorers[0].flag} ${scorers[0].es}) con ${scorers[0].goles} ${plural(scorers[0].goles, 'gol', 'goles')}. La tabla se actualiza con cada partido.`) : 'Todavía no se jugaron partidos con goles; la tabla se completa a medida que avanza el torneo.' },
  { q: '¿Quién es el máximo goleador en la historia de los Mundiales?', a: `${allTime[0].name} (${allTime[0].flag}) es el máximo goleador histórico de los Mundiales con ${allTime[0].total} goles${allTime[0].en2026 > 0 ? `, sumando ${allTime[0].en2026} en el Mundial 2026` : ''}. Lo escoltan ${allTime[1].name} con ${allTime[1].total} y ${allTime[2].name} con ${allTime[2].total}. El récord venía siendo de ${preRecord.name} con ${preRecord.pre2026}.` },
  { q: '¿Qué es el Botín de Oro?', a: 'Es el premio al máximo goleador del Mundial. Si hay empate en goles, se define por asistencias y luego por menos minutos jugados. Los autogoles no cuentan para el goleador.' },
  { q: '¿Los penales cuentan para el Botín de Oro?', a: 'Sí, los goles de penal en el desarrollo del partido cuentan. No cuentan los goles en las definiciones por penales (tandas), que son un desempate aparte.' },
  { q: '¿Cuántos goles lleva el Mundial 2026?', a: `Van ${totalGoles} goles en ${jugados} ${plural(jugados, 'partido jugado', 'partidos jugados')}, repartidos entre ${scorers.length} ${plural(scorers.length, 'goleador', 'goleadores')} distintos${totalPenales > 0 ? ` (${totalPenales} de penal)` : ''}. No se cuentan los autogoles, que no se le adjudican a ningún goleador.` },
  { q: '¿Qué argentinos marcaron en el Mundial 2026?', a: argentinos.length
      ? `${argentinos.map((s) => `${s.name} (${s.goles})`).join(', ')}. En total, ${argentinos.reduce((n, s) => n + s.goles, 0)} goles de jugadores de la Selección Argentina.`
      : 'Todavía no hay goles de jugadores argentinos registrados en el feed.' },
  { q: '¿De dónde salen estos datos y cada cuánto se actualizan?', a: 'Del feed abierto de openfootball (worldcup.json), el mismo que alimenta el fixture y las posiciones. Al abrir la página se recalcula con los goles más recientes, así que no depende de que publiquemos un cambio.' },
];

const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Mundial 2026', item: `${SITE}/mundial-2026` },
    { '@type': 'ListItem', position: 3, name: 'Goleadores', item: URL } ] },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'ItemList', name: 'Máximos goleadores en la historia de los Mundiales', itemListElement: allTime.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: `${s.name} (${s.country}) — ${s.total} goles` })) },
] };

const liveConfig = { url: LIVE_FIXTURE_URL };

// Motor EN VIVO (ESPN) para los goles de la final — ver MundialFinalLive.astro.
const finalMatch = fixture.matches.find((m) => /^final$/i.test((m.round || '').trim())) || null;
const espnFinalTeams = [finalMatch?.team1, finalMatch?.team2].filter((n): n is string => !!n && !!TEAMS[n]);
const espnCfg = {
  date: (finalMatch?.date || '2026-07-19').replace(/-/g, ''),
  finalTeams: espnFinalTeams,
  teams: Object.fromEntries(espnFinalTeams.map((n) => [n, { es: TEAMS[n].es, flag: TEAMS[n].flag }])),
  pollMs: 60000,
};
const fLabel = (n?: string | null) => (n && TEAMS[n] ? `${TEAMS[n].flag} ${TEAMS[n].es}` : 'Por definir');
---

<Layout title={title} description={description} canonical="/goleadores-mundial-2026" schema={schema} audience="AR" domain="data">
  <Header slot="header" />

  <main>
    <div class="cf-page gol" data-domain="data">
      <nav class="cf-crumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li aria-hidden="true" class="cf-crumb__sep">›</li>
          <li><a href="/mundial-2026">Mundial 2026</a></li>
          <li aria-hidden="true" class="cf-crumb__sep">›</li>
          <li aria-current="page">Goleadores</li>
        </ol>
      </nav>

      <header class="cf-hero">
        <div class="cf-hero__main">
          <p class="cf-kicker"><span aria-hidden="true">⚽</span> Carrera por el Botín de Oro · 2026</p>
          <h1 class="cf-h1">Goleadores del <span class="cf-yr">Mundial 2026</span></h1>
          <p class="cf-sub">Quién va puntero, cuántos goles lleva y cuántos fueron de penal. Se recalcula con cada partido.</p>
          <ul class="cf-pills">
            <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Datos en vivo openfootball</li>
            <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Autogoles excluidos</li>
            <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Histórico incluido</li>
          </ul>
          <p class="gol-updated">
            Última actualización: <span data-live-updated>{updated}</span> ·
            Datos: <a href="https://github.com/openfootball/worldcup.json" rel="noopener" target="_blank">openfootball</a>
          </p>
        </div>
        <div class="cf-hero__deco" aria-hidden="true">
          <div class="gol-deco-wrap">
            <div class="cf-deco-card">
              <div class="cf-deco-card__label">Dato principal · puntero</div>
              <div class="cf-deco-card__value" data-deco-val>{leader ? `${leader.goles} ${plural(leader.goles, 'gol', 'goles')}` : '—'}</div>
              <div class="cf-deco-card__note" data-deco-note>{leader ? (tied.length > 1 ? `${tied.map((s) => s.name).join(' y ')} — empatados` : `${leader.flag} ${leader.name}`) : 'Sin goles registrados'}</div>
            </div>
            <span class="cf-deco-badge gol-badge">⚽</span>
          </div>
          <div class="gol-float">
            <span class="gol-float__k">Goles del torneo</span>
            <strong class="gol-float__v" data-float-val>{totalGoles}</strong>
            <span class="gol-float__n" data-float-note>en {jugados} {plural(jugados, 'partido', 'partidos')}</span>
          </div>
        </div>
      </header>

      <div class="gol-final-wrap">
        <MundialFinalLive
          cfg={espnCfg}
          team1={finalMatch && TEAMS[finalMatch.team1] ? { es: TEAMS[finalMatch.team1].es, flag: TEAMS[finalMatch.team1].flag } : null}
          team2={finalMatch && TEAMS[finalMatch.team2] ? { es: TEAMS[finalMatch.team2].es, flag: TEAMS[finalMatch.team2].flag } : null}
          kickoffLabel="Final del Mundial · hoy 16:00 · MetLife Stadium"
        />
        <p class="gol-final-note">Los goles de la final se suman a la tabla de goleadores del torneo al confirmarse cada uno.</p>
      </div>

      <WeekendPackCapture source="goleadores" />

      <p class="answer-snippet cf-sr" data-snippet>
        {leader
          ? (tied.length > 1
              ? `Goleadores del Mundial 2026: ${tied.map((s) => `${s.name} (${s.es})`).join(' y ')} comparten la punta con ${leader.goles} goles. Van ${totalGoles} goles en ${jugados} partidos.`
              : `Goleador del Mundial 2026: ${leader.name} (${leader.es}) con ${leader.goles} ${plural(leader.goles, 'gol', 'goles')}. Van ${totalGoles} goles en ${jugados} partidos.`)
          : 'Todavía no hay goles registrados en el Mundial 2026.'}
      </p>

      {scorers.length === 0 ? (
        <div class="cf-callout cf-callout--warn" style="margin-top:1.5rem">
          <span class="cf-callout__ico" aria-hidden="true">⚽</span>
          <p>Todavía no hay goles registrados. Volvé cuando empiece la acción.</p>
        </div>
      ) : (
        <>
          <div class="cf-stats">
            <div class="cf-stat cf-stat--accent">
              <div class="cf-stat__label">Puntero</div>
              <div class="cf-stat__value" data-stat-leader>{leader!.goles} {plural(leader!.goles, 'gol', 'goles')}</div>
              <div class="cf-stat__sub" data-stat-leader-sub>{tied.length > 1 ? `${tied.length} empatados` : `${leader!.flag} ${leader!.name}`}</div>
            </div>
            <div class="cf-stat">
              <div class="cf-stat__label">Goles del torneo</div>
              <div class="cf-stat__value" data-stat-total>{totalGoles}</div>
              <div class="cf-stat__sub" data-stat-total-sub>en {jugados} {plural(jugados, 'partido', 'partidos')}</div>
            </div>
            <div class="cf-stat">
              <div class="cf-stat__label">Goleadores distintos</div>
              <div class="cf-stat__value" data-stat-count>{scorers.length}</div>
              <div class="cf-stat__sub">Sin contar autogoles</div>
            </div>
            <div class="cf-stat">
              <div class="cf-stat__label">Goles de penal</div>
              <div class="cf-stat__value" data-stat-pen>{totalPenales}</div>
              <div class="cf-stat__sub">Sólo en juego, no tandas</div>
            </div>
          </div>

          <p class="cf-quick">
            <span class="cf-quick__ico" aria-hidden="true">⚡</span>
            <span class="cf-quick__txt" data-quick>
              <strong>Respuesta rápida.</strong> {tied.length > 1
                ? `${tied.map((s) => s.name).join(' y ')} comparten la punta con ${leader!.goles} goles cada uno.`
                : `${leader!.name} va puntero con ${leader!.goles} ${plural(leader!.goles, 'gol', 'goles')}.`}
            </span>
            <span class="cf-formula">goles − autogoles</span>
          </p>

          <!-- Podio -->
          <section class="cf-section">
            <div class="cf-section__head">
              <div>
                <p class="cf-eyebrow">El podio</p>
                <h2 class="cf-section__title">Los que más gritaron</h2>
              </div>
              <p class="cf-section__lead">Posición por goles. Los empatados comparten puesto: el Botín de Oro los desempata por asistencias y minutos jugados.</p>
            </div>
            <div class="gol-podium" data-podium>
              {podium.map((s, i) => (
                <div class={`gol-pod${i === 0 ? ' gol-pod--first' : ''}`}>
                  <span class="gol-pod__rank">{s.rank}</span>
                  <span class="gol-pod__flag" aria-hidden="true">{s.flag}</span>
                  <span class="gol-pod__name">{s.name}</span>
                  <span class="gol-pod__team">{s.es}</span>
                  <span class="gol-pod__goals">{s.goles}</span>
                  <span class="gol-pod__lbl">{plural(s.goles, 'gol', 'goles')}{s.penales > 0 ? ` · ${s.penales} de penal` : ''}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- Ranking completo con pestañas -->
          <section class="cf-section" id="tabla">
            <div class="cf-section__head">
              <div>
                <p class="cf-eyebrow">Ranking completo</p>
                <h2 class="cf-section__title">Tabla de goleadores</h2>
              </div>
              <p class="cf-section__lead" data-rank-lead>Los {scorers.length} goleadores del torneo, sin recortar. Filtrá por los que siguen en competencia, por Argentina, o mirá el total agrupado por selección.</p>
            </div>

            <div class="cf-seg gol-seg" role="group" aria-label="Filtro de goleadores">
              <button type="button" data-tab="todos" aria-pressed="true">Todos</button>
              <button type="button" data-tab="vivos" aria-pressed="false">Siguen en competencia</button>
              <button type="button" data-tab="arg" aria-pressed="false">Argentina</button>
              <button type="button" data-tab="sel" aria-pressed="false">Por selección</button>
            </div>

            <div class="cf-tablewrap gol-view" data-view="table">
              <table class="cf-table gol-table">
                <thead><tr><th>#</th><th>Jugador</th><th>Selección</th><th>Goles</th><th>Penales</th></tr></thead>
                <tbody data-scorers>
                  {ranked.map((s) => (
                    <tr data-team={s.team} data-alive={aliveTeams.includes(s.team) ? '1' : '0'} data-arg={s.team === 'Argentina' ? '1' : '0'}>
                      <td>{s.rank}</td>
                      <td><strong>{s.name}</strong></td>
                      <td><span class="gol-tflag" aria-hidden="true">{s.flag}</span> {s.es}</td>
                      <td class="cf-td-em">{s.goles}</td>
                      <td>{s.penales || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="gol-empty" data-empty hidden>Ningún goleador coincide con este filtro.</p>
            </div>

            <div class="gol-view gol-sel" data-view="sel" hidden>
              <div class="gol-selgrid" data-bysel>
                {bySelection.map((g) => (
                  <div class="gol-selcard">
                    <div class="gol-selcard__head">
                      <span class="gol-selcard__flag" aria-hidden="true">{g.flag}</span>
                      <span class="gol-selcard__team">{g.es}</span>
                      <span class="gol-selcard__tot">{g.goles}</span>
                    </div>
                    <ul class="gol-selcard__list">
                      {g.players.map((p) => (<li><span>{p.name}</span><strong>{p.goles}</strong></li>))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </section>
        </>
      )}
    </div>

    {leader && route && (
      <!-- Cómo llegó/llegaron a N goles -->
      <div class="cf-band" data-domain="data">
        <div class="cf-band__inner">
          <p class="cf-eyebrow">El recorrido</p>
          <h2 class="cf-section__title" style="margin:0.35rem 0 0.5rem" data-route-title>
            Cómo {tied.length > 1 ? 'llegaron' : 'llegó'} a los {leader.goles} goles
          </h2>
          <p class="cf-section__lead" style="margin:0 0 1.25rem" data-route-lead>
            {tied.length > 1
              ? `${tied.map((s) => s.name).join(' y ')} comparten la punta. Este es el desglose de ${leader.name}, primero en la tabla por orden alfabético al estar empatados.`
              : `El desglose de los ${leader.goles} goles de ${leader.name}, fase por fase.`}
          </p>
          <div class="cf-cards cf-cards--4" data-route-cards>
            <div class="cf-minicard cf-minicard--dark">
              <span class="cf-minicard__ico" aria-hidden="true">🏟️</span>
              <p class="cf-minicard__title">Fase de grupos</p>
              <div class="cf-minicard__big" data-route-grupos>{route.grupos}</div>
              <p class="cf-minicard__desc">{plural(route.grupos, 'gol', 'goles')} en la primera ronda.</p>
            </div>
            <div class="cf-minicard">
              <span class="cf-minicard__ico" aria-hidden="true">🔥</span>
              <p class="cf-minicard__title">Eliminación directa</p>
              <div class="cf-minicard__big" data-route-ko>{route.ko}</div>
              <p class="cf-minicard__desc">{plural(route.ko, 'gol', 'goles')} de 16avos en adelante.</p>
            </div>
            <div class="cf-minicard">
              <span class="cf-minicard__ico" aria-hidden="true">🎯</span>
              <p class="cf-minicard__title">De penal</p>
              <div class="cf-minicard__big" data-route-pen>{route.penales}</div>
              <p class="cf-minicard__desc">El resto, en jugada.</p>
            </div>
            <div class="cf-minicard">
              <span class="cf-minicard__ico" aria-hidden="true">📅</span>
              <p class="cf-minicard__title">Partidos con gol</p>
              <div class="cf-minicard__big" data-route-part>{route.partidos}</div>
              <p class="cf-minicard__desc">Encuentros en los que marcó al menos uno.</p>
            </div>
          </div>
        </div>
      </div>
    )}

    <div class="cf-page gol" data-domain="data">
      <!-- Histórico -->
      <section class="cf-section" id="historico">
        <div class="cf-section__head">
          <div>
            <p class="cf-eyebrow">Todos los Mundiales</p>
            <h2 class="cf-section__title">Máximos goleadores históricos</h2>
          </div>
          <p class="cf-section__lead">Goles en Mundiales hasta Qatar 2022 (FIFA / RSSSF) más los del 2026 sumando en vivo. Los jugadores en actividad suben solos.</p>
        </div>
        <div class="cf-tablewrap">
          <table class="cf-table gol-table">
            <thead><tr><th>#</th><th>Jugador</th><th>Goles</th></tr></thead>
            <tbody data-alltime>
              {allTime.map((s, i) => (
                <tr class={s.en2026 > 0 ? 'is-live' : ''}>
                  <td>{i + 1}</td>
                  <td><span class="gol-tflag" aria-hidden="true">{s.flag}</span> <strong>{s.name}</strong>{s.en2026 > 0 && <span class="gol-badge-live">▲ +{s.en2026} en 2026</span>}</td>
                  <td class="cf-td-em">{s.total}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="gol-note">
          El récord venía siendo de {preRecord.name} con {preRecord.pre2026} goles.
          <a href="/calculadora-top-10-goleadores-historico-mundial-fifa">Ver el top 10 histórico con promedios y períodos →</a>
        </p>
      </section>

      <!-- Cómo se define el Botín de Oro -->
      <section class="cf-section">
        <div class="gol-2col">
          <div class="gol-hl">
            <p class="cf-side-eyebrow">Botín de Oro</p>
            <p class="gol-hl__title">Cómo se define el premio al goleador</p>
            <p class="gol-hl__desc">Lo gana el jugador con más goles del torneo. Si hay empate, FIFA aplica los desempates en orden.</p>
            {leader && (
              <>
                <div class="gol-hl__big" data-hl-big>{leader.goles}</div>
                <p class="gol-hl__desc" data-hl-note>{tied.length > 1 ? `goles — ${tied.length} jugadores empatados en la punta` : `goles — ${leader.name} al frente`}</p>
              </>
            )}
          </div>
          <div class="cf-breakdown">
            <p class="cf-side-eyebrow">Criterios de desempate</p>
            <ol class="gol-rules">
              <li><strong>Goles.</strong> El primer criterio, siempre.</li>
              <li><strong>Asistencias.</strong> Si dos empatan en goles, gana el que más asistió.</li>
              <li><strong>Menos minutos jugados.</strong> El último desempate: premia al más eficiente.</li>
            </ol>
            <div class="cf-callout cf-callout--warn" style="margin-top:1rem">
              <span class="cf-callout__ico" aria-hidden="true">⚠️</span>
              <p>Los <strong>autogoles no se le adjudican a nadie</strong> y los goles de las <strong>tandas de penales no cuentan</strong>: son un desempate aparte, no parte del partido. Los penales dentro del juego sí suman.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="cf-section">
        <p class="cf-eyebrow">Preguntas frecuentes</p>
        <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Lo que más se consulta</h2>
        <div class="cf-faq">
          {faq.map((f, i) => (
            <details class="cf-faq__item" open={i === 0}>
              <summary class="cf-faq__q"><span>{f.q}</span><svg class="cf-faq__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></summary>
              <div class="cf-faq__a">{f.a}</div>
            </details>
          ))}
        </div>
      </section>
    </div>

    <!-- Actualización partido a partido -->
    <div class="cf-band cf-band--warm" data-domain="data">
      <div class="cf-band__inner">
        <div class="gol-2col">
          <div>
            <p class="cf-eyebrow">Actualización partido a partido</p>
            <h2 class="gol-card__title">La tabla se rehace sola con cada gol</h2>
            <p class="cf-side-desc">
              No esperamos a publicar un cambio: al abrir la página se pide el JSON vivo de openfootball y se recalculan
              el podio, el ranking y el histórico con los goles más recientes. Si el feed todavía no cargó un gol, acá tampoco aparece.
            </p>
            <div class="cf-callout cf-callout--warn" style="margin-top:1rem">
              <span class="cf-callout__ico" aria-hidden="true">🕐</span>
              <p>Última lectura del feed: <strong><span data-live-updated>{updated}</span></strong> (hora de Argentina).</p>
            </div>
          </div>
          <div class="cf-side-card cf-side-card--dark">
            <p class="cf-side-eyebrow">Fuente de los datos</p>
            <p class="gol-src__title">Feed abierto, verificable</p>
            <div class="gol-src">
              <div class="gol-src__item"><strong>openfootball / worldcup.json</strong><span>Fixture, resultados y goleadores del Mundial 2026</span></div>
              <div class="gol-src__item"><strong>FIFA / RSSSF</strong><span>Goles en Mundiales hasta Qatar 2022 (base del histórico)</span></div>
              <div class="gol-src__item"><strong>Reglamento FIFA</strong><span>Criterios del Botín de Oro y desempates</span></div>
            </div>
            <p class="gol-src__foot">● Información revisada en julio de 2026</p>
          </div>
        </div>
      </div>
    </div>

    <div class="cf-page gol" data-domain="data">
      <section class="cf-section">
        <p class="cf-eyebrow">Seguí el Mundial</p>
        <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Herramientas relacionadas</h2>
        <div class="cf-related__grid">
          <a class="cf-relcard" href="/fixture-mundial-2026">
            <span class="cf-relcard__ico" aria-hidden="true">📅</span>
            <span class="cf-relcard__title">Fixture y resultados</span>
            <span class="cf-relcard__desc">Todos los partidos del Mundial, con resultados en vivo.</span>
            <span class="cf-relcard__link">Ver el fixture <span aria-hidden="true">→</span></span>
          </a>
          <a class="cf-relcard" href="/posiciones-mundial-2026">
            <span class="cf-relcard__ico" aria-hidden="true">🏆</span>
            <span class="cf-relcard__title">Tabla de posiciones</span>
            <span class="cf-relcard__desc">Cómo va cada grupo, puntos y diferencia de gol.</span>
            <span class="cf-relcard__link">Ver posiciones <span aria-hidden="true">→</span></span>
          </a>
          <a class="cf-relcard" href="/llave-mundial-2026">
            <span class="cf-relcard__ico" aria-hidden="true">🗂️</span>
            <span class="cf-relcard__title">Llave de eliminación</span>
            <span class="cf-relcard__desc">El camino de cada selección hasta la final.</span>
            <span class="cf-relcard__link">Ver la llave <span aria-hidden="true">→</span></span>
          </a>
        </div>
        <p class="gol-more">
          También: <a href="/campeon-mundial-2026">¿Quién ganó? Campeón y palmarés</a> ·
          <a href="/cuando-juega-argentina-mundial-2026">¿Cuándo juega Argentina?</a> ·
          <a href="/calculadora-top-10-goleadores-historico-mundial-fifa">Top 10 goleadores históricos</a>
        </p>
      </section>

      <section class="cf-ctabar">
        <div>
          <p class="cf-ctabar__title">Guardá esta tabla.</p>
          <p class="cf-ctabar__sub">Volvé después de cada partido: se actualiza con cada gol.</p>
        </div>
        <div class="cf-ctabar__actions">
          <a class="cf-ctabar__btn cf-ctabar__btn--solid" href="/fixture-mundial-2026">Ver el fixture</a>
        </div>
      </section>
    </div>
  </main>

  <Footer slot="footer" />
</Layout>

<script type="application/json" id="live-cfg" set:html={JSON.stringify(liveConfig)} />
<script type="application/json" id="historic-scorers" set:html={JSON.stringify(WC_HISTORIC_SCORERS)} />
<script type="application/json" id="teams-map" set:html={JSON.stringify(TEAMS)} />
<script type="application/json" id="round-es" set:html={JSON.stringify(ROUND_ES)} />

<script is:inline>
  // Refresh client-side: recalcula TODO con el feed vivo (mismo algoritmo que el
  // SSR de arriba). Sin imports: las tablas llegan por <script type="application/json">.
  (function () {
    var cfg = JSON.parse(document.getElementById('live-cfg')?.textContent || '{}');
    var TEAMS = JSON.parse(document.getElementById('teams-map')?.textContent || '{}');
    var HIST = JSON.parse(document.getElementById('historic-scorers')?.textContent || '[]');
    var PLACEHOLDER = /^[WL]\d+$/;

    var esc = function (s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    };
    var plural = function (n, s, p) { return n === 1 ? s : p; };
    var teamEs = function (t) { return (TEAMS[t] && TEAMS[t].es) || t || '—'; };
    var teamFlag = function (t) { return (TEAMS[t] && TEAMS[t].flag) || '⚽'; };
    var norm = function (x) { return (x || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim(); };
    var setText = function (sel, txt) {
      document.querySelectorAll(sel).forEach(function (el) { el.textContent = txt; });
    };

    // ── Tabs (funcionan con el HTML del SSR, sin esperar al fetch) ───────────
    var applyTab = function (tab) {
      var tableView = document.querySelector('[data-view="table"]');
      var selView = document.querySelector('[data-view="sel"]');
      if (!tableView || !selView) return;
      if (tab === 'sel') {
        tableView.hidden = true;
        selView.hidden = false;
        return;
      }
      tableView.hidden = false;
      selView.hidden = true;
      var shown = 0;
      document.querySelectorAll('[data-scorers] tr').forEach(function (tr) {
        var ok = tab === 'todos'
          || (tab === 'vivos' && tr.getAttribute('data-alive') === '1')
          || (tab === 'arg' && tr.getAttribute('data-arg') === '1');
        tr.hidden = !ok;
        if (ok) shown++;
      });
      var empty = document.querySelector('[data-empty]');
      if (empty) empty.hidden = shown > 0;
    };

    document.querySelectorAll('.gol-seg [data-tab]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.gol-seg [data-tab]').forEach(function (b) {
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        applyTab(btn.getAttribute('data-tab'));
      });
    });

    // ── Refresh desde el feed vivo ──────────────────────────────────────────
    if (!cfg.url) return;

    function currentTab() {
      var on = document.querySelector('.gol-seg [data-tab][aria-pressed="true"]');
      return on ? on.getAttribute('data-tab') : 'todos';
    }

    async function refresh() {
      try {
        var res = await fetch(cfg.url, { cache: 'no-store' });
        if (!res.ok) return;
        var data = await res.json();
        if (!data || !Array.isArray(data.matches)) return;

        // 1. Goleadores (autogoles excluidos) — mismo algoritmo que topScorers().
        var map = {};
        var totalGoles = 0;
        var add = function (team, goals) {
          for (var i = 0; i < (goals || []).length; i++) {
            var g = goals[i];
            if (g.owngoal) continue;
            totalGoles++;
            var k = g.name + '|' + team;
            if (!map[k]) map[k] = { name: g.name, team: team, goles: 0, penales: 0, partidos: {}, grupos: 0, ko: 0 };
            map[k].goles++;
            if (g.penalty) map[k].penales++;
          }
        };
        for (var i = 0; i < data.matches.length; i++) {
          var m = data.matches[i];
          add(m.team1, m.goals1);
          add(m.team2, m.goals2);
        }
        // Recorrido por fase (para las 4 cards del líder).
        for (var i2 = 0; i2 < data.matches.length; i2++) {
          var m2 = data.matches[i2];
          var sides = [[m2.team1, m2.goals1], [m2.team2, m2.goals2]];
          for (var s2 = 0; s2 < sides.length; s2++) {
            var team = sides[s2][0], goals = sides[s2][1] || [];
            for (var g2 = 0; g2 < goals.length; g2++) {
              if (goals[g2].owngoal) continue;
              var row = map[goals[g2].name + '|' + team];
              if (!row) continue;
              if (m2.group) row.grupos++; else row.ko++;
              row.partidos[m2.num] = 1;
            }
          }
        }

        // Sin slice: las pestañas y los totales por selección necesitan la lista completa.
        var rows = Object.keys(map).map(function (k) { return map[k]; })
          .sort(function (a, b) { return b.goles - a.goles || a.name.localeCompare(b.name); });
        if (!rows.length) return;

        // Ranking denso (empatados comparten puesto).
        var rank = 0, prev = null;
        rows.forEach(function (s, i) {
          if (prev === null || s.goles !== prev) { rank = i + 1; prev = s.goles; }
          s.rank = rank;
        });

        // 2. Selecciones que siguen en competencia.
        var alive = {};
        for (var i3 = 0; i3 < data.matches.length; i3++) {
          var m3 = data.matches[i3];
          if (m3.score && m3.score.ft) continue;
          [m3.team1, m3.team2].forEach(function (t) {
            if (t && !PLACEHOLDER.test(t)) alive[t] = 1;
          });
        }

        var jugados = data.matches.filter(function (m) { return m.score && m.score.ft; }).length;
        var totalPen = rows.reduce(function (n, s) { return n + s.penales; }, 0);
        var leader = rows[0];
        var tied = rows.filter(function (s) { return s.goles === leader.goles; });

        // 3. Tabla de goleadores.
        var tb = document.querySelector('[data-scorers]');
        if (tb) {
          tb.innerHTML = rows.map(function (s) {
            return '<tr data-team="' + esc(s.team) + '" data-alive="' + (alive[s.team] ? '1' : '0') + '" data-arg="' + (s.team === 'Argentina' ? '1' : '0') + '">'
              + '<td>' + s.rank + '</td>'
              + '<td><strong>' + esc(s.name) + '</strong></td>'
              + '<td><span class="gol-tflag" aria-hidden="true">' + teamFlag(s.team) + '</span> ' + esc(teamEs(s.team)) + '</td>'
              + '<td class="cf-td-em">' + s.goles + '</td>'
              + '<td>' + (s.penales || '—') + '</td>'
              + '</tr>';
          }).join('');
        }

        // 4. Podio.
        var pod = document.querySelector('[data-podium]');
        if (pod) {
          pod.innerHTML = rows.slice(0, 3).map(function (s, i) {
            return '<div class="gol-pod' + (i === 0 ? ' gol-pod--first' : '') + '">'
              + '<span class="gol-pod__rank">' + s.rank + '</span>'
              + '<span class="gol-pod__flag" aria-hidden="true">' + teamFlag(s.team) + '</span>'
              + '<span class="gol-pod__name">' + esc(s.name) + '</span>'
              + '<span class="gol-pod__team">' + esc(teamEs(s.team)) + '</span>'
              + '<span class="gol-pod__goals">' + s.goles + '</span>'
              + '<span class="gol-pod__lbl">' + plural(s.goles, 'gol', 'goles') + (s.penales > 0 ? ' · ' + s.penales + ' de penal' : '') + '</span>'
              + '</div>';
          }).join('');
        }

        // 5. Por selección.
        var bysel = document.querySelector('[data-bysel]');
        if (bysel) {
          var groups = {};
          rows.forEach(function (s) {
            if (!groups[s.team]) groups[s.team] = { team: s.team, players: [], goles: 0 };
            groups[s.team].players.push(s);
            groups[s.team].goles += s.goles;
          });
          var gl = Object.keys(groups).map(function (k) { return groups[k]; })
            .sort(function (a, b) { return b.goles - a.goles || teamEs(a.team).localeCompare(teamEs(b.team)); });
          bysel.innerHTML = gl.map(function (g) {
            return '<div class="gol-selcard"><div class="gol-selcard__head">'
              + '<span class="gol-selcard__flag" aria-hidden="true">' + teamFlag(g.team) + '</span>'
              + '<span class="gol-selcard__team">' + esc(teamEs(g.team)) + '</span>'
              + '<span class="gol-selcard__tot">' + g.goles + '</span></div>'
              + '<ul class="gol-selcard__list">'
              + g.players.map(function (p) { return '<li><span>' + esc(p.name) + '</span><strong>' + p.goles + '</strong></li>'; }).join('')
              + '</ul></div>';
          }).join('');
        }

        // 6. Stats + hero + respuesta rápida.
        setText('[data-stat-leader]', leader.goles + ' ' + plural(leader.goles, 'gol', 'goles'));
        setText('[data-stat-leader-sub]', tied.length > 1 ? tied.length + ' empatados' : teamFlag(leader.team) + ' ' + leader.name);
        setText('[data-stat-total]', String(totalGoles));
        setText('[data-stat-total-sub]', 'en ' + jugados + ' ' + plural(jugados, 'partido', 'partidos'));
        setText('[data-stat-count]', String(rows.length));
        setText('[data-rank-lead]', 'Los ' + rows.length + ' goleadores del torneo, sin recortar. Filtrá por los que siguen en competencia, por Argentina, o mirá el total agrupado por selección.');
        setText('[data-stat-pen]', String(totalPen));
        setText('[data-deco-val]', leader.goles + ' ' + plural(leader.goles, 'gol', 'goles'));
        setText('[data-deco-note]', tied.length > 1
          ? tied.map(function (s) { return s.name; }).join(' y ') + ' — empatados'
          : teamFlag(leader.team) + ' ' + leader.name);
        setText('[data-float-val]', String(totalGoles));
        setText('[data-float-note]', 'en ' + jugados + ' ' + plural(jugados, 'partido', 'partidos'));
        var quick = document.querySelector('[data-quick]');
        if (quick) {
          quick.innerHTML = '<strong>Respuesta rápida.</strong> ' + (tied.length > 1
            ? esc(tied.map(function (s) { return s.name; }).join(' y ')) + ' comparten la punta con ' + leader.goles + ' goles cada uno.'
            : esc(leader.name) + ' va puntero con ' + leader.goles + ' ' + plural(leader.goles, 'gol', 'goles') + '.');
        }
        setText('[data-hl-big]', String(leader.goles));
        setText('[data-hl-note]', tied.length > 1
          ? 'goles — ' + tied.length + ' jugadores empatados en la punta'
          : 'goles — ' + leader.name + ' al frente');

        // 7. Cards del recorrido del líder.
        setText('[data-route-title]', 'Cómo ' + (tied.length > 1 ? 'llegaron' : 'llegó') + ' a los ' + leader.goles + ' goles');
        setText('[data-route-lead]', tied.length > 1
          ? tied.map(function (s) { return s.name; }).join(' y ') + ' comparten la punta. Este es el desglose de ' + leader.name + ', primero en la tabla por orden alfabético al estar empatados.'
          : 'El desglose de los ' + leader.goles + ' goles de ' + leader.name + ', fase por fase.');
        setText('[data-route-grupos]', String(leader.grupos));
        setText('[data-route-ko]', String(leader.ko));
        setText('[data-route-pen]', String(leader.penales));
        setText('[data-route-part]', String(Object.keys(leader.partidos).length));

        // 8. Ranking histórico all-time (base hasta 2022 + goles 2026 en vivo).
        try {
          var g26 = {};
          rows.forEach(function (s) { var k = norm(s.name); g26[k] = (g26[k] || 0) + s.goles; });
          var at = HIST.map(function (h) {
            var en = h.matchName ? (g26[norm(h.matchName)] || 0) : 0;
            return { name: h.name, flag: h.flag, en2026: en, total: h.pre2026 + en };
          }).sort(function (a, b) { return b.total - a.total || b.en2026 - a.en2026 || a.name.localeCompare(b.name); })
            .slice(0, 12);
          var atb = document.querySelector('[data-alltime]');
          if (atb && at.length) {
            atb.innerHTML = at.map(function (s, i) {
              return '<tr class="' + (s.en2026 > 0 ? 'is-live' : '') + '">'
                + '<td>' + (i + 1) + '</td>'
                + '<td><span class="gol-tflag" aria-hidden="true">' + s.flag + '</span> <strong>' + esc(s.name) + '</strong>'
                + (s.en2026 > 0 ? '<span class="gol-badge-live">▲ +' + s.en2026 + ' en 2026</span>' : '')
                + '</td><td class="cf-td-em">' + s.total + '</td></tr>';
            }).join('');
          }
        } catch (e) {}

        setText('[data-live-updated]', new Intl.DateTimeFormat('es-AR', {
          timeZone: 'America/Argentina/Buenos_Aires', day: '2-digit', month: 'short',
          hour: '2-digit', minute: '2-digit', hour12: false,
        }).format(new Date()));

        // Re-aplicar el filtro activo sobre las filas nuevas.
        applyTab(currentTab());
      } catch (e) {}
    }

    refresh();
  })();
</script>

<!--
  is:global OBLIGATORIO acá. El refresh en vivo reescribe podio, tabla, "por
  selección" e histórico con innerHTML: esos nodos NO llevan el data-astro-cid-*
  que Astro le estampa al HTML del SSR, así que con <style> scopeado las reglas
  (.gol-pod[data-astro-cid-x]) dejan de matchear y todo queda sin estilo apenas
  entra el primer fetch. Namespace = el prefijo .gol / .gol-* de cada selector.
-->
<style is:global>
  .gol .gol-updated { font-size: 0.75rem; color: var(--text-subtle); margin: 1rem 0 0; }
  .gol .gol-updated a { color: var(--accent); }

  /* ── Hero deco ─────────────────────────────────────────────────────────── */
  .gol .gol-deco-wrap { position: relative; }
  .gol .gol-badge { top: 50%; right: -14px; transform: translateY(-50%); width: 44px; height: 44px; font-size: 1.25rem; }
  .gol .gol-float { margin-top: 0.7rem; padding: 0.75rem 0.9rem; border-radius: var(--radius); background: var(--bg-card); border: 1px solid var(--border); }
  .gol .gol-float__k { font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-subtle); }
  .gol .gol-float__v { display: block; font-size: 1.45rem; font-weight: 800; color: var(--text); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .gol .gol-float__n { font-size: 0.68rem; color: var(--text-subtle); }

  /* ── Podio ─────────────────────────────────────────────────────────────── */
  .gol .gol-podium { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  @media (min-width: 720px) { .gol .gol-podium { grid-template-columns: repeat(3, 1fr); align-items: end; } }
  .gol .gol-pod {
    position: relative; display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: 1.4rem 1rem 1.2rem; border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--bg-card);
  }
  .gol .gol-pod--first {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 10%, var(--bg-card)), var(--bg-card));
    box-shadow: var(--shadow-md);
  }
  @media (min-width: 720px) { .gol .gol-pod--first { padding-top: 2.1rem; padding-bottom: 1.7rem; } }
  .gol .gol-pod__rank {
    position: absolute; top: -11px; left: 50%; transform: translateX(-50%);
    min-width: 26px; height: 22px; padding: 0 0.45rem; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--border-strong); color: var(--bg-card);
    font-size: 0.7rem; font-weight: 800; font-variant-numeric: tabular-nums;
  }
