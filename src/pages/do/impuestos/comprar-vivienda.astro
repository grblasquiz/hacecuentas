---
/**
 * Hub de decisión DO — "Comprar, tener y vender una propiedad: la cuenta completa".
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ComprarViviendaDominicanaExperience from '../../../components/generated/ComprarViviendaDominicanaExperience.astro';
import {
  hub,
  TASA_TRANSFERENCIA,
  IPI,
  GANANCIA_CAPITAL,
  ISR_TRAMOS,
  ISR_EXENCION_ANUAL,
} from '../../../lib/hubs/do/comprar-vivienda';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="DO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ComprarViviendaDominicanaExperience data={hub} />
  <Footer />
</Layout>

