---
/**
 * Hub de decisión DO — "Comprar, tener y vender una propiedad: la cuenta completa".
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ComprarViviendaDominicanaExperience from '../../../components/generated/ComprarViviendaDominicanaExperience.astro';
import {
  hub,
  TASA_TRANSFERENCIA,
  IPI,
  GANANCIA_CAPITAL,
  ISR_TRAMOS,
  ISR_EXENCION_ANUAL,
} from '../../../lib/hubs/do/comprar-vivienda';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="DO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ComprarViviendaDominicanaExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    TASA_TRANSFERENCIA,
    IPI,
    GANANCIA_CAPITAL,
    TRAMOS: ISR_TRAMOS,
    EXENCION: ISR_EXENCION_ANUAL,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const dop = (n) => 'RD$ ' + Math.round(n || 0).toLocaleString('de-DE');

    function isrAnual(base) {
      const b = Math.max(0, base);
      if (b <= EXENCION) return 0;
      for (const t of TRAMOS) {
        const hasta = t.hasta === null ? Infinity : t.hasta;
        if (b > t.desde && b <= hasta) return t.cuotaFija + (b - t.desde) * t.tasa;
      }
      return 0;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'hipoteca';
      const precio = Math.max(0, v.precio || 0);
      const valorDgii = Math.max(0, v.valorDgii || 0);
      const inicialPct = Math.min(100, Math.max(0, v.inicialPct || 0));
      const tasa = Math.max(0, v.tasa || 0);
      const plazo = Math.max(1, v.plazo || 1);
      const honorariosPct = Math.max(0, v.honorariosPct || 0);
      const otros = Math.max(0, v.otrosGastos || 0);
      const costoAdq = Math.max(0, v.costoAdquisicion || 0);
      const multiplicador = Math.max(1, v.multiplicador || 1);

      // Base del impuesto de transferencia: el mayor entre precio y tasación DGII.
      const baseTransferencia = Math.max(precio, valorDgii);
      const transferencia = baseTransferencia * TASA_TRANSFERENCIA;
      const honorarios = precio * (honorariosPct / 100);
      const gastosCierre = transferencia + honorarios + otros;

      // Financiamiento francés.
      const inicial = id === 'contado' ? precio : precio * (inicialPct / 100);
      const financiado = Math.max(0, precio - inicial);
      const i = tasa / 100 / 12;
      const n = Math.round(plazo * 12);
      const cuota = id === 'contado' || financiado === 0
        ? 0
        : i === 0
          ? financiado / n
          : (financiado * i) / (1 - Math.pow(1 + i, -n));
      const totalIntereses = cuota > 0 ? cuota * n - financiado : 0;

      // IPI anual sobre el excedente del mínimo exento.
      const excedenteIpi = Math.max(0, precio - IPI.exento);
      const ipiAnual = excedenteIpi * IPI.tasa;
      const ipiCuota = ipiAnual / IPI.cuotas;

      // Ganancia de capital al vender.
      const costoAjustado = costoAdq * multiplicador;
      const ganancia = Math.max(0, precio - costoAjustado);
      const impuestoJuridica = ganancia * GANANCIA_CAPITAL.tasaPersonaJuridica;
      const impuestoFisica = isrAnual(ganancia);

      const efectivoParaCerrar = inicial + gastosCierre;

      const rows = [
        { k: 'Precio del inmueble', ref: 'Contrato de compraventa', v: precio },
        {
          k: 'Base del impuesto de transferencia',
          ref: valorDgii > precio ? 'Manda la tasación de la DGII' : 'Manda el precio del contrato',
          v: baseTransferencia,
        },
        { k: 'Impuesto de transferencia', ref: Math.round(TASA_TRANSFERENCIA * 100) + '% · Ley 288-04', v: transferencia },
        { k: 'Honorarios legales', ref: honorariosPct.toString().replace('.', ',') + '% del precio', v: honorarios },
        { k: 'Deslinde, certificaciones y registro', ref: 'Gastos administrativos del traspaso', v: otros },
        { k: 'Total de gastos de cierre', ref: 'No se financian: van en efectivo', v: gastosCierre },
        {
          k: 'Gastos de cierre sobre el precio',
          ref: 'Cuánto encarece la operación',
          v: precio > 0 ? (gastosCierre / precio) * 100 : 0,
          format: 'unit',
          unit: '%',
          decimals: 2,
        },
        { k: 'Pago inicial', ref: id === 'contado' ? 'Compra al contado' : inicialPct + '% del precio', v: inicial },
        { k: 'Efectivo que necesitás el día de la firma', ref: 'Inicial + gastos de cierre', v: efectivoParaCerrar, extra: true },
      ];

      if (cuota > 0) {
        rows.push({ k: 'Monto financiado', ref: 'Precio − inicial', v: financiado });
        rows.push({ k: 'Cuota mensual', ref: 'Sistema francés · ' + tasa.toString().replace('.', ',') + '% anual a ' + plazo + ' años', v: cuota, extra: true });
        rows.push({ k: 'Intereses totales del préstamo', ref: n + ' cuotas', v: totalIntereses });
        rows.push({ k: 'Costo total del inmueble financiado', ref: 'Inicial + cuotas + gastos de cierre', v: inicial + cuota * n + gastosCierre });
      }

      rows.push({
        k: 'Excedente gravado por el IPI',
        ref: 'Valor − mínimo exento de ' + dop(IPI.exento),
        v: excedenteIpi,
      });
      rows.push({ k: 'IPI anual', ref: Math.round(IPI.tasa * 100) + '% del excedente · Ley 18-88', v: ipiAnual });
      rows.push({ k: 'Cuota semestral del IPI', ref: 'Vencen el 11-mar y el 11-sep', v: ipiCuota });

      rows.push({ k: 'Costo de adquisición ajustado por inflación', ref: 'Costo × multiplicador ' + multiplicador.toString().replace('.', ','), v: costoAjustado });
      rows.push({ k: 'Ganancia de capital si vendés a este precio', ref: 'Venta − costo ajustado · Art. 289', v: ganancia });
      rows.push({ k: 'Impuesto si sos persona física', ref: 'Escala progresiva del ISR', v: impuestoFisica });
      rows.push({
        k: 'Impuesto si sos persona jurídica',
        ref: Math.round(GANANCIA_CAPITAL.tasaPersonaJuridica * 100) + '% fijo',
        v: impuestoJuridica,
      });

      let total = efectivoParaCerrar;
      let sub =
        'Necesitás ' + dop(efectivoParaCerrar) + ' en efectivo: ' + dop(inicial) + ' de inicial y ' +
        dop(gastosCierre) + ' de gastos de cierre (' + (precio > 0 ? ((gastosCierre / precio) * 100).toFixed(2).replace('.', ',') : '0') + '% del precio)';

      if (cuota > 0) {
        sub += ' · después, ' + dop(cuota) + ' por mes durante ' + plazo + ' años';
      }
      if (id === 'propietario') {
        total = ipiAnual;
        sub = ipiAnual > 0
          ? 'Pagás ' + dop(ipiAnual) + ' de IPI al año, en dos cuotas de ' + dop(ipiCuota) +
            ' · sólo se grava el excedente de ' + dop(IPI.exento) + ', no el valor total'
          : 'No pagás IPI: el valor del inmueble no supera el mínimo exento de ' + dop(IPI.exento);
      }
      if (id === 'venta') {
        total = impuestoFisica;
        sub = ganancia > 0
          ? 'Ganancia gravable de ' + dop(ganancia) + ' · pagás ' + dop(impuestoFisica) +
            ' como persona física o ' + dop(impuestoJuridica) + ' como persona jurídica' +
            (multiplicador === 1 ? ' · cargá el multiplicador de la DGII de tu año de compra: sin él el impuesto sale inflado' : '')
          : 'Con el costo ajustado por inflación no queda ganancia de capital gravable';
      }

      const chart = id === 'venta'
        ? [
            { label: 'Costo ajustado por inflación', value: Math.round(Math.min(costoAjustado, precio)), tone: 'prop' },
            { label: 'Ganancia neta después de impuesto', value: Math.max(0, Math.round(ganancia - impuestoFisica)), tone: 'main' },
            { label: 'Impuesto a la ganancia de capital', value: Math.round(impuestoFisica), tone: 'warn' },
          ]
        : [
            { label: 'Pago inicial (queda en el inmueble)', value: Math.round(inicial), tone: 'main' },
            { label: 'Impuesto de transferencia 3%', value: Math.round(transferencia), tone: 'warn' },
            { label: 'Honorarios legales', value: Math.round(honorarios), tone: 'prop' },
            { label: 'Deslinde y registro', value: Math.round(otros), tone: 'exit' },
          ];

      return { total: dop(total), sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
