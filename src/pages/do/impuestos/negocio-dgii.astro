---
/**
 * Hub de decisión DO — "Qué le debe tu negocio a la DGII".
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import NegocioDgiiDominicanaExperience from '../../../components/generated/NegocioDgiiDominicanaExperience.astro';
import {
  hub,
  ITBIS,
  TASA_ISR_SOCIEDADES,
  ANTICIPOS,
  RETENCION_HONORARIOS,
  ITF,
  PROPINA_LEGAL,
  MORA,
} from '../../../lib/hubs/do/negocio-dgii';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="DO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <NegocioDgiiDominicanaExperience data={hub} />
  <Footer />
</Layout>

