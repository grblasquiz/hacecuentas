---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/do/comprar-y-financiar-un-vehiculo';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="DO" lang="es" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/do-comprar-y-financiar-un-vehiculo';
  const configs = {"c1":{"formulaId":"impuestos-importacion-vehiculo-republica-dominicana","fields":["cifUsd","origen","cilindrada","co2"],"outputs":[{"id":"totalImpuestos","label":"Total de impuestos","primary":true},{"id":"costoTotal","label":"Costo del vehículo nacionalizado"},{"id":"cif","label":"Valor CIF (RD$)"},{"id":"gravamen","label":"Gravamen (arancel)"},{"id":"isc","label":"ISC (por cilindrada)"},{"id":"itbis","label":"ITBIS 18%"},{"id":"primeraPlaca","label":"Primera placa (17%)"},{"id":"impCo2","label":"Impuesto CO₂"},{"id":"detalle","label":"Detalle"}],"title":"Calculadora de impuestos de importación de vehículo — República Dominicana"},"c2":{"formulaId":"prestamo-vehiculo-cuota-republica-dominicana","fields":["precio","inicial","tasa","plazo","seguro"],"outputs":[{"id":"cuota","label":"Cuota mensual","primary":true},{"id":"montoFinanciado","label":"Monto financiado"},{"id":"totalPagar","label":"Costo total (con inicial)"},{"id":"totalIntereses","label":"Total de intereses"},{"id":"detalle","label":"Detalle"}],"title":"Calculadora de préstamo de vehículo en República Dominicana: cuota, inicial y total"}};
  const numeric = (o:any) => Object.entries(o || {}).filter(([k,v]) => !k.startsWith('_') && typeof v === 'number' && Number.isFinite(v as number));
  const labelFor = (cfg:any,key:string) => cfg.outputs.find((o:any)=>o.id===key)?.label || key.replace(/_/g,' ');
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => {
    const id=selected?.id || Object.keys(configs)[0], cfg=(configs as any)[id];
    const values:any={}; for(const key of cfg.fields) values[key]=all[id+'__'+key];
    let out:any; try { out=formulaMap[id](values) || {}; } catch(e:any) { return {total:'—',sub:e?.message||'Revisa los datos',rows:[],chart:[],format:'plain'}; }
    const nums=numeric(out); const preferred=cfg.outputs.find((x:any)=>x.primary && typeof out[x.id]==='number') || cfg.outputs.find((x:any)=>typeof out[x.id]==='number');
    const mainKey=preferred?.id || nums[0]?.[0], main=Number(out[mainKey] ?? nums[0]?.[1] ?? 0);
    const rows=nums.slice(0,12).map(([k,v])=>({k:labelFor(cfg,k),v:Number(v),format:'ars'}));
    const chart=nums.slice(0,6).map(([k,v],i)=>({label:labelFor(cfg,k),value:Math.abs(Number(v)),tone:i===0?'main':i===1?'good':'prop'}));
    return {total:main.toLocaleString('es',{maximumFractionDigits:2}),sub:out._insight || out.detalle || out.resumen || cfg.title,rows,chart,format:'ars'};
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
