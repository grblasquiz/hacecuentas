---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import DominicanaHomeExperience from '../../components/generated/DominicanaHomeExperience.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
import { canDistributeCalc } from '../../lib/content-policy';
import { createLocaleCalcUrl } from '../../lib/locale-calc-url';
import { REPUBLICA_DOMINICANA_2026, fmtDOP } from '../../lib/data/republica-dominicana-2026';

const localeModules = import.meta.glob<any>('../../content/calcs-do/*.json', { eager: true });
const mainModules = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
const localeCalcs = Object.values(localeModules).map((m: any) => m.default || m).filter((c: any) => canDistributeCalc(c, 'do'));
const audienceFiltered = Object.values(mainModules)
  .map((m: any) => m.default || m)
  .filter((c: any) => c.audience === 'DO' && canDistributeCalc(c));
const calcs = [...localeCalcs, ...audienceFiltered];

const calcUrl = createLocaleCalcUrl('do', localeCalcs);

const byCategory: Record<string, any[]> = {};
calcs.forEach((c) => {
  if (!byCategory[c.category]) byCategory[c.category] = [];
  byCategory[c.category].push(c);
});

const categoryMeta: Record<string, { label: string; desc: string; color: string; icon: string }> = {
  finanzas:        { label: 'Finanzas',       desc: 'Sueldo, prestaciones laborales, dólar y peso dominicano.',     color: '#2563eb', icon: '💰' },
  impuestos:       { label: 'Impuestos',      desc: 'ISR 2026, ITBIS 18%, retenciones de la DGII.',                color: '#7c3aed', icon: '🧾' },
  salud:           { label: 'Salud',          desc: 'IMC, calorías, embarazo, fitness.',                  color: '#16a34a', icon: '❤️' },
  familia:         { label: 'Familia',        desc: 'Licencia maternidad, hijos, escolarización.',                  color: '#db2777', icon: '👨‍👩‍👧' },
  vida:            { label: 'Vida cotidiana', desc: 'Alquiler, costo de vida, mercado.',                     color: '#d97706', icon: '🏠' },
  automotor:       { label: 'Automotor',      desc: 'Combustible, placa, gasto del vehículo.',                     color: '#6366f1', icon: '🚗' },
  educacion:       { label: 'Educación',      desc: 'Becas, créditos universitarios, promedios.',                color: '#8b5cf6', icon: '🎓' },
  negocios:        { label: 'Negocios',       desc: 'Márgenes, ITBIS, retenciones, modelos fiscales.',          color: '#0891b2', icon: '📊' },
  marketing:       { label: 'Marketing',      desc: 'CTR, CPC, ROAS, CAC, LTV.',                          color: '#e11d48', icon: '📈' },
  deportes:        { label: 'Deportes',       desc: 'Pace, 1RM, VO2 max, ciclismo.',                      color: '#65a30d', icon: '🏃' },
  viajes:          { label: 'Viajes',         desc: 'Combustible, presupuesto, propinas.',                color: '#0891b2', icon: '✈️' },
  cocina:          { label: 'Cocina',         desc: 'Tazas a gramos, ajustar receta.',                    color: '#ea580c', icon: '🍳' },
  mascotas:        { label: 'Mascotas',       desc: 'Edad perro/gato, alimentación.',                     color: '#db2777', icon: '🐕' },
  matematica:      { label: 'Matemática',     desc: 'Promedios, Pitágoras, conversores.',                 color: '#0d9488', icon: '🧮' },
  tecnologia:      { label: 'Tecnología',     desc: 'Almacenamiento, IA, batería, cloud.',                color: '#06b6d4', icon: '💻' },
  'medio-ambiente':{ label: 'Medio Ambiente', desc: 'Huella de carbono, energía solar.',                  color: '#22c55e', icon: '🌱' },
  electronica:     { label: 'Electrónica',    desc: 'Ley de Ohm, kWh, circuitos.',                        color: '#f59e0b', icon: '⚡' },
  ciencia:         { label: 'Ciencia',        desc: 'Física, química, astronomía.',                       color: '#6366f1', icon: '🔬' },
  jardineria:      { label: 'Jardinería',     desc: 'Riego, tierra, siembra.',                            color: '#15803d', icon: '🌿' },
  construccion:    { label: 'Construcción',   desc: 'Materiales, presupuesto reforma.',                   color: '#b45309', icon: '🧱' },
};

const categoryOrder = ['finanzas','impuestos','vida','familia','salud','automotor','educacion','negocios','marketing','deportes','viajes','cocina','mascotas','matematica','tecnologia','medio-ambiente','electronica','ciencia','jardineria','construccion'];
const activeCategories = categoryOrder.filter((cat) => byCategory[cat] && byCategory[cat].length > 0);

const totalCalcs = calcs.length;

const popularSlugs = [
  'salario-neto-republica-dominicana',
  'calculadora-liquidacion-republica-dominicana',
  'calculadora-cesantia-republica-dominicana',
  'regalia-pascual-republica-dominicana',
  'calculadora-itbis-republica-dominicana',
  'calculadora-isr-republica-dominicana'
];
const popular = popularSlugs.map((s) => calcs.find((c) => c.slug === s)).filter(Boolean);

// ── Datos clave 2026 — todo computado desde src/lib/data/republica-dominicana-2026.ts (fuente única, nunca stale) ──
const D = REPUBLICA_DOMINICANA_2026;
const fmtPct = (n: number) => new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 }).format(n);
const sm = D.salarioMinimo.noSectorizado;
// Tramos ISR mensualizados (la escala del data file es anual): se divide ÷12 para el desglose mensual.
const isrExencionMensual = D.isr.exencionAnual / 12;
const isr15Desde = D.isr.tramos[1].desde / 12;
const isr20Desde = D.isr.tramos[2].desde / 12;
const isr25Desde = D.isr.tramos[3].desde / 12;

const datosClave = [
  { k: 'Salario mínimo sector privado (empresa grande)', v: `${fmtDOP(sm.grande)} /mes`, src: 'Comité Nacional de Salarios (CNS-01-2025)' },
  { k: 'Salario mínimo (mediana / pequeña / micro)', v: `${fmtDOP(sm.mediana)} · ${fmtDOP(sm.pequena)} · ${fmtDOP(sm.micro)}`, src: 'CNS · Ministerio de Trabajo' },
  { k: 'Salario mínimo zonas francas', v: `${fmtDOP(D.salarioMinimo.zonasFrancas)} /mes`, src: 'CNS-03-2025' },
  { k: 'AFP — pensiones (descuento del trabajador)', v: `${fmtPct(D.tss.afpEmpleado * 100)}%`, src: 'TSS · SIPEN (Ley 87-01)' },
  { k: 'SFS — salud (descuento del trabajador)', v: `${fmtPct(D.tss.sfsEmpleado * 100)}%`, src: 'TSS · SISALRIL' },
  { k: 'Total descuento TSS del empleado', v: `${fmtPct(D.tss.totalEmpleado * 100)}% (AFP + SFS)`, src: 'TSS (tss.gob.do)' },
  { k: 'Exención anual de ISR', v: `${fmtDOP(D.isr.exencionAnual)} (${fmtDOP(isrExencionMensual)}/mes)`, src: 'DGII · Art. 296 Cód. Tributario' },
  { k: 'Escala de ISR (tasas marginales)', v: `0% · 15% · 20% · 25%`, src: 'DGII (congelada desde 2018)' },
  { k: 'ITBIS (tasa general)', v: `${fmtPct(D.itbis * 100)}%`, src: 'DGII · Ley 253-12' },
  { k: 'Auxilio de cesantía (Art. 80)', v: `6 / 13 días fijos · 21 días/año (1–5 a.) · 23 días/año (+5 a.)`, src: 'Código de Trabajo · Ley 16-92' },
  { k: 'Preaviso (Art. 76)', v: `7 / 14 / 28 días según antigüedad`, src: 'Código de Trabajo · Ley 16-92' },
  { k: 'Regalía pascual (doble sueldo)', v: `Salario anual ÷ ${D.laboral.regaliaPascual.divisor} · EXENTA de ISR`, src: 'Art. 219 Cód. Trabajo · Ley 16-92' },
  { k: 'Divisor universal de nómina', v: `${new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2 }).format(D.divisorDiario)} días/mes (hora = ÷ ${D.horasMensuales})`, src: 'Reglamento 258-93 · MT' },
];

// ── FAQ país-específica: respuestas con cifras computadas desde la fuente única ──
const faq = [
  {
    q: '¿Cómo se calcula la liquidación laboral en República Dominicana?',
    a: `La liquidación reúne las prestaciones que el Código de Trabajo (Ley 16-92) ordena pagar al terminar el contrato: el preaviso (Art. 76: ${D.laboral.preaviso[0].dias}, ${D.laboral.preaviso[1].dias} o ${D.laboral.preaviso[2].dias} días según antigüedad), el auxilio de cesantía (Art. 80), las vacaciones no disfrutadas y la proporción de la regalía pascual. Todo se calcula sobre el salario diario = salario mensual ÷ ${new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2 }).format(D.divisorDiario)}, el divisor universal de nómina dominicano.`,
  },
  {
    q: '¿Cuánto es la cesantía y cómo se calcula?',
    a: `El auxilio de cesantía (Art. 80) depende de la antigüedad: ${D.laboral.cesantia[0].dias} días para 3–6 meses, ${D.laboral.cesantia[1].dias} días para 6 meses a 1 año (montos fijos), luego ${D.laboral.cesantia[2].dias} días de salario por cada año entre 1 y 5 años, y ${D.laboral.cesantia[3].dias} días por cada año a partir de los 5 años. Se calcula sobre el salario diario ordinario (salario mensual ÷ ${new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2 }).format(D.divisorDiario)}) y solo aplica en despido sin causa o desahucio.`,
  },
  {
    q: '¿Qué es la regalía pascual y cuándo se paga?',
    a: `La regalía pascual (Art. 219), también llamada salario de Navidad o "doble sueldo", equivale al salario ordinario devengado entre enero y diciembre dividido entre ${D.laboral.regaliaPascual.divisor}. Para un sueldo fijo y año completo es prácticamente un sueldo extra. Se paga antes del 20 de diciembre, está EXENTA de ISR y NO cotiza a la TSS, con un tope de ${D.laboral.regaliaPascual.topeSalariosMinimos} salarios mínimos. No incluye horas extra, propinas ni participación en beneficios.`,
  },
  {
    q: '¿Cuánto me descuenta la TSS del salario?',
    a: `Al trabajador se le descuenta un ${fmtPct(D.tss.totalEmpleado * 100)}% de la TSS: ${fmtPct(D.tss.afpEmpleado * 100)}% para la AFP (pensiones) y ${fmtPct(D.tss.sfsEmpleado * 100)}% para el SFS (salud, SeNaSa/ARS). Estos descuentos se topan en el salario cotizable máximo: ${fmtDOP(D.tss.topeSfs)} para salud y ${fmtDOP(D.tss.topeAfp)} para pensiones. El empleador aporta aparte (SFS, AFP, riesgos laborales y solidaridad).`,
  },
  {
    q: '¿Cuál es el salario mínimo en República Dominicana 2026?',
    a: `No hay un salario mínimo único: el Comité Nacional de Salarios lo fija por sector y tamaño de empresa. En el sector privado no sectorizado es de ${fmtDOP(sm.grande)} en empresas grandes, ${fmtDOP(sm.mediana)} en medianas, ${fmtDOP(sm.pequena)} en pequeñas y ${fmtDOP(sm.micro)} en microempresas. En zonas francas es de ${fmtDOP(D.salarioMinimo.zonasFrancas)}. Hotelería, construcción y otros sectores tienen sus propias resoluciones.`,
  },
  {
    q: '¿Cuánto ISR pago sobre mi sueldo en 2026?',
    a: `El ISR de personas físicas usa una escala anual progresiva (congelada desde 2018): el ingreso anual hasta ${fmtDOP(D.isr.exencionAnual)} (${fmtDOP(isrExencionMensual)}/mes) está exento. Entre ${fmtDOP(isr15Desde)} y ${fmtDOP(isr20Desde)} mensuales se paga 15% sobre el excedente; entre ${fmtDOP(isr20Desde)} y ${fmtDOP(isr25Desde)}, 20%; y por encima de ${fmtDOP(isr25Desde)}/mes, 25%. La base es el salario menos la AFP y el SFS, que son deducibles.`,
  },
  {
    q: '¿Qué es el ITBIS y cuánto se paga?',
    a: `El ITBIS (Impuesto sobre Transferencias de Bienes Industrializados y Servicios) es el IVA dominicano. La tasa general es del ${fmtPct(D.itbis * 100)}% (DGII, Ley 253-12). Hay una tasa reducida del ${fmtPct(D.itbisReducido * 100)}% para ciertos alimentos (yogurt, café, aceites, azúcares, cacao) y exenciones del 0% para la canasta básica, medicinas, salud, educación, transporte y alquiler de vivienda.`,
  },
  {
    q: '¿Cómo se calcula el salario diario y el valor de la hora?',
    a: `El salario diario es el salario mensual dividido entre ${new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2 }).format(D.divisorDiario)} (el divisor universal de nómina, del Reglamento 258-93), y el valor de la hora es el salario mensual dividido entre ${D.horasMensuales}. Estos divisores se usan en toda la nómina dominicana: cesantía, preaviso, vacaciones, regalía y horas extra. Las horas extra entre la 44 y la 68 semanal se pagan con un recargo del ${fmtPct(D.laboral.recargos.extra44a68 * 100)}%.`,
  },
  {
    q: '¿Cuántos días de vacaciones corresponden por ley?',
    a: `Las vacaciones (Art. 177) se generan a partir del año de trabajo: ${D.laboral.vacaciones.menos5anios} días laborables con menos de 5 años de antigüedad y ${D.laboral.vacaciones.desde5anios} días a partir de los 5 años. Se pagan sobre el salario ordinario. Si no se completa el año, en contrato indefinido corresponde una proporción (por ejemplo, ${D.laboral.vacaciones.proporcional[6]} días a los 6 meses).`,
  },
];

// ── Equivalencias AR → DO: inyecta autoridad interna desde el catálogo argentino ya posicionado ──
const equivalentesAr = [
  { ar: 'calculadora-aguinaldo-sac', arLabel: 'Aguinaldo (SAC) Argentina', do: 'regalia-pascual-republica-dominicana', doLabel: 'Regalía pascual (doble sueldo)', concepto: 'Aguinaldo / regalía pascual' },
  { ar: 'calculadora-vacaciones-argentina', arLabel: 'Vacaciones Argentina', do: 'salario-neto-republica-dominicana', doLabel: 'Salario neto (con TSS e ISR)', concepto: 'Sueldo y nómina' },
  { ar: 'calculadora-indemnizacion-despido', arLabel: 'Indemnización por despido Argentina', do: 'calculadora-liquidacion-republica-dominicana', doLabel: 'Liquidación laboral', concepto: 'Indemnización / liquidación' },
  { ar: 'calculadora-indemnizacion-despido', arLabel: 'Indemnización por despido Argentina', do: 'calculadora-cesantia-republica-dominicana', doLabel: 'Auxilio de cesantía (Art. 80)', concepto: 'Cesantía' },
  { ar: 'calculadora-iva', arLabel: 'IVA Argentina', do: 'calculadora-itbis-republica-dominicana', doLabel: 'ITBIS República Dominicana (18%)', concepto: 'IVA / ITBIS' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['CollectionPage', 'WebPage'],
      '@id': 'https://hacecuentas.com/do#webpage',
      url: 'https://hacecuentas.com/do',
      name: 'Calculadoras República Dominicana 2026 — ISR, ITBIS, cesantía, regalía pascual | Hacé Cuentas',
      description: `Calculadoras gratis específicas para República Dominicana.`,
      inLanguage: 'es-DO',
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      breadcrumb: { '@id': 'https://hacecuentas.com/do#breadcrumb' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://hacecuentas.com/do#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Hacé Cuentas', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'República Dominicana', item: 'https://hacecuentas.com/do' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://hacecuentas.com/do#faq',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Dataset',
      '@id': 'https://hacecuentas.com/do#datos-2026',
      name: 'Datos laborales, fiscales y cambiarios de República Dominicana 2026',
      description: `Valores oficiales vigentes en República Dominicana 2026: salario mínimo por sector (CNS), descuentos de la TSS (AFP ${fmtPct(D.tss.afpEmpleado * 100)}% + SFS ${fmtPct(D.tss.sfsEmpleado * 100)}%), escala de ISR de la DGII, ITBIS ${fmtPct(D.itbis * 100)}%, auxilio de cesantía y preaviso del Código de Trabajo (Ley 16-92), regalía pascual exenta y el divisor universal de nómina de ${new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2 }).format(D.divisorDiario)}.`,
      url: 'https://hacecuentas.com/do',
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      inLanguage: 'es-DO',
      temporalCoverage: '2026',
      spatialCoverage: { '@type': 'Place', name: 'Dominican Republic' },
      creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
      sourceOrganization: [
        { '@type': 'GovernmentOrganization', name: 'Ministerio de Trabajo de la República Dominicana', url: 'https://www.mt.gob.do' },
        { '@type': 'GovernmentOrganization', name: 'Tesorería de la Seguridad Social (TSS)', url: 'https://www.tss.gob.do' },
        { '@type': 'GovernmentOrganization', name: 'Dirección General de Impuestos Internos (DGII)', url: 'https://dgii.gov.do' },
        { '@type': 'GovernmentOrganization', name: 'Banco Central de la República Dominicana (BCRD)', url: 'https://www.bancentral.gov.do' },
      ],
      keywords: ['salario mínimo República Dominicana 2026', 'ISR República Dominicana', 'ITBIS 18%', 'auxilio de cesantía Art. 80', 'regalía pascual', 'descuento TSS AFP SFS', 'preaviso Código de Trabajo', 'liquidación laboral RD', 'divisor 23,83'],
    },
  ],
};

// Set hreflang único y simétrico para todas las homes (es + en + pt +
// 6 verticales + global), x-default → home raíz. Ver src/lib/hreflang.ts.
const hreflangTags = HOME_HREFLANG;

// Identidad de hub (mockup): hero vía PillarHub full-bleed; el contenido del país
// (populares, categorías, datos, FAQ) se preserva debajo dentro de .cc-index.
const hubConfig = {
  color: '#2563eb',
  nav: 'República Dominicana',
  h1: 'Calculadoras para República Dominicana',
  breadcrumb: [{ label: 'Hacé Cuentas', href: '/' }, { label: 'República Dominicana' }],
  eyebrow: '🇩🇴 República Dominicana · 2026',
  titleLines: ['Calculadoras', 'para República Dominicana'],
  lead: 'Salario neto, liquidación, auxilio de cesantía, regalía pascual, ISR e ITBIS. Datos oficiales de la DGII, la TSS y el Ministerio de Trabajo (Código de Trabajo, Ley 16-92). Gratis.',
  trust: [`${totalCalcs} calculadoras`, 'Datos oficiales 2026', 'Gratis y sin registro'],
  needsKicker: '', needsTitle: '', needsSub: '', needs: [] as any[],
  featuredKicker: '', featuredTitle: '', featuredSub: '', showFeaturedSearch: false, filterBadges: [] as string[], cards: [] as any[],
  roomsKicker: '', roomsTitle: '', roomsSub: '', rooms: [] as any[], factsTitle: '', facts: [] as any[],
};
---

<Layout
  title="Calculadoras República Dominicana 2026 — ISR, ITBIS, cesantía, regalía pascual | Hacé Cuentas"
  description={`${totalCalcs} calculadoras gratis para República Dominicana: salario neto, liquidación, cesantía, regalía pascual, ISR e ITBIS 18%. Datos oficiales 2026 de la DGII, TSS y Ministerio de Trabajo.`}
  lang="es"
  audience="DO"
  hreflang={hreflangTags}
  schema={schema}
  pageType="hub"
>
  <Header slot="header" />

  <DominicanaHomeExperience />

  <div class="cc-index">

    {popular.length > 0 && (
      <section class="popular-section" aria-label="Más usadas">
        <h2 class="popular-title">Más usadas en República Dominicana</h2>
        <div class="popular-grid">
          {popular.map((c: any) => (
            <a href={calcUrl(c)} class="popular-card">
              <span class="popular-icon">{c.icon || '🧮'}</span>
              <span class="popular-label">{c.h1}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="datos-clave" aria-labelledby="datos-clave-title">
      <h2 id="datos-clave-title">Datos clave de República Dominicana 2026</h2>
      <p class="section-sub">Los valores oficiales que usan todas nuestras calculadoras dominicanas. Uso libre con atribución (CC-BY 4.0).</p>
      <div class="dc-wrap">
        <table class="dc-table">
          <thead>
            <tr><th>Concepto</th><th>Valor 2026</th><th>Fuente</th></tr>
          </thead>
          <tbody>
            {datosClave.map((d) => (
              <tr><td>{d.k}</td><td>{d.v}</td><td class="dc-src">{d.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dc-note">Última revisión: {D.fx.fecha}. Fuentes: Ministerio de Trabajo, TSS, DGII y BCRD. La escala del ISR está congelada desde 2018; el salario mínimo lo fija el CNS por sector.</p>
    </section>

    <section class="popular-section" aria-label="Más recursos de República Dominicana">
      <h2 class="popular-title">Más recursos de República Dominicana</h2>
      <div class="popular-grid">
        <a href="/do/salario-neto-republica-dominicana" class="popular-card"><span class="popular-icon">💵</span><span class="popular-label">Salario neto (TSS + ISR)</span></a>
        <a href="/do/regalia-pascual-republica-dominicana" class="popular-card"><span class="popular-icon">🎄</span><span class="popular-label">Regalía pascual (doble sueldo)</span></a>
        <a href="/datos-salario-minimo-latam-2026" class="popular-card"><span class="popular-icon">🌎</span><span class="popular-label">Salario mínimo LATAM</span></a>
        <a href="/prestaciones-laborales-por-pais" class="popular-card"><span class="popular-icon">📋</span><span class="popular-label">Prestaciones laborales por país</span></a>
      </div>
    </section>

    <div class="categories">
      {activeCategories.map((catKey) => {
        const meta = categoryMeta[catKey];
        const catCalcs = byCategory[catKey];
        return (
          <section class="category-section" aria-labelledby={`cat-${catKey}`}>
            <div class="cat-header">
              <span class="cat-icon" aria-hidden="true" style={`background: ${meta?.color}18`}>{meta?.icon ?? '📁'}</span>
              <div class="cat-meta">
                <h2 id={`cat-${catKey}`} class="cat-label">{meta?.label ?? catKey}</h2>
                {meta?.desc && <p class="cat-desc">{meta.desc}</p>}
              </div>
            </div>
            <div class="calc-grid">
              {catCalcs.map((calc: any) => (
                <a href={calcUrl(calc)} class="calc-card">
                  <span class="card-icon" aria-hidden="true">{calc.icon}</span>
                  <div class="card-body">
                    <span class="card-title">{calc.h1}</span>
