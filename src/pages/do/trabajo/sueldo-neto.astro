---
/**
 * Hub de decisión DO — "De tu salario bruto a lo que cobrás en mano".
 * El audience="DO" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SueldoNetoDominicanaExperience from '../../../components/generated/SueldoNetoDominicanaExperience.astro';
import {
  hub,
  TSS,
  ISR_TRAMOS,
  ISR_EXENCION_ANUAL,
  DIVISOR_DIARIO,
  HORAS_MES,
  RECARGOS,
  SALARIO_MINIMO,
} from '../../../lib/hubs/do/sueldo-neto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="DO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoNetoDominicanaExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    TSS,
    TRAMOS: ISR_TRAMOS,
    EXENCION: ISR_EXENCION_ANUAL,
    DIVISOR_DIARIO,
    HORAS_MES,
    RECARGOS,
    SM: SALARIO_MINIMO,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const dop = (n) => 'RD$ ' + Math.round(n || 0).toLocaleString('de-DE');

    /** ISR anual (Art. 296): cuota fija + tasa marginal sobre el excedente del tramo. */
    function isrAnual(base) {
      const b = Math.max(0, base);
      if (b <= EXENCION) return { impuesto: 0, marginal: 0, tramo: TRAMOS[0] };
      for (const t of TRAMOS) {
        const hasta = t.hasta === null ? Infinity : t.hasta;
        if (b > t.desde && b <= hasta) {
          return { impuesto: t.cuotaFija + (b - t.desde) * t.tasa, marginal: t.tasa * 100, tramo: t };
        }
      }
      return { impuesto: 0, marginal: 0, tramo: TRAMOS[0] };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'mensual';
      const brutoJornadaCompleta = Math.max(0, v.bruto || 0);
      const horasSemana = Math.min(44, Math.max(1, v.horasSemana || 44));
      const horasExtra = Math.max(0, v.horasExtra || 0);
      const horasNoct = Math.max(0, v.horasNocturnas || 0);

      // Salario ordinario devengado: proporcional a la jornada real.
      const ordinario = brutoJornadaCompleta * (horasSemana / 44);
      const valorHora = ordinario / HORAS_MES;
      const valorDia = ordinario / DIVISOR_DIARIO;

      // Recargos del Art. 203/204. El nocturno es sólo el plus: la hora base ya
      // está pagada dentro del salario ordinario.
      const pagoExtra = horasExtra * valorHora * (1 + RECARGOS.extra44a68);
      const pagoNocturno = horasNoct * valorHora * RECARGOS.nocturno;
      const bruto = ordinario + pagoExtra + pagoNocturno;

      // TSS: bases topeadas, sobre el exceso no se cotiza.
      const baseAfp = Math.min(bruto, TSS.topeAfp);
      const baseSfs = Math.min(bruto, TSS.topeSfs);
      const afp = baseAfp * TSS.afpEmpleado;
      const sfs = baseSfs * TSS.sfsEmpleado;
      const tss = afp + sfs;

      // ISR: base mensual anualizada, escala anual, ÷ 12.
      const baseIsrMensual = Math.max(0, bruto - tss);
      const r = isrAnual(baseIsrMensual * 12);
      const isr = r.impuesto / 12;

      const neto = bruto - tss - isr;
      const tasaDescuento = bruto > 0 ? ((tss + isr) / bruto) * 100 : 0;

      // La regalía pascual entra completa al año: exenta de ISR, no cotiza TSS.
      const regalia = ordinario;
      const netoAnual = neto * 12 + regalia;

      const rows = [
        { k: 'Salario ordinario devengado del mes', ref: horasSemana < 44 ? horasSemana + ' h/semana sobre 44' : 'Jornada completa', v: ordinario },
        { k: 'Valor de la hora ordinaria', ref: 'Salario ÷ ' + HORAS_MES + ' h/mes', v: valorHora, decimals: 2 },
        { k: 'Valor del día', ref: 'Salario ÷ ' + String(DIVISOR_DIARIO).replace('.', ',') + ' · Regl. 258-93', v: valorDia, decimals: 2 },
      ];

      if (pagoExtra > 0) {
        rows.push({
          k: horasExtra + ' hora(s) extra al ' + Math.round((1 + RECARGOS.extra44a68) * 100) + '% de la hora',
          ref: 'Art. 203 · recargo +' + Math.round(RECARGOS.extra44a68 * 100) + '%',
          v: pagoExtra,
        });
      }
      if (pagoNocturno > 0) {
        rows.push({
          k: 'Recargo nocturno por ' + horasNoct + ' hora(s)',
          ref: 'Art. 204 · +' + Math.round(RECARGOS.nocturno * 100) + '% de la hora',
          v: pagoNocturno,
        });
      }

      rows.push({ k: 'Bruto total del mes', ref: 'Base de TSS e ISR', v: bruto });
      rows.push({
        k: 'AFP — pensiones (se resta)',
        ref: (TSS.afpEmpleado * 100).toFixed(2).replace('.', ',') + '% · tope ' + dop(TSS.topeAfp),
        v: afp,
      });
      rows.push({
        k: 'SFS — salud (se resta)',
        ref: (TSS.sfsEmpleado * 100).toFixed(2).replace('.', ',') + '% · tope ' + dop(TSS.topeSfs),
        v: sfs,
      });
      rows.push({ k: 'Total descuento TSS', ref: '5,91% del salario cotizable', v: tss });
      rows.push({ k: 'Base gravable del ISR', ref: 'Bruto − AFP − SFS', v: baseIsrMensual });
      rows.push({
        k: 'Base anualizada del ISR',
        ref: 'Exención ' + dop(EXENCION) + ' al año',
        v: baseIsrMensual * 12,
      });
      rows.push({
        k: 'Tramo del Art. 296 en el que caés',
        ref: r.tramo.hasta === null ? 'Desde ' + dop(r.tramo.desde) : dop(r.tramo.desde) + ' a ' + dop(r.tramo.hasta),
        v: r.marginal,
        format: 'unit',
        unit: '% marginal',
      });
      rows.push({ k: 'Retención mensual de ISR (se resta)', ref: 'Escala anual ÷ 12', v: isr });
      rows.push({ k: 'Salario neto en mano', ref: 'Bruto − TSS − ISR', v: neto, extra: true });
      rows.push({
        k: 'Descuentos totales sobre el bruto',
        ref: 'TSS + ISR',
        v: tasaDescuento,
        format: 'unit',
        unit: '%',
        decimals: 2,
      });
      rows.push({ k: 'Regalía pascual del año completo', ref: 'Exenta de ISR y sin TSS', v: regalia });
      rows.push({ k: 'Neto anual con la regalía', ref: '12 netos + regalía completa', v: netoAnual, extra: true });
      rows.push({
        k: 'Tu bruto medido en salarios mínimos de empresa grande',
        ref: 'Mínimo no sectorizado ' + dop(SM.grande),
        v: SM.grande > 0 ? bruto / SM.grande : 0,
        format: 'unit',
        unit: 'salarios mínimos',
        decimals: 2,
      });

      let sub =
        (isr > 0
          ? 'Pagás ISR: tu base anual entra en el tramo del ' + r.marginal + '%'
          : 'No pagás ISR: tu base anual no supera la exención de ' + dop(EXENCION)) +
        ' · entre TSS e ISR se va el ' + tasaDescuento.toFixed(2).replace('.', ',') + '% del bruto' +
        ' · al año cobrás ' + dop(netoAnual) + ' netos contando la regalía';

      if (id === 'extras' && horasExtra > RECARGOS.maxExtraTrimestre / 3) {
        sub += ' · ojo con el tope de ' + RECARGOS.maxExtraTrimestre + ' horas extra por trimestre';
      }
      if (id === 'minimo' && bruto < SM.micro) {
        sub += ' · tu bruto está por debajo del mínimo de microempresa (' + dop(SM.micro) + ')';
      }

      return {
        total: dop(neto),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Neto en mano', value: Math.max(0, Math.round(neto)), tone: 'main' },
          { label: 'AFP + SFS (TSS)', value: Math.round(tss), tone: 'prop' },
          { label: 'Retención de ISR', value: Math.round(isr), tone: 'warn' },
        ],
      };
    });
  })();
</script>
