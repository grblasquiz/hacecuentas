---
/**
 * Hub de decisión DO — "De tu salario bruto a lo que cobrás en mano".
 * El audience="DO" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import SueldoNetoDominicanaExperience from '../../../components/generated/SueldoNetoDominicanaExperience.astro';
import {
  hub,
  TSS,
  ISR_TRAMOS,
  ISR_EXENCION_ANUAL,
  DIVISOR_DIARIO,
  HORAS_MES,
  RECARGOS,
  SALARIO_MINIMO,
} from '../../../lib/hubs/do/sueldo-neto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="DO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoNetoDominicanaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

