---
/**
 * Hub de decisión DO — "Se terminó tu contrato: qué te tienen que pagar".
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  CESANTIA,
  PREAVISO,
  VACACIONES,
  DIVISOR_DIARIO,
  PLAZO_ART86_DIAS,
} from '../../../lib/hubs/do/liquidacion';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="DO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ CESANTIA, PREAVISO, VACACIONES, DIVISOR_DIARIO, PLAZO_ART86_DIAS }}
>
  (function () {
    const H = window.HC_HUB;
    const dop = (n) => 'RD$ ' + Math.round(n || 0).toLocaleString('de-DE');

    /** Días de cesantía (Art. 80) según antigüedad en meses. */
    function cesantiaDias(meses) {
      const t = CESANTIA.find(function (x) {
        const hasta = x.hastaMeses === null ? Infinity : x.hastaMeses;
        return meses > x.desdeMeses && meses <= hasta;
      }) || (meses > 60 ? CESANTIA[CESANTIA.length - 1] : null);
      if (!t) return { dias: 0, tramo: null };
      if (!t.porAnio) return { dias: t.dias, tramo: t };
      return { dias: t.dias * Math.floor(meses / 12), tramo: t };
    }

    /** Días de preaviso (Art. 76) según antigüedad en meses. */
    function preavisoDias(meses) {
      const t = PREAVISO.find(function (x) {
        const hasta = x.hastaMeses === null ? Infinity : x.hastaMeses;
        return meses > x.desdeMeses && meses <= hasta;
      }) || (meses > 12 ? PREAVISO[PREAVISO.length - 1] : null);
      return t ? t.dias : 0;
    }

    /** Días de vacaciones (Art. 177) o tabla proporcional (Art. 180). */
    function vacacionesDias(anios, mesesExtra) {
      const total = anios * 12 + mesesExtra;
      if (total >= 60) return VACACIONES.desde5anios;
      if (total >= 12) return VACACIONES.menos5anios;
      const tabla = VACACIONES.proporcional || {};
      return tabla[String(Math.floor(total))] != null ? tabla[String(Math.floor(total))] : (tabla[Math.floor(total)] || 0);
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'despido';
      const salario = Math.max(0, v.salario || 0);
      const anios = Math.max(0, Math.floor(v.anios || 0));
      const mesesExtra = Math.min(11, Math.max(0, Math.floor(v.meses || 0)));
      const mesesRegalia = Math.min(12, Math.max(0, v.mesesRegalia || 0));
      const pendiente = Math.max(0, v.pendiente || 0);
      const diasDesdeSalida = Math.max(0, Math.floor(v.diasDesdeSalida || 0));

      const totalMeses = anios * 12 + mesesExtra;
      const diario = salario / DIVISOR_DIARIO;

      // Cesantía y preaviso: sólo cuando el contrato termina por causa del empleador
      // o por dimisión justificada del trabajador (arts. 75, 95 y 98).
      const conPrestaciones = id === 'despido' || id === 'desahucio' || id === 'dimision';
      const ces = conPrestaciones ? cesantiaDias(totalMeses) : { dias: 0, tramo: null };
      const diasPreaviso = conPrestaciones ? preavisoDias(totalMeses) : 0;

      const cesantia = ces.dias * diario;
      const preaviso = diasPreaviso * diario;

      const diasVac = vacacionesDias(anios, mesesExtra);
      const vacaciones = diasVac * diario;

      // Regalía pascual proporcional: (salario × meses del año) ÷ 12.
      const regalia = (salario * mesesRegalia) / 12;

      const subtotal = cesantia + preaviso + vacaciones + regalia + pendiente;

      // Art. 86: un día de salario por cada día de retraso a partir del día 11.
      const diasRetraso = Math.max(0, diasDesdeSalida - PLAZO_ART86_DIAS);
      const penalidad = diasRetraso * diario;

      const total = subtotal + penalidad;
      const mesesDeSueldo = salario > 0 ? total / salario : 0;

      const rows = [
        {
          k: 'Salario diario',
          ref: 'Mensual ÷ ' + String(DIVISOR_DIARIO).replace('.', ',') + ' · Regl. 258-93',
          v: diario,
          decimals: 2,
        },
        {
          k: 'Antigüedad computada',
          ref: anios + ' año(s) y ' + mesesExtra + ' mes(es)',
          v: totalMeses,
          format: 'unit',
          unit: 'meses',
        },
      ];

      if (conPrestaciones) {
        rows.push({
          k: 'Días de auxilio de cesantía',
          ref: ces.tramo
            ? ces.tramo.porAnio
              ? ces.tramo.dias + ' días por año · Art. 80'
              : ces.tramo.dias + ' días fijos · Art. 80'
            : 'Sin derecho (menos de 3 meses)',
          v: ces.dias,
          format: 'unit',
          unit: 'días',
        });
        rows.push({ k: 'Auxilio de cesantía', ref: 'Art. 80 · exento de ISR y TSS', v: cesantia });
        rows.push({
          k: 'Días de preaviso',
          ref: diasPreaviso > 0 ? 'Art. 76' : 'Sin derecho (menos de 3 meses)',
          v: diasPreaviso,
          format: 'unit',
          unit: 'días',
        });
        rows.push({ k: 'Preaviso en dinero', ref: 'Art. 76', v: preaviso });
      } else {
        rows.push({
          k: 'Cesantía y preaviso que perdés al renunciar sin causa',
          ref: 'Lo que cobrarías con desahucio del empleador',
          v: cesantiaDias(totalMeses).dias * diario + preavisoDias(totalMeses) * diario,
        });
      }

      rows.push({
        k: 'Días de vacaciones',
        ref: totalMeses >= 60 ? 'Art. 177 · 5 años o más' : totalMeses >= 12 ? 'Art. 177 · 1 a 5 años' : 'Art. 180 · proporcional',
        v: diasVac,
        format: 'unit',
        unit: 'días',
      });
      rows.push({ k: 'Vacaciones no disfrutadas', ref: 'Días laborables de salario', v: vacaciones });
      rows.push({
        k: 'Regalía pascual proporcional',
        ref: mesesRegalia + '/12 del salario · exenta de ISR',
        v: regalia,
      });
      if (pendiente > 0) {
        rows.push({ k: 'Salario y comisiones pendientes', ref: 'Último período trabajado', v: pendiente });
      }
      rows.push({ k: 'Subtotal de prestaciones', ref: 'Antes de la mora', v: subtotal });
      rows.push({
        k: 'Días de retraso del Art. 86',
        ref: 'A partir del día ' + (PLAZO_ART86_DIAS + 1) + ' sin pago',
        v: diasRetraso,
        format: 'unit',
        unit: 'días',
      });
      rows.push({ k: 'Penalidad acumulada por mora', ref: 'Art. 86 · 1 día de salario por día', v: penalidad });
      rows.push({ k: 'Total a cobrar', ref: 'Prestaciones + mora', v: total, extra: true });
      rows.push({
        k: 'Tu liquidación medida en sueldos',
        ref: 'Total ÷ salario mensual',
        v: mesesDeSueldo,
        format: 'unit',
        unit: 'sueldos',
        decimals: 2,
      });

      let sub =
        (conPrestaciones
          ? 'Te corresponden ' + ces.dias + ' días de cesantía y ' + diasPreaviso + ' de preaviso'
          : 'Sin cesantía ni preaviso: al renunciar sin causa se pierden') +
        ' · equivale a ' + mesesDeSueldo.toFixed(2).replace('.', ',') + ' sueldos';

      sub += diasRetraso > 0
        ? ' · la mora del Art. 86 ya suma ' + dop(penalidad) + ' y crece ' + dop(diario) + ' por día'
        : ' · el empleador tiene ' + Math.max(0, PLAZO_ART86_DIAS - diasDesdeSalida) + ' día(s) antes de que corra la mora';

      const chart = [];
      if (cesantia > 0) chart.push({ label: 'Auxilio de cesantía', value: Math.round(cesantia), tone: 'main' });
      if (preaviso > 0) chart.push({ label: 'Preaviso', value: Math.round(preaviso), tone: 'prop' });
      if (vacaciones > 0) chart.push({ label: 'Vacaciones', value: Math.round(vacaciones), tone: 'good' });
      if (regalia > 0) chart.push({ label: 'Regalía proporcional', value: Math.round(regalia), tone: 'exit' });
      if (pendiente > 0) chart.push({ label: 'Salario pendiente', value: Math.round(pendiente), tone: 'good' });
      if (penalidad > 0) chart.push({ label: 'Mora del Art. 86', value: Math.round(penalidad), tone: 'warn' });

      return { total: dop(total), sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
