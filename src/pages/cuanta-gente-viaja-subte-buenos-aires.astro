---
// @incremental-standalone — atlas interactivo del subte porteño.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/subte-2026.json';

export const prerender = true;
const fmt = new Intl.NumberFormat('es-AR');
const compact = new Intl.NumberFormat('es-AR',{notation:'compact',maximumFractionDigits:1});
const colors:Record<string,string>={A:'#27b7eb',B:'#f04454',C:'#2a75d4',D:'#2fb276',E:'#8d6bc4',H:'#ffd13d',Premetro:'#ff8a32'};
const stations=Object.entries(data.current.byStation).sort((a,b)=>b[1]-a[1]);
const lines=Object.entries(data.current.byLine).filter(([l])=>colors[l]).sort((a,b)=>b[1]-a[1]);
const total=data.current.total;
const growth=(total/data.previous.total-1)*100;
const lineStations=Object.fromEntries(Object.keys(colors).map(line=>[line,stations.filter(([name])=>data.current.stationLine[name]===line).slice(0,line==='Premetro'?3:7)]));
const radiusFor=(value:number)=>Math.max(7,Math.min(18,7+Math.sqrt(value/stations[0][1])*11));
const layouts:Record<string,{d:string;pts:[number,number][]}>={
  A:{d:'M80 470 L240 470 L345 400 L510 400 L650 330 L870 330',pts:[[80,470],[190,470],[285,440],[410,400],[535,388],[685,330],[850,330]]},
  B:{d:'M85 255 L245 255 L335 315 L510 315 L650 230 L900 230',pts:[[85,255],[200,255],[285,280],[395,315],[515,312],[665,230],[875,230]]},
  C:{d:'M590 90 L590 210 L535 315 L535 520 L610 610',pts:[[590,90],[590,175],[565,255],[535,340],[535,430],[545,520],[605,602]]},
  D:{d:'M250 90 L330 170 L405 235 L510 315 L665 400 L875 520',pts:[[250,90],[325,165],[390,225],[505,310],[610,372],[735,440],[860,512]]},
  E:{d:'M110 590 L260 590 L350 520 L535 520 L685 455 L910 455',pts:[[110,590],[225,590],[315,548],[430,520],[545,515],[700,455],[885,455]]},
  H:{d:'M385 620 L385 515 L420 400 L420 315 L420 130',pts:[[385,620],[385,535],[400,455],[420,375],[420,300],[420,215],[420,135]]},
  Premetro:{d:'M110 590 L90 650 L230 650',pts:[[110,590],[120,650],[220,650]]}
};
const faq=[
  ['¿Cuánta gente viaja en subte por día?','Entre enero y junio de 2026 se registraron 97,8 millones de entradas: un promedio de unas 540.000 por día calendario. La cifra cuenta accesos por molinete, no personas únicas.'],
  ['¿Cuál es la línea de subte más usada?','La línea B fue la que más entradas registró en el primer semestre de 2026. Podés aislar cada línea desde los filtros del mapa.'],
  ['¿Cuál es la estación más concurrida?','Constitución, de la línea C, encabeza el ranking de entradas registradas durante el período analizado.'],
  ['¿Cuál es la hora pico del subte?','Al sumar toda la red, la mayor cantidad de entradas se registra alrededor de las 17 h. Cada estación tiene un patrón propio que podés explorar y comparar.'],
  ['¿Cuánto creció el uso del subte frente a 2025?','En el mismo período enero-junio, las entradas crecieron 2,0% frente a 2025. La comparación usa exactamente los mismos seis meses.'],
  ['¿Qué mide un molinete?','Mide entradas a la red. No identifica personas únicas ni registra directamente dónde bajan: una misma persona puede generar varias entradas en distintos días.'],
  ['¿De dónde salen los datos?','Del dataset público de molinetes de Subterráneos de Buenos Aires, publicado en Buenos Aires Data. Esta página usa los registros disponibles hasta junio de 2026.']
];
const schema={'@context':'https://schema.org','@graph':[{'@type':'Dataset',name:'Entradas al subte de Buenos Aires por estación — 2026',temporalCoverage:'2026-01-01/2026-06-30',spatialCoverage:'Buenos Aires',isBasedOn:data.sourceUrl,creator:{'@type':'Organization',name:'Hacé Cuentas'}},{'@type':'Article',headline:'Cuánta gente viaja en subte en Buenos Aires: estadísticas 2026',dateModified:data.generatedAt},{'@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]};
---

<Layout title="Cuánta gente viaja en subte en Buenos Aires: estadísticas 2026" description="Estadísticas 2026 del subte de Buenos Aires por línea, estación, mes, día y hora. Compará estaciones y encontrá cuándo conviene viajar." canonical="/cuanta-gente-viaja-subte-buenos-aires" audience="AR" schema={schema} domain="data">
  <Header />
  <main class="atlas">
    <section class="map-hero" id="mapa">
      <div class="ambient one"></div><div class="ambient two"></div>
      <header class="hero-title">
        <p><span></span> BUENOS AIRES · 2026</p>
        <h1>El pulso<br/>bajo la ciudad</h1>
        <p class="hero-copy">Seis meses de viajes, convertidos en un mapa vivo. Elegí una estación y mirá cómo se mueve.</p>
      </header>

      <div class="top-stats">
        <div><span>ENTRADAS</span><strong>{compact.format(total)}</strong></div>
        <div><span>VS. 2025</span><strong>+{growth.toFixed(1).replace('.',',')}%</strong></div>
        <div><span>HORA PICO</span><strong>17:00</strong></div>
      </div>

      <div class="map-shell">
        <div class="map-toolbar">
          <div class="search"><svg viewBox="0 0 24 24"><path d="m21 21-4.5-4.5m2.5-5A8 8 0 1 1 3 11a8 8 0 0 1 16 0Z"/></svg><input id="station-search" list="station-list" placeholder="Encontrá tu estación" autocomplete="off"/><button id="search-go">Ir</button></div>
          <div class="filters"><button class="active" data-filter="all">Red completa</button>{Object.entries(colors).map(([line,color])=><button data-filter={line} style={`--line:${color}`}>{line==='Premetro'?'P':line}</button>)}</div>
        </div>
        <datalist id="station-list">{stations.map(([name])=><option value={name}/>)}</datalist>

        <div class="city-map">
          <div class="city-label palermo">PALERMO</div><div class="city-label centro">MICROCENTRO</div><div class="city-label constitucion">CONSTITUCIÓN</div><div class="city-label caballito">CABALLITO</div>
          <svg class="network" viewBox="0 0 980 700" role="img" aria-label="Mapa esquemático de demanda del subte">
            <defs><filter id="glow"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
            {Object.entries(layouts).map(([line,layout])=><g class="map-line" data-map-line={line} style={`--line:${colors[line]}`}>
              <path class="line-shadow" d={layout.d}/><path class="line-path" d={layout.d}/>
              {(lineStations[line] as [string,number][]).map(([name,value],i)=><g class="map-station" data-station={name} transform={`translate(${layout.pts[i][0]} ${layout.pts[i][1]})`} tabindex="0" role="button" aria-label={`${name}: ${fmt.format(value)} entradas`}><circle class="hit" r="27"/><circle class="pulse" r={radiusFor(value)+7}/><circle class="dot" r={radiusFor(value)}/><text x="0" y={radiusFor(value)+20}>{name}</text></g>)}
            </g>)}
          </svg>
          <div class="map-note"><i></i><span>El tamaño del punto representa la cantidad de entradas</span></div>
        </div>

        <aside class="station-ribbon" id="station-panel">
          <button class="ribbon-close" id="panel-close" aria-label="Cerrar detalle">×</button>
          <div class="ribbon-identity">
            <span>ESTACIÓN SELECCIONADA</span>
            <div><i id="panel-line">C</i><h2 id="panel-name">Constitucion</h2></div>
            <p><strong id="panel-total">{fmt.format(stations[0][1])}</strong> entradas</p>
          </div>
          <div class="ribbon-metrics">
            <article><span>EN LA RED</span><b id="panel-rank">#1</b><small id="panel-share">7,6% del total</small></article>
            <article><span>EN SU LÍNEA</span><b id="panel-line-rank">#1</b><small id="panel-line-share">54% de la línea</small></article>
            <article><span>CUÁNDO CONVIENE</span><b id="panel-quiet">—</b><small>franja más tranquila</small></article>
            <article><span>VS. 2025</span><b id="panel-growth">—</b><small>mismo período</small></article>
          </div>
          <div class="ribbon-chart hour-block"><div><span>RITMO HORARIO</span><small id="chart-caption">pico a las 17:00</small></div><div class="spark" id="spark"></div></div>
          <div class="ribbon-chart month-block"><div><span>EVOLUCIÓN MENSUAL</span><small id="weekday-split">—</small></div><div class="months" id="month-bars"></div></div>
          <span id="panel-peak" hidden></span><span id="panel-insight" hidden></span>
          <button class="panel-next" id="panel-next" aria-label="Siguiente estación">→</button>
        </aside>
      </div>
      <a class="scroll-cue" href="#historia"><span>Seguí explorando</span><i>↓</i></a>
    </section>

    <section class="narrative" id="historia">
      <div class="narrative-intro"><p>UNA CIUDAD, DOS PICOS</p><h2>La red se despierta a las 8.<br/>Pero late más fuerte a las 17.</h2><span>Al sumar todas las entradas por franja horaria aparece una coreografía cotidiana: un primer pico cuando empieza el día y otro más intenso al volver.</span></div>
      <div class="rhythm-card">
        <div class="rhythm-title"><span>ENTRADAS POR HORA · TODA LA RED</span><strong>17:00</strong><small>máximo del período</small></div>
        <div class="rhythm-chart" id="rhythm-chart"></div>
        <div class="time-axis"><span>06 h</span><span>09 h</span><span>12 h</span><span>15 h</span><span>18 h</span><span>21 h</span></div>
      </div>
    </section>

    <section class="ranking-section">
      <div class="rank-copy"><p>LAS QUE MUEVEN LA RED</p><h2>Diez estaciones concentran buena parte de la historia.</h2><span>Constitución rompe la escala. Después aparecen cabeceras, combinaciones y nodos que conectan barrios enteros.</span></div>
      <div class="rank-list">
        {stations.slice(0,10).map(([name,value],i)=><button data-rank-station={name}><span>{String(i+1).padStart(2,'0')}</span><div><strong>{name}</strong><small>Línea {data.current.stationLine[name]}</small></div><i style={`--line:${colors[data.current.stationLine[name]]};--w:${value/stations[0][1]*100}%`}><b></b></i><em>{compact.format(Math.round(value/6))}<small>promedio mensual</small></em></button>)}
      </div>
    </section>

    <section class="compare-section" id="comparador">
      <div class="compare-copy"><p>ESTACIÓN CONTRA ESTACIÓN</p><h2>Dos curvas.<br/>Dos maneras de viajar.</h2><span>Elegí dos estaciones para comparar cómo cambia su movimiento a lo largo del día.</span></div>
      <div class="compare-card">
        <div class="compare-controls">
          <label><span>ESTACIÓN 1</span><select id="compare-a">{stations.map(([name])=><option value={name}>{name}</option>)}</select></label>
          <b>VS.</b>
          <label><span>ESTACIÓN 2</span><select id="compare-b">{stations.map(([name],i)=><option value={name} selected={i===1}>{name}</option>)}</select></label>
        </div>
        <div class="compare-legend"><span><i></i><b id="legend-a">{stations[0][0]}</b></span><span><i></i><b id="legend-b">{stations[1][0]}</b></span></div>
        <div class="compare-chart" id="compare-chart" aria-label="Comparación horaria de estaciones"></div>
        <div class="compare-axis"><span>6 h</span><span>9 h</span><span>12 h</span><span>15 h</span><span>18 h</span><span>21 h</span></div>
        <p id="compare-insight"></p>
      </div>
    </section>

    <section class="useful-links">
      <div><p>DEL VIAJE AL BOLSILLO</p><h2>Ahora calculá cuánto te cuesta moverte.</h2></div>
      <nav aria-label="Herramientas SUBE relacionadas">
        <a href="/calculadora-sube-argentina-costo-viaje-gasto-mensual"><span>Calculadora SUBE Argentina</span><b>Costo por viaje y gasto mensual →</b></a>
        <a href="/calculadora-gasto-tarjeta-sube-mensual"><span>Planificador de carga</span><b>Cuánto cargar en la SUBE →</b></a>
        <a href="/blog/tarjeta-sube-guia-completa-2026"><span>Guía 2026</span><b>Tarifas, registro y descuentos →</b></a>
      </nav>
    </section>

    <section class="faq-section">
      <header><p>LAS PREGUNTAS REALES</p><h2>Todo lo que este mapa cuenta —y lo que no.</h2></header>
      <div>{faq.map(([q,a],i)=><details open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div>
    </section>

    <section class="closing">
      <div><p>LA FOTO COMPLETA</p><strong>{compact.format(total)}</strong><span>entradas registradas entre enero y junio de 2026</span></div>
      <div><p>Qué significa</p><span>Son accesos registrados por molinetes, no personas únicas. Una misma persona puede aparecer muchas veces. La comparación con 2025 utiliza exactamente el mismo período.</span><a href={data.sourceUrl} target="_blank" rel="nofollow noopener">Ver fuente oficial ↗</a></div>
    </section>
    <script id="subte-data" type="application/json" set:html={JSON.stringify(data)}></script>
  </main>
  <Footer />
</Layout>

<script>
  const init=()=>{const source=JSON.parse(document.querySelector('#subte-data')?.textContent||'{}');const d=source.current;const list=Object.entries(d.byStation).sort((a:any,b:any)=>b[1]-a[1]);const colors:Record<string,string>={A:'#27b7eb',B:'#f04454',C:'#2a75d4',D:'#2fb276',E:'#8d6bc4',H:'#ffd13d',Premetro:'#ff8a32'};const nf=new Intl.NumberFormat('es-AR');let current=0;const maxEntry=(o:Record<string,number>)=>Object.entries(o).sort((a,b)=>b[1]-a[1])[0];const bars=(target:string,values:Record<string,number>,keys:number[],labels=true)=>{const el=document.querySelector(target) as HTMLElement;const max=Math.max(...keys.map(k=>values[k]||0));el.innerHTML=keys.map(k=>`<i style="--h:${(values[k]||0)/max*100}%" title="${k}:00 · ${nf.format(values[k]||0)}"><span>${labels&&k%3===0?k:''}</span></i>`).join('')};const open=(name:string,focus=false)=>{const value=d.byStation[name];if(!value)return;current=list.findIndex(([n])=>n===name);const line=d.stationLine[name];const peak=maxEntry(d.stationHours[name]||{});(document.querySelector('#panel-line') as HTMLElement).textContent=line==='Premetro'?'P':line;(document.querySelector('#panel-line') as HTMLElement).style.background=colors[line];(document.querySelector('#panel-name') as HTMLElement).textContent=name;(document.querySelector('#panel-total') as HTMLElement).textContent=nf.format(value);(document.querySelector('#panel-rank') as HTMLElement).textContent=`#${current+1}`;(document.querySelector('#panel-peak') as HTMLElement).textContent=`${peak[0]}:00`;(document.querySelector('#chart-caption') as HTMLElement).textContent=`pico a las ${peak[0]}:00`;document.querySelector('#panel-insight')!.innerHTML=`Acá se registra el <strong>${(value/d.total*100).toFixed(1).replace('.',',')}%</strong> de todas las entradas de la red.`;bars('#spark',d.stationHours[name]||{},Array.from({length:19},(_,i)=>i+5),false);document.querySelectorAll('.map-station').forEach(el=>el.classList.toggle('selected',(el as HTMLElement).dataset.station===name));document.querySelector('#station-panel')?.classList.add('open');if(focus)document.querySelector('#station-panel')?.scrollIntoView({behavior:'smooth',block:'nearest'})};document.querySelectorAll<HTMLElement>('.map-station').forEach(el=>{el.addEventListener('click',()=>open(el.dataset.station||'',true));el.addEventListener('keydown',e=>{if(e.key==='Enter')open(el.dataset.station||'',true)})});document.querySelectorAll<HTMLElement>('[data-rank-station]').forEach(el=>el.addEventListener('click',()=>{open(el.dataset.rankStation||'',true);document.querySelector('#mapa')?.scrollIntoView({behavior:'smooth'})}));document.querySelectorAll<HTMLElement>('[data-filter]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(b=>b.classList.toggle('active',b===btn));const f=btn.dataset.filter;document.querySelectorAll<HTMLElement>('[data-map-line]').forEach(line=>line.classList.toggle('dim',f!=='all'&&line.dataset.mapLine!==f))}));const search=()=>open((document.querySelector('#station-search') as HTMLInputElement).value,true);document.querySelector('#search-go')?.addEventListener('click',search);document.querySelector('#station-search')?.addEventListener('change',search);document.querySelector('#panel-next')?.addEventListener('click',()=>open(list[(current+1)%list.length][0] as string));document.querySelector('#panel-close')?.addEventListener('click',()=>document.querySelector('#station-panel')?.classList.remove('open'));bars('#rhythm-chart',d.byHour,Array.from({length:19},(_,i)=>i+5));open(list[0][0] as string)};if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
</script>

<script>
  const enrichStationRibbon=()=>{
    const source=JSON.parse(document.querySelector('#subte-data')?.textContent||'{}');
    const now=source.current, before=source.previous;
    const all=Object.entries(now.byStation).sort((a:any,b:any)=>b[1]-a[1]);
    const nf=new Intl.NumberFormat('es-AR');
    const panel=document.querySelector('#station-panel') as HTMLElement;
    panel.scrollIntoView=()=>{};
    const update=(name:string)=>{
      const value=now.byStation[name]; if(!value)return;
      const line=now.stationLine[name];
      const lineList=all.filter(([station])=>now.stationLine[station]===line);
      const lineRank=lineList.findIndex(([station])=>station===name)+1;
      const old=before.byStation[name]||0;
      const change=old?((value/old-1)*100):null;
      document.querySelector('#panel-share')!.textContent=`${(value/now.total*100).toFixed(1).replace('.',',')}% del total`;
      document.querySelector('#panel-line-rank')!.textContent=`#${lineRank}`;
      document.querySelector('#panel-line-share')!.textContent=`${(value/now.byLine[line]*100).toFixed(1).replace('.',',')}% de la línea`;
      const growth=document.querySelector('#panel-growth') as HTMLElement;
      growth.textContent=change===null?'Sin base':`${change>=0?'+':''}${change.toFixed(1).replace('.',',')}%`;
      growth.classList.toggle('down',change!==null&&change<0);
      const hours=now.stationHours[name]||{};
      const quiet=Object.entries(hours).filter(([h,v])=>Number(h)>=7&&Number(h)<=21&&Number(v)>0).sort((a:any,b:any)=>a[1]-b[1])[0];
      document.querySelector('#panel-quiet')!.textContent=quiet?`${quiet[0]}–${Number(quiet[0])+1} h`:'—';
      const days=now.stationWeekdays[name]||{};
      const workday=(Number(days[0]||0)+Number(days[1]||0)+Number(days[2]||0)+Number(days[3]||0)+Number(days[4]||0))/129;
      const weekend=(Number(days[5]||0)+Number(days[6]||0))/52;
      document.querySelector('#weekday-split')!.textContent=`hábil ${nf.format(Math.round(workday))}/día · finde ${nf.format(Math.round(weekend))}/día`;
      const months=now.stationMonths[name]||{}; const keys=[1,2,3,4,5,6];
      const max=Math.max(...keys.map(k=>months[k]||0),1);
      document.querySelector('#month-bars')!.innerHTML=keys.map(k=>`<i style="--h:${(months[k]||0)/max*100}%" title="${nf.format(months[k]||0)}"><span>${['Ene','Feb','Mar','Abr','May','Jun'][k-1]}</span></i>`).join('');
    };
    const sync=()=>update(document.querySelector('#panel-name')?.textContent||'');
    document.querySelectorAll<HTMLElement>('.map-station,[data-rank-station]').forEach(el=>el.addEventListener('click',()=>setTimeout(sync,0)));
    document.querySelector('#search-go')?.addEventListener('click',()=>setTimeout(sync,0));
    document.querySelector('#station-search')?.addEventListener('change',()=>setTimeout(sync,0));
    document.querySelector('#panel-next')?.addEventListener('click',()=>setTimeout(sync,0));
    const compare=()=>{
      const a=(document.querySelector('#compare-a') as HTMLSelectElement).value;
      const b=(document.querySelector('#compare-b') as HTMLSelectElement).value;
      const hours=Array.from({length:17},(_,i)=>i+6), av=now.stationHours[a]||{}, bv=now.stationHours[b]||{};
      const max=Math.max(...hours.flatMap(h=>[av[h]||0,bv[h]||0]),1);
      document.querySelector('#legend-a')!.textContent=a; document.querySelector('#legend-b')!.textContent=b;
      document.querySelector('#compare-chart')!.innerHTML=hours.map(h=>`<div title="${h}:00 · ${a}: ${nf.format(av[h]||0)} · ${b}: ${nf.format(bv[h]||0)}"><i style="--h:${(av[h]||0)/max*100}%"></i><b style="--h:${(bv[h]||0)/max*100}%"></b></div>`).join('');
      const peakA=hours.sort((x,y)=>(av[y]||0)-(av[x]||0))[0], peakB=[...hours].sort((x,y)=>(bv[y]||0)-(bv[x]||0))[0];
      const ratio=(now.byStation[a]||0)/(now.byStation[b]||1);
      document.querySelector('#compare-insight')!.innerHTML=`<strong>${a}</strong> mueve ${ratio>=1?ratio.toFixed(1).replace('.',','):`${(1/ratio).toFixed(1).replace('.',',')} veces menos`} que <strong>${b}</strong>. Sus picos aparecen a las ${peakA} y ${peakB} h.`;
    };
    document.querySelector('#compare-a')?.addEventListener('change',compare); document.querySelector('#compare-b')?.addEventListener('change',compare); compare();
    setTimeout(()=>{sync();panel.classList.remove('open')},0);
  };
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',enrichStationRibbon);else enrichStationRibbon();
</script>

<style>
