---
/**
 * Hub de decisión — "¿Estoy en mi peso?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer.
 * La página sólo aporta datos (src/lib/hubs/peso-ideal-imc.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import ImcExperience from '../../components/ImcExperience.astro';
import DecisionRelatedLinks from '../../components/DecisionRelatedLinks.astro';
import { hub } from '../../lib/hubs/peso-ideal-imc';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${CANONICAL}#calculator`,
      name: hub.title,
      url: CANONICAL,
      description: hub.description,
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'ARS' },
      inLanguage: 'es-AR',
      dateModified: hub.lastReviewed,
      lastReviewed: hub.lastReviewed,
      about: { '@type': 'Thing', name: 'Índice de masa corporal' },
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
      author: { '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person' },
      featureList: [
        'Cálculo de índice de masa corporal',
        'Rango de peso saludable según altura',
        'Comparación Devine, Robinson y Lorentz',
        'Relación cintura-altura',
        'Estimación de grasa corporal CUN-BAE',
      ],
      isBasedOn: hub.sources.map((source) => source.url),
    },
    {
      '@type': 'MedicalWebPage',
      '@id': `${CANONICAL}#webpage`,
      url: CANONICAL,
      name: hub.title,
      description: hub.description,
      dateModified: hub.lastReviewed,
      lastReviewed: hub.lastReviewed,
      inLanguage: 'es-AR',
      mainEntity: { '@id': `${CANONICAL}#calculator` },
      about: [
        { '@type': 'MedicalCondition', name: 'Sobrepeso y obesidad' },
        { '@type': 'Thing', name: 'Índice de masa corporal' },
      ],
      author: { '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person' },
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
import HubCitableStats from '../../components/hub/HubCitableStats.astro';
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es-AR"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ImcExperience data={hub} />
  <DecisionRelatedLinks items={[
    { href: '/salud/grasa-corporal', title: 'Grasa corporal', description: 'Sumá una métrica de composición al IMC.', icon: '📏' },
    { href: '/salud/crecimiento-infantil', title: 'Crecimiento infantil', description: 'SeguÍ percentiles y evolución por edad.', icon: '🧒' },
    { href: '/salud/fuerza-y-gimnasio', title: 'Fuerza y gimnasio', description: 'Estimá cargas y volumen de entrenamiento.', icon: '🏋️' },
  ]} />
  <HubCitableStats data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>
