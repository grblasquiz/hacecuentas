---
/**
 * Hub de decisión — "¿Cuánto tengo que dormir y a qué hora acostarme?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 * Los datos viven en src/lib/hubs/cuanto-dormir.ts; el chrome, en DecisionHub.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, NSF_BANDS, BEBE_STAGES, CICLO_MIN } from '../../lib/hubs/cuanto-dormir';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ BANDS: NSF_BANDS, STAGES: BEBE_STAGES, CICLO: CICLO_MIN }}>
  (function () {
    const H = window.HC_HUB;

    function hhmm(totalMin) {
      const t = ((Math.round(totalMin) % 1440) + 1440) % 1440;
      const h = Math.floor(t / 60), m = t % 60;
      return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
    }

    H.onCompute(function (v, kase) {
      const modo = (kase && kase.id) || 'adulto';

      // --- Edad normalizada a años --------------------------------------
      const unidad = String(v.edadUnidad || 'anios');
      const valor = Math.max(0, Number(v.edadValor) || 0);
      const enMeses = unidad === 'meses' || modo === 'bebe';
      const meses = enMeses ? (unidad === 'meses' ? valor : valor * 12) : valor * 12;
      const edadAnios = meses / 12;

      // --- Franja NSF / AASM --------------------------------------------
      const band = BANDS.find((b) => edadAnios < b.hasta) || BANDS[BANDS.length - 1];
      const minRec = band.rec[0], maxRec = band.rec[1];
      const minAcep = band.acep[0], maxAcep = band.acep[1];

      // --- Horas que duerme hoy ------------------------------------------
      const horas = Math.max(0, Number(v.horasActuales) || 0);
      const deficit = horas > 0 && horas < minRec ? minRec - horas : 0;
      const exceso = horas > maxRec ? horas - maxRec : 0;

      // --- Hora de acostarse ----------------------------------------------
      let latencia = Number(v.minutosDormirse);
      if (!isFinite(latencia) || latencia < 0) latencia = 15;
      if (latencia > 90) latencia = 90;

      const m = String(v.horaDespertar || '').trim().match(/^(\d{1,2}):(\d{2})$/);
      const hh = m ? Math.min(23, Number(m[1])) : 7;
      const mm = m ? Math.min(59, Number(m[2])) : 0;
      const despertar = hh * 60 + mm;
      const bed = (c) => hhmm(despertar - c * CICLO - latencia);
      // Ciclos completos que entran en el mínimo recomendado de la franja.
      const ciclosMin = Math.round((minRec * 60) / CICLO);

      const rows = [];
      const fmtH = (n) => n.toLocaleString('es-AR', { maximumFractionDigits: 1 });

      rows.push({ k: 'Mínimo recomendado', ref: 'NSF/AASM 2015', v: minRec, format: 'unit', unit: 'h', decimals: 1 });
      rows.push({ k: 'Máximo recomendado', ref: 'NSF/AASM 2015', v: maxRec, format: 'unit', unit: 'h', decimals: 1 });

      let sub = band.grupo;
      let etapaBebe = null;

      if (modo === 'bebe' || edadAnios < 2) {
        etapaBebe = STAGES.find((s) => meses <= s.hastaMeses) || STAGES[STAGES.length - 1];
        rows.push({ k: 'Sueño nocturno (mín.)', ref: etapaBebe.etapa, v: etapaBebe.noct[0], format: 'unit', unit: 'h', decimals: 0 });
        rows.push({ k: 'Sueño nocturno (máx.)', ref: etapaBebe.etapa, v: etapaBebe.noct[1], format: 'unit', unit: 'h', decimals: 0 });
        // Diurno = lo que queda del total una vez descontada la noche.
        rows.push({
          k: 'Siestas (diurno, mín.)',
          ref: etapaBebe.siestas,
          v: Math.max(0, minRec - etapaBebe.noct[1]),
          format: 'unit', unit: 'h', decimals: 0,
        });
        rows.push({
          k: 'Siestas (diurno, máx.)',
          ref: etapaBebe.siestas,
          v: Math.max(0, maxRec - etapaBebe.noct[0]),
          format: 'unit', unit: 'h', decimals: 0,
        });
        rows.push({ k: 'Ventana de vigilia', ref: etapaBebe.ventana, v: etapaBebe.ventanaMedia, format: 'unit', unit: 'h', decimals: 1 });
      }

      if (horas > 0) {
        rows.push({ k: 'Lo que dormís hoy', v: horas, format: 'unit', unit: 'h', decimals: 1, extra: true });
        if (deficit > 0) rows.push({ k: 'Te falta para el mínimo', v: deficit, format: 'unit', unit: 'h', decimals: 1, extra: true });
        if (exceso > 0) rows.push({ k: 'Por encima del máximo', v: exceso, format: 'unit', unit: 'h', decimals: 1, extra: true });
        rows.push({ k: 'Deuda semanal acumulada', ref: 'déficit × 7', v: deficit * 7, format: 'unit', unit: 'h', decimals: 1 });
      }

      rows.push({ k: 'Ciclos de 90 min en el mínimo', v: ciclosMin, format: 'plain' });
      rows.push({ k: 'Minutos en dormirte', v: latencia, format: 'unit', unit: 'min' });
      rows.push({ k: 'Mínimo aceptable', ref: 'fuera de rango por debajo', v: minAcep, format: 'unit', unit: 'h', decimals: 1 });
      rows.push({ k: 'Máximo aceptable', ref: 'fuera de rango por arriba', v: maxAcep, format: 'unit', unit: 'h', decimals: 1 });

      // --- Total y contexto -------------------------------------------------
      let total, position, positionLabel;
      const EJE = 14; // horas de fondo de escala

      if (modo === 'horario') {
        total = bed(6) + ' o ' + bed(5);
        sub =
          'Para despertarte a las ' + hhmm(despertar) + ': 6 ciclos (9 h) o 5 ciclos (7,5 h), ' +
          'con ' + latencia + ' min para dormirte.';
        position = Math.min(100, (9 / EJE) * 100);
        positionLabel = '9 h con 6 ciclos completos';
      } else {
        total = fmtH(minRec) + '-' + fmtH(maxRec) + ' h';
        const ref = horas > 0 ? horas : (minRec + maxRec) / 2;
        position = Math.min(100, Math.max(0, (ref / EJE) * 100));
        if (horas > 0) {
          positionLabel =
            fmtH(horas) + ' h — ' +
            (horas < minAcep ? 'insuficiente'
              : horas < minRec ? 'por debajo del recomendado'
              : horas <= maxRec ? 'dentro del rango recomendado'
              : horas <= maxAcep ? 'por encima del recomendado'
              : 'excesivo');
        } else {
          positionLabel = 'Rango recomendado ' + fmtH(minRec) + '-' + fmtH(maxRec) + ' h';
        }
        sub =
          band.grupo +
          (etapaBebe ? ' · ' + etapaBebe.etapa + ' · ' + etapaBebe.siestas : '') +
          (modo !== 'bebe'
            ? ' · acostate a las ' + bed(6) + ' (6 ciclos) o ' + bed(5) + ' (5 ciclos)'
            : '') +
          (deficit > 0 ? ' · te faltan ' + fmtH(deficit) + ' h' : '');
      }

      return {
        total: total,
        sub: sub,
        rows: rows,
        format: 'unit',
        unit: 'h',
        decimals: 1,
        position: position,
        positionLabel: positionLabel,
        chart: [
          { label: 'Insuficiente (menos de ' + fmtH(minAcep) + ' h)', value: minAcep, tone: 'bad', from: 0, to: minAcep },
          { label: 'Por debajo del ideal', value: minRec - minAcep, tone: 'warn', from: minAcep, to: minRec },
          { label: 'Recomendado ' + fmtH(minRec) + '-' + fmtH(maxRec) + ' h', value: maxRec - minRec, tone: 'good', from: minRec, to: maxRec },
          { label: 'Por encima', value: EJE - maxRec, tone: 'warn', from: maxRec, to: EJE },
        ],
      };
    });
  })();
</script>
