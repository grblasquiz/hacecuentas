---
/**
 * Hub de decisión — "¿Cuánto necesito por día de cada nutriente?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 * Los datos viven en src/lib/hubs/nutrientes-diarios.ts.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, SODIO_LIMITES, AZUCAR, CAFEINA, MAGNESIO_SUPL } from '../../lib/hubs/nutrientes-diarios';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ SODIO: SODIO_LIMITES, AZUCAR, CAFEINA, MAG: MAGNESIO_SUPL }}>
  (function () {
    const H = window.HC_HUB;

    // ── Tablas de referencia ────────────────────────────────────────────────
    // Calcio: IOM 2011 (espejo de calcio-diario-edad-lactancia-menopausia.ts).
    function calcio(edad, sexo) {
      if (sexo === 'embarazo' || sexo === 'lactancia') {
        return edad < 19 ? { rda: 1300, ul: 3000 } : { rda: 1000, ul: 2500 };
      }
      if (edad < 0.5) return { rda: 200, ul: 1000 };
      if (edad < 1) return { rda: 260, ul: 1500 };
      if (edad < 4) return { rda: 700, ul: 2500 };
      if (edad < 9) return { rda: 1000, ul: 2500 };
      if (edad < 19) return { rda: 1300, ul: 3000 };
      if (edad <= 50) return { rda: 1000, ul: 2500 };
      if (edad <= 70) return { rda: sexo === 'mujer' ? 1200 : 1000, ul: 2000 };
      return { rda: 1200, ul: 2000 };
    }

    // Hierro: RDA IOM. La base mujer/varón es la de hierro-diario-vegetariano.ts;
    // embarazo (27) y lactancia (9) se agregan de la misma tabla IOM.
    function hierro(edad, sexo, dieta) {
      let base;
      if (sexo === 'embarazo') base = 27;
      else if (sexo === 'lactancia') base = 9;
      else if (sexo === 'mujer') base = edad >= 51 ? 8 : 18;
      else base = 8;
      const rda = dieta === 'vegetariano' ? base * 1.8 : base;
      return { rda: Math.round(rda), ul: 45, base: base };
    }

    // Magnesio: RDA IOM (espejo de magnesio-dosis-deficiencia-sintomas.ts,
    // con embarazo/lactancia agregados de la misma tabla).
    function magnesio(edad, sexo) {
      if (sexo === 'embarazo') return { rda: edad > 30 ? 360 : 350, ul: MAG.ulSuplemento };
      if (sexo === 'lactancia') return { rda: edad > 30 ? 320 : 310, ul: MAG.ulSuplemento };
      if (sexo === 'hombre') return { rda: edad > 30 ? 420 : 400, ul: MAG.ulSuplemento };
      return { rda: edad > 30 ? 320 : 310, ul: MAG.ulSuplemento };
    }

    // Fibra: AI IOM 2002/2005 (espejo de fibra-dietetica-recomendada-diaria-edad.ts).
    function fibra(edad, sexo) {
      if (sexo === 'embarazo') return { rda: 28, ul: 0 };
      if (sexo === 'lactancia') return { rda: 29, ul: 0 };
      if (edad <= 3) return { rda: 19, ul: 0 };
      if (edad <= 8) return { rda: 25, ul: 0 };
      if (sexo === 'hombre') {
        if (edad <= 13) return { rda: 31, ul: 0 };
        if (edad <= 50) return { rda: 38, ul: 0 };
        return { rda: 30, ul: 0 };
      }
      if (edad <= 18) return { rda: 26, ul: 0 };
      if (edad <= 50) return { rda: 25, ul: 0 };
      return { rda: 21, ul: 0 };
    }

    // Vitamina D: RDA IOM/NASEM 2011 (espejo de vitamina-d-dosis-sol-diaria-edad.ts).
    function vitaminaD(edad) {
      if (edad < 1) return { rda: 400, ul: 1500 };
      if (edad <= 70) return { rda: 600, ul: 4000 };
      return { rda: 800, ul: 4000 };
    }

    H.onCompute(function (v, kase) {
      const modo = (kase && kase.id) || 'calcio';
      const edad = Math.max(0, Number(v.edad) || 0);
      const sexo = String(v.sexo || 'mujer');
      const peso = Math.max(0, Number(v.peso) || 0);
      const dieta = String(v.dieta || 'omnivoro');
      const perfil = String(v.perfil || 'sano');

      const rows = [];
      let unidad = 'mg', decimals = 0, objetivo = 0, ul = 0, eje = 0;
      let tipo = 'meta'; // 'meta' = a alcanzar · 'tope' = a no pasar
      let sub = '';

      if (modo === 'calcio') {
        const r = calcio(edad, sexo);
        objetivo = r.rda; ul = r.ul; eje = r.ul;
        rows.push({ k: 'Objetivo diario (CDR)', ref: 'IOM 2011', v: objetivo, format: 'unit', unit: 'mg' });
        rows.push({ k: 'Límite superior tolerable', ref: 'UL', v: ul, format: 'unit', unit: 'mg' });
        rows.push({ k: 'Porciones lácteas equivalentes', ref: '~300 mg cada una', v: Math.ceil(objetivo / 300), format: 'plain' });
        rows.push({ k: 'Máximo por toma para absorber bien', v: 500, format: 'unit', unit: 'mg' });
        sub = 'Calcio · ' + objetivo + ' mg/día · techo ' + ul.toLocaleString('es-AR') + ' mg';

      } else if (modo === 'hierro') {
        const r = hierro(edad, sexo, dieta);
        objetivo = r.rda; ul = r.ul; eje = r.ul;
        rows.push({ k: 'Objetivo diario (CDR)', ref: 'IOM', v: objetivo, format: 'unit', unit: 'mg' });
        rows.push({ k: 'Base sin ajuste vegetariano', v: r.base, format: 'unit', unit: 'mg' });
        if (dieta === 'vegetariano') {
          rows.push({ k: 'Ajuste por hierro no-hem', ref: '×1,8', v: objetivo - r.base, format: 'unit', unit: 'mg', extra: true });
        }
        rows.push({ k: 'Límite superior tolerable', ref: 'UL adultos', v: ul, format: 'unit', unit: 'mg' });
        sub = 'Hierro · ' + objetivo + ' mg/día' + (dieta === 'vegetariano' ? ' (con ajuste vegetariano)' : '');

      } else if (modo === 'magnesio') {
        const r = magnesio(edad, sexo);
        objetivo = r.rda; ul = 500; eje = 500;
        const porPeso = Math.min(MAG.max, Math.max(MAG.min, peso * MAG.mgPorKg));
        rows.push({ k: 'Objetivo diario (CDR)', ref: 'IOM', v: objetivo, format: 'unit', unit: 'mg' });
        rows.push({ k: 'Dosis orientativa por peso', ref: MAG.mgPorKg + ' mg/kg', v: Math.round(porPeso), format: 'unit', unit: 'mg' });
        rows.push({ k: 'Tope de SUPLEMENTO', ref: 'NIH · elemental', v: MAG.ulSuplemento, format: 'unit', unit: 'mg', extra: true });
        // La etiqueta declara la sal: hay que dividir por el % elemental.
        rows.push({ k: 'Bisglicinato para esa dosis', ref: '14% elemental', v: Math.round(porPeso / 0.14), format: 'unit', unit: 'mg' });
        rows.push({ k: 'Citrato para esa dosis', ref: '16,2% elemental', v: Math.round(porPeso / 0.162), format: 'unit', unit: 'mg' });
        sub = 'Magnesio · ' + objetivo + ' mg/día · suplemento hasta ' + MAG.ulSuplemento + ' mg';

      } else if (modo === 'fibra') {
        const r = fibra(edad, sexo);
        objetivo = r.rda; ul = 0; eje = 50; unidad = 'g';
        rows.push({ k: 'Objetivo diario (AI)', ref: 'IOM 2002/2005', v: objetivo, format: 'unit', unit: 'g' });
        rows.push({ k: 'Regla de fondo', ref: '14 g por 1.000 kcal', v: 14, format: 'unit', unit: 'g' });
        rows.push({ k: 'Ritmo seguro para subirla', ref: 'por semana', v: 5, format: 'unit', unit: 'g' });
        rows.push({ k: 'Tazas de legumbres cocidas equivalentes', ref: '~15 g cada una', v: Math.round((objetivo / 15) * 10) / 10, format: 'plain', decimals: 1 });
        sub = 'Fibra · ' + objetivo + ' g/día';

      } else if (modo === 'vitamina-d') {
        const r = vitaminaD(edad);
        objetivo = r.rda; ul = r.ul; eje = r.ul; unidad = 'UI';
        rows.push({ k: 'Objetivo diario (CDR)', ref: 'IOM/NASEM 2011', v: objetivo, format: 'unit', unit: 'UI' });
        rows.push({ k: 'Límite superior tolerable', ref: 'UL', v: ul, format: 'unit', unit: 'UI' });
        rows.push({ k: 'Equivalente semanal del objetivo', v: objetivo * 7, format: 'unit', unit: 'UI' });
        sub = 'Vitamina D · ' + objetivo + ' UI/día · techo ' + ul.toLocaleString('es-AR') + ' UI';

      } else if (modo === 'sodio') {
        tipo = 'tope';
        // El perfil manda; embarazo y 65+ tienen su propia línea en la tabla OMS/ESC.
        let key = perfil;
        if (perfil === 'sano' && sexo === 'embarazo') key = 'embarazo';
        else if (perfil === 'sano' && edad >= 65) key = 'mayor65';
        else if (perfil === 'sano' && edad >= 14 && edad < 19) key = 'adolescente';
        else if (perfil === 'sano' && edad >= 9 && edad < 14) key = 'nino_9_13';
        else if (perfil === 'sano' && edad >= 4 && edad < 9) key = 'nino_4_8';
        objetivo = SODIO[key] || SODIO.sano;
        eje = 4000;
        rows.push({ k: 'Tope diario de sodio', ref: 'OMS/AHA', v: objetivo, format: 'unit', unit: 'mg', extra: true });
        // 1 g de sal = 400 mg de sodio (NaCl es 40% Na en peso).
        rows.push({ k: 'Equivale en sal de mesa', ref: '1 g sal = 400 mg Na', v: Math.round((objetivo / 400) * 100) / 100, format: 'unit', unit: 'g', decimals: 2 });
        rows.push({ k: 'Cucharaditas de sal', ref: '~6 g cada una', v: Math.round((objetivo / 400 / 6) * 100) / 100, format: 'plain', decimals: 2 });
        rows.push({ k: 'Objetivo estricto con hipertensión', v: 1500, format: 'unit', unit: 'mg' });
        sub = 'Sodio · no pasar ' + objetivo.toLocaleString('es-AR') + ' mg/día (' + (objetivo / 400).toFixed(2).replace('.', ',') + ' g de sal)';

      } else if (modo === 'azucar') {
        tipo = 'tope'; unidad = 'g';
        objetivo = AZUCAR.maximo; eje = 80;
        rows.push({ k: 'Máximo OMS (10% de la energía)', ref: 'sobre 2.000 kcal', v: AZUCAR.maximo, format: 'unit', unit: 'g', extra: true });
        rows.push({ k: 'Objetivo ideal (5% de la energía)', v: AZUCAR.ideal, format: 'unit', unit: 'g' });
        rows.push({ k: 'Cucharaditas en el máximo', ref: '4 g cada una', v: AZUCAR.maximo / AZUCAR.gPorCucharadita, format: 'plain' });
        rows.push({ k: 'Cucharaditas en el ideal', ref: '4 g cada una', v: AZUCAR.ideal / AZUCAR.gPorCucharadita, format: 'plain' });
        rows.push({ k: 'Una lata de gaseosa de 350 ml', v: 37, format: 'unit', unit: 'g' });
        sub = 'Azúcares añadidos · máximo ' + AZUCAR.maximo + ' g/día, ideal ' + AZUCAR.ideal + ' g';

      } else {
        // Cafeína
        tipo = 'tope';
        objetivo = sexo === 'embarazo' ? CAFEINA.embarazo : Math.min(CAFEINA.techoFDA, peso * CAFEINA.mgPorKg);
        objetivo = Math.round(objetivo);
        eje = 600;
        rows.push({ k: 'Tu tope diario', ref: sexo === 'embarazo' ? 'embarazo' : CAFEINA.mgPorKg + ' mg/kg', v: objetivo, format: 'unit', unit: 'mg', extra: true });
        rows.push({ k: 'Techo general FDA', ref: 'adulto sano', v: CAFEINA.techoFDA, format: 'unit', unit: 'mg' });
        rows.push({ k: 'Tazas de café equivalentes', ref: '95 mg cada una', v: Math.round(objetivo / CAFEINA.mgPorTaza), format: 'plain' });
        rows.push({ k: 'Tope en embarazo', v: CAFEINA.embarazo, format: 'unit', unit: 'mg' });
        rows.push({ k: 'Horas antes de dormir para cortarla', v: 8, format: 'unit', unit: 'h' });
        sub = 'Cafeína · no pasar ' + objetivo + ' mg/día (~' + Math.round(objetivo / CAFEINA.mgPorTaza) + ' tazas)';
      }

      // ── Gráfico posicional ────────────────────────────────────────────────
      const pos = Math.min(100, Math.max(0, (objetivo / eje) * 100));
      let chart;
      if (tipo === 'tope') {
        chart = [
          { label: 'Consumo holgado', value: objetivo / 2, tone: 'good', from: 0, to: objetivo / 2 },
          { label: 'Cerca del tope', value: objetivo / 2, tone: 'warn', from: objetivo / 2, to: objetivo },
          { label: 'Por encima del tope', value: eje - objetivo, tone: 'bad', from: objetivo, to: eje },
        ];
      } else {
        const techo = ul > 0 ? ul : eje;
        chart = [
          { label: 'Por debajo del objetivo', value: objetivo, tone: 'warn', from: 0, to: objetivo },
          { label: 'Zona adecuada', value: Math.max(1, techo - objetivo), tone: 'good', from: objetivo, to: techo },
        ];
        if (ul > 0 && eje > ul) chart.push({ label: 'Por encima del límite', value: eje - ul, tone: 'bad', from: ul, to: eje });
      }

      const totalFmt = objetivo.toLocaleString('es-AR', { maximumFractionDigits: decimals });

      return {
        total: totalFmt + ' ' + unidad,
        sub: sub,
        rows: rows,
        format: 'unit',
        unit: unidad,
        decimals: decimals,
        position: pos,
        positionLabel: (tipo === 'tope' ? 'Tu tope: ' : 'Tu objetivo: ') + totalFmt + ' ' + unidad + '/día',
        chart: chart,
      };
    });
  })();
</script>
