---
/**
 * Hub de decisión — "¿Cuántas calorías quemé entrenando?"
 * Reemplaza 19 URLs de calculadora suelta (ver hub.replaces).
 *
 * Un solo motor: kcal = MET × peso × horas. Las 19 calcs absorbidas eran esa
 * misma cuenta con distinto MET. La única excepción es la rama de watts, que
 * mide trabajo mecánico y no usa MET.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CaloriasQuemadasExperience from '../../components/generated/CaloriasQuemadasExperience.astro';
import { hub, ACTIVIDADES, ESCALAS, MOTOR } from '../../lib/hubs/calorias-quemadas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

// Infinity no sobrevive a la serialización a JSON del define:vars.
const ESCALAS_JSON = Object.fromEntries(
  Object.entries(ESCALAS).map(([k, v]) => [k, v.map((s) => ({ ...s, hasta: s.hasta === Infinity ? null : s.hasta }))]),
);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CaloriasQuemadasExperience data={hub} />
  <Footer />
</Layout>

