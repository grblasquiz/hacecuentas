---
/**
 * Hub de decisión — "¿Cuánto peso tengo que subir en el embarazo?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 * Los datos viven en src/lib/hubs/peso-en-el-embarazo.ts.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub, IOM_2009, EXTRA_TRIMESTRE, EXTRA_LACTANCIA, ACTIVIDAD, GEMELAR_EXTRA, POSPARTO,
} from '../../lib/hubs/peso-en-el-embarazo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ IOM: IOM_2009, TRI: EXTRA_TRIMESTRE, LACT: EXTRA_LACTANCIA, ACT: ACTIVIDAD, GEM: GEMELAR_EXTRA, PP: POSPARTO }}
>
  (function () {
    const H = window.HC_HUB;

    H.onCompute(function (v, kase) {
      const modo = (kase && kase.id) || 't2';

      const pesoPrevio = Math.max(1, Number(v.pesoPrevio) || 62);
      const alturaCm = Math.max(100, Number(v.altura) || 165);
      const alturaM = alturaCm / 100;
      const semana = Math.min(42, Math.max(1, Number(v.semana) || 20));
      const edad = Math.max(14, Number(v.edad) || 32);
      const actividad = String(v.actividad || 'ligero');
      const tipoLactancia = String(v.lactancia || 'exclusiva');
      const pesoActual = Math.max(1, Number(v.pesoActual) || pesoPrevio);

      const imc = pesoPrevio / (alturaM * alturaM);
      const band = IOM.find((b) => imc < b.imcHasta) || IOM[IOM.length - 1];

      let minTotal = band.min, maxTotal = band.max;
      if (modo === 'gemelar') { minTotal += GEM.min; maxTotal += GEM.max; }

      // Aumento esperado a la semana actual: 1,5 kg en el 1er trimestre y
      // después la tasa semanal de la categoría (espejo de peso-embarazo.ts).
      const aumentoEsperado = semana <= 13
        ? (semana / 13) * 1.5
        : 1.5 + (semana - 13) * band.tasaSemanal;
      const medio = (band.min + band.max) / 2;
      const idealMin = pesoPrevio + aumentoEsperado * (band.min / medio);
      const idealMax = pesoPrevio + aumentoEsperado * (band.max / medio);

      // Mifflin-St Jeor para mujeres + factor de actividad.
      const bmr = 10 * pesoPrevio + 6.25 * alturaCm - 5 * edad - 161;
      const tdee = bmr * (ACT[actividad] || 1.375);

      const extraTri = TRI[modo] !== undefined ? TRI[modo] : 0;
      const extraLact = LACT[tipoLactancia] !== undefined ? LACT[tipoLactancia] : 500;

      const rows = [];
      const n1 = (x) => Math.round(x * 10) / 10;
      const fmt1 = (x) => n1(x).toLocaleString('es-AR', { maximumFractionDigits: 1 });

      let total, sub, unidad = 'kg', decimals = 1;

      if (modo === 'lactancia') {
        const totalKcal = Math.round(tdee + extraLact);
        unidad = 'kcal'; decimals = 0;
        total = totalKcal.toLocaleString('es-AR') + ' kcal';
        rows.push({ k: 'Tu mantenimiento', ref: 'Mifflin-St Jeor × actividad', v: Math.round(tdee), format: 'unit', unit: 'kcal' });
        rows.push({ k: 'Extra por la lactancia', ref: tipoLactancia, v: extraLact, format: 'unit', unit: 'kcal', extra: true });
        rows.push({ k: 'Total del día', v: totalKcal, format: 'unit', unit: 'kcal', extra: true });
        rows.push({ k: 'Piso calórico mientras amamantás', v: PP.pisoKcal, format: 'unit', unit: 'kcal' });
        rows.push({ k: 'Déficit máximo razonable', v: 500, format: 'unit', unit: 'kcal' });
        rows.push({ k: 'Agua por día (mínimo)', v: tipoLactancia === 'exclusiva' ? 2.5 : 2, format: 'unit', unit: 'l', decimals: 1 });
        sub =
          'Lactancia ' + tipoLactancia + ' · ' + Math.round(tdee).toLocaleString('es-AR') +
          ' kcal de mantenimiento + ' + extraLact + ' kcal de la teta · no bajes de ' + PP.pisoKcal + ' kcal';

      } else if (modo === 'posparto') {
        const falta = Math.max(0, pesoActual - pesoPrevio);
        const semanas = Math.ceil(falta / PP.kgPorSemana);
        const meses = semanas / 4.33;
        total = fmt1(falta) + ' kg';
        rows.push({ k: 'Kilos por encima del peso previo', v: falta, format: 'unit', unit: 'kg', decimals: 1, extra: true });
        rows.push({ k: 'Ritmo seguro', ref: 'por semana', v: PP.kgPorSemana, format: 'unit', unit: 'kg', decimals: 1 });
        rows.push({ k: 'Semanas a ese ritmo', v: semanas, format: 'plain' });
        rows.push({ k: 'Meses a ese ritmo', v: n1(meses), format: 'unit', unit: 'meses', decimals: 1 });
        rows.push({ k: 'Alta habitual para volver al ejercicio', ref: 'control posparto', v: 6, format: 'unit', unit: 'semanas' });
        if (tipoLactancia !== 'no') {
          rows.push({ k: 'Piso calórico mientras amamantás', v: PP.pisoKcal, format: 'unit', unit: 'kcal' });
        }
        sub = falta === 0
          ? 'Ya estás en tu peso previo o por debajo: no hay nada que perseguir.'
          : 'Te separan ' + fmt1(falta) + ' kg de tu peso previo · ~' + semanas + ' semanas (' + fmt1(meses) + ' meses) a 0,5 kg por semana';

      } else {
        total = fmt1(minTotal) + '-' + fmt1(maxTotal) + ' kg';
        const totalKcal = Math.round(tdee + extraTri);
        rows.push({ k: 'IMC previo al embarazo', ref: band.cat, v: n1(imc), format: 'plain', decimals: 1, extra: true });
        rows.push({ k: 'Aumento total mínimo', ref: 'IOM 2009', v: minTotal, format: 'unit', unit: 'kg', decimals: 1 });
        rows.push({ k: 'Aumento total máximo', ref: 'IOM 2009', v: maxTotal, format: 'unit', unit: 'kg', decimals: 1 });
        rows.push({ k: 'Aumento esperado a la semana ' + semana, v: n1(aumentoEsperado), format: 'unit', unit: 'kg', decimals: 1, extra: true });
        rows.push({ k: 'Peso ideal hoy (mín.)', v: n1(idealMin), format: 'unit', unit: 'kg', decimals: 1 });
        rows.push({ k: 'Peso ideal hoy (máx.)', v: n1(idealMax), format: 'unit', unit: 'kg', decimals: 1 });
        rows.push({ k: 'Ritmo semanal 2º y 3er trimestre', v: band.tasaSemanal, format: 'unit', unit: 'kg', decimals: 2 });
        rows.push({ k: 'Tu mantenimiento', ref: 'Mifflin-St Jeor × actividad', v: Math.round(tdee), format: 'unit', unit: 'kcal' });
        rows.push({ k: 'Extra calórico de la etapa', ref: 'ACOG', v: extraTri, format: 'unit', unit: 'kcal' });
        rows.push({ k: 'Calorías del día', v: totalKcal, format: 'unit', unit: 'kcal' });
        sub =
          'IMC previo ' + fmt1(imc) + ' (' + band.cat.toLowerCase() + ')' +
          (modo === 'gemelar' ? ' · gemelar: rango ampliado' : '') +
          ' · a la semana ' + semana + ' deberías pesar entre ' + fmt1(idealMin) + ' y ' + fmt1(idealMax) + ' kg' +
          ' · ' + totalKcal.toLocaleString('es-AR') + ' kcal/día';
      }

      // Gráfico: siempre el IMC previo sobre las franjas, que es lo que define
      // el rango de la respuesta en todas las ramas.
      const EJE_MIN = 15, EJE_MAX = 40;
      const pos = Math.min(100, Math.max(0, ((imc - EJE_MIN) / (EJE_MAX - EJE_MIN)) * 100));

      return {
        total: total,
        sub: sub,
        rows: rows,
        format: 'unit',
        unit: unidad,
        decimals: decimals,
        position: pos,
        positionLabel: 'IMC previo ' + fmt1(imc) + ' — ' + band.cat.toLowerCase() + ' · ganar ' + fmt1(minTotal) + '-' + fmt1(maxTotal) + ' kg',
        chart: [
          { label: 'Bajo peso (ganar 12,5-18 kg)', value: 3.5, tone: 'warn', from: 15, to: 18.5 },
          { label: 'Normal (ganar 11,5-16 kg)', value: 6.5, tone: 'good', from: 18.5, to: 25 },
          { label: 'Sobrepeso (ganar 7-11,5 kg)', value: 5, tone: 'warn', from: 25, to: 30 },
          { label: 'Obesidad (ganar 5-9 kg)', value: 10, tone: 'bad', from: 30, to: 40 },
        ],
      };
    });
  })();
</script>
