---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GrasaCorporalExperience from '../../components/generated/GrasaCorporalExperience.astro';
import { hub } from '../../lib/hubs/grasa-corporal';
const canonical='https://hacecuentas.com/salud/grasa-corporal';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <GrasaCorporalExperience />
  <Footer />
</Layout>
