---
/**
 * Hub de decisión — "¿Cuánta grasa corporal tengo?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: compute() recibe el id del caso activo como 2º
 * argumento. Las cuatro ramas leen el mismo formulario.
 *
 * NO confundir con /salud/peso-ideal-imc: ese responde "¿estoy en mi peso?"
 * con IMC y peso ideal; este responde "de ese peso, cuánto es grasa". Los dos
 * se linkean entre sí desde el copy y las FAQ.
 *
 * YMYL de salud: el aviso del dominio `health` de src/lib/disclaimers.ts va
 * textual en hub.fineprint y como primer `warn` de cada rama. Acá no hay
 * consejo clínico: se estima y se remite al profesional matriculado.
 *
 * La página sólo aporta datos (src/lib/hubs/grasa-corporal.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, ESCALA, CORTES } from '../../lib/hubs/grasa-corporal';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ ESCALA, CORTES }}>
  (function () {
    const H = window.HC_HUB;

    // Acá los números son %, kg, cm y mm. Nada de pesos: cada fila declara
    // `format: 'unit'` con su unidad explícita.
    const dec = (n, d) => (Math.round(n * Math.pow(10, d)) / Math.pow(10, d)).toFixed(d).replace('.', ',');

    const U = {
      pct: { format: 'unit', unit: '%', decimals: 1 },
      pct0: { format: 'unit', unit: '%', decimals: 0 },
      kg: { format: 'unit', unit: 'kg', decimals: 1 },
      cm: { format: 'unit', unit: 'cm', decimals: 1 },
      mm: { format: 'unit', unit: 'mm', decimals: 1 },
      idx: { format: 'unit', unit: 'puntos', decimals: 2 },
      ratio: { format: 'plain', decimals: 2 },
    };
    const row = (k, v, u, extra, ref) => {
      const r = Object.assign({ k: k, v: v }, u);
      if (extra) r.extra = true;
      if (ref) r.ref = ref;
      return r;
    };

    const log10 = (x) => Math.log(x) / Math.LN10;

    /** Franja del ACE en la que cae un porcentaje de grasa, según el sexo. */
    function categoriaGrasa(pct, sexo) {
      const b = ESCALA[sexo].bands;
      for (let i = 0; i < b.length; i++) if (pct < b[i].to) return b[i].label.split(' (')[0];
      return b[b.length - 1].label.split(' (')[0];
    }

    /** Escala del gráfico: las franjas viajan con from/to en puntos de %. */
    function escala(sexo) {
      const cfg = ESCALA[sexo];
      let desde = cfg.min;
      return cfg.bands.map(function (b) {
        const seg = { label: b.label, value: b.to - desde, tone: b.tone, from: desde, to: b.to };
        desde = b.to;
        return seg;
      });
    }
    const posEn = (pct, sexo) => {
      const cfg = ESCALA[sexo];
      return Number(Math.max(0, Math.min(100, ((pct - cfg.min) / (cfg.max - cfg.min)) * 100)).toFixed(1));
    };

    /** US Navy (Hodgdon & Beckett, 1984). Devuelve null si las medidas no cierran. */
    function navy(sexo, altura, cuello, cintura, cadera) {
      if (!altura || !cuello || !cintura) return null;
      if (sexo === 'f') {
        if (!cadera || cintura + cadera - cuello <= 0) return null;
        return Math.max(
          0,
          495 / (1.29579 - 0.35004 * log10(cintura + cadera - cuello) + 0.221 * log10(altura)) - 450
        );
      }
      if (cintura - cuello <= 0) return null;
      return Math.max(0, 495 / (1.0324 - 0.19077 * log10(cintura - cuello) + 0.15456 * log10(altura)) - 450);
    }

    /** Jackson-Pollock 3 pliegues + Siri. */
    function pliegues(sexo, edad, p1, p2, p3) {
      if (!edad || !p1 || !p2 || !p3) return null;
      const s = p1 + p2 + p3;
      const d = sexo === 'f'
        ? 1.0994921 - 0.0009929 * s + 0.0000023 * s * s - 0.0001392 * edad
        : 1.10938 - 0.0008267 * s + 0.0000016 * s * s - 0.0002574 * edad;
      return { suma: s, densidad: d, pct: Math.max(0, 495 / d - 450) };
    }

    H.onCompute(function (v, kase) {
      const caso = kase || 'navy';
      const sexo = String(v.sexo || 'm') === 'f' ? 'f' : 'm';
      const peso = v.peso || 0;
      const altura = v.altura || 0;
      const edad = v.edad || 0;
      const cuello = v.cuello || 0;
      const cintura = v.cintura || 0;
      const cadera = v.cadera || 0;
      const visceral = Math.max(0, v.porcionVisceral || 0);
      const alturaM = altura / 100;
      const sexoTxt = sexo === 'f' ? 'mujeres' : 'hombres';

      const pctNavy = navy(sexo, altura, cuello, cintura, cadera);
      const jp = pliegues(sexo, edad, v.pliegue1 || 0, v.pliegue2 || 0, v.pliegue3 || 0);

      // ──────────────── Rama: circunferencias, método Marina de EE.UU. ────────
      if (caso === 'navy') {
        if (pctNavy === null || !peso) {
          return {
            total: '—',
            sub: sexo === 'f'
              ? 'Ingresá peso, altura, cuello, cintura y cadera. La cintura más la cadera tienen que superar al cuello.'
              : 'Ingresá peso, altura, cuello y cintura. La cintura tiene que ser mayor que el cuello.',
            rows: [], chart: [],
          };
        }
        const pct = pctNavy;
        const cat = categoriaGrasa(pct, sexo);
        const masaGrasa = peso * pct / 100;
        const masaMagra = peso - masaGrasa;
        const ffmi = alturaM > 0 ? masaMagra / (alturaM * alturaM) : 0;
        const imc = alturaM > 0 ? peso / (alturaM * alturaM) : 0;

        const rows = [
          row('Grasa corporal estimada', pct, U.pct, true, 'US Navy 1984'),
          row('Masa grasa', masaGrasa, U.kg, true),
          row('Masa magra (todo lo que no es grasa)', masaMagra, U.kg, true),
          row('Peso total', peso, U.kg),
          row('Cintura menos cuello', sexo === 'f' ? cintura + cadera - cuello : cintura - cuello, U.cm, false,
            sexo === 'f' ? 'cintura + cadera − cuello' : 'cintura − cuello'),
          row('FFMI (masa magra sobre altura²)', ffmi, U.idx),
          row('IMC, para comparar', imc, U.idx, false, 'no distingue músculo'),
          row('Grasa visceral estimada sobre tu peso', pct * visceral / 100, U.pct, false, dec(visceral, 0) + '% de tu grasa'),
          row('Grasa subcutánea estimada sobre tu peso', pct - pct * visceral / 100, U.pct),
        ];

        return {
          total: dec(pct, 1) + '%',
          sub:
            cat + ' para ' + sexoTxt + ' según el ACE · ' + dec(masaGrasa, 1) + ' kg de grasa y ' +
            dec(masaMagra, 1) + ' kg de masa magra · el IMC te da ' + dec(imc, 1) +
            ', que no distingue una cosa de la otra',
          rows: rows,
          chart: escala(sexo),
          format: 'unit',
          unit: '%',
          decimals: 1,
          position: posEn(pct, sexo),
          positionLabel: dec(pct, 1) + '% de grasa — ' + cat.toLowerCase(),
        };
      }

      // ──────────────────────── Rama: pliegues cutáneos ───────────────────────
      if (caso === 'pliegues') {
        if (!jp || !peso) {
          return { total: '—', sub: 'Ingresá edad, peso y los tres pliegues en milímetros.', rows: [], chart: [] };
        }
        const pct = jp.pct;
        const cat = categoriaGrasa(pct, sexo);
        const masaGrasa = peso * pct / 100;
        const masaMagra = peso - masaGrasa;
        const difNavy = pctNavy !== null ? pct - pctNavy : null;

        const rows = [
          row('Grasa corporal por pliegues', pct, U.pct, true, 'Jackson-Pollock + Siri'),
          row('Suma de los tres pliegues', jp.suma, U.mm, true),
          row('Densidad corporal', jp.densidad, { format: 'plain', decimals: 4 }, false, 'g/cm³'),
          row('Masa grasa', masaGrasa, U.kg, true),
          row('Masa magra', masaMagra, U.kg, true),
          row('Pliegue 1', v.pliegue1 || 0, U.mm, false, sexo === 'f' ? 'tríceps' : 'pecho'),
          row('Pliegue 2', v.pliegue2 || 0, U.mm, false, sexo === 'f' ? 'suprailíaco' : 'abdomen'),
          row('Pliegue 3', v.pliegue3 || 0, U.mm, false, 'muslo'),
        ];
        if (difNavy !== null) {
          rows.push(row('Grasa por circunferencias, para comparar', pctNavy, U.pct, false, 'US Navy'));
          rows.push(row('Diferencia entre los dos métodos', Math.abs(difNavy), U.pct, false, 'puntos porcentuales'));
        }

        return {
          total: dec(pct, 1) + '%',
          sub:
            cat + ' para ' + sexoTxt + ' · suma de pliegues ' + dec(jp.suma, 1) + ' mm a los ' + dec(edad, 0) +
            ' años · densidad ' + dec(jp.densidad, 4) + ' g/cm³' +
            (difNavy !== null
              ? ' · ' + dec(Math.abs(difNavy), 1) + ' puntos de diferencia con el método de circunferencias'
              : ''),
          rows: rows,
          chart: escala(sexo),
          format: 'unit',
          unit: '%',
          decimals: 1,
          position: posEn(pct, sexo),
          positionLabel: dec(pct, 1) + '% de grasa — ' + cat.toLowerCase(),
        };
      }

      // ─────────── Rama: cintura-altura, perímetro abdominal e ICC ────────────
      if (caso === 'cintura') {
        if (!cintura || !altura) {
          return { total: '—', sub: 'Ingresá cintura y altura.', rows: [], chart: [] };
        }
        const whtr = cintura / altura;
        const cinturaMax = altura * CORTES.whtr.saludable;
        const zona =
          whtr < CORTES.whtr.delgadez ? 'delgadez, conviene revisarlo'
            : whtr < CORTES.whtr.saludable ? 'zona saludable'
            : whtr < CORTES.whtr.alto ? 'sobrepeso abdominal'
            : 'obesidad abdominal';

        const oms = CORTES.oms[sexo];
        const omsTxt =
          cintura < oms.aumentado ? 'sin riesgo aumentado'
            : cintura < oms.alto ? 'riesgo aumentado'
            : 'riesgo sustancialmente elevado';
        const idfTxt = cintura >= CORTES.idf[sexo] ? 'riesgo metabólico presente' : 'sin riesgo IDF adicional';

        const icc = cadera > 0 ? cintura / cadera : 0;
        const iccCorte = CORTES.icc[sexo];
        const iccTxt = icc === 0 ? 'sin cadera cargada'
          : icc < iccCorte.bajo ? 'riesgo bajo'
          : icc <= iccCorte.alto ? 'riesgo moderado'
          : 'riesgo alto (distribución androide)';

        const rows = [
          row('Índice cintura-altura (WHtR)', whtr, U.ratio, true, 'umbral 0,50'),
          row('Tu cintura', cintura, U.cm),
          row('Cintura máxima saludable para tu altura', cinturaMax, U.cm, true, 'la mitad de tu altura'),
          row('Centímetros de diferencia contra ese máximo', cintura - cinturaMax, U.cm),
          row('Corte OMS de riesgo aumentado', oms.aumentado, U.cm, false, omsTxt),
          row('Corte OMS de riesgo sustancialmente elevado', oms.alto, U.cm),
          row('Corte IDF para población latinoamericana', CORTES.idf[sexo], U.cm, false, idfTxt),
          row('Índice cintura-cadera (ICC)', icc, U.ratio, true, iccTxt),
          row('Corte de riesgo alto del ICC', iccCorte.alto, U.ratio),
        ];
        if (pctNavy !== null) {
          rows.push(row('Grasa corporal por circunferencias', pctNavy, U.pct, false, 'US Navy'));
        }

        const pctRef = pctNavy !== null ? pctNavy : 0;
        const catRef = pctNavy !== null ? categoriaGrasa(pctRef, sexo) : null;

        return {
          total: 'WHtR ' + dec(whtr, 2),
          sub:
            zona.charAt(0).toUpperCase() + zona.slice(1) + ' · OMS: ' + omsTxt + ' · IDF Latinoamérica: ' + idfTxt +
            (icc > 0 ? ' · ICC ' + dec(icc, 2) + ': ' + iccTxt : '') +
            (catRef ? ' · tu grasa estimada es ' + dec(pctRef, 1) + '%' : ''),
          rows: rows,
          chart: escala(sexo),
          format: 'unit',
          unit: 'cm',
          decimals: 1,
          position: posEn(pctRef, sexo),
          positionLabel: catRef
            ? dec(pctRef, 1) + '% de grasa — ' + catRef.toLowerCase() + ' · WHtR ' + dec(whtr, 2)
            : 'WHtR ' + dec(whtr, 2) + ' — ' + zona,
        };
      }

      // ─────────────────────── Rama: masa magra y FFMI ────────────────────────
      const pctBase = pctNavy !== null ? pctNavy : (jp ? jp.pct : null);
      if (pctBase === null || !peso || !altura) {
        return {
          total: '—',
          sub: 'Para el FFMI hace falta el porcentaje de grasa: cargá cuello y cintura, o los tres pliegues.',
          rows: [], chart: [],
        };
      }
      const fuente = pctNavy !== null ? 'US Navy' : 'Jackson-Pollock';
      const masaGrasa = peso * pctBase / 100;
      const masaMagra = peso - masaGrasa;
      const ffmi = masaMagra / (alturaM * alturaM);
      // Ajuste a 1,80 m (Kouri et al., 1995).
      const ffmiAj = ffmi + 6.1 * (1.8 - alturaM);
      const c = CORTES.ffmi[sexo];
      const catFfmi =
        ffmiAj < c.promedio - 2 ? 'por debajo del promedio'
          : ffmiAj < c.promedio ? 'promedio bajo'
          : ffmiAj < c.sobre ? 'promedio'
          : ffmiAj < c.techo ? 'por encima del promedio'
          : 'en el techo natural descripto o por encima';
      const cat = categoriaGrasa(pctBase, sexo);
      const imc = peso / (alturaM * alturaM);

      const rows = [
        row('FFMI ajustado a 1,80 m', ffmiAj, U.idx, true, 'Kouri 1995'),
        row('FFMI sin ajustar', ffmi, U.idx),
        row('Masa magra', masaMagra, U.kg, true),
        row('Masa grasa', masaGrasa, U.kg, true),
        row('Grasa corporal usada para el cálculo', pctBase, U.pct, false, fuente),
        row('FFMI promedio de referencia', c.promedio, U.idx, false, 'para ' + sexoTxt),
        row('Techo natural descripto', c.techo, U.idx, false, 'Kouri 1995'),
        row('Puntos que te faltan para ese techo', Math.max(0, c.techo - ffmiAj), U.idx),
        row('IMC, para comparar', imc, U.idx, false, 'incluye la grasa'),
      ];

      return {
        total: 'FFMI ' + dec(ffmiAj, 1),
        sub:
          catFfmi.charAt(0).toUpperCase() + catFfmi.slice(1) + ' para ' + sexoTxt + ' · ' + dec(masaMagra, 1) +
          ' kg de masa magra con ' + dec(pctBase, 1) + '% de grasa (' + fuente + ') · el IMC te da ' +
          dec(imc, 1) + ' porque suma músculo y grasa en el mismo número',
        rows: rows,
        chart: escala(sexo),
        format: 'unit',
        unit: 'kg',
        decimals: 1,
        position: posEn(pctBase, sexo),
        positionLabel: 'FFMI ' + dec(ffmiAj, 1) + ' · ' + dec(pctBase, 1) + '% de grasa — ' + cat.toLowerCase(),
      };
    });
  })();
</script>
