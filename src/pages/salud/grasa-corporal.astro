---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GrasaCorporalExperience from '../../components/generated/GrasaCorporalExperience.astro';
import ThirdWaveBoost from '../../components/ThirdWaveBoost.astro';
import { hub } from '../../lib/hubs/grasa-corporal';
const canonical='https://hacecuentas.com/salud/grasa-corporal';
const schema={'@context':'https://schema.org','@graph':[{'@type':'WebApplication',name:hub.h1,url:canonical,operatingSystem:'Web',applicationCategory:'HealthApplication',inLanguage:'es',isAccessibleForFree:true},{'@type':'FAQPage',mainEntity:hub.faq.map((f)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:'https://hacecuentas.com/'},{'@type':'ListItem',position:2,name:'Salud',item:'https://hacecuentas.com/salud'},{'@type':'ListItem',position:3,name:hub.h1,item:canonical}]}]};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <GrasaCorporalExperience />
  <ThirdWaveBoost variant="bodyfat" />
  <Footer />
</Layout>
