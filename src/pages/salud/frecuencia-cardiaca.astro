---
/**
 * Hub de decisión — "¿Cuál es mi zona de frecuencia cardíaca?"
 * Reemplaza 11 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 6 casos (zonas / FCmáx / zona 2 / reposo / VO2max / umbral).
 * La página sólo aporta datos (src/lib/hubs/frecuencia-cardiaca.ts) y compute().
 *
 * NINGUNA rama es plata: TODAS las filas declaran `format: 'unit'`. El runtime
 * hace Object.assign y una fila sin formato propio se imprimiría con "$".
 *
 * El gráfico es `scale`: cada rama devuelve segmentos con from/to absolutos y
 * una `position` 0-100 calculada sobre el ancho total de la barra.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FrecuenciaCardiacaExperience from '../../components/generated/FrecuenciaCardiacaExperience.astro';
import {
  hub,
  FORMULAS_FCMAX,
  ZONAS,
  NIVELES,
  COOPER,
  VO2_TABLAS,
  VO2_ETIQUETAS,
  VO2_FUTBOL,
  UMBRAL_BANDA,
} from '../../lib/hubs/frecuencia-cardiaca';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <FrecuenciaCardiacaExperience data={hub} />
  <Footer />
</Layout>

