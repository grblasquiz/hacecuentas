---
/**
 * Hub de decisión — "Me anoté a una carrera: ¿cuántas semanas necesito?".
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PlanCarreraExperience from '../../components/generated/PlanCarreraExperience.astro';
import {
  hub,
  PLANES,
  SEMANAS_POR_EXPERIENCIA,
  PICO_POR_META,
  PICO_POR_META_DEFAULT,
  DISTANCIAS,
  RIEGEL_EXP,
  TAPER,
} from '../../lib/hubs/plan-de-carrera';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PlanCarreraExperience data={hub} />
  <Footer />
</Layout>

