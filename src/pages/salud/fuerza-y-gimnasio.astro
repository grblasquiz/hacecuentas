---
/**
 * Hub de decisión — "Cuánto levanto y cuánto descanso" (fuerza y gimnasio).
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FuerzaGimnasioExperience from '../../components/generated/FuerzaGimnasioExperience.astro';
import {
  hub,
  WILKS,
  WILKS_NIVELES,
  DESCANSO,
  GRUPOS_GRANDES,
  RECUPERACION_BASE,
  FRECUENCIA,
  ESCALERA,
} from '../../lib/hubs/fuerza-y-gimnasio';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

// Infinity no sobrevive a JSON: lo mandamos como null y el runtime lo trata como tope abierto.
const NIVELES = WILKS_NIVELES.map((n) => ({ label: n.label, hasta: Number.isFinite(n.hasta) ? n.hasta : null }));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <FuerzaGimnasioExperience data={hub} />
  <Footer />
</Layout>

