---
/**
 * Hub de decisión — "¿A qué ritmo tengo que correr?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 6 casos (pace / ritmo objetivo / caminata / pace de
 * natación / SWOLF / velocidad crítica).
 *
 * NINGUNA rama es plata: TODAS las filas declaran `format: 'unit'` o `'plain'`.
 * El runtime hace Object.assign y una fila sin formato propio se imprimiría con "$".
 *
 * El gráfico es `scale`: cada rama devuelve segmentos con from/to absolutos y
 * una `position` 0-100 calculada sobre el ancho total de la barra.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  DISTANCIAS,
  RIEGEL,
  ZONAS_CARRERA,
  ZONAS_CAMINATA,
  ZONAS_NATACION,
  ZONAS_SWOLF,
  FACTOR_ZANCADA,
} from '../../lib/hubs/ritmo-running';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    DISTANCIAS,
    RIEGEL,
    ZONAS_CARRERA,
    ZONAS_CAMINATA,
    ZONAS_NATACION,
    ZONAS_SWOLF,
    FACTOR_ZANCADA,
  }}
>
  (function () {
    const H = window.HC_HUB;

    /** m:ss a partir de minutos decimales (mismo redondeo que pace-running.ts). */
    function paceFmt(min) {
      const m = Math.floor(min);
      const s = Math.round((min - m) * 60);
      return s === 60 ? (m + 1) + ':00' : m + ':' + String(s).padStart(2, '0');
    }

    /** h:mm:ss o m:ss a partir de segundos (mismo formato que ritmo-carrera-pace-km.ts). */
    function clock(totalSec) {
      const h = Math.floor(totalSec / 3600);
      const m = Math.floor((totalSec % 3600) / 60);
      const s = Math.round(totalSec % 60);
      if (h > 0) return h + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
      return m + ':' + String(s).padStart(2, '0');
    }

    /** Posición 0-100 dentro del rango que cubren las franjas del gráfico. */
    function posEn(zonas, valor) {
      const lo = zonas[0].from;
      const hi = zonas[zonas.length - 1].to;
      if (hi <= lo) return 0;
      return Math.min(100, Math.max(0, ((valor - lo) / (hi - lo)) * 100));
    }

    function bandas(zonas) {
      return zonas.map(function (z) {
        return { label: z.label, value: z.to - z.from, from: z.from, to: z.to, tone: z.tone };
      });
    }

    /** Nombre de la franja que contiene el valor. */
    function franja(zonas, valor) {
      for (let i = 0; i < zonas.length; i++) {
        if (valor < zonas[i].to) return zonas[i].label;
      }
      return zonas[zonas.length - 1].label;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'pace';

      const horas = Math.max(0, Number(v.horas) || 0);
      const minutos = Math.max(0, Number(v.minutos) || 0);
      const segundos = Math.max(0, Number(v.segundos) || 0);
      const totalSeg = horas * 3600 + minutos * 60 + segundos;
      // Natación y CSS tienen su propio tiempo: el de correr no sirve de default.
      const nadoSeg = Math.max(0, Number(v.nadoMin) || 0) * 60 + Math.max(0, Number(v.nadoSeg) || 0);

      // ── 1. Corrí una distancia: pace, velocidad y proyecciones ───────────
      // ── 2. Tengo un tiempo objetivo: a qué ritmo ir ──────────────────────
      if (id === 'pace' || id === 'objetivo') {
        const dist = Math.max(0.01, Number(v.distancia) || 10);
        const seg = Math.max(1, totalSeg);
        const paceSeg = seg / dist;              // segundos por km
        const paceMin = paceSeg / 60;            // minutos por km
        const kmh = (dist / seg) * 3600;
        const mph = kmh * 0.621371;
        const paceMi = paceMin * 1.60934;        // min por milla

        if (id === 'objetivo') {
          const vuelta = paceSeg * 0.4;          // 400 m de pista
          return {
            total: paceFmt(paceMin) + ' min/km',
            sub:
              'Para hacer ' + dist.toLocaleString('es-AR', { maximumFractionDigits: 3 }) + ' km en ' +
              clock(seg) + ' tenés que sostener ' + paceFmt(paceMin) + ' min/km, o sea ' +
              kmh.toFixed(2) + ' km/h · en cinta es la velocidad que ponés en el display',
            format: 'unit',
            unit: 'min',
            decimals: 2,
            rows: [
              { k: 'Ritmo objetivo por kilómetro', ref: paceFmt(paceMin) + ' min/km', v: paceMin, format: 'unit', unit: 'min', decimals: 2, extra: true },
              { k: 'Velocidad de cinta equivalente', v: kmh, format: 'unit', unit: 'km/h', decimals: 2 },
              { k: 'Parcial al kilómetro 1', ref: clock(paceSeg), v: paceSeg / 60, format: 'unit', unit: 'min', decimals: 2 },
              { k: 'Parcial a los 5 km', ref: clock(paceSeg * 5), v: (paceSeg * 5) / 60, format: 'unit', unit: 'min', decimals: 2 },
              { k: 'Parcial a mitad de recorrido', ref: clock(seg / 2), v: seg / 120, format: 'unit', unit: 'min', decimals: 2 },
              { k: 'Vuelta de 400 m en pista', ref: clock(vuelta), v: vuelta, format: 'unit', unit: 's', decimals: 1 },
              { k: 'Ritmo objetivo por milla', ref: paceFmt(paceMi) + ' min/mi', v: paceMi, format: 'unit', unit: 'min', decimals: 2 },
            ],
            chart: bandas(ZONAS_CARRERA),
            position: posEn(ZONAS_CARRERA, kmh),
            positionLabel: paceFmt(paceMin) + ' min/km · ' + kmh.toFixed(1) + ' km/h · ' + franja(ZONAS_CARRERA, kmh),
          };
        }

        // Proyecciones: Riegel (realista) vs pace constante (la que usaban las
        // calcs viejas y que sobreestima las distancias largas).
        const proy = DISTANCIAS.map(function (d) {
          const riegel = seg * Math.pow(d.km / dist, RIEGEL);
          const lineal = paceSeg * d.km;
          return { d: d, riegel: riegel, lineal: lineal };
        });
        const maraton = proy[proy.length - 1];

        const rows = [
          { k: 'Pace por kilómetro', ref: paceFmt(paceMin) + ' min/km', v: paceMin, format: 'unit', unit: 'min', decimals: 2, extra: true },
          { k: 'Pace por milla', ref: paceFmt(paceMi) + ' min/mi', v: paceMi, format: 'unit', unit: 'min', decimals: 2 },
          { k: 'Velocidad media', v: kmh, format: 'unit', unit: 'km/h', decimals: 2 },
          { k: 'Velocidad en millas por hora', v: mph, format: 'unit', unit: 'mph', decimals: 2 },
        ];
        proy.forEach(function (p) {
          rows.push({
            k: 'Proyección ' + p.d.label + ' (Riegel)',
            ref: clock(p.riegel) + ' · a pace constante daría ' + clock(p.lineal),
            v: p.riegel / 60,
            format: 'unit',
            unit: 'min',
            decimals: 1,
          });
        });

        return {
          total: paceFmt(paceMin) + ' min/km',
          sub:
            dist.toLocaleString('es-AR', { maximumFractionDigits: 3 }) + ' km en ' + clock(seg) + ' · ' +
            kmh.toFixed(2) + ' km/h (' + mph.toFixed(2) + ' mph) · ' + franja(ZONAS_CARRERA, kmh) +
            ' · maratón proyectada ' + clock(maraton.riegel) +
            ' (a pace constante saldría ' + clock(maraton.lineal) + ', que es el error clásico)',
          format: 'unit',
          unit: 'min',
          decimals: 2,
          rows: rows,
          chart: bandas(ZONAS_CARRERA),
          position: posEn(ZONAS_CARRERA, kmh),
          positionLabel: paceFmt(paceMin) + ' min/km · ' + kmh.toFixed(1) + ' km/h · ' + franja(ZONAS_CARRERA, kmh),
        };
      }

      // ── 3. Caminata: pasos por km, zancada y velocidad ───────────────────
      if (id === 'caminata') {
        const pasos = Math.max(1, Number(v.pasos) || 8000);
        const altura = Math.min(230, Math.max(100, Number(v.altura) || 172));
        const min = Math.max(0.01, totalSeg / 60);

        const zancada = (altura * FACTOR_ZANCADA) / 100;          // metros
        const distanciaKm = (pasos * zancada) / 1000;
        const pasosKm = Math.round(1000 / zancada);
        const kmh = distanciaKm / (min / 60);
        const paceMin = min / distanciaKm;

        return {
          total: kmh.toFixed(2) + ' km/h',
          sub:
            pasos.toLocaleString('es-AR') + ' pasos con zancada de ' + zancada.toFixed(2) + ' m (altura ' +
            altura + ' cm) = ' + distanciaKm.toFixed(2) + ' km en ' + clock(totalSeg) + ' · ' +
            franja(ZONAS_CAMINATA, kmh).toLowerCase() + ' · ' + pasosKm.toLocaleString('es-AR') + ' pasos por km',
          format: 'unit',
          unit: 'km/h',
          decimals: 2,
          rows: [
            { k: 'Pasos por kilómetro', ref: 'altura × 0,415', v: pasosKm, format: 'plain', extra: true },
            { k: 'Longitud de zancada', v: zancada, format: 'unit', unit: 'm', decimals: 2 },
            { k: 'Distancia recorrida', v: distanciaKm, format: 'unit', unit: 'km', decimals: 2 },
            { k: 'Velocidad media', v: kmh, format: 'unit', unit: 'km/h', decimals: 2 },
            { k: 'Ritmo por kilómetro', ref: paceFmt(paceMin) + ' min/km', v: paceMin, format: 'unit', unit: 'min', decimals: 2 },
            { k: 'Tiempo caminando', v: min, format: 'unit', unit: 'min', decimals: 1 },
          ],
          chart: bandas(ZONAS_CAMINATA),
          position: posEn(ZONAS_CAMINATA, kmh),
          positionLabel: kmh.toFixed(2) + ' km/h · ' + franja(ZONAS_CAMINATA, kmh),
        };
      }

      // ── 4. Natación: pace por 100 m ──────────────────────────────────────
      if (id === 'natacion') {
        const metros = Math.max(1, Number(v.distanciaNado) || 400);
        const seg = Math.max(1, nadoSeg);
        const pace100 = (seg / metros) * 100;                     // segundos por 100 m
        const kmh = (metros / seg) * 3.6;

        return {
          total: clock(pace100) + ' /100 m',
          sub:
            metros.toLocaleString('es-AR') + ' m en ' + clock(seg) + ' · ' + kmh.toFixed(2) + ' km/h · ' +
            franja(ZONAS_NATACION, pace100).toLowerCase() +
            ' · los 1500 m te llevarían ' + clock(pace100 * 15),
          format: 'unit',
          unit: 's',
          decimals: 1,
          rows: [
            { k: 'Pace por 100 m', ref: clock(pace100) + ' /100 m', v: pace100, format: 'unit', unit: 's', decimals: 1, extra: true },
            { k: 'Velocidad', v: kmh, format: 'unit', unit: 'km/h', decimals: 2 },
            { k: 'Proyección 400 m', ref: clock(pace100 * 4), v: pace100 * 4, format: 'unit', unit: 's', decimals: 0 },
            { k: 'Proyección 1500 m', ref: clock(pace100 * 15), v: pace100 * 15, format: 'unit', unit: 's', decimals: 0 },
            { k: 'Proyección milla (1852 m)', ref: clock(pace100 * 18.52), v: pace100 * 18.52, format: 'unit', unit: 's', decimals: 0 },
          ],
          chart: bandas(ZONAS_NATACION),
          position: posEn(ZONAS_NATACION, pace100),
          positionLabel: clock(pace100) + ' /100 m · ' + franja(ZONAS_NATACION, pace100),
        };
      }

      // ── 5. SWOLF ─────────────────────────────────────────────────────────
      if (id === 'swolf') {
        const t = Math.max(0, Number(v.segLargo) || 0);
        const b = Math.max(0, Number(v.brazadas) || 0);
        const sw = t + b;
        const nivel = franja(ZONAS_SWOLF, sw);

        return {
          total: String(sw),
          sub:
            t + ' segundos + ' + b + ' brazadas = SWOLF ' + sw + ' · nivel ' + nivel.toLowerCase() +
            ' · lo bajás recortando tiempo por largo o brazadas (mejor deslizamiento), no las dos a la fuerza',
          format: 'plain',
          rows: [
            { k: 'Índice SWOLF', ref: 'segundos + brazadas', v: sw, format: 'plain', extra: true },
            { k: 'Segundos del largo', v: t, format: 'unit', unit: 's', decimals: 0 },
            { k: 'Brazadas del largo', v: b, format: 'plain' },
            { k: 'Distancia por brazada (pileta de 25 m)', v: b > 0 ? 25 / b : 0, format: 'unit', unit: 'm', decimals: 2 },
            { k: 'Distancia por brazada (pileta de 50 m)', v: b > 0 ? 50 / b : 0, format: 'unit', unit: 'm', decimals: 2 },
          ],
          chart: bandas(ZONAS_SWOLF),
          position: posEn(ZONAS_SWOLF, sw),
          positionLabel: 'SWOLF ' + sw + ' · ' + nivel,
        };
      }

      // ── 6. Velocidad crítica de nado (CSS) ───────────────────────────────
      const t400 = Math.max(1, nadoSeg);
      const t200 = Math.max(1, Number(v.tiempo200) || 200);
      if (t400 <= t200) {
        return {
          total: '—',
          sub: 'El tiempo de 400 m tiene que ser mayor que el de 200 m. Cargá el test de 400 m en los campos de tiempo nadando, y el de 200 m en segundos totales.',
          format: 'unit',
          unit: 's',
          rows: [],
          chart: bandas(ZONAS_NATACION),
          position: 0,
          positionLabel: 'Datos incompletos',
        };
      }
      const cssMs = 200 / (t400 - t200);          // metros por segundo
      const cssPace = 100 / cssMs;                // segundos por 100 m
      const nivelCss = franja(ZONAS_NATACION, cssPace);

      return {
        total: clock(cssPace) + ' /100 m',
        sub:
          '400 m en ' + clock(t400) + ' y 200 m en ' + clock(t200) + ' → CSS ' + cssMs.toFixed(2) + ' m/s (' +
          (cssMs * 3.6).toFixed(1) + ' km/h) · ' + nivelCss.toLowerCase() +
          ' · es tu umbral sostenible: las series largas van en esa zona',
        format: 'unit',
        unit: 's',
        decimals: 1,
        rows: [
          { k: 'CSS · pace de umbral por 100 m', ref: clock(cssPace) + ' /100 m', v: cssPace, format: 'unit', unit: 's', decimals: 1, extra: true },
          { k: 'CSS en metros por segundo', v: cssMs, format: 'unit', unit: 'm/s', decimals: 2 },
          { k: 'Zona de umbral · borde rápido', ref: clock(cssPace - 3) + ' /100 m', v: cssPace - 3, format: 'unit', unit: 's', decimals: 1 },
          { k: 'Zona de umbral · borde lento', ref: clock(cssPace + 3) + ' /100 m', v: cssPace + 3, format: 'unit', unit: 's', decimals: 1 },
          { k: 'Zona de VO2 máx', ref: clock(cssPace - 8) + ' /100 m', v: cssPace - 8, format: 'unit', unit: 's', decimals: 1 },
          { k: 'Zona de recuperación', ref: clock(cssPace + 10) + ' /100 m', v: cssPace + 10, format: 'unit', unit: 's', decimals: 1 },
        ],
        chart: bandas(ZONAS_NATACION),
        position: posEn(ZONAS_NATACION, cssPace),
        positionLabel: 'CSS ' + clock(cssPace) + ' /100 m · ' + nivelCss,
      };
    });
  })();
</script>
