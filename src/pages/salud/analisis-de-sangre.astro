---
/**
 * Hub de decisión — "Los índices que tu análisis no trae calculados"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 * Los datos viven en src/lib/hubs/analisis-de-sangre.ts.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, KDIGO, LIPIDOS, PAYNE } from '../../lib/hubs/analisis-de-sangre';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ KDIGO, LIP: LIPIDOS, PAYNE }}>
  (function () {
    const H = window.HC_HUB;

    H.onCompute(function (v, kase) {
      const modo = (kase && kase.id) || 'renal';

      const edad = Math.max(18, Number(v.edad) || 45);
      const esHombre = String(v.sexo) === 'hombre';
      const peso = Math.max(1, Number(v.peso) || 70);
      const alturaCm = Math.max(100, Number(v.altura) || 168);

      const rows = [];
      let total, sub, position = 0, positionLabel = '', chart = [];
      let unidad = '', decimals = 1;

      const n = (x, d) => Math.round(x * Math.pow(10, d)) / Math.pow(10, d);
      const fmt = (x, d) => n(x, d).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

      if (modo === 'renal') {
        const scr = Math.max(0.01, Number(v.creatinina) || 0.9);

        // Cockcroft-Gault (1976): [(140 − edad) × peso] / (72 × Scr), ×0,85 mujer.
        const cg = (((140 - edad) * peso) / (72 * scr)) * (esHombre ? 1 : 0.85);

        // CKD-EPI 2021, SIN coeficiente de raza (la revisión de 2021 lo eliminó).
        const kappa = esHombre ? 0.9 : 0.7;
        const alpha = esHombre ? -0.302 : -0.241;
        const ratio = scr / kappa;
        const ckd =
          142 *
          Math.pow(Math.min(ratio, 1), alpha) *
          Math.pow(Math.max(ratio, 1), -1.2) *
          Math.pow(0.9938, edad) *
          (esHombre ? 1 : 1.012);

        const est = KDIGO.find((k) => ckd >= k.desde) || KDIGO[KDIGO.length - 1];
        const brecha = Math.abs(cg - ckd);
        const alturaM = alturaCm / 100;
        const imc = peso / (alturaM * alturaM);

        unidad = 'mL/min';
        rows.push({ k: 'Filtrado glomerular (CKD-EPI 2021)', ref: est.codigo, v: n(ckd, 1), format: 'unit', unit: 'mL/min/1,73 m²', decimals: 1, extra: true });
        rows.push({ k: 'Clearance de creatinina (Cockcroft-Gault)', ref: 'para ajuste de dosis', v: n(cg, 1), format: 'unit', unit: 'mL/min', decimals: 1, extra: true });
        rows.push({ k: 'Diferencia entre las dos ecuaciones', v: n(brecha, 1), format: 'unit', unit: 'unidades', decimals: 1 });
        rows.push({ k: 'Creatinina usada', v: scr, format: 'unit', unit: 'mg/dL', decimals: 2 });
        rows.push({ k: 'Peso aplicado en Cockcroft-Gault', v: peso, format: 'unit', unit: 'kg', decimals: 1 });
        rows.push({ k: 'IMC (contexto del peso usado)', v: n(imc, 1), format: 'plain', decimals: 1 });

        total = fmt(ckd, 1) + ' mL/min/1,73 m²';
        sub =
          est.texto + ' · Cockcroft-Gault ' + fmt(cg, 1) + ' mL/min' +
          (brecha >= 15 ? ' · las dos difieren ' + fmt(brecha, 0) + ' unidades: Cockcroft-Gault depende del peso y no se normaliza por superficie corporal' : '') +
          (imc >= 30 ? ' · con IMC ' + fmt(imc, 1) + ' el peso real sobreestima el clearance' : '') +
          ' · el estadio requiere confirmación a los 3 meses y albuminuria';

        const EJE = 120;
        position = Math.min(100, Math.max(0, (ckd / EJE) * 100));
        positionLabel = fmt(ckd, 1) + ' mL/min/1,73 m² — ' + est.texto;
        chart = [
          { label: 'G5 · fallo renal (<15)', value: 15, tone: 'bad', from: 0, to: 15 },
          { label: 'G4 · descenso grave (15-29)', value: 15, tone: 'bad', from: 15, to: 30 },
          { label: 'G3 · descenso moderado (30-59)', value: 30, tone: 'warn', from: 30, to: 60 },
          { label: 'G2 · descenso leve (60-89)', value: 30, tone: 'warn', from: 60, to: 90 },
          { label: 'G1 · normal o alta (≥90)', value: 30, tone: 'good', from: 90, to: EJE },
        ];

      } else if (modo === 'insulina') {
        const glucosaMgdl = Math.max(1, Number(v.glucosa) || 92);
        const insulina = Math.max(0.01, Number(v.insulina) || 8);
        const mmol = glucosaMgdl / 18;

        const homaIr = (mmol * insulina) / 22.5;
        const homaBeta = (20 * insulina) / Math.max(0.1, mmol - 3.5);
        const quicki = 1 / (Math.log10(insulina) + Math.log10(glucosaMgdl));

        unidad = '';
        rows.push({ k: 'HOMA-IR', ref: 'glucosa mmol × insulina / 22,5', v: n(homaIr, 2), format: 'plain', decimals: 2, extra: true });
        rows.push({ k: 'HOMA-Beta', ref: 'función de la célula beta', v: n(homaBeta, 1), format: 'plain', decimals: 1 });
        rows.push({ k: 'QUICKI', ref: 'índice recíproco logarítmico', v: n(quicki, 3), format: 'plain', decimals: 3 });
        rows.push({ k: 'Glucosa en mmol/L', ref: 'mg/dL ÷ 18', v: n(mmol, 2), format: 'unit', unit: 'mmol/L', decimals: 2 });
        rows.push({ k: 'Insulina usada', v: n(insulina, 2), format: 'unit', unit: 'µU/mL', decimals: 2 });

        total = 'HOMA-IR ' + fmt(homaIr, 2);
        sub =
          'QUICKI ' + fmt(quicki, 3) + ' · HOMA-Beta ' + fmt(homaBeta, 1) +
          ' · no existe un punto de corte universal: el número no diagnostica resistencia a la insulina';

        const EJE = 8;
        position = Math.min(100, Math.max(0, (homaIr / EJE) * 100));
        positionLabel = 'HOMA-IR ' + fmt(homaIr, 2) + ' — la lectura depende de tu laboratorio y de tu contexto';
        chart = [
          { label: 'Valores bajos (referencia poblacional)', value: 2, tone: 'good', from: 0, to: 2 },
          { label: 'Zona de umbrales discutidos (2-3)', value: 1, tone: 'warn', from: 2, to: 3 },
          { label: 'Valores altos', value: 5, tone: 'bad', from: 3, to: EJE },
        ];

      } else if (modo === 'calcio') {
        const ca = Math.max(0.1, Number(v.calcio) || 8.6);
        const alb = Math.max(0.1, Number(v.albumina) || 3.2);
        const correccion = PAYNE.factor * (PAYNE.albuminaRef - alb);
        const corregido = ca + correccion;

        unidad = 'mg/dL';
        rows.push({ k: 'Calcio corregido', ref: 'Payne 1973', v: n(corregido, 2), format: 'unit', unit: 'mg/dL', decimals: 2, extra: true });
        rows.push({ k: 'Calcio medido', v: n(ca, 2), format: 'unit', unit: 'mg/dL', decimals: 2 });
        rows.push({ k: 'Corrección aplicada', ref: '0,8 × (4,0 − albúmina)', v: n(correccion, 2), format: 'unit', unit: 'mg/dL', decimals: 2 });
        rows.push({ k: 'Albúmina usada', v: n(alb, 2), format: 'unit', unit: 'g/dL', decimals: 2 });
        // 1 mmol/L = 4,008 mg/dL
        rows.push({ k: 'Calcio corregido en mmol/L', ref: '÷ 4,008', v: n(corregido / 4.008, 2), format: 'unit', unit: 'mmol/L', decimals: 2 });

        total = fmt(corregido, 2) + ' mg/dL';
        const dentro = corregido >= PAYNE.refMin && corregido <= PAYNE.refMax;
        sub =
          (dentro ? 'Dentro del rango de referencia habitual (8,5-10,5 mg/dL)' : 'Fuera del rango de referencia habitual (8,5-10,5 mg/dL)') +
          ' · la corrección movió el valor ' + fmt(Math.abs(correccion), 2) + ' mg/dL · si la conducta depende del resultado, el estándar es el calcio iónico medido';

        const EJE_MIN = 6, EJE_MAX = 14;
        position = Math.min(100, Math.max(0, ((corregido - EJE_MIN) / (EJE_MAX - EJE_MIN)) * 100));
        positionLabel = 'Calcio corregido ' + fmt(corregido, 2) + ' mg/dL';
        chart = [
          { label: 'Por debajo del rango (<8,5)', value: 2.5, tone: 'bad', from: EJE_MIN, to: PAYNE.refMin },
          { label: 'Rango de referencia (8,5-10,5)', value: 2, tone: 'good', from: PAYNE.refMin, to: PAYNE.refMax },
          { label: 'Por encima del rango (>10,5)', value: 3.5, tone: 'bad', from: PAYNE.refMax, to: EJE_MAX },
        ];

      } else {
        const mgdl = Math.max(1, Number(v.colesterol) || 195);
        const mmol = mgdl / LIP.colesterol;

        unidad = 'mmol/L';
        rows.push({ k: 'Colesterol total en mmol/L', ref: '÷ 38,67', v: n(mmol, 2), format: 'unit', unit: 'mmol/L', decimals: 2, extra: true });
        rows.push({ k: 'Colesterol total en mg/dL', v: n(mgdl, 0), format: 'unit', unit: 'mg/dL' });
        rows.push({ k: 'Factor del colesterol', v: LIP.colesterol, format: 'plain', decimals: 2 });
        rows.push({ k: 'Factor de los triglicéridos', ref: 'para el mismo valor en TG', v: LIP.trigliceridos, format: 'plain', decimals: 2 });
        rows.push({ k: 'El mismo número leído como triglicéridos', ref: '÷ 88,57', v: n(mgdl / LIP.trigliceridos, 2), format: 'unit', unit: 'mmol/L', decimals: 2 });

        const clas = mgdl < 200 ? 'Deseable (<200 mg/dL)'
          : mgdl < 240 ? 'Limítrofe alto (200-239 mg/dL)'
          : 'Alto (≥240 mg/dL)';

        total = fmt(mmol, 2) + ' mmol/L';
        sub =
          fmt(mgdl, 0) + ' mg/dL — ' + clas +
          ' · el colesterol total solo no define riesgo: se evalúa el perfil completo con tu profesional';

        const EJE = 320;
        position = Math.min(100, Math.max(0, (mgdl / EJE) * 100));
        positionLabel = fmt(mgdl, 0) + ' mg/dL — ' + clas;
        chart = [
          { label: 'Deseable (<200)', value: 200, tone: 'good', from: 0, to: 200 },
          { label: 'Limítrofe alto (200-239)', value: 40, tone: 'warn', from: 200, to: 240 },
          { label: 'Alto (≥240)', value: 80, tone: 'bad', from: 240, to: EJE },
        ];
      }

      return {
        total: total,
        sub: sub,
        rows: rows,
        format: unidad ? 'unit' : 'plain',
        unit: unidad,
        decimals: decimals,
        position: position,
        positionLabel: positionLabel,
        chart: chart,
      };
    });
  })();
</script>
