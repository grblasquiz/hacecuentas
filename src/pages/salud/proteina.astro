---
/**
 * Hub de decisión — "¿Cuánta proteína tengo que comer?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/proteina.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, RANGOS, NUTRI } from '../../lib/hubs/proteina';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ RANGOS, NUTRI }}>
  (function () {
    const H = window.HC_HUB;

    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });

    H.onCompute(function (v, caso) {
      const rama = (caso && caso.id) || 'mantenimiento';
      const R = RANGOS[rama] || RANGOS.mantenimiento;

      const peso = Math.max(0, Number(v.peso) || 0);
      const edad = Math.max(0, Number(v.edad) || 0);
      const pctGrasa = Math.min(60, Math.max(0, Number(v.pctGrasa) || 0));
      const comidas = Math.min(8, Math.max(1, Math.round(Number(v.comidas) || 4)));
      const dieta = Math.max(0, Number(v.proteinaDieta) || 0);
      const scoopG = Math.max(1, Number(v.proteinaScoop) || 25);

      if (!peso) {
        return {
          total: '—',
          sub: 'Ingresá tu peso corporal para ver el rango.',
          rows: [],
          chart: [],
          format: 'unit',
          unit: 'g',
        };
      }

      // Base sobre la que se aplica el factor: peso total o masa magra.
      const magra = peso * (1 - pctGrasa / 100);
      const base = R.sobre === 'magra' ? magra : peso;

      // ESPEN 2014: +20% desde los 65 por resistencia anabólica.
      // No se aplica a la rama de masa magra: ese factor ya se calcula sobre
      // tejido activo (así lo hace la fórmula de fisicoculturismo original).
      const esMayor = edad >= NUTRI.SENIOR_EDAD;
      const mult = R.senior && esMayor ? NUTRI.SENIOR_MULT : 1;

      const gMin = base * R.min * mult;
      const gObj = base * R.mid * mult;
      const gMax = base * R.max * mult;

      // g/kg efectivos SIEMPRE sobre el peso corporal, para que el marcador del
      // gráfico sea comparable entre ramas (la rama magra queda más abajo, que
      // es exactamente lo que se quiere mostrar).
      const gkg = gObj / peso;

      // Reparto por comida. El piso sube a 0,55 g/kg desde los 65.
      const porComida = gObj / comidas;
      const comidaMin = peso * NUTRI.COMIDA_MIN;
      const comidaMax = peso * NUTRI.COMIDA_MAX;
      // Desde los 65 el piso útil por toma sube al techo del rango general.
      const comidaPiso = esMayor ? peso * NUTRI.COMIDA_MIN_SENIOR : comidaMin;
      const leucina = porComida * NUTRI.LEUCINA_FRAC;

      // Hueco a cubrir con suplemento.
      const falta = Math.max(0, gObj - dieta);
      const scoops = falta / scoopG;

      // Equivalencias en alimentos (USDA).
      const pollo = (gObj / NUTRI.POLLO_100) * 100;
      const huevos = gObj / NUTRI.HUEVO_UNIDAD;

      const rows = [
        { k: 'Piso del rango diario', ref: nf(R.min * mult, 2) + ' g/kg', v: Math.round(gMin), format: 'unit', unit: 'g' },
        { k: 'Objetivo diario', v: Math.round(gObj), extra: true, format: 'unit', unit: 'g' },
        { k: 'Techo del rango diario', ref: nf(R.max * mult, 2) + ' g/kg', v: Math.round(gMax), format: 'unit', unit: 'g' },
        { k: 'Proteína por kilo de peso', v: Number(gkg.toFixed(2)), format: 'unit', unit: 'g/kg', decimals: 2 },
        { k: 'Por comida', ref: comidas + (comidas === 1 ? ' comida' : ' comidas'), v: Math.round(porComida), format: 'unit', unit: 'g' },
        { k: 'Piso útil por comida', ref: nf(NUTRI.COMIDA_MIN, 2) + ' g/kg', v: Math.round(comidaMin), format: 'unit', unit: 'g' },
        { k: 'Techo útil por comida', ref: nf(NUTRI.COMIDA_MAX, 2) + ' g/kg', v: Math.round(comidaMax), format: 'unit', unit: 'g' },
        { k: 'Leucina por comida', ref: 'umbral 2,5 a 3 g', v: Number(leucina.toFixed(1)), format: 'unit', unit: 'g', decimals: 1 },
        { k: 'Ya cubierto por tu comida', v: Math.round(Math.min(dieta, gObj)), format: 'unit', unit: 'g' },
        { k: 'Falta cubrir', v: Math.round(falta), format: 'unit', unit: 'g' },
        { k: 'Scoops de whey', ref: scoopG + ' g por scoop', v: Number(scoops.toFixed(1)), format: 'unit', unit: 'scoops', decimals: 1 },
        { k: 'Equivale en pechuga de pollo', ref: '31 g cada 100 g', v: Math.round(pollo), format: 'unit', unit: 'g' },
        { k: 'Equivale en huevos', ref: '6,5 g por huevo', v: Math.round(huevos), format: 'unit', unit: 'huevos' },
      ];

      if (esMayor) {
        rows.splice(7, 0, {
          k: 'Piso por comida desde los 65',
          ref: nf(NUTRI.COMIDA_MIN_SENIOR, 2) + ' g/kg',
          v: Math.round(comidaPiso),
          format: 'unit',
          unit: 'g',
        });
      }

      if (R.sobre === 'magra') {
        rows.unshift({ k: 'Tu masa magra', ref: nf(pctGrasa, 0) + '% de grasa', v: Math.round(magra), format: 'unit', unit: 'kg' });
      }

      // Franjas del eje g/kg de peso corporal.
      const tope = NUTRI.ESCALA_MAX;
      const chart = [
        { label: 'Por debajo del mínimo (0 a 0,8)', value: 0.8, from: 0, to: 0.8, tone: 'bad' },
        { label: 'Mínimo OMS (0,8 a 1,2)', value: 0.4, from: 0.8, to: 1.2, tone: 'warn' },
        { label: 'Actividad moderada (1,2 a 1,6)', value: 0.4, from: 1.2, to: 1.6, tone: 'good' },
        { label: 'Hipertrofia (1,6 a 2,2)', value: 0.6, from: 1.6, to: 2.2, tone: 'good' },
        { label: 'Déficit y rangos altos (2,2 a 3)', value: 0.8, from: 2.2, to: tope, tone: 'warn' },
      ];

      const estadoComida =
        porComida < comidaPiso
          ? 'te queda corta por comida: subí los gramos de cada toma o hacé menos comidas'
          : porComida > comidaMax
            ? 'te pasás por comida: repartir en una o dos tomas más aprovecha mejor el total'
            : 'cada comida cae dentro del rango útil';

      const sub =
        nf(gObj, 0) + ' g por día · rango ' + nf(gMin, 0) + ' a ' + nf(gMax, 0) + ' g · ' +
        nf(gkg, 2) + ' g por kilo de peso (' + R.etiqueta + ')' +
        (mult > 1 ? ' · +20% por edad, ESPEN' : '') +
        ' · ' + nf(porComida, 0) + ' g en ' + comidas + (comidas === 1 ? ' comida: ' : ' comidas: ') + estadoComida +
        (falta > 0
          ? ' · te faltan ' + nf(falta, 0) + ' g, unos ' + nf(scoops, 1) + ' scoops'
          : ' · tu comida ya cubre el objetivo, no necesitás suplemento') + '.';

      return {
        total: nf(gObj, 0) + ' g',
        sub: sub,
        rows: rows,
        chart: chart,
        format: 'unit',
        unit: 'g',
        position: Math.min(100, Math.max(0, (gkg / tope) * 100)),
        positionLabel: nf(gkg, 2) + ' g/kg — ' + R.etiqueta,
      };
    });
  })();
</script>
