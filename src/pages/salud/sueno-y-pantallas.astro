---
/**
 * Hub de decisión — "¿Cuántas horas de sueño y de pantalla deberíamos tener?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: la rama activa llega como segundo argumento de
 * compute() (el objeto HubCase que expone DecisionHub).
 *
 * OJO CON EL FORMATO: acá no hay pesos. Cada fila declara su propio `format`
 * ('unit' con h, min, días, %, puntos, o 'plain'). Una fila sin `format` cae a
 * pesos y la página miente.
 *
 * PSQI: screening orientativo, nunca diagnóstico. El copy no nombra patologías.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SuenoPantallasExperience from '../../components/generated/SuenoPantallasExperience.astro';
import {
  hub,
  SUENO_RANGOS,
  SUENO_ESCALA_MAX,
  PANTALLA_TRAMOS,
  PSQI,
  REDES,
  FOCO,
} from '../../lib/hubs/sueno-y-pantallas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SuenoPantallasExperience data={hub} />
  <Footer />
</Layout>

