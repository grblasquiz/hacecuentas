  .cx-watch-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .cx-watch { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 1.35rem 1.4rem; box-shadow: var(--shadow-sm); }
  .cx-watch-ico { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: var(--accent-soft); color: var(--accent-strong); font-size: 1rem; font-weight: 800; margin-bottom: 0.85rem; }
  .cx-watch h3 { font-size: 1rem; font-weight: 750; margin: 0 0 0.4rem; }
  .cx-watch p { font-size: 0.86rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 0.9rem; }
  .cx-watch a { font-size: 0.84rem; font-weight: 700; color: var(--accent-strong); text-decoration: none; }
  .cx-watch a:hover { text-decoration: underline; }

  /* CALCULADORAS */
  .cx-calc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .cx-calc { display: flex; flex-direction: column; background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 1.35rem 1.4rem; box-shadow: var(--shadow-sm); text-decoration: none; color: var(--text); transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s; }
  .cx-calc:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); border-color: var(--accent); }
  .cx-calc-ico { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: var(--accent-soft); color: var(--accent-strong); font-size: 0.9rem; font-weight: 800; margin-bottom: 0.85rem; }
  .cx-calc h3 { font-size: 1rem; font-weight: 750; margin: 0 0 0.35rem; }
  .cx-calc p { font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 0.9rem; flex: 1; }
  .cx-calc-cta { font-size: 0.84rem; font-weight: 700; color: var(--accent-strong); }

  /* CÓMO FUNCIONA + FAQ */
  .cx-method h2, .cx-faq h2 { font-size: 1.15rem; font-weight: 800; margin: 0 0 0.85rem; }
  .cx-method p { font-size: 0.92rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 1.1rem; }
  .cx-src-chip { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; font-weight: 650; color: var(--text-muted); background: var(--bg-soft); border: 1px solid var(--border); border-radius: 999px; padding: 0.4rem 0.85rem; }
  .cx-faq-list { display: flex; flex-direction: column; gap: 0.4rem; }
  .cx-faq-item { border: 1px solid var(--border); border-radius: 10px; background: var(--bg-soft); overflow: hidden; }
  .cx-faq-item summary { cursor: pointer; font-weight: 650; font-size: 0.9rem; color: var(--text); list-style: none; padding: 0.85rem 1rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .cx-faq-item summary::-webkit-details-marker { display: none; }
  .cx-faq-item summary::after { content: '+'; color: var(--text-subtle); font-size: 1.2rem; font-weight: 400; line-height: 1; flex: none; }
  .cx-faq-item[open] summary { color: var(--accent-strong); }
  .cx-faq-item[open] summary::after { content: '−'; }
  .cx-faq-a { font-size: 0.87rem; color: var(--text-muted); line-height: 1.6; padding: 0 1rem 1rem; }
  .cx-faq-a a { color: var(--accent-strong); font-weight: 600; }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .cx-hero { grid-template-columns: 1fr; gap: 1.35rem; padding: 1.6rem; }
    .cx-two, .cx-bottom { grid-template-columns: 1fr; }
    .cx-princ-grid { grid-template-columns: repeat(2, 1fr); }
    .cx-watch-grid, .cx-calc-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 680px) {
    .cx-hero h1 { font-size: 1.9rem; }
    .cx-princ-grid, .cx-watch-grid, .cx-calc-grid { grid-template-columns: 1fr; }
    .cx-rank-tools { flex-direction: column; align-items: stretch; }
    .cx-search { min-width: 0; }
    .cx-filters { overflow-x: auto; }
    /* Ranking: colapsa columnas ARS/tendencia/estrella en mobile */
    .cx-rank-head, .cx-rank-row { grid-template-columns: 26px minmax(120px, 1.6fr) minmax(90px, 1fr) minmax(64px, 0.7fr); }
    .cx-rank-head > :nth-child(4), .cx-rank-head > :nth-child(6), .cx-rank-head > :nth-child(7),
    .cx-rank-ars, .cx-rank-spark, .cx-star { display: none; }
    .cx-tabs { overflow-x: auto; }
  }
</style>

<script>
  interface CoinGeckoCoin {
    id: string; symbol: string; name: string; image: string;
    current_price: number; market_cap: number;
    price_change_percentage_24h: number; sparkline_in_7d?: { price: number[] };
  }
  interface SimplePrice { [coinId: string]: { [fiat: string]: number } }

  const FIAT_LABELS: Record<string, string> = {
    USD: '🇺🇸 Dólar (USD)', EUR: '🇪🇺 Euro (EUR)', ARS: '🇦🇷 Peso argentino (ARS)',
    BRL: '🇧🇷 Real (BRL)', MXN: '🇲🇽 Peso mexicano (MXN)', GBP: '🇬🇧 Libra (GBP)',
    JPY: '🇯🇵 Yen (JPY)', CLP: '🇨🇱 Peso chileno (CLP)', UYU: '🇺🇾 Peso uruguayo (UYU)',
  };

  interface CxState { topCoins: CoinGeckoCoin[]; simplePrices: SimplePrice; updatedAt: number; }
  let STATE: CxState = { topCoins: [], simplePrices: {}, updatedAt: 0 };
  let REFRESH_TIMER: number | null = null;
  let TICK_TIMER: number | null = null;
  let nextIn = 30;

  // ── Favoritos (localStorage) ──
  const FAV_KEY = 'hc_cx_favs_v1';
  function loadFavs(): Set<string> { try { return new Set(JSON.parse(localStorage.getItem(FAV_KEY) || '[]')); } catch { return new Set(); } }
  function saveFavs(s: Set<string>) { try { localStorage.setItem(FAV_KEY, JSON.stringify([...s])); } catch {} }
  let FAVS = loadFavs();

  function loadBuildData() {
    const el = document.getElementById('cx-build-data');
    if (!el?.textContent) return;
    try {
      const parsed = JSON.parse(el.textContent);
      STATE.topCoins = parsed.topCoins || [];
      STATE.simplePrices = parsed.simplePrices || {};
      STATE.updatedAt = parsed.ts || 0;
    } catch {}
  }

  // ── Formato ──
  function fUsd(n: number): string {
    if (n == null || !isFinite(n)) return '—';
    const abs = Math.abs(n);
    const dec = abs >= 10000 ? 0 : abs >= 1 ? 2 : abs >= 0.01 ? 4 : 6;
    return new Intl.NumberFormat('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec }).format(n);
  }
  function fUsd2(n: number): string {
    if (n == null || !isFinite(n)) return '—';
    const abs = Math.abs(n);
    const dec = abs >= 1 ? 2 : abs >= 0.01 ? 4 : 6;
    return '$' + new Intl.NumberFormat('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec }).format(n);
  }
  function fArs(n: number): string { return new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(n); }
  function fPct(n: number): string { const v = n ?? 0; return (v >= 0 ? '+' : '') + v.toFixed(2).replace('.', ',') + '%'; }
  function fmtNum(n: number, max = 8): string { return new Intl.NumberFormat('es-AR', { maximumFractionDigits: max }).format(n); }
  function parseAmount(v: string): number { return Number(v.replace(/\./g, '').replace(/,/g, '.')) || 0; }
  function sparkPts(prices?: number[]): { pts: string; up: boolean } | null {
    const v = (prices || []).filter((x) => typeof x === 'number' && isFinite(x));
    if (v.length < 2) return null;
    const N = 24, stepIn = Math.max(1, Math.floor(v.length / N)); const s: number[] = [];
    for (let i = 0; i < v.length; i += stepIn) s.push(v[i]);
    if (s[s.length - 1] !== v[v.length - 1]) s.push(v[v.length - 1]);
    const min = Math.min(...s), max = Math.max(...s), span = max - min || 1;
    const w = 88, h = 26, pad = 3, step = w / (s.length - 1);
    const pts = s.map((n, i) => `${(i * step).toFixed(1)},${(h - pad - ((n - min) / span) * (h - pad * 2)).toFixed(1)}`).join(' ');
    return { pts, up: v[v.length - 1] >= v[0] };
  }
  function coinById(id: string) { return STATE.topCoins.find((c) => c.id === id); }

  // ── Fetch en vivo ──
  async function fetchLive() {
    try {
      const r1 = await fetch('https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=30&page=1&price_change_percentage=24h&sparkline=true');
      if (r1.ok) STATE.topCoins = await r1.json();
      const ids = STATE.topCoins.map((c) => c.id).join(',');
      if (ids) {
        const r2 = await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=usd,eur,ars,brl,mxn,gbp,jpy,clp,uyu`);
        if (r2.ok) STATE.simplePrices = await r2.json();
      }
      STATE.updatedAt = Date.now();
      renderAll();
      markUpdated(true);
    } catch (e) { console.error('[cx] fetch failed', e); }
    nextIn = 30;
  }

  function markUpdated(ok: boolean) {
    const now = new Date();
    const lq = document.getElementById('cx-last-query'); if (lq) lq.textContent = now.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    const badge = document.getElementById('cx-status-badge'); if (badge && ok) badge.textContent = 'En vivo';
    updateAgo();
  }
  function updateAgo() {
    const el = document.getElementById('cx-updated'); if (!el || !STATE.updatedAt) return;
    const s = Math.max(0, Math.round((Date.now() - STATE.updatedAt) / 1000));
    el.textContent = s < 5 ? 'Actualizado recién' : `Actualizado hace ${s} segundos`;
  }

  // ── Movimiento 24h ──
  const MOV_IDS = ['bitcoin', 'ethereum', 'solana', 'tether'];
  function renderMov() {
    const box = document.getElementById('cx-mov-list'); if (!box) return;
    const coins = MOV_IDS.map(coinById).filter(Boolean) as CoinGeckoCoin[];
    if (!coins.length) return;
    box.innerHTML = coins.map((c) => {
      const ch = c.price_change_percentage_24h ?? 0;
      return `<li class="cx-mov-row"><img class="cx-mov-img" src="${c.image}" alt="${c.symbol}" width="30" height="30" loading="lazy"/>` +
        `<span class="cx-mov-name"><b>${c.name}</b><small>${c.symbol.toUpperCase()}</small></span>` +
        `<span class="cx-mov-price">USD ${fUsd(c.current_price)}</span>` +
        `<span class="cx-chg ${ch >= 0 ? 'up' : 'down'}">${fPct(ch)}</span></li>`;
    }).join('');
  }

  // ── Principales ──
  const FEAT_IDS = ['bitcoin', 'ethereum', 'tether', 'solana'];
  function renderPrincipales() {
    const box = document.getElementById('principales')?.querySelector('.cx-princ-grid') as HTMLElement | null;
    if (!box) return;
    const coins = FEAT_IDS.map(coinById).filter(Boolean) as CoinGeckoCoin[];
    if (!coins.length) return;
    box.innerHTML = coins.map((c) => {
      const ch = c.price_change_percentage_24h ?? 0;
      const ars = STATE.simplePrices[c.id]?.ars;
      const sp = sparkPts(c.sparkline_in_7d?.price);
      const rank = STATE.topCoins.indexOf(c) + 1;
      return `<div class="cx-princ"><div class="cx-princ-top">` +
        `<img class="cx-princ-img" src="${c.image}" alt="${c.symbol}" width="30" height="30" loading="lazy"/>` +
        `<span class="cx-princ-name"><b>${c.name}</b><small>${c.symbol.toUpperCase()}</small></span>` +
        `<span class="cx-chg ${ch >= 0 ? 'up' : 'down'}">${fPct(ch)}</span></div>` +
        `<div class="cx-princ-usd">USD ${fUsd(c.current_price)}</div>` +
        `<div class="cx-princ-ars">ARS ${ars ? fArs(ars) : '—'}</div>` +
        `<div class="cx-princ-foot"><span class="cx-rank-badge">#${rank}</span>` +
        (sp ? `<svg class="cx-spark ${sp.up ? 'up' : 'down'}" viewBox="0 0 88 26" width="88" height="26" preserveAspectRatio="none" aria-hidden="true"><polyline points="${sp.pts}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>` : '') +
        `</div></div>`;
    }).join('');
  }

  // ── Ranking ──
  let RANK_FILTER = 'top';
  let RANK_SEARCH = '';
  const STABLES = new Set(['usdt', 'usdc', 'dai', 'usde', 'fdusd', 'tusd', 'usds', 'pyusd', 'busd']);
  function renderRanking() {
    const body = document.getElementById('cx-rank-body'); if (!body) return;
    let coins = STATE.topCoins.slice();
    const q = RANK_SEARCH.trim().toLowerCase();
    if (q) coins = coins.filter((c) => (c.name + ' ' + c.symbol + ' ' + c.id).toLowerCase().includes(q));
    if (RANK_FILTER === 'gainers') coins = coins.filter((c) => (c.price_change_percentage_24h ?? 0) > 0).sort((a, b) => (b.price_change_percentage_24h ?? 0) - (a.price_change_percentage_24h ?? 0));
    else if (RANK_FILTER === 'losers') coins = coins.filter((c) => (c.price_change_percentage_24h ?? 0) < 0).sort((a, b) => (a.price_change_percentage_24h ?? 0) - (b.price_change_percentage_24h ?? 0));
    else if (RANK_FILTER === 'stable') coins = coins.filter((c) => STABLES.has(c.symbol.toLowerCase()));
    const empty = document.getElementById('cx-rank-empty');
    if (empty) empty.hidden = coins.length > 0;
    const showMore = RANK_FILTER === 'top' && !q;
    body.innerHTML = coins.map((c) => {
      const idx = STATE.topCoins.indexOf(c);
      const ch = c.price_change_percentage_24h ?? 0;
      const ars = STATE.simplePrices[c.id]?.ars;
      const sp = sparkPts(c.sparkline_in_7d?.price);
      const hidden = showMore && idx >= 8 ? ' is-more' : '';
      const on = FAVS.has(c.id) ? ' is-on' : '';
      return `<div class="cx-rank-row${hidden}" data-sym="${c.symbol.toLowerCase()}" data-name="${c.name.toLowerCase()}">` +
        `<span class="cx-rank-n">${idx + 1}</span>` +
        `<span class="cx-rank-coin"><img src="${c.image}" alt="${c.symbol}" width="26" height="26" loading="lazy"/><span class="cx-rank-coin-name"><b>${c.name}</b><small>${c.symbol.toUpperCase()}</small></span></span>` +
        `<span class="cx-rank-usd ta-r">${fUsd2(c.current_price)}</span>` +
        `<span class="cx-rank-ars ta-r">${ars ? '$' + fArs(ars) : '—'}<small>estimado</small></span>` +
        `<span class="cx-rank-chg ta-r cx-chg ${ch >= 0 ? 'up' : 'down'}">${fPct(ch)}</span>` +
        `<span class="cx-rank-spark ta-c">${sp ? `<svg class="cx-spark ${sp.up ? 'up' : 'down'}" viewBox="0 0 88 26" width="72" height="24" preserveAspectRatio="none" aria-hidden="true"><polyline points="${sp.pts}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>` : ''}</span>` +
        `<button type="button" class="cx-star${on}" data-star="${c.id}" aria-label="Favorita">${FAVS.has(c.id) ? '★' : '☆'}</button>` +
        `</div>`;
    }).join('');
    const count = document.getElementById('cx-rank-count');
    if (count) count.textContent = `${STATE.topCoins.length} activos · última actualización ${new Date(STATE.updatedAt || Date.now()).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false })}`;
    const more = document.getElementById('cx-rank-more') as HTMLButtonElement | null;
    if (more) more.style.display = showMore && coins.length > 8 ? '' : 'none';
  }

  // ── Picker (cripto + fiat) ──
  interface CoinOption { value: string; label: string; code: string; group: string; searchText: string; }
  let CX_OPTIONS: CoinOption[] = [];
  function buildCoinOptions() {
    CX_OPTIONS = [];
    for (const c of STATE.topCoins) {
      CX_OPTIONS.push({ value: c.id, label: c.name, code: c.symbol.toUpperCase(), group: '🪙 Criptomonedas', searchText: `${c.name} ${c.symbol} ${c.id}`.toLowerCase() });
    }
    for (const [code, label] of Object.entries(FIAT_LABELS)) {
      CX_OPTIONS.push({ value: code, label, code, group: '💵 Monedas fiat', searchText: `${label} ${code}`.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '') });
    }
  }
  function findOption(value: string): CoinOption | undefined { return CX_OPTIONS.find((o) => o.value === value); }
  function updatePickerLabel(which: 'cx-from' | 'cx-to') {
    const hidden = document.getElementById(`${which}-currency`) as HTMLInputElement;
    const labelEl = document.querySelector(`[data-picker="${which}"] .cx-picker-label`);
    if (!hidden || !labelEl) return;
    const opt = findOption(hidden.value);
    if (opt && opt.group.includes('fiat')) labelEl.textContent = opt.label;
    else labelEl.textContent = opt ? `${opt.label} (${opt.code})` : hidden.value;
  }
  function renderPickerList(which: 'cx-from' | 'cx-to', query = '') {
    const listEl = document.querySelector(`[data-picker="${which}"] .cx-picker-list`);
    const hidden = document.getElementById(`${which}-currency`) as HTMLInputElement;
    if (!listEl || !hidden) return;
    const q = query.trim().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const filtered = q ? CX_OPTIONS.filter((o) => o.searchText.includes(q) || o.code.toLowerCase().includes(q)) : CX_OPTIONS;
    if (!filtered.length) { listEl.innerHTML = `<div class="cx-picker-empty">Sin resultados para "${query}"</div>`; return; }
    const html: string[] = []; let currentGroup = '';
    for (const opt of filtered) {
      if (opt.group !== currentGroup) { currentGroup = opt.group; html.push(`<div class="cx-picker-group">${currentGroup}</div>`); }
      const isSel = opt.value === hidden.value;
      html.push(`<div class="cx-picker-item ${isSel ? 'selected' : ''}" data-value="${opt.value}" role="option" aria-selected="${isSel}"><span>${opt.label}</span><span class="code">${opt.code}</span></div>`);
    }
    listEl.innerHTML = html.join('');
  }
  function openPicker(which: 'cx-from' | 'cx-to') {
    const other = which === 'cx-from' ? 'cx-to' : 'cx-from'; closePicker(other);
    const btn = document.getElementById(`${which}-currency-btn`);
    const panel = document.querySelector(`[data-picker="${which}"] .cx-picker-panel`) as HTMLElement;
    const search = panel?.querySelector('.cx-picker-search') as HTMLInputElement;
    if (!btn || !panel) return;
    btn.setAttribute('aria-expanded', 'true'); panel.hidden = false;
    if (search) { search.value = ''; renderPickerList(which, ''); setTimeout(() => search.focus(), 30); }
  }
  function closePicker(which: 'cx-from' | 'cx-to') {
    const btn = document.getElementById(`${which}-currency-btn`);
    const panel = document.querySelector(`[data-picker="${which}"] .cx-picker-panel`) as HTMLElement | null;
    if (btn && panel) { btn.setAttribute('aria-expanded', 'false'); panel.hidden = true; }
  }
  function setPickerValue(which: 'cx-from' | 'cx-to', value: string) {
    const hidden = document.getElementById(`${which}-currency`) as HTMLInputElement;
    hidden.value = value; updatePickerLabel(which); closePicker(which); renderConverter();
  }
  function populatePickers() {
    buildCoinOptions();
    (['cx-from', 'cx-to'] as const).forEach((which) => {
      const hidden = document.getElementById(`${which}-currency`) as HTMLInputElement;
      if (!hidden) return;
      if (!findOption(hidden.value)) hidden.value = which === 'cx-from' ? 'bitcoin' : 'USD';
      updatePickerLabel(which);
    });
  }

  // ── Conversor ──
  function convert(amount: number, from: string, to: string): number | null {
    if (!amount || from === to) return amount;
    const isFromFiat = from in FIAT_LABELS, isToFiat = to in FIAT_LABELS;
    if (!isFromFiat && !isToFiat) {
      const fu = STATE.simplePrices[from]?.usd, tu = STATE.simplePrices[to]?.usd;
      if (!fu || !tu) return null; return (amount * fu) / tu;
    }
    if (!isFromFiat && isToFiat) { const r = STATE.simplePrices[from]?.[to.toLowerCase()]; return r ? amount * r : null; }
    if (isFromFiat && !isToFiat) { const r = STATE.simplePrices[to]?.[from.toLowerCase()]; return r ? amount / r : null; }
    const btc = STATE.simplePrices['bitcoin']; if (!btc) return null;
    const fr = btc[from.toLowerCase()], tr = btc[to.toLowerCase()];
    if (!fr || !tr) return null; return amount * (tr / fr);
  }
  function renderConverter() {
    const fromAmtEl = document.getElementById('cx-from-amount') as HTMLInputElement;
    const toAmtEl = document.getElementById('cx-to-amount');
    const fromEl = document.getElementById('cx-from-currency') as HTMLInputElement;
    const toEl = document.getElementById('cx-to-currency') as HTMLInputElement;
    const rateMain = document.getElementById('cx-rate-main');
    const rateArs = document.getElementById('cx-rate-ars');
    if (!fromAmtEl || !toAmtEl || !fromEl || !toEl) return;
    const amount = parseAmount(fromAmtEl.value);
    const result = convert(amount, fromEl.value, toEl.value);
    if (result === null) { toAmtEl.textContent = '—'; if (rateMain) rateMain.textContent = 'Sin cotización disponible'; if (rateArs) rateArs.textContent = ''; return; }
    toAmtEl.textContent = fmtNum(result, 8);
    const fromOpt = findOption(fromEl.value), toOpt = findOption(toEl.value);
    const unit = convert(1, fromEl.value, toEl.value);
    if (rateMain && unit !== null && fromOpt && toOpt) rateMain.textContent = `1 ${fromOpt.code} = ${toOpt.code} ${fmtNum(unit, 8)}`;
    if (rateArs) {
      const arsVal = convert(amount, fromEl.value, 'ARS');
      rateArs.textContent = (toEl.value !== 'ARS' && arsVal !== null) ? `= ARS ${fArs(arsVal)}` : '';
    }
  }

  function renderAll() { renderMov(); renderPrincipales(); renderRanking(); populatePickers(); renderConverter(); }

  // ── Auto-refresh 30s + tick ──
  function startAutoRefresh() {
    if (REFRESH_TIMER) clearInterval(REFRESH_TIMER);
    REFRESH_TIMER = window.setInterval(() => { if (!document.hidden) fetchLive(); }, 30_000);
    if (TICK_TIMER) clearInterval(TICK_TIMER);
    TICK_TIMER = window.setInterval(() => {
      const nx = document.getElementById('cx-next');
      nextIn = Math.max(0, nextIn - 1);
      if (nx) nx.textContent = String(nextIn);
      updateAgo();
    }, 1000);
  }
  function stopAutoRefresh() { if (REFRESH_TIMER) { clearInterval(REFRESH_TIMER); REFRESH_TIMER = null; } if (TICK_TIMER) { clearInterval(TICK_TIMER); TICK_TIMER = null; } }

  // ── Eventos ──
  function wire() {
    document.getElementById('cx-from-amount')?.addEventListener('input', renderConverter);
    document.getElementById('cx-swap')?.addEventListener('click', () => {
      const fromEl = document.getElementById('cx-from-currency') as HTMLInputElement;
      const toEl = document.getElementById('cx-to-currency') as HTMLInputElement;
      [fromEl.value, toEl.value] = [toEl.value, fromEl.value];
      updatePickerLabel('cx-from'); updatePickerLabel('cx-to'); renderConverter();
    });
    document.querySelectorAll<HTMLButtonElement>('.cx-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const amt = chip.getAttribute('data-amt') || '1';
        const input = document.getElementById('cx-from-amount') as HTMLInputElement;
        const fromEl = document.getElementById('cx-from-currency') as HTMLInputElement;
        if (findOption('bitcoin')) { fromEl.value = 'bitcoin'; updatePickerLabel('cx-from'); }
        input.value = amt;
        document.querySelectorAll('.cx-chip').forEach((c) => c.classList.toggle('is-active', c === chip));
        renderConverter();
      });
    });
    document.getElementById('cx-rank-search')?.addEventListener('input', (e) => { RANK_SEARCH = (e.target as HTMLInputElement).value; renderRanking(); });
    document.querySelectorAll<HTMLButtonElement>('.cx-filter').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.cx-filter').forEach((x) => x.classList.toggle('is-active', x === b));
      RANK_FILTER = b.getAttribute('data-filter') || 'top';
      document.querySelector('.cx-rank-card')?.classList.remove('is-expanded');
      renderRanking();
    }));
    document.querySelectorAll<HTMLButtonElement>('.cx-cur-btn').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.cx-cur-btn').forEach((x) => x.classList.toggle('is-active', x === b));
      document.querySelector('.cx-rank-card')?.setAttribute('data-cur', b.getAttribute('data-cur') || 'usd');
    }));
    document.getElementById('cx-rank-more')?.addEventListener('click', () => {
      document.querySelector('.cx-rank-card')?.classList.add('is-expanded');
      (document.getElementById('cx-rank-more') as HTMLElement).style.display = 'none';
    });
    document.getElementById('cx-rank-body')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-star]') as HTMLElement | null;
      if (!btn) return;
      const id = btn.getAttribute('data-star')!;
      if (FAVS.has(id)) FAVS.delete(id); else FAVS.add(id);
      saveFavs(FAVS);
      btn.classList.toggle('is-on', FAVS.has(id));
      btn.textContent = FAVS.has(id) ? '★' : '☆';
    });
    (['cx-from', 'cx-to'] as const).forEach((which) => {
      const btn = document.getElementById(`${which}-currency-btn`);
      const panel = document.querySelector(`[data-picker="${which}"] .cx-picker-panel`) as HTMLElement;
      const search = panel?.querySelector('.cx-picker-search') as HTMLInputElement;
      const list = panel?.querySelector('.cx-picker-list') as HTMLElement;
      if (!btn || !panel) return;
      btn.addEventListener('click', () => { btn.getAttribute('aria-expanded') === 'true' ? closePicker(which) : openPicker(which); });
      search?.addEventListener('input', () => renderPickerList(which, search.value));
      search?.addEventListener('keydown', (e) => {
        const items = Array.from(list.querySelectorAll<HTMLElement>('.cx-picker-item'));
        let idx = items.findIndex((i) => i.classList.contains('active'));
        if (e.key === 'ArrowDown') { e.preventDefault(); idx = Math.min(idx + 1, items.length - 1); items.forEach((it, i) => it.classList.toggle('active', i === idx)); items[idx]?.scrollIntoView({ block: 'nearest' }); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); idx = Math.max(idx - 1, 0); items.forEach((it, i) => it.classList.toggle('active', i === idx)); items[idx]?.scrollIntoView({ block: 'nearest' }); }
        else if (e.key === 'Enter') { e.preventDefault(); const t = idx >= 0 ? items[idx] : items[0]; if (t) setPickerValue(which, t.dataset.value!); }
        else if (e.key === 'Escape') { e.preventDefault(); closePicker(which); (btn as HTMLElement).focus(); }
      });
      list?.addEventListener('click', (e) => { const item = (e.target as HTMLElement).closest('.cx-picker-item') as HTMLElement | null; if (item?.dataset.value) setPickerValue(which, item.dataset.value); });
    });
    document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.cx-picker')) { closePicker('cx-from'); closePicker('cx-to'); } });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stopAutoRefresh(); else { fetchLive(); startAutoRefresh(); } });
  }

  // ── Init ──
  loadBuildData();
  renderAll();
  wire();
  fetchLive();
  startAutoRefresh();
</script>
