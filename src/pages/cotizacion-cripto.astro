---
import Layout from '../layouts/Layout.astro';
import { freeOfferSchema } from '../lib/offer-schema';
import { fetchJSON } from '../lib/fetch-timeout';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DatosHoyNav from '../components/DatosHoyNav.astro';

// Force static generation
export const prerender = true;

const title = 'Cotización Cripto en Vivo: Bitcoin, Ethereum, USDT';
const description = 'Precio de Bitcoin, Ethereum, Solana, USDT y 100+ criptomonedas en vivo. Conversor BTC, ETH, SOL a dólar, euro, peso argentino. Actualización cada 30 segundos.';

// Fetch inicial de top cryptos server-side (para SEO + primer render rápido)
interface CoinGeckoCoin {
  id: string;
  symbol: string;
  name: string;
  image: string;
  current_price: number;
  market_cap: number;
  price_change_percentage_24h: number;
  sparkline_in_7d?: { price: number[] };
}
interface SimplePrice { [coinId: string]: { usd: number; eur: number; ars: number; brl: number; mxn: number; }; }

let topCoinsBuild: CoinGeckoCoin[] = [];
let simplePricesBuild: SimplePrice = {};
let buildTs = 0;

try {
  // Top 30 cryptos por market cap (con sparkline 7d para los mini-gráficos)
  topCoinsBuild = await fetchJSON<CoinGeckoCoin[]>(
    'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=30&page=1&price_change_percentage=24h&sparkline=true',
    []
  );

  // Precios en múltiples fiat para el conversor (solo top 30 para no saturar)
  const ids = topCoinsBuild.slice(0, 30).map(c => c.id).join(',');
  if (ids) {
    simplePricesBuild = await fetchJSON<SimplePrice>(
      `https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=usd,eur,ars,brl,mxn,gbp,jpy,clp,uyu`,
      {}
    );
  }
  buildTs = Date.now();
} catch (e) {
  console.warn('[cotizacion-cripto] CoinGecko fetch failed at build time:', e);
}

// ── Helpers de formato (mismos que el cliente) para render SSR crawleable ──
function fUsd(n: number): string {
  if (n == null || !isFinite(n)) return '—';
  const abs = Math.abs(n);
  const dec = abs >= 10000 ? 0 : abs >= 1 ? 2 : abs >= 0.01 ? 4 : 6;
  return new Intl.NumberFormat('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec }).format(n);
}
function fUsd2(n: number): string {
  if (n == null || !isFinite(n)) return '—';
  const abs = Math.abs(n);
  const dec = abs >= 1 ? 2 : abs >= 0.01 ? 4 : 6;
  return '$' + new Intl.NumberFormat('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec }).format(n);
}
function fArs(n: number): string {
  if (n == null || !isFinite(n)) return '—';
  return new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(n);
}
function fPct(n: number): string {
  const v = n ?? 0;
  return (v >= 0 ? '+' : '') + v.toFixed(2).replace('.', ',') + '%';
}
// Sparkline: muestrea ~24 puntos de la serie 7d y arma el polyline (88x26).
function spark(prices?: number[]): { pts: string; up: boolean } | null {
  const v = (prices || []).filter((x) => typeof x === 'number' && isFinite(x));
  if (v.length < 2) return null;
  const N = 24;
  const stepIn = Math.max(1, Math.floor(v.length / N));
  const s: number[] = [];
  for (let i = 0; i < v.length; i += stepIn) s.push(v[i]);
  if (s[s.length - 1] !== v[v.length - 1]) s.push(v[v.length - 1]);
  const min = Math.min(...s), max = Math.max(...s), span = max - min || 1;
  const w = 88, h = 26, pad = 3, step = w / (s.length - 1);
  const pts = s.map((n, i) => `${(i * step).toFixed(1)},${(h - pad - ((n - min) / span) * (h - pad * 2)).toFixed(1)}`).join(' ');
  return { pts, up: v[v.length - 1] >= v[0] };
}

const byId = Object.fromEntries(topCoinsBuild.map((c) => [c.id, c]));
// Activos "más consultados" para Movimiento 24h (curado) + featured Principales.
const featuredIds = ['bitcoin', 'ethereum', 'tether', 'solana'];
const movIds = ['bitcoin', 'ethereum', 'solana', 'tether'];
const featured = featuredIds.map((id) => byId[id]).filter(Boolean) as CoinGeckoCoin[];
const mov = movIds.map((id) => byId[id]).filter(Boolean) as CoinGeckoCoin[];
const rankRows = topCoinsBuild.slice(0, 30);

const buildClock = buildTs
  ? new Date(buildTs).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false })
  : '—';

// Cotización de referencia BTC→USD/ARS para el conversor por defecto (1 BTC).
const btc = byId['bitcoin'];
const btcUsd = btc?.current_price ?? simplePricesBuild['bitcoin']?.usd ?? null;
const btcArs = simplePricesBuild['bitcoin']?.ars ?? null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Cotización Cripto en Vivo',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description,
  offers: freeOfferSchema(),
};

// FAQ — las 4 primeras coinciden con el mockup; el resto amplía cobertura AEO.
const faq = [
  {
    q: '¿Por qué difiere de mi exchange?',
    a: 'El valor que ves acá es el <strong>precio de mercado global</strong> que calcula CoinGecko promediando 800+ exchanges. Tu exchange local (Binance, Ripio, Lemon, Belo) suma un <strong>spread del 0,5% al 3%</strong> más comisiones, así que su precio de compra siempre es un poco más alto y el de venta un poco más bajo.',
  },
  {
    q: '¿Qué monedas fiat puedo usar?',
    a: 'Principales: <strong>USD</strong>, <strong>EUR</strong>, <strong>ARS</strong> (peso argentino), <strong>BRL</strong> (real), <strong>MXN</strong> (peso mexicano), <strong>GBP</strong>, <strong>JPY</strong>, <strong>CLP</strong> y <strong>UYU</strong>. CoinGecko convierte directamente — no depende del dólar intermedio.',
  },
  {
    q: '¿Qué significa la variación 24h?',
    a: 'El porcentaje que subió o bajó el precio en las <strong>últimas 24 horas</strong>, comparando el valor actual contra el de exactamente un día atrás. Verde = subió, rojo = bajó. Es una métrica orientativa de tendencia a corto plazo.',
  },
  {
    q: '¿Cada cuánto se actualiza?',
    a: 'Cada <strong>30 segundos</strong> automáticamente mientras la pestaña esté activa, usando la API pública de <a href="https://www.coingecko.com" rel="noopener">CoinGecko</a>. Si la cerrás y volvés después, se refresca al entrar. Si la fuente se demora, se conserva el último dato válido con su horario.',
  },
  {
    q: '¿Qué criptomonedas soporta?',
    a: 'Las <strong>criptos más grandes por market cap</strong>: Bitcoin (BTC), Ethereum (ETH), Solana (SOL), Tether (USDT), USDC, BNB, XRP, Cardano, Avalanche, Dogecoin, Polkadot, Chainlink, Litecoin, TRON y muchas más.',
  },
  {
    q: '¿De dónde saca el precio CoinGecko?',
    a: 'Agrega datos de <strong>800+ exchanges</strong> (Binance, Coinbase, Kraken, Bitstamp, etc.) y calcula un precio promedio ponderado por volumen. Es el estándar de la industria para precios unificados.',
  },
  {
    q: '¿Qué es el market cap?',
    a: '<strong>Capitalización de mercado</strong>: precio × cantidad de monedas en circulación. Sirve para comparar el tamaño de una crypto: Bitcoin tiene el mayor market cap, Ethereum lo sigue, etc. El ranking de esta página está ordenado por market cap.',
  },
  {
    q: '¿Es precio de compra o de venta?',
    a: 'Es el <strong>precio de mercado promedio</strong>, ni compra ni venta. En tu exchange vas a ver un precio de compra levemente más alto (ask) y uno de venta más bajo (bid). La diferencia se llama <em>spread</em>.',
  },
];

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
    { '@type': 'ListItem', position: 2, name: 'Finanzas', item: 'https://hacecuentas.com/categoria/finanzas' },
    { '@type': 'ListItem', position: 3, name: 'Cotización cripto', item: 'https://hacecuentas.com/cotizacion-cripto' },
  ],
};

// Calculadoras cripto (targets vivos verificados; slugs viejos 301 → canónico).
const calcCards = [
  { icon: '↗', title: 'Ganancia de Bitcoin', desc: 'Resultado de compra y venta, incluyendo precio inicial y final.', href: '/calculadora-ganancia-perdida-criptomonedas', cta: 'Abrir calculadora' },
  { icon: '%', title: 'Staking y APY', desc: 'Proyectá rendimiento compuesto por días, meses o años.', href: '/calculadora-cagr-rendimiento-anualizado-compuesto', cta: 'Calcular rendimiento' },
  { icon: '≈', title: 'Impuesto cripto', desc: 'Estimación informativa del resultado gravado en Argentina.', href: '/calculadora-impuesto-ganancia-cripto-argentina-2026', cta: 'Estimar impuesto' },
  { icon: 'DCA', title: 'Compra periódica', desc: 'Simulá una estrategia de aportes periódicos.', href: '/calculadora-interes-compuesto', cta: 'Simular DCA' },
  { icon: 'AR', title: 'Bienes Personales', desc: 'Estimación informativa para tenencias cripto en Argentina.', href: '/calculadora-bienes-personales-2026', cta: 'Estimar impuesto' },
  { icon: '$', title: 'Cambio de monedas', desc: 'Compara dólar oficial, blue, MEP, CCL y cripto.', href: '/cambio-de-monedas', cta: 'Comparar dólares' },
];
---
<Layout image="/og/data-cotizacion-cripto.jpg" imageWidth={1200} imageHeight={675} title={title} description={description} schema={schema} domain="data" pageType="dashboard">
  <Header slot="header" />

  <article class="cx">
    <nav class="cx-crumb" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/categoria/finanzas">Finanzas</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Cotización cripto</span>
    </nav>

    <!-- HERO -->
    <header class="cx-hero">
      <div class="cx-hero-copy">
        <span class="cx-kicker">Mercado cripto global</span>
        <h1>Cotización cripto</h1>
        <p class="cx-lead">Consultá Bitcoin, Ethereum, Solana, USDT y más de 100 criptomonedas. Convertí precios globales a dólares o pesos argentinos.</p>
        <div class="cx-pills">
          <span class="cx-pill cx-pill-live"><span class="cx-dot" id="cx-live-dot" aria-hidden="true"></span><span id="cx-updated">Actualizado recién</span></span>
          <span class="cx-pill">Fuente: CoinGecko</span>
          <span class="cx-pill">Precios de referencia</span>
        </div>
      </div>
      <aside class="cx-status" aria-label="Estado de los precios">
        <div class="cx-status-top">
          <span class="cx-status-kicker">Estado de los precios</span>
          <span class="cx-status-badge" id="cx-status-badge">Actualizando</span>
        </div>
        <dl class="cx-status-rows">
          <div><dt>Última consulta</dt><dd id="cx-last-query">{buildClock}</dd></div>
          <div><dt>Próxima actualización</dt><dd><span id="cx-next">30</span> s</dd></div>
          <div><dt>Mercado de referencia</dt><dd>Global</dd></div>
        </dl>
      </aside>
    </header>

    <!-- TABS -->
    <nav class="cx-tabs" aria-label="Secciones">
      <a href="#conversor" class="is-active">Conversor</a>
      <a href="#principales">Principales</a>
      <a href="#ranking">Ranking</a>
      <a href="#calculadoras">Calculadoras</a>
      <a href="#como-funciona">Cómo funciona</a>
    </nav>

    <!-- CONVERSOR + MOVIMIENTO 24H -->
    <section class="cx-two" id="conversor">
      <!-- Conversor -->
      <div class="cx-card cx-conv">
        <div class="cx-card-head">
          <div>
            <h2>Conversor cripto</h2>
            <p class="cx-card-sub">Elegí cualquier combinación cripto o moneda fiat.</p>
          </div>
          <span class="cx-badge">Precio global</span>
        </div>

        <div class="cx-conv-box">
          <div class="cx-conv-field">
            <span class="cx-conv-label">Convertís</span>
            <div class="cx-conv-row">
              <input id="cx-from-amount" class="cx-conv-amount" type="text" inputmode="decimal" value="1" autocomplete="off" aria-label="Monto a convertir" />
              <div class="cx-picker" data-picker="cx-from">
                <button class="cx-picker-btn" id="cx-from-currency-btn" type="button" aria-haspopup="listbox" aria-expanded="false">
                  <span class="cx-picker-label">₿ Bitcoin (BTC)</span>
                  <span class="cx-picker-chev" aria-hidden="true">▾</span>
                </button>
                <div class="cx-picker-panel" hidden>
                  <input type="text" class="cx-picker-search" placeholder="Buscar: bitcoin, ETH, solana…" autocomplete="off" />
                  <div class="cx-picker-list" role="listbox"></div>
                </div>
              </div>
              <input type="hidden" id="cx-from-currency" value="bitcoin" />
            </div>
          </div>

          <button id="cx-swap" class="cx-swap" type="button" aria-label="Invertir monedas">⇄</button>

          <div class="cx-conv-field cx-conv-out">
            <span class="cx-conv-label">Recibís aproximadamente</span>
            <div class="cx-conv-row">
              <div id="cx-to-amount" class="cx-conv-result">{btcUsd ? fUsd2(btcUsd).replace('$', '') : '—'}</div>
              <div class="cx-picker" data-picker="cx-to">
                <button class="cx-picker-btn" id="cx-to-currency-btn" type="button" aria-haspopup="listbox" aria-expanded="false">
                  <span class="cx-picker-label">🇺🇸 Dólar (USD)</span>
                  <span class="cx-picker-chev" aria-hidden="true">▾</span>
                </button>
                <div class="cx-picker-panel" hidden>
                  <input type="text" class="cx-picker-search" placeholder="Buscar: USD, ARS, euro…" autocomplete="off" />
                  <div class="cx-picker-list" role="listbox"></div>
                </div>
              </div>
              <input type="hidden" id="cx-to-currency" value="USD" />
            </div>
          </div>
        </div>

        <div class="cx-rate" id="cx-rate-line">
          <span id="cx-rate-main">{btcUsd ? `1 BTC = USD ${fUsd2(btcUsd).replace('$', '')}` : '—'}</span>
          <span id="cx-rate-ars">{btcArs ? `= ARS ${fArs(btcArs)}` : ''}</span>
        </div>

        <div class="cx-chips">
          <button type="button" class="cx-chip" data-amt="0,01">0,01 BTC</button>
          <button type="button" class="cx-chip" data-amt="0,1">0,1 BTC</button>
          <button type="button" class="cx-chip" data-amt="1">1 BTC</button>
          <button type="button" class="cx-chip" data-amt="10">10 BTC</button>
        </div>
        <p class="cx-note">Valor indicativo. No incluye spread, comisiones ni impuestos de tu exchange.</p>
      </div>

      <!-- Movimiento 24h -->
      <div class="cx-card cx-mov">
        <div class="cx-card-head">
          <div>
            <h2>Movimiento 24 horas</h2>
            <p class="cx-card-sub">Activos más consultados.</p>
          </div>
          <span class="cx-badge cx-badge-plain">USD</span>
        </div>
        <ul class="cx-mov-list" id="cx-mov-list">
          {mov.map((c) => {
            const ch = c.price_change_percentage_24h ?? 0;
            return (
              <li class="cx-mov-row">
                <img class="cx-mov-img" src={c.image} alt={c.symbol} loading="lazy" width="30" height="30" />
                <span class="cx-mov-name"><b>{c.name}</b><small>{c.symbol.toUpperCase()}</small></span>
                <span class="cx-mov-price">USD {fUsd(c.current_price)}</span>
                <span class={`cx-chg ${ch >= 0 ? 'up' : 'down'}`}>{fPct(ch)}</span>
              </li>
            );
          })}
        </ul>
        <p class="cx-mov-note">Los precios locales pueden sumar un spread de 0,5% a 3% según exchange y medio de pago.</p>
      </div>
    </section>

    <!-- PRINCIPALES -->
    <section class="cx-section" id="principales">
      <div class="cx-head">
        <div>
          <h2>Principales criptomonedas</h2>
          <p class="cx-sub">Precio global y equivalencia estimada en pesos.</p>
        </div>
        <a class="cx-see" href="#ranking">Ver las 30 →</a>
      </div>
      <div class="cx-princ-grid">
        {featured.map((c) => {
          const ch = c.price_change_percentage_24h ?? 0;
          const ars = simplePricesBuild[c.id]?.ars;
          const sp = spark(c.sparkline_in_7d?.price);
          const rank = topCoinsBuild.indexOf(c) + 1;
          return (
            <div class="cx-princ">
              <div class="cx-princ-top">
                <img class="cx-princ-img" src={c.image} alt={c.symbol} loading="lazy" width="30" height="30" />
                <span class="cx-princ-name"><b>{c.name}</b><small>{c.symbol.toUpperCase()}</small></span>
                <span class={`cx-chg ${ch >= 0 ? 'up' : 'down'}`}>{fPct(ch)}</span>
              </div>
              <div class="cx-princ-usd">USD {fUsd(c.current_price)}</div>
              <div class="cx-princ-ars">ARS {ars ? fArs(ars) : '—'}</div>
              <div class="cx-princ-foot">
                <span class="cx-rank-badge">#{rank}</span>
                {sp && (
                  <svg class={`cx-spark ${sp.up ? 'up' : 'down'}`} viewBox="0 0 88 26" width="88" height="26" preserveAspectRatio="none" aria-hidden="true">
                    <polyline points={sp.pts} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- RANKING -->
    <section class="cx-section" id="ranking">
      <div class="cx-head">
        <div>
          <h2>Ranking por capitalización</h2>
          <p class="cx-sub">Buscá y compará precios, equivalencia y variación en 24 horas.</p>
        </div>
      </div>
      <div class="cx-card cx-rank-card" data-cur="usd">
        <div class="cx-rank-tools">
          <label class="cx-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="search" id="cx-rank-search" placeholder="Buscar cripto…" autocomplete="off" aria-label="Buscar criptomoneda" />
          </label>
          <div class="cx-filters" role="tablist" aria-label="Filtrar ranking">
            <button type="button" class="cx-filter is-active" data-filter="top">Top</button>
            <button type="button" class="cx-filter" data-filter="gainers">Ganadoras</button>
            <button type="button" class="cx-filter" data-filter="losers">Perdedoras</button>
            <button type="button" class="cx-filter" data-filter="stable">Stablecoins</button>
          </div>
          <div class="cx-cur" role="group" aria-label="Moneda">
            <button type="button" class="cx-cur-btn is-active" data-cur="usd">USD</button>
            <button type="button" class="cx-cur-btn" data-cur="ars">ARS</button>
          </div>
        </div>
        <div class="cx-rank-scroll">
          <div class="cx-rank-head" aria-hidden="true">
            <span>#</span><span>Crypto</span><span class="ta-r">Precio USD</span><span class="ta-r">Equiv. ARS</span><span class="ta-r">24 h</span><span class="ta-c">Tendencia</span><span></span>
          </div>
          <div id="cx-rank-body">
            {rankRows.map((c, i) => {
              const ch = c.price_change_percentage_24h ?? 0;
              const ars = simplePricesBuild[c.id]?.ars;
              const sp = spark(c.sparkline_in_7d?.price);
              return (
                <div class={`cx-rank-row${i >= 8 ? ' is-more' : ''}`} data-sym={c.symbol.toLowerCase()} data-name={c.name.toLowerCase()} data-chg={ch}>
                  <span class="cx-rank-n">{i + 1}</span>
                  <span class="cx-rank-coin">
                    <img src={c.image} alt={c.symbol} loading="lazy" width="26" height="26" />
                    <span class="cx-rank-coin-name"><b>{c.name}</b><small>{c.symbol.toUpperCase()}</small></span>
                  </span>
                  <span class="cx-rank-usd ta-r">{fUsd2(c.current_price)}</span>
                  <span class="cx-rank-ars ta-r">{ars ? '$' + fArs(ars) : '—'}<small>estimado</small></span>
                  <span class={`cx-rank-chg ta-r cx-chg ${ch >= 0 ? 'up' : 'down'}`}>{fPct(ch)}</span>
                  <span class="cx-rank-spark ta-c">
                    {sp && (
                      <svg class={`cx-spark ${sp.up ? 'up' : 'down'}`} viewBox="0 0 88 26" width="72" height="24" preserveAspectRatio="none" aria-hidden="true">
                        <polyline points={sp.pts} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </span>
                  <button type="button" class="cx-star" data-star={c.id} aria-label={`Marcar ${c.name} como favorita`}>☆</button>
                </div>
              );
            })}
          </div>
          <p class="cx-rank-empty" id="cx-rank-empty" hidden>Sin resultados.</p>
        </div>
        <div class="cx-rank-foot">
          <span id="cx-rank-count">{rankRows.length} activos · última actualización {buildClock}</span>
          <button type="button" class="cx-more" id="cx-rank-more">Mostrar más</button>
        </div>
      </div>
    </section>

    <!-- QUÉ MIRAR -->
    <section class="cx-section">
      <div class="cx-head">
        <div>
          <h2>Qué mirar antes de convertir</h2>
          <p class="cx-sub">El precio global no siempre coincide con el valor final de compra o venta.</p>
        </div>
      </div>
      <div class="cx-watch-grid">
        <div class="cx-watch">
          <span class="cx-watch-ico" aria-hidden="true">⇄</span>
          <h3>Precio versus cotización del exchange</h3>
          <p>Cada plataforma suma spread, comisiones y liquidez propia.</p>
          <a href="/calculadora-impuesto-ganancia-cripto-argentina-2026">Estimar impuesto cripto →</a>
        </div>
        <div class="cx-watch">
          <span class="cx-watch-ico" aria-hidden="true">$</span>
          <h3>Equivalencia en pesos</h3>
          <p>Es una referencia de mercado, no necesariamente el precio cripto local.</p>
          <a href="/cambio-de-monedas">Comparar con dólar cripto →</a>
        </div>
        <div class="cx-watch">
