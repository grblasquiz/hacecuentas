---
// @incremental-standalone — landing estática aislada; habilita deploy incremental.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/live/futbol-argentino.json';
import { footballMatchFragment, footballMatchName, footballSportsEvent } from '../lib/football-seo';
const title = 'Fútbol argentino hoy: partidos, resultados y tablas | Hacé Cuentas';
const description = 'Partidos de hoy, resultados en vivo, próximos encuentros y tablas actualizadas de Primera División y Primera Nacional del fútbol argentino.';
const TZ = 'America/Argentina/Buenos_Aires';
const dateKey = (value: string | Date) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year:'numeric', month:'2-digit', day:'2-digit' }).format(new Date(value));
const todayKey = dateKey(new Date());
const teams = (event: any) => event.competitions?.[0]?.competitors || [];
const side = (event: any, homeAway: string) => teams(event).find((team: any) => team.homeAway === homeAway);
const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char] || char));
const fmtDay = (iso: string) => new Intl.DateTimeFormat('es-AR', { timeZone: TZ, weekday:'short', day:'2-digit', month:'short' }).format(new Date(iso)).replace('.', '');
const fmtHour = (iso: string) => new Intl.DateTimeFormat('es-AR', { timeZone: TZ, hour:'2-digit', minute:'2-digit', hour12:false }).format(new Date(iso));
const longDate = new Intl.DateTimeFormat('es-AR', { timeZone: TZ, weekday:'long', day:'numeric', month:'long' }).format(new Date());
const allEvents = [
  ...(data.first?.events || []).map((event: any) => ({ ...event, league:'Primera' })),
  ...(data.national?.events || []).map((event: any) => ({ ...event, league:'Nacional' })),
].sort((a: any, b: any) => new Date(a.date).getTime() - new Date(b.date).getTime());
const todays = allEvents.filter((event: any) => dateKey(event.date) === todayKey);
const recent = allEvents.filter((event:any)=>dateKey(event.date)<todayKey&&(event.competitions?.[0]?.status?.type?.completed||event.competitions?.[0]?.status?.type?.state==='post')).sort((a:any,b:any)=>+new Date(b.date)-+new Date(a.date)).slice(0,12);
const upcoming = allEvents.filter((event: any) => dateKey(event.date) > todayKey).slice(0, 12);
const liveCount = todays.filter((event: any) => event.competitions?.[0]?.status?.type?.state === 'in').length;
const matchHtml = (event: any, showDay = false) => {
  const home = side(event, 'home'); const away = side(event, 'away');
  const status = event.competitions?.[0]?.status; const state = status?.type?.state;
  const live = state === 'in'; const done = status?.type?.completed || state === 'post';
  const label = live ? `● ${esc(status.displayClock || 'EN VIVO')}` : done ? 'Final' : showDay ? `${fmtDay(event.date)} · ${fmtHour(event.date)}` : fmtHour(event.date);
  const team = (entry: any) => {
    const logo = entry?.team?.logo ? '<img src="' + esc(entry.team.logo) + '" alt="" width="29" height="29" onerror="this.remove()">' : '';
    return `<div class="team"><span class="crest" aria-hidden="true"><span>⚽</span>${logo}</span><strong>${esc(entry?.team?.shortDisplayName || entry?.team?.displayName)}</strong><b>${done || live ? esc(entry?.score) : '—'}</b></div>`;
  };
  return `<article id="${esc(footballMatchFragment(event))}" class="match ${live ? 'liveMatch' : ''}"><h3 class="matchName">${esc(footballMatchName(event))}</h3><div class="matchTop"><span class="league">${esc(event.league)}</span><span class="state ${live ? 'live' : done ? 'final' : ''}">${label}</span></div>${team(home)}${team(away)}</article>`;
};
const stat = (entry: any, name: string) => entry.stats?.find((item: any) => item.name === name)?.displayValue || '0';
const tablesHtml = (groups: any[]) => groups.map((group: any, groupIndex: number) => `<article class="tableCard"><h3>${esc((group.name || `Zona ${groupIndex + 1}`).replace('Group', 'Zona'))}</h3><div class="tableWrap"><table><thead><tr><th>#</th><th>Equipo</th><th>PJ</th><th>DG</th><th>PTS</th></tr></thead><tbody>${(group.standings?.entries || []).map((entry: any, index: number) => `<tr><td><span class="rank ${index < 4 ? 'top' : ''}">${index + 1}</span></td><td><div class="club"><img src="${esc(entry.team?.logos?.[0]?.href)}" alt="" width="23" height="23"><span>${esc(entry.team?.shortDisplayName || entry.team?.displayName)}</span></div></td><td>${stat(entry, 'gamesPlayed')}</td><td>${stat(entry, 'pointDifferential')}</td><td><strong>${stat(entry, 'points')}</strong></td></tr>`).join('')}</tbody></table></div></article>`).join('');
const updatedAt = new Intl.DateTimeFormat('es-AR', { timeZone: TZ, hour:'2-digit', minute:'2-digit', hour12:false }).format(new Date(data.fetchedAt));
const schema={'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage',name:title,url:'https://hacecuentas.com/futbol-argentino-hoy',inLanguage:'es-AR',dateModified:data.fetchedAt},
  {'@type':'ItemList',name:'Partidos y resultados del fútbol argentino',itemListElement:[...recent,...todays,...upcoming].map((event:any,index:number)=>({'@type':'ListItem',position:index+1,item:footballSportsEvent(event,'Argentina','https://hacecuentas.com/futbol-argentino-hoy')}))}
]};
---

<Layout title={title} description={description} canonical="/futbol-argentino-hoy" audience="AR" domain="life" pageType="data" noAds={true} schema={schema}>
  <Header slot="header" />
  <main class="footballHub">
<section class="hero"><div class="wrap"><div class="breadcrumbs"><a href="/">Inicio</a><span>›</span><a href="/deportes">Deportes</a><span>›</span><strong>Fútbol argentino</strong></div><div class="heroGrid"><div><div class="kicker" id="todayLabel">{longDate}</div><h1>Fútbol argentino, <span>hoy</span></h1><p class="heroText">Resultados, horarios, próximos partidos y posiciones de Primera y Primera Nacional en un solo lugar.</p></div><div class="summary"><div class="metric"><b id="todayCount">{todays.length}</b><span>partidos hoy</span></div><div class="metric"><b id="liveCount">{liveCount}</b><span>en vivo</span></div><div class="metric"><b id="nextCount">{upcoming.length}</b><span>próximos</span></div></div></div><nav class="quickNav"><a href="#hoy">Hoy</a>{recent.length>0&&<a href="#resultados">Resultados recientes</a>}<a href="#proximos">Próximos 14 días</a><a href="#tablas" data-open-tab="first">Tabla Primera</a><a href="#tablas" data-open-tab="national">Tabla Nacional</a></nav></div></section>
  <div class="wrap content">
    <section class="section sectionCard" id="hoy"><div class="sectionHead"><div class="sectionTitle"><span class="sectionIcon">⚽</span><div><h2>Partidos de hoy</h2><p id="datePill">{longDate} · hora argentina</p></div></div><span class="sectionMeta">Se publica al finalizar cada partido · {updatedAt}</span></div><div class="matchesGrid" id="todayMatches" set:html={todays.length ? todays.map((event: any) => matchHtml(event)).join('') : '<div class="empty">No hay partidos programados hoy en estas categorías.</div>'}></div></section>
    {recent.length>0&&<section class="section sectionCard" id="resultados"><div class="sectionHead"><div class="sectionTitle"><span class="sectionIcon">✓</span><div><h2>Resultados recientes</h2><p>Últimas 72 horas</p></div></div></div><div class="matchesGrid" set:html={recent.map((event:any)=>matchHtml(event,true)).join('')}></div></section>}
    <section class="section sectionCard" id="proximos"><div class="sectionHead"><div class="sectionTitle"><span class="sectionIcon">▦</span><div><h2>Lo que viene</h2><p>Agenda de Primera y Primera Nacional</p></div></div><span class="sectionMeta">Próximos 14 días</span></div><div class="nextGrid" id="nextMatches" set:html={upcoming.length ? upcoming.map((event: any) => matchHtml(event, true)).join('') : '<div class="empty">El próximo cronograma todavía no fue publicado.</div>'}></div></section>
    <section class="tableShell" id="tablas"><div class="tableHeader"><div><h2>Tablas de posiciones</h2><p>Elegí el torneo para consultar todas sus zonas.</p></div><div class="tableTabs" role="tablist" aria-label="Elegir torneo"><button class="tableTab active" id="tab-first" role="tab" aria-selected="true" aria-controls="panel-first" data-tab="first">Primera</button><button class="tableTab" id="tab-national" role="tab" aria-selected="false" aria-controls="panel-national" data-tab="national">Primera Nacional</button></div></div><div class="leaguePanel active" id="panel-first" role="tabpanel" aria-labelledby="tab-first"><div class="groups" id="firstTables" set:html={tablesHtml(data.first?.groups || [])}></div><div class="tableNote"><span class="legend"><i></i>Primeros puestos</span><span>Datos 2026</span></div></div><div class="leaguePanel" id="panel-national" role="tabpanel" aria-labelledby="tab-national"><div class="groups" id="nationalTables" set:html={tablesHtml(data.national?.groups || [])}></div><div class="tableNote"><span class="legend"><i></i>Primeros puestos</span><span>Datos 2026</span></div></div></section>
    <p class="source">Horarios en Argentina. Los resultados y posiciones se actualizan desde fuentes deportivas públicas y pueden tener una breve demora respecto del campo de juego.</p>
  </div>
  
  <nav class="mobileNav"><a href="#hoy"><b>⚽</b>Hoy</a><a href="#proximos"><b>▦</b>Agenda</a><a href="#tablas" data-open-tab="first"><b>≡</b>Primera</a><a href="#tablas" data-open-tab="national"><b>≡</b>Nacional</a></nav>
  </main>
  <Footer slot="footer" />
</Layout>

<style>
:root{--blue:#1769e0;--blue-dark:#0b3268;--blue-soft:#eaf3ff;--ink:#142033;--muted:#66758a;--line:#e4eaf2;--paper:#f6f8fb;--white:#fff;--green:#0b9b64;--green-soft:#e8f8f1;--red:#e94646;--red-soft:#fff0ef;--amber:#f0a11a;--shadow:0 12px 36px rgba(20,47,82,.08)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button{font:inherit}main{min-height:100vh}.siteHeader{height:68px;padding:0 max(20px,calc((100vw - 1240px)/2));display:flex;align-items:center;gap:24px;background:rgba(255,255,255,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50}.brand{display:flex;align-items:center;gap:10px;font-weight:850;letter-spacing:-.02em}.brandMark{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:var(--blue);color:#fff;font-size:12px;letter-spacing:-.04em;box-shadow:0 5px 14px rgba(23,105,224,.25)}.brandSub{font-size:12px;font-weight:650;color:var(--muted);padding-left:14px;border-left:1px solid var(--line)}.desktopNav{margin-left:auto;display:flex;gap:6px}.desktopNav a{padding:8px 12px;border-radius:9px;font-size:13px;font-weight:650;color:#536176}.desktopNav a:hover{background:var(--blue-soft);color:var(--blue)}.dataState{display:flex;align-items:center;gap:7px;font-size:11px;font-weight:750;color:var(--green);padding:7px 10px;background:var(--green-soft);border-radius:99px}.dataState i{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 4px rgba(11,155,100,.12)}.wrap{width:min(1240px,calc(100% - 40px));margin:0 auto}.hero{padding:48px 0 26px;background:linear-gradient(180deg,#fff 0%,var(--paper) 100%)}.breadcrumbs{display:flex;align-items:center;gap:8px;color:#7b8899;font-size:12px;margin-bottom:22px}.breadcrumbs a:hover{color:var(--blue)}.breadcrumbs span{color:#b4bdc9}.heroGrid{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:end}.kicker{display:flex;align-items:center;gap:8px;color:var(--blue);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}.kicker:before{content:"";width:20px;height:3px;border-radius:3px;background:var(--blue)}h1{font-size:clamp(38px,5vw,66px);line-height:.98;letter-spacing:-.055em;margin:0;max-width:760px}h1 span{color:var(--blue)}.heroText{max-width:650px;color:var(--muted);font-size:16px;line-height:1.55;margin:18px 0 0}.summary{display:grid;grid-template-columns:repeat(3,112px);background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}.metric{padding:19px 16px;text-align:center}.metric+.metric{border-left:1px solid var(--line)}.metric b{display:block;font-size:25px;letter-spacing:-.04em}.metric span{display:block;color:var(--muted);font-size:10px;font-weight:750;text-transform:uppercase;letter-spacing:.06em;margin-top:4px}.quickNav{display:flex;gap:8px;margin-top:30px;overflow:auto;padding-bottom:2px;scrollbar-width:none}.quickNav::-webkit-scrollbar{display:none}.quickNav a{flex:0 0 auto;padding:9px 13px;border:1px solid var(--line);background:#fff;border-radius:99px;color:#526176;font-size:12px;font-weight:700}.quickNav a:first-child{background:var(--ink);border-color:var(--ink);color:#fff}.quickNav a:hover{border-color:#b7c9e2;color:var(--blue)}.content{padding:24px 0 80px}.section{scroll-margin-top:88px;margin-top:28px}.sectionCard{background:#fff;border:1px solid var(--line);border-radius:22px;padding:26px;box-shadow:0 5px 24px rgba(24,54,90,.05)}.sectionHead{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:20px}.sectionTitle{display:flex;align-items:center;gap:12px}.sectionIcon{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:var(--blue-soft);color:var(--blue);font-size:18px}.sectionHead h2{font-size:23px;letter-spacing:-.035em;margin:0}.sectionHead p{font-size:12px;color:var(--muted);margin:4px 0 0}.sectionMeta{padding:8px 11px;border-radius:9px;background:#f7f9fc;color:#718095;font-size:11px;font-weight:700;white-space:nowrap}.matchesGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.match{border:1px solid var(--line);border-radius:15px;padding:15px;background:#fff;min-width:0;transition:.18s ease}.match:hover{transform:translateY(-2px);border-color:#bfd1ea;box-shadow:0 10px 24px rgba(28,65,109,.08)}.match.liveMatch{border-color:#efb7b4;background:linear-gradient(180deg,#fff 0%,#fffafa 100%)}.matchTop{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.league{font-size:9px;font-weight:850;text-transform:uppercase;letter-spacing:.09em;color:#718095}.state{font-size:10px;font-weight:800;padding:5px 7px;border-radius:7px;color:#5e6c7e;background:#f2f5f8}.state.live{color:var(--red);background:var(--red-soft)}.state.final{color:var(--green);background:var(--green-soft)}.team{display:grid;grid-template-columns:32px minmax(0,1fr) 28px;align-items:center;gap:9px;padding:8px 0}.team+.team{border-top:1px solid #eef2f6}.team img{width:29px;height:29px;object-fit:contain}.team strong{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.team b{text-align:right;font-size:19px;letter-spacing:-.03em}.nextGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.nextGrid .match{background:#fafbfd}.empty{padding:30px;border:1px dashed #cbd5e1;border-radius:14px;color:var(--muted);grid-column:1/-1;text-align:center;background:#fafbfd}.error{background:#fff7f4;border-color:#f2c5b5;color:#9a4327}.tableShell{margin-top:28px;background:#fff;border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 5px 24px rgba(24,54,90,.05);scroll-margin-top:88px}.tableHeader{padding:24px 26px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:24px}.tableHeader h2{font-size:23px;letter-spacing:-.035em;margin:0}.tableHeader p{font-size:12px;color:var(--muted);margin:5px 0 0}.tableTabs{display:flex;gap:4px;background:#f0f4f8;padding:4px;border-radius:11px}.tableTab{border:0;background:transparent;color:#647286;font-size:12px;font-weight:750;padding:8px 12px;border-radius:8px;cursor:pointer}.tableTab.active{background:#fff;color:var(--blue);box-shadow:0 2px 8px rgba(20,47,82,.09)}.leaguePanel{display:none;padding:22px 26px 26px}.leaguePanel.active{display:block}.groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.tableCard{border:1px solid var(--line);border-radius:15px;overflow:hidden}.tableCard h3{margin:0;padding:13px 16px;background:#f8fafc;border-bottom:1px solid var(--line);font-size:10px;text-transform:uppercase;letter-spacing:.11em;color:#66758a}table{width:100%;border-collapse:collapse;font-size:12px}th{color:#8793a3;font-size:8px;text-transform:uppercase;letter-spacing:.1em;padding:10px 8px;border-bottom:1px solid var(--line);text-align:center}th:nth-child(2){text-align:left}td{padding:9px 8px;border-bottom:1px solid #edf1f5;text-align:center}tbody tr:last-child td{border-bottom:0}tbody tr:hover{background:#fafcff}td:first-child{width:38px}.club{display:flex;align-items:center;gap:8px;text-align:left;font-weight:700}.club img{width:23px;height:23px;object-fit:contain}.rank{display:grid;place-items:center;width:22px;height:22px;border-radius:7px;color:#748195;font-size:10px}.rank.top{background:var(--blue-soft);color:var(--blue);font-weight:850}.tableNote{display:flex;gap:16px;align-items:center;padding-top:14px;color:#7c8898;font-size:10px}.legend{display:flex;align-items:center;gap:6px}.legend i{width:9px;height:9px;border-radius:3px;background:var(--blue-soft);border:1px solid #bdd5f8}.source{color:#7b8797;font-size:11px;line-height:1.5;margin:18px 4px 0}.siteFooter{border-top:1px solid var(--line);background:#fff;padding:30px 0 90px}.footerInner{display:flex;align-items:center;gap:22px;color:#748195;font-size:11px}.footerInner p{margin:0 auto 0 0}.mobileNav{display:none}.skeleton{min-height:130px;background:linear-gradient(90deg,#f1f4f7 25%,#fafbfd 45%,#f1f4f7 65%);background-size:300% 100%;animation:shine 1.35s infinite}@keyframes shine{to{background-position:-150% 0}}
    @media(max-width:980px){.heroGrid{grid-template-columns:1fr}.summary{width:100%;grid-template-columns:repeat(3,1fr)}.matchesGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.nextGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.groups{grid-template-columns:1fr}}
    @media(max-width:680px){.siteHeader{height:60px;padding:0 16px}.brandSub,.desktopNav,.dataState{display:none}.footballHub{overflow:hidden}.footballHub .wrap{width:calc(100vw - 28px);margin-inline:14px}.hero{padding:28px 0 16px}.breadcrumbs{margin-bottom:18px}.footballHub h1{font-size:40px;white-space:normal;overflow-wrap:anywhere}.heroText{font-size:14px;margin-top:13px}.heroGrid{gap:22px}.summary{border-radius:14px}.metric{padding:14px 8px}.metric b{font-size:21px}.metric span{font-size:8px}.quickNav{margin-top:20px}.content{padding-top:8px;padding-bottom:38px}.section{margin-top:18px}.sectionCard{padding:18px 14px;border-radius:17px}.sectionHead{margin-bottom:15px}.sectionIcon{width:34px;height:34px}.sectionHead h2,.tableHeader h2{font-size:20px}.sectionMeta{display:none}.matchesGrid,.nextGrid{grid-template-columns:1fr}.match{padding:13px;border-radius:13px}.nextGrid{gap:9px}.tableShell{margin-top:18px;border-radius:17px}.tableHeader{padding:19px 15px 0;display:block}.tableTabs{margin-top:16px;width:100%}.tableTab{flex:1}.leaguePanel{padding:15px}.tableCard{border-radius:12px}.tableWrap{overflow-x:auto}.club span{max-width:145px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tableNote{padding-left:2px}.footerInner{align-items:flex-start;flex-direction:column;gap:9px}.footerInner p{margin:0}.siteFooter{padding-bottom:86px}.mobileNav{display:grid;grid-template-columns:repeat(4,1fr);position:fixed;left:10px;right:10px;bottom:10px;z-index:60;background:rgba(20,32,51,.95);backdrop-filter:blur(12px);border-radius:15px;padding:6px;box-shadow:0 12px 32px rgba(11,30,54,.28)}.mobileNav a{display:flex;flex-direction:column;align-items:center;gap:4px;color:#c8d2df;font-size:8px;font-weight:750;text-transform:uppercase;letter-spacing:.05em;padding:6px}.mobileNav b{font-size:16px;color:#fff}.mobileNav a:first-child{background:rgba(255,255,255,.1);border-radius:10px}}
</style>

<!-- El contenido de partidos/tablas entra por set:html y no recibe el scope
     automático de Astro. Estas reglas son las mismas del mockup aprobado,
     acotadas al hub para no tocar el Header/Footer canónicos. -->
<style is:global>
  .footballHub .match{border:1px solid var(--line);border-radius:15px;padding:15px;background:#fff;min-width:0;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
  .footballHub .match:hover{transform:translateY(-2px);border-color:#bfd1ea;box-shadow:0 10px 24px rgba(28,65,109,.08)}
  .footballHub .match.liveMatch{border-color:#efb7b4;background:linear-gradient(180deg,#fff 0%,#fffafa 100%)}
  .footballHub .matchTop{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
  .footballHub .match{scroll-margin-top:88px}
  .footballHub .matchName{font-size:13px;line-height:1.35;margin:0 0 10px;color:var(--ink);letter-spacing:-.01em}
  .footballHub .matchName+.matchTop{padding-top:9px;border-top:1px solid #eef2f6}
  .footballHub .league{font-size:9px;font-weight:850;text-transform:uppercase;letter-spacing:.09em;color:#718095}
  .footballHub .state{font-size:10px;font-weight:800;padding:5px 7px;border-radius:7px;color:#5e6c7e;background:#f2f5f8}
  .footballHub .state.live{color:var(--red);background:var(--red-soft)}
  .footballHub .state.final{color:var(--green);background:var(--green-soft)}
  .footballHub .team{display:grid;grid-template-columns:32px minmax(0,1fr) 28px;align-items:center;gap:9px;padding:8px 0}
  .footballHub .team+.team{border-top:1px solid #eef2f6}
  .footballHub .team img{width:29px;height:29px;object-fit:contain}
  .footballHub .crest{position:relative;width:29px;height:29px;display:grid;place-items:center;border-radius:50%;background:#eef3f8;color:#8391a3;font-size:14px;overflow:hidden}
  .footballHub .crest>img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#fff}
  .footballHub .team strong{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .footballHub .team b{text-align:right;font-size:19px;letter-spacing:-.03em}
  .footballHub .nextGrid .match{background:#fafbfd}
  .footballHub .empty{padding:30px;border:1px dashed #cbd5e1;border-radius:14px;color:var(--muted);grid-column:1/-1;text-align:center;background:#fafbfd}
  .footballHub .tableCard{border:1px solid var(--line);border-radius:15px;overflow:hidden}
  .footballHub .tableCard h3{margin:0;padding:13px 16px;background:#f8fafc;border-bottom:1px solid var(--line);font-size:10px;text-transform:uppercase;letter-spacing:.11em;color:#66758a}
  .footballHub table{width:100%;border-collapse:collapse;font-size:12px}
  .footballHub th{color:#8793a3;font-size:8px;text-transform:uppercase;letter-spacing:.1em;padding:10px 8px;border-bottom:1px solid var(--line);text-align:center}
  .footballHub th:nth-child(2){text-align:left}
  .footballHub td{padding:9px 8px;border-bottom:1px solid #edf1f5;text-align:center}
  .footballHub tbody tr:last-child td{border-bottom:0}
  .footballHub tbody tr:hover{background:#fafcff}
  .footballHub td:first-child{width:38px}
  .footballHub .club{display:flex;align-items:center;gap:8px;text-align:left;font-weight:700}
  .footballHub .club img{width:23px;height:23px;object-fit:contain}
  .footballHub .rank{display:grid;place-items:center;width:22px;height:22px;border-radius:7px;color:#748195;font-size:10px}
  .footballHub .rank.top{background:var(--blue-soft);color:var(--blue);font-weight:850}
  @media(max-width:680px){.footballHub .match{padding:13px;border-radius:13px}.footballHub .tableCard{border-radius:12px}.footballHub .tableWrap{overflow-x:auto}.footballHub .club span{max-width:145px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}}
</style>

<script is:inline>
(()=>{
  function openTab(name){document.querySelectorAll('.tableTab').forEach(b=>{const on=b.dataset.tab===name;b.classList.toggle('active',on);b.setAttribute('aria-selected',String(on))});document.querySelectorAll('.leaguePanel').forEach(p=>p.classList.toggle('active',p.id==='panel-'+name))}document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>openTab(b.dataset.tab)));document.querySelectorAll('[data-open-tab]').forEach(a=>a.addEventListener('click',()=>openTab(a.dataset.openTab)));
})();
</script>
