<script is:inline>
  // Marca el próximo feriado según la fecha de hoy (client-side → siempre fresco,
  // aunque el HTML esté cacheado desde un build anterior).
  (function () {
    const hoy = new Date();
    const hoyISO = hoy.getFullYear() + '-' + String(hoy.getMonth() + 1).padStart(2, '0') + '-' + String(hoy.getDate()).padStart(2, '0');
    const rows = Array.prototype.slice.call(document.querySelectorAll('#feriados-table tbody tr'));
    let prox = null;
    for (const tr of rows) {
      const f = tr.getAttribute('data-fecha');
      if (f && f >= hoyISO) { prox = { fecha: f, row: tr }; break; }
    }
    const card = document.querySelector('[data-proximo]');
    if (!prox) {
      if (card) {
        const m = card.querySelector('[data-proximo-main]');
        const n = card.querySelector('[data-proximo-nombre]');
        const d = card.querySelector('[data-proximo-days]');
        if (m) m.textContent = 'Sin feriados pendientes';
        if (n) n.textContent = '2026 ya terminó su calendario';
        if (d) d.textContent = 'ver 2027';
      }
      return;
    }
    // El nombre sale de data-nombre y NO de textContent: la celda también
    // contiene la nota y el badge "Próximo" (aunque esté hidden, textContent lo incluye).
    const nombre = prox.row.getAttribute('data-nombre') || '';
    const dia = prox.row.children[1].textContent.trim();
    const [, mm, dd] = prox.fecha.split('-');
    const mesesL = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    const dds = Math.max(0, Math.round((Date.parse(prox.fecha + 'T00:00:00') - Date.parse(hoyISO + 'T00:00:00')) / 86400000));

    prox.row.classList.add('fc-proximo-row');
    // El badge ya viene en el SSR (hidden): así conserva los estilos scopeados,
    // que un elemento creado con createElement no recibiría.
    const badge = prox.row.querySelector('[data-badge]');
    if (badge) badge.removeAttribute('hidden');

    if (card) {
      const m = card.querySelector('[data-proximo-main]');
      const n = card.querySelector('[data-proximo-nombre]');
      const d = card.querySelector('[data-proximo-days]');
      if (m) m.textContent = dia + ' ' + Number(dd) + ' de ' + mesesL[Number(mm) - 1];
      if (n) n.textContent = nombre;
      if (d) d.textContent = dds === 0 ? 'es hoy' : dds === 1 ? 'es mañana' : 'faltan ' + dds + ' días';
    }
  })();
</script>

