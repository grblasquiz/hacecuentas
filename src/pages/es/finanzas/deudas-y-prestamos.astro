---
/**
 * Hub de decisión ES — deudas y préstamos. Reemplaza 3 calculadoras sueltas.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, MAX_MESES_SIMULACION } from '../../../lib/hubs/es/deudas-y-prestamos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/es' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="ES"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MAX_MESES: MAX_MESES_SIMULACION }}>
  (function () {
    const H = window.HC_HUB;
    const eur = (n) => Math.round(n || 0).toLocaleString('es-ES') + ' €';
    const pctS = (n) => n.toFixed(2).replace('.', ',') + '%';

    function cuotaFrancesa(capital, tinAnual, meses) {
      if (!(capital > 0) || meses <= 0) return 0;
      const i = tinAnual / 12;
      if (i === 0) return capital / meses;
      return (capital * i) / (1 - Math.pow(1 + i, -meses));
    }

    /** TAE efectiva a partir del coste total y el plazo. */
    function taeAproximada(capital, cuota, meses, comision) {
      const neto = capital - comision;
      if (!(neto > 0) || meses <= 0 || cuota <= 0) return 0;
      let lo = 0;
      let hi = 3;
      for (let k = 0; k < 80; k++) {
        const mid = (lo + hi) / 2;
        const i = mid / 12;
        const pv = i === 0 ? cuota * meses : (cuota * (1 - Math.pow(1 + i, -meses))) / i;
        if (pv > neto) lo = mid;
        else hi = mid;
      }
      return (lo + hi) / 2;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'personal';
      const capital = Math.max(0, v.capital || 0);
      const tin = Math.max(0, v.tin || 0) / 100;
      const meses = Math.max(1, Math.round(v.plazoMeses || 1));
      const comisionPct = Math.max(0, v.comisionApertura || 0) / 100;
      const tinRevolving = Math.max(0, v.tinRevolving || 0) / 100;
      const cuotaRevolving = Math.max(0, v.cuotaRevolving || 0);
      const cuotasActuales = Math.max(0, v.cuotasActuales || 0);
      const plazoReunificado = Math.max(1, Math.round(v.plazoReunificado || 1));

      const comision = capital * comisionPct;
      const cuota = cuotaFrancesa(capital, tin, meses);
      const totalPagado = cuota * meses + comision;
      const intereses = Math.max(0, cuota * meses - capital);
      const coste = Math.max(0, totalPagado - capital);
      const tae = taeAproximada(capital, cuota, meses, comision);

      const rows = [
        { k: 'Importe del préstamo', ref: 'Lo que te prestan', v: capital },
        { k: 'TIN', ref: 'Tipo nominal, sin comisiones', v: tin * 100, format: 'unit', unit: '%', decimals: 2 },
        { k: 'Comisión de apertura', ref: pctS(comisionPct * 100) + ' del importe', v: comision },
        { k: 'Plazo', ref: 'Mensualidades', v: meses, format: 'unit', unit: 'meses' },
        { k: 'Cuota mensual', ref: 'Sistema francés', v: cuota, extra: true },
        { k: 'Intereses del préstamo', ref: 'Todo el período', v: intereses },
        { k: 'Coste total del crédito', ref: 'Intereses más comisiones', v: coste, extra: true },
        { k: 'Total que devuelves', ref: 'Capital más coste', v: totalPagado },
        { k: 'TAE efectiva', ref: 'Con comisiones dentro', v: tae * 100, format: 'unit', unit: '%', decimals: 2, extra: true },
        {
          k: 'Diferencia entre TAE y TIN',
          ref: 'Lo que esconden las comisiones',
          v: (tae - tin) * 100,
          format: 'unit',
          unit: 'puntos',
          decimals: 2,
        },
      ];

      let principal = coste;
      let sub = '';

      if (id === 'revolving') {
        // Simulación mes a mes de la revolving.
        let saldo = capital;
        let mesesRev = 0;
        let interesesRev = 0;
        const iMes = tinRevolving / 12;
        while (saldo > 0.01 && mesesRev < MAX_MESES) {
          const interesMes = saldo * iMes;
          if (cuotaRevolving <= interesMes) {
            mesesRev = MAX_MESES;
            interesesRev = Infinity;
            break;
          }
          interesesRev += interesMes;
          saldo = saldo + interesMes - cuotaRevolving;
          mesesRev++;
        }
        const nunca = !isFinite(interesesRev) || mesesRev >= MAX_MESES;
        principal = nunca ? 0 : interesesRev;

        rows.push({ k: 'Saldo de la tarjeta', ref: 'Lo que debes ahora', v: capital });
        rows.push({
          k: 'TIN de la revolving',
          ref: 'Tipo de la tarjeta',
          v: tinRevolving * 100,
          format: 'unit',
          unit: '%',
          decimals: 2,
        });
        rows.push({ k: 'Cuota mensual que pagas', ref: 'La que tienes fijada', v: cuotaRevolving });
        rows.push({ k: 'Intereses del primer mes', ref: 'De tu cuota, esto no amortiza nada', v: capital * iMes });
        rows.push({
          k: 'Meses hasta saldarla',
          ref: nunca ? 'Con esa cuota la deuda no se salda nunca' : 'Sin volver a usar la tarjeta',
          v: nunca ? MAX_MESES : mesesRev,
          format: 'unit',
          unit: 'meses',
          extra: true,
        });
        rows.push({
          k: 'Intereses totales de la revolving',
          ref: nunca ? 'Deuda perpetua con esa cuota' : 'Lo que pagas de más',
          v: nunca ? 0 : interesesRev,
          extra: true,
        });
        rows.push({
          k: 'Lo que ahorrarías pasándola a préstamo personal',
          ref: 'Frente al préstamo de arriba',
          v: nunca ? 0 : Math.max(0, interesesRev - intereses),
        });

        sub = nunca
          ? 'Con una cuota de ' +
            eur(cuotaRevolving) +
            ' no llegas ni a cubrir los intereses del primer mes: la deuda no se salda nunca y crece'
          : 'Tardarías ' +
            mesesRev +
            ' meses en saldar ' +
            eur(capital) +
            ' y pagarías ' +
            eur(interesesRev) +
            ' sólo de intereses · pasarla a un préstamo personal ahorraría ' +
            eur(Math.max(0, interesesRev - intereses));
      } else if (id === 'reunificacion') {
        const cuotaNueva = cuotaFrancesa(capital, tin, plazoReunificado);
        const totalNuevo = cuotaNueva * plazoReunificado + comision;
        const alivioMensual = cuotasActuales - cuotaNueva;
        principal = Math.max(0, totalNuevo - capital);

        rows.push({ k: 'Cuotas que pagas ahora', ref: 'Suma de todas tus deudas', v: cuotasActuales });
        rows.push({ k: 'Cuota reunificada', ref: plazoReunificado + ' meses', v: cuotaNueva, extra: true });
        rows.push({
          k: alivioMensual >= 0 ? 'Alivio mensual' : 'Sobrecoste mensual',
          ref: 'Diferencia con lo que pagas hoy',
          v: Math.abs(alivioMensual),
          extra: true,
        });
        rows.push({ k: 'Total que devolverías reunificando', ref: 'Cuota × plazo más comisiones', v: totalNuevo });
        rows.push({ k: 'Coste total de reunificar', ref: 'Todo lo que pagas de más', v: principal, extra: true });
        rows.push({
          k: 'Sobrecoste frente al préstamo corto',
          ref: 'Por alargar el plazo',
          v: Math.max(0, principal - coste),
        });
        rows.push({
          k: 'Meses de más que pagarías',
          ref: 'Frente al plazo original',
          v: Math.max(0, plazoReunificado - meses),
          format: 'unit',
          unit: 'meses',
        });

        sub =
          'Reunificando pagarías ' +
          eur(cuotaNueva) +
          ' al mes en vez de ' +
          eur(cuotasActuales) +
          ', pero durante ' +
          plazoReunificado +
          ' meses: el crédito te costaría ' +
          eur(principal) +
          ' en total';
      } else {
        sub =
          'Un préstamo de ' +
          eur(capital) +
          ' al ' +
          pctS(tin * 100) +
          ' TIN a ' +
          meses +
          ' meses tiene una cuota de ' +
          eur(cuota) +
          ' y una TAE efectiva del ' +
          pctS(tae * 100) +
          ': devuelves ' +
          eur(coste) +
          ' de más';
      }

      return {
        total: eur(principal),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Capital prestado', value: Math.round(capital), tone: 'main' },
          { label: 'Coste del crédito', value: Math.round(coste), tone: 'bad' },
        ].filter(function (s) {
          return s.value > 0;
        }),
        format: 'unit',
        unit: '€',
        decimals: 0,
      };
    });
  })();
</script>
