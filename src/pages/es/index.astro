---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EspanaHomeExperience from '../../components/generated/EspanaHomeExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
const canonical='https://hacecuentas.com/es';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Hacé Cuentas España",url:canonical,operatingSystem:'Web'};
---
<Layout title="Hacé Cuentas España | Hacé Cuentas" description="Hacé Cuentas España. Herramienta clara, gratuita y actualizada." canonical={canonical} schema={schema} lang="es" hreflang={HOME_HREFLANG}>
  <Header />
  <EspanaHomeExperience />
  <RecoveredHubIntro eyebrow="España" h1="Calculadoras para España" lede="Herramientas gratuitas para resolver cuentas de trabajo, impuestos y finanzas con contexto local." note="Elegí un tema y revisá los datos y supuestos de cada cálculo." links={[{href:'/es/calculadoras',title:'Todas las calculadoras',description:'Explorá el catálogo disponible para España.'},{href:'/es/trabajo',title:'Trabajo',description:'Nómina, finiquito, paro y jubilación.'},{href:'/es/impuestos',title:'Impuestos',description:'IRPF y obligaciones habituales.'}]} />
  <Footer />
</Layout>
