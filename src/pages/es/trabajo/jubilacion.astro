---
/**
 * Hub de decisión ES — jubilación y pensiones. Reemplaza 5 calculadoras sueltas.
 * audience="ES" literal al Layout. define:vars serializa a JSON (Infinity → null).
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, PENSIONES, BRECHA, PORCENTAJE, ANTICIPACION } from '../../../lib/hubs/es/jubilacion';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/es' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="ES"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ P: PENSIONES, B: BRECHA, PCT: PORCENTAJE, A: ANTICIPACION }}>
  (function () {
    const H = window.HC_HUB;
    const eur = (n) => Math.round(n || 0).toLocaleString('es-ES') + ' €';

    function porcentajeCarrera(aniosCotizados) {
      const meses = aniosCotizados * 12;
      if (meses < PCT.mesesMinimos) return 0;
      const extra = meses - PCT.mesesMinimos;
      const tramo1 = Math.min(extra, PCT.mesesTramo1);
      const tramo2 = Math.max(0, extra - PCT.mesesTramo1);
      const pct = PCT.pctMinimo + tramo1 * PCT.porMesTramo1 + tramo2 * PCT.porMesTramo2;
      return Math.min(pct, PCT.pctMaximo);
    }

    function coeficienteMensual(aniosCotizados) {
      for (const par of A.coefVoluntaria) {
        const limite = par[0] == null ? Infinity : par[0];
        if (aniosCotizados < limite) return par[1];
      }
      return A.coefVoluntaria[A.coefVoluntaria.length - 1][1];
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'ordinaria';
      const base = Math.max(0, v.base || 0);
      const anios = Math.max(0, v.aniosCotizados || 0);
      const hijos = Math.max(0, Math.min(B.maxHijos, Math.round(v.hijos || 0)));
      const ipc = Math.max(0, v.ipc || 0);
      const pagas = Number(v.pagas) === 12 ? 12 : 14;
      const situacion = String(v.situacionViudedad || 'general');

      const rows = [];
      let pensionMensual = 0;
      let sub = '';
      let chart = [];

      if (id === 'viudedad') {
        const pctViudedad =
          situacion === 'cargas'
            ? P.viudedad.cargasFamiliares
            : situacion === 'mayor65'
              ? P.viudedad.mayor65SinRentas
              : P.viudedad.general;
        const bruta = base * (pctViudedad / 100);
        const minima =
          situacion === 'cargas'
            ? P.viudedadMinima2026.conCargas
            : situacion === 'mayor65'
              ? P.viudedadMinima2026.titular65
              : P.viudedadMinima2026.titularMenor60;
        pensionMensual = Math.min(Math.max(bruta, minima), P.maximaMensual);

        rows.push({ k: 'Base reguladora del fallecido', ref: 'Base del cálculo', v: base });
        rows.push({
          k: 'Porcentaje de viudedad',
          ref: situacion === 'cargas' ? 'Con cargas familiares' : situacion === 'mayor65' ? 'Mayor de 65 sin rentas' : 'General',
          v: pctViudedad,
          format: 'unit',
          unit: '%',
          decimals: 0,
        });
        rows.push({ k: 'Pensión resultante', ref: 'Base × porcentaje', v: bruta });
        rows.push({ k: 'Pensión mínima garantizada', ref: 'Según tu situación', v: minima });
        rows.push({ k: 'Pensión de viudedad', ref: 'Lo que cobrarías al mes', v: pensionMensual, extra: true });
        chart = [
          { label: 'Tu pensión de viudedad', value: Math.round(pensionMensual), tone: 'main' },
          { label: 'Pensión máxima del sistema', value: Math.round(P.maximaMensual), tone: 'prop' },
        ];
        sub =
          'Con una base de ' +
          eur(base) +
          ' y el ' +
          pctViudedad +
          '% aplicable, la pensión de viudedad queda en ' +
          eur(pensionMensual) +
          ' al mes en ' +
          pagas +
          ' pagas';
      } else {
        const pct = porcentajeCarrera(anios);
        const pensionOrdinaria = Math.min(base * (pct / 100), P.maximaMensual);

        const maxMeses = id === 'anticipada_involuntaria' ? A.maxMesesInvoluntaria : A.maxMesesVoluntaria;
        const meses = id === 'ordinaria' ? 0 : Math.min(Math.max(0, v.mesesAnticipados || 0), maxMeses);
        const coefMes = coeficienteMensual(anios) * (id === 'anticipada_involuntaria' ? A.factorInvoluntaria : 1);
        const reduccion = meses * coefMes;
        const pensionReducida = pensionOrdinaria * (1 - reduccion);

        const complementoBrecha = hijos * B.importeMensualPorHijo;
        pensionMensual = Math.min(pensionReducida + complementoBrecha, P.maximaMensual + complementoBrecha);

        const revalorizada = pensionMensual * (1 + ipc / 100);

        rows.push({ k: 'Base reguladora mensual', ref: 'Media de tus bases de cotización', v: base });
        rows.push({
          k: 'Años cotizados',
          ref: anios >= 15 ? 'Cumples el mínimo de 15 años' : 'No llegas al mínimo de 15 años',
          v: anios,
          format: 'unit',
          unit: 'años',
        });
        rows.push({
          k: 'Porcentaje de tu carrera',
          ref: '50% con 15 años, hasta el 100%',
          v: pct,
          format: 'unit',
          unit: '%',
          decimals: 2,
        });
        rows.push({ k: 'Pensión a la edad ordinaria', ref: 'Base × porcentaje, con tope', v: pensionOrdinaria });
        if (meses > 0) {
          rows.push({
            k: 'Meses de anticipación',
            ref: 'Máximo ' + maxMeses + ' en esta modalidad',
            v: meses,
            format: 'unit',
            unit: 'meses',
          });
          rows.push({
            k: 'Reducción por anticipar',
            ref: (coefMes * 100).toFixed(2).replace('.', ',') + '% por mes',
            v: reduccion * 100,
            format: 'unit',
            unit: '%',
            decimals: 2,
          });
          rows.push({ k: 'Lo que pierdes cada mes', ref: 'De por vida', v: pensionOrdinaria - pensionReducida });
        }
        if (hijos > 0) {
          rows.push({
            k: 'Complemento de brecha de género',
            ref: eur(B.importeMensualPorHijo) + ' por hijo, hasta ' + B.maxHijos,
            v: complementoBrecha,
          });
        }
        rows.push({ k: 'Pensión mensual', ref: 'Lo que cobrarías, en ' + pagas + ' pagas', v: pensionMensual, extra: true });
        rows.push({ k: 'Pensión anual', ref: pagas + ' pagas', v: pensionMensual * pagas });
        rows.push({
          k: 'Tras la revalorización',
          ref: 'Con un IPC del ' + String(ipc).replace('.', ',') + '%',
          v: revalorizada,
        });
        rows.push({ k: 'Pensión máxima del sistema', ref: 'Tope legal mensual', v: P.maximaMensual });
        rows.push({
          k: 'Tasa de sustitución',
          ref: 'Pensión ÷ base reguladora',
          v: base > 0 ? (pensionMensual / base) * 100 : 0,
          format: 'unit',
          unit: '%',
          decimals: 1,
        });

        chart = [
          { label: 'Tu pensión', value: Math.round(pensionMensual), tone: 'main' },
          { label: 'Lo que pierdes por anticipar', value: Math.round(pensionOrdinaria - pensionReducida), tone: 'bad' },
          { label: 'Hasta la pensión máxima', value: Math.round(Math.max(0, P.maximaMensual - pensionMensual)), tone: 'prop' },
        ];

        sub =
          anios < 15
            ? 'Con ' + anios + ' años cotizados no llegas al mínimo de 15: no hay pensión contributiva todavía'
            : 'Con ' +
              anios +
              ' años cotizados te corresponde el ' +
              pct.toFixed(2).replace('.', ',') +
              '% de tu base: ' +
              eur(pensionMensual) +
              ' al mes en ' +
              pagas +
              ' pagas' +
              (meses > 0 ? ' · anticipar ' + meses + ' meses te cuesta ' + eur(pensionOrdinaria - pensionReducida) + ' cada mes de por vida' : '');
      }

      return {
        total: eur(pensionMensual),
        sub: sub,
        rows: rows,
        chart: chart.filter(function (s) {
          return s.value > 0;
        }),
        format: 'unit',
        unit: '€',
        decimals: 0,
      };
    });
  })();
</script>
