---
/**
 * Silo Educación · España — índice de hubs de decisión del mercado ES.
 * El listado sale del registry, no a mano.
 */
export const prerender = true;

import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import SiloIndex from "../../../components/hub/SiloIndex.astro";
import { hubsOfSilo } from "../../../lib/hubs/registry";

const HREF = "/es/educacion";
const SILO = "Educación";
const LEDE =
  "Cuánto cuesta estudiar en España y qué nota necesitas: grados, FP, másteres, becas MEC y EvAU.";
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${SILO} en España`,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    "@type": "WebPage",
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title={`${SILO} en España — calculadoras y guías | Hacé Cuentas`}
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="ES"
  lang="es"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
