---
/**
 * Hub de decisión ES — cuánto cuesta estudiar. Reemplaza 5 calculadoras sueltas.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import MasterOficialTituloPropioExperience from '../../../components/generated/MasterOficialTituloPropioExperience.astro';
import {
  hub,
  PRIVADA_ANUAL,
  FP_TASAS,
  MASTER_CREDITO,
  UMBRALES_BECA,
  INCREMENTO_UMBRAL,
  BECA_CUANTIA,
  ERASMUS_MENSUAL,
} from '../../../lib/hubs/es/cuanto-cuesta-estudiar';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/es' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="ES"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <MasterOficialTituloPropioExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

