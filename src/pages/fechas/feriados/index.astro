---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import FeriadosHomeExperience from '../../../components/generated/FeriadosHomeExperience.astro';
import HubCitableStats from '../../../components/hub/HubCitableStats.astro';
import { hub } from '../../../lib/hubs/feriados';
const canonical='https://hacecuentas.com/fechas/feriados';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <FeriadosHomeExperience />
  <section class="next-year" aria-labelledby="feriados-2027-title">
    <h2 id="feriados-2027-title">Planificá los feriados de Argentina 2027</h2>
    <p>Consultá las fechas según la normativa vigente, Carnaval y las oportunidades de unir días libres. Los días turísticos pendientes se distinguen de los feriados definidos por ley.</p>
    <p><a href="/feriados-argentina-2027">Feriados Argentina 2027: calendario, fines de semana largos y puentes</a></p>
  </section>
  <HubCitableStats data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

<style>
  .next-year { max-width: 960px; margin: 2rem auto; padding: 0 1.25rem; }
  .next-year p { line-height: 1.6; }
</style>
