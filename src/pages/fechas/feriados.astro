---
/**
 * Hub de decisión — "¿Cuándo es el próximo feriado?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: próximo feriado (default), cuántos quedan, días hábiles
 * y fines de semana largos.
 *
 * OJO — HUB QUE CADUCA. En este archivo NO hay ningún año literal. `ANIO_TABLA`
 * se deriva de la primera fecha de la tabla de feriados y la fecha de referencia
 * sale de `new Date()` en el navegador. Si hoy cae fuera del año que cubre la
 * tabla, cada rama lo avisa en pantalla en vez de devolver 0.
 *
 * OJO formato: nada de esto es plata. Todas las filas declaran `format: 'unit'`
 * o `'plain'` porque el runtime hace Object.assign sobre el formato base 'ars' y
 * una fila sin formato propio saldría con "$" adelante.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, FERIADOS, CALENDARIO_META } from '../../lib/hubs/feriados';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ FERIADOS, META: CALENDARIO_META }}>
  (function () {
    const H = window.HC_HUB;
    const MS_DIA = 86400000;

    /** Fila con unidad explícita. Nada acá es plata. */
    const U = function (k, unit, v, decimals, ref, extra) {
      return { k: k, v: v, format: 'unit', unit: unit, decimals: decimals || 0, ref: ref, extra: !!extra };
    };

    const mk = function (y, m, d) { return new Date(y, m - 1, d, 0, 0, 0, 0); };
    const parseISO = function (s) {
      const p = String(s || '').split('-').map(Number);
      if (p.length !== 3 || p.some(isNaN)) return null;
      return mk(p[0], p[1], p[2]);
    };
    const hoyLocal = function () {
      const n = new Date();
      return mk(n.getFullYear(), n.getMonth() + 1, n.getDate());
    };
    const iso = function (d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    };
    const fmt = function (d) {
      try {
        return d.toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      } catch (e) {
        return d.getDate() + '/' + (d.getMonth() + 1) + '/' + d.getFullYear();
      }
    };

    // El año del calendario se DERIVA de la tabla cargada. Nunca se escribe.
    const ANIO_TABLA = FERIADOS.length ? Number(FERIADOS[0].fecha.slice(0, 4)) : 0;
    const FIN_ANIO = mk(ANIO_TABLA, 12, 31);

    const ES_NACIONAL = { inamovible: 1, trasladable: 1 };
    const cal = FERIADOS.map(function (f) {
      return { d: parseISO(f.fecha), fecha: f.fecha, nombre: f.nombre, tipo: f.tipo, trasladadoDe: f.trasladadoDe };
    });
    const tipoLabel = function (t) {
      return t === 'inamovible' ? 'Inamovible'
        : t === 'trasladable' ? 'Trasladable'
        : t === 'puente' ? 'Puente turístico'
        : 'Día no laborable';
    };

    /** Resultado "no puedo responder honestamente": la tabla es de otro año. */
    const fueraDeTabla = function (hoy) {
      const msg = hoy.getFullYear() > ANIO_TABLA
        ? 'El calendario cargado en el sitio es el de ' + ANIO_TABLA + ' y hoy ya estamos en ' + hoy.getFullYear() +
          '. Los feriados nacionales no cambian, pero los traslados y los puentes turísticos se decretan cada año: hasta que se publique el calendario nuevo no podemos darte una fecha real en vez de una inventada.'
        : 'El calendario cargado en el sitio es el de ' + ANIO_TABLA + ' y la fecha que elegiste es anterior a ese año. Elegí una fecha dentro de ' + ANIO_TABLA + '.';
      return {
        total: '—',
        sub: msg,
        rows: [
          { k: 'Año que cubre el calendario cargado', v: ANIO_TABLA, format: 'plain', decimals: 0, ref: META.fuente },
          U('Feriados y días no laborables en la tabla', 'días', cal.length, 0, 'Dato verificado al ' + META.dataAsOf),
        ],
        chart: [],
        format: 'unit',
        unit: 'días',
        decimals: 0,
        position: 100,
        positionLabel: 'Sin calendario cargado para ' + hoy.getFullYear(),
      };
    };

    /** Barra de progreso común: qué parte de los días no laborables del año ya pasó. */
    const progreso = function (hoy) {
      const pasados = cal.filter(function (f) { return f.d < hoy; }).length;
      const total = cal.length || 1;
      return {
        pasados: pasados,
        quedan: total - pasados,
        pct: Math.round((pasados / total) * 1000) / 10,
        chart: [
          { label: 'Ya pasaron', value: pasados, tone: 'prop' },
          { label: 'Quedan', value: total - pasados, tone: 'main' },
        ],
      };
    };

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'proximo';
      const hoy = hoyLocal();
      const desde = parseISO(v.desde) || hoy;
      const hasta = parseISO(v.hasta) || FIN_ANIO;
      const sabHabil = String(v.sabados) === 'si';
      const contarPuentes = String(v.puentes) !== 'no';
      const licencia = Math.max(0, Math.min(30, Math.round(Number(v.licencia) || 0)));

      // Fuera del año que cubre la tabla no se inventa nada.
      if (!ANIO_TABLA || desde.getFullYear() !== ANIO_TABLA) return fueraDeTabla(desde);

      const relevantes = cal.filter(function (f) { return contarPuentes || f.tipo !== 'puente'; });
      const prog = progreso(hoy);

      // ── Cuál es el próximo feriado ──────────────────────────────────────────
      if (id === 'proximo') {
        const futuros = relevantes.filter(function (f) { return f.d > desde; });
        if (!futuros.length) {
          return {
            total: '—',
            sub: 'Desde el ' + fmt(desde) + ' ya no quedan feriados en el calendario ' + ANIO_TABLA +
              '. El del año siguiente se publica por decreto entre septiembre y noviembre.',
            rows: [
              U('Feriados y días no laborables del año', 'días', cal.length, 0, META.fuente),
              U('Ya transcurridos', 'días', prog.pasados, 0, 'Al ' + fmt(hoy)),
            ],
            chart: prog.chart,
            format: 'unit',
            unit: 'días',
            decimals: 0,
            position: 100,
            positionLabel: 'No quedan feriados en el calendario ' + ANIO_TABLA,
          };
        }

        const prox = futuros[0];
        const dias = Math.round((prox.d - desde) / MS_DIA);
        const dow = prox.d.getDay();
        const pegado = dow === 1 || dow === 5;
        const seguidos = pegado ? 3 : dow === 0 || dow === 6 ? 2 : 1;

        const rows = [
          U('Faltan para ' + prox.nombre, 'días', dias, 0, fmt(prox.d) + ' · ' + tipoLabel(prox.tipo), true),
          U('Faltan en semanas', 'semanas', dias / 7, 1, 'Mismo período, otra unidad'),
          U('Días seguidos de descanso que arma', 'días', seguidos, 0,
            pegado ? 'Cae pegado al fin de semana' : dow === 0 || dow === 6 ? 'Cae en fin de semana: no suma día libre' : 'Día suelto en el medio de la semana'),
        ];
        if (prox.trasladadoDe) {
          const orig = parseISO(prox.trasladadoDe);
          rows.push(U('Días que se corrió respecto de la fecha original', 'días',
            Math.abs(Math.round((prox.d - orig) / MS_DIA)), 0,
            'La fecha original era el ' + fmt(orig) + ' · Decreto 1584/2010'));
        }
        if (futuros[1]) {
          rows.push(U('Faltan para el siguiente (' + futuros[1].nombre + ')', 'días',
            Math.round((futuros[1].d - desde) / MS_DIA), 0, fmt(futuros[1].d)));
        }
        if (futuros[2]) {
          rows.push(U('Faltan para el tercero (' + futuros[2].nombre + ')', 'días',
            Math.round((futuros[2].d - desde) / MS_DIA), 0, fmt(futuros[2].d)));
        }
        rows.push(U('Días no laborables que quedan en el año', 'días', futuros.length, 0, 'Calendario ' + ANIO_TABLA));
        rows.push(U('Feriados nacionales que quedan', 'feriados', futuros.filter(function (f) { return ES_NACIONAL[f.tipo]; }).length, 0, 'Inamovibles y trasladables'));

        return {
          total: dias.toLocaleString('es-AR') + (dias === 1 ? ' día' : ' días'),
          sub: prox.nombre + ' — ' + fmt(prox.d) + ' · ' + tipoLabel(prox.tipo) +
            (pegado ? ' · arma fin de semana largo de 3 días' : '') +
            ' · quedan ' + futuros.length + ' días no laborables en el calendario ' + ANIO_TABLA + '.',
          rows: rows,
          chart: prog.chart,
          format: 'unit',
          unit: 'días',
          decimals: 0,
          position: prog.pct,
          positionLabel: 'Ya pasaron ' + prog.pasados + ' de los ' + cal.length + ' días no laborables del año',
        };
      }

      // ── Cuántos feriados quedan ─────────────────────────────────────────────
      if (id === 'restan') {
        const futuros = cal.filter(function (f) { return f.d >= desde; });
        const nacionales = futuros.filter(function (f) { return ES_NACIONAL[f.tipo]; });
        const puentes = futuros.filter(function (f) { return f.tipo === 'puente'; });
        const noLab = futuros.filter(function (f) { return f.tipo === 'no-laborable'; });
        const enSemana = futuros.filter(function (f) { const w = f.d.getDay(); return w !== 0 && w !== 6; });
        const perdidos = futuros.length - enSemana.length;

        const rows = [
          U('Feriados nacionales que quedan', 'feriados', nacionales.length, 0, 'Inamovibles + trasladables', true),
          U('Puentes turísticos que quedan', 'días', puentes.length, 0, 'Resolución del Ministerio de Turismo'),
          U('Días no laborables que quedan', 'días', noLab.length, 0, 'A opción del empleador'),
          U('Total de días libres que quedan', 'días', futuros.length, 0, 'Todo junto', true),
          U('De esos, caen de lunes a viernes', 'días', enSemana.length, 0, 'Los que realmente te dan descanso'),
          U('Se pierden por caer sábado o domingo', 'días', perdidos, 0, 'No suman día libre'),
          U('Ya transcurridos en el año', 'días', prog.pasados, 0, 'Desde el 1 de enero'),
          U('Total del calendario del año', 'días', cal.length, 0, META.fuente),
        ];
        if (futuros.length) {
          rows.push(U('Faltan para el próximo (' + futuros[0].nombre + ')', 'días',
            Math.round((futuros[0].d - desde) / MS_DIA), 0, fmt(futuros[0].d)));
          const ultimo = futuros[futuros.length - 1];
          rows.push(U('Faltan para el último del año (' + ultimo.nombre + ')', 'días',
            Math.round((ultimo.d - desde) / MS_DIA), 0, fmt(ultimo.d)));
        }

        return {
          total: nacionales.length.toLocaleString('es-AR') + (nacionales.length === 1 ? ' feriado' : ' feriados'),
          sub: 'Desde el ' + fmt(desde) + ' quedan ' + nacionales.length + ' feriados nacionales' +
            (puentes.length || noLab.length ? ', más ' + (puentes.length + noLab.length) + ' día(s) no laborable(s) entre puentes turísticos y el 8 de diciembre' : '') +
            '. ' + enSemana.length + ' de esos días caen de lunes a viernes.',
          rows: rows,
          chart: prog.chart,
          format: 'unit',
          unit: 'días',
          decimals: 0,
          position: prog.pct,
          positionLabel: 'Ya pasaron ' + prog.pasados + ' de los ' + cal.length + ' días no laborables del año',
        };
      }

      // ── Días hábiles que quedan ─────────────────────────────────────────────
      if (id === 'habiles') {
        const fin = hasta < desde ? FIN_ANIO : hasta;
        const feriadoDe = {};
        for (let i = 0; i < relevantes.length; i++) feriadoDe[relevantes[i].fecha] = relevantes[i].nombre;

        let corridos = 0, habiles = 0, finde = 0, feriadosEnSemana = 0, feriadosTotal = 0, sabHabiles = 0;
        const cur = new Date(desde.getTime());
        // El día inicial se incluye; el final también, para que "del 1 al 31" sean 31 días.
        while (cur <= fin) {
          corridos++;
          const w = cur.getDay();
          const esFer = !!feriadoDe[iso(cur)];
          if (esFer) feriadosTotal++;
          const esFinde = w === 0 || (w === 6 && !sabHabil);
          if (esFinde) {
            finde++;
          } else if (esFer) {
            feriadosEnSemana++;
          } else {
            habiles++;
            if (w === 6) sabHabiles++;
          }
          cur.setDate(cur.getDate() + 1);
        }

        const semanas = corridos / 7;
        const rows = [
          U('Días hábiles del período', 'días hábiles', habiles, 0,
            sabHabil ? 'Lunes a sábado, sin feriados' : 'Lunes a viernes, sin feriados', true),
          U('Días corridos del período', 'días', corridos, 0, 'Del ' + fmt(desde) + ' al ' + fmt(fin)),
          U('Días de fin de semana', 'días', finde, 0, sabHabil ? 'Sólo domingos' : 'Sábados y domingos'),
          U('Feriados que caen de lunes a viernes', 'días', feriadosEnSemana, 0, 'Se descuentan de los hábiles'),
          U('Feriados del período en total', 'días', feriadosTotal, 0,
            contarPuentes ? 'Feriados, puentes y días no laborables' : 'Sólo feriados nacionales'),
          U('Feriados que se pierden en el finde', 'días', feriadosTotal - feriadosEnSemana, 0, 'Ya eran no laborables'),
          U('Semanas del período', 'semanas', semanas, 1, 'Días corridos dividido siete'),
          U('Proporción de días hábiles', '%', corridos > 0 ? (habiles / corridos) * 100 : 0, 1, 'Hábiles sobre corridos'),
          U('Horas de trabajo estimadas', 'horas', habiles * 8, 0, 'Jornada de 8 horas'),
        ];
        if (sabHabil) rows.push(U('Sábados contados como hábiles', 'días', sabHabiles, 0, 'Porque marcaste jornada de seis días'));

        return {
          total: habiles.toLocaleString('es-AR') + (habiles === 1 ? ' día hábil' : ' días hábiles'),
          sub: 'Entre el ' + fmt(desde) + ' y el ' + fmt(fin) + ' hay ' + corridos + ' días corridos: ' + finde +
            ' de fin de semana y ' + feriadosEnSemana + ' feriados en día de semana. Quedan ' + habiles + ' días hábiles.',
          rows: rows,
          // Dos segmentos, no tres: el gráfico es posicional y el marcador cae
          // en el % de hábiles. Con tres franjas el marcador no coincidiría con
          // ningún borde y la barra se leería mal.
          chart: [
            { label: 'Días hábiles', value: habiles, tone: 'main' },
            { label: 'Fines de semana y feriados', value: corridos - habiles, tone: 'prop' },
          ],
          format: 'unit',
          unit: 'días',
          decimals: 0,
          position: corridos > 0 ? Math.round((habiles / corridos) * 1000) / 10 : 0,
          positionLabel: habiles + ' de los ' + corridos + ' días del período son hábiles',
        };
      }

      // ── Fines de semana largos ──────────────────────────────────────────────
      const futuros = relevantes.filter(function (f) { return f.d >= desde; });
      const largos = [];
      for (let i = 0; i < futuros.length; i++) {
        const f = futuros[i];
        const w = f.d.getDay();
        if (w === 0 || w === 6) continue; // cae en el finde: no arma nada
        // Días no laborables consecutivos pegados a este (puente + feriado).
        let bloque = 1;
        let j = i + 1;
        while (j < futuros.length && Math.round((futuros[j].d - futuros[j - 1].d) / MS_DIA) === 1) { bloque++; j++; }
        const primero = f.d.getDay();
        const ultimo = futuros[i + bloque - 1].d.getDay();
        let seguidos = bloque;
        let necesita = 0;
        // El día puente que pedís de licencia TAMBIÉN es día de descanso: suma.
        if (primero === 1) seguidos += 2;                          // arranca lunes: viene del finde
        else if (primero === 2) { seguidos += 3; necesita += 1; }   // martes: lunes de licencia + finde
        if (ultimo === 5) seguidos += 2;                           // termina viernes: sigue el finde
        else if (ultimo === 4) { seguidos += 3; necesita += 1; }    // jueves: viernes de licencia + finde
        if (seguidos >= 3 && necesita <= licencia) {
          largos.push({ f: f, bloque: bloque, seguidos: seguidos, necesita: necesita });
        }
        i += bloque - 1;
      }

      const gratis = largos.filter(function (l) { return l.necesita === 0; });
      const rows = [
        U('Fines de semana largos que quedan', 'findes', largos.length, 0,
          licencia > 0 ? 'Usando hasta ' + licencia + ' día(s) de licencia' : 'Sin pedir licencia', true),
        U('De esos, sin pedir un solo día', 'findes', gratis.length, 0, 'Feriado pegado al fin de semana'),
      ];
      for (let i = 0; i < largos.length && i < 8; i++) {
        const l = largos[i];
        rows.push(U(l.f.nombre + ' — ' + l.seguidos + ' días seguidos', 'días',
          Math.round((l.f.d - desde) / MS_DIA), 0,
          fmt(l.f.d) + (l.necesita ? ' · pedís ' + l.necesita + ' día de licencia' : ' · sin licencia')));
      }
      const totalDias = largos.reduce(function (s, l) { return s + l.seguidos; }, 0);
      rows.push(U('Días de descanso seguidos que suman todos', 'días', totalDias, 0, 'Sumando cada fin de semana largo'));
      rows.push(U('Días de licencia que gastarías en total', 'días', largos.reduce(function (s, l) { return s + l.necesita; }, 0), 0, 'Contra tus 14 días corridos de vacaciones mínimas'));

      return {
        total: largos.length.toLocaleString('es-AR') + (largos.length === 1 ? ' finde largo' : ' findes largos'),
        sub: largos.length
          ? 'Desde el ' + fmt(desde) + ' quedan ' + largos.length + ' fines de semana largos' +
            (licencia > 0 ? ' si estás dispuesto a usar hasta ' + licencia + ' día(s) de licencia' : '') +
            '. El próximo es ' + largos[0].f.nombre + ', ' + fmt(largos[0].f.d) + ': ' + largos[0].seguidos + ' días seguidos.'
          : 'Desde el ' + fmt(desde) + ' no quedan fines de semana largos en el calendario ' + ANIO_TABLA + '.',
        rows: rows,
        chart: prog.chart,
        format: 'unit',
        unit: 'días',
        decimals: 0,
        position: prog.pct,
        positionLabel: 'Ya pasaron ' + prog.pasados + ' de los ' + cal.length + ' días no laborables del año',
      };
    });
  })();
</script>
