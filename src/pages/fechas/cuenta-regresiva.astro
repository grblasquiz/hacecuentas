---
/**
 * Hub de decisión — "¿Cuánto falta para…?"
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (fecha elegida, Navidad y fin de año, próximo
 * feriado, fechas móviles).
 *
 * OJO — HUB QUE CADUCA. En este archivo NO hay ningún año literal. Todo sale de
 * `new Date()` en el navegador. Una fecha pasada nunca devuelve negativo: salta
 * a la próxima ocurrencia y lo avisa. La tabla de feriados cubre un solo año y
 * el compute() lo detecta solo (`ANIO_TABLA`), avisando en pantalla si hoy cae
 * fuera en vez de mostrar un 0 engañoso.
 *
 * OJO formato: nada de esto es plata. Todas las filas declaran `format: 'unit'`
 * porque el runtime hace Object.assign y una fila sin formato propio saldría
 * con "$" adelante.
 *
 * Lo que se absorbe pero NO se reimplementa: la fecha de las próximas
 * elecciones por país. No hay en el repo una tabla electoral multi-país
 * mantenida, y hardcodearla sería exactamente el tipo de dato que caduca sin
 * que nadie se entere. La URL redirige igual.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import CuentaRegresivaExperience from '../../components/generated/CuentaRegresivaExperience.astro';
import {
  hub,
  FERIADOS,
  FECHAS_MOVILES,
  VERANO_MES,
  VERANO_DIA,
  MUNDIAL_2030,
  HITO_DIAS,
} from '../../lib/hubs/cuenta-regresiva';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CuentaRegresivaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

