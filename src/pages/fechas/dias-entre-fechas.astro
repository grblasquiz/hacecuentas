---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DiasEntreFechasHubExperience from '../../components/generated/DiasEntreFechasHubExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
const canonical='https://hacecuentas.com/fechas/dias-entre-fechas';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Días entre fechas",url:canonical,operatingSystem:'Web'};
---
<Layout title="Días entre fechas | Hacé Cuentas" description="Días entre fechas. Herramienta clara, gratuita y actualizada." canonical={canonical} schema={schema} lang="es">
  <Header />
  <DiasEntreFechasHubExperience />
  <RecoveredHubIntro eyebrow="Fechas" h1="Calcular días entre dos fechas" lede="Encontrá la diferencia entre fechas y resolvé cálculos de calendario sin hacer cuentas a mano." note="Elegí la herramienta según necesites días corridos, hábiles o una fecha futura." links={[{href:'/fechas/dias-entre-fechas',title:'Días entre fechas',description:'Medí la distancia entre dos fechas.'},{href:'/fechas/dias-habiles',title:'Días hábiles',description:'Excluí fines de semana y feriados cuando corresponda.'},{href:'/fechas/sumar-dias',title:'Sumar días',description:'Obtené una fecha anterior o posterior.'}]} />
  <Footer />
</Layout>
