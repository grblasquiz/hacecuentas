---
/**
 * Hub de decisión — "¿Mi bebé crece bien?" (0 a 24 meses)
 * Arquetipo RAMIFICADO. Absorbe 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/crecimiento-bebe.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y
 * no se tocan.
 *
 * YMYL de salud infantil: el hub informa percentiles, edad corregida y
 * cronologías, y remite al pediatra. No hay consejo clínico en ninguna rama.
 * El aviso médico (dominio `health` de src/lib/disclaimers.ts) viaja en
 * hub.fineprint y como primer `warn` de cada rama.
 *
 * NO se pisa con /salud/crecimiento-infantil: aquel arranca en edad escolar
 * (IMC infantil, talla adulta, mochila). Acá el rango es 0-24 meses.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import CrecimientoBebesExperience from '../../components/generated/CrecimientoBebesExperience.astro';
import { hub, WFA_LMS, BANDS, BAND_TONES, HITOS, HITOS_AREA, DIENTES, TALLA_PIE, PIE_POR_EDAD } from '../../lib/hubs/crecimiento-bebe';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CrecimientoBebesExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

