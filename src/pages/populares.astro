---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CATEGORY_COLORS, BRAND_DEFAULT } from '../lib/category-colors';
import { FEATURED } from '../lib/category-layout';

// "Las más usadas" — ranking de popularidad.
//
// SEÑAL REAL: src/lib/popular-curated.json (lo alimenta
// scripts/refresh-home-popular.py desde GSC clicks 28d; mismo origen que la
// home). Si ese JSON está commiteado, usamos su orden tal cual.
//
// FALLBACK (hoy el JSON no está commiteado): partimos de la lista curada
// histórica que ya usa index.astro y la completamos con los slugs FEATURED de
// cada categoría (category-layout.ts) para que la página tenga cuerpo aunque no
// haya analytics. Deduplicamos preservando el orden de prioridad.
//
// TODO: alimentar desde GSC/analytics — correr scripts/refresh-home-popular.py
// y commitear src/lib/popular-curated.json para que este ranking salga de datos
// reales en vez del fallback curado.

const calcModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
const calcs = Object.values(calcModules)
  .map((m: any) => m.default || m)
  .filter((c: any) => c && c.slug && c.h1 && !c.noindex);

// 1) Señal real desde GSC (si el JSON existe). Mismo patrón que index.astro.
const popularCuratedModules = import.meta.glob<any>('../lib/popular-curated.json', { eager: true });
const curatedJson: { slugs?: string[] } | null =
  (Object.values(popularCuratedModules)[0] as any)?.default ??
  (Object.values(popularCuratedModules)[0] as any) ??
  null;

// 2) Fallback curado histórico (espeja la lista de index.astro).
const CURATED_FALLBACK = [
  'sueldo-en-mano-argentina',
  'calculadora-aguinaldo-sac',
  'calculadora-monotributo-2026',
  'calculadora-impuesto-ganancias-sueldo',
  'calculadora-antiguedad-laboral',
  'calculadora-ingresos-brutos-provincial',
  'calculadora-impuesto-cheque-debitos-creditos',
  'calculadora-imc',
  'dias-entre-dos-fechas',
  'calculadora-conversor-metros-lineales-a-metros-cuadrados',
  'calculadora-estimador-costo-viaje-taxi-remis',
  'calculadora-impuesto-sellos-inmueble-contrato',
  'calculadora-costo-m2-construccion-argentina',
  'calculadora-cuantos-dias-faltan-Navidad-2026',
];

// 3) Completar con los FEATURED de cada categoría (orden estable por categoría).
const featuredFlat = Object.values(FEATURED).flat();

// Orden de prioridad: GSC → curada → featured. Dedup preservando orden y
// quedándonos sólo con slugs que existen en el catálogo vivo.
const bySlug = new Map(calcs.map((c: any) => [c.slug, c]));
const ranked: any[] = [];
const seen = new Set<string>();
for (const slug of [...(curatedJson?.slugs ?? []), ...CURATED_FALLBACK, ...featuredFlat]) {
  if (seen.has(slug)) continue;
  const c = bySlug.get(slug);
  if (!c) continue; // slug stale → lo salteamos (no rompe el build)
  seen.add(slug);
  ranked.push(c);
}

const usingRealData = Boolean(curatedJson?.slugs?.length);

const CATEGORY_LABELS: Record<string, string> = {
  finanzas: 'Finanzas',
  salud: 'Salud',
  negocios: 'Negocios',
  marketing: 'Marketing',
  vida: 'Vida cotidiana',
  deportes: 'Deportes',
  viajes: 'Viajes',
  construccion: 'Construcción',
  cocina: 'Cocina',
  mascotas: 'Mascotas',
  matematica: 'Matemática',
  educacion: 'Educación',
  automotor: 'Automotor',
  tecnologia: 'Tecnología',
  'medio-ambiente': 'Medio Ambiente',
  electronica: 'Electrónica',
  entretenimiento: 'Entretenimiento',
  ciencia: 'Ciencia',
  jardineria: 'Jardinería',
  familia: 'Familia',
  idiomas: 'Idiomas',
  impuestos: 'Impuestos',
  hogar: 'Hogar',
  clima: 'Clima',
  juegos: 'Juegos',
  astronomia: 'Astronomía',
};

const siteUrl = 'https://hacecuentas.com';
const title = 'Calculadoras más usadas — Hacé Cuentas';
const description = 'Las calculadoras más usadas de Hacé Cuentas: sueldo en mano, aguinaldo, monotributo, IMC, días entre fechas y más. Las que más buscan y usan los argentinos.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Calculadoras más usadas',
  description,
  url: `${siteUrl}/populares`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: ranked.length,
    itemListElement: ranked.map((c: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.h1,
      url: `${siteUrl}/${c.slug}`,
    })),
  },
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Más usadas', item: `${siteUrl}/populares` },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="/populares"
  audience="AR"
  schema={schema}
>
  <Header slot="header" />

  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />

  <nav class="breadcrumbs" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <span class="sep" aria-hidden="true">/</span>
    <span class="current">Más usadas</span>
  </nav>

  <header class="page-header">
    <h1>Las calculadoras más usadas</h1>
    <p>
      Las herramientas que más buscan y usan en Hacé Cuentas. Si buscás algo puntual,
      mirá el <a href="/calculadoras">índice completo</a> o usá el <a href="/buscar">buscador</a>.
    </p>
  </header>

  <ol class="pop-list">
    {ranked.map((c: any, i: number) => {
      const color = CATEGORY_COLORS[c.category] || BRAND_DEFAULT;
      const label = CATEGORY_LABELS[c.category] || c.category;
      return (
        <li class="pop-item">
          <a href={`/${c.slug}`} style={`--cat: ${color}`}>
            <span class="pop-rank">{i + 1}</span>
            <span class="pop-icon" aria-hidden="true">{c.icon || '🧮'}</span>
            <span class="pop-body">
              <span class="pop-name">
                {c.h1}
                {c.audience === 'AR' && (
                  <span class="ar-badge" title="Específica para Argentina" aria-label="Específica para Argentina">🇦🇷</span>
                )}
              </span>
              {c.description && <span class="pop-desc">{c.description}</span>}
            </span>
            <span class="pop-cat" style={`color: ${color}`}>{label}</span>
          </a>
        </li>
      );
    })}
  </ol>

  <p class="pop-foot">
    {usingRealData
      ? 'Ranking basado en las búsquedas y usos de los últimos 28 días.'
      : 'Selección de las calculadoras más populares del sitio.'}
    {' '}¿No encontrás la tuya? Está en el <a href="/calculadoras">índice completo</a>.
  </p>

  <Footer slot="footer" />
</Layout>

<style>
  .breadcrumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    margin-bottom: 1.25rem;
  }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }
  .breadcrumbs .sep { color: var(--border-strong); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }

  .page-header { margin-bottom: 1.75rem; }
  .page-header h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); margin-bottom: 0.5rem; }
  .page-header p { color: var(--text-muted); margin: 0; max-width: 640px; }

  .pop-list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .pop-item { margin: 0; }
  .pop-item a {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1.125rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .pop-item a:hover {
    border-color: var(--cat);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .pop-rank {
    flex-shrink: 0;
    width: 1.75rem;
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--cat);
    text-align: center;
  }
  .pop-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.375rem;
    background: color-mix(in srgb, var(--cat) 12%, transparent);
    border-radius: var(--radius-sm);
  }
  .pop-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .pop-name { font-weight: 600; font-size: 0.9375rem; line-height: 1.35; }
  .ar-badge { margin-left: 0.35em; font-size: 0.9em; vertical-align: middle; line-height: 1; }
  .pop-desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pop-cat {
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .pop-foot {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  @media (max-width: 560px) {
    .pop-cat { display: none; }
    .pop-item a { gap: 0.625rem; padding: 0.75rem 0.875rem; }
    .pop-icon { width: 38px; height: 38px; font-size: 1.2rem; }
  }
</style>
