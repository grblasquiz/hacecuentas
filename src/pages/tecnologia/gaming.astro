---
/**
 * Hub de decisión — "¿Qué FPS me da mi PC?"
 * Reemplaza 12 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (fps / fuente / costo / ping).
 * La página sólo aporta datos (src/lib/hubs/gaming.ts) y compute().
 *
 * Sólo la rama de costo es plata. FPS, Hz, ms, watts y GB declaran
 * `format: 'unit'` en TODAS las filas: el runtime hace Object.assign y una fila
 * sin formato propio caería a pesos con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  GPUS,
  CPUS,
  RESOLUCIONES,
  CALIDADES,
  GENEROS,
  UPSCALING,
  REFRIGERACION,
  PSU,
  PESO_JUEGOS,
  PING_RANGOS,
  VELOCIDAD_FIBRA,
  TARIFAS_2026,
  TARIFA_PARAMS,
  REFERENCIAS_OCIO,
  DIAS_MES,
} from '../../lib/hubs/gaming';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    GPUS,
    CPUS,
    RES: RESOLUCIONES,
    CAL: CALIDADES,
    GEN: GENEROS,
    UPS: UPSCALING,
    REFRI: REFRIGERACION,
    PSU,
    PESO: PESO_JUEGOS,
    PING: PING_RANGOS,
    FIBRA: VELOCIDAD_FIBRA,
    TARIFAS: TARIFAS_2026,
    TP: TARIFA_PARAMS,
    OCIO: REFERENCIAS_OCIO,
    DIAS_MES,
  }}
>
  (function () {
    const H = window.HC_HUB;

    // Formatos de fila. Sólo la rama de costo usa ARS; el resto son unidades.
    const ARS = { format: 'ars', decimals: 0 };
    const FPS = { format: 'unit', unit: 'FPS', decimals: 0 };
    const FPS1 = { format: 'unit', unit: 'FPS', decimals: 1 };
    const HZ = { format: 'unit', unit: 'Hz', decimals: 0 };
    const MS = { format: 'unit', unit: 'ms', decimals: 2 };
    const MS0 = { format: 'unit', unit: 'ms', decimals: 0 };
    const W = { format: 'unit', unit: 'W', decimals: 0 };
    const KWH = { format: 'unit', unit: 'kWh', decimals: 1 };
    const GB = { format: 'unit', unit: 'GB', decimals: 0 };
    const TB = { format: 'unit', unit: 'TB', decimals: 2 };
    const PCT = { format: 'unit', unit: '%', decimals: 1 };
    const KM = { format: 'unit', unit: 'km', decimals: 0 };
    const HS = { format: 'unit', unit: 'h', decimals: 1 };
    const NUM = { format: 'plain', decimals: 0 };

    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);
    const dec = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    /**
     * Precio marginal del kWh, del cuadro tarifario REAL del repo.
     * Energía + tasa de alumbrado + IVA + Ley 25.413. Con subsidio, el bloque
     * bonificado paga el 50%: para el consumo EXTRA de una PC lo relevante es
     * el precio marginal, así que ese es el que se usa.
     */
    function precioKwh(dist, cond) {
      const t = TARIFAS[dist] || TARIFAS.edenor;
      const impuestos = (1 + TP.alumbrado) * (1 + TP.iva) * (1 + TP.ley25413);
      const base = cond === 'con_subsidio' ? t.kwhPleno * (1 - TP.bonificacionBase) : t.kwhPleno;
      return { precio: base * impuestos, pleno: t.kwhPleno * impuestos, label: t.label, impuestos: impuestos };
    }

    /** Consumo pico del equipo, con la tabla del módulo real de fuentes. */
    function consumo(v) {
      const g = GPUS[String(v.gpu)] || GPUS.rtx4060;
      const c = CPUS[String(v.cpu)] || CPUS.medio;
      const r = REFRI[String(v.refrigeracion)] || REFRI.aire;
      const ram = Math.max(0, Number(v.ramGb) || 0) * PSU.RAM_W_GB;
      const discos = Math.max(0, Number(v.discos) || 0) * PSU.DISCO_W;
      const total = g.watts + c.watts + ram + discos + r.watts + PSU.BASE_W;
      return { g: g, c: c, r: r, ram: ram, discos: discos, total: total };
    }

    /** Modelo de FPS: la GPU pone el techo, el CPU puede bajarlo. */
    function estimarFps(v) {
      const g = GPUS[String(v.gpu)] || GPUS.rtx4060;
      const c = CPUS[String(v.cpu)] || CPUS.medio;
      const res = RES[String(v.resolucion)] || RES['1080p'];
      const cal = CAL[String(v.calidad)] || CAL.alto;
      const gen = GEN[String(v.genero)] || GEN.accion;
      const ups = UPS[String(v.upscaling)] || UPS.off;
      const ram = Math.max(0, Number(v.ramGb) || 0);
      // Penalización por RAM insuficiente: con 8 GB los AAA modernos se ahogan.
      const penRam = ram < 8 ? 0.6 : ram < 16 ? 0.85 : 1;

      const fpsGpu = g.fps * res.factor * cal.factor * gen.factor * ups.factor * penRam;
      // El techo del CPU casi no cambia con la resolución: por eso es el que
      // define el cuello de botella cuando bajás la calidad o el tamaño.
      const capCpu = c.cap * gen.factor * penRam;
      const fps = Math.min(fpsGpu, capCpu);
      const limita = capCpu < fpsGpu ? 'cpu' : 'gpu';
      const holgura = limita === 'cpu' ? (fpsGpu - capCpu) / fpsGpu : (capCpu - fpsGpu) / capCpu;
      return {
        g: g, c: c, res: res, cal: cal, gen: gen, ups: ups, penRam: penRam,
        fpsGpu: fpsGpu, capCpu: capCpu, fps: fps, limita: limita,
        bottleneck: Math.round(holgura * 100),
      };
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'fps';

      // ── Rama 1: cuántos FPS voy a tener ──────────────────────────────────
      if (id === 'fps') {
        const e = estimarFps(v);
        const hz = Math.max(1, Number(v.hz) || 60);
        const fps = e.fps;
        if (!(fps > 0)) {
          return { total: '—', sub: 'Elegí placa de video, procesador y resolución.', rows: [], chart: [] };
        }
        const vistos = Math.min(fps, hz);
        const tirados = Math.max(0, fps - hz);
        const faltantes = Math.max(0, hz - fps);
        const aprovechamiento = (vistos / hz) * 100;
        const frametime = 1000 / fps;

        let veredicto;
        if (tirados > 0) {
          veredicto =
            'Tu PC genera ' + dec(tirados, 0) + ' FPS que el monitor no llega a mostrar: ' +
            'subí calidad, resolución, o cambiá a un monitor de más Hz.';
        } else if (faltantes > 0) {
          veredicto =
            'Te faltan ' + dec(faltantes, 0) + ' FPS para exprimir tu monitor de ' + dec(hz, 0) +
            ' Hz: bajá calidad o activá escalado.';
        } else {
          veredicto = 'FPS y Hz están clavados: es el escenario ideal.';
        }

        const rows = [
          row('FPS estimados en tu configuración', fps, FPS, true),
          row('Techo de la placa (' + e.g.nombre + ')', e.fpsGpu, FPS, false, e.res.nombre + ' ' + e.cal.nombre.toLowerCase()),
          row('Techo del procesador (' + e.c.nombre + ')', e.capCpu, FPS),
          row('Cuello de botella', e.bottleneck, PCT, true, e.limita === 'cpu' ? 'lo frena el CPU' : 'lo frena la GPU'),
          row('Hz de tu monitor', hz, HZ),
          row('Frames que el monitor muestra', vistos, FPS, true),
          row('Frames por segundo que se desperdician', tirados, FPS, tirados > 0),
          row('Aprovechamiento del monitor', aprovechamiento, PCT),
          row('Frametime (lo que se siente al mover el mouse)', frametime, MS, false, '1.000 ÷ FPS'),
          row('Frametime del monitor a ' + dec(hz, 0) + ' Hz', 1000 / hz, MS),
          row('Mínimo jugable para ' + e.gen.nombre, e.gen.min, FPS),
          row('Recomendado para ' + e.gen.nombre, e.gen.rec, FPS),
          row('Ideal para ' + e.gen.nombre, e.gen.ideal, FPS),
          row('Megapíxeles que dibuja por frame', e.res.px / 1e6, { format: 'unit', unit: 'MP', decimals: 2 }),
          row('Píxeles por segundo', (e.res.px * fps) / 1e6, { format: 'unit', unit: 'MP/s', decimals: 0 }),
        ];
        if (e.ups.factor !== 1) {
          rows.push(row('Ganancia del escalado ' + e.ups.nombre, (e.ups.factor - 1) * 100, PCT));
        } else {
          rows.push(row('FPS con DLSS/FSR en modo calidad', Math.min(e.capCpu, e.fpsGpu * 1.35), FPS, false, 'si el juego lo soporta'));
        }
        if (e.penRam < 1) {
          rows.push(row('Penalización por RAM insuficiente', (1 - e.penRam) * 100, PCT, true, 'sumá memoria antes que cambiar la placa'));
        }
        rows.push(row('Presupuesto de referencia de una build así', e.g.usd, { format: 'unit', unit: 'USD', decimals: 0 }));

        const chart = [
          { label: 'FPS que muestra el monitor', value: vistos, tone: 'good' },
          { label: 'FPS desperdiciados (sobran)', value: tirados, tone: 'warn' },
          { label: 'FPS que te faltan para el monitor', value: faltantes, tone: 'bad' },
        ].filter(function (s) { return s.value > 0; });

        return {
          total: dec(fps, 0) + ' FPS',
          sub:
            e.g.nombre + ' + ' + e.c.nombre + ' en ' + e.res.nombre + ' ' + e.cal.nombre.toLowerCase() +
            ' · ' + dec(frametime, 1) + ' ms por frame · aprovechás el ' + dec(aprovechamiento, 0) +
            '% de tu monitor de ' + dec(hz, 0) + ' Hz · ' + veredicto,
          rows: rows,
          chart: chart,
          format: 'unit',
          unit: 'FPS',
          decimals: 0,
        };
      }

      // ── Rama 2: qué fuente necesito ──────────────────────────────────────
      if (id === 'fuente') {
        const k = consumo(v);
        if (!(k.total > 0)) {
          return { total: '—', sub: 'Elegí placa, procesador y refrigeración.', rows: [], chart: [] };
        }
        const psu = Math.ceil((k.total * PSU.MARGEN) / PSU.ESCALON) * PSU.ESCALON;
        let cert;
        if (k.total < 350) cert = '80 PLUS White o Bronze';
        else if (k.total < 700) cert = '80 PLUS Gold';
        else cert = '80 PLUS Gold o Platinum (ATX 3.1 si la placa usa 12V-2x6)';
        let tip;
        if (psu >= 1000) tip = 'PC top: exigí conector 12V-2x6 nativo, no adaptador de cuatro cabezas.';
        else if (psu >= 750) tip = 'Gaming sólido: comprá marca reconocida, no genérica.';
        else if (psu >= 550) tip = 'Mainstream: 550 W Gold cubre bien y deja margen de upgrade.';
        else tip = 'Equipo liviano: una fuente de 450 W certificada alcanza y sobra.';

        const pctGpu = (k.g.watts / k.total) * 100;
        const rows = [
          row('Placa de video (' + k.g.nombre + ')', k.g.watts, W, true),
          row('Procesador (' + k.c.nombre + ')', k.c.watts, W, true),
          row('Memoria RAM', k.ram, W, false, dec(PSU.RAM_W_GB, 1) + ' W por GB'),
          row('Discos y SSD', k.discos, W, false, dec(PSU.DISCO_W, 0) + ' W cada uno'),
          row('Refrigeración (' + k.r.nombre + ')', k.r.watts, W),
          row('Placa base, ventiladores y USB', PSU.BASE_W, W),
          row('Consumo real del equipo', k.total, W, true),
          row('Margen de seguridad del 35%', k.total * (PSU.MARGEN - 1), W, false, 'picos transitorios de la GPU'),
          row('Fuente recomendada', psu, W, true),
          row('Peso de la placa de video en el total', pctGpu, PCT),
          row('Consumo desde la pared (eficiencia 87%)', k.total / PSU.EFICIENCIA, W),
          row('Consumo estimado en reposo', k.total * PSU.IDLE_FRAC, W),
        ];

        return {
          total: dec(psu, 0) + ' W',
          sub:
            'Consumo real ' + dec(k.total, 0) + ' W · fuente recomendada ' + dec(psu, 0) + ' W ' + cert +
            ' · la placa se lleva el ' + dec(pctGpu, 0) + '% · ' + tip,
          rows: rows,
          chart: [
            { label: 'Placa de video', value: k.g.watts, tone: 'main' },
            { label: 'Procesador', value: k.c.watts, tone: 'warn' },
            { label: 'RAM', value: k.ram, tone: 'good' },
            { label: 'Discos', value: k.discos, tone: 'prop' },
            { label: 'Refrigeración', value: k.r.watts, tone: 'exit' },
            { label: 'Placa base y otros', value: PSU.BASE_W, tone: 'bad' },
          ].filter(function (s) { return s.value > 0; }),
          format: 'unit',
          unit: 'W',
          decimals: 0,
        };
      }

      // ── Rama 3: cuánto me cuesta jugar por mes ───────────────────────────
      if (id === 'costo') {
        const k = consumo(v);
        const t = precioKwh(String(v.distribuidora), String(v.condicion));
        const hj = Math.max(0, Number(v.horasJuegoDia) || 0);
        const hi = Math.max(0, Number(v.horasIdleDia) || 0);
        if (hj + hi === 0) {
          return { total: '$0', sub: 'Indicá cuántas horas por día usás la PC.', rows: [], chart: [] };
        }
        // De la pared sale más energía que la que consumen los componentes:
        // hay que dividir por la eficiencia de la fuente.
        const wJuego = k.total / PSU.EFICIENCIA;
        const wIdle = (k.total * PSU.IDLE_FRAC) / PSU.EFICIENCIA;
        const kwhJuego = (wJuego / 1000) * hj * DIAS_MES;
        const kwhIdle = (wIdle / 1000) * hi * DIAS_MES;
        const kwhMes = kwhJuego + kwhIdle;
        const costoJuego = kwhJuego * t.precio;
        const costoIdle = kwhIdle * t.precio;
        const costoMes = costoJuego + costoIdle;
        const horasMes = hj * DIAS_MES;
        const luzHora = horasMes > 0 ? costoJuego / horasMes : 0;

        const precioJuego = Math.max(0, Number(v.precioJuego) || 0);
        const horasJugadas = Math.max(0, Number(v.horasJugadas) || 0);
        const juegoHora = horasJugadas > 0 ? precioJuego / horasJugadas : 0;
        const cineHora = OCIO.cinePrecio / OCIO.cineHoras;
        const streamHora = OCIO.streamingPrecio / OCIO.streamingHoras;
        const totalHora = juegoHora + luzHora;

        const gbAAA = Math.max(0, Number(v.juegosAAA) || 0) * PESO.aaa;
        const gbIndie = Math.max(0, Number(v.juegosIndie) || 0) * PESO.indie;
        const gbMMO = Math.max(0, Number(v.juegosMMO) || 0) * PESO.mmo;
        const gbTotal = Math.ceil((gbAAA + gbIndie + gbMMO + PESO.sistema) * (1 + PESO.margen));

        const rows = [
          row('Consumo en juego', kwhJuego, KWH, false, dec(hj, 1) + ' h/día'),
          row('Consumo en reposo', kwhIdle, KWH, false, dec(hi, 1) + ' h/día'),
          row('Consumo total del mes', kwhMes, KWH, true),
          row('Precio del kWh que te aplica', t.precio, ARS, false, t.label + ', con impuestos'),
          row('Precio pleno del kWh (sin subsidio)', t.pleno, ARS),
          row('Costo de jugar', costoJuego, ARS, true),
          row('Costo de tenerla prendida sin jugar', costoIdle, ARS),
          row('Costo eléctrico del mes', costoMes, ARS, true),
          row('Costo eléctrico del año', costoMes * 12, ARS),
          row('Luz por hora de juego', luzHora, ARS),
          row('Amortización del juego por hora', juegoHora, ARS, false, dec(horasJugadas, 0) + ' h jugadas'),
          row('Costo total por hora de juego', totalHora, ARS, true),
          row('Una hora de cine, para comparar', cineHora, ARS),
          row('Una hora de streaming, para comparar', streamHora, ARS),
          row('Horas de juego al mes', horasMes, HS),
          row('Espacio que ocupa tu biblioteca', gbTotal, GB, false, 'con sistema y 10% libre'),
          row('En terabytes', gbTotal / 1000, TB),
          row('Consumo desde la pared jugando', wJuego, W),
        ];

        const barato =
          totalHora <= streamHora
            ? 'más barato que el streaming'
            : totalHora <= cineHora
              ? 'más barato que el cine, más caro que el streaming'
              : 'más caro que ir al cine: metele más horas';

        return {
          total: H.ars(costoMes),
          sub:
            dec(kwhMes, 1) + ' kWh al mes a ' + H.ars(t.precio) + '/kWh (' + t.label + ') · ' +
            H.ars(totalHora) + ' por hora de juego sumando luz y amortización · ' + barato,
          rows: rows,
          chart: [
            { label: 'Luz jugando', value: costoJuego, tone: 'main' },
            { label: 'Luz en reposo', value: costoIdle, tone: 'warn' },
          ].filter(function (s) { return s.value > 0; }),
          format: 'ars',
          decimals: 0,
        };
      }

      // ── Rama 4: cuánto ping es aceptable ─────────────────────────────────
      const km = Math.max(0, Number(v.distanciaKm) || 0);
      const pingReal = Math.max(0, Number(v.pingReal) || 0);
      const rango = PING[String(v.generoPing)] || PING.fps;
      if (!(km > 0)) {
        return { total: '—', sub: 'Indicá la distancia aproximada al servidor del juego.', rows: [], chart: [] };
      }
      // Ida y vuelta a ~200.000 km/s en fibra: ese es el piso físico.
      const teorico = ((km * 2) / FIBRA) * 1000;
      const factor = km < 1000 ? 2.5 : km < 5000 ? 2.0 : 1.8;
      const estimado = teorico * factor;
      const overhead = pingReal > 0 ? pingReal - teorico : estimado - teorico;

      let clasificacion, tono;
      if (pingReal <= rango.excelente) { clasificacion = 'Excelente'; tono = 'good'; }
      else if (pingReal <= rango.bueno) { clasificacion = 'Bueno'; tono = 'good'; }
      else if (pingReal <= rango.aceptable) { clasificacion = 'Aceptable'; tono = 'warn'; }
      else { clasificacion = 'Malo — vas a tener lag'; tono = 'bad'; }

      const e = estimarFps(v);
      const framesPerdidos = e.fps > 0 && pingReal > 0 ? (pingReal / 1000) * e.fps : 0;

      const rows = [
        row('Piso teórico por distancia', teorico, MS, true, 'ida y vuelta a 200.000 km/s en fibra'),
        row('Ping realista esperable', estimado, MS0, false, 'con el ruteo y el procesamiento reales'),
        row('Tu ping actual', pingReal, MS0, true),
        row('Overhead sobre el piso físico', overhead, MS0),
        row('Ping excelente para ' + rango.nombre, rango.excelente, MS0),
        row('Ping bueno para ' + rango.nombre, rango.bueno, MS0),
        row('Máximo tolerable para ' + rango.nombre, rango.aceptable, MS0, true),
        row('Distancia al servidor', km, KM),
        row('Cuántos frames de desventaja son, a tus FPS', framesPerdidos, FPS1, false, dec(e.fps, 0) + ' FPS estimados'),
        row('Latencia total sumando el frametime', pingReal + (e.fps > 0 ? 1000 / e.fps : 0), MS),
        row('Lo que agrega el WiFi, en el peor caso', 30, MS0, false, 'para competitivo, cable'),
      ];

      const relacion = teorico > 0 ? pingReal / teorico : 0;
      const diagnostico =
        pingReal === 0
          ? 'Cargá el ping que te marca el juego para compararlo con el piso físico.'
          : relacion < 2
            ? 'Tu ISP está ruteando muy bien: estás cerca del mínimo físico.'
            : relacion < 3
              ? 'El overhead es el normal para esa distancia.'
              : 'Tu ping está muy por encima de lo esperable: es ruteo del ISP o congestión, no distancia.';

      return {
        total: dec(pingReal, 0) + ' ms',
        sub:
          clasificacion + ' para ' + rango.nombre + ' · el piso físico a ' + dec(km, 0) + ' km es ' +
          dec(teorico, 1) + ' ms y lo esperable ' + dec(estimado, 0) + ' ms · ' + diagnostico,
        rows: rows,
        chart: [
          { label: 'Piso físico por distancia', value: Math.min(teorico, pingReal || teorico), tone: 'good' },
          { label: 'Overhead de red', value: Math.max(0, overhead), tone: tono === 'bad' ? 'bad' : 'warn' },
        ].filter(function (s) { return s.value > 0; }),
        format: 'unit',
        unit: 'ms',
        decimals: 0,
      };
    });
  })();
</script>
