---
/**
 * Hub de decisión — "¿Qué FPS me da mi PC?"
 * Reemplaza 12 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (fps / fuente / costo / ping).
 * La página sólo aporta datos (src/lib/hubs/gaming.ts) y compute().
 *
 * Sólo la rama de costo es plata. FPS, Hz, ms, watts y GB declaran
 * `format: 'unit'` en TODAS las filas: el runtime hace Object.assign y una fila
 * sin formato propio caería a pesos con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GamingExperience from '../../components/generated/GamingExperience.astro';
import {
  hub,
  GPUS,
  CPUS,
  RESOLUCIONES,
  CALIDADES,
  GENEROS,
  UPSCALING,
  REFRIGERACION,
  PSU,
  PESO_JUEGOS,
  PING_RANGOS,
  VELOCIDAD_FIBRA,
  TARIFAS_2026,
  TARIFA_PARAMS,
  REFERENCIAS_OCIO,
  DIAS_MES,
} from '../../lib/hubs/gaming';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <GamingExperience data={hub} />
  <Footer />
</Layout>

