---
/**
 * Hub de decisión — "¿Cuánto dura la batería?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: la rama activa llega como segundo argumento de
 * compute() y decide qué campos se leen. La rama por defecto es el dispositivo
 * con capacidad en mAh, que es la de más tráfico.
 *
 * La página sólo aporta datos (src/lib/hubs/baterias.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import BateriasExperience from '../../components/generated/BateriasExperience.astro';
import {
  hub,
  FACTOR_CARGA,
  MAX_C,
  QUIMICA_LABEL,
  QUIMICA_TIP,
  V_CELDA_LITIO,
  UPS_FP,
  UPS_WH_POR_VA,
  UPS_PEUKERT_EXP,
} from '../../lib/hubs/baterias';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <BateriasExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

