---
/**
 * Hub de decisión — "¿Cuánto dura la batería?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: la rama activa llega como segundo argumento de
 * compute() y decide qué campos se leen. La rama por defecto es el dispositivo
 * con capacidad en mAh, que es la de más tráfico.
 *
 * La página sólo aporta datos (src/lib/hubs/baterias.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BateriasExperience from '../../components/generated/BateriasExperience.astro';
import {
  hub,
  FACTOR_CARGA,
  MAX_C,
  QUIMICA_LABEL,
  QUIMICA_TIP,
  V_CELDA_LITIO,
  UPS_FP,
  UPS_WH_POR_VA,
  UPS_PEUKERT_EXP,
} from '../../lib/hubs/baterias';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <BateriasExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ FACTOR_CARGA, MAX_C, QUIMICA_LABEL, QUIMICA_TIP, V_CELDA_LITIO, UPS_FP, UPS_WH_POR_VA, UPS_PEUKERT_EXP }}
>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay pesos: TODAS las filas declaran su formato y su unidad.
    const HORAS = { format: 'unit', unit: 'h', decimals: 2 };
    const MINUTOS = { format: 'unit', unit: 'min', decimals: 1 };
    const WH = { format: 'unit', unit: 'Wh', decimals: 1 };
    const MAH = { format: 'unit', unit: 'mAh', decimals: 0 };
    const MILIAMP = { format: 'unit', unit: 'mA', decimals: 1 };
    const AMP = { format: 'unit', unit: 'A', decimals: 2 };
    const VOLT = { format: 'unit', unit: 'V', decimals: 1 };
    const WATT = { format: 'unit', unit: 'W', decimals: 0 };
    const AH = { format: 'unit', unit: 'Ah', decimals: 1 };
    const PORC = { format: 'unit', unit: '%', decimals: 0 };
    const TASA_C = { format: 'unit', unit: 'C', decimals: 2 };
    const DIAS = { format: 'unit', unit: 'días', decimals: 1 };

    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    const dec = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    const vacio = (msg) => ({ total: '—', sub: msg, rows: [], chart: [] });

    /** Duración legible: minutos, horas o días según la escala. */
    function txtDur(horas) {
      if (!isFinite(horas) || horas <= 0) return '—';
      if (horas < 1) return dec(horas * 60, 0) + ' min';
      if (horas < 48) {
        const h = Math.floor(horas);
        const m = Math.round((horas - h) * 60);
        return h + ' h ' + m + ' min';
      }
      return dec(horas / 24, 1) + ' días';
    }

    // ──────────────────── RAMA: dispositivo con batería en mAh ────────────────────
    // Calcado de `duracion-bateria-mah-consumo.ts`: capacidad × eficiencia ÷ consumo.
    function calcDispositivo(v) {
      const mah = Number(v.capacidadMah) || 0;
      const ma = Number(v.consumoMa) || 0;
      const effPct = Number(v.eficiencia) || 0;

      if (mah <= 0) return vacio('Ingresá la capacidad de la batería en mAh.');
      if (ma <= 0) return vacio('Ingresá el consumo del dispositivo en mA.');
      if (effPct <= 0 || effPct > 100) return vacio('La eficiencia tiene que estar entre 1% y 100%.');

      const eff = effPct / 100;
      const mahUtil = mah * eff;
      const mahPerdidos = mah - mahUtil;
      const horas = mahUtil / ma;
      const whNominal = (mah * V_CELDA_LITIO) / 1000;
      const whUtil = (mahUtil * V_CELDA_LITIO) / 1000;
      // Cuánto duraría sin descontar eficiencia: la "cuenta de servilleta".
      const horasIngenuas = mah / ma;

      const rows = [
        row('Autonomía estimada', horas, HORAS, true, 'mAh útiles ÷ mA'),
        row('En minutos', horas * 60, MINUTOS, false, 'uso continuo'),
        row('En días de uso continuo', horas / 24, DIAS, false, '24 h seguidas'),
        row('Capacidad realmente aprovechable', mahUtil, MAH, true, dec(effPct, 0) + '% de eficiencia'),
        row('Capacidad que se pierde', mahPerdidos, MAH, false, 'conversión y autoconsumo'),
        row('Energía nominal', whNominal, WH, false, 'a ' + dec(V_CELDA_LITIO, 1) + ' V de celda'),
        row('Energía aprovechable', whUtil, WH, false, 'la que llega a la carga'),
        row('Consumo cargado', ma, MILIAMP, false, 'promedio'),
        row('Lo que daría la cuenta sin eficiencia', horasIngenuas, HORAS, false, 'de más'),
      ];

      return {
        total: txtDur(horas),
        sub:
          dec(mah, 0) + ' mAh al ' + dec(effPct, 0) + '% de eficiencia son ' + dec(mahUtil, 0) +
          ' mAh reales · con ' + dec(ma, 1) + ' mA de consumo dan ' + dec(horas, 1) +
          ' h · la cuenta sin eficiencia te prometía ' + dec(horasIngenuas, 1) + ' h',
        rows: rows,
        chart: [
          { label: 'Capacidad aprovechable', value: Number(mahUtil.toFixed(1)), tone: 'main' },
          { label: 'Se pierde por eficiencia', value: Number(mahPerdidos.toFixed(1)), tone: 'warn' },
        ],
        format: 'unit',
        unit: 'mAh',
        decimals: 0,
      };
    }

    // ──────────────── RAMA: banco de 12/24/48 V medido en Ah ────────────────
    // Calcado de `bateria-capacidad-runtime-ah.ts`: Ah × V × DoD × eficiencia ÷ W.
    function calcBanco(v) {
      const ah = Number(v.ah) || 0;
      const volt = Number(v.vBateria) || 0;
      const w = Number(v.consumoW) || 0;
      const dodPct = Number(v.dod) || 0;
      const effPct = Number(v.eficiencia) || 0;

      if (ah <= 0) return vacio('Ingresá la capacidad del banco en Ah.');
      if (volt <= 0) return vacio('Ingresá la tensión de la batería en volts.');
      if (w <= 0) return vacio('Ingresá el consumo de la carga en watts.');
      if (dodPct <= 0 || dodPct > 100) return vacio('La profundidad de descarga tiene que estar entre 1% y 100%.');
      if (effPct <= 0 || effPct > 100) return vacio('La eficiencia tiene que estar entre 1% y 100%.');

      const dod = dodPct / 100;
      const eff = effPct / 100;
      const whNominal = ah * volt;
      const whUtil = whNominal * dod * eff;
      const whPerdido = whNominal - whUtil;
      const horas = whUtil / w;
      const ahUtiles = ah * dod;
      const corrienteA = w / volt;
      const perdidoPct = whNominal > 0 ? (1 - whUtil / whNominal) * 100 : 0;

      const rows = [
        row('Autonomía estimada', horas, HORAS, true, 'Wh útiles ÷ W'),
        row('En minutos', horas * 60, MINUTOS, false, 'carga constante'),
        row('Energía nominal del banco', whNominal, WH, false, 'Ah × V'),
        row('Energía realmente utilizable', whUtil, WH, true, 'con DoD y eficiencia'),
        row('Energía que no vas a poder usar', whPerdido, WH, false, dec(perdidoPct, 0) + '% del total'),
        row('Ah que podés sacar sin dañarla', ahUtiles, AH, false, 'DoD ' + dec(dodPct, 0) + '%'),
        row('Corriente que le pedís al banco', corrienteA, AMP, false, 'W ÷ V'),
        row('Profundidad de descarga aplicada', dodPct, PORC, false, 'según química'),
        row('Eficiencia de descarga aplicada', effPct, PORC, false, 'inversor y cables'),
      ];

      return {
        total: txtDur(horas),
        sub:
          'De los ' + dec(whNominal, 0) + ' Wh nominales sólo ' + dec(whUtil, 0) +
          ' Wh son utilizables (DoD ' + dec(dodPct, 0) + '% y eficiencia ' + dec(effPct, 0) +
          '%: el ' + dec(perdidoPct, 0) + '% no lo vas a poder usar) · con ' + dec(w, 0) +
          ' W dan ' + dec(horas, 1) + ' h',
        rows: rows,
        chart: [
          { label: 'Energía utilizable', value: Number(whUtil.toFixed(1)), tone: 'main' },
          { label: 'Energía no aprovechable', value: Number(whPerdido.toFixed(1)), tone: 'warn' },
        ],
        format: 'unit',
        unit: 'Wh',
        decimals: 0,
      };
    }

    // ───────────────────────────── RAMA: UPS ─────────────────────────────
    // Dos caminos, como en las dos calcs originales:
    //  · con Ah y V conocidos → cálculo exacto (`ups-autonomia-potencia-carga.ts`)
    //  · sin Ah → estimación tipo Peukert calibrada contra tablas de APC/Eaton
    //    (`autonomia-ups-tiempo-respaldo-servidor.ts`)
    function calcUps(v) {
      const va = Number(v.vaUps) || 0;
      const w = Number(v.consumoW) || 0;
      const ah = Number(v.ahUps) || 0;
      const volt = Number(v.vBateria) || 0;
      const effPct = Number(v.eficiencia) || 0;

      if (va <= 0) return vacio('Ingresá la capacidad del UPS en VA.');
      if (w <= 0) return vacio('Ingresá la carga enchufada al UPS, en watts.');
      if (effPct <= 0 || effPct > 100) return vacio('La eficiencia tiene que estar entre 1% y 100%.');

      const eff = effPct / 100;
      const wMax = va * UPS_FP;
      const util = (w / wMax) * 100;

      let minutos, whUtil, metodo;
      if (ah > 0 && volt > 0) {
        whUtil = ah * volt * eff;
        minutos = (whUtil * 60) / w;
        metodo = 'batería conocida';
      } else {
        // Modelo calibrado: energía útil ≈ VA × 0,028 Wh, con premio a carga baja.
        whUtil = va * UPS_WH_POR_VA;
        const peukert = w < wMax ? Math.pow(wMax / w, UPS_PEUKERT_EXP) : 1;
        minutos = ((whUtil / w) * 60) * peukert;
        metodo = 'estimado desde los VA';
      }

      const sobrecarga = util > 100;
      const margenW = wMax - w;

      const rows = [
        row('Respaldo estimado', minutos, MINUTOS, true, metodo),
        row('En horas', minutos / 60, HORAS, false, 'sólo si la carga es baja'),
        row('Potencia útil real del UPS', wMax, WATT, true, 'VA × ' + dec(UPS_FP, 1) + ' (factor de potencia)'),
        row('Carga enchufada', w, WATT, false, 'la que declaraste'),
        row('Utilización del UPS', util, PORC, false, sobrecarga ? 'SOBRECARGADO' : util > 80 ? 'al límite' : 'con margen'),
        row('Margen de potencia que te queda', margenW, WATT, false, sobrecarga ? 'negativo' : 'podés sumar'),
        row('Energía útil de la batería', whUtil, WH, false, ah > 0 && volt > 0 ? 'Ah × V × eficiencia' : 'estimada'),
        row('Capacidad nominal declarada', va, { format: 'unit', unit: 'VA', decimals: 0 }, false, 'lo que dice la caja'),
      ];
      if (ah > 0 && volt > 0) {
        rows.push(row('Batería del UPS', ah, AH, false, dec(volt, 0) + ' V'));
      }

      return {
        total: dec(minutos, 0) + ' min',
        sub: sobrecarga
          ? 'Con ' + dec(w, 0) + ' W superás la potencia útil del UPS (' + dec(wMax, 0) +
            ' W): está sobrecargado al ' + dec(util, 0) + '% y puede cortar de golpe. Bajá la carga o pasá a un equipo más grande.'
          : 'Con ' + dec(w, 0) + ' W usás el ' + dec(util, 0) + '% de la capacidad útil (' + dec(wMax, 0) +
            ' W) y tenés unos ' + dec(minutos, 0) + ' min de respaldo · ' + metodo,
        rows: rows,
        chart: [
          { label: 'Carga enchufada', value: Number(w.toFixed(1)), tone: sobrecarga ? 'bad' : 'main' },
          { label: 'Margen libre', value: Number(Math.max(0, margenW).toFixed(1)), tone: 'good' },
        ],
        format: 'unit',
        unit: 'W',
        decimals: 0,
      };
    }

    // ────────────────────── RAMA: tiempo de carga ──────────────────────
    // Calcado de `carga-bateria-tiempo-amp.ts`.
    function calcCarga(v) {
      const ah = Number(v.ah) || 0;
      const act = Number(v.cargaActual);
      const ca = Number(v.cargadorA) || 0;
      const q = String(v.quimica || '1');

      if (ah <= 0) return vacio('Ingresá la capacidad de la batería en Ah.');
      if (ca <= 0) return vacio('Ingresá la corriente del cargador en amperios.');
      const actual = isFinite(act) ? Math.min(100, Math.max(0, act)) : 0;

      const f = FACTOR_CARGA[q] != null ? FACTOR_CARGA[q] : 1.15;
      const mc = MAX_C[q] != null ? MAX_C[q] : 0.5;
      const nombre = QUIMICA_LABEL[q] || 'batería';

      const ahNec = (ah * (100 - actual)) / 100;
      const horasIdeal = ahNec / ca;
      const horas = horasIdeal * f;
      const tasaC = ca / ah;
      const seguro = tasaC <= mc ? 'segura' : tasaC <= mc * 1.5 ? 'alta, revisá temperatura' : 'excesiva, bajá la corriente';
      const perdidaH = horas - horasIdeal;

      const rows = [
        row('Tiempo de carga estimado', horas, HORAS, true, nombre),
        row('En minutos', horas * 60, MINUTOS, false, 'de punta a punta'),
        row('Ah a reponer', ahNec, AH, true, 'del ' + dec(actual, 0) + '% al 100%'),
        row('Tiempo ideal sin pérdidas', horasIdeal, HORAS, false, 'Ah ÷ A'),
        row('Tiempo extra por ineficiencia de carga', perdidaH, HORAS, false, 'factor ' + dec(f, 2)),
        row('Tasa C del cargador', tasaC, TASA_C, false, seguro),
        row('Tasa C máxima segura de esta química', mc, TASA_C, false, nombre),
        row('Corriente del cargador', ca, AMP, false, 'declarada'),
        row('Corriente máxima recomendada', mc * ah, AMP, false, 'máx C × Ah'),
      ];

      return {
        total: txtDur(horas),
        sub:
          'Reponer ' + dec(ahNec, 1) + ' Ah con un cargador de ' + dec(ca, 1) + ' A tarda ' +
          dec(horas, 1) + ' h · tasa ' + dec(tasaC, 2) + 'C sobre un máximo de ' + dec(mc, 2) +
          'C para ' + nombre + ' (' + seguro + ') · ' + (QUIMICA_TIP[q] || ''),
        rows: rows,
        chart: [
          { label: 'Ah a reponer', value: Number(ahNec.toFixed(2)), tone: 'main' },
          { label: 'Ah que ya tenés', value: Number((ah - ahNec).toFixed(2)), tone: 'good' },
        ],
        format: 'unit',
        unit: 'Ah',
        decimals: 1,
      };
    }

    // ──────────────────────── RAMA: pack LiPo ────────────────────────
    // Calcado de `bateria-lipo-capacidad-descarga.ts`.
    function calcLipo(v) {
      const mah = Number(v.capacidadMah) || 0;
      const s = Math.round(Number(v.celdas) || 0);
      const c = Number(v.tasaC) || 0;
      const cons = Number(v.consumoA) || 0;
      const ds = Number(v.descargaSegura) || 0;

      if (mah <= 0) return vacio('Ingresá la capacidad del pack en mAh.');
      if (s <= 0) return vacio('Ingresá la cantidad de celdas (S) del pack.');
      if (c <= 0) return vacio('Ingresá la tasa C de descarga impresa en el pack.');
      if (cons <= 0) return vacio('Ingresá el consumo promedio en amperios.');
      if (ds <= 0 || ds > 100) return vacio('La descarga segura tiene que estar entre 1% y 100%.');

      const vNominal = s * V_CELDA_LITIO;
      const ah = mah / 1000;
      const corrMax = ah * c;
      const potMax = corrMax * vNominal;
      const energia = ah * vNominal;
      const energiaUtil = energia * (ds / 100);
      const minutos = ((ah * ds) / 100 / cons) * 60;
      const margenA = corrMax - cons;

      const rows = [
        row('Tiempo de vuelo estimado', minutos, MINUTOS, true, 'al ' + dec(ds, 0) + '% de descarga'),
        row('En horas', minutos / 60, HORAS, false, 'uso continuo'),
        row('Tensión nominal del pack', vNominal, VOLT, true, s + 'S × ' + dec(V_CELDA_LITIO, 1) + ' V'),
        row('Corriente máxima de pico', corrMax, AMP, true, dec(c, 0) + 'C sobre ' + dec(ah, 2) + ' Ah'),
        row('Potencia máxima instantánea', potMax, WATT, false, 'pico × tensión'),
        row('Margen sobre tu consumo promedio', margenA, AMP, false, margenA > 0 ? 'te sobra' : 'el pack no da'),
        row('Energía almacenada', energia, WH, false, 'Ah × V nominal'),
        row('Energía utilizable', energiaUtil, WH, false, 'hasta el ' + dec(ds, 0) + '%'),
        row('Capacidad utilizable', (mah * ds) / 100, MAH, false, 'el resto no se toca'),
      ];

      return {
        total: dec(minutos, 1) + ' min',
        sub:
          'Un pack de ' + dec(mah, 0) + ' mAh ' + s + 'S descargado hasta el ' + dec(ds, 0) +
          '% con ' + dec(cons, 1) + ' A promedio da ' + dec(minutos, 1) + ' min · entrega hasta ' +
          dec(corrMax, 0) + ' A de pico (' + dec(potMax, 0) + ' W) · guarda ' + dec(energia, 1) + ' Wh',
        rows: rows,
        chart: [
          { label: 'Energía utilizable', value: Number(energiaUtil.toFixed(2)), tone: 'main' },
          { label: 'Reserva que no se toca', value: Number((energia - energiaUtil).toFixed(2)), tone: 'warn' },
        ],
        format: 'unit',
        unit: 'Wh',
        decimals: 1,
      };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'dispositivo';
      if (id === 'banco') return calcBanco(v);
      if (id === 'ups') return calcUps(v);
      if (id === 'carga') return calcCarga(v);
      if (id === 'lipo') return calcLipo(v);
      return calcDispositivo(v);
    });
  })();
</script>
