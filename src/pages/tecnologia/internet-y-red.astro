---
/**
 * Hub de decisión — "¿Me alcanzan los megas? ¿Cuánto tarda esta descarga?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer
 * y el medio de conexión se elige en un select que cambia el techo de velocidad
 * y el overhead.
 * La página sólo aporta datos (src/lib/hubs/internet-y-red.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, MEDIOS, CABLES, DATOS, WIFI } from '../../lib/hubs/internet-y-red';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MED: MEDIOS, CAB: CABLES, D: DATOS, W: WIFI }}>
  (function () {
    const H = window.HC_HUB;

    // Nada de esto es plata. El runtime hace Object.assign: una fila sin
    // `format` propio se imprime en pesos.
    const MBPS = { format: 'unit', unit: 'Mbps', decimals: 1 };
    const MBS = { format: 'unit', unit: 'MB/s', decimals: 2 };
    const MB = { format: 'unit', unit: 'MB', decimals: 0 };
    const GB = { format: 'unit', unit: 'GB', decimals: 1 };
    const MIN = { format: 'unit', unit: 'min', decimals: 1 };
    const SEG = { format: 'unit', unit: 's', decimals: 0 };
    const HS = { format: 'unit', unit: 'h', decimals: 2 };
    const MTS = { format: 'unit', unit: 'm', decimals: 0 };
    const MHZ = { format: 'unit', unit: 'MHz', decimals: 0 };
    const PCT = { format: 'unit', unit: '%', decimals: 1 };
    const NUM = { format: 'plain', decimals: 0 };

    function coma(n, d) {
      return n.toFixed(d).replace('.', ',');
    }

    /** Tiempo legible a partir de segundos. */
    function tiempoTxt(seg) {
      if (seg < 60) return coma(seg, 1) + ' s';
      if (seg < 3600) return coma(seg / 60, 1) + ' min';
      const h = Math.floor(seg / 3600);
      const m = Math.round((seg - h * 3600) / 60);
      return h + ' h ' + m + ' min';
    }

    H.onCompute(function (v) {
      const medio = MED[String(v.medio || 'fibra')] || MED.fibra;
      const cable = CAB[String(v.catCable || 'cat5e')] || CAB.cat5e;
      const contratada = Math.max(0, v.velocidadContratada || 0);
      const real = Math.max(0, v.velocidadReal || 0);
      const tamanoGb = Math.max(0, v.tamano || 0);
      const metros = Math.max(0, v.metrosCable || 0);
      const abono = Math.max(0, v.abono || 0);

      if (!real || !tamanoGb) {
        return {
          total: '0 min',
          sub: 'Ingresá la velocidad que medís y el tamaño de la descarga.',
          rows: [],
          chart: [],
          format: 'unit',
          unit: 'min',
        };
      }

      // ── Velocidad real vs contratada (velocidad-internet-mbps-real) ──
      const pct = contratada > 0 ? (real / contratada) * 100 : 0;
      const diferencia = contratada - real;
      const costoPorMbps = real > 0 ? abono / real : 0;
      let estado;
      if (pct >= 90) estado = 'Excelente: tu ISP cumple perfectamente';
      else if (pct >= 80) estado = 'Aceptable: está dentro de lo esperable';
      else if (pct >= 70) estado = 'Bajo: podés reclamar a tu ISP';
      else estado = 'Inaceptable: reclamá al ISP y, si no responde, al ENACOM';

      // ── Techo del medio y velocidad efectiva ──
      // El enlace nunca da más que su techo, y el overhead se descuenta antes
      // de pasar de bits a bytes (igual que en las fórmulas originales).
      const enlace = medio.cap > 0 ? Math.min(real, medio.cap) : real;
      const efectivaMbps = enlace * (medio.ef / 100);
      const mbs = efectivaMbps / 8;

      // ── Tiempo de descarga (ancho-banda / transferencia LAN) ──
      const tamanoMb = tamanoGb * D.MB_POR_GB;
      const segundos = mbs > 0 ? tamanoMb / mbs : 0;
      const minutos = segundos / 60;
      const horas = minutos / 60;
      const segPorGb = mbs > 0 ? D.MB_POR_GB / mbs : 0;

      const rows = [];

      rows.push(Object.assign({ k: 'Velocidad contratada', v: contratada }, MBPS));
      rows.push(Object.assign({ k: 'Velocidad real medida', v: real, extra: true }, MBPS));
      rows.push(Object.assign({ k: 'Cumplimiento del ISP', ref: estado, v: pct }, PCT));
      rows.push(Object.assign({ k: 'Mbps que no te llegan', v: Math.max(0, diferencia) }, MBPS));
      if (medio.cap > 0) {
        rows.push(Object.assign({ k: 'Techo de ' + medio.nombre, v: medio.cap }, MBPS, { decimals: 0 }));
      }
      rows.push(Object.assign({ k: 'Eficiencia del medio (overhead)', v: medio.ef }, PCT, { decimals: 0 }));
      rows.push(Object.assign({ k: 'Velocidad efectiva', v: efectivaMbps, extra: true }, MBPS));
      rows.push(Object.assign({ k: 'Lo mismo en megabytes por segundo', ref: '÷ 8 bits', v: mbs, extra: true }, MBS));

      rows.push(Object.assign({ k: 'Tamaño de la descarga', ref: '1 GB = 1024 MB', v: tamanoMb }, MB));
      rows.push(Object.assign({ k: 'Tiempo de descarga', v: minutos, extra: true }, MIN));
      rows.push(Object.assign({ k: 'Lo mismo en segundos', v: segundos }, SEG));
      if (horas >= 1) rows.push(Object.assign({ k: 'Lo mismo en horas', v: horas }, HS));
      rows.push(Object.assign({ k: 'Cuánto tarda 1 GB por este medio', v: segPorGb / 60 }, MIN, { decimals: 2 }));

      // ── Comparación contra el cable, para ver qué se pierde por el aire ──
      const efCable = MED.gigabit.ef / 100;
      const enlaceCable = Math.min(real, MED.gigabit.cap);
      const mbsCable = (enlaceCable * efCable) / 8;
      const segCable = mbsCable > 0 ? tamanoMb / mbsCable : 0;
      if (medio.banda) {
        rows.push(Object.assign({ k: 'Lo mismo con cable Gigabit', v: segCable / 60 }, MIN));
        rows.push(Object.assign({ k: 'Minutos que ganás enchufando el cable', v: Math.max(0, (segundos - segCable) / 60) }, MIN));
      }

      // ── Cable ethernet: qué categoría y hasta dónde llega ──
      const alcanza = metros <= cable.metros;
      const refCable = alcanza
        ? cable.nombre + ': ' + cable.nota
        : cable.nombre + ': ' + metros + ' m superan el tramo máximo, meté un switch en el medio';
      rows.push(Object.assign({ k: 'Velocidad máxima del ' + cable.nombre, ref: refCable, v: cable.max }, MBPS, { decimals: 0 }));
      rows.push(Object.assign({ k: 'Tramo máximo del ' + cable.nombre, v: cable.metros }, MTS));
      rows.push(Object.assign({ k: 'Margen de cable que te queda', v: cable.metros - metros }, MTS));
      if (cable.maxCorto) {
        rows.push(Object.assign({ k: cable.nombre + ' a 10 Gbps: sólo hasta', v: cable.metrosCorto }, MTS));
      }
      rows.push(Object.assign({ k: 'Frecuencia del ' + cable.nombre, v: cable.mhz }, MHZ));

      // ── Wifi: canal y ancho recomendados para la banda del medio ──
      if (medio.banda) {
        const w = W[medio.banda];
        rows.push(Object.assign({ k: 'Canal sugerido (de ' + w.canales + ')', ref: w.consejo, v: w.sugerido }, NUM));
        rows.push(Object.assign({ k: 'Ancho de canal recomendado', v: w.ancho }, MHZ));
      }

      // ── Datos móviles por streaming ──
      const gbHd = Math.max(0, v.horasVideoHd || 0) * D.VIDEO_HD;
      const gbSd = Math.max(0, v.horasVideoSd || 0) * D.VIDEO_SD;
      const gbMus = Math.max(0, v.horasMusica || 0) * D.MUSICA;
      const gbVc = Math.max(0, v.horasVideollamadas || 0) * D.VIDEOLLAMADAS;
      const gbRedes = Math.max(0, v.horasRedesSociales || 0) * D.REDES;
      const gbDia = gbHd + gbSd + gbMus + gbVc + gbRedes + D.BASE;
      const gbMes = gbDia * 30;
      const consumos = [
        ['Video HD', gbHd],
        ['Video SD', gbSd],
        ['Música', gbMus],
        ['Videollamadas', gbVc],
        ['Redes sociales', gbRedes],
      ].sort(function (a, b) {
        return b[1] - a[1];
      });
      const plan =
        gbMes <= 5 ? 'un plan de 5 GB' : gbMes <= 10 ? 'un plan de 8-10 GB' : gbMes <= 20 ? 'un plan de 15-20 GB' : 'un plan ilimitado o de 30+ GB';

      rows.push(Object.assign({ k: 'Datos móviles por día', v: gbDia }, GB, { decimals: 2 }));
      rows.push(Object.assign({ k: 'Datos móviles por mes', ref: 'te conviene ' + plan, v: gbMes, extra: true }, GB));
      rows.push(Object.assign({ k: 'Lo que más consume: ' + consumos[0][0], v: consumos[0][1] * 30 }, GB));
      rows.push(Object.assign({ k: 'Esta descarga sobre tu consumo del mes', v: gbMes > 0 ? (tamanoGb / gbMes) * 100 : 0 }, PCT, { decimals: 0 }));

      // ── Las dos únicas filas en pesos ──
      rows.push({ k: 'Abono mensual', v: abono });
      rows.push({ k: 'Costo de cada Mbps que realmente recibís', ref: 'abono ÷ velocidad medida', v: costoPorMbps, decimals: 2 });

      const posPct = Math.min(110, Math.max(0, pct));

      return {
        total: tiempoTxt(segundos),
        sub:
          medio.nombre +
          ' · ' +
          coma(efectivaMbps, 1) +
          ' Mbps efectivos (' +
          coma(mbs, 2) +
          ' MB/s) · ' +
          coma(pct, 1) +
          '% de lo contratado · ' +
          medio.tip,
        rows: rows,
        format: 'unit',
        unit: 'min',
        decimals: 1,
        position: (posPct / 110) * 100,
        positionLabel: coma(pct, 1) + '% de lo contratado — ' + estado,
        chart: [
          { label: 'Inaceptable (menos del 70%)', value: 70, from: 0, to: 70, tone: 'bad' },
          { label: 'Bajo (70-80%)', value: 10, from: 70, to: 80, tone: 'warn' },
          { label: 'Aceptable (80-90%)', value: 10, from: 80, to: 90, tone: 'prop' },
          { label: 'Excelente (90% o más)', value: 20, from: 90, to: 110, tone: 'good' },
        ],
      };
    });
  })();
</script>
