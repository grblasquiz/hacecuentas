---
/**
 * Hub de decisión — "Fotos y video: cuánto ocupan y a qué resolución"
 * Reemplaza 16 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: compute() recibe el id del caso activo como 2º
 * argumento y cambia qué responde, no qué campos lee.
 *
 * La página sólo aporta datos (src/lib/hubs/fotografia.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 *
 * CRITERIO DE MÚLTIPLOS: base decimal en todo el hub, 1 GB = 1000 MB (la vara
 * del fabricante de la tarjeta y la del bitrate). El valor binario que reporta
 * el sistema operativo se calcula aparte y viaja en su propia fila, rotulado
 * "GiB". No se mezclan nunca.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FotografiaExperience from '../../components/generated/FotografiaExperience.astro';
import { hub, PARAMS, MB_POR_MP, ASPECTOS } from '../../lib/hubs/fotografia';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <FotografiaExperience data={hub} />
  <Footer />
</Layout>

