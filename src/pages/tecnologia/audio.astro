---
/**
 * Hub de decisión — "Audio: BPM, tempo, afinación y decibeles".
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/audio.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 *
 * OJO: este hub NO es de plata. El default de `format` del runtime es 'ars', así
 * que todas las filas y todos los resultados llevan `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AudioExperience from '../../components/generated/AudioExperience.astro';
import { hub, AUDIO } from '../../lib/hubs/audio';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <AudioExperience data={hub} />
  <Footer />
</Layout>

