---
/**
 * Hub de decisión — "¿Cuánto me cuesta la API de IA?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * Los precios y multiplicadores viven en src/lib/hubs/costo-ia.ts. Acá sólo
 * va el compute(). Todo el hub es plata en dólares: el resultado y todas las
 * filas declaran format 'unit' con unit 'USD' para que el runtime no les
 * ponga el signo de peso.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, PRECIOS, CACHE_WRITE, CACHE_READ, SERVIDOR } from '../../lib/hubs/costo-ia';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const MATH = { PRECIOS, CACHE_WRITE, CACHE_READ, SERVIDOR };

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ M: MATH }}>
  (function () {
    const H = window.HC_HUB;

    /** Todo este hub es dólares: nunca el "$" de peso del runtime. */
    function usd(n) {
      const v = Number(n) || 0;
      const dec = Math.abs(v) < 100 ? 2 : 0;
      return 'US$ ' + v.toLocaleString('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec });
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'api';
      const rows = [];
      let chart = [];
      let total = 0;
      let sub = '';

      if (id === 'api') {
        const modelo = M.PRECIOS[v.modelo] || M.PRECIOS['sonnet-5'];
        // Los campos de precio pisan la tabla; en 0 se usa el del modelo.
        const pIn = Number(v.precioIn) > 0 ? Number(v.precioIn) : modelo.in;
        const pOut = Number(v.precioOut) > 0 ? Number(v.precioOut) : modelo.out;

        const mIn = Math.max(0, Number(v.tokensIn) || 0);
        const mOut = Math.max(0, Number(v.tokensOut) || 0);
        const fijoPct = Math.min(100, Math.max(0, Number(v.promptFijo) || 0)) / 100;
        const hit = Math.min(100, Math.max(0, Number(v.cacheHit) || 0)) / 100;

        // La parte fija del input es la única cacheable. Sobre ella:
        // los misses se escriben a 1,25× y los hits se leen a 0,10×.
        const base = mIn * fijoPct;
        const variable = mIn - base;
        const costoWrite = base * (1 - hit) * M.CACHE_WRITE * pIn;
        const costoRead = base * hit * M.CACHE_READ * pIn;
        const costoVar = variable * pIn;
        const costoOut = mOut * pOut;

        total = costoWrite + costoRead + costoVar + costoOut;
        const sinCache = mIn * pIn + costoOut;
        const ahorro = sinCache - total;

        rows.push({ k: 'Entrada sin cachear', ref: usd(pIn) + '/M', v: costoVar, format: 'unit', unit: 'USD', decimals: 2 });
        if (base > 0) {
          rows.push({ k: 'Escritura de caché', ref: '1,25× entrada', v: costoWrite, format: 'unit', unit: 'USD', decimals: 2 });
          rows.push({ k: 'Lectura de caché', ref: '0,10× entrada', v: costoRead, format: 'unit', unit: 'USD', decimals: 2 });
        }
        rows.push({ k: 'Salida', ref: usd(pOut) + '/M', v: costoOut, format: 'unit', unit: 'USD', decimals: 2 });

        const llamadasMes = Math.max(0, Number(v.llamadasDia) || 0) * 30;
        if (llamadasMes > 0) {
          rows.push({ k: 'Costo por llamada', ref: Math.round(llamadasMes).toLocaleString('es-AR') + ' al mes', v: total / llamadasMes, format: 'unit', unit: 'USD', decimals: 4 });
        }
        rows.push({ k: 'Proyección anual', ref: '× 12', v: total * 12, format: 'unit', unit: 'USD', decimals: 0, extra: true });
        if (ahorro > 0.005) {
          rows.push({ k: 'Ahorro del prompt caching', ref: 'vs. sin caché', v: ahorro, format: 'unit', unit: 'USD', decimals: 2, extra: true });
        }

        chart = [
          { label: 'Entrada', value: costoVar + costoWrite + costoRead, tone: 'main' },
          { label: 'Salida', value: costoOut, tone: 'warn' },
        ];

        const pctOut = total > 0 ? Math.round((costoOut / total) * 100) : 0;
        sub =
          modelo.nombre + ' · ' + usd(pIn) + ' entrada y ' + usd(pOut) + ' salida por millón · la salida explica el ' +
          pctOut + '% del gasto' +
          (ahorro > 0.005 ? ' · caché: ' + usd(ahorro) + ' menos por mes' : '');
      } else if (id === 'gpu') {
        const precio = Math.max(0, Number(v.precioGpu) || 0);
        const gpus = Math.max(1, Number(v.cantidadGpus) || 1);
        const horas = Math.max(0, Number(v.horasMes) || 0);
        const desc = Math.min(90, Math.max(0, Number(v.spot) || 0)) / 100;
        const idle = Math.min(horas, Math.max(0, Number(v.horasIdle) || 0));

        const onDemandHora = precio * gpus;
        const efectivoHora = onDemandHora * (1 - desc);
        total = efectivoHora * horas;
        const ahorroSpot = (onDemandHora - efectivoHora) * horas;
        const costoIdle = efectivoHora * idle;
        const costoUtil = total - costoIdle;

        rows.push({ k: 'Horas con carga real', ref: (horas - idle).toFixed(0) + ' h', v: costoUtil, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Horas ociosas que igual pagás', ref: idle.toFixed(0) + ' h', v: costoIdle, format: 'unit', unit: 'USD', decimals: 2, extra: costoIdle > 0 });
        rows.push({ k: 'Costo efectivo por hora', ref: gpus + '× GPU', v: efectivoHora, format: 'unit', unit: 'USD', decimals: 3 });
        if (ahorroSpot > 0) {
          rows.push({ k: 'Ahorro por descuento spot', ref: (desc * 100).toFixed(0) + '%', v: ahorroSpot, format: 'unit', unit: 'USD', decimals: 2 });
        }
        rows.push({ k: 'Proyección anual', ref: '× 12', v: total * 12, format: 'unit', unit: 'USD', decimals: 0, extra: true });

        chart = [
          { label: 'Cómputo con carga', value: costoUtil, tone: 'main' },
          { label: 'Tiempo ocioso', value: costoIdle, tone: 'bad' },
        ];

        const pctIdle = total > 0 ? Math.round((costoIdle / total) * 100) : 0;
        sub =
          gpus + '× GPU a ' + usd(efectivoHora) + ' por hora efectiva durante ' + horas + ' h' +
          (costoIdle > 0 ? ' · el ' + pctIdle + '% se va en tarjetas encendidas sin usar' : '');
      } else if (id === 'servidor') {
        const vcpus = Math.max(0, Number(v.vcpus) || 0);
        const ram = Math.max(0, Number(v.ramGb) || 0);
        const disco = Math.max(0, Number(v.storageGb) || 0);
        const trafico = Math.max(0, Number(v.traficoGb) || 0);

        const costoCpu = vcpus * M.SERVIDOR.cpuMes;
        const costoRam = ram * M.SERVIDOR.ramMes;
        const costoDisco = disco * M.SERVIDOR.storageMes;
        const costoTrafico = trafico * M.SERVIDOR.traficoGb;
        total = costoCpu + costoRam + costoDisco + costoTrafico;

        rows.push({ k: 'vCPU', ref: usd(M.SERVIDOR.cpuMes) + ' c/u', v: costoCpu, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'RAM', ref: usd(M.SERVIDOR.ramMes) + '/GB', v: costoRam, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Disco SSD', ref: usd(M.SERVIDOR.storageMes) + '/GB', v: costoDisco, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Tráfico de salida', ref: usd(M.SERVIDOR.traficoGb) + '/GB', v: costoTrafico, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Proyección anual', ref: '× 12', v: total * 12, format: 'unit', unit: 'USD', decimals: 0, extra: true });
        rows.push({ k: 'Si reservás la instancia (−40%)', ref: 'referencia', v: total * 0.6, format: 'unit', unit: 'USD', decimals: 2, extra: true });

        const compute = costoCpu + costoRam;
        chart = [
          { label: 'Cómputo (vCPU y RAM)', value: compute, tone: 'main' },
          { label: 'Almacenamiento', value: costoDisco, tone: 'good' },
          { label: 'Tráfico de salida', value: costoTrafico, tone: 'warn' },
        ];

        const pctCompute = total > 0 ? Math.round((compute / total) * 100) : 0;
        sub = vcpus + ' vCPU · ' + ram + ' GB RAM · ' + disco + ' GB SSD · el cómputo se lleva el ' + pctCompute + '% de la factura';
      } else {
        // throughput: ¿cuánto me sale el millón de tokens propio?
        const tps = Math.max(0, Number(v.tokensSegundo) || 0);
        const batch = Math.max(1, Number(v.batch) || 1);
        const precio = Math.max(0, Number(v.precioGpu) || 0);
        const gpus = Math.max(1, Number(v.cantidadGpus) || 1);
        const horas = Math.max(0, Number(v.horasMes) || 0);

        const tpsTotal = tps * batch;
        const tokensHora = tpsTotal * 3600;
        const costoHora = precio * gpus;
        const porMillon = tokensHora > 0 ? (costoHora / tokensHora) * 1e6 : 0;
        total = costoHora * horas;
        const millonesMes = (tokensHora * horas) / 1e6;

        const modelo = M.PRECIOS[v.modelo] || M.PRECIOS['sonnet-5'];
        const pIn = Number(v.precioIn) > 0 ? Number(v.precioIn) : modelo.in;

        rows.push({ k: 'Tu costo por millón de tokens', ref: Math.round(tpsTotal).toLocaleString('es-AR') + ' tok/s', v: porMillon, format: 'unit', unit: 'USD', decimals: 3 });
        rows.push({ k: 'Precio de entrada de la API para comparar', ref: modelo.nombre, v: pIn, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Costo de GPU por hora', ref: gpus + '× GPU', v: costoHora, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Gasto mensual de GPU', ref: horas + ' h', v: total, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Millones de tokens que servís al mes', ref: 'a full', v: millonesMes, format: 'unit', unit: 'M tokens', decimals: 1, extra: true });

        chart = [
          { label: 'Tu costo por millón', value: porMillon, tone: porMillon < pIn ? 'good' : 'bad' },
          { label: 'Precio de la API', value: pIn, tone: 'main' },
        ];

        sub =
          'Servís ' + Math.round(tpsTotal).toLocaleString('es-AR') + ' tokens por segundo · el millón propio te sale ' +
          usd(porMillon) + ' contra ' + usd(pIn) + ' de la API · ' +
          (porMillon < pIn ? 'autohospedar cierra a este volumen' : 'a este volumen no cierra');
      }

      return {
        total: usd(total),
        sub: sub,
        rows: rows,
        format: 'unit',
        unit: 'USD',
        decimals: 2,
        chart: chart,
      };
    });
  })();
</script>
