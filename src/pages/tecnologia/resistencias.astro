---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResistenciasExperience from '../../components/generated/ResistenciasExperience.astro';
import { hub } from '../../lib/hubs/resistencias';
const canonical='https://hacecuentas.com/tecnologia/resistencias';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <ResistenciasExperience />
  <Footer />
</Layout>
