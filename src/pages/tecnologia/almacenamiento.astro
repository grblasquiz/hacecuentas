---
/**
 * Hub de decisión — "¿Cuántos GB son y cuánto espacio me queda de verdad?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer
 * y la unidad + la base se eligen en dos selects.
 * La página sólo aporta datos (src/lib/hubs/almacenamiento.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, FACTORES, NOMBRES, RAID } from '../../lib/hubs/almacenamiento';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ F: FACTORES, NOM: NOMBRES, RAID_LV: RAID }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay plata: todas las filas declaran format. El runtime hace
    // Object.assign y una fila sin `format` propio se imprimiría en pesos.
    const NUM = { format: 'plain', decimals: 0 };
    const U = (u, d) => ({ format: 'unit', unit: u, decimals: d === undefined ? 2 : d });

    const GIB = 1073741824;
    const TIB = 1099511627776;

    function esFmt(n, d) {
      return Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });
    }

    H.onCompute(function (v) {
      const valor = Math.max(0, v.valor || 0);
      const unidad = String(v.unidadOrigen || 'tb');
      const base = String(v.base || 'decimal') === 'binaria' ? 'binaria' : 'decimal';
      const tabla = F[base] || F.decimal;
      const factor = tabla[unidad] !== undefined ? tabla[unidad] : tabla.tb;

      const n = Math.floor(Math.max(0, v.discos || 0));
      const tam = Math.max(0, v.tamanoDisco || 0);
      const nivelId = String(v.nivel || '5');
      const lv = RAID_LV[nivelId] || RAID_LV['5'];

      if (!valor) {
        return { total: '0 GB', sub: 'Ingresá una cantidad para convertirla.', rows: [], chart: [] };
      }

      // ── Conversión ──────────────────────────────────────────────────────
      const bytes = valor * factor;
      const bits = bytes * 8;

      const kb = bytes / 1e3;
      const mb = bytes / 1e6;
      const gb = bytes / 1e9;
      const tb = bytes / 1e12;

      const kib = bytes / 1024;
      const mib = bytes / 1048576;
      const gib = bytes / GIB;
      const tib = bytes / TIB;

      // Brecha a nivel GB: 1 - 1e9/2^30 = 6,87%. Es la del insight del calc viejo.
      const brecha = gb > 0 ? (1 - gib / gb) * 100 : 0;

      const rows = [];
      rows.push(Object.assign({ k: 'Bits', ref: '1 byte = 8 bits', v: bits }, NUM));
      rows.push(Object.assign({ k: 'Bytes', v: bytes, extra: true }, NUM));
      rows.push(Object.assign({ k: 'Kilobytes (decimal, 1.000 B)', v: kb }, U('KB', 2)));
      rows.push(Object.assign({ k: 'Megabytes (decimal, 1.000 KB)', v: mb }, U('MB', 3)));
      rows.push(Object.assign({ k: 'Gigabytes (decimal, 1.000 MB)', v: gb, extra: true }, U('GB', 4)));
      rows.push(Object.assign({ k: 'Terabytes (decimal, 1.000 GB)', v: tb }, U('TB', 6)));
      rows.push(Object.assign({ k: 'Kibibytes (binario, 1.024 B)', v: kib }, U('KiB', 2)));
      rows.push(Object.assign({ k: 'Mebibytes (binario, 1.024 KiB)', v: mib }, U('MiB', 3)));
      rows.push(Object.assign({ k: 'Gibibytes — lo que muestra Windows', v: gib, extra: true }, U('GiB', 4)));
      rows.push(Object.assign({ k: 'Tebibytes (binario, 1.024 GiB)', v: tib }, U('TiB', 6)));
      rows.push(Object.assign({ k: 'Brecha entre GB decimal y GiB binario', v: brecha }, U('%', 2)));

      // ── RAID ────────────────────────────────────────────────────────────
      let raidOk = true;
      let raidMsg = '';
      if (n < lv.min) {
        raidOk = false;
        raidMsg = lv.nombre + ' necesita como mínimo ' + lv.min + ' discos.';
      } else if (lv.par && n % 2 !== 0) {
        raidOk = false;
        raidMsg = lv.nombre + ' necesita una cantidad par de discos.';
      } else if (!tam) {
        raidOk = false;
        raidMsg = 'Ingresá el tamaño de cada disco en TB.';
      }

      const chart = [];
      let subRaid = raidMsg;

      if (raidOk) {
        const total = n * tam;
        const discosUtiles = n * lv.factorN + lv.offset;
        const util = discosUtiles * tam;
        const perdido = total - util;
        const eficiencia = total > 0 ? (util / total) * 100 : 0;
        const tolerancia = lv.tolTodosMenosUno ? n - 1 : lv.tol;

        // Lo que el sistema operativo va a mostrar: los mismos bytes leídos en
        // base binaria (TiB), y la brecha de conteo entre ambas varas.
        const utilTiB = (util * 1e12) / TIB;
        const brechaTB = util - utilTiB;
        const copias = bytes > 0 ? Math.floor((util * 1e12) / bytes) : 0;

        rows.push(Object.assign({ k: 'Capacidad bruta del arreglo', ref: n + ' × ' + esFmt(tam, 1) + ' TB', v: total }, U('TB', 2)));
        rows.push(Object.assign({ k: 'Espacio útil en ' + lv.nombre, v: util, extra: true }, U('TB', 2)));
        rows.push(Object.assign({ k: 'Espacio en redundancia (paridad o espejo)', v: perdido }, U('TB', 2)));
        rows.push(Object.assign({ k: 'Aprovechamiento del arreglo', v: eficiencia }, U('%', 0)));
        rows.push(Object.assign({ k: 'Discos que pueden fallar sin perder datos', v: tolerancia }, U('discos', 0)));
        rows.push(Object.assign({ k: 'Espacio útil como lo va a mostrar el sistema', v: utilTiB, extra: true }, U('TiB', 2)));
        rows.push(Object.assign({ k: 'Copias de esa cantidad que entran en el arreglo', v: copias }, NUM));

        chart.push({ label: 'Útil, como lo ve el sistema', value: utilTiB, tone: 'good' });
        chart.push({ label: 'Brecha decimal vs binaria', value: brechaTB, tone: 'warn' });
        chart.push({ label: 'Redundancia', value: perdido, tone: 'prop' });

        subRaid =
          lv.nombre + ' con ' + n + ' discos: ' + esFmt(util, 1) + ' TB útiles de ' + esFmt(total, 1) +
          ' TB brutos (' + esFmt(eficiencia, 0) + '%), tolera ' + tolerancia + ' disco' +
          (tolerancia === 1 ? '' : 's') + ' — ' + lv.nota;
      }

      const nom = NOM[unidad] || NOM.tb;
      const etiqueta = base === 'binaria' ? nom.iec : nom.si;

      return {
        total: esFmt(gb, gb >= 100 ? 1 : 3) + ' GB',
        sub:
          esFmt(valor, valor % 1 === 0 ? 0 : 3) + ' ' + etiqueta + ' = ' + esFmt(gb, 3) + ' GB decimales = ' +
          esFmt(gib, 3) + ' GiB binarios (' + esFmt(brecha, 1) + '% menos en pantalla) · ' + subRaid,
        rows: rows,
        chart: chart.filter(function (s) { return s.value > 0; }),
        format: 'unit',
        unit: 'GB',
        decimals: 2,
      };
    });
  })();
</script>
