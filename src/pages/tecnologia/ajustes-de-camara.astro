---
/**
 * Hub de decisión — "¿Con qué ajustes disparo?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/ajustes-de-camara.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * ACÁ NO HAY PLATA: cada fila declara su `format` ('unit' con su unidad o
 * 'plain'). Una fila sin format propio saldría en pesos.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AjustesCamaraExperience from '../../components/generated/AjustesCamaraExperience.astro';
import { hub, APERTURAS, DENSIDAD_POR_PASO } from '../../lib/hubs/ajustes-de-camara';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <AjustesCamaraExperience data={hub} />
  <Footer />
</Layout>

