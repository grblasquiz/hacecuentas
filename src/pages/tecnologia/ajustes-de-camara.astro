---
/**
 * Hub de decisión — "¿Con qué ajustes disparo?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/ajustes-de-camara.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * ACÁ NO HAY PLATA: cada fila declara su `format` ('unit' con su unidad o
 * 'plain'). Una fila sin format propio saldría en pesos.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, APERTURAS, DENSIDAD_POR_PASO } from '../../lib/hubs/ajustes-de-camara';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ APERTURAS, DENSIDAD_POR_PASO }}>
  (function () {
    const H = window.HC_HUB;

    function nnum(x, def) {
      const n = Number(String(x == null ? '' : x).replace(/\./g, '').replace(',', '.'));
      return isFinite(n) && n > 0 ? n : def;
    }
    /** Los selects de f/ y crop llegan con punto decimal: no les toques los puntos. */
    function fnum(x, def) {
      const n = Number(x);
      return isFinite(n) && n > 0 ? n : def;
    }
    function r(n, d) {
      const p = Math.pow(10, d || 0);
      return Math.round(n * p) / p;
    }
    /** Segundos → texto legible ("1/125 s", "8,0 s", "2,5 min"). */
    function tiempo(seg) {
      if (seg < 1) return '1/' + Math.round(1 / seg) + ' s';
      if (seg < 60) return r(seg, 1).toLocaleString('es-AR') + ' s';
      return r(seg / 60, 1).toLocaleString('es-AR') + ' min';
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'exposicion';
      const iso = nnum(v.iso, 100);
      const N = fnum(v.apertura, 5.6);
      const d = nnum(v.velocidad, 125); // denominador: 1/d segundos
      const t = 1 / d;

      // ───────────────────────────────── Exposición (triángulo)
      if (id === 'exposicion') {
        // EV de la combinación de diafragma y obturador, y EV100 de la escena.
        const ev = Math.log2((N * N) / t);
        const ev100 = ev - Math.log2(iso / 100);
        // Regla del sol f/16 = EV 15 a ISO 100: cuántos pasos me separan.
        const vsSol = ev100 - 15;

        const rows = [
          { k: 'EV de tu combinación (f/ y velocidad)', ref: 'EV = log2(N²/t)', v: r(ev, 2), format: 'unit', unit: 'EV', decimals: 2, extra: true },
          { k: 'Luz de la escena en EV100', ref: 'corregido por ISO', v: r(ev100, 2), format: 'unit', unit: 'EV', decimals: 2 },
          { k: 'Distancia a la regla del sol f/16 (EV 15)', v: r(vsSol, 2), format: 'unit', unit: 'pasos', decimals: 2 },
          { k: 'Pasos que te da el ISO sobre 100', v: r(Math.log2(iso / 100), 2), format: 'unit', unit: 'pasos', decimals: 2 },
        ];
        // La escalera de combinaciones equivalentes: misma foto, otro diafragma.
        APERTURAS.forEach(function (a) {
          const tEq = (a * a) / Math.pow(2, ev); // t = N² / 2^EV
          rows.push({
            k: 'Con f/' + a + ' → ' + tiempo(tEq),
            ref: tEq < 1 ? 'a mano alzada' : 'con trípode',
            v: r(tEq < 1 ? 1 / tEq : tEq, tEq < 1 ? 0 : 1),
            format: 'unit',
            unit: tEq < 1 ? 'de segundo' : 'segundos',
            decimals: tEq < 1 ? 0 : 1,
          });
        });

        // Escala de luz ambiente en EV100, de noche cerrada a playa al mediodía.
        const bands = [
          { label: 'EV −2 a 3 — noche, luna, ciudad de noche', from: -2, to: 3, tone: 'bad' },
          { label: 'EV 3 a 7 — interior de noche, luz artificial', from: 3, to: 7, tone: 'warn' },
          { label: 'EV 7 a 11 — interior de día, sombra profunda', from: 7, to: 11, tone: 'good' },
          { label: 'EV 11 a 14 — nublado, sombra abierta', from: 11, to: 14, tone: 'good' },
          { label: 'EV 14 a 17 — sol pleno, nieve o playa', from: 14, to: 17, tone: 'warn' },
        ];
        const pos = Math.max(0, Math.min(100, ((ev100 + 2) / 19) * 100));

        return {
          total: 'EV ' + r(ev, 1).toLocaleString('es-AR'),
          sub:
            'ISO ' + iso + ' · f/' + N + ' · ' + tiempo(t) +
            ' · la escena mide EV100 ' + r(ev100, 1).toLocaleString('es-AR') +
            (Math.abs(vsSol) < 0.5
              ? ' — es casi exactamente la regla del sol f/16'
              : vsSol > 0
                ? ' — ' + r(vsSol, 1).toLocaleString('es-AR') + ' pasos más luminosa que el sol f/16'
                : ' — ' + r(-vsSol, 1).toLocaleString('es-AR') + ' pasos más oscura que el sol f/16'),
          rows: rows,
          chart: bands.map(function (b) { return { label: b.label, value: b.to - b.from, tone: b.tone, from: b.from, to: b.to }; }),
          format: 'unit',
          unit: 'EV',
          decimals: 1,
          position: r(pos, 1),
          positionLabel: 'EV100 ' + r(ev100, 1).toLocaleString('es-AR'),
        };
      }

      // ───────────────────────────────── Filtro ND
      if (id === 'nd') {
        const pasos = Math.max(0.5, fnum(v.stops_nd, 10));
        const factor = Math.pow(2, pasos);
        const tCon = t * factor;
        // Densidad óptica EXACTA: pasos × log10(2), no × 0,3 como la calc vieja.
        const densidad = pasos * DENSIDAD_POR_PASO;

        const rows = [
          { k: 'Exposición con el filtro puesto', ref: 't × 2^pasos', v: r(tCon, 2), format: 'unit', unit: 'segundos', decimals: 2, extra: true },
          { k: 'Exposición sin filtro', v: d, format: 'unit', unit: 'de segundo', decimals: 0 },
          { k: 'Pasos que corta el filtro', v: pasos, format: 'unit', unit: 'pasos', decimals: 1 },
          { k: 'Factor de reducción de luz', ref: '2^pasos', v: r(factor, 0), format: 'unit', unit: '×', decimals: 0 },
          { k: 'Densidad óptica rotulada en el filtro', ref: 'pasos × log10(2)', v: r(densidad, 2), format: 'plain', decimals: 2 },
          { k: 'Luz que deja pasar', v: r(100 / factor, 4), format: 'unit', unit: '%', decimals: 4 },
        ];

        const bands = [
          { label: 'Menos de 1 s — a mano alzada todavía se puede', from: 0, to: 1, tone: 'good' },
          { label: '1 a 30 s — trípode obligatorio', from: 1, to: 30, tone: 'warn' },
          { label: '30 s a 5 min — modo Bulb con disparador', from: 30, to: 300, tone: 'bad' },
        ];
        const pos = Math.max(0, Math.min(100, (Math.log10(Math.max(tCon, 0.001) * 1000) / Math.log10(300000)) * 100));

        return {
          total: tiempo(tCon),
          sub:
            'ND de ' + pasos + ' pasos (factor ' + r(factor, 0) + '×, densidad ' + r(densidad, 2).toLocaleString('es-AR') + ') · ' +
            'de ' + tiempo(t) + ' pasás a ' + tiempo(tCon) + ' · ' +
            (tCon > 30
              ? 'la cámara sola llega hasta 30 s: necesitás modo Bulb y disparador o intervalómetro'
              : tCon > 1
                ? 'con esta velocidad el trípode no es opcional'
                : 'velocidad manejable, igual el trípode te da nitidez'),
          rows: rows,
          chart: bands.map(function (b) { return { label: b.label, value: b.to - b.from, tone: b.tone, from: b.from, to: b.to }; }),
          format: 'unit',
          unit: 'segundos',
          decimals: 1,
          position: r(pos, 1),
          positionLabel: tiempo(tCon) + ' de exposición',
        };
      }

      // ───────────────────────────────── Flash (número guía)
      if (id === 'flash') {
        const gn = nnum(v.gn, 36);
        // El GN se publica a ISO 100 y escala con la raíz del ISO.
        const gnEf = gn * Math.sqrt(iso / 100);
        const alcance = gnEf / N;

        const rows = [
          { k: 'Alcance máximo a full power', ref: 'GN efectivo / f', v: r(alcance, 1), format: 'unit', unit: 'm', decimals: 1, extra: true },
          { k: 'Número guía efectivo a tu ISO', ref: 'GN × √(ISO/100)', v: r(gnEf, 1), format: 'unit', unit: 'GN', decimals: 1 },
          { k: 'Número guía del fabricante (ISO 100)', v: gn, format: 'unit', unit: 'GN', decimals: 0 },
          { k: 'Alcance a media potencia (1/2)', v: r(alcance / Math.SQRT2, 1), format: 'unit', unit: 'm', decimals: 1 },
          { k: 'Alcance a 1/4 de potencia', v: r(alcance / 2, 1), format: 'unit', unit: 'm', decimals: 1 },
          { k: 'Diafragma necesario para llegar a 5 m', v: r(gnEf / 5, 1), format: 'unit', unit: 'f/', decimals: 1 },
        ];

        const bands = [
          { label: '0 a 4 m — alcance limitado, acercate', from: 0, to: 4, tone: 'bad' },
          { label: '4 a 8 m — alcance medio', from: 4, to: 8, tone: 'warn' },
          { label: '8 a 15 m — buen alcance', from: 8, to: 15, tone: 'good' },
          { label: '15 a 25 m — de sobra', from: 15, to: 25, tone: 'good' },
        ];
        const pos = Math.max(0, Math.min(100, (alcance / 25) * 100));

        return {
          total: r(alcance, 1).toLocaleString('es-AR') + ' m',
          sub:
            'GN ' + gn + ' a ISO ' + iso + ' y f/' + N + ' · GN efectivo ' + r(gnEf, 0) + ' · ' +
            (alcance > 15
              ? 'te sobra alcance: podés bajar potencia o cerrar el diafragma'
              : alcance > 8
                ? 'buen alcance para un ambiente normal'
                : alcance > 4
                  ? 'si necesitás más, abrí el diafragma o subí el ISO'
                  : 'alcance corto: acercate al sujeto, abrí el diafragma o subí el ISO'),
          rows: rows,
          chart: bands.map(function (b) { return { label: b.label, value: b.to - b.from, tone: b.tone, from: b.from, to: b.to }; }),
          format: 'unit',
          unit: 'm',
          decimals: 1,
          position: r(pos, 1),
          positionLabel: r(alcance, 1).toLocaleString('es-AR') + ' m de alcance',
        };
      }

      // ───────────────────────────────── Focal equivalente
      const focal = nnum(v.focal, 50);
      const cropO = fnum(v.sensor_origen, 1.5);
      const cropD = fnum(v.sensor_destino, 1);
      const focalFF = focal * cropO;
      const eq = focalFF / cropD;
      // Ángulo horizontal sobre el ancho de 36 mm del full frame.
      const aov = 2 * Math.atan(36 / (2 * focalFF)) * (180 / Math.PI);

      const tipo =
        focalFF < 20 ? 'ultra gran angular — paisaje extremo y arquitectura'
        : focalFF < 35 ? 'gran angular — paisaje, interiores y calle'
        : focalFF < 50 ? 'angular moderado — reportaje y street'
        : focalFF <= 60 ? 'normal — se parece a la visión humana'
        : focalFF < 85 ? 'tele corto — retrato de medio cuerpo'
        : focalFF < 135 ? 'tele medio — retrato y deporte cercano'
        : focalFF < 300 ? 'teleobjetivo — deporte, fauna y eventos'
        : 'super teleobjetivo — fauna lejana y astronomía';

      const rows = [
        { k: 'Focal equivalente en el sensor de destino', v: r(eq, 1), format: 'unit', unit: 'mm', decimals: 1, extra: true },
        { k: 'Equivalente en full frame', ref: 'focal × crop de origen', v: r(focalFF, 1), format: 'unit', unit: 'mm', decimals: 1 },
        { k: 'Focal real grabada en la lente', v: focal, format: 'unit', unit: 'mm', decimals: 0 },
        { k: 'Ángulo de visión horizontal', ref: '2·atan(36/2f)', v: r(aov, 1), format: 'unit', unit: '°', decimals: 1 },
        { k: 'Velocidad mínima sugerida a mano alzada', ref: 'regla 1/focal equivalente', v: Math.round(focalFF), format: 'unit', unit: 'de segundo', decimals: 0 },
        { k: 'Relación entre los dos sensores', v: r(cropO / cropD, 2), format: 'unit', unit: '×', decimals: 2 },
      ];

      const bands = [
        { label: 'Hasta 20 mm — ultra gran angular', from: 0, to: 20, tone: 'good' },
        { label: '20 a 35 mm — gran angular', from: 20, to: 35, tone: 'good' },
        { label: '35 a 60 mm — angular y normal', from: 35, to: 60, tone: 'warn' },
        { label: '60 a 135 mm — retrato', from: 60, to: 135, tone: 'warn' },
        { label: '135 a 300 mm — teleobjetivo', from: 135, to: 300, tone: 'bad' },
        { label: 'Más de 300 mm — super tele', from: 300, to: 600, tone: 'bad' },
      ];
      const pos = Math.max(0, Math.min(100, (focalFF / 600) * 100));

      return {
        total: r(eq, 0).toLocaleString('es-AR') + ' mm',
        sub:
          'Tu ' + focal + ' mm encuadra como un ' + r(eq, 0) + ' mm en el sensor elegido (' +
          r(focalFF, 0) + ' mm full frame, ' + r(aov, 0) + '° de ángulo horizontal) · ' + tipo,
        rows: rows,
        chart: bands.map(function (b) { return { label: b.label, value: b.to - b.from, tone: b.tone, from: b.from, to: b.to }; }),
        format: 'unit',
        unit: 'mm',
        decimals: 0,
        position: r(pos, 1),
        positionLabel: r(focalFF, 0) + ' mm equivalentes — ' + tipo,
      };
    });
  })();
</script>
