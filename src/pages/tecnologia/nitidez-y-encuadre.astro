---
/**
 * Hub de decisión — "¿Qué va a salir nítido y cuánto entra en el cuadro?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/nitidez-y-encuadre.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * ACÁ NO HAY PLATA: cada fila declara su `format` ('unit' con su unidad o
 * 'plain'). Una fila sin format propio saldría en pesos.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import NitidezEncuadreExperience from '../../components/generated/NitidezEncuadreExperience.astro';
import { hub, SENSORES, DIAG_FF, COC_DIVISOR, ARCSEC_POR_SEGUNDO } from '../../lib/hubs/nitidez-y-encuadre';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <NitidezEncuadreExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

