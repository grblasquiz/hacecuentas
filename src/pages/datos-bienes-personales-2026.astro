---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Página-dato citable: mínimo no imponible + escala de Bienes Personales 2026
// (período fiscal 2025, DJ en 2026). Datos verificados contra ARCA (mismos que
// la calc /calculadora-bienes-personales-minimo-no-imponible-2026). Schema Dataset
// + CC-BY 4.0 + "Cómo citar" → backlink por atribución.

const ULTIMA = '2026-06-13';
const MNI = 384728044;
const CASA = 1346548155;
const fmt = (n) => '$' + n.toLocaleString('es-AR');
const escala = [
  ['Hasta $250.000.000', '0,50%'],
  ['Más de $250.000.000 a $500.000.000', '0,75%'],
  ['Más de $500.000.000 a $1.000.000.000', '1,00%'],
  ['Más de $1.000.000.000 a $2.000.000.000', '1,25%'],
  ['Más de $2.000.000.000', '1,75%'],
];

const SITE = 'https://hacecuentas.com';
const URL = `${SITE}/datos-bienes-personales-2026`;
const title = 'Bienes Personales 2026: mínimo no imponible y escala';
const description = `Datos de Bienes Personales 2026 (período fiscal 2025): mínimo no imponible ${fmt(MNI)}, vivienda única exenta hasta ${fmt(CASA)} y escala de alícuotas del 0,50% al 1,75%. Datos ARCA. Uso libre con atribución (CC-BY 4.0).`;

const faq = [
  { q: '¿Cuál es el mínimo no imponible de Bienes Personales 2026?', a: `Para el período fiscal 2025 (declaración en 2026), el mínimo no imponible general es de ${fmt(MNI)}. Si tu patrimonio al 31/12 no lo supera, no pagás el impuesto.` },
  { q: '¿Hasta cuánto está exenta la casa-habitación?', a: `La vivienda única destinada a casa-habitación está exenta hasta ${fmt(CASA)}. Recién tributás por el excedente de ese valor (y aparte del mínimo no imponible general).` },
  { q: '¿Cuáles son las alícuotas de Bienes Personales 2026?', a: 'La escala progresiva va del 0,50% (hasta $250M sobre el excedente del mínimo) al 1,75% (más de $2.000M). El detalle está en la tabla de arriba. Los bienes en el exterior pueden tener alícuotas diferenciales según el régimen vigente.' },
  { q: '¿Qué bienes alcanza?', a: 'El patrimonio de las personas humanas al 31 de diciembre: inmuebles, automotores, saldos bancarios, plazos fijos, acciones y participaciones, criptomonedas, y bienes en el país y en el exterior, valuados según las normas de ARCA.' },
  { q: '¿Cuándo se paga?', a: 'La declaración jurada de Bienes Personales (junto con Ganancias) de personas humanas se presenta a mediados de año; para 2026 el vencimiento fue prorrogado al 27 de julio de 2026.' },
  { q: '¿De dónde salen estos datos?', a: 'De la normativa de ARCA (ex AFIP) vigente para el período fiscal 2025. Los valores se actualizan por inflación según la ley del impuesto.' },
  { q: '¿Puedo usar esta tabla en mi web o trabajo?', a: 'Sí, bajo licencia CC-BY 4.0: reproducí los datos citando la fuente con un enlace a hacecuentas.com. Más abajo está el bloque "Cómo citar".' },
];
const datasetSchema = {
  '@type': 'Dataset', '@id': `${URL}#dataset`,
  name: 'Bienes Personales Argentina 2026 — mínimo no imponible y escala',
  description: 'Mínimo no imponible, exención de casa-habitación y escala de alícuotas del impuesto a los Bienes Personales en Argentina para el período fiscal 2025 (declaración 2026). Fuente: ARCA.',
  url: URL, license: 'https://creativecommons.org/licenses/by/4.0/', isAccessibleForFree: true,
  inLanguage: 'es-AR', dateModified: ULTIMA, temporalCoverage: '2025/2026', spatialCoverage: { '@type': 'Place', name: 'Argentina' },
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: SITE },
  sourceOrganization: { '@type': 'GovernmentOrganization', name: 'ARCA (ex AFIP)', url: 'https://www.afip.gob.ar/' },
  keywords: ['Bienes Personales', 'mínimo no imponible', 'alícuotas', '2026', 'Argentina', 'ARCA'],
  variableMeasured: ['Mínimo no imponible (ARS)', 'Exención casa-habitación (ARS)', 'Alícuota por tramo (%)'],
};
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', '@id': `${URL}#webpage`, name: title, description, url: URL, inLanguage: 'es-AR', dateModified: ULTIMA, mainEntity: { '@id': `${URL}#dataset` } },
  datasetSchema,
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Bienes Personales 2026', item: URL } ] },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
] };
---

<Layout image="/og/data-datos-bienes-personales-2026.jpg" imageWidth={1200} imageHeight={675} title={title} description={description} canonical="/datos-bienes-personales-2026" audience="AR" schema={schema} domain="data">
  <Header slot="header" />
  <main class="article-main">
    <article class="datos-page">
      <header>
        <nav class="crumbs"><a href="/">Inicio</a> <span>›</span> <span>Bienes Personales 2026</span></nav>
        <h1>Bienes Personales 2026: mínimo no imponible y escala</h1>
        <p class="lede">Datos del impuesto a los <strong>Bienes Personales</strong> para el período fiscal 2025 (declaración 2026): mínimo no imponible, exención de la vivienda y escala de alícuotas. Fuente: <strong>ARCA</strong>.</p>
        <p class="updated">Última revisión: <time datetime={ULTIMA}>{ULTIMA}</time> · Licencia <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC-BY 4.0</a> (uso libre con atribución)</p>
      </header>

      <section class="stats-callout">
        <div class="stat"><span class="stat-num">{fmt(MNI)}</span><span class="stat-label">mínimo no imponible general</span></div>
        <div class="stat"><span class="stat-num">{fmt(CASA)}</span><span class="stat-label">casa-habitación exenta hasta</span></div>
        <div class="stat"><span class="stat-num">0,50% – 1,75%</span><span class="stat-label">escala de alícuotas</span></div>
      </section>

      <section>
        <h2>Escala de alícuotas de Bienes Personales 2026</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th class="l">Patrimonio gravado (sobre el excedente del mínimo)</th><th>Alícuota</th></tr></thead>
            <tbody>{escala.map(([t, a]) => (<tr><td class="l">{t}</td><td>{a}</td></tr>))}</tbody>
          </table>
        </div>
        <p class="note">La alícuota se aplica sobre el excedente del mínimo no imponible. Bienes en el exterior pueden tener tratamiento diferencial según el régimen vigente.</p>
      </section>

      <section>
        <h2>Calculá tu caso</h2>
        <ul class="calc-links">
          <li><a href="/calculadora-bienes-personales-2026">Calculadora de Bienes Personales 2026</a></li>
          <li><a href="/datos-ganancias-2026">Escala de Ganancias 2026</a> · <a href="/datos-monotributo-2026">Monotributo 2026</a> · <a href="/datos-topes-sipa-2026">Topes SIPA 2026</a></li>
        </ul>
      </section>

      <section class="cite-instructions">
        <h2>Cómo citar esta tabla</h2>
        <p>¿Usás estos datos en una nota, trabajo, app o web? La atribución pedida es:</p>
        <pre><code>Fuente: Hacé Cuentas — https://hacecuentas.com/datos-bienes-personales-2026
Datos ARCA · Licencia CC-BY 4.0</code></pre>
      </section>

      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </section>

      <section class="fuentes">
        <h2>Fuentes</h2>
        <ul><li><a href="https://www.afip.gob.ar/" rel="nofollow noopener" target="_blank">ARCA (ex AFIP) — Bienes Personales</a></li></ul>
      </section>
    </article>
  </main>
  <Footer slot="footer" />
</Layout>

<style>
  .datos-page { max-width: 900px; margin: 0 auto; padding: 1rem 1rem 4rem; }
  .crumbs { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .datos-page h1 { font-size: 2rem; line-height: 1.2; margin-bottom: 1rem; }
  .lede { font-size: 1.1rem; line-height: 1.6; color: var(--text); }
  .updated { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem; }
  .updated a { color: var(--accent); }
  .datos-page h2 { font-size: 1.4rem; margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .stats-callout { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin: 1.75rem 0; }
  .stat { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 0.6rem; padding: 0.9rem 1rem; text-align: center; }
  .stat-num { display: block; font-size: 1.2rem; font-weight: 700; color: var(--accent); line-height: 1.2; }
  .stat-label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }
  .table-wrap { overflow-x: auto; margin: 1.25rem 0; }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th, td { padding: 0.6rem 0.7rem; text-align: right; border-bottom: 1px solid var(--border); }
  th.l, td.l { text-align: left; }
  th { background: var(--bg-soft); font-weight: 600; }
  .note { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem; }
  .calc-links li, .fuentes li { line-height: 1.7; margin-bottom: 0.5rem; }
  .calc-links, .fuentes ul { margin-left: 1.25rem; }
  .calc-links a, .fuentes a { color: var(--accent); }
  .cite-instructions { margin-top: 2.5rem; padding: 1.1rem; background: var(--bg-soft); border-radius: 0.6rem; }
  .cite-instructions pre { background: var(--code-bg, #eaeef3); padding: 0.75rem; border-radius: 0.4rem; overflow-x: auto; font-size: 0.85rem; }
  .faq details { border-bottom: 1px solid var(--border); padding: 0.75rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq details p { margin-top: 0.5rem; color: var(--text-muted); line-height: 1.6; }
</style>
