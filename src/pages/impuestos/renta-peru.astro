---
/**
 * Hub de decisión — "Impuesto a la renta en Perú: ¿cuánto pago?"
 * Reemplaza /calculadora-impuesto-renta-peru-4ta-5ta-2026.
 *
 * OJO con el audience: HubData sólo admite 'AR' | 'global', pero esta página es
 * peruana. El audience="PE" se pasa acá, literal al Layout, para no perder el
 * geo targeting del mercado.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, UIT, TABLA_RENTA_PE, DEDUCCION_UIT, DEDUCCION_4TA, TOPE_4TA_UIT } from '../../lib/hubs/renta-peru';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="PE"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ UIT, TABLA: TABLA_RENTA_PE, DEDUCCION_UIT, DEDUCCION_4TA, TOPE_4TA_UIT }}
>
  (function () {
    const H = window.HC_HUB;
    const pen = (n) => 'S/ ' + Math.round(n || 0).toLocaleString('es-PE');

    // Escala progresiva del Art. 53 LIR, en UIT acumuladas.
    // Espejo de src/lib/formulas/impuesto-renta-peru.ts.
    function escala(rentaNeta) {
      if (rentaNeta <= 0) return { impuesto: 0, marginal: 0 };
      const rentaUit = rentaNeta / UIT;
      let impuesto = 0, anterior = 0, marginal = 0;
      for (const t of TABLA) {
        const hasta = t.hastaUit === null ? Infinity : t.hastaUit;
        const tramo = Math.min(rentaUit, hasta) - anterior;
        if (tramo <= 0) break;
        impuesto += tramo * UIT * (t.tasa / 100);
        marginal = t.tasa;
        anterior = hasta;
        if (rentaUit <= hasta) break;
      }
      return { impuesto: impuesto, marginal: marginal };
    }

    H.onCompute(function (v, kase) {
      const categoria = (kase && kase.id) === '4ta' ? '4ta' : '5ta';
      const ingreso = Math.max(0, v.ingreso || 0);
      const adicionales = Math.max(0, v.deduccionesAd || 0);
      const retenciones = Math.max(0, v.retenciones || 0);

      const deduccion20 = categoria === '4ta'
        ? Math.min(ingreso * DEDUCCION_4TA, TOPE_4TA_UIT * UIT)
        : 0;
      const deduccion7 = DEDUCCION_UIT * UIT;
      const rentaBruta = ingreso - deduccion20;
      const rentaNeta = Math.max(0, rentaBruta - deduccion7 - adicionales);

      const r = escala(rentaNeta);
      const impuesto = Math.round(r.impuesto);
      const saldo = Math.max(0, impuesto - retenciones);
      const aFavor = Math.max(0, retenciones - impuesto);
      const efectiva = ingreso > 0 ? (impuesto / ingreso) * 100 : 0;
      const deduccionTotal = deduccion20 + Math.min(deduccion7 + adicionales, Math.max(0, rentaBruta));

      const rows = [{ k: 'Ingreso anual bruto', ref: categoria + ' categoría', v: ingreso }];
      if (deduccion20 > 0) {
        rows.push({ k: 'Deducción del 20% (se resta)', ref: 'Tope ' + TOPE_4TA_UIT + ' UIT', v: deduccion20 });
      }
      rows.push({ k: 'Deducción fija de 7 UIT (se resta)', ref: 'Art. 46 LIR', v: deduccion7 });
      if (adicionales > 0) {
        rows.push({ k: 'Deducciones adicionales (se restan)', ref: 'Hasta 3 UIT', v: adicionales });
      }
      rows.push({ k: 'Renta neta de trabajo', ref: 'Base del Art. 53', v: rentaNeta });
      rows.push({ k: 'Renta neta en UIT', ref: 'UIT ' + pen(UIT), v: rentaNeta / UIT, format: 'unit', unit: 'UIT', decimals: 1 });
      rows.push({ k: 'Tasa marginal alcanzada', ref: 'Último tramo aplicado', v: r.marginal, format: 'unit', unit: '%' });
      rows.push({ k: 'Impuesto a la renta del año', ref: 'Art. 53 LIR', v: impuesto, extra: true });
      if (retenciones > 0) {
        rows.push({ k: 'Retenciones ya practicadas (se restan)', ref: 'Pagos a cuenta', v: Math.min(retenciones, impuesto) });
        rows.push({ k: aFavor > 0 ? 'Saldo a favor' : 'Saldo por regularizar', ref: 'Declaración anual', v: aFavor > 0 ? aFavor : saldo, extra: true });
      }
      rows.push({ k: 'Tasa efectiva sobre el ingreso', ref: 'Impuesto ÷ ingreso', v: efectiva, format: 'unit', unit: '%', decimals: 2 });

      return {
        total: pen(impuesto),
        sub:
          categoria + ' categoría · renta neta ' + (rentaNeta / UIT).toFixed(1).replace('.', ',') + ' UIT · ' +
          (impuesto > 0
            ? 'marginal ' + r.marginal + '% · tasa efectiva ' + efectiva.toFixed(2).replace('.', ',') + '%'
            : 'la deducción de 7 UIT absorbe todo: no pagás impuesto') +
          (retenciones > 0
            ? (aFavor > 0 ? ' · te quedan ' + pen(aFavor) + ' a favor' : ' · falta pagar ' + pen(saldo))
            : ''),
        rows: rows,
        chart: [
          { label: 'Ingreso sin gravar (deducciones)', value: Math.round(deduccionTotal), tone: 'good' },
          { label: 'Renta neta que queda tras el impuesto', value: Math.max(0, Math.round(rentaNeta - impuesto)), tone: 'main' },
          { label: 'Impuesto a la renta', value: impuesto, tone: 'warn' },
        ],
      };
    });
  })();
</script>
