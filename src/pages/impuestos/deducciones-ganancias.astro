---
/**
 * Hub de decisión — "¿Qué me puedo deducir de Ganancias y cuánto me baja?"
 * Reemplaza 3 URLs de calculadora suelta (ver hub.replaces).
 *
 * No recalcula el impuesto de cuarta categoría (para eso está
 * /impuestos/ganancias-cuarta-categoria): responde qué deducciones podés
 * computar y cuánta base imponible e impuesto te sacan de encima.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import DeduccionesGananciasExperience from '../../components/generated/DeduccionesGananciasExperience.astro';
import { hub, CASE_MATH, DEDUC, ESCALA_JSON } from '../../lib/hubs/deducciones-ganancias';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DeduccionesGananciasExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

