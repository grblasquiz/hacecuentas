---
/**
 * Hub de decisión — "¿Qué retenciones y percepciones me hacen al facturar?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import RetencionesImpuestosExperience from '../../components/generated/RetencionesImpuestosExperience.astro';
import { hub, RG830_RATES, TAX } from '../../lib/hubs/retenciones';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};

const PLAN = {
  tasaMensualPct: TAX.plan.tasaMensualPct,
  cuotaMinima: TAX.plan.cuotaMinima,
  pagoACuentaPct: TAX.plan.planes.micro.pagoACuentaPct,
  cuotasMax: TAX.plan.planes.micro.cuotasMax,
};

const CONST = {
  idcUnilateral: TAX.idcUnilateral,
  idcComputable: TAX.idcComputable,
  resarcitorio: TAX.interesResarcitorioMensual,
  punitorio: TAX.interesPunitorioMensual,
  turismoPesos: TAX.percepcionTurismoPesos,
  monedaExtranjera: TAX.percepcionMonedaExtranjera,
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <RetencionesImpuestosExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

