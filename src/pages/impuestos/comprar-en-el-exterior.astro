---
export const prerender = true;
import SeoReferenceTable from '../../components/SeoReferenceTable.astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import ComprarExteriorImpuestosExperience from '../../components/generated/ComprarExteriorImpuestosExperience.astro';
import { hub, ENVIOS_2026 } from '../../lib/hubs/comprar-en-el-exterior';
const canonical='https://hacecuentas.com/impuestos/comprar-en-el-exterior';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
import HubCitableStats from '../../components/hub/HubCitableStats.astro';
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <ComprarExteriorImpuestosExperience />
  <SeoReferenceTable title="Límites para compras personales en el exterior" columns={['Concepto', 'Condición']}
    rows={[
      { label: 'Tope del régimen simplificado', details: [`USD ${ENVIOS_2026.topeEnvioUSD.toLocaleString('es-AR')} FOB por envío`] },
      { label: 'Franquicia', details: [`USD ${ENVIOS_2026.franquiciaFobUSD} FOB por envío, hasta ${ENVIOS_2026.enviosPorAnio} por año`] },
      { label: 'Cantidad', details: [`Hasta ${ENVIOS_2026.unidadesIgualesMax} unidades de la misma especie`] },
      { label: 'Tributos dentro de la franquicia', details: ['IVA e impuestos internos, cuando correspondan'] },
    ]}>
    <p>Consultá los procedimientos de ARCA para <a href="https://www.arca.gob.ar/envios-internacionales/courier/importacion/pequenios-envios.asp">courier</a> y <a href="https://www.arca.gob.ar/envios-internacionales/puerta-a-puerta/procedimiento.asp">Correo Argentino</a>.</p>
  </SeoReferenceTable>
  <HubCitableStats data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>
