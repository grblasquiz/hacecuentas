---
/**
 * Hub de decisión — "¿Cómo discrimino el IVA?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/iva.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 *
 * OJO FORMATO: el runtime hace `Object.assign` del formato base con el de cada
 * fila. Acá la mayoría de las filas son plata (default 'ars'), pero las que no
 * lo son —alícuota, proporción sobre el total— declaran su `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import IvaExperience from '../../components/generated/IvaExperience.astro';
import { hub, PAISES, CASE_MATH, ALICUOTA_GENERAL } from '../../lib/hubs/iva';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <IvaExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MATH: CASE_MATH, PAISES, ALICUOTA_GENERAL }}>
  (function () {
    const H = window.HC_HUB;

    // Porcentaje con coma decimal es-AR y hasta 4 decimales (17,3554%).
    function pct(n, dec) {
      return Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: dec == null ? 2 : dec,
        maximumFractionDigits: dec == null ? 2 : dec,
      });
    }

    H.onCompute(function (v, kase) {
      const m = MATH[(kase && kase.id) || 'sacar'] || MATH.sacar;
      const monto = Math.max(0, v.monto || 0);

      // Alícuota efectiva de la rama: fija (10,5%), del país, o la del select.
      const pais = m.usaPais ? PAISES[String(v.pais || 'argentina')] || PAISES.argentina : null;
      const alicuota = m.alicuotaFija != null ? m.alicuotaFija : pais ? pais.alicuota : Number(v.alicuota) || 21;
      const nombreImp = pais ? pais.impuesto : 'IVA';
      const factor = 1 + alicuota / 100;

      if (!monto) {
        return {
          total: H.ars(0),
          sub: 'Cargá el monto y actualizá la estimación.',
          rows: [],
          chart: [],
        };
      }

      let neto, iva, total;
      if (m.modo === 'agregar') {
        // Agregar: la base es el neto, así que el IVA sí es el % directo.
        neto = monto;
        iva = monto * (alicuota / 100);
        total = neto + iva;
      } else {
        // Sacar: DIVIDIR por (1 + alícuota). Restar el % da un neto falso.
        total = monto;
        neto = monto / factor;
        iva = total - neto;
      }

      // Proporción real del impuesto dentro del precio final: a/(100+a).
      const pctSobreTotal = (alicuota / (100 + alicuota)) * 100;

      const rows = [];
      rows.push({ k: 'Precio neto (base gravada)', ref: m.norma, v: neto, extra: true });
      rows.push({ k: nombreImp + ' ' + pct(alicuota, alicuota % 1 ? 1 : 0) + '%', ref: m.norma, v: iva, extra: true });
      rows.push({ k: 'Precio final con ' + nombreImp, ref: 'Total', v: total });
      // Filas que NO son plata: format explícito o el runtime les pone "$".
      rows.push({
        k: 'Alícuota aplicada',
        ref: pais ? pais.nombre : 'Argentina',
        v: alicuota,
        format: 'unit',
        unit: '%',
        decimals: alicuota % 1 ? 1 : 0,
      });
      rows.push({
        k: 'Cuánto del precio final es impuesto',
        ref: 'alícuota ÷ (100 + alícuota)',
        v: pctSobreTotal,
        format: 'unit',
        unit: '% del total',
        decimals: 4,
      });

      if (m.modo === 'sacar') {
        // La fila que justifica el hub: restar el % da un neto que no cierra.
        const netoMal = total * (1 - alicuota / 100);
        rows.push({ k: 'ERROR CLÁSICO — restar el ' + pct(alicuota, alicuota % 1 ? 1 : 0) + '% al precio final', ref: 'no hacer', v: netoMal });
        rows.push({ k: 'Diferencia contra el neto correcto', ref: 'neto − mal calculado', v: neto - netoMal });
      }

      if ((kase && kase.id) === 'reducida') {
        // Comparación contra la alícuota general, que es la duda real de la rama.
        const netoGral = total / (1 + ALICUOTA_GENERAL / 100);
        rows.push({ k: 'Si fuera al ' + ALICUOTA_GENERAL + '%: IVA contenido', ref: 'comparación', v: total - netoGral });
        rows.push({ k: 'Diferencia de impuesto entre 10,5% y ' + ALICUOTA_GENERAL + '%', ref: 'comparación', v: total - netoGral - iva });
      }

      const subPartes = [];
      if (m.modo === 'agregar') {
        subPartes.push('neto ' + H.ars(neto) + ' × ' + pct(factor, 3) + ' = ' + H.ars(total));
      } else {
        subPartes.push(H.ars(total) + ' ÷ ' + pct(factor, 3) + ' = neto ' + H.ars(neto));
      }
      subPartes.push('el ' + nombreImp + ' es el ' + pct(pctSobreTotal, 4) + '% del precio final');
      if (pais) subPartes.push(pais.nombre + ' · ' + nombreImp + ' ' + pct(alicuota, alicuota % 1 ? 1 : 0) + '% · ' + pais.moneda + (pais.nota ? ' · ' + pais.nota : ''));

      return {
        total: H.ars(iva),
        sub: subPartes.join(' · '),
        rows: rows,
        chart: [
          { label: 'Precio neto', value: Math.round(neto * 100) / 100, tone: 'main' },
          { label: nombreImp + ' ' + pct(alicuota, alicuota % 1 ? 1 : 0) + '%', value: Math.round(iva * 100) / 100, tone: 'warn' },
        ],
        decimals: 0,
      };
    });
  })();
</script>
