---
/**
 * Hub de decisión — "¿Tengo que pagar Bienes Personales?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/bienes-personales.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BienesPersonalesExperience from '../../components/generated/BienesPersonalesExperience.astro';
import {
  hub,
  CASE_MATH,
  MNI,
  DEDUCCION_CASA,
  ESCALA,
  REIBP_TASA,
  REIBP_ANIOS,
  DEPRECIACION_ANUAL,
  DEPRECIACION_PISO,
} from '../../lib/hubs/bienes-personales';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const CONST = {
  mni: MNI,
  casaTope: DEDUCCION_CASA,
  escala: ESCALA,
  reibpTasa: REIBP_TASA,
  reibpAnios: REIBP_ANIOS,
  dep: DEPRECIACION_ANUAL,
  depPiso: DEPRECIACION_PISO,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <BienesPersonalesExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MATH: CASE_MATH, K: CONST }}>
  (function () {
    const H = window.HC_HUB;
    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });

    H.onCompute(function (v, kase) {
      const m = MATH[kase?.id] || MATH.basico;

      // Valuación fiscal del automotor: 8% anual con piso del 40% del valor
      // de origen. Mismo factor que valuacion-fiscal-automotor-provincia.ts.
      const antiguedad = Math.max(0, Number(v.antiguedad) || 0);
      const factorDep = Math.max(K.depPiso, 1 - antiguedad * K.dep);
      const auto = Math.max(0, v.autoValor) * factorDep;

      const casa = Math.max(0, v.casa);
      const exterior = m.exterior ? Math.max(0, v.exterior) : 0;
      const enPais =
        casa +
        Math.max(0, v.otrosInmuebles) +
        auto +
        Math.max(0, v.inversiones) +
        Math.max(0, v.cripto) +
        Math.max(0, v.otros);

      const bruto = enPais + exterior;
      const deduccionCasa = m.casa ? Math.min(casa, K.casaTope) : 0;
      const base = Math.max(0, bruto - deduccionCasa);

      const paga = base > K.mni;
      const excedente = paga ? base - K.mni : 0;

      // Impuesto: REIBP (tasa fija × 5 años) o escala progresiva sobre el excedente.
      let impuesto = 0;
      let marginal = 0;
      let tramoLabel = 'No alcanzado';
      // El REIBP también arranca del MNI: por debajo del mínimo no hay
      // impuesto que adelantar. Mismo orden que la fórmula original, que
      // retorna antes de evaluar el régimen especial.
      if (m.reibp && paga) {
        impuesto = base * K.reibpTasa * K.reibpAnios;
        marginal = K.reibpTasa * 100;
        tramoLabel = 'REIBP · tasa fija por ' + K.reibpAnios + ' años';
      } else if (paga) {
        for (let k = 0; k < K.escala.length; k++) {
          const tramo = K.escala[k];
          if (excedente <= tramo.hasta) {
            const desde = k === 0 ? 0 : K.escala[k - 1].hasta;
            marginal = tramo.tasa * 100;
            impuesto = tramo.acumulado + (excedente - desde) * tramo.tasa;
            tramoLabel = tramo.label;
            break;
          }
        }
      }

      const efectiva = base > 0 ? (impuesto / base) * 100 : 0;

      const rows = [
        { k: 'Bienes en el país', v: enPais },
        { k: 'Bienes en el exterior', ref: 'misma escala (Ley 27.743)', v: exterior },
        { k: 'Patrimonio declarado', v: bruto, extra: true },
        {
          k: 'Deducción por casa-habitación',
          ref: m.casa ? 'tope ' + H.ars(K.casaTope) : 'no aplica en este caso',
          v: -deduccionCasa,
        },
        { k: 'Base imponible', v: base, extra: true },
        { k: 'Mínimo no imponible', ref: 'exento', v: -Math.min(base, K.mni) },
        { k: 'Excedente gravado', v: excedente, extra: true },
        { k: 'Valuación fiscal del auto', ref: nf(factorDep * 100) + '% del valor de origen', v: auto },
        { k: 'Alícuota marginal', v: marginal, format: 'unit', unit: '%', decimals: 2 },
        { k: 'Alícuota efectiva sobre la base', v: efectiva, format: 'unit', unit: '%', decimals: 3 },
        { k: 'Impuesto determinado', v: impuesto, extra: true },
      ];

      // --- Gráfico posicional: el eje es la base imponible ---
      // La primera franja es el mínimo. Si el marcador cae ahí, no pagás.
      const t1 = K.mni + K.escala[0].hasta;
      const t2 = K.mni + K.escala[1].hasta;
      const tope = Math.max(t2 * 1.6, base * 1.15, K.mni * 1.4);

      const chart = [
        { label: 'Exento · mínimo no imponible', value: K.mni, tone: 'good', from: 0, to: K.mni },
        { label: '0,50%', value: t1 - K.mni, tone: 'warn', from: K.mni, to: t1 },
        { label: '0,75%', value: t2 - t1, tone: 'warn', from: t1, to: t2 },
        { label: '1,00%', value: Math.max(0, tope - t2), tone: 'bad', from: t2, to: tope },
      ];

      const sub = paga
        ? 'Superás el mínimo por ' + H.ars(excedente) + ' · ' + tramoLabel +
          ' · alícuota efectiva ' + nf(efectiva, 3) + '% sobre una base de ' + H.ars(base)
        : 'Tu base de ' + H.ars(base) + ' queda por debajo del mínimo no imponible de ' +
          H.ars(K.mni) + ': este período no tributás.';

      return {
        total: paga ? H.ars(impuesto) : 'No pagás',
        sub: sub,
        rows: rows,
        chart: chart,
        position: tope > 0 ? Math.min(100, (base / tope) * 100) : 0,
        positionLabel: paga
          ? 'Base ' + H.ars(base) + ' · ' + tramoLabel
          : 'Base ' + H.ars(base) + ' · por debajo del mínimo, no pagás',
      };
    });
  })();
</script>
