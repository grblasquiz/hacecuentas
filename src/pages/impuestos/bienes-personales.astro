---
/**
 * Hub de decisión — "¿Tengo que pagar Bienes Personales?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/bienes-personales.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import BienesPersonalesExperience from '../../components/generated/BienesPersonalesExperience.astro';
import ThirdWaveBoost from '../../components/ThirdWaveBoost.astro';
import {
  hub,
  CASE_MATH,
  MNI,
  DEDUCCION_CASA,
  ESCALA,
  REIBP_TASA,
  REIBP_ANIOS,
  DEPRECIACION_ANUAL,
  DEPRECIACION_PISO,
} from '../../lib/hubs/bienes-personales';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const CONST = {
  mni: MNI,
  casaTope: DEDUCCION_CASA,
  escala: ESCALA,
  reibpTasa: REIBP_TASA,
  reibpAnios: REIBP_ANIOS,
  dep: DEPRECIACION_ANUAL,
  depPiso: DEPRECIACION_PISO,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name: hub.h1, url: CANONICAL, operatingSystem: 'Web', applicationCategory: 'FinanceApplication', inLanguage: 'es', isAccessibleForFree: true },
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <BienesPersonalesExperience data={hub} />
  <ThirdWaveBoost variant="assets" />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>
