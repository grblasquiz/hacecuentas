---
/**
 * Hub de decisión — "DNI, pasaporte y trámites: ¿cuánto cuesta y qué necesito?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: 8 casos, cuatro de costo y tres determinísticos
 * (CBU, CUIL, letra del DNI). Las ramas sin plata declaran format 'plain'
 * en el resultado Y en cada fila: el default del runtime es pesos.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import DniPasaporteExperience from '../../components/generated/DniPasaporteExperience.astro';
import { hub, ARANCELES, ENTIDADES, PSP, PESOS, LETRAS } from '../../lib/hubs/tramites';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DniPasaporteExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

