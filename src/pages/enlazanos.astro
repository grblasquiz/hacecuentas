---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import ContentCard from '../components/ui/ContentCard.astro';
import { TOTAL_DISPLAY } from '../lib/calc-counts';

const title = "Enlazanos — Recomendá nuestras calculadoras | Hacé Cuentas";
const description =
  "¿Usás nuestras calculadoras en tu trabajo o tu web? Enlazanos con un clic. Snippets HTML listos para copiar y pegar, ordenados por rubro: contadores, RRHH, medios y docentes.";

const siteUrl = "https://hacecuentas.com";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteUrl}/enlazanos#webpage`,
  name: title,
  description,
  url: `${siteUrl}/enlazanos`,
  inLanguage: ["es", "es-AR", "es-419"],
  isPartOf: {
    "@type": "WebSite",
    name: "Hacé Cuentas",
    url: siteUrl,
  },
};

const schemaBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Enlazanos", item: `${siteUrl}/enlazanos` },
  ],
};

// ── Snippets por rubro ──────────────────────────────────────────────────────
// Cada vertical trae 1–2 anchors reales a calcs canónicas de alto tráfico.
// El HTML que copia el usuario apunta directo a la página de la calc (deep-link
// con anchor de keyword), que es lo que concentra autoridad en esas URLs.
const link = (slug: string, label: string) =>
  `<a href="${siteUrl}/${slug}" target="_blank" rel="noopener">${label}</a>`;

const verticals = [
  {
    id: "contadores",
    emoji: "🧾",
    title: "Contadores y estudios",
    intro:
      "Poné a mano de tus clientes las cuentas que más te preguntan por WhatsApp: monotributo y Ganancias, siempre con las escalas del año.",
    snippet:
      link("calculadora-monotributo-2026", "Calculadora de Monotributo 2026") +
      " y " +
      link("calculadora-impuesto-ganancias-sueldo", "Calculadora de Impuesto a las Ganancias") +
      " — por Hacé Cuentas.",
  },
  {
    id: "rrhh",
    emoji: "💼",
    title: "RRHH y liquidación de sueldos",
    intro:
      "Ideal para intranets, onboarding y áreas de Personal: que el equipo estime su sueldo en mano o una indemnización sin pedírtelo a vos.",
    snippet:
      link("sueldo-en-mano-argentina", "Calculadora de sueldo en mano") +
      " e " +
      link("calculadora-indemnizacion-despido", "Calculadora de indemnización por despido") +
      " — por Hacé Cuentas.",
  },
  {
    id: "medios",
    emoji: "📰",
    title: "Medios y periodismo",
    intro:
      "Para notas de economía y actualidad: dólar del día e inflación acumulada, con datos que se actualizan solos. Más contexto para tu lector, cero mantenimiento para vos.",
    snippet:
      link("dolar-hoy", "Dólar hoy") +
      " e " +
      link("inflacion-argentina", "Inflación en Argentina") +
      " — por Hacé Cuentas.",
  },
  {
    id: "docentes",
    emoji: "🎓",
    title: "Docentes y educación",
    intro:
      "Para aulas virtuales, blogs de cátedra y guías de estudio: una científica completa y la regla de tres, gratis y sin registro para tus alumnos.",
    snippet:
      link("calculadora-cientifica", "Calculadora científica online") +
      " y " +
      link("calculadora-regla-de-tres-simple", "Calculadora de regla de tres") +
      " — por Hacé Cuentas.",
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
>
  <Header slot="header" />

  <article class="enlazanos-page">

    <nav class="breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Enlazanos</span>
    </nav>

    <!-- HERO -->
    <header class="hero">
      <div class="hero__copy">
        <div class="hero__badge">Recomendanos</div>
        <h1>¿Usás nuestras calculadoras?<br /><span>Enlazanos</span></h1>
        <p class="hero__sub">
          Sumá un enlace desde tu web, intranet o blog. Elegí tu rubro, copiá el HTML y pegalo donde quieras.
          Ayuda a que más gente encuentre las {TOTAL_DISPLAY} calculadoras.
        </p>
        <a href="#snips-heading" class="hero__cta">Elegir mi rubro <span aria-hidden="true">↓</span></a>
      </div>
      <aside class="hero__proof" aria-label="Beneficios de enlazar">
        <span class="proof-icon" aria-hidden="true">🔗</span>
        <strong>Un enlace útil para tu audiencia.</strong>
        <span>Datos actualizados por nosotros, cero mantenimiento para vos.</span>
        <small>HTML listo · Sin registro · Gratis</small>
      </aside>
    </header>

    <!-- SNIPPETS POR RUBRO -->
    <section class="snips-section" aria-labelledby="snips-heading">
      <h2 id="snips-heading">Snippets listos por rubro</h2>
      <p class="snips-intro">
        Cada bloque es HTML válido para pegar en cualquier CMS (WordPress, Blogger, Wix)
        o directo en tu código. Los enlaces abren la calculadora en una pestaña nueva.
      </p>

      <div class="snips-grid">
        {verticals.map((v) => (
          <ContentCard class="snip-card">
            <div class="snip-card__head">
              <span class="snip-card__emoji" aria-hidden="true">{v.emoji}</span>
              <div>
                <h3>{v.title}</h3>
                <p class="snip-card__intro">{v.intro}</p>
              </div>
            </div>

            <div class="snip-preview">
              <span class="snip-preview__label">Así se ve:</span>
              <p class="snip-rendered" set:html={v.snippet}></p>
            </div>

            <div class="code-block-wrapper">
              <div class="code-block-header">
                <span class="code-block-label">HTML para copiar</span>
                <button
                  class="btn-copy"
                  data-code={v.snippet}
                  data-vertical={v.id}
                  aria-label={`Copiar HTML de ${v.title}`}
                >
                  Copiar HTML
                </button>
              </div>
              <pre class="code-block"><code>{v.snippet}</code></pre>
            </div>
          </ContentCard>
        ))}
      </div>
    </section>

    <!-- POR QUÉ -->
    <section class="why-section" aria-labelledby="why-heading">
      <h2 id="why-heading">¿Por qué enlazarnos conviene a los dos?</h2>
      <div class="why-grid">
        <ContentCard class="why-card" interactive>
          <div class="why-icon" aria-hidden="true">🎯</div>
          <h3>Le das valor a tu página</h3>
          <p>Un enlace a la calculadora exacta resuelve la duda de tu visitante en el momento, sin que tengas que armar ni mantener la herramienta.</p>
        </ContentCard>
        <ContentCard class="why-card" interactive>
          <div class="why-icon" aria-hidden="true">🔗</div>
          <h3>Enlace real, no atrapado</h3>
          <p>Es un <code>&lt;a&gt;</code> normal a la calculadora — no un iframe. Cuenta como una recomendación genuina y siempre apunta al dato actualizado.</p>
        </ContentCard>
        <ContentCard class="why-card" interactive>
          <div class="why-icon" aria-hidden="true">🔄</div>
          <h3>Cero mantenimiento</h3>
          <p>Nosotros actualizamos escalas, cotizaciones e índices. Tu enlace siempre lleva a la versión vigente, sin que toques nada.</p>
        </ContentCard>
      </div>
    </section>

    <!-- CTA PARTNERSHIPS -->
    <section class="cta-partners" aria-labelledby="cta-heading">
      <div class="cta-inner">
        <div class="cta-icon" aria-hidden="true">🤝</div>
        <h2 id="cta-heading">¿Buscás algo más grande?</h2>
        <p>
          Si sos un medio, una fintech o un estudio y querés una calculadora
          <strong>a medida</strong>, embeber un widget con tu marca o coordinar un
          intercambio de contenidos, hablemos. Armamos partnerships que suman a las dos partes.
        </p>
        <a href="/contacto?tema=partnerships" class="btn-primary btn-primary--large">
          Escribinos para partnerships <span aria-hidden="true">→</span>
        </a>
        <p class="cta-alt">
          ¿Preferís un widget interactivo embebido? Mirá <a href="/embeber">cómo embeber una calculadora →</a>
        </p>
      </div>
    </section>

    <Newsletter />

  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)}></script>

  <Footer slot="footer" />
</Layout>

<script>
  // Copy-to-clipboard para todos los .btn-copy. Aditivo: evento gtag opcional
  // con guard typeof gtag (no toca ningún tag existente).
  document.querySelectorAll<HTMLButtonElement>('.btn-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.dataset.code ?? '';
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      try {
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'enlazanos_copy', { vertical: btn.dataset.vertical ?? '' });
        }
      } catch {}
      const original = btn.textContent ?? '';
      btn.textContent = '¡Copiado!';
      btn.classList.add('btn-copy--success');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('btn-copy--success');
      }, 2000);
    });
  });
</script>

<style>
  .enlazanos-page {
    max-width: 880px;
    margin: 1rem auto 2rem;
    padding: 0 1rem;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-subtle);
    margin-bottom: 1.5rem;
  }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }

  section { margin-bottom: 4rem; }
  section h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    margin-bottom: 1.25rem;
    color: var(--text);
  }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 2rem;
    align-items: center;
    padding: 2.8rem;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    border-radius: 1.5rem;
    background: linear-gradient(125deg, color-mix(in srgb, var(--accent) 9%, var(--bg-card)), var(--bg-card) 68%);
    margin-bottom: 3.5rem;
  }
  .hero__badge {
    display: inline-block;
    background: var(--accent-subtle, #ecfdf5);
    color: var(--accent);
    border: 1px solid var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }
  :global([data-theme="dark"]) .hero__badge {
    background: rgba(52,211,153,0.1);
  }
  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 3.35rem);
    line-height: 1.15;
    letter-spacing: -0.045em;
    margin: 0 0 1rem;
  }
  .hero h1 span { color: var(--accent); }
  .hero__sub {
    font-size: 1.0625rem;
    color: var(--text-muted);
    max-width: 610px;
    margin: 0;
    line-height: 1.6;
  }
  .hero__cta { display: inline-flex; align-items: center; gap: .55rem; margin-top: 1.35rem; padding: .75rem 1.05rem; border-radius: .75rem; background: var(--accent); color: #fff; font-weight: 700; text-decoration: none; font-size: .9rem; }
  .hero__cta:hover { color: #fff; filter: brightness(1.06); text-decoration: none; }
  .hero__proof { display: flex; flex-direction: column; gap: .55rem; padding: 1.25rem; border-radius: 1rem; background: #111a33; color: #f1f5ff; box-shadow: 0 15px 30px rgba(15,23,42,.12); }
  .proof-icon { font-size: 1.5rem; }
  .hero__proof strong { font-size: 1rem; line-height: 1.35; }
  .hero__proof > span:not(.proof-icon) { color: #bdc9e5; font-size: .85rem; line-height: 1.45; }
  .hero__proof small { margin-top: .35rem; color: #8fa1c7; font-size: .72rem; font-weight: 700; letter-spacing: .03em; }

  /* Botones */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    background: var(--accent);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: filter 0.15s, transform 0.15s;
    border: none;
    cursor: pointer;
  }
  .btn-primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
    text-decoration: none;
    color: #fff;
  }
  .btn-primary--large {
    font-size: 1.0625rem;
    padding: 0.875rem 2rem;
  }
  .btn-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    background: var(--bg-card);
    color: var(--text);
    border: 1px solid var(--border);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .btn-copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn-copy--success {
    border-color: var(--accent) !important;
    color: var(--accent) !important;
    background: var(--accent-subtle, #ecfdf5) !important;
  }
  :global([data-theme="dark"]) .btn-copy--success {
    background: rgba(52,211,153,0.1) !important;
  }

  /* SNIPPETS */
  .snips-intro {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-bottom: 1.75rem;
  }
  .snips-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .snip-card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    margin-bottom: 1.125rem;
  }
  .snip-card__emoji {
    font-size: 1.75rem;
    flex-shrink: 0;
    line-height: 1.2;
  }
  .snip-card__head h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
    color: var(--text);
  }
  .snip-card__intro {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .snip-preview {
    background: var(--bg-soft, var(--bg-muted));
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 0.875rem 1rem;
    margin-bottom: 1rem;
  }
  .snip-preview__label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-subtle);
    margin-bottom: 0.375rem;
  }
  .snip-rendered {
    font-size: 0.9375rem;
    color: var(--text);
    margin: 0;
    line-height: 1.55;
  }
  .snip-rendered :global(a) { color: var(--accent); }

  .code-block-wrapper {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
  }
  .code-block-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .code-block {
    margin: 0;
    padding: 1rem;
    background: var(--bg-code, #0f172a);
    color: #e2e8f0;
    font-family: 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }
  :global([data-theme="light"]) .code-block {
    background: #1e293b;
  }

  /* WHY */
  .why-section h2 { text-align: center; }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .why-icon { font-size: 1.75rem; margin-bottom: 0.75rem; display: block; }
  .why-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .why-card p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }
  .why-card code {
    font-size: 0.85em;
    background: var(--bg-muted);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }

  /* CTA */
  .cta-partners {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
  }
  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }
  .cta-icon { font-size: 2.5rem; margin-bottom: 1rem; display: block; }
  .cta-inner h2 { font-size: 1.5rem; margin-bottom: 0.875rem; }
  .cta-inner p {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .cta-inner strong { color: var(--text); }
  .cta-alt {
    font-size: 0.9375rem !important;
    margin-top: 1.25rem;
    margin-bottom: 0 !important;
  }
  .cta-alt a { color: var(--accent); }

  @media (min-width: 720px) {
    .snips-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; padding: 1.5rem; }
    .hero__proof { display: none; }
    .why-grid { grid-template-columns: 1fr; }
    .cta-partners { padding: 2rem 1.25rem; }
  }
</style>
