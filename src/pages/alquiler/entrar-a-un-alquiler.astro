---
/**
 * Hub de decisión — "¿Cuánta plata necesito para entrar a un alquiler?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/entrar-a-un-alquiler.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * Las constantes NO se inventan: salen de las fórmulas reales de
 * src/lib/formulas/ (comisión, caución, expensas por m², regla del 30%).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import EntrarAlquilerExperience from '../../components/generated/EntrarAlquilerExperience.astro';
import {
  hub,
  COMISION,
  IVA,
  CAUCION_TASA,
  EXPENSAS_M2_MEDIO,
  DEPOSITO_MESES,
  DEPOSITO_MESES_LEY_VIEJA,
} from '../../lib/hubs/entrar-a-un-alquiler';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const CONST = {
  COMISION,
  IVA,
  CAUCION_TASA,
  EXPENSAS_M2_MEDIO,
  DEPOSITO_MESES,
  DEPOSITO_MESES_LEY_VIEJA,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <EntrarAlquilerExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

