---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AlquilerExperience from '../../components/AlquilerExperience.astro';
import TopPagesBoost from '../../components/TopPagesBoost.astro';
import { hub, FRECUENCIA_MESES, CONTRATO_MESES } from '../../lib/hubs/aumento-de-alquiler';
import { ICL_FECHAS, ICL_VALORES, ICL_LAST_UPDATED } from '../../lib/formulas/_bcra-icl';
import ipcSerieData from '../../data/ipc-indec-serie.json';
import inflacionLive from '../../data/live/inflacion.json';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const IPC: Record<string, number> = {};
for (const row of (ipcSerieData as any).serie as Array<{ mes: string; pct: number }>) {
  if (row && typeof row.mes === 'string' && Number.isFinite(Number(row.pct))) IPC[row.mes] = Number(row.pct);
}
for (const row of ((inflacionLive as any).last_12_months as Array<{ fecha: string; valor: number }>) || []) {
  const key = String(row.fecha).slice(0, 7);
  if (/^\d{4}-\d{2}$/.test(key) && Number.isFinite(Number(row.valor))) IPC[key] = Number(row.valor);
}
const IPC_KEYS = Object.keys(IPC).sort();
const IPC_PCTS = IPC_KEYS.map((key) => IPC[key]);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'FAQPage', mainEntity: hub.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
      { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
      { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
    ] },
    { '@type': 'WebApplication', name: hub.title, url: CANONICAL, applicationCategory: 'FinanceApplication', operatingSystem: 'Web', dateModified: hub.lastReviewed, offers: { '@type': 'Offer', price: '0', priceCurrency: 'ARS' } },
  ],
};
import HubCitableStats from '../../components/hub/HubCitableStats.astro';
---

<Layout title={hub.title} description={hub.description} canonical={CANONICAL} schema={schema} audience={hub.audience} lang="es" ogType="article" articleSection={hub.silo}>
  <Header />
  <AlquilerExperience
    data={hub}
    icl={ICL_VALORES as number[]}
    iclStart={ICL_FECHAS[0]}
    iclLastUpdated={ICL_LAST_UPDATED}
    ipcKeys={IPC_KEYS}
    ipcPcts={IPC_PCTS}
    frecuencias={FRECUENCIA_MESES}
    contratos={CONTRATO_MESES}
  />
  <TopPagesBoost variant="rent" />
  <HubCitableStats data={hub} />
  <Footer />
</Layout>
