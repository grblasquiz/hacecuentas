---
/**
 * Hub de decisión — "¿A qué precio me liquidan y cuánto puedo arriesgar?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/liquidacion-apalancamiento.ts)
 * y su compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, CASE_SIDE } from '../../lib/hubs/liquidacion-apalancamiento';
import dolar from '../../data/live/dolar.json';

/**
 * Dólar cripto del día: es el tipo de cambio real de entrada y salida a las
 * stablecoins con las que se opera en estos mercados, así que es el que
 * corresponde para leer en pesos lo que se está arriesgando.
 */
const CRIPTO = Math.round(Number(dolar?.quotes?.cripto?.venta) || 0);
const CRIPTO_FECHA = (dolar?.quotes?.cripto?.fechaActualizacion || '').slice(0, 10);

/** Copia superficial: no mutamos el objeto del hub, sólo precargamos el campo. */
const data = {
  ...hub,
  fields: hub.fields.map((f) => (f.id === 'dolar' ? { ...f, value: CRIPTO.toLocaleString('es-AR') } : f)),
  stamps: hub.stamps.map((s) =>
    s === 'Dólar cripto del día' ? `Dólar cripto $${CRIPTO.toLocaleString('es-AR')}${CRIPTO_FECHA ? ' · ' + CRIPTO_FECHA : ''}` : s,
  ),
};

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={data} />
  <Footer />
</Layout>

<script is:inline define:vars={{ SIDE: CASE_SIDE }}>
  (function () {
    const H = window.HC_HUB;

    const usd = (n, d) => {
      const dec = d === undefined ? 2 : d;
      return 'US$' + n.toLocaleString('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec });
    };

    H.onCompute(function (v, kase) {
      const caso = kase?.id || 'long';

      const ent = Number(v.precioEntrada) || 0;
      const actual = Number(v.precioActual) || 0;
      const lev = Math.max(1, Number(v.leverage) || 1);
      const mm = Math.max(0, Number(v.mantenimiento) || 0) / 100;
      const nocional = Math.max(0, Number(v.tamanoPosicion) || 0);
      const capital = Math.max(0, Number(v.capital) || 0);
      const riesgoPct = Math.max(0, Number(v.riesgoPct) || 0);
      const stop = Number(v.precioStop) || 0;
      const stopPips = Math.max(0, Number(v.stopPips) || 0);
      const valorPip = Math.max(0, Number(v.valorPipLote) || 0);
      const funding = Number(v.fundingRate) || 0;
      const ladoFunding = String(v.direccionFunding || 'long');
      const tc = Math.max(0, Number(v.dolar) || 0);

      const lado = caso === 'funding' ? ladoFunding : SIDE[caso] || 'long';
      const esLong = lado === 'long';

      const vacio = (msg) => ({ total: '—', sub: msg, rows: [], chart: [], format: 'plain', decimals: 2 });
      if (!ent) return vacio('Cargá el precio de entrada para ver a qué precio te liquidan.');

      /**
       * Precio de liquidación con margen aislado, con el margen de mantenimiento
       * contemplado — misma fórmula que usaba la calculadora de perpetuos:
       *   long  = entrada × (1 − 1/lev + mm)
       *   short = entrada × (1 + 1/lev − mm)
       */
      const liq = Math.max(0, esLong ? ent * (1 - 1 / lev + mm) : ent * (1 + 1 / lev - mm));
      const distAbs = Math.abs(ent - liq);
      const distPct = (distAbs / ent) * 100;

      /** Escala: de la entrada a la liquidación, con el precio actual como marcador. */
      function escalaPrecio(precioRef) {
        const lo = Math.min(ent, liq);
        const hi = Math.max(ent, liq);
        const margen = (hi - lo) * 0.35 || 1;
        const desde = Math.max(0, lo - margen);
        const hasta = hi + margen;
        const span = hasta - desde || 1;
        const chart = esLong
          ? [
              { label: 'Zona de liquidación', value: liq - desde, tone: 'bad', from: Math.round(desde * 100) / 100, to: Math.round(liq * 100) / 100 },
              { label: 'Colchón que te queda', value: hasta - liq, tone: 'good', from: Math.round(liq * 100) / 100, to: Math.round(hasta * 100) / 100 },
            ]
          : [
              { label: 'Colchón que te queda', value: liq - desde, tone: 'good', from: Math.round(desde * 100) / 100, to: Math.round(liq * 100) / 100 },
              { label: 'Zona de liquidación', value: hasta - liq, tone: 'bad', from: Math.round(liq * 100) / 100, to: Math.round(hasta * 100) / 100 },
            ];
        const p = precioRef > 0 ? precioRef : ent;
        return { chart: chart, position: Math.min(100, Math.max(0, ((p - desde) / span) * 100)) };
      }

      const e = escalaPrecio(actual);
      const recorridoPct = actual > 0 && distAbs > 0 ? (Math.abs(actual - ent) / distAbs) * 100 : 0;
      const enContra = actual > 0 && (esLong ? actual < ent : actual > ent);
      const faltaHastaLiq = actual > 0 ? Math.abs(actual - liq) : distAbs;
      const faltaPct = actual > 0 ? (faltaHastaLiq / actual) * 100 : distPct;
      const etiquetaPos =
        actual > 0
          ? 'Precio hoy ' + usd(actual) + ' · liquidación ' + usd(liq) + ' · falta ' + faltaPct.toFixed(2) + '% ' + (esLong ? 'de caída' : 'de suba')
          : 'Liquidación ' + usd(liq) + ' a ' + distPct.toFixed(2) + '% de tu entrada';

      // ------------------------------------------- tamaño de posición en cripto
      if (caso === 'size-cripto') {
        if (!capital || !riesgoPct || !stop || stop === ent)
          return vacio('Cargá capital, riesgo por operación y un precio de stop distinto de la entrada.');
        // Espejo de position-size-cripto-leverage.ts: unidades = riesgo ÷ distancia al stop.
        const riesgo = capital * (riesgoPct / 100);
        const distStop = Math.abs(ent - stop);
        const unidades = riesgo / distStop;
        const tam = unidades * ent;
        const margen = tam / lev;
        const esLongTrade = ent > stop;
        const liqTrade = Math.max(0, esLongTrade ? ent * (1 - 1 / lev + mm) : ent * (1 + 1 / lev - mm));
        const liqAntes = esLongTrade ? liqTrade > stop : liqTrade < stop;
        const distStopPct = (distStop / ent) * 100;
        const escalaMax = Math.max(10, Math.ceil(riesgoPct) + 2);
        return {
          total: usd(tam, 2),
          sub:
            'Tamaño de posición que banca un riesgo de ' + usd(riesgo) + ' (' + riesgoPct + '% del capital) · ' +
            unidades.toFixed(6) + ' unidades con ' + usd(margen) + ' de margen · ' +
            (liqAntes ? 'ojo: la liquidación te queda antes que el stop' : 'la liquidación queda más lejos que tu stop'),
          rows: [
            { k: 'Tamaño de la posición', ref: 'unidades × precio de entrada', v: tam, format: 'plain', decimals: 2, extra: true },
            { k: 'Unidades a operar', v: unidades, format: 'plain', decimals: 6 },
            { k: 'Margen que inmoviliza', ref: 'tamaño ÷ ' + lev + 'x', v: margen, format: 'plain', decimals: 2 },
            { k: 'Plata que arriesgás', ref: riesgoPct + '% del capital', v: riesgo, format: 'plain', decimals: 2 },
            { k: 'Distancia hasta el stop', v: distStopPct, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Precio de liquidación', ref: 'margen aislado', v: liqTrade, format: 'plain', decimals: 2 },
            { k: 'Distancia hasta la liquidación', v: (Math.abs(ent - liqTrade) / ent) * 100, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Riesgo por operación', v: riesgoPct, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Plata que arriesgás en pesos', ref: 'al dólar cripto', v: riesgo * tc, format: 'ars' },
          ],
          chart: [
            { label: 'Conservador', value: 1, tone: 'good', from: 0, to: 1 },
            { label: 'Estándar', value: 1, tone: 'good', from: 1, to: 2 },
            { label: 'Agresivo', value: 3, tone: 'warn', from: 2, to: 5 },
            { label: 'Temerario', value: escalaMax - 5, tone: 'bad', from: 5, to: escalaMax },
          ],
          format: 'plain',
          decimals: 2,
          position: Math.min(100, Math.max(0, (riesgoPct / escalaMax) * 100)),
          positionLabel:
            'Arriesgás ' + riesgoPct.toFixed(2) + '% del capital por operación' +
            (liqAntes ? ' · la liquidación queda antes que el stop' : ''),
        };
      }

      // -------------------------------------------- tamaño de posición en forex
      if (caso === 'size-forex') {
        if (!capital || !riesgoPct || !stopPips || !valorPip)
          return vacio('Cargá capital, riesgo por operación, stop en pips y valor del pip.');
        // Espejo de position-size-forex-pips-riesgo.ts: lotes = riesgo ÷ (pips × valor del pip).
        const riesgo = capital * (riesgoPct / 100);
        const lotes = riesgo / (stopPips * valorPip);
        const escalaMax = Math.max(10, Math.ceil(riesgoPct) + 2);
        return {
          total: lotes.toLocaleString('es-AR', { minimumFractionDigits: 3, maximumFractionDigits: 3 }),
          sub:
            'Lotes estándar que corresponden a un riesgo de ' + usd(riesgo) + ' (' + riesgoPct + '% del capital) con un stop de ' +
            stopPips + ' pips',
          rows: [
            { k: 'Lotes estándar', ref: '100.000 unidades cada uno', v: lotes, format: 'plain', decimals: 3, extra: true },
            { k: 'Lotes mini', v: lotes * 10, format: 'plain', decimals: 2 },
            { k: 'Lotes micro', v: lotes * 100, format: 'plain', decimals: 1 },
            { k: 'Unidades de la divisa base', v: Math.round(lotes * 100000), format: 'plain' },
            { k: 'Pérdida máxima si salta el stop', v: riesgo, format: 'plain', decimals: 2 },
            { k: 'Cuánto vale cada pip con este lotaje', v: lotes * valorPip, format: 'plain', decimals: 2 },
            { k: 'Riesgo por operación', v: riesgoPct, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Pérdida máxima en pesos', ref: 'al dólar cripto', v: riesgo * tc, format: 'ars' },
          ],
          chart: [
            { label: 'Conservador', value: 1, tone: 'good', from: 0, to: 1 },
            { label: 'Estándar', value: 1, tone: 'good', from: 1, to: 2 },
            { label: 'Agresivo', value: 3, tone: 'warn', from: 2, to: 5 },
            { label: 'Temerario', value: escalaMax - 5, tone: 'bad', from: 5, to: escalaMax },
          ],
          format: 'plain',
          decimals: 3,
          position: Math.min(100, Math.max(0, (riesgoPct / escalaMax) * 100)),
          positionLabel: 'Arriesgás ' + riesgoPct.toFixed(2) + '% del capital · ' + lotes.toFixed(3) + ' lotes estándar',
        };
      }

      // ------------------------------------------------------------- funding
      if (caso === 'funding') {
        if (!nocional) return vacio('Cargá el tamaño de la posición para ver cuánto te come el funding.');
        // Espejo de perpetual-liquidation-funding: 3 períodos de 8 horas por día.
        const margenInicial = nocional / lev;
        const signo = esLong ? 1 : -1;
        const porPeriodo = signo * nocional * (funding / 100);
        const porDia = porPeriodo * 3;
        const porSemana = porDia * 7;
        const porMes = porDia * 30;
        const drena = porDia > 0 ? margenInicial / porDia : 0;
        const esCosto = porPeriodo > 0;
        return {
          total: usd(Math.abs(porDia), 2),
          sub:
            (esCosto ? 'Costo de funding por día' : 'Ingreso de funding por día') + ' sobre un nocional de ' + usd(nocional, 0) +
            ' · ' + (esCosto ? 'te drena el margen inicial en ' + drena.toFixed(0) + ' días si el precio no se mueve' : 'el funding juega a tu favor') +
            ' · liquidación en ' + usd(liq),
          rows: [
            { k: esCosto ? 'Funding que pagás por día' : 'Funding que cobrás por día', ref: '3 períodos de 8 horas', v: Math.abs(porDia), format: 'plain', decimals: 2, extra: true },
            { k: 'Funding por período de 8 horas', v: Math.abs(porPeriodo), format: 'plain', decimals: 4 },
            { k: 'Funding por semana', v: Math.abs(porSemana), format: 'plain', decimals: 2 },
            { k: 'Funding por mes', v: Math.abs(porMes), format: 'plain', decimals: 2 },
            { k: 'Margen inicial de la posición', ref: 'nocional ÷ ' + lev + 'x', v: margenInicial, format: 'plain', decimals: 2 },
            { k: 'Días hasta que el funding se coma el margen', v: esCosto ? drena : 0, format: 'unit', unit: 'días', decimals: 0 },
            { k: 'Precio de liquidación', ref: 'margen aislado', v: liq, format: 'plain', decimals: 2 },
            { k: 'Distancia hasta la liquidación', v: distPct, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Funding mensual en pesos', ref: 'al dólar cripto', v: Math.abs(porMes) * tc, format: 'ars' },
          ],
          chart: e.chart,
          format: 'plain',
          decimals: 2,
          position: e.position,
          positionLabel: etiquetaPos,
        };
      }

      // --------------------------------------------- long / short (por defecto)
      const margenInicial = nocional > 0 ? nocional / lev : 0;
      const perdidaEnLiq = margenInicial;
      const pnlActual = actual > 0 && nocional > 0 ? (esLong ? (actual - ent) / ent : (ent - actual) / ent) * nocional : 0;
      return {
        total: usd(liq),
        sub:
          'Precio de liquidación de un ' + (esLong ? 'long' : 'short') + ' ' + lev + 'x · te liquidan con ' +
          (esLong ? 'una caída' : 'una suba') + ' del ' + distPct.toFixed(2) + '% desde tu entrada' +
          (actual > 0 ? ' · el precio ya recorrió ' + (enContra ? recorridoPct.toFixed(0) + '% de ese camino' : '0% en contra') : ''),
        rows: [
          { k: 'Precio de liquidación', ref: 'margen aislado con mantenimiento', v: liq, format: 'plain', decimals: 2, extra: true },
          { k: 'Distancia hasta la liquidación', v: distPct, format: 'unit', unit: '%', decimals: 2 },
          { k: 'Distancia en dólares', v: distAbs, format: 'plain', decimals: 2 },
          { k: 'Precio de entrada', v: ent, format: 'plain', decimals: 2 },
          { k: 'Precio actual', v: actual, format: 'plain', decimals: 2 },
          { k: 'Falta ' + (esLong ? 'de caída' : 'de suba') + ' desde el precio de hoy', v: faltaPct, format: 'unit', unit: '%', decimals: 2 },
          { k: 'Margen inicial de la posición', ref: 'nocional ÷ ' + lev + 'x', v: margenInicial, format: 'plain', decimals: 2 },
          { k: 'Lo que perdés si te liquidan', ref: 'el margen entero', v: perdidaEnLiq, format: 'plain', decimals: 2 },
          { k: 'Resultado al precio de hoy', v: pnlActual, format: 'plain', decimals: 2 },
          { k: 'Margen inicial en pesos', ref: 'al dólar cripto', v: margenInicial * tc, format: 'ars' },
        ],
        chart: e.chart,
        format: 'plain',
        decimals: 2,
        position: e.position,
        positionLabel: etiquetaPos,
      };
    });
  })();
</script>
