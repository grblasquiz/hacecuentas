---
/**
 * Hub de decisión — "¿Cuánto vale un CEDEAR y cuánto rinde?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/cedears.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CedearsExperience from '../../components/generated/CedearsExperience.astro';
import { hub, PAGOS_POR_ANIO } from '../../lib/hubs/cedears';
import dolar from '../../data/live/dolar.json';

/**
 * Dólar CCL del día. Es el que corresponde para CEDEARs: el certificado nace de
 * operar títulos contra el exterior, que es justamente el mecanismo del CCL.
 */
const CCL = Math.round(Number(dolar?.quotes?.contadoconliqui?.venta) || 0);
const CCL_FECHA = (dolar?.quotes?.contadoconliqui?.fechaActualizacion || '').slice(0, 10);

/** Copia superficial: no mutamos el objeto del hub, sólo precargamos el campo. */
const data = {
  ...hub,
  fields: hub.fields.map((f) => (f.id === 'ccl' ? { ...f, value: CCL.toLocaleString('es-AR') } : f)),
  stamps: hub.stamps.map((s) =>
    s === 'Dólar CCL del día' ? `Dólar CCL $${CCL.toLocaleString('es-AR')}${CCL_FECHA ? ' · ' + CCL_FECHA : ''}` : s,
  ),
};

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CedearsExperience data={data} />
  <Footer />
</Layout>

<script is:inline define:vars={{ PAGOS: PAGOS_POR_ANIO }}>
  (function () {
    const H = window.HC_HUB;

    H.onCompute(function (v, kase) {
      const caso = kase?.id || 'teorico';
      const precioUsd = Number(v.precioUsd) || 0;
      const ratio = Math.max(1, Math.round(Number(v.ratio) || 1));
      const ccl = Number(v.ccl) || 0;
      const precioCedear = Number(v.precioCedear) || 0;
      const cantidad = Math.max(0, Number(v.cantidad) || 0);
      const divUsd = Number(v.dividendoUsd) || 0;
      const retencion = Math.min(100, Math.max(0, Number(v.retencion) || 0));
      const freq = String(v.frecuencia || 'trimestral');

      const vacio = {
        total: '—',
        sub: 'Completá el precio de la acción, el ratio y el CCL para ver el resultado.',
        rows: [],
        chart: [],
        format: 'plain',
        decimals: 2,
      };
      if (!precioUsd || !ccl) return vacio;

      // Espejo de cedear-conversion-ratio.ts: teórico = (USD / ratio) × CCL.
      const teorico = (precioUsd / ratio) * ccl;
      const cedearUsd = precioUsd / ratio;
      // Espejo de cedear-ratio-conversion-dolares.ts: implícito = (ARS × ratio) / USD.
      const implicito = precioCedear > 0 ? (precioCedear * ratio) / precioUsd : 0;
      const prima = precioCedear > 0 ? ((precioCedear - teorico) / teorico) * 100 : 0;
      const accionesEquiv = cantidad / ratio;
      const tenenciaUsd = accionesEquiv * precioUsd;
      const tenenciaArs = cantidad * (precioCedear > 0 ? precioCedear : teorico);

      // Espejo de cedear-dividend-yield-2026.ts: dividendo por CEDEAR = (USD / ratio) × TC.
      const divPorCedearBruto = (divUsd / ratio) * ccl;
      const divPorCedearNeto = divPorCedearBruto * (1 - retencion / 100);
      const baseYield = precioCedear > 0 ? precioCedear : teorico;
      const yieldCedearBruto = baseYield > 0 ? (divPorCedearBruto / baseYield) * 100 : 0;
      const yieldCedearNeto = baseYield > 0 ? (divPorCedearNeto / baseYield) * 100 : 0;
      const rentaAnualCedear = divPorCedearNeto * cantidad;

      // Espejo de dividendos-yield-anual.ts, pero sobre la acción en dólares.
      const yieldAccion = precioUsd > 0 ? (divUsd / precioUsd) * 100 : 0;
      const pagos = PAGOS[freq] || 4;
      const rentaAnualAccion = divUsd * accionesEquiv;
      const rentaMensualAccion = rentaAnualAccion / 12;
      const rentaPorPago = rentaAnualAccion / pagos;
      const inversionUsd = precioUsd * accionesEquiv;

      /** Escala de prima/descuento: banda de ±2% considerada alineada. */
      function escalaPrima(p) {
        const bound = Math.max(6, Math.ceil(Math.abs(p)) + 2);
        return {
          chart: [
            { label: 'Descuento', value: bound - 2, tone: 'good', from: -bound, to: -2 },
            { label: 'Alineado', value: 4, tone: 'warn', from: -2, to: 2 },
            { label: 'Prima', value: bound - 2, tone: 'bad', from: 2, to: bound },
          ],
          position: Math.min(100, Math.max(0, ((p + bound) / (2 * bound)) * 100)),
        };
      }

      /** Escala de dividend yield con las mismas franjas que la calculadora vieja. */
      function escalaYield(y) {
        return {
          chart: [
            { label: 'Bajo (growth)', value: 2, tone: 'warn', from: 0, to: 2 },
            { label: 'Moderado', value: 2, tone: 'good', from: 2, to: 4 },
            { label: 'Atractivo', value: 4, tone: 'good', from: 4, to: 8 },
            { label: 'Sospechosamente alto', value: 4, tone: 'bad', from: 8, to: 12 },
          ],
          position: Math.min(100, Math.max(0, (y / 12) * 100)),
        };
      }

      const filasComunes = [
        { k: 'Precio teórico del CEDEAR', ref: '(USD ÷ ratio) × CCL', v: teorico, format: 'ars' },
        { k: 'Valor en dólares de 1 CEDEAR', ref: '1/' + ratio + ' de acción', v: cedearUsd, format: 'plain', decimals: 4 },
      ];

      if (caso === 'dividendos-cedear') {
        const e = escalaYield(yieldCedearNeto);
        return {
          total: yieldCedearNeto.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%',
          sub:
            'Dividend yield neto sobre ' + H.ars(baseYield) + ' por CEDEAR · retención de origen ' + retencion + '%' +
            (cantidad > 0 ? ' · ' + cantidad + ' CEDEARs rinden ' + H.ars(rentaAnualCedear) + ' al año' : ''),
          rows: [
            { k: 'Dividendo bruto por CEDEAR (anual)', ref: '(USD ÷ ratio) × CCL', v: divPorCedearBruto, format: 'ars' },
            { k: 'Retención en el país de origen', ref: retencion + '%', v: divPorCedearBruto - divPorCedearNeto, format: 'ars' },
            { k: 'Dividendo neto por CEDEAR (anual)', v: divPorCedearNeto, format: 'ars', extra: true },
            { k: 'Renta anual de tu tenencia', ref: cantidad + ' CEDEARs', v: rentaAnualCedear, format: 'ars' },
            { k: 'Renta mensual promedio', v: rentaAnualCedear / 12, format: 'ars' },
            { k: 'Dividend yield bruto', v: yieldCedearBruto, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Dividend yield neto', v: yieldCedearNeto, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Capital inmovilizado', ref: 'a precio de mercado', v: tenenciaArs, format: 'ars' },
          ],
          chart: e.chart,
          format: 'unit',
          unit: '%',
          decimals: 2,
          position: e.position,
          positionLabel: 'Yield neto ' + yieldCedearNeto.toFixed(2) + '% (bruto ' + yieldCedearBruto.toFixed(2) + '%)',
        };
      }

      if (caso === 'dividendos-accion') {
        const e = escalaYield(yieldAccion);
        const zona =
          yieldAccion >= 8
            ? 'zona alta: revisá el payout antes de entrar'
            : yieldAccion >= 4
              ? 'zona atractiva, típica de valor o inmobiliario'
              : yieldAccion >= 2
                ? 'zona moderada, típica de una compañía madura'
                : 'zona baja, típica de crecimiento';
        return {
          total: yieldAccion.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%',
          sub: 'Dividend yield anual de la acción · ' + zona,
          rows: [
            { k: 'Dividend yield anual', ref: 'dividendo ÷ precio', v: yieldAccion, format: 'unit', unit: '%', decimals: 2, extra: true },
            { k: 'Acciones equivalentes a tu tenencia', ref: cantidad + ' CEDEARs ÷ ' + ratio, v: accionesEquiv, format: 'plain', decimals: 4 },
            { k: 'Renta anual en dólares', v: rentaAnualAccion, format: 'plain', decimals: 2 },
            { k: 'Renta mensual promedio en dólares', v: rentaMensualAccion, format: 'plain', decimals: 2 },
            { k: 'Cobro por pago (' + freq + ', ' + pagos + ' al año)', v: rentaPorPago, format: 'plain', decimals: 2 },
            { k: 'Capital invertido en dólares', v: inversionUsd, format: 'plain', decimals: 2 },
            { k: 'Renta anual equivalente en pesos', ref: 'al CCL', v: rentaAnualAccion * ccl, format: 'ars' },
          ],
          chart: e.chart,
          format: 'unit',
          unit: '%',
          decimals: 2,
          position: e.position,
          positionLabel: 'Yield ' + yieldAccion.toFixed(2) + '% — ' + zona,
        };
      }

      if (caso === 'equivalencia') {
        const e = escalaPrima(prima);
        return {
          total: ratio.toLocaleString('es-AR') + ' CEDEARs',
          sub:
            'equivalen a 1 acción · cada CEDEAR es ' + (1 / ratio).toFixed(4) + ' de acción' +
            (cantidad > 0 ? ' · tus ' + cantidad + ' CEDEARs son ' + accionesEquiv.toFixed(4) + ' acciones' : ''),
          rows: [
            { k: 'CEDEARs por acción entera', ref: 'ratio de conversión', v: ratio, format: 'plain', extra: true },
            { k: 'Fracción de acción por CEDEAR', v: 1 / ratio, format: 'plain', decimals: 4 },
            { k: 'Acciones equivalentes a tu tenencia', v: accionesEquiv, format: 'plain', decimals: 4 },
            { k: 'Valor de tu tenencia en dólares', v: tenenciaUsd, format: 'plain', decimals: 2 },
            { k: 'Valor de tu tenencia en pesos', ref: precioCedear > 0 ? 'a precio de mercado' : 'al teórico', v: tenenciaArs, format: 'ars' },
            filasComunes[0],
            filasComunes[1],
          ],
          chart: e.chart,
          format: 'plain',
          decimals: 2,
          position: e.position,
          positionLabel:
            precioCedear > 0
              ? 'Prima/descuento ' + (prima >= 0 ? '+' : '') + prima.toFixed(2) + '%'
              : 'Cargá el precio de mercado para ver la prima',
        };
      }

      if (caso === 'dolar-implicito') {
        const e = escalaPrima(prima);
        if (precioCedear <= 0) {
          return {
            total: '—',
            sub: 'Cargá el precio del CEDEAR en el mercado para saber a qué dólar estás comprando.',
            rows: filasComunes,
            chart: [],
            format: 'ars',
          };
        }
        const dif = ((implicito / ccl) - 1) * 100;
        return {
          total: H.ars(implicito),
          sub:
            'Dólar implícito de la operación · ' +
            (dif > 0.5
              ? Math.abs(dif).toFixed(2) + '% más caro que el CCL de referencia'
              : dif < -0.5
                ? Math.abs(dif).toFixed(2) + '% más barato que el CCL de referencia'
                : 'prácticamente en paridad con el CCL'),
          rows: [
            { k: 'Dólar implícito que estás pagando', ref: '(precio × ratio) ÷ USD', v: implicito, format: 'ars', extra: true },
            { k: 'Dólar CCL de referencia', v: ccl, format: 'ars' },
            { k: 'Diferencia contra el CCL', v: dif, format: 'unit', unit: '%', decimals: 2 },
            filasComunes[0],
            { k: 'Prima o descuento contra el teórico', v: prima, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Sobrecosto en pesos por CEDEAR', ref: 'mercado − teórico', v: precioCedear - teorico, format: 'ars' },
          ],
          chart: e.chart,
          format: 'ars',
          position: e.position,
          positionLabel: 'Implícito ' + H.ars(implicito) + ' vs CCL ' + H.ars(ccl),
        };
      }

      // Caso por defecto: precio teórico.
      const e = escalaPrima(prima);
      const lectura =
        precioCedear <= 0
          ? 'Cargá el precio de mercado para ver si cotiza con prima o descuento'
          : prima > 2
            ? 'cotiza con prima del ' + prima.toFixed(2) + '%: está caro contra su teórico'
            : prima < -2
              ? 'cotiza con descuento del ' + Math.abs(prima).toFixed(2) + '%: está barato contra su teórico'
              : 'está alineado con su teórico (dentro de ±2%)';
      return {
        total: H.ars(teorico),
        sub: 'Acción US$' + precioUsd + ' · ratio ' + ratio + ':1 · CCL ' + H.ars(ccl) + ' · ' + lectura,
        rows: [
          { k: 'Precio teórico del CEDEAR', ref: '(USD ÷ ratio) × CCL', v: teorico, format: 'ars', extra: true },
          { k: 'Precio de mercado', v: precioCedear, format: 'ars' },
          { k: 'Prima o descuento', v: prima, format: 'unit', unit: '%', decimals: 2 },
          { k: 'Diferencia en pesos por CEDEAR', v: precioCedear > 0 ? precioCedear - teorico : 0, format: 'ars' },
          { k: 'Valor en dólares de 1 CEDEAR', ref: '1/' + ratio + ' de acción', v: cedearUsd, format: 'plain', decimals: 4 },
          { k: 'Dólar implícito del mercado', v: implicito, format: 'ars' },
          { k: 'Valor de tu tenencia', ref: cantidad + ' CEDEARs', v: tenenciaArs, format: 'ars' },
        ],
        chart: precioCedear > 0 ? e.chart : [],
        format: 'ars',
        position: e.position,
        positionLabel:
          precioCedear > 0
            ? 'Prima/descuento ' + (prima >= 0 ? '+' : '') + prima.toFixed(2) + '%'
            : 'Sin precio de mercado cargado',
      };
    });
  })();
</script>
