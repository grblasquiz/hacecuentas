---
/**
 * Hub de decisión — "¿Cuánto vale un CEDEAR y cuánto rinde?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/cedears.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CedearsExperience from '../../components/generated/CedearsExperience.astro';
import { hub, PAGOS_POR_ANIO } from '../../lib/hubs/cedears';
import dolar from '../../data/live/dolar.json';

/**
 * Dólar CCL del día. Es el que corresponde para CEDEARs: el certificado nace de
 * operar títulos contra el exterior, que es justamente el mecanismo del CCL.
 */
const CCL = Math.round(Number(dolar?.quotes?.contadoconliqui?.venta) || 0);
const CCL_FECHA = (dolar?.quotes?.contadoconliqui?.fechaActualizacion || '').slice(0, 10);

/** Copia superficial: no mutamos el objeto del hub, sólo precargamos el campo. */
const data = {
  ...hub,
  fields: hub.fields.map((f) => (f.id === 'ccl' ? { ...f, value: CCL.toLocaleString('es-AR') } : f)),
  stamps: hub.stamps.map((s) =>
    s === 'Dólar CCL del día' ? `Dólar CCL $${CCL.toLocaleString('es-AR')}${CCL_FECHA ? ' · ' + CCL_FECHA : ''}` : s,
  ),
};

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CedearsExperience data={data} />
  <Footer />
</Layout>

