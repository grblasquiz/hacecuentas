---
/**
 * Hub de decisión — "¿Cuánto gané de verdad con mis cripto, después de comisiones?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/ganancia-con-cripto.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import GananciaCriptoExperience from '../../components/generated/GananciaCriptoExperience.astro';
import { hub, GAS_LIMITS, BLOQUES_POR_HALVING } from '../../lib/hubs/ganancia-con-cripto';
import dolar from '../../data/live/dolar.json';

/**
 * Dólar cripto del día: es el tipo de cambio al que efectivamente se entra y se
 * sale de stablecoins en el mercado local, así que es el que corresponde para
 * pasar a pesos un resultado en dólares de una operación en cripto.
 */
const CRIPTO = Math.round(Number(dolar?.quotes?.cripto?.venta) || 0);
const CRIPTO_FECHA = (dolar?.quotes?.cripto?.fechaActualizacion || '').slice(0, 10);

/** Copia superficial: no mutamos el objeto del hub, sólo precargamos el campo. */
const data = {
  ...hub,
  fields: hub.fields.map((f) => (f.id === 'dolar' ? { ...f, value: CRIPTO.toLocaleString('es-AR') } : f)),
  stamps: hub.stamps.map((s) =>
    s === 'Dólar cripto del día' ? `Dólar cripto $${CRIPTO.toLocaleString('es-AR')}${CRIPTO_FECHA ? ' · ' + CRIPTO_FECHA : ''}` : s,
  ),
};

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <GananciaCriptoExperience data={data} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

