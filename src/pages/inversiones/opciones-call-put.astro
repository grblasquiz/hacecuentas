---
/**
 * Hub de decisión — "¿Cuánto vale esta opción y desde qué precio gano?"
 * Reemplaza 2 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/opciones-call-put.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import OpcionesCallPutExperience from '../../components/generated/OpcionesCallPutExperience.astro';
import { hub, CASE_MATH } from '../../lib/hubs/opciones-call-put';
import tasas from '../../data/live/tasas.json';

/** Tasa libre de riesgo por defecto: plazo fijo 30 días (TNA) del BCRA. Dato vivo. */
const TASA_DEFECTO = Number(tasas?.plazo_fijo_30d?.valor) || 0;
const TASA_FECHA = tasas?.plazo_fijo_30d?.fecha || '';

/** Copia superficial: no mutamos el objeto del hub, sólo precargamos el campo. */
const data = {
  ...hub,
  fields: hub.fields.map((f) => (f.id === 'tasa' ? { ...f, value: TASA_DEFECTO } : f)),
  stamps: hub.stamps.map((s) =>
    s.startsWith('Tasa de referencia') ? `Tasa libre de riesgo ${TASA_DEFECTO}% (BCRA${TASA_FECHA ? ' · ' + TASA_FECHA : ''})` : s,
  ),
};

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <OpcionesCallPutExperience data={data} />
  <Footer />
</Layout>

