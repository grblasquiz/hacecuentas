---
/**
 * Hub de decisión — "¿Cuánto crece mi plata con interés compuesto?"
 * Reemplaza 13 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: la rama activa llega como segundo argumento de
 * compute().
 *
 * OJO CON EL FORMATO: el resultado base es 'ars' porque la mayoría de las
 * filas son plata, pero las tasas van en % y los plazos en años. Toda fila que
 * no sea plata declara su propio `format` + `unit`; el runtime hace
 * Object.assign y sin eso caería a pesos.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import InteresCompuestoExperience from '../../components/generated/InteresCompuestoExperience.astro';
import { hub, TASAS } from '../../lib/hubs/interes-compuesto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <InteresCompuestoExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

