---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const mods = import.meta.glob<any>('../../../content/blog-pt/*.json', { eager: true });
const posts = Object.values(mods)
  .map((m: any) => m.default || m)
  .sort((a: any, b: any) => (b.updatedDate || b.date || '').localeCompare(a.updatedDate || a.date || ''));

function fmt(iso: string): string {
  return new Date(iso + 'T00:00:00Z').toLocaleDateString('pt-BR',
    { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
}
const siteUrl = 'https://hacecuentas.com';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Blog — Hacé Cuentas (Brasil)',
  url: `${siteUrl}/pt/blog`,
  inLanguage: 'pt-BR',
};
---

<Layout
  title="Blog — finanças e impostos no Brasil | Hacé Cuentas"
  description="Notícias e guias de finanças, impostos e direitos trabalhistas no Brasil: IPCA, salário, 13º, FGTS e mais."
  canonical="/pt/blog"
  schema={schema}
  lang="pt"
  audience="BR"
  noindex={false}
  domain="knowledge"
>
  <Header slot="header" />
  <div class="wrap">
    <h1>Blog</h1>
    <p class="sub">Finanças, impostos e direitos trabalhistas no Brasil — com dados oficiais atualizados.</p>
    {posts.length === 0 ? (
      <p>Em breve.</p>
    ) : (
      <div class="grid">
        {posts.map((p: any) => (
          <a class="card" href={`/pt/blog/${p.slug}`}>
            <span class="emoji" aria-hidden="true">{p.heroEmoji || '📝'}</span>
            <span class="card-title">{p.ogTitle || p.h1 || p.title}</span>
            {p.description && <span class="card-desc">{p.description.slice(0, 120)}{p.description.length > 120 ? '…' : ''}</span>}
            {(p.date || p.updatedDate) && <time class="card-date">{fmt(p.updatedDate || p.date)}</time>}
          </a>
        ))}
      </div>
    )}
  </div>
  <Footer slot="footer" />
</Layout>

<style>
  .wrap { max-width: 760px; margin: 0 auto; padding: 2rem 1rem 4rem; }
  h1 { font-size: clamp(1.75rem, 5vw, 2.25rem); font-weight: 800; margin: 0 0 0.5rem; color: var(--text); }
  .sub { color: var(--text-muted); font-size: 1.0625rem; margin: 0 0 2rem; }
  .grid { display: grid; grid-template-columns: 1fr; gap: 0.875rem; }
  @media (min-width: 600px) { .grid { grid-template-columns: 1fr 1fr; } }
  .card { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.25rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: var(--text); transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s; }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .emoji { font-size: 1.75rem; }
  .card-title { font-weight: 700; font-size: 1.0625rem; line-height: 1.3; }
  .card-desc { font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; }
  .card-date { font-size: 0.75rem; color: var(--text-subtle); margin-top: 0.25rem; }
</style>
