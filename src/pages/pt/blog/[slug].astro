  .bp-fact__value { font-size: 0.9375rem; font-weight: 700; color: var(--text); line-height: 1.3; }
  .bp-answer__cta { flex-shrink: 0; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.7rem 1.15rem; border-radius: var(--radius); background: linear-gradient(135deg, var(--accent), var(--accent-hover)); color: #fff; font-size: 0.875rem; font-weight: 700; text-decoration: none; box-shadow: var(--shadow-accent); transition: transform 0.15s, filter 0.15s; }
