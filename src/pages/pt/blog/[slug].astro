  .bp-sources { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .bp-sources__title { font-size: 1.35rem; font-weight: 800; color: var(--text); margin: 0.4rem 0 0.5rem; letter-spacing: -0.01em; }
  .bp-sources__desc { font-size: 0.875rem; color: var(--text-muted); line-height: 1.55; margin: 0 0 1.1rem; }
  .bp-sources__list { display: flex; flex-direction: column; gap: 0.5rem; }
  .bp-source { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.8rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); text-decoration: none; color: var(--text); transition: border-color 0.15s, background 0.15s; }
  .bp-source:hover { border-color: var(--accent); background: var(--accent-soft); }
  .bp-source__title { font-size: 0.875rem; font-weight: 600; }
  .bp-source__ico { flex-shrink: 0; color: var(--text-subtle); }
  .bp-source:hover .bp-source__ico { color: var(--accent); }

  .bp-faq { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .bp-faq__title { font-size: 1.35rem; font-weight: 800; color: var(--text); margin: 0 0 1.25rem; letter-spacing: -0.01em; }
  .bp-faq__list { display: flex; flex-direction: column; gap: 0.5rem; }
  .bp-faq__item { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .bp-faq__item[open] { border-color: var(--accent); }
  .bp-faq__q { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 1rem 1.125rem; cursor: pointer; list-style: none; font-weight: 600; font-size: 0.9375rem; color: var(--text); line-height: 1.4; }
  .bp-faq__q::-webkit-details-marker { display: none; }
  .bp-faq__chev { flex-shrink: 0; color: var(--text-subtle); transition: transform 0.2s; }
  .bp-faq__item[open] .bp-faq__chev { transform: rotate(180deg); color: var(--accent); }
  .bp-faq__a { padding: 0 1.125rem 1rem; font-size: 0.9375rem; color: var(--text-muted); line-height: 1.65; border-top: 1px solid var(--border); padding-top: 0.875rem; }

  .bp-related { margin-top: 3.5rem; }
  .bp-related__title { font-size: 1.5rem; font-weight: 800; color: var(--text); margin: 0.4rem 0 1.25rem; letter-spacing: -0.015em; }
  .bp-related__grid { display: grid; grid-template-columns: 1fr; gap: 0.85rem; }
  @media (min-width: 640px) { .bp-related__grid { grid-template-columns: repeat(3, 1fr); } }
  .bp-calc-card { display: flex; flex-direction: column; align-items: flex-start; padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-card); text-decoration: none; color: var(--text); transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s; }
  .bp-calc-card:hover { transform: translateY(-2px); border-color: var(--accent); box-shadow: var(--shadow-md); }
  .bp-calc-card__icon { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 11px; margin-bottom: 0.85rem; background: var(--accent-soft); font-size: 1.3rem; }
  .bp-calc-card__title { font-size: 0.9375rem; font-weight: 700; line-height: 1.3; color: var(--text); margin-bottom: 0.35rem; }
  .bp-calc-card__desc { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 0.9rem; }
  .bp-calc-card__link { margin-top: auto; font-size: 0.8125rem; font-weight: 700; color: var(--accent); display: inline-flex; gap: 0.3rem; align-items: center; }

  .bp-news { margin-top: 3.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 2rem; padding: 1.75rem 2rem; border-radius: var(--radius-xl); background: linear-gradient(120deg, #1b1830 0%, #241a3d 100%); border: 1px solid rgba(168, 85, 247, 0.18); }
  .bp-news__title { margin: 0 0 0.3rem; font-size: clamp(1.15rem, 2.4vw, 1.4rem); font-weight: 800; color: #fff; letter-spacing: -0.01em; line-height: 1.2; }
  .bp-news__sub { margin: 0; font-size: 0.9rem; color: rgba(255, 255, 255, 0.62); line-height: 1.5; }
  .bp-news__form { display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 280px; max-width: 440px; }
  .bp-news__form input[type="email"] { flex: 1; min-width: 0; padding: 0.75rem 0.95rem; border-radius: var(--radius); border: 1px solid rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.07); color: #fff; font-family: inherit; font-size: 0.9rem; }
