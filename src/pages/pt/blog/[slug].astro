  /* ═══ PROSE ═══ */
  .prose { font-size: 1.0625rem; line-height: 1.75; color: var(--text); }
  .prose :global(p) { margin: 0 0 1.25rem; }
  .prose :global(h2) { font-size: clamp(1.375rem, 2.6vw, 1.6rem); font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; color: var(--text); margin: 2.75rem 0 1rem; scroll-margin-top: 5rem; }
  .prose :global(h3) { font-size: 1.1875rem; font-weight: 700; line-height: 1.3; color: var(--text); margin: 2rem 0 0.75rem; scroll-margin-top: 5rem; }
  .prose :global(h4) { font-size: 1rem; font-weight: 700; color: var(--text); margin: 1.5rem 0 0.5rem; }
