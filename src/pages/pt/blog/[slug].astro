  .prose :global(blockquote) { margin: 1.5rem 0; padding: 1rem 1.25rem; border-left: 4px solid var(--accent); background: var(--accent-soft); border-radius: 0 var(--radius) var(--radius) 0; color: var(--text-muted); font-style: italic; }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.875em; background: var(--bg-muted); border: 1px solid var(--border); border-radius: 4px; padding: 0.125em 0.375em; color: var(--text); }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--border); margin: 1.5rem 0; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }

  .prose :global(table) { width: 100%; border-collapse: separate; border-spacing: 0; margin: 1.75rem 0; font-size: 0.9375rem; display: block; overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .prose :global(thead) { background: var(--accent-soft); }
  .prose :global(th) { font-weight: 700; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.75rem 0.9rem; text-align: left; color: var(--accent); white-space: nowrap; border-bottom: 1px solid var(--border); }
  .prose :global(td) { padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--border); vertical-align: top; }
