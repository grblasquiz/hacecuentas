  .bp-answer__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem 1.75rem; flex: 1; min-width: 0; }
  .bp-fact { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
