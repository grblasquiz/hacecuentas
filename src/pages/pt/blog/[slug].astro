---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PreferredSourceCta from '../../../components/PreferredSourceCta.astro';

export async function getStaticPaths() {
  const posts = import.meta.glob<any>('../../../content/blog-pt/*.json', { eager: true });
  return Object.values(posts).map((mod: any) => {
    const p = mod.default || mod;
    return { params: { slug: p.slug }, props: { post: p } };
  });
}

const { post } = Astro.props;
const siteUrl = 'https://hacecuentas.com';
const url = `${siteUrl}/pt/blog/${post.slug}`;
const ogImage = (post.heroImage as string)?.trim() || `/og/blog-pt-${post.slug}.jpg`;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// ─── Related calcs (PT) ───────────────────────────────────────────────────────
const calcModules = import.meta.glob<any>('../../../content/calcs-pt/*.json', { eager: true });
const calcBySlug = new Map(
  Object.values(calcModules).map((m: any) => { const c = m.default || m; return [c.slug, c]; })
);
const relatedCalcs = (post.relatedCalcs || []).map((s: string) => calcBySlug.get(s)).filter(Boolean);

// ─── Category labels (PT) ─────────────────────────────────────────────────────
const categoryLabels: Record<string, string> = {
  finanzas: 'Finanças', financas: 'Finanças', economia: 'Economia', fiscal: 'Impostos',
  negocios: 'Negócios', negocio: 'Negócios', salud: 'Saúde', saude: 'Saúde',
  marketing: 'Marketing', deportes: 'Esportes', esportes: 'Esportes', viajes: 'Viagens',
  vida: 'Dia a dia', hogar: 'Casa', mascotas: 'Pets', matematica: 'Matemática',
  construccion: 'Construção', cocina: 'Cozinha', educacion: 'Educação',
};
const categoryLabel = categoryLabels[post.category] || post.category || 'Blog';

// ─── Fechas ───────────────────────────────────────────────────────────────────
function formatDate(iso: string): string {
  return new Date(iso + 'T00:00:00Z').toLocaleDateString('pt-BR',
    { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
}
const dateFormatted = formatDate(post.date);
const dateISO = new Date(post.date + 'T00:00:00Z').toISOString();
const modISO = post.updatedDate ? new Date(post.updatedDate + 'T00:00:00Z').toISOString() : dateISO;
const reviewedFormatted = formatDate(post.updatedDate || post.lastReviewed || post.date);

// ─── Autor (E-E-A-T: persona real) ────────────────────────────────────────────
const rawAuthor = (post.author || '').trim();
const displayAuthor = (!rawAuthor || /hac[eé] cuentas|equipo|equipe/i.test(rawAuthor))
  ? 'Martín Rodríguez'
  : rawAuthor;
const authorInitials = displayAuthor.split(/\s+/).map((w: string) => w[0]).filter(Boolean).slice(0, 2).join('').toUpperCase();

// ─── TOC ──────────────────────────────────────────────────────────────────────
interface TocItem { id: string; text: string }
function buildToc(html: string): TocItem[] {
  const toc: TocItem[] = [];
  const re = /<h2[^>]*>(.*?)<\/h2>/gi; let m: RegExpExecArray | null;
  while ((m = re.exec(html)) !== null) {
    const text = m[1].replace(/<[^>]+>/g, '').trim();
    const id = text.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').slice(0, 80);
    toc.push({ id, text });
  }
  return toc;
}
function injectIds(html: string, toc: TocItem[]): string {
  let i = 0;
  return html.replace(/<h2([^>]*)>/gi, (_m: string, a: string) =>
    /\bid=/.test(a) || !toc[i] ? `<h2${a}>` : `<h2${a} id="${toc[i++].id}">`);
}
const autoToc = buildToc(post.content || '');
const contentWithIds = injectIds(post.content || '', autoToc);
const tocItems: TocItem[] = (post.tableOfContents && post.tableOfContents.length)
  ? post.tableOfContents.map((t: any) => ({ id: t.anchor, text: t.title }))
  : autoToc;

// ─── Datos de marca ───────────────────────────────────────────────────────────
const isNews = /^(inflacao|ipca|informe|finde|feriado|13|imposto|noticias)/i.test(post.slug);
const kickerStatus = isNews ? 'Informe' : 'Guia atualizado';
const keyFacts: Array<{ label: string; value: string }> = post.keyFacts || [];
const keyTakeaways: string[] = post.keyTakeaways || [];
const sources: Array<{ title: string; url: string }> = post.sources || [];
const verified = sources.length > 0;

const primaryCalc: any = relatedCalcs[0];
const cleanCalcName = (c: any) => String(c?.h1 || c?.title || '').split('|')[0].trim();
const calcCta = {
  eyebrow: post.calcCta?.eyebrow || 'Calculadora recomendada',
  title: post.calcCta?.title || (primaryCalc ? cleanCalcName(primaryCalc) : ''),
  desc: post.calcCta?.desc || (primaryCalc?.description ? String(primaryCalc.description).split('|')[0].trim().slice(0, 150) : ''),
  label: post.calcCta?.label || 'Usar a calculadora',
};
const sidebarCta = {
  title: post.sidebarCta?.title || 'Precisa do número exato?',
  desc: post.sidebarCta?.desc || 'Faça o cálculo grátis com os seus dados.',
  label: post.sidebarCta?.label || 'Calcular agora',
};
const answerCtaLabel = post.answerCtaLabel || 'Ir para a calculadora';

const summaryHtml = keyTakeaways.length
  ? `<aside class="hc-summary" role="note">`
    + `<div class="hc-summary__head"><span class="hc-summary__icon" aria-hidden="true">+</span>`
    + `<span class="hc-summary__title">O essencial, em 30 segundos</span></div>`
    + `<ul class="hc-summary__list">` + keyTakeaways.map((t) => `<li>${t}</li>`).join('') + `</ul></aside>`
  : '';
const calcCardHtml = primaryCalc
  ? `<aside class="hc-calc-cta"><div class="hc-calc-cta__body">`
    + `<span class="hc-calc-cta__eyebrow">${calcCta.eyebrow}</span>`
    + `<span class="hc-calc-cta__title">${calcCta.title}</span>`
    + (calcCta.desc ? `<span class="hc-calc-cta__desc">${calcCta.desc}</span>` : '')
    + `<a class="hc-calc-cta__btn" href="/pt/${primaryCalc.slug}">${calcCta.label} <span aria-hidden="true">→</span></a>`
    + `</div><span class="hc-calc-cta__glyph" aria-hidden="true">${primaryCalc.icon || '🧮'}</span></aside>`
  : '';

let bodyHtml = contentWithIds;
{
  const h2Pos = bodyHtml.search(/<h2/i);
  const firstPEnd = bodyHtml.indexOf('</p>');
  const inserts: Array<{ pos: number; html: string }> = [];
  if (summaryHtml && firstPEnd !== -1 && (h2Pos === -1 || firstPEnd < h2Pos)) inserts.push({ pos: firstPEnd + 4, html: summaryHtml });
  if (calcCardHtml) inserts.push({ pos: h2Pos !== -1 ? h2Pos : bodyHtml.length, html: calcCardHtml });
  inserts.sort((a, b) => b.pos - a.pos).forEach((ins) => { bodyHtml = bodyHtml.slice(0, ins.pos) + ins.html + bodyHtml.slice(ins.pos); });
}

// ─── Schema ───────────────────────────────────────────────────────────────────
const articleSchema: any = {
  '@context': 'https://schema.org',
  '@type': isNews ? 'NewsArticle' : 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: dateISO,
  dateModified: modISO,
  author: displayAuthor === 'Martín Rodríguez'
    ? { '@type': 'Person', '@id': `${siteUrl}/autores/martin-rodriguez#person`, name: 'Martín Rodríguez', url: `${siteUrl}/autores/martin-rodriguez` }
    : { '@type': 'Person', name: displayAuthor, url: siteUrl },
  publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: siteUrl, logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: [ogImageAbs],
  inLanguage: 'pt-BR',
  keywords: (post.seoKeywords || []).join(', '),
  articleBody: post.content?.replace(/<[^>]+>/g, '').slice(0, 3000),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${siteUrl}/pt` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/pt/blog` },
    { '@type': 'ListItem', position: 3, name: post.title, item: url },
  ],
};
const faqSchema = post.faq?.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: post.faq.map((f: { q: string; a: string }) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;
const pageSchema = { '@context': 'https://schema.org', '@graph': [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])] };

const showToc = tocItems.length >= 3;
const showSidebar = showToc || !!primaryCalc;
const isYmyl = ['finanzas', 'financas', 'negocios', 'salud', 'saude'].includes(post.category);
---

<Layout
  title={post.title}
  description={post.description}
  canonical={`/pt/blog/${post.slug}`}
  schema={pageSchema}
  image={ogImage}
  ogTitle={post.ogTitle}
  lang="pt"
  audience="BR"
  ogType="article"
  articleAuthor={displayAuthor}
  articleSection={categoryLabel}
  articlePublishedTime={dateISO}
  articleModifiedTime={modISO}
  newsKeywords={isNews ? (post.seoKeywords || []) : undefined}
  noindex={false}
  domain="knowledge"
>
  <Header slot="header" />

  <div class="bp">

    <nav class="bp-crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/pt">Início</a></li>
        <li aria-hidden="true" class="sep">›</li>
        <li><a href="/pt/blog">Blog</a></li>
        <li aria-hidden="true" class="sep">›</li>
        <li aria-current="page">{categoryLabel}</li>
      </ol>
    </nav>

    <header class="bp-hero">
      <p class="bp-kicker">
        <span class="bp-kicker__cat">{categoryLabel}</span>
        <span class="bp-kicker__dot" aria-hidden="true">·</span>
        <span class="bp-kicker__status">{kickerStatus}</span>
      </p>
      <h1 class="bp-title">{post.h1 || String(post.title).split('|')[0].trim()}</h1>
      <p class="bp-sub">{post.lead || post.description}</p>
      <div class="bp-byline">
        <span class="bp-avatar" aria-hidden="true">{authorInitials}</span>
        <div class="bp-byline__text">
          {displayAuthor === 'Martín Rodríguez' ? (
            <a href="/autores/martin-rodriguez" rel="author" class="bp-byline__author">{displayAuthor}</a>
          ) : (
            <span class="bp-byline__author">{displayAuthor}</span>
          )}
          <div class="bp-byline__meta">
            <time datetime={dateISO}>{dateFormatted}</time>
            <span class="bp-byline__dot" aria-hidden="true">·</span>
            <span>{post.readingTime || 4} min</span>
            {verified && (
              <>
                <span class="bp-byline__dot" aria-hidden="true">·</span>
                <span class="bp-verified">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Verificado com fontes oficiais
                </span>
              </>
            )}
          </div>
        </div>
      </div>
    </header>

    {keyFacts.length > 0 && (
      <div class="bp-answer">
        <div class="bp-answer__facts">
          {keyFacts.map((f) => (
            <div class="bp-fact">
              <span class="bp-fact__label">{f.label}</span>
              <span class="bp-fact__value">{f.value}</span>
            </div>
          ))}
        </div>
        {primaryCalc && (
          <a class="bp-answer__cta" href={`/pt/${primaryCalc.slug}`}>{answerCtaLabel} <span aria-hidden="true">→</span></a>
        )}
      </div>
    )}

    <div class={`bp-grid${showSidebar ? '' : ' bp-grid--full'}`}>

      <article class="bp-main">

        {showToc && (
          <nav class="bp-toc-mobile" aria-label="Índice">
            <details>
              <summary>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                Neste artigo
              </summary>
              <ol class="bp-toc__list">
                {tocItems.map((item) => (<li><a href={`#${item.id}`}>{item.text}</a></li>))}
              </ol>
            </details>
          </nav>
        )}

        {isYmyl && (
          <aside class="bp-disclaimer" role="note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <p><strong>Informação educativa, não é assessoria profissional.</strong> Conteúdo jornalístico baseado em fontes públicas oficiais. Para decisões importantes, consulte um {['salud', 'saude'].includes(post.category) ? 'profissional de saúde' : 'contador ou assessor financeiro'}.</p>
          </aside>
        )}

        <div class="bp-body prose" set:html={bodyHtml} />

        {sources.length > 0 && (
          <section class="bp-sources">
            <p class="bp-eyebrow">Transparência editorial</p>
            <h2 class="bp-sources__title">Fontes oficiais</h2>
            <p class="bp-sources__desc">Última revisão editorial: {reviewedFormatted}. Contrastamos valores e procedimento com documentação pública.</p>
            <div class="bp-sources__list">
              {sources.map((s) => (
                <a class="bp-source" href={s.url} target="_blank" rel="noopener nofollow">
                  <span class="bp-source__title">{s.title}</span>
                  <svg class="bp-source__ico" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              ))}
            </div>
          </section>
        )}

        {post.faq?.length > 0 && (
          <section class="bp-faq">
            <h2 class="bp-faq__title">Perguntas frequentes</h2>
            <div class="bp-faq__list">
              {post.faq.map((f: { q: string; a: string }, i: number) => (
                <details class="bp-faq__item" open={i === 0}>
                  <summary class="bp-faq__q">
                    <span>{f.q}</span>
                    <svg class="bp-faq__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                  </summary>
                  <div class="bp-faq__a">{f.a}</div>
                </details>
              ))}
            </div>
          </section>
        )}

        <PreferredSourceCta lang="pt" />

      </article>

      {showSidebar && (
        <aside class="bp-side" aria-label="Recursos do artigo">
          <div class="bp-side__sticky">
            {showToc && (
              <nav class="bp-toc" aria-label="Índice">
                <div class="bp-toc__head">
                  <span class="bp-eyebrow">Neste artigo</span>
                  <span class="bp-toc__pct" aria-hidden="true">0%</span>
                </div>
                <ol class="bp-toc__list">
                  {tocItems.map((item) => (<li><a href={`#${item.id}`}>{item.text}</a></li>))}
                </ol>
              </nav>
            )}
            {primaryCalc && (
              <div class="bp-side-cta">
                <p class="bp-side-cta__title">{sidebarCta.title}</p>
                <p class="bp-side-cta__desc">{sidebarCta.desc}</p>
                <a class="bp-side-cta__btn" href={`/pt/${primaryCalc.slug}`}>{sidebarCta.label} <span aria-hidden="true">→</span></a>
                <p class="bp-side-cta__note">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Conteúdo revisado e atualizado com informação oficial
                </p>
              </div>
            )}
          </div>
        </aside>
      )}

    </div><!-- /bp-grid -->

    {relatedCalcs.length > 0 && (
      <section class="bp-related">
        <p class="bp-eyebrow">Continue fazendo contas</p>
        <h2 class="bp-related__title">Calculadoras relacionadas</h2>
        <div class="bp-related__grid">
          {relatedCalcs.slice(0, 3).map((calc: any) => (
            <a href={`/pt/${calc.slug}`} class="bp-calc-card">
              <span class="bp-calc-card__icon" aria-hidden="true">{calc.icon || '🧮'}</span>
              <span class="bp-calc-card__title">{cleanCalcName(calc)}</span>
              {calc.description && (
                <span class="bp-calc-card__desc">{String(calc.description).split('|')[0].trim().slice(0, 90)}</span>
              )}
              <span class="bp-calc-card__link">Calcular agora <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="bp-news" data-nosnippet aria-labelledby="bp-news-title">
      <div class="bp-news__text">
        <h2 id="bp-news-title" class="bp-news__title">Quando um número-chave mudar, a gente te avisa.</h2>
        <p class="bp-news__sub">Impostos, dólar, salários e vencimentos. Dois minutos, zero spam.</p>
      </div>
      <form class="bp-news__form" id="bp-news-form" novalidate>
        <label class="bp-sr" for="bp-news-email">Seu e-mail</label>
        <input type="email" id="bp-news-email" name="email" placeholder="seu@email.com" required autocomplete="email" aria-describedby="bp-news-msg" />
        <button type="submit" class="bp-news__btn">Quero receber</button>
        <p class="bp-news__msg" id="bp-news-msg" role="status" aria-live="polite" hidden></p>
      </form>
    </section>

  </div>

  <Footer slot="footer" />
</Layout>

<script>
  (function () {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.bp-toc a, .bp-toc-mobile a');
    const headings = Array.from(document.querySelectorAll<HTMLElement>('.bp-body h2[id]'));
    const pct = document.querySelector<HTMLElement>('.bp-toc__pct');
    const main = document.querySelector<HTMLElement>('.bp-main');

    if (tocLinks.length && headings.length) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${id}`));
            break;
          }
        }
      }, { rootMargin: '0px 0px -70% 0px', threshold: 0 });
      headings.forEach((h) => observer.observe(h));
    }

    if (pct && main) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = main.getBoundingClientRect();
        const vh = window.innerHeight;
        const total = rect.height - vh;
        const scrolled = -rect.top;
        const p = total > 0 ? Math.min(100, Math.max(0, Math.round((scrolled / total) * 100))) : (rect.top < vh ? 100 : 0);
        pct.textContent = p + '%';
      };
      window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    }
  })();

  (window.requestIdleCallback || function (fn: any) { return setTimeout(fn, 1); })(function () {
    const form = document.getElementById('bp-news-form') as HTMLFormElement | null;
    const msg = document.getElementById('bp-news-msg') as HTMLElement | null;
    if (!form || !msg) return;
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const input = form.querySelector('input[type="email"]') as HTMLInputElement | null;
      const email = input ? input.value.trim() : '';
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (!email || !/^[^@]+@[^@]+\.[^@]+$/.test(email)) {
        msg.hidden = false; msg.textContent = 'Digite um e-mail válido.'; msg.className = 'bp-news__msg bp-news__msg--err';
        return;
      }
      if (btn) btn.disabled = true;
      msg.hidden = false; msg.textContent = 'Salvando…'; msg.className = 'bp-news__msg';
      try {
        const res = await fetch('/api/newsletter', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email, source: 'blog-pt' }) });
        if (res.ok) {
          msg.textContent = 'Pronto! Você está inscrito.'; msg.className = 'bp-news__msg bp-news__msg--ok';
          if (input) input.value = '';
          if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'newsletter_signup', { method: 'blog-pt' });
        } else {
          const j = await res.json().catch(() => ({}));
          msg.textContent = j.error || 'Não foi possível salvar, tente mais tarde.'; msg.className = 'bp-news__msg bp-news__msg--err';
        }
      } catch (err) {
        msg.textContent = 'Erro de rede. Verifique sua conexão.'; msg.className = 'bp-news__msg bp-news__msg--err';
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  });
</script>

<style>
  /* ═══ Blog post PT — mesmo design do mockup (violeta = domínio "knowledge") ═══ */
  .bp { max-width: 1080px; margin: 0 auto; padding: 1.25rem 1.15rem 4rem; }
  .bp-eyebrow { display: inline-block; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--accent); }

  .bp-crumb ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.4rem; list-style: none; margin: 0; padding: 0; font-size: 0.8125rem; color: var(--text-subtle); }
  .bp-crumb a { color: var(--text-subtle); text-decoration: none; }
  .bp-crumb a:hover { color: var(--accent); }
  .bp-crumb .sep { color: var(--border-strong); }
  .bp-crumb [aria-current="page"] { color: var(--text-muted); }

  .bp-hero { margin: 1.5rem 0 0; max-width: 820px; }
  .bp-kicker { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.9rem; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; }
  .bp-kicker__cat { color: var(--accent); }
  .bp-kicker__cat::before { content: "—"; margin-right: 0.4rem; }
  .bp-kicker__dot { color: var(--border-strong); }
  .bp-kicker__status { color: var(--text-subtle); }
  .bp-title { font-size: clamp(1.9rem, 5vw, 3rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.025em; color: var(--text); margin: 0 0 1rem; }
  .bp-sub { font-size: clamp(1.0625rem, 2vw, 1.1875rem); line-height: 1.55; color: var(--text-muted); margin: 0 0 1.5rem; max-width: 660px; }

  .bp-byline { display: flex; align-items: center; gap: 0.75rem; }
  .bp-avatar { flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; font-size: 0.8125rem; font-weight: 700; }
