  .prose :global(.hc-callout--warning) { background: #fffbeb; border-color: #fde68a; border-left-color: #f59e0b; color: #78350f; }
  .prose :global(.hc-callout--warning strong) { color: #92400e; }
  :root[data-theme="dark"] .prose :global(.hc-callout--warning) { background: rgba(180, 83, 9, 0.15); border-color: rgba(245, 158, 11, 0.4); color: #fde68a; }

  .prose :global(.hc-timeline) { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin: 1.75rem 0; padding: 0; list-style: none; }
  .prose :global(.hc-timeline > li) { margin: 0; padding: 0.9rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); }
  .prose :global(.hc-timeline > li.is-now) { border-color: var(--accent); background: var(--accent-soft); box-shadow: 0 0 0 1px var(--accent) inset; }
  .prose :global(.hc-timeline__when) { display: block; font-size: 0.625rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); margin-bottom: 0.4rem; }
  .prose :global(.hc-timeline__val) { display: block; font-size: 1.05rem; font-weight: 800; color: var(--text); margin-bottom: 0.25rem; }
  .prose :global(.hc-timeline__sub) { display: block; font-size: 0.78rem; color: var(--text-subtle); line-height: 1.4; }

  .prose :global(.hc-cards) { display: grid; grid-template-columns: 1fr; gap: 0.85rem; margin: 1.75rem 0; padding: 0; list-style: none; }
  @media (min-width: 520px) { .prose :global(.hc-cards) { grid-template-columns: repeat(2, 1fr); } }
  .prose :global(.hc-cards > li) { margin: 0; padding: 1.1rem 1.15rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-card); }
  .prose :global(.hc-cards__ico) { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 10px; margin-bottom: 0.7rem; background: var(--accent-soft); color: var(--accent); font-size: 1.15rem; }
  .prose :global(.hc-cards__title) { display: block; font-size: 0.9375rem; font-weight: 700; color: var(--text); margin-bottom: 0.25rem; }
  .prose :global(.hc-cards__desc) { display: block; font-size: 0.84rem; color: var(--text-muted); line-height: 1.5; }

  .prose :global(.hc-steps) { list-style: none; margin: 1.75rem 0; padding: 0; counter-reset: step; display: grid; gap: 0.7rem; }
  .prose :global(.hc-steps > li) { counter-increment: step; position: relative; margin: 0; padding: 0.9rem 1.1rem 0.9rem 3.4rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); }
  .prose :global(.hc-steps > li::before) { content: counter(step); position: absolute; left: 1rem; top: 0.85rem; width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent-hover)); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.8125rem; font-weight: 800; }
  .prose :global(.hc-steps__title) { display: block; font-weight: 700; color: var(--text); font-size: 0.95rem; margin-bottom: 0.15rem; }
  .prose :global(.hc-steps__desc) { display: block; font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; }

  .prose :global(.inline-cta) { display: flex; align-items: center; gap: 0.875rem; margin: 1.75rem 0; padding: 0.95rem 1.15rem; background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); border-left: 4px solid var(--accent); border-radius: var(--radius); }
  .prose :global(.inline-cta__icon) { font-size: 1.6rem; line-height: 1; flex-shrink: 0; }
  .prose :global(.inline-cta__txt) { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .prose :global(.inline-cta__txt strong) { font-size: 0.95rem; color: var(--text); }
