  .prose :global(.hc-cat-table tbody td:first-child) { text-align: center; width: 1%; white-space: nowrap; }

  .prose :global(.hc-summary) { margin: 1.75rem 0; padding: 1.3rem 1.4rem; background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent); border-radius: var(--radius-lg); }
  .prose :global(.hc-summary__head) { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
  .prose :global(.hc-summary__icon) { flex-shrink: 0; width: 26px; height: 26px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; font-size: 1.1rem; font-weight: 700; line-height: 1; }
  .prose :global(.hc-summary__title) { font-size: 1rem; font-weight: 800; color: var(--text); }
  .prose :global(.hc-summary__list) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .prose :global(.hc-summary__list li) { position: relative; padding-left: 1.75rem; margin: 0; font-size: 0.9375rem; line-height: 1.5; color: var(--text-muted); }
  .prose :global(.hc-summary__list li::before) { content: "✓"; position: absolute; left: 0; top: -1px; color: var(--accent); font-weight: 800; font-size: 0.95rem; }

  .prose :global(.hc-calc-cta) { position: relative; overflow: hidden; margin: 2rem 0; padding: 1.5rem 1.6rem; border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--accent) 0%, var(--accent-hover) 55%, var(--accent-strong) 100%); color: #fff; box-shadow: var(--shadow-accent); }
