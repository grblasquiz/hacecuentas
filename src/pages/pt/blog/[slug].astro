  .bp-toc__list { list-style: none; margin: 0.6rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.1rem; counter-reset: toc; }
  .bp-toc__list li { counter-increment: toc; }
  .bp-toc__list a { display: flex; gap: 0.55rem; align-items: baseline; font-size: 0.8125rem; line-height: 1.4; color: var(--text-muted); text-decoration: none; padding: 0.4rem 0.5rem; border-radius: var(--radius-sm); transition: background 0.12s, color 0.12s; }
  .bp-toc__list a::before { content: counter(toc); flex-shrink: 0; font-size: 0.6875rem; font-weight: 700; color: var(--text-subtle); font-variant-numeric: tabular-nums; min-width: 1ch; }
  .bp-toc__list a:hover { color: var(--accent); background: var(--accent-soft); }
