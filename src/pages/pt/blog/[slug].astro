  .prose :global(.hc-calc-cta__eyebrow) { font-size: 0.625rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255, 255, 255, 0.85); margin-bottom: 0.5rem; }
  .prose :global(.hc-calc-cta__title) { font-size: 1.25rem; font-weight: 800; line-height: 1.25; margin-bottom: 0.45rem; }
  .prose :global(.hc-calc-cta__desc) { font-size: 0.9375rem; line-height: 1.55; color: rgba(255, 255, 255, 0.9); margin-bottom: 1.1rem; max-width: 46ch; }
  .prose :global(.hc-calc-cta__btn) { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.7rem 1.15rem; border-radius: var(--radius); background: #fff; color: var(--accent-strong); font-size: 0.875rem; font-weight: 700; text-decoration: none; transition: transform 0.15s; }
  .prose :global(.hc-calc-cta__btn:hover) { transform: translateY(-1px); color: var(--accent-strong); }
  .prose :global(.hc-calc-cta__glyph) { position: absolute; right: -0.5rem; bottom: -1.5rem; z-index: 0; font-size: 8rem; line-height: 1; opacity: 0.14; filter: grayscale(1) brightness(3); pointer-events: none; }

  .prose :global(.hc-callout) { display: flex; gap: 0.8rem; align-items: flex-start; margin: 1.75rem 0; padding: 1rem 1.2rem; border-radius: var(--radius); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent); border-left: 4px solid var(--accent); font-size: 0.9375rem; line-height: 1.6; color: var(--text-muted); }
  .prose :global(.hc-callout p) { margin: 0; }
