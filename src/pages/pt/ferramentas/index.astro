---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';
const href='/pt/ferramentas';
const hubs=hubsOfSilo(href);
---
<Layout title="Conversores | Hacé Cuentas" description="Como converto esta medida sem errar?" canonical={`https://hacecuentas.com${href}`} audience="BR" lang="pt-BR">
  <Header /><SiloIndex silo="Conversores" href={href} lede="Como converto esta medida sem errar?" hubs={hubs} /><Footer />
</Layout>
