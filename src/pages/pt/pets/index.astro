---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';
const href='/pt/pets';
const hubs=hubsOfSilo(href);
---
<Layout title="Cuidados com pets | Hacé Cuentas" description="Quanto meu animal precisa por dia?" canonical={`https://hacecuentas.com${href}`} audience="BR" lang="pt-BR">
  <Header /><SiloIndex silo="Cuidados com pets" href={href} lede="Quanto meu animal precisa por dia?" hubs={hubs} /><Footer />
</Layout>
