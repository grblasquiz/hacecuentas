---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';
const href='/pt/cozinha';
const hubs=hubsOfSilo(href);
---
<Layout title="Receitas e festas | Hacé Cuentas" description="Quanto de comida eu preciso preparar?" canonical={`https://hacecuentas.com${href}`} audience="BR" lang="pt-BR">
  <Header /><SiloIndex silo="Receitas e festas" href={href} lede="Quanto de comida eu preciso preparar?" hubs={hubs} /><Footer />
</Layout>
