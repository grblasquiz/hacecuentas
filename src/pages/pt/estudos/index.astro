---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';
const href='/pt/estudos';
const hubs=hubsOfSilo(href);
---
<Layout title="Estudos | Hacé Cuentas" description="Quanto preciso estudar ou tirar para passar?" canonical={`https://hacecuentas.com${href}`} audience="BR" lang="pt-BR">
  <Header /><SiloIndex silo="Estudos" href={href} lede="Quanto preciso estudar ou tirar para passar?" hubs={hubs} /><Footer />
</Layout>
