---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/pt/comida-para-receitas-e-festas';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="BR" lang="pt-BR" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/pt-comida-para-receitas-e-festas';
  const configs = {"c1":{"formulaId":"bolo-casamento-br","fields":["numeroConvidados","doceFinoPorPessoa"],"outputs":[{"id":"boloKg","label":"Bolo (kg)","primary":true},{"id":"docesTotal","label":"Doces finos (unidades)"}],"title":"Quantidade de Bolo de Casamento por Convidado"},"c2":{"formulaId":"cafe-molido-taza-metodo-preparacion","fields":["metodo","tazas"],"outputs":[{"id":"resultado","label":"Café moído necessário","primary":true},{"id":"resumen","label":"Detalhe do cálculo"}],"title":"Quanto Café Moído por Xícara (por Método de Preparo)"},"c3":{"formulaId":"kilos-chocolate-casero-bombones-receta","fields":["cantidad","peso","relleno","merma"],"outputs":[{"id":"resultado","label":"Cobertura a pesar (g)","primary":true},{"id":"resumen","label":"Detalhamento do cálculo"}],"title":"Quanto chocolate preciso para fazer bombons caseiros?"},"c4":{"formulaId":"conversion-cucharaditas-gramos-especias-sal","fields":["ingrediente","cucharaditas"],"outputs":[{"id":"resultado","label":"Resultado em gramas","primary":true},{"id":"resumen","label":"Interpretação"}],"title":"Conversão de Colher de Chá para Gramas — Sal, Açúcar, Especiarias"},"c5":{"formulaId":"conversion-cups-gramos-harina-azucar-aceite","fields":["cups","ingredient"],"outputs":[{"id":"resultado","label":"Resultado em Gramas","primary":true},{"id":"resumen","label":"Resumo"}],"title":"Conversor Cups para Gramas — Farinha, Açúcar, Óleo e 18 Ingredientes"},"c6":{"formulaId":"festa-churrasco-gramas-br","fields":["adultos","criancas"],"outputs":[{"id":"carneTotalKg","label":"Carne total (kg)","primary":true},{"id":"picanhaKg","label":"Picanha (kg)"},{"id":"linguicaKg","label":"Linguiça (kg)"},{"id":"frangoKg","label":"Frango (kg)"},{"id":"paoUnidades","label":"Pães de alho (un)"}],"title":"Gramas de Carne por Pessoa no Churrasco"},"c7":{"formulaId":"porciones-torta-cumpleanos-invitados-tamano","fields":["shape","diametro","lado","largo","ancho","portion"],"outputs":[{"id":"resultado","label":"Porções estimadas","primary":true},{"id":"resumen","label":"Interpretação"}],"title":"Calculadora de Porções de Bolo por Tamanho da Forma"},"c8":{"formulaId":"porciones-sushi-por-persona-promedio","fields":["personas","nivelHambre","ninos","precioPorPieza"],"outputs":[{"id":"piezasTotales","label":"Total de peças a pedir","primary":true,"format":"number"},{"id":"rollsEquivalentes","label":"≈ rolls de 8 peças","format":"number"},{"id":"costoEstimado","label":"Custo estimado"},{"id":"resumen","label":"Detalhe"}],"title":"Porções de sushi por pessoa"},"c9":{"formulaId":"cantidad-hamburguesas-parrilla-cumpleanos","fields":["adultos","ninos","rol","peso_medallon"],"outputs":[{"id":"resultado","label":"Quantidade de Hambúrgueres","primary":true},{"id":"resumen","label":"Detalhamento do cálculo"}],"title":"Quantos Hambúrgueres por Pessoa para uma Festa?"},"c10":{"formulaId":"tiempos-coccion-verduras-al-vapor-hervido","fields":["v1","v2"],"outputs":[{"id":"resultado","label":"Tempo de cozimento","primary":true},{"id":"resumen","label":"Guia de cozimento"}],"title":"Tempos de cozimento de verduras no vapor e em água fervente"}};
  const numeric = (o:any) => Object.entries(o || {}).filter(([k,v]) => !k.startsWith('_') && typeof v === 'number' && Number.isFinite(v as number));
  const labelFor = (cfg:any,key:string) => cfg.outputs.find((o:any)=>o.id===key)?.label || key.replace(/_/g,' ');
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => {
    const id=selected?.id || Object.keys(configs)[0], cfg=(configs as any)[id];
    const values:any={}; for(const key of cfg.fields) values[key]=all[id+'__'+key];
    let out:any; try { out=formulaMap[id](values) || {}; } catch(e:any) { return {total:'—',sub:e?.message||'Revisa los datos',rows:[],chart:[],format:'plain'}; }
    const nums=numeric(out); const preferred=cfg.outputs.find((x:any)=>x.primary && typeof out[x.id]==='number') || cfg.outputs.find((x:any)=>typeof out[x.id]==='number');
    const mainKey=preferred?.id || nums[0]?.[0], main=Number(out[mainKey] ?? nums[0]?.[1] ?? 0);
    const rows=nums.slice(0,12).map(([k,v])=>({k:labelFor(cfg,k),v:Number(v),format:'unit'}));
    const chart=nums.slice(0,6).map(([k,v],i)=>({label:labelFor(cfg,k),value:Math.abs(Number(v)),tone:i===0?'main':i===1?'good':'prop'}));
    return {total:main.toLocaleString('pt-BR',{maximumFractionDigits:2}),sub:out._insight || out.detalle || out.resumen || cfg.title,rows,chart,format:'unit'};
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
