---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/pt/aprender-e-passar';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="BR" lang="pt-BR" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/pt-aprender-e-passar';
  const configs = {"c1":{"formulaId":"apps-idioma-efectividad-comparacion-nivel","fields":["nivel","objetivo"],"outputs":[{"id":"recom","label":"App recomendado","primary":true},{"id":"alter","label":"Alternativas"},{"id":"resumen","label":"Detalhes"}],"title":"Qual aplicativo de idiomas é melhor para o seu nível?"},"c2":{"formulaId":"clases-semanales-italki-online-frecuencia","fields":["meta"],"outputs":[{"id":"clases","label":"Aulas/sem","primary":true},{"id":"duracion","label":"Min/aula"},{"id":"resumen","label":"Plano recomendado"}],"title":"Quantas Aulas de Idioma por Semana Você Precisa?"},"c3":{"formulaId":"cbc-uba-materias-regularidad-requisitos","fields":["asistenciaPorcentaje","parcial1","parcial2"],"outputs":[{"id":"regularidad","label":"Situação Acadêmica","primary":true},{"id":"promedio","label":"Média dos Parciais"},{"id":"observacion","label":"Próximo Passo"}],"title":"Calculadora de Regularidade CBC UBA: Regular ou Livre?"},"c4":{"formulaId":"nota-promedio-bachillerato-secundario-materias","fields":["notasTexto"],"outputs":[{"id":"promedio","label":"Média","primary":true},{"id":"clasificacion","label":"Classificação"},{"id":"materiasAprobadas","label":"Matérias aprovadas"}],"title":"Média escolar do ensino médio: aprovação, recuperação ou reprovação"},"c5":{"formulaId":"media-para-passar-recuperacao-nota-necessaria","fields":["mediaParcial","pesoParcialPct","mediaParaPassar","notaMaxima"],"outputs":[{"id":"notaNecessaria","label":"Nota necessária na final","primary":true},{"id":"situacao","label":"Situação"},{"id":"pesoFinalPct","label":"Peso da prova final"},{"id":"folga","label":"Folga/margem"},{"id":"detalhe","label":"Detalhe"}],"title":"Calculadora: quanto preciso para passar"},"c6":{"formulaId":"media-ponderada-enem-nota-corte-sisu","fields":["notaLinguagens","notaHumanas","notaNatureza","notaMatematica","notaRedacao","pesoLinguagens","pesoHumanas","pesoNatureza","pesoMatematica","pesoRedacao","notaCorte"],"outputs":[{"id":"mediaPonderada","label":"Média ponderada (SiSU)","primary":true},{"id":"mediaSimples","label":"Média simples (aritmética)"},{"id":"situacao","label":"Situação vs. nota de corte"},{"id":"margem","label":"Margem"},{"id":"detalhe","label":"Detalhe do cálculo"}],"title":"Calculadora de média ponderada do ENEM (nota de corte do SiSU)"},"c7":{"formulaId":"podcasts-aprender-idioma-minutos-diarios","fields":["nivel"],"outputs":[{"id":"minDia","label":"Min/dia"},{"id":"tipo","label":"Tipo de podcast"},{"id":"resumen","label":"Plano"}],"title":"Podcasts para aprender idiomas"}};
  const numeric = (o:any) => Object.entries(o || {}).filter(([k,v]) => !k.startsWith('_') && typeof v === 'number' && Number.isFinite(v as number));
  const labelFor = (cfg:any,key:string) => cfg.outputs.find((o:any)=>o.id===key)?.label || key.replace(/_/g,' ');
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => {
    const id=selected?.id || Object.keys(configs)[0], cfg=(configs as any)[id];
    const values:any={}; for(const key of cfg.fields) values[key]=all[id+'__'+key];
    let out:any; try { out=formulaMap[id](values) || {}; } catch(e:any) { return {total:'—',sub:e?.message||'Revisa los datos',rows:[],chart:[],format:'plain'}; }
    const nums=numeric(out); const preferred=cfg.outputs.find((x:any)=>x.primary && typeof out[x.id]==='number') || cfg.outputs.find((x:any)=>typeof out[x.id]==='number');
    const mainKey=preferred?.id || nums[0]?.[0], main=Number(out[mainKey] ?? nums[0]?.[1] ?? 0);
    const rows=nums.slice(0,12).map(([k,v])=>({k:labelFor(cfg,k),v:Number(v),format:'unit'}));
    const chart=nums.slice(0,6).map(([k,v],i)=>({label:labelFor(cfg,k),value:Math.abs(Number(v)),tone:i===0?'main':i===1?'good':'prop'}));
    return {total:main.toLocaleString('pt-BR',{maximumFractionDigits:2}),sub:out._insight || out.detalle || out.resumen || cfg.title,rows,chart,format:'unit'};
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
