---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/pt/decisoes-e-calculos-do-dia-a-dia';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="BR" lang="pt-BR" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/pt-decisoes-e-calculos-do-dia-a-dia';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"dash-hipertension-sodio-diario-tabla","fields":["tipoDash"],"outputs":[{"id":"sodioMaximo","label":"Sódio máximo diário","primary":true},{"id":"equivalente","label":"Equivalente de sal"},{"id":"observacion","label":"Observação"}],"title":"Calculadora de sódio diário na dieta DASH (hipertensão)"},"c2":{"formulaId":"elo-ajedrez-ganado-perdido-variacion","fields":["eloActual","eloOponente","resultado","kFactor"],"outputs":[{"id":"nuevoElo","label":"Novo ELO","primary":true},{"id":"variacion","label":"Variação"},{"id":"expectativa","label":"Expectativa"}],"title":"Variação de ELO do Xadrez"},"c3":{"formulaId":"vegana-proteina-completa-combinacion-aminoacidos","fields":["plato"],"outputs":[{"id":"completo","label":"Está Completo?","primary":true},{"id":"aminoacidoLimitante","label":"Aminoácido Limitante"},{"id":"pdcaas","label":"PDCAAS"}],"title":"Proteína Vegana Completa: Combinação de Aminoácidos"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'pt-BR', format: 'unit' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
