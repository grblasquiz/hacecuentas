---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/pt/energia-da-casa';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="BR" lang="pt-BR" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/pt-energia-da-casa';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"consumo-heladera-anual-kwh","fields":["potenciaW","dutyCycle","tarifa"],"outputs":[{"id":"kwhAnual","label":"Consumo anual","primary":true},{"id":"kwhMensual","label":"Consumo mensal"},{"id":"costoAnual","label":"Custo anual"},{"id":"resumen","label":"Interpretação"}],"title":"Consumo de Geladeira em kWh (Gasto Anual)"},"c2":{"formulaId":"conta-de-luz-kwh-bandeira-tarifaria","fields":["consumoKwh","tarifaKwh","bandeira","cip"],"outputs":[{"id":"total","label":"Conta estimada","primary":true},{"id":"valorEnergia","label":"Valor da energia (kWh × tarifa)"},{"id":"valorBandeira","label":"Acréscimo da bandeira"},{"id":"cipValor","label":"Iluminação pública (CIP)"},{"id":"custoMedioKwh","label":"Custo médio por kWh"},{"id":"detalhe","label":"Detalhe"}],"title":"Calculadora de conta de luz (kWh e bandeira tarifária)"},"c3":{"formulaId":"energia-electrodomestico-etiqueta-eficiencia","fields":["kwhClaseActual","kwhClaseNueva","tarifa"],"outputs":[{"id":"ahorroKwhAño","label":"kWh/ano economizados","primary":true},{"id":"ahorroPesosAño","label":"R$/ano economizados"},{"id":"resumen","label":"Interpretação"}],"title":"¿Cuánto ahorrás cambiando a electrodoméstico A+++?"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'pt-BR', format: 'ars' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
