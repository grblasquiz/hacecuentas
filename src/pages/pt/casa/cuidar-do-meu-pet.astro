---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/pt/cuidar-do-meu-pet';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="BR" lang="pt-BR" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/pt-cuidar-do-meu-pet';
  const configs = {"c1":{"formulaId":"pecera-litros-peces-cantidad-m2","fields":["fishLength","fishCount","fishType"],"outputs":[{"id":"resultado","label":"Volume mínimo","primary":true},{"id":"resumen","label":"Detalhes do cálculo"}],"title":"Quantos litros por peixe? Calculadora de aquário"},"c2":{"formulaId":"cobayo-vitamina-c-dosis-diaria","fields":["v1","v2"],"outputs":[{"id":"resultado","label":"Dose diária recomendada","primary":true},{"id":"resumen","label":"Como foi calculado"}],"title":"Calculadora de Vitamina C para Cobaias — Dose Diária por Peso"},"c3":{"formulaId":"conejo-comida-heno-peso-edad","fields":["peso_kg","etapa"],"outputs":[{"id":"resultado","label":"Pellets diários","primary":true},{"id":"resumen","label":"Desglose completo da dieta"}],"title":"Quanto deve comer um coelho? Feno, pellets e verduras por peso"},"c4":{"formulaId":"envejecer-mascota-humano-tabla-raza-tamano","fields":["tipo","edadMascota"],"outputs":[{"id":"edadHumana","label":"Idade humana aprox","primary":true},{"id":"etapa","label":"Etapa de vida"},{"id":"observacion","label":"Observação"}],"title":"Idade do seu animal em anos humanos"},"c5":{"formulaId":"huron-ferret-dieta-proteina-animal","fields":["v1","v2"],"outputs":[{"id":"resultado","label":"Alimento diário","primary":true},{"id":"resumen","label":"Resumo por fase"}],"title":"Quanto devo alimentar meu furão? Ração e proteína diária por peso"},"c6":{"formulaId":"paseos-perro-minutos-raza-energia","fields":["energia","tamano","edad","braquicefalo"],"outputs":[{"id":"minutosDia","label":"Minutos de passeio por dia","primary":true,"format":"number"},{"id":"paseosDia","label":"Saídas recomendadas por dia","format":"number"},{"id":"duracionPorPaseo","label":"Duração por saída (minutos)","format":"number"},{"id":"intensidad","label":"Intensidade recomendada"},{"id":"resumen","label":"Resumo"},{"id":"advertencia","label":"Advertências"}],"title":"Quantos minutos de passeio o seu cachorro precisa por dia?"},"c7":{"formulaId":"tortuga-agua-dieta-peso-edad","fields":["peso_g","edad_anios"],"outputs":[{"id":"resultado","label":"Quantidade de alimento","primary":true},{"id":"resumen","label":"Recomendação de alimentação"}],"title":"Quanto alimentar tartaruga de água: calculadora por peso e idade"}};
  const numeric = (o:any) => Object.entries(o || {}).filter(([k,v]) => !k.startsWith('_') && typeof v === 'number' && Number.isFinite(v as number));
  const labelFor = (cfg:any,key:string) => cfg.outputs.find((o:any)=>o.id===key)?.label || key.replace(/_/g,' ');
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => {
    const id=selected?.id || Object.keys(configs)[0], cfg=(configs as any)[id];
    const values:any={}; for(const key of cfg.fields) values[key]=all[id+'__'+key];
    let out:any; try { out=formulaMap[id](values) || {}; } catch(e:any) { return {total:'—',sub:e?.message||'Revisa los datos',rows:[],chart:[],format:'plain'}; }
    const nums=numeric(out); const preferred=cfg.outputs.find((x:any)=>x.primary && typeof out[x.id]==='number') || cfg.outputs.find((x:any)=>typeof out[x.id]==='number');
    const mainKey=preferred?.id || nums[0]?.[0], main=Number(out[mainKey] ?? nums[0]?.[1] ?? 0);
    const rows=nums.slice(0,12).map(([k,v])=>({k:labelFor(cfg,k),v:Number(v),format:'unit'}));
    const chart=nums.slice(0,6).map(([k,v],i)=>({label:labelFor(cfg,k),value:Math.abs(Number(v)),tone:i===0?'main':i===1?'good':'prop'}));
    return {total:main.toLocaleString('pt-BR',{maximumFractionDigits:2}),sub:out._insight || out.detalle || out.resumen || cfg.title,rows,chart,format:'unit'};
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
