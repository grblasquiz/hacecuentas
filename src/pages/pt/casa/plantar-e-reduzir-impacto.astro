---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/pt/plantar-e-reduzir-impacto';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="BR" lang="pt-BR" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/pt-plantar-e-reduzir-impacto';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"calendario-siembra-hemisferio-sur","fields":["mes"],"outputs":[{"id":"recomendadas","label":"O que plantar","primary":true},{"id":"resumen","label":"Interpretação"}],"title":"Calendário de Plantio do Hemisfério Sul: O que Semear Mês a Mês"},"c2":{"formulaId":"cosecha-esperada-huerta-kg","fields":["especie","m2"],"outputs":[{"id":"kgTotal","label":"Colheita estimada","primary":true},{"id":"resumen","label":"Interpretação"}],"title":"Calculadora de colheita esperada da horta (kg/m²)"},"c3":{"formulaId":"huella-carbono-boda-evento","fields":["invitados"],"outputs":[{"id":"kgCo2","label":"CO₂ total","primary":true},{"id":"arbolesCompensar","label":"Árvores a plantar"},{"id":"resumen","label":"Interpretação"}],"title":"Pegada de carbono do casamento ou evento: calcule e compense"},"c4":{"formulaId":"podar-rosal-cuando-fecha","fields":["zona"],"outputs":[{"id":"mejorEpoca","label":"Melhor época para podar","primary":true},{"id":"resumen","label":"Interpretação"}],"title":"Quando Podar Roseiras — por Zona Climática"},"c5":{"formulaId":"biodegradacion-residuo-tiempo","fields":["material"],"outputs":[{"id":"tiempoEstimado","label":"Tempo de biodegradação","primary":true},{"id":"resumen","label":"Interpretação"}],"title":"Tempo de Biodegradação de Materiais: calculadora + tabela completa"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'pt-BR', format: 'unit' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
