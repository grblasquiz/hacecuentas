---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';
const href='/pt/casa';
const hubs=hubsOfSilo(href);
---
<Layout title="Energia da casa | Hacé Cuentas" description="Quanto de energia minha casa consome?" canonical={`https://hacecuentas.com${href}`} audience="BR" lang="pt-BR">
  <Header /><SiloIndex silo="Energia da casa" href={href} lede="Quanto de energia minha casa consome?" hubs={hubs} /><Footer />
</Layout>
