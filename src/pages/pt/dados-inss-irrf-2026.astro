---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  SALARIO_MINIMO,
  INSS_FAIXAS,
  INSS_TETO,
  INSS_CONTRIB_MAX,
  calcINSS,
  IRRF_FAIXAS,
  IRRF_DEDUCAO_DEPENDENTE,
  IRRF_SIMPLIFICADO_MENSAL,
  IRRF_ISENCAO_REDUTOR,
  IRRF_REDUTOR_TETO,
  calcIRRFTabelaCheia,
  calcIRRF2026,
} from '../../lib/data/brasil-2026';

// Página-dado citável (PT-BR): tabela INSS 2026 + IRRF com o redutor da reforma.
// Tudo vem da fonte única src/lib/data/brasil-2026.ts — a mesma usada pelo
// simulador de holerite → tabela e calculadoras nunca divergem.
// Padrão espelhado de /datos-monotributo-2026: tabela server-rendered + schema
// Dataset + CC-BY 4.0 + bloco "Como citar".

const ULTIMA_REVISAO = '2026-06-10';
const VIGENCIA = '2026 (reajuste anual em janeiro)';

const fmtBRL = (n: number) =>
  'R$ ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtPct = (n: number) =>
  (n * 100).toLocaleString('pt-BR', { maximumFractionDigits: 1 }) + '%';

// Faixas do INSS com limites inferiores reconstruídos da fonte única.
const faixasINSS = INSS_FAIXAS.map((f, i) => ({
  de: i === 0 ? 0 : INSS_FAIXAS[i - 1].ate + 0.01,
  ate: f.ate,
  aliquota: f.aliquota,
  deduzir: f.deduzir,
}));

// Faixas do IRRF (tabela cheia, vigente desde mai/2025).
const faixasIRRF = IRRF_FAIXAS.map((f, i) => ({
  de: i === 0 ? 0 : IRRF_FAIXAS[i - 1].ate + 0.01,
  ate: f.ate,
  aliquota: f.aliquota,
  deduzir: f.deduzir,
}));

// Exemplos: INSS + IRRF (com e sem o redutor da reforma) por salário bruto.
// Calculados com as MESMAS funções do simulador de holerite (calcINSS / calcIRRF2026).
const EXEMPLOS = [SALARIO_MINIMO, 2_500, 3_500, 5_000, 6_500, 7_350, INSS_TETO, 12_000];
const exemplos = EXEMPLOS.map((salario) => {
  const inss = calcINSS(salario);
  const base = salario - inss; // sem dependentes nem outras deduções
  const irCheio = Math.round(calcIRRFTabelaCheia(base) * 100) / 100;
  const irReforma = Math.round(calcIRRF2026(base) * 100) / 100;
  return { salario, inss, base, irCheio, irReforma, economia: Math.round((irCheio - irReforma) * 100) / 100 };
});

const title =
  'Dados INSS e IRRF 2026: tabelas oficiais + redutor da reforma do IR | Hacé Cuentas';
const description =
  `Tabela do INSS 2026 (faixas de 7,5% a 14%, teto de ${fmtBRL(INSS_TETO)}) e do IRRF mensal com o redutor da reforma: isenção efetiva até R$ 5.000 de base e redução parcial até R$ 7.350. Com exemplos de desconto por salário e quanto a reforma economiza. Uso livre com atribuição (CC-BY 4.0).`;

const PAGE_URL = 'https://hacecuentas.com/pt/dados-inss-irrf-2026';

const faq = [
  {
    q: 'Qual é o teto do INSS em 2026?',
    a: `${fmtBRL(INSS_TETO)}. Quem ganha acima disso contribui sobre o teto: o desconto máximo de INSS em 2026 é ${fmtBRL(INSS_CONTRIB_MAX)} por mês, independentemente do salário.`,
  },
  {
    q: 'Quais são as faixas do INSS 2026?',
    a: `Quatro faixas progressivas: 7,5% até ${fmtBRL(INSS_FAIXAS[0].ate)} (1 salário mínimo), 9% até ${fmtBRL(INSS_FAIXAS[1].ate)}, 12% até ${fmtBRL(INSS_FAIXAS[2].ate)} e 14% até o teto de ${fmtBRL(INSS_TETO)}. As alíquotas são progressivas: cada faixa incide só sobre a parcela do salário dentro dela.`,
  },
  {
    q: 'Quem está isento de Imposto de Renda em 2026?',
    a: `Com o redutor da reforma, quem tem base de cálculo mensal (salário menos INSS e deduções) até ${fmtBRL(IRRF_ISENCAO_REDUTOR)} paga zero de IRRF — na prática, salários brutos de até cerca de R$ 5.580 sem dependentes. Entre ${fmtBRL(IRRF_ISENCAO_REDUTOR)} e ${fmtBRL(IRRF_REDUTOR_TETO)} de base há redução parcial do imposto.`,
  },
  {
    q: 'Como funciona o redutor do IRRF da reforma?',
    a: `O imposto é zerado para bases até ${fmtBRL(IRRF_ISENCAO_REDUTOR)}; entre ${fmtBRL(IRRF_ISENCAO_REDUTOR)} e ${fmtBRL(IRRF_REDUTOR_TETO)} aplica-se uma redução que diminui gradualmente; acima de ${fmtBRL(IRRF_REDUTOR_TETO)} vale a tabela cheia, sem redução. A tabela progressiva em si é a vigente desde maio/2025.`,
  },
  {
    q: 'Qual é a dedução por dependente no IRRF 2026?',
    a: `${fmtBRL(IRRF_DEDUCAO_DEPENDENTE)} por dependente por mês, abatida da base de cálculo antes de aplicar a tabela.`,
  },
  {
    q: 'O que é o desconto simplificado do IRRF?',
    a: `Uma dedução fixa de ${fmtBRL(IRRF_SIMPLIFICADO_MENSAL)} mensais que substitui as deduções legais (INSS, dependentes) quando for mais vantajosa para o contribuinte. O empregador aplica automaticamente a opção que resultar em menos imposto.`,
  },
  {
    q: 'Qual é o salário mínimo de 2026?',
    a: `${fmtBRL(SALARIO_MINIMO)} (Decreto 12.797/2025, reajuste de 6,79% sobre os R$ 1.518 de 2025). Quem ganha o mínimo desconta 7,5% de INSS (${fmtBRL(calcINSS(SALARIO_MINIMO))}) e não paga IRRF.`,
  },
  {
    q: 'Quando essas tabelas são reajustadas?',
    a: 'O salário mínimo e as faixas do INSS são reajustados em janeiro de cada ano (INPC). A tabela do IRRF depende de lei — a progressiva vigente é a de maio/2025, e o redutor da reforma vale a partir de 2026.',
  },
  {
    q: 'Posso usar estas tabelas no meu site, matéria ou trabalho?',
    a: 'Sim. Os dados são publicados sob licença Creative Commons CC-BY 4.0: você pode reproduzi-los livremente citando a fonte com um link para hacecuentas.com. O bloco "Como citar" está logo abaixo.',
  },
];

const datasetSchema = {
  '@type': 'Dataset',
  '@id': `${PAGE_URL}#dataset`,
  name: 'INSS e IRRF Brasil 2026 — tabelas, teto e redutor da reforma',
  description:
    `Faixas progressivas do INSS 2026 (7,5% a 14%, teto ${fmtBRL(INSS_TETO)}), tabela mensal do IRRF com parcelas a deduzir, dedução por dependente, desconto simplificado e o redutor da reforma (isenção até R$ 5.000 de base). Fontes: Portaria Interministerial MPS/MF e legislação do IR.`,
  url: PAGE_URL,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  inLanguage: 'pt-BR',
  dateModified: ULTIMA_REVISAO,
  temporalCoverage: '2026',
  spatialCoverage: { '@type': 'Place', name: 'Brasil' },
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  keywords: ['INSS 2026', 'IRRF 2026', 'Tabela INSS', 'Imposto de Renda', 'Redutor reforma IR', 'Brasil'],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${PAGE_URL}#webpage`,
      name: title,
      description,
      url: PAGE_URL,
      inLanguage: 'pt-BR',
      dateModified: ULTIMA_REVISAO,
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
      mainEntity: { '@id': `${PAGE_URL}#dataset` },
    },
    datasetSchema,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://hacecuentas.com/pt' },
        { '@type': 'ListItem', position: 2, name: 'Dados INSS e IRRF 2026', item: PAGE_URL },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="/pt/dados-inss-irrf-2026"
  audience="BR"
  lang="pt"
  schema={schema}
  domain="data"
>
  <Header slot="header" lang="pt" />

  <main class="article-main">
    <article class="page-content datos-page">
      <header class="article-header">
        <nav class="crumbs" aria-label="Navegação">
          <a href="/pt">Início</a> <span>›</span> <span>Dados INSS e IRRF 2026</span>
        </nav>
        <h1>INSS e IRRF 2026: tabelas oficiais + redutor da reforma</h1>
        <p class="lede">
          Tabelas de referência dos descontos do trabalhador CLT em 2026: as
          <strong> 4 faixas do INSS</strong> (teto de {fmtBRL(INSS_TETO)}), a
          <strong> tabela mensal do IRRF</strong> e o <strong>redutor da reforma do IR</strong>,
          que zera o imposto para base de cálculo até {fmtBRL(IRRF_ISENCAO_REDUTOR)} e reduz
          parcialmente até {fmtBRL(IRRF_REDUTOR_TETO)}. Com exemplos por salário.
        </p>
        <p class="updated">
          Última revisão: <time datetime={ULTIMA_REVISAO}>{new Date(ULTIMA_REVISAO).toLocaleDateString('pt-BR')}</time> ·
          Vigência: {VIGENCIA} ·
          Licença <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC-BY 4.0</a> (uso livre com atribuição)
        </p>
      </header>

      <section class="stats-callout" aria-label="Dados em destaque">
        <div class="stat">
          <span class="stat-num">{fmtBRL(INSS_TETO)}</span>
          <span class="stat-label">teto do INSS 2026</span>
        </div>
        <div class="stat">
          <span class="stat-num">{fmtBRL(INSS_CONTRIB_MAX)}</span>
          <span class="stat-label">desconto máximo de INSS</span>
        </div>
        <div class="stat">
          <span class="stat-num">{fmtBRL(IRRF_ISENCAO_REDUTOR)}</span>
          <span class="stat-label">base isenta de IR (redutor)</span>
        </div>
        <div class="stat">
          <span class="stat-num">{fmtBRL(SALARIO_MINIMO)}</span>
          <span class="stat-label">salário mínimo 2026</span>
        </div>
      </section>

      <section>
        <h2>Tabela do INSS 2026 (desconto do segurado CLT)</h2>
        <p>
          Alíquotas progressivas sobre o salário de contribuição, com a "parcela a deduzir" que
          simplifica o cálculo: <em>INSS = salário × alíquota − parcela a deduzir</em>.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Faixa salarial</th>
                <th>Alíquota</th>
                <th>Parcela a deduzir</th>
              </tr>
            </thead>
            <tbody>
              {faixasINSS.map((f) => (
                <tr>
                  <td data-label="Faixa">{f.de === 0 ? `Até ${fmtBRL(f.ate)}` : `${fmtBRL(f.de)} a ${fmtBRL(f.ate)}`}</td>
                  <td data-label="Alíquota"><strong>{fmtPct(f.aliquota)}</strong></td>
                  <td data-label="Deduzir">{f.deduzir === 0 ? '—' : fmtBRL(f.deduzir)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          Acima do teto de {fmtBRL(INSS_TETO)}, o desconto fica fixo em {fmtBRL(INSS_CONTRIB_MAX)}.
          Fonte: Portaria Interministerial MPS/MF (reajuste pelo INPC, janeiro 2026).
        </p>
      </section>

      <section>
        <h2>Tabela do IRRF mensal (cheia) + redutor 2026</h2>
        <p>
          A tabela progressiva é a vigente desde maio/2025. Em 2026 entra em vigor o
          <strong> redutor da reforma do IR</strong>, aplicado DEPOIS da tabela:
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Base de cálculo mensal</th>
                <th>Alíquota</th>
                <th>Parcela a deduzir</th>
              </tr>
            </thead>
            <tbody>
              {faixasIRRF.map((f) => (
                <tr>
                  <td data-label="Base">{f.ate === Infinity ? `Acima de ${fmtBRL(faixasIRRF[faixasIRRF.length - 2].ate)}` : f.de === 0 ? `Até ${fmtBRL(f.ate)}` : `${fmtBRL(f.de)} a ${fmtBRL(f.ate)}`}</td>
                  <td data-label="Alíquota"><strong>{f.aliquota === 0 ? 'Isento' : fmtPct(f.aliquota)}</strong></td>
                  <td data-label="Deduzir">{f.deduzir === 0 ? '—' : fmtBRL(f.deduzir)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="cambios">
          <li>
            <strong>Redutor da reforma (2026):</strong> IR zerado para base de cálculo até
            {' '}{fmtBRL(IRRF_ISENCAO_REDUTOR)}; redução parcial e decrescente entre
            {' '}{fmtBRL(IRRF_ISENCAO_REDUTOR)} e {fmtBRL(IRRF_REDUTOR_TETO)}; tabela cheia acima
            disso.
          </li>
          <li>
            <strong>Dedução por dependente:</strong> {fmtBRL(IRRF_DEDUCAO_DEPENDENTE)} por mês,
            por dependente.
          </li>
          <li>
            <strong>Desconto simplificado:</strong> {fmtBRL(IRRF_SIMPLIFICADO_MENSAL)} mensais,
            usado quando for mais vantajoso que as deduções legais.
          </li>
        </ul>
      </section>

      <section>
        <h2>Exemplos: desconto por salário e quanto a reforma economiza</h2>
        <p>
          Calculados com as mesmas funções do nosso simulador de holerite. Base de cálculo do IR =
          salário − INSS, sem dependentes:
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Salário bruto</th>
                <th>INSS</th>
                <th>IRRF 2026 (com redutor)</th>
                <th>IRRF sem a reforma</th>
                <th>Economia/mês</th>
              </tr>
            </thead>
            <tbody>
              {exemplos.map((e) => (
                <tr>
                  <td data-label="Salário"><strong>{fmtBRL(e.salario)}</strong></td>
                  <td data-label="INSS">{fmtBRL(e.inss)}</td>
                  <td data-label="IRRF 2026">{e.irReforma === 0 ? 'Isento' : fmtBRL(e.irReforma)}</td>
                  <td data-label="IRRF tabela cheia">{e.irCheio === 0 ? 'Isento' : fmtBRL(e.irCheio)}</td>
                  <td data-label="Economia">{e.economia > 0 ? fmtBRL(e.economia) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          "IRRF sem a reforma" = tabela cheia de mai/2025 sem o redutor, para comparação. Valores
          de referência sem dependentes nem pensão; o holerite real pode variar com outras
          deduções.
        </p>
      </section>

      <section>
        <h2>Calcule o seu caso</h2>
        <p>Estas tabelas são a referência. Para o seu salário líquido exato, use as calculadoras:</p>
        <ul class="calc-links">
          <li><a href="/pt/simulador-holerite-clt">Simulador de holerite CLT (salário líquido completo)</a></li>
          <li><a href="/pt/salario-liquido-clt-inss-irrf-2026">Salário líquido CLT 2026 (INSS + IRRF)</a></li>
          <li><a href="/pt/irrf-mensal-folha-pagamento-2026">IRRF mensal na folha de pagamento</a></li>
          <li><a href="/pt/seguro-desemprego-valor-parcelas-trabalhador-clt">Seguro-desemprego: valor das parcelas</a></li>
        </ul>
      </section>

      <section class="cite-instructions">
        <h2>Como citar estas tabelas</h2>
        <p>Vai usar estes dados em uma matéria, trabalho, app ou site? A atribuição pedida é:</p>
        <pre><code>Fonte: Hacé Cuentas — https://hacecuentas.com/pt/dados-inss-irrf-2026
Tabelas INSS/IRRF 2026 · Licença CC-BY 4.0</code></pre>
        <p>
          Se publicar online, agradecemos o link para
          <a href="https://hacecuentas.com/pt/dados-inss-irrf-2026">hacecuentas.com/pt/dados-inss-irrf-2026</a>.
        </p>
      </section>

      <section class="faq">
        <h2>Perguntas frequentes</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <section class="fuentes">
        <h2>Fontes</h2>
        <ul>
          <li>
            <a href="https://www.planalto.gov.br/ccivil_03/_ato2023-2026/2025/decreto/d12797.htm" rel="nofollow noopener" target="_blank">Decreto 12.797/2025</a> — salário mínimo 2026 (R$ 1.621).
          </li>
          <li>Portaria Interministerial MPS/MF — faixas e teto do INSS 2026 (reajuste INPC).</li>
          <li>Lei 14.663/2023 e reforma do IR 2026 — tabela progressiva do IRRF e redutor (isenção efetiva até R$ 5.000).</li>
        </ul>
      </section>
    </article>
  </main>

  <Footer slot="footer" lang="pt" />
</Layout>

<style>
  .datos-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem 1rem 4rem;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-bottom: 0.75rem;
  }
  .crumbs a { color: var(--accent, #2563eb); text-decoration: none; }
  .datos-page h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text, #222);
  }
  .updated {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-top: 0.5rem;
  }
  .datos-page h2 {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .stats-callout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin: 1.75rem 0;
  }
  .stat {
    background: var(--bg-soft, #f4f6f9);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 0.6rem;
    padding: 0.9rem 1rem;
    text-align: center;
  }
  .stat-num {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent, #2563eb);
    line-height: 1.2;
  }
  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted, #666);
    margin-top: 0.25rem;
  }
  .table-wrap { overflow-x: auto; margin: 1.25rem 0; }
  .datos-page table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    min-width: 540px;
  }
  .datos-page th {
    background: var(--bg-soft, #f1f5f9);
    padding: 0.6rem 0.7rem;
    text-align: right;
    font-weight: 600;
    border-bottom: 2px solid var(--border, #e5e7eb);
    white-space: nowrap;
  }
  .datos-page th:first-child { text-align: left; }
  .datos-page td {
    padding: 0.55rem 0.7rem;
    text-align: right;
    border-bottom: 1px solid var(--border, #eee);
    white-space: nowrap;
  }
  .datos-page td:first-child { text-align: left; }
  .datos-page tbody tr:nth-child(odd) { background: var(--bg-card, #fafafa); }
  .note {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-top: 0.5rem;
  }
  .cambios li, .calc-links li, .fuentes li { line-height: 1.7; margin-bottom: 0.5rem; }
  .cambios, .calc-links, .fuentes ul { margin-left: 1.25rem; }
  .calc-links a, .fuentes a { color: var(--accent, #2563eb); }
  .cite-instructions {
    margin-top: 2.5rem;
    padding: 1.1rem;
    background: var(--bg-soft, #f4f6f9);
    border-radius: 0.6rem;
  }
  .cite-instructions pre {
    background: var(--code-bg, #eaeef3);
    padding: 0.75rem;
    border-radius: 0.4rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }
  .faq details {
    border-bottom: 1px solid var(--border, #e5e7eb);
    padding: 0.75rem 0;
  }
  .faq summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--text, #222);
  }
  .faq details p {
    margin-top: 0.5rem;
    color: var(--text-muted, #555);
    line-height: 1.6;
  }
</style>
