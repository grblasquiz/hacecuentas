---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';
const href='/pt/jardim';
const hubs=hubsOfSilo(href);
---
<Layout title="Jardim e ambiente | Hacé Cuentas" description="Quando plantar e qual é o impacto da minha escolha?" canonical={`https://hacecuentas.com${href}`} audience="BR" lang="pt-BR">
