---
/**
 * Hub de decisão BR — "Quanto pago comprando em dólar, euro ou site gringo?".
 * As alíquotas de IOF e de ICMS entram como campo editável: mudam por decreto
 * e por estado, e travá-las no código seria pior que não calculá-las.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, IOF_REFERENCIA, IMPORTACAO } from '../../../lib/hubs/pt/comprar-em-dolar-iof';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://hacecuentas.com/pt' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="BR"
  lang="pt"
  ogType="article"
  articleSection={hub.silo}
>
  <Header lang="pt" />
  <DecisionHub data={hub} />
  <Footer lang="pt" />
</Layout>

<script is:inline define:vars={{ IOF_REFERENCIA, IMPORTACAO }}>
  (function () {
    const H = window.HC_HUB;
    const brl = (n) =>
      'R$ ' + (Math.round((n || 0) * 100) / 100).toLocaleString('pt-BR', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    const moeda = (n) =>
      (Math.round((n || 0) * 100) / 100).toLocaleString('pt-BR', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    const pct = (n) => (n || 0).toFixed(2).replace('.', ',') + '%';

    H.onCompute(function (v) {
      const op = String(v.operacao || 'cartao');
      const valor = Math.max(0, v.valorMoeda || 0);
      const cotacao = Math.max(0, v.cotacao || 0);
      const spread = Math.max(0, v.spread || 0) / 100;
      const iofPct = Math.max(0, v.iofPct || 0) / 100;
      const freteUsd = Math.max(0, v.freteUsd || 0);
      const icmsPct = Math.min(0.35, Math.max(0, v.icms || 0) / 100);
      const taxaFixa = Math.max(0, v.taxaFixa || 0);

      if (valor <= 0 || cotacao <= 0) {
        return {
          total: brl(0),
          sub: 'Informe o valor em moeda estrangeira e a cotação comercial do dia.',
          rows: [],
          chart: [],
        };
      }

      // ---------- Compra em site internacional ----------
      if (op === 'importacao') {
        const aduaneiroUsd = valor + freteUsd;
        const aduaneiro = aduaneiroUsd * cotacao;
        const dentroLimite = aduaneiroUsd <= IMPORTACAO.limiteUsd;
        const ii = dentroLimite
          ? aduaneiro * IMPORTACAO.iiAte50
          : Math.max(0, aduaneiro * IMPORTACAO.iiAcima50 - IMPORTACAO.abatimentoUsd * cotacao);
        // ICMS "por dentro": a base inclui o próprio imposto.
        const baseIcms = (aduaneiro + ii) / (1 - icmsPct);
        const icms = baseIcms - (aduaneiro + ii);
        const total = aduaneiro + ii + icms + taxaFixa;
        const sobre = aduaneiro > 0 ? ((total / aduaneiro) - 1) * 100 : 0;

        const rows = [
          { k: 'Produto', ref: 'US$ ' + moeda(valor) + ' × ' + brl(cotacao), v: valor * cotacao },
          { k: 'Frete e seguro', ref: 'Entram no valor aduaneiro e no limite de US$ 50', v: freteUsd * cotacao },
          { k: 'Valor aduaneiro', ref: 'US$ ' + moeda(aduaneiroUsd) + ' · base dos impostos', v: aduaneiro, extra: true },
          {
            k: 'Imposto de importação',
            ref: dentroLimite
              ? 'Até US$ ' + IMPORTACAO.limiteUsd + ' em loja habilitada: ' + (IMPORTACAO.iiAte50 * 100) + '%'
              : 'Acima de US$ ' + IMPORTACAO.limiteUsd + ': ' + (IMPORTACAO.iiAcima50 * 100) + '% com abatimento de US$ ' + IMPORTACAO.abatimentoUsd,
            v: ii,
          },
          {
            k: 'ICMS estadual',
            ref: pct(icmsPct * 100) + ' por dentro sobre valor aduaneiro + II',
            v: icms,
          },
          { k: 'Total de impostos', ref: 'II + ICMS', v: ii + icms, extra: true },
          { k: 'Custo final da compra', ref: 'Valor aduaneiro + impostos' + (taxaFixa > 0 ? ' + taxa fixa' : ''), v: total, extra: true },
          {
            k: 'Quanto os impostos somam sobre o preço',
            ref: 'Custo final ÷ valor aduaneiro',
            v: sobre,
            format: 'unit',
            unit: '%',
            decimals: 2,
          },
        ];
        if (aduaneiroUsd > IMPORTACAO.tetoUsd) {
          rows.push({
            k: 'Acima do teto do regime simplificado',
            ref: 'US$ ' + IMPORTACAO.tetoUsd + ' · exige despacho formal de importação',
            v: 0,
            format: 'plain',
          });
        }

        return {
          total: brl(total),
          sub:
            'US$ ' + moeda(aduaneiroUsd) + ' de valor aduaneiro viram ' + brl(total) +
            ' na sua mão: ' + brl(ii + icms) + ' são imposto (' + pct(sobre) + ' acima do preço)' +
            (dentroLimite ? ' · faixa de 20% só vale em loja habilitada no Remessa Conforme' : ''),
          rows: rows,
          chart: [
            { label: 'Valor da compra', value: Math.round(aduaneiro), tone: 'main' },
            { label: 'Imposto de importação', value: Math.round(ii), tone: 'warn' },
            { label: 'ICMS estadual', value: Math.round(icms), tone: 'bad' },
            { label: 'Taxa fixa', value: Math.round(taxaFixa), tone: 'exit' },
          ].filter((s) => s.value > 0),
        };
      }

      // ---------- Câmbio: cartão, remessa e espécie ----------
      const base = valor * cotacao;
      const referencia =
        op === 'cartao' ? IOF_REFERENCIA.cartao : op === 'remessa' ? IOF_REFERENCIA.remessa : IOF_REFERENCIA.especie;
      const nomeOp =
        op === 'cartao' ? 'Cartão internacional' : op === 'remessa' ? 'Remessa para conta própria' : 'Espécie ou pré-pago';

      const spreadValor = base * spread;
      const comSpread = base + spreadValor;
      const iofValor = comSpread * iofPct;
      const total = comSpread + iofValor + taxaFixa;
      const cotEfetiva = total / valor;
      const custoExtra = base > 0 ? ((total / base) - 1) * 100 : 0;

      const rows = [
        { k: 'Valor pela cotação comercial', ref: moeda(valor) + ' × ' + brl(cotacao) + ' (PTAX)', v: base },
        { k: 'Spread da instituição', ref: pct(spread * 100) + ' sobre a cotação comercial', v: spreadValor },
        { k: 'Subtotal convertido', ref: 'Base sobre a qual o IOF incide', v: comSpread },
        { k: 'IOF da operação', ref: pct(iofPct * 100) + ' · referência para ' + nomeOp.toLowerCase() + ': ' + pct(referencia), v: iofValor },
      ];
      if (taxaFixa > 0) rows.push({ k: 'Taxa fixa da operação', ref: 'Wire fee ou tarifa administrativa', v: taxaFixa });
      rows.push({ k: 'Total em reais', ref: 'O que sai do seu bolso', v: total, extra: true });
      rows.push({ k: 'Cotação efetiva por unidade de moeda', ref: 'Total ÷ moeda estrangeira comprada', v: cotEfetiva, decimals: 4, extra: true });
      rows.push({
        k: 'Custo extra sobre a cotação comercial',
        ref: 'Spread e IOF compostos, não somados',
        v: custoExtra,
        format: 'unit',
        unit: '%',
        decimals: 2,
      });
      if (op === 'remessa') {
        rows.push({
          k: 'Quanto chega lá fora',
          ref: 'Moeda estrangeira efetivamente creditada',
          v: valor,
          format: 'unit',
          unit: 'em moeda estrangeira',
          decimals: 2,
        });
      }
      if (Math.abs(iofPct * 100 - referencia) > 0.01) {
        rows.push({
          k: 'Alíquota informada diferente da referência',
          ref: 'Você usou ' + pct(iofPct * 100) + ' e a referência desta operação é ' + pct(referencia),
          v: 0,
          format: 'plain',
        });
      }

      return {
        total: brl(total),
        sub:
          nomeOp + ': cotação efetiva de ' + brl(cotEfetiva) + ' por unidade, ' + pct(custoExtra) +
          ' acima da comercial de ' + brl(cotacao) + ' · ' + brl(spreadValor + iofValor + taxaFixa) + ' de encargos',
        rows: rows,
        chart: [
          { label: 'Valor pela cotação comercial', value: Math.round(base), tone: 'main' },
          { label: 'Spread da instituição', value: Math.round(spreadValor), tone: 'warn' },
          { label: 'IOF', value: Math.round(iofValor), tone: 'bad' },
          { label: 'Taxa fixa', value: Math.round(taxaFixa), tone: 'exit' },
        ].filter((s) => s.value > 0),
      };
    });
  })();
</script>
