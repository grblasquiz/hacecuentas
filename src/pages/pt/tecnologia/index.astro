---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';
const href='/pt/tecnologia';
const hubs=hubsOfSilo(href);
---
<Layout title="Tecnologia | Hacé Cuentas" description="Quanto custa, consome ou demora minha tecnologia?" canonical={`https://hacecuentas.com${href}`} audience="BR" lang="pt-BR">
  <Header /><SiloIndex silo="Tecnologia" href={href} lede="Quanto custa, consome ou demora minha tecnologia?" hubs={hubs} /><Footer />
</Layout>
