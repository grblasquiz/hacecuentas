---
/** Public reference widget; no analytics so iframe impressions are not site visits. */
export const prerender = true;
import { CATEGORIAS, TOPES, CUOTA_SERVICIOS, CUOTA_BIENES, META } from '../../lib/data/monotributo-2026';
const money=(n:number)=>n.toLocaleString('es-AR',{style:'currency',currency:'ARS'});
const source='https://hacecuentas.com/datos-monotributo-2026?utm_source=tabla_embebida&utm_medium=referral&utm_campaign=monotributo_20261118';
---
<!doctype html><html lang="es-AR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, follow"/><link rel="canonical" href="https://hacecuentas.com/datos-monotributo-2026"/><title>Tabla de Monotributo 2026 para tu sitio — Hacé Cuentas</title></head>
<body><main><header><p class="brand">HACÉ CUENTAS · DATOS ARCA</p><h1>Monotributo 2026: categorías A–K</h1><p>Valores desde <time datetime={META.vigencia}>{META.vigencia.split('-').reverse().join('/')}</time>. Servicios y venta de bienes.</p></header>
<div class="table" tabindex="0" role="region" aria-label="Tabla desplazable de categorías"><table><thead><tr><th scope="col">Categoría</th><th scope="col">Tope anual</th><th scope="col">Cuota servicios</th><th scope="col">Cuota bienes</th></tr></thead><tbody>{CATEGORIAS.map(cat=><tr><th scope="row">{cat}</th><td>{money(TOPES[cat])}</td><td>{money(CUOTA_SERVICIOS[cat])}</td><td>{money(CUOTA_BIENES[cat])}</td></tr>)}</tbody></table></div>
<p class="note">Cuota general con SIPA y obra social individual, sin adherentes. No incluye Ingresos Brutos; hay excepciones previsionales. La categoría también depende de otros parámetros. Confirmá tu situación en ARCA.</p>
<footer><a href={source} target="_blank" rel="noopener">Ver tabla completa y calcular categoría en Hacé Cuentas ↗</a><p>Fuente: <a href={META.fuenteUrl} target="_blank" rel="noopener">ARCA, categorías y valores</a> · Reutilización con atribución CC BY 4.0.</p></footer></main></body></html>
<style is:global>*{box-sizing:border-box}body{margin:0;background:#fff;color:#203d35;font:14px/1.5 system-ui,sans-serif}main{padding:20px;max-width:900px;margin:auto}h1{font-size:23px;line-height:1.2;margin:8px 0}.brand{font-weight:800;font-size:11px;letter-spacing:1.4px;color:#39715d}header p{margin:8px 0 15px}.table{overflow:auto;border:1px solid #dce7e0;border-radius:9px}table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}th,td{padding:10px 12px;border-bottom:1px solid #e2eae4;white-space:nowrap;text-align:right}th:first-child{text-align:left}thead{background:#edf5ef;font-size:12px}tbody tr:last-child th,tbody tr:last-child td{border:0}.note{font-size:12px;color:#546b61}footer{border-top:1px solid #dce7e0;padding-top:12px}a{color:#216248;text-underline-offset:3px}footer>a{font-weight:750}footer p{font-size:12px;margin:8px 0}@media(max-width:450px){main{padding:14px}th,td{padding:9px 8px;font-size:12px}}</style>
