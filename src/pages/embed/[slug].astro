---
export const prerender = false;

import computeIndex from '../../lib/calc-compute-index.json';

type Field = {
  id: string;
  t: string;
  r?: number;
  def?: unknown;
  o?: Array<string | { value?: string; label?: string }>;
};
type Entry = {
  fields?: Field[];
  h?: string;
  cat?: string;
  aud?: string;
  loc?: string;
};

const slug = Astro.params.slug || '';
const calc = (computeIndex as Record<string, Entry>)[slug];
if (!calc) return new Response('Calculadora no encontrada', { status: 404 });

const title = calc.h || slug.replaceAll('-', ' ');
const fields = calc.fields || [];
const sourceUrl = `https://hacecuentas.com/${slug}`;
const labelFor = (id: string) =>
  id.replaceAll('_', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const optionValue = (option: string | { value?: string; label?: string }) =>
  typeof option === 'string' ? option : (option.value || option.label || '');
const optionLabel = (option: string | { value?: string; label?: string }) =>
  typeof option === 'string' ? labelFor(option) : (option.label || option.value || '');
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <title>{title}</title>
  </head>
  <body>
    <main class="widget">
      <header>
        <h1>{title}</h1>
        <a href={sourceUrl} target="_blank" rel="noopener sponsored">por <strong>Hacé Cuentas</strong> ↗</a>
      </header>

      <form id="hc-form">
        {fields.map((field) => (
          <label>
            <span>{labelFor(field.id)}{field.r ? ' *' : ''}</span>
            {field.t === 'select' || field.t === 'radio' ? (
              <select name={field.id} required={Boolean(field.r)}>
                {(field.o || []).map((option) => (
                  <option value={optionValue(option)} selected={String(field.def ?? '') === optionValue(option)}>
                    {optionLabel(option)}
                  </option>
                ))}
              </select>
            ) : field.t === 'boolean' ? (
              <input name={field.id} type="checkbox" checked={Boolean(field.def)} />
            ) : (
              <input
                name={field.id}
                type={field.t === 'date' || field.t === 'datetime-local' ? field.t : field.t === 'number' ? 'number' : 'text'}
                value={String(field.def ?? '')}
                required={Boolean(field.r)}
                step={field.t === 'number' ? 'any' : undefined}
              />
            )}
          </label>
        ))}
        <button type="submit">Calcular</button>
      </form>

      <section id="hc-result" aria-live="polite" hidden></section>
    </main>

    <script is:inline define:vars={{ slug }}>
      (function () {
        var form = document.getElementById('hc-form');
        var result = document.getElementById('hc-result');
        function pretty(value) {
          if (value === null || value === undefined || value === '') return '—';
          if (typeof value === 'object') return JSON.stringify(value, null, 2);
          return String(value);
        }
        function postHeight() {
          if (window.parent !== window) {
            window.parent.postMessage({ type: 'hc-embed-height', slug: slug, height: document.documentElement.scrollHeight }, '*');
          }
        }
        form.addEventListener('submit', async function (event) {
          event.preventDefault();
          var button = form.querySelector('button');
          var inputs = {};
          Array.from(form.elements).forEach(function (control) {
            if (!control.name) return;
            if (control.type === 'checkbox') inputs[control.name] = control.checked;
            else if (control.value !== '') inputs[control.name] = control.value;
          });
          button.disabled = true;
          button.textContent = 'Calculando…';
          result.hidden = false;
          result.innerHTML = '<p>Calculando…</p>';
          try {
            var response = await fetch('/api/calc/' + encodeURIComponent(slug) + '/compute', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ inputs: inputs, lang: 'es' })
            });
            var data = await response.json();
            if (!response.ok || !data.ok) throw new Error(data.message || 'No se pudo calcular');
            var rows = Object.entries(data.result || {}).map(function (entry) {
              return '<div><dt>' + entry[0].replaceAll('_', ' ') + '</dt><dd><pre>' + pretty(entry[1]).replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</pre></dd></div>';
            }).join('');
            result.innerHTML = '<h2>Resultado</h2><dl>' + rows + '</dl>';
          } catch (error) {
            result.innerHTML = '<p class="error">' + (error && error.message ? error.message : 'No se pudo calcular') + '</p>';
          } finally {
            button.disabled = false;
            button.textContent = 'Calcular';
            postHeight();
          }
        });
        new ResizeObserver(postHeight).observe(document.body);
        window.addEventListener('load', postHeight);
      })();
    </script>
  </body>
</html>

<style>
  :root { color-scheme: light; font-family: Inter, system-ui, sans-serif; color: #10213a; background: #fff; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  .widget { max-width: 720px; margin: auto; padding: 20px; }
  header { display: flex; align-items: start; justify-content: space-between; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid #e2e8f0; }
  h1 { margin: 0; font-size: clamp(1.25rem, 4vw, 1.75rem); line-height: 1.2; }
  header a { flex: none; color: #2563eb; font-size: .8rem; text-decoration: none; }
  form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 20px; }
  label { display: grid; gap: 6px; color: #475569; font-size: .86rem; font-weight: 700; }
  input, select { width: 100%; min-height: 44px; border: 1px solid #cbd5e1; border-radius: 9px; padding: 9px 11px; background: #fff; color: #0f172a; font: inherit; }
  input:focus, select:focus { outline: 3px solid #dbeafe; border-color: #2563eb; }
  input[type="checkbox"] { width: 22px; min-height: 22px; }
  button { grid-column: 1 / -1; min-height: 46px; border: 0; border-radius: 10px; background: #2563eb; color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
  button:disabled { opacity: .65; cursor: wait; }
  #hc-result { margin-top: 20px; padding: 18px; border-radius: 12px; background: #f1f5f9; }
  #hc-result h2 { margin: 0 0 12px; font-size: 1.1rem; }
  dl { display: grid; gap: 10px; margin: 0; }
  dl div { display: grid; grid-template-columns: minmax(120px, .8fr) minmax(0, 1.2fr); gap: 12px; padding-bottom: 8px; border-bottom: 1px solid #dbe3ec; }
  dt { color: #64748b; text-transform: capitalize; }
  dd { margin: 0; font-weight: 700; }
  pre { margin: 0; white-space: pre-wrap; font: inherit; }
  .error { color: #b91c1c; }
  @media (max-width: 540px) { form { grid-template-columns: 1fr; } header { display: grid; } dl div { grid-template-columns: 1fr; gap: 3px; } }
</style>
