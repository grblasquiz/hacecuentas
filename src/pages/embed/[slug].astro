---
export const prerender = true;

import Calculator from '../../components/Calculator.astro';
import { filterByIncremental } from '../../lib/incremental';
import { canEmbedCalc } from '../../lib/content-policy';

export async function getStaticPaths() {
  const calcs = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
  const all = Object.values(calcs).map((mod: any) => mod.default || mod);
  return filterByIncremental(all, 'calcs', 'ar').map((c: any) => ({
    params: { slug: c.slug },
    props: { calc: c },
  }));
}

const { calc } = Astro.props;
// Restringidas (YMYL) no se pueden embeber: mostramos un aviso sin calculadora.
const embeddable = canEmbedCalc(calc);
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <title>{calc.title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="embed-wrap">
      <div class="embed-head">
        <h1 class="embed-title">{calc.icon} {calc.h1}</h1>
        <a href={`https://hacecuentas.com/${calc.slug}`} target="_blank" rel="noopener sponsored" class="embed-source">
          por <strong>Hacé Cuentas</strong> ↗
        </a>
      </div>
      {embeddable ? (
        <Calculator config={calc} />
      ) : (
        <div class="embed-unavailable" role="note">
          <p><strong>Esta herramienta no está disponible para embeber.</strong></p>
          <p>Por seguridad, esta calculadora no ofrece una versión insertable. Podés
            consultarla en <a href={`https://hacecuentas.com/${calc.slug}`} target="_blank" rel="noopener">Hacé Cuentas</a>.</p>
        </div>
      )}
    </div>

    <script is:inline define:vars={{ slug: calc.slug, name: calc.h1 }}>
      // Auto-resize: posta su height al parent iframe
      function postHeight() {
        var h = document.documentElement.scrollHeight;
        if (window.parent !== window) {
          window.parent.postMessage({ type: 'hc-embed-height', slug: slug, height: h }, '*');
        }
      }
      // Posta el nombre real de la calc para que el loader arme el anchor del backlink.
      function postMeta() {
        if (window.parent !== window) {
          window.parent.postMessage({ type: 'hc-embed-meta', slug: slug, name: name }, '*');
        }
      }
      var ro = new ResizeObserver(postHeight);
      ro.observe(document.body);
      window.addEventListener('load', function () { postHeight(); postMeta(); });
    </script>

    <!-- Partner Studio: aplica tema/logo/título/CTA desde la querystring y
         puentea eventos al parent (web component <hace-cuentas>). Los params de
         prefill (name=value) ya los consume el script propio de Calculator. -->
    <script is:inline define:vars={{ EMBED_SLUG: calc.slug }}>
      (function () {
        var p = new URLSearchParams(location.search);
        var root = document.documentElement;

        // Tema: accent del partner.
        var accent = p.get('accent');
        if (accent && /^#[0-9a-fA-F]{3,8}$/.test(accent)) {
          root.style.setProperty('--accent', accent);
          root.style.setProperty('--accent-hover', accent);
          root.style.setProperty('--accent-strong', accent);
        }

        // Título personalizado.
        var title = p.get('title');
        if (title) {
          var h = document.querySelector('.embed-title');
          if (h) h.textContent = title;
          try { document.title = title; } catch (e) {}
        }

        // Logo del partner en el encabezado.
        var logo = p.get('logo');
        if (logo && /^https:\/\//.test(logo)) {
          var head = document.querySelector('.embed-head');
          if (head) {
            var img = document.createElement('img');
            img.src = logo;
            img.alt = '';
            img.setAttribute('aria-hidden', 'true');
            img.style.cssText = 'max-height:28px;max-width:140px;width:auto;height:auto;object-fit:contain;flex-shrink:0';
            head.insertBefore(img, head.firstChild);
          }
        }

        // Ocultar atribución (sólo llega noattr=1 si el web component lo autorizó).
        if (p.get('noattr') === '1') {
          var src = document.querySelector('.embed-source');
          if (src) src.style.display = 'none';
        }

        // Puente de eventos hacia el parent.
        var ctaLabel = p.get('cta');
        var ctaUrl = p.get('ctaurl');
        var container = document.querySelector('.calc-container');

        function postEvent(event, detail) {
          if (window.parent !== window) {
            window.parent.postMessage({ type: 'hc-embed-event', event: event, slug: EMBED_SLUG, detail: detail || {} }, '*');
          }
        }

        if (container) {
          var ctaInjected = false;
          // Calculó: el contenedor dispara hc-calc-result con el primary ya formateado.
          container.addEventListener('hc-calc-result', function (e) {
            var primary = (e.detail && e.detail.primary) || '';
            postEvent('calculate', { primary: primary, slug: EMBED_SLUG });

            // CTA propio del partner debajo del resultado.
            if (ctaLabel && ctaUrl && /^https:\/\//.test(ctaUrl) && !ctaInjected) {
              ctaInjected = true;
              var results = document.querySelector('.calc-results');
              if (results) {
                var wrap = document.createElement('div');
                wrap.style.cssText = 'margin-top:1rem;text-align:center';
                var a = document.createElement('a');
                a.href = ctaUrl;
                a.target = '_top';
                a.rel = 'noopener';
                a.textContent = ctaLabel;
                a.style.cssText = 'display:inline-block;background:var(--accent);color:#fff;font-weight:600;font-size:.9375rem;padding:.6rem 1.25rem;border-radius:10px;text-decoration:none';
                a.addEventListener('click', function () { postEvent('complete', { cta: ctaUrl }); });
                wrap.appendChild(a);
                results.appendChild(wrap);
              }
            }
          });

          // Compartir/copiar.
          container.addEventListener('click', function (e) {
            var t = e.target;
            var btn = t && t.closest ? t.closest('[data-action]') : null;
            if (!btn) return;
            var action = btn.getAttribute('data-action');
            if (action === 'share' || action === 'whatsapp' || action === 'copy' || action === 'embed' || action === 'copyLink') {
              postEvent('share', { action: action });
            }
          });
        }
      })();
    </script>

    <style is:global>
      :root {
        --bg: #ffffff;
        --bg-soft: #f8fafc;
        --bg-muted: #f1f5f9;
        --bg-card: #ffffff;
        --border: #e2e8f0;
        --border-strong: #cbd5e1;
        --text: #0f172a;
        --text-muted: #475569;
        --text-subtle: #64748b;
        --accent: #2563eb;
        --accent-hover: #1d4ed8;
        --accent-soft: #eff6ff;
        --accent-strong: #1e40af;
        --success: #16a34a;
        --success-soft: #f0fdf4;
        --danger: #dc2626;
        --danger-soft: #fef2f2;
        --shadow-sm: 0 1px 2px 0 rgb(15 23 42 / 0.05);
        --shadow: 0 1px 3px 0 rgb(15 23 42 / 0.08), 0 1px 2px -1px rgb(15 23 42 / 0.06);
        --shadow-md: 0 4px 6px -1px rgb(15 23 42 / 0.08);
        --shadow-lg: 0 10px 15px -3px rgb(15 23 42 / 0.1);
        --radius-sm: 6px;
        --radius: 10px;
        --radius-lg: 14px;
        --font-body: 'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', 'SF Mono', Monaco, monospace;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-family: var(--font-body); -webkit-font-smoothing: antialiased; }
      body { background: var(--bg); color: var(--text); font-size: 15px; line-height: 1.5; padding: 1rem; }
      .embed-wrap { max-width: 720px; margin: 0 auto; }
      .embed-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border);
      }
      .embed-title {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.3;
      }
      .embed-source {
        font-size: 0.75rem;
        color: var(--text-subtle);
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .embed-source strong { color: var(--accent); }
      .embed-source:hover strong { text-decoration: underline; }
      /* Hide share buttons inside embeds (they depend on parent page) */
      .embed-wrap .share .btn-share[data-action="embed"],
      .embed-wrap .share .btn-share[data-action="whatsapp"] { display: none; }
    </style>
  </body>
</html>
