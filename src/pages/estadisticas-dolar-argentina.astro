---
// @incremental-standalone — página de estadísticas citables del dólar en Argentina.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import blueDs from '../../public/datasets/dolar-blue-argentina-historico.json';
import oficialDs from '../../public/datasets/dolar-oficial-argentina-historico.json';

const URL = 'https://hacecuentas.com/estadisticas-dolar-argentina';
type Row = { fecha: string; compra_ars: number; venta_ars: number };
const blue = (blueDs.data as Row[]).slice().sort((a, b) => a.fecha.localeCompare(b.fecha));
const oficial = (oficialDs.data as Row[]).slice().sort((a, b) => a.fecha.localeCompare(b.fecha));
const nf = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 });
const nf1 = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 1 });
const ars = (v: number) => `$${nf.format(v)}`;
const pct = (v: number) => `${nf1.format(v)}%`;
const dateFmt = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const firstBlue = blue[0], lastBlue = blue[blue.length - 1];
const lastOficial = oficial[oficial.length - 1];
const oficialMap = new Map(oficial.map((r) => [r.fecha, r]));
const gaps = blue.map((r) => { const o = oficialMap.get(r.fecha); return o && o.venta_ars ? { fecha: r.fecha, gap: (r.venta_ars / o.venta_ars - 1) * 100 } : null; }).filter(Boolean) as { fecha: string; gap: number }[];
const maxGap = gaps.reduce((a, b) => (b.gap > a.gap ? b : a));
const currentGap = gaps[gaps.length - 1];
const multiplier = lastBlue.venta_ars / firstBlue.venta_ars;

const yearEnd = new Map<string, number>();
for (const r of blue) yearEnd.set(r.fecha.slice(0, 4), r.venta_ars);
const years = [...yearEnd.keys()].sort();
const annualRises = years.slice(1).map((y, i) => ({ year: y, rise: (yearEnd.get(y)! / yearEnd.get(years[i])! - 1) * 100, close: yearEnd.get(y)! }));
const topRises = annualRises.slice().sort((a, b) => b.rise - a.rise).slice(0, 5);
const recentYears = annualRises.slice(-8).reverse();
const currentYear = lastBlue.fecha.slice(0, 4);

const faqs = [
  { q: '¿A cuánto está el dólar blue hoy en Argentina?', a: `Al ${dateFmt(lastBlue.fecha)}, el dólar blue cotiza a ${ars(lastBlue.venta_ars)} para la venta y el oficial a ${ars(lastOficial.venta_ars)}. La brecha entre ambos es de ${pct(currentGap.gap)}.` },
  { q: '¿Cuánto subió el dólar blue desde 2011?', a: `Pasó de ${ars(firstBlue.venta_ars)} en enero de 2011 a ${ars(lastBlue.venta_ars)}: se multiplicó por ${nf.format(multiplier)} en ${years.length} años.` },
  { q: '¿Cuál fue la mayor brecha entre el dólar blue y el oficial?', a: `El ${dateFmt(maxGap.fecha)} la brecha llegó a ${pct(maxGap.gap)}, el máximo de toda la serie.` },
  { q: '¿En qué año subió más el dólar blue?', a: `${topRises[0].year}, con una suba de ${pct(topRises[0].rise)}. Le siguen ${topRises[1].year} (${pct(topRises[1].rise)}) y ${topRises[2].year} (${pct(topRises[2].rise)}).` },
  { q: '¿Qué es la brecha cambiaria?', a: 'Es la diferencia porcentual entre el dólar paralelo (blue) y el oficial. Cuando hay restricciones para comprar dólares al tipo de cambio oficial, la brecha tiende a ampliarse.' },
  { q: '¿Qué diferencia hay entre dólar blue y dólar oficial?', a: 'El oficial es el tipo de cambio de referencia que publican los bancos; el blue es el que surge del mercado informal. Esta serie registra ambos, día por día, desde 2011.' },
  { q: '¿Cada cuánto se actualizan estos datos?', a: `La serie se actualiza automáticamente con cada rueda cambiaria. El último dato cargado es del ${dateFmt(lastBlue.fecha)}.` },
  { q: '¿Puedo descargar la serie histórica del dólar?', a: 'Sí: las series completas del blue y del oficial están disponibles en CSV y JSON bajo licencia CC BY 4.0, con atribución y enlace a Hacé Cuentas.' },
];
const schema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'Article', headline: `Estadísticas del dólar en Argentina: blue y oficial desde 2011`, description: `Serie diaria del dólar blue y oficial: ${blue.length.toLocaleString('es-AR')} cotizaciones, brecha cambiaria histórica y récords por año.`, url: URL, datePublished: '2026-08-19', dateModified: blueDs.generatedAt, author: { '@type': 'Person', name: 'Martín Rodríguez', url: 'https://hacecuentas.com/autores/martin-rodriguez' }, publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' } },
    { '@type': 'Dataset', name: 'Dólar blue y oficial en Argentina — serie diaria', description: `Cotizaciones diarias de compra y venta del dólar blue y oficial desde ${firstBlue.fecha} hasta ${lastBlue.fecha}.`, url: URL, license: 'https://creativecommons.org/licenses/by/4.0/', temporalCoverage: `${firstBlue.fecha}/${lastBlue.fecha}`, spatialCoverage: 'Argentina', creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' }, isBasedOn: blueDs.sourceUrl, distribution: [
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datasets/dolar-blue-argentina-historico.csv' },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datasets/dolar-blue-argentina-historico.json' },
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datasets/dolar-oficial-argentina-historico.csv' },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datasets/dolar-oficial-argentina-historico.json' },
    ] },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' }, { '@type': 'ListItem', position: 2, name: 'Estadísticas del dólar en Argentina', item: URL }] },
  ],
};
---

<Layout title={`Estadísticas del dólar en Argentina: blue y oficial desde 2011 (${blue.length.toLocaleString('es-AR')} datos)`} description={`El dólar blue en cifras: hoy ${ars(lastBlue.venta_ars)}, se multiplicó por ${nf.format(multiplier)} desde 2011, brecha récord ${pct(maxGap.gap)} en 2023. Series diarias descargables en CSV y JSON.`} canonical={URL} schema={schema} lang="es" audience="AR" ogType="article" articlePublishedTime="2026-08-19" articleModifiedTime={blueDs.generatedAt} domain="data">
  <Header />
  <main class="stats-page">
    <article>
      <nav aria-label="Migas de pan"><a href="/">Inicio</a><span>›</span><span>Estadísticas del dólar</span></nav>
      <header class="hero">
        <p class="eyebrow">Investigación propia · Datos al {dateFmt(lastBlue.fecha)}</p>
        <h1>Estadísticas del dólar en Argentina: {years.length} años de blue y oficial</h1>
        <p class="lede">{blue.length.toLocaleString('es-AR')} cotizaciones diarias del dólar blue y su comparación con el oficial: la brecha cambiaria día por día, los años de mayor devaluación y los récords históricos. Los números se recalculan automáticamente con cada rueda.</p>
        <p class="scope"><strong>Alcance:</strong> serie diaria desde enero de 2011. Ambas series completas se pueden descargar más abajo (CC BY 4.0).</p>
      </header>

      <section aria-labelledby="resumen"><h2 id="resumen">Los números principales</h2><div class="metric-grid">
        <div><strong>{ars(lastBlue.venta_ars)}</strong><span>dólar blue hoy (venta)</span></div>
        <div><strong>{ars(lastOficial.venta_ars)}</strong><span>dólar oficial hoy (venta)</span></div>
        <div><strong>{pct(currentGap.gap)}</strong><span>brecha cambiaria actual</span></div>
        <div><strong>×{nf.format(multiplier)}</strong><span>multiplicación del blue desde 2011</span></div>
        <div><strong>{pct(maxGap.gap)}</strong><span>brecha récord ({dateFmt(maxGap.fecha)})</span></div>
        <div><strong>{blue.length.toLocaleString('es-AR')}</strong><span>cotizaciones diarias registradas</span></div>
      </div></section>

      <section><h2>Los 5 años de mayor suba del blue</h2><p>Variación del precio de venta entre el cierre de cada año y el anterior.</p><ol class="ranking">{topRises.map((r) => <li><span>{r.year}</span><strong>+{pct(r.rise)}</strong></li>)}</ol></section>

      <section><h2>Evolución anual reciente</h2><div class="table-wrap"><table><thead><tr><th>Año</th><th>Cierre del blue</th><th>Variación anual</th></tr></thead><tbody>{recentYears.map((r) => <tr><th>{r.year}{r.year === currentYear ? ' (parcial)' : ''}</th><td>{ars(r.close)}</td><td><strong>{r.rise >= 0 ? '+' : ''}{pct(r.rise)}</strong></td></tr>)}</tbody></table></div></section>

      <section class="method"><h2>Metodología y límites</h2><p>La serie registra los precios de compra y venta publicados en cada rueda cambiaria para el dólar oficial minorista y el paralelo (blue). La brecha se calcula sobre el precio de venta de ambos en la misma fecha. Los fines de semana y feriados no hay cotización.</p><p><a href="/metodologia">Leé la metodología editorial completa</a>.</p></section>

      <section class="downloads"><h2>Descargar las series completas</h2><p>Licencia CC BY 4.0: reutilizalas con atribución y enlace a esta página.</p><div><a href="/datasets/dolar-blue-argentina-historico.csv" download>Blue — CSV</a><a href="/datasets/dolar-blue-argentina-historico.json" download>Blue — JSON</a><a href="/datasets/dolar-oficial-argentina-historico.csv" download>Oficial — CSV</a><a href="/datasets/dolar-oficial-argentina-historico.json" download>Oficial — JSON</a></div></section>

      <section><h2>Cómo citar</h2><blockquote>Hacé Cuentas ({currentYear}). “Estadísticas del dólar en Argentina”. Series diarias 2011–{currentYear} del dólar blue y oficial. {URL}</blockquote></section>

      <section><h2>Herramientas relacionadas</h2><ol class="ranking">
        <li><a href="/dolar-hoy">Dólar hoy: todas las cotizaciones vigentes</a><strong>Datos</strong></li>
        <li><a href="/cambio-de-monedas">Conversor de monedas</a><strong>Calculadora</strong></li>
        <li><a href="/estadisticas-inflacion-argentina">Estadísticas de inflación en Argentina</a><strong>Informe</strong></li>
        <li><a href="/estadisticas-plazo-fijo-uva-argentina">Estadísticas de plazo fijo y UVA</a><strong>Informe</strong></li>
      </ol></section>

      <section><h2>Preguntas frecuentes</h2>{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .stats-page{max-width:1080px;margin:0 auto;padding:clamp(1rem,3vw,2rem);color:var(--text,#18283a)}article>nav{display:flex;gap:.5rem;color:var(--text-muted,#64748b);font-size:.85rem}.hero{padding:clamp(2rem,6vw,4rem) 0}.eyebrow{color:var(--accent,#23648d);font-size:.78rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}h1{max-width:850px;margin:.4rem 0;font-size:clamp(2.3rem,7vw,4.4rem);line-height:1.02}.lede{max-width:820px;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.65}.scope{max-width:820px;padding:1rem;border-left:4px solid #2e7ca7;background:var(--bg-soft,#eef6fa)}section{margin:clamp(2.5rem,6vw,5rem) 0}h2{font-size:clamp(1.5rem,3vw,2.2rem)}.metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem}.metric-grid>div{display:flex;flex-direction:column;padding:1.2rem;border:1px solid var(--border,#dce3e9);border-radius:15px;background:var(--bg-card,#fff)}.metric-grid strong{font-size:clamp(1.7rem,4vw,2.6rem);color:var(--accent,#173c5d)}.metric-grid span{color:var(--text-muted,#526477);font-size:.85rem}.table-wrap{overflow-x:auto;border:1px solid var(--border,#dce3e9);border-radius:14px}table{width:100%;border-collapse:collapse}th,td{padding:.8rem 1rem;border-bottom:1px solid var(--border,#e5e7eb);text-align:right}th:first-child{text-align:left}.ranking{display:grid;gap:.55rem;padding:0;list-style:none}.ranking li{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-bottom:1px solid var(--border,#e5e7eb)}.ranking a{color:var(--accent,#23648d);font-weight:700}.method,.downloads{padding:clamp(1.25rem,3vw,2rem);border-radius:18px;background:var(--bg-soft,#f4f7f9)}.downloads div{display:flex;flex-wrap:wrap;gap:.75rem}.downloads a{padding:.8rem 1rem;border-radius:10px;background:#176b91;color:#fff;font-weight:800;text-decoration:none}blockquote{margin:0;padding:1.25rem;border-left:4px solid #2e7ca7;background:var(--bg-soft,#eef6fa);line-height:1.6}details{padding:1rem 0;border-bottom:1px solid var(--border,#dce3e9)}summary{cursor:pointer;font-weight:800}details p{line-height:1.65}@media(max-width:600px){th,td{padding:.65rem .55rem;font-size:.8rem}.ranking li{align-items:flex-start;flex-direction:column}}
</style>
