---
/**
 * Hub de decisión CL — "Me separo: cuánto cuesta, cómo se reparten los bienes y
 * de cuánto es la pensión de alimentos."
 * Ruta bajo el prefijo /cl/, igual que las calculadoras que absorbe.
 * audience="CL" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  UF,
  UTM,
  IMR,
  PISO_ALIMENTOS,
  TECHO_ALIMENTOS_PCT,
  REGISTRO_DEUDORES,
  VIAS,
  INCREMENTOS,
  COSTO_TRAMITE,
  REGIMENES,
  CUSTODIAS,
  CAPACIDADES,
} from '../../../lib/hubs/cl/separarse-en-chile';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CL"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    UF, UTM, IMR, PISO_ALIMENTOS, TECHO_ALIMENTOS_PCT, REGISTRO_DEUDORES,
    VIAS, INCREMENTOS, COSTO_TRAMITE, REGIMENES, CUSTODIAS, CAPACIDADES,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const clp = (n) => '$' + Math.round(n || 0).toLocaleString('es-CL');
    const pick = (arr, id, def) => arr.find((x) => x.id === id) || arr[def || 0];
    const num = (x) => Math.max(0, Number(x) || 0);

    // ── Costo y plazo del divorcio ───────────────────────────────────────────
    // Espejo de divorcio-chile-cese-convivencia-3-anos.ts, con una corrección:
    // los "aranceles de tribunal" de $80.000 a $120.000 no existen. Los
    // tribunales de familia no cobran arancel. Acá el costo de trámite son los
    // certificados del Registro Civil y, si hay inmuebles, escritura e
    // inscripción en el Conservador.
    function divorcio(v, viaId) {
      const via = pick(VIAS, viaId, 0);
      const hijos = Math.max(0, Math.round(Number(v.hijos) || 0));
      const complejidad = v.complejidad || 'si_simple';
      const sinAcuerdo = v.acuerdoHijos === 'no' && hijos > 0;

      let honMin = via.honMin;
      let honMax = via.honMax;
      let mesesMin = via.mesesMin;
      let mesesMax = via.mesesMax;

      const porHijos = hijos * INCREMENTOS.porHijo;
      honMin += porHijos;
      honMax += porHijos;
      if (hijos > 0) mesesMax += 1;

      let porBienes = 0;
      if (complejidad === 'si_simple') { porBienes = INCREMENTOS.bienesSimples; mesesMax += 1; }
      else if (complejidad === 'si_complejo') { porBienes = INCREMENTOS.bienesComplejos; mesesMax += 2; }
      honMin += porBienes;
      honMax += porBienes;

      let porDeudas = 0;
      if (num(v.deudasComunes) > 0) { porDeudas = INCREMENTOS.deudasCompartidas; mesesMax += 1; }
      honMin += porDeudas;
      honMax += porDeudas;

      let porCustodia = 0;
      if (sinAcuerdo) { porCustodia = INCREMENTOS.sinAcuerdoCustodia; mesesMax += 2; }
      honMin += porCustodia;
      honMax += porCustodia;

      // Honorarios cotizados pisan la estimación.
      const cotizado = num(v.honorarios);
      if (cotizado > 0) { honMin = cotizado; honMax = cotizado; }

      const certificados = COSTO_TRAMITE.certificadosRegistroCivil;
      const conInmuebles = complejidad !== 'no';
      const escritura = conInmuebles ? COSTO_TRAMITE.escrituraNotarial : 0;
      const conservador = conInmuebles ? COSTO_TRAMITE.inscripcionConservador : 0;
      const tramite = certificados + escritura + conservador;

      return {
        via, hijos, sinAcuerdo, cotizado,
        honMin, honMax, porHijos, porBienes, porDeudas, porCustodia,
        certificados, escritura, conservador, tramite,
        totalMin: honMin + tramite,
        totalMax: honMax + tramite,
        mesesMin, mesesMax,
      };
    }

    // ── Partición de bienes ──────────────────────────────────────────────────
    // Reescrito respecto de la fórmula vieja, que tenía tres errores: mostraba
    // "100% / 0%" en separación de bienes, dejaba muerta la rama de
    // participación en gananciales (las dos ganancias eran idénticas por
    // construcción) y cobraba un "impuesto de transferencia" del 1,25% que no
    // existe: la adjudicación en la partición de una comunidad no es enajenación.
    function particion(v) {
      const reg = pick(REGIMENES, v.regimen, 0);
      const comunes = num(v.bienesComunes);
      const deudasComunes = num(v.deudasComunes);
      const propiosA = num(v.propiosA);
      const propiosB = num(v.propiosB);
      const gananciales = Math.max(0, comunes - deudasComunes);

      let cuotaA = 0, cuotaB = 0, credito = 0, deudaA = 0, deudaB = 0, nota = '';

      if (reg.id === 'sociedad_conyugal') {
        cuotaA = gananciales * 0.5;
        cuotaB = gananciales * 0.5;
        deudaA = deudasComunes * 0.5;
        deudaB = deudasComunes * 0.5;
        nota = 'Los gananciales se dividen por mitades (Art. 1774 CC), después de pagar el pasivo social.';
      } else if (reg.id === 'separacion_bienes') {
        cuotaA = 0;
        cuotaB = 0;
        nota = 'No hay masa que partir: cada cónyuge conserva sus bienes y responde de sus deudas.';
      } else {
        // Participación en los gananciales: el que ganó menos tiene un crédito
        // por la mitad del exceso. Acá el proxy de "ganancial" de cada uno son
        // sus bienes propios acumulados durante el matrimonio.
        const gananciaA = propiosA;
        const gananciaB = propiosB;
        const exceso = Math.abs(gananciaA - gananciaB);
        credito = exceso * 0.5;
        nota = gananciaA > gananciaB
          ? 'El cónyuge que hace el cálculo ganó más: le debe al otro la mitad del exceso.'
          : gananciaB > gananciaA
            ? 'El otro cónyuge ganó más: te debe la mitad del exceso como crédito de participación.'
            : 'Ambos obtuvieron gananciales equivalentes: no hay crédito de participación.';
      }

      const signoCredito = reg.id === 'participacion_gananciales'
        ? (propiosA > propiosB ? -credito : credito)
        : 0;

      const totalA = Math.max(0, propiosA + cuotaA + signoCredito - deudaA);
      const totalB = Math.max(0, propiosB + cuotaB - signoCredito - deudaB);
      const suma = totalA + totalB;

      return {
        reg, comunes, deudasComunes, propiosA, propiosB, gananciales,
        cuotaA, cuotaB, deudaA, deudaB, credito, signoCredito, nota,
        totalA, totalB, suma,
        pctA: suma > 0 ? (totalA / suma) * 100 : 0,
        pctB: suma > 0 ? (totalB / suma) * 100 : 0,
      };
    }

    // ── Pensión de alimentos ─────────────────────────────────────────────────
    // La fórmula vieja NO escalaba con el número de hijos (numero_hijos sólo
    // aparecía en código muerto), no aplicaba el piso legal del Art. 3 de la
    // Ley 14.908 y no aplicaba el techo del 50% del Art. 7. Acá se aplican los
    // tres. El porcentaje por hijo es un criterio orientativo declarado, no ley.
    function alimentos(v) {
      const hijos = Math.max(0, Math.round(Number(v.hijos) || 0));
      const bruto = num(v.ingresoAlimentante);
      const desc = Math.min(60, Math.max(0, Number(v.descuentosPct) || 0)) / 100;
      const liquido = bruto * (1 - desc);
      const custodia = pick(CUSTODIAS, v.custodia, 0);
      const capacidad = pick(CAPACIDADES, v.capacidad, 1);
      const extras = num(v.gastosExtra);

      // Piso legal Art. 3 Ley 14.908, en ingreso mínimo remuneracional.
      const pisoPorHijo = hijos === 1 ? PISO_ALIMENTOS.unHijo : PISO_ALIMENTOS.dosOMasPorHijo;
      const pisoLegal = hijos > 0 ? IMR * pisoPorHijo * hijos : 0;

      // Techo legal Art. 7 Ley 14.908: 50% de las rentas del alimentante.
      const techoLegal = bruto * TECHO_ALIMENTOS_PCT;

      // Criterio orientativo de capacidad económica: 20% del líquido por el
      // primer hijo y 10% adicional por cada hijo siguiente, ajustado por el
      // régimen de cuidado personal y por la capacidad económica.
      const pctBase = hijos > 0 ? Math.min(0.5, 0.2 + 0.1 * (hijos - 1)) : 0;
      const pctAjustado = Math.max(0, pctBase * (1 + custodia.ajuste) + capacidad.ajuste * (hijos > 0 ? 1 : 0));
      const porCapacidad = liquido * pctAjustado;

      // El monto estimado es el mayor entre el piso legal y la capacidad, topado.
      const antesDeTecho = Math.max(pisoLegal, porCapacidad);
      const pension = Math.min(antesDeTecho, techoLegal);
      const topeAplicado = antesDeTecho > techoLegal;
      const pisoManda = pisoLegal > porCapacidad;

      return {
        hijos, bruto, liquido, custodia, capacidad, extras,
        pisoPorHijo, pisoLegal, techoLegal,
        pctBase, pctAjustado, porCapacidad,
        pension, topeAplicado, pisoManda,
        total: pension + extras,
        porHijo: hijos > 0 ? pension / hijos : 0,
        pctDelLiquido: liquido > 0 ? (pension / liquido) * 100 : 0,
        pctDeLasRentas: bruto > 0 ? ((pension + extras) / bruto) * 100 : 0,
      };
    }

    // ── Mora y Registro Nacional de Deudores ─────────────────────────────────
    // La fórmula vieja aplicaba un 27% anual citando el "Art. 22 del Código
    // Civil" (que regula interpretación de la ley, no intereses) y activaba el
    // registro a las 2 cuotas. La ley manda reajustar por IPC y aplicar el
    // interés corriente; el registro se activa con 3 cuotas consecutivas o 5
    // discontinuas (Ley 21.389).
    function mora(v) {
      const cuotas = Math.max(0, Math.round(Number(v.cuotasImpagas) || 0));
      const pension = num(v.pensionFijada);
      const ipc = Math.max(0, Number(v.ipcAcumulado) || 0) / 100;
      const tasa = Math.max(0, Number(v.interesAnual) || 0) / 100;

      const capital = pension * cuotas;
      const reajuste = capital * ipc;
      const capitalReajustado = capital + reajuste;
      // Interés simple sobre el capital reajustado, promediando la antigüedad
      // de las cuotas: en promedio cada cuota lleva cuotas/2 meses de mora.
      const mesesPromedio = cuotas / 2;
      const interes = capitalReajustado * tasa * (mesesPromedio / 12);
      const deuda = capitalReajustado + interes;

      const inscribible = cuotas >= REGISTRO_DEUDORES.cuotasConsecutivas;
      return {
        cuotas, pension, ipc, tasa, capital, reajuste, capitalReajustado,
        mesesPromedio, interes, deuda, inscribible,
        faltanCuotas: Math.max(0, REGISTRO_DEUDORES.cuotasConsecutivas - cuotas),
      };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'mutuo_acuerdo';
      const rows = [];
      let total, sub, chart;

      if (id === 'particion') {
        const p = particion(v);
        rows.push({ k: 'Régimen patrimonial', ref: p.reg.norma, v: 0, format: 'plain' });
        rows.push({ k: 'Bienes sociales o comunes', ref: 'Adquiridos durante el matrimonio', v: p.comunes });
        rows.push({ k: 'Deudas sociales o comunes', ref: 'Pasivo a pagar antes de repartir', v: p.deudasComunes });
        if (p.reg.id === 'sociedad_conyugal') {
          rows.push({ k: 'Gananciales netos a repartir', ref: 'Activo social menos pasivo social', v: p.gananciales, extra: true });
          rows.push({ k: 'Mitad de gananciales de cada cónyuge', ref: 'Art. 1774 CC · por mitades', v: p.cuotaA });
          rows.push({ k: 'Deuda social que asume cada uno', ref: 'La mitad del pasivo social', v: p.deudaA });
        } else if (p.reg.id === 'participacion_gananciales') {
          rows.push({ k: 'Crédito de participación', ref: 'La mitad del exceso · Art. 1792-19 CC', v: p.credito, extra: true });
        }
        rows.push({ k: 'Bienes propios de quien hace el cálculo', ref: 'No entran en la mitad de gananciales', v: p.propiosA });
        rows.push({ k: 'Bienes propios del otro cónyuge', ref: 'No entran en la mitad de gananciales', v: p.propiosB });
        rows.push({ k: 'Te quedas con', ref: p.pctA.toFixed(1).replace('.', ',') + '% del total repartido', v: p.totalA, extra: true });
        rows.push({ k: 'El otro cónyuge se queda con', ref: p.pctB.toFixed(1).replace('.', ',') + '% del total repartido', v: p.totalB, extra: true });
        rows.push({ k: 'Impuesto por la adjudicación de bienes en la partición', ref: 'La adjudicación no es enajenación: no hay mayor valor', v: 0 });
        rows.push({ k: 'Escritura pública de liquidación', ref: 'Sólo si hay bienes que traspasar', v: COSTO_TRAMITE.escrituraNotarial });
        rows.push({ k: 'Inscripción en el Conservador de Bienes Raíces', ref: 'Por inmueble que cambia de titular', v: COSTO_TRAMITE.inscripcionConservador });
        total = clp(p.totalA);
        sub = p.reg.nombre + ': te quedas con ' + clp(p.totalA) + ' y el otro cónyuge con ' + clp(p.totalB) + '. ' + p.nota;
        chart = [
          { label: 'Tu parte', value: Math.round(p.totalA), tone: 'main' },
          { label: 'Parte del otro cónyuge', value: Math.round(p.totalB), tone: 'prop' },
          { label: 'Deudas que se pagan antes', value: Math.round(p.deudasComunes), tone: 'bad' },
        ].filter((s) => s.value > 0);

      } else if (id === 'alimentos') {
        const a = alimentos(v);
        rows.push({ k: 'Hijos menores con derecho a alimentos', ref: 'Alimentarios del cálculo', v: a.hijos, format: 'plain' });
        rows.push({ k: 'Ingreso bruto del alimentante', ref: 'Base del techo legal del 50%', v: a.bruto });
        rows.push({ k: 'Ingreso líquido del alimentante', ref: 'Después de descuentos previsionales e impuesto', v: a.liquido });
        rows.push({ k: 'Ingreso mínimo remuneracional', ref: 'Ley 21.830 · base del piso legal', v: IMR });
        rows.push({
          k: 'Piso legal por hijo',
          ref: (a.hijos === 1 ? '40%' : '30%') + ' del IMR · Art. 3 Ley 14.908',
          v: IMR * a.pisoPorHijo,
        });
        rows.push({ k: 'Piso legal total del caso', ref: a.hijos + (a.hijos === 1 ? ' hijo' : ' hijos'), v: a.pisoLegal, extra: true });
        rows.push({ k: 'Techo legal de la pensión', ref: '50% de las rentas · Art. 7 Ley 14.908', v: a.techoLegal, extra: true });
        rows.push({ k: 'Porcentaje orientativo por capacidad económica', ref: a.custodia.nombre + ' · capacidad ' + a.capacidad.nombre.toLowerCase(), v: a.pctAjustado * 100, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: 'Estimación por capacidad económica', ref: 'Criterio orientativo, no legal', v: a.porCapacidad });
        rows.push({ k: 'Pensión mensual estimada', ref: a.pisoManda ? 'Manda el piso legal' : a.topeAplicado ? 'Topada en el 50% de las rentas' : 'Manda la capacidad económica', v: a.pension, extra: true });
        if (a.hijos > 1) rows.push({ k: 'Pensión por cada hijo', ref: 'Total ÷ ' + a.hijos, v: a.porHijo });
        if (a.extras > 0) rows.push({ k: 'Gastos extraordinarios mensualizados', ref: 'Colegio, salud y actividades', v: a.extras });
        rows.push({ k: 'Total mensual a pagar', ref: 'Pensión más gastos extraordinarios', v: a.total, extra: true });
        rows.push({ k: 'Porcentaje del ingreso líquido que representa', ref: 'Pensión ÷ líquido', v: a.pctDelLiquido, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: 'Porcentaje de las rentas brutas', ref: 'Tope legal: 50%', v: a.pctDeLasRentas, format: 'unit', unit: '%', decimals: 1 });
        total = clp(a.total);
        sub = a.hijos === 0
          ? 'Indica al menos un hijo menor para estimar la pensión'
          : 'Pensión estimada de ' + clp(a.pension) + ' al mes por ' + a.hijos + (a.hijos === 1 ? ' hijo' : ' hijos') +
            ' · el piso legal del Art. 3 son ' + clp(a.pisoLegal) + ' y el techo del Art. 7 son ' + clp(a.techoLegal) +
            (a.pisoManda ? ' · en tu caso manda el piso legal' : a.topeAplicado ? ' · en tu caso se aplicó el techo del 50%' : ' · el monto final lo fija el juez');
        chart = [
          { label: 'Pensión mensual', value: Math.round(a.pension), tone: 'main' },
          { label: 'Gastos extraordinarios', value: Math.round(a.extras), tone: 'prop' },
          { label: 'Resto del líquido del alimentante', value: Math.round(Math.max(0, a.liquido - a.pension - a.extras)), tone: 'good' },
        ].filter((s) => s.value > 0);

      } else if (id === 'deudor') {
        const m = mora(v);
        rows.push({ k: 'Cuotas de pensión impagas', ref: 'Total o parcialmente adeudadas', v: m.cuotas, format: 'plain' });
        rows.push({ k: 'Pensión mensual fijada', ref: 'Según la sentencia o el avenimiento', v: m.pension });
        rows.push({ k: 'Capital adeudado', ref: 'Cuotas × pensión, sin reajuste', v: m.capital });
        rows.push({ k: 'Reajuste por variación del IPC', ref: (m.ipc * 100).toFixed(1).replace('.', ',') + '% acumulado · INE', v: m.reajuste });
        rows.push({ k: 'Capital reajustado', ref: 'Base sobre la que corre el interés', v: m.capitalReajustado, extra: true });
        rows.push({ k: 'Interés corriente devengado', ref: (m.tasa * 100).toFixed(1).replace('.', ',') + '% anual · tasa CMF, antigüedad media ' + m.mesesPromedio.toFixed(1).replace('.', ',') + ' meses', v: m.interes });
        rows.push({ k: 'Deuda total actualizada', ref: 'Capital reajustado más interés', v: m.deuda, extra: true });
        rows.push({ k: 'Cuotas consecutivas para inscribir en el registro', ref: 'Ley 21.389 · o 5 discontinuas', v: REGISTRO_DEUDORES.cuotasConsecutivas, format: 'plain' });
        if (!m.inscribible) {
          rows.push({ k: 'Cuotas que faltan para llegar al umbral', ref: 'Pagando antes se evita la inscripción', v: m.faltanCuotas, format: 'plain' });
        }
        rows.push({ k: 'Retención de la devolución de impuestos', ref: 'El SII la imputa a la deuda hasta cubrirla', v: m.deuda });
        rows.push({ k: 'Deuda medida en pensiones mensuales', ref: 'Cuántos meses de pensión representa', v: m.pension > 0 ? m.deuda / m.pension : 0, format: 'unit', unit: 'pensiones', decimals: 1 });
        rows.push({ k: 'Deuda expresada en UTM', ref: 'UTM del mes ' + clp(UTM), v: UTM > 0 ? m.deuda / UTM : 0, format: 'unit', unit: 'UTM', decimals: 1 });
        total = clp(m.deuda);
        sub = m.cuotas === 0
          ? 'Sin cuotas impagas: la situación está al día'
          : 'Con ' + m.cuotas + (m.cuotas === 1 ? ' cuota impaga' : ' cuotas impagas') + ' la deuda actualizada es ' + clp(m.deuda) +
            (m.inscribible
              ? ' · se cumple el umbral de la Ley 21.389: el tribunal puede ordenar la inscripción en el Registro Nacional de Deudores'
              : ' · faltan ' + m.faltanCuotas + ' cuota(s) para el umbral de inscripción');
        chart = [
          { label: 'Capital adeudado', value: Math.round(m.capital), tone: 'main' },
          { label: 'Reajuste por IPC', value: Math.round(m.reajuste), tone: 'warn' },
          { label: 'Interés corriente', value: Math.round(m.interes), tone: 'bad' },
        ].filter((s) => s.value > 0);

      } else {
        const d = divorcio(v, id);
        rows.push({ k: 'Vía del divorcio', ref: d.via.norma, v: 0, format: 'plain' });
        rows.push({
          k: 'Cese de convivencia exigido',
          ref: d.via.ceseAnios === 0 ? 'No se exige: hay que probar la causal' : 'Con fecha cierta acreditada',
          v: d.via.ceseAnios,
          format: 'unit',
          unit: d.via.ceseAnios === 1 ? 'año' : 'años',
        });
        rows.push({ k: d.cotizado > 0 ? 'Honorarios que te cotizaron' : 'Honorarios base de la vía', ref: d.cotizado > 0 ? 'El valor que cargaste' : 'Rango de mercado', v: d.cotizado > 0 ? d.cotizado : d.via.honMin });
        if (d.cotizado === 0) {
          if (d.porHijos > 0) rows.push({ k: 'Recargo por ' + d.hijos + (d.hijos === 1 ? ' hijo' : ' hijos'), ref: 'Cuidado personal, alimentos y relación directa', v: d.porHijos });
          if (d.porBienes > 0) rows.push({ k: 'Recargo por bienes a repartir', ref: v.complejidad === 'si_complejo' ? 'Patrimonio complejo' : 'Patrimonio simple', v: d.porBienes });
          if (d.porDeudas > 0) rows.push({ k: 'Recargo por deudas comunes', ref: 'Hay pasivo que ordenar', v: d.porDeudas });
          if (d.porCustodia > 0) rows.push({ k: 'Recargo por falta de acuerdo sobre los hijos', ref: 'Lo resuelve el tribunal', v: d.porCustodia });
          rows.push({ k: 'Honorarios estimados, piso', ref: 'Rango de mercado', v: d.honMin });
          rows.push({ k: 'Honorarios estimados, techo', ref: 'Rango de mercado', v: d.honMax, extra: true });
        }
        rows.push({ k: 'Arancel del tribunal de familia', ref: 'El proceso judicial es gratuito', v: 0 });
        rows.push({ k: 'Certificados del Registro Civil', ref: 'Matrimonio y nacimiento de los hijos', v: d.certificados });
        if (d.escritura > 0) rows.push({ k: 'Escritura pública de liquidación', ref: 'Sólo si hay bienes que traspasar', v: d.escritura });
        if (d.conservador > 0) rows.push({ k: 'Inscripción en el Conservador de Bienes Raíces', ref: 'Por inmueble que cambia de titular', v: d.conservador });
        rows.push({ k: 'Costo total, piso', ref: 'Honorarios más trámite', v: d.totalMin, extra: true });
        rows.push({ k: 'Costo total, techo', ref: 'Honorarios más trámite', v: d.totalMax, extra: true });
        rows.push({ k: 'Duración estimada, piso', ref: 'Desde la demanda hasta la sentencia', v: d.mesesMin, format: 'unit', unit: 'meses' });
        rows.push({ k: 'Duración estimada, techo', ref: 'Con audiencias y objeciones', v: d.mesesMax, format: 'unit', unit: 'meses' });
        rows.push({ k: 'Costo máximo expresado en UF', ref: 'UF de hoy ' + clp(UF), v: UF > 0 ? d.totalMax / UF : 0, format: 'unit', unit: 'UF', decimals: 1 });
        total = clp(d.totalMax);
        sub = 'Divorcio ' + d.via.nombre.toLowerCase() + ': entre ' + clp(d.totalMin) + ' y ' + clp(d.totalMax) +
          ', y entre ' + d.mesesMin + ' y ' + d.mesesMax + ' meses' +
          (d.via.ceseAnios > 0 ? ' · antes hay que acreditar ' + d.via.ceseAnios + (d.via.ceseAnios === 1 ? ' año' : ' años') + ' de cese de convivencia' : ' · no exige cese de convivencia, pero sí probar la causal');
        chart = [
          { label: 'Honorarios de abogado', value: Math.round(d.honMax), tone: 'main' },
          { label: 'Certificados y trámite', value: Math.round(d.certificados), tone: 'prop' },
          { label: 'Escritura e inscripción', value: Math.round(d.escritura + d.conservador), tone: 'exit' },
        ].filter((s) => s.value > 0);
      }

      return { total: total, sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
