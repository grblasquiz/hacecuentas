---
/**
 * Hub de decisión CL — "¿Cuánto sale de verdad este vuelo, y me conviene comprar afuera?"
 * Ruta bajo el prefijo /cl/, igual que las calculadoras que absorbe.
 * audience="CL" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  USD,
  ADUANA,
  TASA_INTERNACIONAL_USD,
  TASA_DOMESTICA_CLP,
  AEROPUERTOS,
  TARIFAS,
  CATEGORIAS,
  VALOR_MILLA_CENTAVOS_USD,
} from '../../../lib/hubs/cl/viajar-y-comprar-afuera';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CL"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    USD, ADUANA, TASA_INTERNACIONAL_USD, TASA_DOMESTICA_CLP,
    AEROPUERTOS, TARIFAS, CATEGORIAS, VALOR_MILLA_CENTAVOS_USD,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const clp = (n) => '$' + Math.round(n || 0).toLocaleString('es-CL');
    const usd = (n) => 'US$' + (Math.round((n || 0) * 100) / 100).toLocaleString('es-CL');
    const pick = (arr, id, def) => arr.find((x) => x.id === id) || arr[def || 0];
    const num = (x) => Math.max(0, Number(x) || 0);

    const tipoCambio = (v) => (num(v.dolar) > 0 ? num(v.dolar) : USD);

    // ── Vuelo: tarifa + tasa de embarque + cargo de terminal ─────────────────
    // Corrección respecto de las dos fórmulas viejas: el transporte de pasajeros
    // está exento de IVA (Art. 13 N°3 DL 825; el internacional además por el
    // Art. 12 letra E N°2). Ninguna de las dos aplicaba la exención.
    function vuelo(v, internacional) {
      const pax = Math.max(1, Math.round(Number(v.pasajeros) || 1));
      const aero = pick(AEROPUERTOS, v.aeropuerto, 0);
      const tc = tipoCambio(v);
      const tarifa = num(v.tarifa);
      const extrasPax = num(v.equipaje);

      const tasaUsdPax = internacional ? Math.max(0, Number(v.tasaIntlUsd) || TASA_INTERNACIONAL_USD) : 0;
      const tasaPax = internacional ? tasaUsdPax * tc : (num(v.tasaDomCLP) || TASA_DOMESTICA_CLP);
      const terminalPax = internacional ? aero.terminalIntl : aero.terminalDom;

      const tarifaTotal = tarifa * pax;
      const tasaTotal = tasaPax * pax;
      const terminalTotal = terminalPax * pax;
      const extrasTotal = extrasPax * pax;
      const recargo = tasaTotal + terminalTotal;
      const total = tarifaTotal + recargo + extrasTotal;

      return {
        pax, aero, tc, tarifa, tasaUsdPax, tasaPax, terminalPax, extrasPax,
        tarifaTotal, tasaTotal, terminalTotal, extrasTotal, recargo, total,
        porPax: total / pax,
        pctRecargo: total > 0 ? (recargo / total) * 100 : 0,
        pctSobreTarifa: tarifaTotal > 0 ? (recargo / tarifaTotal) * 100 : 0,
      };
    }

    // ── Millas LATAM Pass ────────────────────────────────────────────────────
    function millas(v) {
      const gasto = num(v.gastoUsd);
      const t = pick(TARIFAS, v.tarifaMillas, 0);
      const c = pick(CATEGORIAS, v.categoria, 0);
      const tc = tipoCambio(v);
      const centavos = Math.max(0.01, Number(v.valorMilla) || VALOR_MILLA_CENTAVOS_USD);

      const base = gasto * t.factor;
      const bonus = base * c.bonus;
      const totalMillas = base + bonus;
      const valorUsd = totalMillas * (centavos / 100);
      const valorPesos = valorUsd * tc;

      return {
        gasto, t, c, tc, centavos, base, bonus, totalMillas, valorUsd, valorPesos,
        retornoPct: gasto > 0 ? (valorUsd / gasto) * 100 : 0,
        gastoPesos: gasto * tc,
        millasPorMilPesos: gasto * tc > 0 ? (totalMillas / (gasto * tc)) * 1000 : 0,
      };
    }

    // ── Aduana: comprar afuera vs comprar en Chile ───────────────────────────
    // Corrección respecto de la fórmula vieja: el derecho y el IVA se calculan
    // sobre el valor aduanero (el precio de la mercancía), NO sobre el precio
    // con el sales tax del estado de compra incluido.
    function aduana(v) {
      const precioUsd = num(v.precioUsa);
      const tax = Math.max(0, Number(v.salesTax) || 0);
      const tc = tipoCambio(v);
      const precioChile = num(v.precioChile);
      const declara = v.declara === 'declarar';
      const esUsado = v.usado === 'si';

      const salesTaxUsd = precioUsd * (tax / 100);
      const costoCompraUsd = precioUsd + salesTaxUsd;

      // Valor aduanero = precio de la mercancía, sin el impuesto interno de EE. UU.
      const valorAduanero = declara ? precioUsd : 0;
      const derecho = valorAduanero * ADUANA.derechoAdValorem;
      const recargoUsado = declara && esUsado ? valorAduanero * ADUANA.recargoUsado : 0;
      const ivaAduana = (valorAduanero + derecho + recargoUsado) * ADUANA.iva;
      const impuestosUsd = derecho + recargoUsado + ivaAduana;

      const costoCompraClp = costoCompraUsd * tc;
      const impuestosClp = impuestosUsd * tc;
      const total = costoCompraClp + impuestosClp;
      const ahorro = precioChile - total;

      return {
        precioUsd, tax, tc, precioChile, declara, esUsado,
        salesTaxUsd, costoCompraUsd, valorAduanero, derecho, recargoUsado, ivaAduana,
        impuestosUsd, costoCompraClp, impuestosClp, total, ahorro,
        conviene: ahorro > 0,
        cargaEfectiva: valorAduanero > 0 ? (impuestosUsd / valorAduanero) * 100 : 0,
        pctAhorro: precioChile > 0 ? (ahorro / precioChile) * 100 : 0,
        sobreFranquicia: precioUsd > ADUANA.declaracionSimplificadaMaxUsd,
      };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'internacional';
      const rows = [];
      let total, sub, chart;

      if (id === 'millas') {
        const m = millas(v);
        rows.push({ k: 'Gasto del pasaje neto de tasas', ref: 'Base de acumulación', v: m.gasto, format: 'unit', unit: 'USD', decimals: 0 });
        rows.push({ k: 'Ese gasto en pesos', ref: 'Dólar ' + clp(m.tc), v: m.gastoPesos });
        rows.push({ k: 'Millas base — ' + m.t.nombre, ref: 'Factor ' + m.t.factor.toFixed(1).replace('.', ',') + ' millas por dólar', v: m.base, format: 'unit', unit: 'millas', decimals: 0 });
        rows.push({ k: 'Bonus por categoría — ' + m.c.nombre, ref: '+' + Math.round(m.c.bonus * 100) + '% sobre las millas base', v: m.bonus, format: 'unit', unit: 'millas', decimals: 0 });
        rows.push({ k: 'Millas que acumulas', ref: 'Base más bonus', v: m.totalMillas, format: 'unit', unit: 'millas', decimals: 0, extra: true });
        rows.push({ k: 'Valor de canje de la milla', ref: 'Referencia de mercado, editable', v: m.centavos, format: 'unit', unit: '¢USD', decimals: 2 });
        rows.push({ k: 'Valor de esas millas en dólares', ref: 'Millas × valor de canje', v: m.valorUsd, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Valor de esas millas en pesos', ref: 'Al dólar de ' + clp(m.tc), v: m.valorPesos, extra: true });
        rows.push({ k: 'Retorno del gasto en millas', ref: 'Valor de las millas ÷ gasto', v: m.retornoPct, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: 'Millas por cada mil pesos gastados', ref: 'Para comparar contra otros programas', v: m.millasPorMilPesos, format: 'unit', unit: 'millas', decimals: 1 });
        rows.push({ k: 'Umbral para que convenga canjear', ref: 'Precio en plata ÷ millas pedidas debe superar esto', v: m.centavos * m.tc / 100 });
        total = clp(m.valorPesos);
        sub = 'Con ' + usd(m.gasto) + ' en tarifa ' + m.t.nombre + ' acumulas unas ' +
          Math.round(m.totalMillas).toLocaleString('es-CL') + ' millas, que a un valor de canje de ' +
          m.centavos.toFixed(1).replace('.', ',') + ' ¢USD valen ' + clp(m.valorPesos) + ' · te vuelve el ' +
          m.retornoPct.toFixed(1).replace('.', ',') + '% de lo gastado';
        chart = [
          { label: 'Millas base', value: Math.round(m.base), tone: 'main' },
          { label: 'Bonus de categoría', value: Math.round(m.bonus), tone: 'good' },
        ].filter((s) => s.value > 0);

      } else if (id === 'aduana') {
        const a = aduana(v);
        rows.push({ k: 'Precio en Estados Unidos', ref: 'Sin impuestos', v: a.precioUsd, format: 'unit', unit: 'USD', decimals: 0 });
        rows.push({ k: 'Sales tax del estado', ref: a.tax.toFixed(1).replace('.', ',') + '% · no forma parte del valor aduanero', v: a.salesTaxUsd, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Lo que pagas en la tienda', ref: 'Precio más sales tax', v: a.costoCompraUsd, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Ese monto en pesos', ref: 'Dólar ' + clp(a.tc), v: a.costoCompraClp });
        rows.push({ k: 'Valor aduanero declarado', ref: a.declara ? 'Precio de la mercancía, sin sales tax' : 'Entra como efecto personal en uso', v: a.valorAduanero, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Derecho ad valorem', ref: (ADUANA.derechoAdValorem * 100).toFixed(0) + '% sobre el valor aduanero', v: a.derecho, format: 'unit', unit: 'USD', decimals: 2 });
        if (a.recargoUsado > 0) {
          rows.push({ k: 'Recargo por artículo usado', ref: (ADUANA.recargoUsado * 100).toFixed(0) + '% adicional', v: a.recargoUsado, format: 'unit', unit: 'USD', decimals: 2 });
        }
        rows.push({ k: 'IVA de importación', ref: (ADUANA.iva * 100).toFixed(0) + '% sobre valor más derecho', v: a.ivaAduana, format: 'unit', unit: 'USD', decimals: 2 });
        rows.push({ k: 'Impuestos de aduana en pesos', ref: a.declara ? 'Carga efectiva del ' + a.cargaEfectiva.toFixed(1).replace('.', ',') + '%' : 'No tributa como efecto personal', v: a.impuestosClp });
        rows.push({ k: 'Costo total de traerlo', ref: 'Compra más impuestos', v: a.total, extra: true });
        rows.push({ k: 'Precio del mismo producto en Chile', ref: 'Con boleta y garantía local', v: a.precioChile, extra: true });
        rows.push({ k: a.conviene ? 'Ahorro trayéndolo de afuera' : 'Sobrecosto de traerlo de afuera', ref: a.pctAhorro.toFixed(1).replace('.', ',') + '% del precio en Chile', v: Math.abs(a.ahorro), extra: true });
        rows.push({ k: 'Tope de la declaración simplificada', ref: 'Sobre esto hace falta destinación aduanera formal', v: ADUANA.declaracionSimplificadaMaxUsd, format: 'unit', unit: 'USD', decimals: 0 });
        rows.push({ k: 'Franquicia de compras en duty free', ref: 'Por viajero', v: ADUANA.dutyFreeMaxUsd, format: 'unit', unit: 'USD', decimals: 0 });
        rows.push({ k: 'Franquicia de obsequios', ref: 'Por viajero', v: ADUANA.obsequiosMaxUsd, format: 'unit', unit: 'USD', decimals: 0 });
        total = clp(a.total);
        sub = (a.conviene ? 'Conviene traerlo: ' : 'Conviene comprarlo en Chile: ') +
          'te sale ' + clp(a.total) + ' contra ' + clp(a.precioChile) + ' acá, una diferencia de ' + clp(Math.abs(a.ahorro)) +
          (a.declara ? ' · declarándolo pagas ' + clp(a.impuestosClp) + ' de impuestos' : ' · entrando como efecto personal en uso no tributa') +
          (a.sobreFranquicia ? ' · ojo: supera el tope de la declaración simplificada' : '');
        chart = [
          { label: 'Precio en la tienda', value: Math.round(a.precioUsd * a.tc), tone: 'main' },
          { label: 'Sales tax de EE. UU.', value: Math.round(a.salesTaxUsd * a.tc), tone: 'warn' },
          { label: 'Derecho y recargo de aduana', value: Math.round((a.derecho + a.recargoUsado) * a.tc), tone: 'exit' },
          { label: 'IVA de importación', value: Math.round(a.ivaAduana * a.tc), tone: 'bad' },
        ].filter((s) => s.value > 0);

      } else {
        const internacional = id !== 'domestico';
        const f = vuelo(v, internacional);
        rows.push({ k: 'Tarifa base por pasajero', ref: 'El precio publicado', v: f.tarifa });
        rows.push({ k: 'Pasajeros', ref: 'Del mismo boleto', v: f.pax, format: 'plain' });
        rows.push({ k: 'Tarifa base total', ref: 'Exenta de IVA · Art. 13 N°3 DL 825', v: f.tarifaTotal, extra: true });
        if (internacional) {
          rows.push({ k: 'Tasa de embarque internacional', ref: usd(f.tasaUsdPax) + ' por pasajero, al dólar de ' + clp(f.tc), v: f.tasaPax });
        } else {
          rows.push({ k: 'Tasa de embarque nacional', ref: 'Por pasajero · valor de referencia editable', v: f.tasaPax });
        }
        rows.push({ k: 'Tasa de embarque de todo el boleto', ref: f.pax + ' pasajero(s)', v: f.tasaTotal });
        rows.push({ k: 'Cargo por uso de terminal', ref: f.aero.nombre, v: f.terminalTotal });
        rows.push({ k: 'IVA del pasaje aéreo', ref: 'Transporte de pasajeros exento · DL 825', v: 0 });
        if (f.extrasTotal > 0) {
          rows.push({ k: 'Equipaje, asiento y otros cargos', ref: clp(f.extrasPax) + ' por pasajero', v: f.extrasTotal });
        }
        rows.push({ k: 'Recargo total sobre la tarifa', ref: 'Tasa más cargo de terminal', v: f.recargo, extra: true });
        rows.push({ k: 'Total a pagar', ref: 'Todo el boleto', v: f.total, extra: true });
        rows.push({ k: 'Costo final por pasajero', ref: 'Total ÷ ' + f.pax, v: f.porPax, extra: true });
        rows.push({ k: 'Peso de las tasas en el precio final', ref: 'Recargo ÷ total', v: f.pctRecargo, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: 'Las tasas encarecen la tarifa en', ref: 'Recargo ÷ tarifa base', v: f.pctSobreTarifa, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: 'Tipo de cambio aplicado', ref: num(v.dolar) > 0 ? 'El que fijaste' : 'Dólar observado del día', v: f.tc });
        total = clp(f.total);
        sub = (internacional ? 'Vuelo internacional' : 'Vuelo doméstico') + ' desde ' + f.aero.nombre.split(' — ')[0] +
          ' para ' + f.pax + ' pasajero(s): ' + clp(f.total) + ' en total, ' + clp(f.porPax) + ' por persona · ' +
          clp(f.recargo) + ' son tasas y cargos, el ' + f.pctRecargo.toFixed(1).replace('.', ',') +
          '% del precio final · el pasaje no lleva IVA';
        chart = [
          { label: 'Tarifa base', value: Math.round(f.tarifaTotal), tone: 'main' },
          { label: 'Tasa de embarque', value: Math.round(f.tasaTotal), tone: 'warn' },
          { label: 'Cargo de terminal', value: Math.round(f.terminalTotal), tone: 'exit' },
          { label: 'Equipaje y otros cargos', value: Math.round(f.extrasTotal), tone: 'bad' },
        ].filter((s) => s.value > 0);
      }

      return { total: total, sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
