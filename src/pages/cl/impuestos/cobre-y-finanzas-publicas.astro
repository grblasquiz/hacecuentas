---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/cl/cobre-y-finanzas-publicas';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="CL" lang="es" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/cl-cobre-y-finanzas-publicas';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"cobre-precio-bolsa-chile-impacto-fiscal-codelco","fields":["precio_cobre_usd_libra","tipo_cambio_usd_clp","produccion_cobre_ton","tasa_royalty_promedio","margen_operacional_codelco","tasa_impuesto_corporativo","otras_mineras_aporte"],"outputs":[{"id":"ingreso_royalty_usd","label":"Ingreso royalty Codelco (USD millones/año)","format":"number","decimals":2},{"id":"ingreso_irpf_codelco_usd","label":"Ingreso IRPF Codelco (USD millones/año)","format":"number","decimals":2},{"id":"total_ingresos_codelco_usd","label":"Total ingresos fiscales Codelco (USD millones/año)","format":"number","decimals":2},{"id":"total_ingresos_mineria_clp","label":"Total ingresos minería (incluyendo privada) - CLP miles de millones/año","format":"number","decimals":2},{"id":"sensibilidad_precio_usd","label":"Sensibilidad: USD +1/lb genera (USD millones adicionales)","format":"number","decimals":2},{"id":"sensibilidad_precio_clp","label":"Sensibilidad: USD +1/lb genera (CLP mil millones adicionales)","format":"number","decimals":2},{"id":"porcentaje_presupuesto_fiscal","label":"% estimado de ingresos fiscales totales (aprox.)","format":"number","decimals":1},{"id":"fondo_estabilizacion_aporte","label":"Aporte potencial Fondo Estabilización Económica (CLP mil millones)","format":"number","decimals":2}],"title":"Calculadora de impacto fiscal del precio del cobre en Chile"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'es', format: 'ars' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
