---
/**
 * Hub de decisión CL — "¿Cuánto paga de impuestos mi empresa?"
 * Ruta bajo el prefijo /cl/, igual que las calculadoras que absorbe.
 * audience="CL" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ImpuestosEmpresaChileExperience from '../../../components/generated/ImpuestosEmpresaChileExperience.astro';
import {
  hub,
  UF,
  UTM,
  UTA,
  REGIMENES,
  RENTA_PRESUNTA,
  PATENTE,
} from '../../../lib/hubs/cl/impuestos-de-mi-empresa';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CL"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ImpuestosEmpresaChileExperience data={hub} />
  <Footer />
</Layout>

