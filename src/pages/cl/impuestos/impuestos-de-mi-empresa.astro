---
/**
 * Hub de decisión CL — "¿Cuánto paga de impuestos mi empresa?"
 * Ruta bajo el prefijo /cl/, igual que las calculadoras que absorbe.
 * audience="CL" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  UF,
  UTM,
  UTA,
  REGIMENES,
  RENTA_PRESUNTA,
  PATENTE,
} from '../../../lib/hubs/cl/impuestos-de-mi-empresa';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CL"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ UF, UTM, UTA, REG: REGIMENES, PRESUNTA: RENTA_PRESUNTA, PAT: PATENTE }}
>
  (function () {
    const H = window.HC_HUB;
    const clp = (n) => '$' + Math.round(n || 0).toLocaleString('es-CL');
    const num = (n, d) => n.toLocaleString('es-CL', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });

    // Global Complementario simplificado (Art. 52 LIR) para el caso transparente
    // y para el crédito de la renta presunta: tramos anuales en UTA.
    const TRAMOS_IGC = [
      { hasta: 13.5, factor: 0, rebaja: 0 },
      { hasta: 30, factor: 0.04, rebaja: 0.54 },
      { hasta: 50, factor: 0.08, rebaja: 1.74 },
      { hasta: 70, factor: 0.135, rebaja: 4.49 },
      { hasta: 90, factor: 0.23, rebaja: 11.14 },
      { hasta: 120, factor: 0.304, rebaja: 17.8 },
      { hasta: 310, factor: 0.35, rebaja: 23.32 },
      { hasta: Infinity, factor: 0.4, rebaja: 38.82 },
    ];
    function igc(base) {
      const b = Math.max(0, base);
      const uta = UTA > 0 ? b / UTA : 0;
      for (const t of TRAMOS_IGC) {
        if (uta <= t.hasta) {
          return { impuesto: Math.max(0, b * t.factor - t.rebaja * UTA), marginal: t.factor * 100, uta: uta };
        }
      }
      return { impuesto: 0, marginal: 0, uta: uta };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'pyme';
      const ingresos = Math.max(0, v.ingresos || 0);
      const gastos = Math.max(0, v.gastos || 0);
      const depreciacion = Math.max(0, v.depreciacion || 0);
      const rechazados = Math.max(0, v.gastosRechazados || 0);
      const ppm = Math.max(0, v.ppm || 0);
      const limitePyme = REG.limitePymeUf * UF;

      // ── IVA ─────────────────────────────────────────────────────────
      if (id === 'iva') {
        const ventas = Math.max(0, v.ventasNetas || 0);
        const compras = Math.max(0, v.comprasNetas || 0);
        const debito = ventas * REG.iva;
        const credito = compras * REG.iva;
        const aPagar = Math.max(0, debito - credito);
        const remanente = Math.max(0, credito - debito);
        return {
          total: clp(aPagar),
          sub:
            'Débito ' + clp(debito) + ' − crédito ' + clp(credito) + ' = ' +
            (remanente > 0 ? 'remanente a favor de ' + clp(remanente) : clp(aPagar) + ' a enterar') +
            ' · el IVA lo paga el consumidor, la empresa solo lo recauda',
          rows: [
            { k: 'Ventas netas del período', ref: 'Sin IVA', v: ventas },
            { k: 'Débito fiscal', ref: num(REG.iva * 100) + '% de las ventas · DL 825', v: debito },
            { k: 'Compras netas con factura', ref: 'Relacionadas con el giro', v: compras },
            { k: 'Crédito fiscal', ref: num(REG.iva * 100) + '% de las compras · DL 825', v: credito },
            { k: 'IVA a enterar en el Formulario 29', ref: 'Débito − crédito', v: aPagar, extra: true },
            { k: 'Remanente de crédito para el próximo período', ref: 'Se arrastra reajustado', v: remanente },
            { k: 'Precio final que paga tu cliente', ref: 'Venta neta + IVA', v: ventas + debito },
            {
              k: 'Peso del IVA a enterar sobre tus ventas',
              ref: 'No confundir con el 19% de la facturación',
              v: ventas > 0 ? (aPagar / ventas) * 100 : 0,
              format: 'unit',
              unit: '%',
              decimals: 2,
            },
            { k: 'Cuánto sería si el IVA fuera un costo del 19% de las ventas', ref: 'Cálculo INCORRECTO, solo de contraste', v: debito },
          ],
          chart: [
            { label: 'Crédito fiscal de tus compras', value: Math.round(Math.min(credito, debito)), tone: 'good' },
            { label: 'IVA que enteras', value: Math.round(aPagar), tone: 'warn' },
            { label: 'Remanente a tu favor', value: Math.round(remanente), tone: 'main' },
          ],
        };
      }

      // ── Patente municipal y costo de constituir ─────────────────────
      if (id === 'patente') {
        const capital = Math.max(0, v.capitalPropio || 0);
        const tasa = Math.min(PAT.tasaMaxPorMil, Math.max(PAT.tasaMinPorMil, v.tasaPorMil || PAT.tasaMinPorMil));
        const notaria = Math.max(0, v.costoNotaria || 0);
        const bruto = capital * (tasa / 1000);
        const minimo = PAT.minimoUtm * UTM;
        const maximo = PAT.maximoUtm * UTM;
        const patente = Math.min(Math.max(bruto, minimo), maximo);
        const cuota = patente / PAT.cuotasAlAnio;
        const enUtm = UTM > 0 ? patente / UTM : 0;
        return {
          total: clp(patente),
          sub:
            'Patente anual con tasa de ' + num(tasa, 1) + '‰ sobre un capital propio de ' + clp(capital) +
            ' · ' + PAT.cuotasAlAnio + ' cuotas de ' + clp(cuota) +
            (bruto < minimo ? ' · aplicó el mínimo de ' + PAT.minimoUtm + ' UTM' : bruto > maximo ? ' · aplicó el tope de ' + PAT.maximoUtm + ' UTM' : ''),
          rows: [
            { k: 'Capital propio tributario', ref: 'Base de la patente · Art. 24 DL 3.063', v: capital },
            { k: 'Tasa por mil de tu municipio', ref: 'Entre ' + PAT.tasaMinPorMil + '‰ y ' + PAT.tasaMaxPorMil + '‰', v: tasa, format: 'unit', unit: '‰', decimals: 1 },
            { k: 'Patente antes de mínimos y topes', ref: 'Capital × tasa ÷ 1.000', v: bruto },
            { k: 'Mínimo legal', ref: PAT.minimoUtm + ' UTM al año', v: minimo },
            { k: 'Máximo legal', ref: PAT.maximoUtm.toLocaleString('es-CL') + ' UTM al año', v: maximo },
            { k: 'Patente anual a pagar', ref: 'Dentro del rango legal', v: patente, extra: true },
            { k: 'Cada cuota semestral', ref: 'Enero y julio', v: cuota },
            { k: 'Patente expresada en UTM', ref: 'UTM ' + clp(UTM), v: enUtm, format: 'unit', unit: 'UTM', decimals: 2 },
            { k: 'Costo de constituir por el Registro de Empresas y Sociedades', ref: 'Ley 20.659 · gratuito y en línea', v: 0 },
            { k: 'Notaría y asesoría, si vas por la vía tradicional', ref: 'Valor que pusiste tú', v: notaria },
            { k: 'Costo total del primer año', ref: 'Patente + constitución', v: patente + notaria },
          ],
          chart: [
            { label: 'Primera cuota (enero)', value: Math.round(cuota), tone: 'main' },
            { label: 'Segunda cuota (julio)', value: Math.round(cuota), tone: 'prop' },
            { label: 'Notaría y asesoría', value: Math.round(notaria), tone: 'warn' },
          ],
        };
      }

      // ── Renta presunta ──────────────────────────────────────────────
      if (id === 'presunta') {
        const act = PRESUNTA.find((a) => a.id === v.actividadPresunta) || PRESUNTA[0];
        const base = Math.max(0, v.basePresunta || 0);
        const tasa =
          act.tasa !== null
            ? act.tasa
            : Math.min(act.tasaMax, Math.max(act.tasaMin, (v.tasaMineria || 4) / 100));
        const rentaPresunta = base * tasa;
        const topeVentas = act.topeVentasUf * UF;
        const superaTope = ingresos > topeVentas;

        // Primera Categoría (tasa Pyme) y su crédito contra el Global Complementario.
        const idpc = rentaPresunta * REG.tasaPyme;
        const r = igc(rentaPresunta);
        const igcNeto = Math.max(0, r.impuesto - idpc);
        const cargaTotal = idpc + igcNeto;

        return {
          total: clp(cargaTotal),
          sub:
            act.norma + ' · base presunta ' + clp(rentaPresunta) +
            ' · tope de ventas ' + act.topeVentasUf.toLocaleString('es-CL') + ' UF (' + clp(topeVentas) + ')' +
            (superaTope ? ' — LO SUPERAS: quedas obligado a contabilidad completa' : ' — dentro del régimen'),
          rows: [
            { k: act.baseLabel, ref: 'Base del cálculo presunto', v: base },
            { k: 'Tasa presunta de tu actividad', ref: act.norma, v: tasa * 100, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Renta presunta del ejercicio', ref: 'Base × tasa', v: rentaPresunta, extra: true },
            { k: 'Tus ventas anuales', ref: 'Se comparan contra el tope', v: ingresos },
            { k: 'Tope de ventas de tu actividad', ref: act.topeVentasUf.toLocaleString('es-CL') + ' UF · Art. 34 LIR', v: topeVentas },
            {
              k: superaTope ? 'Cuánto pasaste el tope' : 'Margen que te queda antes del tope',
              ref: superaTope ? 'Contabilidad completa desde el 1 de enero siguiente' : 'Sigues en renta presunta',
              v: Math.abs(topeVentas - ingresos),
            },
            { k: 'Impuesto de Primera Categoría', ref: num(REG.tasaPyme * 100) + '% sobre la renta presunta', v: idpc },
            { k: 'Renta presunta en UTA', ref: 'UTA ' + clp(UTA), v: r.uta, format: 'unit', unit: 'UTA', decimals: 2 },
            { k: 'Global Complementario antes del crédito', ref: 'Art. 52 LIR · marginal ' + num(r.marginal, 1) + '%', v: r.impuesto },
            { k: 'Crédito por Primera Categoría', ref: 'Art. 56 N°3 LIR · no se paga dos veces', v: Math.min(idpc, r.impuesto) },
            { k: 'Global Complementario a pagar', ref: 'Después del crédito', v: igcNeto },
            { k: 'Carga tributaria total', ref: 'Primera Categoría + Global Complementario neto', v: cargaTotal, extra: true },
          ],
          chart: [
            { label: 'Renta presunta que te queda', value: Math.max(0, Math.round(rentaPresunta - cargaTotal)), tone: 'main' },
            { label: 'Impuesto de Primera Categoría', value: Math.round(idpc), tone: 'prop' },
            { label: 'Global Complementario neto', value: Math.round(igcNeto), tone: 'warn' },
          ],
        };
      }

      // ── Regímenes de renta: Pyme, transparente y general ────────────
      const rli = Math.max(0, ingresos - gastos - depreciacion + rechazados);
      const superaPyme = ingresos > limitePyme;

      if (id === 'transparente') {
        // 14D N°8: la empresa NO paga Primera Categoría. Tributan los dueños.
        const r = igc(rli);
        const comparaPyme = rli * REG.tasaPyme;
        return {
          total: clp(r.impuesto),
          sub:
            'La empresa paga $0 de Primera Categoría · los dueños tributan ' + clp(r.impuesto) +
            ' de Global Complementario sobre ' + clp(rli) + ' atribuidos · marginal ' + num(r.marginal, 1) + '%',
          rows: [
            { k: 'Ingresos percibidos del año', ref: 'Criterio de caja · Art. 14 D LIR', v: ingresos },
            { k: 'Gastos pagados del año', ref: 'Criterio de caja', v: gastos },
            { k: 'Depreciación instantánea', ref: 'Beneficio del régimen Pyme', v: depreciacion },
            { k: 'Gastos rechazados agregados', ref: 'Art. 21 LIR', v: rechazados },
            { k: 'Base atribuible a los dueños', ref: 'Renta líquida imponible', v: rli, extra: true },
            { k: 'Impuesto de Primera Categoría de la empresa', ref: 'El 14D N°8 NO lo paga', v: 0 },
            { k: 'Base atribuida en UTA', ref: 'UTA ' + clp(UTA), v: r.uta, format: 'unit', unit: 'UTA', decimals: 2 },
            { k: 'Tasa marginal del dueño', ref: 'Art. 52 LIR', v: r.marginal, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Global Complementario del dueño', ref: 'Sobre la renta atribuida', v: r.impuesto, extra: true },
            { k: 'Lo que pagaría la empresa en el 14D general', ref: num(REG.tasaPyme * 100) + '% de Primera Categoría', v: comparaPyme },
            {
              k: r.impuesto <= comparaPyme ? 'Cuánto ahorras con el transparente' : 'Cuánto pagas de más con el transparente',
              ref: 'Antes de considerar el crédito al retirar',
              v: Math.abs(comparaPyme - r.impuesto),
            },
            { k: 'Límite del régimen Pyme', ref: REG.limitePymeUf.toLocaleString('es-CL') + ' UF de ingresos promedio', v: limitePyme },
          ],
          chart: [
            { label: 'Renta que queda para los dueños', value: Math.max(0, Math.round(rli - r.impuesto)), tone: 'main' },
            { label: 'Global Complementario', value: Math.round(r.impuesto), tone: 'warn' },
          ],
        };
      }

      const esGeneral = id === 'general';
      const tasa = esGeneral || superaPyme ? REG.tasaGeneral : REG.tasaPyme;
      const impuesto = rli * tasa;
      const impuestoArt21 = rechazados * 0.4;
      const neto = Math.max(0, impuesto - ppm);
      const ppmMensual = impuesto / 12;
      const efectiva = ingresos > 0 ? (impuesto / ingresos) * 100 : 0;

      return {
        total: clp(impuesto),
        sub:
          'Impuesto de Primera Categoría al ' + num(tasa * 100) + '% sobre una renta líquida imponible de ' +
          clp(rli) + ' · ' + (neto > 0 ? clp(neto) + ' a pagar después de los PPM' : 'los PPM ya lo cubren') +
          (superaPyme && !esGeneral ? ' · superas el límite del régimen Pyme, se aplica la tasa general' : ''),
        rows: [
          { k: 'Ingresos del año', ref: esGeneral ? 'Devengados' : 'Percibidos · criterio de caja', v: ingresos },
          { k: 'Gastos deducibles', ref: 'Necesarios para producir la renta', v: gastos },
          { k: 'Depreciación', ref: esGeneral ? 'Lineal o acelerada' : 'Instantánea en el régimen Pyme', v: depreciacion },
          { k: 'Gastos rechazados agregados', ref: 'Vuelven a la base · Art. 21 LIR', v: rechazados },
          { k: 'Renta líquida imponible', ref: 'Base del impuesto', v: rli, extra: true },
          { k: 'Tasa aplicada', ref: esGeneral || superaPyme ? 'Régimen general · Art. 20 LIR' : 'Régimen Pyme · Art. 14 D N°3 LIR', v: tasa * 100, format: 'unit', unit: '%' },
          { k: 'Impuesto de Primera Categoría', ref: 'RLI × tasa', v: impuesto, extra: true },
          { k: 'Impuesto único del Art. 21 sobre gastos rechazados', ref: '40% · solo si benefician a los dueños', v: impuestoArt21 },
          { k: 'PPM ya pagados', ref: 'Formulario 29', v: ppm },
          { k: 'Impuesto neto a pagar en abril', ref: 'Impuesto − PPM', v: neto },
          { k: 'PPM mensual equivalente', ref: 'Impuesto ÷ 12 · referencia', v: ppmMensual },
          { k: 'Crédito contra el Global Complementario de los socios', ref: esGeneral ? 'Parcial (65%) en el semi integrado' : 'Total en el régimen Pyme', v: esGeneral ? impuesto * 0.65 : impuesto },
          { k: 'Límite del régimen Pyme', ref: REG.limitePymeUf.toLocaleString('es-CL') + ' UF de ingresos promedio', v: limitePyme },
          {
            k: 'Tasa efectiva sobre tus ingresos',
            ref: 'Impuesto ÷ ingresos',
            v: efectiva,
            format: 'unit',
            unit: '%',
            decimals: 2,
          },
        ],
        chart: [
          { label: 'Renta que queda en la empresa', value: Math.max(0, Math.round(rli - impuesto)), tone: 'main' },
          { label: 'Impuesto de Primera Categoría', value: Math.round(impuesto), tone: 'warn' },
          { label: 'Impuesto del Art. 21', value: Math.round(impuestoArt21), tone: 'bad' },
        ],
      };
    });
  })();
</script>
