---
/**
 * Hub de decisión CL — "¿Por qué me llegó tan cara la cuenta y cómo la bajo?"
 * Ruta bajo el prefijo /cl/, igual que las calculadoras que absorbe.
 * audience="CL" va literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, IVA, SUBSIDIO_ELECTRICO, TARIFAS_REF, GAS } from '../../../lib/hubs/cl/cuentas-de-la-casa';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CL"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ IVA, SUBSIDIO_ELECTRICO, TARIFAS_REF, GAS }}>
  (function () {
    const H = window.HC_HUB;
    const clp = (n) => '$' + Math.round(n || 0).toLocaleString('es-CL');

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'luz';
      const rows = [];

      // ─── Rama: subsidio eléctrico Ley 21.667 ───────────────────────────────
      if (id === 'subsidio') {
        const integrantes = Math.max(1, Math.round(Number(v.integrantes) || 1));
        const tramo = Number(v.rshTramo) || 100;
        const elegible = tramo <= SUBSIDIO_ELECTRICO.rshTramoMax;
        const monto =
          integrantes >= 4
            ? SUBSIDIO_ELECTRICO.montoCuatroOMas
            : integrantes >= 2
              ? SUBSIDIO_ELECTRICO.montoDosATres
              : SUBSIDIO_ELECTRICO.montoUnIntegrante;
        const total = elegible ? monto : 0;
        const porCuota = total / SUBSIDIO_ELECTRICO.cuotas;

        // Boleta de referencia para saber qué proporción cubre.
        const kwh = Math.max(0, Number(v.kwh) || 0);
        const precioKwh = Math.max(0, Number(v.precioKwh) || 0);
        const cargoFijo = Math.max(0, Number(v.cargoFijo) || 0);
        const boleta = (cargoFijo + kwh * precioKwh) * (1 + IVA);
        const cubre = boleta > 0 ? (porCuota / boleta) * 100 : 0;

        rows.push({ k: 'Tu tramo en el Registro Social de Hogares', ref: 'Más bajo = mayor vulnerabilidad', v: tramo, format: 'unit', unit: '%' });
        rows.push({ k: 'Tramo máximo para acceder al beneficio', ref: 'Ley 21.667', v: SUBSIDIO_ELECTRICO.rshTramoMax, format: 'unit', unit: '%' });
        rows.push({ k: 'Personas en el hogar', ref: 'Define el monto', v: integrantes, format: 'plain' });
        rows.push({
          k: elegible ? 'Calificas por tramo del RSH' : 'NO calificas por tramo del RSH',
          ref: elegible ? 'Estás dentro del ' + SUBSIDIO_ELECTRICO.rshTramoMax + '% más vulnerable' : 'El beneficio llega hasta el tramo ' + SUBSIDIO_ELECTRICO.rshTramoMax + '%',
          v: elegible ? 1 : 0,
          format: 'plain',
        });
        rows.push({ k: 'Monto total del beneficio', ref: 'Hogar de ' + integrantes + (integrantes === 1 ? ' persona' : ' personas'), v: total, extra: true });
        rows.push({ k: 'Descuento en cada boleta', ref: SUBSIDIO_ELECTRICO.cuotas + ' cuotas mensuales', v: porCuota, extra: true });
        rows.push({ k: 'Tu boleta de referencia', ref: kwh + ' kWh con IVA incluido', v: boleta });
        rows.push({ k: 'Porcentaje de la boleta que cubre', ref: 'Cuota ÷ boleta', v: cubre, format: 'unit', unit: '%', decimals: 0 });
        rows.push({ k: 'Lo que seguirías pagando cada mes', ref: 'Boleta menos la cuota del subsidio', v: Math.max(0, boleta - porCuota) });
        rows.push({ k: 'Monto para hogar de 1 persona', ref: 'Referencia · ' + SUBSIDIO_ELECTRICO.fechaDato, v: SUBSIDIO_ELECTRICO.montoUnIntegrante });
        rows.push({ k: 'Monto para hogar de 2 a 3 personas', ref: 'Referencia · ' + SUBSIDIO_ELECTRICO.fechaDato, v: SUBSIDIO_ELECTRICO.montoDosATres });
        rows.push({ k: 'Monto para hogar de 4 o más personas', ref: 'Referencia · ' + SUBSIDIO_ELECTRICO.fechaDato, v: SUBSIDIO_ELECTRICO.montoCuatroOMas });

        return {
          total: clp(total),
          sub: elegible
            ? 'Con tramo ' + tramo + '% y ' + integrantes + (integrantes === 1 ? ' persona' : ' personas') + ' en el hogar te corresponden ' +
              clp(total) + ', descontados en ' + SUBSIDIO_ELECTRICO.cuotas + ' cuotas de ' + clp(porCuota) +
              ' · eso cubre cerca del ' + cubre.toFixed(0) + '% de tu boleta.'
            : 'Con tramo ' + tramo + '% del RSH no calificas: el subsidio de la Ley 21.667 llega hasta el tramo ' +
              SUBSIDIO_ELECTRICO.rshTramoMax + '%, que es el 40% de hogares de menores ingresos.',
          rows: rows,
          chart: [
            { label: 'Lo que cubre el subsidio', value: Math.round(porCuota), tone: 'good' },
            { label: 'Lo que sigues pagando', value: Math.round(Math.max(0, boleta - porCuota)), tone: 'main' },
          ],
        };
      }

      // ─── Rama: compensación por corte de luz ───────────────────────────────
      if (id === 'corte') {
        const kwh = Math.max(0, Number(v.kwh) || 0);
        const horas = Math.max(0, Number(v.horasCorte) || 0);
        const boleta = Math.max(0, v.montoBoleta || 0);

        const ens = (kwh / 720) * horas; // mes comercial de 30 días = 720 horas
        const tarifaMedia = kwh > 0 ? boleta / kwh : 0;
        const valorPropio = ens * tarifaMedia;
        const promedioDiario = boleta / 30;
        const sernac = promedioDiario * 10;

        rows.push({ k: 'Consumo mensual facturado', ref: 'De tu última boleta', v: kwh, format: 'unit', unit: 'kWh' });
        rows.push({ k: 'Duración del corte', ref: 'Horas sin suministro', v: horas, format: 'unit', unit: 'horas', decimals: 1 });
        rows.push({ k: 'Energía que no te suministraron', ref: 'Consumo ÷ 720 h × horas de corte', v: ens, format: 'unit', unit: 'kWh', decimals: 2, extra: true });
        rows.push({ k: 'Energía que la SEC manda compensar', ref: 'El DOBLE · Art. 16 B Ley 18.410', v: ens * 2, format: 'unit', unit: 'kWh', decimals: 2, extra: true });
        rows.push({ k: 'Tu tarifa media, todo incluido', ref: 'Boleta ÷ kWh del mes', v: tarifaMedia, decimals: 0 });
        rows.push({ k: 'Valor de esa energía a TU tarifa', ref: 'Solo como referencia', v: valorPropio });
        rows.push({ k: 'Promedio diario de tu última boleta', ref: 'Boleta ÷ 30 días', v: promedioDiario });
        rows.push({ k: 'Compensación mínima por suspensión injustificada', ref: '10 veces el promedio diario', v: sernac, extra: true });

        return {
          total: clp(sernac),
          sub:
            'Un corte de ' + horas.toLocaleString('es-CL') + ' horas equivale a ' +
            ens.toLocaleString('es-CL', { maximumFractionDigits: 1 }) + ' kWh no suministrados. La SEC obliga a descontarte el doble ' +
            'valorizado a costo de racionamiento —un valor regulado mayor que tu tarifa, que calcula la distribuidora— y aparece solo en la boleta siguiente. ' +
            'Si la suspensión fue injustificada, puedes exigir además al menos ' + clp(sernac) + '.',
          rows: rows,
          chart: [
            { label: 'Mínimo por suspensión injustificada', value: Math.round(sernac), tone: 'good' },
            { label: 'Tu energía cortada, a tu tarifa', value: Math.round(valorPropio), tone: 'main' },
          ],
        };
      }

      // ─── Rama: internet ────────────────────────────────────────────────────
      if (id === 'internet') {
        const precio = Math.max(0, v.precioInternet || 0);
        const vel = Math.max(1, Number(v.velocidad) || 1);
        const precioAlt = Math.max(0, v.precioInternetAlt || 0);
        const velAlt = Math.max(0, Number(v.velocidadAlt) || 0);

        const porMbps = precio / vel;
        const anual = precio * 12;
        const porMbpsAlt = velAlt > 0 ? precioAlt / velAlt : 0;
        const ahorroMes = precioAlt > 0 ? precio - precioAlt : 0;

        rows.push({ k: 'Precio mensual de tu plan', ref: 'Después de la promoción', v: precio, extra: true });
        rows.push({ k: 'Velocidad contratada', ref: 'La que promete el plan', v: vel, format: 'unit', unit: 'Mbps' });
        rows.push({ k: 'Precio por Mbps de tu plan', ref: 'Lo comparable entre ofertas', v: porMbps, decimals: 1, extra: true });
        rows.push({ k: 'Lo que pagas al año', ref: '12 mensualidades', v: anual });
        rows.push({ k: 'Lo que pagas en dos años', ref: '24 mensualidades', v: precio * 24 });
        if (precioAlt > 0) {
          rows.push({ k: 'Precio del plan alternativo', ref: velAlt > 0 ? velAlt + ' Mbps' : 'Velocidad no indicada', v: precioAlt });
          if (velAlt > 0) {
            rows.push({ k: 'Precio por Mbps del alternativo', ref: 'Más bajo es mejor', v: porMbpsAlt, decimals: 1 });
          }
          rows.push({
            k: ahorroMes >= 0 ? 'Te ahorras al mes cambiándote' : 'Pagarías más al mes cambiándote',
            ref: 'Diferencia entre los dos planes',
            v: Math.abs(ahorroMes),
            extra: true,
          });
          rows.push({ k: ahorroMes >= 0 ? 'Ahorro en un año' : 'Sobrecosto en un año', ref: 'Diferencia × 12', v: Math.abs(ahorroMes) * 12 });
        }

        return {
          total: clp(precio),
          sub:
            'Tu plan sale ' + clp(precio) + ' al mes por ' + vel + ' Mbps, es decir ' + clp(porMbps) + ' por Mbps · ' +
            clp(anual) + ' al año' +
            (precioAlt > 0
              ? ahorroMes > 0
                ? ' · cambiándote al de ' + clp(precioAlt) + ' te ahorrarías ' + clp(ahorroMes * 12) + ' al año.'
                : ahorroMes < 0
                  ? ' · el alternativo es ' + clp(Math.abs(ahorroMes)) + ' más caro al mes.'
                  : ' · los dos planes cuestan lo mismo.'
              : '.'),
          rows: rows,
          chart:
            precioAlt > 0
              ? [
                  { label: 'Tu plan actual (año)', value: Math.round(anual), tone: ahorroMes > 0 ? 'bad' : 'main' },
                  { label: 'Plan alternativo (año)', value: Math.round(precioAlt * 12), tone: ahorroMes > 0 ? 'good' : 'main' },
                ]
              : [
                  { label: 'Lo que pagas al año', value: Math.round(anual), tone: 'main' },
                  { label: 'Un mes', value: Math.round(precio), tone: 'prop' },
                ],
        };
      }

      // ─── Rama: gas de red contra cilindro, comparado por ENERGÍA ───────────
      if (id === 'gas') {
        const m3 = Math.max(0, Number(v.gasM3) || 0);
        const gasCargoFijo = Math.max(0, Number(v.gasCargoFijo) || 0);
        const gasPrecioM3 = Math.max(0, Number(v.gasPrecioM3) || 0);
        const kg = Number(v.cilindroKg) || 15;
        const precioCilindro = Math.max(0, v.precioCilindro || 0); // ya viene con IVA

        // Energía mensual que necesitas, en kWh, a partir del consumo de red.
        const energiaKwh = m3 * GAS.kwhPorM3Red;

        // Red: cargo fijo + consumo, más IVA.
        const costoRed = (gasCargoFijo + m3 * gasPrecioM3) * (1 + IVA);

        // Cilindro: la misma energía servida con GLP. El precio de calle YA tiene IVA.
        const kwhPorCilindro = kg * GAS.kwhPorKgGlp;
        const cilindrosMes = kwhPorCilindro > 0 ? energiaKwh / kwhPorCilindro : 0;
        const costoCilindro = cilindrosMes * precioCilindro;

        const costoKwhRed = energiaKwh > 0 ? costoRed / energiaKwh : 0;
        const costoKwhGlp = kwhPorCilindro > 0 ? precioCilindro / kwhPorCilindro : 0;
        const diferencia = costoRed - costoCilindro;
        const redGana = diferencia < 0 ? false : true;

        // Punto de equilibrio: energía a la que ambos cuestan lo mismo.
        // cargoFijo·(1+IVA) + E·precioKwhRedVar = E·costoKwhGlp
        const precioKwhRedVar = (gasPrecioM3 * (1 + IVA)) / GAS.kwhPorM3Red;
        const denom = costoKwhGlp - precioKwhRedVar;
        const equilibrioKwh = denom > 0 ? (gasCargoFijo * (1 + IVA)) / denom : null;
        const equilibrioM3 = equilibrioKwh !== null ? equilibrioKwh / GAS.kwhPorM3Red : null;

        rows.push({ k: 'Consumo de referencia', ref: m3 + ' m³ de gas de red', v: m3, format: 'unit', unit: 'm³' });
        rows.push({ k: 'Energía que eso representa', ref: GAS.kwhPorM3Red + ' kWh por m³ de gas natural', v: energiaKwh, format: 'unit', unit: 'kWh', decimals: 0, extra: true });
        rows.push({ k: 'Gas de red — cargo fijo con IVA', ref: 'Se paga aunque no consumas', v: gasCargoFijo * (1 + IVA) });
        rows.push({ k: 'Gas de red — consumo con IVA', ref: m3 + ' m³ × ' + clp(gasPrecioM3), v: m3 * gasPrecioM3 * (1 + IVA) });
        rows.push({ k: 'Costo mensual con gas de RED', ref: 'Cargo fijo más consumo, con IVA', v: costoRed, extra: true });
        rows.push({ k: 'Energía de un cilindro de ' + kg + ' kg', ref: GAS.kwhPorKgGlp + ' kWh por kilo de gas licuado', v: kwhPorCilindro, format: 'unit', unit: 'kWh', decimals: 0 });
        rows.push({ k: 'Cilindros que necesitarías al mes', ref: 'Para la misma energía', v: cilindrosMes, format: 'unit', unit: 'cilindros', decimals: 2 });
        rows.push({ k: 'Costo mensual con CILINDRO', ref: 'Precio de calle, ya con IVA', v: costoCilindro, extra: true });
        rows.push({ k: 'Costo por kWh con gas de red', ref: 'Incluye el cargo fijo repartido', v: costoKwhRed, decimals: 1 });
        rows.push({ k: 'Costo por kWh con gas licuado', ref: 'Sin cargo fijo', v: costoKwhGlp, decimals: 1 });
        rows.push({
          k: redGana ? 'El cilindro te sale más barato en' : 'La red te sale más barata en',
          ref: 'Diferencia mensual',
          v: Math.abs(diferencia),
          extra: true,
        });
        rows.push({ k: 'Diferencia en el año', ref: 'Diferencia × 12', v: Math.abs(diferencia) * 12 });
        if (equilibrioM3 !== null && equilibrioM3 > 0) {
          rows.push({ k: 'Consumo desde el cual conviene la red', ref: 'Punto de equilibrio', v: equilibrioM3, format: 'unit', unit: 'm³ al mes', decimals: 1 });
        } else {
          rows.push({ k: 'A estos precios el cilindro nunca alcanza a la red', ref: 'No hay punto de equilibrio', v: 0, format: 'plain' });
        }

        const barato = diferencia < 0 ? 'la red' : 'el cilindro';
        return {
          total: clp(Math.min(costoRed, costoCilindro)),
          sub:
            'Para ' + energiaKwh.toFixed(0) + ' kWh al mes, ' + barato + ' sale más barato: ' +
            clp(Math.min(costoRed, costoCilindro)) + ' contra ' + clp(Math.max(costoRed, costoCilindro)) +
            ' · diferencia de ' + clp(Math.abs(diferencia)) + ' al mes (' + clp(Math.abs(diferencia) * 12) + ' al año)' +
            (equilibrioM3 !== null && equilibrioM3 > 0
              ? ' · la red conviene desde ' + equilibrioM3.toFixed(1) + ' m³ al mes.'
              : '.'),
          rows: rows,
          chart: [
            { label: 'Gas de red', value: Math.round(costoRed), tone: diferencia < 0 ? 'good' : 'bad' },
            { label: 'Cilindro de ' + kg + ' kg', value: Math.round(costoCilindro), tone: diferencia < 0 ? 'bad' : 'good' },
          ],
        };
      }

      // ─── Rama por defecto: la boleta de la luz ─────────────────────────────
      const kwh = Math.max(0, Number(v.kwh) || 0);
      const solar = Math.min(kwh, Math.max(0, Number(v.kwhSolar) || 0));
      const precioKwh = Math.max(0, Number(v.precioKwh) || 0);
      const cargoFijo = Math.max(0, Number(v.cargoFijo) || 0);
      const dist = TARIFAS_REF.find((t) => t.id === v.distribuidora) || TARIFAS_REF[0];

      // El autoconsumo reduce los kWh facturados. Se descuenta UNA sola vez.
      const kwhFacturados = Math.max(0, kwh - solar);
      const energia = kwhFacturados * precioKwh;
      const neto = cargoFijo + energia;
      const iva = neto * IVA;
      const total = neto + iva;

      // Boleta sin autoconsumo, para medir el ahorro.
      const netoSin = cargoFijo + kwh * precioKwh;
      const totalSin = netoSin * (1 + IVA);
      const ahorroSolar = totalSin - total;

      const costoRealKwh = kwh > 0 ? total / kwh : 0;

      rows.push({ k: 'Consumo del mes', ref: 'Lo que registró el medidor', v: kwh, format: 'unit', unit: 'kWh' });
      if (solar > 0) {
        rows.push({ k: 'Generación solar propia', ref: 'Energía que no le compras a la red', v: solar, format: 'unit', unit: 'kWh' });
        rows.push({ k: 'kWh que efectivamente te facturan', ref: 'Consumo menos autoconsumo', v: kwhFacturados, format: 'unit', unit: 'kWh', extra: true });
      }
      rows.push({ k: 'Cargo fijo del mes', ref: 'Se paga aunque consumas cero', v: cargoFijo });
      rows.push({ k: 'Cargo por energía', ref: kwhFacturados + ' kWh × ' + clp(precioKwh), v: energia, extra: true });
      rows.push({ k: 'Suministro sin IVA', ref: 'Cargo fijo más energía', v: neto });
      rows.push({ k: 'IVA', ref: '19% · toda la electricidad domiciliaria lo paga', v: iva });
      rows.push({ k: 'TOTAL de la boleta', ref: 'Lo que tienes que pagar', v: total, extra: true });
      rows.push({ k: 'Lo que te cuesta cada kWh de verdad', ref: 'Total ÷ kWh consumidos, con el cargo fijo repartido', v: costoRealKwh, decimals: 1, extra: true });
      rows.push({ k: 'Cuánto del total es cargo fijo', ref: 'La parte que no baja apagando luces', v: neto > 0 ? (cargoFijo / neto) * 100 : 0, format: 'unit', unit: '%', decimals: 1 });
      if (solar > 0) {
        rows.push({ k: 'Boleta que tendrías sin paneles', ref: 'Mismo consumo, todo comprado a la red', v: totalSin });
        rows.push({ k: 'Ahorro del autoconsumo solar', ref: 'Se descuenta una sola vez', v: ahorroSolar, extra: true });
        rows.push({ k: 'Ahorro solar en el año', ref: 'Ahorro × 12, si el mes es representativo', v: ahorroSolar * 12 });
      }
      rows.push({ k: 'Si bajaras el consumo un 10%', ref: 'Solo baja la parte de energía', v: total - kwhFacturados * 0.1 * precioKwh * (1 + IVA) });
      rows.push({ k: 'Referencia de tu distribuidora', ref: dist.nombre + ' · ' + clp(dist.precioKwh) + '/kWh y ' + clp(dist.cargoFijo) + ' de cargo fijo', v: dist.precioKwh, decimals: 0 });

      return {
        total: clp(total),
        sub:
          'Tu boleta suma ' + clp(total) + ' por ' + kwh + ' kWh: ' + clp(cargoFijo) + ' de cargo fijo, ' +
          clp(energia) + ' de energía y ' + clp(iva) + ' de IVA · cada kWh te sale ' + clp(costoRealKwh) +
          ' una vez repartido el cargo fijo' +
          (solar > 0 ? ' · el autoconsumo solar te ahorra ' + clp(ahorroSolar) + ' este mes.' : '.'),
        rows: rows,
        chart: [
          { label: 'Energía consumida', value: Math.round(energia), tone: 'main' },
          { label: 'Cargo fijo', value: Math.round(cargoFijo), tone: 'exit' },
          { label: 'IVA 19%', value: Math.round(iva), tone: 'warn' },
        ],
      };
    });
  })();
</script>
