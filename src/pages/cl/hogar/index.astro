---
/**
 * Silo Hogar · Chile — índice de hubs de decisión del mercado CL.
 * Existe para que el breadcrumb de los hubs chilenos no apunte a un 404 y para
 * repartir link equity entre hermanos. El listado sale del registry, no a mano.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';

const HREF = '/cl/hogar';
const SILO = 'Hogar';
const LEDE =
  'Arriendo, crédito hipotecario y cuentas de la casa, resueltos con la UF del día, el arancel que de verdad cobra el Conservador y las tarifas que aparecen en tu boleta.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${SILO} en Chile`,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title={`Hogar en Chile — arriendo, crédito hipotecario y cuentas | Hacé Cuentas`}
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="CL"
  lang="es"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
