---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { HOME_HREFLANG } from '../lib/hreflang';

const popular = [
  { href: '/salud/peso-ideal-imc', group: 'Salud', title: '¿Estoy en mi peso?', desc: 'IMC, rango saludable y contexto.', icon: '♥', color: 'mint' },
  { href: '/alquiler/aumento-de-alquiler', group: 'Alquiler', title: '¿Cuánto me aumenta el alquiler?', desc: 'ICL, IPC y fecha del contrato.', icon: '⌂', color: 'yellow' },
  { href: '/trabajo/indemnizacion-por-despido', group: 'Trabajo', title: 'Me despiden: ¿cuánto me pagan?', desc: 'Todos los conceptos de la indemnización.', icon: '↗', color: 'blue' },
  { href: '/trabajo/aguinaldo', group: 'Trabajo', title: '¿Cuánto aguinaldo me corresponde?', desc: 'SAC completo o proporcional.', icon: '＋', color: 'coral' },
  { href: '/trabajo/sueldo-vs-inflacion', group: 'Plata', title: '¿Mi sueldo le gana a la inflación?', desc: 'Inflación, poder de compra y decisiones.', icon: '%', color: 'lilac' },
  { href: '/jubilacion', group: 'Jubilación', title: '¿Cuándo y con cuánto me jubilo?', desc: 'Edad, aportes y próximos pasos.', icon: '◷', color: 'navy' },
];

const moments = [
  {
    class: 'work', number: '01', title: 'Cambió mi trabajo',
    desc: 'Entendé cuánto cobrás, cuánto perdés y qué deberían pagarte.',
    href: '/trabajo', cta: 'Resolver temas de trabajo',
    links: [
      ['/trabajo/sueldo-bruto-y-neto', 'Sueldo en mano'],
      ['/trabajo/liquidacion-final', 'Liquidación final'],
      ['/trabajo/vacaciones', 'Vacaciones'],
    ],
  },
  {
    class: 'home-life', number: '02', title: 'Alquilo, compro o construyo',
    desc: 'Todos los costos juntos antes de firmar, mudarte o empezar una obra.',
    href: '/alquiler', cta: 'Resolver vivienda y alquiler',
    links: [
      ['/alquiler/aumento-de-alquiler', 'Aumento del alquiler'],
      ['/alquiler/entrar-a-un-alquiler', 'Plata para entrar'],
      ['/construccion/costo-por-m2', 'Costo por m²'],
    ],
  },
  {
    class: 'health', number: '03', title: 'Me cuido y cuido a los míos',
    desc: 'Referencias claras para interpretar números de salud y familia.',
    href: '/salud', cta: 'Resolver preguntas de salud',
    links: [
      ['/salud/peso-ideal-imc', 'Peso e IMC'],
      ['/salud/crecimiento-infantil', 'Crecimiento infantil'],
      ['/embarazo/semanas', 'Semanas de embarazo'],
    ],
  },
  {
    class: 'money', number: '04', title: 'Ordeno mi plata',
    desc: 'Impuestos, ahorro y deudas explicados en pesos de hoy.',
    href: '/finanzas-personales', cta: 'Ordenar mis finanzas',
    links: [
      ['/impuestos/monotributo', 'Monotributo'],
      ['/finanzas-personales/dolar', 'Dólar o pesos'],
      ['/finanzas-personales/prestamo', 'Costo de un préstamo'],
    ],
  },
  {
    class: 'car', number: '05', title: 'Decido sobre el auto',
    desc: 'Compra, uso y mantenimiento vistos como un costo completo.',
    href: '/auto', cta: 'Resolver gastos del auto',
    links: [
      ['/auto/auto-o-uber', 'Auto o Uber'],
      ['/auto/costo-anual', 'Costo anual'],
      ['/auto/nafta-y-peajes', 'Nafta y peajes'],
    ],
  },
];

const live = [
  { href: '/futbol-hoy', tag: 'EN VIVO', title: 'Fútbol hoy en 14 países', meta: 'Partidos, resultados y tablas por país', color: 'navy' },
  { href: '/recategorizacion-monotributo-julio-2026', tag: 'GUÍA 2026', title: 'Recategorización Monotributo', meta: 'Nueva escala y guía para revisar tu categoría', color: 'green' },
  { href: '/valores-bcra', tag: 'HOY', title: 'Dólar, UVA e inflación', meta: 'Datos económicos diarios', color: 'blue' },
  { href: '/fechas/feriados', tag: 'CALENDARIO', title: 'Feriados de Argentina', meta: 'Días hábiles y próximos feriados', color: 'yellow' },
];

const countries = [
  ['/co','🇨🇴','Colombia'], ['/mx','🇲🇽','México'], ['/cl','🇨🇱','Chile'], ['/pe','🇵🇪','Perú'],
  ['/ec','🇪🇨','Ecuador'], ['/ve','🇻🇪','Venezuela'], ['/py','🇵🇾','Paraguay'], ['/uy','🇺🇾','Uruguay'],
  ['/do','🇩🇴','Rep. Dominicana'], ['/es','🇪🇸','España'], ['/pt','🇧🇷','Brasil'], ['/pt-pt','🇵🇹','Portugal'],
  ['/en','🌎','English'],
];

const latam = [
  ['/co/datos-salario-minimo-colombia-2026', '🇨🇴', 'Salario mínimo Colombia 2026', 'Valor mensual, diario y con auxilio de transporte'],
  ['/mx/datos-salario-minimo-mexico-2026', '🇲🇽', 'Salario mínimo México 2026', 'General y Frontera Norte, por día y por mes'],
  ['/mx/datos-uma-imss-2026', '🇲🇽', 'Valor de la UMA 2026', 'Diaria, mensual y anual (INEGI)'],
  ['/pe/datos-sueldo-minimo-peru-2026', '🇵🇪', 'Sueldo mínimo Perú 2026', 'RMV vigente y cálculo por hora'],
  ['/pe/calculadora-tipo-de-cambio-sunat-dolar-soles-peru', '🇵🇪', 'Tipo de cambio SUNAT hoy', 'Dólar a soles, compra y venta'],
  ['/co/calculadora-trm-dolar-hoy-pesos-colombianos', '🇨🇴', 'TRM dólar hoy', 'Pesos colombianos por dólar'],
  ['/ec/calculadora-prestamo-quirografario-iess-ecuador', '🇪🇨', 'Préstamo quirografario IESS', 'Cuota, plazo e interés BIESS'],
  ['/es/calculadora-irpf-2026-tramos-espana-nomina', '🇪🇸', 'IRPF 2026 en la nómina', 'Tramos y retención por comunidad'],
  ['/feriados-colombia-2026', '🇨🇴', 'Festivos Colombia 2026', '19 festivos y puentes'],
  ['/feriados-chile-2026', '🇨🇱', 'Feriados Chile 2026', 'Calendario oficial e irrenunciables'],
  ['/feriados-peru-2026', '🇵🇪', 'Feriados Perú 2026', 'Días no laborables y feriados largos'],
  ['/datos-monotributo-2026', '🇦🇷', 'Categorías Monotributo 2026', 'Tabla de topes y cuotas vigentes'],
];

const silos = [
  ['/alquiler','Alquiler'], ['/auto','Auto'], ['/bebes','Bebés'], ['/ciencia','Ciencia'], ['/cocina','Cocina'],
  ['/construccion','Construcción'], ['/conversores','Conversiones'], ['/embarazo','Embarazo'], ['/estudio','Estudio'],
  ['/eventos','Eventos'], ['/familia','Familia'], ['/fechas','Fechas'], ['/finanzas-personales','Finanzas'],
  ['/futbol','Fútbol'], ['/hogar','Hogar'], ['/impuestos','Impuestos'], ['/inversiones','Inversiones'],
  ['/jardin','Jardín'], ['/jubilacion','Jubilación'], ['/mascotas','Mascotas'], ['/matematica','Matemática'],
  ['/negocios','Negocios'], ['/nutricion','Nutrición'], ['/ocio','Ocio'], ['/salud','Salud'],
  ['/tecnologia','Tecnología'], ['/trabajo','Trabajo'], ['/viajes','Viajes'], ['/vivienda','Vivienda'],
];

const searchItems = [...popular.map(({ href, title, group }) => ({ href, label: title, group })),
  ...moments.flatMap((m) => m.links.map(([href, label]) => ({ href, label, group: m.title })))];
const uniqueSearchItems = [...new Map(searchItems.map((item) => [item.href, item])).values()];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Hacé Cuentas',
  url: 'https://hacecuentas.com/',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://hacecuentas.com/buscar?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="Decisiones con números claros para Argentina — Hacé Cuentas"
  description="Hubs de decisión para resolver trabajo, alquiler, impuestos, finanzas, salud y vida cotidiana con números claros, fuentes y datos vigentes."
  image="/og/index.png"
  audience="AR"
  pageType="home"
  schema={schema}
  hreflang={HOME_HREFLANG}
>
  <Header slot="header" />

  <div class="hc-home">
    <div class="hero">
      <div class="hero-copy">
        <span class="hero-label">UNA PREGUNTA. LA CUENTA COMPLETA.</span>
        <h1>No adivines.<br /><em>Hacé cuentas.</em></h1>
        <p>Respuestas para decisiones reales de plata, trabajo, salud y vida cotidiana. Con la norma aplicada, la fuente y la fecha del dato.</p>
        <p class="hero-proof"><strong>Más de 600 calculadoras y guías gratuitas</strong> para resolver una cuenta y entender qué hacer después.</p>

        <form class="search" id="hub-search" role="search" action="/buscar" method="get">
          <label for="home-query">¿Qué necesitás resolver?</label>
          <div class="search-box">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.7-4.7m2.2-5.3a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"/></svg>
            <input id="home-query" name="q" type="search" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" placeholder="Ej: me despidieron, ¿cuánto me tienen que pagar?" autocomplete="off" aria-controls="hub-results" aria-expanded="false" />
            <button type="submit">Encontrar respuesta <span>→</span></button>
          </div>
          <div class="search-results" id="hub-results" role="listbox" aria-label="Resultados de búsqueda" aria-live="polite" hidden></div>
          <p class="search-status" id="hub-search-status" role="status" aria-live="polite"></p>
        </form>

        <nav class="quick-searches" aria-label="Búsquedas frecuentes">
          <span>Probá con:</span>
          <button type="button" data-query="sueldo neto">Sueldo neto</button>
          <button type="button" data-query="monotributo">Monotributo</button>
          <button type="button" data-query="aumento alquiler">Alquiler</button>
          <button type="button" data-query="indemnización">Indemnización</button>
        </nav>

        <div class="hero-trust">
          <span><i>✓</i> Gratis</span>
          <span><i>⌁</i> Fuentes citadas</span>
          <span><i>◷</i> Datos vigentes</span>
        </div>
      </div>

    </div>

    <section class="popular wrap" aria-labelledby="popular-title">
      <div class="section-title">
        <div><span>PARA EMPEZAR</span><h2 id="popular-title">Empezá por una pregunta.</h2></div>
        <p>Seis decisiones frecuentes para llegar rápido a la cuenta que necesitás.</p>
      </div>
      <div class="popular-grid">
        {popular.map((item) => (
          <a class:list={['popular-card', `popular-card--${item.color}`]} href={item.href} data-home-section="popular">
            <div class="popular-icon">{item.icon}</div>
            <div><span>{item.group}</span><h3>{item.title}</h3><p>{item.desc}</p></div>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="moments" aria-labelledby="moments-title">
      <div class="wrap">
        <div class="section-title section-title--light">
          <div><span>LA VIDA NO VIENE POR CATEGORÍAS</span><h2 id="moments-title">Elegí tu momento.</h2></div>
          <p>Cada página junta las cuentas que aparecen cuando estás frente a una decisión real.</p>
        </div>
        <div class="moment-grid">
          {moments.map((item) => (
            <article class:list={['moment-card', `moment-card--${item.class}`]}>
              <span class="moment-number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
              <ul>{item.links.map(([href, label]) => <li><a href={href}>{label}<span>→</span></a></li>)}</ul>
              <a class="moment-cta" href={item.href} data-home-section="moment">{item.cta} <span>↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="fresh wrap" aria-labelledby="fresh-title">
      <div class="section-title">
        <div><span>LOS DATOS CAMBIAN</span><h2 id="fresh-title">La vigencia también es parte de la respuesta.</h2></div>
        <p>Cuando cambia un índice, una escala o un calendario, la cuenta tiene que mostrarlo.</p>
      </div>
      <div class="fresh-grid">
        {live.map((item) => (
          <a class:list={['fresh-card', `fresh-card--${item.color}`]} href={item.href} data-home-section="fresh">
            <span>{item.tag}</span><h3>{item.title}</h3><p>{item.meta}</p><b>Ver dato actualizado ↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="method wrap" aria-labelledby="method-title">
      <div class="method-visual">
        <div class="method-ring"><span>✓</span></div>
        <div class="method-card method-card--a"><small>01</small><b>La norma</b><span>Qué regla se aplica</span></div>
        <div class="method-card method-card--b"><small>02</small><b>La fuente</b><span>De dónde sale el dato</span></div>
        <div class="method-card method-card--c"><small>03</small><b>La fecha</b><span>Desde cuándo está vigente</span></div>
      </div>
      <div class="method-copy">
        <span>CÓMO TRABAJAMOS</span>
        <h2 id="method-title">Podés revisar de dónde sale cada número.</h2>
        <p>No escondemos supuestos. Cada respuesta identifica la fórmula o norma, cita fuentes primarias cuando existen y muestra la fecha de vigencia.</p>
        <a href="/metodologia">Conocer nuestra metodología <b>→</b></a>
      </div>
    </section>

    <section class="world">
      <div class="wrap world-grid">
        <div class="world-copy">
          <span>HECHO PARA CADA PAÍS</span>
          <h2>Estás en Argentina.<br />También sabemos las reglas de otros 13 mercados.</h2>
          <p>Cada país tiene sus propias preguntas, leyes y valores. No traducimos la experiencia argentina: construimos respuestas locales.</p>
        </div>
        <div class="country-grid">
          {countries.map(([href, flag, label]) => <a href={href} data-home-section="country"><span>{flag}</span><b>{label}</b><i>↗</i></a>)}
        </div>
      </div>
    </section>

    <section class="latam wrap" aria-labelledby="latam-title">
      <div class="section-title">
        <div><span>DATOS OFICIALES POR PAÍS</span><h2 id="latam-title">Los valores que más se consultan en Latinoamérica y España.</h2></div>
        <p>Salarios mínimos, feriados, tipos de cambio y escalas fiscales con la fuente oficial y la fecha de vigencia.</p>
      </div>
      <nav class="latam-grid" aria-label="Datos oficiales más consultados">
        {latam.map(([href, flag, title, meta]) => (
          <a href={href} data-home-section="latam"><span aria-hidden="true">{flag}</span><b>{title}</b><small>{meta}</small></a>
        ))}
      </nav>
    </section>

    <section class="directory wrap" aria-labelledby="directory-title">
      <div><span>EXPLORAR</span><h2 id="directory-title">Hay una respuesta para cada cuenta.</h2></div>
      <details>
        <summary>Ver todas las áreas <span aria-hidden="true">↓</span></summary>
        <nav aria-label="Áreas de Hacé Cuentas">
          {silos.map(([href, label]) => <a href={href} data-home-section="directory">{label}<span>↗</span></a>)}
        </nav>
      </details>
    </section>
  </div>

  <Footer slot="footer" />
  <ScrollToTop />

  <script is:inline define:vars={{ searchItems: uniqueSearchItems }}>
    (() => {
      const form = document.getElementById('hub-search');
      const input = document.getElementById('home-query');
      const results = document.getElementById('hub-results');
      const status = document.getElementById('hub-search-status');
      if (!form || !input || !results || !status) return;
      const normalize = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[char]);
      const track = (name, params = {}) => { if (typeof window.hcTrack === 'function') window.hcTrack(name, params); };
      let fullIndex = null;
      let loadingPromise = null;
      let started = false;
      let lastNoResults = '';
      const loadIndex = async () => {
        if (fullIndex) return fullIndex;
        if (loadingPromise) return loadingPromise;
        status.textContent = 'Buscando entre más de 600 herramientas…';
        loadingPromise = (async () => { try {
          const response = await fetch('/api/calcs-index.json');
          if (!response.ok) throw new Error('index');
          const data = await response.json();
          fullIndex = (data.calculators || [])
            .filter((item) => item.locale === 'es' && (item.audience === 'AR' || item.audience === 'global'))
            .map((item) => ({ href: new URL(item.url).pathname, label: item.h1 || item.title, group: item.category || 'Calculadoras' }));
        } catch { fullIndex = []; }
        status.textContent = '';
        return fullIndex;
        })();
        return loadingPromise;
      };
      const closeResults = () => {
        results.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
      };
      const render = async () => {
        const query = normalize(input.value).trim();
        if (query.length < 2) {
          closeResults(); results.innerHTML = ''; status.textContent = ''; return [];
        }
        const remoteItems = await loadIndex();
        if (query !== normalize(input.value).trim()) return [];
        const terms = query.split(/\s+/);
        const items = [...new Map([...searchItems, ...remoteItems].map((item) => [item.href, item])).values()];
        const matches = items.filter((item) => {
          const text = normalize(item.label + ' ' + item.group);
          return terms.every((term) => text.includes(term));
        }).slice(0, 6);
        results.innerHTML = matches.length
          ? matches.map((item, index) => `<a id="hub-option-${index}" role="option" aria-selected="false" data-position="${index + 1}" href="${escapeHtml(item.href)}"><span>${escapeHtml(item.group)}</span><b>${escapeHtml(item.label)}</b><i aria-hidden="true">→</i></a>`).join('')
          : '<div class="search-empty"><b>No encontramos una coincidencia exacta.</b><span>Probá con menos palabras o buscá en todo el catálogo.</span><a href="/buscar?q=' + encodeURIComponent(input.value.trim()) + '">Ver todas las herramientas →</a></div>';
        results.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        status.textContent = matches.length ? `${matches.length} resultados disponibles.` : 'No encontramos coincidencias exactas.';
        if (!matches.length && query !== lastNoResults) {
          lastNoResults = query;
          track('hc_search_no_results', { search_term: input.value.trim(), source_page: location.pathname });
        }
        return matches;
      };
      const focusOption = (index) => {
        const options = [...results.querySelectorAll('[role="option"]')];
        if (!options.length) return;
        const selected = (index + options.length) % options.length;
        options.forEach((option, current) => option.setAttribute('aria-selected', current === selected ? 'true' : 'false'));
        input.setAttribute('aria-activedescendant', options[selected].id);
        options[selected].focus();
      };
      input.addEventListener('input', () => {
        if (!started && input.value.trim()) { started = true; track('hc_search_started', { source_page: location.pathname }); }
        render();
      });
      input.addEventListener('focus', () => {
        track('hc_home_search_focus', { source_page: location.pathname });
        loadIndex().then(() => { if (document.activeElement === input) render(); });
      }, { once: true });
      input.addEventListener('mouseenter', loadIndex, { once: true });
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeResults();
        if (event.key === 'ArrowDown' && !results.hidden) {
          event.preventDefault(); focusOption(0);
        }
      });
      results.addEventListener('keydown', (event) => {
        const options = [...results.querySelectorAll('[role="option"]')];
        const current = options.indexOf(document.activeElement);
        if (event.key === 'Escape') { closeResults(); input.focus(); }
        if (event.key === 'ArrowDown') { event.preventDefault(); focusOption(current + 1); }
        if (event.key === 'ArrowUp') { event.preventDefault(); current <= 0 ? input.focus() : focusOption(current - 1); }
      });
      results.addEventListener('click', (event) => {
        const link = event.target.closest('[role="option"]');
        if (link) track('hc_search_result_clicked', { target_slug: link.pathname.replace(/^\//, ''), result_position: Number(link.dataset.position || 0), source_page: location.pathname });
      });
      document.addEventListener('click', (event) => {
        if (!form.contains(event.target)) closeResults();
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const rawQuery = input.value.trim();
        if (!rawQuery) { status.textContent = 'Escribí una cuenta o una situación para buscar.'; input.focus(); return; }
        track('hc_search_submitted', { search_term: rawQuery, source_page: location.pathname });
        const matches = await render();
        if (matches.length) window.location.href = matches[0].href;
        else window.location.href = '/buscar?q=' + encodeURIComponent(rawQuery);
      });
      document.querySelectorAll('.quick-searches [data-query]').forEach((button) => button.addEventListener('click', () => {
        input.value = button.dataset.query || '';
        input.focus();
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }));
      document.querySelectorAll('[data-home-section]').forEach((link) => link.addEventListener('click', () => {
        track('related_click', { interaction_type: link.dataset.homeSection, target_slug: link.pathname.replace(/^\//, ''), source_page: location.pathname });
      }));
    })();
  </script>
</Layout>

<style>
  :global(body[data-page-type="home"]) { background: #fff; color: #182238; }
  :global(body[data-page-type="home"] > main#main) { width: 100%; max-width: none; margin: 0; padding: 0; overflow: clip; }
  .hc-home { --navy:#174B7A; --blue:#477df4; --mint:#45bd88; --coral:#f47c63; --yellow:#f4c551; --paper:#f8f9fc; --line:#e4e8ef; }
  .wrap, .hero { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  h1,h2,h3,p { margin-top: 0; }
  a { color: inherit; }

  .hero { display:block; min-height:0; padding:84px 0 92px; }
  .hero-copy { max-width:900px; }
  .hero-label, .section-title span, .method-copy>span, .world-copy>span, .directory>div>span { color:#5a6d89; font-size:11px; font-weight:800; letter-spacing:.13em; }
  .hero h1 { margin:20px 0 24px; color:var(--navy); font-size:clamp(58px,6.3vw,86px); line-height:.93; letter-spacing:-.07em; }
