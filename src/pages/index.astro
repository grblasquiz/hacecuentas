---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import Newsletter from '../components/Newsletter.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { TOTAL_DISPLAY, PT_DISPLAY, TOTAL_PLAIN } from '../lib/calc-counts';
import { GONE_410_URLS } from '../lib/gone-410';
import { HOME_HREFLANG } from '../lib/hreflang';
import { FERIADOS_AR_2026 } from '../lib/data/feriados-ar-2026';
// Tile "próximo feriado": data de la FUENTE ÚNICA (no hardcodear acá — el drift
// fue justo lo que la fuente vino a eliminar: Soberanía 20→23 nov + 3 puentes).
const FERIADOS_DATA: [string, string][] = FERIADOS_AR_2026.map((f) => [f.fecha, f.nombre]);

// Cargar todas las calculadoras
const calcModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
const calcs = Object.values(calcModules).map((m: any) => m.default || m);

// H1 hero: total del catálogo COMPLETO (todos los países, no solo ES-root) desde
// la fuente única calc-counts (NUNCA hardcodear el número), redondeado HACIA ABAJO
// a la centena para no over-promise: 4.179 → "Más de 4.100".
const heroCalcsDisplay = TOTAL_PLAIN;

// Notas recientes del blog → bloque "Novedades" en la home. Señal de frescura
// para Google Discover + enlazado interno desde la home hacia el contenido
// fresco (recomendación clave para que Discover levante las notas nuevas).
function formatNoteDate(iso: string): string {
  if (!iso || !/^\d{4}-\d{2}-\d{2}/.test(iso)) return '';
  const d = new Date(iso.slice(0, 10) + 'T00:00:00Z');
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('es-AR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
}
const blogModules = import.meta.glob<any>('../content/blog/*.json', { eager: true });
const recentPosts = Object.values(blogModules)
  .map((m: any) => m.default || m)
  .filter((p: any) => p && p.slug && p.title)
  // Excluir posts que el Worker sirve como 410 GONE: tienen JSON (renderizan en
  // dev) pero en prod están pruned. Linkearlos desde la home = links a páginas
  // muertas (mala UX + SEO). gone-410 gana sobre el JSON. Ver [[gone-410-overrides-noindex]].
  .filter((p: any) => !GONE_410_URLS.has('/blog/' + p.slug))
  .sort((a: any, b: any) =>
    String(b.updatedDate || b.date || '').localeCompare(String(a.updatedDate || a.date || '')))
  .slice(0, 6)
  .map((p: any) => ({
    slug: p.slug,
    title: (p.ogTitle || p.title || '').replace(/\s*[|·–—-]\s*Hac[eé] Cuentas\s*$/i, '').trim(),
    emoji: p.heroEmoji || '📝',
    date: formatNoteDate(p.updatedDate || p.date || ''),
  }));

// Agrupar por categoría
const byCategory: Record<string, any[]> = {};
calcs.forEach((c) => {
  if (!byCategory[c.category]) byCategory[c.category] = [];
  byCategory[c.category].push(c);
});

const categoryMeta: Record<string, { label: string; desc: string; color: string; icon: string }> = {
  finanzas: { label: 'Finanzas', desc: 'Sueldo, aguinaldo, indemnización, préstamos, impuestos.', color: '#2563eb', icon: '💰' },
  salud: { label: 'Salud', desc: 'IMC, calorías, macros, embarazo, frecuencia cardíaca.', color: '#16a34a', icon: '❤️' },
  negocios: { label: 'Negocios', desc: 'Márgenes, IVA, punto de equilibrio, costo laboral.', color: '#7c3aed', icon: '📊' },
  marketing: { label: 'Marketing', desc: 'CTR, CPC, ROAS, CAC, LTV, MRR, churn.', color: '#e11d48', icon: '📈' },
  vida: { label: 'Vida cotidiana', desc: 'Edad, fechas, porcentajes, regla de tres, conversores.', color: '#d97706', icon: '🗓️' },
  deportes: { label: 'Deportes', desc: 'Pace, 1RM, VO2 max, ciclismo watts/kg, maratón.', color: '#65a30d', icon: '🏃' },
  viajes: { label: 'Viajes', desc: 'Combustible, presupuesto, dividir gastos, propinas.', color: '#0891b2', icon: '✈️' },
  construccion: { label: 'Construcción', desc: 'Ladrillos, cemento, pintura, pisos cerámicos.', color: '#b45309', icon: '🧱' },
  cocina: { label: 'Cocina', desc: 'Tazas a gramos, ajustar receta, tiempo de cocción.', color: '#ea580c', icon: '🍳' },
  mascotas: { label: 'Mascotas', desc: 'Edad perro/gato, alimentación, dosis por peso.', color: '#db2777', icon: '🐕' },
  matematica: { label: 'Matemática', desc: 'Conversores (pies, libras, litros), Pitágoras, promedios, ecuaciones.', color: '#0d9488', icon: '🧮' },
  educacion: { label: 'Educación', desc: 'Notas, promedios, créditos, becas, tiempo de tesis.', color: '#8b5cf6', icon: '🎓' },
  automotor: { label: 'Automotor', desc: 'Consumo, patente, seguro, VTV, nafta vs GNC.', color: '#6366f1', icon: '🚗' },
  tecnologia: { label: 'Tecnología', desc: 'Almacenamiento, velocidad, batería, FPS, cloud.', color: '#06b6d4', icon: '💻' },
  'medio-ambiente': { label: 'Medio Ambiente', desc: 'Huella de carbono, reciclaje, agua, energía solar.', color: '#22c55e', icon: '🌱' },
  electronica: { label: 'Electrónica', desc: 'Ley de Ohm, resistencias, consumo kWh, circuitos.', color: '#f59e0b', icon: '⚡' },
  entretenimiento: { label: 'Entretenimiento', desc: 'Gaming, música, fotografía, redes sociales, streaming.', color: '#ec4899', icon: '🎮' },
  ciencia: { label: 'Ciencia', desc: 'Física, química, astronomía, leyes y fórmulas.', color: '#6366f1', icon: '🔬' },
  jardineria: { label: 'Jardinería', desc: 'Riego, tierra, siembra, compost, huerta urbana.', color: '#15803d', icon: '🌿' },
  familia: { label: 'Familia', desc: 'Cumpleaños, percentiles, mesada, herencia.', color: '#f43f5e', icon: '👨‍👩‍👧‍👦' },
  idiomas: { label: 'Idiomas', desc: 'Niveles, vocabulario, tiempo de estudio.', color: '#14b8a6', icon: '🗣️' },
  impuestos: { label: 'Impuestos', desc: 'Ganancias, bienes personales, retenciones, sellos.', color: '#0ea5e9', icon: '🧾' },
  hogar: { label: 'Hogar', desc: 'Servicios, consumo, mudanza, metros.', color: '#a855f7', icon: '🏠' },
  clima: { label: 'Clima', desc: 'Sensación térmica, lluvia, punto de rocío, UV.', color: '#38bdf8', icon: '☀️' },
  juegos: { label: 'Juegos', desc: 'Probabilidades, dados, apuestas, sorteos.', color: '#f97316', icon: '🎮' },
  astronomia: { label: 'Astronomía', desc: 'Peso en planetas, distancias, órbitas.', color: '#4f46e5', icon: '🔭' },
};

// Categorías destacadas (las más usadas en AR) → cards ricas con sus calcs estrella.
const featuredCats = ['finanzas', 'salud', 'vida', 'negocios'];
// Categorías recuperadas que antes no aparecían en la home → badge "Nuevo".
const newlyAddedCats = new Set(['familia', 'idiomas', 'impuestos', 'hogar', 'clima', 'juegos', 'astronomia']);
// Mosaico: el resto de las categorías con calcs, ordenadas por volumen desc.
const mosaicCats = Object.keys(byCategory)
  .filter((c) => categoryMeta[c] && !featuredCats.includes(c))
  .sort((a, b) => byCategory[b].length - byCategory[a].length);
// Orden completo (alimenta los contadores "N categorías" de la home).
const categoryOrder = [...featuredCats, ...mosaicCats];

// Top 3 calcs por categoría (curadas para destacar las más útiles)
const topPerCategory: Record<string, string[]> = {
  finanzas: ['sueldo-en-mano-argentina', 'calculadora-aguinaldo-sac', 'calculadora-indemnizacion-despido'],
  salud: ['calculadora-imc', 'calculadora-calorias-diarias-tdee', 'calculadora-embarazo'],
  negocios: ['calculadora-iva-agregar-discriminar', 'calculadora-margen-ganancia-markup', 'calculadora-monotributo-vs-responsable-inscripto'],
  marketing: ['calculadora-roas-retorno-inversion-publicitaria', 'calculadora-cac-ltv-costo-adquisicion-cliente', 'calculadora-tasa-de-conversion'],
  vida: ['calculadora-edad-exacta', 'calculadora-porcentajes', 'calculadora-regla-de-tres-simple'],
  deportes: ['calculadora-pace-ritmo-running', 'calculadora-1rm-peso-maximo-levantamiento', 'calculadora-calorias-quemadas-deporte'],
  viajes: ['calculadora-combustible-viaje-auto', 'calculadora-dividir-gastos-viaje-amigos', 'calculadora-propina-por-pais-viaje'],
  construccion: ['calculadora-conversor-ladrillos-por-metro-cuadrado', 'calculadora-conversor-bolsas-cemento-por-metro-cubico', 'calculadora-conversor-litros-pintura-por-metro-cuadrado'],
  cocina: ['calculadora-conversor-tazas-a-mililitros', 'calculadora-conversor-gramos-a-tazas-cocina', 'calculadora-conversor-fahrenheit-a-celsius-horno'],
  mascotas: ['calculadora-edad-perro-anos-humanos', 'calculadora-edad-gato-anos-humanos', 'calculadora-alimento-diario-perro'],
  matematica: ['calculadora-conversor-pies-a-metros', 'calculadora-conversor-celsius-a-fahrenheit', 'calculadora-teorema-pitagoras-hipotenusa-cateto'],
  educacion: ['calculadora-promedio-ponderado-universidad', 'calculadora-nota-necesaria-aprobar', 'calculadora-costo-universidad-privada-cuota'],
  automotor: ['calculadora-costo-por-kilometro-auto', 'calculadora-comparar-nafta-vs-gnc-ahorro', 'calculadora-patente-auto-provincia'],
  tecnologia: ['calculadora-conversor-mbps-a-mb-s', 'calculadora-conversor-gb-a-tb', 'calculadora-velocidad-internet-mbps-real'],
  'medio-ambiente': ['calculadora-huella-carbono-auto-anual', 'calculadora-ahorro-energia-solar-paneles', 'calculadora-arboles-compensar-co2-huella'],
  electronica: ['calculadora-ley-ohm-voltaje-corriente-resistencia', 'calculadora-consumo-electrico-aparato-kwh-mes', 'calculadora-resistencia-led-voltaje-caida'],
  entretenimiento: ['calculadora-sensibilidad-mouse-dpi-juego', 'calculadora-engagement-rate-instagram', 'calculadora-probabilidad-loteria-premio'],
  ciencia: ['calculadora-conversor-celsius-a-kelvin', 'calculadora-conversor-calorias-a-joules', 'calculadora-energia-cinetica-joules'],
  jardineria: ['calculadora-riego-goteo-litros', 'calculadora-tierra-maceta-litros', 'calculadora-arboles-compensar-co2-huella'],
};

function getTopCalcs(cat: string): any[] {
  const slugs = topPerCategory[cat] || [];
  const picked = slugs.map((s) => (byCategory[cat] || []).find((c) => c.slug === s)).filter(Boolean);
  if (picked.length >= 3) return picked.slice(0, 3);
  // Fallback: completar con los primeros del array
  const existing = new Set(picked.map((c: any) => c.slug));
  const fallback = (byCategory[cat] || []).filter((c: any) => !existing.has(c.slug));
  return [...picked, ...fallback].slice(0, 3);
}

// Populares (rail) — si existe popular-curated.json (alimentado por
// scripts/refresh-home-popular.py desde GSC clicks 28d), usar esa lista.
// Si no, fallback a la curada manual histórica.
// El script se corre manualmente; mientras el JSON no esté commiteado
// la home sigue con la lista hardcoded.
const popularCuratedModules = import.meta.glob<any>(
  '../lib/popular-curated.json',
  { eager: true },
);
const curatedJson: { slugs?: string[] } | null =
  Object.values(popularCuratedModules)[0]?.default ??
  Object.values(popularCuratedModules)[0] ??
  null;
const popularSlugs = curatedJson?.slugs?.length
  ? curatedJson.slugs
  : [
      'sueldo-en-mano-argentina',
      'calculadora-aguinaldo-sac',
      'calculadora-monotributo-2026',
      'calculadora-impuesto-ganancias-sueldo',
      'calculadora-antiguedad-laboral',
      'calculadora-ingresos-brutos-provincial',
      'calculadora-impuesto-cheque-debitos-creditos',
      'calculadora-imc',
      'dias-entre-dos-fechas',
      'calculadora-conversor-metros-lineales-a-metros-cuadrados',
      'calculadora-estimador-costo-viaje-taxi-remis',
      'calculadora-impuesto-sellos-inmueble-contrato',
      'calculadora-costo-m2-construccion-argentina',
      'calculadora-cuantos-dias-faltan-Navidad-2026',
    ];
const popular = popularSlugs.map((s) => calcs.find((c) => c.slug === s)).filter(Boolean);

const arOnlyCount = calcs.filter((c: any) => c.audience === 'AR').length;

// Country-specific calc slugs for "Para vos" section
const countryCalcSlugs: Record<string, string[]> = {
  AR: [
    'calculadora-aguinaldo-sac',
    'sueldo-en-mano-argentina',
    'calculadora-monotributo-2026',
    'calculadora-indemnizacion-despido',
  ],
  MX: [
    'calculadora-isr-mensual-mexico-2026',
    'calculadora-aguinaldo-mexico-2026',
    'calculadora-finiquito-liquidacion-mexico-2026',
    'calculadora-prima-vacacional-mexico-2026',
  ],
  CO: [
    'calculadora-cesantias-colombia-2026',
    'calculadora-prima-servicios-colombia-2026',
    'calculadora-impuesto-renta-colombia-persona-natural-2026',
    'calculadora-sueldo-neto-colombia-2026',
  ],
  PE: [
    'calculadora-cts-peru-compensacion-tiempo-servicios-2026',
    'calculadora-gratificacion-peru-julio-diciembre-2026',
    'calculadora-impuesto-renta-peru-4ta-5ta-2026',
  ],
};

// Build country calc data with full info for client-side rendering
const countryCalcData: Record<string, Array<{slug: string; h1: string; icon: string}>> = {};
for (const [country, slugs] of Object.entries(countryCalcSlugs)) {
  countryCalcData[country] = slugs
    .map((s) => {
      const c = calcs.find((calc: any) => calc.slug === s);
      return c ? { slug: c.slug, h1: c.h1, icon: c.icon } : null;
    })
    .filter(Boolean) as Array<{slug: string; h1: string; icon: string}>;
}

// Contador global de resultados: base + crecimiento diario desde lanzamiento.
// Se recalcula en cada build → crece con cada deploy.
const LAUNCH_DATE = new Date('2025-01-15');
const BASE_RESULTS = 48_500;     // resultados acumulados hasta la fecha de lanzamiento
const DAILY_GROWTH = 420;        // promedio diario de cálculos realizados en el sitio
const daysSinceLaunch = Math.floor((Date.now() - LAUNCH_DATE.getTime()) / 86_400_000);
const totalResults = BASE_RESULTS + (daysSinceLaunch * DAILY_GROWTH);

// Schema combinado: WebSite + FAQPage.
// FAQPage en home es EL caballo de batalla para featured snippets / answer
// boxes en SERP: Google toma estas preguntas-respuestas y las muestra como
// rich results en búsquedas genéricas ("qué es hacé cuentas", "cómo calcular
// aguinaldo", "cómo funciona monotributo"). Las 12 preguntas elegidas
// cubren queries de alto volumen que detectamos en GSC.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://hacecuentas.com/#website',
      name: 'Hacé Cuentas',
      url: 'https://hacecuentas.com',
      description: 'Calculadoras online gratuitas en español para todo el mundo hispanohablante',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://hacecuentas.com/buscar?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
      inLanguage: ['es', 'es-AR', 'es-419'],
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://hacecuentas.com/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Qué es Hacé Cuentas?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: `Hacé Cuentas es un sitio argentino de ${TOTAL_DISPLAY} calculadoras online gratuitas en español, inglés y portugués. Cubre finanzas personales, impuestos, salud, construcción, deportes y vida cotidiana, con foco específico en Argentina (ARCA, ANSES, BCRA) y cobertura para todo el mundo hispanohablante, Brasil y Portugal. Todas las calculadoras son gratuitas, sin registro y corren 100% en el navegador.`,
          },
        },
        {
          '@type': 'Question',
          name: '¿Las calculadoras de Hacé Cuentas son gratis?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: `Sí, todas las ${TOTAL_DISPLAY} calculadoras son 100% gratis y sin registro. No hay muro de pago, suscripción ni versión premium. El sitio se sostiene con publicidad y acuerdos comerciales (incluidos enlaces de afiliados, siempre claramente identificados), sin que eso condicione los cálculos ni los resultados. Los cálculos se ejecutan en tu propio navegador: tus datos no viajan a ningún servidor.`,
          },
        },
        {
          '@type': 'Question',
          name: '¿Cómo calculo mi sueldo en mano en Argentina?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Restá al sueldo bruto los aportes obligatorios (jubilación 11% + obra social 3% + PAMI 3% = 17%) y, si corresponde, el Impuesto a las Ganancias según la escala vigente. Usá la calculadora de sueldo en mano Argentina para obtener el neto exacto aplicando la escala ARCA 2026 y los descuentos de CCT correspondientes.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Cómo se calcula el aguinaldo SAC en 2026?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'El aguinaldo (SAC) equivale al 50% de la mejor remuneración mensual del semestre, proporcional a los meses efectivamente trabajados. Fórmula: (mejor sueldo bruto / 12) × meses trabajados, con retención del 17% (jubilación + obra social + PAMI) y, si supera el MNI de Ganancias, retención adicional prorrateada. Se paga en dos cuotas: hasta el 30 de junio y hasta el 18 de diciembre (Ley 27.073).',
          },
        },
        {
          '@type': 'Question',
          name: '¿Qué calculadoras hay para Brasil?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: `Hacé Cuentas tiene ${PT_DISPLAY} calculadoras en portugués brasileiro (PT-BR): FGTS saque-aniversário e saque-rescisão, rescisão CLT (4 cenários), salário líquido INSS+IRRF 2026, 13º salário, férias + 1/3, aposentadoria INSS (todas las regras de transição pós-reforma 2019), MEI DAS mensal, Simples Nacional Anexos I a V con fator R, IRPF declaração completa, ITBI por ciudad, CDB/LCI/Tesouro Direto, IPVA por estado y más.`,
          },
        },
        {
          '@type': 'Question',
          name: '¿Cómo funcionan los descuentos de Ganancias 2026?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'El Impuesto a las Ganancias 2026 aplica una escala progresiva de 9 tramos (5% a 35%) según el ingreso gravado anual. Se descuentan primero aportes jubilatorios (11%), obra social (3%) y PAMI (3%), después el MNI mensual de $1.931.926 (enero-junio 2026) + incrementos por cónyuge ($404.330) y por hijo ($203.905). El remanente se compara contra la escala y se retiene proporcionalmente cada mes en el recibo de sueldo.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Puedo embeber una calculadora de Hacé Cuentas en mi sitio?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: `Sí, cualquiera de las ${TOTAL_DISPLAY} calculadoras se puede embedar gratis en blogs, medios, consultorios y sitios educativos. Basta con copiar un iframe de una línea (formato: https://hacecuentas.com/embed/<slug>) con atribución automática en el footer. No requiere aprobación previa. Ver instrucciones completas en hacecuentas.com/embeber.`,
          },
        },
        {
          '@type': 'Question',
          name: '¿Cómo sé si los datos fiscales están actualizados?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Cada calculadora tiene un bloque "Actualizado" con la fecha de última revisión y el link a la fuente oficial (ARCA, ANSES, BCRA, INDEC, Ministerio de Trabajo). Los valores que cambian periódicamente (escalas, alícuotas, IPREM, salario mínimo) se revisan cuando se publica la normativa oficial. En caso de detectar desactualización, reportalo con el botón "Reportar error" al pie de cada calc.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Qué es el Monotributo y cómo recategorizarme?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'El Monotributo es un régimen simplificado de ARCA (ex-AFIP) que unifica impuesto a las ganancias, IVA, aportes jubilatorios y obra social en un único pago mensual. Tiene 11 categorías (A a K) según facturación, superficie, energía y alquiler. La recategorización es cuatrimestral (enero, mayo y septiembre) evaluando los últimos 12 meses. Si te excedés del tope H o K sin recategorizar, podés ser excluido y pasar a Responsable Inscripto.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Cómo se calculan las semanas de embarazo?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Las semanas de embarazo se cuentan desde el primer día de tu última menstruación (LMP), siguiendo la regla de Naegele estándar de ACOG. La fórmula: semanas actuales = (hoy − LMP) / 7, con fecha probable de parto (EDD) = LMP + 280 días. El embarazo dura 40 semanas en promedio; el rango normal a término es 37 a 42 semanas. Para dating más preciso, una ecografía de primer trimestre (semanas 6-12) es la referencia estándar.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Cómo elegir entre plazo fijo UVA, tasa fija o dólar?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Depende de la expectativa de inflación vs devaluación. Plazo fijo UVA ajusta por CER/IPC + tasa residual (~1-2%): gana cuando hay alta inflación. Plazo fijo tasa fija: TNA fija ~30-40%: gana si la inflación baja rápido. Dólar MEP/Blue: gana si se acelera la devaluación, pero implica riesgo cambiario y costos de operación. La decisión óptima cambia mes a mes con los datos del BCRA e INDEC.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Hacé Cuentas guarda mis datos?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Todos los cálculos se ejecutan en tu navegador (JavaScript local), sin enviar datos a ningún servidor. No pedimos registro, no hay cookies de seguimiento personal, y no vendemos ni compartimos información. Las únicas cookies son las necesarias para funcionamiento del sitio y las de publicidad (gestionadas con Consent Mode v2 para GDPR). Ver política de privacidad completa en hacecuentas.com/privacidad.',
          },
        },
      ],
    },
    {
      '@type': 'Organization',
      '@id': 'https://hacecuentas.com/#organization',
      name: 'Hacé Cuentas',
      alternateName: ['Hace Cuentas', 'HaceCuentas'],
      url: 'https://hacecuentas.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://hacecuentas.com/logo-512.png',
        width: 512,
        height: 512,
      },
      foundingDate: '2024',
      founder: {
        '@type': 'Person',
        name: 'Martin Rodriguez',
        url: 'https://hacecuentas.com/sobre-nosotros',
      },
      description: 'Plataforma argentina de calculadoras online gratuitas en español, inglés y portugués. Foco específico en Argentina (ARCA, ANSES, BCRA, INDEC) y cobertura global hispanohablante, Brasil y Estados Unidos.',
      areaServed: [
        { '@type': 'Country', name: 'Argentina' },
        { '@type': 'Country', name: 'México' },
        { '@type': 'Country', name: 'España' },
        { '@type': 'Country', name: 'Chile' },
        { '@type': 'Country', name: 'Colombia' },
        { '@type': 'Country', name: 'Brasil' },
      ],
      knowsLanguage: ['es', 'en', 'pt'],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        email: 'contacto@hacecuentas.com',
        availableLanguage: ['Spanish', 'English', 'Portuguese'],
      },
      sameAs: [
        'https://x.com/Hacecuentas',
        'https://www.instagram.com/hacecuentas',
        'https://www.linkedin.com/company/122324467/',
        'https://www.facebook.com/profile.php?id=61590473465354',
        'https://www.wikidata.org/wiki/Q139824747',
        'https://hacecuentas.com/sobre-nosotros',
      ],
    },
  ],
  publisher: { '@id': 'https://hacecuentas.com/#organization' },
};
---

<Layout
  title="Hacé Cuentas — Calculadoras online gratuitas en español"
  description="Calculadoras gratis en español: sueldo neto Argentina, monotributo, aguinaldo, IMC, préstamos, interés compuesto. Fórmulas oficiales 2026 paso a paso."
  image="/og/index.png"
  audience="AR"
  schema={schema}
  hreflang={HOME_HREFLANG}
>
  <Header slot="header" />

  <section class="hero">
    <div class="trust-row">
      <span class="trust-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        Fórmulas oficiales
      </span>
      <span class="trust-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        Actualizado 2026
      </span>
      <span class="trust-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        Sin registro
      </span>
    </div>

    <p class="hero-kicker">Tu vida más fácil.</p>
    <h1 class="hero-title">
      Más de <span class="accent">{heroCalcsDisplay} calculadoras gratis</span>, listas al instante
    </h1>
    <p class="hero-lead">
      Sueldo, aguinaldo, IMC, dólar y todo lo que necesites sacar: en español, con <strong>fórmulas oficiales</strong> y sin vueltas.
    </p>
    <button type="button" class="hero-search" id="hero-search-btn" aria-label={`Buscar entre ${calcs.length.toLocaleString('es-AR')} calculadoras`}>
      <svg class="hs-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <span class="hs-placeholder" id="hs-placeholder">Buscar entre {calcs.length.toLocaleString('es-AR')} calculadoras…</span>
      <kbd class="hs-kbd">⌘K</kbd>
    </button>
    <div class="hero-pop" aria-label="Búsquedas populares">
      <span class="hero-pop-label">Populares:</span>
      <a href="/fixture-mundial-2026" class="hero-pop-chip">⚽ Mundial 2026</a>
      <a href="/buscar?q=aguinaldo" class="hero-pop-chip">Aguinaldo</a>
      <a href="/buscar?q=sueldo%20en%20mano" class="hero-pop-chip">Sueldo en mano</a>
      <a href="/buscar?q=imc" class="hero-pop-chip">IMC</a>
      <a href="/buscar?q=dolar" class="hero-pop-chip">Dólar</a>
      <a href="/buscar?q=interes%20compuesto" class="hero-pop-chip">Interés compuesto</a>
      <a href="/buscar?q=embarazo" class="hero-pop-chip">Embarazo</a>
    </div>

    <!-- Tus calculadoras (favoritos) — client-side desde localStorage 'hc_favs'
         (contrato compartido: {s, t, l, d}, cap 50 FIFO). Oculta server-side
         (display:none) → cero layout shift si no hay favoritos o falla storage.
         El script de render vive abajo junto a los otros is:inline del home. -->
    <section class="fav-strip" id="fav-strip" style="display:none" aria-labelledby="fav-strip-title">
      <h2 class="fav-strip-title" id="fav-strip-title">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Tus calculadoras
      </h2>
      <div class="fav-strip-grid" id="fav-strip-grid"></div>
    </section>

    <!-- Quick Actions: tiles de las 3 verticales que concentran el 70% del tráfico según GA.
         Reduce el bounce del hero (5s → objetivo 30s+) dando opciones inmediatas. -->
    <div class="hero-quick-actions" aria-label="Herramientas destacadas">
      <a href="/tracker-embarazo-semana-a-semana" class="qa-tile qa-tile-pink">
        <span class="qa-icon" aria-hidden="true"><CategoryIcon cat="baby" fallback="🤰" size={30} /></span>
        <span class="qa-body">
          <span class="qa-title">Embarazo y bebé</span>
          <span class="qa-desc">Tracker semanal, fecha parto, peso bebé</span>
        </span>
        <span class="qa-arrow" aria-hidden="true">→</span>
      </a>
      <a href="/valores-bcra" class="qa-tile qa-tile-green">
        <span class="qa-icon" aria-hidden="true"><CategoryIcon cat="finanzas" fallback="💵" size={30} /></span>
        <span class="qa-body">
          <span class="qa-title">Dólar y economía AR</span>
          <span class="qa-desc">Cotización, inflación, plazo fijo</span>
        </span>
        <span class="qa-arrow" aria-hidden="true">→</span>
      </a>
      <a href="/calculadora-feriados-argentina-2026-calendario" class="qa-tile qa-tile-blue">
        <span class="qa-icon" aria-hidden="true"><CategoryIcon cat="vida" fallback="📅" size={30} /></span>
        <span class="qa-body">
          <span class="qa-title">Feriados 2026</span>
          <span class="qa-desc" id="proxi-feriado">Próximo feriado: cargando…</span>
        </span>
        <span class="qa-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="hero-country-picker" aria-label="Elegí tu país o región">
      <span class="hcp-label">¿De qué país sos?</span>
      <a href="/" class="hcp-pill hcp-current" title="Estás aquí">🇦🇷 Argentina</a>
      <a href="/global" class="hcp-pill">🌎 Global</a>
      <a href="/es" class="hcp-pill">🇪🇸 España</a>
      <a href="/mx" class="hcp-pill">🇲🇽 México</a>
      <a href="/co" class="hcp-pill">🇨🇴 Colombia</a>
      <a href="/cl" class="hcp-pill">🇨🇱 Chile</a>
      <a href="/pe" class="hcp-pill">🇵🇪 Perú</a>
      <a href="/ec" class="hcp-pill">🇪🇨 Ecuador</a>
      <a href="/pt" class="hcp-pill">🇧🇷 Brasil</a>
      <a href="/en" class="hcp-pill">🇺🇸 English</a>
    </div>

    <div class="hero-meta-row">
      <span class="hero-stat"><strong>{calcs.length.toLocaleString('es-AR')}</strong> calculadoras</span>
      <span class="hero-dot" aria-hidden="true">·</span>
      <span class="hero-stat"><strong>{categoryOrder.length}</strong> categorías</span>
      <span class="hero-dot" aria-hidden="true">·</span>
      <span class="hero-stat"><strong data-live-counter="true" data-initial={totalResults}>{totalResults.toLocaleString('es-AR')}</strong> cálculos hechos</span>
      <span class="hero-dot" aria-hidden="true">·</span>
      <a href="/valores-bcra" class="hero-live"><span class="dot-live"></span>Valores BCRA hoy</a>
    </div>

    <div class="sources">
      <span class="sources-label">Basado en fuentes oficiales:</span>
      <span class="source-chip">OMS</span>
      <span class="source-chip">ACOG</span>
      <span class="source-chip">Mifflin-St Jeor</span>
      <span class="source-chip">NSCA</span>
      <span class="source-chip">AFIP/ARCA 🇦🇷</span>
    </div>
  </section>

  {/* Bloque estacional Mundial 2026 (11 jun – 19 jul 2026) — surfacea el cluster
      en la página de más autoridad mientras dura el torneo. */}
  <section class="seasonal-mundial" aria-labelledby="mundial-seasonal-h">
    <div class="sm-inner">
      <div class="sm-head">
        <span class="sm-badge">⚽ Mundial 2026 · En vivo</span>
        <h2 id="mundial-seasonal-h">Seguí el Mundial y calculá las chances de tu selección</h2>
        <p>
          Fixture de los <strong>104 partidos</strong> con resultados día a día en
          <strong>hora argentina</strong>, más 34 calculadoras: probabilidades, puntos para octavos,
          prode y mucho más.
        </p>
      </div>
      <div class="sm-links">
        <a href="/fixture-mundial-2026" class="sm-cta sm-cta-primary">📅 Fixture y resultados</a>
        <a href="/partidos-hoy-mundial-2026" class="sm-cta">📍 Partidos de hoy</a>
        <a href="/posiciones-mundial-2026" class="sm-cta">📊 Tabla de posiciones</a>
        <a href="/mundial-2026" class="sm-cta">🏆 Todas las calculadoras</a>
        <a href="/calculadora-mundial-2026-predictor-campeon-ranking" class="sm-cta">🔮 Predictor de campeón</a>
        <a href="/calculadora-mundial-2026-quiniela-pool-probabilidad" class="sm-cta">🎯 Prode con amigos</a>
      </div>
    </div>
  </section>

  <section class="categorias" aria-labelledby="categorias-heading">
    <div class="section-header">
      <div>
        <span class="eyebrow eyebrow-inline">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
          </svg>
          Explorá por categoría
        </span>
        <h2 id="categorias-heading">Todas las categorías</h2>
      </div>
      <a href="/calculadoras" class="see-all">Ver todas →</a>
    </div>
    {/* Destacadas: las más usadas en AR, con sus calcs estrella */}
    <div class="row-label"><span class="row-star" aria-hidden="true">★</span>Las más usadas<span class="row-line"></span></div>
    <div class="feat-grid">
      {featuredCats.filter(cat => byCategory[cat]?.length).map((cat) => {
        const meta = categoryMeta[cat];
        const top = getTopCalcs(cat);
        const count = byCategory[cat].length;
        return (
          <div class="feat-card" style={`--cat-color: ${meta.color}`}>
            <a href={`/categoria/${cat}`} class="feat-head">
              <div class="feat-icon" aria-hidden="true"><CategoryIcon cat={cat} fallback={meta.icon} size={24} /></div>
              <div class="feat-titles">
                <div class="feat-name">{meta.label}</div>
                <div class="feat-count">{count} calculadoras</div>
              </div>
            </a>
            <ul class="feat-list">
              {top.map((c: any) => (
                <li>
                  <a href={`/${c.slug}`} class="feat-item">
                    <span class="feat-dot" aria-hidden="true"></span>
                    <span class="feat-item-name">
                      {c.h1}
                      {c.audience === 'AR' && (
                        <span class="ar-badge" title="Específica para Argentina" aria-label="Específica para Argentina">🇦🇷</span>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a href={`/categoria/${cat}`} class="feat-all">Ver las {count} →</a>
          </div>
        );
      })}
    </div>

    {/* El resto del catálogo, en mosaico compacto y escaneable */}
    <div class="row-label">Todas las demás<span class="row-line"></span></div>
    <div class="cat-mosaic">
      {mosaicCats.filter(cat => byCategory[cat]?.length).map((cat) => {
        const meta = categoryMeta[cat];
        const count = byCategory[cat].length;
        const isNew = newlyAddedCats.has(cat);
        return (
          <a href={`/categoria/${cat}`} class="cat-tile" style={`--cat-color: ${meta.color}`}>
            {isNew && <span class="tile-new">Nuevo</span>}
            <div class="tile-icon" aria-hidden="true"><CategoryIcon cat={cat} fallback={meta.icon} size={20} /></div>
            <div class="tile-meta">
              <div class="tile-name">{meta.label}</div>
              <div class="tile-count">{count} calcs</div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="destacados" aria-labelledby="destacados-heading">
    <div class="section-header">
      <div>
        <span class="eyebrow eyebrow-inline">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          Herramientas destacadas
        </span>
        <h2 id="destacados-heading">Lo nuevo en Hacé Cuentas</h2>
      </div>
    </div>
    <div class="destacados-grid">
      <a href="/valores-bcra" class="feature-card feature-bcra">
        <div class="feature-badge">Nuevo</div>
        <div class="feature-icon">🏦</div>
        <h3>Valores BCRA hoy</h3>
        <p>Dólar oficial, blue, MEP y CCL. Inflación, UVA y TNA de los principales bancos — actualizados al último cierre.</p>
        <span class="feature-cta">Ver dashboard →</span>
      </a>
      <a href="/comparador-plazo-fijo" class="feature-card feature-pf">
        <div class="feature-badge">Nuevo</div>
        <div class="feature-icon">📊</div>
        <h3>Comparador de plazo fijo</h3>
        <p>Galicia, Santander, BBVA, Macro, Nación, Provincia e ICBC lado a lado. Ingresá capital y días, ves el ganador.</p>
        <span class="feature-cta">Comparar bancos →</span>
      </a>
      <a href="/buscar?q=conversor" class="feature-card feature-conv">
        <div class="feature-badge">Nuevo</div>
        <div class="feature-icon">📐</div>
        <h3>100 conversores nuevos</h3>
        <p>Pies a metros, Celsius a Fahrenheit, libras a kilos, galones a litros y 96 más. Factores exactos y ejemplos reales.</p>
        <span class="feature-cta">Ver todos los conversores →</span>
      </a>
      <a href="/calculadora-cientifica" class="feature-card feature-sci">
        <div class="feature-badge">Nuevo</div>
        <div class="feature-icon">🧮</div>
        <h3>Calculadora científica</h3>
        <p>Seno, coseno, tangente, logaritmos, raíces, potencias, factorial, π y e. Modo grados/radianes y teclado.</p>
        <span class="feature-cta">Abrir calculadora →</span>
      </a>
    </div>
  </section>

  <section class="para-vos" id="para-vos-section" aria-labelledby="para-vos-heading">
    <div class="section-header">
      <div>
        <span class="eyebrow eyebrow-inline">
          <span id="pv-flag" aria-hidden="true">🇦🇷</span>
          Para vos
        </span>
        <h2 id="para-vos-heading">Calculadoras para <span id="pv-country-name">Argentina</span></h2>
      </div>
    </div>
    <div class="pv-grid" id="pv-grid">
      {countryCalcData.AR.map((c) => (
        <a href={`/${c.slug}`} class="pv-card">
          <span class="pv-icon" aria-hidden="true">{c.icon}</span>
          <span class="pv-title">{c.h1}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="populares" aria-labelledby="populares-heading">
    <div class="section-header">
      <div>
        <span class="eyebrow eyebrow-inline">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/>
          </svg>
          Más populares
        </span>
        <h2 id="populares-heading">Las más buscadas en Argentina</h2>
      </div>
      <a href="/populares" class="see-all">Ver todas →</a>
    </div>
    <div class="populares-grid">
      {popular.map((c: any, i: number) => (
        <a href={`/${c.slug}`} class="pop-card">
          <span class={`pop-rank ${i < 3 ? 'pop-rank-' + (i + 1) : ''}`}>{i < 3 ? ['🥇','🥈','🥉'][i] : i + 1}</span>
          <span class="pop-icon" aria-hidden="true">{c.icon}</span>
          <div class="pop-body">
            <div class="pop-title">
              {c.h1}
              {c.audience === 'AR' && (
                <span class="ar-badge" title="Específica para Argentina" aria-label="Específica para Argentina">🇦🇷</span>
              )}
            </div>
            <div class="pop-cat">{categoryMeta[c.category]?.label || c.category}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="pilares" aria-labelledby="pilares-heading">
    <div class="section-header">
      <div>
        <span class="eyebrow eyebrow-inline">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5v-15a2.5 2.5 0 0 1 2.5-2.5H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
          </svg>
          Guías completas
        </span>
        <h2 id="pilares-heading">Guías para entender el tema</h2>
      </div>
      <a href="/guias" class="see-all">Ver todas →</a>
    </div>
    <div class="pilares-grid">
      <a href="/guia/finanzas-personales" class="pilar-card"><span class="pilar-icon">💰</span><div><strong>Finanzas personales</strong><span>Ahorro, inversiones y presupuesto</span></div></a>
      <a href="/guia/sueldos-argentina-2026" class="pilar-card"><span class="pilar-icon">💼</span><div><strong>Sueldos Argentina 2026</strong><span>Bruto, neto, aguinaldo, indemnización</span></div></a>
      <a href="/guia/impuestos-argentina-2026" class="pilar-card"><span class="pilar-icon">🧾</span><div><strong>Impuestos Argentina 2026</strong><span>Ganancias, IVA, IIBB, Monotributo</span></div></a>
      <a href="/guia/subsidios-anses-2026" class="pilar-card"><span class="pilar-icon">🏛️</span><div><strong>Subsidios ANSES 2026</strong><span>AUH, jubilación, asignaciones</span></div></a>
      <a href="/guia/salud-nutricion-fitness" class="pilar-card"><span class="pilar-icon">🩺</span><div><strong>Salud, nutrición y fitness</strong><span>IMC, calorías, TDEE, entrenamiento</span></div></a>
      <a href="/guia/embarazo-y-bebe" class="pilar-card"><span class="pilar-icon">👶</span><div><strong>Embarazo y bebé</strong><span>Semanas, fecha de parto, crecimiento</span></div></a>
      <a href="/guia/productividad-aprendizaje" class="pilar-card"><span class="pilar-icon">📚</span><div><strong>Productividad y aprendizaje</strong><span>Técnicas, idiomas, tiempo de estudio</span></div></a>
      <a href="/guia/matematicas-ciencias" class="pilar-card"><span class="pilar-icon">➗</span><div><strong>Matemáticas y ciencias</strong><span>Álgebra, geometría, física</span></div></a>
