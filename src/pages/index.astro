  }
  .feature-pf::after {
    background: linear-gradient(
      105deg,
      transparent 35%,
      color-mix(in srgb, var(--success) 22%, transparent) 50%,
      transparent 65%
    );
    background-size: 250% 100%;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 200% center; }
    50% { background-position: -200% center; }
  }

  .feature-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.1875rem 0.5rem;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    z-index: 1;
  }
  .feature-pf .feature-badge { background: var(--success); }

  .feature-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1;
  }
  .feature-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .feature-card p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .feature-cta {
    display: inline-flex;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .feature-pf .feature-cta { color: var(--success); }

  /* [4.5] Para vos — country-specific section */
  .para-vos {
    margin: 2rem 0 2.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.06), rgba(168, 85, 247, 0.04));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
    border-radius: var(--radius-lg);
  }
  .para-vos .section-header { margin-bottom: 1rem; }
  .para-vos .eyebrow { gap: 0.5rem; }

  .pv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.625rem;
  }

  .pv-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .pv-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }

  .pv-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
  }

  .pv-title {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .para-vos { padding: 1rem 1.125rem 1.25rem; }
  }

  /* [5] Populares with medal rankings */
  /* content-visibility: auto le dice al browser que NO haga render layout/style
     de estas secciones hasta que estén cerca del viewport. Reduce Style & Layout
     drásticamente (PageSpeed reportaba 2141ms). contain-intrinsic-size reserva
     espacio aproximado para evitar layout shift. */
  .populares, .pilares, .categorias, .final-cta {
    content-visibility: auto;
    contain-intrinsic-size: 1px 800px;
  }

  .populares {
    margin: 2rem 0 3rem;
  }
  .populares-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
  }

  .pop-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.125rem 1rem 2.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.2s ease-out,
                border-color 0.2s ease-out,
                background 0.2s ease-out;
    will-change: transform;
  }

  .pop-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px) scale(1.015);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    background: linear-gradient(180deg, var(--bg-card), color-mix(in srgb, var(--accent-soft) 30%, var(--bg-card)));
  }
  .pop-card:active {
    transform: translateY(-1px) scale(1);
    transition-duration: 0.05s;
  }
  .pop-card:hover .pop-icon {
    transform: rotate(-4deg) scale(1.08);
  }
  .pop-card .pop-icon {
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .pop-rank {
    position: absolute;
    left: 0.625rem;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 700;
  }
  /* Medal ranks — emoji replaces number, no bg circle */
  .pop-rank-1, .pop-rank-2, .pop-rank-3 {
    background: none;
    font-size: 1.125rem;
    width: 26px;
    height: 26px;
  }

  .pop-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
  }

  .pop-body { flex: 1; min-width: 0; }
  .pop-title {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
    margin-bottom: 0.125rem;
  }
  .ar-badge {
    margin-left: 0.35em;
    font-size: 0.85em;
    vertical-align: middle;
    line-height: 1;
    display: inline-block;
  }
  .pop-cat {
    font-size: 0.75rem;
    color: var(--text-subtle);
    font-weight: 500;
  }

  /* Quick Actions: 3 tiles grandes de verticales top (data-driven de GA) */
  .hero-quick-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    max-width: 820px;
    margin: 1.25rem auto 1.5rem;
  }
  .qa-tile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.125rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.2s ease-out,
                border-color 0.2s ease-out;
    text-align: left;
  }
  /* OJO con :hover. Antes el tile tenía scale(1.02) → el texto se veía empañado
     ("pelado") porque cualquier transform: scale() en un contenedor rompe el
     sub-pixel font rendering del browser (la capa entera se rasteriza una vez
     y se escala vectorialmente, perdiendo el LCD smoothing). Fix: lift puro
     con translateY + shadow + border highlight, sin scale a nivel tile.
     El icon (emoji) sí mantiene scale porque un glifo de 32px no acusa blur. */
  .qa-tile:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }
  .qa-tile:active { transform: translateY(-1px); transition-duration: 0.05s; }
  .qa-tile-pink:hover { border-color: #ec4899; }
  .qa-tile-green:hover { border-color: #10b981; }
  .qa-tile-blue:hover { border-color: #3b82f6; }
  .qa-tile:hover .qa-arrow { transform: translateX(4px); }
  .qa-tile:hover .qa-icon { transform: scale(1.15) rotate(-5deg); }
  .qa-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
    display: inline-flex;
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
  }
  .qa-tile-pink .qa-icon { color: #ec4899; }
  .qa-tile-green .qa-icon { color: #10b981; }
  .qa-tile-blue .qa-icon { color: #3b82f6; }
  .qa-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  .qa-title { font-weight: 700; font-size: 0.9375rem; color: var(--text); }
  .qa-desc { font-size: 0.75rem; color: var(--text-muted); line-height: 1.3; }
  .qa-arrow { color: var(--text-muted); font-weight: 700; font-size: 1.125rem; transition: transform 0.2s ease-out; }
  @media (max-width: 640px) {
    .hero-quick-actions { grid-template-columns: 1fr; gap: 0.5rem; }
    .qa-tile { padding: 0.875rem 1rem; }
    .qa-icon { font-size: 1.75rem; }
  }

  /* [5b] Pilares / guías — mostradas encima de categorías */
  .pilares { margin: 2rem 0 3rem; }
  .pilares-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.6rem;
  }
  .pilar-card {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.2s ease-out,
                border-color 0.2s ease-out;
    will-change: transform;
  }
  .pilar-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px) scale(1.015);
    box-shadow: var(--shadow-md);
  }
  .pilar-card:active { transform: translateY(-1px) scale(1); transition-duration: 0.05s; }
  .pilar-card:hover .pilar-icon {
    transform: scale(1.15) rotate(-5deg);
  }
  .pilar-icon {
    font-size: 1.5rem; flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .pilar-card > div { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .pilar-card strong { font-size: 0.95rem; color: var(--text); font-weight: 700; line-height: 1.25; }
  .pilar-card span:last-child { font-size: 0.8125rem; color: var(--text-subtle); line-height: 1.4; }

  /* [6] Categorías — top-border gradient instead of left border */
  .categorias { margin: 2rem 0 3rem; }

  /* Rótulo de fila ("Las más usadas" / "Todas las demás") — da jerarquía
     editorial sin tapar nada (reemplaza el badge TOP que iba sobre las cards). */
  .row-label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    margin: 0.25rem 0 0.85rem;
  }
  .row-label .row-star { color: #d97706; }
  .row-label .row-line { height: 1px; background: var(--border); flex: 1; }
  .feat-grid + .row-label { margin-top: 1.75rem; }

  /* ---- Destacadas: 4 cards ricas con sus calcs estrella ---- */
  .feat-grid {
    display: grid;
    /* auto-fit con sólo 4 items → 4 cols en desktop, colapsa solo en pantallas
       chicas sin necesidad de media queries extra. */
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }
  .feat-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.05rem 0.95rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.2s ease-out, border-color 0.2s ease-out;
    will-change: transform;
  }
  /* Franja superior sólida en el color de la categoría (nítida, sin degradado). */
  .feat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--cat-color, var(--accent));
  }
  .feat-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--cat-color, var(--accent)) 50%, var(--border));
  }
  .feat-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.8rem;
    text-decoration: none;
    color: var(--text);
  }
  .feat-head:hover { text-decoration: none; }
  .feat-head:hover .feat-name { color: var(--cat-color); }
  .feat-icon {
    width: 44px; height: 44px;
    flex-shrink: 0;
    border-radius: 11px;
    background: color-mix(in srgb, var(--cat-color) 14%, transparent);
    color: var(--cat-color);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.35rem;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .feat-card:hover .feat-icon { transform: scale(1.08) rotate(-3deg); }
  .feat-titles { min-width: 0; }
  .feat-name {
    font-weight: 800;
    font-size: 1.02rem;
    line-height: 1.15;
    transition: color 0.15s;
  }
  .feat-count {
    font-size: 0.74rem;
    color: var(--text-subtle);
    font-weight: 600;
    margin-top: 0.15rem;
  }
  .feat-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .feat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    transition: border-color 0.12s, color 0.12s;
  }
  .feat-item:hover {
    color: var(--text);
    text-decoration: none;
    border-color: color-mix(in srgb, var(--cat-color) 45%, var(--border));
  }
  .feat-dot {
    width: 6px; height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--cat-color, var(--accent));
  }
  .feat-item-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    line-height: 1.3;
  }
  .feat-all {
    margin-top: 0.75rem;
    align-self: flex-start;
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--cat-color, var(--accent));
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .feat-all:hover { text-decoration: underline; }

  /* ---- Mosaico compacto: el resto del catálogo, escaneable ---- */
  .cat-mosaic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.7rem;
  }
  .cat-tile {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 62px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--cat-color, var(--accent));
    border-radius: 11px;
    padding: 0.7rem 0.75rem;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s ease-out, box-shadow 0.15s ease-out, border-color 0.15s;
  }
  .cat-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    border-color: color-mix(in srgb, var(--cat-color) 55%, var(--border));
    border-left-color: var(--cat-color);
  }
  .tile-icon {
    width: 34px; height: 34px;
    flex-shrink: 0;
    border-radius: 8px;
    background: color-mix(in srgb, var(--cat-color) 13%, transparent);
    color: var(--cat-color);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.05rem;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cat-tile:hover .tile-icon { transform: scale(1.1); }
  .tile-meta { min-width: 0; }
  .tile-name { font-weight: 700; font-size: 0.84rem; line-height: 1.15; }
  .tile-count {
    font-size: 0.7rem;
    color: var(--text-subtle);
    font-weight: 600;
    margin-top: 0.15rem;
  }
  /* Badge "Nuevo" anclado a la esquina; el overflow:hidden del tile evita
     que se salga del encuadre aunque el nombre sea largo. */
  .tile-new {
    position: absolute;
    top: 6px; right: 7px;
    font-size: 0.52rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #15803d;
    background: #dcfce7;
    border-radius: 5px;
    padding: 2px 5px;
    line-height: 1;
  }

  /* [7] Stats with icons */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 3rem 0;
    padding: 1.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .stat { text-align: center; }
  .stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
    margin: 0 auto 0.625rem;
  }
  .stat-icon-green { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
  .stat-icon-flag { background: rgba(96, 165, 250, 0.1); color: #60a5fa; }
  .stat-num {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.25rem;
  }
  .stat-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* [9] Why — each icon has its own color */
  .why {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }
  .why h2 {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 1.75rem;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .why-item {
    padding: 1.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .why-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--why-soft, var(--accent-soft));
    color: var(--why-color, var(--accent));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .why-item h3 { margin-bottom: 0.5rem; font-size: 1rem; }
  .why-item p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Final CTA */
  .final-cta {
    margin: 4rem 0 2rem;
    padding: 2.5rem 2rem;
    text-align: center;
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
  }
  .final-cta h3 {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
    color: var(--accent-strong);
  }
  .final-cta p {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .cta-actions {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  /* Secciones editoriales — rediseño v3 con cards explícitos + icon grande.
     Cada sección es un container visual claro (no más muros de texto). */
  .editorial-intro,
  .editorial-method,
  .editorial-faq {
    margin: 4rem auto;
    max-width: 1100px;
    background: var(--bg-card, #fff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 24px;
    padding: 3rem 2.75rem;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 8px 24px -8px rgba(15, 23, 42, 0.08);
    position: relative;
    overflow: hidden;
  }
  /* Banda gradient top */
  .editorial-intro::before,
  .editorial-method::before,
  .editorial-faq::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 50%, #7c3aed));
  }
  html[data-theme="dark"] .editorial-intro,
  html[data-theme="dark"] .editorial-method,
  html[data-theme="dark"] .editorial-faq {
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 8px 24px -8px rgba(0, 0, 0, 0.5);
  }

  .editorial-wrap {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* Header: icon grande + eyebrow + título */
  .editorial-intro h2,
  .editorial-method h2,
  .editorial-faq h2 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 1.5rem;
    color: var(--text);
    position: relative;
    padding-top: 4.5rem;
  }
  /* Eyebrow */
  .editorial-intro h2::before,
  .editorial-method h2::before,
  .editorial-faq h2::before {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
