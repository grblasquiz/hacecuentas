      radial-gradient(ellipse 80% 60% at 20% 22%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 30%, rgba(14, 165, 233, 0.06), transparent 55%),
      radial-gradient(ellipse 50% 40% at 50% 90%, rgba(168, 85, 247, 0.05), transparent 50%);
    /* El tinte se recortaba plano contra el borde superior del hero (overflow:hidden)
       → línea dura "cortante". Un mask vertical lo hace aparecer con un fundido
       desde arriba y desvanecerse hacia abajo, sin bordes secos. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 22%, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 22%, #000 80%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }
  .hero > * { position: relative; z-index: 1; }
  /* El buscador del hero abre un dropdown absoluto que debe solaparse sobre las
     bandas de abajo (fav-strip, country-picker, meta-row). Como todos los hijos
     de .hero comparten z-index:1, el orden del DOM haría que esas bandas pinten
     encima del dropdown. Subimos hero-grid por encima de ellas. */
  .hero > .hero-grid { z-index: 2; }

  /* Hero asimétrico: izquierda intención + buscador, derecha panel "Hoy". */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.45fr 0.85fr;
    gap: 2.5rem;
    align-items: start;
    max-width: 1080px;
    margin: 0 auto 1.5rem;
    text-align: left;
  }
  .hero-grid .hero-title { margin-left: 0; margin-right: 0; text-align: left; }
  .hero-grid .hero-lead { margin-left: 0; }
  .hero-grid .hero-search--secondary { margin-left: 0; margin-right: 0; }
  .hero-main > :where(.search-shell, .pi-shell, form) { margin-left: 0; }

  .hero-intents {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    margin-top: 1.1rem;
  }
  .hero-intents-label { color: var(--text-subtle); font-size: 0.8125rem; font-weight: 700; }
  .hero-intent-chip {
    display: inline-flex; align-items: center;
    padding: 0.34rem 0.8rem; border-radius: 999px;
    background: var(--bg-card); border: 1px solid var(--border);
    font-size: 0.8125rem; font-weight: 600; color: var(--text-muted); text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .hero-intent-chip:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

  /* Panel "Hoy en Argentina" — Surface 3: tinte de marca, no card neutra. */
  .hoy-panel {
    align-self: stretch;
    padding: 1.25rem 1.35rem 1.1rem;
    border-radius: 18px;
    background: linear-gradient(165deg, color-mix(in srgb, var(--accent) 10%, var(--bg-card)), var(--bg-card) 75%);
    border: 1px solid color-mix(in srgb, var(--accent) 26%, var(--border));
    box-shadow: var(--shadow-md);
  }
  .hoy-head {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent-strong); margin-bottom: 0.9rem;
  }
  .hoy-list { list-style: none; margin: 0 0 0.9rem; padding: 0; display: flex; flex-direction: column; }
  .hoy-list li {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;
    padding: 0.55rem 0; border-bottom: 1px solid color-mix(in srgb, var(--accent) 12%, var(--border));
  }
  .hoy-list li:last-child { border-bottom: 0; }
  .hoy-lbl { color: var(--text-muted); font-size: 0.8125rem; font-weight: 600; }
  .hoy-val {
    font-family: var(--font-num, var(--font-mono)); font-variant-numeric: tabular-nums;
    font-weight: 700; font-size: 0.95rem; color: var(--text); white-space: nowrap;
  }
  .hoy-more {
    display: inline-flex; align-items: center; font-size: 0.8125rem; font-weight: 700;
    color: var(--accent); text-decoration: none;
  }
  .hoy-more:hover { text-decoration: underline; }

  /* Resultados guardados (hc_saved) — card vertical: título + valor en mono. */
  .saved-strip { max-width: 640px; margin: 0 auto 1.75rem; }
  .saved-card { flex-direction: column; align-items: flex-start; gap: 0.15rem; padding: 0.6rem 0.75rem; text-decoration: none; }
  .saved-card:hover { border-color: var(--accent); }
  .saved-card-t { font-size: 0.78rem; font-weight: 600; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .saved-card-v { font-family: var(--font-num, var(--font-mono)); font-variant-numeric: tabular-nums; font-weight: 700; font-size: 0.95rem; color: var(--accent-strong); }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; gap: 1.5rem; text-align: center; }
    .hero-grid .hero-title, .hero-grid .hero-lead { margin-left: auto; margin-right: auto; text-align: center; }
    /* Layout de 1 columna centrado: el buscador (.hsx, scoped en HeroSearch) y el
       toggle del asistente también van centrados, si no quedan pegados a la izq. */
    .hero-grid :global(.hsx) { margin-left: auto; margin-right: auto; }
    .hero-grid .hero-assistant { margin-left: auto; margin-right: auto; }
    .hero-grid .hero-assistant-summary { justify-content: center; }
    .hero-intents { justify-content: center; }
    .hoy-panel { text-align: left; max-width: 460px; margin: 0 auto; width: 100%; }
  }

  /* Caminos principales (4) — una puerta clara por intención. */
  .caminos { max-width: 1080px; margin: 0 auto 3.25rem; }
  .caminos-head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .caminos-eyebrow {
    display: block; margin-bottom: 0.35rem; color: var(--accent-strong);
    font-size: 0.7rem; font-weight: 850; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .caminos-head h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -0.045em; }
  .caminos-all { color: var(--accent); font-size: 0.8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .caminos-all:hover { text-decoration: underline; }
  .caminos-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; }
  .camino {
    display: flex; flex-direction: column; gap: 0.35rem; min-height: 182px;
    padding: 1.25rem; border-radius: 18px; text-decoration: none; color: var(--text);
    border: 1px solid var(--border); background: var(--bg-card);
    box-shadow: 0 8px 25px color-mix(in srgb, var(--text) 5%, transparent);
    transition: transform 0.16s, box-shadow 0.16s, border-color 0.16s;
  }
  .camino:hover { transform: translateY(-3px); border-color: var(--c-ac); box-shadow: 0 10px 26px -8px color-mix(in srgb, var(--c-ac) 30%, transparent); }
  .camino-ic { width: 42px; height: 42px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--c-ac) 10%, var(--bg-card)); color: var(--c-ac); margin-bottom: 0.55rem; }
  .camino-t { font-size: 1.05rem; font-weight: 800; letter-spacing: -0.02em; }
  .camino-d { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.4; }
  .camino-go { margin-top: auto; padding-top: 0.75rem; font-size: 0.8rem; font-weight: 800; color: var(--c-ac); }
  .camino-primary { color: #fff; border-color: transparent; background: #101a36; box-shadow: 0 14px 34px rgba(16,26,54,0.17); }
  .camino-primary .camino-ic { color: #101a36; background: var(--c-ac); }
  .camino-primary .camino-d { color: rgba(255,255,255,0.64); }
  .camino-primary .camino-go { color: var(--c-ac); }
  @media (max-width: 760px) { .caminos-grid { grid-template-columns: 1fr 1fr; } }

  /* Mobile (#5): los destacados pasan a CARRUSEL horizontal con snap, no a una
     pila infinita. Aplica a caminos, productos y "lo nuevo" (feature cards). */
  @media (max-width: 640px) {
    .caminos-head { align-items: flex-start; }
    .caminos-all { margin-top: 1.3rem; }
    .caminos-grid, .destacados-grid {
      display: grid; grid-auto-flow: column; grid-template-columns: none;
      grid-auto-columns: 78%; gap: 0.75rem;
      overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
      scrollbar-width: none; margin: 0 -1rem; padding: 0 1rem 0.5rem;
    }
    .caminos-grid::-webkit-scrollbar, .destacados-grid::-webkit-scrollbar { display: none; }
    .caminos-grid > *, .destacados-grid > * { scroll-snap-align: start; }
  }

  /* Motion = causalidad, no decoración: calmamos rotaciones de íconos en hover
     (quedan los lifts/translate, que sí comunican estado). */
  .feat-card:hover .feat-icon { transform: scale(1.04); }
  @media (hover: none) {
    .pop-card:hover, .pilar-card:hover, .feat-card:hover, .camino:hover { transform: none; box-shadow: none; }
  }

  .trust-row {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.75rem;
    background: var(--success-soft);
    color: var(--success);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  /* Kicker (ex-H1 "Tu vida más fácil."): eyebrow corto arriba del H1. */
  .hero-kicker {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }

  /* H1 más largo que el viejo "Tu vida más fácil." → tope un toque menor,
     max-width para que wrapee en 2 líneas prolijas y balance para mobile. */
  .hero-title {
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0 auto 1.25rem;
    max-width: 900px;
    font-weight: 800;
    text-wrap: balance;
  }

  .hero-title .accent {
    background: linear-gradient(135deg, var(--accent), #0ea5e9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-lead {
    font-size: 1.0625rem;
    max-width: 620px;
    margin: 0 auto 1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .hero-country-picker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    max-width: 720px;
    margin: 1.75rem auto 1.25rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
  }
  .hcp-label {
    color: var(--text-muted);
    font-weight: 500;
    margin-right: 0.25rem;
  }
  .hcp-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3125rem 0.625rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-muted);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .hcp-pill:hover { border-color: var(--accent); color: var(--accent); }
  .hcp-pill.hcp-current {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
    cursor: default;
  }
  /* Mobile: en vez de wrappear en 3 líneas, scroll horizontal con snap. (#17) */
  @media (max-width: 600px) {
    .hero-country-picker {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      max-width: none;
    }
    .hero-country-picker::-webkit-scrollbar { display: none; }
    .hcp-label { flex-shrink: 0; }
    .hcp-pill { flex-shrink: 0; scroll-snap-align: start; }
  }

  .hero-ctas {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin-bottom: 2rem;
  }

  /* Hero search input — protagonista del home */
  .hero-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 600px;
    margin: 0 auto 0.875rem;
    padding: 1.0625rem 1.25rem;
    background: var(--bg-card);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s, background-color 0.18s, color 0.18s;
    font-family: inherit;
    text-align: left;
  }
  .hero-search:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-1px);
  }
  .hs-icon { color: var(--accent); flex-shrink: 0; }
  .hs-placeholder {
    flex: 1;
    color: var(--text-subtle);
    font-size: 1.0625rem;
    font-weight: 400;
    transition: opacity 0.2s;
  }

  /* Buscador por nombre demoteado a secundario: el intérprete es la entrada
     primaria. Más chico, sin sombra fuerte, separado del bloque del asistente. */
  .hero-search--secondary {
    max-width: 460px;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    background: var(--bg);
    border-width: 1px;
    border-color: var(--border);
    box-shadow: none;
  }
  .hero-search--secondary .hs-placeholder { font-size: 0.9375rem; }
  .hero-search--secondary .hs-icon { width: 18px; height: 18px; }

  /* Asistente IA demoteado a secundario (opt-in, dentro de un <details>). */
  .hero-assistant {
    max-width: 640px;
    margin-top: 0.875rem;
  }
  .hero-assistant-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text-muted);
    padding: 0.375rem 0;
    user-select: none;
  }
  .hero-assistant-summary::-webkit-details-marker { display: none; }
  .hero-assistant-summary::before {
    content: '';
    width: 0; height: 0;
    border-left: 5px solid currentColor;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    transition: transform 0.15s;
  }
  .hero-assistant[open] > .hero-assistant-summary::before { transform: rotate(90deg); }
  .hero-assistant-summary span { text-decoration: underline; text-underline-offset: 2px; }
  .hero-assistant-summary:hover { color: var(--accent); }
  .hero-assistant[open] > .hero-assistant-summary { margin-bottom: 0.75rem; }

  /* Chips de búsquedas populares — debajo del buscador */
  .hero-pop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    max-width: 640px;
    margin: 0 auto 1.75rem;
  }
  .hero-pop-label {
    color: var(--text-subtle);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .hero-pop-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.7rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .hero-pop-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
  /* Mobile: chips populares en una sola fila scrolleable (no wrappear en 3 líneas) */
  @media (max-width: 600px) {
    .hero-pop {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      max-width: none;
      padding: 0 1rem;
    }
    .hero-pop::-webkit-scrollbar { display: none; }
    .hero-pop-label { flex-shrink: 0; }
    .hero-pop-chip { flex-shrink: 0; scroll-snap-align: start; }
  }

  /* Franja "Tus calculadoras" — favoritos del usuario (localStorage).
     Server-side viene display:none; el JS la muestra sólo con ≥1 fav. */
  .fav-strip {
    max-width: 640px;
    margin: 0 auto 1.75rem;
  }
  .fav-strip-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-muted);
    margin: 0 0 0.625rem;
  }
  .fav-strip-title svg { color: #f59e0b; flex-shrink: 0; }
  .fav-strip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.5rem;
  }
  .fav-card {
    display: flex;
    align-items: stretch;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .fav-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }
  .fav-link {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.125rem 0.5rem 0.7rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fav-link:hover { color: var(--accent); }
  .fav-remove {
    flex-shrink: 0;
    width: 1.875rem;
    border: 0;
    background: transparent;
    color: var(--text-subtle);
    font-size: 1.0625rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
  }
  .fav-remove:hover { color: #dc2626; }
  @media (max-width: 600px) {
    .fav-strip { padding: 0 1rem; }
    .fav-strip-grid { grid-template-columns: 1fr 1fr; }
  }

  .hs-kbd {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.5rem;
    background: var(--bg-muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-subtle);
    flex-shrink: 0;
  }

  .hero-meta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 0.625rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .hero-stat strong { color: var(--text); font-weight: 700; }
  .hero-dot { color: var(--border-strong); }
  .hero-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--accent-soft);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .hero-live:hover { background: var(--accent); color: var(--on-accent); text-decoration: none; }

  @media (max-width: 540px) {
    .hs-placeholder { font-size: 0.9375rem; }
    .hs-kbd { display: none; }
    .hero-meta-row { font-size: 0.8125rem; gap: 0.375rem 0.5rem; }
  }

  .btn-primary, .btn-secondary, .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
    border: 1px solid transparent;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: var(--shadow);
  }
  .btn-primary:hover { background: var(--accent-strong); color: var(--on-accent); transform: translateY(-1px); box-shadow: var(--shadow-md); text-decoration: none; }

  .btn-secondary {
    background: var(--bg-card);
    color: var(--text);
    border-color: var(--border);
    box-shadow: var(--shadow-sm);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; transform: translateY(-1px); }

  .btn-ghost {
    background: transparent;
    color: var(--accent);
    padding: 0.75rem 1rem;
  }
  .btn-ghost:hover { background: var(--accent-soft); text-decoration: none; }

  .dot-live {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }
  /* Pulso compositado (transform+opacity, fuera del main-thread) en vez de
     animar box-shadow, que repinta cada frame y dispara INP. */
  .dot-live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(22, 163, 74, 0.5);
    animation: pulse 2s infinite;
    will-change: transform, opacity;
  }
  @keyframes pulse {
    0%   { transform: scale(1); opacity: 0.5; }
    70%  { transform: scale(3); opacity: 0; }
    100% { transform: scale(3); opacity: 0; }
  }

  /* Sources */
  .sources {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border);
  }

  .sources-label {
    font-size: 0.75rem;
    color: var(--text-subtle);
    font-weight: 500;
    margin-right: 0.25rem;
  }

  .source-chip {
    display: inline-flex;
    padding: 0.25rem 0.625rem;
    background: var(--bg-muted);
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid var(--border);
  }

  /* Sección headers */
  .section-title {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
    line-height: 1.3;
  }
  .section-title .eyebrow {
    display: block;
    margin-bottom: 0.375rem;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .section-header h2 { margin: 0; font-size: 1.5rem; }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .eyebrow-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.375rem;
  }

  .see-all {
    font-size: 0.875rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }
  .see-all:hover { text-decoration: underline; }

  /* [4] Destacados (BCRA + Comparador) with shimmer */
  /* Salas de decisión — selector visual de decisiones de la home. */
  .salas-home {
    --salas-navy: #07194f;
    --salas-blue: #1450d2;
    --salas-border: #d8e0f2;
    margin: 3rem 0 3.5rem;
  }
  .salas-home-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .salas-home-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.9rem;
    color: var(--salas-blue);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .salas-home-eyebrow svg { flex: 0 0 auto; }
  .salas-home h2 {
    margin: 0;
    color: var(--salas-navy);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 3.15vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .salas-home-lede {
    margin: 1rem 0 0;
    color: #4c5b7a;
    font-size: 1.06rem;
    line-height: 1.6;
  }
  .salas-home-all {
    margin-bottom: 1.65rem;
    color: var(--salas-blue);
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .salas-home-all span { display: inline-block; margin-left: 0.45rem; transition: transform 0.18s ease; }
  .salas-home-all:hover span { transform: translateX(3px); }
  .salas-home-filters {
    display: flex;
    gap: 0.7rem;
    margin: 2.3rem 0 1.7rem;
    overflow-x: auto;
    padding: 1px 1px 0.25rem;
    scrollbar-width: none;
  }
  .salas-home-filters::-webkit-scrollbar { display: none; }
  .salas-home-filters a {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.65rem 1.75rem;
    border: 1px solid var(--salas-border);
    border-radius: 999px;
    background: #fff;
    color: #14378f;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }
  .salas-home-filters a:hover { border-color: #9db2e2; background: #f8faff; transform: translateY(-1px); }
  .salas-home-filters a.is-active {
    min-width: 9.2rem;
    border-color: var(--salas-navy);
    background: var(--salas-navy);
    color: #fff;
    box-shadow: 0 8px 18px rgba(7, 25, 79, 0.14);
  }
  .salas-home-filters svg {
    width: 1.45rem;
    height: 1.45rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .salas-home-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .sala-card {
    min-height: 13.7rem;
    display: grid;
    grid-template-columns: 5.3rem minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    column-gap: 1rem;
    padding: 1.75rem 1.4rem 1.1rem;
    border: 1px solid var(--salas-border);
    border-radius: 0.85rem;
    background: #fff;
    color: var(--salas-navy);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(27, 55, 112, 0.045);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .sala-card:hover {
    border-color: #9eb4e6;
    box-shadow: 0 12px 28px rgba(27, 55, 112, 0.11);
    transform: translateY(-3px);
  }
  .sala-icon {
    width: 5.1rem;
    height: 5.1rem;
    display: grid;
    place-items: center;
    grid-row: 1;
    border-radius: 50%;
    background: #f1f4fb;
    color: var(--salas-navy);
  }
  .sala-icon svg {
    width: 2.65rem;
    height: 2.65rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sala-card-content { min-width: 0; padding-top: 0.25rem; }
  .sala-category {
    display: block;
    margin-bottom: 1rem;
    color: var(--salas-blue);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .sala-title {
    display: block;
    color: var(--salas-navy);
    font-size: 1.06rem;
    font-weight: 750;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }
  .sala-cta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.2rem;
    padding: 0.9rem 0.4rem 0;
    border-top: 1px solid #dfe5f2;
    color: var(--salas-blue);
    font-size: 0.94rem;
    font-weight: 650;
  }
  .sala-cta span { transition: transform 0.18s ease; }
  .sala-card:hover .sala-cta span { transform: translateX(3px); }
  .salas-home-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin: 2.25rem 0 0;
    color: #53617d;
    font-size: 0.95rem;
  }
  .salas-trust-icon {
    width: 3.1rem;
    height: 3.1rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #f1f4fb;
    color: var(--salas-blue);
  }
  .salas-trust-icon svg { width: 1.75rem; height: 1.75rem; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .salas-trust-dot { color: #8792aa; }
  @media (max-width: 900px) {
    .salas-home-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .salas-lede-break { display: none; }
  }
  @media (max-width: 640px) {
    .salas-home { margin-top: 2.5rem; }
    .salas-home-header { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .salas-home h2 { font-size: 2rem; }
    .salas-home-lede { font-size: 0.96rem; }
    .salas-home-all { margin: 0; }
    .salas-home-filters { margin: 1.75rem 0 1.25rem; }
    .salas-home-filters a { min-height: 2.65rem; padding: 0.55rem 1.15rem; font-size: 0.9rem; }
    .salas-home-filters a.is-active { min-width: 6rem; }
    .salas-home-grid { grid-template-columns: 1fr; }
    .sala-card { min-height: 12.4rem; }
    .salas-home-trust { align-items: flex-start; flex-wrap: wrap; text-align: center; line-height: 1.5; }
    .salas-trust-icon { flex-basis: 100%; margin: 0 auto 0.15rem; background: transparent; }
  }

  /* Banda unificada de calculadoras (populares + para vos + lo nuevo) */
  .explorar-calcs { margin: 2.5rem 0 3rem; }
  .explorar-calcs .populares-grid,
  .explorar-calcs .pv-grid { margin-bottom: 1.75rem; }
  .explorar-calcs .row-label { margin-top: 0.5rem; }
  /* Banda "Aprendé": espacio entre guías y notas + link del blog */
  .aprende .pilares-grid { margin-bottom: 0.5rem; }
  .aprende .row-label { margin-top: 1.5rem; }
  .aprende-bloglink { text-align: right; margin-top: 0.75rem; }

  .destacados {
    margin: 2.5rem 0 3rem;
  }
  .destacados-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1rem;
  }

  .feature-card {
    position: relative;
    display: block;
    padding: 1.5rem 1.5rem 1.25rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s, background-color 0.2s, color 0.2s;
    border: 1px solid transparent;
    cursor: pointer;
  }
  .feature-card:hover .feature-cta {
    transform: translateX(4px);
  }
  .feature-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }
  .feature-bcra {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(14, 165, 233, 0.05));
    border-color: rgba(37, 99, 235, 0.25);
  }
  .feature-pf {
    background: linear-gradient(135deg, rgba(22, 163, 74, 0.08), rgba(22, 163, 74, 0.03));
    border-color: rgba(22, 163, 74, 0.25);
  }
  .feature-conv {
    background: linear-gradient(135deg, rgba(13, 148, 136, 0.08), rgba(13, 148, 136, 0.03));
    border-color: rgba(13, 148, 136, 0.25);
  }
  .feature-conv .feature-badge { background: #0d9488; }
  .feature-conv .feature-cta { color: #0d9488; }
  .feature-sci {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.08), rgba(124, 58, 237, 0.03));
    border-color: rgba(124, 58, 237, 0.25);
  }
  .feature-sci .feature-badge { background: #7c3aed; }
  .feature-sci .feature-cta { color: #7c3aed; }

  /* Shimmer effect — subtle border glow, not overlay */
  .feature-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(
      105deg,
      transparent 35%,
      color-mix(in srgb, var(--accent) 18%, transparent) 50%,
      transparent 65%
    );
    background-size: 250% 100%;
    background-position: 120% center;
    pointer-events: none;
    z-index: 0;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    padding: 1px;
  }
  .feature-pf::after {
    background: linear-gradient(
      105deg,
      transparent 35%,
      color-mix(in srgb, var(--success) 22%, transparent) 50%,
      transparent 65%
    );
    background-size: 250% 100%;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 200% center; }
    50% { background-position: -200% center; }
  }

  .feature-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.1875rem 0.5rem;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    z-index: 1;
  }
  .feature-pf .feature-badge { background: var(--success); }

  .feature-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1;
  }
  .feature-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .feature-card p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .feature-cta {
    display: inline-flex;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .feature-pf .feature-cta { color: var(--success); }

  /* [4.5] Para vos — country-specific section */
  .para-vos {
    margin: 2rem 0 2.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.06), rgba(168, 85, 247, 0.04));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
    border-radius: var(--radius-lg);
  }
  .para-vos .section-header { margin-bottom: 1rem; }
  .para-vos .eyebrow { gap: 0.5rem; }

  .pv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.625rem;
  }

  .pv-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .pv-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }

  .pv-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
  }

  .pv-title {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .para-vos { padding: 1rem 1.125rem 1.25rem; }
  }

  /* [5] Populares with medal rankings */
  /* content-visibility: auto le dice al browser que NO haga render layout/style
     de estas secciones hasta que estén cerca del viewport. Reduce Style & Layout
     drásticamente (PageSpeed reportaba 2141ms). contain-intrinsic-size reserva
     espacio aproximado para evitar layout shift. */
  .populares, .pilares, .categorias, .final-cta {
    content-visibility: auto;
    contain-intrinsic-size: 1px 800px;
  }

  .populares {
    margin: 2rem 0 3rem;
  }
  /* Populares = un ranking → leaderboard en un solo panel con filas numeradas y
     divisores internos (no 10 cards boxeadas). Silueta: banda de datos / tabla. */
  .populares-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0 1.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 0.5rem 1.125rem;
  }

  .pop-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.8rem 0.25rem 0.8rem 2.5rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    text-decoration: none;
    color: var(--text);
    transition: padding-left 0.15s ease, color 0.15s ease;
    will-change: padding-left;
  }

  .pop-card:hover {
    border-color: var(--border);
    transform: none;
    box-shadow: none;
    text-decoration: none;
    padding-left: 2.85rem;
    background: transparent;
  }
  .pop-card:hover .pop-title { color: var(--accent); }
  .pop-card:active {
    transform: none;
  }
  .pop-card:hover .pop-icon {
    transform: rotate(-4deg) scale(1.08);
  }
  .pop-card .pop-icon {
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .pop-rank {
    position: absolute;
    left: 0.625rem;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 700;
  }
  /* Medal ranks — emoji replaces number, no bg circle */
  .pop-rank-1, .pop-rank-2, .pop-rank-3 {
    background: none;
    font-size: 1.125rem;
    width: 26px;
    height: 26px;
  }

  .pop-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
  }

  .pop-body { flex: 1; min-width: 0; }
  .pop-title {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
    margin-bottom: 0.125rem;
  }
  .ar-badge {
    margin-left: 0.35em;
    font-size: 0.85em;
    vertical-align: middle;
    line-height: 1;
    display: inline-block;
  }
  .pop-cat {
    font-size: 0.75rem;
    color: var(--text-subtle);
    font-weight: 500;
  }

  /* Quick Actions: 3 tiles grandes de verticales top (data-driven de GA) */
  .hero-quick-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    max-width: 820px;
    margin: 1.25rem auto 1.5rem;
  }
  .qa-tile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.125rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.2s ease-out,
                border-color 0.2s ease-out;
    text-align: left;
  }
  /* OJO con :hover. Antes el tile tenía scale(1.02) → el texto se veía empañado
     ("pelado") porque cualquier transform: scale() en un contenedor rompe el
     sub-pixel font rendering del browser (la capa entera se rasteriza una vez
     y se escala vectorialmente, perdiendo el LCD smoothing). Fix: lift puro
     con translateY + shadow + border highlight, sin scale a nivel tile.
     El icon (emoji) sí mantiene scale porque un glifo de 32px no acusa blur. */
  .qa-tile:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }
  .qa-tile:active { transform: translateY(-1px); transition-duration: 0.05s; }
  .qa-tile-pink:hover { border-color: #ec4899; }
  .qa-tile-green:hover { border-color: #10b981; }
  .qa-tile-blue:hover { border-color: #3b82f6; }
  .qa-tile:hover .qa-arrow { transform: translateX(4px); }
  .qa-tile:hover .qa-icon { transform: scale(1.15) rotate(-5deg); }
  .qa-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
    display: inline-flex;
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
  }
  .qa-tile-pink .qa-icon { color: #ec4899; }
  .qa-tile-green .qa-icon { color: #10b981; }
  .qa-tile-blue .qa-icon { color: #3b82f6; }
  .qa-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  .qa-title { font-weight: 700; font-size: 0.9375rem; color: var(--text); }
  .qa-desc { font-size: 0.75rem; color: var(--text-muted); line-height: 1.3; }
  .qa-arrow { color: var(--text-muted); font-weight: 700; font-size: 1.125rem; transition: transform 0.2s ease-out; }
  @media (max-width: 640px) {
    .hero-quick-actions { grid-template-columns: 1fr; gap: 0.5rem; }
    .qa-tile { padding: 0.875rem 1rem; }
    .qa-icon { font-size: 1.75rem; }
  }

  /* [5b] Pilares / guías — mostradas encima de categorías */
  .pilares { margin: 2rem 0 3rem; }
  /* Guías + notas = contenido editorial → índice abierto sin cajas, filas con
     hairline superior. Silueta: lista editorial en columnas (no grid de cards). */
  .pilares-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0 1.75rem;
    border-top: 1px solid var(--border);
  }
  .pilar-card {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.8rem 0.25rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    color: var(--text);
    text-decoration: none;
    transition: padding-left 0.15s ease, border-color 0.15s;
  }
  .pilar-card:hover {
    border-bottom-color: var(--accent);
    padding-left: 0.7rem;
    transform: none;
    box-shadow: none;
  }
  .pilar-card:active { transform: none; }
  .pilar-card:hover strong { color: var(--accent); }
  .pilar-card:hover .pilar-icon {
    transform: scale(1.12) rotate(-5deg);
  }
  .pilar-icon {
    font-size: 1.5rem; flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .pilar-card > div { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .pilar-card strong { font-size: 0.95rem; color: var(--text); font-weight: 700; line-height: 1.25; }
  .pilar-card span:last-child { font-size: 0.8125rem; color: var(--text-subtle); line-height: 1.4; }

  /* [6] Categorías — top-border gradient instead of left border */
  .categorias { margin: 2rem 0 3rem; }

  /* Rótulo de fila ("Las más usadas" / "Todas las demás") — da jerarquía
     editorial sin tapar nada (reemplaza el badge TOP que iba sobre las cards). */
  .row-label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    margin: 0.25rem 0 0.85rem;
  }
  .row-label .row-star { color: #d97706; }
  .row-label .row-line { height: 1px; background: var(--border); flex: 1; }
  .feat-grid + .row-label { margin-top: 1.75rem; }

  /* ---- Destacadas: 4 cards ricas con sus calcs estrella ---- */
  .feat-grid {
    display: grid;
    /* auto-fit con sólo 4 items → 4 cols en desktop, colapsa solo en pantallas
       chicas sin necesidad de media queries extra. */
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }
  .feat-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.05rem 0.95rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.2s ease-out, border-color 0.2s ease-out;
    will-change: transform;
  }
  /* Franja superior sólida en el color de la categoría (nítida, sin degradado). */
  .feat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--cat-color, var(--accent));
  }
  .feat-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--cat-color, var(--accent)) 50%, var(--border));
  }
  .feat-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.8rem;
    text-decoration: none;
    color: var(--text);
  }
  .feat-head:hover { text-decoration: none; }
  .feat-head:hover .feat-name { color: var(--cat-color); }
  .feat-icon {
    width: 44px; height: 44px;
    flex-shrink: 0;
    border-radius: 11px;
    background: color-mix(in srgb, var(--cat-color) 14%, transparent);
    color: var(--cat-color);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.35rem;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .feat-card:hover .feat-icon { transform: scale(1.08) rotate(-3deg); }
  .feat-titles { min-width: 0; }
  .feat-name {
    font-weight: 800;
    font-size: 1.02rem;
    line-height: 1.15;
    transition: color 0.15s;
  }
  .feat-count {
    font-size: 0.74rem;
    color: var(--text-subtle);
    font-weight: 600;
    margin-top: 0.15rem;
  }
  .feat-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .feat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    transition: border-color 0.12s, color 0.12s;
  }
  .feat-item:hover {
    color: var(--text);
    text-decoration: none;
    border-color: color-mix(in srgb, var(--cat-color) 45%, var(--border));
  }
  .feat-dot {
    width: 6px; height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--cat-color, var(--accent));
  }
  .feat-item-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    line-height: 1.3;
  }
  .feat-all {
    margin-top: 0.75rem;
    align-self: flex-start;
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--cat-color, var(--accent));
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .feat-all:hover { text-decoration: underline; }

  /* ---- Chips de categoría (arquitectura de pilares jul-2026) ---- */
  /* Las 26 categorías demotadas a navegación terciaria: chips chicos en una
     banda compacta. Crawleables pero sin competir con las cards de pilar. */
  .cat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .cat-chip:hover {
    border-color: var(--cat-color);
    color: var(--cat-color);
    text-decoration: none;
  }

  /* ---- Mosaico compacto: el resto del catálogo ---- */
  /* Navegación secundaria → links compactos, sin caja ni borde: el color vive
     sólo en el ícono. Silueta: clúster de chips (contrasta con las feat-cards). */
  .cat-mosaic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.25rem 0.5rem;
  }
  .cat-tile {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 0;
    background: transparent;
    border: 0;
    border-radius: 10px;
    padding: 0.5rem 0.6rem;
    text-decoration: none;
    color: var(--text);
    transition: background-color 0.15s ease-out, transform 0.15s ease-out;
  }
  .cat-tile:hover {
    transform: none;
    box-shadow: none;
    text-decoration: none;
    background: color-mix(in srgb, var(--cat-color) 10%, transparent);
  }
  .cat-tile:hover .tile-name { color: var(--cat-color); }
  .tile-icon {
    width: 30px; height: 30px;
    flex-shrink: 0;
    border-radius: 8px;
    background: color-mix(in srgb, var(--cat-color) 15%, transparent);
    color: var(--cat-color);
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cat-tile:hover .tile-icon { transform: scale(1.1); }
  .tile-meta { min-width: 0; }
  .tile-name { font-weight: 700; font-size: 0.84rem; line-height: 1.15; }
  .tile-count {
    font-size: 0.7rem;
    color: var(--text-subtle);
    font-weight: 600;
    margin-top: 0.15rem;
  }
  /* Badge "Nuevo" anclado a la esquina; el overflow:hidden del tile evita
     que se salga del encuadre aunque el nombre sea largo. */
  .tile-new {
    position: absolute;
    top: 6px; right: 7px;
    font-size: 0.52rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #15803d;
    background: #dcfce7;
    border-radius: 5px;
    padding: 2px 5px;
    line-height: 1;
  }

  /* [7] Stats with icons */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 3rem 0;
    padding: 1.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .stat { text-align: center; }
  .stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
    margin: 0 auto 0.625rem;
  }
  .stat-icon-green { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
  .stat-icon-flag { background: rgba(96, 165, 250, 0.1); color: #60a5fa; }
  .stat-num {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.25rem;
  }
  .stat-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* [9] Why — each icon has its own color */
  .why {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }
  .why h2 {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 1.75rem;
  }
  /* Why = información contextual → columnas abiertas, sin recuadros ni borde.
     Silueta: banda de 4 columnas con icono de color, separadas sólo por aire. */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem 2rem;
  }
  .why-item {
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }
  .why-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--why-soft, var(--accent-soft));
    color: var(--why-color, var(--accent));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .why-item h3 { margin-bottom: 0.5rem; font-size: 1rem; }
  .why-item p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Fusión "Sobre Hacé Cuentas": el texto editorial (E-E-A-T) vive colapsado
     en <details> → presente en el HTML, sin ocupar media home. */
  .about-fold { margin-top: 1.5rem; display: grid; gap: 0.625rem; }
  .ed-collapse {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
  }
  .ed-collapse > summary {
    cursor: pointer;
    list-style: none;
    padding: 0.875rem 1.125rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .ed-collapse > summary::-webkit-details-marker { display: none; }
  .ed-collapse > summary::before {
    content: "";
    width: 0.5rem; height: 0.5rem;
    flex-shrink: 0;
    border-right: 2px solid var(--text-subtle);
    border-bottom: 2px solid var(--text-subtle);
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
  }
  .ed-collapse[open] > summary::before { transform: rotate(45deg); }
  .ed-collapse > summary:hover { color: var(--accent); }
  .ed-collapse[open] > summary { border-bottom: 1px solid var(--border); }
  .ed-collapse .editorial-wrap { padding: 0.75rem 1.125rem 1.25rem; margin: 0; }

  /* Final CTA */
  .final-cta {
    margin: 4rem 0 2rem;
    padding: 2.5rem 2rem;
    text-align: center;
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
  }
  .final-cta h3 {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
    color: var(--accent-strong);
  }
  .final-cta p {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .cta-actions {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  /* Secciones editoriales — rediseño v3 con cards explícitos + icon grande.
     Cada sección es un container visual claro (no más muros de texto). */
  .editorial-intro,
  .editorial-method,
  .editorial-faq {
    margin: 4rem auto;
    max-width: 1100px;
    background: var(--bg-card, #fff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 24px;
    padding: 3rem 2.75rem;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 8px 24px -8px rgba(15, 23, 42, 0.08);
    position: relative;
    overflow: hidden;
  }
  /* Banda gradient top */
  .editorial-intro::before,
  .editorial-method::before,
  .editorial-faq::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 50%, #7c3aed));
  }
  html[data-theme="dark"] .editorial-intro,
  html[data-theme="dark"] .editorial-method,
  html[data-theme="dark"] .editorial-faq {
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 8px 24px -8px rgba(0, 0, 0, 0.5);
  }

  .editorial-wrap {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* Header: icon grande + eyebrow + título */
  .editorial-intro h2,
  .editorial-method h2,
  .editorial-faq h2 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 1.5rem;
    color: var(--text);
    position: relative;
    padding-top: 4.5rem;
  }
  /* Eyebrow */
  .editorial-intro h2::before,
  .editorial-method h2::before,
  .editorial-faq h2::before {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .editorial-intro h2::before { content: "Sobre Hacé Cuentas"; }
  .editorial-method h2::before { content: "Cómo trabajamos"; }
  .editorial-faq h2::before { content: "Preguntas frecuentes"; }

  /* Icono circular arriba del h2 */
  .editorial-intro h2::after,
  .editorial-method h2::after,
  .editorial-faq h2::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--accent-soft), color-mix(in srgb, var(--accent) 18%, transparent));
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    line-height: 1;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .editorial-intro h2::after { content: "📚"; }
  .editorial-method h2::after { content: "🛠️"; }
  .editorial-faq h2::after { content: "💬"; }

  /* Body de Qué encontrarás */
  .editorial-intro p {
    color: var(--text-muted, #475569);
    font-size: 1.0625rem;
    line-height: 1.75;
    margin: 0 0 1.125rem;
  }
  .editorial-intro p:first-of-type {
    font-size: 1.1875rem;
    color: var(--text);
    line-height: 1.6;
    font-weight: 500;
  }
  .editorial-intro p:first-of-type strong {
    background: linear-gradient(120deg, var(--accent), color-mix(in srgb, var(--accent) 50%, #7c3aed));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 800;
  }
  .editorial-intro strong {
    color: var(--text);
    font-weight: 700;
  }

  /* Links */
  .editorial-intro a,
  .editorial-method a,
  .editorial-faq a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    font-weight: 500;
  }
  .editorial-intro a:hover,
  .editorial-method a:hover,
  .editorial-faq a:hover {
    color: var(--accent-strong);
  }

  /* Método: intro párrafo + grid de cards numeradas */
  .editorial-method .editorial-wrap > p:first-of-type {
    color: var(--text-muted, #475569);
    font-size: 1.0625rem;
    line-height: 1.7;
    margin: 0 0 1.75rem;
  }
  .method-steps {
    counter-reset: ms;
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 1.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .method-steps > li {
    position: relative;
    padding: 1.5rem 1.25rem 1.375rem;
    background: var(--bg-soft, #f8fafc);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 16px;
    counter-increment: ms;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-muted, #475569);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }
  .method-steps > li:hover {
    border-color: var(--accent);
    background: var(--bg-card, #fff);
    transform: translateY(-3px);
    box-shadow:
      0 4px 12px -4px color-mix(in srgb, var(--accent) 30%, transparent),
      0 12px 24px -12px rgba(15, 23, 42, 0.12);
  }
  html[data-theme="dark"] .method-steps > li:hover {
    background: var(--bg-muted, #334155);
    box-shadow:
      0 4px 12px -4px color-mix(in srgb, var(--accent) 40%, transparent),
      0 12px 24px -12px rgba(0, 0, 0, 0.5);
  }
  .method-steps > li::before {
    content: counter(ms);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 55%, #7c3aed));
    color: var(--on-accent);
    font-weight: 800;
    font-size: 1.125rem;
    margin-bottom: 0.875rem;
    letter-spacing: -0.02em;
    box-shadow: 0 4px 8px color-mix(in srgb, var(--accent) 35%, transparent);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .method-steps > li:hover::before {
    transform: scale(1.08) rotate(-3deg);
  }
  html[data-theme="dark"] .method-steps > li::before {
    color: var(--bg);
  }
  .method-steps > li strong {
    display: block;
    color: var(--text);
    font-weight: 700;
    font-size: 1.0625rem;
    margin-bottom: 0.375rem;
    letter-spacing: -0.01em;
  }
  .method-steps code {
    background: var(--accent-soft);
    color: var(--accent-strong);
    padding: 0.125rem 0.45rem;
    border-radius: 5px;
    font-size: 0.85em;
    font-family: var(--font-mono);
  }
  /* Callout final del método */
  .editorial-method .editorial-wrap > p:last-child {
    margin-top: 1.5rem;
    padding: 1.125rem 1.25rem;
    background: linear-gradient(135deg, var(--accent-soft), color-mix(in srgb, var(--accent) 8%, var(--bg-soft)));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-left: 4px solid var(--accent);
    border-radius: 12px;
    font-size: 0.9375rem;
    color: var(--text);
    line-height: 1.6;
  }
  @media (prefers-reduced-motion: reduce) {
    .method-steps > li,
    .method-steps > li::before { transition: none; }
    .method-steps > li:hover { transform: none; }
    .method-steps > li:hover::before { transform: none; }
  }

  @media (max-width: 720px) {
    .editorial-intro,
    .editorial-method,
    .editorial-faq {
      padding: 2rem 1.25rem 2.25rem;
      border-radius: 18px;
      margin: 2.5rem auto;
    }
    .editorial-intro h2,
    .editorial-method h2,
    .editorial-faq h2 {
      font-size: 1.5rem;
      padding-top: 4rem;
    }
    .editorial-intro h2::after,
    .editorial-method h2::after,
    .editorial-faq h2::after {
      width: 48px;
      height: 48px;
      font-size: 1.5rem;
    }
    .editorial-intro p:first-of-type {
      font-size: 1.0625rem;
    }
    .method-steps {
      gap: 0.75rem;
    }
    .method-steps > li {
      padding: 1.25rem 1rem 1.125rem;
    }
  }
  .ed-faq-item {
    border: 1px solid var(--border, rgba(0,0,0,0.08));
    border-radius: var(--radius);
    margin: 0 0 0.625rem;
    background: var(--card-bg, #fff);
  }
  .ed-faq-item summary {
    cursor: pointer;
    padding: 0.875rem 1rem;
    font-weight: 600;
    color: var(--text);
    list-style: none;
    position: relative;
    padding-right: 2.5rem;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .ed-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .ed-faq-item summary::after {
    content: "+";
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.25rem;
    color: var(--accent);
    font-weight: 700;
    transition: transform 0.2s;
  }
  .ed-faq-item[open] summary::after {
    content: "−";
  }
  .ed-faq-item summary:hover {
    color: var(--accent-strong);
  }
  .ed-faq-item p {
    margin: 0;
    padding: 0 1rem 1rem;
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .hero { padding: 2.5rem 0 2rem; }
    .stats { grid-template-columns: 1fr; gap: 1rem; padding: 1.25rem; }
    .section-header { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    .section-header h2 { font-size: 1.25rem; }
    .feature-card { padding: 1.25rem; }
    .feature-card h3 { font-size: 1.125rem; }
    .feat-card { padding: 0.875rem 1rem; }
    .feat-grid { grid-template-columns: 1fr; }
    .cat-mosaic { grid-template-columns: repeat(2, 1fr); }
    .final-cta { padding: 1.75rem 1.25rem; }
    .editorial-intro,
    .editorial-method,
    .editorial-faq { margin: 2.25rem 0; }
    .editorial-intro h2,
    .editorial-method h2,
    .editorial-faq h2 { font-size: 1.25rem; }
    .editorial-intro p,
    .editorial-method p { font-size: 0.9375rem; }
    .method-steps > li { font-size: 0.9375rem; padding-left: 2.25rem; }
  }

  /* focus-visible accesible en todas las cards clickables */
  .pop-card:focus-visible,
  .pilar-card:focus-visible,
  .cat-tile:focus-visible,
  .feat-head:focus-visible,
  .feat-item:focus-visible,
  .feat-all:focus-visible,
  .feature-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius);
  }

  /* Reduce motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    .feature-card::after { animation: none; }
    .dot-live::after { animation: none; }
    .hs-placeholder { transition: none; }
    .pop-card, .pilar-card, .feat-card, .cat-tile, .feature-card,
    .pop-icon, .pilar-icon, .feat-icon, .tile-icon,
    .feat-card::before {
      transition: none !important;
    }
    .pop-card:hover, .pilar-card:hover, .feat-card:hover, .cat-tile:hover {
      transform: none !important;
    }
    .pop-card:hover .pop-icon,
    .pilar-card:hover .pilar-icon,
    .feat-card:hover .feat-icon,
    .cat-tile:hover .tile-icon {
      transform: none !important;
    }
  }

  /* Bloque estacional Mundial 2026 */
  .seasonal-mundial { max-width: 1120px; margin: 1.5rem auto 0; padding: 0 1.25rem; }
  .sm-inner { background: linear-gradient(135deg, var(--accent-soft, #eef4ff), var(--bg, #fff)); border: 1px solid var(--accent, #2c5cdc); border-radius: var(--radius-lg, 1rem); padding: 1.5rem 1.75rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; }
  .sm-head { flex: 1 1 360px; min-width: 0; }
  .sm-badge { display: inline-block; background: var(--accent, #2c5cdc); color: #fff; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; padding: 0.25rem 0.7rem; border-radius: 999px; margin-bottom: 0.6rem; }
  .sm-head h2 { font-size: clamp(1.2rem, 2.5vw, 1.55rem); margin: 0 0 0.4rem; line-height: 1.2; color: var(--text, #1e293b); }
  .sm-head p { margin: 0; color: var(--text-muted, #475569); font-size: 0.95rem; line-height: 1.5; }
  .sm-links { flex: 1 1 280px; display: flex; flex-wrap: wrap; gap: 0.6rem; align-content: center; }
  .sm-cta { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.6rem 1rem; border-radius: var(--radius-sm, 0.5rem); border: 1px solid var(--accent, #2c5cdc); color: var(--accent-strong, #1e40af); background: var(--bg, #fff); font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: transform 0.15s, background 0.15s; white-space: nowrap; }
  .sm-cta:hover { transform: translateY(-1px); text-decoration: none; }
  .sm-cta-primary { background: var(--accent, #2c5cdc); color: #fff; }
  .sm-cta-primary:hover { filter: brightness(1.07); }
  .seasonal-monotributo .sm-inner { background: linear-gradient(135deg, #ecfdf5, var(--bg, #fff)); border-color: #059669; }
  .seasonal-monotributo .sm-badge { background: #047857; }
  .seasonal-monotributo .sm-cta { border-color: #059669; color: #047857; }
  .seasonal-monotributo .sm-cta-primary { background: #047857; color: #fff; }
  @media (max-width: 560px) { .sm-inner { padding: 1.25rem; } .sm-cta { flex: 1 1 calc(50% - 0.3rem); justify-content: center; } }
  /* Modo finde: mismo layout que seasonal-mundial con acento cálido.
     Contraste AA: badge/CTA primary usan #c2410c (blanco 5.18:1); #ea580c
     daba 3.56:1 con texto blanco chico → fail WCAG 1.4.3. */
  .fm-inner { background: linear-gradient(135deg, #fff4ec, var(--bg, #fff)); border-color: #ea580c; }
  .fm-badge { background: #c2410c; }
  .fm-cta { border-color: #ea580c; color: #c2410c; }
  .fm-cta-primary { background: #c2410c; color: #fff; }
  .fm-question { font-weight: 700; font-size: 1.05rem; color: #9a3412; margin: 0.75rem 0 0.5rem; }
  .fm-more { margin: 0.9rem 0 0; font-size: 0.9rem; }
  .fm-more a { color: #c2410c; font-weight: 600; text-decoration: none; }
  .fm-more a:hover { text-decoration: underline; }
  /* Dark mode: los naranjas hardcodeados quedaban sobre el gradiente que
     termina en var(--bg)=#0f172a (texto #9a3412 → 2.4:1). Superficie oscura
     cálida + naranjas claros (#fdba74 ≥ 9:1 sobre #431407/#0f172a). */
  html[data-theme="dark"] .fm-inner { background: linear-gradient(135deg, #431407, var(--bg, #0f172a)); border-color: #ea580c; }
  html[data-theme="dark"] .fm-question { color: #fdba74; }
  html[data-theme="dark"] .fm-cta { color: #fdba74; }
  html[data-theme="dark"] .fm-more a { color: #fdba74; }

  /* =====================================================================
     HOME UX V4 — sistema visual unificado
     Sólo cambia presentación: el inventario, copy, URLs, datos vivos,
     personalización, schema y bloques editoriales se preservan completos.
     ===================================================================== */
  .hero,
  .caminos,
  .salas-home,
  .seasonal-mundial,
  .categorias,
  .explorar-calcs,
  .aprende,
  .stats,
  .about-hc,
  .editorial-faq,
  .final-cta {
    --home-navy: #07194f;
    --home-blue: #1450d2;
    --home-blue-soft: #eef3ff;
    --home-border: #d9e1f0;
    --home-ink-soft: #52617d;
  }

  /* Ritmo y títulos compartidos: misma jerarquía en toda la página. */
  .caminos,
  .salas-home,
  .categorias,
  .explorar-calcs,
  .aprende,
  .about-hc,
  .editorial-faq {
    margin-top: 5rem;
    margin-bottom: 5rem;
  }
  .section-header,
  .caminos-head {
    align-items: flex-end;
    margin-bottom: 1.8rem;
  }
  .section-header h2,
  .caminos-head h2,
  .about-hc > h2,
  .editorial-faq h2 {
    color: var(--home-navy);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.9rem, 3vw, 2.65rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .eyebrow,
  .caminos-eyebrow {
    color: var(--home-blue);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }
  .see-all,
  .caminos-all {
    color: var(--home-blue);
    font-size: 0.9rem;
    font-weight: 700;
  }

  /* Hero: una entrada dominante y un panel vivo que se entiende de un vistazo. */
  .hero {
    position: relative;
    isolation: isolate;
    max-width: 1120px;
    padding: 4.75rem 0 3.25rem;
  }
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background:
      radial-gradient(circle at 14% 25%, rgba(20, 80, 210, 0.09), transparent 30%),
      radial-gradient(circle at 83% 18%, rgba(128, 160, 255, 0.13), transparent 27%),
      linear-gradient(180deg, #fbfcff 0%, #fff 88%);
    border-bottom: 1px solid #edf0f7;
  }
  .hero-grid { gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
    padding: 0.38rem 0.7rem;
    border: 1px solid #cbd9fb;
    border-radius: 999px;
    background: rgba(255,255,255,0.82);
    color: var(--home-blue);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .hero-kicker::before {
    content: '';
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #a8e43d;
    box-shadow: 0 0 0 4px rgba(168, 228, 61, 0.18);
  }
  .hero-title {
    max-width: 12ch;
    margin-bottom: 1.1rem;
    color: var(--home-navy);
    font-size: clamp(3rem, 5.2vw, 4.65rem);
    letter-spacing: -0.065em;
    line-height: 0.97;
  }
  .hero-title .accent {
    color: var(--home-blue);
    background: none;
    -webkit-text-fill-color: currentColor;
  }
  .hero-lead {
    max-width: 60ch;
    margin-bottom: 1.25rem;
    color: #485775;
    font-size: 1.08rem;
    line-height: 1.65;
  }
  .hero :global(.hero-search),
  .hero :global(.hs-shell) {
    border-color: #aebee0;
    box-shadow: 0 12px 30px rgba(7, 25, 79, 0.09), 0 2px 5px rgba(7, 25, 79, 0.06);
  }
  .hero-assistant { margin-top: 0.95rem; }
  .hero-assistant-summary {
    color: #53617b;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .hero-intents { margin-top: 1.35rem; gap: 0.5rem; }
  .hero-intent-chip {
    padding: 0.42rem 0.8rem;
    border-color: #d5deef;
    background: rgba(255,255,255,0.9);
    color: #34435f;
    font-weight: 650;
  }
  .hero-intent-chip:hover { border-color: var(--home-blue); color: var(--home-blue); }
  .hoy-panel {
    min-height: 23.5rem;
    padding: 1.65rem 1.8rem;
    border: 1px solid #193b91;
    border-radius: 1.35rem;
    background:
      radial-gradient(circle at 92% 0%, rgba(75, 118, 235, 0.38), transparent 38%),
      linear-gradient(145deg, #061744, #0b286d 72%, #123789);
    box-shadow: 0 22px 46px rgba(7, 25, 79, 0.18);
    color: #fff;
  }
  .hoy-head { color: #cbd9ff; letter-spacing: 0.1em; }
  .hoy-list { margin: 1rem 0 1.2rem; }
  .hoy-list li { border-color: rgba(255,255,255,0.14); }
  .hoy-lbl { color: #d8e1f8; }
  .hoy-val { color: #fff; }
  .hoy-more { color: #b9f24b; font-weight: 750; }
  .hero-country-picker {
    margin-top: 2.2rem;
    padding: 1rem 1.15rem;
    border: 1px solid #e0e6f1;
    border-radius: 1rem;
    background: #f8faff;
  }
  .hcp-pill { background: #fff; }
  .hcp-current { background: var(--home-blue-soft); border-color: #8fa9e8; }
  .hero-meta-row { margin-top: 1.25rem; }
  .sources {
    margin-top: 1.2rem;
    padding: 0.85rem 1rem;
    border: 0;
    border-radius: 0.85rem;
    background: #f7f8fb;
  }

  /* Cuatro puertas: selector consistente y claramente accionable. */
  .caminos { max-width: 1120px; }
  .caminos-grid { gap: 1rem; }
  .camino {
    min-height: 14.5rem;
    padding: 1.55rem 1.4rem;
    border-color: var(--home-border);
    border-radius: 1rem;
    box-shadow: 0 5px 16px rgba(34, 57, 105, 0.05);
  }
  .camino::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(145deg, color-mix(in srgb, var(--c-ac) 8%, transparent), transparent 45%);
  }
  .camino:hover { border-color: #9cb2e2; box-shadow: 0 16px 30px rgba(25, 52, 110, 0.11); }
  .camino-ic { width: 3.25rem; height: 3.25rem; border-radius: 0.85rem; }
  .camino-t { margin-top: 1.05rem; font-size: 1.08rem; }
  .camino-d { font-size: 0.88rem; line-height: 1.55; }
  .camino-go { margin-top: auto; padding-top: 1rem; font-size: 0.84rem; }
  .camino-primary {
    background: linear-gradient(145deg, #07194f, #0a266b);
    border-color: #07194f;
    box-shadow: 0 18px 34px rgba(7, 25, 79, 0.19);
  }
  .camino-primary::after { background: radial-gradient(circle at 95% 5%, rgba(185,242,75,0.16), transparent 38%); }

  /* Salas: se integra al mismo ancho y ritmo del resto de la home. */
  .salas-home { max-width: 1120px; }
  .salas-home h2 { font-size: clamp(2.1rem, 3.6vw, 3rem); }
  .sala-card { border-radius: 1rem; }

  /* Actualidad: tres módulos compactos dentro de una misma familia visual. */
  .seasonal-mundial {
    max-width: 1120px;
    margin-top: 1rem;
    padding: 0;
  }
  .seasonal-mundial:first-of-type { margin-top: 5rem; }
  .sm-inner {
    position: relative;
    overflow: hidden;
    padding: 1.65rem 1.8rem;
    border-color: #c8d5f4;
    border-radius: 1rem;
    background: #f4f7ff;
    box-shadow: 0 4px 14px rgba(31, 56, 110, 0.045);
  }
  .sm-inner::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--home-blue);
  }
  .sm-head h2 { color: var(--home-navy); letter-spacing: -0.025em; }
  .sm-badge { background: var(--home-blue); }
  .sm-cta { border-color: #aac0ee; border-radius: 0.7rem; background: #fff; color: #173b93; }
  .sm-cta-primary { border-color: var(--home-blue); background: var(--home-blue); color: #fff; }
  .seasonal-monotributo .sm-inner { background: #f2fbf7; border-color: #a6d9c5; }
  .seasonal-monotributo .sm-inner::before { background: #047857; }
  .fm-inner { background: #fff8f3; border-color: #f2c4a6; }
  .fm-inner::before { background: #c2410c; }

  /* Pilares: gran bloque de exploración con superficie propia. */
  .categorias {
    position: relative;
    padding: 2.4rem;
    border: 1px solid #dbe4f6;
    border-radius: 1.35rem;
    background: linear-gradient(155deg, #f5f8ff 0%, #fff 55%);
  }
  .feat-grid { gap: 1rem; }
  .feat-card {
    padding: 1.2rem 1.15rem 1.1rem;
    border-color: #d6deec;
    border-radius: 1rem;
    box-shadow: 0 5px 14px rgba(31, 55, 102, 0.05);
  }
  .feat-card::before { height: 4px; }
  .feat-icon { width: 48px; height: 48px; border-radius: 14px; }
  .feat-item { background: #f8f9fc; border-color: #e2e7ef; }
  .row-label { margin-top: 2rem; color: #4a5873; }
  .cat-chip { background: #fff; border-color: #d8e0ed; }

  /* Calculadoras: listas densas pero con agrupación y lectura más claras. */
  .explorar-calcs { position: relative; }
  .explorar-calcs .populares-grid {
    padding: 0.75rem 1.35rem;
    border-color: #d9e2f2;
    border-radius: 1.1rem;
    background: #f7f9fd;
  }
  .pop-card { padding-top: 1rem; padding-bottom: 1rem; }
  .pop-icon { width: 42px; height: 42px; border-radius: 0.75rem; }
  .pop-title { color: #15254c; }
  .pv-grid { gap: 0.75rem; }
  .pv-card {
    min-height: 4.6rem;
    border-color: #dce3ef;
    border-radius: 0.85rem;
    background: #fff;
    box-shadow: 0 3px 10px rgba(24, 48, 95, 0.035);
  }
  .destacados-grid { gap: 1rem; }
  .feature-card {
    min-height: 15.5rem;
    border-color: #d9e1ef;
    border-radius: 1rem;
    box-shadow: 0 5px 14px rgba(31, 55, 102, 0.05);
  }

  /* Aprendizaje: tono editorial cálido y cards escaneables. */
  .aprende {
    padding: 2.4rem;
    border: 1px solid #e5e0d7;
    border-radius: 1.35rem;
    background: linear-gradient(155deg, #fffaf2, #fff 55%);
  }
  .aprende .pilares-grid { border-top-color: #e4ded2; }
  .aprende .pilar-card {
    min-height: 4.7rem;
    padding: 0.95rem 0.75rem;
    border-bottom-color: #e7e1d8;
    border-radius: 0.65rem;
  }
  .aprende .pilar-card:hover { padding-left: 1rem; background: rgba(255,255,255,0.78); }
  .pilar-icon {
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 0.7rem;
    background: #fff;
    box-shadow: inset 0 0 0 1px #e6e0d7;
    font-size: 1.25rem;
  }

  /* Prueba social: banda de confianza, no tres cajas sueltas. */
  .stats {
    margin: 5rem 0;
    padding: 2rem 1.75rem;
    border: 0;
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at 100% 0%, rgba(41, 93, 215, 0.42), transparent 32%),
      linear-gradient(135deg, #061744, #0b286d);
    box-shadow: 0 20px 40px rgba(7, 25, 79, 0.16);
  }
  .stat { position: relative; padding: 0.3rem 1.3rem; }
  .stat + .stat { border-left: 1px solid rgba(255,255,255,0.16); }
  .stat-icon { background: rgba(255,255,255,0.1); color: #b9f24b; }
  .stat-icon-green { color: #7ee7ad; }
  .stat-icon-flag { color: #9bb9ff; }
  .stat-num { color: #fff; }
  .stat-label { color: #d4def5; }

  /* Confianza + contenido profundo: jerarquía sobria, sin muro visual. */
  .about-hc {
    padding: 2.6rem;
    border: 1px solid #dce4f2;
    border-radius: 1.35rem;
    background: #f8faff;
  }
  .about-hc > h2 { margin: 0 0 2rem; text-align: left; }
  .why { border-top: 0; }
  .why-grid { gap: 1rem; }
  .why-item {
    padding: 1.25rem;
    border: 1px solid #e0e6f1;
    border-radius: 0.95rem;
    background: #fff;
  }
  .why-icon { margin-bottom: 0.8rem; border-radius: 0.75rem; }
  .about-fold { margin-top: 1rem; }
  .ed-collapse { border-color: #dce3ef; border-radius: 0.8rem; }
  .ed-collapse > summary { padding: 1rem 1.15rem; }

  .editorial-faq {
    max-width: 1120px;
    padding: 2.5rem;
    border-color: #dbe3f2;
    border-radius: 1.35rem;
    background: linear-gradient(155deg, #f4f7ff, #fff 50%);
    box-shadow: none;
  }
  .editorial-faq::before { height: 0; }
  .editorial-faq h2 {
    max-width: 18ch;
    margin-bottom: 2rem;
    padding-top: 0;
  }
  .editorial-faq h2::before,
  .editorial-faq h2::after { display: none; }
  .ed-faq-item {
    margin-bottom: 0.7rem;
    border-color: #dbe3f0;
    border-radius: 0.8rem;
    box-shadow: 0 2px 7px rgba(26, 50, 99, 0.025);
  }
  .ed-faq-item summary { padding: 1rem 1.1rem; font-size: 0.98rem; }

  /* Cierre: CTA inequívoco, separado del contenido editorial. */
  .final-cta {
    margin: 5rem 0 2rem;
    padding: 3.2rem 2rem;
    border: 0;
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at 90% 5%, rgba(72, 118, 231, 0.45), transparent 35%),
      linear-gradient(135deg, #061744, #0b286d);
    box-shadow: 0 20px 40px rgba(7, 25, 79, 0.16);
  }
  .final-cta h3 { color: #fff; font-size: clamp(1.65rem, 3vw, 2.25rem); }
  .final-cta p { color: #d4def5; font-size: 1rem; }
  .final-cta .btn-primary { background: #b9f24b; color: #132d07; border-color: #b9f24b; }
  .final-cta .btn-primary:hover { background: #c8f86c; color: #132d07; }
  .final-cta .btn-ghost { color: #fff; }

  /* Dark mode: mantener contraste sin perder la nueva jerarquía. */
  html[data-theme="dark"] .hero::before {
    background:
      radial-gradient(circle at 15% 20%, rgba(59,130,246,0.16), transparent 31%),
      linear-gradient(180deg, #0d1729, var(--bg) 90%);
    border-bottom-color: #26334a;
  }
  html[data-theme="dark"] .hero-kicker,
  html[data-theme="dark"] .hero-intent-chip,
  html[data-theme="dark"] .hcp-pill,
  html[data-theme="dark"] .feat-card,
  html[data-theme="dark"] .cat-chip,
  html[data-theme="dark"] .pv-card,
  html[data-theme="dark"] .why-item,
  html[data-theme="dark"] .ed-faq-item { background: var(--bg-card); }
  html[data-theme="dark"] .hero-country-picker,
  html[data-theme="dark"] .sources,
  html[data-theme="dark"] .categorias,
  html[data-theme="dark"] .explorar-calcs .populares-grid,
  html[data-theme="dark"] .aprende,
  html[data-theme="dark"] .about-hc,
  html[data-theme="dark"] .editorial-faq { background: var(--bg-soft); border-color: var(--border); }
  html[data-theme="dark"] .section-header h2,
  html[data-theme="dark"] .caminos-head h2,
  html[data-theme="dark"] .about-hc > h2,
  html[data-theme="dark"] .editorial-faq h2,
  html[data-theme="dark"] .hero-title { color: var(--text); }

  @media (max-width: 900px) {
    .hero { padding-top: 3.5rem; }
    .hero-grid { gap: 2rem; }
    .hoy-panel { min-height: 0; }
    .categorias,
