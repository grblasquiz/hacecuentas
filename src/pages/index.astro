---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { HOME_HREFLANG } from '../lib/hreflang';

const popular = [
  { href: '/salud/peso-ideal-imc', group: 'Salud', title: '¿Estoy en mi peso?', desc: 'IMC, rango saludable y contexto.', icon: '♥', color: 'mint' },
  { href: '/alquiler/aumento-de-alquiler', group: 'Alquiler', title: '¿Cuánto me aumenta el alquiler?', desc: 'ICL, IPC y fecha del contrato.', icon: '⌂', color: 'yellow' },
  { href: '/trabajo/indemnizacion-por-despido', group: 'Trabajo', title: 'Me despiden: ¿cuánto me pagan?', desc: 'Todos los conceptos de la indemnización.', icon: '↗', color: 'blue' },
  { href: '/trabajo/aguinaldo', group: 'Trabajo', title: '¿Cuánto aguinaldo me corresponde?', desc: 'SAC completo o proporcional.', icon: '＋', color: 'coral' },
  { href: '/fechas/dias-entre-fechas', group: 'Fechas', title: '¿Cuántos días hay entre dos fechas?', desc: 'Corridos, hábiles y feriados.', icon: '◷', color: 'lilac' },
  { href: '/impuestos/ganancias-cuarta-categoria', group: 'Impuestos', title: '¿Me descuentan Ganancias?', desc: 'Piso, deducciones y retención.', icon: '%', color: 'navy' },
];

const moments = [
  {
    class: 'work', number: '01', title: 'Cambió mi trabajo',
    desc: 'Entendé cuánto cobrás, cuánto perdés y qué deberían pagarte.',
    href: '/trabajo', cta: 'Resolver temas de trabajo',
    links: [
      ['/trabajo/sueldo-bruto-y-neto', 'Sueldo en mano'],
      ['/trabajo/liquidacion-final', 'Liquidación final'],
      ['/trabajo/vacaciones', 'Vacaciones'],
    ],
  },
  {
    class: 'home-life', number: '02', title: 'Alquilo, compro o construyo',
    desc: 'Todos los costos juntos antes de firmar, mudarte o empezar una obra.',
    href: '/alquiler', cta: 'Resolver vivienda y alquiler',
    links: [
      ['/alquiler/aumento-de-alquiler', 'Aumento del alquiler'],
      ['/alquiler/entrar-a-un-alquiler', 'Plata para entrar'],
      ['/construccion/costo-por-m2', 'Costo por m²'],
    ],
  },
  {
    class: 'health', number: '03', title: 'Me cuido y cuido a los míos',
    desc: 'Referencias claras para interpretar números de salud y familia.',
    href: '/salud', cta: 'Resolver preguntas de salud',
    links: [
      ['/salud/peso-ideal-imc', 'Peso e IMC'],
      ['/salud/crecimiento-infantil', 'Crecimiento infantil'],
      ['/embarazo/semanas', 'Semanas de embarazo'],
    ],
  },
  {
    class: 'money', number: '04', title: 'Ordeno mi plata',
    desc: 'Impuestos, ahorro y deudas explicados en pesos de hoy.',
    href: '/finanzas-personales', cta: 'Ordenar mis finanzas',
    links: [
      ['/impuestos/monotributo', 'Monotributo'],
      ['/finanzas-personales/dolar', 'Dólar o pesos'],
      ['/finanzas-personales/prestamo', 'Costo de un préstamo'],
    ],
  },
  {
    class: 'car', number: '05', title: 'Decido sobre el auto',
    desc: 'Compra, uso y mantenimiento vistos como un costo completo.',
    href: '/auto', cta: 'Resolver gastos del auto',
    links: [
      ['/auto/auto-o-uber', 'Auto o Uber'],
      ['/auto/costo-anual', 'Costo anual'],
      ['/auto/nafta-y-peajes', 'Nafta y peajes'],
    ],
  },
];

const live = [
  { href: '/datos-monotributo-2026', tag: 'VIGENTE', title: 'Monotributo 2026', meta: 'Escala, topes y cuotas', color: 'green' },
  { href: '/valores-bcra', tag: 'HOY', title: 'Dólar, UVA e inflación', meta: 'Datos económicos diarios', color: 'blue' },
  { href: '/fechas/feriados', tag: 'CALENDARIO', title: 'Feriados de Argentina', meta: 'Días hábiles y próximos feriados', color: 'yellow' },
  { href: '/datos-salario-minimo-latam-2026', tag: '13 PAÍSES', title: 'Salarios mínimos LATAM', meta: 'Valor, vigencia y fuente', color: 'coral' },
];

const countries = [
  ['/co','🇨🇴','Colombia'], ['/mx','🇲🇽','México'], ['/cl','🇨🇱','Chile'], ['/pe','🇵🇪','Perú'],
  ['/ec','🇪🇨','Ecuador'], ['/ve','🇻🇪','Venezuela'], ['/py','🇵🇾','Paraguay'], ['/uy','🇺🇾','Uruguay'],
  ['/do','🇩🇴','Rep. Dominicana'], ['/es','🇪🇸','España'], ['/pt','🇧🇷','Brasil'], ['/pt-pt','🇵🇹','Portugal'],
  ['/en','🌎','English'],
];

const silos = [
  ['/alquiler','Alquiler'], ['/auto','Auto'], ['/bebes','Bebés'], ['/ciencia','Ciencia'], ['/cocina','Cocina'],
  ['/construccion','Construcción'], ['/conversores','Conversiones'], ['/embarazo','Embarazo'], ['/estudio','Estudio'],
  ['/eventos','Eventos'], ['/familia','Familia'], ['/fechas','Fechas'], ['/finanzas-personales','Finanzas'],
  ['/futbol','Fútbol'], ['/hogar','Hogar'], ['/impuestos','Impuestos'], ['/inversiones','Inversiones'],
  ['/jardin','Jardín'], ['/jubilacion','Jubilación'], ['/mascotas','Mascotas'], ['/matematica','Matemática'],
  ['/negocios','Negocios'], ['/nutricion','Nutrición'], ['/ocio','Ocio'], ['/salud','Salud'],
  ['/tecnologia','Tecnología'], ['/trabajo','Trabajo'], ['/viajes','Viajes'], ['/vivienda','Vivienda'],
];

const searchItems = [...popular.map(({ href, title, group }) => ({ href, label: title, group })),
  ...moments.flatMap((m) => m.links.map(([href, label]) => ({ href, label, group: m.title })))];
const uniqueSearchItems = [...new Map(searchItems.map((item) => [item.href, item])).values()];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Hacé Cuentas',
  url: 'https://hacecuentas.com/',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://hacecuentas.com/buscar?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="Hacé Cuentas — Respuestas completas para decidir"
  description="Resolvé preguntas de plata, trabajo, salud y vida cotidiana con cálculos, normativa, fuentes y datos actualizados."
  image="/og/index.png"
  audience="AR"
  pageType="home"
  schema={schema}
  hreflang={HOME_HREFLANG}
>
  <Header slot="header" />

  <div class="hc-home">
    <main class="hero">
      <div class="hero-copy">
        <span class="hero-label">UNA PREGUNTA. LA CUENTA COMPLETA.</span>
        <h1>No adivines.<br /><em>Hacé cuentas.</em></h1>
        <p>Respuestas para decisiones reales de plata, trabajo, salud y vida cotidiana. Con la norma aplicada, la fuente y la fecha del dato.</p>

        <form class="search" id="hub-search" role="search" action="/buscar" method="get">
          <label for="home-query">¿Qué necesitás resolver?</label>
          <div class="search-box">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.7-4.7m2.2-5.3a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"/></svg>
            <input id="home-query" name="q" type="search" placeholder="Ej: me despidieron, ¿cuánto me tienen que pagar?" autocomplete="off" aria-controls="hub-results" aria-expanded="false" />
            <button type="submit">Encontrar respuesta <span>→</span></button>
          </div>
          <div class="search-results" id="hub-results" hidden></div>
        </form>

        <div class="hero-trust">
          <span><i>✓</i> Gratis</span>
          <span><i>⌁</i> Fuentes citadas</span>
          <span><i>◷</i> Datos vigentes</span>
        </div>
      </div>

    </main>

    <section class="popular wrap" aria-labelledby="popular-title">
      <div class="section-title">
        <div><span>MÁS RESUELTAS</span><h2 id="popular-title">Empezá por una pregunta.</h2></div>
        <p>Las decisiones que más personas resolvieron en los últimos 90 días.</p>
      </div>
      <div class="popular-grid">
        {popular.map((item) => (
          <a class:list={['popular-card', `popular-card--${item.color}`]} href={item.href}>
            <div class="popular-icon">{item.icon}</div>
            <div><span>{item.group}</span><h3>{item.title}</h3><p>{item.desc}</p></div>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="moments" aria-labelledby="moments-title">
      <div class="wrap">
        <div class="section-title section-title--light">
          <div><span>LA VIDA NO VIENE POR CATEGORÍAS</span><h2 id="moments-title">Elegí tu momento.</h2></div>
          <p>Cada página junta las cuentas que aparecen cuando estás frente a una decisión real.</p>
        </div>
        <div class="moment-grid">
          {moments.map((item) => (
            <article class:list={['moment-card', `moment-card--${item.class}`]}>
              <span class="moment-number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
              <ul>{item.links.map(([href, label]) => <li><a href={href}>{label}<span>→</span></a></li>)}</ul>
              <a class="moment-cta" href={item.href}>{item.cta} <span>↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="fresh wrap" aria-labelledby="fresh-title">
      <div class="section-title">
        <div><span>LOS DATOS CAMBIAN</span><h2 id="fresh-title">La vigencia también es parte de la respuesta.</h2></div>
        <p>Cuando cambia un índice, una escala o un calendario, la cuenta tiene que mostrarlo.</p>
      </div>
      <div class="fresh-grid">
        {live.map((item) => (
          <a class:list={['fresh-card', `fresh-card--${item.color}`]} href={item.href}>
            <span>{item.tag}</span><h3>{item.title}</h3><p>{item.meta}</p><b>Ver dato actualizado ↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="method wrap" aria-labelledby="method-title">
      <div class="method-visual">
        <div class="method-ring"><span>✓</span></div>
        <div class="method-card method-card--a"><small>01</small><b>La norma</b><span>Qué regla se aplica</span></div>
        <div class="method-card method-card--b"><small>02</small><b>La fuente</b><span>De dónde sale el dato</span></div>
        <div class="method-card method-card--c"><small>03</small><b>La fecha</b><span>Desde cuándo está vigente</span></div>
      </div>
      <div class="method-copy">
        <span>CÓMO TRABAJAMOS</span>
        <h2 id="method-title">Podés revisar de dónde sale cada número.</h2>
        <p>No escondemos supuestos. Cada respuesta identifica la fórmula o norma, cita fuentes primarias cuando existen y muestra la fecha de vigencia.</p>
        <a href="/metodologia">Conocer nuestra metodología <b>→</b></a>
      </div>
    </section>

    <section class="world">
      <div class="wrap world-grid">
        <div class="world-copy">
          <span>HECHO PARA CADA PAÍS</span>
          <h2>Estás en Argentina.<br />También sabemos las reglas de otros 13 mercados.</h2>
          <p>Cada país tiene sus propias preguntas, leyes y valores. No traducimos la experiencia argentina: construimos respuestas locales.</p>
        </div>
        <div class="country-grid">
          {countries.map(([href, flag, label]) => <a href={href}><span>{flag}</span><b>{label}</b><i>↗</i></a>)}
        </div>
      </div>
    </section>

    <section class="directory wrap" aria-labelledby="directory-title">
      <div><span>TODAS LAS ÁREAS</span><h2 id="directory-title">Hay una respuesta para cada cuenta.</h2></div>
      <nav aria-label="Áreas de Hacé Cuentas">
        {silos.map(([href, label]) => <a href={href}>{label}<span>↗</span></a>)}
      </nav>
    </section>
  </div>

  <Footer slot="footer" />
  <ScrollToTop />

  <script is:inline define:vars={{ searchItems: uniqueSearchItems }}>
    (() => {
      const form = document.getElementById('hub-search');
      const input = document.getElementById('home-query');
      const results = document.getElementById('hub-results');
      if (!form || !input || !results) return;
      const normalize = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const render = () => {
        const query = normalize(input.value).trim();
        if (query.length < 2) {
          results.hidden = true; results.innerHTML = ''; input.setAttribute('aria-expanded', 'false'); return [];
        }
        const terms = query.split(/\s+/);
        const matches = searchItems.filter((item) => {
          const text = normalize(item.label + ' ' + item.group);
          return terms.every((term) => text.includes(term));
        }).slice(0, 6);
        results.innerHTML = matches.map((item) => `<a href="${item.href}"><span>${item.group}</span><b>${item.label}</b><i>→</i></a>`).join('');
        results.hidden = matches.length === 0;
        input.setAttribute('aria-expanded', matches.length ? 'true' : 'false');
        return matches;
      };
      input.addEventListener('input', render);
      input.addEventListener('focus', render);
      document.addEventListener('click', (event) => {
        if (!form.contains(event.target)) { results.hidden = true; input.setAttribute('aria-expanded', 'false'); }
      });
      form.addEventListener('submit', (event) => {
        const matches = render();
        if (matches.length) { event.preventDefault(); window.location.href = matches[0].href; }
      });
    })();
  </script>
</Layout>

<style>
  :global(body[data-page-type="home"]) { background: #fff; color: #182238; }
  :global(body[data-page-type="home"] > main#main) { width: 100%; max-width: none; margin: 0; padding: 0; overflow: clip; }
  .hc-home { --navy:#174B7A; --blue:#477df4; --mint:#45bd88; --coral:#f47c63; --yellow:#f4c551; --paper:#f8f9fc; --line:#e4e8ef; }
  .wrap, .hero { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  h1,h2,h3,p { margin-top: 0; }
  a { color: inherit; }

  .hero { display:block; min-height:0; padding:84px 0 92px; }
  .hero-copy { max-width:900px; }
  .hero-label, .section-title span, .method-copy>span, .world-copy>span, .directory>div>span { color:#5a6d89; font-size:11px; font-weight:800; letter-spacing:.13em; }
  .hero h1 { margin:20px 0 24px; color:var(--navy); font-size:clamp(58px,6.3vw,86px); line-height:.93; letter-spacing:-.07em; }
  .hero h1 em { color:var(--blue); font-style:normal; }
  .hero-copy>p { max-width:720px; color:#68758a; font-size:18px; line-height:1.65; }
  .search { position:relative; z-index:5; max-width:790px; margin-top:30px; }
  .search label { display:block; margin-bottom:9px; color:#34445c; font-size:13px; font-weight:700; }
  .search-box { display:grid; grid-template-columns:24px 1fr auto; align-items:center; gap:10px; padding:7px 7px 7px 17px; border:1px solid #dfe4eb; border-radius:14px; background:#fff; box-shadow:0 14px 36px rgba(34,52,80,.1); }
  .search-box svg { width:22px; fill:none; stroke:#738198; stroke-width:2; }
  .search-box input { min-width:0; height:50px; border:0; outline:0; background:transparent; color:var(--navy); font:inherit; }
  .search-box button { min-height:50px; padding:0 18px; border:0; border-radius:10px; background:var(--navy); color:#fff; font:inherit; font-size:13px; font-weight:750; cursor:pointer; }
  .search-box button:hover { background:var(--blue); }
  .search-results { position:absolute; inset:calc(100% + 8px) 0 auto; padding:7px; border:1px solid var(--line); border-radius:12px; background:#fff; box-shadow:0 16px 36px rgba(28,46,75,.16); }
  .search-results :global(a) { display:grid; grid-template-columns:1fr auto; padding:10px 12px; border-radius:8px; text-decoration:none; }
  .search-results :global(a:hover) { background:#f3f6fb; }
  .search-results :global(span) { grid-column:1; color:#8590a0; font-size:10px; text-transform:uppercase; }
  .search-results :global(b) { grid-column:1; }
  .search-results :global(i) { grid-column:2; grid-row:1/3; align-self:center; font-style:normal; }
  .hero-trust { display:flex; flex-wrap:wrap; gap:18px; margin-top:21px; color:#69768a; font-size:12px; }
  .hero-trust span { display:flex; align-items:center; gap:7px; }
  .hero-trust i { display:grid; place-items:center; width:25px; height:25px; border-radius:50%; background:#eaf9f3; color:var(--mint); font-style:normal; font-weight:800; }

  .popular { padding:88px 0 102px; }
  .section-title { display:grid; grid-template-columns:1.2fr .8fr; gap:80px; align-items:end; margin-bottom:36px; }
  .section-title h2, .method-copy h2, .world-copy h2, .directory h2 { margin:11px 0 0; color:var(--navy); font-size:clamp(38px,4vw,56px); line-height:1.04; letter-spacing:-.05em; }
  .section-title>p { margin:0; color:#708096; line-height:1.6; }
  .popular-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  .popular-card { position:relative; display:grid; grid-template-columns:52px 1fr; gap:15px; min-height:196px; padding:22px; border:1px solid var(--line); border-radius:18px; background:#fff; text-decoration:none; transition:.2s ease; }
  .popular-card:hover { transform:translateY(-4px); box-shadow:0 16px 32px rgba(31,50,79,.09); }
  .popular-icon { display:grid; place-items:center; width:48px; height:48px; border-radius:15px; font-size:22px; font-weight:800; }
  .popular-card--mint .popular-icon { background:#dff7ec; color:#26a770; }.popular-card--yellow .popular-icon { background:#fff0bd; color:#aa7500; }
  .popular-card--blue .popular-icon { background:#e4edff; color:#477df4; }.popular-card--coral .popular-icon { background:#ffe5df; color:#df6048; }
  .popular-card--lilac .popular-icon { background:#efe7ff; color:#815bc5; }.popular-card--navy .popular-icon { background:#e8ecf2; color:#263854; }
  .popular-card span { color:#7b8798; font-size:10px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .popular-card h3 { margin:8px 0 7px; color:var(--navy); font-size:20px; line-height:1.18; letter-spacing:-.025em; }
  .popular-card p { margin:0; color:#778398; font-size:13px; line-height:1.45; }
  .popular-card>b { position:absolute; right:17px; bottom:15px; color:#9da8b7; }

  .moments { padding:94px 0 104px; background:#17243b; }
  .section-title--light span { color:#8fdcb9; }.section-title--light h2 { color:#fff; }.section-title--light>p { color:#aeb9c9; }
  .moment-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:14px; }
  .moment-card { position:relative; grid-column:span 2; min-height:370px; display:flex; flex-direction:column; padding:24px; overflow:hidden; border-radius:20px; }
  .moment-card:nth-child(1),.moment-card:nth-child(2) { grid-column:span 3; }
  .moment-card--work { background:#dce8ff; }.moment-card--home-life { background:#ffefb9; }.moment-card--health { background:#dff7ec; }
  .moment-card--money { background:#ffe1da; }.moment-card--car { background:#eee5ff; }
  .moment-card::after { content:""; position:absolute; width:160px; height:160px; right:-70px; top:-70px; border:30px solid rgba(255,255,255,.35); border-radius:50%; }
  .moment-number { position:relative; z-index:1; color:#55657c; font:700 12px "JetBrains Mono",monospace; }
  .moment-card h3 { position:relative; z-index:1; max-width:85%; margin:44px 0 10px; color:var(--navy); font-size:27px; line-height:1.05; letter-spacing:-.035em; }
  .moment-card>p { position:relative; z-index:1; color:#53647b; font-size:13px; line-height:1.5; }
  .moment-card ul { position:relative; z-index:1; list-style:none; padding:0; margin:14px 0 20px; }
  .moment-card li a { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid rgba(24,34,56,.13); color:#32445e; font-size:12px; text-decoration:none; }
  .moment-cta { position:relative; z-index:1; display:flex; justify-content:space-between; margin-top:auto; padding:12px 13px; border-radius:10px; background:rgba(255,255,255,.58); color:var(--navy); font-size:12px; font-weight:800; text-decoration:none; }

  .fresh { padding:96px 0; }
  .fresh-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
  .fresh-card { min-height:230px; display:flex; flex-direction:column; padding:22px; border-radius:18px; text-decoration:none; }
  .fresh-card--green { background:#dff7ec; }.fresh-card--blue { background:#dfe9ff; }.fresh-card--yellow { background:#fff0bd; }.fresh-card--coral { background:#ffe1da; }
  .fresh-card>span { width:max-content; padding:5px 8px; border-radius:999px; background:rgba(255,255,255,.6); color:#52637a; font-size:9px; font-weight:900; letter-spacing:.1em; }
  .fresh-card h3 { margin:34px 0 8px; color:var(--navy); font-size:23px; line-height:1.1; }
  .fresh-card p { color:#5f6f84; font-size:13px; line-height:1.45; }
  .fresh-card b { margin-top:auto; color:#31445f; font-size:12px; }

  .method { display:grid; grid-template-columns:1.05fr .95fr; gap:80px; align-items:center; padding:80px; margin-bottom:100px; overflow:hidden; border-radius:28px; background:#eef4ff; }
  .method-visual { position:relative; min-height:370px; }
  .method-ring { position:absolute; inset:15px auto auto 15px; width:230px; height:230px; display:grid; place-items:center; border:40px solid #cadcff; border-radius:50%; }
  .method-ring span { display:grid; place-items:center; width:84px; height:84px; border-radius:50%; background:var(--blue); color:#fff; font-size:45px; }
  .method-card { position:absolute; width:185px; padding:16px; border-radius:14px; background:#fff; box-shadow:0 16px 30px rgba(39,65,104,.11); }
  .method-card--a { top:0; right:10px; }.method-card--b { right:55px; top:137px; }.method-card--c { left:80px; bottom:0; }
