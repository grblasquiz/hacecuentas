  <!-- Prefetch inteligente: en requestIdleCallback (no interfiere con render crítico)
       precargamos el HTML de las 6 calcs más visitadas. Si el user clickea una,
       carga instantánea desde cache. No usamos prefetchAll de Astro porque eso
       dispararía cientos de requests inútiles. -->
  <!-- Próximo feriado 2026 — texto en el tile de feriados. Lo calculamos
       client-side porque la fecha "hoy" es dinámica (cambia cada día).
       La lista viene de la FUENTE ÚNICA feriados-ar-2026.ts vía define:vars. -->
  <script is:inline define:vars={{ FERIADOS_DATA }}>
    (function () {
      var FERIADOS = FERIADOS_DATA;
      var el = document.getElementById('proxi-feriado');
      if (!el) return;
      var hoy = new Date(); hoy.setHours(0,0,0,0);
      var prox = FERIADOS.map(function(f){
        var d = new Date(f[0]+'T00:00:00');
        return { d: d, n: f[1], diff: Math.ceil((d-hoy)/86400000) };
      }).filter(function(x){ return x.diff >= 0; });
      if (prox.length === 0) { el.textContent = 'Último feriado del año ya pasó'; return; }
      var p = prox[0];
      var dow = ['dom','lun','mar','mié','jue','vie','sáb'][p.d.getDay()];
      var dia = p.d.getDate();
      var mes = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'][p.d.getMonth()];
      var txt = 'Próximo: ' + p.n + ' (' + dow + ' ' + dia + ' ' + mes;
      if (p.diff === 0) txt += ' — HOY)';
      else if (p.diff === 1) txt += ' — mañana)';
      else txt += ' — en ' + p.diff + ' días)';
      el.textContent = txt;
    })();
  </script>

  <!-- Franja "Tus calculadoras": lee localStorage 'hc_favs' (contrato {s,t,l,d})
       y muestra hasta 8 cards. Render 100% DOM API (textContent escapa el título;
       nunca innerHTML con datos del storage). Si no hay favs o storage falla,
       la sección queda display:none. Re-corre en astro:page-load (retorno SPA),
       mismo patrón que el resto de los scripts del home. -->
  <script is:inline>
    (function () {
      var KEY = 'hc_favs';
      var LANGS = { '': 1, en: 1, pt: 1, mx: 1, es: 1, co: 1, cl: 1, pe: 1, ec: 1 };

      function validFav(f) {
        return !!f &&
          typeof f.s === 'string' && /^[a-z0-9][a-z0-9-]*$/i.test(f.s) &&
          typeof f.l === 'string' && LANGS[f.l] === 1;
      }

      function readFavs() {
        try {
          var raw = localStorage.getItem(KEY);
          if (!raw) return [];
          var arr = JSON.parse(raw);
          if (!Array.isArray(arr)) return [];
          return arr.filter(validFav);
        } catch (e) { return []; }
      }

      // Quita un fav re-leyendo el array CRUDO y filtrando sólo el match (s,l):
      // preserva intactos ítems de otros agentes aunque no pasen validFav.
      function removeFav(s, l) {
        try {
          var raw = localStorage.getItem(KEY);
          var arr = raw ? JSON.parse(raw) : [];
          if (!Array.isArray(arr)) return;
          var next = arr.filter(function (f) {
            return !(f && f.s === s && (typeof f.l === 'string' ? f.l : '') === l);
          });
          localStorage.setItem(KEY, JSON.stringify(next));
        } catch (e) {}
      }

      function render() {
        var strip = document.getElementById('fav-strip');
        var grid = document.getElementById('fav-strip-grid');
        if (!strip || !grid) return; // no estamos en el home
        var favs = readFavs();
        if (favs.length === 0) { strip.style.display = 'none'; return; }
        while (grid.firstChild) grid.removeChild(grid.firstChild);
        // FIFO en storage (más nuevo al final) → mostramos los más recientes primero.
        favs.slice().reverse().slice(0, 8).forEach(function (f) {
          var url = (f.l ? '/' + f.l : '') + '/' + f.s;
          var card = document.createElement('div');
          card.className = 'fav-card';
          var a = document.createElement('a');
          a.className = 'fav-link';
          a.href = url;
          a.textContent = (typeof f.t === 'string' && f.t) ? f.t : f.s.replace(/-/g, ' ');
          a.addEventListener('click', function () {
            try {
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'fav_open', { calc_slug: f.s });
              }
            } catch (e) {}
          });
          var rm = document.createElement('button');
          rm.type = 'button';
          rm.className = 'fav-remove';
          rm.setAttribute('aria-label', 'Quitar ' + ((typeof f.t === 'string' && f.t) ? f.t : f.s) + ' de tus calculadoras');
          rm.textContent = '×';
          rm.addEventListener('click', function (ev) {
            ev.preventDefault();
            ev.stopPropagation();
            removeFav(f.s, f.l);
            render();
          });
          card.appendChild(a);
          card.appendChild(rm);
          grid.appendChild(card);
        });
        strip.style.display = '';
      }

      if (!window.__hcFavStrip) {
        window.__hcFavStrip = true;
        document.addEventListener('astro:page-load', render);
      }
      render();
    })();
  </script>

  <script is:inline>
    (function () {
      var topUrls = [
        '/sueldo-en-mano-argentina',
        '/calculadora-aguinaldo-sac',
        '/calculadora-imc',
        '/calculadora-interes-compuesto',
        '/calculadora-porcentajes',
        '/calculadora-plazo-fijo',
      ];
      function schedule(cb) {
        if ('requestIdleCallback' in window) window.requestIdleCallback(cb, { timeout: 3000 });
        else setTimeout(cb, 2000);
      }
      function prefetch(url) {
        try {
          var l = document.createElement('link');
          l.rel = 'prefetch'; l.href = url; l.as = 'document';
          document.head.appendChild(l);
        } catch (e) {}
      }
      schedule(function () {
        // Save-Data o slow-2g: no prefetch
        var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (conn && (conn.saveData || /2g/.test(conn.effectiveType))) return;
        topUrls.forEach(prefetch);
      });
    })();
  </script>
</Layout>

<script is:inline>
  // Home: buscador hero (delegación) + contador vivo + placeholder rotativo.
  //
  // Astro ClientRouter swappea el body en cada navegación SPA. El bug original:
  // el script corría 1 sola vez → al VOLVER al home el #hero-search-btn nuevo
  // quedaba sin handler ("clickeo y no hace nada").
  //
  // OJO (verificado en prod 2026-06-04, browser real): requestIdleCallback queda
  // STARVED tras una navegación ClientRouter y NUNCA corre. Un primer intento que
  // re-ataba el botón en astro:page-load PERO vía requestIdleCallback no funcionó
  // por eso. astro:page-load SÍ dispara confiable; lo que no corre es el RIC.
  //
  // Solución robusta:
  //   [1] Buscador → DELEGACIÓN de click en `document` (persiste a todos los
  //       swaps; no depende de re-wire ni de requestIdleCallback).
  //   [2] Contador/placeholder → init DIRECTO (sin RIC) en astro:page-load.
  (function () {
    // [1] Buscador hero → modal del header (#open-search). Un solo listener en
    //     document capta el click sin importar cuántas veces ClientRouter
    //     reemplace el botón.
    if (!window.__hcHeroDeleg) {
      window.__hcHeroDeleg = true;
      document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest && e.target.closest('#hero-search-btn');
        if (btn) {
          var openBtn = document.getElementById('open-search');
          if (openBtn) openBtn.click();
        }
      });
    }

    // [2] Contador vivo + placeholder rotativo: se reinician en cada vista del
    //     home (carga inicial + retorno SPA). clearTimers evita acumular intervals.
    var timers = [];
    function clearTimers() { timers.forEach(function (t) { clearTimeout(t); }); timers = []; }
    function startHome() {
      if (!document.getElementById('hs-placeholder')) return; // sólo en el home
      clearTimers();

      // Contador vivo (+1 cada 2-8s). Base SSR → sin flash 0→target.
      var fmt = typeof Intl !== 'undefined'
        ? new Intl.NumberFormat('es-AR').format
        : function (n) { return String(n); };
      // El número se muestra estático (formateado). Se quitó el auto-incremento
      // aleatorio (Math.random cada 2-8s): un contador que sube solo en vivo es
      // prueba social fabricada y choca con el pitch "fórmulas oficiales" + la
      // re-alta de AdSense. Pendiente (decisión del dueño): alimentarlo con el
      // dato real de eventos GA4 en cada build, o pasar a copy no cuantitativo.
      document.querySelectorAll('[data-live-counter]').forEach(function (el) {
        var current = parseInt(el.getAttribute('data-initial'), 10) || 0;
        el.textContent = fmt(current);
      });

      // Placeholder rotativo del buscador.
      var ph = document.getElementById('hs-placeholder');
      var phrases = [
        'Calcular sueldo en mano...',
        '¿Cuántas calorías quemo?...',
        'Cuota de préstamo...',
        'Calcular aguinaldo...',
        'Convertir tazas a gramos...',
        'Calcular IMC...',
        'Margen de ganancia...',
      ];
      var idx = 0;
      timers.push(setInterval(function () {
        idx = (idx + 1) % phrases.length;
        ph.style.opacity = '0';
        setTimeout(function () {
          ph.textContent = phrases[idx];
          ph.style.opacity = '1';
        }, 200);
      }, 3000));
    }

    // astro:page-load corre en carga inicial Y tras cada navegación SPA (RIC no).
    if (!window.__hcHomeLifecycle) {
      window.__hcHomeLifecycle = true;
      document.addEventListener('astro:before-swap', clearTimers);
      document.addEventListener('astro:page-load', startHome);
    }
    startHome();
  })();
</script>

<script define:vars={{ countryCalcData }}>
  // [4] Country detection — "Para vos" section (deferred — no crítico)
  (window.requestIdleCallback || function (fn) { return setTimeout(fn, 1); })(function () {
    var COUNTRY_NAMES = { AR: 'Argentina', MX: 'México', CO: 'Colombia', PE: 'Perú' };
    var COUNTRY_FLAGS = { AR: '\u{1F1E6}\u{1F1F7}', MX: '\u{1F1F2}\u{1F1FD}', CO: '\u{1F1E8}\u{1F1F4}', PE: '\u{1F1F5}\u{1F1EA}' };
    var LANG_MAP = { 'es-AR': 'AR', 'es-MX': 'MX', 'es-CO': 'CO', 'es-PE': 'PE' };

    function detectCountry() {
      // 1. Check localStorage first
      try {
        var saved = localStorage.getItem('hc_country');
        if (saved && countryCalcData[saved]) return saved;
      } catch (e) {}

      // 2. navigator.language / navigator.languages
      var langs = [];
      try {
        if (navigator.languages && navigator.languages.length) {
          langs = [].slice.call(navigator.languages);
        } else if (navigator.language) {
          langs = [navigator.language];
        }
      } catch (e) {}

      for (var i = 0; i < langs.length; i++) {
        var code = LANG_MAP[langs[i]];
        if (code) return code;
      }

      return null;
    }

    function renderSection(country) {
      var section = document.getElementById('para-vos-section');
      var grid = document.getElementById('pv-grid');
      var flag = document.getElementById('pv-flag');
      var name = document.getElementById('pv-country-name');
      if (!section || !grid || !country) return;

      var calcsData = countryCalcData[country];
      if (!calcsData || !calcsData.length) return;

      // Set heading
      if (flag) flag.textContent = COUNTRY_FLAGS[country] || '';
      if (name) name.textContent = COUNTRY_NAMES[country] || 'tu país';

      // Render cards
      grid.innerHTML = calcsData.map(function (c) {
        return '<a href="/' + c.slug + '" class="pv-card">' +
          '<span class="pv-icon" aria-hidden="true">' + c.icon + '</span>' +
          '<span class="pv-title">' + c.h1 + '</span>' +
          '</a>';
      }).join('');

      section.style.display = '';

      // Save to localStorage
      try { localStorage.setItem('hc_country', country); } catch (e) {}
    }

    var detected = detectCountry();
    if (detected) {
      renderSection(detected);
    }
  });
</script>

