---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Newsletter from '../../components/Newsletter.astro';
import { TOTAL_DISPLAY, TOTAL_PLAIN } from '../../lib/calc-counts';
import { VERTICALES } from '../../lib/partners/verticales';

const title = 'Partner Studio — Calculadoras white-label para medios y productos | Hacé Cuentas';
const description =
  `Convertí cualquiera de las ${TOTAL_PLAIN} calculadoras de Hacé Cuentas en un widget propio: tu color, tu logo, tus textos, datos precargados y eventos para tu sistema. Un solo web component <hace-cuentas>.`;

const ORIGIN = 'https://hacecuentas.com';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${ORIGIN}/partners#webpage`,
  name: title,
  description,
  url: `${ORIGIN}/partners`,
  inLanguage: ['es', 'es-AR', 'es-419'],
  isPartOf: { '@type': 'WebSite', name: 'Hacé Cuentas', url: ORIGIN },
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: ORIGIN,
    logo: `${ORIGIN}/favicon.svg`,
  },
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${ORIGIN}/` },
    { '@type': 'ListItem', position: 2, name: 'Partner Studio', item: `${ORIGIN}/partners` },
  ],
};

// Calcs disponibles en el generador (las que tienen /embed/<slug>, es decir AR).
const generatorCalcs = [
  { slug: 'calculadora-sueldo-en-mano-argentina', name: 'Sueldo en mano' },
  { slug: 'calculadora-aguinaldo-sac', name: 'Aguinaldo (SAC)' },
  { slug: 'calculadora-monotributo-categoria', name: 'Categoría de monotributo' },
  { slug: 'calculadora-impuesto-ganancias-sueldo', name: 'Impuesto a las Ganancias' },
  { slug: 'calculadora-indemnizacion-despido', name: 'Indemnización por despido' },
  { slug: 'calculadora-plazo-fijo', name: 'Plazo fijo' },
  { slug: 'calculadora-interes-compuesto', name: 'Interés compuesto' },
  { slug: 'calculadora-cuota-prestamo', name: 'Cuota de préstamo' },
  { slug: 'calculadora-iva-agregar-discriminar', name: 'IVA' },
  { slug: 'calculadora-porcentajes', name: 'Porcentajes' },
  { slug: 'calculadora-imc', name: 'IMC' },
  { slug: 'dias-entre-dos-fechas', name: 'Días entre fechas' },
];

const capabilities = [
  { icon: '🎨', title: 'Tu marca', desc: 'Color de acento, logo y textos propios. La calculadora se ve como parte de tu sitio, no como un widget pegado.' },
  { icon: '🧮', title: 'Datos precargados', desc: 'Llegá con campos ya completos (sueldo, monto, categoría) y resultado calculado al instante. Ideal para notas y landings.' },
  { icon: '🌎', title: 'País y moneda', desc: 'Indicá el país y la calculadora usa la moneda y las reglas correctas.' },
  { icon: '🔔', title: 'Eventos', desc: 'onCalculate, onShare y onComplete como eventos DOM nativos. Conectá tu analytics o tu sistema sin tocar el iframe.' },
  { icon: '🔗', title: 'CTA propio', desc: 'Un botón con tu copy y tu URL aparece debajo del resultado. El cálculo termina en tu embudo, no en el nuestro.' },
  { icon: '📐', title: 'Auto-resize', desc: 'El alto se ajusta solo al contenido. Responsive, sin saltos, sin scroll interno.' },
  { icon: '🔒', title: 'Cálculo local', desc: 'Los datos del usuario nunca salen de su navegador. Privacidad total, sin backend que mantener.' },
  { icon: '♻️', title: 'Siempre actualizado', desc: 'Cuando cambia una ley o un valor (Ganancias, ICL, monotributo) tu widget se actualiza solo. Vos no hacés nada.' },
];

const events = [
  { name: 'hc:ready', when: 'El iframe cargó y la calculadora está lista.', detail: '{ slug }' },
  { name: 'hc:calculate', when: 'El usuario tocó "Calcular" y hay resultado.', detail: '{ primary, slug }' },
  { name: 'hc:share', when: 'El usuario compartió o copió el resultado.', detail: '{ action }' },
  { name: 'hc:complete', when: 'El usuario tocó el CTA del partner.', detail: '{ cta }' },
];

const faqs = [
  {
    q: '¿En qué se diferencia del iframe de /embeber?',
    a: 'El iframe es "copiá y pegá este código". El web component <hace-cuentas> es un producto de distribución: además de embeber, te deja personalizar marca, precargar datos, recibir eventos en tu sistema y poner tu propio CTA. Mismo motor, mucho más control.',
  },
  {
    q: '¿Cómo lo instalo?',
    a: 'Pegás una sola vez el script <script async src="https://hacecuentas.com/hc.js"></script> y después usás el tag <hace-cuentas calculator="..."> tantas veces como quieras, en cualquier página. Funciona en HTML plano, WordPress, React, Vue o cualquier framework.',
  },
  {
    q: '¿Puedo cambiar los colores y poner mi logo?',
    a: 'Sí. Con accent="#tucolor" cambiás el color de acento de toda la calculadora, y con logo="https://tusitio.com/logo.svg" aparece tu logo en el encabezado. También podés cambiar el título con title="...".',
  },
  {
    q: '¿Puedo recibir un aviso cuando el usuario calcula?',
    a: 'Sí. El elemento emite eventos DOM (hc:calculate, hc:share, hc:complete) que escuchás con addEventListener. Llega el resultado principal en el detail del evento, listo para mandarlo a tu analytics o tu CRM.',
  },
  {
    q: '¿Puedo precargar datos en la calculadora?',
    a: 'Sí, con el atributo prefill=\'{"campo":"valor"}\'. Si todos los campos requeridos quedan completos, la calculadora calcula sola al cargar. Perfecto para notas tipo "con un sueldo de $X, esto te queda en mano".',
  },
  {
    q: '¿Tengo que dejar el enlace "Powered by Hacé Cuentas"?',
    a: 'Sí, por defecto sí: el crédito va en tu página (es un backlink real) y mantenerlo es lo que hace que el producto sea gratis. Los partners con plan pueden ocultarlo (modo sin atribución), validado por dominio autorizado.',
  },
  {
    q: '¿Necesito una API key o registrarme?',
    a: 'Para el uso estándar (con atribución), no: pegás el script y listo. El partner-id y la config sólo hacen falta para funciones avanzadas como el modo sin atribución o temas por defecto.',
  },
  {
    q: '¿Funciona en React / Next / Vue?',
    a: 'Sí. Los web components son estándar del navegador, así que <hace-cuentas> funciona como cualquier etiqueta HTML. En React, pasá los atributos como strings; los eventos los escuchás con un ref y addEventListener.',
  },
  {
    q: '¿Qué calculadoras puedo usar?',
    a: `Las ${TOTAL_DISPLAY} calculadoras de Hacé Cuentas. Pasás el slug de la calc (el que ves en la URL, ej. calculadora-sueldo-en-mano-argentina) en el atributo calculator.`,
  },
];

// Snippet de ejemplo (medio) para la sección de código.
const exampleSnippet = `<script async src="https://hacecuentas.com/hc.js"><\/script>

<hace-cuentas
  calculator="calculadora-sueldo-en-mano-argentina"
  accent="#d2122e"
  logo="https://tu-medio.com/logo.svg"
  title="Calculá tu sueldo en mano"
  cta-label="Más notas de economía"
  cta-url="https://tu-medio.com/economia"
  partner-id="tu-medio">
</hace-cuentas>

<script>
  document.querySelector('hace-cuentas')
    .addEventListener('hc:calculate', function (e) {
      // e.detail.primary = resultado principal
      gtag('event', 'calc_done', { value: e.detail.primary });
    });
<\/script>`;
---

<Layout title={title} description={description} schema={schema}>
  <Header slot="header" />

  <article class="partners-page">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <a href="/embeber">Embeber</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Partner Studio</span>
    </nav>

    <!-- 1. HERO -->
    <header class="hero">
      <div class="hero__badge">Partner Studio</div>
      <h1>Las calculadoras de Hacé Cuentas,<br />con tu marca</h1>
      <p class="hero__sub">
        Un solo web component <code>&lt;hace-cuentas&gt;</code>: tu color, tu logo,
        tus textos, datos precargados y eventos para tu sistema. De "código para
        copiar" a producto de distribución.
      </p>
      <div class="hero__cta">
        <a href="#generador" class="btn-primary">Probar el generador <span aria-hidden="true">→</span></a>
        <a href="#docs" class="btn-ghost">Ver documentación</a>
      </div>
    </header>

    <!-- 2. GROWTH LOOP -->
    <section class="loop-section" aria-labelledby="loop-heading">
      <h2 id="loop-heading">El loop de crecimiento</h2>
      <p class="section-intro">Cada partner que distribuye nuestras calculadoras hace mejor a todo el sistema:</p>
      <ol class="loop">
        <li><span class="loop__dot">+</span> Más partners</li>
        <li><span class="loop__dot">→</span> Más cálculos fuera de hacecuentas.com</li>
        <li><span class="loop__dot">→</span> Más atribución y reconocimiento</li>
        <li><span class="loop__dot">→</span> Más datos de uso</li>
        <li><span class="loop__dot">→</span> Mejores herramientas</li>
        <li><span class="loop__dot">↺</span> Y más partners</li>
      </ol>
    </section>

    <!-- 3. CAPABILITIES -->
    <section class="caps-section" aria-labelledby="caps-heading">
      <h2 id="caps-heading">Todo lo que podés controlar</h2>
      <div class="caps-grid">
        {capabilities.map((c) => (
          <div class="cap-card">
            <span class="cap-icon" aria-hidden="true">{c.icon}</span>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 3b. SOLUCIONES POR RUBRO -->
    <section class="verticals-section" aria-labelledby="verticals-heading">
      <h2 id="verticals-heading">Soluciones por rubro</h2>
      <p class="section-intro">Calculadoras elegidas para tu tipo de sitio, con el código listo y casos de uso concretos.</p>
      <div class="verticals-grid">
        {VERTICALES.map((v) => (
          <a class="vertical-card" href={`/partners/${v.slug}`}>
            <span class="vertical-card__icon" aria-hidden="true">{v.icon}</span>
            <span class="vertical-card__name">{v.nombre}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 4. GENERADOR INTERACTIVO -->
    <section id="generador" class="gen-section" aria-labelledby="gen-heading">
      <h2 id="gen-heading">Generá tu widget</h2>
      <p class="section-intro">Configurá, mirá la vista previa en vivo y copiá el código.</p>

      <div class="gen-grid">
        <!-- Controles -->
        <form class="gen-controls" id="gen-form" autocomplete="off">
          <label class="gen-field">
            <span>Calculadora</span>
            <select id="gen-calc">
              {generatorCalcs.map((c) => <option value={c.slug}>{c.name}</option>)}
            </select>
          </label>

          <label class="gen-field">
            <span>Color de acento</span>
            <span class="gen-color-row">
              <input type="color" id="gen-accent" value="#2563eb" />
              <input type="text" id="gen-accent-hex" value="#2563eb" maxlength="7" spellcheck="false" />
            </span>
          </label>

          <label class="gen-field">
            <span>Título (opcional)</span>
            <input type="text" id="gen-title" placeholder="Ej. Calculá tu sueldo en mano" />
          </label>

          <label class="gen-field">
            <span>Logo URL (opcional, https)</span>
            <input type="url" id="gen-logo" placeholder="https://tu-sitio.com/logo.svg" />
          </label>

          <div class="gen-field gen-field--split">
            <label>
              <span>CTA — texto</span>
              <input type="text" id="gen-cta-label" placeholder="Más notas" />
            </label>
            <label>
              <span>CTA — URL</span>
              <input type="url" id="gen-cta-url" placeholder="https://tu-sitio.com/..." />
            </label>
          </div>

          <label class="gen-field gen-field--check" title="Disponible con plan de partner">
            <input type="checkbox" id="gen-noattr" disabled />
            <span>Ocultar atribución <em>(requiere plan de partner)</em></span>
          </label>
        </form>

        <!-- Vista previa en vivo -->
        <div class="gen-preview">
          <span class="gen-preview__label">Vista previa en vivo</span>
          <hace-cuentas id="hc-preview" calculator="calculadora-sueldo-en-mano-argentina" accent="#2563eb"></hace-cuentas>
        </div>
      </div>

      <!-- Snippet -->
      <div class="code-block-wrapper">
        <div class="code-block-header">
          <span class="code-block-label">Tu código</span>
          <button class="btn-copy" id="gen-copy" type="button" aria-label="Copiar código">Copiar código</button>
        </div>
        <pre class="code-block"><code id="gen-snippet"></code></pre>
      </div>
    </section>

    <!-- 5. DOCS: instalación + ejemplo -->
    <section id="docs" class="docs-section" aria-labelledby="docs-heading">
      <h2 id="docs-heading">Cómo se ve en tu sitio</h2>
      <p class="section-intro">Pegás el script una vez. Después, el tag las veces que quieras.</p>
      <div class="code-block-wrapper">
        <div class="code-block-header">
          <span class="code-block-label">Ejemplo completo (medio)</span>
          <button class="btn-copy" type="button" data-code={exampleSnippet} aria-label="Copiar ejemplo">Copiar</button>
        </div>
        <pre class="code-block"><code>{exampleSnippet}</code></pre>
      </div>
    </section>

    <!-- 6. EVENTOS -->
    <section class="events-section" aria-labelledby="events-heading">
      <h2 id="events-heading">Eventos</h2>
      <p class="section-intro">El elemento emite eventos DOM nativos. Escuchalos con <code>addEventListener</code>.</p>
      <div class="events-table-wrap">
        <table class="events-table">
          <thead>
            <tr><th>Evento</th><th>Cuándo</th><th>detail</th></tr>
          </thead>
          <tbody>
            {events.map((e) => (
              <tr>
                <td><code>{e.name}</code></td>
                <td>{e.when}</td>
                <td><code>{e.detail}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 7. ATRIBUCIÓN / PLANES -->
    <section class="attribution-section" aria-labelledby="attr-heading">
      <div class="attribution-inner">
        <div class="attribution-icon" aria-hidden="true">🤝</div>
        <h2 id="attr-heading">Gratis con atribución</h2>
        <p>
          El uso estándar es <strong>gratis</strong>: solo mantené visible el enlace
          <strong>"Powered by Hacé Cuentas"</strong> que aparece debajo del widget en tu
          página. Ese backlink es lo que sostiene el proyecto.
        </p>
        <p class="attribution-reason">
          ¿Sos un medio o un producto y necesitás modo sin atribución, tema por defecto
          o dominios autorizados? Eso es el plan de partner: escribinos desde
          <a href="/contacto">contacto</a> y te damos un <code>partner-id</code>.
        </p>
      </div>
    </section>

    <!-- 8. FAQ -->
    <section class="faq-section" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Preguntas frecuentes</h2>
      <dl class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-q">
              <span>{item.q}</span>
              <span class="faq-chevron" aria-hidden="true">›</span>
            </summary>
            <dd class="faq-a"><p>{item.a}</p></dd>
          </details>
        ))}
      </dl>
    </section>

    <!-- 9. FINAL CTA -->
    <section class="cta-final" aria-labelledby="cta-heading">
      <h2 id="cta-heading">Listo para distribuir</h2>
      <p>¿Solo querés el iframe simple sin personalización? También está disponible.</p>
      <div class="hero__cta">
        <a href="#generador" class="btn-primary btn-primary--large">Generar mi widget <span aria-hidden="true">→</span></a>
        <a href="/embeber" class="btn-ghost">Embeber simple (iframe) →</a>
      </div>
    </section>

    <Newsletter />
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)}></script>
  <script is:inline async src="/hc.js"></script>

  <script>
  // ── Generador interactivo ──────────────────────────────────────────────
  function byId<T extends HTMLElement = HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  const calcSel = byId<HTMLSelectElement>('gen-calc');
  const accent = byId<HTMLInputElement>('gen-accent');
  const accentHex = byId<HTMLInputElement>('gen-accent-hex');
  const titleInp = byId<HTMLInputElement>('gen-title');
  const logoInp = byId<HTMLInputElement>('gen-logo');
  const ctaLabel = byId<HTMLInputElement>('gen-cta-label');
  const ctaUrl = byId<HTMLInputElement>('gen-cta-url');
  const preview = document.getElementById('hc-preview');
  const snippet = byId<HTMLElement>('gen-snippet');

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function build() {
    if (!calcSel || !preview || !snippet) return;
    const slug = calcSel.value;
    const acc = (accentHex?.value || '#2563eb').trim();
    const title = titleInp?.value.trim() || '';
    const logo = logoInp?.value.trim() || '';
    const cLabel = ctaLabel?.value.trim() || '';
    const cUrl = ctaUrl?.value.trim() || '';

    // Actualizar la vista previa en vivo (el web component re-renderiza al cambiar atributos).
    preview.setAttribute('calculator', slug);
    if (/^#[0-9a-fA-F]{3,8}$/.test(acc)) preview.setAttribute('accent', acc);
    title ? preview.setAttribute('title', title) : preview.removeAttribute('title');
    logo && /^https:\/\//.test(logo) ? preview.setAttribute('logo', logo) : preview.removeAttribute('logo');
    if (cLabel && /^https:\/\//.test(cUrl)) {
      preview.setAttribute('cta-label', cLabel);
      preview.setAttribute('cta-url', cUrl);
    } else {
      preview.removeAttribute('cta-label');
      preview.removeAttribute('cta-url');
    }

    // Construir el snippet.
    const attrs: string[] = [`calculator="${esc(slug)}"`];
    if (/^#[0-9a-fA-F]{3,8}$/.test(acc)) attrs.push(`accent="${esc(acc)}"`);
    if (title) attrs.push(`title="${esc(title)}"`);
    if (logo && /^https:\/\//.test(logo)) attrs.push(`logo="${esc(logo)}"`);
    if (cLabel && /^https:\/\//.test(cUrl)) {
      attrs.push(`cta-label="${esc(cLabel)}"`);
      attrs.push(`cta-url="${esc(cUrl)}"`);
    }
    const tag = `<hace-cuentas\n  ${attrs.join('\n  ')}>\n</hace-cuentas>`;
    const code = `<script async src="https://hacecuentas.com/hc.js"><\/script>\n\n${tag}`;
    snippet.textContent = code;
  }

  // Sincronizar color picker ↔ hex.
  accent?.addEventListener('input', () => { if (accentHex) accentHex.value = accent.value; build(); });
  accentHex?.addEventListener('input', () => {
    const v = accentHex.value.trim();
    if (/^#[0-9a-fA-F]{6}$/.test(v) && accent) accent.value = v;
    build();
  });
  [calcSel, titleInp, logoInp, ctaLabel, ctaUrl].forEach((el) => {
    el?.addEventListener('input', build);
    el?.addEventListener('change', build);
  });

  build();

  // Demo: log de eventos del widget de preview (útil para que el partner vea que funciona).
  preview?.addEventListener('hc:calculate', (e) => {
    // eslint-disable-next-line no-console
    console.log('[Partner Studio demo] hc:calculate', (e as CustomEvent).detail);
  });

  // ── Copiar código (snippet del generador + ejemplos estáticos) ──────────
  function copyText(btn: HTMLButtonElement, text: string) {
    const done = () => {
      const orig = btn.textContent ?? '';
      btn.textContent = '¡Copiado!';
      btn.classList.add('btn-copy--success');
      setTimeout(() => { btn.textContent = orig; btn.classList.remove('btn-copy--success'); }, 2000);
    };
    navigator.clipboard.writeText(text).then(done).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch {}
      document.body.removeChild(ta); done();
    });
  }

  byId('gen-copy')?.addEventListener('click', () => {
    const b = byId('gen-copy') as HTMLButtonElement;
    copyText(b, snippet?.textContent ?? '');
  });
  document.querySelectorAll<HTMLButtonElement>('.btn-copy[data-code]').forEach((btn) => {
    btn.addEventListener('click', () => copyText(btn, btn.dataset.code ?? ''));
  });
</script>

  <Footer slot="footer" />
</Layout>

<style>
  .partners-page { max-width: 960px; margin: 1rem auto 2rem; padding: 0 1rem; }

  .breadcrumbs {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.875rem; color: var(--text-subtle); margin-bottom: 1.5rem; flex-wrap: wrap;
  }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }

  section { margin-bottom: 4rem; }
  section h2 { font-size: clamp(1.375rem, 3vw, 1.75rem); margin-bottom: 0.75rem; color: var(--text); }
  .section-intro { color: var(--text-muted); font-size: 0.9375rem; margin-bottom: 1.5rem; line-height: 1.6; }

  code { font-family: 'Fira Code', 'Cascadia Code', Consolas, monospace; font-size: 0.875em; }

  /* HERO */
  .hero { text-align: center; padding: 2.5rem 1rem 3rem; border-bottom: 1px solid var(--border); margin-bottom: 3rem; }
  .hero__badge {
    display: inline-block; background: var(--accent-subtle, #eff6ff); color: var(--accent);
    border: 1px solid var(--accent); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; padding: 0.25rem 0.75rem; border-radius: 999px; margin-bottom: 1.25rem;
  }
  .hero h1 { font-size: clamp(1.875rem, 5vw, 2.75rem); line-height: 1.15; margin-bottom: 1rem; }
  .hero h1 + .hero__sub, .hero__sub { font-size: 1.0625rem; color: var(--text-muted); max-width: 620px; margin: 0 auto 1.75rem; line-height: 1.6; }
  .hero__sub code { background: var(--bg-muted); padding: 0.1em 0.35em; border-radius: 5px; color: var(--accent); }
  .hero__cta { display: flex; gap: 0.75rem; justify-content: center; align-items: center; flex-wrap: wrap; }

  /* Botones */
  .btn-primary {
