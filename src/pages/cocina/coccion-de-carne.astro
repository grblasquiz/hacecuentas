---
/**
 * Hub de decisión — "¿Cuánto tiempo va esta carne?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cinco ramas (horno, termómetro, descongelado, marinado,
 * fritura). Todas las temperaturas internas salen de la MISMA tabla
 * (TEMPERATURAS + CORTES.tempFija) para que el hub no se contradiga como se
 * contradecían las calculadoras que reemplaza.
 *
 * El gráfico es posicional y cambia de eje según la rama: °C internos en horno
 * y termómetro, horas en descongelado y marinado, °C de aceite en fritura.
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import CoccionCarneExperience from '../../components/generated/CoccionCarneExperience.astro';
import {
  hub, CORTES, TEMPERATURAS, CARRYOVER, DESCONGELADO, MARINADO,
  FACTOR_GROSOR, FACTOR_MARINADA, PUNTO_HUMO, TEMP_FRITURA, MARGEN_MINIMO,
} from '../../lib/hubs/coccion-de-carne';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CoccionCarneExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

