---
/**
 * Hub de decisión — "¿Cuánto tiempo va esta carne?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cinco ramas (horno, termómetro, descongelado, marinado,
 * fritura). Todas las temperaturas internas salen de la MISMA tabla
 * (TEMPERATURAS + CORTES.tempFija) para que el hub no se contradiga como se
 * contradecían las calculadoras que reemplaza.
 *
 * El gráfico es posicional y cambia de eje según la rama: °C internos en horno
 * y termómetro, horas en descongelado y marinado, °C de aceite en fritura.
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub, CORTES, TEMPERATURAS, CARRYOVER, DESCONGELADO, MARINADO,
  FACTOR_GROSOR, FACTOR_MARINADA, PUNTO_HUMO, TEMP_FRITURA, MARGEN_MINIMO,
} from '../../lib/hubs/coccion-de-carne';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    CORTES, TEMPERATURAS, CARRYOVER, DESCONGELADO, MARINADO,
    FACTOR_GROSOR, FACTOR_MARINADA, PUNTO_HUMO, TEMP_FRITURA, MARGEN_MINIMO,
  }}
>
  (function () {
    const H = window.HC_HUB;

    const n1 = (x, d) => Number(x || 0).toLocaleString('es-AR', {
      minimumFractionDigits: d == null ? 0 : d,
      maximumFractionDigits: d == null ? 0 : d,
    });

    /** Franjas arbitrarias para el gráfico posicional de cada rama. */
    function segs(lista) {
      return lista.map((s) => ({ label: s[0], value: s[2] - s[1], from: s[1], to: s[2], tone: s[3] }));
    }
    /** Posición 0-100 de un valor dentro del rango de las franjas. */
    function pos(lista, valor) {
      const desde = lista[0][1];
      const hasta = lista[lista.length - 1][2];
      return Number(Math.min(100, Math.max(0, ((valor - desde) / (hasta - desde)) * 100)).toFixed(1));
    }

    /** Minutos a "2 h 15 min". */
    function hhmm(min) {
      const m = Math.round(min);
      if (m < 60) return m + ' min';
      const h = Math.floor(m / 60);
      const r = m % 60;
      return r > 0 ? h + ' h ' + r + ' min' : h + ' h';
    }

    /** Corte elegido y su tabla de temperatura interna. */
    function ctx(v) {
      const corte = CORTES[v.corte] || CORTES.pollo_entero;
      const t = TEMPERATURAS[corte.tipo] || TEMPERATURAS.vaca;
      const punto = ['jugoso', 'medio', 'bien'].indexOf(String(v.punto)) > -1 ? String(v.punto) : 'medio';
      // El corte manda sobre el tipo donde hay una razón (matambre, aves, picada).
      const objetivo = corte.tempFija != null && punto !== 'bien'
        ? corte.tempFija
        : (corte.tempFija != null ? Math.max(corte.tempFija, t[punto]) : t[punto]);
      return { corte, t, punto, objetivo };
    }

    const PUNTO_TXT = { jugoso: 'jugoso', medio: 'a punto', bien: 'bien cocido' };

    // Franjas de temperatura interna, comunes a horno y termómetro.
    const EJE_TEMP = [
      ['Crudo', 40, 52, 'bad'],
      ['Jugoso', 52, 60, 'warn'],
      ['A punto', 60, 68, 'good'],
      ['Bien cocido', 68, 80, 'main'],
      ['Muy cocido / colágeno', 80, 95, 'exit'],
    ];

    // ---------- RAMA 1: horno ----------
    function calcHorno(v) {
      const c = ctx(v);
      const peso = Math.max(0.05, Number(v.peso) || 1.5);
      const minPorKg = c.corte.minPorKg[c.punto] || c.corte.minPorKg.medio;
      const total = minPorKg * peso;
      const retirar = c.corte.tipo === 'pollo' ? c.objetivo : Math.max(45, c.objetivo - CARRYOVER);
      const control = total * 0.8;

      const rows = [
        { k: 'Tiempo total de horno', ref: c.corte.nombre, v: total, format: 'unit', unit: 'min', decimals: 0, extra: true },
        { k: 'Minutos por kilo', ref: 'punto ' + PUNTO_TXT[c.punto], v: minPorKg, format: 'unit', unit: 'min/kg', decimals: 0 },
        { k: 'Temperatura del horno', ref: c.corte.nombre, v: c.corte.tempHorno, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Temperatura interna objetivo', ref: c.t.nombre, v: c.objetivo, format: 'unit', unit: '°C', decimals: 0, extra: true },
        { k: 'Retirar del horno a', ref: 'sube ~' + CARRYOVER + ' °C en reposo', v: retirar, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Mínimo seguro USDA-FSIS', ref: c.t.nombre, v: c.t.minSeguro, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Empezá a medir a los', ref: '80% del tiempo estimado', v: control, format: 'unit', unit: 'min', decimals: 0 },
        { k: 'Reposo antes de cortar', ref: 'tapada con aluminio', v: c.corte.reposoMin, format: 'unit', unit: 'min', decimals: 0 },
      ];

      return {
        total: hhmm(total),
        sub:
          c.corte.nombre + ' de ' + n1(peso, 1) + ' kg ' + PUNTO_TXT[c.punto] + ': ' + hhmm(total) + ' a ' +
          c.corte.tempHorno + ' °C, retirando a ' + retirar + ' °C internos para llegar a ' + c.objetivo +
          ' °C tras el reposo · ' + c.corte.nota,
        rows: rows,
        chart: segs(EJE_TEMP),
        format: 'unit',
        unit: 'min',
        decimals: 0,
        position: pos(EJE_TEMP, c.objetivo),
        positionLabel:
          'Objetivo ' + c.objetivo + ' °C internos (' + PUNTO_TXT[c.punto] + ') · mínimo seguro ' +
          c.t.minSeguro + ' °C · ' + hhmm(total) + ' de horno',
      };
    }

    // ---------- RAMA 2: termómetro ----------
    function calcTermometro(v) {
      const c = ctx(v);
      const retirar = c.corte.tipo === 'pollo' ? c.objetivo : Math.max(45, c.objetivo - CARRYOVER);

      const rows = [
        { k: 'Temperatura interna objetivo', ref: PUNTO_TXT[c.punto], v: c.objetivo, format: 'unit', unit: '°C', decimals: 0, extra: true },
        { k: 'Retirar del fuego a', ref: 'cocción residual', v: retirar, format: 'unit', unit: '°C', decimals: 0, extra: true },
        { k: 'Mínimo seguro USDA-FSIS', ref: c.t.nombre, v: c.t.minSeguro, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Si la querés jugosa', ref: c.t.nombre, v: c.t.jugoso, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Si la querés a punto', ref: c.t.nombre, v: c.t.medio, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Si la querés bien cocida', ref: c.t.nombre, v: c.t.bien, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Cuánto sube durante el reposo', ref: 'pieza mediana', v: CARRYOVER, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Reposo antes de cortar', ref: 'tapada con aluminio', v: c.corte.reposoMin, format: 'unit', unit: 'min', decimals: 0 },
      ];

      const bajoMinimo = c.objetivo < c.t.minSeguro;

      return {
        total: c.objetivo + ' °C',
        sub:
          c.corte.nombre + ' ' + PUNTO_TXT[c.punto] + ': ' + c.objetivo + ' °C en el centro, retirando a ' +
          retirar + ' °C · ' + c.t.notaSeguridad +
          (bajoMinimo ? ' · atención: este punto queda por debajo del mínimo seguro de ' + c.t.minSeguro + ' °C' : ''),
        rows: rows,
        chart: segs(EJE_TEMP),
        format: 'unit',
        unit: '°C',
        decimals: 0,
        position: pos(EJE_TEMP, c.objetivo),
        positionLabel:
          c.objetivo + ' °C — ' + PUNTO_TXT[c.punto] + ' · mínimo seguro ' + c.t.minSeguro + ' °C',
      };
    }

    // ---------- RAMA 3: descongelado ----------
    function calcDescongelado(v) {
      const peso = Math.max(0.05, Number(v.peso) || 1.5);
      const clave = DESCONGELADO[v.metodoDescongelado] ? String(v.metodoDescongelado) : 'heladera';
      const m = DESCONGELADO[clave];
      const horas = m.horasPorKg * peso;

      const eje = [
        ['Microondas', 0, 1, 'warn'],
        ['Agua fría', 1, 6, 'main'],
        ['Heladera media', 6, 20, 'good'],
        ['Heladera pieza grande', 20, 48, 'exit'],
      ];

      const rows = [
        { k: 'Tiempo con el método elegido', ref: m.nombre, v: horas, format: 'unit', unit: 'h', decimals: 1, extra: true },
        { k: 'En minutos', ref: m.nombre, v: horas * 60, format: 'unit', unit: 'min', decimals: 0 },
        { k: 'Horas por kilo del método', ref: m.nombre, v: m.horasPorKg, format: 'unit', unit: 'h/kg', decimals: 1 },
        { k: 'Si lo hacés en heladera', ref: '10 h por kilo', v: DESCONGELADO.heladera.horasPorKg * peso, format: 'unit', unit: 'h', decimals: 1 },
        { k: 'Si lo hacés en agua fría', ref: '2 h por kilo', v: DESCONGELADO['agua-fria'].horasPorKg * peso, format: 'unit', unit: 'h', decimals: 1 },
        { k: 'Si lo hacés en microondas', ref: '12 min por kilo', v: DESCONGELADO.microondas.horasPorKg * peso, format: 'unit', unit: 'h', decimals: 1 },
        { k: 'Recambio de agua', ref: 'sólo método agua fría', v: 30, format: 'unit', unit: 'min', decimals: 0 },
      ];

      const seguridad = clave === 'heladera'
        ? 'es el único método que permite volver a congelar sin cocinar'
        : 'hay que cocinar inmediatamente después y no vuelve al freezer';

      return {
        total: hhmm(horas * 60),
        sub:
          n1(peso, 1) + ' kg en ' + m.nombre.toLowerCase() + ': ' + hhmm(horas * 60) + ' · ' + m.instruccion +
          ' · ' + seguridad,
        rows: rows,
        chart: segs(eje),
        format: 'unit',
        unit: 'h',
        decimals: 1,
        position: pos(eje, horas),
        positionLabel: m.nombre + ' · ' + n1(peso, 1) + ' kg en ' + hhmm(horas * 60),
      };
    }

    // ---------- RAMA 4: marinado ----------
    function calcMarinado(v) {
      const c = ctx(v);
      const base = MARINADO[c.corte.tipo] || MARINADO.vaca;
      const fg = FACTOR_GROSOR[v.grosor] || 1;
      const fm = FACTOR_MARINADA[v.marinada] || 1;

      const min = base.min * fg * fm;
      const opt = base.opt * fg * fm;
      const max = base.max * fg * fm;

      const eje = [
        ['Poco sabor', 0, Math.round(min), 'warn'],
        ['Ventana ideal', Math.round(min), Math.round(max), 'good'],
        ['Se pasa', Math.round(max), Math.round(max * 1.5), 'bad'],
      ];

      const rows = [
        { k: 'Tiempo óptimo de marinado', ref: c.corte.nombre, v: opt, format: 'unit', unit: 'min', decimals: 0, extra: true },
        { k: 'Tiempo mínimo para que tome sabor', ref: c.corte.nombre, v: min, format: 'unit', unit: 'min', decimals: 0 },
        { k: 'Tiempo máximo antes de arruinar la textura', ref: c.corte.nombre, v: max, format: 'unit', unit: 'min', decimals: 0, extra: true },
        { k: 'Óptimo en horas', ref: 'para planificar', v: opt / 60, format: 'unit', unit: 'h', decimals: 1 },
        { k: 'Factor por grosor', ref: String(v.grosor || 'medio'), v: fg, format: 'plain', decimals: 2 },
        { k: 'Factor por tipo de marinada', ref: String(v.marinada || 'aceite'), v: fm, format: 'plain', decimals: 2 },
        { k: 'Atemperar antes de cocinar', ref: 'fuera de la heladera', v: 30, format: 'unit', unit: 'min', decimals: 0 },
      ];

      const nota = String(v.marinada) === 'acida'
        ? 'la marinada ácida actúa rápido y "cocina" la superficie: no te pases del máximo'
        : String(v.marinada) === 'seca'
          ? 'la marinada seca actúa despacio y perdona el exceso de tiempo'
          : 'marinada de acción media, la más tolerante';

      return {
        total: hhmm(opt),
        sub:
          c.corte.nombre + ' ' + String(v.grosor || 'medio') + ' con marinada ' + String(v.marinada || 'aceite') +
          ': mínimo ' + hhmm(min) + ', óptimo ' + hhmm(opt) + ', máximo ' + hhmm(max) +
          ' · siempre en heladera · ' + nota,
        rows: rows,
        chart: segs(eje),
        format: 'unit',
        unit: 'min',
        decimals: 0,
        position: pos(eje, opt),
        positionLabel: 'Óptimo ' + hhmm(opt) + ' · ventana de ' + hhmm(min) + ' a ' + hhmm(max),
      };
    }

    // ---------- RAMA 5: fritura ----------
    function calcFritura(v) {
      const a = PUNTO_HUMO[v.aceite] || PUNTO_HUMO.girasol;
      const f = TEMP_FRITURA[v.fritura] || TEMP_FRITURA.milanesa;
      const margen = a.temp - f.temp;
      const apto = margen >= MARGEN_MINIMO;

      const eje = [
        ['Salteado suave', 100, 160, 'good'],
        ['Fritura estándar', 160, 190, 'main'],
        ['Fritura fuerte', 190, 230, 'warn'],
        ['Zona de humo', 230, 260, 'bad'],
      ];

      const rows = [
        { k: 'Punto de humo del aceite', ref: a.nombre, v: a.temp, format: 'unit', unit: '°C', decimals: 0, extra: true },
        { k: 'Temperatura de fritura necesaria', ref: f.nombre, v: f.temp, format: 'unit', unit: '°C', decimals: 0, extra: true },
        { k: 'Margen disponible', ref: apto ? 'apto' : 'insuficiente', v: margen, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Margen mínimo recomendado', ref: 'para no humear', v: MARGEN_MINIMO, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Punto de humo del girasol alto oleico', ref: 'alternativa segura', v: PUNTO_HUMO.girasol_ao.temp, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Punto de humo de la canola', ref: 'alternativa segura', v: PUNTO_HUMO.canola.temp, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Punto de humo del oliva refinado', ref: 'alternativa segura', v: PUNTO_HUMO.oliva_comun.temp, format: 'unit', unit: '°C', decimals: 0 },
      ];

      return {
        total: f.temp + ' °C',
        sub:
          f.nombre + ' con aceite de ' + a.nombre.toLowerCase() + ': freír a ' + f.temp + ' °C, punto de humo ' +
          a.temp + ' °C, margen de ' + margen + ' °C · ' +
          (apto
            ? 'combinación apta: el aceite aguanta sin degradarse'
            : 'no recomendado: elegí girasol alto oleico, canola u oliva refinado'),
        rows: rows,
        chart: segs(eje),
        format: 'unit',
        unit: '°C',
        decimals: 0,
        position: pos(eje, f.temp),
        positionLabel:
          'Fritura a ' + f.temp + ' °C · punto de humo ' + a.temp + ' °C · margen ' + margen + ' °C',
      };
    }

    const BRANCH = {
      horno: calcHorno,
      termometro: calcTermometro,
      descongelado: calcDescongelado,
      marinado: calcMarinado,
      fritura: calcFritura,
    };

    H.onCompute(function (v, kase) {
      const fn = BRANCH[(kase && kase.id) || 'horno'] || calcHorno;
      return fn(v);
    });
  })();
</script>
