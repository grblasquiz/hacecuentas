---
/**
 * Hub de decisión — "Los números de tu cerveza casera"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: seis ramas que comparten OG y FG.
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub, FACTOR_ABV, ABW_POR_ABV, FACTOR_ATENUACION_REAL, FACTOR_AZUCAR, PERDIDAS, TEMP_CALIBRACION,
} from '../../lib/hubs/cerveza-casera';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    FACTOR_ABV, ABW_POR_ABV, FACTOR_ATENUACION_REAL, FACTOR_AZUCAR, PERDIDAS, TEMP_CALIBRACION,
  }}
>
  (function () {
    const H = window.HC_HUB;

    const n1 = (x, d) => Number(x || 0).toLocaleString('es-AR', {
      minimumFractionDigits: d == null ? 0 : d,
      maximumFractionDigits: d == null ? 0 : d,
    });

    function segs(lista) {
      return lista.map((s) => ({ label: s[0], value: s[2] - s[1], from: s[1], to: s[2], tone: s[3] }));
    }
    function pos(lista, valor) {
      const desde = lista[0][1];
      const hasta = lista[lista.length - 1][2];
      return Number(Math.min(100, Math.max(0, ((valor - desde) / (hasta - desde)) * 100)).toFixed(1));
    }

    /** OG y FG saneadas: la FG siempre por debajo de la OG. */
    function dens(v) {
      const og = Math.min(1.2, Math.max(1.001, Number(v.og) || 1.052));
      let fg = Math.max(0.98, Number(v.fg) || 1.012);
      if (fg >= og) fg = og - 0.001;
      return { og: og, fg: fg };
    }

    /** Grados Plato aproximados a partir de la densidad. */
    const plato = (sg) => ((sg - 1) * 1000) / 4;

    const estiloPorAbv = (a) =>
      a < 3.5 ? 'Session / lager liviana'
      : a < 5 ? 'Lager, pilsner o blonde ale'
      : a < 6 ? 'Pale ale, amber o stout'
      : a < 7.5 ? 'IPA, brown ale o porter'
      : a < 9 ? 'Double IPA o belgian strong'
      : 'Imperial o barleywine';

    // ---------- RAMA 1: ABV ----------
    function calcAbv(v) {
      const d = dens(v);
      const abv = (d.og - d.fg) * FACTOR_ABV;
      const abw = abv * ABW_POR_ABV;
      const aten = ((d.og - d.fg) / (d.og - 1)) * 100;
      // Extracto real (Balling) y calorías por 100 ml: la fórmula usa ABW,
      // no ABV. La calculadora vieja usaba ABV y sobrestimaba ~20%.
      const re = 0.1808 * plato(d.og) + 0.8192 * plato(d.fg);
      const kcal = (6.9 * abw + 4 * Math.max(0, re - 0.1)) * d.fg;

      const eje = [
        ['Session', 0, 3.5, 'good'],
        ['Lager', 3.5, 5, 'main'],
        ['Ale', 5, 6, 'exit'],
        ['IPA', 6, 7.5, 'prop'],
        ['Fuerte', 7.5, 9, 'warn'],
        ['Imperial', 9, 15, 'bad'],
      ];

      const rows = [
        { k: 'Alcohol en volumen (ABV)', ref: '(OG − FG) × 131,25', v: abv, format: 'unit', unit: '%', decimals: 2, extra: true },
        { k: 'Alcohol en peso (ABW)', ref: 'ABV × 0,789', v: abw, format: 'unit', unit: '%', decimals: 2 },
        { k: 'Atenuación aparente', ref: '(OG − FG) ÷ (OG − 1)', v: aten, format: 'unit', unit: '%', decimals: 1, extra: true },
        { k: 'Calorías cada 100 ml', ref: 'sobre ABW y extracto real', v: kcal, format: 'unit', unit: 'kcal', decimals: 0 },
        { k: 'Calorías en una botella de 500 ml', ref: 'referencia', v: kcal * 5, format: 'unit', unit: 'kcal', decimals: 0 },
        { k: 'Densidad inicial en grados Plato', ref: 'OG ' + n1(d.og, 3), v: plato(d.og), format: 'unit', unit: '°P', decimals: 1 },
        { k: 'Densidad final en grados Plato', ref: 'FG ' + n1(d.fg, 3), v: plato(d.fg), format: 'unit', unit: '°P', decimals: 1 },
        { k: 'Extracto real', ref: 'azúcares que quedaron', v: re, format: 'unit', unit: '°P', decimals: 2 },
      ];

      const nota =
        aten < 65 ? 'atenuación baja: revisá si la fermentación realmente terminó antes de embotellar'
        : aten > 88 ? 'atenuación muy alta: cuerpo seco, casi sin azúcares residuales'
        : 'atenuación dentro del rango sano';

      return {
        total: n1(abv, 2) + '%',
        sub:
          estiloPorAbv(abv) + ' · ' + n1(abv, 2) + '% ABV (' + n1(abw, 2) + '% ABW) · atenuación ' +
          n1(aten, 1) + '% · ' + Math.round(kcal) + ' kcal cada 100 ml · ' + nota,
        rows: rows,
        chart: segs(eje),
        format: 'unit',
        unit: '%',
        decimals: 2,
        position: pos(eje, abv),
        positionLabel: n1(abv, 2) + '% ABV — ' + estiloPorAbv(abv),
      };
    }

    // ---------- RAMA 2: atenuación ----------
    function calcAtenuacion(v) {
      const d = dens(v);
      const aparente = ((d.og - d.fg) / (d.og - 1)) * 100;
      const real = aparente * FACTOR_ATENUACION_REAL;
      const esperada = Math.max(0, Number(v.atenuacionEsperada) || 0);

      const eje = [
        ['Muy incompleta', 40, 60, 'bad'],
        ['Baja o trabada', 60, 70, 'warn'],
        ['Normal ale', 70, 80, 'good'],
        ['Alta: lager o saison', 80, 88, 'main'],
        ['Muy alta: Brett o enzimas', 88, 100, 'exit'],
      ];

      const rows = [
        { k: 'Atenuación aparente', ref: 'la que mide el hidrómetro', v: aparente, format: 'unit', unit: '%', decimals: 1, extra: true },
        { k: 'Atenuación real', ref: 'aparente × 0,81', v: real, format: 'unit', unit: '%', decimals: 1 },
        { k: 'Densidad final que tenés', ref: 'FG medida', v: d.fg * 1000, format: 'plain', decimals: 0 },
      ];
      if (esperada > 0) {
        const fgEsperada = d.og - (esperada / 100) * (d.og - 1);
        rows.push({ k: 'Atenuación que declara la cepa', ref: 'datasheet', v: esperada, format: 'unit', unit: '%', decimals: 0, extra: true });
        rows.push({ k: 'Diferencia contra la cepa', ref: 'tuya − declarada', v: aparente - esperada, format: 'unit', unit: 'puntos', decimals: 1 });
        rows.push({ k: 'FG a la que debería haber llegado', ref: 'con la atenuación de la cepa', v: fgEsperada * 1000, format: 'plain', decimals: 0 });
      }
      rows.push({ k: 'Azúcares fermentados', ref: 'OG − FG en puntos', v: (d.og - d.fg) * 1000, format: 'plain', decimals: 0 });

      const estado =
        aparente < 60 ? 'Fermentación muy incompleta'
        : aparente < 70 ? 'Baja: cuerpo fuerte o fermentación trabada'
        : aparente < 80 ? 'Normal para una ale'
        : aparente < 88 ? 'Alta: típica de lager o saison seca'
        : 'Muy alta: sospechá Brett o enzimas';

      const diag = esperada > 0
        ? (aparente < esperada - 5
            ? 'por debajo del rango de la cepa: revisá temperatura y cantidad de levadura antes de embotellar'
            : aparente > esperada + 5
              ? 'por encima del rango de la cepa: sospechá contaminación o un macerado muy bajo'
              : 'dentro del rango esperado: fermentación sana')
        : 'cargá la atenuación del datasheet de tu cepa para comparar';

      return {
        total: n1(aparente, 1) + '%',
        sub: estado + ' · aparente ' + n1(aparente, 1) + '%, real ' + n1(real, 1) + '% · ' + diag,
        rows: rows,
        chart: segs(eje),
        format: 'unit',
        unit: '%',
        decimals: 1,
        position: pos(eje, aparente),
        positionLabel: n1(aparente, 1) + '% aparente — ' + estado,
      };
    }

    // ---------- RAMA 3: IBU (Tinseth 1997) ----------
    function calcIbu(v) {
      const d = dens(v);
      const g = Math.max(0, Number(v.gramosLupulo) || 0);
      const aa = Math.max(0.1, Number(v.alfaAcidos) || 10);
      const t = Math.max(0, Number(v.tiempoHervor) || 0);
      const vol = Math.max(1, Number(v.volumen) || 20);

      const fDensidad = 1.65 * Math.pow(0.000125, d.og - 1);
      const fTiempo = (1 - Math.exp(-0.04 * t)) / 4.15;
      const util = fDensidad * fTiempo;
      const ibu = (util * aa * g * 1000) / (vol * 100);

      const eje = [
        ['Muy suave', 0, 15, 'good'],
        ['Suave', 15, 30, 'main'],
        ['Moderado', 30, 45, 'exit'],
        ['Amargo (IPA)', 45, 70, 'prop'],
        ['Muy amargo', 70, 100, 'warn'],
        ['Extremo', 100, 120, 'bad'],
      ];

      const clas =
        ibu < 15 ? 'Muy suave, tipo lager ligera'
        : ibu < 30 ? 'Suave, tipo pilsner o kölsch'
        : ibu < 45 ? 'Moderado, tipo pale ale'
        : ibu < 70 ? 'Amargo, tipo IPA'
        : ibu < 100 ? 'Muy amargo, tipo double IPA'
        : 'Extremo, tipo imperial IPA';

      const rows = [
        { k: 'Amargor estimado', ref: 'modelo Tinseth', v: ibu, format: 'unit', unit: 'IBU', decimals: 1, extra: true },
        { k: 'Utilización del lúpulo', ref: 'en estas condiciones', v: util * 100, format: 'unit', unit: '%', decimals: 1, extra: true },
        { k: 'Factor por densidad del mosto', ref: 'OG ' + n1(d.og, 3), v: fDensidad, format: 'plain', decimals: 3 },
        { k: 'Factor por tiempo de hervor', ref: t + ' min', v: fTiempo, format: 'plain', decimals: 3 },
        { k: 'Alfa ácidos aportados', ref: 'gramos × alfa', v: (g * aa) / 100, format: 'unit', unit: 'g', decimals: 1 },
        { k: 'Lúpulo por litro', ref: 'densidad de la receta', v: g / vol, format: 'unit', unit: 'g/L', decimals: 2 },
        { k: 'Volumen de hervor', ref: 'sobre el que se diluye', v: vol, format: 'unit', unit: 'L', decimals: 1 },
      ];

      return {
        total: n1(ibu, 1) + ' IBU',
        sub:
          clas + ' · ' + g + ' g al ' + n1(aa, 1) + '% de alfa, ' + t + ' min de hervor en ' + n1(vol, 1) +
          ' L · utilización ' + n1(util * 100, 1) + '% · el dry hopping no suma IBU',
        rows: rows,
        chart: segs(eje),
        format: 'unit',
        unit: 'IBU',
        decimals: 1,
        position: pos(eje, ibu),
        positionLabel: n1(ibu, 1) + ' IBU — ' + clas,
      };
    }

    // ---------- RAMA 4: azúcar de cebado ----------
    function calcCebado(v) {
      const vol = Math.max(0.5, Number(v.volumen) || 20);
      const obj = Math.max(0.5, Number(v.co2) || 2.4);
      const temp = Number(v.temperatura);
      const t = isFinite(temp) ? temp : 20;
      const az = FACTOR_AZUCAR[v.tipoAzucar] || FACTOR_AZUCAR.dextrosa;

      // CO2 residual disuelto según la temperatura más alta de fermentación.
      const residual = 3.0378 - 0.050062 * t + 0.00026555 * t * t;
      const delta = Math.max(0, obj - residual);
      const gramos = delta * vol * az.factor;

      const eje = [
        ['Baja, tipo british', 0.5, 1.8, 'main'],
        ['Estándar', 1.8, 3.5, 'good'],
        ['Alta: riesgo de botellas', 3.5, 6, 'bad'],
      ];

      const rows = [
        { k: 'Azúcar de cebado a agregar', ref: az.nombre, v: gramos, format: 'unit', unit: 'g', decimals: 0, extra: true },
        { k: 'Por litro de cerveza', ref: az.nombre, v: gramos / vol, format: 'unit', unit: 'g/L', decimals: 2 },
        { k: 'CO2 objetivo', ref: 'lo que buscás', v: obj, format: 'unit', unit: 'vol', decimals: 2, extra: true },
        { k: 'CO2 residual de la fermentación', ref: 'a ' + n1(t, 1) + ' °C', v: residual, format: 'unit', unit: 'vol', decimals: 2 },
        { k: 'CO2 que hay que cebar', ref: 'objetivo − residual', v: delta, format: 'unit', unit: 'vol', decimals: 2 },
        { k: 'Con dextrosa', ref: '3,86 g por litro y volumen', v: delta * vol * FACTOR_AZUCAR.dextrosa.factor, format: 'unit', unit: 'g', decimals: 0 },
        { k: 'Con azúcar común', ref: '3,51 g por litro y volumen', v: delta * vol * FACTOR_AZUCAR.sacarosa.factor, format: 'unit', unit: 'g', decimals: 0 },
        { k: 'Con extracto de malta seco', ref: '4,50 g por litro y volumen', v: delta * vol * FACTOR_AZUCAR.dme.factor, format: 'unit', unit: 'g', decimals: 0 },
      ];

      const riesgo = obj > 3.5
        ? 'por encima de 3,5 volúmenes usá botellas de pared gruesa: el riesgo de reventar es real'
        : obj < 1.8
          ? 'carbonatación baja tipo británica: se sirve fresca, no helada'
          : 'carbonatación estándar: cualquier botella de cerveza comercial aguanta';

      return {
        total: n1(gramos, 0) + ' g',
        sub:
          n1(gramos, 0) + ' g de ' + az.nombre + ' para ' + n1(vol, 1) + ' L a ' + n1(obj, 1) +
          ' volúmenes · la fermentación a ' + n1(t, 1) + ' °C ya dejó ' + n1(residual, 2) +
          ' volúmenes residuales · ' + riesgo,
        rows: rows,
        chart: segs(eje),
        format: 'unit',
        unit: 'g',
        decimals: 0,
        position: pos(eje, obj),
        positionLabel: n1(obj, 1) + ' volúmenes de CO2 · ' + n1(gramos, 0) + ' g de ' + az.nombre,
      };
    }

    // ---------- RAMA 5: litros que llegan a la botella ----------
    function calcVolumen(v) {
      const vPost = Math.max(1, Number(v.volumen) || 20);
      const lupulo = Math.max(0, Number(v.gramosLupulo) || 0);

      const absorcion = (lupulo * PERDIDAS.absorcionLupuloMlPorG) / 1000;
      const vFerm = Math.max(0, vPost - absorcion - PERDIDAS.trubOlla);
      const vBotella = Math.max(0, vFerm - PERDIDAS.espacioMuerto - PERDIDAS.camaLevadura);
      const perdida = vPost - vBotella;
      const rendimiento = (vBotella / vPost) * 100;

      const eje = [
        ['Rendimiento pobre', 0, 65, 'bad'],
        ['Aceptable', 65, 80, 'warn'],
        ['Bueno', 80, 100, 'good'],
      ];

      const rows = [
        { k: 'Litros que llegan a la botella', ref: 'después de todas las pérdidas', v: vBotella, format: 'unit', unit: 'L', decimals: 2, extra: true },
        { k: 'Litros que llegan al fermentador', ref: 'post-hervor − lúpulo − trub', v: vFerm, format: 'unit', unit: 'L', decimals: 2 },
        { k: 'Volumen post-hervor', ref: 'punto de partida', v: vPost, format: 'unit', unit: 'L', decimals: 2, extra: true },
        { k: 'Pérdida total', ref: 'post-hervor − botella', v: perdida, format: 'unit', unit: 'L', decimals: 2 },
        { k: 'Absorción del lúpulo', ref: '10 ml por gramo', v: absorcion, format: 'unit', unit: 'L', decimals: 2 },
        { k: 'Trub de la olla', ref: 'referencia de equipo', v: PERDIDAS.trubOlla, format: 'unit', unit: 'L', decimals: 2 },
        { k: 'Espacio muerto del fermentador', ref: 'referencia de equipo', v: PERDIDAS.espacioMuerto, format: 'unit', unit: 'L', decimals: 2 },
        { k: 'Cama de levadura', ref: 'referencia de equipo', v: PERDIDAS.camaLevadura, format: 'unit', unit: 'L', decimals: 2 },
        { k: 'Botellas de 500 ml que salen', ref: 'redondeado hacia abajo', v: Math.floor(vBotella / 0.5), format: 'unit', unit: 'botellas', decimals: 0 },
      ];

      return {
        total: n1(vBotella, 1) + ' L',
        sub:
          'De ' + n1(vPost, 1) + ' L post-hervor terminás embotellando ' + n1(vBotella, 1) + ' L (' +
          n1(rendimiento, 0) + '% de rendimiento): se van ' + n1(perdida, 1) +
          ' L entre lúpulo, trub, espacio muerto y borra',
        rows: rows,
        chart: segs(eje),
        format: 'unit',
        unit: 'L',
        decimals: 2,
        position: pos(eje, rendimiento),
        positionLabel: 'Rendimiento ' + n1(rendimiento, 0) + '% · ' + n1(vBotella, 1) + ' L embotellados',
      };
    }

    // ---------- RAMA 6: corrección del hidrómetro ----------
    function calcHidrometro(v) {
      const sg = Math.min(1.2, Math.max(0.98, Number(v.og) || 1.052));
      const temp = Number(v.temperatura);
      const tC = isFinite(temp) ? temp : 20;

      // Ecuación de la ASBC, en grados Fahrenheit.
      const f = (T) => 1.00130346 - 0.000134722 * T + 0.00000204052 * T * T - 0.0000000023282 * T * T * T;
      const tF = (tC * 9) / 5 + 32;
      const calF = (TEMP_CALIBRACION * 9) / 5 + 32;
      const corregida = (sg * f(tF)) / f(calF);
      const delta = corregida - sg;
      const brix = ((corregida - 1) * 1000) / 4;

      const eje = [
        ['Cerveza liviana', 1000, 1040, 'good'],
        ['Cerveza media', 1040, 1060, 'main'],
        ['Cerveza fuerte', 1060, 1090, 'warn'],
        ['Imperial', 1090, 1130, 'bad'],
      ];

      const rows = [
        { k: 'Densidad corregida (×1000)', ref: 'calibración ' + TEMP_CALIBRACION + ' °C', v: corregida * 1000, format: 'plain', decimals: 1, extra: true },
        { k: 'Lectura cruda (×1000)', ref: 'lo que marcó el hidrómetro', v: sg * 1000, format: 'plain', decimals: 1 },
        { k: 'Corrección en puntos', ref: 'corregida − cruda', v: delta * 1000, format: 'plain', decimals: 2, extra: true },
        { k: 'Temperatura de la muestra', ref: 'la que cargaste', v: tC, format: 'unit', unit: '°C', decimals: 1 },
        { k: 'Temperatura de calibración', ref: 'la del instrumento', v: TEMP_CALIBRACION, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Equivalencia en grados Brix', ref: 'aproximada', v: brix, format: 'unit', unit: '°Bx', decimals: 1 },
        { k: 'Impacto sobre el ABV final', ref: 'si no corregís', v: Math.abs(delta) * 131.25, format: 'unit', unit: '%', decimals: 2 },
      ];

      const abs = Math.abs(delta);
      const lectura =
        abs >= 0.003 ? 'la desviación es grande: medí más cerca de la temperatura de calibración'
        : abs >= 0.0005 ? 'la corrección ya pesa en el cálculo de alcohol: usá el valor corregido'
        : 'mediste casi a temperatura de calibración, la corrección es despreciable';

      return {
        total: n1(corregida, 4),
        sub:
          'Lectura ' + n1(sg, 3) + ' a ' + n1(tC, 1) + ' °C → densidad real ' + n1(corregida, 4) + ' (' +
          (delta >= 0 ? '+' : '') + n1(delta * 1000, 2) + ' puntos) · ' + lectura,
        rows: rows,
        chart: segs(eje),
        format: 'plain',
        decimals: 3,
        position: pos(eje, corregida * 1000),
        positionLabel: 'Densidad corregida ' + n1(corregida, 4) + ' · ' + n1(brix, 1) + ' °Bx',
      };
    }

    const BRANCH = {
      abv: calcAbv,
      atenuacion: calcAtenuacion,
      ibu: calcIbu,
      cebado: calcCebado,
      volumen: calcVolumen,
      hidrometro: calcHidrometro,
    };

    H.onCompute(function (v, kase) {
      const fn = BRANCH[(kase && kase.id) || 'abv'] || calcAbv;
      return fn(v);
    });
  })();
</script>
