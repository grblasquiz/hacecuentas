---
/**
 * Hub de decisión — "¿A qué temperatura pongo el horno?"
 * Reemplaza 3 URLs de conversor suelto (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer.
 * La página sólo aporta datos (src/lib/hubs/temperatura-horno.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, SCALE, GAS_A_CELSIUS, AJUSTE_CONVECCION } from '../../lib/hubs/temperatura-horno';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ SCALE, GAS_A_CELSIUS, AJUSTE_CONVECCION }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay plata: todo se formatea como unidad (grados, minutos, número de gas).
    const dec = (n, d) => (Math.round(n * Math.pow(10, d)) / Math.pow(10, d)).toFixed(d).replace('.', ',');

    // Franjas como las nombra una receta.
    function zona(c) {
      if (c < 140) return 'horno muy suave';
      if (c < 165) return 'horno suave';
      if (c < 195) return 'horno moderado';
      if (c < 235) return 'horno fuerte';
      return 'horno muy fuerte';
    }

    function usoDe(c) {
      if (c < 140) return 'secar merengues, deshidratar frutas o mantener caliente';
      if (c < 165) return 'merengues, pavlova, cocciones largas y flanes a baño María';
      if (c < 195) return 'bizcochuelos, budines, tartas dulces y pollo entero';
      if (c < 235) return 'panes, empanadas, pizza casera, papas y verduras doradas';
      return 'pizza a la piedra, gratinar y dorar rápido';
    }

    // Reverso de la tabla oficial: °C → número de gas más cercano.
    function celsiusAGas(c) {
      let mejor = 1;
      let minDiff = Infinity;
      Object.keys(GAS_A_CELSIUS).forEach(function (g) {
        const d = Math.abs(c - GAS_A_CELSIUS[g]);
        if (d < minDiff) { minDiff = d; mejor = Number(g); }
      });
      return { gas: mejor, temp: GAS_A_CELSIUS[String(mejor)], diff: c - GAS_A_CELSIUS[String(mejor)] };
    }

    H.onCompute(function (v) {
      const valor = Number(v.valor);
      const unidad = String(v.unidad || 'fahrenheit');
      const conveccion = String(v.horno || 'convencional') === 'conveccion';

      if (!isFinite(valor)) {
        return { total: '—', sub: 'Ingresá un valor numérico.', rows: [], chart: [] };
      }

      // ── 1. Todo se normaliza a grados Celsius ──
      let celsius;
      let origen;
      if (unidad === 'celsius') {
        celsius = valor;
        origen = dec(valor, 0) + ' °C';
      } else if (unidad === 'gas') {
        // Tabla oficial gas mark 1-9; fuera de rango se extrapola linealmente.
        const entero = Math.round(valor);
        const exacto = GAS_A_CELSIUS[String(entero)];
        if (exacto !== undefined && Math.abs(valor - entero) < 0.01) {
          celsius = exacto;
        } else if (valor < 1) {
          celsius = 110 + valor * 30; // ¼ de gas ≈ 110 °C
        } else {
          const lo = Math.max(1, Math.floor(valor));
          const hi = Math.min(9, Math.ceil(valor));
          const cLo = GAS_A_CELSIUS[String(lo)] || 140;
          const cHi = GAS_A_CELSIUS[String(hi)] || 240;
          celsius = cLo + (cHi - cLo) * (valor - lo);
        }
        origen = 'número de gas ' + dec(valor, 0);
      } else {
        celsius = (valor - 32) * 5 / 9;
        origen = dec(valor, 0) + ' °F';
      }

      // ── 2. Las otras dos escalas ──
      const fahrenheit = celsius * 9 / 5 + 32;
      const g = celsiusAGas(celsius);
      const conVentilador = celsius - AJUSTE_CONVECCION;

      // Lo que hay que poner en TU horno: si es de convección, 20 °C menos.
      const aPoner = conveccion ? conVentilador : celsius;

      // Precalentado sugerido según lo caliente que vaya el horno.
      const precalentado = celsius < 160 ? 10 : celsius < 220 ? 15 : 20;

      const cRedondo = Math.round(celsius);
      const nombre = zona(celsius);

      // Todas las filas declaran su formato: sin `format` el runtime las pinta en $.
      const gradosC = { format: 'unit', unit: '°C', decimals: 0 };
      const rows = [
        Object.assign({ k: 'Temperatura en grados Celsius', v: Math.round(celsius) }, gradosC),
        { k: 'Temperatura en grados Fahrenheit', v: Math.round(fahrenheit), format: 'unit', unit: '°F', decimals: 0 },
        {
          k: 'Número de gas más cercano (perilla 1 a 9)',
          ref: 'tabla UK',
          v: g.gas,
          format: 'unit',
          unit: 'de 9',
          decimals: 0,
        },
        Object.assign({ k: 'Ese número de gas, en grados', v: g.temp }, gradosC),
        Object.assign({ k: 'Si tu horno tiene ventilador (convección)', ref: '−20 °C', v: Math.round(conVentilador) }, gradosC),
        Object.assign({ k: 'Lo que tenés que poner en TU horno', v: Math.round(aPoner), extra: true }, gradosC),
        { k: 'Precalentado sugerido', v: precalentado, format: 'unit', unit: 'min', decimals: 0 },
        {
          k: 'Diferencia con el escalón de gas más cercano',
          v: Math.abs(Math.round(g.diff)),
          format: 'unit',
          unit: '°C',
          decimals: 0,
        },
      ];

      // Escala 100–280 °C con las franjas de receta; `position` marca tu temperatura.
      const pos = Math.max(0, Math.min(100, ((celsius - SCALE.min) / (SCALE.max - SCALE.min)) * 100));
      let desde = SCALE.min;
      const chart = SCALE.bands.map(function (b) {
        const seg = { label: b.label, value: b.to - desde, tone: b.tone, from: desde, to: b.to };
        desde = b.to;
        return seg;
      });

      const notaVentilador = conveccion
        ? ' · como tu horno es de convección, poné ' + Math.round(conVentilador) + ' °C'
        : '';

      return {
        total: Math.round(aPoner) + ' °C',
        sub:
          (unidad === 'gas' ? origen + ' = ' : '') +
          cRedondo + ' °C = ' + Math.round(fahrenheit) + ' °F = gas ' + g.gas +
          ' · ' + nombre + ', ideal para ' + usoDe(celsius) + notaVentilador,
        rows: rows,
        chart: chart,
        // Default del resultado: grados Celsius (acá no hay pesos).
        format: 'unit',
        unit: '°C',
        decimals: 0,
        position: Number(pos.toFixed(1)),
        positionLabel: cRedondo + ' °C — ' + nombre,
      };
    });
  })();
</script>
