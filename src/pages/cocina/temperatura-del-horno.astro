---
/**
 * Hub de decisión — "¿A qué temperatura pongo el horno?"
 * Reemplaza 3 URLs de conversor suelto (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer.
 * La página sólo aporta datos (src/lib/hubs/temperatura-horno.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TemperaturaHornoExperience from '../../components/generated/TemperaturaHornoExperience.astro';
import { hub, SCALE, GAS_A_CELSIUS, AJUSTE_CONVECCION } from '../../lib/hubs/temperatura-horno';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <TemperaturaHornoExperience data={hub} />
  <Footer />
</Layout>

