---
/**
 * Hub de decisión — "¿Cuántos gramos es una taza?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (4 ramas, `cases`). La rama define los MILILITROS de
 * la taza: 240 (cups), 250 (métrica AR) o el modo cucharas / sin balanza.
 *
 * Ninguna densidad vive acá: todas se derivan de las fórmulas reales del repo
 * (conversion-medidas-cocina-tazas-gramos, conversion-cups-gramos-*,
 * tazas-gramos, conversion-cucharaditas-gramos-especias-sal,
 * conversion-cucharadas-cucharaditas-ml, conversor-tazas-a-mililitros,
 * equivalencia-huevos-tamano-gramos-claras) dentro de
 * src/lib/hubs/tazas-gramos.ts, que también documenta las contradicciones
 * entre esas tablas y con qué criterio se resolvieron.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TazasGramosExperience from '../../components/generated/TazasGramosExperience.astro';
import {
  hub,
  DENSIDADES,
  TAZA_BASE_ML,
  TAZA_POR_RAMA,
  CDA_ML,
  CDTA_ML,
  MASA_G,
  HUEVO_CLARA_PCT,
  HUEVO_YEMA_PCT,
  HUEVO_COMESTIBLE_PCT,
} from '../../lib/hubs/tazas-gramos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <TazasGramosExperience data={hub} />
  <Footer />
</Layout>

