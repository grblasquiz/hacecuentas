---
/**
 * Hub de decisión — "¿Cuántos gramos es una taza?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (4 ramas, `cases`). La rama define los MILILITROS de
 * la taza: 240 (cups), 250 (métrica AR) o el modo cucharas / sin balanza.
 *
 * Ninguna densidad vive acá: todas se derivan de las fórmulas reales del repo
 * (conversion-medidas-cocina-tazas-gramos, conversion-cups-gramos-*,
 * tazas-gramos, conversion-cucharaditas-gramos-especias-sal,
 * conversion-cucharadas-cucharaditas-ml, conversor-tazas-a-mililitros,
 * equivalencia-huevos-tamano-gramos-claras) dentro de
 * src/lib/hubs/tazas-gramos.ts, que también documenta las contradicciones
 * entre esas tablas y con qué criterio se resolvieron.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  DENSIDADES,
  TAZA_BASE_ML,
  TAZA_POR_RAMA,
  CDA_ML,
  CDTA_ML,
  MASA_G,
  HUEVO_CLARA_PCT,
  HUEVO_YEMA_PCT,
  HUEVO_COMESTIBLE_PCT,
} from '../../lib/hubs/tazas-gramos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    DENSIDADES,
    TAZA_BASE_ML,
    TAZA_POR_RAMA,
    CDA_ML,
    CDTA_ML,
    MASA_G,
    HUEVO_CLARA_PCT,
    HUEVO_YEMA_PCT,
    HUEVO_COMESTIBLE_PCT,
  }}
>
  (function () {
    const H = window.HC_HUB;

    // Este hub NO es de plata: acá no hay una sola fila en pesos. Toda fila
    // declara su `format`, porque el runtime hace Object.assign y la que no lo
    // declara cae a $ por defecto.
    const U = (v, unit, decimals) => ({ v: v, format: 'unit', unit: unit, decimals: decimals || 0 });

    const n = (x, d) =>
      Number(x || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });

    /** Cuántos decimales merece un número para no mentir ni marear. */
    function dec(x) {
      const a = Math.abs(x);
      if (a === 0) return 0;
      if (Number.isInteger(x)) return 0;
      if (a < 1) return 3;
      if (a < 10) return 2;
      if (a < 100) return 1;
      return 0;
    }

    const ETIQUETA = {
      taza: 'tazas',
      media_taza: 'medias tazas',
      cuarto_taza: 'cuartos de taza',
      cda: 'cucharadas',
      cdta: 'cucharaditas',
      ml: 'ml',
      g: 'g',
      kg: 'kg',
      oz: 'oz',
      lb: 'lb',
      unidad: 'unidades',
    };

    /** Tope de la escala de densidad del gráfico, en g por taza de 240 ml. */
    const ESCALA_MAX = 350;

    H.onCompute(function (v, kase) {
      const rama = (kase && kase.id) || 'cups';
      const tazaMl = TAZA_POR_RAMA[rama] || TAZA_BASE_ML;

      const ingId = DENSIDADES[v.ingrediente] ? v.ingrediente : 'harina_comun';
      const ing = DENSIDADES[ingId];
      const cantidad = Math.max(0, Number(v.cantidad) || 0);

      // Volúmenes de cada unidad, en ml. La taza depende de la rama; la
      // cucharada y la cucharadita NO (15 y 5 ml siempre).
      const VOL = {
        taza: tazaMl,
        media_taza: tazaMl / 2,
        cuarto_taza: tazaMl / 4,
        cda: CDA_ML,
        cdta: CDTA_ML,
        ml: 1,
      };

      const esHuevo = ing.gUnidad > 0;
      let uo = v.unidadOrigen || 'taza';
      let ud = v.unidadDestino || 'g';
      // "Unidades" sólo existe para los huevos: si lo eligen con otro
      // ingrediente, cae a la medida más razonable en vez de dar 0.
      if (uo === 'unidad' && !esHuevo) uo = 'taza';
      if (ud === 'unidad' && !esHuevo) ud = 'g';

      // Gramos por mililitro del ingrediente. La densidad de la tabla está
      // expresada por taza de 240 ml, así que se divide por 240 SIEMPRE,
      // independientemente de la taza que use la rama.
      const gPorMl = ing.gTaza / TAZA_BASE_ML;

      function aGramos(cant, u) {
        if (MASA_G[u]) return cant * MASA_G[u];
        if (u === 'unidad') return cant * ing.gUnidad;
        return cant * (VOL[u] || 0) * gPorMl;
      }
      function desdeGramos(g, u) {
        if (MASA_G[u]) return g / MASA_G[u];
        if (u === 'unidad') return ing.gUnidad ? g / ing.gUnidad : 0;
        const ml = gPorMl ? g / gPorMl : 0;
        return VOL[u] ? ml / VOL[u] : 0;
      }

      const gramos = aGramos(cantidad, uo);
      const resultado = desdeGramos(gramos, ud);
      const mlTotales = gPorMl ? gramos / gPorMl : 0;

      // Equivalencias del ingrediente, ya ajustadas a la taza de la rama.
      const gPorTazaRama = ing.gTaza * (tazaMl / TAZA_BASE_ML);
      const gPorCda = ing.gTaza * (CDA_ML / TAZA_BASE_ML);
      const gPorCdta = ing.gTaza * (CDTA_ML / TAZA_BASE_ML);

      const rows = [];

      rows.push({
        k: 'Peso',
        ref: n(cantidad, dec(cantidad)) + ' ' + ETIQUETA[uo] + ' de ' + ing.label,
        ...U(gramos, 'g', dec(gramos)),
        extra: true,
      });
      if (!esHuevo || uo !== 'unidad') {
        rows.push({
          k: 'Volumen equivalente',
          ref: 'a razón de ' + n(gPorMl, 3) + ' g por ml',
          ...U(mlTotales, 'ml', dec(mlTotales)),
        });
      }
      rows.push({
        k: 'En tazas de ' + n(tazaMl) + ' ml',
        ref: rama === 'taza_ar' ? 'taza métrica del bazar' : 'taza legal de EE.UU.',
        ...U(desdeGramos(gramos, 'taza'), 'tazas', 2),
      });
      rows.push({
        k: 'En cucharadas soperas',
        ref: 'rasas, de ' + CDA_ML + ' ml',
        ...U(desdeGramos(gramos, 'cda'), 'cdas', 1),
      });
      rows.push({
        k: 'En cucharaditas',
        ref: 'rasas, de ' + CDTA_ML + ' ml · 1 cda = 3 cdtas',
        ...U(desdeGramos(gramos, 'cdta'), 'cdtas', 1),
      });

      if (esHuevo) {
        const unidades = ing.gUnidad ? gramos / ing.gUnidad : 0;
        rows.push({
          k: 'Huevos enteros con cáscara',
          ref: n(ing.gUnidad) + ' g cada uno',
          ...U(unidades, 'huevos', 1),
          extra: true,
        });
        rows.push({
          k: 'Clara',
          ref: Math.round(HUEVO_CLARA_PCT * 100) + '% del peso con cáscara',
          ...U(gramos * HUEVO_CLARA_PCT, 'g', 0),
        });
        rows.push({
          k: 'Yema',
          ref: Math.round(HUEVO_YEMA_PCT * 100) + '% del peso con cáscara',
          ...U(gramos * HUEVO_YEMA_PCT, 'g', 0),
        });
        rows.push({
          k: 'Parte comestible',
          ref: 'la cáscara es el ' + Math.round((1 - HUEVO_COMESTIBLE_PCT) * 100) + '%',
          ...U(gramos * HUEVO_COMESTIBLE_PCT, 'g', 0),
        });
      }

      rows.push({
        k: '1 taza de ' + ing.label,
        ref: 'taza de ' + n(tazaMl) + ' ml, enrasada sin compactar',
        ...U(gPorTazaRama, 'g', dec(gPorTazaRama)),
        extra: true,
      });
      rows.push({
        k: '1 cucharada rasa',
        ref: CDA_ML + ' ml de ' + ing.label,
        ...U(gPorCda, 'g', 1),
      });
      rows.push({
        k: '1 cucharadita rasa',
        ref: CDTA_ML + ' ml de ' + ing.label,
        ...U(gPorCdta, 'g', 1),
      });
      rows.push({
        k: 'Margen por cómo llenes la taza',
        ref: 'compactar en vez de airear suma hasta un 25%',
        ...U(gramos * 0.25, 'g', dec(gramos * 0.25)),
      });

      const d = dec(resultado);
      const total = n(resultado, d) + ' ' + ETIQUETA[ud];

      // Escala de densidad: dónde cae este ingrediente entre 0 y 350 g/taza.
      const densidadEscala = ing.gTaza;
      const position = Math.min(100, Math.max(0, (densidadEscala / ESCALA_MAX) * 100));

      return {
        total: total,
        sub:
          n(cantidad, dec(cantidad)) + ' ' + ETIQUETA[uo] + ' de ' + ing.label +
          ' = ' + n(gramos, dec(gramos)) + ' g · 1 taza de ' + n(tazaMl) + ' ml pesa ' +
          n(gPorTazaRama, dec(gPorTazaRama)) + ' g',
        format: 'plain',
        rows: rows,
        chart: [
          { label: 'Livianos · hasta 120 g por taza', value: 120, from: 0, to: 120, tone: 'good' },
          { label: 'Medios · 120 a 230 g por taza', value: 110, from: 120, to: 230, tone: 'prop' },
          { label: 'Densos · más de 230 g por taza', value: 120, from: 230, to: ESCALA_MAX, tone: 'warn' },
        ],
        position: position,
        positionLabel:
          ing.label + ': ' + n(ing.gTaza, dec(ing.gTaza)) + ' g por taza de ' + n(TAZA_BASE_ML) + ' ml',
      };
    });
  })();
</script>
