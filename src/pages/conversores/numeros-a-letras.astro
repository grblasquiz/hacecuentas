---
/**
 * Hub de decisión — "Pasar números a letras, romanos y binario"
 * Reemplaza 4 URLs de conversor suelto (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/numeros-a-letras.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y
 * no se tocan.
 *
 * OJO FORMATO: acá no hay plata. El runtime hace `Object.assign` del formato
 * base con el de cada fila, y una fila sin `format` cae en 'ars'. Por eso el
 * resultado declara `format: 'plain'` y cada fila declara el suyo igual.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, MONEDAS, PALABRAS, LEXICO, ROMANOS, ROMANO_VALOR, BASES } from '../../lib/hubs/numeros-a-letras';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ MONEDAS, PALABRAS, LEXICO, ROMANOS, ROMANO_VALOR, BASES }}
>
  (function () {
    const H = window.HC_HUB;

    // ---------- número → letras (RAE, escala larga) ----------
    // apocope: "uno"/"veintiuno" pierden la o delante de sustantivo masculino
    // ("un peso", "veintiún pesos"). Es el error clásico del cheque a mano.
    function tresDigitos(n, apocope) {
      if (n === 0) return '';
      if (n === 100) return 'cien';
      const c = Math.floor(n / 100);
      const resto = n % 100;
      let centena = c > 0 ? PALABRAS.centenas[c] : '';
      let bajo = '';
      if (resto === 0) bajo = '';
      else if (resto < 30) bajo = PALABRAS.unidades[resto];
      else {
        const d = Math.floor(resto / 10);
        const u = resto % 10;
        bajo = PALABRAS.decenas[d];
        if (u > 0) bajo += ' y ' + PALABRAS.unidades[u];
      }
      if (apocope) bajo = bajo.replace(/\bveintiuno\b/, 'veintiún').replace(/\buno\b/, 'un');
      if (centena && bajo) return centena + ' ' + bajo;
      return centena || bajo;
    }

    function grupoSeis(n, apocopeFinal) {
      if (n === 0) return '';
      const miles = Math.floor(n / 1000);
      const resto = n % 1000;
      let out = '';
      // "mil", nunca "un mil".
      if (miles > 0) out = miles === 1 ? 'mil' : tresDigitos(miles, true) + ' mil';
      if (resto > 0) {
        const t = tresDigitos(resto, apocopeFinal);
        out = out ? out + ' ' + t : t;
      }
      return out.trim();
    }

    function enteroALetras(num, apocopeFinal) {
      if (num === 0) return 'cero';
      const grupos = [];
      let n = num;
      while (n > 0) {
        grupos.push(n % 1000000);
        n = Math.floor(n / 1000000);
      }
      const partes = [];
      for (let g = grupos.length - 1; g >= 0; g--) {
        const valor = grupos[g];
        if (valor === 0) continue;
        if (g === 0) partes.push(grupoSeis(valor, apocopeFinal));
        else if (valor === 1) partes.push('un ' + PALABRAS.escalas[g]);
        else partes.push(grupoSeis(valor, true) + ' ' + PALABRAS.escalasPlural[g]);
      }
      return partes.join(' ').replace(/\s+/g, ' ').trim();
    }

    // RAE: "un millón DE pesos", pero "un millón doscientos mil pesos".
    function terminaEnEscala(letras) {
      return /(mill(ón|ones)|bill(ón|ones)|trill(ón|ones))$/.test(letras);
    }

    // ---------- parsers ----------
    // Acepta "1.250,50", "1250.50" y "1250,5". Devuelve entero + centavos.
    function importe(s) {
      let t = String(s == null ? '' : s).trim().replace(/[^\d.,-]/g, '');
      const neg = /^-/.test(t);
      t = t.replace(/-/g, '');
      if (t.indexOf(',') > -1) t = t.replace(/\./g, '').replace(',', '.');
      else {
        const puntos = (t.match(/\./g) || []).length;
        if (puntos > 1) t = t.replace(/\./g, '');
        else if (puntos === 1 && (t.split('.')[1] || '').length === 3) t = t.replace('.', '');
      }
      const n = Number(t);
      const abs = isFinite(n) ? Math.abs(n) : 0;
      let entero = Math.floor(abs);
      let centavos = Math.round((abs - entero) * 100);
      if (centavos === 100) { entero += 1; centavos = 0; }
      return { entero: entero, centavos: centavos, neg: neg };
    }

    function normalizar(s) {
      return String(s == null ? '' : s)
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-zñ\s]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function letrasANumero(texto) {
      const limpio = normalizar(texto);
      if (!limpio) return { error: 'Escribí el número en letras, por ejemplo "mil doscientos cincuenta".' };
      let neg = false;
      let cuerpo = limpio;
      if (/^menos\b/.test(cuerpo)) { neg = true; cuerpo = cuerpo.replace(/^menos\b/, '').trim(); }
      const tokens = cuerpo.split(' ').filter(function (t) { return t && LEXICO.ignorar.indexOf(t) === -1; });
      if (!tokens.length) return { error: 'Escribí el número en letras, por ejemplo "mil doscientos cincuenta".' };
      if (tokens.length === 1 && tokens[0] === 'cero') return { valor: 0 };

      let resultado = 0, bloqueMillones = 0, grupo = [], malo = null;
      function cerrarGrupo() {
        let total = 0;
        for (let i = 0; i < grupo.length; i++) {
          const tok = grupo[i];
          if (LEXICO.centenas[tok] !== undefined) total += LEXICO.centenas[tok];
          else if (LEXICO.decenas[tok] !== undefined) total += LEXICO.decenas[tok];
          else if (LEXICO.unidades[tok] !== undefined) total += LEXICO.unidades[tok];
          else if (!malo) malo = tok;
        }
        grupo = [];
        return total;
      }
      for (let i = 0; i < tokens.length; i++) {
        const tok = tokens[i];
        if (tok === 'millon' || tok === 'millones') {
          let coef = bloqueMillones + cerrarGrupo();
          if (coef === 0) coef = 1;
          resultado += coef * 1000000;
          bloqueMillones = 0;
        } else if (tok === 'mil') {
          let coef = cerrarGrupo();
          if (coef === 0) coef = 1;
          bloqueMillones += coef * 1000;
        } else grupo.push(tok);
      }
      resultado += bloqueMillones + cerrarGrupo();
      if (malo) return { error: 'No reconozco la palabra "' + malo + '". Escribí el número en letras, por ejemplo "mil doscientos cincuenta".' };
      return { valor: neg ? -resultado : resultado };
    }

    function aRomano(n) {
      let resto = n, out = '';
      for (let i = 0; i < ROMANOS.length; i++) {
        while (resto >= ROMANOS[i][0]) { out += ROMANOS[i][1]; resto -= ROMANOS[i][0]; }
      }
      return out;
    }

    // Suma de izquierda a derecha, restando cuando un símbolo menor precede a
    // uno mayor. Revalidación canónica: "IIII" y "IC" dan el número correcto
    // pero no son escritura válida, así que las rechazamos.
    function deRomano(s) {
      const up = s.toUpperCase();
      let total = 0;
      for (let i = 0; i < up.length; i++) {
        const actual = ROMANO_VALOR[up[i]];
        if (actual === undefined) return { error: 'El carácter "' + up[i] + '" no es romano. Usá sólo I, V, X, L, C, D, M.' };
        const sig = i + 1 < up.length ? ROMANO_VALOR[up[i + 1]] : 0;
        total += actual < sig ? -actual : actual;
      }
      if (total < 1 || total > 3999) return { error: 'Ese romano representa ' + total + ', fuera del rango estándar (1 a 3999).' };
      if (aRomano(total) !== up) return { error: '"' + up + '" no es válido: la forma correcta de ' + total + ' es ' + aRomano(total) + '.' };
      return { valor: total };
    }

    const nf = function (n) { return Number(n || 0).toLocaleString('es-AR'); };
    function vacio(msg) { return { total: '—', sub: msg, rows: [], chart: [], format: 'plain' }; }

    // Barras de escala compartidas por las ramas de cheque y letras→número.
    function barrasEscala(entero, centavos) {
      const millones = Math.floor(entero / 1000000);
      const miles = Math.floor((entero % 1000000) / 1000);
      const unidades = entero % 1000;
      const rows = [], chart = [];
      if (millones > 0) {
        // Etiqueta = cómo se LEE ese bloque en voz alta, no el coeficiente pelado.
        const txt = millones === 1 ? 'un millón' : enteroALetras(millones, true) + ' millones';
        rows.push({ k: 'Millones: ' + txt, ref: '× 1.000.000', v: millones * 1000000, format: 'plain' });
        chart.push({ label: 'Millones', value: millones * 1000000, tone: 'main' });
      }
      if (miles > 0) {
        const txt = miles === 1 ? 'mil' : enteroALetras(miles, true) + ' mil';
        rows.push({ k: 'Miles: ' + txt, ref: '× 1.000', v: miles * 1000, format: 'plain' });
        chart.push({ label: 'Miles', value: miles * 1000, tone: 'prop' });
      }
      rows.push({ k: 'Unidades: ' + enteroALetras(unidades, false), ref: '× 1', v: unidades, format: 'plain' });
      chart.push({ label: 'Unidades', value: unidades, tone: 'good' });
      if (centavos != null) {
        rows.push({ k: 'Centavos (se escriben ' + String(centavos).padStart(2, '0') + '/100)', ref: '÷ 100', v: centavos, format: 'unit', unit: 'centavos' });
        chart.push({ label: 'Centavos', value: centavos, tone: 'warn' });
      }
      return { rows: rows, chart: chart };
    }

    H.onCompute(function (v, kase) {
      const modo = (kase && kase.id) || 'cheque';
      const bruto = String(v.entrada == null ? '' : v.entrada).trim();
      if (!bruto) return vacio('Escribí un número, un texto en letras o un romano para convertir.');

      // ---------------- RAMA 1: cheque / pagaré ----------------
      if (modo === 'cheque') {
        const m = MONEDAS[String(v.moneda || 'ARS')] || MONEDAS.ARS;
        if (!/\d/.test(bruto)) return vacio('Para la línea del cheque escribí el importe en números, por ejemplo 1250,50.');
        const imp = importe(bruto);
        if (imp.entero >= 1e18) return vacio('Probá con un importe menor a un trillón: más arriba el texto deja de ser legible.');

        // DOS formas del importe:
        //  - `letras` va APOCOPADA ("veintiún pesos"): el número precede al
        //    sustantivo masculino. Es la que va en el recibo y en el orden
        //    inverso del cheque.
        //  - `letrasSueltas` va SIN apócope ("veintiuno"): en la línea bancaria
        //    "SON PESOS VEINTIUNO" la moneda va primero, así que el número no
        //    precede a nada y no se apocopa.
        const letras = enteroALetras(imp.entero, true);
        const letrasSueltas = enteroALetras(imp.entero, false);
        const de = terminaEnEscala(letras) ? 'DE ' : '';
        const cent = String(imp.centavos).padStart(2, '0');
        // Orden bancario: la moneda va PRIMERO, así que acá tampoco entra el
        // "de" (sólo aparece cuando la cifra precede al sustantivo).
        const lineaCheque = ('SON ' + m.cheque + ' ' + letrasSueltas + ' CON ' + cent + '/100').toUpperCase();
        // Variante con el orden inverso: ahí sí, apócope y "un millón DE pesos".
        const chequeOrdenado = (letras + ' ' + (de ? 'de ' : '') + m.cheque.toLowerCase() + ' con ' + cent + '/100').toUpperCase();
        const unidad = imp.entero === 1 ? m.singular : m.plural;
        const centWord = imp.centavos === 1 ? m.centSingular : m.centPlural;
        const contrato =
          m.plural.toUpperCase() + ' ' + enteroALetras(imp.entero, false).toUpperCase() +
          (imp.centavos > 0 ? ' CON ' + enteroALetras(imp.centavos, false).toUpperCase() + ' ' + centWord.toUpperCase() : '') +
          ' (' + m.simbolo + (imp.entero + imp.centavos / 100).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ')';

        const b = barrasEscala(imp.entero, imp.centavos);
        return {
          total: (imp.neg ? 'MENOS ' : '') + lineaCheque,
          sub:
            m.simbolo + (imp.entero + imp.centavos / 100).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) +
            ' · en un recibo o factura: "' + letras + ' ' + (de ? 'de ' : '') + unidad + ' con ' + imp.centavos + ' ' + centWord +
            '" · en un contrato o escritura: "' + contrato + '"' +
            ' · si el banco pide el orden inverso: "' + chequeOrdenado + '"',
          rows: b.rows,
          chart: b.chart,
          format: 'plain',
        };
      }

      // ---------------- RAMA 2: letras → número ----------------
      if (modo === 'letras-a-numero') {
        const r = letrasANumero(bruto);
        if (r.error) return vacio(r.error);
        const abs = Math.abs(r.valor);
        const b = barrasEscala(abs, null);
        return {
          total: (r.valor < 0 ? '−' : '') + nf(abs),
          sub:
            '"' + bruto.trim() + '" equivale a ' + (r.valor < 0 ? '−' : '') + nf(abs) +
            ' · en letras vuelve a escribirse "' + (r.valor < 0 ? 'menos ' : '') + enteroALetras(abs, false) + '"',
          rows: b.rows,
          chart: b.chart,
          format: 'plain',
        };
      }

      // ---------------- RAMA 3: números romanos ----------------
      if (modo === 'romanos') {
        const soloDigitos = /^-?\d+$/.test(bruto);
        const soloRomano = /^[IVXLCDMivxlcdm]+$/.test(bruto);
        let valor, titulo, sub;
        if (soloDigitos) {
          valor = parseInt(bruto, 10);
          if (valor < 1 || valor > 3999) return vacio('El sistema romano clásico va del 1 al 3999. ' + nf(valor) + ' queda fuera.');
          titulo = aRomano(valor);
          sub = nf(valor) + ' se escribe ' + titulo + ' en números romanos.';
        } else if (soloRomano) {
          const r = deRomano(bruto);
          if (r.error) return vacio(r.error);
          valor = r.valor;
          titulo = nf(valor);
          sub = 'El romano ' + bruto.toUpperCase() + ' equivale a ' + nf(valor) + ' en el sistema arábigo.';
        } else {
          return vacio('Escribí dígitos (ej. 2026) o sólo letras romanas I V X L C D M (ej. MMXXVI).');
        }

        const rows = [], chart = [];
        let resto = valor;
        for (let i = 0; i < ROMANOS.length; i++) {
          const val = ROMANOS[i][0], sim = ROMANOS[i][1];
          let cuenta = 0;
          while (resto >= val) { cuenta++; resto -= val; }
          if (cuenta > 0) {
            rows.push({ k: sim.repeat(cuenta), ref: cuenta + ' × ' + nf(val), v: val * cuenta, format: 'plain' });
            chart.push({ label: sim.repeat(cuenta), value: val * cuenta, tone: 'main' });
          }
        }
        return {
          total: titulo,
          sub: sub + ' Se lee sumando de izquierda a derecha; si un símbolo menor va antes de uno mayor, se resta.',
          rows: rows,
          chart: chart,
          format: 'plain',
        };
      }

      // ---------------- RAMA 4: decimal / binario / hexadecimal ----------------
      const bo = BASES[String(v.baseOrigen || 'decimal')] || BASES.decimal;
      const bd = BASES[String(v.baseDestino || 'binario')] || BASES.binario;
      let t = bruto;
      let neg = false;
      if (t.charAt(0) === '-') { neg = true; t = t.slice(1); }
      else if (t.charAt(0) === '+') t = t.slice(1);
      t = t.replace(/^0x/i, '').replace(/^0b/i, '').replace(/^0o/i, '').toLowerCase();
      if (!t) return vacio('Ingresá un número para convertir.');
      if (!new RegExp(bo.validos).test(t)) {
        return vacio('"' + bruto + '" no es un número ' + bo.nombre + ' válido: se permiten ' + bo.permitidos + '.');
      }
      const dec = parseInt(t, bo.radix);
      if (!isFinite(dec)) return vacio('No se pudo interpretar el número. Revisá el valor y la base de origen.');
      if (dec > Number.MAX_SAFE_INTEGER) {
        return vacio('El número es demasiado grande para convertirlo con exactitud (máximo 9.007.199.254.740.991 en decimal).');
      }
      const signo = neg ? '-' : '';
      const enBase = function (radix) {
        const s = dec.toString(radix);
        return radix === 16 ? s.toUpperCase() : s;
      };

      // Barras: las potencias de 2 activas, que es la lectura real del binario.
      const rows = [], chart = [];
      const bits = dec.toString(2);
      for (let i = 0; i < bits.length; i++) {
        if (bits[i] !== '1') continue;
        const exp = bits.length - 1 - i;
        const peso = Math.pow(2, exp);
        rows.push({ k: 'Bit 2^' + exp, ref: 'posición ' + (exp + 1), v: peso, format: 'plain' });
        chart.push({ label: '2^' + exp, value: peso, tone: 'main' });
      }
      if (!rows.length) rows.push({ k: 'Cero: ningún bit encendido', ref: 'base ' + bo.radix, v: 0, format: 'plain' });

      return {
        total: signo + enBase(bd.radix),
        sub:
          'Decimal ' + signo + dec.toString(10) + ' · binario ' + signo + enBase(2) +
          ' · octal ' + signo + enBase(8) + ' · hexadecimal ' + signo + enBase(16) +
          ' · el decimal es el puente: todas las bases representan la misma cantidad.',
        rows: rows,
        chart: chart,
        format: 'plain',
      };
    });
  })();
</script>
