---
/**
 * Hub de decisión — "Convertir metros, pies y pulgadas"
 * Reemplaza 15 URLs de conversor suelto (ver hub.replaces).
 *
 * Arquetipo CONVERSOR: sin `cases`. La ramificación la hacen el selector de
 * familia y los dos `select` de unidad. La respuesta fija va en hub.answer y la
 * puebla esta página (el runtime sólo llena esas listas cuando el hub ramifica).
 *
 * La página sólo aporta datos (src/lib/hubs/conversor-longitud.ts) y compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, UNITS, SCALE } from '../../lib/hubs/conversor-longitud';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const ANSWER = hub.answer;
const BANDS = hub.chart.bands ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ UNITS, SCALE, ANSWER, BANDS }}>
  (function () {
    const H = window.HC_HUB;

    // Acá los valores son MEDIDAS (m, cm, in, ft, m², ha), no pesos: cada fila
    // viaja con format:'unit', su `unit` real y los decimales que la magnitud
    // necesita (ver decFor). El número NO va dentro del texto de `k`.
    // Parser propio: acepta "1,5" y "1.5" y también "1.200,5" (miles es-AR).
    function numLocal(s) {
      let t = String(s == null ? '' : s).trim().replace(/[^\d.,-]/g, '');
      if (t.indexOf(',') > -1) t = t.replace(/\./g, '').replace(',', '.');
      else if ((t.match(/\./g) || []).length > 1) t = t.replace(/\./g, '');
      const n = Number(t);
      return isFinite(n) ? n : 0;
    }

    function fmt(n) {
      if (!isFinite(n)) return '—';
      const abs = Math.abs(n);
      let d = 2;
      if (abs === 0) d = 0;
      else if (abs < 0.001) d = 8;
      else if (abs < 0.1) d = 5;
      else if (abs < 10) d = 4;
      else if (abs < 1000) d = 2;
      else d = 1;
      return n.toLocaleString('es-AR', { minimumFractionDigits: 0, maximumFractionDigits: d });
    }

    // Decimales adaptativos para el runtime (que usa min=max=decimals).
    // Objetivo: 7 cifras significativas, que es lo que hace falta para que
    // 1.609,344 m o 0,00064516 m² se lean exactos y no "$1.609" / "$0".
    // Piso 2 (nunca un conversor muestra un entero pelado) y techo 12.
    function decFor(n) {
      const abs = Math.abs(Number(n) || 0);
      if (!isFinite(abs) || abs === 0) return 2;
      const exp = Math.floor(Math.log10(abs));
      return Math.max(2, Math.min(12, 6 - exp));
    }

    // El panel de "Respuesta rápida" lo llena el runtime sólo cuando el hub
    // ramifica. Este hub no ramifica, así que lo poblamos nosotros una vez.
    (function fillAnswer() {
      const put = (id, arr) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.replaceChildren();
        (arr || []).forEach((t) => {
          const li = document.createElement('li');
          li.textContent = t;
          el.appendChild(li);
        });
      };
      put('yes-list', ANSWER.yes);
      put('warn-list', ANSWER.warn);
      const p = document.getElementById('plazo');
      if (p) p.textContent = ANSWER.plazo;
    })();

    // Los dos select listan las 20 unidades; según la familia elegida dejamos
    // visibles sólo las que corresponden, para que nadie pida "metros a acres".
    const famSel = document.getElementById('familia');
    const desdeSel = document.getElementById('desde');
    const hastaSel = document.getElementById('hasta');

    function syncOptions() {
      const modo = famSel ? famSel.value : 'longitud';
      const famDesde = modo === 'superficie' ? 'superficie' : 'longitud';
      const famHasta = modo === 'longitud' ? 'longitud' : 'superficie';
      [[desdeSel, famDesde], [hastaSel, famHasta]].forEach(function (par) {
        const sel = par[0], fam = par[1];
        if (!sel) return;
        let visibleSeleccionada = false;
        let primera = null;
        Array.prototype.forEach.call(sel.options, function (o) {
          const u = UNITS[o.value];
          const ok = !!u && u.fam === fam;
          o.hidden = !ok;
          o.disabled = !ok;
          if (ok && !primera) primera = o.value;
          if (ok && o.value === sel.value) visibleSeleccionada = true;
        });
        if (!visibleSeleccionada && primera) sel.value = primera;
      });
    }

    if (famSel) famSel.addEventListener('change', syncOptions);
    syncOptions();

    H.onCompute(function (v) {
      const modo = String(v.familia || 'longitud');
      const valor = numLocal(v.valor);
      const ancho = numLocal(v.ancho);

      let baseM2 = null; // valor en la base de superficie
      let baseM = null;  // valor en la base de longitud
      let sub = '';
      let titulo = '';

      if (modo === 'lineal') {
        // metros lineales × ancho del rollo = metros cuadrados
        if (!valor || !ancho) {
          return { total: '—', sub: 'Completá los metros lineales y el ancho del rollo.', rows: [], chart: [] };
        }
        baseM2 = valor * ancho;
        baseM = Math.sqrt(baseM2);
        titulo = fmt(baseM2) + ' m²';
        sub =
          fmt(valor) + ' metros lineales × ' + fmt(ancho) + ' m de ancho = ' + fmt(baseM2) +
          ' m² · equivale a un cuadrado de ' + fmt(baseM) + ' m de lado';
      } else {
        const uD = UNITS[String(v.desde)] || UNITS.m;
        const uH = UNITS[String(v.hasta)] || UNITS.m;
        if (uD.fam !== uH.fam) {
          return {
            total: '—',
            sub: 'No se puede convertir ' + uD.name.toLowerCase() + ' a ' + uH.name.toLowerCase() +
              ': una es longitud y la otra superficie. Para pasar de largo a área necesitás un ancho (opción "Metros lineales → metros cuadrados").',
            rows: [],
            chart: [],
          };
        }
        const base = valor * uD.f;
        const salida = base / uH.f;
        titulo = fmt(salida) + ' ' + uH.sym;
        sub =
          fmt(valor) + ' ' + uD.sym + ' = ' + fmt(salida) + ' ' + uH.sym +
          ' · factor 1 ' + uD.sym + ' = ' + fmt(uD.f / uH.f) + ' ' + uH.sym;
        if (uD.fam === 'superficie') {
          baseM2 = base;
          baseM = Math.sqrt(base);
        } else {
          baseM = base;
        }
      }

      // Desglose: la medida en todas las unidades de su familia.
      const fam = modo === 'longitud' ? 'longitud' : 'superficie';
      const destino = modo === 'lineal' ? 'm2' : String(v.hasta);
      const rows = [];
      Object.keys(UNITS).forEach(function (k) {
        const u = UNITS[k];
        if (u.fam !== fam) return;
        const val = fam === 'longitud' ? baseM / u.f : baseM2 / u.f;
        rows.push({
          k: u.name,
          v: val,
          extra: k === destino,
          format: 'unit',
          unit: u.sym,
          decimals: decFor(val),
        });
      });

      // Regla comparativa 1 mm → 1 km en escala logarítmica. Para superficie
      // ubicamos el lado del cuadrado equivalente, que es lo que se puede ver.
      const metrosVisibles = fam === 'longitud' ? baseM : baseM2 != null ? Math.sqrt(baseM2) : 0;
      const lo = Math.log10(SCALE.min), hi = Math.log10(SCALE.max);
      const pos = metrosVisibles > 0
        ? Math.max(0, Math.min(100, ((Math.log10(metrosVisibles) - lo) / (hi - lo)) * 100))
        : 0;

      const chart = BANDS.map(function (b) {
        return {
          label: b.label,
          value: Math.log10(b.to) - Math.log10(b.from),
          tone: b.tone === 'good' ? 'good' : b.tone === 'warn' ? 'warn' : 'main',
        };
      });

      // Referencia reconocible más cercana a la medida.
      let ref = SCALE.refs[0];
      SCALE.refs.forEach(function (r) {
        if (Math.abs(Math.log10(r.m) - Math.log10(metrosVisibles || 1)) <
            Math.abs(Math.log10(ref.m) - Math.log10(metrosVisibles || 1))) ref = r;
      });
      const veces = metrosVisibles > 0 ? metrosVisibles / ref.m : 0;
      const comparacion = metrosVisibles > 0
        ? (Math.abs(veces - 1) < 0.02
            ? 'prácticamente ' + ref.label
            : veces >= 1
              ? fmt(veces) + ' veces ' + ref.label
              : 'un ' + fmt(veces * 100) + '% de ' + ref.label)
        : '';

      return {
        total: titulo,
        sub: sub + (comparacion ? ' · ' + comparacion : ''),
        rows: rows,
        chart: chart,
        // Formato por defecto: las franjas del gráfico valen décadas de la
        // escala logarítmica, no pesos. Cada fila del desglose lo pisa con su
        // propia unidad.
        format: 'unit',
        unit: 'década',
        decimals: 0,
        position: Number(pos.toFixed(1)),
        positionLabel:
          titulo + (fam === 'superficie' ? ' — lado equivalente ' + fmt(metrosVisibles) + ' m' : '') +
          (comparacion ? ' — ' + comparacion : ''),
      };
    });
  })();
</script>
