---
/**
 * Hub de decisión — "Convertir Celsius, Fahrenheit y Kelvin"
 * Reemplaza 5 URLs de conversor suelto (ver hub.replaces).
 *
 * Arquetipo CONVERSOR: sin `cases`. La ramificación la hacen los dos `select`
 * de escala y los campos opcionales de viento/humedad, que encienden la lectura
 * de clima. La respuesta fija va en hub.answer y la puebla esta página (el
 * runtime sólo llena esas listas cuando el hub ramifica).
 *
 * La página sólo aporta datos (src/lib/hubs/convertir-temperatura.ts) y compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  SCALES,
  CERO_ABSOLUTO_C,
  SCALE_RANGE,
  REFS,
  ROPA,
} from '../../lib/hubs/convertir-temperatura';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const ANSWER = hub.answer;
const BANDS = hub.chart.bands ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ SCALES, CERO_ABSOLUTO_C, SCALE_RANGE, REFS, ROPA, ANSWER, BANDS }}
>
  (function () {
    const H = window.HC_HUB;

    // Los valores acá son GRADOS, no pesos: toda fila del desglose viaja con
    // format:'unit' y el símbolo real de su escala. Sin eso el runtime las
    // imprimiría en $ (el default del contrato es 'ars').

    // Parser propio: acepta "-1,5", "-1.5" y también "1.200,5" (miles es-AR).
    // El signo menos importa: en temperatura es la mitad de los casos.
    function numLocal(s) {
      let t = String(s == null ? '' : s).trim().replace(/\s/g, '');
      if (!t) return null;
      const neg = /^[-−]/.test(t);
      t = t.replace(/[^\d.,]/g, '');
      if (!t) return null;
      if (t.indexOf(',') > -1) t = t.replace(/\./g, '').replace(',', '.');
      else if ((t.match(/\./g) || []).length > 1) t = t.replace(/\./g, '');
      const n = Number(t);
      if (!isFinite(n)) return null;
      return neg ? -n : n;
    }

    function fmt(n, d) {
      if (!isFinite(n)) return '—';
      return n.toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });
    }

    // Decimales adaptativos: 2 alcanza para clima y cocina, pero un valor chico
    // (0,05 °C) o el cero absoluto (−273,15) necesitan ver la parte decimal.
    function decFor(n) {
      const abs = Math.abs(Number(n) || 0);
      if (abs !== 0 && abs < 0.01) return 4;
      return 2;
    }

    const toC = (v, s) => (v - s.off) * s.k;
    const fromC = (c, s) => c / s.k + s.off;

    // El panel de "Respuesta rápida" lo llena el runtime sólo cuando el hub
    // ramifica. Este hub no ramifica, así que lo poblamos nosotros una vez.
    (function fillAnswer() {
      const put = (id, arr) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.replaceChildren();
        (arr || []).forEach((t) => {
          const li = document.createElement('li');
          li.textContent = t;
          el.appendChild(li);
        });
      };
      put('yes-list', ANSWER.yes);
      put('warn-list', ANSWER.warn);
      const p = document.getElementById('plazo');
      if (p) p.textContent = ANSWER.plazo;
    })();

    function ropaDe(c) {
      for (let i = 0; i < ROPA.length; i++) if (c < ROPA[i].max) return ROPA[i].texto;
      return ROPA[ROPA.length - 1].texto;
    }

    /** Referencia reconocible más cercana, en °C. */
    function refDe(c) {
      let best = REFS[0];
      REFS.forEach(function (r) {
        if (Math.abs(r.c - c) < Math.abs(best.c - c)) best = r;
      });
      return best;
    }

    H.onCompute(function (v) {
      const sD = SCALES[String(v.desde)] || SCALES.c;
      const sH = SCALES[String(v.hasta)] || SCALES.c;
      const valor = numLocal(v.valor);

      if (valor === null) {
        return { total: '—', sub: 'Escribí una temperatura para convertirla.', rows: [], chart: [] };
      }

      // --- Guarda del cero absoluto -------------------------------------
      // Se valida en Celsius, que es donde vive el piso físico. Con esto
      // Kelvin y Rankine nunca pueden salir negativos: si el valor de entrada
      // cae por debajo, no hay conversión que devolver.
      const c = toC(valor, sD);
      if (c < CERO_ABSOLUTO_C - 1e-9) {
        return {
          total: '—',
          sub:
            fmt(valor, decFor(valor)) + ' ' + sD.sym + ' está por debajo del cero absoluto. En ' +
            sD.sym + ' el piso es ' + fmt(sD.min, 2) + ' ' + sD.sym +
            ', que equivale a −273,15 °C y a 0 K. No existe una temperatura más baja: revisá el valor o la escala de origen.',
          rows: [],
          chart: [],
        };
      }

      const salida = fromC(c, sH);
      const f = fromC(c, SCALES.f);
      const k = fromC(c, SCALES.k);
      const r = fromC(c, SCALES.r);

      // --- Lectura de clima ---------------------------------------------
      // Sensación térmica por viento: fórmula oficial de Environment Canada,
      // válida sólo con ≤10 °C y viento >4,8 km/h.
      const viento = Math.max(0, numLocal(v.viento) || 0);
      const hum = Math.min(100, Math.max(0, numLocal(v.humedad) === null ? 50 : numLocal(v.humedad)));
      let sensacion = null;
      if (c <= 10 && viento > 4.8) {
        sensacion =
          13.12 + 0.6215 * c - 11.37 * Math.pow(viento, 0.16) + 0.3965 * c * Math.pow(viento, 0.16);
      }
      // Índice de calor: ecuación de Rothfusz (NWS), en °F, desde 27 °C.
      let indice = null;
      if (c >= 27) {
        const hi =
          -42.379 + 2.04901523 * f + 10.14333127 * hum - 0.22475541 * f * hum -
          0.00683783 * f * f - 0.05481717 * hum * hum + 0.00122874 * f * f * hum +
          0.00085282 * f * hum * hum - 0.00000199 * f * f * hum * hum;
        indice = ((hi - 32) * 5) / 9;
      }

      // --- Desglose: las cuatro escalas ---------------------------------
      const rows = [
        { key: 'c', val: c }, { key: 'f', val: f }, { key: 'k', val: k }, { key: 'r', val: r },
      ].map(function (o) {
        const s = SCALES[o.key];
        return {
          k: s.name,
          v: o.val,
          extra: o.key === String(v.hasta),
          format: 'unit',
          unit: s.sym,
          decimals: decFor(o.val),
        };
      });

      if (sensacion !== null) {
        rows.push({
          k: 'Sensación térmica con ' + fmt(viento, 0) + ' km/h de viento',
          ref: 'Environment Canada',
          v: sensacion,
          format: 'unit',
          unit: '°C',
          decimals: 1,
        });
      }
      if (indice !== null) {
        rows.push({
          k: 'Índice de calor con ' + fmt(hum, 0) + '% de humedad',
          ref: 'NWS Rothfusz',
          v: indice,
          format: 'unit',
          unit: '°C',
          decimals: 1,
        });
      }

      // --- Regla posicional ----------------------------------------------
      const lo = SCALE_RANGE.min, hi2 = SCALE_RANGE.max;
      const pos = Math.max(0, Math.min(100, ((c - lo) / (hi2 - lo)) * 100));
      const fueraDeRango = c < lo ? ' (fuera de la regla, por debajo de ' + lo + ' °C)'
        : c > hi2 ? ' (fuera de la regla, por encima de ' + hi2 + ' °C)' : '';

      const chart = BANDS.map(function (b) {
        return {
          label: b.label,
          value: b.to - b.from,
          from: b.from,
          to: b.to,
          tone: b.tone === 'good' ? 'good' : b.tone === 'bad' ? 'bad' : 'warn',
        };
      });

      const ref = refDe(c);
      const cerca = Math.abs(c - ref.c) < 1.5
        ? 'prácticamente ' + ref.label
        : (c > ref.c ? fmt(c - ref.c, 1) + ' °C por encima de ' : fmt(ref.c - c, 1) + ' °C por debajo de ') + ref.label;

      let lectura = ropaDe(c);
      if (sensacion !== null) {
        lectura = 'Con el viento se siente como ' + fmt(sensacion, 1) + ' °C. ' + lectura;
      } else if (indice !== null) {
        lectura = 'Con la humedad se siente como ' + fmt(indice, 1) + ' °C. ' + lectura;
      }
      if (c <= 3 && c >= -5) {
        lectura = 'Riesgo de helada: a ras del suelo puede haber 2 o 3 grados menos que en el aire. ' + lectura;
      }

      const dec = decFor(salida);
      return {
        total: fmt(salida, dec) + ' ' + sH.sym,
        sub:
          fmt(valor, decFor(valor)) + ' ' + sD.sym + ' = ' + fmt(salida, dec) + ' ' + sH.sym +
          ' · ' + cerca + ' · ' + lectura,
        rows: rows,
        chart: chart,
        // Default del resultado: las franjas del gráfico valen grados Celsius.
        // Cada fila del desglose lo pisa con su propia escala.
        format: 'unit',
        unit: '°C',
        decimals: 0,
        position: Number(pos.toFixed(1)),
        positionLabel: fmt(c, decFor(c)) + ' °C — ' + cerca + fueraDeRango,
      };
    });
  })();
</script>
