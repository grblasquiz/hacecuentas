---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConversorTemperaturaExperience from '../../components/generated/ConversorTemperaturaExperience.astro';
import { hub } from '../../lib/hubs/convertir-temperatura';
const canonical='https://hacecuentas.com/conversores/temperatura';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <ConversorTemperaturaExperience />
  <Footer />
</Layout>
