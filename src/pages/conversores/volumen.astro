---
/**
 * Hub de decisión — "Convertir litros, galones y onzas"
 * Reemplaza 3 URLs de conversor suelto (ver hub.replaces).
 *
 * Arquetipo CONVERSOR: sin `cases`. La ramificación la hacen los dos `select`
 * de unidad. La respuesta fija va en hub.answer y la puebla esta página (el
 * runtime sólo llena esas listas cuando el hub ramifica).
 *
 * La página sólo aporta datos (src/lib/hubs/convertir-volumen.ts) y compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, UNITS, SCALE } from '../../lib/hubs/convertir-volumen';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const ANSWER = hub.answer;
const BANDS = hub.chart.bands ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ UNITS, SCALE, ANSWER, BANDS }}>
  (function () {
    const H = window.HC_HUB;

    // Acá los valores son VOLÚMENES (ml, l, gal, fl oz), no plata: cada fila
    // viaja con format:'unit', su `unit` real y los decimales que la magnitud
    // necesita (ver decFor). El número NO va dentro del texto de `k`.
    // Parser propio: acepta "1,5" y "1.5" y también "1.200,5" (miles es-AR).
    function numLocal(s) {
      let t = String(s == null ? '' : s).trim().replace(/[^\d.,-]/g, '');
      if (t.indexOf(',') > -1) t = t.replace(/\./g, '').replace(',', '.');
      else if ((t.match(/\./g) || []).length > 1) t = t.replace(/\./g, '');
      const n = Number(t);
      return isFinite(n) ? n : 0;
    }

    function fmt(n) {
      if (!isFinite(n)) return '—';
      const abs = Math.abs(n);
      let d = 2;
      if (abs === 0) d = 0;
      else if (abs < 0.001) d = 8;
      else if (abs < 0.1) d = 5;
      else if (abs < 10) d = 4;
      else if (abs < 1000) d = 2;
      else d = 1;
      return n.toLocaleString('es-AR', { minimumFractionDigits: 0, maximumFractionDigits: d });
    }

    // Decimales adaptativos para el runtime (que usa min=max=decimals).
    // Objetivo: 7 cifras significativas, para que 29,5735296 ml o
    // 0,0002641721 m³ se lean exactos y no "$30" / "$0".
    function decFor(n) {
      const abs = Math.abs(Number(n) || 0);
      if (!isFinite(abs) || abs === 0) return 2;
      const exp = Math.floor(Math.log10(abs));
      return Math.max(2, Math.min(12, 6 - exp));
    }

    // El panel de "Respuesta rápida" lo llena el runtime sólo cuando el hub
    // ramifica. Este hub no ramifica, así que lo poblamos nosotros una vez.
    (function fillAnswer() {
      const put = (id, arr) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.replaceChildren();
        (arr || []).forEach((t) => {
          const li = document.createElement('li');
          li.textContent = t;
          el.appendChild(li);
        });
      };
      put('yes-list', ANSWER.yes);
      put('warn-list', ANSWER.warn);
      const p = document.getElementById('plazo');
      if (p) p.textContent = ANSWER.plazo;
    })();

    H.onCompute(function (v) {
      const valor = numLocal(v.valor);
      const uD = UNITS[String(v.desde)] || UNITS.l;
      const uH = UNITS[String(v.hasta)] || UNITS.l;

      // Siempre se DIVIDE por el factor exacto de destino: nunca se multiplica
      // por un recíproco redondeado (ver nota de factores en el .ts).
      const ml = valor * uD.f;
      const salida = ml / uH.f;

      const titulo = fmt(salida) + ' ' + uH.sym;
      let sub =
        fmt(valor) + ' ' + uD.sym + ' = ' + fmt(salida) + ' ' + uH.sym +
        ' · factor 1 ' + uD.sym + ' = ' + fmt(uD.f / uH.f) + ' ' + uH.sym;

      // Las dos trampas del volumen: los dos galones y las dos onzas.
      const esGal = uD === UNITS.gal_us || uH === UNITS.gal_us || uD === UNITS.gal_uk || uH === UNITS.gal_uk;
      const esOz = uD === UNITS.oz_us || uH === UNITS.oz_us || uD === UNITS.oz_uk || uH === UNITS.oz_uk;
      if (esGal) {
        sub += ' · ojo: el galón imperial es un 20,09% más grande que el US (' +
          fmt(ml / UNITS.gal_us.f) + ' gal US vs ' + fmt(ml / UNITS.gal_uk.f) + ' gal UK)';
      }
      if (esOz) {
        sub += ' · con la otra onza líquida el número cambia un 4,08% (' +
          fmt(ml / UNITS.oz_us.f) + ' fl oz US vs ' + fmt(ml / UNITS.oz_uk.f) + ' fl oz UK)';
      }

      const destino = String(v.hasta);
      const rows = Object.keys(UNITS).map(function (k) {
        const u = UNITS[k];
        const val = ml / u.f;
        return {
          k: u.name,
          v: val,
          extra: k === destino,
          format: 'unit',
          unit: u.sym,
          decimals: decFor(val),
        };
      });

      // Regla comparativa 1 ml → 1000 L en escala logarítmica.
      const lo = Math.log10(SCALE.min), hi = Math.log10(SCALE.max);
      const pos = ml > 0
        ? Math.max(0, Math.min(100, ((Math.log10(ml) - lo) / (hi - lo)) * 100))
        : 0;

      const chart = BANDS.map(function (b) {
        return {
          label: b.label,
          value: Math.log10(b.to) - Math.log10(b.from),
          tone: b.tone === 'good' ? 'good' : b.tone === 'warn' ? 'warn' : 'main',
        };
      });

      // Referencia reconocible más cercana al volumen.
      let ref = SCALE.refs[0];
      SCALE.refs.forEach(function (r) {
        if (Math.abs(Math.log10(r.ml) - Math.log10(ml || 1)) <
            Math.abs(Math.log10(ref.ml) - Math.log10(ml || 1))) ref = r;
      });
      const veces = ml > 0 ? ml / ref.ml : 0;
      const comparacion = ml > 0
        ? (Math.abs(veces - 1) < 0.02
            ? 'prácticamente ' + ref.label
            : veces >= 1
              ? fmt(veces) + ' veces ' + ref.label
              : 'un ' + fmt(veces * 100) + '% de ' + ref.label)
        : '';

      return {
        total: titulo,
        sub: sub + (comparacion ? ' · ' + comparacion : ''),
        rows: rows,
        chart: chart,
        // Formato por defecto: las franjas del gráfico valen décadas de la
        // escala logarítmica, no pesos. Cada fila del desglose lo pisa con su
        // propia unidad.
        format: 'unit',
        unit: 'década',
        decimals: 0,
        position: Number(pos.toFixed(1)),
        positionLabel: titulo + (comparacion ? ' — ' + comparacion : ''),
      };
    });
  })();
</script>
