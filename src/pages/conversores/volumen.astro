---
/**
 * Hub de decisión — "Convertir litros, galones y onzas"
 * Reemplaza 3 URLs de conversor suelto (ver hub.replaces).
 *
 * Arquetipo CONVERSOR: sin `cases`. La ramificación la hacen los dos `select`
 * de unidad. La respuesta fija va en hub.answer y la puebla esta página (el
 * runtime sólo llena esas listas cuando el hub ramifica).
 *
 * La página sólo aporta datos (src/lib/hubs/convertir-volumen.ts) y compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import ConversorVolumenExperience from '../../components/generated/ConversorVolumenExperience.astro';
import { hub, UNITS, SCALE } from '../../lib/hubs/convertir-volumen';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const ANSWER = hub.answer;
const BANDS = hub.chart.bands ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ConversorVolumenExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

