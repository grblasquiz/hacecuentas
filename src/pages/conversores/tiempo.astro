---
/**
 * Hub de decisión — "¿Cuánto es esto en otra unidad de tiempo?"
 * Reemplaza 5 URLs de conversor suelto (ver hub.replaces).
 *
 * Sigue el patrón de matematica/regla-de-tres.astro: la página sólo aporta
 * los datos (src/lib/hubs/conversor-de-tiempo.ts) y su compute(). El chrome,
 * el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 *
 * Los días por año NO se duplican acá: se serializan con define:vars desde
 * DIAS_POR_ANO, que es el único lugar donde viven las cuatro convenciones.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConversorTiempoExperience from '../../components/generated/ConversorTiempoExperience.astro';
import { hub, DIAS_POR_ANO } from '../../lib/hubs/conversor-de-tiempo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ConversorTiempoExperience data={hub} />
  <Footer />
</Layout>

