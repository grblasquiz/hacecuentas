---
/**
 * Hub de decisión — "¿Qué talle soy?"
 * Reemplaza 11 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cuatro ramas (ropa, calzado, corpiño, anillo). El
 * runtime de DecisionHub llena las listas de "Qué te corresponde" desde
 * hub.cases; esta página sólo aporta los datos y compute().
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito
 * ('unit' con cm/mm/pulgadas o 'plain' para el número de talle).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import TallesExperience from '../../components/generated/TallesExperience.astro';
import NextTenBoost from '../../components/NextTenBoost.astro';
import { hub, ROPA, CALZADO, COPAS, UK_ANILLO, SCALES } from '../../lib/hubs/talles';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
    { '@type': 'WebApplication', name: hub.title, url: CANONICAL, applicationCategory: 'ShoppingApplication', operatingSystem: 'Web', dateModified: hub.lastReviewed, offers: { '@type': 'Offer', price: '0', priceCurrency: 'ARS' } },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <TallesExperience data={hub} />
  <NextTenBoost variant="sizes" />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>
