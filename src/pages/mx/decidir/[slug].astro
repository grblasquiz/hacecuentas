---
export const prerender = true;

import DecisionIntlRoomPage from '../../../components/DecisionIntlRoomPage.astro';
import { DECISION_COUNTRIES } from '../../../lib/decisions/locales';
import { roomsOfCountry } from '../../../lib/decisions/locales-registry';

export async function getStaticPaths() {
  return roomsOfCountry('mx').map((room) => ({
    params: { slug: room.slug },
    props: { room },
  }));
}

const { room } = Astro.props;
---

<DecisionIntlRoomPage country={DECISION_COUNTRIES.mx} room={room} />
