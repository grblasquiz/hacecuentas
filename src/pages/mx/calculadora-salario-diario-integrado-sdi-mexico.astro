---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SalarioDiarioIntegradoMexicoExperience from '../../components/generated/SalarioDiarioIntegradoMexicoExperience.astro';

const canonical = 'https://hacecuentas.com/mx/calculadora-salario-diario-integrado-sdi-mexico';
const title = 'Calculadora de Salario Diario Integrado (SDI) México 2026';
const description = 'Calcula tu Salario Diario Integrado por hora y día con aguinaldo, vacaciones, prima vacacional, prestaciones y tope de 25 UMA para el IMSS.';
const faq = [
  ['¿Qué es el Salario Diario Integrado?', 'Es el salario diario más la parte proporcional de las prestaciones que integran, como aguinaldo, vacaciones y prima vacacional.'],
  ['¿Cómo se calcula el factor de integración?', 'Se suman 365 días, los días de aguinaldo y el resultado de multiplicar vacaciones por prima vacacional; luego se divide entre 365.'],
  ['¿Cuántos días de vacaciones se consideran?', 'Dependen de los años cumplidos de antigüedad conforme a la tabla vigente de la Ley Federal del Trabajo.'],
  ['¿El SDI y el SBC son lo mismo?', 'El SDI sirve para integrar la remuneración diaria. El SBC es la base reportada al IMSS y está sujeto al límite legal de 25 UMA.'],
  ['¿Cuál es el tope del SBC en 2026?', 'La calculadora aplica un máximo de 25 UMA diarias, equivalente a 2.932,75 pesos por día con la UMA usada para 2026.'],
  ['¿Puedo incluir prestaciones superiores a la ley?', 'Sí. Puedes cambiar los días de aguinaldo, la prima vacacional y agregar prestaciones fijas mensuales que integren.'],
  ['¿La calculadora sustituye el cálculo de nómina?', 'No. Es una estimación orientativa; la integración definitiva depende de las prestaciones y condiciones reales del trabajador.'],
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name: title, url: canonical, applicationCategory: 'FinanceApplication', operatingSystem: 'Web' },
    { '@type': 'FAQPage', mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } })) },
    { '@type':'BreadcrumbList', itemListElement:[
      { '@type':'ListItem', position:1, name:'Inicio', item:'https://hacecuentas.com/mx' },
      { '@type':'ListItem', position:2, name:'Trabajo', item:'https://hacecuentas.com/mx/trabajo' },
      { '@type':'ListItem', position:3, name:'Salario Diario Integrado', item:canonical },
    ]},
  ],
};
---
<Layout title={title} description={description} canonical={canonical} schema={schema} audience="MX" lang="es" ogType="article" articleSection="Trabajo">
  <Header />
  <SalarioDiarioIntegradoMexicoExperience />
  <Footer />
</Layout>
