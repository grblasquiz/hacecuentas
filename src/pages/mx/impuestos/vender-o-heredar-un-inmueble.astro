---
/**
 * Hub de decisión MX — impuestos al vender, heredar, donar o escriturar un inmueble.
 * audience="MX" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, INMUEBLE_MX } from '../../../lib/hubs/mx/vender-o-heredar-un-inmueble';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ I: INMUEBLE_MX }}>
  (function () {
    const H = window.HC_HUB;
    const mxn = (n) => '$' + Math.round(n || 0).toLocaleString('es-MX');

    /** ISR anual 2026 — tarifa del Art. 152 LISR (Anexo 8 RMF 2026). */
    function isrAnual(base) {
      if (!isFinite(base) || base <= 0) return 0;
      const t = I.tarifaAnual;
      for (let k = 0; k < t.length; k++) {
        const limInf = t[k][0], limSup = t[k][1], cuota = t[k][2], tasa = t[k][3];
        if (base >= limInf && base <= limSup) return cuota + (base - limInf) * tasa;
      }
      const u = t[t.length - 1];
      return u[2] + (base - u[0]) * u[3];
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'casa';
      const valor = Math.max(0, v.valor || 0);
      const tasaIsai = Math.min(10, Math.max(0, v.tasaIsai || 0)) / 100;
      const tasaNotaria = Math.min(10, Math.max(0, v.tasaNotaria || 0)) / 100;
      const tasaRegistro = Math.min(10, Math.max(0, v.tasaRegistro || 0)) / 100;

      // ── Caso 3: herencia o donación ────────────────────────────────────
      if (id === 'herencia') {
        const isai = valor * tasaIsai;
        const notario = valor * tasaNotaria;
        const registro = valor * tasaRegistro;

        const tipo = v.tipoTransmision || 'herencia';
        let isr = 0;
        let nota;
        if (tipo === 'herencia') {
          nota = 'La herencia está exenta de ISR para el heredero. Solo hay que informarla en la declaración anual cuando el total de ingresos exentos del año supera el umbral de la ley.';
        } else if (tipo === 'donacion-directa') {
          nota = 'La donación entre cónyuges, ascendientes y descendientes en línea recta está exenta de ISR sin límite de monto.';
        } else {
          const exencion = I.umasExencionDonacionTerceros * I.umaAnual;
          isr = isrAnual(Math.max(0, valor - exencion));
          nota = 'La donación a una persona fuera de la línea recta solo está exenta hasta ' + mxn(exencion) +
            ' (3 UMA anuales); el excedente se acumula a tus ingresos y causa ISR.';
        }

        const total = isai + notario + registro + isr;
        return {
          total: mxn(total),
          sub:
            'Transmitir un inmueble de ' + mxn(valor) + ' cuesta alrededor de ' + mxn(total) + ', o sea el ' +
            (valor > 0 ? ((total / valor) * 100).toFixed(2).replace('.', ',') : '0') + '% de su valor. ' + nota,
          rows: [
            { k: 'Valor del inmueble', v: valor },
            { k: 'ISAI del municipio', ref: 'impuesto local', v: isai, extra: true },
            { k: 'Honorarios de notaría', v: notario },
            { k: 'Derechos del Registro Público', v: registro },
            { k: 'ISR por la transmisión', ref: 'LISR Art. 93', v: isr },
            { k: 'Costo total de transmitir', v: total },
            { k: 'Costo sobre el valor del inmueble', v: valor > 0 ? (total / valor) * 100 : 0, format: 'unit', unit: '%', decimals: 2 },
          ],
          chart: [
            { label: 'ISAI', value: isai, tone: 'warn' },
            { label: 'Notaría', value: notario, tone: 'prop' },
            { label: 'Registro', value: registro, tone: 'exit' },
            { label: 'ISR', value: isr, tone: 'bad' },
          ],
        };
      }

      // ── Caso 4: gastos de escrituración al comprar ─────────────────────
      if (id === 'escriturar') {
        const isai = valor * tasaIsai;
        const notario = valor * tasaNotaria;
        const registro = valor * tasaRegistro;
        const extras = Math.max(0, v.extras || 0);
        const cierre = isai + notario + registro + extras;
        const dineroTotal = valor + cierre;

        return {
          total: mxn(cierre),
          sub:
            'Gastos de cierre por encima del precio: el ' + (valor > 0 ? ((cierre / valor) * 100).toFixed(2).replace('.', ',') : '0') +
            '% del valor del inmueble. Para firmar necesitas ' + mxn(dineroTotal) + ' en total, y el crédito hipotecario no financia esta parte.',
          rows: [
            { k: 'Precio del inmueble', v: valor },
            { k: 'ISAI', ref: 'impuesto local de adquisición', v: isai, extra: true },
            { k: 'Honorarios de notaría', v: notario },
            { k: 'Derechos del Registro Público', v: registro },
            { k: 'Avalúo, gestoría y trámites', v: extras },
            { k: 'Total de gastos de escrituración', v: cierre },
            { k: 'Dinero necesario para cerrar', v: dineroTotal },
            { k: 'Gastos sobre el precio', v: valor > 0 ? (cierre / valor) * 100 : 0, format: 'unit', unit: '%', decimals: 2 },
          ],
          chart: [
            { label: 'ISAI', value: isai, tone: 'warn' },
            { label: 'Notaría', value: notario, tone: 'prop' },
            { label: 'Registro', value: registro, tone: 'exit' },
            { label: 'Avalúo y gestoría', value: extras, tone: 'main' },
          ],
        };
      }

      // ── Casos 1 y 2: venta de inmueble ─────────────────────────────────
      const costo = Math.max(0, v.costo || 0);
      const gastos = Math.max(0, v.gastos || 0);
      const anios = Math.min(I.maxAniosTenencia, Math.max(1, Math.floor(v.anios || 1)));
      const gananciaTotal = Math.max(0, valor - costo - gastos);

      let exento = 0;
      let gravable = gananciaTotal;
      let exencionMXN = 0;

      if (id === 'casa' && String(v.exencion || 'si') !== 'no') {
        const udi = Number(v.udi) > 0 ? Number(v.udi) : I.valorUdi;
        exencionMXN = I.exencionUdis * udi;
        if (valor <= exencionMXN) {
          gravable = 0;
        } else {
          // Art. 93-XIX: la ganancia se grava en la proporción excedente/precio.
          gravable = gananciaTotal * ((valor - exencionMXN) / valor);
        }
      }
      exento = gananciaTotal - gravable;

      // Art. 120: la ganancia se divide entre los años de tenencia, se aplica la tarifa anual
      // y el resultado se multiplica por los mismos años.
      const isr = isrAnual(gravable / anios) * anios;
      const provisional = id === 'terreno' ? gananciaTotal * I.pagoProvisionalEntidad : 0;
      const neto = valor - costo - gastos - isr;
      const tasaEfectiva = gananciaTotal > 0 ? (isr / gananciaTotal) * 100 : 0;

      const rows = [
        { k: 'Precio de venta', v: valor },
        { k: 'Costo de adquisición', v: costo },
        { k: 'Gastos y mejoras comprobadas', v: gastos },
        { k: 'Ganancia total de la operación', v: gananciaTotal },
      ];
      if (id === 'casa') {
        rows.push({ k: 'Exención de 700.000 UDIS en pesos', ref: 'LISR Art. 93-XIX', v: exencionMXN });
        rows.push({ k: 'Ganancia exenta', v: exento });
      }
      rows.push({ k: 'Ganancia gravable', v: gravable });
      rows.push({ k: 'Años de tenencia aplicados', ref: 'LISR Art. 120', v: anios, format: 'unit', unit: 'años' });
      rows.push({ k: 'ISR estimado de la venta', v: isr, extra: true });
      if (id === 'terreno') {
        rows.push({ k: 'Pago provisional del 5% ante notario', ref: 'LISR Art. 127', v: provisional });
        rows.push({ k: 'Diferencia contra el ISR anual', v: isr - provisional });
      }
      rows.push({ k: 'Tasa efectiva sobre la ganancia', v: tasaEfectiva, format: 'unit', unit: '%', decimals: 1 });
      rows.push({ k: 'Te queda después de impuestos', v: neto });

      let sub;
      if (gananciaTotal === 0) {
        sub = 'No hay ganancia: vendes en ' + mxn(valor) + ' con un costo total de ' + mxn(costo + gastos) + '. Sin ganancia no hay ISR.';
      } else if (gravable === 0) {
        sub = 'Venta exenta: el precio de ' + mxn(valor) + ' no supera las 700.000 UDIS (' + mxn(exencionMXN) +
          '). Recuerda acreditar ante notario que es tu casa habitación y no haber usado la exención en 3 años.';
      } else if (id === 'casa') {
        sub = 'El precio supera la exención de ' + mxn(exencionMXN) + ': se grava la ganancia en proporción al excedente. ' +
          'ISR estimado ' + mxn(isr) + ' (' + tasaEfectiva.toFixed(1).replace('.', ',') + '% de la ganancia), que retiene el notario al firmar.';
      } else {
        sub = 'Sin exención: toda la ganancia de ' + mxn(gananciaTotal) + ' es gravable. El notario entera ' + mxn(provisional) +
          ' de pago provisional a la entidad federativa, a cuenta de un ISR anual estimado de ' + mxn(isr) + '.';
      }

      return {
        total: mxn(isr),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Costo y gastos recuperados', value: costo + gastos, tone: 'main' },
          { label: 'Ganancia exenta', value: exento, tone: 'good' },
          { label: 'ISR estimado', value: isr, tone: 'warn' },
          { label: 'Ganancia gravada neta de ISR', value: Math.max(0, gravable - isr), tone: 'prop' },
        ],
      };
    });
  })();
</script>
