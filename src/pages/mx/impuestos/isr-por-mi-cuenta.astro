---
/**
 * Hub de decisión MX — ISR facturando por cuenta propia: RESICO, régimen general,
 * retenciones de honorarios, plataformas digitales y asimilados a salarios.
 * audience="MX" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, FACTURO_MX } from '../../../lib/hubs/mx/isr-por-mi-cuenta';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ F: FACTURO_MX }}>
  (function () {
    const H = window.HC_HUB;
    const mxn = (n) => '$' + Math.round(n || 0).toLocaleString('es-MX');

    /** Tarifa progresiva mensual del Art. 96 LISR (Anexo 8 RMF 2026). */
    function isrMensual(base) {
      if (!isFinite(base) || base <= 0) return 0;
      for (let k = 0; k < F.tarifaMensual.length; k++) {
        const f = F.tarifaMensual[k];
        const limSup = f[1] === null ? Infinity : f[1];
        if (base >= f[0] && base <= limSup) {
          return Math.round((f[2] + (base - f[0]) * f[3]) * 100) / 100;
        }
      }
      const last = F.tarifaMensual[F.tarifaMensual.length - 1];
      return Math.round((last[2] + (base - last[0]) * last[3]) * 100) / 100;
    }

    /** Tasa de RESICO según el ingreso mensual cobrado (LISR Art. 113-E). */
    function tasaResico(ingresoMensual) {
      for (let k = 0; k < F.resico.tabla.length; k++) {
        const lim = F.resico.tabla[k][0] === null ? Infinity : F.resico.tabla[k][0];
        if (ingresoMensual <= lim) return F.resico.tabla[k][1];
      }
      return F.resico.tabla[F.resico.tabla.length - 1][1];
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'factura';

      const ingreso = Math.max(0, v.ingresoMensual || 0);
      const gastos = Math.min(Math.max(0, v.deduccionesMensuales || 0), ingreso);
      const esMoral = v.tipoCliente !== 'fisica';

      // Comunes a las comparaciones de régimen.
      const utilidad = Math.max(0, ingreso - gastos);
      const isrGeneral = isrMensual(utilidad);
      const tasaRes = tasaResico(ingreso);
      const cuotaResico = ingreso * tasaRes;

      // ── Caso 2: cuota de RESICO ────────────────────────────────────────
      if (id === 'resico') {
        const anualizado = cuotaResico * 12;
        const proyeccionAnual = ingreso * 12;
        const rebasa = proyeccionAnual > F.resico.topeAnual;
        const retPm = esMoral ? ingreso * F.resico.retencionPersonaMoral : 0;
        const tasaEfectiva = ingreso > 0 ? (cuotaResico / ingreso) * 100 : 0;

        return {
          total: mxn(cuotaResico),
          sub:
            'Cuota mensual de ISR en RESICO, con la tasa del ' + (tasaRes * 100).toFixed(2).replace('.', ',') + '% que te toca por tu nivel de ingreso. ' +
            (rebasa
              ? 'Ojo: a este ritmo proyectas ' + mxn(proyeccionAnual) + ' anuales y rebasas el tope del régimen.'
              : 'En el régimen general, con tus gastos, pagarías ' + mxn(isrGeneral) + ' este mes.'),
          rows: [
            { k: 'Ingreso mensual cobrado', v: ingreso },
            { k: 'Tasa de RESICO aplicable', ref: 'LISR Art. 113-E', v: tasaRes * 100, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Cuota mensual de ISR', v: cuotaResico, extra: true },
            { k: 'Cuota anualizada', v: anualizado },
            { k: 'Retención de tu cliente persona moral', ref: '1,25%', v: retPm },
            { k: 'Mismo mes en el régimen general', v: isrGeneral, extra: true },
            { k: 'Diferencia a favor de RESICO', v: Math.max(0, isrGeneral - cuotaResico) },
            { k: 'Diferencia a favor del régimen general', v: Math.max(0, cuotaResico - isrGeneral) },
            { k: 'Proyección anual de ingresos', v: proyeccionAnual },
            { k: 'Tope anual del régimen', v: F.resico.topeAnual },
            { k: 'Tasa efectiva sobre tu ingreso', v: tasaEfectiva, format: 'unit', unit: '%', decimals: 2 },
          ],
          chart: [
            { label: 'Te queda', value: Math.max(0, ingreso - cuotaResico), tone: 'main' },
            { label: 'Cuota de ISR (RESICO)', value: cuotaResico, tone: 'warn' },
          ],
        };
      }

      // ── Caso 3: pago provisional del régimen general ───────────────────
      if (id === 'general') {
        const margen = ingreso > 0 ? (utilidad / ingreso) * 100 : 0;
        const tasaEfectiva = ingreso > 0 ? (isrGeneral / ingreso) * 100 : 0;
        return {
          total: mxn(isrGeneral),
          sub:
            'Pago provisional de ISR del mes sobre una utilidad fiscal de ' + mxn(utilidad) + '. ' +
            'Con el mismo ingreso, RESICO te costaría ' + mxn(cuotaResico) + '.',
          rows: [
            { k: 'Ingresos cobrados del mes', v: ingreso },
            { k: 'Deducciones autorizadas', v: gastos },
            { k: 'Utilidad fiscal', ref: 'LISR Art. 100', v: utilidad, extra: true },
            { k: 'Pago provisional de ISR', ref: 'LISR Art. 106', v: isrGeneral, extra: true },
            { k: 'Te queda después de ISR', v: Math.max(0, utilidad - isrGeneral) },
            { k: 'Misma situación en RESICO', v: cuotaResico },
            { k: 'Diferencia contra RESICO', v: Math.abs(isrGeneral - cuotaResico) },
            { k: 'Margen de utilidad', v: margen, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Tasa efectiva sobre ingresos', v: tasaEfectiva, format: 'unit', unit: '%', decimals: 1 },
          ],
          chart: [
            { label: 'Te queda después de ISR', value: Math.max(0, utilidad - isrGeneral), tone: 'main' },
            { label: 'Deducciones autorizadas', value: gastos, tone: 'good' },
            { label: 'ISR del mes', value: isrGeneral, tone: 'warn' },
          ],
        };
      }

      // ── Caso 4: retención de plataformas digitales ─────────────────────
      if (id === 'plataformas') {
        const conRfc = v.dioRfc !== 'no';
        const tasaAct =
          v.actividad === 'hospedaje' ? F.plataformas.hospedaje
          : v.actividad === 'bienesServicios' ? F.plataformas.bienesServicios
          : F.plataformas.transporte;
        const tasaIsr = conRfc ? tasaAct : F.plataformas.sinRfc;
        const tasaIva = conRfc ? F.plataformas.ivaConRfc : F.plataformas.ivaSinRfc;
        const retIsr = ingreso * tasaIsr;
        const retIva = ingreso * tasaIva;
        const retTotal = retIsr + retIva;
        const neto = ingreso - retTotal;

        // Cuánto te costaría no haber dado el RFC (o cuánto te ahorra haberlo dado).
        const retSinRfc = ingreso * (F.plataformas.sinRfc + F.plataformas.ivaSinRfc);
        const retConRfc = ingreso * (tasaAct + F.plataformas.ivaConRfc);

        return {
          total: mxn(neto),
          sub:
            'Neto que te deposita la app después de retenciones. ' +
            (conRfc
              ? 'Con RFC registrado te retienen ' + mxn(retTotal) + ' en total.'
              : 'Sin RFC te retienen ' + mxn(retTotal) + ': registrarlo te devolvería ' + mxn(retSinRfc - retConRfc) + ' al mes.'),
          rows: [
            { k: 'Ingreso cobrado por la app', v: ingreso },
            { k: 'Tasa de ISR aplicada', ref: 'LISR Art. 113-A', v: tasaIsr * 100, format: 'unit', unit: '%', decimals: 2 },
            { k: 'ISR retenido', v: retIsr, extra: true },
            { k: 'Tasa de IVA retenida', ref: 'LIVA Art. 18-J', v: tasaIva * 100, format: 'unit', unit: '%', decimals: 2 },
            { k: 'IVA retenido', v: retIva },
            { k: 'Total retenido', v: retTotal },
            { k: 'Neto que te depositan', v: neto, extra: true },
            { k: 'Retención total si NO das RFC', v: retSinRfc },
            { k: 'Retención total si SÍ das RFC', v: retConRfc },
            { k: 'Lo que te cuesta no dar el RFC', v: Math.max(0, retSinRfc - retConRfc) },
          ],
          chart: [
            { label: 'Neto a recibir', value: Math.max(0, neto), tone: 'main' },
            { label: 'ISR retenido', value: retIsr, tone: 'warn' },
            { label: 'IVA retenido', value: retIva, tone: 'prop' },
          ],
        };
      }

      // ── Caso 5: asimilados a salarios vs honorarios ────────────────────
      if (id === 'asimilados') {
        // Asimilado: la tarifa del Art. 96 se aplica sobre el ingreso COMPLETO (no hay deducciones).
        const isrAsimilado = isrMensual(ingreso);
        const netoAsimilado = ingreso - isrAsimilado;
        const costoClienteAsimilado = ingreso;

        // Honorarios régimen general: se deducen los gastos y el cliente paga IVA además del subtotal.
        const netoHonorarios = utilidad - isrGeneral;
        const costoClienteHonorarios = ingreso * (1 + F.iva);

        const diff = netoHonorarios - netoAsimilado;

        return {
          total: mxn(Math.abs(diff)),
          sub:
            (Math.abs(diff) < 1
              ? 'Las dos modalidades te dejan prácticamente el mismo neto; decide por lo no monetario.'
              : diff > 0
                ? 'Diferencia mensual a favor de facturar por honorarios, gracias a que deduces ' + mxn(gastos) + ' de gastos.'
                : 'Diferencia mensual a favor de asimilados a salarios: con tus gastos actuales, deducir no alcanza a compensar.') +
            ' Recuerda que asimilados no da IMSS ni prestaciones.',
          rows: [
            { k: 'Ingreso mensual bruto', v: ingreso },
            { k: 'ISR como asimilado a salarios', ref: 'LISR Art. 96', v: isrAsimilado, extra: true },
            { k: 'Neto mensual como asimilado', v: netoAsimilado, extra: true },
            { k: 'Gastos deducibles que sí puedes usar por honorarios', v: gastos },
            { k: 'ISR por honorarios (régimen general)', ref: 'LISR Art. 106', v: isrGeneral },
            { k: 'Neto mensual por honorarios, ya deducidos los gastos', v: netoHonorarios, extra: true },
            { k: 'Diferencia de neto entre las dos', v: Math.abs(diff) },
            { k: 'Le cuesta a tu cliente como asimilado', v: costoClienteAsimilado },
            { k: 'Le cuesta a tu cliente por honorarios, con IVA', v: costoClienteHonorarios },
          ],
          chart: [
            { label: 'Neto como asimilado', value: Math.max(0, netoAsimilado), tone: 'prop' },
            { label: 'Neto por honorarios', value: Math.max(0, netoHonorarios), tone: 'main' },
          ],
        };
      }

      // ── Caso 1: qué me queda de una factura de honorarios ──────────────
      const subtotal = ingreso;
      const ivaTrasladado = subtotal * F.iva;
      const retIsrHon = esMoral ? subtotal * F.honorarios.retIsr : 0;
      const retIvaHon = esMoral ? ivaTrasladado * F.honorarios.retIvaTercios : 0;
      const totalFactura = subtotal + ivaTrasladado;
      const netoDepositado = totalFactura - retIsrHon - retIvaHon;
      const pctNeto = totalFactura > 0 ? (netoDepositado / totalFactura) * 100 : 0;

      return {
        total: mxn(netoDepositado),
        sub: esMoral
          ? 'Neto que te deposita una persona moral: te retiene ' + mxn(retIsrHon) + ' de ISR y ' + mxn(retIvaHon) + ' de IVA, que después acreditas.'
          : 'Una persona física no retiene: cobras el subtotal más el IVA completo, y ese IVA lo enteras tú al SAT.',
        rows: [
          { k: 'Subtotal de la factura', v: subtotal },
          { k: 'IVA trasladado', ref: 'LIVA Art. 1', v: ivaTrasladado },
          { k: 'Total facturado', v: totalFactura },
          { k: 'ISR retenido', ref: 'LISR Art. 106 · 10%', v: retIsrHon },
          { k: 'IVA retenido', ref: 'LIVA Art. 1-A · 2/3', v: retIvaHon },
          { k: 'Neto que te depositan', v: netoDepositado, extra: true },
          { k: 'IVA que tienes que enterar tú', v: ivaTrasladado - retIvaHon },
          { k: 'Retención en RESICO sobre el mismo subtotal', ref: '1,25%', v: esMoral ? subtotal * F.resico.retencionPersonaMoral : 0 },
          { k: 'Neto sobre el total facturado', v: pctNeto, format: 'unit', unit: '%', decimals: 1 },
        ],
        chart: [
          { label: 'Neto a recibir', value: Math.max(0, netoDepositado), tone: 'main' },
          { label: 'ISR retenido', value: retIsrHon, tone: 'warn' },
          { label: 'IVA retenido', value: retIvaHon, tone: 'prop' },
        ],
      };
    });
  })();
</script>
