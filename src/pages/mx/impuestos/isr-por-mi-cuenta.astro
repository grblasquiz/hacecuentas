---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import IsrCuentaPropiaMexicoExperience from '../../../components/generated/IsrCuentaPropiaMexicoExperience.astro';
import DecisionRelatedLinks from '../../../components/DecisionRelatedLinks.astro';
import RegimeJourney from '../../../components/RegimeJourney.astro';
import { hub } from '../../../lib/hubs/mx/isr-por-mi-cuenta';
const canonical='https://hacecuentas.com/mx/impuestos/isr-por-mi-cuenta';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,description:hub.description,url:canonical,applicationCategory:'FinanceApplication',operatingSystem:'Web',dateModified:hub.lastReviewed,offers:{'@type':'Offer',price:'0',priceCurrency:'MXN'}};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <IsrCuentaPropiaMexicoExperience />
  <RegimeJourney country="México" regime="RESICO" headline="RESICO o general: decidilo con tu margen real." intro="La tasa baja de RESICO no descuenta gastos. Esta ruta separa elegibilidad, pago mensual y comparación para que no elijas mirando sólo el porcentaje." steps={['Proyectá ingresos cobrados','Chequeá requisitos RESICO','Compará contra tus deducciones']} links={[{href:'/mx/calculadora-resico-personas-fisicas-mexico-2026-cuota',label:'Calcular RESICO',note:'Tasa y cuota mensual estimada'},{href:'/mx/impuestos/declaracion-anual',label:'Preparar declaración',note:'Saldo, deducciones y fechas'},{href:'/mx/impuestos/iva',label:'Separar el IVA',note:'IVA trasladado, acreditable y neto'}]} tone="emerald" />
  <section class="formula-note" aria-labelledby="formula-isr-cuenta-propia">
    <h2 id="formula-isr-cuenta-propia">Cómo se calcula</h2>
    <p><strong>RESICO:</strong> ingreso efectivamente cobrado × tasa del tramo. No descuenta gastos.</p>
    <p><strong>Régimen general:</strong> ingresos cobrados menos deducciones autorizadas; sobre esa utilidad se aplica la tarifa progresiva y se restan pagos y retenciones acreditables.</p>
    <p><strong>Honorarios y plataformas:</strong> el resultado separa ISR, IVA y retenciones porque no todos esos importes son un costo definitivo.</p>
  </section>
  <DecisionRelatedLinks items={[
    { href: '/mx/impuestos/declaracion-anual', title: 'Declaración anual', description: 'Prepará el saldo y las deducciones del ejercicio.', icon: '📋' },
    { href: '/mx/impuestos/iva', title: 'IVA', description: 'Separá IVA trasladado, acreditable y neto.', icon: '🧾' },
    { href: '/mx/trabajo/sueldo-neto', title: 'Sueldo neto', description: 'Compará el resultado con un empleo en nómina.', icon: '💵' },
  ]} />
  <Footer />
</Layout>

<style>
  .formula-note { max-width: 1120px; margin: 2rem auto; padding: 1.5rem; border: 1px solid #d8e3df; border-radius: 1rem; background: #f7faf8; }
  .formula-note h2 { margin-top: 0; }
  .formula-note p { margin: .55rem 0; line-height: 1.6; }
</style>
