---
/**
 * Hub de decisión MX — comprar o vender auto: contado vs crédito, CAT, ISAN,
 * depreciación, ISR de la venta e importación.
 * audience="MX" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, COMPRA_MX } from '../../../lib/hubs/mx/comprar-o-vender-auto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ C: COMPRA_MX }}>
  (function () {
    const H = window.HC_HUB;
    const mxn = (n) => '$' + Math.round(n || 0).toLocaleString('es-MX');
    const pct = (n) => (Math.round(n * 100) / 100).toFixed(2) + ' %';

    /** Tarifa progresiva: [límite inferior, límite superior, cuota fija, tasa]. */
    function aplicarTarifa(base, tarifa) {
      if (!isFinite(base) || base <= 0) return 0;
      for (let k = 0; k < tarifa.length; k++) {
        const t = tarifa[k];
        if (base >= t[0] && base <= t[1]) {
          return Math.round((t[2] + (base - t[0]) * t[3]) * 100) / 100;
        }
      }
      const last = tarifa[tarifa.length - 1];
      return Math.round((last[2] + (base - last[0]) * last[3]) * 100) / 100;
    }

    /** Cuota fija de un crédito (anualidad francesa). */
    function cuota(monto, tasaMensual, meses) {
      if (tasaMensual === 0) return monto / meses;
      return (monto * tasaMensual) / (1 - Math.pow(1 + tasaMensual, -meses));
    }

    /** ISAN sobre el precio sin IVA, con los umbrales de exención publicados. */
    function isanDe(precio) {
      if (!(precio > 0)) return { impuesto: 0, beneficio: 'Sin base gravable' };
      let tramo = C.isanTramos[C.isanTramos.length - 1];
      for (let k = 0; k < C.isanTramos.length; k++) {
        if (precio <= C.isanTramos[k][0]) {
          tramo = C.isanTramos[k];
          break;
        }
      }
      let impuesto = tramo[1] + Math.max(0, precio - tramo[3]) * tramo[2];
      if (precio > C.isanAjusteDesde) {
        impuesto = Math.max(0, impuesto - (precio - C.isanAjusteDesde) * C.isanAjusteTasa);
      }
      let beneficio = 'Sin exención';
      if (precio <= C.isanExentoHasta) {
        impuesto = 0;
        beneficio = 'Exento al 100 %';
      } else if (precio <= C.isanMitadHasta) {
        impuesto *= 0.5;
        beneficio = 'Reducción del 50 %';
      }
      return { impuesto: impuesto, beneficio: beneficio };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'contado';
      const precio = Math.max(0, v.precioAuto || 0);
      const plazo = Math.max(1, Math.round(Number(v.plazoMeses) || 12));
      const enganchePct = Math.min(95, Math.max(0, Number(v.enganchePct) || 0));
      const enganche = precio * (enganchePct / 100);
      const montoFin = Math.max(0, precio - enganche);

      // ── Caso 2: mensualidad y CAT del crédito ─────────────────────────
      if (id === 'credito') {
        const cat = Math.max(0, Number(v.catAnual) || 0) / 100;
        const tasaMes = Math.pow(1 + cat, 1 / 12) - 1;
        const mensualidad = cuota(montoFin, tasaMes, plazo);
        const intereses = mensualidad * plazo - montoFin;
        const pagoTotal = enganche + mensualidad * plazo;

        const seguroPct =
          v.seguro === 'basico' ? C.seguroBasicoAnual : v.seguro === 'amplio' ? C.seguroAmplioAnual : 0;
        const primaMensual = (precio * seguroPct) / 12;
        const conSeguro = mensualidad + primaMensual;

        const deduccion = intereses * C.isrMarginalDeduccion;

        let ahorro = 0;
        let etiquetaAlternativa = '';
        if (v.comparar === 'leasing' || v.comparar === 'renting') {
          const cuotaPct = v.comparar === 'leasing' ? C.cuotaLeasing : C.cuotaRenting;
          const pagoAlternativa = precio * cuotaPct * plazo;
          const dedAlternativa = pagoAlternativa * C.isrMarginalDeduccion;
          ahorro = pagoTotal - deduccion - (pagoAlternativa - dedAlternativa);
          etiquetaAlternativa = v.comparar === 'leasing' ? 'leasing' : 'renting';
        }

        const interesesPct = montoFin > 0 ? (intereses / montoFin) * 100 : 0;

        return {
          total: mxn(conSeguro),
          sub:
            'Mensualidad de ' +
            mxn(mensualidad) +
            ' durante ' +
            plazo +
            ' meses' +
            (primaMensual > 0 ? ', más ' + mxn(primaMensual) + ' de seguro al mes' : '') +
            '. Los intereses suman ' +
            mxn(intereses) +
            ', un ' +
            pct(interesesPct) +
            ' extra sobre lo financiado.' +
            (etiquetaAlternativa
              ? ahorro > 0
                ? ' Frente a ' + etiquetaAlternativa + ', el crédito sale ' + mxn(ahorro) + ' más caro en términos netos.'
                : ' Frente a ' + etiquetaAlternativa + ', el crédito sale ' + mxn(-ahorro) + ' más barato en términos netos.'
              : ''),
          rows: [
            { k: 'Enganche', v: enganche },
            { k: 'Monto financiado', v: montoFin },
            { k: 'Mensualidad sin seguro', v: mensualidad, extra: true },
            { k: 'Prima de seguro mensual', v: primaMensual },
            { k: 'Mensualidad con seguro', v: conSeguro },
            { k: 'Intereses totales', v: intereses },
            { k: 'Pago total del crédito', v: pagoTotal },
            { k: 'Tasa mensual equivalente al CAT', v: tasaMes * 100, format: 'unit', unit: '%', decimals: 3 },
            { k: 'Deducción de ISR estimada sobre intereses', ref: 'solo si el auto está afecto a tu actividad', v: deduccion },
            { k: etiquetaAlternativa ? 'Diferencia neta contra ' + etiquetaAlternativa : 'Comparación con arrendamiento', v: ahorro },
          ],
          chart: [
            { label: 'Enganche', value: enganche, tone: 'prop' },
            { label: 'Capital financiado', value: montoFin, tone: 'main' },
            { label: 'Intereses', value: intereses, tone: 'warn' },
            { label: 'Seguro del plazo', value: primaMensual * plazo, tone: 'exit' },
          ],
        };
      }

      // ── Caso 3: ISAN de auto nuevo ────────────────────────────────────
      if (id === 'isan') {
        const base = Math.max(0, v.precioSinIva || 0);
        const r = isanDe(base);
        const iva = base * C.iva;
        const tasaEfectiva = base > 0 ? (r.impuesto / base) * 100 : 0;

        return {
          total: mxn(r.impuesto),
          sub:
            'ISAN estimado sobre un precio sin IVA de ' +
            mxn(base) +
            '. Resultado: ' +
            r.beneficio.toLowerCase() +
            '. Con IVA e ISAN, el auto te sale en ' +
            mxn(base + iva + r.impuesto) +
            '.',
          rows: [
            { k: 'Precio sin IVA', v: base },
            { k: 'ISAN', ref: 'LFISAN', v: r.impuesto, extra: true },
            { k: 'IVA sobre el precio', ref: 'LIVA Art. 1', v: iva },
            { k: 'Precio final estimado', v: base + iva + r.impuesto },
            { k: 'Tasa efectiva del ISAN', v: tasaEfectiva, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Umbral de exención total', v: C.isanExentoHasta },
            { k: 'Umbral de reducción del 50 %', v: C.isanMitadHasta },
          ],
          chart: [
            { label: 'Precio sin IVA', value: base, tone: 'main' },
            { label: 'IVA', value: iva, tone: 'prop' },
            { label: 'ISAN', value: r.impuesto, tone: 'warn' },
          ],
        };
      }

      // ── Caso 4: vender el usado (depreciación + ISR) ──────────────────
      if (id === 'vender') {
        const antiguedad = Math.max(0, Math.round(Number(v.antiguedadAnios) || 0));
        const km = Math.max(0, v.kmRecorridos || 0);
        const tasaDep = Math.min(60, Math.max(0, Number(v.tasaDepreciacion) || 0)) / 100;
        const primerAnio = String(v.primerAnioMayor) !== 'no';

        let valor = precio;
        if (antiguedad >= 1) {
          let inicio = 1;
          if (primerAnio) {
            valor = valor * (1 - C.caidaPrimerAnio);
            inicio = 2;
          }
          for (let y = inicio; y <= antiguedad; y++) valor = valor * (1 - tasaDep);
        }
        const kmEsperado = C.kmEsperadoPorAnio * antiguedad;
        const excesoKm = Math.max(0, km - kmEsperado);
        const penalPct = Math.min(0.2, (excesoKm / 10000) * 0.05);
        const penalizacion = valor * penalPct;
        const valorEstimado = Math.max(0, valor - penalizacion);

        const precioVenta = Math.max(0, v.precioVenta || 0);
        const mejoras = Math.max(0, v.mejoras || 0);
        const costo = precio + mejoras;
        const exencion = 3 * C.umaAnual;
        const ganancia = Math.max(0, precioVenta - costo);
        const exento = Math.min(ganancia, exencion);
        const gravable = Math.max(0, ganancia - exencion);
        const retencion = precioVenta >= C.umbralRetencion && gravable > 0 ? 0.2 * precioVenta : 0;
        const parteAnual = antiguedad > 0 ? gravable / antiguedad : gravable;
        const isr = aplicarTarifa(parteAnual, C.tarifaAnual) * Math.max(1, antiguedad);

        return {
          total: mxn(valorEstimado),
          sub:
            'Valor estimado hoy tras ' +
            antiguedad +
            ' año(s) y ' +
            Math.round(km).toLocaleString('es-MX') +
            ' km. ' +
            (ganancia <= 0
              ? 'Al precio de venta que pusiste no hay ganancia, así que no generas ISR por la enajenación.'
              : gravable <= 0
                ? 'Tu ganancia de ' + mxn(ganancia) + ' no supera las 3 UMA anuales exentas: no pagas ISR.'
                : 'Sobre la ganancia gravable de ' + mxn(gravable) + ' el ISR estimado es ' + mxn(isr) + '.') +
            ' Contrasta el valor contra guías de precios y anuncios reales antes de decidir.',
          rows: [
            { k: 'Valor estimado hoy', v: valorEstimado, extra: true },
            { k: 'Depreciación acumulada', v: Math.max(0, precio - valorEstimado) },
            { k: 'Castigo por kilometraje excedente', v: penalizacion },
            { k: 'Ganancia de la venta', ref: 'venta menos costo y mejoras', v: ganancia },
            { k: 'Parte exenta', ref: '3 UMA anuales · LISR Art. 93-XIX', v: exento },
            { k: 'Ganancia gravable', v: gravable },
            { k: 'ISR estimado', ref: 'tarifa anual LISR', v: isr },
            { k: 'Retención del 20 % del comprador', ref: 'LISR Art. 126', v: retencion },
            { k: 'Pérdida de valor sobre el precio de compra', v: precio > 0 ? ((precio - valorEstimado) / precio) * 100 : 0, format: 'unit', unit: '%', decimals: 1 },
          ],
          chart: [
            { label: 'Valor estimado hoy', value: valorEstimado, tone: 'main' },
            { label: 'Depreciación acumulada', value: Math.max(0, precio - valorEstimado), tone: 'bad' },
          ],
        };
      }

      // ── Caso 5: importar de Estados Unidos ────────────────────────────
      if (id === 'importar') {
        const usd = Math.max(0, v.valorUsd || 0);
        const tc = Math.max(0, Number(v.tipoCambio) || 0);
        const valorMxn = usd * tc;
        const igi = valorMxn * (Math.max(0, Number(v.igiPct) || 0) / 100);
        const dta = valorMxn * C.dtaPct;
        const iva = (valorMxn + igi + dta) * C.iva;
        const isan = isanDe(valorMxn).impuesto;
        const agente = Math.max(0, v.agenteTraslado || 0);
        const impuestos = igi + dta + iva + isan;
        const total = valorMxn + impuestos + agente;
        const sobrecosto = valorMxn > 0 ? (total / valorMxn - 1) * 100 : 0;

        return {
          total: mxn(total),
          sub:
            'Un vehículo de US$ ' +
            Math.round(usd).toLocaleString('es-MX') +
            ' queda puesto en México en unos ' +
            mxn(total) +
            ': ' +
            pct(sobrecosto) +
            ' por encima del precio de compra. No incluye placas, adecuaciones ni trámites estatales.',
          rows: [
            { k: 'Valor del vehículo en pesos', v: valorMxn },
            { k: 'Impuesto general de importación', ref: 'según fracción arancelaria', v: igi },
            { k: 'Derecho de trámite aduanero', v: dta },
            { k: 'IVA sobre valor más IGI y DTA', ref: 'LIVA Art. 1', v: iva },
            { k: 'ISAN estimado', ref: 'LFISAN', v: isan },
            { k: 'Agente aduanal y traslado', v: agente },
            { k: 'Costo total puesto en México', v: total, extra: true },
            { k: 'Sobrecosto sobre el precio de compra', v: sobrecosto, format: 'unit', unit: '%', decimals: 1 },
          ],
          chart: [
            { label: 'Valor del vehículo', value: valorMxn, tone: 'main' },
            { label: 'IGI', value: igi, tone: 'warn' },
            { label: 'IVA', value: iva, tone: 'bad' },
            { label: 'DTA e ISAN', value: dta + isan, tone: 'prop' },
            { label: 'Agente y traslado', value: agente, tone: 'exit' },
          ],
        };
      }

      // ── Caso 1: contado vs financiado ─────────────────────────────────
      const tasaAnual = Math.max(0, Number(v.tasaAnual) || 0);
      const iMes = tasaAnual / 100 / 12;
      const mensualidad = cuota(montoFin, iMes, plazo);
      const totalFinanciado = enganche + mensualidad * plazo;
      const sobreprecio = totalFinanciado - precio;

      const cetes = Math.max(0, Number(v.tasaCetes) || 0);
      const anios = plazo / 12;
      const costoOportunidad = precio * (Math.pow(1 + cetes / 100, anios) - 1);
      const contadoConviene = sobreprecio > costoOportunidad;

      return {
        total: mxn(Math.abs(sobreprecio - costoOportunidad)),
        sub: contadoConviene
          ? 'Conviene de contado. El crédito te cuesta ' +
            mxn(sobreprecio) +
            ' en intereses contra ' +
            mxn(costoOportunidad) +
            ' que rendiría tu dinero invertido en ' +
            anios.toFixed(1) +
            ' años: la diferencia a favor de pagar de una es de ' +
            mxn(sobreprecio - costoOportunidad) +
            '.'
          : 'Financiar puede convenir. Tu dinero invertido rendiría ' +
            mxn(costoOportunidad) +
            ', más que los ' +
            mxn(sobreprecio) +
            ' de intereses del crédito, con una diferencia de ' +
            mxn(costoOportunidad - sobreprecio) +
            '. Solo vale si de verdad inviertes el dinero que no desembolsaste.',
        rows: [
          { k: 'Enganche', v: enganche },
          { k: 'Monto financiado', v: montoFin },
          { k: 'Mensualidad', v: mensualidad },
          { k: 'Desembolso total financiando', v: totalFinanciado },
          { k: 'Sobreprecio del crédito', ref: 'intereses acumulados', v: sobreprecio, extra: true },
          { k: 'Costo de oportunidad de pagar de contado', ref: 'rendimiento del plazo', v: costoOportunidad },
          { k: 'Diferencia entre ambos costos', v: Math.abs(sobreprecio - costoOportunidad) },
          { k: 'Plazo comparado', v: anios, format: 'unit', unit: 'años', decimals: 1 },
        ],
        chart: [
          { label: 'Sobreprecio del crédito', value: sobreprecio, tone: contadoConviene ? 'bad' : 'main' },
          { label: 'Costo de oportunidad de contado', value: costoOportunidad, tone: contadoConviene ? 'main' : 'bad' },
        ],
      };
    });
  })();
</script>
