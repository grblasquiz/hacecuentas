---
/**
 * Hub de decisión MX — crédito de vivienda: Infonavit, FOVISSSTE, banco y
 * devolución del ahorro de la Subcuenta de Vivienda.
 * audience="MX" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CreditoViviendaMexicoExperience from '../../../components/generated/CreditoViviendaMexicoExperience.astro';
import { hub, VIVIENDA_MX } from '../../../lib/hubs/mx/credito-de-vivienda';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CreditoViviendaMexicoExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ K: VIVIENDA_MX }}>
  (function () {
    const H = window.HC_HUB;
    const mxn = (n) => '$' + Math.round(n || 0).toLocaleString('es-MX');
    const pos = (n) => Math.max(0, Number(n) || 0);

    /** Cuota francesa: capital, tasa ANUAL en %, plazo en meses. */
    function cuotaFrancesa(capital, tasaAnualPct, meses) {
      if (capital <= 0 || meses <= 0) return 0;
      const r = tasaAnualPct / 100 / 12;
      if (r === 0) return capital / meses;
      const f = Math.pow(1 + r, meses);
      return (capital * (r * f)) / (f - 1);
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'infonavit';

      const salario = pos(v.salarioMensual);
      const antiguedad = pos(v.antiguedad);
      const edad = Math.max(18, pos(v.edad));
      const subcuenta = pos(v.subcuenta);
      const valor = pos(v.valorVivienda);
      const enganche = pos(v.enganche);
      const tasa = pos(v.tasaAnual);
      const anios = Math.max(1, pos(v.plazoAnios));
      const meses = anios * 12;
      const extraPct = pos(v.costoExtraPct);
      const aperturaPct = pos(v.aperturaPct);

      // ── Caso 1: cuánto me presta Infonavit ────────────────────────────
      if (id === 'infonavit') {
        const puntaje =
          antiguedad * 10 + Math.floor(subcuenta / 250) + edad * 5;
        const califica = puntaje >= K.puntajeMinimo;
        const marginal = !califica && puntaje >= K.puntajeMinimo - 200;

        const poderAdquisitivo =
          salario * K.coeficientePoderAdquisitivo * K.factorRiesgo;
        const techoLegal = K.vsmMaximo * K.salarioMinimoMensual;
        const montoMaximo = Math.min(subcuenta + poderAdquisitivo, techoLegal);

        let plazoMeses = Math.max(0, (K.edadRetiro - edad) * 12);
        plazoMeses = Math.min(plazoMeses, K.plazoMaximoMeses);
        plazoMeses = Math.max(plazoMeses, K.plazoMinimoMeses);

        const cuota = cuotaFrancesa(montoMaximo, tasa, plazoMeses);
        const faltante = Math.max(0, valor - montoMaximo);

        return {
          total: mxn(montoMaximo),
          sub:
            (califica
              ? 'Con ' + Math.round(puntaje) + ' puntos superas el mínimo de ' + K.puntajeMinimo + '. '
              : marginal
                ? 'Estás a ' + Math.round(K.puntajeMinimo - puntaje) + ' puntos del mínimo de ' + K.puntajeMinimo + '. '
                : 'Te faltan ' + Math.round(K.puntajeMinimo - puntaje) + ' puntos para el mínimo de ' + K.puntajeMinimo + '. ') +
            'Monto máximo estimado con mensualidad de ' + mxn(cuota) + ' a ' + Math.round(plazoMeses / 12) + ' años.' +
            (faltante > 0 ? ' Para una vivienda de ' + mxn(valor) + ' te faltarían ' + mxn(faltante) + '.' : ''),
          rows: [
            { k: 'Puntos estimados de precalificación', v: Math.round(puntaje), format: 'unit', unit: 'pts' },
            { k: 'Puntos mínimos que pide Infonavit', v: K.puntajeMinimo, format: 'unit', unit: 'pts' },
            { k: 'Saldo de tu Subcuenta de Vivienda', v: subcuenta },
            { k: 'Capacidad de crédito estimada', ref: 'estimación, no dato oficial', v: poderAdquisitivo },
            { k: 'Monto máximo estimado', v: montoMaximo, extra: true },
            { k: 'Tope legal de 25 veces el salario mínimo', v: techoLegal },
            { k: 'Plazo máximo por tu edad', v: Math.round(plazoMeses), format: 'unit', unit: 'meses' },
            { k: 'Mensualidad estimada', v: cuota },
            { k: 'Falta para la vivienda que miras', v: faltante },
          ],
          chart: [
            { label: 'Subcuenta de Vivienda', value: subcuenta, tone: 'good' },
            { label: 'Capacidad de crédito', value: Math.max(0, montoMaximo - subcuenta), tone: 'main' },
            { label: 'Falta de tu bolsillo', value: faltante, tone: 'warn' },
          ],
        };
      }

      // ── Caso 2: ya tengo el crédito, cuánto pago al mes ────────────────
      if (id === 'mensualidad') {
        const monto = pos(v.montoCredito);
        const cuotaBase = cuotaFrancesa(monto, tasa, meses);
        const adminMensual = (monto * (extraPct / 100)) / 12;
        const mensualidad = cuotaBase + adminMensual;
        const totalPagado = mensualidad * meses;
        const interesesFin = cuotaBase * meses - monto;
        const adminTotal = adminMensual * meses;
        const sobrecosto = Math.max(0, totalPagado - monto);
        const pesoSueldo = salario > 0 ? (mensualidad / salario) * 100 : 0;
        const umiMensual = K.umiDiaria * K.factorMensual;

        return {
          total: mxn(mensualidad),
          sub:
            'Mensualidad estimada durante ' + meses + ' pagos. Sobre un crédito de ' + mxn(monto) +
            ' terminas devolviendo ' + mxn(totalPagado) + ', es decir ' + mxn(sobrecosto) + ' de más entre intereses y gastos.' +
            (salario > 0 ? ' Equivale al ' + pesoSueldo.toFixed(1) + '% de tu sueldo mensual.' : ''),
          rows: [
            { k: 'Cuota de capital e intereses', v: cuotaBase },
            { k: 'Gastos de administración prorrateados', v: adminMensual },
            { k: 'Mensualidad total', v: mensualidad, extra: true },
            { k: 'Peso sobre tu sueldo', v: pesoSueldo, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Sueldo que te queda después del descuento', v: Math.max(0, salario - mensualidad) },
            { k: 'Pagos totales del crédito', v: meses, format: 'unit', unit: 'meses' },
            { k: 'Intereses del crédito', v: Math.max(0, interesesFin) },
            { k: 'Gastos de administración del crédito', v: adminTotal },
            { k: 'Total que devuelves', v: totalPagado },
            { k: 'Valor mensual de una UMI', ref: 'UMI × 30,4', v: umiMensual },
          ],
          chart: [
            { label: 'Capital prestado', value: monto, tone: 'main' },
            { label: 'Intereses', value: Math.max(0, interesesFin), tone: 'warn' },
            { label: 'Gastos de administración', value: adminTotal, tone: 'prop' },
          ],
        };
      }

      // ── Caso 3: FOVISSSTE ──────────────────────────────────────────────
      if (id === 'fovissste') {
        const disponible = Math.max(0, valor - subcuenta);
        const solicitado = pos(v.montoCredito);
        const credito = Math.max(0, Math.min(solicitado > 0 ? solicitado : disponible, disponible));
        const cuota = cuotaFrancesa(credito, tasa, meses);
        const total = cuota * meses;
        const faltante = Math.max(0, valor - subcuenta - credito);

        return {
          total: mxn(cuota),
          sub:
            'Cuota mensual estimada durante ' + anios + ' años. Con ' + mxn(subcuenta) +
            ' de subcuenta y un crédito de ' + mxn(credito) + ', ' +
            (faltante > 0
              ? 'todavía necesitarías ' + mxn(faltante) + ' de recursos propios para completar el precio.'
              : 'cubres el precio completo sin poner recursos propios.'),
          rows: [
            { k: 'Precio de la vivienda', v: valor },
            { k: 'Subcuenta que se aplica al crédito', v: subcuenta },
            { k: 'Monto financiado', v: credito, extra: true },
            { k: 'Cuota mensual', v: cuota },
            { k: 'Pagos totales', v: meses, format: 'unit', unit: 'meses' },
            { k: 'Costo financiero del crédito', v: Math.max(0, total - credito) },
            { k: 'Total que devuelves', v: total },
            { k: 'Recursos propios que faltan', v: faltante },
          ],
          chart: [
            { label: 'Subcuenta', value: subcuenta, tone: 'good' },
            { label: 'Crédito', value: credito, tone: 'main' },
            { label: 'Recursos propios', value: faltante, tone: 'warn' },
          ],
        };
      }

      // ── Caso 4: hipoteca bancaria ──────────────────────────────────────
      if (id === 'banco') {
        const credito = Math.max(0, valor - enganche);
        const cuotaCapital = cuotaFrancesa(credito, tasa, meses);
        const segurosMensuales = (credito * (extraPct / 100)) / 12;
        const mensual = cuotaCapital + segurosMensuales;
        const apertura = (credito * aperturaPct) / 100;
        const desembolso = enganche + apertura;
        const intereses = Math.max(0, cuotaCapital * meses - credito);
        const pesoIngreso = salario > 0 ? (mensual / salario) * 100 : 0;

        return {
          total: mxn(mensual),
          sub:
            'Mensualidad con seguros incluidos sobre un crédito de ' + mxn(credito) + ' a ' + anios +
            ' años. Para firmar necesitarías alrededor de ' + mxn(desembolso) + ' entre enganche y comisión de apertura.' +
            (salario > 0
              ? pesoIngreso > 35
                ? ' Representa el ' + pesoIngreso.toFixed(1) + '% de tu ingreso: por encima de un tercio los bancos suelen recortar el monto.'
                : ' Representa el ' + pesoIngreso.toFixed(1) + '% de tu ingreso, dentro de lo que la banca considera sano.'
              : ''),
          rows: [
            { k: 'Precio de la vivienda', v: valor },
            { k: 'Enganche', v: enganche },
            { k: 'Monto del crédito', v: credito, extra: true },
            { k: 'Cuota de capital e intereses', v: cuotaCapital },
            { k: 'Seguros y gastos prorrateados', v: segurosMensuales },
            { k: 'Mensualidad total', v: mensual },
            { k: 'Peso sobre tu ingreso', v: pesoIngreso, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Comisión de apertura', v: apertura },
            { k: 'Desembolso inicial estimado', v: desembolso },
            { k: 'Intereses totales', v: intereses },
          ],
          chart: [
            { label: 'Enganche', value: enganche, tone: 'good' },
            { label: 'Crédito', value: credito, tone: 'main' },
            { label: 'Intereses', value: intereses, tone: 'warn' },
          ],
        };
      }

      // ── Caso 5: devolución del ahorro Infonavit ────────────────────────
      const usoCredito = v.usoCredito === 'si';
      const fondo = pos(v.fondo7292);
      const rend = pos(v.rendimientoSubcuenta);

      const sbcDiario = salario / K.factorMensual;
      const topeDiario = K.umaDiaria * K.topeSbcUmas;
      const sbcAplicable = Math.min(sbcDiario, topeDiario);
      const sbcMensual = sbcAplicable * K.factorMensual;
      const aportacionMensual = sbcMensual * K.aportacionPatronal;
      const mesesCotizados = Math.round(antiguedad * 12);
      const r = rend / 100 / 12;

      let saldoSubcuenta;
      if (usoCredito) saldoSubcuenta = 0;
      else if (r > 0) saldoSubcuenta = aportacionMensual * ((Math.pow(1 + r, mesesCotizados) - 1) / r);
      else saldoSubcuenta = aportacionMensual * mesesCotizados;

      const aportadoSinRendimiento = usoCredito ? 0 : aportacionMensual * mesesCotizados;
      const rendimientos = Math.max(0, saldoSubcuenta - aportadoSinRendimiento);
      const totalRecuperable = saldoSubcuenta + fondo;

      return {
        total: mxn(totalRecuperable),
        sub: usoCredito
          ? 'Como ya usaste un crédito Infonavit, tu Subcuenta de Vivienda 97 se aplicó a ese crédito: lo que queda por reclamar aparte es el Fondo de Ahorro 1972-1992.'
          : 'Estimación del ahorro acumulado en ' + antiguedad + ' años cotizados. La Subcuenta 97 se te entrega a través de tu Afore al pensionarte; el Fondo 72-92 se solicita directo en Infonavit.',
        rows: [
          { k: 'Salario base de cotización diario', v: sbcDiario, decimals: 2 },
          { k: 'Tope del SBC', ref: '25 UMA · LSS Art. 28', v: topeDiario, decimals: 2 },
          { k: 'Aportación patronal mensual', ref: '5% · Ley Infonavit Art. 29', v: aportacionMensual },
          { k: 'Aportación anual', v: aportacionMensual * 12 },
          { k: 'Meses cotizados', v: mesesCotizados, format: 'unit', unit: 'meses' },
          { k: 'Aportaciones acumuladas sin rendimiento', v: aportadoSinRendimiento },
          { k: 'Rendimientos estimados', v: rendimientos },
          { k: 'Saldo estimado de la Subcuenta 97', v: saldoSubcuenta },
          { k: 'Fondo de Ahorro 1972-1992', v: fondo },
          { k: 'Total recuperable estimado', v: totalRecuperable, extra: true },
        ],
        chart: [
          { label: 'Aportaciones del patrón', value: aportadoSinRendimiento, tone: 'main' },
          { label: 'Rendimientos', value: rendimientos, tone: 'good' },
          { label: 'Fondo 72-92', value: fondo, tone: 'prop' },
        ],
      };
    });
  })();
</script>
