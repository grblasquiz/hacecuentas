---
/**
 * Hub de decisión MX — deudas y crédito al consumo: tarjeta, meses sin intereses,
 * préstamo de tienda, Fonacot, ISSSTE y descuento real de una oferta.
 * audience="MX" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DeudasCreditoMexicoExperience from '../../../components/generated/DeudasCreditoMexicoExperience.astro';
import { hub, DEUDA_MX } from '../../../lib/hubs/mx/deudas-y-credito';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DeudasCreditoMexicoExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ K: DEUDA_MX }}>
  (function () {
    const H = window.HC_HUB;
    const mxn = (n) => '$' + Math.round(n || 0).toLocaleString('es-MX');
    const pos = (n) => Math.max(0, Number(n) || 0);

    /** Cuota de amortización francesa para `periodos` periodos con tasa por periodo. */
    function cuotaPeriodica(capital, tasaPeriodo, periodos) {
      if (capital <= 0 || periodos <= 0) return 0;
      if (tasaPeriodo === 0) return capital / periodos;
      return (capital * tasaPeriodo) / (1 - Math.pow(1 + tasaPeriodo, -periodos));
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'tarjeta';

      const saldo = pos(v.saldo);
      const tasa = pos(v.tasaAnual);
      const plazoMeses = Math.max(1, Math.round(pos(v.plazoMeses)));
      const plazoQ = Math.max(1, Math.round(pos(v.plazoQuincenas)));
      const precio = pos(v.precio);

      // ── Caso 1: deuda de tarjeta de crédito ───────────────────────────
      if (id === 'tarjeta') {
        const pagoMes = pos(v.pagoMensual);
        const comisiones = pos(v.comisionesAnuales);
        const iMensual = tasa / 100 / 12;
        const ivaPct = K.ivaGeneral;

        let saldoActual = saldo;
        let meses = 0;
        let interesesPagados = 0;
        let ivaPagado = 0;
        const maxMeses = 600;
        let impagable = false;

        while (saldoActual > 0.01 && meses < maxMeses) {
          const interesMes = saldoActual * iMensual;
          const ivaMes = interesMes * ivaPct;
          const cargos = interesMes + ivaMes;
          if (pagoMes <= cargos) {
            impagable = true;
            meses = maxMeses;
            interesesPagados += interesMes;
            ivaPagado += ivaMes;
            break;
          }
          saldoActual -= pagoMes - cargos;
          interesesPagados += interesMes;
          ivaPagado += ivaMes;
          meses++;
        }

        const totalPagado = pagoMes * meses + comisiones;
        const cat = meses > 0 && saldo > 0 ? (Math.pow(totalPagado / saldo, 12 / meses) - 1) * 100 : 0;
        const costoTotal = interesesPagados + ivaPagado + comisiones;

        return {
          total: mxn(totalPagado),
          sub: impagable
            ? 'Con ese abono la deuda nunca se liquida: no alcanza a cubrir los intereses del mes más su IVA, así que el saldo crece cada periodo. Subí el abono por encima de ' +
              mxn(saldo * iMensual * (1 + ivaPct)) + ' al mes para empezar a bajar capital.'
            : 'Liquidas en ' + meses + ' meses abonando ' + mxn(pagoMes) + ' al mes. Pagas ' + mxn(costoTotal) +
              ' de más sobre los ' + mxn(saldo) + ' que debías, con un CAT aproximado de ' + cat.toFixed(1) + '%.',
          rows: [
            { k: 'Saldo de la deuda', v: saldo },
            { k: 'Abono mensual', v: pagoMes },
            { k: 'Meses hasta liquidar', v: meses, format: 'unit', unit: 'meses' },
            { k: 'Intereses pagados', v: interesesPagados },
            { k: 'IVA sobre los intereses', ref: 'LIVA Art. 1', v: ivaPagado },
            { k: 'Anualidad y comisiones', v: comisiones },
            { k: 'Costo total del crédito', v: costoTotal, extra: true },
            { k: 'Total desembolsado', v: totalPagado },
            { k: 'CAT aproximado', v: cat, format: 'unit', unit: '%', decimals: 1 },
          ],
          chart: [
            { label: 'Capital de la deuda', value: saldo, tone: 'main' },
            { label: 'Intereses', value: interesesPagados, tone: 'warn' },
            { label: 'IVA sobre intereses', value: ivaPagado, tone: 'bad' },
            { label: 'Comisiones', value: comisiones, tone: 'prop' },
          ],
        };
      }

      // ── Caso 2: meses sin intereses vs contado ────────────────────────
      if (id === 'msi') {
        const tasaInv = pos(v.tasaInversion);
        const descuento = Math.min(100, pos(v.descuentoContado));
        const pagoMensual = precio / plazoMeses;
        const r = tasaInv / 100 / 12;
        const valorPresente = r > 0 ? (pagoMensual * (1 - Math.pow(1 + r, -plazoMeses))) / r : precio;
        const costoContado = precio * (1 - descuento / 100);
        const beneficioDiferir = precio - valorPresente;
        const convieneMsi = valorPresente <= costoContado;
        const ahorro = Math.abs(costoContado - valorPresente);

        return {
          total: mxn(pagoMensual),
          sub:
            'Pago mensual a ' + plazoMeses + ' meses. ' +
            (convieneMsi
              ? 'Medido en dinero de hoy, pagar a meses te cuesta ' + mxn(valorPresente) + ': ' + mxn(ahorro) +
                ' menos que el precio de contado con descuento.'
              : 'El descuento de contado deja el precio en ' + mxn(costoContado) + ', por debajo del valor de hoy de las cuotas (' +
                mxn(valorPresente) + '): pagar de una vez te ahorra ' + mxn(ahorro) + '.'),
          rows: [
            { k: 'Precio de lista', v: precio },
            { k: 'Pago mensual a meses', v: pagoMensual, extra: true },
            { k: 'Meses de la promoción', v: plazoMeses, format: 'unit', unit: 'meses' },
            { k: 'Costo real de pagar a meses, medido hoy', v: valorPresente },
            { k: 'Precio de contado con descuento', v: costoContado },
            { k: 'Beneficio financiero de diferir el pago', v: beneficioDiferir },
            { k: 'Diferencia entre las dos opciones', v: ahorro },
          ],
          chart: [
            { label: 'Pago de contado', value: costoContado, tone: convieneMsi ? 'warn' : 'good' },
            { label: 'Costo real a meses', value: valorPresente, tone: convieneMsi ? 'good' : 'warn' },
          ],
        };
      }

      // ── Caso 3: préstamo de tienda departamental ──────────────────────
      if (id === 'tienda') {
        const iq = tasa / 100 / K.quincenasPorAnio;
        const abono = cuotaPeriodica(saldo, iq, plazoQ);
        const totalPagado = abono * plazoQ;
        const intereses = totalPagado - saldo;
        const recargoPct = saldo > 0 ? (intereses / saldo) * 100 : 0;

        return {
          total: mxn(abono),
          sub:
            'Abono quincenal durante ' + plazoQ + ' quincenas, es decir ' + (plazoQ / 2) + ' meses. Al final devuelves ' +
            mxn(totalPagado) + ': ' + mxn(intereses) + ' de intereses, un ' + recargoPct.toFixed(1) +
            '% sobre lo que te prestaron.',
          rows: [
            { k: 'Lo que te prestan', v: saldo },
            { k: 'Abono quincenal', v: abono, extra: true },
            { k: 'Quincenas del crédito', v: plazoQ, format: 'unit', unit: 'quincenas' },
            { k: 'Equivalente en meses', v: plazoQ / 2, format: 'unit', unit: 'meses', decimals: 1 },
            { k: 'Intereses totales', v: intereses },
            { k: 'Recargo sobre el monto prestado', v: recargoPct, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Total que devuelves', v: totalPagado },
          ],
          chart: [
            { label: 'Lo que te prestan', value: saldo, tone: 'main' },
            { label: 'Intereses', value: Math.max(0, intereses), tone: 'warn' },
          ],
        };
      }

      // ── Caso 4: crédito Fonacot ───────────────────────────────────────
      if (id === 'fonacot') {
        const F = K.fonacot;
        const salarioNeto = pos(v.salarioNeto);
        const plazo = Math.max(F.plazoMinMeses, Math.min(F.plazoMaxMeses, plazoMeses));
        const cat = Math.max(F.catMinimo, Math.min(F.catMaximo, tasa));
        const tasaMensual = cat / 100 / 12;

        const montoMaximo = salarioNeto * F.mesesSalarioMaximo;
        const cuotaMaxTeorica = cuotaPeriodica(montoMaximo, tasaMensual, plazo);
        const capacidadPago = salarioNeto * F.capacidadPagoMax;

        let montoFinal = montoMaximo;
        let limitado = false;
        if (cuotaMaxTeorica > capacidadPago) {
          const f = Math.pow(1 + tasaMensual, plazo);
          montoFinal = (capacidadPago * (f - 1)) / (tasaMensual * f);
          limitado = true;
        }
        montoFinal = Math.max(0, Math.min(montoFinal, montoMaximo));

        const mensualidad = cuotaPeriodica(montoFinal, tasaMensual, plazo);
        const totalPagado = mensualidad * plazo;
        const intereses = Math.max(0, totalPagado - montoFinal);

        return {
          total: mxn(montoFinal),
          sub:
            'Monto estimado a ' + plazo + ' meses con CAT del ' + cat.toFixed(1) + '%, con mensualidad de ' +
            mxn(mensualidad) + ' descontada de tu nómina. ' +
            (limitado
              ? 'El monto se recortó porque la cuota del máximo teórico superaba el tope de capacidad de pago.'
              : 'La cuota cabe dentro del tope de capacidad de pago.'),
          rows: [
            { k: 'Monto máximo por meses de salario', v: montoMaximo },
            { k: 'Tope de cuota por capacidad de pago', v: capacidadPago },
            { k: 'Monto estimado que te prestarían', v: montoFinal, extra: true },
            { k: 'Mensualidad descontada de nómina', v: mensualidad },
            { k: 'Plazo aplicado', v: plazo, format: 'unit', unit: 'meses' },
            { k: 'CAT aplicado', v: cat, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Intereses totales', v: intereses },
            { k: 'Total que devuelves', v: totalPagado },
          ],
          chart: [
            { label: 'Capital prestado', value: montoFinal, tone: 'main' },
            { label: 'Intereses', value: intereses, tone: 'warn' },
          ],
        };
      }

      // ── Caso 5: préstamo personal ISSSTE ──────────────────────────────
      if (id === 'issste') {
        const sueldoQ = pos(v.sueldoQuincenal);
        const iq = tasa / 100 / K.quincenasPorAnio;
        const descuento = cuotaPeriodica(saldo, iq, plazoQ);
        const totalPagado = descuento * plazoQ;
        const intereses = totalPagado - saldo;
        const maxPermitido = sueldoQ * K.topeDescuentoIssste;
        const excede = sueldoQ > 0 && descuento > maxPermitido;
        const pctSueldo = sueldoQ > 0 ? (descuento / sueldoQ) * 100 : 0;
        const fueraDePrograma = saldo < K.montoMinIssste || saldo > K.montoMaxIssste;

        return {
          total: mxn(descuento),
          sub:
            'Descuento quincenal durante ' + plazoQ + ' quincenas. Devuelves ' + mxn(totalPagado) + ' en total, con ' +
            mxn(intereses) + ' de intereses. ' +
            (excede
              ? 'Supera el tope legal del 50% de tu sueldo básico quincenal: el máximo permitido sería ' + mxn(maxPermitido) +
                '. Pedí menos monto o más quincenas.'
              : sueldoQ > 0
                ? 'Equivale al ' + pctSueldo.toFixed(1) + '% de tu sueldo básico quincenal, dentro del tope legal del 50%.'
                : 'Cargá tu sueldo básico quincenal para verificar el tope legal del 50%.') +
            (fueraDePrograma ? ' Ojo: el monto queda fuera del rango habitual del programa.' : ''),
          rows: [
            { k: 'Monto del préstamo', v: saldo },
            { k: 'Descuento quincenal', v: descuento, extra: true },
            { k: 'Quincenas del préstamo', v: plazoQ, format: 'unit', unit: 'quincenas' },
            { k: 'Peso sobre tu sueldo básico quincenal', v: pctSueldo, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Descuento máximo permitido', ref: 'tope legal del 50%', v: maxPermitido },
            { k: 'Intereses totales', v: Math.max(0, intereses) },
            { k: 'Total que devuelves', v: totalPagado },
            { k: 'Monto mínimo del programa', v: K.montoMinIssste },
            { k: 'Monto máximo del programa', v: K.montoMaxIssste },
          ],
          chart: [
            { label: 'Monto prestado', value: saldo, tone: 'main' },
            { label: 'Intereses', value: Math.max(0, intereses), tone: 'warn' },
          ],
        };
      }

      // ── Caso 6: ¿esta oferta es real? ─────────────────────────────────
      const tachado = pos(v.precioTachado);
      const historico = pos(v.precioAntes);
      const oferta = precio;

      const descAnunciado = tachado > 0 ? (1 - oferta / tachado) * 100 : 0;
      const tieneHistorico = historico > 0;
      const descReal = tieneHistorico ? (1 - oferta / historico) * 100 : descAnunciado;
      const ahorroReal = tieneHistorico ? historico - oferta : tachado - oferta;
      const inflado = tieneHistorico && historico < tachado * 0.999;
      const infladoPct = inflado ? ((tachado - historico) / historico) * 100 : 0;
      const pagoMsi = oferta / plazoMeses;

      let veredicto;
      if (!tieneHistorico) {
        veredicto = 'Sin el precio histórico no se puede validar si el descuento es real.';
      } else if (descReal <= 0) {
        veredicto = 'Oferta falsa: pagas igual o más que semanas antes del evento.';
      } else if (descReal < descAnunciado / 2) {
        veredicto = 'Oferta inflada: el descuento real es ' + descReal.toFixed(1) + '%, no ' + descAnunciado.toFixed(1) + '%.';
      } else {
        veredicto = 'Descuento genuino: ' + descReal.toFixed(1) + '% real contra el precio de semanas antes.';
      }

      return {
        total: mxn(Math.max(0, ahorroReal)),
        sub:
          veredicto + ' La etiqueta anuncia ' + descAnunciado.toFixed(1) + '% contra el precio tachado' +
          (inflado ? ', que está inflado un ' + infladoPct.toFixed(1) + '% sobre lo que costaba antes' : '') +
          '. A ' + plazoMeses + ' meses sin intereses el pago sale en ' + mxn(pagoMsi) + ' al mes.',
        rows: [
          { k: 'Precio tachado que anuncia la tienda', v: tachado },
          { k: 'Precio real de semanas antes', v: historico },
          { k: 'Precio de la oferta', v: oferta },
          { k: 'Descuento anunciado', v: descAnunciado, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Descuento real', v: descReal, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Inflado del precio tachado', v: infladoPct, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Ahorro real en pesos', v: Math.max(0, ahorroReal), extra: true },
          { k: 'Pago mensual si lo difieres', v: pagoMsi },
        ],
        chart: [
          { label: 'Lo que pagas', value: oferta, tone: 'main' },
          { label: 'Ahorro real', value: Math.max(0, ahorroReal), tone: 'good' },
          { label: 'Descuento que solo existe en la etiqueta', value: Math.max(0, tachado - Math.max(historico, oferta)), tone: 'bad' },
        ],
      };
    });
  })();
</script>
