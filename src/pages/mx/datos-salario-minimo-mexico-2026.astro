---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Página-dato enlazable (autoridad) México: salario mínimo, UMA y prestaciones
// 2026. Datos: src/lib/data/mexico-2026.ts (salario general $315,04/día; UMA
// $117,31/día) + LFT. Patrón [[linkable-data-pages-strategy]] (Dataset+CC-BY).

const ULTIMA_REVISION = '2026-07-01';
const PAGE_URL = 'https://hacecuentas.com/mx/datos-salario-minimo-mexico-2026';

const salarios = [
  { c: 'Salario mínimo general', v: '$315,04 / día', n: '$9.577,22 / mes (× 30,4)' },
  { c: 'Salario mínimo Zona Libre Frontera Norte', v: '$440,87 / día', n: '$13.402,45 / mes' },
  { c: 'UMA diaria', v: '$117,31', n: 'vigente desde 01-feb-2026' },
  { c: 'UMA mensual', v: '$3.566,22', n: '' },
  { c: 'UMA anual', v: '$42.794,64', n: 'tope de muchas deducciones y multas' },
];

const prestaciones = [
  { c: 'Aguinaldo', v: '15 días (mínimo)', n: 'LFT Art. 87 · antes del 20-dic' },
  { c: 'Prima vacacional', v: '25% (mínimo)', n: 'sobre los días de vacaciones · LFT Art. 80' },
  { c: 'Vacaciones (primer año)', v: '12 días', n: 'reforma "vacaciones dignas" 2023 · +2 por año hasta 20' },
  { c: 'Prima de antigüedad', v: '12 días/año', n: 'al terminar la relación · LFT Art. 162' },
];

const title = 'Salario mínimo México 2026: $315,04 diario ($9.577 al mes) y UMA | Hacé Cuentas';
const description = 'Salario mínimo en México 2026: $315,04 diarios ($9.577,22 al mes) general y $440,87 en la Frontera Norte. UMA 2026 $117,31. Tabla con aguinaldo, prima vacacional y vacaciones dignas. Datos oficiales CONASAMI/INEGI, descargables (CC-BY 4.0).';

const faq = [
  { q: '¿Cuál es el salario mínimo en México 2026?', a: 'El salario mínimo general 2026 es de $315,04 pesos diarios (unos $9.577,22 al mes con el factor 30,4). En la Zona Libre de la Frontera Norte es de $440,87 diarios ($13.402,45 mensuales).' },
  { q: '¿Cuánto vale la UMA en 2026?', a: 'La UMA (Unidad de Medida y Actualización) 2026 es de $117,31 diaria, $3.566,22 mensual y $42.794,64 anual, vigente desde el 1 de febrero de 2026 (INEGI). Se usa como referencia de multas, trámites, créditos Infonavit y topes de deducciones.' },
  { q: '¿Por qué se usa la UMA y no el salario mínimo?', a: 'Desde 2016 la mayoría de obligaciones, multas y topes se calculan en UMA y no en salarios mínimos, para desvincular esos montos de los aumentos al salario. El salario mínimo se usa solo para lo laboral.' },
  { q: '¿Cuánto aguinaldo me corresponde?', a: 'El aguinaldo mínimo legal es de 15 días de salario, que el patrón debe pagar antes del 20 de diciembre (LFT Art. 87). Muchas empresas pagan más por contrato.' },
  { q: '¿Cuántos días de vacaciones tengo?', a: 'Con la reforma de "vacaciones dignas" (2023), el primer año dan 12 días, y aumentan 2 días por año hasta llegar a 20. Sobre esos días se paga una prima vacacional de al menos 25%.' },
  { q: '¿Cómo se calcula el ISR del salario?', a: 'El ISR sobre sueldos es progresivo (Art. 96 LISR, tarifa actualizada 2026). El patrón lo retiene cada mes según la tabla y el subsidio al empleo. Usá la calculadora de sueldo neto para tu caso.' },
  { q: '¿De dónde salen estos datos?', a: 'De CONASAMI y el DOF (salarios mínimos), INEGI y el DOF (UMA) y la Ley Federal del Trabajo (prestaciones). Fuentes al final.' },
  { q: '¿Puedo usar esta tabla en mi web, nota o trabajo?', a: 'Sí. Los datos se publican bajo licencia CC-BY 4.0: reproducilos citando la fuente con un enlace a hacecuentas.com. Más abajo está el bloque "Cómo citar".' },
];

const datasetSchema = {
  '@type': 'Dataset', '@id': `${PAGE_URL}#dataset`,
  name: 'Salario mínimo, UMA y prestaciones México 2026',
  description: 'Salario mínimo general y de la Zona Libre de la Frontera Norte, UMA (diaria, mensual y anual) y prestaciones laborales mínimas (aguinaldo, prima vacacional, vacaciones) vigentes en México en 2026.',
  url: PAGE_URL, license: 'https://creativecommons.org/licenses/by/4.0/', isAccessibleForFree: true,
  inLanguage: 'es-MX', dateModified: ULTIMA_REVISION, temporalCoverage: '2026',
  spatialCoverage: { '@type': 'Place', name: 'México' },
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  keywords: ['salario mínimo México 2026', 'UMA 2026', 'aguinaldo', 'prima vacacional', 'CONASAMI', 'México'],
  variableMeasured: ['Salario mínimo (MXN)', 'UMA (MXN)', 'Aguinaldo (días)', 'Prima vacacional (%)'],
  identifier: 'https://hacecuentas.com/datos/salario-minimo-mexico-2026.json', version: '2026',
  distribution: [
    { '@type': 'DataDownload', name: 'Salario mínimo México 2026 (JSON)', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datos/salario-minimo-mexico-2026.json' },
    { '@type': 'DataDownload', name: 'Salario mínimo México 2026 (CSV)', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datos/salario-minimo-mexico-2026.csv' },
  ],
};
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${PAGE_URL}#webpage`, name: title, description, url: PAGE_URL, inLanguage: 'es-MX', dateModified: ULTIMA_REVISION, mainEntity: { '@id': `${PAGE_URL}#dataset` } },
    datasetSchema,
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'México', item: 'https://hacecuentas.com/mx' },
      { '@type': 'ListItem', position: 2, name: 'Salario mínimo 2026', item: PAGE_URL },
    ]},
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<Layout image="/og/data-datos-salario-minimo-mexico-2026.jpg" imageWidth={1200} imageHeight={675} title={title} description={description} canonical="/mx/datos-salario-minimo-mexico-2026" audience="MX" lang="es" schema={schema} domain="data">
  <Header slot="header" />
  <main class="article-main">
    <article class="page-content datos-page">
      <header class="article-header">
        <nav class="crumbs" aria-label="Migas de pan"><a href="/mx">México</a> <span>›</span> <span>Salario mínimo 2026</span></nav>
        <h1>Salario mínimo en México 2026: general, frontera, UMA y prestaciones</h1>
        <p class="lede">El salario mínimo general 2026 es de <strong>$315,04 diarios</strong> ($9.577,22 al mes); en la Zona Libre de la Frontera Norte, <strong>$440,87</strong>. La <strong>UMA 2026</strong> es de <strong>$117,31</strong> diaria. Más aguinaldo, prima vacacional y vacaciones.</p>
        <p class="updated">Última revisión: <time datetime={ULTIMA_REVISION}>{new Date(ULTIMA_REVISION).toLocaleDateString('es-MX')}</time> · Licencia <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC-BY 4.0</a> (uso libre con atribución)</p>
      </header>

      <section class="stats-callout">
        <div class="stat"><span class="stat-num">$315,04</span><span class="stat-label">mínimo general / día</span></div>
        <div class="stat"><span class="stat-num">$9.577,22</span><span class="stat-label">mínimo general / mes</span></div>
        <div class="stat"><span class="stat-num">$440,87</span><span class="stat-label">mínimo ZLFN / día</span></div>
        <div class="stat"><span class="stat-num">$117,31</span><span class="stat-label">UMA diaria 2026</span></div>
      </section>

      <section>
        <h2>Salario mínimo y UMA 2026</h2>
        <div class="table-wrap"><table>
          <thead><tr><th>Concepto</th><th>Valor 2026</th></tr></thead>
          <tbody>{salarios.map((r) => (<tr><td data-label="Concepto"><strong>{r.c}</strong>{r.n ? <span class="sub"> · {r.n}</span> : null}</td><td data-label="Valor">{r.v}</td></tr>))}</tbody>
        </table></div>
      </section>

      <section>
        <h2>Prestaciones laborales mínimas (LFT)</h2>
        <div class="table-wrap"><table>
          <thead><tr><th>Concepto</th><th>2026</th></tr></thead>
          <tbody>{prestaciones.map((r) => (<tr><td data-label="Concepto"><strong>{r.c}</strong>{r.n ? <span class="sub"> · {r.n}</span> : null}</td><td data-label="Valor">{r.v}</td></tr>))}</tbody>
        </table></div>
      </section>

      <section>
        <h2>Calculá tu caso</h2>
        <ul class="calc-links">
          <li><a href="/calculadora-sueldo-neto-mexico-isr-imss">Sueldo neto (ISR e IMSS)</a></li>
          <li><a href="/categoria/finanzas">Aguinaldo neto 2026</a></li>
          <li><a href="/calculadora-finiquito-liquidacion-mexico-2026">Finiquito y liquidación</a></li>
          <li><a href="/mx/calculadoras">Todas las calculadoras de México →</a></li>
        </ul>
      </section>

      <section aria-label="Salario mínimo en otros países">
        <h2>Salario mínimo en otros países</h2>
        <ul class="calc-links">
          <li><a href="/co/datos-salario-minimo-colombia-2026">Salario mínimo Colombia 2026</a></li>
          <li><a href="/datos-salario-basico-ecuador-2026">Salario básico Ecuador 2026</a></li>
          <li><a href="/datos-salario-minimo-latam-2026">Comparativa salario mínimo LATAM</a></li>
          <li><a href="/feriados-mexico-2026">Feriados y calendario México 2026</a></li>
        </ul>
      </section>

      <section class="cite-instructions">
        <h2>Descargar estos datos</h2>
        <p>Datos abiertos (CC-BY 4.0): <a href="/datos/salario-minimo-mexico-2026.json" download>⬇ JSON</a> · <a href="/datos/salario-minimo-mexico-2026.csv" download>⬇ CSV</a></p>
      </section>
      <section class="cite-instructions">
        <h2>Cómo citar esta tabla</h2>
        <p>¿Usás estos datos en una nota, trabajo, app o web? La atribución pedida es:</p>
        <pre><code>Fuente: Hacé Cuentas — https://hacecuentas.com/mx/datos-salario-minimo-mexico-2026
Salario mínimo, UMA y prestaciones México 2026 · Licencia CC-BY 4.0</code></pre>
      </section>

      <section class="faq"><h2>Preguntas frecuentes</h2>{faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}</section>
      <section class="fuentes"><h2>Fuentes</h2><ul>
        <li>CONASAMI / DOF — salarios mínimos 2026.</li>
        <li>INEGI / DOF — UMA 2026 (vigente desde 01-feb-2026).</li>
        <li>Ley Federal del Trabajo — aguinaldo, prima vacacional, vacaciones, prima de antigüedad.</li>
      </ul></section>
    </article>
  </main>
  <Footer slot="footer" />
</Layout>

<style>
  .datos-page { max-width: 900px; margin: 0 auto; padding: 1rem 1rem 4rem; }
  .crumbs { font-size: 0.85rem; color: var(--text-muted, #666); margin-bottom: 0.75rem; }
  .crumbs a { color: var(--accent, #2563eb); text-decoration: none; }
  .datos-page h1 { font-size: 2rem; line-height: 1.2; margin-bottom: 1rem; }
  .lede { font-size: 1.1rem; line-height: 1.6; color: var(--text, #222); }
  .updated { font-size: 0.85rem; color: var(--text-muted, #666); margin-top: 0.5rem; }
  .datos-page h2 { font-size: 1.4rem; margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .stats-callout { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin: 1.75rem 0; }
  .stat { background: var(--bg-soft, #f4f6f9); border: 1px solid var(--border, #e5e7eb); border-radius: 0.6rem; padding: 0.9rem 1rem; text-align: center; }
  .stat-num { display: block; font-size: 1.15rem; font-weight: 700; color: var(--accent, #2563eb); line-height: 1.2; }
  .stat-label { display: block; font-size: 0.8rem; color: var(--text-muted, #666); margin-top: 0.25rem; }
  .table-wrap { overflow-x: auto; margin: 1.25rem 0; }
  .datos-page table { width: 100%; border-collapse: collapse; font-size: 0.95rem; min-width: 420px; }
  .datos-page th { background: var(--bg-soft, #f1f5f9); padding: 0.6rem 0.7rem; text-align: right; font-weight: 600; border-bottom: 2px solid var(--border, #e5e7eb); }
  .datos-page th:first-child { text-align: left; }
  .datos-page td { padding: 0.55rem 0.7rem; text-align: right; border-bottom: 1px solid var(--border, #eee); }
  .datos-page td:first-child { text-align: left; }
  .datos-page tbody tr:nth-child(odd) { background: var(--bg-card, #fafafa); }
  .sub { color: var(--text-subtle, #888); font-weight: 400; font-size: 0.85em; }
  .calc-links li { line-height: 1.7; margin-bottom: 0.5rem; }
  .calc-links, .fuentes ul { margin-left: 1.25rem; }
  .calc-links a, .fuentes a { color: var(--accent, #2563eb); }
  .fuentes li { line-height: 1.6; margin-bottom: 0.4rem; }
  .cite-instructions { margin-top: 2rem; padding: 1.1rem; background: var(--bg-soft, #f4f6f9); border-radius: 0.6rem; }
  .cite-instructions pre { background: var(--code-bg, #eaeef3); padding: 0.75rem; border-radius: 0.4rem; overflow-x: auto; font-size: 0.85rem; }
  .faq details { border-bottom: 1px solid var(--border, #e5e7eb); padding: 0.75rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq details p { margin-top: 0.5rem; color: var(--text-muted, #555); line-height: 1.6; }
</style>
