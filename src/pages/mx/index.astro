---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import PillarHub from '../../components/PillarHub.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
import { canDistributeCalc } from '../../lib/content-policy';
import { createLocaleCalcUrl } from '../../lib/locale-calc-url';
import { MEXICO_2026, fmtMXN, isrMensual2026, cuotaImssObreroMensual } from '../../lib/data/mexico-2026';
import mxLive from '../../data/live/mexico.json';

const localeModules = import.meta.glob<any>('../../content/calcs-mx/*.json', { eager: true });
const mainModules = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
const localeCalcs = Object.values(localeModules).map((m: any) => m.default || m).filter((c: any) => canDistributeCalc(c, 'mx'));
const audienceFiltered = Object.values(mainModules)
  .map((m: any) => m.default || m)
  .filter((c: any) => c.audience === 'MX' && canDistributeCalc(c));
const calcs = [...localeCalcs, ...audienceFiltered];

const calcUrl = createLocaleCalcUrl('mx', localeCalcs);

const byCategory: Record<string, any[]> = {};
calcs.forEach((c) => {
  if (!byCategory[c.category]) byCategory[c.category] = [];
  byCategory[c.category].push(c);
});

const categoryMeta: Record<string, { label: string; desc: string; color: string; icon: string }> = {
  finanzas:        { label: 'Finanzas',       desc: 'Sueldo, ISR, ahorro, AFORE, hipoteca.',                color: '#2563eb', icon: '💰' },
  impuestos:       { label: 'Impuestos',      desc: 'ISR 2026, IVA 16%, RFC, declaración anual SAT.',                color: '#7c3aed', icon: '🧾' },
  salud:           { label: 'Salud',          desc: 'IMC, calorías, embarazo, fitness.',                  color: '#16a34a', icon: '❤️' },
  familia:         { label: 'Familia',        desc: 'Maternidad, escolarización, hijos.',                  color: '#db2777', icon: '👨‍👩‍👧' },
  vida:            { label: 'Vida cotidiana', desc: 'Renta, escrituración, costo de vida.',                     color: '#d97706', icon: '🏠' },
  automotor:       { label: 'Automotor',      desc: 'Tenencia, verificación, financiamiento auto.',                color: '#6366f1', icon: '🚗' },
  educacion:       { label: 'Educación',      desc: 'Becas CONACYT, calificaciones.',                color: '#8b5cf6', icon: '🎓' },
  negocios:        { label: 'Negocios',       desc: 'Márgenes, IVA, modelos fiscales.',                   color: '#0891b2', icon: '📊' },
  marketing:       { label: 'Marketing',      desc: 'CTR, CPC, ROAS, CAC, LTV.',                          color: '#e11d48', icon: '📈' },
  deportes:        { label: 'Deportes',       desc: 'Pace, 1RM, VO2 max, ciclismo.',                      color: '#65a30d', icon: '🏃' },
  viajes:          { label: 'Viajes',         desc: 'Combustible, presupuesto, propinas.',                color: '#0891b2', icon: '✈️' },
  cocina:          { label: 'Cocina',         desc: 'Tazas a gramos, ajustar receta.',                    color: '#ea580c', icon: '🍳' },
  mascotas:        { label: 'Mascotas',       desc: 'Edad perro/gato, alimentación.',                     color: '#db2777', icon: '🐕' },
  matematica:      { label: 'Matemática',     desc: 'Promedios, Pitágoras, conversores.',                 color: '#0d9488', icon: '🧮' },
  tecnologia:      { label: 'Tecnología',     desc: 'Almacenamiento, IA, batería, cloud.',                color: '#06b6d4', icon: '💻' },
  'medio-ambiente':{ label: 'Medio Ambiente', desc: 'Huella de carbono, energía solar.',                  color: '#22c55e', icon: '🌱' },
  electronica:     { label: 'Electrónica',    desc: 'Ley de Ohm, kWh, circuitos.',                        color: '#f59e0b', icon: '⚡' },
  ciencia:         { label: 'Ciencia',        desc: 'Física, química, astronomía.',                       color: '#6366f1', icon: '🔬' },
  jardineria:      { label: 'Jardinería',     desc: 'Riego, tierra, siembra.',                            color: '#15803d', icon: '🌿' },
  construccion:    { label: 'Construcción',   desc: 'Materiales, presupuesto reforma.',                   color: '#b45309', icon: '🧱' },
};

const categoryOrder = ['impuestos','finanzas','vida','familia','salud','automotor','educacion','negocios','marketing','deportes','viajes','cocina','mascotas','matematica','tecnologia','medio-ambiente','electronica','ciencia','jardineria','construccion'];
const activeCategories = categoryOrder.filter((cat) => byCategory[cat] && byCategory[cat].length > 0);

const totalCalcs = calcs.length;

const popularSlugs = [
  'calculadora-isr-mexico-2026-tarifa-mensual-empleado',
  'calculadora-finiquito-liquidacion-mexico',
  'calculadora-imss-cuotas-empleado-patron-mexico-2026',
  'calculadora-aguinaldo-mexico-2026-15-dias-tope-30',
  'calculadora-prima-vacacional-mexico',
  'calculadora-rfc-homoclave-persona-fisica-mexico'
];
const popular = popularSlugs.map((s) => calcs.find((c) => c.slug === s)).filter(Boolean);

// ── Datos clave 2026 — todo computado desde src/lib/data/mexico-2026.ts (fuente única, nunca stale) ──
const M = MEXICO_2026;
const usdmxn = (mxLive as any)?.usdmxn?.valor ?? 17.23;
const usdmxnStr = `$${usdmxn.toFixed(2).replace('.', ',')}`;
const liveMes = new Date((mxLive as any)?._meta?.fetchedAt ?? '2026-06-01').toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });
// Ejemplo de sueldo neto: bruto mensual $15.000 (ISR Art. 96 + cuota obrera IMSS, SBC ≈ bruto)
const ejemploBruto = 15000;
const isrEjemplo = isrMensual2026(ejemploBruto);
const imssEjemplo = cuotaImssObreroMensual(ejemploBruto);
const netoEjemplo = ejemploBruto - isrEjemplo - imssEjemplo;
const aguinaldoSm = M.salarioMinimo.generalDiario * M.lft.aguinaldoDiasMinimo;
const topePrimaAntiguedadDiario = M.salarioMinimo.generalDiario * M.lft.primaAntiguedad.topeSalarioVecesSm;
const exentoAguinaldo = M.uma.diaria * M.exencionesIsrUmas.aguinaldo;

const datosClave = [
  { k: 'Salario mínimo general', v: `${fmtMXN(M.salarioMinimo.generalDiario)} /día — ${fmtMXN(M.salarioMinimo.generalMensual)} /mes`, src: 'CONASAMI, DOF 09-dic-2025' },
  { k: 'Salario mínimo frontera norte (ZLFN)', v: `${fmtMXN(M.salarioMinimo.zlfnDiario)} /día — ${fmtMXN(M.salarioMinimo.zlfnMensual)} /mes`, src: 'CONASAMI, DOF 09-dic-2025' },
  { k: 'UMA 2026', v: `${fmtMXN(M.uma.diaria)} /día — ${fmtMXN(M.uma.mensual)} /mes`, src: 'INEGI, vigente desde 01-feb-2026' },
  { k: `Dólar (USD, ${liveMes})`, v: usdmxnStr, src: 'Tipo de cambio de mercado' },
  { k: 'ISR mensual (tarifa Art. 96)', v: '1.92% a 35%', src: 'SAT, Anexo 8 RMF 2026' },
  { k: 'Subsidio para el empleo', v: `${fmtMXN(M.subsidioEmpleo.montoMensual)} /mes (ingresos hasta ${fmtMXN(M.subsidioEmpleo.topeIngresoMensual)})`, src: 'Decreto DOF 31-dic-2025' },
  { k: 'Cuota obrera IMSS', v: '2.375% del SBC (+0.4% sobre el excedente de 3 UMA)', src: 'Ley del Seguro Social' },
  { k: 'Aguinaldo mínimo', v: `${M.lft.aguinaldoDiasMinimo} días de salario (antes del 20-dic)`, src: 'LFT Art. 87' },
  { k: 'Prima vacacional mínima', v: '25% sobre los días de vacaciones', src: 'LFT Art. 80' },
  { k: 'INFONAVIT (aportación patronal)', v: '5% del SBC', src: 'Ley INFONAVIT Art. 29' },
];

// ── Las más buscadas — calcs MX con más tracción real en Bing (GSC/Bing Webmaster, jun-2026) ──
const masBuscadas = [
  { slug: 'calculadora-prima-antiguedad-mexico', icon: '🎖️', title: 'Prima de antigüedad', desc: `12 días de salario por año trabajado, con salario topado a 2 veces el mínimo (${fmtMXN(topePrimaAntiguedadDiario)} diarios en 2026).` },
  { slug: 'calculadora-placas-auto-costo-mexico', icon: '🪪', title: 'Costo de placas de auto', desc: 'Cuánto cuesta emplacar un auto según el estado: placas, tarjeta de circulación y refrendo.' },
  { slug: 'calculadora-imss-cuotas-empleado-patron-mexico-2026', icon: '🏥', title: 'Cuotas IMSS 2026', desc: 'Cuánto aportan trabajador y patrón al IMSS sobre tu salario base de cotización.' },
  { slug: 'calculadora-isr-honorarios-persona-fisica', icon: '💼', title: 'ISR por honorarios', desc: 'ISR de actividad profesional con retención del 10% si facturás a persona moral.' },
  { slug: 'calculadora-credito-infonavit-descuento', icon: '🏠', title: 'Descuento Infonavit', desc: 'Cuánto te descuentan del sueldo por tu crédito Infonavit según el factor de pago.' },
  { slug: 'calculadora-impuesto-cedular-arrendamiento-mexico', icon: '🏘️', title: 'ISR por arrendamiento', desc: `ISR por rentar un inmueble, con la deducción ciega del ${(M.arrendamiento.deduccionCiega * 100).toFixed(0)}% sin comprobantes.` },
];

// ── Equivalencias AR → MX: inyecta autoridad interna desde el catálogo argentino ya posicionado ──
const equivalentesAr = [
  { ar: 'sueldo-en-mano-argentina', arLabel: 'Sueldo en mano (Argentina)', mx: 'calculadora-sueldo-neto-mexico', mxLabel: 'Sueldo neto en México', concepto: 'Sueldo neto' },
  { ar: 'calculadora-aguinaldo-sac', arLabel: 'Aguinaldo (SAC) Argentina', mx: 'calculadora-aguinaldo-mexico-2026-15-dias-tope-30', mxLabel: 'Aguinaldo en México (15 días)', concepto: 'Aguinaldo' },
  { ar: 'calculadora-monotributo-2026', arLabel: 'Monotributo Argentina', mx: 'calculadora-rfc-cuota-resico-pf-mexico', mxLabel: 'RESICO persona física', concepto: 'Régimen simplificado' },
  { ar: 'calculadora-vacaciones-argentina', arLabel: 'Vacaciones Argentina', mx: 'calculadora-vacaciones-mexico-2024-reforma-12-dias-incremento', mxLabel: 'Vacaciones dignas en México', concepto: 'Vacaciones' },
  { ar: 'calculadora-indemnizacion-despido', arLabel: 'Indemnización por despido Argentina', mx: 'calculadora-finiquito-mexico-completo-rescision-relacion', mxLabel: 'Finiquito en México', concepto: 'Indemnización / finiquito' },
];

// ── FAQ país-específica: respuestas con cifras computadas desde la fuente única ──
const faq = [
  {
    q: '¿Cuál es el salario mínimo en México en 2026?',
    a: `Desde el 1 de enero de 2026 el salario mínimo general es de ${fmtMXN(M.salarioMinimo.generalDiario)} diarios (${fmtMXN(M.salarioMinimo.generalMensual)} al mes) y en la Zona Libre de la Frontera Norte de ${fmtMXN(M.salarioMinimo.zlfnDiario)} diarios (${fmtMXN(M.salarioMinimo.zlfnMensual)} al mes), según la resolución de CONASAMI publicada en el DOF.`,
  },
  {
    q: '¿Cómo se calcula el sueldo neto en México 2026?',
    a: `Al sueldo bruto se le resta el ISR (tarifa mensual del Art. 96 LISR, del 1.92% al 35%) y la cuota obrera del IMSS (~2.375% del SBC más 0.4% del excedente de 3 UMA). Ejemplo: con ${fmtMXN(ejemploBruto)} brutos al mes pagás ${fmtMXN(isrEjemplo)} de ISR y ${fmtMXN(imssEjemplo)} de IMSS, y te quedan ${fmtMXN(netoEjemplo)} netos aproximados.`,
  },
  {
    q: '¿Cuánto vale la UMA en 2026 y para qué sirve?',
    a: `La UMA 2026 vale ${fmtMXN(M.uma.diaria)} diarios (${fmtMXN(M.uma.mensual)} mensuales), vigente desde el 1 de febrero de 2026 (INEGI). Se usa para topes del IMSS e INFONAVIT, exenciones de ISR, multas y créditos: por ejemplo, el SBC se topa en 25 UMA y el aguinaldo está exento hasta 30 UMA (${fmtMXN(exentoAguinaldo)}).`,
  },
  {
    q: '¿Cuánto me toca de aguinaldo en 2026?',
    a: `El mínimo legal son ${M.lft.aguinaldoDiasMinimo} días de salario, pagaderos antes del 20 de diciembre (LFT Art. 87). Con salario mínimo general son ${fmtMXN(aguinaldoSm)}. Si trabajaste menos de un año, te corresponde la parte proporcional. Está exento de ISR hasta 30 UMA (${fmtMXN(exentoAguinaldo)}).`,
  },
  {
    q: '¿Cuánto descuentan de IMSS al trabajador?',
    a: `La cuota obrera es ~2.375% del salario base de cotización (enfermedad y maternidad en dinero, gastos médicos de pensionados, invalidez y vida, y cesantía y vejez), más 0.4% sobre lo que exceda de 3 UMA. El patrón paga mucho más: cuota fija de 20.40% de la UMA por trabajador, retiro 2%, CEAV progresivo (3.15% a 7.513% en 2026), INFONAVIT 5% y riesgo de trabajo.`,
  },
  {
    q: '¿Quién recibe el subsidio para el empleo en 2026?',
    a: `Los trabajadores con ingreso mensual de hasta ${fmtMXN(M.subsidioEmpleo.topeIngresoMensual)}: el subsidio es de ${fmtMXN(M.subsidioEmpleo.montoMensual)} mensuales y se resta del ISR a retener (decreto DOF 31-dic-2025). Por eso quien gana el salario mínimo no paga ISR.`,
  },
  {
    q: '¿Cómo se calcula la prima de antigüedad?',
    a: `Son ${M.lft.primaAntiguedad.diasPorAnio} días de salario por cada año de servicio (LFT Art. 162), con el salario topado a ${M.lft.primaAntiguedad.topeSalarioVecesSm} veces el mínimo: en 2026 el tope es ${fmtMXN(topePrimaAntiguedadDiario)} diarios. Se paga al renunciar con 15+ años de antigüedad, o en cualquier despido o muerte del trabajador.`,
  },
  {
    q: '¿Cuántos días de vacaciones corresponden en 2026?',
    a: `Con la reforma de "vacaciones dignas" (LFT Art. 76): ${M.lft.vacacionesPorAnio[0]} días el primer año, y suben 2 por año hasta ${M.lft.vacacionesPorAnio[4]} en el quinto; después aumentan 2 días cada 5 años. Además se paga prima vacacional mínima del 25% sobre esos días (LFT Art. 80).`,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['CollectionPage', 'WebPage'],
      '@id': 'https://hacecuentas.com/mx#webpage',
      url: 'https://hacecuentas.com/mx',
      name: 'Calculadoras México 2026 — ISR, IMSS, RFC | Hacé Cuentas',
      description: `Calculadoras gratis específicas para México.`,
      inLanguage: 'es-MX',
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      breadcrumb: { '@id': 'https://hacecuentas.com/mx#breadcrumb' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://hacecuentas.com/mx#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Hacé Cuentas', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'México', item: 'https://hacecuentas.com/mx' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://hacecuentas.com/mx#faq',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Dataset',
      '@id': 'https://hacecuentas.com/mx#datos-2026',
      name: 'Datos laborales y fiscales de México 2026',
      description: `Valores oficiales vigentes en México 2026: salario mínimo (${fmtMXN(M.salarioMinimo.generalDiario)} diarios general, ${fmtMXN(M.salarioMinimo.zlfnDiario)} ZLFN), UMA (${fmtMXN(M.uma.diaria)} diaria), tarifa de ISR, subsidio para el empleo, cuotas IMSS, aguinaldo, prima vacacional e INFONAVIT.`,
      url: 'https://hacecuentas.com/mx',
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      inLanguage: 'es-MX',
      temporalCoverage: '2026',
      spatialCoverage: { '@type': 'Place', name: 'México' },
      creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
      sourceOrganization: [
        { '@type': 'GovernmentOrganization', name: 'CONASAMI', url: 'https://www.gob.mx/conasami' },
        { '@type': 'GovernmentOrganization', name: 'SAT', url: 'https://www.sat.gob.mx' },
        { '@type': 'GovernmentOrganization', name: 'IMSS', url: 'https://www.imss.gob.mx' },
      ],
      keywords: ['salario mínimo México 2026', 'UMA 2026', 'tarifa ISR 2026', 'cuotas IMSS 2026', 'subsidio para el empleo 2026', 'aguinaldo'],
    },
  ],
};

// Set hreflang único y simétrico para todas las homes (es + en + pt +
// 6 verticales + global), x-default → home raíz. Ver src/lib/hreflang.ts.
const hreflangTags = HOME_HREFLANG;

// Identidad de hub (mockup): hero vía PillarHub full-bleed; el contenido del país
// (populares, categorías, datos, FAQ) se preserva debajo dentro de .cc-index.
const hubConfig = {
  color: '#2563eb',
  nav: 'México',
  h1: 'Calculadoras para México',
  breadcrumb: [{ label: 'Hacé Cuentas', href: '/' }, { label: 'México' }],
  eyebrow: '🇲🇽 México · 2026',
  titleLines: ['Calculadoras', 'para México'],
  lead: 'ISR, IMSS, RFC, finiquito, INFONAVIT, aguinaldo y prima vacacional. Datos oficiales SAT, IMSS y CONDUSEF. Gratis y sin registro.',
  trust: [`${totalCalcs} calculadoras`, 'Datos oficiales 2026', 'Gratis y sin registro'],
  quick: { tag: 'Dato en vivo', title: 'Dólar hoy en México', desc: 'Cotización de mercado, actualizada a diario.', cta: `Ver dólar · ${usdmxnStr} →`, href: '/dolar-hoy-mexico', variant: 'cta' as const },
  needsKicker: '', needsTitle: '', needsSub: '', needs: [] as any[],
  featuredKicker: '', featuredTitle: '', featuredSub: '', showFeaturedSearch: false, filterBadges: [] as string[], cards: [] as any[],
  roomsKicker: '', roomsTitle: '', roomsSub: '', rooms: [] as any[], factsTitle: '', facts: [] as any[],
};
---

<Layout
  title="Calculadoras México 2026 — ISR, IMSS, RFC | Hacé Cuentas"
  description={`${totalCalcs} calculadoras gratis para México: ISR, IMSS, RFC, finiquito, INFONAVIT, AFORE. Datos oficiales SAT 2026.`}
  lang="es"
  audience="MX"
  hreflang={hreflangTags}
  schema={schema}
  pageType="hub"
>
  <Header slot="header" />

  <PillarHub config={hubConfig} />

  <div class="cc-index">

    {popular.length > 0 && (
      <section class="popular-section" aria-label="Más usadas">
        <h2 class="popular-title">Más usadas en México</h2>
        <div class="popular-grid">
          {popular.map((c: any) => (
            <a href={calcUrl(c)} class="popular-card">
              <span class="popular-icon">{c.icon || '🧮'}</span>
              <span class="popular-label">{c.h1}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="top-bing" aria-labelledby="mas-buscadas-title">
      <h2 id="mas-buscadas-title">Las más buscadas en México</h2>
      <p class="section-sub">Las calculadoras mexicanas con más búsquedas este mes.</p>
      <div class="top-grid">
        {masBuscadas.map((c) => (
          <a href={`/mx/${c.slug}`} class="top-card">
            <span class="t-icon" aria-hidden="true">{c.icon}</span>
            <span>
              <span class="t-title">{c.title}</span>
              <span class="t-desc">{c.desc}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="datos-clave" aria-labelledby="datos-clave-title">
      <h2 id="datos-clave-title">Datos clave de México 2026</h2>
      <p class="section-sub">Los valores oficiales que usan todas nuestras calculadoras mexicanas. Uso libre con atribución (CC-BY 4.0).</p>
      <div class="dc-wrap">
        <table class="dc-table">
          <thead>
            <tr><th>Concepto</th><th>Valor 2026</th><th>Fuente</th></tr>
          </thead>
          <tbody>
            {datosClave.map((d) => (
              <tr><td>{d.k}</td><td>{d.v}</td><td class="dc-src">{d.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dc-note">Última revisión: 10 de junio de 2026. Fuentes: DOF, CONASAMI, INEGI, SAT e IMSS.</p>
    </section>

    <section class="popular-section" aria-label="Más recursos de México">
      <h2 class="popular-title">Más recursos de México</h2>
      <div class="popular-grid">
        <a href="/dolar-hoy-mexico" class="popular-card"><span class="popular-icon">💵</span><span class="popular-label">Dólar hoy en México</span></a>
        <a href="/feriados-mexico-2026" class="popular-card"><span class="popular-icon">📅</span><span class="popular-label">Feriados México 2026</span></a>
        <a href="/mx/datos-salario-minimo-mexico-2026" class="popular-card"><span class="popular-icon">💵</span><span class="popular-label">Salario mínimo México 2026</span></a>
        <a href="/datos-salario-minimo-latam-2026" class="popular-card"><span class="popular-icon">🌎</span><span class="popular-label">Salario mínimo LATAM</span></a>
        <a href="/prestaciones-laborales-por-pais" class="popular-card"><span class="popular-icon">📋</span><span class="popular-label">Prestaciones laborales por país</span></a>
        <a href="/mx/decidir" class="popular-card"><span class="popular-icon">🧭</span><span class="popular-label">Salas de decisión</span></a>
      </div>
    </section>

    <div class="categories">
      {activeCategories.map((catKey) => {
        const meta = categoryMeta[catKey];
        const catCalcs = byCategory[catKey];
        return (
          <section class="category-section" aria-labelledby={`cat-${catKey}`}>
            <div class="cat-header">
              <span class="cat-icon" aria-hidden="true" style={`background: ${meta?.color}18`}>{meta?.icon ?? '📁'}</span>
              <div class="cat-meta">
                <h2 id={`cat-${catKey}`} class="cat-label">{meta?.label ?? catKey}</h2>
                {meta?.desc && <p class="cat-desc">{meta.desc}</p>}
              </div>
            </div>
            <div class="calc-grid">
              {catCalcs.map((calc: any) => (
