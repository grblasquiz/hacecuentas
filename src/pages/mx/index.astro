---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MexicoHomeExperience from '../../components/generated/MexicoHomeExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
const canonical='https://hacecuentas.com/mx';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Hacé Cuentas México",url:canonical,operatingSystem:'Web'};
---
<Layout title="Hacé Cuentas México | Hacé Cuentas" description="Hacé Cuentas México. Herramienta clara, gratuita y actualizada." canonical={canonical} schema={schema} lang="es" hreflang={HOME_HREFLANG}>
  <Header />
  <MexicoHomeExperience />
  <RecoveredHubIntro eyebrow="México" h1="Calculadoras para México" lede="Cuentas claras para sueldo, prestaciones, impuestos, vivienda y decisiones cotidianas." note="Cada herramienta explica las variables usadas y el alcance del resultado." links={[{href:'/mx/calculadoras',title:'Todas las calculadoras',description:'Catálogo completo para México.'},{href:'/mx/trabajo',title:'Trabajo',description:'Sueldo neto, aguinaldo, finiquito e IMSS.'},{href:'/mx/impuestos',title:'Impuestos',description:'ISR, IVA y obligaciones frecuentes.'}]} />
  <Footer />
</Layout>
