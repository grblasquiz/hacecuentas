---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MexicoHomeExperience from '../../components/generated/MexicoHomeExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
const canonical='https://hacecuentas.com/mx';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Hacé Cuentas México",url:canonical,operatingSystem:'Web'};
---
<Layout title="Calculadoras de México 2026: sueldo, ISR e IMSS | Hacé Cuentas" description="Calculadoras de México actualizadas a 2026 para sueldo neto, ISR, IMSS, aguinaldo, finiquito, vivienda y trámites, con fuentes oficiales." canonical={canonical} schema={schema} lang="es" hreflang={HOME_HREFLANG}>
  <Header />
  <MexicoHomeExperience />
  <RecoveredHubIntro headingLevel="h2" eyebrow="México 2026" h1="Datos y cálculos más consultados" lede="Entrá directo a las referencias laborales y calendarios con mayor demanda en México." note="Cada página muestra su fuente, vigencia y las herramientas para calcular tu caso." links={[
    {href:'/mx/datos-salario-minimo-mexico-2026',title:'Salario mínimo México 2026',description:'Valor diario, mensual, frontera norte y prestaciones.'},
    {href:'/mx/datos-uma-imss-2026',title:'UMA 2026',description:'Valor diario, mensual y anual para IMSS, multas y topes.'},
    {href:'/feriados-mexico-2026',title:'Feriados México 2026',description:'Calendario oficial, descansos obligatorios y puentes.'},
    {href:'/mx/trabajo/sueldo-neto',title:'Sueldo neto',description:'ISR, IMSS, subsidio y pago mensual estimado.'},
    {href:'/mx/calculadoras',title:'Todas las herramientas de México',description:'Catálogo completo por tema.'}
  ]} />
  <Footer />
</Layout>
