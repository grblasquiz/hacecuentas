---
/**
 * Hub de decisión MX — "¿De cuánto va a ser mi pensión y me alcanzan las semanas?"
 *
 * El audience="MX" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import PensionImssMexicoExperience from '../../../components/generated/PensionImssMexicoExperience.astro';
import {
  hub,
  UMA_MX,
  SM_MX,
  LEY73_MX,
  PMG_MX,
  INVALIDEZ_MX,
  IMSS_MX,
  ISSSTE_MX,
  VIUDEZ_MX,
} from '../../../lib/hubs/mx/mi-pension-imss';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PensionImssMexicoExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

