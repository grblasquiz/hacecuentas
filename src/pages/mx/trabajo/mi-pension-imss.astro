---
/**
 * Hub de decisión MX — "¿De cuánto va a ser mi pensión y me alcanzan las semanas?"
 *
 * El audience="MX" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PensionImssMexicoExperience from '../../../components/generated/PensionImssMexicoExperience.astro';
import {
  hub,
  UMA_MX,
  SM_MX,
  LEY73_MX,
  PMG_MX,
  INVALIDEZ_MX,
  IMSS_MX,
  ISSSTE_MX,
  VIUDEZ_MX,
} from '../../../lib/hubs/mx/mi-pension-imss';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PensionImssMexicoExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    UMA: UMA_MX,
    SM: SM_MX,
    L73: LEY73_MX,
    PMG: PMG_MX,
    INV: INVALIDEZ_MX,
    IMSS: IMSS_MX,
    ISSSTE: ISSSTE_MX,
    VIU: VIUDEZ_MX,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const mxn = (n) => '$' + Math.round(n || 0).toLocaleString('es-MX');
    const pct = (n, d) => (n * 100).toFixed(d === undefined ? 2 : d).replace('.', ',') + '%';

    /** Renglón de la tabla del Art. 167 LSS-73 según el salario diario en veces la UMA. */
    function filaArt167(veces) {
      const t = L73.tablaArt167;
      for (const f of t) {
        const hasta = f[0] === null ? Infinity : f[0];
        if (veces <= hasta) return f;
      }
      return t[t.length - 1];
    }

    /** Tasa CEAV patronal 2026 por nivel de SBC diario (tabla de la reforma de pensiones). */
    function tasaCeav(sbcDiario) {
      if (!(sbcDiario > 0)) return 0;
      if (sbcDiario <= SM.generalDiario) return IMSS.ceavTabla2026[0].tasa;
      const umas = sbcDiario / UMA.diaria;
      for (const f of IMSS.ceavTabla2026) {
        const hasta = f.hastaUmas === null ? Infinity : f.hastaUmas;
        if (umas <= hasta) return f.tasa;
      }
      return IMSS.ceavTabla2026[IMSS.ceavTabla2026.length - 1].tasa;
    }

    /**
     * Pensión Ley 73 a partir de un salario MENSUAL promedio, semanas y edad.
     * Réplica de src/lib/formulas/pension-imss-ley-73-mexico.ts.
     */
    function ley73(salarioMensual, semanas, edad, conConyuge, hijos) {
      const pensionMinima = SM.generalDiario * L73.diasMesOficial * L73.factorDecreto2001;
      if (semanas < L73.semanasMinimas) {
        return { ok: false, faltan: L73.semanasMinimas - semanas, pensionMinima };
      }
      const salarioDiario = salarioMensual / SM.factorMensual;
      const topeDiario = UMA.diaria * L73.topeSalarioUmas;
      const diarioTopado = Math.min(salarioDiario, topeDiario);
      const mensualTopado = diarioTopado * SM.factorMensual;
      const topado = salarioDiario > topeDiario;

      const veces = diarioTopado / UMA.diaria;
      const fila = filaArt167(veces);
      const cuantiaPct = fila[1];
      const incrementoPct = fila[2];

      const cuantiaBasica = cuantiaPct * mensualTopado;
      const aniosExcedentes = Math.floor((semanas - L73.semanasMinimas) / 52);
      const incrementos = aniosExcedentes * incrementoPct * mensualTopado;
      const base = cuantiaBasica + incrementos;

      const asigConyuge = conConyuge ? base * L73.asignaciones.esposa : 0;
      const asigHijos = hijos * base * L73.asignaciones.hijo;
      const sinDependientes = !conConyuge && hijos === 0;
      const ayuda = sinDependientes ? base * L73.asignaciones.ayudaAsistencial : 0;
      const asignaciones = asigConyuge + asigHijos + ayuda;

      const totalCapped = Math.min(base + asignaciones, mensualTopado);
      const factorEdad = L73.factorEdad[edad] !== undefined ? L73.factorEdad[edad] : L73.factorEdad[60];
      const conEdad = totalCapped * factorEdad;
      const conDecreto = conEdad * L73.factorDecreto2001;
      const minimaAplica = conDecreto < pensionMinima;
      const pension = Math.max(conDecreto, pensionMinima);
      const escala = base + asignaciones > 0 ? (conEdad / (base + asignaciones)) * L73.factorDecreto2001 : 0;

      return {
        ok: true, pension, pensionMinima, minimaAplica, cuantiaBasica, incrementos,
        asignaciones, aniosExcedentes, mensualTopado, topado, factorEdad, conDecreto,
        escala, veces, cuantiaPct, incrementoPct,
      };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'ley73';
      const salario = Math.max(0, v.salarioPromedio || 0);
      const semanas = Math.max(0, Math.floor(v.semanas || 0));
      const edad = Math.floor(Number(v.edadRetiro) || 65);
      const conConyuge = String(v.conyuge || 'no') === 'si';
      const hijos = Math.max(0, Math.floor(v.hijos || 0));

      // ── Ley 73 ────────────────────────────────────────────────────────────
      if (id === 'ley73') {
        const p = ley73(salario, semanas, edad, conConyuge, hijos);
        if (!p.ok) {
          return {
            total: mxn(0),
            sub:
              'Con ' + semanas + ' semanas todavía no llegas al mínimo de ' + L73.semanasMinimas +
              ' de la Ley 73: te faltan ' + p.faltan + ' (unos ' + (p.faltan / 52).toFixed(1).replace('.', ',') +
              ' años de cotización).',
            rows: [
              { k: 'Semanas cotizadas', v: semanas, format: 'unit', unit: 'semanas' },
              { k: 'Semanas mínimas de la Ley 73', ref: 'LSS-73 Art. 138', v: L73.semanasMinimas, format: 'unit', unit: 'semanas' },
              { k: 'Semanas que te faltan', v: p.faltan, format: 'unit', unit: 'semanas', extra: true },
              { k: 'Años de cotización que representan', v: p.faltan / 52, format: 'unit', unit: 'años', decimals: 1 },
              { k: 'Pensión mínima garantizada Ley 73', ref: 'LSS-73 Art. 168', v: p.pensionMinima },
            ],
            chart: [
              { label: 'Semanas que ya tienes', value: semanas, tone: 'main' },
              { label: 'Semanas que te faltan', value: p.faltan, tone: 'bad' },
            ],
            format: 'ars',
          };
        }
        const reemplazo = (p.pension / Math.min(salario, p.mensualTopado)) * 100;
        return {
          total: mxn(p.pension),
          sub:
            'Cuantía básica del ' + pct(p.cuantiaPct) + ' + ' + p.aniosExcedentes +
            ' incrementos de ' + pct(p.incrementoPct, 3) + ' × factor de edad ' +
            pct(p.factorEdad, 0) + ' × 1,11 del decreto de 2001' +
            (p.minimaAplica ? ' → se eleva a la pensión mínima garantizada' : '') +
            '. Tasa de reemplazo ' + reemplazo.toFixed(0) + '%' + (p.topado ? ', salario topado a 25 UMA' : '') + '.',
          rows: [
            { k: 'Pensión mensual estimada', v: p.pension, extra: true },
            { k: 'Cuantía básica', ref: 'LSS-73 Art. 167', v: p.cuantiaBasica },
            { k: 'Incrementos por semanas extra', ref: p.aniosExcedentes + ' años arriba de 500', v: p.incrementos },
            { k: 'Asignaciones familiares', ref: 'LSS-73 Art. 164', v: p.asignaciones },
            { k: 'Pensión antes del piso mínimo', v: p.conDecreto },
            { k: 'Pensión mínima garantizada Ley 73', ref: 'LSS-73 Art. 168', v: p.pensionMinima },
            { k: 'Pensión anual (12 pagos + aguinaldo)', v: p.pension * 13 },
            { k: 'Salario promedio que se usó', v: p.mensualTopado },
            { k: 'Tasa de reemplazo', v: reemplazo, format: 'unit', unit: '%', decimals: 0 },
          ],
          chart: [
            { label: 'Cuantía básica', value: Math.max(0, p.cuantiaBasica * p.escala), tone: 'main' },
            { label: 'Incrementos por semanas', value: Math.max(0, p.incrementos * p.escala), tone: 'good' },
            { label: 'Asignaciones familiares', value: Math.max(0, p.asignaciones * p.escala), tone: 'prop' },
            { label: 'Ajuste a pensión mínima', value: Math.max(0, p.pension - p.conDecreto), tone: 'warn' },
          ],
        };
      }

      // ── Ley 97: cuenta individual + pensión garantizada ───────────────────
      if (id === 'ley97') {
        const saldo = Math.max(0, v.saldoAfore || 0);
        const edadHoy = Math.max(18, Math.floor(v.edadActual || 45));
        const edadJub = Math.max(edadHoy, edad);
        const anios = Math.max(0, edadJub - edadHoy);
        const rMensual = Math.max(0, v.rendimiento || 0) / 100 / 12;
        const meses = anios * 12;
        const factor = Math.pow(1 + rMensual, meses);
        const saldoFinal = rMensual === 0 ? saldo : saldo * factor;
        // Factor de anualidad simplificada: cada peso de saldo compra 0,4% de pensión mensual.
        const pensionSaldo = saldoFinal * 0.004;

        const semReq = PMG.semanasRequeridas2026;
        const faltan = Math.max(0, semReq - semanas);
        const cumpleSemanas = semanas >= semReq;
        const cumpleEdad = edadJub >= PMG.edadCesantia;

        // Pensión garantizada estimada: interpolación del SBC en UMA entre el piso y el techo
        // de la tabla del Art. 170 (1 UMA → mínimo, 12 UMA o más → máximo).
        const sbcEnUma = salario / UMA.mensual;
        const t = Math.min(1, Math.max(0, (sbcEnUma - 1) / (12 - 1)));
        const pmg = PMG.montoMin + t * (PMG.montoMax - PMG.montoMin);
        const califica = cumpleSemanas && cumpleEdad;
        const pensionFinal = califica ? Math.max(pensionSaldo, pmg) : pensionSaldo;
        const aplicaPmg = califica && pmg > pensionSaldo;

        return {
          total: mxn(pensionFinal),
          sub:
            (califica
              ? 'Cumples los requisitos de ' + semReq + ' semanas y ' + PMG.edadCesantia + ' años. '
              : 'Todavía no calificas a la pensión garantizada: ' +
                (faltan > 0 ? 'te faltan ' + faltan + ' semanas. ' : 'te falta la edad mínima. ')) +
            (aplicaPmg
              ? 'Tu saldo daría ' + mxn(pensionSaldo) + ', así que manda la pensión garantizada.'
              : 'Tu saldo proyectado de ' + mxn(saldoFinal) + ' a los ' + edadJub + ' años es lo que define la pensión.'),
          rows: [
            { k: 'Pensión mensual estimada', v: pensionFinal, extra: true },
            { k: 'Saldo proyectado a los ' + edadJub + ' años', v: saldoFinal },
            { k: 'Pensión que compra ese saldo', ref: 'renta vitalicia estimada', v: pensionSaldo },
            { k: 'Pensión garantizada estimada', ref: 'LSS Art. 170', v: pmg },
            { k: 'Semanas cotizadas', v: semanas, format: 'unit', unit: 'semanas' },
            { k: 'Semanas requeridas este año', ref: 'sube 25 por año', v: semReq, format: 'unit', unit: 'semanas' },
            { k: 'Semanas que te faltan', v: faltan, format: 'unit', unit: 'semanas' },
            { k: 'Salario base en UMA', v: sbcEnUma, format: 'unit', unit: 'UMA', decimals: 2 },
            { k: 'Años que le quedan al saldo para crecer', v: anios, format: 'unit', unit: 'años' },
          ],
          chart: [
            { label: 'Saldo actual', value: saldo, tone: 'main' },
            { label: 'Rendimiento proyectado', value: Math.max(0, saldoFinal - saldo), tone: 'good' },
          ],
        };
      }

      // ── Modalidad 40 ──────────────────────────────────────────────────────
      if (id === 'modalidad40') {
        const nUma = Math.min(25, Math.max(1, Math.floor(v.umaM40 || 1)));
        const aniosM40 = Math.max(1, Math.floor(v.aniosM40 || 1));
        const alza = Math.max(0, v.incrementoM40 || 0) / 100;

        const sbcDiario = nUma * UMA.diaria;
        const sbcMensual = nUma * UMA.mensual;

        const tasaFija =
          IMSS.patronRetiro +
          IMSS.patronInvalidezVida +
          IMSS.obreroInvalidezVida +
          IMSS.patronGastosMedicos +
          IMSS.obreroGastosMedicos +
          IMSS.obreroCesantiaVejez;
        const tasa = tasaFija + tasaCeav(sbcDiario);
        const cuotaInicial = sbcMensual * tasa;

        let aportacionTotal = 0;
        for (let a = 0; a < aniosM40; a++) {
          aportacionTotal += cuotaInicial * Math.pow(1 + alza, a) * 12;
        }
        const cuotaPromedio = aportacionTotal / (aniosM40 * 12);

        const semanasTotales = semanas + aniosM40 * 52;
        const edadPension = Math.max(60, Math.min(65, edad));

        // Con Modalidad 40 el escenario típico es sin dependientes: ayuda asistencial 15%.
        const conM40 = ley73(sbcMensual, semanasTotales, edadPension, conConyuge, hijos);
        const sinM40 = ley73(salario, semanas, edadPension, conConyuge, hijos);
        const pensionCon = conM40.ok ? conM40.pension : 0;
        const pensionSin = sinM40.ok ? sinM40.pension : 0;
        const mejora = pensionCon - pensionSin;
        const mesesRecuperar = mejora > 0 ? aportacionTotal / mejora : 0;

        return {
          total: mxn(pensionCon),
          sub:
            'Cuota de ' + mxn(cuotaInicial) + ' al mes (' + pct(tasa, 3) + ' de ' + mxn(sbcMensual) +
            '). Aportas ' + mxn(aportacionTotal) + ' en ' + aniosM40 + (aniosM40 === 1 ? ' año' : ' años') +
            (mejora > 0
              ? ' y recuperas la inversión en ~' + Math.round(mesesRecuperar) + ' meses de pensión.'
              : ' pero el cálculo no mejora tu pensión: revisa el salario elegido.'),
          rows: [
            { k: 'Pensión con Modalidad 40', v: pensionCon, extra: true },
            { k: 'Pensión sin Modalidad 40', v: pensionSin },
            { k: 'Aumento mensual de pensión', v: mejora },
            { k: 'Cuota mensual inicial', ref: pct(tasa, 3) + ' del salario elegido', v: cuotaInicial },
            { k: 'Cuota mensual promedio del período', v: cuotaPromedio },
            { k: 'Aportación total de ' + aniosM40 + (aniosM40 === 1 ? ' año' : ' años'), v: aportacionTotal },
            { k: 'Meses de pensión para recuperar lo aportado', v: mesesRecuperar, format: 'unit', unit: 'meses', decimals: 1 },
            { k: 'Semanas totales al cierre', v: semanasTotales, format: 'unit', unit: 'semanas' },
            { k: 'Salario base elegido', ref: nUma + ' UMA', v: sbcMensual },
          ],
          chart: [
            { label: 'Pensión que ya tenías', value: Math.max(0, pensionSin), tone: 'main' },
            { label: 'Aumento por Modalidad 40', value: Math.max(0, mejora), tone: 'good' },
          ],
        };
      }

      // ── ISSSTE, Décimo Transitorio ────────────────────────────────────────
      if (id === 'issste') {
        const aniosServicio = Math.max(0, Math.floor(v.aniosServicio || 0));
        const esMujer = String(v.sexo || 'hombre') === 'mujer';
        const aniosPara100 = esMujer ? ISSSTE.aniosPara100.mujer : ISSSTE.aniosPara100.hombre;
        const edadMinJub = esMujer ? ISSSTE.edadMinimaJubilacion.mujer : ISSSTE.edadMinimaJubilacion.hombre;

        const topeMensual = UMA.mensual * ISSSTE.topeUma;
        const sueldoTopado = Math.min(salario, topeMensual);
        const topado = salario > topeMensual;
        const smMensual = SM.generalDiario * SM.factorMensual;

        let regimen = 'Sin derecho aún';
        let porcentaje = 0;
        let motivo = '';

        if (aniosServicio >= aniosPara100) {
          regimen = 'Jubilación';
          porcentaje = 1;
          if (edad < edadMinJub) {
            porcentaje = 0;
            regimen = 'Jubilación (falta la edad mínima)';
            motivo =
              'Ya tienes los ' + aniosPara100 + ' años de servicio, pero en 2026 la edad mínima es de ' +
              edadMinJub + ' años: te faltan ' + (edadMinJub - edad) + '.';
          }
        } else if (aniosServicio >= 15 && edad >= 60) {
          regimen = 'Retiro por edad y tiempo de servicios';
          const cap = Math.min(29, aniosServicio);
          porcentaje = ISSSTE.tablaEdadServicio[cap] || 0;
        } else if (aniosServicio >= 10 && edad >= 65) {
          regimen = 'Cesantía en edad avanzada';
          porcentaje = edad >= 70 ? ISSSTE.cesantiaMax : (ISSSTE.tablaCesantia[edad] || 0.4);
        } else {
          motivo =
            'Con ' + aniosServicio + ' años de servicio y ' + edad +
            ' de edad no llegas todavía a ninguna de las tres modalidades del Décimo Transitorio.';
        }

        const calculada = sueldoTopado * porcentaje;
        const aplicaPiso = calculada > 0 && calculada < smMensual;
        const pension = porcentaje > 0 ? Math.max(calculada, smMensual) : 0;
        const reemplazo = sueldoTopado > 0 ? (pension / sueldoTopado) * 100 : 0;

        return {
          total: mxn(pension),
          sub:
            porcentaje > 0
              ? 'Régimen: ' + regimen + '. Te corresponde el ' + pct(porcentaje, 1) +
                ' del sueldo básico' + (topado ? ', topado a 10 UMA' : '') +
                (aplicaPiso ? ', elevado al piso de un salario mínimo mensual' : '') + '.'
              : motivo,
          rows: [
            { k: 'Pensión mensual estimada', v: pension, extra: true },
            { k: 'Sueldo básico de cálculo', ref: topado ? 'topado a 10 UMA' : 'último año de cotización', v: sueldoTopado },
            { k: 'Porcentaje del sueldo básico', ref: 'Décimo Transitorio', v: porcentaje * 100, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Años de servicio', v: aniosServicio, format: 'unit', unit: 'años' },
            { k: 'Años para el 100%', v: aniosPara100, format: 'unit', unit: 'años' },
            { k: 'Edad mínima de jubilación en 2026', ref: 'reforma DOF 24-jun-2025', v: edadMinJub, format: 'unit', unit: 'años' },
            { k: 'Tope del sueldo básico (10 UMA al mes)', ref: 'LISSSTE Art. 17', v: topeMensual },
            { k: 'Piso: un salario mínimo mensual', v: smMensual },
            { k: 'Tasa de reemplazo', v: reemplazo, format: 'unit', unit: '%', decimals: 0 },
          ],
          chart: [
            { label: 'Pensión mensual', value: Math.max(0, pension), tone: 'main' },
            { label: 'Parte del sueldo no cubierta', value: Math.max(0, sueldoTopado - pension), tone: 'exit' },
          ],
        };
      }

      // ── Invalidez ─────────────────────────────────────────────────────────
      if (id === 'invalidez') {
        const grado75 = String(v.gradoInvalidez || 'menor75') === 'mayor75';
        const topeMensual = UMA.diaria * IMSS.topeSbcUmas * SM.factorMensual;
        const topado = salario > topeMensual;
        const salarioMensual = Math.min(salario, topeMensual);

        const cuantiaBasica = salarioMensual * INV.porcentajeSalarioPromedio;
        let pctAsig = 0;
        if (conConyuge) pctAsig += INV.asignacionConyuge;
        if (hijos > 0) pctAsig += INV.asignacionHijo * hijos;
        if (!conConyuge && hijos === 0) pctAsig += INV.ayudaAsistencial;
        const asignaciones = cuantiaBasica * pctAsig;
        const total = cuantiaBasica + asignaciones;

        const semReq = grado75 ? INV.semanasRequeridasInvalidez75 : INV.semanasRequeridas;
        const cumple = semanas >= semReq;

        return {
          total: mxn(total),
          sub:
            (cumple
              ? 'Cumples: ' + semanas + ' semanas contra las ' + semReq + ' requeridas. '
              : 'Aún no cumples: tienes ' + semanas + ' semanas y necesitas ' + semReq +
                ' (te faltan ' + (semReq - semanas) + '). ') +
            'Cuantía básica del ' + pct(INV.porcentajeSalarioPromedio, 0) + ' del salario promedio' +
            (topado ? ', topado a 25 UMA' : '') + ' más ' + pct(pctAsig, 0) + ' de asignaciones.',
          rows: [
            { k: 'Pensión mensual estimada', v: total, extra: true },
            { k: 'Cuantía básica (35% del salario promedio)', ref: 'LSS Art. 141', v: cuantiaBasica },
            { k: 'Asignaciones familiares', ref: 'LSS Art. 138', v: asignaciones },
            { k: 'Salario promedio de cálculo', ref: 'últimas 500 semanas', v: salarioMensual },
            { k: 'Semanas cotizadas', v: semanas, format: 'unit', unit: 'semanas' },
            { k: 'Semanas requeridas', ref: grado75 ? 'invalidez ≥ 75%' : 'invalidez del 50% al 74%', v: semReq, format: 'unit', unit: 'semanas' },
            { k: 'Pensión anual (12 pagos + aguinaldo)', v: total * 13 },
            { k: 'Porcentaje de asignaciones aplicado', v: pctAsig * 100, format: 'unit', unit: '%', decimals: 0 },
          ],
          chart: [
            { label: 'Cuantía básica', value: Math.max(0, cuantiaBasica), tone: 'main' },
            { label: 'Asignaciones familiares', value: Math.max(0, asignaciones), tone: 'prop' },
          ],
        };
      }

      // ── Viudez y orfandad ─────────────────────────────────────────────────
      const base = Math.max(0, v.pensionAsegurado || 0);
      const semMat = Math.max(0, Math.floor(v.semanasMatrimonio || 0));
      const cumpleSem = semanas >= VIU.semanasMinimas;
      const cumpleMat = semMat >= VIU.semanasMatrimonioMinimas || hijos > 0;
      const cumple = cumpleSem && cumpleMat;

      let viudez = base * VIU.porcentajeViudez;
      let orfandad = base * VIU.porcentajeOrfandad * hijos;
      // La suma de viudez y orfandad no puede exceder el 100% de la pensión base.
      const sumaBruta = viudez + orfandad;
      const excede = sumaBruta > base && base > 0;
      if (excede) {
        const ajuste = base / sumaBruta;
        viudez = viudez * ajuste;
        orfandad = orfandad * ajuste;
      }
      const totalFamilia = viudez + orfandad;
      const aguinaldo = totalFamilia * VIU.mesesAguinaldo;

      return {
        total: mxn(viudez),
        sub:
          (cumple
            ? 'Cumples los requisitos: ' + semanas + ' semanas del asegurado y ' +
              (hijos > 0 ? 'hijos en común' : semMat + ' semanas de matrimonio') + '. '
            : 'Faltan requisitos: ' +
              (!cumpleSem ? 'se piden ' + VIU.semanasMinimas + ' semanas cotizadas del asegurado. ' : '') +
              (!cumpleMat ? 'se pide un año de matrimonio o hijos en común. ' : '')) +
          'La viudez es el ' + pct(VIU.porcentajeViudez, 0) + ' de la pensión del asegurado (' + mxn(base) + ')' +
          (hijos > 0 ? ', y cada hijo suma un ' + pct(VIU.porcentajeOrfandad, 0) + ' de orfandad' : '') +
          (excede ? '. La suma excedía el 100% de la pensión base y se ajustó proporcionalmente' : '') + '.',
        rows: [
          { k: 'Pensión de viudez', ref: 'LSS Art. 131', v: viudez, extra: true },
          { k: 'Pensión de orfandad (' + hijos + ')', ref: 'LSS Art. 137', v: orfandad },
          { k: 'Total que cobra la familia', v: totalFamilia },
          { k: 'Pensión base del asegurado', v: base },
          { k: 'Aguinaldo anual', ref: 'LSS Art. 164 — una mensualidad', v: aguinaldo },
          { k: 'Ingreso anual de la familia', v: totalFamilia * 12 + aguinaldo },
          { k: 'Semanas cotizadas del asegurado', v: semanas, format: 'unit', unit: 'semanas' },
          { k: 'Semanas mínimas exigidas', v: VIU.semanasMinimas, format: 'unit', unit: 'semanas' },
          { k: 'Semanas de matrimonio', v: semMat, format: 'unit', unit: 'semanas' },
        ],
        chart: [
          { label: 'Viudez', value: Math.max(0, viudez), tone: 'main' },
          { label: 'Orfandad', value: Math.max(0, orfandad), tone: 'prop' },
          { label: 'Parte de la pensión que no se paga', value: Math.max(0, base - totalFamilia), tone: 'exit' },
        ],
      };
    });
  })();
</script>
