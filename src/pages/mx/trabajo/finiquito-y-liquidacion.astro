---
/**
 * Hub de decisión MX — "Me despiden o renuncio: ¿cuánto me tienen que pagar?".
 * audience="MX" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  ISR_MENSUAL,
  LFT,
  EXENCIONES,
  UMA_DIARIA,
  SM_GENERAL_DIARIO,
  FACTOR_MENSUAL,
} from '../../../lib/hubs/mx/finiquito-y-liquidacion';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ TARIFA: ISR_MENSUAL, LFT, EXENCIONES, UMA_DIARIA, SM_DIARIO: SM_GENERAL_DIARIO, FACTOR_MENSUAL }}
>
  (function () {
    const H = window.HC_HUB;
    const mxn = (n) => '$' + Math.round(n || 0).toLocaleString('es-MX');

    function isrMensual(base) {
      if (!(base > 0)) return 0;
      for (const t of TARIFA) {
        const hasta = t.hasta === null ? Infinity : t.hasta;
        if (base >= t.desde && base <= hasta) return t.cuota + (base - t.desde) * t.tasa;
      }
      const last = TARIFA[TARIFA.length - 1];
      return last.cuota + (base - last.desde) * last.tasa;
    }

    /** Días de vacaciones de ley por antigüedad cumplida (LFT Art. 76, reforma 2023). */
    function diasVacacionesLey(anios) {
      const a = Math.floor(anios);
      if (a < 1) return 0;
      if (a <= LFT.vacacionesPorAnio.length) return LFT.vacacionesPorAnio[a - 1];
      return 20 + LFT.incrementoQuinquenal * Math.ceil((a - 5) / 5);
    }

    /** Salario diario integrado: sueldo + aguinaldo y prima vacacional prorrateados (LFT Art. 84 y 89). */
    function salarioIntegrado(sd, anios) {
      const diasVac = Math.max(diasVacacionesLey(Math.max(1, anios)), LFT.vacacionesPorAnio[0]);
      const factor = (365 + LFT.aguinaldoDias + diasVac * (LFT.primaVacacionalPct / 100)) / 365;
      return { sdi: sd * factor, factor: factor };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'despido-injustificado';
      const sd = Math.max(0, v.salarioDiario || 0);
      const anios = Math.max(0, Math.min(50, v.antiguedad || 0));
      const diasPend = Math.max(0, Math.min(31, v.diasPendientes || 0));
      const diasAnio = Math.max(0, Math.min(365, v.diasAnio || 0));
      const primaPct = Math.max(25, v.primaVacacionalPct || 25);
      const diasVacInput = Math.max(0, v.diasVacaciones || 0);
      const diasVac = diasVacInput > 0 ? diasVacInput : diasVacacionesLey(anios);

      // ── Finiquito: partes proporcionales, siempre debidas ──
      const sueldoPendiente = sd * diasPend;
      const vacaciones = sd * diasVac;
      const primaVacacional = vacaciones * (primaPct / 100);
      const aguinaldo = (sd * LFT.aguinaldoDias * diasAnio) / 365;
      const finiquito = sueldoPendiente + vacaciones + primaVacacional + aguinaldo;

      // ── Indemnización: sólo en despido injustificado, sobre salario INTEGRADO ──
      const integ = salarioIntegrado(sd, anios);
      const esInjustificado = id === 'despido-injustificado';
      const tresMeses = esInjustificado ? integ.sdi * LFT.mesesConstitucionales * 30 : 0;
      const veinteDias = esInjustificado ? integ.sdi * LFT.diasPorAnio20 * anios : 0;

      // ── Prima de antigüedad: PROPORCIONAL (Art. 162) con tope de 2 SM (Art. 486) ──
      const topePrima = SM_DIARIO * LFT.primaAntiguedadTopeSm;
      const salarioPrima = Math.min(sd, topePrima);
      const aplicaPrima = id === 'renuncia' ? anios >= 15 : anios > 0;
      const primaAntiguedad = aplicaPrima ? salarioPrima * LFT.primaAntiguedadDias * anios : 0;

      const separacion = tresMeses + veinteDias + primaAntiguedad;
      const bruto = finiquito + separacion;

      // ── ISR ──
      // 1) Separación: exención de 90 UMA por año de servicio (LISR 93-XIII), año iniciado cuenta completo.
      const aniosExencion = separacion > 0 ? Math.max(1, Math.ceil(anios)) : 0;
      const exencionSeparacion = UMA_DIARIA * EXENCIONES.separacionPorAnioUmas * aniosExencion;
      const gravableSeparacion = Math.max(0, separacion - exencionSeparacion);
      // Tasa efectiva del último sueldo ordinario mensual (Art. 95 LISR / 174 RLISR).
      const sueldoMensual = sd * 30;
      const tasaEfectiva = sueldoMensual > 0 ? isrMensual(sueldoMensual) / sueldoMensual : 0;
      const isrSeparacion = gravableSeparacion * tasaEfectiva;

      // 2) Finiquito ordinario: aguinaldo exento hasta 30 UMA, prima vacacional hasta 15 UMA,
      //    vacaciones y sueldo pendiente gravan completo (LISR Art. 93 fracc. XIV).
      const exAguinaldo = Math.min(aguinaldo, UMA_DIARIA * EXENCIONES.aguinaldoUmas);
      const exPrimaVac = Math.min(primaVacacional, UMA_DIARIA * EXENCIONES.primaVacacionalUmas);
      const gravableFiniquito = Math.max(0, finiquito - exAguinaldo - exPrimaVac);
      const isrFiniquito = isrMensual(gravableFiniquito);

      const isrTotal = isrSeparacion + isrFiniquito;
      const neto = bruto - isrTotal;
      const exentoTotal = exencionSeparacion > 0
        ? Math.min(separacion, exencionSeparacion) + exAguinaldo + exPrimaVac
        : exAguinaldo + exPrimaVac;

      const rows = [
        { k: 'Sueldo pendiente', ref: diasPend + ' días × ' + mxn(sd), v: sueldoPendiente },
        {
          k: 'Vacaciones no disfrutadas',
          ref: diasVac + ' días · Art. 76 LFT' + (diasVacInput > 0 ? ' (los que cargaste)' : ' (los de ley)'),
          v: vacaciones,
        },
        { k: 'Prima vacacional', ref: primaPct + '% · Art. 80 LFT', v: primaVacacional },
        { k: 'Aguinaldo proporcional', ref: LFT.aguinaldoDias + ' días × ' + diasAnio + '/365 · Art. 87 LFT', v: aguinaldo },
        { k: 'Subtotal del finiquito', ref: 'Siempre te toca', v: finiquito, extra: true },
      ];

      if (esInjustificado) {
        rows.push({
          k: 'Indemnización de tres meses',
          ref: '90 días × salario integrado ' + mxn(integ.sdi) + ' · Art. 48 LFT',
          v: tresMeses,
        });
        rows.push({
          k: 'Veinte días por año de servicio',
          ref: LFT.diasPorAnio20 + ' × ' + anios.toFixed(1).replace('.', ',') + ' años · Art. 50 LFT',
          v: veinteDias,
        });
      }

      if (aplicaPrima) {
        rows.push({
          k: 'Prima de antigüedad',
          ref:
            LFT.primaAntiguedadDias + ' días/año × ' + anios.toFixed(1).replace('.', ',') + ' años × ' + mxn(salarioPrima) +
            (sd > topePrima ? ' (topado a 2 SM · Art. 486)' : ' · Art. 162 LFT'),
          v: primaAntiguedad,
        });
      } else if (id === 'renuncia') {
        rows.push({
          k: 'Prima de antigüedad que NO te corresponde',
          ref: 'Renuncia con menos de 15 años · Art. 162 LFT',
          v: 0,
        });
      }

      rows.push({ k: 'Total bruto a pagar', ref: 'Finiquito + indemnizaciones', v: bruto, extra: true });

      if (separacion > 0) {
        rows.push({
          k: 'Exención de la indemnización',
          ref: EXENCIONES.separacionPorAnioUmas + ' UMA × ' + aniosExencion + ' año/s · Art. 93-XIII LISR',
          v: Math.min(separacion, exencionSeparacion),
        });
        rows.push({
          k: 'Base gravable de la indemnización',
          ref: 'Lo que rebasa la exención',
          v: gravableSeparacion,
        });
        rows.push({
          k: 'ISR de la indemnización',
          ref: 'Tasa efectiva del sueldo · Art. 174 RLISR',
          v: isrSeparacion,
        });
      }

      rows.push({
        k: 'Exención del aguinaldo y la prima vacacional',
        ref: EXENCIONES.aguinaldoUmas + ' UMA + ' + EXENCIONES.primaVacacionalUmas + ' UMA · Art. 93-XIV LISR',
        v: exAguinaldo + exPrimaVac,
      });
      rows.push({ k: 'ISR del finiquito ordinario', ref: 'Tarifa del Art. 96 LISR', v: isrFiniquito });
      rows.push({ k: 'ISR total retenido', ref: 'Separación + finiquito', v: isrTotal });
      rows.push({ k: 'Total neto que te deben depositar', ref: 'Bruto menos ISR', v: neto, extra: true });
      rows.push({
        k: 'Tasa efectiva sobre el total bruto',
        ref: 'ISR ÷ bruto',
        v: bruto > 0 ? (isrTotal / bruto) * 100 : 0,
        format: 'unit',
        unit: '%',
        decimals: 2,
      });
      rows.push({
        k: 'Cuántos meses de sueldo representa',
        ref: 'Neto ÷ sueldo mensual (' + mxn(sueldoMensual) + ')',
        v: sueldoMensual > 0 ? neto / sueldoMensual : 0,
        format: 'unit',
        unit: 'meses de sueldo',
        decimals: 1,
      });

      const sub =
        (esInjustificado
          ? 'Despido injustificado: al finiquito de ' + mxn(finiquito) + ' se suman ' + mxn(separacion) + ' de indemnización y prima'
          : separacion > 0
            ? 'Finiquito de ' + mxn(finiquito) + ' más ' + mxn(primaAntiguedad) + ' de prima de antigüedad'
            : 'Solo finiquito: no corresponde indemnización ni prima de antigüedad') +
        ' · ISR retenido ' + mxn(isrTotal) +
        ' · queda exento ' + mxn(exentoTotal);

      const chart = [
        { label: 'Finiquito (partes proporcionales)', value: Math.round(finiquito), tone: 'main' },
        { label: 'Indemnización por despido', value: Math.round(tresMeses + veinteDias), tone: 'good' },
        { label: 'Prima de antigüedad', value: Math.round(primaAntiguedad), tone: 'prop' },
        { label: 'ISR retenido', value: Math.round(isrTotal), tone: 'warn' },
      ].filter((s) => s.value > 0);

      return { total: mxn(neto), sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
