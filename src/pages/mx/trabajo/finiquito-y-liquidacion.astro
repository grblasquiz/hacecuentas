---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import FiniquitoLiquidacionMexicoExperience from '../../../components/generated/FiniquitoLiquidacionMexicoExperience.astro';
import { hub } from '../../../lib/hubs/mx/finiquito-y-liquidacion';
const canonical='https://hacecuentas.com/mx/trabajo/finiquito-y-liquidacion';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
import HubCitableStats from '../../../components/hub/HubCitableStats.astro';
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <FiniquitoLiquidacionMexicoExperience />
  <HubCitableStats data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>
