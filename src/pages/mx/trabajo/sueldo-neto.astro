---
/**
 * Hub de decisión MX — "¿Cuánto me queda del sueldo en mano?".
 * audience="MX" va literal al Layout: HubData sólo modela 'AR' | 'global' y el
 * mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SueldoNetoMexicoExperience from '../../../components/generated/SueldoNetoMexicoExperience.astro';
import ThirdWaveBoost from '../../../components/ThirdWaveBoost.astro';
import { hub, ISR_MENSUAL, IMSS_OBRERO, SUBSIDIO, UMA, SALARIO_MINIMO } from '../../../lib/hubs/mx/sueldo-neto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name: hub.h1, url: CANONICAL, operatingSystem: 'Web', applicationCategory: 'FinanceApplication', inLanguage: 'es-MX', isAccessibleForFree: true },
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoNetoMexicoExperience data={hub} />
  <p class="hc-data-source">Dato de partida: <a href="/mx/datos-salario-minimo-mexico-2026">salario mínimo de México 2026 por zona, mes y jornada</a>.</p>
  <ThirdWaveBoost variant="mxNet" />
  <Footer />
</Layout>

<style>.hc-data-source{max-width:1120px;margin:0 auto 2rem;padding:0 1.25rem;color:#475569}.hc-data-source a{font-weight:700}</style>
