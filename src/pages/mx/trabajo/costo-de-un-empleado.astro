---
/**
 * Hub de decisión MX — "¿Cuánto me cuesta realmente tener a alguien en nómina?"
 *
 * El audience="MX" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CostoEmpleadoMexicoExperience from '../../../components/generated/CostoEmpleadoMexicoExperience.astro';
import {
  hub,
  UMA_MX,
  FACTOR_MENSUAL_MX,
  SM_HOGAR_MX,
  IMSS_PATRON_MX,
  IMSS_OBRERO_MX,
  CEAV_MX,
  ISN_MX,
  LFT_MX,
  PRIMA_RT_MX,
} from '../../../lib/hubs/mx/costo-de-un-empleado';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CostoEmpleadoMexicoExperience data={hub} />
  <section class="sdi-explainer" aria-labelledby="factor-integracion-2026">
    <div class="sdi-explainer__inner">
      <p class="sdi-explainer__eyebrow">Nómina México 2026</p>
      <h2 id="factor-integracion-2026">Factor de integración 2026: cómo pasar del salario diario al SDI</h2>
      <p>
        El <strong>factor de integración</strong> incorpora al salario diario las prestaciones que integran el
        salario base de cotización: aguinaldo, vacaciones y prima vacacional. Con las prestaciones mínimas de
        ley para el primer año —15 días de aguinaldo, 12 días de vacaciones y prima vacacional de 25%— el
        factor es <strong>1,0493</strong> en 2026.
      </p>
      <div class="sdi-explainer__formula" role="note">
        <strong>Fórmula:</strong> (365 + días de aguinaldo + días de vacaciones × prima vacacional) ÷ 365.
        Multiplica el salario diario por ese factor para obtener el salario diario integrado (SDI).
      </div>
      <p>
        Si otorgas prestaciones superiores a las mínimas, el factor y el SDI aumentan. Ese SDI alimenta el
        cálculo de cuotas del IMSS e INFONAVIT que ya se incluyen en el costo patronal de esta página.
      </p>
      <div class="sdi-explainer__tools" aria-label="Calculadoras específicas de nómina">
        <a href="/mx/calculadora-factor-integracion-salarial-imss-mexico">
          Calcular el factor de integración IMSS según antigüedad
        </a>
        <a href="/mx/calculadora-isn-impuesto-sobre-nominas-estado">
          Calcular el ISN 2026 con la tasa de cada estado
        </a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .sdi-explainer { background: #f7fafc; padding: 64px 24px; color: #19304a; }
  .sdi-explainer__inner { max-width: 900px; margin: 0 auto; }
  .sdi-explainer__eyebrow { color: #177663; font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .sdi-explainer h2 { margin: 10px 0 18px; font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.12; }
  .sdi-explainer p { font-size: 1.05rem; line-height: 1.7; }
  .sdi-explainer__formula { margin: 24px 0; padding: 18px 20px; border-left: 4px solid #268b78; border-radius: 8px; background: #fff; line-height: 1.6; }
  .sdi-explainer__tools { display: grid; gap: 12px; margin-top: 28px; }
  .sdi-explainer__tools a { display: block; padding: 16px 18px; border: 1px solid #c7e2dc; border-radius: 10px; background: #fff; color: #126755; font-weight: 750; text-decoration: none; }
  .sdi-explainer__tools a:hover { border-color: #268b78; text-decoration: underline; }
</style>
