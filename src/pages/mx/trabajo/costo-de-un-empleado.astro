---
/**
 * Hub de decisión MX — "¿Cuánto me cuesta realmente tener a alguien en nómina?"
 *
 * El audience="MX" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  UMA_MX,
  FACTOR_MENSUAL_MX,
  SM_HOGAR_MX,
  IMSS_PATRON_MX,
  IMSS_OBRERO_MX,
  CEAV_MX,
  ISN_MX,
  LFT_MX,
  PRIMA_RT_MX,
} from '../../../lib/hubs/mx/costo-de-un-empleado';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    UMA: UMA_MX,
    FACTOR_MENSUAL: FACTOR_MENSUAL_MX,
    SM_HOGAR: SM_HOGAR_MX,
    PATRON: IMSS_PATRON_MX,
    OBRERO: IMSS_OBRERO_MX,
    CEAV: CEAV_MX,
    ISN: ISN_MX,
    LFT: LFT_MX,
    PRT: PRIMA_RT_MX,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const mxn = (n) => '$' + Math.round(n || 0).toLocaleString('es-MX');

    /** Días de vacaciones por antigüedad — LFT Art. 76 (vacaciones dignas). */
    function diasVacaciones(anios) {
      const a = Math.max(1, Math.floor(anios || 1));
      if (a <= LFT.vacacionesPorAnio.length) return LFT.vacacionesPorAnio[a - 1];
      return 20 + LFT.vacacionesIncrementoQuinquenal * Math.ceil((a - 5) / 5);
    }

    /** Tabla progresiva de CEAV patronal 2026 por nivel de SBC diario en UMA. */
    function tasaCeav(sbcDiario) {
      const umas = (sbcDiario || 0) / UMA.diaria;
      for (const t of CEAV) {
        const hasta = t.hastaUmas === null ? Infinity : t.hastaUmas;
        if (umas <= hasta) return t.tasa;
      }
      return CEAV[CEAV.length - 1].tasa;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'nomina';
      const sueldo = Math.max(0, v.sueldo || 0);
      const estado = ISN[v.estado] !== undefined ? v.estado : 'CDMX';
      const tasaIsn = ISN[estado];
      const anios = Math.max(1, Math.floor(v.antiguedad || 1));
      const aguinaldoDias = Math.max(LFT.aguinaldoDiasMinimo, v.aguinaldoDias || LFT.aguinaldoDiasMinimo);
      const topeSbcDiario = UMA.diaria * PATRON.topeSbcUmas;
      const tresUmaDiaria = UMA.diaria * 3;

      // ── Rama 3: prima de riesgo de trabajo (LSS Art. 72) ────────────────
      if (id === 'prima-rt') {
        const n = Math.max(1, Math.floor(v.trabajadores || 1));
        const s = Math.max(0, v.diasSubsidiados || 0);
        const iDec = Math.max(0, v.incapacidades || 0) / 100;
        const d = Math.max(0, Math.floor(v.defunciones || 0));
        const siniestralidad = (s / 365 + PRT.V * (iDec + d)) * (PRT.F / n);
        const primaCalculada = siniestralidad + PRT.M;

        const actual = (v.primaRiesgo || 0) / 100;
        let primaFinal = primaCalculada;
        if (actual > 0) {
          primaFinal = Math.min(
            Math.max(primaFinal, actual - PRT.variacionMaximaAnual),
            actual + PRT.variacionMaximaAnual,
          );
        }
        primaFinal = Math.min(Math.max(primaFinal, PRT.M), PRT.primaMaxima);

        // Nómina de cotización: SBC del sueldo promedio × trabajadores.
        const vac = diasVacaciones(anios);
        const factor = (365 + aguinaldoDias + vac * LFT.primaVacacional) / 365;
        const sbcDiario = Math.min((sueldo / FACTOR_MENSUAL) * factor, topeSbcDiario);
        const nominaAnual = sbcDiario * 365 * n;
        const costoAnual = nominaAnual * primaFinal;
        const costoActual = actual > 0 ? nominaAnual * actual : 0;

        return {
          total: (primaFinal * 100).toFixed(4).replace('.', ',') + '%',
          sub:
            'Prima de la fórmula del Art. 72: ' +
            (primaCalculada * 100).toFixed(4).replace('.', ',') +
            '%' +
            (actual > 0 && Math.abs(primaFinal - primaCalculada) > 0.000005
              ? ' — acotada a ±1 punto porcentual respecto de tu prima vigente (Art. 74)'
              : '') +
            '. Rige de marzo a febrero.',
          rows: [
            { k: 'Prima que resulta de la fórmula', ref: 'LSS Art. 72', v: primaCalculada * 100, format: 'unit', unit: '%', decimals: 4 },
            { k: 'Prima aplicable ya acotada', ref: 'LSS Art. 74', v: primaFinal * 100, format: 'unit', unit: '%', decimals: 4, extra: true },
            { k: 'Índice de siniestralidad', v: siniestralidad * 100, format: 'unit', unit: '%', decimals: 4 },
            { k: 'Trabajadores promedio expuestos', v: n, format: 'plain' },
            { k: 'Cuota anual de riesgo de trabajo', v: costoAnual },
            { k: 'Cuota mensual de riesgo de trabajo', v: costoAnual / 12 },
            { k: 'Diferencia contra tu prima vigente (anual)', v: costoAnual - costoActual },
          ],
          chart: [
            { label: 'Prima mínima de ley', value: PRT.M * 100, tone: 'good' },
            { label: 'Siniestralidad de tu empresa', value: siniestralidad * 100, tone: 'bad' },
          ],
          format: 'ars',
        };
      }

      // ── Rama 2: persona trabajadora del hogar (programa PTHH) ───────────
      if (id === 'hogar') {
        const zona = v.zonaHogar === 'frontera' ? 'frontera' : 'general';
        const smDia = zona === 'frontera' ? SM_HOGAR.zlfnDiario : SM_HOGAR.generalDiario;
        const esquema = String(v.esquemaHogar || 'mes');
        let diasMes;
        if (esquema === 'mes') {
          diasMes = FACTOR_MENSUAL;
        } else {
          const dw = Math.min(6, Math.max(1, Math.floor(Number(esquema) || 5)));
          diasMes = dw * (FACTOR_MENSUAL / 7);
        }

        const salarioDiario = sueldo / diasMes;
        const cotizable = Math.max(salarioDiario, smDia);
        // Factor de integración del primer año: 15 días de aguinaldo + 25% de 12 de vacaciones.
        const factor = (365 + LFT.aguinaldoDiasMinimo + LFT.vacacionesPorAnio[0] * LFT.primaVacacional) / 365;
        const sdi = Math.min(cotizable * factor, topeSbcDiario);
        const sbcMensual = sdi * diasMes;
        const excedenteDiario = Math.max(0, sdi - tresUmaDiaria);

        const fijaEym = PATRON.eymCuotaFijaUma * UMA.diaria * diasMes;
        const excEym = PATRON.eymExcedente * excedenteDiario * diasMes;
        const prestDinero = PATRON.eymPrestacionesDinero * sbcMensual;
        const gmp = PATRON.gastosMedicosPensionados * sbcMensual;
        const invVida = PATRON.invalidezVida * sbcMensual;
        const guarderias = PATRON.guarderias * sbcMensual;
        const retiro = PATRON.retiro * sbcMensual;
        const ceav = tasaCeav(sdi) * sbcMensual;
        const rt = PATRON.riesgoTrabajoClaseI * sbcMensual;
        const cuotaPatron = fijaEym + excEym + prestDinero + gmp + invVida + guarderias + retiro + ceav + rt;
        const infonavit = PATRON.infonavit * sbcMensual;
        const obrera = OBRERO.totalSinExcedente * sbcMensual + OBRERO.eymExcedente * excedenteDiario * diasMes;
        const lineaCaptura = cuotaPatron + infonavit + obrera;

        return {
          total: mxn(sueldo + lineaCaptura),
          sub:
            'Salario ' + mxn(sueldo) + ' + línea de captura ' + mxn(lineaCaptura) +
            ' (IMSS, INFONAVIT y cuota obrera absorbida). SBC diario ' + mxn(sdi) +
            (salarioDiario < smDia
              ? ' — ojo: tu salario por día trabajado queda debajo del mínimo profesional de ' + mxn(smDia)
              : ''),
          rows: [
            { k: 'Salario que le pagas', v: sueldo, extra: true },
            { k: 'Cuota patronal del IMSS', ref: 'LSS Arts. 106, 147, 168, 211', v: cuotaPatron },
            { k: 'INFONAVIT 5% del SBC', ref: 'obligatorio desde 2026', v: infonavit },
            { k: 'Cuota obrera (la absorbe el patrón)', ref: 'LSS Arts. 25, 107, 147, 168', v: obrera },
            { k: 'Línea de captura mensual', v: lineaCaptura },
            { k: 'Días cotizados al mes', v: diasMes, format: 'unit', unit: 'días', decimals: 1 },
            { k: 'Salario base de cotización mensual', v: sbcMensual },
            { k: 'Mínimo profesional del oficio (por día)', ref: 'CONASAMI 2026', v: smDia },
          ],
          chart: [
            { label: 'Salario', value: sueldo, tone: 'main' },
            { label: 'Cuota patronal IMSS', value: cuotaPatron, tone: 'exit' },
            { label: 'INFONAVIT 5%', value: infonavit, tone: 'prop' },
            { label: 'Cuota obrera absorbida', value: obrera, tone: 'warn' },
          ],
        };
      }

      // ── Rama 1: trabajador en nómina ───────────────────────────────────
      const salarioDiario = sueldo / FACTOR_MENSUAL;
      const vac = diasVacaciones(anios);
      const factor = (365 + aguinaldoDias + vac * LFT.primaVacacional) / 365;
      const sbcDiario = Math.min(salarioDiario * factor, topeSbcDiario);
      const sbcMensual = sbcDiario * FACTOR_MENSUAL;
      const tresUmaMensual = UMA.mensual * 3;

      const primaPct = Math.min(
        PRT.primaMaxima,
        Math.max(PRT.M, (v.primaRiesgo || PATRON.riesgoTrabajoClaseI * 100) / 100),
      );

      const cuotaFijaEyM = PATRON.eymCuotaFijaUma * UMA.mensual;
      const excedente = Math.max(0, sbcMensual - tresUmaMensual) * PATRON.eymExcedente;
      const prestacionesDinero = sbcMensual * PATRON.eymPrestacionesDinero;
      const gmp = sbcMensual * PATRON.gastosMedicosPensionados;
      const invalidezVida = sbcMensual * PATRON.invalidezVida;
      const guarderias = sbcMensual * PATRON.guarderias;
      const ceav = sbcMensual * tasaCeav(sbcDiario);
      const riesgoTrabajo = sbcMensual * primaPct;
      const retiro = sbcMensual * PATRON.retiro;
      const imssPatronal =
        cuotaFijaEyM + excedente + prestacionesDinero + gmp + invalidezVida + guarderias + ceav + riesgoTrabajo + retiro;

      const infonavit = sbcMensual * PATRON.infonavit;
      const provAguinaldo = (aguinaldoDias * salarioDiario) / 12;
      const provPrima = (vac * salarioDiario * LFT.primaVacacional) / 12;
      const provisiones = provAguinaldo + provPrima;
      const isn = (sueldo + provisiones) * tasaIsn;

      const costoMensual = sueldo + imssPatronal + infonavit + isn + provisiones;
      const carga = sueldo > 0 ? ((costoMensual - sueldo) / sueldo) * 100 : 0;

      return {
        total: mxn(costoMensual),
        sub:
          'Carga adicional del ' + carga.toFixed(1).replace('.', ',') + '% sobre el sueldo bruto. ' +
          mxn(costoMensual * 12) + ' al año. SBC ' + mxn(sbcMensual) +
          ' (factor de integración ' + factor.toFixed(4).replace('.', ',') + ', ' + vac + ' días de vacaciones).',
        rows: [
          { k: 'Sueldo bruto', v: sueldo, extra: true },
          { k: 'IMSS patronal (incluye CEAV, riesgo de trabajo y retiro 2%)', ref: 'LSS Arts. 106, 147, 168, 211', v: imssPatronal },
          { k: 'INFONAVIT 5% del SBC', ref: 'Ley INFONAVIT Art. 29', v: infonavit },
          { k: 'Impuesto sobre nóminas — ' + estado, ref: (tasaIsn * 100).toFixed(2).replace('.', ',') + '%', v: isn },
          { k: 'Provisión de aguinaldo y prima vacacional', ref: 'LFT Arts. 80 y 87', v: provisiones },
          { k: 'Costo total mensual', v: costoMensual },
          { k: 'Costo total anual', v: costoMensual * 12 },
          { k: 'Salario diario integrado (SDI)', ref: 'LSS Art. 27', v: sbcDiario, decimals: 2 },
          { k: 'Carga sobre el sueldo', v: carga, format: 'unit', unit: '%', decimals: 1 },
        ],
        chart: [
          { label: 'Sueldo bruto', value: sueldo, tone: 'main' },
          { label: 'IMSS patronal', value: imssPatronal, tone: 'exit' },
          { label: 'INFONAVIT 5%', value: infonavit, tone: 'prop' },
          { label: 'ISN ' + estado, value: isn, tone: 'warn' },
          { label: 'Aguinaldo y prima vacacional', value: provisiones, tone: 'good' },
        ],
      };
    });
  })();
</script>
