---
/**
 * Hub de decisión MX — "¿Cuánto me cuesta realmente tener a alguien en nómina?"
 *
 * El audience="MX" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CostoEmpleadoMexicoExperience from '../../../components/generated/CostoEmpleadoMexicoExperience.astro';
import {
  hub,
  UMA_MX,
  FACTOR_MENSUAL_MX,
  SM_HOGAR_MX,
  IMSS_PATRON_MX,
  IMSS_OBRERO_MX,
  CEAV_MX,
  ISN_MX,
  LFT_MX,
  PRIMA_RT_MX,
} from '../../../lib/hubs/mx/costo-de-un-empleado';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CostoEmpleadoMexicoExperience data={hub} />
  <Footer />
</Layout>

