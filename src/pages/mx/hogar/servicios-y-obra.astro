---
/**
 * Hub de decisión MX — luz CFE, paneles solares, gas LP y costo de obra.
 * audience="MX" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, CFE_MX, GAS_LP_MX, OBRA_MX } from '../../../lib/hubs/mx/servicios-y-obra';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="MX"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ C: CFE_MX, G: GAS_LP_MX, O: OBRA_MX }}>
  (function () {
    const H = window.HC_HUB;
    const mxn = (n) => '$' + Math.round(n || 0).toLocaleString('es-MX');
    const num = (v, d) => {
      if (v === '' || v === null || v === undefined) return d;
      const n = Number(String(v).replace(/[^0-9.,-]/g, '').replace(/\.(?=\d{3}\b)/g, '').replace(',', '.'));
      return Number.isFinite(n) ? n : d;
    };
    const r2 = (n) => Math.round(n * 100) / 100;

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'luz';

      // ── Rama 2: paneles solares ─────────────────────────────────────────
      if (id === 'solar') {
        const consumoMes = Math.max(0, num(v.consumoKwhMes, 0));
        const recibo = Math.max(0, num(v.reciboMensual, 0));
        const potencia = Math.max(0, num(v.potenciaKw, 0));
        const costo = Math.max(0, num(v.costoInstalacion, 0));
        const rendimiento = Math.max(0, num(v.generacionAnualPorKw, 0));
        const cargoFijo = Math.max(0, num(v.cargoFijoMensual, 120));

        const generacion = potencia * rendimiento;
        const consumoAnual = consumoMes * 12;
        const compensable = Math.min(generacion, consumoAnual);
        const costoVariableAnual = Math.max(0, (recibo - cargoFijo) * 12);
        const ahorro = consumoAnual > 0 ? costoVariableAnual * Math.min(1, compensable / consumoAnual) : 0;
        const payback = ahorro > 0 ? costo / ahorro : 0;
        const cobertura = consumoAnual > 0 ? (generacion / consumoAnual) * 100 : 0;
        const pagoRestante = Math.max(0, recibo * 12 - ahorro);

        return {
          total: mxn(ahorro),
          sub:
            'El sistema generaría ' + Math.round(generacion).toLocaleString('es-MX') + ' kWh al año y cubriría cerca del ' +
            Math.round(cobertura) + '% de tu consumo. Ahorrarías ' + mxn(ahorro) + ' al año y la inversión se recuperaría en ' +
            (payback ? payback.toFixed(1).replace('.', ',') + ' años' : 'un plazo no calculable con estos datos') +
            '. El cargo fijo de ' + mxn(cargoFijo) + ' al mes se sigue pagando.',
          rows: [
            { k: 'Ahorro anual estimado', v: ahorro, extra: true },
            { k: 'Generación anual del sistema', v: Math.round(generacion), format: 'unit', unit: 'kWh' },
            { k: 'Consumo anual de tu casa', v: Math.round(consumoAnual), format: 'unit', unit: 'kWh' },
            { k: 'Cobertura del consumo', v: Math.round(cobertura), format: 'unit', unit: '%' },
            { k: 'Recuperación de la inversión', v: r2(payback), format: 'unit', unit: 'años', decimals: 1 },
            { k: 'Costo instalado', v: costo },
            { k: 'Lo que seguirías pagando a CFE al año', v: pagoRestante },
            { k: 'Cargo fijo anual que no desaparece', v: cargoFijo * 12 },
          ],
          chart: [
            { label: 'Ahorro anual', value: Math.round(ahorro), tone: 'good' },
            { label: 'Pago CFE restante', value: Math.round(pagoRestante), tone: 'warn' },
          ],
        };
      }

      // ── Rama 3: gas LP ──────────────────────────────────────────────────
      if (id === 'gas') {
        const esCilindro = String(v.tipoRecipiente || 'estacionario') === 'cilindro';
        const capacidad = Math.max(0, num(v.capacidad, esCilindro ? 30 : 300));
        const nivelActual = Math.min(100, Math.max(0, num(v.nivelActualPct, esCilindro ? 0 : 20)));
        const objetivoDefault = esCilindro ? 100 : G.llenadoMaxEstacionario * 100;
        const nivelObjetivo = Math.min(100, Math.max(0, num(v.nivelObjetivoPct, objetivoDefault)));
        const precioLitro = Math.max(0, num(v.precioGasLitro, G.precioLitro));
        const precioKg = Math.max(0, num(v.precioGasKg, G.precioKg));

        if (!(capacidad > 0) || nivelObjetivo <= nivelActual) {
          return {
            total: mxn(0),
            sub: 'Revisa los datos: la capacidad debe ser mayor a cero y el nivel objetivo mayor que el nivel actual.',
            rows: [
              { k: 'Capacidad del recipiente', v: capacidad, format: 'unit', unit: esCilindro ? 'kg' : 'L' },
              { k: 'Nivel actual', v: nivelActual, format: 'unit', unit: '%' },
              { k: 'Nivel objetivo', v: nivelObjetivo, format: 'unit', unit: '%' },
            ],
            chart: [{ label: 'Sin cálculo', value: 1, tone: 'warn' }],
          };
        }

        const fraccion = (nivelObjetivo - nivelActual) / 100;
        const unidades = r2(capacidad * fraccion);
        const precioUnitario = esCilindro ? precioKg : precioLitro;
        const costo = r2(unidades * precioUnitario);
        const unidad = esCilindro ? 'kg' : 'L';
        const kgEquivalentes = esCilindro ? unidades : r2(unidades * 0.54);
        const yaTiene = r2(capacidad * (nivelActual / 100));
        const sobrellenado = !esCilindro && nivelObjetivo > 90;

        return {
          total: mxn(costo),
          sub:
            'Cargar ' + unidades.toLocaleString('es-MX') + ' ' + unidad + ' (del ' + nivelActual + '% al ' + nivelObjetivo +
            '%) cuesta ' + mxn(costo) + ' a ' + mxn(precioUnitario) + ' por ' + unidad + '. ' +
            (sobrellenado
              ? 'Ojo: los estacionarios se cargan a un máximo de alrededor del 85% por seguridad.'
              : 'Confirma el precio máximo semanal de la CNE en tu municipio antes de pedir la pipa.'),
          rows: [
            { k: 'Costo del llenado', v: costo, extra: true },
            { k: 'Gas a cargar', v: unidades, format: 'unit', unit: unidad, decimals: 1 },
            { k: 'Gas que ya tienes', v: yaTiene, format: 'unit', unit: unidad, decimals: 1 },
            { k: 'Equivalente en kilos de gas', v: kgEquivalentes, format: 'unit', unit: 'kg', decimals: 1 },
            { k: 'Precio aplicado', ref: 'precio máximo semanal CNE', v: precioUnitario, decimals: 2 },
            { k: 'Capacidad del recipiente', v: capacidad, format: 'unit', unit: unidad },
            { k: 'Costo de llenar de vacío al objetivo', v: r2(capacidad * (nivelObjetivo / 100) * precioUnitario) },
          ],
          chart: [
            { label: 'Gas que ya tienes', value: Math.round(yaTiene), tone: 'prop' },
            { label: 'Gas que cargas', value: Math.round(unidades), tone: 'main' },
          ],
        };
      }

      // ── Rama 4: costo de obra ───────────────────────────────────────────
      if (id === 'obra') {
        const metros = Math.max(0, num(v.metros, 0));
        const calidadIn = String(v.calidadObra || 'media');
        const calidad = O.costoM2[calidadIn] ? calidadIn : 'media';
        const costoM2 = O.costoM2[calidad];
        const total = costoM2 * metros;
        const materiales = total * O.pctMateriales;
        const manoObra = total * (1 - O.pctMateriales);

        return {
          total: mxn(total),
          sub:
            'Construir ' + metros.toLocaleString('es-MX') + ' m² con terminación ' + calidad + ' cuesta alrededor de ' +
            mxn(total) + ', a razón de ' + mxn(costoM2) + ' por m². De ese total, unos ' + mxn(materiales) +
            ' son materiales y ' + mxn(manoObra) + ' mano de obra. No incluye terreno, proyecto ni licencias.',
          rows: [
            { k: 'Costo total de la obra', v: total, extra: true },
            { k: 'Costo por metro cuadrado', ref: 'nivel ' + calidad, v: costoM2 },
            { k: 'Superficie a construir', v: metros, format: 'unit', unit: 'm²' },
            { k: 'Materiales (≈60%)', v: materiales },
            { k: 'Mano de obra (≈40%)', v: manoObra },
            { k: 'Mismo proyecto en terminación económica', v: O.costoM2.economica * metros },
            { k: 'Mismo proyecto en terminación media', v: O.costoM2.media * metros },
            { k: 'Mismo proyecto en terminación premium', v: O.costoM2.premium * metros },
          ],
          chart: [
            { label: 'Materiales', value: Math.round(materiales), tone: 'main' },
            { label: 'Mano de obra', value: Math.round(manoObra), tone: 'prop' },
          ],
        };
      }

      // ── Rama 1 (default): recibo de luz CFE ─────────────────────────────
      const zona = String(v.tarifaZona || '1').toLowerCase();
      const esVerano = String(v.temporada || 'verano').toLowerCase() === 'verano';
      const aplicaDac = String(v.aplicarDac || 'no').toLowerCase() === 'si';

      const consumoBim = Math.max(0, num(v.consumoKwh, 0));
      const consumoMes = consumoBim / 2;
      const limiteDac = C.limiteDac[zona] !== undefined ? C.limiteDac[zona] : 250;
      const bloques = esVerano ? (C.bloquesVerano[zona] || C.bloqueFueraVerano) : C.bloqueFueraVerano;

      let kwhBasico = 0, kwhIntermedio = 0, kwhExcedente = 0;
      let basicoMes = 0, intermedioMes = 0, excedenteMes = 0;
      let cargoEnergiaMes = 0;
      let cargoFijoMes = 0;

      if (aplicaDac) {
        cargoEnergiaMes = consumoMes * C.dacPrecioKwh;
        cargoFijoMes = C.dacCargoFijoMensual;
      } else {
        kwhBasico = Math.min(consumoMes, bloques.basicoHasta);
        kwhIntermedio = Math.max(0, Math.min(consumoMes, bloques.intermedioHasta) - bloques.basicoHasta);
        kwhExcedente = Math.max(0, consumoMes - bloques.intermedioHasta);
        basicoMes = kwhBasico * C.precioBasico;
        intermedioMes = kwhIntermedio * C.precioIntermedio;
        excedenteMes = kwhExcedente * C.precioExcedente;
        cargoEnergiaMes = basicoMes + intermedioMes + excedenteMes;
      }

      const cargoEnergia = cargoEnergiaMes * 2;
      const cargoFijo = cargoFijoMes * 2;
      const subtotal = cargoEnergia + cargoFijo;
      const iva = subtotal * C.iva;
      const totalRecibo = subtotal + iva;
      const costoPorKwh = consumoBim > 0 ? totalRecibo / consumoBim : 0;
      const superaDac = !aplicaDac && consumoMes > limiteDac;
      const cercaDac = !aplicaDac && !superaDac && consumoMes >= limiteDac * 0.85;

      const rows = [
        { k: 'Total del recibo bimestral', v: r2(totalRecibo), extra: true },
        { k: 'Cargo de energía', v: r2(cargoEnergia) },
        { k: 'Cargo fijo', v: r2(cargoFijo) },
        { k: 'IVA 16%', v: r2(iva) },
        { k: 'Costo promedio real por kWh', v: r2(costoPorKwh), decimals: 2 },
        { k: 'Consumo mensual equivalente', v: Math.round(consumoMes), format: 'unit', unit: 'kWh' },
        { k: 'Límite de alto consumo de tu zona', ref: 'promedio móvil 12 meses', v: limiteDac, format: 'unit', unit: 'kWh/mes' },
      ];
      if (!aplicaDac) {
        rows.push({ k: 'kWh en tramo básico (por mes)', v: Math.round(kwhBasico), format: 'unit', unit: 'kWh' });
        rows.push({ k: 'kWh en tramo intermedio (por mes)', v: Math.round(kwhIntermedio), format: 'unit', unit: 'kWh' });
        rows.push({ k: 'kWh en tramo excedente (por mes)', v: Math.round(kwhExcedente), format: 'unit', unit: 'kWh' });
      }
      rows.push({ k: 'Estimación del gasto anual en luz', v: r2(totalRecibo * 6) });

      const segs = [];
      if (aplicaDac) {
        if (cargoEnergia > 0) segs.push({ label: 'Energía DAC', value: r2(cargoEnergia), tone: 'bad' });
        if (cargoFijo > 0) segs.push({ label: 'Cargo fijo', value: r2(cargoFijo), tone: 'warn' });
      } else {
        if (basicoMes > 0) segs.push({ label: 'Básico', value: r2(basicoMes * 2), tone: 'good' });
        if (intermedioMes > 0) segs.push({ label: 'Intermedio', value: r2(intermedioMes * 2), tone: 'main' });
        if (excedenteMes > 0) segs.push({ label: 'Excedente', value: r2(excedenteMes * 2), tone: 'bad' });
      }
      if (iva > 0) segs.push({ label: 'IVA 16%', value: r2(iva), tone: 'prop' });

      let aviso = '';
      if (aplicaDac) {
        aviso = ' Para volver al subsidio tienes que bajar tu promedio móvil de doce meses por debajo de ' + limiteDac + ' kWh/mes.';
      } else if (superaDac) {
        aviso = ' Tu consumo mensual ya supera el límite DAC de ' + limiteDac + ' kWh/mes: si lo sostienes doce meses, CFE te reclasifica y pierdes el subsidio.';
      } else if (cercaDac) {
        aviso = ' Estás cerca del límite DAC (' + limiteDac + ' kWh/mes): vigila tu promedio anual para no perder el subsidio.';
      }

      return {
        total: mxn(totalRecibo),
        sub:
          'Pagas ' + mxn(totalRecibo) + ' por el bimestre, o sea ' + costoPorKwh.toFixed(2).replace('.', ',') +
          ' pesos por kWh. Tus ' + Math.round(consumoBim) + ' kWh equivalen a ' + Math.round(consumoMes) + ' kWh al mes.' + aviso,
        rows: rows,
        chart: segs.length ? segs : [{ label: 'Sin consumo', value: 1, tone: 'prop' }],
      };
    });
  })();
</script>
