---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PushOptIn from '../components/PushOptIn.astro';
import DatosHoyNav from '../components/DatosHoyNav.astro';
import dolarData from '../data/live/dolar.json';

const LIVE_URL = 'https://dolarapi.com/v1/dolares';
const quotes: Record<string, any> = (dolarData as any).quotes || {};
const fetchedAt = (dolarData as any)._meta?.fetchedAt;

// Orden + etiquetas para mostrar
const ORDEN: Array<{ casa: string; label: string }> = [
  { casa: 'blue', label: 'Blue' },
  { casa: 'oficial', label: 'Oficial' },
  { casa: 'bolsa', label: 'MEP (Bolsa)' },
  { casa: 'contadoconliqui', label: 'CCL (Contado con liqui)' },
  { casa: 'tarjeta', label: 'Tarjeta' },
  { casa: 'cripto', label: 'Cripto' },
  { casa: 'mayorista', label: 'Mayorista' },
];
const fmt = (n: number | null | undefined) => (n == null ? '—' : '$' + Math.round(n).toLocaleString('es-AR'));
const oficialVenta = quotes.oficial?.venta || 0;
const brecha = (v: number | undefined) => (!v || !oficialVenta ? null : Math.round((v / oficialVenta - 1) * 1000) / 10);
const cards = ORDEN.filter((o) => quotes[o.casa]).map((o) => {
  const q = quotes[o.casa];
  return { ...o, compra: q.compra, venta: q.venta, brecha: o.casa === 'oficial' ? null : brecha(q.venta) };
});
const blue = quotes.blue?.venta, mep = quotes.bolsa?.venta;

const SITE = 'https://hacecuentas.com';
const URL = `${SITE}/dolar-hoy`;
const updated = fetchedAt ? new Intl.DateTimeFormat('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(fetchedAt)) : '—';
const title = 'Dólar hoy en Argentina EN VIVO: blue, oficial, MEP, CCL y cripto | Hacé Cuentas';
const description = `Cotización del dólar hoy en Argentina, en vivo: blue ${fmt(blue)}, oficial ${fmt(oficialVenta)}, MEP ${fmt(mep)}, CCL, tarjeta y cripto. Brecha cambiaria y conversor. Se actualiza solo.`;

const faq = [
  { q: '¿A cuánto está el dólar blue hoy?', a: `El dólar blue cotiza hoy a ${fmt(quotes.blue?.compra)} para la compra y ${fmt(blue)} para la venta. La cotización se actualiza automáticamente; la hora figura arriba.` },
  { q: '¿Qué diferencia hay entre dólar oficial, blue, MEP y CCL?', a: 'El oficial es el del Banco Nación. El blue es el informal. El MEP (dólar bolsa) y el CCL (contado con liquidación) son legales y se operan comprando/vendiendo bonos o CEDEARs; el CCL permite girar al exterior. La brecha es cuánto más caro está cada uno respecto del oficial.' },
  { q: '¿Cuál es la brecha cambiaria hoy?', a: blue ? `La brecha del blue respecto del oficial hoy es de aproximadamente ${brecha(blue)}%.` : 'La brecha se calcula como (precio del dólar paralelo ÷ dólar oficial − 1). Arriba ves la brecha de cada tipo de cambio.' },
  { q: '¿De dónde salen estas cotizaciones?', a: 'De DolarAPI (que agrega fuentes de mercado y el BCRA). Al abrir la página se traen los valores más recientes en tiempo real.' },
  { q: '¿Cada cuánto se actualiza el dólar acá?', a: 'En vivo: al cargar la página se consultan las cotizaciones del momento, y el sitio guarda un valor de respaldo que se refresca varias veces al día.' },
];
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Dólar hoy', item: URL } ] },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
] };
const liveConfig = { url: LIVE_URL };
---

<Layout image="/og/data-dolar-hoy.jpg" imageWidth={1200} imageHeight={675} title={title} description={description} canonical="/dolar-hoy" schema={schema} audience="AR" domain="data">
  <Header slot="header" />
  <main class="wrap">
    <nav class="crumbs"><a href="/">Inicio</a> › <span>Dólar hoy</span></nav>
    <h1>Dólar hoy en Argentina — en vivo 💵</h1>
    <p class="lede">Cotización del dólar <strong>blue, oficial, MEP, CCL, tarjeta y cripto</strong>, actualizada en tiempo real. Con brecha cambiaria.</p>
    <p class="updated">Última actualización: <span data-live-updated>{updated}</span> · Fuente: <a href="https://dolarapi.com" rel="noopener" target="_blank">DolarAPI</a></p>

    <div class="cards" data-cards>
      {cards.map((c) => (
        <div class="card" data-casa={c.casa}>
          <div class="card-label">{c.label}</div>
          <div class="card-venta" data-venta>{fmt(c.venta)}</div>
          <div class="card-meta">
            <span>compra <span data-compra>{fmt(c.compra)}</span></span>
            {c.brecha != null && <span class="brecha" data-brecha>+{c.brecha}% vs oficial</span>}
          </div>
        </div>
      ))}
    </div>

    <DatosHoyNav current="/dolar-hoy" />

    <PushOptIn topic="valores" />

    <section class="links">
      <h2>Calculá con el dólar</h2>
      <ul>
        <li><a href="/cambio-de-monedas">💱 Conversor de monedas (pesos ⇄ dólar)</a></li>
        <li><a href="/calculadora-dolar-blue-vs-oficial-brecha">📊 Brecha dólar blue vs oficial</a></li>
        <li><a href="/valores-bcra">🏦 Dólar, UVA e índices del BCRA</a></li>
        <li><a href="/calculadora-plazo-fijo">💰 Plazo fijo — ¿le gana al dólar?</a></li>
        <li><a href="/estadisticas-dolar-argentina">📈 Estadísticas históricas: blue y oficial desde 2011</a></li>
      </ul>
    </section>

    <section class="faq">
      <h2>Preguntas frecuentes</h2>
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
  </main>
  <Footer slot="footer" />
</Layout>

<script type="application/json" id="live-cfg" set:html={JSON.stringify(liveConfig)} />
<script>
  (function () {
    const cfg = JSON.parse(document.getElementById('live-cfg')?.textContent || '{}');
    if (!cfg.url) return;
    const fmt = (n) => (n == null ? '—' : '$' + Math.round(n).toLocaleString('es-AR'));
    async function refresh() {
      try {
        const res = await fetch(cfg.url, { cache: 'no-store' });
        if (!res.ok) return;
        const arr = await res.json();
        if (!Array.isArray(arr)) return;
        const by = {}; arr.forEach((q) => by[q.casa] = q);
        const oficial = by.oficial?.venta || 0;
        document.querySelectorAll('.card[data-casa]').forEach((el) => {
          const q = by[el.getAttribute('data-casa')]; if (!q) return;
          el.querySelector('[data-venta]').textContent = fmt(q.venta);
          const cp = el.querySelector('[data-compra]'); if (cp) cp.textContent = fmt(q.compra);
          const br = el.querySelector('[data-brecha]');
          if (br && oficial && el.getAttribute('data-casa') !== 'oficial') br.textContent = '+' + (Math.round((q.venta / oficial - 1) * 1000) / 10) + '% vs oficial';
        });
        const u = document.querySelector('[data-live-updated]');
        if (u) u.textContent = new Intl.DateTimeFormat('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date());
      } catch {}
    }
    refresh();
    setInterval(refresh, 120000);
  })();
</script>

<style>
  .wrap { max-width: 820px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
  .crumbs { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  .crumbs a { color: var(--accent); text-decoration: none; }
  h1 { font-size: clamp(1.6rem, 4.5vw, 2.1rem); font-weight: 800; margin: 0 0 0.5rem; }
  .lede { font-size: 1.05rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 0.4rem; }
  .updated { font-size: 0.8rem; color: var(--text-subtle); margin: 0 0 1.5rem; }
  .updated a { color: var(--accent); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
  .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .card-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-subtle); font-weight: 700; }
  .card-venta { font-size: 1.6rem; font-weight: 800; color: var(--text); margin: 0.25rem 0; font-variant-numeric: tabular-nums; }
  .card-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.25rem; font-size: 0.78rem; color: var(--text-muted); }
  .brecha { color: var(--accent); font-weight: 600; }
  .links, .faq { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .links h2, .faq h2 { font-size: 1.2rem; font-weight: 700; margin: 0 0 1rem; }
  .links ul { list-style: none; padding: 0; display: grid; gap: 0.5rem; grid-template-columns: 1fr; }
  @media (min-width: 600px) { .links ul { grid-template-columns: 1fr 1fr; } }
  .links a { color: var(--accent); text-decoration: none; font-weight: 600; }
  .faq details { border-bottom: 1px solid var(--border); padding: 0.75rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq details p { margin-top: 0.5rem; color: var(--text-muted); line-height: 1.6; }
</style>
