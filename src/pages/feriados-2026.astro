---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { FERIADOS_LATAM_2026 } from '../lib/data/feriados-latam-2026';

// Hub desambiguador para queries SIN país.
//
// Medido en Bing Webmaster (2026-07-25, ventana de 78 días):
//   «feriados 2026»   3.528 impr →  7 clicks (0,20%)
//   «calendario 2026»   505 impr →  1 click  (0,20%)
// Rankeaban /feriados-peru-2026, /feriados-chile-2026, /feriados-ecuador-2026 y
// /feriados-mexico-2026 rotando entre sí. No es canibalización (no se pueden
// fusionar los feriados de dos países): la query es ambigua y el usuario no
// sabe si el resultado es el suyo. Esta página responde la query ambigua y
// rutea, en vez de apostar a un país al azar.

const PAISES = ['argentina', 'mexico', 'colombia', 'chile', 'peru', 'ecuador']
  .map((k) => (FERIADOS_LATAM_2026 as Record<string, any>)[k])
  .filter(Boolean);

const title = 'Feriados 2026 por país: calendario oficial de LATAM';
const description =
  'Feriados 2026 de México, Colombia, Chile, Perú y Ecuador en una sola tabla: cuántos días no laborables tiene cada país y el calendario oficial completo. Elegí tu país y mirá las fechas.';

const hoy = new Date('2026-07-25');
function proximo(p: any) {
  const lista = (p.feriados || []).filter((f: any) => f?.fecha);
  for (const f of lista) {
    const d = new Date(f.fecha);
    if (!Number.isNaN(d.getTime()) && d >= hoy) return f;
  }
  return null;
}

const faq = [
  {
    q: '¿Cuántos feriados hay en 2026 en cada país?',
    a: PAISES.map((p) => `${p.pais}: ${p.totalLabel}`).join('. ') + '.',
  },
  {
    q: '¿Los feriados son iguales en toda Latinoamérica?',
    a: 'No. Cada país fija sus feriados por ley propia y sólo coinciden algunas fechas religiosas y el 1 de enero y el 1 de mayo. Las fiestas patrias, los feriados puente y los días de descanso obligatorio cambian por completo de un país a otro, y también cambia si el día se paga doble o si se puede trasladar al lunes.',
  },
  {
    q: '¿Qué diferencia hay entre feriado y día no laborable?',
    a: 'Depende del país. En general el feriado es de descanso obligatorio y se paga recargo si trabajás; el día no laborable queda a criterio del empleador. Perú y Argentina distinguen las dos figuras de forma explícita; en Colombia y Chile casi todos los días son feriados obligatorios.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="hub">
    <h1>Feriados 2026 por país</h1>
    <p class="lead">
      Elegí tu país y mirá el calendario oficial completo de {new Date().getFullYear() === 2026 ? '2026' : '2026'}
      con las fechas, el día de la semana y los fines de semana largos.
    </p>

    <table class="tabla">
      <thead>
        <tr>
          <th scope="col">País</th>
          <th scope="col">Feriados 2026</th>
          <th scope="col">Próximo</th>
          <th scope="col">Calendario</th>
        </tr>
      </thead>
      <tbody>
        {PAISES.map((p) => {
          const n = proximo(p);
          return (
            <tr>
              <th scope="row">{p.pais}</th>
              <td>{p.totalLabel}</td>
              <td>{n ? `${n.nombre} · ${n.fecha}` : '—'}</td>
              <td><a href={`/${p.slug}`}>Ver feriados de {p.pais} →</a></td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <h2>Preguntas frecuentes</h2>
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}

    <h2>Hacé algo con los feriados</h2>
    <ul class="links">
      <li><a href="/fechas/feriados">¿Cuántos días hábiles quedan en 2026?</a> — desde hoy hasta fin de año, con los feriados de tu país descontados.</li>
      <li><a href="/trabajo/vacaciones">Armá tu puente óptimo 2026</a> — decinos cuántos días de vacaciones tenés y te decimos cuándo pedirlos para lograr más días seguidos libres.</li>
    </ul>

    <h2>También te puede servir</h2>
    <ul class="links">
      <li><a href="/fechas/dias-entre-fechas">Días corridos y hábiles entre dos fechas</a></li>
      <li><a href="/fechas/cuenta-regresiva">Cuántos días faltan para una fecha</a></li>
      <li><a href="/fechas/edad-exacta">Edad exacta en años, meses y días</a></li>
    </ul>
  </main>
</Layout>

<style>
  .hub { max-width: 820px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  h1 { font-size: clamp(1.5rem, 4vw, 2.1rem); line-height: 1.2; margin: 0 0 .6rem; }
  .lead { color: var(--muted, #555); margin: 0 0 1.5rem; }
  h2 { font-size: 1.25rem; margin: 2rem 0 .75rem; }
  .tabla { width: 100%; border-collapse: collapse; font-size: .95rem; display: block; overflow-x: auto; }
  .tabla th, .tabla td { padding: .6rem .7rem; border-bottom: 1px solid var(--border, #e5e5e5); text-align: left; vertical-align: top; }
  .tabla thead th { font-weight: 600; white-space: nowrap; }
  .tabla tbody th { font-weight: 600; white-space: nowrap; }
  details { border-bottom: 1px solid var(--border, #e5e5e5); padding: .6rem 0; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin: .6rem 0 0; color: var(--muted, #555); }
  .links { padding-left: 1.1rem; }
  .links li { margin: .35rem 0; }
</style>
