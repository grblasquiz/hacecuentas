---
/**
 * Hub de decisión — "¿Cuánto me cuesta realmente un empleado?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * Las alícuotas patronales y la ART por riesgo se importan del módulo real
 * (src/lib/formulas/aportes-patronales-cargas-sociales.ts). Acá no se
 * hardcodea ningún porcentaje de la norma.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import CostoEmpleadoExperience from '../../components/generated/CostoEmpleadoExperience.astro';
import {
  hub,
  CASE_MATH,
  INCISO_A,
  DIAS_VACACIONES_BASE,
  DIVISOR_VACACIONES,
  SEGURO_VIDA_MENSUAL,
} from '../../lib/hubs/costo-de-un-empleado';
import {
  ALICUOTAS_DEC_814,
  ART_POR_RIESGO,
  APORTE_OBRA_SOCIAL_EMPLEADOR,
} from '../../lib/formulas/aportes-patronales-cargas-sociales';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CostoEmpleadoExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

