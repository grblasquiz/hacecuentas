---
/**
 * Hub de decisión — "Me quedé sin trabajo: ¿qué me paga ANSES?"
 * Reemplaza 3 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: la respuesta la aporta el caso activo (hub.cases).
 * La página sólo aporta datos (src/lib/hubs/seguro-de-desempleo.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SeguroDesempleoExperience from '../../components/generated/SeguroDesempleoExperience.astro';
import { hub, DESEMPLEO, SMVM, EMBARGO, FONDO_CESE, CASE_MATH } from '../../lib/hubs/seguro-de-desempleo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SeguroDesempleoExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ DESEMPLEO, SMVM, EMBARGO, FONDO_CESE, MATH: CASE_MATH }}>
  (function () {
    const H = window.HC_HUB;

    const meses1 = (n) => n + (n === 1 ? ' mes' : ' meses');

    /** Duración de la prestación según meses aportados (Ley 24.013 art. 117). */
    function duracion(mesesAportados) {
      for (let i = 0; i < DESEMPLEO.escalones.length; i++) {
        if (mesesAportados >= DESEMPLEO.escalones[i].desde) return DESEMPLEO.escalones[i].meses;
      }
      return 0; // con menos de 6 meses de aportes no corresponde
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'prestacion';
      const m = MATH[id] || MATH.prestacion;
      const sueldo = Math.max(0, v.sueldo || 0);
      const aportados = Math.max(0, Math.min(36, v.meses || 0));
      const cobradas = Math.max(0, Math.min(12, v.cobrados || 0));

      // ─────────────── RAMA EMBARGO ───────────────
      // Art. 120 LCT + Decreto 484/87, sobre el sueldo NETO.
      if (id === 'embargo') {
        const neto = Math.max(0, v.neto || 0);
        const alimentaria = String(v.deuda || 'comun') === 'alimentaria';

        let embargable = 0;
        let pctTexto = '0% — sueldo inembargable';
        let excedente = 0;

        if (neto > 0 && alimentaria) {
          embargable = neto * EMBARGO.alimentaria;
          excedente = neto;
          pctTexto = '33% del neto (tope por cuota alimentaria)';
        } else if (neto > SMVM) {
          excedente = neto - SMVM;
          const pct = neto <= SMVM * 2 ? EMBARGO.tramo1 : EMBARGO.tramo2;
          embargable = excedente * pct;
          pctTexto =
            Math.round(pct * 100) + '% del excedente sobre el salario mínimo (sueldo ' +
            (neto <= SMVM * 2 ? 'entre 1 y 2' : 'mayor a 2') + ' SMVM)';
        }

        const teQueda = neto - embargable;
        const pctSobreNeto = neto > 0 ? (embargable / neto) * 100 : 0;

        const rows = [
          { k: 'Tu sueldo neto en mano', ref: 'Art. 120 LCT', v: Math.round(neto) },
          { k: 'Mínimo inembargable (1 salario mínimo)', ref: 'SMVM', v: Math.round(alimentaria ? 0 : SMVM) },
          { k: 'Excedente sobre el mínimo', ref: 'Dto. 484/87', v: Math.round(alimentaria ? neto : excedente) },
          { k: 'Máximo embargable por mes', ref: m.norma, v: Math.round(embargable), extra: true },
          { k: 'Lo que te queda todos los meses', ref: m.norma, v: Math.round(teQueda), extra: true },
          {
            k: 'Retención sobre tu sueldo neto',
            v: Number(pctSobreNeto.toFixed(1)),
            format: 'unit',
            unit: '%',
            decimals: 1,
          },
        ];

        return {
          total: H.ars(Math.round(embargable)),
          sub:
            pctTexto + ' · te quedan ' + H.ars(Math.round(teQueda)) + ' de ' + H.ars(Math.round(neto)) +
            ' (retención del ' + pctSobreNeto.toFixed(1).replace('.', ',') + '%)',
          rows: rows,
          chart: [
            { label: 'Parte protegida de tu sueldo', value: Math.max(0, teQueda), tone: 'good' },
            { label: 'Parte embargable', value: Math.max(0, embargable), tone: 'warn' },
          ],
          position: Number(Math.min(100, pctSobreNeto).toFixed(1)),
          positionLabel:
            embargable > 0
              ? 'Te retienen ' + H.ars(Math.round(embargable)) + ' por mes · ' +
                pctSobreNeto.toFixed(1).replace('.', ',') + '% del neto'
              : 'Tu sueldo es inembargable por deudas comunes',
        };
      }

      // ─────────────── RAMAS DE PRESTACIÓN ───────────────
      // Cuantía: 75% de la mejor remuneración, acotada entre piso y techo (Dto. 267/2006).
      const base = sueldo * DESEMPLEO.porcentaje;
      const cuota = sueldo > 0 ? Math.min(Math.max(base, DESEMPLEO.piso), DESEMPLEO.techo) : 0;

      let meses = duracion(aportados);
      if (m.tope !== null && meses > m.tope) meses = m.tope; // construcción: tope 8 cuotas
      const cuotaMostrada = meses > 0 ? cuota : 0;
      const cobradasReales = Math.min(cobradas, meses);
      const restantes = Math.max(0, meses - cobradasReales);
      const total = cuotaMostrada * meses;
      const porCobrar = cuotaMostrada * restantes;

      const rows = [
        { k: 'Mejor remuneración del semestre', ref: m.norma, v: Math.round(sueldo) },
        { k: '75% de esa remuneración', ref: 'Dto. 267/2006', v: Math.round(base) },
        { k: 'Piso de la prestación (ANSES)', ref: 'tope mínimo', v: DESEMPLEO.piso },
        { k: 'Techo de la prestación (ANSES)', ref: 'tope máximo', v: DESEMPLEO.techo },
        { k: 'Cuota mensual que cobrás', ref: m.norma, v: Math.round(cuotaMostrada), extra: true },
        { k: 'Cuotas que te corresponden', v: meses, format: 'unit', unit: 'meses', decimals: 0 },
        { k: 'Cuotas que te quedan por cobrar', v: restantes, format: 'unit', unit: 'meses', decimals: 0 },
        { k: 'Total de toda la prestación', ref: m.norma, v: Math.round(total), extra: true },
        { k: 'Lo que te falta cobrar', v: Math.round(porCobrar) },
      ];

      // Construcción: además del seguro, el fondo de cese laboral ya depositado.
      if (m.fondo && sueldo > 0) {
        const mesesPrimerAnio = Math.min(12, aportados);
        const mesesResto = Math.max(0, aportados - 12);
        const fondo = sueldo * FONDO_CESE.primerAnio * mesesPrimerAnio + sueldo * FONDO_CESE.siguientes * mesesResto;
        rows.push({ k: 'Fondo de cese laboral acumulado (12% y 8%)', ref: 'Ley 22.250', v: Math.round(fondo), extra: true });
        rows.push({ k: 'Fondo + prestación completa', ref: 'Ley 22.250 + 25.371', v: Math.round(fondo + total) });
      }

      const topeAplica = sueldo > 0 && base > DESEMPLEO.techo;
      const pisoAplica = sueldo > 0 && base < DESEMPLEO.piso;

      let nota;
      if (meses === 0) {
        nota = 'con ' + meses1(aportados) + ' de aportes no llegás a los 6 meses mínimos que pide ANSES';
      } else if (topeAplica) {
        nota = 'tu sueldo supera el tope: la cuota queda limitada al techo de ' + H.ars(DESEMPLEO.techo);
      } else if (pisoAplica) {
        nota = 'el 75% quedaba por debajo del piso, así que cobrás el mínimo de ' + H.ars(DESEMPLEO.piso);
      } else {
        nota = 'la cuota es el 75% de tu mejor remuneración';
      }
      if (m.tope !== null && duracion(aportados) > m.tope) {
        nota += ' · en la construcción la prestación se topea en ' + m.tope + ' cuotas';
      }

      const posicion = meses > 0 ? (cobradasReales / meses) * 100 : 0;

      return {
        total: H.ars(Math.round(cuotaMostrada)),
        sub:
          meses1(meses) + ' de prestación · ' + meses1(restantes) + ' por cobrar · total ' +
          H.ars(Math.round(total)) + ' · ' + nota,
        rows: rows,
        chart: [
          { label: 'Cuotas ya cobradas', value: cobradasReales, tone: 'warn' },
          { label: 'Cuotas que te quedan', value: restantes, tone: 'good' },
        ],
        position: Number(posicion.toFixed(1)),
        positionLabel:
          meses > 0
            ? meses1(meses) + ' de prestación · te quedan ' + restantes
            : 'No alcanzás el mínimo de 6 meses de aportes',
      };
    });
  })();
</script>
