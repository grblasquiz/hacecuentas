---
/**
 * Hub de decisión — "Empleada doméstica: ¿cuánto le pago?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/empleada-domestica.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * La escala horaria de la CNTCP y los importes de aportes/ART NO se escriben
 * acá: se importan del módulo real de la calculadora de aportes, que es la
 * fuente única del sitio para casas particulares.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EmpleadaDomesticaExperience from '../../components/generated/EmpleadaDomesticaExperience.astro';
import {
  hub,
  CASE_MATH,
  SEMANAS_MES,
  TRAMOS_VACACIONES,
  DIVISOR_VACACIONES,
} from '../../lib/hubs/empleada-domestica';
import {
  ESCALA_HORA,
  AFIP_POR_TRAMO,
  ART_REFERENCIAL,
} from '../../lib/formulas/aportes-empleada-domestica-casas-particulares-empleador';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <EmpleadaDomesticaExperience data={hub} />
  <Footer />
</Layout>

