---
/**
 * Hub de decisión — "Empleada doméstica: ¿cuánto le pago?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/empleada-domestica.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * La escala horaria de la CNTCP y los importes de aportes/ART NO se escriben
 * acá: se importan del módulo real de la calculadora de aportes, que es la
 * fuente única del sitio para casas particulares.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  CASE_MATH,
  SEMANAS_MES,
  TRAMOS_VACACIONES,
  DIVISOR_VACACIONES,
} from '../../lib/hubs/empleada-domestica';
import {
  ESCALA_HORA,
  AFIP_POR_TRAMO,
  ART_REFERENCIAL,
} from '../../lib/formulas/aportes-empleada-domestica-casas-particulares-empleador';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    MATH: CASE_MATH,
    ESCALA: ESCALA_HORA,
    AFIP: AFIP_POR_TRAMO,
    ART_DEF: ART_REFERENCIAL,
    SEMANAS_MES,
    TRAMOS: TRAMOS_VACACIONES,
    DIVISOR_VACACIONES,
  }}
>
  (function () {
    const H = window.HC_HUB;

    H.onCompute(function (v, kase) {
      const m = MATH[kase?.id] || MATH['hora-sin-retiro'];
      const cat = String(v.categoria || 'tareas-gen');
      const fila = ESCALA[cat] || ESCALA['tareas-gen'];
      const horas = Math.max(0, Math.min(48, v.horas || 0));
      const antiguedad = Math.max(0, v.antiguedad || 0);
      const art = v.art > 0 ? v.art : ART_DEF;

      // Valor hora de la escala CNTCP (columna con/sin retiro según la rama).
      const valorHora = m.retiro === 'con' ? fila.conRetiro : fila.sinRetiro;
      // Piso mensual = valor hora × horas semanales × 4,33 semanas promedio.
      const pisoMensual = valorHora * horas * SEMANAS_MES;
      const pactado = Math.max(0, v.sueldoPactado || 0);
      // Sólo la rama "mensual" parte de un monto pactado; el resto usa la escala.
      const usaPactado = kase?.id === 'mensual' && pactado > 0;
      const sueldo = usaPactado ? pactado : pisoMensual;

      // Tramo de horas semanales → aportes + contribuciones a ARCA (importe fijo).
      let tramo, aportes;
      if (horas < 12) { tramo = 'Menos de 12 hs/semana'; aportes = AFIP.menos12; }
      else if (horas < 16) { tramo = 'De 12 a menos de 16 hs/semana'; aportes = AFIP.de12a16; }
      else { tramo = '16 hs/semana o más (obra social plena)'; aportes = AFIP.mas16; }

      // Provisiones: SAC (un doceavo) y vacaciones (sueldo ÷ 25 × días, prorrateado al mes).
      const diasVac = (TRAMOS.find((t) => antiguedad < t.hastaAnios) || TRAMOS[TRAMOS.length - 1]).dias;
      const provSac = sueldo / 12;
      const valorDiaVac = sueldo / DIVISOR_VACACIONES;
      const provVac = (valorDiaVac * diasVac) / 12;

      const cargasEmpleador = aportes + art + provSac + provVac;
      const costoTotal = sueldo + cargasEmpleador;
      const soloAportes = m.foco === 'aportes';

      const rows = [];
      if (!usaPactado) {
        rows.push({ k: 'Valor hora de escala (' + (m.retiro === 'con' ? 'con' : 'sin') + ' retiro)', ref: 'CNTCP', v: valorHora, format: 'ars', decimals: 2 });
        rows.push({ k: 'Horas por mes (' + horas + ' × 4,33 semanas)', ref: 'Régimen horario', v: horas * SEMANAS_MES, format: 'unit', unit: 'horas', decimals: 1 });
      } else {
        rows.push({ k: 'Piso mensual según escala CNTCP', ref: 'CNTCP', v: pisoMensual });
      }
      rows.push({ k: usaPactado ? 'Sueldo mensual pactado' : 'Sueldo mensual de bolsillo', ref: 'Ley 26.844', v: sueldo, extra: true });
      rows.push({ k: 'Aportes y contribuciones a ARCA — ' + tramo, ref: 'Casas Particulares', v: aportes });
      rows.push({ k: 'Cuota mensual de ART', ref: 'Ley 24.557', v: art });
      if (!soloAportes) {
        rows.push({ k: 'Provisión de aguinaldo (1/12 del sueldo)', ref: 'Art. 39', v: provSac });
        rows.push({ k: 'Provisión de vacaciones (' + diasVac + ' días a sueldo ÷ 25)', ref: 'Art. 30', v: provVac });
      }
      rows.push({
        k: soloAportes ? 'Total mensual a ARCA + ART' : 'Costo total mensual para vos',
        ref: soloAportes ? 'ARCA' : 'Ley 26.844',
        v: soloAportes ? aportes + art : costoTotal,
        extra: true,
      });

      const total = soloAportes ? aportes + art : costoTotal;
      const pesoCargas = costoTotal > 0 ? (cargasEmpleador / costoTotal) * 100 : 0;

      const sub = soloAportes
        ? tramo + ' · ARCA ' + H.ars(aportes) + ' + ART ' + H.ars(art) + ' · sueldo aparte ' + H.ars(sueldo)
        : 'ella cobra ' + H.ars(sueldo) + ' · vos ponés ' + H.ars(cargasEmpleador) + ' más (' + pesoCargas.toFixed(1).replace('.', ',') + '% del total) · ' + m.nota;

      return {
        total: H.ars(total),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Sueldo de bolsillo (lo que cobra ella)', value: Math.round(sueldo), tone: 'main' },
          { label: 'Aportes y contribuciones a ARCA', value: Math.round(aportes), tone: 'warn' },
          { label: 'ART', value: Math.round(art), tone: 'bad' },
          { label: 'Provisión de aguinaldo y vacaciones', value: Math.round(provSac + provVac), tone: 'prop' },
        ],
      };
    });
  })();
</script>
