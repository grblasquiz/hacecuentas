---
/**
 * Hub de decisión — "¿Cuánto cobro de aguinaldo?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/aguinaldo.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AguinaldoExperience from '../../components/generated/AguinaldoExperience.astro';
import CalculatorResultLoop from '../../components/CalculatorResultLoop.astro';
import { hub, CASE_MATH, DIAS_SEMESTRE } from '../../lib/hubs/aguinaldo';
import { BASE_IMPONIBLE_MAXIMA_APORTES } from '../../lib/formulas/sueldo-ar';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <AguinaldoExperience data={hub} />
  <CalculatorResultLoop
    slug="trabajo/aguinaldo"
    title="Cálculo de aguinaldo"
    rootSelector=".mockup-aguinaldo"
    completeSelector="#calcBtn"
    resultSelector="#net"
    summarySelector="#summary"
    reminder={{
      date: '2026-12-18',
      title: 'Fecha límite de la segunda cuota del aguinaldo',
      description: 'Revisá el depósito y recalculá tu SAC con el mejor sueldo del semestre.',
    }}
    related={[
      { href: '/trabajo/sueldo-bruto-y-neto', title: 'Calculá tu sueldo en mano', description: 'Del bruto al neto, con descuentos.' },
      { href: '/trabajo/liquidacion-final', title: 'Revisá tu liquidación final', description: 'Renuncia, despido y SAC proporcional.' },
    ]}
  />
  <Footer />
</Layout>
