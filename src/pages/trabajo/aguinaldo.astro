---
/**
 * Hub de decisión — "¿Cuánto cobro de aguinaldo?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/aguinaldo.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, CASE_MATH, DIAS_SEMESTRE } from '../../lib/hubs/aguinaldo';
import { BASE_IMPONIBLE_MAXIMA_APORTES } from '../../lib/formulas/sueldo-ar';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ MATH: CASE_MATH, DIAS_SEMESTRE, TOPE_APORTES: BASE_IMPONIBLE_MAXIMA_APORTES }}
>
  (function () {
    const H = window.HC_HUB;

    H.onCompute(function (v, kase) {
      const m = MATH[kase?.id] || MATH.dependencia;
      const sueldo = Math.max(0, v.sueldo || 0);
      const mesesRaw = Math.max(0, Math.min(6, v.meses || 0));
      const diasRaw = Math.max(0, Math.min(30, v.dias || 0));
      const bono = m.bono ? Math.max(0, v.bono || 0) : 0;

      // Proporción del semestre: meses enteros sobre 6 + días sueltos sobre 181 (Art. 122).
      const fraccion = Math.min(1, mesesRaw / 6 + diasRaw / DIAS_SEMESTRE);
      const diasComputados = Math.round(fraccion * DIAS_SEMESTRE);

      // SAC = 50% de la mejor remuneración del semestre, proporcional al tiempo trabajado.
      const sacCompleto = sueldo / 2;
      const bruto = sacCompleto * fraccion;

      // Aportes personales (11% jubilación + 3% PAMI + 3% obra social) con base topeada.
      const aportes = Math.min(bruto, TOPE_APORTES / 2) * m.aportes;
      const neto = bruto - aportes;

      const rows = [];
      rows.push({ k: m.baseLabel, ref: m.norma, v: sueldo });
      rows.push({ k: 'Medio sueldo (SAC por semestre completo)', ref: 'Art. 121', v: sacCompleto });
      rows.push({ k: 'Aguinaldo bruto proporcional', ref: 'Art. 122', v: bruto, extra: true });
      if (aportes > 0) rows.push({ k: 'Aportes personales (17%)', ref: 'Ley 24.241', v: aportes });
      rows.push({ k: 'Aguinaldo neto en mano', ref: m.norma, v: neto, extra: true });
      if (m.bono && bono > 0) {
        rows.push({ k: 'Bono/refuerzo previsional (no genera SAC)', ref: 'ANSES', v: bono });
        rows.push({ k: 'Total a cobrar en el mes (haber + SAC + bono)', ref: 'ANSES', v: sueldo + neto + bono });
      }

      const mesesComputados = Math.round(fraccion * 6 * 10) / 10;
      const mesesAfuera = Math.round((6 - mesesComputados) * 10) / 10;

      const subPartes = [
        mesesComputados + ' de 6 meses del semestre',
        'base ' + H.ars(sueldo),
      ];
      if (aportes > 0) subPartes.push('bruto ' + H.ars(bruto) + ' − 17% de aportes');
      else subPartes.push(m.notaSinAportes || 'sin aportes personales');

      return {
        total: H.ars(neto),
        sub: subPartes.join(' · '),
        rows: rows,
        chart: [
          { label: 'Meses que computan', value: mesesComputados, tone: 'good' },
          { label: 'Meses que quedan afuera', value: Math.max(0, mesesAfuera), tone: 'warn' },
        ],
        position: Math.round(fraccion * 1000) / 10,
        positionLabel:
          mesesComputados + ' de 6 meses computados (' + diasComputados + ' de ' + DIAS_SEMESTRE + ' días)',
      };
    });
  })();
</script>
