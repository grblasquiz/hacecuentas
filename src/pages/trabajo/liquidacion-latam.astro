---
/**
 * Hub de decisión — "Me voy del trabajo: ¿qué me tienen que pagar?" (MX, CO, PE, CL, BO, ES).
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * OJO con el audience: HubData sólo admite 'AR' | 'global'. Este hub cubre seis
 * mercados, así que va 'global' — no hay un país único al que apuntar el geo.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, PAISES, MX_VACACIONES } from '../../lib/hubs/liquidacion-latam';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ PAISES, MX_VAC: MX_VACACIONES }}>
  (function () {
    const H = window.HC_HUB;

    /** Decimales por moneda: los pesos van enteros, soles/euros/bolivianos con centavos. */
    const DECIMALES = { mx: 0, co: 0, cl: 0, pe: 2, bo: 2, es: 2 };

    function money(n, P, dec) {
      const val = Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: dec,
        maximumFractionDigits: dec,
      });
      return P.simbolo + ' ' + val;
    }

    /** Días de vacaciones del Art. 76 LFT (reforma 2023) según años cumplidos. */
    function diasVacacionesMx(anios) {
      const a = Math.floor(anios);
      if (a < 1) return 12;
      for (const par of MX_VAC) {
        if (a <= par[0]) return par[1];
      }
      return 32;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'mx';
      const P = PAISES[id];
      const dec = DECIMALES[id] != null ? DECIMALES[id] : 0;

      const sueldo = Math.max(0, v.sueldo || 0);
      const anios = Math.max(0, v.anios || 0);
      const meses = Math.min(11, Math.max(0, v.meses || 0));
      const mesesAnio = Math.min(12, Math.max(0, v.mesesAnio || 0));
      const mesesSem = Math.min(6, Math.max(0, v.mesesSem || 0));
      const diasVac = Math.max(0, v.diasVac || 0);
      const diasPend = Math.min(31, Math.max(0, v.diasPend || 0));
      const motivo = String(v.motivo || 'despido');
      const conAviso = String(v.aviso || 'no') === 'si';

      const antiguedadAnios = anios + meses / 12;
      const diario = sueldo / 30;

      const rows = [];
      let ruptura = 0; // lo que se cobra por la ruptura del vínculo
      let devengado = 0; // lo que ya venías generando
      let descuentos = 0;
      let nota = '';

      if (id === 'mx') {
        // --- México: LFT ---
        const sd = diario;
        const propAnio = mesesAnio / 12;
        const diasTabla = diasVacacionesMx(antiguedadAnios);
        const aniosEnteros = Math.floor(antiguedadAnios);

        const pendientes = sd * diasPend;
        const aguinaldo = sd * P.diasAguinaldo * propAnio;
        const vacaciones = sd * diasVac;
        const primaVac = vacaciones * (P.primaVacacionalPct / 100);

        // Prima de antigüedad: Art. 162 LFT (12 días por año, proporcional en las
        // fracciones) con la base topeada en 2 salarios mínimos de la zona (Art. 486).
        const smZona = String(v.zonaMx || 'general') === 'frontera' ? P.smDiarioFrontera : P.smDiario;
        const baseTope = Math.min(sd, smZona * 2);
        const primaAntig =
          motivo === 'despido' || antiguedadAnios >= 15 ? 12 * baseTope * antiguedadAnios : 0;

        const indemnizacion = motivo === 'despido' ? sd * 90 + sd * 20 * aniosEnteros : 0;

        devengado = pendientes + aguinaldo + vacaciones + primaVac;
        ruptura = indemnizacion + primaAntig;

        const bruto = devengado + ruptura;
        // Exención Art. 93 LISR: 90 UMA por año de servicio sobre la indemnización.
        const exento = Math.min(indemnizacion, P.exentoSeparacionUmas * P.umaDiaria * Math.max(1, aniosEnteros));
        const gravable = Math.max(0, bruto - exento - primaAntig);
        descuentos = gravable * P.isrEfectivoEstimado;

        rows.push({ k: 'Salario diario base', ref: 'Sueldo mensual ÷ 30', v: sd });
        rows.push({ k: 'Días de vacaciones que te corresponden', ref: 'Art. 76 LFT', v: diasTabla, format: 'unit', unit: 'días', decimals: 0 });
        rows.push({ k: 'Salarios devengados y no pagados', ref: diasPend + ' días', v: pendientes });
        rows.push({ k: 'Aguinaldo proporcional', ref: 'Art. 87 LFT · 15 días', v: aguinaldo });
        rows.push({ k: 'Vacaciones pendientes', ref: diasVac + ' días', v: vacaciones });
        rows.push({ k: 'Prima vacacional', ref: 'Art. 80 LFT · 25%', v: primaVac });
        if (primaAntig > 0) rows.push({ k: 'Prima de antigüedad', ref: 'Art. 162 LFT · 12 días por año · tope 2 SM (' + money(smZona * 2, P, 2) + ' diarios)', v: primaAntig });
        if (indemnizacion > 0) rows.push({ k: 'Indemnización (3 meses + 20 días por año)', ref: 'Arts. 48 y 50 LFT', v: indemnizacion, extra: true });
        rows.push({ k: 'ISR estimado (se resta)', ref: 'Exento hasta 90 UMA por año', v: descuentos });
        nota =
          motivo === 'despido'
            ? 'Liquidación por despido injustificado'
            : 'Finiquito: sin conceptos indemnizatorios';
      } else if (id === 'co') {
        // --- Colombia: CST ---
        const conAuxilio = sueldo > 0 && sueldo <= P.smlmv * 2;
        const base = sueldo + (conAuxilio ? P.auxilioTransporte : 0);
        const diasAnio = mesesAnio * 30;
        const diasSem = mesesSem * 30;

        const cesantias = (base * diasAnio) / 360;
        const intereses = (cesantias * P.interesCesantias * diasAnio) / 360;
        const prima = (base * diasSem) / 360;
        const vacaciones = diario * diasVac;
        const pendientes = diario * diasPend;

        devengado = cesantias + intereses + prima + vacaciones + pendientes;
        ruptura = 0;

        rows.push({ k: 'Base de liquidación', ref: conAuxilio ? 'Salario + auxilio de transporte' : 'Salario (supera 2 SMLMV)', v: base });
        rows.push({ k: 'Salarios devengados y no pagados', ref: diasPend + ' días', v: pendientes });
        rows.push({ k: 'Cesantías', ref: 'Art. 249 CST · ' + diasAnio + '/360', v: cesantias });
        rows.push({ k: 'Intereses sobre cesantías', ref: 'Ley 52/1975 · 12% anual', v: intereses });
        rows.push({ k: 'Prima de servicios del semestre', ref: 'Art. 306 CST · ' + diasSem + '/360', v: prima });
        rows.push({ k: 'Vacaciones pendientes', ref: diasVac + ' días', v: vacaciones });
        nota = 'No incluye la indemnización del Art. 64 CST';
      } else if (id === 'pe') {
        // --- Perú: CTS y gratificación ---
        const rem = sueldo;
        const sexto = rem / 6;
        const baseCts = rem + sexto;
        const cts = (baseCts / 12) * mesesSem;
        const grati = (rem / 6) * mesesSem;
        const bonif = grati * P.bonificacionExtraordinaria;
        const vacaciones = diario * diasVac;
        const pendientes = diario * diasPend;

        devengado = cts + grati + bonif + vacaciones + pendientes;
        ruptura = 0;

        rows.push({ k: 'Base de cálculo de la CTS', ref: 'Remuneración + 1/6 de gratificación', v: baseCts });
        rows.push({ k: 'Remuneraciones devengadas', ref: diasPend + ' días', v: pendientes });
        rows.push({ k: 'CTS trunca del semestre', ref: 'D.S. 001-97-TR · ' + mesesSem + ' meses', v: cts });
        rows.push({ k: 'Gratificación trunca', ref: 'Ley 27735 · ' + mesesSem + '/6', v: grati });
        rows.push({ k: 'Bonificación extraordinaria', ref: 'Ley 29351 · 9%', v: bonif });
        rows.push({ k: 'Vacaciones truncas', ref: diasVac + ' días', v: vacaciones });
        nota = 'La CTS y la gratificación no sufren descuentos de AFP, ONP ni EsSalud';
      } else if (id === 'cl') {
        // --- Chile: Código del Trabajo ---
        const aniosBrutos = meses > 6 ? anios + 1 : anios;
        const aniosComp = Math.min(aniosBrutos, P.topeAnios);
        const topeado = aniosBrutos > P.topeAnios;

        const ias = motivo === 'despido' ? sueldo * aniosComp : 0;
        const sustitutiva = motivo === 'despido' && !conAviso ? sueldo : 0;
        // Feriado: los días hábiles pendientes se pagan en días corridos (factor 7/5).
        const feriado = diario * diasVac * P.factorFeriado;
        const pendientes = diario * diasPend;

        ruptura = ias + sustitutiva;
        devengado = feriado + pendientes;

        rows.push({ k: 'Años computables', ref: topeado ? 'Tope 11 años · Art. 163 CT' : 'Fracción > 6 meses = año entero', v: aniosComp, format: 'unit', unit: 'años', decimals: 0 });
        rows.push({ k: 'Remuneraciones devengadas', ref: diasPend + ' días', v: pendientes });
        if (ias > 0) rows.push({ k: 'Indemnización por años de servicio', ref: 'Art. 163 CT', v: ias, extra: true });
        if (sustitutiva > 0) rows.push({ k: 'Indemnización sustitutiva del aviso', ref: 'Art. 162 CT · 1 sueldo', v: sustitutiva });
        rows.push({ k: 'Feriado proporcional', ref: diasVac + ' días hábiles × 7/5', v: feriado });
        nota =
          motivo === 'despido'
            ? 'Despido por necesidades de la empresa (Art. 161 CT)'
            : 'Sin indemnización por años: sólo feriado y haberes';
      } else if (id === 'bo') {
        // --- Bolivia: LGT + DS 110 ---
        const antigMeses = anios * 12 + meses;
        const indem = antigMeses >= P.mesesMinimosIndemnizacion ? sueldo * antiguedadAnios : 0;
        const desahucio = motivo === 'despido' ? sueldo * P.desahucioSueldos : 0;
        const aguinaldo = (sueldo / 12) * mesesAnio;
        const vacaciones = diario * diasVac;
        const pendientes = diario * diasPend;

        ruptura = indem + desahucio;
        devengado = aguinaldo + vacaciones + pendientes;

        rows.push({ k: 'Antigüedad computable', ref: 'Sin tope desde el DS 110/2009', v: antiguedadAnios, format: 'unit', unit: 'años', decimals: 2 });
        rows.push({ k: 'Sueldos devengados y no pagados', ref: diasPend + ' días', v: pendientes });
        if (indem > 0) rows.push({ k: 'Indemnización por tiempo de servicio', ref: 'LGT · 1 sueldo por año', v: indem, extra: true });
        if (desahucio > 0) rows.push({ k: 'Desahucio', ref: 'Art. 12 LGT · 3 sueldos', v: desahucio });
        rows.push({ k: 'Aguinaldo proporcional', ref: mesesAnio + '/12', v: aguinaldo });
        rows.push({ k: 'Vacaciones pendientes', ref: diasVac + ' días', v: vacaciones });
        nota =
          motivo === 'despido'
            ? 'Despido sin causa: corresponde desahucio'
            : 'Sin desahucio: la indemnización se paga igual (DS 110/2009)';
      } else {
        // --- España: despido objetivo, Art. 52 y 53 ET ---
        const sd = (sueldo * 12) / 365;
        const diasBrutos = P.diasPorAnio * antiguedadAnios;
        const diasIndem = motivo === 'despido' ? Math.min(diasBrutos, P.topeDias) : 0;
        const topeado = motivo === 'despido' && diasBrutos > P.topeDias;

        const indem = sd * diasIndem;
        const preaviso = motivo === 'despido' && !conAviso ? sd * P.diasPreaviso : 0;
        const vacaciones = sd * diasVac;
        const pendientes = sd * diasPend;

        ruptura = indem + preaviso;
        devengado = vacaciones + pendientes;

        rows.push({ k: 'Salario diario', ref: 'Bruto anual ÷ 365', v: sd });
        rows.push({ k: 'Días de indemnización', ref: topeado ? 'Tope 12 mensualidades (360 días)' : '20 días por año', v: diasIndem, format: 'unit', unit: 'días', decimals: 0 });
        rows.push({ k: 'Salarios devengados', ref: diasPend + ' días', v: pendientes });
        if (indem > 0) rows.push({ k: 'Indemnización por despido objetivo', ref: 'Art. 53.1.b ET', v: indem, extra: true });
        if (preaviso > 0) rows.push({ k: 'Preaviso no dado', ref: 'Art. 53.1.c ET · 15 días', v: preaviso });
        rows.push({ k: 'Vacaciones no disfrutadas', ref: diasVac + ' días', v: vacaciones });
        nota =
          motivo === 'despido'
            ? topeado
              ? 'El tope de 12 mensualidades recorta la indemnización'
              : 'Despido objetivo dentro del tope legal'
            : 'Baja voluntaria: sin indemnización, sólo finiquito';
      }

      const bruto = ruptura + devengado;
      const total = Math.max(0, bruto - descuentos);

      rows.push({ k: 'Total a cobrar', ref: descuentos > 0 ? 'Bruto menos ISR estimado' : 'Suma de conceptos', v: total, extra: true });

      const chart = [
        { label: 'Por la ruptura', value: Math.round(ruptura), tone: 'main' },
        { label: 'Conceptos devengados', value: Math.round(devengado), tone: 'prop' },
      ];
      if (descuentos > 0) chart.push({ label: 'Impuesto estimado', value: Math.round(descuentos), tone: 'bad' });

      return {
        total: money(total, P, dec),
        sub:
          P.nombre + ' · importes en ' + P.moneda + ' · ' +
          antiguedadAnios.toFixed(1).replace('.', ',') + ' años de antigüedad · ' + nota,
        rows: rows,
        chart: chart.filter(function (s) { return s.value > 0; }),
        format: 'unit',
        unit: P.moneda,
        decimals: dec,
      };
    });
  })();
</script>
