---
/**
 * Hub de decisión — "Me voy del trabajo: ¿qué me tienen que pagar?" (MX, CO, PE, CL, BO, ES).
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * OJO con el audience: HubData sólo admite 'AR' | 'global'. Este hub cubre seis
 * mercados, así que va 'global' — no hay un país único al que apuntar el geo.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import LiquidacionLatamExperience from '../../components/generated/LiquidacionLatamExperience.astro';
import { hub, PAISES, MX_VACACIONES } from '../../lib/hubs/liquidacion-latam';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <LiquidacionLatamExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

