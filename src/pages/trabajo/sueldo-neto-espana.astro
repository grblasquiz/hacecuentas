---
/**
 * Hub de decisión — "¿Cuánto me queda neto en España?".
 * Reemplaza 3 URLs de calculadora suelta (ver hub.replaces).
 *
 * OJO: HubData sólo admite audience 'AR' | 'global'. El audience="ES" se pasa
 * acá, literal al Layout, igual que en sueldo-neto-mexico, para no perder el
 * geo targeting del mercado.
 *
 * OJO 2: define:vars serializa a JSON, así que los Infinity de las escalas
 * llegan como null. El compute los trata como "sin límite".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  TRAMOS_ESTATALES,
  TRAMOS_MADRID,
  TRAMOS_CATALUNA,
  TRAMOS_GENERALES,
  ES_PARAMS,
} from '../../lib/hubs/sueldo-neto-espana';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="ES"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    ESTATAL: TRAMOS_ESTATALES,
    MADRID: TRAMOS_MADRID,
    CATALUNA: TRAMOS_CATALUNA,
    GENERAL: TRAMOS_GENERALES,
    P: ES_PARAMS,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const eur = (n) => Math.round(n || 0).toLocaleString('es-AR') + ' €';

    /**
     * Escala progresiva. `limite` viene como null cuando el módulo declaraba
     * Infinity (JSON no lo serializa): se trata como sin tope.
     * Espejo de calcularTramos() en src/lib/formulas/irpf-madrid-2026.ts.
     */
    function escala(base, tramos) {
      if (!(base > 0)) return 0;
      let impuesto = 0;
      let prev = 0;
      for (const par of tramos) {
        const limite = par[0] == null ? Infinity : par[0];
        const tasa = par[1];
        if (base > prev) {
          impuesto += (Math.min(base, limite) - prev) * tasa;
          prev = limite;
          if (base <= limite) break;
        }
      }
      return impuesto;
    }

    function cuotaAutonomoMensual(facturacion, tarifaPlana) {
      if (tarifaPlana) return P.tarifaPlanaMensual;
      for (const par of P.cuotaPorFacturacion) {
        const limite = par[0] == null ? Infinity : par[0];
        if (facturacion < limite) return par[1];
      }
      return P.cuotaPorFacturacion[P.cuotaPorFacturacion.length - 1][1];
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'madrid';
      const bruto = Math.max(0, v.bruto || 0);
      const pagas = Number(v.pagas) === 12 ? 12 : 14;
      const minimo = Math.max(0, v.minimo || 0);
      const ssManual = Math.max(0, v.ss || 0);
      const gastos = Math.max(0, v.gastos || 0);
      const tarifaPlana = String(v.tarifaPlana || 'no') === 'si';

      const rows = [];
      let neto = 0;
      let chart = [];
      let sub = '';

      if (id === 'autonomo') {
        const cuotaMensual = cuotaAutonomoMensual(bruto, tarifaPlana);
        const cuotaAnual = cuotaMensual * 12;
        const base = bruto - gastos - cuotaAnual;
        const irpf = escala(base, GENERAL);
        neto = bruto - gastos - cuotaAnual - irpf;

        const presion = bruto > 0 ? ((cuotaAnual + irpf) / bruto) * 100 : 0;

        rows.push({ k: 'Facturación anual sin IVA', ref: 'Base del cálculo', v: bruto });
        rows.push({ k: 'Gastos deducibles (se restan)', ref: 'Gasto de la actividad', v: gastos });
        rows.push({ k: 'Cuota de autónomos', ref: eur(cuotaMensual) + ' al mes' + (tarifaPlana ? ' · tarifa plana' : ''), v: cuotaAnual });
        rows.push({ k: 'Rendimiento neto', ref: 'Facturación − gastos − cuota', v: Math.max(0, base) });
        rows.push({ k: 'IRPF (se resta)', ref: 'Escala general 19% a 45%', v: irpf });
        rows.push({ k: 'Neto anual', ref: 'Lo que te queda', v: neto, extra: true });
        rows.push({ k: 'Neto mensual', ref: 'Neto anual ÷ 12', v: neto / 12 });
        rows.push({ k: 'Presión fiscal', ref: '(cuota + IRPF) ÷ facturación', v: presion, format: 'unit', unit: '%', decimals: 1 });

        chart = [
          { label: 'Neto para vos', value: Math.round(Math.max(0, neto)), tone: 'main' },
          { label: 'Gastos deducibles', value: Math.round(gastos), tone: 'prop' },
          { label: 'Cuota de autónomos', value: Math.round(cuotaAnual), tone: 'warn' },
          { label: 'IRPF', value: Math.round(irpf), tone: 'bad' },
        ];
        sub =
          'De ' + eur(bruto) + ' facturados te quedan ' + eur(neto) + ' netos (' + eur(neto / 12) +
          ' al mes) · entre cuota e IRPF se va el ' + presion.toFixed(1).replace('.', ',') + '%';
      } else {
        const autonomica = id === 'cataluna' ? CATALUNA : MADRID;
        const nombre = id === 'cataluna' ? 'Cataluña' : 'Madrid';

        const ss = ssManual > 0 ? ssManual : Math.min(bruto * P.ssTrabajadorPct, P.ssTopeAnual);
        const base = Math.max(0, bruto - ss - minimo);
        const estatal = escala(base, ESTATAL);
        const auto = escala(base, autonomica);
        const irpf = estatal + auto;
        neto = bruto - ss - irpf;
        const efectivo = bruto > 0 ? (irpf / bruto) * 100 : 0;

        rows.push({ k: 'Bruto anual', ref: 'Base del cálculo', v: bruto });
        rows.push({ k: 'Cotización a la Seguridad Social (se resta)', ref: ssManual > 0 ? 'Valor que cargaste' : '6,35% con tope', v: ss });
        rows.push({ k: 'Mínimo personal y familiar (se resta)', ref: 'Reduce la base', v: minimo });
        rows.push({ k: 'Base imponible', ref: 'Bruto − cotización − mínimo', v: base });
        rows.push({ k: 'Cuota estatal', ref: 'Escala común a toda España', v: estatal });
        rows.push({ k: 'Cuota autonómica de ' + nombre, ref: 'Escala de la comunidad', v: auto });
        rows.push({ k: 'IRPF total (se resta)', ref: 'Estatal + autonómica', v: irpf });
        rows.push({ k: 'Neto anual', ref: 'Lo que te queda', v: neto, extra: true });
        rows.push({ k: 'Neto por paga', ref: pagas + ' pagas al año', v: neto / pagas });
        rows.push({ k: 'Tipo efectivo', ref: 'IRPF ÷ bruto', v: efectivo, format: 'unit', unit: '%', decimals: 2 });

        chart = [
          { label: 'Neto en mano', value: Math.round(Math.max(0, neto)), tone: 'main' },
          { label: 'IRPF', value: Math.round(irpf), tone: 'bad' },
          { label: 'Seguridad Social', value: Math.round(ss), tone: 'prop' },
        ];
        sub =
          nombre + ' · de ' + eur(bruto) + ' brutos pagás ' + eur(irpf) + ' de IRPF (tipo efectivo ' +
          efectivo.toFixed(2).replace('.', ',') + '%) · te quedan ' + eur(neto / pagas) + ' por paga en ' + pagas + ' pagas';
      }

      return {
        total: eur(neto),
        sub: sub,
        rows: rows,
        chart: chart.filter(function (s) { return s.value > 0; }),
        format: 'unit',
        unit: '€',
        decimals: 0,
      };
    });
  })();
</script>
