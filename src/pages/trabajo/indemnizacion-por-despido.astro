---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import IndemnizacionExperience from '../../components/IndemnizacionExperience.astro';
import DecisionRelatedLinks from '../../components/DecisionRelatedLinks.astro';
import TopPagesBoost from '../../components/TopPagesBoost.astro';
import { hub, CASE_MATH } from '../../lib/hubs/indemnizacion-por-despido';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
    {
      '@type': 'WebApplication',
      name: hub.title,
      description: hub.description,
      url: CANONICAL,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      dateModified: hub.lastReviewed,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'ARS' },
    },
  ],
};
---

<Layout title={hub.title} description={hub.description} canonical={CANONICAL} schema={schema} audience={hub.audience} lang="es" ogType="article" articleSection={hub.silo}>
  <Header />
  <IndemnizacionExperience data={hub} caseMath={CASE_MATH} />
  <DecisionRelatedLinks items={[
    { href: '/trabajo/liquidacion-final', title: 'Liquidación final', description: 'Revisá qué conceptos entran al cerrar una relación laboral.', icon: '🧾' },
    { href: '/trabajo/sueldo-bruto-y-neto', title: 'Sueldo bruto y neto', description: 'Entendé cuánto llega a tu cuenta después de descuentos.', icon: '💵' },
    { href: '/trabajo/aguinaldo', title: 'Aguinaldo', description: 'Calculá el SAC y el proporcional que corresponde.', icon: '📅' },
  ]} />
  <TopPagesBoost variant="severance" />
  <Footer />
</Layout>
