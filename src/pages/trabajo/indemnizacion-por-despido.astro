---
/**
 * Hub de decisión #3 — "Me despiden: ¿cuánto me tienen que pagar?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * PATRÓN DE REFERENCIA para los otros hubs: la página sólo aporta los datos
 * (src/lib/hubs/<slug>.ts) y su compute(). Todo el chrome, el CSS y el runtime
 * viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, CASE_MATH } from '../../lib/hubs/indemnizacion-por-despido';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MATH: CASE_MATH }}>
  (function () {
    const H = window.HC_HUB;

    H.onCompute(function (v, kase) {
      const m = MATH[kase?.id] || { factor: 1, extra: 0 };
      const sueldo = v.sueldo, anios = v.anios, meses = v.meses, dia = v.dia || 1;
      const totalMeses = anios * 12 + meses;

      // Fracción mayor a 3 meses cuenta como año entero (Art. 245).
      const computables = anios + (meses > 3 ? 1 : 0);
      // Art. 231: 1 mes hasta 5 años INCLUSIVE; 2 meses recién pasados los 5 años.
      const mesesPreaviso = totalMeses > 60 ? 2 : 1;

      // Base del Art. 245: tope de convenio con el piso del 67% del fallo Vizzoti.
      // Espejo de src/lib/formulas/indemnizacion.ts.
      const tope = Math.max(0, Number(v.tope) || 0);
      let base = sueldo, vizzoti = false;
      if (tope > 0) {
        const piso = sueldo * 0.67;
        if (tope < piso) { base = piso; vizzoti = true; } else { base = tope; }
      }

      const antiguedad = base * computables * m.factor;
      const preaviso = sueldo * mesesPreaviso;
      const sacPreaviso = preaviso / 12;
      const integracion = (sueldo / 30) * Math.max(0, 30 - dia);
      const sacIntegracion = integracion / 12;
      const sacProp = (sueldo / 2) * (3 / 6);
      // Días de vacaciones según antigüedad total (Art. 150), proporcional medio año (Art. 156).
      const diasVacAnual = totalMeses <= 60 ? 14 : totalMeses <= 120 ? 21 : totalMeses <= 240 ? 28 : 35;
      const vacaciones = (sueldo / 25) * (diasVacAnual / 2);
      const sacVac = vacaciones / 12;
      const agravada = sueldo * m.extra;

      const rows = [];
      if (m.factor > 0) rows.push({ k: 'Indemnización por antigüedad', ref: 'Art. 245', v: antiguedad });
      rows.push({ k: 'Preaviso (' + mesesPreaviso + (mesesPreaviso > 1 ? ' meses)' : ' mes)'), ref: 'Art. 232', v: preaviso });
      rows.push({ k: 'SAC sobre preaviso', ref: 'Art. 123', v: sacPreaviso });
      rows.push({ k: 'Integración mes de despido', ref: 'Art. 233', v: integracion });
      rows.push({ k: 'SAC sobre integración', ref: 'Art. 123', v: sacIntegracion });
      rows.push({ k: 'Aguinaldo proporcional', ref: 'Art. 121', v: sacProp });
      rows.push({ k: 'Vacaciones no gozadas', ref: 'Art. 156', v: vacaciones });
      rows.push({ k: 'SAC sobre vacaciones', ref: 'Art. 123', v: sacVac });
      if (agravada > 0) rows.push({ k: 'Indemnización agravada (13 sueldos)', ref: 'Art. 182', v: agravada, extra: true });

      const total = rows.reduce((a, r) => a + r.v, 0);
      const principal = antiguedad + agravada;
      const salida = preaviso + sacPreaviso + integracion + sacIntegracion;

      return {
        total: H.ars(total),
        sub:
          computables + ' años computables · mejor sueldo ' + H.ars(sueldo) +
          (tope > 0
            ? (vizzoti
                ? ' · base Art. 245 ' + H.ars(base) + ' (piso 67%, Vizzoti)'
                : ' · base Art. 245 topeada en ' + H.ars(base))
            : '') +
          (m.factor === 0.5 ? ' · antigüedad al 50% por Art. 247' : ''),
        rows: rows,
        chart: [
          { label: 'Indemnización principal', value: principal, tone: 'main' },
          { label: 'Preaviso y salida', value: salida, tone: 'exit' },
          { label: 'Proporcionales', value: Math.max(0, total - principal - salida), tone: 'prop' },
        ],
      };
    });
  })();
</script>
