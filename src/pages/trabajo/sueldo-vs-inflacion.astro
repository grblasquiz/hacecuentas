---
/**
 * Hub de decisión — "¿Mi sueldo le gana a la inflación?"
 * Reemplaza 12 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/sueldo-alcanza.ts) y su
 * compute(). El chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * El IPC, el SMVM, el RIPTE y las cotizaciones viajan al cliente en DATA, que
 * el módulo del hub arma leyendo las fuentes vivas. Nada hardcodeado acá.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import SueldoVsInflacionExperience from '../../components/generated/SueldoVsInflacionExperience.astro';
import { hub, SUELDO_DATA } from '../../lib/hubs/sueldo-alcanza';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoVsInflacionExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

