---
/**
 * Hub de decisión — "¿Cuánto me queda en mano del sueldo bruto?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Patrón: la página sólo aporta los datos (src/lib/hubs/<slug>.ts) y su
 * compute(). El chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * Los parámetros del cálculo NO se hardcodean acá: se importan de los módulos
 * reales del repo (tope de la base imponible, escala y deducciones de Ganancias,
 * cuotas de monotributo) y se serializan al script con define:vars.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SueldoBrutoNetoExperience from '../../components/SueldoBrutoNetoExperience.astro';
import { hub } from '../../lib/hubs/sueldo-bruto-y-neto';
import { BASE_IMPONIBLE_MAXIMA_APORTES } from '../../lib/formulas/sueldo-ar';
import {
  ESCALA,
  MNI_MENSUAL_BASE,
  INCREMENTO_CONYUGE_MENSUAL,
  INCREMENTO_HIJO_MENSUAL,
} from '../../lib/formulas/_ganancias-escala';
import { CUOTA_SERVICIOS } from '../../lib/data/monotributo-2026';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

/** Constantes reales del repo, serializables (Infinity no sobrevive a JSON). */
const PARAMS = {
  topeAportes: BASE_IMPONIBLE_MAXIMA_APORTES,
  mni: MNI_MENSUAL_BASE,
  conyuge: INCREMENTO_CONYUGE_MENSUAL,
  hijo: INCREMENTO_HIJO_MENSUAL,
  escala: ESCALA.map((t) => ({
    hasta: Number.isFinite(t.hasta) ? t.hasta : null,
    tasa: t.tasa,
    acumulado: t.acumulado,
  })),
  cuotaMonotributo: CUOTA_SERVICIOS,
  // Contribuciones patronales estimadas (Dec. 814/01 + OS ley 23.660), sin ART.
  contribPatronal: 0.264,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
    { '@type': 'WebApplication', name: hub.title, url: CANONICAL, applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'ARS' } },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoBrutoNetoExperience data={hub} params={PARAMS} />
  <Footer />
</Layout>
