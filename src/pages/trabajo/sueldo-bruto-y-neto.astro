---
/**
 * Hub de decisión — "¿Cuánto me queda en mano del sueldo bruto?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Patrón: la página sólo aporta los datos (src/lib/hubs/<slug>.ts) y su
 * compute(). El chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * Los parámetros del cálculo NO se hardcodean acá: se importan de los módulos
 * reales del repo (tope de la base imponible, escala y deducciones de Ganancias,
 * cuotas de monotributo) y se serializan al script con define:vars.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/sueldo-bruto-y-neto';
import { BASE_IMPONIBLE_MAXIMA_APORTES } from '../../lib/formulas/sueldo-ar';
import {
  ESCALA,
  MNI_MENSUAL_BASE,
  INCREMENTO_CONYUGE_MENSUAL,
  INCREMENTO_HIJO_MENSUAL,
} from '../../lib/formulas/_ganancias-escala';
import { CUOTA_SERVICIOS } from '../../lib/data/monotributo-2026';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

/** Constantes reales del repo, serializables (Infinity no sobrevive a JSON). */
const PARAMS = {
  topeAportes: BASE_IMPONIBLE_MAXIMA_APORTES,
  mni: MNI_MENSUAL_BASE,
  conyuge: INCREMENTO_CONYUGE_MENSUAL,
  hijo: INCREMENTO_HIJO_MENSUAL,
  escala: ESCALA.map((t) => ({
    hasta: Number.isFinite(t.hasta) ? t.hasta : null,
    tasa: t.tasa,
    acumulado: t.acumulado,
  })),
  cuotaMonotributo: CUOTA_SERVICIOS,
  // Contribuciones patronales estimadas (Dec. 814/01 + OS ley 23.660), sin ART.
  contribPatronal: 0.264,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ P: PARAMS }}>
  (function () {
    const H = window.HC_HUB;

    /** Escala mensual de Ganancias (art. 94 LIG). `hasta: null` = último tramo. */
    function impuesto(base) {
      if (base <= 0) return 0;
      let previo = 0;
      for (let i = 0; i < P.escala.length; i++) {
        const t = P.escala[i];
        const tope = t.hasta === null ? Infinity : t.hasta;
        if (base <= tope) return t.acumulado + (base - previo) * t.tasa;
        previo = tope;
      }
      return 0;
    }

    /** Núcleo bruto → neto. Monótono creciente: sirve para la búsqueda inversa. */
    function desglose(bruto, conyuge, hijos, sindPct) {
      const baseAportes = Math.min(bruto, P.topeAportes);
      const jubilacion = baseAportes * 0.11;
      const obraSocial = baseAportes * 0.03;
      const pami = baseAportes * 0.03;
      const aportes = jubilacion + obraSocial + pami;
      const sindicato = bruto * (sindPct / 100);

      const mni = P.mni + (conyuge ? P.conyuge : 0) + hijos * P.hijo;
      // La cuota sindical es deducible de la base de retención (RG 4003, anexo II,
      // "aportes a sindicatos"), así que sale antes de aplicar la escala.
      const ganancias = impuesto(Math.max(0, bruto - aportes - sindicato - mni));

      const descuentos = aportes + sindicato + ganancias;
      return {
        bruto: bruto,
        jubilacion: jubilacion,
        obraSocial: obraSocial,
        pami: pami,
        sindicato: sindicato,
        aportes: aportes,
        ganancias: ganancias,
        descuentos: descuentos,
        neto: bruto - descuentos,
        topeAplicado: bruto > P.topeAportes,
      };
    }

    /** Inverso: qué bruto deja el neto objetivo (convergencia $100). */
    function desdeNeto(objetivo, conyuge, hijos, sindPct) {
      let lo = objetivo, hi = objetivo * 2, guard = 0;
      while (desglose(hi, conyuge, hijos, sindPct).neto < objetivo && guard < 40) { hi *= 2; guard++; }
      let mid = hi;
      for (let i = 0; i < 60; i++) {
        mid = (lo + hi) / 2;
        const n = desglose(mid, conyuge, hijos, sindPct).neto;
        if (Math.abs(n - objetivo) <= 100) break;
        if (n < objetivo) lo = mid; else hi = mid;
        if (hi - lo <= 1) break;
      }
      return desglose(Math.round(mid), conyuge, hijos, sindPct);
    }

    /** Días de vacaciones por antigüedad (LCT art. 150). */
    function diasVacaciones(anios) {
      if (anios >= 20) return 35;
      if (anios >= 10) return 28;
      if (anios >= 5) return 21;
      return 14;
    }

    /** Barra partida: bolsillo + cada descuento. */
    function barra(d) {
      const segs = [{ label: 'A tu bolsillo', value: Math.max(0, d.neto), tone: 'main' }];
      if (d.jubilacion > 0) segs.push({ label: 'Jubilación (11%)', value: d.jubilacion, tone: 'exit' });
      if (d.pami > 0) segs.push({ label: 'PAMI (3%)', value: d.pami, tone: 'prop' });
      if (d.obraSocial > 0) segs.push({ label: 'Obra social (3%)', value: d.obraSocial, tone: 'good' });
      if (d.sindicato > 0) segs.push({ label: 'Sindicato', value: d.sindicato, tone: 'prop' });
      if (d.ganancias > 0) segs.push({ label: 'Ganancias', value: d.ganancias, tone: 'warn' });
      return segs;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'bruto-a-neto';
      const conyuge = String(v.conyuge) === 'si';
      const hijos = Math.max(0, v.hijos || 0);
      const sind = Math.max(0, v.sindicato || 0);

      // --- Monotributista / autónomo -------------------------------------
      if (id === 'autonomo') {
        const facturacion = v.bruto || 0;
        const cat = String(v.categoria || 'D').toUpperCase();
        const cuota = P.cuotaMonotributo[cat] || P.cuotaMonotributo.D;
        const iibb = facturacion * (Math.max(0, v.iibb || 0) / 100);
        const gastos = 15000;
        const neto = facturacion - cuota - iibb - gastos;
        const pct = facturacion ? (neto / facturacion) * 100 : 0;

        return {
          total: H.ars(Math.max(0, neto)),
          sub:
            'Categoría ' + cat + ' · te queda el ' + pct.toFixed(1) + '% de lo que facturás · ' +
            'sin aguinaldo, vacaciones pagas ni indemnización',
          rows: [
            { k: 'Facturación mensual', ref: 'bruto', v: facturacion },
            { k: 'Cuota de monotributo (cat. ' + cat + ')', ref: 'integrado + SIPA + obra social', v: -cuota },
            { k: 'Ingresos Brutos', ref: 'provincial', v: -iibb },
            { k: 'Gastos fijos estimados', ref: 'contador, banco', v: -gastos },
            { k: 'Neto en el bolsillo', ref: 'estimado', v: Math.max(0, neto), extra: true },
          ],
          chart: [
            { label: 'A tu bolsillo', value: Math.max(0, neto), tone: 'main' },
            { label: 'Monotributo', value: cuota, tone: 'exit' },
            { label: 'Ingresos Brutos', value: iibb, tone: 'warn' },
            { label: 'Gastos fijos', value: gastos, tone: 'prop' },
          ],
        };
      }

      // --- Neto → bruto ---------------------------------------------------
      if (id === 'neto-a-bruto') {
        const objetivo = v.neto || 0;
        const d = desdeNeto(objetivo, conyuge, hijos, sind);
        return {
          total: H.ars(d.bruto),
          sub:
            'Bruto necesario para cobrar ' + H.ars(objetivo) + ' en mano · ' +
            'descuento total del ' + ((d.descuentos / d.bruto) * 100).toFixed(1) + '%' +
            (d.topeAplicado ? ' · aportes topeados' : ''),
          rows: [
            { k: 'Sueldo bruto necesario', ref: 'resultado', v: d.bruto, extra: true },
            { k: 'Jubilación (SIPA 11%)', ref: 'Ley 24.241 art. 11', v: d.jubilacion },
            { k: 'INSSJP–PAMI (3%)', ref: 'Ley 19.032', v: d.pami },
            { k: 'Obra social (3%)', ref: 'Ley 23.660', v: d.obraSocial },
            { k: 'Cuota sindical', ref: 'convenio', v: d.sindicato },
            { k: 'Impuesto a las Ganancias', ref: 'Art. 94 LIG', v: d.ganancias },
            { k: 'Neto en mano', ref: 'objetivo', v: d.neto },
          ],
          chart: barra(d),
        };
      }

      // --- Recibo completo -------------------------------------------------
      const d = desglose(v.bruto || 0, conyuge, hijos, sind);

      if (id === 'recibo') {
        const dias = diasVacaciones(v.antiguedad || 0);
        const valorDia = d.bruto / 25;
        const vacaciones = valorDia * dias;
        const sac = d.bruto / 2;
        const contrib = d.bruto * P.contribPatronal;
        return {
          total: H.ars(Math.max(0, d.neto)),
          sub:
            'Neto del mes · aguinaldo devengado ' + H.ars(sac) + ' en bruto · ' +
            dias + ' días de vacaciones (' + H.ars(vacaciones) + ') · ' +
            'costo para el empleador ' + H.ars(d.bruto + contrib),
          rows: [
            { k: 'Sueldo bruto', ref: 'remunerativo', v: d.bruto },
            { k: 'Jubilación (SIPA 11%)', ref: 'Ley 24.241 art. 11', v: d.jubilacion },
            { k: 'INSSJP–PAMI (3%)', ref: 'Ley 19.032', v: d.pami },
            { k: 'Obra social (3%)', ref: 'Ley 23.660', v: d.obraSocial },
            { k: 'Cuota sindical', ref: 'convenio', v: d.sindicato },
            { k: 'Impuesto a las Ganancias', ref: 'Art. 94 LIG', v: d.ganancias },
            { k: 'Neto en mano', ref: 'a cobrar', v: Math.max(0, d.neto), extra: true },
            { k: 'Aguinaldo devengado (SAC), en bruto', ref: 'LCT art. 121 · antes de aportes', v: sac },
            { k: 'Vacaciones: ' + dias + ' días a ' + H.ars(valorDia), ref: 'LCT arts. 150 y 155', v: vacaciones },
            { k: 'Contribuciones patronales (est.)', ref: 'Dec. 814/01, sin ART', v: contrib },
          ],
          chart: barra(d),
        };
      }

      // --- Bruto → neto (default) -----------------------------------------
      return {
        total: H.ars(Math.max(0, d.neto)),
        sub:
          'De un bruto de ' + H.ars(d.bruto) + ' se descuenta el ' +
          (d.bruto ? ((d.descuentos / d.bruto) * 100).toFixed(1) : '0') + '%' +
          (d.topeAplicado ? ' · aportes topeados en ' + H.ars(P.topeAportes) : '') +
          (d.ganancias > 0 ? '' : ' · no pagás Ganancias con tu situación familiar'),
        rows: [
          { k: 'Sueldo bruto', ref: 'punto de partida', v: d.bruto },
          { k: 'Jubilación (SIPA 11%)', ref: 'Ley 24.241 art. 11', v: d.jubilacion },
          { k: 'INSSJP–PAMI (3%)', ref: 'Ley 19.032', v: d.pami },
          { k: 'Obra social (3%)', ref: 'Ley 23.660', v: d.obraSocial },
          { k: 'Cuota sindical', ref: 'convenio', v: d.sindicato },
          { k: 'Impuesto a las Ganancias', ref: 'Art. 94 LIG', v: d.ganancias },
          { k: 'Neto en mano', ref: 'a cobrar', v: Math.max(0, d.neto), extra: true },
        ],
        chart: barra(d),
      };
    });
  })();
</script>
