---
/**
 * Silo Trabajo — índice de hubs de decisión.
 * Existe para que el breadcrumb de los hubs no apunte a un 404 y para repartir
 * link equity entre hermanos. El listado sale del registry, no a mano.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SiloIndex from '../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../lib/hubs/registry';

const HREF = '/trabajo';
const SILO = 'Trabajo';
const LEDE = 'Lo que cobrás, lo que te descuentan y lo que te corresponde cuando el trabajo empieza, cambia o termina.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: SILO,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title={`${SILO} — calculadoras y guías | Hacé Cuentas`}
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  lang="es"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
