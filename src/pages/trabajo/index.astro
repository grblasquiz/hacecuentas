---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TrabajoHomeExperience from '../../components/generated/TrabajoHomeExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
const canonical='https://hacecuentas.com/trabajo';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Trabajo",url:canonical,operatingSystem:'Web'};
---
<Layout title="Trabajo | Hacé Cuentas" description="Trabajo. Herramienta clara, gratuita y actualizada." canonical={canonical} schema={schema} lang="es">
  <Header />
  <TrabajoHomeExperience />
  <RecoveredHubIntro eyebrow="Trabajo" h1="Calculadoras de sueldo y trabajo" lede="Calculá haberes, aguinaldo, vacaciones, indemnizaciones y costos laborales con explicaciones claras." note="Elegí la situación que necesitás resolver y completá los datos solicitados." links={[{href:'/trabajo/sueldo-bruto-y-neto',title:'Sueldo bruto y neto',description:'Estimá descuentos y salario de bolsillo.'},{href:'/trabajo/aguinaldo',title:'Aguinaldo',description:'Calculá el SAC según tu mejor remuneración.'},{href:'/trabajo/liquidacion-final',title:'Liquidación final',description:'Revisá los conceptos de una desvinculación.'}]} />
  <Footer />
</Layout>
