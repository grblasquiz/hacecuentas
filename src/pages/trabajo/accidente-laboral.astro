---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InstitutionalMockupExperience from '../../components/InstitutionalMockupExperience.astro';
import NextTenBoost from '../../components/NextTenBoost.astro';
import { JOURNEYS } from '../../lib/institutional-journeys';

const data = JOURNEYS.accidente;
const canonical = `https://hacecuentas.com/${data.slug}`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: data.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: data.silo, item: `https://hacecuentas.com${data.siloHref}` },
        { '@type': 'ListItem', position: 3, name: data.h1, item: canonical },
      ],
    },
    {
      '@type': 'HowTo',
      name: 'Qué hacer después de un accidente laboral',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Avisá y dejá constancia' },
        { '@type': 'HowToStep', position: 2, name: 'Pedí el número de siniestro' },
        { '@type': 'HowToStep', position: 3, name: 'Guardá estudios y certificados' },
      ],
    },
    { '@type': 'WebPage', name: data.title, url: canonical, dateModified: '2026-08-04', inLanguage: 'es-AR' },
  ],
};
---

<Layout title={data.title} description={data.description} canonical={canonical} schema={schema} audience="AR" lang="es" ogType="article" articleSection={data.silo} pageType="hub">
  <Header />
  <InstitutionalMockupExperience data={data} kind="accidente" />
  <NextTenBoost variant="accident" />
  <Footer />
</Layout>
