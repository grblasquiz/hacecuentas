---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { FERIADOS_LATAM_2027 } from '../lib/data/feriados-latam-2027';

// Hub desambiguador para queries SIN país, versión 2027 (mismo racional que
// /feriados-2026: la query «feriados 2027» es ambigua y esta página rutea).
// Publicada temprano a propósito: la demanda «feriados <año siguiente>» arranca
// en septiembre-octubre y casi no tiene competencia con datos verificados.

const PAISES = ['argentina', 'mexico', 'colombia', 'chile', 'peru', 'ecuador']
  .map((k) => (FERIADOS_LATAM_2027 as Record<string, any>)[k])
  .filter(Boolean);

const title = 'Feriados 2027 por país: calendario oficial de LATAM';
const description =
  'Feriados 2027 de Argentina, México, Colombia, Chile, Perú y Ecuador en una sola tabla: cuántos días no laborables tiene cada país y el calendario completo con fechas confirmadas. Elegí tu país.';

function primero(p: any) {
  const lista = (p.feriados || []).filter((f: any) => f?.fecha);
  return lista[0] ?? null;
}

const faq = [
  {
    q: '¿Cuántos feriados hay en 2027 en cada país?',
    a: PAISES.map((p) => `${p.pais}: ${p.totalLabel}`).join('. ') + '.',
  },
  {
    q: '¿Estas fechas 2027 ya están confirmadas?',
    a: 'Las fechas fijadas por ley ya se conocen y son las que muestra cada calendario, con los traslados legales aplicados. Lo que puede sumarse más adelante son los feriados definidos por decreto anual (por ejemplo los feriados puente turísticos de Argentina, que se anuncian hacia fines de 2026). Actualizamos cada calendario cuando salen los decretos.',
  },
  {
    q: '¿Los feriados son iguales en toda Latinoamérica?',
    a: 'No. Cada país fija sus feriados por ley propia y sólo coinciden algunas fechas religiosas y el 1 de enero y el 1 de mayo. Las fiestas patrias, los traslados al lunes y los recargos por trabajar un feriado cambian por completo de un país a otro.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="hub">
    <h1>Feriados 2027 por país</h1>
    <p class="lead">
      Elegí tu país y mirá el calendario 2027 completo con las fechas confirmadas,
      el día de la semana y los fines de semana largos para planificar el año.
    </p>

    <table class="tabla">
      <thead>
        <tr>
          <th scope="col">País</th>
          <th scope="col">Feriados 2027</th>
          <th scope="col">Primero del año</th>
          <th scope="col">Calendario</th>
        </tr>
      </thead>
      <tbody>
        {PAISES.map((p) => {
          const n = primero(p);
          return (
            <tr>
              <th scope="row">{p.pais}</th>
              <td>{p.totalLabel}</td>
              <td>{n ? `${n.nombre} · ${n.fecha}` : '—'}</td>
              <td><a href={`/${p.slug}`}>Ver feriados de {p.pais} →</a></td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <h2>Preguntas frecuentes</h2>
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}

    <h2>¿Buscabas el año en curso?</h2>
    <ul class="links">
      <li><a href="/feriados-2026">Feriados 2026 por país</a> — el calendario vigente de este año.</li>
    </ul>

    <h2>Hacé algo con los feriados</h2>
    <ul class="links">
      <li><a href="/fechas/dias-entre-fechas">Días corridos y hábiles entre dos fechas</a></li>
      <li><a href="/trabajo/vacaciones">Armá tu puente óptimo</a> — decinos cuántos días de vacaciones tenés y te decimos cuándo pedirlos.</li>
      <li><a href="/fechas/cuenta-regresiva">Cuántos días faltan para una fecha</a></li>
    </ul>
  </main>
</Layout>

<style>
  .hub { max-width: 820px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  h1 { font-size: clamp(1.5rem, 4vw, 2.1rem); line-height: 1.2; margin: 0 0 .6rem; }
  .lead { color: var(--muted, #555); margin: 0 0 1.5rem; }
  h2 { font-size: 1.25rem; margin: 2rem 0 .75rem; }
  .tabla { width: 100%; border-collapse: collapse; font-size: .95rem; display: block; overflow-x: auto; }
  .tabla th, .tabla td { padding: .6rem .7rem; border-bottom: 1px solid var(--border, #e5e5e5); text-align: left; vertical-align: top; }
  .tabla thead th { font-weight: 600; white-space: nowrap; }
  .tabla tbody th { font-weight: 600; white-space: nowrap; }
  details { border-bottom: 1px solid var(--border, #e5e5e5); padding: .6rem 0; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin: .6rem 0 0; color: var(--muted, #555); }
  .links { padding-left: 1.1rem; }
  .links li { margin: .35rem 0; }
</style>
