---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/calc-flagship.css';

// Página-dato enlazable (autoridad) Colombia: salario mínimo, auxilio, UVT,
// jornada y recargos 2026. Patrón [[linkable-data-pages-strategy]]: Dataset +
// CC-BY + "Cómo citar" → backlink editorial. Datos: src/lib/data/colombia-2026.ts
// (SMLMV $1.750.905, auxilio $249.095, UVT $52.374) + CST/leyes citadas.

const ULTIMA_REVISION = '2026-07-31';
const PAGE_URL = 'https://hacecuentas.com/co/datos-salario-minimo-colombia-2026';

const valores = [
  { c: 'Salario mínimo (SMLMV)', v: '$1.750.905', n: 'Decreto transitorio 0159/2026' },
  { c: 'Salario mínimo diario', v: '$58.363,50', n: 'SMLMV ÷ 30' },
  { c: 'Auxilio de transporte', v: '$249.095', n: 'Decreto 1470/2025 · si ganás hasta 2 SMLMV' },
  { c: 'SMLMV + auxilio de transporte', v: '$2.000.000', n: 'el "mínimo" que se suele citar' },
  { c: 'UVT 2026', v: '$52.374', n: 'DIAN Resolución 000238/2025' },
  { c: 'Jornada laboral', v: '42 horas/semana', n: 'desde 15-jul-2026 (antes 44 h, Ley 2101/2021)' },
];

const title = 'Salario mínimo Colombia 2026: $1.750.905 y auxilio';
const description = 'Salario mínimo Colombia 2026: $1.750.905; con auxilio, $2.000.000. Consultá valor diario, por hora, UVT, jornada y recargos vigentes.';

const faq: Array<{ q: string; a: string; link?: { href: string; text: string } }> = [
  { q: '¿Cuál es el salario mínimo en Colombia 2026?', a: 'El salario mínimo legal mensual vigente (SMLMV) en 2026 es de $1.750.905. El Decreto 1469/2025 fijó inicialmente el monto y, tras su suspensión provisional, el Decreto 0159/2026 volvió a establecer el mismo valor de forma transitoria. Sumado al auxilio de transporte de $249.095, el total llega a $2.000.000 cuando corresponde ese auxilio.' },
  { q: '¿SMLMV, SMMLV y SMLV son lo mismo?', a: 'Sí: las tres siglas nombran el mismo valor, el salario mínimo legal mensual vigente de $1.750.905 en 2026. SMLMV es la forma completa (salario mínimo legal mensual vigente); SMMLV y SMLV son variantes de uso corriente en decretos, liquidaciones y contratos. Cuando una norma dice "2 SMMLV" o "2 SMLV" se refiere a $3.501.810.' },
  { q: '¿Cuánto es un SMMLV en pesos en 2026?', a: 'Un SMMLV equivale a $1.750.905 mensuales. Dos SMMLV son $3.501.810 y cuatro SMMLV, $7.003.620. El tope de $249.095 de auxilio de transporte se paga a quienes ganan hasta 2 SMMLV.' },
  { q: '¿Cuánto es el salario mínimo por hora en Colombia 2026?', a: 'Hasta el 14 de julio la hora ordinaria del salario mínimo vale $7.958,66 ($1.750.905 ÷ 220). Desde el 15 de julio, con la jornada máxima de 42 horas, pasa a $8.337,64 ($1.750.905 ÷ 210). Ese divisor legal es la base para calcular horas extra y recargos.' },
  { q: '¿Cuánto es el salario mínimo por día en Colombia 2026?', a: 'El salario mínimo diario 2026 es de $58.363,50, que resulta de dividir el SMLMV mensual de $1.750.905 entre 30 días. Es el valor antes de sumar el auxilio de transporte; con el auxilio proporcional, el día mínimo ronda los $66.666,67.' },
  { q: '¿Cuánto es el salario mínimo por quincena en 2026?', a: 'La quincena mínima 2026 es de $875.452,50, es decir la mitad del SMLMV mensual ($1.750.905 ÷ 2). Si además te corresponde el auxilio de transporte, se suma la mitad ($124.547,50) y la quincena llega a $1.000.000.' },
  { q: '¿A quién le corresponde el auxilio de transporte?', a: 'El auxilio de transporte ($249.095 en 2026) lo recibe quien gana hasta 2 SMLMV (es decir, hasta $3.501.810). No se recibe si el empleador pone el transporte. Si trabajaste menos de un mes completo, se paga proporcional a los días trabajados (÷30).', link: { href: '/co/calculadora-auxilio-transporte-colombia-2026', text: 'Calculá tu auxilio de transporte proporcional' } },
  { q: '¿El auxilio de transporte se suma al salario mínimo?', a: 'Sí, pero se paga por fuera del salario. El auxilio de $249.095 se suma al SMLMV de $1.750.905 para dar un ingreso mínimo de $2.000.000, siempre que ganes hasta 2 SMLMV. Cuenta como base para liquidar la prima de servicios y las cesantías, pero no para los aportes a salud y pensión, y no se paga si la empresa suministra el transporte.' },
  { q: '¿El salario mínimo aplica para trabajo de medio tiempo o por días?', a: 'Sí, de forma proporcional al tiempo trabajado. La hora ordinaria mínima vale $7.958,66 hasta el 14 de julio y $8.337,64 desde el 15 de julio de 2026; el día mínimo es $58.363,50. El auxilio de transporte también se reconoce proporcionalmente.' },
  { q: '¿Cuánto vale la UVT en 2026?', a: 'La UVT (Unidad de Valor Tributario) 2026 es de $52.374, según la Resolución DIAN 000238 de 2025. Se usa para topes de retención, sanciones y declaración de renta.' },
  { q: '¿Cuántas horas es la jornada laboral en 2026?', a: 'Desde el 15 de julio de 2026 la jornada máxima legal baja a 42 horas semanales (era 44 h antes), según el último escalón de la Ley 2101 de 2021. La hora ordinaria "sube" porque el sueldo se divide entre menos horas.' },
  { q: '¿Cuánto se paga de recargo nocturno y dominical?', a: 'El recargo nocturno es del 35% sobre la hora ordinaria. La hora extra diurna es +25% y la nocturna +75%. El recargo por dominical o festivo sube al 90% desde el 1 de julio de 2026 (Ley 2466/2025).' },
  { q: '¿Qué prestaciones recibe un trabajador?', a: 'Cesantías (1 mes de salario por año), intereses sobre cesantías (12% anual), prima de servicios (1 mes por año, pagada mitad en junio y mitad en diciembre) y vacaciones (15 días hábiles por año).' },
  { q: '¿De dónde salen estos datos?', a: 'De los decretos de salario mínimo y auxilio de transporte de MinTrabajo, las resoluciones de la DIAN para la UVT y el Código Sustantivo del Trabajo. Fuentes al final.' },
  { q: '¿Puedo usar esta tabla en mi web, nota o trabajo?', a: 'Sí. Los datos se publican bajo licencia CC-BY 4.0: podés reproducirlos citando la fuente con un enlace a hacecuentas.com. Más abajo está el bloque "Cómo citar".' },
];

const datasetSchema = {
  '@type': 'Dataset', '@id': `${PAGE_URL}#dataset`,
  name: 'Salario mínimo y prestaciones Colombia 2026',
  description: 'Salario mínimo legal mensual (SMLMV), auxilio de transporte, UVT, jornada laboral, recargos y prestaciones vigentes en Colombia en 2026.',
  url: PAGE_URL, license: 'https://creativecommons.org/licenses/by/4.0/', isAccessibleForFree: true,
  inLanguage: 'es-CO', dateModified: ULTIMA_REVISION, temporalCoverage: '2026',
  spatialCoverage: { '@type': 'Place', name: 'Colombia' },
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  keywords: ['salario mínimo Colombia 2026', 'SMLMV', 'auxilio de transporte', 'UVT', 'recargo nocturno', 'prestaciones', 'Colombia'],
  variableMeasured: ['Salario mínimo (COP)', 'Auxilio de transporte (COP)', 'UVT (COP)', 'Recargos (%)'],
  identifier: 'https://hacecuentas.com/datos/salario-minimo-colombia-2026.json', version: '2026',
  distribution: [
    { '@type': 'DataDownload', name: 'Salario mínimo Colombia 2026 (JSON)', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datos/salario-minimo-colombia-2026.json' },
    { '@type': 'DataDownload', name: 'Salario mínimo Colombia 2026 (CSV)', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datos/salario-minimo-colombia-2026.csv' },
  ],
};
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${PAGE_URL}#webpage`, name: title, description, url: PAGE_URL, inLanguage: 'es-CO', dateModified: ULTIMA_REVISION, mainEntity: { '@id': `${PAGE_URL}#dataset` } },
    datasetSchema,
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Colombia', item: 'https://hacecuentas.com/co' },
      { '@type': 'ListItem', position: 2, name: 'Salario mínimo 2026', item: PAGE_URL },
    ]},
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<Layout image="/og/data-datos-salario-minimo-colombia-2026.jpg" imageWidth={1200} imageHeight={675} title={title} description={description} canonical="/co/datos-salario-minimo-colombia-2026" audience="CO" lang="es-CO" schema={schema} domain="money">
  <Header slot="header" />
  <main class="cf-page smc" data-domain="money">

    <nav class="cf-crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li aria-hidden="true" class="cf-crumb__sep">›</li>
        <li><a href="/co">Colombia</a></li>
        <li aria-hidden="true" class="cf-crumb__sep">›</li>
        <li aria-current="page">Salario mínimo 2026</li>
      </ol>
    </nav>

    <header class="cf-hero">
      <div class="cf-hero__main">
        <p class="cf-kicker"><span aria-hidden="true">🇨🇴</span> Colombia · Datos 2026</p>
        <h1 class="cf-h1">Salario mínimo en Colombia <span class="cf-yr">2026</span></h1>
        <p class="cf-sub">Todos los valores que necesitás en un solo lugar: salario mensual, auxilio de transporte, valor por hora, UVT y recargos.</p>
        <ul class="cf-pills">
          <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Datos oficiales verificados</li>
          <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Actualizado en julio de 2026</li>
          <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Uso libre con atribución</li>
        </ul>
      </div>
      <div class="cf-hero__deco" aria-hidden="true">
        <div class="cf-deco-card">
          <div class="cf-deco-card__label">Salario mínimo mensual</div>
          <div class="cf-deco-card__value">$1.750.905</div>
          <div class="cf-deco-card__note">COP · vigente desde el 1 de enero</div>
        </div>
        <div class="cf-deco-sub"><strong>Con auxilio de transporte</strong> <span class="cf-deco-chip">$2.000.000 · +23%</span></div>
      </div>
    </header>

    <p class="smc-otropais">
      <span aria-hidden="true">🌎</span> ¿Buscabas el salario mínimo de <strong>otro país</strong>?
      Mirá la <a href="/datos-salario-minimo-latam-2026">tabla del salario mínimo 2026 en toda LATAM</a>
      (Argentina, México, Chile, Brasil, Perú y 6 más, con norma y vigencia).
    </p>

    <div class="cf-stats">
      <div class="cf-stat cf-stat--accent"><div class="cf-stat__label">Ingreso mínimo total</div><div class="cf-stat__value">$2.000.000</div><div class="cf-stat__sub">SMLMV + auxilio</div></div>
      <div class="cf-stat"><div class="cf-stat__label">Auxilio de transporte</div><div class="cf-stat__value">$249.095</div><div class="cf-stat__sub">hasta 2 SMLMV</div></div>
      <div class="cf-stat"><div class="cf-stat__label">Valor diario</div><div class="cf-stat__value">$58.363,50</div><div class="cf-stat__sub">SMLMV ÷ 30</div></div>
      <div class="cf-stat"><div class="cf-stat__label">UVT 2026</div><div class="cf-stat__value">$52.374</div><div class="cf-stat__sub">DIAN Res. 000238/2025</div></div>
    </div>

    <aside class="smc-legal" aria-label="Estado normativo del salario mínimo 2026">
      <strong>Estado normativo actualizado</strong>
      <p>El monto no cambió: sigue en <b>$1.750.905</b>. El Decreto 1469/2025 fue suspendido provisionalmente y el <a href="https://www.suin-juriscol.gov.co/viewDocument.asp?id=30056106" target="_blank" rel="noopener">Decreto 0159/2026</a> fijó transitoriamente el mismo valor mientras se decide el proceso de nulidad.</p>
    </aside>

    <!-- Así se compone -->
    <section class="cf-section">
      <p class="cf-eyebrow">La cifra, desglosada</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Así se compone el mínimo</h2>
      <div class="cf-2col">
        <div class="cf-breakdown">
          <div class="cf-breakdown__big">$2.000.000 <span style="font-size:0.9rem;font-weight:600;color:var(--text-subtle)">COP</span></div>
          <div class="cf-brow"><span class="cf-brow__lbl">Salario base (SMLMV)</span><span class="cf-brow__val">$1.750.905</span><span class="cf-brow__bar"><span style="width:87.5%"></span></span></div>
          <div class="cf-brow"><span class="cf-brow__lbl">Auxilio de transporte</span><span class="cf-brow__val">$249.095</span><span class="cf-brow__bar"><span style="width:12.5%"></span></span></div>
          <div class="cf-breakdown__total"><span>Ingreso mensual mínimo con auxilio</span><strong>$2.000.000</strong></div>
        </div>
        <div class="cf-cards" style="align-content:start">
          <div class="cf-minicard"><span class="cf-minicard__ico" aria-hidden="true">⏱️</span><p class="cf-minicard__title">Por hora ordinaria</p><div class="cf-minicard__big">$8.337,64</div><p class="cf-minicard__sub">Jornada de 42 h (SMLMV ÷ 210)</p></div>
          <div class="cf-minicard"><span class="cf-minicard__ico" aria-hidden="true">📅</span><p class="cf-minicard__title">Por día</p><div class="cf-minicard__big">$58.363,50</div><p class="cf-minicard__sub">SMLMV ÷ 30</p></div>
        </div>
      </div>
    </section>

    <!-- Del mes a la hora -->
    <section class="cf-section">
      <p class="cf-eyebrow">Referencia rápida</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Del mes a la hora</h2>
      <div class="cf-cards cf-cards--4" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
        <div class="cf-minicard cf-stat--accent" style="border-top-color:var(--accent)"><p class="cf-minicard__title">Mes</p><div class="cf-minicard__big">$1.750.905</div><p class="cf-minicard__sub">Valor base</p></div>
        <div class="cf-minicard"><p class="cf-minicard__title">Quincena</p><div class="cf-minicard__big">$875.452,50</div><p class="cf-minicard__sub">SMLMV ÷ 2</p></div>
        <div class="cf-minicard"><p class="cf-minicard__title">Referencia por 7 días</p><div class="cf-minicard__big">$408.544,50</div><p class="cf-minicard__sub">SMLMV ÷ 30 × 7; no es nómina semanal</p></div>
        <div class="cf-minicard"><p class="cf-minicard__title">Día</p><div class="cf-minicard__big">$58.363,50</div><p class="cf-minicard__sub">SMLMV ÷ 30</p></div>
        <div class="cf-minicard"><p class="cf-minicard__title">Hora</p><div class="cf-minicard__big">$8.337,64</div><p class="cf-minicard__sub">desde 15-jul</p></div>
      </div>
    </section>

    <!-- Jornada baja -->
    <section class="cf-section">
      <div class="cf-side-card cf-side-card--dark smc-jornada">
        <div>
          <p class="cf-side-eyebrow">Cambio clave 2026</p>
          <h2 class="smc-jornada__title">La jornada baja, el valor hora sube</h2>
          <p class="cf-side-desc" style="max-width:44ch">Desde el 15 de julio la jornada máxima pasa de 44 a 42 horas semanales. El salario mensual no cambia: se divide entre menos horas.</p>
        </div>
        <div class="smc-jornada__cmp">
          <div class="smc-j"><span class="smc-j__lbl">Hasta 14 de julio</span><span class="smc-j__val">44 h / semana</span><span class="smc-j__sub">$7.958,66 por hora</span></div>
          <span class="smc-j__arrow" aria-hidden="true">→</span>
          <div class="smc-j smc-j--now"><span class="smc-j__lbl">Desde 15 de julio</span><span class="smc-j__val">42 h / semana</span><span class="smc-j__sub">$8.337,64 por hora</span></div>
        </div>
      </div>
    </section>

    <!-- Auxilio -->
    <section class="cf-section">
      <p class="cf-eyebrow">Auxilio de transporte</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Quién lo recibe y cómo se suma</h2>
      <div class="cf-cmp">
        <div class="cf-cmp__col cf-cmp__col--yes">
          <div class="cf-cmp__head"><span aria-hidden="true">✓</span> Te corresponde si…</div>
          <ul class="cf-cmp__list">
            <li>Tu ingreso mensual no supera 2 SMLMV ($3.501.810)</li>
            <li>Tu empleador no suministra el transporte</li>
            <li>Se reconoce proporcionalmente si trabajás por días o medio tiempo</li>
          </ul>
        </div>
        <div class="cf-cmp__col smc-impact">
          <div class="cf-cmp__head"><span aria-hidden="true">＋</span> Cómo impacta</div>
          <ul class="cf-cmp__list">
            <li>Se incluye en la base de la prima de servicios</li>
            <li>También integra la base para las cesantías</li>
            <li>No se usa para aportes a salud y pensión</li>
          </ul>
          <div class="smc-sum">$1.750.905 + $249.095 <strong>= $2.000.000</strong></div>
        </div>
      </div>
    </section>

    <!-- Recargos -->
    <section class="cf-section">
      <p class="cf-eyebrow">Trabajo suplementario</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Recargos y horas extra</h2>
      <div class="cf-cards cf-cards--4">
        <div class="cf-minicard cf-minicard--v1"><span class="cf-minicard__ico" aria-hidden="true">🌙</span><div class="cf-minicard__big">+35%</div><p class="cf-minicard__title">Recargo nocturno</p><p class="cf-minicard__sub">De 19:00 a 6:00, sobre hora ordinaria</p></div>
        <div class="cf-minicard cf-minicard--v2"><span class="cf-minicard__ico" aria-hidden="true">☀️</span><div class="cf-minicard__big">+25%</div><p class="cf-minicard__title">Hora extra diurna</p><p class="cf-minicard__sub">Trabajo suplementario</p></div>
        <div class="cf-minicard cf-minicard--v3"><span class="cf-minicard__ico" aria-hidden="true">🌚</span><div class="cf-minicard__big">+75%</div><p class="cf-minicard__title">Hora extra nocturna</p><p class="cf-minicard__sub">Trabajo suplementario</p></div>
        <div class="cf-minicard cf-minicard--v4"><span class="cf-minicard__ico" aria-hidden="true">🗓️</span><div class="cf-minicard__big">+90%</div><p class="cf-minicard__title">Dominical / festivo</p><p class="cf-minicard__sub">Desde 1-jul-2026</p></div>
      </div>
    </section>

    <!-- Prestaciones -->
    <section class="cf-section">
      <p class="cf-eyebrow">Prestaciones sociales</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Lo que genera un año trabajado</h2>
      <div class="cf-cards cf-cards--4">
        <div class="cf-minicard cf-minicard--v1"><span class="cf-minicard__ico" aria-hidden="true">🏦</span><p class="cf-minicard__title">Cesantías</p><div class="cf-minicard__big">1 mes / año</div><p class="cf-minicard__sub">Se consignan antes del 14-feb</p></div>
        <div class="cf-minicard cf-minicard--v2"><span class="cf-minicard__ico" aria-hidden="true">📈</span><p class="cf-minicard__title">Intereses</p><div class="cf-minicard__big">12% anual</div><p class="cf-minicard__sub">Sobre las cesantías, antes del 31-ene</p></div>
        <div class="cf-minicard cf-minicard--v3"><span class="cf-minicard__ico" aria-hidden="true">🎁</span><p class="cf-minicard__title">Prima</p><div class="cf-minicard__big">1 mes / año</div><p class="cf-minicard__sub">Mitad en junio, mitad en diciembre</p></div>
        <div class="cf-minicard cf-minicard--v4"><span class="cf-minicard__ico" aria-hidden="true">🏖️</span><p class="cf-minicard__title">Vacaciones</p><div class="cf-minicard__big">15 días</div><p class="cf-minicard__sub">Hábiles por cada año trabajado</p></div>
      </div>
    </section>

    <!-- Tabla maestra -->
    <section class="cf-section">
      <p class="cf-eyebrow">Tabla maestra</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Todos los valores 2026</h2>
      <div class="cf-tablewrap">
        <table class="cf-table">
          <thead><tr><th>Concepto</th><th>Fórmula o condición</th><th>Valor 2026</th></tr></thead>
          <tbody>
            {valores.map((r) => (<tr><td class="cf-td-dot">{r.c}</td><td style="color:var(--text-subtle);font-size:0.85rem">{r.n}</td><td class="cf-td-em">{r.v}</td></tr>))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Datos abiertos -->
    <section class="cf-section">
      <div class="cf-2col">
        <div>
          <p class="cf-eyebrow">Datos abiertos · CC-BY 4.0</p>
          <h2 class="cf-section__title" style="margin:0.35rem 0 0.6rem">Usá estos datos en tu proyecto</h2>
          <p class="cf-section__lead" style="max-width:56ch;margin-bottom:1.1rem">Descargá la tabla en formato estructurado y citá la fuente con un enlace para poder usarla.</p>
          <div class="smc-dl">
            <a class="cf-primary" style="width:auto;display:inline-flex" href="/datos/salario-minimo-colombia-2026.json" download><span aria-hidden="true">⬇</span> Descargar JSON</a>
            <a class="cf-sc" style="padding:0.7rem 1.1rem" href="/datos/salario-minimo-colombia-2026.csv" download><span aria-hidden="true">⬇</span> Descargar CSV</a>
