---
export const prerender = true;
import LocaleCatalog from '../../components/LocaleCatalog.astro';
const localeModules = import.meta.glob<any>('../../content/calcs-co/*.json', { eager: true });
const mainModules = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
const localeCalcs = Object.values(localeModules).map((m: any) => m.default || m).filter((c: any) => c && c.slug && c.h1 && !c.noindex);
const localeSlugs = new Set(localeCalcs.map((c: any) => c.slug));
const audienceCalcs = Object.values(mainModules).map((m: any) => m.default || m).filter((c: any) => c && c.slug && c.h1 && !c.noindex && c.audience === 'CO');
const all = [...localeCalcs, ...audienceCalcs];
const calcs = all.map((c: any) => ({ h1: c.h1, slug: c.slug, icon: c.icon, category: c.category, url: localeSlugs.has(c.slug) ? `/co/${c.slug}` : `/${c.slug}` }));
---
<LocaleCatalog calcs={calcs} prefix="co" audience="CO" country="Colombia" lang="es-CO" topics="salario mínimo, prestaciones, retención en la fuente, UVT, hora extra, liquidación" dataLink="/co/datos-salario-minimo-colombia-2026" dataLabel="📊 Salario mínimo y prestaciones Colombia 2026" />
