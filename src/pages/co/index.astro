---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ColombiaHomeExperience from '../../components/generated/ColombiaHomeExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
const canonical='https://hacecuentas.com/co';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Hacé Cuentas Colombia",url:canonical,operatingSystem:'Web'};
---
<Layout title="Calculadoras de Colombia: salario, impuestos y finanzas | Hacé Cuentas" description="Calculá salario, prestaciones, impuestos, créditos, vivienda y gastos cotidianos en Colombia con valores y fuentes locales." canonical={canonical} schema={schema} lang="es" hreflang={HOME_HREFLANG}>
  <Header />
  <ColombiaHomeExperience />
  <RecoveredHubIntro headingLevel="h2" eyebrow="Datos Colombia 2026" h1="Referencias oficiales más consultadas" lede="Accedé directo a los valores y calendarios que más se consultan en Colombia, con fuentes y vigencia visibles." note="Estos enlaces son páginas de referencia; para calcular tu caso usá las herramientas relacionadas dentro de cada una." links={[
    {href:'/co/datos-salario-minimo-colombia-2026',title:'Salario mínimo Colombia 2026',description:'SMLMV, auxilio, valor diario, hora y prestaciones.'},
    {href:'/feriados-colombia-2026',title:'Festivos Colombia 2026',description:'Los 18 festivos, lunes trasladados y puentes.'},
    {href:'/co/validar-nit',title:'Validar NIT',description:'Formato y dígito de verificación para Colombia.'},
    {href:'/co/trabajo/horas-extras-y-recargos',title:'Horas extra y recargos',description:'Valores diurnos, nocturnos, dominicales y festivos.'}
  ]} />
  <Footer />
</Layout>
