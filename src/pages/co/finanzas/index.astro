---
/**
 * Silo Finanzas · Colombia — índice de hubs de decisión del mercado CO.
 * Existe para que el breadcrumb de los hubs colombianos no apunte a un 404 y para
 * repartir link equity entre hermanos. El listado sale del registry, no a mano.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import ContextualToolLink from '../../../components/ContextualToolLink.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';

const HREF = '/co/finanzas';
const SILO = 'Finanzas';
const LEDE =
  'Ahorro, CDT, créditos, hipoteca, pensión y comisiones bancarias en Colombia, con las tasas y topes vigentes de la Superfinanciera y el Banco de la República.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${SILO} en Colombia`,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title={`Finanzas personales en Colombia — ahorro, crédito y pensión | Hacé Cuentas`}
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <ContextualToolLink
    eyebrow="Dólar en Colombia"
    title="TRM de hoy: convertí dólares a pesos colombianos"
    description="Usá la tasa vigente para pasar USD a COP y comparar el valor de una compra, transferencia o ingreso."
    href="/co/calculadora-trm-dolar-hoy-pesos-colombianos"
    linkLabel="Calcular con la TRM"
  />
  <Footer />
</Layout>
