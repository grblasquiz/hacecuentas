---
/**
 * Hub de decisión CO — "¿Me alcanza para comprar y cuánto termino pagando?"
 *
 * El gráfico es posicional (scale): la cuota contra el tope legal del 30% del
 * ingreso familiar (Ley 546/1999 art. 17), así que compute() devuelve position
 * y positionLabel.
 *
 * audience="CO" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import ComprarViviendaColombiaExperience from '../../../components/generated/ComprarViviendaColombiaExperience.astro';
import {
  hub,
  SMLMV,
  UVT,
  CREDITO,
  CIERRE,
  TOPE_VIS_SMLMV,
  TOPE_VIP_SMLMV,
  CUOTA_INICIAL_NO_VIS_PCT,
  CUOTA_INICIAL_VIS_PCT,
  MI_CASA_YA,
  DEDUCCION_INTERESES_UVT,
} from '../../../lib/hubs/co/comprar-vivienda';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ComprarViviendaColombiaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

