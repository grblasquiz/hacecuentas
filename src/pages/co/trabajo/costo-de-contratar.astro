---
/**
 * Hub de decisión CO — "¿Cuánto me cuesta de verdad tener un empleado?" (lado empleador).
 *
 * audience="CO" va literal al Layout: HubData sólo modela 'AR' | 'global' y el
 * mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CostoContratarColombiaExperience from '../../../components/generated/CostoContratarColombiaExperience.astro';
import {
  hub,
  SMLMV,
  AUXILIO_TRANSPORTE,
  TOPE_AUXILIO_SMLMV,
  APORTES,
  PRESTACIONES,
  JORNADA,
  INTEGRAL,
  INDEMNIZACION,
  FIC_CONSTRUCCION,
} from '../../../lib/hubs/co/costo-de-contratar';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CostoContratarColombiaExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    SMLMV,
    AUXILIO: AUXILIO_TRANSPORTE,
    TOPE_AUX: TOPE_AUXILIO_SMLMV,
    APORTES,
    PRESTACIONES,
    JORNADA,
    INTEGRAL,
    INDEMNIZACION,
    FIC: FIC_CONSTRUCCION,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');

    // Ley 2101/2021: el divisor legal de horas del mes baja de 220 a 210 el 15-jul-2026.
    // Se resuelve por fecha, no se hardcodea (la calc vieja dejaba 220 fijo y la hora salía mal).
    function divisorLegal() {
      return new Date() >= new Date(JORNADA.corte)
        ? JORNADA.divisorDesde15Jul2026
        : JORNADA.divisorHasta14Jul2026;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'pj-exonerado';
      const salario = Math.max(0, v.salario || 0);
      const claseRaw = String(v.claseArl || 'I').toUpperCase();
      const clase = APORTES.arl[claseRaw] !== undefined ? claseRaw : 'I';
      const tasaArl = APORTES.arl[clase];
      const esConstruccion = String(v.construccion || 'no') === 'si';
      const horasProd = Math.max(1, Math.round(v.horasProductivas || 190));

      const esIntegral = id === 'integral';
      const esDespido = id === 'despido';

      // Auxilio de transporte: hasta 2 SMLMV. El salario integral nunca lo lleva.
      const topeAuxilio = TOPE_AUX * SMLMV;
      const auxilio = !esIntegral && salario > 0 && salario <= topeAuxilio ? AUXILIO : 0;

      // IBC de seguridad social: 70% en integral, y tope de 25 SMLMV siempre.
      const baseCotizacion = esIntegral ? salario * INTEGRAL.ibcFactor : salario;
      const ibc = Math.min(baseCotizacion, APORTES.ibcTopeSmlmv * SMLMV);

      // Exoneración art. 114-1 ET: sólo persona jurídica y sólo bajo 10 SMLMV.
      // El integral arranca en 13 SMLMV, así que nunca se exonera.
      const exonerado = id === 'pj-exonerado' && !esIntegral && salario < APORTES.exoneracionSmlmvTope * SMLMV;

      // ── Seguridad social a cargo del empleador ──
      const salud = exonerado ? 0 : ibc * APORTES.saludEmpleador;
      const pension = ibc * APORTES.pensionEmpleador;
      const arl = ibc * tasaArl;
      const segSocial = salud + pension + arl;

      // ── Parafiscales: la caja NUNCA se exonera ──
      const ccf = ibc * APORTES.cajaCompensacion;
      const icbf = exonerado ? 0 : ibc * APORTES.icbf;
      const sena = exonerado ? 0 : ibc * APORTES.sena;
      const fic = esConstruccion ? salario * FIC : 0;
      const parafiscales = ccf + icbf + sena + fic;

      // ── Prestaciones sociales ──
      // Integral: sólo vacaciones (prima, cesantías e intereses van dentro del factor del 30%).
      const basePrestacional = salario + auxilio;
      const cesantias = esIntegral ? 0 : basePrestacional * PRESTACIONES.cesantias;
      // Los intereses son el 12% DE LAS CESANTÍAS del año, no el 12% del sueldo.
      const intereses = cesantias * PRESTACIONES.intereses;
      const prima = esIntegral ? 0 : basePrestacional * PRESTACIONES.prima;
      const vacaciones = salario * PRESTACIONES.vacaciones;
      const prestaciones = cesantias + intereses + prima + vacaciones;

      const costoMensual = salario + auxilio + segSocial + parafiscales + prestaciones;
      const sobrecosto = costoMensual - salario;
      const factor = salario > 0 ? costoMensual / salario : 0;
      const costoHora = costoMensual / horasProd;
      const div = divisorLegal();
      const horaNomina = salario / div;

      const rows = [];
      let total, sub, chart;

      if (esDespido) {
        // ── Rama despido: indemnización art. 64 CST + prestaciones pendientes ──
        const anios = Math.max(0, Math.round(v.anios || 0));
        const meses = Math.max(0, Math.round(v.meses || 0));
        const T = anios + meses / 12;
        const valorDia = salario / 30;
        const menor10 = salario < APORTES.exoneracionSmlmvTope * SMLMV;
        const tabla = menor10 ? INDEMNIZACION.menos10Smlmv : INDEMNIZACION.desde10Smlmv;
        const dias = T <= 0 ? 0 : T <= 1
          ? tabla.diasPrimerAnio
          : tabla.diasPrimerAnio + tabla.diasPorAnioAdicional * (T - 1);
        const indemnizacion = dias * valorDia;

        const mesesPend = Math.min(12, Math.max(0, Math.round(v.mesesPendientes || 0)));
        const prop = mesesPend / 12;
        const cesPend = basePrestacional * prop;
        // Intereses: 12% sobre el saldo de cesantías DEL AÑO, proporcionales al tiempo corrido.
        const intPend = cesPend * PRESTACIONES.intereses * prop;
        const primaPend = basePrestacional * prop;
        const vacacionesPend = salario * PRESTACIONES.vacaciones * mesesPend;
        const pendientes = cesPend + intPend + primaPend + vacacionesPend;
        const costoDespido = indemnizacion + pendientes;

        rows.push({ k: 'Salario mensual de base', ref: 'Día = salario ÷ 30', v: salario });
        rows.push({
          k: 'Antigüedad computada',
          ref: menor10 ? 'Tabla 30 + 20 días · art. 64 CST' : 'Tabla 20 + 15 días · art. 64 CST',
          v: T,
          format: 'unit',
          unit: 'años',
          decimals: 2,
        });
        rows.push({
          k: 'Días de indemnización que te corresponden pagar',
          ref: 'Art. 64 CST · término indefinido',
          v: dias,
          format: 'unit',
          unit: 'días',
          decimals: 1,
        });
        rows.push({ k: 'Indemnización por despido sin justa causa', ref: 'Art. 64 CST', v: indemnizacion, extra: true });
        rows.push({ k: 'Cesantías proporcionales pendientes', ref: mesesPend + ' meses sin liquidar', v: cesPend });
        rows.push({ k: 'Intereses a las cesantías', ref: '12% sobre el saldo del año · Ley 52/1975', v: intPend });
        rows.push({ k: 'Prima de servicios proporcional', ref: 'Art. 306 CST', v: primaPend });
        rows.push({ k: 'Vacaciones proporcionales', ref: PRESTACIONES.vacacionesDiasHabiles + ' días hábiles/año · art. 186 CST', v: vacacionesPend });
        rows.push({ k: 'Total de prestaciones pendientes', ref: 'Se deben aunque el despido sea con justa causa', v: pendientes });
        rows.push({ k: 'Desembolso total del despido', ref: 'Indemnización + liquidación', v: costoDespido, extra: true });
        rows.push({
          k: 'Cuántos sueldos equivale',
          ref: 'Costo ÷ salario mensual',
          v: salario > 0 ? costoDespido / salario : 0,
          format: 'unit',
          unit: 'sueldos',
          decimals: 1,
        });

        total = cop(costoDespido);
        sub =
          'Indemnización ' + cop(indemnizacion) + ' + liquidación pendiente ' + cop(pendientes) +
          ' · ' + dias.toLocaleString('es-CO', { maximumFractionDigits: 1 }) + ' días de indemnización' +
          ' · tabla ' + (menor10 ? '30 + 20' : '20 + 15') + ' del art. 64 CST';
        chart = [
          { label: 'Indemnización (la sanción)', value: Math.round(indemnizacion), tone: 'bad' },
          { label: 'Cesantías, intereses y prima', value: Math.round(cesPend + intPend + primaPend), tone: 'main' },
          { label: 'Vacaciones proporcionales', value: Math.round(vacacionesPend), tone: 'good' },
        ];
      } else {
        // ── Ramas de costo corriente ──
        rows.push({ k: 'Salario pactado', ref: esIntegral ? 'Salario integral · art. 132 CST' : 'Contrato laboral', v: salario });
        if (auxilio > 0) {
          rows.push({ k: 'Auxilio de transporte', ref: 'Hasta ' + TOPE_AUX + ' SMLMV · Decreto 1470/2025', v: auxilio });
        }
        if (esIntegral) {
          rows.push({
            k: 'Base de cotización a seguridad social',
            ref: '70% del salario integral · art. 132 CST',
            v: ibc,
          });
        }
        if (!exonerado) {
          rows.push({ k: 'Salud a cargo del empleador', ref: '8,5% del IBC · Ley 100/1993', v: salud });
        }
        rows.push({ k: 'Pensión a cargo del empleador', ref: '12% del IBC · Ley 100/1993', v: pension });
        rows.push({
          k: 'ARL clase ' + clase,
          ref: (tasaArl * 100).toLocaleString('es-CO', { maximumFractionDigits: 3 }) + '% · 100% del empleador',
          v: arl,
        });
        rows.push({ k: 'Caja de compensación familiar', ref: '4% · nunca exonerada · Ley 21/1982', v: ccf });
        if (!exonerado) {
          rows.push({ k: 'ICBF', ref: '3% · Ley 89/1988', v: icbf });
          rows.push({ k: 'SENA', ref: '2% · Ley 21/1982', v: sena });
        }
        if (fic > 0) {
          rows.push({ k: 'FIC — Fondo de la Industria de la Construcción', ref: '1% de la nómina de obra · Ley 21/1982 art. 6', v: fic });
        }
        if (!esIntegral) {
          rows.push({ k: 'Cesantías provisionadas', ref: '8,33% de salario + auxilio', v: cesantias });
          rows.push({ k: 'Intereses a las cesantías', ref: '12% sobre las cesantías del año · Ley 52/1975', v: intereses });
          rows.push({ k: 'Prima de servicios provisionada', ref: '8,33% de salario + auxilio', v: prima });
        }
        rows.push({
          k: 'Vacaciones provisionadas',
          ref: PRESTACIONES.vacacionesDiasHabiles + ' días hábiles/año · art. 186 CST',
          v: vacaciones,
        });
        rows.push({ k: 'Total de cargas sobre el sueldo', ref: 'Todo lo que el trabajador no ve en su cuenta', v: sobrecosto });
        rows.push({ k: 'Costo mensual real del empleado', ref: 'Lo que desembolsás de verdad', v: costoMensual, extra: true });
        rows.push({
          k: 'Factor de costo sobre el salario',
          ref: exonerado ? 'Con exoneración art. 114-1 ET' : 'Sin exoneración art. 114-1 ET',
          v: factor,
          format: 'unit',
          unit: '× el salario',
          decimals: 2,
        });
        rows.push({ k: 'Costo anual del puesto', ref: '12 meses', v: costoMensual * 12 });
        rows.push({
          k: 'Costo por hora productiva',
          ref: horasProd + ' h reales/mes · piso para cotizar',
          v: costoHora,
        });
        rows.push({
          k: 'Hora "de nómina" con la que suele confundirse',
          ref: 'Salario ÷ ' + div + ' h · Ley 2101/2021',
          v: horaNomina,
        });

        total = cop(costoMensual);
        sub =
          'Factor ' + factor.toLocaleString('es-CO', { maximumFractionDigits: 2 }) + '× el salario' +
          ' · ' + cop(sobrecosto) + ' de cargas sobre el sueldo' +
          ' · ' + cop(costoHora) + ' por hora productiva' +
          (exonerado
            ? ' · exonerado de salud 8,5%, SENA e ICBF'
            : ' · sin exoneración del art. 114-1 ET');
        chart = [
          { label: 'Salario y auxilio (lo que él recibe)', value: Math.round(salario + auxilio), tone: 'main' },
          { label: 'Prestaciones sociales', value: Math.round(prestaciones), tone: 'good' },
          { label: 'Seguridad social patronal', value: Math.round(segSocial), tone: 'warn' },
          { label: 'Parafiscales', value: Math.round(parafiscales), tone: 'bad' },
        ];
      }

      return { total: total, sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
