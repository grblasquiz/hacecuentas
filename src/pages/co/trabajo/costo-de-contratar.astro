---
/**
 * Hub de decisión CO — "¿Cuánto me cuesta de verdad tener un empleado?" (lado empleador).
 *
 * audience="CO" va literal al Layout: HubData sólo modela 'AR' | 'global' y el
 * mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CostoContratarColombiaExperience from '../../../components/generated/CostoContratarColombiaExperience.astro';
import {
  hub,
  SMLMV,
  AUXILIO_TRANSPORTE,
  TOPE_AUXILIO_SMLMV,
  APORTES,
  PRESTACIONES,
  JORNADA,
  INTEGRAL,
  INDEMNIZACION,
  FIC_CONSTRUCCION,
} from '../../../lib/hubs/co/costo-de-contratar';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CostoContratarColombiaExperience data={hub} />
  <Footer />
</Layout>

