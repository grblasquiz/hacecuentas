---
/**
 * Hub de decisión CO — "Prestación de servicios: cuánto pago de seguridad social
 * y cuánto me queda". audience="CO" va literal al Layout; el mercado real viaja
 * en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import IndependienteHonorariosColombiaExperience from '../../../components/generated/IndependienteHonorariosColombiaExperience.astro';
import {
  hub,
  SMLMV,
  AUXILIO_TRANSPORTE,
  TOPE_AUXILIO_SMLMV,
  IBC,
  TASAS_IND,
  ARL,
  FSP,
  NOMINA,
  PRESUNCION_UGPP,
  PRESUNCION_TRANSPORTE,
} from '../../../lib/hubs/co/independiente-y-honorarios';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <IndependienteHonorariosColombiaExperience data={hub} />
  <Footer />
</Layout>

