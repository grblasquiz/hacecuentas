---
/**
 * Hub de decisión CO — "Prestación de servicios: cuánto pago de seguridad social
 * y cuánto me queda". audience="CO" va literal al Layout; el mercado real viaja
 * en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import IndependienteHonorariosColombiaExperience from '../../../components/generated/IndependienteHonorariosColombiaExperience.astro';
import {
  hub,
  SMLMV,
  AUXILIO_TRANSPORTE,
  TOPE_AUXILIO_SMLMV,
  IBC,
  TASAS_IND,
  ARL,
  FSP,
  NOMINA,
  PRESUNCION_UGPP,
  PRESUNCION_TRANSPORTE,
} from '../../../lib/hubs/co/independiente-y-honorarios';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <IndependienteHonorariosColombiaExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    SMLMV,
    AUXILIO_TRANSPORTE,
    TOPE_AUXILIO_SMLMV,
    IBC,
    TASAS: TASAS_IND,
    ARL,
    FSP,
    NOMINA,
    PRESUNCION: PRESUNCION_UGPP,
    PRESUNCION_TRANSPORTE,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');
    const pct = (n) => n.toFixed(2).replace('.', ',');

    const PISO = SMLMV * IBC.pisoSmlmv;
    const TOPE = SMLMV * IBC.topeSmlmv;

    /** Tasa del Fondo de Solidaridad Pensional según el IBC (hasta: null = sin techo). */
    function tasaFsp(ibc) {
      const enSmlmv = ibc / SMLMV;
      for (const t of FSP) {
        const hasta = t.hasta === null ? Infinity : t.hasta;
        if (enSmlmv >= t.desde && enSmlmv < hasta) return t.tasa;
      }
      return 0;
    }

    function presuncionDe(id) {
      const a = PRESUNCION.find((x) => x.id === id);
      return a ? a.pct : PRESUNCION[0].pct;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'ops';

      const ingreso = Math.max(0, v.ingreso || 0);
      const gastos = Math.max(0, v.gastos || 0);
      const salario = Math.max(0, v.salario || 0);
      const meses = Math.min(12, Math.max(1, Math.round(v.meses || 12)));
      const claseArl = String(v.arl || 'ninguna');
      const tasaArl = ARL[claseArl] || 0;

      // ── Base de cotización según la figura ──
      // OPS: 40% del bruto (Ley 2277/2022 art. 89).
      // Cuenta propia y apps: 40% del ingreso NETO de la presunción (Decreto 0379/2026).
      const usaPresuncion = id === 'cuentapropia' || id === 'repartidor';
      const pctPresuncion = id === 'repartidor' ? PRESUNCION_TRANSPORTE : presuncionDe(v.actividad);
      const costoPresunto = usaPresuncion ? ingreso * (pctPresuncion / 100) : 0;
      const ingresoNeto = Math.max(0, ingreso - costoPresunto);

      const base40 = ingresoNeto * IBC.porcentaje;
      const ibc = Math.min(Math.max(base40, PISO), TOPE);
      const enPiso = base40 < PISO;
      const enTope = base40 > TOPE;

      const salud = ibc * TASAS.salud;
      const pension = ibc * TASAS.pension;
      const tFsp = tasaFsp(ibc);
      const fsp = ibc * tFsp;
      const arl = ibc * tasaArl;
      const pila = salud + pension + fsp + arl;

      const bolsillo = ingreso - pila - gastos;
      const ingresoAnual = ingreso * meses;
      const promedioMensualReal = ingresoAnual / 12;

      const rows = [
        { k: 'Lo que facturás al mes', ref: 'Cuenta de cobro o liquidación de la app', v: ingreso },
      ];

      if (usaPresuncion) {
        rows.push({
          k: 'Presunción de costos de tu actividad (se resta)',
          ref: pct(pctPresuncion) + '% · Resolución UGPP 532/2024',
          v: costoPresunto,
        });
        rows.push({ k: 'Ingreso neto sobre el que se calcula el IBC', ref: 'Decreto 0379/2026', v: ingresoNeto });
      }

      rows.push({
        k: 'Base de cotización (IBC)',
        ref: enPiso
          ? 'Piso de 1 SMLMV: el 40% dio menos'
          : enTope
            ? 'Tope de ' + IBC.topeSmlmv + ' SMLMV'
            : IBC.porcentaje * 100 + '% del ingreso' + (usaPresuncion ? ' neto' : ' bruto'),
        v: ibc,
        extra: true,
      });
      rows.push({ k: 'Aporte a salud', ref: pct(TASAS.salud * 100) + '% del IBC', v: salud });
      rows.push({ k: 'Aporte a pensión', ref: pct(TASAS.pension * 100) + '% del IBC', v: pension });
      rows.push({
        k: 'Fondo de Solidaridad Pensional',
        ref: tFsp > 0 ? pct(tFsp * 100) + '% del IBC · desde 4 SMLMV' : 'No aplica: IBC menor a 4 SMLMV',
        v: fsp,
      });
      rows.push({
        k: 'ARL' + (claseArl === 'ninguna' ? '' : ' clase ' + claseArl),
        ref: claseArl === 'ninguna' ? 'No incluida en el cálculo' : pct(tasaArl * 100) + '% del IBC · Decreto 1772/1994',
        v: arl,
      });
      rows.push({ k: 'Total de la planilla PILA', ref: 'Se paga mes vencido', v: pila, extra: true });

      if (gastos > 0) {
        rows.push({ k: 'Gastos reales que ponés vos', ref: 'Gasolina, desgaste, datos, herramientas', v: gastos });
      }

      rows.push({ k: 'Lo que te queda limpio en el mes', ref: 'Facturado menos PILA y gastos', v: bolsillo, extra: true });
      rows.push({
        k: 'Peso de la PILA sobre lo que facturás',
        ref: 'Planilla ÷ ingreso bruto',
        v: ingreso > 0 ? (pila / ingreso) * 100 : 0,
        format: 'unit',
        unit: '%',
        decimals: 1,
      });
      rows.push({
        k: 'Promedio mensual real si trabajás ' + meses + ' de 12 meses',
        ref: 'Los meses sin contrato no los paga nadie',
        v: (bolsillo * meses) / 12,
      });

      let total = cop(bolsillo);
      let sub =
        'Cotizás por un IBC de ' + cop(ibc) +
        (enPiso ? ' (piso de 1 SMLMV)' : enTope ? ' (tope de ' + IBC.topeSmlmv + ' SMLMV)' : '') +
        ' · PILA de ' + cop(pila) + ' al mes · te quedan ' + cop(bolsillo) +
        ' limpios, ' + cop(promedioMensualReal - pila - gastos) + ' promediando los meses sin contrato';

      // Barra apilada: a dónde va cada peso facturado.
      let chart = [
        { label: 'Te queda limpio', value: Math.max(0, Math.round(bolsillo)), tone: 'main' },
        { label: 'Salud', value: Math.round(salud), tone: 'warn' },
        { label: 'Pensión', value: Math.round(pension), tone: 'prop' },
        { label: 'FSP y ARL', value: Math.round(fsp + arl), tone: 'bad' },
        { label: 'Gastos tuyos', value: Math.round(gastos), tone: 'exit' },
      ].filter((s) => s.value > 0);

      // ── Rama de comparación: nómina vs prestación de servicios ──
      if (id === 'comparar') {
        const auxilio = salario > 0 && salario < SMLMV * TOPE_AUXILIO_SMLMV ? AUXILIO_TRANSPORTE : 0;
        const baseprest = salario + auxilio;
        // Prestaciones: cesantías + intereses sobre cesantías + prima + vacaciones.
        // Vacaciones se liquidan sobre el salario, sin auxilio de transporte.
        const cesantias = baseprest * NOMINA.cesantias;
        const interesesCes = cesantias * NOMINA.interesesCesantias;
        const prima = baseprest * NOMINA.prima;
        const vacaciones = salario * NOMINA.vacaciones;
        const prestaciones = cesantias + interesesCes + prima + vacaciones;

        // Exoneración art. 114-1 ET: salud 8,5% + SENA + ICBF sólo por debajo de 10 SMLMV.
        const exonerado = salario < SMLMV * NOMINA.exoneracionTopeSmlmv;
        const tasaPatron =
          NOMINA.pensionEmpleador + NOMINA.caja + (tasaArl || ARL.I) +
          (exonerado ? 0 : NOMINA.saludEmpleador + NOMINA.icbf + NOMINA.sena);
        const aportesPatron = salario * tasaPatron;
        const costoEmpresa = salario + auxilio + prestaciones + aportesPatron;
        const netoEmpleado = salario * (1 - NOMINA.saludEmpleado - NOMINA.pensionEmpleado) + auxilio;

        // Honorario que deja el mismo neto: el IBC es el 40% del bruto (OPS), así que
        // la carga efectiva es 40% × 28,5% (+ ARL si la asume el contratista).
        const cargaEfectiva = IBC.porcentaje * (TASAS.salud + TASAS.pension + tasaArl);
        const honorarioMismoNeto = netoEmpleado / Math.max(0.01, 1 - cargaEfectiva);
        const brecha = honorarioMismoNeto - salario;

        rows.push({ k: '— Comparación con un sueldo de ' + cop(salario) + ' —', ref: 'Nómina', v: 0 });
        rows.push({ k: 'Auxilio de transporte', ref: auxilio > 0 ? 'Aplica: el sueldo es menor a 2 SMLMV' : 'No aplica: el sueldo pasa 2 SMLMV', v: auxilio });
        rows.push({ k: 'Prestaciones provisionadas', ref: 'Cesantías, intereses, prima y vacaciones', v: prestaciones });
        rows.push({
          k: 'Aportes del empleador',
          ref: exonerado ? 'Pensión, ARL y caja (exonerado de salud, SENA e ICBF)' : 'Pensión, ARL, caja, salud, SENA e ICBF',
          v: aportesPatron,
        });
        rows.push({ k: 'Costo real de ese empleado para la empresa', ref: 'Todo incluido', v: costoEmpresa, extra: true });
        rows.push({ k: 'Neto que recibe el empleado', ref: 'Salario menos 4% salud y 4% pensión, más auxilio', v: netoEmpleado });
        rows.push({ k: 'Honorario que necesitás para igualar ese neto', ref: 'Con el 40% de IBC y aporte completo', v: honorarioMismoNeto, extra: true });
        rows.push({ k: 'Cuánto más que el sueldo tenés que facturar', ref: 'Sólo para empatar el mes', v: brecha });
        rows.push({
          k: 'Sobreprecio sobre el sueldo básico',
          ref: 'Honorario ÷ salario',
          v: salario > 0 ? (honorarioMismoNeto / salario - 1) * 100 : 0,
          format: 'unit',
          unit: '% más',
          decimals: 1,
        });
        rows.push({ k: 'Honorario para igualar lo que le cuesta a la empresa', ref: 'Techo de negociación', v: costoEmpresa });

        total = cop(honorarioMismoNeto);
        sub =
          'Para igualar el neto de un sueldo de ' + cop(salario) + ' (' + cop(netoEmpleado) + ' en mano) tenés que facturar ' +
          cop(honorarioMismoNeto) + ' al mes · a la empresa ese empleado le cuesta ' + cop(costoEmpresa) +
          ' · y esto todavía no cubre los ' + (12 - meses) + ' meses del año sin contrato';

        chart = [
          { label: 'Neto del empleado', value: Math.round(netoEmpleado), tone: 'main' },
          { label: 'Aportes del empleado', value: Math.round(salario * (NOMINA.saludEmpleado + NOMINA.pensionEmpleado)), tone: 'warn' },
          { label: 'Prestaciones provisionadas', value: Math.round(prestaciones), tone: 'prop' },
          { label: 'Aportes del empleador', value: Math.round(aportesPatron), tone: 'exit' },
        ].filter((s) => s.value > 0);
      }

      return { total: total, sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
