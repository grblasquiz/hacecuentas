---
/**
 * Hub de decisión CO — "Estoy incapacitado o de licencia: ¿quién me paga y cuánto?"
 * audience="CO" va literal al Layout; el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  SMLMV,
  SMDLV,
  INCAPACIDAD,
  MATERNIDAD,
  PATERNIDAD,
  CESANTE,
  COPAGO_ACUERDO_260,
} from '../../../lib/hubs/co/incapacidad-y-licencias';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    SMLMV,
    SMDLV,
    INCAPACIDAD,
    MATERNIDAD,
    PATERNIDAD,
    CESANTE,
    COPAGO: COPAGO_ACUERDO_260,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');

    /** Rango de copago del Acuerdo 260/2004 según el IBC en SMLMV (hastaSmlmv: null = último). */
    function rangoCopago(ibcMensual) {
      const enSmlmv = ibcMensual / SMLMV;
      for (const r of COPAGO) {
        if (r.hastaSmlmv === null || enSmlmv < r.hastaSmlmv) return r;
      }
      return COPAGO[COPAGO.length - 1];
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'incapacidad';

      const ibc = Math.max(0, v.ibc || 0);
      const diasExtra = Math.max(0, Math.round(v.diasExtra || 0));
      const personas = Math.max(0, Math.round(v.personas || 0));
      const cuotaFamiliar = Math.max(0, v.cuotaFamiliar || 0);
      const cuotaModeradora = Math.max(0, v.cuotaModeradora || 0);
      const servicios = Math.max(0, Math.round(v.servicios || 0));

      const valorDia = ibc / 30;
      const rango = rangoCopago(ibc);
      const topeCopagoAnual = rango.topeAnualSmlmv * SMLMV;
      const gastoModeradoras = cuotaModeradora * servicios;

      const rows = [
        { k: 'IBC mensual sobre el que te liquidan', ref: 'Lo que reporta el empleador en la planilla', v: ibc },
        { k: 'Valor de tu día', ref: 'IBC ÷ 30', v: valorDia },
      ];

      let total, sub, chart;

      if (id === 'incapacidad') {
        const dias = Math.min(INCAPACIDAD.topeDiasEps, Math.max(1, Math.round(v.dias || 1)));
        const truncado = Math.round(v.dias || 0) > INCAPACIDAD.topeDiasEps;

        // Piso legal: el auxilio nunca baja del salario mínimo diario proporcional.
        const dia66 = Math.max(valorDia * INCAPACIDAD.pct1a90, SMDLV);
        const dia50 = Math.max(valorDia * INCAPACIDAD.pct91a180, SMDLV);
        const aplicaPiso = valorDia * INCAPACIDAD.pct1a90 < SMDLV;

        const dias1a90 = Math.min(dias, 90);
        const dias91a180 = Math.max(0, dias - 90);
        const diasEmpleador = Math.min(dias1a90, INCAPACIDAD.diasEmpleador);
        const diasEps66 = Math.max(0, dias1a90 - diasEmpleador);

        const pagaEmpleador = diasEmpleador * dia66;
        const pagaEps = diasEps66 * dia66 + dias91a180 * dia50;
        const cobras = pagaEmpleador + pagaEps;
        const salarioNormal = valorDia * dias;
        const perdes = Math.max(0, salarioNormal - cobras);

        rows.push({
          k: 'Valor del día en el tramo del ' + (INCAPACIDAD.pct1a90 * 100).toFixed(2).replace('.', ',') + '%',
          ref: aplicaPiso ? 'Elevado al mínimo diario de ' + cop(SMDLV) : 'Días 1 a 90',
          v: dia66,
        });
        rows.push({
          k: 'Días 1 a ' + diasEmpleador + ': los paga tu empleador',
          ref: 'CST art. 227',
          v: pagaEmpleador,
        });
        if (diasEps66 > 0) {
          rows.push({ k: 'Días 3 a ' + dias1a90 + ': los paga la EPS', ref: (INCAPACIDAD.pct1a90 * 100).toFixed(2).replace('.', ',') + '% del IBC', v: diasEps66 * dia66 });
        }
        if (dias91a180 > 0) {
          rows.push({ k: 'Días 91 a ' + dias + ': los paga la EPS', ref: INCAPACIDAD.pct91a180 * 100 + '% del IBC · ' + cop(dia50) + ' por día', v: dias91a180 * dia50 });
        }
        rows.push({ k: 'Total que vas a cobrar', ref: 'Empleador + EPS', v: cobras, extra: true });
        rows.push({ k: 'Lo que habrías ganado trabajando esos días', ref: 'Valor día × ' + dias, v: salarioNormal });
        rows.push({ k: 'Lo que dejás de percibir', ref: 'Nadie lo cubre', v: perdes, extra: true });
        rows.push({
          k: 'Porcentaje de tu salario que terminás cobrando',
          ref: 'Cobrado ÷ salario normal',
          v: salarioNormal > 0 ? (cobras / salarioNormal) * 100 : 0,
          format: 'unit',
          unit: '%',
          decimals: 1,
        });

        total = cop(cobras);
        sub =
          'Por ' + dias + (dias === 1 ? ' día' : ' días') + ' cobrás ' + cop(cobras) + ': ' + cop(pagaEmpleador) +
          ' del empleador y ' + cop(pagaEps) + ' de la EPS' +
          (perdes > 0 ? ' · dejás de percibir ' + cop(perdes) : ' · el piso del mínimo diario te deja cobrando lo mismo que trabajando') +
          (truncado ? ' · desde el día 181 paga el fondo de pensiones, no la EPS' : '');

        chart = [
          { label: 'Paga el empleador', value: Math.round(pagaEmpleador), tone: 'prop' },
          { label: 'Paga la EPS', value: Math.round(pagaEps), tone: 'main' },
          { label: 'Dejás de percibir', value: Math.round(perdes), tone: 'bad' },
        ].filter((s) => s.value > 0);
      } else if (id === 'maternidad' || id === 'paternidad') {
        const esMaternidad = id === 'maternidad';
        const diasLey = esMaternidad ? MATERNIDAD.dias : PATERNIDAD.dias;
        const semanas = esMaternidad ? MATERNIDAD.semanas : PATERNIDAD.semanas;
        // Piso: la licencia tampoco puede pagar menos que el mínimo diario proporcional.
        const diaLicencia = Math.max(valorDia, SMDLV);
        const pagaEps = diaLicencia * diasLey;
        const pagaEmpleador = diaLicencia * diasExtra;
        const cobras = pagaEps + pagaEmpleador;

        rows.push({
          k: 'Días de licencia de ley',
          ref: semanas + (semanas === 1 ? ' semana' : ' semanas') + ' · Ley 1822/2017',
          v: diasLey,
          format: 'unit',
          unit: 'días',
        });
        rows.push({ k: 'Valor del día de licencia', ref: valorDia < SMDLV ? 'Elevado al mínimo diario' : '100% del IBC', v: diaLicencia });
        rows.push({ k: 'Lo que paga la EPS', ref: 'Los ' + diasLey + ' días de ley, al 100%', v: pagaEps, extra: true });
        if (diasExtra > 0) {
          rows.push({ k: 'Días negociados por encima de la ley', ref: 'Los paga el empleador, no la EPS', v: pagaEmpleador });
        }
        rows.push({ k: 'Total de la licencia', ref: 'EPS + empleador', v: cobras, extra: true });
        rows.push({
          k: 'Equivalente en meses de tu IBC',
          ref: 'Total ÷ IBC mensual',
          v: ibc > 0 ? cobras / ibc : 0,
          format: 'unit',
          unit: 'meses de sueldo',
          decimals: 1,
        });
        if (esMaternidad) {
          rows.push({
            k: 'Semanas que podés tomar antes del parto',
            ref: 'Mínimo ' + MATERNIDAD.semanasPreparto + ', hasta ' + MATERNIDAD.semanasPrepartoMax,
            v: MATERNIDAD.semanasPrepartoMax,
            format: 'unit',
            unit: 'semanas',
          });
        }

        total = cop(cobras);
        sub =
          semanas + (semanas === 1 ? ' semana' : ' semanas') + ' de licencia al 100% del IBC: ' + cop(pagaEps) +
          ' los paga la EPS' + (diasExtra > 0 ? ' y ' + cop(pagaEmpleador) + ' el empleador por los días negociados' : '') +
          ' · se liquida sobre el IBC reportado, no sobre lo que recibís en mano';

        chart = [
          { label: 'Paga la EPS', value: Math.round(pagaEps), tone: 'main' },
          { label: 'Paga el empleador (días negociados)', value: Math.round(pagaEmpleador), tone: 'prop' },
        ].filter((s) => s.value > 0);
      } else {
        // Mecanismo de Protección al Cesante: aportes sobre 1 SMLMV + cuota monetaria.
        const aportes = SMLMV * CESANTE.tasaAportes;
        const cuota = cuotaFamiliar * personas;
        const mensual = aportes + cuota;
        const totalMax = mensual * CESANTE.mesesMax;
        const salarioPerdido = ibc * CESANTE.mesesMax;

        rows.push({ k: 'Aportes a salud y pensión que asume la Caja', ref: (CESANTE.tasaAportes * 100).toString().replace('.', ',') + '% de 1 SMLMV', v: aportes });
        rows.push({ k: 'Cuota monetaria por ' + personas + (personas === 1 ? ' persona a cargo' : ' personas a cargo'), ref: cop(cuotaFamiliar) + ' cada una · varía por Caja', v: cuota });
        rows.push({ k: 'Beneficio mensual', ref: 'Aportes + cuota monetaria', v: mensual, extra: true });
        rows.push({
          k: 'Meses de beneficio',
          ref: 'Ley 1636/2013',
          v: CESANTE.mesesMax,
          format: 'unit',
          unit: 'meses',
        });
        rows.push({ k: 'Beneficio total por los ' + CESANTE.mesesMax + ' meses', ref: 'Techo del mecanismo', v: totalMax, extra: true });
        rows.push({ k: 'Plata que efectivamente pasa por tu cuenta', ref: 'Sólo la cuota monetaria: los aportes van al sistema', v: cuota * CESANTE.mesesMax });
        rows.push({ k: 'Sueldo que dejás de recibir en esos ' + CESANTE.mesesMax + ' meses', ref: 'IBC × ' + CESANTE.mesesMax, v: salarioPerdido });
        rows.push({
          k: 'Qué porcentaje de tu sueldo cubre el beneficio',
          ref: 'Beneficio ÷ sueldo perdido',
          v: salarioPerdido > 0 ? (totalMax / salarioPerdido) * 100 : 0,
          format: 'unit',
          unit: '%',
          decimals: 1,
        });

        total = cop(mensual);
        sub =
          'El mecanismo cubre ' + cop(mensual) + ' al mes por hasta ' + CESANTE.mesesMax + ' meses (' + cop(totalMax) +
          '), pero sólo ' + cop(cuota) + ' pasan por tu cuenta: el resto son tus aportes a salud y pensión sobre un salario mínimo';

        chart = [
          { label: 'Aportes que paga la Caja', value: Math.round(aportes * CESANTE.mesesMax), tone: 'main' },
          { label: 'Cuota monetaria a tu bolsillo', value: Math.round(cuota * CESANTE.mesesMax), tone: 'prop' },
          { label: 'Sueldo que no cubre nadie', value: Math.round(Math.max(0, salarioPerdido - totalMax)), tone: 'bad' },
        ].filter((s) => s.value > 0);
      }

      // La salud te sigue costando en cualquiera de las cuatro ramas.
      rows.push({ k: 'Cuotas moderadoras estimadas en el año', ref: cop(cuotaModeradora) + ' × ' + servicios + ' servicios', v: gastoModeradoras });
      rows.push({
        k: 'Copago sobre atenciones, según tu rango',
        ref: 'Rango ' + rango.id + ' (' + rango.label + ') · Acuerdo 260/2004',
        v: rango.pctServicio * 100,
        format: 'unit',
        unit: '% del valor del servicio',
        decimals: 1,
      });
      rows.push({ k: 'Tope anual de copagos de tu rango', ref: rango.topeAnualSmlmv.toString().replace('.', ',') + ' SMLMV · verificá el valor con tu EPS', v: topeCopagoAnual });

      return { total: total, sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
