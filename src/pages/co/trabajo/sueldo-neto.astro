---
/**
 * Hub de decisión CO — "¿Cuánto me queda en mano del sueldo?"
 *
 * El audience="CO" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SueldoNetoColombiaExperience from '../../../components/generated/SueldoNetoColombiaExperience.astro';
import {
  hub,
  SMLMV,
  AUXILIO,
  TOPE_AUXILIO_SMLMV,
  UVT,
  APORTES,
  FSP,
  ART383,
  EXENTA_LABORAL,
  LIMITE_336,
  INTEGRAL,
  APRENDIZ,
  EMBARGO,
  JORNADA,
} from '../../../lib/hubs/co/sueldo-neto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoNetoColombiaExperience data={hub} />
  <p class="hc-data-source">Dato oficial de referencia: <a href="/co/datos-salario-minimo-colombia-2026">salario mínimo de Colombia 2026, auxilio de transporte y valor diario</a>.</p>
  <Footer />
</Layout>

<style>.hc-data-source{max-width:1120px;margin:0 auto 2rem;padding:0 1.25rem;color:#475569}.hc-data-source a{font-weight:700}</style>
