---
/**
 * Hub de decisión CO — "¿Cuánto me queda en mano del sueldo?"
 *
 * El audience="CO" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SueldoNetoColombiaExperience from '../../../components/generated/SueldoNetoColombiaExperience.astro';
import {
  hub,
  SMLMV,
  AUXILIO,
  TOPE_AUXILIO_SMLMV,
  UVT,
  APORTES,
  FSP,
  ART383,
  EXENTA_LABORAL,
  LIMITE_336,
  INTEGRAL,
  APRENDIZ,
  EMBARGO,
  JORNADA,
} from '../../../lib/hubs/co/sueldo-neto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoNetoColombiaExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    SMLMV,
    AUXILIO,
    TOPE_AUXILIO_SMLMV,
    UVT,
    APORTES,
    FSP,
    ART383,
    EXENTA_LABORAL,
    LIMITE_336,
    INTEGRAL,
    APRENDIZ,
    EMBARGO,
    JORNADA,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');

    /**
     * Tasa del Fondo de Solidaridad Pensional según el IBC, con la escala REAL de
     * la Ley 100 (1% a 2%). La calc vieja cobraba 1% plano incluso arriba de 16
     * SMLMV, donde la ley manda 1,4% o más.
     */
    function tasaFsp(ibc) {
      const enSmlmv = ibc / SMLMV;
      for (const t of FSP) {
        const hasta = t.hasta === null ? Infinity : t.hasta;
        if (enSmlmv >= t.desde && enSmlmv < hasta) return t.tasa;
      }
      return 0;
    }

    /** Retención salarial mensual del art. 383 ET sobre la base gravable en COP. */
    function retefuente(baseCop) {
      const baseUvt = Math.max(0, baseCop) / UVT;
      for (const t of ART383) {
        const hasta = t.hasta === null ? Infinity : t.hasta;
        if (baseUvt > t.desde && baseUvt <= hasta) {
          return {
            valor: ((baseUvt - t.desde) * t.tasa + t.adicion) * UVT,
            marginal: t.tasa * 100,
            baseUvt: baseUvt,
          };
        }
      }
      return { valor: 0, marginal: 0, baseUvt: baseUvt };
    }

    /** Lo embargable por deuda común: el SMLMV es intocable, del resto 1/5 (arts. 154-155 CST). */
    function embargable(salarioTotal) {
      return Math.max(0, salarioTotal - SMLMV) * EMBARGO.excedenteEmbargable;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'ordinario';
      const salarioIngresado = Math.max(0, v.salario || 0);
      const deducciones = Math.max(0, v.deducciones || 0);
      const otros = Math.max(0, v.otros || 0);
      const quiereAuxilio = String(v.auxilio || 'si') === 'si';
      const etapaLectiva = String(v.etapa || 'productiva') === 'lectiva';

      const rows = [];
      // ── Salario del mes según la rama ──────────────────────────────────────
      let salario = salarioIngresado;
      let notaRama = '';
      let baseAportes;           // IBC sobre el que caen salud, pensión y FSP
      let permiteAuxilio = true;
      let aplicaPension = true;

      if (id === 'aprendiz') {
        const pct = etapaLectiva
          ? APRENDIZ.lectivaPorcentajeSmlmv
          : APRENDIZ.productivaPorcentajeSmlmv;
        salario = SMLMV * pct;
        baseAportes = salario;
        permiteAuxilio = false;
        // Etapa lectiva: EPS y ARL las paga el empleador; el aprendiz no aporta pensión.
        aplicaPension = !etapaLectiva;
        notaRama = etapaLectiva
          ? 'Etapa lectiva: ' + Math.round(pct * 100) + '% del SMLMV, con EPS y ARL a cargo de la empresa'
          : 'Etapa productiva: ' + Math.round(pct * 100) + '% del SMLMV, ya con aportes de salud y pensión';
        rows.push({
          k: 'Apoyo de sostenimiento del aprendiz',
          ref: Math.round(pct * 100) + '% del SMLMV · Ley 2466/2025 art. 21',
          v: salario,
        });
      } else if (id === 'integral') {
        baseAportes = salario * INTEGRAL.ibcFactor;
        permiteAuxilio = false;
        const minimo = SMLMV * INTEGRAL.minimoSmlmv;
        notaRama =
          salario >= minimo - 0.5
            ? 'Salario integral válido: supera el mínimo de ' + INTEGRAL.minimoSmlmv + ' SMLMV'
            : 'Ojo: no llega al mínimo de ' + INTEGRAL.minimoSmlmv + ' SMLMV, el pacto de integralidad no valdría';
        rows.push({ k: 'Salario integral pactado', ref: 'Art. 132 CST', v: salario });
        rows.push({
          k: 'Mínimo legal para pactar integral',
          ref: INTEGRAL.minimoSmlmv + ' SMLMV (10 + ' + Math.round(INTEGRAL.factorPrestacional * 100) + '% prestacional)',
          v: minimo,
        });
        rows.push({
          k: 'Base de aportes (factor salarial)',
          ref: Math.round(INTEGRAL.ibcFactor * 100) + '% del integral · art. 132 CST',
          v: baseAportes,
        });
      } else {
        // Ordinario y mínimo comparten motor; la rama "mínimo" además avisa del piso legal.
        if (id === 'minimo' && salario < SMLMV) {
          salario = SMLMV;
          notaRama = 'Lo que cargaste está por debajo del mínimo legal: la cuenta usa el SMLMV, que es irrenunciable';
        }
        baseAportes = salario;
        rows.push({ k: 'Salario del mes', ref: id === 'minimo' ? 'SMLMV Decreto 1469/2025' : 'Bruto pactado', v: salario });
      }

      // Tope y piso del IBC (Ley 797/2003): 1 a 25 SMLMV.
      const ibcTope = SMLMV * APORTES.ibcTopeSmlmv;
      const ibcSinTopear = baseAportes;
      const ibc = Math.min(Math.max(baseAportes, SMLMV * APORTES.ibcMinimoSmlmv), ibcTope);
      if (ibcSinTopear > ibcTope) {
        rows.push({
          k: 'Ingreso base de cotización (topeado)',
          ref: 'Tope de ' + APORTES.ibcTopeSmlmv + ' SMLMV · Ley 797/2003',
          v: ibc,
        });
      }

      // ── Auxilio de transporte ─────────────────────────────────────────────
      const topeAuxilio = SMLMV * TOPE_AUXILIO_SMLMV;
      const correspondeAuxilio = permiteAuxilio && quiereAuxilio && salario <= topeAuxilio;
      const auxilio = correspondeAuxilio ? AUXILIO : 0;
      if (permiteAuxilio) {
        rows.push({
          k: correspondeAuxilio ? 'Auxilio de transporte (se suma)' : 'Auxilio de transporte que no corresponde',
          ref: correspondeAuxilio
            ? 'Decreto 1470/2025 · no paga aportes'
            : 'Se pierde arriba de ' + TOPE_AUXILIO_SMLMV + ' SMLMV (' + cop(topeAuxilio) + ')',
          v: auxilio,
        });
      }

      // ── Aportes de ley del trabajador ─────────────────────────────────────
      const salud = ibc * APORTES.salud;
      const pension = aplicaPension ? ibc * APORTES.pension : 0;
      const tasaFspAplicada = tasaFsp(ibc);
      const fsp = aplicaPension ? ibc * tasaFspAplicada : 0;

      rows.push({ k: 'Salud (se resta)', ref: Math.round(APORTES.salud * 100) + '% · Ley 100/1993', v: salud });
      rows.push({
        k: aplicaPension ? 'Pensión (se resta)' : 'Pensión (no aplica en etapa lectiva)',
        ref: Math.round(APORTES.pension * 100) + '% · Ley 100/1993',
        v: pension,
      });
      rows.push({
        k: fsp > 0 ? 'Fondo de Solidaridad Pensional (se resta)' : 'Fondo de Solidaridad Pensional (no te aplica)',
        ref:
          fsp > 0
            ? (tasaFspAplicada * 100).toLocaleString('es-CO', { maximumFractionDigits: 1 }) + '% · escala Ley 100 art. 27'
            : 'Sólo desde ' + FSP[0].desde + ' SMLMV (' + cop(FSP[0].desde * SMLMV) + ')',
        v: fsp,
      });

      // ── Depuración para la retención (arts. 206-10, 336 y 383 ET) ──────────
      const rentaLiquida = Math.max(0, salario - salud - pension - fsp);
      const topeExentaMes = (EXENTA_LABORAL.topeAnualUvt * UVT) / 12;
      const exenta = Math.min(rentaLiquida * EXENTA_LABORAL.porcentaje, topeExentaMes);
      // Art. 336 ET: deducciones + rentas exentas ≤ menor(40% renta líquida, 1.340 UVT/año).
      const tope336 = Math.min(rentaLiquida * LIMITE_336.pct, (LIMITE_336.topeUvt * UVT) / 12);
      const beneficiosBrutos = exenta + deducciones;
      const beneficiosAplicados = Math.min(beneficiosBrutos, tope336);
      const recorte = Math.max(0, beneficiosBrutos - beneficiosAplicados);
      const baseGravable = Math.max(0, rentaLiquida - beneficiosAplicados);
      const ret = retefuente(baseGravable);
      const retencion = Math.round(ret.valor);

      rows.push({ k: 'Renta líquida (salario menos aportes obligatorios)', ref: 'Base de la depuración', v: rentaLiquida });
      rows.push({
        k: 'Renta exenta del ' + Math.round(EXENTA_LABORAL.porcentaje * 100) + '%',
        ref: 'Tope ' + EXENTA_LABORAL.topeAnualUvt.toLocaleString('es-CO') + ' UVT/año · art. 206-10 ET',
        v: exenta,
      });
      if (deducciones > 0) {
        rows.push({ k: 'Deducciones informadas al empleador', ref: 'Dependientes, vivienda, prepagada, AFC', v: deducciones });
      }
      if (recorte > 0) {
        rows.push({
          k: 'Beneficios recortados por el límite global',
          ref: 'Menor entre ' + Math.round(LIMITE_336.pct * 100) + '% y ' + LIMITE_336.topeUvt.toLocaleString('es-CO') + ' UVT/año · art. 336 ET',
          v: recorte,
        });
      }
      rows.push({ k: 'Base gravable de la retención', ref: 'Art. 383 ET', v: baseGravable });
      rows.push({
        k: 'Base gravable en UVT',
        ref: 'Retención desde ' + ART383[1].desde + ' UVT',
        v: ret.baseUvt,
        format: 'unit',
        unit: 'UVT',
        decimals: 1,
      });
      rows.push({ k: 'Retención en la fuente (se resta)', ref: 'Anticipo del impuesto de renta', v: retencion });
      if (otros > 0) {
        rows.push({ k: 'Otros descuentos autorizados (se restan)', ref: 'Libranzas, cooperativa, embargos', v: otros });
      }

      // ── Neto ───────────────────────────────────────────────────────────────
      const descuentosLey = salud + pension + fsp + retencion;
      const neto = Math.max(0, salario + auxilio - descuentosLey - otros);
      const pctDescuento = salario > 0 ? (descuentosLey / salario) * 100 : 0;

      rows.push({ k: 'Total de descuentos de ley', ref: 'Salud + pensión + FSP + retención', v: descuentosLey });
      rows.push({ k: 'Neto que te llega a la cuenta', ref: 'Salario + auxilio − descuentos', v: neto, extra: true });
      rows.push({
        k: 'Cuánto se te va en descuentos de ley',
        ref: 'Sobre el salario bruto',
        v: pctDescuento,
        format: 'unit',
        unit: '%',
        decimals: 2,
      });

      // Valor hora con el divisor vigente HOY (Ley 2101/2021: 210 desde el 15-jul-2026).
      const hoy = new Date();
      const divisor =
        hoy >= new Date('2026-07-15')
          ? JORNADA.divisorMensualDesde15Jul2026
          : JORNADA.divisorMensualHasta14Jul2026;
      rows.push({
        k: 'Valor de tu hora ordinaria',
        ref: 'Salario ÷ ' + divisor + ' · jornada de ' + (divisor === JORNADA.divisorMensualDesde15Jul2026 ? JORNADA.horasSemanaDesde15Jul2026 : JORNADA.horasSemanaHasta14Jul2026) + ' h',
        v: salario / divisor,
      });
      rows.push({
        k: 'Tu salario medido en salarios mínimos',
        ref: 'SMLMV ' + cop(SMLMV),
        v: salario / SMLMV,
        format: 'unit',
        unit: 'SMLMV',
        decimals: 2,
      });

      // Embargabilidad (arts. 154-156 CST).
      const embComun = embargable(salario);
      rows.push({
        k: embComun > 0 ? 'Máximo embargable por deuda común' : 'Máximo embargable por deuda común (sos inembargable)',
        ref: 'SMLMV intocable + 1/5 del excedente · arts. 154-155 CST',
        v: embComun,
      });
      rows.push({
        k: 'Máximo embargable por alimentos o cooperativas',
        ref: Math.round(EMBARGO.topeAlimentosCooperativas * 100) + '% de todo el salario · art. 156 CST',
        v: salario * EMBARGO.topeAlimentosCooperativas,
      });

      const sub =
        (notaRama ? notaRama + ' · ' : '') +
        'te descuentan ' + cop(descuentosLey) + ' (' + pctDescuento.toFixed(1).replace('.', ',') + '% del bruto)' +
        (retencion > 0
          ? ' · con retención en la fuente al ' + ret.marginal + '% marginal'
          : ' · sin retención en la fuente') +
        (auxilio > 0 ? ' · más ' + cop(auxilio) + ' de auxilio de transporte' : '');

      const chart = [
        { label: 'Lo que te queda en mano', value: Math.round(neto), tone: 'main' },
        { label: 'Salud ' + Math.round(APORTES.salud * 100) + '%', value: Math.round(salud), tone: 'good' },
        { label: 'Pensión ' + Math.round(APORTES.pension * 100) + '%', value: Math.round(pension), tone: 'prop' },
        { label: 'Fondo de Solidaridad Pensional', value: Math.round(fsp), tone: 'warn' },
        { label: 'Retención en la fuente', value: retencion, tone: 'bad' },
        { label: 'Otros descuentos autorizados', value: Math.round(otros), tone: 'exit' },
      ].filter(function (s) { return s.value > 0; });

      return { total: cop(neto), sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
