---
/**
 * Hub de decisión CO — "¿Cuánto me tienen que pagar por esa hora?"
 *
 * El audience="CO" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  SMLMV,
  JORNADA,
  RECARGOS,
  CORTES,
  TOPE_EXTRAS,
  FESTIVOS_2026,
} from '../../../lib/hubs/co/horas-extras-y-recargos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    SMLMV,
    JORNADA,
    RECARGOS,
    CORTES,
    TOPE_EXTRAS,
    FESTIVOS_2026,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');
    const pctTxt = (n) => (n * 100).toLocaleString('es-CO', { maximumFractionDigits: 0 }) + '%';

    /** Comparar ISO 'YYYY-MM-DD' lexicográficamente = comparar cronológicamente. */
    function normalizarFecha(f) {
      const s = String(f || '').trim();
      return /^\d{4}-\d{2}-\d{2}$/.test(s) ? s : '2026-07-28';
    }

    /** Divisor del valor hora vigente a esa fecha (Ley 2101/2021: 220 → 210 el 15-jul-2026). */
    function divisorDe(fecha) {
      return fecha >= CORTES.jornada42
        ? JORNADA.divisorMensualDesde15Jul2026
        : JORNADA.divisorMensualHasta14Jul2026;
    }

    /** Recargo dominical vigente a esa fecha (Ley 2466/2025: 80% → 90% → 100%). */
    function dominicalDe(fecha) {
      if (fecha >= CORTES.dominical100) return RECARGOS.dominicalFestivoDesde01Jul2027;
      if (fecha >= CORTES.dominical90) return RECARGOS.dominicalFestivoDesde01Jul2026;
      return RECARGOS.dominicalFestivoHasta30Jun2026;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'extra-diurna';
      const salario = Math.max(0, v.salario || 0);
      const horas = Math.max(0, v.horas || 0);
      const fecha = normalizarFecha(v.fecha);
      const esNocturno = String(v.nocturno || 'no') === 'si';

      const divisor = divisorDe(fecha);
      const jornadaSemanal =
        divisor === JORNADA.divisorMensualDesde15Jul2026
          ? JORNADA.horasSemanaDesde15Jul2026
          : JORNADA.horasSemanaHasta14Jul2026;
      const horaOrdinaria = salario / divisor;
      const recargoDom = dominicalDe(fecha);

      // ── Recargo de la modalidad elegida ───────────────────────────────────
      // El 75% de la extra nocturna YA comprende la nocturnidad: no se le suma el 35%.
      let recargo = 0;
      let etiqueta = '';
      let refLegal = '';
      if (id === 'extra-diurna') {
        recargo = RECARGOS.extraDiurna;
        etiqueta = 'Hora extra diurna';
        refLegal = 'Art. 168 CST';
      } else if (id === 'extra-nocturna') {
        recargo = RECARGOS.extraNocturna;
        etiqueta = 'Hora extra nocturna';
        refLegal = 'Art. 168 CST · incluye la nocturnidad';
      } else if (id === 'recargo-nocturno') {
        recargo = RECARGOS.nocturno;
        etiqueta = 'Recargo nocturno sobre jornada ordinaria';
        refLegal = 'Art. 168 CST · desde las ' + RECARGOS.horaInicioNocturna + ':00';
      } else {
        recargo = recargoDom + (esNocturno ? RECARGOS.nocturno : 0);
        etiqueta = esNocturno ? 'Domingo o festivo de noche' : 'Domingo o festivo';
        refLegal = 'Arts. 179-180 CST · Ley 2466/2025';
      }

      const factor = 1 + recargo;
      const valorHoraModalidad = horaOrdinaria * factor;
      const soloRecargo = horaOrdinaria * recargo;
      const pagoTotal = horas * valorHoraModalidad;
      const plusTotal = horas * soloRecargo;

      const rows = [
        { k: 'Salario mensual', ref: 'Base del cálculo', v: salario },
        {
          k: 'Valor de tu hora ordinaria',
          ref: 'Salario ÷ ' + divisor + ' · jornada de ' + jornadaSemanal + ' h/semana',
          v: horaOrdinaria,
        },
        {
          k: 'Recargo que te corresponde',
          ref: refLegal,
          v: recargo * 100,
          format: 'unit',
          unit: '%',
          decimals: 0,
        },
        {
          k: 'Factor sobre la hora ordinaria',
          ref: '1 + recargo',
          v: factor,
          format: 'plain',
          decimals: 2,
        },
        { k: 'Valor de esa hora — ' + etiqueta, ref: 'Hora ordinaria × factor', v: valorHoraModalidad },
        { k: 'Sólo el plus por hora', ref: 'Lo que suma el recargo', v: soloRecargo },
        {
          k: 'Horas que estás liquidando',
          ref: 'Del período',
          v: horas,
          format: 'unit',
          unit: 'horas',
          decimals: 0,
        },
        { k: 'Total a pagar por esas horas', ref: etiqueta, v: pagoTotal, extra: true },
        { k: 'De ese total, cuánto es puro recargo', ref: 'Sobre el pago base de las mismas horas', v: plusTotal },
      ];

      // Cuánto cambia el número por las dos transiciones de 2026.
      const horaVieja = salario / JORNADA.divisorMensualHasta14Jul2026;
      const horaNueva = salario / JORNADA.divisorMensualDesde15Jul2026;
      rows.push({
        k: 'Cuánto subió tu hora con la jornada de ' + JORNADA.horasSemanaDesde15Jul2026 + ' h',
        ref: 'Divisor ' + JORNADA.divisorMensualHasta14Jul2026 + ' → ' + JORNADA.divisorMensualDesde15Jul2026 + ' · Ley 2101/2021',
        v: horaNueva - horaVieja,
      });
      rows.push({
        k: 'Ese salto en porcentaje',
        ref: 'Sobre el valor de la hora ordinaria',
        v: (horaNueva / horaVieja - 1) * 100,
        format: 'unit',
        unit: '%',
        decimals: 2,
      });

      if (id === 'dominical') {
        const base = horas * horaOrdinaria;
        const extraNoct = esNocturno ? RECARGOS.nocturno : 0;
        rows.push({
          k: 'Las mismas horas con el recargo del ' + pctTxt(RECARGOS.dominicalFestivoHasta30Jun2026),
          ref: 'Régimen hasta el 30-jun-2026',
          v: horas * (salario / JORNADA.divisorMensualHasta14Jul2026) * (1 + RECARGOS.dominicalFestivoHasta30Jun2026 + extraNoct),
        });
        rows.push({
          k: 'Las mismas horas con el recargo del ' + pctTxt(RECARGOS.dominicalFestivoDesde01Jul2027),
          ref: 'Desde el 01-jul-2027 · Ley 2466/2025',
          v: horas * horaNueva * (1 + RECARGOS.dominicalFestivoDesde01Jul2027 + extraNoct),
        });
        rows.push({
          k: 'Festivos nacionales en el año',
          ref: FESTIVOS_2026.lunes + ' caen lunes y arman puente',
          v: FESTIVOS_2026.total,
          format: 'unit',
          unit: 'festivos',
          decimals: 0,
        });
        void base;
      } else if (id !== 'recargo-nocturno') {
        rows.push({
          k: 'Tope legal de horas extras al mes',
          ref: TOPE_EXTRAS.porDia + '/día y ' + TOPE_EXTRAS.porSemana + '/semana · Ley 50/1990 art. 22',
          v: TOPE_EXTRAS.porMesAprox,
          format: 'unit',
          unit: 'horas',
          decimals: 0,
        });
        if (horas > TOPE_EXTRAS.porMesAprox) {
          rows.push({
            k: 'Horas por encima del tope legal',
            ref: 'Se deben pagar igual, pero el tope se está incumpliendo',
            v: horas - TOPE_EXTRAS.porMesAprox,
            format: 'unit',
            unit: 'horas',
            decimals: 0,
          });
        }
      }

      // ── Escalera de recargos (gráfico posicional 'steps') ─────────────────
      // Eje: puntos porcentuales de recargo, de 0 al máximo (dominical + nocturno).
      const domPct = recargoDom * 100;
      const nocPct = RECARGOS.nocturno * 100;
      const maxPct = domPct + nocPct;
      const escalones = [
        { label: 'Hora ordinaria', from: 0, to: RECARGOS.extraDiurna * 100, tone: 'good' },
        { label: 'Extra diurna ' + pctTxt(RECARGOS.extraDiurna), from: RECARGOS.extraDiurna * 100, to: nocPct, tone: 'main' },
        { label: 'Recargo nocturno ' + pctTxt(RECARGOS.nocturno), from: nocPct, to: RECARGOS.extraNocturna * 100, tone: 'prop' },
        { label: 'Extra nocturna ' + pctTxt(RECARGOS.extraNocturna), from: RECARGOS.extraNocturna * 100, to: domPct, tone: 'warn' },
        { label: 'Dominical o festivo ' + pctTxt(recargoDom), from: domPct, to: maxPct, tone: 'bad' },
      ];
      const miPct = recargo * 100;
      const position = maxPct > 0 ? Math.min(100, Math.max(0, (miPct / maxPct) * 100)) : 0;

      const sub =
        etiqueta + ' · hora ordinaria ' + cop(horaOrdinaria) + ' (÷' + divisor + ')' +
        ' · con recargo del ' + pctTxt(recargo) + ' cada hora vale ' + cop(valorHoraModalidad) +
        (fecha >= CORTES.jornada42
          ? ' · ya te aplica la jornada de ' + JORNADA.horasSemanaDesde15Jul2026 + ' horas'
          : ' · todavía con la jornada de ' + JORNADA.horasSemanaHasta14Jul2026 + ' horas');

      return {
        total: cop(pagoTotal),
        sub: sub,
        rows: rows,
        chart: escalones,
        position: position,
        positionLabel: etiqueta + ': recargo del ' + pctTxt(recargo) + ' — ' + cop(valorHoraModalidad) + ' por hora',
      };
    });
  })();
</script>
