---
/**
 * Silo Vida · Colombia — índice de hubs de decisión del mercado CO.
 * Existe para que el breadcrumb de los hubs colombianos no apunte a un 404 y para
 * repartir link equity entre hermanos. El listado sale del registry, no a mano.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';

const HREF = '/co/vida';
const SILO = 'Vida';
const LEDE =
  'Arriendo, servicios públicos, costo de vida, familia y estudio en Colombia, con los datos del DANE y las tarifas vigentes de cada operador.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${SILO} en Colombia`,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title={`Vida cotidiana en Colombia — arriendo, recibos y costo de vida | Hacé Cuentas`}
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
