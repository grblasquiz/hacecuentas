---
/**
 * Hub de decisión CO — "¿Por qué me llegó tan caro el recibo?".
 * Las tarifas viajan como valores de referencia editables: la CREG y la CRA las recalculan
 * cada mes, así que ninguna se trata como constante dura en el cálculo.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import RecibosServiciosColombiaExperience from '../../../components/generated/RecibosServiciosColombiaExperience.astro';
import {
  hub,
  FACTOR_ESTRATO,
  SUBSISTENCIA,
  INTERNET_REF,
  TARIFAS_REF_FECHA,
} from '../../../lib/hubs/co/recibos-de-servicios';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <RecibosServiciosColombiaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

