---
/**
 * Hub de decisión CO — "¿Por qué me llegó tan caro el recibo?".
 * Las tarifas viajan como valores de referencia editables: la CREG y la CRA las recalculan
 * cada mes, así que ninguna se trata como constante dura en el cálculo.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  FACTOR_ESTRATO,
  SUBSISTENCIA,
  INTERNET_REF,
  TARIFAS_REF_FECHA,
} from '../../../lib/hubs/co/recibos-de-servicios';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    FACTOR: FACTOR_ESTRATO,
    SUB: SUBSISTENCIA,
    INTERNET: INTERNET_REF,
    REF_FECHA: TARIFAS_REF_FECHA,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');
    const num = (n) => Math.round(n || 0).toLocaleString('es-CO');

    const META = {
      luz: { unidad: 'kWh', tarifaKey: 'tarifaLuz', nombre: 'energía', regulador: 'CREG' },
      gas: { unidad: 'm³', tarifaKey: 'tarifaGas', nombre: 'gas natural', regulador: 'CREG' },
      agua: { unidad: 'm³', tarifaKey: 'tarifaAgua', nombre: 'acueducto y alcantarillado', regulador: 'CRA' },
    };

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'luz';
      const estrato = Math.min(6, Math.max(1, Math.round(Number(v.estrato) || 3)));
      const factor = FACTOR[estrato] !== undefined ? FACTOR[estrato] : 0;
      const alta = String(v.altitud || 'alta') === 'alta';
      const rows = [];

      if (id === 'internet') {
        const plan = Math.max(0, v.planInternet || 0);
        const anual = plan * 12;
        const masBarato = INTERNET.planes[0];
        const masCaro = INTERNET.planes[INTERNET.planes.length - 1];
        const difVsBarato = plan - masBarato.precio;
        const excluidoIva = estrato <= 2;
        const ivaImplicito = excluidoIva ? 0 : plan - plan / 1.19;

        rows.push({ k: 'Lo que pagás por mes', ref: 'Precio real, no promocional', v: plan, extra: true });
        rows.push({ k: 'Lo que pagás en el año', ref: 'Doce mensualidades', v: anual });
        rows.push({
          k: excluidoIva ? 'IVA (excluido en estratos 1 y 2)' : 'IVA que ya viene incluido en el precio de lista',
          ref: excluidoIva ? 'Art. 476 ET' : '19% dentro del precio publicado',
          v: ivaImplicito,
        });
        INTERNET.planes.forEach(function (p) {
          rows.push({
            k: 'Referencia ' + p.operador + ' · ' + p.mbps + ' Mbps',
            ref: 'Sólo internet · ' + INTERNET.fecha + ' · precio comercial',
            v: p.precio,
          });
        });
        rows.push({
          k: 'Cargo de instalación del operador que lo cobra',
          ref: 'Se paga una sola vez, al contratar con permanencia',
          v: INTERNET.instalacionTigo,
        });
        rows.push({
          k: difVsBarato > 0 ? 'Cuánto pagás de más contra el plan más barato de la muestra' : 'Cuánto pagás de menos contra el plan más barato de la muestra',
          ref: masBarato.operador + ' ' + masBarato.mbps + ' Mbps',
          v: Math.abs(difVsBarato),
        });
        rows.push({ k: 'Ahorro anual si te pasaras al más barato', ref: 'Antes de instalación y permanencia', v: Math.max(0, difVsBarato) * 12 });

        return {
          total: cop(plan),
          sub:
            'Pagás ' + cop(plan) + ' al mes, ' + cop(anual) + ' en el año · la referencia de ' + INTERNET.fecha +
            ' para 300 Mbps va de ' + cop(masBarato.precio) + ' (' + masBarato.operador + ') a ' + cop(masCaro.precio) +
            ' (' + masCaro.operador + ') · son precios comerciales, verificá antes de firmar',
          rows: rows,
          chart: [
            { label: 'Plan de internet', value: Math.round(plan), tone: 'main' },
            { label: 'Instalación prorrateada al mes', value: Math.round(INTERNET.instalacionTigo / 12), tone: 'prop' },
          ],
        };
      }

      const m = META[id] || META.luz;
      const tarifa = Math.max(0, Number(v[m.tarifaKey]) || 0);
      const consumo = Math.max(0, v.consumo || 0);
      const cargoFijo = Math.max(0, v.cargoFijo || 0);
      const otros = Math.max(0, v.otrosCargos || 0);
      const recorte = Math.max(0, v.ahorro || 0);
      const bloque = alta ? SUB[id].alta : SUB[id].baja;

      const consumoValorizado = consumo * tarifa;
      const subsidiable = Math.min(consumo, bloque);
      const fueraDeBloque = Math.max(0, consumo - bloque);

      // Asimetría legal: el subsidio cubre sólo el bloque de subsistencia; la contribución
      // de los estratos 5 y 6 se cobra sobre el consumo total.
      const ajuste = factor < 0 ? subsidiable * tarifa * factor : consumoValorizado * factor;
      const servicio = consumoValorizado + ajuste;
      const total = cargoFijo + servicio + otros;

      // Ahorro de recortar: lo que está fuera del bloque se ahorra a tarifa plena.
      const recorteFuera = Math.min(recorte, fueraDeBloque);
      const recorteDentro = recorte - recorteFuera;
      const ahorro =
        factor < 0
          ? recorteFuera * tarifa + recorteDentro * tarifa * (1 + factor)
          : recorte * tarifa * (1 + factor);

      rows.push({ k: 'Cargo fijo del servicio', ref: 'Se paga aunque no consumas', v: cargoFijo });
      rows.push({
        k: 'Consumo del mes',
        ref: 'Referencia de tarifa: ' + REF_FECHA + ' · reemplazala por la de tu factura',
        v: consumo,
        format: 'unit',
        unit: m.unidad,
      });
      rows.push({
        k: 'Tarifa que estás aplicando',
        ref: 'La fija la ' + m.regulador + ' y cambia todos los meses',
        v: tarifa,
      });
      rows.push({ k: 'Consumo valorizado a tarifa plena', ref: consumo + ' ' + m.unidad + ' × ' + cop(tarifa), v: consumoValorizado });
      rows.push({
        k: 'Bloque de subsistencia de tu ciudad',
        ref: alta ? 'Desde 1.000 msnm' : 'Por debajo de 1.000 msnm',
        v: bloque,
        format: 'unit',
        unit: m.unidad,
      });
      rows.push({
        k: fueraDeBloque > 0 ? 'Consumo por encima del bloque, sin subsidio' : 'Margen que te queda dentro del bloque subsidiado',
        ref: 'Lo que pasa del bloque se paga a tarifa plena',
        v: fueraDeBloque > 0 ? fueraDeBloque : bloque - consumo,
        format: 'unit',
        unit: m.unidad,
      });
      rows.push({
        k:
          factor < 0
            ? 'Subsidio del estrato ' + estrato + ' (se resta)'
            : factor > 0
              ? 'Contribución de solidaridad del estrato ' + estrato + ' (se suma)'
              : 'Ajuste por estrato ' + estrato + ' (no aplica)',
        ref:
          factor < 0
            ? Math.abs(factor * 100) + '% sobre el bloque de subsistencia · Ley 1117/2006'
            : factor > 0
              ? factor * 100 + '% sobre todo el consumo · Ley 142/1994 art. 89'
              : 'El estrato 4 paga tarifa plena',
        v: Math.abs(ajuste),
      });
      rows.push({ k: 'Costo del servicio con el ajuste del estrato', ref: 'Consumo ± estrato', v: servicio });
      rows.push({ k: 'Otros cargos de la misma factura', ref: 'Alumbrado, aseo, sobretasas, financiaciones', v: otros });
      rows.push({ k: 'Total estimado de la factura', ref: 'Cargo fijo + servicio + otros', v: total, extra: true });
      rows.push({
        k: 'Cuánto te sale cada ' + m.unidad + ' con todo adentro',
        ref: 'Total ÷ consumo',
        v: consumo > 0 ? total / consumo : 0,
        decimals: 0,
      });
      rows.push({
        k: 'Ahorro si bajás ' + num(recorte) + ' ' + m.unidad,
        ref: fueraDeBloque > 0 ? 'Empieza por el consumo no subsidiado: ahí ahorrás más' : 'Dentro del bloque, el ahorro es la tarifa menos el subsidio',
        v: ahorro,
        extra: true,
      });
      rows.push({ k: 'Ese ahorro en el año', ref: 'Doce meses', v: ahorro * 12 });
      rows.push({ k: 'Lo que gastás en el año con el consumo actual', ref: 'Doce facturas iguales', v: total * 12 });

      const sub =
        'Factura estimada de ' + cop(total) + ' por ' + num(consumo) + ' ' + m.unidad + ' de ' + m.nombre +
        ' · ' +
        (factor < 0
          ? 'el estrato ' + estrato + ' te descuenta ' + cop(Math.abs(ajuste)) + ' sobre los primeros ' + num(bloque) + ' ' + m.unidad
          : factor > 0
            ? 'el estrato ' + estrato + ' te suma ' + cop(ajuste) + ' de contribución sobre todo el consumo'
            : 'el estrato 4 paga tarifa plena, sin subsidio ni contribución') +
        ' · bajando ' + num(recorte) + ' ' + m.unidad + ' ahorrás ' + cop(ahorro) + ' al mes';

      return {
        total: cop(total),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Cargo fijo', value: Math.round(cargoFijo), tone: 'prop' },
          { label: 'Consumo a tarifa plena', value: Math.round(consumoValorizado), tone: 'main' },
          {
            label: factor < 0 ? 'Subsidio del estrato' : 'Contribución del estrato',
            value: Math.round(Math.abs(ajuste)),
            tone: factor < 0 ? 'good' : 'bad',
          },
          { label: 'Otros cargos', value: Math.round(otros), tone: 'warn' },
        ].filter((s) => s.value > 0),
      };
    });
  })();
</script>
