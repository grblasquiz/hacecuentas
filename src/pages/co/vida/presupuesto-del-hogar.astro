---
/**
 * Hub de decisión CO — "¿Cuánto necesito al mes para vivir en Colombia y con qué ayudas cuento?"
 * Gasto del hogar por ciudad y composición, fondo de emergencia y transferencias del Estado.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import PresupuestoHogarColombiaExperience from '../../../components/generated/PresupuestoHogarColombiaExperience.astro';
import {
  hub,
  SMLMV,
  AUXILIO_TRANSPORTE,
  APORTES_EMPLEADO,
  IVA_DPS,
  BASE_MENSUAL,
  CIUDADES,
  NIVELES,
  FONDO_MESES,
} from '../../../lib/hubs/co/presupuesto-del-hogar';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PresupuestoHogarColombiaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

