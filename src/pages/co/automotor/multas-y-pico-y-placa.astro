---
/**
 * Hub de decisión CO — "Pico y placa y comparendos".
 * Ruta bajo el prefijo /co/, igual que las calculadoras que absorbe.
 * audience="CO" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  MULTAS,
  HORARIOS,
  RESTRICCION,
  CIUDADES,
  SOLIDARIO,
} from '../../../lib/hubs/co/multas-y-pico-y-placa';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MULTAS, HORARIOS, RESTRICCION, CIUDADES, SOLIDARIO }}>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'circular';
      const ciudad = String(v.ciudad || 'bogota');
      const digito = Math.max(0, Math.min(9, Math.round(v.digito || 0)));
      const dia = String(v.dia || 'lunes');
      const periodo = String(v.periodo || 'mes');
      const diasUso = Math.max(1, Math.round(v.diasUso || 1));
      const tipo = String(v.tipo || 'C').toUpperCase();
      const diasHabiles = Math.max(0, Math.round(v.diasHabiles || 0));
      const conCurso = String(v.curso || 'si') === 'si';
      const electronico = String(v.notificacion || 'agente') === 'electronico';
      const km = Math.max(0, v.km || 0);
      const rendimiento = Math.max(1, v.rendimiento || 1);
      const precioGalon = Math.max(0, v.precioGalon || 0);
      const peajes = Math.max(0, v.peajes || 0);

      const rows = [];
      const chart = [];
      const ciudadTxt = CIUDADES[ciudad] || 'Bogotá';

      // ── Pico y placa ──────────────────────────────────────────────────
      const finDeSemana = dia === 'sabado' || dia === 'domingo';
      const restringidos = (RESTRICCION[ciudad] || {})[dia] || [];
      const restringido = !finDeSemana && restringidos.indexOf(digito) !== -1;
      const multaC = MULTAS.C;

      rows.push({
        k: 'Último dígito de tu placa',
        ref: ciudadTxt + ' · ' + dia,
        v: digito,
        format: 'plain',
      });
      rows.push({
        k: finDeSemana ? 'Fin de semana: no hay pico y placa' : restringido ? 'HOY NO podés circular' : 'HOY sí podés circular',
        ref: finDeSemana
          ? 'Sábados, domingos y festivos nacionales están libres'
          : 'Dígitos restringidos ese día: ' + (restringidos.join(' y ') || 'ninguno') + ' · ⚠️ esquema de referencia',
        v: restringido ? 0 : 1,
        format: 'plain',
      });
      if (!finDeSemana) {
        rows.push({
          k: 'Horario de la restricción',
          ref: HORARIOS[ciudad] || '',
          v: 0,
          format: 'plain',
        });
      }

      // ── Permiso solidario ─────────────────────────────────────────────
      const baseSolidario = SOLIDARIO.base[periodo] || SOLIDARIO.base.mes;
      const solidario = baseSolidario;
      const solidarioPorDia = solidario / diasUso;

      // ── Comparendo ────────────────────────────────────────────────────
      const valorMulta = MULTAS[tipo] !== undefined ? MULTAS[tipo] : MULTAS.C;
      const plazo50 = electronico
        ? MULTAS.descuentoProntoPago50.plazoDiasHabilesElectronico
        : MULTAS.descuentoProntoPago50.plazoDiasHabiles;
      const plazo25 = electronico
        ? MULTAS.descuentoProntoPago25.plazoDiasHabilesElectronico
        : MULTAS.descuentoProntoPago25.plazoDiasHabiles;

      let descuento = 0;
      let motivo = '';
      if (tipo === 'E') {
        motivo = 'Tipo E no tiene descuento por pronto pago (Ley 1696 de 2013)';
      } else if (!conCurso) {
        motivo = 'Sin el curso de normas de tránsito no hay descuento';
      } else if (diasHabiles <= plazo50) {
        descuento = MULTAS.descuentoProntoPago50.porcentaje;
        motivo = 'Dentro de los ' + plazo50 + ' días hábiles y con curso';
      } else if (diasHabiles <= plazo25) {
        descuento = MULTAS.descuentoProntoPago25.porcentaje;
        motivo = 'Dentro de los ' + plazo25 + ' días hábiles y con curso';
      } else {
        motivo = 'Se venció el plazo del descuento: pagás el 100%';
      }
      const multaAPagar = Math.round(valorMulta * (1 - descuento));
      const ahorroMulta = valorMulta - multaAPagar;
      const diasRestantes50 = Math.max(0, plazo50 - diasHabiles);
      const diasRestantes25 = Math.max(0, plazo25 - diasHabiles);

      // ── Viaje ─────────────────────────────────────────────────────────
      const kmTotal = km * 2;
      const galones = kmTotal / rendimiento;
      const gasolina = galones * precioGalon;
      const peajesTotal = peajes * 2;
      const viaje = gasolina + peajesTotal;

      let total = 0;
      let sub = '';

      if (id === 'solidario') {
        total = solidario;
        rows.push({
          k: 'Tarifa base del permiso',
          ref: 'Por ' + (periodo === 'dia' ? 'un día' : periodo === 'mes' ? 'un mes' : 'un semestre') + ' · ⚠️ referencial',
          v: baseSolidario,
        });
        rows.push({
          k: 'Si el vehículo está matriculado fuera de Bogotá',
          ref: 'Multiplicador de ' + SOLIDARIO.factorMatriculaFuera + '×',
          v: baseSolidario * SOLIDARIO.factorMatriculaFuera,
        });
        rows.push({ k: 'Permiso a pagar', ref: 'Te habilita a circular en tu día', v: solidario, extra: true });
        rows.push({
          k: 'Lo que te sale cada día que realmente lo usás',
          ref: diasUso + ' días de uso previstos',
          v: solidarioPorDia,
          extra: true,
        });
        rows.push({ k: 'Comparendo que te ahorrás cada vez', ref: 'Infracción tipo C por circular en restricción', v: multaC });
        rows.push({
          k: 'Cuántas multas equivale el permiso',
          ref: 'Permiso ÷ valor del comparendo',
          v: solidario / multaC,
          format: 'unit',
          unit: 'comparendos',
          decimals: 1,
        });
        chart.push({ label: 'Permiso solidario', value: Math.round(solidario), tone: 'good' });
        chart.push({ label: 'Un solo comparendo tipo C', value: Math.round(multaC), tone: 'bad' });
        sub =
          'El permiso te sale ' + cop(solidarioPorDia) + ' por día de uso · un solo comparendo tipo C cuesta ' +
          cop(multaC) + ', así que se paga solo con ' + (solidario / multaC).toFixed(1).replace('.', ',') +
          ' multas evitadas';
      } else if (id === 'comparendo') {
        total = multaAPagar;
        rows.push({ k: 'Valor pleno del comparendo', ref: 'Infracción tipo ' + tipo + ' · indexado por UVB', v: valorMulta });
        rows.push({
          k: 'Descuento que te corresponde',
          ref: motivo,
          v: descuento * 100,
          format: 'unit',
          unit: '%',
        });
        rows.push({ k: 'Lo que te ahorra el pronto pago', ref: 'Art. 136 del Código Nacional de Tránsito', v: ahorroMulta });
        rows.push({ k: 'A pagar', ref: motivo, v: multaAPagar, extra: true });
        rows.push({
          k: 'Días hábiles que te quedan para el 50%',
          ref: 'Plazo total: ' + plazo50 + ' días hábiles' + (electronico ? ' (fotodetección)' : ''),
          v: diasRestantes50,
          format: 'unit',
          unit: 'días',
        });
        rows.push({
          k: 'Días hábiles que te quedan para el 25%',
          ref: 'Plazo total: ' + plazo25 + ' días hábiles' + (electronico ? ' (fotodetección)' : ''),
          v: diasRestantes25,
          format: 'unit',
          unit: 'días',
        });
        rows.push({
          k: 'Lo que te costaría si dejás vencer todos los plazos',
          ref: '100% de la multa',
          v: valorMulta,
        });
        chart.push({ label: 'Lo que pagás', value: multaAPagar, tone: 'main' });
        chart.push({ label: 'Lo que te ahorra el descuento', value: Math.round(ahorroMulta), tone: 'good' });
        sub =
          motivo +
          (descuento > 0
            ? ' · te ahorrás ' + cop(ahorroMulta) + ', y te quedan ' + diasRestantes50 + ' días hábiles de ese plazo'
            : ' · pagás el valor pleno de ' + cop(valorMulta));
      } else if (id === 'viaje') {
        total = viaje;
        rows.push({
          k: 'Distancia total del viaje',
          ref: 'Ida y vuelta',
          v: kmTotal,
          format: 'unit',
          unit: 'km',
        });
        rows.push({
          k: 'Combustible que vas a necesitar',
          ref: rendimiento + ' km por galón',
          v: galones,
          format: 'unit',
          unit: 'galones',
          decimals: 1,
        });
        rows.push({ k: 'Costo del combustible', ref: cop(precioGalon) + ' por galón', v: gasolina });
        rows.push({ k: 'Peajes de ida y vuelta', ref: 'El doble de los de ida', v: peajesTotal });
        rows.push({ k: 'Costo total del viaje', ref: 'Combustible más peajes', v: viaje, extra: true });
        rows.push({
          k: 'Costo por kilómetro',
          ref: 'Sólo combustible y peajes, sin desgaste',
          v: kmTotal > 0 ? viaje / kmTotal : 0,
        });
        chart.push({ label: 'Combustible', value: Math.round(gasolina), tone: 'main' });
        chart.push({ label: 'Peajes', value: Math.round(peajesTotal), tone: 'warn' });
        sub =
          Math.round(kmTotal).toLocaleString('es-CO') + ' km ida y vuelta · ' +
          cop(kmTotal > 0 ? viaje / kmTotal : 0) + ' por kilómetro · el pico y placa no aplica en carretera, pero sí el regional de retorno en puentes';
      } else {
        total = restringido ? multaC : 0;
        rows.push({ k: 'Comparendo si salís igual', ref: 'Infracción tipo C, más grúa y patios aparte', v: multaC });
        rows.push({ k: 'Permiso solidario para ese día', ref: 'Alternativa legal', v: SOLIDARIO.base.dia });
        rows.push({
          k: 'Diferencia entre el permiso y la multa',
          ref: 'Lo que te ahorrás haciéndolo bien',
          v: multaC - SOLIDARIO.base.dia,
          extra: true,
        });
        chart.push({ label: 'Permiso por un día', value: Math.round(SOLIDARIO.base.dia), tone: 'good' });
        chart.push({ label: 'Comparendo tipo C', value: Math.round(multaC), tone: 'bad' });
        sub = finDeSemana
          ? 'Es ' + dia + ': no hay pico y placa en ' + ciudadTxt + ' para vehículos particulares'
          : restringido
            ? 'Tu placa NO puede circular el ' + dia + ' en ' + ciudadTxt + ' entre ' + (HORARIOS[ciudad] || '') +
              ' · el permiso por un día cuesta ' + cop(SOLIDARIO.base.dia) + ' contra ' + cop(multaC) + ' de multa'
            : 'Tu placa SÍ puede circular el ' + dia + ' en ' + ciudadTxt +
              ' · ⚠️ el esquema rota cada semestre: confirmá en la Secretaría de Movilidad antes de salir';
      }

      return {
        total: cop(total),
        sub: sub,
        rows: rows,
        chart: chart,
      };
    });
  })();
</script>
