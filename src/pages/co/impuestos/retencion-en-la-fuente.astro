---
/**
 * Hub de decisión CO — "¿Cuánta retención en la fuente me practican (o le practico)?".
 * audience="CO" literal al Layout: HubData sólo modela 'AR' | 'global' y el
 * mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  UVT,
  TABLA_383,
  CONCEPTOS,
  EXENTA_LABORAL,
  LIMITE_336,
  ART_387,
  ARRIENDO_MUEBLES,
} from '../../../lib/hubs/co/retencion-en-la-fuente';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    UVT,
    TABLA: TABLA_383,
    CONCEPTOS,
    EXENTA_LABORAL,
    LIMITE_336,
    ART_387,
    ARRIENDO_MUEBLES,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');
    const pct = (n, d) => n.toFixed(d === undefined ? 2 : d).replace('.', ',') + '%';

    // Tabla mensual del art. 383 ET, en UVT (hasta: null = sin techo).
    function tabla383(baseCop) {
      const baseUvt = Math.max(0, baseCop) / UVT;
      for (const t of TABLA) {
        const hasta = t.hasta === null ? Infinity : t.hasta;
        if (baseUvt > t.desde && baseUvt <= hasta) {
          return {
            baseUvt: baseUvt,
            retencion: ((baseUvt - t.desde) * t.tasa + t.adicion) * UVT,
            marginal: t.tasa * 100,
            tramo: t,
          };
        }
      }
      return { baseUvt: baseUvt, retencion: 0, marginal: 0, tramo: TABLA[0] };
    }

    const CLAVE_CONCEPTO = {
      compras: 'Compras generales',
      servicios: 'Servicios generales',
      honorarios: 'Honorarios y comisiones',
      arrendamiento: 'Arrendamiento bienes inmuebles',
    };

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'empleado_p1';
      const ingreso = Math.max(0, v.ingreso || 0);
      const esEmpleado = id === 'empleado_p1' || id === 'empleado_p2';

      // ═══════════ Ramas de empleado: depuración arts. 387 y 388 ET ═══════════
      if (esEmpleado) {
        const aportes = Math.min(Math.max(0, v.aportes || 0), ingreso);
        const tieneDeps = Math.max(0, Math.round(v.dependientes || 0)) > 0;
        const otrasDedCargadas = Math.max(0, v.otrasDed || 0);

        // Ingreso tras aportes obligatorios (ingreso no constitutivo de renta).
        const ingresoNeto = Math.max(0, ingreso - aportes);

        // Art. 387 ET: dependientes = 10% del ingreso bruto, tope 32 UVT/mes.
        const dedDependientes = tieneDeps
          ? Math.min(ingreso * ART_387.dependientesPct, ART_387.dependientesTopeUvtMes * UVT)
          : 0;
        // Vivienda (100 UVT/mes) + prepagada (16 UVT/mes): tope conjunto del campo.
        const topeOtras = (ART_387.viviendaTopeUvtMes + ART_387.prepagadaTopeUvtMes) * UVT;
        const otrasDed = Math.min(otrasDedCargadas, topeOtras);
        const otrasRecortadas = otrasDedCargadas - otrasDed;

        // Art. 206-10 ET: 25% sobre el subtotal tras aportes y deducciones, tope 790 UVT/año.
        const topeExentaMes = (EXENTA_LABORAL.topeAnualUvt / 12) * UVT;
        const subtotal = Math.max(0, ingresoNeto - dedDependientes - otrasDed);
        const exenta = Math.min(subtotal * EXENTA_LABORAL.porcentaje, topeExentaMes);

        // Art. 336/388 ET: menor entre el 40% del ingreso depurado y 1.340 UVT/año.
        const brutos = dedDependientes + otrasDed + exenta;
        const topeGlobal = Math.min(ingresoNeto * LIMITE_336.pct, (LIMITE_336.topeUvt / 12) * UVT);
        const aplicados = Math.min(brutos, topeGlobal);
        const recorte = Math.max(0, brutos - aplicados);

        const base = Math.max(0, ingresoNeto - aplicados);
        const r = tabla383(base);
        const retencion = Math.round(r.retencion);
        const porcentajeFijo = base > 0 ? (retencion / base) * 100 : 0;
        const efectiva = ingreso > 0 ? (retencion / ingreso) * 100 : 0;
        const neto = Math.max(0, ingreso - aportes - retencion);

        const rows = [
          { k: 'Ingreso laboral del mes', ref: id === 'empleado_p2' ? 'Promedio de los últimos 12 meses' : 'Pago del mes', v: ingreso },
          { k: 'Aportes obligatorios a salud y pensión (se restan)', ref: 'Ingreso no constitutivo de renta', v: aportes },
          { k: 'Ingreso depurado antes de beneficios', ref: 'Base del tope del 40% · art. 388 ET', v: ingresoNeto },
        ];
        if (dedDependientes > 0) {
          rows.push({
            k: 'Deducción por dependientes',
            ref: (ART_387.dependientesPct * 100).toFixed(0) + '% del ingreso, tope ' + ART_387.dependientesTopeUvtMes + ' UVT/mes · art. 387 ET',
            v: dedDependientes,
          });
        }
        rows.push({
          k: 'Intereses de vivienda y medicina prepagada',
          ref: 'Topes ' + ART_387.viviendaTopeUvtMes + ' y ' + ART_387.prepagadaTopeUvtMes + ' UVT/mes · art. 387 ET',
          v: otrasDed,
        });
        if (otrasRecortadas > 0) {
          rows.push({ k: 'Parte que excede los topes del art. 387', ref: 'No entra en la depuración', v: otrasRecortadas });
        }
        rows.push({
          k: 'Renta exenta del 25% de rentas de trabajo',
          ref: 'Tope ' + EXENTA_LABORAL.topeAnualUvt.toLocaleString('es-CO') + ' UVT/año · art. 206-10 ET',
          v: exenta,
        });
        rows.push({
          k: 'Beneficios aceptados (se restan)',
          ref: 'Menor entre 40% y ' + LIMITE_336.topeUvt.toLocaleString('es-CO') + ' UVT/año · art. 336 ET',
          v: aplicados,
        });
        if (recorte > 0) {
          rows.push({ k: 'Beneficios recortados por el límite global', ref: 'Excedente que se pierde · art. 388 ET', v: recorte });
        }
        rows.push({ k: 'Base gravable de retención', ref: 'Entrada de la tabla del art. 383 ET', v: base });
        rows.push({
          k: 'Base gravable en UVT',
          ref: 'UVT ' + cop(UVT),
          v: r.baseUvt,
          format: 'unit',
          unit: 'UVT',
          decimals: 1,
        });
        rows.push({
          k: 'Tramo del art. 383 en el que caés',
          ref: r.tramo.desde + (r.tramo.hasta === null ? ' UVT en adelante' : ' a ' + r.tramo.hasta + ' UVT'),
          v: r.marginal,
          format: 'unit',
          unit: '% marginal',
        });
        rows.push({ k: 'Retención del mes', ref: 'Tabla del art. 383 ET', v: retencion, extra: true });
        if (id === 'empleado_p2') {
          rows.push({
            k: 'Porcentaje fijo del semestre',
            ref: 'Retención ÷ base gravable · art. 386 ET',
            v: porcentajeFijo,
            format: 'unit',
            unit: '%',
            decimals: 2,
            extra: true,
          });
          rows.push({ k: 'Retención estimada de los 6 meses', ref: 'Porcentaje fijo aplicado al semestre', v: retencion * 6 });
        } else {
          rows.push({ k: 'Retención estimada del año', ref: '12 meses al mismo nivel de ingreso', v: retencion * 12 });
        }
        rows.push({ k: 'Neto que te queda en el mes', ref: 'Ingreso menos aportes y retención', v: neto });
        rows.push({
          k: 'Tasa efectiva sobre tu ingreso bruto',
          ref: 'Retención ÷ ingreso',
          v: efectiva,
          format: 'unit',
          unit: '%',
          decimals: 2,
        });

        const sub =
          (retencion > 0
            ? 'Te retienen ' + cop(retencion) + ' este mes'
            : 'No te retienen: tu base queda debajo de las ' + TABLA[1].desde + ' UVT') +
          ' · base ' + r.baseUvt.toFixed(0) + ' UVT (tramo del ' + r.marginal + '%)' +
          (id === 'empleado_p2'
            ? ' · porcentaje fijo ' + pct(porcentajeFijo) + ' para los 6 meses siguientes'
            : ' · tasa efectiva ' + pct(efectiva));

        return {
          total: cop(retencion),
          sub: sub,
          rows: rows,
          chart: [
            { label: 'Neto en tu bolsillo', value: Math.round(neto), tone: 'main' },
            { label: 'Aportes a salud y pensión', value: Math.round(aportes), tone: 'exit' },
            { label: 'Fuera del impuesto (deducciones y renta exenta)', value: Math.round(aplicados), tone: 'good' },
            { label: 'Retención en la fuente', value: retencion, tone: 'warn' },
          ].filter((s) => s.value > 0),
        };
      }

      // ═══════════ Ramas de pago a terceros: base mínima + tarifa ═══════════
      const clave = id === 'arrendamiento' ? 'arrendamiento' : String(v.concepto || 'servicios');
      const nombre = CLAVE_CONCEPTO[clave] || CLAVE_CONCEPTO.servicios;
      const row = CONCEPTOS.filter(function (c) { return c.concepto === nombre; })[0] || CONCEPTOS[1];
      const esDeclarante = String(v.declarante || 'si') !== 'no';

      const tarifa = clave === 'arrendamiento' ? row.declarante : (esDeclarante ? row.declarante : row.noDeclarante);
      const superaBase = row.basePesos === 0 || ingreso >= row.basePesos;
      const retencion = superaBase ? Math.round(ingreso * tarifa) : 0;
      const neto = ingreso - retencion;

      const rows = [
        {
          k: clave === 'arrendamiento' ? 'Canon mensual del inmueble' : 'Valor de la factura antes de IVA',
          ref: nombre,
          v: ingreso,
        },
        {
          k: 'Base mínima del concepto',
          ref: row.baseUvt > 0 ? row.baseUvt + ' UVT · Decreto 1625/2016' : 'Sin base mínima: se retiene desde el primer peso',
          v: row.basePesos,
        },
        {
          k: 'Tarifa aplicada',
          ref: clave === 'arrendamiento'
            ? 'Igual para declarante y no declarante'
            : (esDeclarante ? 'Beneficiario declarante o persona jurídica' : 'Persona natural no declarante'),
          v: tarifa * 100,
          format: 'unit',
          unit: '%',
          decimals: 1,
        },
        { k: 'Retención a practicar', ref: superaBase ? 'Base × tarifa' : 'No supera la base mínima', v: retencion, extra: true },
        { k: 'Neto a girar', ref: 'Valor menos retención', v: neto },
      ];

      if (clave === 'arrendamiento') {
        rows.push({
          k: 'Tarifa si fuera un bien mueble',
          ref: 'Sin cuantía mínima · art. 1.2.4.9.1 DUR 1625/2016',
          v: ARRIENDO_MUEBLES * 100,
          format: 'unit',
          unit: '%',
          decimals: 1,
        });
        rows.push({ k: 'Retención si fuera un bien mueble', ref: 'Comparación', v: Math.round(ingreso * ARRIENDO_MUEBLES) });
      } else {
        const tarifaAlt = esDeclarante ? row.noDeclarante : row.declarante;
        rows.push({
          k: esDeclarante ? 'Retención si NO fuera declarante' : 'Retención si fuera declarante',
          ref: pct(tarifaAlt * 100, 1) + ' · mismo concepto',
          v: superaBase ? Math.round(ingreso * tarifaAlt) : 0,
        });
      }

      rows.push({ k: 'Retención anualizada a este ritmo', ref: '12 pagos iguales', v: retencion * 12 });
      rows.push({
        k: 'Peso de la retención sobre el pago',
        ref: 'Retención ÷ valor del pago',
        v: ingreso > 0 ? (retencion / ingreso) * 100 : 0,
        format: 'unit',
        unit: '%',
        decimals: 2,
      });

      const sub = superaBase
        ? 'Se retiene ' + pct(tarifa * 100, 1) + ' de ' + cop(ingreso) + ' · girás ' + cop(neto) +
          ' · la retención es un anticipo del impuesto de renta del que cobra'
        : 'El pago de ' + cop(ingreso) + ' no llega a la base mínima de ' + row.baseUvt + ' UVT (' +
          cop(row.basePesos) + ') · no se practica retención';

      return {
        total: cop(retencion),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Neto que recibe el que cobra', value: Math.round(neto), tone: 'main' },
          { label: 'Retención que va a la DIAN', value: retencion, tone: 'warn' },
        ].filter((s) => s.value > 0),
      };
    });
  })();
</script>
