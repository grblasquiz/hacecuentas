---
/**
 * Hub de decisión CO — "¿Cuánta retención en la fuente me practican (o le practico)?".
 * audience="CO" literal al Layout: HubData sólo modela 'AR' | 'global' y el
 * mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import RetencionFuenteColombiaExperience from '../../../components/generated/RetencionFuenteColombiaExperience.astro';
import {
  hub,
  UVT,
  TABLA_383,
  CONCEPTOS,
  EXENTA_LABORAL,
  LIMITE_336,
  ART_387,
  ARRIENDO_MUEBLES,
} from '../../../lib/hubs/co/retencion-en-la-fuente';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <RetencionFuenteColombiaExperience data={hub} />
  <Footer />
</Layout>

