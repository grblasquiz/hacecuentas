---
/**
 * Hub de decisión CO — "Declaración de renta de persona natural".
 * Piloto de la arquitectura de hubs bajo prefijo de país: la ruta vive bajo /co/,
 * igual que las calculadoras que absorbe.
 *
 * El audience="CO" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import RentaPersonasColombiaExperience from '../../../components/generated/RentaPersonasColombiaExperience.astro';
import {
  hub,
  UVT,
  TABLA_241,
  EXENTA_LABORAL,
  LIMITE_336,
  DEPENDIENTES,
  PENSION_EXENTA_UVT_MES,
  TOPES_DECLARAR,
  UVT_DECLARA,
  VENCIMIENTOS,
} from '../../../lib/hubs/co/renta-personas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <RentaPersonasColombiaExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    UVT,
    TABLA: TABLA_241,
    EXENTA_LABORAL,
    LIMITE_336,
    DEPENDIENTES,
    PENSION_EXENTA_UVT_MES,
    TOPES: TOPES_DECLARAR,
    UVT_DECLARA,
    VENCIMIENTOS,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');
    const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio',
      'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

    // Tabla art. 241 ET, en UVT. Espejo de COLOMBIA_2026.rentaArt241 (hasta: null = sin techo).
    function tabla241(baseCop) {
      const baseUvt = Math.max(0, baseCop) / UVT;
      for (const t of TABLA) {
        const hasta = t.hasta === null ? Infinity : t.hasta;
        if (baseUvt > t.desde && baseUvt <= hasta) {
          return { baseUvt: baseUvt, impuesto: ((baseUvt - t.desde) * t.tasa + t.adicion) * UVT, marginal: t.tasa * 100, tramo: t };
        }
      }
      return { baseUvt: baseUvt, impuesto: 0, marginal: 0, tramo: TABLA[0] };
    }

    function vencimiento(digitos) {
      const d = Math.min(99, Math.max(0, Math.round(digitos || 0)));
      const idx = d === 0 ? 49 : Math.ceil(d / 2) - 1;
      const iso = VENCIMIENTOS[idx];
      const p = iso.split('-').map(Number);
      return { texto: p[2] + ' de ' + MESES[p[1] - 1] + ' de ' + p[0], iso: iso };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'asalariado';
      const ingresos = Math.max(0, v.ingresos || 0);
      const aportes = Math.min(Math.max(0, v.aportes || 0), ingresos);
      const beneficios = Math.max(0, v.beneficios || 0);
      const retenciones = Math.max(0, v.retenciones || 0);
      const patrimonio = Math.max(0, v.patrimonio || 0);
      const deps = Math.min(DEPENDIENTES.maximo, Math.max(0, Math.round(v.dependientes || 0)));

      // Aportes obligatorios: ingreso no constitutivo de renta, salen antes de todo.
      const rentaLiquida = Math.max(0, ingresos - aportes);

      const tieneRentasDeTrabajo = id === 'asalariado' || id === 'independiente';
      const rows = [
        { k: 'Ingresos brutos del año', ref: 'Declarados', v: ingresos },
        { k: 'Aportes obligatorios a salud y pensión (se restan)', ref: 'Ingreso no constitutivo de renta', v: aportes },
        {
          k: 'Renta líquida antes de beneficios',
          ref: id === 'pensionado' ? 'Cédula de pensiones' : 'Base del tope del 40%',
          v: rentaLiquida,
        },
      ];

      let rentaGravable, beneficiosAplicados, recorte, exenta, depDeduccion;

      if (id === 'pensionado') {
        // Cédula de pensiones: exención del art. 206-5 ET, fuera del límite del art. 336.
        exenta = Math.min(rentaLiquida, PENSION_EXENTA_UVT_MES * UVT * 12);
        depDeduccion = 0;
        beneficiosAplicados = 0;
        recorte = beneficios;
        rentaGravable = Math.max(0, rentaLiquida - exenta);
        rows.push({
          k: 'Pensión exenta (se resta)',
          ref: PENSION_EXENTA_UVT_MES.toLocaleString('es-CO') + ' UVT/mes · art. 206-5 ET',
          v: exenta,
        });
      } else {
        exenta = tieneRentasDeTrabajo
          ? Math.min(rentaLiquida * EXENTA_LABORAL.porcentaje, EXENTA_LABORAL.topeAnualUvt * UVT)
          : 0;
        depDeduccion = tieneRentasDeTrabajo ? deps * DEPENDIENTES.uvtCadaUno * UVT : 0;
        const brutos = exenta + depDeduccion + beneficios;
        // Art. 336 ET: el menor entre el 40% de la renta líquida y el tope anual en UVT.
        const tope = Math.min(rentaLiquida * LIMITE_336.pct, LIMITE_336.topeUvt * UVT);
        beneficiosAplicados = Math.min(brutos, tope);
        recorte = Math.max(0, brutos - beneficiosAplicados);
        rentaGravable = Math.max(0, rentaLiquida - beneficiosAplicados);

        if (exenta > 0) {
          rows.push({
            k: 'Renta exenta del 25% de rentas de trabajo',
            ref: 'Tope ' + EXENTA_LABORAL.topeAnualUvt.toLocaleString('es-CO') + ' UVT · art. 206-10 ET',
            v: exenta,
          });
        }
        if (depDeduccion > 0) {
          rows.push({
            k: 'Deducción por ' + deps + (deps === 1 ? ' dependiente' : ' dependientes'),
            ref: DEPENDIENTES.uvtCadaUno + ' UVT c/u · art. 336 par. 5 ET',
            v: depDeduccion,
          });
        }
        rows.push({ k: 'Otras deducciones y rentas exentas declaradas', ref: 'Vivienda, prepagada, AFC, voluntarias', v: beneficios });
        rows.push({
          k: 'Total de beneficios aceptados (se restan)',
          ref: 'Menor entre 40% y ' + LIMITE_336.topeUvt.toLocaleString('es-CO') + ' UVT · art. 336',
          v: beneficiosAplicados,
        });
        if (recorte > 0) {
          rows.push({ k: 'Beneficios recortados por el límite global', ref: 'Excedente que se pierde · art. 336 ET', v: recorte });
        }
      }

      const r = tabla241(rentaGravable);
      const impuesto = Math.round(r.impuesto);
      const acreditado = Math.min(retenciones, impuesto);
      const saldo = Math.max(0, impuesto - acreditado);
      const aFavor = Math.max(0, retenciones - impuesto);
      const efectiva = ingresos > 0 ? (impuesto / ingresos) * 100 : 0;

      // Art. 592 ET: los topes se miden con la UVT del año gravable que se declara.
      const topeIngresos = TOPES.topeIngresosUvt * UVT_DECLARA;
      const topePatrimonio = TOPES.topePatrimonioUvt * UVT_DECLARA;
      const obligado = (ingresos >= topeIngresos && ingresos > 0) || patrimonio > topePatrimonio;
      const venc = vencimiento(v.digitos);

      rows.push({ k: 'Renta líquida gravable', ref: 'Base del art. 241 ET', v: rentaGravable });
      rows.push({
        k: 'Renta gravable en UVT',
        ref: 'UVT ' + cop(UVT),
        v: r.baseUvt,
        format: 'unit',
        unit: 'UVT',
        decimals: 1,
      });
      rows.push({
        k: 'Tramo del art. 241 en el que caés',
        ref: r.tramo.desde.toLocaleString('es-CO') + (r.tramo.hasta === null ? ' UVT en adelante' : ' a ' + r.tramo.hasta.toLocaleString('es-CO') + ' UVT'),
        v: r.marginal,
        format: 'unit',
        unit: '% marginal',
      });
      rows.push({ k: 'Impuesto liquidado del año', ref: 'Tabla del art. 241 ET', v: impuesto });
      rows.push({ k: 'Retención en la fuente acreditada (se resta)', ref: 'Anticipo ya pagado', v: acreditado });
      rows.push({ k: 'Saldo a pagar', ref: 'Formulario 210', v: saldo, extra: true });
      if (aFavor > 0) {
        rows.push({ k: 'Saldo a favor para imputar o pedir en devolución', ref: 'Te retuvieron de más', v: aFavor, extra: true });
      }
      rows.push({
        k: 'Tasa efectiva sobre tus ingresos brutos',
        ref: 'Impuesto ÷ ingresos',
        v: efectiva,
        format: 'unit',
        unit: '%',
        decimals: 2,
      });
      rows.push(
        ingresos >= topeIngresos
          ? {
              k: 'Cuánto pasaste el tope de ingresos para declarar',
              ref: TOPES.topeIngresosUvt.toLocaleString('es-CO') + ' UVT · art. 592 ET',
              v: ingresos - topeIngresos,
            }
          : {
              k: 'Margen que te queda antes del tope de ingresos para declarar',
              ref: TOPES.topeIngresosUvt.toLocaleString('es-CO') + ' UVT · art. 592 ET',
              v: topeIngresos - ingresos,
            }
      );

      const sub =
        (obligado
          ? 'Estás obligado a declarar'
          : 'No superás los topes de ingresos ni de patrimonio del art. 592 (revisá también consumos y consignaciones)') +
        ' · vencés el ' + venc.texto +
        ' · renta gravable ' + r.baseUvt.toFixed(0) + ' UVT (tramo del ' + r.marginal + '%)' +
        (aFavor > 0
          ? ' · te quedan ' + cop(aFavor) + ' a favor'
          : ' · tasa efectiva ' + efectiva.toFixed(2).replace('.', ',') + '%');

      const fueraDeImpuesto = Math.round(aportes + beneficiosAplicados + (id === 'pensionado' ? exenta : 0));

      return {
        total: cop(saldo),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Fuera del impuesto (aportes, deducciones y exentas)', value: fueraDeImpuesto, tone: 'good' },
          { label: 'Renta gravada que te queda', value: Math.max(0, Math.round(rentaGravable - impuesto)), tone: 'main' },
          { label: 'Impuesto liquidado', value: impuesto, tone: 'warn' },
        ],
      };
    });
  })();
</script>
