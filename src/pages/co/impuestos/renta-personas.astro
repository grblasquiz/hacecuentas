---
/**
 * Hub de decisión CO — "Declaración de renta de persona natural".
 * Piloto de la arquitectura de hubs bajo prefijo de país: la ruta vive bajo /co/,
 * igual que las calculadoras que absorbe.
 *
 * El audience="CO" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import RentaPersonasColombiaExperience from '../../../components/generated/RentaPersonasColombiaExperience.astro';
import {
  hub,
  UVT,
  TABLA_241,
  EXENTA_LABORAL,
  LIMITE_336,
  DEPENDIENTES,
  PENSION_EXENTA_UVT_MES,
  TOPES_DECLARAR,
  UVT_DECLARA,
  VENCIMIENTOS,
} from '../../../lib/hubs/co/renta-personas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const calculatorConfig = {
  uvt: UVT_DECLARA,
  table: TABLA_241,
  limits: {
    income: TOPES_DECLARAR.topeIngresosUvt * UVT_DECLARA,
    assets: TOPES_DECLARAR.topePatrimonioUvt * UVT_DECLARA,
    card: TOPES_DECLARAR.topeConsumosTarjetaUvt * UVT_DECLARA,
    purchases: TOPES_DECLARAR.topeComprasUvt * UVT_DECLARA,
    deposits: TOPES_DECLARAR.topeConsignacionesUvt * UVT_DECLARA,
  },
  dueDates: VENCIMIENTOS,
  exempt25CapUvt: EXENTA_LABORAL.topeAnualUvt,
  globalCapUvt: LIMITE_336.topeUvt,
  dependentUvt: DEPENDIENTES.uvtCadaUno,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
    { '@type': 'WebApplication', name: hub.title, url: `${CANONICAL}#calculadora`, applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'COP' }, dateModified: '2026-08-16' },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
  articleAuthor="Martín Rodríguez"
  articlePublished="2026-08-04"
  articleModified="2026-08-16"
  suppressAutoEnhancements={true}
>
  <Header slot="header" />
  <RentaPersonasColombiaExperience data={hub} config={calculatorConfig} />
  <Footer slot="footer" />
</Layout>
