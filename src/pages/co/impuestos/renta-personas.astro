---
/**
 * Hub de decisión CO — "Declaración de renta de persona natural".
 * Piloto de la arquitectura de hubs bajo prefijo de país: la ruta vive bajo /co/,
 * igual que las calculadoras que absorbe.
 *
 * El audience="CO" se pasa literal al Layout: HubData sólo modela 'AR' | 'global'
 * y el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import RentaPersonasColombiaExperience from '../../../components/generated/RentaPersonasColombiaExperience.astro';
import {
  hub,
  UVT,
  TABLA_241,
  EXENTA_LABORAL,
  LIMITE_336,
  DEPENDIENTES,
  PENSION_EXENTA_UVT_MES,
  TOPES_DECLARAR,
  UVT_DECLARA,
  VENCIMIENTOS,
} from '../../../lib/hubs/co/renta-personas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <RentaPersonasColombiaExperience data={hub} />
  <Footer />
</Layout>

