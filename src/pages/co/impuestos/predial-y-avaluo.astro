---
/**
 * Hub de decisión CO — "Impuesto predial y avalúo catastral".
 * Ruta bajo el prefijo /co/, igual que las calculadoras que absorbe.
 * audience="CO" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import PredialAvaluoColombiaExperience from '../../../components/generated/PredialAvaluoColombiaExperience.astro';
import {
  hub,
  SMLMV,
  PREDIAL_BOGOTA,
  TABLA_RESIDENCIAL_BOGOTA,
  PREFERENCIAL_BOGOTA,
  TARIFA_MEDELLIN_POR_MIL,
  RATIO_CATASTRAL_COMERCIAL,
} from '../../../lib/hubs/co/predial-y-avaluo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PredialAvaluoColombiaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

