---
/**
 * Hub de decisión CO — "Tengo un negocio: ¿qué impuestos me tocan?".
 * audience="CO" literal al Layout: HubData sólo modela 'AR' | 'global' y el
 * mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ImpuestosNegocioColombiaExperience from '../../../components/generated/ImpuestosNegocioColombiaExperience.astro';
import {
  hub,
  UVT,
  IVA,
  RENTA_SOCIEDADES,
  RST,
  TOPES_DECLARAR,
} from '../../../lib/hubs/co/impuestos-de-mi-negocio';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ImpuestosNegocioColombiaExperience data={hub} />
  <Footer />
</Layout>

