---
/**
 * Hub de decisión CO — "Tengo un negocio: ¿qué impuestos me tocan?".
 * audience="CO" literal al Layout: HubData sólo modela 'AR' | 'global' y el
 * mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import ImpuestosNegocioColombiaExperience from '../../../components/generated/ImpuestosNegocioColombiaExperience.astro';
import RegimeJourney from '../../../components/RegimeJourney.astro';
import BusinessUtilitiesColombia from '../../../components/BusinessUtilitiesColombia.astro';
import {
  hub,
  UVT,
  IVA,
  RENTA_SOCIEDADES,
  RST,
  TOPES_DECLARAR,
} from '../../../lib/hubs/co/impuestos-de-mi-negocio';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ImpuestosNegocioColombiaExperience data={hub} />
  <BusinessUtilitiesColombia />
  <RegimeJourney country="Colombia" regime="SIMPLE" headline="Antes de entrar al SIMPLE, mirá toda la carga del negocio." intro="El ahorro depende de actividad, ingresos, anticipos e ICA. Ordenamos la decisión para comparar el SIMPLE con renta ordinaria sobre el mismo escenario." steps={['Definí actividad e ingresos','Estimá anticipo bimestral','Compará renta, ICA y aportes']} links={[{href:'/co/calculadora-monotributo-colombia-pequenos-comercios',label:'Simular SIMPLE',note:'Pago estimado según actividad'},{href:'/co/impuestos/renta-personas',label:'Comparar renta ordinaria',note:'Base, deducciones y tarifa'},{href:'/co/impuestos/retencion-en-la-fuente',label:'Revisar retenciones',note:'Anticipos que ya te practicaron'}]} tone="amber" />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>
