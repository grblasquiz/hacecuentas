---
/**
 * Hub de decisión CO — "Ganancia ocasional, herencia y patrimonio".
 * Ruta bajo el prefijo /co/, igual que las calculadoras que absorbe.
 * audience="CO" va literal al Layout: HubData sólo modela 'AR' | 'global'.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  UVT,
  GO,
  HERENCIA_ART307,
  PATRIMONIO_LEY_2277,
  TIMBRE,
} from '../../../lib/hubs/co/patrimonio-y-herencia';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="CO"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ UVT, GO, ART307: HERENCIA_ART307, ESCALA: PATRIMONIO_LEY_2277, TIMBRE }}
>
  (function () {
    const H = window.HC_HUB;
    const cop = (n) => '$' + Math.round(n || 0).toLocaleString('es-CO');

    /** Escala marginal del impuesto al patrimonio (Ley 2277/2022): tramo + adición fija en UVT. */
    function patrimonioArt296(baseCop) {
      const uvt = Math.max(0, baseCop) / UVT;
      for (const t of ESCALA) {
        const hasta = t.hastaUvt === null ? Infinity : t.hastaUvt;
        if (uvt > t.desdeUvt && uvt <= hasta) {
          return {
            uvt: uvt,
            impuesto: ((uvt - t.desdeUvt) * t.tasa + t.adicionUvt) * UVT,
            marginal: t.tasa * 100,
            tramo: t,
          };
        }
      }
      return { uvt: uvt, impuesto: 0, marginal: 0, tramo: ESCALA[0] };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'vivienda';
      const valor = Math.max(0, v.valor || 0);
      const costo = Math.max(0, v.costo || 0);
      const anios = Math.max(0, v.anios || 0);
      const reinvierte = String(v.reinvierte || 'si') === 'si';
      const parentesco = String(v.parentesco || 'legitimario');
      const viviendaHabitacion = Math.max(0, v.vivienda || 0);

      const rows = [];
      let impuesto = 0;
      let exento = 0;
      let gravable = 0;
      let baseBruta = 0;
      let sub = '';
      let etiquetaExento = 'Parte exenta';

      if (id === 'patrimonio') {
        // Base: patrimonio líquido = activos − deudas, menos la exclusión de la casa
        // de habitación (12.000 UVT del valor patrimonial).
        const liquido = Math.max(0, valor - costo);
        const exclusionVivienda = Math.min(viviendaHabitacion, 12000 * UVT);
        const base = Math.max(0, liquido - exclusionVivienda);
        const r = patrimonioArt296(base);
        impuesto = Math.round(r.impuesto);
        baseBruta = liquido;
        exento = Math.min(base, ESCALA[1].desdeUvt * UVT) + exclusionVivienda;
        gravable = Math.max(0, base - ESCALA[1].desdeUvt * UVT);

        rows.push({ k: 'Activos totales declarados', ref: 'Al 1 de enero', v: valor });
        rows.push({ k: 'Deudas (se restan)', ref: 'Al 1 de enero', v: costo });
        rows.push({ k: 'Patrimonio líquido', ref: 'Base del impuesto', v: liquido });
        if (exclusionVivienda > 0) {
          rows.push({
            k: 'Casa de habitación excluida de la base',
            ref: 'Primeras 12.000 UVT del valor patrimonial',
            v: exclusionVivienda,
          });
        }
        rows.push({
          k: 'Umbral exento',
          ref: ESCALA[1].desdeUvt.toLocaleString('es-CO') + ' UVT · Ley 2277 de 2022',
          v: ESCALA[1].desdeUvt * UVT,
        });
        rows.push({ k: 'Base gravable por encima del umbral', ref: 'Lo que sí tributa', v: gravable });
        rows.push({
          k: 'Patrimonio líquido en UVT',
          ref: 'UVT ' + cop(UVT),
          v: r.uvt,
          format: 'unit',
          unit: 'UVT',
          decimals: 0,
        });
        rows.push({
          k: 'Tarifa marginal del tramo',
          ref: r.tramo.desdeUvt.toLocaleString('es-CO') +
            (r.tramo.hastaUvt === null ? ' UVT en adelante' : ' a ' + r.tramo.hastaUvt.toLocaleString('es-CO') + ' UVT'),
          v: r.marginal,
          format: 'unit',
          unit: '%',
          decimals: 2,
        });
        rows.push({ k: 'Impuesto al patrimonio del año', ref: 'Arts. 292-3 y 296-3 ET', v: impuesto, extra: true });

        sub =
          impuesto > 0
            ? 'Caés en el tramo marginal del ' + r.marginal.toString().replace('.', ',') +
              '% · sólo tributan ' + cop(gravable) + ' de tu patrimonio, no el total'
            : 'No superás el umbral de ' + ESCALA[1].desdeUvt.toLocaleString('es-CO') +
              ' UVT: no pagás impuesto al patrimonio este año';
        etiquetaExento = 'Patrimonio que no tributa';
      } else if (id === 'herencia') {
        // Art. 307 ET: exención por beneficiario y por tipo de bien.
        baseBruta = Math.max(0, valor - costo);
        let topeExento;
        let refExento;
        if (parentesco === 'vivienda-urbana') {
          topeExento = ART307.viviendaUrbanaUvt * UVT;
          refExento = ART307.viviendaUrbanaUvt.toLocaleString('es-CO') + ' UVT · vivienda urbana del causante';
        } else if (parentesco === 'rural') {
          topeExento = ART307.inmuebleRuralUvt * UVT;
          refExento = ART307.inmuebleRuralUvt.toLocaleString('es-CO') + ' UVT · inmueble rural del causante';
        } else if (parentesco === 'otro') {
          topeExento = Math.min(baseBruta * ART307.otrosBeneficiariosPct, ART307.otrosBeneficiariosTopeUvt * UVT);
          refExento =
            (ART307.otrosBeneficiariosPct * 100).toFixed(0) + '% de lo recibido, tope ' +
            ART307.otrosBeneficiariosTopeUvt.toLocaleString('es-CO') + ' UVT';
        } else {
          topeExento = ART307.legitimariosUvt * UVT;
          refExento = ART307.legitimariosUvt.toLocaleString('es-CO') + ' UVT · legitimarios y cónyuge';
        }
        exento = Math.min(baseBruta, topeExento);
        gravable = Math.max(0, baseBruta - exento);
        impuesto = Math.round(gravable * GO.tarifa);

        rows.push({ k: 'Valor de lo que heredás', ref: 'Antes de gastos', v: valor });
        rows.push({ k: 'Gastos del proceso sucesoral (se restan)', ref: 'Notaría, abogado, avalúos', v: costo });
        rows.push({ k: 'Lo que efectivamente recibís', ref: 'Base de la ganancia ocasional', v: baseBruta });
        rows.push({ k: 'Porción exenta que te corresponde', ref: refExento + ' · art. 307 ET', v: exento });
        rows.push({ k: 'Ganancia ocasional gravada', ref: 'Lo que supera tu exención', v: gravable });
        rows.push({
          k: 'Tarifa aplicada',
          ref: 'Art. 314 ET',
          v: GO.tarifa * 100,
          format: 'unit',
          unit: '%',
        });
        rows.push({ k: 'Impuesto de ganancia ocasional', ref: 'A pagar en tu declaración', v: impuesto, extra: true });
        rows.push({ k: 'Lo que te queda en la mano', ref: 'Recibido menos impuesto', v: baseBruta - impuesto, extra: true });

        sub =
          (gravable === 0
            ? 'La exención del art. 307 cubre todo lo que recibís: no pagás ganancia ocasional'
            : 'Tributan ' + cop(gravable) + ' de los ' + cop(baseBruta) + ' que recibís') +
          ' · la exención es POR heredero, así que cada uno tiene la suya';
        etiquetaExento = 'Exento por el art. 307';
      } else {
        // Ventas: vivienda de habitación (con exención del art. 311-1) u otro activo.
        baseBruta = Math.max(0, valor - costo);
        const esGananciaOcasional = anios >= GO.aniosParaGananciaOcasional;
        const aplicaExencionVivienda = id === 'vivienda' && esGananciaOcasional && reinvierte;
        exento = aplicaExencionVivienda ? Math.min(baseBruta, GO.exencionViviendaUvt * UVT) : 0;
        gravable = Math.max(0, baseBruta - exento);
        impuesto = esGananciaOcasional ? Math.round(gravable * GO.tarifa) : 0;
        const retencion = valor * GO.retencionNotariaPn;

        rows.push({ k: 'Precio de venta', ref: 'Lo que recibís', v: valor });
        rows.push({ k: 'Costo fiscal probado (se resta)', ref: 'Compra + mejoras con soporte', v: costo });
        rows.push({ k: 'Utilidad de la venta', ref: 'Base antes de exenciones', v: baseBruta });
        rows.push({
          k: 'Años de posesión',
          ref: esGananciaOcasional
            ? 'Es ganancia ocasional · art. 300 ET'
            : 'Menos de ' + GO.aniosParaGananciaOcasional + ' años: tributa como renta ordinaria',
          v: anios,
          format: 'unit',
          unit: anios === 1 ? 'año' : 'años',
        });
        if (id === 'vivienda') {
          rows.push({
            k: aplicaExencionVivienda ? 'Utilidad exenta por vivienda de habitación' : 'Exención de vivienda no aplicada',
            ref: aplicaExencionVivienda
              ? 'Tope ' + GO.exencionViviendaUvt.toLocaleString('es-CO') + ' UVT · art. 311-1 ET'
              : esGananciaOcasional
                ? 'Requiere reinvertir en vivienda, AFC o hipoteca'
                : 'Sólo existe dentro del régimen de ganancia ocasional',
            v: exento,
          });
        }
        rows.push({ k: 'Utilidad gravada', ref: 'Lo que sí tributa', v: gravable });
        rows.push({
          k: 'Tarifa aplicada',
          ref: esGananciaOcasional ? 'Art. 314 ET' : 'Tabla del art. 241, hasta 39% marginal',
          v: esGananciaOcasional ? GO.tarifa * 100 : 39,
          format: 'unit',
          unit: esGananciaOcasional ? '%' : '% marginal máximo',
        });
        rows.push({
          k: esGananciaOcasional ? 'Impuesto de ganancia ocasional' : 'Impuesto estimado como renta ordinaria',
          ref: esGananciaOcasional ? 'Cédula de ganancias ocasionales' : 'Depende de tus demás ingresos del año',
          v: esGananciaOcasional ? impuesto : Math.round(gravable * 0.39),
          extra: true,
        });
        rows.push({
          k: 'Retención que te practica el notario',
          ref: (GO.retencionNotariaPn * 100).toFixed(0) + '% del precio · anticipo, arts. 398-401 ET',
          v: retencion,
        });
        const saldo = (esGananciaOcasional ? impuesto : Math.round(gravable * 0.39)) - retencion;
        rows.push(
          saldo >= 0
            ? { k: 'Saldo que te queda por pagar al declarar', ref: 'Impuesto menos retención', v: saldo, extra: true }
            : { k: 'Saldo a favor para imputar o pedir en devolución', ref: 'Te retuvieron de más', v: -saldo, extra: true }
        );
        rows.push({ k: 'Neto que te queda de la venta', ref: 'Precio menos impuesto', v: valor - (esGananciaOcasional ? impuesto : Math.round(gravable * 0.39)), extra: true });

        if (valor > TIMBRE.umbralUvt * UVT) {
          rows.push({
            k: 'Impuesto de timbre sobre la escritura',
            ref: 'Supera las ' + TIMBRE.umbralUvt.toLocaleString('es-CO') + ' UVT · arts. 514-554 ET',
            v: valor * TIMBRE.tarifa,
          });
        }

        if (!esGananciaOcasional) {
          sub =
            'Con ' + anios + (anios === 1 ? ' año' : ' años') + ' de posesión NO es ganancia ocasional: la utilidad va a la tabla de renta y puede pagar hasta el 39% en vez del ' +
            (GO.tarifa * 100).toFixed(0) + '%';
        } else if (gravable === 0) {
          sub = 'La exención del art. 311-1 cubre toda tu utilidad: impuesto cero, y la retención del notario queda como saldo a favor';
        } else {
          sub =
            'Tributan ' + cop(gravable) + ' de una utilidad de ' + cop(baseBruta) +
            ' · tasa efectiva sobre el precio de venta: ' +
            (valor > 0 ? ((impuesto / valor) * 100).toFixed(2).replace('.', ',') : '0') + '%';
        }
        etiquetaExento = id === 'vivienda' ? 'Utilidad exenta (art. 311-1)' : 'Exento';
      }

      const noGanancia = Math.max(0, id === 'patrimonio' ? costo : costo);

      return {
        total: cop(impuesto),
        sub: sub,
        rows: rows,
        chart: [
          {
            label: id === 'patrimonio' ? 'Deudas que restan del patrimonio' : 'Costo fiscal / gastos (nunca fue ganancia)',
            value: Math.round(noGanancia),
            tone: 'prop',
          },
          { label: etiquetaExento, value: Math.round(exento), tone: 'good' },
          { label: 'Base que sí tributa', value: Math.round(Math.max(0, gravable - impuesto)), tone: 'main' },
          { label: 'Impuesto', value: Math.round(impuesto), tone: 'bad' },
        ],
      };
    });
  })();
</script>
