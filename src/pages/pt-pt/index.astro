---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import PillarHub from '../../components/PillarHub.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
import { canDistributeCalc } from '../../lib/content-policy';
import { PORTUGAL_2026, fmtEUR, DATA_AS_OF } from '../../lib/data/portugal-2026';

const localeModules = import.meta.glob<any>('../../content/calcs-pt-pt/*.json', { eager: true });
const mainModules = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
const localeCalcs = Object.values(localeModules).map((m: any) => m.default || m).filter((c: any) => canDistributeCalc(c, 'pt-pt'));
const audienceFiltered = Object.values(mainModules)
  .map((m: any) => m.default || m)
  .filter((c: any) => c.audience === 'PT' && canDistributeCalc(c));
const calcs = [...localeCalcs, ...audienceFiltered];

const localeSlugs = new Set(localeCalcs.map((c: any) => c.slug));
function calcUrl(c: any): string {
  return localeSlugs.has(c.slug) ? `/pt-pt/${c.slug}` : `/${c.slug}`;
}

const byCategory: Record<string, any[]> = {};
calcs.forEach((c) => {
  if (!byCategory[c.category]) byCategory[c.category] = [];
  byCategory[c.category].push(c);
});

const categoryMeta: Record<string, { label: string; desc: string; color: string; icon: string }> = {
  finanzas:        { label: 'Finanças',        desc: 'Salário líquido, IRS, subsídios, Segurança Social e euro.', color: '#2563eb', icon: '💰' },
  impuestos:       { label: 'Impostos',        desc: 'IRS, IVA 23%/13%/6%, IMI, IMT e mais-valias.',              color: '#7c3aed', icon: '🧾' },
  salud:           { label: 'Saúde',           desc: 'IMC, calorias, gravidez, fitness.',                         color: '#16a34a', icon: '❤️' },
  familia:         { label: 'Família',         desc: 'Licença parental, abono de família, escola.',               color: '#db2777', icon: '👨‍👩‍👧' },
  vida:            { label: 'Vida quotidiana', desc: 'Renda, custo de vida, compras.',                            color: '#d97706', icon: '🏠' },
  automotor:       { label: 'Automóvel',       desc: 'Combustível, IUC, custo do carro.',                         color: '#6366f1', icon: '🚗' },
  educacion:       { label: 'Educação',        desc: 'Bolsas, propinas, médias.',                                 color: '#8b5cf6', icon: '🎓' },
  negocios:        { label: 'Negócios',        desc: 'Margens, IVA, recibos verdes, modelos fiscais.',            color: '#0891b2', icon: '📊' },
  marketing:       { label: 'Marketing',       desc: 'CTR, CPC, ROAS, CAC, LTV.',                                 color: '#e11d48', icon: '📈' },
  deportes:        { label: 'Desporto',        desc: 'Ritmo, 1RM, VO2 max, ciclismo.',                            color: '#65a30d', icon: '🏃' },
  viajes:          { label: 'Viagens',         desc: 'Combustível, orçamento, gorjetas.',                         color: '#0891b2', icon: '✈️' },
  cocina:          { label: 'Culinária',       desc: 'Chávenas para gramas, ajustar receita.',                    color: '#ea580c', icon: '🍳' },
  mascotas:        { label: 'Animais',         desc: 'Idade do cão/gato, alimentação.',                           color: '#db2777', icon: '🐕' },
  matematica:      { label: 'Matemática',      desc: 'Médias, Pitágoras, conversores.',                           color: '#0d9488', icon: '🧮' },
  tecnologia:      { label: 'Tecnologia',      desc: 'Armazenamento, IA, bateria, cloud.',                        color: '#06b6d4', icon: '💻' },
  'medio-ambiente':{ label: 'Ambiente',        desc: 'Pegada de carbono, energia solar.',                         color: '#22c55e', icon: '🌱' },
  electronica:     { label: 'Eletrónica',      desc: 'Lei de Ohm, kWh, circuitos.',                               color: '#f59e0b', icon: '⚡' },
  ciencia:         { label: 'Ciência',         desc: 'Física, química, astronomia.',                              color: '#6366f1', icon: '🔬' },
  jardineria:      { label: 'Jardinagem',      desc: 'Rega, terra, sementeira.',                                  color: '#15803d', icon: '🌿' },
  construccion:    { label: 'Construção',      desc: 'Materiais, orçamento de obra.',                             color: '#b45309', icon: '🧱' },
};

const categoryOrder = ['finanzas','impuestos','vida','familia','salud','automotor','educacion','negocios','marketing','deportes','viajes','cocina','mascotas','matematica','tecnologia','medio-ambiente','electronica','ciencia','jardineria','construccion'];
const activeCategories = categoryOrder.filter((cat) => byCategory[cat] && byCategory[cat].length > 0);

const totalCalcs = calcs.length;

const popularSlugs = [
  'calculadora-salario-liquido-portugal',
  'calculadora-irs-portugal-2026',
  'calculadora-subsidio-ferias-portugal',
  'calculadora-iva-portugal',
  'calculadora-compensacao-despedimento-portugal',
  'calculadora-imt-compra-casa-portugal',
];
const popular = popularSlugs.map((s) => calcs.find((c) => c.slug === s)).filter(Boolean);

// ── Dados oficiais 2026 — tudo computado a partir de src/lib/data/portugal-2026.ts (fonte única, nunca desatualizado) ──
const P = PORTUGAL_2026;
const fmtPct = (n: number) => new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 }).format(n);
const irsPrimeiraTaxa = fmtPct(P.irs.escaloes[0].taxa * 100);                          // 12,5
const irsUltimaTaxa = fmtPct(P.irs.escaloes[P.irs.escaloes.length - 1].taxa * 100);    // 48
const ssTrabPct = fmtPct(P.segSocial.trabalhador * 100);                               // 11
const ssEmpPct = fmtPct(P.segSocial.empregador * 100);                                 // 23,75
const ssIndepPct = fmtPct(P.segSocial.independente.taxaGeral * 100);                   // 21,4
const dataVerificacao = new Date(DATA_AS_OF + 'T00:00:00Z').toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const dadosOficiais = [
  { k: 'Salário mínimo nacional (RMMG)', v: `${fmtEUR(P.rmmg.mensal)} /mês × ${P.rmmg.meses} meses = ${fmtEUR(P.rmmg.anual)} /ano`, src: 'Decreto-Lei n.º 139/2025' },
  { k: 'Salário mínimo à hora (40 h/semana)', v: `${fmtEUR(P.rmmg.horaPara40h)}`, src: 'Art. 271.º Código do Trabalho' },
  { k: 'IAS — Indexante dos Apoios Sociais', v: `${fmtEUR(P.ias)}`, src: 'Portaria n.º 480-A/2025/1' },
  { k: 'IRS — escalões 2026 (continente)', v: `${P.irs.escaloes.length} escalões: ${irsPrimeiraTaxa}% → ${irsUltimaTaxa}% (taxas marginais)`, src: 'Lei n.º 73-A/2025 (OE 2026)' },
  { k: 'IRS — dedução específica (Cat. A)', v: `${fmtEUR(P.irs.deducaoEspecificaTrabalho)} (${fmtPct(P.irs.deducaoEspecificaFatorIas)} × IAS)`, src: 'CIRS' },
  { k: 'IRS — mínimo de existência', v: `${fmtEUR(P.irs.minimoExistenciaAnual)} /ano (abaixo disto não paga IRS)`, src: 'Art. 70.º CIRS' },
  { k: 'IRS Jovem', v: `isenção até ${fmtEUR(P.irsJovem.limiteIsencaoAnual)} /ano (${P.irsJovem.limiteIsencaoFatorIas} × IAS), máx. ${P.irsJovem.anosMaximos} anos, até aos ${P.irsJovem.idadeMaxima} anos`, src: 'Lei n.º 73-A/2025' },
  { k: 'Segurança Social (conta de outrem)', v: `${ssTrabPct}% trabalhador + ${ssEmpPct}% entidade empregadora`, src: 'Código Contributivo' },
  { k: 'Segurança Social — independentes', v: `${ssIndepPct}% sobre ${fmtPct(P.segSocial.independente.percRendimentoRelevanteServicos * 100)}% do faturado (base máx. ${fmtEUR(P.segSocial.independente.baseMaximaMensal)} /mês)`, src: 'Código Contributivo' },
  { k: 'Subsídio de refeição isento', v: `${fmtEUR(P.subsidios.refeicao.isentoDinheiroDia)} /dia em dinheiro · ${fmtEUR(P.subsidios.refeicao.isentoCartaoDia)} /dia em cartão`, src: 'OE 2026' },
  { k: 'Subsídio de desemprego', v: `${fmtPct(P.desemprego.percRemuneracaoReferencia * 100)}% da RR, máx. ${fmtEUR(P.desemprego.topeSuperiorMensal)} (2,5 × IAS)`, src: 'Segurança Social' },
  { k: 'Compensação por despedimento', v: `${P.cessacao.diasPorAno} dias de retribuição base por ano de antiguidade`, src: 'Art. 366.º Código do Trabalho' },
  { k: 'IVA (continente)', v: `${fmtPct(P.iva.normal * 100)}% normal · ${fmtPct(P.iva.intermedia * 100)}% intermédia · ${fmtPct(P.iva.reduzida * 100)}% reduzida`, src: 'Art. 18.º CIVA' },
  { k: 'IMI', v: `${fmtPct(P.imi.urbanoMin * 100)}%–${fmtPct(P.imi.urbanoMax * 100)}% urbano · ${fmtPct(P.imi.rustico * 100)}% rústico`, src: 'Código do IMI' },
  { k: 'IMT Jovem (isenção HPP)', v: `até ${fmtEUR(P.imt.isencaoJovemAte)} (compradores até aos ${P.imt.isencaoJovemIdadeMax} anos)`, src: 'Ofício Circulado AT n.º 40129/2026' },
];

// ── FAQ específica de Portugal: respostas com valores computados da fonte única ──
const faq = [
  {
    q: 'Qual é o salário mínimo em Portugal em 2026?',
    a: `O salário mínimo nacional (RMMG) é de ${fmtEUR(P.rmmg.mensal)} por mês desde 1 de janeiro de 2026 (Decreto-Lei n.º 139/2025), pago ${P.rmmg.meses} vezes por ano (12 meses + subsídio de férias + subsídio de Natal), o que dá ${fmtEUR(P.rmmg.anual)} anuais. É um aumento de ${fmtPct(P.rmmg.aumentoVs2025Pct * 100)}% face aos 870 € de 2025. Nos Açores o valor regional é ${fmtEUR(P.rmmg.acores)} e na Madeira ${fmtEUR(P.rmmg.madeira)}. Com um horário de 40 h/semana, o valor à hora é de ${fmtEUR(P.rmmg.horaPara40h)}.`,
  },
  {
    q: 'O que é o IAS e qual é o valor em 2026?',
    a: `O IAS (Indexante dos Apoios Sociais) é o valor de referência usado para calcular prestações sociais, limites do IRS Jovem, o teto do subsídio de desemprego e a base contributiva dos independentes. Em 2026 vale ${fmtEUR(P.ias)} (Portaria n.º 480-A/2025/1), uma subida de 2,8% face aos 522,50 € de 2025.`,
  },
  {
    q: 'Como se calcula o salário líquido em Portugal?',
    a: `Ao salário bruto descontam-se ${ssTrabPct}% para a Segurança Social e a retenção mensal de IRS segundo as tabelas em vigor. Líquido = bruto − SS − IRS. Quem ganha o salário mínimo (${fmtEUR(P.rmmg.mensal)} × ${P.rmmg.meses} = ${fmtEUR(P.rmmg.anual)} /ano) não paga IRS, porque fica dentro do mínimo de existência de ${fmtEUR(P.irs.minimoExistenciaAnual)}. A nossa calculadora de salário líquido faz as contas com os escalões de 2026.`,
  },
  {
    q: 'Quais são os escalões do IRS em 2026?',
    a: `O IRS de 2026 (continente) tem ${P.irs.escaloes.length} escalões com taxas marginais de ${irsPrimeiraTaxa}% (rendimento coletável até ${fmtEUR(P.irs.escaloes[0].ateEuros)}) a ${irsUltimaTaxa}% (acima de ${fmtEUR(P.irs.escaloes[P.irs.escaloes.length - 2].ateEuros)}), atualizados pela Lei n.º 73-A/2025 (OE 2026). As taxas aplicam-se ao rendimento coletável — o bruto menos a dedução específica de ${fmtEUR(P.irs.deducaoEspecificaTrabalho)} (ou as contribuições para a SS, se forem superiores) — e não diretamente ao salário bruto.`,
  },
  {
    q: 'Como funciona o IRS Jovem em 2026?',
    a: `O IRS Jovem isenta parte do rendimento do trabalho (Cat. A e B) de quem tem até ${P.irsJovem.idadeMaxima} anos, durante um máximo de ${P.irsJovem.anosMaximos} anos: 100% de isenção no 1.º ano, 75% do 2.º ao 4.º, 50% do 5.º ao 7.º e 25% do 8.º ao 10.º. A parte isenta tem um limite anual de ${P.irsJovem.limiteIsencaoFatorIas} × IAS = ${fmtEUR(P.irsJovem.limiteIsencaoAnual)}.`,
  },
  {
    q: 'Quanto desconto para a Segurança Social?',
    a: `Um trabalhador por conta de outrem desconta ${ssTrabPct}% do salário bruto; a entidade empregadora paga mais ${ssEmpPct}% (que não sai do recibo), num total de ${fmtPct(P.segSocial.totalTco * 100)}%. Os trabalhadores independentes (recibos verdes) pagam ${ssIndepPct}% sobre 70% do que faturam em serviços (base mensal máxima de ${fmtEUR(P.segSocial.independente.baseMaximaMensal)} = 12 × IAS), com isenção nos primeiros 12 meses de atividade.`,
  },
  {
    q: 'Quantos salários se recebem por ano em Portugal?',
    a: `Catorze: 12 meses de ordenado mais o subsídio de férias (1 mês) e o subsídio de Natal (1 mês). Cada subsídio corresponde a um mês de retribuição base. É por isso que o salário anual em Portugal se calcula multiplicando o mensal por ${P.subsidios.totalMesesAno} — e que as nossas calculadoras de férias, Natal e salário anual usam ${P.subsidios.totalMesesAno} meses por defeito.`,
  },
  {
    q: 'Qual é o valor do subsídio de refeição isento de impostos em 2026?',
    a: `O subsídio de refeição está isento de IRS e de Segurança Social até ${fmtEUR(P.subsidios.refeicao.isentoDinheiroDia)} por dia se for pago em dinheiro, ou até ${fmtEUR(P.subsidios.refeicao.isentoCartaoDia)} por dia se for pago em cartão ou vale refeição. Só o excedente acima destes limites é tributado.`,
  },
  {
    q: 'Como se calcula o subsídio de desemprego?',
    a: `O subsídio de desemprego é ${fmtPct(P.desemprego.percRemuneracaoReferencia * 100)}% da remuneração de referência (a média dos salários de 12 dos últimos 14 meses, incluindo férias e Natal), com um teto de ${fmtEUR(P.desemprego.topeSuperiorMensal)} por mês (2,5 × IAS) e um piso de ${fmtEUR(P.desemprego.minimoComRmmg)} (1,15 × IAS) quando a remuneração de referência é igual ou superior ao salário mínimo. A duração depende da idade e do tempo de descontos.`,
  },
  {
    q: 'Quanto se recebe de compensação por despedimento?',
    a: `No regime atual, a compensação por cessação do contrato é de ${P.cessacao.diasPorAno} dias de retribuição base e diuturnidades por cada ano completo de antiguidade (fração proporcional). Há dois tetos legais: a retribuição mensal considerada não pode exceder ${P.cessacao.topeRetribuicaoMensalFatorRmmg} × RMMG (${fmtEUR(P.cessacao.topeRetribuicaoMensal)}) e a compensação total não pode passar de ${P.cessacao.topeCompensacaoFatorRmmg} × RMMG (${fmtEUR(P.cessacao.topeCompensacaoTotal)}). Para antiguidade anterior a outubro de 2013 aplicam-se regras transitórias mais generosas.`,
  },
  {
    q: 'Quais são as taxas de IVA em Portugal?',
    a: `No continente, o IVA tem três taxas: ${fmtPct(P.iva.normal * 100)}% (normal, a maioria dos bens e serviços), ${fmtPct(P.iva.intermedia * 100)}% (intermédia, restauração e alguns alimentos) e ${fmtPct(P.iva.reduzida * 100)}% (reduzida, bens essenciais como pão, leite, medicamentos e livros). Os Açores aplicam 16%/9%/4% e a Madeira 22%/12%/5%.`,
  },
  {
    q: 'Quanto se paga de IMT ao comprar casa em 2026?',
    a: `O IMT calcula-se por escalões sobre o maior valor entre o preço e o VPT. Para habitação própria e permanente, está isento até ${fmtEUR(P.imt.hpp[0].ateEuros)}; acima disso aplicam-se taxas marginais de 2% a 8% com parcela a abater (Ofício Circulado AT n.º 40129/2026). Os jovens até aos ${P.imt.isencaoJovemIdadeMax} anos têm isenção total de IMT na compra da primeira habitação própria até ${fmtEUR(P.imt.isencaoJovemAte)}.`,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['CollectionPage', 'WebPage'],
      '@id': 'https://hacecuentas.com/pt-pt#webpage',
      url: 'https://hacecuentas.com/pt-pt',
      name: 'Calculadoras Portugal 2026 — IRS, IVA, salário líquido, Segurança Social | Hacé Cuentas',
      description: 'Calculadoras gratuitas específicas para Portugal.',
      inLanguage: 'pt-PT',
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      breadcrumb: { '@id': 'https://hacecuentas.com/pt-pt#breadcrumb' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://hacecuentas.com/pt-pt#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Hacé Cuentas', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Portugal', item: 'https://hacecuentas.com/pt-pt' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://hacecuentas.com/pt-pt#faq',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Dataset',
      '@id': 'https://hacecuentas.com/pt-pt#dados-2026',
      name: 'Dados fiscais e laborais de Portugal 2026',
      description: `Valores oficiais em vigor em Portugal (continente) em 2026: salário mínimo nacional (${fmtEUR(P.rmmg.mensal)} × ${P.rmmg.meses} meses), IAS (${fmtEUR(P.ias)}), escalões do IRS (${irsPrimeiraTaxa}%–${irsUltimaTaxa}%), IRS Jovem, descontos para a Segurança Social (${ssTrabPct}% + ${ssEmpPct}%; independentes ${ssIndepPct}%), subsídios de férias, Natal e refeição, subsídio de desemprego, compensação por despedimento, IVA ${fmtPct(P.iva.normal * 100)}%/${fmtPct(P.iva.intermedia * 100)}%/${fmtPct(P.iva.reduzida * 100)}%, IMI e IMT.`,
      url: 'https://hacecuentas.com/pt-pt',
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      inLanguage: 'pt-PT',
      temporalCoverage: '2026',
      spatialCoverage: { '@type': 'Place', name: 'Portugal' },
      creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
      sourceOrganization: [
        { '@type': 'GovernmentOrganization', name: 'Segurança Social', url: 'https://www.seg-social.pt' },
        { '@type': 'GovernmentOrganization', name: 'Autoridade Tributária e Aduaneira (AT)', url: 'https://www.portaldasfinancas.gov.pt' },
        { '@type': 'GovernmentOrganization', name: 'Diário da República Eletrónico', url: 'https://diariodarepublica.pt' },
      ],
      keywords: ['salário mínimo Portugal 2026', 'IAS 2026', 'escalões IRS 2026', 'salário líquido Portugal', 'IRS Jovem', 'descontos Segurança Social', 'subsídio de desemprego', 'subsídio de refeição 2026', 'IVA Portugal', 'IMT 2026', 'IMI'],
    },
  ],
};

// Set hreflang único y simétrico para todas las homes (es + en + pt + pt-pt +
// verticales + global), x-default → home raíz. Ver src/lib/hreflang.ts.
const hreflangTags = HOME_HREFLANG;

// Identidad de hub (mockup): hero vía PillarHub full-bleed; el contenido del país
// (populares, categorías, datos, FAQ) se preserva debajo dentro de .cc-index.
const hubConfig = {
  color: '#2563eb',
  nav: 'Portugal',
  h1: 'Calculadoras para Portugal',
  breadcrumb: [{ label: 'Hacé Cuentas', href: '/' }, { label: 'Portugal' }],
  eyebrow: '🇵🇹 Portugal · 2026',
  titleLines: ['Calculadoras', 'para Portugal'],
  lead: 'Salário líquido, IRS, subsídios de férias e de Natal, descontos para a Segurança Social, IVA e indemnização por despedimento. Adaptadas a Portugal. Grátis.',
  trust: [`${totalCalcs} calculadoras`, 'Dados oficiais 2026', 'Grátis e sem registo'],
  needsKicker: '', needsTitle: '', needsSub: '', needs: [] as any[],
  featuredKicker: '', featuredTitle: '', featuredSub: '', showFeaturedSearch: false, filterBadges: [] as string[], cards: [] as any[],
  roomsKicker: '', roomsTitle: '', roomsSub: '', rooms: [] as any[], factsTitle: '', facts: [] as any[],
};
---

<Layout
  title="Calculadoras Portugal 2026 — IRS, IVA, salário líquido, Segurança Social | Hacé Cuentas"
  description={`Calculadoras gratuitas para Portugal: salário líquido, IRS, subsídios de férias e Natal, Segurança Social, IVA e indemnização por despedimento. Dados de 2026.`}
  lang="pt"
  audience="PT"
  hreflang={hreflangTags}
  schema={schema}
  pageType="hub"
>
  <Header slot="header" lang="es" />

  <PillarHub config={hubConfig} />

  <div class="cc-index">

    {popular.length > 0 && (
      <section class="popular-section" aria-label="Mais usadas">
        <h2 class="popular-title">Mais usadas em Portugal</h2>
        <div class="popular-grid">
          {popular.map((c: any) => (
            <a href={calcUrl(c)} class="popular-card">
              <span class="popular-icon">{c.icon || '🧮'}</span>
              <span class="popular-label">{c.h1}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="datos-clave" aria-labelledby="dados-oficiais-title">
      <h2 id="dados-oficiais-title">Dados oficiais de Portugal 2026</h2>
      <p class="section-sub">Os valores em vigor que todas as nossas calculadoras portuguesas usam. Utilização livre com atribuição (CC-BY 4.0).</p>
      <div class="dc-wrap">
        <table class="dc-table">
          <thead>
            <tr><th>Conceito</th><th>Valor 2026</th><th>Fonte</th></tr>
          </thead>
          <tbody>
            {dadosOficiais.map((d) => (
              <tr><td>{d.k}</td><td>{d.v}</td><td class="dc-src">{d.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dc-note">Última verificação: {dataVerificacao}. Fontes: Diário da República, Autoridade Tributária e Segurança Social. Os valores referem-se a Portugal continental — os Açores e a Madeira têm salário mínimo e IVA próprios.</p>
    </section>

    <p class="hub-link-wrap">
      <a href="/pt-pt/calculadoras" class="hub-link">Ver o catálogo completo de calculadoras de Portugal →</a>
    </p>

    {activeCategories.length > 0 && (
      <div class="categories">
        {activeCategories.map((catKey) => {
          const meta = categoryMeta[catKey];
          const catCalcs = byCategory[catKey];
          return (
            <section class="category-section" aria-labelledby={`cat-${catKey}`}>
              <div class="cat-header">
                <span class="cat-icon" aria-hidden="true" style={`background: ${meta?.color}18`}>{meta?.icon ?? '📁'}</span>
                <div class="cat-meta">
                  <h2 id={`cat-${catKey}`} class="cat-label">{meta?.label ?? catKey}</h2>
                  {meta?.desc && <p class="cat-desc">{meta.desc}</p>}
                </div>
              </div>
              <div class="calc-grid">
                {catCalcs.map((calc: any) => (
                  <a href={calcUrl(calc)} class="calc-card">
                    <span class="card-icon" aria-hidden="true">{calc.icon}</span>
                    <div class="card-body">
                      <span class="card-title">{calc.h1}</span>
                      <span class="card-desc">{calc.description}</span>
                    </div>
                    <span class="card-badge" style={`background:${meta?.color}18; color:${meta?.color}`}>{meta?.label ?? catKey}</span>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    )}

    <section class="faq-hub" aria-labelledby="faq-title">
      <h2 id="faq-title">Perguntas frequentes sobre salários e impostos em Portugal 2026</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <details>
            <summary><span>{f.q}</span></summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

