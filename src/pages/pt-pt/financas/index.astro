---
/**
 * Silo Finanças · Portugal — índice dos hubs de decisão do mercado PT.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';

const HREF = '/pt-pt/financas';
const SILO = 'Finanças';
const LEDE =
  'Crédito à habitação, taxa de esforço, amortização antecipada, Certificados de Aforro, reforma e complementos da Segurança Social: as decisões de dinheiro de médio e longo prazo em Portugal.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${SILO} em Portugal`,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title="Finanças em Portugal — crédito habitação, poupança e reforma | Hacé Cuentas"
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="PT"
  lang="pt"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
