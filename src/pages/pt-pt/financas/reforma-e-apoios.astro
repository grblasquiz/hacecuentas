---
/**
 * Hub de decisão PT — "Quando o salário deixa de entrar: o que o Estado garante".
 * A rota vive sob /pt-pt/, tal como as calculadoras que absorve.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, IAS, PENSAO, CSI, RSI } from '../../../lib/hubs/pt-pt/reforma-e-apoios';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://hacecuentas.com/pt-pt' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="PT"
  lang="pt"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ IAS, PENSAO, CSI, RSI }}>
  (function () {
    const H = window.HC_HUB;
    const eur = (n, d) =>
      Number(n || 0).toLocaleString('de-DE', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      }) + ' €';

    /**
     * Taxa global de formação da pensão. Espelho da fórmula viva, SEM o piso de
     * "pensão mínima" de 0,55 × IAS, que não tem norma que o suporte.
     */
    function taxaFormacao(rr, anos) {
      if (anos <= PENSAO.anosDeCorte) {
        return Math.min(anos * PENSAO.taxaAnualAte20Anos, PENSAO.limiteGlobal);
      }
      let ponderada = 0;
      let anterior = 0;
      for (const e of PENSAO.escaloes) {
        const limite = e.ateIas === null ? Infinity : e.ateIas * IAS;
        const naFaixa = Math.min(rr, limite) - anterior;
        if (naFaixa > 0) ponderada += (naFaixa / rr) * e.taxaAno;
        anterior = limite;
        if (rr <= limite) break;
      }
      return Math.min(ponderada * anos, PENSAO.limiteGlobal);
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'pensao';
      const rows = [];
      let total = 0;
      let sub = '';
      let chart = [];

      if (id === 'csi') {
        const casal = String(v.situacaoCsi || 'isolado') === 'casal';
        const referenciaAnual = casal ? CSI.casalAnual : CSI.isoladoAnual;
        const rendimentos = Math.max(0, v.rendimentosAnuais || 0);
        total = Math.max(0, (referenciaAnual - rendimentos) / 12);

        rows.push({ k: 'Situação', ref: casal ? 'Casal' : 'Vive só', v: casal ? 2 : 1, format: 'unit', unit: 'pessoa(s)' });
        rows.push({ k: 'Valor de referência anual', ref: casal ? 'Referência do casal' : 'Referência de quem vive só', v: referenciaAnual, format: 'unit', unit: '€' });
        rows.push({ k: 'Equivalente mensal da referência', ref: 'Anual ÷ 12', v: referenciaAnual / 12, format: 'unit', unit: '€', decimals: 2 });
        rows.push({ k: 'Rendimentos anuais considerados', ref: 'Pensões e outros rendimentos', v: rendimentos, format: 'unit', unit: '€' });
        rows.push({ k: 'Diferença até à referência', ref: 'É isto que o CSI cobre', v: Math.max(0, referenciaAnual - rendimentos), format: 'unit', unit: '€' });
        rows.push({ k: 'CSI mensal estimado', ref: 'Prestação diferencial', v: total, extra: true, format: 'unit', unit: '€', decimals: 2 });
        rows.push({ k: 'Rendimento mensal total com o CSI', ref: 'Rendimentos próprios + complemento', v: rendimentos / 12 + total, format: 'unit', unit: '€', decimals: 2 });
        rows.push({
          k: 'Rendimento anual acima do qual deixa de ter direito',
          ref: 'Valor de referência',
          v: referenciaAnual,
          format: 'unit',
          unit: '€',
        });
        rows.push({ k: 'Idade mínima exigida', ref: 'Requisito de acesso', v: CSI.idadeMinima, format: 'unit', unit: 'anos' });

        sub =
          (total > 0
            ? 'Tem direito a ' + eur(total) + ' por mês de complemento'
            : 'Sem direito: os rendimentos já atingem o valor de referência') +
          ' · sujeito a condição de recursos, que considera também o património e os rendimentos dos filhos';
        chart = [
          { label: 'Rendimentos próprios (por mês)', value: Math.round(rendimentos / 12), tone: 'main' },
          { label: 'Complemento do Estado', value: Math.round(total), tone: 'good' },
        ];
      } else if (id === 'rsi') {
        const nAdultos = Math.max(1, Math.round(v.nAdultos || 1));
        const nCriancas = Math.max(0, Math.round(v.nCriancas || 0));
        const rendimentos = Math.max(0, v.rendimentosMensais || 0);
        const referencia = RSI.titular + RSI.adultoAdicional * (nAdultos - 1) + RSI.crianca * nCriancas;
        total = Math.max(0, referencia - rendimentos);

        rows.push({ k: 'Titular', ref: 'Primeiro adulto do agregado', v: RSI.titular, format: 'unit', unit: '€', decimals: 2 });
        rows.push({
          k: 'Adultos adicionais',
          ref: (nAdultos - 1) + ' × ' + eur(RSI.adultoAdicional, 2),
          v: RSI.adultoAdicional * (nAdultos - 1),
          format: 'unit',
          unit: '€',
          decimals: 2,
        });
        rows.push({
          k: 'Crianças e jovens com menos de 18 anos',
          ref: nCriancas + ' × ' + eur(RSI.crianca, 2),
          v: RSI.crianca * nCriancas,
          format: 'unit',
          unit: '€',
          decimals: 2,
        });
        rows.push({ k: 'Valor de referência do agregado', ref: 'Escala de equivalência', v: referencia, format: 'unit', unit: '€', decimals: 2 });
        rows.push({ k: 'Rendimentos mensais do agregado', ref: 'Tudo o que já entra', v: rendimentos, format: 'unit', unit: '€' });
        rows.push({ k: 'RSI mensal estimado', ref: 'Prestação diferencial', v: total, extra: true, format: 'unit', unit: '€', decimals: 2 });
        rows.push({ k: 'Rendimento mensal total com o RSI', ref: 'Rendimentos próprios + prestação', v: rendimentos + total, format: 'unit', unit: '€', decimals: 2 });
        rows.push({ k: 'RSI ao fim de um ano', ref: '12 mensalidades', v: total * 12, format: 'unit', unit: '€' });
        rows.push({
          k: 'Rendimento mensal acima do qual deixa de ter direito',
          ref: 'Valor de referência do agregado',
          v: referencia,
          format: 'unit',
          unit: '€',
          decimals: 2,
        });

        sub =
          (total > 0
            ? 'Tem direito a ' + eur(total) + ' por mês'
            : 'Sem direito: o agregado já supera o valor de referência de ' + eur(referencia)) +
          ' · cada euro de rendimento que entra retira um euro de prestação';
        chart = [
          { label: 'Rendimentos próprios', value: Math.round(rendimentos), tone: 'main' },
          { label: 'RSI que completa', value: Math.round(total), tone: 'good' },
        ];
      } else {
        // ── Pensão de reforma ──
        const rr = Math.max(0, v.remuneracaoMedia || 0);
        const anos = Math.min(50, Math.max(0, Math.round(v.anosDescontos || 0)));
        const taxa = rr > 0 && anos > 0 ? taxaFormacao(rr, anos) : 0;
        total = rr * taxa;
        const acedeAoRegimeGeral = anos >= PENSAO.anosMinimosCarreira;

        rows.push({ k: 'Remuneração de referência mensal', ref: 'Média da carreira contributiva', v: rr, format: 'unit', unit: '€' });
        rows.push({ k: 'Anos de descontos', ref: 'Anos civis com registo de remunerações', v: anos, format: 'unit', unit: 'anos' });
        rows.push({
          k: 'Taxa global de formação da pensão',
          ref: anos <= PENSAO.anosDeCorte
            ? (PENSAO.taxaAnualAte20Anos * 100).toLocaleString('de-DE') + ' % por ano de carreira'
            : 'Escala de 2,0 % a 2,3 % por ano · carreira longa',
          v: taxa * 100,
          format: 'unit',
          unit: '%',
          decimals: 1,
        });
        rows.push({ k: 'Pensão mensal estimada', ref: 'Remuneração de referência × taxa de formação', v: total, extra: true, format: 'unit', unit: '€', decimals: 2 });
        rows.push({
          k: 'Taxa de substituição do rendimento',
          ref: 'Pensão ÷ remuneração de referência',
          v: rr > 0 ? (total / rr) * 100 : 0,
          format: 'unit',
          unit: '%',
          decimals: 1,
        });
        rows.push({ k: 'Quanto perde face à remuneração de referência', ref: 'Diferença mensal', v: Math.max(0, rr - total), format: 'unit', unit: '€', decimals: 2 });
        rows.push({
          k: 'Pensão máxima possível com esta remuneração',
          ref: 'Limite global de ' + (PENSAO.limiteGlobal * 100).toLocaleString('de-DE') + ' %',
          v: rr * PENSAO.limiteGlobal,
          format: 'unit',
          unit: '€',
          decimals: 2,
        });
        rows.push({
          k: 'Anos que ainda faltam para atingir o limite global',
          ref: 'Mantendo esta remuneração de referência',
          v: taxa >= PENSAO.limiteGlobal || anos <= 0 ? 0 : Math.max(0, Math.ceil((PENSAO.limiteGlobal - taxa) / (taxa / anos))),
          format: 'unit',
          unit: 'anos',
        });
        rows.push({ k: 'Pensão anual estimada', ref: '14 meses, como os salários', v: total * 14, format: 'unit', unit: '€' });
        rows.push({
          k: 'Anos de carreira exigidos para a pensão do regime geral',
          ref: acedeAoRegimeGeral ? 'Já os tem' : 'Ainda não os tem',
          v: PENSAO.anosMinimosCarreira,
          format: 'unit',
          unit: 'anos',
        });

        sub =
          'Taxa de formação de ' + (taxa * 100).toFixed(1).replace('.', ',') + ' % · substitui ' +
          (rr > 0 ? ((total / rr) * 100).toFixed(0) : '0') + ' % do que ganhava' +
          (acedeAoRegimeGeral ? '' : ' · atenção: com menos de ' + PENSAO.anosMinimosCarreira + ' anos de carreira não há acesso à pensão do regime geral') +
          ' · sem fator de sustentabilidade nem pensão mínima aplicados';
        chart = [
          { label: 'Pensão estimada', value: Math.round(total), tone: 'good' },
          { label: 'Rendimento que deixa de ter', value: Math.round(Math.max(0, rr - total)), tone: 'bad' },
        ];
      }

      return {
        total: eur(total),
        sub: sub,
        rows: rows,
        chart: chart,
      };
    });
  })();
</script>
