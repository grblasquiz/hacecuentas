---
/**
 * Silo Trabalho · Portugal — índice dos hubs de decisão do mercado PT.
 * O listado sai do registry (hubsOfSilo), não à mão.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';

const HREF = '/pt-pt/trabalho';
const SILO = 'Trabalho';
const LEDE =
  'Salário líquido, retenção na fonte, subsídios de férias e de Natal, subsídio de refeição, férias, feriados e baixas: as contas do recibo de vencimento em Portugal, com as taxas da Segurança Social e os escalões de IRS em vigor.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${SILO} em Portugal`,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title="Trabalho em Portugal — calculadoras de salário e subsídios | Hacé Cuentas"
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="PT"
  lang="pt"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
