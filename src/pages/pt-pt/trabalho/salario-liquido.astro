---
/**
 * Hub de decisão PT — "Quanto é que recebo mesmo ao fim do mês?".
 * A rota vive sob /pt-pt/, tal como as calculadoras que absorve.
 *
 * audience="PT" vai literal ao Layout: HubData só modela 'AR' | 'global' e o
 * mercado real viaja em hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SalarioLiquidoPortugalExperience from '../../../components/generated/SalarioLiquidoPortugalExperience.astro';
import {
  hub,
  RMMG,
  SS,
  ESCALOES,
  IRS_BASES,
  IRS_JOVEM,
  REFEICAO,
  AJUDAS,
} from '../../../lib/hubs/pt-pt/salario-liquido';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://hacecuentas.com/pt-pt' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="PT"
  lang="pt"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SalarioLiquidoPortugalExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ RMMG, SS, ESCALOES, IRS_BASES, IRS_JOVEM, REFEICAO, AJUDAS }}
>
  (function () {
    const H = window.HC_HUB;
    /** Formato português: ponto para milhares, vírgula para decimais. */
    const eur = (n, d) =>
      Number(n || 0).toLocaleString('de-DE', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      }) + ' €';

    /** Escala progressiva de IRS sobre o rendimento coletável (taxas marginais reais). */
    function irsPorEscaloes(base) {
      if (base <= 0) return 0;
      let imposto = 0;
      let anterior = 0;
      for (const e of ESCALOES) {
        const limite = e.ate === null ? Infinity : e.ate;
        const noTramo = Math.min(base, limite) - anterior;
        if (noTramo > 0) imposto += noTramo * e.taxa;
        anterior = limite;
        if (base <= limite) break;
      }
      return imposto;
    }

    /** Taxa marginal do escalão em que cai o rendimento coletável. */
    function marginal(base) {
      let anterior = 0;
      for (const e of ESCALOES) {
        const limite = e.ate === null ? Infinity : e.ate;
        if (base <= limite) return { taxa: e.taxa, de: anterior, ate: e.ate };
        anterior = limite;
      }
      const u = ESCALOES[ESCALOES.length - 1];
      return { taxa: u.taxa, de: anterior, ate: null };
    }

    /**
     * IRS anual de trabalho dependente a partir do bruto anual.
     * Espelho exato de irsTrabalhoDependenteAnual() de src/lib/data/portugal-2026.ts.
     */
    function irsAnualTrabalho(brutoAnual, ssAnual, isencaoJovem) {
      if (brutoAnual <= 0) return 0;
      const isento = Math.min(brutoAnual * (isencaoJovem || 0), IRS_JOVEM.limiteIsencaoAnual);
      const tributavel = Math.max(0, brutoAnual - isento);
      if (tributavel <= IRS_BASES.minimoExistencia) return 0;
      const deducao = Math.max(IRS_BASES.deducaoEspecifica, ssAnual);
      return irsPorEscaloes(Math.max(0, tributavel - deducao));
    }

    /** Percentagem de isenção do IRS Jovem pelo ano de obtenção de rendimentos. */
    function isencaoJovemDoAno(ano) {
      const a = Math.min(IRS_JOVEM.anosMaximos, Math.max(1, Math.round(ano || 1)));
      if (a === 1) return 1;
      if (a <= 4) return 0.75;
      if (a <= 7) return 0.5;
      return 0.25;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'tco';
      const bruto = Math.max(0, v.bruto || 0);
      const dias = Math.max(0, Math.round(v.diasTrabalho || 0));
      const refDia = Math.max(0, v.refeicaoDia || 0);
      const emCartao = String(v.meioRefeicao || 'cartao') !== 'dinheiro';
      const horasSemana = Math.min(60, Math.max(1, Math.round(v.horasSemana || RMMG.horasSemanaPadrao)));

      // ── Subsídio de refeição: isento até ao limite, o excedente é tributado ──
      const limiteRef = emCartao ? REFEICAO.cartao : REFEICAO.dinheiro;
      const refIsentoMes = Math.min(refDia, limiteRef) * dias;
      const refTributadoMes = Math.max(0, refDia - limiteRef) * dias;
      const refTotalMes = refDia * dias;

      // ── Base de incidência: bruto + parte do subsídio de refeição que passa o limite ──
      const base = bruto + refTributadoMes;
      const ss = base * SS.trabalhador;
      const ssPatronal = base * SS.empregador;

      const isencaoJovem = id === 'jovem' ? isencaoJovemDoAno(v.anoJovem) : 0;
      const brutoAnual = base * RMMG.meses;
      const irsAnualTotal = irsAnualTrabalho(brutoAnual, ss * RMMG.meses, isencaoJovem);
      const irs = irsAnualTotal / RMMG.meses;

      // ── Ajudas de custo e quilómetros: isentos dentro dos limites ──
      const diasDesloc = Math.max(0, Math.round(v.diasDeslocacao || 0));
      const valorDiaAjuda =
        String(v.destino || 'nacional') === 'estrangeiro' ? AJUDAS.estrangeiroDia : AJUDAS.nacionalDia;
      const km = Math.max(0, v.km || 0);
      const ajudas = diasDesloc * valorDiaAjuda + km * AJUDAS.kmViaturaPropria;

      const liquidoSalario = bruto + refTotalMes - ss - irs;
      const totalEmMao = liquidoSalario + ajudas;

      // ── Valor da hora (art. 271.º CT: retribuição × 12 ÷ (52 × horas/semana)) ──
      const valorHora = (bruto * 12) / (52 * horasSemana);
      const pisoHora = (RMMG.mensal * 12) / (52 * horasSemana);

      // ── Subsídios de férias e de Natal: IRS marginal (14 meses vs 13) ──
      const ssSub = bruto * SS.trabalhador;
      const irs14 = irsAnualTrabalho(bruto * 14, ssSub * 14, isencaoJovem);
      const irs13 = irsAnualTrabalho(bruto * 13, ssSub * 13, isencaoJovem);
      const irsSubsidio = Math.max(0, irs14 - irs13);
      const subsidioLiquido = bruto - ssSub - irsSubsidio;

      const coletavelAnual = Math.max(
        0,
        Math.max(0, brutoAnual - Math.min(brutoAnual * isencaoJovem, IRS_JOVEM.limiteIsencaoAnual)) -
          Math.max(IRS_BASES.deducaoEspecifica, ss * RMMG.meses)
      );
      const m = marginal(coletavelAnual);
      const descontoPct = base > 0 ? ((ss + irs) / (bruto + refTotalMes)) * 100 : 0;

      const rows = [
        { k: 'Salário base mensal bruto', ref: 'Contrato de trabalho', v: bruto, format: 'unit', unit: '€' },
        {
          k: 'Subsídio de refeição isento',
          ref: 'Até ' + eur(limiteRef, 2) + '/dia em ' + (emCartao ? 'cartão' : 'dinheiro'),
          v: refIsentoMes,
          format: 'unit',
          unit: '€',
        },
      ];

      if (refTributadoMes > 0) {
        rows.push({
          k: 'Subsídio de refeição acima do limite (tributado)',
          ref: 'Entra na base de IRS e de Segurança Social',
          v: refTributadoMes,
          format: 'unit',
          unit: '€',
        });
      }

      rows.push({
        k: 'Base de incidência do mês',
        ref: 'Bruto + excedente do subsídio de refeição',
        v: base,
        format: 'unit',
        unit: '€',
      });
      rows.push({
        k: 'Segurança Social do trabalhador (desconta)',
        ref: (SS.trabalhador * 100).toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' % · Código Contributivo',
        v: ss,
        format: 'unit',
        unit: '€',
      });
      rows.push({
        k: 'Retenção de IRS estimada (desconta)',
        ref:
          isencaoJovem > 0
            ? 'IRS Jovem: ' + (isencaoJovem * 100).toLocaleString('de-DE') + ' % isento'
            : irs > 0
              ? 'Escalões da Lei n.º 73-A/2025'
              : 'Abaixo do mínimo de existência',
        v: irs,
        format: 'unit',
        unit: '€',
      });
      rows.push({
        k: 'Salário líquido do mês',
        ref: 'Com subsídio de refeição incluído',
        v: liquidoSalario,
        format: 'unit',
        unit: '€',
      });

      if (ajudas > 0) {
        rows.push({
          k: 'Ajudas de custo e quilómetros isentos',
          ref:
            diasDesloc + ' dia(s) × ' + eur(valorDiaAjuda, 2) +
            (km > 0 ? ' + ' + km.toLocaleString('de-DE') + ' km × ' + eur(AJUDAS.kmViaturaPropria, 2) : ''),
          v: ajudas,
          format: 'unit',
          unit: '€',
        });
      }

      rows.push({
        k: 'Total em mão no mês',
        ref: 'Líquido + isentos',
        v: totalEmMao,
        extra: true,
        format: 'unit',
        unit: '€',
      });
      rows.push({
        k: 'Peso dos descontos sobre o que recebe',
        ref: 'Segurança Social + IRS',
        v: descontoPct,
        format: 'unit',
        unit: '%',
        decimals: 1,
      });
      rows.push({
        k: 'Rendimento coletável anual',
        ref: 'Dedução específica de ' + eur(IRS_BASES.deducaoEspecifica, 2),
        v: coletavelAnual,
        format: 'unit',
        unit: '€',
      });
      rows.push({
        k: 'Escalão de IRS em que cai',
        ref: m.ate === null ? 'Acima de ' + eur(m.de) : eur(m.de) + ' a ' + eur(m.ate),
        v: m.taxa * 100,
        format: 'unit',
        unit: '% marginal',
        decimals: 1,
      });
      rows.push({
        k: 'Valor da sua hora',
        ref: 'Art. 271.º CT · ' + horasSemana + ' h/semana',
        v: valorHora,
        format: 'unit',
        unit: '€/hora',
        decimals: 2,
      });
      rows.push({
        k: 'Piso legal do valor/hora à RMMG',
        ref: 'RMMG ' + eur(RMMG.mensal) + ' · ' + horasSemana + ' h/semana',
        v: pisoHora,
        format: 'unit',
        unit: '€/hora',
        decimals: 2,
      });
      rows.push({
        k: 'Subsídio de férias líquido',
        ref: 'Art. 264.º CT · um mês de retribuição base',
        v: subsidioLiquido,
        format: 'unit',
        unit: '€',
      });
      rows.push({
        k: 'Subsídio de Natal líquido',
        ref: 'Art. 263.º CT · um mês de retribuição base',
        v: subsidioLiquido,
        format: 'unit',
        unit: '€',
      });
      rows.push({
        k: 'Rendimento bruto anual a ' + RMMG.meses + ' meses',
        ref: 'Base do cálculo do IRS',
        v: brutoAnual,
        format: 'unit',
        unit: '€',
      });
      rows.push({
        k: 'Custo da entidade patronal (não sai do seu recibo)',
        ref: (SS.empregador * 100).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' % sobre a base',
        v: ssPatronal,
        format: 'unit',
        unit: '€',
      });

      const abaixoDoMinimo = bruto > 0 && bruto < RMMG.mensal;
      const sub =
        (irs > 0
          ? 'Retêm-lhe ' + eur(irs) + ' de IRS por mês'
          : 'Sem retenção de IRS: fica no mínimo de existência') +
        ' · desconta ' + eur(ss) + ' de Segurança Social' +
        ' · a sua hora vale ' + eur(valorHora, 2) +
        (abaixoDoMinimo ? ' · atenção: o seu bruto está abaixo da RMMG de ' + eur(RMMG.mensal) : '');

      return {
        total: eur(totalEmMao),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Fica em mão', value: Math.round(totalEmMao), tone: 'good' },
          { label: 'Segurança Social', value: Math.round(ss), tone: 'warn' },
          { label: 'Retenção de IRS', value: Math.round(irs), tone: 'bad' },
        ],
      };
    });
  })();
</script>
