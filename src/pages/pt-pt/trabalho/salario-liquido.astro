---
/**
 * Hub de decisão PT — "Quanto é que recebo mesmo ao fim do mês?".
 * A rota vive sob /pt-pt/, tal como as calculadoras que absorve.
 *
 * audience="PT" vai literal ao Layout: HubData só modela 'AR' | 'global' e o
 * mercado real viaja em hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SalarioLiquidoPortugalExperience from '../../../components/generated/SalarioLiquidoPortugalExperience.astro';
import {
  hub,
  RMMG,
  SS,
  ESCALOES,
  IRS_BASES,
  IRS_JOVEM,
  REFEICAO,
  AJUDAS,
} from '../../../lib/hubs/pt-pt/salario-liquido';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://hacecuentas.com/pt-pt' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="PT"
  lang="pt"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SalarioLiquidoPortugalExperience data={hub} />
  <Footer />
</Layout>

