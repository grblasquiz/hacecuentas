---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SalarioMinimoPortugalHoraExperience from '../../components/generated/SalarioMinimoPortugalHoraExperience.astro';

const canonical = 'https://hacecuentas.com/pt-pt/calculadora-salario-minimo-portugal-hora';
const title = 'Calculadora do salário mínimo por hora em Portugal 2026';
const description = 'Calcule quanto vale uma hora do salário mínimo em Portugal por região, horário semanal, mês e ano, incluindo os 14 pagamentos.';
const faq = [
  ['Qual é o salário mínimo em Portugal em 2026?', 'No continente, a Retribuição Mínima Mensal Garantida é de 920 euros por mês em 2026.'],
  ['Quanto vale o salário mínimo por hora?', 'Com 920 euros mensais e 40 horas por semana, o valor equivalente é de aproximadamente 5,31 euros por hora.'],
  ['Como é calculado o valor por hora?', 'Multiplicam-se as horas semanais por 52 e divide-se por 12 para obter as horas mensais médias; depois divide-se o salário mensal por esse total.'],
  ['O cálculo inclui os subsídios de férias e de Natal?', 'O total anual inclui 14 pagamentos. O valor normal por hora é calculado sobre a remuneração mensal base, sem somar os subsídios à hora.'],
  ['O salário mínimo é igual nos Açores e na Madeira?', 'Não. Em 2026, a calculadora usa 966 euros nos Açores e 968 euros na Madeira.'],
  ['Posso calcular um horário parcial?', 'Sim. Altere as horas semanais para ver a equivalência horária de um horário diferente.'],
  ['O resultado é o valor líquido?', 'Não. O resultado é bruto e não desconta Segurança Social, IRS ou outros descontos aplicáveis.'],
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type':'WebApplication', name:title, url:canonical, applicationCategory:'FinanceApplication', operatingSystem:'Web' },
    { '@type':'FAQPage', mainEntity:faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } })) },
    { '@type':'BreadcrumbList', itemListElement:[
      { '@type':'ListItem', position:1, name:'Início', item:'https://hacecuentas.com/pt-pt' },
      { '@type':'ListItem', position:2, name:'Trabalho', item:'https://hacecuentas.com/pt-pt/trabalho' },
      { '@type':'ListItem', position:3, name:'Salário mínimo por hora', item:canonical },
    ]},
  ],
};
---
<Layout title={title} description={description} canonical={canonical} schema={schema} audience="PT" lang="pt" ogType="article" articleSection="Trabalho">
  <Header />
  <SalarioMinimoPortugalHoraExperience />
  <Footer />
</Layout>
