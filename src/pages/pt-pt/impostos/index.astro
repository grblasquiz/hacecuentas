---
/**
 * Silo Impostos · Portugal — índice dos hubs de decisão do mercado PT.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';

const HREF = '/pt-pt/impostos';
const SILO = 'Impostos';
const LEDE =
  'IRS, reembolso, mais-valias, recibos verdes, IMI, AIMI, IMT, Imposto do Selo, IUC e ISV: o que a Autoridade Tributária cobra a quem trabalha, tem casa ou tem carro em Portugal.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${SILO} em Portugal`,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title="Impostos em Portugal — IRS, IMI, IMT e IUC | Hacé Cuentas"
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="PT"
  lang="pt"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
