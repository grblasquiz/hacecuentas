---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

const calcModules = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
const allCalcs = Object.values(calcModules).map((m: any) => m.default || m);
const bySlug = new Map(allCalcs.map((c: any) => [c.slug, c]));

// Curated top 20 calcs para emprendedores AR
const slugs = [
  'calculadora-monotributo-2026',
  'calculadora-cuota-prestamo',
  'sueldo-en-mano-argentina',
  'calculadora-iva-incluido-neto-discriminar',
  'calculadora-impuesto-ganancias-sueldo',
  'calculadora-aguinaldo-sac',
  'calculadora-indemnizacion-despido',
  'calculadora-prestamo-personal-cuota-mensual',
  'calculadora-cft-prestamo-personal-comparativa',
  'calculadora-bienes-personales-2026',
  'calculadora-dolar-blue-vs-oficial-brecha',
  'calculadora-tarifa-freelance-dolar-experiencia-hora',
  'calculadora-cac-costo-adquisicion-sales-funnel',
  'calculadora-costo-hora-desarrollador-senior',
  'calculadora-roi-inversion',
  'calculadora-valor-empresa-multiplo-ebitda',
  'calculadora-fire-retiro-temprano',
  'calculadora-inflacion-poder-compra',
  'calculadora-ingresos-brutos-cm-3-jurisdicciones',
  'calculadora-payback-periodo-recupero-inversion',
];

const items = slugs.map((s) => bySlug.get(s)).filter(Boolean);

const title = 'Top 20 calculadoras para emprendedores Argentina 2026 | Hacé Cuentas';
const description =
  'Las 20 calculadoras esenciales para emprendedores AR 2026: monotributo, sueldos, créditos, IVA, IIBB, dólar, ROI, valuación. Gratis online.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  description,
  numberOfItems: items.length,
  itemListElement: items.map((c: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://hacecuentas.com/${c.slug}`,
    name: c.h1,
  })),
};
---

<Layout title={title} description={description} canonical="/top/emprendedores-argentina" audience="AR" schema={itemListSchema}>
  <Header />
  <main class="article-main">
    <article class="hub-page">
      <header>
        <h1>Top 20 calculadoras para emprendedores en Argentina 2026</h1>
        <p class="lede">
          Si emprendés en Argentina, estas son las 20 calculadoras que más vas a usar:
          monotributo, sueldos, créditos, impuestos, dólar y métricas de negocio.
          Todas gratuitas, sin registro, actualizadas a 2026.
        </p>
      </header>

      <ol class="hub-list">
        {items.map((c: any, idx: number) => (
          <li class="hub-item">
            <span class="hub-num">{idx + 1}.</span>
            <div>
              <a href={`/${c.slug}`}><strong>{c.h1}</strong></a>
              <p>{c.description}</p>
            </div>
          </li>
        ))}
      </ol>

      <aside class="hub-footer">
        <h2>¿Buscás algo más específico?</h2>
        <p>
          Mirá nuestros índices por categoría:
          <a href="/categoria/finanzas">Finanzas</a> ·
          <a href="/categoria/negocios">Negocios</a> ·
          <a href="/categoria/impuestos">Impuestos</a> ·
          <a href="/categoria/marketing">Marketing</a>.
        </p>
        <p>O accedé a nuestro <a href="/datasets">catálogo de datasets públicos</a> (CSV + JSON).</p>
      </aside>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .hub-page { max-width: 860px; margin: 0 auto; padding: 1rem; }
  .lede { font-size: 1.1rem; color: var(--text-2, #444); }
  .hub-list { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 1rem; }
  .hub-item { display: flex; gap: 0.75rem; padding: 0.75rem; border: 1px solid var(--border, #ddd); border-radius: 0.5rem; }
  .hub-num { font-weight: 700; color: var(--accent, #2c5cdc); min-width: 2rem; }
  .hub-item p { margin: 0.25rem 0 0; color: var(--text-2, #666); font-size: 0.95rem; }
  .hub-footer { margin-top: 2rem; padding: 1rem; background: var(--bg-soft, #f4f6f9); border-radius: 0.5rem; }
</style>
