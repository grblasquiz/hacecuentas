---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

const calcModules = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
const allCalcs = Object.values(calcModules).map((m: any) => m.default || m);
const bySlug = new Map(allCalcs.map((c: any) => [c.slug, c]));

const slugs = [
  'simulador-jubilacion-anses',
  'calculadora-jubilacion-minima-anses',
  'calculadora-edad-jubilacion-anos-aporte',
  'calculadora-aguinaldo-sac',
  'calculadora-indemnizacion-despido',
  'calculadora-monotributo-2026',
  'calculadora-impuesto-ganancias-sueldo',
  'calculadora-retencion-ganancias-rg-830',
  'sueldo-en-mano-argentina',
  'calculadora-iva-incluido-neto-discriminar',
  'calculadora-bienes-personales-2026',
  'calculadora-asignacion-universal-hijo-auh',
  'calculadora-asignacion-familiar-hijo-anses-tramo',
  'calculadora-ingresos-brutos-cm-3-jurisdicciones',
  'calculadora-ripte-actualizacion-jubilatoria-sueldo',
  'calculadora-vacaciones-dias-ley',
  'calculadora-licencia-maternidad-paternidad-pais',
  'calculadora-horas-extra',
  'calculadora-dias-vacaciones-ley',
  'calculadora-anses-complemento-leche-maternidad',
  'calculadora-asignacion-discapacidad-pensionado',
  'calculadora-auh-asignacion-universal-hijo-monto-2026',
  'calculadora-licencia-paga-sin-goce-empleado',
  'calculadora-preaviso-despido-meses-antiguedad',
  'calculadora-paritaria-uocra-construccion-2026-categoria',
];

const items = slugs.map((s) => bySlug.get(s)).filter(Boolean);

const title = 'Top 25 calculadoras ANSES y AFIP/ARCA 2026 | Hacé Cuentas';
const description =
  '25 calculadoras esenciales para trámites con ANSES y AFIP/ARCA en Argentina 2026: jubilación, monotributo, ganancias, AUH, asignaciones, indemnización, IVA, IIBB.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  description,
  numberOfItems: items.length,
  itemListElement: items.map((c: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://hacecuentas.com/${c.slug}`,
    name: c.h1,
  })),
};
---

<Layout title={title} description={description} canonical="/top/anses-afip-argentina" audience="AR" schema={itemListSchema}>
  <Header />
  <main class="article-main">
    <article class="hub-page">
      <header>
        <h1>Top 25 calculadoras de ANSES y AFIP/ARCA — Argentina 2026</h1>
        <p class="lede">
          Las calculadoras que más se usan para trámites previsionales (ANSES) y
          fiscales (AFIP/ARCA): jubilación, monotributo, ganancias, asignaciones,
          AUH, indemnización, vacaciones, IIBB. Gratis y actualizadas a 2026.
        </p>
      </header>

      <ol class="hub-list">
        {items.map((c: any, idx: number) => (
          <li class="hub-item">
            <span class="hub-num">{idx + 1}.</span>
            <div>
              <a href={`/${c.slug}`}><strong>{c.h1}</strong></a>
              <p>{c.description}</p>
            </div>
          </li>
        ))}
      </ol>

      <aside class="hub-footer">
        <h2>Recursos relacionados</h2>
        <p>
          <a href="/calculadora-jubilacion-minima-anses">Jubilación mínima ANSES</a> ·
          <a href="/calculadora-monotributo-2026">Categorías del monotributo</a> ·
          <a href="/calculadora-edad-jubilacion-anos-aporte">Edad y años de aporte para jubilarte</a> ·
          <a href="/calculadora-impuesto-ganancias-sueldo">Impuesto a las ganancias sobre el sueldo</a>.
        </p>
      </aside>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .hub-page { max-width: 860px; margin: 0 auto; padding: 1rem; }
  .lede { font-size: 1.1rem; color: var(--text-2, #444); }
  .hub-list { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 1rem; }
  .hub-item { display: flex; gap: 0.75rem; padding: 0.75rem; border: 1px solid var(--border, #ddd); border-radius: 0.5rem; }
  .hub-num { font-weight: 700; color: var(--accent, #2c5cdc); min-width: 2rem; }
  .hub-item p { margin: 0.25rem 0 0; color: var(--text-2, #666); font-size: 0.95rem; }
  .hub-footer { margin-top: 2rem; padding: 1rem; background: var(--bg-soft, #f4f6f9); border-radius: 0.5rem; }
</style>
