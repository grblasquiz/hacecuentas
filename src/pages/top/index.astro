---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

const hubs = [
  {
    slug: 'emprendedores-argentina',
    title: 'Top 20 para emprendedores Argentina 2026',
    description: 'Monotributo, sueldos, créditos, IVA, IIBB, dólar, ROI, valuación.',
  },
  {
    slug: 'anses-afip-argentina',
    title: 'Top 25 ANSES + AFIP/ARCA 2026',
    description: 'Jubilación, asignaciones, ganancias, AUH, indemnización, vacaciones.',
  },
  {
    slug: 'freelancers-2026',
    title: 'Top calculadoras para freelancers Argentina 2026',
    description: 'Tarifa por hora, monotributo, dólar MEP, Deel vs Payoneer.',
  },
];

const title = 'Listados Top de Calculadoras — Hacé Cuentas';
const description =
  'Listados curados de las calculadoras más útiles según perfil: emprendedores, freelancers, ANSES/AFIP. Para que encuentres lo que necesitás más rápido.';
---

<Layout title={title} description={description} canonical="/top" audience="AR">
  <Header />
  <main class="article-main">
    <article class="hub-page">
      <header>
        <h1>Top Listados — Calculadoras curadas por perfil</h1>
        <p class="lede">Listados curados de calculadoras para perfiles específicos.</p>
      </header>

      <ul class="hub-list">
        {hubs.map((h) => (
          <li class="hub-item">
            <a href={`/top/${h.slug}`}><strong>{h.title}</strong></a>
            <p>{h.description}</p>
          </li>
        ))}
      </ul>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .hub-page { max-width: 760px; margin: 0 auto; padding: 1rem; }
  .lede { font-size: 1.1rem; color: var(--text-2, #444); }
  .hub-list { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 1rem; }
  .hub-item { padding: 1rem; border: 1px solid var(--border, #ddd); border-radius: 0.5rem; }
  .hub-item p { margin: 0.25rem 0 0; color: var(--text-2, #666); font-size: 0.95rem; }
</style>
