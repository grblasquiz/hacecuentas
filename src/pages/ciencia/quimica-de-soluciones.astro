---
/**
 * Hub de decisión — "¿Qué concentración tiene mi solución?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 5 casos (moles / molaridad / dilución / molalidad / titulación).
 * La página sólo aporta datos (src/lib/hubs/quimica-de-soluciones.ts) y compute().
 * NADA acá es plata: cada fila declara format 'unit' con su unidad propia.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, CONST, SCALE } from '../../lib/hubs/quimica-de-soluciones';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const BANDS = hub.chart.bands ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ C: CONST, SCALE, BANDS }}>
  (function () {
    const H = window.HC_HUB;

    // Nada de este hub es plata. El runtime hace Object.assign y una fila sin
    // `format` propio caería a pesos con "$": se declara en TODAS.
    const G = { format: 'unit', unit: 'g', decimals: 4 };
    const GMOL = { format: 'unit', unit: 'g/mol', decimals: 4 };
    const MOL = { format: 'unit', unit: 'mol', decimals: 6 };
    const MMOL = { format: 'unit', unit: 'mmol', decimals: 4 };
    const MOLAR = { format: 'unit', unit: 'mol/L', decimals: 6 };
    const MOLAL = { format: 'unit', unit: 'mol/kg', decimals: 6 };
    const NORM = { format: 'unit', unit: 'N', decimals: 6 };
    const L = { format: 'unit', unit: 'L', decimals: 5 };
    const ML = { format: 'unit', unit: 'mL', decimals: 3 };
    const GL = { format: 'unit', unit: 'g/L', decimals: 4 };
    const PPM = { format: 'unit', unit: 'ppm', decimals: 1 };
    const PCT = { format: 'unit', unit: '%', decimals: 4 };
    const KG = { format: 'unit', unit: 'kg', decimals: 4 };
    const CEL = { format: 'unit', unit: '°C', decimals: 3 };
    const VECES = { format: 'unit', unit: '×', decimals: 3 };
    const PART = { format: 'unit', unit: 'partículas', decimals: 0 };

    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    /** Formato humano con decimales adaptativos (para los textos, no las filas). */
    function fmt(n, d) {
      if (!isFinite(n)) return '—';
      if (d == null) {
        const abs = Math.abs(n);
        if (abs === 0) d = 0;
        else if (abs < 0.0001) d = 8;
        else if (abs < 0.01) d = 6;
        else if (abs < 1) d = 5;
        else if (abs < 1000) d = 4;
        else d = 2;
      }
      return Number(n).toLocaleString('es-AR', { minimumFractionDigits: 0, maximumFractionDigits: d });
    }

    /** Notación científica legible en castellano. */
    function sci(n, d) {
      if (!isFinite(n) || n === 0) return '0';
      const e = Math.floor(Math.log10(Math.abs(n)));
      const m = n / Math.pow(10, e);
      return fmt(m, d == null ? 4 : d) + ' × 10^' + e;
    }

    /** Posición 0-100 sobre la regla logarítmica de molaridad (1 µM → 10 M). */
    function posM(m) {
      if (!(m > 0)) return 0;
      const lo = Math.log10(SCALE.minM), hi = Math.log10(SCALE.maxM);
      return Math.max(0, Math.min(100, ((Math.log10(m) - lo) / (hi - lo)) * 100));
    }

    /** Franjas del gráfico: DÉCADAS logarítmicas, no mol/L crudos. */
    function bandas() {
      return BANDS.map(function (b) {
        return {
          label: b.label,
          value: Math.log10(b.to) - Math.log10(b.from),
          tone: b.tone === 'good' ? 'good' : b.tone === 'bad' ? 'bad' : b.tone === 'warn' ? 'warn' : 'main',
        };
      });
    }

    /** Referencia reconocible más cercana, en escala logarítmica. */
    function referencia(m) {
      if (!(m > 0)) return '';
      let ref = SCALE.refs[0];
      SCALE.refs.forEach(function (r) {
        if (Math.abs(Math.log10(r.m) - Math.log10(m)) < Math.abs(Math.log10(ref.m) - Math.log10(m))) ref = r;
      });
      const veces = m / ref.m;
      if (Math.abs(veces - 1) < 0.05) return 'prácticamente ' + ref.label;
      return veces >= 1
        ? fmt(veces, 2) + ' veces ' + ref.label
        : 'un ' + fmt(veces * 100, 1) + '% de ' + ref.label;
    }

    /** Lectura cualitativa de la concentración (mismos cortes que la calc vieja). */
    function categoria(m) {
      return m < 0.1 ? 'diluida' : m <= 1 ? 'moderada' : 'concentrada';
    }

    /** Masa molar sumando los pares (masa atómica × cantidad) cargados. */
    function masaMolarDe(v) {
      const pares = [
        [Number(v.ma1) || 0, Number(v.n1) || 0],
        [Number(v.ma2) || 0, Number(v.n2) || 0],
        [Number(v.ma3) || 0, Number(v.n3) || 0],
        [Number(v.ma4) || 0, Number(v.n4) || 0],
      ].filter(function (p) { return p[0] > 0 && p[1] > 0; });
      let total = 0;
      pares.forEach(function (p) { total += p[0] * p[1]; });
      return { pares: pares, total: total };
    }

    /** La masa molar que usa el resto del hub: la explícita, o la de la rama 1. */
    function masaMolarEfectiva(v) {
      const dato = Number(v.masaMolar) || 0;
      if (dato > 0) return dato;
      return masaMolarDe(v).total;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'moles';

      // ── Rama 1: masa molar y conversión mol ↔ gramo ──────────────────────
      if (id === 'moles') {
        const mm = masaMolarDe(v);
        const M = mm.total;
        if (!(M > 0)) {
          return {
            total: '—',
            sub: 'Cargá al menos un elemento con su masa atómica y su cantidad de átomos mayores a cero.',
            rows: [],
            chart: [],
          };
        }
        const masa = Number(v.masa) || 0;
        const molesDato = Number(v.moles) || 0;
        let moles, masaFinal, partio;
        if (masa > 0) { moles = masa / M; masaFinal = masa; partio = 'de la masa'; }
        else if (molesDato > 0) { moles = molesDato; masaFinal = molesDato * M; partio = 'de los moles'; }
        else { moles = 1; masaFinal = M; partio = 'de un mol de referencia'; }
        const particulas = moles * C.NA;

        const rows = [row('Masa molar del compuesto', M, GMOL, true, 'Σ(masa atómica × átomos)')];
        mm.pares.forEach(function (p, idx) {
          rows.push(
            row(
              'Aporte del elemento ' + (idx + 1) + ' (' + fmt(p[1], 0) + ' × ' + fmt(p[0], 4) + ')',
              p[0] * p[1],
              GMOL,
              false,
              fmt(((p[0] * p[1]) / M) * 100, 2) + '% del peso'
            )
          );
        });
        rows.push(row('Masa considerada', masaFinal, G, masa > 0));
        rows.push(row('Moles que representa', moles, MOL, true, 'n = m / M'));
        rows.push(row('Milimoles', moles * 1000, MMOL));
        rows.push(row('Partículas (N_A exacto)', particulas, PART, false, 'N_A = 6,02214076 × 10²³'));
        rows.push(row('Moles que hay en 100 g', 100 / M, MOL));
        rows.push(row('Gramos que pesa 1 mol', M, G));

        return {
          total: fmt(M, 4) + ' g/mol',
          sub:
            'Masa molar ' + fmt(M, 4) + ' g/mol · partiendo ' + partio + ': ' + fmt(masaFinal, 4) +
            ' g = ' + fmt(moles, 6) + ' mol = ' + sci(particulas, 4) + ' partículas',
          rows: rows,
          chart: bandas(),
          format: 'unit',
          unit: 'década',
          decimals: 2,
          position: 0,
          positionLabel:
            fmt(M, 4) + ' g/mol — la regla de abajo es de concentración; esta rama todavía no define una solución',
        };
      }

      // ── Rama 2: molaridad ────────────────────────────────────────────────
      if (id === 'molaridad') {
        const M = masaMolarEfectiva(v);
        const vol = Number(v.volumenL) || 0;
        const molarDato = Number(v.molaridadDato) || 0;
        const masa = Number(v.masa) || 0;
        const molesDato = Number(v.moles) || 0;

        // Moles disponibles: explícitos, o desde la masa y la masa molar.
        let moles = molesDato > 0 ? molesDato : masa > 0 && M > 0 ? masa / M : 0;
        let molar, despeje;
        if (molarDato > 0 && vol > 0 && moles <= 0) {
          molar = molarDato; moles = molar * vol; despeje = 'los moles';
        } else if (molarDato > 0 && moles > 0 && !(vol > 0)) {
          molar = molarDato; despeje = 'el volumen';
        } else if (moles > 0 && vol > 0) {
          molar = moles / vol; despeje = 'la molaridad';
        } else {
          return {
            total: '—',
            sub: 'Hacen falta dos de los tres: moles (o masa + masa molar), volumen de solución y molaridad.',
            rows: [],
            chart: [],
          };
        }
        const volFinal = despeje === 'el volumen' ? moles / molar : vol;
        const gramos = M > 0 ? moles * M : 0;
        const gl = volFinal > 0 ? gramos / volFinal : 0;

        const rows = [
          row('Molaridad de la solución', molar, MOLAR, true, 'M = n / V'),
          row('Moles de soluto', moles, MOL, despeje === 'los moles'),
          row('Volumen de solución', volFinal, L, despeje === 'el volumen'),
          row('Volumen en mililitros', volFinal * 1000, ML),
          row('Milimoles de soluto', moles * 1000, MMOL),
        ];
        if (M > 0) {
          rows.push(row('Masa molar usada', M, GMOL));
          rows.push(row('Gramos de soluto a pesar', gramos, G, true, 'm = n × M'));
          rows.push(row('Concentración en g/L', gl, GL));
          rows.push(row('Porcentaje masa-volumen', gl / 10, PCT, false, '1% p/v = 10 g/L'));
          rows.push(row('En partes por millón', gl * 1000, PPM));
        }
        rows.push(row('Partículas de soluto', moles * C.NA, PART));

        const comp = referencia(molar);
        return {
          total: fmt(molar, 5) + ' mol/L',
          sub:
            'Despejaste ' + despeje + ': ' + fmt(moles, 5) + ' mol en ' + fmt(volFinal, 4) + ' L dan ' +
            fmt(molar, 5) + ' M, una solución ' + categoria(molar) +
            (M > 0 ? ' · hay que pesar ' + fmt(gramos, 4) + ' g' : '') + (comp ? ' · ' + comp : ''),
          rows: rows,
          chart: bandas(),
          format: 'unit',
          unit: 'década',
          decimals: 2,
          position: Number(posM(molar).toFixed(1)),
          positionLabel: fmt(molar, 4) + ' mol/L — solución ' + categoria(molar) + (comp ? ', ' + comp : ''),
        };
      }

      // ── Rama 3: dilución C1V1 = C2V2 ─────────────────────────────────────
      if (id === 'dilucion') {
        const c1 = Number(v.c1) || 0;
        const c2 = Number(v.c2) || 0;
        const v2 = Number(v.v2) || 0;
        if (!(c1 > 0) || !(c2 > 0) || !(v2 > 0)) {
          return { total: '—', sub: 'Completá la concentración de la madre, la final y el volumen final.', rows: [], chart: [] };
        }
        if (c2 > c1) {
          return {
            total: '—',
            sub:
              'La concentración final (' + fmt(c2) + ') no puede ser mayor que la de la solución madre (' + fmt(c1) +
              '): diluir sólo baja la concentración. Para subirla hay que evaporar solvente o agregar más soluto.',
            rows: [],
            chart: [],
          };
        }
        const v1 = (c2 * v2) / c1;
        const solvente = v2 - v1;
        const factor = c1 / c2;
        const chico = v1 < 1;

        const rows = [
          row('Solución madre a medir', v1, ML, true, 'V1 = C2·V2 / C1'),
          row('Solvente a agregar hasta el aforo', solvente, ML, true),
          row('Volumen final', v2, ML),
          row('Factor de dilución', factor, VECES, false, 'se rotula 1:' + fmt(factor, 1)),
          row('Concentración de la madre', c1, { format: 'plain', decimals: 5 }),
          row('Concentración final', c2, { format: 'plain', decimals: 5 }),
          row('Porcentaje del volumen final que es stock', (v1 / v2) * 100, PCT),
          row('Si hicieras dos pasos iguales, cada uno sería', Math.sqrt(factor), VECES, false, 'dilución seriada'),
        ];

        const comp = referencia(c2);
        return {
          total: fmt(v1, 2) + ' mL de la madre',
          sub:
            'Tomá ' + fmt(v1, 2) + ' mL de la solución madre y completá hasta ' + fmt(v2, 2) + ' mL con solvente (' +
            fmt(solvente, 2) + ' mL) · dilución 1:' + fmt(factor, 1) +
            (chico
              ? ' · ojo: medir menos de 1 mL con probeta no es confiable, hacelo en dos pasos o con micropipeta'
              : ' · usá pipeta aforada y completá hasta la marca, no sumes el solvente a ojo'),
          rows: rows,
          chart: bandas(),
          format: 'unit',
          unit: 'década',
          decimals: 2,
          position: Number(posM(c2).toFixed(1)),
          positionLabel:
            'Concentración final ' + fmt(c2, 5) + (comp ? ' — leída como mol/L, ' + comp : ''),
        };
      }

      // ── Rama 4: molalidad y porcentaje ───────────────────────────────────
      if (id === 'molalidad') {
        const M = masaMolarEfectiva(v);
        const masa = Number(v.masa) || 0;
        const kg = Number(v.kgSolvente) || 0;
        const iVH = Math.max(1, Number(v.ipartic) || 1);
        if (!(M > 0) || !(masa > 0) || !(kg > 0)) {
          return {
            total: '—',
            sub: 'Hacen falta la masa de soluto, su masa molar y los kilos de solvente, todos mayores a cero.',
            rows: [],
            chart: [],
          };
        }
        const moles = masa / M;
        const molalidad = moles / kg;
        const masaTotal = masa + kg * 1000;      // g de solución
        const pct = (masa / masaTotal) * 100;    // % p/p con la masa total
        const gl = pct * 10;                     // leído como p/v
        const ppm = pct * 10000;
        const crio = C.KF_AGUA * molalidad * iVH;
        const ebu = C.KB_AGUA * molalidad * iVH;

        const rows = [
          row('Molalidad', molalidad, MOLAL, true, 'm = n / kg de SOLVENTE'),
          row('Moles de soluto', moles, MOL),
          row('Masa de soluto', masa, G),
          row('Masa molar usada', M, GMOL),
          row('Solvente', kg, KG),
          row('Masa total de la solución', masaTotal, G),
          row('Porcentaje de soluto', pct, PCT, true, 'denominador: la solución entera'),
          row('Leído como p/v, en g/L', gl, GL),
          row('En partes por millón', ppm, PPM),
          row('Partículas por fórmula (van’t Hoff)', iVH, { format: 'plain', decimals: 0 }),
          row('Congela a', -crio, CEL, true, 'Kf agua = 1,86 °C·kg/mol'),
          row('Hierve a', 100 + ebu, CEL, false, 'Kb agua = 0,512 °C·kg/mol'),
        ];

        const comp = referencia(molalidad);
        return {
          total: fmt(molalidad, 4) + ' mol/kg',
          sub:
            fmt(moles, 4) + ' mol de soluto en ' + fmt(kg, 4) + ' kg de solvente dan ' + fmt(molalidad, 4) +
            ' molal (' + fmt(pct, 3) + '% en masa, ' + fmt(gl, 1) + ' g/L) · en agua congelaría a ' +
            fmt(-crio, 2) + ' °C y herviría a ' + fmt(100 + ebu, 2) + ' °C' +
            (molalidad >= 1
              ? ' · por encima de 1 mol/kg molalidad y molaridad ya difieren de forma notoria'
              : ' · a esta dilución, en agua, molalidad y molaridad son casi iguales'),
          rows: rows,
          chart: bandas(),
          format: 'unit',
          unit: 'década',
          decimals: 2,
          position: Number(posM(molalidad).toFixed(1)),
          positionLabel:
            fmt(molalidad, 4) + ' mol/kg — en agua diluida equivale casi a la misma molaridad' + (comp ? ', ' + comp : ''),
        };
      }

      // ── Rama 5: titulación ácido-base ────────────────────────────────────
      const ct = Number(v.ct) || 0;
      const vt = Number(v.vt) || 0;
      const nt = Math.max(1, Number(v.nt) || 1);
      const va = Number(v.va) || 0;
      const na = Math.max(1, Number(v.na) || 1);
      if (!(ct > 0) || !(vt > 0) || !(va > 0)) {
        return {
          total: '—',
          sub: 'Completá la concentración y el volumen del titulante y el volumen de la alícuota, todos mayores a cero.',
          rows: [],
          chart: [],
        };
      }
      const conc = (ct * vt * nt) / (va * na);
      const normalidad = conc * na;
      const mmol = conc * va;                 // mmol de analito en la alícuota
      const eqTit = ct * vt * nt;             // meq de titulante gastados
      const Mm = masaMolarEfectiva(v);

      const rows = [
        row('Concentración de la muestra', conc, MOLAR, true, 'C = Ct·Vt·nt / (Va·na)'),
        row('Normalidad de la muestra', normalidad, NORM, false, 'N = M × n'),
        row('Analito en la alícuota', mmol, MMOL, true),
        row('Analito en moles', mmol / 1000, MOL),
        row('Miliequivalentes de titulante gastados', eqTit, { format: 'unit', unit: 'meq', decimals: 4 }),
        row('Titulante gastado', vt, ML),
        row('Alícuota de muestra', va, ML),
        row('Factor n del titulante', nt, { format: 'plain', decimals: 0 }),
        row('Factor n de la muestra', na, { format: 'plain', decimals: 0 }),
        row('Concentración del titulante', ct, MOLAR),
      ];
      if (Mm > 0) {
        rows.push(row('Gramos de analito en la alícuota', (mmol / 1000) * Mm, G, false, 'con la masa molar cargada'));
        rows.push(row('Analito por litro de muestra', conc * Mm, GL));
      }

      const comp = referencia(conc);
      const poliprotico = nt > 1 || na > 1;
      return {
        total: fmt(conc, 5) + ' mol/L',
        sub:
          'Los equivalentes se igualan a los ' + fmt(vt, 2) + ' mL de titulante: la muestra es ' + fmt(conc, 5) +
          ' M (' + fmt(normalidad, 5) + ' N), o sea ' + fmt(mmol, 4) + ' mmol en la alícuota de ' + fmt(va, 2) + ' mL' +
          (poliprotico
            ? ' · los factores n (' + nt + ' y ' + na + ') están pesando de verdad acá'
            : ' · las dos especies son monopróticas, así que molaridad y normalidad coinciden') +
          (comp ? ' · ' + comp : ''),
        rows: rows,
        chart: bandas(),
        format: 'unit',
        unit: 'década',
        decimals: 2,
        position: Number(posM(conc).toFixed(1)),
        positionLabel: fmt(conc, 5) + ' mol/L — solución ' + categoria(conc) + (comp ? ', ' + comp : ''),
      };
    });
  })();
</script>
