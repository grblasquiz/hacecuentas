---
/**
 * Hub de decisión — "¿Cuánto pesaría, cuánto tardaría, cuán lejos está?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 5 casos (peso / escape / órbita / distancias / viaje).
 * La página sólo aporta datos (src/lib/hubs/planetas-y-viaje-espacial.ts) y compute().
 * NADA acá es plata: cada fila declara su `format` propio.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PlanetasViajeExperience from '../../components/generated/PlanetasViajeExperience.astro';
import { hub, CONST, CUERPOS, SCALE, HITOS_LY } from '../../lib/hubs/planetas-y-viaje-espacial';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const BANDS = hub.chart.bands ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PlanetasViajeExperience data={hub} />
  <Footer />
</Layout>

