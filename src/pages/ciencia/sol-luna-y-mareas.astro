---
/**
 * Hub de decisión — "¿A qué hora amanece, qué fase lunar hay y cuándo sube la marea?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (hoy / luna / retraso / mareas).
 * La página sólo aporta datos (src/lib/hubs/sol-luna-y-mareas.ts) y compute().
 *
 * TODO se resuelve para HOY: los campos de fecha y hora arrancan vacíos y
 * compute() los reemplaza por `new Date()`. NADA acá es plata: cada fila
 * declara su `format` propio.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SolLunaMareasExperience from '../../components/generated/SolLunaMareasExperience.astro';
import { hub, CONST, CIUDADES, PUERTOS } from '../../lib/hubs/sol-luna-y-mareas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const BANDS = hub.chart.bands ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SolLunaMareasExperience data={hub} />
  <Footer />
</Layout>

