---
/**
 * Hub de decisión — "¿A qué hora amanece, qué fase lunar hay y cuándo sube la marea?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (hoy / luna / retraso / mareas).
 * La página sólo aporta datos (src/lib/hubs/sol-luna-y-mareas.ts) y compute().
 *
 * TODO se resuelve para HOY: los campos de fecha y hora arrancan vacíos y
 * compute() los reemplaza por `new Date()`. NADA acá es plata: cada fila
 * declara su `format` propio.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, CONST, CIUDADES, PUERTOS } from '../../lib/hubs/sol-luna-y-mareas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const BANDS = hub.chart.bands ?? [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ K: CONST, CIUDADES, PUERTOS, BANDS }}>
  (function () {
    const H = window.HC_HUB;

    // Nada de este hub es plata: todas las filas declaran su formato.
    const HORAS = { format: 'unit', unit: 'h', decimals: 3 };
    const MIN = { format: 'unit', unit: 'min', decimals: 1 };
    const MIN2 = { format: 'unit', unit: 'min/día', decimals: 2 };
    const GRADOS = { format: 'unit', unit: '°', decimals: 3 };
    const DIAS = { format: 'unit', unit: 'días', decimals: 2 };
    const PCT = { format: 'unit', unit: '%', decimals: 1 };
    const METROS = { format: 'unit', unit: 'm', decimals: 2 };
    const RELOJ = { format: 'unit', unit: 'h (decimal)', decimals: 3 };

    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    const RAD = Math.PI / 180;

    function fmt(n, d) {
      if (!isFinite(n)) return '—';
      return Number(n).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });
    }

    /** Minutos del día → "HH:MM" (envuelve en 24 h). */
    function hhmm(min) {
      if (!isFinite(min)) return '—';
      let m = ((min % 1440) + 1440) % 1440;
      const h = Math.floor(m / 60);
      const mm = Math.round(m - h * 60);
      const h2 = mm === 60 ? (h + 1) % 24 : h;
      const mm2 = mm === 60 ? 0 : mm;
      return String(h2).padStart(2, '0') + ':' + String(mm2).padStart(2, '0');
    }

    /** Duración en horas → "9 h 51 min". */
    function dur(horas) {
      if (!isFinite(horas)) return '—';
      const t = Math.round(horas * 60);
      return Math.floor(t / 60) + ' h ' + String(t % 60).padStart(2, '0') + ' min';
    }

    const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];

    function diaDelAnio(y, m, d) {
      return Math.round((Date.UTC(y, m - 1, d) - Date.UTC(y, 0, 0)) / 86400000);
    }
    function fechaDeN(y, N) {
      const d = new Date(Date.UTC(y, 0, N));
      return d.getUTCDate() + ' de ' + MESES[d.getUTCMonth()];
    }
    function diasDelAnio(y) {
      return diaDelAnio(y, 12, 31);
    }

    /**
     * Algoritmo solar de la NOAA (serie de Spencer). Devuelve todo en minutos
     * UTC desde medianoche, más la declinación y la ecuación del tiempo.
     * `cenit` en grados: 90,833 para orto/ocaso, 96 para crepúsculo civil.
     */
    function solar(y, N, lat, lon, cenit) {
      const dias = diasDelAnio(y);
      const g = ((2 * Math.PI) / dias) * (N - 1 + 0.5);
      const eqtime =
        229.18 *
        (0.000075 +
          0.001868 * Math.cos(g) -
          0.032077 * Math.sin(g) -
          0.014615 * Math.cos(2 * g) -
          0.040849 * Math.sin(2 * g));
      const decl =
        0.006918 -
        0.399912 * Math.cos(g) +
        0.070257 * Math.sin(g) -
        0.006758 * Math.cos(2 * g) +
        0.000907 * Math.sin(2 * g) -
        0.002697 * Math.cos(3 * g) +
        0.00148 * Math.sin(3 * g);
      const phi = lat * RAD;
      const cosHa = Math.cos(cenit * RAD) / (Math.cos(phi) * Math.cos(decl)) - Math.tan(phi) * Math.tan(decl);
      const noon = 720 - 4 * lon - eqtime;
      let ha = null, polar = null;
      if (cosHa > 1) polar = 'noche';       // el sol no llega nunca a ese cenit
      else if (cosHa < -1) polar = 'dia';   // nunca baja de ese cenit
      else ha = Math.acos(cosHa) / RAD;
      return {
        eqtime: eqtime,
        declGrados: decl / RAD,
        noon: noon,
        ha: ha,
        polar: polar,
        salida: ha == null ? null : noon - 4 * ha,
        puesta: ha == null ? null : noon + 4 * ha,
        luz: ha == null ? (polar === 'dia' ? 24 : 0) : (8 * ha) / 60,
      };
    }

    /** Edad de la Luna en días dentro del ciclo sinódico (fase media). */
    function edadLunar(ms) {
      let e = ((ms - K.REF_LUNA_NUEVA_MS) / 86400000) % K.CICLO_LUNAR;
      if (e < 0) e += K.CICLO_LUNAR;
      return e;
    }
    function proximoEvento(ms, faseDias) {
      let falta = faseDias - edadLunar(ms);
      if (falta <= 0) falta += K.CICLO_LUNAR;
      return { ms: ms + falta * 86400000, dias: falta };
    }
    function fechaUTC(ms) {
      const d = new Date(ms);
      return (
        String(d.getUTCDate()).padStart(2, '0') + '/' + String(d.getUTCMonth() + 1).padStart(2, '0') + '/' +
        d.getUTCFullYear() + ' ' + String(d.getUTCHours()).padStart(2, '0') + ':' +
        String(d.getUTCMinutes()).padStart(2, '0') + ' UTC'
      );
    }
    function nombreFase(edad) {
      if (edad < 1.0 || edad >= 28.5) return 'Luna nueva';
      if (edad < 6.38) return 'Luna creciente';
      if (edad < 8.38) return 'Cuarto creciente';
      if (edad < 13.77) return 'Gibosa creciente';
      if (edad < 15.77) return 'Luna llena';
      if (edad < 21.14) return 'Gibosa menguante';
      if (edad < 23.14) return 'Cuarto menguante';
      return 'Luna menguante';
    }

    /** Lugar elegido, o el personalizado. */
    function lugarDe(v) {
      const k = String(v.ciudad || 'buenos-aires');
      if (k !== 'personalizado' && CIUDADES[k]) return CIUDADES[k];
      return {
        nombre: 'el punto que cargaste',
        lat: Number(v.latitud) || 0,
        lon: Number(v.longitud) || 0,
        huso: isFinite(Number(v.huso)) ? Number(v.huso) : 0,
      };
    }

    /**
     * Momento del cálculo. Fecha y hora vacías = AHORA: ese es el punto del
     * hub. Se interpreta siempre en la hora local del lugar elegido, no en la
     * del navegador.
     */
    function momento(v, lugar) {
      const ahora = new Date();
      const txtF = String(v.fecha || '').trim();
      const txtH = String(v.hora || '').trim();
      let y, m, d, esHoy = false;
      const mf = txtF.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (mf) {
        y = +mf[1]; m = +mf[2]; d = +mf[3];
      } else {
        // Fecha del calendario en la hora local del lugar elegido.
        const loc = new Date(ahora.getTime() + lugar.huso * 3600000);
        y = loc.getUTCFullYear(); m = loc.getUTCMonth() + 1; d = loc.getUTCDate();
        esHoy = true;
      }
      let horaLocal;
      const mh = txtH.match(/^(\d{1,2})[:.\s]?(\d{2})?$/);
      if (mh) horaLocal = Math.min(1439, Math.max(0, +mh[1] * 60 + (+mh[2] || 0)));
      else {
        const loc = new Date(ahora.getTime() + lugar.huso * 3600000);
        horaLocal = loc.getUTCHours() * 60 + loc.getUTCMinutes();
      }
      const ms = Date.UTC(y, m - 1, d, 0, 0, 0) + (horaLocal - lugar.huso * 60) * 60000;
      return {
        y: y, m: m, d: d,
        N: diaDelAnio(y, m, d),
        horaLocal: horaLocal,
        ms: ms,
        esHoy: esHoy && !mh,
        etiqueta: String(d).padStart(2, '0') + '/' + String(m).padStart(2, '0') + '/' + y,
      };
    }

    /** Franjas fijas del gráfico (regla lineal de 0 a 24 h de luz). */
    function bandas() {
      return BANDS.map(function (b) {
        return {
          label: b.label,
          value: b.to - b.from,
          tone: b.tone === 'good' ? 'good' : b.tone === 'bad' ? 'bad' : b.tone === 'warn' ? 'warn' : 'main',
        };
      });
    }
    function posLuz(horas) {
      return Number(Math.max(0, Math.min(100, (horas / 24) * 100)).toFixed(1));
    }
    function etiquetaLuz(horas, lugar) {
      return dur(horas) + ' de luz en ' + lugar.nombre;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'hoy';
      const lugar = lugarDe(v);
      const t = momento(v, lugar);

      if (!(Math.abs(lugar.lat) <= 90) || !(Math.abs(lugar.lon) <= 180)) {
        return { total: '—', sub: 'Cargá una latitud entre −90 y 90 y una longitud entre −180 y 180.', rows: [], chart: [] };
      }

      const S = solar(t.y, t.N, lugar.lat, lugar.lon, K.CENIT_ORTO);
      const CIV = solar(t.y, t.N, lugar.lat, lugar.lon, K.CENIT_CIVIL);
      const off = lugar.huso * 60; // UTC → local
      const cuando = t.esHoy ? 'Hoy' : 'El ' + t.etiqueta;

      // ── Rama 1: amanecer, atardecer y horas de luz de hoy ────────────────
      if (id === 'hoy') {
        const rows = [];
        if (S.polar) {
          rows.push(row('Duración del día', S.luz, HORAS, true, S.polar === 'dia' ? 'sol continuo' : 'el sol no sale'));
        } else {
          rows.push(row('Amanecer (hora local, decimal)', (S.salida + off) / 60, RELOJ, true, hhmm(S.salida + off)));
          rows.push(row('Atardecer (hora local, decimal)', (S.puesta + off) / 60, RELOJ, true, hhmm(S.puesta + off)));
          rows.push(row('Mediodía solar (hora local, decimal)', (S.noon + off) / 60, RELOJ, true, hhmm(S.noon + off)));
          rows.push(row('Horas de luz', S.luz, HORAS, true, dur(S.luz)));
          rows.push(row('Horas de oscuridad', 24 - S.luz, HORAS, false, dur(24 - S.luz)));
          rows.push(row('Duración del día, en minutos', S.luz * 60, MIN));
        }
        if (CIV.salida != null) {
          rows.push(row('Empieza a aclarar (crepúsculo civil)', (CIV.salida + off) / 60, RELOJ, false, hhmm(CIV.salida + off)));
          rows.push(row('Se hace de noche (fin del crepúsculo civil)', (CIV.puesta + off) / 60, RELOJ, false, hhmm(CIV.puesta + off)));
          if (S.salida != null) {
            rows.push(row('Duración del crepúsculo, cada punta', (S.salida - CIV.salida), MIN, false, 'el sol 6° bajo el horizonte'));
          }
        }
        rows.push(row('Declinación solar del día', S.declGrados, GRADOS, false, 'dónde está el sol respecto del ecuador'));
        rows.push(row('Ecuación del tiempo', S.eqtime, MIN, false, 'lo que se adelanta o atrasa el sol frente al reloj'));
        rows.push(row('Corrimiento por longitud', -4 * lugar.lon, MIN, false, '4 minutos por grado al oeste del meridiano de Greenwich'));
        rows.push(row('Día del año', t.N, DIAS, false, 'sobre ' + diasDelAnio(t.y) + ' días'));
        rows.push(row('Latitud usada', lugar.lat, GRADOS));

        if (S.salida != null) {
          const faltaLuz = (S.puesta + off) - t.horaLocal;
          rows.push(
            row(
              faltaLuz >= 0 ? 'Cuánto falta para que se ponga el sol' : 'Hace cuánto se puso el sol',
              Math.abs(faltaLuz),
              MIN,
              true,
              'contado desde las ' + hhmm(t.horaLocal)
            )
          );
        }

        const sub = S.polar
          ? cuando + ' en ' + lugar.nombre + ' hay ' + (S.polar === 'dia' ? 'DÍA POLAR: el sol no se esconde en todo el día' : 'NOCHE POLAR: el sol no llega a asomar') +
            ' · a esta latitud (' + fmt(lugar.lat, 2) + '°) eso pasa cerca de los solsticios'
          : cuando + ' en ' + lugar.nombre + ' el sol sale a las ' + hhmm(S.salida + off) + ' y se pone a las ' +
            hhmm(S.puesta + off) + ': son ' + dur(S.luz) + ' de luz · el mediodía solar cae a las ' +
            hhmm(S.noon + off) + ', no a las 12:00, por la longitud y por la ecuación del tiempo · después del atardecer todavía queda luz útil hasta las ' +
            hhmm(CIV.puesta + off);

        return {
          total: S.polar ? (S.polar === 'dia' ? 'Sol las 24 horas' : 'El sol no sale') : hhmm(S.salida + off) + ' → ' + hhmm(S.puesta + off),
          sub: sub,
          rows: rows,
          chart: bandas(),
          format: 'unit',
          unit: 'h',
          decimals: 1,
          position: posLuz(S.luz),
          positionLabel: etiquetaLuz(S.luz, lugar),
        };
      }

      // ── Rama 2: fase lunar de hoy ────────────────────────────────────────
      if (id === 'luna') {
        const edad = edadLunar(t.ms);
        const frac = edad / K.CICLO_LUNAR;
        const ilum = ((1 - Math.cos(2 * Math.PI * frac)) / 2) * 100;
        const fase = nombreFase(edad);
        const creciendo = edad < K.CICLO_LUNAR / 2;
        const nueva = proximoEvento(t.ms, 0);
        const llena = proximoEvento(t.ms, K.CICLO_LUNAR / 2);
        const cre = proximoEvento(t.ms, K.CICLO_LUNAR / 4);
        const men = proximoEvento(t.ms, (3 * K.CICLO_LUNAR) / 4);

        const rows = [
          row('Disco iluminado', ilum, PCT, true, fase),
          row('Edad de la Luna en el ciclo', edad, DIAS, true, 'ciclo sinódico de ' + fmt(K.CICLO_LUNAR, 2) + ' días'),
          row('Fracción del ciclo recorrida', frac * 100, PCT, false, creciendo ? 'creciendo' : 'menguando'),
          row('Faltan para la próxima luna llena', llena.dias, DIAS, true, fechaUTC(llena.ms)),
          row('Faltan para la próxima luna nueva', nueva.dias, DIAS, true, fechaUTC(nueva.ms)),
          row('Faltan para el próximo cuarto creciente', cre.dias, DIAS, false, fechaUTC(cre.ms)),
          row('Faltan para el próximo cuarto menguante', men.dias, DIAS, false, fechaUTC(men.ms)),
          row('Retraso diario de la salida de la Luna', (2 * K.CICLO_MAREA - 24) * 60, MIN, false, 'promedio: por eso la marea también se corre unos 50 min por día'),
          row('Duración del ciclo sinódico', K.CICLO_LUNAR, DIAS, false, '29 días, 12 h y 44 min'),
          row('Incertidumbre de la fase media', 14, { format: 'unit', unit: 'h', decimals: 0 }, false, 'la órbita lunar es elíptica: la fase real se corre'),
          row('Horas de luz solar de ese mismo día', S.luz, HORAS, false, dur(S.luz) + ' en ' + lugar.nombre),
        ];

        return {
          total: fase + ' — ' + fmt(ilum, 0) + '%',
          sub:
            cuando + ' la Luna está ' + fase.toLowerCase() + ', con el ' + fmt(ilum, 1) +
            '% del disco iluminado y ' + (creciendo ? 'creciendo' : 'menguando') + ' · tiene ' + fmt(edad, 1) +
            ' días de ciclo · la próxima luna llena cae el ' + fechaUTC(llena.ms) + ', en ' + fmt(llena.dias, 1) +
            ' días · acordate de que en el hemisferio sur la creciente se ilumina del lado IZQUIERDO, al revés de las ilustraciones europeas',
          rows: rows,
          chart: bandas(),
          format: 'unit',
          unit: 'h',
          decimals: 1,
          position: posLuz(S.luz),
          positionLabel: etiquetaLuz(S.luz, lugar),
        };
      }

      // ── Rama 3: retraso diario del amanecer y del atardecer ──────────────
      if (id === 'retraso') {
        const dias = diasDelAnio(t.y);
        const may = solar(t.y, t.N + 1 > dias ? 1 : t.N + 1, lugar.lat, lugar.lon, K.CENIT_ORTO);
        if (S.polar || may.polar) {
          return {
            total: '—',
            sub:
              'A ' + fmt(lugar.lat, 2) + '° de latitud, ' + (t.esHoy ? 'hoy' : 'ese día') +
              ' no hay ni amanecer ni atardecer: es ' + (S.polar === 'dia' ? 'día polar' : 'noche polar') +
              ', así que no hay un corrimiento diario que medir. Probá con una fecha más cerca de un equinoccio.',
            rows: [],
            chart: bandas(),
            format: 'unit', unit: 'h', decimals: 1,
            position: posLuz(S.luz), positionLabel: etiquetaLuz(S.luz, lugar),
          };
        }
        // Cada punta del día se calcula por separado: ahí está el fenómeno.
        const dAmanecer = may.salida - S.salida;   // + = sale más tarde
        const dAtardecer = may.puesta - S.puesta;  // + = anochece más tarde
        const dLuz = (may.luz - S.luz) * 60;

        // Barrido del año: el día más corto, el amanecer más tardío y el
        // atardecer más temprano son TRES fechas distintas.
        let nCorto = 1, luzMin = Infinity, nLargo = 1, luzMax = -Infinity;
        let nSalTarde = 1, salMax = -Infinity, nPueTemp = 1, pueMin = Infinity;
        let nSalTemp = 1, salMin = Infinity, nPueTarde = 1, pueMax = -Infinity;
        for (let n = 1; n <= dias; n++) {
          const s = solar(t.y, n, lugar.lat, lugar.lon, K.CENIT_ORTO);
          if (s.luz < luzMin) { luzMin = s.luz; nCorto = n; }
          if (s.luz > luzMax) { luzMax = s.luz; nLargo = n; }
          if (s.salida == null) continue;
          if (s.salida > salMax) { salMax = s.salida; nSalTarde = n; }
          if (s.salida < salMin) { salMin = s.salida; nSalTemp = n; }
          if (s.puesta < pueMin) { pueMin = s.puesta; nPueTemp = n; }
          if (s.puesta > pueMax) { pueMax = s.puesta; nPueTarde = n; }
        }
        const gapSal = nSalTarde - nCorto;
        const gapPue = nPueTemp - nCorto;

        const rows = [
          row('El amanecer se corre', dAmanecer, MIN2, true, dAmanecer >= 0 ? 'sale más tarde cada día' : 'sale más temprano cada día'),
          row('El atardecer se corre', dAtardecer, MIN2, true, dAtardecer >= 0 ? 'anochece más tarde cada día' : 'anochece más temprano cada día'),
          row('El día cambia', dLuz, MIN2, true, dLuz >= 0 ? 'se está alargando' : 'se está acortando'),
          row('Asimetría entre las dos puntas', Math.abs(dAmanecer) - Math.abs(dAtardecer), MIN2, true, 'si fuera cero, el amanecer más tardío caería el día más corto'),
          row('El mediodía solar se corre', ((may.noon - S.noon)), MIN2, false, 'esto es la ecuación del tiempo en acción'),
          row('Día más corto del año', luzMin, HORAS, true, fechaDeN(t.y, nCorto) + ' · ' + dur(luzMin)),
          row('Día más largo del año', luzMax, HORAS, false, fechaDeN(t.y, nLargo) + ' · ' + dur(luzMax)),
          row('Amanecer más tardío del año', (salMax + off) / 60, RELOJ, true, fechaDeN(t.y, nSalTarde) + ' · ' + hhmm(salMax + off)),
          row('Atardecer más temprano del año', (pueMin + off) / 60, RELOJ, true, fechaDeN(t.y, nPueTemp) + ' · ' + hhmm(pueMin + off)),
          row('Amanecer más temprano del año', (salMin + off) / 60, RELOJ, false, fechaDeN(t.y, nSalTemp) + ' · ' + hhmm(salMin + off)),
          row('Atardecer más tardío del año', (pueMax + off) / 60, RELOJ, false, fechaDeN(t.y, nPueTarde) + ' · ' + hhmm(pueMax + off)),
          row('Días entre el día más corto y el amanecer más tardío', gapSal, DIAS, true, gapSal > 0 ? 'el amanecer sigue retrasándose DESPUÉS del solsticio' : 'cae antes del solsticio'),
          row('Días entre el atardecer más temprano y el día más corto', -gapPue, DIAS, true, gapPue < 0 ? 'el atardecer ya se estiraba ANTES del solsticio' : 'cae después'),
          row('Amanecer de hoy (hora local, decimal)', (S.salida + off) / 60, RELOJ, false, hhmm(S.salida + off)),
          row('Atardecer de hoy (hora local, decimal)', (S.puesta + off) / 60, RELOJ, false, hhmm(S.puesta + off)),
        ];

        const ritmo = Math.abs(dLuz) < 0.3 ? 'estás cerca de un solsticio: la duración del día casi no se mueve'
          : Math.abs(dLuz) < 1.2 ? 'estás a mitad de camino entre un solsticio y un equinoccio'
          : 'estás cerca de un equinoccio: es cuando el día cambia más rápido de todo el año';

        return {
          total: (dLuz >= 0 ? '+' : '') + fmt(dLuz, 2) + ' min/día',
          sub:
            cuando + ' en ' + lugar.nombre + ' el día se está ' + (dLuz >= 0 ? 'alargando' : 'acortando') + ' ' +
            fmt(Math.abs(dLuz), 2) + ' min por día: el sol sale ' + fmt(Math.abs(dAmanecer), 2) + ' min ' +
            (dAmanecer >= 0 ? 'más tarde' : 'más temprano') + ' y se pone ' + fmt(Math.abs(dAtardecer), 2) + ' min ' +
            (dAtardecer >= 0 ? 'más tarde' : 'más temprano') +
            (Math.abs(Math.abs(dAmanecer) - Math.abs(dAtardecer)) > 0.05
              ? ' — ojo: NO son la mitad y la mitad, y esa asimetría es todo el asunto'
              : ' — hoy las dos puntas se mueven casi parejo, pero cerca de los solsticios se despegan del todo') +
            ' · ' + ritmo +
            ' · en esta latitud el día más corto cae el ' + fechaDeN(t.y, nCorto) + ', pero el amanecer más tardío es el ' +
            fechaDeN(t.y, nSalTarde) + ' y el atardecer más temprano el ' + fechaDeN(t.y, nPueTemp) + ': tres fechas distintas',
          rows: rows,
          chart: bandas(),
          format: 'unit',
          unit: 'h',
          decimals: 1,
          position: posLuz(S.luz),
          positionLabel: etiquetaLuz(S.luz, lugar),
        };
      }

      // ── Rama 4: mareas ───────────────────────────────────────────────────
      const pk = String(v.puerto || 'mar-del-plata');
      const P = PUERTOS[pk] || PUERTOS['mar-del-plata'];
      const edad = edadLunar(t.ms);
      const dMin = Math.min(edad, Math.abs(edad - K.CICLO_LUNAR / 2), Math.abs(edad - K.CICLO_LUNAR));
      const sicigia = 1 + 0.3 * Math.cos((dMin / (K.CICLO_LUNAR / 4)) * (Math.PI / 2));
      const horasDesdeNueva = (t.ms - K.REF_LUNA_NUEVA_MS) / 3600000;
      const faseMarea = (((horasDesdeNueva - P.offsetHoras) % K.CICLO_MAREA) + K.CICLO_MAREA) % K.CICLO_MAREA;
      const hastaPleamar = (K.CICLO_MAREA - faseMarea) % K.CICLO_MAREA;
      const hastaBajamar = (hastaPleamar + K.CICLO_MAREA / 2) % K.CICLO_MAREA;
      const ampEfectiva = P.amplitud * sicigia;
      const nivelMedio = P.amplitud * 0.5 + 0.5;
      const alturaPlea = nivelMedio + ampEfectiva / 2;
      const alturaBaja = nivelMedio - ampEfectiva / 2;
      const tipo = dMin < 2.5 ? 'Marea viva (sicigia): amplitud máxima, cerca de luna nueva o llena'
        : dMin > 5.5 ? 'Marea muerta (cuadratura): amplitud mínima, cerca de los cuartos'
        : 'Marea intermedia entre viva y muerta';

      const rowsM = [
        row('Faltan para la próxima pleamar', hastaPleamar, { format: 'unit', unit: 'h', decimals: 2 }, true, hhmm(t.horaLocal + hastaPleamar * 60) + ' hora local, ESTIMADO'),
        row('Faltan para la próxima bajamar', hastaBajamar, { format: 'unit', unit: 'h', decimals: 2 }, true, hhmm(t.horaLocal + hastaBajamar * 60) + ' hora local, ESTIMADO'),
        row('Altura estimada de la pleamar', alturaPlea, METROS, true, P.nota),
        row('Altura estimada de la bajamar', alturaBaja, METROS, true),
        row('Cuánto sube y baja el agua', alturaPlea - alturaBaja, METROS, true, 'amplitud de hoy'),
        row('Amplitud típica del puerto', P.amplitud, METROS, false, P.nombre),
        row('Factor de sicigia de hoy', sicigia, { format: 'plain', decimals: 3 }, false, tipo),
        row('Distancia a la luna nueva o llena más cercana', dMin, DIAS, false, '0 = marea viva · 7,4 = marea muerta'),
        row('Edad de la Luna', edad, DIAS, false, 'la marea sigue a la Luna, no al reloj'),
        row('Duración del ciclo de marea', K.CICLO_MAREA, { format: 'unit', unit: 'h', decimals: 4 }, false, '12 h 25 min: componente lunar M2'),
        row('Cuánto se corre la marea cada día', (2 * K.CICLO_MAREA - 24) * 60, MIN, false, 'lo mismo que se retrasa la salida de la Luna'),
        row('Pleamares por día', 24 / K.CICLO_MAREA, { format: 'plain', decimals: 3 }, false, 'régimen semidiurno'),
      ];

      return {
        total: 'Pleamar en ' + fmt(hastaPleamar, 1) + ' h',
        sub:
          '⚠️ ESTIMACIÓN, NO SIRVE PARA NAVEGAR. En ' + P.nombre + ', ' + (t.esHoy ? 'desde ahora' : 'desde las ' + hhmm(t.horaLocal)) +
          ', la próxima pleamar sería en ' + fmt(hastaPleamar, 1) + ' h (~' + fmt(alturaPlea, 2) + ' m) y la bajamar en ' +
          fmt(hastaBajamar, 1) + ' h (~' + fmt(alturaBaja, 2) + ' m): el agua se movería unos ' + fmt(alturaPlea - alturaBaja, 2) +
          ' m · ' + tipo + ' · los horarios salen de un modelo genérico de una sola componente y pueden errar por HORAS: antes de meterte al agua, cruzar un banco o caminar una restinga, mirá la tabla oficial del Servicio de Hidrografía Naval',
        rows: rowsM,
        chart: bandas(),
        format: 'unit',
        unit: 'h',
        decimals: 1,
        position: posLuz(S.luz),
        positionLabel: etiquetaLuz(S.luz, lugar),
      };
    });
  })();
</script>
