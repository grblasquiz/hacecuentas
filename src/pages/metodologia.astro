---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MetodologiaExperience from '../components/generated/MetodologiaExperience.astro';
const canonical='https://hacecuentas.com/metodologia';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Metodología de Hacé Cuentas",url:canonical,operatingSystem:'Web'};
---
<Layout title="Cómo verificamos fórmulas, datos y fuentes | Metodología" description="Conocé cómo Hacé Cuentas selecciona fuentes, prueba fórmulas, actualiza valores, trata contenidos sensibles y corrige errores." canonical={canonical} schema={schema} lang="es">
  <Header />
  <MetodologiaExperience />
  <Footer />
</Layout>
