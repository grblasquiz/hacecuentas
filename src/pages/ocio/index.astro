---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import OcioHomeExperience from '../../components/generated/OcioHomeExperience.astro';
import BingPriorityLinks from '../../components/BingPriorityLinks.astro';
const canonical='https://hacecuentas.com/ocio';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Ocio",url:canonical,operatingSystem:'Web'};
---
<Layout title="Calculadoras de ocio, entretenimiento y tiempo libre | Hacé Cuentas" description="Planificá actividades, juegos, salidas, lecturas y tiempo libre con calculadoras prácticas de costos, duración y organización." canonical={canonical} schema={schema} lang="es">
  <Header />
  <OcioHomeExperience />
  <BingPriorityLinks title="Números para jugar mejor" items={[{href:'/ocio/numeros-de-videojuegos',title:'Números de videojuegos',description:'FPS, latencia, ranking, trades y recursos dentro del juego.'}]} />
  <Footer />
</Layout>
