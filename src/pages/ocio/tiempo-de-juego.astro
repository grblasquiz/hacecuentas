---
/**
 * Hub de decisión — "¿Cuánto tiempo me va a llevar?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Las constantes de cada rama viven en src/lib/hubs/juegos.ts y son copia fiel
 * de las fórmulas originales de src/lib/formulas/. Acá sólo va el compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import TiempoJuegoExperience from '../../components/generated/TiempoJuegoExperience.astro';
import {
  hub,
  PUZZLE_TASA,
  PUZZLE_DIFICULTAD,
  PUZZLE_FACTOR_MIN,
  PUZZLE_FACTOR_MAX,
  MODELISMO_NIVEL,
  MODELISMO_TAMANO,
  MODELISMO_COSTO_POT,
  BANDAS_HORAS,
  BANDAS_TOPE,
} from '../../lib/hubs/juegos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const MATH = {
  PUZZLE_TASA,
  PUZZLE_DIFICULTAD,
  PUZZLE_FACTOR_MIN,
  PUZZLE_FACTOR_MAX,
  MODELISMO_NIVEL,
  MODELISMO_TAMANO,
  MODELISMO_COSTO_POT,
  BANDAS: BANDAS_HORAS,
  TOPE: BANDAS_TOPE,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <TiempoJuegoExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

