---
// @incremental-standalone — página de estadísticas citables de plazo fijo y UVA.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import pfDs from '../../public/datasets/tasa-plazo-fijo-30dias-argentina-historico.json';
import uvaDs from '../../public/datasets/uva-argentina-historico.json';

const URL = 'https://hacecuentas.com/estadisticas-plazo-fijo-uva-argentina';
const pf = (pfDs.data as { fecha: string; tasa_tna_pct: number }[]).slice().sort((a, b) => a.fecha.localeCompare(b.fecha));
const uva = (uvaDs.data as { fecha: string; valor_ars: number }[]).slice().sort((a, b) => a.fecha.localeCompare(b.fecha));
const nf = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 });
const nf1 = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 1 });
const nf2 = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 2 });
const pct = (v: number) => `${nf1.format(v)}%`;
const dateFmt = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const lastPf = pf[pf.length - 1], firstPf = pf[0];
const maxPf = pf.reduce((a, b) => (b.tasa_tna_pct > a.tasa_tna_pct ? b : a));
const minPf = pf.reduce((a, b) => (b.tasa_tna_pct < a.tasa_tna_pct ? b : a));
const firstUva = uva[0], lastUva = uva[uva.length - 1];
const uvaMultiplier = lastUva.valor_ars / firstUva.valor_ars;
const mensualEfectiva = lastPf.tasa_tna_pct / 12;
const yearEndUva = new Map<string, number>();
for (const r of uva) yearEndUva.set(r.fecha.slice(0, 4), r.valor_ars);
const uvaYears = [...yearEndUva.keys()].sort();
const uvaAnnual = uvaYears.slice(1).map((y, i) => ({ year: y, rise: (yearEndUva.get(y)! / yearEndUva.get(uvaYears[i])! - 1) * 100, close: yearEndUva.get(y)! })).reverse();
const currentYear = lastPf.fecha.slice(0, 4);
const avgPfByYear = new Map<string, number[]>();
for (const r of pf) { const y = r.fecha.slice(0, 4); if (!avgPfByYear.has(y)) avgPfByYear.set(y, []); avgPfByYear.get(y)!.push(r.tasa_tna_pct); }
const pfAnnual = [...avgPfByYear.entries()].map(([year, vs]) => ({ year, avg: vs.reduce((a, b) => a + b, 0) / vs.length, max: Math.max(...vs) })).sort((a, b) => b.year.localeCompare(a.year)).slice(0, 10);

const faqs = [
  { q: '¿Cuál es la tasa de plazo fijo a 30 días hoy en Argentina?', a: `Al ${dateFmt(lastPf.fecha)}, la tasa de referencia (TNA) para plazos fijos a 30 días es ${pct(lastPf.tasa_tna_pct)}, equivalente a ${pct(mensualEfectiva)} mensual.` },
  { q: '¿Cuál fue la tasa de plazo fijo más alta de la historia reciente?', a: `${pct(maxPf.tasa_tna_pct)} de TNA, el ${dateFmt(maxPf.fecha)}, durante el pico inflacionario de 2023.` },
  { q: '¿Y la más baja de la serie?', a: `${pct(minPf.tasa_tna_pct)} de TNA, el ${dateFmt(minPf.fecha)}.` },
  { q: '¿Qué es la UVA y cuánto vale hoy?', a: `La UVA (Unidad de Valor Adquisitivo) es una unidad indexada por inflación que usa el BCRA para créditos y plazos fijos ajustables. Vale $${nf2.format(lastUva.valor_ars)} (publicada hasta el ${dateFmt(lastUva.fecha)}).` },
  { q: '¿Cuánto subió la UVA desde su serie inicial?', a: `De $${nf2.format(firstUva.valor_ars)} en junio de 2018 a $${nf2.format(lastUva.valor_ars)}: se multiplicó por ${nf.format(uvaMultiplier)}.` },
  { q: '¿Qué diferencia hay entre TNA y tasa efectiva mensual?', a: 'La TNA (tasa nominal anual) es la referencia publicada por los bancos; para un plazo fijo a 30 días, el rendimiento del mes es aproximadamente la TNA dividida por 12.' },
  { q: '¿Conviene plazo fijo tradicional o UVA?', a: 'El tradicional fija la tasa por adelantado; el UVA ajusta por inflación más un margen. Cuál rinde más depende de si la inflación del período supera o no la tasa fija. Esta página muestra ambas series para comparar.' },
  { q: '¿Puedo descargar las series completas?', a: 'Sí: la serie de tasas de plazo fijo a 30 días y la serie diaria de la UVA están disponibles en CSV y JSON bajo licencia CC BY 4.0, con atribución y enlace a Hacé Cuentas.' },
];
const schema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'Article', headline: 'Estadísticas de plazo fijo y UVA en Argentina', description: `Serie histórica de tasas de plazo fijo a 30 días y valor UVA: récords, promedios anuales y datos vigentes.`, url: URL, datePublished: '2026-08-19', dateModified: pfDs.generatedAt, author: { '@type': 'Person', name: 'Martín Rodríguez', url: 'https://hacecuentas.com/autores/martin-rodriguez' }, publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' } },
    { '@type': 'Dataset', name: 'Tasa de plazo fijo 30 días y UVA en Argentina — series históricas', description: `Tasas TNA de plazo fijo a 30 días desde ${firstPf.fecha} y valor diario de la UVA desde ${firstUva.fecha}.`, url: URL, license: 'https://creativecommons.org/licenses/by/4.0/', temporalCoverage: `${firstPf.fecha}/${lastPf.fecha}`, spatialCoverage: 'Argentina', creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' }, isBasedOn: pfDs.sourceUrl, distribution: [
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datasets/tasa-plazo-fijo-30dias-argentina-historico.csv' },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datasets/tasa-plazo-fijo-30dias-argentina-historico.json' },
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datasets/uva-argentina-historico.csv' },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datasets/uva-argentina-historico.json' },
    ] },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' }, { '@type': 'ListItem', position: 2, name: 'Estadísticas de plazo fijo y UVA', item: URL }] },
  ],
};
---

<Layout title={`Estadísticas de plazo fijo y UVA en Argentina: tasas desde 2014 y récords`} description={`Plazo fijo y UVA en cifras: TNA hoy ${pct(lastPf.tasa_tna_pct)}, récord ${pct(maxPf.tasa_tna_pct)} en 2023, UVA multiplicada por ${nf.format(uvaMultiplier)} desde 2018. Series descargables en CSV y JSON.`} canonical={URL} schema={schema} lang="es" audience="AR" ogType="article" articlePublishedTime="2026-08-19" articleModifiedTime={pfDs.generatedAt} domain="data">
  <Header />
  <main class="stats-page">
    <article>
      <nav aria-label="Migas de pan"><a href="/">Inicio</a><span>›</span><span>Estadísticas de plazo fijo y UVA</span></nav>
      <header class="hero">
        <p class="eyebrow">Investigación propia · Datos al {dateFmt(lastPf.fecha)}</p>
        <h1>Estadísticas de plazo fijo y UVA en Argentina</h1>
        <p class="lede">La serie de tasas de plazo fijo a 30 días desde 2014 y el valor diario de la UVA desde 2018: récords, promedios por año y los datos vigentes para decidir dónde poner los pesos. Todo se recalcula automáticamente con cada actualización del BCRA.</p>
        <p class="scope"><strong>Fuente:</strong> series del BCRA. Datasets completos descargables más abajo (CC BY 4.0).</p>
      </header>

      <section aria-labelledby="resumen"><h2 id="resumen">Los números principales</h2><div class="metric-grid">
        <div><strong>{pct(lastPf.tasa_tna_pct)}</strong><span>TNA plazo fijo 30 días hoy</span></div>
        <div><strong>{pct(mensualEfectiva)}</strong><span>rendimiento mensual aproximado</span></div>
        <div><strong>{pct(maxPf.tasa_tna_pct)}</strong><span>tasa récord ({dateFmt(maxPf.fecha)})</span></div>
        <div><strong>{pct(minPf.tasa_tna_pct)}</strong><span>tasa mínima de la serie ({minPf.fecha.slice(0, 4)})</span></div>
        <div><strong>${nf2.format(lastUva.valor_ars)}</strong><span>valor UVA vigente</span></div>
        <div><strong>×{nf.format(uvaMultiplier)}</strong><span>multiplicación de la UVA desde 2018</span></div>
      </div></section>

      <section><h2>Tasa de plazo fijo por año</h2><p>Promedio y máximo de la TNA de referencia en cada año de la serie.</p><div class="table-wrap"><table><thead><tr><th>Año</th><th>TNA promedio</th><th>TNA máxima</th></tr></thead><tbody>{pfAnnual.map((r) => <tr><th>{r.year}{r.year === currentYear ? ' (parcial)' : ''}</th><td>{pct(r.avg)}</td><td><strong>{pct(r.max)}</strong></td></tr>)}</tbody></table></div></section>

      <section><h2>La UVA, año por año</h2><p>Valor de cierre y variación anual de la UVA — que sigue a la inflación con unos meses de rezago.</p><div class="table-wrap"><table><thead><tr><th>Año</th><th>Cierre UVA</th><th>Variación anual</th></tr></thead><tbody>{uvaAnnual.map((r) => <tr><th>{r.year}{r.year >= currentYear ? ' (parcial)' : ''}</th><td>${nf2.format(r.close)}</td><td><strong>+{pct(r.rise)}</strong></td></tr>)}</tbody></table></div></section>

      <section class="method"><h2>Metodología y límites</h2><p>La tasa registrada es la TNA de referencia para plazos fijos a 30 días publicada por el BCRA (cada banco puede pagar algo más o menos). El valor UVA es el oficial diario del BCRA, que se publica con proyección de algunos días. El rendimiento mensual aproximado divide la TNA por 12; el rendimiento efectivo exacto depende de los días del mes.</p><p><a href="/metodologia">Leé la metodología editorial completa</a>.</p></section>

      <section class="downloads"><h2>Descargar las series completas</h2><p>Licencia CC BY 4.0: reutilizalas con atribución y enlace a esta página.</p><div><a href="/datasets/tasa-plazo-fijo-30dias-argentina-historico.csv" download>Plazo fijo — CSV</a><a href="/datasets/tasa-plazo-fijo-30dias-argentina-historico.json" download>Plazo fijo — JSON</a><a href="/datasets/uva-argentina-historico.csv" download>UVA — CSV</a><a href="/datasets/uva-argentina-historico.json" download>UVA — JSON</a></div></section>

      <section><h2>Cómo citar</h2><blockquote>Hacé Cuentas ({currentYear}). “Estadísticas de plazo fijo y UVA en Argentina”. Series BCRA 2014–{currentYear}. {URL}</blockquote></section>

      <section><h2>Herramientas relacionadas</h2><ol class="ranking">
        <li><a href="/calculadora-actualizacion-inflacion-ipc">Actualizar un monto por inflación (IPC)</a><strong>Calculadora</strong></li>
        <li><a href="/estadisticas-inflacion-argentina">Estadísticas de inflación en Argentina</a><strong>Informe</strong></li>
        <li><a href="/estadisticas-dolar-argentina">Estadísticas del dólar en Argentina</a><strong>Informe</strong></li>
        <li><a href="/valores-bcra">Dólar, UVA e índices del BCRA hoy</a><strong>Datos</strong></li>
      </ol></section>

      <section><h2>Preguntas frecuentes</h2>{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .stats-page{max-width:1080px;margin:0 auto;padding:clamp(1rem,3vw,2rem);color:var(--text,#18283a)}article>nav{display:flex;gap:.5rem;color:var(--text-muted,#64748b);font-size:.85rem}.hero{padding:clamp(2rem,6vw,4rem) 0}.eyebrow{color:var(--accent,#23648d);font-size:.78rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}h1{max-width:850px;margin:.4rem 0;font-size:clamp(2.3rem,7vw,4.4rem);line-height:1.02}.lede{max-width:820px;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.65}.scope{max-width:820px;padding:1rem;border-left:4px solid #2e7ca7;background:var(--bg-soft,#eef6fa)}section{margin:clamp(2.5rem,6vw,5rem) 0}h2{font-size:clamp(1.5rem,3vw,2.2rem)}.metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem}.metric-grid>div{display:flex;flex-direction:column;padding:1.2rem;border:1px solid var(--border,#dce3e9);border-radius:15px;background:var(--bg-card,#fff)}.metric-grid strong{font-size:clamp(1.7rem,4vw,2.6rem);color:var(--accent,#173c5d)}.metric-grid span{color:var(--text-muted,#526477);font-size:.85rem}.table-wrap{overflow-x:auto;border:1px solid var(--border,#dce3e9);border-radius:14px}table{width:100%;border-collapse:collapse}th,td{padding:.8rem 1rem;border-bottom:1px solid var(--border,#e5e7eb);text-align:right}th:first-child{text-align:left}.ranking{display:grid;gap:.55rem;padding:0;list-style:none}.ranking li{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-bottom:1px solid var(--border,#e5e7eb)}.ranking a{color:var(--accent,#23648d);font-weight:700}.method,.downloads{padding:clamp(1.25rem,3vw,2rem);border-radius:18px;background:var(--bg-soft,#f4f7f9)}.downloads div{display:flex;flex-wrap:wrap;gap:.75rem}.downloads a{padding:.8rem 1rem;border-radius:10px;background:#176b91;color:#fff;font-weight:800;text-decoration:none}blockquote{margin:0;padding:1.25rem;border-left:4px solid #2e7ca7;background:var(--bg-soft,#eef6fa);line-height:1.6}details{padding:1rem 0;border-bottom:1px solid var(--border,#dce3e9)}summary{cursor:pointer;font-weight:800}details p{line-height:1.65}@media(max-width:600px){th,td{padding:.65rem .55rem;font-size:.8rem}.ranking li{align-items:flex-start;flex-direction:column}}
</style>
