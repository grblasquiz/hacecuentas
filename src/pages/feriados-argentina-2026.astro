---
export const prerender = true;
import FeriadosLanding from '../components/FeriadosLanding.astro';
import { FERIADOS_AR_2026, META, parseLocal, tipoLabel } from '../lib/data/feriados-ar-2026';

// FERIADOS_AR_2026 (fuente única) NO trae el día de la semana ni un tipo-label
// display; lo derivamos acá al build para encajar en el shape que espera
// FeriadosLanding (mismo componente que las landings LATAM), sin duplicar la data.
const DIAS_CAP = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
const feriados = FERIADOS_AR_2026.map((f) => ({
  fecha: f.fecha,
  dia: DIAS_CAP[parseLocal(f.fecha).getDay()],
  nombre: f.nombre,
  tipo: tipoLabel(f.tipo),
}));

const data = {
  pais: 'Argentina',
  gentilicio: 'los argentinos',
  audience: 'AR' as const,
  slug: 'feriados-argentina-2026',
  totalLabel: `${feriados.length} feriados y días no laborables`,
  dataAsOf: META.dataAsOf,
  marco: 'Ley 27.399 (régimen de feriados nacionales), Decreto 1584/2010 y Resolución 164/2025 (días no laborables turísticos)',
  notaTipo: 'Inamovible = se celebra en su fecha exacta. Trasladable = puede moverse al lunes o martes/jueves más cercano. No laborable = el empleador decide si se trabaja. Puente = día no laborable turístico decretado para armar un fin de semana largo.',
  fuentes: [
    { nombre: META.fuente, url: META.fuenteUrl },
  ],
  feriados,
};

const related = [
  { href: '/dias-entre-dos-fechas', label: 'Días entre dos fechas' },
  { href: '/calculadora-cuenta-regresiva-dias-faltan', label: 'Cuenta regresiva: cuántos días faltan' },
  { href: '/cuantos-feriados-restan-ano-argentina', label: 'Cuántos feriados quedan este año' },
  { href: '/', label: 'Más calculadoras de Hacé Cuentas' },
];

const title = 'Feriados Argentina 2026: calendario oficial con fechas y fines de semana largos | Hacé Cuentas';
const description = `Calendario de feriados Argentina 2026: los ${feriados.length} feriados nacionales y días no laborables con la fecha exacta, el día de la semana y todos los fines de semana largos y puentes. Mirá cuál es el próximo. Datos oficiales (Ley 27.399).`;
---
<FeriadosLanding data={data} related={related} title={title} description={description} />
