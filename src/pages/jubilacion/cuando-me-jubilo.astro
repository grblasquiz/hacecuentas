---
/**
 * Hub de decisión — "¿Cuándo me puedo jubilar?"
 * Reemplaza 3 URLs de calculadora suelta (ver hub.replaces).
 *
 * La matemática de abajo es espejo de las fórmulas reales listadas en
 * src/lib/hubs/cuando-jubilo.ts. Las constantes viajan en REQ y el haber
 * mínimo en MIN: no se duplican números a mano dentro del script.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CuandoMeJubiloExperience from '../../components/generated/CuandoMeJubiloExperience.astro';
import { hub, REQUISITOS, HABER_MINIMO, PUAM } from '../../lib/hubs/cuando-jubilo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CuandoMeJubiloExperience data={hub} />
  <Footer />
</Layout>

