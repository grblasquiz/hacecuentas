---
/**
 * Hub de decisión — "¿Cuándo me puedo jubilar?"
 * Reemplaza 3 URLs de calculadora suelta (ver hub.replaces).
 *
 * La matemática de abajo es espejo de las fórmulas reales listadas en
 * src/lib/hubs/cuando-jubilo.ts. Las constantes viajan en REQ y el haber
 * mínimo en MIN: no se duplican números a mano dentro del script.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, REQUISITOS, HABER_MINIMO, PUAM } from '../../lib/hubs/cuando-jubilo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ REQ: REQUISITOS, MIN: HABER_MINIMO, PUAM_MONTO: PUAM }}>
  (function () {
    const H = window.HC_HUB;
    const n1 = (n) => Math.round(n * 10) / 10;

    /** Franjas fijas de la barra de avance (espejo de hub.chart.bands). */
    const BANDS = [
      { label: 'Lejos', from: 0, to: 50, tone: 'bad' },
      { label: 'A mitad', from: 50, to: 80, tone: 'warn' },
      { label: 'Cerca', from: 80, to: 99, tone: 'warn' },
      { label: 'Listo', from: 99, to: 100, tone: 'good' },
    ];

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'activo';
      const edad = Math.max(0, v.edad);
      const edadMinima = v.sexo === 'm' ? REQ.edadHombre : REQ.edadMujer;
      const aportes = Math.max(0, v.anios) + Math.max(0, Math.min(11, v.meses)) / 12;

      const faltaEdad = Math.max(0, edadMinima - edad);
      const faltaAporte = Math.max(0, REQ.aniosAportes - aportes);
      const cumpleEdad = edad >= edadMinima;
      const cumpleAportes = aportes >= REQ.aniosAportes;
      const faltan = Math.max(faltaEdad, faltaAporte);
      const anioJubilacion = new Date().getFullYear() + Math.ceil(faltan);

      // Avance combinado: manda el requisito más atrasado.
      const avance = Math.round(
        Math.min(edadMinima > 0 ? Math.min(1, edad / edadMinima) : 1, Math.min(1, aportes / REQ.aniosAportes)) * 100,
      );
      const posLabel = cumpleEdad && cumpleAportes
        ? 'Cumplís los dos requisitos'
        : avance + '% del camino · falta ' + (faltaAporte >= faltaEdad ? 'aportes' : 'edad');

      // ---------- PLAN DE PAGO (regularización Ley 27.705) ----------
      if (id === 'regularizacion') {
        const mopre = Math.max(0, v.mopre);
        const mesesFaltantes = Math.min(REQ.moratoriaMaxAnios * 12, Math.round(faltaAporte * 12));
        const deuda = REQ.moratoriaPctMopre * mopre * mesesFaltantes;
        const cuota = deuda / REQ.moratoriaCuotas;
        const neto = Math.max(0, MIN - cuota);
        const pct = MIN > 0 ? Math.round((cuota / MIN) * 100) : 0;
        const conviene = neto > PUAM_MONTO;

        return {
          total: H.ars(deuda),
          sub: mopre <= 0
            ? 'Cargá el MOPRE vigente para ver la deuda: sin ese valor la cuenta no se puede hacer.'
            : mesesFaltantes + ' meses a comprar · cuota de ' + H.ars(cuota) + ' (' + pct + '% del haber) durante ' +
              REQ.moratoriaCuotas + ' meses · te quedan ' + H.ars(neto) + ' en mano, ' +
              (conviene ? 'por encima de la PUAM' : 'por debajo de la PUAM'),
          rows: [
            { k: 'Meses de aportes a comprar', v: mesesFaltantes, format: 'unit', unit: 'meses' },
            { k: 'Años que representan', v: n1(mesesFaltantes / 12), format: 'unit', unit: 'años', decimals: 1 },
            { k: 'Deuda total del plan', ref: '29% MOPRE × mes', v: Math.round(deuda), extra: true },
            { k: 'Cuota mensual', ref: '120 cuotas', v: Math.round(cuota) },
            { k: 'Haber mínimo vigente', v: MIN },
            { k: 'Haber en mano tras el descuento', v: Math.round(neto) },
            { k: 'PUAM, para comparar', ref: '80% del mínimo', v: PUAM_MONTO },
          ],
          format: 'ars',
          chart: BANDS.map((b) => ({ label: b.label, value: b.to - b.from, tone: b.tone, from: b.from, to: b.to })),
          position: avance,
          positionLabel: posLabel,
        };
      }

      // ---------- PUAM ----------
      if (id === 'puam') {
        const faltaPuam = Math.max(0, REQ.puamEdad - edad);
        const resigna = MIN - PUAM_MONTO;
        return {
          total: H.ars(PUAM_MONTO),
          sub: faltaPuam > 0
            ? 'Te faltan ' + n1(faltaPuam) + ' años para los ' + REQ.puamEdad + ' que pide la PUAM · resignás ' +
              H.ars(resigna) + ' por mes frente al haber mínimo'
            : 'Ya tenés la edad para pedirla · resignás ' + H.ars(resigna) + ' por mes frente al haber mínimo',
          rows: [
            { k: 'PUAM mensual', ref: '80% del mínimo', v: PUAM_MONTO, extra: true },
            { k: 'Haber mínimo de una jubilación ordinaria', v: MIN },
            { k: 'Diferencia mensual que resignás', v: Math.round(resigna) },
            { k: 'Diferencia en un año (con aguinaldo)', v: Math.round(resigna * 13) },
            { k: 'Edad para pedirla', ref: 'ambos sexos', v: REQ.puamEdad, format: 'unit', unit: 'años' },
            { k: 'Años que te faltan para esa edad', v: n1(faltaPuam), format: 'unit', unit: 'años', decimals: 1 },
          ],
          format: 'ars',
          chart: BANDS.map((b) => ({ label: b.label, value: b.to - b.from, tone: b.tone, from: b.from, to: b.to })),
          position: avance,
          positionLabel: posLabel,
        };
      }

      // ---------- TENGO LA EDAD, ME FALTAN APORTES ----------
      if (id === 'sin-aportes') {
        return {
          total: cumpleAportes ? 'Ya llegás' : n1(faltaAporte) + ' años',
          sub: cumpleAportes
            ? 'Tenés los 30 años de aportes: te corresponde la jubilación ordinaria, no la PUAM.'
            : 'Te faltan ' + n1(faltaAporte) + ' años de aportes para los 30 · con la edad cumplida y sin moratoria abierta, la vía es la PUAM de ' + H.ars(PUAM_MONTO),
          rows: [
            { k: 'Años de aportes que te faltan', v: n1(faltaAporte), format: 'unit', unit: 'años', decimals: 1, extra: true },
            { k: 'Años de aportes que ya tenés', v: n1(aportes), format: 'unit', unit: 'años', decimals: 1 },
            { k: 'Años de aportes exigidos', ref: 'Ley 24.241', v: REQ.aniosAportes, format: 'unit', unit: 'años' },
            { k: 'Años que te faltan por edad', v: n1(faltaEdad), format: 'unit', unit: 'años', decimals: 1 },
            { k: 'PUAM mensual', ref: '80% del mínimo', v: PUAM_MONTO, format: 'ars' },
            { k: 'Haber mínimo, para comparar', v: MIN, format: 'ars' },
          ],
          format: 'unit', unit: 'años', decimals: 1,
          chart: BANDS.map((b) => ({ label: b.label, value: b.to - b.from, tone: b.tone, from: b.from, to: b.to })),
          position: avance,
          positionLabel: posLabel,
        };
      }

      // ---------- SIGO TRABAJANDO (default) ----------
      const limitante = cumpleEdad && cumpleAportes
        ? 'ya cumplís los dos requisitos'
        : faltaAporte > faltaEdad
          ? 'te frenan los aportes'
          : faltaEdad > faltaAporte
            ? 'te frena la edad'
            : 'te frenan edad y aportes al mismo tiempo';

      return {
        total: faltan <= 0 ? 'Ya podés' : n1(faltan) + ' años',
        sub: faltan <= 0
          ? 'Cumplís edad y aportes: podés iniciar el trámite en ANSES.'
          : 'Alrededor de ' + anioJubilacion + ' · ' + limitante,
        rows: [
          { k: 'Años que te faltan en total', v: n1(faltan), format: 'unit', unit: 'años', decimals: 1, extra: true },
          { k: 'Años que te faltan por edad', v: n1(faltaEdad), format: 'unit', unit: 'años', decimals: 1 },
          { k: 'Años que te faltan por aportes', v: n1(faltaAporte), format: 'unit', unit: 'años', decimals: 1 },
          { k: 'Edad mínima que te aplica', ref: 'Ley 24.241', v: edadMinima, format: 'unit', unit: 'años' },
          { k: 'Años de aportes que ya tenés', v: n1(aportes), format: 'unit', unit: 'años', decimals: 1 },
          { k: 'Año aproximado de jubilación', v: anioJubilacion, format: 'plain' },
        ],
        format: 'unit', unit: 'años', decimals: 1,
        chart: BANDS.map((b) => ({ label: b.label, value: b.to - b.from, tone: b.tone, from: b.from, to: b.to })),
        position: avance,
        positionLabel: posLabel,
      };
    });
  })();
</script>
