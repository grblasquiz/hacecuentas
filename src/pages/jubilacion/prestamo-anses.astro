---
/**
 * Hub de decisión — "¿Cuánto me presta ANSES y con qué cuota me queda el haber?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/prestamo-anses.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y
 * no se tocan.
 *
 * El índice del silo (src/pages/jubilacion/index.astro) ya existe y no se toca.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, CASE_MATH } from '../../lib/hubs/prestamo-anses';
import { FERIADOS_AR_2026, DIAS_SEMANA, MESES } from '../../lib/data/feriados-ar-2026';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

/** Fuente única de feriados: sólo las fechas, que es lo que necesita el cronograma. */
const FERIADOS = FERIADOS_AR_2026.map((f) => f.fecha);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MATH: CASE_MATH, FERIADOS, DIAS: DIAS_SEMANA, MESES }}>
  (function () {
    const H = window.HC_HUB;
    const FER = new Set(FERIADOS);
    // Tope superior de la escala del gráfico (ver hub.chart.bands: 0 → 60).
    const ESCALA = 60;
    const pos = (pct) => Math.max(0, Math.min(100, (pct / ESCALA) * 100));

    /** Cuota del sistema francés. Espejo de cuotaFrances() de la fórmula original. */
    function cuotaFrances(capital, r, n) {
      if (!capital || !n) return 0;
      if (r === 0) return capital / n;
      const f = Math.pow(1 + r, n);
      return (capital * (r * f)) / (f - 1);
    }

    /** Capital máximo dada una cuota tope. Espejo de capitalDesdeCuota(). */
    function capitalDesdeCuota(cuota, r, n) {
      if (!cuota || !n) return 0;
      if (r === 0) return cuota * n;
      const f = Math.pow(1 + r, n);
      return (cuota * (f - 1)) / (r * f);
    }

    function esHabil(d) {
      const dow = d.getDay();
      if (dow === 0 || dow === 6) return false;
      const iso =
        d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
      return !FER.has(iso);
    }

    /** Suma n días hábiles. Espejo de sumarHabiles() de la fórmula del cronograma. */
    function sumarHabiles(inicio, n) {
      const d = new Date(inicio.getTime());
      while (!esHabil(d)) d.setDate(d.getDate() + 1);
      let c = 0;
      while (c < n) {
        d.setDate(d.getDate() + 1);
        if (esHabil(d)) c++;
      }
      return d;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'jubilado';
      const rama = MATH.ramas[id] || MATH.ramas.jubilado;
      const TOPE = MATH.tope;

      const haber = Math.max(0, Number(v.haber) || 0);
      const solicitado = Math.max(0, Number(v.monto) || 0);
      const plazo = Math.max(1, Math.round(Number(v.plazo) || 48));
      const tna = Math.max(0, Number(v.tna) || 0);
      const r = tna / 100 / 12;

      // El bono se paga aparte y sólo hasta el haber mínimo: no amplía el crédito.
      const bono = haber > 0 && haber <= MATH.haberMinimo ? rama.bono : 0;

      const cuotaTope = haber * TOPE;
      const maximo = Math.floor(capitalDesdeCuota(cuotaTope, r, plazo));

      // ── Rama cronograma: no hay crédito, hay fecha ──────────────────────
      if (rama.kind === 'fecha') {
        const term = Math.max(0, Math.min(9, Math.round(Number(v.dni) || 0)));
        const partes = String(v.inicio || '').split('-');
        const base =
          partes.length === 3
            ? new Date(Number(partes[0]), Number(partes[1]) - 1, Number(partes[2]))
            : new Date();
        const fecha = sumarHabiles(base, term);
        const legible =
          DIAS[fecha.getDay()] + ' ' + fecha.getDate() + ' de ' + MESES[fecha.getMonth() + 1].toLowerCase();

        return {
          total: legible.charAt(0).toUpperCase() + legible.slice(1),
          sub:
            'DNI terminado en ' + term + ' · sos el ' + (term + 1) + '° en el orden de cobro · ' +
            'la fecha de arranque la publica ANSES cada mes',
          rows: [
            { k: 'Terminación de tu DNI', ref: 'Último dígito', v: term, format: 'plain' },
            { k: 'Tu lugar en el orden de cobro', ref: 'La 0 cobra primero', v: term + 1, format: 'unit', unit: '°' },
            { k: 'Días hábiles después del arranque', ref: 'Salteando feriados', v: term, format: 'unit', unit: 'días hábiles' },
            { k: 'Tu haber', ref: 'Lo que se acredita', v: haber },
            { k: 'Bono de refuerzo', ref: bono > 0 ? 'Se acredita aparte' : 'No corresponde con este haber', v: bono, extra: bono > 0 },
            { k: 'Total que se acredita', ref: 'Haber más bono', v: haber + bono, extra: true },
          ],
          chart: [
            { label: 'Margen cómodo', value: 0, from: 0, to: 15, tone: 'good' },
            { label: 'Se siente', value: 0, from: 15, to: 30, tone: 'warn' },
            { label: 'Pasa el tope del 30%', value: 0, from: 30, to: ESCALA, tone: 'bad' },
          ],
          position: 0,
          positionLabel: 'Sin cuota descontada: el cronograma ordena el cobro, no afecta el haber',
        };
      }

      // ── Ramas de plata ──────────────────────────────────────────────────
      // 'maximo' arranca del tope y despeja el capital; las otras parten del
      // monto pedido y lo topean si se pasa.
      let capital;
      let topeado = false;
      if (rama.kind === 'maximo' && solicitado <= 0) {
        capital = maximo;
      } else if (solicitado > maximo) {
        capital = maximo;
        topeado = true;
      } else {
        capital = solicitado;
      }

      const cuota = cuotaFrances(capital, r, plazo);
      const totalPagar = cuota * plazo;
      const intereses = totalPagar - capital;
      const afectacion = haber > 0 ? (cuota / haber) * 100 : 0;
      const bolsillo = haber + bono - cuota;

      // Comparación con la TNA promedio del sistema (BCRA, dato vivo).
      const cuotaMercado = cuotaFrances(capital, MATH.tnaMercado / 100 / 12, plazo);

      const rows = [
        { k: 'Tu haber', ref: 'Base del tope', v: haber },
        { k: 'Cuota máxima permitida', ref: 'Tope de afectación 30%', v: cuotaTope },
        { k: 'Máximo que te presta ANSES', ref: plazo + ' cuotas a ' + tna + '% TNA', v: maximo },
        { k: 'Capital del cálculo', ref: topeado ? 'Topeado al máximo' : 'Lo que pediste', v: capital },
        { k: 'Tu cuota mensual', ref: 'Sistema francés', v: cuota, extra: true },
        { k: 'Afectación del haber', ref: 'El tope es 30%', v: afectacion, format: 'unit', unit: '%', decimals: 1 },
        { k: 'Intereses de todo el crédito', ref: 'Total menos capital', v: intereses },
        { k: 'Total a devolver', ref: plazo + ' cuotas', v: totalPagar },
        { k: 'Bono de refuerzo', ref: bono > 0 ? 'Se cobra aparte del haber' : 'No corresponde con este haber', v: bono },
        { k: 'Te queda en el bolsillo por mes', ref: 'Haber más bono menos cuota', v: bolsillo, extra: true },
        { k: 'Cuota al promedio de mercado', ref: 'BCRA ' + MATH.tnaMercado + '% TNA', v: cuotaMercado },
      ];

      const sub =
        (topeado
          ? 'Pediste más del máximo: se topeó en ' + H.ars(maximo)
          : 'Capital ' + H.ars(capital)) +
        ' · cuota ' + H.ars(cuota) + ' (' + afectacion.toFixed(1) + '% del haber, tope 30%)' +
        (bono > 0 ? ' · más el bono de ' + H.ars(bono) : '');

      return {
        total: H.ars(Math.max(0, bolsillo)),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Margen cómodo', value: 0, from: 0, to: 15, tone: 'good' },
          { label: 'Se siente', value: 0, from: 15, to: 30, tone: 'warn' },
          { label: 'Pasa el tope del 30%', value: 0, from: 30, to: ESCALA, tone: 'bad' },
        ],
        position: pos(afectacion),
        positionLabel:
          'La cuota se lleva el ' + afectacion.toFixed(1) + '% del haber' +
          (afectacion > 30 ? ' — pasa el tope y no se aprueba' : ' — entra dentro del tope'),
      };
    });
  })();
</script>
