---
export const prerender = true;

import { hubSeoGraph } from '../../lib/hubs/seo';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import JubilacionExperience from '../../components/JubilacionExperience.astro';
import {
  hub,
  HABER_MINIMO,
  HABER_MAXIMO,
  BONO_REFUERZO,
  PBU,
  COEF_ANUAL,
  TOPE_ANIOS,
} from '../../lib/hubs/cuanto-voy-a-cobrar';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;
const schema = hubSeoGraph(hub);
import HubCitableStats from '../../components/hub/HubCitableStats.astro';
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <JubilacionExperience
    data={hub}
    minimo={HABER_MINIMO}
    maximo={HABER_MAXIMO}
    bono={BONO_REFUERZO}
    pbu={PBU}
    coefAnual={COEF_ANUAL}
    topeAnios={TOPE_ANIOS}
  />
  <HubCitableStats data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>
