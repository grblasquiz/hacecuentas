---
/**
 * Hub de decisión — "¿Me corresponde una pensión?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * El haber mínimo NO se escribe acá: viaja desde src/lib/hubs/pensiones.ts,
 * que lo lee de la fórmula real jubilacion-minima.ts. Misma fuente que el hub
 * hermano /jubilacion/cuando-me-jubilo, para que no puedan contradecirse.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PensionesExperience from '../../components/generated/PensionesExperience.astro';
import { hub, CASE_MATH, HABER_MINIMO } from '../../lib/hubs/pensiones';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PensionesExperience data={hub} />
  <Footer />
</Layout>

