---
/**
 * Hub de decisión — "¿Me corresponde una pensión?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * El haber mínimo NO se escribe acá: viaja desde src/lib/hubs/pensiones.ts,
 * que lo lee de la fórmula real jubilacion-minima.ts. Misma fuente que el hub
 * hermano /jubilacion/cuando-me-jubilo, para que no puedan contradecirse.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, CASE_MATH, HABER_MINIMO } from '../../lib/hubs/pensiones';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MATH: CASE_MATH, HM: HABER_MINIMO }}>
  (function () {
    const H = window.HC_HUB;
    // Tope superior de la escala del gráfico (ver hub.chart.bands: 0 → 130).
    const ESCALA = 130;
    const pos = (pct) => Math.max(0, Math.min(100, (pct / ESCALA) * 100));

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'viudez';
      const haber = Math.max(0, Number(v.haberCausante) || 0);
      const hijos = Math.max(0, Math.floor(Number(v.hijos) || 0));
      const edad = Math.max(0, Math.floor(Number(v.edad) || 0));
      const aportes = Math.max(0, Number(v.aportes) || 0);
      const grado = Math.max(0, Number(v.grado) || 0);
      const hijosNacidos = Math.max(0, Math.floor(Number(v.hijosNacidos) || 0));

      // ── Pensión por fallecimiento — Ley 24.241 art. 98 ──────────────────
      if (id === 'viudez') {
        const pctConyugeNom = hijos === 0 ? MATH.viudezSinHijos : MATH.viudezConHijos;
        const totalNom = pctConyugeNom + hijos * MATH.viudezPorHijo;
        const factor = totalNom > 100 ? 100 / totalNom : 1;
        const prorrateo = totalNom > 100;
        const pctConyuge = pctConyugeNom * factor;
        const pctHijo = hijos > 0 ? MATH.viudezPorHijo * factor : 0;
        const pctTotal = Math.min(100, totalNom);
        const pConyuge = (haber * pctConyuge) / 100;
        const pTotal = (haber * pctTotal) / 100;
        const pctSobreMinimo = HM > 0 ? (pConyuge / HM) * 100 : 0;

        const rows = [
          { k: 'Haber del causante', ref: 'Base de cálculo', v: haber },
          { k: 'Tu pensión como cónyuge', ref: 'Art. 98 inc. a/b', v: pConyuge, extra: true },
          { k: 'Porcentaje que te toca', ref: 'Art. 98', v: pctConyuge, format: 'unit', unit: '%', decimals: 2 },
        ];
        if (hijos > 0) {
          rows.push({ k: 'Pensión por cada hijo con derecho', ref: 'Art. 98 inc. c', v: (haber * pctHijo) / 100 });
          rows.push({ k: 'Hijos con derecho computados', ref: 'Menores de 18 o incapacitados', v: hijos, format: 'unit', unit: 'hijos' });
          rows.push({ k: 'Cobra el grupo familiar completo', ref: 'Art. 98, pauta II', v: pTotal });
        }
        rows.push({ k: 'Tu pensión vs. el haber mínimo', ref: 'Referencia ANSES', v: pctSobreMinimo, format: 'unit', unit: '%', decimals: 1 });

        return {
          total: H.ars(pConyuge),
          sub:
            (hijos === 0
              ? 'Cónyuge sin hijos con derecho: 70% del haber del causante'
              : prorrateo
                ? 'Con ' + hijos + ' hijo(s) la suma da ' + totalNom + '% y se prorratea al 100% (art. 98, pauta II)'
                : 'Cónyuge en concurrencia con ' + hijos + ' hijo(s): 50% + 20% por hijo') +
            ' · sobre un haber de ' + H.ars(haber),
          rows: rows,
          chart: [
            { label: 'Por debajo del 70%', value: 0, from: 0, to: 70, tone: 'bad' },
            { label: 'PNC invalidez (70%)', value: 0, from: 70, to: 80, tone: 'warn' },
            { label: 'PUAM (80%)', value: 0, from: 80, to: 100, tone: 'warn' },
            { label: 'Haber mínimo o más', value: 0, from: 100, to: ESCALA, tone: 'good' },
          ],
          position: pos(pctSobreMinimo),
          positionLabel: H.ars(pConyuge) + ' — ' + Math.round(pctSobreMinimo) + '% del haber mínimo',
        };
      }

      // ── Ramas no contributivas: todas son un % del haber mínimo ─────────
      let monto = 0;
      let factorPct = 0;
      let sub = '';
      const rows = [{ k: 'Haber mínimo jubilatorio vigente', ref: 'ANSES — base de todas las PNC', v: HM }];

      if (id === 'invalidez') {
        const edadOk = edad >= MATH.invalidezEdadMin && edad <= MATH.invalidezEdadMax;
        const gradoOk = grado >= MATH.invalidezGradoMin;
        const elegible = edadOk && gradoOk;
        factorPct = MATH.invalidezFactor * 100;
        monto = elegible ? HM * MATH.invalidezFactor : 0;
        rows.push({ k: 'PNC por invalidez (70% del mínimo)', ref: 'Decreto 432/97', v: HM * MATH.invalidezFactor, extra: true });
        rows.push({ k: 'Grado de invalidez certificado', ref: 'Junta médica ANDIS', v: grado, format: 'unit', unit: '%' });
        rows.push({ k: 'Grado mínimo exigido', ref: 'Requisito', v: MATH.invalidezGradoMin, format: 'unit', unit: '%' });
        rows.push({ k: 'Diferencia contra el haber mínimo', ref: 'Lo que resignás por mes', v: HM - HM * MATH.invalidezFactor });
        if (edad >= 65) {
          rows.push({ k: 'A los 65 pasa a PUAM (80%)', ref: 'Ley 27.260', v: HM * MATH.puamFactor });
        }
        sub = elegible
          ? '70% del haber mínimo, con PAMI incluido'
          : !edadOk
            ? edad > MATH.invalidezEdadMax
              ? 'A partir de los 65 la vía es la PUAM, no la PNC por invalidez: cambiá de caso'
              : 'La PNC por invalidez se pide desde los 18 años'
            : 'El grado certificado (' + grado + '%) no llega al mínimo exigido del ' + MATH.invalidezGradoMin + '%';
        if (!elegible) monto = 0;
      } else if (id === 'madre7') {
        const faltan = Math.max(0, MATH.madre7Hijos - hijosNacidos);
        const elegible = faltan === 0;
        factorPct = MATH.madre7Factor * 100;
        monto = elegible ? HM * MATH.madre7Factor : 0;
        rows.push({ k: 'PNC madre de 7 hijos (100% del mínimo)', ref: 'Ley 23.746', v: HM * MATH.madre7Factor, extra: true });
        rows.push({ k: 'Hijos nacidos vivos declarados', ref: 'Incluye fallecidos y adoptados', v: hijosNacidos, format: 'unit', unit: 'hijos' });
        rows.push({ k: 'Hijos que faltan para llegar a 7', ref: 'Requisito Ley 23.746', v: faltan, format: 'unit', unit: 'hijos' });
        rows.push({ k: 'Total anual con aguinaldo (13 pagos)', ref: 'La PNC cobra SAC', v: monto * 13 });
        sub = elegible
          ? 'Haber mínimo completo, con aguinaldo: 13 pagos al año'
          : 'Faltan ' + faltan + ' hijo(s) nacidos vivos para el requisito de la Ley 23.746';
      } else {
        // PUAM
        const edadOk = edad >= MATH.puamEdad;
        const sinAportes = aportes < 30;
        factorPct = MATH.puamFactor * 100;
        monto = edadOk && sinAportes ? HM * MATH.puamFactor : 0;
        rows.push({ k: 'PUAM (80% del mínimo)', ref: 'Ley 27.260 art. 13', v: HM * MATH.puamFactor, extra: true });
        rows.push({ k: 'Diferencia contra el haber mínimo', ref: 'Lo que resignás por mes', v: HM - HM * MATH.puamFactor });
        rows.push({ k: 'Años de aportes declarados', ref: 'Historia laboral ANSES', v: aportes, format: 'unit', unit: 'años', decimals: 0 });
        rows.push({ k: 'Años que faltan para la jubilación ordinaria', ref: 'Requisito: 30 años', v: Math.max(0, 30 - aportes), format: 'unit', unit: 'años' });
        if (!edadOk) rows.push({ k: 'Años que faltan para la PUAM', ref: 'Se pide a los 65', v: MATH.puamEdad - edad, format: 'unit', unit: 'años' });
        sub = !edadOk
          ? 'La PUAM se pide a los 65 años: te faltan ' + (MATH.puamEdad - edad)
          : !sinAportes
            ? 'Con ' + aportes + ' años de aportes te corresponde jubilación ordinaria, que paga más que la PUAM'
            : '80% del haber mínimo, con PAMI y aguinaldo';
        if (!sinAportes && edadOk) {
          monto = HM;
          factorPct = 100;
        }
      }

      const pctSobreMinimo = HM > 0 ? (monto / HM) * 100 : 0;
      rows.push({ k: 'Cuánto es del haber mínimo', ref: 'Comparación', v: pctSobreMinimo, format: 'unit', unit: '%', decimals: 0 });

      return {
        total: H.ars(monto),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Por debajo del 70%', value: 0, from: 0, to: 70, tone: 'bad' },
          { label: 'PNC invalidez (70%)', value: 0, from: 70, to: 80, tone: 'warn' },
          { label: 'PUAM (80%)', value: 0, from: 80, to: 100, tone: 'warn' },
          { label: 'Haber mínimo o más', value: 0, from: 100, to: ESCALA, tone: 'good' },
        ],
        position: pos(pctSobreMinimo),
        positionLabel:
          monto > 0
            ? H.ars(monto) + ' — ' + Math.round(pctSobreMinimo) + '% del haber mínimo'
            : 'Hoy no se cumplen los requisitos de esta prestación',
      };
    });
  })();
</script>
