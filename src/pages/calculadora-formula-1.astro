---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { freeOfferSchema } from '../lib/offer-schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const site = 'https://hacecuentas.com';
const PAGE_URL = `${site}/calculadora-formula-1`;

const title = 'Calculadora de Fórmula 1 2026: Puntos, Campeonato y Velocidad | Hacé Cuentas';
const description =
  'Multicalculadora de Fórmula 1 2026: sumá los puntos de un piloto por sus resultados, mirá la tabla de puntos por posición (carrera y sprint), calculá si un piloto todavía puede ser campeón y convertí un tiempo de vuelta a velocidad promedio. Gratis, en tu navegador.';

const RACE = [25, 18, 15, 12, 10, 8, 6, 4, 2, 1];
const SPRINT = [8, 7, 6, 5, 4, 3, 2, 1];

const faqs = [
  {
    q: '¿Cómo funciona el sistema de puntos de la Fórmula 1 en 2026?',
    a: 'En 2026 los <strong>10 primeros</strong> de cada Gran Premio suman puntos: <strong>25, 18, 15, 12, 10, 8, 6, 4, 2 y 1</strong>. En las <strong>carreras sprint</strong>, puntúan los <strong>8 primeros</strong>: 8, 7, 6, 5, 4, 3, 2 y 1. Desde 2025 <strong>no existe el punto por vuelta rápida</strong>, así que el máximo por Gran Premio es 25 puntos y por sprint, 8.',
  },
  {
    q: '¿Cuántos puntos da cada posición en un Gran Premio?',
    a: 'Los puntos por posición en carrera son: <strong>1.º = 25</strong>, 2.º = 18, 3.º = 15, 4.º = 12, 5.º = 10, 6.º = 8, 7.º = 6, 8.º = 4, 9.º = 2 y <strong>10.º = 1</strong>. Del 11.º en adelante no se suma ningún punto. Podés ver la tabla completa y sumar los resultados de un piloto en las pestañas de arriba.',
  },
  {
    q: '¿Cuántos puntos otorga una carrera sprint?',
    a: 'La <strong>sprint</strong> reparte puntos solo entre los <strong>8 primeros</strong>: <strong>8, 7, 6, 5, 4, 3, 2 y 1</strong>. Es un formato aparte que se corre el sábado en algunos fines de semana (habitualmente 6 por temporada). Un piloto puede sumar la sprint del sábado y el Gran Premio del domingo, hasta <strong>33 puntos</strong> en ese fin de semana.',
  },
  {
    q: '¿Sigue existiendo el punto por la vuelta rápida?',
    a: 'No. La FIA <strong>eliminó el punto por vuelta rápida a partir de la temporada 2025</strong>, tras la manipulación estratégica vista en el GP de Singapur 2024. Ese punto extra (que existió de 2019 a 2024, para quien marcaba la vuelta más rápida terminando entre los 10 primeros) <strong>ya no se otorga en 2026</strong>.',
  },
  {
    q: '¿Cuál es el máximo de puntos que puede sacar un piloto en un fin de semana?',
    a: 'En un fin de semana <strong>normal</strong>, el máximo es <strong>25 puntos</strong> (ganar el Gran Premio). En un fin de semana <strong>con sprint</strong>, el máximo es <strong>33 puntos</strong>: 8 por ganar la sprint del sábado + 25 por ganar la carrera del domingo.',
  },
  {
    q: '¿Cómo se calcula si un piloto todavía puede ser campeón?',
    a: 'Se cuentan los <strong>puntos que quedan en juego</strong>: cada Gran Premio restante vale hasta 25 y cada sprint restante hasta 8. Si la <strong>diferencia</strong> entre el líder y el perseguidor es <strong>mayor</strong> que ese máximo disponible, el perseguidor ya no puede alcanzarlo (campeonato matemáticamente definido). Usá la pestaña <em>“¿Puede ser campeón?”</em> para calcularlo al instante.',
  },
  {
    q: '¿Qué pasa si dos pilotos terminan empatados en puntos?',
    a: 'Se aplica el <strong>desempate por «countback»</strong>: gana el título quien tenga <strong>más victorias</strong>. Si siguen igualados, se comparan los <strong>segundos puestos</strong>, luego los terceros, y así sucesivamente hasta romper el empate. Los puntos son iguales, pero el historial de mejores resultados define.',
  },
  {
    q: '¿Cuántas carreras y sprints tiene la temporada 2026?',
    a: 'El calendario reciente de F1 ronda las <strong>24 carreras</strong> y <strong>6 sprints</strong> por temporada. El número exacto puede variar según el calendario oficial de cada año, así que para el cálculo de “¿puede ser campeón?” conviene poner las carreras y sprints que <strong>realmente faltan</strong> en el momento en que hacés la cuenta.',
  },
  {
    q: '¿Cómo se calcula la velocidad promedio de una vuelta?',
    a: 'Se divide la <strong>longitud del circuito</strong> por el <strong>tiempo de vuelta</strong>. Por ejemplo, una vuelta de 1:30.000 (90 segundos) en un circuito de 5,0 km da 5 km ÷ 0,025 h = <strong>200 km/h</strong> de promedio. La pestaña <em>“Vuelta → velocidad”</em> lo hace por vos y te muestra el resultado en km/h y mph.',
  },
];

const howToSteps = [
  { name: 'Elegí la pestaña', text: 'Puntos por posición, sumador de temporada, “¿puede ser campeón?” o vuelta → velocidad.' },
  { name: 'Cargá los datos', text: 'Posiciones y sprints del piloto, o los puntos y carreras que faltan, o el tiempo de vuelta.' },
  { name: 'Mirá el resultado', text: 'La calculadora suma los puntos, dice si el campeonato sigue abierto o te da la velocidad promedio.' },
];

const related = [
  { href: '/formula-1-2026', t: 'F1 2026: calendario y posiciones', i: '🏁' },
  { href: '/calculadora-f1-puntos-campeonato-mundial-quedan', t: 'Puntos restantes para ser campeón', i: '🏎️' },
  { href: '/deportes', t: 'Mundial, NBA y F1', i: '🏟️' },
  { href: '/categoria/deportes', t: 'Todas las calculadoras deportivas', i: '📊' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de Fórmula 1',
  url: PAGE_URL,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  inLanguage: 'es',
  isAccessibleForFree: true,
  offers: freeOfferSchema({ priceCurrency: 'ARS' }),
  featureList: [
    'Sumar puntos de un piloto por sus resultados',
    'Tabla de puntos por posición (carrera y sprint) 2026',
    'Calcular si un piloto todavía puede ser campeón',
    'Convertir tiempo de vuelta a velocidad promedio',
  ],
};
const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Deportes', item: `${site}/deportes` },
    { '@type': 'ListItem', position: 3, name: 'Calculadora de Fórmula 1', item: PAGE_URL },
  ],
};
const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
};
const schemaHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Cómo usar la calculadora de Fórmula 1',
  step: howToSteps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text })),
};
---

<Layout title={title} description={description} canonical={PAGE_URL} schema={schema} domain="knowledge">
  <Header slot="header" />

  <article class="f1-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/deportes">Deportes</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Calculadora de Fórmula 1</span>
    </nav>

    <h1>Calculadora de Fórmula 1 2026</h1>
    <p class="lead">
      Cuatro calculadoras de F1 en una: <strong>sumá los puntos</strong> de un piloto, mirá la <strong>tabla de puntos por
      posición</strong>, calculá si alguien <strong>todavía puede ser campeón</strong> y convertí un <strong>tiempo de vuelta
      a velocidad promedio</strong>. Sistema de puntos 2026 (sin punto por vuelta rápida). Todo en tu navegador, gratis.
    </p>

    <!-- h2 de sección: los <h3> de las tablas colgaban del <h1> sin nivel intermedio
         (salto h1→h3 en la auditoría de encabezados 2026-07-24). -->
    <h2 class="sr-only">Calculadoras de puntos, campeonato y velocidad de la Fórmula 1 2026</h2>
    <div id="f1" class="f1-card">
      <div class="f1-tabs" role="tablist">
        <button class="f1-tab is-active" data-tab="puntos" role="tab" type="button">🏁 Puntos por posición</button>
        <button class="f1-tab" data-tab="sumador" role="tab" type="button">➕ Sumador de temporada</button>
        <button class="f1-tab" data-tab="campeon" role="tab" type="button">🏆 ¿Puede ser campeón?</button>
        <button class="f1-tab" data-tab="velocidad" role="tab" type="button">⏱️ Vuelta → velocidad</button>
      </div>

      <!-- TAB: Puntos por posición -->
      <section class="f1-panel is-active" data-panel="puntos">
        <div class="f1-tables">
          <div class="f1-tbl">
            <h3>Gran Premio (carrera)</h3>
            <table>
              <thead><tr><th>Posición</th><th>Puntos</th></tr></thead>
              <tbody>
                {RACE.map((p, i) => (<tr><td>{i + 1}.º</td><td><strong>{p}</strong></td></tr>))}
                <tr class="f1-muted"><td>11.º+</td><td>0</td></tr>
              </tbody>
            </table>
          </div>
          <div class="f1-tbl">
            <h3>Carrera sprint</h3>
            <table>
              <thead><tr><th>Posición</th><th>Puntos</th></tr></thead>
              <tbody>
                {SPRINT.map((p, i) => (<tr><td>{i + 1}.º</td><td><strong>{p}</strong></td></tr>))}
                <tr class="f1-muted"><td>9.º+</td><td>0</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <p class="f1-note">Desde 2025 no hay punto por vuelta rápida. Máximo por fin de semana: 25 (normal) o 33 (con sprint).</p>
      </section>

      <!-- TAB: Sumador -->
      <section class="f1-panel" data-panel="sumador" hidden>
        <p class="f1-help">Poné cuántas veces el piloto terminó en cada posición y te sumo el total de puntos de la temporada.</p>
        <div class="f1-grid">
          <div>
            <h3>Carreras (Grandes Premios)</h3>
            <div class="f1-poscount" id="f1RaceCounts"></div>
          </div>
          <div>
            <h3>Sprints</h3>
            <div class="f1-poscount" id="f1SprintCounts"></div>
          </div>
        </div>
        <div class="f1-result" id="f1SumResult">
          <div class="f1-big"><span id="f1SumTotal">0</span> <small>puntos</small></div>
          <div class="f1-sub" id="f1SumBreak">Cargá resultados para ver el total.</div>
        </div>
      </section>

      <!-- TAB: Campeón -->
      <section class="f1-panel" data-panel="campeon" hidden>
        <p class="f1-help">¿El campeonato sigue abierto? Poné los puntos actuales y lo que falta del calendario.</p>
        <div class="f1-fields">
          <label>Puntos del líder<input type="number" id="f1Lider" inputmode="numeric" min="0" placeholder="Ej: 310" /></label>
          <label>Puntos del perseguidor<input type="number" id="f1Perseg" inputmode="numeric" min="0" placeholder="Ej: 258" /></label>
          <label>Grandes Premios que faltan<input type="number" id="f1Carreras" inputmode="numeric" min="0" max="30" placeholder="Ej: 3" /></label>
          <label>Sprints que faltan<input type="number" id="f1Sprints" inputmode="numeric" min="0" max="12" placeholder="Ej: 1" /></label>
        </div>
        <button class="f1-btn" id="f1CampeonBtn" type="button">Calcular</button>
        <div class="f1-result" id="f1CampeonResult" hidden></div>
      </section>

      <!-- TAB: Velocidad -->
      <section class="f1-panel" data-panel="velocidad" hidden>
        <p class="f1-help">Convertí un tiempo de vuelta en velocidad promedio. Poné el tiempo como <code>1:30.500</code> o en segundos.</p>
        <div class="f1-fields">
          <label>Tiempo de vuelta<input type="text" id="f1Lap" inputmode="decimal" placeholder="1:30.500 o 90.5" /></label>
          <label>Longitud del circuito (km)<input type="text" id="f1Dist" inputmode="decimal" placeholder="Ej: 5.412" /></label>
        </div>
        <button class="f1-btn" id="f1VelBtn" type="button">Calcular</button>
        <div class="f1-result" id="f1VelResult" hidden></div>
      </section>
    </div>

    <section class="f1-sec">
      <h2>El sistema de puntos de la Fórmula 1 en 2026</h2>
      <p>Desde 2010, cada Gran Premio reparte <strong>25-18-15-12-10-8-6-4-2-1</strong> entre los diez primeros. Las <strong>sprints</strong> (desde 2022) suman <strong>8-7-6-5-4-3-2-1</strong> entre los ocho primeros. En 2025 se eliminó el punto por vuelta rápida, así que en 2026 el tope por carrera es 25 y por sprint, 8. El campeón es quien más puntos acumula al final; en caso de empate, se desempata por número de victorias (y luego por segundos puestos, terceros, etc.).</p>
    </section>

    <section class="f1-faq">
      <h2>Preguntas frecuentes</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="f1-faq-a" set:html={f.a} />
        </details>
      ))}
    </section>

    <section class="f1-related">
      <h2>Otras calculadoras</h2>
      <div class="f1-related-grid">
        {related.map((r) => (
          <a href={r.href} class="f1-related-card"><span aria-hidden="true">{r.i}</span><span>{r.t}</span></a>
        ))}
      </div>
    </section>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaFaq)}></script>

  <Footer slot="footer" />
</Layout>

<style is:global>
  .f1-page { max-width: 820px; margin: 0 auto; padding: 0 16px 48px; }
  .f1-page .lead { font-size: 1.05rem; line-height: 1.6; color: var(--text-2, #475569); }
  .f1-card { border: 1px solid var(--border, #e2e8f0); border-radius: 16px; padding: 8px; background: var(--surface, #fff); box-shadow: 0 1px 3px rgba(0,0,0,.05); margin-top: 18px; }
  #f1 .f1-tabs { display: flex; gap: 6px; flex-wrap: wrap; padding: 8px 8px 0; }
  #f1 .f1-tab { flex: 1 1 auto; border: 1px solid var(--border, #e2e8f0); background: var(--surface-2, #f8fafc); color: var(--text-2, #475569); border-radius: 10px 10px 0 0; padding: 10px 12px; font-weight: 600; font-size: .9rem; cursor: pointer; white-space: nowrap; }
  #f1 .f1-tab.is-active { background: var(--accent, #2563eb); color: #fff; border-color: var(--accent, #2563eb); }
  #f1 .f1-panel { padding: 18px 14px 14px; }
  #f1 h3 { font-size: 1rem; margin: 0 0 8px; }
  #f1 .f1-help { color: var(--text-2, #64748b); margin: 0 0 14px; font-size: .95rem; }
  #f1 .f1-tables, #f1 .f1-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  #f1 table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  #f1 th, #f1 td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border, #eef2f7); }
  #f1 th { color: var(--text-2, #64748b); font-weight: 600; }
  #f1 .f1-muted td { color: var(--text-2, #94a3b8); }
  #f1 .f1-note, #f1 .f1-sub { font-size: .85rem; color: var(--text-2, #64748b); }
  #f1 .f1-note { margin: 14px 0 0; }
  #f1 .f1-poscount { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  #f1 .f1-pc { display: flex; align-items: center; gap: 6px; }
  #f1 .f1-pc label { font-size: .82rem; color: var(--text-2, #475569); width: 42px; flex: 0 0 auto; }
  #f1 .f1-pc input { width: 100%; padding: 7px 8px; border: 1px solid var(--border, #cbd5e1); border-radius: 8px; font-size: .95rem; background: var(--surface, #fff); color: var(--text, #0f172a); }
  #f1 .f1-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  #f1 .f1-fields label { display: flex; flex-direction: column; gap: 5px; font-size: .85rem; font-weight: 600; color: var(--text-2, #475569); }
  #f1 .f1-fields input { padding: 11px 12px; border: 1px solid var(--border, #cbd5e1); border-radius: 10px; font-size: 1.05rem; background: var(--surface, #fff); color: var(--text, #0f172a); }
  #f1 .f1-btn { margin-top: 14px; background: var(--accent, #2563eb); color: #fff; font-weight: 700; border: none; border-radius: 10px; padding: 12px 24px; font-size: 1rem; cursor: pointer; }
  #f1 .f1-btn:hover { filter: brightness(1.08); }
  #f1 .f1-result { margin-top: 18px; padding: 16px; border-radius: 12px; background: var(--surface-2, #f1f5f9); }
  #f1 .f1-result.ok { background: color-mix(in srgb, #16a34a 12%, #fff); border: 1px solid color-mix(in srgb, #16a34a 30%, #fff); }
  #f1 .f1-result.no { background: color-mix(in srgb, #dc2626 10%, #fff); border: 1px solid color-mix(in srgb, #dc2626 28%, #fff); }
  #f1 .f1-big { font-size: 2rem; font-weight: 800; color: var(--accent, #2563eb); }
  #f1 .f1-big small { font-size: 1rem; font-weight: 600; color: var(--text-2, #64748b); }
  #f1 .f1-verdict { font-size: 1.15rem; font-weight: 700; margin-bottom: 6px; }
  .f1-sec { margin-top: 32px; } .f1-sec h2, .f1-faq h2, .f1-related h2 { font-size: 1.3rem; margin: 0 0 12px; }
  .f1-sec p { line-height: 1.7; color: var(--text-2, #475569); }
  .f1-faq { margin-top: 30px; } .f1-related { margin-top: 30px; }
  .f1-faq details { border: 1px solid var(--border, #e2e8f0); border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; background: var(--surface, #fff); }
  .f1-faq summary { font-weight: 600; cursor: pointer; }
  .f1-faq-a { margin-top: 8px; line-height: 1.6; color: var(--text-2, #475569); }
  .f1-related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
  .f1-related-card { display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; border: 1px solid var(--border, #e2e8f0); border-radius: 12px; padding: 12px 14px; background: var(--surface, #fff); }
  .f1-related-card:hover { border-color: var(--accent, #2563eb); }
  @media (max-width: 560px) {
    #f1 .f1-tables, #f1 .f1-grid, #f1 .f1-fields { grid-template-columns: 1fr; }
    #f1 .f1-tab { flex: 1 1 45%; }
  }
</style>

<script is:inline>
  (function () {
    var RACE = [25, 18, 15, 12, 10, 8, 6, 4, 2, 1];
    var SPRINT = [8, 7, 6, 5, 4, 3, 2, 1];

    function init() {
      var root = document.getElementById('f1');
      if (!root || root.dataset.ready === '1') return;
      root.dataset.ready = '1';

      // --- Tabs ---
      var tabs = root.querySelectorAll('.f1-tab');
      var panels = root.querySelectorAll('.f1-panel');
      tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          tabs.forEach(function (x) { x.classList.remove('is-active'); });
          t.classList.add('is-active');
          panels.forEach(function (p) {
            var on = p.getAttribute('data-panel') === t.getAttribute('data-tab');
            p.classList.toggle('is-active', on);
            p.hidden = !on;
          });
        });
      });

      // --- Sumador ---
      var raceBox = document.getElementById('f1RaceCounts');
      var sprintBox = document.getElementById('f1SprintCounts');
      function buildCounts(box, n, prefix) {
        var html = '';
        for (var i = 1; i <= n; i++) {
          html += '<div class="f1-pc"><label for="' + prefix + i + '">' + i + '.º</label>' +
            '<input id="' + prefix + i + '" type="number" inputmode="numeric" min="0" max="30" placeholder="0" data-pos="' + i + '" data-kind="' + prefix + '"></div>';
        }
        box.innerHTML = html;
      }
      buildCounts(raceBox, 10, 'race');
      buildCounts(sprintBox, 8, 'sprint');
      var sumTotal = document.getElementById('f1SumTotal');
      var sumBreak = document.getElementById('f1SumBreak');
      function recalcSum() {
        var racePts = 0, sprintPts = 0, wins = 0, podios = 0, carreras = 0;
        root.querySelectorAll('#f1RaceCounts input').forEach(function (inp) {
          var pos = parseInt(inp.getAttribute('data-pos'), 10);
          var c = Math.max(0, parseInt(inp.value, 10) || 0);
          racePts += c * RACE[pos - 1];
          carreras += c;
          if (pos === 1) wins += c;
          if (pos <= 3) podios += c;
        });
        root.querySelectorAll('#f1SprintCounts input').forEach(function (inp) {
          var pos = parseInt(inp.getAttribute('data-pos'), 10);
          var c = Math.max(0, parseInt(inp.value, 10) || 0);
          sprintPts += c * SPRINT[pos - 1];
        });
        var total = racePts + sprintPts;
        sumTotal.textContent = total;
        if (total === 0 && carreras === 0) {
          sumBreak.textContent = 'Cargá resultados para ver el total.';
        } else {
          sumBreak.innerHTML = racePts + ' pts en carreras + ' + sprintPts + ' pts en sprints · ' +
            wins + ' victoria' + (wins === 1 ? '' : 's') + ' · ' + podios + ' podio' + (podios === 1 ? '' : 's') + '.';
        }
      }
      root.querySelectorAll('#f1RaceCounts input, #f1SprintCounts input').forEach(function (inp) {
        inp.addEventListener('input', recalcSum);
      });

      // --- ¿Puede ser campeón? ---
      var campeonBtn = document.getElementById('f1CampeonBtn');
      var campeonRes = document.getElementById('f1CampeonResult');
      campeonBtn.addEventListener('click', function () {
        var lider = parseInt(document.getElementById('f1Lider').value, 10);
        var perseg = parseInt(document.getElementById('f1Perseg').value, 10);
        var carreras = Math.max(0, parseInt(document.getElementById('f1Carreras').value, 10) || 0);
        var sprints = Math.max(0, parseInt(document.getElementById('f1Sprints').value, 10) || 0);
        campeonRes.hidden = false;
        if (isNaN(lider) || isNaN(perseg)) {
          campeonRes.className = 'f1-result';
          campeonRes.innerHTML = 'Completá los puntos del líder y del perseguidor.';
          return;
        }
        var enJuego = carreras * 25 + sprints * 8;
        var gap = lider - perseg;
        var maxPerseg = perseg + enJuego;
        if (gap < 0) {
          campeonRes.className = 'f1-result ok';
          campeonRes.innerHTML = '<div class="f1-verdict">👀 El “perseguidor” va arriba por ' + (-gap) + ' puntos.</div>' +
            '<div class="f1-sub">Revisá quién es el líder. Quedan ' + enJuego + ' puntos en juego.</div>';
          return;
        }
        if (gap > enJuego) {
          campeonRes.className = 'f1-result no';
          campeonRes.innerHTML = '<div class="f1-verdict">❌ Ya no puede alcanzarlo.</div>' +
            '<div class="f1-sub">Le faltan <strong>' + gap + '</strong> puntos y solo quedan <strong>' + enJuego + '</strong> en juego (' +
            carreras + ' GP × 25 + ' + sprints + ' sprint × 8). Aunque gane todo, llega a ' + maxPerseg + '.</div>';
        } else {
          var difMin = gap;
          campeonRes.className = 'f1-result ok';
          var msg = '<div class="f1-verdict">✅ Todavía puede ser campeón.</div>';
          if (gap === 0) {
            msg += '<div class="f1-sub">Están empatados en ' + lider + ' puntos: se define en la pista (y por countback de victorias si terminan iguales). Quedan ' + enJuego + ' puntos en juego.</div>';
          } else {
            var prom = carreras > 0 ? (gap / carreras) : gap;
            msg += '<div class="f1-sub">Necesita recuperar <strong>' + gap + '</strong> puntos con <strong>' + enJuego + '</strong> todavía en juego. Si gana todo llega a <strong>' + maxPerseg + '</strong>' +
              (carreras > 0 ? '. Debería sacarle en promedio ~' + (Math.round(prom * 10) / 10) + ' puntos por Gran Premio' : '') + '.</div>';
          }
          campeonRes.innerHTML = msg;
        }
      });

      // --- Vuelta -> velocidad ---
      var velBtn = document.getElementById('f1VelBtn');
      var velRes = document.getElementById('f1VelResult');
      function parseLap(s) {
        s = (s || '').trim().replace(',', '.');
        if (s === '') return NaN;
        if (s.indexOf(':') >= 0) {
          var parts = s.split(':');
          var min = parseFloat(parts[0]);
          var sec = parseFloat(parts[1]);
          if (isNaN(min) || isNaN(sec)) return NaN;
          return min * 60 + sec;
        }
        return parseFloat(s);
      }
      velBtn.addEventListener('click', function () {
        var secs = parseLap(document.getElementById('f1Lap').value);
        var km = parseFloat((document.getElementById('f1Dist').value || '').replace(',', '.'));
        velRes.hidden = false;
        if (isNaN(secs) || secs <= 0 || isNaN(km) || km <= 0) {
          velRes.className = 'f1-result';
          velRes.innerHTML = 'Poné un tiempo de vuelta (ej. 1:30.500) y la longitud del circuito en km.';
          return;
        }
        var kmh = km / (secs / 3600);
        var mph = kmh * 0.621371;
        velRes.className = 'f1-result ok';
        velRes.innerHTML = '<div class="f1-big">' + (Math.round(kmh * 10) / 10) + ' <small>km/h</small></div>' +
          '<div class="f1-sub">= ' + (Math.round(mph * 10) / 10) + ' mph de velocidad promedio · vuelta de ' + (Math.round(secs * 1000) / 1000) + ' s en ' + km + ' km.</div>';
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
