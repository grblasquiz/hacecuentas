---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CATEGORY_COLORS, BRAND_DEFAULT } from '../lib/category-colors';
import { PILLARS } from '../lib/pillars';
import PillarHub from '../components/PillarHub.astro';
import currentTools from '../lib/current-tools-index.json';

// Índice navegable de TODAS las calculadoras del catálogo raíz (las que se
// sirven en /{slug}). Mismo glob que /buscar y /categoria — no incluye las
// variantes localizadas EN/PT/MX/etc. que viven en src/content/calcs-*/.
//
// Página LIVIANA: renderiza sólo una lista de links (<a href="/{slug}">), no
// monta ninguna calculadora. El filtro de texto corre 100% en el cliente sobre
// los nodos ya presentes en el DOM (no fetchea nada).
const allCalcs = currentTools.map((tool) => ({
  ...tool,
  slug: tool.slug,
  href: new URL(tool.url || `/${tool.slug}`, 'https://hacecuentas.com').pathname.replace(/\/$/, '') || '/',
  icon: '🧮',
}));

// Label + icono + orden de categorías. Espeja el `categoryMeta` de index.astro;
// el color sale de la fuente única CATEGORY_COLORS (category-colors.ts).
const CATEGORY_LABELS: Record<string, string> = {
  finanzas: 'Finanzas',
  salud: 'Salud',
  negocios: 'Negocios',
  marketing: 'Marketing',
  vida: 'Vida cotidiana',
  deportes: 'Deportes',
  viajes: 'Viajes',
  construccion: 'Construcción',
  cocina: 'Cocina',
  mascotas: 'Mascotas',
  matematica: 'Matemática',
  educacion: 'Educación',
  automotor: 'Automotor',
  tecnologia: 'Tecnología',
  'medio-ambiente': 'Medio Ambiente',
  electronica: 'Electrónica',
  entretenimiento: 'Entretenimiento',
  ciencia: 'Ciencia',
  jardineria: 'Jardinería',
  familia: 'Familia',
  idiomas: 'Idiomas',
  impuestos: 'Impuestos',
  trabajo: 'Trabajo',
  'finanzas-personales': 'Finanzas personales',
  alquiler: 'Alquiler',
  auto: 'Auto',
  bebes: 'Bebés',
  estudio: 'Estudio',
  eventos: 'Eventos',
  fechas: 'Fechas',
  futbol: 'Fútbol',
  inversiones: 'Inversiones',
  jardin: 'Jardín',
  jubilacion: 'Jubilación',
  nutricion: 'Nutrición',
  ocio: 'Ocio',
  tramites: 'Trámites',
  vivienda: 'Vivienda',
  hogar: 'Hogar',
  clima: 'Clima',
  juegos: 'Juegos',
  astronomia: 'Astronomía',
};

const CATEGORY_ICONS: Record<string, string> = {
  finanzas: '💰',
  salud: '❤️',
  negocios: '📊',
  marketing: '📈',
  vida: '🗓️',
  deportes: '🏃',
  viajes: '✈️',
  construccion: '🧱',
  cocina: '🍳',
  mascotas: '🐕',
  matematica: '🧮',
  educacion: '🎓',
  automotor: '🚗',
  tecnologia: '💻',
  'medio-ambiente': '🌱',
  electronica: '⚡',
  entretenimiento: '🎮',
  ciencia: '🔬',
  jardineria: '🌿',
  familia: '👨‍👩‍👧‍👦',
  idiomas: '🗣️',
  impuestos: '🧾',
  hogar: '🏠',
  clima: '☀️',
  juegos: '🎲',
  astronomia: '🔭',
};

// Orden fijo: el de CATEGORY_LABELS (las más usadas primero), y al final
// cualquier categoría presente en el catálogo que no esté en el mapa.
const CATEGORY_ORDER = Object.keys(CATEGORY_LABELS);

// Agrupar por categoría.
const byCat: Record<string, any[]> = {};
for (const c of allCalcs) {
  const k = c.category || 'otros';
  (byCat[k] ||= []).push(c);
}

const orderedCats = [
  ...CATEGORY_ORDER.filter((c) => byCat[c]?.length),
  ...Object.keys(byCat).filter((c) => !CATEGORY_ORDER.includes(c)).sort(),
];

// Dentro de cada categoría, ordenar alfabéticamente por título (locale es).
//
// ARQUITECTURA jul-2026: la página ya NO renderiza el listado plano completo
// (~1.750 <a> diluían la autoridad interna: "todas las páginas → todas las
// calculadoras"). En HTML van sólo las TOP_N destacadas por categoría + el
// link a /categoria/<cat> (que pagina el resto server-side). El remanente se
// carga POR INTERACCIÓN desde /search-index.json (client-side, invisible
// para el crawler) al tocar "Mostrar todas" o al filtrar.
const groups = orderedCats.map((cat) => {
  const sorted = byCat[cat].slice().sort((a, b) => (a.h1 || '').localeCompare(b.h1 || '', 'es'));
  return {
    cat,
    label: CATEGORY_LABELS[cat] || cat,
    icon: CATEGORY_ICONS[cat] || '🧮',
    color: CATEGORY_COLORS[cat] || BRAND_DEFAULT,
    calcs: sorted,
    total: sorted.length,
    hiddenCount: 0,
    categoryHub: sorted.find((item) => item.locale === 'es' && item.slug === cat)?.href,
  };
});

const totalCount = allCalcs.length;

const title = 'Todas las calculadoras — Hacé Cuentas';
const description = `Índice completo de las ${totalCount} calculadoras online gratuitas de Hacé Cuentas, organizadas por categoría: finanzas, salud, negocios, matemática y más. Buscá y entrá a cualquiera.`;

const siteUrl = 'https://hacecuentas.com';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Todas las calculadoras de Hacé Cuentas',
  description,
  url: `${siteUrl}/calculadoras`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: totalCount,
    // Cap a 50 items: el ItemList completo eran ~440KB de ld+json (las 2.832
    // calcs) inflando el HTML a 1,86MB. numberOfItems mantiene el total real y
    // la lista de links visible queda intacta; Google no necesita las 2.832 acá.
    itemListElement: groups.flatMap((g) => g.calcs).slice(0, 50).map((c: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.h1,
      url: `${siteUrl}/${c.slug}`,
    })),
  },
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Todas las calculadoras', item: `${siteUrl}/calculadoras` },
  ],
};

// ── Identidad de hub (mockup): hero + "necesidades" arriba, vía PillarHub. El
// listado funcional (search + directorio por categoría + arquitectura SEO 12/cat)
// se preserva DEBAJO, igual que las páginas de categoría (pageType="hub").
const HUB_TONES = ['i1', 'i2', 'i3', 'i4', 'i5', 'i6'];
const quickTools = [
  { icon: '🪪', title: 'Validar CUIT / CUIL', desc: 'Dígito y formato', href: '/validar-cuit' },
  { icon: '🏦', title: 'Validar CBU / CVU', desc: 'Clave bancaria', href: '/validar-cbu' },
  { icon: '🔌', title: 'Consumo eléctrico', desc: 'Qué gasta cada aparato', href: '/calculadora-consumo-electrodomesticos' },
  { icon: '📄', title: 'Imagen a PDF', desc: 'Convertí al instante', href: '/convertir-imagen-a-pdf' },
];
const hubConfig = {
  color: BRAND_DEFAULT,
  nav: 'todas las calculadoras',
  h1: 'Catálogo general de calculadoras en español',
  seoTail: `${totalCount} calculadoras globales y para Argentina`,
  breadcrumb: [{ label: 'Inicio', href: '/' }, { label: 'Todas las calculadoras' }],
  eyebrow: '🧮 Directorio completo',
  titleLines: ['Calculadoras', 'en español'],
  lead: `${totalCount} hubs vigentes de todos los países y categorías, gratis, sin registro y con tus datos privados.`,
  trust: ['Gratis y sin registro', 'Datos verificados 2026', 'Cálculo 100% privado'],
  quick: { tag: 'Acceso rápido', title: 'Las más usadas', desc: 'Arrancá por las calculadoras que más usa la gente en 2026.', cta: 'Ver populares →', href: '/populares', variant: 'cta' as const },
  needsKicker: 'Elegí por tema',
  needsTitle: '¿Qué necesitás calcular?',
  needsSub: 'Entrá por uno de los cuatro pilares o usá una herramienta rápida.',
  needs: [
    ...PILLARS.map((p, i) => ({ icon: p.icon, tone: HUB_TONES[i % 6], title: p.nav, desc: p.h1, href: `/${p.slug}` })),
    ...quickTools.map((t, i) => ({ icon: t.icon, tone: HUB_TONES[(i + 4) % 6], title: t.title, desc: t.desc, href: t.href })),
  ],
  featuredKicker: '', featuredTitle: '', featuredSub: '', showFeaturedSearch: false, filterBadges: [] as string[], cards: [],
  roomsKicker: '', roomsTitle: '', roomsSub: '', rooms: [],
  factsTitle: '', facts: [],
};
---

<Layout
  title={title}
  description={description}
  canonical="/calculadoras"
  audience="global"
  schema={schema}
  pageType="hub"
>
  <Header slot="header" />

  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />

  <div class="hub-listing">
    <p class="country-adapt">🌎 Calculadoras adaptadas por país: <a href="/es/calculadoras">España</a> · <a href="/cl/calculadoras">Chile</a> · <a href="/co/calculadoras">Colombia</a> · <a href="/mx/calculadoras">México</a> · <a href="/pe/calculadoras">Perú</a> · <a href="/ec/calculadoras">Ecuador</a>.</p>

  <div class="search-wrap">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input id="filter-input" type="search" placeholder="Filtrar calculadoras por nombre…" autocomplete="off" aria-label="Filtrar calculadoras" />
    <button id="filter-clear" type="button" aria-label="Limpiar filtro" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="results-count" id="results-count" aria-live="polite"></div>

  {/* Índice de saltos por categoría */}
  <nav class="cat-jump" aria-label="Saltar a categoría">
    {groups.map((g) => (
      <a class="cat-jump-chip" href={`#cat-${g.cat}`} data-cat={g.cat} style={`--cat: ${g.color}`}>
        <span class="cat-jump-icon" aria-hidden="true">{g.icon}</span>
        {g.label} <span class="cat-jump-n">{g.total}</span>
      </a>
    ))}
  </nav>

  <div id="cat-list">
    {groups.map((g) => (
      <section class="cat-block" id={`cat-${g.cat}`} data-cat-block={g.cat} style={`--cat: ${g.color}`}>
        <h2 class="cat-title">
          <span class="cat-title-icon" aria-hidden="true">{g.icon}</span>
          <a href={g.categoryHub || `#cat-${g.cat}`}>{g.label}</a>
          <span class="cat-title-n">{g.total}</span>
        </h2>
        <ul class="calc-list">
          {g.calcs.map((c: any) => (
            <li class="calc-item" data-slug={c.slug} data-name={`${c.h1} ${c.slug}`.toLowerCase()}>
              <a href={c.href}>
                <span class="calc-item-icon" aria-hidden="true">{c.icon || '🧮'}</span>
                <span class="calc-item-name">{c.h1}</span>
                {c.audience === 'AR' && (
                  <span class="ar-badge" title="Específica para Argentina" aria-label="Específica para Argentina">🇦🇷</span>
                )}
              </a>
            </li>
          ))}
        </ul>
        <div class="cat-foot">
          {g.hiddenCount > 0 && (
            <button type="button" class="cat-expand" data-expand={g.cat}>
              Mostrar las {g.hiddenCount} restantes
            </button>
          )}
          {g.categoryHub && <a href={g.categoryHub} class="cat-full">Entrar al hub principal →</a>}
        </div>
      </section>
    ))}
  </div>

  <div class="empty" id="empty" hidden>
    <div class="empty-icon">🔍</div>
    <h3>Sin resultados</h3>
    <p>No encontramos calculadoras que coincidan con tu filtro.</p>
  </div>
  </div>{/* /.hub-listing */}

  <PillarHub config={hubConfig} />

  <Footer slot="footer" />
</Layout>

<style>
  /* pageType="hub" → el <main> queda full-bleed para el hero del PillarHub.
     Este contenedor re-centra el directorio (search + categorías) debajo. */
  .hub-listing {
    width: min(1180px, calc(100% - 40px));
    margin: 2.25rem auto 0;
    order: 2;
  }
  :global(body[data-page-type="hub"] main#main) { display: flex; flex-direction: column; }
  :global(body[data-page-type="hub"] main#main > .hub-interlinking) { order: 3; }
  .country-adapt {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }
  .country-adapt a { color: var(--accent); font-weight: 600; }
  .breadcrumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    margin-bottom: 1.25rem;
  }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }
  .breadcrumbs .sep { color: var(--border-strong); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }

  .page-header { margin-bottom: 1.5rem; }
  .page-header h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); margin-bottom: 0.5rem; }
  .page-header p { color: var(--text-muted); margin: 0; max-width: 640px; }
  .page-header strong { color: var(--text); }

  .pillar-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.625rem;
    margin-bottom: 1.5rem;
  }
  .pillar-strip-card {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    background: var(--bg-card);
    border: 1.5px solid var(--border);
    border-left: 4px solid var(--pilar);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .pillar-strip-card:hover { border-color: var(--pilar); box-shadow: var(--shadow-lg); text-decoration: none; }
  .ps-icon { font-size: 1.25rem; flex-shrink: 0; }
  .ps-name { font-size: 0.9rem; font-weight: 600; color: var(--text); line-height: 1.3; }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.125rem;
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 1rem;
    color: var(--text-subtle);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
    position: sticky;
    top: 0.5rem;
    z-index: 5;
  }
  .search-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .search-wrap input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1rem;
    color: var(--text);
  }
  #filter-clear {
    background: transparent;
    border: none;
    color: var(--text-subtle);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    display: flex;
  }
  #filter-clear:hover { color: var(--text); background: var(--bg-muted); }

  .results-count {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    min-height: 1.25rem;
    margin-bottom: 1rem;
  }

  .cat-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .cat-jump-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4375rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .cat-jump-chip:hover {
    border-color: var(--cat);
    color: var(--cat);
  }
  .cat-jump-icon { font-size: 0.95em; }
  .cat-jump-n {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-subtle);
  }
  .cat-jump-chip[hidden] { display: none; }

  .cat-block {
    margin-bottom: 2.5rem;
    scroll-margin-top: 4.5rem;
  }
  .cat-block[hidden] { display: none; }

  .cat-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    padding-bottom: 0.625rem;
    margin-bottom: 1rem;
    border-bottom: 2px solid color-mix(in srgb, var(--cat) 25%, transparent);
  }
  .cat-title-icon { font-size: 1.1em; }
  .cat-title a { color: var(--text); text-decoration: none; }
  .cat-title a:hover { color: var(--cat); }
  .cat-title-n {
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    background: var(--cat);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }

  .calc-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
  }
  .calc-item[hidden] { display: none; }
  .calc-item a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.35;
    transition: background 0.12s, color 0.12s;
  }
  .calc-item a:hover {
    background: color-mix(in srgb, var(--cat) 10%, transparent);
    color: var(--cat);
  }
  .calc-item-icon { flex-shrink: 0; font-size: 1em; }
  .calc-item-name { flex: 1; min-width: 0; }
  .ar-badge { flex-shrink: 0; font-size: 0.9em; line-height: 1; }

  .cat-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.625rem;
    padding-left: 0.625rem;
  }
  .cat-foot[hidden] { display: none; }
  .cat-expand {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .cat-expand:hover { border-color: var(--cat); color: var(--cat); }
  .cat-full {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--cat);
    text-decoration: none;
  }
  .cat-full:hover { text-decoration: underline; }

  .empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }
  .empty-icon { font-size: 3rem; margin-bottom: 0.5rem; opacity: 0.6; }
  .empty h3 { margin-bottom: 0.5rem; }
</style>

<script>
  // Directorio con carga POR INTERACCIÓN (arquitectura de pilares jul-2026):
  // el HTML estático sólo trae las TOP_N destacadas por categoría. El resto
  // del catálogo se trae de /search-index.json (mismo índice que el buscador
  // del header) recién cuando el usuario toca "Mostrar todas" o filtra.
  // Así el crawler ve un directorio curado y el usuario no pierde nada.
  // Se re-ata en cada navegación SPA (astro:page-load) porque ClientRouter
  // swap-ea el <body>.
  function initCalcFilter() {
    const input = document.getElementById('filter-input') as HTMLInputElement | null;
    const clear = document.getElementById('filter-clear');
    const count = document.getElementById('results-count');
    const empty = document.getElementById('empty');
    const list = document.getElementById('cat-list');
    if (!input || !list || (list as HTMLElement).dataset.init) return;
    (list as HTMLElement).dataset.init = '1';

    const blocks = Array.from(list.querySelectorAll<HTMLElement>('[data-cat-block]'));
    const jumpChips = Array.from(document.querySelectorAll<HTMLElement>('.cat-jump-chip'));

    const norm = (s: string) =>
      s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    // Categorías que el usuario expandió a mano ("Mostrar todas"): sus items
    // extra quedan visibles también sin filtro activo.
    const expandedCats = new Set<string>();
    let indexPromise: Promise<void> | null = null;

    // Nodos construidos con createElement/textContent (nunca innerHTML con
    // datos del índice) — mismo criterio anti-XSS que el modal del header.
    function makeItem(c: any): HTMLElement {
      const li = document.createElement('li');
      li.className = 'calc-item';
      li.dataset.slug = c.s;
      li.dataset.name = `${c.h} ${c.s}`.toLowerCase();
      li.dataset.extra = '1';
      const a = document.createElement('a');
      a.href = '/' + c.s;
      const icon = document.createElement('span');
      icon.className = 'calc-item-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = c.i || '🧮';
      const name = document.createElement('span');
      name.className = 'calc-item-name';
      name.textContent = c.h;
      a.appendChild(icon);
      a.appendChild(name);
      if (c.a === 'AR') {
        const badge = document.createElement('span');
        badge.className = 'ar-badge';
        badge.title = 'Específica para Argentina';
        badge.textContent = '🇦🇷';
        a.appendChild(badge);
      }
      li.appendChild(a);
      return li;
    }

    // Trae el índice completo UNA vez y appendea a cada categoría los items
    // que el HTML estático no trajo. La visibilidad la decide apply().
    function ensureIndex(): Promise<void> {
      if (indexPromise) return indexPromise;
      indexPromise = fetch('/search-index.json', { cache: 'force-cache' })
        .then((r) => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then((data: any[]) => {
          for (const block of blocks) {
            const cat = block.getAttribute('data-cat-block');
            const ul = block.querySelector('.calc-list');
            if (!cat || !ul) continue;
            const have = new Set(
              Array.from(ul.querySelectorAll<HTMLElement>('.calc-item')).map((li) => li.dataset.slug),
            );
            const rest = data
              .filter((c) => (c.c || 'otros') === cat && c.s && !have.has(c.s))
              .sort((a, b) => (a.h || '').localeCompare(b.h || '', 'es'));
            const frag = document.createDocumentFragment();
            for (const c of rest) frag.appendChild(makeItem(c));
            ul.appendChild(frag);
          }
        })
        .catch((err) => {
          console.error('[calculadoras] index fetch failed', err);
          indexPromise = null;
          throw err;
        });
      return indexPromise;
    }

    function apply() {
      const q = norm(input!.value.trim());
      const tokens = q.split(/\s+/).filter(Boolean);
      let visible = 0;

      const items = Array.from(list!.querySelectorAll<HTMLElement>('.calc-item'));
      for (const it of items) {
        let match: boolean;
        if (tokens.length) {
          const name = norm(it.dataset.name || '');
          match = tokens.every((t) => name.includes(t));
        } else {
          // Sin filtro: los items extra (cargados por interacción) sólo se ven
          // en las categorías que el usuario expandió.
          const cat = it.closest('[data-cat-block]')?.getAttribute('data-cat-block') || '';
          match = !it.dataset.extra || expandedCats.has(cat);
        }
        it.hidden = !match;
        if (match) visible++;
      }

      // Ocultar bloques de categoría sin matches; sincronizar chips de salto.
      for (const b of blocks) {
        const cat = b.getAttribute('data-cat-block');
        const anyVisible = b.querySelector('.calc-item:not([hidden])') !== null;
        b.hidden = !anyVisible;
        const chip = jumpChips.find((c) => c.dataset.cat === cat);
        if (chip) chip.hidden = !anyVisible;
        // El footer de la categoría (expandir / ver completa) sólo sin filtro.
        const foot = b.querySelector<HTMLElement>('.cat-foot');
        if (foot) foot.hidden = tokens.length > 0;
      }

      if (empty) empty.hidden = visible > 0;
      if (count) {
        count.textContent = tokens.length
          ? `${visible} resultado${visible === 1 ? '' : 's'}`
          : '';
      }
      if (clear) clear.hidden = !input!.value;
    }

    // "Mostrar las N restantes" por categoría.
    for (const btn of Array.from(list.querySelectorAll<HTMLElement>('.cat-expand'))) {
      btn.addEventListener('click', async () => {
        const cat = btn.getAttribute('data-expand');
        if (!cat) return;
        btn.textContent = 'Cargando…';
        try {
          await ensureIndex();
          expandedCats.add(cat);
          btn.remove();
          apply();
        } catch {
          btn.textContent = 'No se pudo cargar — reintentar';
        }
      });
    }

    let searchToken = 0;
    input.addEventListener('input', () => {
      const q = input.value.trim();
      if (q) {
        // Filtrar necesita el catálogo completo: lo traemos al primer tipeo y
        // aplicamos sobre lo que haya mientras tanto (evita esperar el fetch).
        apply();
        const my = ++searchToken;
        ensureIndex().then(() => { if (my === searchToken) apply(); }).catch(() => {});
      } else {
        apply();
      }
    });
    clear?.addEventListener('click', () => {
      input.value = '';
      input.focus();
      apply();
    });

    // Aplicar query inicial si vino por ?q= (consistencia con /buscar).
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      input.value = q;
      apply();
      ensureIndex().then(apply).catch(() => {});
    }
  }

  initCalcFilter();
  document.addEventListener('astro:page-load', initCalcFilter);
</script>
