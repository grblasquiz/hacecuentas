---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PregnancyWeekExperience from '../../components/generated/PregnancyWeekExperience.astro';
const canonical = 'https://hacecuentas.com/en/pregnancy-week-calculator';
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:'Pregnancy week calculator',url:canonical,applicationCategory:'FinanceApplication',operatingSystem:'Web'};
