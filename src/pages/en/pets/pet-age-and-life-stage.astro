---
/**
 * Hub EN — "How old is my pet really, and what's due now?"
 * audience="US" y lang="en" literales; el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  CAT_YEAR_1,
  CAT_YEAR_2,
  CAT_PER_YEAR_AFTER,
  DOG_SIZE_FACTOR,
  DOG_BREEDS,
  RABBIT_YEAR_1,
  RABBIT_FACTOR,
  SPAY,
} from '../../../lib/hubs/en/pet-age-and-life-stage';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/en' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ CAT_YEAR_1, CAT_YEAR_2, CAT_PER_YEAR_AFTER, DOG_SIZE_FACTOR, DOG_BREEDS, RABBIT_YEAR_1, RABBIT_FACTOR, SPAY }}
>
  (function () {
    const H = window.HC_HUB;
    const r1 = (x) => Math.round((x || 0) * 10) / 10;

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'cat';

      if (id === 'dog') {
        // 0 es un valor legítimo (recién nacido): nada de `|| default`.
        const age = Math.max(0, Number.isFinite(v.dogage) ? v.dogage : 0);
        const key = String(v.breed || 'labrador-retriever');
        const br = DOG_BREEDS[key] || DOG_BREEDS['labrador-retriever'];
        const factor = DOG_SIZE_FACTOR[br.size] ?? 1.0;
        // AVMA 2020: 16 × ln(edad) + 31; por debajo de 1 año, interpolación lineal.
        const base = age <= 0 ? 0 : age < 1 ? 15 * age : 16 * Math.log(age) + 31;
        const human = base * factor;
        const stage =
          human < 20 ? 'Puppy or juvenile' :
          human < 40 ? 'Young adult' :
          human < 60 ? 'Mature adult' :
          human < 75 ? 'Senior' : 'Geriatric';
        const advice =
          human < 20 ? 'Vaccine series, early socialisation and growth-formula food.' :
          human < 60 ? 'Annual exams and a balanced diet are enough; watch weight and joints.' :
          'Twice-yearly exams, senior diet, joint support, and bloodwork at every visit.';
        const rows = [
          { k: 'Breed', ref: br.label + ' — ' + br.size + ' size class', v: factor, format: 'plain', decimals: 2 },
          { k: 'Dog age', ref: 'Calendar years', v: age, format: 'unit', unit: 'years', decimals: 1 },
          { k: 'AVMA 2020 base equivalence', ref: age < 1 ? 'Under a year: linear, 15 × age' : '16 × ln(age) + 31', v: base, format: 'unit', unit: 'human years', decimals: 1 },
          { k: 'Human-year equivalent', ref: 'Base × the size factor', v: human, format: 'unit', unit: 'human years', decimals: 1, extra: true },
          { k: 'The old "×7" answer, for comparison', ref: 'Wrong by a wide margin at both ends', v: age * 7, format: 'unit', unit: 'human years', decimals: 1 },
          { k: 'A toy breed of the same age', ref: 'Size factor 0.90', v: base * 0.9, format: 'unit', unit: 'human years', decimals: 1 },
          { k: 'A large breed of the same age', ref: 'Size factor 1.10', v: base * 1.1, format: 'unit', unit: 'human years', decimals: 1 },
          { k: 'Human years added by the next dog year', ref: 'The curve flattens as the dog ages', v: Math.max(0, (16 * Math.log(age + 1) + 31) * factor - human), format: 'unit', unit: 'human years', decimals: 1 },
        ];
        return {
          total: Math.round(human) + ' human years',
          sub:
            br.label + ' at ' + age + ' · ' + stage + ' · ' + advice,
          position: Math.min(100, (human / 90) * 100),
          positionLabel: Math.round(human) + ' human years — ' + stage,
          rows: rows,
          chart: [
            { label: 'Puppy or juvenile', value: 20, from: 0, to: 20, tone: 'good' },
            { label: 'Young adult', value: 20, from: 20, to: 40, tone: 'main' },
            { label: 'Mature adult', value: 20, from: 40, to: 60, tone: 'prop' },
            { label: 'Senior', value: 15, from: 60, to: 75, tone: 'warn' },
            { label: 'Geriatric', value: 15, from: 75, to: 90, tone: 'bad' },
          ],
        };
      }

      if (id === 'rabbit') {
        const age = Math.max(0, Number.isFinite(v.rabbitage) ? v.rabbitage : 0);
        const key = String(v.rabbitbreed || 'medium');
        const br = RABBIT_FACTOR[key] || RABBIT_FACTOR.medium;
        const human = age <= 1 ? age * RABBIT_YEAR_1 : RABBIT_YEAR_1 + (age - 1) * br.perYear;
        let stage;
        if (key === 'giant') {
          stage = age < 0.5 ? 'Kit' : age < 1 ? 'Adolescent' : age < 3 ? 'Young adult' : age < 4 ? 'Mature adult' : age < 5 ? 'Senior' : 'Advanced senior';
        } else {
          stage = age < 0.5 ? 'Kit' : age < 1 ? 'Adolescent' : age < 3 ? 'Young adult' : age < 5 ? 'Mature adult' : age < 7 ? 'Senior' : 'Advanced senior';
        }
        const topYears = key === 'giant' ? 7 : key === 'dwarf' ? 12 : 10;
        const rows = [
          { k: 'Breed size', ref: br.label + ' — life expectancy ' + br.expectancy, v: br.perYear, format: 'unit', unit: 'human years per rabbit year' },
          { k: 'Rabbit age', ref: 'Calendar years', v: age, format: 'unit', unit: 'years', decimals: 1 },
          { k: 'The first year alone', ref: 'A twelve-month rabbit is fully adult', v: Math.min(age, 1) * RABBIT_YEAR_1, format: 'unit', unit: 'human years', decimals: 1 },
          { k: 'Human-year equivalent', ref: 'First year 21, then ' + br.perYear + ' per year', v: human, format: 'unit', unit: 'human years', decimals: 1, extra: true },
          { k: 'Years left to typical life expectancy', ref: br.expectancy + ' for this size', v: Math.max(0, topYears - age), format: 'unit', unit: 'years', decimals: 1, extra: true },
          { k: 'A dwarf of the same age', ref: '6 human years per rabbit year', v: age <= 1 ? age * RABBIT_YEAR_1 : RABBIT_YEAR_1 + (age - 1) * 6, format: 'unit', unit: 'human years', decimals: 1 },
          { k: 'A giant of the same age', ref: '10 human years per rabbit year', v: age <= 1 ? age * RABBIT_YEAR_1 : RABBIT_YEAR_1 + (age - 1) * 10, format: 'unit', unit: 'human years', decimals: 1 },
        ];
        return {
          total: Math.round(human) + ' human years',
          sub:
            br.label + ' at ' + age + ' years · ' + stage + ' · life expectancy ' + br.expectancy + ' · ' +
            'any drop in hay eating is a dental exam, not a wait-and-see',
          position: Math.min(100, (age / topYears) * 100),
          positionLabel: stage + ' — ' + r1(age) + ' of about ' + topYears + ' years',
          rows: rows,
          chart: [
            { label: 'Kit and adolescent', value: 1, from: 0, to: 1, tone: 'good' },
            { label: 'Young adult', value: 2, from: 1, to: 3, tone: 'main' },
            { label: 'Mature adult', value: 2, from: 3, to: 5, tone: 'prop' },
            { label: 'Senior', value: 2, from: 5, to: 7, tone: 'warn' },
            { label: 'Advanced senior', value: Math.max(1, topYears - 7), from: 7, to: Math.max(8, topYears), tone: 'bad' },
          ],
        };
      }

      if (id === 'spay') {
        const key = String(v.spaywho || 'dog_medium');
        const sp = SPAY[key] || SPAY.dog_medium;
        const rows = [
          { k: 'Ideal window opens', ref: sp.ideal + ' is the target', v: sp.min, format: 'unit', unit: 'months', extra: true },
          { k: 'Outer edge of the window', ref: 'Past this the trade-offs change', v: sp.max, format: 'unit', unit: 'months', extra: true },
          { k: 'Window width', ref: 'How much room the booking has', v: sp.max - sp.min, format: 'unit', unit: 'months' },
          { k: 'The same in weeks', ref: 'Useful when the pet is still counted in weeks', v: sp.min * 4.345, format: 'unit', unit: 'weeks', decimals: 0 },
          { k: 'Cat first heat can arrive as early as', ref: 'Which is why the feline deadline is five months', v: 4, format: 'unit', unit: 'months' },
          { k: 'Heat cycles after which most tumour protection is lost', ref: 'Protection decays fast with each cycle', v: 2, format: 'plain' },
          { k: 'Growth plate closure, giant breeds', ref: 'The reason the giant window sits late', v: 21, format: 'unit', unit: 'months' },
        ];
        return {
          total: sp.ideal,
          sub: sp.risk + '. ' + sp.note,
          position: Math.min(100, (sp.min / 24) * 100),
          positionLabel: 'Window ' + sp.min + '–' + sp.max + ' months, ideal ' + sp.ideal,
          rows: rows,
          chart: [
            { label: 'Too early', value: sp.min, from: 0, to: sp.min, tone: 'warn' },
            { label: 'Recommended window', value: sp.max - sp.min, from: sp.min, to: sp.max, tone: 'good' },
            { label: 'Later than ideal', value: Math.max(1, 24 - sp.max), from: sp.max, to: 24, tone: 'bad' },
          ],
        };
      }

      if (id === 'vaccines') {
        const weeks = Math.max(0, Number.isFinite(v.puppyweeks) ? v.puppyweeks : 0);
        const documented = String(v.hasrecord || 'no') === 'yes';
        let stage, now, next, rabies;
        if (weeks < 6) {
          stage = 'Too young to start';
          now = 'Nothing yet. Until about six weeks, antibodies from the mother block the vaccine from taking.';
          next = 'First core dose between six and eight weeks of age.';
          rabies = 'Rabies comes later — most US jurisdictions set a minimum of twelve or sixteen weeks.';
        } else if (weeks < 9) {
          stage = 'Puppy — first dose';
          now = 'First core dose is due: distemper, adenovirus, parvovirus and parainfluenza.';
          next = 'Second core dose two to four weeks from now, around ten to twelve weeks of age.';
          rabies = 'Not yet. Rabies is given at the minimum age your state or county sets.';
        } else if (weeks < 13) {
          stage = 'Puppy — second dose';
          now = 'Second core dose is due.';
          next = 'Third core dose at twelve to sixteen weeks, and rabies at the age your jurisdiction requires.';
          rabies = 'Rabies becomes possible in most US jurisdictions from twelve weeks — check your county.';
        } else if (weeks < 17) {
          stage = 'Puppy — final dose window';
          now = 'Final core dose of the series, which must land at sixteen weeks or later, plus rabies if not already given.';
          next = 'Booster one year after the final puppy dose, then on your veterinarian\'s interval.';
          rabies = 'Rabies is due now if your jurisdiction has not already required it.';
        } else if (weeks < 52) {
          stage = 'Young dog — finishing the series';
          now = 'Complete any missing dose of the puppy series now; a series that stopped before sixteen weeks is not finished.';
          next = 'First full booster at twelve months of age.';
          rabies = 'Rabies must be current and documented — it is a legal requirement, not a recommendation.';
        } else if (!documented) {
          stage = 'Adult with no record';
          now = 'Treat as unvaccinated: start the core series again, typically two doses three to four weeks apart.';
          next = 'Booster a year after the second dose, then on the interval your veterinarian sets.';
          rabies = 'Rabies is due now, and it needs a certificate for the record.';
        } else {
          stage = 'Adult, vaccinated';
          now = 'Nothing due unless the record says otherwise. Core boosters typically run every one to three years.';
          next = 'Next booster on the date in the record; annual exam regardless.';
          rabies = 'Rabies on the interval your state or county requires, which may be one or three years.';
        }
        const months = weeks / 4.345;
        const rows = [
          { k: 'Age entered', ref: months >= 12 ? r1(months / 12) + ' years' : r1(months) + ' months', v: weeks, format: 'unit', unit: 'weeks', decimals: 0 },
          { k: 'Earliest the core series can start', ref: 'Maternal antibodies block it before this', v: 6, format: 'unit', unit: 'weeks', extra: true },
          { k: 'Final dose must land at or after', ref: 'Stopping earlier can leave the puppy unprotected', v: 16, format: 'unit', unit: 'weeks', extra: true },
          { k: 'Interval between puppy doses', ref: 'Two to four weeks', v: 3, format: 'unit', unit: 'weeks' },
          { k: 'Weeks until the sixteen-week milestone', ref: weeks >= 16 ? 'Already past it' : 'Book ahead', v: Math.max(0, 16 - weeks), format: 'unit', unit: 'weeks' },
          { k: 'Wait after the final dose before public ground', ref: 'Parvovirus survives in soil for months', v: 2, format: 'unit', unit: 'weeks', extra: true },
          { k: 'Typical adult core booster interval', ref: 'Set by your veterinarian, longer than it used to be', v: 3, format: 'unit', unit: 'years' },
        ];
        return {
          total: stage,
          sub: now + ' ' + next + ' ' + rabies,
          position: Math.min(100, (weeks / 24) * 100),
          positionLabel: stage + ' — ' + Math.round(weeks) + ' weeks',
          rows: rows,
          chart: [
            { label: 'Too young', value: 6, from: 0, to: 6, tone: 'warn' },
            { label: 'First dose', value: 3, from: 6, to: 9, tone: 'good' },
            { label: 'Second dose', value: 4, from: 9, to: 13, tone: 'main' },
            { label: 'Final dose and rabies', value: 4, from: 13, to: 17, tone: 'prop' },
            { label: 'Protected, boosters from here', value: 7, from: 17, to: 24, tone: 'good' },
          ],
        };
      }

      // cat
      const age = Math.max(0, Number.isFinite(v.catage) ? v.catage : 0);
      let human;
      if (age <= 0) human = 0;
      else if (age <= 1) human = age * CAT_YEAR_1;
      else if (age <= 2) human = CAT_YEAR_1 + (age - 1) * (CAT_YEAR_2 - CAT_YEAR_1);
      else human = CAT_YEAR_2 + (age - 2) * CAT_PER_YEAR_AFTER;
      const stage = age < 1 ? 'Kitten' : age <= 6 ? 'Young adult' : age <= 10 ? 'Mature adult' : 'Senior';
      const advice =
        age < 1 ? 'Vaccination, deworming, socialisation and spaying by five months.' :
        age <= 6 ? 'Annual exam, weight and dental care — this is where the baseline is set.' :
        age <= 10 ? 'Move to six-monthly exams with annual blood and urine panels.' :
        'Exams every three to four months. Thyroid, kidney values and blood pressure are the ones that move first.';
      const rows = [
        { k: 'Cat age', ref: 'Calendar years', v: age, format: 'unit', unit: 'years', decimals: 1 },
        { k: 'The first year', ref: 'Worth 15 human years on its own', v: Math.min(age, 1) * CAT_YEAR_1, format: 'unit', unit: 'human years', decimals: 1 },
        { k: 'The second year', ref: 'Adds 9 more, reaching 24 at two years', v: age <= 1 ? 0 : Math.min(age - 1, 1) * 9, format: 'unit', unit: 'human years', decimals: 1 },
        { k: 'Every year after that', ref: '4 human years each', v: age <= 2 ? 0 : (age - 2) * CAT_PER_YEAR_AFTER, format: 'unit', unit: 'human years', decimals: 1 },
        { k: 'Human-year equivalent', ref: 'AAFP/AAHA feline equivalence', v: human, format: 'unit', unit: 'human years', decimals: 1, extra: true },
        { k: 'The old "×7" answer, for comparison', ref: 'Off by nine years already at twelve months', v: age * 7, format: 'unit', unit: 'human years', decimals: 1 },
        { k: 'Recommended months between vet visits', ref: 'Shortens with stage, not with symptoms', v: age < 7 ? 12 : age <= 10 ? 6 : 4, format: 'unit', unit: 'months', extra: true },
      ];
      return {
        total: Math.round(human) + ' human years',
        sub: stage + ' · ' + advice,
        position: Math.min(100, (age / 20) * 100),
        positionLabel: stage + ' — ' + r1(age) + ' cat years, about ' + Math.round(human) + ' human',
        rows: rows,
        chart: [
          { label: 'Kitten', value: 1, from: 0, to: 1, tone: 'good' },
          { label: 'Young adult', value: 5, from: 1, to: 6, tone: 'main' },
          { label: 'Mature adult', value: 4, from: 6, to: 10, tone: 'prop' },
          { label: 'Senior', value: 10, from: 10, to: 20, tone: 'warn' },
        ],
      };
    });
  })();
</script>
