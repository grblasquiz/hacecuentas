---
/**
 * Hub EN — "How much should I feed this animal?"
 * audience="US" y lang="en" literales; el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  KG_PER_LB,
  G_PER_OZ,
  DOG_MER,
  CAT_MER,
  WET_KCAL_PER_G,
  RABBIT,
  FERRET,
  BIRD,
  TURTLE,
  GUINEA_PIG_VIT_C,
} from '../../../lib/hubs/en/how-much-to-feed-my-pet';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/en' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ KG_PER_LB, G_PER_OZ, DOG_MER, CAT_MER, WET_KCAL_PER_G, RABBIT, FERRET, BIRD, TURTLE, GUINEA_PIG_VIT_C }}
>
  (function () {
    const H = window.HC_HUB;
    const n0 = (x) => Math.round(x || 0).toLocaleString('en-US');
    const oz = (grams) => grams / G_PER_OZ;

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'dog';
      // v.weightlb / v.weightoz pueden ser 0 legítimamente: no usamos `|| default`.
      const lb = Math.max(0, Number.isFinite(v.weightlb) ? v.weightlb : 0);
      const kg = lb * KG_PER_LB;
      const smallOz = Math.max(0, Number.isFinite(v.weightoz) ? v.weightoz : 0);
      const smallG = smallOz * G_PER_OZ;

      if (id === 'cat') {
        const factor = CAT_MER[String(v.catstage || 'neutered')] ?? 1.2;
        const rer = 70 * Math.pow(kg, 0.75);
        const mer = rer * factor;
        const kcalPerG = Math.max(0.1, (Number.isFinite(v.kcalkg) ? v.kcalkg : 3500)) / 1000;
        const dryG = mer / kcalPerG;
        const wetG = mer / WET_KCAL_PER_G;
        const rows = [
          { k: 'Cat weight', ref: kg.toFixed(2) + ' kg', v: lb, format: 'unit', unit: 'lb', decimals: 1 },
          { k: 'Resting energy requirement', ref: '70 × kg^0.75', v: rer, format: 'unit', unit: 'kcal/day' },
          { k: 'Life-stage factor applied', ref: 'AAHA nutritional assessment', v: factor, format: 'plain', decimals: 2 },
          { k: 'Daily calories', ref: 'RER × factor', v: mer, format: 'unit', unit: 'kcal/day', extra: true },
          { k: 'Dry food', ref: n0(dryG) + ' g', v: oz(dryG), format: 'unit', unit: 'oz/day', decimals: 2, extra: true },
          { k: 'Wet food', ref: n0(wetG) + ' g — about 90 kcal per 100 g', v: oz(wetG), format: 'unit', unit: 'oz/day', decimals: 2, extra: true },
          { k: 'Half dry, half wet — the dry half', ref: 'Same calories, split down the middle', v: oz(dryG / 2), format: 'unit', unit: 'oz/day', decimals: 2 },
          { k: 'Half dry, half wet — the wet half', ref: 'Same calories, split down the middle', v: oz(wetG / 2), format: 'unit', unit: 'oz/day', decimals: 2 },
          { k: 'Energy density you entered', ref: 'Printed on the bag', v: Number.isFinite(v.kcalkg) ? v.kcalkg : 3500, format: 'unit', unit: 'kcal/kg' },
        ];
        return {
          total: oz(dryG).toFixed(1) + ' oz dry',
          sub:
            n0(mer) + ' kcal/day · or ' + oz(wetG).toFixed(1) + ' oz of wet food for the same calories · ' +
            'never crash-diet a cat — rapid weight loss can trigger hepatic lipidosis',
          rows: rows,
          chart: [
            { label: 'Resting energy (kcal)', value: Math.round(rer), tone: 'main' },
            { label: 'Life-stage surcharge (kcal)', value: Math.max(0, Math.round(mer - rer)), tone: 'good' },
          ],
        };
      }

      if (id === 'rabbit') {
        const key = String(v.rabbitstage || 'adult');
        const st = RABBIT[key] || RABBIT.adult;
        const hayG = kg * 30;
        const unlimited = st.pellets < 0;
        let pelletG = unlimited ? 0 : kg * st.pellets;
        if (!unlimited && st.cap !== null) pelletG = Math.min(pelletG, st.cap);
        const vegG = kg * st.veg;
        const fruitWeekG = kg * st.fruit;
        const rows = [
          { k: 'Rabbit weight', ref: kg.toFixed(2) + ' kg', v: lb, format: 'unit', unit: 'lb', decimals: 1 },
          { k: 'Hay, daily minimum', ref: n0(hayG) + ' g — offer it unlimited, this is a floor', v: oz(hayG), format: 'unit', unit: 'oz/day', decimals: 2, extra: true },
          { k: 'Hay type for this stage', ref: st.hay, v: 0, format: 'plain' },
          { k: 'Fresh greens', ref: vegG > 0 ? n0(vegG) + ' g' : 'Not yet — introduce vegetables at 12 weeks', v: oz(vegG), format: 'unit', unit: 'oz/day', decimals: 2, extra: true },
          { k: 'Pellets', ref: unlimited ? 'Unlimited while growing' : (st.cap !== null ? n0(pelletG) + ' g, capped at ' + st.cap + ' g/day' : n0(pelletG) + ' g'), v: oz(pelletG), format: 'unit', unit: 'oz/day', decimals: 2, extra: true },
          { k: 'Fruit, weekly ceiling', ref: fruitWeekG > 0 ? n0(fruitWeekG) + ' g/week' : 'None at this stage', v: oz(fruitWeekG), format: 'unit', unit: 'oz/week', decimals: 2 },
          { k: 'Hay as a share of the diet', ref: 'By volume, what a rabbit should actually eat', v: 80, format: 'unit', unit: '%' },
        ];
        return {
          total: unlimited ? 'Unlimited pellets' : oz(pelletG).toFixed(2) + ' oz pellets',
          sub:
            'Hay at least ' + oz(hayG).toFixed(1) + ' oz/day and unlimited · ' +
            (vegG > 0 ? oz(vegG).toFixed(1) + ' oz of greens · ' : 'no greens before 12 weeks · ') +
            'a rabbit that stops eating or stops passing droppings is an emergency',
          rows: rows,
          chart: [
            { label: 'Hay (oz)', value: Math.round(oz(hayG) * 100) / 100, tone: 'main' },
            { label: 'Greens (oz)', value: Math.round(oz(vegG) * 100) / 100, tone: 'good' },
            { label: 'Pellets (oz)', value: Math.round(oz(pelletG) * 100) / 100, tone: 'warn' },
          ],
        };
      }

      if (id === 'ferret') {
        const st = FERRET[String(v.ferretstage || 'adult')] || FERRET.adult;
        const foodG = kg * 1000 * st.intake;
        const proteinG = foodG * (st.protein / 100);
        const fatG = foodG * (st.fat / 100);
        const rows = [
          { k: 'Ferret weight', ref: kg.toFixed(3) + ' kg', v: lb, format: 'unit', unit: 'lb', decimals: 2 },
          { k: 'Life stage', ref: st.label, v: st.intake * 100, format: 'unit', unit: '% of body weight/day' },
          { k: 'Daily food', ref: foodG.toFixed(1) + ' g', v: oz(foodG), format: 'unit', unit: 'oz/day', decimals: 2, extra: true },
          { k: 'Minimum animal protein in that food', ref: st.protein + '% of the ration', v: oz(proteinG), format: 'unit', unit: 'oz/day', decimals: 2, extra: true },
          { k: 'Minimum fat', ref: st.fat + '% of the ration', v: oz(fatG), format: 'unit', unit: 'oz/day', decimals: 2 },
          { k: 'Minimum protein on the label', ref: 'Dry matter basis', v: st.protein, format: 'unit', unit: '%' },
          { k: 'Minimum fat on the label', ref: 'Dry matter basis', v: st.fat, format: 'unit', unit: '%' },
          { k: 'Gut transit time', ref: 'Why free-feeding is correct for this species', v: 3.5, format: 'unit', unit: 'hours', decimals: 1 },
        ];
        return {
          total: oz(foodG).toFixed(2) + ' oz/day',
          sub:
            st.intake * 100 + '% of body weight · at least ' + st.protein + '% animal protein and ' + st.fat + '% fat · ' +
            'grain, corn or fruit in the first three ingredients means the food is wrong for an obligate carnivore',
          rows: rows,
          chart: [
            { label: 'Animal protein (oz)', value: Math.round(oz(proteinG) * 100) / 100, tone: 'main' },
            { label: 'Fat (oz)', value: Math.round(oz(fatG) * 100) / 100, tone: 'good' },
            { label: 'Everything else (oz)', value: Math.max(0, Math.round(oz(foodG - proteinG - fatG) * 100) / 100), tone: 'warn' },
          ],
        };
      }

      if (id === 'bird') {
        const sp = BIRD[String(v.birdspecies || 'cockatiel')] || BIRD.cockatiel;
        const dailyG = smallG * sp.intake;
        const seedG = dailyG * sp.seed;
        const pelletG = dailyG * sp.pellet;
        const freshG = dailyG * (sp.veg + sp.fruit);
        const rows = [
          { k: 'Bird weight', ref: smallG.toFixed(1) + ' g', v: smallOz, format: 'unit', unit: 'oz', decimals: 2 },
          { k: 'Typical weight for this group', ref: sp.label, v: 0, format: 'plain' },
          { k: 'Daily intake', ref: sp.intake * 100 + '% of body weight — ' + dailyG.toFixed(1) + ' g', v: dailyG, format: 'unit', unit: 'g/day', decimals: 1, extra: true },
          { k: 'Seed', ref: Math.round(sp.seed * 100) + '% of the diet', v: seedG * 7, format: 'unit', unit: 'g/week', decimals: 1, extra: true },
          { k: 'Formulated pellets', ref: Math.round(sp.pellet * 100) + '% of the diet', v: pelletG * 7, format: 'unit', unit: 'g/week', decimals: 1, extra: true },
          { k: 'Fresh vegetables and fruit', ref: Math.round((sp.veg + sp.fruit) * 100) + '% of the diet', v: freshG * 7, format: 'unit', unit: 'g/week', decimals: 1 },
          { k: 'Seed per day', ref: 'The number that matters for a small bird', v: seedG, format: 'unit', unit: 'g/day', decimals: 2 },
          { k: 'Remove fresh food after', ref: 'Bacterial growth in a warm cage', v: 4, format: 'unit', unit: 'hours' },
        ];
        return {
          total: (seedG * 7).toFixed(1) + ' g seed/week',
          sub:
            sp.label + ' at ' + smallOz.toFixed(2) + ' oz · ' + Math.round(sp.seed * 100) + '% seed, ' +
            Math.round(sp.pellet * 100) + '% pellets, ' + Math.round((sp.veg + sp.fruit) * 100) + '% fresh · ' +
            'an all-seed diet is the classic cause of malnutrition in captive parrots',
          rows: rows,
          chart: [
            { label: 'Pellets (g/week)', value: Math.round(pelletG * 70) / 10, tone: 'main' },
            { label: 'Seed (g/week)', value: Math.round(seedG * 70) / 10, tone: 'warn' },
            { label: 'Fresh food (g/week)', value: Math.round(freshG * 70) / 10, tone: 'good' },
          ],
        };
      }

      if (id === 'turtle') {
        const age = Math.max(0, Number.isFinite(v.turtleage) ? v.turtleage : 0);
        let st = TURTLE[TURTLE.length - 1];
        for (let i = 0; i < TURTLE.length; i++) { if (age < TURTLE[i].maxAge) { st = TURTLE[i]; break; } }
        const dailyG = smallG * st.rate;
        const weeklyG = dailyG * st.sessions;
        const rows = [
          { k: 'Turtle weight', ref: smallG.toFixed(1) + ' g', v: smallOz, format: 'unit', unit: 'oz', decimals: 2 },
          { k: 'Life stage', ref: st.label, v: age, format: 'unit', unit: 'years', decimals: 1 },
          { k: 'Daily ration rate', ref: 'Fraction of body weight', v: st.rate * 100, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Per feeding session', ref: dailyG.toFixed(2) + ' g', v: dailyG, format: 'unit', unit: 'g', decimals: 2, extra: true },
          { k: 'Feeding sessions', ref: 'Begging is not hunger', v: st.sessions, format: 'unit', unit: 'per week', extra: true },
          { k: 'Weekly total', ref: 'What actually drives growth', v: weeklyG, format: 'unit', unit: 'g/week', decimals: 2 },
          { k: 'Animal protein share', ref: 'Pellets, bloodworms, feeder fish', v: st.protein, format: 'unit', unit: '%' },
          { k: 'Leafy greens and aquatic plants', ref: 'Rises steadily with age', v: st.veg, format: 'unit', unit: '%' },
        ];
        return {
          total: dailyG.toFixed(1) + ' g per feed',
          sub:
            st.label + ' · ' + st.sessions + ' feeds a week, ' + weeklyG.toFixed(1) + ' g total · ' +
            st.protein + '% protein and ' + st.veg + '% vegetation · ' +
            'no feeding plan prevents metabolic bone disease without working UVB',
          rows: rows,
          chart: [
            { label: 'Animal protein (%)', value: st.protein, tone: 'main' },
            { label: 'Vegetation (%)', value: st.veg, tone: 'good' },
          ],
        };
      }

      if (id === 'guineapig') {
        const st = GUINEA_PIG_VIT_C[String(v.gpstate || 'healthy')] || GUINEA_PIG_VIT_C.healthy;
        const gpKg = smallG / 1000;
        const mg = gpKg * st.mgkg;
        // Pimiento rojo ≈ 128 mg de vitamina C por 100 g; perejil ≈ 130 mg/100 g.
        const pepperG = mg > 0 ? (mg / 128) * 100 : 0;
        const parsleyG = mg > 0 ? (mg / 130) * 100 : 0;
        const rows = [
          { k: 'Guinea pig weight', ref: smallG.toFixed(0) + ' g', v: smallOz, format: 'unit', unit: 'oz', decimals: 2 },
          { k: 'Condition', ref: st.label, v: st.mgkg, format: 'unit', unit: 'mg/kg/day' },
          { k: 'Daily vitamin C', ref: gpKg.toFixed(3) + ' kg × ' + st.mgkg + ' mg/kg', v: mg, format: 'unit', unit: 'mg/day', decimals: 1, extra: true },
          { k: 'As fresh red bell pepper', ref: 'About 128 mg of vitamin C per 100 g', v: oz(pepperG), format: 'unit', unit: 'oz/day', decimals: 2, extra: true },
          { k: 'As fresh parsley', ref: 'About 130 mg per 100 g — feed sparingly, it is calcium-rich', v: oz(parsleyG), format: 'unit', unit: 'oz/day', decimals: 2 },
          { k: 'Therapeutic ceiling without a vet', ref: 'Beyond this the dose belongs to a veterinarian', v: 50, format: 'unit', unit: 'mg/kg/day' },
          { k: 'Days of storage before pellet vitamin C is unreliable', ref: 'Ascorbic acid degrades in the bag', v: 90, format: 'unit', unit: 'days' },
        ];
        return {
          total: mg.toFixed(1) + ' mg/day',
          sub:
            st.label + ' at ' + st.mgkg + ' mg/kg · about ' + oz(pepperG).toFixed(2) + ' oz of red bell pepper · ' +
            'guinea pigs cannot make their own vitamin C, so this is a daily requirement rather than a supplement',
          rows: rows,
          chart: [
            { label: 'Vitamin C needed (mg)', value: Math.round(mg * 10) / 10, tone: 'main' },
            { label: 'Headroom to the 50 mg/kg ceiling (mg)', value: Math.max(0, Math.round((gpKg * 50 - mg) * 10) / 10), tone: 'good' },
          ],
        };
      }

      if (id === 'medication') {
        const mgkg = Math.max(0, Number.isFinite(v.dosemgkg) ? v.dosemgkg : 0);
        const conc = Math.max(0, Number.isFinite(v.concentration) ? v.concentration : 0);
        const doses = Math.max(1, Math.round(Number.isFinite(v.dosesperday) ? v.dosesperday : 1));
        const mgTotal = kg * mgkg;
        const mlTotal = conc > 0 ? mgTotal / conc : 0;
        const mlPerDose = mlTotal / doses;
        const rows = [
          { k: 'Pet weight in pounds', ref: 'What you weighed', v: lb, format: 'unit', unit: 'lb', decimals: 1 },
          { k: 'The same weight in kilograms', ref: '1 lb = 0.45359237 kg — the dose is per kilogram', v: kg, format: 'unit', unit: 'kg', decimals: 3, extra: true },
          { k: 'Prescribed dose', ref: 'The figure from your veterinarian', v: mgkg, format: 'unit', unit: 'mg/kg', decimals: 2 },
          { k: 'Total per day', ref: 'kg × mg/kg', v: mgTotal, format: 'unit', unit: 'mg/day', decimals: 2, extra: true },
          { k: 'Bottle concentration', ref: conc > 0 ? 'Read off the bottle in your hand' : 'Not entered — tablets, or fill it in for millilitres', v: conc, format: 'unit', unit: 'mg/mL', decimals: 1 },
          { k: 'Volume per day', ref: conc > 0 ? 'Total mg ÷ concentration' : 'Needs a concentration', v: mlTotal, format: 'unit', unit: 'mL/day', decimals: 2, extra: true },
          { k: 'Volume in the syringe each time', ref: 'Split across ' + doses + (doses === 1 ? ' dose' : ' doses'), v: mlPerDose, format: 'unit', unit: 'mL', decimals: 2, extra: true },
          { k: 'Milligrams per dose', ref: 'If the product is tablets', v: mgTotal / doses, format: 'unit', unit: 'mg', decimals: 2 },
          { k: 'What the dose would be if you entered pounds as kilograms', ref: 'The classic overdose — 2.2× too much', v: lb * mgkg, format: 'unit', unit: 'mg/day', decimals: 2 },
        ];
        return {
          total: conc > 0 ? mlPerDose.toFixed(2) + ' mL per dose' : mgTotal.toFixed(1) + ' mg/day',
          sub:
            n0(mgTotal) + ' mg/day for ' + kg.toFixed(2) + ' kg at ' + mgkg + ' mg/kg' +
            (conc > 0 ? ' · ' + mlTotal.toFixed(2) + ' mL/day split into ' + doses : ' · enter the bottle concentration for millilitres') +
            ' · confirm every dose with your veterinarian before giving it',
          rows: rows,
          chart: [
            { label: 'Milligrams per dose', value: Math.round((mgTotal / doses) * 100) / 100, tone: 'main' },
            { label: 'Milligrams in the rest of the day', value: Math.max(0, Math.round((mgTotal - mgTotal / doses) * 100) / 100), tone: 'good' },
          ],
        };
      }

      // dog
      const factor = DOG_MER[String(v.dogstage || 'adult_neutered')] ?? 1.6;
      const rer = 70 * Math.pow(kg, 0.75);
      const mer = rer * factor;
      const kcalPerG = Math.max(0.1, (Number.isFinite(v.kcalkg) ? v.kcalkg : 3500)) / 1000;
      const grams = mer / kcalPerG;
      const rows = [
        { k: 'Dog weight', ref: kg.toFixed(2) + ' kg', v: lb, format: 'unit', unit: 'lb', decimals: 1 },
        { k: 'Resting energy requirement', ref: '70 × kg^0.75 (NRC allometric formula)', v: rer, format: 'unit', unit: 'kcal/day' },
        { k: 'Life-stage factor applied', ref: 'WSAVA / NRC maintenance multiplier', v: factor, format: 'plain', decimals: 2 },
        { k: 'Daily calories', ref: 'RER × factor', v: mer, format: 'unit', unit: 'kcal/day', extra: true },
        { k: 'Food energy density you entered', ref: 'Printed on every US bag', v: Number.isFinite(v.kcalkg) ? v.kcalkg : 3500, format: 'unit', unit: 'kcal/kg' },
        { k: 'Daily food', ref: n0(grams) + ' g', v: oz(grams), format: 'unit', unit: 'oz/day', decimals: 2, extra: true },
        { k: 'Low end of the band', ref: '15% below — start here if the dog is soft-bodied', v: oz(grams * 0.85), format: 'unit', unit: 'oz/day', decimals: 2 },
        { k: 'High end of the band', ref: '15% above', v: oz(grams * 1.15), format: 'unit', unit: 'oz/day', decimals: 2 },
        { k: 'Per meal on twice-a-day feeding', ref: 'Split it — it also lowers bloat risk', v: oz(grams / 2), format: 'unit', unit: 'oz', decimals: 2 },
      ];
      return {
        total: oz(grams).toFixed(1) + ' oz/day',
        sub:
          n0(mer) + ' kcal/day (RER ' + n0(rer) + ' × ' + factor + ') · band ' +
          oz(grams * 0.85).toFixed(1) + '–' + oz(grams * 1.15).toFixed(1) + ' oz · ' +
          'weigh the portion — the same cup of kibble varies by 20–30%',
        rows: rows,
        chart: [
          { label: 'Resting energy (kcal)', value: Math.round(rer), tone: 'main' },
          { label: 'Life-stage and activity surcharge (kcal)', value: Math.max(0, Math.round(mer - rer)), tone: 'good' },
        ],
      };
    });
  })();
</script>
