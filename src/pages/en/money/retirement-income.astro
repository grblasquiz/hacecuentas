---
/**
 * Decision hub EN — "Roth or traditional, and what will I actually live on?"
 * Replaces 11 loose calculator URLs (see hub.replaces).
 *
 * Every statutory constant is imported from src/lib/hubs/en/retirement-income.ts,
 * which re-exports src/lib/data/usa-2026.ts. Nothing is duplicated here.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, LIMITS, SS, IRMAA, RMD_TABLE, SENIOR_DEDUCTION } from '../../../lib/hubs/en/retirement-income';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ L: LIMITS, SS, IRMAA, RMD: RMD_TABLE, SENIOR: SENIOR_DEDUCTION }}>
  (function () {
    const H = window.HC_HUB;
    const usd = (n) => '$' + Math.round(n || 0).toLocaleString('en-US');

    /** SSA bend-point formula: 90% / 32% / 15% of the AIME slices. */
    function pia(aime) {
      const a = Math.max(0, aime || 0);
      const f = SS.piaFactors;
      return (
        f[0] * Math.min(a, SS.bendPoint1) +
        f[1] * Math.max(0, Math.min(a, SS.bendPoint2) - SS.bendPoint1) +
        f[2] * Math.max(0, a - SS.bendPoint2)
      );
    }

    /**
     * Claiming-age adjustment against the full retirement age.
     * Early: 5/9 of 1% per month for the first 36, then 5/12 of 1%.
     * Late: 8% a year of delayed retirement credits, capped at 70.
     */
    function claimFactor(claimAge) {
      const fra = SS.fullRetirementAge;
      const age = Math.min(SS.maxDelayAge, Math.max(SS.earlyClaimAge, claimAge));
      if (age >= fra) return 1 + (Math.min(age, SS.maxDelayAge) - fra) * SS.delayedCreditPerYear;
      const monthsEarly = (fra - age) * 12;
      const first = Math.min(36, monthsEarly);
      const rest = Math.max(0, monthsEarly - 36);
      return 1 - (first * (5 / 9) / 100) - (rest * (5 / 12) / 100);
    }

    /** RMD required beginning age, SECURE 2.0. */
    function rmdStartAge(birthYear) {
      if (birthYear >= 1960) return 75;
      if (birthYear >= 1951) return 73;
      return 72;
    }

    function irmaaTier(magi, mfj) {
      const th = mfj ? IRMAA.mfj : IRMAA.single;
      for (let i = 0; i < th.length; i++) if (magi <= th[i]) return i;
      return IRMAA.tiers.length - 1;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'contribute';
      const age = Math.max(18, Math.round(v.age || 55));
      const birthYear = Math.round(v.birthYear || 1971);
      const mfj = String(v.filing) === 'mfj';
      const contribution = Math.max(0, v.contribution || 0);
      const rateNow = Math.max(0, v.rateNow || 0) / 100;
      const rateLater = Math.max(0, v.rateLater || 0) / 100;
      const growth = Math.max(0, v.growthRate || 0) / 100;
      const yearsToRetire = Math.max(1, Math.round(v.yearsToRetire || 1));
      const balance = Math.max(0, v.balance || 0);
      const magi = Math.max(0, v.magi || 0);

      let total, sub, rows, chart;

      if (id === 'contribute') {
        const catchUp = age >= 60 && age <= 63 ? L.superCatchUp60_63 : age >= 50 ? L.catchUp50 : 0;
        const catchUpLabel = age >= 60 && age <= 63 ? 'enhanced catch-up, ages 60–63 (SECURE 2.0)' : age >= 50 ? 'standard catch-up, 50+' : 'no catch-up under 50';
        const deferral = L.deferralUnder50 + catchUp;
        const iraCatch = age >= 50 ? L.iraCatchUp50 : 0;
        const ira = L.iraLimit + iraCatch;
        const hsaBase = String(v.hsaCoverage) === 'family' ? L.hsaFamily : L.hsaSelfOnly;
        const hsa = hsaBase + (age >= 55 ? L.hsaCatchUp55 : 0);
        const allBuckets = deferral + ira + hsa;

        rows = [
          { k: '401(k) elective deferral limit', ref: 'IRS §402(g), Notice 2025-67', v: L.deferralUnder50, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Catch-up available at your age', ref: catchUpLabel, v: catchUp, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Your total 401(k) deferral limit', ref: 'Deferral plus catch-up', v: deferral, format: 'unit', unit: 'USD', decimals: 0, extra: true },
          { k: 'Combined employee plus employer cap', ref: 'IRS §415(c)', v: L.total415c, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'IRA limit — a completely separate bucket', ref: 'IRS §219(b)(5)' + (iraCatch > 0 ? ', including the 50+ catch-up' : ''), v: ira, format: 'unit', unit: 'USD', decimals: 0, extra: true },
          { k: 'HSA limit for ' + (String(v.hsaCoverage) === 'family' ? 'family' : 'self-only') + ' coverage', ref: 'IRS Rev. Proc. 2025-19' + (age >= 55 ? ', including the 55+ catch-up' : ''), v: hsa, format: 'unit', unit: 'USD', decimals: 0, extra: true },
          { k: 'Total you could shelter across all three', ref: 'Employee side only — employer match is on top', v: allBuckets, format: 'unit', unit: 'USD', decimals: 0, extra: true },
          { k: 'What you planned to contribute', ref: 'From the form', v: contribution, format: 'unit', unit: 'USD', decimals: 0 },
          { k: contribution < allBuckets ? 'Room you are leaving unused' : 'Amount over the combined limits', ref: 'Across 401(k), IRA and HSA', v: Math.abs(allBuckets - contribution), format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Immediate tax saved on a pre-tax contribution', ref: 'At your ' + (rateNow * 100).toFixed(0) + '% marginal rate', v: Math.min(contribution, allBuckets) * rateNow, format: 'unit', unit: 'USD', decimals: 0 },
        ];
        total = usd(allBuckets);
        sub =
          '401(k) ' + usd(deferral) + ' · IRA ' + usd(ira) + ' · HSA ' + usd(hsa) +
          ' — three separate buckets, ' + usd(allBuckets) + ' in total. ' + catchUpLabel + '.';
        chart = [
          { label: '401(k)', value: Math.round(deferral), tone: 'main' },
          { label: 'IRA', value: Math.round(ira), tone: 'good' },
          { label: 'HSA', value: Math.round(hsa), tone: 'prop' },
        ];
      } else if (id === 'roth') {
        const factor = Math.pow(1 + growth, yearsToRetire);
        // Traditional: the full amount goes in pre-tax, taxed on the way out.
        const tradGross = contribution * factor;
        const tradNet = tradGross * (1 - rateLater);
        const upfrontRefund = contribution * rateNow;
        const tradPlusInvestedRefund = tradNet + upfrontRefund * factor;
        // Roth: only the after-tax amount goes in, nothing taxed on the way out.
        const rothIn = contribution * (1 - rateNow);
        const rothNet = rothIn * factor;

        rows = [
          { k: 'Contribution', ref: 'The same headline amount either way', v: contribution, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Growth multiple over ' + yearsToRetire + ' years', ref: 'At ' + (growth * 100).toFixed(1) + '% a year', v: factor, format: 'unit', unit: '×', decimals: 2 },
          { k: 'Traditional: balance at retirement, before tax', ref: 'Full amount invested pre-tax', v: tradGross, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Traditional: what you keep after withdrawal tax', ref: 'Taxed at ' + (rateLater * 100).toFixed(0) + '% on the way out', v: tradNet, format: 'unit', unit: 'USD', decimals: 0, extra: true },
          { k: 'Traditional: the tax refund it generates today', ref: 'At your ' + (rateNow * 100).toFixed(0) + '% rate — only counts if you invest it', v: upfrontRefund, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Traditional plus the refund invested alongside', ref: 'The fair like-for-like comparison', v: tradPlusInvestedRefund, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Roth: after-tax amount actually invested', ref: 'Tax paid up front at ' + (rateNow * 100).toFixed(0) + '%', v: rothIn, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Roth: what you keep at retirement', ref: 'Nothing taxed on the way out', v: rothNet, format: 'unit', unit: 'USD', decimals: 0, extra: true },
          { k: rothNet >= tradNet ? 'Roth advantage' : 'Traditional advantage', ref: 'Comparing equal headline contributions', v: Math.abs(rothNet - tradNet), format: 'unit', unit: 'USD', decimals: 0, extra: true },
          { k: 'Break-even retirement tax rate', ref: 'Above this, Roth wins; below it, traditional wins', v: rateNow * 100, format: 'unit', unit: '%', decimals: 1, extra: true },
        ];
        total = usd(Math.max(rothNet, tradNet));
        sub =
          (rothNet > tradNet ? 'Roth' : rothNet < tradNet ? 'Traditional' : 'Neither') +
          ' comes out ahead by ' + usd(Math.abs(rothNet - tradNet)) + ' · they tie when your retirement rate equals today’s ' +
          (rateNow * 100).toFixed(0) + '% · Roth also has no lifetime RMD';
        chart = [
          { label: 'Roth, after tax', value: Math.round(rothNet), tone: 'good' },
          { label: 'Traditional, after tax', value: Math.round(tradNet), tone: 'main' },
          { label: 'Traditional + refund invested', value: Math.round(tradPlusInvestedRefund), tone: 'prop' },
        ];
      } else if (id === 'socialsecurity') {
        const aime = Math.max(0, v.aime || 0);
        const base = pia(aime);
        const claimAge = Math.min(SS.maxDelayAge, Math.max(SS.earlyClaimAge, Math.round(v.claimAge || SS.fullRetirementAge)));
        const at62 = base * claimFactor(SS.earlyClaimAge);
        const atFra = base;
        const at70 = base * claimFactor(SS.maxDelayAge);
        const yours = base * claimFactor(claimAge);
        const earned = Math.max(0, v.earnedIncome || 0);
        const overLimit = Math.max(0, earned - SS.earningsTestUnderFRA);
        const withheld = claimAge < SS.fullRetirementAge ? overLimit / 2 : 0;
        // Break-even of delaying to FRA against claiming at 62.
        const monthlyGain = atFra - at62;
        const forgone = at62 * (SS.fullRetirementAge - SS.earlyClaimAge) * 12;
        const breakEvenYears = monthlyGain > 0 ? forgone / (monthlyGain * 12) : 0;

        rows = [
          { k: 'Primary insurance amount at full retirement age', ref: '90/32/15 bend-point formula on an AIME of ' + usd(aime), v: base, format: 'unit', unit: 'USD per month', decimals: 0, extra: true },
          { k: 'Monthly benefit if you claim at 62', ref: 'About 30% below full retirement age, permanently', v: at62, format: 'unit', unit: 'USD per month', decimals: 0 },
          { k: 'Monthly benefit at full retirement age (' + SS.fullRetirementAge + ')', ref: 'Born 1960 or later', v: atFra, format: 'unit', unit: 'USD per month', decimals: 0 },
          { k: 'Monthly benefit if you delay to 70', ref: (SS.delayedCreditPerYear * 100) + '% a year in delayed credits', v: at70, format: 'unit', unit: 'USD per month', decimals: 0 },
          { k: 'Your benefit claiming at ' + claimAge, ref: 'Before tax and before Medicare deductions', v: yours, format: 'unit', unit: 'USD per month', decimals: 0, extra: true },
          { k: 'That benefit over a year', ref: '12 monthly payments', v: yours * 12, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Next COLA already announced', ref: 'SSA cost-of-living adjustment', v: SS.cola * 100, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Your benefit after that COLA', ref: 'Applied to the monthly figure', v: yours * (1 + SS.cola), format: 'unit', unit: 'USD per month', decimals: 0 },
          { k: 'Earnings test limit before full retirement age', ref: '$1 withheld per $2 over the limit', v: SS.earningsTestUnderFRA, format: 'unit', unit: 'USD per year', decimals: 0 },
          { k: 'Benefit withheld by the earnings test', ref: withheld > 0 ? 'Credited back after full retirement age — not lost' : 'Not applicable at your claiming age', v: withheld, format: 'unit', unit: 'USD per year', decimals: 0 },
          { k: 'Years of the higher benefit needed to break even on delaying', ref: 'Delaying from 62 to ' + SS.fullRetirementAge, v: breakEvenYears, format: 'unit', unit: 'years', decimals: 1, extra: true },
          { k: 'Age at which delaying overtakes claiming at 62', ref: 'Longevity beyond this favours waiting', v: SS.fullRetirementAge + breakEvenYears, format: 'unit', unit: 'years old', decimals: 1, extra: true },
          { k: 'Maximum earnings subject to Social Security tax', ref: 'The wage base for this year', v: SS.maxTaxableEarnings, format: 'unit', unit: 'USD', decimals: 0 },
        ];
        total = usd(yours) + '/mo';
        sub =
          'Claiming at ' + claimAge + ' pays ' + usd(yours) + ' a month · ' + usd(at62) + ' at 62, ' + usd(atFra) +
          ' at ' + SS.fullRetirementAge + ', ' + usd(at70) + ' at 70 · delaying breaks even around age ' +
          (SS.fullRetirementAge + breakEvenYears).toFixed(0);
        chart = [
          { label: 'Claim at 62', value: Math.round(at62), tone: 'warn' },
          { label: 'Claim at ' + SS.fullRetirementAge, value: Math.round(atFra), tone: 'main' },
          { label: 'Claim at 70', value: Math.round(at70), tone: 'good' },
        ];
      } else if (id === 'rmd') {
        const startAge = rmdStartAge(birthYear);
        const tableAge = Math.min(120, Math.max(72, age));
        const factor = RMD[tableAge] || RMD[120];
        const required = age >= startAge ? balance / factor : 0;
        const pctRequired = balance > 0 ? (required / balance) * 100 : 0;
        const payoutRate = Math.max(0, v.payoutRate || 0) / 100;
        const annuityMonthly = (balance * payoutRate) / 12;
        const factorAt85 = RMD[85];

        rows = [
          { k: 'Age your RMDs must begin', ref: 'SECURE 2.0, by birth year ' + birthYear, v: startAge, format: 'unit', unit: 'years old', decimals: 0, extra: true },
          { k: age >= startAge ? 'Years you have been subject to RMDs' : 'Years until RMDs start', ref: 'Counted from your current age', v: Math.abs(age - startAge), format: 'unit', unit: 'years', decimals: 0 },
          { k: 'Life-expectancy factor at age ' + tableAge, ref: 'IRS Uniform Lifetime Table, Pub. 590-B', v: factor, format: 'unit', unit: '', decimals: 1 },
          { k: 'Required minimum distribution this year', ref: age >= startAge ? 'Prior year-end balance ÷ the factor' : 'Not yet required at your age', v: required, format: 'unit', unit: 'USD', decimals: 0, extra: true },
          { k: 'That as a share of the balance', ref: 'Rises every year as the factor falls', v: pctRequired, format: 'unit', unit: '%', decimals: 2, extra: true },
          { k: 'Monthly, if you spread it evenly', ref: 'The RMD is annual — the schedule is yours', v: required / 12, format: 'unit', unit: 'USD per month', decimals: 0 },
          { k: 'What the same balance would require at 85', ref: 'Factor ' + factorAt85 + ' — the percentage keeps climbing', v: balance / factorAt85, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Penalty if you miss it', ref: '25% of the shortfall, 10% if corrected promptly', v: required * 0.25, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Annuity income from the same balance', ref: 'At a ' + (payoutRate * 100).toFixed(1) + '% quoted payout rate', v: annuityMonthly, format: 'unit', unit: 'USD per month', decimals: 0, extra: true },
          { k: 'Annuity income over a year', ref: 'Includes your own capital coming back — not a return', v: annuityMonthly * 12, format: 'unit', unit: 'USD', decimals: 0 },
          { k: 'Difference between the annuity and the RMD', ref: 'The annuity pays more but you give up the balance', v: annuityMonthly * 12 - required, format: 'unit', unit: 'USD per year', decimals: 0 },
        ];
        total = usd(required);
        sub =
          'RMDs begin at ' + startAge + ' for someone born in ' + birthYear + ' · this year requires ' + usd(required) +
          ' (' + pctRequired.toFixed(2) + '% of the balance) · the same money as an annuity would pay ' + usd(annuityMonthly) + ' a month';
        chart = [
          { label: 'Required distribution', value: Math.round(required), tone: 'warn' },
          { label: 'Annuity income, one year', value: Math.round(annuityMonthly * 12), tone: 'main' },
          { label: 'Required at age 85', value: Math.round(balance / factorAt85), tone: 'bad' },
        ];
      } else {
        const tier = irmaaTier(magi, mfj);
        const t = IRMAA.tiers[tier];
        const base = IRMAA.tiers[0];
        const monthly = t.partB + t.partD;
        const surcharge = monthly - base.partB;
        const th = mfj ? IRMAA.mfj : IRMAA.single;
        const nextThreshold = tier < th.length ? th[tier] : null;
        const seniorPhaseout = mfj ? SENIOR.phaseoutMfj : SENIOR.phaseoutSingle;
        const seniorRaw = age >= 65 ? SENIOR.perPerson * (mfj ? 2 : 1) : 0;
        const seniorReduction = Math.max(0, magi - seniorPhaseout) * SENIOR.phaseoutRate;
        const senior = Math.max(0, seniorRaw - seniorReduction);

        rows = [
          { k: 'Your IRMAA bracket', ref: 'Based on income from two years ago, not this year', v: tier, format: 'unit', unit: 'of ' + (IRMAA.tiers.length - 1), decimals: 0, extra: true },
          { k: 'Medicare Part B premium', ref: tier === 0 ? 'Standard premium — no surcharge' : 'Includes the income-related surcharge', v: t.partB, format: 'unit', unit: 'USD per month', decimals: 2, extra: true },
          { k: 'Part D surcharge', ref: 'Paid on top of whatever your drug plan charges', v: t.partD, format: 'unit', unit: 'USD per month', decimals: 2 },
          { k: 'Total Medicare cost per month', ref: 'Part B plus the Part D surcharge', v: monthly, format: 'unit', unit: 'USD per month', decimals: 2, extra: true },
          { k: 'Over a year', ref: '12 months of premiums', v: monthly * 12, format: 'unit', unit: 'USD', decimals: 2 },
          { k: 'Standard premium with no surcharge', ref: 'What someone below the first threshold pays', v: base.partB, format: 'unit', unit: 'USD per month', decimals: 2 },
          { k: 'What IRMAA is costing you a year', ref: 'Against the standard premium', v: surcharge * 12, format: 'unit', unit: 'USD', decimals: 2, extra: true },
          {
            k: nextThreshold ? 'Income headroom before the next bracket' : 'You are in the top bracket',
            ref: nextThreshold ? 'IRMAA is a cliff — one dollar over moves the whole year' : 'No further step above this',
            v: nextThreshold ? Math.max(0, nextThreshold - magi) : 0,
            format: 'unit',
            unit: 'USD',
            decimals: 0,
            extra: true,
          },
          { k: 'Senior bonus deduction at 65+', ref: age >= 65 ? 'OBBBA, tax years 2025–2028 only' : 'Not available under 65', v: senior, format: 'unit', unit: 'USD', decimals: 0, extra: true },
          { k: 'Phase-out already applied to it', ref: (SENIOR.phaseoutRate * 100) + '% of income over ' + usd(seniorPhaseout), v: seniorReduction, format: 'unit', unit: 'USD', decimals: 0 },
        ];
        total = usd(monthly) + '/mo';
        sub =
          'Bracket ' + tier + ' of ' + (IRMAA.tiers.length - 1) + ' at ' + usd(magi) + ' MAGI · ' + usd(monthly) +
          ' a month, ' + usd(surcharge * 12) + ' a year above the standard premium' +
          (nextThreshold ? ' · ' + usd(Math.max(0, nextThreshold - magi)) + ' of headroom before the next cliff' : '');
        chart = [
          { label: 'Standard Part B premium', value: Math.round(base.partB), tone: 'good' },
          { label: 'Your Part B premium', value: Math.round(t.partB), tone: 'main' },
          { label: 'Your Part D surcharge', value: Math.round(t.partD), tone: 'warn' },
        ];
      }

      return { total: total, sub: sub, rows: rows, chart: chart, format: 'unit', unit: 'USD', decimals: 0 };
    });
  })();
</script>
