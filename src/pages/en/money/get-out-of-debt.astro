---
/**
 * Decision hub EN/US — "What's the fastest, cheapest way to clear my debt?"
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, CAR_LOAN, STD_DEDUCTION, BRACKETS } from '../../../lib/hubs/en/get-out-of-debt';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ CAR_LOAN, STD_DEDUCTION, BRACKETS }}>
  (function () {
    const H = window.HC_HUB;
    const usd = (n) => '$' + Math.round(Number(n) || 0).toLocaleString('en-US');
    const USD = { format: 'unit', unit: 'USD' };
    const MAX_MONTHS = 600;

    function monthsToText(m) {
      const y = Math.floor(m / 12);
      const mo = Math.round(m % 12);
      if (y <= 0) return mo + (mo === 1 ? ' month' : ' months');
      if (mo === 0) return y + (y === 1 ? ' year' : ' years');
      return y + ' yr ' + mo + ' mo';
    }

    /** Marginal federal rate for a taxable income — mirrors marginalRate2026(). */
    function marginalRate(taxable, status) {
      const b = BRACKETS[status] || BRACKETS.single;
      let rate = b[0][1];
      for (let k = 0; k < b.length; k++) if (taxable > b[k][0]) rate = b[k][1];
      return rate;
    }

    function pmt(principal, annualRatePct, months) {
      if (principal <= 0 || months <= 0) return 0;
      const r = annualRatePct / 100 / 12;
      if (r === 0) return principal / months;
      const f = Math.pow(1 + r, months);
      return (principal * r * f) / (f - 1);
    }

    /** Avalanche/snowball simulation. Mirrors simulate() of debt-avalanche-payoff-calculator.ts. */
    function simulate(debts, extra, byHighestApr) {
      const bal = debts.map((d) => d.balance);
      const rates = debts.map((d) => d.apr / 100 / 12);
      let interest = 0;
      let months = 0;
      const order = [];
      const cleared = debts.map(() => false);

      while (months < MAX_MONTHS) {
        if (bal.every((b) => b <= 0.005)) break;
        months++;

        // Minimums freed by cleared debts roll into the extra pool.
        let pool = extra;
        for (let k = 0; k < debts.length; k++) if (bal[k] <= 0.005) pool += debts[k].min;

        const active = [];
        for (let k = 0; k < debts.length; k++) if (bal[k] > 0.005) active.push(k);
        active.sort((a, z) =>
          byHighestApr
            ? debts[z].apr - debts[a].apr || bal[z] - bal[a]
            : bal[a] - bal[z] || debts[z].apr - debts[a].apr
        );
        const target = active.length ? active[0] : -1;

        for (let k = 0; k < debts.length; k++) {
          if (bal[k] <= 0.005) { bal[k] = 0; continue; }
          const int = bal[k] * rates[k];
          interest += int;
          let pay = debts[k].min + (k === target ? pool : 0);
          const owed = bal[k] + int;
          if (pay >= owed) {
            bal[k] = 0;
            if (!cleared[k]) { cleared[k] = true; order.push(debts[k].name + ' (month ' + months + ')'); }
          } else {
            bal[k] = owed - pay;
          }
        }
      }
      return { interest: interest, months: months, order: order };
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'minimum';
      const balance = Math.max(0, v.balance || 0);
      const apr = Math.max(0, v.apr || 0);
      const fixedPay = Math.max(0, v.monthly_payment || 0);
      const minPct = Math.max(0.1, v.min_percent || 2);
      const minFloor = Math.max(0, v.min_floor || 0);
      const d2bal = Math.max(0, v.debt2_balance || 0);
      const d2apr = Math.max(0, v.debt2_apr || 0);
      const d2min = Math.max(0, v.debt2_min || 0);
      const extra = Math.max(0, v.extra_payment || 0);
      const loanYears = Math.max(1, v.loan_years || 4);
      const status = v.filing_status === 'mfj' ? 'mfj' : v.filing_status === 'hoh' ? 'hoh' : 'single';
      const magi = Math.max(0, v.magi || 0);

      const r = apr / 100 / 12;
      const firstInterest = balance * r;

      // ───────────────────── Minimum payments only ─────────────────────
      if (id === 'minimum') {
        let bal = balance;
        let paid = 0;
        let months = 0;
        let firstPayment = 0;
        while (bal > 0.005 && months < MAX_MONTHS) {
          months++;
          const int = bal * r;
          const required = Math.max(bal * (minPct / 100) + int, minFloor);
          const pay = Math.min(required, bal + int);
          if (months === 1) firstPayment = pay;
          if (pay <= int + 0.005) { months = MAX_MONTHS; paid = Infinity; break; }
          bal = bal + int - pay;
          paid += pay;
        }
        const never = !isFinite(paid) || months >= MAX_MONTHS;
        const interest = never ? Infinity : paid - balance;

        const rows = [
          { k: 'Starting balance', v: balance, ...USD },
          { k: 'APR', ref: 'Purchase rate on the statement', v: apr, format: 'unit', unit: '%', decimals: 2 },
          { k: 'Interest charged in month one', ref: 'Balance × APR ÷ 12', v: firstInterest, ...USD, decimals: 2 },
          { k: 'Minimum required in month one', ref: minPct + '% of balance + interest, floor $' + minFloor, v: firstPayment, ...USD, decimals: 2 },
          { k: 'Principal actually repaid in month one', ref: 'Minimum minus interest', v: Math.max(0, firstPayment - firstInterest), ...USD, decimals: 2 },
          { k: 'Months of minimum payments', ref: never ? 'Never clears at this minimum' : monthsToText(months), v: never ? MAX_MONTHS : months, format: 'unit', unit: 'months', extra: true },
          { k: 'Total interest paid', ref: 'Over the whole run', v: never ? 0 : interest, ...USD, extra: true },
          { k: 'Total handed to the issuer', ref: 'Principal + interest', v: never ? 0 : paid, ...USD },
          { k: 'Interest as a share of what you borrowed', v: never || balance <= 0 ? 0 : (interest / balance) * 100, format: 'unit', unit: '%', decimals: 1 },
          { k: 'What a fixed ' + usd(fixedPay) + '/mo would cost instead', ref: 'Switch to the fixed-payment case to see it', v: fixedPay, ...USD },
        ];

        return {
          total: never ? 'Never clears' : usd(interest),
          sub: never
            ? 'At this minimum the payment never exceeds the interest — the balance grows instead of falling.'
            : 'Minimum only: ' + monthsToText(months) + ' and ' + usd(interest) + ' of interest on a ' + usd(balance) + ' balance.',
          rows: rows,
          chart: [
            { label: 'What you borrowed', value: Math.round(balance), tone: 'main' },
            { label: 'Interest on top', value: never ? 0 : Math.round(interest), tone: 'bad' },
          ],
        };
      }

      // ───────────────────── Fixed monthly payment ─────────────────────
      if (id === 'fixed') {
        const tooLow = fixedPay <= firstInterest + 0.005 && r > 0;
        let bal = balance;
        let paid = 0;
        let months = 0;
        if (!tooLow) {
          while (bal > 0.005 && months < MAX_MONTHS) {
            months++;
            const int = bal * r;
            const pay = Math.min(fixedPay, bal + int);
            bal = bal + int - pay;
            paid += pay;
          }
        }
        const interest = tooLow ? 0 : paid - balance;

        // What the same balance would cost on minimums, for the comparison row.
        let mBal = balance, mPaid = 0, mMonths = 0;
        while (mBal > 0.005 && mMonths < MAX_MONTHS) {
          mMonths++;
          const int = mBal * r;
          const req = Math.max(mBal * (minPct / 100) + int, minFloor);
          if (req <= int + 0.005) { mMonths = MAX_MONTHS; mPaid = 0; break; }
          const pay = Math.min(req, mBal + int);
          mBal = mBal + int - pay;
          mPaid += pay;
        }
        const minInterest = mPaid > 0 ? mPaid - balance : 0;

        const rows = [
          { k: 'Starting balance', v: balance, ...USD },
          { k: 'Fixed payment you commit to', ref: 'Same amount every month', v: fixedPay, ...USD, decimals: 2 },
          { k: 'Interest charged in month one', ref: 'Your payment must beat this', v: firstInterest, ...USD, decimals: 2 },
          { k: 'Months to zero', ref: tooLow ? 'Payment too low — balance grows' : monthsToText(months), v: tooLow ? 0 : months, format: 'unit', unit: 'months', extra: true },
          { k: 'Total interest at this payment', v: interest, ...USD, extra: true },
          { k: 'Total paid', ref: 'Principal + interest', v: tooLow ? 0 : paid, ...USD },
          { k: 'Total interest if you paid only the minimum', ref: mMonths >= MAX_MONTHS ? 'Never clears' : monthsToText(mMonths), v: minInterest, ...USD },
          { k: 'Interest saved by fixing the payment', ref: 'The value of not letting it shrink', v: Math.max(0, minInterest - interest), ...USD, extra: true },
          { k: 'Months saved versus the minimum', v: mMonths >= MAX_MONTHS ? 0 : Math.max(0, mMonths - months), format: 'unit', unit: 'months' },
        ];

        return {
          total: tooLow ? 'Payment too low' : usd(interest),
          sub: tooLow
            ? 'At ' + apr + '% the first month alone costs ' + usd(firstInterest) + ' — a ' + usd(fixedPay) + ' payment never clears the balance.'
            : 'Clear in ' + monthsToText(months) + ' for ' + usd(interest) + ' of interest — ' + usd(Math.max(0, minInterest - interest)) + ' less than minimum payments.',
          rows: rows,
          chart: [
            { label: 'What you borrowed', value: Math.round(balance), tone: 'main' },
            { label: 'Interest at this payment', value: Math.max(0, Math.round(interest)), tone: 'warn' },
            { label: 'Interest avoided vs minimums', value: Math.max(0, Math.round(minInterest - interest)), tone: 'good' },
          ],
        };
      }

      // ───────────────────── Avalanche vs snowball ─────────────────────
      if (id === 'avalanche') {
        const debts = [
          { name: 'Debt 1', balance: balance, apr: apr, min: Math.max(fixedPay, Math.max(balance * (minPct / 100), minFloor)) },
        ];
        if (d2bal > 0) debts.push({ name: 'Debt 2', balance: d2bal, apr: d2apr, min: d2min });

        const av = simulate(debts.map((d) => ({ ...d })), extra, true);
        const sn = simulate(debts.map((d) => ({ ...d })), extra, false);
        const saved = sn.interest - av.interest;
        const totalBalance = debts.reduce((a, d) => a + d.balance, 0);
        const totalMin = debts.reduce((a, d) => a + d.min, 0);

        const rows = [
          { k: 'Total debt', ref: debts.length + (debts.length === 1 ? ' balance' : ' balances'), v: totalBalance, ...USD },
          { k: 'Minimum payments combined', ref: 'What you must pay no matter what', v: totalMin, ...USD, decimals: 2 },
          { k: 'Extra you add on top', ref: 'All of it goes to the target debt', v: extra, ...USD },
          { k: 'Highest APR in the pile', ref: 'The avalanche target', v: Math.max(apr, d2bal > 0 ? d2apr : 0), format: 'unit', unit: '%', decimals: 2 },
          { k: 'Avalanche — months to debt free', ref: monthsToText(av.months), v: av.months, format: 'unit', unit: 'months' },
          { k: 'Avalanche — total interest', ref: 'Highest APR first', v: av.interest, ...USD, extra: true },
          { k: 'Snowball — months to debt free', ref: monthsToText(sn.months), v: sn.months, format: 'unit', unit: 'months' },
          { k: 'Snowball — total interest', ref: 'Smallest balance first', v: sn.interest, ...USD },
          { k: 'Interest avalanche saves', ref: saved < 1 ? 'Both methods clear in the same order here' : 'Pure arithmetic difference', v: Math.max(0, saved), ...USD, extra: true },
          { k: 'Months avalanche saves', v: Math.max(0, sn.months - av.months), format: 'unit', unit: 'months' },
          { k: 'Total you hand over under avalanche', ref: 'Principal + interest', v: totalBalance + av.interest, ...USD },
        ];

        return {
          total: usd(av.interest),
          sub:
            'Avalanche clears everything in ' + monthsToText(av.months) + ' for ' + usd(av.interest) +
            ' of interest' + (saved >= 1 ? ' — ' + usd(saved) + ' less than snowball' : ' — same as snowball with these balances') +
            (av.order.length ? ' · order: ' + av.order.join(', ') : ''),
          rows: rows,
          chart: [
            { label: 'Principal', value: Math.round(totalBalance), tone: 'main' },
            { label: 'Interest under avalanche', value: Math.round(av.interest), tone: 'warn' },
            { label: 'Extra interest snowball would cost', value: Math.max(0, Math.round(saved)), tone: 'bad' },
          ],
        };
      }

      // ───────────────────────── Car loan ─────────────────────────
      const loanMonths = Math.round(loanYears * 12);
      const carPay = pmt(balance, apr, loanMonths);
      const carInterest = carPay * loanMonths - balance;
      const yearOneInterest = (function () {
        let b = balance, acc = 0;
        for (let m = 0; m < Math.min(12, loanMonths); m++) {
          const int = b * r;
          acc += int;
          b = b + int - carPay;
        }
        return acc;
      })();

      // OBBBA deduction — constants from src/lib/data/usa-2026.ts, never from memory.
      const eligible = Math.min(yearOneInterest, CAR_LOAN.cap);
      const threshold = CAR_LOAN.phaseoutStart[status];
      const excess = Math.max(0, magi - threshold);
      const reduction = Math.round(excess * (CAR_LOAN.reductionPer1000 / 1000) * 100) / 100;
      const deduction = Math.max(0, Math.round((eligible - reduction) * 100) / 100);
      const taxableProxy = Math.max(0, magi - STD_DEDUCTION[status]);
      const mr = marginalRate(taxableProxy, status);
      const taxSaved = Math.round(deduction * mr * 100) / 100;
      const netInterest = Math.max(0, yearOneInterest - taxSaved);

      const rows = [
        { k: 'Car loan balance', v: balance, ...USD },
        { k: 'APR', v: apr, format: 'unit', unit: '%', decimals: 2 },
        { k: 'Monthly payment', ref: loanYears + '-year term', v: carPay, ...USD, decimals: 2 },
        { k: 'Interest over the remaining term', ref: 'What the loan costs you in total', v: carInterest, ...USD },
        { k: 'Interest you will pay in the next 12 months', ref: 'Front-loaded — highest at the start', v: yearOneInterest, ...USD, extra: true },
        { k: 'Deductible after the annual cap', ref: 'Cap $' + CAR_LOAN.cap.toLocaleString('en-US') + ' · OBBBA', v: eligible, ...USD },
        { k: 'Cut by the MAGI phase-out', ref: '$' + CAR_LOAN.reductionPer1000 + ' per $1,000 over $' + threshold.toLocaleString('en-US'), v: reduction, ...USD },
        { k: 'Deduction you can actually claim', ref: 'No need to itemize', v: deduction, ...USD, extra: true },
        { k: 'Your marginal federal rate', ref: 'Applied to the deduction', v: mr * 100, format: 'unit', unit: '%', decimals: 0 },
        { k: 'Federal tax the deduction saves', v: taxSaved, ...USD },
        { k: 'Net interest cost after the deduction', ref: 'Year-one interest minus the tax saving', v: netInterest, ...USD, extra: true },
      ];

      return {
        total: usd(netInterest),
        sub:
          deduction > 0
            ? 'Year-one interest ' + usd(yearOneInterest) + ', deduction ' + usd(deduction) + ', tax saved ' + usd(taxSaved) +
              ' — only if the car is new, personal-use and U.S.-assembled.'
            : 'Your MAGI of ' + usd(magi) + ' phases the deduction out entirely: the full ' + usd(yearOneInterest) + ' of interest is a plain cost.',
        rows: rows,
        chart: [
          { label: 'Interest you bear', value: Math.round(netInterest), tone: 'warn' },
          { label: 'Interest offset by the deduction', value: Math.round(taxSaved), tone: 'good' },
          { label: 'Principal still owed', value: Math.round(balance), tone: 'main' },
        ],
      };
    });
  })();
</script>
