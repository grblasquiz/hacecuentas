---
/**
 * Silo Home & Building · mercado US — índice de hubs de decisión.
 * Existe para que el breadcrumb de los hubs ingleses no apunte a un 404 y para
 * repartir link equity entre hermanos. El listado sale del registry, no a mano.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';

const HREF = '/en/home';
const SILO = 'Home & Building';
const LEDE =
  'Sizing and take-off calculators for the house itself: paint, tile and plaster quantities, concrete and rebar, AC and heating capacity, water heaters and pipe sizes, wire gauge and solar panels, decking, stairs and cabinet cuts. Imperial units, US codes, and the metric equivalent alongside every number.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: SILO,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title="Home & building calculators — paint, concrete, HVAC, wiring | Hacé Cuentas"
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
