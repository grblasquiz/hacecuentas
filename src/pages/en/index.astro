---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EnglishHomeExperience from '../../components/generated/EnglishHomeExperience.astro';
import LocaleHubEditorial from '../../components/LocaleHubEditorial.astro';
import BingPriorityLinks from '../../components/BingPriorityLinks.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
const canonical='https://hacecuentas.com/en';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Hacé Cuentas in English",url:canonical,operatingSystem:'Web'};
---
<Layout title="Hacé Cuentas in English | Hacé Cuentas" description="Hacé Cuentas in English. Herramienta clara, gratuita y actualizada." canonical={canonical} schema={schema} lang="en" hreflang={HOME_HREFLANG}>
  <Header />
  <EnglishHomeExperience />
  <BingPriorityLinks title="Practical family and pet planning" items={[{href:'/en/family/baby-and-child-milestones',title:'Baby and child milestones',description:'Sleep, teeth, screen time, growth and age-based milestones.'},{href:'/en/pets/dog-lifestyle-and-costs',title:'Dog lifestyle and costs',description:'Walking, shedding, apartment fit and first-year ownership costs.'}]} />
  <LocaleHubEditorial locale="en" />
  <Footer />
</Layout>
