---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import PillarHub from '../../components/PillarHub.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
import { ES_TOTAL_DISPLAY_EN } from '../../lib/calc-counts';

// Load all English calculators
const calcModules = import.meta.glob<any>('../../content/calcs-en/*.json', { eager: true });
const calcs = Object.values(calcModules).map((m: any) => m.default || m);

// Group by category
const byCategory: Record<string, any[]> = {};
calcs.forEach((c) => {
  if (!byCategory[c.category]) byCategory[c.category] = [];
  byCategory[c.category].push(c);
});

// English-friendly category metadata
const categoryMeta: Record<string, { label: string; desc: string; color: string; icon: string }> = {
  finanzas:        { label: 'Finance',       desc: 'Salary, severance, loans, taxes, compound interest.',    color: '#2563eb', icon: '💰' },
  salud:           { label: 'Health',        desc: 'BMI, calories, body fat, pregnancy, fitness.',            color: '#16a34a', icon: '❤️' },
  negocios:        { label: 'Business',      desc: 'Margins, VAT, markup, break-even, pricing.',              color: '#7c3aed', icon: '📊' },
  marketing:       { label: 'Marketing',     desc: 'CTR, CPC, ROAS, CAC, LTV, MRR, churn.',                  color: '#e11d48', icon: '📈' },
  vida:            { label: 'Daily Life',    desc: 'Age, dates, percentages, rule of three, converters.',     color: '#d97706', icon: '🗓️' },
  deportes:        { label: 'Sports',        desc: 'Pace, 1RM, calories burned, running, strength training.', color: '#65a30d', icon: '🏃' },
  viajes:          { label: 'Travel',        desc: 'Fuel costs, trip budgets, expense splitting, tips.',      color: '#0891b2', icon: '✈️' },
  construccion:    { label: 'Construction',  desc: 'Bricks, cement, paint, flooring estimates.',              color: '#b45309', icon: '🧱' },
  cocina:          { label: 'Cooking',       desc: 'Cups to grams, recipe scaling, cooking conversions.',     color: '#ea580c', icon: '🍳' },
  mascotas:        { label: 'Pets',          desc: 'Dog/cat age, feeding, medication by weight.',             color: '#db2777', icon: '🐕' },
  matematica:      { label: 'Math',          desc: 'Average, Pythagoras, quadratic, factorial, GCD.',         color: '#0d9488', icon: '🧮' },
  educacion:       { label: 'Education',     desc: 'Grades, averages, credits, scholarships.',                color: '#8b5cf6', icon: '🎓' },
  automotor:       { label: 'Automotive',    desc: 'Fuel consumption, insurance, registration fees.',         color: '#6366f1', icon: '🚗' },
  tecnologia:      { label: 'Technology',    desc: 'Storage, bandwidth, battery, FPS, cloud costs.',          color: '#06b6d4', icon: '💻' },
  'medio-ambiente':{ label: 'Environment',  desc: 'Carbon footprint, recycling, water, solar energy.',       color: '#22c55e', icon: '🌱' },
  electronica:     { label: 'Electronics',  desc: "Ohm's law, resistors, kWh consumption, circuits.",        color: '#f59e0b', icon: '⚡' },
};

// Show categories that have at least one English calc, in a sensible order
const categoryOrder = ['finanzas', 'salud', 'negocios', 'marketing', 'vida', 'deportes', 'viajes',
  'construccion', 'cocina', 'mascotas', 'matematica', 'educacion', 'automotor', 'tecnologia',
  'medio-ambiente', 'electronica'];

const activeCategories = categoryOrder.filter((cat) => byCategory[cat] && byCategory[cat].length > 0);

const totalCalcs = calcs.length;

// Featured: niche calculators with a clear search gap (curated from the
// EN long-tail triage). Early position in the HTML = internal link priority.
const FEATURED: Array<{ slug: string; label: string }> = [
  { slug: 'premature-infant-corrected-age', label: 'Corrected age calculator for premature babies' },
  { slug: 'dog-food-calculator-by-weight', label: 'How much to feed a dog per day, by weight' },
  { slug: 'pizzas-by-guests', label: 'How many pizzas do I need for a party?' },
  { slug: 'bbq-meat-portions-per-person', label: 'How much meat per person for a BBQ' },
  { slug: 'rice-grams-per-person', label: 'How much rice per person (grams)' },
  { slug: 'dry-pasta-portions-per-person', label: 'How much dry pasta per person' },
  { slug: 'birthday-cake-servings-calculator', label: 'Cake servings by pan size' },
  { slug: 'bakers-percentage-calculator', label: "Baker's percentage & hydration calculator" },
  { slug: 'ibu-beer-hops-tinseth', label: 'Beer IBU calculator (Tinseth formula)' },
  { slug: 'srm-color-cerveza-morey', label: 'Beer SRM color calculator (Morey formula)' },
  { slug: 'priming-sugar-carbonation', label: 'Priming sugar calculator for carbonation' },
  { slug: 'vodka-fruit-infusion-time', label: 'How long to infuse vodka with fruit' },
  { slug: 'heart-rate-zones-karvonen', label: 'Karvonen heart rate zone calculator' },
  { slug: 'ftp-cycling-watts', label: 'FTP calculator from a 20-minute test' },
  { slug: 'half-marathon-projection-from-10k-cameron', label: 'Predict your half marathon time from a 10K' },
  { slug: 'endurance-race-gel-calculator', label: 'How many energy gels for a race' },
  { slug: 'aceite-motor-capacidad-cambio-km', label: 'Oil change interval by oil type and km' },
  { slug: 'car-battery-cca-calculator', label: 'Car battery CCA calculator by engine size' },
  { slug: 'extra-ac-fuel-consumption', label: 'How much extra fuel does car A/C use?' },
  { slug: 'truck-payload-capacity-calculator', label: 'Truck payload capacity from GVWR and curb weight' },
  { slug: 'dilution-concentration-c1v1-c2v2', label: 'C1V1 = C2V2 dilution calculator' },
  { slug: 'parallax-distance-parsecs', label: 'Parallax to parsecs calculator (d = 1/p)' },
  { slug: 'redshift-radial-velocity', label: 'Redshift to radial velocity calculator' },
  { slug: 'richter-scale-magnitude-energy', label: 'Richter magnitude to energy (joules / TNT)' },
  { slug: 'weight-on-other-planets', label: 'Weight on other planets calculator' },
  { slug: 'bricks-per-square-meter-wall', label: 'How many bricks per square meter of wall' },
  { slug: 'ceramic-tile-adhesive-bags', label: 'Bags of tile adhesive per square meter' },
  { slug: 'grass-seed-per-m2-lawn', label: 'Grass seed per square meter calculator' },
  { slug: 'ph-soil-correction-lime-sulfur', label: 'Lime or sulfur to change soil pH' },
  { slug: 'anki-daily-flashcards-memorization-vocabulary', label: 'New Anki cards per day to finish a deck' },
  { slug: 'english-levels-cambridge-duolingo-time-conversion', label: 'Hours to reach each English CEFR level' },
  { slug: 'ielts-toefl-cefr-equivalency', label: 'IELTS to TOEFL score conversion' },
  { slug: 'servo-pwm-angle', label: 'Servo PWM pulse width to angle' },
  { slug: 'karaoke-songs-per-hour', label: 'How many karaoke songs per hour' },
  { slug: 'baby-shower-budget-calculator', label: 'Baby shower budget per guest' },
  { slug: 'criminal-background-certificate-cost', label: 'FBI criminal background check cost (2026)' },
  { slug: 'us-b1-b2-tourist-visa-cost', label: 'Total cost of a US B1/B2 tourist visa' },
  { slug: 'annual-pet-carbon-footprint', label: 'Pet carbon footprint calculator (dog & cat)' },
  { slug: 'material-biodegradation-time', label: 'How long materials take to biodegrade' },
  { slug: 'bmi-seniors-65-plus-table', label: 'BMI calculator for seniors 65+ (geriatric ranges)' },
];
const featuredSlugs = new Set(calcs.map((c) => c.slug));
const featured = FEATURED.filter((f) => featuredSlugs.has(f.slug));

// Schema.org
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['CollectionPage', 'WebPage'],
      '@id': 'https://hacecuentas.com/en/#webpage',
      url: 'https://hacecuentas.com/en',
      name: 'Free Online Calculators — Hacé Cuentas',
      description: 'Directory of free online calculators for finance, health, math, business, and more. Accurate, private, and no sign-up required.',
      inLanguage: 'en',
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      breadcrumb: { '@id': 'https://hacecuentas.com/en/#breadcrumb' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://hacecuentas.com/en/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Hacé Cuentas', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'English Calculators', item: 'https://hacecuentas.com/en' },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Free Online Calculators',
      description: `${totalCalcs} free online calculators for finance, health, math, business, sports, and more.`,
      numberOfItems: totalCalcs,
      itemListElement: calcs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.h1,
        url: `https://hacecuentas.com/en/${c.slug}`,
        description: c.description,
      })),
    },
  ],
};

// Set hreflang único y simétrico para todas las homes (es + en + pt +
// 6 verticales + global), x-default → home raíz. Ver src/lib/hreflang.ts.
const hreflangTags = HOME_HREFLANG;

// Hub identity (mockup): hero via PillarHub full-bleed; the English content
// (featured, categories) is preserved below inside .en-index.
const hubConfig = {
  color: '#2563eb',
  nav: 'Calculators',
  h1: 'Free Online Calculators',
  breadcrumb: [{ label: 'Hacé Cuentas', href: '/' }, { label: 'English Calculators' }],
  eyebrow: '🌎 English Calculators',
  titleLines: ['Free Online', 'Calculators'],
  lead: 'Accurate, private, and easy to use. Finance, health, math, business and everyday life. No registration required.',
  trust: [`${totalCalcs} calculators`, 'Updated 2026', 'Free & private'],
  needsKicker: '', needsTitle: '', needsSub: '', needs: [] as any[],
  featuredKicker: '', featuredTitle: '', featuredSub: '', showFeaturedSearch: false, filterBadges: [] as string[], cards: [] as any[],
  roomsKicker: '', roomsTitle: '', roomsSub: '', rooms: [] as any[], factsTitle: '', facts: [] as any[],
};
---

<Layout
  title="Free Online Calculators — Hacé Cuentas"
  description="Free online calculators for finance, health, math, business, sports, and everyday life. Accurate formulas, instant results, 100% private. No registration required."
  lang="en"
  hreflang={hreflangTags}
  schema={schema}
  pageType="hub"
>
  <Header slot="header" lang="en" />

  <PillarHub config={hubConfig} />

  <div class="en-index">

    <!-- Featured niche calculators -->
    {featured.length > 0 && (
      <section class="featured" aria-labelledby="featured-title">
        <h2 id="featured-title" class="featured-title">Featured calculators</h2>
        <p class="featured-sub">Hand-picked tools you won't find everywhere else.</p>
        <ul class="featured-list">
          {featured.map((f) => (
            <li><a href={`/en/${f.slug}`} class="featured-link">{f.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    <!-- Calculator grid grouped by category -->
    <div class="categories">
      {activeCategories.map((catKey) => {
        const meta = categoryMeta[catKey];
        const catCalcs = byCategory[catKey];
        return (
          <section class="category-section" aria-labelledby={`cat-${catKey}`}>
            <div class="cat-header">
              <span class="cat-icon" aria-hidden="true" style={`background: ${meta?.color}18`}>
                {meta?.icon ?? '📁'}
              </span>
              <div class="cat-meta">
                <h2 id={`cat-${catKey}`} class="cat-label">{meta?.label ?? catKey}</h2>
                {meta?.desc && <p class="cat-desc">{meta.desc}</p>}
              </div>
            </div>

            <div class="calc-grid">
              {catCalcs.map((calc) => (
                <a href={`/en/${calc.slug}`} class="calc-card">
                  <span class="card-icon" aria-hidden="true">{calc.icon}</span>
                  <div class="card-body">
                    <span class="card-title">{calc.h1}</span>
                    <span class="card-desc">{calc.description}</span>
                  </div>
                  <span
                    class="card-badge"
                    style={`background:${meta?.color}18; color:${meta?.color}`}
                  >
                    {meta?.label ?? catKey}
                  </span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <!-- Footer CTA -->
    <aside class="cta-footer" aria-label="More calculators">
      <p class="cta-text">Looking for more?</p>
      <p class="cta-sub">
        Visit our full site in Spanish with {ES_TOTAL_DISPLAY_EN} calculators —
        including Argentina-specific tools for taxes, wages, and more.
      </p>
      <a href="/" class="cta-link">Ver calculadoras en español &rarr;</a>
    </aside>

  </div>

  <ScrollToTop />
  <Footer slot="footer" lang="en" />
</Layout>

<style>
  .en-index {
    max-width: 1060px;
    margin: 0 auto;
  }

  /* ── Hero ── */
  .hero {
    text-align: center;
    padding: 3rem 1rem 2.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .hero-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.3rem 0.875rem;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .hero-sub {
    font-size: 1.0625rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    font-size: 0.875rem;
    color: var(--text-subtle);
  }

  .stat strong {
    color: var(--text);
    font-weight: 700;
  }

  .stat-sep {
    color: var(--border-strong);
  }

  /* ── Breadcrumbs ── */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    margin-bottom: 2rem;
  }

  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover { color: var(--accent); }

  .breadcrumbs .sep { color: var(--border-strong); }

  .breadcrumbs .current {
    color: var(--text);
    font-weight: 500;
  }

  /* ── Featured ── */
  .featured {
    margin-bottom: 3rem;
    padding: 1.5rem 1.75rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .featured-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .featured-sub {
    font-size: 0.875rem;
    color: var(--text-subtle);
    margin: 0 0 1rem;
  }

  .featured-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .featured-link {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--text);
    text-decoration: none;
    line-height: 1.4;
    transition: border-color 0.15s, color 0.15s;
  }

  .featured-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  /* ── Category sections ── */
  .categories {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .category-section {}

  .cat-header {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .cat-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.375rem;
  }

  .cat-meta { flex: 1; min-width: 0; }

  .cat-label {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.1875rem;
    line-height: 1.25;
  }

  .cat-desc {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-subtle);
    line-height: 1.45;
  }

  /* ── Calculator grid ── */
  .calc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .calc-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .calc-grid { grid-template-columns: 1fr; }
  }

  /* ── Calc card ── */
  .calc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.125rem 0.875rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }

  .calc-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .card-icon {
    flex-shrink: 0;
    font-size: 1.5rem;
    line-height: 1;
  }

  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
  }

  .card-title {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--text);
  }

  .card-desc {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-badge {
    align-self: flex-start;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.4;
    margin-top: auto;
  }

  /* ── CTA footer ── */
  .cta-footer {
    margin-top: 4rem;
    padding: 2rem 2.25rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .cta-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .cta-sub {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1.375rem;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
  }

  .cta-link:hover {
    background: var(--accent-hover);
    color: #fff;
    transform: translateY(-1px);
    text-decoration: none;
  }

  /* ── Responsive tweaks ── */
  @media (max-width: 640px) {
    .hero { padding: 2rem 0.75rem 2rem; }
    .cta-footer { padding: 1.5rem 1.25rem; }
    .cat-header { align-items: center; }
  }
</style>
