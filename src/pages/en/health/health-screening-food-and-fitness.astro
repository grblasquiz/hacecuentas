---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/en/health-screening-food-and-fitness';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="US" lang="en" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/en-health-screening-food-and-fitness';
  const configs = {"c1":{"formulaId":"alcohol-sangre-bac","fields":["peso","sexo","bebidas","tipoBebida","horas"],"outputs":[{"id":"bac","label":"Estimated BAC","format":"number","primary":true,"suffix":" g/L"},{"id":"gramosAlcohol","label":"Total alcohol consumed","format":"number","suffix":" g"},{"id":"horasHastaCero","label":"Hours until BAC reaches zero","format":"number","suffix":" hours"},{"id":"estado","label":"Status","format":"text"},{"id":"mensaje","label":"Summary","format":"text"}],"title":"Blood Alcohol Content (BAC) Calculator — Widmark Formula"},"c2":{"formulaId":"grasa-corporal-pliegues","fields":["sexo","edad","peso","pliegue1","pliegue2","pliegue3"],"outputs":[{"id":"porcentajeGrasa","label":"% Body fat","format":"number","primary":true,"suffix":"%"},{"id":"categoria","label":"Category","format":"text"},{"id":"masaGrasa","label":"Fat mass","format":"number","suffix":" kg"},{"id":"masaMagra","label":"Lean mass","format":"number","suffix":" kg"},{"id":"densidadCorporal","label":"Body density","format":"number"},{"id":"mensaje","label":"Summary","format":"text"}],"title":"Body Fat % Calculator by Skinfolds"},"c3":{"formulaId":"boxeo-calorias-quemadas-rounds-peso","fields":["pesoKg","tipo","minutos"],"outputs":[{"id":"caloriasQuemadas","label":"Calories Burned","primary":true},{"id":"mets","label":"MET Value"},{"id":"interpretacion","label":"Interpretation"}],"title":"Calories Burned Boxing — by Weight, Style & Duration"},"c4":{"formulaId":"burnout-indice-carga-laboral-test-mbi","fields":["cansancioEmocional","despersonalizacion","realizacionPersonal"],"outputs":[{"id":"nivel","label":"Burnout Level","primary":true},{"id":"interpretacion","label":"Interpretation"},{"id":"recomendacion","label":"Recommendation"}],"title":"Burnout Index Calculator"},"c5":{"formulaId":"celiaco-gluten-alimentos-ppm-sin-tacc","fields":["alimento"],"outputs":[{"id":"contieneTacc","label":"Contains gluten","primary":true},{"id":"ppm","label":"Approx ppm"},{"id":"alternativa","label":"Gluten-Free Alternative"}],"title":"Gluten in Foods: ppm Levels & Celiac-Safe Alternatives"},"c6":{"formulaId":"peso-objetivo-competicion","fields":["altura","sexo","deporte"],"outputs":[{"id":"pesoIdeal","label":"Competitive Ideal Weight","format":"text","primary":true},{"id":"bmiRango","label":"Target BMI","format":"text"},{"id":"pesoMin","label":"Minimum Weight","format":"number","suffix":" kg"},{"id":"pesoMax","label":"Maximum Weight","format":"number","suffix":" kg"},{"id":"mensaje","label":"Summary","format":"text"}],"title":"Competition Weight Calculator: Ideal Range by Sport and Height"},"c7":{"formulaId":"vegana-proteina-completa-combinacion-aminoacidos","fields":["plato"],"outputs":[{"id":"completo","label":"Is it Complete?","primary":true},{"id":"aminoacidoLimitante","label":"Limiting Amino Acid"},{"id":"pdcaas","label":"PDCAAS (0–1)"}],"title":"Complete Vegan Protein Combinations"},"c8":{"formulaId":"certificado-antecedentes-penales-costo","fields":["urgencia"],"outputs":[{"id":"costo","label":"Cost","primary":true},{"id":"validez","label":"Validity Period"},{"id":"resumen","label":"Summary"}],"title":"FBI Criminal Background Check Cost 2026 (+ State & Employment Checks)"},"c9":{"formulaId":"fodmap-alimentos-intolerancia-sii-tabla","fields":["alimento"],"outputs":[{"id":"nivelFodmap","label":"FODMAP Level","primary":true},{"id":"porcionSegura","label":"Safe Serving Size"},{"id":"alternativa","label":"Alternative Foods"}],"title":"Low FODMAP Foods: Complete Chart for IBS"},"c10":{"formulaId":"pH-alimento-alcalinidad","fields":["alimento"],"outputs":[{"id":"ph","label":"pH","format":"number","primary":true},{"id":"clasificacion","label":"Classification","format":"text"},{"id":"impacto","label":"Dental/Digestive Impact","format":"text"}],"title":"Food pH and Alkalinity Calculator"},"c11":{"formulaId":"keto-macros-cetogenica-deficit-completo","fields":["calorias","objetivo"],"outputs":[{"id":"grasaG","label":"Fat (g)","primary":true},{"id":"proteinaG","label":"Protein (g)"},{"id":"carbosG","label":"Carbs (g)"}],"title":"Keto Macros Calculator — fat, protein & carbs for ketosis"},"c12":{"formulaId":"calidad-sueno-pittsburgh","fields":["latencia","duracion","horasCama","perturbaciones","calidadSubjetiva","disfuncionDiurna"],"outputs":[{"id":"puntajeGlobal","label":"PSQI Score","format":"number","primary":true,"suffix":" /21"},{"id":"resultado","label":"Result","format":"text"},{"id":"eficiencia","label":"Sleep efficiency","format":"number","suffix":"%"},{"id":"recomendacion","label":"Recommendation","format":"text"},{"id":"mensaje","label":"Summary","format":"text"}],"title":"Sleep Quality Calculator — Simplified Pittsburgh Index"},"c13":{"formulaId":"depresion-posparto-test","fields":["epds1","epds2","epds3","epds4","epds5","epds6","epds7","epds8","epds9","epds10"],"outputs":[{"id":"puntaje","label":"EPDS Score","format":"text","primary":true},{"id":"interpretacion","label":"Interpretation","format":"text"},{"id":"recomendacion","label":"Recommendation","format":"text"},{"id":"recursos","label":"Help Resources","format":"text"}],"title":"Postpartum Depression Test — EPDS Edinburgh Scale"},"c14":{"formulaId":"acidez-orina-alimentos","fields":["proteina","fosforo","potasio","magnesio","calcio"],"outputs":[{"id":"pral","label":"PRAL (mEq/100g)","format":"number","primary":true},{"id":"efecto","label":"Effect on urine","format":"text"},{"id":"recomendacion","label":"Clinical recommendation","format":"text"}],"title":"PRAL Calculator: Calculate Urine Acidity by Food"},"c15":{"formulaId":"spf-proteccion-solar-minutos-piel","fields":["tipoPiel","spf"],"outputs":[{"id":"minutosProteccion","label":"Theoretical protection time","primary":true},{"id":"reaplicar","label":"Reapply every"},{"id":"advertencia","label":"Important note"}],"title":"How Long Does Sunscreen Protect You? SPF Time Calculator"}};
  const numeric = (o:any) => Object.entries(o || {}).filter(([k,v]) => !k.startsWith('_') && typeof v === 'number' && Number.isFinite(v as number));
  const labelFor = (cfg:any,key:string) => cfg.outputs.find((o:any)=>o.id===key)?.label || key.replace(/_/g,' ');
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => {
    const id=selected?.id || Object.keys(configs)[0], cfg=(configs as any)[id];
    const values:any={}; for(const key of cfg.fields) values[key]=all[id+'__'+key];
    let out:any; try { out=formulaMap[id](values) || {}; } catch(e:any) { return {total:'—',sub:e?.message||'Revisa los datos',rows:[],chart:[],format:'plain'}; }
    const nums=numeric(out); const preferred=cfg.outputs.find((x:any)=>x.primary && typeof out[x.id]==='number') || cfg.outputs.find((x:any)=>typeof out[x.id]==='number');
    const mainKey=preferred?.id || nums[0]?.[0], main=Number(out[mainKey] ?? nums[0]?.[1] ?? 0);
    const rows=nums.slice(0,12).map(([k,v])=>({k:labelFor(cfg,k),v:Number(v),format:'unit'}));
    const chart=nums.slice(0,6).map(([k,v],i)=>({label:labelFor(cfg,k),value:Math.abs(Number(v)),tone:i===0?'main':i===1?'good':'prop'}));
    return {total:main.toLocaleString('en',{maximumFractionDigits:2}),sub:out._insight || out.detalle || out.resumen || cfg.title,rows,chart,format:'unit'};
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
