---
/**
 * Decision hub EN — "How many calories and macros should I eat?"
 * Replaces 18 loose calculator URLs (see hub.replaces).
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  KCAL_PER_G,
  ACTIVITY,
  MIFFLIN,
  HARRIS,
  GOAL_MULTIPLIER,
  CALORIE_FLOOR,
  MIN_FAT_G,
  SPLITS,
  ATKINS_CARBS,
  SODIUM,
  GLYCEMIC,
  FASTING_SPLIT,
  FIBER_AI,
  DRINK_CARBS,
  ETHANOL_DENSITY,
  US_STANDARD_DRINK_G,
  LB_PER_KG,
  CM_PER_IN,
} from '../../../lib/hubs/en/calories-and-macros';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    K: KCAL_PER_G,
    ACTIVITY,
    MIFFLIN,
    HARRIS,
    GOALS: GOAL_MULTIPLIER,
    FLOOR: CALORIE_FLOOR,
    MIN_FAT_G,
    SPLITS,
    ATKINS: ATKINS_CARBS,
    SODIUM,
    GLYCEMIC,
    FAST: FASTING_SPLIT,
    FIBER: FIBER_AI,
    DRINK_CARBS,
    ETHANOL_DENSITY,
    US_STD_G: US_STANDARD_DRINK_G,
    LB_PER_KG,
    CM_PER_IN,
  }}
>
  (function () {
    const H = window.HC_HUB;

    /** IOM 2005 adequate intake for dietary fibre, in grams per day. */
    function fiberTarget(age, isMale) {
      if (age <= 3) return FIBER.child1to3;
      if (age <= 8) return FIBER.child4to8;
      if (isMale) {
        if (age <= 13) return FIBER.male9to13;
        if (age <= 18) return FIBER.male14to18;
        if (age <= 50) return FIBER.male19to50;
        return FIBER.male51plus;
      }
      if (age <= 13) return FIBER.female9to13;
      if (age <= 18) return FIBER.female14to18;
      if (age <= 50) return FIBER.female19to50;
      return FIBER.female51plus;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'cut';

      const lb = Math.max(0, Number(v.weightLb) || 0);
      const totalIn = Math.max(0, Number(v.heightFt) || 0) * 12 + Math.max(0, Number(v.heightIn) || 0);
      const age = Math.max(0, Number(v.age) || 0);
      const sex = String(v.sex || 'm') === 'f' ? 'f' : 'm';
      const isMale = sex === 'm';
      const activityKey = String(v.activity || 'moderate');
      const activity = ACTIVITY[activityKey] || ACTIVITY.moderate;
      const equation = String(v.equation || 'mifflin');
      // A protein target of exactly 0 is not meaningful, so the fallback is safe.
      const proteinPerLb = Math.max(0, Number(v.proteinPerLb) || 1);
      const fatPct = Math.max(0, Number(v.fatPct) || 27);
      const atkinsPhase = String(v.atkinsPhase || '1');
      const sodiumPlan = String(v.sodiumPlan || 'standard');
      const mealsPct = Math.max(0, Number(v.mealsPct) || 80);
      // 0 snacks is a legitimate answer, so read it without a truthy fallback.
      const snacks = Math.max(0, Math.round(Number(v.snacks) >= 0 ? Number(v.snacks) : 2));
      const foodGi = Math.max(0, Number(v.foodGi) || 0);
      const foodCarbs = Math.max(0, Number(v.foodCarbs) || 0);
      const drinkMl = Math.max(0, Number(v.drinkMl) || 0);
      const drinkAbv = Math.max(0, Number(v.drinkAbv) || 0);
      const drinkType = String(v.drinkType || 'beer_regular');

      if (!(lb > 0) || !(totalIn > 0) || !(age > 0)) {
        return {
          total: 'Enter weight, height and age',
          sub: 'Those three plus sex and activity are all the calorie target needs.',
          rows: [],
          chart: [],
          format: 'plain',
        };
      }

      const kg = lb / LB_PER_KG;
      const cm = totalIn * CM_PER_IN;

      // ---- BMR, both equations -----------------------------------------------
      const mifflin =
        MIFFLIN.weight * kg + MIFFLIN.height * cm - MIFFLIN.age * age + (isMale ? MIFFLIN.male : MIFFLIN.female);
      const hb = isMale ? HARRIS.male : HARRIS.female;
      const harris = hb.base + hb.weight * kg + hb.height * cm - hb.age * age;
      const bmr = equation === 'harris' ? harris : mifflin;
      const tdee = bmr * activity;

      // ---- Calorie target -----------------------------------------------------
      const goalMult = GOALS[id] != null ? GOALS[id] : 1;
      const rawTarget = tdee * goalMult;
      const floor = isMale ? FLOOR.male : FLOOR.female;
      const clamped = rawTarget < floor;
      const target = Math.round(Math.max(rawTarget, floor));

      const rows = [];
      rows.push({ k: 'BMR — Mifflin-St Jeor (1990)', ref: '10×kg + 6.25×cm − 5×age ' + (isMale ? '+ 5' : '− 161'), v: mifflin, format: 'unit', unit: 'kcal', decimals: 0 });
      rows.push({ k: 'BMR — Harris-Benedict, revised 1984', ref: 'Typically reads a little higher', v: harris, format: 'unit', unit: 'kcal', decimals: 0 });
      rows.push({ k: 'Difference between the two equations', ref: 'Usually under 100 kcal', v: Math.abs(mifflin - harris), format: 'unit', unit: 'kcal', decimals: 0 });
      rows.push({ k: 'TDEE — maintenance', ref: 'BMR × ' + activity + ' (' + activityKey + ')', v: tdee, format: 'unit', unit: 'kcal', decimals: 0, extra: true });
      rows.push({ k: 'Your target for this goal', ref: 'TDEE × ' + goalMult + (clamped ? ' — raised to the clinical floor' : ''), v: target, format: 'unit', unit: 'kcal', decimals: 0, extra: true });
      rows.push({ k: 'Daily gap against maintenance', ref: target < tdee ? 'A deficit' : target > tdee ? 'A surplus' : 'At maintenance', v: target - tdee, format: 'unit', unit: 'kcal', decimals: 0 });
      rows.push({ k: 'Expected weekly weight change', ref: 'At roughly 3,500 kcal per pound', v: ((target - tdee) * 7) / 3500, format: 'unit', unit: 'lb per week', decimals: 2 });
      if (clamped) {
        rows.push({ k: 'Clinical floor applied', ref: 'The minimum recommended without medical supervision', v: floor, format: 'unit', unit: 'kcal', decimals: 0 });
      }

      // ---- Macros -------------------------------------------------------------
      let proteinG, fatG, carbG, macroNote;

      if (id === 'atkins') {
        carbG = ATKINS[atkinsPhase] != null ? ATKINS[atkinsPhase] : ATKINS['1'];
        proteinG = Math.round((target * SPLITS.iifym.protein) / K.protein);
        fatG = Math.max(0, Math.round((target - carbG * K.carb - proteinG * K.protein) / K.fat));
        macroNote = 'Phase ' + atkinsPhase + ': carbs capped at ' + carbG + ' g, protein at 30% of calories, fat takes the rest';
      } else if (id === 'dash') {
        proteinG = Math.round((target * SPLITS.dash.protein) / K.protein);
        fatG = Math.round((target * SPLITS.dash.fat) / K.fat);
        carbG = Math.round((target * SPLITS.dash.carb) / K.carb);
        macroNote = 'DASH split: 55% carbohydrate, 18% protein, 27% fat';
      } else if (id === 'recomp') {
        proteinG = Math.round((target * SPLITS.recomp.protein) / K.protein);
        fatG = Math.round((target * SPLITS.recomp.fat) / K.fat);
        carbG = Math.round((target - proteinG * K.protein - fatG * K.fat) / K.carb);
        macroNote = 'Recomp split: 30% protein, 25% fat, carbohydrate takes the remainder';
      } else if (id === 'maintain') {
        proteinG = Math.round((target * SPLITS.iifym.protein) / K.protein);
        fatG = Math.round((target * SPLITS.iifym.fat) / K.fat);
        carbG = Math.round((target * SPLITS.iifym.carb) / K.carb);
        macroNote = 'IIFYM split: 30% protein, 30% fat, 40% carbohydrate';
      } else {
        // cut, bulk and fasting all set protein by bodyweight and fat by percentage.
        proteinG = Math.round(lb * proteinPerLb);
        fatG = Math.max(MIN_FAT_G, Math.round((target * (fatPct / 100)) / K.fat));
        carbG = Math.round((target - proteinG * K.protein - fatG * K.fat) / K.carb);
        if (carbG < 0) {
          // Protein plus fat overshoot the target: cap protein, as the live formula does.
          proteinG = Math.max(0, Math.round((target - fatG * K.fat) / K.protein));
          carbG = Math.max(0, Math.round((target - proteinG * K.protein - fatG * K.fat) / K.carb));
          macroNote = 'Protein and fat exceeded the target, so protein was capped to fit — ease the deficit or lower the fat share';
        } else {
          macroNote = proteinPerLb + ' g of protein per lb, fat at ' + fatPct + '% of calories, carbs take the remainder';
        }
      }

      const pKcal = proteinG * K.protein;
      const fKcal = fatG * K.fat;
      const cKcal = carbG * K.carb;
      const macroKcal = pKcal + fKcal + cKcal;

      rows.push({ k: 'Protein', ref: macroNote, v: proteinG, format: 'unit', unit: 'g', decimals: 0, extra: true });
      rows.push({ k: 'Fat', ref: fatG === MIN_FAT_G ? 'At the ' + MIN_FAT_G + ' g hormonal floor' : Math.round((fKcal / macroKcal) * 100) + '% of calories', v: fatG, format: 'unit', unit: 'g', decimals: 0, extra: true });
      rows.push({ k: 'Carbohydrate', ref: Math.round((cKcal / macroKcal) * 100) + '% of calories', v: carbG, format: 'unit', unit: 'g', decimals: 0, extra: true });
      rows.push({ k: 'Protein per kilogram of bodyweight', ref: 'The literature range is 1.6 to 2.2 g/kg for trainees', v: proteinG / kg, format: 'unit', unit: 'g/kg', decimals: 2 });

      // ---- Case-specific rows -------------------------------------------------
      if (id === 'maintain') {
        rows.push({ k: 'Discretionary calories', ref: '20% of the target can be anything, if the macros still close', v: target * SPLITS.iifym.discretionary, format: 'unit', unit: 'kcal', decimals: 0 });
      }

      if (id === 'fasting') {
        rows.push({ k: 'Meal 1 — breaking the fast', ref: '35% of the day inside the 8-hour window', v: target * FAST.meal1, format: 'unit', unit: 'kcal', decimals: 0 });
        rows.push({ k: 'Meal 2 — the main meal', ref: '40% of the day', v: target * FAST.meal2, format: 'unit', unit: 'kcal', decimals: 0 });
        rows.push({ k: 'Meal 3 — the lighter one', ref: '25% of the day', v: target * FAST.meal3, format: 'unit', unit: 'kcal', decimals: 0 });
        rows.push({ k: 'Two-meal alternative — first meal', ref: '40% if you only eat twice', v: target * 0.4, format: 'unit', unit: 'kcal', decimals: 0 });
        rows.push({ k: 'Two-meal alternative — second meal', ref: '60% if you only eat twice', v: target * 0.6, format: 'unit', unit: 'kcal', decimals: 0 });
        rows.push({ k: 'Protein per meal across three meals', ref: 'Hitting this is the hard part of a short window', v: proteinG / 3, format: 'unit', unit: 'g', decimals: 0 });
      }

      if (id === 'atkins') {
        rows.push({ k: 'Net carbohydrate allowance this phase', ref: 'Phase ' + atkinsPhase, v: carbG, format: 'unit', unit: 'g', decimals: 0 });
        rows.push({ k: 'Carbohydrate calories out of the whole day', ref: 'The rest comes from protein and fat', v: cKcal, format: 'unit', unit: 'kcal', decimals: 0 });
        ['1', '2', '3', '4'].forEach(function (p) {
          if (p !== atkinsPhase) {
            rows.push({ k: 'Phase ' + p + ' allowance for comparison', ref: 'Where you go next', v: ATKINS[p], format: 'unit', unit: 'g of net carbs', decimals: 0 });
          }
        });
      }

      if (id === 'dash') {
        const na = sodiumPlan === 'strict' ? SODIUM.strict : SODIUM.standard;
        rows.push({ k: 'Sodium ceiling', ref: sodiumPlan === 'strict' ? 'Strict DASH arm' : 'Standard DASH arm', v: na, format: 'unit', unit: 'mg', decimals: 0, extra: true });
        rows.push({ k: 'That ceiling as salt', ref: '400 mg of sodium per gram of salt', v: na / SODIUM.mgPerGramSalt, format: 'unit', unit: 'g of salt', decimals: 2 });
        rows.push({ k: 'How far below a typical Western diet', ref: 'Which runs about ' + SODIUM.typicalWestern + ' mg', v: SODIUM.typicalWestern - na, format: 'unit', unit: 'mg', decimals: 0 });
        rows.push({ k: 'The other DASH sodium option', ref: sodiumPlan === 'strict' ? 'Standard arm' : 'Strict arm — the biggest BP reductions', v: sodiumPlan === 'strict' ? SODIUM.standard : SODIUM.strict, format: 'unit', unit: 'mg', decimals: 0 });
      }

      // ---- Rows that apply to every case --------------------------------------
      const fiber = fiberTarget(age, isMale);
      rows.push({ k: 'Dietary fibre target', ref: 'IOM 2005 adequate intake for your age and sex', v: fiber, format: 'unit', unit: 'g', decimals: 0 });
      rows.push({ k: 'Fibre as a share of your carbohydrate', ref: 'Hard below about 100 g of carbs a day', v: carbG > 0 ? (fiber / carbG) * 100 : 0, format: 'unit', unit: '%', decimals: 1 });

      if (snacks > 0 && mealsPct < 100) {
        const snackTotal = target * (1 - mealsPct / 100);
        rows.push({ k: 'Calories left for snacks', ref: mealsPct + '% of the day goes to main meals', v: snackTotal, format: 'unit', unit: 'kcal', decimals: 0 });
        rows.push({ k: 'Calories per snack', ref: 'Across ' + snacks + ' snack' + (snacks > 1 ? 's' : ''), v: Math.round(snackTotal / snacks / 5) * 5, format: 'unit', unit: 'kcal', decimals: 0 });
        rows.push({ k: 'Calories per main meal, across three', ref: mealsPct + '% of the target split three ways', v: (target * (mealsPct / 100)) / 3, format: 'unit', unit: 'kcal', decimals: 0 });
      }

      if (foodGi > 0 && foodCarbs > 0) {
        const gl = (foodGi * foodCarbs) / 100;
        const giBand = foodGi <= GLYCEMIC.giLow ? 'low' : foodGi <= GLYCEMIC.giMedium ? 'medium' : 'high';
        const glBand = gl <= GLYCEMIC.glLow ? 'low' : gl <= GLYCEMIC.glMedium ? 'medium' : 'high';
        rows.push({ k: 'Glycemic index of that food', ref: 'A ' + giBand + ' GI (low is 55 or under)', v: foodGi, format: 'plain', decimals: 0 });
        rows.push({ k: 'Glycemic load of that serving', ref: 'GI × carbs ÷ 100 — a ' + glBand + ' load', v: gl, format: 'plain', decimals: 1 });
        rows.push({ k: 'That serving as a share of your daily carbs', ref: 'Portion is what glycemic load adds to the index', v: carbG > 0 ? (foodCarbs / carbG) * 100 : 0, format: 'unit', unit: '%', decimals: 1 });
      }

      if (drinkMl > 0 && drinkAbv > 0) {
        const ethanolG = drinkMl * (drinkAbv / 100) * ETHANOL_DENSITY;
        const alcKcal = ethanolG * K.alcohol;
        const carbPer100 = DRINK_CARBS[drinkType] != null ? DRINK_CARBS[drinkType] : 0;
        const drinkCarbG = (drinkMl / 100) * carbPer100;
        const drinkKcal = alcKcal + drinkCarbG * K.carb;
        rows.push({ k: 'Calories in that drink', ref: 'Ethanol at 7 kcal/g plus residual carbohydrate', v: drinkKcal, format: 'unit', unit: 'kcal', decimals: 0 });
        rows.push({ k: 'Grams of ethanol in it', ref: 'Volume × ABV × 0.789', v: ethanolG, format: 'unit', unit: 'g', decimals: 1 });
        rows.push({ k: 'US standard drinks', ref: '14 g of ethanol each', v: ethanolG / US_STD_G, format: 'plain', decimals: 2 });
        rows.push({ k: 'That drink as a share of your daily target', ref: 'Alcohol sits on top unless you plan for it', v: (drinkKcal / target) * 100, format: 'unit', unit: '%', decimals: 1 });
      }

      const nf = function (n) { return Math.round(n).toLocaleString('en-US'); };

      return {
        total: nf(target) + ' kcal',
        sub:
          nf(proteinG) + ' g protein · ' + nf(fatG) + ' g fat · ' + nf(carbG) + ' g carbs · ' +
          'BMR ' + nf(bmr) + ' kcal, TDEE ' + nf(tdee) + ' kcal' +
          (clamped ? ' — target raised to the ' + nf(floor) + ' kcal clinical floor' : ''),
        rows: rows,
        format: 'plain',
        chart: [
          { label: 'Protein — ' + proteinG + ' g', value: pKcal, tone: 'main' },
          { label: 'Fat — ' + fatG + ' g', value: fKcal, tone: 'warn' },
          { label: 'Carbohydrate — ' + carbG + ' g', value: cKcal, tone: 'good' },
        ],
      };
    });
  })();
</script>
