---
/**
 * Decision hub EN — "Am I at a healthy weight?"
 * Replaces 12 loose calculator URLs (see hub.replaces).
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  SCALE,
  HEALTHY_BMI,
  SENIOR_BMI,
  IBW,
  CHILD_BMI_BOYS,
  CHILD_BMI_GIRLS,
  CHILD_WEIGHT_BOYS,
  CHILD_WEIGHT_GIRLS,
  WHR,
  WAIST_CM,
  WHTR_THRESHOLD,
  BODY_FAT_BANDS,
  VISCERAL_BANDS,
  BSA,
  LB_PER_KG,
  CM_PER_IN,
} from '../../../lib/hubs/en/body-weight';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    SCALE,
    HEALTHY: HEALTHY_BMI,
    SENIOR: SENIOR_BMI,
    IBW,
    CB_BOYS: CHILD_BMI_BOYS,
    CB_GIRLS: CHILD_BMI_GIRLS,
    CW_BOYS: CHILD_WEIGHT_BOYS,
    CW_GIRLS: CHILD_WEIGHT_GIRLS,
    WHR,
    WAIST_CM,
    WHTR: WHTR_THRESHOLD,
    FAT_BANDS: BODY_FAT_BANDS,
    VISC_BANDS: VISCERAL_BANDS,
    BSA,
    LB_PER_KG,
    CM_PER_IN,
  }}
>
  (function () {
    const H = window.HC_HUB;

    const kgFromLb = (lb) => lb / LB_PER_KG;
    const lbFromKg = (kg) => kg * LB_PER_KG;
    const cmFromIn = (inches) => inches * CM_PER_IN;
    const inFromCm = (cm) => cm / CM_PER_IN;

    function bandLabel(bands, x) {
      for (const b of bands) if (x < b.max) return b.label;
      return bands[bands.length - 1].label;
    }

    /** Position 0-100 on the BMI scale declared in SCALE. */
    function scalePos(bmi) {
      return Math.min(100, Math.max(0, ((bmi - SCALE.min) / (SCALE.max - SCALE.min)) * 100));
    }
    function scaleChart() {
      let prev = SCALE.min;
      return SCALE.bands.map(function (b) {
        const seg = { label: b.label, value: b.to, from: prev, to: b.to, tone: b.tone };
        prev = b.to;
        return seg;
      });
    }

    /**
     * Linear interpolation on a percentile table keyed by age.
     * Mirrors imc-infantil-percentil.ts: pick the tabulated ages bracketing the
     * requested age, then interpolate every percentile between them.
     */
    function interpTable(table, age) {
      const ages = Object.keys(table).map(Number).sort(function (a, b) { return a - b; });
      let lower = ages[0];
      let upper = ages[ages.length - 1];
      for (let k = 0; k < ages.length; k++) {
        if (ages[k] <= age) lower = ages[k];
        if (ages[k] >= age) { upper = ages[k]; break; }
      }
      const low = table[lower];
      const up = table[upper];
      const t = upper === lower ? 0 : (age - lower) / (upper - lower);
      return low.map(function (a, idx) { return a + (up[idx] - a) * t; });
    }

    /**
     * Weight-for-age uses the nearest LOWER tabulated age, not interpolation —
     * that is what peso-ideal-ninos.ts does, and this hub keeps it identical.
     */
    function stepTable(table, age) {
      const ages = Object.keys(table).map(Number).sort(function (a, b) { return a - b; });
      let closest = ages[0];
      for (const e of ages) if (e <= age) closest = e;
      return table[closest];
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'adult';

      const lb = Math.max(0, Number(v.weightLb) || 0);
      const totalIn = Math.max(0, Number(v.heightFt) || 0) * 12 + Math.max(0, Number(v.heightIn) || 0);
      const sex = String(v.sex || 'm') === 'f' ? 'f' : 'm';
      const isMale = sex === 'm';
      // Age 0 is not a valid input for this hub (BMI starts at 2), so the
      // fallback is safe here.
      const age = Math.max(0, Number(v.age) || 0);
      const frameKey = String(v.frame || 'medium');
      const frame = IBW.frame[frameKey] || 1;
      const waistIn = Math.max(0, Number(v.waistIn) || 0);
      const hipIn = Math.max(0, Number(v.hipIn) || 0);
      const bodyFat = Math.max(0, Number(v.bodyFat) || 0);
      const visceralShare = Math.max(0, Number(v.visceralShare) || 0);

      if (!(lb > 0) || !(totalIn > 0)) {
        return {
          total: 'Enter weight and height',
          sub: 'A weight in pounds and a height in feet and inches are all the BMI needs.',
          rows: [],
          chart: [],
          format: 'plain',
        };
      }

      const kg = kgFromLb(lb);
      const cm = cmFromIn(totalIn);
      const m = cm / 100;
      const bmi = kg / (m * m);
      const rows = [];

      // ---- Body surface area -------------------------------------------------
      if (id === 'bsa') {
        const mosteller = Math.sqrt((kg * cm) / BSA.mostellerDivisor);
        const duBois = BSA.duBois.k * Math.pow(kg, BSA.duBois.wExp) * Math.pow(cm, BSA.duBois.hExp);
        const haycock = BSA.haycock.k * Math.pow(kg, BSA.haycock.wExp) * Math.pow(cm, BSA.haycock.hExp);
        const avg = (mosteller + duBois + haycock) / 3;
        const spread = Math.max(mosteller, duBois, haycock) - Math.min(mosteller, duBois, haycock);

        rows.push({ k: 'Du Bois & Du Bois', ref: '0.007184 × kg^0.425 × cm^0.725 (1916)', v: duBois, format: 'unit', unit: 'm²', decimals: 3, extra: true });
        rows.push({ k: 'Mosteller', ref: '√(kg × cm ÷ 3600) — the clinical default (1987)', v: mosteller, format: 'unit', unit: 'm²', decimals: 3 });
        rows.push({ k: 'Haycock', ref: '0.024265 × kg^0.5378 × cm^0.3964 — paediatrics (1978)', v: haycock, format: 'unit', unit: 'm²', decimals: 3 });
        rows.push({ k: 'Average of the three', ref: 'Use this only as a sanity check', v: avg, format: 'unit', unit: 'm²', decimals: 3 });
        rows.push({ k: 'Spread between the formulas', ref: 'Widest minus narrowest', v: spread, format: 'unit', unit: 'm²', decimals: 3 });
        rows.push({ k: 'Percentage of the 1.73 m² dosing reference', ref: 'The standard adult normalisation', v: (avg / 1.73) * 100, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: 'Weight used', ref: String(Math.round(lb * 10) / 10) + ' lb converted', v: kg, format: 'unit', unit: 'kg', decimals: 1 });
        rows.push({ k: 'Height used', ref: String(totalIn) + ' in converted', v: cm, format: 'unit', unit: 'cm', decimals: 1 });

        return {
          total: duBois.toFixed(2) + ' m²',
          sub:
            'Du Bois ' + duBois.toFixed(3) + ' m² · Mosteller ' + mosteller.toFixed(3) +
            ' m² · Haycock ' + haycock.toFixed(3) + ' m². They agree within ' + spread.toFixed(3) + ' m².',
          rows: rows,
          format: 'plain',
          position: scalePos(bmi),
          positionLabel: 'BMI ' + bmi.toFixed(1),
          chart: scaleChart(),
        };
      }

      // ---- Child and teenager -------------------------------------------------
      if (id === 'child') {
        const table = sex === 'f' ? CB_GIRLS : CB_BOYS;
        const clamped = Math.min(18, Math.max(2, age || 10));
        const p = interpTable(table, clamped);
        const p5 = p[0], p50 = p[1], p85 = p[2], p97 = p[3];

        let band, pctLabel;
        if (bmi < p5) { band = 'Underweight'; pctLabel = 'below the 5th percentile'; }
        else if (bmi < p85) { band = 'Healthy weight'; pctLabel = '5th to 84th percentile'; }
        else if (bmi < p97) { band = 'Overweight'; pctLabel = '85th to 96th percentile'; }
        else { band = 'Obesity'; pctLabel = '97th percentile or above'; }

        rows.push({ k: 'BMI', ref: 'Weight in kg ÷ height in m squared', v: bmi, format: 'unit', unit: 'BMI', decimals: 1, extra: true });
        rows.push({ k: 'Age used for the curve', ref: 'WHO BMI-for-age, ' + (sex === 'f' ? 'girls' : 'boys'), v: clamped, format: 'unit', unit: 'years', decimals: 1 });
        rows.push({ k: '5th percentile BMI — below this is underweight', ref: 'Interpolated between tabulated ages', v: p5, format: 'unit', unit: 'BMI', decimals: 1 });
        rows.push({ k: '50th percentile BMI — the median for this age', ref: 'WHO reference', v: p50, format: 'unit', unit: 'BMI', decimals: 1 });
        rows.push({ k: '85th percentile BMI — overweight starts here', ref: 'WHO reference', v: p85, format: 'unit', unit: 'BMI', decimals: 1 });
        rows.push({ k: '97th percentile BMI — obesity starts here', ref: 'WHO reference', v: p97, format: 'unit', unit: 'BMI', decimals: 1 });
        rows.push({ k: 'Healthy weight at this height — lower end', ref: 'BMI ' + p5.toFixed(1) + ' for this age', v: lbFromKg(p5 * m * m), format: 'unit', unit: 'lb', decimals: 1 });
        rows.push({ k: 'Healthy weight at this height — upper end', ref: 'BMI ' + p85.toFixed(1) + ' for this age', v: lbFromKg(p85 * m * m), format: 'unit', unit: 'lb', decimals: 1 });

        if (age <= 10) {
          const w = stepTable(sex === 'f' ? CW_GIRLS : CW_BOYS, age);
          rows.push({ k: 'Weight-for-age 15th percentile', ref: 'WHO weight-for-age, under 11 only', v: lbFromKg(w[0]), format: 'unit', unit: 'lb', decimals: 1 });
          rows.push({ k: 'Weight-for-age median', ref: 'WHO weight-for-age, under 11 only', v: lbFromKg(w[1]), format: 'unit', unit: 'lb', decimals: 1, extra: true });
          rows.push({ k: 'Weight-for-age 85th percentile', ref: 'WHO weight-for-age, under 11 only', v: lbFromKg(w[2]), format: 'unit', unit: 'lb', decimals: 1 });
        }

        return {
          total: bmi.toFixed(1) + ' — ' + band,
          sub:
            'BMI ' + bmi.toFixed(1) + ' for a ' + clamped + '-year-old ' + (sex === 'f' ? 'girl' : 'boy') +
            ' sits in the ' + pctLabel + '. In children only the percentile means anything — the number itself does not.',
          rows: rows,
          format: 'plain',
          position: scalePos(bmi),
          positionLabel: 'BMI ' + bmi.toFixed(1) + ' — ' + pctLabel,
          chart: scaleChart(),
        };
      }

      // ---- Body composition ---------------------------------------------------
      if (id === 'composition') {
        if (!(bodyFat > 0)) {
          return {
            total: 'Enter a body fat percentage',
            sub: 'This case needs a body fat percentage from DEXA, a bioimpedance scale or calipers.',
            rows: [],
            chart: [],
            format: 'plain',
          };
        }
        const fatLb = (lb * bodyFat) / 100;
        const leanLb = lb - fatLb;
        rows.push({ k: 'Fat mass', ref: bodyFat.toFixed(1) + '% of body weight', v: fatLb, format: 'unit', unit: 'lb', decimals: 1, extra: true });
        rows.push({ k: 'Lean mass — muscle, bone, organs, water', ref: 'Everything that is not fat', v: leanLb, format: 'unit', unit: 'lb', decimals: 1, extra: true });
        rows.push({ k: 'Body fat classification', ref: bandLabel(FAT_BANDS, bodyFat), v: bodyFat, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: 'Fat-free mass index', ref: 'Lean mass in kg ÷ height in m squared', v: kgFromLb(leanLb) / (m * m), format: 'unit', unit: 'FFMI', decimals: 1 });
        rows.push({ k: 'BMI for comparison', ref: 'Cannot tell fat from muscle', v: bmi, format: 'unit', unit: 'BMI', decimals: 1 });

        if (visceralShare > 0) {
          const visceralOfBody = (bodyFat * visceralShare) / 100;
          const subcutOfBody = bodyFat - visceralOfBody;
          const ratio = visceralOfBody > 0 ? subcutOfBody / visceralOfBody : 0;
          rows.push({ k: 'Visceral fat as a share of body weight', ref: visceralShare.toFixed(1) + '% of your fat mass', v: visceralOfBody, format: 'unit', unit: '%', decimals: 1 });
          rows.push({ k: 'Subcutaneous fat as a share of body weight', ref: 'Total fat minus visceral', v: subcutOfBody, format: 'unit', unit: '%', decimals: 1 });
          rows.push({ k: 'Visceral fat mass', ref: 'The portion that reaches the liver first', v: (lb * visceralOfBody) / 100, format: 'unit', unit: 'lb', decimals: 1 });
          rows.push({ k: 'Subcutaneous-to-visceral ratio', ref: bandLabel(VISC_BANDS, visceralShare), v: ratio, format: 'unit', unit: 'to 1', decimals: 1 });
        }

        return {
          total: fatLb.toFixed(1) + ' lb fat / ' + leanLb.toFixed(1) + ' lb lean',
          sub:
            'Of your ' + lb.toFixed(1) + ' lb, ' + fatLb.toFixed(1) + ' lb is fat (' + bodyFat.toFixed(1) +
            '%) and ' + leanLb.toFixed(1) + ' lb is lean mass. Classification: ' + bandLabel(FAT_BANDS, bodyFat) + '.',
          rows: rows,
          format: 'plain',
          position: scalePos(bmi),
          positionLabel: 'BMI ' + bmi.toFixed(1) + ' · ' + bodyFat.toFixed(1) + '% body fat',
          chart: scaleChart(),
        };
      }

      // ---- Waist and hips -----------------------------------------------------
      if (id === 'waist') {
        if (!(waistIn > 0)) {
          return {
            total: 'Enter a waist measurement',
            sub: 'Measure horizontally at navel level, at the end of a normal breath out.',
            rows: [],
            chart: [],
            format: 'plain',
          };
        }
        const waistCm = cmFromIn(waistIn);
        const incThreshold = isMale ? WAIST_CM.maleIncreased : WAIST_CM.femaleIncreased;
        const highThreshold = isMale ? WAIST_CM.maleHigh : WAIST_CM.femaleHigh;
        const waistBand =
          waistCm < incThreshold ? 'No increased risk'
            : waistCm < highThreshold ? 'Increased risk' : 'Substantially elevated risk';

        rows.push({ k: 'Waist circumference', ref: waistCm.toFixed(1) + ' cm — ' + waistBand, v: waistIn, format: 'unit', unit: 'in', decimals: 2, extra: true });
        rows.push({ k: 'WHO increased-risk threshold', ref: incThreshold + ' cm for ' + (isMale ? 'men' : 'women'), v: inFromCm(incThreshold), format: 'unit', unit: 'in', decimals: 1 });
        rows.push({ k: 'WHO substantially-elevated threshold', ref: highThreshold + ' cm for ' + (isMale ? 'men' : 'women'), v: inFromCm(highThreshold), format: 'unit', unit: 'in', decimals: 1 });
        rows.push({ k: 'Inches over the increased-risk line', ref: 'Negative means you are under it', v: waistIn - inFromCm(incThreshold), format: 'unit', unit: 'in', decimals: 2 });

        const whtr = waistIn / totalIn;
        rows.push({ k: 'Waist-to-height ratio', ref: 'Keep it under ' + WHTR + ' — waist below half your height', v: whtr, format: 'plain', decimals: 3, extra: true });
        rows.push({ k: 'Waist at the 0.5 limit for your height', ref: 'Half of ' + totalIn + ' in', v: totalIn * WHTR, format: 'unit', unit: 'in', decimals: 1 });

        if (hipIn > 0) {
          const whr = waistIn / hipIn;
          const lowT = isMale ? WHR.maleLow : WHR.femaleLow;
          const highT = isMale ? WHR.maleHigh : WHR.femaleHigh;
          const whrBand = whr < lowT ? 'Low risk' : whr <= highT ? 'Moderate risk' : 'High risk';
          rows.push({ k: 'Waist-to-hip ratio', ref: 'WHO 2008 — ' + whrBand, v: whr, format: 'plain', decimals: 2, extra: true });
          rows.push({ k: 'Low-risk ceiling for ' + (isMale ? 'men' : 'women'), ref: 'Below this is low risk', v: lowT, format: 'plain', decimals: 2 });
          rows.push({ k: 'High-risk floor for ' + (isMale ? 'men' : 'women'), ref: 'Above this is high risk', v: highT, format: 'plain', decimals: 2 });
        }

        rows.push({ k: 'BMI for comparison', ref: 'Where BMI and waist disagree, act on the waist', v: bmi, format: 'unit', unit: 'BMI', decimals: 1 });

        return {
          total: waistIn.toFixed(1) + ' in — ' + waistBand,
          sub:
            'Waist ' + waistIn.toFixed(1) + ' in (' + waistCm.toFixed(0) + ' cm) · waist-to-height ' + whtr.toFixed(3) +
            (whtr < WHTR ? ' (under the 0.5 line)' : ' (over the 0.5 line)') +
            (hipIn > 0 ? ' · waist-to-hip ' + (waistIn / hipIn).toFixed(2) : ''),
          rows: rows,
          format: 'plain',
          position: scalePos(bmi),
          positionLabel: 'BMI ' + bmi.toFixed(1) + ' · waist ' + waistIn.toFixed(1) + ' in',
          chart: scaleChart(),
        };
      }

      // ---- Adult and 65+ ------------------------------------------------------
      const senior = id === 'senior' || age >= 65;
      const loBmi = senior ? SENIOR.min : HEALTHY.min;
      const hiBmi = senior ? SENIOR.max : HEALTHY.max;

      let category;
      if (senior) {
        if (bmi < SENIOR.min) category = 'Nutritional risk / underweight for 65+';
        else if (bmi < SENIOR.max) category = 'Healthy weight for 65+';
        else if (bmi < 30) category = 'Mild overweight — low risk at 65+';
        else if (bmi < 35) category = 'Obesity class I';
        else category = 'Obesity class II–III';
      } else {
        if (bmi < 18.5) category = 'Underweight';
        else if (bmi < 25) category = 'Healthy weight';
        else if (bmi < 30) category = 'Overweight';
        else if (bmi < 35) category = 'Obesity class I';
        else if (bmi < 40) category = 'Obesity class II';
        else category = 'Obesity class III';
      }

      const loLb = lbFromKg(loBmi * m * m);
      const hiLb = lbFromKg(hiBmi * m * m);

      rows.push({ k: 'Body mass index', ref: 'Weight in kg ÷ height in m squared (WHO)', v: bmi, format: 'unit', unit: 'BMI', decimals: 1, extra: true });
      rows.push({ k: 'Healthy weight — lower end', ref: 'BMI ' + loBmi + (senior ? ' (ESPEN 2018, age 65+)' : ' (WHO)'), v: loLb, format: 'unit', unit: 'lb', decimals: 1 });
      rows.push({ k: 'Healthy weight — upper end', ref: 'BMI ' + hiBmi + (senior ? ' (ESPEN 2018, age 65+)' : ' (WHO)'), v: hiLb, format: 'unit', unit: 'lb', decimals: 1 });
      rows.push({
        k: bmi > hiBmi ? 'Pounds above the healthy range' : bmi < loBmi ? 'Pounds below the healthy range' : 'Pounds of room left in the range',
        ref: bmi > hiBmi ? 'To reach BMI ' + hiBmi : bmi < loBmi ? 'To reach BMI ' + loBmi : 'Distance to the top of the range',
        v: bmi > hiBmi ? lb - hiLb : bmi < loBmi ? loLb - lb : hiLb - lb,
        format: 'unit',
        unit: 'lb',
        decimals: 1,
        extra: true,
      });

      if (senior) {
        rows.push({ k: 'WHO older-adult range — lower end', ref: 'BMI ' + SENIOR.whoMin, v: lbFromKg(SENIOR.whoMin * m * m), format: 'unit', unit: 'lb', decimals: 1 });
        rows.push({ k: 'WHO older-adult range — upper end', ref: 'BMI ' + SENIOR.whoMax, v: lbFromKg(SENIOR.whoMax * m * m), format: 'unit', unit: 'lb', decimals: 1 });
        rows.push({ k: 'Standard adult healthy range for reference — lower end', ref: 'BMI 18.5, not the one that applies to you', v: lbFromKg(HEALTHY.min * m * m), format: 'unit', unit: 'lb', decimals: 1 });
        rows.push({ k: 'Standard adult healthy range for reference — upper end', ref: 'BMI 24.9, not the one that applies to you', v: lbFromKg(HEALTHY.max * m * m), format: 'unit', unit: 'lb', decimals: 1 });
        rows.push({ k: 'Weight loss that warrants medical review', ref: '5% of body weight over 6 months, unintentional', v: lb * 0.05, format: 'unit', unit: 'lb', decimals: 1 });
      }

      // Ideal body weight formulas, all in kg then converted to pounds.
      const over60 = Math.max(0, totalIn - 60);
      const devineKg = (isMale ? IBW.devine.male : IBW.devine.female) + IBW.devine.perInch * over60;
      const robinsonKg =
        (isMale ? IBW.robinson.male : IBW.robinson.female) +
        (isMale ? IBW.robinson.malePerInch : IBW.robinson.femalePerInch) * over60;
      const hamwiKg =
        (isMale ? IBW.hamwi.male : IBW.hamwi.female) +
        (isMale ? IBW.hamwi.malePerInch : IBW.hamwi.femalePerInch) * over60;
      const lorentzKg = cm - 100 - (cm - 150) / (isMale ? IBW.lorentz.maleDivisor : IBW.lorentz.femaleDivisor);
      const avgKg = (devineKg + robinsonKg + hamwiKg + lorentzKg) / 4;

      rows.push({ k: 'Ideal weight — Devine', ref: (isMale ? '50' : '45.5') + ' kg + 2.3 kg per inch over 5 ft (1974)', v: lbFromKg(devineKg) * frame, format: 'unit', unit: 'lb', decimals: 1 });
      rows.push({ k: 'Ideal weight — Robinson', ref: (isMale ? '52 kg + 1.9' : '49 kg + 1.7') + ' kg per inch over 5 ft (1983)', v: lbFromKg(robinsonKg) * frame, format: 'unit', unit: 'lb', decimals: 1 });
      rows.push({ k: 'Ideal weight — Hamwi', ref: (isMale ? '48 kg + 2.7' : '45.5 kg + 2.2') + ' kg per inch over 5 ft (1964)', v: lbFromKg(hamwiKg) * frame, format: 'unit', unit: 'lb', decimals: 1 });
      rows.push({ k: 'Ideal weight — Lorentz', ref: 'cm − 100 − (cm − 150) ÷ ' + (isMale ? '4' : '2') + ' (1929)', v: lbFromKg(lorentzKg) * frame, format: 'unit', unit: 'lb', decimals: 1 });
      rows.push({ k: 'Average of the four formulas', ref: frameKey === 'medium' ? 'No frame adjustment applied' : frameKey + ' frame: ' + Math.round((frame - 1) * 100) + '% applied', v: lbFromKg(avgKg) * frame, format: 'unit', unit: 'lb', decimals: 1, extra: true });
      rows.push({ k: 'Spread between the four formulas', ref: 'How much the choice of formula matters', v: lbFromKg(Math.max(devineKg, robinsonKg, hamwiKg, lorentzKg) - Math.min(devineKg, robinsonKg, hamwiKg, lorentzKg)) * frame, format: 'unit', unit: 'lb', decimals: 1 });

      if (waistIn > 0) {
        const whtr = waistIn / totalIn;
        rows.push({ k: 'Waist-to-height ratio', ref: whtr < WHTR ? 'Under the 0.5 line' : 'Over the 0.5 line — abdominal fat risk', v: whtr, format: 'plain', decimals: 3 });
      }
      if (bodyFat > 0) {
        rows.push({ k: 'Fat mass', ref: bodyFat.toFixed(1) + '% — ' + bandLabel(FAT_BANDS, bodyFat), v: (lb * bodyFat) / 100, format: 'unit', unit: 'lb', decimals: 1 });
        rows.push({ k: 'Lean mass', ref: 'What BMI cannot separate out', v: lb - (lb * bodyFat) / 100, format: 'unit', unit: 'lb', decimals: 1 });
      }

      return {
        total: bmi.toFixed(1) + ' — ' + category,
        sub:
          'Healthy range for ' + Math.floor(totalIn / 12) + ' ft ' + (totalIn % 12) + ' in is ' +
          loLb.toFixed(0) + ' to ' + hiLb.toFixed(0) + ' lb' + (senior ? ' on the 65-plus scale' : '') +
          ' · the four ideal-weight formulas average ' + (lbFromKg(avgKg) * frame).toFixed(0) + ' lb.',
        rows: rows,
        format: 'plain',
        position: scalePos(bmi),
        positionLabel: 'BMI ' + bmi.toFixed(1) + ' — ' + category,
        chart: scaleChart(),
      };
    });
  })();
</script>
