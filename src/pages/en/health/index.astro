---
/**
 * Silo Health · English market — index of the /en/health decision hubs.
 * Exists so the hub breadcrumbs do not point at a 404 and so sibling hubs share
 * link equity. The listing comes from the registry, never by hand.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';

const HREF = '/en/health';
const SILO = 'Health';
const LEDE =
  'Weight, calories, lab results, fertility and training — worked out with the reference ranges the guidelines actually publish, and with the source named on every number.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${SILO} calculators and guides`,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title="Health calculators — weight, labs, fertility and training | Hacé Cuentas"
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
