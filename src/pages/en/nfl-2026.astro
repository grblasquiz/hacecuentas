---
// @incremental-standalone — isolated English sports landing.
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import data from '../../data/live/nfl-2026.json';
import nflClient from '../../scripts/nfl-season-client.js?raw';
import { eventTicketOffer } from '../../lib/offer-schema';

const PAGE_URL = 'https://hacecuentas.com/en/nfl-2026';
const ET = 'America/New_York';
const games = data.games || [];
const now = new Date();
const nextGame = games.find((game: any) => game.state !== 'post' && new Date(game.date) > now) || games[0];
const activeType = Number(nextGame?.seasonType || 1);
const activeWeek = Number(nextGame?.week || 1);
const initialGames = games.filter((game: any) => Number(game.seasonType) === activeType && Number(game.week) === activeWeek);
const calendarPhase = data.calendar?.find((phase: any) => Number(phase.value) === activeType);
const activeCalendarWeek = calendarPhase?.entries?.find((entry: any) => Number(entry.value) === activeWeek);
const upcoming = games.filter((game: any) => game.state !== 'post' && new Date(game.date) > now).slice(1, 4);
const internationalGames = games.filter((game: any) => game.seasonType === 2 && game.country !== 'USA');
const snapshot = JSON.stringify(data).replace(/</g, '\\u003c');

const format = (iso: string, options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-US', { timeZone:ET, ...options }).format(new Date(iso));
const gameDate = (game: any) => format(game.date, { weekday:'short', month:'short', day:'numeric' });
const gameTime = (game: any) => game.timeValid === false ? 'TBD' : format(game.date, { hour:'numeric', minute:'2-digit' });
const updated = format(data.fetchedAt, { month:'short', day:'numeric', year:'numeric', hour:'numeric', minute:'2-digit' });
const nextKickoff = `${gameDate(nextGame)} at ${gameTime(nextGame)} ET`;

const title = 'NFL Schedule 2026: Games, Scores & Standings | Hacé Cuentas';
const description = 'Complete 2026 NFL schedule with weekly matchups, kickoff times, TV channels, final scores, AFC/NFC standings, international games and Super Bowl LXI.';
const keywords = ['2026 NFL schedule','NFL schedule 2026','NFL games today','NFL scores','NFL standings 2026','NFL Week 1 schedule','NFL preseason schedule','Super Bowl LXI','NFL international games','NFL kickoff times'];
const newsKeywords = ['NFL 2026','NFL schedule','NFL scores','NFL standings','Super Bowl LXI','NFL international games'];
const hreflang = [{ lang:'en-US', href:PAGE_URL }, { lang:'x-default', href:PAGE_URL }];

const faqs = [
  {
    q: 'When does the 2026 NFL season start?',
    a: 'The 2026 preseason begins with the Pro Football Hall of Fame Game on Thursday, August 6. The regular season opens on Wednesday, September 9, when the defending champion Seattle Seahawks host the New England Patriots. Week 1 continues through Monday, September 14.',
  },
  {
    q: 'How many games are in the 2026 NFL regular season?',
    a: 'The regular-season schedule contains 272 games across 18 weeks. Each of the 32 teams plays 17 games and has one bye week. This page lets you browse every week without leaving the schedule.',
  },
  {
    q: 'Where can I see NFL scores after each game?',
    a: 'Final scores appear directly in the weekly schedule after ESPN confirms that a game is complete. The page does not publish partial or unofficial scores as final results.',
  },
  {
    q: 'How do I view NFL kickoff times in my time zone?',
    a: 'Use the time-zone selector above the weekly schedule. You can switch between Eastern, Central, Mountain, Pacific, United Kingdom or your device’s local time. Week 18 games marked TBD will update after the league announces their exact kickoff times.',
  },
  {
    q: 'How do the AFC and NFC standings work?',
    a: 'The NFL has two 16-team conferences, the AFC and NFC. Each conference is divided into East, North, South and West divisions. Division winners earn playoff berths, with the remaining spots awarded to the best wild-card records in each conference.',
  },
  {
    q: 'How many international games are on the 2026 NFL schedule?',
    a: `The 2026 regular season features ${internationalGames.length} international games across Australia, Brazil, England, France, Germany, Mexico and Spain. The full international slate is listed below with dates, venues and broadcast information.`,
  },
  {
    q: 'When and where is Super Bowl LXI?',
    a: 'Super Bowl LXI is scheduled for Sunday, February 14, 2027 at SoFi Stadium in Inglewood, California. It will decide the champion of the 2026 NFL season.',
  },
  {
    q: 'Where does the schedule and standings data come from?',
    a: 'The master schedule is verified against NFL.com. Matchups, kickoff times, broadcast information, final scores and standings are synchronized from ESPN. Flexible scheduling can change selected games later in the season, so always check the latest listed time.',
  },
];

const breadcrumb = {
  '@type':'BreadcrumbList',
  itemListElement:[
    { '@type':'ListItem', position:1, name:'Hacé Cuentas', item:'https://hacecuentas.com/en' },
    { '@type':'ListItem', position:2, name:'Sports', item:'https://hacecuentas.com/en/nfl-2026' },
    { '@type':'ListItem', position:3, name:'2026 NFL Schedule', item:PAGE_URL },
  ],
};
const webPage = {
  '@type':['WebPage','CollectionPage'],
  '@id':`${PAGE_URL}#webpage`, url:PAGE_URL,
  name:'2026 NFL Schedule, Scores and Standings',
  description, inLanguage:'en-US', dateModified:data.fetchedAt,
  about:{ '@type':'SportsOrganization', name:'National Football League', url:'https://www.nfl.com' },
};
// Shared nodes for the season event and every Week 1 game (subEvent): image +
// offers + performer, so no SportsEvent node is left without the fields Search
// Console flags across the sports pages. performer = the 32 real NFL teams.
const NFL_ORGANIZER = { '@type':'SportsOrganization', name:'National Football League', url:'https://www.nfl.com' };
const NFL_TICKETS = 'https://www.nfl.com/tickets/';
const EVENT_IMAGE = ['https://hacecuentas.com/og-default.png'];
const nflPerformers = (data.teams || []).map((t: any) => ({ '@type':'SportsTeam', name:t.name }));
const sportsEvent = {
  '@type':'SportsEvent',
  name:'2026 NFL season', sport:'American football',
  description,
  startDate:'2026-08-06', endDate:'2027-02-14',
  eventStatus:'https://schema.org/EventScheduled',
  image:EVENT_IMAGE,
  organizer:NFL_ORGANIZER,
  performer:nflPerformers,
  offers:eventTicketOffer({ url:NFL_TICKETS }),
  location:{ '@type':'Place', name:'United States and international host cities' },
  subEvent:games.filter((game: any) => game.seasonType === 2 && game.week === 1).map((game: any) => ({
    '@type':'SportsEvent', name:`${game.away.name} at ${game.home.name}`, startDate:game.date,
    description:`${game.away.name} at ${game.home.name}, Week 1 of the 2026 NFL season, at ${game.venue} in ${game.city}.`,
    eventStatus:'https://schema.org/EventScheduled',
    image:EVENT_IMAGE,
    location:{ '@type':'Place', name:game.venue, address:{ '@type':'PostalAddress', addressLocality:game.city, addressRegion:game.stateCode, addressCountry:game.country } },
    organizer:NFL_ORGANIZER,
    performer:[{ '@type':'SportsTeam', name:game.away.name }, { '@type':'SportsTeam', name:game.home.name }],
    competitor:[{ '@type':'SportsTeam', name:game.away.name }, { '@type':'SportsTeam', name:game.home.name }],
    offers:eventTicketOffer({ url:NFL_TICKETS }),
    url:game.href,
  })),
};
const dataset = {
  '@type':'Dataset', name:'2026 NFL schedule, scores and standings', description,
  creator:{ '@type':'Organization', name:'Hacé Cuentas', url:'https://hacecuentas.com' },
  isBasedOn:['https://www.nfl.com/schedules/','https://www.espn.com/nfl/schedule/'],
  temporalCoverage:'2026-08-06/2027-02-14', dateModified:data.fetchedAt, url:PAGE_URL,
};
const faqSchema = { '@type':'FAQPage', mainEntity:faqs.map((faq) => ({ '@type':'Question', name:faq.q, acceptedAnswer:{ '@type':'Answer', text:faq.a } })) };
const schema = { '@context':'https://schema.org', '@graph':[breadcrumb,webPage,sportsEvent,dataset,faqSchema] };

const staticTeams = (conference: string, division: string) => data.teams.filter((team: any) => team.conference === conference && team.division === division);
---

<Layout title={title} description={description} canonical="/en/nfl-2026" audience="US" lang="en" hreflang={hreflang} schema={schema} keywords={keywords} newsKeywords={newsKeywords} ogTitle="The complete 2026 NFL season, one week at a time" domain="life" pageType="data">
  <Header slot="header" lang="en" />

  <main class="nfl" data-nfl data-scoreboard-api="https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard" data-standings-api="https://site.api.espn.com/apis/v2/sports/football/nfl/standings?region=us&lang=en&contentorigin=espn&season=2026">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/en">Home</a><span>/</span><a href="/en#sports">Sports</a><span>/</span><strong>NFL 2026</strong></nav>

    <section class="hero" aria-labelledby="nfl-title">
      <div class="hero-copy">
        <div class="eyebrow"><i></i><span data-season-status>SCHEDULE RELEASED</span><b>2026–27</b></div>
        <h1 id="nfl-title"><i class="sr-only">2026 NFL schedule: </i><span>EVERY WEEK.</span> EVERY GAME.<br/>ONE SEASON.</h1>
        <p>The complete 2026 NFL schedule, final scores and playoff race—organized for fast, no-noise game-day checking.</p>
        <div class="hero-actions"><a href="#schedule" class="primary">Browse the schedule <b>↓</b></a><a href="https://www.nfl.com/schedules/2026/" target="_blank" rel="noopener" class="secondary">Official NFL schedule ↗</a></div>
        <dl><div><dt>32</dt><dd>TEAMS</dd></div><div><dt>18</dt><dd>WEEKS</dd></div><div><dt>272</dt><dd>GAMES</dd></div><div><dt>{internationalGames.length}</dt><dd>INT'L</dd></div></dl>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="field"><span class="yard y20">20</span><span class="yard y40">40</span><span class="yard y50">50</span><span class="yard y60">40</span><span class="yard y80">20</span><i class="football"><b></b></i><strong>NFL<br/>2026</strong></div>
      </div>
    </section>

    <section class="kickoff-grid" aria-label="Next NFL games">
      <article class="spotlight" data-featured>
        <div class="spotlight-kicker"><span>NEXT KICKOFF</span><b>{nextGame.weekLabel}</b></div>
        <div class="spotlight-teams"><div><img width="48" height="48" src={nextGame.away.logo} alt=""/><strong>{nextGame.away.abbr}</strong><em>—</em></div><i>@</i><div><img width="48" height="48" src={nextGame.home.logo} alt=""/><strong>{nextGame.home.abbr}</strong><em>—</em></div></div>
        <div class="spotlight-details"><b>{nextKickoff}</b><span>{nextGame.broadcasts.join(' · ')} · {nextGame.venue}</span></div>
        <a href={nextGame.href} target="_blank" rel="noopener">Game details <b>→</b></a>
      </article>
      <aside class="up-next"><header><span>UP NEXT</span><a href="#schedule">Full week →</a></header><div data-upcoming>{upcoming.map((game: any) => <a href={game.href} target="_blank" rel="noopener"><span><img width="48" height="48" src={game.away.logo} alt=""/>{game.away.abbr} <i>at</i> <img width="48" height="48" src={game.home.logo} alt=""/>{game.home.abbr}</span><b>{gameDate(game)}<small>{gameTime(game)} ET</small></b></a>)}</div><footer><span>All times can be changed</span><b>by NFL flex scheduling</b></footer></aside>
    </section>

    <section class="schedule" id="schedule" aria-labelledby="schedule-title">
      <header class="section-head"><div><span>SEASON CENTER</span><h2 id="schedule-title">2026 NFL schedule</h2><p>Jump between every phase and week. Scores appear only after a game is final.</p></div><label class="timezone">Time zone<select data-timezone aria-label="Schedule time zone"><option value="America/New_York">Eastern (ET)</option><option value="America/Chicago">Central (CT)</option><option value="America/Denver">Mountain (MT)</option><option value="America/Los_Angeles">Pacific (PT)</option><option value="Europe/London">United Kingdom</option><option value="local">My local time</option></select><small data-tz-label>Times shown in ET</small></label></header>
      <div class="schedule-shell">
        <div class="schedule-tools"><div class="phase-tabs" data-phase-tabs>{[1,2,3].map((type) => <button type="button" class:list={{active:type === activeType}} aria-pressed={type === activeType}>{type === 1 ? 'Preseason' : type === 2 ? 'Regular season' : 'Playoffs'}</button>)}</div><label>Choose week<select data-week-select>{calendarPhase?.entries?.map((entry: any) => <option value={entry.value} selected={entry.value === activeWeek}>{entry.label} · {entry.detail}</option>)}</select></label></div>
        <div class="week-title" data-week-label><span>{activeCalendarWeek?.label}</span><b>{activeCalendarWeek?.detail}</b></div>
        <div class="game-list" data-game-list>{initialGames.map((game: any) => <a class="game-card" href={game.href} target="_blank" rel="noopener"><div class="game-meta"><span>{game.state === 'post' ? 'FINAL' : `${gameDate(game)} · ${gameTime(game)} ET`}</span><b>{game.broadcasts.join(' · ') || 'TV TBD'}</b></div><div class="matchup"><div><img width="48" height="48" src={game.away.logo} alt=""/><span><strong>{game.away.shortName}</strong><small>{game.away.record || 'Away'}</small></span><em>{game.state === 'post' ? game.away.score : ''}</em></div><div><img width="48" height="48" src={game.home.logo} alt=""/><span><strong>{game.home.shortName}</strong><small>{game.home.record || 'Home'}</small></span><em>{game.state === 'post' ? game.home.score : ''}</em></div></div><footer><span>{[game.venue,game.city,game.stateCode].filter(Boolean).join(' · ')}</span><b>{game.state === 'post' ? 'Game recap' : 'Matchup details'} →</b></footer></a>)}</div>
      </div>
    </section>

    <section class="standings-section" id="standings" aria-labelledby="standings-title">
      <header class="section-head"><div><span>PLAYOFF PICTURE</span><h2 id="standings-title">AFC & NFC standings</h2><p>Conference and division records update after completed games.</p></div><div class="conference-tabs" data-conference-tabs><button type="button" class="active" aria-pressed="true">AFC</button><button type="button" aria-pressed="false">NFC</button></div></header>
      <div class="standings-grid" data-standings>{['East','North','South','West'].map((division) => <section class="division"><header><span>AFC</span><h3>{division}</h3></header><div class="standing-head"><span>Team</span><b>W</b><b>L</b><b>T</b><b>PCT</b></div>{staticTeams('AFC',division).map((team: any) => <a href={`https://www.espn.com/nfl/team/_/name/${team.abbr.toLowerCase()}`} target="_blank" rel="noopener"><span><img width="48" height="48" src={team.logo} alt=""/>{team.shortName}</span><b>0</b><b>0</b><b>0</b><b>.000</b></a>)}</section>)}</div>
    </section>

    <section class="key-dates" aria-labelledby="key-dates-title">
      <header class="section-head"><div><span>MARK THE CALENDAR</span><h2 id="key-dates-title">Four dates that define the season</h2></div></header>
      <ol><li><time>Aug 6</time><span><b>Hall of Fame Game</b><small>Panthers vs. Cardinals · Canton, Ohio</small></span></li><li><time>Sep 9</time><span><b>NFL Kickoff</b><small>Patriots at Seahawks · Week 1</small></span></li><li><time>Jan 10</time><span><b>Regular-season finale</b><small>Week 18 · kickoff times TBD</small></span></li><li class="final"><time>Feb 14</time><span><b>Super Bowl LXI</b><small>SoFi Stadium · Inglewood, California</small></span></li></ol>
    </section>

    <section class="international" aria-labelledby="international-title">
      <header class="section-head"><div><span>GLOBAL SERIES</span><h2 id="international-title">Nine international games</h2><p>The NFL’s biggest international slate yet spans four continents and seven countries.</p></div><a href="https://www.nfl.com/international/games" target="_blank" rel="noopener">NFL International ↗</a></header>
      <div>{internationalGames.map((game: any) => <a href={game.href} target="_blank" rel="noopener"><small>WEEK {game.week} · {game.country}</small><strong>{game.away.abbr} <i>at</i> {game.home.abbr}</strong><span>{gameDate(game)} · {gameTime(game)} ET</span><em>{game.venue}</em></a>)}</div>
    </section>

    <section class="seo-copy" aria-label="About the 2026 NFL season">
      <div class="answer"><span>THE FULL SEASON, WITHOUT THE CLUTTER</span><h2>Your 2026 NFL schedule and score tracker</h2><p>The <strong>2026 NFL season</strong> features 32 teams, 272 regular-season games and an 18-week schedule. Use this page to find the next kickoff, browse every weekly matchup, check television coverage and follow the AFC and NFC standings. The schedule includes all preseason games, the full regular season, nine international matchups and the road to <strong>Super Bowl LXI</strong>.</p><p>Kickoff times are displayed in the time zone you choose. Later-season games remain subject to the NFL’s flexible scheduling rules, especially Weeks 16 through 18. When a game finishes, its score is published only after the data source marks the result as final.</p></div>
      <div class="faq"><span>QUICK ANSWERS</span><h2>2026 NFL schedule FAQ</h2>{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div>
    </section>

    <section class="network"><div><span>MORE FROM HACÉ CUENTAS</span><h2>Numbers for the rest of your game</h2></div><nav><a href="/en"><small>EXPLORE</small><strong>All English calculators</strong><span>Browse tools →</span></a><a href="/en/1rm-calculator"><small>STRENGTH</small><strong>One-rep max calculator</strong><span>Estimate your max →</span></a><a href="/en/calories-burned-calculator"><small>FITNESS</small><strong>Calories burned by sport</strong><span>Open calculator →</span></a></nav></section>
    <p class="source">Schedule verified with <a href="https://www.nfl.com/schedules/2026/" target="_blank" rel="noopener">NFL.com</a>. Matchups, broadcasts, final scores and standings: ESPN. Snapshot updated <time datetime={data.fetchedAt}>{updated} ET</time>.</p>
    <script id="nfl-season-snapshot" type="application/json" set:html={snapshot}></script>
  </main>

  <Footer slot="footer" lang="en" />
</Layout>

<script is:inline set:html={nflClient}></script>

<style is:global>
#main{padding:0;width:100%}
.nfl{--bg:#06100e;--panel:#0c1916;--panel-2:#11231e;--line:#263a33;--text:#f7fbf9;--muted:#9cafaa;--lime:#b7ff3c;--orange:#ff6b2c;--blue:#78b7ff;background:var(--bg);color:var(--text);font-family:var(--font-body,Inter,system-ui);min-height:100vh;padding-bottom:64px;width:100%}
.nfl *{box-sizing:border-box}.nfl a{color:inherit}.nfl h1,.nfl h2,.nfl h3,.nfl strong,.nfl b{color:var(--text)}.nfl p{color:var(--muted)}
.nfl .sr-only{height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px;clip:rect(0,0,0,0);white-space:nowrap}
.nfl>section,.nfl>.crumbs,.nfl>.source{margin-inline:auto;width:min(1180px,calc(100% - 48px))}
.crumbs{align-items:center;color:#6f8980;display:flex;font-size:11px;gap:8px;padding:16px 0}.crumbs a{color:#a9bbb5;text-decoration:none}.crumbs strong{color:#fff}
