---
/**
 * Hub EN — "What are my training zones and what do I eat during the race?"
 * audience="US" y lang="en" literales; el mercado real viaja en hub.locale.
 * Rama de cafeína = YMYL-dosis: disclaimer médico en fineprint y primer warn de cada rama.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  FTP_FROM_20MIN,
  POWER_ZONES,
  KG_PER_LB,
  M_PER_YD,
  MLSS_PACE_BANDS,
  SWIM_BANDS,
  SWOLF_BANDS,
  CARBS_PER_HOUR_G,
  GEL_CARBS_G,
  FUEL_THRESHOLD_H,
  CAFFEINE_MG_PER_KG,
  CAFFEINE_DAILY_CAP_MG,
  MG_PER_COFFEE,
} from '../../../lib/hubs/en/endurance-thresholds';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/en' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    FTP_FROM_20MIN,
    POWER_ZONES,
    KG_PER_LB,
    M_PER_YD,
    MLSS_PACE_BANDS,
    SWIM_BANDS,
    SWOLF_BANDS,
    CARBS_PER_HOUR_G,
    GEL_CARBS_G,
    FUEL_THRESHOLD_H,
    CAFFEINE_MG_PER_KG,
    CAFFEINE_DAILY_CAP_MG,
    MG_PER_COFFEE,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const KM_PER_MILE = 1.609344;
    const n0 = (x) => Math.round(x || 0).toLocaleString('en-US');
    const mmss = (s) => {
      const t = Math.max(0, Math.round(s || 0));
      return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0');
    };
    /** Minutos decimales → mm:ss. */
    const pace = (min) => mmss(min * 60);

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'ftp';

      if (id === 'cp') {
        const p1 = Math.max(1, v.p1 || 1);
        const t1 = Math.max(1, v.t1 || 1);
        const p2 = Math.max(1, v.p2 || 1);
        const t2 = Math.max(1, v.t2 || 1);
        if (t1 === t2 || p1 === p2) {
          return {
            total: 'Two different efforts needed',
            sub: 'The two durations must differ and the two power values must differ — otherwise the model has no solution. Use something like 3 minutes and 10 to 12 minutes.',
            rows: [
              { k: 'Shorter effort power', ref: 'As entered', v: p1, format: 'unit', unit: 'W' },
              { k: 'Longer effort power', ref: 'As entered', v: p2, format: 'unit', unit: 'W' },
            ],
            chart: [{ label: 'Shorter effort (W)', value: Math.round(p1), tone: 'main' }, { label: 'Longer effort (W)', value: Math.round(p2), tone: 'warn' }],
          };
        }
        const cp = (p1 * t1 - p2 * t2) / (t1 - t2);
        const wPrimeJ = (p1 - cp) * t1;
        if (cp <= 0 || wPrimeJ <= 0) {
          return {
            total: 'These efforts do not fit the model',
            sub: 'For a positive Critical Power the shorter effort has to be the more powerful one: P1 greater than P2 with t1 less than t2. Check that both efforts were genuinely maximal for their duration.',
            rows: [
              { k: 'Critical Power the inputs imply', ref: 'Negative or zero — inputs inconsistent', v: cp, format: 'unit', unit: 'W', decimals: 1 },
              { k: 'W′ the inputs imply', ref: 'Negative or zero — inputs inconsistent', v: wPrimeJ / 1000, format: 'unit', unit: 'kJ', decimals: 1 },
            ],
            chart: [{ label: 'Shorter effort (W)', value: Math.round(p1), tone: 'main' }, { label: 'Longer effort (W)', value: Math.round(p2), tone: 'warn' }],
          };
        }
        const lb = Math.max(1, v.bodyLb || 1);
        const kg = lb * KG_PER_LB;
        const tlim50 = wPrimeJ / 50 / 60;
        const ftpEquiv = Math.max(1, v.w20 || 1) * FTP_FROM_20MIN;
        const rows = [
          { k: 'Critical Power', ref: '(P1·t1 − P2·t2) ÷ (t1 − t2)', v: cp, format: 'unit', unit: 'W', decimals: 1, extra: true },
          { k: 'W′, the anaerobic reserve', ref: '(P1 − CP) × t1', v: wPrimeJ / 1000, format: 'unit', unit: 'kJ', decimals: 2, extra: true },
          { k: 'W′ in joules', ref: 'The same number, unrounded unit', v: wPrimeJ, format: 'unit', unit: 'J' },
          { k: 'Critical Power per pound', ref: (cp / kg).toFixed(2) + ' W/kg', v: cp / lb, format: 'unit', unit: 'W/lb', decimals: 3 },
          { k: 'How long you can hold CP + 50 W', ref: 'Until W′ is empty', v: tlim50, format: 'unit', unit: 'min', decimals: 1 },
          { k: 'How long you can hold CP + 100 W', ref: 'Twice the power above CP, half the time', v: wPrimeJ / 100 / 60, format: 'unit', unit: 'min', decimals: 1 },
          { k: 'A 20-minute-test FTP, for comparison', ref: '95% of the 20-minute power field', v: ftpEquiv, format: 'unit', unit: 'W', decimals: 0 },
          { k: 'Gap between that FTP and your CP', ref: 'CP usually reads a few watts lower', v: ftpEquiv - cp, format: 'unit', unit: 'W', decimals: 1 },
        ];
        return {
          total: Math.round(cp) + ' W',
          sub:
            'W′ of ' + (wPrimeJ / 1000).toFixed(1) + ' kJ — the finite work available above CP · at 50 W over CP that lasts about ' +
            tlim50.toFixed(1) + ' minutes · ' + (cp / kg).toFixed(2) + ' W/kg (' + (cp / lb).toFixed(3) +
            ' W/lb) · both efforts have to have been genuinely maximal',
          rows: rows,
          chart: [
            { label: 'Critical Power (W)', value: Math.round(cp), tone: 'main' },
            { label: 'Extra watts W′ buys for 5 min', value: Math.round(wPrimeJ / 300), tone: 'warn' },
          ],
        };
      }

      if (id === 'mlss') {
        const hr = Math.max(60, v.thrHr || 165);
        let band = MLSS_PACE_BANDS[MLSS_PACE_BANDS.length - 1];
        for (let n = 0; n < MLSS_PACE_BANDS.length; n++) {
          if (hr < MLSS_PACE_BANDS[n].maxHr) { band = MLSS_PACE_BANDS[n]; break; }
        }
        const loMi = band.loMinKm * KM_PER_MILE;
        const hiMi = band.hiMinKm * KM_PER_MILE;
        const midMi = (loMi + hiMi) / 2;
        const rows = [
          { k: 'Threshold heart rate', ref: 'As entered', v: hr, format: 'unit', unit: 'bpm' },
          { k: 'Threshold pace, fast end', ref: pace(loMi) + ' /mi', v: loMi, format: 'unit', unit: 'min/mi', decimals: 2, extra: true },
          { k: 'Threshold pace, slow end', ref: pace(hiMi) + ' /mi', v: hiMi, format: 'unit', unit: 'min/mi', decimals: 2, extra: true },
          { k: 'Threshold pace per kilometre, fast end', ref: pace(band.loMinKm) + ' /km', v: band.loMinKm, format: 'unit', unit: 'min/km', decimals: 2 },
          { k: 'Threshold pace per kilometre, slow end', ref: pace(band.hiMinKm) + ' /km', v: band.hiMinKm, format: 'unit', unit: 'min/km', decimals: 2 },
          { k: 'Speed at the middle of the band', ref: (60 / ((band.loMinKm + band.hiMinKm) / 2)).toFixed(2) + ' km/h', v: 60 / midMi, format: 'unit', unit: 'mph', decimals: 2 },
          { k: 'Distance a 20-minute tempo run covers at that pace', ref: 'The classic threshold session', v: 20 / midMi, format: 'unit', unit: 'mi', decimals: 2 },
          { k: 'Roughly what you could race for an hour', ref: 'Threshold pace, by definition', v: 60 / midMi, format: 'unit', unit: 'mi', decimals: 2 },
        ];
        return {
          total: pace(loMi) + '–' + pace(hiMi) + ' /mi',
          sub:
            pace(band.loMinKm) + '–' + pace(band.hiMinKm) + ' per km at a threshold heart rate of ' + Math.round(hr) +
            ' · this is a reference band keyed to heart rate, not a lactate measurement — confirm it against a recent race, since threshold pace is roughly what you could hold for an hour',
          rows: rows,
          chart: [
            { label: 'Fast end (min/mi)', value: Math.round(loMi * 100) / 100, tone: 'good' },
            { label: 'Slow end (min/mi)', value: Math.round(hiMi * 100) / 100, tone: 'warn' },
          ],
        };
      }

      if (id === 'swimpace') {
        const raw = Math.max(1, v.swimDist || 1);
        const isYd = String(v.swimUnit || 'm') === 'yd';
        const meters = isYd ? raw * M_PER_YD : raw;
        const yards = meters / M_PER_YD;
        const sec = Math.max(1, (v.swimMin || 0) * 60);
        const per100m = (sec / meters) * 100;
        const per100yd = (sec / yards) * 100;
        const speed = meters / sec;
        let level = SWIM_BANDS[SWIM_BANDS.length - 1].label;
        for (let n = 0; n < SWIM_BANDS.length; n++) {
          if (per100m < SWIM_BANDS[n].under) { level = SWIM_BANDS[n].label; break; }
        }
        const rows = [
          { k: 'Distance swum', ref: Math.round(yards) + ' yd', v: meters, format: 'unit', unit: 'm' },
          { k: 'Time taken', ref: mmss(sec), v: sec / 60, format: 'unit', unit: 'min', decimals: 2 },
          { k: 'Pace per 100 metres', ref: mmss(per100m) + ' /100 m', v: per100m, format: 'unit', unit: 's', decimals: 1, extra: true },
          { k: 'Pace per 100 yards', ref: mmss(per100yd) + ' /100 yd', v: per100yd, format: 'unit', unit: 's', decimals: 1, extra: true },
          { k: 'Speed', ref: 'Metres covered per second', v: speed, format: 'unit', unit: 'm/s', decimals: 2 },
          { k: 'Seconds per 100 to reach the next band', ref: level === 'Elite' ? 'You are already in the top band' : 'Improvement needed', v: level === 'Elite' ? 0 : Math.max(0, per100m - (level === 'Advanced' ? 65 : level === 'Intermediate' ? 90 : 120)), format: 'unit', unit: 's', decimals: 1 },
          { k: 'Time this pace would give over 1,650 yards', ref: 'The classic US distance event', v: (per100yd * 16.5) / 60, format: 'unit', unit: 'min', decimals: 1 },
        ];
        return {
          total: mmss(per100m) + ' /100 m',
          sub:
            mmss(per100yd) + ' per 100 yd · ' + speed.toFixed(2) + ' m/s · that is ' + level +
            ' level for freestyle · pool length changes this number, so compare only like with like',
          rows: rows,
          chart: [
            { label: 'Your pace (s/100 m)', value: Math.round(per100m), tone: per100m < 90 ? 'good' : 'warn' },
            { label: 'Advanced benchmark (s/100 m)', value: 90, tone: 'main' },
          ],
        };
      }

      if (id === 'swolf') {
        const t = Math.max(1, v.lapSec || 1);
        const b = Math.max(1, Math.round(v.strokes || 1));
        const swolf = t + b;
        let level = SWOLF_BANDS[SWOLF_BANDS.length - 1].label;
        for (let n = 0; n < SWOLF_BANDS.length; n++) {
          if (swolf < SWOLF_BANDS[n].under) { level = SWOLF_BANDS[n].label; break; }
        }
        // Un largo de piscina estándar en EE.UU. son 25 yardas.
        const lapYd = 25;
        const rows = [
          { k: 'Seconds for the lap', ref: 'Half of the score', v: t, format: 'unit', unit: 's' },
          { k: 'Strokes in the lap', ref: 'The other half', v: b, format: 'unit', unit: 'strokes' },
          { k: 'SWOLF score', ref: 'Seconds plus strokes — lower is better', v: swolf, format: 'plain', extra: true },
          { k: 'Distance covered per stroke', ref: 'Assuming a 25-yard lap', v: lapYd / b, format: 'unit', unit: 'yd/stroke', decimals: 2, extra: true },
          { k: 'Share of the score coming from time', ref: 'The lever you pull with fitness', v: (t / swolf) * 100, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Share coming from stroke count', ref: 'The lever you pull with technique', v: (b / swolf) * 100, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Points to the next band down', ref: level === 'Elite' ? 'You are already in the top band' : 'How much to shave off', v: level === 'Elite' ? 0 : Math.max(0, swolf - (level === 'Advanced' ? 39 : level === 'Intermediate' ? 55 : 69)), format: 'plain' },
          { k: 'Score if you removed two strokes at the same time', ref: 'Better glide, same speed', v: swolf - 2, format: 'plain' },
        ];
        return {
          total: 'SWOLF ' + swolf,
          sub:
            level + ' level · ' + Math.round(t) + ' seconds plus ' + b + ' strokes · about ' + (lapYd / b).toFixed(2) +
            ' yards per stroke in a 25-yard pool · only comparable within the same pool length, and gliding your way to a low score does not make you faster',
          rows: rows,
          chart: [
            { label: 'Seconds', value: Math.round(t), tone: 'main' },
            { label: 'Strokes', value: b, tone: 'warn' },
          ],
        };
      }

      if (id === 'fuel') {
        const h = Math.max(0.25, v.raceH || 0.25);
        const gels = h < FUEL_THRESHOLD_H ? 0 : Math.ceil((h * CARBS_PER_HOUR_G) / GEL_CARBS_G);
        const carbs = gels * GEL_CARBS_G;
        const needed = h * CARBS_PER_HOUR_G;
        const everyMin = gels > 0 ? (h * 60) / gels : 0;
        const rows = [
          { k: 'Expected race duration', ref: Math.round(h * 60) + ' minutes', v: h, format: 'unit', unit: 'hours', decimals: 2 },
          { k: 'Carbohydrate target', ref: '60 g per hour beyond 75 minutes', v: gels > 0 ? needed : 0, format: 'unit', unit: 'g', decimals: 0 },
          { k: 'Standard 30 g gels to carry', ref: gels > 0 ? 'Rounded up so you never run short' : 'Under 75 minutes your own glycogen covers it', v: gels, format: 'unit', unit: 'gels', extra: true },
          { k: 'Carbohydrate those gels supply', ref: '30 g each', v: carbs, format: 'unit', unit: 'g', extra: true },
          { k: 'Take one roughly every', ref: gels > 0 ? 'Start at about minute 40' : 'Not applicable at this duration', v: everyMin, format: 'unit', unit: 'min', decimals: 0 },
          { k: 'Water to take with them', ref: 'About 6 fl oz per gel', v: gels * 6, format: 'unit', unit: 'fl oz' },
          { k: 'Ceiling for glucose alone', ref: 'The SGLT1 transporter saturates here', v: CARBS_PER_HOUR_G, format: 'unit', unit: 'g/h' },
          { k: 'Ceiling with a glucose–fructose blend', ref: 'A second transporter, for trained guts', v: 90, format: 'unit', unit: 'g/h' },
        ];
        return {
          total: gels + (gels === 1 ? ' gel' : ' gels'),
          sub:
            gels > 0
              ? carbs + ' g of carbohydrate for ' + h + ' hours · one every ' + Math.round(everyMin) +
                ' minutes starting around minute 40, each with about 6 fl oz of plain water · never trial a new product on race day'
              : 'Under about 75 minutes your own glycogen stores cover the effort — water is enough, and a gel adds nothing but a risk of stomach trouble',
          rows: rows,
          chart: [
            { label: 'Carbs from gels (g)', value: carbs, tone: 'good' },
            { label: 'Carbs the duration calls for (g)', value: Math.round(gels > 0 ? needed : 0), tone: 'main' },
          ],
        };
      }

      if (id === 'caffeine') {
        const lb = Math.max(1, v.bodyLb || 1);
        const kg = lb * KG_PER_LB;
        const tol = CAFFEINE_MG_PER_KG[String(v.tolerance)] ? String(v.tolerance) : 'medium';
        const band = CAFFEINE_MG_PER_KG[tol];
        let lo = kg * band.lo;
        let hi = kg * band.hi;
        const capped = hi > CAFFEINE_DAILY_CAP_MG;
        if (hi > CAFFEINE_DAILY_CAP_MG) hi = CAFFEINE_DAILY_CAP_MG;
        if (lo > hi) lo = hi;
        const rows = [
          { k: 'Body weight', ref: kg.toFixed(1) + ' kg', v: lb, format: 'unit', unit: 'lb', decimals: 0 },
          { k: 'Dose per kilogram applied', ref: 'ISSN range for your stated tolerance', v: band.hi, format: 'unit', unit: 'mg/kg', decimals: 1 },
          { k: 'Dose per pound applied', ref: 'The same range in US units', v: band.hi * KG_PER_LB, format: 'unit', unit: 'mg/lb', decimals: 2 },
          { k: 'Lower end of your dose', ref: 'Start here if you have not tried it', v: lo, format: 'unit', unit: 'mg', extra: true },
          { k: 'Upper end of your dose', ref: capped ? 'Capped at the EFSA daily ceiling' : 'Within the EFSA daily ceiling', v: hi, format: 'unit', unit: 'mg', extra: true },
          { k: 'Cups of filter coffee at the low end', ref: 'About 95 mg per cup', v: lo / MG_PER_COFFEE, format: 'unit', unit: 'cups', decimals: 1 },
          { k: 'Cups of filter coffee at the high end', ref: 'About 95 mg per cup', v: hi / MG_PER_COFFEE, format: 'unit', unit: 'cups', decimals: 1 },
          { k: 'EFSA daily ceiling for a healthy adult', ref: 'Everything you drink today counts against it', v: CAFFEINE_DAILY_CAP_MG, format: 'unit', unit: 'mg' },
          { k: 'Headroom left in the day at the high end', ref: 'What you may still have from other sources', v: Math.max(0, CAFFEINE_DAILY_CAP_MG - hi), format: 'unit', unit: 'mg' },
          { k: 'Still circulating at bedtime, 10 hours later', ref: 'Half-life of roughly 5 hours', v: hi / 4, format: 'unit', unit: 'mg' },
        ];
        return {
          total: Math.round(lo) + '–' + Math.round(hi) + ' mg',
          sub:
            'About ' + (lo / MG_PER_COFFEE).toFixed(1) + '–' + (hi / MG_PER_COFFEE).toFixed(1) +
            ' cups of filter coffee, taken ' + (tol === 'low' ? '45 to 60' : '30 to 60') + ' minutes before the start' +
            (capped ? ' · capped at the EFSA 400 mg daily ceiling' : '') +
            ' · start at the low end, never trial it on race day, and ask a physician first if you are pregnant, under 18, on medication or living with a heart, anxiety or blood-pressure condition',
          rows: rows,
          chart: [
            { label: 'Your dose, high end (mg)', value: Math.round(hi), tone: capped ? 'warn' : 'good' },
            { label: 'EFSA daily ceiling (mg)', value: CAFFEINE_DAILY_CAP_MG, tone: 'main' },
          ],
        };
      }

      // ftp
      const w20 = Math.max(1, v.w20 || 1);
      const ftp = w20 * FTP_FROM_20MIN;
      const lb = Math.max(1, v.bodyLb || 1);
      const kg = lb * KG_PER_LB;
      const rows = [
        { k: '20-minute average power', ref: 'As entered', v: w20, format: 'unit', unit: 'W' },
        { k: 'FTP', ref: '95% of the 20-minute average', v: ftp, format: 'unit', unit: 'W', decimals: 0, extra: true },
        { k: 'Watts per kilogram', ref: 'The number that decides climbing', v: ftp / kg, format: 'unit', unit: 'W/kg', decimals: 2, extra: true },
        { k: 'Watts per pound', ref: 'The same figure in US units', v: ftp / lb, format: 'unit', unit: 'W/lb', decimals: 3 },
      ];
      for (let n = 0; n < POWER_ZONES.length; n++) {
        const z = POWER_ZONES[n];
        rows.push({
          k: z.z + ' — ' + z.name,
          ref: Math.round(ftp * z.lo) + '–' + Math.round(ftp * z.hi) + ' W',
          v: Math.round(ftp * z.hi),
          format: 'unit',
          unit: 'W',
          extra: z.z === 'Z2' || z.z === 'Z4',
        });
      }
      rows.push({ k: 'Energy of a one-hour ride at FTP', ref: 'Watts × 3,600 seconds', v: (ftp * 3600) / 1000, format: 'unit', unit: 'kJ', decimals: 0 });
      return {
        total: Math.round(ftp) + ' W',
        sub:
          (ftp / kg).toFixed(2) + ' W/kg (' + (ftp / lb).toFixed(3) + ' W/lb) · endurance work sits at ' +
          Math.round(ftp * 0.56) + '–' + Math.round(ftp * 0.75) + ' W and threshold work at ' +
          Math.round(ftp * 0.91) + '–' + Math.round(ftp * 1.05) + ' W · re-test every six to eight weeks on the same power meter',
        rows: rows,
        chart: [
          { label: 'Endurance ceiling (W)', value: Math.round(ftp * 0.75), tone: 'good' },
          { label: 'FTP (W)', value: Math.round(ftp), tone: 'main' },
          { label: 'VO2 max ceiling (W)', value: Math.round(ftp * 1.2), tone: 'warn' },
        ],
      };
    });
  })();
</script>
