---
/**
 * Decision hub EN — "How much should my baby be eating?"
 * Replaces 6 loose calculator URLs (see hub.replaces).
 *
 * audience="US" is passed literally: HubData only models 'AR' | 'global' and the
 * real market travels in hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub, ML_PER_OZ, KG_PER_LB, FORMULA_RULE, AGE_BANDS, INTAKE_SCALE } from '../../../lib/hubs/en/feeding-your-baby';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ ML_PER_OZ, KG_PER_LB, RULE: FORMULA_RULE, BANDS: AGE_BANDS, SCALE: INTAKE_SCALE }}>
  (function () {
    const H = window.HC_HUB;
    const oz = (n) => (Math.round((n || 0) * 10) / 10).toLocaleString('en-US') + ' fl oz';

    function bandFor(months) {
      for (const b of BANDS) if (months <= b.maxMonths) return b;
      return BANDS[BANDS.length - 1];
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'formula';
      const months = Math.max(0, Math.min(24, Math.round(v.months || 0)));
      const lb = Math.max(0, v.weight || 0);
      const kg = lb * KG_PER_LB;
      const band = bandFor(months);
      const feeds = Math.max(1, Math.round(v.feeds || 0) || band.feeds);
      const sessionOz = Math.max(0, v.sessionOz || 0);

      // Formula: AAP rule of thumb, weight-driven, with the practical daily cap.
      const ruleOz = lb * RULE.ozPerLb;
      const cappedOz = Math.min(ruleOz, RULE.dailyCapOz);
      // Breast milk: age-driven, NOT weight-driven.
      const breastOz = band.breastOzDay;

      let dailyOz, rows;

      if (id === 'formula') {
        dailyOz = cappedOz * band.solidsFactor;
        rows = [
          { k: 'Weight', ref: 'As entered', v: lb, format: 'unit', unit: 'lb', decimals: 1 },
          { k: 'AAP rule: 2.5 fl oz per pound per day', ref: 'Before the daily cap', v: ruleOz, format: 'unit', unit: 'fl oz', decimals: 1 },
          { k: 'Practical daily cap', ref: 'AAP — more milk is not the answer past this', v: RULE.dailyCapOz, format: 'unit', unit: 'fl oz', decimals: 0 },
        ];
        if (band.solidsFactor < 1) {
          rows.push({
            k: 'Share of calories still coming from milk at ' + months + ' months',
            ref: 'Solids take over the rest',
            v: band.solidsFactor * 100,
            format: 'unit',
            unit: '%',
            decimals: 0,
          });
        }
      } else if (id === 'breast') {
        dailyOz = breastOz;
        rows = [
          { k: 'Typical intake at ' + months + (months === 1 ? ' month' : ' months'), ref: 'Age-based, not weight-based', v: breastOz, format: 'unit', unit: 'fl oz', decimals: 0 },
          { k: 'Same figure in millilitres', ref: '1 fl oz = 29.57 mL', v: breastOz * ML_PER_OZ, format: 'unit', unit: 'mL', decimals: 0 },
          { k: 'Normal range for a breastfed baby', ref: 'Kent et al. 2006', v: 30, format: 'unit', unit: 'fl oz (upper end)', decimals: 0 },
        ];
      } else {
        // Pumping: cover a full supply for the age.
        dailyOz = Math.max(breastOz, 25 * band.solidsFactor);
        const needed = sessionOz > 0 ? dailyOz / sessionOz : 0;
        rows = [
          { k: 'Daily target a full supply has to cover', ref: 'AAP / CDC', v: dailyOz, format: 'unit', unit: 'fl oz', decimals: 1 },
          { k: 'Your output per session', ref: 'Both breasts combined', v: sessionOz, format: 'unit', unit: 'fl oz', decimals: 1 },
          {
            k: 'Sessions a day needed at that output',
            ref: 'Round up, never below 8 in the first weeks',
            v: needed,
            format: 'unit',
            unit: 'sessions',
            decimals: 1,
            extra: true,
          },
        ];
      }

      const perFeed = dailyOz / feeds;
      const mlPerKg = kg > 0 ? (dailyOz * ML_PER_OZ) / kg : 0;

      rows.push({ k: 'Total per 24 hours', ref: band.note, v: dailyOz, format: 'unit', unit: 'fl oz', decimals: 1, extra: true });
      rows.push({ k: 'Feeds or bottles per day', ref: 'Typical for ' + months + ' months: ' + band.feeds, v: feeds, format: 'plain' });
      rows.push({ k: 'Per feed', ref: 'Daily total divided by feeds', v: perFeed, format: 'unit', unit: 'fl oz', decimals: 1, extra: true });
      rows.push({ k: 'Per feed in millilitres', ref: '1 fl oz = 29.57 mL', v: perFeed * ML_PER_OZ, format: 'unit', unit: 'mL', decimals: 0 });
      rows.push({
        k: 'Intake per kilogram of body weight',
        ref: 'Clinical reference: about 150 mL/kg/day under 6 months',
        v: mlPerKg,
        format: 'unit',
        unit: 'mL/kg/day',
        decimals: 0,
      });
      rows.push({ k: 'Diapers to expect per day', ref: 'At least 6 wet after the first week', v: band.diapers, format: 'plain' });
      rows.push({ k: 'Diapers per month', ref: 'For stocking up', v: band.diapers * 30, format: 'plain' });
      rows.push({
        k: months < 6 ? 'Months until solids can start' : 'Months since solids could start',
        ref: 'Around 6 months, if the baby sits and has head control',
        v: Math.abs(6 - months),
        format: 'unit',
        unit: 'months',
        decimals: 0,
      });

      const pos = Math.min(100, Math.max(0, ((dailyOz - SCALE.min) / (SCALE.max - SCALE.min)) * 100));
      const verdict =
        dailyOz < SCALE.low ? 'below the usual range for this age' : dailyOz > SCALE.high ? 'above the practical daily cap' : 'inside the usual range';

      return {
        total: oz(dailyOz),
        sub:
          'About ' + oz(perFeed) + ' per feed across ' + feeds + ' feeds · ' +
          Math.round(mlPerKg) + ' mL/kg/day · ' + verdict + ' · expect about ' + band.diapers + ' diapers a day',
        rows: rows,
        format: 'unit',
        unit: 'fl oz',
        decimals: 1,
        position: pos,
        positionLabel: oz(dailyOz) + ' a day — ' + verdict,
        chart: [
          { label: 'Low for age (under 19 oz)', value: SCALE.low, from: SCALE.min, to: SCALE.low, tone: 'warn' },
          { label: 'Usual range (19–32 oz)', value: SCALE.high, from: SCALE.low, to: SCALE.high, tone: 'good' },
          { label: 'Above the cap (over 32 oz)', value: SCALE.max, from: SCALE.high, to: SCALE.max, tone: 'bad' },
        ],
      };
    });
  })();
</script>
