---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/en/events-and-family-transitions';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="US" lang="en" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/en-events-and-family-transitions';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"divorcio-liquidacion-bienes-gananciales-costo","fields":["bienes","acuerdo"],"outputs":[{"id":"honorariosEstimados","label":"Estimated Attorney Fees","primary":true},{"id":"tiempo","label":"Estimated Timeline"},{"id":"observacion","label":"Important Notes"}],"title":"Estimate Your Divorce Settlement Costs"},"c2":{"formulaId":"talla-anillo-dedo","fields":["circunferencia","sistema"],"outputs":[{"id":"tallaAR","label":"EU / Argentina Size","format":"number","primary":true},{"id":"tallaUS","label":"US Size","format":"number"},{"id":"tallaEU","label":"EU Size","format":"number"},{"id":"tallaUK","label":"UK Size","format":"text"},{"id":"diametro","label":"Inside diameter","format":"number","suffix":" mm"},{"id":"mensaje","label":"Summary","format":"text"}],"title":"Ring Size Calculator: Convert mm to US, UK & EU"},"c3":{"formulaId":"etapas-duelo-perdida-familiar-meses","fields":["tipoPerdida"],"outputs":[{"id":"etapas","label":"Grief Stages","primary":true},{"id":"duracion","label":"Typical Duration"},{"id":"alerta","label":"Warning Signs"},{"id":"resumen","label":"Summary"}],"title":"Stages of Grief After Family Loss"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'en', format: 'ars' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
