---
/**
 * Hub EN — "How much time is that, exactly?"
 * audience="US" y lang="en" literales; el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  WEEKLY_OT_THRESHOLD,
  OT_MULTIPLIER,
  US_LIFE_EXPECTANCY,
} from '../../../lib/hubs/en/dates-and-hours';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/en' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ WEEKLY_OT_THRESHOLD, OT_MULTIPLIER, US_LIFE_EXPECTANCY }}>
  (function () {
    const H = window.HC_HUB;
    const n0 = (x) => Math.round(x || 0).toLocaleString('en-US');
    const usd = (n) =>
      '$' + (Math.round((n || 0) * 100) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const MS_DAY = 86400000;

    /** Parseo local (no UTC) para que la fecha no se corra un día por zona horaria. */
    function parseDate(s) {
      const p = String(s || '').split('-').map(Number);
      if (p.length !== 3 || p.some((x) => !isFinite(x))) return null;
      const d = new Date(p[0], p[1] - 1, p[2]);
      d.setHours(0, 0, 0, 0);
      return isNaN(d.getTime()) ? null : d;
    }

    /** Días de lunes a viernes entre dos fechas, sin contar feriados. */
    function businessDays(a, b) {
      let count = 0;
      const cur = new Date(a.getTime());
      while (cur < b) {
        const w = cur.getDay();
        if (w !== 0 && w !== 6) count++;
        cur.setDate(cur.getDate() + 1);
      }
      return count;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'age';

      if (id === 'between') {
        const a = parseDate(v.from);
        const b = parseDate(v.to);
        if (!a || !b) {
          return {
            total: 'Enter both dates',
            sub: 'Pick a start and an end date above to see the span.',
            rows: [],
            chart: [{ label: 'No dates entered', value: 1, tone: 'main' }],
          };
        }
        const [lo, hi] = a <= b ? [a, b] : [b, a];
        const days = Math.round((hi.getTime() - lo.getTime()) / MS_DAY);
        const biz = businessDays(lo, hi);
        const weekend = days - biz;
        const rows = [
          { k: 'Calendar days', ref: 'Exclusive of the start date', v: days, format: 'unit', unit: 'days', extra: true },
          { k: 'Business days', ref: 'Monday to Friday, holidays NOT removed', v: biz, format: 'unit', unit: 'days', extra: true },
          { k: 'Weekend days', ref: 'Saturdays and Sundays', v: weekend, format: 'unit', unit: 'days' },
          { k: 'Full weeks', ref: 'Days ÷ 7', v: days / 7, format: 'unit', unit: 'weeks', decimals: 1 },
          { k: 'Months', ref: 'Average month of 30.44 days', v: days / 30.436875, format: 'unit', unit: 'months', decimals: 1 },
          { k: 'Years', ref: 'Average year of 365.2425 days', v: days / 365.2425, format: 'unit', unit: 'years', decimals: 2 },
          { k: 'Hours', ref: '24 per day', v: days * 24, format: 'unit', unit: 'hours' },
          { k: 'Counting inclusively instead', ref: 'If your contract counts the start date', v: days + 1, format: 'unit', unit: 'days' },
        ];
        return {
          total: n0(days) + ' days',
          sub:
            n0(biz) + ' business days and ' + n0(weekend) + ' weekend days · ' +
            (days / 7).toFixed(1) + ' weeks · public holidays are NOT deducted, subtract them yourself for a filing deadline',
          rows: rows,
          chart: [
            { label: 'Business days', value: biz, tone: 'main' },
            { label: 'Weekend days', value: weekend, tone: 'good' },
          ],
        };
      }

      if (id === 'timecard') {
        const days = Math.min(7, Math.max(0, Math.round(v.days || 0)));
        const hoursDay = Math.max(0, v.hoursday || 0);
        const breakH = Math.max(0, v.breakmin || 0) / 60;
        const rate = Math.max(0, v.rate || 0);
        const netDay = Math.max(0, hoursDay - breakH);
        const total = netDay * days;
        const regular = Math.min(total, WEEKLY_OT_THRESHOLD);
        const ot = Math.max(0, total - WEEKLY_OT_THRESHOLD);
        const regPay = regular * rate;
        const otPay = ot * rate * OT_MULTIPLIER;
        const gross = regPay + otPay;
        const rows = [
          { k: 'Hours on the clock', ref: n0(days) + ' days × ' + hoursDay + ' h', v: hoursDay * days, format: 'unit', unit: 'h', decimals: 2 },
          { k: 'Unpaid breaks deducted', ref: Math.round(breakH * 60) + ' min per day', v: breakH * days, format: 'unit', unit: 'h', decimals: 2 },
          { k: 'Net hours worked this week', ref: 'What counts for pay', v: total, format: 'unit', unit: 'h', decimals: 2, extra: true },
          { k: 'Regular hours', ref: 'Up to ' + WEEKLY_OT_THRESHOLD + ' h · FLSA 29 U.S.C. § 207', v: regular, format: 'unit', unit: 'h', decimals: 2 },
          { k: 'Overtime hours', ref: 'Beyond ' + WEEKLY_OT_THRESHOLD + ' h, paid at ' + OT_MULTIPLIER + '×', v: ot, format: 'unit', unit: 'h', decimals: 2 },
          { k: 'Regular pay', ref: usd(rate) + '/h', v: regPay, format: 'unit', unit: 'USD', decimals: 2 },
          { k: 'Overtime pay', ref: usd(rate * OT_MULTIPLIER) + '/h', v: otPay, format: 'unit', unit: 'USD', decimals: 2 },
          { k: 'Gross pay for the week', ref: 'Before taxes and withholding', v: gross, format: 'unit', unit: 'USD', decimals: 2, extra: true },
          { k: 'Effective average rate', ref: 'Gross ÷ hours worked', v: total > 0 ? gross / total : 0, format: 'unit', unit: 'USD/h', decimals: 2 },
        ];
        return {
          total: usd(gross),
          sub:
            total.toFixed(2) + ' h worked · ' + ot.toFixed(2) + ' h of overtime at ' + usd(rate * OT_MULTIPLIER) + '/h · ' +
            (ot > 0
              ? 'federal overtime is weekly, and some states add a daily rule on top'
              : 'no federal overtime this week — check your state’s daily rule if you worked long days'),
          rows: rows,
          chart: [
            { label: 'Regular pay', value: Math.round(regPay), tone: 'main' },
            { label: 'Overtime pay', value: Math.round(otPay), tone: 'good' },
          ],
        };
      }

      if (id === 'graduation') {
        const total = Math.max(1, Math.round(v.total || 1));
        const passed = Math.min(total, Math.max(0, Math.round(v.passed || 0)));
        const perTerm = Math.max(1, v.perterm || 1);
        const passRate = Math.min(100, Math.max(10, v.passrate || 100)) / 100;
        const left = total - passed;
        const effective = perTerm * passRate;
        const terms = Math.ceil(left / effective);
        const years = terms / 2;
        const pct = (passed / total) * 100;
        const perfectTerms = Math.ceil(left / perTerm);
        const finish = new Date();
        finish.setMonth(finish.getMonth() + terms * 6);
        const monthName = finish.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
        const rows = [
          { k: 'Courses in the degree', ref: 'As entered', v: total, format: 'plain' },
          { k: 'Already passed', ref: pct.toFixed(0) + '% complete', v: passed, format: 'plain' },
          { k: 'Courses left', ref: 'Total minus passed', v: left, format: 'plain', extra: true },
          { k: 'Effective courses per term', ref: perTerm + ' taken × ' + (passRate * 100).toFixed(0) + '% passed', v: effective, format: 'plain', decimals: 2 },
          { k: 'Terms remaining', ref: 'Rounded up', v: terms, format: 'unit', unit: 'terms', extra: true },
          { k: 'Years remaining', ref: 'Two terms a year', v: years, format: 'unit', unit: 'years', decimals: 1 },
          { k: 'Terms it would take at a 100% pass rate', ref: 'What the failures are costing you', v: perfectTerms, format: 'unit', unit: 'terms' },
          { k: 'Extra terms the current pass rate adds', ref: 'Retakes compete with new courses for the same slots', v: terms - perfectTerms, format: 'unit', unit: 'terms' },
        ];
        return {
          total: terms + (terms === 1 ? ' term' : ' terms'),
          sub:
            years.toFixed(1) + ' years — finishing around ' + monthName + ' · ' + pct.toFixed(0) + '% of the degree done · ' +
            'prerequisite chains and once-a-year courses can push this out further',
          rows: rows,
          chart: [
            { label: 'Courses passed', value: passed, tone: 'good' },
            { label: 'Courses remaining', value: left, tone: 'main' },
          ],
          position: pct,
          positionLabel: pct.toFixed(0) + '% of the degree complete',
        };
      }

      // age
      const birth = parseDate(v.birth);
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      if (!birth || birth > today) {
        return {
          total: 'Enter a valid date',
          sub: 'The date of birth has to be a real date in the past.',
          rows: [],
          chart: [{ label: 'No date entered', value: 1, tone: 'main' }],
        };
      }
      let y = today.getFullYear() - birth.getFullYear();
      let m = today.getMonth() - birth.getMonth();
      let d = today.getDate() - birth.getDate();
      if (d < 0) {
        m--;
        d += new Date(today.getFullYear(), today.getMonth(), 0).getDate();
      }
      if (m < 0) { y--; m += 12; }
      const totalDays = Math.floor((today.getTime() - birth.getTime()) / MS_DAY);
      let next = new Date(today.getFullYear(), birth.getMonth(), birth.getDate());
      if (next <= today) next = new Date(today.getFullYear() + 1, birth.getMonth(), birth.getDate());
      const untilBday = Math.ceil((next.getTime() - today.getTime()) / MS_DAY);
      const lifePct = Math.min(100, (y + m / 12) / US_LIFE_EXPECTANCY * 100);
      const rows = [
        { k: 'Years', ref: 'Complete years lived', v: y, format: 'plain', extra: true },
        { k: 'Plus months', ref: 'Since your last birthday', v: m, format: 'unit', unit: 'months' },
        { k: 'Plus days', ref: 'Since the last monthly anniversary', v: d, format: 'unit', unit: 'days' },
        { k: 'Total days alive', ref: 'Leap days counted individually', v: totalDays, format: 'unit', unit: 'days', extra: true },
        { k: 'Total weeks', ref: 'Days ÷ 7', v: totalDays / 7, format: 'unit', unit: 'weeks', decimals: 0 },
        { k: 'Total hours', ref: '24 per day', v: totalDays * 24, format: 'unit', unit: 'hours' },
        { k: 'Days until your next birthday', ref: 'You turn ' + (y + 1), v: untilBday, format: 'unit', unit: 'days', extra: true },
        { k: 'Share of US average life expectancy', ref: US_LIFE_EXPECTANCY + ' years, CDC/NCHS', v: lifePct, format: 'unit', unit: '%', decimals: 1 },
      ];
      return {
        total: y + ' yr, ' + m + ' mo, ' + d + ' d',
        sub:
          n0(totalDays) + ' days alive · next birthday in ' + untilBday + ' day' + (untilBday === 1 ? '' : 's') +
          ', when you turn ' + (y + 1),
        rows: rows,
        chart: [
          { label: 'Days lived', value: totalDays, tone: 'main' },
          { label: 'Days until your next birthday', value: untilBday, tone: 'good' },
        ],
        position: lifePct,
        positionLabel: y + ' years old — ' + lifePct.toFixed(0) + '% of US average life expectancy',
      };
    });
  })();
</script>
