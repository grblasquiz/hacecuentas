---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { isRestrictedCalc, canAdvertiseCalc } from '../../lib/content-policy';
import { categoryDomain } from '../../lib/category-colors';
import { freeOfferSchema } from '../../lib/offer-schema';
import { applicationCategoryFor, SPEAKABLE_SELECTORS, FAQ_SPEAKABLE_SELECTORS, buildSchemaDescription, citationNodes, localeBreadcrumb } from '../../lib/calc-schema';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Calculator from '../../components/Calculator.astro';
import RelatedCalcs from '../../components/RelatedCalcs.astro';
import CalcLayoutV2 from '../../components/CalcLayoutV2.astro';
import ReferenceTables from '../../components/ReferenceTables.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import InteractiveBmiTable from '../../components/InteractiveBmiTable.astro';
import ImcUnitsHook from '../../components/ImcUnitsHook.astro';
import ImcResultCta from '../../components/ImcResultCta.astro';
import { md, mdInline } from '../../lib/markdown';
import ogManifest from '../../lib/og-manifest.json';
import { findMentions, findPrimaryAbout } from '../../lib/wikidata-entities';
import { filterByIncremental } from '../../lib/incremental';
import { resolveHreflangRoute } from '../../lib/hreflang';
import hreflangIndex from '../../lib/hreflang-index.json';

export async function getStaticPaths() {
  const calcs = import.meta.glob<any>('../../content/calcs-en/*.json', { eager: true });
  const all = Object.values(calcs).map((mod: any) => mod.default || mod);
  return filterByIncremental(all, 'calcs', 'en').map((c: any) => ({
    params: { slug: c.slug },
    props: { calc: c },
  }));
}

const { calc } = Astro.props;

const categoryLabels: Record<string, string> = {
  finanzas: 'Finance',
  negocios: 'Business',
  negocio: 'Business',
  salud: 'Health',
  marketing: 'Marketing',
  deportes: 'Sports',
  viajes: 'Travel',
  vida: 'Daily Life',
  mascotas: 'Pets',
  matematica: 'Math',
  construccion: 'Construction',
  cocina: 'Cooking',
  educacion: 'Education',
  automotor: 'Automotive',
  tecnologia: 'Technology',
  'medio-ambiente': 'Environment',
  electronica: 'Electronics',
};

// OG image: manifest pre-build. output:'server' corre el frontmatter en Workers
// runtime sin node:fs — usar fs directo rompe ~187 HTMLs con "Illegal invocation"
// de miniflare bajo carga durante prerender.
let ogImage = '/og-default.png';
if ((ogManifest as Record<string, boolean>)[calc.slug]) {
  ogImage = `/og/${calc.slug}.png`;
}

// dateModified: lastReviewed > dataUpdate.lastUpdated > build date.
let dateModified: string;
let lastReviewedLabel: string;
const _dataUpdateLast = calc.dataUpdate?.lastUpdated;
if (calc.lastReviewed && /^\d{4}-\d{2}-\d{2}$/.test(calc.lastReviewed)) {
  dateModified = new Date(calc.lastReviewed + 'T00:00:00Z').toISOString();
} else if (_dataUpdateLast && /^\d{4}-\d{2}-\d{2}$/.test(_dataUpdateLast)) {
  dateModified = new Date(_dataUpdateLast + 'T00:00:00Z').toISOString();
} else {
  dateModified = new Date().toISOString();
}
lastReviewedLabel = new Date(dateModified).toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
// datePublished opcional: viene de calc.datePublished si está declarada.
// Si no, omitimos el campo del schema (JSON.stringify ignora undefined).
const _rawDatePub = calc.datePublished;
const datePublished: string | undefined = typeof _rawDatePub === 'string' && /^\d{4}-\d{2}-\d{2}(T.*)?$/.test(_rawDatePub)
  ? (_rawDatePub.length === 10 ? new Date(_rawDatePub + 'T00:00:00Z').toISOString() : _rawDatePub)
  : undefined;

// audience: 'AR' = Argentina-specific; 'US' = United States (default for EN content,
// Bing US mercado prioritario); 'global' = worldwide (catch-all). El default a 'US'
// fixea geo.region=AR bug que estaba afectando ranking en Bing US y Google US.
const audience: 'AR' | 'US' | 'global' = calc.audience === 'AR'
  ? 'AR'
  : calc.audience === 'global'
  ? 'global'
  : 'US';
const enLocale = 'en-US';

// HowTo schema: dejó de emitirse (Google lo deprecó en 2023, sin rich results).

// description ≥50 chars para structured data (Search Console rechaza las cortas).
const schemaDescriptionSafe = buildSchemaDescription(calc, categoryLabels);

const schemaFAQ = calc.faq && calc.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: FAQ_SPEAKABLE_SELECTORS,
  },
  mainEntity: calc.faq.map((f: any) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
} : null;

const schemaBreadcrumb = localeBreadcrumb('en', calc.h1);

// SoftwareApplication + WebApplication
const schemaApp = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'WebApplication'],
  name: calc.h1,
  description: schemaDescriptionSafe,
  url: `https://hacecuentas.com/en/${calc.slug}`,
  mainEntityOfPage: `https://hacecuentas.com/en/${calc.slug}`,
  applicationCategory: applicationCategoryFor(calc.category),
  applicationSubCategory: 'Calculator',
  operatingSystem: 'Any (Web)',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  inLanguage: enLocale,
  isAccessibleForFree: true,
  datePublished,
  dateModified,
  offers: freeOfferSchema({ priceCurrency: 'USD', validFrom: datePublished || dateModified }),
  image: {
    '@type': 'ImageObject',
    url: `https://hacecuentas.com${ogImage}`,
    width: 1200,
    height: 630,
  },
  screenshot: `https://hacecuentas.com${ogImage}`,
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
  },
  // Mentions: Wikidata entities reconocidas en h1/seoKeywords. Entity disambiguation
  // gratis para LLMs (ChatGPT/Claude/Perplexity/Gemini) vía Wikidata knowledge graph.
  mentions: findMentions(`${calc.h1 || ''} ${(Array.isArray(calc.seoKeywords) ? calc.seoKeywords : []).join(' ')}`),
  ...(findPrimaryAbout(calc.h1 || '') ? { about: findPrimaryAbout(calc.h1 || '') } : {}),
  // Speakable selectors expandidos — voice assistants (Alexa/Cortana/Google) y
  // AI (ChatGPT/Copilot/Claude/Perplexity) priorizan estos fragmentos para
  // responder queries de voz/AI.
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: SPEAKABLE_SELECTORS,
  },
  ...(citationNodes(calc.sources) ? { citation: citationNodes(calc.sources) } : {}),
};

// Article schema for YMYL categories
const isYMYL = ['finanzas', 'salud', 'negocios', 'mascotas', 'familia', 'impuestos'].includes(calc.category);
const _explLower = ((calc.explanation || '') + (calc.intro || '') + (calc.keyTakeaway || '')).toLowerCase();
const _hasDisclaimer = ['disclaimer','informational only','consult','not medical advice','not financial advice','not a substitute','licensed professional','board-certified','tax professional'].some(kw => _explLower.includes(kw));
const _disclaimerByCategory: Record<string, { who: string; verb: string }> = {
  salud:     { who: 'licensed physician, registered dietitian, or board-certified healthcare professional', verb: 'replace medical advice' },
  mascotas:  { who: 'licensed veterinarian', verb: 'replace veterinary advice' },
  finanzas:  { who: 'CFP, CFA, or licensed financial advisor', verb: 'constitute personalized financial advice' },
  impuestos: { who: 'CPA, EA, or licensed tax professional', verb: 'constitute tax advice' },
  negocios:  { who: 'CPA, attorney, or licensed business advisor', verb: 'constitute professional advice' },
  familia:   { who: 'licensed professional in the relevant area', verb: 'replace personalized guidance' },
};
const _disc = _disclaimerByCategory[calc.category];
const showYmylDisclaimer = isYMYL && !_hasDisclaimer && _disc;
// snippetDescription: answer-first format priority answerSnippet > keyTakeaway > description.
// Used by Google AI Overviews + Gemini extract directly.
const _stripMd = (s: string) => (s || '').replace(/\*\*(.+?)\*\*/g, '$1').replace(/\[(.+?)\]\(.+?\)/g, '$1').replace(/\s+/g, ' ').trim();
const _snippetCandidate = calc.answerSnippet || calc.keyTakeaway || calc.description;
const _stripped = _stripMd(_snippetCandidate);
const snippetDescription = (_stripped.length >= 50 ? _stripped : calc.description).slice(0, 500);
// wordCount REAL: explanation + intro + keyTakeaway + answerSnippet + FAQ +
// useCases. No solo explanation — las calcs con explanation corto pero mucho
// contenido editorial (FAQ largas, casos de uso) salían artificialmente thin.
const _articleWordCount = [
  calc.explanation || '',
  calc.intro || '',
  calc.keyTakeaway || '',
  calc.answerSnippet || '',
  ...(Array.isArray(calc.faq) ? calc.faq.flatMap((f: any) => [f.q || '', f.a || '']) : []),
  ...(Array.isArray(calc.useCases) ? calc.useCases : []),
].join(' ').split(/\s+/).filter(Boolean).length;
// Article schema — emitido SIEMPRE (no solo YMYL), con wordCount real. Mismo
// criterio que la página AR (post-comparativa Omni Calculator).
const schemaArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: calc.h1,
  description: snippetDescription,
  url: `https://hacecuentas.com/en/${calc.slug}`,
  mainEntityOfPage: `https://hacecuentas.com/en/${calc.slug}`,
  image: `https://hacecuentas.com${ogImage}`,
  inLanguage: enLocale,
  datePublished,
  dateModified,
  author: {
    '@type': 'Person',
    '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person',
    name: 'Martín Rodríguez',
    url: 'https://hacecuentas.com/autores/martin-rodriguez',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://hacecuentas.com/og-default.png',
    },
  },
  about: categoryLabels[calc.category] || calc.category,
  articleSection: categoryLabels[calc.category] || calc.category,
  // wordCount: señal de profundidad para E-E-A-T (recomendado por Article schema).
  wordCount: _articleWordCount,
  isAccessibleForFree: true,
  ...(citationNodes(calc.sources) ? { citation: citationNodes(calc.sources) } : {}),
};

const schemaGraph: any[] = [schemaBreadcrumb, schemaApp, schemaArticle];
// HowTo deprecado por Google (2023, sin rich results) → dejó de emitirse (ahorra ~22KB/página en flagships).
if (schemaFAQ) schemaGraph.push(schemaFAQ);

// MedicalWebPage / LearningResource — categoría 'salud' / 'educacion'.
// Bing y Copilot priorizan schema médico/educativo para esos queries.

const schemaDescription = schemaDescriptionSafe;

if (calc.category === 'medio-ambiente') {
  schemaGraph.push({
    '@type': 'CreativeWork',
    name: calc.h1,
    description: schemaDescription,
    url: `https://hacecuentas.com/en/${calc.slug}`,
    inLanguage: enLocale,
    about: [
      { '@type': 'Thing', name: 'Climate change', sameAs: 'https://www.wikidata.org/wiki/Q7942' },
      { '@type': 'Thing', name: 'Sustainability', sameAs: 'https://www.wikidata.org/wiki/Q219416' },
      { '@type': 'Thing', name: 'Carbon footprint', sameAs: 'https://www.wikidata.org/wiki/Q1054116' },
    ],
    keywords: 'huella carbono, sostenibilidad, medio ambiente, CO2, emisiones',
    datePublished: (datePublished || dateModified).split('T')[0],
    dateModified: dateModified.split('T')[0],
    publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by/4.0/',
  });
}

if (calc.category === 'salud') {
  const MEDICAL_CONDITION_MAP_EN: Record<string, { name: string; sameAs?: string }> = {
    'bmi-calculator': { name: 'Body mass index', sameAs: 'https://www.wikidata.org/wiki/Q170481' },
    'child-bmi-percentile': { name: 'Body mass index', sameAs: 'https://www.wikidata.org/wiki/Q170481' },
    'pregnancy-weight-gain-bmi': { name: 'Pregnancy', sameAs: 'https://www.wikidata.org/wiki/Q47912' },
    'bmi-seniors-65-plus-table': { name: 'Sarcopenia', sameAs: 'https://www.wikidata.org/wiki/Q1407294' },
  };
  const medicalCondition = MEDICAL_CONDITION_MAP_EN[calc.slug];
  schemaGraph.push({
    '@type': 'MedicalWebPage',
    name: calc.h1,
    description: schemaDescription,
    url: `https://hacecuentas.com/en/${calc.slug}`,
    inLanguage: enLocale,
    isAccessibleForFree: true,
    datePublished: (datePublished || dateModified).split('T')[0],
    dateModified: dateModified.split('T')[0],
    lastReviewed: (calc.lastReviewed || dateModified.split('T')[0]),
    audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
    medicalAudience: 'Patient',
    ...(medicalCondition ? {
      about: {
        '@type': 'MedicalCondition',
        name: medicalCondition.name,
        ...(medicalCondition.sameAs ? { sameAs: medicalCondition.sameAs } : {}),
      },
    } : {}),
    ...(citationNodes(calc.sources) ? { citation: citationNodes(calc.sources) } : {}),
    publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  });
}
if (calc.category === 'educacion') {
  schemaGraph.push({
    '@type': 'LearningResource',
    name: calc.h1,
    description: schemaDescription,
    url: `https://hacecuentas.com/en/${calc.slug}`,
    inLanguage: enLocale,
    learningResourceType: 'Calculator',
    educationalUse: 'Practice',
    audience: { '@type': 'EducationalAudience', educationalRole: 'student' },
    datePublished: (datePublished || dateModified).split('T')[0],
    dateModified: dateModified.split('T')[0],
    publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
    isAccessibleForFree: true,
  });
}

const effectiveNoindex = calc.noindex === true || isRestrictedCalc(calc);
// YMYL: en páginas noindex/restringidas sólo emitimos BreadcrumbList (sin rich results).
const schema = { '@context': 'https://schema.org', '@graph': effectiveNoindex ? schemaGraph.filter((n: any) => n['@type'] === 'BreadcrumbList') : schemaGraph };

const updated = lastReviewedLabel;

// Reading time: ~250 words/minute in English
const wordCount = calc.explanation ? calc.explanation.split(/\s+/).length : 0;
const readingMin = Math.max(1, Math.round(wordCount / 250));

// Optional SEO fields
const sources: Array<{ name: string; url?: string }> = calc.sources || [];
const useCases: string[] = calc.useCases || [];
const example: { title?: string; steps?: string[]; result?: string } | null = calc.example || null;
const keyTakeaway: string = calc.keyTakeaway || '';
const relatedSlugs: string[] = calc.relatedSlugs || [];

// Lookup for related links — load English calcs
const allCalcsModules = import.meta.glob<any>('../../content/calcs-en/*.json', { eager: true });
const allCalcs = Object.values(allCalcsModules).map((m: any) => m.default || m);
const relatedContextual = relatedSlugs
  .map((s) => allCalcs.find((c) => c.slug === s))
  .filter(Boolean);

// TOC: top-level rendered sections (in order of appearance)
const tocSections: Array<{ id: string; label: string }> = [
  { id: 'calculator', label: 'Calculator' },
];
if (keyTakeaway) tocSections.push({ id: 'summary', label: 'In a nutshell' });
if (useCases.length > 0) tocSections.push({ id: 'when-to-use', label: 'When to use' });
if (example && example.steps) tocSections.push({ id: 'example', label: 'Step-by-step example' });
if (calc.explanation) tocSections.push({ id: 'how-it-works', label: 'How it works' });
if (calc.faq && calc.faq.length > 0) tocSections.push({ id: 'faq', label: 'FAQ' });
if (sources.length > 0) tocSections.push({ id: 'sources', label: 'Sources' });

// Heuristic LaTeX detection in explanation (to conditionally load KaTeX)
const hasMath = calc.explanation && /(\$[^$\n]+\$|\\frac|\\sqrt|\\sum|\\times|\\cdot)/.test(calc.explanation);

// Pre-filled subject for "Report error"
const reportSubject = encodeURIComponent(`Error in /en/${calc.slug}`);
const reportBody = encodeURIComponent(
  `Hi Martín,\n\nI found an error in the calculator "${calc.h1}":\n\nURL: https://hacecuentas.com/en/${calc.slug}\nInput data: \nExpected result: \nActual result: \nSource / reference: \n\nThank you.`
);

// Un único índice distribuible hace que todos los miembros emitan el mismo set.
const hreflangTags = resolveHreflangRoute(hreflangIndex, 'en', calc.slug).tags;
---

<Layout
  title={calc.title}
  description={calc.description}
  schema={schema}
  audience={audience}
  image={ogImage}
  lang="en"
  hreflang={hreflangTags}
  noindex={effectiveNoindex}
  noAds={!canAdvertiseCalc(calc)}
  domain={categoryDomain(calc.category)}
>
  <Header slot="header" lang="en" />

  <CalcLayoutV2 calc={calc} lang="en" />

  <ScrollToTop />

  <Footer slot="footer" lang="en" />
</Layout>
