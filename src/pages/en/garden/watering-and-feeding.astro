---
/**
 * Hub EN — "How much water, fertilizer and amendment does this garden need?"
 * audience="US" y lang="en" literales; el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  L_PER_GAL,
  M2_PER_FT2,
  KG_PER_LB,
  WATER_L_PER_DAY,
  STAGE_MULT,
  NPK_G_PER_M2,
  PH_LIME_G_PER_M2_PER_POINT,
  PH_SULFUR_G_PER_M2_PER_POINT,
  SOIL_BUFFER,
  MULCH_KG_PER_M3,
  EC_SCALES,
} from '../../../lib/hubs/en/watering-and-feeding';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/en' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    L_PER_GAL,
    M2_PER_FT2,
    KG_PER_LB,
    WATER_L_PER_DAY,
    STAGE_MULT,
    NPK_G_PER_M2,
    PH_LIME_G_PER_M2_PER_POINT,
    PH_SULFUR_G_PER_M2_PER_POINT,
    SOIL_BUFFER,
    MULCH_KG_PER_M3,
    EC_SCALES,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const n0 = (x) => Math.round(x || 0).toLocaleString('en-US');

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'water';
      const areaFt2 = Math.max(0, v.area || 0);
      const areaM2 = areaFt2 * M2_PER_FT2;

      if (id === 'fertilizer') {
        const rate = NPK_G_PER_M2[String(v.npk || '10-10-10')] || 30;
        const grams = areaM2 * rate;
        const lb = (grams / 1000) / KG_PER_LB;
        const oz = lb * 16;
        const per1000 = ((1000 * M2_PER_FT2 * rate) / 1000) / KG_PER_LB;
        const rows = [
          { k: 'Bed area', ref: n0(areaFt2) + ' sq ft', v: areaM2, format: 'unit', unit: 'm²', decimals: 1 },
          { k: 'Application rate', ref: 'For NPK ' + String(v.npk), v: rate, format: 'unit', unit: 'g/m²' },
          { k: 'Rate per 1,000 sq ft', ref: 'How US bags are labelled', v: per1000, format: 'unit', unit: 'lb', decimals: 2 },
          { k: 'Total needed', ref: 'Area × rate', v: lb, format: 'unit', unit: 'lb', decimals: 2, extra: true },
          { k: 'The same figure in ounces', ref: '16 oz per lb', v: oz, format: 'unit', unit: 'oz', decimals: 1 },
          { k: 'In grams', ref: 'For a kitchen scale', v: grams, format: 'unit', unit: 'g' },
          { k: 'Per application if you split it three ways', ref: 'Better than one heavy dose', v: lb / 3, format: 'unit', unit: 'lb', decimals: 2, extra: true },
        ];
        return {
          total: lb.toFixed(2) + ' lb',
          sub:
            rate + ' g/m² of NPK ' + String(v.npk) + ' over ' + n0(areaFt2) + ' sq ft · ' +
            'split it into two or three applications through the season · water it in so it does not burn foliage',
          rows: rows,
          chart: [
            { label: 'Per application, split in three (lb)', value: Math.round((lb / 3) * 100) / 100, tone: 'main' },
            { label: 'Season total (lb)', value: Math.round(lb * 100) / 100, tone: 'good' },
          ],
        };
      }

      if (id === 'ph') {
        const now = Math.max(3, Math.min(10, v.phnow || 7));
        const target = Math.max(3, Math.min(10, v.phtarget || 7));
        const buffer = SOIL_BUFFER[String(v.soil || 'loam')] || 1;
        const diff = Math.abs(target - now);
        const raising = target > now;
        const perPoint = raising ? PH_LIME_G_PER_M2_PER_POINT : PH_SULFUR_G_PER_M2_PER_POINT;
        const gm2 = diff * perPoint * buffer;
        const kg = (gm2 * areaM2) / 1000;
        const lb = kg / KG_PER_LB;
        const rows = [
          { k: 'Current pH', ref: 'From your soil test', v: now, format: 'plain', decimals: 1 },
          { k: 'Target pH', ref: 'Most vegetables want 6.0–7.0', v: target, format: 'plain', decimals: 1 },
          { k: 'pH points to move', ref: raising ? 'Raising — agricultural lime' : 'Lowering — elemental sulfur', v: diff, format: 'plain', decimals: 1, extra: true },
          { k: 'Soil texture adjustment', ref: String(v.soil) + ' — clay resists change most', v: buffer, format: 'plain', decimals: 2 },
          { k: 'Rate', ref: perPoint + ' g/m² per pH point × buffer', v: gm2, format: 'unit', unit: 'g/m²' },
          { k: raising ? 'Agricultural lime needed' : 'Elemental sulfur needed', ref: n0(areaFt2) + ' sq ft', v: lb, format: 'unit', unit: 'lb', decimals: 2, extra: true },
          { k: 'The same figure in kilograms', ref: '1 lb = 0.45359237 kg', v: kg, format: 'unit', unit: 'kg', decimals: 2 },
          { k: 'Weeks to allow before planting', ref: raising ? 'Lime: 8–12 weeks' : 'Sulfur: 4–12 weeks, bacteria-dependent', v: raising ? 10 : 8, format: 'unit', unit: 'weeks' },
        ];
        return {
          total: lb.toFixed(1) + ' lb of ' + (raising ? 'lime' : 'sulfur'),
          sub:
            'Moving pH ' + diff.toFixed(1) + ' points in ' + String(v.soil) + ' soil over ' + n0(areaFt2) + ' sq ft · ' +
            'work it into the top 6–8 inches and allow months, not weeks · retest before applying any more',
          rows: rows,
          chart: [
            { label: raising ? 'Lime needed (lb)' : 'Sulfur needed (lb)', value: Math.round(lb * 10) / 10, tone: 'main' },
            { label: 'What sandy soil would need instead (lb)', value: Math.round((lb / buffer) * SOIL_BUFFER.sandy * 10) / 10, tone: 'good' },
          ],
        };
      }

      if (id === 'mulch') {
        const inches = Math.max(0.1, v.depth || 0.1);
        const ft3 = areaFt2 * (inches / 12);
        const yd3 = ft3 / 27;
        const bags = Math.ceil(ft3 / 2);
        const m3 = ft3 * 0.028316846592;
        const kg = m3 * MULCH_KG_PER_M3;
        const rows = [
          { k: 'Area to cover', ref: 'As entered', v: areaFt2, format: 'unit', unit: 'sq ft' },
          { k: 'Depth', ref: inches < 2 ? 'Below 2 in it does almost nothing' : '2–4 in is the useful range', v: inches, format: 'unit', unit: 'in', decimals: 1 },
          { k: 'Volume needed', ref: 'Area × depth', v: ft3, format: 'unit', unit: 'cu ft', decimals: 1, extra: true },
          { k: 'In cubic yards', ref: '27 cu ft per yard — bulk is cheaper past ~10 bags', v: yd3, format: 'unit', unit: 'cu yd', decimals: 2, extra: true },
          { k: 'Standard 2 cu ft bags', ref: 'Rounded up', v: bags, format: 'plain', extra: true },
          { k: 'Approximate weight', ref: 'Straw at 100 kg/m³ — bark and wood are heavier', v: kg / KG_PER_LB, format: 'unit', unit: 'lb' },
          { k: 'What 2 inches would take instead', ref: 'The minimum useful depth', v: (areaFt2 * (2 / 12)) / 2, format: 'plain', decimals: 0 },
        ];
        return {
          total: bags + (bags === 1 ? ' bag' : ' bags'),
          sub:
            ft3.toFixed(1) + ' cu ft (' + yd3.toFixed(2) + ' cu yd) at ' + inches + ' in deep · ' +
            (inches < 2
              ? 'that depth will not suppress weeds — go to 2–4 inches'
              : 'keep it pulled back from trunks and stems, no mulch volcanoes'),
          rows: rows,
          chart: [
            { label: 'Volume at your depth (cu ft)', value: Math.round(ft3), tone: 'main' },
            { label: 'Extra over a 2-inch minimum (cu ft)', value: Math.max(0, Math.round(ft3 - areaFt2 * (2 / 12))), tone: 'good' },
          ],
        };
      }

      if (id === 'hydro') {
        const ec = Math.max(0, v.ec || 0);
        const factor = EC_SCALES[String(v.scale || 's500')] || 500;
        const ppm = ec * factor;
        let band, tone;
        if (ppm < 400) { band = 'seedling and cutting territory — too weak for vegetative growth'; tone = 'warn'; }
        else if (ppm <= 1500) { band = 'the vegetative-growth range, healthy for most crops'; tone = 'good'; }
        else if (ppm <= 2400) { band = 'a loaded solution, suited to flowering or heavy feeders'; tone = 'good'; }
        else { band = 'very high — dilute before it burns the roots'; tone = 'bad'; }
        const rows = [
          { k: 'EC reading', ref: 'As entered', v: ec, format: 'unit', unit: 'mS/cm', decimals: 2 },
          { k: 'Scale factor of your meter', ref: 'This is why meters disagree on ppm', v: factor, format: 'plain' },
          { k: 'Concentration on your scale', ref: 'EC × factor', v: ppm, format: 'unit', unit: 'ppm', extra: true },
          { k: 'On the 500 scale (Hanna)', ref: 'Most common in the US', v: ec * EC_SCALES.s500, format: 'unit', unit: 'ppm' },
          { k: 'On the 640 scale (Eutech)', ref: 'Same solution, different number', v: ec * EC_SCALES.s640, format: 'unit', unit: 'ppm' },
          { k: 'On the 700 scale (Truncheon)', ref: 'Same solution again', v: ec * EC_SCALES.s700, format: 'unit', unit: 'ppm' },
          { k: 'Root-burn threshold', ref: 'Roughly, for most crops', v: 2400, format: 'unit', unit: 'ppm' },
        ];
        return {
          total: n0(ppm) + ' ppm',
          sub:
            'EC ' + ec.toFixed(2) + ' on the ' + factor + ' scale — ' + band +
            ' · a recipe without its scale is meaningless, the same solution reads three different numbers',
          rows: rows,
          chart: [
            { label: 'Your concentration (ppm)', value: Math.round(ppm), tone: tone === 'bad' ? 'bad' : 'main' },
            { label: 'Headroom to the burn threshold (ppm)', value: Math.max(0, Math.round(2400 - ppm)), tone: 'good' },
          ],
          position: Math.min(100, (ppm / 3000) * 100),
          positionLabel: n0(ppm) + ' ppm — ' + band,
        };
      }

      // water
      const base = WATER_L_PER_DAY[String(v.species || 'tomato')] ?? 1;
      const mult = STAGE_MULT[String(v.stage || 'growth')] ?? 1;
      const plants = Math.max(1, Math.round(v.plants || 1));
      const litersDay = base * mult;
      const galDay = litersDay / L_PER_GAL;
      const galWeekAll = (galDay * 7 * plants);
      const rows = [
        { k: 'Base need for this plant', ref: 'Vegetative baseline', v: base, format: 'unit', unit: 'L/day', decimals: 2 },
        { k: 'Stage multiplier', ref: String(v.stage), v: mult, format: 'plain', decimals: 2 },
        { k: 'Water per plant per day', ref: 'Base × stage', v: litersDay, format: 'unit', unit: 'L', decimals: 2, extra: true },
        { k: 'The same figure in gallons', ref: '1 gal = 3.785411784 L', v: galDay, format: 'unit', unit: 'gal', decimals: 3, extra: true },
        { k: 'Per plant per week', ref: '7 days', v: litersDay * 7, format: 'unit', unit: 'L', decimals: 1 },
        { k: 'All ' + plants + ' plants, per week', ref: 'What you actually carry', v: galWeekAll, format: 'unit', unit: 'gal', decimals: 1, extra: true },
        { k: 'In a container or above 90°F, expect', ref: 'Roughly double', v: galWeekAll * 2, format: 'unit', unit: 'gal', decimals: 1 },
      ];
      return {
        total: galDay.toFixed(2) + ' gal/day',
        sub:
          litersDay.toFixed(2) + ' L per plant per day · ' + galWeekAll.toFixed(1) + ' gal a week for ' + plants +
          ' plants · check the top inch of soil before watering, and water deeply in the morning rather than lightly every evening',
        rows: rows,
        chart: [
          { label: 'Weekly water for your plants (gal)', value: Math.round(galWeekAll * 10) / 10, tone: 'main' },
          { label: 'Extra a heatwave or container adds (gal)', value: Math.round(galWeekAll * 10) / 10, tone: 'warn' },
        ],
      };
    });
  })();
</script>
