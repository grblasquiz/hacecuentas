---
/**
 * Hub EN — "How many plants fit, how far apart, and how long until they sprout?"
 * audience="US" y lang="en" literales; el mercado real viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  CM_PER_IN,
  M2_PER_FT2,
  L_PER_GAL,
  SPACING_CM,
  SEEDS_PER_M2,
  GERMINATION,
  POT_MULT,
  DRAINAGE_SHARE,
} from '../../../lib/hubs/en/planting-and-spacing';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hacecuentas.com/en' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="US"
  lang="en"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ CM_PER_IN, M2_PER_FT2, L_PER_GAL, SPACING_CM, SEEDS_PER_M2, GERMINATION, POT_MULT, DRAINAGE_SHARE }}
>
  (function () {
    const H = window.HC_HUB;
    const n0 = (x) => Math.round(x || 0).toLocaleString('en-US');

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'spacing';
      const areaFt2 = Math.max(0, v.area || 0);
      const areaM2 = areaFt2 * M2_PER_FT2;

      if (id === 'seeds') {
        const crop = String(v.seedcrop || 'lettuce');
        const density = SEEDS_PER_M2[crop] ?? 10;
        const seeds = areaM2 * density;
        const margin = seeds * 0.15;
        const perFt2 = density * M2_PER_FT2;
        const rows = [
          { k: 'Bed area', ref: n0(areaFt2) + ' sq ft', v: areaM2, format: 'unit', unit: 'm²', decimals: 1 },
          { k: 'Sowing density', ref: 'For ' + crop, v: density, format: 'unit', unit: 'seeds/m²' },
          { k: 'The same density per square foot', ref: '1 sq ft = 0.09290304 m²', v: perFt2, format: 'unit', unit: 'seeds/sq ft', decimals: 1 },
          { k: 'Seeds for the bed', ref: 'Area × density', v: seeds, format: 'plain', extra: true },
          { k: 'Margin for failures', ref: '15% — more if the seed is over two years old', v: margin, format: 'plain' },
          { k: 'Seeds to buy', ref: 'Total with the margin', v: seeds + margin, format: 'plain', extra: true },
          { k: 'At a 50% germination rate, for old seed', ref: 'What three-year-old onion seed does', v: seeds * 2, format: 'plain' },
        ];
        return {
          total: n0(seeds + margin) + ' seeds',
          sub:
            density + ' seeds/m² over ' + n0(areaFt2) + ' sq ft, plus a 15% margin · ' +
            'sowing density is not final spacing — you sow thick and thin down · test old seed on a paper towel first',
          rows: rows,
          chart: [
            { label: 'Seeds for the bed', value: Math.round(seeds), tone: 'main' },
            { label: 'Margin for failures', value: Math.round(margin), tone: 'good' },
          ],
        };
      }

      if (id === 'germination') {
        const crop = String(v.germcrop || 'tomato');
        const f = Math.max(32, v.soiltemp || 68);
        const c = (f - 32) * (5 / 9);
        const band = c < 18 ? 'cool' : c < 23 ? 'mid' : 'warm';
        const table = GERMINATION[crop] || GERMINATION.lettuce;
        const days = table[band];
        const mid = (s) => {
          const p = String(s).split('–').map(Number);
          return (p[0] + (p[1] || p[0])) / 2;
        };
        const rows = [
          { k: 'Soil temperature', ref: c.toFixed(1) + ' °C', v: f, format: 'unit', unit: '°F' },
          { k: 'Temperature band applied', ref: band === 'cool' ? 'Cool: around 59 °F' : band === 'mid' ? 'Mid: around 68 °F' : 'Warm: around 77 °F', v: band === 'cool' ? 59 : band === 'mid' ? 68 : 77, format: 'unit', unit: '°F' },
          { k: 'Days to germination', ref: days + ' days for ' + crop, v: mid(days), format: 'unit', unit: 'days', decimals: 1, extra: true },
          { k: 'At 59 °F soil', ref: table.cool + ' days', v: mid(table.cool), format: 'unit', unit: 'days', decimals: 1 },
          { k: 'At 68 °F soil', ref: table.mid + ' days', v: mid(table.mid), format: 'unit', unit: 'days', decimals: 1 },
          { k: 'At 77 °F soil', ref: table.warm + ' days', v: mid(table.warm), format: 'unit', unit: 'days', decimals: 1 },
          { k: 'Days you would save by warming to 77 °F', ref: 'A heat mat is what buys this', v: Math.max(0, mid(days) - mid(table.warm)), format: 'unit', unit: 'days', decimals: 1, extra: true },
          { k: 'Wait this long before re-sowing', ref: 'Twice the upper end of the range', v: mid(days) * 2, format: 'unit', unit: 'days', decimals: 0 },
        ];
        return {
          total: days + ' days',
          sub:
            crop + ' at ' + Math.round(f) + ' °F soil (' + c.toFixed(0) + ' °C) · ' +
            'warming to 77 °F would save about ' + Math.max(0, mid(days) - mid(table.warm)).toFixed(0) + ' days · ' +
            'measure the soil, not the air — they differ by weeks in spring',
          rows: rows,
          chart: [
            { label: 'Days at your soil temperature', value: Math.round(mid(days) * 10) / 10, tone: band === 'cool' ? 'warn' : 'main' },
            { label: 'Days you would save at 77 °F', value: Math.round(Math.max(0, mid(days) - mid(table.warm)) * 10) / 10, tone: 'good' },
          ],
        };
      }

      if (id === 'pot') {
        const ballIn = Math.max(0.5, v.rootball || 0.5);
        const mult = POT_MULT[String(v.planttype || 'fruiting')] ?? 1.5;
        const potIn = ballIn * mult;
        // Maceta troncocónica: profundidad ≈ 0,7 × diámetro. Mismo modelo que la fórmula viva.
        const potCm = potIn * CM_PER_IN;
        const liters = Math.PI * Math.pow(potCm / 2, 2) * potCm * 0.7 / 1000;
        const gal = liters / L_PER_GAL;
        const rows = [
          { k: 'Root-ball diameter', ref: (ballIn * CM_PER_IN).toFixed(1) + ' cm', v: ballIn, format: 'unit', unit: 'in', decimals: 1 },
          { k: 'Multiplier for this plant type', ref: String(v.planttype), v: mult, format: 'plain', decimals: 2 },
          { k: 'Recommended pot diameter', ref: potCm.toFixed(0) + ' cm', v: potIn, format: 'unit', unit: 'in', decimals: 1, extra: true },
          { k: 'Growing room around the root ball', ref: 'Half the diameter difference, each side', v: (potIn - ballIn) / 2, format: 'unit', unit: 'in', decimals: 1 },
          { k: 'Soil volume needed', ref: 'Tapered pot, depth ≈ 0.7 × diameter', v: gal, format: 'unit', unit: 'gal', decimals: 2, extra: true },
          { k: 'The same volume in litres', ref: '1 gal = 3.785411784 L', v: liters, format: 'unit', unit: 'L', decimals: 1 },
          { k: 'A nominal "1 gallon" nursery pot actually holds', ref: 'Trade sizes are not measurements', v: 0.7, format: 'unit', unit: 'gal', decimals: 2 },
        ];
        return {
          total: potIn.toFixed(1) + ' in pot',
          sub:
            'About ' + gal.toFixed(1) + ' gal (' + liters.toFixed(1) + ' L) of mix · ' +
            'step up one or two sizes at a time — soil with no roots in it stays wet and rots them',
          rows: rows,
          chart: [
            { label: 'Root ball (in)', value: Math.round(ballIn * 10) / 10, tone: 'main' },
            { label: 'Growing room added (in)', value: Math.round((potIn - ballIn) * 10) / 10, tone: 'good' },
          ],
        };
      }

      if (id === 'drainage') {
        const gal = Math.max(0.1, v.potvolume || 0.1);
        const min = gal * DRAINAGE_SHARE.min;
        const max = gal * DRAINAGE_SHARE.max;
        const rows = [
          { k: 'Pot volume', ref: (gal * L_PER_GAL).toFixed(1) + ' L', v: gal, format: 'unit', unit: 'gal', decimals: 1 },
          { k: 'Drainage layer, low end', ref: '5% of the volume', v: min, format: 'unit', unit: 'gal', decimals: 2 },
          { k: 'Drainage layer, high end', ref: '15% of the volume', v: max, format: 'unit', unit: 'gal', decimals: 2, extra: true },
          { k: 'In litres, high end', ref: '1 gal = 3.785411784 L', v: max * L_PER_GAL, format: 'unit', unit: 'L', decimals: 2 },
          { k: 'Soil volume left after the layer', ref: 'At the high end', v: gal - max, format: 'unit', unit: 'gal', decimals: 2 },
          { k: 'What actually fixes drainage', ref: 'Drainage holes and an open mix — not gravel', v: 0, format: 'plain' },
        ];
        return {
          total: min.toFixed(2) + '–' + max.toFixed(2) + ' gal',
          sub:
            'Five to fifteen percent of a ' + gal.toFixed(1) + ' gal pot · ' +
            'but a gravel layer under fine mix raises the perched water table and can make things worse — the drainage hole and the mix are what matter',
          rows: rows,
          chart: [
            { label: 'Potting mix (gal)', value: Math.round((gal - max) * 100) / 100, tone: 'main' },
            { label: 'Drainage layer (gal)', value: Math.round(max * 100) / 100, tone: 'good' },
          ],
        };
      }

      // spacing
      const crop = String(v.crop || 'tomato');
      const sp = SPACING_CM[crop] || SPACING_CM.tomato;
      const minIn = sp.min / CM_PER_IN;
      const maxIn = sp.max / CM_PER_IN;
      const rowFt = Math.max(0, v.rowlength || 0);
      const perRowMax = Math.floor((rowFt * 12) / minIn);
      const perRowMin = Math.floor((rowFt * 12) / maxIn);
      const perFtMax = 12 / minIn;
      const rows = [
        { k: 'Recommended spacing, minimum', ref: sp.min + ' cm', v: minIn, format: 'unit', unit: 'in', decimals: 1 },
        { k: 'Recommended spacing, maximum', ref: sp.max + ' cm', v: maxIn, format: 'unit', unit: 'in', decimals: 1 },
        { k: 'Plants per linear foot, tightest', ref: 'At the minimum spacing', v: perFtMax, format: 'plain', decimals: 2 },
        { k: 'Plants in a ' + rowFt + ' ft row, tightest', ref: 'Minimum spacing', v: perRowMax, format: 'plain', extra: true },
        { k: 'Plants in a ' + rowFt + ' ft row, roomiest', ref: 'Maximum spacing', v: perRowMin, format: 'plain', extra: true },
        { k: 'Row spacing to leave for access', ref: 'Usually wider than in-row spacing', v: Math.max(24, maxIn * 1.5), format: 'unit', unit: 'in', decimals: 0 },
        { k: 'Bed area you have', ref: areaM2.toFixed(1) + ' m²', v: areaFt2, format: 'unit', unit: 'sq ft' },
      ];
      return {
        total: minIn.toFixed(0) + '–' + maxIn.toFixed(0) + ' in apart',
        sub:
          sp.label + ' · ' + perRowMin + '–' + perRowMax + ' plants in a ' + rowFt + ' ft row · ' +
          'crowding costs yield rather than saving space, and still air between plants is what blight needs',
        rows: rows,
        chart: [
          { label: 'Plants at the roomiest spacing', value: perRowMin, tone: 'good' },
          { label: 'Extra plants if you crowd them', value: Math.max(0, perRowMax - perRowMin), tone: 'warn' },
        ],
      };
    });
  })();
</script>
