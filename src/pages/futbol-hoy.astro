---
// @incremental-standalone
export const prerender=true;
import Layout from '../layouts/Layout.astro';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';
import { footballMarkets, footballHreflang } from '../lib/football-markets';
const all=[{country:'Argentina',path:'/futbol-argentino-hoy',leagues:'Primera División y Primera Nacional'},...footballMarkets.map(m=>({country:m.country,path:m.path,leagues:m.leagues.join(' y ')}))];
const schema={'@context':'https://schema.org','@type':'ItemList',name:'Fútbol hoy por país',numberOfItems:all.length,itemListElement:all.map((x,i)=>({'@type':'ListItem',position:i+1,name:x.country,url:`https://hacecuentas.com${x.path}`}))};
---
<Layout title="Fútbol hoy: partidos, resultados y tablas por país | Hacé Cuentas" description="Partidos de hoy, resultados, próximos encuentros y tablas de las principales ligas de cada país." canonical="/futbol-hoy" hreflang={footballHreflang} schema={schema} domain="life" pageType="hub"><Header slot="header"/><main><section class="hero"><div class="wrap"><p>HACÉ CUENTAS · DEPORTES</p><h1>Todo el fútbol de hoy, <span>país por país</span></h1><div class="lead">Elegí tu país para ver partidos, resultados, próximos cruces y tablas. Cada landing se actualiza cuando termina un partido.</div></div></section><section class="wrap grid">{all.map(x=><a class="country" href={x.path}><small>FÚTBOL DE {x.country.toUpperCase()}</small><h2>{x.country}</h2><p>{x.leagues}</p><b>Ver partidos y tablas →</b></a>)}</section></main><Footer slot="footer"/></Layout>
<style>main{background:#f6f8fb;min-height:100vh}.wrap{width:min(1180px,calc(100% - 40px));margin:auto}.hero{padding:72px 0 50px;background:#fff}.hero p{color:#1769e0;font-weight:850;font-size:12px;letter-spacing:.09em}.hero h1{font-size:clamp(42px,6vw,76px);line-height:1;letter-spacing:-.055em;max-width:900px;margin:12px 0}.hero h1 span{color:#1769e0}.lead{color:#66758a;font-size:18px;max-width:720px;line-height:1.55}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:34px 0 80px}.country{background:#fff;border:1px solid #e4eaf2;border-radius:20px;padding:25px;transition:.2s}.country:hover{transform:translateY(-3px);border-color:#1769e0;box-shadow:0 12px 30px #142f5214}.country small{color:#1769e0;font-weight:800;font-size:10px;letter-spacing:.08em}.country h2{font-size:26px;margin:10px 0 5px}.country p{color:#66758a;min-height:40px}.country b{font-size:13px}@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.wrap{width:calc(100% - 28px)}.hero{padding:42px 0 30px}.grid{grid-template-columns:1fr;padding-top:20px}.country p{min-height:0}}</style>
