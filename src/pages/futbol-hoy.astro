---
// @incremental-standalone
export const prerender=true;
import Layout from '../layouts/Layout.astro';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';
import { footballMarkets, footballHreflang } from '../lib/football-markets';
const all=[{country:'Argentina',path:'/futbol-argentino-hoy',leagues:'Primera División y Primera Nacional'},...footballMarkets.map(m=>({country:m.country,path:m.path,leagues:m.leagues.join(' y ')}))];
const schema={'@context':'https://schema.org','@type':'ItemList',name:'Fútbol hoy por país',numberOfItems:all.length,itemListElement:all.map((x,i)=>({'@type':'ListItem',position:i+1,name:x.country,url:`https://hacecuentas.com${x.path}`}))};
---
<Layout title="Fútbol hoy: partidos, resultados y tablas por país | Hacé Cuentas" description="Partidos de hoy, resultados, próximos encuentros, horarios y tablas de las principales ligas de cada país, con una landing actualizada por mercado." canonical="/futbol-hoy" hreflang={footballHreflang} schema={schema} domain="life" pageType="hub" noAds={true}><Header slot="header"/><main><section class="hero"><div class="wrap"><p>HACÉ CUENTAS · DEPORTES</p><h1>Todo el fútbol de hoy, <span>país por país</span></h1><div class="lead">Elegí tu país para ver partidos, resultados, próximos cruces y tablas. Cada landing se actualiza cuando termina un partido.</div><a class="sport-home" href="/futbol">Explorar todas las herramientas de fútbol →</a></div></section><section class="wrap grid">{all.map(x=><a class="country" href={x.path}><small>FÚTBOL DE {x.country.toUpperCase()}</small><h2>{x.country}</h2><p>{x.leagues}</p><b>Ver partidos y tablas →</b></a>)}</section><section class="wrap evergreen"><header><div><small>FÚTBOL CON DATOS</small><h2>Más que partidos de hoy</h2></div><p>Entrá a herramientas que siguen funcionando cuando termina la fecha.</p></header><div class="evergreen-grid"><a href="/futbol/puntos-y-campeonato"><strong>Puntos y campeonato</strong><span>Escenarios para clasificar o salvarse.</span><b>Hacer la cuenta →</b></a><a href="/futbol/estadisticas"><strong>Estadísticas de jugadores</strong><span>Distancia, velocidad y referencias.</span><b>Medir rendimiento →</b></a><a href="/futbol/premios"><strong>Premios del fútbol</strong><span>Comparaciones y números del deporte.</span><b>Ver herramientas →</b></a></div></section><p class="wrap source">Fuente de resultados y posiciones: <a href="https://www.espn.com/soccer/" target="_blank" rel="noopener noreferrer external">ESPN</a>. Los horarios se muestran en la zona local de cada país y pueden tener una breve demora.</p></main><Footer slot="footer"/></Layout>
<style>main{background:#f6f8fb;min-height:100vh}.wrap{width:min(1180px,calc(100% - 40px));margin:auto}.hero{padding:72px 0 50px;background:#fff}.hero p{color:#1769e0;font-weight:850;font-size:12px;letter-spacing:.09em}.hero h1{font-size:clamp(42px,6vw,76px);line-height:1;letter-spacing:-.055em;max-width:900px;margin:12px 0}.hero h1 span{color:#1769e0}.lead{color:#66758a;font-size:18px;max-width:720px;line-height:1.55}.sport-home{display:inline-flex;margin-top:22px;color:#1769e0;font-size:13px;font-weight:800;text-decoration:underline;text-underline-offset:4px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:34px 0 80px}.country{background:#fff;border:1px solid #e4eaf2;border-radius:20px;padding:25px;transition:.2s}.country:hover{transform:translateY(-3px);border-color:#1769e0;box-shadow:0 12px 30px #142f5214}.country small{color:#1769e0;font-weight:800;font-size:10px;letter-spacing:.08em}.country h2{font-size:26px;margin:10px 0 5px}.country p{color:#66758a;min-height:40px}.country b{font-size:13px}.evergreen{padding:0 0 60px}.evergreen header{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:20px}.evergreen header small{color:#1769e0;font-weight:850;font-size:10px;letter-spacing:.12em}.evergreen h2{font-size:30px;letter-spacing:-.04em;margin:7px 0 0}.evergreen header p{color:#66758a;font-size:13px;max-width:360px;margin:0}.evergreen-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.evergreen-grid a{display:flex;flex-direction:column;gap:8px;min-height:150px;padding:18px;background:#174b7a;color:#fff;border-radius:16px}.evergreen-grid a:hover{background:#0f3d66}.evergreen-grid strong{font-size:16px}.evergreen-grid span{color:#d7e8f5;font-size:12px;line-height:1.45}.evergreen-grid b{margin-top:auto;color:#b9e0ff;font-size:11px}@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}.evergreen-grid{grid-template-columns:1fr}.evergreen header{display:block}.evergreen header p{margin-top:8px}}@media(max-width:560px){.wrap{width:calc(100% - 28px)}.hero{padding:42px 0 30px}.grid{grid-template-columns:1fr;padding-top:20px}.country p{min-height:0}.evergreen{padding-bottom:40px}}</style>
