---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { freeOfferSchema } from '../lib/offer-schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PriorityDecisionCta from '../components/PriorityDecisionCta.astro';
import '../styles/calc-flagship.css';
import { ANSES_2026 } from '../lib/data/anses-2026';

// Valores de referencia 2026 de esta página (fuente única para SSR y para el
// script del cliente, que los lee por data-* del root). Son los mismos que ya
// usaba el simulador: NO se inventan datos previsionales.
const JUB_MIN = ANSES_2026.haberMinimo;
const BONO = 70_000;          // refuerzo extraordinario, no integra el haber
const JUB_MAX = ANSES_2026.haberMaximo;
const PBU = ANSES_2026.pbu;
const PUAM_PCT = 0.80;        // PUAM = 80% de la mínima
const PUAM = JUB_MIN * PUAM_PCT;
const PISO = JUB_MIN;
const TASA_ANUAL = 0.015;     // 1,5% por año de aportes (fórmula simplificada)
const APORTES_REQ = 30;       // régimen general

const fmtArs = (n: number) => '$' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(Math.round(n));

// Misma fórmula simplificada que el script del cliente (documentada más abajo).
function simular(sexo: string, edad: number, aportes: number, sueldo: number, aportesFuturos: number, regimen: string) {
  let edadJub = sexo === 'hombre' ? 65 : 60;
  let aportesReq = APORTES_REQ;
  if (regimen === 'puam') { edadJub = 65; aportesReq = 0; }
  const anosFaltan = Math.max(0, edadJub - edad);
  const futurosPosibles = Math.min(Math.max(0, aportesFuturos), anosFaltan);
  const aportesAlJubilar = aportes + futurosPosibles;
  const aportesComputados = Math.min(aportesAlJubilar, 35);
  const cumpleAportes = aportesAlJubilar >= aportesReq;
  const sueldoJub = sueldo;
  let haber: number;
  if (regimen === 'puam') haber = PUAM;
  else if (!cumpleAportes) haber = 0;
  else haber = Math.max(PISO, Math.min(PBU + sueldoJub * TASA_ANUAL * aportesComputados, JUB_MAX));
  const tasaReemplazo = sueldoJub > 0 && haber > 0 ? (haber / sueldoJub) * 100 : 0;
  return { edadJub, aportesReq, anosFaltan, aportesAlJubilar, aportesComputados, cumpleAportes, sueldoJub, haber, tasaReemplazo };
}

// Caso por defecto: los aportes futuros son explícitos y la remuneración se
// expresa en pesos de hoy. No proyectamos un sueldo terminal como promedio ANSES.
const INIT = { sexo: 'mujer', edad: 40, aportes: 15, sueldo: 1_500_000, aportesFuturos: 20, regimen: 'general' };
const init = simular(INIT.sexo, INIT.edad, INIT.aportes, INIT.sueldo, INIT.aportesFuturos, INIT.regimen);

// Escenarios de referencia: computados con la MISMA fórmula del simulador, con el
// caso ya en edad jubilatoria (edad 60 = edadJub de mujer ⇒ sin proyección de aumentos).
const escenarios = [20, 25, 30, 35, 40].map((a) => ({
  aportes: a,
  ...simular('mujer', 60, a, INIT.sueldo, 0, 'general'),
}));

const title = 'Simulador jubilación ANSES 2026: edad, aportes y haber';
const description = 'Calculá cuándo podrías jubilarte, cuántos aportes te faltan y un haber orientativo. Valores ANSES vigentes y escenarios de jubilación o PUAM.';

const lastReviewed = '2026-08-16';

const schemaApp = {
  '@type': 'WebApplication',
  name: 'Simulador de Jubilación ANSES',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  url: 'https://hacecuentas.com/simulador-jubilacion-anses',
  description,
  publisher: { '@id': 'https://hacecuentas.com/#organization' },
  dateModified: lastReviewed,
  offers: freeOfferSchema({ priceCurrency: 'ARS' }),
  speakable: {
    '@type': 'SpeakableSpecification',
    // Selectores del body rediseñado (.cf-*): el .lead y el [data-haber-estimado]
    // del layout viejo ya no existen.
    cssSelector: ['.cf-h1', '.cf-sub', '#sj-haber'],
  },
};

const schemaBreadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
    { '@type': 'ListItem', position: 2, name: 'Finanzas', item: 'https://hacecuentas.com/finanzas-personales' },
    { '@type': 'ListItem', position: 3, name: 'Simulador jubilación ANSES', item: 'https://hacecuentas.com/simulador-jubilacion-anses' },
  ],
};

const faq = [
  { q: '¿Cuántos años de aportes necesito para jubilarme?', a: 'En el régimen general se requieren <strong>30 años de aportes</strong>. Los regímenes diferenciales y especiales tienen requisitos propios y no se calculan con este simulador.' },
  { q: '¿Qué edad necesito?', a: '<strong>60 años mujer, 65 años hombre</strong>. Con la reforma jubilatoria se igualó en varios países hispanos. En AR sigue esa diferencia por género.' },
  { q: '¿Cómo se calcula el haber jubilatorio?', a: 'ANSES suma la Prestación Básica Universal (PBU), la Prestación Compensatoria por aportes anteriores a julio de 1994 y la Prestación Adicional por Permanencia por aportes posteriores. PC y PAP consideran remuneraciones actualizadas; esta herramienta solo ofrece una aproximación.' },
  { q: '¿Qué es la PUAM?', a: 'La Pensión Universal para el Adulto Mayor es una prestación para personas de 65 años o más que no cobran ni tienen derecho a jubilación o pensión. Equivale al 80% del haber mínimo y exige, entre otras condiciones, residencia y evaluación socioeconómica.' },
  { q: '¿Puedo jubilarme antes de los 60/65?', a: 'Jubilación por invalidez, régimen especial (docente, minero, policial), retiro voluntario en empresa privada. Cada caso tiene requisitos específicos.' },
  { q: '¿Cuánto actualiza la jubilación?', a: 'Por <strong>movilidad IPC mensual</strong> desde 2024 (antes por fórmula semestral). Se actualiza en boletín oficial. Bonos adicionales se suman según contexto.' },
  { q: '¿Si trabajo en negro cuenta?', a: 'Un período sin aportes no aparece automáticamente en la historia laboral. Podés reunir pruebas y pedir reconocimiento de servicios; cualquier plan de regularización depende de que esté vigente y de que cumplas sus condiciones.' },
  { q: '¿Qué es el RIPTE?', a: 'Remuneraciones Imponibles Promedio de los Trabajadores Estables. Se usa para actualizar el valor de los aportes viejos al momento de jubilación.' },
  { q: '¿Puedo jubilarme y seguir trabajando?', a: 'Sí, en el régimen general. Pero los aportes que sigás haciendo <strong>no aumentan tu jubilación</strong>. En ciertos regímenes especiales hay incompatibilidad.' },
  { q: '¿Cómo puedo mejorar mi situación futura?', a: 'Revisá que tu Historia Laboral esté completa, regularizá períodos solo mediante opciones vigentes y verificadas, y evaluá ahorro complementario. La incidencia de las remuneraciones depende de los meses computables, su actualización y los topes imponibles; confirmá tu caso en Mi ANSES.' },
];

const schemaFaq = {
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [schemaApp, schemaBreadcrumb, schemaFaq],
};
---
<Layout title={title} description={description} image="/og/simulador-jubilacion-anses.png" schema={schema} domain="life">
  <Header slot="header" />

  <div class="cf-page sj" data-domain="life"
    data-jub-min={JUB_MIN} data-bono={BONO} data-jub-max={JUB_MAX}
    data-pbu={PBU} data-puam-pct={PUAM_PCT} data-tasa={TASA_ANUAL}>
    <nav class="cf-crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li aria-hidden="true" class="cf-crumb__sep">›</li>
        <li><a href="/finanzas-personales">Finanzas</a></li>
        <li aria-hidden="true" class="cf-crumb__sep">›</li>
        <li aria-current="page">Simulador de jubilación</li>
      </ol>
    </nav>

    <header class="cf-hero">
      <div class="cf-hero__main">
        <p class="cf-kicker"><span aria-hidden="true">👴</span> ANSES · Régimen previsional 2026</p>
        <h1 class="cf-h1">Simulador de <span class="cf-yr">jubilación ANSES</span></h1>
        <p class="cf-sub">Estimá cuándo podrías jubilarte, qué aportes te faltarían y un escenario orientativo de haber con valores ANSES vigentes.</p>
        <ul class="cf-pills">
          <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Datos verificados 2026</li>
          <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Cálculo privado</li>
          <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Resultado explicado</li>
        </ul>
      </div>
      <div class="cf-hero__deco" aria-hidden="true">
        <span class="cf-deco-float"><span aria-hidden="true">📊</span> Fórmula simplificada</span>
        <div class="sj-deco-wrap">
          <div class="cf-deco-card">
            <div class="cf-deco-card__label">Dato principal</div>
            <div class="cf-deco-card__value" id="sj-deco-val">{fmtArs(init.haber)}</div>
            <div class="cf-deco-card__note">Escenario orientativo de haber</div>
          </div>
          <span class="cf-deco-badge sj-badge">👴</span>
        </div>
        <div class="cf-deco-sub"><strong>Tasa de reemplazo</strong> <span class="cf-deco-chip" id="sj-deco-tasa">{init.tasaReemplazo.toFixed(1).replace('.', ',')}%</span></div>
      </div>
    </header>

    <section class="cf-card" id="calc">
      <div class="cf-panel">
        <div class="cf-panel__head">
          <div>
            <p class="cf-panel__eyebrow">Calculadora</p>
            <h2 class="cf-panel__title">Tu situación previsional</h2>
          </div>
          <span class="cf-panel__priv"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> No guardamos tus datos</span>
        </div>

        <div class="cf-grid2">
          <div class="cf-field">
            <div class="cf-field__row"><label class="cf-label" for="sj-sexo">Sexo</label><span class="cf-hint">Edad de retiro</span></div>
            <select class="cf-input" id="sj-sexo">
              <option value="mujer">Mujer (jubilación a los 60)</option>
              <option value="hombre">Hombre (jubilación a los 65)</option>
            </select>
          </div>
          <div class="cf-field">
            <div class="cf-field__row"><label class="cf-label" for="sj-regimen">Régimen</label></div>
            <select class="cf-input" id="sj-regimen">
              <option value="general">General (60/65 años, 30 aportes)</option>
              <option value="puam">PUAM (65+ sin 30 aportes)</option>
            </select>
          </div>
        </div>

        <div class="cf-grid2">
          <div class="cf-field">
            <div class="cf-field__row"><label class="cf-label" for="sj-edad">Edad actual</label></div>
            <input class="cf-input cf-input--money" type="number" id="sj-edad" min="18" max="80" value="40" />
          </div>
          <div class="cf-field">
            <div class="cf-field__row"><label class="cf-label" for="sj-aportes">Años de aportes</label><span class="cf-hint">Acumulados</span></div>
            <input class="cf-input cf-input--money" type="number" id="sj-aportes" min="0" max="50" value="15" />
          </div>
        </div>

        <div class="cf-grid2">
          <div class="cf-field">
            <div class="cf-field__row"><label class="cf-label" for="sj-sueldo">Remuneración mensual de referencia</label><span class="cf-hint">pesos de hoy</span></div>
            <div class="sj-money"><span class="sj-money__sign">$</span><input class="cf-input cf-input--money" type="text" inputmode="numeric" id="sj-sueldo" value="1.500.000" /></div>
          </div>
          <div class="cf-field">
            <div class="cf-field__row"><label class="cf-label" for="sj-aportes-futuros">Años más que estimás aportar</label><span class="cf-hint">hasta la edad ordinaria</span></div>
            <input class="cf-input cf-input--money" type="number" id="sj-aportes-futuros" value="20" min="0" max="42" />
          </div>
        </div>
        <p class="cf-help">Usá como referencia un promedio mensual actualizado de remuneraciones sujetas a aportes. La herramienta no supone que seguirás aportando: indicá cuántos años más estimás hacerlo.</p>

        <button class="cf-primary" id="sj-calc-btn" type="button">Ver mi jubilación estimada <span aria-hidden="true">→</span></button>

        <div class="cf-shortcuts">
          <span class="cf-shortcuts__lbl">Ejemplos:</span>
          <button class="cf-sc" type="button" data-ej-edad="30" data-ej-aportes="8">30 años · 8 aportes</button>
          <button class="cf-sc" type="button" data-ej-edad="45" data-ej-aportes="22">45 años · 22 aportes</button>
          <button class="cf-sc" type="button" data-ej-edad="55" data-ej-aportes="30">55 años · 30 aportes</button>
        </div>
      </div>

      <div class="cf-result" id="sj-result">
        <p class="cf-result__eyebrow">Resultado estimado</p>
        <div class="cf-result__big" id="sj-haber">{fmtArs(init.haber)}</div>
        <div class="cf-result__biglabel">Escenario orientativo de haber</div>
        <p class="cf-result__sub" id="sj-haber-sub">{(init.haber / JUB_MIN).toFixed(1).replace('.', ',')}× la jubilación mínima</p>
        <div class="cf-tiles cf-tiles--2">
          <div class="cf-tile"><div class="cf-tile__value" id="sj-edad-jub">{init.edadJub} años</div><div class="cf-tile__label">Edad de jubilación</div></div>
          <div class="cf-tile"><div class="cf-tile__value" id="sj-anos-faltan">{init.anosFaltan} años</div><div class="cf-tile__label">Te faltan</div></div>
          <div class="cf-tile"><div class="cf-tile__value" id="sj-aportes-total">{init.aportesAlJubilar} años</div><div class="cf-tile__label">Aportes al jubilarte</div></div>
          <div class="cf-tile"><div class="cf-tile__value" id="sj-tasa">{init.tasaReemplazo.toFixed(1).replace('.', ',')}%</div><div class="cf-tile__label">Tasa de reemplazo</div></div>
        </div>
        <div class="cf-rows">
          <div class="cf-rrow"><span class="cf-rrow__lbl">Remuneración de referencia <small>orientativa, en pesos de hoy</small></span><span class="cf-rrow__val" id="sj-sueldo-jub">{fmtArs(init.sueldoJub)}</span></div>
          <div class="cf-rrow"><span class="cf-rrow__lbl">Requisito de aportes <small>del régimen elegido</small></span><span class="cf-rrow__val" id="sj-aportes-status">Cumple ({init.aportesReq} req.)</span></div>
        </div>
        <div class="cf-result__formula" id="sj-formula">{fmtArs(PBU)} + ({fmtArs(init.sueldoJub)} × 1,5% × {init.aportesComputados}) = {fmtArs(init.haber)}</div>
        <p class="cf-stale-hint">Apretá Calcular para actualizar</p>
        <div class="cf-result__actions cf-result__actions--2">
          <button class="cf-rbtn" type="button" id="sj-copy"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copiar resultado</button>
          <button class="cf-rbtn" type="button" id="sj-detail"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg> Ver desglose</button>
        </div>
      </div>
    </section>

    <PriorityDecisionCta
      roomSlug="estoy-listo-para-jubilarme"
      href="/jubilacion/cuanto-voy-a-cobrar?from=simulador-jubilacion-anses"
      title="¿La jubilación y tus ahorros alcanzan para retirarte?"
      description="Cruzá este haber estimado con tus gastos, ahorro complementario y brecha mensual."
      sourcePage="simulador-jubilacion-anses"
      label="Evaluar si estás listo para jubilarte →"
    />

    <div class="cf-quick">
      <span class="cf-quick__ico" aria-hidden="true">⚡</span>
      <p class="cf-quick__txt" id="sj-quick"><strong>Respuesta rápida.</strong> A los {init.edadJub} años llegarías con {init.aportesAlJubilar} años de aportes y un haber estimado de <strong>{fmtArs(init.haber)}</strong>, el {init.tasaReemplazo.toFixed(1).replace('.', ',')}% de tu remuneración de referencia.</p>
      <span class="cf-formula">PBU + 1,5% × aportes × remuneración</span>
    </div>

    <!-- Feasibility -->
    <div class="cf-callout sj-feasible" id="sj-feasible" style="margin-top:1.5rem">
      <span class="cf-callout__ico" aria-hidden="true" id="sj-feasible-ico">✓</span>
      <p><strong id="sj-feasible-title">Vas a jubilarte en tiempo</strong><br /><span id="sj-feasible-text">—</span></p>
    </div>

    <!-- Datos clave -->
    <section class="cf-section">
      <div class="cf-section__head">
        <div>
          <p class="cf-eyebrow">Datos clave</p>
          <h2 class="cf-section__title">Todo lo importante, de un vistazo</h2>
        </div>
        <p class="cf-section__lead">Valores de referencia del caso cargado y reglas principales para interpretar el resultado.</p>
      </div>
      <div class="cf-cards cf-cards--4">
        <div class="cf-minicard cf-minicard--dark">
          <span class="cf-minicard__ico" aria-hidden="true">⬇️</span>
          <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Haber mínimo</p>
          <div class="cf-minicard__big">{fmtArs(JUB_MIN)}</div>
          <p class="cf-minicard__desc" style="margin-top:0.3rem">Agosto 2026. El bono extraordinario se muestra aparte.</p>
        </div>
        <div class="cf-minicard">
          <span class="cf-minicard__ico" aria-hidden="true">📊</span>
          <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">PBU</p>
          <div class="cf-minicard__big">{fmtArs(PBU)}</div>
          <p class="cf-minicard__desc" style="margin-top:0.3rem">Componente básico que se suma al cálculo del haber inicial.</p>
        </div>
        <div class="cf-minicard">
          <span class="cf-minicard__ico" aria-hidden="true">⬆️</span>
          <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Jubilación máxima</p>
          <div class="cf-minicard__big">{fmtArs(JUB_MAX)}</div>
          <p class="cf-minicard__desc" style="margin-top:0.3rem">Tope oficial de agosto 2026.</p>
        </div>
        <div class="cf-minicard">
          <span class="cf-minicard__ico" aria-hidden="true">🛟</span>
          <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">PUAM</p>
          <div class="cf-minicard__big">{fmtArs(PUAM)}</div>
          <p class="cf-minicard__desc" style="margin-top:0.3rem">80% de la mínima, a los 65, sujeto a residencia, incompatibilidades y demás requisitos.</p>
        </div>
      </div>
    </section>

    <!-- Cómo leer el resultado -->
    <section class="cf-section">
      <div class="sj-2col">
        <div class="sj-hl">
          <p class="cf-side-eyebrow">Cómo leer el resultado</p>
          <p class="sj-hl__title">La tasa de reemplazo es el número que importa</p>
          <p class="sj-hl__desc">No mires solo el haber en pesos: comparalo con tus ingresos y gastos. La estimación suma la PBU y un 1,5% de la remuneración de referencia por cada año aportado.</p>
          <div class="sj-hl__big" id="sj-hl-big">{init.tasaReemplazo.toFixed(1).replace('.', ',')}%</div>
          <p class="sj-hl__desc">Tasa de reemplazo del caso cargado</p>
        </div>
        <div class="cf-breakdown">
          <div class="cf-brow">
            <span class="cf-brow__lbl">Tu haber estimado</span>
            <span class="cf-brow__val" id="sj-b-haber">{fmtArs(init.haber)}</span>
            <span class="cf-brow__bar"><span id="sj-b-haber-bar" style={`width:${Math.min(100, Math.round((init.haber / JUB_MAX) * 100))}%`}></span></span>
          </div>
          <p class="sj-note">Comparado contra el tope máximo del sistema</p>
          <div class="cf-brow" style="margin-top:1rem">
            <span class="cf-brow__lbl">Prestación Básica Universal</span>
            <span class="cf-brow__val">{fmtArs(PBU)}</span>
            <span class="cf-brow__bar"><span class="sj-bar--alt" style={`width:${Math.round((PBU / JUB_MAX) * 100)}%`}></span></span>
          </div>
          <p class="sj-note">Componente fijo del haber inicial</p>
          <div class="cf-brow" style="margin-top:1rem">
            <span class="cf-brow__lbl">Haber mínimo garantizado</span>
            <span class="cf-brow__val">{fmtArs(PISO)}</span>
            <span class="cf-brow__bar"><span class="sj-bar--min" style={`width:${Math.round((PISO / JUB_MAX) * 100)}%`}></span></span>
          </div>
          <p class="sj-note">Nadie que cumpla requisitos cobra menos que esto</p>
          <div class="cf-callout cf-callout--warn" style="margin-top:1.25rem">
            <span class="cf-callout__ico" aria-hidden="true">📉</span>
            <p>Una tasa de reemplazo por debajo del <strong>50%</strong> significa que este escenario da menos de la mitad de tu remuneración de referencia. Comparalo con tus gastos antes de decidir cuánto ahorro complementario necesitás.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Paso a paso -->
    <section class="cf-section">
