<script is:inline>
  (function () {
    const root = document.querySelector('.sj');
    if (!root) return;
    // Constantes de referencia 2026: vienen del frontmatter por data-* (fuente única).
    const JUB_MIN = Number(root.getAttribute('data-jub-min'));
    const BONO = Number(root.getAttribute('data-bono'));
    const JUB_MAX = Number(root.getAttribute('data-jub-max'));
    const PBU = Number(root.getAttribute('data-pbu'));
    const PUAM_PCT = Number(root.getAttribute('data-puam-pct'));
    const TASA = Number(root.getAttribute('data-tasa'));
    const PISO = JUB_MIN;
    const PUAM = JUB_MIN * PUAM_PCT;

    const $ = (id) => document.getElementById(id);
    const fmtArs = (n) => '$' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(Math.round(n));
    const dec = (n, d) => n.toFixed(d).replace('.', ',');

    const sexoEl = $('sj-sexo'), edadEl = $('sj-edad'), aportesEl = $('sj-aportes'),
      sueldoEl = $('sj-sueldo'), futurosEl = $('sj-aportes-futuros'), regimenEl = $('sj-regimen');
    let trackedStart = false;
    const track = (name, params = {}) => { if (typeof window.hcTrack === 'function') window.hcTrack(name, params); };

    function parseAmt(s) { return Number(String(s || '').replace(/\D/g, '')) || 0; }
    function fmtThousands(v) { const n = String(v).replace(/\D/g, ''); return n ? Number(n).toLocaleString('es-AR') : ''; }
    function syncFutureMax() {
      const ordinaryAge = regimenEl.value === 'puam' ? 65 : (sexoEl.value === 'hombre' ? 65 : 60);
      const available = Math.max(0, ordinaryAge - (Number(edadEl.value) || 0));
      futurosEl.max = String(available);
      if ((Number(futurosEl.value) || 0) > available) futurosEl.value = String(available);
    }

    // El resultado SÓLO se recalcula al apretar Calcular (o Enter en un input).
    // Cualquier cambio de input marca el panel como pendiente, no dispara el cálculo.
    const resultEl = $('sj-result');
    function markStale() { if (resultEl) resultEl.setAttribute('data-stale', '1'); }
    function clearStale() { if (resultEl) resultEl.removeAttribute('data-stale'); }
    function calcular() {
      track('calculator_start', { calculator_slug: 'simulador-jubilacion-anses', calculator_category: 'jubilacion', country: 'AR' });
      render(); clearStale();
      track('calculator_complete', { calculator_slug: 'simulador-jubilacion-anses', calculator_category: 'jubilacion', country: 'AR' });
    }
    function onEnter(el) { el.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); calcular(); } }); }

    // Misma aproximación que el SSR: PBU + 1,5% × hasta 35 años × remuneración de referencia,
    // acotada entre los haberes mínimo y máximo. El bono no integra el haber.
    function simular() {
      const sexo = sexoEl.value;
      const edad = Number(edadEl.value) || 0;
      const aportes = Number(aportesEl.value) || 0;
      const sueldo = parseAmt(sueldoEl.value);
      const aportesFuturos = Number(futurosEl.value) || 0;
      const regimen = regimenEl.value;
      let edadJub = sexo === 'hombre' ? 65 : 60;
      let aportesReq = 30;
      if (regimen === 'puam') { edadJub = 65; aportesReq = 0; }
      const anosFaltan = Math.max(0, edadJub - edad);
      const futurosPosibles = Math.min(Math.max(0, aportesFuturos), anosFaltan);
      const aportesAlJubilar = aportes + futurosPosibles;
      const aportesComputados = Math.min(aportesAlJubilar, 35);
      const cumpleAportes = aportesAlJubilar >= aportesReq;
      const sueldoJub = sueldo;
      let haber;
      if (regimen === 'puam') haber = PUAM;
      else if (!cumpleAportes) haber = 0;
      else haber = Math.max(PISO, Math.min(PBU + sueldoJub * TASA * aportesComputados, JUB_MAX));
      const tasaReemplazo = sueldoJub > 0 && haber > 0 ? (haber / sueldoJub) * 100 : 0;
      return { sexo, edad, aportes, sueldo, aportesFuturos, futurosPosibles, regimen, edadJub, aportesReq, anosFaltan,
        aportesAlJubilar, aportesComputados, cumpleAportes, sueldoJub, haber, tasaReemplazo };
    }

    function render() {
      const r = simular();
      const tieneHaber = r.haber > 0;

      $('sj-haber').textContent = tieneHaber ? fmtArs(r.haber) : '—';
      $('sj-haber-sub').textContent = tieneHaber
        ? dec(r.haber / JUB_MIN, 1) + '× la jubilación mínima'
        : 'No cumple los requisitos de aportes';
      $('sj-edad-jub').textContent = r.edadJub + ' años';
      $('sj-anos-faltan').textContent = r.anosFaltan === 0 ? 'Ya podés' : r.anosFaltan + ' años';
      $('sj-aportes-total').textContent = r.aportesAlJubilar + ' años';
      $('sj-tasa').textContent = tieneHaber ? dec(r.tasaReemplazo, 1) + '%' : '—';
      $('sj-sueldo-jub').textContent = fmtArs(r.sueldoJub);
      $('sj-aportes-status').textContent = r.regimen === 'puam'
        ? 'PUAM · sin requisito'
        : r.cumpleAportes ? 'Cumple (' + r.aportesReq + ' req.)' : 'Faltan ' + (r.aportesReq - r.aportesAlJubilar) + ' años';
      $('sj-formula').textContent = r.regimen === 'puam'
        ? fmtArs(JUB_MIN) + ' × 80% = ' + fmtArs(PUAM)
        : fmtArs(PBU) + ' + (' + fmtArs(r.sueldoJub) + ' × 1,5% × ' + r.aportesComputados + ') = ' + (tieneHaber ? fmtArs(r.haber) : '—');

      $('sj-deco-val').textContent = tieneHaber ? fmtArs(r.haber) : '—';
      $('sj-deco-tasa').textContent = tieneHaber ? dec(r.tasaReemplazo, 1) + '%' : '—';

      $('sj-quick').innerHTML = tieneHaber
        ? '<strong>Respuesta rápida.</strong> A los ' + r.edadJub + ' años llegarías con ' + r.aportesAlJubilar +
          ' años de aportes y un haber estimado de <strong>' + fmtArs(r.haber) + '</strong>, el ' +
          dec(r.tasaReemplazo, 1) + '% de tu remuneración de referencia.'
        : '<strong>Respuesta rápida.</strong> A los ' + r.edadJub + ' años llegarías con solo ' + r.aportesAlJubilar +
          ' años de aportes y el régimen exige ' + r.aportesReq + ': sin moratoria no accederías al haber.';

      $('sj-hl-big').textContent = tieneHaber ? dec(r.tasaReemplazo, 1) + '%' : '—';
      $('sj-b-haber').textContent = tieneHaber ? fmtArs(r.haber) : '—';
      $('sj-b-haber-bar').style.width = Math.min(100, Math.round((r.haber / JUB_MAX) * 100)) + '%';

      $('sj-s1').textContent = r.edad + ' años · ' + r.aportes + ' aportes · ' + fmtArs(r.sueldo);
      $('sj-s2').textContent = fmtArs(PBU) + ' + (' + fmtArs(r.sueldoJub) + ' × 1,5% × ' + r.aportesComputados + ')';
      $('sj-s3').textContent = tieneHaber ? fmtArs(r.haber) + ' · ' + dec(r.tasaReemplazo, 1) + '% de la referencia' : 'No cumple requisitos';

      // Viabilidad
      const fEl = $('sj-feasible'), fIco = $('sj-feasible-ico'), fT = $('sj-feasible-title'), fX = $('sj-feasible-text');
      if (r.regimen === 'puam') {
        fIco.textContent = '✓';
        fT.textContent = 'Accedés a la PUAM';
        fX.textContent = 'A los 65 años, si cumplís residencia, evaluación socioeconómica e incompatibilidades, podrías acceder a la PUAM: ' + fmtArs(PUAM) + ' por mes (80% de la mínima).';
        fEl.className = 'cf-callout sj-feasible sj-feasible--ok';
      } else if (r.cumpleAportes) {
        fIco.textContent = '✓';
        fT.textContent = 'Vas a jubilarte en tiempo';
        fX.textContent = 'Al cumplir ' + r.edadJub + ' años tendrías ' + r.aportesAlJubilar + ' años de aportes y el régimen ' +
          r.regimen + ' exige ' + r.aportesReq + '. Llegás con ' + (r.aportesAlJubilar - r.aportesReq) + ' de margen.';
        fEl.className = 'cf-callout sj-feasible sj-feasible--ok';
      } else {
        fIco.textContent = '⚠️';
        fT.textContent = 'No cumplirías los requisitos sin ajustes';
        fX.textContent = 'Al cumplir ' + r.edadJub + ' años solo tendrías ' + r.aportesAlJubilar + ' años de aportes y necesitás ' +
          r.aportesReq + '. Opciones: aportar más años (empleo formal o monotributo con SIPA), moratoria vigente si ANSES la habilita, o esperar a los 65 y acceder a la PUAM.';
        fEl.className = 'cf-callout cf-callout--warn sj-feasible';
      }

      // Recomendaciones personalizadas
      const recs = [];
      if (!r.cumpleAportes && r.regimen !== 'puam') {
        recs.push('<strong>Completá aportes</strong>: te faltan ' + (r.aportesReq - r.aportesAlJubilar) +
          ' años. Si podés, pasá a empleo formal o monotributo (aporta al SIPA) lo antes posible.');
      }
      if (tieneHaber && r.haber <= PISO * 1.1) {
        recs.push('<strong>Jubilación cerca del mínimo</strong>: tu proyección roza el piso de ' + fmtArs(PISO) +
          '. Para subir: maximizá tus últimos años de aportes, aportá voluntariamente y complementá con ahorro propio.');
      }
      if (tieneHaber && r.haber >= JUB_MAX) {
        recs.push('<strong>Tocás el tope máximo</strong>: el haber quedó limitado en ' + fmtArs(JUB_MAX) +
          '. Aportar más años ya no sube tu jubilación: el excedente conviene canalizarlo a ahorro propio.');
      }
      if (tieneHaber && r.haber < r.sueldoJub * 0.5) {
        recs.push('<strong>Tasa de reemplazo baja</strong>: vas a cobrar el ' + dec(r.tasaReemplazo, 1) +
          '% de tu remuneración de referencia. Compará este escenario con tus gastos y planificá ahorro complementario si la brecha es alta.');
      }
      if (r.anosFaltan > 10) {
        recs.push('<strong>Tenés tiempo a favor</strong>: con ' + r.anosFaltan +
          ' años por delante, el interés compuesto juega de tu lado. Ver <a href="/finanzas-personales">calculadoras financieras</a>.');
      }
      if (r.anosFaltan <= 5 && tieneHaber) {
        recs.push('<strong>Revisá tus remuneraciones computables</strong>: el cálculo oficial considera 120 meses con remuneración actualizada y topes imponibles. Confirmalos en Mi ANSES.');
      }
      if (recs.length === 0) {
        recs.push('Tu situación previsional se ve bien. Mantené los aportes al día y considerá complementar con ahorro personal.');
      }
      $('sj-recs-list').innerHTML = recs.map((x) => '<li>' + x + '</li>').join('');
    }

    // El formateo de miles sigue en vivo (es feedback de UI del propio input), el cálculo no.
    sueldoEl.addEventListener('input', () => { sueldoEl.value = fmtThousands(sueldoEl.value); markStale(); });
    sexoEl.addEventListener('change', () => { syncFutureMax(); markStale(); });
    regimenEl.addEventListener('change', () => { syncFutureMax(); markStale(); });
    edadEl.addEventListener('input', () => { syncFutureMax(); markStale(); });
    [aportesEl, futurosEl].forEach((el) => el.addEventListener('input', markStale));
    [sexoEl, regimenEl, edadEl, aportesEl, sueldoEl, futurosEl].forEach((el) => {
      onEnter(el);
      el.addEventListener('input', () => {
        if (!trackedStart) { trackedStart = true; track('hc_calculator_input_started', { calculator_slug: 'simulador-jubilacion-anses', calculator_category: 'jubilacion', country: 'AR' }); }
      });
    });
    $('sj-calc-btn').addEventListener('click', calcular);
    // Ejemplos: escriben los valores en los inputs, pero no recalculan.
    document.querySelectorAll('[data-ej-edad]').forEach((b) => b.addEventListener('click', () => {
      edadEl.value = b.getAttribute('data-ej-edad');
      aportesEl.value = b.getAttribute('data-ej-aportes');
      syncFutureMax();
      markStale();
    }));

    function summary() {
      const r = simular();
      if (r.haber <= 0) {
        return 'Simulador de jubilación ANSES: con ' + r.edad + ' años y ' + r.aportes + ' de aportes, a los ' +
          r.edadJub + ' llegaría con ' + r.aportesAlJubilar + ' años y el régimen exige ' + r.aportesReq +
          '. — hacecuentas.com';
      }
      return 'Simulador de jubilación ANSES: haber estimado ' + fmtArs(r.haber) + ' a los ' + r.edadJub +
        ' años, con ' + r.aportesAlJubilar + ' años de aportes (tasa de reemplazo ' + dec(r.tasaReemplazo, 1) +
        '% sobre una remuneración de referencia de ' + fmtArs(r.sueldoJub) + '). Estimación orientativa. — hacecuentas.com';
    }
    function shareUrl() {
      const r = simular();
      return location.origin + location.pathname + '?sexo=' + r.sexo + '&edad=' + r.edad + '&aportes=' + r.aportes +
        '&sueldo=' + r.sueldo + '&aportes_futuros=' + r.aportesFuturos + '&regimen=' + r.regimen;
    }
    function copy(t, btn) { navigator.clipboard?.writeText(t).then(() => { const o = btn.innerHTML; btn.innerHTML = '✓ Copiado'; setTimeout(() => btn.innerHTML = o, 1500); }); }
    $('sj-copy').addEventListener('click', (e) => copy(summary(), e.currentTarget));
    $('sj-detail').addEventListener('click', () => { document.getElementById('como-funciona')?.scrollIntoView({ behavior: 'smooth' }); });
    const s2 = $('sj-share2'); if (s2) s2.addEventListener('click', (e) => copy(shareUrl(), e.currentTarget));

    const q = new URLSearchParams(location.search);
    if (q.get('sexo')) sexoEl.value = q.get('sexo');
    if (q.get('regimen')) regimenEl.value = q.get('regimen');
    if (q.get('edad')) edadEl.value = q.get('edad');
    if (q.get('aportes')) aportesEl.value = q.get('aportes');
    if (q.get('sueldo')) sueldoEl.value = fmtThousands(q.get('sueldo'));
    if (q.get('aportes_futuros')) futurosEl.value = q.get('aportes_futuros');
    syncFutureMax();
    calcular();
  })();
</script>

