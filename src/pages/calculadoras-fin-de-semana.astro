---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

// Meta-hub de FIN DE SEMANA. El catálogo pesa hacia intención de día hábil
// (fiscal/laboral) → el orgánico se cae ~48% sáb/dom. Este hub agrupa los
// clusters RESILIENTES al finde (cocina, escapadas, fitness, ocio, mascotas),
// concentra link-equity interna en calcs que hoy rankean sólo en la cola, y
// crea una superficie nativa de finde apta para Discover. Complementa (no
// duplica) /calculadoras-evento, que es el hub profundo de asado/fiesta.
const calcModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
const allCalcs = Object.values(calcModules).map((m: any) => m.default || m);
const bySlug = new Map(allCalcs.map((c: any) => [c.slug, c]));

const groups: Array<{ title: string; icon: string; intro: string; slugs: string[] }> = [
  {
    title: 'Asado y juntadas',
    icon: '🔥',
    intro: 'El plan clásico de finde: cuánta carne, cerveza, empanadas y pizza por invitado para que no falte ni sobre. Tenés el hub completo con +40 calculadoras de evento.',
    slugs: [
      'calculadora-asado-kg-por-persona-cortes-tira-vacio-pollo',
      'calculadora-cerveza-por-invitado-duracion-fiesta',
      'calculadora-empanadas-por-invitado-juntada',
      'calculadora-pizza-por-invitado-porciones',
    ],
  },
  {
    title: 'Recetas y medidas de cocina',
    icon: '🍳',
    intro: 'Cocinar tranquilo el finde: convertí tazas a gramos, calculá las porciones de arroz, la proporción de cocción y la equivalencia de huevos sin tener que adivinar.',
    slugs: [
      'calculadora-conversion-medidas-cocina-tazas-gramos',
      'calculadora-porcion-arroz-gramos-personas',
      'calculadora-arroz-agua-proporcion-coccion',
      'calculadora-huevos-por-receta-comensales',
      'equivalencia-huevos-tamano-gramos-claras',
      'conversor-celsius-fahrenheit-temperatura',
    ],
  },
  {
    title: 'Escapadas y viajes',
    icon: '🚗',
    intro: 'La escapada de finde, sin sorpresas: cuánta nafta vas a gastar, cuánto salen los peajes, el costo del remis, el consumo cada 100 km y a qué hora llegás.',
    slugs: [
      'calculadora-combustible-viaje-auto',
      'calculadora-consumo-nafta-litros-100km',
      'calculadora-costo-peaje-ruta',
      'calculadora-estimador-costo-viaje-taxi-remis',
      'calculadora-horario-llegada-zona-horaria',
      'calculadora-llegada-aeropuerto-minutos-vuelo',
    ],
  },
  {
    title: 'Fitness y salud',
    icon: '💪',
    intro: 'El finde es para ponerse al día con el cuerpo: tu IMC, las calorías de mantenimiento, el déficit para bajar de peso, cuánto quemás caminando, el ritmo de carrera y el agua que tenés que tomar.',
    slugs: [
      'calculadora-imc',
      'calculadora-calorias-diarias-tdee',
      'calculadora-deficit-calorico-semanal',
      'calculadora-calorias-caminando',
      'ritmo-carrera-pace-km',
      'calculadora-agua-diaria-litros-segun-peso',
    ],
  },
  {
    title: 'Ocio y curiosidades',
    icon: '🎲',
    intro: 'Para matar el aburrimiento o resolver una discusión de sobremesa: compatibilidad de nombres, tu edad exacta, los días entre dos fechas y cuánto tardás en leer un libro.',
    slugs: [
      'calculadora-compatibilidad-nombres',
      'calculadora-edad-exacta',
      'dias-entre-dos-fechas',
      'calculadora-tiempo-lectura-paginas-estudio',
    ],
  },
  {
    title: 'Mascotas',
    icon: '🐶',
    intro: 'El finde tenés tiempo para tu mascota: cuántos gramos de comida por día, su peso ideal según la raza, su edad en años humanos y cuántos paseos necesita.',
    slugs: [
      'calculadora-comida-diaria-raza-perro',
      'calculadora-peso-ideal-perro-raza',
      'calculadora-edad-perro-anos-humanos',
      'calculadora-edad-gato-anos-humanos',
      'calculadora-paseos-diarios-perro-raza',
    ],
  },
];

const resolvedGroups = groups.map((g) => ({ ...g, items: g.slugs.map((s) => bySlug.get(s)).filter(Boolean) }));
const totalItems = resolvedGroups.reduce((acc, g) => acc + g.items.length, 0);

const title = `Calculadoras para el fin de semana — asado, recetas, escapadas, fitness y más | Hacé Cuentas`;
const description = `Las ${totalItems} calculadoras que más sirven el sábado y domingo: cuánta carne y cerveza para el asado, medidas de cocina, nafta y peajes de la escapada, IMC y calorías, y todo para tu mascota. Gratis y sin registro.`;
const canonical = '/calculadoras-fin-de-semana';

const allItems = resolvedGroups.flatMap((g) => g.items);
const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: 'Calculadoras para el fin de semana', description, numberOfItems: allItems.length,
  itemListElement: allItems.map((c: any, i: number) => ({ '@type': 'ListItem', position: i + 1, url: `https://hacecuentas.com/${c.slug}`, name: c.h1 })),
};
const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Calculadoras para el fin de semana', description, url: `https://hacecuentas.com${canonical}`, inLanguage: 'es-AR',
  isPartOf: { '@type': 'WebSite', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
};
const schema = { '@context': 'https://schema.org', '@graph': [itemListSchema, collectionSchema] };
---

<Layout title={title} description={description} canonical={canonical} audience="global" schema={schema}>
  <Header />
  <main class="article-main">
    <article class="hub-page">
      <header class="hub-header">
        <div class="hub-eyebrow">🗓️ Hub temático</div>
        <h1>Calculadoras para el fin de semana</h1>
        <p class="lede">
          Las cuentas que de verdad hacés el <strong>sábado y domingo</strong>: el <strong>asado</strong> y la juntada,
          las <strong>medidas de cocina</strong>, la <strong>nafta y los peajes</strong> de la escapada, el <strong>fitness</strong>
          que retomás y todo lo de tu <strong>mascota</strong>. {totalItems} calculadoras, gratis y sin registro.
        </p>
      </header>

      <nav class="hub-toc" aria-label="Índice del hub">
        <strong>Saltar a:</strong>
        <ul>
          {resolvedGroups.map((g) => (
            <li><a href={`#${g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{g.icon} {g.title}</a></li>
          ))}
        </ul>
      </nav>

      {resolvedGroups.map((g) => {
        const id = g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        return (
          <section class="hub-group" id={id}>
            <h2><span class="group-icon" aria-hidden="true">{g.icon}</span> {g.title}</h2>
            <p class="group-intro">{g.intro}</p>
            <ul class="hub-list">
              {g.items.map((c: any) => (
                <li class="hub-item">
                  <a href={`/${c.slug}`} class="hub-link">
                    <span class="hub-icon" aria-hidden="true">{c.icon || '🗓️'}</span>
                    <div class="hub-body"><strong>{c.h1}</strong><p>{c.description}</p></div>
                  </a>
                </li>
              ))}
            </ul>
            {g.title === 'Asado y juntadas' && (
              <p class="group-more"><a href="/calculadoras-evento">Ver el hub completo de asado, fiesta y evento →</a></p>
            )}
          </section>
        );
      })}

      <aside class="hub-cta">
        <h2>Buscás otra cosa</h2>
        <p>Explorá <a href="/categoria/cocina">cocina</a>, <a href="/categoria/viajes">viajes</a>, <a href="/categoria/salud">salud</a> o <a href="/categoria/mascotas">mascotas</a>, o mirá <a href="/calculadoras">todas las calculadoras →</a></p>
      </aside>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .hub-page { max-width: 980px; margin: 0 auto; padding: 1rem 1rem 3rem; }
  .hub-header { text-align: center; padding: 1.5rem 0 2rem; border-bottom: 1px solid var(--border, #e2e8f0); margin-bottom: 2rem; }
  .hub-eyebrow { display: inline-block; background: var(--accent-soft, #eef4ff); color: var(--accent-strong, #1e40af); padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; margin-bottom: 0.75rem; }
  .hub-header h1 { font-size: clamp(1.6rem, 4vw, 2.4rem); margin: 0.25rem 0 0.75rem; line-height: 1.15; }
  .lede { font-size: 1.05rem; color: var(--text-2, #475569); max-width: 760px; margin: 0 auto; line-height: 1.55; }
  .hub-toc { background: var(--surface-2, #f8fafc); padding: 1rem 1.25rem; border-radius: 0.75rem; margin: 0 0 2rem; font-size: 0.9rem; }
  .hub-toc strong { display: block; margin-bottom: 0.5rem; color: var(--text-2, #475569); }
  .hub-toc ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .hub-toc a { color: var(--accent, #2c5cdc); text-decoration: none; font-weight: 500; }
  .hub-toc a:hover { text-decoration: underline; }
  .hub-group { margin: 2.5rem 0; scroll-margin-top: 1rem; }
  .hub-group h2 { font-size: 1.4rem; margin: 0 0 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
  .group-icon { font-size: 1.5rem; line-height: 1; }
  .group-intro { color: var(--text-2, #475569); margin: 0 0 1rem; font-size: 0.975rem; line-height: 1.5; }
  .hub-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.75rem; }
  .hub-item { margin: 0; }
  .hub-link { display: flex; gap: 0.75rem; padding: 0.875rem; border: 1px solid var(--border, #e2e8f0); border-radius: 0.5rem; text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s; height: 100%; box-sizing: border-box; }
  .hub-link:hover { border-color: var(--accent, #2c5cdc); transform: translateY(-1px); }
  .hub-icon { font-size: 1.4rem; line-height: 1.2; flex-shrink: 0; }
  .hub-body { display: flex; flex-direction: column; min-width: 0; }
  .hub-body strong { color: var(--text, #1e293b); font-size: 0.975rem; line-height: 1.3; }
  .hub-body p { margin: 0.25rem 0 0; color: var(--text-2, #64748b); font-size: 0.85rem; line-height: 1.4; }
  .group-more { margin: 1rem 0 0; font-size: 0.95rem; }
  .group-more a { color: var(--accent, #2c5cdc); font-weight: 500; text-decoration: none; }
  .group-more a:hover { text-decoration: underline; }
  .hub-cta { margin-top: 3rem; padding: 1.5rem; background: var(--surface-2, #f8fafc); border-radius: 0.75rem; text-align: center; }
  .hub-cta h2 { font-size: 1.15rem; margin: 0 0 0.5rem; }
  .hub-cta p { margin: 0; color: var(--text-2, #475569); }
  .hub-cta a { color: var(--accent, #2c5cdc); font-weight: 500; }
  @media (max-width: 640px) { .hub-list { grid-template-columns: 1fr; } }
</style>
