---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PillarHub from '../components/PillarHub.astro';

export const prerender = true;

// Hub temático "asado / fiesta / juntada" — cluster de ~40 calcs de cantidad
// por invitado que estaban dispersas en cocina/vida/familia sin hub propio.
// Mismo patrón que /mundial-2026: agrupa + concentra autoridad interna + crea
// superficie de crawl. Alta intención de FIN DE SEMANA (asado/cumple/juntada).
const calcModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
const allCalcs = Object.values(calcModules).map((m: any) => m.default || m);
const bySlug = new Map(allCalcs.map((c: any) => [c.slug, c]));

const groups: Array<{ title: string; icon: string; intro: string; slugs: string[] }> = [
  {
    title: 'Asado y parrilla',
    icon: '🔥',
    intro: 'El asado del domingo, bien calculado: cuántos kilos de carne, achuras y chorizos por invitado para que no falte ni sobre.',
    slugs: [
      'calculadora-asado-por-invitado-kg-carne',
      'calculadora-asado-kg-por-persona-cortes-tira-vacio-pollo',
      'calculadora-achuras-por-invitado-parrilla',
      'calculadora-chorizos-por-invitado-asado',
    ],
  },
  {
    title: 'Bebidas y tragos',
    icon: '🍺',
    intro: 'Cuánta cerveza, fernet, champagne, hielo y bebida sin alcohol comprar según los invitados y la duración de la juntada.',
    slugs: [
      'calculadora-cerveza-por-invitado-duracion-fiesta',
      'calculadora-cerveza-invitado-evento',
      'calculadora-fernet-cola-por-invitado-juntada',
      'calculadora-fernet-cola-proporciones',
      'calculadora-champagne-por-invitado-brindis',
      'calculadora-pisco-por-invitado-previa',
      'calculadora-negroni-proporciones-invitados',
      'calculadora-old-fashioned-cantidad-invitados',
      'calculadora-hielo-por-invitado-fiesta',
      'calculadora-agua-por-invitado-fiesta',
      'calculadora-gaseosa-por-invitado-cumple-infantil',
      'calculadora-jugo-por-invitado-bautismo',
    ],
  },
  {
    title: 'Comida, picada y postre',
    icon: '🍕',
    intro: 'Empanadas, pizza, picada, ensaladas, pan y postres: las cantidades por invitado para cualquier evento.',
    slugs: [
      'calculadora-empanadas-por-invitado-juntada',
      'calculadora-empanadas-por-persona-evento-asado-cumple',
      'calculadora-pizza-por-invitado-porciones',
      'calculadora-fiambre-queso-por-invitado-picada',
      'calculadora-snacks-por-invitado-juntada',
      'calculadora-pan-por-invitado-evento',
      'calculadora-ensalada-por-invitado-evento',
      'calculadora-bocadillos-por-invitado-evento-coffee-break',
      'calculadora-canape-por-invitado-coctel',
      'calculadora-masitas-dulces-por-invitado-casamiento',
      'calculadora-cupcakes-por-invitado-cumple',
      'calculadora-helado-litros-por-evento-invitados-tipos',
      'calculadora-fruta-por-invitado-cumple',
    ],
  },
  {
    title: 'Fiesta, cumple y casamiento',
    icon: '🎉',
    intro: 'Presupuesto por invitado, cotillón, invitaciones, sillas y mesas, meseros y regalos para cumples, 15 y casamientos.',
    slugs: [
      'calculadora-presupuesto-casamiento-por-invitado',
      'calculadora-presupuesto-cumple-15-quinceanera',
      'calculadora-presupuesto-cumple-infantil',
      'boda-presupuesto-invitados-estimacion',
      'calculadora-sillas-mesas-invitados',
      'calculadora-meseros-necesarios-invitados',
      'calculadora-cotillon-cumple-personas',
      'calculadora-invitaciones-cumple-numero',
      'calculadora-regalos-invitado-souvenir',
      'calculadora-regalo-boda-apropiado-invitado',
    ],
  },
];

const resolvedGroups = groups.map((g) => ({ ...g, items: g.slugs.map((s) => bySlug.get(s)).filter(Boolean) }));
const totalItems = resolvedGroups.reduce((acc, g) => acc + g.items.length, 0);

const title = `Calculadoras para tu asado o evento: ${totalItems} por invitado`;
const description = `Organizá tu asado, cumpleaños, juntada o casamiento sin que falte ni sobre: ${totalItems} calculadoras de cuánto comprar por invitado — carne, cerveza, empanadas, pizza, hielo, sillas, presupuesto y más. Gratis y sin registro.`;
const canonical = '/calculadoras-evento';

const allItems = resolvedGroups.flatMap((g) => g.items);
const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: 'Calculadoras para eventos, asados y fiestas', description, numberOfItems: allItems.length,
  itemListElement: allItems.map((c: any, i: number) => ({ '@type': 'ListItem', position: i + 1, url: `https://hacecuentas.com/${c.slug}`, name: c.h1 })),
};
const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Calculadoras para eventos, asados y fiestas', description, url: `https://hacecuentas.com${canonical}`, inLanguage: 'es-AR',
  isPartOf: { '@type': 'WebSite', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
};
const schema = { '@context': 'https://schema.org', '@graph': [itemListSchema, collectionSchema] };

// Identidad de hub (mockup): hero + "necesidades" (los grupos del tema) vía
// PillarHub, full-bleed; las listas por grupo se preservan debajo.
const HUB_TONES = ['i1', 'i2', 'i3', 'i4', 'i5', 'i6'];
const anchorOf = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const hubConfig = {
  color: '#c2410c',
  nav: 'asado, fiesta y evento',
  h1: 'Calculadoras para tu asado, fiesta o evento',
  breadcrumb: [{ label: 'Inicio', href: '/' }, { label: 'Asado, fiesta y evento' }],
  eyebrow: '🎉 Hub temático',
  titleLines: ['Calculadoras para tu', 'asado, fiesta o evento'],
  lead: `Más de ${totalItems} calculadoras para organizar tu asado, cumpleaños, juntada o casamiento sin que falte ni sobre: cantidades por invitado. Cargás la gente y listo.`,
  trust: ['Cantidades por invitado', 'Gratis y sin registro', 'Cálculo privado'],
  quick: { tag: 'Para tu evento', title: 'Calculadoras de cocina', desc: 'Todo lo que se cocina y se sirve, por persona.', cta: 'Ver cocina →', href: '/categoria/cocina', variant: 'cta' as const },
  needsKicker: 'Elegí por necesidad',
  needsTitle: '¿Qué estás organizando?',
  needsSub: 'Entrá directo al tipo de cálculo que necesitás.',
  needs: resolvedGroups.map((g, i) => ({ icon: g.icon, tone: HUB_TONES[i % 6], title: g.title, desc: '', href: `#${anchorOf(g.title)}` })),
  featuredKicker: '', featuredTitle: '', featuredSub: '', showFeaturedSearch: false, filterBadges: [] as string[], cards: [] as any[],
  roomsKicker: '', roomsTitle: '', roomsSub: '', rooms: [] as any[], factsTitle: '', facts: [] as any[],
};
---

<Layout title={title} description={description} canonical={canonical} audience="global" schema={schema} pageType="hub">
  <Header />
  <PillarHub config={hubConfig} />
  <main class="article-main">
    <article class="hub-page">
      {resolvedGroups.map((g) => {
        const id = g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        return (
          <section class="hub-group" id={id}>
            <h2><span class="group-icon" aria-hidden="true">{g.icon}</span> {g.title}</h2>
            <p class="group-intro">{g.intro}</p>
            <ul class="hub-list">
              {g.items.map((c: any) => (
                <li class="hub-item">
                  <a href={`/${c.slug}`} class="hub-link">
                    <span class="hub-icon" aria-hidden="true">{c.icon || '🎉'}</span>
                    <div class="hub-body"><strong>{c.h1}</strong><p>{c.description}</p></div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      <aside class="hub-cta">
        <h2>¿Falta tu evento?</h2>
        <p>Seguí explorando <a href="/categoria/cocina">calculadoras de cocina →</a> o <a href="/categoria/vida">de vida cotidiana →</a>.</p>
      </aside>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .hub-page { max-width: 980px; margin: 0 auto; padding: 1rem 1rem 3rem; }
  .hub-header { text-align: center; padding: 1.5rem 0 2rem; border-bottom: 1px solid var(--border, #e2e8f0); margin-bottom: 2rem; }
  .hub-eyebrow { display: inline-block; background: var(--accent-soft, #eef4ff); color: var(--accent-strong, #1e40af); padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; margin-bottom: 0.75rem; }
  .hub-header h1 { font-size: clamp(1.6rem, 4vw, 2.4rem); margin: 0.25rem 0 0.75rem; line-height: 1.15; }
  .lede { font-size: 1.05rem; color: var(--text-2, #475569); max-width: 760px; margin: 0 auto; line-height: 1.55; }
  .hub-toc { background: var(--surface-2, #f8fafc); padding: 1rem 1.25rem; border-radius: 0.75rem; margin: 0 0 2rem; font-size: 0.9rem; }
  .hub-toc strong { display: block; margin-bottom: 0.5rem; color: var(--text-2, #475569); }
  .hub-toc ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .hub-toc a { color: var(--accent, #2c5cdc); text-decoration: none; font-weight: 500; }
  .hub-toc a:hover { text-decoration: underline; }
  .hub-group { margin: 2.5rem 0; scroll-margin-top: 1rem; }
  .hub-group h2 { font-size: 1.4rem; margin: 0 0 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
  .group-icon { font-size: 1.5rem; line-height: 1; }
  .group-intro { color: var(--text-2, #475569); margin: 0 0 1rem; font-size: 0.975rem; line-height: 1.5; }
  .hub-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.75rem; }
  .hub-item { margin: 0; }
  .hub-link { display: flex; gap: 0.75rem; padding: 0.875rem; border: 1px solid var(--border, #e2e8f0); border-radius: 0.5rem; text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s; height: 100%; box-sizing: border-box; }
  .hub-link:hover { border-color: var(--accent, #2c5cdc); transform: translateY(-1px); }
  .hub-icon { font-size: 1.4rem; line-height: 1.2; flex-shrink: 0; }
  .hub-body { display: flex; flex-direction: column; min-width: 0; }
  .hub-body strong { color: var(--text, #1e293b); font-size: 0.975rem; line-height: 1.3; }
  .hub-body p { margin: 0.25rem 0 0; color: var(--text-2, #64748b); font-size: 0.85rem; line-height: 1.4; }
  .hub-cta { margin-top: 3rem; padding: 1.5rem; background: var(--surface-2, #f8fafc); border-radius: 0.75rem; text-align: center; }
  .hub-cta h2 { font-size: 1.15rem; margin: 0 0 0.5rem; }
  .hub-cta p { margin: 0; color: var(--text-2, #475569); }
  .hub-cta a { color: var(--accent, #2c5cdc); font-weight: 500; }
  @media (max-width: 640px) { .hub-list { grid-template-columns: 1fr; } }
</style>
