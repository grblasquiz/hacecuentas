---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PillarHub from '../components/PillarHub.astro';
import NextTenBoost from '../components/NextTenBoost.astro';
import { PILLAR_BY_SLUG } from '../lib/pillars';

const pillar = PILLAR_BY_SLUG['impuestos-argentina'];
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pillar.title, url: 'https://hacecuentas.com/impuestos-argentina', dateModified: '2026-08-04', inLanguage: 'es-AR' };
---

<Layout
  title={pillar.title}
  description={pillar.description}
  canonical={'/' + pillar.slug}
  audience="AR"
  domain={pillar.domain}
  pageType="hub"
  schema={schema}
>
  <Header slot="header" />
  <PillarHub pillar={pillar} />
  <NextTenBoost variant="taxes" />
  <Footer slot="footer" />
</Layout>
