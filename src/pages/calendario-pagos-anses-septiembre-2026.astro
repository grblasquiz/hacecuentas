---
// Página de DATO estacional: calendario de pagos ANSES septiembre 2026 por terminación
// de DNI, con lookup interactivo simple (JS inline). Datos: ANSES / prensa (jul-2026).
// Los montos de septiembre aplican el IPC de julio (2,1%). Las fechas permanecen
// identificadas como estimadas hasta contar con el cronograma oficial de ANSES.
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import ActionCard from '../components/ui/ActionCard.astro';

const siteUrl = 'https://hacecuentas.com';
const URL_PAGE = `${siteUrl}/calendario-pagos-anses-septiembre-2026`;

const title = 'Calendario de pagos ANSES septiembre 2026: cuándo cobro según mi DNI | Hacé Cuentas';
const description = 'Fechas estimadas de pago ANSES para septiembre 2026 por terminación de DNI y montos calculados con la movilidad de 2,1%. Verificá el cronograma oficial en Mi ANSES.';

// Cronogramas por terminación de DNI (septiembre 2026)
const minima = [
  ['0', 'Martes 8 de septiembre'], ['1', 'Miércoles 9 de septiembre'], ['2', 'Jueves 10 de septiembre'],
  ['3', 'Viernes 11 de septiembre'], ['4', 'Lunes 14 de septiembre'], ['5', 'Martes 15 de septiembre'],
  ['6', 'Miércoles 16 de septiembre'], ['7', 'Jueves 17 de septiembre'], ['8', 'Viernes 18 de septiembre'],
  ['9', 'Lunes 21 de septiembre'],
];
const superan = [
  ['0 y 1', 'Martes 22 de septiembre'], ['2 y 3', 'Miércoles 23 de septiembre'],
  ['4 y 5', 'Jueves 24 de septiembre'], ['6 y 7', 'Viernes 25 de septiembre'],
  ['8 y 9', 'Lunes 28 de septiembre'],
];
const auh = [
  ['0', 'Martes 8 de septiembre'], ['1', 'Miércoles 9 de septiembre'], ['2', 'Jueves 10 de septiembre'],
  ['3', 'Viernes 11 de septiembre'], ['4', 'Lunes 14 de septiembre'], ['5', 'Martes 15 de septiembre'],
  ['6', 'Miércoles 16 de septiembre'], ['7', 'Jueves 17 de septiembre'], ['8', 'Viernes 18 de septiembre'],
  ['9', 'Lunes 21 de septiembre'],
];
const pnc = [
  ['0 y 1', 'Martes 8 de septiembre'], ['2 y 3', 'Miércoles 9 de septiembre'],
  ['4 y 5', 'Jueves 10 de septiembre'], ['6 y 7', 'Viernes 11 de septiembre'],
  ['8 y 9', 'Lunes 14 de septiembre'],
];

const faqItems = [
  {
    q: '¿Cuándo cobran los jubilados en septiembre 2026?',
    a: 'Si ANSES mantiene su patrón habitual, los jubilados y pensionados que cobran hasta el haber mínimo cobrarían entre el martes 8 y el lunes 21 de septiembre. Quienes superan el mínimo cobrarían del 22 al 28. Son fechas estimadas: confirmalas en Mi ANSES antes de organizar un pago.'
  },
  {
    q: '¿Cuándo se cobra la AUH en septiembre 2026?',
    a: 'Según el patrón habitual, la AUH se pagaría entre el 8 y el 21 de septiembre según la terminación del DNI. El cronograma todavía es estimado: verificá tu fecha exacta en Mi ANSES.'
  },
  {
    q: '¿Cuánto cobra un jubilado con la mínima en septiembre 2026?',
    a: 'La movilidad de septiembre es 2,1%, correspondiente al IPC de julio. Aplicada sobre la mínima de agosto da aproximadamente $428.549,14 brutos. Si el bono se mantiene en $70.000, el total sería cercano a $498.549,14; verificá la liquidación oficial en Mi ANSES.'
  },
  {
    q: '¿Cuánto cobra la AUH en septiembre 2026?',
    a: 'Con la movilidad de 2,1%, la AUH de septiembre se estima en $154.030 brutos por hijo y aproximadamente $123.224 de cobro mensual, considerando la retención del 20% hasta la presentación de la Libreta AUH. Verificá tu liquidación en Mi ANSES.'
  },
  {
    q: '¿Cuándo cobran las Pensiones No Contributivas (PNC) en septiembre 2026?',
    a: 'Según el patrón habitual, las PNC se pagarían del martes 8 al lunes 14 de septiembre, con DNI agrupados de a dos terminaciones por día. El monto estimado con la movilidad de 2,1% ronda $299.984; cualquier bono depende de confirmación oficial.'
  },
  {
    q: '¿Qué dato todavía falta confirmar?',
    a: 'La movilidad de 2,1% ya surge del IPC de julio. Todavía deben confirmarse el cronograma oficial de pagos, la continuidad y monto del bono y la liquidación particular de cada beneficiario.'
  },
  {
    q: '¿Septiembre tiene feriados que muevan el calendario?',
    a: 'No. Septiembre 2026 no tiene feriados nacionales, así que el cronograma avanza de corrido: los pagos solo saltan los fines de semana. Es distinto de agosto, donde el feriado del 17 (San Martín) corrió parte del calendario de la mínima.'
  },
  {
    q: '¿Qué pasa si no retiro la plata el día que me toca?',
    a: 'Nada: la fecha del calendario es el día en que ANSES acredita el pago en tu cuenta. El dinero queda depositado y podés extraerlo cuando quieras con tu tarjeta de débito, sin vencimiento inmediato. Solo los pagos por ventanilla sin acreditación bancaria tienen fecha límite de cobro.'
  },
  {
    q: '¿Dónde verifico mi fecha y lugar de cobro exactos?',
    a: 'En la app o web Mi ANSES (mi.anses.gob.ar), sección "Mis cobros", con CUIL y Clave de la Seguridad Social. Ahí figura la fecha, el banco y el monto exacto de tu liquidación de septiembre 2026.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': URL_PAGE,
      url: URL_PAGE,
      name: 'Calendario de pagos ANSES septiembre 2026 por terminación de DNI',
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      inLanguage: 'es-AR',
      datePublished: '2026-07-26',
      dateModified: '2026-08-16',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Finanzas', item: `${siteUrl}/categoria/finanzas` },
        { '@type': 'ListItem', position: 3, name: 'Calendario pagos ANSES septiembre 2026' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---
<Layout title={title} description={description} canonical="/calendario-pagos-anses-septiembre-2026" schema={schema} audience="AR" noindex={true}>
  <Header slot="header" />

  <article class="landing">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/categoria/finanzas">Finanzas</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Calendario pagos ANSES septiembre 2026</span>
    </nav>

    <!-- HERO -->
    <header class="hero">
      <h1>Calendario de pagos ANSES septiembre 2026: cuándo cobro según mi DNI</h1>
      <p class="lead">
        <strong>Estado: cronograma estimado, todavía no confirmado por ANSES.</strong> Según el patrón habitual, en septiembre 2026 los <strong>jubilados que cobran hasta la mínima</strong> cobrarían del
        <strong>8 al 21 de septiembre</strong>, los que <strong>superan la mínima</strong> del
        <strong>22 al 28</strong>, la <strong>AUH y el SUAF</strong> del <strong>8 al 21</strong> y las
        <strong>PNC</strong> del <strong>8 al 14</strong>, siempre según la terminación del DNI.
        Septiembre no tiene feriados nacionales, así que el cronograma corre sin saltos.
        La movilidad de septiembre queda en <strong>2,1%</strong>, correspondiente al IPC de julio publicado por INDEC. Las fechas deben verificarse en Mi ANSES antes de organizar un pago.
      </p>
      <div class="hero-meta">
        <span>Revisado: 16 de agosto de 2026</span>
        <span>Montos calculados · fechas todavía estimadas</span>
      </div>
    </header>

    <!-- BUSCADOR POR DNI -->
    <section class="section">
      <div class="lookup-box">
        <h2>¿Cuándo cobro? Buscá tu fecha</h2>
        <div class="lookup-controls">
          <label>
            ¿Qué cobrás?
            <select id="grupo">
              <option value="minima">Jubilación/pensión hasta la mínima</option>
              <option value="superan">Jubilación/pensión que supera la mínima</option>
              <option value="auh">AUH / Asignaciones Familiares (SUAF)</option>
              <option value="pnc">Pensión No Contributiva (PNC)</option>
            </select>
          </label>
          <label>
            Último número de tu DNI
            <select id="digito">
              <option value="0">0</option><option value="1">1</option><option value="2">2</option>
              <option value="3">3</option><option value="4">4</option><option value="5">5</option>
              <option value="6">6</option><option value="7">7</option><option value="8">8</option>
              <option value="9">9</option>
            </select>
          </label>
        </div>
        <div id="resultado" class="lookup-result" aria-live="polite">Fecha estimada: <strong>martes 8 de septiembre de 2026</strong>. Confirmala en Mi ANSES.</div>
      </div>
    </section>

    <!-- MONTOS -->
    <section class="section">
      <h2>Montos estimados para septiembre 2026</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Prestación</th><th>Monto vigente</th></tr></thead>
          <tbody>
            <tr><td class="concepto">Jubilación mínima (bruta)</td><td class="highlight">≈ $428.549,14</td></tr>
            <tr><td class="concepto">Mínima + bono, si se mantiene en $70.000</td><td class="highlight">≈ $498.549,14</td></tr>
            <tr><td class="concepto">Jubilación máxima</td><td>≈ $2.884.014</td></tr>
            <tr><td class="concepto">PUAM (80% de la mínima)</td><td>≈ $342.839 + bono, si corresponde</td></tr>
            <tr><td class="concepto">PNC invalidez / vejez (70%)</td><td>≈ $299.984 + bono, si corresponde</td></tr>
            <tr><td class="concepto">AUH por hijo (bruta)</td><td>≈ $154.030</td></tr>
            <tr><td class="concepto">AUH en mano (80%)</td><td>≈ $123.224</td></tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Cálculo: monto de agosto × 1,021. La movilidad está confirmada por el IPC de julio; el bono y cada liquidación individual requieren confirmación oficial.
        Más detalle en <a href="/aumento-jubilaciones">aumento de jubilaciones</a>.
      </p>
    </section>

    <!-- TABLAS POR GRUPO -->
    <section class="section">
      <h2>Jubilados y pensionados que cobran hasta la mínima</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>DNI terminado en</th><th>Fecha de cobro</th></tr></thead>
          <tbody>{minima.map(([d, f]) => <tr><td class="concepto">{d}</td><td>{f}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="table-note">Sin feriados en septiembre: el cronograma avanza un dígito por día hábil, del martes 8 al lunes 21.</p>
    </section>

    <section class="section">
      <h2>Jubilados y pensionados que superan la mínima</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>DNI terminado en</th><th>Fecha de cobro</th></tr></thead>
          <tbody>{superan.map(([d, f]) => <tr><td class="concepto">{d}</td><td>{f}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>AUH y Asignaciones Familiares (SUAF)</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>DNI terminado en</th><th>Fecha de cobro</th></tr></thead>
          <tbody>{auh.map(([d, f]) => <tr><td class="concepto">{d}</td><td>{f}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="table-note">
        Verificá la fecha exacta en Mi ANSES: la acreditación puede variar según el banco.
      </p>
    </section>

    <section class="section">
      <h2>Pensiones No Contributivas (PNC)</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>DNI terminado en</th><th>Fecha de cobro</th></tr></thead>
          <tbody>{pnc.map(([d, f]) => <tr><td class="concepto">{d}</td><td>{f}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <!-- CTA -->
    <div class="cta-box">
      <h3>Calculá cuánto te corresponde</h3>
      <p>Simulá tu jubilación o el monto de tu AUH con los valores actualizados.</p>
      <div class="cta-links">
        <a href="/simulador-jubilacion-anses" class="cta-btn">Simulador de jubilación ANSES</a>
        <a href="/calculadora-asignacion-universal-hijo-auh-2026-monto" class="cta-btn secondary">Calculadora AUH 2026</a>
      </div>
    </div>

    <!-- LINKS RELACIONADOS -->
    <section class="section">
      <h2>Herramientas relacionadas</h2>
      <div class="link-grid">
        <ActionCard href="/calendario-pagos-anses-agosto-2026" title="Calendario ANSES agosto 2026" desc="Las fechas y montos del mes anterior" icon='<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>' />
        <ActionCard href="/aumento-jubilaciones" title="Aumento de jubilaciones" desc="Cuánto suben los haberes este mes por movilidad" icon='<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>' />
        <ActionCard href="/calculadora-jubilacion-minima-anses" title="Jubilación mínima + bono" desc="Haber mínimo actualizado con y sin bono" icon='<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>' />
        <ActionCard href="/calculadora-asignacion-universal-hijo-auh-2026-monto" title="Calculadora AUH 2026" desc="Cuánto cobrás por hijo con el monto vigente" icon='<path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><circle cx="12" cy="12" r="10"/>' />
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq-section">
      <h2>Preguntas frecuentes sobre los pagos de ANSES en septiembre 2026</h2>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <Newsletter />
  </article>

  <Footer slot="footer" />
</Layout>

<script is:inline>
  (function () {
    const FECHAS = {
      minima: ['martes 8', 'miércoles 9', 'jueves 10', 'viernes 11', 'lunes 14', 'martes 15', 'miércoles 16', 'jueves 17', 'viernes 18', 'lunes 21'],
      superan: ['martes 22', 'martes 22', 'miércoles 23', 'miércoles 23', 'jueves 24', 'jueves 24', 'viernes 25', 'viernes 25', 'lunes 28', 'lunes 28'],
      auh: ['martes 8', 'miércoles 9', 'jueves 10', 'viernes 11', 'lunes 14', 'martes 15', 'miércoles 16', 'jueves 17', 'viernes 18', 'lunes 21'],
      pnc: ['martes 8', 'martes 8', 'miércoles 9', 'miércoles 9', 'jueves 10', 'jueves 10', 'viernes 11', 'viernes 11', 'lunes 14', 'lunes 14'],
    };
    const grupo = document.getElementById('grupo');
    const digito = document.getElementById('digito');
    const resultado = document.getElementById('resultado');
    function actualizar() {
      const g = grupo.value;
      const d = parseInt(digito.value, 10);
      const fecha = FECHAS[g][d];
      resultado.innerHTML = 'Fecha estimada: <strong>' + fecha + ' de septiembre de 2026</strong>. Confirmala en Mi ANSES.';
    }
    grupo.addEventListener('change', actualizar);
    digito.addEventListener('change', actualizar);
    actualizar();
  })();
</script>

<style>
  .landing { max-width: 860px; margin: 0 auto; padding: 0 0 3rem; }
  .breadcrumbs { font-size: 0.875rem; color: var(--text-subtle); margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .breadcrumbs a { color: var(--text-muted); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }
  .breadcrumbs .sep { color: var(--border-strong); }

  .hero { margin-bottom: 2.5rem; }
  .hero h1 { margin-bottom: 1rem; }
  .lead { font-size: 1.0625rem; color: var(--text-muted); margin-bottom: 1rem; max-width: 760px; line-height: 1.65; }
  .hero-meta { display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.8125rem; color: var(--text-subtle); }

  .section { margin-bottom: 2.5rem; }
  .section h2 { margin-bottom: 0.75rem; }
  .section p { margin-bottom: 0.75rem; color: var(--text-muted); line-height: 1.65; }

  /* Lookup */
  .lookup-box {
    background: linear-gradient(135deg, var(--accent-soft) 0%, var(--bg-soft) 100%);
    border: 1px solid var(--accent); border-radius: var(--radius-lg); padding: 1.5rem;
  }
  .lookup-box h2 { color: var(--accent-strong); margin-bottom: 1rem; }
  .lookup-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
  .lookup-controls label { display: flex; flex-direction: column; gap: 0.375rem; font-size: 0.875rem; font-weight: 600; color: var(--text-muted); }
  .lookup-controls select {
    padding: 0.625rem 0.75rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
    background: var(--bg-card); color: var(--text); font-size: max(16px, 1em); font-weight: 500;
  }
  .lookup-result {
    padding: 1rem 1.25rem; background: var(--bg-card); border-left: 3px solid var(--success, #059669);
    border-radius: var(--radius-sm); font-size: 1.0625rem; color: var(--text);
  }

  /* Table */
  .table-wrap { overflow-x: auto; margin: 1rem 0; border-radius: var(--radius-lg); border: 1px solid var(--border); }
  table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; font-feature-settings: 'tnum'; }
  thead { background: var(--bg-soft); }
  th {
    padding: 0.75rem 1rem; text-align: left; font-size: 0.8125rem; font-weight: 600;
    color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em;
    border-bottom: 1px solid var(--border);
  }
  td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); color: var(--text-muted); }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--bg-soft); }
  .concepto { font-weight: 500; color: var(--text); }
  .highlight { font-weight: 700; color: var(--success); }
  .table-note { font-size: 0.8125rem; color: var(--text-subtle); margin-top: 0.5rem; }

  /* CTA */
  .cta-box {
    text-align: center; padding: 2rem 1.5rem; margin: 2rem 0;
    background: linear-gradient(135deg, var(--accent-soft) 0%, var(--bg-soft) 100%);
    border: 1px solid var(--accent); border-radius: var(--radius-lg);
  }
  .cta-box h3 { color: var(--accent-strong); margin-bottom: 0.5rem; }
  .cta-box p { margin-bottom: 1rem; }
  .cta-links { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .cta-btn {
    display: inline-flex; align-items: center; gap: 0.375rem;
    padding: 0.75rem 1.5rem; background: var(--accent); color: #fff;
    border-radius: var(--radius-sm); font-weight: 600; font-size: 0.9375rem;
    transition: background 0.15s, transform 0.15s;
  }
  .cta-btn:hover { background: var(--accent-strong); transform: translateY(-1px); color: #fff; }
  .cta-btn.secondary { background: var(--bg-card); color: var(--accent); border: 1px solid var(--accent); }
  .cta-btn.secondary:hover { background: var(--accent-soft); color: var(--accent-strong); }

  /* Link grid */
  .link-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-top: 1rem; }

  /* FAQ */
  .faq-section { padding-top: 1rem; border-top: 1px solid var(--border); }
  .faq-list { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 1rem; }
  .faq-item {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden; transition: border-color 0.15s;
  }
  .faq-item[open] { border-color: var(--accent); }
  .faq-item summary {
    padding: 1rem 1.25rem; font-weight: 600; font-size: 0.9375rem;
    cursor: pointer; list-style: none; display: flex; align-items: center; gap: 0.75rem;
    color: var(--text);
  }
  .faq-item summary::before { content: '+'; font-size: 1.25rem; font-weight: 700; color: var(--accent); flex-shrink: 0; width: 1.25rem; text-align: center; }
  .faq-item[open] summary::before { content: '\2212'; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p { padding: 0 1.25rem 1rem; font-size: 0.9375rem; color: var(--text-muted); line-height: 1.65; }

  @media (max-width: 640px) {
    .lookup-controls { grid-template-columns: 1fr; }
    th, td { padding: 0.5rem 0.625rem; font-size: 0.8125rem; }
  }
</style>
