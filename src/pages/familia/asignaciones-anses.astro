---
/**
 * Hub de decisión — "AUH y asignaciones familiares: ¿cuánto cobro?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Los montos NO se escriben acá: viajan desde src/lib/hubs/auh.ts, que toma la
 * AUH y la retención del 20% de src/lib/data/argentina-2026.ts (la única fuente
 * del repo con fecha de verificación para este dato).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AsignacionesAnsesExperience from '../../components/generated/AsignacionesAnsesExperience.astro';
import { hub, CASE_MATH } from '../../lib/hubs/auh';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <AsignacionesAnsesExperience data={hub} />
  <Footer />
</Layout>

