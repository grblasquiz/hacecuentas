---
/**
 * Hub de decisión — "¿Cuánto es la cuota alimentaria?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: la respuesta de cada rama vive en hub.cases.
 * La página sólo aporta datos (src/lib/hubs/cuota-alimentaria.ts) y su compute().
 *
 * Tema sensible: el resultado es orientativo y el copy lo dice en el lede, en el
 * fineprint, en las advertencias de cada rama y en la FAQ. No hay tabla oficial
 * de porcentajes en la Argentina: los rangos son de jurisprudencia.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CuotaAlimentariaExperience from '../../components/generated/CuotaAlimentariaExperience.astro';
import {
  hub,
  RANGOS,
  AJUSTE_EDAD,
  CASE_MATH,
  TOPE_PRACTICO,
  PARTE_EXTRAORDINARIOS,
} from '../../lib/hubs/cuota-alimentaria';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CuotaAlimentariaExperience data={hub} />
  <Footer />
</Layout>

