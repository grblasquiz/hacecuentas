---
export const prerender = true;
import FeriadosLanding from '../components/FeriadosLanding.astro';
import { FERIADOS_LATAM_2027 } from '../lib/data/feriados-latam-2027';

const related = [
  { href: '/dias-entre-dos-fechas', label: 'Días entre dos fechas' },
  { href: '/calculadora-cuenta-regresiva-dias-faltan', label: 'Cuenta regresiva: cuántos días faltan' },
  { href: '/cl/calculadora-horas-extras-chile-recargo-50-ley-40-horas', label: 'Calculadora de horas extra en Chile' },

  // Cluster de feriados 2027 ↔ 2026: la versión vigente le pasa autoridad a la
  // del año siguiente y viceversa (mismo patrón que el cluster 2026).
  { href: '/feriados-chile-2026', label: 'Feriados Chile 2026' },
  { href: '/feriados-2027', label: 'Feriados 2027 en todos los países' },
];

const title = 'Feriados Chile 2027: calendario oficial con puentes';
const description = 'Feriados de Chile 2027: fechas oficiales confirmadas, día de la semana de cada una, fines de semana largos y puentes para planificar el año.';
---
<FeriadosLanding data={FERIADOS_LATAM_2027.chile} related={related} title={title} description={description} anio={2027} />
