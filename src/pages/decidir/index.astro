---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { DECISION_MANIFEST } from '../../lib/decisions/manifest';

const site = 'https://hacecuentas.com';
const title = 'Salas de decisión — decidí con números reales | Hacé Cuentas';
const description =
  'No son calculadoras sueltas: son experiencias completas para decisiones de plata importantes. Cargás tus datos una vez y combinamos varias fórmulas para darte una conclusión clara, escenarios y próximos pasos.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Salas de decisión',
      description,
      url: `${site}/decidir`,
      inLanguage: 'es-AR',
      isPartOf: { '@id': `${site}/#website` },
    },
    {
      '@type': 'ItemList',
      itemListElement: DECISION_MANIFEST.map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${site}/decidir/${r.slug}`,
        name: r.h1,
      })),
    },
  ],
};
---

<Layout title={title} description={description} schema={schema} audience="AR">
  <Header slot="header" />

  <main class="dh">
    <header class="dh-head">
      <span class="dh-eyebrow">🧭 Salas de decisión</span>
      <h1>Decisiones de plata, con números reales</h1>
      <p class="dh-lede">
        No son calculadoras sueltas. Cada sala combina varias fórmulas para responder una
        decisión completa: cargás tus datos una vez y te damos una conclusión clara, tres
        escenarios y los próximos pasos. Sin vueltas, sin registro.
      </p>
    </header>

    <ul class="dh-grid">
      {DECISION_MANIFEST.map((r) => (
        <li>
          <a href={`/decidir/${r.slug}`} class="dh-card">
            <span class="dh-icon" aria-hidden="true">{r.icon}</span>
            <span class="dh-card-title">{r.h1}</span>
            <span class="dh-card-desc">{r.intro}</span>
            <span class="dh-card-cta">Abrir la sala →</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="dh-foot">
      ¿Te falta una decisión? <a href="/sugerir">Sugerí una sala</a> y la sumamos.
    </p>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .dh {
    max-width: 880px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .dh-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dh-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dh-head h1 {
    margin: 0;
    font-size: clamp(1.625rem, 5vw, 2.375rem);
    line-height: 1.15;
    color: var(--text);
  }
  .dh-lede {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 60ch;
  }
  .dh-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .dh-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 0.75rem);
    background: var(--bg);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.1s, box-shadow 0.15s;
  }
  .dh-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.08));
  }
  .dh-icon {
    font-size: 1.75rem;
  }
  .dh-card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
  }
  .dh-card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
  }
  .dh-card-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
  }
  .dh-foot {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .dh-foot a {
    color: var(--accent-strong, #0369a1);
  }
</style>
