---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { DECISION_MANIFEST } from '../../lib/decisions/manifest';
import { DECISION_HUBS, INDEX_EXTRA_GROUPS } from '../../lib/decisions/hubs';
import { DECISION_COUNTRY_LIST } from '../../lib/decisions/locales';
import { buildHreflangCluster } from '../../lib/hreflang';
import { PRIORITY_DECISIONS } from '../../lib/decisions/priority';

// Cluster hreflang de los índices de salas. Las verticales de país (/co, /mx,
// /cl, /pe) se absorbieron en los hubs de decisión de cada mercado y ahora son
// 301, así que salen del cluster: un alternate a un redirect es señal rota.
const hreflang = buildHreflangCluster({
  es: 'decidir',
});

const site = 'https://hacecuentas.com';
const title = 'Salas de decisión — decidí con números reales | Hacé Cuentas';
const description =
  'No son calculadoras sueltas: son experiencias completas para decisiones de plata importantes. Cargás tus datos una vez y combinamos varias fórmulas para darte una conclusión clara, escenarios y próximos pasos.';

const bySlug = new Map(DECISION_MANIFEST.map((r) => [r.slug, r]));
const priorityRooms = PRIORITY_DECISIONS
  .map((item) => bySlug.get(item.slug))
  .filter((room): room is NonNullable<typeof room> => Boolean(room));
const prioritySlugSet = new Set(PRIORITY_DECISIONS.map((item) => item.slug));

// Índice agrupado: cada sala aparece UNA vez, bajo su hub primario (el primero
// de DECISION_HUBS que la contiene; los hubs pueden solaparse entre sí, el
// índice no). Después, los grupos sin hub propio (auto/familia/ahorro).
const seen = new Set<string>(prioritySlugSet);
const hubSections = DECISION_HUBS.map((hub) => {
  const rooms = hub.roomSlugs
    .filter((s) => !seen.has(s) && bySlug.has(s))
    .map((s) => {
      seen.add(s);
      return bySlug.get(s)!;
    });
  return { hub, rooms };
});
const extraSections = INDEX_EXTRA_GROUPS.map((g) => ({
  ...g,
  rooms: g.roomSlugs
    .filter((s) => !seen.has(s) && bySlug.has(s))
    .map((s) => {
      seen.add(s);
      return bySlug.get(s)!;
    }),
}));
// Red de seguridad: salas nuevas que todavía no fueron asignadas a ningún grupo.
const unsorted = DECISION_MANIFEST.filter((r) => !seen.has(r.slug));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Salas de decisión',
      description,
      url: `${site}/decidir`,
      inLanguage: 'es-AR',
      isPartOf: { '@id': `${site}/#website` },
    },
    {
      '@type': 'ItemList',
      itemListElement: [...priorityRooms, ...DECISION_MANIFEST.filter((r) => !prioritySlugSet.has(r.slug))].map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${site}/decidir/${r.slug}`,
        name: r.h1,
      })),
    },
  ],
};
---

<Layout title={title} description={description} schema={schema} audience="AR" hreflang={hreflang}>
  <Header slot="header" />

  <main class="dh">
    <header class="dh-head">
      <span class="dh-eyebrow">🧭 Salas de decisión</span>
      <h1>Decisiones de plata, con números reales</h1>
      <p class="dh-lede">
        No son calculadoras sueltas. Cada sala combina varias fórmulas para responder una
        decisión completa: cargás tus datos una vez y te damos una conclusión clara, tres
        escenarios y los próximos pasos. Sin vueltas, sin registro.
      </p>
      <nav class="dh-hub-nav" aria-label="Hubs de decisión">
        {DECISION_HUBS.map((h) => (
          <a href={`/decidir/${h.slug}`}>{h.icon} {h.shortLabel}</a>
        ))}
      </nav>
    </header>

    <section class="dh-group dh-priority" aria-labelledby="dh-priority-title">
      <div class="dh-group-head">
        <div>
          <span class="dh-priority-label">Empezá por acá</span>
          <h2 id="dh-priority-title">Las 10 decisiones esenciales</h2>
        </div>
      </div>
      <ul class="dh-grid">
        {priorityRooms.map((r) => (
          <li>
            <a href={`/decidir/${r.slug}`} class="dh-card" data-priority-room data-room-slug={r.slug}>
              <span class="dh-icon" aria-hidden="true">{r.icon}</span>
              <span class="dh-card-title">{r.h1}</span>
              <span class="dh-card-desc">{r.description}</span>
              <span class="dh-card-cta">Abrir la sala →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {hubSections.map(({ hub, rooms }) => (
      <section class="dh-group">
        <div class="dh-group-head">
          <h2>
            <a href={`/decidir/${hub.slug}`}>{hub.icon} {hub.h1}</a>
          </h2>
          <a class="dh-group-more" href={`/decidir/${hub.slug}`}>Ver el hub →</a>
        </div>
        <ul class="dh-grid">
          {rooms.map((r) => (
            <li>
              <a href={`/decidir/${r.slug}`} class="dh-card">
                <span class="dh-icon" aria-hidden="true">{r.icon}</span>
                <span class="dh-card-title">{r.h1}</span>
                <span class="dh-card-desc">{r.description}</span>
                <span class="dh-card-cta">Abrir la sala →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {extraSections.map((g) => (
      <section class="dh-group">
        <div class="dh-group-head">
          <h2>{g.icon} {g.title}</h2>
        </div>
        <ul class="dh-grid">
          {g.rooms.map((r) => (
            <li>
              <a href={`/decidir/${r.slug}`} class="dh-card">
                <span class="dh-icon" aria-hidden="true">{r.icon}</span>
                <span class="dh-card-title">{r.h1}</span>
                <span class="dh-card-desc">{r.description}</span>
                <span class="dh-card-cta">Abrir la sala →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {unsorted.length > 0 && (
      <section class="dh-group">
        <div class="dh-group-head">
          <h2>🧩 Más decisiones</h2>
        </div>
        <ul class="dh-grid">
          {unsorted.map((r) => (
            <li>
              <a href={`/decidir/${r.slug}`} class="dh-card">
                <span class="dh-icon" aria-hidden="true">{r.icon}</span>
                <span class="dh-card-title">{r.h1}</span>
                <span class="dh-card-desc">{r.description}</span>
                <span class="dh-card-cta">Abrir la sala →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="dh-group">
      <div class="dh-group-head">
        <h2>🌎 Salas de decisión por país</h2>
      </div>
      <p class="dh-countries-lede">
        Las decisiones son universales; las tasas y los impuestos, no. Estas salas también existen
        con números locales de:
      </p>
      <nav class="dh-hub-nav" aria-label="Salas de decisión por país">
        {DECISION_COUNTRY_LIST.map((c) => (
          <a href={`/${c.cc}/decidir`}>{c.flag} {c.name}</a>
        ))}
      </nav>
    </section>

    <p class="dh-foot">
      ¿Te falta una decisión? <a href="/sugerir">Sugerí una sala</a> y la sumamos.
    </p>
  </main>

  <Footer slot="footer" />
</Layout>

<script>
  document.querySelectorAll('[data-priority-room]').forEach((node) => {
    const card = node as HTMLElement;
    const target_slug = card.dataset.roomSlug || '';
    card.addEventListener('click', () => {
      if (typeof (window as any).hcTrack === 'function') (window as any).hcTrack('hc_decision_room_clicked', { source_page: 'decision_hub', target_slug });
    });
  });
</script>

<style>
  .dh {
    max-width: 880px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .dh-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dh-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dh-head h1 {
    margin: 0;
    font-size: clamp(1.625rem, 5vw, 2.375rem);
    line-height: 1.15;
    color: var(--text);
  }
  .dh-lede {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 60ch;
  }
  .dh-hub-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .dh-hub-nav a {
    display: inline-block;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--accent-strong, #0369a1);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .dh-hub-nav a:hover {
    border-color: var(--accent);
    background: var(--accent-soft, #e0f2fe);
  }
  .dh-group {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .dh-group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .dh-group-head h2 {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.25;
    color: var(--text);
  }
  .dh-group-head h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .dh-group-head h2 a:hover {
    color: var(--accent-strong, #0369a1);
    text-decoration: underline;
  }
  .dh-group-more {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
    text-decoration: none;
  }
  .dh-group-more:hover {
    text-decoration: underline;
  }
  .dh-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .dh-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 0.75rem);
    background: var(--bg);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.1s, box-shadow 0.15s;
  }
  .dh-priority { padding: 1rem; border: 1px solid #cfd8f3; border-radius: 18px; background: #f7f8ff; }
  .dh-priority-label { display: block; margin-bottom: .25rem; color: #4050cf; font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .dh-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.08));
  }
  .dh-icon {
    font-size: 1.75rem;
  }
  .dh-card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
  }
  .dh-card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
  }
  .dh-card-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
  }
  .dh-countries-lede {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
    max-width: 60ch;
  }
  .dh-foot {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .dh-foot a {
    color: var(--accent-strong, #0369a1);
  }
</style>
