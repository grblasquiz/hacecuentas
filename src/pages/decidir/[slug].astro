---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionRoom from '../../components/DecisionRoom.astro';
import { freeOfferSchema } from '../../lib/offer-schema';
import { md } from '../../lib/markdown';
import { DECISION_LIST, getRoom } from '../../lib/decisions/index';
import { primaryHubOf } from '../../lib/decisions/hubs';
import { relatedRooms } from '../../lib/decisions/related';
import { equivalentsByEsSlug } from '../../lib/decisions/locales';
import { buildHreflangCluster } from '../../lib/hreflang';

export async function getStaticPaths() {
  return DECISION_LIST.map((room) => ({
    params: { slug: room.slug },
    props: { slug: room.slug },
  }));
}

const { slug } = Astro.props;
const room = getRoom(slug)!;

const site = 'https://hacecuentas.com';
const url = `${site}/decidir/${room.slug}`;
const dateModified = new Date(room.lastReviewed + 'T00:00:00Z').toISOString();
const datePublished = dateModified;
const lastReviewedLabel = new Date(dateModified).toLocaleDateString('es-AR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC', // sin esto, medianoche UTC renderiza el día anterior en ART (UTC-3)
});

// Baseline SSR: el bot ve un resultado de ejemplo sin ejecutar JS.
const initialResult = room.compute(room.example);

// hreflang: si la sala tiene versiones país (co/mx/cl/pe), declarar el
// cluster simétrico completo (misma lista en todos los miembros). Sin
// versiones país → undefined y el Layout cae en su fallback es-AR self.
const eq = equivalentsByEsSlug(room.slug);
const hreflang = eq
  ? buildHreflangCluster({
      es: `decidir/${eq.es}`,
      co: eq.co ? `decidir/${eq.co}` : undefined,
      mx: eq.mx ? `decidir/${eq.mx}` : undefined,
      cl: eq.cl ? `decidir/${eq.cl}` : undefined,
      pe: eq.pe ? `decidir/${eq.pe}` : undefined,
    })
  : undefined;

// Hub primario de la sala (breadcrumb + salas hermanas). Puede ser null si la
// sala no pertenece a ningún hub (auto/familia/ahorro viven solo en /decidir).
const hub = primaryHubOf(room.slug);
const siblings = hub
  ? hub.roomSlugs
      .filter((s) => s !== room.slug)
      .map((s) => DECISION_LIST.find((r) => r.slug === s))
      .filter(Boolean)
      .slice(0, 6)
  : [];

// Decisiones relacionadas (cross-linking temático). Complementa a los siblings
// del hub: excluye los ya mostrados para no repetir enlaces. Para las salas SIN
// hub, este bloque es su ÚNICA fuente de links sala→sala.
const related = relatedRooms(
  room.slug,
  4,
  siblings.map((s) => s!.slug),
);

// HowTo steps desde el howItWorks numerado ("1. **Título.** texto").
const howToSteps = [...room.howItWorks.matchAll(/^\d+\.\s+\*\*(.+?)\*\*\s*(.*)$/gm)].map((m) => ({
  name: m[1].replace(/\.$/, ''),
  text: (m[2] || m[1]).replace(/\*\*/g, '').trim(),
}));

const authorRef = { '@id': `${site}/autores/martin-rodriguez#person` };

const schemaGraph: any[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Decisiones', item: `${site}/decidir` },
      ...(hub
        ? [
            { '@type': 'ListItem', position: 3, name: hub.h1, item: `${site}/decidir/${hub.slug}` },
            { '@type': 'ListItem', position: 4, name: room.h1 },
          ]
        : [{ '@type': 'ListItem', position: 3, name: room.h1 }]),
    ],
  },
  {
    '@type': ['WebApplication', 'SoftwareApplication'],
    name: room.h1,
    description: room.description,
    url,
    mainEntityOfPage: url,
    applicationCategory: 'FinanceApplication',
    applicationSubCategory: 'Decision tool',
    operatingSystem: 'Web',
    browserRequirements: 'Requires JavaScript. Requires HTML5.',
    inLanguage: 'es-AR',
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    datePublished,
    dateModified,
    offers: freeOfferSchema({ priceCurrency: 'ARS', validFrom: datePublished }),
    publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: site },
    author: { '@type': 'Person', ...authorRef, name: 'Martín Rodríguez', url: `${site}/autores/martin-rodriguez` },
    // Citation con fuentes externas (mismo patrón que las calc pages): los
    // LLMs/Copilot ponderan páginas que citan fuentes verificables.
    ...(room.sources?.length
      ? {
          citation: room.sources.map((s) => ({
            '@type': 'CreativeWork',
            name: s.name,
            ...(s.url ? { url: s.url } : {}),
          })),
        }
      : {}),
    // Speakable: intro (respuesta a la pregunta del h1) + número decisivo.
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.dr-answer-text', '.dr-intro', '.dr-decisive-value', '.dr-decisive-label'],
    },
  },
];

if (howToSteps.length >= 3) {
  schemaGraph.push({
    '@type': 'HowTo',
    name: `Cómo decidir: ${room.h1}`,
    description: room.description,
    inLanguage: 'es-AR',
    totalTime: 'PT2M',
    step: howToSteps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
      url: `${url}#paso-${i + 1}`,
    })),
  });
}

if (room.faq.length > 0) {
  schemaGraph.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    url,
    inLanguage: 'es-AR',
    datePublished,
    dateModified,
    author: authorRef,
    publisher: { '@id': `${site}/#organization` },
    mainEntity: room.faq.map((f, i) => ({
      '@type': 'Question',
      '@id': `${url}#faq-${i + 1}`,
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a, inLanguage: 'es-AR' },
    })),
  });
}

const schema = { '@context': 'https://schema.org', '@graph': schemaGraph };
const howItWorksHtml = md(room.howItWorks);
---

<Layout
  title={room.title}
  description={room.description}
  schema={schema}
  audience="AR"
  hreflang={hreflang}
  ogType="article"
  articleSection="Decisiones"
  articleModifiedTime={dateModified}
  domain="money"
  pageType="room"
>
  <Header slot="header" />

  <main class="dr-page">
    <!-- HERO navy (mockup 2026-07-12) -->
    <header class="dr-hero">
      <div class="wrap">
        <nav class="dr-breadcrumb" aria-label="Migas de pan">
          <a href="/">Inicio</a> <span aria-hidden="true">›</span>
          <a href="/decidir">Decisiones</a> <span aria-hidden="true">›</span>
          {hub && (
            <>
              <a href={`/decidir/${hub.slug}`}>{hub.shortLabel}</a> <span aria-hidden="true">›</span>
            </>
          )}
          <span aria-current="page">{room.h1}</span>
        </nav>
        <div class="dr-hero-grid">
          <div class="dr-hero-copy">
            <span class="dr-eyebrow">🧭 Sala de decisión{hub ? ` · ${hub.shortLabel}` : ''}</span>
            <h1>{room.icon} {room.h1}</h1>
            <p class="dr-hero-lead">{room.description}</p>
            <div class="dr-hero-trust">
              <span><b>✓</b> Compara costos totales</span>
              <span><b>✓</b> Datos y supuestos vigentes 2026</span>
              <span><b>✓</b> Resultado en 2 minutos</span>
            </div>
          </div>
          {room.answer && (
            <aside class="dr-idea" aria-label="La idea clave">
              <span class="dr-idea-label">La idea clave</span>
              <div class="dr-idea-text" set:html={md(room.answer).replace(/^<p>|<\/p>\s*$/g, '')} />
            </aside>
          )}
        </div>
        <p class="dr-updated">Revisado: {lastReviewedLabel}</p>
      </div>
    </header>

    <div class="dr-body">
    <DecisionRoom room={room} initialResult={initialResult} />

    <section class="dr-section" id="como-funciona">
      <h2>Cómo lo calculamos</h2>
      <div class="dr-prose" set:html={howItWorksHtml} />
    </section>

    <section class="dr-section dr-component-calcs">
      <h2>Las calculadoras que usa esta sala</h2>
      <p>Esta decisión combina estas herramientas. Si querés ver cada cálculo por separado:</p>
      <ul class="dr-calc-links">
        {room.componentCalcs.map((c) => (
          <li>
            <a href={`/${c.slug}`}>{c.label}</a>
          </li>
        ))}
      </ul>
    </section>

    {hub && siblings.length > 0 && (
      <section class="dr-section dr-siblings">
        <h2>Más decisiones {hub.slug === 'laborales' ? 'laborales' : `de ${hub.shortLabel.toLowerCase()}`}</h2>
        <ul class="dr-calc-links">
          {siblings.map((s) => (
            <li>
              <a href={`/decidir/${s!.slug}`}>{s!.icon} {s!.h1}</a>
            </li>
          ))}
          <li>
            <a href={`/decidir/${hub.slug}`}><strong>{hub.icon} Ver todas →</strong></a>
          </li>
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="dr-section dr-related">
        <h2>Decisiones relacionadas</h2>
        <p>Si estás mirando esta decisión, estas otras salas suelen ir de la mano:</p>
        <ul class="dr-related-grid">
          {related.map((r) => (
            <li>
              <a href={`/decidir/${r.slug}`} class="dr-related-card">
                <span class="dr-related-icon" aria-hidden="true">{r.icon}</span>
                <span class="dr-related-body">
                  <span class="dr-related-title">{r.h1}</span>
                  <span class="dr-related-desc">{r.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {eq && (
      <section class="dr-section dr-countries">
        <h2>Esta decisión en otros países</h2>
        <p>La lógica es la misma, pero las tasas, los impuestos y las reglas cambian. Tenemos versiones con números locales:</p>
        <ul class="dr-calc-links">
          {eq.co && <li><a href={`/co/decidir/${eq.co}`}>🇨🇴 Colombia</a></li>}
          {eq.mx && <li><a href={`/mx/decidir/${eq.mx}`}>🇲🇽 México</a></li>}
          {eq.cl && <li><a href={`/cl/decidir/${eq.cl}`}>🇨🇱 Chile</a></li>}
          {eq.pe && <li><a href={`/pe/decidir/${eq.pe}`}>🇵🇪 Perú</a></li>}
        </ul>
      </section>
    )}

    <section class="dr-section" id="faq">
      <h2>Preguntas frecuentes</h2>
      <div class="dr-faq">
        {room.faq.map((f, i) => (
          <details id={`faq-${i + 1}`}>
            <summary>{f.q}</summary>
            <div>
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    {room.sources && room.sources.length > 0 && (
      <section class="dr-section dr-sources" id="fuentes">
        <h2>Fuentes</h2>
        <ul>
          {room.sources.map((s) => (
            <li>{s.url ? <a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a> : s.name}</li>
          ))}
        </ul>
      </section>
    )}
    </div><!-- /.dr-body -->
  </main>

  <Footer slot="footer" />
</Layout>

<style is:global>
  /* Sala full-bleed (mockup): el hero navy va de borde a borde. */
  body[data-page-type='room'] > main#main {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip;
  }
</style>

<style>
  .dr-page { display: block; }
  .dr-page .wrap { width: min(1200px, calc(100% - 2.5rem)); margin: 0 auto; }
  @media (min-width: 1600px) { .dr-page .wrap { width: min(1360px, calc(100% - 6rem)); } }

  /* HERO navy */
  .dr-hero {
    background:
      radial-gradient(circle at 84% 12%, rgba(126, 101, 244, 0.28), transparent 34%),
      linear-gradient(160deg, #1a1e3a 0%, #14182d 70%);
    color: #fff;
    padding: 40px 0 38px;
  }
  .dr-hero .dr-breadcrumb { font-size: 0.8125rem; color: #9aa0bd; margin-bottom: 22px; }
  .dr-hero .dr-breadcrumb a { color: #9aa0bd; text-decoration: none; }
  .dr-hero .dr-breadcrumb a:hover { color: #fff; }
  .dr-hero-grid { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 40px; align-items: center; }
  .dr-hero-copy { min-width: 0; }
  .dr-eyebrow {
    display: inline-block; font-size: 0.75rem; font-weight: 800; color: #a99bff;
    text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.6rem;
  }
  .dr-hero h1 {
    margin: 0 0 0.7rem; font-size: clamp(1.75rem, 4.4vw, 2.6rem); line-height: 1.08;
    color: #fff; font-weight: 850; letter-spacing: -0.03em;
  }
  .dr-hero-lead { margin: 0 0 1.1rem; font-size: 1.0625rem; line-height: 1.55; color: #c7cadd; max-width: 60ch; }
  .dr-hero-trust { display: flex; flex-wrap: wrap; gap: 16px; font-size: 0.8125rem; font-weight: 600; color: #aeb3c8; }
  .dr-hero-trust span { display: inline-flex; align-items: center; gap: 6px; }
  .dr-hero-trust b { color: #39d98a; }
  .dr-idea {
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px; padding: 1.125rem 1.25rem;
  }
  .dr-idea-label { display: block; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: #a99bff; margin-bottom: 0.5rem; }
  .dr-idea-text { font-size: 0.95rem; line-height: 1.5; color: #e6e8f4; }
  .dr-idea-text :global(strong) { color: #fff; }
  .dr-updated { margin: 20px 0 0; font-size: 0.78rem; color: #7f86a3; }

  /* Cuerpo (herramienta + secciones) */
  .dr-body {
    width: min(1200px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 2.25rem 0 3rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 1600px) { .dr-body { width: min(1360px, calc(100% - 6rem)); } }
  .dr-body > .dr-section { max-width: 860px; }
  @media (max-width: 900px) {
    .dr-hero-grid { grid-template-columns: 1fr; gap: 24px; }
  }
  .dr-section h2 {
    font-size: 1.375rem;
    margin: 0 0 0.75rem;
    color: var(--text);
  }
  .dr-prose {
    line-height: 1.65;
    color: var(--text);
  }
  .dr-prose :global(ol),
  .dr-prose :global(ul) {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dr-calc-links {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .dr-calc-links a {
    display: inline-block;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--bg);
    color: var(--accent-strong, #0369a1);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .dr-calc-links a:hover {
    border-color: var(--accent);
    background: var(--accent-soft, #e0f2fe);
  }
  .dr-faq details {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
  }
  .dr-faq summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }
  .dr-faq details > div {
    padding-top: 0.5rem;
  }
  .dr-faq p {
    margin: 0;
    line-height: 1.6;
    color: var(--text);
  }
  .dr-sources ul {
    padding-left: 1.1rem;
    line-height: 1.6;
  }
  .dr-sources a {
    color: var(--accent-strong, #0369a1);
  }

  /* "La respuesta corta" — callout snippet-friendly arriba de la herramienta. */
  .dr-answer {
    border-left: 3px solid var(--accent, #0284c7);
    background: var(--accent-soft, #e0f2fe);
    border-radius: var(--radius-sm, 0.5rem);
    padding: 0.875rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .dr-answer-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-strong, #0369a1);
  }
  .dr-answer-text {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text);
  }

  /* Decisiones relacionadas — cross-linking sala→sala. */
  .dr-related-grid {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }
  .dr-related-card {
    display: flex;
    gap: 0.625rem;
    height: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 0.75rem);
    background: var(--bg);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.1s;
  }
  .dr-related-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .dr-related-icon {
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .dr-related-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .dr-related-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
  }
  .dr-related-desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
