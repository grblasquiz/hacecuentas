---
// AMP Web Story (Google Web Stories) — formato vertical tipo "stories" que
// Google muestra en carrusel propio en Discover/Imágenes/Search. Una historia
// por JSON en src/content/historias/. La validez AMP final la deja
// scripts/amp-clean-historias.mjs (post-build) que borra el shim JS que Astro
// inyecta en toda página y normaliza standalone="true" → standalone.
export const prerender = true;

export async function getStaticPaths() {
  const mods = import.meta.glob('../../content/historias/*.json', { eager: true });
  return Object.values(mods).map((m) => {
    const s = (m as any).default || m;
    return { params: { slug: s.slug }, props: { story: s } };
  });
}

const { story } = Astro.props as { story: any };

const SITE = 'https://hacecuentas.com';
const canonical = `${SITE}/historias/${story.slug}`;
const portraitUrl = `${SITE}${story.portrait}`;
const articleUrl = `${SITE}${story.article}`;
const logoUrl = `${SITE}/icon-192.png`;
const accent = story.accent || '#0f172a';
const desc = story.cover?.title || story.title;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: story.title,
  description: desc,
  image: [portraitUrl],
  inLanguage: 'es-AR',
  isPartOf: { '@type': 'WebSite', name: 'Hacé Cuentas', url: SITE },
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    logo: { '@type': 'ImageObject', url: logoUrl, width: 192, height: 192 },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};

// amp-custom: única hoja de estilo permitida (sin !important, sin position:fixed).
// El accent se interpola por historia. Cada página usa template="fill" con un
// wrapper flex full-height para alinear el contenido de forma predecible.
const css = `
*{box-sizing:border-box;margin:0;padding:0}
amp-story{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#fff}
.fill{width:100%;height:100%;display:flex;flex-direction:column;padding:2.4em 1.6em}
.cover{justify-content:flex-end;background:linear-gradient(to top,rgba(0,0,0,.88) 0%,rgba(0,0,0,.45) 42%,rgba(0,0,0,.08) 100%)}
.kicker{display:inline-block;align-self:flex-start;font-size:.72em;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:rgba(255,255,255,.18);padding:.34em .7em;border-radius:999px;margin-bottom:.7em}
.cover-title{font-size:2.05em;font-weight:800;line-height:1.12;text-shadow:0 1px 12px rgba(0,0,0,.4)}
.brand{margin-top:.9em;font-size:.82em;font-weight:600;opacity:.85}
.page{justify-content:center;background:${accent}}
.page-num{font-size:.78em;font-weight:700;letter-spacing:.06em;opacity:.6;margin-bottom:.9em}
.page-heading{font-size:1.7em;font-weight:800;line-height:1.18;margin-bottom:.55em}
.page-text{font-size:1.12em;line-height:1.5;opacity:.92;font-weight:400}
.cta-page{justify-content:center;background:${accent}}
.cta-lead{font-size:1.5em;font-weight:800;line-height:1.22}
.cta-btn{display:inline-block;background:#fff;color:${accent};font-weight:700;font-size:1em;padding:.85em 1.5em;border-radius:999px;text-decoration:none;box-shadow:0 4px 18px rgba(0,0,0,.28)}
`;
---
<!DOCTYPE html>
<html amp lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <title>{story.title} · Hacé Cuentas</title>
    <link rel="canonical" href={canonical} />
    <meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1" />
    <meta name="description" content={desc} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <script async src="https://cdn.ampproject.org/v0.js" is:inline></script>
    <script async custom-element="amp-story" src="https://cdn.ampproject.org/v0/amp-story-1.0.js" is:inline></script>
    <style amp-boilerplate is:inline>body{-webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-moz-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-ms-animation:-amp-start 8s steps(1,end) 0s 1 normal both;animation:-amp-start 8s steps(1,end) 0s 1 normal both}@-webkit-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-moz-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-ms-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-o-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}</style><noscript><style amp-boilerplate is:inline>body{-webkit-animation:none;-moz-animation:none;-ms-animation:none;animation:none}</style></noscript>
    <style amp-custom is:inline set:html={css}></style>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>
  </head>
  <body>
    <amp-story
      standalone="true"
      title={story.title}
      publisher="Hacé Cuentas"
      publisher-logo-src={logoUrl}
      poster-portrait-src={portraitUrl}
    >
      <amp-story-page id="cover">
        <amp-story-grid-layer template="fill">
          <amp-img src={portraitUrl} layout="fill" alt={story.title}></amp-img>
        </amp-story-grid-layer>
        <amp-story-grid-layer template="fill">
          <div class="fill cover">
            <span class="kicker">{story.cover.kicker}</span>
            <h1 class="cover-title">{story.cover.title}</h1>
            <p class="brand">Hacé Cuentas</p>
          </div>
        </amp-story-grid-layer>
      </amp-story-page>

      {story.pages.map((p: any, i: number) => (
        <amp-story-page id={`p${i + 1}`}>
          <amp-story-grid-layer template="fill">
            <div class="fill page">
              <span class="page-num">{i + 1} / {story.pages.length}</span>
              <h2 class="page-heading">{p.heading}</h2>
              <p class="page-text">{p.text}</p>
            </div>
          </amp-story-grid-layer>
        </amp-story-page>
      ))}

      <amp-story-page id="cta">
        <amp-story-grid-layer template="fill">
          <div class="fill cta-page">
            <p class="cta-lead">{story.cta.text}</p>
          </div>
        </amp-story-grid-layer>
        <amp-story-cta-layer>
          <a class="cta-btn" href={articleUrl}>{story.cta.label} →</a>
        </amp-story-cta-layer>
      </amp-story-page>
    </amp-story>
  </body>
</html>
