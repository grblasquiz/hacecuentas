---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const site = 'https://hacecuentas.com';
const path = '/historias';

// Todas las Web Stories (mismo origen que historias/[slug].astro)
const mods = import.meta.glob<any>('../../content/historias/*.json', { eager: true });
const stories = Object.values(mods)
  .map((m: any) => m.default || m)
  .filter((s: any) => s && s.slug);

const title = 'Historias — Hacé Cuentas en formato visual';
const description = 'Web Stories de Hacé Cuentas: inflación, sueldos, aguinaldo, monotributo y más, explicados en formato visual y rápido. Los números que te importan, en historias.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Historias de Hacé Cuentas',
      description,
      url: `${site}${path}`,
      inLanguage: 'es-AR',
      isPartOf: { '@id': `${site}/#website` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Historias', item: `${site}${path}` },
      ],
    },
    {
      '@type': 'ItemList',
      itemListElement: stories.map((s: any, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${site}/historias/${s.slug}`,
        name: s.title,
      })),
    },
  ],
};
---

<Layout title={title} description={description} schema={schema} audience="AR" canonical={path}>
  <Header slot="header" />

  <main class="hi">
    <header class="hi-head">
      <h1>Historias</h1>
      <p>Los números que te importan, en formato visual y rápido. Tocá una historia y deslizá.</p>
    </header>

    <div class="hi-grid">
      {stories.map((s: any) => (
        <a class="hi-card" href={`/historias/${s.slug}`} style={`--acc:${s.accent || '#0f172a'}`}>
          <img class="hi-cover" src={s.portrait} alt={s.title} width="270" height="480" loading="lazy" decoding="async" />
          <span class="hi-overlay">
            {s.cover?.kicker && <span class="hi-kicker">{s.cover.kicker}</span>}
            <span class="hi-title">{s.title}</span>
          </span>
        </a>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .hi { max-width: 900px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .hi-head { text-align: center; margin-bottom: 1.5rem; }
  .hi-head h1 { margin: 0 0 0.4rem; font-size: clamp(1.5rem, 6vw, 2rem); color: var(--text); }
  .hi-head p { margin: 0 auto; font-size: 0.95rem; color: var(--text-muted); max-width: 52ch; line-height: 1.5; }

  .hi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.9rem; }
  .hi-card { position: relative; display: block; aspect-ratio: 9 / 16; border-radius: var(--radius-lg, 1rem); overflow: hidden; text-decoration: none; box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,.12)); border: 1px solid var(--border); background: var(--acc); }
  .hi-cover { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hi-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 0.3rem; padding: 0.8rem; background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.35) 45%, rgba(0,0,0,0) 75%); }
  .hi-kicker { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; opacity: 0.9; }
  .hi-title { font-size: 0.9rem; font-weight: 700; color: #fff; line-height: 1.2; }
  .hi-card:hover .hi-title { text-decoration: underline; }
</style>
