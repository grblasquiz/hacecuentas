const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbCrumbs.map((c, i) => {
    const li: any = { '@type': 'ListItem', position: i + 1, name: c.name };
    if (c.item) li.item = c.item;
    if (c.description) li.description = c.description;
    return li;
  }),
};

// Mapeo categoría → schema.org applicationCategory: fuente única en
// src/lib/calc-schema.ts (la compartimos con las rutas por locale).
const applicationCategory = applicationCategoryFor(calc.category);

// Entidades Wikidata detectadas en h1/title/keywords. Se calcula una vez y sólo
// se inyecta si hay match: `mentions: []` es ruido en cada página sin entidades.
const _mentions = findMentions(
  `${calc.h1 || ''} ${calc.title || ''} ${(calc.seoKeywords || []).join(' ')}`
);

// SoftwareApplication + WebApplication — Google las usa para web apps / calculadoras
const schemaApp = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'WebApplication'],
  name: calc.h1,
  // description con fallback answerSnippet > keyTakeaway > schemaDescription para
  // que Bing/Copilot levanten el texto curado al rich snippet.
  description: snippetDescription,
  url: `https://hacecuentas.com/${calc.slug}`,
  mainEntityOfPage: `https://hacecuentas.com/${calc.slug}`,
  applicationCategory,
  applicationSubCategory: 'Calculator',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  inLanguage: schemaLang,
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  datePublished,
  dateModified,
  offers: freeOfferSchema({ priceCurrency: countryBadge.currency, validFrom: datePublished || dateModified }),
  // image + screenshot: Bing/Copilot usan estas props para rich snippets visuales
  // en SoftwareApplication. Sin ellas, los resultados van sin thumbnail.
  image: {
    '@type': 'ImageObject',
    url: `https://hacecuentas.com${ogImage}`,
    width: 1200,
    height: 630,
  },
  screenshot: `https://hacecuentas.com${ogImage}`,
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
  },
  // Speakable: permite a voice assistants (Alexa, Cortana, Google Assistant) y
  // AI bots (ChatGPT, Copilot, Claude, Perplexity, Gemini) identificar las
  // partes clave de la calc para responder a queries de voz/AI.
  // Bing/Copilot le prestan especial atención a Speakable.
  // Selectores ampliados 2026-05-11 para incluir FAQ y primer párrafo de explicación.
  speakable: {
    '@type': 'SpeakableSpecification',
    // Lista canonica verificada contra CalcLayoutV2 (src/lib/calc-schema.ts).
    // La tanda anterior (.answer-snippet, .aeo-quick-answer, .calc-intro,
    // .calc-key-takeaway, .use-cases li) eran clases de paginas sueltas, no del
    // layout de calcs: no matcheaban nada.
    cssSelector: SPEAKABLE_SELECTORS,
  },
  // Citation: fuentes verificables externas (mismo array que Article schema cuando aplica).
  // Bing/Copilot priorizan citation para citar en answer cards y AI Overviews.
  // Importante incluirlo en SoftwareApplication (que se renderiza siempre) y no
  // solo en Article (que solo aplica a YMYL o explanation > 1500).
  ...(citationLd.length ? { citation: citationLd } : {}),
  // Mentions: entidades Wikidata reconocidas en h1/seoKeywords. Le da a LLMs
  // (ChatGPT/Claude/Perplexity/Gemini) entity disambiguation gratis vía
  // knowledge graph de Wikidata. Ej: si la calc menciona "ANSES" → linkea a
  // https://www.wikidata.org/wiki/Q830348.
  ...(_mentions.length ? { mentions: _mentions } : {}),
  // About: primary topic de la página. Más fuerte que `mentions` para entity
  // resolution en Google/Bing/LLMs. Solo si matcheamos en el H1 (conservador).
  // Si no hay match en H1, no inyectamos `about` (mejor vacío que erróneo).
  ...(findPrimaryAbout(calc.h1 || '') ? { about: findPrimaryAbout(calc.h1 || '') } : {}),
};

// Article schema para categorías YMYL (Finanzas, Salud) y cualquier calc con explanation extensa
const isYMYL = ['finanzas', 'salud', 'negocios', 'mascotas', 'familia', 'impuestos'].includes(calc.category);
// YMYL disclaimer auto-inject: si categoría sensible Y explanation no menciona ya
// "consultá con", "no reemplaza", "disclaimer" o similar, agregar bloque visible.
// Refuerza E-E-A-T trust signals para Bing/Gemini/Perplexity AI citations.
const _explLower = ((calc.explanation || '') + (calc.intro || '') + (calc.keyTakeaway || '')).toLowerCase();
const _hasDisclaimer = ['disclaimer','orientativ','no reemplaz','consultá con','consulta con','profesional matriculado','asesor financiero','contador público','profesional de la salud','no constituye asesoramiento','no sustituye'].some(kw => _explLower.includes(kw));
const _disclaimerByCategory: Record<string, { who: string; verb: string }> = {
  salud:     { who: 'médico, nutricionista o profesional de la salud matriculado', verb: 'reemplazan la consulta médica profesional' },
  mascotas:  { who: 'veterinario matriculado', verb: 'reemplazan la consulta veterinaria' },
  finanzas:  { who: 'asesor financiero registrado en la CNV o contador público matriculado', verb: 'constituyen asesoramiento financiero individualizado' },
  impuestos: { who: 'contador público matriculado o asesor fiscal', verb: 'constituyen asesoramiento tributario' },
  negocios:  { who: 'contador público, abogado o asesor matriculado', verb: 'constituyen asesoramiento profesional' },
  familia:   { who: 'profesional matriculado del área correspondiente', verb: 'reemplazan asesoramiento personalizado' },
};
const _disc = _disclaimerByCategory[calc.category];
const showYmylDisclaimer = isYMYL && !_hasDisclaimer && _disc;
// Article schema para TODAS las calcs (2026-05-28) post comparativa con Omni
// Calculator (3.863 calcs, líder global): ellos emiten Article unconditional y
// rankean #1 en la mayoría del nicho. Antes era condicional (YMYL OR explanation
// >1500). El riesgo del cambio era inyectar Article con wordCount thin, pero
// resolvimos contando el wordCount REAL (explanation + intro + keyTakeaway +
// answerSnippet + FAQ q/a) — ver wordCount abajo. Las 11 calcs marketing/deportes
// con explanation ~900 chars tienen FAQ 7-12 + intro ≥500 chars, suman 400-600
// palabras de contenido editorial → suficiente para Article real, no thin.
const _articleWordCount = (() => {
  const parts: string[] = [
    calc.explanation || '',
    calc.intro || '',
    calc.keyTakeaway || '',
    calc.answerSnippet || '',
  ];
  if (Array.isArray(calc.faq)) {
    for (const f of calc.faq) {
      if (typeof f === 'object') {
        parts.push(f.q || f.question || '');
        parts.push(f.a || f.answer || '');
      }
    }
  }
  return parts.join(' ').split(/\s+/).filter(Boolean).length;
})();
const schemaArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: calc.h1,
  // description: usa answerSnippet (50-60 palabras) > keyTakeaway > schemaDescription
  // para que Google levante directo el texto del featured snippet.
  description: snippetDescription,
  url: `https://hacecuentas.com/${calc.slug}`,
  mainEntityOfPage: `https://hacecuentas.com/${calc.slug}`,
  image: `https://hacecuentas.com${ogImage}`,
  inLanguage: schemaLang,
  datePublished,
  dateModified,
  // Author como Person (Martín Rodríguez). Post Core Update Abril 2026,
  // Google premia author real verificable por encima de Organization genérica.
  // El @id Person está definido en /autores/martin-rodriguez con sameAs GitHub.
  // Publisher queda Organization (Hacé Cuentas) — author/publisher split correcto.
  author: {
    '@type': 'Person',
    '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person',
    name: 'Martín Rodríguez',
    url: 'https://hacecuentas.com/autores/martin-rodriguez',
  },
  // Revisor profesional real (médico/nutricionista/veterinario/kinesiólogo…)
  // como `contributor` — propiedad estándar Schema.org. NO reemplaza al author
  // editorial (Martín). Solo se emite si el revisor es completo y válido.
  ...(hasValidProfessionalReviewer(calc) ? {
    contributor: {
      '@type': 'Person',
      name: calc.professionalReviewer.name,
      ...(calc.professionalReviewer.profileUrl ? { url: calc.professionalReviewer.profileUrl } : {}),
      ...(calc.professionalReviewer.profession || calc.professionalReviewer.credential
        ? { jobTitle: [calc.professionalReviewer.profession, calc.professionalReviewer.credential].filter(Boolean).join(', ') }
        : {}),
    },
  } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://hacecuentas.com/og-default.png',
    },
  },
  about: categoryLabels[calc.category] || calc.category,
  articleSection: categoryLabels[calc.category] || calc.category,
  // wordCount: contamos TODO el contenido editorial (explanation + intro + key
  // takeaway + answerSnippet + FAQ q/a), no solo explanation. Sin esto, calcs
  // marketing/deportes con explanation ~900 chars salían con wordCount ~120 → Google
  // lo lee como thin content. El cuerpo completo llega típicamente a 400-1500
  // palabras → señal honesta al rich results check.
  wordCount: _articleWordCount,
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  ...(citationLd.length ? { citation: citationLd } : {}),
  // mentions: entidades Wikidata reconocidas en h1/seoKeywords (mismo helper que
  // usamos en SoftwareApplication). LLMs (ChatGPT/Claude/Perplexity/Copilot)
  // reciben entity disambiguation cross-schema → más probabilidades de ser citado.
  ...(_mentions.length ? { mentions: _mentions } : {}),
  // keywords: refuerza tema para Bing AI y AI Overviews. Concat de seoKeywords
  // (top 5 para no inflar).
  keywords: (calc.seoKeywords || []).slice(0, 5).join(', '),
  // publishingPrinciples a nivel Article (no solo Org) refuerza E-E-A-T en YMYL.
  publishingPrinciples: 'https://hacecuentas.com/politica-editorial',
};

const schemaGraph: any[] = [schemaBreadcrumb, schemaApp, schemaArticle];
