export async function getStaticPaths() {
  const calcs = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
  const all = Object.values(calcs).map((mod: any) => mod.default || mod);
  return filterByIncremental(all, 'calcs', 'ar').map((c: any) => ({
    params: { slug: c.slug },
    props: { calc: c },
  }));
}

const { calc } = Astro.props;

// Cargar calcs de otros locales para hreflang bidireccional
const enCalcModules = import.meta.glob<any>('../content/calcs-en/*.json', { eager: true });
const enCalcs = Object.values(enCalcModules).map((m: any) => m.default || m);
const ptCalcModules = import.meta.glob<any>('../content/calcs-pt/*.json', { eager: true });
const ptCalcs = Object.values(ptCalcModules).map((m: any) => m.default || m);
const mxCalcModules = import.meta.glob<any>('../content/calcs-mx/*.json', { eager: true });
const mxCalcs = Object.values(mxCalcModules).map((m: any) => m.default || m);
const esCalcModules = import.meta.glob<any>('../content/calcs-es/*.json', { eager: true });
const esCalcs = Object.values(esCalcModules).map((m: any) => m.default || m);
const coCalcModules = import.meta.glob<any>('../content/calcs-co/*.json', { eager: true });
const coCalcs = Object.values(coCalcModules).map((m: any) => m.default || m);
const clCalcModules = import.meta.glob<any>('../content/calcs-cl/*.json', { eager: true });
const clCalcs = Object.values(clCalcModules).map((m: any) => m.default || m);
const peCalcModules = import.meta.glob<any>('../content/calcs-pe/*.json', { eager: true });
const peCalcs = Object.values(peCalcModules).map((m: any) => m.default || m);
const ecCalcModules = import.meta.glob<any>('../content/calcs-ec/*.json', { eager: true });
const ecCalcs = Object.values(ecCalcModules).map((m: any) => m.default || m);

// Markdown simple → HTML
// Escape HTML antes de inyectar en templates. Defense-in-depth por si un JSON
// contribuido externamente contiene <script> o eventos inline.
function escHtml(s: string): string {
  return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
}
// Escape para atributos href — solo permite protocolos seguros
function safeUrl(u: string): string {
  const trimmed = u.trim();
  // Permitir solo http(s), mailto, tel, anchors y relative paths
  if (/^(https?:|mailto:|tel:|#|\/)/i.test(trimmed)) {
    return escHtml(trimmed);
  }
  return '#'; // bloquear javascript:, data:, etc.
}

const categoryLabels: Record<string, string> = {
  finanzas: 'Finanzas',
  negocios: 'Negocios',
  negocio: 'Negocios',
  salud: 'Salud',
  marketing: 'Marketing',
  deportes: 'Deportes',
  viajes: 'Viajes',
  vida: 'Vida cotidiana',
  mascotas: 'Mascotas',
  matematica: 'Matemática',
  construccion: 'Construcción',
  cocina: 'Cocina',
  educacion: 'Educación',
  automotor: 'Automotor',
  tecnologia: 'Tecnología',
  'medio-ambiente': 'Medio Ambiente',
  electronica: 'Electrónica',
};

// dateModified = lastReviewed del JSON > mtime del archivo > build date
let dateModified: string;
let lastReviewedLabel: string;
// OG image: se usa /og/{slug}.png si la slug figura en el manifest generado
// en pre-build (scripts/generate-og-manifest.ts). Fallback al default.
// No podemos usar fs directo acá porque con output:'server' el frontmatter
// corre en el runtime Cloudflare Workers (que no tiene node:fs).
let ogImage = '/og-default.png';
if ((ogManifest as Record<string, boolean>)[calc.slug]) {
  ogImage = `/og/${calc.slug}.png`;
}

// dateModified: prioridad live-data-refresh > lastReviewed > dataUpdate.lastUpdated > build date.
// - Si la calc tiene dataSource (Information Gain con datos live BCRA/INDEC/Dolar),
//   dateModified = build date (porque el cron diario re-deploya cuando hay cambios live).
// - Caso contrario: lastReviewed > dataUpdate.lastUpdated > build date.
const _dataUpdateLast = calc.dataUpdate?.lastUpdated;
const _hasLiveData = Array.isArray(calc.dataSource) && calc.dataSource.length > 0;
if (_hasLiveData) {
  // Live data se refresca diariamente vía data-refresh-daily.yml — usar build date
  // como dateModified señaliza a Google/Bing que la página tiene contenido fresco.
  dateModified = new Date().toISOString();
} else if (calc.lastReviewed && /^\d{4}-\d{2}-\d{2}$/.test(calc.lastReviewed)) {
  dateModified = new Date(calc.lastReviewed + 'T00:00:00Z').toISOString();
} else if (_dataUpdateLast && /^\d{4}-\d{2}-\d{2}$/.test(_dataUpdateLast)) {
  dateModified = new Date(_dataUpdateLast + 'T00:00:00Z').toISOString();
} else {
  dateModified = new Date().toISOString();
}
lastReviewedLabel = new Date(dateModified).toLocaleDateString('es-AR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
// Badge "Actualizado <mes> <año>" en español, junto al H1.
const _badgeMonthYear = new Date(dateModified).toLocaleDateString('es-AR', {
  month: 'long',
  year: 'numeric',
});
// Sello de frescura a NIVEL DATO (src/lib/data-freshness.ts): si la calc tiene
// datos live (dataSource, refresh diario) o su fórmula importa una tabla maestra
// de src/lib/data/ con DATA_AS_OF, el badge muestra la vigencia del DATO además
// de la fecha editorial. Caso contrario, cae al "Actualizado <mes año>" de siempre.
const _dataAsOf: string | null = _hasLiveData
  ? dateModified.slice(0, 10) // live data: se refresca a diario vía cron → vigencia = build date
  : getDataAsOf((calc as any).formulaId);
let updatedBadgeLabel = `Actualizado ${_badgeMonthYear}`;
let updatedBadgeTitle = `Última revisión: ${lastReviewedLabel}`;
if (_dataAsOf) {
  const _dataAsOfDate = new Date(_dataAsOf + 'T00:00:00Z');
  // timeZone UTC: sin esto, medianoche UTC renderiza como el día ANTERIOR en ART (UTC-3).
  const _dataAsOfLabel = _dataAsOfDate.toLocaleDateString('es-AR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
  updatedBadgeLabel = `Datos: ${_dataAsOfLabel} · Revisado: ${_badgeMonthYear}`;
  const _dataAsOfFull = _dataAsOfDate.toLocaleDateString('es-AR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
  updatedBadgeTitle = `Dato vigente al ${_dataAsOfFull} · Última revisión: ${lastReviewedLabel}`;
}
// Color de categoría (B): tiñe la zona de identidad del header (eyebrow + ícono).
// El teal de marca (--accent) se mantiene para el CTA y el resultado.
const catColor = categoryColor(calc.category);
// Variante AA-safe del color de categoría para usar como TEXTO (eyebrow).
const catTextColor = categoryTextColor(calc.category);
// datePublished opcional: viene de calc.datePublished si está declarada (YYYY-MM-DD o ISO).
// Si no, omitimos el campo del schema (JSON.stringify ignora undefined).
// Fechas uniformes hardcodeadas son señal de scaled content para Google.
const _rawDatePub = calc.datePublished;
const datePublished: string | undefined = typeof _rawDatePub === 'string' && /^\d{4}-\d{2}-\d{2}(T.*)?$/.test(_rawDatePub)
  ? (_rawDatePub.length === 10 ? new Date(_rawDatePub + 'T00:00:00Z').toISOString() : _rawDatePub)
  : undefined;

// audience: código país ISO o 'global'. Default histórico: 'global'.
type AudienceCode = 'AR' | 'MX' | 'CL' | 'CO' | 'ES' | 'BO' | 'PE' | 'UY' | 'BR' | 'global';
const VALID_AUDIENCES: AudienceCode[] = ['AR','MX','CL','CO','ES','BO','PE','UY','BR','global'];
const rawAudience = calc.audience;
// Normalizar casing: "ar"→"AR", "Global"→"global". Evita que un código mal tipeado
// se degrade en silencio a 'global' y pierda el geo/locale del país.
const normAudience = typeof rawAudience === 'string'
  ? (rawAudience.toLowerCase() === 'global' ? 'global' : rawAudience.toUpperCase())
  : 'global';
const audience: AudienceCode = (VALID_AUDIENCES as string[]).includes(normAudience)
  ? (normAudience as AudienceCode)
  : 'global';
const schemaLang = audience === 'AR' ? 'es-AR' : audience === 'MX' ? 'es-MX' : audience === 'CL' ? 'es-CL' : audience === 'CO' ? 'es-CO' : audience === 'ES' ? 'es-ES' : audience === 'BR' ? 'pt-BR' : 'es';

// Country badge metadata (flag + tooltip + currency). Mostrado al lado del h1.
const COUNTRY_META: Record<AudienceCode, { flag: string; tooltip: string; currency: string }> = {
  AR:     { flag: '🇦🇷', tooltip: 'Datos Argentina (ARCA/ANSES)',          currency: 'ARS' },
  MX:     { flag: '🇲🇽', tooltip: 'Datos México (SAT/IMSS)',                currency: 'MXN' },
  CL:     { flag: '🇨🇱', tooltip: 'Datos Chile (SII/AFP)',                  currency: 'CLP' },
  CO:     { flag: '🇨🇴', tooltip: 'Datos Colombia (DIAN)',                  currency: 'COP' },
  ES:     { flag: '🇪🇸', tooltip: 'Datos España (IRPF/Hacienda)',           currency: 'EUR' },
  BO:     { flag: '🇧🇴', tooltip: 'Datos Bolivia',                          currency: 'BOB' },
  PE:     { flag: '🇵🇪', tooltip: 'Datos Perú (SUNAT)',                     currency: 'PEN' },
  UY:     { flag: '🇺🇾', tooltip: 'Datos Uruguay (DGI/BPS)',                currency: 'UYU' },
  BR:     { flag: '🇧🇷', tooltip: 'Datos Brasil (Receita Federal)',         currency: 'BRL' },
  global: { flag: '🌎', tooltip: 'Aplica globalmente (sin localizar a país)', currency: 'USD' },
};
const countryBadge = COUNTRY_META[audience];
// Nombre display por país para el aviso de jurisdicción (#25 — generalizado a todos los países, no solo AR).
const COUNTRY_NAME: Record<AudienceCode, string> = {
  AR: 'Argentina', MX: 'México', CL: 'Chile', CO: 'Colombia', ES: 'España',
  BO: 'Bolivia', PE: 'Perú', UY: 'Uruguay', BR: 'Brasil', global: 'tu país',
};

// Citas estructuradas para LLMs/Copilot: objeto CreativeWork con url+name+date+publisher
// (en vez de strings sueltos) → las IAs validan fuente y fecha antes de citar.
const citationLd = (calc.sources || [])
  .map((s: any) => {
    if (!s || (!s.url && !s.name)) return null;
    const o: any = { '@type': 'CreativeWork', name: s.name || s.url };
    if (s.url) o.url = s.url;
    if (s.date) o.datePublished = String(s.date);
    if (s.publisher) o.publisher = { '@type': 'Organization', name: s.publisher };
    return o;
  })
  .filter(Boolean);

/**
 * Description "safe" para schemas structured data. Google Rich Results exige
 * longitud mínima (~50 chars) en varios tipos (Dataset, SoftwareApplication,
 * Article); descriptions cortas caen como "La longitud de cadena del campo
 * description no es válida" en Search Console.
 *
 * Estrategia: partir de calc.description, y si es corta completar con h1,
 * keyTakeaway y category label — contenido real, no padding artificial.
 * Cap a 500 chars para no inflar el HTML innecesariamente.
 */
function buildSchemaDescription(c: any): string {
  const base = (c.description || '').trim();
  if (base.length >= 50) return base.slice(0, 500);
  const parts = [base];
  if (c.h1) parts.push(c.h1);
  if (c.keyTakeaway) parts.push(String(c.keyTakeaway).replace(/\*\*/g, ''));
  const catLabel = categoryLabels[c.category] || c.category;
  if (catLabel) parts.push(`Categoría: ${catLabel}.`);
  const merged = parts.filter(Boolean).join(' — ').trim();
  return (merged.length >= 50 ? merged : `${merged} Calculadora gratis, sin registro, resultado inmediato.`).slice(0, 500);
}
const schemaDescription = buildSchemaDescription(calc);

// Featured Snippet description: prioridad answerSnippet > keyTakeaway > schemaDescription.
// Se inyecta en Article/SoftwareApplication.description para que Google use ese texto
// como base del featured snippet (Position 0). Strip markdown bold/italic para evitar
// que `**` aparezcan literales en SERP. Cap a 500 chars (límite seguro Article schema).
function stripMd(s: string): string {
  return String(s || '')
    .replace(/\*\*(.+?)\*\*/g, '$1')
    .replace(/\*(.+?)\*/g, '$1')
    .replace(/`([^`\n]+)`/g, '$1')
    .replace(/\[(.+?)\]\(.+?\)/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
}
const snippetDescription = (() => {
  const candidate = calc.answerSnippet || calc.keyTakeaway || schemaDescription;
  const stripped = stripMd(candidate);
  return (stripped.length >= 50 ? stripped : schemaDescription).slice(0, 500);
})();

// Prioridad: 1) howToSteps explícitos en JSON, 2) extraídos del explanation
// (líneas tipo "1. ...", "Paso 1: ..."), 3) fallback a los fields.
function extractStepsFromExplanation(text: string): Array<{name: string, text: string}> {
  if (!text) return [];
  const steps: Array<{name: string, text: string}> = [];
  // Match "1. Texto" o "Paso 1: Texto" en líneas separadas
  const re = /^(?:Paso\s+)?(\d+)\.\s+(.+?)(?:\n(?!\d+\.|\n)[^\n]+)*/gim;
  for (const m of text.matchAll(re)) {
    const body = m[2].trim();
    if (body.length < 8 || body.length > 280) continue;
    const colon = body.indexOf(':');
    if (colon > 4 && colon < 60) {
      steps.push({ name: body.slice(0, colon).trim(), text: body.slice(colon + 1).trim() });
    } else {
      const head = body.split(/[.!?]\s/)[0].slice(0, 70);
      steps.push({ name: head, text: body });
    }
    if (steps.length >= 8) break; // Cap razonable para HowTo
  }
  return steps;
}

const howToSteps = calc.howToSteps && calc.howToSteps.length > 0
  ? calc.howToSteps
  : (() => {
      const fromText = extractStepsFromExplanation(calc.explanation || '');
      if (fromText.length >= 3) return fromText;
      return calc.fields.map((f: any) => ({
        name: f.label,
        text: f.help || `Ingresá ${f.label.toLowerCase()}`,
      }));
    })();

// ¿Hay pasos REALES para el HowTo? (explícitos en JSON o extraídos de la
// explanation). Si caemos al fallback de fields ("Ingresá X"), NO emitimos el
// HowTo schema: un HowTo de relleno sobre "cómo usar la UI" es schema padding
// (señal de scaled content / HCU). El render visible no depende de esto.
const hasRealHowToSteps =
  (Array.isArray(calc.howToSteps) && calc.howToSteps.length >= 2) ||
  extractStepsFromExplanation(calc.explanation || '').length >= 3;

// HowTo schema: además de los steps, declaramos `tool` con los inputs del
// calc (cada field es algo que el usuario "necesita aportar"). Boost al
// rich result + ayuda a Google a entender qué datos requiere la calc.
const schemaHowTo: any = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `Cómo usar la ${calc.h1}`,
  description: schemaDescription,
  totalTime: 'PT1M',
  inLanguage: schemaLang,
  step: howToSteps.map((s: any, i: number) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.text,
    url: `https://hacecuentas.com/${calc.slug}#paso-${i + 1}`,
    ...(ogImage !== '/og-default.png' ? { image: `https://hacecuentas.com${ogImage}` } : {}),
  })),
};
if (Array.isArray(calc.fields) && calc.fields.length > 0) {
  schemaHowTo.tool = calc.fields.slice(0, 8).map((f: any) => ({
    '@type': 'HowToTool',
    name: f.label,
  }));
}
if (Array.isArray(calc.supplies) && calc.supplies.length > 0) {
  schemaHowTo.supply = calc.supplies.map((s: any) => ({
    '@type': 'HowToSupply',
    name: typeof s === 'string' ? s : s.name,
  }));
}

const schemaFAQ = calc.faq && calc.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `https://hacecuentas.com/${calc.slug}#faq`,
  url: `https://hacecuentas.com/${calc.slug}`,
  inLanguage: schemaLang,
  ...(datePublished ? { datePublished } : {}),
  dateModified,
  about: categoryLabels[calc.category] || calc.category,
  author: { '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person' },
  publisher: { '@id': 'https://hacecuentas.com/#organization' },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.faq-list summary', '.faq-list details > div'],
  },
  mainEntity: calc.faq.map((f: any, i: number) => ({
    '@type': 'Question',
    '@id': `https://hacecuentas.com/${calc.slug}#faq-${i + 1}`,
    name: f.q,
    answerCount: 1,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
      inLanguage: schemaLang,
      author: { '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person' },
      url: `https://hacecuentas.com/${calc.slug}#faq-${i + 1}`,
    },
  })),
} : null;

// Guía pilar del tema (hub) para link contextual de SEO.
// resolveGuideSlug: override manual → patrón de slug (guías AR) → categoría.
// Insertamos el crumb de guía SÓLO cuando difiere del default de la categoría:
// evita "Salud / Salud y fitness" redundante, pero enriquece monotributo→Impuestos,
// aguinaldo/indemnización→Sueldos, jubilación→ANSES (las páginas de plata cross-category).
const pillarGuideSlug: string | null = resolveGuideSlug(calc);
const pillarGuideTitle: string | null = pillarGuideSlug ? GUIDE_TITLES[pillarGuideSlug] : null;
const includeGuideCrumb: boolean = !!pillarGuideSlug && !!pillarGuideTitle && pillarGuideSlug !== CATEGORY_TO_GUIDE[calc.category];

const breadcrumbCrumbs: Array<{ name: string; item?: string; description?: string }> = [
  {
    name: 'Inicio',
    item: 'https://hacecuentas.com/',
    description: 'Calculadoras gratuitas para Argentina',
  },
  {
    name: categoryLabels[calc.category] || calc.category,
    item: `https://hacecuentas.com/categoria/${calc.category}`,
    description: `Calculadoras de ${categoryLabels[calc.category] || calc.category}`,
  },
  ...(includeGuideCrumb ? [{
    name: pillarGuideTitle as string,
    item: `https://hacecuentas.com/guia/${pillarGuideSlug}`,
    description: `Guía completa: ${pillarGuideTitle}`,
  }] : []),
  {
    name: calc.h1,
    description: (calc.description || '').slice(0, 160),
  },
];

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbCrumbs.map((c, i) => {
    const li: any = { '@type': 'ListItem', position: i + 1, name: c.name };
    if (c.item) li.item = c.item;
    if (c.description) li.description = c.description;
    return li;
  }),
};

// Mapeo categoría → schema.org applicationCategory. Google usa esto para
// clasificar la app en Rich Results. Las categorías sin match natural
// (cocina, juegos, etc.) caen a UtilitiesApplication.
const APPLICATION_CATEGORY_MAP: Record<string, string> = {
  finanzas: 'FinanceApplication',
  impuestos: 'FinanceApplication',
  negocios: 'BusinessApplication',
  marketing: 'BusinessApplication',
  salud: 'HealthApplication',
  mascotas: 'HealthApplication',
  familia: 'LifestyleApplication',
  vida: 'LifestyleApplication',
  hogar: 'LifestyleApplication',
  jardineria: 'LifestyleApplication',
  cocina: 'LifestyleApplication',
  viajes: 'TravelApplication',
  deportes: 'HealthApplication',
  educacion: 'EducationalApplication',
  idiomas: 'EducationalApplication',
  matematica: 'EducationalApplication',
  ciencia: 'EducationalApplication',
  astronomia: 'EducationalApplication',
  clima: 'UtilitiesApplication',
  'medio-ambiente': 'UtilitiesApplication',
  construccion: 'UtilitiesApplication',
  automotor: 'UtilitiesApplication',
  tecnologia: 'UtilitiesApplication',
  electronica: 'UtilitiesApplication',
  entretenimiento: 'GameApplication',
  juegos: 'GameApplication',
};
const applicationCategory = APPLICATION_CATEGORY_MAP[calc.category] || 'UtilitiesApplication';

// SoftwareApplication + WebApplication — Google las usa para web apps / calculadoras
const schemaApp = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'WebApplication'],
  name: calc.h1,
  // description con fallback answerSnippet > keyTakeaway > schemaDescription para
  // que Bing/Copilot levanten el texto curado al rich snippet.
  description: snippetDescription,
  url: `https://hacecuentas.com/${calc.slug}`,
  mainEntityOfPage: `https://hacecuentas.com/${calc.slug}`,
  applicationCategory,
  applicationSubCategory: 'Calculator',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  inLanguage: schemaLang,
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  datePublished,
  dateModified,
  offers: freeOfferSchema({ priceCurrency: countryBadge.currency, validFrom: datePublished || dateModified }),
  // image + screenshot: Bing/Copilot usan estas props para rich snippets visuales
  // en SoftwareApplication. Sin ellas, los resultados van sin thumbnail.
  image: {
    '@type': 'ImageObject',
    url: `https://hacecuentas.com${ogImage}`,
    width: 1200,
    height: 630,
  },
  screenshot: `https://hacecuentas.com${ogImage}`,
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
  },
  // Speakable: permite a voice assistants (Alexa, Cortana, Google Assistant) y
  // AI bots (ChatGPT, Copilot, Claude, Perplexity, Gemini) identificar las
  // partes clave de la calc para responder a queries de voz/AI.
  // Bing/Copilot le prestan especial atención a Speakable.
  // Selectores ampliados 2026-05-11 para incluir FAQ y primer párrafo de explicación.
  speakable: {
    '@type': 'SpeakableSpecification',
    // Solo selectores que EXISTEN de verdad en el DOM renderizado (verificado
    // 2026-05-29). Se removieron los fantasma (.aeo-direct-answer, .calc-summary,
    // .calc-result-output, #faq dt, #faq dd, #cuando-usar p) que nunca matcheaban:
    // Speakable con selectores rotos a escala es señal de markup auto-generado.
    cssSelector: [
      '[data-speakable]',            // hook universal (answer-snippet + key-takeaway lo llevan)
      '.answer-snippet',            // Featured Snippet block (Position 0 Google)
      '.aeo-quick-answer',          // Respuesta rápida (TOP para AEO/voice)
      '.calc-intro',                 // intro
      '.calc-key-takeaway',          // en pocas palabras
      'h1',                          // título principal (siempre voice-relevant)
      '#como-funciona p:first-of-type',  // primer párrafo de explicación
      '#faq details > div p:first-of-type',  // 1er párrafo respuesta FAQ enfocado
      '.use-cases li',               // casos de uso (alta densidad de intent)
    ],
  },
  // Citation: fuentes verificables externas (mismo array que Article schema cuando aplica).
  // Bing/Copilot priorizan citation para citar en answer cards y AI Overviews.
  // Importante incluirlo en SoftwareApplication (que se renderiza siempre) y no
  // solo en Article (que solo aplica a YMYL o explanation > 1500).
  citation: citationLd,
  // Mentions: entidades Wikidata reconocidas en h1/seoKeywords. Le da a LLMs
  // (ChatGPT/Claude/Perplexity/Gemini) entity disambiguation gratis vía
  // knowledge graph de Wikidata. Ej: si la calc menciona "ANSES" → linkea a
  // https://www.wikidata.org/wiki/Q830348.
  mentions: findMentions(
    `${calc.h1 || ''} ${calc.title || ''} ${(calc.seoKeywords || []).join(' ')}`
  ),
  // About: primary topic de la página. Más fuerte que `mentions` para entity
  // resolution en Google/Bing/LLMs. Solo si matcheamos en el H1 (conservador).
  // Si no hay match en H1, no inyectamos `about` (mejor vacío que erróneo).
  ...(findPrimaryAbout(calc.h1 || '') ? { about: findPrimaryAbout(calc.h1 || '') } : {}),
};

// Article schema para categorías YMYL (Finanzas, Salud) y cualquier calc con explanation extensa
const isYMYL = ['finanzas', 'salud', 'negocios', 'mascotas', 'familia', 'impuestos'].includes(calc.category);
// YMYL disclaimer auto-inject: si categoría sensible Y explanation no menciona ya
// "consultá con", "no reemplaza", "disclaimer" o similar, agregar bloque visible.
// Refuerza E-E-A-T trust signals para Bing/Gemini/Perplexity AI citations.
const _explLower = ((calc.explanation || '') + (calc.intro || '') + (calc.keyTakeaway || '')).toLowerCase();
const _hasDisclaimer = ['disclaimer','orientativ','no reemplaz','consultá con','consulta con','profesional matriculado','asesor financiero','contador público','profesional de la salud','no constituye asesoramiento','no sustituye'].some(kw => _explLower.includes(kw));
const _disclaimerByCategory: Record<string, { who: string; verb: string }> = {
  salud:     { who: 'médico, nutricionista o profesional de la salud matriculado', verb: 'reemplazan la consulta médica profesional' },
  mascotas:  { who: 'veterinario matriculado', verb: 'reemplazan la consulta veterinaria' },
  finanzas:  { who: 'asesor financiero registrado en la CNV o contador público matriculado', verb: 'constituyen asesoramiento financiero individualizado' },
  impuestos: { who: 'contador público matriculado o asesor fiscal', verb: 'constituyen asesoramiento tributario' },
  negocios:  { who: 'contador público, abogado o asesor matriculado', verb: 'constituyen asesoramiento profesional' },
  familia:   { who: 'profesional matriculado del área correspondiente', verb: 'reemplazan asesoramiento personalizado' },
};
const _disc = _disclaimerByCategory[calc.category];
const showYmylDisclaimer = isYMYL && !_hasDisclaimer && _disc;
// Article schema para TODAS las calcs (2026-05-28) post comparativa con Omni
// Calculator (3.863 calcs, líder global): ellos emiten Article unconditional y
// rankean #1 en la mayoría del nicho. Antes era condicional (YMYL OR explanation
// >1500). El riesgo del cambio era inyectar Article con wordCount thin, pero
// resolvimos contando el wordCount REAL (explanation + intro + keyTakeaway +
// answerSnippet + FAQ q/a) — ver wordCount abajo. Las 11 calcs marketing/deportes
// con explanation ~900 chars tienen FAQ 7-12 + intro ≥500 chars, suman 400-600
// palabras de contenido editorial → suficiente para Article real, no thin.
const _articleWordCount = (() => {
  const parts: string[] = [
    calc.explanation || '',
    calc.intro || '',
    calc.keyTakeaway || '',
    calc.answerSnippet || '',
  ];
  if (Array.isArray(calc.faq)) {
    for (const f of calc.faq) {
      if (typeof f === 'object') {
        parts.push(f.q || f.question || '');
        parts.push(f.a || f.answer || '');
      }
    }
  }
  return parts.join(' ').split(/\s+/).filter(Boolean).length;
})();
const schemaArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: calc.h1,
  // description: usa answerSnippet (50-60 palabras) > keyTakeaway > schemaDescription
  // para que Google levante directo el texto del featured snippet.
  description: snippetDescription,
  url: `https://hacecuentas.com/${calc.slug}`,
  mainEntityOfPage: `https://hacecuentas.com/${calc.slug}`,
  image: `https://hacecuentas.com${ogImage}`,
  inLanguage: schemaLang,
  datePublished,
  dateModified,
  // Author como Person (Martín Rodríguez). Post Core Update Abril 2026,
  // Google premia author real verificable por encima de Organization genérica.
  // El @id Person está definido en /autores/martin-rodriguez con sameAs GitHub.
  // Publisher queda Organization (Hacé Cuentas) — author/publisher split correcto.
  author: {
    '@type': 'Person',
    '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person',
    name: 'Martín Rodríguez',
    url: 'https://hacecuentas.com/autores/martin-rodriguez',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://hacecuentas.com/og-default.png',
    },
  },
  about: categoryLabels[calc.category] || calc.category,
  articleSection: categoryLabels[calc.category] || calc.category,
  // wordCount: contamos TODO el contenido editorial (explanation + intro + key
  // takeaway + answerSnippet + FAQ q/a), no solo explanation. Sin esto, calcs
  // marketing/deportes con explanation ~900 chars salían con wordCount ~120 → Google
  // lo lee como thin content. El cuerpo completo llega típicamente a 400-1500
  // palabras → señal honesta al rich results check.
  wordCount: _articleWordCount,
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  citation: citationLd,
  // mentions: entidades Wikidata reconocidas en h1/seoKeywords (mismo helper que
  // usamos en SoftwareApplication). LLMs (ChatGPT/Claude/Perplexity/Copilot)
  // reciben entity disambiguation cross-schema → más probabilidades de ser citado.
  mentions: findMentions(
    `${calc.h1 || ''} ${calc.title || ''} ${(calc.seoKeywords || []).join(' ')}`
  ),
  // keywords: refuerza tema para Bing AI y AI Overviews. Concat de seoKeywords
  // (top 5 para no inflar).
  keywords: (calc.seoKeywords || []).slice(0, 5).join(', '),
  // publishingPrinciples a nivel Article (no solo Org) refuerza E-E-A-T en YMYL.
  publishingPrinciples: 'https://hacecuentas.com/politica-editorial',
};

const schemaGraph: any[] = [schemaBreadcrumb, schemaApp, schemaArticle];
if (hasRealHowToSteps) schemaGraph.unshift(schemaHowTo);
if (schemaFAQ) schemaGraph.push(schemaFAQ);

