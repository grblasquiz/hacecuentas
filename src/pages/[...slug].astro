// VideoObject schema — si la calc declara `video` (objeto o array de objetos),
// agregamos schema VideoObject para que Google muestre el rich snippet de video
// y aparezca en Google Videos. Formato esperado en JSON:
//   "video": { "name": "...", "description": "...", "thumbnailUrl": "...",
//              "uploadDate": "2026-01-15", "embedUrl": "https://www.youtube.com/embed/XXX" }
//   o array de varios.
const videos = Array.isArray(calc.video) ? calc.video : (calc.video ? [calc.video] : []);
for (const v of videos) {
  if (!v?.name || !v?.embedUrl) continue;
  schemaGraph.push({
    '@type': 'VideoObject',
    name: v.name,
    description: v.description || schemaDescription,
    thumbnailUrl: v.thumbnailUrl || `https://hacecuentas.com${ogImage}`,
