      educationalRole: 'student',
    },
    datePublished: (datePublished || dateModified).split('T')[0],
    dateModified: dateModified.split('T')[0],
    publisher: {
      '@type': 'Organization',
      name: 'Hacé Cuentas',
      url: 'https://hacecuentas.com',
    },
    isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  });
}

// VideoObject schema — si la calc declara `video` (objeto o array de objetos),
// agregamos schema VideoObject para que Google muestre el rich snippet de video
// y aparezca en Google Videos. Formato esperado en JSON:
//   "video": { "name": "...", "description": "...", "thumbnailUrl": "...",
//              "uploadDate": "2026-01-15", "embedUrl": "https://www.youtube.com/embed/XXX" }
//   o array de varios.
const videos = Array.isArray(calc.video) ? calc.video : (calc.video ? [calc.video] : []);
for (const v of videos) {
  if (!v?.name || !v?.embedUrl) continue;
  schemaGraph.push({
    '@type': 'VideoObject',
    name: v.name,
    description: v.description || schemaDescription,
    thumbnailUrl: v.thumbnailUrl || `https://hacecuentas.com${ogImage}`,
    uploadDate: v.uploadDate || (datePublished || dateModified).split('T')[0],
    embedUrl: v.embedUrl,
    contentUrl: v.contentUrl,
    duration: v.duration, // ISO 8601, ej "PT2M30S"
    inLanguage: schemaLang,
    publisher: {
      '@type': 'Organization',
      name: 'Hacé Cuentas',
      logo: { '@type': 'ImageObject', url: 'https://hacecuentas.com/og-default.png' },
    },
  });
}

// AggregateRating — pulled desde D1 vía scripts/ratings-pull.ts → db/ratings.json.
// El JSON estatico de la calc puede sobreescribir con `ratings: { value, count }`.
// Threshold >= 5 votos reales para evitar self-serving / low-sample bias.
const calcRatings = (calc as any).ratings || (ratingsPulled as Record<string, { value: number; count: number }>)[calc.slug];
if (calcRatings && calcRatings.count >= 5) {
  const appNode = schemaGraph.find((n: any) => n['@type'] === 'SoftwareApplication' || n['@type'] === 'WebApplication');
  if (appNode) {
    appNode.aggregateRating = {
      '@type': 'AggregateRating',
      ratingValue: Number(calcRatings.value).toFixed(1),
      ratingCount: calcRatings.count,
      bestRating: '5',
      worstRating: '1',
    };
  }
}

const schema = { '@context': 'https://schema.org', '@graph': schemaGraph };

const updated = lastReviewedLabel;

// Reading time: ~200 palabras/minuto en español
const wordCount = calc.explanation ? calc.explanation.split(/\s+/).length : 0;
const readingMin = Math.max(1, Math.round(wordCount / 200));

// Nuevos campos SEO (todos opcionales)
const sources: Array<{ name: string; url?: string }> = calc.sources || [];
const useCases: string[] = calc.useCases || [];
const example: { title?: string; steps?: string[]; result?: string } | null = calc.example || null;
const keyTakeaway: string = calc.keyTakeaway || '';
// answerSnippet: 50-60 palabras optimizadas para Google Featured Snippet (Position 0).
// A diferencia de keyTakeaway (40-75 palabras para AEO/AI engines), este campo está
// formateado específicamente como respuesta directa al query principal — sin markdown
// pesado, idealmente 1 párrafo conciso que Google pueda extraer literal al SERP.
// Campo opcional: si no existe, el bloque no se renderiza y schemas hacen fallback.
const answerSnippet: string = calc.answerSnippet || '';
const relatedSlugs: string[] = calc.relatedSlugs || [];
const downloads: Array<{ label: string; href: string; description?: string }> = calc.downloads || [];

// (pillarGuideSlug / pillarGuideTitle / includeGuideCrumb se computan arriba,
// junto al schema BreadcrumbList, para poder enriquecer el breadcrumb con el hub.)

// Cluster al que pertenece esta calc (embarazo, dólar, etc.)
const cluster = findClusterForSlug(calc.slug);

// Hub de categoría: bloque rico de columnas si esta calc es "ancla" de su familia
const categoryHub = findHubForSlug(calc.slug);

// Tabla de conversiones comunes (server-rendered, crawleable) para conversores de
// unidades del top buscado. Factores hand-verified contra la fórmula — ver
// scripts/generate-converter-tables.mjs. Antes ningún conversor exponía esta tabla,
// que es justo lo que responde "cuánto es 10 cm en pulgadas" (Bing/AEO/featured snippet).
const converterTable: { from: string; to: string; fromU: string; toU: string; note: string; rows: string[][] } | null =
  (converterTables as Record<string, any>)[calc.slug] || null;

// Lookup para related links dentro del contenido
const allCalcsModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
const allCalcs = Object.values(allCalcsModules).map((m: any) => m.default || m);
const relatedContextual = relatedSlugs
  .map((s) => allCalcs.find((c) => c.slug === s))
  .filter(Boolean);

// Journey (propuestas #1 y #2): próximos pasos del recorrido real (cluster +
// sección de guía), no calcs "parecidas". Misma fuente para related y NextStep.
const journeySlugs: string[] = getJourneySteps(calc.slug, relatedSlugs, 6);
// Dedupe vs ClusterHub: el hub de arriba ya muestra las calcs del cluster, así
// que el bloque "Calculadoras relacionadas" del pie no debe repetirlas (era 1:1
// cuando había cluster). Excluimos sus slugs; si queda vacío, RelatedCalcs cae
// a su fallback por categoría/TF-IDF.
const _clusterSlugs = new Set((cluster?.items || []).map((it: any) => it.slug));
const journeyRelated: string[] = (journeySlugs.length ? journeySlugs : relatedSlugs)
  .filter((s) => !_clusterSlugs.has(s));
// #1 "Tu próximo paso" post-resultado — excluye YMYL (salud/finanzas).
const nextStepItems = journeySlugs
  .map((s) => allCalcs.find((c) => c.slug === s))
  .filter(Boolean)
  .slice(0, 3)
  .map((c: any) => ({ slug: c.slug, h1: c.h1, icon: c.icon, description: c.description }));
const showNextStep = !NEXT_STEP_EXCLUDED.has(calc.category) && nextStepItems.length >= 2;
// Monetización contextual (propuesta jun-2026): oferta por-calc, SEO-safe, se
// revela post-resultado. Wiring en src/lib/offers.ts. Sólo calcs de alto intento.
const contextualOffer = getOfferForCalc(calc.slug);
// #5 comparador "vs" relevante (conecta los comparadores existentes, antes huérfanos).
const comparator = getComparatorForCalc(calc.slug);
// #14 "Complemento recomendado": calcs fijadas por el autor como paso obligado
// (campo opcional calc.mustNextSteps = [slug]). Render-if-present; resuelve título vía allCalcs.
const mustNextSteps = (Array.isArray(calc.mustNextSteps) ? calc.mustNextSteps : [])
  .map((s: string) => allCalcs.find((c) => c.slug === s))
  .filter(Boolean)
  .map((c: any) => ({ slug: c.slug, h1: c.h1, icon: c.icon }));

// TOC: secciones top-level renderizadas (en orden de aparición)
const tocSections: Array<{ id: string; label: string }> = [
  { id: 'calculadora', label: 'Calculadora' },
];
if (keyTakeaway) tocSections.push({ id: 'respuesta-rapida', label: 'En pocas palabras' });
if (useCases.length > 0) tocSections.push({ id: 'cuando-usar', label: 'Cuándo usar' });
if (example && example.steps) tocSections.push({ id: 'ejemplo', label: 'Ejemplo paso a paso' });
if (converterTable) tocSections.push({ id: 'tabla-conversiones', label: 'Tabla de conversiones' });
if (calc.explanation) tocSections.push({ id: 'como-funciona', label: 'Cómo funciona' });
if (calc.faq && calc.faq.length > 0) tocSections.push({ id: 'faq', label: 'Preguntas frecuentes' });
if (sources.length > 0) tocSections.push({ id: 'fuentes', label: 'Fuentes y referencias' });

// Rail derecho de calcs sugeridas — 3ra columna del grid en desktop >=1280px.
// Se muestra cuando hay TOC (así el grid es siempre [TOC][contenido][rail], sin
// columnas vacías). IMC mantiene su lista curada diversa; el resto auto-deriva.
const hasRail = tocSections.length > 2;
const isImc = calc.slug === 'calculadora-imc';
const IMC_RAIL_ITEMS = [
  { icon: '👶', label: 'IMC infantil', href: '/calculadora-imc-infantil-percentil' },
  { icon: '🤰', label: 'Embarazo', href: '/calculadora-embarazo' },
  { icon: '🩺', label: 'Ovulación', href: '/calculadora-ovulacion-dias-fertiles' },
  { icon: '🧬', label: 'Edad metabólica', href: '/calculadora-edad-metabolica' },
  { icon: '⚡', label: 'TMB basal', href: '/calculadora-tmb-basal-harris-benedict-metabolismo' },
  { icon: '🔥', label: 'Calorías TDEE', href: '/calculadora-calorias-diarias-tdee' },
  { icon: '👴', label: 'IMC adultos mayores', href: '/calculadora-imc-adultos-mayores-edad-tabla' },
];

// Hubs temáticos fijados arriba del rail (concentran autoridad interna hacia el
// hub sin tocar ningún JSON → no mueven el sitemap):
//  - Mundial 2026: las ~30 calcs del cluster apuntan al hub /mundial-2026, así el
//    que cae de Google a una calc del Mundial descubre el cluster entero (driver
//    #1 de tráfico de fin de semana, timely jun-jul 2026).
//  - Mate/ciencia: la Calculadora científica (157+ calcs).
const isMundialCalc =
  calc.slug.includes('mundial-2026') ||
  calc.slug === 'cuanto-falta-mundial-fifa-2026-2030' ||
  calc.slug === 'calculadora-top-10-goleadores-historico-mundial-fifa';
// Cluster asado/fiesta/evento (~40 calcs de cantidad por invitado) → hub
// /calculadoras-evento. Alta intención de fin de semana.
const isEventoCalc =
  /invitado|asado|por-persona-evento|fernet-cola|presupuesto-cumple|cotillon|invitaciones-cumple|quinceanera/.test(calc.slug);
const railPinned =
  isMundialCalc
    ? [{ icon: '⚽', label: 'Mundial 2026 — todas las calculadoras', href: '/mundial-2026' }]
    : isEventoCalc
    ? [{ icon: '🎉', label: 'Calculadoras para tu asado o fiesta', href: '/calculadoras-evento' }]
    : ['matematica', 'ciencia'].includes(calc.category)
    ? [{ icon: '🧮', label: 'Calculadora científica', href: '/calculadora-cientifica' }]
    : undefined;

// Icons del quick-nav (sticky pills) por section id
const quickNavIcons: Record<string, string> = {
  'calculadora': '🧮',
  'respuesta-rapida': '⚡',
  'cuando-usar': '💡',
  'ejemplo': '📋',
  'casos-resueltos': '📊',
  'como-funciona': '🧠',
  'faq': '💬',
  'fuentes': '📚',
  'metodologia': '🛡️',
};

// Detección heurística de fórmulas LaTeX en el explanation (para cargar KaTeX condicional)
const hasMath = calc.explanation && /(\$[^$\n]+\$|\\frac|\\sqrt|\\sum|\\times|\\cdot)/.test(calc.explanation);

// Asunto pre-llenado para "Reportar error"
const reportSubject = encodeURIComponent(`Error en /${calc.slug}`);
const reportBody = encodeURIComponent(
  `Hola Equipo Hacé Cuentas,\n\nEncontré un error en la calculadora "${calc.h1}":\n\nURL: https://hacecuentas.com/${calc.slug}\nDatos que ingresé: \nResultado esperado: \nResultado obtenido: \nFuente / referencia: \n\nGracias.`
);

// hreflang bidireccional: detectar versiones en otros locales por slug similar o matching explícito
const enVersion = findVersionByEsSlug(enCalcs, calc.slug);
const ptVersion = findVersionByEsSlug(ptCalcs, calc.slug);
const mxVersion = findVersionByEsSlug(mxCalcs, calc.slug, true);
const esVersion = findVersionByEsSlug(esCalcs, calc.slug, true);
const coVersion = findVersionByEsSlug(coCalcs, calc.slug, true);
const clVersion = findVersionByEsSlug(clCalcs, calc.slug, true);
const peVersion = findVersionByEsSlug(peCalcs, calc.slug);
const ecVersion = findVersionByEsSlug(ecCalcs, calc.slug);

// Set hreflang unificado: todos los miembros del cluster declaran el MISMO
// set con UN solo x-default (la versión ES raíz). Ver src/lib/hreflang.ts.
// Cluster de 1 miembro → undefined → fallback del Layout (self + x-default).
const hreflangTags = buildHreflangCluster({
  es: calc.slug,
  en: enVersion?.slug,
  pt: ptVersion?.slug,
  mx: mxVersion?.slug,
  esEs: esVersion?.slug,
  co: coVersion?.slug,
  cl: clVersion?.slug,
  pe: peVersion?.slug,
  ec: ecVersion?.slug,
});

// Pills del lang-switch. Se renderizan en DOS navs (desktop arriba del grid /
// mobile abajo de la calculadora — ver "AD-FIRST MOBILE" en el CSS); el array
// único evita que las dos copias diverjan.
const langPills = [
  ptVersion && { href: `/pt/${ptVersion.slug}`, hreflang: 'pt', lang: 'pt', flag: '🇧🇷', label: 'Português' },
  enVersion && { href: `/en/${enVersion.slug}`, hreflang: 'en', lang: 'en', flag: '🇺🇸', label: 'English' },
  mxVersion && { href: `/mx/${mxVersion.slug}`, hreflang: 'es-MX', lang: 'es-MX', flag: '🇲🇽', label: 'México' },
  esVersion && { href: `/es/${esVersion.slug}`, hreflang: 'es-ES', lang: 'es-ES', flag: '🇪🇸', label: 'España' },
].filter(Boolean) as { href: string; hreflang: string; lang: string; flag: string; label: string }[];
---

<Layout
  title={calc.title}
  description={calc.description}
  schema={schema}
  audience={audience}
  image={ogImage}
  hreflang={hreflangTags}
  canonical={calc.canonicalSlug ? `/${calc.canonicalSlug}` : undefined}
  noindex={calc.noindex === true}
>
  <Header slot="header" />

  <CalcLayoutV2 calc={calc} dataAsOf={_dataAsOf ?? undefined} />

  <ScrollToTop />

  <Footer slot="footer" />
</Layout>
