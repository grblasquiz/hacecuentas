// Si no, omitimos el campo del schema (JSON.stringify ignora undefined).
// Fechas uniformes hardcodeadas son señal de scaled content para Google.
const _rawDatePub = calc.datePublished;
const datePublished: string | undefined = typeof _rawDatePub === 'string' && /^\d{4}-\d{2}-\d{2}(T.*)?$/.test(_rawDatePub)
  ? (_rawDatePub.length === 10 ? new Date(_rawDatePub + 'T00:00:00Z').toISOString() : _rawDatePub)
  : undefined;

// audience: código país ISO o 'global'. Default histórico: 'global'.
type AudienceCode = 'AR' | 'MX' | 'CL' | 'CO' | 'ES' | 'BO' | 'PE' | 'UY' | 'BR' | 'global';
const VALID_AUDIENCES: AudienceCode[] = ['AR','MX','CL','CO','ES','BO','PE','UY','BR','global'];
const rawAudience = calc.audience;
// Normalizar casing: "ar"→"AR", "Global"→"global". Evita que un código mal tipeado
// se degrade en silencio a 'global' y pierda el geo/locale del país.
const normAudience = typeof rawAudience === 'string'
  ? (rawAudience.toLowerCase() === 'global' ? 'global' : rawAudience.toUpperCase())
  : 'global';
const audience: AudienceCode = (VALID_AUDIENCES as string[]).includes(normAudience)
  ? (normAudience as AudienceCode)
  : 'global';
const schemaLang = audience === 'AR' ? 'es-AR' : audience === 'MX' ? 'es-MX' : audience === 'CL' ? 'es-CL' : audience === 'CO' ? 'es-CO' : audience === 'ES' ? 'es-ES' : audience === 'BR' ? 'pt-BR' : 'es';

// Country badge metadata (flag + tooltip + currency). Mostrado al lado del h1.
const COUNTRY_META: Record<AudienceCode, { flag: string; tooltip: string; currency: string }> = {
  AR:     { flag: '🇦🇷', tooltip: 'Datos Argentina (ARCA/ANSES)',          currency: 'ARS' },
  MX:     { flag: '🇲🇽', tooltip: 'Datos México (SAT/IMSS)',                currency: 'MXN' },
  CL:     { flag: '🇨🇱', tooltip: 'Datos Chile (SII/AFP)',                  currency: 'CLP' },
  CO:     { flag: '🇨🇴', tooltip: 'Datos Colombia (DIAN)',                  currency: 'COP' },
  ES:     { flag: '🇪🇸', tooltip: 'Datos España (IRPF/Hacienda)',           currency: 'EUR' },
  BO:     { flag: '🇧🇴', tooltip: 'Datos Bolivia',                          currency: 'BOB' },
  PE:     { flag: '🇵🇪', tooltip: 'Datos Perú (SUNAT)',                     currency: 'PEN' },
  UY:     { flag: '🇺🇾', tooltip: 'Datos Uruguay (DGI/BPS)',                currency: 'UYU' },
  BR:     { flag: '🇧🇷', tooltip: 'Datos Brasil (Receita Federal)',         currency: 'BRL' },
  global: { flag: '🌎', tooltip: 'Aplica globalmente (sin localizar a país)', currency: 'USD' },
};
const countryBadge = COUNTRY_META[audience];
// Nombre display por país para el aviso de jurisdicción (#25 — generalizado a todos los países, no solo AR).
const COUNTRY_NAME: Record<AudienceCode, string> = {
  AR: 'Argentina', MX: 'México', CL: 'Chile', CO: 'Colombia', ES: 'España',
  BO: 'Bolivia', PE: 'Perú', UY: 'Uruguay', BR: 'Brasil', global: 'tu país',
};

// Citas estructuradas para LLMs/Copilot: objeto CreativeWork con url+name+date+publisher
// (en vez de strings sueltos) → las IAs validan fuente y fecha antes de citar.
const citationLd = (calc.sources || [])
  .map((s: any) => {
    if (!s || (!s.url && !s.name)) return null;
    const o: any = { '@type': 'CreativeWork', name: s.name || s.url };
    if (s.url) o.url = s.url;
    if (s.date) o.datePublished = String(s.date);
    if (s.publisher) o.publisher = { '@type': 'Organization', name: s.publisher };
    return o;
  })
  .filter(Boolean);

/**
 * Description "safe" para schemas structured data. Google Rich Results exige
 * longitud mínima (~50 chars) en varios tipos (Dataset, SoftwareApplication,
 * Article); descriptions cortas caen como "La longitud de cadena del campo
 * description no es válida" en Search Console.
 *
 * Estrategia: partir de calc.description, y si es corta completar con h1,
 * keyTakeaway y category label — contenido real, no padding artificial.
 * Cap a 500 chars para no inflar el HTML innecesariamente.
 */
function buildSchemaDescription(c: any): string {
  const base = (c.description || '').trim();
  if (base.length >= 50) return base.slice(0, 500);
  const parts = [base];
  if (c.h1) parts.push(c.h1);
  if (c.keyTakeaway) parts.push(String(c.keyTakeaway).replace(/\*\*/g, ''));
  const catLabel = categoryLabels[c.category] || c.category;
  if (catLabel) parts.push(`Categoría: ${catLabel}.`);
  const merged = parts.filter(Boolean).join(' — ').trim();
  return (merged.length >= 50 ? merged : `${merged} Calculadora gratis, sin registro, resultado inmediato.`).slice(0, 500);
}
const schemaDescription = buildSchemaDescription(calc);

// Featured Snippet description: prioridad answerSnippet > keyTakeaway > schemaDescription.
// Se inyecta en Article/SoftwareApplication.description para que Google use ese texto
// como base del featured snippet (Position 0). Strip markdown bold/italic para evitar
// que `**` aparezcan literales en SERP. Cap a 500 chars (límite seguro Article schema).
function stripMd(s: string): string {
  return String(s || '')
    .replace(/\*\*(.+?)\*\*/g, '$1')
    .replace(/\*(.+?)\*/g, '$1')
    .replace(/`([^`\n]+)`/g, '$1')
    .replace(/\[(.+?)\]\(.+?\)/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
}
const snippetDescription = (() => {
  const candidate = calc.answerSnippet || calc.keyTakeaway || schemaDescription;
  const stripped = stripMd(candidate);
  return (stripped.length >= 50 ? stripped : schemaDescription).slice(0, 500);
})();

// HowTo schema: dejó de emitirse (Google lo deprecó en 2023, sin rich results).
// Se removieron también la extracción de pasos y el fallback de fields que sólo
// lo alimentaban a él.

const schemaFAQ = calc.faq && calc.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `https://hacecuentas.com/${calc.slug}#faq`,
  url: `https://hacecuentas.com/${calc.slug}`,
  inLanguage: schemaLang,
  ...(datePublished ? { datePublished } : {}),
  dateModified,
  about: categoryLabels[calc.category] || calc.category,
  author: { '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person' },
  publisher: { '@id': 'https://hacecuentas.com/#organization' },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: FAQ_SPEAKABLE_SELECTORS,
  },
  mainEntity: calc.faq.map((f: any, i: number) => ({
    '@type': 'Question',
    '@id': `https://hacecuentas.com/${calc.slug}#faq-${i + 1}`,
    name: f.q,
    answerCount: 1,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
      inLanguage: schemaLang,
      author: { '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person' },
      url: `https://hacecuentas.com/${calc.slug}#faq-${i + 1}`,
    },
  })),
} : null;

// Guía pilar del tema (hub) para link contextual de SEO.
// resolveGuideSlug: override manual → patrón de slug (guías AR) → categoría.
// Insertamos el crumb de guía SÓLO cuando difiere del default de la categoría:
// evita "Salud / Salud y fitness" redundante, pero enriquece monotributo→Impuestos,
// aguinaldo/indemnización→Sueldos, jubilación→ANSES (las páginas de plata cross-category).
const pillarGuideSlug: string | null = resolveGuideSlug(calc);
