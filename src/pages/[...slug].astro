  'mundial-bonus': MundialBonusJugadorMockup,
  'generacion': GeneracionMockup,
  'transfer-auto': TransferAutoMockup,
  'costo-m2': CostoM2ConstruccionMockup,
  'monotributo': MonotributoMockup,
  'sueldo-mano': SueldoEnManoMockup,
  'imc-infantil': ImcInfantilPercentilMockup,
  'embarazo': EmbarazoMockup,
  'bebidas': BebidasEventoMockup,
  'resistencia': ResistenciaColoresMockup,
  'mundial-goles': MundialGolesArgMockup,
  'interes-compuesto': InteresCompuestoMockup,
  'ladrillos': LadrillosM2Mockup,
  'plazo-fijo': PlazoFijoMockup,
};
const MockupComp = mockupBatch ? MOCKUP_COMPONENTS[mockupBatch] : null;
// metros-lineales usa una lista de relacionadas curada, no la del JSON.
const mockupRelated = mockupBatch === 'metros-lineales' ? mtlRelated : mbRelated;

const PESO_PERRO_FLAGSHIP = new Set([
  'calculadora-peso-ideal-pitbull',
  'calculadora-peso-ideal-rottweiler',
  'calculadora-peso-ideal-yorkshire-terrier',
]);
const isPesoPerro = PESO_PERRO_FLAGSHIP.has(calc.slug);
const ppRelated = isPesoPerro
  ? (calc.relatedSlugs || []).map((s: string) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isImpresion3d = calc.slug === 'calculadora-costo-impresion-3d-pieza';
const i3Related = isImpresion3d
  ? ['calculadora-filamento-3d-necesario-modelo', 'calculadora-precio-hora-servicio-3d', 'calculadora-tiempo-impresion-3d-layer']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isCombustibleViaje = calc.slug === 'calculadora-combustible-viaje-auto';
const vcRelated = isCombustibleViaje
  ? ['calculadora-consumo-nafta-litros-100km', 'calculadora-costo-peaje-ruta', 'calculadora-split-gastos-grupo-amigos']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isConversorLatam = calc.slug === 'conversor-moneda-dolar-peso-real-latam';
const cmRelated = isConversorLatam
  ? ['conversor-dolar-argentina', 'calculadora-dolar-blue-vs-oficial-brecha', 'conversor-dolar-euro-pesos-argentinos']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isMillasLatam = calc.slug === 'calculadora-millas-latam-destino';
// mlatamRelated (no mlRelated): `mlRelated` ya lo usa isMetrosLineales más arriba.
const mlatamRelated = isMillasLatam
  ? ['calculadora-valor-millas-punto-centavos', 'calculadora-puntos-vs-cash-vuelo-cuando-conviene', 'calculadora-millas-american-aa-destino']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isImcPediatrico = calc.slug === 'calculadora-indice-masa-corporal-pediatrico';
// OJO: `calculadora-imc-infantil-percentil` y `calculadora-percentil-peso-bebe-oms-edad-meses`
// están RESTRINGIDAS (content-policy) → fuera de relacionadas aunque el JSON las liste.
const ipRelated = isImcPediatrico
  ? ['calculadora-imc', 'calculadora-peso-ideal', 'calculadora-imc-adultos-mayores-edad-tabla']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isCaloriasTdee = calc.slug === 'calculadora-calorias-diarias-tdee';
const tdRelated = isCaloriasTdee
  ? ['calculadora-imc', 'calculadora-peso-ideal', 'calculadora-porcentaje-grasa-corporal']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isFondoDesempleo = calc.slug === 'calculadora-fondo-desempleo-anses-monto-tiempo';
const fdRelated = isFondoDesempleo
  ? ['calculadora-fondo-emergencia-meses', 'calculadora-indemnizacion-despido', 'sueldo-en-mano-argentina']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isArtIndemnizacion = calc.slug === 'calculadora-art-indemnizacion-tabla-incapacidad-laboral-permanente';
const artRelated = isArtIndemnizacion
  ? ['calculadora-indemnizacion-despido', 'calculadora-fondo-desempleo-anses-monto-tiempo', 'sueldo-en-mano-argentina']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isParitariaUocra = calc.slug === 'calculadora-paritaria-uocra-construccion-2026-categoria';
const uoRelated = isParitariaUocra
  ? ['calculadora-costo-m2-construccion-argentina', 'sueldo-en-mano-argentina', 'calculadora-aguinaldo-sac']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isIndemDespido = calc.slug === 'calculadora-indemnizacion-despido';
const ixRelated = isIndemDespido
  ? (calc.relatedSlugs || []).map((s: string) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isSueldoBrutoNeto = calc.slug === 'calculadora-sueldo-bruto-desde-neto';
const sbRelated = isSueldoBrutoNeto
  ? (calc.relatedSlugs || []).map((s: string) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isLiqRenuncia = calc.slug === 'calculadora-liquidacion-final-renuncia';
const lqRelated = isLiqRenuncia
  ? (calc.relatedSlugs || []).map((s: string) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isAguinaldoCasa = calc.slug === 'calculadora-aguinaldo-empleada-casa-particular-medio-tiempo-categoria';
const cpRelated = isAguinaldoCasa
  ? (calc.relatedSlugs || []).map((s: string) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isGananciasCuarta = calc.slug === 'calculadora-ganancias-empleados-4ta-categoria-2026';
const gcRelated = isGananciasCuarta
  ? ['calculadora-ganancias-aguinaldo-sac-retencion', 'sueldo-en-mano-argentina', 'calculadora-aguinaldo-sac']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
// OJO: el mockup "IVA incluido" matchea por título con `calculadora-iva-incluido-neto-discriminar`,
// pero el factor 21/121 = 0,17355 y el modo "Discriminar IVA" sólo existen en esta calc
// (formulaId `precio-iva`, archivo precio-iva.json). Es la correcta.
const isIvaAgregarDisc = calc.slug === 'calculadora-iva-agregar-discriminar';
const ivRelated = isIvaAgregarDisc
  ? ['calculadora-iva-incluido-neto-discriminar', 'calculadora-iva-saldo-favor-contra-ri', 'calculadora-monotributo-cuota-2026-todas-categorias']
      .map((s) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isInteresJudicial = calc.slug === 'calculadora-interes-judicial-tasa';
const ijRelated = isInteresJudicial
  ? (calc.relatedSlugs || []).map((s: string) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const isAportesPatronales = calc.slug === 'calculadora-aportes-patronales-empleado-registrado-cargas-sociales-2026';
const apRelated = isAportesPatronales
  ? (calc.relatedSlugs || []).map((s: string) => allCalcs.find((c: any) => c.slug === s)).filter(Boolean)
  : [];
const flagshipBespoke = !calcIsRestricted && (isDiasEntreFechas || isAguinaldoSac || isLifeMiles || isNumeroALetras || isPorcentajes
  || isConversorLatam || isMillasLatam || isImcPediatrico || isCaloriasTdee
  || isFondoDesempleo || isArtIndemnizacion || isParitariaUocra
  || isIndemDespido || isSueldoBrutoNeto || isLiqRenuncia || isAguinaldoCasa
  || isGananciasCuarta || isIvaAgregarDisc || isInteresJudicial || isAportesPatronales
  || isTempHorno || isMetrosLineales || isImpresion3d || isCombustibleViaje
  || isPesoPerro || !!mockupBatch);
// El mockup no usa el color de la categoría (viajes→life/cian): va rosa coral.
// Número a letras ya coincide (matematica→knowledge), no hace falta forzarlo.
// Porcentajes: el mockup va violeta, pero la categoría es vida→life (cian).
// Temperatura de horno → ámbar (cocina→life) · metros lineales → cian (construccion→home)
// · combustible → ámbar (viajes→life). Impresión 3D ya coincide (tecnologia→knowledge).
// Conversor LATAM: el mockup va esmeralda, pero la categoría es finanzas→money.
// Millas LATAM: el mockup va rosa/magenta, pero la categoría es viajes→life (cian).
// IMC pediátrico: el mockup va azul/violeta, pero la categoría es salud→health (rosa coral).
// TDEE: el mockup ya coincide (salud→health), no hace falta forzarlo.
// Los 3 de ANSES/laboral son finanzas→money, pero cada mockup usa otro color:
// fondo de desempleo → esmeralda, indemnización ART → rosa coral, UOCRA → ámbar.
const flagshipDomain: 'money' | 'data' | 'health' | 'home' | 'knowledge' | 'life' | null =
  isLifeMiles ? 'health' : isPorcentajes ? 'knowledge'
  : isTempHorno ? 'home' : isMetrosLineales ? 'life' : isCombustibleViaje ? 'home'
  : isConversorLatam ? 'data' : isMillasLatam ? 'health'
  : isImcPediatrico ? 'life'
  : isFondoDesempleo ? 'data' : isArtIndemnizacion ? 'health'
  : isParitariaUocra ? 'home'
  // Sueldos AR (finanzas→money), pero cada mockup usa otro color: indemnización por
  // despido → rojo/crimson, neto→bruto → esmeralda, aguinaldo casa particular → rosa.
  // Liquidación final por renuncia ya coincide (money/índigo), no hace falta forzarlo.
  : isIndemDespido ? 'health' : isSueldoBrutoNeto ? 'data'
  : isAguinaldoCasa ? 'health'
  // Impuestos/negocios AR: los 4 mockups tienen color propio y las 3 categorías
  // (impuestos / negocios / finanzas) mapean todas a money→índigo, así que van forzados:
  // Ganancias 4ta → violeta, IVA → esmeralda, interés judicial → violeta,
  // aportes patronales → esmeralda.
  : isGananciasCuarta ? 'knowledge' : isIvaAgregarDisc ? 'data'
  : isInteresJudicial ? 'knowledge' : isAportesPatronales ? 'data'
  : null;
---

<Layout
  title={calc.title}
  description={calc.description}
  schema={schema}
  audience={audience}
  image={ogImage}
  hreflang={hreflangTags}
  canonical={calc.canonicalSlug ? `/${calc.canonicalSlug}` : undefined}
  noindex={effectiveNoindex}
  noAds={!canAdvertiseCalc(calc)}
  domain={flagshipDomain || categoryDomain(calc.category)}
  pageType="calculator"
>
  <Header slot="header" />

  {!calcIsRestricted && <Fragment>
  {isDiasEntreFechas && <DiasEntreFechas calc={calc} related={diasRelated} />}
  {isAguinaldoSac && <AguinaldoSac calc={calc} related={agRelated} />}
  {isLifeMiles && <MillasLifeMilesMockup calc={calc} related={lmRelated} />}
  {isNumeroALetras && <NumeroALetras calc={calc} related={nlRelated} />}
  {isPorcentajes && <PorcentajesMockup calc={calc} related={pjRelated} />}
  {isTempHorno && <TemperaturaHornoFlagship calc={calc} related={thRelated} />}
  {isImpresion3d && <Impresion3dFlagship calc={calc} related={i3Related} />}
  {isPesoPerro && <PesoIdealPerroFlagship calc={calc} related={ppRelated} />}
  {MockupComp && <MockupComp calc={calc} related={mockupRelated} />}
  {isCombustibleViaje && <CombustibleViajeFlagship calc={calc} related={vcRelated} />}
  {isConversorLatam && <ConversorMonedaLatam calc={calc} related={cmRelated} />}
  {isMillasLatam && <MillasLatamMockup calc={calc} related={mlatamRelated} />}
  {isImcPediatrico && <ImcPediatricoCdc calc={calc} related={ipRelated} />}
  {isCaloriasTdee && <CaloriasTdeeFlagship calc={calc} related={tdRelated} />}
  {isIndemDespido && <IndemnizacionDespido calc={calc} related={ixRelated} />}
  {isSueldoBrutoNeto && <SueldoBrutoDesdeNeto calc={calc} related={sbRelated} />}
  {isLiqRenuncia && <LiquidacionFinalRenuncia calc={calc} related={lqRelated} />}
  {isAguinaldoCasa && <AguinaldoCasaParticular calc={calc} related={cpRelated} />}
  {isFondoDesempleo && <FondoDesempleoAnses calc={calc} related={fdRelated} />}
  {isArtIndemnizacion && <ArtIndemnizacion calc={calc} related={artRelated} />}
  {isParitariaUocra && <ParitariaUocra calc={calc} related={uoRelated} />}
  {isGananciasCuarta && <GananciasCuartaCat calc={calc} related={gcRelated} />}
  {isIvaAgregarDisc && <IvaAgregarDiscriminarMockup calc={calc} related={ivRelated} />}
  {isInteresJudicial && <InteresJudicialTasa calc={calc} related={ijRelated} />}
  {isAportesPatronales && <AportesPatronales calc={calc} related={apRelated} />}
  </Fragment>}
  {!flagshipBespoke && <CalcLayoutV2 calc={calc} dataAsOf={_dataAsOf ?? undefined} />}
  {/* Los bloques de linking contextual (blog / tabla / Web Story) viven dentro
      de CalcLayoutV2; las bespoke no pasan por ahí y perdían el link. Un solo
      punto de montaje: cualquier mockup nuevo lo hereda. */}
  {flagshipBespoke && <CalcContextLinks calc={calc} />}

  {isMundialCalc && <WeekendPackCapture source="calculadora-mundial" />}

  <ScrollToTop />

  <Footer slot="footer" />
</Layout>
