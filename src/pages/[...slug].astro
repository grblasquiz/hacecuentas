    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--accent-strong);
    border: 1px solid var(--border);
  }
  .example-result {
    padding: 1rem 1.25rem;
    background:
      radial-gradient(circle at 0% 100%, color-mix(in srgb, var(--accent) 15%, transparent) 0%, transparent 60%),
      linear-gradient(135deg, var(--accent-soft) 0%, color-mix(in srgb, #a78bfa 12%, var(--accent-soft)) 100%);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    box-shadow: 0 2px 8px -4px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .example-result strong { color: var(--accent-strong); font-weight: 700; }

  /* Fuentes */
  .sources-box {
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .sources-box h2 {
    margin: 0 0 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .sources-box ul {
    margin: 0;
    padding-left: 1.25rem;
  }
  .sources-box li {
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    font-size: 0.9375rem;
  }
  .sources-box a {
    color: var(--accent);
    text-decoration: none;
  }
  .sources-box a:hover { text-decoration: underline; }

  /* E-E-A-T trust block */
  .trust-block {
    margin: 2.5rem 0;
    padding: 1.75rem 1.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .trust-block h2 {
    font-size: 1.1rem;
    margin: 0 0 1.25rem;
    color: var(--text);
    font-weight: 700;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }
  .trust-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: .9rem 1.1rem;
  }
  .trust-label {
    display: block;
    font-size: .72rem;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: .06em;
    font-weight: 700;
    margin-bottom: .4rem;
  }
  .trust-item p {
    margin: 0;
    font-size: .88rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .trust-item a { color: var(--accent); text-decoration: none; }
  .trust-item a:hover { text-decoration: underline; }

  /* Related contextual */
  .also-see {
    margin-top: 3rem;
  }
  .also-see h2 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
  .also-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }
  .also-card {
    display: flex;
    gap: 0.875rem;
    padding: 1rem 1.125rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.2s, background 0.15s;
    position: relative;
    overflow: hidden;
  }
  .also-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 8%, transparent) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .also-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    transform: translateY(-3px);
    box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--accent) 28%, transparent);
    text-decoration: none;
  }
  .also-card:hover::before { opacity: 1; }
  .also-card:hover .also-icon {
    transform: scale(1.08) rotate(-3deg);
    background: linear-gradient(135deg, var(--accent-soft) 0%, color-mix(in srgb, #a78bfa 20%, var(--accent-soft)) 100%);
  }
  .also-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.375rem;
    transition: transform 0.2s, background 0.2s;
  }
  .also-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.125rem; }
  .also-title { font-weight: 600; font-size: 0.9375rem; line-height: 1.3; }
  .also-desc { font-size: 0.75rem; color: var(--text-subtle); line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA back */
  .calc-downloads {
    margin: 1.5rem 0 2rem;
    padding: 1rem 1.125rem;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.06), rgba(14, 165, 233, 0.02));
    border: 1px solid rgba(14, 165, 233, 0.25);
    border-radius: var(--radius);
  }
  :root[data-theme="dark"] .calc-downloads {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(56, 189, 248, 0.03));
    border-color: rgba(56, 189, 248, 0.28);
  }
  .calc-downloads-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .calc-downloads-icon { font-size: 1.125rem; }
  .calc-downloads-list {
    display: grid;
    gap: 0.5rem;
  }
  .calc-download-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    text-decoration: none;
    transition: all 0.15s ease-out;
  }
  .calc-download-item:hover {
    border-color: #0ea5e9;
    background: rgba(14, 165, 233, 0.05);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .calc-download-label {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .calc-download-desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .guide-link-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: linear-gradient(135deg, rgba(37,99,235,0.07), rgba(37,99,235,0.02));
    border: 1px solid rgba(37,99,235,0.25);
    border-radius: var(--radius);
    flex-wrap: wrap;
  }
  :root[data-theme="dark"] .guide-link-cta {
    background: linear-gradient(135deg, rgba(96,165,250,0.08), rgba(96,165,250,0.03));
    border-color: rgba(96,165,250,0.28);
  }
  .guide-link-icon { font-size: 1.8rem; flex-shrink: 0; }
  .guide-link-body { flex: 1; min-width: 240px; display: flex; flex-direction: column; gap: 0.15rem; }
  .guide-link-eyebrow {
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--accent-strong); font-weight: 700;
  }
  .guide-link-body strong { font-size: 1.0625rem; color: var(--text); font-weight: 700; }
  .guide-link-desc { color: var(--text-muted); font-size: 0.875rem; }
  .guide-link-btn {
    padding: 0.5rem 1rem; border-radius: var(--radius-sm);
    background: var(--accent); color: var(--bg);
    font-weight: 600; font-size: 0.9375rem; text-decoration: none;
    white-space: nowrap;
  }
  .guide-link-btn:hover { background: var(--accent-strong); }
  @media (max-width: 640px) {
    .guide-link-btn { width: 100%; text-align: center; }
  }

  .cta-back {
    margin-top: 3.5rem;
    padding: 1.75rem;
    background: var(--accent-soft);
    border: 1px solid #dbeafe;
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .cta-back p {
    margin: 0 0 0.75rem;
    color: var(--accent-strong);
    font-weight: 500;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1.125rem;
    background: var(--bg);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all 0.15s;
  }

  .btn-ghost:hover {
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
  }

  /* Layout con TOC sticky lateral */
  .calc-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  .calc-main { min-width: 0; }

  @media (min-width: 1100px) {
    .calc-page { max-width: 1080px; }
    .calc-layout { grid-template-columns: 220px minmax(0, 1fr); align-items: flex-start; }
    .toc {
      position: sticky;
      top: 90px;
      align-self: flex-start;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
    }
  }

  .toc {
    padding: 1rem 1.125rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .toc-title {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.625rem;
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .toc-list a {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    line-height: 1.35;
    transition: background 0.12s, color 0.12s;
    border-left: 2px solid transparent;
  }
  .toc-list a:hover { background: var(--bg); color: var(--text); }
  .toc-list a.active {
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 1099px) {
    /* En mobile ocultamos el TOC para que la calculadora aparezca arriba del fold.
       Las secciones son pocas y la navegación vertical scroll alcanza. */
    .toc { display: none; }
  }

  /* Calc actions: thumbs + share + reportar */
  .calc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.5rem;
    padding: 0.875rem 1.125rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .ca-feedback {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }
  .ca-q { font-size: 0.875rem; color: var(--text-muted); font-weight: 500; }
  .ca-msg { font-size: 0.875rem; color: var(--text-muted); }
  .ca-msg a { color: var(--accent); text-decoration: underline; }
  .ca-buttons { display: inline-flex; gap: 0.375rem; }
  .ca-vote {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    padding: 0.375rem 0.75rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }
  .ca-vote:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
  .ca-tools { display: inline-flex; gap: 0.375rem; flex-wrap: wrap; }
  .ca-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    padding: 0.375rem 0.75rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
    transition: all 0.15s;
  }
  .ca-tool:hover {
    border-color: var(--text-subtle);
    color: var(--text);
    background: var(--bg-soft);
  }

  /* KaTeX overrides leves */
  .explanation :global(.katex-display) {
    margin: 1rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0;
  }
  .explanation :global(.katex) {
    font-size: 1em;
  }

  @media (max-width: 640px) {
    .explanation { padding: 1.5rem 1.25rem; }
    .header-left { flex-direction: row; }
    .icon-wrap { width: 48px; height: 48px; font-size: 1.5rem; }
    .calc-actions { flex-direction: column; align-items: stretch; }
    .ca-feedback, .ca-tools { justify-content: center; }
  }

  .fab-recalc {
    display: none;
  }
  @media (max-width: 1099px) {
    .fab-recalc {
      display: none; /* JS controls via hidden attr */
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      z-index: 50;
      padding: 0.625rem 1rem;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 999px;
      font-size: 0.8125rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
      align-items: center;
      gap: 0.375rem;
      transition: all 0.2s;
      font-family: inherit;
    }
    .fab-recalc:not([hidden]) {
      display: inline-flex;
    }
    .fab-recalc:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.5);
    }
  }

  .cta-suggest {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .cta-suggest a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
  }

  /* ============================================================
   * REDISEÑO V4 (2026-05-21): cada section como card + quick-nav + mobile bar
   * Aplica overrides al final para máxima precedencia.
   * ============================================================ */

  /* Quick-nav pills (sticky después de la calc) */
  .calc-quick-nav {
    position: sticky;
    top: 64px;
    z-index: 30;
    margin: 1rem -0.25rem 1.25rem;
    padding: 0.625rem 0.25rem;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .calc-quick-nav-track {
    display: flex;
    gap: 0.375rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2px 0;
  }
  .calc-quick-nav-track::-webkit-scrollbar { display: none; }
  .calc-quick-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 99px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }
  .calc-quick-nav-pill:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }
  .calc-quick-nav-pill.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  html[data-theme="dark"] .calc-quick-nav-pill.active { color: var(--bg); }
  .calc-quick-nav-icon { font-size: 0.95em; line-height: 1; }

  /* Section cards — cada section principal como card visual */
  .calc-main > section[id="cuando-usar"],
  .calc-main > section[id="ejemplo"],
  .calc-main > section[id="casos-resueltos"],
  .calc-main > section[id="como-funciona"],
  .calc-main > section[id="faq"],
  .calc-main > section[id="fuentes"],
  .calc-main > section[id="metodologia"],
  .calc-main > section.also-see {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 2rem 1.875rem 1.625rem;
    margin: 0.875rem 0;
    box-shadow: var(--shadow-sm);
    scroll-margin-top: 130px;
    position: relative;
    overflow: visible;
  }
  /* Banda gradient top */
  .calc-main > section[id="cuando-usar"]::before,
  .calc-main > section[id="ejemplo"]::before,
  .calc-main > section[id="casos-resueltos"]::before,
  .calc-main > section[id="como-funciona"]::before,
  .calc-main > section[id="faq"]::before,
  .calc-main > section[id="fuentes"]::before,
  .calc-main > section[id="metodologia"]::before,
  .calc-main > section.also-see::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 50%, #7c3aed));
    border-radius: 18px 18px 0 0;
  }
  /* H2 con icon y eyebrow */
  .calc-main > section[id] > h2,
  .calc-main > section.also-see > h2,
  .calc-main > section[id="como-funciona"] > .explanation-header > h2 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    padding-top: 3.75rem;
    margin-bottom: 1rem;
    position: relative;
  }
  .calc-main > section[id="como-funciona"] > .explanation-header {
    padding-top: 0;
    border-bottom: none;
    margin-bottom: 1rem;
  }
  .calc-main > section[id] > h2::before,
  .calc-main > section.also-see > h2::before,
  .calc-main > section[id="como-funciona"] > .explanation-header > h2::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent-soft), color-mix(in srgb, var(--accent-2) 12%, transparent));
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 400;
  }
  /* Eyebrow uppercase encima del h2 (via ::after pero posicionado above) */
  .calc-main > section[id] > h2::after,
  .calc-main > section.also-see > h2::after,
  .calc-main > section[id="como-funciona"] > .explanation-header > h2::after {
    position: absolute;
    top: 0.625rem;
    left: 3.625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    line-height: 1;
  }
  /* Icons + eyebrows por section */
  #cuando-usar > h2::before { content: "💡"; }
  #cuando-usar > h2::after { content: "Cuándo usarla"; }
  #ejemplo > h2::before { content: "📋"; }
  #ejemplo > h2::after { content: "Ejemplo práctico"; }
  #casos-resueltos > h2::before { content: "📊"; }
  #casos-resueltos > h2::after { content: "Casos resueltos"; }
  #como-funciona > .explanation-header > h2::before { content: "🧠"; }
  #como-funciona > .explanation-header > h2::after { content: "Cómo funciona"; }
  #faq > h2::before { content: "💬"; }
  #faq > h2::after { content: "Preguntas frecuentes"; }
  #fuentes > h2::before { content: "📚"; }
  #fuentes > h2::after { content: "Fuentes verificables"; }
  #metodologia > h2::before { content: "🛡️"; }
  #metodologia > h2::after { content: "Confianza y metodología"; }
  .also-see > h2::before { content: "🔗"; }
  .also-see > h2::after { content: "Relacionadas"; }

  /* Override: en como-funciona el h2 está dentro de .explanation-header */
  #como-funciona { padding-top: 2rem; }

  /* Mobile: padding más chico para las cards */
  @media (max-width: 720px) {
    .calc-main > section[id="cuando-usar"],
    .calc-main > section[id="ejemplo"],
    .calc-main > section[id="casos-resueltos"],
    .calc-main > section[id="como-funciona"],
    .calc-main > section[id="faq"],
    .calc-main > section[id="fuentes"],
    .calc-main > section[id="metodologia"],
    .calc-main > section.also-see {
      padding: 1.5rem 1.125rem 1.25rem;
      border-radius: 14px;
    }
    .calc-main > section[id] > h2,
    .calc-main > section.also-see > h2,
    .calc-main > section[id="como-funciona"] > .explanation-header > h2 {
      font-size: 1.25rem;
      padding-top: 3.25rem;
    }
    .calc-main > section[id] > h2::before,
    .calc-main > section.also-see > h2::before,
    .calc-main > section[id="como-funciona"] > .explanation-header > h2::before {
      width: 38px;
      height: 38px;
      font-size: 1.25rem;
    }
    .calc-main > section[id] > h2::after,
    .calc-main > section.also-see > h2::after,
    .calc-main > section[id="como-funciona"] > .explanation-header > h2::after {
      left: 3.125rem;
    }
  }

  /* Override quick-nav top en mobile (no hay header sticky) */
  @media (max-width: 720px) {
