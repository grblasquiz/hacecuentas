// Dataset schema — RESTRINGIDO a calcs con datos vivos (auto-api / auto-scrape).
// Schema.org/Dataset es para CONJUNTOS DE DATOS CURADOS (escala ARCA, tasas
// BCRA, IPC INDEC, etc.), no para cualquier calc con tabla en explanation.
// Google puede flaggear Dataset overuse como schema padding (señal HCU).
// Antes: hasTable disparaba Dataset en ~700+ calcs (falso positivo).
// Ahora: solo las ~45 calcs con dataUpdate de fuentes oficiales en vivo.
const isLiveDataCalc =
  calc.dataUpdate?.updateType === 'auto-api' ||
  calc.dataUpdate?.updateType === 'auto-scrape';
const hasTable = calc.explanation && /\|.*\|.*\n\|[-:\s|]+\|/.test(calc.explanation);
if (isLiveDataCalc && hasTable) {
  // temporalCoverage: período al que aplican los datos. Para calcs con
  // dataUpdate.lastUpdated lo usamos como inicio; el fin queda abierto.
  const tempStart = (calc.dataUpdate?.lastUpdated || (datePublished || dateModified).split('T')[0]);
  const datasetKeywords: string[] = [
    categoryLabels[calc.category] || calc.category,
    ...(calc.seoKeywords || []).slice(0, 8),
  ].filter(Boolean);
  schemaGraph.push({
    '@type': 'Dataset',
    name: `${calc.h1} — Datos y tablas de referencia`,
    description: schemaDescription,
    url: `https://hacecuentas.com/${calc.slug}`,
    inLanguage: schemaLang,
    creator: {
      '@type': 'Organization',
      name: 'Hacé Cuentas',
      url: 'https://hacecuentas.com',
    },
    dateModified,
    temporalCoverage: `${tempStart}/`,  // ISO 8601 open-ended interval (slash sin terminador, per schema.org)
    keywords: datasetKeywords,
    license: 'https://creativecommons.org/licenses/by/4.0/',
  });
}

