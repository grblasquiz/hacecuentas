  .intro {
    font-size: 1.0625rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .intro :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  /* Badge AR en H1 */
  .ar-badge-h1 {
    display: inline-block;
    margin-left: 0.4em;
    font-size: 0.7em;
    vertical-align: 0.15em;
    line-height: 1;
  }

  /* Lang switcher — visible ES→PT/EN/MX/ES: mueve "link juice" interno y
     da descubrimiento al usuario. Aparece sólo si existe versión en otros
     locales. */
  .lang-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: -0.75rem 0 1.25rem;
    padding: 0.5rem 0.75rem;
