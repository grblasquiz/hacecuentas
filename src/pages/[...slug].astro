      linear-gradient(135deg, var(--accent-soft) 0%, color-mix(in srgb, #a78bfa 20%, var(--accent-soft)) 100%);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--accent) 15%, transparent),
      0 6px 18px -6px color-mix(in srgb, var(--accent) 35%, transparent),
      inset 0 1px 0 rgba(255,255,255,0.5);
    position: relative;
  }
  .icon-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    pointer-events: none;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.375rem;
    padding: 0.25rem 0.625rem;
