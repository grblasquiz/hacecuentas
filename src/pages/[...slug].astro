const includeGuideCrumb: boolean = !!pillarGuideSlug && !!pillarGuideTitle && pillarGuideSlug !== CATEGORY_TO_GUIDE[calc.category];

const breadcrumbCrumbs: Array<{ name: string; item?: string; description?: string }> = [
  {
    name: 'Inicio',
    item: 'https://hacecuentas.com/',
    description: 'Calculadoras gratuitas para Argentina',
  },
  {
    name: categoryLabels[calc.category] || calc.category,
    item: `https://hacecuentas.com/categoria/${calc.category}`,
    description: `Calculadoras de ${categoryLabels[calc.category] || calc.category}`,
  },
  ...(includeGuideCrumb ? [{
    name: pillarGuideTitle as string,
    item: `https://hacecuentas.com/guia/${pillarGuideSlug}`,
    description: `Guía completa: ${pillarGuideTitle}`,
