---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustStrip from '../components/ui/TrustStrip.astro';
import bcraIndicesRaw from '../lib/bcra-indices.json';
import { getPlazoFijoTop } from '../lib/plazo-fijo';
import { ICL_VALORES, ICL_LAST_UPDATED } from '../lib/formulas/_bcra-icl';
import { fetchJSON } from '../lib/fetch-timeout';

const title = 'Valores BCRA Hoy: Dólar, Inflación, UVA, ICL y Tasas';
const description = 'Dashboard con dólar oficial, MEP, blue, CCL, tarjeta, UVA del día, inflación INDEC mensual y anual, ICL para alquileres y TNA plazo fijo. Datos oficiales BCRA/INDEC actualizados.';

// Fetch en build-time con fallbacks seguros
function safeFetch<T>(url: string, fallback: T): Promise<T> {
  return fetchJSON<T>(url, fallback, { headers: { 'User-Agent': 'hacecuentas.com/1.0' } });
}

type Dolar = { casa: string; nombre: string; compra: number; venta: number; fechaActualizacion: string };
type InflacionPoint = { fecha: string; valor: number };
type UvaPoint = { fecha: string; valor: number };

const dolares = await safeFetch<Dolar[]>('https://dolarapi.com/v1/dolares', []);
const inflacion = await safeFetch<InflacionPoint[]>('https://api.argentinadatos.com/v1/finanzas/indices/inflacion', []);
const uva = await safeFetch<UvaPoint[]>('https://api.argentinadatos.com/v1/finanzas/indices/uva', []);
const inflacionInteranual = await safeFetch<InflacionPoint[]>(
  'https://api.argentinadatos.com/v1/finanzas/indices/inflacionInteranual',
  []
);

// ── Tasas e índices del BCRA (API oficial v4.0) — la página rankea por "badlar
// hoy" / "tasa de referencia bcra" / "cer hoy" pero NO los mostraba. Sirve esas
// queries directo. Node acepta el cert BCRA sin flags. Fallback seguro a null.
// Tasas/índices BCRA (BADLAR, TAMAR, CER) + riesgo país: pre-fetcheados en build
// por scripts/fetch-bcra-indices.mjs. NO se fetchean acá porque el WAF del BCRA
// bloquea el SSR de Astro/Vite ("internal error; reference=…"); desde Node plano
// (el script de prebuild) responde 200. Ver el script.
type Punto = { valor: number; fecha: string; prev?: number | null; spark?: number[] } | null;
type DolarPunto = { venta: number; fecha: string; prev?: number | null; spark?: number[] } | null;
const bcraIndices = bcraIndicesRaw as {
  badlar: Punto; tamar: Punto; cer: Punto; riesgoPais: Punto;
  dolar?: Record<string, DolarPunto>;
};
const badlar = bcraIndices.badlar;
const tamar = bcraIndices.tamar;
const cer = bcraIndices.cer;
const riesgoPais = bcraIndices.riesgoPais;
const dolarHist = bcraIndices.dolar || {};

// Fecha de hoy (build) para detectar valores PUBLICADOS POR ADELANTADO: el BCRA
// publica el CER con ~10 días de anticipación, así que su "fecha" puede ser futura.
const todayStr = new Date().toISOString().slice(0, 10);
const isFutureDate = (s?: string) => !!s && s.slice(0, 10) > todayStr;

// Últimos valores
const dolarMap = Object.fromEntries(dolares.map((d) => [d.casa, d]));
const ultimoIpc = inflacion.at(-1);
const ultimaIpcAnual = inflacionInteranual.at(-1);
const ultimaUva = uva.at(-1);

// Formato
const fmtAr = (n: number) => new Intl.NumberFormat('es-AR', { maximumFractionDigits: 2 }).format(n);
const fmtDate = (s: string) => {
  if (!s) return '—';
  try {
    // Fechas 'YYYY-MM-DD' (sin hora) se parsean como UTC y, al pasarlas a hora
    // AR (UTC-3), retroceden un día (ej. CER 2026-07-15 mostraba 14/07). Forzamos
    // medianoche local para que el día quede exacto. Las ISO con hora van tal cual.
    const d = /^\d{4}-\d{2}-\d{2}$/.test(s) ? new Date(s + 'T00:00:00') : new Date(s);
    return d.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
  } catch {
    return s;
  }
};

const buildDate = new Date().toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' });

// Tarjetas dólar en orden deseado.
// Nota sobre dólar tarjeta: el Impuesto PAIS (30%) se dejó vencer el 22/12/2024.
// Desde entonces el recargo es sólo la percepción Ganancias/Bienes Personales del 30%.
// Antes de tocar este hint verificar última normativa AFIP vigente.
const dolarCards: { key: string; label: string; hint: string; isTaxed?: boolean; href: string; cta: string }[] = [
  { key: 'oficial', label: 'Dólar Oficial', hint: 'Cotización mayorista del BCRA', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
  { key: 'blue', label: 'Dólar Blue', hint: 'Paralelo informal (Parque Lezama, arbolitos)', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
  { key: 'bolsa', label: 'Dólar MEP', hint: 'MEP / Bolsa: AL30 en pesos vs AL30 en USD', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
  { key: 'contadoconliqui', label: 'Dólar CCL', hint: 'Contado con liqui: para girar al exterior', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
  { key: 'tarjeta', label: 'Dólar Tarjeta', hint: 'Oficial + 30% percepción Ganancias (PAIS derogado dic 2024)', isTaxed: true, href: '/conversor-dolar-argentina', cta: 'Calcular con recargo →' },
  { key: 'cripto', label: 'Dólar Cripto', hint: 'USDT promedio en exchanges', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
];

const builtAtISO = new Date().toISOString();

// Histórico mensual (último valor de cada mes) para tablas crawleables + long-tail.
function ultimoPorMes<T extends { fecha: string; valor: number }>(points: T[], n: number): T[] {
  const byMonth: Record<string, T> = {};
  for (const p of points) {
    if (!p?.fecha) continue;
    byMonth[p.fecha.slice(0, 7)] = p; // pisa: queda el último del mes
  }
  return Object.values(byMonth).slice(-n).reverse();
}
const mesLargo = (s: string) => {
  try { return new Date(s).toLocaleDateString('es-AR', { month: 'long', year: 'numeric' }); }
  catch { return s; }
};
const uvaHist = ultimoPorMes(uva, 12);     // UVA es serie diaria → tomamos fin de mes
const ipcHist = inflacion.slice(-6).reverse(); // inflación INDEC ya es mensual

// ── Sparklines SVG (polyline) a partir de series REALES ya en scope. No se
// inventan datos: si no hay ≥2 puntos, sparkline() devuelve null y no se pinta.
// Se toman los últimos ~30 puntos de la serie diaria de UVA y los últimos 12
// meses de inflación mensual (INDEC no publica diario).
function sparkline(values: number[], w = 88, h = 26): string | null {
  const v = values.filter((n) => typeof n === 'number' && isFinite(n));
  if (v.length < 2) return null;
  const min = Math.min(...v);
  const max = Math.max(...v);
  const span = max - min || 1;
  const step = w / (v.length - 1);
  const pad = 2; // margen vertical para que no se corte el trazo
  const pts = v
    .map((n, i) => {
      const x = (i * step).toFixed(1);
      const y = (h - pad - ((n - min) / span) * (h - pad * 2)).toFixed(1);
      return `${x},${y}`;
    })
    .join(' ');
  return pts;
}
const uvaSpark = sparkline(uva.slice(-30).map((p) => p.valor));
const uvaSparkUp = uva.length >= 2 ? uva[uva.length - 1].valor >= uva[uva.length - 30 >= 0 ? uva.length - 30 : 0].valor : true;
const ipcSpark = sparkline(inflacion.slice(-12).map((p) => p.valor));
const ipcSparkUp = inflacion.length >= 2 ? inflacion[inflacion.length - 1].valor >= inflacion[0].valor : false;

// ── Variación mes a mes (delta) para UVA e inflación — dato REAL de las series.
// La UVA sube ~siempre (indexada), así que su delta suele ser 'pos' visual pero
// aquí lo dejamos neutral: subir la UVA no es "bueno". La inflación SÍ es
// semántica: baja = verde (pos), sube = rojo (neg).
function pctDelta(cur?: number, prev?: number): string | null {
  if (cur == null || prev == null || prev === 0) return null;
  const d = ((cur / prev - 1) * 100);
  const s = d.toFixed(1).replace('.', ',');
  return (d >= 0 ? '+' : '') + s + '%';
}
const uvaPrevMes = uvaHist.length >= 2 ? uvaHist[1]?.valor : undefined; // uvaHist va del más nuevo al más viejo
const uvaDeltaMes = pctDelta(ultimaUva?.valor, uvaPrevMes);
const ipcPrev = inflacion.length >= 2 ? inflacion[inflacion.length - 2]?.valor : undefined;
const ipcDeltaPts = (ultimoIpc?.valor != null && ipcPrev != null)
  ? (() => { const d = ultimoIpc.valor - ipcPrev; return (d >= 0 ? '+' : '') + d.toFixed(1).replace('.', ',') + ' pts'; })()
  : null;
// Tono de la inflación: si el IPC del mes es menor que el previo → desaceleró (pos/verde).
const ipcDeltaTone: 'pos' | 'neg' | 'neutral' =
  (ultimoIpc?.valor != null && ipcPrev != null)
    ? (ultimoIpc.valor < ipcPrev ? 'pos' : ultimoIpc.valor > ipcPrev ? 'neg' : 'neutral')
    : 'neutral';

// Plazo fijo: top tasas de bancos RECONOCIBLES (helper compartido, mismo filtro
// que /comparador-plazo-fijo — sin compañías financieras chicas).
const plazoFijoRows = await getPlazoFijoTop(14);
const pfMax = plazoFijoRows.length ? plazoFijoRows[0].tna : null;

const uvaHoy = ultimaUva ? `$${fmtAr(ultimaUva.valor)}` : 'el valor del día';
const ipcMensualTxt = ultimoIpc ? `${ultimoIpc.valor.toFixed(1)}%` : 'el último dato del INDEC';
const ipcAnualTxt = ultimaIpcAnual ? `${ultimaIpcAnual.valor.toFixed(1)}%` : 'el último interanual';

// ICL (Índice de Contratos de Locación) — ajuste de alquileres. Data oficial BCRA
// (serie diaria en _bcra-icl.ts). La exponemos acá para servir "ICL hoy / valor ICL".
const iclHoy = ICL_VALORES.at(-1) ?? null;
const iclFmt = iclHoy != null ? iclHoy.toLocaleString('es-AR', { minimumFractionDigits: 4, maximumFractionDigits: 4 }) : null;

const pct = (n: number) => `${n.toFixed(2).replace('.', ',')}%`;

// ── Enriquecido por tarjeta (D): sparkline + variación + acción. Helpers reales
// sobre las series ya en scope; si no hay ≥2 puntos, el sparkline no se pinta.
function sparkFrom(spark?: number[] | null): { pts: string | null; up: boolean } {
  if (!spark || spark.length < 2) return { pts: null, up: true };
  return { pts: sparkline(spark), up: spark[spark.length - 1] >= spark[0] };
}
// Variación firmada: pct → porcentaje; digits/suffix configurables (pts, pb…).
function deltaSigned(cur?: number | null, prev?: number | null, opts: { pct?: boolean; digits?: number; suffix?: string } = {}): string | null {
  if (cur == null || prev == null || prev === 0) return null;
  const raw = opts.pct ? (cur / prev - 1) * 100 : cur - prev;
  const digits = opts.digits ?? (opts.pct ? 1 : 2);
  const s = raw.toFixed(digits).replace('.', ',');
  return (raw >= 0 ? '+' : '') + s + (opts.pct ? '%' : (opts.suffix ? ' ' + opts.suffix : ''));
}

const iclSparkArr = ICL_VALORES.slice(-30) as number[];
const iclPrev = ICL_VALORES.length >= 2 ? ICL_VALORES.at(-2)! : null;

// Cards de tasas/índices BCRA (server-rendered, crawleables) — ahora con
// sparkline, variación, fuente, acción y aviso de valor anticipado (CER).
type TasaView = {
  label: string; value: string; sub: string; fecha: string;
  spark: number[] | null; prev: number | null; deltaKind: 'pct' | 'pts' | 'pb';
  href?: string; cta?: string; riskTone?: boolean;
};
const tasasBcra: TasaView[] = [
  badlar && { label: 'BADLAR', value: pct(badlar.valor), sub: 'Plazo fijo mayorista (>$1M), bancos privados', fecha: badlar.fecha, spark: badlar.spark ?? null, prev: badlar.prev ?? null, deltaKind: 'pts', href: '/calculadora-plazo-fijo', cta: 'Calcular plazo fijo →' },
  tamar && { label: 'TAMAR', value: pct(tamar.valor), sub: 'Tasa mayorista de referencia del BCRA', fecha: tamar.fecha, spark: tamar.spark ?? null, prev: tamar.prev ?? null, deltaKind: 'pts', href: '/calculadora-plazo-fijo', cta: 'Calcular plazo fijo →' },
  cer && { label: 'CER', value: fmtAr(cer.valor), sub: 'Coef. de Estabilización de Referencia (indexa la UVA)', fecha: cer.fecha, spark: cer.spark ?? null, prev: cer.prev ?? null, deltaKind: 'pct', href: '/calculadora-actualizacion-inflacion-ipc', cta: 'Actualizar por inflación →' },
  iclHoy != null && { label: 'ICL', value: iclFmt ?? '', sub: 'Índice de Contratos de Locación — ajuste de alquileres', fecha: ICL_LAST_UPDATED, spark: iclSparkArr, prev: iclPrev, deltaKind: 'pct', href: '/calculadora-actualizacion-alquiler-icl', cta: 'Actualizar alquiler →' },
  riesgoPais && { label: 'Riesgo país', value: `${Math.round(riesgoPais.valor)} pb`, sub: 'EMBI+ Argentina (puntos básicos)', fecha: riesgoPais.fecha, spark: riesgoPais.spark ?? null, prev: riesgoPais.prev ?? null, deltaKind: 'pb', riskTone: true },
].filter(Boolean) as TasaView[];

// Frase-resumen crawleable (AEO / featured snippet para "valores bcra hoy").
const resumenParts: string[] = [];
if (dolarMap.blue?.venta) resumenParts.push(`el dólar blue cotiza a $${fmtAr(dolarMap.blue.venta)}`);
if (dolarMap.oficial?.venta) resumenParts.push(`el oficial a $${fmtAr(dolarMap.oficial.venta)}`);
if (ultimaUva) resumenParts.push(`la UVA vale $${fmtAr(ultimaUva.valor)}`);
if (iclHoy != null) resumenParts.push(`el ICL para alquileres está en ${iclFmt}`);
if (ultimoIpc) resumenParts.push(`la inflación mensual fue ${ultimoIpc.valor.toFixed(1).replace('.', ',')}%`);
if (badlar) resumenParts.push(`la tasa BADLAR rinde ${pct(badlar.valor)} anual`);
if (riesgoPais) resumenParts.push(`y el riesgo país está en ${Math.round(riesgoPais.valor)} puntos`);
const resumen = resumenParts.length
  ? `Hoy en Argentina ${resumenParts.join(', ')}, según datos oficiales del BCRA e INDEC actualizados al ${buildDate}.`
  : '';

// ── Enriquecido del dólar por tarjeta (D): sparkline + variación diaria + fecha.
// venta live (dolarapi) para el número; spark/prev del histórico de build.
const dolarView: Record<string, { spark: number[] | null; delta: string | null; fecha: string }> = {};
for (const c of dolarCards) {
  const h = dolarHist[c.key];
  const venta = dolarMap[c.key]?.venta ?? h?.venta ?? null;
  dolarView[c.key] = {
    spark: h?.spark ?? null,
    delta: deltaSigned(venta, h?.prev, { pct: true }),
    fecha: dolarMap[c.key]?.fechaActualizacion || h?.fecha || '',
  };
}

// ── LECTURA EJECUTIVA (B): "qué mirar hoy". Insights computados de la data real,
// cada uno con a-quién-afecta y qué calculadora usar. Sin recomendación financiera.
const mercadoKeys = ['blue', 'bolsa', 'contadoconliqui', 'cripto'];
let topBrecha: { label: string; pct: number } | null = null;
for (const k of mercadoKeys) {
  const v = dolarMap[k]?.venta;
  const of = dolarMap.oficial?.venta;
  if (v && of) {
    const p = (v / of - 1) * 100;
    if (!topBrecha || p > topBrecha.pct) {
      topBrecha = { label: (dolarCards.find((c) => c.key === k)?.label || k).replace('Dólar ', ''), pct: p };
    }
  }
}
const execItems: { icon: string; html: string; href: string; cta: string }[] = [];
if (topBrecha) {
  execItems.push({
    icon: '💸',
    html: `El <strong>dólar ${topBrecha.label}</strong> marca la mayor brecha frente al oficial: <strong>+${topBrecha.pct.toFixed(1).replace('.', ',')}%</strong>. Es el número que miran quienes ahorran o giran divisas.`,
    href: '/conversor-dolar-argentina', cta: 'Convertir a mi cotización →',
  });
}
if (badlar && ultimaIpcAnual) {
  const gana = badlar.valor >= ultimaIpcAnual.valor;
  execItems.push({
    icon: gana ? '📈' : '📉',
    html: `La <strong>BADLAR</strong> mayorista rinde <strong>${pct(badlar.valor)}</strong> anual, ${gana ? 'por encima' : 'por debajo'} de la inflación interanual (<strong>${ipcAnualTxt}</strong>): un plazo fijo tradicional ${gana ? 'le gana' : 'pierde contra'} la inflación en términos nominales.`,
    href: '/calculadora-plazo-fijo', cta: 'Calcular mi plazo fijo →',
  });
}
if (ultimoIpc && ipcPrev != null && ipcDeltaPts) {
  const desac = ultimoIpc.valor < ipcPrev;
  execItems.push({
    icon: desac ? '🟢' : '🔴',
    html: `La <strong>inflación mensual</strong> del INDEC fue <strong>${ipcMensualTxt}</strong>, ${desac ? 'una desaceleración' : 'una aceleración'} frente al mes previo (${ipcDeltaPts}). Impacta alquileres, salarios y ahorros en pesos.`,
    href: '/calculadora-actualizacion-inflacion-ipc', cta: 'Actualizar un monto →',
  });
}
if (isFutureDate(cer?.fecha) && cer) {
  execItems.push({
    icon: '🗓️',
    html: `El <strong>CER</strong> ya tiene valor publicado por el BCRA para el <strong>${fmtDate(cer.fecha)}</strong> (${fmtAr(cer.valor)}): la UVA de esos días está anticipada. Útil si tenés un crédito o alquiler que ajusta por UVA/CER.`,
    href: '/calculadora-credito-uva-vs-tasa-fija', cta: 'Ver cuota UVA →',
  });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
    { '@type': 'ListItem', position: 2, name: 'Valores BCRA hoy', item: 'https://hacecuentas.com/valores-bcra' },
  ],
};

const faqs: { q: string; a: string }[] = [
  {
    q: '¿Cuánto vale el ICL hoy y cómo se ajusta un alquiler?',
    a: `El <strong>ICL (Índice de Contratos de Locación)</strong> del BCRA está en <strong>${iclFmt ?? 'el último dato'}</strong>${iclHoy != null ? ` al ${fmtDate(ICL_LAST_UPDATED)}` : ''}. Se publica a diario y combina 50% inflación (IPC) y 50% salarios (RIPTE). Para ajustar un alquiler se divide el ICL del día del ajuste por el del día de inicio del período; hacé la cuenta automática en la <a href="/calculadora-actualizacion-alquiler-icl">calculadora de actualización de alquiler por ICL</a>.`,
  },
  {
    q: '¿Cuánto vale la UVA hoy?',
    a: `La UVA (Unidad de Valor Adquisitivo) está en <strong>${uvaHoy}</strong>${ultimaUva ? ` al ${fmtDate(ultimaUva.fecha)}` : ''}, según el BCRA. La UVA se ajusta diariamente por el CER (que sigue a la inflación) con un rezago de unos 45 días, así que su valor sube prácticamente todos los días. La tabla de arriba muestra su evolución mes a mes.`,
  },
  {
    q: '¿Qué es la UVA y para qué se usa?',
    a: 'La <strong>UVA (Unidad de Valor Adquisitivo)</strong> es una unidad de cuenta creada por el BCRA en 2016 que se actualiza por inflación (índice CER). Equivalía a 1/1000 del costo de construcción de un metro cuadrado de vivienda. Se usa para indexar <strong>créditos hipotecarios UVA</strong>, <strong>plazos fijos UVA</strong> y algunos contratos, de modo que el capital mantenga su poder adquisitivo frente a la inflación.',
  },
  {
    q: '¿Cuál es la inflación de Argentina hoy?',
    a: `La última inflación mensual del INDEC (IPC Nacional) fue de <strong>${ipcMensualTxt}</strong> y la interanual (últimos 12 meses) de <strong>${ipcAnualTxt}</strong>. El INDEC publica el IPC alrededor del día 14 de cada mes con el dato del mes anterior. Arriba podés ver la serie de los últimos meses.`,
  },
  {
    q: '¿Qué diferencia hay entre dólar oficial, blue, MEP y CCL?',
    a: 'El <strong>oficial</strong> es la cotización regulada del BCRA. El <strong>blue</strong> es el paralelo informal (efectivo, sin factura). El <strong>MEP</strong> (dólar bolsa) surge de comprar un bono en pesos y venderlo en dólares en el país; es legal. El <strong>CCL</strong> (contado con liqui) es similar pero la liquidación queda en el exterior. La diferencia entre el blue/MEP y el oficial se llama <strong>brecha cambiaria</strong>.',
  },
  {
    q: '¿Por qué el dólar tarjeta es más caro que el oficial?',
    a: 'Históricamente el dólar tarjeta sumaba el Impuesto PAÍS (30%) más la percepción a cuenta de Ganancias (30%). En 2026 eso cambió: el <strong>Impuesto PAÍS está derogado</strong> (dic-2024) y la percepción del 30% sobre <strong>consumos directos en dólares se eliminó</strong> (ene-2026), así que una compra o suscripción en USD se liquida al oficial. El recargo del 30% (percepción recuperable) sólo sigue para <strong>servicios turísticos y de transporte al exterior pagados en pesos</strong> — es lo que refleja la cotización "tarjeta/turista".',
  },
  {
    q: '¿Cuánto rinde un plazo fijo hoy?',
    a: `Las tasas (TNA) de plazo fijo tradicional a 30 días van desde ~16% hasta <strong>${pfMax ? String(pfMax).replace('.', ',') + '%' : '~23%'}</strong> anual según el banco, como se ve en la tabla de arriba (ordenada de mayor a menor). Para saber cuánto cobrás en pesos por un monto y plazo concretos, usá la <a href="/calculadora-plazo-fijo">calculadora de plazo fijo</a> o compará bancos en el <a href="/comparador-plazo-fijo">comparador</a>.`,
  },
  {
    q: '¿Qué es la tasa BADLAR y cuánto está hoy?',
    a: `La <strong>BADLAR</strong> (Buenos Aires Deposits of Large Amount Rate) es la tasa promedio que pagan los bancos privados por plazos fijos mayoristas de más de un millón de pesos a 30-35 días. El BCRA la publica a diario y se usa como referencia para préstamos, UVA y contratos. Hoy la BADLAR de bancos privados está en <strong>${badlar ? pct(badlar.valor) : 'el último dato del BCRA'}</strong>${badlar ? ` (al ${fmtDate(badlar.fecha)})` : ''}. La <strong>TAMAR</strong>${tamar ? ` (${pct(tamar.valor)})` : ''} es la versión mayorista que el BCRA adoptó como tasa de referencia.`,
  },
  {
    q: '¿Cuál es el riesgo país de Argentina hoy?',
    a: `El <strong>riesgo país</strong> (índice EMBI+ de JP Morgan) mide la sobretasa que paga la deuda argentina frente a los bonos del Tesoro de EE.UU., en puntos básicos (100 pb = 1%). Hoy está en <strong>${riesgoPais ? Math.round(riesgoPais.valor) + ' puntos' : 'el último dato disponible'}</strong>${riesgoPais ? ` (al ${fmtDate(riesgoPais.fecha)})` : ''}. Cuanto más bajo, más confianza del mercado en que el país pagará su deuda y más cerca está de volver a financiarse en los mercados internacionales.`,
  },
  {
    q: '¿Cada cuánto se actualizan estos valores?',
    a: 'Las cotizaciones del dólar se <strong>refrescan en vivo</strong> al abrir la página (desde dolarapi.com, que consolida bancos y casas de cambio). La inflación y la UVA se actualizan con cada publicación oficial del INDEC y el BCRA. La fecha de cada dato figura debajo del valor.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Valores BCRA y INDEC hoy',
  description: 'Dólar oficial, blue, MEP, CCL y tarjeta; inflación INDEC mensual e interanual; UVA y tasas de plazo fijo de Argentina.',
  keywords: 'dolar hoy, dolar blue, inflación INDEC, UVA BCRA, valor uva hoy, plazo fijo TNA, valores BCRA, ICL hoy, valor ICL BCRA, coeficiente ICL alquiler',
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  license: 'https://hacecuentas.com/terminos',
  url: 'https://hacecuentas.com/valores-bcra',
  dateModified: builtAtISO,
  temporalCoverage: uvaHist.length ? `${uvaHist[uvaHist.length - 1].fecha}/${uvaHist[0].fecha}` : undefined,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://dolarapi.com/v1/dolares' },
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://api.argentinadatos.com/v1/finanzas/indices/uva' },
  ],
  variableMeasured: [
    dolarMap.blue?.venta && { '@type': 'PropertyValue', name: 'Dólar blue (venta)', value: dolarMap.blue.venta, unitText: 'ARS' },
    dolarMap.oficial?.venta && { '@type': 'PropertyValue', name: 'Dólar oficial (venta)', value: dolarMap.oficial.venta, unitText: 'ARS' },
    ultimaUva && { '@type': 'PropertyValue', name: 'UVA', value: ultimaUva.valor, unitText: 'ARS' },
    ultimoIpc && { '@type': 'PropertyValue', name: 'Inflación mensual IPC (INDEC)', value: ultimoIpc.valor, unitText: 'P1' },
    badlar && { '@type': 'PropertyValue', name: 'Tasa BADLAR bancos privados', value: badlar.valor, unitText: 'P1' },
    riesgoPais && { '@type': 'PropertyValue', name: 'Riesgo país (EMBI+)', value: Math.round(riesgoPais.valor), unitText: 'basis point' },
  ].filter(Boolean),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---
<Layout title={title} description={description} schema={schema} domain="data" pageType="dashboard">
  <Header slot="header" />

  <article class="dashboard">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Valores BCRA hoy</span>
    </nav>

    <header class="dash-head">
      <h1>Valores BCRA y INDEC hoy</h1>
      <p class="lead">Dólar oficial, blue, MEP y CCL, inflación INDEC, UVA y tasas de plazo fijo de Argentina, en un solo lugar.</p>
    </header>

    <!-- BARRA SUPERIOR DE DASHBOARD: estado en vivo + fuente + metodología -->
    <TrustStrip class="dash-bar">
      <span class="ui-trust__item dash-bar__live">
        <span class="live-dot" aria-hidden="true"></span>
        Cotizaciones en vivo · <time data-updated datetime={builtAtISO}>actualizado {buildDate}</time>
      </span>
      <span class="ui-trust__item">Fuente: BCRA · INDEC · dolarapi</span>
      <a class="ui-trust__item dash-bar__method" href="#fuentes">Ver metodología →</a>
    </TrustStrip>

    {resumen && <p class="vb-resumen">{resumen}</p>}

    <!-- LECTURA EJECUTIVA (B): qué mirar hoy — insights computados de la data,
         con a-quién-afecta y qué calculadora usar. Sin recomendación financiera. -->
    {execItems.length > 0 && (
      <section class="exec" aria-label="Qué mirar hoy">
        <div class="exec-head">
          <span class="exec-kicker">Lectura del día</span>
          <h2 class="exec-title">Qué mirar hoy · {buildDate}</h2>
        </div>
        <ul class="exec-list">
          {execItems.map((it) => (
            <li class="exec-item">
              <span class="exec-icon" aria-hidden="true">{it.icon}</span>
              <span class="exec-body">
                <span class="exec-text" set:html={it.html}></span>
                <a class="exec-cta" href={it.href}>{it.cta}</a>
              </span>
            </li>
          ))}
        </ul>
        <p class="exec-note">Lectura informativa de datos oficiales, no es recomendación de inversión.</p>
      </section>
    )}

    <!-- ÍNDICE DE ANCLAS (sticky) — navegación entre secciones sin ocultar
         contenido: TODO sigue en el HTML (crawleable), sólo hace scroll. -->
    <nav class="dash-tabs" aria-label="Secciones del dashboard">
      <a href="#dolar">Dólar</a>
      <a href="#inflacion">Inflación</a>
      <a href="#tasas">Tasas BCRA</a>
      <a href="#historico">UVA e IPC</a>
      <a href="#plazo-fijo">Plazo fijo</a>
      <a href="#alertas">Alertas</a>
    </nav>

    <!-- SECCIÓN DÓLAR -->
    <section class="dash-section" id="dolar">
      <h2>💵 Cotización del dólar</h2>
      <div class="card-grid">
        {dolarCards.map((c) => {
          const d = dolarMap[c.key];
          const venta = d?.venta;
          const brecha = venta && dolarMap.oficial?.venta ? ((venta / dolarMap.oficial.venta - 1) * 100).toFixed(1) : null;
          // Brecha cambiaria sólo tiene sentido para dólares de mercado (blue/MEP/CCL/cripto),
          // no para el tarjeta — ese "+30%" es el impuesto, no una brecha.
          const showBrecha = brecha && c.key !== 'oficial' && !c.isTaxed;
          const showTaxBadge = c.isTaxed && brecha;
          const view = dolarView[c.key];
          const sparkPts = view?.spark ? sparkline(view.spark) : null;
          const sparkUp = view?.spark && view.spark.length >= 2 ? view.spark[view.spark.length - 1] >= view.spark[0] : true;
          return (
            <div class="card">
              <div class="card-head">
                <span class="card-label">{c.label}</span>
                {showTaxBadge ? (
                  <span class="badge badge-tax" title="Recargo por percepción Ganancias, no brecha cambiaria">+{brecha}% impuesto</span>
                ) : view?.delta && (
                  <span class="delta delta-neutral" title="Variación vs el día anterior">{view.delta}</span>
                )}
              </div>
              <div class="card-value" data-dolar-key={c.key}>
                {venta ? `$${fmtAr(venta)}` : '—'}
              </div>
              {sparkPts && (
                <svg class={`spark spark-${sparkUp ? 'up' : 'down'}`} viewBox="0 0 88 26" width="88" height="26" preserveAspectRatio="none" aria-hidden="true" role="img">
                  <polyline points={sparkPts} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              <div class="card-sub">
                {d?.compra ? `Compra: $${fmtAr(d.compra)}` : c.hint}
              </div>
              {showBrecha ? (
                <div class="card-meta">
                  <span class="meta-label">Brecha vs oficial</span>
                  <span class="meta-val" data-brecha-key={c.key}>+{brecha}%</span>
                </div>
              ) : (
                <div class="card-hint">{c.hint}</div>
              )}
              <div class="card-foot">
                <span class="card-src">{view?.fecha ? `Al ${fmtDate(view.fecha)} · dolarapi` : 'Fuente: dolarapi'}</span>
                <a class="card-act" href={c.href}>{c.cta}</a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- SECCIÓN INFLACIÓN -->
    <section class="dash-section" id="inflacion">
      <h2>📈 Inflación (INDEC)</h2>
      <div class="card-grid">
        <div class="card hi">
          <div class="card-head">
            <span class="card-label">Inflación mensual</span>
            {ipcDeltaPts && (
              <span class={`delta delta-${ipcDeltaTone}`} title="Variación vs el mes anterior (puntos porcentuales)">{ipcDeltaPts}</span>
            )}
          </div>
          <div class="card-value" data-ipc-mensual>
            {ultimoIpc ? `${ultimoIpc.valor.toFixed(1)}%` : '—'}
          </div>
          {ipcSpark && (
            <svg class={`spark spark-${ipcSparkUp ? 'up' : 'down'}`} viewBox="0 0 88 26" width="88" height="26" preserveAspectRatio="none" aria-hidden="true" role="img">
              <polyline points={ipcSpark} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          <div class="card-sub">IPC Nacional · últimos 12 meses</div>
          <div class="card-hint">Último dato: {ultimoIpc ? fmtDate(ultimoIpc.fecha) : '—'}</div>
        </div>
        <div class="card hi">
          <div class="card-head">
            <span class="card-label">Inflación anual</span>
          </div>
          <div class="card-value" data-ipc-anual>
            {ultimaIpcAnual ? `${ultimaIpcAnual.valor.toFixed(1)}%` : '—'}
          </div>
          <div class="card-sub">Interanual (últimos 12m)</div>
          <div class="card-hint">Último dato: {ultimaIpcAnual ? fmtDate(ultimaIpcAnual.fecha) : '—'}</div>
        </div>
        <div class="card hi">
          <div class="card-head">
            <span class="card-label">UVA</span>
            {uvaDeltaMes && (
              <span class="delta delta-neutral" title="Variación vs el mes anterior">{uvaDeltaMes}</span>
            )}
          </div>
          <div class="card-value" data-uva>
            {ultimaUva ? `$${fmtAr(ultimaUva.valor)}` : '—'}
          </div>
          {uvaSpark && (
            <svg class={`spark spark-${uvaSparkUp ? 'up' : 'down'}`} viewBox="0 0 88 26" width="88" height="26" preserveAspectRatio="none" aria-hidden="true" role="img">
              <polyline points={uvaSpark} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          <div class="card-sub">Unidad de Valor Adquisitivo · últimos 30 días</div>
          <div class="card-hint">Al {ultimaUva ? fmtDate(ultimaUva.fecha) : '—'}</div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN TASAS E ÍNDICES BCRA -->
    {tasasBcra.length > 0 && (
      <section class="dash-section" id="tasas">
        <h2>🏛️ Tasas e índices del BCRA</h2>
        <div class="card-grid">
          {tasasBcra.map((t) => {
            const s = sparkFrom(t.spark);
            const cur = t.spark && t.spark.length ? t.spark[t.spark.length - 1] : null;
            const delta = t.deltaKind === 'pct'
              ? deltaSigned(cur, t.prev, { pct: true, digits: 2 })
              : t.deltaKind === 'pb'
                ? deltaSigned(cur, t.prev, { digits: 0, suffix: 'pb' })
                : deltaSigned(cur, t.prev, { digits: 2, suffix: 'pts' });
            // Riesgo país: bajar es "bueno" (verde); subir "malo" (rojo). El resto, neutral.
            const tone = t.riskTone && cur != null && t.prev != null
              ? (cur < t.prev ? 'pos' : cur > t.prev ? 'neg' : 'neutral')
              : 'neutral';
            const futuro = isFutureDate(t.fecha);
            return (
              <div class="card">
                <div class="card-head">
                  <span class="card-label">{t.label}</span>
                  {delta && (
                    <span class={`delta delta-${tone}`} title="Variación vs el dato anterior">{delta}</span>
                  )}
                </div>
                <div class="card-value" data-tasa={t.label === 'ICL' ? 'icl' : undefined}>{t.value}</div>
                {s.pts && (
                  <svg class={`spark spark-${s.up ? 'up' : 'down'}`} viewBox="0 0 88 26" width="88" height="26" preserveAspectRatio="none" aria-hidden="true" role="img">
                    <polyline points={s.pts} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                <div class="card-sub">{t.sub}</div>
                {futuro ? (
                  <div class="card-hint card-hint-future" title="El BCRA publica el CER con días de anticipación">📅 Valor publicado por el BCRA para el {fmtDate(t.fecha)}</div>
                ) : (
                  <div class="card-hint">Al {fmtDate(t.fecha)} · BCRA</div>
                )}
                {t.href && t.cta && (
                  <div class="card-foot">
                    <span class="card-src">Fuente: BCRA</span>
                    <a class="card-act" href={t.href}>{t.cta}</a>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- SECCIÓN HISTÓRICO UVA + INFLACIÓN -->
    <section class="dash-section" id="historico">
      <h2>📅 Evolución reciente: UVA e inflación mes a mes</h2>
      <div class="hist-grid">
        <div class="hist-block">
          <h3>Valor de la UVA por mes (BCRA)</h3>
          {uvaHist.length ? (
            <table class="hist-table">
              <thead><tr><th>Mes</th><th>UVA</th></tr></thead>
              <tbody>
                {uvaHist.map((p) => (
                  <tr><td>{mesLargo(p.fecha)}</td><td>{'$' + fmtAr(p.valor)}</td></tr>
                ))}
              </tbody>
            </table>
          ) : <p class="hist-empty">Datos no disponibles en este momento.</p>}
        </div>
        <div class="hist-block">
          <h3>Inflación mensual (IPC INDEC)</h3>
          {ipcHist.length ? (
            <table class="hist-table">
              <thead><tr><th>Mes</th><th>IPC</th></tr></thead>
              <tbody>
                {ipcHist.map((p) => (
                  <tr><td>{mesLargo(p.fecha)}</td><td>{p.valor.toFixed(1) + '%'}</td></tr>
                ))}
              </tbody>
            </table>
          ) : <p class="hist-empty">Datos no disponibles en este momento.</p>}
        </div>
      </div>
    </section>

    <!-- SECCIÓN PLAZO FIJO / TASAS -->
    <section class="dash-section" id="plazo-fijo">
      <h2>🏦 Plazo fijo: mejores TNA por banco{pfMax ? ` (hasta ${String(pfMax).replace('.', ',')}%)` : ''}</h2>
      {plazoFijoRows.length ? (
        <div class="tna-bars">
          {plazoFijoRows.map((x, i) => (
            <div class={`tna-row${i === 0 ? ' tna-row-top' : ''}`}>
              <span class="tna-bank">{x.banco}</span>
              <span class="tna-track" aria-hidden="true"><span class="tna-fill" style={`width:${Math.max(8, Math.round((x.tna / (pfMax || x.tna)) * 100))}%`}></span></span>
              <span class="tna-val" data-pf-top={i === 0 ? '' : undefined}>{String(x.tna).replace('.', ',')}%</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="hist-empty">Las tasas no están disponibles en este momento — miralas en el comparador.</p>
      )}
      <p class="tna-note">TNA para plazo fijo tradicional a 30 días, ordenadas de mayor a menor. Fuente: BCRA (vía argentinadatos), actualizado al {buildDate}. La tasa puede cambiar; confirmá la vigente en tu banco.</p>
      <p class="sec-cta">
        <a href="/comparador-plazo-fijo" class="cta-link">Ver comparador interactivo →</a>
        <a href="/plazo-fijo-vs-billeteras" class="cta-link">¿Y contra las billeteras? →</a>
        <a href="/calculadora-plazo-fijo" class="cta-link">Calculadora individual →</a>
      </p>
    </section>

    <!-- SECCIÓN ALERTAS (C): avisos en el navegador (localStorage + Notification).
         Sin backend: se guardan en el dispositivo y se chequean al abrir la página.
         Para avisos por email, se derivan a las calcs con motor de alertas real. -->
    <section class="dash-section" id="alertas">
      <h2>🔔 Alertas de valores</h2>
      <p class="alert-lead">
        Poné un aviso y te avisamos <strong>en este navegador</strong> —con notificación del sistema si la permitís— cuando se cumpla.
        Se guarda sólo en tu dispositivo y se chequea cada vez que abrís esta página.
      </p>
      <form class="alert-form" id="hcAlertForm" novalidate>
        <div class="alert-row">
          <label class="alert-field">
            <span class="alert-lbl">Métrica</span>
            <select id="hcAlertMetric" class="alert-input">
              <option value="blue">Dólar blue</option>
              <option value="oficial">Dólar oficial</option>
              <option value="bolsa">Dólar MEP</option>
              <option value="contadoconliqui">Dólar CCL</option>
              <option value="cripto">Dólar cripto</option>
              <option value="uva">UVA</option>
              <option value="icl">ICL (alquileres)</option>
              <option value="pfmax">Plazo fijo · TNA máxima</option>
            </select>
          </label>
          <label class="alert-field" id="hcAlertOpField">
            <span class="alert-lbl">Condición</span>
            <select id="hcAlertOp" class="alert-input">
              <option value="gte">Supere</option>
              <option value="lte">Baje de</option>
            </select>
          </label>
          <label class="alert-field" id="hcAlertValField">
            <span class="alert-lbl">Valor</span>
            <input id="hcAlertVal" class="alert-input" type="number" inputmode="decimal" step="any" placeholder="Ej. 1600" />
          </label>
          <button type="submit" class="alert-btn">Activar aviso</button>
        </div>
        <p class="alert-hint" id="hcAlertChangeHint" hidden>Te avisamos cuando este valor <strong>cambie</strong> respecto del que ves ahora.</p>
        <p class="alert-msg" id="hcAlertMsg" role="status" aria-live="polite"></p>
      </form>
      <ul class="alert-list" id="hcAlertList" aria-label="Alertas activas"></ul>
      <p class="alert-fallback">
        ¿Preferís aviso por <strong>email</strong> cuando cambie un valor por normativa? Activalo dentro de la
        <a href="/calculadora-actualizacion-alquiler-icl">calculadora de alquiler ICL</a> o la
        <a href="/calculadora-plazo-fijo">de plazo fijo</a> — usan nuestro motor de alertas con recálculo.
      </p>
    </section>

    <!-- LINKS A CALCS -->
    <section class="dash-section">
      <h2>🔗 Calculadoras con estos valores</h2>
      <div class="link-grid">
        <a href="/conversor-dolar-argentina" class="link-card">
          <span class="link-title">Dólar tarjeta</span>
          <span class="link-desc">Calcular qué te cobran con PAIS + Ganancias</span>
        </a>
        <a href="/calculadora-actualizacion-inflacion-ipc" class="link-card">
          <span class="link-title">Inflación IPC</span>
          <span class="link-desc">Actualizar un monto del pasado a hoy</span>
        </a>
        <a href="/calculadora-credito-uva-vs-tasa-fija" class="link-card">
          <span class="link-title">Crédito UVA</span>
          <span class="link-desc">Cuota hipotecaria ajustada por UVA</span>
        </a>
        <a href="/calculadora-actualizacion-alquiler-icl" class="link-card">
          <span class="link-title">Alquiler ICL</span>
          <span class="link-desc">Ajuste anual por índice BCRA</span>
        </a>
        <a href="/calculadora-plazo-fijo" class="link-card">
          <span class="link-title">Plazo fijo</span>
          <span class="link-desc">Rendimiento en $ con TNA actual</span>
        </a>
        <a href="/calculadora-cuota-prestamo" class="link-card">
          <span class="link-title">Préstamo personal</span>
          <span class="link-desc">Cuota con tasa promedio bancos</span>
        </a>
      </div>
    </section>

    <section class="dash-section">
      <h2>📊 Tablas de datos 2026 (citables, CC-BY)</h2>
      <div class="link-grid">
        <a href="/datos-ganancias-2026" class="link-card">
          <span class="link-title">Ganancias 2026</span>
          <span class="link-desc">Escala del impuesto y deducciones art. 30</span>
        </a>
        <a href="/datos-topes-sipa-2026" class="link-card">
          <span class="link-title">Topes SIPA 2026</span>
          <span class="link-desc">Base imponible máxima de aportes</span>
        </a>
        <a href="/datos-aguinaldo-2026" class="link-card">
          <span class="link-title">Aguinaldo (SAC) 2026</span>
          <span class="link-desc">Fechas legales, fórmula y ejemplos</span>
        </a>
        <a href="/datos-monotributo-2026" class="link-card">
          <span class="link-title">Monotributo 2026</span>
          <span class="link-desc">Categorías, topes y cuotas A-K</span>
        </a>
        <a href="/datos-salario-minimo-latam-2026" class="link-card">
          <span class="link-title">Salario mínimo LATAM</span>
          <span class="link-desc">AR, BR, PE y EC comparados con fuentes</span>
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="dash-section faq-section">
      <h2>❓ Preguntas frecuentes</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <div class="faq-answer" set:html={f.a}></div>
          </details>
        ))}
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
    </section>

    <section class="dash-section sources" id="fuentes">
      <h3>Fuentes y metodología</h3>
      <ul class="sources-list">
        <li><a href="https://www.bcra.gob.ar" target="_blank" rel="noopener">BCRA — Banco Central de la República Argentina</a> (cotización oficial, UVA)</li>
        <li><a href="https://www.indec.gob.ar" target="_blank" rel="noopener">INDEC</a> (IPC Nacional)</li>
        <li><a href="https://dolarapi.com" target="_blank" rel="noopener">dolarapi.com</a> (consolida cotizaciones)</li>
        <li><a href="https://argentinadatos.com" target="_blank" rel="noopener">argentinadatos.com</a> (inflación, UVA)</li>
      </ul>
      <p class="disclaimer">Los valores son informativos y pueden tener desfase de unas horas. Para operaciones grandes consultá siempre con tu banco o la fuente oficial.</p>
    </section>
  </article>

  <Footer slot="footer" />
</Layout>

<script>
  // Refresh híbrido: el HTML llega con los valores del último build (crawleables);
  // al cargar la página los actualizamos en vivo desde las APIs públicas.
  (function () {
    const fmt = (n: number) => new Intl.NumberFormat('es-AR', { maximumFractionDigits: 2 }).format(n);
    const J = async (u: string) => { const r = await fetch(u); if (!r.ok) throw new Error('http'); return r.json(); };
    async function refresh() {
      if (!document.querySelector('.dashboard [data-uva], .dashboard [data-dolar-key]')) return;
      const [dol, uva, ipc, ipcA] = await Promise.allSettled([
        J('https://dolarapi.com/v1/dolares'),
        J('https://api.argentinadatos.com/v1/finanzas/indices/uva'),
        J('https://api.argentinadatos.com/v1/finanzas/indices/inflacion'),
        J('https://api.argentinadatos.com/v1/finanzas/indices/inflacionInteranual'),
      ]);
      let okDol = false, oficial: number | null = null;
      if (dol.status === 'fulfilled' && Array.isArray(dol.value)) {
        okDol = true;
        const map: Record<string, any> = {};
        dol.value.forEach((d: any) => { map[d.casa] = d; });
        oficial = map.oficial && map.oficial.venta ? map.oficial.venta : null;
        document.querySelectorAll('[data-dolar-key]').forEach((el) => {
          const d = map[el.getAttribute('data-dolar-key') || ''];
          if (d && d.venta) el.textContent = '$' + fmt(d.venta);
        });
        if (oficial) document.querySelectorAll('[data-brecha-key]').forEach((el) => {
          const d = map[el.getAttribute('data-brecha-key') || ''];
          if (d && d.venta) el.textContent = '+' + ((d.venta / (oficial as number) - 1) * 100).toFixed(1) + '%';
        });
      }
      const last = (s: PromiseSettledResult<any>) =>
        (s.status === 'fulfilled' && Array.isArray(s.value) && s.value.length) ? s.value[s.value.length - 1] : null;
      const u = last(uva); if (u) { const el = document.querySelector('[data-uva]'); if (el) el.textContent = '$' + fmt(u.valor); }
      const m = last(ipc); if (m) { const el = document.querySelector('[data-ipc-mensual]'); if (el) el.textContent = m.valor.toFixed(1) + '%'; }
      const a = last(ipcA); if (a) { const el = document.querySelector('[data-ipc-anual]'); if (el) el.textContent = a.valor.toFixed(1) + '%'; }
      const t = document.querySelector('[data-updated]');
      if (t && okDol) {
        const now = new Date();
        t.textContent = 'hoy ' + now.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
        t.setAttribute('datetime', now.toISOString());
      }
      try { checkAlerts(); } catch (e) { /* noop */ }
    }

    // ── ALERTAS EN EL NAVEGADOR (C) ─────────────────────────────────────────
    // Sin backend: se guardan en localStorage y se chequean contra el valor que
    // se ve en pantalla (ya actualizado por refresh()). Notificación del sistema
    // si el usuario la permite; si no, banner en la lista.
    const LS_KEY = 'hc_bcra_alerts_v1';
    const METRIC_META: Record<string, { label: string; sel: string; unit: string; type: 'threshold' | 'change' }> = {
      blue: { label: 'Dólar blue', sel: '[data-dolar-key="blue"]', unit: '$', type: 'threshold' },
      oficial: { label: 'Dólar oficial', sel: '[data-dolar-key="oficial"]', unit: '$', type: 'threshold' },
      bolsa: { label: 'Dólar MEP', sel: '[data-dolar-key="bolsa"]', unit: '$', type: 'threshold' },
      contadoconliqui: { label: 'Dólar CCL', sel: '[data-dolar-key="contadoconliqui"]', unit: '$', type: 'threshold' },
      cripto: { label: 'Dólar cripto', sel: '[data-dolar-key="cripto"]', unit: '$', type: 'threshold' },
      uva: { label: 'UVA', sel: '[data-uva]', unit: '$', type: 'change' },
      icl: { label: 'ICL', sel: '[data-tasa="icl"]', unit: '', type: 'change' },
      pfmax: { label: 'Plazo fijo (TNA máx.)', sel: '[data-pf-top]', unit: '%', type: 'change' },
    };
    function readNum(sel: string): number | null {
      const el = document.querySelector(sel);
      if (!el) return null;
      const raw = (el.textContent || '').replace(/[^0-9.,-]/g, '').replace(/\./g, '').replace(',', '.');
      const n = parseFloat(raw);
      return isFinite(n) ? n : null;
    }
    function loadAlerts(): any[] {
      try { return JSON.parse(localStorage.getItem(LS_KEY) || '[]'); } catch { return []; }
    }
    function saveAlerts(a: any[]) { localStorage.setItem(LS_KEY, JSON.stringify(a)); }
    function fmtNum(n: number, unit: string): string {
      const s = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 2 }).format(n);
      return unit === '$' ? '$' + s : unit === '%' ? s + '%' : s;
    }
    function notify(title: string, body: string) {
      try {
        if ('Notification' in window && Notification.permission === 'granted') {
          new Notification(title, { body, icon: '/favicon.svg' });
          return;
        }
      } catch { /* noop */ }
      // Fallback visible: marcar la fila y avisar en el status.
      const msg = document.getElementById('hcAlertMsg');
      if (msg) { msg.textContent = '🔔 ' + title + ' — ' + body; msg.className = 'alert-msg alert-msg-ok'; }
    }
    function checkAlerts() {
      const alerts = loadAlerts();
      if (!alerts.length) { renderAlerts(); return; }
      let changed = false;
      for (const al of alerts) {
        const meta = METRIC_META[al.metric];
        if (!meta) continue;
        const cur = readNum(meta.sel);
        if (cur == null) continue;
        if (meta.type === 'threshold') {
          const hit = al.op === 'lte' ? cur <= al.val : cur >= al.val;
          if (hit && !al.fired) {
            al.fired = true; changed = true;
            notify('Alerta: ' + meta.label, meta.label + ' ' + (al.op === 'lte' ? 'bajó a' : 'superó') + ' ' + fmtNum(cur, meta.unit) + ' (umbral ' + fmtNum(al.val, meta.unit) + ')');
          } else if (!hit && al.fired) {
            al.fired = false; changed = true; // rearma cuando vuelve del otro lado
          }
        } else { // change
          if (al.base == null) { al.base = cur; changed = true; }
          else if (Math.abs(cur - al.base) > 1e-6) {
            notify('Alerta: ' + meta.label, meta.label + ' cambió de ' + fmtNum(al.base, meta.unit) + ' a ' + fmtNum(cur, meta.unit));
            al.base = cur; changed = true;
          }
        }
      }
      if (changed) saveAlerts(alerts);
      renderAlerts();
    }
    function removeAlert(id: string) {
      saveAlerts(loadAlerts().filter((a: any) => a.id !== id));
      renderAlerts();
    }
    function renderAlerts() {
      const list = document.getElementById('hcAlertList');
      if (!list) return;
      const alerts = loadAlerts();
      list.innerHTML = '';
      for (const al of alerts) {
        const meta = METRIC_META[al.metric];
        if (!meta) continue;
        const li = document.createElement('li');
        li.className = 'alert-chip' + (al.fired ? ' alert-chip-fired' : '');
        const desc = meta.type === 'threshold'
          ? meta.label + ' ' + (al.op === 'lte' ? '≤' : '≥') + ' ' + fmtNum(al.val, meta.unit)
          : meta.label + ' cambie' + (al.base != null ? ' (desde ' + fmtNum(al.base, meta.unit) + ')' : '');
        const txt = document.createElement('span');
        txt.textContent = (al.fired ? '✅ ' : '🔔 ') + desc;
        const btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'alert-chip-x'; btn.setAttribute('aria-label', 'Quitar alerta'); btn.textContent = '✕';
        btn.addEventListener('click', () => removeAlert(al.id));
        li.appendChild(txt); li.appendChild(btn);
        list.appendChild(li);
      }
    }
    function initAlertForm() {
      const form = document.getElementById('hcAlertForm') as HTMLFormElement | null;
      if (!form || form.dataset.wired) return;
      form.dataset.wired = '1';
      const metricSel = document.getElementById('hcAlertMetric') as HTMLSelectElement;
      const opField = document.getElementById('hcAlertOpField')!;
      const valField = document.getElementById('hcAlertValField')!;
      const changeHint = document.getElementById('hcAlertChangeHint')!;
      const valInput = document.getElementById('hcAlertVal') as HTMLInputElement;
      const msg = document.getElementById('hcAlertMsg')!;
      function syncMode() {
        const meta = METRIC_META[metricSel.value];
        const isThreshold = meta && meta.type === 'threshold';
        opField.hidden = !isThreshold;
        valField.hidden = !isThreshold;
        changeHint.hidden = !!isThreshold;
      }
      metricSel.addEventListener('change', syncMode);
      syncMode();
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const metric = metricSel.value;
        const meta = METRIC_META[metric];
        if (!meta) return;
        const alerts = loadAlerts();
        const id = metric + '-' + Date.now().toString(36);
        if (meta.type === 'threshold') {
          const val = parseFloat(valInput.value);
          if (!isFinite(val)) { msg.textContent = 'Poné un valor numérico.'; msg.className = 'alert-msg alert-msg-err'; return; }
          const op = (document.getElementById('hcAlertOp') as HTMLSelectElement).value;
          alerts.push({ id, metric, op, val, fired: false });
          msg.textContent = 'Listo: te avisamos si ' + meta.label + ' ' + (op === 'lte' ? 'baja a ' : 'supera ') + fmtNum(val, meta.unit) + '.';
        } else {
          const cur = readNum(meta.sel);
          alerts.push({ id, metric, base: cur, type: 'change' });
          msg.textContent = 'Listo: te avisamos cuando ' + meta.label + ' cambie' + (cur != null ? ' (ahora ' + fmtNum(cur, meta.unit) + ')' : '') + '.';
        }
        msg.className = 'alert-msg alert-msg-ok';
        saveAlerts(alerts);
        valInput.value = '';
        if ('Notification' in window && Notification.permission === 'default') {
          try { Notification.requestPermission(); } catch { /* noop */ }
        }
        checkAlerts();
      });
      renderAlerts();
    }

    refresh();
    initAlertForm();
    document.addEventListener('astro:page-load', function () { refresh(); initAlertForm(); });
  })();
</script>

<style>
  .dashboard { max-width: 1060px; margin: 0 auto; padding: 0 0 3rem; }
  .breadcrumbs { font-size: 0.875rem; color: var(--text-subtle); margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .breadcrumbs a { color: var(--text-muted); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }
  .breadcrumbs .sep { color: var(--border-strong); }

  .dash-head { margin-bottom: 2rem; }
  .dash-head h1 { margin-bottom: 0.5rem; }
  .lead { color: var(--text-muted); font-size: 1.0625rem; max-width: 680px; }
  .vb-resumen {
    margin: 1.25rem 0 0;
    padding: 0.9rem 1.1rem;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm, 8px);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 760px;
  }

  /* Barra superior de dashboard (TrustStrip + estado en vivo) */
  .dash-bar { margin: 0 0 1.5rem; }
  .dash-bar__live { font-weight: 600; color: var(--text); }
  .dash-bar__method { color: var(--accent-strong); font-weight: 600; text-decoration: none; }
  .dash-bar__method:hover { text-decoration: underline; }
  .dash-bar .live-dot { margin-right: 2px; }

  /* Índice de anclas sticky entre secciones (no oculta contenido). */
  .dash-tabs {
    position: sticky; top: 0; z-index: 3;
    display: flex; gap: 0.375rem; flex-wrap: wrap;
    padding: 0.5rem 0; margin-bottom: 1.5rem;
    background: color-mix(in srgb, var(--bg-card) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(6px);
    border-bottom: 1px solid var(--border);
  }
  .dash-tabs a {
    font-size: 0.8125rem; font-weight: 600; color: var(--text-muted);
    padding: 0.3rem 0.7rem; border-radius: 999px;
    border: 1px solid var(--border); background: var(--bg-card);
    text-decoration: none; white-space: nowrap;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .dash-tabs a:hover { background: var(--accent-soft); color: var(--accent-strong); border-color: var(--accent); }
  /* que la barra sticky no tape el título al saltar por ancla */
  .dash-section[id] { scroll-margin-top: 3.25rem; }

  .dash-section { margin-bottom: 2.5rem; }
  .dash-section h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-grid {
    display: grid;
    gap: 0.875rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.125rem 1.25rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s, background-color 0.2s, color 0.2s;
  }
  .card:hover { box-shadow: var(--shadow); border-color: var(--border-strong); }
  .card.hi {
    background: linear-gradient(135deg, var(--accent-soft) 0%, #e0f2fe 100%);
    border-color: #bfdbfe;
  }
  html[data-theme="dark"] .card.hi {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.12) 0%, rgba(96, 165, 250, 0.15) 100%);
    border-color: rgba(147, 197, 253, 0.25);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .card-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .card.hi .card-label { color: var(--accent-strong); }

  .badge {
    background: var(--danger-soft);
    color: var(--danger);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
  }
  /* Impuesto (tarjeta) vs brecha cambiaria (blue/mep/ccl): colores distintos
     para que el usuario no confunda el recargo fiscal con una brecha de mercado. */
  .badge-tax {
    background: var(--warning-soft, rgba(245, 158, 11, 0.14));
    color: var(--warning, #b45309);
    cursor: help;
  }

  /* Delta de variación (mes a mes) — coloreado por tono semántico.
     Es la VARIACIÓN (sube/baja), distinta de la brecha (sub-dato aparte). */
  .delta {
    font-family: var(--font-num, var(--font-mono));
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem; font-weight: 700;
    padding: 0.1rem 0.4rem; border-radius: 999px;
    background: var(--bg-muted, rgba(100, 116, 139, 0.12));
    color: var(--text-muted); white-space: nowrap;
  }
  .delta-pos { background: var(--success-soft, rgba(22, 163, 74, 0.14)); color: var(--success-text, #15803d); }
  .delta-neg { background: var(--danger-soft, rgba(220, 38, 38, 0.12)); color: var(--danger, #dc2626); }
  .delta-neutral { background: var(--bg-muted, rgba(100, 116, 139, 0.12)); color: var(--text-muted); }

  /* Sparkline SVG (30d / 12m) — hereda color por dirección de la serie. */
  .spark { display: block; width: 88px; height: 26px; margin: 0.35rem 0 0.15rem; overflow: visible; }
  .spark-up { color: var(--accent-strong); }
  .spark-down { color: var(--danger, #dc2626); }

  /* Brecha como sub-dato ETIQUETADO (no un badge ambiguo de variación). */
  .card-meta {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 0.5rem; margin-top: 0.1rem;
  }
  .meta-label { font-size: 0.72rem; color: var(--text-subtle); text-transform: uppercase; letter-spacing: 0.03em; }
  .meta-val {
    font-family: var(--font-num, var(--font-mono)); font-variant-numeric: tabular-nums;
    font-size: 0.8125rem; font-weight: 700; color: var(--text-muted);
  }

  .card-value {
    font-family: var(--font-num, var(--font-mono));
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.25rem;
    line-height: 1.1;
  }
  .card.hi .card-value { color: var(--accent-strong); }

  /* === Terminal financiero (#14): canvas gris-azulado + tarjetas-monitor ===
     El fondo levemente azulado y las métricas en mono dan el "look terminal",
     no una sucesión de bloques editoriales. */
  :global(body[data-page-type="dashboard"]) { background: #eef2f8; }
  :global(html[data-theme="dark"] body[data-page-type="dashboard"]) { background: #0b1220; }
  .card { background: var(--bg-card); }

  /* Tabla de bancos con BARRAS horizontales (plazo fijo). */
  .tna-bars {
    display: flex; flex-direction: column;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 4px 12px; margin-bottom: 1rem;
  }
  .tna-row {
    display: grid; grid-template-columns: 150px 1fr 64px; align-items: center; gap: 14px;
    padding: 8px 2px; border-bottom: 1px solid var(--border);
  }
  .tna-row:last-child { border-bottom: 0; }
  .tna-bank { font-size: 0.85rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tna-track { height: 8px; background: var(--bg-muted); border-radius: 999px; overflow: hidden; }
  .tna-fill {
    display: block; height: 100%; border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 55%, var(--accent-2, #0d9488)));
  }
  .tna-val {
    font-family: var(--font-num, var(--font-mono)); font-variant-numeric: tabular-nums;
    font-weight: 700; font-size: 0.92rem; text-align: right; color: var(--accent-strong);
  }
  .tna-row-top .tna-val { color: var(--success-text, #15803d); }
  @media (max-width: 520px) { .tna-row { grid-template-columns: 92px 1fr 50px; gap: 9px; } }

  .card-sub {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }
  .card-hint {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }

  /* TNA grid */
  .tna-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.625rem;
    margin-bottom: 1rem;
  }
  .tna-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 0.875rem;
    text-align: center;
  }
  .tna-bank { font-size: 0.8125rem; color: var(--text-muted); font-weight: 500; }
  .tna-val { font-size: 1.375rem; font-weight: 700; color: var(--accent-strong); margin-top: 0.25rem; }

  .sec-cta { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .cta-link { font-weight: 600; font-size: 0.9375rem; }

  /* Link grid */
  .link-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .link-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
