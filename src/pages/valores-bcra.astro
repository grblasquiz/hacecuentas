  .link-title { font-weight: 600; font-size: 0.9375rem; }
  .link-desc { font-size: 0.8125rem; color: var(--text-muted); }
  .link-card:hover .link-desc { color: var(--accent); }

  .sources { padding-top: 1rem; border-top: 1px solid var(--border); }
  .sources h3 { font-size: 0.9375rem; margin-bottom: 0.625rem; color: var(--text); }
  .sources-list {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .disclaimer {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    font-style: italic;
  }

  /* Fila "en vivo" */
  .updated-row {
    display: flex; align-items: center; gap: 0.4rem;
    font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.5rem;
  }
  .live-dot {
    width: 8px; height: 8px; border-radius: 50%; flex: none;
    background: #16a34a; box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.18);
    animation: pulseDot 2s infinite;
  }
  @keyframes pulseDot { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  /* Histórico UVA + inflación */
  .hist-grid {
    display: grid; gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .hist-block h3 { font-size: 0.95rem; margin-bottom: 0.625rem; color: var(--text); }
  .hist-table {
    width: 100%; border-collapse: collapse; font-size: 0.875rem;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); overflow: hidden;
  }
  .hist-table th, .hist-table td { padding: 0.5rem 0.75rem; text-align: left; }
  .hist-table thead th {
    background: var(--accent-soft); color: var(--text-muted);
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.03em;
  }
  .hist-table tbody tr { border-top: 1px solid var(--border); }
  .hist-table tbody td:first-child { text-transform: capitalize; color: var(--text-muted); }
  .hist-table tbody td:last-child {
    text-align: right; font-weight: 700; color: var(--text);
    font-feature-settings: 'tnum';
  }
  .hist-empty { font-size: 0.875rem; color: var(--text-subtle); }

  .tna-note { font-size: 0.8125rem; color: var(--text-subtle); margin-bottom: 0.75rem; }

  /* FAQ */
  .faq-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 0 1rem;
  }
