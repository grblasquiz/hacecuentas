  .vb-sources p { font-size: 0.88rem; color: var(--text-muted); line-height: 1.55; margin: 0 0 1rem; max-width: 70ch; }
  .vb-source-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .vb-source-badge { font-size: 0.8rem; font-weight: 650; color: var(--text-muted); background: var(--bg-soft); border: 1px solid var(--border); border-radius: 999px; padding: 0.4rem 0.85rem; text-decoration: none; }
  .vb-source-badge:hover { border-color: var(--accent); color: var(--accent-strong); }
  .vb-source-more { color: var(--accent-strong); }

  /* SECUNDARIO (histórico / links / faq) */
  .vb-secondary .vb-head h2 { font-size: 1.15rem; }
  .vb-hist-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .vb-hist-h3 { font-size: 0.92rem; font-weight: 700; margin: 0 0 0.7rem; }
  .vb-hist-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .vb-hist-table th, .vb-hist-table td { padding: 0.5rem 0.4rem; text-align: left; }
  .vb-hist-table thead th { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-subtle); border-bottom: 1px solid var(--border); }
  .vb-hist-table tbody tr { border-bottom: 1px solid var(--border); }
  .vb-hist-table tbody td:first-child { text-transform: capitalize; color: var(--text-muted); }
  .vb-hist-table tbody td:last-child { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }

  .vb-link-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  .vb-link { display: flex; flex-direction: column; gap: 0.2rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 0.85rem 1rem; text-decoration: none; color: var(--text); transition: border-color 0.15s, background-color 0.15s; }
  .vb-link:hover { border-color: var(--accent); background: var(--accent-soft); }
  .vb-link-title { font-size: 0.88rem; font-weight: 700; }
  .vb-link-desc { font-size: 0.76rem; color: var(--text-muted); }

  .vb-faq-list { display: flex; flex-direction: column; gap: 0.4rem; }
  .vb-faq-item { border: 1px solid var(--border); border-radius: 10px; background: var(--bg-card); overflow: hidden; }
  .vb-faq-item summary { cursor: pointer; font-weight: 650; font-size: 0.92rem; color: var(--text); list-style: none; padding: 0.9rem 1.1rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .vb-faq-item summary::-webkit-details-marker { display: none; }
  .vb-faq-item summary::after { content: '+'; color: var(--text-subtle); font-size: 1.2rem; line-height: 1; flex: none; }
  .vb-faq-item[open] summary { color: var(--accent-strong); }
  .vb-faq-item[open] summary::after { content: '−'; }
  .vb-faq-a { font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; padding: 0 1.1rem 1.1rem; max-width: 74ch; }
  .vb-faq-a a { color: var(--accent-strong); font-weight: 600; }

  .vb-empty { font-size: 0.85rem; color: var(--text-subtle); }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .vb-hero, .vb-alert-banner { grid-template-columns: 1fr; gap: 1.35rem; padding: 1.6rem; }
    .vb-glance, .vb-usa-grid, .vb-link-grid { grid-template-columns: repeat(2, 1fr); }
    .vb-change-grid { grid-template-columns: 1fr; }
    .vb-infl-grid, .vb-hist-grid { grid-template-columns: 1fr; }
    .vb-alert-form { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 680px) {
    .vb-hero h1 { font-size: 1.9rem; }
    .vb-glance, .vb-usa-grid, .vb-link-grid { grid-template-columns: 1fr; }
    .vb-alert-form { grid-template-columns: 1fr; }
    .vb-tabs { overflow-x: auto; }
    .vb-dolar-head, .vb-dolar-row { grid-template-columns: minmax(120px, 1.6fr) minmax(80px, 1fr) minmax(64px, 0.7fr) 16px; }
    .vb-dolar-head > :nth-child(2), .vb-dolar-head > :nth-child(5), .vb-dolar-compra, .vb-dolar-upd { display: none; }
  }
</style>

<script>
  // Refresh híbrido: el HTML llega con los valores del último build (crawleables);
  // al cargar la página los actualizamos en vivo desde las APIs públicas.
  (function () {
    const fmt = (n: number) => new Intl.NumberFormat('es-AR', { maximumFractionDigits: 2 }).format(n);
    const J = async (u: string) => { const r = await fetch(u); if (!r.ok) throw new Error('http'); return r.json(); };
    async function refresh() {
      if (!document.querySelector('.vb [data-uva], .vb [data-dolar-key]')) return;
      const [dol, uva, ipc, ipcA] = await Promise.allSettled([
        J('https://dolarapi.com/v1/dolares'),
        J('https://api.argentinadatos.com/v1/finanzas/indices/uva'),
        J('https://api.argentinadatos.com/v1/finanzas/indices/inflacion'),
        J('https://api.argentinadatos.com/v1/finanzas/indices/inflacionInteranual'),
      ]);
      let okDol = false, oficial: number | null = null;
      if (dol.status === 'fulfilled' && Array.isArray(dol.value)) {
        okDol = true;
        const map: Record<string, any> = {};
        dol.value.forEach((d: any) => { map[d.casa] = d; });
        oficial = map.oficial && map.oficial.venta ? map.oficial.venta : null;
        document.querySelectorAll('[data-dolar-key]').forEach((el) => {
          const d = map[el.getAttribute('data-dolar-key') || ''];
          if (d && d.venta) el.textContent = '$' + fmt(d.venta);
        });
        if (oficial) document.querySelectorAll('[data-brecha-key]').forEach((el) => {
          const d = map[el.getAttribute('data-brecha-key') || ''];
          if (d && d.venta) el.textContent = '+' + ((d.venta / (oficial as number) - 1) * 100).toFixed(1).replace('.', ',') + '%';
        });
      }
      const last = (s: PromiseSettledResult<any>) =>
        (s.status === 'fulfilled' && Array.isArray(s.value) && s.value.length) ? s.value[s.value.length - 1] : null;
      const u = last(uva); if (u) { const el = document.querySelector('[data-uva]'); if (el) el.textContent = '$' + fmt(u.valor); }
      const m = last(ipc); if (m) { const el = document.querySelector('[data-ipc-mensual]'); if (el) el.textContent = m.valor.toFixed(1).replace('.', ',') + '%'; }
      const a = last(ipcA); if (a) { const el = document.querySelector('[data-ipc-anual]'); if (el) el.textContent = a.valor.toFixed(1).replace('.', ',') + '%'; }
      const t = document.querySelector('[data-updated]');
      if (t && okDol) {
        const now = new Date();
        t.textContent = 'Actualizado hoy, ' + now.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', hour12: false });
        t.setAttribute('datetime', now.toISOString());
      }
      try { checkAlerts(); } catch (e) { /* noop */ }
    }

    // ── ALERTAS EN EL NAVEGADOR (localStorage + Notification) ──────────────
    const LS_KEY = 'hc_bcra_alerts_v1';
    const METRIC_META: Record<string, { label: string; sel: string; unit: string; type: 'threshold' | 'change' }> = {
      blue: { label: 'Dólar blue', sel: '[data-dolar-key="blue"]', unit: '$', type: 'threshold' },
      oficial: { label: 'Dólar oficial', sel: '[data-dolar-key="oficial"]', unit: '$', type: 'threshold' },
      bolsa: { label: 'Dólar MEP', sel: '[data-dolar-key="bolsa"]', unit: '$', type: 'threshold' },
      contadoconliqui: { label: 'Dólar CCL', sel: '[data-dolar-key="contadoconliqui"]', unit: '$', type: 'threshold' },
      cripto: { label: 'Dólar cripto', sel: '[data-dolar-key="cripto"]', unit: '$', type: 'threshold' },
      uva: { label: 'UVA', sel: '[data-uva]', unit: '$', type: 'change' },
      icl: { label: 'ICL', sel: '[data-tasa="icl"]', unit: '', type: 'change' },
      pfmax: { label: 'Plazo fijo (TNA máx.)', sel: '[data-pf-top]', unit: '%', type: 'change' },
    };
    function readNum(sel: string): number | null {
      const el = document.querySelector(sel);
      if (!el) return null;
      const raw = (el.textContent || '').replace(/[^0-9.,-]/g, '').replace(/\./g, '').replace(',', '.');
      const n = parseFloat(raw);
      return isFinite(n) ? n : null;
    }
    function loadAlerts(): any[] { try { return JSON.parse(localStorage.getItem(LS_KEY) || '[]'); } catch { return []; } }
    function saveAlerts(a: any[]) { localStorage.setItem(LS_KEY, JSON.stringify(a)); }
    function fmtNum(n: number, unit: string): string {
      const s = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 2 }).format(n);
      return unit === '$' ? '$' + s : unit === '%' ? s + '%' : s;
    }
    function notify(title: string, body: string) {
      try {
        if ('Notification' in window && Notification.permission === 'granted') { new Notification(title, { body, icon: '/favicon.svg' }); return; }
      } catch { /* noop */ }
      const msg = document.getElementById('hcAlertMsg');
      if (msg) { msg.textContent = '🔔 ' + title + ' — ' + body; msg.className = 'vb-alert-msg alert-msg-ok'; }
    }
    function checkAlerts() {
      const alerts = loadAlerts();
      if (!alerts.length) { renderAlerts(); return; }
      let changed = false;
      for (const al of alerts) {
        const meta = METRIC_META[al.metric];
        if (!meta) continue;
        const cur = readNum(meta.sel);
        if (cur == null) continue;
        if (meta.type === 'threshold') {
          const hit = al.op === 'lte' ? cur <= al.val : cur >= al.val;
          if (hit && !al.fired) { al.fired = true; changed = true; notify('Alerta: ' + meta.label, meta.label + ' ' + (al.op === 'lte' ? 'bajó a' : 'superó') + ' ' + fmtNum(cur, meta.unit) + ' (umbral ' + fmtNum(al.val, meta.unit) + ')'); }
          else if (!hit && al.fired) { al.fired = false; changed = true; }
        } else {
          if (al.base == null) { al.base = cur; changed = true; }
          else if (Math.abs(cur - al.base) > 1e-6) { notify('Alerta: ' + meta.label, meta.label + ' cambió de ' + fmtNum(al.base, meta.unit) + ' a ' + fmtNum(cur, meta.unit)); al.base = cur; changed = true; }
        }
      }
      if (changed) saveAlerts(alerts);
      renderAlerts();
    }
    function removeAlert(id: string) { saveAlerts(loadAlerts().filter((a: any) => a.id !== id)); renderAlerts(); }
    function renderAlerts() {
      const list = document.getElementById('hcAlertList');
      if (!list) return;
      const alerts = loadAlerts();
      list.innerHTML = '';
      for (const al of alerts) {
        const meta = METRIC_META[al.metric];
        if (!meta) continue;
        const li = document.createElement('li');
        li.className = 'alert-chip' + (al.fired ? ' alert-chip-fired' : '');
        const desc = meta.type === 'threshold'
          ? meta.label + ' ' + (al.op === 'lte' ? '≤' : '≥') + ' ' + fmtNum(al.val, meta.unit)
          : meta.label + ' cambie' + (al.base != null ? ' (desde ' + fmtNum(al.base, meta.unit) + ')' : '');
        const txt = document.createElement('span');
        txt.textContent = (al.fired ? '✅ ' : '🔔 ') + desc;
        const btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'alert-chip-x'; btn.setAttribute('aria-label', 'Quitar alerta'); btn.textContent = '✕';
        btn.addEventListener('click', () => removeAlert(al.id));
        li.appendChild(txt); li.appendChild(btn);
        list.appendChild(li);
      }
    }
    function initAlertForm() {
      const form = document.getElementById('hcAlertForm') as HTMLFormElement | null;
      if (!form || form.dataset.wired) return;
      form.dataset.wired = '1';
      const metricSel = document.getElementById('hcAlertMetric') as HTMLSelectElement;
      const opField = document.getElementById('hcAlertOpField')!;
      const valField = document.getElementById('hcAlertValField')!;
      const changeHint = document.getElementById('hcAlertChangeHint')!;
      const valInput = document.getElementById('hcAlertVal') as HTMLInputElement;
      const msg = document.getElementById('hcAlertMsg')!;
      function syncMode() {
        const meta = METRIC_META[metricSel.value];
        const isThreshold = meta && meta.type === 'threshold';
        opField.hidden = !isThreshold;
        valField.hidden = !isThreshold;
        changeHint.hidden = !!isThreshold;
      }
      metricSel.addEventListener('change', syncMode);
      syncMode();
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const metric = metricSel.value;
        const meta = METRIC_META[metric];
        if (!meta) return;
        const alerts = loadAlerts();
        const id = metric + '-' + Date.now().toString(36);
        if (meta.type === 'threshold') {
          const val = parseFloat(valInput.value);
          if (!isFinite(val)) { msg.textContent = 'Poné un valor numérico.'; msg.className = 'vb-alert-msg alert-msg-err'; return; }
          const op = (document.getElementById('hcAlertOp') as HTMLSelectElement).value;
          alerts.push({ id, metric, op, val, fired: false });
          msg.textContent = 'Listo: te avisamos si ' + meta.label + ' ' + (op === 'lte' ? 'baja a ' : 'supera ') + fmtNum(val, meta.unit) + '.';
        } else {
          const cur = readNum(meta.sel);
          alerts.push({ id, metric, base: cur, type: 'change' });
          msg.textContent = 'Listo: te avisamos cuando ' + meta.label + ' cambie' + (cur != null ? ' (ahora ' + fmtNum(cur, meta.unit) + ')' : '') + '.';
        }
        msg.className = 'vb-alert-msg alert-msg-ok';
        saveAlerts(alerts);
        valInput.value = '';
        if ('Notification' in window && Notification.permission === 'default') {
          try { Notification.requestPermission(); } catch { /* noop */ }
        }
        checkAlerts();
      });
      renderAlerts();
    }

    // ── Botón "Actualizar valores" del hero ──
    function initRefreshBtn() {
      const btn = document.getElementById('vb-refresh');
      if (!btn || (btn as any).dataset.wired) return;
      (btn as any).dataset.wired = '1';
      btn.addEventListener('click', () => { btn.textContent = '↻ Actualizando…'; refresh().finally(() => { btn.textContent = '↻ Actualizar valores'; }); });
    }

    refresh();
    initAlertForm();
    initRefreshBtn();
    document.addEventListener('astro:page-load', function () { refresh(); initAlertForm(); initRefreshBtn(); });
  })();
</script>

<script>
  // ── Gráfico UVA: toggle de rango (6 meses / 1 año / Todo) ──
  (function () {
    interface P { f: string; v: number; }
    const el = document.getElementById('vb-uva-data');
    if (!el?.textContent) return;
    let series: P[] = [];
    try { series = JSON.parse(el.textContent); } catch { return; }
    if (series.length < 2) return;

    const W = 580, H = 200, padL = 6, padR = 6, padT = 16, padB = 26;
    const fmtAr = (n: number) => new Intl.NumberFormat('es-AR', { maximumFractionDigits: 2 }).format(n);
    function shortMonth(s: string): string {
      try {
        const d = /^\d{4}-\d{2}-\d{2}$/.test(s) ? new Date(s + 'T00:00:00') : new Date(s);
        const m = d.toLocaleDateString('es-AR', { month: 'short' }).replace('.', '');
        return m.charAt(0).toUpperCase() + m.slice(1);
      } catch { return s; }
    }
    function fmtDate(s: string): string {
      try { const d = /^\d{4}-\d{2}-\d{2}$/.test(s) ? new Date(s + 'T00:00:00') : new Date(s); return d.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' }); } catch { return s; }
    }
    function sample(arr: P[], max: number): P[] {
      if (arr.length <= max) return arr;
      const out: P[] = []; const step = arr.length / max;
      for (let i = 0; i < max; i++) out.push(arr[Math.floor(i * step)]);
      if (out[out.length - 1] !== arr[arr.length - 1]) out.push(arr[arr.length - 1]);
      return out;
    }
    function draw(range: '6m' | '1a' | 'all') {
      const days = range === '6m' ? 182 : range === '1a' ? 365 : series.length;
      let pts = series.slice(Math.max(0, series.length - days));
      pts = sample(pts, 60);
      if (pts.length < 2) return;
      const vals = pts.map((p) => p.v);
      const min = Math.min(...vals), max = Math.max(...vals), span = (max - min) || 1;
      const innerW = W - padL - padR, innerH = H - padT - padB;
      const X = (i: number) => padL + (i / (pts.length - 1)) * innerW;
      const Y = (v: number) => padT + (1 - (v - min) / span) * innerH;
      const line = pts.map((p, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(p.v).toFixed(1)}`).join(' ');
      const baseY = (padT + innerH).toFixed(1);
      const area = `${line} L${X(pts.length - 1).toFixed(1)} ${baseY} L${X(0).toFixed(1)} ${baseY} Z`;
      const lineEl = document.getElementById('vb-uva-line'); const areaEl = document.getElementById('vb-uva-area');
      if (lineEl) lineEl.setAttribute('d', line);
      if (areaEl) areaEl.setAttribute('d', area);
      const g = document.getElementById('vb-uva-labels');
      if (g) {
        g.innerHTML = '';
        for (let k = 0; k < 6; k++) {
          const i = Math.round((k * (pts.length - 1)) / 5);
          const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          t.setAttribute('x', String(X(i))); t.setAttribute('y', String(H - 6)); t.setAttribute('text-anchor', 'middle');
          t.textContent = shortMonth(pts[i].f);
          g.appendChild(t);
        }
      }
      // Actualizar delta + fecha
      const first = pts[0].v, lastP = pts[pts.length - 1];
      const chg = first ? (lastP.v / first - 1) * 100 : 0;
      const lbl = range === '6m' ? 'en 6 meses' : range === '1a' ? 'en 1 año' : 'histórico';
      const deltaEl = document.getElementById('vb-uva-delta');
      if (deltaEl) deltaEl.textContent = `${chg >= 0 ? '+' : ''}${chg.toFixed(1).replace('.', ',')}% ${lbl}`;
      const bigEl = document.getElementById('vb-uva-big'); if (bigEl) bigEl.textContent = '$' + fmtAr(lastP.v);
      const dateEl = document.getElementById('vb-uva-date'); if (dateEl) dateEl.textContent = fmtDate(lastP.f);
    }
    function wire() {
      document.querySelectorAll<HTMLButtonElement>('.vb-range-btn').forEach((b) => {
        if ((b as any).dataset.wired) return;
        (b as any).dataset.wired = '1';
        b.addEventListener('click', () => {
          document.querySelectorAll('.vb-range-btn').forEach((x) => x.classList.toggle('is-active', x === b));
          draw((b.getAttribute('data-range') as any) || '6m');
        });
      });
    }
    wire();
    document.addEventListener('astro:page-load', wire);
  })();
</script>
