---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DatosHoyNav from '../components/DatosHoyNav.astro';
import bcraIndicesRaw from '../lib/bcra-indices.json';
import { getPlazoFijoTop } from '../lib/plazo-fijo';
import { ICL_VALORES, ICL_LAST_UPDATED } from '../lib/formulas/_bcra-icl';
import { fetchJSON } from '../lib/fetch-timeout';

const title = "Valores BCRA hoy: tasas, dólar y plazo fijo actualizados";
const description = 'Dashboard con dólar oficial, MEP, blue, CCL, tarjeta, UVA del día, inflación INDEC mensual y anual, ICL para alquileres y TNA plazo fijo. Datos oficiales BCRA/INDEC actualizados.';

// Fetch en build-time con fallbacks seguros
function safeFetch<T>(url: string, fallback: T): Promise<T> {
  return fetchJSON<T>(url, fallback, { headers: { 'User-Agent': 'hacecuentas.com/1.0' } });
}

type Dolar = { casa: string; nombre: string; compra: number; venta: number; fechaActualizacion: string };
type InflacionPoint = { fecha: string; valor: number };
type UvaPoint = { fecha: string; valor: number };

const dolares = await safeFetch<Dolar[]>('https://dolarapi.com/v1/dolares', []);
const inflacion = await safeFetch<InflacionPoint[]>('https://api.argentinadatos.com/v1/finanzas/indices/inflacion', []);
const uva = await safeFetch<UvaPoint[]>('https://api.argentinadatos.com/v1/finanzas/indices/uva', []);
const inflacionInteranual = await safeFetch<InflacionPoint[]>(
  'https://api.argentinadatos.com/v1/finanzas/indices/inflacionInteranual',
  []
);

// Tasas/índices BCRA (BADLAR, TAMAR, CER) + riesgo país: pre-fetcheados en build
// por scripts/fetch-bcra-indices.mjs (el WAF del BCRA bloquea el SSR de Astro).
type Punto = { valor: number; fecha: string; prev?: number | null; spark?: number[] } | null;
type DolarPunto = { venta: number; fecha: string; prev?: number | null; spark?: number[] } | null;
const bcraIndices = bcraIndicesRaw as {
  badlar: Punto; tamar: Punto; cer: Punto; riesgoPais: Punto;
  dolar?: Record<string, DolarPunto>;
};
const badlar = bcraIndices.badlar;
const tamar = bcraIndices.tamar;
const cer = bcraIndices.cer;
const riesgoPais = bcraIndices.riesgoPais;
const dolarHist = bcraIndices.dolar || {};

// Fecha de hoy (build) para detectar valores PUBLICADOS POR ADELANTADO (CER).
const todayStr = new Date().toISOString().slice(0, 10);
const isFutureDate = (s?: string) => !!s && s.slice(0, 10) > todayStr;

// Últimos valores
const dolarMap = Object.fromEntries(dolares.map((d) => [d.casa, d]));
const ultimoIpc = inflacion.at(-1);
const ultimaIpcAnual = inflacionInteranual.at(-1);
const ultimaUva = uva.at(-1);

// Formato
const fmtAr = (n: number) => new Intl.NumberFormat('es-AR', { maximumFractionDigits: 2 }).format(n);
const fmtDate = (s: string) => {
  if (!s) return '—';
  try {
    const d = /^\d{4}-\d{2}-\d{2}$/.test(s) ? new Date(s + 'T00:00:00') : new Date(s);
    return d.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
  } catch {
    return s;
  }
};
// Fecha corta "08 jul" (para las celdas de actualización de la tabla).
const fmtShort = (s: string) => {
  if (!s) return '—';
  try {
    const d = /^\d{4}-\d{2}-\d{2}$/.test(s) ? new Date(s + 'T00:00:00') : new Date(s);
    return d.toLocaleDateString('es-AR', { day: '2-digit', month: 'short' }).replace('.', '');
  } catch { return s; }
};
const fmtClock = (s: string) => {
  if (!s) return '';
  try { return new Date(s).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', hour12: false }); }
  catch { return ''; }
};

const buildDate = new Date().toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' });
const buildClock = new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', hour12: false });

// Tarjetas dólar en orden deseado.
const dolarCards: { key: string; label: string; hint: string; isTaxed?: boolean; href: string; cta: string }[] = [
  { key: 'oficial', label: 'Dólar Oficial', hint: 'Cotización mayorista del BCRA', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
  { key: 'blue', label: 'Dólar Blue', hint: 'Paralelo informal (Parque Lezama, arbolitos)', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
  { key: 'bolsa', label: 'Dólar MEP', hint: 'MEP / Bolsa: AL30 en pesos vs AL30 en USD', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
  { key: 'contadoconliqui', label: 'Dólar CCL', hint: 'Contado con liqui: para girar al exterior', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
  { key: 'tarjeta', label: 'Dólar Tarjeta', hint: 'Oficial + 30% percepción Ganancias (PAIS derogado dic 2024)', isTaxed: true, href: '/conversor-dolar-argentina', cta: 'Calcular con recargo →' },
  { key: 'cripto', label: 'Dólar Cripto', hint: 'USDT promedio en exchanges', href: '/conversor-dolar-argentina', cta: 'Convertir →' },
];

const builtAtISO = new Date().toISOString();

// Histórico mensual (último valor de cada mes) para tablas crawleables + long-tail.
function ultimoPorMes<T extends { fecha: string; valor: number }>(points: T[], n: number): T[] {
  const byMonth: Record<string, T> = {};
  for (const p of points) {
    if (!p?.fecha) continue;
    byMonth[p.fecha.slice(0, 7)] = p;
  }
  return Object.values(byMonth).slice(-n).reverse();
}
const mesLargo = (s: string) => {
  try { return new Date(s).toLocaleDateString('es-AR', { month: 'long', year: 'numeric' }); }
  catch { return s; }
};
const uvaHist = ultimoPorMes(uva, 12);
const ipcHist = inflacion.slice(-6).reverse();

const pct = (n: number) => `${n.toFixed(2).replace('.', ',')}%`;
const pct1 = (n: number) => `${n.toFixed(1).replace('.', ',')}%`;

// ── Datos "Hoy, de un vistazo" (dólar blue, CCL, inflación, UVA) ──
const oficialVenta = dolarMap.oficial?.venta ?? null;
const blueVenta = dolarMap.blue?.venta ?? null;
const cclVenta = dolarMap.contadoconliqui?.venta ?? null;
const blueBrecha = blueVenta && oficialVenta ? ((blueVenta / oficialVenta - 1) * 100) : null;
const cclBrecha = cclVenta && oficialVenta ? ((cclVenta / oficialVenta - 1) * 100) : null;

const ipcPrev = inflacion.length >= 2 ? inflacion[inflacion.length - 2]?.valor : undefined;
const ipcDeltaPts = (ultimoIpc?.valor != null && ipcPrev != null)
  ? (() => { const d = ultimoIpc.valor - ipcPrev; return (d >= 0 ? '+' : '') + d.toFixed(1).replace('.', ',') + ' puntos'; })()
  : null;
const ipcDeltaTone: 'pos' | 'neg' | 'neutral' =
  (ultimoIpc?.valor != null && ipcPrev != null)
    ? (ultimoIpc.valor < ipcPrev ? 'pos' : ultimoIpc.valor > ipcPrev ? 'neg' : 'neutral')
    : 'neutral';

// UVA: variación en ~30 días (mockup: "+0,6% en 30 días").
function uvaChangeDays(days: number): number | null {
  if (uva.length < 2) return null;
  const last = uva[uva.length - 1].valor;
  const idx = Math.max(0, uva.length - 1 - days);
  const prev = uva[idx]?.valor;
  return prev ? (last / prev - 1) * 100 : null;
}
const uva30d = uvaChangeDays(30);
const uva6m = uvaChangeDays(182);

// ── Plazo fijo: top tasas de bancos reconocibles ──
const plazoFijoRows = await getPlazoFijoTop(14);
const pfMax = plazoFijoRows.length ? plazoFijoRows[0].tna : null;

const uvaHoy = ultimaUva ? `$${fmtAr(ultimaUva.valor)}` : 'el valor del día';
const ipcMensualTxt = ultimoIpc ? `${ultimoIpc.valor.toFixed(1).replace('.', ',')}%` : 'el último dato del INDEC';
const ipcAnualTxt = ultimaIpcAnual ? `${ultimaIpcAnual.valor.toFixed(1).replace('.', ',')}%` : 'el último interanual';

const iclHoy = ICL_VALORES.at(-1) ?? null;
const iclFmt = iclHoy != null ? iclHoy.toLocaleString('es-AR', { minimumFractionDigits: 4, maximumFractionDigits: 4 }) : null;
const iclPrev = ICL_VALORES.length >= 2 ? ICL_VALORES.at(-2)! : null;
const iclDelta = (iclHoy != null && iclPrev) ? ((iclHoy / iclPrev - 1) * 100) : null;

// ── Tabla "Cotizaciones del dólar" (código, nombre, subtítulo, compra/venta) ──
const dolarTableMeta: Record<string, { code: string; short: string; subtitle: string }> = {
  oficial: { code: 'OF', short: 'Oficial', subtitle: 'Banco Nación' },
  blue: { code: 'BL', short: 'Blue', subtitle: 'Mercado informal' },
  bolsa: { code: 'ME', short: 'MEP', subtitle: 'Mercado de bonos' },
  contadoconliqui: { code: 'CC', short: 'CCL', subtitle: 'Contado con liquidación' },
  tarjeta: { code: 'TA', short: 'Tarjeta', subtitle: 'Oficial + percepción vigente' },
  cripto: { code: 'CR', short: 'Cripto', subtitle: 'USDT promedio' },
};
const dolarTable = dolarCards.map((c) => {
  const d = dolarMap[c.key];
  const meta = dolarTableMeta[c.key];
  const brechaNum = d?.venta && oficialVenta ? ((d.venta / oficialVenta - 1) * 100) : null;
  const isBase = c.key === 'oficial';
  const clock = fmtClock(d?.fechaActualizacion);
  const updated = isBase
    ? fmtShort(d?.fechaActualizacion || todayStr).toUpperCase()
    : c.isTaxed
      ? `Dato base · ${fmtShort(d?.fechaActualizacion || todayStr)}`
      : clock ? `Hoy · ${clock}` : `Al ${fmtShort(d?.fechaActualizacion || todayStr)}`;
  return {
    key: c.key, code: meta.code, short: meta.short, subtitle: meta.subtitle,
    compra: d?.compra ?? null, venta: d?.venta ?? null,
    brechaNum, isBase, isTaxed: !!c.isTaxed, updated, href: c.href,
  };
});

// ── Estado de las fuentes (hero panel) ──
const fuentes = [
  { label: 'BCRA', fresh: badlar ? `al ${fmtShort(badlar.fecha)}` : 'operativa' },
  { label: 'INDEC', fresh: ultimoIpc ? fmtDate(ultimoIpc.fecha) : 'operativa' },
  { label: 'DólarAPI', fresh: dolarMap.blue?.fechaActualizacion ? fmtClock(dolarMap.blue.fechaActualizacion) || 'hoy' : 'operativa' },
];

// ── Gráfico de área: Evolución UVA ──
function shortMonth(s: string): string {
  try {
    const d = /^\d{4}-\d{2}-\d{2}$/.test(s) ? new Date(s + 'T00:00:00') : new Date(s);
    const m = d.toLocaleDateString('es-AR', { month: 'short' }).replace('.', '');
    return m.charAt(0).toUpperCase() + m.slice(1);
  } catch { return s; }
}
function buildArea(series: UvaPoint[]) {
  const pts = series.filter((p) => p && isFinite(p.valor));
  if (pts.length < 2) return null;
  const w = 580, h = 200, padL = 6, padR = 6, padT = 16, padB = 26;
  const vals = pts.map((p) => p.valor);
  const min = Math.min(...vals), max = Math.max(...vals), span = (max - min) || 1;
  const innerW = w - padL - padR, innerH = h - padT - padB;
  const X = (i: number) => padL + (i / (pts.length - 1)) * innerW;
  const Y = (v: number) => padT + (1 - (v - min) / span) * innerH;
  const line = pts.map((p, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(p.valor).toFixed(1)}`).join(' ');
  const baseY = (padT + innerH).toFixed(1);
  const area = `${line} L${X(pts.length - 1).toFixed(1)} ${baseY} L${X(0).toFixed(1)} ${baseY} Z`;
  const nLab = 6; const labels: { x: number; text: string }[] = [];
  for (let k = 0; k < nLab; k++) {
    const i = Math.round((k * (pts.length - 1)) / (nLab - 1));
    labels.push({ x: X(i), text: shortMonth(pts[i].fecha) });
  }
  return { w, h, line, area, labels, baseY };
}
// 6 meses por defecto (~182 días). Downsample para no saturar el SVG.
function downsample<T>(arr: T[], max: number): T[] {
  if (arr.length <= max) return arr;
  const out: T[] = []; const step = arr.length / max;
  for (let i = 0; i < max; i++) out.push(arr[Math.floor(i * step)]);
  if (out[out.length - 1] !== arr[arr.length - 1]) out.push(arr[arr.length - 1]);
  return out;
}
const uva6mSeries = downsample(uva.slice(-182), 60);
const uvaChart = buildArea(uva6mSeries);
// Serie embebida (downsampled) para el toggle 6m / 1año / Todo en el cliente.
const uvaEmbed = downsample(uva, 300).map((p) => ({ f: p.fecha, v: p.valor }));

// ── Lectura ejecutiva "Qué cambió hoy" (insights de la data real) ──
const mercadoKeys = ['blue', 'bolsa', 'contadoconliqui', 'cripto'];
let topBrecha: { label: string; pct: number } | null = null;
for (const k of mercadoKeys) {
  const v = dolarMap[k]?.venta;
  const of = oficialVenta;
  if (v && of) {
    const p = (v / of - 1) * 100;
    if (!topBrecha || p > topBrecha.pct) {
      topBrecha = { label: (dolarCards.find((c) => c.key === k)?.label || k).replace('Dólar ', ''), pct: p };
    }
  }
}
const execItems: { icon: string; html: string; href: string; cta: string }[] = [];
if (topBrecha) {
  execItems.push({
    icon: '↗',
    html: `El <strong>${topBrecha.label}</strong> marca la mayor brecha frente al oficial: cotiza <strong>${pct1(topBrecha.pct)}</strong> por encima del oficial vendedor.`,
    href: '/conversor-dolar-argentina', cta: 'Comparar dólares →',
  });
}
if (badlar && ultimaIpcAnual) {
  const gana = badlar.valor >= ultimaIpcAnual.valor;
  execItems.push({
    icon: '%',
    html: gana
      ? `Las tasas le ganan a la inflación: la <strong>BADLAR</strong> anual rinde <strong>${pct(badlar.valor)}</strong> frente a ${ipcAnualTxt} interanual.`
      : `Las tasas siguen debajo de la inflación: la <strong>BADLAR</strong> anual es <strong>${pct(badlar.valor)}</strong> frente a ${ipcAnualTxt} de inflación interanual.`,
    href: '/calculadora-plazo-fijo', cta: 'Simular plazo fijo →',
  });
}
if (ultimoIpc && ipcPrev != null && ipcDeltaPts) {
  const desac = ultimoIpc.valor < ipcPrev;
  const mesIpc = ultimoIpc.fecha ? new Date(/^\d{4}-\d{2}-\d{2}$/.test(ultimoIpc.fecha) ? ultimoIpc.fecha + 'T00:00:00' : ultimoIpc.fecha).toLocaleDateString('es-AR', { month: 'long' }) : 'el último mes';
  execItems.push({
    icon: desac ? '↩' : '↪',
    html: `La <strong>inflación mensual ${desac ? 'desaceleró' : 'aceleró'}</strong>: fue ${ipcMensualTxt} en ${mesIpc}, ${ipcDeltaPts} ${desac ? 'menos' : 'más'} que el mes anterior.`,
    href: '/calculadora-actualizacion-inflacion-ipc', cta: 'Actualizar un monto →',
  });
}

// ── Indicadores principales (BCRA / INDEC) ──
type Indicador = { label: string; value: string; sub: string; future?: boolean };
const indicadores: Indicador[] = [
  ultimaIpcAnual && { label: 'Inflación interanual', value: `${ultimaIpcAnual.valor.toFixed(1).replace('.', ',')}%`, sub: `IPC nacional · ${mesLargo(ultimaIpcAnual.fecha)}`, anual: true },
  badlar && { label: 'BADLAR', value: pct1(badlar.valor), sub: `TNA · ${fmtDate(badlar.fecha)}` },
  tamar && { label: 'TAMAR', value: pct(tamar.valor), sub: `TNA · ${fmtDate(tamar.fecha)}` },
  iclHoy != null && { label: 'ICL', value: iclFmt ?? '', sub: iclDelta != null ? `${(iclDelta >= 0 ? '+' : '') + iclDelta.toFixed(2).replace('.', ',')}% diario` : `al ${fmtDate(ICL_LAST_UPDATED)}`, icl: true },
].filter(Boolean) as any;
const cerCard = cer ? { label: isFutureDate(cer.fecha) ? 'CER publicada a futuro' : 'CER', value: fmtAr(cer.valor), sub: isFutureDate(cer.fecha) ? `Vigente para el ${fmtDate(cer.fecha)} — no confundir con el valor de hoy` : `al ${fmtDate(cer.fecha)}`, future: isFutureDate(cer.fecha) } : null;

// Frase-resumen crawleable (AEO).
const resumenParts: string[] = [];
if (blueVenta) resumenParts.push(`el dólar blue cotiza a $${fmtAr(blueVenta)}`);
if (oficialVenta) resumenParts.push(`el oficial a $${fmtAr(oficialVenta)}`);
if (ultimaUva) resumenParts.push(`la UVA vale $${fmtAr(ultimaUva.valor)}`);
if (iclHoy != null) resumenParts.push(`el ICL para alquileres está en ${iclFmt}`);
if (ultimoIpc) resumenParts.push(`la inflación mensual fue ${ultimoIpc.valor.toFixed(1).replace('.', ',')}%`);
if (badlar) resumenParts.push(`la tasa BADLAR rinde ${pct(badlar.valor)} anual`);
if (riesgoPais) resumenParts.push(`y el riesgo país está en ${Math.round(riesgoPais.valor)} puntos`);
const resumen = resumenParts.length
  ? `Hoy en Argentina ${resumenParts.join(', ')}, según datos oficiales del BCRA e INDEC actualizados al ${buildDate}.`
  : '';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
    { '@type': 'ListItem', position: 2, name: 'Valores BCRA hoy', item: 'https://hacecuentas.com/valores-bcra' },
  ],
};

const faqs: { q: string; a: string }[] = [
  {
    q: '¿Cuánto vale el ICL hoy y cómo se ajusta un alquiler?',
    a: `El <strong>ICL (Índice de Contratos de Locación)</strong> del BCRA está en <strong>${iclFmt ?? 'el último dato'}</strong>${iclHoy != null ? ` al ${fmtDate(ICL_LAST_UPDATED)}` : ''}. Se publica a diario y combina 50% inflación (IPC) y 50% salarios (RIPTE). Para ajustar un alquiler se divide el ICL del día del ajuste por el del día de inicio del período; hacé la cuenta automática en la <a href="/calculadora-actualizacion-alquiler-icl">calculadora de actualización de alquiler por ICL</a>.`,
  },
  {
    q: '¿Cuánto vale la UVA hoy?',
    a: `La UVA (Unidad de Valor Adquisitivo) está en <strong>${uvaHoy}</strong>${ultimaUva ? ` al ${fmtDate(ultimaUva.fecha)}` : ''}, según el BCRA. La UVA se ajusta diariamente por el CER (que sigue a la inflación) con un rezago de unos 45 días, así que su valor sube prácticamente todos los días. El gráfico de arriba muestra su evolución.`,
  },
  {
    q: '¿Qué es la UVA y para qué se usa?',
    a: 'La <strong>UVA (Unidad de Valor Adquisitivo)</strong> es una unidad de cuenta creada por el BCRA en 2016 que se actualiza por inflación (índice CER). Equivalía a 1/1000 del costo de construcción de un metro cuadrado de vivienda. Se usa para indexar <strong>créditos hipotecarios UVA</strong>, <strong>plazos fijos UVA</strong> y algunos contratos, de modo que el capital mantenga su poder adquisitivo frente a la inflación.',
  },
  {
    q: '¿Cuál es la inflación de Argentina hoy?',
    a: `La última inflación mensual del INDEC (IPC Nacional) fue de <strong>${ipcMensualTxt}</strong> y la interanual (últimos 12 meses) de <strong>${ipcAnualTxt}</strong>. El INDEC publica el IPC alrededor del día 14 de cada mes con el dato del mes anterior.`,
  },
  {
    q: '¿Qué diferencia hay entre dólar oficial, blue, MEP y CCL?',
    a: 'El <strong>oficial</strong> es la cotización regulada del BCRA. El <strong>blue</strong> es el paralelo informal (efectivo, sin factura). El <strong>MEP</strong> (dólar bolsa) surge de comprar un bono en pesos y venderlo en dólares en el país; es legal. El <strong>CCL</strong> (contado con liqui) es similar pero la liquidación queda en el exterior. La diferencia entre el blue/MEP y el oficial se llama <strong>brecha cambiaria</strong>.',
  },
  {
    q: '¿Por qué el dólar tarjeta es más caro que el oficial?',
    a: 'Históricamente el dólar tarjeta sumaba el Impuesto PAÍS (30%) más la percepción a cuenta de Ganancias (30%). En 2026 eso cambió: el <strong>Impuesto PAÍS está derogado</strong> (dic-2024) y la percepción del 30% sobre <strong>consumos directos en dólares se eliminó</strong> (ene-2026), así que una compra o suscripción en USD se liquida al oficial. El recargo del 30% (percepción recuperable) sólo sigue para <strong>servicios turísticos y de transporte al exterior pagados en pesos</strong> — es lo que refleja la cotización "tarjeta/turista".',
  },
  {
    q: '¿Cuánto rinde un plazo fijo hoy?',
    a: `Las tasas (TNA) de plazo fijo tradicional a 30 días van desde ~16% hasta <strong>${pfMax ? String(pfMax).replace('.', ',') + '%' : '~23%'}</strong> anual según el banco, como se ve en el ranking de arriba (ordenado de mayor a menor). Para saber cuánto cobrás en pesos por un monto y plazo concretos, usá la <a href="/calculadora-plazo-fijo">calculadora de plazo fijo</a> o compará bancos en el <a href="/comparador-plazo-fijo">comparador</a>.`,
  },
  {
    q: '¿Qué es la tasa BADLAR y cuánto está hoy?',
    a: `La <strong>BADLAR</strong> (Buenos Aires Deposits of Large Amount Rate) es la tasa promedio que pagan los bancos privados por plazos fijos mayoristas de más de un millón de pesos a 30-35 días. El BCRA la publica a diario. Hoy la BADLAR de bancos privados está en <strong>${badlar ? pct(badlar.valor) : 'el último dato del BCRA'}</strong>${badlar ? ` (al ${fmtDate(badlar.fecha)})` : ''}. La <strong>TAMAR</strong>${tamar ? ` (${pct(tamar.valor)})` : ''} es la versión mayorista que el BCRA adoptó como tasa de referencia.`,
  },
  {
    q: '¿Cuál es el riesgo país de Argentina hoy?',
    a: `El <strong>riesgo país</strong> (índice EMBI+ de JP Morgan) mide la sobretasa que paga la deuda argentina frente a los bonos del Tesoro de EE.UU., en puntos básicos (100 pb = 1%). Hoy está en <strong>${riesgoPais ? Math.round(riesgoPais.valor) + ' puntos' : 'el último dato disponible'}</strong>${riesgoPais ? ` (al ${fmtDate(riesgoPais.fecha)})` : ''}. Cuanto más bajo, más confianza del mercado en que el país pagará su deuda.`,
  },
  {
    q: '¿Cada cuánto se actualizan estos valores?',
    a: 'Las cotizaciones del dólar se <strong>refrescan en vivo</strong> al abrir la página (desde dolarapi.com, que consolida bancos y casas de cambio). La inflación y la UVA se actualizan con cada publicación oficial del INDEC y el BCRA. La fecha de cada dato figura debajo del valor.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Valores BCRA y INDEC hoy',
  description: 'Dólar oficial, blue, MEP, CCL y tarjeta; inflación INDEC mensual e interanual; UVA y tasas de plazo fijo de Argentina.',
  keywords: 'dolar hoy, dolar blue, inflación INDEC, UVA BCRA, valor uva hoy, plazo fijo TNA, valores BCRA, ICL hoy, valor ICL BCRA, coeficiente ICL alquiler',
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  license: 'https://hacecuentas.com/terminos',
  url: 'https://hacecuentas.com/valores-bcra',
  dateModified: builtAtISO,
  temporalCoverage: uvaHist.length ? `${uvaHist[uvaHist.length - 1].fecha}/${uvaHist[0].fecha}` : undefined,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://dolarapi.com/v1/dolares' },
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://api.argentinadatos.com/v1/finanzas/indices/uva' },
  ],
  variableMeasured: [
    blueVenta && { '@type': 'PropertyValue', name: 'Dólar blue (venta)', value: blueVenta, unitText: 'ARS' },
    oficialVenta && { '@type': 'PropertyValue', name: 'Dólar oficial (venta)', value: oficialVenta, unitText: 'ARS' },
    ultimaUva && { '@type': 'PropertyValue', name: 'UVA', value: ultimaUva.valor, unitText: 'ARS' },
    ultimoIpc && { '@type': 'PropertyValue', name: 'Inflación mensual IPC (INDEC)', value: ultimoIpc.valor, unitText: 'P1' },
    badlar && { '@type': 'PropertyValue', name: 'Tasa BADLAR bancos privados', value: badlar.valor, unitText: 'P1' },
    riesgoPais && { '@type': 'PropertyValue', name: 'Riesgo país (EMBI+)', value: Math.round(riesgoPais.valor), unitText: 'basis point' },
  ].filter(Boolean),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};

const usaCards = [
  { icon: '$', title: 'Conversor de dólares', desc: 'Oficial, blue, MEP, CCL, tarjeta y cripto.', href: '/conversor-dolar-argentina', cta: 'Abrir calculadora' },
  { icon: '%', title: 'Plazo fijo', desc: 'Calculá el rendimiento con tasas actuales.', href: '/calculadora-plazo-fijo', cta: 'Simular inversión' },
  { icon: '↗', title: 'Actualizar por inflación', desc: 'Llevá un monto histórico a valores de hoy.', href: '/calculadora-actualizacion-inflacion-ipc', cta: 'Actualizar monto' },
  { icon: '⌂', title: 'Alquiler por ICL', desc: 'Estimá el próximo ajuste de tu contrato.', href: '/calculadora-actualizacion-alquiler-icl', cta: 'Calcular ajuste' },
];
---
<Layout image="/og/data-valores-bcra.jpg" imageWidth={1200} imageHeight={675} title={title} description={description} schema={schema} domain="data" pageType="dashboard">
  <Header slot="header" />

  <article class="vb">
    <nav class="vb-crumb" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Valores BCRA e INDEC</span>
    </nav>

    <!-- HERO -->
    <header class="vb-hero">
      <div class="vb-hero-copy">
        <span class="vb-kicker">Datos económicos de Argentina</span>
        <h1>Valores BCRA e INDEC</h1>
        <p class="vb-lead">Dólar, inflación, UVA y tasas en un solo tablero. Compará valores, entendé qué cambió y usalos directamente en tus cuentas.</p>
        <div class="vb-pills">
          <span class="vb-pill vb-pill-live"><span class="vb-dot" aria-hidden="true"></span><time data-updated datetime={builtAtISO}>Actualizado hoy, {buildClock}</time></span>
          <span class="vb-pill">4 fuentes oficiales y de mercado</span>
          <span class="vb-pill">Zona horaria: Argentina</span>
        </div>
      </div>
      <aside class="vb-status" aria-label="Estado de las fuentes">
        <div class="vb-status-top">
          <span class="vb-status-kicker">Estado de las fuentes</span>
          <span class="vb-status-badge">Operativas</span>
        </div>
        <ul class="vb-status-rows">
          {fuentes.map((f) => (
            <li><span class="vb-src-name"><span class="vb-dot vb-dot-static" aria-hidden="true"></span>{f.label}</span><span class="vb-src-fresh">{f.fresh}</span></li>
          ))}
        </ul>
        <button type="button" class="vb-refresh" id="vb-refresh">↻ Actualizar valores</button>
      </aside>
    </header>

    <!-- TABS -->
    <nav class="vb-tabs" aria-label="Secciones del tablero">
      <a href="#resumen" class="is-active">Resumen</a>
      <a href="#dolar">Dólar</a>
      <a href="#inflacion">Inflación e índices</a>
      <a href="#tasas">Tasas</a>
      <a href="#alertas">Alertas</a>
      <a href="#calculadoras">Calculadoras</a>
      <a href="#fuentes">Fuentes</a>
    </nav>

    {resumen && <p class="vb-resumen sr-only">{resumen}</p>}

    <!-- HOY, DE UN VISTAZO -->
    <section class="vb-section" id="resumen">
      <div class="vb-head">
        <div>
          <h2>Hoy, de un vistazo</h2>
          <p class="vb-sub">Los cuatro datos que más se consultan.</p>
        </div>
        <a class="vb-see" href="#dolar">Ver todos los valores →</a>
      </div>
      <div class="vb-glance">
        <div class="vb-gcard">
          <div class="vb-gcard-top"><span class="vb-gcard-label">Dólar blue</span><span class="vb-tag">Actual</span></div>
          <div class="vb-gcard-val" data-dolar-key="blue">{blueVenta ? `$${fmtAr(blueVenta)}` : '—'}</div>
          <div class="vb-gcard-note"><span data-brecha-key="blue">{blueBrecha != null ? pct1(blueBrecha) : '—'}</span> brecha con el oficial</div>
          <div class="vb-gcard-foot">Venta · DólarAPI · {fmtClock(dolarMap.blue?.fechaActualizacion) || 'hoy'}</div>
        </div>
        <div class="vb-gcard is-featured">
          <div class="vb-gcard-top"><span class="vb-gcard-label">Dólar CCL</span><span class="vb-tag">Actual</span></div>
          <div class="vb-gcard-val" data-dolar-key="contadoconliqui">{cclVenta ? `$${fmtAr(cclVenta)}` : '—'}</div>
          <div class="vb-gcard-note vb-note-pos"><span data-brecha-key="contadoconliqui">{cclBrecha != null ? '+' + pct1(cclBrecha) : '—'}</span> brecha · la mayor hoy</div>
          <div class="vb-gcard-foot">Venta · Mercado · {fmtClock(dolarMap.contadoconliqui?.fechaActualizacion) || 'hoy'}</div>
        </div>
        <div class="vb-gcard">
          <div class="vb-gcard-top"><span class="vb-gcard-label">Inflación mensual</span><span class="vb-tag">{ultimoIpc ? new Date(/^\d{4}-\d{2}-\d{2}$/.test(ultimoIpc.fecha) ? ultimoIpc.fecha + 'T00:00:00' : ultimoIpc.fecha).toLocaleDateString('es-AR', { month: 'short' }).replace('.', '').toUpperCase() : '—'}</span></div>
          <div class="vb-gcard-val" data-ipc-mensual>{ultimoIpc ? `${ultimoIpc.valor.toFixed(1).replace('.', ',')}%` : '—'}</div>
          <div class={`vb-gcard-note vb-note-${ipcDeltaTone}`}>{ipcDeltaPts ? `${ipcDeltaPts} vs. mes anterior` : 'IPC nacional'}</div>
          <div class="vb-gcard-foot">IPC nacional · INDEC · {ultimoIpc ? fmtShort(ultimoIpc.fecha) : '—'}</div>
        </div>
        <div class="vb-gcard">
          <div class="vb-gcard-top"><span class="vb-gcard-label">UVA</span><span class="vb-tag">Actual</span></div>
          <div class="vb-gcard-val" data-uva>{ultimaUva ? `$${fmtAr(ultimaUva.valor)}` : '—'}</div>
          <div class="vb-gcard-note">{uva30d != null ? `${(uva30d >= 0 ? '+' : '') + uva30d.toFixed(1).replace('.', ',')}% en 30 días` : 'Unidad de Valor Adquisitivo'}</div>
          <div class="vb-gcard-foot">Unidad · BCRA · {ultimaUva ? fmtShort(ultimaUva.fecha) : '—'}</div>
        </div>
      </div>
    </section>

    <!-- QUÉ CAMBIÓ HOY -->
    {execItems.length > 0 && (
      <section class="vb-section">
        <div class="vb-head">
          <div>
            <h2>Qué cambió hoy</h2>
            <p class="vb-sub">Contexto corto para saber dónde mirar.</p>
          </div>
        </div>
        <div class="vb-change-grid">
          {execItems.map((it) => (
            <div class="vb-change">
              <span class="vb-change-ico" aria-hidden="true">{it.icon}</span>
              <div class="vb-change-body">
                <p class="vb-change-text" set:html={it.html}></p>
                <a class="vb-change-cta" href={it.href}>{it.cta}</a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- COTIZACIONES DEL DÓLAR -->
    <section class="vb-section" id="dolar">
      <div class="vb-head">
        <div>
          <h2>Cotizaciones del dólar</h2>
          <p class="vb-sub">Compará compra, venta, brecha y fecha de cada mercado.</p>
        </div>
        <a class="vb-see" href="/conversor-dolar-argentina">Abrir conversor →</a>
      </div>
      <div class="vb-card vb-dolar-card" data-cv="venta">
        <div class="vb-card-bar">
          <span class="vb-card-title">Comparación de cotizaciones</span>
          <div class="vb-cv" role="group" aria-label="Compra o venta">
            <button type="button" class="vb-cv-btn is-active" data-cv="venta">Venta</button>
            <button type="button" class="vb-cv-btn" data-cv="compra">Compra</button>
          </div>
        </div>
        <div class="vb-dolar-scroll">
          <div class="vb-dolar-head" aria-hidden="true">
            <span>Cotización</span><span class="ta-r">Compra</span><span class="ta-r">Venta</span><span class="ta-r">Brecha</span><span>Actualización</span><span></span>
          </div>
          {dolarTable.map((r) => (
            <a class="vb-dolar-row" href={r.href}>
              <span class="vb-dolar-coin">
                <span class="vb-dolar-code">{r.code}</span>
                <span class="vb-dolar-name"><b>{r.short}</b><small>{r.subtitle}</small></span>
              </span>
              <span class="vb-dolar-compra ta-r">{r.compra != null ? `$${fmtAr(r.compra)}` : '—'}</span>
              <span class="vb-dolar-venta ta-r" data-dolar-key={r.key}>{r.venta != null ? `$${fmtAr(r.venta)}` : '—'}</span>
              <span class="ta-r">
                {r.isBase ? (
                  <span class="vb-brecha-base">Base</span>
                ) : r.isTaxed ? (
                  <span class="vb-brecha vb-brecha-tax">+30%</span>
                ) : (
                  <span class={`vb-brecha ${r.brechaNum && r.brechaNum > 0.05 ? 'vb-brecha-up' : ''}`} data-brecha-key={r.key}>{r.brechaNum != null ? (r.brechaNum > 0.05 ? '+' : '') + pct1(r.brechaNum) : '—'}</span>
                )}
              </span>
              <span class="vb-dolar-upd">{r.isBase ? <span class="vb-upd-badge">{r.updated}</span> : r.updated}</span>
              <span class="vb-dolar-chev" aria-hidden="true">›</span>
            </a>
          ))}
        </div>
        <p class="vb-dolar-note">ⓘ El dólar oficial muestra su fecha de observación porque no todas las fuentes actualizan con la misma frecuencia. Cada dato conserva su propia fuente y horario.</p>
      </div>
    </section>

    <!-- INFLACIÓN E ÍNDICES -->
    <section class="vb-section" id="inflacion">
      <div class="vb-head">
        <div>
          <h2>Inflación e índices</h2>
          <p class="vb-sub">Valores publicados por INDEC y BCRA, con su período exacto.</p>
        </div>
        <a class="vb-see" href="#historico">Ver series completas →</a>
      </div>
      <div class="vb-infl-grid">
        <div class="vb-card vb-ind-card">
          <div class="vb-card-bar"><span class="vb-card-title">Indicadores principales</span><span class="vb-badge-src">BCRA / INDEC</span></div>
          <div class="vb-ind-grid">
            {indicadores.map((ind: any) => (
              <div class="vb-ind">
                <span class="vb-ind-label">{ind.label}</span>
                <span class="vb-ind-val" data-ipc-anual={ind.anual ? '' : undefined} data-tasa={ind.icl ? 'icl' : undefined}>{ind.value}</span>
                <span class="vb-ind-sub">{ind.sub}</span>
              </div>
            ))}
          </div>
          {cerCard && (
            <div class={`vb-cer ${cerCard.future ? 'is-future' : ''}`}>
              <span class="vb-ind-label">{cerCard.label}</span>
              <span class="vb-ind-val">{cerCard.value}</span>
              <span class="vb-ind-sub">{cerCard.sub}</span>
            </div>
          )}
        </div>
        <div class="vb-card vb-uva-card">
          <div class="vb-card-bar">
            <span class="vb-card-title">Evolución UVA</span>
            <div class="vb-range" role="group" aria-label="Rango del gráfico">
              <button type="button" class="vb-range-btn is-active" data-range="6m">6 meses</button>
              <button type="button" class="vb-range-btn" data-range="1a">1 año</button>
              <button type="button" class="vb-range-btn" data-range="all">Todo</button>
            </div>
          </div>
          <div class="vb-uva-top">
            <div>
              <div class="vb-uva-big" id="vb-uva-big">{ultimaUva ? `$${fmtAr(ultimaUva.valor)}` : '—'}</div>
              <div class="vb-uva-delta" id="vb-uva-delta">{uva6m != null ? `${(uva6m >= 0 ? '+' : '') + uva6m.toFixed(1).replace('.', ',')}% en 6 meses` : ''}</div>
            </div>
            <span class="vb-uva-date" id="vb-uva-date">{ultimaUva ? fmtDate(ultimaUva.fecha) : ''}</span>
          </div>
          <div class="vb-chart-wrap">
            {uvaChart ? (
              <svg id="vb-uva-chart" class="vb-chart" viewBox={`0 0 ${uvaChart.w} ${uvaChart.h}`} preserveAspectRatio="none" role="img" aria-label="Evolución de la UVA">
                <defs>
                  <linearGradient id="uvaFill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.28" />
                    <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path id="vb-uva-area" d={uvaChart.area} fill="url(#uvaFill)" />
                <path id="vb-uva-line" d={uvaChart.line} fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                <g id="vb-uva-labels" class="vb-chart-x">
                  {uvaChart.labels.map((l) => (
                    <text x={l.x} y={uvaChart.h - 6} text-anchor="middle">{l.text}</text>
                  ))}
                </g>
              </svg>
            ) : <p class="vb-empty">Datos de la UVA no disponibles en este momento.</p>}
          </div>
        </div>
      </div>
    </section>

    <!-- TASAS DE PLAZO FIJO -->
    <section class="vb-section" id="tasas">
      <div class="vb-head">
        <div>
          <h2>Tasas de plazo fijo</h2>
          <p class="vb-sub">Ranking orientativo para depósitos a 30 días.</p>
        </div>
        <a class="vb-see" href="/comparador-plazo-fijo">Comparar todos los bancos →</a>
      </div>
      <div class="vb-card vb-pf-card">
        <div class="vb-card-bar"><span class="vb-card-title">Mejores tasas publicadas</span><span class="vb-badge-src">TNA</span></div>
        {plazoFijoRows.length ? (
          <div class="vb-pf-bars">
            {plazoFijoRows.slice(0, 5).map((x, i) => (
              <div class={`vb-pf-row${i === 0 ? ' is-top' : ''}`}>
                <span class="vb-pf-bank">{x.banco}</span>
                <span class="vb-pf-track" aria-hidden="true"><span class="vb-pf-fill" style={`width:${Math.max(10, Math.round((x.tna / (pfMax || x.tna)) * 100))}%`}></span></span>
                <span class="vb-pf-val" data-pf-top={i === 0 ? '' : undefined}>{String(x.tna).replace('.', ',')}%</span>
              </div>
            ))}
          </div>
        ) : (
          <p class="vb-empty">Las tasas no están disponibles en este momento — miralas en el comparador.</p>
        )}
        <div class="vb-pf-foot">
          <span>Última consulta: hoy, {buildClock}</span>
          <a href="/calculadora-plazo-fijo" class="vb-see">Simular rendimiento →</a>
        </div>
      </div>
    </section>

    <!-- ALERTAS -->
    <section class="vb-section" id="alertas">
      <div class="vb-alert-banner">
        <div class="vb-alert-copy">
          <span class="vb-alert-kicker">Alertas personalizadas</span>
          <h2>Te avisamos cuando cambie</h2>
          <p>Elegí un valor y la condición. La alerta se guarda en tu navegador.</p>
          <p class="vb-alert-fine">Sin pedir teléfono ni compartir tus datos.</p>
        </div>
        <form class="vb-alert-form" id="hcAlertForm" novalidate>
          <label class="vb-alert-field">
            <span class="vb-alert-lbl">Indicador</span>
            <select id="hcAlertMetric" class="vb-alert-input">
              <option value="blue">Dólar blue</option>
              <option value="oficial">Dólar oficial</option>
              <option value="bolsa">Dólar MEP</option>
              <option value="contadoconliqui">Dólar CCL</option>
              <option value="cripto">Dólar cripto</option>
              <option value="uva">UVA</option>
              <option value="icl">ICL (alquileres)</option>
              <option value="pfmax">Plazo fijo · TNA máxima</option>
            </select>
          </label>
          <label class="vb-alert-field" id="hcAlertOpField">
            <span class="vb-alert-lbl">Condición</span>
            <select id="hcAlertOp" class="vb-alert-input">
              <option value="gte">Supera</option>
              <option value="lte">Baja de</option>
            </select>
          </label>
          <label class="vb-alert-field" id="hcAlertValField">
            <span class="vb-alert-lbl">Valor</span>
            <input id="hcAlertVal" class="vb-alert-input" type="number" inputmode="decimal" step="any" placeholder="$ 1.550" />
          </label>
          <button type="submit" class="vb-alert-btn">Crear alerta</button>
        </form>
      </div>
      <p class="vb-alert-hint" id="hcAlertChangeHint" hidden>Te avisamos cuando este valor <strong>cambie</strong> respecto del que ves ahora.</p>
      <p class="vb-alert-msg" id="hcAlertMsg" role="status" aria-live="polite"></p>
      <ul class="vb-alert-list" id="hcAlertList" aria-label="Alertas activas"></ul>
    </section>

    <!-- USÁ ESTOS VALORES -->
    <section class="vb-section" id="calculadoras">
      <div class="vb-head">
        <div>
          <h2>Usá estos valores en una cuenta</h2>
          <p class="vb-sub">Calculadoras precargadas con el último dato disponible.</p>
        </div>
      </div>
      <div class="vb-usa-grid">
        {usaCards.map((c) => (
          <a class="vb-usa" href={c.href}>
            <span class="vb-usa-ico" aria-hidden="true">{c.icon}</span>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
            <span class="vb-usa-cta">{c.cta} →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- FUENTES Y METODOLOGÍA -->
    <section class="vb-section" id="fuentes">
      <div class="vb-card vb-sources">
        <h2>Fuentes y metodología</h2>
        <p>Cada indicador muestra fuente, fecha de observación y frecuencia propias. Los valores son informativos y pueden diferir de la cotización final de una entidad.</p>
        <div class="vb-source-badges">
          <a class="vb-source-badge" href="https://www.bcra.gob.ar" target="_blank" rel="noopener">BCRA</a>
          <a class="vb-source-badge" href="https://www.indec.gob.ar" target="_blank" rel="noopener">INDEC</a>
          <a class="vb-source-badge" href="https://dolarapi.com" target="_blank" rel="noopener">DólarAPI</a>
          <span class="vb-source-badge">Entidades financieras</span>
          <a class="vb-source-badge vb-source-more" href="#historico">Ver metodología →</a>
        </div>
      </div>
    </section>

    <!-- HISTÓRICO (crawleable, long-tail) -->
    <section class="vb-section vb-secondary" id="historico">
      <div class="vb-head"><div><h2>Evolución mes a mes: UVA e inflación</h2></div></div>
      <div class="vb-hist-grid">
        <div class="vb-card">
          <h3 class="vb-hist-h3">Valor de la UVA por mes (BCRA)</h3>
          {uvaHist.length ? (
            <table class="vb-hist-table">
              <thead><tr><th>Mes</th><th>UVA</th></tr></thead>
              <tbody>{uvaHist.map((p) => (<tr><td>{mesLargo(p.fecha)}</td><td>{'$' + fmtAr(p.valor)}</td></tr>))}</tbody>
            </table>
          ) : <p class="vb-empty">Datos no disponibles en este momento.</p>}
        </div>
        <div class="vb-card">
          <h3 class="vb-hist-h3">Inflación mensual (IPC INDEC)</h3>
          {ipcHist.length ? (
            <table class="vb-hist-table">
              <thead><tr><th>Mes</th><th>IPC</th></tr></thead>
              <tbody>{ipcHist.map((p) => (<tr><td>{mesLargo(p.fecha)}</td><td>{p.valor.toFixed(1) + '%'}</td></tr>))}</tbody>
            </table>
          ) : <p class="vb-empty">Datos no disponibles en este momento.</p>}
        </div>
      </div>
    </section>

    <!-- MÁS CALCULADORAS Y TABLAS (interlinking) -->
    <section class="vb-section vb-secondary">
      <div class="vb-head"><div><h2>Más calculadoras y tablas de datos</h2></div></div>
      <div class="vb-link-grid">
        <a href="/cuanto-perdio-tu-sueldo" class="vb-link"><span class="vb-link-title">¿Cuánto perdió tu sueldo?</span><span class="vb-link-desc">Tu poder de compra, hoy vs hace un año</span></a>
