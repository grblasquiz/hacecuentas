---
/**
 * Hub de decisión — "¿Cuáles son mis días fértiles?" (arquetipo ramificado).
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * SILO COMPARTIDO con /embarazo/semanas: aquel responde "de cuántas semanas
 * estoy" (ya hay embarazo); este responde lo de ANTES —buscarlo o datar la
 * concepción—. No se duplica nada: acá no hay trimestres, ni tamaño del bebé,
 * ni calendario de ecografías.
 *
 * ⚠️ YMYL — SALUD. El disclaimer ('health' + el override ES de
 * 'calculadora-ovulacion-dias-fertiles' en src/lib/disclaimers.ts) va en
 * fineprint, como PRIMER warn de cada caso y en la FAQ. Además, cada rama dice
 * explícitamente que esto NO es un método anticonceptivo y que el método del
 * ritmo falla ~24% en uso típico. No sacar.
 *
 * Patrón: la página sólo aporta datos (src/lib/hubs/dias-fertiles.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import DiasFertilesExperience from '../../components/generated/DiasFertilesExperience.astro';
import { hub, CICLO, PROB_POR_DIA, EDAD_MUJER, RIESGO_DOWN, EDAD_VARON } from '../../lib/hubs/dias-fertiles';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DiasFertilesExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

