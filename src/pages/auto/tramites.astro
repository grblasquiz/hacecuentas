---
/**
 * Hub de decisión — "Transferencia, licencia y multas: ¿cuánto sale cada trámite?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/tramites-auto.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, TRAMITE_MATH, INFRACCIONES, SCORING_TOPE } from '../../lib/hubs/tramites-auto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ M: TRAMITE_MATH, INFRACCIONES, SCORING_TOPE }}>
  (function () {
    const H = window.HC_HUB;

    const PROV_LABEL = { caba: 'CABA', pba: 'Buenos Aires', cba: 'Córdoba', sfe: 'Santa Fe' };
    const LIC_TIPO = {
      nueva: 'licencia nueva',
      renov: 'renovación',
      duplicado: 'duplicado',
      ampliacion: 'ampliación',
    };
    const num = (n) => Number(n || 0).toLocaleString('es-AR');

    H.onCompute(function (v, kase) {
      const id = kase && kase.id ? kase.id : 'transferir';
      const valor = Math.max(0, v.valor || 0);
      const prov = String(v.provincia || 'caba');
      const provTxt = PROV_LABEL[prov] || prov.toUpperCase();

      // ── Transferencia de un usado ─────────────────────────────────────────
      // Calcado de transfer-auto-costo-registro.ts: 1,5% de arancel + 1% de
      // sellado sobre la valuación, más los tres gastos fijos, más el extra
      // por cambio de radicación.
      if (id === 'transferir') {
        const t = M.transferencia;
        const cambio = String(v.radicacion || 'misma') === 'cambio';
        const arancel = Math.round(valor * t.arancelPct);
        const sellado = Math.round(valor * t.selladoPct);
        const fijos = t.verificacionPolicial + t.formularios + t.informeDominio;
        const extra = cambio ? t.extraRadicacion : 0;
        const total = Math.round(valor * t.arancelPct + valor * t.selladoPct + fijos + extra);

        // Trámites conexos: se pagan aparte y NO entran en el total del registro.
        const libre = M.libreDeuda[prov] || M.libreDeuda.caba;
        const r = M.radicacion;
        const recaratular = cambio ? r.fijo + valor * (r.sellosPct[prov] || r.sellosDefault) : 0;

        const rows = [
          { k: 'Valuación fiscal del vehículo', ref: 'Tabla del registro', v: valor },
          { k: 'Arancel del Registro Automotor (1,5%)', ref: 'DNRPA', v: arancel },
          { k: 'Impuesto de sellos provincial (1%)', ref: provTxt, v: sellado },
          { k: 'Verificación policial', ref: 'Policía', v: t.verificacionPolicial },
          { k: 'Formularios 08 y 12', ref: 'DNRPA', v: t.formularios },
          { k: 'Informe de dominio', ref: 'DNRPA', v: t.informeDominio },
        ];
        if (extra > 0) rows.push({ k: 'Extra por cambio de radicación', ref: 'DNRPA', v: extra });
        rows.push({ k: 'Costo total de la transferencia', ref: 'Total', v: total, extra: true });
        rows.push({ k: 'Certificado de libre deuda (trámite aparte)', ref: provTxt, v: libre });
        if (recaratular > 0) {
          rows.push({
            k: 'Recaratular el legajo en la nueva provincia (aparte)',
            ref: provTxt,
            v: Math.round(recaratular),
          });
        }

        const chart = [
          { label: 'Arancel DNRPA', value: arancel, tone: 'main' },
          { label: 'Sellos provinciales', value: sellado, tone: 'prop' },
          { label: 'Verificación y formularios', value: fijos, tone: 'exit' },
        ];
        if (extra > 0) chart.push({ label: 'Cambio de radicación', value: extra, tone: 'warn' });

        return {
          total: H.ars(total),
          sub:
            'Valuación ' + H.ars(valor) + ' · ' + provTxt +
            ' · impuestos ' + H.ars(arancel + sellado) + ' + fijos ' + H.ars(fijos + extra) +
            ' · libre deuda ' + H.ars(libre) + ' aparte',
          rows: rows,
          chart: chart,
        };
      }

      // ── Patentamiento de un 0km ───────────────────────────────────────────
      // Calcado de registro-dnrpa-auto-0km-arancel.ts.
      if (id === 'patentar') {
        const p = M.patentamiento;
        const pct = p.sellosPct[prov] != null ? p.sellosPct[prov] : 0.015;
        const dnrpa = p.dnrpaFijo + valor * p.dnrpaPct;
        const sellos = valor * pct;
        const total = dnrpa + sellos;
        const share = valor > 0 ? (total / valor) * 100 : 0;

        return {
          total: H.ars(total),
          sub:
            '0km de ' + H.ars(valor) + ' en ' + provTxt + ' · ' +
            (Math.round(share * 10) / 10).toString().replace('.', ',') +
            '% del valor de lista · sellos ' + (pct * 100).toFixed(1).replace('.', ',') + '%',
          rows: [
            { k: 'Valor del vehículo 0km', ref: 'Lista', v: valor },
            { k: 'Arancel fijo de inscripción inicial', ref: 'DNRPA', v: p.dnrpaFijo },
            { k: 'Arancel variable DNRPA (0,8% del valor)', ref: 'DNRPA', v: Math.round(valor * p.dnrpaPct) },
            { k: 'Arancel DNRPA total', ref: 'DNRPA', v: Math.round(dnrpa) },
            {
              k: 'Impuesto de sellos (' + (pct * 100).toFixed(1).replace('.', ',') + '%)',
              ref: provTxt,
              v: Math.round(sellos),
            },
            { k: 'Costo total de patentamiento', ref: 'Total', v: Math.round(total), extra: true },
          ],
          chart: [
            { label: 'Arancel DNRPA', value: Math.round(dnrpa), tone: 'main' },
            { label: 'Sellos provinciales', value: Math.round(sellos), tone: 'prop' },
          ],
        };
      }

      // ── Licencia de conducir ──────────────────────────────────────────────
      // Calcado de licencia-conducir-costo-categoria-b1-a.ts: arancel base por
      // tipo de trámite × multiplicador de categoría.
      if (id === 'licencia') {
        const l = M.licencia;
        const tipo = String(v.licenciaTipo || 'nueva');
        const cat = String(v.licenciaCat || 'b');
        const base = l.base[tipo] != null ? l.base[tipo] : l.base.nueva;
        const mult = l.mult[cat] != null ? l.mult[cat] : 1;
        const costo = base * mult;
        const recargo = costo - base;

        const rows = [
          { k: 'Arancel base — ' + (LIC_TIPO[tipo] || tipo), ref: 'Municipio', v: base },
          {
            k: 'Recargo por categoría ' + cat.toUpperCase() + ' (×' + String(mult).replace('.', ',') + ')',
            ref: 'ANSV',
            v: Math.round(recargo),
          },
          { k: 'Costo total del trámite', ref: 'Total', v: Math.round(costo), extra: true },
        ];

        const chart = [{ label: 'Arancel base municipal', value: base, tone: 'main' }];
        if (recargo > 0) chart.push({ label: 'Recargo por categoría', value: Math.round(recargo), tone: 'warn' });

        return {
          total: H.ars(costo),
          sub:
            (LIC_TIPO[tipo] || tipo) + ' categoría ' + cat.toUpperCase() +
            (recargo > 0 ? ' · recargo del ' + Math.round((mult - 1) * 100) + '% por exámenes adicionales' : ' · sin recargo de categoría') +
            ' · vigencia 5 años la primera, luego 1 a 5 según edad',
          rows: rows,
          chart: chart,
        };
      }

      // ── Multa de tránsito ─────────────────────────────────────────────────
      // Calcado de multa-transito-puntos-licencia.ts: promedio del rango de UF
      // por el valor de la Unidad Fija.
      const inf = INFRACCIONES[String(v.infraccion || '1')] || INFRACCIONES['1'];
      const uf = Math.max(0, v.valorUf || 0);
      const ufPromedio = (inf.ufMin + inf.ufMax) / 2;
      const monto = ufPromedio * uf;
      const montoMin = inf.ufMin * uf;
      const montoMax = inf.ufMax * uf;
      const voluntario = monto / 2;

      return {
        total: H.ars(monto),
        sub:
          inf.nombre + ' · ' + inf.ufMin + ' a ' + inf.ufMax + ' UF × ' + H.ars(uf) +
          ' · ' + inf.puntos + ' de ' + SCORING_TOPE + ' puntos del Scoring · rango ' +
          H.ars(montoMin) + ' a ' + H.ars(montoMax),
        rows: [
          { k: 'Multa mínima del rango (' + inf.ufMin + ' UF)', ref: 'Ley 24.449', v: Math.round(montoMin) },
          { k: 'Multa estimada (promedio ' + ufPromedio + ' UF)', ref: 'Ley 24.449', v: Math.round(monto), extra: true },
          { k: 'Multa máxima del rango (' + inf.ufMax + ' UF)', ref: 'Ley 24.449', v: Math.round(montoMax) },
          { k: 'Pago voluntario estimado (50% de descuento)', ref: 'Juzgado de faltas', v: Math.round(voluntario) },
          {
            k: 'Puntos que se descuentan del Scoring',
            ref: 'ANSV',
            v: inf.puntos,
            format: 'unit',
            unit: 'de ' + SCORING_TOPE + ' puntos',
          },
          {
            k: 'Puntos que te quedan',
            ref: 'ANSV',
            v: SCORING_TOPE - inf.puntos,
            format: 'unit',
            unit: 'puntos',
          },
        ],
        chart: [
          { label: 'Piso del rango de UF', value: Math.round(montoMin), tone: 'main' },
          { label: 'Margen del juez de faltas', value: Math.round(montoMax - montoMin), tone: 'warn' },
        ],
      };
    });
  })();
</script>
