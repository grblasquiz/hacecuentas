---
/**
 * Hub de decisión — "¿Me conviene tener auto o usar Uber?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/auto-vs-uber.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  CASE_MATH,
  CITY_DATA,
  APP_TARIFA,
  MEDIDO_BASE_HORA,
  MEDIDO_ESCALON,
  DEPRECIACION_ANUAL,
  DEPRECIACION_PISO,
  CO2_POR_LITRO,
} from '../../lib/hubs/auto-vs-uber';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const CONST = {
  app: APP_TARIFA,
  medidoBase: MEDIDO_BASE_HORA,
  medidoEscalon: MEDIDO_ESCALON,
  dep: DEPRECIACION_ANUAL,
  depPiso: DEPRECIACION_PISO,
  co2: CO2_POR_LITRO,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MATH: CASE_MATH, CITY: CITY_DATA, K: CONST }}>
  (function () {
    const H = window.HC_HUB;
    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });

    /**
     * Estacionamiento medido: tarifa progresiva del sistema Blinkay.
     * La hora n vale base * 1,3^(min(n,4)-1); de la 5ª en adelante se
     * estabiliza en el valor de la 4ª. Espejo de la fórmula original
     * `estacionamiento-medido-hora-caba-zona.ts`.
     */
    function costoMedido(horas) {
      const h = horas > 0 ? horas : 0;
      const rate = (n) => K.medidoBase * Math.pow(K.medidoEscalon, Math.min(n, 4) - 1);
      let total = 0;
      const full = Math.floor(h);
      for (let n = 1; n <= full; n++) total += rate(n);
      const frac = h - full;
      if (frac > 0) total += rate(full + 1) * frac;
      return total;
    }

    H.onCompute(function (v, kase) {
      const m = MATH[kase?.id] || MATH.apps;
      const c = CITY[v.ciudad] || CITY.caba;

      const viajes = Math.max(0, Number(v.viajes) || 0);
      const km = Math.max(0, Number(v.km) || 0);
      const minutos = Math.max(0, Number(v.minutos) || 0);
      const consumo = Math.max(0, Number(v.consumo) || 0);
      const antiguedad = Math.max(0, Number(v.antiguedad) || 0);

      // --- El auto propio ---
      // Depreciación: 8% anual con piso del 40% del valor de origen. Mismo
      // factor que las tablas de valuación fiscal automotor.
      const factorDep = Math.max(K.depPiso, 1 - antiguedad * K.dep);
      const valuacion = v.valorAuto * factorDep;
      const patenteMes = (valuacion * (c.alicuota / 100)) / 12;
      const seguroMes = v.seguro;
      const serviceMes = v.service / 12;
      // Si ya tocó el piso del 40%, el auto dejó de perder valor de tabla.
      const deprecMes = factorDep > K.depPiso ? (v.valorAuto * K.dep) / 12 : 0;
      const medidoMes = costoMedido(v.horasMedido) * v.diasMedido * m.medido;

      const kmMes = viajes * km;
      const litrosMes = (kmMes * consumo) / 100;
      const naftaMes = litrosMes * c.nafta;
      const naftaPorViaje = ((km * consumo) / 100) * c.nafta;

      const fijosMes = patenteMes + seguroMes + serviceMes + deprecMes + medidoMes;
      const autoMes = fijosMes + naftaMes;

      // --- La alternativa sin auto ---
      let porViaje = 0;
      let altLabel = 'Uber';
      if (m.modo === 'remis') {
        porViaje = Math.max(c.remis.bandera + km * c.remis.porKm, c.remis.minimo);
        altLabel = 'Taxi o remis';
      } else if (m.modo === 'boleto') {
        porViaje = v.boleto;
        altLabel = 'Transporte público';
      } else {
        porViaje = (K.app.bajada + km * K.app.porKm + minutos * K.app.porMin) * m.factorApp;
        altLabel = kase?.id === 'didi' ? 'DiDi' : kase?.id === 'cabify' ? 'Cabify' : 'Uber';
      }
      const altMes = porViaje * viajes;

      // --- El umbral: dónde se cruzan las dos curvas ---
      // fijos + nafta*n = porViaje*n  →  n = fijos / (porViaje - naftaPorViaje)
      const margen = porViaje - naftaPorViaje;
      const hayCruce = margen > 0;
      const equilibrio = hayCruce ? fijosMes / margen : Infinity;
      const equilibrioRed = hayCruce ? Math.ceil(equilibrio) : 0;

      const conviene = autoMes < altMes ? 'auto' : 'alt';
      const diferencia = Math.abs(autoMes - altMes);

      const rows = [
        { k: 'Patente (' + c.provincia + ')', ref: nf(c.alicuota, 1) + '% de la valuación', v: patenteMes },
        { k: 'Seguro', v: seguroMes },
        { k: 'Service, cubiertas y VTV', ref: 'prorrateado', v: serviceMes },
        { k: 'Depreciación del vehículo', ref: '8% anual, piso 40%', v: deprecMes },
        { k: 'Nafta súper', ref: nf(c.nafta) + ' $/L en ' + c.provincia, v: naftaMes },
        { k: 'Estacionamiento medido', ref: 'tarifa progresiva', v: medidoMes },
        { k: 'Total del auto propio por mes', v: autoMes, extra: true },
        { k: altLabel + ' por mes', ref: nf(porViaje) + ' por viaje', v: altMes, extra: true },
        {
          k: conviene === 'auto' ? 'Te ahorra el auto propio' : 'Te ahorra ' + altLabel,
          v: diferencia,
        },
        {
          k: 'Punto de equilibrio',
          ref: 'a partir de acá conviene el auto',
          v: equilibrioRed,
          format: 'unit',
          unit: 'viajes/mes',
          extra: true,
        },
        { k: 'Kilómetros por mes', v: kmMes, format: 'unit', unit: 'km', decimals: 0 },
        { k: 'Litros de nafta por mes', v: litrosMes, format: 'unit', unit: 'L', decimals: 1 },
        { k: 'CO₂ que emite el auto', ref: '2,31 kg por litro', v: litrosMes * K.co2, format: 'unit', unit: 'kg', decimals: 0 },
        { k: 'Costo por kilómetro del auto', v: kmMes > 0 ? autoMes / kmMes : 0 },
      ];

      // --- Gráfico posicional: el eje son viajes por mes ---
      const tope = hayCruce
        ? Math.max(Math.ceil(equilibrio * 1.4), Math.ceil(viajes * 1.15), 10)
        : Math.max(Math.ceil(viajes * 1.3), 10);
      const corte = hayCruce ? Math.min(equilibrio, tope) : tope;

      const chart = hayCruce
        ? [
            { label: 'Conviene ' + altLabel, value: corte, tone: 'good', from: 0, to: corte },
            { label: 'Conviene el auto propio', value: Math.max(0, tope - corte), tone: 'warn', from: corte, to: tope },
          ]
        : [{ label: 'Conviene ' + altLabel + ' siempre', value: tope, tone: 'good', from: 0, to: tope }];

      const total = hayCruce ? nf(equilibrioRed) + ' viajes/mes' : 'Nunca';

      const sub = hayCruce
        ? 'Hacés ' + nf(viajes) + ' viajes/mes: ' +
          (conviene === 'auto'
            ? 'te conviene el auto propio, ahorrás ' + H.ars(diferencia) + '/mes'
            : 'te conviene ' + altLabel + ', ahorrás ' + H.ars(diferencia) + '/mes') +
          ' · auto ' + H.ars(autoMes) + ' vs ' + altLabel + ' ' + H.ars(altMes)
        : 'Con estos números cada viaje en ' + altLabel + ' sale menos que la nafta que consume tu auto: no hay punto de equilibrio.';

      return {
        total: total,
        sub: sub,
        rows: rows,
        chart: chart,
        position: tope > 0 ? Math.min(100, (viajes / tope) * 100) : 0,
        positionLabel:
          nf(viajes) + ' viajes/mes' +
          (hayCruce ? ' · equilibrio en ' + nf(equilibrioRed) + ' viajes/mes' : ' · sin punto de equilibrio'),
      };
    });
  })();
</script>
