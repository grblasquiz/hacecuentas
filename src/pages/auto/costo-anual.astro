---
/**
 * Hub de decisión — "¿Cuánto me cuesta por año tener el auto?"
 * Es el paraguas (TCO) del silo /auto. Reemplaza 8 URLs sueltas (hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/costo-auto.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CostoAnualAutoExperience from '../../components/generated/CostoAnualAutoExperience.astro';
import {
  hub,
  CASE_MATH,
  FISCAL,
  PROVINCIAS,
  ALICUOTAS,
  NAFTA_POR_PROVINCIA,
  NAFTA_NACIONAL,
  VTV_EDAD_MINIMA,
} from '../../lib/hubs/costo-auto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const CONST = {
  fiscal: FISCAL,
  vtvEdad: VTV_EDAD_MINIMA,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CostoAnualAutoExperience data={hub} />
  <Footer />
</Layout>

