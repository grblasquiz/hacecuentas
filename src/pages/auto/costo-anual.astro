---
/**
 * Hub de decisión — "¿Cuánto me cuesta por año tener el auto?"
 * Es el paraguas (TCO) del silo /auto. Reemplaza 8 URLs sueltas (hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/costo-auto.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  CASE_MATH,
  FISCAL,
  PROVINCIAS,
  ALICUOTAS,
  NAFTA_POR_PROVINCIA,
  NAFTA_NACIONAL,
  VTV_EDAD_MINIMA,
} from '../../lib/hubs/costo-auto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const CONST = {
  fiscal: FISCAL,
  vtvEdad: VTV_EDAD_MINIMA,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ MATH: CASE_MATH, PROV: PROVINCIAS, ALIC: ALICUOTAS, NAFTA: NAFTA_POR_PROVINCIA, NAFTA_NAC: NAFTA_NACIONAL, K: CONST }}
>
  (function () {
    const H = window.HC_HUB;
    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });

    /**
     * Mantenimiento estimado — espejo de `costo-mantenimiento-auto-anual-km.ts`:
     *   pct = 0,03 + edad×0,005 + max(0, (km − 15.000)/15.000) × 0,01, topeado en 10%
     * Se aplica sobre el valor del auto. Sólo se usa si el usuario deja el campo en 0.
     */
    function mantenimientoEstimado(valor, edad, km) {
      const pct = 0.03 + edad * 0.005 + Math.max(0, (km - 15000) / 15000) * 0.01;
      return valor * Math.min(0.1, pct);
    }

    H.onCompute(function (v, kase) {
      const m = MATH[kase && kase.id] || MATH.usado;
      const provKey = String(v.provincia || 'buenos-aires');
      const prov = PROV[provKey] || PROV['buenos-aires'];
      const alic = (ALIC[provKey] || ALIC['buenos-aires']).alicuota; // en %

      const valor = Math.max(0, Number(v.valorAuto) || 0);
      const antiguedad = Math.max(0, Number(v.antiguedad) || 0);
      const km = Math.max(0, Number(v.kmAnuales) || 0);
      const consumo = Math.max(0, Number(v.consumo) || 0);
      const seguroAnual = Math.max(0, Number(v.seguroMensual) || 0) * 12;
      const cocheraAnual = Math.max(0, Number(v.cocheraMensual) || 0) * 12;
      const mantIngresado = Math.max(0, Number(v.mantenimientoAnual) || 0);

      // --- Combustible: precio de la provincia, con fallback al promedio país ---
      const tipo = String(v.combustible || 'Nafta Súper');
      const tabla = NAFTA[prov.nafta] || {};
      const precioLitro = Number(tabla[tipo] || NAFTA_NAC[tipo] || NAFTA_NAC['Nafta Súper']);
      const litros = (km * consumo) / 100;
      const naftaAnual = litros * precioLitro;

      // --- Patente ---
      // OJO: el campo es "cuánto vale tu auto HOY", así que la valuación fiscal
      // ya viene depreciada. Volver a aplicarle la quita por antigüedad sería
      // descontar dos veces. Mismo criterio que `simulador-costo-mantener-auto`,
      // que le pasa el valor de mercado directo a la fórmula de patente.
      const patenteAnual = valor * (alic / 100);

      // --- Depreciación económica del año que viene, sobre el valor de hoy ---
      // Tasa según el caso (8% tabla fiscal · 20% primer año · 12% uso intensivo).
      // El piso del 40% de la tabla fiscal se alcanza a los 7,5 años (0,08 × 7,5
      // = 0,60): a partir de ahí el auto dejó de depreciar a efectos de tabla y
      // lo tratamos como 0, igual que hace /auto/auto-o-uber.
      const pisoAlcanzado = m.piso > 0 && antiguedad * K.fiscal.tasa >= 1 - K.fiscal.piso;
      const depreciacionAnual = pisoAlcanzado ? 0 : valor * m.tasa;
      const valorResidual = valor - depreciacionAnual;

      // --- VTV prorrateada ---
      const vtvAnual = m.vtv && antiguedad >= K.vtvEdad ? prov.vtv : 0;

      // --- Mantenimiento ---
      const mantAnual = mantIngresado > 0 ? mantIngresado : mantenimientoEstimado(valor, antiguedad, km);

      const totalAnual =
        naftaAnual + seguroAnual + patenteAnual + depreciacionAnual + vtvAnual + mantAnual + cocheraAnual;
      const totalMensual = totalAnual / 12;
      const totalDiario = totalAnual / 365;

      const porKmReal = km > 0 ? totalAnual / km : 0;
      const porKmBolsillo = km > 0 ? (totalAnual - depreciacionAnual) / km : 0;
      const naftaPorKm = (consumo / 100) * precioLitro;

      const rows = [
        { k: 'Combustible', ref: nf(precioLitro) + ' $/L en ' + prov.nombre, v: naftaAnual },
        { k: 'Seguro', ref: 'tu cuota × 12', v: seguroAnual },
        {
          k: 'Patente en ' + prov.nombre,
          ref: nf(alic, 1) + '% sobre la valuación fiscal',
          v: patenteAnual,
        },
        {
          k: 'Service y mantenimiento',
          ref: mantIngresado > 0 ? 'lo que cargaste' : 'estimado por antigüedad y km',
          v: mantAnual,
        },
        { k: 'VTV', ref: vtvAnual > 0 ? 'desde los ' + K.vtvEdad + ' años' : 'no corresponde', v: vtvAnual },
        { k: 'Cochera', v: cocheraAnual },
        {
          k: 'Depreciación (valor que pierde el auto)',
          ref: pisoAlcanzado
            ? 'ya tocó el piso del ' + nf(K.fiscal.piso * 100, 0) + '% de tabla'
            : nf(m.tasa * 100, 0) + '% anual sobre el valor de hoy',
          v: depreciacionAnual,
        },
        { k: 'Total por año', v: totalAnual, extra: true },
        { k: 'Total por mes', v: totalMensual, extra: true },
        { k: 'Te cuesta por día, lo uses o no', v: totalDiario },
        { k: 'Costo por kilómetro REAL (con depreciación)', v: porKmReal, extra: true, decimals: 2 },
        { k: 'Costo por kilómetro de bolsillo (sin depreciación)', v: porKmBolsillo, decimals: 2 },
        { k: 'Sólo el combustible por kilómetro', v: naftaPorKm, decimals: 2 },
        { k: 'Litros al año', v: litros, format: 'unit', unit: 'L', decimals: 0 },
        { k: 'Valor del auto dentro de un año', v: valorResidual },
      ];

      // Gráfico: composición del gasto anual (donut con leyenda).
      const chart = [
        { label: 'Depreciación', value: Math.round(depreciacionAnual), tone: 'bad' },
        { label: 'Combustible', value: Math.round(naftaAnual), tone: 'main' },
        { label: 'Seguro', value: Math.round(seguroAnual), tone: 'warn' },
        { label: 'Patente', value: Math.round(patenteAnual), tone: 'prop' },
        { label: 'Service', value: Math.round(mantAnual), tone: 'exit' },
        { label: 'VTV', value: Math.round(vtvAnual), tone: 'good' },
        { label: 'Cochera', value: Math.round(cocheraAnual), tone: 'good' },
      ].filter(function (s) {
        return s.value > 0;
      });

      const mayor = chart.slice().sort(function (a, b) {
        return b.value - a.value;
      })[0];
      const pctMayor = totalAnual > 0 && mayor ? (mayor.value / totalAnual) * 100 : 0;

      const sub =
        'Son ' + H.ars(totalMensual) + ' por mes y ' + H.ars(totalDiario) + ' por día. ' +
        'Cada kilómetro te sale ' + H.ars(porKmReal) + ' contando la depreciación, y ' +
        H.ars(porKmBolsillo) + ' sin contarla' +
        (mayor
          ? ' · lo que más pesa es ' + mayor.label.toLowerCase() + ', con el ' + nf(pctMayor, 0) + '% del total'
          : '');

      return {
        total: H.ars(totalAnual),
        sub: sub,
        rows: rows,
        chart: chart,
        decimals: 0,
      };
    });
  })();
</script>
