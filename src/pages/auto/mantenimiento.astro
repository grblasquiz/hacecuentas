---
/**
 * Hub de decisión — "Neumáticos, aceite y service: ¿cuándo y cuánto?" (arquetipo RAMIFICADO).
 * Absorbe 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/mantenimiento.ts) y su compute().
 * El chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MantenimientoAutoExperience from '../../components/generated/MantenimientoAutoExperience.astro';
import { hub, A_PASCAL, ACEITE, CORREA } from '../../lib/hubs/mantenimiento';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <MantenimientoAutoExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ PA: A_PASCAL, ACEITE, CORREA }}>
  (function () {
    const H = window.HC_HUB;

    // NADA acá es plata. El runtime hace Object.assign(base, over): una fila
    // que omite `format` no hereda el del resultado y saldría con "$".
    const MM = { format: 'unit', unit: 'mm', decimals: 1 };
    const PCT = { format: 'unit', unit: '%', decimals: 1 };
    const PSI = { format: 'unit', unit: 'PSI', decimals: 1 };
    const BAR = { format: 'unit', unit: 'bar', decimals: 3 };
    const KPA = { format: 'unit', unit: 'kPa', decimals: 1 };
    const KM = { format: 'unit', unit: 'km' };
    const CCA = { format: 'unit', unit: 'CCA' };
    const ML = { format: 'unit', unit: 'ml', decimals: 1 };
    const L = { format: 'unit', unit: 'L', decimals: 1 };

    const dec = (n, d) => (Number(n) || 0).toFixed(d).replace('.', ',');
    const miles = (n) => Math.round(n || 0).toLocaleString('es-AR');

    /** "205/55 R16" → {ancho, perfil, rin, label}. null si no parsea. */
    function parseMedida(txt) {
      const m = String(txt || '').match(/(\d{2,3})\s*[\/x]\s*(\d{2})\s*[rR]?\s*(\d{2}(?:[.,]\d)?)/);
      if (!m) return null;
      const ancho = Number(m[1]);
      const perfil = Number(m[2]);
      const rin = Number(String(m[3]).replace(',', '.'));
      if (!(ancho >= 100 && ancho <= 400)) return null;
      if (!(perfil >= 20 && perfil <= 90)) return null;
      if (!(rin >= 12 && rin <= 24)) return null;
      return { ancho, perfil, rin, label: ancho + '/' + perfil + ' R' + rin };
    }

    /** Diámetro total en mm: 2 × altura de flanco + llanta en mm. */
    const diametro = (t) => (t.ancho * t.perfil) / 100 * 2 + t.rin * 25.4;

    const pos = (val, max) => Math.min(100, Math.max(0, (val / max) * 100));

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'medida';
      const rows = [];

      // ---------------------------------------------------------------- medida
      if (id === 'medida') {
        const MAX = 6; // tope de la escala, en % de desviación
        const t1 = parseMedida(v.medidaOriginal);
        const t2 = parseMedida(v.medidaNueva);
        const franjas = [
          { label: 'Excelente (±1,5%)', value: 1.5, from: 0, to: 1.5, tone: 'good' },
          { label: 'Aceptable (±3%)', value: 1.5, from: 1.5, to: 3, tone: 'warn' },
          { label: 'Fuera de tolerancia', value: 3, from: 3, to: MAX, tone: 'bad' },
        ];

        if (!t1) {
          return {
            total: 'Medida inválida',
            sub: 'Escribí la medida como aparece en el flanco: ancho/perfil Rllanta, por ejemplo 205/55 R16.',
            rows: [],
            chart: franjas,
            format: 'unit', unit: '%', decimals: 1,
            position: 0,
            positionLabel: 'Cargá una medida válida',
          };
        }

        const d1 = diametro(t1);
        const flanco1 = (t1.ancho * t1.perfil) / 100;
        rows.push({ k: 'Diámetro del ' + t1.label, v: d1, extra: true, ...MM });
        rows.push({ k: 'Altura de flanco del original', v: flanco1, ...MM });

        if (!t2) {
          rows.push({ k: 'Vueltas por kilómetro', ref: '1.000.000 mm ÷ (π × diámetro)', v: 1000000 / (Math.PI * d1), format: 'plain' });
          return {
            total: dec(d1, 1) + ' mm',
            sub: 'El ' + t1.label + ' tiene ' + dec(d1, 1) + ' mm de diámetro y ' + dec(flanco1, 1) +
              ' mm de flanco. Cargá una segunda medida para ver si es equivalente.',
            rows: rows,
            chart: franjas,
            format: 'unit', unit: '%', decimals: 1,
            position: 0,
            positionLabel: 'Sin medida alternativa para comparar',
          };
        }

        const d2 = diametro(t2);
        const dif = ((d2 - d1) / d1) * 100;
        const abs = Math.abs(dif);
        const signo = dif > 0 ? '+' : dif < 0 ? '−' : '';
        const flanco2 = (t2.ancho * t2.perfil) / 100;

        rows.push({ k: 'Diámetro del ' + t2.label, v: d2, extra: true, ...MM });
        rows.push({ k: 'Altura de flanco de la alternativa', v: flanco2, ...MM });
        rows.push({ k: 'Diferencia de diámetro', v: d2 - d1, ...MM });
        rows.push({ k: 'Desviación', ref: 'sobre el diámetro original', v: dif, extra: true, ...PCT });
        rows.push({ k: 'Ancho de banda: diferencia', v: t2.ancho - t1.ancho, format: 'unit', unit: 'mm' });
        // A 100 km/h reales, lo que va a mostrar el velocímetro con la medida nueva.
        rows.push({ k: 'Velocímetro a 100 km/h reales', ref: 'con la medida nueva', v: 100 / (1 + dif / 100), format: 'unit', unit: 'km/h', decimals: 1 });

        const juicio = abs <= 1.5
          ? 'Equivalencia excelente: el velocímetro casi no se entera.'
          : abs <= 3
            ? 'Equivalente dentro de la tolerancia del 3%, pero el velocímetro ya se corre un poco.'
            : 'Fuera de tolerancia: más de 3% de desviación. No es una medida equivalente.';

        return {
          total: signo + dec(abs, 1) + '%',
          sub: t1.label + ' → ' + t2.label + ': ' + dec(d1, 1) + ' mm contra ' + dec(d2, 1) + ' mm. ' + juicio +
            ' Verificá igual que el ancho entre en la llanta y no roce.',
          rows: rows,
          chart: franjas,
          format: 'unit', unit: '%', decimals: 1,
          position: pos(abs, MAX),
          positionLabel: 'Desviación ' + signo + dec(abs, 1) + '% · límite práctico 3%',
        };
      }

      // --------------------------------------------------------------- presion
      if (id === 'presion') {
        const MAX = 60; // tope de la escala, en PSI
        const valor = Math.max(0, v.presionValor || 0);
        const u = PA[v.presionUnidad] ? v.presionUnidad : 'psi';
        // Todo pasa por pascales con factores exactos: sin redondeos intermedios.
        const pascales = valor * PA[u];
        const psi = pascales / PA.psi;
        const bar = pascales / PA.bar;
        const kpa = pascales / PA.kpa;

        rows.push({ k: 'En PSI', v: psi, extra: true, ...PSI });
        rows.push({ k: 'En bar', v: bar, extra: true, ...BAR });
        rows.push({ k: 'En kPa', v: kpa, ...KPA });
        rows.push({ k: 'En pascales', ref: 'unidad base del SI', v: pascales, format: 'plain' });
        rows.push({ k: 'Factor exacto psi → bar', v: PA.psi / PA.bar, format: 'unit', unit: 'bar/psi', decimals: 6 });

        const zona = psi < 28
          ? 'Es baja para un auto de pasajeros: subinfla el desgaste de los hombros y el consumo.'
          : psi <= 36
            ? 'Está dentro del rango habitual de un auto de pasajeros.'
            : psi <= 45
              ? 'Es propia de una SUV o pickup, sobre todo con carga.'
              : 'Es alta: revisá la especificación del vehículo antes de dejarla así.';

        return {
          total: dec(psi, 1) + ' PSI',
          sub: dec(valor, 2) + ' ' + (u === 'kpa' ? 'kPa' : u === 'bar' ? 'bar' : 'PSI') + ' = ' + dec(psi, 1) +
            ' PSI = ' + dec(bar, 3) + ' bar = ' + dec(kpa, 1) + ' kPa. ' + zona +
            ' Medí siempre en frío y seguí la etiqueta del auto, no el máximo del neumático.',
          rows: rows,
          chart: [
            { label: 'Baja', value: 28, from: 0, to: 28, tone: 'warn' },
            { label: 'Auto de pasajeros', value: 8, from: 28, to: 36, tone: 'good' },
            { label: 'SUV / pickup con carga', value: 9, from: 36, to: 45, tone: 'warn' },
            { label: 'Alta', value: 15, from: 45, to: MAX, tone: 'bad' },
          ],
          format: 'unit', unit: 'PSI', decimals: 1,
          position: pos(psi, MAX),
          positionLabel: dec(psi, 1) + ' PSI · ' + dec(bar, 2) + ' bar',
        };
      }

      // ---------------------------------------------------------------- aceite
      if (id === 'aceite') {
        const MAX = 130; // tope de la escala, en % del intervalo consumido
        const tipo = ACEITE[v.tipoAceite] ? v.tipoAceite : 'semi';
        const int = ACEITE[tipo].km;
        const km = Math.max(0, v.kmActual || 0);
        const ultimo = Math.max(0, Math.min(v.kmUltimoCambio || 0, km));
        const prox = ultimo + int;
        const recorridos = km - ultimo;
        const faltan = prox - km;
        const usado = int > 0 ? (recorridos / int) * 100 : 0;

        rows.push({ k: 'Intervalo del aceite ' + ACEITE[tipo].label.toLowerCase(), v: int, extra: true, ...KM });
        rows.push({ k: 'Último cambio', v: ultimo, ...KM });
        rows.push({ k: 'Recorridos desde el cambio', v: recorridos, ...KM });
        rows.push({ k: 'Próximo cambio', v: prox, extra: true, ...KM });
        rows.push({ k: faltan >= 0 ? 'Te faltan' : 'Estás pasado', v: Math.abs(faltan), ...KM });
        rows.push({ k: 'Intervalo consumido', v: usado, ...PCT });

        const juicio = usado >= 100
          ? 'Ya pasaste el intervalo: cambiá el aceite y el filtro cuanto antes.'
          : usado >= 80
            ? 'Estás cerca del límite: agendá el service.'
            : 'Todavía tenés margen.';

        return {
          total: miles(prox) + ' km',
          sub: 'Con aceite ' + ACEITE[tipo].label.toLowerCase() + ' el intervalo es de ' + miles(int) +
            ' km, así que el próximo cambio va cerca de los ' + miles(prox) + ' km. ' + juicio +
            ' Si el manual pide menos, manda el manual; y cambialo igual una vez al año aunque hagas pocos kilómetros.',
          rows: rows,
          chart: [
            { label: 'Con margen', value: 70, from: 0, to: 70, tone: 'good' },
            { label: 'Cerca del cambio', value: 30, from: 70, to: 100, tone: 'warn' },
            { label: 'Pasado', value: 30, from: 100, to: MAX, tone: 'bad' },
          ],
          format: 'unit', unit: '%', decimals: 0,
          position: pos(usado, MAX),
          positionLabel: dec(usado, 0) + '% del intervalo consumido',
        };
      }

      // ---------------------------------------------------------------- correa
      if (id === 'correa') {
        const MAX = 130;
        const marca = CORREA[v.marcaCorrea] ? v.marcaCorrea : 'generico';
        const int = CORREA[marca].km;
        const km = Math.max(0, v.kmActual || 0);

        if (int === 0) {
          rows.push({ k: 'Kilómetros actuales', v: km, ...KM });
          rows.push({ k: 'Intervalo de cambio programado', ref: 'usa cadena', v: 0, ...KM });
          return {
            total: 'Sin cambio programado',
            sub: CORREA[marca].label + ': el motor usa cadena de distribución, así que no hay kilometraje fijo de cambio. ' +
              'Actuá sólo si escuchás cascabeleo, salta un testigo o el motor pierde sincronismo.',
            rows: rows,
            chart: [
              { label: 'Cadena: sin plan de cambio', value: MAX, from: 0, to: MAX, tone: 'good' },
            ],
            format: 'unit', unit: '%', decimals: 0,
            position: 0,
            positionLabel: 'Cadena de distribución: sin intervalo',
          };
        }

        // Mismo criterio que la calc vieja: próximo múltiplo del intervalo.
        const prox = Math.max(int, Math.ceil(km / int) * int);
        const faltan = Math.max(0, prox - km);
        const usado = ((km - (prox - int)) / int) * 100;

        rows.push({ k: 'Intervalo de ' + CORREA[marca].label, v: int, extra: true, ...KM });
        rows.push({ k: 'Kilómetros actuales', v: km, ...KM });
        rows.push({ k: 'Próximo cambio', v: prox, extra: true, ...KM });
        rows.push({ k: 'Te faltan', v: faltan, ...KM });
        rows.push({ k: 'Intervalo consumido', v: usado, ...PCT });

        const due = faltan <= 5000;
        return {
          total: miles(prox) + ' km',
          sub: CORREA[marca].label + ': el próximo cambio de correa va a los ' + miles(prox) + ' km, te faltan ' +
            miles(faltan) + ' km. ' + (due
              ? 'Estás a menos de 5.000 km: agendalo ya, una correa cortada puede destruir el motor.'
              : 'No corre apuro, pero no lo saltees.') +
            ' Ojo con el vencimiento por tiempo: normalmente entre 5 y 7 años.',
          rows: rows,
          chart: [
            { label: 'Con margen', value: 70, from: 0, to: 70, tone: 'good' },
            { label: 'Cerca del cambio', value: 30, from: 70, to: 100, tone: 'warn' },
            { label: 'Pasado', value: 30, from: 100, to: MAX, tone: 'bad' },
          ],
          format: 'unit', unit: '%', decimals: 0,
          position: pos(usado, MAX),
          positionLabel: dec(usado, 0) + '% del intervalo consumido',
        };
      }

      // --------------------------------------------------------------- bateria
      if (id === 'bateria') {
        const MAX = 1500; // tope de la escala, en CCA
        const cc = Math.max(0, v.cilindrada || 0);
        const diesel = v.tipoMotor === 'diesel';
        const mult = diesel ? 2 : 1;
        const min = Math.round((cc / 1000) * 300 * mult);
        const rec = Math.round(min * 1.2);

        rows.push({ k: 'Cilindrada', v: cc, format: 'unit', unit: 'cc' });
        rows.push({ k: 'Factor por tipo de motor', ref: diesel ? 'diésel' : 'nafta', v: mult, format: 'unit', unit: '×', decimals: 1 });
        rows.push({ k: 'CCA mínimos', v: min, extra: true, ...CCA });
        rows.push({ k: 'CCA recomendados', ref: '20% de margen', v: rec, extra: true, ...CCA });

        return {
          total: miles(rec) + ' CCA',
          sub: 'Para un motor de ' + miles(cc) + ' cc ' + (diesel ? 'diésel' : 'nafta') + ' no bajes de ' + miles(min) +
            ' CCA y apuntá a ' + miles(rec) + ' CCA' + (diesel ? ' — los diésel piden casi el doble de corriente de arranque' : '') +
            '. Es una estimación por cilindrada: el manual del vehículo manda, y revisá también el tamaño de caja y la posición de bornes.',
          rows: rows,
          chart: [
            { label: 'Autos chicos', value: 500, from: 0, to: 500, tone: 'good' },
            { label: 'Autos medianos', value: 300, from: 500, to: 800, tone: 'good' },
            { label: 'Grandes / diésel', value: 400, from: 800, to: 1200, tone: 'warn' },
            { label: 'Uso pesado', value: 300, from: 1200, to: MAX, tone: 'warn' },
          ],
          format: 'unit', unit: 'CCA', decimals: 0,
          position: pos(rec, MAX),
          positionLabel: miles(rec) + ' CCA recomendados (mínimo ' + miles(min) + ')',
        };
      }

      // ---------------------------------------------------------------- mezcla
      const MAXML = 50; // tope de la escala, en ml de aceite por litro de nafta
      const litros = Math.max(0, v.litrosNafta || 0);
      const rel = String(v.relacionMezcla || '50:1');
      const ratio = parseInt(rel.split(':')[0], 10) || 50;
      const mlAceite = (litros * 1000) / ratio;
      const mlPorLitro = 1000 / ratio;

      rows.push({ k: 'Nafta a mezclar', v: litros, extra: true, ...L });
      rows.push({ k: 'Relación', ref: 'partes de nafta por 1 de aceite', v: ratio, format: 'plain' });
      rows.push({ k: 'Aceite 2 tiempos', v: mlAceite, extra: true, ...ML });
      rows.push({ k: 'Aceite por litro de nafta', v: mlPorLitro, ...ML });
      rows.push({ k: 'Volumen total de la mezcla', v: litros * 1000 + mlAceite, ...ML });

      return {
        total: dec(mlAceite, 1) + ' ml',
        sub: 'Para ' + dec(litros, 1) + ' L de nafta a ' + rel + ' van ' + dec(mlAceite, 1) +
          ' ml de aceite de 2 tiempos (' + dec(mlPorLitro, 1) + ' ml por litro). ' +
          'Respetá la relación del fabricante del equipo: con poco aceite se funde el motor, con demasiado ensucia la bujía y humea.',
        rows: rows,
        chart: [
          { label: '50:1 (20 ml/L)', value: 20, from: 0, to: 20, tone: 'good' },
          { label: '40:1 (25 ml/L)', value: 5, from: 20, to: 25, tone: 'good' },
          { label: '30:1 (33 ml/L)', value: 8.3, from: 25, to: 33.3, tone: 'warn' },
          { label: '25:1 (40 ml/L)', value: 16.7, from: 33.3, to: MAXML, tone: 'warn' },
        ],
        format: 'unit', unit: 'ml', decimals: 1,
        position: pos(mlPorLitro, MAXML),
        positionLabel: dec(mlPorLitro, 1) + ' ml de aceite por litro de nafta (' + rel + ')',
      };
    });
  })();
</script>
