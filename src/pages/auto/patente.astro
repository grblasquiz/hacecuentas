---
/**
 * Hub de decisión — "¿Cuánto pago de patente?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/patente.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import SeoReferenceTable from '../../components/SeoReferenceTable.astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import PatenteAutoExperience from '../../components/generated/PatenteAutoExperience.astro';
import {
  hub,
  ALICUOTAS,
  ESCALA_CORDOBA,
  DESCUENTO_CONTADO_CBA,
  FRANJAS_MOTO,
  RECARGO_CABA_MOTO,
  PATENTAMIENTO,
} from '../../lib/hubs/patente';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PatenteAutoExperience data={hub} />
  <SeoReferenceTable title="Dónde consultar la patente según la jurisdicción" columns={['Jurisdicción', 'Organismo']}
    rows={[
      { label: 'Provincia de Buenos Aires', href: hub.sources[0].url, details: ['ARBA · Impuesto Automotor'] },
      { label: 'Ciudad de Buenos Aires', href: hub.sources[1].url, details: ['AGIP · Patentes'] },
      { label: 'Córdoba', href: hub.sources[2].url, details: ['Rentas Córdoba · Automotor'] },
      { label: 'Santa Fe', href: hub.sources[3].url, details: ['API Santa Fe · Patente Única'] },
    ]}>
    <p>Consultá en qué jurisdicción está radicado el vehículo y usá la valuación fiscal y el año del dominio para revisar la liquidación.</p>
  </SeoReferenceTable>
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

