---
/**
 * Hub de decisión — "¿Cuánto pago de patente?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/patente.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PatenteAutoExperience from '../../components/generated/PatenteAutoExperience.astro';
import {
  hub,
  ALICUOTAS,
  ESCALA_CORDOBA,
  DESCUENTO_CONTADO_CBA,
  FRANJAS_MOTO,
  RECARGO_CABA_MOTO,
  PATENTAMIENTO,
} from '../../lib/hubs/patente';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PatenteAutoExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    ALICUOTAS,
    ESCALA_CORDOBA,
    DESCUENTO_CONTADO_CBA,
    FRANJAS_MOTO,
    RECARGO_CABA_MOTO,
    PATENTAMIENTO,
  }}
>
  (function () {
    const H = window.HC_HUB;

    const PCT = { format: 'unit', unit: '%', decimals: 2 };
    const PCT1 = { format: 'unit', unit: '%', decimals: 1 };

    /** Lista ordenada de jurisdicciones para el ranking y los extremos. */
    const LISTA = Object.keys(ALICUOTAS)
      .map((k) => ({ id: k, nombre: ALICUOTAS[k].nombre, alicuota: ALICUOTAS[k].alicuota }))
      .sort((a, b) => a.alicuota - b.alicuota);
    const MAS_BARATA = LISTA[0];
    const MAS_CARA = LISTA[LISTA.length - 1];
    const PROMEDIO = LISTA.reduce((a, p) => a + p.alicuota, 0) / LISTA.length;

    function tramo(escala, valor) {
      for (let i = 0; i < escala.length; i++) if (valor <= escala[i].hasta) return escala[i];
      return escala[escala.length - 1];
    }

    H.onCompute(function (v, kase) {
      const id = kase && kase.id ? kase.id : 'auto';
      const valuacion = Math.max(0, v.valuacion || 0);
      const cuotas = Math.max(1, Math.min(12, Math.round(v.cuotas || 1)));
      const cc = Math.max(0, Math.round(v.cilindrada || 0));
      const provId = String(v.provincia || 'buenos-aires');
      const prov = ALICUOTAS[provId] || ALICUOTAS['buenos-aires'];

      const rows = [];
      let total = 0;
      let alicuota = prov.alicuota;
      let chart = [];
      let sub = '';

      if (id === 'moto') {
        // Alícuota por franja de cilindrada; CABA recarga un 10%.
        const franja = tramo(FRANJAS_MOTO, cc);
        const recargo = provId === 'caba' ? RECARGO_CABA_MOTO : 1;
        alicuota = franja.alicuota * recargo;
        total = (valuacion * alicuota) / 100;

        const sellado = valuacion * PATENTAMIENTO.selladoPct;
        const registro = PATENTAMIENTO.arancelFijo + sellado;

        rows.push({ k: 'Valor fiscal de la moto', ref: 'DNRPA', v: valuacion });
        rows.push({ k: 'Franja de cilindrada: ' + franja.label, ref: cc + ' cc', v: franja.alicuota, ...PCT1 });
        if (recargo > 1) rows.push({ k: 'Recargo de CABA sobre la alícuota', ref: 'AGIP', v: 10, ...PCT1 });
        rows.push({ k: 'Alícuota aplicada', ref: prov.nombre, v: alicuota, ...PCT });
        rows.push({ k: 'Patente anual', ref: 'Impuesto automotor', v: total, extra: true });
        rows.push({ k: 'Cada cuota (' + cuotas + ' al año)', ref: 'Calendario provincial', v: total / cuotas });
        rows.push({ k: 'Arancel fijo de inscripción (una sola vez)', ref: 'DNRPA', v: PATENTAMIENTO.arancelFijo });
        rows.push({ k: 'Sellado de inscripción (0,8% del valor)', ref: 'Sellos provincial', v: sellado });
        rows.push({ k: 'Costo total de patentamiento inicial', ref: 'Trámite único', v: registro, extra: true });

        // Comparación: tu franja contra el resto de las franjas de cilindrada.
        chart = FRANJAS_MOTO.map((f) => ({
          label: f.label + (f.label === franja.label ? ' (la tuya)' : ''),
          value: Math.round((valuacion * f.alicuota * recargo) / 100),
          tone: f.label === franja.label ? 'main' : f.alicuota > franja.alicuota ? 'bad' : 'good',
        }));

        sub =
          cc + ' cc · alícuota ' + alicuota.toFixed(2).replace('.', ',') + '% en ' + prov.nombre +
          ' · patentarla cuesta ' + H.ars(registro) + ' aparte' +
          (cc > 0 && cc < 100 ? ' · en varias provincias los ciclomotores están exentos' : '');
      } else if (id === 'cordoba') {
        // Escala por tramo de valuación + 15% de descuento por pago contado.
        const t = tramo(ESCALA_CORDOBA, valuacion);
        alicuota = t.alicuota;
        const base = (valuacion * alicuota) / 100;
        const contado = base * (1 - DESCUENTO_CONTADO_CBA);
        const ahorro = base - contado;
        const bimestral = base / 5;
        total = cuotas === 1 ? contado : base;

        rows.push({ k: 'Valuación fiscal', ref: 'DGR Córdoba', v: valuacion });
        rows.push({ k: 'Tramo de la escala: ' + t.label, ref: 'Ley 6.006', v: alicuota, ...PCT1 });
        rows.push({ k: 'Patente anual base (sin descuento)', ref: 'Ley impositiva 2026', v: base, extra: true });
        rows.push({ k: 'Descuento por pago contado (15%)', ref: 'DGR', v: ahorro });
        rows.push({ k: 'Total pagando contado', ref: 'Buen Contribuyente', v: contado, extra: true });
        rows.push({ k: 'Cada una de las 5 cuotas bimestrales', ref: 'feb/abr/jun/ago/oct', v: bimestral });
        rows.push({ k: 'Peso mensual del impuesto', ref: 'Base ÷ 12', v: base / 12 });

        chart = [
          { label: 'Córdoba (la tuya)', value: Math.round(base), tone: 'main' },
          { label: 'Promedio de las 24 jurisdicciones', value: Math.round((valuacion * PROMEDIO) / 100), tone: 'warn' },
          { label: MAS_CARA.nombre + ' (la más cara)', value: Math.round((valuacion * MAS_CARA.alicuota) / 100), tone: 'bad' },
          { label: MAS_BARATA.nombre + ' (la más barata)', value: Math.round((valuacion * MAS_BARATA.alicuota) / 100), tone: 'good' },
        ];

        sub =
          'Tramo ' + t.label + ' · base ' + H.ars(base) +
          (cuotas === 1
            ? ' · contado con 15% off: ahorrás ' + H.ars(ahorro)
            : ' · 5 cuotas de ' + H.ars(bimestral) + ' (contado ahorrarías ' + H.ars(ahorro) + ')');
      } else {
        // 'auto' y 'valuacion' comparten motor: valuación × alícuota provincial.
        total = (valuacion * alicuota) / 100;
        const mensual = total / 12;
        const pesoPct = valuacion > 0 ? (total / valuacion) * 100 : 0;
        const puesto = LISTA.length - LISTA.findIndex((p) => p.id === provId);
        const enLaMasBarata = (valuacion * MAS_BARATA.alicuota) / 100;

        rows.push({ k: 'Valuación fiscal del vehículo', ref: 'DNRPA', v: valuacion });
        rows.push({ k: 'Alícuota de ' + prov.nombre, ref: 'Ley impositiva 2026', v: alicuota, ...PCT1 });
        rows.push({ k: 'Patente anual', ref: 'Impuesto automotor', v: total, extra: true });
        rows.push({ k: 'Cada cuota (' + cuotas + ' al año)', ref: 'Calendario provincial', v: total / cuotas });
        rows.push({ k: 'Peso mensual del impuesto', ref: 'Anual ÷ 12', v: mensual });

        if (id === 'valuacion') {
          rows.push({ k: 'La patente sobre el valor fiscal', ref: 'Anual ÷ valuación', v: pesoPct, ...PCT });
          rows.push({
            k: 'Puesto de tu jurisdicción (1 = la más cara)',
            ref: 'sobre 24',
            v: puesto,
            format: 'unit',
            unit: 'de 24',
          });
          rows.push({
            k: 'Diferencia contra ' + MAS_BARATA.nombre + ' (la más barata)',
            ref: MAS_BARATA.alicuota.toFixed(1).replace('.', ',') + '%',
            v: Math.max(0, total - enLaMasBarata),
          });
        }

        chart = [
          { label: prov.nombre + ' (la tuya)', value: Math.round(total), tone: 'main' },
          { label: 'Promedio de las 24 jurisdicciones', value: Math.round((valuacion * PROMEDIO) / 100), tone: 'warn' },
          { label: MAS_CARA.nombre + ' (la más cara)', value: Math.round((valuacion * MAS_CARA.alicuota) / 100), tone: 'bad' },
          { label: MAS_BARATA.nombre + ' (la más barata)', value: Math.round(enLaMasBarata), tone: 'good' },
        ];

        sub =
          prov.nombre + ' · alícuota ' + alicuota.toFixed(1).replace('.', ',') + '%' +
          ' · ' + cuotas + ' cuota' + (cuotas > 1 ? 's' : '') + ' de ' + H.ars(total / cuotas) +
          ' · ' + H.ars(mensual) + ' por mes';
      }

      return {
        total: H.ars(total),
        sub: sub,
        rows: rows,
        chart: chart,
      };
    });
  })();
</script>
