---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COOP_DATASETS, MIN_OBS } from '../lib/coop/datasets';

const today = new Date().toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' });

const live = COOP_DATASETS.filter((d) => d.status === 'live');
const soon = COOP_DATASETS.filter((d) => d.status === 'soon');

const title = 'Cooperativa de datos anónimos — Índices propios de Hacé Cuentas';
const description =
  'Aportá tus datos de forma anónima y voluntaria para construir índices argentinos abiertos: sueldo neto, relación alquiler/ingreso y tasas reales. Consentimiento explícito, nunca asociado a tu email, metodología pública.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: 'Cooperativa de datos anónimos de Hacé Cuentas',
      description,
      url: 'https://hacecuentas.com/cooperativa-de-datos',
      inLanguage: 'es-AR',
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
      author: {
        '@type': 'Person',
        '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person',
        name: 'Martín Rodríguez',
        url: 'https://hacecuentas.com/autores/martin-rodriguez',
      },
      dateModified: new Date().toISOString().slice(0, 10),
    },
    ...live.map((d) => ({
      '@type': 'Dataset',
      name: d.indexName,
      description: d.blurb,
      url: `https://hacecuentas.com/cooperativa-de-datos#${d.id}`,
      creator: { '@id': 'https://hacecuentas.com/#organization' },
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      measurementTechnique: 'Aporte anónimo voluntario con consentimiento explícito; agregación por segmento con mínimo de 30 observaciones.',
    })),
  ],
};
---

<Layout title={title} description={description} schema={schema}>
  <Header slot="header" />

  <article class="legal coop">
    <h1>Cooperativa de datos anónimos</h1>
    <p class="date">Última actualización: {today}</p>

    <p class="lead">
      Hacé Cuentas no envía los datos que cargás en las calculadoras: el cálculo pasa en tu
      dispositivo y tu privacidad está protegida por defecto. Eso no se toca. Pero después de
      ciertos resultados te ofrecemos algo distinto: <strong>aportar ese dato de forma anónima y
      voluntaria</strong> para construir estadísticas argentinas que hoy no existen abiertas.
      A cambio, ves al instante tu posición relativa — por ejemplo, en qué percentil de sueldo
      estás dentro de tu área y seniority.
    </p>

    <div class="coop-cta-note">
      🔒 El aporte es <strong>opt-in</strong>: no se guarda nada salvo que toques el botón y marques
      el consentimiento. Nunca se asocia a tu email ni a tu cuenta.
    </div>

    <nav class="toc" aria-label="Tabla de contenidos">
      <strong>En esta página:</strong>
      <ul>
        <li><a href="#indices">Los índices</a></li>
        <li><a href="#como">Cómo funciona</a></li>
        <li><a href="#salvaguardas">Salvaguardas</a></li>
        <li><a href="#metodologia">Metodología</a></li>
        <li><a href="#tus-aportes">Tus aportes</a></li>
      </ul>
    </nav>

    <h2 id="indices">Los índices</h2>
    <p>
      Cada índice se construye sólo con aportes anónimos. Mostramos un segmento únicamente cuando
      reúne al menos <strong>{MIN_OBS} observaciones</strong>, para que nadie sea identificable.
      Los números se actualizan a diario.
    </p>

    <div class="coop-grid" data-coop-grid>
      {live.map((d) => (
        <section class="coop-card is-live" id={d.id} data-dataset={d.id}>
          <header>
            <span class="coop-badge">En vivo</span>
            <h3>{d.indexName}</h3>
          </header>
          <p class="coop-blurb">{d.blurb}</p>
          <div class="coop-numbers" data-coop-numbers>
            <p class="coop-loading">Cargando datos del índice…</p>
          </div>
        </section>
      ))}
      {soon.map((d) => (
        <section class="coop-card is-soon" id={d.id}>
          <header>
            <span class="coop-badge soon">Próximamente</span>
            <h3>{d.indexName}</h3>
          </header>
          <p class="coop-blurb">{d.blurb}</p>
          <p class="coop-soon-note">Lo activamos cuando una calculadora del rubro empiece a recibir aportes.</p>
        </section>
      ))}
    </div>

    <h2 id="como">Cómo funciona</h2>
    <ol class="coop-steps">
      <li><strong>Calculás normal.</strong> Tus datos no se envían: el cálculo es local.</li>
      <li><strong>Te ofrecemos aportar.</strong> Después del resultado aparece una invitación opcional. Si no querés, no pasa nada.</li>
      <li><strong>Consentís explícitamente.</strong> Marcás la casilla y completás 1–2 datos de contexto (rol, provincia, banco…) para ubicar tu aporte en un segmento.</li>
      <li><strong>Guardamos el dato anónimo.</strong> Sin email, sin cuenta, sin IP en claro. Recalculamos el cálculo en el servidor para tener el valor exacto.</li>
      <li><strong>Ves tu percentil.</strong> Si tu segmento ya tiene {MIN_OBS}+ aportes, te mostramos dónde caés. Si no, te decimos cuántos faltan.</li>
    </ol>

    <h2 id="salvaguardas">Salvaguardas mínimas</h2>
    <ul class="coop-safeguards">
      <li><strong>Consentimiento explícito.</strong> Nada se guarda automáticamente. Siempre hay un botón y una casilla.</li>
      <li><strong>Nunca asociado al email.</strong> El endpoint de aporte ni siquiera lee tu sesión. No hay forma de unir un aporte con una persona.</li>
      <li><strong>Rangos además de valores.</strong> Guardamos el rango (ej. «$800.000–$900.000») junto al valor, y el rango es lo que sobrevive a largo plazo.</li>
      <li><strong>Mínimo {MIN_OBS} observaciones.</strong> Ningún segmento con menos de {MIN_OBS} aportes se muestra ni a vos ni en los índices públicos.</li>
      <li><strong>Ubicación a nivel provincia.</strong> Nunca pedimos dirección ni localidad fina: la geografía máxima es la provincia o una zona amplia.</li>
      <li><strong>Eliminación programada.</strong> Los valores exactos y el hash anti-spam se borran pasados ~18 meses; quedan sólo los agregados y los rangos.</li>
      <li><strong>Auditoría pública.</strong> Esta misma página documenta la metodología, y los agregados se publican vía <code>/api/coop/stats</code>.</li>
      <li><strong>Revocable.</strong> Cada aporte te deja un token en tu dispositivo. Podés revocarlo cuando quieras desde <a href="#tus-aportes">«Tus aportes»</a>.</li>
    </ul>

    <h2 id="metodologia">Metodología</h2>
    <p>
      Cuando aportás, el servidor <strong>reejecuta el cálculo</strong> con tus inputs para obtener el
      valor autoritativo (no confiamos en un número manipulado del lado del cliente). Ese valor se
      guarda junto a las dimensiones de segmento que elegiste y al período (mes). Un proceso diario:
    </p>
    <ul>
      <li>Calcula los percentiles (p10, p25, mediana, p75, p90), media, mínimo y máximo por segmento.</li>
      <li>Congela un <em>snapshot</em> mensual de cada índice, para que la serie histórica persista aunque después se poden los valores exactos.</li>
      <li>Limita cada dispositivo a un aporte por segmento y por mes, para evitar que alguien sesgue el índice.</li>
    </ul>
    <p>
      La licencia de los índices agregados es <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>:
      podés reusarlos citando a Hacé Cuentas.
    </p>

    <h2 id="tus-aportes">Tus aportes</h2>
    <p>
      Estos son los aportes hechos desde <em>este</em> dispositivo (los guardamos sólo en tu
      navegador para que puedas revocarlos). No hay forma de listarlos por persona porque son
      anónimos.
    </p>
    <div data-coop-mine>
      <p class="coop-empty">Todavía no aportaste nada desde este dispositivo.</p>
    </div>

    <Footer slot="footer" />
  </article>
</Layout>

<style>
  .coop-cta-note {
    margin: 1.25rem 0;
    padding: 0.875rem 1.1rem;
    background: var(--accent-soft, color-mix(in srgb, var(--accent) 10%, var(--bg-card)));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
  }
  .coop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 2rem;
  }
  .coop-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    background: var(--bg-card);
  }
  .coop-card.is-soon { opacity: 0.78; }
  .coop-card header { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 0.5rem; }
  .coop-card h3 { margin: 0; font-size: 1.05rem; line-height: 1.3; }
  .coop-badge {
    align-self: flex-start;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase;
    padding: 0.15rem 0.5rem; border-radius: 999px;
    background: color-mix(in srgb, var(--success, #16a34a) 16%, transparent);
    color: var(--success, #16a34a);
  }
  .coop-badge.soon { background: color-mix(in srgb, var(--text-muted) 16%, transparent); color: var(--text-muted); }
  .coop-blurb { font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 0.75rem; }
  .coop-soon-note { font-size: 0.8rem; color: var(--text-subtle); margin: 0; }
  .coop-loading { font-size: 0.85rem; color: var(--text-subtle); margin: 0; }
  .coop-numbers .coop-stat-row {
    display: flex; justify-content: space-between; gap: 0.75rem;
    padding: 0.4rem 0; border-top: 1px solid var(--border); font-size: 0.9rem;
  }
  .coop-numbers .coop-stat-row strong { color: var(--text); }
  .coop-numbers .coop-seg-name { color: var(--text-muted); }
  .coop-numbers .coop-overall { font-weight: 600; }
  .coop-numbers .coop-n { font-size: 0.78rem; color: var(--text-subtle); }
  .coop-steps { line-height: 1.6; }
  .coop-steps li { margin-bottom: 0.4rem; }
  .coop-safeguards { line-height: 1.6; list-style: none; padding-left: 0; }
  .coop-safeguards li { margin-bottom: 0.55rem; padding-left: 1.4rem; position: relative; }
  .coop-safeguards li::before { content: '✓'; position: absolute; left: 0; color: var(--success, #16a34a); font-weight: 700; }
  .coop-mine-item {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 0.65rem 0.85rem; border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 0.5rem;
  }
  .coop-mine-item .coop-mine-meta { font-size: 0.85rem; color: var(--text-muted); }
  .coop-mine-item button {
    padding: 0.35rem 0.8rem; font-size: 0.8rem; font-weight: 600; cursor: pointer;
    background: transparent; color: var(--danger, #b91c1c);
    border: 1px solid var(--danger, #b91c1c); border-radius: var(--radius-sm);
  }
  .coop-mine-item button:disabled { opacity: 0.5; cursor: default; }
  .coop-empty { font-size: 0.9rem; color: var(--text-subtle); }
</style>

<script>
  const CURRENCY = (n: number) => '$' + Math.round(n).toLocaleString('es-AR');
  const fmt = (unit: string, n: number) =>
    unit === 'pct' ? `${Math.round(n * 10) / 10}%` : CURRENCY(n);

  // ── Índices en vivo: cargar segmentos publicados por dataset ──────────────
  async function loadDataset(card: HTMLElement) {
    const id = card.dataset.dataset;
    const box = card.querySelector<HTMLElement>('[data-coop-numbers]');
    if (!id || !box) return;
    try {
      const resp = await fetch(`/api/coop/stats?dataset=${encodeURIComponent(id)}`);
      const data = await resp.json();
      const segs = (data && data.segments) || [];
      if (!segs.length) {
        box.innerHTML = '<p class="coop-loading">Todavía juntando datos. Sé de los primeros en aportar desde la calculadora.</p>';
        return;
      }
      const unit = (data.dataset && data.dataset.unit) || 'ARS';
      const rows = segs.slice(0, 12).map((s: any) => {
        const name = s.isOverall
          ? 'Todos los aportes'
          : Object.values(s.segments || {}).filter(Boolean).join(' · ') || 'Segmento';
        return `<div class="coop-stat-row ${s.isOverall ? 'coop-overall' : ''}">
          <span class="coop-seg-name">${escapeHtml(name)} <span class="coop-n">(${s.n})</span></span>
          <strong>${fmt(unit, s.p50)}</strong>
        </div>`;
      }).join('');
      box.innerHTML = rows + '<p class="coop-n" style="margin:.5rem 0 0">Mediana por segmento. Sólo segmentos con 30+ aportes.</p>';
    } catch {
      box.innerHTML = '<p class="coop-loading">No pudimos cargar el índice ahora.</p>';
    }
  }

  function escapeHtml(s: string) {
    return s.replace(/[<>&"]/g, (c) => (c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '&' ? '&amp;' : '&quot;'));
  }

  document.querySelectorAll<HTMLElement>('[data-dataset]').forEach(loadDataset);

  // ── Tus aportes: leer localStorage 'hc_coop' y permitir revocar ───────────
  type CoopRecord = { token: string; dataset: string; label: string; at: number };

  function readMine(): CoopRecord[] {
    try {
      const raw = localStorage.getItem('hc_coop');
      const arr = raw ? JSON.parse(raw) : [];
      return Array.isArray(arr) ? arr : [];
    } catch { return []; }
  }
  function writeMine(list: CoopRecord[]) {
    try { localStorage.setItem('hc_coop', JSON.stringify(list)); } catch { /* ignore */ }
  }

  function renderMine() {
    const box = document.querySelector<HTMLElement>('[data-coop-mine]');
    if (!box) return;
    const list = readMine();
    if (!list.length) {
      box.innerHTML = '<p class="coop-empty">Todavía no aportaste nada desde este dispositivo.</p>';
      return;
    }
    box.innerHTML = list.map((r) => {
      const d = new Date(r.at).toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' });
      return `<div class="coop-mine-item" data-token="${escapeHtml(r.token)}">
        <span class="coop-mine-meta"><strong>${escapeHtml(r.label || r.dataset)}</strong> — aportado el ${d}</span>
        <button type="button" data-revoke="${escapeHtml(r.token)}">Revocar</button>
      </div>`;
    }).join('');

    box.querySelectorAll<HTMLButtonElement>('[data-revoke]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const token = btn.dataset.revoke!;
        btn.disabled = true; btn.textContent = 'Revocando…';
        try {
          await fetch('/api/coop/revoke', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token }),
          });
        } catch { /* aun así lo sacamos local */ }
        writeMine(readMine().filter((r) => r.token !== token));
        renderMine();
      });
    });
  }

  renderMine();
</script>
