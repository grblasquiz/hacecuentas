---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MundialFinalLive from '../components/MundialFinalLive.astro';
import WeekendPackCapture from '../components/WeekendPackCapture.astro';
import { fixture, teamLabel, artDayLabel, artTime } from '../lib/data/mundial-2026';
import { topScorers } from '../lib/mundial-live';

const SITE = 'https://hacecuentas.com';
const URL = `${SITE}/balon-de-oro-mundial-2026`;

const matches = fixture.matches;
const final = matches.find((m) => /^final$/i.test((m.round || '').trim())) || null;
const t1 = final ? teamLabel(final.team1) : null;
const t2 = final ? teamLabel(final.team2) : null;
const finalDefinido = !!(t1 && t2 && !t1.tbd && !t2.tbd);

const goleadores = topScorers(matches, 5);
const botin = goleadores[0] || null;

const finalistNames = [final?.team1, final?.team2].filter((n): n is string => !!n && !teamLabel(n).tbd);
const espnCfg = {
  date: (final?.date || '2026-07-19').replace(/-/g, ''),
  finalTeams: finalistNames,
  teams: Object.fromEntries(finalistNames.map((n) => [n, { es: teamLabel(n).es, flag: teamLabel(n).flag }])),
  pollMs: 60000,
};
const kickoffLabel = final?.date ? `Final · ${artDayLabel(final.date, final.time)} · ${artTime(final.date, final.time)} · MetLife Stadium` : 'Final del Mundial 2026';

// Balón de Oro histórico (mejor jugador del torneo) — evergreen, crawleable.
const historico = [
  { anio: 2022, jugador: 'Lionel Messi', pais: '🇦🇷 Argentina', sede: 'Qatar' },
  { anio: 2018, jugador: 'Luka Modrić', pais: '🇭🇷 Croacia', sede: 'Rusia' },
  { anio: 2014, jugador: 'Lionel Messi', pais: '🇦🇷 Argentina', sede: 'Brasil' },
  { anio: 2010, jugador: 'Diego Forlán', pais: '🇺🇾 Uruguay', sede: 'Sudáfrica' },
  { anio: 2006, jugador: 'Zinedine Zidane', pais: '🇫🇷 Francia', sede: 'Alemania' },
  { anio: 2002, jugador: 'Oliver Kahn', pais: '🇩🇪 Alemania', sede: 'Corea y Japón' },
  { anio: 1998, jugador: 'Ronaldo', pais: '🇧🇷 Brasil', sede: 'Francia' },
  { anio: 1994, jugador: 'Romário', pais: '🇧🇷 Brasil', sede: 'Estados Unidos' },
  { anio: 1990, jugador: 'Salvatore Schillaci', pais: '🇮🇹 Italia', sede: 'Italia' },
  { anio: 1986, jugador: 'Diego Maradona', pais: '🇦🇷 Argentina', sede: 'México' },
];

const title = 'Balón de Oro del Mundial 2026: mejor jugador y goleador | Hacé Cuentas';
const description = 'Quién gana el Balón de Oro del Mundial 2026 (mejor jugador) y la Bota de Oro (máximo goleador). Se actualiza en vivo con la final y la lista histórica de ganadores.';
const ogTitle = 'Balón de Oro del Mundial 2026: mejor jugador y goleador';
const keywords = ['balón de oro mundial 2026', 'mejor jugador mundial 2026', 'bota de oro 2026', 'goleador mundial 2026', 'balón de oro', 'mvp mundial 2026', 'quién ganó el balón de oro'];
const newsKeywords = ['Balón de Oro', 'Mundial 2026', 'mejor jugador', 'Bota de Oro', 'goleador'];

const faq = [
  { q: '¿Qué es el Balón de Oro del Mundial?', a: 'El Balón de Oro (adidas Golden Ball) es el premio al mejor jugador de la Copa del Mundo. Lo elige un panel de la FIFA y los medios acreditados, y se entrega en la ceremonia posterior a la final. Es distinto de la Bota de Oro, que premia al máximo goleador.' },
  { q: '¿Cuándo se anuncia el Balón de Oro 2026?', a: 'Se anuncia el mismo día de la final, el domingo 19 de julio de 2026, en la ceremonia de premiación que se hace apenas termina el partido en el MetLife Stadium. Esta página se actualiza en cuanto se confirma el ganador.' },
  { q: '¿Cuál es la diferencia entre Balón de Oro y Bota de Oro?', a: 'El Balón de Oro premia al mejor jugador del torneo (rendimiento general), mientras que la Bota de Oro (Golden Boot) premia al máximo goleador. Si hay empate en goles, la Bota de Oro se define por asistencias y, si sigue igualado, por menos minutos jugados.' },
  { q: '¿Quién es el máximo goleador del Mundial 2026 hasta ahora?', a: botin ? `Hasta ahora el máximo goleador es ${botin.name} (${botin.es}) con ${botin.goles} goles. La Bota de Oro se define al terminar la final. Podés ver la tabla completa en la página de goleadores.` : 'La Bota de Oro se define al terminar la final. Mirá la tabla de goleadores actualizada en vivo.' },
  { q: '¿Quién ganó el último Balón de Oro?', a: 'En Qatar 2022, el Balón de Oro fue para Lionel Messi (Argentina), que además levantó la Copa. Messi es el único jugador que lo ganó dos veces (2014 y 2022).' },
  { q: '¿Un jugador puede ganar el Balón de Oro sin ser campeón?', a: 'Sí. El Balón de Oro premia al mejor jugador más allá del resultado de la final. Por ejemplo, Luka Modrić lo ganó en 2018 con Croacia siendo subcampeón, y Lionel Messi en 2014 pese a la derrota en la final.' },
  { q: '¿De dónde salen los datos en vivo de esta página?', a: 'El resultado de la final y los goleadores se actualizan automáticamente desde ESPN durante el partido. El ganador del Balón de Oro se carga en cuanto la FIFA lo anuncia en la ceremonia. La lista histórica es información oficial de las ediciones anteriores.' },
];

const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Mundial 2026', item: `${SITE}/mundial-2026` },
    { '@type': 'ListItem', position: 3, name: 'Balón de Oro', item: URL } ] },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'ItemList', name: 'Ganadores del Balón de Oro del Mundial', itemListElement: historico.map((h, i) => ({ '@type': 'ListItem', position: i + 1, name: `${h.anio}: ${h.jugador}` })) },
] };
---

<Layout title={title} description={description} canonical="/balon-de-oro-mundial-2026" schema={schema} audience="AR" domain="life" pageType="data" keywords={keywords} newsKeywords={newsKeywords} ogTitle={ogTitle}>
  <Header slot="header" />
  <main class="bdo">
    <nav class="crumbs"><a href="/">Inicio</a> › <a href="/mundial-2026">Mundial 2026</a> › <span>Balón de Oro</span></nav>
    <h1>🏅 Balón de Oro del Mundial 2026</h1>
    <p class="lede">Quién es el <strong>mejor jugador</strong> del Mundial 2026 (Balón de Oro) y el <strong>máximo goleador</strong> (Bota de Oro). Se define en la final del {finalDefinido ? `${t1!.es} vs ${t2!.es}` : 'Mundial'} y acá lo vas a ver apenas la FIFA lo anuncie.</p>

    <MundialFinalLive
      cfg={espnCfg}
      team1={t1 && !t1.tbd ? { es: t1.es, flag: t1.flag } : null}
      team2={t2 && !t2.tbd ? { es: t2.es, flag: t2.flag } : null}
      kickoffLabel={kickoffLabel}
    />

    <WeekendPackCapture source="balon-de-oro" />

    <section class="awards" data-espn-mvp-root>
      <article class="award award--gold">
        <span class="award__eyebrow">Balón de Oro</span>
        <h2 class="award__title" data-espn-mvp>Se anuncia al terminar la final</h2>
        <p class="award__note">Mejor jugador del torneo · lo elige la FIFA en la ceremonia post-final.</p>
      </article>
      <article class="award">
        <span class="award__eyebrow">Bota de Oro</span>
        <h2 class="award__title">{botin ? `${botin.flag} ${botin.name}` : 'Se define en la final'}</h2>
        <p class="award__note">{botin ? `Máximo goleador · ${botin.goles} goles${goleadores[1] && goleadores[1].goles === botin.goles ? ' (en pelea)' : ''}` : 'Máximo goleador del torneo.'} <a href="/goleadores-mundial-2026">Ver goleadores →</a></p>
      </article>
    </section>

    {goleadores.length > 0 && (
      <section class="mini-scorers">
        <h2>La pelea por la Bota de Oro</h2>
        <ol class="scorers-list">
          {goleadores.map((g) => (
            <li><span class="s-name">{g.flag} {g.name}</span><span class="s-goals">{g.goles} {g.goles === 1 ? 'gol' : 'goles'}</span></li>
          ))}
        </ol>
        <p class="note"><a href="/goleadores-mundial-2026">Ver la tabla completa de goleadores →</a></p>
      </section>
    )}

    <section class="explainer">
      <h2>Balón de Oro vs. Bota de Oro: ¿cuál es cuál?</h2>
      <p>El <strong>Balón de Oro</strong> (adidas Golden Ball) premia al <strong>mejor jugador</strong> del Mundial, elegido por un panel de la FIFA. La <strong>Bota de Oro</strong> (Golden Boot) premia al <strong>máximo goleador</strong>; si hay empate en goles, se define por asistencias y, si sigue igualado, por menos minutos jugados. También se entrega el <strong>Guante de Oro</strong> al mejor arquero y el premio al <strong>Mejor Jugador Joven</strong>.</p>
    </section>

    <section class="historic">
      <h2>🏆 Ganadores del Balón de Oro (1986-2026)</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Año</th><th>Mejor jugador</th><th>Selección</th><th>Sede</th></tr></thead>
          <tbody>
            <tr class="row-now"><td><b>2026</b></td><td data-espn-mvp>Se define el 19 de julio</td><td>—</td><td>USA, México y Canadá</td></tr>
            {historico.map((h) => (
              <tr><td>{h.anio}</td><td>{h.jugador}</td><td>{h.pais}</td><td>{h.sede}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">Lionel Messi es el único jugador que ganó el Balón de Oro del Mundial dos veces (2014 y 2022).</p>
    </section>

    <section class="links">
      <h2>Seguí el Mundial 2026</h2>
      <ul>
        <li><a href="/campeon-mundial-2026">🏆 ¿Quién ganó el Mundial 2026?</a></li>
        <li><a href="/goleadores-mundial-2026">⚽ Tabla de goleadores</a></li>
        <li><a href="/fixture-mundial-2026">📅 Fixture y resultados</a></li>
        <li><a href="/llave-mundial-2026">🗂️ Llave de eliminación</a></li>
        <li><a href="/mundial-2026">🌎 Hub del Mundial 2026</a></li>
      </ul>
    </section>

    <section class="faq">
      <h2>Preguntas frecuentes</h2>
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
  </main>
  <Footer slot="footer" />
</Layout>

<style>
  .bdo { max-width: 900px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
  .crumbs { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .bdo h1 { font-size: clamp(1.5rem, 4.5vw, 2.05rem); font-weight: 800; margin: 0 0 0.5rem; }
  .lede { font-size: 1.05rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 1.5rem; }
  .bdo :global(.hcf) { margin-bottom: 1.6rem; }
  .awards { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin: 0 0 2rem; }
  .award { background: var(--bg-card); border: 1px solid var(--border); border-radius: 18px; padding: 1.3rem 1.4rem; }
  .award--gold { background: linear-gradient(135deg, #fff, #fbf3d8); border-color: #efdca0; }
  .award__eyebrow { display: block; font-size: 0.72rem; font-weight: 850; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.5rem; }
  .award--gold .award__eyebrow { color: #a9852a; }
  .award__title { font-family: Georgia, 'Times New Roman', serif; font-size: 1.4rem; font-weight: 700; margin: 0 0 0.5rem; line-height: 1.1; }
  [data-espn-mvp-root].is-known .award--gold .award__title { color: #8a6a17; }
  .award__note { font-size: 0.82rem; color: var(--text-muted); margin: 0; line-height: 1.5; }
  .award__note a { color: var(--accent); text-decoration: none; font-weight: 700; }
  .mini-scorers, .explainer, .historic, .links, .faq { margin: 2rem 0; }
  .bdo h2 { font-size: 1.25rem; font-weight: 800; margin: 0 0 0.9rem; }
  .scorers-list { list-style: none; counter-reset: s; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .scorers-list li { counter-increment: s; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.7rem 0.9rem; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-card); }
  .scorers-list li::before { content: counter(s); font-weight: 800; color: var(--accent); font-family: Georgia, serif; margin-right: 0.5rem; }
  .s-name { flex: 1; font-weight: 600; }
  .s-goals { font-weight: 800; font-variant-numeric: tabular-nums; }
  .explainer p { color: var(--text-muted); line-height: 1.7; }
  .table-scroll { overflow-x: auto; }
  .historic table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .historic th, .historic td { text-align: left; padding: 0.6rem 0.7rem; border-bottom: 1px solid var(--border); }
  .historic th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-subtle); }
  .historic .row-now { background: var(--accent-soft); }
  .historic .row-now td { font-weight: 700; }
  .note { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.8rem; }
  .note a { color: var(--accent); text-decoration: none; font-weight: 700; }
  .links ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .links a { color: var(--accent); text-decoration: none; font-weight: 600; }
  .faq details { border-bottom: 1px solid var(--border); padding: 0.75rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq details p { margin-top: 0.5rem; color: var(--text-muted); line-height: 1.6; }
  @media (max-width: 520px) { .awards { grid-template-columns: 1fr; } }
</style>
