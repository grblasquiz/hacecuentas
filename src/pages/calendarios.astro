---
export const prerender = true;

/**
 * /calendarios — calendarios .ics suscribibles (plan de tráfico directo).
 * Suscribirse una vez = recordatorios permanentes en el calendario del usuario,
 * cada evento con link al sitio. Los .ics los genera scripts/generate-ics.ts.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SITE = 'https://hacecuentas.com';

interface Cal {
  file: string;
  emoji: string;
  nombre: string;
  desc: string;
  eventos: string;
}
const GRUPOS: Array<{ titulo: string; cals: Cal[] }> = [
  {
    titulo: 'Feriados 2026',
    cals: [
      { file: 'feriados-argentina-2026.ics', emoji: '🇦🇷', nombre: 'Feriados Argentina', desc: 'Los 19 feriados oficiales, con traslados y puentes turísticos.', eventos: '19 eventos' },
      { file: 'feriados-mexico-2026.ics', emoji: '🇲🇽', nombre: 'Feriados México', desc: 'Descansos obligatorios de la LFT.', eventos: '7 eventos' },
      { file: 'feriados-colombia-2026.ics', emoji: '🇨🇴', nombre: 'Feriados Colombia', desc: 'Festivos con Ley Emiliani aplicada.', eventos: '19 eventos' },
      { file: 'feriados-chile-2026.ics', emoji: '🇨🇱', nombre: 'Feriados Chile', desc: 'Feriados legales e irrenunciables.', eventos: '16 eventos' },
      { file: 'feriados-peru-2026.ics', emoji: '🇵🇪', nombre: 'Feriados Perú', desc: 'Feriados nacionales y días no laborables.', eventos: '16 eventos' },
      { file: 'feriados-ecuador-2026.ics', emoji: '🇪🇨', nombre: 'Feriados Ecuador', desc: 'Feriados nacionales con traslados.', eventos: '12 eventos' },
    ],
  },
  {
    titulo: 'Impuestos y plata (Argentina)',
    cals: [
      { file: 'vencimientos-arca-2026.ics', emoji: '💸', nombre: 'Vencimientos ARCA/AFIP', desc: 'Cuota mensual del monotributo, recategorización semestral y fechas del aguinaldo.', eventos: '16 eventos' },
    ],
  },
  {
    titulo: 'Mundial 2026',
    cals: [
      { file: 'mundial-2026-argentina.ics', emoji: '🇦🇷', nombre: 'Argentina en el Mundial', desc: 'Todos los partidos de la Selección y la final, en tu hora local.', eventos: 'partidos de AR + final' },
      { file: 'mundial-2026.ics', emoji: '⚽', nombre: 'Mundial completo', desc: 'Los 104 partidos con horario.', eventos: '104 eventos' },
    ],
  },
];

const title = 'Calendarios 2026 para suscribirte: feriados, vencimientos y Mundial | Hacé Cuentas';
const description = 'Sumá a tu calendario (Google, Apple, Outlook) los feriados 2026 de Argentina y LATAM, los vencimientos de ARCA/AFIP y los partidos del Mundial. Suscripción gratis: se actualiza solo.';

const faq = [
  { q: '¿Cómo agrego un calendario a Google Calendar?', a: 'Tocá "Google Calendar" en el calendario que quieras: se abre Google Calendar y te pregunta si querés agregarlo. También podés ir a Configuración → Agregar calendario → Desde URL y pegar el link del .ics.' },
  { q: '¿Funciona en iPhone (Apple Calendar)?', a: 'Sí. Tocá "Suscribirme" desde el iPhone y Calendario te ofrece agregarlo como calendario suscripto. Se actualiza solo, no ocupa espacio y lo podés borrar cuando quieras.' },
  { q: '¿Es gratis? ¿Me van a mandar spam?', a: 'Es gratis y no pedimos email ni ningún dato: es una suscripción de calendario estándar (.ics), la misma tecnología que usan los feriados de Google. No hay forma de que te mandemos nada.' },
  { q: '¿Qué pasa si cambia una fecha?', a: 'Actualizamos el calendario y tu aplicación lo refresca sola en la próxima sincronización. Por eso conviene suscribirse en vez de descargar.' },
];
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Calendarios', item: `${SITE}/calendarios` } ] },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
] };

const webcal = (file: string) => `webcal://hacecuentas.com/calendarios/${file}`;
const gcal = (file: string) => `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcal(file))}`;
---

<Layout title={title} description={description} canonical="/calendarios" schema={schema} audience="AR" domain="life">
  <Header slot="header" />
  <main class="wrap">
    <nav class="crumbs"><a href="/">Inicio</a> › <span>Calendarios</span></nav>
    <h1>Calendarios 2026 para suscribirte 📅</h1>
    <p class="lede">
      Feriados, vencimientos de impuestos y el Mundial, <strong>directo en tu calendario</strong> (Google, Apple u Outlook).
      Te suscribís una vez y se actualiza solo — cada evento trae el link a la calculadora que va con la fecha.
    </p>

    {GRUPOS.map((g) => (
      <section class="grupo">
        <h2>{g.titulo}</h2>
        <div class="cards">
          {g.cals.map((c) => (
            <div class="card">
              <div class="card-head">
                <span class="card-emoji" aria-hidden="true">{c.emoji}</span>
                <div>
                  <h3>{c.nombre}</h3>
                  <p class="card-desc">{c.desc} <span class="card-n">({c.eventos})</span></p>
                </div>
              </div>
              <div class="card-actions">
                <a class="btn btn-primary" href={webcal(c.file)}>Suscribirme</a>
                <a class="btn" href={gcal(c.file)} target="_blank" rel="noopener">Google Calendar</a>
                <a class="btn btn-ghost" href={`/calendarios/${c.file}`} download>Descargar .ics</a>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="faq">
      <h2>Preguntas frecuentes</h2>
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
  </main>
  <Footer slot="footer" />
</Layout>

<style>
  .wrap { max-width: 820px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
  .crumbs { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  .crumbs a { color: var(--accent); text-decoration: none; }
  h1 { font-size: clamp(1.6rem, 4.5vw, 2.1rem); font-weight: 800; margin: 0 0 0.5rem; }
  .lede { font-size: 1.05rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 1.5rem; }
  .grupo { margin-top: 2rem; }
  .grupo h2 { font-size: 1.25rem; font-weight: 700; margin: 0 0 0.9rem; }
  .cards { display: grid; gap: 0.75rem; }
  .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.1rem; }
  .card-head { display: flex; gap: 0.75rem; align-items: flex-start; margin-bottom: 0.75rem; }
  .card-emoji { font-size: 1.5rem; line-height: 1.2; }
  .card h3 { font-size: 1rem; font-weight: 700; margin: 0 0 0.15rem; }
  .card-desc { font-size: 0.86rem; color: var(--text-muted); margin: 0; line-height: 1.5; }
  .card-n { color: var(--text-subtle); }
  .card-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .btn {
    display: inline-block; border-radius: 999px; padding: 0.45rem 0.95rem;
    font-size: 0.85rem; font-weight: 600; text-decoration: none;
    border: 1px solid var(--border); color: var(--text);
    transition: background 0.15s ease;
  }
  .btn:hover { background: var(--accent-soft, #eff6ff); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent, #fff); }
  .btn-primary:hover { background: var(--accent-hover, #1d4ed8); }
  .btn-ghost { border-color: transparent; color: var(--text-muted); }
  .faq { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .faq h2 { font-size: 1.2rem; font-weight: 700; margin: 0 0 1rem; }
  .faq details { border-bottom: 1px solid var(--border); padding: 0.75rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq details p { margin-top: 0.5rem; color: var(--text-muted); line-height: 1.6; }
</style>
