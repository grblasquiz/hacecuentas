---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  PROFILE_GROUPS, PROFILE_FIELDS, PROVINCES_BY_COUNTRY, CURRENCY_BY_COUNTRY,
} from '../lib/profile/schema';
import { PRODUCTS } from '../lib/products/manifest';
import { ICONS } from '../lib/products/dashboard';
import profileUsage from '../lib/profile/usage-auto.json';

const groups = PROFILE_GROUPS.map((g) => ({
  ...g,
  fields: PROFILE_FIELDS.filter((f) => f.group === g.id),
})).filter((g) => g.fields.length > 0);

const usage = profileUsage as Record<string, { slug: string; title: string }[]>;
const totalFields = PROFILE_FIELDS.length;
// Config que consume el script inline (provincias dependientes + moneda por país).
const profileConfig = JSON.stringify({
  provinces: PROVINCES_BY_COUNTRY,
  currency: CURRENCY_BY_COUNTRY,
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Mi Hacé Cuentas — tu perfil numérico',
  description:
    'Iniciá sesión para guardar tu perfil numérico y que precargue todas las calculadoras en cualquier dispositivo.',
  url: 'https://hacecuentas.com/mi-hacecuentas',
  inLanguage: 'es-AR',
  isPartOf: { '@id': 'https://hacecuentas.com/#website' },
};

const inputType = (t: string) =>
  t === 'number' ? 'number' : t === 'date' ? 'date' : 'text';
---

<Layout
  title="Mi Hacé Cuentas — tu perfil numérico"
  description="Iniciá sesión para guardar tu perfil y que precargue todas las calculadoras en cualquier dispositivo. Login sin contraseña."
  noindex={true}
  schema={schema}
  pageType="hub"
>
  <Fragment slot="header">
    <!-- Barra superior (encima del header, sólo desloguéado) -->
    <div class="lg-topbar" data-login-topbar>
      <div class="lg-tb-in">
        <span class="lg-tb-left"><span class="lg-tb-dot" aria-hidden="true"></span><strong>Acceso seguro</strong><span class="lg-tb-sub"> · Sin contraseña</span></span>
        <span class="lg-tb-right" data-topbar-dest>Después de entrar volvés a tus herramientas</span>
      </div>
    </div>
    <Header />
  </Fragment>

  <div class="profile-page">
    <!-- Estado de carga -->
    <p class="profile-loading" data-auth-loading>Cargando…</p>

    <!-- ───────── No logueado: landing + login (mockup 2026-07-12) ───────── -->
    <div class="acct-landing" data-login-view hidden>
      <!-- HERO -->
      <section class="al-sec al-hero">
        <div class="wrap">
          <nav class="al-crumb" aria-label="Ruta de navegación"><a href="/">Inicio</a>&nbsp;/&nbsp;<span>Mi Hacé Cuentas</span></nav>
          <div class="al-hero-grid">
            <div class="al-copy">
              <span class="al-eyebrow">✨ Tu perfil numérico</span>
              <h1>Tus números, listos<br><span class="accent">cuando los necesitás.</span></h1>
              <p class="al-lead">Guardá una vez los datos que repetís siempre y encontrá cada calculadora lista para usar, desde cualquier dispositivo.</p>
              <div class="al-benefits">
                <div class="al-benefit"><span class="ab-ic i1" aria-hidden="true">⚡</span><span><b>Menos datos para completar</b><small>Precargamos sólo lo necesario.</small></span></div>
                <div class="al-benefit"><span class="ab-ic i2" aria-hidden="true">🔄</span><span><b>Todo sincronizado</b><small>Celular, notebook o tablet.</small></span></div>
                <div class="al-benefit"><span class="ab-ic i3" aria-hidden="true">⚡</span><span><b>Resultados más rápidos</b><small>Volvé a calcular en segundos.</small></span></div>
                <div class="al-benefit"><span class="ab-ic i4" aria-hidden="true">🔒</span><span><b>Siempre bajo tu control</b><small>Editá o borrá todo cuando quieras.</small></span></div>
              </div>
              <div class="al-precard">
                <div class="al-precard-head"><span>Tu perfil precarga estos datos</span><span class="al-synced">● Sincronizado</span></div>
                <div class="al-precard-grid">
                  <div class="al-pc"><small>Sueldo bruto</small><b>$ 1.500.000</b></div>
                  <div class="al-pc"><small>Provincia</small><b>Buenos Aires</b></div>
                  <div class="al-pc"><small>Antigüedad</small><b>4 años</b></div>
                  <div class="al-pc"><small>Alquiler</small><b>$ 480.000</b></div>
                </div>
              </div>
            </div>

            <aside class="al-login">
              <span class="al-eyebrow small">Empezá gratis</span>
              <h2>Creá tu cuenta</h2>
              <p class="al-login-sub">Sin contraseña. Entrá con Google o recibí un código de 6 dígitos en tu email.</p>

              <!-- Google Sign-In (se rellena por JS sólo si hay Client ID configurado) -->
              <div class="google-login" data-google-wrap hidden>
                <div class="google-btn-host" data-google-btn></div>
                <p class="login-err" data-google-err hidden></p>
                <div class="al-divider"><span>o con tu email</span></div>
              </div>

              <form data-email-step>
                <label for="login-email">Tu email</label>
                <input id="login-email" type="email" data-login-email placeholder="tu@email.com" autocomplete="email" required />
                <button type="submit" data-email-submit>Enviar código →</button>
                <p class="login-err" data-email-err hidden></p>
              </form>

              <form data-code-step hidden>
                <p class="code-sent">Te mandamos un código a <strong data-email-display></strong>.</p>
                <label for="login-code">Código</label>
                <input id="login-code" type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code" data-login-code placeholder="000000" />
                <button type="submit" data-code-submit>Entrar</button>
                <button type="button" class="link-btn" data-login-back>← Cambiar email</button>
                <p class="login-err" data-code-err hidden></p>
              </form>

              <p class="al-privacy">🔒 Usamos tu email sólo para iniciar sesión y sincronizar tu perfil. <a href="/privacidad">Más sobre privacidad</a></p>

              <label class="al-nl">
                <input type="checkbox" data-nl />
                <span>Quiero recibir novedades y herramientas útiles por email. <em>Opcional.</em></span>
              </label>
            </aside>
          </div>
        </div>
      </section>

      <!-- CÓMO FUNCIONA -->
      <section class="al-sec al-steps">
        <div class="wrap">
          <div class="al-center">
            <span class="al-kicker">Simple de verdad</span>
            <h2 class="al-title">Una cuenta que te ahorra tiempo</h2>
            <p class="al-sub">No necesitás armar un perfil completo. Guardás lo que quieras, cuando lo necesitás.</p>
          </div>
          <div class="al-steps-grid">
            <div class="al-step"><span class="al-num">01</span><b>Entrás sin contraseña</b><p>Google o un código temporal al email. Sin claves nuevas para recordar.</p></div>
            <div class="al-step"><span class="al-num">02</span><b>Guardás tus datos frecuentes</b><p>Sueldo, provincia, antigüedad, alquiler y otros valores que repetís.</p></div>
            <div class="al-step"><span class="al-num">03</span><b>Calculás más rápido</b><p>Las herramientas compatibles aparecen precargadas y listas para revisar.</p></div>
          </div>
        </div>
      </section>

      <!-- PREVIEW DEL PANEL -->
      <section class="al-sec al-inside">
        <div class="wrap">
          <div class="al-center">
            <span class="al-kicker">Así se ve por dentro</span>
            <h2 class="al-title">Tu información, ordenada y útil</h2>
            <p class="al-sub">Un lugar claro para actualizar datos, continuar cálculos y controlar tu cuenta.</p>
          </div>
          <div class="al-dash" aria-hidden="true">
            <aside class="al-dash-side">
              <div class="al-dash-acct"><span class="al-dash-ava">MB</span><span class="al-dash-acct-txt"><b>Mi cuenta</b><small>martin@email.com</small></span></div>
              <span class="al-dash-nav is-on">▤ Resumen</span>
              <span class="al-dash-nav">👤 Mi perfil</span>
              <span class="al-dash-nav">🕘 Actividad reciente</span>
              <span class="al-dash-nav">♡ Favoritos</span>
              <span class="al-dash-nav">🔒 Privacidad</span>
            </aside>
            <div class="al-dash-main">
              <div class="al-dash-head"><b>Buen día, Martin</b><span class="al-synced">● Todo guardado</span></div>
              <div class="al-dash-cards">
                <div class="al-dash-card"><small>Perfil laboral</small><b>$ 1.500.000</b><span>Sueldo bruto mensual</span></div>
                <div class="al-dash-card"><small>Ubicación</small><b>Buenos Aires</b><span>Provincia principal</span></div>
                <div class="al-dash-card"><small>Antigüedad</small><b>4 años y 2 meses</b><span>Desde mayo de 2022</span></div>
              </div>
              <div class="al-dash-foot"><span>Tu perfil ya puede precargar <b>18 calculadoras</b>.</span><span class="al-dash-link">Explorar calculadoras →</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- PRIVACIDAD (navy) -->
      <section class="al-sec al-privacy-sec">
        <div class="wrap">
          <div class="al-priv-grid">
            <div class="al-priv-copy">
              <span class="al-kicker light">Privacidad sin letra chica</span>
              <h2 class="al-title">Tus números son tuyos.</h2>
              <p>Mi Hacé Cuentas está pensado para ahorrar tiempo, no para convertir tus datos personales en un producto.</p>
            </div>
            <div class="al-priv-cards">
              <div class="al-priv-card"><b>Sin montos en analytics</b><p>No enviamos sueldo, alquiler ni resultados a herramientas de medición.</p></div>
              <div class="al-priv-card"><b>Newsletter separado</b><p>La suscripción es opcional y nunca viene marcada por defecto.</p></div>
              <div class="al-priv-card"><b>Control total</b><p>Podés editar, exportar o eliminar tu perfil y tu cuenta.</p></div>
              <div class="al-priv-card"><b>Sesión segura</b><p>Google o códigos temporales; no almacenamos una contraseña.</p></div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- ───────── Logueado: perfil ───────── -->
    <section data-profile-view hidden>
      <div class="acct-wrap">
      <header class="profile-hero">
        <h1>Mi Hacé Cuentas</h1>
        <p class="profile-lead">
          Tu perfil numérico. Lo cargás una vez y precarga todas las calculadoras,
          en cualquier dispositivo donde inicies sesión.
        </p>
      </header>
      <!-- Encabezado de cuenta (#19) -->
      <div class="account-card">
        <div class="account-avatar" data-account-avatar aria-hidden="true"></div>
        <div class="account-info">
          <strong class="account-email" data-account-email></strong>
          <span class="account-sub" data-account-sub></span>
        </div>
        <div class="account-menu">
          <button type="button" class="link-btn" data-logout>Cerrar sesión</button>
          <button type="button" class="link-btn link-subtle" data-logout-all>Cerrar en todos los dispositivos</button>
        </div>
      </div>

      <!-- Tus productos: la experiencia de marca con recurrencia (perfil + alertas
           + hitos + historial). Movido acá desde la home: vive en el área logueada. -->
      <section class="productos-mi" aria-labelledby="productos-mi-h">
        <div class="section-header">
          <div>
            <span class="eyebrow eyebrow-inline">⭐ Tus productos</span>
            <h2 id="productos-mi-h">Las cuentas que hacés todos los meses, en un solo lugar</h2>
            <p class="productos-mi-lede">
              Tus números precargan cada producto y vuelven con alertas, fechas e historial. Elegí uno.
            </p>
          </div>
          <a href="/mi" class="see-all">Ver mis productos →</a>
        </div>
        <div class="productos-mi-grid">
          {PRODUCTS.map((p) => (
            <a href={`/mi/${p.slug}`} class="producto-card" style={`--c-accent:${p.accent}`}>
              <span class="producto-icon" aria-hidden="true">{p.icon}</span>
              <span class="producto-name">{p.name}</span>
              <span class="producto-tag">{p.tagline}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Progreso del perfil (#7) + toggle ocultar montos (#16) -->
      <div class="profile-toolbar">
        <button type="button" class="amounts-toggle" data-amounts-toggle aria-pressed="false">
          <span class="eye-open" aria-hidden="true">👁️</span><span class="eye-off" aria-hidden="true" hidden>🙈</span>
          <span data-amounts-toggle-label>Ocultar montos</span>
        </button>
      </div>
      <div class="profile-progress" data-progress-wrap>
        <div class="profile-progress-head">
          <span class="profile-progress-label" data-progress-label></span>
          <span class="profile-progress-pct" data-progress-pct></span>
        </div>
        <div class="profile-progress-track"><div class="profile-progress-fill" data-progress-fill></div></div>
      </div>

      <form class="profile-form" data-profile-form>
        {groups.map((g) => (
          <div class="profile-group" data-profile-group={g.id}>
            <button type="button" class="group-toggle" data-group-toggle={g.id} aria-expanded="true">
              <span class="group-title"><span aria-hidden="true">{g.icon}</span> {g.label}</span>
              <span class="group-count" data-group-count={g.id}></span>
              <span class="group-chevron" aria-hidden="true">▾</span>
            </button>
            <div class="profile-rows" data-group-body={g.id}>
              {g.emptyHint && (
                <p class="group-empty-hint" data-group-empty={g.id} hidden>{g.emptyHint}</p>
              )}
              {g.fields.map((f) => (
                <div class="profile-row" data-profile-row={f.key}>
                  <label for={`pf-${f.key}`}>
                    {f.label}
                    {f.unit && <span class="profile-unit">({f.unit})</span>}
                  </label>
                  <div class="profile-control">
                    {f.key === 'ubicacion.provincia' ? (
                      <select id={`pf-${f.key}`} data-pk={f.key} data-ptype="provincia">
                        <option value="">Elegí primero el país</option>
                      </select>
                    ) : f.type === 'enum' ? (
                      <select id={`pf-${f.key}`} data-pk={f.key} data-ptype="enum">
                        <option value="">—</option>
                        {f.options?.map((o) => <option value={o.value}>{o.label}</option>)}
                      </select>
                    ) : f.type === 'boolean' ? (
                      <select id={`pf-${f.key}`} data-pk={f.key} data-ptype="boolean">
                        <option value="">—</option>
                        <option value="true">Sí</option>
                        <option value="false">No</option>
                      </select>
                    ) : f.type === 'number' && f.unit === '$' ? (
                      <input
                        id={`pf-${f.key}`}
                        type="text"
                        data-pk={f.key}
                        data-ptype="number"
                        data-money="1"
                        inputmode="numeric"
                        placeholder="—"
                      />
                    ) : (
                      <input
                        id={`pf-${f.key}`}
                        type={inputType(f.type)}
                        data-pk={f.key}
                        data-ptype={f.type}
                        inputmode={f.type === 'number' ? 'decimal' : undefined}
                        placeholder="—"
                      />
                    )}
                    <button type="button" class="profile-del" data-profile-del={f.key} hidden aria-label={`Borrar ${f.label}`}>✕</button>
                  </div>
                  {f.key === 'trabajo.antiguedadAnios' && (
                    <p class="profile-hint" data-antiguedad-hint hidden>Calculada desde tu fecha de ingreso. Podés ajustarla a mano.</p>
                  )}
                  <p class="profile-meta" data-profile-meta={f.key} hidden></p>
                  {usage[f.key] && usage[f.key].length > 0 && (
                    <p class="profile-usage">
                      <span aria-hidden="true">↻</span> Precarga {usage[f.key].length === 1 ? 'la calculadora' : `${usage[f.key].length} calculadoras`}:{' '}
                      {usage[f.key].map((c, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={`/${c.slug}`}>{c.title}</a>
                        </>
                      ))}
                    </p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </form>

      <!-- Recientes + Favoritos (#19): tu actividad, unificada en el panel.
           Datos de localStorage (hc_recent / hc_favs, contrato {s,t,l,d}), 100%
           cliente, ocultos si están vacíos. Misma reconstrucción de URL que el home. -->
      <section class="panel-calcs" data-panel-calcs hidden>
        <div class="panel-calcs-group" data-recent-group hidden>
          <h2 class="panel-calcs-h">🕘 Usadas recientemente</h2>
          <div class="panel-calcs-grid" data-recent-grid></div>
        </div>
        <div class="panel-calcs-group" data-favs-group hidden>
          <h2 class="panel-calcs-h">⭐ Tus favoritas</h2>
          <div class="panel-calcs-grid" data-favs-grid></div>
        </div>
      </section>

      <!-- Alertas de cambios normativos -->
      <section class="alerts-block" data-alerts-block>
        <h2 class="alerts-h">🔔 Tus alertas de cambios</h2>
        <p class="alerts-intro">Te avisamos por mail cuando una actualización normativa cambia un resultado que guardaste.</p>
        <p class="alerts-empty" data-alerts-empty hidden>Todavía no tenés alertas. Creá una desde cualquier calculadora fiscal, con el botón <strong>“Avisame si una norma cambia este resultado”</strong>.</p>
        <ul class="alerts-list" data-alerts-list></ul>
      </section>

      <div class="profile-actions">
        <button type="button" class="profile-clear-all" data-profile-clear-all>Borrar todos mis datos</button>
        <button type="button" class="profile-delete-account" data-delete-account>Borrar mi cuenta</button>
      </div>
      </div><!-- /.acct-wrap -->
    </section>
  </div>

  <!-- Barra de guardado fija (#2). Visible sólo logueado. -->
  <div class="save-bar" data-save-bar hidden>
    <span class="save-status" data-save-status>Todo guardado</span>
    <button type="button" class="save-btn" data-save-btn disabled>Guardar datos</button>
  </div>

  <script type="application/json" data-profile-config set:html={profileConfig}></script>

  <Footer slot="footer" />
</Layout>

<style is:global>
  /* Landing del login (mockup): full-bleed como los hubs. El dashboard logueado
     se re-centra con .acct-wrap. */
  body[data-page-type='hub'] > main#main {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip;
  }
  /* Recientes + Favoritos del panel (#19). Global porque el markup se puebla
     por DOM API (sin scope hash de Astro). Tokens → hereda tema/dominio. */
  .panel-calcs { display: grid; gap: 1.25rem; margin: 1.75rem 0; }
  .panel-calcs[hidden] { display: none; }
  .panel-calcs-group[hidden] { display: none; }
  .panel-calcs-h { font-size: 1.05rem; margin-bottom: 0.75rem; }
  .panel-calcs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.6rem; }
  .pc-card { position: relative; display: flex; align-items: center; gap: 0.5rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius, 10px); padding: 0.7rem 0.85rem; transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease; }
  .pc-card:hover { transform: translateY(-2px); border-color: var(--accent); box-shadow: var(--shadow-md); }
  .pc-link { color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.9rem; line-height: 1.3; flex: 1; }
  .pc-link:hover { color: var(--accent); }
  .pc-remove { flex-shrink: 0; width: 26px; height: 26px; border-radius: 999px; border: none; background: transparent; color: var(--text-subtle); font-size: 1.15rem; line-height: 1; cursor: pointer; }
  .pc-remove:hover { background: var(--bg-muted); color: var(--danger, #dc2626); }
</style>

<script is:inline>
  // Panel de Recientes + Favoritos (#19). Independiente del script principal.
  (function () {
    function read(key) {
      try { var a = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(a) ? a : []; } catch (e) { return []; }
    }
    function write(key, arr) { try { localStorage.setItem(key, JSON.stringify(arr)); } catch (e) {} }
    function urlOf(f) { return (f.l ? '/' + f.l : '') + '/' + f.s; }
    function valid(f) { return f && typeof f.s === 'string' && /^[a-z0-9][a-z0-9/-]*$/i.test(f.s); }

    function renderGroup(items, gridSel, groupSel, removableKey) {
      var grid = document.querySelector(gridSel);
      var group = document.querySelector(groupSel);
      if (!grid || !group) return false;
      while (grid.firstChild) grid.removeChild(grid.firstChild);
      var list = items.filter(valid).slice(0, 12);
      if (!list.length) { group.hidden = true; return false; }
      list.forEach(function (f) {
        var card = document.createElement('div'); card.className = 'pc-card';
        var a = document.createElement('a'); a.className = 'pc-link'; a.href = urlOf(f);
        a.textContent = (typeof f.t === 'string' && f.t) ? f.t : f.s.replace(/-/g, ' ');
        card.appendChild(a);
        if (removableKey) {
          var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'pc-remove';
          rm.setAttribute('aria-label', 'Quitar de tus favoritas'); rm.textContent = '×';
          rm.addEventListener('click', function (ev) {
            ev.preventDefault(); ev.stopPropagation();
            var next = read(removableKey).filter(function (x) { return !(x && x.s === f.s && (x.l || '') === (f.l || '')); });
            write(removableKey, next); renderAll();
          });
          card.appendChild(rm);
        }
        grid.appendChild(card);
      });
      group.hidden = false;
      return true;
    }

    function renderAll() {
      var panel = document.querySelector('[data-panel-calcs]');
      if (!panel) return;
      var recent = read('hc_recent').slice().reverse(); // más nuevo primero
      var favs = read('hc_favs').slice().reverse();
      var hasRecent = renderGroup(recent, '[data-recent-grid]', '[data-recent-group]', null);
      var hasFavs = renderGroup(favs, '[data-favs-grid]', '[data-favs-group]', 'hc_favs');
      panel.hidden = !(hasRecent || hasFavs);
    }

    renderAll();
    document.addEventListener('astro:page-load', renderAll);
  })();
</script>

<script is:inline>
  (function () {
    function qs(s) { return document.querySelector(s); }
    var state = { email: '' };

    async function api(path, opts) {
      var res = await fetch(path, Object.assign({
        headers: { 'content-type': 'application/json' },
        credentials: 'same-origin',
      }, opts));
      var data = null;
      try { data = await res.json(); } catch (e) {}
      return { ok: res.ok, status: res.status, data: data };
    }

    function show(view) {
      qs('[data-auth-loading]').hidden = view !== 'loading';
      qs('[data-login-view]').hidden = view !== 'login';
      qs('[data-profile-view]').hidden = view !== 'profile';
    }

    function fmtDate(iso) { try { return new Date(iso).toLocaleDateString('es-AR'); } catch (e) { return ''; } }
    function srcLabel(src) {
      if (!src || src === 'profile') return 'editado por vos';
      if (src.indexOf('calc:') === 0) return 'desde ' + src.slice(5);
      return src;
    }

    // ───── Editor (logueado) ─────
    // Config del server (provincias dependientes + moneda por país).
    var CFG = (function () { try { return JSON.parse(qs('[data-profile-config]').textContent || '{}'); } catch (e) { return {}; } })();
    var PROVINCES = CFG.provinces || {};
    var CURRENCY = CFG.currency || {};

    var dirty = {};      // claves con cambios sin guardar
    var saving = false;

    function fields() { return document.querySelectorAll('[data-pk]'); }
    function fieldEl(key) { return qs('[data-pk="' + key + '"]'); }

    // Formatea miles en vivo (1000000 → 1.000.000). Solo enteros.
    function fmtMoney(str) {
      var digits = String(str == null ? '' : str).replace(/\D/g, '');
      return digits ? Number(digits).toLocaleString('es-AR') : '';
    }
    function displayValue(el, value) {
      if (el.getAttribute('data-money')) return fmtMoney(value);
      return String(value);
    }
    // Valor actual normalizado del campo (number/string/'' ).
    function currentValue(el) {
      var ptype = el.getAttribute('data-ptype');
      var raw = (el.value || '').trim();
      if (raw === '') return '';
      if (ptype === 'number') return Number(raw.replace(/[.\s]/g, '').replace(',', '.'));
      return raw;
    }

    function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

    // Rellena el desplegable de provincia según el país (#1).
    function populateProvinces(country, selected) {
      var sel = fieldEl('ubicacion.provincia');
      if (!sel) return;
      var list = PROVINCES[country] || [];
      if (!list.length) {
        sel.innerHTML = '<option value="">' + (country ? 'Sin jurisdicciones para este país' : 'Elegí primero el país') + '</option>';
        return;
      }
      var html = '<option value="">—</option>';
      for (var i = 0; i < list.length; i++) html += '<option value="' + esc(list[i]) + '">' + esc(list[i]) + '</option>';
      sel.innerHTML = html;
      if (selected) sel.value = selected;
    }

    // Antigüedad en años (#4) derivada de la fecha de ingreso.
    function yearsSince(iso) {
      var d = new Date(iso); if (isNaN(d.getTime())) return null;
      var now = new Date();
      var y = now.getFullYear() - d.getFullYear();
      var m = now.getMonth() - d.getMonth();
      if (m < 0 || (m === 0 && now.getDate() < d.getDate())) y--;
      return y >= 0 && y < 100 ? y : null;
    }
    function toggleAntiguedadHint(on) {
      var h = qs('[data-antiguedad-hint]'); if (h) h.hidden = !on;
    }

    function updateProgress() {
      var all = fields(); var n = 0, total = all.length;
      Array.prototype.forEach.call(all, function (el) { if (currentValue(el) !== '') n++; });
      var pct = total ? Math.round((n / total) * 100) : 0;
      var fill = qs('[data-progress-fill]'); if (fill) fill.style.width = pct + '%';
      var pe = qs('[data-progress-pct]'); if (pe) pe.textContent = pct + '%';
      var le = qs('[data-progress-label]');
      if (le) le.textContent = n === 0 ? 'Tu perfil está vacío — cargá tus datos' : (n + ' de ' + total + ' datos cargados');
    }

    function setStatus(text, kind) {
      var s = qs('[data-save-status]'); if (!s) return;
      s.textContent = text;
      s.className = 'save-status' + (kind ? ' is-' + kind : '');
    }
    function updateSaveBar() {
      var n = Object.keys(dirty).length;
      var btn = qs('[data-save-btn]'); if (btn) btn.disabled = (n === 0) || saving;
      if (n > 0) setStatus(n === 1 ? '1 cambio sin guardar' : n + ' cambios sin guardar', 'dirty');
    }
    // Contador por grupo (#18) + visibilidad del hint de grupo vacío (#20).
    function updateGroupCounts() {
      Array.prototype.forEach.call(document.querySelectorAll('[data-group-body]'), function (body) {
        var gid = body.getAttribute('data-group-body');
        var els = body.querySelectorAll('[data-pk]');
        var n = 0;
        Array.prototype.forEach.call(els, function (el) { if (currentValue(el) !== '') n++; });
        var cnt = qs('[data-group-count="' + gid + '"]'); if (cnt) cnt.textContent = n + '/' + els.length;
        var empty = qs('[data-group-empty="' + gid + '"]'); if (empty) empty.hidden = n > 0;
      });
    }

    function markDirty(key) { dirty[key] = true; updateProgress(); updateGroupCounts(); updateSaveBar(); }

    // Ocultar/mostrar montos (#16) — blur en los campos $, recordado en localStorage.
    function applyAmountsHidden(on) {
      var form = qs('[data-profile-form]'); if (form) form.classList.toggle('amounts-hidden', on);
      var btn = qs('[data-amounts-toggle]'); if (!btn) return;
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      var eo = qs('.eye-open'), ef = qs('.eye-off'); if (eo) eo.hidden = on; if (ef) ef.hidden = !on;
      var lbl = qs('[data-amounts-toggle-label]'); if (lbl) lbl.textContent = on ? 'Mostrar montos' : 'Ocultar montos';
    }
    function wireAmountsToggle() {
      var btn = qs('[data-amounts-toggle]'); if (!btn || btn.dataset.wired) return; btn.dataset.wired = '1';
      var saved = false; try { saved = localStorage.getItem('hc_hide_amounts') === '1'; } catch (e) {}
      applyAmountsHidden(saved);
      btn.addEventListener('click', function () {
        var on = btn.getAttribute('aria-pressed') !== 'true';
        applyAmountsHidden(on);
        try { localStorage.setItem('hc_hide_amounts', on ? '1' : '0'); } catch (e) {}
      });
    }

    // Acordeón de grupos (#18).
    function wireGroupToggles() {
      Array.prototype.forEach.call(document.querySelectorAll('[data-group-toggle]'), function (btn) {
        if (btn.dataset.wired) return; btn.dataset.wired = '1';
        btn.addEventListener('click', function () {
          var gid = btn.getAttribute('data-group-toggle');
          var body = qs('[data-group-body="' + gid + '"]');
          var open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', open ? 'false' : 'true');
          if (body) body.hidden = open;
        });
      });
    }

    function hydrateEditor(profile) {
      // Espejá el perfil del server al store local para que las calcs precarguen.
      try {
        if (window.HCProfile) {
          window.HCProfile.clear();
          Object.keys(profile).forEach(function (k) {
            window.HCProfile.set(k, profile[k].value, profile[k].src || 'profile');
          });
        }
      } catch (e) {}

      var pais = profile['ubicacion.pais'] ? String(profile['ubicacion.pais'].value) : '';
      var prov = profile['ubicacion.provincia'] ? String(profile['ubicacion.provincia'].value) : '';
      populateProvinces(pais, prov);

      Array.prototype.forEach.call(fields(), function (el) {
        var key = el.getAttribute('data-pk');
        var entry = profile[key];
        var del = qs('[data-profile-del="' + key + '"]');
        var meta = qs('[data-profile-meta="' + key + '"]');
        if (key === 'ubicacion.provincia') {
          // value ya seteado por populateProvinces
        } else if (entry) {
          el.value = displayValue(el, entry.value);
        } else {
          el.value = '';
        }
        if (del) del.hidden = !entry && currentValue(el) === '';
        if (entry && meta) { meta.hidden = false; meta.textContent = 'Actualizado ' + fmtDate(entry.at) + ' · ' + srcLabel(entry.src); }
        else if (meta) meta.hidden = true;
      });

      toggleAntiguedadHint(!!profile['trabajo.fechaIngreso']);
      dirty = {};
      updateProgress();
      updateGroupCounts();
      setStatus('Todo guardado', 'saved');
      var btn = qs('[data-save-btn]'); if (btn) btn.disabled = true;
    }

    function wireEditor() {
      Array.prototype.forEach.call(fields(), function (el) {
        if (el.dataset.wired) return; el.dataset.wired = '1';
        var key = el.getAttribute('data-pk');
        var isMoney = !!el.getAttribute('data-money');
        var evt = (el.tagName === 'SELECT' || el.getAttribute('data-ptype') === 'date') ? 'change' : 'input';

        el.addEventListener(evt, function () {
          if (isMoney) el.value = fmtMoney(el.value);
          markDirty(key);
          var del = qs('[data-profile-del="' + key + '"]'); if (del) del.hidden = currentValue(el) === '';

          if (key === 'ubicacion.pais') {
            var pais = el.value;
            populateProvinces(pais, '');
            markDirty('ubicacion.provincia');
            // Autosugerir moneda si está vacía (#3).
            var mon = fieldEl('moneda.principal');
            if (mon && !mon.value && CURRENCY[pais]) { mon.value = CURRENCY[pais]; markDirty('moneda.principal'); }
          }
          if (key === 'trabajo.fechaIngreso') {
            var yrs = yearsSince(el.value);
            var ant = fieldEl('trabajo.antiguedadAnios');
            if (ant && yrs != null) { ant.value = String(yrs); markDirty('trabajo.antiguedadAnios'); }
            toggleAntiguedadHint(!!el.value);
          }
        });
      });

      Array.prototype.forEach.call(document.querySelectorAll('[data-profile-del]'), function (btn) {
        if (btn.dataset.wired) return; btn.dataset.wired = '1';
        btn.addEventListener('click', function () {
          var key = btn.getAttribute('data-profile-del');
          var el = fieldEl(key); if (el) el.value = '';
          btn.hidden = true;
          markDirty(key);
          if (key === 'trabajo.fechaIngreso') toggleAntiguedadHint(false);
        });
      });

      var saveBtn = qs('[data-save-btn]');
      if (saveBtn && !saveBtn.dataset.wired) { saveBtn.dataset.wired = '1'; saveBtn.addEventListener('click', save); }

      var clearAll = qs('[data-profile-clear-all]');
      if (clearAll && !clearAll.dataset.wired) {
        clearAll.dataset.wired = '1';
        clearAll.addEventListener('click', async function () {
          if (!window.confirm('¿Borrar todos los datos de tu perfil? No se puede deshacer.')) return;
          await api('/api/profile', { method: 'DELETE', body: '{}' });
          if (window.HCProfile) window.HCProfile.clear();
          await refresh();
        });
      }
      var del = qs('[data-delete-account]');
      if (del && !del.dataset.wired) {
        del.dataset.wired = '1';
        del.addEventListener('click', async function () {
          if (!window.confirm('¿Borrar tu cuenta y todos tus datos para siempre?')) return;
          await api('/api/auth/account', { method: 'DELETE' });
          if (window.HCProfile) window.HCProfile.clear();
          location.reload();
        });
      }
      var logout = qs('[data-logout]');
      if (logout && !logout.dataset.wired) {
        logout.dataset.wired = '1';
        logout.addEventListener('click', async function () {
          await api('/api/auth/logout', { method: 'POST', body: '{}' });
          if (window.HCProfile) window.HCProfile.clear();
          location.reload();
        });
      }
      var logoutAll = qs('[data-logout-all]');
      if (logoutAll && !logoutAll.dataset.wired) {
        logoutAll.dataset.wired = '1';
        logoutAll.addEventListener('click', async function () {
          if (!window.confirm('¿Cerrar sesión en TODOS los dispositivos? Vas a tener que volver a entrar en cada uno.')) return;
          await api('/api/auth/logout-all', { method: 'POST', body: '{}' });
          if (window.HCProfile) window.HCProfile.clear();
          location.reload();
        });
      }

      wireAmountsToggle();
      wireGroupToggles();

      if (!window.__hcUnloadGuard) {
        window.__hcUnloadGuard = true;
        window.addEventListener('beforeunload', function (e) {
          if (Object.keys(dirty).length) { e.preventDefault(); e.returnValue = ''; }
        });
      }
    }

    async function save() {
      if (saving) return;
      var keys = Object.keys(dirty); if (!keys.length) return;
      saving = true;
      var btn = qs('[data-save-btn]'); if (btn) btn.disabled = true;
      setStatus('Guardando…', 'saving');
      var ok = true;
      for (var i = 0; i < keys.length; i++) {
        var key = keys[i];
        var el = fieldEl(key);
        var value = el ? currentValue(el) : '';
        var r;
        if (value === '') {
          r = await api('/api/profile', { method: 'DELETE', body: JSON.stringify({ key: key }) });
          if (window.HCProfile) window.HCProfile.clear(key);
        } else {
          r = await api('/api/profile', { method: 'POST', body: JSON.stringify({ key: key, value: value, src: 'profile' }) });
          if (window.HCProfile) window.HCProfile.set(key, value, 'profile');
        }
        if (!r.ok) ok = false;
      }
      saving = false;
      dirty = {};
      await refresh();
      setStatus(ok ? 'Guardado ✓' : 'Hubo un error al guardar', ok ? 'saved' : 'error');
    }

    async function refresh() {
      var r = await api('/api/auth/me', { method: 'GET' });
      if (r.data && r.data.authed) hydrateEditor(r.data.profile || {});
    }

    // Encabezado de cuenta rico (#19): avatar (inicial), email, proveedor + alta.
    function fillAccountHeader(me) {
      var email = me.email || '';
      var em = qs('[data-account-email]'); if (em) em.textContent = email;
      var av = qs('[data-account-avatar]'); if (av) av.textContent = (email.charAt(0) || '?').toUpperCase();
      var sub = qs('[data-account-sub]');
      if (sub) {
        var parts = [];
        if (me.authProvider) parts.push(me.authProvider === 'google' ? 'Entraste con Google' : 'Entrás con código por mail');
        if (me.createdAt) { try { parts.push('miembro desde ' + new Date(me.createdAt).toLocaleDateString('es-AR', { month: 'long', year: 'numeric' })); } catch (e) {} }
        sub.textContent = parts.join(' · ');
        sub.hidden = parts.length === 0;
      }
    }

    function showProfile(me) {
      fillAccountHeader(me);
      show('profile');
      var bar = qs('[data-save-bar]'); if (bar) bar.hidden = false;
      hydrateEditor(me.profile || {});
      wireEditor();
      loadAlerts();
    }

    // ───── Alertas "avisame cuando cambie" ─────
    function fmtAlertVal(v) {
      var n = Number(String(v).replace(/[^\d.-]/g, ''));
      return isFinite(n) && String(v).replace(/[^\d.-]/g, '') !== '' ? '$' + n.toLocaleString('es-AR', { maximumFractionDigits: 0 }) : String(v);
    }
    async function loadAlerts() {
      var list = qs('[data-alerts-list]'); var empty = qs('[data-alerts-empty]');
      if (!list) return;
      var r = await api('/api/alerts/mine', { method: 'GET' });
      var alerts = (r.data && r.data.alerts) || [];
      list.innerHTML = '';
      if (empty) empty.hidden = alerts.length > 0;
      alerts.forEach(function (a) {
        var li = document.createElement('li');
        li.className = 'alert-item';
        var changed = a.last_changed_at ? ' · cambió ' + new Date(a.last_changed_at).toLocaleDateString('es-AR') : '';
        li.innerHTML =
          '<div class="alert-item-body">' +
            '<a class="alert-item-title" href="/' + a.slug + '">' + (a.headline_label || a.slug) + '</a>' +
            '<span class="alert-item-meta">Hoy: <strong>' + fmtAlertVal(a.last_headline) + '</strong>' + changed + '</span>' +
          '</div>' +
          '<button type="button" class="alert-item-del" data-alert-del="' + a.id + '" aria-label="Borrar alerta">✕</button>';
        list.appendChild(li);
      });
      Array.prototype.forEach.call(list.querySelectorAll('[data-alert-del]'), function (btn) {
        btn.addEventListener('click', async function () {
          var id = btn.getAttribute('data-alert-del');
          await api('/api/alerts/' + id, { method: 'DELETE' });
          loadAlerts();
        });
      });
    }

    // ───── Login ─────
    function err(sel, msg) { var e = qs(sel); if (!e) return; e.hidden = !msg; e.textContent = msg || ''; }

    function wireLogin() {
      var emailStep = qs('[data-email-step]');
      var codeStep = qs('[data-code-step]');

      emailStep.addEventListener('submit', async function (ev) {
        ev.preventDefault();
        err('[data-email-err]', '');
        var email = (qs('[data-login-email]').value || '').trim().toLowerCase();
        if (!email) return;
        var btn = qs('[data-email-submit]'); btn.disabled = true; btn.textContent = 'Enviando…';
        var r = await api('/api/auth/request-code', { method: 'POST', body: JSON.stringify({ email: email }) });
        btn.disabled = false; btn.textContent = 'Enviarme un código';
        if (!r.ok) { err('[data-email-err]', (r.data && r.data.error) || 'No se pudo enviar.'); return; }
        state.email = email;
        qs('[data-email-display]').textContent = email;
        emailStep.hidden = true; codeStep.hidden = false;
        qs('[data-login-code]').focus();
        if (r.data && r.data.devCode) { qs('[data-login-code]').value = r.data.devCode; } // sólo dev
      });

      qs('[data-login-back]').addEventListener('click', function () {
        codeStep.hidden = true; emailStep.hidden = false; err('[data-code-err]', '');
      });

      codeStep.addEventListener('submit', async function (ev) {
        ev.preventDefault();
        err('[data-code-err]', '');
        var code = (qs('[data-login-code]').value || '').trim();
        if (!/^\d{6}$/.test(code)) { err('[data-code-err]', 'Ingresá los 6 dígitos.'); return; }
        var newsletter = qs('[data-nl]').checked;
        var btn = qs('[data-code-submit]'); btn.disabled = true; btn.textContent = 'Entrando…';
        var r = await api('/api/auth/verify', { method: 'POST', body: JSON.stringify({ email: state.email, code: code, newsletter: newsletter }) });
        btn.disabled = false; btn.textContent = 'Entrar';
        if (!r.ok) { err('[data-code-err]', (r.data && r.data.error) || 'Código incorrecto.'); return; }
        trackLogin('email');
        showProfile({ email: r.data.email, profile: r.data.profile || {} });
        // Si vino de una calc (?next=/ruta), volver allá (el perfil ya quedó en
        // el caché local, así que la calc precarga). Guard anti open-redirect.
        var next = new URLSearchParams(location.search).get('next');
        if (next && next.charAt(0) === '/' && next.charAt(1) !== '/') location.assign(next);
      });
    }

    // ───── Google Sign-In (Google Identity Services) ─────
    var googleInited = false;
    function setupGoogle(clientId) {
      if (!clientId || googleInited) return;
      googleInited = true;
      var wrap = qs('[data-google-wrap]');
      if (wrap) wrap.hidden = false;

      function initGsi() {
        if (!(window.google && window.google.accounts && window.google.accounts.id)) return;
        window.google.accounts.id.initialize({
          client_id: clientId,
          callback: onGoogleCredential,
          auto_select: false,
          cancel_on_tap_outside: true,
        });
        var host = qs('[data-google-btn]');
        if (host) {
          // Ancho responsive: GSI usa un width fijo → lo calculamos según el
          // espacio real de la card para que no desborde en mobile.
          var avail = Math.round(host.getBoundingClientRect().width) || 360;
          var gw = Math.max(200, Math.min(400, avail));
          window.google.accounts.id.renderButton(host, {
            type: 'standard', theme: 'outline', size: 'large',
            text: 'continue_with', shape: 'rectangular', logo_alignment: 'left',
            locale: 'es-419', width: gw,
          });
        }
      }

      // Cargar el script de GIS una sola vez y luego inicializar.
      var existing = document.getElementById('gsi-script');
      if (existing) { if (window.google) initGsi(); else existing.addEventListener('load', initGsi); return; }
      var s = document.createElement('script');
      s.src = 'https://accounts.google.com/gsi/client';
      s.async = true; s.defer = true; s.id = 'gsi-script';
      s.onload = initGsi;
      document.head.appendChild(s);
    }

    async function onGoogleCredential(resp) {
      err('[data-google-err]', '');
      if (!resp || !resp.credential) { err('[data-google-err]', 'No se pudo iniciar sesión con Google.'); return; }
      var newsletter = qs('[data-nl]') ? qs('[data-nl]').checked : false;
      var r = await api('/api/auth/google', {
        method: 'POST',
        body: JSON.stringify({ credential: resp.credential, newsletter: newsletter }),
      });
      if (!r.ok) { err('[data-google-err]', (r.data && r.data.error) || 'No se pudo iniciar sesión con Google.'); return; }
      trackLogin('google');
      showProfile({ email: r.data.email, profile: r.data.profile || {} });
      var next = new URLSearchParams(location.search).get('next');
      if (next && next.charAt(0) === '/' && next.charAt(1) !== '/') location.assign(next);
    }

    // Evento GA4 de login completado (embudo: vio la pantalla → se logueó).
    function trackLogin(method) {
      try { if (typeof window.gtag === 'function') window.gtag('event', 'login', { method: method }); }
      catch (_) {}
    }

    async function init() {
      show('loading');
      wireLogin();
      var r = await api('/api/auth/me', { method: 'GET' });
      if (r.data && r.data.authed) { showProfile(r.data); return; }
      show('login');
      if (r.data && r.data.googleClientId) setupGoogle(r.data.googleClientId);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>

<style>
  /* Tus productos (movido desde la home → área logueada). */
  .productos-mi { margin: 1.5rem 0 2rem; }
  .productos-mi .section-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.25rem;
  }
  .productos-mi .section-header h2 { margin: 0; font-size: 1.5rem; }
  .productos-mi .eyebrow {
    font-size: 0.75rem; font-weight: 700; color: var(--accent);
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .productos-mi .eyebrow-inline {
    display: inline-flex; align-items: center; gap: 0.375rem; margin-bottom: 0.375rem;
  }
  .productos-mi .see-all {
    font-size: 0.875rem; color: var(--accent); text-decoration: none;
    font-weight: 500; white-space: nowrap;
  }
  .productos-mi .see-all:hover { text-decoration: underline; }
  .productos-mi-lede { margin: 0.5rem 0 0; max-width: 60ch; color: var(--text-muted); font-size: 0.9375rem; line-height: 1.55; }
  .productos-mi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1.25rem; }
  .producto-card {
    position: relative;
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 1.5rem 1.4rem 1.45rem;
    background: linear-gradient(165deg, color-mix(in srgb, var(--c-accent) 13%, var(--bg-card)), var(--bg-card) 72%);
    border: 1px solid color-mix(in srgb, var(--c-accent) 30%, var(--border));
    border-radius: 18px; text-decoration: none; color: var(--text); overflow: hidden;
    transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s;
  }
  .producto-card:hover { transform: translateY(-3px); border-color: var(--c-accent); box-shadow: 0 10px 28px -6px color-mix(in srgb, var(--c-accent) 32%, transparent); }
  .producto-icon {
    width: 54px; height: 54px; border-radius: 15px; margin-bottom: 0.35rem;
    display: inline-flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--c-accent) 18%, var(--bg-card));
    font-size: 1.85rem; line-height: 1;
  }
  .producto-name { font-size: 1.1875rem; font-weight: 800; letter-spacing: -0.02em; }
  .producto-tag { color: var(--c-accent); font-weight: 600; font-size: 0.875rem; }
  @media (hover: none) {
    .producto-card:hover { transform: none; box-shadow: none; }
  }
  @media (max-width: 640px) {
    .productos-mi .section-header { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    .productos-mi .section-header h2 { font-size: 1.25rem; }
  }

  .profile-page { }
  .acct-wrap { max-width: 720px; margin: 0 auto; padding: 2rem 1rem 3rem; }
  .profile-hero h1 { font-size: 1.75rem; margin: 0 0 0.5rem; }
  .profile-lead { color: var(--text-muted); margin: 0 0 1.25rem; line-height: 1.5; }
  .profile-loading { color: var(--text-subtle); text-align: center; padding: 4rem 1rem; }

  /* ═══════════ Landing del login (mockup 2026-07-12) ═══════════
     Mismo sistema visual que los hubs (PillarHub). Local, sólo estado deslogueado. */
  .acct-landing {
    --ink: #131729; --muted: #63697b; --line: #e5e7ef; --wash: #f7f7fb;
    --purple: #6853e7; --blue: #2f6fed; --navy: #14182d;
    --shadow: 0 18px 50px rgba(24, 26, 55, 0.1);
    color: var(--ink);
    font-family: 'Inter Variable', Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  .acct-landing a { text-decoration: none; color: inherit; }
  .acct-landing .wrap { width: min(1200px, calc(100% - 2.5rem)); margin: auto; }
  @media (min-width: 1600px) { .acct-landing .wrap { width: min(1360px, calc(100% - 6rem)); } }
  .acct-landing .al-sec { padding: 62px 0; }
  .acct-landing h1, .acct-landing h2 { color: var(--ink); letter-spacing: -0.03em; }
  .al-eyebrow {
    display: inline-flex; align-items: center; gap: 8px; border: 1px solid #dcd6ff; background: #fff;
    color: #5c48cb; padding: 7px 11px; border-radius: 999px; font-size: 12px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.6px;
  }
  .al-eyebrow.small { padding: 6px 10px; font-size: 11px; }
  .al-kicker { font-size: 12px; color: var(--purple); font-weight: 850; text-transform: uppercase; letter-spacing: 0.8px; }
  .al-kicker.light { color: #a99bff; }
  .al-title { font-size: clamp(26px, 3.4vw, 34px); font-weight: 820; margin: 8px 0 0; letter-spacing: -0.03em; }
  .al-sub { font-size: 16px; color: var(--muted); margin: 10px auto 0; max-width: 620px; }
  .al-center { text-align: center; margin-bottom: 34px; }

  /* HERO */
  .al-hero {
    background: radial-gradient(circle at 82% 12%, rgba(126, 101, 244, 0.20), transparent 30%), linear-gradient(180deg, #f5f3ff 0%, #fff 88%);
    border-bottom: 1px solid #ecebfa; padding-top: 46px; padding-bottom: 56px;
  }
  .al-crumb { font-size: 13px; color: #74788b; margin-bottom: 24px; }
  .al-crumb a:hover { color: var(--purple); }
  .al-hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: start; }
  .al-copy { min-width: 0; }
  .al-benefit { min-width: 0; }
  .al-copy h1 { font-size: clamp(34px, 4.6vw, 46px); line-height: 1.05; margin: 16px 0 14px; font-weight: 850; letter-spacing: -0.04em; }
  .al-copy h1 .accent { color: var(--purple); }
  .al-lead { font-size: 17px; line-height: 1.6; color: #555b6f; max-width: 520px; margin: 0 0 26px; }
  .al-benefits { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 26px; margin-bottom: 28px; }
  .al-benefit { display: flex; gap: 12px; align-items: flex-start; }
  .al-benefit .ab-ic { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; font-size: 16px; flex: none; }
  .al-benefit .i1 { background: #fff6df; } .al-benefit .i2 { background: #eaf7fb; }
  .al-benefit .i3 { background: #edf3ff; } .al-benefit .i4 { background: #f3efff; }
  .al-benefit b { display: block; font-size: 14px; font-weight: 750; margin-bottom: 2px; }
  .al-benefit small { color: var(--muted); font-size: 12.5px; line-height: 1.4; }
  .al-precard { border: 1px solid var(--line); border-radius: 16px; background: #fff; padding: 16px 18px; box-shadow: 0 8px 24px rgba(24, 26, 55, 0.05); }
  .al-precard-head { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--muted); margin-bottom: 12px; }
  .al-synced { color: #0f9f6e; font-weight: 700; font-size: 12px; }
  .al-precard-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .al-pc { border: 1px solid var(--line); border-radius: 11px; padding: 9px 11px; }
  .al-pc small { display: block; font-size: 10.5px; color: var(--muted); margin-bottom: 3px; }
  .al-pc b { font-size: 13.5px; font-weight: 750; }

  /* LOGIN CARD */
  .al-login { min-width: 0; background: #fff; border: 1px solid #ddd9f5; border-radius: 22px; padding: 26px; box-shadow: var(--shadow); }
  .al-login h2 { font-size: 24px; font-weight: 830; margin: 8px 0 6px; letter-spacing: -0.02em; }
  .al-login-sub { font-size: 13.5px; color: var(--muted); line-height: 1.5; margin: 0 0 18px; }
  .al-login label { display: block; font-size: 13px; font-weight: 650; margin: 0 0 6px; color: #3a4055; }
  .al-login input[type="email"], .al-login input[type="text"] {
    width: 100%; height: 46px; border: 1.5px solid #d8d9e4; border-radius: 12px; padding: 0 14px;
    font: inherit; font-size: 15px; background: #fff; color: var(--ink); margin-bottom: 12px;
  }
  .al-login input:focus { outline: none; border-color: var(--purple); }
  .al-login button[type="submit"] {
    width: 100%; height: 46px; border: 0; border-radius: 12px; cursor: pointer; font: inherit;
    font-size: 15px; font-weight: 800; color: #fff; background: linear-gradient(135deg, var(--purple), var(--blue));
    box-shadow: 0 8px 20px rgba(83, 81, 225, 0.22);
  }
  .al-login button[disabled] { opacity: 0.6; cursor: default; }
  .al-login .link-btn { background: none; border: 0; color: var(--muted); font: inherit; font-size: 13px; cursor: pointer; padding: 8px 0 0; text-decoration: underline; }
  .al-divider { display: flex; align-items: center; gap: 12px; margin: 16px 0; color: #9aa0b0; font-size: 12px; }
  .al-divider:before, .al-divider:after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .google-login { margin-bottom: 4px; }
  .google-btn-host { display: flex; justify-content: center; overflow: hidden; }
  .google-btn-host > div, .google-btn-host iframe { max-width: 100% !important; }
  .al-login .login-err { color: #dc2626; font-size: 12.5px; margin: 6px 0 0; }
  .al-login .code-sent { font-size: 13px; color: var(--muted); margin: 0 0 10px; }
  .al-privacy { display: flex; gap: 6px; font-size: 12px; color: #7b8091; line-height: 1.45; margin: 16px 0 0; }
  .al-privacy a { color: var(--purple); font-weight: 600; }
  .al-nl { display: flex; gap: 9px; align-items: flex-start; margin: 14px 0 0; font-size: 12.5px; color: #4a5063; line-height: 1.4; cursor: pointer; }
  .al-nl input { width: 16px; height: 16px; margin-top: 1px; flex: none; accent-color: var(--purple); }
  .al-nl em { color: var(--muted); font-style: normal; }

  /* CÓMO FUNCIONA */
  .al-steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .al-step { border: 1px solid var(--line); border-radius: 18px; background: #fff; padding: 26px 24px; transition: 0.18s; }
  .al-step:hover { border-color: #cfc8ff; box-shadow: 0 14px 34px rgba(33, 32, 70, 0.07); transform: translateY(-3px); }
  .al-num { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: #f1efff; color: var(--purple); font-weight: 850; font-size: 13px; margin-bottom: 16px; }
  .al-step b { display: block; font-size: 17px; font-weight: 780; margin-bottom: 8px; }
  .al-step p { font-size: 13.5px; color: var(--muted); line-height: 1.55; margin: 0; }

  /* PREVIEW DEL PANEL */
  .al-inside { background: var(--wash); }
  .al-dash { display: grid; grid-template-columns: 230px 1fr; gap: 20px; background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 22px; box-shadow: 0 18px 50px rgba(24, 26, 55, 0.08); max-width: 940px; margin: 0 auto; }
  .al-dash-side { background: #14182d; border-radius: 16px; padding: 16px; color: #cfd2e6; }
  .al-dash-acct { display: flex; gap: 10px; align-items: center; padding-bottom: 14px; margin-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .al-dash-ava { width: 38px; height: 38px; border-radius: 11px; background: linear-gradient(135deg, var(--purple), var(--blue)); display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 13px; flex: none; }
  .al-dash-acct-txt b { display: block; font-size: 13.5px; color: #fff; }
  .al-dash-acct-txt small { font-size: 11px; color: #9aa0bd; }
  .al-dash-nav { display: block; padding: 9px 11px; border-radius: 9px; font-size: 13px; color: #aab0c9; margin-bottom: 2px; }
  .al-dash-nav.is-on { background: rgba(255,255,255,0.08); color: #fff; font-weight: 650; }
  .al-dash-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .al-dash-head b { font-size: 19px; font-weight: 800; }
  .al-dash-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }
  .al-dash-card { border: 1px solid var(--line); border-radius: 13px; padding: 14px; }
  .al-dash-card small { display: block; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.4px; color: var(--muted); margin-bottom: 7px; }
  .al-dash-card b { display: block; font-size: 17px; font-weight: 800; margin-bottom: 4px; }
  .al-dash-card span { font-size: 12px; color: var(--muted); }
  .al-dash-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: #f4f2ff; border-radius: 12px; padding: 12px 16px; font-size: 13px; color: #4a5063; }
  .al-dash-link { color: var(--purple); font-weight: 700; white-space: nowrap; }

  /* PRIVACIDAD (navy) */
  .al-privacy-sec { background: var(--navy); color: #fff; }
  .al-priv-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 40px; align-items: center; }
  .al-priv-copy h2 { color: #fff; margin: 10px 0; }
  .al-priv-copy p { color: #aeb3c8; font-size: 15px; line-height: 1.6; margin: 0; max-width: 420px; }
  .al-priv-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .al-priv-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.11); border-radius: 15px; padding: 18px; }
  .al-priv-card b { display: block; font-size: 14.5px; font-weight: 750; margin-bottom: 6px; }
  .al-priv-card p { font-size: 12.5px; color: #aeb3c8; line-height: 1.5; margin: 0; }

  @media (max-width: 900px) {
    .al-hero-grid, .al-priv-grid { grid-template-columns: 1fr; gap: 32px; }
    .al-steps-grid, .al-dash-cards { grid-template-columns: 1fr; }
    .al-dash { grid-template-columns: 1fr; }
    .al-dash-side { display: none; }
  }
  @media (max-width: 560px) {
    .acct-landing .al-sec { padding: 40px 0; }
    .al-benefits { grid-template-columns: 1fr; }
    .al-precard-grid { grid-template-columns: 1fr 1fr; }
    .al-priv-cards { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .acct-landing * { transition: none !important; } }

  /* Login card */
  .login-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    max-width: 440px;
  }
  .login-card h2 { margin: 0 0 0.5rem; font-size: 1.25rem; }
  .login-sub { color: var(--text-muted); font-size: 0.875rem; line-height: 1.5; margin: 0 0 1.25rem; }
  .login-card label { display: block; font-size: 0.8125rem; font-weight: 600; margin: 0 0 0.375rem; }
  .login-card input[type="email"],
  .login-card input[type="text"] {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 1.5px solid var(--border-input);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    margin-bottom: 0.875rem;
  }
  #login-code { letter-spacing: 0.4em; text-align: center; font-size: 1.5rem; font-weight: 700; }
  .nl-check { display: flex !important; align-items: flex-start; gap: 0.5rem; font-weight: 400 !important; font-size: 0.8125rem !important; color: var(--text-muted); margin-bottom: 1rem !important; cursor: pointer; }
  .nl-check input { margin-top: 0.15rem; flex: 0 0 auto; }
  .login-card button[type="submit"] {
    width: 100%;
    padding: 0.75rem;
    background: var(--accent, #2563eb);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    font: inherit;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .login-card button[disabled] { opacity: 0.6; cursor: default; }
  .link-btn { background: none; border: none; color: var(--accent, #2563eb); cursor: pointer; font: inherit; font-size: 0.8125rem; padding: 0.5rem 0 0; }
  .code-sent { font-size: 0.875rem; color: var(--text-muted); margin: 0 0 0.875rem; }
  .login-err { color: var(--danger); font-size: 0.8125rem; margin: 0.5rem 0 0; }
  .google-btn-host { display: flex; justify-content: center; margin-bottom: 0.25rem; }
  .login-divider { display: flex; align-items: center; gap: 0.75rem; margin: 1rem 0 1.125rem; color: var(--text-subtle); font-size: 0.75rem; }
  .login-divider::before, .login-divider::after { content: ""; flex: 1; height: 1px; background: var(--border); }
  .login-privacy { margin: 1.25rem 0 0; font-size: 0.75rem; color: var(--text-subtle); line-height: 1.5; }
  .login-privacy a { color: var(--accent, #2563eb); }

  /* Ventajas de la cuenta (pre-login) */
  .login-benefits { list-style: none; margin: 0 0 1.25rem; padding: 0.875rem 1rem; background: var(--bg-muted); border-radius: var(--radius-sm); display: flex; flex-direction: column; gap: 0.625rem; }
  .login-benefits li { font-size: 0.8125rem; line-height: 1.45; color: var(--text-muted); display: flex; gap: 0.5rem; align-items: flex-start; }
  .login-benefits li span { flex: 0 0 auto; }
  .login-benefits strong { color: var(--text); font-weight: 600; }

  /* Profile (logged in) — encabezado de cuenta (#19) */
  .account-card {
    display: flex; align-items: center; gap: 0.875rem;
    padding: 0.875rem 1rem; background: var(--bg-muted); border-radius: var(--radius-sm); margin-bottom: 1.25rem;
  }
  .account-avatar {
    flex: 0 0 auto; width: 2.75rem; height: 2.75rem; border-radius: 50%;
    background: var(--accent, #2563eb); color: #fff; display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1.25rem; text-transform: uppercase;
  }
  .account-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .account-email { font-size: 0.9375rem; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .account-sub { font-size: 0.75rem; color: var(--text-subtle); }
  .account-menu { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-end; gap: 0.15rem; }
  .link-subtle { color: var(--text-subtle) !important; font-size: 0.75rem !important; }

  /* Toolbar (toggle ocultar montos #16) */
  .profile-toolbar { display: flex; justify-content: flex-end; margin: 0 0 0.75rem; }
  .amounts-toggle { display: inline-flex; align-items: center; gap: 0.4rem; background: none; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.35rem 0.75rem; font: inherit; font-size: 0.75rem; color: var(--text-muted); cursor: pointer; }
  .amounts-toggle:hover { border-color: var(--accent, #2563eb); color: var(--accent, #2563eb); }
  .profile-form.amounts-hidden input[data-money] { filter: blur(6px); }
  .profile-form.amounts-hidden input[data-money]:focus { filter: none; }

  /* Progreso del perfil (#7) */
  .profile-progress { margin: 0 0 1.5rem; }
  .profile-progress-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem; }
  .profile-progress-label { font-size: 0.8125rem; font-weight: 600; color: var(--text); }
  .profile-progress-pct { font-size: 0.8125rem; font-weight: 700; color: var(--accent, #2563eb); }
  .profile-progress-track { height: 8px; background: var(--bg-muted); border-radius: 999px; overflow: hidden; }
  .profile-progress-fill { height: 100%; width: 0; background: var(--accent, #2563eb); border-radius: 999px; transition: width 0.3s ease; }

  /* Hint de antigüedad derivada (#4) + usage links (#8) */
  .profile-hint { margin: 0.15rem 0 0; font-size: 0.6875rem; color: var(--text-subtle); font-style: italic; }
  .profile-usage { margin: 0.25rem 0 0; font-size: 0.6875rem; color: var(--text-subtle); line-height: 1.5; }
  .profile-usage a { color: var(--accent, #2563eb); text-decoration: none; }
  .profile-usage a:hover { text-decoration: underline; }

  /* Barra de guardado fija (#2) */
  .save-bar {
    position: sticky; bottom: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    max-width: 720px; margin: 0 auto; padding: 0.75rem 1rem;
    background: var(--bg); border-top: 1px solid var(--border);
    box-shadow: 0 -4px 16px rgba(0,0,0,0.06);
  }
  .save-status { font-size: 0.8125rem; color: var(--text-muted); }
  .save-status.is-dirty { color: var(--accent, #2563eb); font-weight: 600; }
  .save-status.is-saved { color: var(--success, #16a34a); }
  .save-status.is-error { color: var(--danger); font-weight: 600; }
  .save-btn {
    flex: 0 0 auto; padding: 0.625rem 1.5rem; background: var(--accent, #2563eb); color: #fff;
    border: none; border-radius: var(--radius-sm); font: inherit; font-weight: 600; font-size: 0.9375rem; cursor: pointer;
  }
  .save-btn:disabled { opacity: 0.5; cursor: default; }
  .profile-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .profile-group { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0; margin: 0; overflow: hidden; }
  .group-toggle {
    width: 100%; display: flex; align-items: center; gap: 0.5rem;
    background: none; border: none; padding: 0.875rem 1.25rem; cursor: pointer; font: inherit; color: var(--text); text-align: left;
  }
  .group-title { font-weight: 700; font-size: 0.9375rem; flex: 1; }
  .group-count { font-size: 0.75rem; font-weight: 600; color: var(--text-subtle); }
  .group-chevron { font-size: 0.75rem; color: var(--text-subtle); transition: transform 0.2s ease; }
  .group-toggle[aria-expanded="false"] .group-chevron { transform: rotate(-90deg); }
  .group-empty-hint { margin: 0 0 0.5rem; font-size: 0.75rem; color: var(--text-subtle); line-height: 1.45; font-style: italic; }
  .profile-rows[data-group-body] { padding: 0 1.25rem 1.25rem; }
  .profile-rows { display: flex; flex-direction: column; gap: 0.875rem; }
  .profile-row { display: flex; flex-direction: column; gap: 0.3125rem; }
  .profile-row label { font-size: 0.8125rem; font-weight: 600; color: var(--text); }
  .profile-unit { font-weight: 400; color: var(--text-subtle); margin-left: 0.25rem; }
  .profile-control { display: flex; align-items: center; gap: 0.5rem; }
  .profile-control input, .profile-control select {
    flex: 1; padding: 0.5rem 0.625rem; border: 1.5px solid var(--border-input);
    border-radius: var(--radius-sm); background: var(--bg); color: var(--text); font: inherit; font-size: 0.9375rem;
  }
  .profile-del { flex: 0 0 auto; background: none; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-subtle); width: 2rem; height: 2rem; cursor: pointer; }
  .profile-del:hover { border-color: var(--danger); color: var(--danger); }
  .profile-meta { margin: 0; font-size: 0.6875rem; color: var(--text-subtle); }
  /* Alertas de cambios normativos */
  .alerts-block { margin-top: 2rem; }
  .alerts-h { font-size: 1.05rem; margin: 0 0 0.25rem; }
  .alerts-intro { font-size: 0.8125rem; color: var(--text-muted); margin: 0 0 1rem; line-height: 1.5; }
  .alerts-empty { font-size: 0.8125rem; color: var(--text-subtle); line-height: 1.5; padding: 0.875rem 1rem; background: var(--bg-muted); border-radius: var(--radius-sm); margin: 0; }
  .alerts-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .alert-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm); }
  .alert-item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
