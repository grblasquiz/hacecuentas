    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.75rem;
    border-radius: 999px; font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase;
    color: var(--login-accent); background: color-mix(in srgb, var(--login-accent) 12%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--login-accent) 26%, var(--border));
  }
  .lg-title { margin: 1rem 0 0; font-size: clamp(2rem, 4.4vw, 3rem); line-height: 1.06; font-weight: 850; letter-spacing: -0.035em; color: var(--text); }
  .lg-accent { color: var(--login-accent); }
  .lg-lead { margin: 1rem 0 0; font-size: 1.0625rem; line-height: 1.6; color: var(--text-muted); max-width: 30rem; }
  .lg-benefits { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.75rem; margin: 1.75rem 0 0; }
  .lg-benefit { min-width: 0; display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.9rem 1rem; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-card); }
  .lg-bic { width: 32px; height: 32px; flex: none; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--login-accent) 12%, var(--bg-card)); color: var(--login-accent); }
  .lg-bic :global(svg) { width: 17px; height: 17px; }
  .lg-benefit b { display: block; font-size: 0.875rem; font-weight: 700; color: var(--text); }
  .lg-benefit small { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.4; }
  .lg-dest { display: flex; align-items: baseline; gap: 0.4rem; margin: 1.5rem 0 0; font-size: 0.9375rem; color: var(--text-muted); }
  .lg-dest b { color: var(--text); font-weight: 700; }
  .lg-dest-ic { color: var(--success-text); font-weight: 800; }

  /* Derecha: acceso */
  .lg-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 20px; padding: 1.75rem; box-shadow: var(--shadow-lg); }
  .lg-card-eyebrow { font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--login-accent); }
  .lg-card-title { margin: 0.4rem 0 0.4rem; font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text); }
  .lg-card-sub { margin: 0 0 1.25rem; font-size: 0.9375rem; color: var(--text-muted); line-height: 1.5; }
  .lg-card label { display: block; font-size: 0.8125rem; font-weight: 650; margin: 0 0 0.4rem; color: var(--text); }
  .lg-card input[type="email"], .lg-card input[type="text"] {
    width: 100%; height: 48px; border: 1.5px solid var(--border-input); border-radius: 12px; padding: 0 0.9rem;
    font: inherit; font-size: 1rem; background: var(--bg-card); color: var(--text); margin-bottom: 0.75rem;
  }
  .lg-card input:focus { outline: none; border-color: var(--login-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--login-accent) 22%, transparent); }
  .lg-submit {
    width: 100%; height: 48px; border: 0; border-radius: 12px; cursor: pointer; font: inherit;
    font-size: 0.9375rem; font-weight: 700; color: #fff; background: var(--login-accent);
  }
  .lg-submit:hover { filter: brightness(0.96); }
  .lg-submit[disabled] { opacity: 0.6; cursor: default; }
