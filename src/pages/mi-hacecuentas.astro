---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  PROFILE_GROUPS, PROFILE_FIELDS, PROVINCES_BY_COUNTRY, CURRENCY_BY_COUNTRY,
} from '../lib/profile/schema';
import { PRODUCTS, PRODUCT_BY_TOOL_SLUG } from '../lib/products/manifest';
import { ICONS } from '../lib/products/dashboard';
import profileUsage from '../lib/profile/usage-auto.json';

const groups = PROFILE_GROUPS.map((g) => ({
  ...g,
  fields: PROFILE_FIELDS.filter((f) => f.group === g.id),
})).filter((g) => g.fields.length > 0);

const usage = profileUsage as Record<string, { slug: string; title: string }[]>;
const totalFields = PROFILE_FIELDS.length;
// Config que consume el script inline (provincias dependientes + moneda por país).
const profileConfig = JSON.stringify({
  provinces: PROVINCES_BY_COUNTRY,
  currency: CURRENCY_BY_COUNTRY,
});

// Config del dashboard logueado. TODO sale del manifest de productos (fuente de
// verdad ya validada contra el catálogo): hitos con su regla de recurrencia,
// claves de perfil por vertical y slugs elegibles para alerta. El cliente
// resuelve la próxima ocurrencia de cada hito ≥ hoy, así nunca mostramos una
// fecha vencida ni horneamos una fecha en el HTML prerenderizado.
const dashConfig = JSON.stringify({
  products: PRODUCTS.map((p) => ({
    slug: p.slug,
    name: p.name,
    icon: p.icon,
    profileKeys: p.profileKeys,
    alertSlugs: p.alertSlugs,
    milestones: p.milestones,
  })),
  productByTool: Object.fromEntries(PRODUCT_BY_TOOL_SLUG),
  productName: Object.fromEntries(PRODUCTS.map((p) => [p.id, p.name])),
  // Claves de los 3 montos del resumen (mismas del perfil, sin duplicar copy).
  metrics: { ingreso: 'trabajo.sueldoNeto', gastos: 'gastos.recurrentesMensual' },
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Mi Hacé Cuentas — tu perfil numérico',
  description:
    'Iniciá sesión para guardar tu perfil numérico y que precargue todas las calculadoras en cualquier dispositivo.',
  url: 'https://hacecuentas.com/mi-hacecuentas',
  inLanguage: 'es-AR',
  isPartOf: { '@id': 'https://hacecuentas.com/#website' },
};

const inputType = (t: string) =>
  t === 'number' ? 'number' : t === 'date' ? 'date' : 'text';
---

<Layout
  noAds={true}
  title="Mi Hacé Cuentas — tu perfil numérico"
  description="Iniciá sesión para guardar tu perfil y que precargue todas las calculadoras en cualquier dispositivo. Login sin contraseña."
  noindex={true}
  schema={schema}
  pageType="hub"
>
  <Fragment slot="header">
    <!-- Barra superior (encima del header, sólo desloguéado) -->
    <div class="lg-topbar" data-login-topbar>
      <div class="lg-tb-in">
        <span class="lg-tb-left"><span class="lg-tb-dot" aria-hidden="true"></span><strong>Acceso seguro</strong><span class="lg-tb-sub"> · Sin contraseña</span></span>
        <span class="lg-tb-right" data-topbar-dest>Después de entrar volvés a tus herramientas</span>
      </div>
    </div>
    <Header />
  </Fragment>

  <div class="profile-page">
    <!-- Estado de carga -->
    <p class="profile-loading" data-auth-loading>Cargando…</p>

    <!-- ───────── No logueado: landing + login (mockup 2026-07-12) ───────── -->
    <div class="lg-landing" data-login-view hidden>
      <div class="lg-wrap">
        <nav class="lg-crumb" aria-label="Ruta de navegación">
          <a href="/">Inicio</a> <span aria-hidden="true">/</span>
          <a href="/mi">Mi Hacé Cuentas</a> <span aria-hidden="true">/</span>
          <span data-crumb-dest>Ingresar</span>
        </nav>

        <div class="lg-grid">
          <!-- IZQUIERDA: propuesta contextual -->
          <div class="lg-copy">
            <span class="lg-eyebrow" data-login-eyebrow><span data-eyebrow-ic aria-hidden="true">✨</span><span data-eyebrow-txt>Tu perfil numérico</span></span>
            <h1 class="lg-title">Guardá los números <span data-title-prefix></span><span class="lg-accent" data-title-word>que repetís.</span></h1>
            <p class="lg-lead" data-login-lead>Ingresá para precargar los datos que repetís, recibir avisos cuando algo cambia y mantener juntas tus herramientas.</p>

            <div class="lg-benefits">
              <div class="lg-benefit"><span class="lg-bic" aria-hidden="true" set:html={ICONS.trendingUp} /><span><b data-benefit1-title>Datos precargados</b><small data-benefit1-desc>No volvés a escribir lo mismo cada vez.</small></span></div>
              <div class="lg-benefit"><span class="lg-bic" aria-hidden="true" set:html={ICONS.bell} /><span><b>Alertas útiles</b><small>Te avisamos cuando cambia el dato que usás.</small></span></div>
              <div class="lg-benefit"><span class="lg-bic" aria-hidden="true" set:html={ICONS.clock} /><span><b>Historial sincronizado</b><small>Continuá desde cualquier dispositivo.</small></span></div>
              <div class="lg-benefit"><span class="lg-bic" aria-hidden="true" set:html={ICONS.shield} /><span><b>Datos bajo tu control</b><small>Editá, exportá o borrá cuando quieras.</small></span></div>
            </div>

            <p class="lg-dest"><span class="lg-dest-ic" aria-hidden="true">✓</span> <b>Destino guardado:</b> después de autenticarte volvés a <b data-dest-name>tus herramientas</b>.</p>
          </div>

          <!-- DERECHA: acceso -->
          <aside class="lg-card">
            <span class="lg-card-eyebrow" data-login-card-eyebrow>Acceso a tu cuenta</span>
            <h2 class="lg-card-title">Entrá o creá tu cuenta</h2>
            <p class="lg-card-sub">Sin contraseña. Usá Google o recibí un código temporal por email.</p>

            <!-- Google Sign-In (se rellena por JS sólo si hay Client ID configurado) -->
            <div class="google-login" data-google-wrap hidden>
              <div class="google-btn-host" data-google-btn></div>
              <p class="login-err" data-google-err hidden></p>
              <div class="lg-divider"><span>o con tu email</span></div>
            </div>

            <form data-email-step>
              <label for="login-email">Tu email</label>
              <input id="login-email" type="email" data-login-email placeholder="tu@email.com" autocomplete="email" required />
              <button type="submit" data-email-submit class="lg-submit">Enviar código →</button>
              <p class="login-err" data-email-err hidden></p>
            </form>

            <form data-code-step hidden>
              <p class="code-sent">Te mandamos un código a <strong data-email-display></strong>.</p>
              <label for="login-code">Código</label>
              <input id="login-code" type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code" data-login-code placeholder="000000" />
              <button type="submit" data-code-submit class="lg-submit">Entrar</button>
              <button type="button" class="link-btn" data-login-back>← Cambiar email</button>
              <p class="login-err" data-code-err hidden></p>
            </form>

            <p class="lg-privacy"><span aria-hidden="true">🔒</span> Usamos tu email para iniciar sesión y sincronizar tu perfil. El parámetro de retorno conserva únicamente una ruta interna segura.</p>

            <label class="lg-nl">
              <input type="checkbox" data-nl />
              <span>Quiero recibir novedades y herramientas útiles por email. <em>Opcional.</em></span>
            </label>
          </aside>
        </div>

        <!-- CUANDO INGRESES -->
        <section class="lg-ready">
          <div class="lg-ready-head">
            <span class="lg-kicker">Cuando ingreses</span>
            <h2 data-ready-title>Tu cuenta queda lista para usar</h2>
            <p>La cuenta no bloquea las calculadoras: sólo agrega precarga, sincronización y alertas.</p>
          </div>
          <div class="lg-ready-grid">
            <div class="lg-ready-card"><span class="lg-ready-ic" aria-hidden="true" set:html={ICONS.wallet} /><b>Perfil compartido</b><small>Tus datos básicos viajan entre las herramientas compatibles.</small></div>
            <div class="lg-ready-card"><span class="lg-ready-ic" aria-hidden="true" set:html={ICONS.calendar} /><b>Próximos hitos</b><small>Las fechas que importan, organizadas por cercanía.</small></div>
            <div class="lg-ready-card"><span class="lg-ready-ic" aria-hidden="true" set:html={ICONS.target} /><b>Decisiones conectadas</b><small>Salas que arrancan con tus datos ya cargados.</small></div>
          </div>
        </section>
      </div>
    </div>

    <!-- ───────── Logueado: dashboard "centro de control" (mockup 2026-07-14) ─────────
         REGLA DURA: no se inventan datos del usuario. Cada número sale de una
         fuente REAL y verificable:
           · montos            → perfil del server (/api/auth/me → HCProfile)
           · "Lo próximo"      → PRODUCTS[].milestones + regla de recurrencia
           · "Alertas activas" → /api/alerts/mine
           · "Continuar…"      → hc_recent + hc-history-<slug> (resultado guardado)
           · % del perfil      → campos cargados / campos totales
         Sin dato ⇒ estado vacío + CTA. Nunca un monto de ejemplo. -->
    <section data-profile-view hidden>
      <div class="hcd" data-hcd>
        <div class="hcd-scrim" data-hcd-scrim hidden></div>

        <!-- ───── Sidebar (drawer en <900px) ───── -->
        <aside class="hcd-side" data-hcd-side aria-label="Tu espacio">
          <div class="hcd-side-top">
            <a class="hcd-brand" href="/">
              <span class="hcd-brand-mark" aria-hidden="true">HC</span>
              <span class="hcd-brand-word">Hacé Cuentas</span>
            </a>
            <button type="button" class="hcd-side-close" data-hcd-close aria-label="Cerrar menú">✕</button>
          </div>

          <nav class="hcd-nav" aria-label="Secciones">
            <span class="hcd-nav-label">Tu espacio</span>
            <a class="hcd-navlink" href="#resumen" data-hcd-link="resumen"><span class="hcd-navic" aria-hidden="true" set:html={ICONS.growth} /><span>Resumen</span></a>
            <a class="hcd-navlink" href="#mis-productos" data-hcd-link="mis-productos"><span class="hcd-navic" aria-hidden="true" set:html={ICONS.box} /><span>Mis productos</span></a>
            <a class="hcd-navlink" href="#mi-perfil" data-hcd-link="mi-perfil"><span class="hcd-navic" aria-hidden="true" set:html={ICONS.doc} /><span>Mi perfil</span><span class="hcd-badge" data-hcd-badge-perfil hidden></span></a>
            <a class="hcd-navlink" href="#actividad" data-hcd-link="actividad"><span class="hcd-navic" aria-hidden="true" set:html={ICONS.clock} /><span>Actividad</span></a>
            <a class="hcd-navlink" href="#alertas" data-hcd-link="alertas"><span class="hcd-navic" aria-hidden="true" set:html={ICONS.bell} /><span>Alertas</span><span class="hcd-badge hcd-badge-num" data-hcd-badge-alertas hidden></span></a>
            <span class="hcd-nav-label">Descubrir</span>
            <a class="hcd-navlink" href="/buscar"><span class="hcd-navic" aria-hidden="true" set:html={ICONS.percent} /><span>Calculadoras</span></a>
            <a class="hcd-navlink" href="/decidir"><span class="hcd-navic" aria-hidden="true" set:html={ICONS.scale} /><span>Salas de decisión</span></a>
          </nav>

          <div class="hcd-sync">
            <b><span class="hcd-sync-dot" aria-hidden="true"></span>Todo sincronizado</b>
            <small>Tus datos están disponibles en todos tus dispositivos.</small>
          </div>

          <div class="hcd-user">
            <button type="button" class="hcd-user-btn" data-hcd-user-btn aria-expanded="false">
              <span class="account-avatar" data-account-avatar aria-hidden="true"></span>
              <span class="hcd-user-txt">
                <b data-hcd-user-name>Tu cuenta</b>
                <small data-hcd-user-email></small>
              </span>
              <span class="hcd-user-chev" aria-hidden="true">⌃</span>
            </button>
            <div class="hcd-user-menu" data-hcd-user-menu hidden>
              <a href="#mi-perfil">Mi perfil</a>
              <a href="/privacidad">Privacidad</a>
              <button type="button" class="link-btn" data-logout>Cerrar sesión</button>
              <button type="button" class="link-btn link-subtle" data-logout-all>Cerrar en todos los dispositivos</button>
            </div>
          </div>
        </aside>

        <!-- ───── Columna de contenido ───── -->
        <div class="hcd-main">
          <div class="hcd-topbar">
            <button type="button" class="hcd-burger" data-hcd-open aria-label="Abrir menú" aria-expanded="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>

            <form class="hcd-search" action="/buscar" method="get" role="search">
              <span class="hcd-search-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
              <input type="search" name="q" data-hcd-search placeholder="Buscar una calculadora…" aria-label="Buscar una calculadora" autocomplete="off" />
              <kbd class="hcd-kbd" aria-hidden="true">⌘K</kbd>
            </form>

            <div class="hcd-tb-actions">
              <button type="button" class="amounts-toggle hcd-amounts" data-amounts-toggle aria-pressed="false">
                <span class="eye-open" aria-hidden="true">👁️</span><span class="eye-off" aria-hidden="true" hidden>🙈</span>
                <span class="hcd-amounts-lbl" data-amounts-toggle-label>Ocultar montos</span>
              </button>
              <a class="hcd-icon-btn hcd-bell" href="#alertas" aria-label="Tus alertas">
                <span class="hcd-bell-ic" aria-hidden="true" set:html={ICONS.bell} />
                <span class="hcd-bell-dot" data-hcd-bell-dot hidden></span>
              </a>
              <button type="button" class="hcd-icon-btn" data-hcd-theme aria-label="Cambiar tema">
                <svg class="hcd-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>
                <svg class="hcd-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
              </button>
            </div>
          </div>

          <div class="hcd-content">
            <!-- 1 · Encabezado -->
            <header class="hcd-head" id="resumen">
              <span class="hcd-eyebrow">Mi Hacé Cuentas</span>
              <h2 data-hcd-hello>Tus números, en orden.</h2>
              <p class="hcd-sub">Un resumen práctico de lo que cambió y de las cuentas que siguen.</p>
            </header>

            <!-- 2 · Stat cards. Los 3 montos salen del PERFIL REAL del usuario;
                 vacío ⇒ CTA de onboarding, nunca un número de ejemplo. -->
            <div class="hcd-stats">
              <article class="hcd-stat" data-hcd-stat="ingreso">
                <div class="hcd-stat-top">
                  <span class="hcd-stat-label">Ingreso mensual</span>
                  <span class="hcd-stat-ic" style="--i:#0ea66e" aria-hidden="true" set:html={ICONS.wallet} />
                </div>
                <strong class="hcd-stat-val hcd-money" data-hcd-val>—</strong>
                <p class="hcd-stat-note"><span data-hcd-note></span><a class="hcd-stat-cta" data-hcd-cta href="#mi-perfil" hidden>Cargá tu sueldo neto →</a></p>
              </article>

              <article class="hcd-stat" data-hcd-stat="gastos">
                <div class="hcd-stat-top">
                  <span class="hcd-stat-label">Gastos fijos</span>
                  <span class="hcd-stat-ic" style="--i:#d97706" aria-hidden="true" set:html={ICONS.receipt} />
                </div>
                <strong class="hcd-stat-val hcd-money" data-hcd-val>—</strong>
                <p class="hcd-stat-note"><span data-hcd-note></span><a class="hcd-stat-cta" data-hcd-cta href="#mi-perfil" hidden>Cargá tus gastos fijos →</a></p>
              </article>

              <article class="hcd-stat" data-hcd-stat="disponible">
                <div class="hcd-stat-top">
                  <span class="hcd-stat-label">Disponible estimado</span>
                  <span class="hcd-stat-ic" style="--i:#2563eb" aria-hidden="true" set:html={ICONS.coins} />
                </div>
                <strong class="hcd-stat-val hcd-money" data-hcd-val>—</strong>
                <p class="hcd-stat-note"><span data-hcd-note></span><a class="hcd-stat-cta" data-hcd-cta href="#mi-perfil" hidden>Completá tu perfil →</a></p>
              </article>

              <!-- 4ª: azul llena. El gauge muestra tu TASA DE AHORRO (aritmética
                   sobre tus dos montos), NO el puntaje compuesto de salud
                   financiera: ese suma liquidez y deudas, y se calcula entero en
                   la sala /decidir/cual-es-mi-salud-financiera. -->
              <article class="hcd-stat hcd-stat-hero" data-hcd-stat="salud">
                <div class="hcd-stat-top">
                  <span class="hcd-stat-label">Salud financiera</span>
                  <span class="hcd-stat-ic" aria-hidden="true" set:html={ICONS.heart} />
                </div>
                <div class="hcd-gauge-row">
                  <span class="hcd-gauge" data-hcd-gauge>
                    <svg viewBox="0 0 72 72" aria-hidden="true">
                      <circle class="hcd-gauge-bg" cx="36" cy="36" r="30" />
                      <circle class="hcd-gauge-fg" cx="36" cy="36" r="30" data-hcd-gauge-fg />
                    </svg>
                    <b data-hcd-gauge-val>—</b>
                  </span>
                  <span class="hcd-gauge-txt">
                    <b data-hcd-gauge-cap>Tasa de ahorro</b>
                    <small data-hcd-gauge-note>Cargá tu ingreso y tus gastos fijos para verla.</small>
                  </span>
                </div>
                <a class="hcd-stat-link" data-hcd-salud-cta href="#mi-perfil">Completar perfil →</a>
              </article>
            </div>

            <!-- 3 · Tus productos -->
            <section class="hcd-sec" id="mis-productos" aria-labelledby="hcd-prods-h">
              <div class="hcd-sec-head">
                <div>
                  <h2 id="hcd-prods-h">Tus productos</h2>
                  <p>Las cuentas que hacés todos los meses, precargadas con tus números.</p>
                </div>
                <a class="hcd-see" href="/mi">Ver todo →</a>
              </div>
              <div class="hcd-prods">
                {PRODUCTS.map((p) => (
                  <article class="hcd-prod" data-hcd-prod={p.slug} style={`--c:${p.accent}`}>
                    <div class="hcd-prod-top">
                      <span class="hcd-prod-ic" aria-hidden="true">{p.icon}</span>
                      <span class="hcd-prod-badge" data-hcd-prod-badge hidden></span>
                    </div>
                    <a class="hcd-prod-name" href={`/mi/${p.slug}`}>{p.name}</a>
                    <span class="hcd-prod-tag">{p.tagline}</span>
                    <div class="hcd-prod-foot">
                      <span class="hcd-prod-next-lbl">Próximo paso</span>
                      <a class="hcd-prod-next" data-hcd-prod-next href={`/mi/${p.slug}`}>Abrir →</a>
                    </div>
                  </article>
                ))}
              </div>
            </section>

            <!-- 4 · Dos columnas -->
            <div class="hcd-cols">
              <!-- Izq: Lo próximo (fechas REALES de PRODUCTS[].milestones) -->
              <section class="hcd-card" aria-labelledby="hcd-next-h">
                <div class="hcd-sec-head">
                  <div><h2 id="hcd-next-h">Lo próximo</h2><p>Fechas que se vienen en tus productos.</p></div>
                  <a class="hcd-see" href="/mi">Ver calendario →</a>
                </div>
                <ul class="hcd-next" data-hcd-next></ul>
              </section>

              <div class="hcd-col-side">
                <!-- Alertas activas (REAL: /api/alerts/mine) -->
                <section class="hcd-card alerts-block" id="alertas" data-alerts-block aria-labelledby="hcd-alerts-h">
                  <div class="hcd-sec-head">
                    <div><h2 id="hcd-alerts-h">Alertas activas</h2><p>Te avisamos por mail cuando una actualización normativa cambia un resultado que guardaste.</p></div>
                  </div>
                  <p class="alerts-empty" data-alerts-empty hidden>Todavía no tenés alertas. Creá una desde cualquier calculadora fiscal, con el botón <strong>“Avisame si una norma cambia este resultado”</strong>.</p>
                  <ul class="alerts-list" data-alerts-list></ul>
                </section>

                <!-- Tu perfil numérico (REAL: campos cargados / totales) -->
                <section class="hcd-card hcd-progress-card" data-progress-wrap aria-labelledby="hcd-prog-h">
                  <div class="hcd-sec-head"><div><h2 id="hcd-prog-h">Tu perfil numérico</h2></div><span class="profile-progress-pct" data-progress-pct></span></div>
                  <div class="profile-progress-track"><div class="profile-progress-fill" data-progress-fill></div></div>
                  <p class="profile-progress-label" data-progress-label></p>
                  <p class="hcd-progress-help">Cuantos más datos cargues, más calculadoras arrancan con tus números ya puestos.</p>
                  <div class="hcd-progress-btns">
                    <a class="hcd-btn hcd-btn-primary" href="#mi-perfil">Completar perfil</a>
                    <a class="hcd-btn" href="/privacidad">Privacidad</a>
                  </div>
                </section>
              </div>
            </div>

            <!-- 5 · Continuar donde dejaste (REAL: hc_recent + hc-history-<slug>) -->
            <section class="hcd-sec" aria-labelledby="hcd-cont-h">
              <div class="hcd-sec-head">
                <div><h2 id="hcd-cont-h">Continuar donde dejaste</h2><p>Las últimas calculadoras que abriste, con el resultado que guardaste.</p></div>
                <a class="hcd-see" href="#actividad">Ver actividad →</a>
              </div>
              <div class="hcd-cont" data-hcd-cont></div>
              <p class="hcd-empty" data-hcd-cont-empty hidden>Todavía no guardaste cálculos. <a href="/buscar">Elegí una calculadora</a> y va a aparecer acá.</p>
            </section>

            <!-- 6 · Mi perfil -->
            <section class="hcd-sec" id="mi-perfil" aria-labelledby="hcd-perfil-h">
              <div class="hcd-sec-head">
                <div>
                  <h2 id="hcd-perfil-h">Mi perfil</h2>
                  <p>Lo cargás una vez y precarga todas las calculadoras, en cualquier dispositivo donde inicies sesión.</p>
                </div>
              </div>
              <div class="hcd-acct">
                <span class="account-info">
                  <strong class="account-email" data-account-email></strong>
                  <span class="account-sub" data-account-sub></span>
                </span>
              </div>

      <form class="profile-form" data-profile-form>
        {groups.map((g) => (
          <div class="profile-group" data-profile-group={g.id}>
            <button type="button" class="group-toggle" data-group-toggle={g.id} aria-expanded="true">
              <span class="group-title"><span aria-hidden="true">{g.icon}</span> {g.label}</span>
              <span class="group-count" data-group-count={g.id}></span>
              <span class="group-chevron" aria-hidden="true">▾</span>
            </button>
            <div class="profile-rows" data-group-body={g.id}>
              {g.emptyHint && (
                <p class="group-empty-hint" data-group-empty={g.id} hidden>{g.emptyHint}</p>
              )}
              {g.fields.map((f) => (
                <div class="profile-row" data-profile-row={f.key}>
                  <label for={`pf-${f.key}`}>
                    {f.label}
                    {f.unit && <span class="profile-unit">({f.unit})</span>}
                  </label>
                  <div class="profile-control">
                    {f.key === 'ubicacion.provincia' ? (
                      <select id={`pf-${f.key}`} data-pk={f.key} data-ptype="provincia">
                        <option value="">Elegí primero el país</option>
                      </select>
                    ) : f.type === 'enum' ? (
                      <select id={`pf-${f.key}`} data-pk={f.key} data-ptype="enum">
                        <option value="">—</option>
                        {f.options?.map((o) => <option value={o.value}>{o.label}</option>)}
                      </select>
                    ) : f.type === 'boolean' ? (
                      <select id={`pf-${f.key}`} data-pk={f.key} data-ptype="boolean">
                        <option value="">—</option>
                        <option value="true">Sí</option>
                        <option value="false">No</option>
                      </select>
                    ) : f.type === 'number' && f.unit === '$' ? (
                      <input
                        id={`pf-${f.key}`}
                        type="text"
                        data-pk={f.key}
                        data-ptype="number"
                        data-money="1"
                        inputmode="numeric"
                        placeholder="—"
                      />
                    ) : (
                      <input
                        id={`pf-${f.key}`}
                        type={inputType(f.type)}
                        data-pk={f.key}
                        data-ptype={f.type}
                        inputmode={f.type === 'number' ? 'decimal' : undefined}
                        placeholder="—"
                      />
                    )}
                    <button type="button" class="profile-del" data-profile-del={f.key} hidden aria-label={`Borrar ${f.label}`}>✕</button>
                  </div>
                  {f.key === 'trabajo.antiguedadAnios' && (
                    <p class="profile-hint" data-antiguedad-hint hidden>Calculada desde tu fecha de ingreso. Podés ajustarla a mano.</p>
                  )}
                  <p class="profile-meta" data-profile-meta={f.key} hidden></p>
                  {usage[f.key] && usage[f.key].length > 0 && (
                    <p class="profile-usage">
                      <span aria-hidden="true">↻</span> Precarga {usage[f.key].length === 1 ? 'la calculadora' : `${usage[f.key].length} calculadoras`}:{' '}
                      {usage[f.key].map((c, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={`/${c.slug}`}>{c.title}</a>
                        </>
                      ))}
                    </p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </form>

              <div class="profile-actions">
                <button type="button" class="profile-clear-all" data-profile-clear-all>Borrar todos mis datos</button>
                <button type="button" class="profile-delete-account" data-delete-account>Borrar mi cuenta</button>
              </div>
            </section>

            <!-- 7 · Actividad — favoritas (hc_favs). Las recientes viven arriba,
                 en "Continuar donde dejaste": el grupo de recientes de este panel
                 se retiró a propósito (renderGroup() lo saltea si no está en el DOM). -->
            <section class="hcd-sec" id="actividad" aria-labelledby="hcd-act-h">
              <div class="hcd-sec-head">
                <div><h2 id="hcd-act-h">Actividad</h2><p>Lo que guardaste y lo que marcaste como favorito.</p></div>
                <a class="hcd-see" href="/buscar">Ver calculadoras →</a>
              </div>
              <section class="panel-calcs" data-panel-calcs hidden>
                <div class="panel-calcs-group" data-favs-group hidden>
                  <h3 class="panel-calcs-h">⭐ Tus favoritas</h3>
                  <div class="panel-calcs-grid" data-favs-grid></div>
                </div>
              </section>
              <p class="hcd-empty" data-hcd-favs-empty hidden>Todavía no marcaste favoritas. Tocá la ⭐ en cualquier calculadora para tenerla acá.</p>
            </section>
          </div><!-- /.hcd-content -->
        </div><!-- /.hcd-main -->
      </div><!-- /.hcd -->
    </section>
  </div>

  <!-- Barra de guardado fija (#2). Visible sólo logueado. -->
  <div class="save-bar" data-save-bar hidden>
    <span class="save-status" data-save-status>Todo guardado</span>
    <button type="button" class="save-btn" data-save-btn disabled>Guardar datos</button>
  </div>

  <script type="application/json" data-profile-config set:html={profileConfig}></script>
  <script type="application/json" data-dash-config set:html={dashConfig}></script>

  <Footer slot="footer" />
</Layout>

<style is:global>
  /* Landing del login (mockup): full-bleed como los hubs. El dashboard logueado
     también es full-bleed (sidebar + contenido ocupan todo el ancho). */
  body[data-page-type='hub'] > main#main {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip;
  }
  /* Recientes + Favoritos del panel (#19). Global porque el markup se puebla
     por DOM API (sin scope hash de Astro). Tokens → hereda tema/dominio. */
  .panel-calcs { display: grid; gap: 1.25rem; margin: 1.75rem 0; }
  .panel-calcs[hidden] { display: none; }
  .panel-calcs-group[hidden] { display: none; }
  .panel-calcs-h { font-size: 1.05rem; margin-bottom: 0.75rem; }
  .panel-calcs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.6rem; }
  .pc-card { position: relative; display: flex; align-items: center; gap: 0.5rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius, 10px); padding: 0.7rem 0.85rem; transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease; }
  .pc-card:hover { transform: translateY(-2px); border-color: var(--accent); box-shadow: var(--shadow-md); }
  .pc-link { color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.9rem; line-height: 1.3; flex: 1; }
  .pc-link:hover { color: var(--accent); }
  .pc-remove { flex-shrink: 0; width: 26px; height: 26px; border-radius: 999px; border: none; background: transparent; color: var(--text-subtle); font-size: 1.15rem; line-height: 1; cursor: pointer; }
  .pc-remove:hover { background: var(--bg-muted); color: var(--danger, #dc2626); }

  /* ═══════════════════════════════════════════════════════════════════
     DASHBOARD LOGUEADO (.hcd-*) — mockup 2026-07-14.
     Global porque casi todo el contenido se puebla por DOM API (sin scope
     hash de Astro). Prefijo `.hcd-` propio de esta página; nada acá existe
     en otra ruta. NO toca calc-flagship.css.
     ═══════════════════════════════════════════════════════════════════ */

  /* En modo dashboard la página usa su propio chrome → el header/footer del
     sitio se esconden. La vista desloguéada NO lleva esta clase: conserva el
     header, el footer y la barra de "Acceso seguro" tal cual. */
  body.hc-dash-mode .site-header,
  body.hc-dash-mode .lg-topbar,
  body.hc-dash-mode .site-footer { display: none !important; }
  body.hc-dash-mode { background: #f4f5f9; }
  :root[data-theme='dark'] body.hc-dash-mode { background: #0b1020; }
  body.hc-drawer-open { overflow: hidden; }

  /* Ocultar montos (#16): vale para todo el dashboard, no sólo el form. */
  body.hc-amounts-hidden .hcd-money { filter: blur(8px); user-select: none; }

  .hcd {
    --hcd-side: #1a1f36;
    --hcd-side-2: #151a2e;
    --hcd-side-tx: #c7d0e0;
    --hcd-side-dim: #79839a;
    --hcd-a: #2563eb;
    --hcd-bg: #f4f5f9;
    --hcd-card: #ffffff;
    --hcd-bd: #e5e8ef;
    --hcd-tx: #0f172a;
    --hcd-mu: #64748b;
    --hcd-su: #94a3b8;
    --hcd-sh: 0 1px 2px rgba(16, 24, 40, 0.05);
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    min-height: 100vh;
    background: var(--hcd-bg);
    color: var(--hcd-tx);
    font-synthesis: none;
  }
  :root[data-theme='dark'] .hcd {
    --hcd-bg: #0b1020;
    --hcd-card: #131a2e;
    --hcd-bd: #262f47;
    --hcd-tx: #e8edf7;
    --hcd-mu: #98a3b8;
    --hcd-su: #6b7688;
    --hcd-sh: 0 1px 2px rgba(0, 0, 0, 0.3);
  }
  .hcd a { text-decoration: none; }

  /* ───────── Sidebar ───────── */
  .hcd-side {
    position: sticky; top: 0; align-self: start;
    height: 100vh; display: flex; flex-direction: column; min-height: 0;
    background: var(--hcd-side); color: var(--hcd-side-tx);
    padding: 1.1rem 0.75rem 0.9rem;
  }
  .hcd-side-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0 0.4rem 0.35rem; }
  .hcd-brand { display: inline-flex; align-items: center; gap: 0.6rem; min-width: 0; }
  .hcd-brand-mark {
    width: 32px; height: 32px; flex: none; border-radius: 9px; background: var(--hcd-a);
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-size: 0.75rem; font-weight: 800; letter-spacing: -0.02em;
  }
  .hcd-brand-word { color: #fff; font-weight: 700; font-size: 0.9375rem; letter-spacing: -0.01em; white-space: nowrap; }
  .hcd-side-close {
    display: none; width: 44px; height: 44px; flex: none; border: 0; border-radius: 9px;
    background: transparent; color: var(--hcd-side-tx); font-size: 1rem; cursor: pointer;
  }
  .hcd-side-close:hover { background: rgba(255, 255, 255, 0.08); }

  .hcd-nav { display: flex; flex-direction: column; gap: 0.1rem; margin-top: 1.1rem; overflow-y: auto; min-height: 0; flex: 1; }
  .hcd-nav-label {
    padding: 0.75rem 0.7rem 0.35rem; font-size: 0.625rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--hcd-side-dim);
  }
  .hcd-navlink {
    position: relative; display: flex; align-items: center; gap: 0.65rem;
    min-height: 44px; padding: 0.55rem 0.7rem; border-radius: 9px;
    color: var(--hcd-side-tx); font-size: 0.875rem; font-weight: 550;
    border-left: 3px solid transparent; transition: background-color 0.14s, color 0.14s;
  }
  .hcd-navlink:hover { background: rgba(255, 255, 255, 0.07); color: #fff; }
  .hcd-navlink.is-active {
    background: color-mix(in srgb, var(--hcd-a) 30%, transparent);
    border-left-color: var(--hcd-a); color: #fff; font-weight: 650;
  }
  .hcd-navic { width: 17px; height: 17px; flex: none; display: inline-flex; opacity: 0.9; }
  .hcd-navic svg { width: 100%; height: 100%; }
  .hcd-navlink > span:nth-child(2) { flex: 1; min-width: 0; }
  .hcd-badge {
    flex: none; padding: 0.1rem 0.4rem; border-radius: 999px; font-size: 0.6875rem; font-weight: 700;
    background: rgba(255, 255, 255, 0.12); color: #e2e8f0;
  }
  .hcd-badge[hidden] { display: none; }
  .hcd-badge-num { background: var(--hcd-a); color: #fff; min-width: 20px; text-align: center; }

  .hcd-sync {
    margin: 0.75rem 0.15rem 0.6rem; padding: 0.75rem 0.8rem; border-radius: 11px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hcd-sync b { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8125rem; font-weight: 650; color: #fff; }
  .hcd-sync small { display: block; margin-top: 0.2rem; font-size: 0.6875rem; line-height: 1.4; color: var(--hcd-side-dim); }
  .hcd-sync-dot { width: 7px; height: 7px; flex: none; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2); }

  .hcd-user { position: relative; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 0.6rem; }
  .hcd-user-btn {
    width: 100%; display: flex; align-items: center; gap: 0.6rem; min-height: 44px;
    padding: 0.4rem 0.5rem; border: 0; border-radius: 10px; background: transparent;
    color: inherit; font: inherit; cursor: pointer; text-align: left;
  }
  .hcd-user-btn:hover { background: rgba(255, 255, 255, 0.07); }
  .hcd-user .account-avatar { width: 32px; height: 32px; flex: none; font-size: 0.875rem; background: var(--hcd-a); }
  .hcd-user-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .hcd-user-txt b { font-size: 0.8125rem; font-weight: 650; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hcd-user-txt small { font-size: 0.6875rem; color: var(--hcd-side-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hcd-user-chev { flex: none; color: var(--hcd-side-dim); font-size: 0.75rem; }
  .hcd-user-menu {
    position: absolute; bottom: calc(100% + 0.35rem); left: 0.25rem; right: 0.25rem; z-index: 5;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.1rem; padding: 0.4rem;
    background: var(--hcd-side-2); border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 11px; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }
  .hcd-user-menu[hidden] { display: none; }
  .hcd-user-menu a, .hcd-user-menu .link-btn {
    display: block; width: 100%; text-align: left; padding: 0.55rem 0.55rem; border-radius: 7px;
    font-size: 0.8125rem; color: var(--hcd-side-tx) !important; text-decoration: none;
    background: none; border: 0; cursor: pointer; font: inherit;
  }
  .hcd-user-menu a:hover, .hcd-user-menu .link-btn:hover { background: rgba(255, 255, 255, 0.08); color: #fff !important; }
  .hcd-user-menu .link-subtle { color: var(--hcd-side-dim) !important; font-size: 0.75rem !important; }

  /* ───────── Topbar ───────── */
  .hcd-main { min-width: 0; display: flex; flex-direction: column; }
  .hcd-topbar {
    position: sticky; top: 0; z-index: 30;
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.7rem 1.5rem; border-bottom: 1px solid var(--hcd-bd);
    background: color-mix(in srgb, var(--hcd-bg) 90%, transparent);
    backdrop-filter: blur(10px);
  }
  .hcd-burger {
    display: none; width: 44px; height: 44px; flex: none; align-items: center; justify-content: center;
    border: 1px solid var(--hcd-bd); border-radius: 10px; background: var(--hcd-card);
    color: var(--hcd-tx); cursor: pointer;
  }
  .hcd-burger svg { width: 20px; height: 20px; }
  .hcd-search { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; }
  .hcd-search-ic { position: absolute; left: 0.75rem; width: 17px; height: 17px; color: var(--hcd-su); pointer-events: none; }
  .hcd-search-ic svg { width: 100%; height: 100%; }
  .hcd-search input {
    width: 100%; height: 42px; padding: 0 3.2rem 0 2.4rem;
    border: 1px solid var(--hcd-bd); border-radius: 10px;
    background: var(--hcd-card); color: var(--hcd-tx); font: inherit; font-size: 0.875rem;
  }
  .hcd-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .hcd-search input:focus { outline: none; border-color: var(--hcd-a); box-shadow: 0 0 0 3px color-mix(in srgb, var(--hcd-a) 18%, transparent); }
  .hcd-kbd {
    position: absolute; right: 0.6rem; padding: 0.1rem 0.35rem; border-radius: 5px;
    border: 1px solid var(--hcd-bd); background: var(--hcd-bg);
    font-family: inherit; font-size: 0.6875rem; color: var(--hcd-su); pointer-events: none;
  }
  .hcd-tb-actions { display: flex; align-items: center; gap: 0.4rem; flex: none; }
  .hcd .amounts-toggle.hcd-amounts {
    min-height: 42px; gap: 0.4rem; padding: 0 0.75rem; border: 1px solid var(--hcd-bd);
    border-radius: 10px; background: var(--hcd-card); color: var(--hcd-mu); font-size: 0.8125rem;
  }
  .hcd .amounts-toggle.hcd-amounts:hover { border-color: var(--hcd-a); color: var(--hcd-a); }
  .hcd-icon-btn {
    position: relative; width: 42px; height: 42px; flex: none;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--hcd-bd); border-radius: 10px; background: var(--hcd-card);
    color: var(--hcd-mu); cursor: pointer;
  }
  .hcd-icon-btn:hover { border-color: var(--hcd-a); color: var(--hcd-a); }
  .hcd-icon-btn svg, .hcd-bell-ic { width: 18px; height: 18px; }
  .hcd-bell-ic svg { width: 100%; height: 100%; }
  .hcd-bell-dot {
    position: absolute; top: 8px; right: 9px; width: 8px; height: 8px; border-radius: 50%;
    background: #ef4444; border: 2px solid var(--hcd-card);
  }
  .hcd-bell-dot[hidden] { display: none; }
  .hcd-moon { display: none; }
  :root[data-theme='dark'] .hcd-sun { display: none; }
  :root[data-theme='dark'] .hcd-moon { display: block; }

  /* ───────── Contenido ───────── */
  .hcd-content { padding: 1.75rem 1.5rem 4rem; display: flex; flex-direction: column; gap: 1.75rem; min-width: 0; }
  .hcd-content > * { min-width: 0; }
  .hcd-head { scroll-margin-top: 72px; }
  .hcd-eyebrow { font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--hcd-a); }
  .hcd-head h2 { margin: 0.45rem 0 0; font-size: clamp(1.5rem, 3.2vw, 2rem); font-weight: 800; letter-spacing: -0.03em; color: var(--hcd-tx); line-height: 1.15; }
  .hcd-sub { margin: 0.4rem 0 0; font-size: 0.9375rem; color: var(--hcd-mu); line-height: 1.55; max-width: 60ch; }

  .hcd-sec { scroll-margin-top: 72px; }
  .hcd-sec-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .hcd-sec-head h2 { margin: 0; font-size: 1.125rem; font-weight: 700; letter-spacing: -0.015em; color: var(--hcd-tx); }
  .hcd-sec-head p { margin: 0.2rem 0 0; font-size: 0.8438rem; color: var(--hcd-mu); line-height: 1.5; }
  .hcd-see { flex: none; font-size: 0.8125rem; font-weight: 650; color: var(--hcd-a); white-space: nowrap; }
  .hcd-see:hover { text-decoration: underline; }
  .hcd-card { background: var(--hcd-card); border: 1px solid var(--hcd-bd); border-radius: 14px; padding: 1.25rem; box-shadow: var(--hcd-sh); scroll-margin-top: 72px; }
  .hcd-empty { margin: 0; font-size: 0.875rem; color: var(--hcd-mu); line-height: 1.55; }
  .hcd-empty[hidden] { display: none; }
  .hcd-empty a { color: var(--hcd-a); font-weight: 600; }

  /* ───────── Stat cards ───────── */
  .hcd-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .hcd-stat {
    display: flex; flex-direction: column; min-width: 0;
    background: var(--hcd-card); border: 1px solid var(--hcd-bd); border-radius: 14px;
    padding: 1.1rem 1.2rem; box-shadow: var(--hcd-sh);
  }
  .hcd-stat-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.6rem; }
  .hcd-stat-label { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--hcd-su); }
  .hcd-stat-ic {
    width: 30px; height: 30px; flex: none; border-radius: 8px;
    display: inline-flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--i, #2563eb) 13%, transparent); color: var(--i, #2563eb);
  }
  .hcd-stat-ic svg { width: 16px; height: 16px; }
  .hcd-stat-val {
    display: block; margin: 0.6rem 0 0.3rem; font-family: var(--font-num, inherit);
    font-size: 1.6rem; font-weight: 700; letter-spacing: -0.025em; color: var(--hcd-su);
    overflow-wrap: anywhere;
  }
  .hcd-stat-val.is-set { color: var(--hcd-tx); }
  .hcd-stat.is-neg .hcd-stat-val.is-set { color: #dc2626; }
  .hcd-stat-note { margin: 0; font-size: 0.75rem; color: var(--hcd-mu); line-height: 1.45; }
  .hcd-stat-note > span[hidden] { display: none; }
  .hcd-stat-cta { font-size: 0.75rem; font-weight: 650; color: var(--hcd-a); }
  .hcd-stat-cta:hover { text-decoration: underline; }
  .hcd-stat-cta[hidden] { display: none; }

  /* 4ª card: azul llena + gauge */
  .hcd-stat-hero { background: linear-gradient(150deg, #2563eb 0%, #1e40af 100%); border-color: transparent; color: #fff; }
  .hcd-stat-hero .hcd-stat-label { color: rgba(255, 255, 255, 0.72); }
  .hcd-stat-hero .hcd-stat-ic { background: rgba(255, 255, 255, 0.16); color: #fff; }
  .hcd-gauge-row { display: flex; align-items: center; gap: 0.8rem; margin: 0.75rem 0 0.6rem; }
  .hcd-gauge { position: relative; width: 62px; height: 62px; flex: none; display: inline-flex; align-items: center; justify-content: center; }
  .hcd-gauge svg { width: 62px; height: 62px; transform: rotate(-90deg); }
  .hcd-gauge-bg { fill: none; stroke: rgba(255, 255, 255, 0.2); stroke-width: 6; }
  .hcd-gauge-fg { fill: none; stroke: #fff; stroke-width: 6; stroke-linecap: round; transition: stroke-dashoffset 0.6s ease; }
