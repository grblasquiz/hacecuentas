<!-- ═══════════ Dashboard logueado (mockup 2026-07-14) ═══════════
     Render 100% cliente sobre datos REALES. Cada bloque declara su fuente.
     Si un dato no existe ⇒ estado vacío + CTA. Nunca un valor de ejemplo. -->
<script is:inline>
  (function () {
    var cfgEl = document.querySelector('[data-dash-config]');
    var root = document.querySelector('[data-hcd]');
    if (!cfgEl || !root) return;
    var CFG; try { CFG = JSON.parse(cfgEl.textContent || '{}'); } catch (e) { return; }

    var MON = ['ENE','FEB','MAR','ABR','MAY','JUN','JUL','AGO','SEP','OCT','NOV','DIC'];
    var qs = function (s) { return root.querySelector(s); };
    var qsa = function (s) { return Array.prototype.slice.call(root.querySelectorAll(s)); };
    var alertsCache = [];

    // ── utils ───────────────────────────────────────────────
    function num(v) {
      if (typeof v === 'number') return isFinite(v) ? v : NaN;
      var s = String(v == null ? '' : v).trim();
      if (!s) return NaN;
      var n = Number(s);
      if (isFinite(n)) return n;
      n = Number(s.replace(/\./g, '').replace(',', '.')); // fallback es-AR
      return isFinite(n) ? n : NaN;
    }
    function money(n) { return '$ ' + Math.round(n).toLocaleString('es-AR'); }
    function pget(key) { try { return window.HCProfile ? window.HCProfile.get(key) : undefined; } catch (e) { return undefined; } }
    function pnum(key) { var v = pget(key); return (v === undefined || v === null || v === '') ? NaN : num(v); }
    function has(key) { var v = pget(key); return v !== undefined && v !== null && v !== ''; }
    function txt(el, s) { if (el) el.textContent = s; }

    // ── 1 · Saludo + pie del sidebar (fuente: email de la sesión) ──
    function nameFromEmail(email) {
      var local = String(email || '').split('@')[0] || '';
      var first = local.split(/[._+\-0-9]+/).filter(Boolean)[0] || '';
      if (first.replace(/[^a-záéíóúñü]/gi, '').length < 2) return ''; // basura ⇒ sin nombre
      return first.charAt(0).toUpperCase() + first.slice(1);
    }
    function maskEmail(email) {
      var p = String(email || '').split('@');
      if (p.length !== 2) return String(email || '');
      var l = p[0];
      var keep = l.length <= 2 ? l.charAt(0) : l.slice(0, 2);
      return keep + '•••@' + p[1];
    }
    function renderMe(email) {
      var n = nameFromEmail(email);
      txt(qs('[data-hcd-hello]'), n ? 'Hola, ' + n + '. Tus números, en orden.' : 'Tus números, en orden.');
      txt(qs('[data-hcd-user-name]'), n || 'Tu cuenta');
      txt(qs('[data-hcd-user-email]'), maskEmail(email));
    }

    // ── 2 · Stat cards (fuente: perfil real del server) ──────
    function fillStat(id, value, note, ctaWhenEmpty) {
      var card = qs('[data-hcd-stat="' + id + '"]'); if (!card) return;
      var val = card.querySelector('[data-hcd-val]');
      var noteEl = card.querySelector('[data-hcd-note]');
      var cta = card.querySelector('[data-hcd-cta]');
      var ok = value !== null;
      if (val) { val.textContent = ok ? value : '—'; val.classList.toggle('is-set', ok); }
      if (noteEl) { noteEl.textContent = ok ? note : ''; noteEl.hidden = !ok; }
      if (cta) cta.hidden = ok;
      card.classList.toggle('is-empty', !ok);
    }
    function renderStats() {
      var ing = pnum(CFG.metrics.ingreso);
      var gas = pnum(CFG.metrics.gastos);
      var hasIng = isFinite(ing), hasGas = isFinite(gas);

      fillStat('ingreso', hasIng ? money(ing) : null, 'Sueldo neto, de tu perfil');
      fillStat('gastos', hasGas ? money(gas) : null, 'Gastos fijos, de tu perfil');

      var both = hasIng && hasGas;
      var disp = both ? ing - gas : NaN;
      fillStat('disponible', both ? money(disp) : null, 'Ingreso neto − gastos fijos');
      var dispCard = qs('[data-hcd-stat="disponible"]');
      if (dispCard) dispCard.classList.toggle('is-neg', both && disp < 0);

      // Gauge: TASA DE AHORRO real = (ingreso − gastos) / ingreso. No es el
      // puntaje compuesto de salud financiera (ese pondera liquidez y deudas y
      // se calcula entero en la sala) → lo etiquetamos por su nombre exacto.
      var gEl = qs('[data-hcd-gauge]');
      var fg = qs('[data-hcd-gauge-fg]');
      var C = 2 * Math.PI * 30;
      var okG = both && ing > 0;
      var tasa = okG ? ((ing - gas) / ing) * 100 : 0;
      var shown = Math.max(0, Math.min(100, tasa));
      txt(qs('[data-hcd-gauge-val]'), okG ? Math.round(tasa) + '%' : '—');
      txt(qs('[data-hcd-gauge-cap]'), okG ? 'Tasa de ahorro' : 'Sin datos suficientes');
      txt(qs('[data-hcd-gauge-note]'), okG
        ? 'Lo que te queda del ingreso después de tus gastos fijos. El puntaje completo suma además liquidez y deudas.'
        : 'Cargá tu ingreso y tus gastos fijos para verla.');
      if (gEl) gEl.classList.toggle('is-empty', !okG);
      if (fg) { fg.style.strokeDasharray = C.toFixed(1); fg.style.strokeDashoffset = (C * (1 - shown / 100)).toFixed(1); }
      var sc = qs('[data-hcd-salud-cta]');
      if (sc) {
        sc.textContent = okG ? 'Ver diagnóstico →' : 'Completar perfil →';
        sc.href = okG ? '/decidir/cual-es-mi-salud-financiera' : '#mi-perfil';
      }
    }

    // ── 3 · Hitos (fuente: PRODUCTS[].milestones, próxima ocurrencia ≥ hoy) ──
    function stripTime(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
    function nextOccurrence(rule, now) {
      var y = now.getFullYear(), t = stripTime(now);
      function mk(yy, mm, dd) { return new Date(yy, mm, dd); }
      function lastDay(yy, mm) { return new Date(yy, mm + 1, 0); }
      if (rule.type === 'monthly-last') {
        var a = lastDay(y, now.getMonth());
        return a < t ? lastDay(y, now.getMonth() + 1) : a;
      }
      if (rule.type === 'monthly-day') {
        var b = mk(y, now.getMonth(), rule.day);
        return b < t ? mk(y, now.getMonth() + 1, rule.day) : b;
      }
      if (rule.type === 'yearly') {
        var c = mk(y, rule.month - 1, rule.day);
        return c < t ? mk(y + 1, rule.month - 1, rule.day) : c;
      }
      if (rule.type === 'biyearly') {
        var cands = [mk(y, rule.month1 - 1, rule.day), mk(y, rule.month2 - 1, rule.day), mk(y + 1, rule.month1 - 1, rule.day)];
        for (var i = 0; i < cands.length; i++) if (cands[i] >= t) return cands[i];
        return cands[cands.length - 1];
      }
      return now;
    }
    function allMilestones() {
      var now = new Date(), out = [];
      (CFG.products || []).forEach(function (p) {
        (p.milestones || []).forEach(function (m) {
          var d = nextOccurrence(m.rule, now);
          out.push({ p: p, m: m, d: d, days: Math.round((stripTime(d) - stripTime(now)) / 86400000) });
        });
      });
      return out.sort(function (a, b) { return a.d - b.d; });
    }
    function countdown(days) { return days === 0 ? 'Es hoy.' : days === 1 ? 'Falta 1 día.' : 'Faltan ' + days + ' días.'; }
    function renderNext(items) {
      var ul = qs('[data-hcd-next]'); if (!ul) return;
      ul.innerHTML = '';
      items.slice(0, 4).forEach(function (it) {
        var li = document.createElement('li');
        li.className = 'hcd-next-item';
        var date = document.createElement('span');
        date.className = 'hcd-next-date';
        date.innerHTML = '<b>' + String(it.d.getDate()).padStart(2, '0') + '</b><small>' + MON[it.d.getMonth()] + '</small>';
        var ic = document.createElement('span');
        ic.className = 'hcd-next-ic'; ic.setAttribute('aria-hidden', 'true'); ic.textContent = it.m.emoji;
        var body = document.createElement('span');
        body.className = 'hcd-next-body';
        var b = document.createElement('b'); b.textContent = it.m.label;
        var small = document.createElement('small'); small.textContent = countdown(it.days) + ' ' + it.m.detail;
        body.appendChild(b); body.appendChild(small);
        li.appendChild(date); li.appendChild(ic); li.appendChild(body);
        if (it.m.toolSlug) {
          var a = document.createElement('a');
          a.className = 'hcd-next-cta'; a.href = '/' + it.m.toolSlug; a.textContent = 'Calcular →';
          li.appendChild(a);
        }
        ul.appendChild(li);
      });
    }

    // ── 4 · Productos: badge + próximo paso (perfil + alertas + hitos reales) ──
    function renderProds(items) {
      (CFG.products || []).forEach(function (p) {
        var card = qs('[data-hcd-prod="' + p.slug + '"]'); if (!card) return;

        var mine = alertsCache.filter(function (a) { return (p.alertSlugs || []).indexOf(a.slug) !== -1; }).length;
        var keys = p.profileKeys || [];
        var filled = keys.filter(has).length;
        var badge = card.querySelector('[data-hcd-prod-badge]');
        if (badge) {
          var label = '', kind = '';
          if (mine > 0) { label = mine + (mine === 1 ? ' alerta' : ' alertas'); kind = 'alert'; }
          else if (!keys.length) { label = ''; }
          else if (filled === 0) { label = 'Sin datos'; kind = 'empty'; }
          else if (filled === keys.length) { label = 'Completo'; kind = 'ok'; }
          else { label = filled + '/' + keys.length + ' datos'; kind = 'part'; }
          badge.textContent = label;
          badge.hidden = !label;
          badge.className = 'hcd-prod-badge' + (kind ? ' is-' + kind : '');
        }

        var next = items.filter(function (it) { return it.p.slug === p.slug; })[0];
        var na = card.querySelector('[data-hcd-prod-next]');
        if (na) {
          if (next) {
            na.textContent = next.m.label + ' · ' + next.d.getDate() + ' ' + MON[next.d.getMonth()].toLowerCase() + ' →';
            na.href = next.m.toolSlug ? '/' + next.m.toolSlug : '/mi/' + p.slug;
          } else {
            na.textContent = 'Abrir ' + p.name + ' →';
            na.href = '/mi/' + p.slug;
          }
        }
      });
    }

    // ── 5 · Continuar donde dejaste (hc_recent + hc-history-<slug>) ──
    function readLS(key) {
      try { var a = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(a) ? a : []; } catch (e) { return []; }
    }
    function validRecent(f) { return f && typeof f.s === 'string' && /^[a-z0-9][a-z0-9/-]*$/i.test(f.s); }
    function relTime(iso) {
      var t = Date.parse(iso); if (!isFinite(t)) return '';
      var s = Math.floor((Date.now() - t) / 1000);
      if (s < 60) return 'recién';
      var m = Math.floor(s / 60); if (m < 60) return 'hace ' + m + ' min';
      var h = Math.floor(m / 60); if (h < 24) return 'hace ' + h + ' h';
      var d = Math.floor(h / 24); if (d < 30) return 'hace ' + d + (d === 1 ? ' día' : ' días');
      var mo = Math.floor(d / 30); return 'hace ' + mo + (mo === 1 ? ' mes' : ' meses');
    }
    function lastResult(slug) {
      var h = readLS('hc-history-' + slug);
      if (!h.length) return null;
      var e = h.slice().sort(function (a, b) { return (b.ts || 0) - (a.ts || 0); })[0];
      return (e && e.primary) ? { primary: String(e.primary), label: String(e.label || 'Tu resultado') } : null;
    }
    function renderCont() {
      var wrap = qs('[data-hcd-cont]'); var empty = qs('[data-hcd-cont-empty]');
      if (!wrap) return;
      wrap.innerHTML = '';
      var list = readLS('hc_recent').filter(validRecent).slice().reverse().slice(0, 3);
      if (!list.length) { wrap.hidden = true; if (empty) empty.hidden = false; return; }
      wrap.hidden = false; if (empty) empty.hidden = true;
      list.forEach(function (f) {
        var pid = (CFG.productByTool || {})[f.s];
        var pname = pid ? (CFG.productName || {})[pid] : null;
        var href = (f.l ? '/' + f.l : '') + '/' + f.s;
        var card = document.createElement('article');
        card.className = 'hcd-cont-card';

        var top = document.createElement('div');
        top.className = 'hcd-cont-top';
        var eye = document.createElement('span');
        eye.className = 'hcd-cont-eyebrow'; eye.textContent = pname || 'Calculadora';
        var when = document.createElement('span');
        when.className = 'hcd-cont-when'; when.textContent = relTime(f.d);
        top.appendChild(eye); top.appendChild(when);

        var h3 = document.createElement('h3');
        h3.className = 'hcd-cont-title';
        h3.textContent = (typeof f.t === 'string' && f.t) ? f.t : f.s.replace(/-/g, ' ');

        card.appendChild(top); card.appendChild(h3);

        var res = lastResult(f.s);
        if (res) {
          var row = document.createElement('div');
          row.className = 'hcd-cont-row';
          var rl = document.createElement('span'); rl.className = 'hcd-cont-row-lbl'; rl.textContent = res.label;
          var rv = document.createElement('b'); rv.className = 'hcd-cont-row-val hcd-money'; rv.textContent = res.primary;
          row.appendChild(rl); row.appendChild(rv);
          card.appendChild(row);
        } else {
          var no = document.createElement('p');
          no.className = 'hcd-cont-norow'; no.textContent = 'Todavía no guardaste un resultado acá.';
          card.appendChild(no);
        }

        var a = document.createElement('a');
        a.className = 'hcd-cont-cta'; a.href = href;
        a.textContent = res ? 'Abrir y actualizar →' : 'Abrir →';
        card.appendChild(a);
        wrap.appendChild(card);
      });
    }
    function renderFavsEmpty() {
      var e = qs('[data-hcd-favs-empty]');
      if (e) e.hidden = readLS('hc_favs').length > 0;
    }

    // ── 6 · Badges del sidebar / campana ────────────────────
    function renderAlertsBits() {
      var n = alertsCache.length;
      var b = qs('[data-hcd-badge-alertas]');
      if (b) { b.textContent = String(n); b.hidden = n === 0; }
      var dot = qs('[data-hcd-bell-dot]');
      if (dot) dot.hidden = n === 0;
    }

    // ── Drawer (mobile) ─────────────────────────────────────
    var side = qs('[data-hcd-side]'), scrim = qs('[data-hcd-scrim]'), burger = qs('[data-hcd-open]');
    function setDrawer(open) {
      if (!side) return;
      side.classList.toggle('is-open', open);
      if (scrim) scrim.hidden = !open;
      if (burger) burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.classList.toggle('hc-drawer-open', open);
      if (open) { var f = side.querySelector('[data-hcd-close]'); if (f) f.focus(); }
    }
    if (burger) burger.addEventListener('click', function () { setDrawer(!side.classList.contains('is-open')); });
    var closeBtn = qs('[data-hcd-close]'); if (closeBtn) closeBtn.addEventListener('click', function () { setDrawer(false); if (burger) burger.focus(); });
    if (scrim) scrim.addEventListener('click', function () { setDrawer(false); });
    qsa('.hcd-nav a').forEach(function (a) { a.addEventListener('click', function () { setDrawer(false); }); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && side && side.classList.contains('is-open')) { setDrawer(false); if (burger) burger.focus(); }
    });

    // ── Menú de usuario ─────────────────────────────────────
    var ub = qs('[data-hcd-user-btn]'), um = qs('[data-hcd-user-menu]');
    if (ub && um) {
      ub.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = um.hidden;
        um.hidden = !open;
        ub.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('click', function (e) {
        if (!um.hidden && !um.contains(e.target) && !ub.contains(e.target)) { um.hidden = true; ub.setAttribute('aria-expanded', 'false'); }
      });
    }

    // ── Tema (misma política que Layout/Header: clave 'hc-theme') ──
    var tb = qs('[data-hcd-theme]');
    if (tb) tb.addEventListener('click', function () {
      var cur = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      var next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('hc-theme', next); } catch (e) {}
    });

    // ── ⌘K / Ctrl+K → foco en el buscador ───────────────────
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
        var input = qs('[data-hcd-search]');
        if (input && !document.querySelector('[data-profile-view]').hidden) { e.preventDefault(); input.focus(); input.select(); }
      }
    });

    // ── Scroll-spy del sidebar ──────────────────────────────
    // Por posición, no por intersectionRatio: las secciones tienen alturas muy
    // dispares (#resumen ~100px vs #mi-perfil ~2000px) y una sección más alta
    // que el viewport nunca llega a un ratio alto → la chiquita ganaba siempre.
    // Regla: gana la última sección cuyo tope ya pasó la línea de la topbar.
    function initSpy() {
      // En ORDEN DE DOCUMENTO (#alertas vive en la columna derecha, antes de
      // #mi-perfil): el desempate del fondo depende de este orden.
      var ids = ['resumen', 'mis-productos', 'alertas', 'mi-perfil', 'actividad'];
      var secs = ids.map(function (id) { return document.getElementById(id); }).filter(Boolean);
      if (!secs.length) return;
      var links = {};
      qsa('[data-hcd-link]').forEach(function (a) { links[a.getAttribute('data-hcd-link')] = a; });
      var ticking = false;
      function update() {
        ticking = false;
        var line = 100, best = null, bestTop = -Infinity, firstId = null, firstTop = Infinity;
        secs.forEach(function (el) {
          var top = el.getBoundingClientRect().top;
          if (top < firstTop) { firstTop = top; firstId = el.id; }
          if (top <= line && top > bestTop) { bestTop = top; best = el.id; }
        });
        best = best || firstId;
        // Última sección: nunca llega a cruzar la línea porque no queda página
        // para scrollear debajo. Si tocamos el fondo, gana la última visible.
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
          var lastVisible = null;
          secs.forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) lastVisible = el.id;
          });
          if (lastVisible) best = lastVisible;
        }
        ids.forEach(function (id) { if (links[id]) links[id].classList.toggle('is-active', id === best); });
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }

    // ── Orquestación ────────────────────────────────────────
    var pending = false;
    function renderProfileBits() {
      var items = allMilestones();
      renderStats();
      renderNext(items);
      renderProds(items);
    }
    function schedule() {
      if (pending) return; pending = true;
      requestAnimationFrame(function () { pending = false; renderProfileBits(); });
    }

    window.addEventListener('hc-dash-me', function (e) {
      renderMe((e.detail && e.detail.email) || '');
      renderProfileBits();
      renderCont();
      renderFavsEmpty();
    });
    window.addEventListener('hc-profile-change', schedule);
    window.addEventListener('hc-dash-progress', function (e) {
      var b = qs('[data-hcd-badge-perfil]');
      var pct = (e.detail && e.detail.pct) || 0;
      if (b) { b.textContent = pct + '%'; b.hidden = false; }
    });
    window.addEventListener('hc-dash-alerts', function (e) {
      alertsCache = (e.detail && e.detail.alerts) || [];
      renderAlertsBits();
      renderProds(allMilestones());
    });

    // Primer pintado (hitos y recientes no dependen de la sesión).
    renderProfileBits();
    renderCont();
    renderFavsEmpty();
    initSpy();
  })();
</script>

<style>
  .profile-page { }
  .profile-loading { color: var(--text-subtle); text-align: center; padding: 4rem 1rem; }

  /* ═══════════ Landing del login (mockup 2026-07-12, contextual) ═══════════
     Theme-aware (tokens del sitio) + --login-accent por producto (via ?next). */
  .lg-landing {
    --login-accent: var(--accent);
    background:
      radial-gradient(90% 60% at 82% 0%, color-mix(in srgb, var(--login-accent) 12%, transparent), transparent 60%),
      var(--bg);
  }
  .lg-landing a { text-decoration: none; }
  .lg-wrap { max-width: 1200px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
