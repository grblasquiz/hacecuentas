---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import CostoConstruirPeruExperience from '../../../components/generated/CostoConstruirPeruExperience.astro';
import { hub } from '../../../lib/hubs/pe/costo-de-construir';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="PE" lang="es" ogType="article" articleSection={hub.silo}>
  <Header /><CostoConstruirPeruExperience data={hub} /><HubSeoAnswer data={hub} />
  <Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/pe-costo-de-construir';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"costo-construccion-m2-peru","fields":["metros","calidad"],"outputs":[{"id":"costoTotal","label":"Costo total estimado de la obra","primary":true},{"id":"costoPorM2","label":"Costo por m²"},{"id":"desglose","label":"Materiales vs mano de obra"},{"id":"detalle","label":"Detalle del cálculo"}],"title":"Calculadora de Costo de Construcción por m² 2026"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'es', format: 'ars' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
