---
/**
 * Hub de decisión PE — "El día que no trabajo: vacaciones, feriado, falta o descanso médico".
 * audience="PE" literal: HubData sólo modela 'AR' | 'global' y el mercado viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DiasNoTrabajoPeruExperience from '../../../components/generated/DiasNoTrabajoPeruExperience.astro';
import {
  hub,
  DIAS_VACACIONES,
  DIAS_A_CARGO_EMPLEADOR,
  TOPE_DIAS_SUBSIDIO,
  FERIADOS,
  TOTAL_FERIADOS,
} from '../../../lib/hubs/pe/dias-que-no-trabajo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="PE"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DiasNoTrabajoPeruExperience data={hub} />
  <Footer />
</Layout>

