---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';
const href='/pe/estudio';
const hubs=hubsOfSilo(href);
---
<Layout title="Estudiar en Perú: costos, notas y calculadoras | Hacé Cuentas" description="¿Cuánto cuesta estudiar y qué nota necesito?" canonical={`https://hacecuentas.com${href}`} audience="PE" lang="es">
  <Header /><SiloIndex silo="Estudiar en Perú" href={href} lede="¿Cuánto cuesta estudiar y qué nota necesito?" hubs={hubs} /><Footer />
</Layout>
