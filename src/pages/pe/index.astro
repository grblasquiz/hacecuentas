---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
import { PERU_2026, fmtPEN } from '../../lib/data/peru-2026';
import peLive from '../../data/live/peru.json';

const localeModules = import.meta.glob<any>('../../content/calcs-pe/*.json', { eager: true });
const mainModules = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
const localeCalcs = Object.values(localeModules).map((m: any) => m.default || m);
const audienceFiltered = Object.values(mainModules)
  .map((m: any) => m.default || m)
  .filter((c: any) => c.audience === 'PE');
const calcs = [...localeCalcs, ...audienceFiltered];

const localeSlugs = new Set(localeCalcs.map((c: any) => c.slug));
function calcUrl(c: any): string {
  return localeSlugs.has(c.slug) ? `/pe/${c.slug}` : `/${c.slug}`;
}

const byCategory: Record<string, any[]> = {};
calcs.forEach((c) => {
  if (!byCategory[c.category]) byCategory[c.category] = [];
  byCategory[c.category].push(c);
});

const categoryMeta: Record<string, { label: string; desc: string; color: string; icon: string }> = {
  finanzas:        { label: 'Finanzas',       desc: 'Sueldo neto, CTS, gratificación, AFP vs ONP.',                color: '#2563eb', icon: '💰' },
  impuestos:       { label: 'Impuestos',      desc: 'Renta 5ta SUNAT 2026, IGV 18%, RUS, detracciones.',                color: '#7c3aed', icon: '🧾' },
  salud:           { label: 'Salud',          desc: 'IMC, calorías, embarazo, fitness.',                  color: '#16a34a', icon: '❤️' },
  familia:         { label: 'Familia',        desc: 'Licencia maternidad, hijos, escolarización.',                  color: '#db2777', icon: '👨‍👩‍👧' },
  vida:            { label: 'Vida cotidiana', desc: 'Arriendo, costo de vida, mercado.',                     color: '#d97706', icon: '🏠' },
  automotor:       { label: 'Automotor',      desc: 'SOAT, impuesto vehicular, combustible.',                color: '#6366f1', icon: '🚗' },
  educacion:       { label: 'Educación',      desc: 'Becas, créditos universitarios, promedios.',                color: '#8b5cf6', icon: '🎓' },
  negocios:        { label: 'Negocios',       desc: 'Márgenes, IVA, modelos fiscales.',                   color: '#0891b2', icon: '📊' },
  marketing:       { label: 'Marketing',      desc: 'CTR, CPC, ROAS, CAC, LTV.',                          color: '#e11d48', icon: '📈' },
  deportes:        { label: 'Deportes',       desc: 'Pace, 1RM, VO2 max, ciclismo.',                      color: '#65a30d', icon: '🏃' },
  viajes:          { label: 'Viajes',         desc: 'Combustible, presupuesto, propinas.',                color: '#0891b2', icon: '✈️' },
  cocina:          { label: 'Cocina',         desc: 'Tazas a gramos, ajustar receta.',                    color: '#ea580c', icon: '🍳' },
  mascotas:        { label: 'Mascotas',       desc: 'Edad perro/gato, alimentación.',                     color: '#db2777', icon: '🐕' },
  matematica:      { label: 'Matemática',     desc: 'Promedios, Pitágoras, conversores.',                 color: '#0d9488', icon: '🧮' },
  tecnologia:      { label: 'Tecnología',     desc: 'Almacenamiento, IA, batería, cloud.',                color: '#06b6d4', icon: '💻' },
  'medio-ambiente':{ label: 'Medio Ambiente', desc: 'Huella de carbono, energía solar.',                  color: '#22c55e', icon: '🌱' },
  electronica:     { label: 'Electrónica',    desc: 'Ley de Ohm, kWh, circuitos.',                        color: '#f59e0b', icon: '⚡' },
  ciencia:         { label: 'Ciencia',        desc: 'Física, química, astronomía.',                       color: '#6366f1', icon: '🔬' },
  jardineria:      { label: 'Jardinería',     desc: 'Riego, tierra, siembra.',                            color: '#15803d', icon: '🌿' },
  construccion:    { label: 'Construcción',   desc: 'Materiales, presupuesto reforma.',                   color: '#b45309', icon: '🧱' },
};

const categoryOrder = ['finanzas','impuestos','vida','familia','salud','automotor','educacion','negocios','marketing','deportes','viajes','cocina','mascotas','matematica','tecnologia','medio-ambiente','electronica','ciencia','jardineria','construccion'];
const activeCategories = categoryOrder.filter((cat) => byCategory[cat] && byCategory[cat].length > 0);

const totalCalcs = calcs.length;

const popularSlugs = [
  'calculadora-sueldo-bruto-a-neto-peru',
  'calculadora-cts-peru-deposito-semestral',
  'calculadora-gratificacion-peru-julio-diciembre',
  'calculadora-impuesto-renta-quinta-categoria-peru',
  'calculadora-afp-vs-onp-peru',
  'calculadora-liquidacion-beneficios-sociales-peru'
];
const popular = popularSlugs.map((s) => calcs.find((c) => c.slug === s)).filter(Boolean);

// ── Datos clave 2026 — todo computado desde src/lib/data/peru-2026.ts (fuente única, nunca stale) ──
const P = PERU_2026;
const usdpen = (peLive as any)?.usdpen?.valor ?? 3.40;
const usdpenStr = usdpen.toFixed(3).replace('.', ',');
const liveMes = new Date((peLive as any)?._meta?.fetchedAt ?? '2026-06-01').toLocaleDateString('es-PE', { month: 'long', year: 'numeric' });
const netoRmvOnp = P.rmv * (1 - P.onp);
const deduccion7Uit = P.renta5ta.deduccionUit * P.uit;
const gratifRmv = P.rmv * (1 + P.gratificacion.bonificacionExtraordinaria);

const datosClave = [
  { k: 'Remuneración Mínima Vital (RMV)', v: `${fmtPEN(P.rmv)} /mes`, src: 'DS 006-2024-TR (MTPE)' },
  { k: 'UIT 2026', v: fmtPEN(P.uit), src: 'DS 301-2025-EF (MEF)' },
  { k: 'IGV', v: '18% (16% IGV + 2% IPM)', src: 'SUNAT' },
  { k: `Dólar (USD, ${liveMes})`, v: `S/ ${usdpenStr}`, src: 'Tipo de cambio de mercado' },
  { k: 'Asignación familiar', v: `${fmtPEN(P.asignacionFamiliar)} /mes (10% de la RMV)`, src: 'Ley 25129' },
  { k: 'Descuento ONP', v: '13% de la remuneración', src: 'ONP' },
  { k: 'Descuento AFP (total aprox.)', v: '~12,5% (10% fondo + prima + comisión)', src: 'SBS' },
  { k: 'EsSalud (paga el empleador)', v: '9% — no se descuenta de la boleta', src: 'EsSalud' },
  { k: 'Renta de 5ta categoría', v: `exenta hasta 7 UIT/año (${fmtPEN(deduccion7Uit)})`, src: 'SUNAT' },
  { k: 'Gratificaciones', v: '1 sueldo en julio y 1 en diciembre (+9% bonif.)', src: 'Ley 27735 / Ley 30334' },
];

// ── FAQ país-específica: respuestas con cifras computadas desde la fuente única ──
const faq = [
  {
    q: '¿Cuál es el sueldo mínimo en Perú en 2026?',
    a: `La Remuneración Mínima Vital es de ${fmtPEN(P.rmv)} mensuales (DS 006-2024-TR, vigente desde enero de 2025 y mantenida en 2026). Si tenés hijos menores de edad se suma la asignación familiar de ${fmtPEN(P.asignacionFamiliar)} (10% de la RMV).`,
  },
  {
    q: '¿Cómo se calcula el sueldo neto en Perú 2026?',
    a: `A la remuneración bruta se le descuenta la pensión: 13% si estás en ONP o ~12,5% si estás en AFP (10% al fondo + prima de seguro + comisión). Con la RMV de ${fmtPEN(P.rmv)} en ONP quedan ${fmtPEN(netoRmvOnp)} netos. EsSalud (9%) lo paga el empleador y no se descuenta. Si tus ingresos anuales superan 7 UIT, se retiene además renta de 5ta categoría.`,
  },
  {
    q: '¿Cuánto vale la UIT en 2026 y para qué sirve?',
    a: `La UIT 2026 vale ${fmtPEN(P.uit)} (DS 301-2025-EF). Define topes y tramos tributarios: la renta de 5ta deduce 7 UIT (${fmtPEN(deduccion7Uit)}), los tramos del impuesto van en UIT (8% hasta 5 UIT, 14%, 17%, 20% y 30% sobre 45 UIT) y muchas multas se fijan en UIT.`,
  },
  {
    q: '¿Quién paga impuesto a la renta de 5ta categoría?',
    a: `Sólo quien gana más de 7 UIT al año (${fmtPEN(deduccion7Uit)}). Como el año tiene 14 sueldos (12 + 2 gratificaciones), en la práctica empezás a pagar con sueldos desde aproximadamente ${fmtPEN(deduccion7Uit / 14)} mensuales. Por debajo de eso, la retención es cero.`,
  },
  {
    q: '¿Cuándo se pagan las gratificaciones y cuánto recibo?',
    a: `En julio (Fiestas Patrias) y diciembre (Navidad), hasta el 15 de cada mes: un sueldo completo cada una, libre de descuentos de AFP/ONP, más la bonificación extraordinaria del 9% (Ley 30334). Con la RMV: ${fmtPEN(gratifRmv)} por gratificación.`,
  },
  {
    q: '¿Qué es la CTS y cuándo se deposita?',
    a: `La CTS (Compensación por Tiempo de Servicios) equivale a un sueldo al año más 1/6 de la gratificación, depositado en dos armadas: hasta el 15 de mayo y hasta el 15 de noviembre. Es un fondo intangible pensado como seguro de desempleo.`,
  },
  {
    q: '¿Cuánto le cuesta un trabajador al empleador en Perú?',
    a: `Sobre el sueldo bruto, el empleador del régimen general suma: EsSalud 9%, gratificaciones (2 sueldos/año ≈ 16,67%), CTS (≈ 9,72%) y vacaciones (1 sueldo/año ≈ 8,33%). El sobrecosto total ronda el 45% del sueldo mensual.`,
  },
];

// ── Equivalencias AR → PE: inyecta autoridad interna desde el catálogo argentino ya posicionado ──
const equivalentesAr = [
  { ar: 'sueldo-en-mano-argentina', arLabel: 'Sueldo en mano (Argentina)', pe: 'calculadora-sueldo-bruto-a-neto-peru', peLabel: 'Sueldo neto en Perú', concepto: 'Sueldo neto' },
  { ar: 'calculadora-aguinaldo-sac', arLabel: 'Aguinaldo (SAC) Argentina', pe: 'calculadora-gratificacion-peru-julio-diciembre', peLabel: 'Gratificación (jul/dic)', concepto: 'Aguinaldo / gratificación' },
  { ar: 'calculadora-monotributo-2026', arLabel: 'Monotributo Argentina', pe: 'calculadora-rus-nuevo-regimen-unico-simplificado-peru', peLabel: 'Nuevo RUS', concepto: 'Régimen simplificado' },
  { ar: 'calculadora-vacaciones-argentina', arLabel: 'Vacaciones Argentina', pe: 'calculadora-vacaciones-truncas-peru', peLabel: 'Vacaciones truncas en Perú', concepto: 'Vacaciones' },
  { ar: 'calculadora-indemnizacion-despido', arLabel: 'Indemnización por despido Argentina', pe: 'calculadora-indemnizacion-despido-arbitrario-peru', peLabel: 'Indemnización por despido', concepto: 'Indemnización' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['CollectionPage', 'WebPage'],
      '@id': 'https://hacecuentas.com/pe#webpage',
      url: 'https://hacecuentas.com/pe',
      name: 'Calculadoras Perú 2026 — SUNAT, CTS, gratificación, AFP | Hacé Cuentas',
      description: `Calculadoras gratis específicas para Perú.`,
      inLanguage: 'es-PE',
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      breadcrumb: { '@id': 'https://hacecuentas.com/pe#breadcrumb' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://hacecuentas.com/pe#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Hacé Cuentas', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Perú', item: 'https://hacecuentas.com/pe' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://hacecuentas.com/pe#faq',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Dataset',
      '@id': 'https://hacecuentas.com/pe#datos-2026',
      name: 'Datos laborales y fiscales de Perú 2026',
      description: `Valores oficiales vigentes en Perú 2026: Remuneración Mínima Vital (${fmtPEN(P.rmv)}), UIT (${fmtPEN(P.uit)}), IGV, asignación familiar, descuentos de ONP y AFP, EsSalud, renta de 5ta categoría y gratificaciones.`,
      url: 'https://hacecuentas.com/pe',
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      inLanguage: 'es-PE',
      temporalCoverage: '2026',
      spatialCoverage: { '@type': 'Place', name: 'Perú' },
      creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
      sourceOrganization: [
        { '@type': 'GovernmentOrganization', name: 'SUNAT', url: 'https://www.sunat.gob.pe' },
        { '@type': 'GovernmentOrganization', name: 'Ministerio de Trabajo y Promoción del Empleo', url: 'https://www.gob.pe/mtpe' },
      ],
      keywords: ['sueldo mínimo Perú 2026', 'UIT 2026', 'renta quinta categoría', 'CTS 2026', 'gratificación julio diciembre', 'AFP vs ONP'],
    },
  ],
};

// Set hreflang único y simétrico para todas las homes (es + en + pt +
// 6 verticales + global), x-default → home raíz. Ver src/lib/hreflang.ts.
const hreflangTags = HOME_HREFLANG;
---

<Layout
  title="Calculadoras Perú 2026 — SUNAT, CTS, gratificación, AFP | Hacé Cuentas"
  description={`${totalCalcs} calculadoras gratis para Perú: sueldo neto, renta 5ta SUNAT, CTS, gratificaciones, AFP vs ONP, RMV. Datos oficiales 2026.`}
  lang="es"
  audience="PE"
  hreflang={hreflangTags}
  schema={schema}
>
  <Header slot="header" />

  <div class="cc-index">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-badge">🇵🇪 Perú · 2026</div>
        <h1>Calculadoras para Perú</h1>
        <p class="hero-sub">Sueldo neto, renta de 5ta categoría, CTS, gratificaciones, AFP vs ONP, RMV. Datos oficiales SUNAT, MTPE y EsSalud. Gratis.</p>
        <div class="hero-stats">
          <span class="stat"><strong>{totalCalcs}</strong> calculadoras</span>
          <span class="stat-sep" aria-hidden="true">·</span>
          <span class="stat"><strong>{activeCategories.length}</strong> categorías</span>
          <span class="stat-sep" aria-hidden="true">·</span>
          <span class="stat">100% gratis</span>
        </div>
        <a href="/dolar-hoy-peru" class="hero-live"><span class="dot-live" aria-hidden="true"></span>Dólar hoy en Perú: S/ {usdpenStr}</a>
      </div>
    </section>

    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Hacé Cuentas</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Perú</span>
    </nav>

    {popular.length > 0 && (
      <section class="popular-section" aria-label="Más usadas">
        <h2 class="popular-title">Más usadas en Perú</h2>
        <div class="popular-grid">
          {popular.map((c: any) => (
            <a href={calcUrl(c)} class="popular-card">
              <span class="popular-icon">{c.icon || '🧮'}</span>
              <span class="popular-label">{c.h1}</span>
            </a>
          ))}
          <a href="/pe/validar-ruc" class="popular-card"><span class="popular-icon">🪪</span><span class="popular-label">Validar RUC (SUNAT)</span></a>
        </div>
      </section>
    )}

    <section class="datos-clave" aria-labelledby="datos-clave-title">
      <h2 id="datos-clave-title">Datos clave de Perú 2026</h2>
      <p class="section-sub">Los valores oficiales que usan todas nuestras calculadoras peruanas. Uso libre con atribución (CC-BY 4.0).</p>
      <div class="dc-wrap">
        <table class="dc-table">
          <thead>
            <tr><th>Concepto</th><th>Valor 2026</th><th>Fuente</th></tr>
          </thead>
          <tbody>
            {datosClave.map((d) => (
              <tr><td>{d.k}</td><td>{d.v}</td><td class="dc-src">{d.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dc-note">Última revisión: 10 de junio de 2026. Fuentes: SUNAT, MTPE, EsSalud y El Peruano.</p>
    </section>

    <section class="popular-section" aria-label="Más recursos de Perú">
      <h2 class="popular-title">Más recursos de Perú</h2>
      <div class="popular-grid">
        <a href="/dolar-hoy-peru" class="popular-card"><span class="popular-icon">💵</span><span class="popular-label">Dólar hoy en Perú</span></a>
        <a href="/feriados-peru-2026" class="popular-card"><span class="popular-icon">📅</span><span class="popular-label">Feriados Perú 2026</span></a>
        <a href="/datos-salario-minimo-latam-2026" class="popular-card"><span class="popular-icon">🌎</span><span class="popular-label">Salario mínimo LATAM</span></a>
        <a href="/pe/decidir" class="popular-card"><span class="popular-icon">🧭</span><span class="popular-label">Salas de decisión</span></a>
      </div>
    </section>

    <div class="categories">
      {activeCategories.map((catKey) => {
        const meta = categoryMeta[catKey];
        const catCalcs = byCategory[catKey];
        return (
          <section class="category-section" aria-labelledby={`cat-${catKey}`}>
            <div class="cat-header">
              <span class="cat-icon" aria-hidden="true" style={`background: ${meta?.color}18`}>{meta?.icon ?? '📁'}</span>
              <div class="cat-meta">
                <h2 id={`cat-${catKey}`} class="cat-label">{meta?.label ?? catKey}</h2>
                {meta?.desc && <p class="cat-desc">{meta.desc}</p>}
              </div>
            </div>
            <div class="calc-grid">
              {catCalcs.map((calc: any) => (
                <a href={calcUrl(calc)} class="calc-card">
                  <span class="card-icon" aria-hidden="true">{calc.icon}</span>
                  <div class="card-body">
                    <span class="card-title">{calc.h1}</span>
                    <span class="card-desc">{calc.description}</span>
                  </div>
                  <span class="card-badge" style={`background:${meta?.color}18; color:${meta?.color}`}>{meta?.label ?? catKey}</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <section class="equiv-ar" aria-labelledby="equiv-ar-title">
      <h2 id="equiv-ar-title">Equivalentes en Argentina</h2>
      <p class="section-sub">¿Venís de Argentina o comparás los dos países? Cada cálculo laboral tiene su par peruano.</p>
      <div class="equiv-grid">
        {equivalentesAr.map((e) => (
          <div class="equiv-row">
            <span class="equiv-concepto">{e.concepto}</span>
            <div class="equiv-pair">
              <a href={`/${e.ar}`} class="equiv-link">🇦🇷 {e.arLabel}</a>
              <span class="equiv-arrow" aria-hidden="true">→</span>
              <a href={`/pe/${e.pe}`} class="equiv-link">🇵🇪 {e.peLabel}</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="faq-hub" aria-labelledby="faq-title">
      <h2 id="faq-title">Preguntas frecuentes sobre sueldos e impuestos en Perú 2026</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <details>
            <summary><span>{f.q}</span></summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <aside class="cta-footer" aria-label="Otras versiones">
      <p class="cta-text">¿Buscas calculadoras de otro país?</p>
      <p class="cta-sub">Tenemos versiones específicas con datos locales para Argentina, España, México, Perú, Chile y Brasil. La versión global aplica al resto del mundo hispano.</p>
      <div class="cta-links">
        <a href="/global" class="cta-pill">🌎 Global</a>
        <a href="/" class="cta-pill">🇦🇷 Argentina</a>
        <a href="/es" class="cta-pill">🇪🇸 España</a>
        <a href="/mx" class="cta-pill">🇲🇽 México</a>
        <a href="/pe" class="cta-pill">🇵🇪 Perú</a>
        <a href="/cl" class="cta-pill">🇨🇱 Chile</a>
        <a href="/pt" class="cta-pill">🇧🇷 Brasil</a>
      </div>
    </aside>
  </div>

  <ScrollToTop />
  <Footer slot="footer" />
</Layout>

<style>
  .cc-index { max-width: 1060px; margin: 0 auto; }
  .hero { text-align: center; padding: 3rem 1rem 2.5rem; border-bottom: 1px solid var(--border); margin-bottom: 2rem; }
  .hero-inner { max-width: 720px; margin: 0 auto; }
  .hero-badge {
    display: inline-block; padding: 0.3rem 0.875rem; background: var(--accent-soft);
    color: var(--accent); border: 1px solid var(--border); border-radius: 999px;
    font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.02em; margin-bottom: 1rem;
  }
  .hero h1 { font-size: clamp(2rem, 5vw, 2.75rem); margin: 0 0 0.875rem; line-height: 1.15; }
  .hero-sub { color: var(--text-muted); font-size: 1.0625rem; line-height: 1.6; max-width: 620px; margin: 0 auto 1.5rem; }
  .hero-stats { display: inline-flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; color: var(--text-muted); font-size: 0.9375rem; }
  .hero-stats .stat strong { color: var(--text); font-weight: 700; }
  .hero-stats .stat-sep { opacity: 0.4; }

  .breadcrumbs { padding: 0 1rem 1.5rem; font-size: 0.875rem; color: var(--text-muted); }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }
  .breadcrumbs .sep { margin: 0 0.5rem; opacity: 0.5; }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }

  .popular-section { padding: 0 1rem 2rem; }
  .popular-title { font-size: 1.125rem; margin: 0 0 0.875rem; color: var(--text-muted); font-weight: 600; }
  .popular-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.625rem; }
  .popular-card {
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    padding: 1rem 0.75rem; background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-sm); text-decoration: none; color: var(--text);
    text-align: center; transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .popular-card:hover { border-color: var(--accent); transform: translateY(-2px); }
