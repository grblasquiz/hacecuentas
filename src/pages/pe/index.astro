---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PeruHomeExperience from '../../components/generated/PeruHomeExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
const canonical='https://hacecuentas.com/pe';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Hacé Cuentas Perú",url:canonical,operatingSystem:'Web'};
---
<Layout title="Hacé Cuentas Perú | Hacé Cuentas" description="Hacé Cuentas Perú. Herramienta clara, gratuita y actualizada." canonical={canonical} schema={schema} lang="es" hreflang={HOME_HREFLANG}>
  <Header />
  <PeruHomeExperience />
  <RecoveredHubIntro eyebrow="Perú" h1="Calculadoras para Perú" lede="Herramientas prácticas para trabajo, impuestos, vivienda, estudios y finanzas personales." note="Usá la categoría que mejor describa tu consulta y verificá la fuente indicada." links={[{href:'/pe/calculadoras',title:'Todas las calculadoras',description:'Catálogo completo para Perú.'},{href:'/pe/trabajo',title:'Trabajo',description:'Sueldo, beneficios y liquidaciones.'},{href:'/pe/finanzas-personales',title:'Finanzas personales',description:'Créditos, ahorro y jubilación.'}]} />
  <Footer />
</Layout>
