---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PeruHomeExperience from '../../components/generated/PeruHomeExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
const canonical='https://hacecuentas.com/pe';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Hacé Cuentas Perú",url:canonical,operatingSystem:'Web'};
---
<Layout title="Calculadoras de Perú: sueldo, impuestos y finanzas | Hacé Cuentas" description="Calculá sueldo, CTS, gratificación, impuestos, créditos, vivienda, auto y trámites en Perú con valores y fuentes locales." canonical={canonical} schema={schema} lang="es" hreflang={HOME_HREFLANG}>
  <Header />
  <PeruHomeExperience />
  <RecoveredHubIntro eyebrow="Perú 2026" h1="Datos y cálculos más consultados" lede="Accedé directo a las referencias de sueldo, tipo de cambio y calendario con mayor demanda en Perú." note="Cada página indica la fuente y la fecha de actualización usada." links={[
    {href:'/pe/datos-sueldo-minimo-peru-2026',title:'Sueldo mínimo Perú 2026',description:'RMV mensual, valor diario y referencias laborales.'},
    {href:'/pe/calculadora-tipo-de-cambio-sunat-dolar-soles-peru',title:'Tipo de cambio SUNAT',description:'Dólar a soles para facturas, IGV y declaraciones.'},
    {href:'/feriados-peru-2026',title:'Feriados Perú 2026',description:'Feriados nacionales, días no laborables y puentes.'},
    {href:'/pe/trabajo',title:'Trabajo',description:'Sueldo, CTS, gratificación y liquidaciones.'},
    {href:'/pe/calculadoras',title:'Todas las herramientas de Perú',description:'Catálogo completo por tema.'}
  ]} />
  <Footer />
</Layout>
