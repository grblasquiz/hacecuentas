---
/**
 * Hub de decisión PE — "¿Cuánto impuesto se le suma a lo que compro o cobro?"
 * Absorbe IGV, detracciones (SPOT), ITF, tributos courier y tipo de cambio SUNAT.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  IGV,
  IGV_MYPE,
  SPOT,
  SPOT_MINIMO,
  ITF_TASA,
  BANCARIZACION,
  COURIER,
} from '../../../lib/hubs/pe/igv-y-compras';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="PE"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ IGV, IGV_MYPE, SPOT, SPOT_MINIMO, ITF_TASA, BANCARIZACION, COURIER }}
>
  (function () {
    const H = window.HC_HUB;
    const nf = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 });
    const nf2 = new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const sol = (n) => 'S/ ' + nf.format(Math.round(n || 0));
    const sol2 = (n) => 'S/ ' + nf2.format(Math.round((n || 0) * 100) / 100);
    const usd = (n) => 'US$ ' + nf2.format(Math.round((n || 0) * 100) / 100);
    const pct = (x) => String(x * 100).replace('.', ',') + '%';
    const MONEY = { format: 'unit', unit: 'soles' };

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'igv';
      const monto = Math.max(0, v.monto || 0);
      const tc = Math.max(0.5, v.tipoCambio || 3.4);
      const rows = [];

      // ---------- IGV: agregar o quitar ----------
      if (id === 'igv') {
        const tasa = String(v.tasaIgv || 'general') === 'mype' ? IGV_MYPE : IGV;
        const quitar = String(v.modo || 'agregar') === 'quitar';
        let base, igv, total;
        if (quitar) { total = monto; base = total / (1 + tasa); igv = total - base; }
        else { base = monto; igv = base * tasa; total = base + igv; }

        rows.push({ k: 'Valor de venta (base imponible)', ref: quitar ? 'Precio final ÷ ' + (1 + tasa).toFixed(3).replace('.', ',') : 'Lo que cargaste', v: base, decimals: 2 });
        rows.push({ k: 'IGV de la operación', ref: tasa === IGV ? '16% de IGV + 2% de IPM' : 'Tasa especial MYPE de restaurantes y hoteles', v: igv, decimals: 2, extra: true });
        rows.push({ k: 'Precio final con IGV', ref: 'Lo que figura en el comprobante', v: total, decimals: 2 });
        rows.push({ k: 'Tasa aplicada', ref: 'Sobre el valor de venta', v: tasa * 100, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: 'Peso del IGV sobre el precio final', ref: 'IGV ÷ total', v: total > 0 ? (igv / total) * 100 : 0, format: 'unit', unit: '%', decimals: 2 });

        return {
          total: sol2(igv),
          sub: 'Valor de venta ' + sol2(base) + ' + IGV ' + sol2(igv) + ' = ' + sol2(total) + ' · tasa ' + pct(tasa),
          rows: rows,
          format: MONEY.format,
          unit: MONEY.unit,
          decimals: 2,
          chart: [
            { label: 'Valor de venta', value: Math.round(base), tone: 'main' },
            { label: 'IGV', value: Math.round(igv), tone: 'warn' },
          ],
        };
      }

      // ---------- Detracción SPOT ----------
      if (id === 'detraccion') {
        const key = String(v.servicio || 'servicios');
        const s = SPOT.find((x) => x.id === key) || SPOT[0];
        const aplica = monto > SPOT_MINIMO;
        const detraccion = aplica ? monto * s.pct : 0;
        const alProveedor = monto - detraccion;
        // Descomposición informativa del importe total de la operación.
        const baseSinIgv = monto / (1 + IGV);

        rows.push({ k: 'Importe total de la operación', ref: 'Con IGV incluido: es la base de la detracción', v: monto, decimals: 2 });
        rows.push({ k: 'Valor de venta sin IGV', ref: 'Informativo · total ÷ 1,18', v: baseSinIgv, decimals: 2 });
        rows.push({ k: 'Porcentaje de detracción', ref: s.label + ' · ' + s.ref, v: s.pct * 100, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: aplica ? 'Detracción a depositar' : 'Detracción (no corresponde)', ref: aplica ? 'A tu cuenta del Banco de la Nación' : 'La operación no supera ' + sol(SPOT_MINIMO), v: detraccion, decimals: 2, extra: true });
        rows.push({ k: 'Lo que el cliente te transfiere', ref: 'Importe total menos la detracción', v: alProveedor, decimals: 2 });
        rows.push({ k: 'Umbral para que nazca la obligación', ref: 'Anexo 3 · R.S. 183-2004/SUNAT', v: SPOT_MINIMO });

        return {
          total: sol2(detraccion),
          sub: aplica
            ? 'De ' + sol2(monto) + ' te transfieren ' + sol2(alProveedor) + ' y ' + sol2(detraccion) + ' van a tu cuenta de detracciones (' + pct(s.pct) + ')'
            : 'La operación no supera ' + sol(SPOT_MINIMO) + ': no hay detracción y cobras los ' + sol2(monto) + ' completos',
          rows: rows,
          format: MONEY.format,
          unit: MONEY.unit,
          decimals: 2,
          chart: [
            { label: 'Te lo transfieren', value: Math.round(alProveedor), tone: 'main' },
            { label: 'Va a la cuenta de detracciones', value: Math.round(detraccion), tone: 'prop' },
          ],
        };
      }

      // ---------- ITF ----------
      if (id === 'itf') {
        const n = Math.max(1, Math.round(v.operaciones || 1));
        const porOp = Math.round(monto * ITF_TASA * 100) / 100;
        const totalItf = Math.round(porOp * n * 100) / 100;
        const movido = monto * n;
        const neto = movido - totalItf;
        const requiereBanco = monto >= BANCARIZACION.pen;

        rows.push({ k: 'Monto por operación', ref: 'Cargo o abono en cuenta afecta', v: monto, decimals: 2 });
        rows.push({ k: 'Operaciones del mes', ref: 'Del mismo monto', v: n, format: 'plain' });
        rows.push({ k: 'ITF por operación', ref: pct(ITF_TASA) + ' · Ley 28194', v: porOp, decimals: 2 });
        rows.push({ k: 'ITF total retenido', ref: 'Lo descuenta el banco automáticamente', v: totalItf, decimals: 2, extra: true });
        rows.push({ k: 'Total movido en el período', ref: 'Monto × operaciones', v: movido, decimals: 2 });
        rows.push({ k: 'Queda después del ITF', ref: 'Movido menos la retención', v: neto, decimals: 2 });
        rows.push({ k: 'ITF por cada S/ 1.000 movidos', ref: 'Referencia rápida', v: 1000 * ITF_TASA, decimals: 2 });
        rows.push({ k: requiereBanco ? 'Bancarización obligatoria' : 'Bancarización no obligatoria', ref: requiereBanco ? 'Supera el umbral de ' + sol(BANCARIZACION.pen) : 'Por debajo de ' + sol(BANCARIZACION.pen) + ' (o US$ ' + BANCARIZACION.usd + ')', v: BANCARIZACION.pen });

        return {
          total: sol2(totalItf),
          sub:
            'Por mover ' + sol2(movido) + ' en ' + n + (n === 1 ? ' operación gravada' : ' operaciones gravadas') +
            ' el banco retiene ' + sol2(totalItf) + ' · ' + pct(ITF_TASA) + ' por operación' +
            (requiereBanco ? ' · esta operación debe pagarse por el sistema financiero' : ''),
          rows: rows,
          format: MONEY.format,
          unit: MONEY.unit,
          decimals: 2,
          chart: [
            { label: 'Monto que queda', value: Math.round(neto), tone: 'main' },
            { label: 'ITF retenido', value: Math.max(1, Math.round(totalItf)), tone: 'warn' },
          ],
        };
      }

      // ---------- Compra del exterior por courier ----------
      const valor = Math.max(0, v.valorUsd || 0);
      const excede = valor > COURIER.topeSimplificadoUsd;
      const exento = valor <= COURIER.deMinimisUsd;
      const adv = exento || excede ? 0 : valor * COURIER.adValorem;
      const baseIgv = valor + adv;
      const igvUsd = exento || excede ? 0 : baseIgv * COURIER.igv;
      const tributosUsd = adv + igvUsd;
      const totalUsd = valor + tributosUsd;

      rows.push({ k: 'Valor FOB de la compra', ref: usd(valor) + ' al tipo de cambio ' + nf2.format(tc), v: valor * tc, decimals: 2 });
      rows.push({ k: 'Ad valorem', ref: excede ? 'Régimen general: según la subpartida de cada producto' : exento ? 'No corresponde: hasta US$ ' + COURIER.deMinimisUsd + ' FOB no hay tributos' : pct(COURIER.adValorem) + ' sobre el valor FOB', v: adv * tc, decimals: 2 });
      rows.push({ k: 'IGV de importación', ref: excede ? 'Régimen general' : exento ? 'No corresponde' : pct(COURIER.igv) + ' sobre valor + ad valorem', v: igvUsd * tc, decimals: 2 });
      rows.push({ k: 'Tributos totales', ref: excede ? 'Requiere agente de aduana y declaración' : usd(tributosUsd), v: tributosUsd * tc, decimals: 2, extra: true });
      rows.push({ k: 'Costo final del pedido', ref: usd(totalUsd) + ' · sin contar el flete ni la comisión del courier', v: totalUsd * tc, decimals: 2 });
      rows.push({ k: 'Carga tributaria sobre el precio', ref: 'Tributos ÷ valor de la mercadería', v: valor > 0 ? (tributosUsd / valor) * 100 : 0, format: 'unit', unit: '%', decimals: 1 });
      rows.push({ k: 'Margen hasta el umbral sin tributos', ref: 'De minimis de US$ ' + COURIER.deMinimisUsd + ' FOB', v: Math.max(0, COURIER.deMinimisUsd - valor) * tc, decimals: 2 });

      return {
        total: sol2(tributosUsd * tc),
        sub: excede
          ? 'La compra supera los US$ ' + COURIER.topeSimplificadoUsd + ' FOB: sale del régimen courier y necesita agente de aduana, con aranceles según la subpartida de cada producto'
          : exento
            ? 'Hasta US$ ' + COURIER.deMinimisUsd + ' FOB no se pagan tributos: el paquete llega sin cargos de Aduanas'
            : usd(adv) + ' de ad valorem y ' + usd(igvUsd) + ' de IGV sobre una compra de ' + usd(valor) + ' · ' + ((tributosUsd / valor) * 100).toFixed(1).replace('.', ',') + '% extra',
        rows: rows,
        format: MONEY.format,
        unit: MONEY.unit,
        decimals: 2,
        chart: [
          { label: 'Tu compra', value: Math.round(valor * tc), tone: 'main' },
          { label: 'Ad valorem', value: Math.round(adv * tc), tone: 'prop' },
          { label: 'IGV de importación', value: Math.round(igvUsd * tc), tone: 'warn' },
        ],
      };
    });
  })();
</script>
