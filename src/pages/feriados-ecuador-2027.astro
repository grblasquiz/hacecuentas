---
export const prerender = true;
import FeriadosLanding from '../components/FeriadosLanding.astro';
import { FERIADOS_LATAM_2027 } from '../lib/data/feriados-latam-2027';

const related = [
  { href: '/dias-entre-dos-fechas', label: 'Días entre dos fechas' },
  { href: '/calculadora-cuenta-regresiva-dias-faltan', label: 'Cuenta regresiva: cuántos días faltan' },
  { href: '/ec/calculadora-decimo-cuarto-sueldo-ecuador', label: 'Calculadora de décimo cuarto sueldo Ecuador' },
  { href: '/ec', label: 'Más calculadoras para Ecuador' },

  // Cluster de feriados 2027 ↔ 2026: la versión vigente le pasa autoridad a la
  // del año siguiente y viceversa (mismo patrón que el cluster 2026).
  { href: '/feriados-ecuador-2026', label: 'Feriados Ecuador 2026' },
  { href: '/feriados-2027', label: 'Feriados 2027 en todos los países' },
];

const title = 'Feriados Ecuador 2027: calendario oficial con puentes';
const description = 'Feriados de Ecuador 2027: fechas oficiales confirmadas, día de la semana de cada una, fines de semana largos y puentes para planificar el año.';
---
<FeriadosLanding data={FERIADOS_LATAM_2027.ecuador} related={related} title={title} description={description} anio={2027} />
