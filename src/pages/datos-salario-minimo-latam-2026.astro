---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { salarioMinimo } from '../lib/formulas/salario-minimo';
import { SALARIO_MINIMO as SM_BR } from '../lib/data/brasil-2026';
import { PERU_2026 } from '../lib/data/peru-2026';
import { ECUADOR_2026 } from '../lib/data/ecuador-2026';
import { COLOMBIA_2026 } from '../lib/data/colombia-2026';
import { MEXICO_2026 } from '../lib/data/mexico-2026';
import { PARAGUAY_2026 } from '../lib/data/paraguay-2026';
import { URUGUAY_2026 } from '../lib/data/uruguay-2026';
import { CHILE_2026 } from '../lib/data/chile-2026';
import { REPUBLICA_DOMINICANA_2026 } from '../lib/data/republica-dominicana-2026';
import { VENEZUELA_2026 } from '../lib/data/venezuela-2026';

// Página-dato enlazable: salario mínimo comparado en LATAM 2026.
// Cada valor sale de la fuente única verificada de su país en este repo
// (salario-minimo.ts AR / brasil-2026.ts / peru-2026.ts / ecuador-2026.ts),
// las mismas que usan las calculadoras → cero drift entre tabla y calcs.
// Sólo se publican países con fuente única verificada (cero estimaciones).
// Patrón espejado de /datos-monotributo-2026: tabla server-rendered + schema
// Dataset + CC-BY 4.0 + bloque "Cómo citar".

const ULTIMA_REVISION = '2026-07-24';

// AR — el SMVM vive en la fórmula oficial (el fetcher de CNEPySMVyM la patchea).
const ar = salarioMinimo({ horasSemana: 48 });

const fmtNum = (n: number, locale = 'es-AR', dec = 0) =>
  n.toLocaleString(locale, { minimumFractionDigits: dec, maximumFractionDigits: dec });

const PAISES = [
  {
    pais: 'Argentina',
    bandera: '🇦🇷',
    instrumento: 'Salario Mínimo, Vital y Móvil (SMVM)',
    valor: `$ ${fmtNum(ar.smvmMensual)} ARS`,
    norma: 'Resolución 9/2025 CNEPySMVyM',
    vigencia: ar.fechaVigencia,
    nota: `Valor hora: $ ${fmtNum(ar.smvmHora)} · jornada completa (48 h semanales)`,
  },
  {
    pais: 'Brasil',
    bandera: '🇧🇷',
    instrumento: 'Salário mínimo nacional',
    valor: `R$ ${fmtNum(SM_BR, 'pt-BR', 2)} BRL`,
    norma: 'Decreto 12.797/2025',
    vigencia: 'enero 2026',
    nota: 'Reajuste anual en enero (+6,79% sobre los R$ 1.518 de 2025)',
  },
  {
    pais: 'Perú',
    bandera: '🇵🇪',
    instrumento: 'Remuneración Mínima Vital (RMV)',
    valor: `S/ ${fmtNum(PERU_2026.rmv, 'es-PE')} PEN`,
    norma: 'DS 006-2024-TR',
    vigencia: 'desde enero 2025 (mantenida en 2026)',
    nota: `Asignación familiar: S/ ${fmtNum(PERU_2026.asignacionFamiliar, 'es-PE')} (10% de la RMV, con hijos menores)`,
  },
  {
    pais: 'Ecuador',
    bandera: '🇪🇨',
    instrumento: 'Salario Básico Unificado (SBU)',
    valor: `US$ ${fmtNum(ECUADOR_2026.sbu, 'es-EC')} USD`,
    norma: 'Ministerio del Trabajo',
    vigencia: 'enero 2026',
    nota: `Economía dolarizada · décimo cuarto sueldo = 1 SBU (US$ ${fmtNum(ECUADOR_2026.decimoCuarto, 'es-EC')})`,
  },
  {
    pais: 'México',
    bandera: '🇲🇽',
    instrumento: 'Salario Mínimo General (CONASAMI)',
    valor: `$ ${fmtNum(MEXICO_2026.salarioMinimo.generalDiario, 'es-MX', 2)} MXN/día`,
    norma: 'Resolución CONASAMI 2026',
    vigencia: 'enero 2026',
    nota: `≈ $ ${fmtNum(MEXICO_2026.salarioMinimo.generalMensual, 'es-MX')} mensual · Zona Libre Frontera Norte: $ ${fmtNum(MEXICO_2026.salarioMinimo.zlfnDiario, 'es-MX', 2)}/día`,
  },
  {
    pais: 'Colombia',
    bandera: '🇨🇴',
    instrumento: 'Salario Mínimo Legal Mensual (SMLMV)',
    valor: `$ ${fmtNum(COLOMBIA_2026.smlmv, 'es-CO')} COP`,
    norma: 'Decreto 1469 de 2025',
    vigencia: 'enero 2026',
    nota: `+ auxilio de transporte $ ${fmtNum(COLOMBIA_2026.auxilioTransporte, 'es-CO')} (Dto 1470/2025) = $ ${fmtNum(COLOMBIA_2026.smlmv + COLOMBIA_2026.auxilioTransporte, 'es-CO')}`,
  },
  {
    pais: 'Paraguay',
    bandera: '🇵🇾',
    instrumento: 'Salario Mínimo (SMVM)',
    valor: `Gs. ${fmtNum(PARAGUAY_2026.salarioMinimo, 'es-PY')} PYG`,
    norma: 'MTESS (Paraguay)',
    vigencia: 'desde julio 2026',
    nota: `Jornal mínimo diario: Gs. ${fmtNum(PARAGUAY_2026.jornalMinimo, 'es-PY')}`,
  },
  {
    pais: 'Uruguay',
    bandera: '🇺🇾',
    instrumento: 'Salario Mínimo Nacional (SMN)',
    valor: `$ ${fmtNum(URUGUAY_2026.smn.mensualJulio, 'es-UY')} UYU`,
    norma: 'Decreto N° 319/025',
    vigencia: 'desde julio 2026',
    nota: `$ ${fmtNum(URUGUAY_2026.smn.mensualEnero, 'es-UY')} de enero a junio · jornal $ ${fmtNum(URUGUAY_2026.smn.jornalJulio, 'es-UY')}`,
  },
  {
    pais: 'Chile',
    bandera: '🇨🇱',
    instrumento: 'Ingreso Mínimo Mensual (IMM)',
    valor: `$ ${fmtNum(CHILE_2026.imm, 'es-CL')} CLP`,
    norma: 'Ley 21.830',
    vigencia: 'desde mayo 2026',
    nota: `$ ${fmtNum(CHILE_2026.immHistoricoEneAbr2026, 'es-CL')} de enero a abril (Ley 21.751) · menores de 18 y mayores de 65: $ ${fmtNum(CHILE_2026.immMenores18Mayores65, 'es-CL')}`,
  },
  {
    pais: 'República Dominicana',
    bandera: '🇩🇴',
    instrumento: 'Salario mínimo por sector y tamaño de empresa (CNS)',
    valor: `RD$ ${fmtNum(REPUBLICA_DOMINICANA_2026.salarioMinimo.noSectorizado.grande, 'es-DO', 2)} DOP`,
    norma: 'Resolución CNS-01-2025',
    vigencia: 'desde febrero 2026 (2ª fase)',
    nota: `No hay un mínimo único: el valor mostrado es el del sector privado no sectorizado en empresas grandes. Mediana RD$ ${fmtNum(REPUBLICA_DOMINICANA_2026.salarioMinimo.noSectorizado.mediana, 'es-DO', 2)} · pequeña RD$ ${fmtNum(REPUBLICA_DOMINICANA_2026.salarioMinimo.noSectorizado.pequena, 'es-DO', 2)} · micro RD$ ${fmtNum(REPUBLICA_DOMINICANA_2026.salarioMinimo.noSectorizado.micro, 'es-DO', 2)}`,
  },
  {
    pais: 'Venezuela',
    bandera: '🇻🇪',
    instrumento: 'Salario mínimo legal (LOTTT)',
    valor: `Bs. ${fmtNum(VENEZUELA_2026.salarioMinimoVes, 'es-VE')} VES`,
    norma: 'LOTTT — último ajuste marzo 2022',
    vigencia: 'sin modificar desde 2022',
    nota: `El mínimo legal quedó congelado y hoy es nominal: el grueso del ingreso llega por el cestaticket (US$ ${fmtNum(VENEZUELA_2026.cestaticketUsd)} indexado a tasa BCV) y bonos no salariales, que no computan para prestaciones`,
  },
];

const title =
  'Salario Mínimo 2026: cuánto es en cada país de LATAM (tabla oficial) | Hacé Cuentas';
const description =
  `¿Cuánto es el salario mínimo 2026? Argentina $ ${fmtNum(ar.smvmMensual)} ARS · Colombia $ ${fmtNum(COLOMBIA_2026.smlmv, 'es-CO')} COP · México $ ${fmtNum(MEXICO_2026.salarioMinimo.generalDiario, 'es-MX', 2)}/día · Chile $ ${fmtNum(CHILE_2026.imm, 'es-CL')} CLP · Brasil R$ ${fmtNum(SM_BR, 'pt-BR', 0)} · Perú S/ ${fmtNum(PERU_2026.rmv, 'es-PE')} y 5 países más, con norma legal y vigencia. Fuentes oficiales, uso libre (CC-BY 4.0).`;

const PAGE_URL = 'https://hacecuentas.com/datos-salario-minimo-latam-2026';

// ── Datos numéricos crudos por país para el gráfico SVG.
// Valores EXACTOS de la fuente única de cada país (los mismos de la tabla) → cero fabricación.
// OJO: monedas distintas (ARS/BRL/PEN/USD) → NO comparables en un eje común.
// Por eso cada barra ocupa el mismo ancho (NO se escalan entre sí, evitando la
// comparación engañosa que la página ya advierte) y lleva su moneda y monto.
const chartPaises = [
  { pais: 'Argentina', bandera: '🇦🇷', moneda: 'ARS', simbolo: '$', valor: ar.smvmMensual, locale: 'es-AR' },
  { pais: 'Brasil', bandera: '🇧🇷', moneda: 'BRL', simbolo: 'R$', valor: SM_BR, locale: 'pt-BR' },
  { pais: 'Perú', bandera: '🇵🇪', moneda: 'PEN', simbolo: 'S/', valor: PERU_2026.rmv, locale: 'es-PE' },
  { pais: 'Ecuador', bandera: '🇪🇨', moneda: 'USD', simbolo: 'US$', valor: ECUADOR_2026.sbu, locale: 'es-EC' },
  { pais: 'México', bandera: '🇲🇽', moneda: 'MXN', simbolo: '$', valor: MEXICO_2026.salarioMinimo.generalMensual, locale: 'es-MX' },
  { pais: 'Colombia', bandera: '🇨🇴', moneda: 'COP', simbolo: '$', valor: COLOMBIA_2026.smlmv, locale: 'es-CO' },
  { pais: 'Paraguay', bandera: '🇵🇾', moneda: 'PYG', simbolo: 'Gs.', valor: PARAGUAY_2026.salarioMinimo, locale: 'es-PY' },
  { pais: 'Uruguay', bandera: '🇺🇾', moneda: 'UYU', simbolo: '$', valor: URUGUAY_2026.smn.mensualJulio, locale: 'es-UY' },
  { pais: 'Chile', bandera: '🇨🇱', moneda: 'CLP', simbolo: '$', valor: CHILE_2026.imm, locale: 'es-CL' },
  { pais: 'Rep. Dominicana', bandera: '🇩🇴', moneda: 'DOP', simbolo: 'RD$', valor: REPUBLICA_DOMINICANA_2026.salarioMinimo.noSectorizado.grande, locale: 'es-DO' },
  { pais: 'Venezuela', bandera: '🇻🇪', moneda: 'VES', simbolo: 'Bs.', valor: VENEZUELA_2026.salarioMinimoVes, locale: 'es-VE' },
];
// Geometría del SVG (barras horizontales: una fila por país).
const VB_W = 760;
const ROW_H = 70;
const VB_H = chartPaises.length * ROW_H + 16;
const LABEL_W = 160; // ancho reservado a la etiqueta de país
const BAR_X = LABEL_W;
const BAR_MAX_W = VB_W - LABEL_W - 16; // la barra llega casi al borde (no es eje comparativo)
const BAR_H = 30;
const chartRows = chartPaises.map((p, i) => {
  const cy = 8 + i * ROW_H + ROW_H / 2;
  return {
    ...p,
    cy,
    barY: cy - BAR_H / 2,
    barW: BAR_MAX_W, // mismo ancho para todas → señala que NO se comparan
    montoFmt: `${p.simbolo} ${p.valor.toLocaleString(p.locale, { minimumFractionDigits: 0, maximumFractionDigits: 0 })} ${p.moneda}`,
  };
});
// Snippet de cita listo para copiar (atribución + dato clave + backlink canónico).
const citeSnippet = `<p>Salario mínimo 2026 en LATAM: Argentina $ ${fmtNum(ar.smvmMensual)} ARS · México $ ${fmtNum(MEXICO_2026.salarioMinimo.generalDiario, 'es-MX', 2)} MXN/día · Colombia $ ${fmtNum(COLOMBIA_2026.smlmv, 'es-CO')} COP · Brasil R$ ${fmtNum(SM_BR, 'pt-BR')} BRL · Perú S/ ${fmtNum(PERU_2026.rmv, 'es-PE')} PEN · Paraguay Gs. ${fmtNum(PARAGUAY_2026.salarioMinimo, 'es-PY')} PYG · Uruguay $ ${fmtNum(URUGUAY_2026.smn.mensualJulio, 'es-UY')} UYU · Ecuador US$ ${fmtNum(ECUADOR_2026.sbu)} USD. <a href="${PAGE_URL}">Fuente: Hacé Cuentas — Salario mínimo LATAM 2026</a></p>`;

const faq = [
  {
    q: '¿Cuál es el salario mínimo de Argentina en 2026?',
    a: `$ ${fmtNum(ar.smvmMensual)} mensuales para jornada completa (${ar.fechaVigencia}), con valor hora de $ ${fmtNum(ar.smvmHora)}. Lo fija el Consejo del Salario (CNEPySMVyM) con un cronograma de aumentos; la Resolución 9/2025 cubre noviembre 2025 a agosto 2026.`,
  },
  {
    q: '¿Cuál es el salario mínimo de Brasil en 2026?',
    a: `R$ ${fmtNum(SM_BR, 'pt-BR', 2)} mensuales (Decreto 12.797/2025), un 6,79% más que los R$ 1.518 de 2025. Se reajusta cada enero por la regla de valorización (INPC + crecimiento del PBI).`,
  },
  {
    q: '¿Cuál es el salario mínimo de Perú en 2026?',
    a: `S/ ${fmtNum(PERU_2026.rmv, 'es-PE')} (Remuneración Mínima Vital, DS 006-2024-TR), vigente desde enero 2025 y mantenida en 2026. Los trabajadores con hijos menores suman la asignación familiar de S/ ${fmtNum(PERU_2026.asignacionFamiliar, 'es-PE')} (10% de la RMV).`,
  },
  {
    q: '¿Cuál es el salario mínimo de Ecuador en 2026?',
    a: `US$ ${fmtNum(ECUADOR_2026.sbu)} (Salario Básico Unificado fijado por el Ministerio del Trabajo). Ecuador está dolarizado, así que es el único de la tabla expresado directamente en dólares. Además, el décimo cuarto sueldo equivale a 1 SBU.`,
  },
  {
    q: '¿Qué país de la tabla tiene el salario mínimo más alto?',
    a: 'No se puede responder comparando los números directamente: cada país está en su moneda (peso argentino, peso mexicano, peso colombiano, real, sol, guaraní, peso uruguayo y dólar) con poderes de compra distintos. Para compararlos hay que convertirlos a una moneda común al tipo de cambio del día — podés hacerlo con nuestro conversor de monedas — y aun así la comparación omite el costo de vida local.',
  },
  {
    q: '¿Por qué no está la tabla en dólares?',
    a: 'Porque el tipo de cambio cambia todos los días (y en Argentina, según el dólar que uses). Publicar una conversión fija dejaría la tabla desactualizada en una semana. Los valores en moneda local con su norma legal son el dato estable y citable; la conversión la hacés al día con el conversor.',
  },
  {
    q: '¿Cuál es el salario mínimo de Chile en 2026?',
    a: `$ ${fmtNum(CHILE_2026.imm, 'es-CL')} mensuales (Ingreso Mínimo Mensual, Ley 21.830) desde mayo 2026. De enero a abril rigió $ ${fmtNum(CHILE_2026.immHistoricoEneAbr2026, 'es-CL')} (Ley 21.751). Chile tiene además montos diferenciados: $ ${fmtNum(CHILE_2026.immMenores18Mayores65, 'es-CL')} para menores de 18 y mayores de 65 años, y $ ${fmtNum(CHILE_2026.immNoRemuneracional, 'es-CL')} para fines no remuneracionales.`,
  },
  {
    q: '¿Cuál es el salario mínimo de Colombia en 2026?',
    a: `$ ${fmtNum(COLOMBIA_2026.smlmv, 'es-CO')} COP mensuales (SMLMV). A eso se le suma el auxilio de transporte, que se paga a quien gana hasta 2 salarios mínimos y no es salario a todos los efectos, pero sí entra en la base de prestaciones sociales.`,
  },
  {
    q: '¿Por qué Venezuela aparece con un valor tan bajo?',
    a: `Porque el salario mínimo legal venezolano (Bs. ${fmtNum(VENEZUELA_2026.salarioMinimoVes, 'es-VE')} según la LOTTT) no se ajusta desde marzo de 2022 y hoy es prácticamente nominal. El ingreso real de un trabajador llega por el cestaticket (US$ ${fmtNum(VENEZUELA_2026.cestaticketUsd)} indexado a la tasa BCV) y bonos de guerra económica que, por definición legal, no son salario y no computan para prestaciones, vacaciones ni utilidades. Publicamos el valor legal porque es la base de cálculo de los pasivos laborales, no porque describa lo que alguien cobra.`,
  },
  {
    q: '¿Por qué República Dominicana tiene varios salarios mínimos?',
    a: `Porque no existe un mínimo único: el Comité Nacional de Salarios (CNS) lo fija por sector y por tamaño de empresa. En el sector privado no sectorizado va de RD$ ${fmtNum(REPUBLICA_DOMINICANA_2026.salarioMinimo.noSectorizado.micro, 'es-DO', 2)} (microempresa) a RD$ ${fmtNum(REPUBLICA_DOMINICANA_2026.salarioMinimo.noSectorizado.grande, 'es-DO', 2)} (empresa grande), y hay resoluciones aparte para zonas francas y hotelería. La tabla muestra el de empresa grande como referencia.`,
  },
  {
    q: '¿Por qué no aparece mi país?',
    a: 'La tabla incluye los países para los que consolidamos una fuente única verificada (norma y valor oficial). Sumamos el resto a medida que verificamos su fuente con el mismo estándar; preferimos una tabla exacta antes que completa con valores sin verificar.',
  },
  {
    q: '¿Cada cuánto cambian estos valores?',
    a: 'Argentina: por resolución del Consejo del Salario, con cronogramas de aumentos en el año (el valor de la tabla es el del mes de vigencia indicado). Brasil: cada enero. Perú: por decreto supremo, sin fecha fija (la RMV actual rige desde 2025). Ecuador: cada enero.',
  },
  {
    q: '¿Puedo usar esta tabla en mi web, nota o trabajo?',
    a: 'Sí. Los datos se publican bajo licencia Creative Commons CC-BY 4.0: podés reproducirlos libremente citando la fuente con un enlace a hacecuentas.com. Más abajo está el bloque "Cómo citar".',
  },
];

const datasetSchema = {
  '@type': 'Dataset',
  '@id': `${PAGE_URL}#dataset`,
  name: 'Salario mínimo en América Latina 2026 — Argentina, México, Colombia, Chile, Brasil, Perú, Paraguay, Uruguay, Ecuador, República Dominicana y Venezuela',
  description:
    'Tabla comparativa del salario mínimo legal 2026 en moneda local, con instrumento legal, norma y vigencia por país: SMVM (Argentina), Salario Mínimo General (México), SMLMV (Colombia), IMM (Chile), salário mínimo (Brasil), RMV (Perú), SMVM (Paraguay), SMN (Uruguay), SBU (Ecuador), salario mínimo por sector del CNS (República Dominicana) y mínimo LOTTT (Venezuela). Fuentes oficiales de cada país.',
  url: PAGE_URL,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  inLanguage: 'es-419',
  dateModified: ULTIMA_REVISION,
  temporalCoverage: '2026',
  spatialCoverage: PAISES.map((p) => ({ '@type': 'Place', name: p.pais })),
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  keywords: ['Salario mínimo', 'salario mínimo 2026', 'sueldo mínimo', 'SMVM', 'SMLMV', 'IMM', 'Salário mínimo', 'RMV', 'SBU', 'América Latina', 'LATAM', '2026'],
  variableMeasured: [
    'Salario mínimo mensual (moneda local)', 'Norma legal vigente', 'Fecha de vigencia',
  ],
  identifier: 'https://hacecuentas.com/datos/salario-minimo-latam-2026.json',
  version: '2026',
  distribution: [
    { '@type': 'DataDownload', name: 'Salario mínimo LATAM 2026 (JSON)', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datos/salario-minimo-latam-2026.json' },
    { '@type': 'DataDownload', name: 'Salario mínimo LATAM 2026 (CSV)', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datos/salario-minimo-latam-2026.csv' },
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${PAGE_URL}#webpage`,
      name: title,
      description,
      url: PAGE_URL,
      inLanguage: 'es-419',
      dateModified: ULTIMA_REVISION,
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
      mainEntity: { '@id': `${PAGE_URL}#dataset` },
    },
    datasetSchema,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Salario mínimo LATAM 2026', item: PAGE_URL },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout image="/og/data-datos-salario-minimo-latam-2026.jpg" imageWidth={1200} imageHeight={675}
  title={title}
  description={description}
  canonical="/datos-salario-minimo-latam-2026"
  audience="global"
  schema={schema}
  domain="data"
>
  <Header slot="header" />

  <main class="article-main">
    <article class="page-content datos-page">
      <header class="article-header">
        <nav class="crumbs" aria-label="Migas de pan">
          <a href="/">Inicio</a> <span>›</span> <span>Salario mínimo LATAM 2026</span>
        </nav>
        <h1>Salario mínimo 2026: cuánto es en cada país de LATAM</h1>
        <p class="lede">
          El salario mínimo legal vigente en 2026 en <strong>Argentina, México, Colombia, Chile,
          Brasil, Perú, Paraguay, Uruguay, Ecuador, República Dominicana y Venezuela</strong>, en
          moneda local y con la norma que lo fija. Cada valor sale de la fuente oficial de su país
          y es el mismo que usan las calculadoras de sueldo de este sitio.
        </p>
        <p class="updated">
          Última revisión: <time datetime={ULTIMA_REVISION}>{new Date(ULTIMA_REVISION).toLocaleDateString('es-AR')}</time> ·
          Licencia <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC-BY 4.0</a> (uso libre con atribución)
        </p>
      </header>

      <p class="answer-snippet">
        <strong>Salario mínimo 2026:</strong> Argentina <strong>$ {fmtNum(ar.smvmMensual)}</strong> ARS ·
        Brasil <strong>R$ {fmtNum(SM_BR, 'pt-BR')}</strong> BRL ·
        Perú <strong>S/ {fmtNum(PERU_2026.rmv, 'es-PE')}</strong> PEN ·
        Ecuador <strong>US$ {fmtNum(ECUADOR_2026.sbu)}</strong> USD.
        Cada valor en moneda local, con la norma oficial que lo fija (tabla abajo).
      </p>

      <section class="stats-callout" aria-label="Datos destacados">
        <div class="stat">
          <span class="stat-num">$ {fmtNum(ar.smvmMensual)}</span>
          <span class="stat-label">🇦🇷 SMVM Argentina (ARS)</span>
        </div>
        <div class="stat">
