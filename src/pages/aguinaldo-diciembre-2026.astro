---
// Segunda cuota del SAC 2026. Reemplaza a /aguinaldo-junio-2026 (301 en public/_redirects).
// Deadline legal: 18-dic-2026 (Ley 27.073) + 4 días hábiles de tolerancia → 24-dic-2026.
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import ActionCard from '../components/ui/ActionCard.astro';

const title = 'Aguinaldo Diciembre 2026: cuándo cobro, cómo calcularlo y montos | Hacé Cuentas';
const description = 'Todo sobre el aguinaldo de diciembre 2026 en Argentina: fecha límite de pago (18/12), fórmula del SAC, tabla con ejemplos por sueldo, descuentos y qué hacer si no te pagan.';

const siteUrl = 'https://hacecuentas.com';

const ejemplos = [
  { sueldo: 400000, aguinaldoBruto: 200000, jubilacion: 22000, obraSocial: 6000, pami: 6000, neto: 166000 },
  { sueldo: 600000, aguinaldoBruto: 300000, jubilacion: 33000, obraSocial: 9000, pami: 9000, neto: 249000 },
  { sueldo: 800000, aguinaldoBruto: 400000, jubilacion: 44000, obraSocial: 12000, pami: 12000, neto: 332000 },
  { sueldo: 1000000, aguinaldoBruto: 500000, jubilacion: 55000, obraSocial: 15000, pami: 15000, neto: 415000 },
  { sueldo: 1500000, aguinaldoBruto: 750000, jubilacion: 82500, obraSocial: 22500, pami: 22500, neto: 622500 },
  { sueldo: 2000000, aguinaldoBruto: 1000000, jubilacion: 110000, obraSocial: 30000, pami: 30000, neto: 830000 },
];

const fmtAr = (n: number) => new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(n);

// Countdown al 18-dic-2026 calculado en build (deploy diario → queda fresco en el HTML
// estático) + re-cálculo client-side como enhancement.
const DEADLINE_ISO = '2026-12-18';
const hoyAR = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Argentina/Buenos_Aires' }));
hoyAR.setHours(0, 0, 0, 0);
const deadline = new Date(2026, 11, 18);
const diasFaltan = Math.max(0, Math.round((deadline.getTime() - hoyAR.getTime()) / 86400000));

const faqItems = [
  {
    q: '¿Cuándo se cobra el aguinaldo de diciembre 2026?',
    a: 'La fecha límite legal es el 18 de diciembre de 2026 (Ley 27.073). El empleador tiene hasta 4 días hábiles posteriores para acreditarlo, es decir, hasta el 24 de diciembre de 2026. Si para esa fecha no lo depositó, está incumpliendo la ley.'
  },
  {
    q: '¿Cómo se calcula el aguinaldo de diciembre 2026?',
    a: 'Se toma la mejor remuneración bruta mensual del segundo semestre (julio a diciembre 2026), se divide por 2, y si no trabajaste los 6 meses completos, se multiplica por los meses trabajados dividido 6. La fórmula es: Aguinaldo = (Mejor sueldo del semestre / 2) x (meses trabajados / 6).'
  },
  {
    q: '¿El aguinaldo de junio cuenta para calcular el de diciembre?',
    a: 'No. El SAC no se computa a sí mismo: para el aguinaldo de diciembre se compara la remuneración mensual habitual de julio a diciembre (sueldo, horas extra, comisiones), sin sumar el aguinaldo cobrado en junio ni conceptos no remunerativos.'
  },
  {
    q: '¿El aguinaldo incluye horas extra y comisiones?',
    a: 'Sí. Para calcular el aguinaldo se toma la mayor remuneración mensual devengada, que incluye todos los conceptos remunerativos: sueldo básico, horas extra, comisiones, presentismo, plus por antigüedad y premios habituales. No incluye asignaciones familiares ni viáticos sin rendición.'
  },
  {
    q: '¿Qué descuentos tiene el aguinaldo?',
    a: 'Al aguinaldo se le aplican los mismos descuentos que al sueldo: 11% de jubilación (SIPA), 3% de obra social, 3% de PAMI (Ley 19.032) y el aporte sindical si corresponde. En total, aproximadamente un 17-19% de descuentos. Además, puede estar alcanzado por el Impuesto a las Ganancias si tu remuneración supera el mínimo no imponible.'
  },
  {
    q: '¿Me corresponde aguinaldo si empecé a trabajar en octubre 2026?',
    a: 'Sí, te corresponde un aguinaldo proporcional. Si empezaste en octubre y trabajaste hasta diciembre (3 meses), tu aguinaldo será: (Mejor sueldo / 2) x (3/6) = un cuarto de tu mejor sueldo bruto del período. El derecho al aguinaldo nace desde el primer día de trabajo.'
  },
  {
    q: '¿El aguinaldo paga Impuesto a las Ganancias?',
    a: 'Sí. El SAC está alcanzado por el Impuesto a las Ganancias de cuarta categoría. En diciembre, al sumarse el aguinaldo a la remuneración habitual, la retención puede ser significativamente mayor. Algunos empleadores distribuyen el impacto a lo largo del año para evitar un golpe concentrado en junio y diciembre.'
  },
  {
    q: '¿Qué pasa si mi empleador no me paga el aguinaldo a tiempo?',
    a: 'Si tu empleador no paga el aguinaldo dentro de los plazos legales (18 de diciembre + 4 días hábiles), podés intimar por escrito (carta documento o telegrama laboral gratuito) exigiendo el pago con intereses. Si no responde, podés hacer una denuncia en el Ministerio de Trabajo o iniciar acciones legales con un abogado laboralista. Los intereses se calculan desde la fecha en que debió pagarse.'
  },
  {
    q: '¿Me corresponde aguinaldo si estoy en período de prueba?',
    a: 'Sí. El período de prueba no exime al empleador de ninguna obligación salarial. Te corresponde aguinaldo proporcional a los días trabajados. Si te despiden durante la prueba, el SAC proporcional debe incluirse en la liquidación final.'
  },
  {
    q: '¿Cómo verifico que mi aguinaldo está bien calculado?',
    a: 'Revisá tus recibos de sueldo de julio a diciembre 2026, identificá el mes con mayor remuneración bruta (incluyendo horas extra y comisiones), dividilo por 2, y si no trabajaste los 6 meses, multiplicá por la proporción de meses. Compará ese resultado con el concepto "SAC" en tu recibo de diciembre. Si hay diferencia, reclamá por escrito a RRHH.'
  },
  {
    q: '¿El aguinaldo se calcula sobre el sueldo bruto o el neto?',
    a: 'Siempre se calcula sobre el sueldo bruto (remuneración devengada). Después, al monto del aguinaldo bruto se le aplican los descuentos de ley (jubilación, obra social, PAMI). El resultado es el aguinaldo neto o "en mano".'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/aguinaldo-diciembre-2026`,
      url: `${siteUrl}/aguinaldo-diciembre-2026`,
      name: title,
      description: description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      inLanguage: 'es-AR',
      datePublished: '2026-07-11',
      dateModified: '2026-07-11',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Finanzas', item: `${siteUrl}/categoria/finanzas` },
        { '@type': 'ListItem', position: 3, name: 'Aguinaldo Diciembre 2026' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
};
---
<Layout title={title} description={description} schema={schema} audience="AR">
  <Header slot="header" />

  <article class="landing">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/categoria/finanzas">Finanzas</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Aguinaldo Diciembre 2026</span>
    </nav>

    <!-- HERO -->
    <header class="hero">
      <h1>Aguinaldo Diciembre 2026: cuándo se cobra, cómo calcularlo y tabla de montos</h1>
      <p class="lead">
        El segundo aguinaldo del año (SAC - Sueldo Anual Complementario) tiene como <strong>fecha límite de pago el 18 de diciembre de 2026</strong> (Ley 27.073), con una tolerancia máxima de 4 días hábiles.
        Acá te explicamos la fórmula, los descuentos que se aplican, ejemplos con distintos sueldos y qué hacer si tu empleador se atrasa.
      </p>
      <div class="hero-meta">
        <span>Actualizado: julio 2026</span>
        <span>Aplica a: trabajadores en relación de dependencia en Argentina</span>
      </div>
      {diasFaltan > 0 && (
        <p class="countdown" data-countdown data-deadline={DEADLINE_ISO}>
          ⏳ Faltan <strong data-countdown-days>{diasFaltan}</strong> días para el 18 de diciembre de 2026.
        </p>
      )}
    </header>

    <!-- FECHAS CLAVE -->
    <section class="section">
      <h2>Fechas clave del aguinaldo diciembre 2026</h2>
      <div class="dates-grid">
        <div class="date-card">
          <div class="date-label">Período que cubre</div>
          <div class="date-value">Julio - Diciembre 2026</div>
          <div class="date-hint">Segundo semestre del año</div>
        </div>
        <div class="date-card accent">
          <div class="date-label">Fecha límite de pago</div>
          <div class="date-value">18 de diciembre 2026</div>
          <div class="date-hint">+ 4 días hábiles de tolerancia</div>
        </div>
        <div class="date-card">
          <div class="date-label">Tolerancia máxima</div>
          <div class="date-value">24 de diciembre 2026</div>
          <div class="date-hint">Después de esa fecha es incumplimiento</div>
        </div>
      </div>
      <p class="section-note">
        A diferencia de la primera cuota (que vence el 30 de junio), la segunda cuota del SAC vence el <strong>18 de diciembre</strong> por la Ley 27.073, para que el pago llegue antes de las fiestas.
      </p>
    </section>

    <!-- FÓRMULA -->
    <section class="section">
      <h2>Fórmula del aguinaldo (SAC)</h2>
      <div class="formula-box">
        <div class="formula">
          <code>Aguinaldo = (Mejor sueldo bruto del semestre / 2) &times; (meses trabajados / 6)</code>
        </div>
        <p class="formula-note">
          Se toma la <strong>mayor remuneración mensual devengada</strong> del semestre julio-diciembre 2026. Incluye sueldo básico, horas extra, comisiones, presentismo y todo concepto remunerativo (el aguinaldo de junio NO se computa). Si trabajaste los 6 meses completos, el factor (meses/6) es 1 y no afecta el cálculo.
        </p>
      </div>

      <h3>Ejemplo rápido</h3>
      <p>
        Si tu mejor sueldo bruto del semestre fue de <strong>$800.000</strong> y trabajaste los 6 meses completos:
      </p>
      <ul class="example-steps">
        <li>Aguinaldo bruto = $800.000 / 2 = <strong>$400.000</strong></li>
        <li>Descuento jubilación (11%) = $44.000</li>
        <li>Descuento obra social (3%) = $12.000</li>
        <li>Descuento PAMI (3%) = $12.000</li>
        <li>Aguinaldo neto (en mano) = <strong>$332.000</strong></li>
      </ul>
    </section>

    <!-- CTA CALCULADORA -->
    <div class="cta-box">
      <h3>Calculá tu aguinaldo exacto ahora</h3>
      <p>Ingresá tu mejor sueldo, los meses trabajados y obtené el resultado con descuentos incluidos.</p>
      <a href="/calculadora-aguinaldo-sac" class="cta-btn">Ir a la calculadora de aguinaldo</a>
    </div>

    <!-- TABLA DE EJEMPLOS -->
    <section class="section">
      <h2>Tabla: aguinaldo diciembre 2026 según tu sueldo</h2>
      <p>
        Ejemplos para trabajadores que cumplieron el semestre completo (julio a diciembre 2026).
        Los descuentos incluyen jubilación (11%), obra social (3%) y PAMI (3%) = 17% total.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Mejor sueldo bruto</th>
              <th>Aguinaldo bruto</th>
              <th>Jubilación (11%)</th>
              <th>Obra social (3%)</th>
              <th>PAMI (3%)</th>
              <th>Aguinaldo neto</th>
            </tr>
          </thead>
          <tbody>
            {ejemplos.map((e) => (
              <tr>
                <td>{fmtAr(e.sueldo)}</td>
                <td>{fmtAr(e.aguinaldoBruto)}</td>
                <td>{fmtAr(e.jubilacion)}</td>
                <td>{fmtAr(e.obraSocial)}</td>
                <td>{fmtAr(e.pami)}</td>
                <td class="highlight">{fmtAr(e.neto)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        <strong>Nota:</strong> estos montos no incluyen el aporte sindical (varía según gremio, típicamente 2-3%) ni la retención de Impuesto a las Ganancias (aplica si tu remuneración supera el mínimo no imponible). Usá la <a href="/calculadora-aguinaldo-sac">calculadora de aguinaldo</a> para un cálculo personalizado.
      </p>
    </section>

    <!-- DESCUENTOS -->
    <section class="section">
      <h2>Descuentos del aguinaldo: qué te retienen</h2>
      <p>Al aguinaldo se le aplican exactamente los mismos descuentos que al sueldo mensual. Los aportes obligatorios del trabajador son:</p>
      <div class="descuentos-grid">
        <div class="descuento-card">
          <div class="descuento-pct">11%</div>
          <div class="descuento-name">Jubilación (SIPA)</div>
          <div class="descuento-detail">Aporte al Sistema Integrado Previsional Argentino. Es el descuento más grande y financia las jubilaciones.</div>
        </div>
        <div class="descuento-card">
          <div class="descuento-pct">3%</div>
          <div class="descuento-name">Obra Social</div>
          <div class="descuento-detail">Aporte obligatorio a la obra social sindical. Podés derivarlo a una prepaga si lo deseás (aportar + diferencia).</div>
        </div>
        <div class="descuento-card">
          <div class="descuento-pct">3%</div>
          <div class="descuento-name">PAMI (Ley 19.032)</div>
          <div class="descuento-detail">Aporte al INSSJP (PAMI). Es obligatorio para todos los trabajadores en relación de dependencia, sin importar la edad.</div>
        </div>
        <div class="descuento-card warning">
          <div class="descuento-pct">Variable</div>
          <div class="descuento-name">Impuesto a las Ganancias</div>
          <div class="descuento-detail">Aplica si tu remuneración bruta supera el mínimo no imponible. En diciembre, al sumarse el aguinaldo, la retención puede ser mayor. Usá la <a href="/calculadora-ganancias-empleados-4ta-categoria-2026">calculadora de Ganancias</a> para estimar el impacto.</div>
        </div>
      </div>
    </section>

    <!-- QUÉ PASA SI NO PAGAN -->
    <section class="section">
      <h2>Si tu empleador no paga el aguinaldo a tiempo</h2>
      <p>
        La ley establece que la segunda cuota del aguinaldo debe pagarse antes del 18 de diciembre (con un máximo de 4 días hábiles de tolerancia). Si tu empleador no cumple, tenés varias opciones:
      </p>
      <div class="steps-list">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-content">
            <h4>Intimación por escrito</h4>
            <p>Enviá un telegrama laboral gratuito (en cualquier oficina del Correo Argentino, sin costo para el trabajador) o una carta documento intimando al pago del SAC con intereses. Esto deja constancia legal de tu reclamo.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <div class="step-content">
            <h4>Denuncia en el Ministerio de Trabajo</h4>
            <p>Podés hacer una denuncia online o presencial en la delegación del Ministerio de Trabajo de tu jurisdicción. El Ministerio citará al empleador a una audiencia de conciliación.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <div class="step-content">
            <h4>Acción judicial</h4>
            <p>Si la conciliación no prospera, podés iniciar una demanda laboral con un abogado laboralista. El empleador deberá pagar el aguinaldo adeudado más intereses (generalmente tasa activa del Banco Nación) desde la fecha en que debió pagarse.</p>
          </div>
        </div>
      </div>
      <p class="legal-note">
        <strong>Importante:</strong> el no pago del aguinaldo puede constituir una injuria laboral grave que habilita al trabajador a considerarse despedido (despido indirecto) con derecho a indemnización completa. Sin embargo, siempre es recomendable agotar las vías de conciliación antes de tomar medidas drásticas. Consultá con un abogado laboralista antes de intimar despido indirecto.
      </p>
    </section>

    <!-- LINKS RELACIONADOS -->
    <section class="section">
      <h2>Calculadoras relacionadas</h2>
      <div class="link-grid">
        <ActionCard href="/calculadora-aguinaldo-sac" title="Calculadora de Aguinaldo (SAC)" desc="Calculá tu aguinaldo bruto y neto con descuentos" icon='<rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>' />
        <ActionCard href="/calculadora-cuanto-falta-aguinaldo-junio-diciembre" title="¿Cuánto falta para el aguinaldo?" desc="Cuenta regresiva al 18 de diciembre" icon='<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' />
        <ActionCard href="/sueldo-en-mano-argentina" title="Sueldo en Mano" desc="De bruto a neto con todos los descuentos" icon='<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>' />
        <ActionCard href="/calculadora-ganancias-empleados-4ta-categoria-2026" title="Impuesto a las Ganancias" desc="Estimá la retención de 4ta categoría sobre tu sueldo" icon='<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>' />
        <ActionCard href="/calculadora-indemnizacion-despido" title="Indemnización por Despido" desc="Incluye SAC proporcional en la liquidación final" icon='<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>' />
        <ActionCard href="/datos-aguinaldo-2026" title="Datos del aguinaldo 2026" desc="Tabla de referencia: fechas legales, fórmula, tope y ejemplos (CC-BY)" icon='<line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/>' />
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq-section">
      <h2>Preguntas frecuentes sobre el aguinaldo diciembre 2026</h2>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <Newsletter />
  </article>

  <Footer slot="footer" />
</Layout>

<script>
  // Enhancement: recalcular el countdown del lado del cliente (el valor de build
  // ya viene en el HTML estático; esto sólo lo afina si el HTML quedó cacheado).
  (function () {
    const el = document.querySelector('[data-countdown]') as HTMLElement | null;
    if (!el) return;
    const daysEl = el.querySelector('[data-countdown-days]');
    const iso = el.dataset.deadline;
    if (!daysEl || !iso) return;
    const [y, m, d] = iso.split('-').map(Number);
    const deadline = new Date(y, m - 1, d);
    const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
    const dias = Math.round((deadline.getTime() - hoy.getTime()) / 86400000);
    if (dias > 0) {
      daysEl.textContent = String(dias);
    } else if (dias === 0) {
      el.innerHTML = '📅 <strong>Hoy, 18 de diciembre, es la fecha límite legal de pago del aguinaldo.</strong>';
    } else {
      el.innerHTML = '📅 La fecha límite legal (18 de diciembre) ya pasó. Tu empleador tenía hasta 4 días hábiles de tolerancia (24 de diciembre): si no lo cobraste, mirá abajo cómo reclamar.';
    }
  })();
</script>

<style>
  .landing { max-width: 860px; margin: 0 auto; padding: 0 0 3rem; }
  .breadcrumbs { font-size: 0.875rem; color: var(--text-subtle); margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .breadcrumbs a { color: var(--text-muted); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }
  .breadcrumbs .sep { color: var(--border-strong); }

  .hero { margin-bottom: 2.5rem; }
  .hero h1 { margin-bottom: 1rem; }
  .lead { font-size: 1.0625rem; color: var(--text-muted); margin-bottom: 1rem; max-width: 760px; line-height: 1.65; }
  .hero-meta { display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.8125rem; color: var(--text-subtle); }
  .countdown {
    font-size: 0.9375rem; font-weight: 500; background: var(--bg-soft); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 0.625rem 0.875rem; margin-top: 1rem; color: var(--text-muted); max-width: 760px;
  }

  .section { margin-bottom: 2.5rem; }
  .section h2 { margin-bottom: 0.75rem; }
  .section h3 { margin: 1.25rem 0 0.5rem; font-size: 1.125rem; }
  .section p { margin-bottom: 0.75rem; color: var(--text-muted); line-height: 1.65; }
  .section-note { font-size: 0.875rem; color: var(--text-subtle); margin-top: 0.75rem; }

  /* Dates grid */
