---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  { value: 'finanzas', label: 'Finanzas' },
  { value: 'salud', label: 'Salud' },
  { value: 'deportes', label: 'Deportes' },
  { value: 'familia', label: 'Familia' },
  { value: 'cocina', label: 'Cocina' },
  { value: 'construccion', label: 'Construcción' },
  { value: 'automotor', label: 'Automotor' },
  { value: 'mascotas', label: 'Mascotas' },
  { value: 'matematicas', label: 'Matemáticas' },
  { value: 'ciencia', label: 'Ciencia' },
  { value: 'idiomas', label: 'Idiomas' },
  { value: 'entretenimiento', label: 'Entretenimiento' },
  { value: 'vida', label: 'Vida' },
  { value: 'negocios', label: 'Negocios' },
  { value: 'tecnologia', label: 'Tecnología' },
  { value: 'otros', label: 'Otros' },
];
---

<Layout
  noAds={true}
  title="Sugerí una calculadora nueva — Hacé Cuentas"
  description="¿Hay una calculadora que te falta? Proponé tu idea y la comunidad la vota. Si gana tracción, la construimos. 100% gratis, sin registro."
>
  <Header slot="header" />

  <article class="legal">
    <header class="suggest-hero">
      <div>
        <p class="eyebrow">✦ Construimos con la comunidad</p>
        <h1>Sugerí una calculadora nueva</h1>
        <p class="intro">
          ¿Hay un cálculo que no encontrás? Contanos qué necesitás.
          Otros usuarios votan tu idea y las más útiles pasan al roadmap.
        </p>
        <div class="hero-trust" aria-label="Cómo funciona">
          <span>✓ Sin registro</span><span>✓ Revisión humana</span><span>✓ Votación pública</span>
        </div>
      </div>
      <aside class="hero-card" aria-label="Tu aporte">
        <span class="hero-card-icon" aria-hidden="true">💡</span>
        <strong>Una buena idea se convierte en una herramienta para todos.</strong>
        <span>Te lleva menos de 2 minutos.</span>
      </aside>
    </header>

    <form id="hc-suggest-form" class="suggest-form" novalidate>
      <div class="form-heading">
        <span class="step">01</span>
        <div><h2>Contanos tu idea</h2><p>Con estos datos podemos evaluar si ya existe y cómo construirla.</p></div>
      </div>
      <div class="form-row">
        <label for="sg-title">Título de la calculadora <span class="req">*</span></label>
        <input
          type="text"
          id="sg-title"
          name="title"
          required
          minlength="6"
          maxlength="120"
          placeholder="Ej: Calculadora de propina por país"
          autocomplete="off"
        />
        <small class="hint">Mínimo 6 caracteres. Sé específico.</small>
      </div>

      <div class="form-row">
        <label for="sg-desc">¿Qué calcula? <span class="req">*</span></label>
        <textarea
          id="sg-desc"
          name="description"
          rows="5"
          required
          minlength="20"
          maxlength="1000"
          placeholder="Contanos qué inputs tendría, qué devuelve, y para qué la usarías. Ej: ingresar monto de la cuenta y país, devuelve propina sugerida según costumbre local."></textarea>
        <small class="hint">Entre 20 y 1000 caracteres.</small>
      </div>

      <div class="form-row">
        <label for="sg-cat">Categoría <span class="req">*</span></label>
        <select id="sg-cat" name="category" required>
          <option value="">— Elegí una —</option>
          {categories.map((c) => <option value={c.value}>{c.label}</option>)}
        </select>
      </div>

      <div class="form-row">
        <label for="sg-email">Email (opcional)</label>
        <input
          type="email"
          id="sg-email"
          name="email"
          maxlength="254"
          placeholder="tu@email.com"
          autocomplete="email"
        />
        <small class="hint">Si la construimos, te avisamos. No spam.</small>
      </div>

      <!-- Honeypot anti-spam: oculto via CSS, los bots lo llenan. -->
      <div class="hp-field" aria-hidden="true">
        <label for="sg-website">Tu web (no completes esto)</label>
        <input type="text" id="sg-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="sg-submit" id="sg-submit-btn">
        Enviar sugerencia
      </button>
      <p class="sg-msg" id="sg-msg" role="status" aria-live="polite"></p>
    </form>

    <aside class="suggest-aside">
      <div class="how-card">
        <p class="aside-kicker">Qué pasa después</p>
        <h2>De idea a calculadora</h2>
        <ol class="how-it-works">
          <li><strong>Proponés</strong><span>Contanos la cuenta que necesitás.</span></li>
          <li><strong>Revisamos</strong><span>Chequeamos factibilidad y duplicados.</span></li>
          <li><strong>Priorizamos</strong><span>Evaluamos cuánto puede ayudar y a cuántas personas.</span></li>
          <li><strong>Construimos</strong><span>Publicamos primero las ideas más útiles.</span></li>
        </ol>
      </div>
    </aside>
  </article>

  <script is:inline>
    (function () {
      var f = document.getElementById('hc-suggest-form');
      if (!f) return;
      var btn = document.getElementById('sg-submit-btn');
      var msg = document.getElementById('sg-msg');

      function setMsg(text, kind) {
        msg.textContent = text || '';
        msg.className = 'sg-msg' + (kind ? ' sg-msg-' + kind : '');
      }

      f.addEventListener('submit', function (e) {
        e.preventDefault();
        var title = f.title.value.trim();
        var desc = f.description.value.trim();
        var cat = f.category.value;
        var email = f.email.value.trim();
        var hp = f.website.value;

        if (title.length < 6) { setMsg('El título es muy corto.', 'err'); return; }
        if (desc.length < 20) { setMsg('La descripción es muy corta.', 'err'); return; }
        if (!cat) { setMsg('Elegí una categoría.', 'err'); return; }

        btn.disabled = true;
        setMsg('Enviando…', '');

        fetch('/api/suggestions', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title: title, description: desc, category: cat, email: email, website: hp }),
        })
          .then(function (r) { return r.json().then(function (j) { return { status: r.status, body: j }; }); })
          .then(function (res) {
            if (res.status >= 200 && res.status < 300 && res.body && res.body.ok) {
              setMsg('¡Gracias! Tu sugerencia fue enviada. Aparecerá en la lista pública una vez aprobada.', 'ok');
              f.reset();
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'suggestion_submit', { category: cat });
              }
            } else {
              setMsg((res.body && res.body.error) || 'Error inesperado. Probá de nuevo.', 'err');
            }
          })
          .catch(function () { setMsg('No pudimos conectarnos. Probá en un rato.', 'err'); })
          .finally(function () { btn.disabled = false; });
      });
    })();
  </script>

  <Footer slot="footer" />
</Layout>

<style>
  .legal { max-width: 1120px; margin: 0 auto; padding: 2rem 1.25rem 4.5rem; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(270px, .65fr); gap: 2rem; }
  .suggest-hero { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 2rem; align-items: end; padding: 2.75rem; border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border)); border-radius: 1.5rem; background: linear-gradient(125deg, color-mix(in srgb, var(--accent) 10%, var(--bg-card)), var(--bg-card) 65%); }
  .eyebrow, .aside-kicker { margin: 0 0 .55rem; color: var(--accent); font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .legal h1 { margin: 0 0 .8rem; color: var(--text); font-size: clamp(2.2rem, 5vw, 3.65rem); line-height: 1.03; letter-spacing: -.055em; }
  .intro { max-width: 680px; color: var(--text-muted); font-size: 1.08rem; margin: 0; line-height: 1.6; }
  .hero-trust { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; margin-top: 1.35rem; color: var(--text-muted); font-size: .84rem; font-weight: 600; }
  .hero-trust span::first-letter { color: #059669; }
  .hero-card { display: flex; flex-direction: column; gap: .6rem; padding: 1.35rem; border-radius: 1rem; color: #eef2ff; background: #111a33; box-shadow: 0 15px 30px rgba(15, 23, 42, .12); }
  .hero-card-icon { font-size: 1.6rem; }
  .hero-card strong { font-size: 1.02rem; line-height: 1.35; }
  .hero-card span:last-child { color: #b8c5e0; font-size: .85rem; }
  .legal h2 { color: var(--text); }
  .legal p { color: var(--text-muted); line-height: 1.6; }
  .legal a { color: var(--accent); }

  .suggest-form {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    box-shadow: 0 12px 32px rgba(15, 23, 42, .04);
  }
  .form-heading { display: flex; gap: .85rem; align-items: flex-start; padding-bottom: .5rem; }
  .step { display: grid; place-items: center; flex: 0 0 2rem; width: 2rem; height: 2rem; border-radius: 50%; background: var(--accent); color: #fff; font-family: 'JetBrains Mono', monospace; font-size: .7rem; font-weight: 700; }
  .form-heading h2 { margin: 0; font-size: 1.18rem; }
  .form-heading p { margin: .2rem 0 0; font-size: .87rem; }
  .form-row { display: flex; flex-direction: column; gap: 0.375rem; }
  .form-row label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
  }
  .req { color: var(--accent); }
  .form-row input,
  .form-row select,
  .form-row textarea {
    padding: .74rem .82rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
    font-size: 0.9375rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .form-row input:focus,
  .form-row select:focus,
  .form-row textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .form-row textarea { resize: vertical; min-height: 110px; }
  .hint { font-size: 0.75rem; color: var(--text-subtle); }

  /* Honeypot — visible para bots, invisible para humanos y screen readers. */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .sg-submit {
    align-self: flex-start;
    padding: .78rem 1.3rem;
    background: var(--accent);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }
  .sg-submit:hover:not(:disabled) { background: var(--accent-strong); }
  .sg-submit:disabled { opacity: 0.6; cursor: wait; }

  .sg-msg { margin: 0; font-size: 0.875rem; }
  .sg-msg-ok { color: var(--success, #166534); }
  .sg-msg-err { color: var(--danger, #b91c1c); }

  .suggest-aside { display: flex; flex-direction: column; gap: 1rem; }
  .cta-listado, .how-card {
    padding: 1.35rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.1rem;
  }
  .cta-listado h2, .how-card h2 { margin: 0 0 .55rem; font-size: 1.15rem; line-height: 1.25; }
  .cta-listado p { margin: 0; font-size: .9rem; }
  .aside-link { display: inline-flex; margin-top: 1rem; font-size: .88rem; font-weight: 700; text-decoration: none; }
  .how-it-works { list-style: none; counter-reset: steps; margin: 1rem 0 0; padding: 0; display: grid; gap: .8rem; }
  .how-it-works li { counter-increment: steps; display: grid; grid-template-columns: 1.75rem 1fr; column-gap: .65rem; font-size: .86rem; }
  .how-it-works li::before { content: counter(steps); grid-row: span 2; display: grid; place-items: center; width: 1.55rem; height: 1.55rem; border-radius: 50%; color: var(--accent); background: var(--accent-soft); font-size: .7rem; font-weight: 800; }
  .how-it-works strong { color: var(--text); }
  .how-it-works span { color: var(--text-muted); font-size: .8rem; line-height: 1.4; }
  @media (max-width: 760px) { .legal { display: block; padding: 1rem 1rem 3rem; } .suggest-hero { grid-template-columns: 1fr; padding: 1.6rem; margin-bottom: 1rem; } .hero-card { display: none; } .suggest-form { padding: 1.2rem; } .suggest-aside { margin-top: 1rem; } }
</style>
