---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { freeOfferSchema } from '../lib/offer-schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Convertir Imagen a PDF Online Gratis (JPG y PNG) | Hacé Cuentas';
const description =
  'Convertí imágenes JPG, PNG y WebP a PDF online y gratis. Uní varias fotos en un solo PDF, elegí tamaño de hoja (A4, Carta) y orientación. 100% en tu navegador: tus archivos no se suben a ningún servidor. Sin registro ni marca de agua.';

const site = 'https://hacecuentas.com';

const faqs = [
  {
    q: '¿Cómo convierto una imagen a PDF?',
    a: 'Arrastrá la imagen (o varias) a la zona de carga —o tocá "Elegir imágenes"—, ordenálas si hace falta, elegí el tamaño de hoja y la orientación, y presioná <strong>Generar PDF</strong>. El archivo se arma al instante en tu navegador y se descarga solo. No hay que instalar ni registrarse.',
  },
  {
    q: '¿Puedo unir varias imágenes (JPG y PNG) en un solo PDF?',
    a: 'Sí. Podés cargar todas las fotos que quieras y se juntan en <strong>un único PDF, una imagen por página</strong>, en el orden que vos definas. Usá las flechas ▲▼ de cada miniatura para reordenar y la ✕ para descartar la que no quieras antes de generar el archivo.',
  },
  {
    q: '¿Mis archivos se suben a algún servidor?',
    a: 'No. Todo el proceso ocurre <strong>100% dentro de tu navegador</strong>: las imágenes nunca salen de tu dispositivo ni viajan a internet. Por eso funciona incluso con la conexión cortada una vez que la página cargó, y es seguro para documentos privados (DNI, recibos, facturas).',
  },
  {
    q: '¿Qué formatos de imagen puedo convertir?',
    a: 'Acepta <strong>JPG/JPEG, PNG, WebP y GIF</strong> (se toma el primer fotograma del GIF). Las imágenes con fondo transparente (PNG/WebP) se colocan sobre fondo blanco. El formato <strong>HEIC</strong> del iPhone no siempre se puede leer desde el navegador; si te da error, convertí la foto a JPG primero (compartila o guardala como "Más compatible" desde el iPhone).',
  },
  {
    q: '¿Puedo elegir el tamaño de hoja (A4, Carta) y la orientación?',
    a: 'Sí. Podés generar el PDF en <strong>A4</strong>, <strong>Carta (Letter)</strong> o <strong>ajustado al tamaño de cada imagen</strong> (sin bordes). La orientación puede ser <strong>automática</strong> (cada página se acomoda a si la foto es vertical u horizontal), o forzada a vertical u horizontal. También podés elegir con o sin margen.',
  },
  {
    q: '¿Cómo cambio el orden de las imágenes?',
    a: 'Cada imagen cargada aparece como una miniatura numerada. Usá las flechas <strong>▲ (subir)</strong> y <strong>▼ (bajar)</strong> para moverla, y la <strong>✕</strong> para quitarla. El orden de arriba hacia abajo es el orden de las páginas en el PDF final.',
  },
  {
    q: '¿Se pierde calidad al pasar la imagen a PDF?',
    a: 'La imagen se incrusta en el PDF con una compresión JPEG de alta calidad. Para que el archivo no pese de más, las fotos muy grandes se reescalan a un máximo de ~2.500 px por lado (más que suficiente para imprimir en A4). Si necesitás la resolución original exacta, elegí la calidad "Máxima" en las opciones.',
  },
  {
    q: '¿Funciona en el celular?',
    a: 'Sí. Podés cargar fotos desde la galería o sacarlas con la cámara y generar el PDF directamente en <strong>Android o iPhone</strong>, sin app. El PDF se descarga a tu teléfono y lo podés compartir por WhatsApp, mail o subirlo donde te lo pidan.',
  },
  {
    q: '¿Es gratis y sin marca de agua?',
    a: 'Sí. Es <strong>gratis, sin límite de archivos, sin registro y sin marca de agua</strong>. El PDF sale limpio, solo con tus imágenes.',
  },
  {
    q: '¿Puedo convertir un PDF a imagen, o Word a PDF, con esta herramienta?',
    a: 'Esta herramienta hace específicamente <strong>imágenes → PDF</strong> (juntar JPG/PNG/WebP en un PDF). No convierte PDF a imagen ni documentos de Word/Excel a PDF. Para esos casos necesitás otra herramienta; acá el foco está en armar un PDF a partir de tus fotos o capturas de pantalla.',
  },
];

const howToSteps = [
  { name: 'Cargá tus imágenes', text: 'Arrastrá las fotos a la zona de carga o tocá "Elegir imágenes". Podés cargar varias a la vez (JPG, PNG, WebP).' },
  { name: 'Ordenalas', text: 'Usá las flechas ▲▼ de cada miniatura para definir el orden de las páginas y la ✕ para descartar las que no van.' },
  { name: 'Elegí hoja y orientación', text: 'Seleccioná A4, Carta o "ajustar a la imagen", la orientación (auto/vertical/horizontal) y si querés margen.' },
  { name: 'Generá el PDF', text: 'Tocá "Generar PDF": el archivo se arma en tu navegador y se descarga al instante. Nada se sube a internet.' },
];

const related = [
  { href: '/calculadora-cientifica', t: 'Calculadora científica online', i: '🧮' },
  { href: '/contador-de-palabras-y-caracteres', t: 'Contador de palabras y caracteres', i: '🔤' },
  { href: '/convertir-mayusculas-minusculas', t: 'Convertir mayúsculas y minúsculas', i: '🔠' },
  { href: '/generador-de-contrasenas-seguras', t: 'Generador de contraseñas seguras', i: '🔐' },
  { href: '/conversor-pulgadas-a-centimetros', t: 'Conversor de pulgadas a centímetros', i: '📏' },
  { href: '/generador-de-numeros-aleatorios', t: 'Generador de números aleatorios', i: '🎲' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Convertir imagen a PDF',
  url: `${site}/convertir-imagen-a-pdf`,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  inLanguage: 'es',
  isAccessibleForFree: true,
  offers: freeOfferSchema({ priceCurrency: 'ARS' }),
  featureList: [
    'Convertir JPG, PNG y WebP a PDF',
    'Unir varias imágenes en un solo PDF',
    'Tamaño de hoja A4, Carta o ajustado a la imagen',
    'Orientación automática, vertical u horizontal',
    'Reordenar y quitar imágenes antes de generar',
    'Procesamiento 100% en el navegador (privado)',
    'Gratis, sin registro y sin marca de agua',
  ],
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Convertir imagen a PDF', item: `${site}/convertir-imagen-a-pdf` },
  ],
};

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};

const schemaHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Cómo convertir una imagen a PDF',
  step: howToSteps.map((s, idx) => ({
    '@type': 'HowToStep',
    position: idx + 1,
    name: s.name,
    text: s.text,
  })),
};
---

<Layout title={title} description={description} schema={schema} domain="knowledge">
  <Header slot="header" />

  <article class="pdf-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Convertir imagen a PDF</span>
    </nav>

    <h1>Convertir imagen a PDF online</h1>
    <p class="lead">
      Pasá tus imágenes <strong>JPG, PNG o WebP</strong> a PDF y uní varias fotos en un solo archivo.
      Elegí el tamaño de hoja y la orientación, y descargá el PDF al instante.
      <strong>Todo corre en tu navegador</strong>: tus archivos no se suben a ningún servidor.
    </p>

    <div class="pdf-answer">
      <p>
        <strong>¿Cómo se convierte una imagen a PDF?</strong> Cargás una o varias imágenes, elegís el orden y el tamaño
        de hoja (A4, Carta o ajustado a la foto) y la herramienta arma un <strong>PDF con una imagen por página</strong>.
        El proceso es <strong>100% local</strong>: las fotos nunca salen de tu dispositivo, así que es seguro para
        documentos privados como DNI, recibos o facturas. Es <strong>gratis, sin registro y sin marca de agua</strong>.
      </p>
    </div>

    <div id="pdf-tool" class="pdf-card">
      <label id="pdfDrop" class="pdf-drop" for="pdfInput">
        <input id="pdfInput" type="file" accept="image/*" multiple hidden />
        <span class="pdf-drop-ico" aria-hidden="true">🖼️➜📄</span>
        <span class="pdf-drop-title">Arrastrá tus imágenes acá</span>
        <span class="pdf-drop-sub">o tocá para elegirlas — JPG, PNG, WebP · sin límite</span>
      </label>

      <div id="pdfList" class="pdf-list" aria-live="polite"></div>

      <div id="pdfOptions" class="pdf-options" hidden>
        <div class="pdf-opt">
          <label for="optSize">Hoja</label>
          <select id="optSize">
            <option value="a4" selected>A4 (210×297 mm)</option>
            <option value="letter">Carta / Letter</option>
            <option value="fit">Ajustar a la imagen (sin bordes)</option>
          </select>
        </div>
        <div class="pdf-opt">
          <label for="optOrient">Orientación</label>
          <select id="optOrient">
            <option value="auto" selected>Automática</option>
            <option value="portrait">Vertical</option>
            <option value="landscape">Horizontal</option>
          </select>
        </div>
        <div class="pdf-opt">
          <label for="optMargin">Margen</label>
          <select id="optMargin">
            <option value="0" selected>Sin margen</option>
            <option value="28">Chico (~1 cm)</option>
            <option value="42">Mediano (~1,5 cm)</option>
          </select>
        </div>
        <div class="pdf-opt">
          <label for="optQuality">Calidad</label>
          <select id="optQuality">
            <option value="0.82">Estándar (archivo liviano)</option>
            <option value="0.92" selected>Alta</option>
            <option value="1">Máxima (sin reescalar)</option>
          </select>
        </div>
      </div>

      <div class="pdf-actions">
        <button id="pdfGenerate" type="button" class="pdf-btn" disabled>Generar PDF</button>
        <button id="pdfClear" type="button" class="pdf-btn-ghost" hidden>Vaciar todo</button>
        <span id="pdfStatus" class="pdf-status" role="status" aria-live="polite"></span>
      </div>

      <div id="pdfResult" class="pdf-result" hidden>
        <span class="pdf-result-ico" aria-hidden="true">✅</span>
        <div class="pdf-result-txt">
          <strong>Tu PDF está listo.</strong>
          <span id="pdfResultMeta"></span>
        </div>
        <a id="pdfDownload" class="pdf-btn" download="documento.pdf" href="#">Descargar de nuevo</a>
      </div>

      <p class="pdf-privacy">🔒 Tus imágenes se procesan en tu dispositivo. No se suben a ningún servidor.</p>
    </div>

    <section class="pdf-how">
      <h2>Cómo convertir tus imágenes a PDF</h2>
      <ol>
        {howToSteps.map((s) => (
          <li><strong>{s.name}.</strong> {s.text}</li>
        ))}
      </ol>
    </section>

    <section class="pdf-faq">
      <h2>Preguntas frecuentes</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="pdf-faq-a" set:html={f.a} />
        </details>
      ))}
    </section>

    <section class="pdf-related">
      <h2>Otras herramientas gratis</h2>
      <div class="pdf-related-grid">
        {related.map((r) => (
          <a href={r.href} class="pdf-related-card">
            <span class="pdf-related-ico" aria-hidden="true">{r.i}</span>
            <span>{r.t}</span>
          </a>
        ))}
      </div>
    </section>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaFaq)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaHowTo)}></script>

  <Footer slot="footer" />
</Layout>

<style is:global>
  #pdf-tool * { box-sizing: border-box; }
  .pdf-page { max-width: 820px; margin: 0 auto; padding: 0 16px 48px; }
  .pdf-page .lead { font-size: 1.05rem; line-height: 1.6; color: var(--text-2, #475569); }
  .pdf-answer { background: var(--surface-2, #f1f5f9); border-radius: 12px; padding: 14px 18px; margin: 18px 0 22px; }
  .pdf-answer p { margin: 0; line-height: 1.6; }

  .pdf-card {
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 16px;
    padding: 20px;
    background: var(--surface, #fff);
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
  }

  #pdf-tool .pdf-drop {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    text-align: center; cursor: pointer;
    border: 2px dashed var(--border-strong, #cbd5e1);
    border-radius: 14px; padding: 34px 18px;
    background: var(--surface-2, #f8fafc);
    transition: border-color .15s, background .15s;
  }
  #pdf-tool .pdf-drop:hover, #pdf-tool .pdf-drop.drag {
    border-color: var(--accent, #2563eb);
    background: color-mix(in srgb, var(--accent, #2563eb) 8%, #fff);
  }
  #pdf-tool .pdf-drop-ico { font-size: 1.9rem; letter-spacing: 2px; }
  #pdf-tool .pdf-drop-title { font-weight: 700; font-size: 1.05rem; }
  #pdf-tool .pdf-drop-sub { color: var(--text-2, #64748b); font-size: .9rem; }

  #pdf-tool .pdf-list { display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }
  #pdf-tool .pdf-item {
    display: flex; align-items: center; gap: 12px;
    border: 1px solid var(--border, #e2e8f0); border-radius: 12px; padding: 8px 10px;
    background: var(--surface, #fff);
  }
  #pdf-tool .pdf-item img {
    width: 56px; height: 56px; object-fit: cover; border-radius: 8px; flex: 0 0 auto;
    background: #f1f5f9; border: 1px solid var(--border, #e2e8f0);
  }
  #pdf-tool .pdf-item-info { flex: 1 1 auto; min-width: 0; }
  #pdf-tool .pdf-item-name { font-weight: 600; font-size: .92rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #pdf-tool .pdf-item-meta { color: var(--text-2, #64748b); font-size: .8rem; }
  #pdf-tool .pdf-item-num {
    flex: 0 0 auto; width: 26px; height: 26px; border-radius: 999px;
    display: grid; place-items: center; font-size: .8rem; font-weight: 700;
    background: var(--accent, #2563eb); color: #fff;
  }
  #pdf-tool .pdf-item-btns { display: flex; gap: 4px; flex: 0 0 auto; }
  #pdf-tool .pdf-mini {
    width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--border, #e2e8f0);
    background: var(--surface-2, #f8fafc); cursor: pointer; font-size: .95rem; line-height: 1;
    display: grid; place-items: center; color: var(--text, #0f172a);
  }
  #pdf-tool .pdf-mini:hover { border-color: var(--accent, #2563eb); }
  #pdf-tool .pdf-mini:disabled { opacity: .35; cursor: default; }
  #pdf-tool .pdf-mini-x:hover { border-color: #ef4444; color: #ef4444; }

  #pdf-tool .pdf-options {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px;
  }
  #pdf-tool .pdf-opt { display: flex; flex-direction: column; gap: 4px; }
  #pdf-tool .pdf-opt label { font-size: .82rem; font-weight: 600; color: var(--text-2, #475569); }
  #pdf-tool .pdf-opt select {
    padding: 9px 10px; border-radius: 10px; border: 1px solid var(--border, #cbd5e1);
    background: var(--surface, #fff); font-size: .92rem; color: var(--text, #0f172a);
  }

  #pdf-tool .pdf-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 18px; }
  #pdf-tool .pdf-btn, .pdf-related a, .pdf-page a.pdf-btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--accent, #2563eb); color: #fff; font-weight: 700;
    border: none; border-radius: 10px; padding: 12px 22px; font-size: 1rem; cursor: pointer;
    text-decoration: none; transition: filter .15s;
  }
  #pdf-tool .pdf-btn:hover { filter: brightness(1.08); }
  #pdf-tool .pdf-btn:disabled { opacity: .5; cursor: default; filter: none; }
  #pdf-tool .pdf-btn-ghost {
    background: transparent; color: var(--text-2, #475569); border: 1px solid var(--border, #cbd5e1);
    border-radius: 10px; padding: 11px 16px; font-weight: 600; cursor: pointer;
  }
  #pdf-tool .pdf-status { color: var(--text-2, #64748b); font-size: .9rem; }

  #pdf-tool .pdf-result {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    margin-top: 16px; padding: 14px 16px; border-radius: 12px;
    background: color-mix(in srgb, #16a34a 10%, #fff); border: 1px solid color-mix(in srgb, #16a34a 30%, #fff);
  }
  #pdf-tool .pdf-result-ico { font-size: 1.4rem; }
  #pdf-tool .pdf-result-txt { flex: 1 1 auto; display: flex; flex-direction: column; }
  #pdf-tool .pdf-result-txt span { color: var(--text-2, #475569); font-size: .88rem; }
  #pdf-tool .pdf-privacy { margin: 16px 0 0; font-size: .82rem; color: var(--text-2, #64748b); text-align: center; }

  .pdf-how, .pdf-faq, .pdf-related { margin-top: 34px; }
  .pdf-how h2, .pdf-faq h2, .pdf-related h2 { font-size: 1.3rem; margin: 0 0 14px; }
  .pdf-how ol { padding-left: 20px; line-height: 1.7; }
  .pdf-how li { margin-bottom: 8px; }
  .pdf-faq details {
    border: 1px solid var(--border, #e2e8f0); border-radius: 10px; padding: 12px 14px; margin-bottom: 10px;
    background: var(--surface, #fff);
  }
  .pdf-faq summary { font-weight: 600; cursor: pointer; }
  .pdf-faq-a { margin-top: 8px; line-height: 1.6; color: var(--text-2, #475569); }
  .pdf-faq-a a { color: var(--accent, #2563eb); }
  .pdf-related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
  .pdf-related-card {
    display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit;
    border: 1px solid var(--border, #e2e8f0); border-radius: 12px; padding: 12px 14px; background: var(--surface, #fff);
    transition: border-color .15s;
  }
  .pdf-related-card:hover { border-color: var(--accent, #2563eb); }
  .pdf-related-ico { font-size: 1.3rem; }

  @media (max-width: 520px) {
    #pdf-tool .pdf-options { grid-template-columns: 1fr; }
    #pdf-tool .pdf-item-meta { display: none; }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var root = document.getElementById('pdf-tool');
      if (!root || root.dataset.ready === '1') return;
      root.dataset.ready = '1';

      var input = document.getElementById('pdfInput');
      var drop = document.getElementById('pdfDrop');
      var list = document.getElementById('pdfList');
      var options = document.getElementById('pdfOptions');
      var genBtn = document.getElementById('pdfGenerate');
      var clearBtn = document.getElementById('pdfClear');
      var status = document.getElementById('pdfStatus');
      var result = document.getElementById('pdfResult');
      var resultMeta = document.getElementById('pdfResultMeta');
      var downloadLink = document.getElementById('pdfDownload');

      var items = []; // { id, name, bitmap, w, h, thumb }
      var uid = 0;
      var lastUrl = null;

      // ---- helpers ----
      function fmtBytes(n) {
        if (n < 1024) return n + ' B';
        if (n < 1024 * 1024) return (n / 1024).toFixed(0) + ' KB';
        return (n / 1024 / 1024).toFixed(1) + ' MB';
      }

      function decodeImage(file) {
        if (typeof createImageBitmap === 'function') {
          return createImageBitmap(file).catch(function () { return decodeViaImg(file); });
        }
        return decodeViaImg(file);
      }
      function decodeViaImg(file) {
        return new Promise(function (res, rej) {
          var url = URL.createObjectURL(file);
          var img = new Image();
          img.onload = function () { res(img); };
          img.onerror = function () { URL.revokeObjectURL(url); rej(new Error('No se pudo leer la imagen')); };
          img.src = url;
        });
      }

      function bmpSize(bmp) {
        return { w: bmp.width || bmp.naturalWidth, h: bmp.height || bmp.naturalHeight };
      }

      // Reescala una imagen a JPEG (bytes) con tope de lado y calidad dados.
      function rasterToJpeg(bmp, maxSide, quality) {
        var s = bmpSize(bmp);
        var scale = maxSide > 0 ? Math.min(1, maxSide / Math.max(s.w, s.h)) : 1;
        var cw = Math.max(1, Math.round(s.w * scale));
        var ch = Math.max(1, Math.round(s.h * scale));
        var canvas = document.createElement('canvas');
        canvas.width = cw; canvas.height = ch;
        var ctx = canvas.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, cw, ch);
        ctx.drawImage(bmp, 0, 0, cw, ch);
        var dataUrl = canvas.toDataURL('image/jpeg', quality);
        var b64 = dataUrl.substring(dataUrl.indexOf(',') + 1);
        var bin = atob(b64);
        var bytes = new Uint8Array(bin.length);
        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i) & 0xff;
        return { bytes: bytes, w: cw, h: ch };
      }

      function thumbUrl(bmp) {
        var s = bmpSize(bmp);
        var scale = Math.min(1, 120 / Math.max(s.w, s.h));
        var cw = Math.max(1, Math.round(s.w * scale));
        var ch = Math.max(1, Math.round(s.h * scale));
        var canvas = document.createElement('canvas');
        canvas.width = cw; canvas.height = ch;
        var ctx = canvas.getContext('2d');
        ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, cw, ch);
        ctx.drawImage(bmp, 0, 0, cw, ch);
        return canvas.toDataURL('image/jpeg', 0.7);
      }

      // ---- state / UI ----
      function render() {
        list.innerHTML = '';
        items.forEach(function (it, idx) {
          var row = document.createElement('div');
          row.className = 'pdf-item';
          row.innerHTML =
            '<span class="pdf-item-num">' + (idx + 1) + '</span>' +
            '<img src="' + it.thumb + '" alt="" />' +
            '<div class="pdf-item-info">' +
            '<div class="pdf-item-name"></div>' +
            '<div class="pdf-item-meta">' + it.w + '×' + it.h + ' px</div>' +
            '</div>' +
            '<div class="pdf-item-btns">' +
            '<button type="button" class="pdf-mini pdf-up" title="Subir" aria-label="Subir">▲</button>' +
            '<button type="button" class="pdf-mini pdf-down" title="Bajar" aria-label="Bajar">▼</button>' +
            '<button type="button" class="pdf-mini pdf-mini-x pdf-del" title="Quitar" aria-label="Quitar">✕</button>' +
            '</div>';
          row.querySelector('.pdf-item-name').textContent = it.name;
          var up = row.querySelector('.pdf-up');
          var down = row.querySelector('.pdf-down');
          up.disabled = idx === 0;
          down.disabled = idx === items.length - 1;
          up.addEventListener('click', function () { move(idx, -1); });
          down.addEventListener('click', function () { move(idx, 1); });
          row.querySelector('.pdf-del').addEventListener('click', function () { remove(idx); });
          list.appendChild(row);
        });
        var has = items.length > 0;
        options.hidden = !has;
        clearBtn.hidden = !has;
        genBtn.disabled = !has;
        if (has) { result.hidden = true; }
      }

      function move(idx, dir) {
        var j = idx + dir;
        if (j < 0 || j >= items.length) return;
        var tmp = items[idx]; items[idx] = items[j]; items[j] = tmp;
        render();
      }
      function remove(idx) { items.splice(idx, 1); render(); }

      function addFiles(fileList) {
        var files = Array.prototype.slice.call(fileList).filter(function (f) {
          return f.type.indexOf('image/') === 0 || /\.(jpe?g|png|webp|gif|bmp)$/i.test(f.name);
        });
        if (!files.length) { setStatus('Elegí archivos de imagen (JPG, PNG, WebP).'); return; }
        setStatus('Cargando ' + files.length + ' imagen' + (files.length > 1 ? 'es' : '') + '…');
        var pending = files.length;
        files.forEach(function (f) {
          decodeImage(f).then(function (bmp) {
            var s = bmpSize(bmp);
            items.push({ id: ++uid, name: f.name, bitmap: bmp, w: s.w, h: s.h, thumb: thumbUrl(bmp) });
            done();
          }).catch(function () {
            setStatus('No se pudo leer "' + f.name + '". Si es HEIC del iPhone, convertila a JPG.');
            done();
          });
        });
        function done() { pending--; if (pending === 0) { setStatus(''); render(); } }
      }

      function setStatus(t) { status.textContent = t || ''; }

      // ---- PDF builder (cero dependencias) ----
      function enc(str) {
        var a = new Uint8Array(str.length);
        for (var i = 0; i < str.length; i++) a[i] = str.charCodeAt(i) & 0xff;
        return a;
      }
      function fmt(n) { return (Math.round(n * 100) / 100).toString(); }

      var SIZES = { a4: [595.28, 841.89], letter: [612, 792] };

      function pageLayout(imgW, imgH, opts) {
        var pageW, pageH;
        if (opts.size === 'fit') {
          // 1 px -> 0.75 pt (96 dpi). Página = imagen, sin bordes.
          pageW = imgW * 0.75; pageH = imgH * 0.75;
          return { pageW: pageW, pageH: pageH, dx: 0, dy: 0, dw: pageW, dh: pageH };
        }
        var base = SIZES[opts.size] || SIZES.a4;
        var pw = base[0], ph = base[1];
        var landscape;
        if (opts.orient === 'landscape') landscape = true;
        else if (opts.orient === 'portrait') landscape = false;
        else landscape = imgW > imgH; // auto
        if (landscape) { pageW = Math.max(pw, ph); pageH = Math.min(pw, ph); }
        else { pageW = Math.min(pw, ph); pageH = Math.max(pw, ph); }
        var m = opts.margin || 0;
        var availW = pageW - 2 * m, availH = pageH - 2 * m;
        var scale = Math.min(availW / imgW, availH / imgH);
        var dw = imgW * scale, dh = imgH * scale;
        var dx = (pageW - dw) / 2, dy = (pageH - dh) / 2;
        return { pageW: pageW, pageH: pageH, dx: dx, dy: dy, dw: dw, dh: dh };
      }

      function buildPdf(jpegs, opts) {
        // jpegs: [{ bytes, w, h }]
        var chunks = [];
        var len = 0;
        var offsets = [];
        function push(bytes) { chunks.push(bytes); len += bytes.length; }
        function pushStr(s) { push(enc(s)); }
        function startObj(n) { offsets[n] = len; pushStr(n + ' 0 obj\n'); }
        function endObj() { pushStr('endobj\n'); }

        pushStr('%PDF-1.4\n');
        push(new Uint8Array([0x25, 0xe2, 0xe3, 0xcf, 0xd3, 0x0a])); // %âãÏÓ

        var N = jpegs.length;
        var pageObjs = [];
        var next = 3;
        for (var i = 0; i < N; i++) { pageObjs.push({ page: next, content: next + 1, img: next + 2 }); next += 3; }
        var totalObjs = next - 1;

        // 1 = Catalog
        startObj(1); pushStr('<< /Type /Catalog /Pages 2 0 R >>\n'); endObj();
        // 2 = Pages
        startObj(2);
        pushStr('<< /Type /Pages /Count ' + N + ' /Kids [' +
          pageObjs.map(function (p) { return p.page + ' 0 R'; }).join(' ') + '] >>\n');
        endObj();

        for (var k = 0; k < N; k++) {
          var im = jpegs[k];
          var p = pageObjs[k];
          var L = pageLayout(im.w, im.h, opts);
          // Page
          startObj(p.page);
          pushStr('<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ' + fmt(L.pageW) + ' ' + fmt(L.pageH) + ']' +
            ' /Resources << /XObject << /Im0 ' + p.img + ' 0 R >> >> /Contents ' + p.content + ' 0 R >>\n');
          endObj();
          // Content stream
          var content = 'q\n' + fmt(L.dw) + ' 0 0 ' + fmt(L.dh) + ' ' + fmt(L.dx) + ' ' + fmt(L.dy) + ' cm\n/Im0 Do\nQ\n';
          var cbytes = enc(content);
          startObj(p.content);
          pushStr('<< /Length ' + cbytes.length + ' >>\nstream\n');
          push(cbytes);
          pushStr('\nendstream\n');
          endObj();
          // Image XObject (JPEG / DCTDecode)
          startObj(p.img);
          pushStr('<< /Type /XObject /Subtype /Image /Width ' + im.w + ' /Height ' + im.h +
            ' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ' + im.bytes.length + ' >>\nstream\n');
          push(im.bytes);
          pushStr('\nendstream\n');
          endObj();
        }

        // xref
        var xrefOff = len;
        var count = totalObjs + 1;
        pushStr('xref\n0 ' + count + '\n');
        pushStr('0000000000 65535 f \n');
        for (var n = 1; n <= totalObjs; n++) {
          var off = offsets[n] || 0;
          var s = '' + off;
          while (s.length < 10) s = '0' + s;
          pushStr(s + ' 00000 n \n');
        }
        pushStr('trailer\n<< /Size ' + count + ' /Root 1 0 R >>\nstartxref\n' + xrefOff + '\n%%EOF\n');

        var out = new Uint8Array(len);
        var o = 0;
        for (var c = 0; c < chunks.length; c++) { out.set(chunks[c], o); o += chunks[c].length; }
        return new Blob([out], { type: 'application/pdf' });
      }

      function readOpts() {
        return {
          size: document.getElementById('optSize').value,
          orient: document.getElementById('optOrient').value,
          margin: parseFloat(document.getElementById('optMargin').value) || 0,
          quality: parseFloat(document.getElementById('optQuality').value) || 0.92,
        };
      }

      function generate() {
        if (!items.length) return;
        var opts = readOpts();
        genBtn.disabled = true;
        setStatus('Generando PDF…');
        // Dar un frame para que se pinte el estado antes del trabajo pesado.
        setTimeout(function () {
          try {
            var maxSide = opts.quality >= 1 ? 0 : 2500; // 0 = sin reescalar
            var jpegs = items.map(function (it) {
              var q = opts.quality >= 1 ? 0.95 : opts.quality;
              return rasterToJpeg(it.bitmap, maxSide, q);
            });
            var blob = buildPdf(jpegs, opts);
            if (lastUrl) URL.revokeObjectURL(lastUrl);
            lastUrl = URL.createObjectURL(blob);
            var fname = 'documento-' + items.length + (items.length > 1 ? '-imagenes' : '-imagen') + '.pdf';
            downloadLink.href = lastUrl;
            downloadLink.download = fname;
            resultMeta.textContent = items.length + (items.length > 1 ? ' páginas' : ' página') + ' · ' + fmtBytes(blob.size);
            result.hidden = false;
            setStatus('');
            // Descarga automática
            var a = document.createElement('a');
            a.href = lastUrl; a.download = fname;
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            if (typeof window.gtag === 'function') {
              try { window.gtag('event', 'pdf_generado', { imagenes: items.length }); } catch (e) {}
            }
          } catch (err) {
            setStatus('Hubo un error generando el PDF. Probá con menos imágenes o calidad Estándar.');
          } finally {
            genBtn.disabled = items.length === 0;
          }
        }, 30);
      }

      // ---- events ----
      input.addEventListener('change', function (e) { addFiles(e.target.files); input.value = ''; });
      genBtn.addEventListener('click', generate);
      clearBtn.addEventListener('click', function () { items = []; setStatus(''); render(); });

      ['dragenter', 'dragover'].forEach(function (ev) {
        drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.add('drag'); });
      });
      ['dragleave', 'drop'].forEach(function (ev) {
        drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.remove('drag'); });
      });
      drop.addEventListener('drop', function (e) {
        if (e.dataTransfer && e.dataTransfer.files) addFiles(e.dataTransfer.files);
      });

      render();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  })();
</script>
