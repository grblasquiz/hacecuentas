---
/**
 * Hub de decisión VE — "Cuánto le debo al SENIAT".
 * El compute() replica las fórmulas vivas de ISLR anual, retención de ISLR sobre
 * sueldos, retención de IVA, IGTF, conversión U.T. ↔ Bs., INCES y sucesiones.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import IslrSeniatVenezuelaExperience from '../../../components/generated/IslrSeniatVenezuelaExperience.astro';
import RegimeJourney from '../../../components/RegimeJourney.astro';
import { hub, TARIFA_1, ISLR, OTROS_TRIBUTOS, SUCESIONES } from '../../../lib/hubs/ve/islr-y-tributos-seniat';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="VE"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <IslrSeniatVenezuelaExperience data={hub} />
  <RegimeJourney country="Venezuela" regime="Cuenta propia" headline="No hay monotributo: ordená ISLR, IVA y obligaciones por separado." intro="En vez de inventar un equivalente, esta ruta parte de tu tipo de contribuyente y separa renta, anticipos, IVA y tributos municipales." steps={['Definí actividad y contribuyente','Estimá enriquecimiento neto','Revisá IVA y tributos locales']} links={[{href:'/ve/impuestos/islr-y-tributos-seniat',label:'Calcular ISLR',note:'Tarifa, rebajas y resultado'},{href:'/ve/impuestos/index',label:'Ver obligaciones SENIAT',note:'Mapa fiscal y vencimientos'},{href:'/ve/calculadora-retencion-iva-venezuela',label:'Calcular retención de IVA',note:'Pago y comprobante estimado'}]} tone="amber" />
  <Footer />
</Layout>
