---
/**
 * Hub de decisión VE — "Cuánto le debo al SENIAT".
 * El compute() replica las fórmulas vivas de ISLR anual, retención de ISLR sobre
 * sueldos, retención de IVA, IGTF, conversión U.T. ↔ Bs., INCES y sucesiones.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import IslrSeniatVenezuelaExperience from '../../../components/generated/IslrSeniatVenezuelaExperience.astro';
import { hub, TARIFA_1, ISLR, OTROS_TRIBUTOS, SUCESIONES } from '../../../lib/hubs/ve/islr-y-tributos-seniat';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="VE"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <IslrSeniatVenezuelaExperience data={hub} />
  <Footer />
</Layout>

