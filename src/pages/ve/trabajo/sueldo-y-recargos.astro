---
/**
 * Hub de decisión VE — "Cuánto me tienen que pagar este mes".
 * El compute() replica las fórmulas vivas de salario por hora, horas extras,
 * bono nocturno, feriados trabajados, cestaticket, bono de guerra y canasta básica.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SueldoRecargosVenezuelaExperience from '../../../components/generated/SueldoRecargosVenezuelaExperience.astro';
import { hub, RECARGOS } from '../../../lib/hubs/ve/sueldo-y-recargos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="VE"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoRecargosVenezuelaExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ R: RECARGOS }}>
  (function () {
    const H = window.HC_HUB;
    const bs = (n) =>
      'Bs. ' + new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 }).format(Math.round((n || 0) * 100) / 100);

    H.onCompute(function (v) {
      const salarioMensual = Math.max(0, v.salarioMensual || 0);
      const horasJornada = Math.max(1, Math.round(v.horasJornada || 8));
      const horasExtras = Math.max(0, Math.round(v.horasExtras || 0));
      const horasNocturnas = Math.max(0, Math.round(v.horasNocturnas || 0));
      const diasFeriados = Math.max(0, Math.round(v.diasFeriados || 0));
      const tasaBcv = Math.max(0, v.tasaBcv || 0);
      const cestaticketUsd = Math.max(0, v.cestaticketUsd || 0);
      const bonoGuerraUsd = Math.max(0, v.bonoGuerraUsd || 0);
      const canastaUsd = Math.max(0, v.canastaUsd || 0);

      // Valor de la hora: criterio de nómina (mensual ÷ 30 ÷ horas de jornada).
      const salarioDiario = salarioMensual / 30;
      const valorHora = salarioDiario / horasJornada;
      // Criterio de jornada legal (mensual ÷ 173,33), para comparar.
      const valorHoraLegal = salarioMensual / R.horasMes;

      // Recargos LOTTT. En la extra nocturna los recargos se ENCADENAN (multiplican).
      const valorHoraExtra = valorHora * (1 + R.extra);
      const valorHoraNocturna = valorHora * (1 + R.nocturno);
      const valorHoraExtraNocturna = valorHoraNocturna * (1 + R.extra);

      const pagoExtras = horasExtras * valorHoraExtra;
      const bonoNocturno = horasNocturnas * valorHora * R.nocturno; // solo el plus
      const recargoFeriado = diasFeriados * salarioDiario * R.feriado;
      const pagoFeriados = diasFeriados * salarioDiario * (1 + R.feriado);

      // Piezas indexadas al dólar.
      const cestaticketBs = cestaticketUsd * tasaBcv;
      const bonoGuerraBs = bonoGuerraUsd * tasaBcv;

      const salarioYRecargos = salarioMensual + pagoExtras + bonoNocturno + pagoFeriados;
      const totalBs = salarioYRecargos + cestaticketBs + bonoGuerraBs;
      const totalUsd = tasaBcv > 0 ? totalBs / tasaBcv : 0;

      const pctCanasta = canastaUsd > 0 ? (totalUsd / canastaUsd) * 100 : 0;
      const deficitUsd = Math.max(0, canastaUsd - totalUsd);
      const pctQueGeneraPasivos = totalBs > 0 ? (salarioYRecargos / totalBs) * 100 : 0;

      const rows = [
        { k: 'Valor de tu hora (criterio de nómina)', ref: 'Mensual ÷ 30 ÷ ' + horasJornada + ' h', v: valorHora },
        { k: 'Valor de tu hora (jornada legal)', ref: 'Mensual ÷ ' + R.horasMes.toFixed(2) + ' h · 40 h × 52 ÷ 12', v: valorHoraLegal },
        { k: 'Salario normal del mes', ref: 'Base de todos los recargos', v: salarioMensual },
        { k: 'Hora extra diurna', ref: '+' + R.extra * 100 + '% · Art. 118', v: valorHoraExtra },
        { k: 'Hora extra nocturna', ref: '+' + R.nocturno * 100 + '% y +' + R.extra * 100 + '% encadenados · Arts. 117-118', v: valorHoraExtraNocturna },
        { k: 'Pago por ' + horasExtras + ' horas extras diurnas', ref: 'Art. 118', v: pagoExtras },
        { k: 'Bono nocturno por ' + horasNocturnas + ' horas', ref: 'Solo el recargo del ' + R.nocturno * 100 + '% · Art. 117', v: bonoNocturno },
        { k: 'Pago por ' + diasFeriados + ' feriados o domingos', ref: 'Día + ' + R.feriado * 100 + '% · Art. 120', v: pagoFeriados },
        { k: 'De ese pago, recargo puro', ref: 'Lo que se suma por encima del día', v: recargoFeriado },
        {
          k: 'Días de descanso compensatorio ganados',
          ref: 'Art. 119 · no se canjean por dinero',
          v: diasFeriados,
          format: 'unit',
          unit: 'días',
        },
        { k: 'Salario + recargos (genera prestaciones)', ref: 'Base de tu liquidación futura', v: salarioYRecargos, extra: true },
        { k: 'Cestaticket socialista', ref: 'USD ' + cestaticketUsd + ' × tasa BCV · no es salario', v: cestaticketBs },
        { k: 'Bono de Guerra Económica', ref: 'USD ' + bonoGuerraUsd + ' × tasa BCV · no es salario', v: bonoGuerraBs },
        { k: 'Ingreso total del mes', ref: 'Todo junto', v: totalBs, extra: true },
        {
          k: 'Ingreso total en dólares',
          ref: 'A la tasa BCV que cargaste',
          v: totalUsd,
          format: 'unit',
          unit: 'USD',
          decimals: 2,
        },
        {
          k: 'Parte de tu ingreso que genera pasivos laborales',
          ref: 'Salario y recargos sobre el total',
          v: pctQueGeneraPasivos,
          format: 'unit',
          unit: '%',
          decimals: 1,
        },
        {
          k: 'Porcentaje de la canasta básica que cubrís',
          ref: 'CENDAS-FVM',
          v: pctCanasta,
          format: 'unit',
          unit: '%',
          decimals: 1,
        },
        {
          k: deficitUsd > 0 ? 'Déficit mensual contra la canasta' : 'Excedente sobre la canasta',
          ref: 'En dólares',
          v: deficitUsd > 0 ? deficitUsd : totalUsd - canastaUsd,
          format: 'unit',
          unit: 'USD',
          decimals: 2,
        },
      ];

      const sub =
        'Hora ' + bs(valorHora) + ' · ' + pctQueGeneraPasivos.toFixed(0) + '% de tu ingreso genera prestaciones · ' +
        (canastaUsd > 0
          ? 'cubrís el ' + pctCanasta.toFixed(0) + '% de la canasta'
          : 'cargá la canasta del CENDAS para comparar');

      return {
        total: bs(totalBs),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Salario normal', value: Math.round(salarioMensual), tone: 'main' },
          { label: 'Recargos de jornada (extras, nocturno, feriados)', value: Math.round(pagoExtras + bonoNocturno + pagoFeriados), tone: 'good' },
          { label: 'Cestaticket (no es salario)', value: Math.round(cestaticketBs), tone: 'prop' },
          { label: 'Bono de guerra (no es salario)', value: Math.round(bonoGuerraBs), tone: 'warn' },
        ],
      };
    });
  })();
</script>
