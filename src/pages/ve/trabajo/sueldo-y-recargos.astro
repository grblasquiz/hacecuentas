---
/**
 * Hub de decisión VE — "Cuánto me tienen que pagar este mes".
 * El compute() replica las fórmulas vivas de salario por hora, horas extras,
 * bono nocturno, feriados trabajados, cestaticket, bono de guerra y canasta básica.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SueldoRecargosVenezuelaExperience from '../../../components/generated/SueldoRecargosVenezuelaExperience.astro';
import { hub, RECARGOS } from '../../../lib/hubs/ve/sueldo-y-recargos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="VE"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoRecargosVenezuelaExperience data={hub} />
  <Footer />
</Layout>

