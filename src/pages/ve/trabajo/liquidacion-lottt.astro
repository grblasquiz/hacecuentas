---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LiquidacionLotttExperience from '../../../components/generated/LiquidacionLotttExperience.astro';
import { hub } from '../../../lib/hubs/ve/liquidacion-lottt';
const canonical='https://hacecuentas.com/ve/trabajo/liquidacion-lottt';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
import HubCitableStats from '../../../components/hub/HubCitableStats.astro';
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <LiquidacionLotttExperience />
  <HubCitableStats data={hub} />
  <Footer />
</Layout>
