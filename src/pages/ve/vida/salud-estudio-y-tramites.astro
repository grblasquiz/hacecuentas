---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/ve/salud-estudio-y-tramites';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="VE" lang="es" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/ve-salud-estudio-y-tramites';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"calorias-tdee","fields":["sexo","edad","peso","altura","actividad"],"outputs":[{"id":"tdee","label":"Calorías para mantener","format":"number","primary":true,"suffix":"kcal/día"},{"id":"bmr","label":"Metabolismo basal (reposo)","format":"number","suffix":"kcal"},{"id":"paraBajarPeso","label":"Para bajar peso (~0,5 kg/semana)","format":"number","suffix":"kcal/día"},{"id":"paraSubirPeso","label":"Para subir peso (~0,5 kg/semana)","format":"number","suffix":"kcal/día"},{"id":"nivelActividad","label":"Actividad aplicada","format":"text"}],"title":"Calculadora de calorías diarias (gasto energético)"},"c2":{"formulaId":"costo-pasaporte-saime-venezuela","fields":["tramite","tarifaUsdManual","tasaBcv"],"outputs":[{"id":"costoBs","label":"Costo en bolívares","format":"currency","prefix":"Bs.","primary":true,"description":"Tarifa en dólares convertida a bolívares a la tasa BCV."},{"id":"costoUsd","label":"Tarifa en dólares","format":"currency","prefix":"$","description":"Tarifa del trámite en dólares (referencial o la que ingreses)."},{"id":"tasaUsada","label":"Tasa BCV aplicada","description":"Bolívares por dólar usados en el cálculo."},{"id":"detalle","label":"Detalle"}],"title":"Costo del pasaporte y la prórroga (SAIME) en bolívares"},"c3":{"formulaId":"calculadora-promedio-notas-20-puntos-venezuela","fields":["notas","creditos","notaAprobatoria"],"outputs":[{"id":"promedio","label":"Promedio / índice (sobre 20)","format":"text","primary":true,"description":"Promedio simple o índice ponderado si cargaste créditos."},{"id":"categoria","label":"Nivel","format":"text","description":"Excelente, distinguido, bueno, aprobado o reprobado."},{"id":"materiasAprobadas","label":"Materias aprobadas","format":"number","description":"Cantidad de notas iguales o mayores a la mínima."},{"id":"materiasReprobadas","label":"Materias reprobadas","format":"number","description":"Cantidad de notas por debajo de la mínima."}],"title":"Calculadora de promedio de notas e índice académico (escala 0-20)"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'es', format: 'unit' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
