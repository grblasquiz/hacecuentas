---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import CaloriasDiariasExperience from '../../components/generated/CaloriasDiariasExperience.astro';
import { hub } from '../../lib/hubs/calorias-diarias';
const canonical='https://hacecuentas.com/nutricion/calorias-diarias';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
import HubCitableStats from '../../components/hub/HubCitableStats.astro';
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <CaloriasDiariasExperience />
  <HubCitableStats data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>
