---
export const prerender = true;
import FeriadosLanding from '../components/FeriadosLanding.astro';
import { FERIADOS_LATAM_2026 } from '../lib/data/feriados-latam-2026';

const related = [
  { href: '/dias-entre-dos-fechas', label: 'Días entre dos fechas' },
  { href: '/calculadora-cuenta-regresiva-dias-faltan', label: 'Cuenta regresiva: cuántos días faltan' },
  { href: '/pe/calculadora-cts-peru-compensacion-tiempo-servicios-2026', label: 'Calculadora de CTS Perú 2026' },
  { href: '/pe', label: 'Más calculadoras para Perú' },
];

const title = 'Feriados Perú 2026: los 16 días no laborables oficiales';
const description = 'Feriados de Perú 2026: los 16 días feriados y no laborables con la fecha y el día de la semana. Fines de semana largos, puentes y cuál es el próximo feriado. Datos oficiales.';
---
<FeriadosLanding data={FERIADOS_LATAM_2026.peru} related={related} title={title} description={description} />
