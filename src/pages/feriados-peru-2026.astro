---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeriadosPeruExperience from '../components/generated/FeriadosPeruExperience.astro';
const canonical='https://hacecuentas.com/feriados-peru-2026';
const schema={'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage',name:'Calendario de feriados de Perú 2026',description:'Feriados nacionales, días no laborables y puentes posibles de Perú en 2026.',url:canonical,inLanguage:'es-PE',dateModified:'2026-07-31'},
  {'@type':'FAQPage',mainEntity:[
    {'@type':'Question',name:'¿Cuántos feriados nacionales tiene Perú en 2026?',acceptedAnswer:{'@type':'Answer',text:'El calendario incluye 16 feriados nacionales y distingue los días no laborables aplicables al sector público.'}},
    {'@type':'Question',name:'¿Feriado y día no laborable son lo mismo en Perú?',acceptedAnswer:{'@type':'Answer',text:'No. El feriado nacional alcanza a trabajadores públicos y privados; los días no laborables pueden tener reglas de compensación y alcance diferentes.'}}
  ]}
]};
---
<Layout title="Feriados Perú 2026: calendario y días no laborables | Hacé Cuentas" description="Calendario de feriados de Perú 2026 con los 16 feriados nacionales, días no laborables, fines de semana largos y puentes posibles." canonical={canonical} schema={schema} lang="es" audience="PE">
  <Header />
  <FeriadosPeruExperience />
  <Footer />
</Layout>
