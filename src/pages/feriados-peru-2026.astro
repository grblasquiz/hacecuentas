---
export const prerender = true;
import FeriadosLanding from '../components/FeriadosLanding.astro';
import { FERIADOS_LATAM_2026 } from '../lib/data/feriados-latam-2026';

const related = [
  { href: '/dias-entre-dos-fechas', label: 'Días entre dos fechas' },
  { href: '/calculadora-cuenta-regresiva-dias-faltan', label: 'Cuenta regresiva: cuántos días faltan' },
  { href: '/pe/calculadora-cts-peru-compensacion-tiempo-servicios-2026', label: 'Calculadora de CTS Perú 2026' },
  { href: '/pe', label: 'Más calculadoras para Perú' },

  // Cluster de feriados: las 5 landings estaban aisladas (1-2 inlinks cada una,
  // posición 7-8 en Bing). Enlazadas entre sí se sostienen mutuamente.
  { href: '/feriados-colombia-2026', label: 'Feriados Colombia 2026' },
  { href: '/feriados-2026', label: 'Feriados 2026 en todos los países' },
  { href: '/feriados-chile-2026', label: 'Feriados Chile 2026' },
  { href: '/feriados-ecuador-2026', label: 'Feriados Ecuador 2026' },
  { href: '/feriados-mexico-2026', label: 'Feriados México 2026' },
];

const title = "Feriados Perú 2026: los 16 días y el próximo que viene";
const description = 'Los 16 feriados y días no laborables de Perú 2026 con fecha y día de la semana. Descubre el próximo feriado y los fines de semana largos. Datos oficiales.';
---
<FeriadosLanding data={FERIADOS_LATAM_2026.peru} related={related} title={title} description={description} />
