---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import ActionCard from '../components/ui/ActionCard.astro';
import { CATEGORIAS, TOPES, CUOTA_SERVICIOS, CUOTA_BIENES } from '../lib/data/monotributo-2026';

const title = 'Recategorización Monotributo: vence 5 de agosto 2026 — nuevas escalas desde agosto | Hacé Cuentas';
const description = 'Calculá tu categoría para la recategorización del monotributo que vence el 5 de agosto de 2026. Nueva escala oficial ARCA desde agosto, cuotas A a K y trámite paso a paso.';
const siteUrl = 'https://hacecuentas.com';
const fmtAr = (n: number) => '$' + Math.round(n).toLocaleString('es-AR');

const categorias = CATEGORIAS.map((cat) => ({
  cat,
  tope: TOPES[cat],
  servicios: CUOTA_SERVICIOS[cat],
  bienes: CUOTA_BIENES[cat],
}));

const faqItems = [
  { q: '¿Cuándo vence la recategorización del monotributo en agosto 2026?', a: 'El trámite puede realizarse hasta el 5 de agosto de 2026 inclusive. La nueva categoría rige desde agosto y el primer pago con la escala actualizada vence el 20 de agosto.' },
  { q: '¿Qué período tengo que sumar?', a: 'Para esta recategorización se evalúan los últimos 12 meses de actividad: julio de 2025 a junio de 2026. Sumá los ingresos brutos facturados durante ese período.' },
  { q: '¿Tengo que hacer el trámite si sigo en la misma categoría?', a: 'No. ARCA indica que quienes mantienen la misma categoría no deben realizar ninguna acción. Solo tenés que recategorizarte si tus parámetros cambiaron.' },
  { q: '¿Quiénes no deben recategorizarse?', a: 'No deben hacerlo quienes continúan en la misma categoría ni quienes tienen menos de seis meses de actividad.' },
  { q: '¿Qué parámetros revisa ARCA además de la facturación?', a: 'También se consideran los alquileres devengados, la superficie afectada a la actividad y la energía eléctrica consumida. La categoría la determina el parámetro más alto que corresponda.' },
  { q: '¿Puedo bajar de categoría?', a: 'Sí. Si tus ingresos y demás parámetros bajaron y ahora encuadrás en una categoría inferior, podés recategorizarte hacia abajo y pagar una cuota menor.' },
  { q: '¿Qué pasa si supero la categoría K?', a: 'Si superás el tope anual de la categoría K quedás fuera del régimen simplificado y corresponde evaluar el pase al Régimen General como Responsable Inscripto.' },
  { q: '¿Las cuotas son iguales para servicios y venta de bienes?', a: 'Los topes de facturación son iguales, pero las cuotas difieren. Desde agosto 2026 la categoría K paga $1.614.446 en servicios y $702.103 en venta de bienes.' },
  { q: '¿Dónde se hace la recategorización?', a: 'Se realiza online en el portal Monotributo de ARCA, ingresando con CUIT y clave fiscal. El sistema muestra la facturación anual y permite confirmar la nueva categoría.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/recategorizacion-monotributo-julio-2026`,
      url: `${siteUrl}/recategorizacion-monotributo-julio-2026`,
      name: title,
      description,
      inLanguage: 'es-AR',
      datePublished: '2026-04-16',
      dateModified: '2026-08-01',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Impuestos', item: `${siteUrl}/impuestos` },
        { '@type': 'ListItem', position: 3, name: 'Recategorización Monotributo 2026' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
    },
  ],
};
---

<Layout title={title} description={description} schema={schema} audience="AR">
  <Header slot="header" />

  <main class="mono-page">
    <div class="deadline-strip"><span aria-hidden="true"></span><strong>La recategorización vence el miércoles 5 de agosto.</strong><em>Quedan 4 días.</em></div>

    <section class="mono-hero">
      <div class="page-shell">
        <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><b>/</b><a href="/impuestos">Impuestos</a><b>/</b><span>Monotributo</span></nav>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Escala ARCA vigente</p>
            <h1>¿Tenés que cambiar de categoría?</h1>
            <p class="hero-lead">Sumá lo facturado en los últimos 12 meses. Te mostramos tu categoría, la nueva cuota y cuánto margen te queda.</p>
            <div class="trust-row"><span>Datos oficiales ARCA</span><span>Actualizado 1/8/2026</span><span>Gratis y sin registro</span></div>
            <div class="deadline-card"><div class="calendar"><strong>05</strong><span>agosto</span></div><div><b>Último día para recategorizarte</b><p>La nueva categoría rige desde agosto y el primer pago vence el 20/8.</p></div></div>
          </div>

          <form class="category-calc" id="category-calc">
            <div class="calc-head"><div><h2>Calculá tu categoría</h2><p>Completalo en menos de un minuto.</p></div><span>Vigente 08/2026</span></div>
            <div class="calc-tabs" role="tablist" aria-label="Tipo de cálculo">
              <button type="button" role="tab" aria-selected="true" data-mode="category">Mi categoría</button>
              <button type="button" role="tab" aria-selected="false" data-mode="quota">Mi cuota</button>
              <button type="button" role="tab" aria-selected="false" data-mode="change">¿Debo cambiar?</button>
            </div>
            <div class="calc-fields">
              <label class="wide"><span>Facturación bruta de los últimos 12 meses</span><div><b>$</b><input id="billing" type="number" min="0" step="100000" value="22000000" /></div></label>
              <label><span>Actividad</span><select id="activity"><option value="services">Servicios</option><option value="goods">Venta de bienes</option></select></label>
              <label><span>Categoría actual</span><select id="current"><option value="">No sé / alta nueva</option>{CATEGORIAS.map((cat) => <option value={cat} selected={cat === 'C'}>{cat}</option>)}</select></label>
            </div>
            <section class="calc-result" aria-live="polite">
              <div class="result-top"><div><small id="result-label">Te corresponde</small><strong id="result-value">Categoría C</strong></div><div class="result-status"><small>Estado</small><b id="result-status">Estás bien</b></div></div>
              <div class="result-stats"><span>Cuota mensual<b id="result-quota">$66.020</b></span><span>Margen hasta el tope<b id="result-margin">$2.670.494</b></span><span>Impacto anual<b id="result-annual">$792.241</b></span></div>
              <button type="submit" id="result-action">Ver resultado y próximos pasos</button>
            </section>
          </form>
        </div>
      </div>
    </section>

    <nav class="section-nav" aria-label="En esta página"><div class="page-shell"><a href="#escala">Tu categoría</a><a href="#escala">Tabla completa</a><a href="#pasos">Cómo hacerlo</a><a href="#preguntas">Preguntas frecuentes</a><a href="#fuentes">Fuentes oficiales</a></div></nav>

    <section class="page-section page-shell" id="escala">
      <div class="section-intro"><h2>Nueva escala desde agosto</h2><p>Los topes son iguales para servicios y venta de bienes. Lo que cambia es la cuota mensual, especialmente en las categorías altas.</p></div>
      <div class="table-wrap"><table><thead><tr><th>Categoría</th><th>Tope anual</th><th>Cuota servicios</th><th>Cuota bienes</th></tr></thead><tbody>{categorias.map((row) => <tr data-cat={row.cat}><td><span class="cat-pill">{row.cat}</span></td><td>{fmtAr(row.tope)}</td><td>{fmtAr(row.servicios)}</td><td>{fmtAr(row.bienes)}</td></tr>)}</tbody></table></div>
    </section>

    <section class="steps-section" id="pasos"><div class="page-shell">
      <div class="section-intro"><h2>Recategorizarte, sin vueltas</h2><p>Antes de entrar a ARCA, hacé la cuenta. Después el trámite online te lleva unos minutos.</p></div>
      <div class="step-grid">
        <article><span>1</span><h3>Sumá 12 meses</h3><p>Reuní todas las facturas emitidas entre julio 2025 y junio 2026.</p></article>
        <article><span>2</span><h3>Revisá parámetros</h3><p>Ingresos, alquileres, superficie y consumo eléctrico de la actividad.</p></article>
        <article><span>3</span><h3>Entrá a ARCA</h3><p>Portal Monotributo → Recategorizarme. El sistema muestra la facturación anual.</p></article>
        <article><span>4</span><h3>Confirmá y guardá</h3><p>Descargá la credencial y verificá el importe antes del pago del 20/8.</p></article>
      </div>
      <div class="arca-cta"><div><strong>¿Ya sabés qué categoría te corresponde?</strong><span>Hacé el trámite antes del miércoles 5 de agosto.</span></div><a href="https://www.arca.gob.ar/monotributo/ayuda/recategorizacion.asp" target="_blank" rel="noopener">Ir al portal de ARCA ↗</a></div>
    </div></section>

    <section class="page-section page-shell info-grid">
      <div><h2>Qué mira ARCA</h2><p>No alcanza con revisar la facturación. La categoría corresponde al parámetro más alto de tu actividad.</p></div>
      <div class="parameter-grid"><article><h3>Ingresos brutos</h3><p>Todo lo facturado durante los últimos 12 meses.</p></article><article><h3>Superficie</h3><p>Metros cuadrados afectados a la actividad.</p></article><article><h3>Energía</h3><p>Consumo eléctrico anual del espacio de trabajo.</p></article><article><h3>Alquileres</h3><p>Total devengado por el local durante el período.</p></article></div>
    </section>

    <section class="page-section page-shell related-section"><div class="section-intro"><h2>Seguí con tus números</h2><p>Herramientas relacionadas para verificar cuota, régimen y vencimientos.</p></div><div class="link-grid">
      <ActionCard href="/impuestos/monotributo" title="Monotributo 2026" desc="Categoría, cuota y margen hasta el tope" icon='<rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><path d="M8 10h8M8 14h5M8 18h4"/>' />
      <ActionCard href="/calculadora-monotributo-vs-responsable-inscripto" title="Monotributo vs. RI" desc="Compará ambos regímenes con tus números" icon='<path d="m16 16 3-8 3 8M2 16l3-8 3 8M7 21h10M12 3v18"/>' />
      <ActionCard href="/vencimientos-afip-2026" title="Vencimientos 2026" desc="Calendario fiscal de ARCA" icon='<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' />
    </div></section>

    <section class="page-section page-shell faq-section" id="preguntas"><div class="section-intro"><h2>Preguntas frecuentes</h2><p>Lo esencial para llegar al vencimiento sin dudas.</p></div><div class="faq-list">{faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>

    <section class="sources page-shell" id="fuentes"><h2>Fuentes oficiales</h2><p>Escala y procedimiento verificados el 1 de agosto de 2026.</p><a href="https://www.arca.gob.ar/monotributo/categorias.asp" target="_blank" rel="noopener">ARCA — montos y categorías vigentes</a><a href="https://www.arca.gob.ar/monotributo/ayuda/recategorizacion.asp" target="_blank" rel="noopener">ARCA — recategorización</a></section>
    <div class="page-shell newsletter-wrap"><Newsletter /></div>
  </main>

  <Footer slot="footer" />
</Layout>

<script define:vars={{ categorias }}>
  const root = document.getElementById('category-calc');
  if (root) {
    const money = (value) => '$' + Math.round(value).toLocaleString('es-AR');
    const billing = root.querySelector('#billing');
    const activity = root.querySelector('#activity');
    const current = root.querySelector('#current');
    let mode = 'category';
    const calculate = () => {
      const amount = Math.max(0, Number(billing.value) || 0);
      const found = categorias.find((row) => amount <= row.tope);
      document.querySelectorAll('tbody tr[data-cat]').forEach((row) => row.classList.toggle('active', Boolean(found && row.dataset.cat === found.cat)));
      if (!found) {
        root.querySelector('#result-label').textContent = 'Resultado';
        root.querySelector('#result-value').textContent = 'Fuera del régimen';
        root.querySelector('#result-status').textContent = 'Revisar con contador';
        root.querySelector('#result-quota').textContent = '—';
        root.querySelector('#result-margin').textContent = 'Superaste K';
        root.querySelector('#result-annual').textContent = '—';
        return;
      }
      const quota = activity.value === 'goods' ? found.bienes : found.servicios;
      const change = Boolean(current.value && current.value !== found.cat);
      root.querySelector('#result-label').textContent = mode === 'quota' ? 'Tu cuota estimada' : mode === 'change' ? 'Resultado de la revisión' : 'Te corresponde';
      root.querySelector('#result-value').textContent = mode === 'quota' ? money(quota) + '/mes' : mode === 'change' ? (change ? 'Cambiar de ' + current.value + ' a ' + found.cat : 'Seguir en ' + found.cat) : 'Categoría ' + found.cat;
      root.querySelector('#result-status').textContent = change ? 'Tenés que actualizar' : 'Estás bien';
      root.querySelector('#result-quota').textContent = money(quota);
      root.querySelector('#result-margin').textContent = money(found.tope - amount);
      root.querySelector('#result-annual').textContent = money(quota * 12);
    };
    root.querySelectorAll('[data-mode]').forEach((tab) => tab.addEventListener('click', () => { mode = tab.dataset.mode; root.querySelectorAll('[data-mode]').forEach((item) => item.setAttribute('aria-selected', String(item === tab))); calculate(); }));
    [billing, activity, current].forEach((control) => control.addEventListener('input', calculate));
    root.addEventListener('submit', (event) => { event.preventDefault(); calculate(); root.querySelector('#result-action').textContent = '✓ Resultado actualizado'; });
    calculate();
  }
</script>

<style>
  .mono-page { --mono-ink:#142238; --mono-muted:#607078; --mono-green:#127861; --mono-deep:#0d4e42; --mono-soft:#dff4ec; --mono-mist:#eef8f5; --mono-sand:#fff4d9; --mono-line:#dce8e4; --mono-navy:#143c4e; color:var(--mono-ink); }
  .page-shell { width:min(1120px, calc(100% - 40px)); margin-inline:auto; }
  .deadline-strip { min-height:43px; padding:8px 20px; display:flex; justify-content:center; align-items:center; gap:10px; text-align:center; background:var(--mono-sand); border-block:1px solid var(--mono-line); font-size:.82rem; }
  .deadline-strip span { width:8px; height:8px; border-radius:50%; background:#c85c2c; box-shadow:0 0 0 5px #c85c2c22; }
  .deadline-strip em { font-style:normal; }
  .mono-hero { padding:38px 0 56px; background:linear-gradient(125deg,var(--mono-mist) 0 64%,var(--mono-sand)); }
  .breadcrumbs { display:flex; gap:8px; margin-bottom:30px; font-size:.75rem; color:var(--mono-muted); }.breadcrumbs b{font-weight:400;color:#9aaba6}
  .hero-grid { display:grid; grid-template-columns:.88fr 1.12fr; gap:58px; align-items:start; }
  .eyebrow { display:flex; align-items:center; gap:10px; margin:0; color:var(--mono-green); font-size:.72rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }.eyebrow:before{content:"";width:28px;height:2px;background:currentColor}
  .hero-copy h1 { max-width:580px; margin:15px 0; font-size:clamp(2.55rem,5vw,3.65rem); line-height:1.02; letter-spacing:-.045em; }
  .hero-lead { max-width:540px; margin:0; color:var(--mono-muted); font-size:1.05rem; line-height:1.55; }
  .trust-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:22px; }.trust-row span{padding:8px 11px;border:1px solid var(--mono-line);border-radius:9px;background:#ffffffcc;color:var(--mono-muted);font-size:.7rem}
  .deadline-card { display:grid; grid-template-columns:76px 1fr; gap:14px; align-items:center; max-width:430px; margin-top:26px; }.deadline-card .calendar{padding:10px;text-align:center;background:#fff;border:1px solid var(--mono-line);border-radius:14px;box-shadow:0 10px 24px #14312a1f}.calendar strong{display:block;color:#c85c2c;font-size:1.75rem;line-height:1}.calendar span{color:var(--mono-muted);font-size:.62rem;text-transform:uppercase;letter-spacing:.08em}.deadline-card p{margin:4px 0 0;color:var(--mono-muted);font-size:.78rem;line-height:1.45}
  .category-calc { padding:26px; background:#fff; border:1px solid var(--mono-line); border-radius:20px; box-shadow:0 24px 65px #14312a1f; }
  .calc-head { display:flex; justify-content:space-between; gap:18px; margin-bottom:20px; }.calc-head h2{margin:0 0 4px;font-size:1.45rem}.calc-head p{margin:0;color:var(--mono-muted);font-size:.75rem}.calc-head>span{height:max-content;padding:7px 10px;border-radius:999px;background:var(--mono-soft);color:var(--mono-deep);font-size:.65rem;font-weight:700}
  .calc-tabs { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; margin-bottom:18px; }.calc-tabs button{min-height:40px;border:1px solid var(--mono-line);border-radius:10px;background:#fff;color:var(--mono-muted);font-size:.72rem;cursor:pointer}.calc-tabs button[aria-selected="true"]{border-color:var(--mono-green);background:var(--mono-soft);color:var(--mono-deep);font-weight:700}
  .calc-fields { display:grid; grid-template-columns:1fr 1fr; gap:10px; }.calc-fields label{padding:10px 12px;border:1px solid var(--mono-line);border-radius:11px}.calc-fields .wide{grid-column:1/-1}.calc-fields label>span{display:block;margin-bottom:6px;color:var(--mono-muted);font-size:.65rem}.calc-fields label div{display:flex;gap:7px}.calc-fields input,.calc-fields select{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--mono-ink);font-weight:700}
  .calc-result { margin-top:13px; padding:20px; border-radius:15px; background:var(--mono-navy); color:#fff; }.result-top{display:flex;justify-content:space-between;gap:15px}.result-top small,.result-stats span{color:#c9d8dc;font-size:.62rem}.result-top>div>strong{display:block;margin-top:3px;font-size:2rem;letter-spacing:-.04em}.result-status{padding:8px 10px;border-radius:9px;background:var(--mono-soft);color:var(--mono-deep);text-align:right}.result-status small{color:inherit}.result-status b{display:block;font-size:.85rem}.result-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px;padding-top:13px;border-top:1px solid #ffffff2e}.result-stats b{display:block;margin-top:4px;color:#fff;font-size:.78rem}.calc-result button{width:100%;margin-top:15px;padding:13px;border:0;border-radius:10px;background:#27a27f;color:#fff;font-weight:700;cursor:pointer}
  .section-nav { background:#fff; border-bottom:1px solid var(--mono-line); }.section-nav>div{display:flex;gap:26px;align-items:center;min-height:58px;overflow:auto;white-space:nowrap}.section-nav a{color:var(--mono-muted);font-size:.76rem}.section-nav a:first-child{color:var(--mono-deep);font-weight:700}
  .page-section,.steps-section { padding-block:54px; }.section-intro{display:grid;grid-template-columns:.85fr 1.15fr;gap:45px;align-items:end;margin-bottom:26px}.section-intro h2{margin:0;font-size:2rem;letter-spacing:-.025em}.section-intro p{margin:0;color:var(--mono-muted);line-height:1.55}
  .table-wrap{overflow:auto;border:1px solid var(--mono-line);border-radius:15px}.table-wrap table{width:100%;min-width:720px;border-collapse:collapse}.table-wrap th,.table-wrap td{padding:13px 16px;text-align:right;border-bottom:1px solid var(--mono-line);font-size:.78rem}.table-wrap th{background:var(--mono-mist);color:var(--mono-muted)}.table-wrap th:first-child,.table-wrap td:first-child{text-align:left}.table-wrap tr:last-child td{border:0}.table-wrap tr.active{background:var(--mono-soft)}.cat-pill{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:8px;background:var(--mono-mist);color:var(--mono-deep);font-weight:800}
  .steps-section { background:var(--mono-mist); border-block:1px solid var(--mono-line); }.step-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step-grid article,.parameter-grid article{padding:18px;background:#fff;border:1px solid var(--mono-line);border-radius:14px}.step-grid article>span{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:var(--mono-soft);color:var(--mono-deep);font-weight:700}.step-grid h3,.parameter-grid h3{margin:14px 0 7px;font-size:.95rem}.step-grid p,.parameter-grid p{margin:0;color:var(--mono-muted);font-size:.78rem;line-height:1.5}.arca-cta{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-top:28px;padding:22px;border:1px solid var(--mono-line);border-radius:15px;background:var(--mono-sand)}.arca-cta strong,.arca-cta span{display:block}.arca-cta span{margin-top:5px;color:var(--mono-muted);font-size:.78rem}.arca-cta a{padding:11px 16px;border-radius:10px;background:var(--mono-green);color:#fff;font-weight:700;white-space:nowrap}
  .info-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:42px}.info-grid h2{font-size:2rem;margin:0 0 10px}.info-grid>div>p{color:var(--mono-muted)}.parameter-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.parameter-grid h3{margin-top:0}
