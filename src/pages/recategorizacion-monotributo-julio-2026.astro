---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import ActionCard from '../components/ui/ActionCard.astro';
import { CATEGORIAS, TOPES, componentes } from '../lib/data/monotributo-2026';

const title = 'Recategorización Monotributo: vence 5 de agosto 2026 — nuevas escalas desde agosto | Hacé Cuentas';
const description = 'Recategorización del monotributo: vence el 5 de agosto de 2026. Nuevas escalas ARCA vigentes desde el 1 de agosto (+16,8%), categorías A a K con topes y cuotas actualizados, paso a paso y primer pago con valores nuevos el 20 de agosto.';

const siteUrl = 'https://hacecuentas.com';

const fmtAr = (n: number) => new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(n);

// Categorías monotributo 2026 — FUENTE ÚNICA: src/lib/data/monotributo-2026.ts
// (escala oficial ARCA vigente desde 2026-08-01, +16,8%). Se muestra la
// cuota de SERVICIOS; en venta de bienes las categorías altas pagan una cuota
// menor con el mismo tope de facturación. Reforma 2026: servicios llega a K.
const categorias = CATEGORIAS.map((cat) => {
  const c = componentes(cat, 'servicios');
  return {
    cat,
    ingresosAnuales: TOPES[cat],
    cuotaTotal: c.total,
    impuesto: c.integrado,
    sipa: c.sipa,
    obraSocial: c.obraSocial,
    actividad: 'Servicios y bienes',
  };
});

const faqItems = [
  {
    q: '¿Cuándo es la recategorización del monotributo julio 2026?',
    a: 'La recategorización semestral del monotributo de julio 2026 vence el 5 de agosto de 2026. Debés evaluar tus ingresos, gastos y parámetros de los últimos 12 meses (julio 2025 a junio 2026) y, si corresponde, cambiar de categoría a través del portal de ARCA (ex-AFIP).'
  },
  {
    q: '¿Qué período se evalúa en la recategorización de julio 2026?',
    a: 'Se evalúan los últimos 12 meses inmediatos anteriores, es decir, desde julio 2025 hasta junio 2026. Se analizan los ingresos brutos acumulados, los gastos inherentes a la actividad, la superficie afectada, la energía eléctrica consumida y el monto de alquileres devengados.'
  },
  {
    q: '¿Qué pasa si no me recategorizo y me corresponde un cambio?',
    a: 'Si no te recategorizás y ARCA detecta que debés estar en una categoría superior, puede recategorizarte de oficio y reclamar la diferencia de cuota más intereses. Si debías bajar de categoría, perdés la oportunidad de pagar menos hasta la próxima recategorización en enero 2027.'
  },
  {
    q: '¿Cómo sé en qué categoría me corresponde estar?',
    a: 'Sumá todos tus ingresos brutos de los últimos 12 meses. Si el total no supera el tope de tu categoría actual, no necesitás cambiar. Si lo supera, debés subir a la categoría cuyo tope cubra tus ingresos. También verificá los otros parámetros: superficie del local, energía eléctrica consumida y monto de alquileres. Usá nuestra calculadora de monotributo para determinarlo rápidamente.'
  },
  {
    q: '¿La recategorización es obligatoria aunque no cambie mi situación?',
    a: 'No. Si tus parámetros (ingresos, superficie, energía, alquileres) no cambiaron y seguís encuadrando en la misma categoría, no es necesario que hagas ningún trámite. Tu categoría se mantiene automáticamente. Solo debés recategorizarte si hay un cambio.'
  },
  {
    q: '¿Puedo recategorizarme fuera de las fechas establecidas?',
    a: 'No. La recategorización solo puede hacerse en los períodos habilitados por ARCA: enero y julio de cada año. Fuera de esas ventanas no es posible cambiar de categoría voluntariamente. La excepción es la exclusión de oficio, que ARCA puede realizar en cualquier momento.'
  },
  {
    q: '¿Qué diferencia hay entre recategorización y exclusión del monotributo?',
    a: 'La recategorización es el cambio de categoría dentro del monotributo. La exclusión implica que salís del régimen simplificado (porque superaste los topes de la categoría más alta o incumpliste requisitos) y pasás a ser Responsable Inscripto, con obligaciones tributarias más complejas (IVA, Ganancias, etc.).'
  },
  {
    q: '¿Cuándo empieza a regir la nueva categoría?',
    a: 'La nueva categoría rige desde el mes siguiente a la recategorización. Si te recategorizás en julio 2026, la nueva cuota aplica desde agosto 2026. El pago de julio se realiza con la categoría anterior.'
  },
  {
    q: '¿Puedo bajar de categoría en la recategorización?',
    a: 'Sí. Si tus ingresos de los últimos 12 meses bajaron y ahora encuadrás en una categoría inferior, podés (y debés) bajar. Esto te permitirá pagar una cuota mensual menor. Muchos monotributistas no lo saben y siguen pagando de más.'
  },
  {
    q: '¿Cuáles son las nuevas escalas del monotributo desde agosto 2026?',
    a: 'ARCA actualizó un 16,8% los topes de facturación y las cuotas, en línea con la inflación del primer semestre. Desde el 1 de agosto de 2026 la categoría A llega hasta $12.009.410 anuales con una cuota de $49.527, y la K (tope máximo del régimen) hasta $126.610.839, con cuota de $1.614.446 en servicios y $702.103 en venta de bienes. La tabla completa está en esta página.'
  },
  {
    q: '¿Cuánto se paga de monotributo en agosto 2026 y cuándo vence?',
    a: 'El pago de agosto 2026 es el primero con los valores nuevos (+16,8%) y vence el 20 de agosto. La cuota va de $49.527 (categoría A) a $1.614.446 (categoría K servicios) según la categoría en la que quedes tras la recategorización que cierra el 5 de agosto.'
  }
];

const howToSteps = [
  { name: 'Ingresá a ARCA con CUIT y clave fiscal', text: 'Accedé al portal de ARCA con tu CUIT y clave fiscal nivel 2 o superior. Si no tenés clave fiscal, podés generarla online o en una dependencia de ARCA.' },
  { name: 'Entrá al servicio "Monotributo"', text: 'En el menú de servicios, buscá "Monotributo" o "Régimen Simplificado". Si no lo tenés habilitado, agregalo desde "Administrador de Relaciones de Clave Fiscal".' },
  { name: 'Seleccioná "Recategorización"', text: 'Dentro del servicio de Monotributo, hacé clic en "Recategorización". El sistema te mostrará tu categoría actual y los parámetros vigentes.' },
  { name: 'Completá los datos del período', text: 'Ingresá tus ingresos brutos de los últimos 12 meses, la superficie afectada a la actividad, el consumo de energía eléctrica y el monto de alquileres devengados. El sistema calculará automáticamente la categoría que te corresponde.' },
  { name: 'Confirmá la nueva categoría', text: 'Verificá que la categoría sugerida sea correcta y confirmá el cambio. El sistema emitirá una constancia de recategorización que podés descargar en PDF.' },
  { name: 'Pagá la nueva cuota desde el mes siguiente', text: 'La nueva cuota del monotributo rige desde agosto 2026. Podés generar el VEP (Volante Electrónico de Pago) desde el mismo portal o configurar el débito automático.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/recategorizacion-monotributo-julio-2026`,
      url: `${siteUrl}/recategorizacion-monotributo-julio-2026`,
      name: title,
      description: description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      inLanguage: 'es-AR',
      datePublished: '2026-04-16',
      dateModified: '2026-07-22',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Finanzas', item: `${siteUrl}/categoria/finanzas` },
        { '@type': 'ListItem', position: 3, name: 'Recategorización Monotributo Julio 2026' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
    // HowTo deprecado por Google (2023, sin rich results) → dejó de emitirse.
  ],
};
---
<Layout title={title} description={description} schema={schema} audience="AR">
  <Header slot="header" />

  <article class="landing">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/categoria/finanzas">Finanzas</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Recategorización Monotributo Julio 2026</span>
    </nav>

    <!-- HERO -->
    <header class="hero">
      <h1>Recategorización Monotributo 2026: vence el 5 de agosto — nuevas escalas y paso a paso</h1>
      <p class="lead">
        Cada 6 meses (enero y julio) los monotributistas deben evaluar si les corresponde cambiar de categoría. La <strong>recategorización de julio 2026 se puede hacer del 15 de julio al 5 de agosto</strong>. En esta guía te explicamos todo: las nuevas categorías con montos actualizados, cómo hacerla en ARCA paso a paso y qué pasa si no te recategorizás.
      </p>
      <div class="hero-meta">
        <span>Actualizado: 22 de julio 2026 (escalas nuevas de agosto)</span>
        <span>Vencimiento: 5 de agosto 2026</span>
      </div>
      <p class="answer-snippet">
        <strong>Recategorización monotributo julio 2026:</strong> se evalúa la facturación de los
        últimos 12 meses (jul 2025 – jun 2026) y, si corresponde, se cambia entre las 11 categorías
        (A a K) en el portal de ARCA. La nueva cuota rige desde agosto 2026. Tabla de categorías y paso a paso abajo.
      </p>
      <p class="answer-snippet">
        ⏳ <strong>Fechas que queman:</strong> la recategorización <strong>vence el martes 5 de agosto de 2026</strong>.
        Las <strong>nuevas escalas de ARCA (+16,8%)</strong> rigen desde el <strong>1 de agosto</strong> (semestre agosto 2026 – enero 2027)
        y el <strong>primer pago con los valores nuevos vence el 20 de agosto</strong>.
      </p>
    </header>

    <!-- FECHAS CLAVE -->
    <section class="section">
      <h2>Fechas clave</h2>
      <div class="dates-grid">
        <div class="date-card">
          <div class="date-label">Período evaluado</div>
          <div class="date-value">Jul 2025 - Jun 2026</div>
          <div class="date-hint">Últimos 12 meses de actividad</div>
        </div>
        <div class="date-card accent">
          <div class="date-label">Vencimiento recategorización</div>
          <div class="date-value">5 de agosto 2026</div>
          <div class="date-hint">Fecha límite (la ventana abre el 15 de julio)</div>
        </div>
        <div class="date-card">
          <div class="date-label">Vigencia nueva categoría</div>
          <div class="date-value">Agosto 2026</div>
          <div class="date-hint">La nueva cuota aplica desde agosto</div>
        </div>
      </div>
    </section>

    <!-- TABLA DE CATEGORÍAS -->
    <section class="section">
      <h2>Categorías del monotributo desde agosto 2026 (nuevas escalas ARCA)</h2>
      <p>
        Los montos se actualizan semestralmente por inflación. Estos son los valores oficiales de ARCA <strong>vigentes desde el 1 de agosto de 2026</strong> (ajuste del +16,8% por el IPC del primer semestre), los que rigen para la recategorización que vence el 5 de agosto y para el semestre agosto 2026 – enero 2027.
        <strong>Nota:</strong> se muestra la cuota de <strong>servicios</strong>; en venta de bienes las categorías altas (D a K) pagan una cuota menor, con el mismo tope de facturación. Verificá siempre tu situación en el portal de ARCA.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Cat.</th>
              <th>Ingresos anuales (tope)</th>
              <th>Cuota total</th>
              <th>Impuesto integrado</th>
              <th>SIPA</th>
              <th>Obra social</th>
              <th>Tipo</th>
            </tr>
          </thead>
          <tbody>
            {categorias.map((c) => (
              <tr>
                <td class="cat-letter">{c.cat}</td>
                <td>{fmtAr(c.ingresosAnuales)}</td>
                <td class="highlight">{fmtAr(c.cuotaTotal)}</td>
                <td>{fmtAr(c.impuesto)}</td>
                <td>{fmtAr(c.sipa)}</td>
                <td>{fmtAr(c.obraSocial)}</td>
                <td class="tipo">{c.actividad}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Desde la reforma 2026, <strong>todas las categorías (A a K) aplican tanto para servicios como para venta de bienes</strong> — los servicios ya no topean en la H. El tope de facturación es igual para ambas actividades; en las categorías altas (I, J, K) la cuota de servicios es mayor que la de venta de bienes.
      </p>
    </section>

    <!-- CTA CALCULADORA -->
    <div class="cta-box">
      <h3>Calculá tu categoría de monotributo</h3>
      <p>Ingresá tus ingresos de los últimos 12 meses y descubrí en qué categoría deberías estar.</p>
      <a href="/calculadora-monotributo-categoria-2026-recategorizacion-julio" class="cta-btn">Calcular mi categoría para julio 2026</a>
    </div>

    <!-- WIZARD -->
    <div class="wizard-cta">
      <p>
        <strong>¿No sabés qué categoría te corresponde?</strong> Si preferís que te guiemos,
        respondé 5 preguntas y el test te dice tu categoría exacta (A a K), la cuota mensual
        y si te conviene pasarte al Régimen General.
      </p>
      <a href="/wizard/que-monotributo-me-conviene-2026">Hacer el test: ¿qué monotributo me conviene en 2026? →</a>
    </div>

    <!-- PASO A PASO -->
    <section class="section">
      <h2>Cómo recategorizarte paso a paso en ARCA</h2>
      <p>El trámite se hace 100% online a través del portal de ARCA. Te lleva aproximadamente 15 minutos.</p>
      <div class="steps-list">
        {howToSteps.map((step, i) => (
          <div class="step">
            <div class="step-num">{i + 1}</div>
            <div class="step-content">
              <h4>{step.name}</h4>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- QUÉ EVALUAR -->
    <section class="section">
      <h2>Parámetros que se evalúan en la recategorización</h2>
      <p>No solo importan los ingresos. ARCA evalúa múltiples parámetros para determinar tu categoría:</p>
      <div class="params-grid">
        <div class="param-card">
          <h4>Ingresos brutos anuales</h4>
          <p>Sumá todo lo facturado en los últimos 12 meses (julio 2025 a junio 2026). Es el parámetro principal.</p>
        </div>
        <div class="param-card">
          <h4>Superficie afectada</h4>
          <p>Los metros cuadrados del local o espacio donde desarrollás tu actividad. No aplica si trabajás desde tu casa sin un espacio exclusivo.</p>
        </div>
        <div class="param-card">
          <h4>Energía eléctrica consumida</h4>
          <p>El consumo anual en kW del local afectado a la actividad. Verificá tus facturas de luz de los últimos 12 meses.</p>
        </div>
        <div class="param-card">
          <h4>Alquileres devengados</h4>
          <p>El monto anual pagado por alquiler del local donde se desarrolla la actividad. Si sos propietario, este parámetro no aplica.</p>
        </div>
      </div>
    </section>

    <!-- MONOTRIBUTO VS RI -->
    <section class="section">
      <h2>Monotributo vs. Responsable Inscripto: cuándo conviene pasar</h2>
      <p>
        Si estás cerca del tope de la categoría K (el tope más alto del monotributo, ahora igual para servicios y para venta de bienes), es buen momento para evaluar si te conviene pasarte a Responsable Inscripto. En algunos casos, especialmente si tenés muchos gastos deducibles, el régimen general puede ser más conveniente.
      </p>
      <p>
        Usá nuestra <a href="/calculadora-monotributo-vs-responsable-inscripto">calculadora comparativa Monotributo vs. RI</a> para simular ambos escenarios con tus números reales.
      </p>
    </section>

    <!-- LINKS RELACIONADOS -->
    <section class="section">
      <h2>Calculadoras relacionadas</h2>
      <div class="link-grid">
        <ActionCard href="/calculadora-monotributo-2026" title="Calculadora Monotributo 2026" desc="Calculá tu cuota mensual según categoría" icon='<rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>' />
        <ActionCard href="/calculadora-monotributo-categoria-ingresos-tope" title="Categoría por Ingresos" desc="Averiguá qué categoría te corresponde según tus ingresos" icon='<circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="M7 6h1v4"/><path d="m16.71 13.88.7.71-2.82 2.82"/>' />
        <ActionCard href="/calculadora-monotributo-vs-responsable-inscripto" title="Monotributo vs. Resp. Inscripto" desc="Compará cuál régimen te conviene más" icon='<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>' />
        <ActionCard href="/calculadora-ganancias-empleados-4ta-categoria-2026" title="Impuesto a las Ganancias" desc="Calculá Ganancias si pasás a Resp. Inscripto" icon='<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>' />
        <ActionCard href="/vencimientos-afip-2026" title="Vencimientos AFIP 2026" desc="Calendario fiscal completo: monotributo, IVA, Ganancias" icon='<rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>' />
        <ActionCard href="/wizard/que-monotributo-me-conviene-2026" title="Test: ¿qué monotributo me conviene?" desc="5 preguntas y sabés tu categoría exacta y la cuota" icon='<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>' />
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq-section">
      <h2>Preguntas frecuentes sobre la recategorización julio 2026</h2>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <Newsletter />
  </article>

  <Footer slot="footer" />
</Layout>

<style>
  .landing { max-width: 860px; margin: 0 auto; padding: 0 0 3rem; }
  .breadcrumbs { font-size: 0.875rem; color: var(--text-subtle); margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .breadcrumbs a { color: var(--text-muted); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }
  .breadcrumbs .sep { color: var(--border-strong); }

  .hero { margin-bottom: 2.5rem; }
  .hero h1 { margin-bottom: 1rem; }
  .lead { font-size: 1.0625rem; color: var(--text-muted); margin-bottom: 1rem; max-width: 760px; line-height: 1.65; }
  .hero-meta { display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.8125rem; color: var(--text-subtle); }
  .answer-snippet { font-size: 1rem; line-height: 1.65; background: var(--bg-soft, #f4f6f9); border-left: 4px solid var(--accent, #2563eb); border-radius: 0.4rem; padding: 0.9rem 1.1rem; margin: 1.1rem 0 0; color: var(--text, #222); max-width: 760px; }

  .section { margin-bottom: 2.5rem; }
  .section h2 { margin-bottom: 0.75rem; }
  .section h3 { margin: 1.25rem 0 0.5rem; font-size: 1.125rem; }
  .section p { margin-bottom: 0.75rem; color: var(--text-muted); line-height: 1.65; }

  .dates-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.875rem; margin-top: 1rem; }
  .date-card {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: 1.25rem; box-shadow: var(--shadow-sm);
  }
  .date-card.accent { background: var(--accent-soft); border-color: var(--accent); }
  .date-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-subtle); margin-bottom: 0.375rem; }
  .date-card.accent .date-label { color: var(--accent-strong); }
  .date-value { font-size: 1.25rem; font-weight: 700; color: var(--text); margin-bottom: 0.25rem; }
  .date-card.accent .date-value { color: var(--accent-strong); }
  .date-hint { font-size: 0.8125rem; color: var(--text-subtle); }

  /* Table */
  .table-wrap { overflow-x: auto; margin: 1rem 0; border-radius: var(--radius-lg); border: 1px solid var(--border); }
  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; font-feature-settings: 'tnum'; }
  thead { background: var(--bg-soft); }
  th {
    padding: 0.75rem 0.75rem; text-align: left; font-size: 0.75rem; font-weight: 600;
    color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em;
    border-bottom: 1px solid var(--border); white-space: nowrap;
  }
  td { padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--border); color: var(--text-muted); }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--bg-soft); }
  .cat-letter { font-weight: 800; color: var(--accent-strong); font-size: 1rem; }
  .highlight { font-weight: 700; color: var(--success); }
  .tipo { font-size: 0.75rem; color: var(--text-subtle); }
  .table-note { font-size: 0.8125rem; color: var(--text-subtle); margin-top: 0.5rem; }

  /* CTA */
  .cta-box {
    text-align: center; padding: 2rem 1.5rem; margin: 2rem 0;
    background: linear-gradient(135deg, var(--accent-soft) 0%, var(--bg-soft) 100%);
    border: 1px solid var(--accent); border-radius: var(--radius-lg);
  }
