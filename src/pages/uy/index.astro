---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import PillarHub from '../../components/PillarHub.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
import { canDistributeCalc } from '../../lib/content-policy';
import { URUGUAY_2026, fmtUYU } from '../../lib/data/uruguay-2026';

const localeModules = import.meta.glob<any>('../../content/calcs-uy/*.json', { eager: true });
const mainModules = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
const localeCalcs = Object.values(localeModules).map((m: any) => m.default || m).filter((c: any) => canDistributeCalc(c, 'uy'));
const audienceFiltered = Object.values(mainModules)
  .map((m: any) => m.default || m)
  .filter((c: any) => c.audience === 'UY' && canDistributeCalc(c));
const calcs = [...localeCalcs, ...audienceFiltered];

const localeSlugs = new Set(localeCalcs.map((c: any) => c.slug));
function calcUrl(c: any): string {
  return localeSlugs.has(c.slug) ? `/uy/${c.slug}` : `/${c.slug}`;
}

const byCategory: Record<string, any[]> = {};
calcs.forEach((c) => {
  if (!byCategory[c.category]) byCategory[c.category] = [];
  byCategory[c.category].push(c);
});

const categoryMeta: Record<string, { label: string; desc: string; color: string; icon: string }> = {
  finanzas:        { label: 'Finanzas',       desc: 'Sueldo líquido, jornal, aguinaldo, aportes BPS y dólar BCU.',   color: '#2563eb', icon: '💰' },
  impuestos:       { label: 'Impuestos',      desc: 'IRPF, IASS, IVA 22%/10%, IRAE 25% (DGI).',                     color: '#7c3aed', icon: '🧾' },
  salud:           { label: 'Salud',          desc: 'IMC, calorías, embarazo, fitness.',                  color: '#16a34a', icon: '❤️' },
  familia:         { label: 'Familia',        desc: 'Licencia maternidad, hijos, escolarización.',                  color: '#db2777', icon: '👨‍👩‍👧' },
  vida:            { label: 'Vida cotidiana', desc: 'Alquiler en UI, costo de vida, mercado.',               color: '#d97706', icon: '🏠' },
  automotor:       { label: 'Automotor',      desc: 'Combustible, patente, gasto del auto.',                       color: '#6366f1', icon: '🚗' },
  educacion:       { label: 'Educación',      desc: 'Becas, créditos universitarios, promedios.',                color: '#8b5cf6', icon: '🎓' },
  negocios:        { label: 'Negocios',       desc: 'Márgenes, IVA, IRAE, modelos fiscales.',                   color: '#0891b2', icon: '📊' },
  marketing:       { label: 'Marketing',      desc: 'CTR, CPC, ROAS, CAC, LTV.',                          color: '#e11d48', icon: '📈' },
  deportes:        { label: 'Deportes',       desc: 'Pace, 1RM, VO2 max, ciclismo.',                      color: '#65a30d', icon: '🏃' },
  viajes:          { label: 'Viajes',         desc: 'Combustible, presupuesto, propinas.',                color: '#0891b2', icon: '✈️' },
  cocina:          { label: 'Cocina',         desc: 'Tazas a gramos, ajustar receta.',                    color: '#ea580c', icon: '🍳' },
  mascotas:        { label: 'Mascotas',       desc: 'Edad perro/gato, alimentación.',                     color: '#db2777', icon: '🐕' },
  matematica:      { label: 'Matemática',     desc: 'Promedios, Pitágoras, conversores.',                 color: '#0d9488', icon: '🧮' },
  tecnologia:      { label: 'Tecnología',     desc: 'Almacenamiento, IA, batería, cloud.',                color: '#06b6d4', icon: '💻' },
  'medio-ambiente':{ label: 'Medio Ambiente', desc: 'Huella de carbono, energía solar.',                  color: '#22c55e', icon: '🌱' },
  electronica:     { label: 'Electrónica',    desc: 'Ley de Ohm, kWh, circuitos.',                        color: '#f59e0b', icon: '⚡' },
  ciencia:         { label: 'Ciencia',        desc: 'Física, química, astronomía.',                       color: '#6366f1', icon: '🔬' },
  jardineria:      { label: 'Jardinería',     desc: 'Riego, tierra, siembra.',                            color: '#15803d', icon: '🌿' },
  construccion:    { label: 'Construcción',   desc: 'Materiales, presupuesto reforma.',                   color: '#b45309', icon: '🧱' },
};

const categoryOrder = ['finanzas','impuestos','vida','familia','salud','automotor','educacion','negocios','marketing','deportes','viajes','cocina','mascotas','matematica','tecnologia','medio-ambiente','electronica','ciencia','jardineria','construccion'];
const activeCategories = categoryOrder.filter((cat) => byCategory[cat] && byCategory[cat].length > 0);

const totalCalcs = calcs.length;

const popularSlugs = [
  'salario-liquido-uruguay',
  'calculadora-irpf-uruguay',
  'calculadora-despido-uruguay',
  'dolar-hoy-uruguay',
  'calculadora-iva-uruguay',
  'calculadora-jornal-uruguay'
];
const popular = popularSlugs.map((s) => calcs.find((c) => c.slug === s)).filter(Boolean);

// ── Datos clave 2026 — todo computado desde src/lib/data/uruguay-2026.ts (fuente única, nunca stale) ──
const U = URUGUAY_2026;
const fmtPct = (n: number) => new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 }).format(n);
const mniIrpf = U.irpf.minimoNoImponibleBpc * U.bpc;   // 7 BPC
const mniIass = U.iass.minimoNoImponibleBpc * U.bpc;   // 9 BPC
const fonasaBaja = Math.round(U.bps.fonasa.hasta25.soloTrabajador * 1000) / 10;
const fonasaAlta = Math.round(U.bps.fonasa.mas25.soloTrabajador * 1000) / 10;
const montepioPct = Math.round(U.bps.montepio * 1000) / 10;

const datosClave = [
  { k: 'Salario mínimo nacional (SMN)', v: `${fmtUYU(U.smn.mensualEnero)} /mes (ene) · ${fmtUYU(U.smn.mensualJulio)} /mes (jul)`, src: 'MTSS · Decreto N° 319/025' },
  { k: 'Jornal mínimo (SMN ÷ 25)', v: `${fmtUYU(U.smn.jornalEnero)} (ene) · ${fmtUYU(U.smn.jornalJulio)} (jul)`, src: 'MTSS · Decreto N° 319/025' },
  { k: 'Base de Prestaciones y Contribuciones (BPC)', v: `${fmtUYU(U.bpc)}`, src: 'BPS · Decreto N° 11/026' },
  { k: 'Aporte jubilatorio personal (montepío)', v: `${fmtPct(montepioPct)}% del nominal`, src: 'BPS · Ley 16.713' },
  { k: 'Aporte FONASA (salud)', v: `${fmtPct(fonasaBaja)}% (hasta 2,5 BPC) a ${fmtPct(fonasaAlta)}%+ (más de 2,5 BPC)`, src: 'BPS · SNIS' },
  { k: 'IRPF — mínimo no imponible', v: `${U.irpf.minimoNoImponibleBpc} BPC = ${fmtUYU(mniIrpf)} /mes exento`, src: 'DGI · BPS Com. R 5/2026' },
  { k: 'IRPF — escala marginal', v: `0% → 36% (8 franjas en BPC)`, src: 'DGI · Cat. II' },
  { k: 'IASS — jubilaciones y pensiones', v: `exento hasta ${U.iass.minimoNoImponibleBpc} BPC (${fmtUYU(mniIass)}); 6% → 30%`, src: 'DGI / BPS' },
  { k: 'IVA (tasa básica / mínima)', v: `${fmtPct(U.iva.basica * 100)}% / ${fmtPct(U.iva.minima * 100)}%`, src: 'DGI · Ley del IVA' },
  { k: 'IRAE (rentas de empresas)', v: `${fmtPct(U.irae * 100)}%`, src: 'DGI · Título 4' },
  { k: 'Aguinaldo (Sueldo Anual Complementario)', v: `1/12 de lo cobrado en el semestre (junio y diciembre)`, src: 'MTSS · Ley 12.840' },
  { k: 'Licencia anual', v: `${U.laboral.licenciaDiasBase} días + 1 día cada 4 años (desde el 5º)`, src: 'MTSS · Ley 12.590' },
  { k: 'Indemnización por despido (mensual)', v: `1 sueldo por año, tope ${U.laboral.despido.mensual.topeMeses} mensualidades`, src: 'MTSS · Ley 10.489' },
];

// ── FAQ país-específica: respuestas con cifras computadas desde la fuente única ──
const faq = [
  {
    q: '¿Cuánto es el salario mínimo en Uruguay 2026?',
    a: `El salario mínimo nacional (SMN) es de ${fmtUYU(U.smn.mensualEnero)} mensuales desde el 1 de enero de 2026 y sube a ${fmtUYU(U.smn.mensualJulio)} desde el 1 de julio (Decreto N° 319/025, MTSS). El decreto define el jornal como SMN ÷ 25 (${fmtUYU(U.smn.jornalEnero)} en enero) y la hora como SMN ÷ 200. El aumento acumulado del año es del ${fmtPct(U.smn.aumentoAnualPct * 100)}%.`,
  },
  {
    q: '¿Cómo se calcula el sueldo líquido en Uruguay?',
    a: `Al salario nominal se le descuentan los aportes personales a BPS (montepío jubilatorio ${fmtPct(montepioPct)}%, FONASA entre ${fmtPct(fonasaBaja)}% y ${fmtPct(fonasaAlta)}%+ según el nominal y la familia a cargo, y el Fondo de Reconversión Laboral 0,1%) y, si corresponde, el IRPF. El líquido = nominal − aportes BPS − IRPF. Nuestra calculadora de sueldo líquido lo hace con la escala 2026 sobre la BPC de ${fmtUYU(U.bpc)}.`,
  },
  {
    q: '¿Qué me descuenta BPS del sueldo?',
    a: `BPS te descuenta del nominal: el montepío (aporte jubilatorio personal) del ${fmtPct(montepioPct)}%, el FONASA para la salud (${fmtPct(fonasaBaja)}% si ganás hasta 2,5 BPC = ${fmtUYU(U.bps.fonasa.umbralBpc * U.bpc)}, y desde ${fmtPct(fonasaAlta)}% si superás ese tope, más adicionales por cónyuge o hijos a cargo) y el Fondo de Reconversión Laboral del 0,1%. El aporte patronal (jubilatorio 7,5% + FONASA 5%) lo paga el empleador, no sale de tu recibo.`,
  },
  {
    q: '¿Cuánto IRPF pago en Uruguay 2026?',
    a: `El IRPF de Categoría II (trabajo dependiente) tiene un mínimo no imponible de ${U.irpf.minimoNoImponibleBpc} BPC = ${fmtUYU(mniIrpf)} por mes: por debajo de eso no pagás. Por encima se aplica una escala progresiva por franjas en BPC con tasas del 10% al 36%. Las deducciones (aportes BPS, hijos a cargo, etc.) no se restan de la base sino que generan un crédito a tasa 14% (nominal menor a 15 BPC) u 8% que se descuenta del impuesto.`,
  },
  {
    q: '¿Cuándo se cobra el aguinaldo en Uruguay?',
    a: `El aguinaldo (Sueldo Anual Complementario) se paga en dos cuotas: la primera antes del 30 de junio (por lo cobrado entre diciembre y mayo) y la segunda antes del 20 de diciembre (por lo cobrado entre junio y noviembre). Cada cuota equivale a 1/12 del total de remuneraciones percibidas en ese semestre (Ley 12.840).`,
  },
  {
    q: '¿Qué es el salario vacacional y cuánto es?',
    a: `El salario vacacional es una suma extra que se paga junto con la licencia anual para que la disfrutes mejor. Equivale aproximadamente al jornal líquido (neto de aportes BPS) multiplicado por los días de licencia que te tomás. Una aproximación habitual es (sueldo nominal × ~0,81 ÷ 30) × días de licencia. Se cobra antes de iniciar las vacaciones.`,
  },
  {
    q: '¿Cuántos días de licencia me corresponden por año?',
    a: `La licencia anual base es de ${U.laboral.licenciaDiasBase} días por cada año calendario completo de trabajo (Ley 12.590). A partir del 5º año de antigüedad se suma 1 día adicional cada 4 años. Si trabajaste menos de un año completo, la licencia se prorratea por los meses efectivamente trabajados.`,
  },
  {
    q: '¿Cuánto es el IVA en Uruguay?',
    a: `El IVA en Uruguay tiene una tasa básica del ${fmtPct(U.iva.basica * 100)}% (la mayoría de los bienes y servicios) y una tasa mínima del ${fmtPct(U.iva.minima * 100)}% para productos de la canasta (alimentos, medicamentos, servicios de salud, etc.). Lo recauda la DGI y ya viene incluido en el precio final que pagás.`,
  },
  {
    q: '¿Cómo se calcula la indemnización por despido (IPD)?',
    a: `Para mensuales, la indemnización por despido es 1 mensualidad por cada año de antigüedad (la fracción cuenta como año entero), con un tope de ${U.laboral.despido.mensual.topeMeses} mensualidades a partir de los 7 años (Ley 10.489). Para jornaleros se calcula en jornales: ${U.laboral.despido.jornalero.jornalesPorAnio} jornales por año, con tope de ${U.laboral.despido.jornalero.topeJornales}. Si trabajaste menos de 100 jornadas no hay derecho a IPD.`,
  },
  {
    q: '¿A cuánto está el dólar en Uruguay hoy?',
    a: `El dólar interbancario del BCU está alrededor de ${fmtUYU(U.usd.interbancario)} por dólar (referencia de ${U.usd.fecha}). En la pizarra del BROU cotiza a ${fmtUYU(U.usd.brouCompra)} la compra y ${fmtUYU(U.usd.brouVenta)} la venta. El dólar cambia todos los días hábiles: para el valor exacto consultá la cotización en vivo del BCU o el BROU.`,
  },
];

// ── Equivalencias AR → UY: inyecta autoridad interna desde el catálogo argentino ya posicionado ──
const equivalentesAr = [
  { ar: 'sueldo-en-mano-argentina', arLabel: 'Sueldo en mano Argentina', uy: 'salario-liquido-uruguay', uyLabel: 'Sueldo líquido Uruguay', concepto: 'Sueldo líquido' },
  { ar: 'calculadora-ganancias-cuarta-categoria', arLabel: 'Impuesto a las Ganancias (4ª) Argentina', uy: 'calculadora-irpf-uruguay', uyLabel: 'IRPF Uruguay', concepto: 'Impuesto a la renta del trabajo' },
  { ar: 'calculadora-indemnizacion-despido', arLabel: 'Indemnización por despido Argentina', uy: 'calculadora-despido-uruguay', uyLabel: 'Despido / IPD Uruguay', concepto: 'Indemnización por despido' },
  { ar: 'liquidacion-final-trabajo', arLabel: 'Liquidación final Argentina', uy: 'liquidacion-final-uruguay', uyLabel: 'Liquidación final Uruguay', concepto: 'Liquidación por egreso' },
  { ar: 'calculadora-iva', arLabel: 'IVA Argentina', uy: 'calculadora-iva-uruguay', uyLabel: 'IVA Uruguay (22% / 10%)', concepto: 'IVA' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['CollectionPage', 'WebPage'],
      '@id': 'https://hacecuentas.com/uy#webpage',
      url: 'https://hacecuentas.com/uy',
      name: 'Calculadoras Uruguay 2026 — IRPF, IVA, sueldo líquido, BPS, dólar | Hacé Cuentas',
      description: `Calculadoras gratis específicas para Uruguay.`,
      inLanguage: 'es-UY',
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      breadcrumb: { '@id': 'https://hacecuentas.com/uy#breadcrumb' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://hacecuentas.com/uy#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Hacé Cuentas', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Uruguay', item: 'https://hacecuentas.com/uy' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://hacecuentas.com/uy#faq',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Dataset',
      '@id': 'https://hacecuentas.com/uy#datos-2026',
      name: 'Datos laborales, fiscales y cambiarios de Uruguay 2026',
      description: `Valores oficiales vigentes en Uruguay 2026: salario mínimo nacional (${fmtUYU(U.smn.mensualEnero)}), BPC (${fmtUYU(U.bpc)}), aportes personales a BPS (montepío ${fmtPct(montepioPct)}% + FONASA), IRPF Categoría II (mínimo no imponible ${U.irpf.minimoNoImponibleBpc} BPC, escala 0%–36%), IASS, IVA 22%/10%, IRAE 25% y parámetros laborales (aguinaldo, licencia, indemnización por despido).`,
      url: 'https://hacecuentas.com/uy',
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      inLanguage: 'es-UY',
      temporalCoverage: '2026',
      spatialCoverage: { '@type': 'Place', name: 'Uruguay' },
      creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
      sourceOrganization: [
        { '@type': 'GovernmentOrganization', name: 'BPS — Banco de Previsión Social', url: 'https://www.bps.gub.uy' },
        { '@type': 'GovernmentOrganization', name: 'DGI — Dirección General Impositiva', url: 'https://www.dgi.gub.uy' },
        { '@type': 'GovernmentOrganization', name: 'MTSS — Ministerio de Trabajo y Seguridad Social', url: 'https://www.gub.uy/ministerio-trabajo-seguridad-social' },
      ],
      keywords: ['salario mínimo Uruguay 2026', 'BPC 2026', 'IRPF Uruguay', 'IASS', 'IVA 22% Uruguay', 'IRAE 25%', 'aportes BPS', 'sueldo líquido Uruguay', 'aguinaldo Uruguay', 'dólar hoy Uruguay'],
    },
  ],
};

// Set hreflang único y simétrico para todas las homes (es + en + pt +
// 6 verticales + global), x-default → home raíz. Ver src/lib/hreflang.ts.
const hreflangTags = HOME_HREFLANG;

// Identidad de hub (mockup): hero vía PillarHub full-bleed; el contenido del país
// (populares, categorías, datos, FAQ) se preserva debajo dentro de .cc-index.
const hubConfig = {
  color: '#2563eb',
  nav: 'Uruguay',
  h1: 'Calculadoras para Uruguay',
  breadcrumb: [{ label: 'Hacé Cuentas', href: '/' }, { label: 'Uruguay' }],
  eyebrow: '🇺🇾 Uruguay · 2026',
  titleLines: ['Calculadoras', 'para Uruguay'],
  lead: 'Sueldo líquido, aportes BPS, IRPF, IASS, IVA, jornal, aguinaldo, despido y el dólar del BCU. Datos oficiales del BPS, la DGI y el MTSS. Gratis.',
  trust: [`${totalCalcs} calculadoras`, 'Datos oficiales 2026', 'Gratis y sin registro'],
  quick: { tag: 'Dato en vivo', title: 'Dólar hoy en Uruguay', desc: 'Cotización de mercado (BCU), actualizada a diario.', cta: 'Ver dólar hoy →', href: '/dolar-hoy-uruguay', variant: 'cta' as const },
  needsKicker: '', needsTitle: '', needsSub: '', needs: [] as any[],
  featuredKicker: '', featuredTitle: '', featuredSub: '', showFeaturedSearch: false, filterBadges: [] as string[], cards: [] as any[],
  roomsKicker: '', roomsTitle: '', roomsSub: '', rooms: [] as any[], factsTitle: '', facts: [] as any[],
};
---

<Layout
  title="Calculadoras Uruguay 2026 — IRPF, IVA, sueldo líquido, BPS, dólar | Hacé Cuentas"
  description={`${totalCalcs} calculadoras gratis para Uruguay: sueldo líquido, aportes BPS, IRPF, IASS, IVA, jornal, aguinaldo, despido y dólar BCU. Datos oficiales 2026.`}
  lang="es"
  audience="UY"
  hreflang={hreflangTags}
  schema={schema}
  pageType="hub"
>
  <Header slot="header" />

  <PillarHub config={hubConfig} />

  <div class="cc-index">

    {popular.length > 0 && (
      <section class="popular-section" aria-label="Más usadas">
        <h2 class="popular-title">Más usadas en Uruguay</h2>
        <div class="popular-grid">
          {popular.map((c: any) => (
            <a href={calcUrl(c)} class="popular-card">
              <span class="popular-icon">{c.icon || '🧮'}</span>
              <span class="popular-label">{c.h1}</span>
            </a>
          ))}
          <a href="/uy/validar-cedula" class="popular-card"><span class="popular-icon">🪪</span><span class="popular-label">Validar cédula uruguaya</span></a>
        </div>
      </section>
    )}

    <section class="datos-clave" aria-labelledby="datos-clave-title">
      <h2 id="datos-clave-title">Datos clave de Uruguay 2026</h2>
      <p class="section-sub">Los valores oficiales que usan todas nuestras calculadoras uruguayas. Uso libre con atribución (CC-BY 4.0).</p>
      <div class="dc-wrap">
        <table class="dc-table">
          <thead>
            <tr><th>Concepto</th><th>Valor 2026</th><th>Fuente</th></tr>
          </thead>
          <tbody>
            {datosClave.map((d) => (
              <tr><td>{d.k}</td><td>{d.v}</td><td class="dc-src">{d.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dc-note">Última revisión: {U.usd.fecha}. Fuentes: BPS, DGI, MTSS e INE. El SMN tiene un ajuste en julio y el dólar del BCU cambia a diario.</p>
    </section>

    <section class="popular-section" aria-label="Más recursos de Uruguay">
      <h2 class="popular-title">Más recursos de Uruguay</h2>
      <div class="popular-grid">
        <a href="/dolar-hoy-uruguay" class="popular-card"><span class="popular-icon">📈</span><span class="popular-label">Dólar hoy EN VIVO (cotización + euro y real)</span></a>
        <a href="/uy/dolar-hoy-uruguay" class="popular-card"><span class="popular-icon">💵</span><span class="popular-label">Conversor dólar ⇄ peso uruguayo</span></a>
        <a href="/uy/calculadora-jornal-uruguay" class="popular-card"><span class="popular-icon">📅</span><span class="popular-label">Jornal ⇄ mensual ⇄ hora</span></a>
        <a href="/datos-salario-minimo-latam-2026" class="popular-card"><span class="popular-icon">🌎</span><span class="popular-label">Salario mínimo LATAM</span></a>
      </div>
    </section>

    <div class="categories">
      {activeCategories.map((catKey) => {
        const meta = categoryMeta[catKey];
        const catCalcs = byCategory[catKey];
        return (
          <section class="category-section" aria-labelledby={`cat-${catKey}`}>
            <div class="cat-header">
              <span class="cat-icon" aria-hidden="true" style={`background: ${meta?.color}18`}>{meta?.icon ?? '📁'}</span>
              <div class="cat-meta">
                <h2 id={`cat-${catKey}`} class="cat-label">{meta?.label ?? catKey}</h2>
                {meta?.desc && <p class="cat-desc">{meta.desc}</p>}
              </div>
            </div>
            <div class="calc-grid">
              {catCalcs.map((calc: any) => (
                <a href={calcUrl(calc)} class="calc-card">
                  <span class="card-icon" aria-hidden="true">{calc.icon}</span>
                  <div class="card-body">
                    <span class="card-title">{calc.h1}</span>
                    <span class="card-desc">{calc.description}</span>
                  </div>
