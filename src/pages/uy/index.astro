---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import UruguayHomeExperience from '../../components/generated/UruguayHomeExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
const canonical='https://hacecuentas.com/uy';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Hacé Cuentas Uruguay",url:canonical,operatingSystem:'Web'};
---
<Layout title="Calculadoras de Uruguay: sueldo, BPS, impuestos y finanzas | Hacé Cuentas" description="Calculá sueldo, aguinaldo, BPS, IRPF, jubilación, préstamos, vivienda y auto en Uruguay con datos y fuentes locales." canonical={canonical} schema={schema} lang="es" hreflang={HOME_HREFLANG}>
  <Header />
  <UruguayHomeExperience />
  <RecoveredHubIntro eyebrow="Uruguay" h1="Calculadoras para Uruguay" lede="Herramientas locales para sueldo, BPS, impuestos, vivienda y finanzas personales." note="Cada resultado muestra sus supuestos para que puedas interpretarlo correctamente." links={[{href:'/uy/calculadoras',title:'Todas las calculadoras',description:'Catálogo completo para Uruguay.'},{href:'/uy/trabajo',title:'Trabajo',description:'Sueldo líquido, BPS y liquidación final.'},{href:'/uy/finanzas',title:'Finanzas',description:'Préstamos, unidades, compras y jubilación.'}]} />
  <Footer />
</Layout>
