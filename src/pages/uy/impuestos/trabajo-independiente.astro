---
/**
 * Hub de decisión UY — "Trabajo independiente": IRPF de servicios personales,
 * monotributo BPS, IRAE e IVA.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  BPC,
  IVA,
  IRAE,
  IRPF_FRANJAS,
  IRPF_DEDUCCION,
  FICTO_GASTOS,
  MONOTRIBUTO,
} from '../../../lib/hubs/uy/trabajo-independiente';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="UY"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ BPC, IVA, IRAE, FRANJAS: IRPF_FRANJAS, DED: IRPF_DEDUCCION, FICTO: FICTO_GASTOS, MONO: MONOTRIBUTO }}
>
  (function () {
    const H = window.HC_HUB;
    const uyu = (n) => '$U ' + new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 }).format(Math.round(n || 0));
    const num = (n, d) => new Intl.NumberFormat('de-DE', { maximumFractionDigits: d === undefined ? 1 : d }).format(n || 0);

    /** Escala del IRPF anualizada: las franjas mensuales en BPC × 12. */
    function irpfAnual(base) {
      if (base <= 0) return 0;
      const bpcAnual = BPC * 12;
      let imp = 0, antBpc = 0;
      for (const f of FRANJAS) {
        const limite = f.hastaBpc === null ? Infinity : f.hastaBpc * bpcAnual;
        const piso = antBpc * bpcAnual;
        const enTramo = Math.min(base, limite) - piso;
        if (enTramo <= 0) { antBpc = f.hastaBpc === null ? Infinity : f.hastaBpc; continue; }
        imp += enTramo * f.tasa;
        antBpc = f.hastaBpc === null ? Infinity : f.hastaBpc;
        if (base <= limite) break;
      }
      return imp;
    }

    function factorGradualidad(meses) {
      for (const g of MONO.gradualidad) {
        if (g.hastaMeses === null || meses <= g.hastaMeses) return g.factor;
      }
      return 1;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'servicios';
      const ingresos = Math.max(0, v.ingresos || 0);
      const gastos = Math.max(0, v.gastos || 0);
      const aportes = Math.max(0, v.aportes || 0);
      const hijos = Math.max(0, Math.round(v.hijos || 0));
      const meses = Math.max(0, Math.round(v.meses || 0));
      const cobertura = String(v.cobertura || 'individual');
      const tasaIva = String(v.tasaIva || 'basica') === 'minima' ? IVA.minima : IVA.basica;

      // ── IRPF servicios personales ──
      const deduccionFicta = ingresos * FICTO;
      const usaReales = gastos > deduccionFicta;
      const deduccionGastos = usaReales ? Math.min(gastos, ingresos) : deduccionFicta;
      const rentaNeta = Math.max(0, ingresos - deduccionGastos);
      const primario = irpfAnual(rentaNeta);
      const umbralAnual = DED.umbralBpc * 12 * BPC;
      const tasaCredito = ingresos < umbralAnual ? DED.tasaBaja : DED.tasaAlta;
      const baseCredito = aportes + hijos * DED.hijoMenorBpcAnual * BPC;
      const credito = baseCredito * tasaCredito;
      const irpf = Math.max(0, primario - credito);

      // ── Monotributo ──
      const cuotaPlena = MONO.cuotas[cobertura] === undefined ? MONO.cuotas.individual : MONO.cuotas[cobertura];
      const parteSalud = cuotaPlena - MONO.aporteJubilatorioBase;
      const factor = factorGradualidad(meses);
      const cuotaMono = MONO.aporteJubilatorioBase * factor + parteSalud;
      const monoAnual = cuotaMono * 12;
      const superaTope = ingresos > MONO.topeAnual;

      // ── IRAE ──
      const rentaFiscal = ingresos - gastos;
      const irae = Math.max(0, rentaFiscal) * IRAE;

      // ── IVA ──
      const ivaSobreNeto = ingresos * tasaIva;
      const conIva = ingresos + ivaSobreNeto;
      const netoSiIncluye = ingresos / (1 + tasaIva);
      const ivaContenido = ingresos - netoSiIncluye;

      const rows = [];
      let total = 0;
      let sub = '';
      let chart = [];

      if (id === 'monotributo') {
        total = monoAnual;
        rows.push({ k: 'Facturación anual declarada', ref: 'Base para el control del tope', v: ingresos });
        rows.push({ k: 'Cuota plena de monotributo', ref: 'Cobertura seleccionada · referencial BPS', v: cuotaPlena });
        rows.push({
          k: 'Gradualidad del aporte jubilatorio',
          ref: meses + (meses === 1 ? ' mes' : ' meses') + ' de antigüedad',
          v: factor * 100,
          format: 'unit',
          unit: '%',
        });
        rows.push({ k: 'Componente jubilatorio con gradualidad', ref: 'Base × factor', v: MONO.aporteJubilatorioBase * factor });
        rows.push({ k: 'Componente de cobertura de salud', ref: 'Sin gradualidad', v: parteSalud });
        rows.push({ k: 'Cuota mensual a pagar', ref: 'Jubilatorio + salud', v: cuotaMono, extra: true });
        rows.push({ k: 'Costo anual del monotributo', ref: '12 cuotas', v: monoAnual, extra: true });
        rows.push({ k: 'Tope anual de facturación', ref: 'Referencial: verificá la tabla del BPS', v: MONO.topeAnual });
        rows.push({
          k: superaTope ? 'Cuánto pasaste el tope' : 'Margen que te queda hasta el tope',
          ref: superaTope ? 'Tenés que pasar al régimen general' : 'Podés seguir en monotributo',
          v: Math.abs(MONO.topeAnual - ingresos),
        });
        rows.push({ k: 'Comparación: IRPF de servicios personales', ref: 'Si tributaras por el régimen general', v: irpf });
        rows.push({
          k: 'Presión sobre tu facturación',
          ref: 'Cuota anual ÷ ingresos',
          v: ingresos > 0 ? (monoAnual / ingresos) * 100 : 0,
          format: 'unit',
          unit: '%',
          decimals: 2,
        });
        sub = 'Cuota de ' + uyu(cuotaMono) + ' por mes (' + uyu(monoAnual) + ' al año)' +
          (factor < 1 ? ' · gradualidad al ' + num(factor * 100, 0) + '%' : ' · cuota plena') +
          (superaTope ? ' · ATENCIÓN: superás el tope de facturación' : '');
        chart = [
          { label: 'Te queda a vos', value: Math.round(Math.max(0, ingresos - monoAnual)), tone: 'main' },
          { label: 'Cuota de monotributo', value: Math.round(monoAnual), tone: 'warn' },
        ];
      } else if (id === 'irae') {
        total = irae;
        rows.push({ k: 'Ingresos gravados del ejercicio', ref: 'Facturación sin IVA', v: ingresos });
        rows.push({ k: 'Gastos deducibles', ref: 'Documentados y vinculados a la renta gravada', v: gastos });
        rows.push({ k: 'Renta neta fiscal', ref: rentaFiscal <= 0 ? 'Pérdida fiscal: no se paga IRAE' : 'Base del impuesto', v: Math.max(0, rentaFiscal) });
        rows.push({ k: 'IRAE del ejercicio', ref: num(IRAE * 100, 0) + '% de la renta neta', v: irae, extra: true });
        rows.push({ k: 'Renta después del IRAE', ref: 'Lo que queda para la empresa', v: rentaFiscal - irae });
        rows.push({
          k: 'Margen neto sobre la facturación',
          ref: 'Renta después de impuesto ÷ ingresos',
          v: ingresos > 0 ? ((rentaFiscal - irae) / ingresos) * 100 : 0,
          format: 'unit',
          unit: '%',
          decimals: 1,
        });
        rows.push({ k: 'Comparación: IRPF de servicios personales', ref: 'Misma facturación, persona física', v: irpf });
        rows.push({ k: 'Comparación: monotributo anual', ref: 'Si calificaras para el régimen', v: monoAnual });
        rows.push({ k: 'IVA a cobrar sobre esa facturación', ref: 'Tasa ' + num(tasaIva * 100, 0) + '%', v: ivaSobreNeto });
        sub = rentaFiscal <= 0
          ? 'El ejercicio cierra en pérdida: no pagás IRAE y la pérdida se arrastra'
          : 'IRAE de ' + uyu(irae) + ' sobre una renta neta de ' + uyu(rentaFiscal) + ' · margen neto ' + num(ingresos > 0 ? ((rentaFiscal - irae) / ingresos) * 100 : 0) + '%';
        chart = [
          { label: 'Renta después de impuesto', value: Math.round(Math.max(0, rentaFiscal - irae)), tone: 'main' },
          { label: 'Gastos deducibles', value: Math.round(gastos), tone: 'prop' },
          { label: 'IRAE', value: Math.round(irae), tone: 'bad' },
        ];
      } else if (id === 'iva') {
        total = ivaSobreNeto;
        rows.push({ k: 'Monto neto', ref: 'Sin IVA', v: ingresos });
        rows.push({ k: 'Tasa aplicada', ref: tasaIva === IVA.minima ? 'Mínima' : 'Básica', v: tasaIva * 100, format: 'unit', unit: '%' });
        rows.push({ k: 'IVA a agregar', ref: 'Neto × tasa', v: ivaSobreNeto, extra: true });
        rows.push({ k: 'Precio final con IVA', ref: 'Neto + IVA', v: conIva, extra: true });
        rows.push({ k: 'Si ese monto YA incluyera IVA, el neto sería', ref: 'Monto ÷ (1 + tasa)', v: netoSiIncluye });
        rows.push({ k: 'IVA contenido en ese caso', ref: 'Monto − neto', v: ivaContenido });
        rows.push({ k: 'El mismo neto con la otra tasa', ref: tasaIva === IVA.minima ? 'Básica ' + num(IVA.basica * 100, 0) + '%' : 'Mínima ' + num(IVA.minima * 100, 0) + '%', v: ingresos * (tasaIva === IVA.minima ? IVA.basica : IVA.minima) });
        rows.push({ k: 'Diferencia entre una tasa y la otra', ref: 'Sobre el mismo neto', v: Math.abs(ingresos * IVA.basica - ingresos * IVA.minima) });
        sub = 'Sobre ' + uyu(ingresos) + ' netos, el IVA al ' + num(tasaIva * 100, 0) + '% agrega ' + uyu(ivaSobreNeto) +
          ' · precio final ' + uyu(conIva);
        chart = [
          { label: 'Monto neto', value: Math.round(ingresos), tone: 'main' },
          { label: 'IVA', value: Math.round(ivaSobreNeto), tone: 'warn' },
        ];
      } else {
        total = irpf;
        rows.push({ k: 'Honorarios facturados en el año', ref: 'Sin IVA', v: ingresos });
        rows.push({ k: 'Deducción ficta de gastos', ref: num(FICTO * 100, 0) + '% de los ingresos, sin justificar', v: deduccionFicta });
        rows.push({ k: 'Gastos reales documentados', ref: usaReales ? 'Conviene: superan al ficto' : 'No conviene: el ficto es mayor', v: gastos });
        rows.push({ k: 'Deducción aplicada', ref: usaReales ? 'Gastos reales' : 'Ficto', v: deduccionGastos });
        rows.push({ k: 'Renta neta gravada', ref: 'Ingresos − deducción', v: rentaNeta });
        rows.push({ k: 'Impuesto primario', ref: 'Escala progresiva anualizada', v: primario });
        rows.push({
          k: 'Crédito por deducciones (se resta del impuesto)',
          ref: num(tasaCredito * 100, 0) + '% sobre ' + uyu(baseCredito) + ' de aportes e hijos',
          v: credito,
        });
        rows.push({ k: 'IRPF anual a pagar', ref: 'Primario − crédito', v: irpf, extra: true });
        rows.push({ k: 'IRPF promedio por mes', ref: 'Anual ÷ 12', v: irpf / 12 });
        rows.push({
          k: 'Tasa efectiva sobre lo facturado',
          ref: 'IRPF ÷ ingresos',
          v: ingresos > 0 ? (irpf / ingresos) * 100 : 0,
          format: 'unit',
          unit: '%',
          decimals: 2,
        });
        rows.push({ k: 'Te queda después de gastos, aportes e IRPF', ref: 'Ingresos − gastos − aportes − IRPF', v: ingresos - deduccionGastos - aportes - irpf });
        rows.push({ k: 'Comparación: cuota anual de monotributo', ref: 'Si calificaras para el régimen', v: monoAnual });
        rows.push({ k: 'Comparación: IRAE sobre la misma actividad', ref: num(IRAE * 100, 0) + '% de la renta neta fiscal', v: irae });

        sub = 'IRPF anual de ' + uyu(irpf) + ' (' + num(ingresos > 0 ? (irpf / ingresos) * 100 : 0, 2) + '% de lo facturado)' +
          ' · te conviene ' + (usaReales ? 'declarar gastos reales' : 'la deducción ficta') +
          ' · el monotributo te costaría ' + uyu(monoAnual);
        chart = [
          { label: 'Te queda a vos', value: Math.round(Math.max(0, ingresos - deduccionGastos - aportes - irpf)), tone: 'main' },
          { label: 'Gastos de la actividad', value: Math.round(deduccionGastos), tone: 'prop' },
          { label: 'Aportes a la caja', value: Math.round(aportes), tone: 'good' },
          { label: 'IRPF', value: Math.round(irpf), tone: 'bad' },
        ];
      }

      return { total: uyu(total), sub: sub, rows: rows, chart: chart };
    });
  })();
</script>
