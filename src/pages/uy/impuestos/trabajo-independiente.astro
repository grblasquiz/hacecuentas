---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import TrabajoIndependienteUruguayExperience from '../../../components/generated/TrabajoIndependienteUruguayExperience.astro';
import RegimeJourney from '../../../components/RegimeJourney.astro';
import { hub } from '../../../lib/hubs/uy/trabajo-independiente';
const canonical='https://hacecuentas.com/uy/impuestos/trabajo-independiente';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
import HubCitableStats from '../../../components/hub/HubCitableStats.astro';
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <TrabajoIndependienteUruguayExperience />
  <RegimeJourney country="Uruguay" regime="Monotributo BPS" headline="Una cuota simple, con decisiones reales de cobertura y gradualidad." intro="El aporte cambia con la antigüedad y la opción de Fonasa. Después del cálculo, la ruta verifica topes y compara IRPF o IRAE para evitar una falsa economía." steps={['Definí antigüedad y Fonasa','Chequeá actividad y topes','Compará monotributo, IRPF e IRAE']} links={[{href:'/uy/calculadora-monotributo-uruguay',label:'Calcular monotributo',note:'Aporte según tu situación'},{href:'/uy/impuestos/trabajo-independiente',label:'Comparar alternativas',note:'Monotributo, IRPF, IRAE e IVA'},{href:'/uy/impuestos/index',label:'Ver obligaciones',note:'Calendario y herramientas fiscales'}]} tone="emerald" />
  <HubCitableStats data={hub} />
  <Footer />
</Layout>
