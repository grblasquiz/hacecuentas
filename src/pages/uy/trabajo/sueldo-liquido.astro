---
/**
 * Hub de decisión UY — "Del sueldo nominal al líquido".
 * Absorbe las calculadoras de salario líquido, aportes BPS, FONASA, IRPF mensual,
 * jornal, valor hora, salario mínimo, horas extra, costo del empleador y servicio doméstico.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SueldoLiquidoUruguayExperience from '../../../components/generated/SueldoLiquidoUruguayExperience.astro';
import {
  hub,
  BPC,
  SMN,
  DIV_JORNAL,
  DIV_HORA,
  IRPF_FRANJAS,
  IRPF_DEDUCCION,
  IRPF_MNI_BPC,
  FONASA,
  MONTEPIO,
  FRL,
  PATRONAL,
  HORA_EXTRA,
} from '../../../lib/hubs/uy/sueldo-liquido';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="UY"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoLiquidoUruguayExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    BPC,
    SMN,
    DIV_JORNAL,
    DIV_HORA,
    FRANJAS: IRPF_FRANJAS,
    DED: IRPF_DEDUCCION,
    MNI_BPC: IRPF_MNI_BPC,
    FONASA,
    MONTEPIO,
    FRL,
    PATRONAL,
    HORA_EXTRA,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const uyu = (n) => '$U ' + new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 }).format(Math.round(n || 0));
    const pct = (x) => new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 }).format(x);

    // Escala progresiva por franjas en BPC (espejo de impuestoPorFranjasBpc).
    function porFranjas(base) {
      if (base <= 0) return 0;
      let imp = 0, antBpc = 0;
      for (const f of FRANJAS) {
        const limite = f.hastaBpc === null ? Infinity : f.hastaBpc * BPC;
        const piso = antBpc * BPC;
        const enTramo = Math.min(base, limite) - piso;
        if (enTramo <= 0) { antBpc = f.hastaBpc === null ? Infinity : f.hastaBpc; continue; }
        imp += enTramo * f.tasa;
        antBpc = f.hastaBpc === null ? Infinity : f.hastaBpc;
        if (base <= limite) break;
      }
      return imp;
    }

    /** Tramo marginal en el que cae el nominal. */
    function marginal(base) {
      let ant = 0;
      for (const f of FRANJAS) {
        const limite = f.hastaBpc === null ? Infinity : f.hastaBpc * BPC;
        if (base > ant * BPC && base <= limite) return f.tasa;
        ant = f.hastaBpc === null ? Infinity : f.hastaBpc;
      }
      return 0;
    }

    /** Tasa FONASA personal oficial (BPS): tabla del data file, no la suma 3%+1,5%+1,5%. */
    function tasaFonasa(nominal, conConyuge, conHijos) {
      const t = nominal <= FONASA.umbralBpc * BPC ? FONASA.hasta25 : FONASA.mas25;
      if (conConyuge && conHijos) return t.conConyugeEHijos;
      if (conConyuge) return t.conConyuge;
      if (conHijos) return t.conHijos;
      return t.soloTrabajador;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'mensual';
      const bruto = Math.max(0, v.nominal || 0);
      const conConyuge = String(v.conyuge || 'no') === 'si';
      const hijos = Math.max(0, Math.round(v.hijos || 0));
      const conHijos = hijos > 0;
      const jornada = Math.min(48, Math.max(1, v.jornada || 44));
      const hsExtra = Math.max(0, v.horasExtra || 0);

      // Jornalero: el monto ingresado es el jornal → equivalente mensual × 25.
      const nominalBase = id === 'jornalero' ? bruto * DIV_JORNAL : bruto;

      // Horas extra: hora simple sobre la jornada real (jornada × 52 ÷ 12 horas/mes).
      const horasMes = (jornada * 52) / 12;
      const horaSimple = horasMes > 0 ? nominalBase / horasMes : 0;
      const montoExtra = horaSimple * (1 + HORA_EXTRA.diaHabil) * hsExtra;

      const nominal = nominalBase + montoExtra;

      // ── Aportes personales BPS ──
      const tFonasa = tasaFonasa(nominal, conConyuge, conHijos);
      const montepio = nominal * MONTEPIO;
      const fonasa = nominal * tFonasa;
      const frl = nominal * FRL;
      const aportes = montepio + fonasa + frl;

      // ── IRPF Cat. II ──
      const primario = porFranjas(nominal);
      const dedHijosMes = (hijos * DED.hijoMenorBpcAnual * BPC) / 12;
      const deducciones = aportes + dedHijosMes;
      const tasaCredito = nominal < DED.umbralBpc * BPC ? DED.tasaBaja : DED.tasaAlta;
      const credito = deducciones * tasaCredito;
      const irpf = Math.max(0, primario - credito);

      const liquido = nominal - aportes - irpf;

      // ── Lado empleador ──
      const tasaPatronal = PATRONAL.jubilatorio + PATRONAL.fonasa + PATRONAL.frl;
      const patronales = nominal * tasaPatronal;
      const provAguinaldo = nominal / 12;
      const provLicencia = nominal / 12;
      const costoEmpleador = nominal + patronales + provAguinaldo + provLicencia;

      const esEmpleador = id === 'empleador';
      const descuento = nominal > 0 ? ((nominal - liquido) / nominal) * 100 : 0;

      const rows = [];
      if (id === 'jornalero') {
        rows.push({ k: 'Jornal ingresado', ref: 'Valor de un jornal', v: bruto });
        rows.push({ k: 'Equivalente mensual', ref: 'Jornal × ' + DIV_JORNAL + ' (Decreto de salario mínimo)', v: nominalBase });
      } else {
        rows.push({ k: 'Sueldo nominal', ref: 'Bruto del contrato', v: nominalBase });
      }
      if (montoExtra > 0) {
        rows.push({
          k: hsExtra + (hsExtra === 1 ? ' hora extra' : ' horas extra') + ' en día hábil',
          ref: 'Hora simple ' + uyu(horaSimple) + ' × ' + (1 + HORA_EXTRA.diaHabil).toFixed(1).replace('.', ',') + ' · Ley 15.996',
          v: montoExtra,
        });
        rows.push({ k: 'Nominal del mes con horas extra', ref: 'Base de aportes e IRPF', v: nominal });
      }
      rows.push({ k: 'Montepío jubilatorio (se descuenta)', ref: (MONTEPIO * 100).toLocaleString('de-DE') + '% · BPS', v: montepio });
      rows.push({
        k: 'FONASA (se descuenta)',
        ref: pct(tFonasa * 100) + '% · ' + (nominal > FONASA.umbralBpc * BPC ? 'más de ' : 'hasta ') + FONASA.umbralBpc + ' BPC' + (conConyuge ? ' · con cónyuge' : '') + (conHijos ? ' · con hijos' : ''),
        v: fonasa,
      });
      rows.push({ k: 'Fondo de Reconversión Laboral (se descuenta)', ref: pct(FRL * 100) + '% · FRL', v: frl });
      rows.push({ k: 'Total de aportes BPS', ref: pct((aportes / (nominal || 1)) * 100) + '% del nominal', v: aportes });
      rows.push({ k: 'IRPF primario según la escala', ref: 'Franjas en BPC · Cat. II', v: primario });
      rows.push({
        k: 'Crédito por deducciones (se resta del impuesto)',
        ref: pct(tasaCredito * 100) + '% sobre ' + uyu(deducciones) + ' deducibles',
        v: credito,
      });
      rows.push({ k: 'IRPF a retener', ref: nominal <= MNI_BPC * BPC ? 'Bajo el mínimo no imponible' : 'Primario − crédito', v: irpf });
      rows.push({ k: 'Sueldo líquido en mano', ref: 'Lo que cobrás', v: liquido, extra: !esEmpleador });
      rows.push({
        k: 'Descuento total sobre el nominal',
        ref: 'Aportes + IRPF',
        v: descuento,
        format: 'unit',
        unit: '%',
        decimals: 1,
      });
      rows.push({
        k: 'Tramo marginal del IRPF',
        ref: 'La tasa que paga tu último peso',
        v: marginal(nominal) * 100,
        format: 'unit',
        unit: '%',
      });
      rows.push({ k: 'Valor de tu hora', ref: jornada + ' h/semana · ' + pct(horasMes) + ' h/mes', v: horaSimple });
      rows.push({ k: 'Valor de tu jornal', ref: 'Mensual ÷ ' + DIV_JORNAL, v: nominalBase / DIV_JORNAL });
      rows.push({
        k: 'Tu nominal medido en salarios mínimos',
        ref: 'SMN ' + uyu(SMN),
        v: SMN > 0 ? nominalBase / SMN : 0,
        format: 'unit',
        unit: 'SMN',
        decimals: 2,
      });

      if (esEmpleador || id === 'domestico') {
        rows.push({ k: 'Aportes patronales', ref: pct(tasaPatronal * 100) + '% · jubilatorio + FONASA + FRL', v: patronales });
        rows.push({ k: 'Provisión de aguinaldo', ref: '1/12 del nominal', v: provAguinaldo });
        rows.push({ k: 'Provisión de licencia y salario vacacional', ref: '≈ 1/12 del nominal', v: provLicencia });
        rows.push({ k: 'Costo total del puesto para el empleador', ref: 'Nominal + patronales + provisiones', v: costoEmpleador, extra: esEmpleador });
        rows.push({
          k: 'Sobrecosto sobre el nominal',
          ref: 'Cuánto más que el bruto',
          v: nominal > 0 ? ((costoEmpleador - nominal) / nominal) * 100 : 0,
          format: 'unit',
          unit: '%',
          decimals: 1,
        });
      }

      const sub = esEmpleador
        ? 'El puesto te cuesta ' + uyu(costoEmpleador) + ' por mes · el trabajador cobra ' + uyu(liquido) +
          ' en mano · aportes patronales ' + uyu(patronales)
        : (irpf > 0 ? 'Pagás IRPF: ' + uyu(irpf) + ' este mes' : 'No pagás IRPF: estás por debajo del mínimo no imponible de ' + MNI_BPC + ' BPC') +
          ' · te descuentan el ' + pct(descuento) + '% · FONASA al ' + pct(tFonasa * 100) + '%' +
          ' · tu hora vale ' + uyu(horaSimple);

      const chart = esEmpleador
        ? [
            { label: 'Líquido del trabajador', value: Math.round(liquido), tone: 'main' },
            { label: 'Aportes personales e IRPF', value: Math.round(aportes + irpf), tone: 'warn' },
            { label: 'Aportes patronales', value: Math.round(patronales), tone: 'bad' },
            { label: 'Provisiones (aguinaldo y licencia)', value: Math.round(provAguinaldo + provLicencia), tone: 'prop' },
          ]
        : [
            { label: 'Líquido en mano', value: Math.round(liquido), tone: 'main' },
            { label: 'Aportes BPS', value: Math.round(aportes), tone: 'warn' },
            { label: 'IRPF', value: Math.round(irpf), tone: 'bad' },
          ];

      return {
        total: uyu(esEmpleador ? costoEmpleador : liquido),
        sub: sub,
        rows: rows,
        chart: chart,
      };
    });
  })();
</script>
