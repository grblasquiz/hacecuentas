---
/**
 * Hub de decisión UY — "Del sueldo nominal al líquido".
 * Absorbe las calculadoras de salario líquido, aportes BPS, FONASA, IRPF mensual,
 * jornal, valor hora, salario mínimo, horas extra, costo del empleador y servicio doméstico.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SueldoLiquidoUruguayExperience from '../../../components/generated/SueldoLiquidoUruguayExperience.astro';
import {
  hub,
  BPC,
  SMN,
  DIV_JORNAL,
  DIV_HORA,
  IRPF_FRANJAS,
  IRPF_DEDUCCION,
  IRPF_MNI_BPC,
  FONASA,
  MONTEPIO,
  FRL,
  PATRONAL,
  HORA_EXTRA,
} from '../../../lib/hubs/uy/sueldo-liquido';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="UY"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SueldoLiquidoUruguayExperience data={hub} />
  <Footer />
</Layout>

