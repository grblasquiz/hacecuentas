---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/uy/cuotas-y-prestamos';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="UY" lang="es" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/uy-cuotas-y-prestamos';
  const configs = {"c1":{"formulaId":"calculadora-cuota-credito-hipotecario-ui-uruguay","fields":["montoPesos","tasaTEA_UI","plazoAnios","inflacionAnual"],"outputs":[{"id":"cuotaUI","label":"Cuota mensual (en UI, fija)","primary":true},{"id":"cuotaPesosHoy","label":"Cuota en pesos hoy"},{"id":"cuotaPesosEn10Anios","label":"Cuota en pesos en 10 años"},{"id":"totalUI","label":"Total del crédito (en UI)"},{"id":"detalle","label":"Detalle"}],"title":"Calculadora de cuota de crédito hipotecario en UI — Uruguay 2026"},"c2":{"formulaId":"calculadora-cuota-prestamo-uruguay","fields":["monto","tasaTEA","plazoMeses"],"outputs":[{"id":"cuotaMensual","label":"Cuota mensual","primary":true},{"id":"totalPagar","label":"Total a pagar"},{"id":"totalIntereses","label":"Total de intereses"},{"id":"detalle","label":"Detalle"}],"title":"Calculadora de cuota de préstamo personal — Uruguay 2026"}};
  const numeric = (o:any) => Object.entries(o || {}).filter(([k,v]) => !k.startsWith('_') && typeof v === 'number' && Number.isFinite(v as number));
  const labelFor = (cfg:any,key:string) => cfg.outputs.find((o:any)=>o.id===key)?.label || key.replace(/_/g,' ');
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => {
    const id=selected?.id || Object.keys(configs)[0], cfg=(configs as any)[id];
    const values:any={}; for(const key of cfg.fields) values[key]=all[id+'__'+key];
    let out:any; try { out=formulaMap[id](values) || {}; } catch(e:any) { return {total:'—',sub:e?.message||'Revisa los datos',rows:[],chart:[],format:'plain'}; }
    const nums=numeric(out); const preferred=cfg.outputs.find((x:any)=>x.primary && typeof out[x.id]==='number') || cfg.outputs.find((x:any)=>typeof out[x.id]==='number');
    const mainKey=preferred?.id || nums[0]?.[0], main=Number(out[mainKey] ?? nums[0]?.[1] ?? 0);
    const rows=nums.slice(0,12).map(([k,v])=>({k:labelFor(cfg,k),v:Number(v),format:'ars'}));
    const chart=nums.slice(0,6).map(([k,v],i)=>({label:labelFor(cfg,k),value:Math.abs(Number(v)),tone:i===0?'main':i===1?'good':'prop'}));
    return {total:main.toLocaleString('es',{maximumFractionDigits:2}),sub:out._insight || out.detalle || out.resumen || cfg.title,rows,chart,format:'ars'};
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
