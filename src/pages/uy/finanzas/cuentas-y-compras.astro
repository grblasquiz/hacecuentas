---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/uy/cuentas-y-compras';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="UY" lang="es" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/uy-cuentas-y-compras';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"compras-exterior-courier-uruguay","fields":["valorUsd","regimen","origen","tipoCambio"],"outputs":[{"id":"totalUyu","label":"Total en pesos","primary":true},{"id":"impuestoUsd","label":"Impuesto (USD)"},{"id":"impuestoUyu","label":"Impuesto (en pesos)"},{"id":"totalUsd","label":"Total con impuesto (USD)"},{"id":"detalle","label":"Detalle"}],"title":"Calculadora de Compras en el Exterior / Courier — Uruguay 2026"},"c2":{"formulaId":"calculadora-factura-ute-consumo-electrico-uruguay","fields":["consumoKwh"],"outputs":[{"id":"total","label":"Factura estimada del mes","primary":true},{"id":"energiaConIva","label":"Energía (con IVA 22%)"},{"id":"cargoFijo","label":"Cargo fijo (exento de IVA)"},{"id":"detalle","label":"Detalle del cálculo"}],"title":"Calculadora de Factura de UTE — Consumo Eléctrico (Uruguay 2026)"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'es', format: 'ars' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
