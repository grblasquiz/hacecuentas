---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/uy/costos-del-auto';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="UY" lang="es" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/uy-costos-del-auto';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"calculadora-costo-viaje-nafta-uruguay","fields":["distanciaKm","idaYVuelta","rendimiento","tipoCombustible","cantidadPeajes","telepeaje"],"outputs":[{"id":"total","label":"Costo total del viaje","primary":true},{"id":"costoCombustible","label":"Combustible"},{"id":"costoPeajes","label":"Peajes"},{"id":"litros","label":"Litros necesarios"},{"id":"detalle","label":"Detalle del cálculo"}],"title":"Calculadora de Costo de Viaje en Auto — Nafta y Peajes (Uruguay 2026)"},"c2":{"formulaId":"patente-rodados-uruguay","fields":["aforo","categoria"],"outputs":[{"id":"patenteAnual","label":"Patente anual estimada","primary":true},{"id":"alicuota","label":"Alícuota aplicada"},{"id":"cuotaEstimada","label":"Cuota estimada (÷10)"},{"id":"pagoContado","label":"Pago contado (con descuento)"},{"id":"detalle","label":"Detalle"}],"title":"Calculadora de Patente de Rodados — Uruguay 2026 (SUCIVE)"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'es', format: 'ars' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
