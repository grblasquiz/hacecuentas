---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const provinciasMod = await import('../../../content/argentina/provincias.json');
  const provincias: any[] = provinciasMod.default || (provinciasMod as any);

  const calcModules = import.meta.glob<any>('../../../content/argentina/*.json', { eager: true });
  const calcs: any[] = Object.entries(calcModules)
    .map(([, mod]) => mod.default || mod)
    .filter((c: any) => c.calcSlug);

  return provincias.map((prov: any) => {
    const provCalcs = calcs.filter((c: any) => c.provinceData && c.provinceData[prov.slug]);
    return {
      params: { provincia: prov.slug },
      props: { provincia: prov, calcs: provCalcs },
    };
  });
}

const { provincia, calcs } = Astro.props;

const siteUrl = 'https://hacecuentas.com';
const pageUrl = `${siteUrl}/argentina/${provincia.slug}`;

// Mapeo de calcSlug → bloque visualizable con la data provincial real
type ProvinceBlock = {
  calcSlug: string;
  calcName: string;
  emoji: string;
  rate: string;
  details: string;
  metrics: Record<string, string>;
  localNotes: string;
};

const provinceBlocks: ProvinceBlock[] = calcs
  .map((c: any) => {
    const pd = (c.provinceData || {})[provincia.slug];
    if (!pd) return null;
    return {
      calcSlug: c.calcSlug,
      calcName: c.calcName || c.title || c.calcSlug,
      emoji: c.heroEmoji || '📊',
      rate: pd.rate || '',
      details: pd.details || '',
      metrics: pd.metrics || {},
      localNotes: pd.localNotes || '',
    } as ProvinceBlock;
  })
  .filter((b: ProvinceBlock | null): b is ProvinceBlock => b !== null);

// Pequeño "snapshot" económico de la provincia que se muestra arriba.
const snapshot: { label: string; value: string }[] = [];
for (const b of provinceBlocks) {
  if (b.calcSlug.includes('costo-m2-construccion') && b.metrics['Costo m2 medio']) {
    snapshot.push({ label: 'Costo m² construcción (media)', value: b.metrics['Costo m2 medio'] });
  }
  if (b.calcSlug.includes('ingresos-brutos') && b.metrics['Alicuota general']) {
    snapshot.push({ label: 'Alícuota IIBB general', value: b.metrics['Alicuota general'] });
  }
  if (b.calcSlug.includes('inmobiliario') && b.metrics['Alicuota urbano']) {
    snapshot.push({ label: 'Inmobiliario urbano', value: b.metrics['Alicuota urbano'] });
  }
  if (b.calcSlug.includes('sellos') && b.metrics['Alicuota inmuebles']) {
    snapshot.push({ label: 'Sellos inmuebles', value: b.metrics['Alicuota inmuebles'] });
  }
  if (b.calcSlug.includes('patente') && b.metrics['Alicuota general']) {
    snapshot.push({ label: 'Patente (rango)', value: b.rate || b.metrics['Alicuota general'] });
  }
}

const title = `${provincia.name} — Calculadoras e impuestos provinciales 2026 | Hacé Cuentas`;
const description = `${provincia.name} 2026: alícuotas oficiales de IIBB, patente, inmobiliario, sellos y costo m² de construcción.${snapshot[0] ? ` ${snapshot[0].label}: ${snapshot[0].value}.` : ''}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#collectionpage`,
      name: title,
      url: pageUrl,
      description,
      inLanguage: 'es-AR',
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      about: provincia.name,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Argentina', item: 'https://hacecuentas.com/argentina' },
        { '@type': 'ListItem', position: 3, name: provincia.name },
      ],
    },
    {
      '@type': 'ItemList',
      name: `Calculadoras de ${provincia.name}`,
      numberOfItems: calcs.length,
      itemListElement: calcs.map((c: any, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.title || c.calcName || c.calcSlug,
        url: `${pageUrl}/${c.calcSlug}`,
      })),
    },
    ...(snapshot.length > 0
      ? [
          {
            '@type': 'Dataset',
            name: `Snapshot fiscal ${provincia.name} 2026`,
            description: `Alícuotas y valores fiscales de ${provincia.name}: IIBB, inmobiliario, sellos, patente y costo m² de construcción.`,
            url: pageUrl,
            inLanguage: 'es-AR',
            keywords: snapshot.map((s) => `${s.label}: ${s.value}`).join(', '),
            spatialCoverage: { '@type': 'Place', name: `${provincia.name}, Argentina` },
          },
        ]
      : []),
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical={`/argentina/${provincia.slug}`}
  schema={schema}
  audience="AR"
>
  <Header slot="header" />

  <article class="prov-hub">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Inicio</a> › <a href="/argentina">Argentina</a> › <span>{provincia.name}</span>
    </nav>

    <h1>{provincia.name} — Calculadoras e impuestos provinciales 2026</h1>

    <p class="lead">
      Calculadoras específicas para <strong>{provincia.name}</strong> con los valores,
      alícuotas y parámetros oficiales 2026. Incluye <strong>Ingresos Brutos</strong>,
      <strong>patente automotor</strong>, <strong>impuesto inmobiliario</strong>,
      <strong>impuesto de sellos</strong> y <strong>costo del m² de construcción</strong>.
      Actualizadas cuando cambia la normativa provincial.
    </p>

    <h2>Datos clave de {provincia.name}</h2>
    <ul class="info-list">
      <li><strong>Capital</strong>: {provincia.capital || '—'}</li>
      <li><strong>Región</strong>: {provincia.region || '—'}</li>
      <li><strong>Código</strong>: {provincia.codigo || provincia.abbr || provincia.slug.toUpperCase()}</li>
      <li><strong>Organismo fiscal</strong>: {provincia.agencia || 'Agencia provincial de recaudación'}</li>
      {provincia.sitioOficial && <li><strong>Sitio oficial</strong>: <a href={provincia.sitioOficial} rel="nofollow" target="_blank">{provincia.sitioOficial.replace(/^https?:\/\//, '')}</a></li>}
    </ul>

    {snapshot.length > 0 && (
      <section class="prov-snapshot" aria-labelledby="snap-h">
        <h2 id="snap-h">Snapshot fiscal 2026 — {provincia.name}</h2>
        <p class="lead-small">
          Valores y alícuotas vigentes para {provincia.name} consolidadas de cada calculadora. Cada
          número se detalla y fundamenta más abajo, con su fuente oficial.
        </p>
        <div class="snap-grid">
          {snapshot.map((s) => (
            <div class="snap-card">
              <span class="snap-label">{s.label}</span>
              <strong class="snap-value">{s.value}</strong>
            </div>
          ))}
        </div>
      </section>
    )}

    <h2>Calculadoras disponibles para {provincia.name}</h2>

    {provinceBlocks.length === 0 ? (
      <p class="empty-msg">
        Todavía no tenemos calculadoras específicas para {provincia.name} cargadas en el sistema.
        Podés ver las <a href="/categoria/impuestos">calculadoras fiscales generales</a> o
        <a href="/contacto"> sugerirnos una</a>.
      </p>
    ) : (
      <div class="calc-blocks">
        {provinceBlocks.map((b) => (
          <article class="prov-calc">
            <header class="prov-calc-h">
              <h3>
                <span class="emoji" aria-hidden="true">{b.emoji}</span>
                <a href={`/argentina/${provincia.slug}/${b.calcSlug}`}>{b.calcName} en {provincia.name}</a>
              </h3>
              {b.rate && <span class="prov-rate">{b.rate}</span>}
            </header>
            {b.details && <p class="prov-details">{b.details}</p>}
            {Object.keys(b.metrics).length > 0 && (
              <table class="prov-metrics">
                <caption class="sr-only">{b.calcName} — {provincia.name} (2026)</caption>
                <tbody>
                  {Object.entries(b.metrics).map(([k, v]) => (
                    <tr>
                      <th scope="row">{k}</th>
                      <td>{v}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {b.localNotes && (
              <p class="prov-localnotes">
                <strong>Particularidades de {provincia.name}:</strong> {b.localNotes}
              </p>
            )}
            <p class="prov-cta">
              <a href={`/argentina/${provincia.slug}/${b.calcSlug}`} class="btn-link">
                Abrir calculadora de {b.calcName.toLowerCase()} en {provincia.name} →
              </a>
            </p>
          </article>
        ))}
      </div>
    )}

    <h2>Calculadoras nacionales relacionadas</h2>
    <p>
      Además de las específicas de {provincia.name}, estas calculadoras aplican a toda
      Argentina y suelen combinarse con las provinciales:
    </p>
    <ul class="national-list">
      <li><a href="/sueldo-en-mano-argentina">Sueldo en mano Argentina</a> — neto a partir del bruto</li>
      <li><a href="/calculadora-aguinaldo-sac">Calculadora de aguinaldo (SAC)</a></li>
      <li><a href="/calculadora-monotributo-2026">Monotributo 2026 — categoría</a></li>
      <li><a href="/calculadora-ganancias-empleados-4ta-categoria-2026">Impuesto a las Ganancias</a></li>
      <li><a href={`/calculadora-valuacion-fiscal-automotor-${provincia.slug}`}>
        Valuación fiscal automotor {provincia.name}
      </a></li>
    </ul>

    <h2>Cómo usamos estas calculadoras</h2>
    <p>
      Las alícuotas y parámetros provinciales cambian cada año (o incluso varias veces por año
      si hay modificaciones normativas). Cada calculadora de <strong>{provincia.name}</strong>
      cita la fuente oficial en la sección "Fuentes" al pie y se revisa periódicamente.
    </p>
    <p>
      Para consultas específicas de liquidación tributaria, facturación electrónica o planes
      de pago con la agencia fiscal provincial, consultá directamente con un contador
      matriculado o con el organismo oficial. Las calculadoras de Hacé Cuentas son
      <em>orientativas</em> y sirven como referencia inicial.
    </p>

    <p class="contact-cta">
      ¿Falta alguna calculadora específica de {provincia.name}? <a href="/contacto">Avisanos</a>
      o abrí un <a href="https://github.com/grblasquiz/hacecuentas/issues" rel="noopener" target="_blank">issue en GitHub</a>.
    </p>

    {provincia.hubContent && (
      <section class="prov-hub-extended" set:html={provincia.hubContent} />
    )}

    {Array.isArray(provincia.hubFaq) && provincia.hubFaq.length > 0 && (
      <section class="prov-hub-faq">
        <h2>Preguntas frecuentes sobre {provincia.name}</h2>
        {provincia.hubFaq.map((qa: {q: string; a: string}) => (
          <details class="prov-faq-item">
            <summary>{qa.q}</summary>
            <div set:html={qa.a} />
          </details>
        ))}
      </section>
    )}
  </article>

  <Footer slot="footer" />
</Layout>

<style>
  .prov-hub {
    max-width: 780px;
    margin: 2rem auto 4rem;
    padding: 0 1.25rem;
    line-height: 1.7;
  }
  .breadcrumb { font-size: 0.85rem; color: var(--color-muted, #666); margin-bottom: 1rem; }
  .breadcrumb a { color: var(--color-accent, #2563eb); }
  .prov-hub h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin: 0 0 1rem; }
  .prov-hub h2 { margin-top: 2.2rem; font-size: 1.4rem; }
  .prov-hub h3 { margin: 0 0 0.4rem; font-size: 1.05rem; }
  .lead { font-size: 1.1rem; margin-bottom: 1.5rem; }
  .info-list, .national-list { padding-left: 1.25rem; }
  .info-list li, .national-list li { margin-bottom: 0.4rem; }
  .calcs-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .calc-card {
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 8px;
    transition: border-color 0.15s, transform 0.15s;
  }
  .calc-card:hover { border-color: var(--color-accent, #2563eb); transform: translateY(-2px); }
  .calc-card a {
    display: block;
    padding: 1rem 1.1rem 1rem 1.1rem;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .calc-card p {
    font-size: 0.9rem;
    color: var(--color-muted, #555);
    margin: 0;
  }
  .calc-card .arrow {
    position: absolute;
    right: 1rem;
    bottom: 0.8rem;
    color: var(--color-accent, #2563eb);
    font-size: 1.2rem;
  }
  .lead-small { font-size: 0.95rem; color: var(--color-muted, #555); margin: 0.25rem 0 1rem; }
  .prov-snapshot { margin: 1.8rem 0 0.5rem; }
  .snap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0.6rem;
    margin: 0.8rem 0 0.5rem;
  }
  .snap-card {
    background: rgba(37, 99, 235, 0.06);
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 8px;
    padding: 0.7rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .snap-label { font-size: 0.78rem; color: var(--color-muted, #555); text-transform: uppercase; letter-spacing: 0.02em; }
  .snap-value { font-size: 1.05rem; }
  .calc-blocks { display: flex; flex-direction: column; gap: 1.2rem; margin: 1.2rem 0 1.5rem; }
  .prov-calc {
    border: 1px solid rgba(128, 128, 128, 0.22);
    border-radius: 10px;
    padding: 1.1rem 1.15rem 1rem;
    background: rgba(0, 0, 0, 0.012);
  }
  .prov-calc-h {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: space-between;
    border-bottom: 1px dashed rgba(128, 128, 128, 0.25);
    padding-bottom: 0.4rem;
    margin-bottom: 0.7rem;
  }
  .prov-calc-h h3 { margin: 0; font-size: 1.1rem; display: flex; align-items: center; gap: 0.45rem; }
  .prov-calc-h h3 .emoji { font-size: 1.15rem; }
  .prov-rate {
    font-weight: 600;
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-accent, #2563eb);
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .prov-details { margin: 0 0 0.65rem; font-size: 0.95rem; }
  .prov-metrics {
    width: 100%;
    border-collapse: collapse;
    margin: 0.4rem 0 0.7rem;
    font-size: 0.92rem;
  }
  .prov-metrics th, .prov-metrics td {
    text-align: left;
    padding: 0.4rem 0.55rem;
    border-bottom: 1px solid rgba(128, 128, 128, 0.18);
  }
  .prov-metrics th { color: var(--color-muted, #555); font-weight: 500; width: 45%; }
  .prov-localnotes {
    background: rgba(245, 158, 11, 0.07);
    border-left: 3px solid rgba(245, 158, 11, 0.55);
    padding: 0.55rem 0.75rem;
    margin: 0.4rem 0 0.7rem;
    font-size: 0.92rem;
    border-radius: 4px;
  }
  .prov-cta { margin: 0.4rem 0 0; font-size: 0.92rem; }
  .btn-link {
    display: inline-block;
    color: var(--color-accent, #2563eb);
    font-weight: 600;
    text-decoration: none;
  }
  .btn-link:hover { text-decoration: underline; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
  .empty-msg {
    background: rgba(128, 128, 128, 0.08);
    padding: 1rem;
    border-radius: 6px;
    font-size: 0.95rem;
  }
  .contact-cta {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(128, 128, 128, 0.2);
    font-size: 0.92rem;
    color: var(--color-muted, #555);
  }
  .prov-hub a {
    color: var(--color-accent, #2563eb);
    text-decoration: underline;
  }
  .calc-card a { text-decoration: none; }
</style>
