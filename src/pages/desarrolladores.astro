---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TOTAL_DISPLAY } from '../lib/calc-counts';

// Schema WebAPI: que un LLM que crawlee esta página entienda que hay una API
// consumible + un servidor MCP, con endpoints y licencia.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebAPI',
  name: 'Hacé Cuentas API + MCP',
  description:
    'API JSON pública y servidor MCP para descubrir, citar y ejecutar las calculadoras de Hacé Cuentas desde LLMs (ChatGPT, Claude, Grok, Gemini), agentes y apps.',
  url: 'https://hacecuentas.com/desarrolladores',
  provider: { '@type': 'Organization', name: 'Hacé Cuentas', '@id': 'https://hacecuentas.com/#organization' },
  documentation: 'https://hacecuentas.com/.well-known/openapi.yaml',
  termsOfService: 'https://hacecuentas.com/terminos',
  license: 'https://creativecommons.org/licenses/by/4.0/',
};

// Ejemplos de código como strings → las llaves {} quedan literales (Astro no las parsea).
const exCatalog = 'curl https://hacecuentas.com/api/calcs-index.json';
const exSpec = 'curl https://hacecuentas.com/api/calc/calculadora-imc.json';
const exCompute = 'curl "https://hacecuentas.com/api/calc/calculadora-imc/compute?peso=80&altura=180"';
const exComputeOut = `{
  "ok": true,
  "slug": "calculadora-imc",
  "inputs": { "peso": 80, "altura": 180 },
  "result": { "imc": 24.69, "categoria": "Peso normal" },
  "meta": { "attribution": "Hacé Cuentas — https://hacecuentas.com/calculadora-imc" }
}`;
const exPost = `curl -X POST https://hacecuentas.com/api/calc/calculadora-imc/compute \\
  -H "Content-Type: application/json" \\
  -d '{"inputs":{"peso":80,"altura":180},"lang":"es"}'`;

// Config MCP para clientes tipo Claude Desktop / Cline (Streamable HTTP remoto).
const mcpConfigClaude = `{
  "mcpServers": {
    "hacecuentas": {
      "url": "https://hacecuentas.com/mcp"
    }
  }
}`;
const mcpConfigGeneric = 'https://hacecuentas.com/mcp';
---

<Layout
  title="API y MCP — usá las calculadoras desde tu LLM o app — Hacé Cuentas"
  description={`API JSON gratuita y servidor MCP para que ChatGPT, Claude, Grok y Gemini consuman las ${TOTAL_DISPLAY} calculadoras de Hacé Cuentas en tiempo real. Sin registro, CC-BY 4.0.`}
  canonical="https://hacecuentas.com/desarrolladores"
  keywords={['hacecuentas api', 'api calculadoras', 'mcp calculadoras', 'calculadoras json', 'openapi calculadoras', 'grok mcp', 'chatgpt actions calculadora']}
  schema={schema}
  domain="knowledge"
>
  <Header slot="header" />

  <article class="dev">
    <h1>API y MCP para desarrolladores y LLMs</h1>
    <p class="lead">
      Las {TOTAL_DISPLAY} calculadoras de Hacé Cuentas son consumibles por programa: una
      <strong>API JSON</strong> para function calling / tool use y un <strong>servidor MCP remoto</strong>
      para conectar directo a ChatGPT, Claude, Grok o Gemini. Gratis, sin registro, sin API key.
      Licencia <a href="https://creativecommons.org/licenses/by/4.0/" rel="nofollow">CC-BY 4.0</a>
      (atribución con link a la calculadora).
    </p>

    <nav class="toc" aria-label="Tabla de contenidos">
      <strong>En esta página:</strong>
      <ul>
        <li><a href="#mcp">Servidor MCP (para LLMs)</a></li>
        <li><a href="#api">API REST (JSON)</a></li>
        <li><a href="#openapi">OpenAPI / GPT personalizado</a></li>
        <li><a href="#licencia">Licencia y atribución</a></li>
      </ul>
    </nav>

    <section id="mcp">
      <h2>Servidor MCP — para LLMs</h2>
      <p>
        Conectá este endpoint como servidor MCP remoto (Streamable HTTP, sin auth) y tu asistente
        usa las calculadoras como herramientas en tiempo real:
      </p>
      <pre class="endpoint"><code>https://hacecuentas.com/mcp</code></pre>
      <p>Expone tres herramientas:</p>
      <ul>
        <li><code>search_calculators</code> — busca calculadoras por palabra clave.</li>
        <li><code>get_calculator</code> — devuelve los inputs de una calculadora.</li>
        <li><code>compute</code> — calcula el resultado en vivo.</li>
      </ul>
      <h3>Conectar en Claude Desktop / Cline / clientes con config JSON</h3>
      <pre><code>{mcpConfigClaude}</code></pre>
      <h3>Conectar en Grok (xAI), ChatGPT u otros</h3>
      <p>
        En el panel de conectores / MCP de tu cliente, agregá un servidor MCP remoto con la URL:
      </p>
      <pre><code>{mcpConfigGeneric}</code></pre>
    </section>

    <section id="api">
      <h2>API REST (JSON)</h2>
      <p>Tres endpoints, todos GET, respuesta JSON, CORS abierto. Flujo: catálogo → ficha → cálculo.</p>

      <h3>1. Catálogo completo</h3>
      <pre><code>{exCatalog}</code></pre>

      <h3>2. Ficha de una calculadora (inputs + ejemplo)</h3>
      <pre><code>{exSpec}</code></pre>

      <h3>3. Calcular en vivo</h3>
      <pre><code>{exCompute}</code></pre>
      <p>Respuesta:</p>
      <pre><code>{exComputeOut}</code></pre>
      <p>
        También por <strong>POST</strong> con los inputs en el body (útil cuando hay muchos campos).
        Agregá <code>?lang=en</code> o <code>?lang=pt</code> para resultados en otro idioma:
      </p>
      <pre><code>{exPost}</code></pre>
    </section>

    <section id="openapi">
      <h2>OpenAPI / GPT personalizado</h2>
      <p>
        La spec OpenAPI 3.1 está en
        <a href="/.well-known/openapi.yaml"><code>/.well-known/openapi.yaml</code></a>.
        Sirve para armar un GPT personalizado (Actions), un tool de function calling, o
        cualquier integración basada en OpenAPI. Política de crawlers de IA en
        <a href="/ai.txt"><code>/ai.txt</code></a> y resumen del sitio en
        <a href="/llms.txt"><code>/llms.txt</code></a>.
      </p>
    </section>

    <section id="licencia">
      <h2>Licencia y atribución</h2>
      <p>
        Uso libre bajo <a href="https://creativecommons.org/licenses/by/4.0/" rel="nofollow">CC-BY 4.0</a>.
        Si mostrás un resultado a un usuario final, atribuí a <strong>Hacé Cuentas</strong> con un link
        a la calculadora usada (cada respuesta incluye el campo <code>attribution</code>).
        Los resultados son orientativos y educativos; verificá con fuentes oficiales antes de decidir.
        Dudas o integraciones: <a href="/contacto">contacto</a>.
      </p>
    </section>
  </article>

  <Footer slot="footer" />
</Layout>

<style>
  .dev {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    line-height: 1.65;
  }
  .dev h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin-bottom: 0.5rem;
  }
  .dev .lead {
    font-size: 1.1rem;
    color: var(--text-secondary, #475569);
    margin-bottom: 1.5rem;
  }
  .dev h2 {
    margin-top: 2.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border, #e2e8f0);
  }
  .dev h3 {
    margin-top: 1.5rem;
    font-size: 1.05rem;
  }
  .dev .toc {
    background: var(--surface-alt, #f8fafc);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }
  .dev .toc ul {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }
  .dev pre {
    background: #0f172a;
    color: #e2e8f0;
    border-radius: 10px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .dev pre.endpoint {
    background: #064e3b;
    font-size: 1rem;
  }
  .dev pre code {
    background: none;
    color: inherit;
    padding: 0;
    white-space: pre;
  }
  .dev :not(pre) > code {
    background: var(--surface-alt, #f1f5f9);
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
    font-size: 0.9em;
  }
</style>
