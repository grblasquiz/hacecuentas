---
/**
 * Hub de decisión — "¿Cuántas plantas me entran acá?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cantero, seto, semillas de huerta, jardín vertical y
 * césped. Las cinco terminan en el mismo eje —unidades por metro cuadrado—, que
 * es lo que hace comparable el gráfico entre ramas.
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub, ESPECIES, SETOS, SEMILLAS_M2, VERTICAL, CESPED, FACTOR_RESIEMBRA, EJE_MAX,
} from '../../lib/hubs/cuantas-plantas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    ESPECIES, SETOS, SEMILLAS_M2, VERTICAL, CESPED, FACTOR_RESIEMBRA, EJE_MAX,
    BANDS: hub.chart.bands,
  }}
>
  (function () {
    const H = window.HC_HUB;

    const n1 = (x, d) => Number(x || 0).toLocaleString('es-AR', {
      minimumFractionDigits: d == null ? 0 : d,
      maximumFractionDigits: d == null ? 0 : d,
    });

    function segsEje() {
      return BANDS.map((b) => ({
        label: b.label, value: b.to - b.from, from: b.from, to: b.to,
        tone: b.tone === 'neutral' ? 'main' : b.tone,
      }));
    }
    const pos = (x) => Number(Math.min(100, Math.max(0, (x / EJE_MAX) * 100)).toFixed(1));

    const lectura = (d) =>
      d < 5 ? 'muy espaciado'
      : d < 20 ? 'holgado'
      : d < 50 ? 'medio'
      : d < 120 ? 'denso'
      : 'muy denso';

    // ---------- RAMA 1: cantero de huerta ----------
    function calcCantero(v) {
      const E = ESPECIES[String(v.especie || 'tomate')] || ESPECIES.tomate;
      const largo = Math.max(0.2, Number(v.largoM) || 3);
      const ancho = Math.max(0.2, Number(v.anchoM) || 1.2);

      const hileras = Math.floor((ancho * 100) / E.entreHileras) + 1;
      const porHilera = Math.floor((largo * 100) / E.entrePlantas) + 1;
      const total = hileras * porHilera;
      const m2 = largo * ancho;
      const porM2 = m2 > 0 ? total / m2 : 0;

      const rows = [
        { k: 'Plantas que entran', ref: E.nombre + ' en ' + n1(largo, 1) + ' × ' + n1(ancho, 1) + ' m', v: total, format: 'plain', decimals: 0, extra: true },
        { k: 'Hileras a lo ancho', ref: E.entreHileras + ' cm entre hileras', v: hileras, format: 'plain', decimals: 0, extra: true },
        { k: 'Plantas por hilera', ref: E.entrePlantas + ' cm entre plantas', v: porHilera, format: 'plain', decimals: 0, extra: true },
        { k: 'Densidad', ref: 'sobre la superficie del cantero', v: porM2, format: 'unit', unit: 'plantas/m²', decimals: 1 },
        { k: 'Superficie del cantero', ref: 'largo × ancho', v: m2, format: 'unit', unit: 'm²', decimals: 2 },
        { k: 'Distancia entre plantas', ref: 'marco de plantación', v: E.entrePlantas, format: 'unit', unit: 'cm', decimals: 0 },
        { k: 'Distancia entre hileras', ref: 'marco de plantación', v: E.entreHileras, format: 'unit', unit: 'cm', decimals: 0 },
        { k: 'Plantines a comprar', ref: '10% extra por las que no prenden', v: Math.ceil(total * 1.1), format: 'plain', decimals: 0 },
      ];

      return {
        total: n1(total, 0) + (total === 1 ? ' planta' : ' plantas'),
        sub:
          E.nombre + ' en un cantero de ' + n1(largo, 1) + ' × ' + n1(ancho, 1) + ' m: ' + hileras +
          (hileras === 1 ? ' hilera' : ' hileras') + ' × ' + porHilera + ' plantas por hilera, ' +
          n1(porM2, 1) + ' plantas/m² respetando ' + E.entrePlantas + ' cm entre plantas y ' +
          E.entreHileras + ' cm entre hileras · la cuenta incluye una planta en cada extremo',
        rows: rows,
        chart: segsEje(),
        format: 'plain',
        decimals: 0,
        position: pos(porM2),
        positionLabel: n1(porM2, 1) + ' plantas por m² — marco ' + lectura(porM2),
      };
    }

    // ---------- RAMA 2: seto ----------
    function calcSeto(v) {
      const S = SETOS[String(v.especieSeto || 'tuya')] || SETOS.tuya;
      const metros = Math.max(0.5, Number(v.metrosSeto) || 10);
      const plantas = Math.ceil(metros / S.dist);
      const porMetro = 1 / S.dist;

      const rows = [
        { k: 'Plantas para el seto', ref: S.nombre + ' cada ' + n1(S.dist, 1) + ' m', v: plantas, format: 'plain', decimals: 0, extra: true },
        { k: 'Plantas por metro lineal', ref: '1 ÷ distancia', v: porMetro, format: 'plain', decimals: 2, extra: true },
        { k: 'Distancia de plantación', ref: 'recomendada para ' + S.nombre, v: S.dist * 100, format: 'unit', unit: 'cm', decimals: 0 },
        { k: 'Metros lineales de seto', ref: 'lo que vas a cubrir', v: metros, format: 'unit', unit: 'm', decimals: 1 },
        { k: 'Si lo plantás un 20% más junto', ref: 'cierra antes, sale más caro', v: Math.ceil(metros / (S.dist * 0.8)), format: 'plain', decimals: 0 },
        { k: 'Plantines a comprar', ref: '10% extra por reposición', v: Math.ceil(plantas * 1.1), format: 'plain', decimals: 0 },
      ];

      return {
        total: n1(plantas, 0) + (plantas === 1 ? ' planta' : ' plantas'),
        sub:
          plantas + ' plantas de ' + S.nombre + ' para ' + n1(metros, 1) + ' m de seto, separadas ' +
          n1(S.dist, 1) + ' m entre sí (' + n1(porMetro, 2) + ' por metro lineal) · respetá la distancia y el seto cierra parejo en dos o tres temporadas',
        rows: rows,
        chart: segsEje(),
        format: 'plain',
        decimals: 0,
        position: pos(porMetro),
        positionLabel: n1(porMetro, 2) + ' plantas por metro lineal de seto',
      };
    }

    // ---------- RAMA 3: semillas de huerta ----------
    function calcSemillas(v) {
      const S = SEMILLAS_M2[String(v.especieSemilla || 'lechuga')] || SEMILLAS_M2.lechuga;
      const m2 = Math.max(0.5, Number(v.superficieM2) || 10);
      const total = m2 * S.d;

      const rows = [
        { k: 'Semillas necesarias', ref: S.nombre + ' en ' + n1(m2, 1) + ' m²', v: total, format: 'plain', decimals: 0, extra: true },
        { k: 'Semillas a comprar', ref: '15% extra por germinación', v: Math.ceil(total * 1.15), format: 'plain', decimals: 0, extra: true },
        { k: 'Densidad de siembra', ref: 'de esta especie', v: S.d, format: 'unit', unit: 'semillas/m²', decimals: 0 },
        { k: 'Superficie a sembrar', ref: 'lo que cargaste', v: m2, format: 'unit', unit: 'm²', decimals: 1 },
        { k: 'Si la semilla es del año pasado', ref: '25% extra', v: Math.ceil(total * 1.25), format: 'plain', decimals: 0 },
        { k: 'Semillas por metro lineal de surco', ref: 'surcos a 50 cm', v: (S.d / 2), format: 'plain', decimals: 0 },
      ];

      return {
        total: n1(total, 0) + ' semillas',
        sub:
          'Para ' + n1(m2, 1) + ' m² de ' + S.nombre + ' necesitás unas ' + n1(total, 0) +
          ' semillas, a ' + S.d + ' semillas/m² · comprá un 10 a 15% de más para cubrir las que no germinen',
        rows: rows,
        chart: segsEje(),
        format: 'plain',
        decimals: 0,
        position: pos(S.d),
        positionLabel: S.d + ' semillas por m² — siembra ' + lectura(S.d),
      };
    }

    // ---------- RAMA 4: jardín vertical ----------
    function calcVertical(v) {
      const V = VERTICAL[String(v.sistema || 'bolsillos')] || VERTICAL.bolsillos;
      const ancho = Math.max(0.2, Number(v.anchoPared) || 2);
      const alto = Math.max(0.2, Number(v.altoPared) || 1.5);
      const m2 = ancho * alto;
      const total = Math.round(m2 * V.d);

      const rows = [
        { k: 'Plantas que entran', ref: V.nombre, v: total, format: 'plain', decimals: 0, extra: true },
        { k: 'Superficie de la pared', ref: n1(ancho, 1) + ' × ' + n1(alto, 1) + ' m', v: m2, format: 'unit', unit: 'm²', decimals: 1, extra: true },
        { k: 'Densidad del sistema', ref: V.nombre, v: V.d, format: 'unit', unit: 'plantas/m²', decimals: 0 },
        { k: 'Plantas a comprar', ref: '15% extra por reposición', v: Math.ceil(total * 1.15), format: 'plain', decimals: 0 },
        { k: 'Peso estimado con sustrato húmedo', ref: '~40 kg por m²: verificá la pared', v: m2 * 40, format: 'unit', unit: 'kg', decimals: 0 },
      ];

      return {
        total: n1(total, 0) + (total === 1 ? ' planta' : ' plantas'),
        sub:
          'En ' + n1(m2, 1) + ' m² (' + n1(ancho, 1) + ' × ' + n1(alto, 1) + ' m) con ' + V.nombre +
          ' entran unas ' + total + ' plantas (' + V.d + '/m²) · ' + V.consejo,
        rows: rows,
        chart: segsEje(),
        format: 'plain',
        decimals: 0,
        position: pos(V.d),
        positionLabel: V.d + ' plantas por m² de pared — ' + lectura(V.d),
      };
    }

    // ---------- RAMA 5: césped ----------
    function calcCesped(v) {
      const C = CESPED[String(v.mezcla || 'premium')] || CESPED.premium;
      const m2 = Math.max(1, Number(v.superficieCesped) || 100);
      const resiembra = String(v.tipoSiembra || 'nueva') === 'resiembra';
      const densidad = resiembra ? C.g * FACTOR_RESIEMBRA : C.g;
      const totalG = densidad * m2;
      const totalKg = totalG / 1000;
      const bolsas = Math.ceil(totalKg);

      const rows = [
        { k: 'Semilla necesaria', ref: C.nombre + (resiembra ? ' en resiembra' : ' en siembra nueva'), v: totalKg, format: 'unit', unit: 'kg', decimals: 2, extra: true },
        { k: 'Bolsas de 1 kg', ref: 'redondeando para arriba', v: bolsas, format: 'plain', decimals: 0, extra: true },
        { k: 'Densidad de siembra', ref: resiembra ? 'la mitad de la siembra nueva' : 'mezcla ' + C.nombre, v: densidad, format: 'unit', unit: 'g/m²', decimals: 0 },
        { k: 'Superficie', ref: 'lo que vas a sembrar', v: m2, format: 'unit', unit: 'm²', decimals: 0 },
        { k: 'Semilla en gramos', ref: 'densidad × superficie', v: totalG, format: 'unit', unit: 'g', decimals: 0 },
        { k: 'Si fuera siembra nueva', ref: 'referencia', v: (C.g * m2) / 1000, format: 'unit', unit: 'kg', decimals: 2 },
      ];

      return {
        total: n1(totalKg, 2) + ' kg de semilla',
        sub:
          'Para ' + n1(m2, 0) + ' m²' + (resiembra ? ' en resiembra' : '') + ' necesitás ' + n1(totalKg, 2) +
          ' kg de semilla (' + densidad + ' g/m²), o sea ' + bolsas + (bolsas === 1 ? ' bolsa' : ' bolsas') +
          ' de 1 kg · ' + (resiembra
            ? 'la resiembra usa la mitad de densidad porque el césped existente ya aporta cobertura'
            : 'la mejor época para la mezcla ' + C.nombre + ' es ' + C.epoca),
        rows: rows,
        chart: segsEje(),
        format: 'plain',
        decimals: 2,
        position: pos(densidad),
        positionLabel: densidad + ' g de semilla por m² — siembra ' + lectura(densidad),
      };
    }

    const BRANCH = {
      cantero: calcCantero, seto: calcSeto, semillas: calcSemillas,
      vertical: calcVertical, cesped: calcCesped,
    };

    H.onCompute(function (v, kase) {
      const fn = BRANCH[(kase && kase.id) || 'cantero'] || calcCantero;
      return fn(v);
    });
  })();
</script>
