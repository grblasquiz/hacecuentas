---
/**
 * Hub de decisión — "¿Cuántas plantas me entran acá?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cantero, seto, semillas de huerta, jardín vertical y
 * césped. Las cinco terminan en el mismo eje —unidades por metro cuadrado—, que
 * es lo que hace comparable el gráfico entre ramas.
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CuantasPlantasExperience from '../../components/generated/CuantasPlantasExperience.astro';
import {
  hub, ESPECIES, SETOS, SEMILLAS_M2, VERTICAL, CESPED, FACTOR_RESIEMBRA, EJE_MAX,
} from '../../lib/hubs/cuantas-plantas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CuantasPlantasExperience data={hub} />
  <Footer />
</Layout>

