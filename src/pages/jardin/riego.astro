---
/**
 * Hub de decisión — "¿Cuánto tengo que regar?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cuatro ramas (planta, goteo, programador, jardín).
 * Todas parten de la MISMA tabla de demanda base (PLANTAS / VEGETACION) para
 * que el hub no se contradiga como se contradecían las calculadoras viejas.
 *
 * Casi nada de lo que sale acá es plata: cada fila declara `format` explícito,
 * salvo el costo mensual del agua, que va en 'ars' a propósito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RiegoJardinExperience from '../../components/generated/RiegoJardinExperience.astro';
import {
  hub, PLANTAS, FACTOR_ETAPA, FACTOR_ESTACION, FACTOR_CLIMA, FACTOR_SUELO, VEGETACION, DIAS_MES,
} from '../../lib/hubs/riego';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <RiegoJardinExperience data={hub} />
  <Footer />
</Layout>

