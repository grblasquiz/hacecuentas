---
/**
 * Hub de decisión — "¿Qué maceta y cuánta tierra?"
 * Reemplaza 3 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: tres ramas (maceta, tierra, mezcla). Las tres son
 * composiciones de un volumen, así que el gráfico es un donut en todas.
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TierraMacetasExperience from '../../components/generated/TierraMacetasExperience.astro';
import { hub, TIPOS, MARGEN_ASENTAMIENTO, PROPORCION_ALTO } from '../../lib/hubs/tierra-y-macetas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <TierraMacetasExperience data={hub} />
  <Footer />
</Layout>

