---
/**
 * Hub de decisión — "¿Cuándo siembro cada cosa?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cuatro ramas (siembra, heladas, germinación, poda).
 *
 * Hub ESTACIONAL sin fecha hardcodeada: el campo `mes` arranca en 'auto' y
 * compute() lo resuelve con `new Date()` en el navegador. Todo el copy que dice
 * "ahora" (estación, qué entra a la tierra este mes, cuántos días faltan para
 * la próxima helada) sale del resultado, no del HTML, así que no envejece con
 * el build.
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito
 * ('unit' con días, cm, °C o meses, o 'plain' para conteos).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub, PAMPEANA, ZONAS, SEMILLAS, FACTOR_SUELO, GERMINACION, PODA, ROSAL, MESES, ESTACIONES,
} from '../../lib/hubs/huerta';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ PAMPEANA, ZONAS, SEMILLAS, FACTOR_SUELO, GERMINACION, PODA, ROSAL, MESES, ESTACIONES, BANDS: hub.chart.bands }}
>
  (function () {
    const H = window.HC_HUB;

    // Día del año con año no bisiesto: alcanza para contar días hasta una
    // fecha media de helada, que ya viene con un margen de varios días.
    const ACUM = [0, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    const doy = (mes, dia) => ACUM[mes] + dia;

    /** Días desde hoy hasta una fecha (mes, día), dando la vuelta al año. */
    function diasHasta(hoyMes, hoyDia, mes, dia) {
      let d = doy(mes, dia) - doy(hoyMes, hoyDia);
      if (d < 0) d += 365;
      return d;
    }

    const n1 = (x, d) => Number(x || 0).toLocaleString('es-AR', {
      minimumFractionDigits: d == null ? 0 : d,
      maximumFractionDigits: d == null ? 0 : d,
    });

    /** Meses del año como franjas contiguas (1 a 13) para el render posicional. */
    function segsAnio() {
      return BANDS.map((b) => ({
        label: b.label, value: b.to - b.from, from: b.from, to: b.to,
        tone: b.tone === 'neutral' ? 'main' : b.tone,
      }));
    }

    /** Contexto común: fecha de hoy, mes elegido, zona y cultivo. */
    function ctx(v) {
      const hoy = new Date();
      const hoyMes = hoy.getMonth() + 1;
      const hoyDia = hoy.getDate();
      const auto = String(v.mes || 'auto') === 'auto';
      const mes = auto ? hoyMes : Math.min(12, Math.max(1, Number(v.mes) || hoyMes));
      // El marcador va sobre el día real cuando el mes es el automático, y al
      // medio del mes cuando el usuario eligió uno para planificar.
      const dia = auto ? hoyDia : 15;
      const zona = ZONAS[v.zona] || ZONAS.buenosaires;
      const cultivo = SEMILLAS[v.cultivo] || SEMILLAS.tomate;
      return {
        hoy, hoyMes, hoyDia, auto, mes, dia, zona, cultivo,
        fechaHoy: hoyDia + ' de ' + MESES[hoyMes],
        estacion: ESTACIONES[mes],
        posicion: Number((((mes - 1 + (dia - 1) / 30.4) / 12) * 100).toFixed(1)),
        ultimaTxt: zona.ultima[1] + ' de ' + MESES[zona.ultima[0]],
        primeraTxt: zona.primera[1] + ' de ' + MESES[zona.primera[0]],
      };
    }

    /** Mes del calendario pampeano que le toca a esta zona en el mes `m`. */
    const mesBase = (m, offset) => (((m - 1 + offset) % 12) + 12) % 12 + 1;
    /** Camino inverso: en qué mes de la zona cae un mes del calendario base. */
    const mesZona = (b, offset) => (((b - 1 - offset) % 12) + 12) % 12 + 1;

    /** Meses (de la zona) en los que el cultivo aparece en el calendario. */
    function ventana(nombre, offset) {
      const clave = nombre.toLowerCase();
      const meses = [];
      for (let b = 1; b <= 12; b++) {
        const d = PAMPEANA[b];
        const hay = [].concat(d.directa, d.almacigo, d.trasplante)
          .some((x) => x.toLowerCase().indexOf(clave) > -1);
        if (hay) meses.push(mesZona(b, offset));
      }
      return meses.sort((a, b) => a - b);
    }

    /** "julio, agosto y septiembre" a partir de una lista de meses. */
    function listarMeses(ms) {
      if (!ms.length) return 'sin ventana en el calendario regional';
      const nom = ms.map((m) => MESES[m]);
      if (nom.length === 1) return nom[0];
      return nom.slice(0, -1).join(', ') + ' y ' + nom[nom.length - 1];
    }

    /** Rango de germinación según especie y temperatura del sustrato. */
    function rangoGerminacion(claveCultivo, cultivo, temp) {
      const tabla = GERMINACION[claveCultivo];
      if (!tabla) {
        // Sin tabla por temperatura: va el rango de referencia de la especie.
        return { min: cultivo.diasMin, max: cultivo.diasMax, banda: null };
      }
      const banda = temp < 18 ? 15 : temp < 23 ? 20 : 25;
      const r = tabla[banda];
      return { min: r[0], max: r[1], banda: banda };
    }

    // ---------- RAMA 1: calendario de siembra ----------
    function calcSiembra(v) {
      const c = ctx(v);
      const base = PAMPEANA[mesBase(c.mes, c.zona.offset)];
      const dir = base.directa, alm = base.almacigo, tra = base.trasplante;
      const total = dir.length + alm.length + tra.length;

      const prof = c.cultivo.profBase * (FACTOR_SUELO[v.suelo] || 1);
      const g = rangoGerminacion(String(v.cultivo), c.cultivo, Number(v.temperatura) || 20);
      const vent = ventana(c.cultivo.nombre, c.zona.offset);
      const enVentana = vent.indexOf(c.mes) > -1;
      const hastaUltima = diasHasta(c.hoyMes, c.hoyDia, c.zona.ultima[0], c.zona.ultima[1]);
      const hastaPrimera = diasHasta(c.hoyMes, c.hoyDia, c.zona.primera[0], c.zona.primera[1]);

      const rows = [
        { k: 'Especies para siembra directa en ' + MESES[c.mes], ref: c.zona.region, v: dir.length, format: 'plain', decimals: 0, extra: true },
        { k: 'Especies para almácigo', ref: c.zona.region, v: alm.length, format: 'plain', decimals: 0 },
        { k: 'Especies para trasplante', ref: c.zona.region, v: tra.length, format: 'plain', decimals: 0 },
        { k: 'Profundidad de siembra de ' + c.cultivo.nombre.toLowerCase(), ref: 'suelo ' + (v.suelo || 'franco'), v: prof, format: 'unit', unit: 'cm', decimals: 1 },
        { k: 'Días mínimos hasta que germine', ref: c.cultivo.metodo, v: g.min, format: 'unit', unit: 'días', decimals: 0 },
        { k: 'Días máximos hasta que germine', ref: c.cultivo.metodo, v: g.max, format: 'unit', unit: 'días', decimals: 0 },
        { k: 'Días desde hoy hasta la última helada', ref: c.ultimaTxt, v: hastaUltima, format: 'unit', unit: 'días', decimals: 0 },
        { k: 'Días desde hoy hasta la primera helada', ref: c.primeraTxt, v: hastaPrimera, format: 'unit', unit: 'días', decimals: 0 },
        { k: 'Días libres de helada al año en tu zona', ref: c.zona.label, v: c.zona.libres, format: 'unit', unit: 'días', decimals: 0 },
      ];

      const partes = [];
      partes.push('hoy es ' + c.fechaHoy + ', ' + ESTACIONES[c.hoyMes] + ' en ' + c.zona.label);
      if (dir.length) partes.push('directa: ' + dir.join(', '));
      if (alm.length) partes.push('almácigo: ' + alm.join(', '));
      if (tra.length) partes.push('trasplante: ' + tra.join(', '));
      partes.push(
        enVentana
          ? c.cultivo.nombre + ' está en ventana este mes'
          : c.cultivo.nombre + ' va en ' + listarMeses(vent)
      );

      return {
        total: total + (total === 1 ? ' especie' : ' especies'),
        sub: partes.join(' · '),
        rows: rows,
        chart: segsAnio(),
        format: 'plain',
        decimals: 0,
        position: c.posicion,
        positionLabel:
          MESES[c.mes] + ' — ' + c.estacion + ' en ' + c.zona.label + ' · ventana de siembra de ' +
          c.cultivo.nombre.toLowerCase() + ': ' + listarMeses(vent) + ' · última helada ~' + c.ultimaTxt,
      };
    }

    // ---------- RAMA 2: heladas ----------
    function calcHeladas(v) {
      const c = ctx(v);
      const hastaUltima = diasHasta(c.hoyMes, c.hoyDia, c.zona.ultima[0], c.zona.ultima[1]);
      const hastaPrimera = diasHasta(c.hoyMes, c.hoyDia, c.zona.primera[0], c.zona.primera[1]);
      const conRiesgo = 365 - c.zona.libres;
      // ¿Estamos dentro de la ventana con riesgo? Sí si la primera helada ya
      // pasó y la última todavía no llegó: eso es que falta menos para la última.
      const enRiesgo = hastaUltima < hastaPrimera;

      const rows = [
        { k: 'Días libres de helada al año', ref: c.zona.label, v: c.zona.libres, format: 'unit', unit: 'días', decimals: 0, extra: true },
        { k: 'Días del año con riesgo de helada', ref: '365 − días libres', v: conRiesgo, format: 'unit', unit: 'días', decimals: 0 },
        { k: 'Días desde hoy hasta la última helada', ref: c.ultimaTxt, v: hastaUltima, format: 'unit', unit: 'días', decimals: 0, extra: true },
        { k: 'Días desde hoy hasta la primera helada', ref: c.primeraTxt, v: hastaPrimera, format: 'unit', unit: 'días', decimals: 0 },
        { k: 'Última helada — día del año', ref: c.ultimaTxt, v: doy(c.zona.ultima[0], c.zona.ultima[1]), format: 'unit', unit: 'del año', decimals: 0 },
        { k: 'Primera helada — día del año', ref: c.primeraTxt, v: doy(c.zona.primera[0], c.zona.primera[1]), format: 'unit', unit: 'del año', decimals: 0 },
      ];

      const calif = c.zona.libres >= 270
        ? 'temporada larga y holgada'
        : c.zona.libres >= 200
          ? 'temporada media'
          : 'temporada corta: el invernadero casi no es opcional';

      return {
        total: c.zona.libres + ' días libres',
        sub:
          c.zona.label + ' · última helada ~' + c.ultimaTxt + ' · primera ~' + c.primeraTxt + ' · ' + calif +
          ' · hoy es ' + c.fechaHoy + ': ' +
          (enRiesgo
            ? 'faltan ' + hastaUltima + ' días para que termine el riesgo'
            : 'faltan ' + hastaPrimera + ' días para la primera helada') +
          ' · ' + c.zona.consejo,
        rows: rows,
        chart: segsAnio(),
        format: 'unit',
        unit: 'días',
        decimals: 0,
        position: c.posicion,
        positionLabel:
          'Hoy ' + c.fechaHoy + ' (' + ESTACIONES[c.hoyMes] + ') · última helada ~' + c.ultimaTxt +
          ' · primera ~' + c.primeraTxt + ' · ' + c.zona.libres + ' días libres',
      };
    }

    // ---------- RAMA 3: germinación ----------
    function calcGerminacion(v) {
      const c = ctx(v);
      const temp = Number(v.temperatura) || 20;
      const clave = String(v.cultivo);
      const g = rangoGerminacion(clave, c.cultivo, temp);
      const tabla = GERMINACION[clave];
      const prof = c.cultivo.profBase * (FACTOR_SUELO[v.suelo] || 1);

      const rows = [
        { k: 'Temperatura del sustrato', ref: 'la que cargaste', v: temp, format: 'unit', unit: '°C', decimals: 0 },
        { k: 'Días mínimos hasta que germine', ref: c.cultivo.nombre, v: g.min, format: 'unit', unit: 'días', decimals: 0 },
        { k: 'Días máximos hasta que germine', ref: c.cultivo.nombre, v: g.max, format: 'unit', unit: 'días', decimals: 0, extra: true },
        { k: 'Profundidad de siembra', ref: 'suelo ' + (v.suelo || 'franco'), v: prof, format: 'unit', unit: 'cm', decimals: 1 },
      ];
      if (tabla) {
        rows.push({ k: 'Días máximos si el sustrato baja a 15 °C', ref: 'franja fría', v: tabla[15][1], format: 'unit', unit: 'días', decimals: 0 });
        rows.push({ k: 'Días máximos si el sustrato sube a 25 °C', ref: 'franja cálida', v: tabla[25][1], format: 'unit', unit: 'días', decimals: 0 });
      }

      const lectura = !tabla
        ? 'no hay tabla por temperatura para esta especie: va el rango de referencia'
        : g.banda === 25
          ? 'estás en la franja cálida, casi lo más rápido posible'
          : g.banda === 15
            ? 'franja fría: subir hacia 20 o 25 °C puede recortar la espera casi a la mitad'
            : 'franja media: unos grados más, hacia 25 °C, acelera el brote';

      return {
        total: g.min + ' a ' + g.max + ' días',
        sub:
          c.cultivo.nombre + ' a ' + temp + ' °C germina en ' + g.min + ' a ' + g.max + ' días · ' + lectura +
          ' · sembrala a ' + n1(prof, 1) + ' cm · ' + c.cultivo.consejo,
        rows: rows,
        chart: segsAnio(),
        format: 'unit',
        unit: 'días',
        decimals: 0,
        position: c.posicion,
        positionLabel:
          c.cultivo.nombre + ' a ' + temp + ' °C: ' + g.min + ' a ' + g.max + ' días · hoy ' + c.fechaHoy +
          ' (' + ESTACIONES[c.hoyMes] + ') · última helada ~' + c.ultimaTxt,
      };
    }

    // ---------- RAMA 4: poda ----------
    function calcPoda(v) {
      const c = ctx(v);
      const clave = String(v.arbol || 'limonero');
      const p = PODA[clave] || PODA.limonero;
      // El rosal es el único cuya ventana la fija el clima de la zona.
      const rosal = clave === 'rosal' ? (ROSAL[c.zona.clima] || ROSAL.templado) : null;
      const desde = rosal ? rosal.desde : p.desde;
      const hasta = rosal ? rosal.hasta : p.hasta;
      const edad = Math.max(1, Number(v.edadArbol) || 1);

      const tipo = edad <= 3
        ? 'poda de formación'
        : edad > 20
          ? 'poda de rejuvenecimiento'
          : 'poda de producción y mantenimiento';

      // Meses desde hoy hasta que abre la ventana (0 si ya estamos adentro).
      const dentro = c.hoyMes >= desde && c.hoyMes <= hasta;
      const faltan = dentro ? 0 : (((desde - c.hoyMes) % 12) + 12) % 12;

      const rows = [
        { k: 'Edad del árbol', ref: tipo, v: edad, format: 'unit', unit: 'años', decimals: 0 },
        { k: 'Años entre podas', ref: p.cadencia, v: p.cadaAnios, format: 'unit', unit: 'años', decimals: 1 },
        { k: 'Meses desde hoy hasta la ventana de poda', ref: dentro ? 'ya estás dentro' : MESES[desde], v: faltan, format: 'unit', unit: 'meses', decimals: 0, extra: true },
        { k: 'Duración de la ventana de poda', ref: MESES[desde] + ' a ' + MESES[hasta], v: hasta - desde + 1, format: 'unit', unit: 'meses', decimals: 0 },
        { k: 'Mes en que abre la ventana', ref: MESES[desde], v: desde, format: 'plain', decimals: 0 },
        { k: 'Mes en que cierra la ventana', ref: MESES[hasta], v: hasta, format: 'plain', decimals: 0 },
      ];

      const ventanaTxt = desde === hasta ? MESES[desde] : MESES[desde] + ' y ' + MESES[hasta];

      return {
        total: ventanaTxt.charAt(0).toUpperCase() + ventanaTxt.slice(1),
        sub:
          p.nombre + ' de ' + edad + (edad === 1 ? ' año' : ' años') + ': ' + tipo + ', ' + p.cadencia.toLowerCase() +
          ' · ventana ' + ventanaTxt + (rosal ? ' (' + rosal.texto + ', clima ' + c.zona.clima + ')' : '') +
          ' · hoy es ' + c.fechaHoy + ': ' + (dentro ? 'estás dentro de la ventana' : 'faltan ' + faltan + (faltan === 1 ? ' mes' : ' meses')) +
          ' · ' + p.consejo,
        rows: rows,
        chart: segsAnio(),
        format: 'unit',
        unit: 'meses',
        decimals: 0,
        position: c.posicion,
        positionLabel:
          'Hoy ' + c.fechaHoy + ' (' + ESTACIONES[c.hoyMes] + ') · ventana de poda de ' + p.nombre.toLowerCase() +
          ': ' + ventanaTxt + ' · ' + tipo,
      };
    }

    const BRANCH = { siembra: calcSiembra, heladas: calcHeladas, germinacion: calcGerminacion, poda: calcPoda };

    H.onCompute(function (v, kase) {
      const fn = BRANCH[(kase && kase.id) || 'siembra'] || calcSiembra;
      return fn(v);
    });
  })();
</script>
