---
/**
 * Hub de decisión — "¿Me conviene poner paneles solares?"
 * Reemplaza 3 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: cálculo dominante (sin `cases`). Una sola cadena:
 * consumo en kWh → paneles y kWp → generación → ahorro en pesos → años de repago.
 *
 * Las constantes (eficiencia 0,80, inyección al 70%, 2,2 m² por panel, precio
 * marginal del kWh con impuestos, tipo de cambio) NO están acá: se derivan de
 * las fórmulas reales del repo dentro de src/lib/hubs/paneles-solares.ts.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PanelesSolaresExperience from '../../components/generated/PanelesSolaresExperience.astro';
import {
  hub,
  REGIONES,
  ORIENTACIONES,
  EFICIENCIA,
  M2_POR_PANEL,
  FACTOR_INYECCION,
  VIDA_UTIL_ANOS,
} from '../../lib/hubs/paneles-solares';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PanelesSolaresExperience data={hub} />
  <Footer />
</Layout>

