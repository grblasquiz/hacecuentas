---
/**
 * Hub de decisión — "Tanque, cañerías y termotanque: ¿qué capacidad necesito?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Toda la matemática es espejo de las fórmulas originales de src/lib/formulas/:
 * tanque-agua-litros-personas, capacidad-tanque-cisterna,
 * calefon-termotanque-litros-personas, cano-agua-diametro-caudal,
 * bombeo-cisterna-tanque-watts y cano-estructural-peso-ml.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  LITROS_PERSONA_DIA,
  TANQUES_COMERCIALES,
  LLENADO_UTIL_CISTERNA,
  PROFUNDIDAD_CISTERNA_M,
  LITROS_ACS_POR_USO,
  TERMOTANQUES_COMERCIALES,
  CAUDAL_POR_PUNTO_LS,
  VELOCIDAD_DISENO_MS,
  CANOS_COMERCIALES_MM,
  RENDIMIENTO_BOMBA,
  DENSIDAD_ACERO,
  PERFILES,
} from '../../lib/hubs/agua-obra';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const CONST = {
  LPD: LITROS_PERSONA_DIA,
  TANQUES: TANQUES_COMERCIALES,
  LLENADO: LLENADO_UTIL_CISTERNA,
  PROF: PROFUNDIDAD_CISTERNA_M,
  ACS: LITROS_ACS_POR_USO,
  TERMOS: TERMOTANQUES_COMERCIALES,
  QPUNTO: CAUDAL_POR_PUNTO_LS,
  VEL: VELOCIDAD_DISENO_MS,
  CANOS: CANOS_COMERCIALES_MM,
  ETA: RENDIMIENTO_BOMBA,
  RHO_ACERO: DENSIDAD_ACERO,
  PERFILES,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ C: CONST }}>
  (function () {
    const H = window.HC_HUB;

    function nf(n, d) {
      return Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });
    }
    function siguiente(lista, x) {
      for (let i = 0; i < lista.length; i++) if (lista[i] >= x) return lista[i];
      return lista[lista.length - 1];
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'tanque';
      const personas = Math.max(1, Math.round(v.personas) || 1);
      const reserva = Math.max(1, Math.round(v.reserva) || 1);

      // --- Tanque de reserva -------------------------------------------------
      // Espejo de src/lib/formulas/tanque-agua-litros-personas.ts
      const litrosNecesarios = personas * C.LPD * reserva;
      const tanque = siguiente(C.TANQUES, litrosNecesarios);

      if (id === 'tanque') {
        const consumoDia = personas * C.LPD;
        const reservaExtra = litrosNecesarios - consumoDia;
        const holgura = Math.max(0, tanque - litrosNecesarios);
        return {
          total: nf(tanque) + ' L',
          sub:
            personas + (personas === 1 ? ' persona' : ' personas') + ' × ' + C.LPD + ' L × ' +
            reserva + (reserva === 1 ? ' día' : ' días') + ' = ' + nf(litrosNecesarios) +
            ' L · tanque comercial de ' + nf(tanque) + ' L',
          format: 'unit',
          unit: 'L',
          rows: [
            { k: 'Consumo por persona y día', ref: 'uso residencial', v: C.LPD, format: 'unit', unit: 'L' },
            { k: 'Consumo de la casa en un día', v: consumoDia, format: 'unit', unit: 'L' },
            { k: 'Litros necesarios con ' + reserva + (reserva === 1 ? ' día' : ' días') + ' de reserva', v: litrosNecesarios, format: 'unit', unit: 'L' },
            { k: 'Tanque comercial a comprar', ref: 'IRAM 13478', v: tanque, format: 'unit', unit: 'L', extra: true },
            { k: 'Holgura que te queda', v: holgura, format: 'unit', unit: 'L' },
            { k: 'Peso del tanque lleno', v: tanque, format: 'unit', unit: 'kg' },
          ],
          chart: [
            { label: 'Consumo de un día', value: consumoDia, tone: 'main' },
            { label: 'Reserva de los días extra', value: reservaExtra, tone: 'exit' },
            { label: 'Holgura del tamaño comercial', value: holgura, tone: 'prop' },
          ],
        };
      }

      // --- Cisterna ----------------------------------------------------------
      // Espejo invertido de src/lib/formulas/capacidad-tanque-cisterna.ts:
      // aquel va dimensiones → litros; acá vamos litros útiles → dimensiones,
      // con el mismo llenado útil del 90% y el mismo consumo de 200 L/persona.
      if (id === 'cisterna') {
        const utilNecesario = litrosNecesarios;
        const geometrico = utilNecesario / C.LLENADO;
        const noAprovechable = geometrico - utilNecesario;
        const areaM2 = geometrico / 1000 / C.PROF;
        const ladoM = Math.sqrt(areaM2);
        const diasFam4 = utilNecesario / (4 * C.LPD);
        return {
          total: nf(utilNecesario) + ' L',
          sub:
            'Útiles para ' + personas + (personas === 1 ? ' persona' : ' personas') + ' durante ' +
            reserva + (reserva === 1 ? ' día' : ' días') + ' · hay que excavar por ' +
            nf(geometrico) + ' L (' + nf(geometrico / 1000, 2) + ' m³)',
          format: 'unit',
          unit: 'L',
          rows: [
            { k: 'Litros útiles que necesitás', v: utilNecesario, format: 'unit', unit: 'L', extra: true },
            { k: 'Volumen geométrico a excavar', ref: 'llenado útil 90%', v: geometrico, format: 'unit', unit: 'L' },
            { k: 'Volumen en metros cúbicos', v: geometrico / 1000, format: 'unit', unit: 'm³', decimals: 2 },
            { k: 'Lado del pozo cuadrado', ref: 'profundidad ' + nf(C.PROF, 1) + ' m', v: ladoM, format: 'unit', unit: 'm', decimals: 2 },
            { k: 'Autonomía para una familia de 4', v: diasFam4, format: 'unit', unit: 'días', decimals: 1 },
          ],
          chart: [
            { label: 'Volumen útil', value: utilNecesario, tone: 'main' },
            { label: 'No aprovechable (10%)', value: noAprovechable, tone: 'warn' },
          ],
        };
      }

      // --- Agua caliente -----------------------------------------------------
      // Espejo de src/lib/formulas/calefon-termotanque-litros-personas.ts
      if (id === 'termotanque') {
        const lpp = C.ACS[String(v.uso)] || C.ACS.normal;
        const demandaDiaria = personas * lpp;
        const coefSim = personas <= 2 ? 1 : personas <= 4 ? 0.85 : personas <= 6 ? 0.75 : 0.65;
        const demandaPico = demandaDiaria * coefSim;
        const esCalefon = String(v.equipo) === 'calefon';

        if (esCalefon) {
          const caudal = personas <= 2 ? 14 : personas <= 4 ? 22 : 24;
          const nota = personas <= 2 ? 'una ducha por vez' : personas <= 4 ? 'modulante, dos duchas justas' : 'conviene termotanque auxiliar';
          return {
            total: nf(caudal) + ' L/min',
            sub: 'Calefón instantáneo para ' + personas + (personas === 1 ? ' persona' : ' personas') + ' con uso ' + String(v.uso) + ' — ' + nota,
            format: 'unit',
            unit: 'L/min',
            rows: [
              { k: 'Agua caliente por persona y día', ref: 'a 60 °C', v: lpp, format: 'unit', unit: 'L' },
              { k: 'Demanda diaria de la casa', v: demandaDiaria, format: 'unit', unit: 'L' },
              { k: 'Demanda en el pico', ref: 'simultaneidad ' + Math.round(coefSim * 100) + '%', v: demandaPico, format: 'unit', unit: 'L' },
              { k: 'Caudal de calefón recomendado', v: caudal, format: 'unit', unit: 'L/min', extra: true },
              { k: 'Duchas simultáneas que cubre', ref: '~10 L/min cada una', v: Math.floor(caudal / 10), format: 'plain' },
            ],
            chart: [
              { label: 'Caudal de una ducha', value: 10, tone: 'main' },
              { label: 'Caudal extra del equipo', value: Math.max(0, caudal - 10), tone: 'exit' },
            ],
          };
        }

        const termo = siguiente(C.TERMOS, demandaPico);
        const margen = Math.max(0, termo - demandaPico);
        return {
          total: nf(termo) + ' L',
          sub:
            personas + (personas === 1 ? ' persona' : ' personas') + ' × ' + lpp + ' L de uso ' + String(v.uso) +
            ' · pico de ' + nf(demandaPico) + ' L con simultaneidad del ' + Math.round(coefSim * 100) + '%',
          format: 'unit',
          unit: 'L',
          rows: [
            { k: 'Agua caliente por persona y día', ref: 'a 60 °C', v: lpp, format: 'unit', unit: 'L' },
            { k: 'Demanda diaria de la casa', v: demandaDiaria, format: 'unit', unit: 'L' },
            { k: 'Coeficiente de simultaneidad', v: coefSim * 100, format: 'unit', unit: '%' },
            { k: 'Demanda en el pico', v: demandaPico, format: 'unit', unit: 'L' },
            { k: 'Termotanque a comprar', ref: 'tamaño comercial', v: termo, format: 'unit', unit: 'L', extra: true },
            { k: 'Margen sobre el pico', v: margen, format: 'unit', unit: 'L' },
          ],
          chart: [
            { label: 'Demanda del pico', value: demandaPico, tone: 'main' },
            { label: 'Margen del tamaño comercial', value: margen, tone: 'prop' },
          ],
        };
      }

      // --- Diámetro de cañería ----------------------------------------------
      // Caudal por puntos sanitarios (espejo de diametro-caneria.ts) y sección
      // por continuidad a 1,5 m/s (espejo de cano-agua-diametro-caudal.ts).
      if (id === 'caneria') {
        const puntos = Math.max(1, Math.round(v.puntos) || 1);
        const pisos = Math.max(1, Math.round(v.pisos) || 1);
        const qLs = puntos * C.QPUNTO;
        const area = qLs / 1000 / C.VEL; // m²
        const dTeorico = Math.sqrt((4 * area) / Math.PI) * 1000; // mm
        let idx = C.CANOS.findIndex(function (x) { return x >= dTeorico; });
        if (idx < 0) idx = C.CANOS.length - 1;
        const idxBase = idx;
        if (pisos >= 2 && idx < C.CANOS.length - 1) idx += 1;
        if (pisos >= 4 && idx < C.CANOS.length - 1) idx += 1;
        const dComercial = C.CANOS[idx];
        const areaComercial = Math.PI * Math.pow(dComercial / 2000, 2);
        const velReal = qLs / 1000 / areaComercial;
        const subidas = idx - idxBase;
        return {
          total: nf(dComercial) + ' mm',
          sub:
            puntos + ' puntos sanitarios mueven ' + nf(qLs, 2) + ' L/s · sección teórica ' + nf(dTeorico) +
            ' mm a ' + nf(C.VEL, 1) + ' m/s' + (subidas > 0 ? ' · +' + subidas + ' medida' + (subidas > 1 ? 's' : '') + ' por los ' + pisos + ' pisos' : ''),
          format: 'unit',
          unit: 'mm',
          rows: [
            { k: 'Puntos sanitarios', v: puntos, format: 'plain' },
            { k: 'Caudal por punto', v: C.QPUNTO, format: 'unit', unit: 'L/s', decimals: 2 },
            { k: 'Caudal total', v: qLs, format: 'unit', unit: 'L/s', decimals: 2 },
            { k: 'Caudal por minuto', v: qLs * 60, format: 'unit', unit: 'L/min', decimals: 1 },
            { k: 'Diámetro interno teórico', ref: 'a ' + nf(C.VEL, 1) + ' m/s', v: dTeorico, format: 'unit', unit: 'mm', decimals: 1 },
            { k: 'Caño comercial de la principal', v: dComercial, format: 'unit', unit: 'mm', extra: true },
            { k: 'Velocidad real en ese caño', v: velReal, format: 'unit', unit: 'm/s', decimals: 2 },
            { k: 'Bajadas a cada artefacto', ref: '½"', v: 13, format: 'unit', unit: 'mm' },
          ],
          chart: [
            { label: 'Sección que necesita el caudal', value: area * 1e6, tone: 'main' },
            { label: 'Sección extra del caño comercial', value: Math.max(0, areaComercial * 1e6 - area * 1e6), tone: 'prop' },
          ],
        };
      }

      // --- Bomba elevadora ---------------------------------------------------
      // Espejo de src/lib/formulas/bombeo-cisterna-tanque-watts.ts
      if (id === 'bomba') {
        const altura = Math.max(1, v.altura || 1);
        const qLmin = tanque / 60; // llenar el tanque de reserva en una hora
        const qM3s = qLmin / 60000;
        const util = qM3s * 1000 * 9.81 * altura; // W hidráulicos
        const potencia = util / C.ETA;
        const perdidas = potencia - util;
        const hp = potencia / 746;
        const hpComercial =
          hp <= 0.5 ? '1/2 HP' : hp <= 0.75 ? '3/4 HP' : hp <= 1 ? '1 HP' : hp <= 1.5 ? '1½ HP' : hp <= 2 ? '2 HP' : Math.ceil(hp) + ' HP';
        return {
          total: nf(potencia) + ' W',
          sub:
            'Para llenar el tanque de ' + nf(tanque) + ' L en una hora (' + nf(qLmin, 1) + ' L/min) a ' +
            nf(altura) + ' m · comprá una bomba de ' + hpComercial,
          format: 'unit',
          unit: 'W',
          rows: [
            { k: 'Caudal a elevar', ref: 'tanque lleno en 1 h', v: qLmin, format: 'unit', unit: 'L/min', decimals: 1 },
            { k: 'Altura de elevación', v: altura, format: 'unit', unit: 'm' },
            { k: 'Potencia hidráulica útil', v: util, format: 'unit', unit: 'W' },
            { k: 'Pérdidas por rendimiento', ref: 'η ' + Math.round(C.ETA * 100) + '%', v: perdidas, format: 'unit', unit: 'W' },
            { k: 'Potencia al eje', v: potencia, format: 'unit', unit: 'W', extra: true },
            { k: 'Potencia teórica en HP', v: hp, format: 'unit', unit: 'HP', decimals: 2 },
          ],
          chart: [
            { label: 'Trabajo útil de elevación', value: util, tone: 'main' },
            { label: 'Pérdidas del equipo', value: perdidas, tone: 'warn' },
          ],
        };
      }

      // --- Estructura de soporte --------------------------------------------
      // Espejo de src/lib/formulas/cano-estructural-peso-ml.ts
      const p = C.PERFILES[String(v.perfil)] || C.PERFILES.c50;
      const metros = Math.max(1, v.metros || 1);
      const pesoMl =
        p.forma === 'redondo'
          ? (Math.PI * (p.a - p.e) * p.e * C.RHO_ACERO) / 1000000
          : ((2 * (p.a + p.b) - 4 * p.e) * p.e * C.RHO_ACERO) / 1000000;
      const pesoAcero = pesoMl * metros;
      const pesoAgua = tanque; // 1 litro de agua = 1 kg
      const cargaTotal = pesoAcero + pesoAgua;
      const barras = Math.ceil(metros / 6);
      return {
        total: nf(cargaTotal) + ' kg',
        sub:
          p.label + ' · ' + nf(pesoMl, 2) + ' kg/m × ' + nf(metros) + ' m = ' + nf(pesoAcero, 1) +
          ' kg de acero, más ' + nf(pesoAgua) + ' kg del tanque lleno',
        format: 'unit',
        unit: 'kg',
        rows: [
          { k: 'Peso del perfil por metro', ref: 'acero 7.850 kg/m³', v: pesoMl, format: 'unit', unit: 'kg/m', decimals: 2 },
          { k: 'Metros de perfil', v: metros, format: 'unit', unit: 'm' },
          { k: 'Barras de 6 m a comprar', v: barras, format: 'plain' },
          { k: 'Peso del acero de la estructura', v: pesoAcero, format: 'unit', unit: 'kg', decimals: 1 },
          { k: 'Peso del agua del tanque lleno', ref: '1 L = 1 kg', v: pesoAgua, format: 'unit', unit: 'kg' },
          { k: 'Carga total sobre los apoyos', v: cargaTotal, format: 'unit', unit: 'kg', decimals: 1, extra: true },
        ],
        chart: [
          { label: 'Agua del tanque lleno', value: pesoAgua, tone: 'main' },
          { label: 'Acero de la estructura', value: pesoAcero, tone: 'exit' },
        ],
      };
    });
  })();
</script>
