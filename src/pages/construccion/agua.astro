---
/**
 * Hub de decisión — "Tanque, cañerías y termotanque: ¿qué capacidad necesito?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Toda la matemática es espejo de las fórmulas originales de src/lib/formulas/:
 * tanque-agua-litros-personas, capacidad-tanque-cisterna,
 * calefon-termotanque-litros-personas, cano-agua-diametro-caudal,
 * bombeo-cisterna-tanque-watts y cano-estructural-peso-ml.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AguaConstruccionExperience from '../../components/generated/AguaConstruccionExperience.astro';
import {
  hub,
  LITROS_PERSONA_DIA,
  TANQUES_COMERCIALES,
  LLENADO_UTIL_CISTERNA,
  PROFUNDIDAD_CISTERNA_M,
  LITROS_ACS_POR_USO,
  TERMOTANQUES_COMERCIALES,
  CAUDAL_POR_PUNTO_LS,
  VELOCIDAD_DISENO_MS,
  CANOS_COMERCIALES_MM,
  RENDIMIENTO_BOMBA,
  DENSIDAD_ACERO,
  PERFILES,
} from '../../lib/hubs/agua-obra';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const CONST = {
  LPD: LITROS_PERSONA_DIA,
  TANQUES: TANQUES_COMERCIALES,
  LLENADO: LLENADO_UTIL_CISTERNA,
  PROF: PROFUNDIDAD_CISTERNA_M,
  ACS: LITROS_ACS_POR_USO,
  TERMOS: TERMOTANQUES_COMERCIALES,
  QPUNTO: CAUDAL_POR_PUNTO_LS,
  VEL: VELOCIDAD_DISENO_MS,
  CANOS: CANOS_COMERCIALES_MM,
  ETA: RENDIMIENTO_BOMBA,
  RHO_ACERO: DENSIDAD_ACERO,
  PERFILES,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <AguaConstruccionExperience data={hub} />
  <Footer />
</Layout>

