---
/**
 * Hub de decisión — "¿Cuánto sale construir una casa?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: cálculo dominante (sin `cases`, con `answer`).
 * El costo del m² NO está acá: se deriva de src/lib/formulas/costo-m2-construccion.ts
 * (índice CAC / CPIC / ICC INDEC) dentro de src/lib/hubs/costo-por-m2.ts.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CostoM2Experience from '../../components/CostoM2Experience.astro';
import NextTenBoost from '../../components/NextTenBoost.astro';
import { hub, M2, SHARES } from '../../lib/hubs/costo-por-m2';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
    { '@type': 'WebApplication', name: hub.title, url: CANONICAL, description: hub.description, applicationCategory: 'FinanceApplication', operatingSystem: 'Web', dateModified: hub.lastReviewed, author: { '@id': 'https://hacecuentas.com/autores/martin-rodriguez#person' }, publisher: { '@id': 'https://hacecuentas.com/#organization' }, isBasedOn: hub.sources.map((source) => source.url), offers: { '@type': 'Offer', price: '0', priceCurrency: 'ARS' } },
  ],
};
import HubCitableStats from '../../components/hub/HubCitableStats.astro';
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CostoM2Experience data={hub} />
  <NextTenBoost variant="construction" />
  <HubCitableStats data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ M2, SHARES }}>
  (function () {
    const H = window.HC_HUB;
    if (!H) return;
    const TONES = ['main', 'exit', 'prop', 'warn'];

    H.onCompute(function (v) {
      const cat = v.categoria || 'estandar';
      const zona = v.zona || 'gba_sur';
      const tabla = (M2[cat] || M2.estandar)[zona] || M2.estandar.gba_sur;

      const cubiertos = Math.max(0, v.cubiertos || 0);
      const semi = Math.max(0, v.semi || 0);
      const computables = cubiertos + semi * 0.5;

      const obra = tabla.ars * computables;

      const rows = SHARES.map(function (s) {
        return { k: s.label, ref: Math.round(s.share * 100) + '% de la obra', v: obra * s.share };
      });
      const total = obra;
      const cuotas = Math.max(1, v.cuotas || 1);

      return {
        total: H.ars(total),
        sub:
          computables.toLocaleString('es-AR') + ' m² computables · ' +
          H.ars(tabla.ars) + '/m² (US$' + tabla.usd.toLocaleString('es-AR') + '/m²) · ' +
          'promedio lineal a valores de hoy ' + H.ars(total / cuotas) + ' por mes (no es cuota contractual)',
        rows: rows,
        chart: SHARES.map(function (s, i) {
          return { label: s.label, value: obra * s.share, tone: TONES[i % TONES.length] };
        }),
      };
    });
  })();
</script>
