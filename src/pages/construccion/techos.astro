---
/**
 * Hub de decisión — "¿Cuánto material necesito para el techo y cuánto me sale?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: cálculo dominante (sin `cases`). El trabajo se elige en un select.
 * Las constantes NO están acá: se derivan de las fórmulas reales del repo
 * (pendiente-techo, membrana-asfaltica-rollos, impermeabilizacion-techo-...,
 * techos-tejas, impermeabilizante-m2) dentro de src/lib/hubs/techos.ts.
 *
 * Lo que el hub resuelve y ninguna calc suelta hacía: la pendiente deja de ser
 * un cálculo aparte y se convierte en el campo que agranda la superficie con
 * la que después comprás membrana o tejas.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  MEMBRANAS,
  TEJAS,
  CLASIF,
  PRIMER_KG_M2,
  CUMBRERA_CADA_M2,
  LISTONES_M_POR_M2,
} from '../../lib/hubs/techos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    MEMBRANAS,
    TEJAS,
    CLASIF,
    PRIMER_KG_M2,
    CUMBRERA_CADA_M2,
    LISTONES_M_POR_M2,
  }}
>
  (function () {
    const H = window.HC_HUB;

    // Filas que NO son plata. El runtime hace Object.assign: sin `format`
    // propio, la fila cae a pesos.
    const M2 = { format: 'unit', unit: 'm²', decimals: 1 };
    const KG = { format: 'unit', unit: 'kg', decimals: 1 };
    const ROLL = { format: 'unit', unit: 'rollos', decimals: 0 };
    const PZ = { format: 'unit', unit: 'piezas', decimals: 0 };
    const ML = { format: 'unit', unit: 'm', decimals: 0 };
    const PCT = { format: 'unit', unit: '%', decimals: 1 };
    const GR = { format: 'unit', unit: '°', decimals: 1 };
    const CM = { format: 'unit', unit: 'cm/m', decimals: 1 };
    const FAC = { format: 'plain', decimals: 3 };
    const ARS = { format: 'ars', decimals: 0 };

    const n = (x, d) =>
      Number(x || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });
    const money = (x) => '$' + n(Math.round(x));

    /** Clasificación de la pendiente, con las franjas barridas de la fórmula. */
    function clasificar(pct) {
      for (let i = 0; i < CLASIF.length; i++) {
        if (pct < CLASIF[i].hasta) return CLASIF[i].label;
      }
      return CLASIF[CLASIF.length - 1].label;
    }

    H.onCompute(function (v) {
      const trabajo = String(v.trabajo || 'membrana');
      const largo = Math.max(0, v.largo || 0);
      const ancho = Math.max(0, v.ancho || 0);
      const planta = largo * ancho;

      // ── Pendiente: % y grados, según cómo la haya cargado el usuario ────
      const modo = String(v.modo || 'porcentaje');
      let pct = 0;
      if (modo === 'grados') {
        const g = Math.min(89.9, Math.max(0, v.pendiente || 0));
        pct = Math.tan((g * Math.PI) / 180) * 100;
      } else if (modo === 'altura') {
        const alt = Math.max(0, v.altura || 0);
        const base = Math.max(0, v.base || 0);
        pct = base > 0 ? (alt / base) * 100 : 0;
      } else {
        pct = Math.max(0, v.pendiente || 0);
      }
      const grados = Math.atan(pct / 100) * (180 / Math.PI);
      // Mismo factor que usa techos-tejas.ts: √(1 + (pendiente/100)²), que es
      // el largo inclinado dividido la base de pendiente-techo.ts.
      const factor = Math.sqrt(1 + Math.pow(pct / 100, 2));
      const faldon = planta * factor;
      const extraM2 = faldon - planta;
      const clasif = clasificar(pct);

      if (!planta) {
        return { total: '$0', sub: 'Cargá el largo y el ancho del techo en planta.', rows: [], chart: [] };
      }

      const filasPendiente = [
        { k: 'Superficie del techo en planta', ref: 'largo × ancho, visto desde arriba', v: planta, ...M2 },
        { k: 'Pendiente', ref: 'altura ÷ base × 100', v: pct, ...PCT },
        { k: 'Pendiente en grados', ref: 'arcotangente de altura ÷ base', v: grados, ...GR },
        { k: 'Lo que sube por metro horizontal', ref: 'el % leído como cm/m', v: pct, ...CM },
        { k: 'Factor de inclinación', ref: '√(1 + (pendiente ÷ 100)²)', v: factor, ...FAC },
        { k: 'Superficie real del faldón', ref: 'planta × factor', v: faldon, extra: true, ...M2 },
        { k: 'm² que agrega la pendiente', ref: 'los que faltan si comprás por la planta', v: extraM2, ...M2 },
      ];

      const manoObra = String(v.manoObra || 'si') === 'si';
      const moM2 = Math.max(0, v.moM2 || 0);
      const costoMO = manoObra ? faldon * moM2 : 0;

      // ── Rama: sólo pendiente ────────────────────────────────────────────
      if (trabajo === 'pendiente') {
        return {
          total: n(pct, 1) + '% · ' + n(grados, 1) + '°',
          sub:
            clasif + ' · ' + n(pct, 1) + ' cm por metro horizontal · ' +
            n(planta, 1) + ' m² en planta pasan a ' + n(faldon, 1) + ' m² reales de faldón (+' + n(extraM2, 1) + ' m²)',
          format: 'plain',
          rows: filasPendiente,
          chart: [
            { label: 'Superficie en planta', value: Math.round(planta * 10) / 10, tone: 'main' },
            { label: 'm² extra por la pendiente', value: Math.round(extraM2 * 10) / 10, tone: 'warn' },
          ],
        };
      }

      // ── Rama: membrana asfáltica ────────────────────────────────────────
      if (trabajo === 'membrana') {
        const M = MEMBRANAS[String(v.tipoMembrana)] || MEMBRANAS.geotextil_40;
        const solape = Math.min(50, Math.max(0, v.solape || 0));
        const precioRollo = Math.max(0, v.precioRollo || 0);
        const precioPegKg = Math.max(0, v.precioPegKg || 0);

        const conSolape = faldon * (1 + solape / 100);
        const rollos = Math.ceil(conSolape / M.areaPorRollo);
        const cubren = rollos * M.areaPorRollo;
        const kgPeg = Math.round(faldon * M.kgPegPorM2 * 100) / 100;
        const kgPrimer = Math.round(faldon * PRIMER_KG_M2 * 100) / 100;

        const costoRollos = rollos * precioRollo;
        const costoPeg = kgPeg * precioPegKg;
        const costoPrimer = kgPrimer * precioPegKg;
        const costoMateriales = costoRollos + costoPeg + costoPrimer;
        const total = costoMateriales + costoMO;

        const rows = filasPendiente.concat([
          { k: 'Superficie con ' + n(solape) + '% de solape', ref: 'faldón × (1 + solape)', v: conSolape, ...M2 },
          { k: 'Rollos de ' + M.label.toLowerCase(), ref: 'rollo de ' + n(M.areaPorRollo) + ' m², redondeo para arriba', v: rollos, extra: true, ...ROLL },
          { k: 'm² que cubren esos rollos', ref: 'lo que entra en el camión', v: cubren, ...M2 },
          { k: 'Adhesivo asfáltico', ref: n(M.kgPegPorM2, 2) + ' kg por m² de faldón', v: kgPeg, ...KG },
          { k: 'Imprimación asfáltica (primer)', ref: n(PRIMER_KG_M2, 2) + ' kg por m², una mano previa', v: kgPrimer, ...KG },
          { k: 'Costo de los rollos', ref: rollos + ' × ' + money(precioRollo), v: costoRollos, ...ARS },
          { k: 'Costo del adhesivo', ref: n(kgPeg, 1) + ' kg × ' + money(precioPegKg), v: costoPeg, ...ARS },
          { k: 'Costo de la imprimación', ref: n(kgPrimer, 1) + ' kg × ' + money(precioPegKg), v: costoPrimer, ...ARS },
          { k: 'Materiales', ref: 'rollos + adhesivo + imprimación', v: costoMateriales, extra: true, ...ARS },
          { k: 'Mano de obra', ref: manoObra ? money(moM2) + ' por m² de faldón' : 'no incluida', v: costoMO, ...ARS },
          { k: 'Costo total', ref: 'materiales' + (manoObra ? ' + colocación' : ', sin colocación'), v: total, extra: true, ...ARS },
          { k: 'Costo por m² real de techo', ref: 'total ÷ ' + n(faldon, 1) + ' m² de faldón', v: faldon > 0 ? total / faldon : 0, ...ARS },
        ]);

        return {
          total: money(total),
          sub:
            n(faldon, 1) + ' m² reales de faldón (' + n(planta, 1) + ' m² en planta × ' + n(factor, 3) + ') · ' +
            rollos + ' rollos de ' + M.label.toLowerCase() + ' con ' + n(solape) + '% de solape · ' +
            n(kgPeg, 1) + ' kg de adhesivo y ' + n(kgPrimer, 1) + ' kg de imprimación · ' +
            (manoObra ? 'colocación incluida' : 'sin mano de obra'),
          rows: rows,
          chart: [
            { label: 'Rollos de membrana', value: Math.round(costoRollos), tone: 'main' },
            { label: 'Adhesivo asfáltico', value: Math.round(costoPeg), tone: 'prop' },
            { label: 'Imprimación (primer)', value: Math.round(costoPrimer), tone: 'warn' },
            { label: 'Mano de obra', value: Math.round(costoMO), tone: 'exit' },
          ],
        };
      }

      // ── Rama: tejas ─────────────────────────────────────────────────────
      const T = TEJAS[String(v.tipoTeja)] || TEJAS.francesa;
      const desp = Math.min(40, Math.max(0, v.desperdicio || 0));
      const precioTeja = Math.max(0, v.precioTeja || 0);
      const precioCumbrera = Math.max(0, v.precioCumbrera || 0);

      const tejasBase = Math.round(faldon * T.porM2);
      const tejasTotal = Math.ceil(faldon * T.porM2 * (1 + desp / 100));
      const tejasDesp = Math.max(0, tejasTotal - tejasBase);
      const cumbreras = Math.ceil(faldon / CUMBRERA_CADA_M2);
      const listones = Math.ceil(faldon * LISTONES_M_POR_M2);

      const costoNetas = tejasBase * precioTeja;
      const costoDesp = tejasDesp * precioTeja;
      const costoCumbreras = cumbreras * precioCumbrera;
      const costoMatTejas = costoNetas + costoDesp + costoCumbreras;
      const totalTejas = costoMatTejas + costoMO;

      const rowsTejas = filasPendiente.concat([
        { k: 'Piezas por m² de ' + T.label.toLowerCase(), ref: 'según el tipo de teja', v: T.porM2, format: 'plain', decimals: 1 },
        { k: 'Tejas netas', ref: 'faldón × piezas por m²', v: tejasBase, ...PZ },
        { k: 'Tejas extra por desperdicio (' + n(desp) + '%)', ref: 'roturas, cortes y remates', v: tejasDesp, ...PZ },
        { k: 'Tejas a comprar', ref: 'netas + desperdicio, redondeo para arriba', v: tejasTotal, extra: true, ...PZ },
        { k: 'Cumbreras', ref: '1 cada ' + n(CUMBRERA_CADA_M2) + ' m² de faldón', v: cumbreras, ...PZ },
        { k: 'Listones', ref: n(LISTONES_M_POR_M2) + ' metros lineales por m² de faldón', v: listones, ...ML },
        { k: 'Costo de las tejas netas', ref: tejasBase + ' × ' + money(precioTeja), v: costoNetas, ...ARS },
        { k: 'Costo del desperdicio', ref: tejasDesp + ' × ' + money(precioTeja), v: costoDesp, ...ARS },
        { k: 'Costo de las cumbreras', ref: cumbreras + ' × ' + money(precioCumbrera), v: costoCumbreras, ...ARS },
        { k: 'Materiales', ref: 'tejas + cumbreras (sin listones ni estructura)', v: costoMatTejas, extra: true, ...ARS },
        { k: 'Mano de obra', ref: manoObra ? money(moM2) + ' por m² de faldón' : 'no incluida', v: costoMO, ...ARS },
        { k: 'Costo total', ref: 'materiales' + (manoObra ? ' + colocación' : ', sin colocación'), v: totalTejas, extra: true, ...ARS },
        { k: 'Costo por m² real de techo', ref: 'total ÷ ' + n(faldon, 1) + ' m² de faldón', v: faldon > 0 ? totalTejas / faldon : 0, ...ARS },
      ]);

      return {
        total: money(totalTejas),
        sub:
          n(tejasTotal) + ' ' + T.label.toLowerCase() + ' para ' + n(faldon, 1) + ' m² reales de faldón (' +
          n(planta, 1) + ' m² en planta × ' + n(factor, 3) + ') · ' + cumbreras + ' cumbreras y ' +
          n(listones) + ' m de listón · ' + (manoObra ? 'colocación incluida' : 'sin mano de obra'),
        rows: rowsTejas,
        chart: [
          { label: 'Tejas netas', value: Math.round(costoNetas), tone: 'main' },
          { label: 'Desperdicio (' + n(desp) + '%)', value: Math.round(costoDesp), tone: 'warn' },
          { label: 'Cumbreras', value: Math.round(costoCumbreras), tone: 'prop' },
          { label: 'Mano de obra', value: Math.round(costoMO), tone: 'exit' },
        ],
      };
    });
  })();
</script>
