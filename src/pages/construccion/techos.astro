---
/**
 * Hub de decisión — "¿Cuánto material necesito para el techo y cuánto me sale?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: cálculo dominante (sin `cases`). El trabajo se elige en un select.
 * Las constantes NO están acá: se derivan de las fórmulas reales del repo
 * (pendiente-techo, membrana-asfaltica-rollos, impermeabilizacion-techo-...,
 * techos-tejas, impermeabilizante-m2) dentro de src/lib/hubs/techos.ts.
 *
 * Lo que el hub resuelve y ninguna calc suelta hacía: la pendiente deja de ser
 * un cálculo aparte y se convierte en el campo que agranda la superficie con
 * la que después comprás membrana o tejas.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import TechosExperience from '../../components/generated/TechosExperience.astro';
import {
  hub,
  MEMBRANAS,
  TEJAS,
  CLASIF,
  PRIMER_KG_M2,
  CUMBRERA_CADA_M2,
  LISTONES_M_POR_M2,
} from '../../lib/hubs/techos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <TechosExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

