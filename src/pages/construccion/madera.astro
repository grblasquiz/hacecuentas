---
/**
 * Hub de decisión — "¿Cuánta madera necesito para el mueble?"
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * El motor arma un despiece (grupos de piezas iguales) según la rama, y sobre
 * ese despiece calcula: metros cuadrados, plan de corte guillotina con el
 * ancho de sierra, placas por área y por corte real, peso, tornillos,
 * bisagras y la capacidad de carga del estante.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MaderaExperience from '../../components/generated/MaderaExperience.astro';
import { hub, PLACAS, MATERIALES, MOTOR } from '../../lib/hubs/madera';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <MaderaExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ PLACAS, MATERIALES, K: MOTOR }}>
  (function () {
    const H = window.HC_HUB;

    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });

    /**
     * Piezas de medida w × h (cm) que entran en una placa de L × A (cm),
     * probando las dos orientaciones. El ancho de corte se suma a la pieza y
     * también a la placa: n piezas necesitan n·w + (n−1)·k de material.
     */
    function corte(w, h, L, A, k) {
      const fit = (pw, ph) => ({
        cols: Math.floor((L + k) / (pw + k)),
        filas: Math.floor((A + k) / (ph + k)),
      });
      const a = fit(w, h);
      const b = fit(h, w);
      const nA = a.cols * a.filas;
      const nB = b.cols * b.filas;
      if (nB > nA) return { n: nB, cols: b.cols, filas: b.filas, rotada: true };
      return { n: nA, cols: a.cols, filas: a.filas, rotada: false };
    }

    /** Largo comercial de tornillo para unir dos piezas del mismo espesor. */
    function largoTornillo(espesorMm) {
      const calc = espesorMm + K.PENETRACION * espesorMm;
      return K.TORNILLOS_MM.find((t) => t >= calc) || Math.ceil(calc);
    }

    /** Peso máximo de un estante apoyado, con flecha admitida de 3 mm. */
    function cargaEstante(largoCm, profCm, espesorMm, eGPa) {
      const L = largoCm / 100;
      const b = profCm / 100;
      const h = espesorMm / 1000;
      if (!L || !b || !h) return 0;
      const E = eGPa * 1e9;
      const I = (b * Math.pow(h, 3)) / 12;
      const PmaxN = (K.FLECHA_MAX_M * 384 * E * I) / (5 * Math.pow(L, 3));
      return PmaxN / K.G;
    }

    H.onCompute(function (v, caso) {
      const rama = (caso && caso.id) || 'biblioteca';

      const ancho = Math.max(0, Number(v.ancho) || 0);
      const alto = Math.max(0, Number(v.alto) || 0);
      const prof = Math.max(0, Number(v.profundidad) || 0);
      const n = Math.max(0, Math.round(Number(v.estantes) || 0));
      const placa = PLACAS[String(v.placa || '183x260')] || PLACAS['183x260'];
      const mat = MATERIALES[String(v.material || 'melamina')] || MATERIALES['melamina'];
      const espesor = Math.max(1, Number(v.espesor) || 18);
      const kerfCm = Math.max(0, Number(v.sierra) || 0) / 10;

      const vacio = {
        total: '—',
        sub: 'Completá el ancho, el alto y la profundidad para ver el despiece.',
        rows: [],
        chart: [],
        format: 'unit',
        unit: 'placas',
      };
      if (!ancho || !prof) return vacio;

      const areaPlacaM2 = (placa.l * placa.a) / 10000;

      // ── Rama deck: no sale de placas, sale de tablas ───────────────────
      if (rama === 'deck') {
        const superficie = (ancho * prof) / 10000;
        if (!superficie) return vacio;
        const pasoCm = K.DECK_ANCHO_CM + K.DECK_SEPARACION_MM / 10;
        const ml = superficie / (pasoCm / 100);
        const mlConDesp = ml * (1 + K.DECK_DESPERDICIO);
        const tablas = Math.ceil(mlConDesp / K.DECK_LARGO_M);
        const lado = Math.sqrt(superficie);
        const cantListones = Math.ceil(lado / (K.DECK_PASO_LISTONES_CM / 100)) + 1;
        const listonesMl = cantListones * lado * 1.1;
        const tornillosPorM2 = (2 * cantListones) / (K.DECK_LARGO_M / (pasoCm / 100));
        const tirafondos = Math.ceil(tornillosPorM2 * superficie * (1 + K.DECK_DESPERDICIO));
        const volumen = superficie * (espesor / 1000);
        const peso = volumen * mat.d;

        return {
          total: nf(tablas, 0) + (tablas === 1 ? ' tabla' : ' tablas'),
          sub:
            nf(superficie, 2) + ' m² de deck con tablas de ' + nf(K.DECK_ANCHO_CM, 1) + ' cm y ' +
            nf(K.DECK_SEPARACION_MM, 0) + ' mm de separación: ' + nf(mlConDesp, 1) + ' metros lineales con el 10% de desperdicio, ' +
            nf(tablas, 0) + (tablas === 1 ? ' tabla de ' : ' tablas de ') + nf(K.DECK_LARGO_M, 1) + ' m · ' + nf(listonesMl, 1) +
            ' metros lineales de listón de apoyo cada 50 cm · ' + nf(tirafondos, 0) + ' tirafondos. El alto no se usa en esta rama.',
          rows: [
            { k: 'Superficie del deck', ref: nf(ancho, 0) + ' × ' + nf(prof, 0) + ' cm', v: Number(superficie.toFixed(2)), format: 'unit', unit: 'm²', decimals: 2 },
            { k: 'Metros lineales de tabla', ref: 'paso de ' + nf(pasoCm, 1) + ' cm', v: Number(ml.toFixed(1)), format: 'unit', unit: 'ml', decimals: 1 },
            { k: 'Con 10% de desperdicio', v: Number(mlConDesp.toFixed(1)), format: 'unit', unit: 'ml', decimals: 1 },
            { k: 'Tablas a comprar', ref: 'largo comercial ' + nf(K.DECK_LARGO_M, 1) + ' m', v: tablas, extra: true, format: 'unit', unit: 'tablas' },
            { k: 'Listones de apoyo', ref: 'cada 50 cm', v: Number(listonesMl.toFixed(1)), format: 'unit', unit: 'ml', decimals: 1 },
            { k: 'Tirafondos', ref: '2 por punto de apoyo', v: tirafondos, format: 'unit', unit: 'tornillos' },
            { k: 'Largo de tirafondo', ref: 'para ' + nf(espesor, 0) + ' mm de tabla', v: largoTornillo(espesor), format: 'unit', unit: 'mm' },
            { k: 'Peso de la madera', ref: mat.label + ', ' + nf(mat.d, 0) + ' kg/m³', v: Number(peso.toFixed(1)), format: 'unit', unit: 'kg', decimals: 1 },
            { k: 'Volumen en pies tabla', ref: '1 pie tabla = 0,00236 m³', v: Math.round(volumen / K.PIE_TABLA_M3), format: 'unit', unit: 'pies tabla' },
          ],
          chart: [
            { label: 'Tablas de piso', value: Number(superficie.toFixed(2)), tone: 'main' },
            { label: 'Desperdicio de corte', value: Number((superficie * K.DECK_DESPERDICIO).toFixed(2)), tone: 'warn' },
          ],
          format: 'unit',
          unit: 'tablas',
          decimals: 0,
        };
      }

      // ── Despiece por rama ──────────────────────────────────────────────
      // Cada grupo: nombre, medidas de corte en cm, cantidad.
      let grupos = [];
      if (rama === 'corte') {
        grupos = [{ k: 'Piezas de ' + nf(ancho, 0) + ' × ' + nf(prof, 0) + ' cm', w: ancho, h: prof, n: Math.max(1, n) }];
      } else if (rama === 'escritorio') {
        grupos = [
          { k: 'Tapa', w: ancho, h: prof, n: 1 },
          { k: 'Laterales de apoyo', w: alto, h: prof, n: 2 },
        ];
      } else if (rama === 'cajonera') {
        const frente = n > 0 ? alto / n : alto;
        grupos = [
          { k: 'Laterales', w: alto, h: prof, n: 2 },
          { k: 'Techo y base', w: ancho, h: prof, n: 2 },
          { k: 'Fondo', w: ancho, h: alto, n: 1 },
          { k: 'Frentes de cajón', w: ancho, h: Number(frente.toFixed(1)), n: Math.max(1, n) },
        ];
      } else {
        // biblioteca y placard comparten el cuerpo
        grupos = [
          { k: 'Laterales', w: alto, h: prof, n: 2 },
          { k: 'Estantes', w: ancho, h: prof, n: n },
          { k: 'Techo y base', w: ancho, h: prof, n: 2 },
          { k: 'Fondo', w: ancho, h: alto, n: 1 },
        ];
        if (rama === 'placard') {
          grupos.push({ k: 'Puertas', w: Number((ancho / 2).toFixed(1)), h: alto, n: 2 });
        }
      }
      grupos = grupos.filter((g) => g.n > 0 && g.w > 0 && g.h > 0);
      if (!grupos.length) return vacio;

      // ── Metros cuadrados y plan de corte ───────────────────────────────
      let m2 = 0;
      let placasCorte = 0;
      let noEntra = false;
      const detalle = [];
      for (const g of grupos) {
        m2 += (g.n * g.w * g.h) / 10000;
        const c = corte(g.w, g.h, placa.l, placa.a, kerfCm);
        if (c.n <= 0) {
          noEntra = true;
          detalle.push({ g: g, c: c, placas: 0 });
          continue;
        }
        const p = Math.ceil(g.n / c.n);
        placasCorte += p;
        detalle.push({ g: g, c: c, placas: p });
      }

      const m2Desp = m2 * (1 + K.DESPERDICIO);
      const placasArea = Math.ceil(m2Desp / areaPlacaM2);
      // La seccionadora del corralón mezcla piezas de distinto grupo en la
      // misma placa, así que la cuenta por área con desperdicio es la compra
      // realista. `placasCorte` es el peor caso: una placa por grupo, sin
      // mezclar, y sirve como techo del presupuesto.
      const placas = noEntra ? 0 : placasArea;
      const aprovechamiento = placas > 0 ? (m2 / (placas * areaPlacaM2)) * 100 : 0;
      const desperdicioM2 = placas > 0 ? placas * areaPlacaM2 - m2 : 0;

      const volumen = m2 * (espesor / 1000);
      const peso = volumen * mat.d;

      const rows = [];
      for (const d of detalle) {
        rows.push({
          k: d.g.k + ' — ' + nf(d.g.w, 0) + ' × ' + nf(d.g.h, 0) + ' cm',
          ref:
            d.c.n > 0
              ? d.c.n + ' por placa (' + d.c.cols + ' × ' + d.c.filas + ')' + (d.c.rotada ? ', rotadas' : '')
              : 'no entra en la placa elegida',
          v: d.g.n,
          format: 'plain',
        });
      }
      rows.push({ k: 'Madera neta', ref: 'suma del despiece', v: Number(m2.toFixed(2)), extra: true, format: 'unit', unit: 'm²', decimals: 2 });
      rows.push({ k: 'Con 15% de desperdicio', ref: 'la regla de bolsillo del rubro', v: Number(m2Desp.toFixed(2)), format: 'unit', unit: 'm²', decimals: 2 });
      rows.push({ k: 'Placas a comprar', ref: placa.label + ' · ' + nf(areaPlacaM2, 2) + ' m² cada una', v: placas, extra: true, format: 'unit', unit: 'placas' });
      rows.push({ k: 'Peor caso, sin mezclar piezas', ref: 'una placa por tipo de pieza: el techo del presupuesto', v: placasCorte, format: 'unit', unit: 'placas' });
      rows.push({ k: 'Aprovechamiento real', v: Number(aprovechamiento.toFixed(1)), format: 'unit', unit: '%', decimals: 1 });
      rows.push({ k: 'Desperdicio real', v: Number(desperdicioM2.toFixed(2)), format: 'unit', unit: 'm²', decimals: 2 });
      rows.push({ k: 'Peso de la madera', ref: mat.label + ', ' + nf(mat.d, 0) + ' kg/m³', v: Number(peso.toFixed(1)), format: 'unit', unit: 'kg', decimals: 1 });
      rows.push({ k: 'Volumen en pies tabla', ref: '1 pie tabla = 0,00236 m³', v: Math.round(volumen / K.PIE_TABLA_M3), format: 'unit', unit: 'pies tabla' });

      // ── Herrajes ───────────────────────────────────────────────────────
      const largo = largoTornillo(espesor);
      const diam = espesor >= 25 ? 5 : espesor <= 12 ? 3.5 : 4;
      let tornillos = 0;
      if (rama !== 'corte') {
        // 2 tornillos por cada extremo de estante, techo y base contra los laterales.
        const horizontales = grupos
          .filter((g) => g.k === 'Estantes' || g.k === 'Techo y base')
          .reduce((a, g) => a + g.n, 0);
        // Fondo: un tornillo cada 20 cm de perímetro.
        const tieneFondo = grupos.some((g) => g.k === 'Fondo');
        const perimetro = tieneFondo ? 2 * (ancho + alto) : 0;
        tornillos = Math.ceil((horizontales * 4 + perimetro / 20) * (1 + K.MARGEN_TORNILLOS));
        rows.push({ k: 'Tornillos de armado', ref: 'con 10% de margen', v: tornillos, format: 'unit', unit: 'tornillos' });
        rows.push({ k: 'Medida del tornillo', ref: diam + ' mm de diámetro · pretaladrar con mecha de ' + (diam - 1) + ' mm', v: largo, format: 'unit', unit: 'mm' });
      }

      let bisagras = 0;
      if (rama === 'placard') {
        const gp = grupos.find((g) => g.k === 'Puertas');
        const pesoHoja = ((gp.w * gp.h) / 10000) * (espesor / 1000) * mat.d;
        const porAlto = Math.ceil(alto / 100 / K.ALTO_POR_BISAGRA_M);
        const porPeso = (K.BISAGRAS_POR_PESO.find((b) => pesoHoja <= b.hasta) || { n: 5 }).n;
        const porPuerta = Math.max(porAlto, porPeso);
        bisagras = porPuerta * 2;
        const tornillosBis = Math.ceil(bisagras * K.TORNILLOS_POR_BISAGRA * (1 + K.MARGEN_TORNILLOS));
        rows.push({ k: 'Peso de cada puerta', v: Number(pesoHoja.toFixed(1)), format: 'unit', unit: 'kg', decimals: 1 });
        rows.push({ k: 'Bisagras por puerta', ref: 'alto pide ' + porAlto + ', peso pide ' + porPeso, v: porPuerta, format: 'plain' });
        rows.push({ k: 'Bisagras en total', ref: '2 puertas', v: bisagras, format: 'plain' });
        rows.push({ k: 'Tornillos de bisagra', ref: '4 por bisagra, con margen', v: tornillosBis, format: 'unit', unit: 'tornillos' });
      }

      // ── Capacidad del estante o de la tapa ─────────────────────────────
      const luz = rama === 'escritorio' ? ancho : ancho;
      const carga = cargaEstante(luz, prof, espesor, mat.e);
      const cargaSegura = carga * 0.6;
      if (rama !== 'corte' && rama !== 'placard') {
        rows.push({
          k: rama === 'escritorio' ? 'Carga máxima de la tapa' : 'Carga máxima por estante',
          ref: 'flecha de 3 mm en ' + nf(luz, 0) + ' cm de luz',
          v: Number(carga.toFixed(1)),
          format: 'unit',
          unit: 'kg',
          decimals: 1,
        });
        rows.push({ k: 'Carga segura recomendada', ref: '60% del máximo', v: Number(cargaSegura.toFixed(1)), format: 'unit', unit: 'kg', decimals: 1 });
      }

      // ── Gráfico: composición de los m² netos por grupo ─────────────────
      const tonos = ['main', 'exit', 'prop', 'good', 'warn'];
      const chart = grupos.map((g, idx) => ({
        label: g.k,
        value: Number(((g.n * g.w * g.h) / 10000).toFixed(3)),
        tone: tonos[idx % tonos.length],
      }));

      // ── Línea de contexto ──────────────────────────────────────────────
      if (noEntra) {
        return {
          total: '—',
          sub:
            'Alguna pieza del despiece no entra en una placa de ' + placa.label +
            ' ni siquiera rotada. Probá un formato de placa más grande o achicá la pieza.',
          rows: rows,
          chart: chart,
          format: 'unit',
          unit: 'placas',
        };
      }

      const brecha = placasCorte - placasArea;
      const sub =
        nf(m2, 2) + ' m² netos de ' + mat.label + ' de ' + nf(espesor, 0) + ' mm, ' +
        nf(m2Desp, 2) + ' m² con el 15% de desperdicio · ' +
        nf(placas, 0) + (placas === 1 ? ' placa' : ' placas') + ' de ' + placa.label + ', con ' +
        nf(aprovechamiento, 0) + '% de aprovechamiento real y ' + nf(desperdicioM2, 2) + ' m² que se tiran' +
        (brecha > 0
          ? ' · si el corralón no mezcla piezas distintas en la misma placa te va a pedir ' + nf(placasCorte, 0) +
            ', o sea ' + nf(brecha, 0) + (brecha === 1 ? ' placa más' : ' placas más') + ': pedí el despiece nesteado'
          : ' · el plan de corte por pieza coincide con la cuenta por área') +
        ' · pesa ' + nf(peso, 0) + ' kg · tornillos de ' + nf(largo, 0) + ' × ' + nf(diam, 1) + ' mm' +
        (rama !== 'corte' && rama !== 'placard'
          ? ' · cada estante de ' + nf(luz, 0) + ' cm aguanta ' + nf(cargaSegura, 0) + ' kg repartidos con margen'
          : '') +
        (bisagras ? ' · ' + nf(bisagras, 0) + ' bisagras' : '') + '.';

      return {
        total: nf(placas, 0) + (placas === 1 ? ' placa' : ' placas'),
        sub: sub,
        rows: rows,
        chart: chart,
        format: 'unit',
        unit: 'placas',
        decimals: 0,
      };
    });
  })();
</script>
