---
/**
 * Hub de decisión — "¿Cuánta madera necesito para el mueble?"
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * El motor arma un despiece (grupos de piezas iguales) según la rama, y sobre
 * ese despiece calcula: metros cuadrados, plan de corte guillotina con el
 * ancho de sierra, placas por área y por corte real, peso, tornillos,
 * bisagras y la capacidad de carga del estante.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MaderaExperience from '../../components/generated/MaderaExperience.astro';
import { hub, PLACAS, MATERIALES, MOTOR } from '../../lib/hubs/madera';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <MaderaExperience data={hub} />
  <Footer />
</Layout>

