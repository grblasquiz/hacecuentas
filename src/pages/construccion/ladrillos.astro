---
/**
 * Hub de decisión — "¿Cuántos ladrillos necesito?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (4 ramas, `cases`).
 * Los rendimientos NO están acá: se derivan de las fórmulas reales del repo
 * (ladrillos-m2, bloques-m2, adoquines-m2, alambre-cerco, cerramiento-perímetro,
 * costo-medianera) dentro de src/lib/hubs/ladrillos.ts.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  PIEZAS,
  PIEZA_POR_RAMA,
  CERCO,
  KG_POR_BOLSA,
  LITROS_POR_BALDE,
  JUNTA_BASE_CM,
  CIMIENTO_M3_POR_METRO,
  METROS_ENTRE_PILARES,
  COSTO_M2_MURO,
} from '../../lib/hubs/ladrillos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    PIEZAS,
    PIEZA_POR_RAMA,
    CERCO,
    KG_POR_BOLSA,
    LITROS_POR_BALDE,
    JUNTA_BASE_CM,
    CIMIENTO_M3_POR_METRO,
    METROS_ENTRE_PILARES,
    COSTO_M2_MURO,
  }}
>
  (function () {
    const H = window.HC_HUB;

    // El desglose mezcla piezas, kg, m³ y bolsas: NINGUNA fila puede quedar sin
    // `format`, porque el runtime hace Object.assign y la que no lo declara cae
    // a pesos. Las de plata declaran 'ars' igual, para que se lea explícito.
    const U = (v, unit, decimals) => ({ v: v, format: 'unit', unit: unit, decimals: decimals || 0 });

    const n = (x, d) =>
      Number(x || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });
    /** Rendimiento por m²: 63 se escribe entero, 12,5 con coma (nunca 12.5). */
    const rend = (x) => Number(x || 0).toLocaleString('es-AR', { maximumFractionDigits: 1 });

    /** Pieza elegida, corregida si no pertenece a la familia de la rama. */
    function piezaDe(rama, elegida) {
      const p = PIEZAS[elegida] || PIEZAS.comun;
      const familiaEsperada = rama === 'bloques' ? 'bloque' : rama === 'adoquines' ? 'adoquin' : 'pared';
      if (p.familia === familiaEsperada) return { id: elegida, ...p };
      const fallback = PIEZA_POR_RAMA[rama] || 'comun';
      return { id: fallback, ...PIEZAS[fallback] };
    }

    H.onCompute(function (v, kase) {
      const rama = (kase && kase.id) || 'pared';
      const largo = Math.max(0, v.largo || 0);
      const altura = Math.max(0, v.altura || 0);
      const vanos = Math.max(0, v.vanos || 0);
      const desp = Math.min(30, Math.max(0, v.desperdicio || 0));
      const junta = Math.min(3, Math.max(0.5, v.junta || JUNTA_BASE_CM));

      // ── Cerco perimetral de alambre ──────────────────────────────────────
      if (rama === 'cerco') {
        const hilos = Math.min(15, Math.max(1, v.hilos || 1));
        const perimetro = largo;
        const metros = perimetro * hilos * CERCO.metrosPorHilo;
        const postes = Math.ceil(perimetro / CERCO.separacionPostes);
        const rollos = Math.ceil(metros / CERCO.metrosPorRollo);
        const sobrante = Math.max(0, rollos * CERCO.metrosPorRollo - metros);

        return {
          total: n(metros) + ' m de alambre',
          sub:
            n(perimetro, 1) + ' m de perímetro × ' + hilos + ' hilos · ' +
            rollos + ' rollo' + (rollos === 1 ? '' : 's') + ' de ' + n(CERCO.metrosPorRollo) + ' m · ' +
            postes + ' postes cada ' + n(CERCO.separacionPostes, 1) + ' m',
          format: 'plain',
          rows: [
            { k: 'Perímetro a cercar', ref: 'dato tuyo', ...U(perimetro, 'm', 1) },
            { k: 'Hilos de alambre', ref: 'alambrado de campo', ...U(hilos, 'hilos') },
            { k: 'Alambre necesario', ref: 'perímetro × hilos', ...U(metros, 'm'), extra: true },
            { k: 'Rollos a comprar', ref: 'rollo de ' + n(CERCO.metrosPorRollo) + ' m', ...U(rollos, 'rollos'), extra: true },
            { k: 'Alambre que te sobra del último rollo', ref: 'redondeo', ...U(sobrante, 'm') },
            { k: 'Postes intermedios', ref: 'cada ' + n(CERCO.separacionPostes, 1) + ' m', ...U(postes, 'postes'), extra: true },
            { k: 'Esquineros reforzados con riostra', ref: 'uno por vértice', ...U(4, 'postes') },
          ],
          chart: [
            { label: 'Alambre (m)', value: metros, tone: 'main' },
            { label: 'Postes (unidades)', value: postes, tone: 'exit' },
          ],
        };
      }

      const P = piezaDe(rama, v.pieza);
      const area = Math.max(0, largo * altura - vanos);
      const piezasNetas = Math.ceil(area * P.porM2);
      const piezas = Math.ceil(area * P.porM2 * (1 + desp / 100));
      const extraDesp = Math.max(0, piezas - piezasNetas);

      // ── Piso de adoquines ────────────────────────────────────────────────
      if (rama === 'adoquines') {
        const arenaM3 = area * P.mortero.arenaM3;
        const baldes = Math.ceil((arenaM3 * 1000) / LITROS_POR_BALDE);

        return {
          total: n(piezas) + ' ' + P.unidad,
          sub:
            n(area, 1) + ' m² de piso · ' + rend(P.porM2) + ' ' + P.unidad + '/m² · ' +
            'cama de arena de 4 cm (' + n(arenaM3, 2) + ' m³)',
          format: 'plain',
          rows: [
            { k: 'Superficie a adoquinar', ref: 'largo × ancho', ...U(area, 'm²', 1) },
            { k: 'Adoquines netos', ref: rend(P.porM2) + ' por m²', ...U(piezasNetas, P.unidad) },
            { k: 'Extra por cortes y rotura (' + desp + '%)', ref: 'desperdicio', ...U(extraDesp, P.unidad) },
            { k: 'Adoquines a comprar', ref: P.label, ...U(piezas, P.unidad), extra: true },
            { k: 'Arena para la cama de asiento', ref: '4 cm de espesor', ...U(arenaM3, 'm³', 2) },
            { k: 'Baldes de arena', ref: 'balde de ' + LITROS_POR_BALDE + ' L', ...U(baldes, 'baldes'), extra: true },
            { k: 'Cordón de contención perimetral', ref: 'sin él el piso se abre', ...U(2 * (largo + altura), 'm', 1) },
          ],
          chart: [
            { label: 'Adoquines (unidades)', value: piezas, tone: 'main' },
            { label: 'Arena (baldes de ' + LITROS_POR_BALDE + ' L)', value: baldes, tone: 'prop' },
          ],
        };
      }

      // ── Pared de ladrillo común o de bloques de hormigón ─────────────────
      const factorJunta = junta / JUNTA_BASE_CM;
      const cementoKg = area * P.mortero.cementoKg * factorJunta;
      const calKg = area * P.mortero.calKg * factorJunta;
      const arenaM3 = area * P.mortero.arenaM3 * factorJunta;
      const bolsasCemento = Math.ceil(cementoKg / KG_POR_BOLSA);
      const bolsasCal = Math.ceil(calKg / KG_POR_BOLSA);
      const baldesArena = Math.ceil((arenaM3 * 1000) / LITROS_POR_BALDE);
      const cimientoM3 = largo * CIMIENTO_M3_POR_METRO;
      const pilares = Math.ceil(largo / METROS_ENTRE_PILARES);
      const costoRef = area * (COSTO_M2_MURO[P.muro] || COSTO_M2_MURO.comun);

      return {
        total: n(piezas) + ' ' + P.unidad,
        sub:
          n(area, 1) + ' m² de pared · ' + rend(P.porM2) + ' ' + P.unidad + '/m² + ' + desp + '% de rotura · ' +
          bolsasCemento + ' bolsas de cemento y ' + bolsasCal + ' de cal',
        format: 'plain',
        rows: [
          { k: 'Superficie de pared (cara vista)', ref: 'largo × alto − vanos', ...U(area, 'm²', 1) },
          { k: 'Piezas netas', ref: rend(P.porM2) + ' por m²', ...U(piezasNetas, P.unidad) },
          { k: 'Extra por rotura y cortes (' + desp + '%)', ref: 'desperdicio', ...U(extraDesp, P.unidad) },
          { k: 'Piezas a comprar', ref: P.label, ...U(piezas, P.unidad), extra: true },
          { k: 'Cemento del mortero', ref: 'mezcla 1:1:6', ...U(cementoKg, 'kg') },
          { k: 'Bolsas de cemento', ref: 'bolsa de ' + KG_POR_BOLSA + ' kg', ...U(bolsasCemento, 'bolsas'), extra: true },
          { k: 'Cal hidráulica del mortero', ref: 'mezcla 1:1:6', ...U(calKg, 'kg') },
          { k: 'Bolsas de cal', ref: 'bolsa de ' + KG_POR_BOLSA + ' kg', ...U(bolsasCal, 'bolsas'), extra: true },
          { k: 'Arena gruesa', ref: 'junta de ' + n(junta, 1) + ' cm', ...U(arenaM3, 'm³', 2) },
          { k: 'Baldes de arena', ref: 'balde de ' + LITROS_POR_BALDE + ' L', ...U(baldesArena, 'baldes') },
          { k: 'Hormigón de la zapata corrida', ref: 'zapata 30×30 · CIRSOC', ...U(cimientoM3, 'm³', 2) },
          { k: 'Pilares de refuerzo', ref: 'cada ' + METROS_ENTRE_PILARES + ' m', ...U(pilares, 'pilares') },
          {
            k: 'Referencia: muro terminado con revoque y mano de obra',
            ref: 'costo de medianera',
            v: costoRef,
            format: 'ars',
          },
        ],
        chart: [
          { label: P.unidad.charAt(0).toUpperCase() + P.unidad.slice(1) + ' (unidades)', value: piezas, tone: 'main' },
          { label: 'Cemento (bolsas de ' + KG_POR_BOLSA + ' kg)', value: bolsasCemento, tone: 'exit' },
          { label: 'Cal (bolsas de ' + KG_POR_BOLSA + ' kg)', value: bolsasCal, tone: 'warn' },
          { label: 'Arena (baldes de ' + LITROS_POR_BALDE + ' L)', value: baldesArena, tone: 'prop' },
        ],
      };
    });
  })();
</script>
