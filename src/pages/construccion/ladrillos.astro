---
/**
 * Hub de decisión — "¿Cuántos ladrillos necesito?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (4 ramas, `cases`).
 * Los rendimientos NO están acá: se derivan de las fórmulas reales del repo
 * (ladrillos-m2, bloques-m2, adoquines-m2, alambre-cerco, cerramiento-perímetro,
 * costo-medianera) dentro de src/lib/hubs/ladrillos.ts.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import LadrillosExperience from '../../components/generated/LadrillosExperience.astro';
import {
  hub,
  PIEZAS,
  PIEZA_POR_RAMA,
  CERCO,
  KG_POR_BOLSA,
  LITROS_POR_BALDE,
  JUNTA_BASE_CM,
  CIMIENTO_M3_POR_METRO,
  METROS_ENTRE_PILARES,
  COSTO_M2_MURO,
} from '../../lib/hubs/ladrillos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <LadrillosExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

