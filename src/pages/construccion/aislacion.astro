---
/**
 * Hub de decisión — "¿Cómo aíslo la casa del frío y el calor?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/aislacion.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  CASE_MATH,
  R_REQUERIDO,
  LAMBDA,
  PRECIO_POR_CM,
  NOMBRES_MATERIAL,
  RENOVACIONES,
  CIELORRASO,
  FACTOR_LUZ,
} from '../../lib/hubs/aislacion';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ MATH: CASE_MATH, RREQ: R_REQUERIDO, LAM: LAMBDA, PRECIO: PRECIO_POR_CM, NOMBRES: NOMBRES_MATERIAL, RENOV: RENOVACIONES, CIELO: CIELORRASO, FACTOR: FACTOR_LUZ }}
>
  (function () {
    const H = window.HC_HUB;

    const dec = (n, d) => Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    /**
     * Espesor y tipo de vidrio por superficie del paño.
     * Espejo de `src/lib/formulas/espesor-vidrio.ts` para el caso base:
     * planta baja o piso bajo (pb-3) y ubicación interior, sin recargo por
     * altura, costa ni viento. Ese recargo se avisa en el texto del caso.
     */
    function vidrio(m2) {
      if (m2 <= 0.5) return { esp: 3, tipo: 'Float' };
      if (m2 <= 1) return { esp: 4, tipo: 'Float' };
      if (m2 <= 2) return { esp: 5, tipo: 'Float' };
      if (m2 <= 3) return { esp: 6, tipo: 'Templado' };
      if (m2 <= 5) return { esp: 8, tipo: 'Templado' };
      return { esp: 10, tipo: 'Templado' };
    }

    H.onCompute(function (v, kase) {
      const modo = (MATH[kase && kase.id] || MATH.muro).modo;

      // ---------------- Ventanas y ventilación ---------------------------
      if (modo === 'aberturas') {
        const largo = Math.max(0, Number(v.largo) || 0);
        const ancho = Math.max(0, Number(v.ancho) || 0);
        const alto = Math.max(0, Number(v.alto) || 0);
        const aV = Math.max(0, Number(v.anchoVentana) || 0);
        const hV = Math.max(0, Number(v.altoVentana) || 0);

        const supPiso = largo * ancho;
        const supVidriadaMin = supPiso * FACTOR;
        const supVentilacionMin = supVidriadaMin / 2;
        const m2Ventana = aV * hV;
        const ventanas = m2Ventana > 0 ? Math.ceil(supVidriadaMin / m2Ventana) : 0;
        const supReal = ventanas * m2Ventana;

        const vid = vidrio(m2Ventana);
        const peso = m2Ventana * vid.esp * 2.5;

        // Perfilería de una corrediza de 2 hojas, 10% de desperdicio, barras de 6 m.
        const pMarco = 2 * (aV + hV);
        const anchoHoja = aV / 2 + 0.03;
        const pHojas = 2 * (2 * (anchoHoja + hV));
        const mlNeto = pMarco + pHojas;
        const mlPorVentana = mlNeto * 1.1;
        const barras = Math.ceil((mlPorVentana * ventanas) / 6);

        const amb = RENOV[v.ambiente] !== undefined ? v.ambiente : 'dormitorio';
        const renov = RENOV[amb];
        const volumen = supPiso * alto;
        const m3h = Math.round(volumen * renov);

        const pct = supPiso > 0 ? (supReal / supPiso) * 100 : 0;
        const TOP = 35;
        const MIN_PCT = FACTOR * 100;

        let lectura;
        if (pct < MIN_PCT) lectura = 'por debajo del mínimo de iluminación natural';
        else if (pct <= 20) lectura = 'en regla y sin exceso de vidrio';
        else lectura = 'muy vidriado: cuidá la pérdida térmica';

        return {
          total: ventanas + (ventanas === 1 ? ' ventana' : ' ventanas'),
          sub:
            'Ambiente de ' + dec(supPiso, 2) + ' m² · ' + dec(supVidriadaMin, 2) + ' m² vidriados mínimos · ' +
            'vidrio ' + vid.tipo.toLowerCase() + ' de ' + vid.esp + ' mm · extractor de ' + m3h.toLocaleString('es-AR') + ' m³/h',
          rows: [
            { k: 'Superficie de piso del ambiente', v: supPiso, format: 'unit', unit: 'm²', decimals: 2 },
            { k: 'Superficie vidriada mínima', ref: 'un octavo del piso', v: supVidriadaMin, format: 'unit', unit: 'm²', decimals: 2 },
            { k: 'Superficie vidriada con ' + ventanas + ' ventana(s)', v: supReal, format: 'unit', unit: 'm²', decimals: 2, extra: true },
            { k: 'Superficie que tiene que poder abrirse', ref: 'mitad de la vidriada', v: supVentilacionMin, format: 'unit', unit: 'm²', decimals: 2 },
            { k: 'Espesor de vidrio recomendado (' + vid.tipo + ')', v: vid.esp, format: 'unit', unit: 'mm' },
            { k: 'Peso de cada paño', v: peso, format: 'unit', unit: 'kg', decimals: 1 },
            { k: 'Perfil de aluminio por ventana', ref: 'corrediza 2 hojas, 10% desperdicio', v: mlPorVentana, format: 'unit', unit: 'm', decimals: 2 },
            { k: 'Barras de perfil de 6 m a comprar', v: barras, format: 'plain' },
            { k: 'Caudal del extractor', ref: renov + ' renovaciones/h', v: m3h, format: 'plain' },
          ],
          format: 'unit',
          unit: 'm²',
          decimals: 2,
          chart: [
            { label: 'Por debajo del mínimo', value: MIN_PCT, tone: 'bad', from: 0, to: MIN_PCT },
            { label: 'En regla', value: 20 - MIN_PCT, tone: 'good', from: MIN_PCT, to: 20 },
            { label: 'Sobrevidriado', value: TOP - 20, tone: 'warn', from: 20, to: TOP },
          ],
          position: Math.min(100, Math.max(0, (pct / TOP) * 100)),
          positionLabel: dec(pct, 1) + '% de superficie vidriada — ' + lectura,
        };
      }

      // ---------------- Muro y techo: espesor de aislante -----------------
      const zona = RREQ[v.zona] ? v.zona : 'III';
      const nivel = v.nivel === 'C' ? 'C' : 'B';
      const material = LAM[v.material] !== undefined ? v.material : 'eps';
      const superficie = Math.max(0, Number(v.superficie) || 0);

      const rReq = RREQ[zona][nivel];
      const rC = RREQ[zona].C;
      const rB = RREQ[zona].B;
      const lambda = LAM[material];

      // e (m) = R × λ, redondeado hacia arriba a la décima de centímetro.
      const espesorCm = Math.ceil(rReq * lambda * 100 * 10) / 10;
      const rValor = Number((espesorCm / 100 / lambda).toFixed(3));
      const kMax = 1 / rReq;

      const costoM2 = PRECIO[material] * espesorCm;
      const costoTotal = costoM2 * superficie;

      const rows = [
        { k: 'Resistencia térmica exigida', ref: 'IRAM 11605 · zona ' + zona + ' nivel ' + nivel, v: rReq, format: 'unit', unit: 'm²·K/W', decimals: 2 },
        { k: 'Transmitancia máxima equivalente (K)', ref: '1 / R', v: kMax, format: 'unit', unit: 'W/m²K', decimals: 2 },
        { k: 'Conductividad del material (λ)', ref: NOMBRES[material], v: lambda, format: 'unit', unit: 'W/m·K', decimals: 3 },
        { k: 'Espesor de aislante necesario', ref: 'e = R × λ', v: espesorCm, format: 'unit', unit: 'cm', decimals: 1, extra: true },
        { k: 'Resistencia térmica que alcanzás', v: rValor, format: 'unit', unit: 'm²·K/W', decimals: 2 },
      ];

      if (modo === 'techo') {
        const supConDesp = superficie * (1 + CIELO.desperdicio / 100);
        rows.push({ k: 'Placas de yeso de 1,20 × 2,40 m', ref: CIELO.desperdicio + '% de desperdicio', v: Math.ceil(supConDesp / CIELO.m2PorPlaca), format: 'plain' });
        rows.push({ k: 'Perfiles de la estructura', v: superficie * CIELO.perfilesMlPorM2, format: 'unit', unit: 'm', decimals: 1 });
        rows.push({ k: 'Tornillos', ref: CIELO.tornillosPorM2 + ' por m² de cielorraso', v: Math.ceil(superficie * CIELO.tornillosPorM2), format: 'plain' });
        rows.push({ k: 'Masilla para juntas', v: superficie * CIELO.masillaKgPorM2, format: 'unit', unit: 'kg', decimals: 1 });
        rows.push({ k: 'Cinta para juntas', v: superficie * CIELO.cintaMlPorM2, format: 'unit', unit: 'm', decimals: 1 });
      }

      rows.push({ k: 'Costo del aislante por m²', ref: 'sólo material', v: costoM2, format: 'ars' });
      rows.push({ k: 'Costo del aislante para ' + dec(superficie, 0) + ' m²', v: costoTotal, format: 'ars', extra: true });

      const TOP = rB * 1.6;
      const cumple = rValor >= rB ? 'cumple el nivel B recomendado' : rValor >= rC ? 'cumple el nivel C mínimo' : 'no llega al mínimo';

      return {
        total: dec(espesorCm, 1) + ' cm',
        sub:
          'Zona ' + zona + ' nivel ' + nivel + ' · ' + NOMBRES[material] + ' · R ' + dec(rValor, 2) +
          ' m²·K/W (exige ' + dec(rReq, 2) + ') · material ' + H.ars(costoTotal) +
          (modo === 'techo' ? ' · más las placas del cielorraso' : ''),
        rows: rows,
        format: 'unit',
        unit: 'cm',
        decimals: 1,
        chart: [
          { label: 'No cumple', value: rC, tone: 'bad', from: 0, to: rC },
          { label: 'Nivel C (mínimo)', value: rB - rC, tone: 'warn', from: rC, to: rB },
          { label: 'Nivel B (recomendado)', value: TOP - rB, tone: 'good', from: rB, to: TOP },
        ],
        position: Math.min(100, Math.max(0, (rValor / TOP) * 100)),
        positionLabel: 'R ' + dec(rValor, 2) + ' m²·K/W — ' + cumple,
      };
    });
  })();
</script>
