---
/**
 * Hub de decisión — "¿Cuántas cajas de cerámicos necesito?"
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (5 ramas, `cases`): cerámico/porcelanato, piso
 * flotante, venecitas, machimbre y porcelanato líquido.
 *
 * Los rendimientos NO están acá: se derivan de las fórmulas reales del repo
 * dentro de src/lib/hubs/ceramicos.ts.
 *
 * Lo que el hub resuelve y ninguna calc suelta hacía: el titular es la CAJA
 * ENTERA a pedir, con el sobrante a la vista, y el pegamento, la pastina y el
 * zócalo salen en la misma lista en vez de en tres calculadoras distintas.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  FORMATOS,
  M2_POR_CAJA,
  MEDIDAS_MM,
  DESPERDICIO_CERAMICO,
  DESPERDICIO_FLOTANTE,
  M2_CAJA_FLOTANTE,
  MERMA_ZOCALO,
  VARILLA_ZOCALO_M,
  PEGAMENTO_KG_M2,
  BOLSA_PEGAMENTO_KG,
  DESPERDICIO_PEGAMENTO_PCT,
  DESPERDICIO_PASTINA_PCT,
  M2_POR_PLANCHA,
  PASTINA_VENECITA_KG_M2,
  ADHESIVO_VENECITA_KG_M2,
  TABLA_MACHIMBRE_M,
  RESINA_L_M2_MM,
  PRIMER_L_M2,
  SELLADOR_L_M2,
  DESPERDICIO_EPOXI_PCT,
} from '../../lib/hubs/ceramicos';

/** Densidad de la pastina cementicia, la misma que usa la fórmula del repo. */
const PASTINA_DENSIDAD = 1.7;
/** Ancho estándar de una puerta, para descontarla del perímetro del zócalo. */
const ANCHO_PUERTA_M = 0.8;

/** Formato → familia de consumo de pegamento. */
const PEGAMENTO_POR_FORMATO: Record<string, string> = Object.fromEntries(
  FORMATOS.map((f) => [f.id, f.pegamento])
);

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    M2_POR_CAJA,
    MEDIDAS_MM,
    PEGAMENTO_POR_FORMATO,
    DESPERDICIO_CERAMICO,
    DESPERDICIO_FLOTANTE,
    M2_CAJA_FLOTANTE,
    MERMA_ZOCALO,
    VARILLA_ZOCALO_M,
    PEGAMENTO_KG_M2,
    BOLSA_PEGAMENTO_KG,
    DESPERDICIO_PEGAMENTO_PCT,
    DESPERDICIO_PASTINA_PCT,
    PASTINA_DENSIDAD,
    ANCHO_PUERTA_M,
    M2_POR_PLANCHA,
    PASTINA_VENECITA_KG_M2,
    ADHESIVO_VENECITA_KG_M2,
    TABLA_MACHIMBRE_M,
    RESINA_L_M2_MM,
    PRIMER_L_M2,
    SELLADOR_L_M2,
    DESPERDICIO_EPOXI_PCT,
  }}
>
  (function () {
    const H = window.HC_HUB;

    // El desglose mezcla m², cajas, bolsas, kg, litros y pesos: NINGUNA fila
    // puede quedar sin `format`, porque el runtime hace Object.assign y la que
    // no lo declara cae a pesos. Las de plata declaran 'ars' explícito.
    const U = (v, unit, decimals) => ({ v: v, format: 'unit', unit: unit, decimals: decimals || 0 });

    const n = (x, d) =>
      Number(x || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });
    const nd = (x, d) => Number(x || 0).toLocaleString('es-AR', { maximumFractionDigits: d === undefined ? 1 : d });

    /**
     * kg/m² de pastina con la fórmula geométrica de juntas-pastina-…:
     *   ((L + A) / (L × A)) × junta × espesor × densidad
     * L y A en mm. Es la MISMA cuenta que la fórmula del repo.
     */
    function pastinaKgM2(largoMm, anchoMm, juntaMm, espesorMm) {
      return ((largoMm + anchoMm) / (largoMm * anchoMm)) * juntaMm * espesorMm * PASTINA_DENSIDAD;
    }

    function plural(x, sing, plur) {
      return x === 1 ? sing : plur;
    }

    H.onCompute(function (v, kase) {
      const rama = (kase && kase.id) || 'ceramico';
      const largo = Math.max(0, v.largo || 0);
      const ancho = Math.max(0, v.ancho || 0);
      const m2 = largo * ancho;
      const perimetro = 2 * (largo + ancho);
      const puertas = Math.max(0, Math.round(v.puertas || 0));
      const precioCaja = Math.max(0, v.precioCaja || 0);
      const formato = M2_POR_CAJA[v.formato] ? v.formato : '60x60';

      const rows = [];

      /* ───────────────────────── Porcelanato líquido ───────────────────────── */
      if (rama === 'epoxi') {
        const espesor = Math.min(5, Math.max(0.5, v.espesorEpoxi || 1.5));
        const f = 1 + DESPERDICIO_EPOXI_PCT / 100;
        const resina = m2 * espesor * RESINA_L_M2_MM * f;
        const primer = m2 * PRIMER_L_M2 * f;
        const sellador = m2 * SELLADOR_L_M2 * f;

        rows.push({ k: 'Superficie a cubrir', ref: 'largo × ancho', ...U(m2, 'm²', 2) });
        rows.push({ k: 'Espesor del piso', ref: 'lo define el fabricante del kit', ...U(espesor, 'mm', 1) });
        rows.push({ k: 'Resina epoxi', ref: nd(RESINA_L_M2_MM, 2) + ' L por m² y por mm', ...U(resina, 'L', 1), extra: true });
        rows.push({ k: 'Primer o imprimación', ref: nd(PRIMER_L_M2, 2) + ' L/m²', ...U(primer, 'L', 1), extra: true });
        rows.push({ k: 'Sellador UV', ref: nd(SELLADOR_L_M2, 2) + ' L/m²', ...U(sellador, 'L', 1), extra: true });
        rows.push({ k: 'Desperdicio incluido', ref: 'sobre los tres productos', ...U(DESPERDICIO_EPOXI_PCT, '%') });

        return {
          total: nd(resina, 1) + ' L de resina',
          sub:
            nd(m2, 2) + ' m² a ' + nd(espesor, 1) + ' mm · más ' + nd(primer, 1) + ' L de primer y ' +
            nd(sellador, 1) + ' L de sellador UV · el epoxi se compra por kit cerrado, redondeá para arriba',
          format: 'plain',
          rows: rows,
          chart: [
            { label: 'Resina epoxi (L)', value: Math.round(resina * 10) / 10, tone: 'main' },
            { label: 'Primer (L)', value: Math.round(primer * 10) / 10, tone: 'prop' },
            { label: 'Sellador UV (L)', value: Math.round(sellador * 10) / 10, tone: 'good' },
          ],
        };
      }

      /* ─────────────────────────── Machimbre ─────────────────────────── */
      if (rama === 'machimbre') {
        const desp = Math.min(30, Math.max(0, v.desperdicio === undefined ? DESPERDICIO_CERAMICO : v.desperdicio));
        const anchoTabla = Math.max(1, v.anchoTabla || 10);
        const areaUtil = Math.round(m2 * (1 + desp / 100) * 10000) / 10000;
        const m2Machimbre = areaUtil > 0 ? Math.ceil(areaUtil * 100) / 100 : 0;
        const ml = areaUtil > 0 ? Math.ceil((areaUtil / (anchoTabla / 100)) * 10) / 10 : 0;
        const tablas = ml > 0 ? Math.ceil(ml / TABLA_MACHIMBRE_M) : 0;
        const mlComprados = tablas * TABLA_MACHIMBRE_M;
        const m2Comprados = (mlComprados * anchoTabla) / 100;

        rows.push({ k: 'Superficie a revestir', ref: 'largo × alto', ...U(m2, 'm²', 2) });
        rows.push({ k: 'Desperdicio por cortes (' + nd(desp, 0) + '%)', ref: 'recortes de punta', ...U(m2Machimbre - m2, 'm²', 2) });
        rows.push({ k: 'Machimbre a comprar', ref: 'con desperdicio', ...U(m2Machimbre, 'm²', 2), extra: true });
        rows.push({ k: 'Metros lineales de tabla', ref: 'tabla de ' + nd(anchoTabla, 1) + ' cm de ancho útil', ...U(ml, 'm', 1) });
        rows.push({ k: 'Tablas de ' + nd(TABLA_MACHIMBRE_M, 0) + ' m', ref: 'la medida que se vende', ...U(tablas, 'tablas'), extra: true });
        rows.push({ k: 'Superficie que cubren esas tablas', ref: nd(mlComprados, 1) + ' m lineales', ...U(m2Comprados, 'm²', 2) });
        rows.push({ k: 'Te sobra', ref: 'guardalo para reposición', ...U(Math.max(0, m2Comprados - m2), 'm²', 2) });

        return {
          total: tablas + ' ' + plural(tablas, 'tabla', 'tablas') + ' de ' + nd(TABLA_MACHIMBRE_M, 0) + ' m',
          sub:
            nd(m2, 2) + ' m² a revestir + ' + nd(desp, 0) + '% de desperdicio = ' + nd(m2Machimbre, 2) +
            ' m² · ' + nd(ml, 1) + ' m lineales de tabla de ' + nd(anchoTabla, 1) + ' cm',
          format: 'plain',
          rows: rows,
          chart: [
            { label: 'm² a revestir', value: Math.round(m2 * 100) / 100, tone: 'prop' },
            { label: 'm² con desperdicio', value: Math.round(m2Machimbre * 100) / 100, tone: 'main' },
            { label: 'm² que cubren las tablas', value: Math.round(m2Comprados * 100) / 100, tone: 'good' },
            { label: 'm² que sobran', value: Math.round(Math.max(0, m2Comprados - m2) * 100) / 100, tone: 'warn' },
          ],
        };
      }

      /* ─────────────────────────── Venecitas ─────────────────────────── */
      if (rama === 'venecita') {
        const desp = Math.min(30, Math.max(0, v.desperdicio === undefined ? DESPERDICIO_CERAMICO : v.desperdicio));
        const areaUtil = m2 * (1 + desp / 100);
        const planchas = Math.ceil(areaUtil / M2_POR_PLANCHA);
        const m2Comprados = planchas * M2_POR_PLANCHA;
        const pastina = Math.ceil(m2 * PASTINA_VENECITA_KG_M2 * 10) / 10;
        const adhesivo = Math.ceil(m2 * ADHESIVO_VENECITA_KG_M2);

        rows.push({ k: 'Superficie a revestir', ref: 'largo × ancho', ...U(m2, 'm²', 2) });
        rows.push({ k: 'Desperdicio por cortes (' + nd(desp, 0) + '%)', ref: 'recortes entre teselas', ...U(areaUtil - m2, 'm²', 2) });
        rows.push({ k: 'Planchas de malla 30 × 30', ref: nd(M2_POR_PLANCHA, 4) + ' m² cada una', ...U(planchas, 'planchas'), extra: true });
        rows.push({ k: 'Superficie que cubren', ref: 'planchas × ' + nd(M2_POR_PLANCHA, 4) + ' m²', ...U(m2Comprados, 'm²', 2) });
        rows.push({ k: 'Pastina', ref: nd(PASTINA_VENECITA_KG_M2, 2) + ' kg/m²: es todo junta', ...U(pastina, 'kg', 1), extra: true });
        rows.push({ k: 'Adhesivo', ref: nd(ADHESIVO_VENECITA_KG_M2, 1) + ' kg/m²', ...U(adhesivo, 'kg'), extra: true });
        rows.push({ k: 'Te sobra', ref: 'reserva para roturas', ...U(Math.max(0, m2Comprados - m2), 'm²', 2) });

        return {
          total: planchas + ' ' + plural(planchas, 'plancha', 'planchas'),
          sub:
            nd(m2, 2) + ' m² + ' + nd(desp, 0) + '% de desperdicio · ' + nd(pastina, 1) + ' kg de pastina y ' +
            nd(adhesivo, 0) + ' kg de adhesivo · en pileta, productos impermeables',
          format: 'plain',
          rows: rows,
          chart: [
            { label: 'm² a revestir', value: Math.round(m2 * 100) / 100, tone: 'prop' },
            { label: 'm² con desperdicio', value: Math.round(areaUtil * 100) / 100, tone: 'main' },
            { label: 'm² en planchas enteras', value: Math.round(m2Comprados * 100) / 100, tone: 'good' },
            { label: 'm² que sobran', value: Math.round(Math.max(0, m2Comprados - m2) * 100) / 100, tone: 'warn' },
          ],
        };
      }

      /* ──────────────────── Cerámico / porcelanato y flotante ──────────────────── */
      const esFlotante = rama === 'flotante';
      const colocacion = DESPERDICIO_FLOTANTE[v.colocacion] !== undefined ? v.colocacion : 'recta';
      const desp = esFlotante
        ? DESPERDICIO_FLOTANTE[colocacion]
        : Math.min(30, Math.max(0, v.desperdicio === undefined ? DESPERDICIO_CERAMICO : v.desperdicio));

      const m2CajaDefault = esFlotante ? M2_CAJA_FLOTANTE : M2_POR_CAJA[formato];
      const m2Caja = v.m2Caja > 0 ? v.m2Caja : m2CajaDefault;

      const m2ConDesp = m2 * (1 + desp / 100);
      const cajas = m2Caja > 0 ? Math.ceil(m2ConDesp / m2Caja) : 0;
      const m2Comprados = cajas * m2Caja;
      const sobrante = Math.max(0, m2Comprados - m2);
      const costo = cajas * precioCaja;

      rows.push({ k: 'Superficie del ambiente', ref: nd(largo, 2) + ' × ' + nd(ancho, 2) + ' m', ...U(m2, 'm²', 2) });
      rows.push({
        k: 'Desperdicio por cortes (' + nd(desp, 0) + '%)',
        ref: esFlotante ? 'colocación ' + (colocacion === 'diagonal' ? 'en diagonal' : 'recta') : 'cortes, roturas y piezas falladas',
        ...U(m2ConDesp - m2, 'm²', 2),
      });
      rows.push({ k: 'Superficie a cubrir con material', ref: 'ambiente + desperdicio', ...U(m2ConDesp, 'm²', 2), extra: true });
      rows.push({
        k: 'm² por caja',
        ref: v.m2Caja > 0 ? 'el que cargaste vos' : esFlotante ? 'caja estándar de flotante' : 'estándar del formato ' + formato,
        ...U(m2Caja, 'm²', 2),
      });
      rows.push({ k: 'CAJAS A COMPRAR', ref: 'redondeo hacia arriba: la caja no se abre', ...U(cajas, 'cajas'), extra: true });
      rows.push({ k: 'Superficie que traen esas cajas', ref: 'cajas × m² por caja', ...U(m2Comprados, 'm²', 2) });
      rows.push({ k: 'Te sobra', ref: 'tu repuesto para el día que se raje una pieza', ...U(sobrante, 'm²', 2) });

      let bolsas = 0;
      let pastina = 0;
      let varillas = 0;
      let mlZocalo = 0;

      if (esFlotante) {
        mlZocalo = Math.max(0, perimetro - puertas * ANCHO_PUERTA_M);
        const mlConMerma = mlZocalo * (1 + MERMA_ZOCALO);
        varillas = Math.ceil(mlConMerma / VARILLA_ZOCALO_M);
        rows.push({ k: 'Zócalo: metros lineales', ref: 'perímetro − ' + puertas + ' ' + plural(puertas, 'puerta', 'puertas'), ...U(mlZocalo, 'm', 1) });
        rows.push({ k: 'Zócalo con merma (' + Math.round(MERMA_ZOCALO * 100) + '%)', ref: 'cortes de esquina a 45°', ...U(mlConMerma, 'm', 1) });
        rows.push({ k: 'Varillas de zócalo de ' + nd(VARILLA_ZOCALO_M, 1) + ' m', ref: 'la medida que se vende', ...U(varillas, 'varillas'), extra: true });
      } else {
        const pegKey = String(v.encolado) === 'doble' ? 'large_double' : PEGAMENTO_POR_FORMATO[formato] || 'medium';
        const pegKgM2 = PEGAMENTO_KG_M2[pegKey];
        const pegKg = m2 * pegKgM2 * (1 + DESPERDICIO_PEGAMENTO_PCT / 100);
        bolsas = Math.ceil(pegKg / BOLSA_PEGAMENTO_KG);

        const mm = MEDIDAS_MM[formato] || [600, 600];
        const junta = Math.max(0.5, v.junta || 3);
        const espesorPieza = Math.max(1, v.espesor || 8);
        const pastinaM2 = pastinaKgM2(mm[0], mm[1], junta, espesorPieza);
        pastina = m2 * pastinaM2 * (1 + DESPERDICIO_PASTINA_PCT / 100);

        rows.push({ k: 'Pegamento', ref: nd(pegKgM2, 1) + ' kg/m² (' + (String(v.encolado) === 'doble' ? 'doble encolado' : 'llana según formato') + ')', ...U(pegKg, 'kg', 1) });
        rows.push({ k: 'Bolsas de pegamento de ' + BOLSA_PEGAMENTO_KG + ' kg', ref: 'redondeo hacia arriba', ...U(bolsas, 'bolsas'), extra: true });
        rows.push({ k: 'Pastina', ref: 'junta ' + nd(junta, 1) + ' mm · espesor ' + nd(espesorPieza, 0) + ' mm → ' + nd(pastinaM2, 3) + ' kg/m²', ...U(pastina, 'kg', 1), extra: true });
      }

      rows.push({ k: 'Costo estimado del material', ref: '$' + n(precioCaja) + ' la caja × ' + cajas, v: costo, format: 'ars' });

      const extra = esFlotante
        ? ' · ' + varillas + ' ' + plural(varillas, 'varilla', 'varillas') + ' de zócalo (' + nd(mlZocalo, 1) + ' m lineales)'
        : ' · ' + bolsas + ' ' + plural(bolsas, 'bolsa', 'bolsas') + ' de pegamento y ' + nd(pastina, 1) + ' kg de pastina';

      return {
        total: cajas + ' ' + plural(cajas, 'caja', 'cajas'),
        sub:
          nd(m2, 2) + ' m² + ' + nd(desp, 0) + '% de desperdicio = ' + nd(m2ConDesp, 2) + ' m² · cajas de ' +
          nd(m2Caja, 2) + ' m² → ' + nd(m2Comprados, 2) + ' m² comprados, te sobran ' + nd(sobrante, 2) + ' m²' + extra,
        format: 'plain',
        rows: rows,
        chart: [
          { label: 'm² del ambiente', value: Math.round(m2 * 100) / 100, tone: 'prop' },
          { label: 'm² con desperdicio', value: Math.round(m2ConDesp * 100) / 100, tone: 'main' },
          { label: 'm² en cajas enteras', value: Math.round(m2Comprados * 100) / 100, tone: 'good' },
          { label: 'm² que sobran', value: Math.round(sobrante * 100) / 100, tone: 'warn' },
        ],
      };
    });
  })();
</script>
