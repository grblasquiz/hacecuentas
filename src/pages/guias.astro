---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TOTAL_DISPLAY } from '../lib/calc-counts';

const guiasModules = import.meta.glob<any>('../content/guias/*.json', { eager: true });
const rawGuides = Object.values(guiasModules).map((m: any) => m.default || m);

const topics = [
  { id: 'all', label: 'Todas', icon: '✦' },
  { id: 'dinero', label: 'Dinero', icon: '💸' },
  { id: 'trabajo', label: 'Trabajo e impuestos', icon: '💼' },
  { id: 'vida', label: 'Vida cotidiana', icon: '🏠' },
  { id: 'bienestar', label: 'Bienestar', icon: '🌿' },
  { id: 'aprendizaje', label: 'Aprendizaje', icon: '🧠' },
];

const topicFor = (g: any) => {
  const text = `${g.slug} ${g.category || ''}`;
  if (/finanzas|fondo-emergencia|inversion-inmobiliaria|dividir-gastos/.test(text)) return 'dinero';
  if (/sueldo|impuesto|anses|negocio|marketing|independiente/.test(text)) return 'trabajo';
  if (/salud|fitness|deporte|embarazo|bebe|productividad/.test(text)) return 'bienestar';
  if (/matematica|ciencia|tecnologia|electronica/.test(text)) return 'aprendizaje';
  return 'vida';
};

const guias = rawGuides
  .map((g: any) => {
    const calcCount = new Set((g.sections || []).flatMap((s: any) => s.calcs || [])).size;
    return { ...g, topic: topicFor(g), calcCount, sectionCount: (g.sections || []).length };
  })
  .sort((a: any, b: any) => a.h1.localeCompare(b.h1, 'es'));

const featuredSlugs = ['sueldos-argentina-2026', 'finanzas-personales', 'auto-y-movilidad'];
const featured = featuredSlugs
  .map((slug) => guias.find((g: any) => g.slug === slug))
  .filter(Boolean);

const title = 'Guías Completas de Cálculo y Finanzas — Hacé Cuentas';
const description = `Guías completas: sueldos Argentina, impuestos, subsidios ANSES, finanzas personales, salud, embarazo, construcción, matemáticas, productividad, cocina. Con ${TOTAL_DISPLAY} calculadoras.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guías Hacé Cuentas',
  description,
  url: 'https://hacecuentas.com/guias',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guias.map((g: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.h1,
      url: `https://hacecuentas.com/guia/${g.slug}`,
    })),
  },
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guías', item: 'https://hacecuentas.com/guias' },
  ],
};
---
<Layout title={title} description={description} image="/og/guias.png" schema={schema} domain="knowledge">
  <Header slot="header" />

  <main class="guides-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <span>Guías</span>
    </nav>

    <header class="guides-hero">
      <div class="hero-copy">
        <span class="eyebrow">Biblioteca práctica</span>
        <h1>Entendé el tema.<br /><span>Después hacé la cuenta.</span></h1>
        <p>
          Recorridos claros para tomar decisiones de plata, trabajo y vida cotidiana.
          Cada guía baja el tema a ejemplos y te lleva a la calculadora exacta cuando la necesitás.
        </p>
        <div class="trust-row" aria-label="Características de las guías">
          <span><strong>{guias.length}</strong> guías</span>
          <span><strong>Fuentes oficiales</strong></span>
          <span><strong>Revisión editorial</strong></span>
        </div>
      </div>

      <div class="hero-finder" role="search" aria-label="Buscar y filtrar guías">
        <label for="guide-search">¿Qué querés resolver?</label>
        <div class="search-box">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" /></svg>
          <input id="guide-search" type="search" placeholder="Ej: sueldo, viaje, auto, embarazo…" autocomplete="off" />
          <kbd>/</kbd>
        </div>
        <div class="topic-filters" aria-label="Filtrar por tema">
          {topics.map((topic) => (
            <button type="button" class="topic-chip" data-topic={topic.id} aria-pressed={topic.id === 'all' ? 'true' : 'false'}>
              <span aria-hidden="true">{topic.icon}</span>{topic.label}
            </button>
          ))}
        </div>
      </div>
    </header>

    <section class="featured-guides" id="featured-guides" aria-labelledby="featured-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Para empezar</span>
          <h2 id="featured-title">Las guías que más resuelven</h2>
        </div>
        <p>Una selección para decisiones frecuentes y de alto impacto.</p>
      </div>
      <div class="featured-grid">
        {featured.map((g: any, i: number) => (
          <a href={`/guia/${g.slug}`} class={`featured-card featured-${i + 1}`}>
            <div class="featured-top">
              <span class="featured-icon" aria-hidden="true">{g.icon}</span>
              <span class="featured-label">Guía destacada</span>
            </div>
            <h3>{g.h1}</h3>
            <p>{g.description}</p>
            <div class="card-meta">
              <span>{g.sectionCount} capítulos</span>
              {g.calcCount > 0 && <span>{g.calcCount} calculadoras</span>}
            </div>
            <span class="card-action">Empezar guía <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="all-guides" aria-labelledby="all-guides-title">
      <div class="section-heading results-heading">
        <div>
          <span class="eyebrow">Explorá a tu manera</span>
          <h2 id="all-guides-title">Todas las guías</h2>
        </div>
        <p id="guide-results" class="results-count" aria-live="polite">{guias.length} guías disponibles</p>
      </div>

      <div class="guides-grid" id="guides-grid">
        {guias.map((g: any) => (
          <article
            class="guide-card"
            data-topic={g.topic}
            data-search={`${g.h1} ${g.description} ${g.slug}`.toLocaleLowerCase('es')}
          >
            <a href={`/guia/${g.slug}`} class="guide-card-link" aria-label={`Abrir guía: ${g.h1}`}>
              <div class="guide-card-top">
                <span class="guide-icon" aria-hidden="true">{g.icon}</span>
                <span class="guide-type">{g.sectionCount >= 6 ? 'Guía completa' : 'Paso a paso'}</span>
              </div>
              <h3>{g.h1}</h3>
              <p>{g.description}</p>
              <div class="guide-card-bottom">
                <div class="card-meta">
                  <span>{g.sectionCount} capítulos</span>
                  {g.calcCount > 0 && <span>{g.calcCount} calculadoras</span>}
                </div>
                <span class="round-arrow" aria-hidden="true">→</span>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="empty-state" id="guides-empty" hidden>
        <span aria-hidden="true">🧭</span>
        <h3>No encontramos esa guía</h3>
        <p>Probá con una palabra más general o elegí otro tema.</p>
        <button type="button" id="clear-guide-filters">Ver todas las guías</button>
      </div>
    </section>

    <aside class="editorial-note">
      <div class="editorial-mark" aria-hidden="true">✓</div>
      <div>
        <strong>Información que podés verificar</strong>
        <p>Las guías se construyen con fuentes oficiales y revisión editorial. Te mostramos la fecha de actualización y las referencias en cada página.</p>
      </div>
      <a href="/politica-editorial">Cómo trabajamos <span aria-hidden="true">→</span></a>
    </aside>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)}></script>
  <Footer slot="footer" />
</Layout>

<style>
  .guides-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1rem 1.25rem 5rem;
    color: var(--text);
  }
  .breadcrumbs { display: flex; align-items: center; gap: .5rem; font-size: .84rem; color: var(--text-subtle); margin-bottom: 1.5rem; }
  .breadcrumbs a { color: var(--accent); text-decoration: none; }

  .guides-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(2rem, 5vw, 4.5rem);
    border: 1px solid var(--border);
    border-radius: 28px;
    background:
      radial-gradient(circle at 92% 8%, color-mix(in srgb, var(--accent) 15%, transparent), transparent 35%),
      linear-gradient(145deg, var(--bg-card), var(--bg-soft));
    overflow: hidden;
  }
  .guides-hero::after {
    content: '';
    position: absolute;
    width: 260px;
    height: 260px;
    right: -150px;
    bottom: -170px;
    border: 42px solid color-mix(in srgb, var(--accent) 10%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }
  .eyebrow { display: block; margin-bottom: .65rem; color: var(--accent); font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .hero-copy h1 { max-width: 650px; margin: 0; font-size: clamp(2.45rem, 5vw, 4.6rem); line-height: .98; letter-spacing: -.055em; font-weight: 850; }
  .hero-copy h1 span { color: var(--accent); }
  .hero-copy > p { max-width: 620px; margin: 1.4rem 0 1.6rem; color: var(--text-muted); font-size: clamp(1rem, 1.8vw, 1.15rem); line-height: 1.65; }
  .trust-row { display: flex; flex-wrap: wrap; gap: .65rem 1.15rem; color: var(--text-subtle); font-size: .82rem; }
  .trust-row span { display: flex; align-items: center; gap: .4rem; }
  .trust-row span::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .trust-row strong { color: var(--text); }

  .hero-finder { position: relative; z-index: 1; min-width: 0; padding: 1.35rem; border: 1px solid var(--border); border-radius: 20px; background: color-mix(in srgb, var(--bg-card) 93%, transparent); box-shadow: var(--shadow-lg); }
  .hero-finder > label { display: block; margin: 0 0 .7rem; font-size: .95rem; font-weight: 750; }
  .search-box { display: flex; align-items: center; gap: .65rem; min-height: 54px; padding: 0 .9rem; border: 1px solid var(--border); border-radius: 13px; background: var(--bg-card); transition: border-color .2s, box-shadow .2s; }
  .search-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
  .search-box svg { width: 21px; fill: none; stroke: var(--text-subtle); stroke-width: 2; }
  .search-box input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: .95rem; }
  .search-box input::placeholder { color: var(--text-subtle); }
  .search-box kbd { padding: .15rem .4rem; border: 1px solid var(--border); border-radius: 5px; background: var(--bg-soft); color: var(--text-subtle); font-size: .72rem; box-shadow: 0 1px 0 var(--border); }
  .topic-filters { display: flex; flex-wrap: wrap; gap: .45rem; width: 100%; min-width: 0; max-width: 100%; margin-top: .9rem; }
  .topic-chip { display: inline-flex; align-items: center; gap: .35rem; padding: .48rem .68rem; border: 1px solid var(--border); border-radius: 999px; background: var(--bg-soft); color: var(--text-muted); font: inherit; font-size: .78rem; font-weight: 650; cursor: pointer; transition: .18s ease; }
  .topic-chip:hover { border-color: var(--accent); color: var(--text); }
  .topic-chip[aria-pressed='true'] { border-color: var(--accent); background: var(--accent); color: #fff; }

  .featured-guides, .all-guides { margin-top: clamp(3.25rem, 7vw, 5.5rem); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.5rem; }
  .section-heading h2 { margin: 0; font-size: clamp(1.65rem, 3vw, 2.25rem); letter-spacing: -.035em; }
  .section-heading > p { max-width: 420px; margin: 0 0 .1rem; color: var(--text-muted); line-height: 1.5; font-size: .92rem; text-align: right; }

  .featured-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .featured-card { position: relative; display: flex; min-height: 330px; flex-direction: column; padding: 1.55rem; border: 1px solid var(--border); border-radius: 20px; background: var(--bg-card); color: var(--text); text-decoration: none; overflow: hidden; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .featured-card::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: linear-gradient(90deg, var(--accent), #06b6d4); }
  .featured-card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: var(--shadow-lg); }
  .featured-top, .guide-card-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .featured-icon { display: grid; width: 48px; height: 48px; place-items: center; border-radius: 14px; background: var(--accent-soft); font-size: 1.65rem; }
  .featured-label, .guide-type { color: var(--text-subtle); font-size: .72rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .featured-card h3 { margin: 1.35rem 0 .65rem; font-size: 1.3rem; line-height: 1.25; letter-spacing: -.02em; }
  .featured-card p { display: -webkit-box; margin: 0 0 1.2rem; overflow: hidden; color: var(--text-muted); font-size: .9rem; line-height: 1.55; -webkit-line-clamp: 4; -webkit-box-orient: vertical; }
  .card-meta { display: flex; flex-wrap: wrap; gap: .4rem .85rem; color: var(--text-subtle); font-size: .76rem; }
  .card-meta span { display: inline-flex; align-items: center; gap: .32rem; }
  .card-meta span::before { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }
  .card-action { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 1.1rem; color: var(--accent); font-size: .9rem; font-weight: 750; }

  .results-count { white-space: nowrap; }
  .guides-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .guide-card { min-width: 0; }
  .guide-card[hidden] { display: none; }
  .guide-card-link { display: flex; min-height: 100%; flex-direction: column; padding: 1.35rem; border: 1px solid var(--border); border-radius: 17px; background: var(--bg-card); color: var(--text); text-decoration: none; transition: transform .18s, border-color .18s, box-shadow .18s; }
  .guide-card-link:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: var(--shadow-md); }
  .guide-icon { display: grid; width: 43px; height: 43px; place-items: center; border: 1px solid var(--border); border-radius: 13px; background: var(--bg-soft); font-size: 1.45rem; }
  .guide-card h3 { margin: 1.05rem 0 .55rem; font-size: 1.08rem; line-height: 1.3; letter-spacing: -.015em; }
  .guide-card p { display: -webkit-box; margin: 0 0 1.15rem; overflow: hidden; color: var(--text-muted); font-size: .86rem; line-height: 1.55; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
  .guide-card-bottom { display: flex; align-items: end; justify-content: space-between; gap: .8rem; margin-top: auto; }
  .round-arrow { display: grid; width: 34px; height: 34px; flex: 0 0 auto; place-items: center; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-weight: 800; transition: transform .18s, background .18s, color .18s; }
  .guide-card-link:hover .round-arrow { transform: translateX(3px); background: var(--accent); color: #fff; }

  .empty-state { padding: 4rem 1rem; border: 1px dashed var(--border); border-radius: 20px; text-align: center; }
  .empty-state > span { font-size: 2.5rem; }
  .empty-state h3 { margin: .8rem 0 .4rem; }
  .empty-state p { margin: 0 0 1rem; color: var(--text-muted); }
  .empty-state button { padding: .65rem 1rem; border: 0; border-radius: 999px; background: var(--accent); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }

  .editorial-note { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; margin-top: 4rem; padding: 1.25rem 1.4rem; border: 1px solid var(--border); border-radius: 18px; background: var(--bg-soft); }
  .editorial-mark { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 900; }
  .editorial-note strong { font-size: .95rem; }
  .editorial-note p { margin: .22rem 0 0; color: var(--text-muted); font-size: .83rem; line-height: 1.5; }
  .editorial-note a { color: var(--accent); font-size: .85rem; font-weight: 750; text-decoration: none; white-space: nowrap; }

  @media (max-width: 960px) {
    .guides-hero { grid-template-columns: 1fr; }
    .hero-copy h1 { max-width: 760px; }
    .featured-grid, .guides-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .featured-card:last-child { grid-column: 1 / -1; min-height: 270px; }
  }
  @media (max-width: 640px) {
    .guides-page { padding: .6rem .8rem 4rem; }
    .breadcrumbs { margin-bottom: .9rem; }
    .guides-hero { gap: 1.7rem; padding: 1.45rem; border-radius: 20px; }
    .hero-copy h1 { font-size: clamp(2.35rem, 12vw, 3.3rem); }
    .hero-copy > p { margin: 1rem 0 1.25rem; }
    .trust-row { gap: .55rem .8rem; }
    .hero-finder { padding: 1rem; border-radius: 16px; box-shadow: var(--shadow-sm); }
    .search-box kbd { display: none; }
    .topic-filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .topic-chip { flex: 0 0 auto; }
    .section-heading { display: block; }
    .section-heading > p { margin-top: .55rem; text-align: left; }
    .featured-grid, .guides-grid { grid-template-columns: 1fr; }
    .featured-card, .featured-card:last-child { min-height: 285px; grid-column: auto; }
    .guide-card-link { min-height: 0; }
    .editorial-note { grid-template-columns: auto 1fr; }
    .editorial-note a { grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .featured-card, .guide-card-link, .round-arrow { transition: none; }
  }
</style>

<script is:inline>
(() => {
  const input = document.getElementById('guide-search');
  const chips = Array.from(document.querySelectorAll('.topic-chip'));
  const cards = Array.from(document.querySelectorAll('.guide-card'));
  const count = document.getElementById('guide-results');
  const empty = document.getElementById('guides-empty');
  const featured = document.getElementById('featured-guides');
  const clear = document.getElementById('clear-guide-filters');
  if (!input || !cards.length) return;

  let activeTopic = 'all';
  const normalize = (value) => value.toLocaleLowerCase('es').normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  const applyFilters = () => {
    const query = normalize(input.value.trim());
    let visible = 0;
    cards.forEach((card) => {
      const search = normalize(card.dataset.search || '');
      const topicMatches = activeTopic === 'all' || card.dataset.topic === activeTopic;
      const searchMatches = !query || search.includes(query);
      card.hidden = !(topicMatches && searchMatches);
      if (!card.hidden) visible += 1;
    });
    count.textContent = `${visible} ${visible === 1 ? 'guía encontrada' : 'guías encontradas'}`;
    empty.hidden = visible !== 0;
    featured.hidden = Boolean(query) || activeTopic !== 'all';
  };

  input.addEventListener('input', applyFilters);
  chips.forEach((chip) => chip.addEventListener('click', () => {
    activeTopic = chip.dataset.topic || 'all';
    chips.forEach((item) => item.setAttribute('aria-pressed', String(item === chip)));
    applyFilters();
  }));
  clear?.addEventListener('click', () => {
    input.value = '';
    activeTopic = 'all';
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.topic === 'all')));
    applyFilters();
    input.focus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== input) {
      event.preventDefault();
      input.focus();
    }
  });
})();
</script>
