---
export const prerender = true;
import FeriadosLanding from '../components/FeriadosLanding.astro';
import { FERIADOS_LATAM_2026 } from '../lib/data/feriados-latam-2026';

const related = [
  { href: '/dias-entre-dos-fechas', label: 'Días entre dos fechas' },
  { href: '/calculadora-cuenta-regresiva-dias-faltan', label: 'Cuenta regresiva: cuántos días faltan' },
  { href: '/mx/calculadora-aguinaldo-mexico-2026-15-dias-tope-30', label: 'Calculadora de aguinaldo México 2026' },
  { href: '/mx', label: 'Más calculadoras para México' },

  // Cluster de feriados: las 5 landings estaban aisladas (1-2 inlinks cada una,
  // posición 7-8 en Bing). Enlazadas entre sí se sostienen mutuamente.
  { href: '/feriados-colombia-2026', label: 'Feriados Colombia 2026' },
  { href: '/feriados-chile-2026', label: 'Feriados Chile 2026' },
  { href: '/feriados-peru-2026', label: 'Feriados Perú 2026' },
  { href: '/feriados-ecuador-2026', label: 'Feriados Ecuador 2026' },
];

const title = 'Feriados México 2026: días festivos oficiales y puentes';
const description = 'Calendario México 2026: los días festivos y de descanso obligatorio (Art. 74 LFT) con la fecha y el día de la semana, más los festivos civiles. Mirá cuál es el próximo y los puentes del año.';
---
<FeriadosLanding data={FERIADOS_LATAM_2026.mexico} related={related} title={title} description={description} />
