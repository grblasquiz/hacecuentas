---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeriadosMexicoExperience from '../components/generated/FeriadosMexicoExperience.astro';
import FeriadosLatamLinks from '../components/FeriadosLatamLinks.astro';
const canonical='https://hacecuentas.com/feriados-mexico-2026';
const schema={'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage',name:'Calendario de feriados de México 2026',description:'Días de descanso obligatorio, puentes, Semana Santa y calendario escolar de México en 2026.',url:canonical,inLanguage:'es-MX',dateModified:'2026-07-31'},
  {'@type':'FAQPage',mainEntity:[
    {'@type':'Question',name:'¿Cuáles son los días de descanso obligatorio en México en 2026?',acceptedAnswer:{'@type':'Answer',text:'El calendario distingue los descansos obligatorios del artículo 74 de la LFT de las fechas tradicionales, escolares y bancarias.'}},
    {'@type':'Question',name:'¿Cómo se paga si trabajo un feriado obligatorio?',acceptedAnswer:{'@type':'Answer',text:'Además del salario del día, corresponde un salario doble por el servicio prestado; en total, el día se paga triple.'}}
  ]}
]};
---
<Layout title="Feriados México 2026: descansos y puentes | Hacé Cuentas" description="Calendario de feriados de México 2026: descansos obligatorios de la LFT, puentes, Semana Santa, fechas escolares y pago si te toca trabajar." canonical={canonical} schema={schema} lang="es" audience="MX">
  <Header />
  <FeriadosMexicoExperience />
  <FeriadosLatamLinks currentPath="/feriados-mexico-2026" />
  <Footer />
</Layout>
