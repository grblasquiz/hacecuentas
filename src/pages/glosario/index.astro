---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PRUNING_REDIRECTS } from '../../lib/pruning-redirects';

const LABELS: Record<string, string> = {
  afip: 'AFIP / ARCA', anses: 'ANSES', cbu: 'CBU', 'alias-cbu': 'Alias CBU',
  cer: 'CER', imc: 'IMC', iva: 'IVA', mcd: 'MCD', mcm: 'MCM',
  tea: 'TEA', tir: 'TIR', van: 'VAN',
};

const terms = Object.entries(PRUNING_REDIRECTS)
  .filter(([path]) => path.startsWith('/glosario/'))
  .map(([path, href]) => {
    const slug = path.replace('/glosario/', '');
    const label = LABELS[slug] ?? slug.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
    return { label, href };
  })
  .sort((a, b) => a.label.localeCompare(b.label, 'es'));

const canonical = 'https://hacecuentas.com/glosario';
const description =
  'Glosario de finanzas, trabajo, impuestos, matemática y salud: entendé cada concepto y pasá directamente a la calculadora o guía que permite usarlo.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glosario de Hacé Cuentas',
  description,
  url: canonical,
  hasDefinedTerm: terms.map((term) => ({
    '@type': 'DefinedTerm',
    name: term.label,
    url: `https://hacecuentas.com${term.href}`,
  })),
};
---

<Layout
  title="Glosario de finanzas, impuestos y cálculos | Hacé Cuentas"
  description={description}
  canonical={canonical}
  schema={schema}
>
  <Header />
  <main class="glossary">
    <nav aria-label="Migas de pan">
      <a href="/">Inicio</a><span aria-hidden="true">›</span><span>Glosario</span>
    </nav>

    <header>
      <p class="eyebrow">Conceptos explicados con herramientas</p>
      <h1>Glosario de Hacé Cuentas</h1>
      <p class="lede">
        Buscá el término que necesitás entender. Cada concepto lleva a la calculadora o guía
        específica donde podés ver la fórmula, los supuestos, un ejemplo y las fuentes.
      </p>
    </header>

    <section aria-labelledby="terminos">
      <h2 id="terminos">Términos y conceptos</h2>
      <div class="grid">
        {terms.map((term) => (
          <a href={term.href}>
            <strong>{term.label}</strong>
            <span>Ver explicación y herramienta <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="how" aria-labelledby="como-usarlo">
      <h2 id="como-usarlo">Cómo usar este glosario</h2>
      <p>
        Una definición aislada rara vez alcanza para tomar una decisión. Por eso consolidamos
        cada término en la página que mejor lo explica y lo aplica. Por ejemplo, interés,
        amortización y TEA llevan al recorrido de préstamos; sueldo bruto, neto, preaviso e
        indemnización llevan a las herramientas laborales; calorías, macronutrientes e IMC
        llevan a los recorridos de salud y nutrición.
      </p>
      <p>
        Cuando el concepto depende de una norma o un valor oficial, la página de destino indica
        la fuente y la fecha de actualización. Los resultados son orientativos: para decisiones
        legales, impositivas o médicas, contrastalos con la autoridad o el profesional que
        corresponda.
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .glossary{max-width:1120px;margin:0 auto;padding:32px 20px 72px}
  nav{display:flex;gap:8px;color:#64748b;font-size:14px;margin-bottom:38px}
  nav a{color:#334155}
  header{max-width:760px;margin-bottom:42px}
  .eyebrow{color:#0f766e;font-weight:800;text-transform:uppercase;letter-spacing:.08em;font-size:13px}
  h1{font-size:clamp(38px,7vw,64px);line-height:1.02;letter-spacing:-.045em;margin:10px 0 18px}
  .lede{font-size:20px;line-height:1.6;color:#475569}
  h2{font-size:28px;margin:0 0 20px}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
  .grid a{display:flex;flex-direction:column;gap:8px;padding:18px;border:1px solid #dbe4ee;border-radius:14px;text-decoration:none;background:#fff;color:#0f172a}
  .grid a:hover{border-color:#0f766e;box-shadow:0 8px 24px rgba(15,118,110,.09)}
  .grid span{color:#526277;font-size:14px}
  .how{max-width:780px;margin-top:54px}
  .how p{font-size:17px;line-height:1.75;color:#334155}
</style>
