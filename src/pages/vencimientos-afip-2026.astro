      { fecha: '13/06', concepto: 'Ganancias Personas Humanas - DDJJ anual (CUIT 7-9)', tipo: 'ganancias' },
      { fecha: '15/06', concepto: 'IVA - DDJJ mensual (CUIT 0-3)', tipo: 'iva' },
      { fecha: '16/06', concepto: 'IVA - DDJJ mensual (CUIT 4-6)', tipo: 'iva' },
