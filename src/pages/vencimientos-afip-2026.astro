    ]
  },
  {
    mes: 'Octubre 2026',
    items: [
      { fecha: '13/10', concepto: 'Ganancias - Anticipos (CUIT 0-3)', tipo: 'ganancias' },
      { fecha: '14/10', concepto: 'Ganancias - Anticipos (CUIT 4-6)', tipo: 'ganancias' },
      { fecha: '15/10', concepto: 'Ganancias - Anticipos (CUIT 7-9)', tipo: 'ganancias' },
      { fecha: '13/10', concepto: 'IVA - DDJJ mensual (CUIT 0-3)', tipo: 'iva' },
      { fecha: '14/10', concepto: 'IVA - DDJJ mensual (CUIT 4-6)', tipo: 'iva' },
      { fecha: '15/10', concepto: 'IVA - DDJJ mensual (CUIT 7-9)', tipo: 'iva' },
      { fecha: '20/10', concepto: 'Monotributo - Cuota mensual', tipo: 'monotributo' },
    ]
  },
  {
    mes: 'Noviembre 2026',
    items: [
      { fecha: '13/11', concepto: 'IVA - DDJJ mensual (CUIT 0-3)', tipo: 'iva' },
      { fecha: '14/11', concepto: 'IVA - DDJJ mensual (CUIT 4-6)', tipo: 'iva' },
      { fecha: '15/11', concepto: 'IVA - DDJJ mensual (CUIT 7-9)', tipo: 'iva' },
      { fecha: '20/11', concepto: 'Monotributo - Cuota mensual', tipo: 'monotributo' },
    ]
  },
  {
    mes: 'Diciembre 2026',
    items: [
      { fecha: '13/12', concepto: 'Ganancias - Anticipos (CUIT 0-3)', tipo: 'ganancias' },
      { fecha: '14/12', concepto: 'Ganancias - Anticipos (CUIT 4-6)', tipo: 'ganancias' },
      { fecha: '15/12', concepto: 'Ganancias - Anticipos (CUIT 7-9)', tipo: 'ganancias' },
      { fecha: '15/12', concepto: 'IVA - DDJJ mensual (CUIT 0-3)', tipo: 'iva' },
      { fecha: '16/12', concepto: 'IVA - DDJJ mensual (CUIT 4-6)', tipo: 'iva' },
      { fecha: '17/12', concepto: 'IVA - DDJJ mensual (CUIT 7-9)', tipo: 'iva' },
      { fecha: '22/12', concepto: 'Monotributo - Cuota mensual', tipo: 'monotributo' },
    ]
  },
];

// --- Filtrado server-side por fecha (la página es prerender y el sitio deploya a diario,
// así el "próximo vencimiento" y la división próximos / ya vencidos se recalculan solos) ---
const hoyAR = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Argentina/Buenos_Aires' }));
const hoyISO = `${hoyAR.getFullYear()}-${String(hoyAR.getMonth() + 1).padStart(2, '0')}-${String(hoyAR.getDate()).padStart(2, '0')}`;

// 'DD/MM' + 'Mes YYYY' → 'YYYY-MM-DD' (comparación lexicográfica = cronológica)
const toISO = (fecha: string, mesLabel: string) => {
  const [d, m] = fecha.split('/');
  const year = mesLabel.split(' ')[1] ?? '2026';
  return `${year}-${m}-${d}`;
};

const conFechas = calendario.map((mes) => ({
  ...mes,
  items: mes.items.map((item) => ({ ...item, iso: toISO(item.fecha, mes.mes) })),
}));

// Meses con vencimientos futuros (>= hoy) y pasados (< hoy). Un mismo mes puede aparecer
// en ambos grupos si estamos a mitad de mes.
const mesesProximos = conFechas
  .map((mes) => ({ ...mes, items: mes.items.filter((it) => it.iso >= hoyISO) }))
  .filter((mes) => mes.items.length > 0);
const mesesPasados = conFechas
  .map((mes) => ({ ...mes, items: mes.items.filter((it) => it.iso < hoyISO) }))
  .filter((mes) => mes.items.length > 0);
const totalPasados = mesesPasados.reduce((acc, m) => acc + m.items.length, 0);

// Próximo vencimiento destacado (+ cuántas obligaciones caen ese mismo día)
const futurosOrdenados = mesesProximos.flatMap((m) => m.items).sort((a, b) => a.iso.localeCompare(b.iso));
const proximoVto = futurosOrdenados[0] ?? null;
const proximoVtoMismoDia = proximoVto ? futurosOrdenados.filter((it) => it.iso === proximoVto.iso) : [];
const MESES_LARGO = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const isoALargo = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} de ${MESES_LARGO[m - 1]} de ${y}`;
};
const diasHasta = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  const [hy, hm, hd] = hoyISO.split('-').map(Number);
  return Math.round((Date.UTC(y, m - 1, d) - Date.UTC(hy, hm - 1, hd)) / 86400000);
};

const faqItems = [
  {
    q: '¿Cuándo vence el monotributo cada mes en 2026?',
    a: 'El monotributo vence el día 20 de cada mes. Si el 20 cae en día no hábil (feriado o fin de semana), el vencimiento se traslada al siguiente día hábil. Las fechas exactas para 2026 son: 20/01, 20/02, 20/03, 21/04, 20/05, 22/06, 20/07, 20/08, 22/09, 20/10, 20/11 y 22/12.'
  },
  {
    q: '¿Cuándo se presenta la declaración jurada de Ganancias 2025?',
    a: 'La declaración jurada anual de Ganancias para personas humanas (ejercicio fiscal 2025) vence en junio de 2026, con fechas escalonadas según la terminación del CUIT: 11/06 para CUIT terminados en 0-3, 12/06 para 4-6 y 13/06 para 7-9. El pago se realiza en la misma fecha o se puede optar por un plan de facilidades.'
  },
  {
    q: '¿Cuándo vence Bienes Personales 2025?',
    a: 'La declaración jurada de Bienes Personales (ejercicio 2025) vence en junio de 2026 junto con Ganancias: 11/06 (CUIT 0-3), 12/06 (CUIT 4-6) y 13/06 (CUIT 7-9). Están obligados a presentarla quienes posean bienes al 31/12/2025 que superen el mínimo no imponible vigente.'
  },
  {
    q: '¿Cuándo son las recategorizaciones del monotributo en 2026?',
    a: 'Las recategorizaciones del monotributo se realizan dos veces al año: en enero (vencimiento 20/01/2026) evaluando los últimos 12 meses anteriores, y en julio (vencimiento 20/07/2026) evaluando julio 2025 a junio 2026. Si tus parámetros no cambiaron, no es necesario recategorizarte.'
  },
  {
    q: '¿Qué pasa si no pago el monotributo a tiempo?',
    a: 'Si no pagás el monotributo antes del vencimiento, se generan intereses resarcitorios automáticos (actualmente alrededor de la tasa efectiva mensual que fija AFIP). Además, la mora reiterada puede dar lugar a una baja de oficio del monotributo. Podés regularizar pagando con el VEP que incluya los intereses, o adherirte a un plan de facilidades.'
  },
  {
    q: '¿Cómo pago mis obligaciones de AFIP?',
    a: 'Las obligaciones de AFIP se pagan mediante VEP (Volante Electrónico de Pago) que se genera desde el portal de AFIP y se abona por homebanking, billetera virtual o en cualquier entidad bancaria. También podés configurar el débito automático en cuenta bancaria o tarjeta de crédito para el monotributo.'
  },
  {
    q: '¿Cuándo vence el IVA mensual en 2026?',
    a: 'El IVA mensual para Responsables Inscriptos vence entre el día 13 y 17 de cada mes, según la terminación del CUIT: días 13/14/15 para CUIT terminados en 0-1/2-3, 4-5/6-7 y 8-9 respectivamente. Si la fecha cae en día no hábil, se traslada al siguiente día hábil.'
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/vencimientos-afip-2026`,
      url: `${siteUrl}/vencimientos-afip-2026`,
      name: title,
      description: description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      inLanguage: 'es-AR',
      datePublished: '2026-04-16',
      dateModified: hoyISO,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Finanzas', item: `${siteUrl}/categoria/finanzas` },
        { '@type': 'ListItem', position: 3, name: 'Vencimientos AFIP 2026' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};

// Colores por tipo para los badges
const tipoLabel: Record<string, string> = {
  monotributo: 'Monotributo',
  ganancias: 'Ganancias',
  iva: 'IVA',
  bienes: 'Bienes Personales',
};
---
<Layout title={title} description={description} schema={schema} audience="AR">
  <Header slot="header" />

  <article class="landing">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/categoria/finanzas">Finanzas</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Vencimientos AFIP 2026</span>
    </nav>

    <!-- HERO -->
    <header class="hero">
      <h1>Vencimientos AFIP 2026: calendario fiscal completo</h1>
      <p class="lead">
        Todas las fechas de vencimiento de AFIP para 2026: monotributo mensual, IVA, Ganancias, Bienes Personales, anticipos y recategorizaciones. Filtrá por mes y tipo de obligación para encontrar tus fechas rápido.
      </p>
      <div class="hero-meta">
        <span>Actualizado: {hoyAR.getDate()} de {MESES_LARGO[hoyAR.getMonth()]} {hoyAR.getFullYear()}</span>
        <span>Fuente: AFIP / RG vigentes</span>
      </div>
      <p class="lead">
        📅 <a href="/calendarios">Suscribite al calendario de vencimientos</a> (Google/Apple/Outlook): cuota del monotributo, recategorización y aguinaldo te avisan solos.
      </p>
    </header>

    <!-- PRÓXIMO VENCIMIENTO -->
    {proximoVto && (
      <section class="section">
        <div class="next-vto" role="status">
          <div class="next-vto-main">
            <div class="next-vto-label">Próximo vencimiento</div>
            <div class="next-vto-fecha">{isoALargo(proximoVto.iso)}</div>
            <div class="next-vto-dias">
              {diasHasta(proximoVto.iso) === 0
                ? 'Vence hoy'
                : diasHasta(proximoVto.iso) === 1
                  ? 'Vence mañana'
                  : `Faltan ${diasHasta(proximoVto.iso)} días`}
            </div>
          </div>
          <div class="next-vto-side">
            {proximoVtoMismoDia.map((it) => (
              <div class="next-vto-item">
                <span class={`vto-badge ${it.tipo}`}>{tipoLabel[it.tipo]}</span>
                <span class="next-vto-concepto">{it.concepto}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FILTROS -->
    <section class="section">
      <div class="filters" id="filters">
        <button class="filter-btn active" data-filter="all">Todos</button>
        <button class="filter-btn" data-filter="monotributo">Monotributo</button>
        <button class="filter-btn" data-filter="iva">IVA</button>
        <button class="filter-btn" data-filter="ganancias">Ganancias</button>
        <button class="filter-btn" data-filter="bienes">Bienes Personales</button>
      </div>
    </section>

    <!-- RESUMEN RÁPIDO MONOTRIBUTO -->
    <section class="section">
      <h2>Vencimientos monotributo 2026 (resumen)</h2>
      <div class="mono-grid">
        {monotributoVto.map((v) => (
          <div class="mono-card">
            <div class="mono-mes">{v.mes}</div>
            <div class="mono-fecha">{v.fecha}</div>
          </div>
        ))}
      </div>
      <p class="section-note">
        La cuota del monotributo vence el día 20 de cada mes. Cuando el 20 cae en feriado o fin de semana, se corre al siguiente día hábil. Podés pagar con VEP, débito automático o en red de pagos.
      </p>
    </section>

    <!-- CALENDARIO MES A MES -->
    <section class="section" id="calendario">
      <h2>Próximos vencimientos, mes a mes</h2>
      <p>Hacé clic en cada mes para ver el detalle de vencimientos que todavía no pasaron. Usá los filtros de arriba para mostrar solo un tipo de obligación.</p>

      <div class="calendar-accordion">
        {mesesProximos.map((m, idx) => (
          <details class="month-block" open={idx === 0}>
            <summary class="month-header">
              <span class="month-name">{m.mes}</span>
              <span class="month-count">{m.items.length} vencimiento{m.items.length !== 1 ? 's' : ''}</span>
            </summary>
            <div class="month-body">
              {m.items.map((item) => (
                <div class={`vto-row ${item.tipo}`} data-tipo={item.tipo}>
                  <span class="vto-fecha">{item.fecha}</span>
                  <span class={`vto-badge ${item.tipo}`}>{tipoLabel[item.tipo]}</span>
                  <span class="vto-concepto">{item.concepto}</span>
                </div>
              ))}
            </div>
          </details>
        ))}
      </div>

      {mesesPasados.length > 0 && (
        <details class="past-block">
          <summary class="past-header">
            Ya vencidos ({totalPasados} vencimiento{totalPasados !== 1 ? 's' : ''} anteriores al {isoALargo(hoyISO)})
          </summary>
          <p class="past-note">
            Fechas que ya pasaron, útiles como referencia (por ejemplo, para regularizar una obligación adeudada con su VEP e intereses).
          </p>
          <div class="calendar-accordion">
            {mesesPasados.map((m) => (
              <details class="month-block">
                <summary class="month-header">
                  <span class="month-name">{m.mes}</span>
                  <span class="month-count">{m.items.length} vencimiento{m.items.length !== 1 ? 's' : ''}</span>
                </summary>
                <div class="month-body">
                  {m.items.map((item) => (
                    <div class={`vto-row ${item.tipo}`} data-tipo={item.tipo}>
                      <span class="vto-fecha">{item.fecha}</span>
                      <span class={`vto-badge ${item.tipo}`}>{tipoLabel[item.tipo]}</span>
                      <span class="vto-concepto">{item.concepto}</span>
                    </div>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      )}
    </section>

    <!-- FECHAS DESTACADAS -->
    <section class="section">
      <h2>Fechas clave 2026</h2>
      <div class="key-dates">
        <div class="kd-card">
          <div class="kd-date">20 de enero</div>
          <div class="kd-title">Recategorización monotributo</div>
          <div class="kd-desc">Primera recategorización semestral. Evaluación julio-diciembre 2025.</div>
        </div>
        <div class="kd-card accent">
          <div class="kd-date">11-13 de junio</div>
          <div class="kd-title">DDJJ Ganancias + Bienes Personales</div>
          <div class="kd-desc">Declaraciones juradas anuales del ejercicio 2025. Fecha según terminación de CUIT.</div>
        </div>
        <div class="kd-card">
          <div class="kd-date">20 de julio</div>
          <div class="kd-title">Recategorización monotributo</div>
          <div class="kd-desc">Segunda recategorización semestral. Evaluación julio 2025 - junio 2026.</div>
        </div>
      </div>
    </section>

