      { fecha: '13/06', concepto: 'Bienes Personales - DDJJ anual (CUIT 7-9)', tipo: 'bienes' },
      { fecha: '11/06', concepto: 'Ganancias Personas Humanas - DDJJ anual (CUIT 0-3)', tipo: 'ganancias' },
