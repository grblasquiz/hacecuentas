      { fecha: '15/09', concepto: 'IVA - DDJJ mensual (CUIT 4-6)', tipo: 'iva' },
      { fecha: '16/09', concepto: 'IVA - DDJJ mensual (CUIT 7-9)', tipo: 'iva' },
