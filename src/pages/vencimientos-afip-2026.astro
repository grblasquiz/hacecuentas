      { fecha: '15/01', concepto: 'IVA - DDJJ mensual (CUIT 0-3)', tipo: 'iva' },
      { fecha: '16/01', concepto: 'IVA - DDJJ mensual (CUIT 4-6)', tipo: 'iva' },
      { fecha: '17/01', concepto: 'IVA - DDJJ mensual (CUIT 7-9)', tipo: 'iva' },
      { fecha: '20/01', concepto: 'Monotributo - Cuota mensual', tipo: 'monotributo' },
      { fecha: '20/01', concepto: 'Recategorización monotributo (semestral)', tipo: 'monotributo' },
    ]
  },
  {
    mes: 'Febrero 2026',
    items: [
      { fecha: '13/02', concepto: 'IVA - DDJJ mensual (CUIT 0-3)', tipo: 'iva' },
