      { fecha: '15/08', concepto: 'Ganancias - Anticipos (CUIT 7-9)', tipo: 'ganancias' },
      { fecha: '13/08', concepto: 'IVA - DDJJ mensual (CUIT 0-3)', tipo: 'iva' },
