---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import ActionCard from '../components/ui/ActionCard.astro';

const title = 'Vencimientos AFIP 2026: calendario fiscal completo mes por mes | Hacé Cuentas';
const description = 'Calendario completo de vencimientos AFIP 2026: monotributo, ganancias, bienes personales, IVA, autónomos. Todas las fechas mes por mes con detalle según terminación de CUIT.';

const siteUrl = 'https://hacecuentas.com';

// Vencimientos monotributo mensuales 2026 (día 20 de cada mes, con ajuste si cae en feriado/fin de semana)
const meses = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
];

const monotributoVto = [
  { mes: 'Enero', fecha: '20/01' },
  { mes: 'Febrero', fecha: '20/02' },
  { mes: 'Marzo', fecha: '20/03' },
  { mes: 'Abril', fecha: '21/04' },
  { mes: 'Mayo', fecha: '20/05' },
  { mes: 'Junio', fecha: '22/06' },
  { mes: 'Julio', fecha: '20/07' },
  { mes: 'Agosto', fecha: '20/08' },
  { mes: 'Septiembre', fecha: '22/09' },
  { mes: 'Octubre', fecha: '20/10' },
  { mes: 'Noviembre', fecha: '20/11' },
  { mes: 'Diciembre', fecha: '22/12' },
];

// Calendario detallado por mes
const calendario = [
