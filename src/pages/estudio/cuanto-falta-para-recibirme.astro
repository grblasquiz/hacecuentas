---
/**
 * Hub de decisión — "¿Cuánto me falta para recibirme?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de estudio/promedio.astro: la página sólo aporta los datos
 * (src/lib/hubs/cuanto-falta-para-recibirme.ts) y su compute(). El chrome, el
 * CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/cuanto-falta-para-recibirme';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * Ninguna rama es plata y el default de HubRow es 'ars': TODA fila declara
     * su formato. Materias, créditos y cuatrimestres en 'plain'; años, meses,
     * horas y porcentajes en 'unit'.
     */
    const CANT = { format: 'plain', decimals: 0 };
    const CANT1 = { format: 'plain', decimals: 1 };
    const MAT = { format: 'unit', unit: 'materias', decimals: 0 };
    const MAT1 = { format: 'unit', unit: 'materias', decimals: 1 };
    const CRED = { format: 'unit', unit: 'créditos', decimals: 0 };
    const CUATRI = { format: 'unit', unit: 'cuatrimestres', decimals: 0 };
    const ANIOS = { format: 'unit', unit: 'años', decimals: 1 };
    const HS = { format: 'unit', unit: 'hs/semana', decimals: 1 };
    const HSTOT = { format: 'unit', unit: 'hs', decimals: 0 };
    const PCT = { format: 'unit', unit: '%', decimals: 2 };

    const fmt = (n, d) => {
      if (!isFinite(n)) return '—';
      const dec = d == null ? 2 : d;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };
    const clamp = (n) => Math.max(0, Math.min(100, isFinite(n) ? n : 0));
    const num = (x, def) => {
      const n = Number(x);
      return isFinite(n) ? n : def;
    };
    const plural = (n, uno, muchos) => (n === 1 ? uno : muchos);

    /**
     * Franjas del avance de la carrera. Se usan en las cuatro ramas que miden
     * progreso sobre el total del plan.
     */
    const TRAMOS = [
      { label: 'Arrancando', value: 25, from: 0, to: 25, tone: 'bad' },
      { label: 'En camino', value: 25, from: 25, to: 50, tone: 'warn' },
      { label: 'Segunda mitad', value: 25, from: 50, to: 75, tone: 'good' },
      { label: 'Recta final', value: 25, from: 75, to: 100, tone: 'main' },
    ];

    /**
     * Horas de trabajo del estudiante que representa 1 crédito, por sistema.
     * Espejo de CREDITO_HORAS en src/lib/hubs/cuanto-falta-para-recibirme.ts.
     */
    const CREDITO_HORAS = {
      rtf15: { horas: 15, nombre: 'Argentina (≈15 hs por crédito)' },
      ects25: { horas: 25, nombre: 'ECTS (25 hs por crédito)' },
      ects30: { horas: 30, nombre: 'ECTS (30 hs por crédito)' },
      us45: { horas: 45, nombre: 'EE.UU. (≈45 hs por semester credit)' },
    };

    /** Semanas de cursada de un cuatrimestre típico en la Argentina. */
    const SEMANAS_CUATRI = 16;
    /** Por encima de esto la carga semanal es difícil de sostener. */
    const CARGA_ALTA = 45;
    /** Tope de la escala del gráfico de carga horaria. */
    const CARGA_TOPE = 60;

    const err = (msg, k, v) => ({
      total: '—',
      sub: msg,
      rows: [{ k: k, v: v, ...CANT }],
      chart: [],
      format: 'plain',
      decimals: 0,
      position: 0,
      positionLabel: msg,
    });

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'materias';

      // ---- Datos compartidos por las ramas de materias --------------------
      const total = Math.max(1, num(v.totalMaterias, 40));
      const aprobadas = Math.max(0, Math.min(total, num(v.materiasAprobadas, 0)));
      const enCurso = Math.max(0, Math.min(total - aprobadas, num(v.materiasEnCurso, 0)));
      const faltantes = Math.max(0, total - aprobadas - enCurso);
      const avanceReal = (aprobadas / total) * 100;
      const avanceOptimista = ((aprobadas + enCurso) / total) * 100;

      const porCuatri = Math.max(1, num(v.materiasPorCuatri, 4));
      const tasa = Math.max(1, Math.min(100, num(v.tasaAprobacion, 100)));
      const cuatrisPorAnio = Math.max(1, Math.min(3, num(v.cuatrisPorAnio, 2)));
      const efectivas = porCuatri * (tasa / 100);
      const cuatris = faltantes === 0 ? 0 : Math.ceil(faltantes / efectivas);
      const aniosRestantes = cuatris / cuatrisPorAnio;

      // ---- 1) Cuántas materias me faltan ----------------------------------
      if (id === 'materias') {
        const paraMitad = Math.max(0, Math.ceil(total * 0.5) - aprobadas);
        const paraTresCuartos = Math.max(0, Math.ceil(total * 0.75) - aprobadas);
        return {
          total: fmt(faltantes, 0),
          sub:
            faltantes === 0
              ? 'Entre aprobadas y en curso cubrís las ' + total + ' materias del plan. Sólo queda cerrar las cursadas y los trámites de egreso.'
              : 'Te faltan ' + fmt(faltantes, 0) + ' de ' + total + ' materias. Llevás ' + fmt(avanceReal) + '% aprobado' +
                (enCurso > 0 ? ' y ' + fmt(avanceOptimista) + '% si sumás las ' + enCurso + ' que estás cursando.' : '.'),
          rows: [
            { k: 'Total de materias del plan', v: total, ...MAT },
            { k: 'Materias aprobadas', v: aprobadas, ...MAT },
            { k: 'Materias en curso', ref: 'todavía no cuentan como avance', v: enCurso, ...MAT },
            { k: 'Materias que te faltan', ref: 'total − aprobadas − en curso', v: faltantes, extra: true, ...MAT },
            { k: 'Avance real de la carrera', ref: 'aprobadas ÷ total', v: avanceReal, extra: true, ...PCT },
            { k: 'Avance sumando las materias en curso', ref: 'la lectura optimista', v: avanceOptimista, ...PCT },
            { k: 'Te faltan para llegar a la mitad', ref: '50% del plan', v: paraMitad, ...MAT },
            { k: 'Te faltan para llegar a la recta final', ref: '75% del plan', v: paraTresCuartos, ...MAT },
          ],
          format: 'plain',
          decimals: 0,
          chart: TRAMOS,
          position: clamp(avanceReal),
          positionLabel: 'Avance ' + fmt(avanceReal) + '% — ' + aprobadas + ' de ' + total + ' materias aprobadas',
        };
      }

      // ---- 2) En cuántos cuatrimestres termino ----------------------------
      if (id === 'cuatrimestres') {
        if (faltantes === 0) {
          return {
            total: '0',
            sub: 'No te queda ninguna materia por cursar: entre aprobadas y en curso cubrís el plan completo.',
            rows: [
              { k: 'Total de materias del plan', v: total, ...MAT },
              { k: 'Materias aprobadas', v: aprobadas, ...MAT },
              { k: 'Materias en curso', v: enCurso, ...MAT },
              { k: 'Materias que te faltan', v: 0, extra: true, ...MAT },
            ],
            format: 'plain',
            decimals: 0,
            chart: TRAMOS,
            position: clamp(avanceReal),
            positionLabel: 'Avance ' + fmt(avanceReal) + '% — sin materias pendientes de cursada',
          };
        }
        const efectivasMas = (porCuatri + 1) * (tasa / 100);
        const cuatrisMas = Math.ceil(faltantes / efectivasMas);
        const ahorro = cuatris - cuatrisMas;
        const meses = Math.round((aniosRestantes) * 12);
        return {
          total: fmt(cuatris, 0),
          sub:
            'Cursando ' + porCuatri + ' ' + plural(porCuatri, 'materia', 'materias') + ' por cuatrimestre y aprobando el ' + fmt(tasa, 0) + '%, ' +
            'aprobás ' + fmt(efectivas, 1) + ' por cuatrimestre: te quedan ' + fmt(cuatris, 0) + ' ' + plural(cuatris, 'cuatrimestre', 'cuatrimestres') +
            ' (' + fmt(aniosRestantes, 1) + ' ' + plural(aniosRestantes, 'año', 'años') + ' a ' + cuatrisPorAnio + ' por año).',
          rows: [
            { k: 'Materias que te faltan', ref: 'total − aprobadas − en curso', v: faltantes, ...MAT },
            { k: 'Materias que cursás por cuatrimestre', v: porCuatri, ...MAT },
            { k: 'Tasa de aprobación', v: tasa, ...PCT },
            { k: 'Materias que aprobás por cuatrimestre', ref: 'cursadas × tasa', v: efectivas, ...MAT1 },
            { k: 'Cuatrimestres que te quedan', ref: 'faltantes ÷ aprobadas por cuatrimestre, hacia arriba', v: cuatris, extra: true, ...CUATRI },
            { k: 'En años', ref: 'cuatrimestres ÷ ' + cuatrisPorAnio + ' por año', v: aniosRestantes, extra: true, ...ANIOS },
            { k: 'En meses', v: meses, format: 'unit', unit: 'meses', decimals: 0 },
            { k: 'Si cursaras una materia más por cuatrimestre', ref: porCuatri + 1 + ' por cuatrimestre', v: cuatrisMas, ...CUATRI },
            { k: 'Cuatrimestres que te ahorrarías', v: ahorro, ...CUATRI },
          ],
          format: 'plain',
          decimals: 0,
          chart: TRAMOS,
          position: clamp(avanceReal),
          positionLabel: 'Avance ' + fmt(avanceReal) + '% — te quedan ' + fmt(cuatris, 0) + ' ' + plural(cuatris, 'cuatrimestre', 'cuatrimestres'),
        };
      }

      // ---- 3) Cuánto voy a tardar en total --------------------------------
      if (id === 'total') {
        const cursados = Math.max(0, num(v.aniosCursados, 0));
        const teorica = Math.max(0.5, num(v.duracionTeorica, 5));
        const duracionReal = cursados + aniosRestantes;
        const sobreTiempo = duracionReal - teorica;
        const pctSobre = (sobreTiempo / teorica) * 100;
        const aniosDisponibles = Math.max(0, teorica - cursados);
        const cuatrisDisponibles = aniosDisponibles * cuatrisPorAnio;
        const ritmoNecesario = cuatrisDisponibles > 0 ? faltantes / cuatrisDisponibles / (tasa / 100) : Infinity;
        return {
          total: fmt(duracionReal, 1),
          sub:
            'A tu ritmo la carrera te va a llevar ' + fmt(duracionReal, 1) + ' ' + plural(duracionReal, 'año', 'años') + ': ' +
            fmt(cursados, 1) + ' ya cursados + ' + fmt(aniosRestantes, 1) + ' que faltan. ' +
            (sobreTiempo > 0.05
              ? 'Son ' + fmt(sobreTiempo, 1) + ' ' + plural(sobreTiempo, 'año', 'años') + ' por encima de los ' + fmt(teorica, 1) + ' del plan (+' + fmt(pctSobre, 0) + '%).'
              : sobreTiempo < -0.05
                ? 'Vas ' + fmt(Math.abs(sobreTiempo), 1) + ' ' + plural(Math.abs(sobreTiempo), 'año', 'años') + ' por debajo de los ' + fmt(teorica, 1) + ' del plan.'
                : 'Justo la duración teórica del plan.'),
          rows: [
            { k: 'Años que llevás cursando', v: cursados, ...ANIOS },
            { k: 'Materias que te faltan', v: faltantes, ...MAT },
            { k: 'Años que te faltan a tu ritmo', ref: fmt(cuatris, 0) + ' cuatrimestres ÷ ' + cuatrisPorAnio + ' por año', v: aniosRestantes, ...ANIOS },
            { k: 'Duración real de tu carrera', ref: 'cursados + faltantes', v: duracionReal, extra: true, ...ANIOS },
            { k: 'Duración teórica del plan', v: teorica, ...ANIOS },
            { k: sobreTiempo >= 0 ? 'Años por encima del plan' : 'Años por debajo del plan', v: Math.abs(sobreTiempo), extra: true, ...ANIOS },
            { k: 'Sobre-tiempo en porcentaje', ref: 'diferencia ÷ duración teórica', v: pctSobre, ...PCT },
            {
              k: 'Materias por cuatrimestre para cerrar dentro del plan',
              ref: aniosDisponibles > 0 ? 'te quedan ' + fmt(cuatrisDisponibles, 0) + ' cuatrimestres de plan' : 'ya pasaste la duración teórica',
              v: ritmoNecesario,
              ...MAT1,
            },
          ],
          format: 'plain',
          decimals: 1,
          chart: [
            { label: 'Ya cursado', value: 50, from: 0, to: 50, tone: 'good' },
            { label: 'Lo que falta', value: 50, from: 50, to: 100, tone: 'warn' },
          ],
          position: duracionReal > 0 ? clamp((cursados / duracionReal) * 100) : 0,
          positionLabel:
            'Llevás ' + fmt(cursados, 1) + ' de ' + fmt(duracionReal, 1) + ' ' + plural(duracionReal, 'año', 'años') + ' de recorrido total',
        };
      }

      // ---- 4) Créditos ----------------------------------------------------
      if (id === 'creditos') {
        const totalC = Math.max(1, num(v.creditosTotales, 240));
        const aprobC = Math.max(0, Math.min(totalC, num(v.creditosAprobados, 0)));
        const porCuatriC = Math.max(1, num(v.creditosPorCuatri, 30));
        const faltanC = totalC - aprobC;
        const avanceC = (aprobC / totalC) * 100;
        const cuatrisC = faltanC === 0 ? 0 : Math.ceil(faltanC / porCuatriC);
        const aniosC = cuatrisC / cuatrisPorAnio;
        return {
          total: fmt(faltanC, 0),
          sub:
            faltanC === 0
              ? 'Completaste los ' + totalC + ' créditos del plan: 100% de la carrera.'
              : 'Te faltan ' + fmt(faltanC, 0) + ' de ' + totalC + ' créditos. Llevás ' + fmt(avanceC) + '% del plan y, a ' +
                porCuatriC + ' créditos por cuatrimestre, te quedan ' + fmt(cuatrisC, 0) + ' ' + plural(cuatrisC, 'cuatrimestre', 'cuatrimestres') +
                ' (' + fmt(aniosC, 1) + ' ' + plural(aniosC, 'año', 'años') + ').',
          rows: [
            { k: 'Créditos totales del plan', v: totalC, ...CRED },
            { k: 'Créditos aprobados', v: aprobC, ...CRED },
            { k: 'Créditos que te faltan', ref: 'total − aprobados', v: faltanC, extra: true, ...CRED },
            { k: 'Avance de la carrera en créditos', ref: 'aprobados ÷ total', v: avanceC, extra: true, ...PCT },
            { k: 'Créditos que aprobás por cuatrimestre', v: porCuatriC, ...CRED },
            { k: 'Cuatrimestres que te faltan', ref: 'faltantes ÷ ritmo, hacia arriba', v: cuatrisC, ...CUATRI },
            { k: 'En años', ref: 'cuatrimestres ÷ ' + cuatrisPorAnio + ' por año', v: aniosC, ...ANIOS },
            { k: 'Avance en materias, para comparar', ref: 'aprobadas ÷ total de materias', v: avanceReal, ...PCT },
          ],
          format: 'plain',
          decimals: 0,
          chart: TRAMOS,
          position: clamp(avanceC),
          positionLabel: 'Avance ' + fmt(avanceC) + '% — ' + aprobC + ' de ' + totalC + ' créditos',
        };
      }

      // ---- 5) Horas de estudio de la materia ------------------------------
      const horasClase = Math.max(1, num(v.horasClase, 6));
      const factor = Math.max(1, Math.min(5, num(v.factorEstudio, 2.5)));
      const materias = Math.max(1, num(v.cantidadMaterias, 4));
      const sist = CREDITO_HORAS[v.sistemaCredito] || CREDITO_HORAS.rtf15;
      const creditosMateria = Math.max(1, num(v.creditosMateria, 8));

      const horasPorMateria = horasClase * factor;
      const horasExtra = horasPorMateria - horasClase;
      const horasTotal = horasPorMateria * materias;
      const horasDia = horasTotal / 7;
      const horasCuatri = horasTotal * SEMANAS_CUATRI;
      const horasPlanMateria = creditosMateria * sist.horas;
      const horasPlanSemana = horasPlanMateria / SEMANAS_CUATRI;

      return {
        total: fmt(horasPorMateria, 1),
        sub:
          'Cada materia te pide ' + fmt(horasPorMateria, 1) + ' hs por semana: ' + fmt(horasClase, 1) + ' de clase + ' +
          fmt(horasExtra, 1) + ' de estudio propio. Con ' + materias + ' ' + plural(materias, 'materia', 'materias') + ' son ' +
          fmt(horasTotal, 1) + ' hs semanales, unas ' + fmt(horasDia, 1) + ' por día.' +
          (horasTotal > CARGA_ALTA ? ' Es una carga alta: cuidá el descanso o bajá una materia.' : ''),
        rows: [
          { k: 'Horas de clase semanales', v: horasClase, ...HS },
          { k: 'Factor de estudio', ref: 'horas totales por cada hora de clase', v: factor, format: 'plain', decimals: 1 },
          { k: 'Horas semanales por materia', ref: 'clase × factor', v: horasPorMateria, extra: true, ...HS },
          { k: 'De esas, estudio propio', ref: 'totales − clase', v: horasExtra, ...HS },
          { k: 'Materias que cursás', v: materias, ...MAT },
          { k: 'Carga semanal total', ref: 'por materia × materias', v: horasTotal, extra: true, ...HS },
          { k: 'Promedio por día', ref: 'total ÷ 7', v: horasDia, format: 'unit', unit: 'hs/día', decimals: 1 },
          { k: 'Horas de todo el cuatrimestre', ref: SEMANAS_CUATRI + ' semanas de cursada', v: horasCuatri, ...HSTOT },
          { k: 'Chequeo por créditos — ' + sist.nombre, ref: creditosMateria + ' créditos × ' + sist.horas + ' hs', v: horasPlanMateria, ...HSTOT },
          { k: 'Ese estándar en horas por semana', ref: 'repartido en ' + SEMANAS_CUATRI + ' semanas', v: horasPlanSemana, ...HS },
        ],
        format: 'plain',
        decimals: 1,
        chart: [
          { label: 'Carga liviana', value: 25, from: 0, to: 25, tone: 'good' },
          { label: 'Carga sostenible', value: 20, from: 25, to: CARGA_ALTA, tone: 'warn' },
          { label: 'Carga alta', value: CARGA_TOPE - CARGA_ALTA, from: CARGA_ALTA, to: CARGA_TOPE, tone: 'bad' },
        ],
        position: clamp((horasTotal / CARGA_TOPE) * 100),
        positionLabel:
          fmt(horasTotal, 1) + ' hs semanales' + (horasTotal > CARGA_ALTA ? ' — por encima del límite razonable de ' + CARGA_ALTA + ' hs' : ' — dentro de lo sostenible'),
      };
    });
  })();
</script>
