---
/**
 * Hub de decisión — "¿Qué puntaje necesito en TOEFL, IELTS o Cambridge?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de estudio/promedio.astro: la página sólo aporta los datos
 * (src/lib/hubs/examenes-de-idioma.ts) y su compute(). El chrome, el CSS y el
 * runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/examenes-de-idioma';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * Ninguna rama es plata en pesos y el default de HubRow es 'ars': TODA fila
     * declara su formato. Puntajes y percentiles en 'plain'; horas, semanas,
     * meses y años en 'unit'. Los costos van en dólares, así que también son
     * 'plain' y el label declara "USD".
     */
    const PTS = { format: 'plain', decimals: 0 };
    const BAND = { format: 'plain', decimals: 1 };
    const PCT = { format: 'unit', unit: '%', decimals: 0 };
    const HS = { format: 'unit', unit: 'h', decimals: 0 };
    const SEM = { format: 'unit', unit: 'semanas', decimals: 0 };
    const MES = { format: 'unit', unit: 'meses', decimals: 1 };
    const USD = { format: 'plain', decimals: 0 };
    const VECES = { format: 'unit', unit: 'veces', decimals: 0 };

    const fmt = (n, d) => {
      if (!isFinite(n)) return '—';
      const dec = d == null ? 1 : d;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };
    const clamp = (n) => Math.max(0, Math.min(100, isFinite(n) ? n : 0));
    const pos = (val, min, max) => clamp(((val - min) / (max - min)) * 100);
    const half = (n) => Math.round(n * 2) / 2;
    const num = (x, def) => {
      const n = Number(String(x == null ? '' : x).replace(',', '.'));
      return isFinite(n) ? n : def;
    };

    const err = (msg, k, v) => ({
      total: '—', sub: msg,
      rows: [{ k: k, v: v, ...PTS }],
      chart: [], format: 'plain', decimals: 0, position: 0, positionLabel: msg,
    });

    // =================================================================
    // ESCALAS OFICIALES
    // =================================================================

    /**
     * Eje continuo de nivel MCER: 0 = piso de A1, 1 = piso de A2, 2 = B1,
     * 3 = B2, 4 = C1, 5 = C2, 6 = techo de la escala. Los anclajes son los
     * cortes oficiales de cada examen sobre ese eje.
     *  - Cambridge English Scale: A1 80 · A2 100 · B1 120 · B2 140 · C1 160 · C2 180 · techo 230
     *  - IELTS (ielts.org): B1 4,0 · B2 5,5 · C1 7,0 · C2 8,5 · techo 9,0
     *    (IELTS no certifica A1/A2: los dos primeros anclajes son extrapolación)
     *  - TOEFL iBT (ETS): B1 42 · B2 72 · C1 95 · C2 115 · techo 120
     */
    const ANCLAS_CAM = [80, 100, 120, 140, 160, 180, 230];
    const ANCLAS_IEL = [2, 3, 4, 5.5, 7, 8.5, 9];
    const ANCLAS_TOE = [0, 20, 42, 72, 95, 115, 120];
    const MCER = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2', 'C2'];

    const MCER_DESC = {
      A1: 'usuario básico inicial: expresiones cotidianas muy simples',
      A2: 'usuario básico: frases y vocabulario de uso frecuente',
      B1: 'usuario independiente umbral: alcanza para viajar y para trabajos no especializados',
      B2: 'usuario independiente avanzado: el piso habitual de admisión universitaria',
      C1: 'usuario competente: habilita posgrados y profesiones exigentes',
      C2: 'usuario maestro: cualquier programa académico del mundo',
    };

    /** Puntaje → nivel continuo 0-6 por interpolación lineal entre anclajes. */
    function aNivel(score, anclas) {
      if (score <= anclas[0]) return 0;
      for (let i = 0; i < anclas.length - 1; i++) {
        if (score <= anclas[i + 1]) {
          const span = anclas[i + 1] - anclas[i];
          return i + (span ? (score - anclas[i]) / span : 0);
        }
      }
      return 6;
    }
    /** Nivel continuo 0-6 → puntaje en la escala de ese examen. */
    function deNivel(nivel, anclas) {
      const n = Math.max(0, Math.min(6, nivel));
      const i = Math.min(5, Math.floor(n));
      return anclas[i] + (n - i) * (anclas[i + 1] - anclas[i]);
    }

    /**
     * Tabla de comparación TOEFL iBT ↔ IELTS de ETS. Es la oficial y va por
     * RANGOS: un 94 y un 101 informan el mismo band. Nada de multiplicar por
     * un factor lineal.
     */
    const ETS = [
      { band: 9.0, min: 118, max: 120 },
      { band: 8.5, min: 115, max: 117 },
      { band: 8.0, min: 110, max: 114 },
      { band: 7.5, min: 102, max: 109 },
      { band: 7.0, min: 94, max: 101 },
      { band: 6.5, min: 79, max: 93 },
      { band: 6.0, min: 60, max: 78 },
      { band: 5.5, min: 46, max: 59 },
      { band: 5.0, min: 35, max: 45 },
      { band: 4.5, min: 32, max: 34 },
    ];
    function etsPorToefl(t) {
      for (let i = 0; i < ETS.length; i++) if (t >= ETS[i].min) return ETS[i];
      return null;
    }
    function etsPorBand(b) {
      let mejor = null, dist = Infinity;
      for (let i = 0; i < ETS.length; i++) {
        const d = Math.abs(ETS[i].band - b);
        if (d < dist) { dist = d; mejor = ETS[i]; }
      }
      return dist <= 0.26 ? mejor : null;
    }

    /** Band de IELTS de referencia por objetivo. Cambian: son referencia. */
    const OBJETIVOS = {
      universidad_grado: { band: 6.5, seccion: 6.0, nombre: 'Universidad — carrera de grado', nota: 'Muchas carreras aceptan 6,0; las más selectivas piden 7,0. El corte lo fija cada programa.' },
      universidad_posgrado: { band: 7.0, seccion: 6.5, nombre: 'Universidad — maestría o doctorado', nota: 'Derecho, periodismo y algunas humanidades suelen pedir 7,5 con mínimos por sección más altos.' },
      visa_uk: { band: 5.5, seccion: 5.5, nombre: 'Visa de estudiante del Reino Unido', nota: 'Para grado o superior el requisito migratorio es B2 con un examen SELT aprobado; tu universidad casi siempre pide más que el mínimo de la visa.' },
      australia_pr: { band: 7.0, seccion: 7.0, nombre: 'Migración a Australia — inglés "proficient"', nota: 'El puntaje migratorio suma más con "superior" (8,0 en cada sección). El mínimo se mide por sección, no por promedio.' },
      canada_ee: { band: 7.0, seccion: 7.0, nombre: 'Canadá Express Entry — CLB 9', nota: 'CLB 9 con IELTS General pide Listening 8,0 y 7,0 en Reading, Writing y Speaking: el corte es por sección.' },
      trabajo_salud: { band: 7.0, seccion: 6.5, nombre: 'Trabajo en salud', nota: 'Los organismos de enfermería y medicina suelen aceptar 6,5 en Writing y exigir 7,0 en el resto. Verificá el requisito del colegio profesional.' },
      trabajo_general: { band: 6.0, seccion: 5.5, nombre: 'Trabajo general en el exterior', nota: 'Muchos empleadores no piden certificado y evalúan en la entrevista; el band sirve como referencia interna.' },
    };

    /** Percentiles del SAT — tabla de referencia nacional de College Board. */
    const SAT_PCT = [
      [400, 1], [500, 1], [600, 3], [700, 8], [800, 16], [900, 27],
      [1000, 41], [1050, 49], [1100, 58], [1200, 74], [1300, 86],
      [1400, 94], [1500, 98], [1550, 99], [1600, 99.5],
    ];
    function satPercentil(s) {
      if (s <= SAT_PCT[0][0]) return SAT_PCT[0][1];
      for (let i = 0; i < SAT_PCT.length - 1; i++) {
        if (s <= SAT_PCT[i + 1][0]) {
          const [x0, y0] = SAT_PCT[i], [x1, y1] = SAT_PCT[i + 1];
          return y0 + ((s - x0) / (x1 - x0)) * (y1 - y0);
        }
      }
      return 99.5;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'convertir';

      // ---- 1) Convertir un puntaje a los demás exámenes -----------------
      if (id === 'convertir') {
        const e = String(v.examenOrigen || 'toefl');
        const p = num(v.puntaje, 0);
        if (!(p > 0)) return err('Cargá tu puntaje en el campo "Tu puntaje en ese examen".', 'Puntaje cargado', 0);

        let nivel, ielts, toefl, cam, rangoTxt = '';
        if (e === 'toefl') {
          const t = Math.max(0, Math.min(120, Math.round(p)));
          toefl = t;
          nivel = aNivel(t, ANCLAS_TOE);
          const fila = etsPorToefl(t);
          ielts = fila ? fila.band : half(deNivel(nivel, ANCLAS_IEL));
          rangoTxt = fila
            ? 'la tabla de ETS pone el tramo ' + fila.min + '–' + fila.max + ' del TOEFL en el band ' + fmt(fila.band) + ' del IELTS'
            : 'por debajo de 32 la tabla de comparación de ETS no informa band';
          cam = Math.round(deNivel(nivel, ANCLAS_CAM));
        } else if (e === 'ielts') {
          const b = half(Math.max(0, Math.min(9, p)));
          ielts = b;
          nivel = aNivel(b, ANCLAS_IEL);
          const fila = etsPorBand(b);
          toefl = fila ? Math.round((fila.min + fila.max) / 2) : Math.round(deNivel(nivel, ANCLAS_TOE));
          rangoTxt = fila
            ? 'la tabla de ETS ubica el band ' + fmt(b) + ' entre ' + fila.min + ' y ' + fila.max + ' del TOEFL: el punto es el centro del rango'
            : 'por debajo de 4,5 la tabla de comparación de ETS no informa equivalencia';
          cam = Math.round(deNivel(nivel, ANCLAS_CAM));
        } else {
          const c = Math.max(80, Math.min(230, Math.round(p)));
          cam = c;
          nivel = aNivel(c, ANCLAS_CAM);
          ielts = half(deNivel(nivel, ANCLAS_IEL));
          toefl = Math.round(deNivel(nivel, ANCLAS_TOE));
          rangoTxt = 'la equivalencia de Cambridge se deriva de los cortes del MCER en la Cambridge English Scale, no de una tabla punto a punto';
        }

        const lvl = MCER[Math.min(5, Math.floor(nivel))];
        const bajoB1 = nivel < 2;
        return {
          total: lvl,
          sub:
            'Nivel ' + lvl + ' del MCER — ' + MCER_DESC[lvl] + '. Equivale a IELTS ' + fmt(ielts) +
            ' / TOEFL iBT ' + fmt(toefl, 0) + ' / Cambridge ' + fmt(cam, 0) + ' en la escala única. ' +
            rangoTxt.charAt(0).toUpperCase() + rangoTxt.slice(1) + '.',
          rows: [
            { k: 'IELTS — band equivalente', ref: e === 'ielts' ? 'tu puntaje' : 'redondeado al 0,5 más cercano', v: ielts, extra: e !== 'ielts', ...BAND },
            { k: 'TOEFL iBT — puntaje equivalente', ref: e === 'toefl' ? 'tu puntaje' : 'tabla de comparación de ETS', v: toefl, extra: e !== 'toefl', ...PTS },
            { k: 'Cambridge English Scale', ref: e === 'cambridge' ? 'tu puntaje' : 'cortes del MCER sobre la escala 80–230', v: cam, extra: e !== 'cambridge', ...PTS },
            { k: 'Piso de tu nivel ' + lvl + ' en IELTS', ref: 'ielts.org', v: deNivel(Math.floor(nivel), ANCLAS_IEL), ...BAND },
            { k: 'Piso de tu nivel ' + lvl + ' en TOEFL iBT', ref: 'ETS', v: Math.round(deNivel(Math.floor(nivel), ANCLAS_TOE)), ...PTS },
            { k: 'Cuánto te falta para el nivel siguiente, en IELTS', ref: 'hasta el piso del nivel de arriba', v: Math.max(0, deNivel(Math.floor(nivel) + 1, ANCLAS_IEL) - ielts), ...BAND },
            { k: 'Posición dentro de tu nivel', ref: '0% recién entrado, 100% a punto de pasar al siguiente', v: (nivel - Math.floor(nivel)) * 100, ...PCT },
          ],
          format: 'plain', decimals: 1,
          chart: [
            { label: 'A1', value: 1, from: 0, to: 1, tone: 'bad' },
            { label: 'A2', value: 1, from: 1, to: 2, tone: 'bad' },
            { label: 'B1', value: 1, from: 2, to: 3, tone: 'warn' },
            { label: 'B2', value: 1, from: 3, to: 4, tone: 'good' },
            { label: 'C1', value: 1, from: 4, to: 5, tone: 'main' },
            { label: 'C2', value: 1, from: 5, to: 6, tone: 'main' },
          ],
          position: pos(nivel, 0, 6),
          positionLabel: 'Nivel ' + lvl + (bajoB1 ? ' — por debajo del B1 que mapean las tablas de IELTS y TOEFL' : ' del MCER'),
        };
      }

      // ---- 2) Band de IELTS que pide mi objetivo ------------------------
      if (id === 'objetivo') {
        const o = OBJETIVOS[v.objetivoIelts] || OBJETIVOS.universidad_grado;
        const actual = half(Math.max(0, Math.min(9, num(v.bandActual, 0))));
        const debil = String(v.seccionDebil || 'ninguna');
        const req = o.band;
        const falta = Math.max(0, req - actual);

        // Plan por sección: la floja baja medio punto y OTRA sección lo
        // compensa subiendo medio punto, así el promedio se mantiene exacto.
        const secc = { listening: req, reading: req, writing: req, speaking: req };
        const nombres = { listening: 'Listening', reading: 'Reading', writing: 'Writing', speaking: 'Speaking' };
        if (nombres[debil]) {
          secc[debil] = req - 0.5;
          const compensa = debil === 'reading' ? 'listening' : 'reading';
          secc[compensa] = req + 0.5;
        }
        const promedio = half((secc.listening + secc.reading + secc.writing + secc.speaking) / 4);
        const nivelReq = MCER[Math.min(5, Math.floor(aNivel(req, ANCLAS_IEL)))];
        const filaReq = etsPorBand(req);

        return {
          total: fmt(req),
          sub:
            o.nombre + ' pide un band de referencia de ' + fmt(req) + ' (' + nivelReq + ' del MCER)' +
            (o.seccion ? ' con un mínimo de ' + fmt(o.seccion) + ' por sección' : '') + '. ' +
            (falta > 0
              ? 'Con tu ' + fmt(actual) + ' te faltan ' + fmt(falta) + ' de band, o sea ' + Math.round(falta / 0.5) + ' medio(s) punto(s). '
              : 'Tu ' + fmt(actual) + ' ya alcanza el band de referencia. ') + o.nota,
          rows: [
            { k: 'Band de referencia — ' + o.nombre, v: req, extra: true, ...BAND },
            { k: 'Mínimo por sección que suele exigirse', ref: 'no alcanza el promedio solo', v: o.seccion, ...BAND },
            { k: 'Tu band actual', v: actual, ...BAND },
            { k: falta > 0 ? 'Cuánto te falta' : 'Cuánto te sobra', ref: 'el IELTS se mueve de a 0,5', v: Math.abs(req - actual), extra: true, ...BAND },
            { k: 'Objetivo de Listening', v: secc.listening, ...BAND },
            { k: 'Objetivo de Reading', v: secc.reading, ...BAND },
            { k: 'Objetivo de Writing', v: secc.writing, ...BAND },
            { k: 'Objetivo de Speaking', v: secc.speaking, ...BAND },
            { k: 'Promedio del plan', ref: 'el band final es el promedio de las 4 secciones', v: promedio, ...BAND },
            { k: 'TOEFL iBT equivalente al band de referencia', ref: filaReq ? 'tabla de ETS, tramo ' + filaReq.min + '–' + filaReq.max : 'fuera de la tabla de ETS', v: filaReq ? Math.round((filaReq.min + filaReq.max) / 2) : Math.round(deNivel(aNivel(req, ANCLAS_IEL), ANCLAS_TOE)), ...PTS },
          ],
          format: 'plain', decimals: 1,
          chart: [
            { label: 'Por debajo de B1', value: 4, from: 0, to: 4, tone: 'bad' },
            { label: 'B1', value: 1.5, from: 4, to: 5.5, tone: 'warn' },
            { label: 'B2', value: 1.5, from: 5.5, to: 7, tone: 'good' },
            { label: 'C1', value: 1.5, from: 7, to: 8.5, tone: 'main' },
            { label: 'C2', value: 0.5, from: 8.5, to: 9, tone: 'main' },
          ],
          position: pos(actual, 0, 9),
          positionLabel: 'Tu band ' + fmt(actual) + ' sobre un objetivo de ' + fmt(req),
        };
      }

      // ---- 3) SAT: percentil -------------------------------------------
      if (id === 'sat') {
        const s = Math.max(400, Math.min(1600, Math.round(num(v.satScore, 0) / 10) * 10));
        const pct = satPercentil(s);
        const promedioSat = 1050;
        return {
          total: fmt(pct, 0),
          sub:
            'Percentil ' + fmt(pct, 0) + ': un ' + fmt(pct, 0) + '% de quienes rinden queda por debajo de tu ' + s + '. ' +
            (s >= promedioSat
              ? 'Estás ' + (s - promedioSat) + ' puntos por encima del promedio de referencia (' + promedioSat + ').'
              : 'Estás ' + (promedioSat - s) + ' puntos por debajo del promedio de referencia (' + promedioSat + ').') +
            ' El percentil se recalcula con cada cohorte.',
          rows: [
            { k: 'Tu score total del SAT', ref: 'suma de las dos secciones, 400 a 1600', v: s, extra: true, ...PTS },
            { k: 'Percentil de referencia nacional', ref: 'College Board', v: pct, extra: true, format: 'plain', decimals: 0 },
            { k: 'Cuántos quedan por encima tuyo', ref: '100 − percentil', v: 100 - pct, ...PCT },
            { k: 'Distancia al promedio de referencia (1050)', v: s - promedioSat, ...PTS },
            { k: 'Puntos hasta 1200 (percentil 74)', v: Math.max(0, 1200 - s), ...PTS },
            { k: 'Puntos hasta 1400 (percentil 94)', v: Math.max(0, 1400 - s), ...PTS },
            { k: 'Puntos hasta 1500 (percentil 98)', v: Math.max(0, 1500 - s), ...PTS },
          ],
          format: 'plain', decimals: 0,
          chart: [
            { label: 'Mitad de abajo', value: 50, from: 0, to: 50, tone: 'bad' },
            { label: 'Percentil 50 a 75', value: 25, from: 50, to: 75, tone: 'warn' },
            { label: 'Percentil 75 a 90', value: 15, from: 75, to: 90, tone: 'good' },
            { label: 'Top 10%', value: 10, from: 90, to: 100, tone: 'main' },
          ],
          position: clamp(pct),
          positionLabel: 'SAT ' + s + ' — percentil ' + fmt(pct, 0),
        };
      }

      // ---- 4) Goethe-Zertifikat ----------------------------------------
      if (id === 'goethe') {
        const mods = [
          { n: 'Lesen', v: Math.max(0, Math.min(100, num(v.lesen, 0))) },
          { n: 'Hören', v: Math.max(0, Math.min(100, num(v.horen, 0))) },
          { n: 'Schreiben', v: Math.max(0, Math.min(100, num(v.schreiben, 0))) },
          { n: 'Sprechen', v: Math.max(0, Math.min(100, num(v.sprechen, 0))) },
        ];
        const prom = mods.reduce(function (a, m) { return a + m.v; }, 0) / 4;
        const reprobados = mods.filter(function (m) { return m.v < 60; });
        const debil = mods.reduce(function (a, b) { return a.v <= b.v ? a : b; });
        const mencion = function (x) {
          return x >= 90 ? 'sehr gut (excelente)' : x >= 80 ? 'gut (bien)' : x >= 70 ? 'befriedigend (satisfactorio)' : x >= 60 ? 'ausreichend (suficiente)' : 'nicht bestanden (no aprobado)';
        };
        const apto = reprobados.length === 0;
        return {
          total: fmt(prom, 0),
          sub:
            (apto
              ? 'Aprobás los cuatro módulos. Promedio ' + fmt(prom, 0) + '/100 — mención de referencia ' + mencion(prom) + '. '
              : 'Te queda(n) pendiente(s) ' + reprobados.map(function (m) { return m.n + ' (' + fmt(m.v, 0) + ')'; }).join(', ') + ': cada módulo se aprueba por separado con 60. ') +
            'Tu módulo más flojo es ' + debil.n + ' con ' + fmt(debil.v, 0) + '/100. Podés volver a rendir sólo los módulos que faltan.',
          rows: [
            { k: 'Lesen — comprensión de lectura', ref: mods[0].v >= 60 ? 'aprobado' : 'por debajo de 60', v: mods[0].v, ...PTS },
            { k: 'Hören — comprensión auditiva', ref: mods[1].v >= 60 ? 'aprobado' : 'por debajo de 60', v: mods[1].v, ...PTS },
            { k: 'Schreiben — expresión escrita', ref: mods[2].v >= 60 ? 'aprobado' : 'por debajo de 60', v: mods[2].v, ...PTS },
            { k: 'Sprechen — expresión oral', ref: mods[3].v >= 60 ? 'aprobado' : 'por debajo de 60', v: mods[3].v, ...PTS },
            { k: 'Módulos aprobados', ref: 'hacen falta los 4 para el certificado completo', v: 4 - reprobados.length, extra: true, ...PTS },
            { k: 'Promedio de los cuatro módulos', ref: 'referencia: no compensa módulos', v: prom, extra: true, format: 'plain', decimals: 1 },
            { k: 'Puntos que le faltan a tu módulo más flojo (' + debil.n + ')', ref: 'hasta 60', v: Math.max(0, 60 - debil.v), ...PTS },
          ],
          format: 'plain', decimals: 0,
          chart: [
            { label: 'No aprobado', value: 60, from: 0, to: 60, tone: 'bad' },
            { label: 'Ausreichend', value: 10, from: 60, to: 70, tone: 'warn' },
            { label: 'Befriedigend', value: 10, from: 70, to: 80, tone: 'good' },
            { label: 'Gut', value: 10, from: 80, to: 90, tone: 'good' },
            { label: 'Sehr gut', value: 10, from: 90, to: 100, tone: 'main' },
          ],
          position: clamp(prom),
          positionLabel: 'Promedio ' + fmt(prom, 0) + '/100 — ' + (apto ? 'los 4 módulos aprobados' : reprobados.length + ' módulo(s) pendiente(s)'),
        };
      }

      // ---- 5) DELE ------------------------------------------------------
      if (id === 'dele') {
        const g1 = Math.max(0, Math.min(25, num(v.dele1, 0)));
        const g2 = Math.max(0, Math.min(25, num(v.dele2, 0)));
        const total = g1 + g2;
        const okTotal = total >= 30;
        const ok1 = g1 >= 15;
        const ok2 = g2 >= 15;
        const apto = okTotal && ok1 && ok2;
        const motivos = [];
        if (!okTotal) motivos.push('el total ' + fmt(total) + ' no llega a 30');
        if (!ok1) motivos.push('el Grupo 1 ' + fmt(g1) + ' no llega a 15');
        if (!ok2) motivos.push('el Grupo 2 ' + fmt(g2) + ' no llega a 15');
        return {
          total: fmt(total) + '/50',
          sub:
            (apto
              ? 'APTO: llegás a los 30 puntos del total y a los 15 mínimos en cada grupo.'
              : 'NO APTO: ' + motivos.join(' y ') + '.') +
            ' El DELE exige las dos condiciones al mismo tiempo: no hay compensación entre grupos.',
          rows: [
            { k: 'Grupo 1 — lectura + expresión escrita', ref: ok1 ? 'supera el mínimo de 15' : 'por debajo del mínimo de 15', v: g1, ...BAND },
            { k: 'Grupo 2 — auditiva + expresión oral', ref: ok2 ? 'supera el mínimo de 15' : 'por debajo del mínimo de 15', v: g2, ...BAND },
            { k: 'Total sobre 50', ref: okTotal ? 'supera el mínimo de 30' : 'por debajo del mínimo de 30', v: total, extra: true, ...BAND },
            { k: 'Puntos que faltan para el total de 30', v: Math.max(0, 30 - total), extra: !okTotal, ...BAND },
            { k: 'Puntos que le faltan al Grupo 1', ref: 'hasta 15', v: Math.max(0, 15 - g1), ...BAND },
            { k: 'Puntos que le faltan al Grupo 2', ref: 'hasta 15', v: Math.max(0, 15 - g2), ...BAND },
            { k: 'Condiciones cumplidas', ref: 'de 3: total, Grupo 1 y Grupo 2', v: (okTotal ? 1 : 0) + (ok1 ? 1 : 0) + (ok2 ? 1 : 0), extra: true, ...PTS },
          ],
          format: 'plain', decimals: 1,
          chart: [
            { label: 'No apto', value: 30, from: 0, to: 30, tone: 'bad' },
            { label: 'Apto', value: 20, from: 30, to: 50, tone: 'good' },
          ],
          position: pos(total, 0, 50),
          positionLabel: fmt(total) + '/50 — ' + (apto ? 'apto' : 'no apto'),
        };
      }

      // ---- 6) Horas de preparación (SAT / GRE) --------------------------
      if (id === 'horas') {
        const hsem = Math.max(1, num(v.horasSemana, 10));
        const cual = String(v.examenPrep || 'sat');
        let horas = 0, filas = [], detalle = '';

        if (cual === 'sat') {
          const ac = Math.max(400, Math.min(1600, num(v.satScore, 0)));
          const obj = Math.max(400, Math.min(1600, num(v.satObjetivo, 0)));
          if (obj <= ac) return err('El objetivo del SAT tiene que ser mayor que tu puntaje actual.', 'Diferencia objetivo − actual', obj - ac);
          const gap = obj - ac;
          const hxp = obj > 1550 ? 1.0 : obj > 1500 ? 0.8 : obj > 1400 ? 0.6 : 0.4;
          horas = gap * hxp * (ac < 1000 ? 1.3 : 1);
          detalle = 'SAT de ' + ac + ' a ' + obj + ': ' + gap + ' puntos a ' + fmt(hxp, 1) + ' h por punto' + (ac < 1000 ? ', con el recargo del 30% por arrancar debajo de 1000' : '');
          filas = [
            { k: 'Puntaje actual', v: ac, ...PTS },
            { k: 'Puntaje objetivo', v: obj, ...PTS },
            { k: 'Brecha a cubrir', ref: 'objetivo − actual', v: gap, ...PTS },
            { k: 'Horas por punto según el objetivo', ref: '0,4 hasta 1400 · 0,6 · 0,8 · 1,0 arriba de 1550', v: hxp, format: 'unit', unit: 'h/punto', decimals: 1 },
          ];
          if (ac < 1000) filas.push({ k: 'Recargo por base menor a 1000', ref: 'multiplica por 1,3', v: horas - gap * hxp, ...HS });
        } else {
          const vA = Math.max(130, Math.min(170, num(v.greVerbalActual, 0)));
          const vO = Math.max(130, Math.min(170, num(v.greVerbalObjetivo, 0)));
          const qA = Math.max(130, Math.min(170, num(v.greQuantActual, 0)));
          const qO = Math.max(130, Math.min(170, num(v.greQuantObjetivo, 0)));
          if (vO < vA || qO < qA) return err('Los objetivos del GRE tienen que ser mayores o iguales a tus puntajes actuales.', 'Diferencia Verbal + Quant', (vO - vA) + (qO - qA));
          const hxpV = vA < 150 ? 8 : vA < 155 ? 10 : vA < 160 ? 13 : vA < 165 ? 16 : 20;
          const hxpQ = qA < 150 ? 7 : qA < 155 ? 9 : qA < 160 ? 11 : qA < 165 ? 14 : 18;
          const hV = (vO - vA) * hxpV;
          const hQ = (qO - qA) * hxpQ;
          horas = hV + hQ;
          const totObj = vO + qO;
          detalle =
            'GRE Verbal ' + vA + '→' + vO + ' y Quant ' + qA + '→' + qO + ' (total objetivo ' + totObj + '). ' +
            (totObj >= 330 ? 'Score de elite: vas a necesitar feedback profesional.' : totObj >= 320 ? 'Rango de universidades top: 6 meses o más.' : totObj >= 310 ? 'Programas de nivel medio: 3 a 5 meses sostenidos.' : 'Programas estatales: alcanzable en 2 a 3 meses.');
          filas = [
            { k: 'Verbal — actual a objetivo', ref: vA + ' → ' + vO, v: vO - vA, ...PTS },
            { k: 'Horas por punto en Verbal', ref: 'según tu base', v: hxpV, format: 'unit', unit: 'h/punto', decimals: 0 },
            { k: 'Horas de Verbal', v: hV, extra: true, ...HS },
            { k: 'Quant — actual a objetivo', ref: qA + ' → ' + qO, v: qO - qA, ...PTS },
            { k: 'Horas por punto en Quant', ref: 'según tu base', v: hxpQ, format: 'unit', unit: 'h/punto', decimals: 0 },
            { k: 'Horas de Quant', v: hQ, extra: true, ...HS },
          ];
        }

        const semanas = horas / hsem;
        const meses = Math.round((semanas / 4.33) * 10) / 10;
        const lectura = meses < 1 ? 'Plazo agresivo: sólo cierra estudiando casi full time.' : meses < 3 ? 'Plazo realista si sostenés la disciplina.' : meses < 6 ? 'Plan sostenible.' : 'Plan largo: conviene bajar el objetivo o subir las horas semanales.';
        const tope = Math.max(8, Math.ceil(meses) + 1);
        filas = filas.concat([
          { k: 'Horas totales de estudio', v: horas, extra: true, ...HS },
          { k: 'Horas por semana que podés poner', v: hsem, ...HS },
          { k: 'Semanas de preparación', ref: 'horas ÷ horas por semana', v: semanas, ...SEM },
          { k: 'Meses de preparación', ref: 'semanas ÷ 4,33', v: meses, extra: true, ...MES },
        ]);
        return {
          total: fmt(horas, 0) + ' h',
          sub: detalle + ' A ' + fmt(hsem, 0) + ' h por semana son ' + fmt(semanas, 0) + ' semanas, o sea ' + fmt(meses, 1) + ' meses. ' + lectura,
          rows: filas,
          format: 'plain', decimals: 0,
          chart: [
            { label: 'Agresivo', value: 1, from: 0, to: 1, tone: 'bad' },
            { label: 'Realista', value: 2, from: 1, to: 3, tone: 'good' },
            { label: 'Sostenible', value: 3, from: 3, to: 6, tone: 'main' },
            { label: 'Largo', value: tope - 6, from: 6, to: tope, tone: 'warn' },
          ],
          position: pos(meses, 0, tope),
          positionLabel: fmt(meses, 1) + ' meses de preparación — ' + lectura,
        };
      }

      // ---- 7) Costo y vigencia ------------------------------------------
      const anios = Math.max(1, Math.min(15, num(v.aniosVigencia, 4)));
      const obj = String(v.objetivoExamen || 'cualquiera');
      const rendidasBianual = Math.ceil(anios / 2);
      const EX = {
        ielts: { nombre: 'IELTS Academic', precio: Math.max(0, num(v.precioIelts, 0)), veces: rendidasBianual, vig: '2 años' },
        toefl: { nombre: 'TOEFL iBT', precio: Math.max(0, num(v.precioToefl, 0)), veces: rendidasBianual, vig: '2 años' },
        cae: { nombre: 'C1 Advanced (CAE)', precio: Math.max(0, num(v.precioCae, 0)), veces: 1, vig: 'sin vencimiento' },
      };
      Object.keys(EX).forEach(function (k) {
        EX[k].total = EX[k].precio * EX[k].veces;
        EX[k].porAnio = EX[k].total / anios;
      });

      const CANDIDATOS = {
        visa_uk: ['ielts'],
        universidad_uk: ['ielts', 'cae', 'toefl'],
        universidad_usa: ['toefl', 'ielts', 'cae'],
        trabajo: ['ielts', 'toefl', 'cae'],
        cualquiera: ['ielts', 'toefl', 'cae'],
      };
      const NOTA_OBJ = {
        visa_uk: 'Para trámites migratorios del Reino Unido sólo valen los exámenes de la lista SELT aprobada por el Home Office: ni el TOEFL ni los Cambridge generales sirven, por más barato que salgan.',
        universidad_uk: 'Reino Unido, Irlanda y Australia aceptan los tres; el C1 Advanced es el único que no vence.',
        universidad_usa: 'En EE.UU. y Canadá el TOEFL es el más pedido, pero el IELTS Academic se acepta casi en todos lados y el C1 Advanced en miles de instituciones.',
        trabajo: 'Para acreditación profesional confirmá qué examen acepta tu colegio u organismo antes de mirar el precio: la lista suele ser corta.',
        cualquiera: 'Sin destino definido, el IELTS Academic es el de mayor cobertura; si el horizonte es largo, el C1 Advanced amortiza mejor.',
      };
      const lista = CANDIDATOS[obj] || CANDIDATOS.cualquiera;
      let elegido = lista[0];
      lista.forEach(function (k) {
        if (EX[k].total < EX[elegido].total) elegido = k;
      });
      const info = EX[elegido];
      const totales = Object.keys(EX).map(function (k) { return EX[k].total; }).sort(function (a, b) { return a - b; });
      const maxTotal = Math.max(1, totales[2]);
      const ahorro = Math.max.apply(null, lista.map(function (k) { return EX[k].total; })) - info.total;

      return {
        total: 'USD ' + fmt(info.total, 0),
        sub:
          'Para un horizonte de ' + fmt(anios, 0) + ' año(s), la opción más barata entre las que sirven para tu objetivo es el ' + info.nombre +
          ': ' + info.veces + ' rendición(es) × USD ' + fmt(info.precio, 0) + ' = USD ' + fmt(info.total, 0) +
          ' (USD ' + fmt(info.porAnio, 0) + ' por año de vigencia). ' +
          (ahorro > 0 ? 'Te ahorra hasta USD ' + fmt(ahorro, 0) + ' frente a la alternativa más cara. ' : '') + (NOTA_OBJ[obj] || ''),
        rows: [
          { k: 'IELTS Academic — costo total del horizonte (USD)', ref: fmt(EX.ielts.veces, 0) + ' rendición(es), vigencia 2 años', v: EX.ielts.total, extra: elegido === 'ielts', ...USD },
          { k: 'TOEFL iBT — costo total del horizonte (USD)', ref: fmt(EX.toefl.veces, 0) + ' rendición(es), vigencia 2 años', v: EX.toefl.total, extra: elegido === 'toefl', ...USD },
          { k: 'C1 Advanced (CAE) — costo total del horizonte (USD)', ref: '1 rendición, el certificado no vence', v: EX.cae.total, extra: elegido === 'cae', ...USD },
          { k: 'Veces que hay que rendir un examen con vigencia de 2 años', ref: 'años ÷ 2, redondeado hacia arriba', v: rendidasBianual, ...VECES },
          { k: 'Costo por año de vigencia — IELTS (USD)', v: EX.ielts.porAnio, ...USD },
          { k: 'Costo por año de vigencia — TOEFL (USD)', v: EX.toefl.porAnio, ...USD },
          { k: 'Costo por año de vigencia — C1 Advanced (USD)', v: EX.cae.porAnio, ...USD },
          { k: 'Diferencia contra la alternativa más cara de tu objetivo (USD)', ref: 'lo que te ahorra la recomendación', v: ahorro, extra: true, ...USD },
        ],
        format: 'plain', decimals: 0,
        chart: [
          { label: 'Más barato — USD ' + fmt(totales[0], 0), value: totales[0], from: 0, to: Math.max(1, totales[0]), tone: 'good' },
          { label: 'Intermedio — USD ' + fmt(totales[1], 0), value: totales[1] - totales[0], from: Math.max(1, totales[0]), to: Math.max(2, totales[1]), tone: 'warn' },
          { label: 'Más caro — USD ' + fmt(totales[2], 0), value: totales[2] - totales[1], from: Math.max(2, totales[1]), to: Math.max(3, totales[2]), tone: 'bad' },
        ],
        position: pos(info.total, 0, maxTotal),
        positionLabel: info.nombre + ' — USD ' + fmt(info.total, 0) + ' en ' + fmt(anios, 0) + ' año(s)',
      };
    });
  })();
</script>
