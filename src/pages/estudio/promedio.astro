---
/**
 * Hub de decisión — "¿Cuál es mi promedio?"
 * Reemplaza 11 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de matematica/porcentajes.astro: la página sólo aporta los
 * datos (src/lib/hubs/promedio.ts) y su compute(). El chrome, el CSS y el
 * runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PromedioEstudioExperience from '../../components/generated/PromedioEstudioExperience.astro';
import { hub } from '../../lib/hubs/promedio';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PromedioEstudioExperience data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * Ninguna rama es plata y el default de HubRow es 'ars': TODA fila declara
     * su formato. Notas y cantidades en 'plain'; porcentajes, clases, créditos
     * y puntos de GPA en 'unit'.
     */
    const NOTA = { format: 'plain', decimals: 2 };
    const CANT = { format: 'plain', decimals: 0 };
    const PCT = { format: 'unit', unit: '%', decimals: 2 };
    const CLASES = { format: 'unit', unit: 'clases', decimals: 0 };
    const CRED = { format: 'unit', unit: 'créditos', decimals: 0 };
    const PTS = { format: 'unit', unit: 'pts', decimals: 2 };

    const fmt = (n, d) => {
      if (!isFinite(n)) return '—';
      const dec = d == null ? 2 : d;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };
    const clamp = (n) => Math.max(0, Math.min(100, isFinite(n) ? n : 0));
    /** Posición 0-100 de un valor dentro de la escala [min, max] del gráfico. */
    const pos = (val, min, max) => clamp(((val - min) / (max - min)) * 100);

    /**
     * Lista de números. Separadores: espacio y punto y coma. La coma queda
     * reservada al decimal rioplatense ("7,5" → 7.5), igual que en la fórmula
     * original de promedio-notas-universidad.
     */
    function lista(str) {
      return String(str == null ? '' : str)
        .split(/[;\s]+/)
        .filter(function (s) { return s !== ''; })
        .map(function (s) { return parseFloat(s.replace(',', '.')); })
        .filter(function (n) { return !isNaN(n); });
    }

    const err = (msg, k, v) => ({
      total: '—', sub: msg,
      rows: [{ k: k, v: v, ...NOTA }],
      chart: [], format: 'plain', decimals: 2, position: 0, positionLabel: msg,
    });

    /** Bandas de la escala de notas 0-10 usada por casi todas las ramas. */
    const BANDAS_NOTA = [
      { label: 'Desaprobado', value: 4, from: 0, to: 4, tone: 'bad' },
      { label: 'Aprobado', value: 2, from: 4, to: 6, tone: 'warn' },
      { label: 'Bueno', value: 2, from: 6, to: 8, tone: 'good' },
      { label: 'Distinguido', value: 2, from: 8, to: 10, tone: 'main' },
    ];

    /** Nota 0-10 → puntos GPA por la tabla de letras estadounidense. */
    function gpaTabla(nota100) {
      const T = [
        [93, 4.0, 'A'], [90, 3.7, 'A-'], [87, 3.3, 'B+'], [83, 3.0, 'B'],
        [80, 2.7, 'B-'], [77, 2.3, 'C+'], [73, 2.0, 'C'], [70, 1.7, 'C-'],
        [67, 1.3, 'D+'], [63, 1.0, 'D'], [60, 0.7, 'D-'],
      ];
      for (let i = 0; i < T.length; i++) {
        if (nota100 >= T[i][0]) return { gpa: T[i][1], letra: T[i][2] };
      }
      return { gpa: 0, letra: 'F' };
    }

    /** Umbrales de promedio por programa de beca. */
    const BECAS = {
      progresar: { min: 0, nombre: 'Progresar (ANSES)', nota: 'No exige promedio mínimo: pide regularidad (2+ materias por año) y tope de ingreso familiar.' },
      uba_excelencia: { min: 7, nombre: 'UBA Excelencia Académica', nota: 'Además del promedio pide 6+ materias aprobadas en el último año. Sólo UBA.' },
      conicet: { min: 7.5, nombre: 'CONICET doctoral', nota: 'Además pide plan de investigación aprobado y director asignado.' },
      santander: { min: 6, nombre: 'Santander Universidades', nota: 'Además pide regularidad y 50%+ de las materias al día.' },
      privada: { min: 8, nombre: 'Beca académica de universidad privada', nota: 'El umbral varía por institución; 8 es el valor de referencia más común.' },
      deportiva: { min: 5, nombre: 'Beca deportiva', nota: 'Además hay que acreditar nivel competitivo en el deporte.' },
    };

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'simple';
      const notas = lista(v.notas);
      const n = notas.length;
      const suma = notas.reduce(function (a, b) { return a + b; }, 0);
      const prom = n ? suma / n : 0;

      // ---- 1) Promedio simple ------------------------------------------
      if (id === 'simple') {
        if (!n) return err('Cargá al menos una nota en el campo "Tus notas".', 'Notas cargadas', 0);
        const alta = Math.max.apply(null, notas);
        const baja = Math.min.apply(null, notas);
        const bajo4 = notas.filter(function (x) { return x < 4; }).length;
        const bajo6 = notas.filter(function (x) { return x < 6; }).length;
        return {
          total: fmt(prom),
          sub:
            'Promedio de ' + n + ' nota(s): ' + fmt(suma, 2) + ' ÷ ' + n + ' = ' + fmt(prom) +
            ' · nota más alta ' + fmt(alta, 2) + ', más baja ' + fmt(baja, 2),
          rows: [
            { k: 'Cantidad de notas', v: n, ...CANT },
            { k: 'Suma de todas las notas', ref: 'paso 1', v: suma, ...NOTA },
            { k: 'Suma ÷ cantidad → promedio', ref: 'paso 2: el despeje', v: prom, extra: true, ...NOTA },
            { k: 'Nota más alta', v: alta, ...NOTA },
            { k: 'Nota más baja', v: baja, ...NOTA },
            { k: 'Notas por debajo de 4', ref: 'piso universitario', v: bajo4, ...CANT },
            { k: 'Notas por debajo de 6', ref: 'piso de secundaria', v: bajo6, ...CANT },
          ],
          format: 'plain', decimals: 2,
          chart: BANDAS_NOTA,
          position: pos(prom, 0, 10),
          positionLabel: 'Promedio ' + fmt(prom) + ' sobre 10',
        };
      }

      // ---- 2) Promedio ponderado ---------------------------------------
      if (id === 'ponderado') {
        const pesos = lista(v.pesos);
        if (!n) return err('Cargá al menos una nota en el campo "Tus notas".', 'Notas cargadas', 0);
        if (pesos.length !== n) {
          return err(
            'Tenés ' + n + ' nota(s) y ' + pesos.length + ' peso(s): la cuenta necesita la misma cantidad de las dos cosas.',
            'Diferencia notas − pesos', n - pesos.length
          );
        }
        const totalPesos = pesos.reduce(function (a, b) { return a + b; }, 0);
        if (!totalPesos) return err('La suma de los pesos no puede ser 0.', 'Suma de los pesos', 0);
        const sumaPond = notas.reduce(function (acc, nota, i) { return acc + nota * pesos[i]; }, 0);
        const pond = sumaPond / totalPesos;
        const dif = pond - prom;
        return {
          total: fmt(pond),
          sub:
            'Ponderado ' + fmt(pond) + ' sobre ' + fmt(totalPesos, 0) + ' créditos en ' + n + ' materia(s) · ' +
            (Math.abs(dif) < 0.005
              ? 'los pesos no lo mueven respecto del promedio simple (' + fmt(prom) + ')'
              : (dif > 0 ? 'te sube ' : 'te baja ') + fmt(Math.abs(dif)) + ' respecto del promedio simple (' + fmt(prom) + ')'),
          rows: [
            { k: 'Cantidad de materias', v: n, ...CANT },
            { k: 'Σ (nota × peso)', ref: 'paso 1', v: sumaPond, ...NOTA },
            { k: 'Σ pesos', ref: 'paso 2', v: totalPesos, ...CRED },
            { k: 'Σ(nota × peso) ÷ Σ pesos → ponderado', ref: 'paso 3: el despeje', v: pond, extra: true, ...NOTA },
            { k: 'Promedio simple, para comparar', ref: 'sin ponderar', v: prom, ...NOTA },
            { k: 'Cuánto te movió la ponderación', v: dif, ...NOTA },
          ],
          format: 'plain', decimals: 2,
          chart: BANDAS_NOTA,
          position: pos(pond, 0, 10),
          positionLabel: 'Ponderado ' + fmt(pond) + ' sobre 10',
        };
      }

      // ---- 3) Nota final de la materia ---------------------------------
      if (id === 'final') {
        const cursada = Number(v.cursada) || 0;
        const examen = Number(v.examen) || 0;
        const pe = Math.max(0, Math.min(100, Number(v.pesoExamen) || 0));
        const pc = 100 - pe;
        const aporteC = (cursada * pc) / 100;
        const aporteE = (examen * pe) / 100;
        const nota = aporteC + aporteE;
        const aprobado = examen >= 4;
        return {
          total: fmt(nota, 1),
          sub:
            (aprobado
              ? 'Cerrás la materia con ' + fmt(nota, 1) + '. '
              : '⚠ El examen dio ' + fmt(examen, 1) + ' (menos de 4): la materia queda desaprobada aunque el promedio dé ' + fmt(nota, 1) + '. ') +
            'Reparto: ' + fmt(pc, 0) + '% cursada y ' + fmt(pe, 0) + '% final.',
          rows: [
            { k: 'Promedio de la cursada', v: cursada, ...NOTA },
            { k: 'Peso de la cursada', ref: '100 − peso del final', v: pc, ...PCT },
            { k: 'Cursada × su peso → aporte', ref: 'paso 1', v: aporteC, ...NOTA },
            { k: 'Nota del examen final', v: examen, ...NOTA },
            { k: 'Peso del examen final', v: pe, ...PCT },
            { k: 'Final × su peso → aporte', ref: 'paso 2', v: aporteE, ...NOTA },
            { k: 'Suma de los dos aportes → nota final', ref: 'paso 3', v: nota, extra: true, ...NOTA },
          ],
          format: 'plain', decimals: 2,
          chart: BANDAS_NOTA,
          position: pos(nota, 0, 10),
          positionLabel: 'Nota final ' + fmt(nota, 1) + (aprobado ? ' — aprobada' : ' — desaprobada por el final'),
        };
      }

      // ---- 4) Asistencia y faltas --------------------------------------
      if (id === 'asistencia') {
        const totales = Math.max(1, Number(v.clasesTotales) || 0);
        const asistidas = Math.max(0, Math.min(totales, Number(v.clasesAsistidas) || 0));
        const minimo = Math.max(1, Math.min(100, Number(v.minAsist) || 0));
        const faltasUsadas = totales - asistidas;
        const clasesMinimas = Math.ceil(totales * (minimo / 100));
        const faltasMaximas = totales - clasesMinimas;
        const disponibles = Math.max(0, faltasMaximas - faltasUsadas);
        const pct = (asistidas / totales) * 100;
        const ok = pct >= minimo;
        return {
          total: fmt(pct) + '%',
          sub:
            ok
              ? (disponibles === 0
                ? 'Estás justo en el límite: la próxima falta te deja libre.'
                : 'Dentro del mínimo. Te quedan ' + disponibles + ' falta(s) disponibles.')
              : 'Quedaste por debajo del ' + fmt(minimo, 0) + '%: te faltaron ' + (faltasUsadas - faltasMaximas) + ' clase(s) de más.',
          rows: [
            { k: 'Clases totales', v: totales, ...CLASES },
            { k: 'Clases a las que fuiste', v: asistidas, ...CLASES },
            { k: 'Faltas ya usadas', ref: 'total − asistidas', v: faltasUsadas, ...CLASES },
            { k: 'Clases mínimas exigidas', ref: 'total × ' + fmt(minimo, 0) + '%, redondeado hacia arriba', v: clasesMinimas, ...CLASES },
            { k: 'Faltas máximas permitidas', ref: 'total − mínimas', v: faltasMaximas, ...CLASES },
            { k: 'Faltas que te quedan', ref: 'máximas − usadas', v: disponibles, extra: true, ...CLASES },
            { k: 'Tu asistencia actual', v: pct, extra: true, ...PCT },
          ],
          format: 'plain', decimals: 2,
          chart: [
            { label: 'Por debajo del mínimo', value: minimo, from: 0, to: Math.round(minimo), tone: 'bad' },
            { label: 'Dentro del mínimo', value: 100 - minimo, from: Math.round(minimo), to: 100, tone: 'good' },
          ],
          position: clamp(pct),
          positionLabel: 'Asistencia ' + fmt(pct) + '% sobre un mínimo de ' + fmt(minimo, 0) + '%',
        };
      }

      // ---- 5) GPA 4.0 ---------------------------------------------------
      if (id === 'gpa') {
        if (!n) return err('Cargá al menos una nota en el campo "Tus notas".', 'Notas cargadas', 0);
        const nota100 = prom * 10;
        const tabla = gpaTabla(nota100);
        const linealDirecto = Math.max(0, Math.min(4, (prom / 10) * 4));
        const linealDesde1 = Math.max(0, Math.min(4, ((prom - 1) * 4) / 9));
        return {
          total: fmt(tabla.gpa, 2),
          sub:
            'Promedio ' + fmt(prom) + '/10 = ' + fmt(nota100, 0) + '/100 = letra ' + tabla.letra +
            ' = GPA ' + fmt(tabla.gpa, 2) + '/4,0 · los métodos lineales darían ' +
            fmt(linealDirecto, 2) + ' y ' + fmt(linealDesde1, 2),
          rows: [
            { k: 'Tu promedio en escala argentina', ref: 'de las notas cargadas', v: prom, ...NOTA },
            { k: 'Pasado a escala 100', ref: 'paso 1: × 10', v: nota100, ...NOTA },
            { k: 'Método 1 — tabla de letras (' + tabla.letra + ')', ref: 'el que usan las universidades de EE.UU.', v: tabla.gpa, extra: true, ...PTS },
            { k: 'Método 2 — lineal directo', ref: 'nota ÷ 10 × 4', v: linealDirecto, ...PTS },
            { k: 'Método 3 — lineal desde 1', ref: '(nota − 1) × 4 ÷ 9', v: linealDesde1, ...PTS },
            { k: 'Diferencia entre el método más alto y el más bajo', ref: 'por eso no hay conversión única', v: Math.max(tabla.gpa, linealDirecto, linealDesde1) - Math.min(tabla.gpa, linealDirecto, linealDesde1), ...PTS },
          ],
          format: 'plain', decimals: 2,
          chart: [
            { label: 'D / F', value: 2, from: 0, to: 2, tone: 'bad' },
            { label: 'C', value: 1, from: 2, to: 3, tone: 'warn' },
            { label: 'B — good standing', value: 0.7, from: 3, to: 3.7, tone: 'good' },
            { label: 'A — honors', value: 0.3, from: 3.7, to: 4, tone: 'main' },
          ],
          position: pos(tabla.gpa, 0, 4),
          positionLabel: 'GPA ' + fmt(tabla.gpa, 2) + '/4,0 — letra ' + tabla.letra,
        };
      }

      // ---- 6) Promedio de la beca --------------------------------------
      if (id === 'beca') {
        if (!n) return err('Cargá al menos una nota en el campo "Tus notas".', 'Notas cargadas', 0);
        const beca = BECAS[v.beca] || BECAS.progresar;
        const dif = prom - beca.min;
        const llega = dif >= 0;
        return {
          total: fmt(prom),
          sub:
            beca.min === 0
              ? beca.nombre + ' no exige promedio mínimo. Tu promedio es ' + fmt(prom) + '. ' + beca.nota
              : (llega
                  ? 'Llegás: tu ' + fmt(prom) + ' supera el mínimo de ' + fmt(beca.min, 1) + ' por ' + fmt(dif) + ' puntos.'
                  : 'Te faltan ' + fmt(Math.abs(dif)) + ' puntos para el mínimo de ' + fmt(beca.min, 1) + '.') +
                ' ' + beca.nota,
          rows: [
            { k: 'Tu promedio', ref: 'de las notas cargadas', v: prom, extra: true, ...NOTA },
            { k: 'Promedio mínimo — ' + beca.nombre, v: beca.min, ...NOTA },
            { k: llega ? 'Puntos que te sobran' : 'Puntos que te faltan', v: Math.abs(dif), extra: true, ...NOTA },
            { k: 'Materias que promediaste', v: n, ...CANT },
          ],
          format: 'plain', decimals: 2,
          chart: beca.min > 0
            ? [
                { label: 'Por debajo del mínimo', value: beca.min, from: 0, to: beca.min, tone: 'bad' },
                { label: 'Cumple el mínimo', value: 10 - beca.min, from: beca.min, to: 10, tone: 'good' },
              ]
            : [{ label: 'Sin mínimo de promedio', value: 10, from: 0, to: 10, tone: 'good' }],
          position: pos(prom, 0, 10),
          positionLabel: 'Promedio ' + fmt(prom) + (beca.min > 0 ? ' sobre un mínimo de ' + fmt(beca.min, 1) : ' — esta beca no exige promedio'),
        };
      }

      // ---- 7) Estadística descriptiva ----------------------------------
      if (!n) return err('Cargá al menos un número en el campo "Tus notas".', 'Datos cargados', 0);
      const ord = notas.slice().sort(function (a, b) { return a - b; });
      const mediana = n % 2 === 0 ? (ord[n / 2 - 1] + ord[n / 2]) / 2 : ord[Math.floor(n / 2)];
      const freq = {};
      notas.forEach(function (x) { freq[x] = (freq[x] || 0) + 1; });
      const maxFreq = Math.max.apply(null, Object.keys(freq).map(function (k) { return freq[k]; }));
      const modas = Object.keys(freq).filter(function (k) { return freq[k] === maxFreq; });
      const modaTxt = maxFreq === 1 ? 'sin moda (todos únicos)' : modas.join(', ');
      const minimo = ord[0];
      const maximo = ord[n - 1];
      const rango = maximo - minimo;
      const varianza = notas.reduce(function (acc, x) { return acc + Math.pow(x - prom, 2); }, 0) / n;
      const desvio = Math.sqrt(varianza);
      const diff = prom - mediana;
      const sesgo = Math.abs(diff) < 1e-9
        ? 'promedio y mediana coinciden: los datos están repartidos de forma simétrica'
        : diff > 0
          ? 'el promedio queda por encima de la mediana: hay valores altos que lo estiran hacia arriba'
          : 'el promedio queda por debajo de la mediana: hay valores bajos que lo tiran hacia abajo';
      return {
        total: fmt(prom),
        sub: 'Sobre ' + n + ' dato(s), ' + sesgo + '. Moda: ' + modaTxt + ' · desvío estándar: ' + fmt(desvio),
        rows: [
          { k: 'Cantidad de datos (n)', v: n, ...CANT },
          { k: 'Suma', v: suma, ...NOTA },
          { k: 'Promedio (media) = suma ÷ n', v: prom, extra: true, ...NOTA },
          { k: 'Mediana — el valor del medio ordenando', v: mediana, extra: true, ...NOTA },
          { k: 'Moda: ' + modaTxt, ref: 'se repite ' + maxFreq + ' vez/veces', v: maxFreq, ...CANT },
          { k: 'Mínimo', v: minimo, ...NOTA },
          { k: 'Máximo', v: maximo, ...NOTA },
          { k: 'Rango = máximo − mínimo', v: rango, ...NOTA },
          { k: 'Varianza poblacional', ref: 'media de los cuadrados de las distancias', v: varianza, format: 'plain', decimals: 4 },
          { k: 'Desvío estándar poblacional', ref: 'raíz de la varianza', v: desvio, format: 'plain', decimals: 4 },
        ],
        format: 'plain', decimals: 2,
        chart: [
          { label: 'Tercio bajo', value: rango / 3, from: minimo, to: minimo + rango / 3, tone: 'bad' },
          { label: 'Tercio medio', value: rango / 3, from: minimo + rango / 3, to: minimo + (2 * rango) / 3, tone: 'warn' },
          { label: 'Tercio alto', value: rango / 3, from: minimo + (2 * rango) / 3, to: maximo, tone: 'good' },
        ],
        position: rango ? pos(prom, minimo, maximo) : 50,
        positionLabel: 'Promedio ' + fmt(prom) + ' dentro del rango ' + fmt(minimo, 2) + ' a ' + fmt(maximo, 2),
      };
    });
  })();
</script>
