---
/**
 * Hub de decisión — "¿Cuánto tardo en leer esto?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Sigue el patrón de estudio/promedio.astro: la página sólo aporta los datos
 * (src/lib/hubs/cuanto-tardo-en-leer.ts) y su compute(). El chrome, el CSS y el
 * runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub } from '../../lib/hubs/cuanto-tardo-en-leer';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    const H = window.HC_HUB;

    /**
     * Ninguna rama es plata y el default de HubRow es 'ars': TODA fila declara
     * su formato.
     */
    const MIN = { format: 'unit', unit: 'minutos', decimals: 0 };
    const HS = { format: 'unit', unit: 'horas', decimals: 1 };
    const PAG = { format: 'unit', unit: 'páginas', decimals: 0 };
    const PAL = { format: 'unit', unit: 'palabras', decimals: 0 };
    const PPM = { format: 'unit', unit: 'PPM', decimals: 0 };
    const PPM1 = { format: 'unit', unit: 'PPM', decimals: 1 };
    const PCT = { format: 'unit', unit: '%', decimals: 0 };
    const CANT = { format: 'plain', decimals: 0 };
    const FACT = { format: 'plain', decimals: 2 };

    const fmt = (n, d) => {
      if (!isFinite(n)) return '—';
      const dec = d == null ? 1 : d;
      return Number(n.toFixed(dec)).toLocaleString('es-AR', { maximumFractionDigits: dec });
    };
    const clamp = (n) => Math.max(0, Math.min(100, isFinite(n) ? n : 0));
    /** Posición 0-100 dentro de la escala de PPM del gráfico (0 a 700). */
    const posPPM = (v) => clamp((v / 700) * 100);

    /** minutos → "6 h 24 min" */
    function hhmm(totalMin) {
      if (!isFinite(totalMin) || totalMin < 0) return '—';
      const h = Math.floor(totalMin / 60);
      const m = Math.round(totalMin % 60);
      if (h === 0) return m + ' min';
      if (m === 0) return h + ' h';
      return h + ' h ' + m + ' min';
    }

    /**
     * Palabras por página. Las calculadoras absorbidas usaban 250, 270 y
     * 350–450 para lo mismo; acá el usuario elige y la constante deja de estar
     * escondida.
     */
    const WPP = { novela: 270, noficcion: 250, ebook: 245, a4: 350, manual: 400, paper: 450 };
    const WPP_LABEL = {
      novela: 'novela o ensayo', noficcion: 'autoayuda o negocios', ebook: 'eBook',
      a4: 'Word A4 12pt 1,5', manual: 'manual universitario', paper: 'paper a doble columna',
    };

    /**
     * Escala única de palabras por minuto. Unifica las dos escalas que traían
     * las calculadoras viejas (una cortaba el "promedio" en 250 y la otra en
     * 300) y la ancla en la mediana de 238 PPM de Brysbaert (2019). La franja
     * de arriba de 500 se marca como skimming: Rayner (2016) no encuentra
     * evidencia de comprensión sostenida por encima de ese umbral.
     */
    const BANDAS_PPM = [
      { label: 'Lenta', value: 180, from: 0, to: 180, tone: 'bad' },
      { label: 'Promedio (≈238)', value: 80, from: 180, to: 260, tone: 'good' },
      { label: 'Rápida', value: 90, from: 260, to: 350, tone: 'main' },
      { label: 'Muy rápida', value: 150, from: 350, to: 500, tone: 'main' },
      { label: 'Skimming', value: 200, from: 500, to: 700, tone: 'warn' },
    ];

    function clasificar(ppm) {
      if (ppm >= 500) return 'skimming: verificá comprensión';
      if (ppm >= 350) return 'muy rápida';
      if (ppm >= 260) return 'rápida';
      if (ppm >= 180) return 'promedio';
      return 'lenta';
    }

    /**
     * Factor "estudiar vs leer". Anclado en los defaults de las dos calcs
     * originales: leer material universitario iba a 6 min/página (10 pág/h) y
     * estudiarlo a 3 pág/h → 3,33×. Baja y alta se abren desde ahí.
     */
    const FACTOR_ESTUDIO = { baja: 2, media: 10 / 3, alta: 5 };
    /** Ajuste de rendimiento de estudio por dificultad (rama de examen). */
    const AJUSTE_DIF = { baja: 1.25, media: 1, alta: 0.7 };
    /** Ajuste del score de comprensión por dificultad del texto (fórmula original). */
    const FACTOR_COMPR = { baja: 0.9, media: 1.0, alta: 1.1 };

    /** MCER → palabras por minuto de referencia y reproducciones necesarias. */
    const MCER = {
      a1: { wpm: 75, rep: 5, repTxt: '4-5 reproducciones' },
      a2: { wpm: 95, rep: 4, repTxt: '3-4 reproducciones' },
      b1: { wpm: 115, rep: 3, repTxt: '2-3 reproducciones' },
      b2: { wpm: 145, rep: 2, repTxt: '2 reproducciones' },
      c1: { wpm: 175, rep: 2, repTxt: '1-2 reproducciones' },
      c2: { wpm: 200, rep: 1, repTxt: '1 reproducción' },
    };

    /** Rendimiento de traducción humana, en palabras por hora. */
    const TRAD = {
      general: { wph: 500, nombre: 'general' },
      tecnico: { wph: 400, nombre: 'técnico' },
      juridico: { wph: 300, nombre: 'jurídico' },
      literario: { wph: 200, nombre: 'literario' },
    };

    const err = (msg, k, v) => ({
      total: '—', sub: msg,
      rows: [{ k: k, v: v, ...CANT }],
      chart: BANDAS_PPM, format: 'plain', decimals: 1, position: 0, positionLabel: msg,
    });

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'libro';

      const wppKey = WPP[v.tipoPagina] ? v.tipoPagina : 'novela';
      const wpp = WPP[wppKey];
      const paginas = Math.max(0, Number(v.paginas) || 0);
      const palabrasCargadas = Math.max(0, Number(v.palabras) || 0);
      const ppm = Math.max(1, Number(v.ppm) || 250);
      const dif = FACTOR_ESTUDIO[v.dificultad] ? v.dificultad : 'media';

      // ---- 1) Cuánto tardo en leer un libro ----------------------------
      if (id === 'libro') {
        const estimado = palabrasCargadas <= 0;
        const palabras = estimado ? paginas * wpp : palabrasCargadas;
        if (palabras <= 0) return err('Cargá las palabras del texto, o las páginas para estimarlas.', 'Palabras', 0);

        // Fórmula original: minutos = palabras ÷ PPM
        const minutos = palabras / ppm;
        const horas = minutos / 60;
        const sesiones30 = Math.ceil(minutos / 30);
        const semanas = Math.ceil(sesiones30 / 7);
        const rows = [];
        if (estimado) {
          rows.push({ k: 'Páginas del texto', v: paginas, ...PAG });
          rows.push({ k: 'Palabras por página — ' + WPP_LABEL[wppKey], ref: 'según el tipo de página elegido', v: wpp, ...PAL });
        }
        rows.push({ k: estimado ? 'Palabras estimadas (páginas × palabras por página)' : 'Palabras totales del texto', ref: 'paso 1', v: palabras, ...PAL });
        rows.push({ k: 'Tu velocidad de lectura', v: ppm, ...PPM });
        rows.push({ k: 'Palabras ÷ PPM → minutos', ref: 'paso 2: el despeje', v: minutos, extra: true, format: 'unit', unit: 'minutos', decimals: 0 });
        rows.push({ k: 'Lo mismo en horas', v: horas, extra: true, ...HS });
        rows.push({ k: 'Sesiones de 30 minutos', ref: 'para repartirlo', v: sesiones30, ...CANT });
        rows.push({ k: 'Semanas leyendo una sesión por día', v: semanas, ...CANT });
        rows.push({ k: 'Páginas por hora a ese ritmo', v: (ppm * 60) / wpp, format: 'unit', unit: 'páginas', decimals: 1 });

        return {
          total: hhmm(minutos),
          sub:
            'A ' + fmt(ppm, 0) + ' PPM, leer ' + fmt(palabras, 0) + ' palabras lleva ' + fmt(minutos, 0) +
            ' minutos (' + fmt(horas, 1) + ' horas) de lectura neta' +
            (estimado ? ', estimando ' + wpp + ' palabras por página' : '') +
            '. Leyendo 30 min por día lo terminás en ' + sesiones30 + ' sesiones.',
          rows: rows,
          format: 'plain', decimals: 1,
          chart: BANDAS_PPM,
          position: posPPM(ppm),
          positionLabel: 'Leés a ' + fmt(ppm, 0) + ' PPM — velocidad ' + clasificar(ppm),
        };
      }

      // ---- 2) Mi velocidad real en PPM ---------------------------------
      if (id === 'velocidad') {
        const pal = Math.max(0, Number(v.palabrasTest) || 0);
        const min = Number(v.minutosTest) || 0;
        if (pal <= 0 || min <= 0) return err('Cargá las palabras del fragmento y los minutos que tardaste.', 'Palabras del fragmento', pal);

        // Fórmula original: wpm = palabras ÷ minutos
        const medido = pal / min;
        const clas = clasificar(medido);
        const porHora = medido * 60;
        const pagHora = porHora / wpp;
        const minPag = wpp / medido;
        const vsMediana = ((medido - 238) / 238) * 100;

        return {
          total: fmt(medido, 0) + ' PPM',
          sub:
            'Leés a ' + fmt(medido, 0) + ' palabras por minuto — velocidad ' + clas + '. ' +
            (Math.abs(vsMediana) < 1
              ? 'Estás justo en la mediana del adulto (238 PPM).'
              : (vsMediana > 0 ? 'Estás ' + fmt(vsMediana, 0) + '% por encima' : 'Estás ' + fmt(Math.abs(vsMediana), 0) + '% por debajo') +
                ' de la mediana del adulto (238 PPM).'),
          rows: [
            { k: 'Palabras del fragmento', v: pal, ...PAL },
            { k: 'Minutos que tardaste', v: min, format: 'unit', unit: 'minutos', decimals: 1 },
            { k: 'Palabras ÷ minutos → tu velocidad', ref: 'paso 1: el despeje', v: medido, extra: true, ...PPM },
            { k: 'Palabras por hora', ref: 'PPM × 60', v: porHora, ...PAL },
            { k: 'Páginas por hora — ' + WPP_LABEL[wppKey], ref: 'a ' + wpp + ' palabras por página', v: pagHora, extra: true, format: 'unit', unit: 'páginas', decimals: 1 },
            { k: 'Minutos por página', v: minPag, format: 'unit', unit: 'minutos', decimals: 1 },
            { k: 'Mediana del adulto en lectura silenciosa', ref: 'Brysbaert 2019', v: 238, ...PPM },
            { k: 'Diferencia contra la mediana', v: vsMediana, ...PCT },
          ],
          format: 'plain', decimals: 1,
          chart: BANDAS_PPM,
          position: posPPM(medido),
          positionLabel: fmt(medido, 0) + ' PPM — velocidad ' + clas,
        };
      }

      // ---- 3) Leer y estudiar un apunte --------------------------------
      if (id === 'apunte') {
        const minPag = Math.max(0, Number(v.minutosPorPagina) || 0);
        if (paginas < 1 || minPag < 1) return err('Cargá las páginas del apunte y los minutos que te lleva una página.', 'Páginas', paginas);

        // Fórmula original: minutos = páginas × minutos por página; sesiones de 45 min
        const minLectura = paginas * minPag;
        const hsLectura = minLectura / 60;
        const sesiones45 = Math.ceil(minLectura / 45);
        const factor = FACTOR_ESTUDIO[dif];
        const minEstudio = minLectura * factor;
        const hsEstudio = minEstudio / 60;
        const sesionesEstudio = Math.ceil(minEstudio / 45);
        const ppmImplicita = wpp / minPag;
        const ppmEstudio = ppmImplicita / factor;

        return {
          total: hhmm(minEstudio),
          sub:
            'Leer las ' + paginas + ' páginas son ' + fmt(hsLectura, 1) + ' h. Estudiarlas de verdad —subrayar, resumir, repasar— ' +
            'las multiplica por ' + fmt(factor, 2) + ' (dificultad ' + dif + '): ' + fmt(hsEstudio, 1) + ' h en ' + sesionesEstudio + ' sesiones de 45 minutos.',
          rows: [
            { k: 'Páginas del apunte', v: paginas, ...PAG },
            { k: 'Minutos por página leyendo', v: minPag, format: 'unit', unit: 'minutos', decimals: 1 },
            { k: 'Páginas × minutos → lectura pura', ref: 'paso 1', v: minLectura, ...MIN },
            { k: 'Lectura pura en horas', v: hsLectura, ...HS },
            { k: 'Sesiones de 45 minutos sólo para leerlo', v: sesiones45, ...CANT },
            { k: 'Factor estudiar / leer — dificultad ' + dif, ref: 'estimación de planificación', v: factor, ...FACT },
            { k: 'Lectura × factor → tiempo de estudio', ref: 'paso 2', v: minEstudio, extra: true, ...MIN },
            { k: 'Estudio en horas', v: hsEstudio, extra: true, ...HS },
            { k: 'Sesiones de 45 minutos para estudiarlo', v: sesionesEstudio, ...CANT },
            { k: 'Velocidad implícita leyendo', ref: wpp + ' palabras por página ÷ minutos por página', v: ppmImplicita, ...PPM },
            { k: 'Velocidad efectiva estudiando', ref: 'lo que realmente avanzás', v: ppmEstudio, extra: true, ...PPM1 },
          ],
          format: 'plain', decimals: 1,
          chart: BANDAS_PPM,
          position: posPPM(ppmEstudio),
          positionLabel:
            'Estudiando avanzás a ' + fmt(ppmEstudio, 0) + ' PPM (leyendo, ' + fmt(ppmImplicita, 0) + ')',
        };
      }

      // ---- 4) Horas de estudio que pide el examen ----------------------
      if (id === 'examen') {
        const pagHora = Number(v.paginasPorHora) || 0;
        if (paginas < 1 || pagHora <= 0) return err('Cargá las páginas del programa y las páginas que estudiás por hora.', 'Páginas', paginas);

        // Fórmula original: horas = páginas ÷ páginas por hora (sin usar dificultad)
        const horasBase = paginas / pagHora;
        const ajuste = AJUSTE_DIF[dif];
        const pagHoraAjust = pagHora * ajuste;
        const horas = paginas / pagHoraAjust;
        const dias2h = Math.max(1, Math.ceil(horas / 2));
        const diasConRepaso = dias2h + 1;
        const ppmEstudio = (pagHoraAjust * wpp) / 60;
        const plan =
          horas <= 6
            ? 'Llegás cómodo: arrancá esta semana y dejá el último día sólo para repasar.'
            : horas <= 30
              ? 'Empezá con ese margen antes del examen y partí cada sesión en bloques de 45–50 minutos con pausas.'
              : 'Esto no se resuelve la semana previa: armá un cronograma por temas y priorizá los capítulos con más peso en el examen.';

        return {
          total: fmt(horas, 1) + ' h',
          sub:
            paginas + ' páginas a ' + fmt(pagHora, 1) + ' pág/h, ajustadas por dificultad ' + dif +
            ', son ' + fmt(horas, 1) + ' horas netas de estudio. A 2 horas por día: ' + dias2h +
            (dias2h === 1 ? ' día' : ' días') + ', más uno de repaso. ' + plan,
          rows: [
            { k: 'Páginas del programa', v: paginas, ...PAG },
            { k: 'Páginas que estudiás por hora', v: pagHora, format: 'unit', unit: 'páginas', decimals: 1 },
            { k: 'Horas sin ajustar', ref: 'páginas ÷ páginas por hora', v: horasBase, ...HS },
            { k: 'Ajuste por dificultad ' + dif, ref: 'baja ×1,25 · media ×1 · alta ×0,7', v: ajuste, ...FACT },
            { k: 'Páginas por hora ajustadas', v: pagHoraAjust, format: 'unit', unit: 'páginas', decimals: 2 },
            { k: 'Horas netas de estudio', ref: 'paso final', v: horas, extra: true, ...HS },
            { k: 'Días a 2 horas diarias', v: dias2h, ...CANT },
            { k: 'Días recomendados, con el repaso final', v: diasConRepaso, extra: true, ...CANT },
            { k: 'Sesiones de 45 minutos', v: Math.ceil((horas * 60) / 45), ...CANT },
            { k: 'Velocidad efectiva estudiando', ref: 'a ' + wpp + ' palabras por página', v: ppmEstudio, extra: true, ...PPM1 },
          ],
          format: 'plain', decimals: 1,
          chart: BANDAS_PPM,
          position: posPPM(ppmEstudio),
          positionLabel: 'Estudiando avanzás a ' + fmt(ppmEstudio, 0) + ' PPM — muy lejos de tu ritmo de lectura',
        };
      }

      // ---- 5) Comprensión lectora y velocidad efectiva -----------------
      if (id === 'comprension') {
        const totales = Math.max(1, Number(v.totales) || 1);
        const correctas = Math.max(0, Number(v.correctas) || 0);
        if (correctas > totales) return err('Las respuestas correctas no pueden superar el total de preguntas.', 'Diferencia', correctas - totales);

        // Fórmula original: crudo = correctas/totales*100; ajustado = min(100, crudo * factor)
        const crudo = (correctas / totales) * 100;
        const fc = FACTOR_COMPR[dif] || 1;
        const ajustado = Math.min(100, crudo * fc);
        const score = Math.round(ajustado);
        const interp =
          ajustado >= 90 ? 'Excelente' : ajustado >= 75 ? 'Muy bueno' : ajustado >= 60 ? 'Normal' : ajustado >= 40 ? 'Bajo' : 'Muy bajo';
        const rec =
          ajustado < 60 ? 'Bajá la velocidad o ampliá vocabulario base antes de acelerar.'
            : ajustado < 80 ? 'Buena base: practicá el método SQ3R y resúmenes propios.'
              : 'Sólido: desafiate con textos más densos.';
        const efectiva = ppm * (ajustado / 100);
        const perdidas = ppm - efectiva;

        return {
          total: fmt(efectiva, 0) + ' PPM efectivas',
          sub:
            'Acertaste ' + correctas + ' de ' + totales + '. Ajustado por dificultad ' + dif + ', tu score es ' + score +
            '/100 (' + interp.toLowerCase() + '). Leyendo a ' + fmt(ppm, 0) + ' PPM, tu velocidad efectiva es ' + fmt(efectiva, 0) +
            ' PPM. ' + rec,
          rows: [
            { k: 'Preguntas correctas', v: correctas, ...CANT },
            { k: 'Preguntas totales', v: totales, ...CANT },
            { k: 'Score crudo', ref: 'correctas ÷ totales × 100', v: crudo, ...PCT },
            { k: 'Factor por dificultad ' + dif, ref: 'baja ×0,9 · media ×1 · alta ×1,1', v: fc, ...FACT },
            { k: 'Score ajustado — ' + interp, ref: 'tope 100', v: score, extra: true, ...PCT },
            { k: 'Tu velocidad nominal', v: ppm, ...PPM },
            { k: 'Velocidad efectiva = PPM × comprensión', ref: 'el número que importa', v: efectiva, extra: true, ...PPM },
            { k: 'Palabras por minuto que se te escapan', v: perdidas, ...PPM },
          ],
          format: 'plain', decimals: 1,
          chart: BANDAS_PPM,
          position: posPPM(efectiva),
          positionLabel: fmt(efectiva, 0) + ' PPM efectivas con ' + score + '% de comprensión',
        };
      }

      // ---- 6) Escuchar en otro idioma ----------------------------------
      if (id === 'dictado') {
        const nk = MCER[v.nivel] ? v.nivel : 'b1';
        const n = MCER[nk];
        const palabras = palabrasCargadas > 0 ? palabrasCargadas : paginas * wpp;
        const duracion = palabras / n.wpm;
        const trabajo = duracion * n.rep;
        const nativa = palabras / 155; // conversación nativa ≈ 150-160 PPM

        return {
          total: hhmm(trabajo),
          sub:
            'Nivel ' + nk.toUpperCase() + ': seguís cómodo un audio de hasta ' + n.wpm + ' palabras por minuto, con ' + n.repTxt +
            '. Un texto de ' + fmt(palabras, 0) + ' palabras dictado a ese ritmo dura ' + hhmm(duracion) +
            ' y te lleva ' + hhmm(trabajo) + ' de trabajo real.',
          rows: [
            { k: 'Palabras del audio o del dictado', v: palabras, ...PAL },
            { k: 'Velocidad que podés seguir — ' + nk.toUpperCase(), ref: 'referencia por nivel del MCER', v: n.wpm, extra: true, ...PPM },
            { k: 'Duración del audio a esa velocidad', ref: 'palabras ÷ PPM', v: duracion, ...MIN },
            { k: 'Reproducciones que necesita tu nivel', ref: n.repTxt, v: n.rep, ...CANT },
            { k: 'Tiempo total de trabajo', ref: 'duración × reproducciones', v: trabajo, extra: true, ...MIN },
            { k: 'Duración a ritmo de conversación nativa', ref: '≈155 PPM', v: nativa, ...MIN },
            { k: 'Cuánto más rápido habla un nativo que tu nivel', v: ((155 - n.wpm) / n.wpm) * 100, ...PCT },
            { k: 'Tu velocidad leyendo, para comparar', v: ppm, ...PPM },
          ],
          format: 'plain', decimals: 1,
          chart: BANDAS_PPM,
          position: posPPM(n.wpm),
          positionLabel: nk.toUpperCase() + ': seguís ' + n.wpm + ' PPM escuchando (leyendo vas a ' + fmt(ppm, 0) + ')',
        };
      }

      // ---- 7) Traducir --------------------------------------------------
      const tk = TRAD[v.tipoTraduccion] ? v.tipoTraduccion : 'general';
      const t = TRAD[tk];
      const palabras = palabrasCargadas > 0 ? palabrasCargadas : paginas * wpp;
      if (palabras <= 0) return err('Cargá las palabras del texto a traducir.', 'Palabras', 0);
      const horas = palabras / t.wph;
      const jornadas = horas / 8;
      const diario = t.wph * 8;
      const ppmTrad = t.wph / 60;
      const vecesMasLento = ppm / ppmTrad;

      return {
        total: fmt(horas, 1) + ' h',
        sub:
          'Texto ' + t.nombre + ': se traducen unas ' + t.wph + ' palabras por hora, o sea ' + fmt(diario, 0) +
          ' palabras en una jornada de 8 h. Traducir ' + fmt(palabras, 0) + ' palabras lleva ' + fmt(horas, 1) +
          ' horas: ' + fmt(jornadas, 1) + ' jornadas. No incluye la revisión por un segundo traductor.',
        rows: [
          { k: 'Palabras del texto', v: palabras, ...PAL },
          { k: 'Rendimiento — texto ' + t.nombre, ref: 'traducción humana sin memorias', v: t.wph, format: 'unit', unit: 'palabras/h', decimals: 0 },
          { k: 'Palabras ÷ rendimiento → horas', ref: 'el despeje', v: horas, extra: true, ...HS },
          { k: 'Jornadas de 8 horas', v: jornadas, format: 'unit', unit: 'jornadas', decimals: 2 },
          { k: 'Rendimiento diario', ref: '8 horas netas', v: diario, ...PAL },
          { k: 'Días con 6 horas productivas', ref: 'lo realista en plazos largos', v: horas / 6, format: 'unit', unit: 'días', decimals: 1 },
          { k: 'Equivalente en palabras por minuto', v: ppmTrad, ...PPM1 },
          { k: 'Cuántas veces más lento que leerlo', ref: 'contra tus ' + fmt(ppm, 0) + ' PPM', v: vecesMasLento, ...FACT },
        ],
        format: 'plain', decimals: 1,
        chart: BANDAS_PPM,
        position: posPPM(ppmTrad),
        positionLabel:
          'Traducís a ' + fmt(ppmTrad, 1) + ' PPM — ' + fmt(vecesMasLento, 0) + ' veces más lento que leer',
      };
    });
  })();
</script>
