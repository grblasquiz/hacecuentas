---
/**
 * Hub de decisión — "¿Cuánto me cuesta el aire o la calefacción?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 5 casos (frío / calor / equipo / agua / grados-día).
 * La página sólo aporta datos (src/lib/hubs/aire-calefaccion.ts) y compute().
 *
 * Sólo tres ramas son plata. Frigorías, BTU, kcal/h, kWh, W, kg, m³ y grados-día
 * declaran `format: 'unit'` en TODAS sus filas: el runtime hace Object.assign y
 * una fila sin formato propio caería a pesos con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ClimatizacionExperience from '../../components/generated/ClimatizacionExperience.astro';
import {
  hub,
  TARIFAS_2026,
  TARIFA_PARAMS,
  FACTOR_IMPUESTOS_LUZ,
  PRECIO_GAS_M3,
  EER,
  CONSUMO_CALOR,
  LENA_KG_HORA,
  LENA_KG_M3,
  BTU,
  KCAL,
  ACS,
  GRADOS_DIA,
  BASE_HOGAR_KWH,
  DIAS_MES,
} from '../../lib/hubs/aire-calefaccion';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ClimatizacionExperience data={hub} />
  <Footer />
</Layout>

