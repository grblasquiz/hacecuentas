---
/**
 * Hub de decisión — "¿Cada cuánto limpio y cuánto producto uso?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 7 casos (rutina / ambiente / lavandina / producto /
 * ropa: costo, consumo y secado).
 *
 * OJO con el formato: sólo las ramas `ropa` y `lavarropas` son plata. Todas las
 * demás filas declaran `format: 'unit'` o `'plain'`, porque el runtime hace
 * Object.assign y una fila sin formato propio se imprimiría con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  MIN_POR_M2,
  AMBIENTES,
  ML_POR_LITRO,
  TIEMPOS_CONTACTO,
  USOS_NOMBRE,
  ML_POR_M2,
  COEF_AGUA,
  COEF_KWH,
  SECADO_BASE,
  SEMANAS_MES,
} from '../../lib/hubs/limpieza';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    MIN_POR_M2,
    AMBIENTES,
    ML_POR_LITRO,
    TIEMPOS_CONTACTO,
    USOS_NOMBRE,
    ML_POR_M2,
    COEF_AGUA,
    COEF_KWH,
    SECADO_BASE,
    SEMANAS_MES,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });

    /** Factores del modelo de secado. Espejo de src/lib/formulas/tiempo-secado-ropa-aire.ts. */
    function factorTemp(T) {
      if (T >= 30) return 0.55;
      if (T >= 25) return 0.7;
      if (T >= 20) return 0.85;
      if (T >= 15) return 1.0;
      if (T >= 10) return 1.3;
      if (T >= 5) return 1.7;
      return 2.3;
    }
    function factorHum(Hr) {
      if (Hr <= 30) return 0.7;
      if (Hr <= 50) return 0.85;
      if (Hr <= 70) return 1.0;
      if (Hr <= 85) return 1.4;
      return 2.0;
    }
    function factorViento(v) {
      if (v < 2) return 1.4;
      if (v < 8) return 1.1;
      if (v < 15) return 0.9;
      if (v < 25) return 0.75;
      return 0.6;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'rutina';

      // ── 1. Rutina: horas semanales por metros cuadrados ──────────────────
      if (id === 'rutina') {
        const m2 = Math.max(1, Number(v.m2) || 70);
        const prof = String(v.profundidad || 'mantenimiento');
        const minM2 = MIN_POR_M2[prof] || 2;
        const valorHora = Math.max(0, Number(v.valorHora) || 0);

        const min = m2 * minM2;
        const horas = min / 60;
        const costo = horas * valorHora;
        const rec = m2 < 50 ? '1 vez por semana' : m2 < 100 ? '2 veces por semana' : '3 veces por semana o servicio';

        // Comparación de los tres niveles de profundidad sobre los mismos m².
        const niveles = [
          { k: 'Mantenimiento', p: 'mantenimiento', tone: 'good' },
          { k: 'Media', p: 'media', tone: 'main' },
          { k: 'A fondo', p: 'a_fondo', tone: 'warn' },
        ];

        return {
          total: nf(horas, 1) + ' h por semana',
          sub:
            m2 + ' m² con limpieza ' + (prof === 'a_fondo' ? 'a fondo' : prof === 'media' ? 'media' : 'de mantenimiento') +
            ' (' + minM2 + ' min/m²) · ' + nf(min, 0) + ' minutos semanales · frecuencia recomendada: ' + rec +
            (valorHora > 0 ? ' · tercerizarlo saldría ' + H.ars(Math.round(costo)) + ' por semana' : ''),
          format: 'unit',
          unit: 'h',
          decimals: 1,
          rows: [
            { k: 'Horas semanales de limpieza', ref: minM2 + ' min/m² × ' + m2 + ' m²', v: horas, format: 'unit', unit: 'h', decimals: 1, extra: true },
            { k: 'Minutos semanales', v: min, format: 'unit', unit: 'min', decimals: 0 },
            { k: 'Horas al mes', ref: SEMANAS_MES + ' semanas/mes', v: horas * SEMANAS_MES, format: 'unit', unit: 'h', decimals: 1 },
            { k: 'Horas al año', v: horas * 52, format: 'unit', unit: 'h', decimals: 0 },
            { k: 'Costo semanal si lo tercerizás', ref: H.ars(valorHora) + ' por hora', v: Math.round(costo), format: 'ars' },
            { k: 'Costo mensual si lo tercerizás', v: Math.round(costo * SEMANAS_MES), format: 'ars' },
          ],
          chart: niveles.map(function (n) {
            return { label: n.k, value: (m2 * MIN_POR_M2[n.p]) / 60, tone: n.tone };
          }),
        };
      }

      // ── 2. Frecuencia y minutos por ambiente ─────────────────────────────
      if (id === 'ambiente') {
        const amb = String(v.ambiente || 'cocina');
        const data = AMBIENTES[amb] || AMBIENTES.cocina;
        const personas = Math.max(1, Number(v.personas) || 3);
        const conMascota = String(v.mascotas || 'no') === 'si';

        const fPers = personas > 3 ? 1.3 : 1;
        const fMasc = conMascota ? 1.4 : 1;
        const min = Math.round(data.minutos * fPers * fMasc);

        const recargos = [];
        if (fPers > 1) recargos.push('+30% por ser ' + personas + ' personas');
        if (fMasc > 1) recargos.push('+40% por mascotas');

        return {
          total: '~' + min + ' min por sesión',
          sub:
            data.freq + ' · base de ' + data.minutos + ' min' +
            (recargos.length ? ' con ' + recargos.join(' y ') : ' sin recargos') +
            ' · tareas: ' + data.tareas,
          format: 'unit',
          unit: 'min',
          decimals: 0,
          rows: [
            { k: 'Minutos por sesión', v: min, format: 'unit', unit: 'min', decimals: 0, extra: true },
            { k: 'Base del ambiente', ref: data.freq, v: data.minutos, format: 'unit', unit: 'min', decimals: 0 },
            { k: 'Recargo por cantidad de personas', ref: fPers > 1 ? '×1,3' : 'sin recargo', v: data.minutos * (fPers - 1), format: 'unit', unit: 'min', decimals: 0 },
            { k: 'Recargo por mascotas', ref: fMasc > 1 ? '×1,4' : 'sin recargo', v: data.minutos * fPers * (fMasc - 1), format: 'unit', unit: 'min', decimals: 0 },
          ],
          chart: Object.keys(AMBIENTES).map(function (k, i) {
            return {
              label: k === 'bano' ? 'Baño' : k.charAt(0).toUpperCase() + k.slice(1),
              value: Math.round(AMBIENTES[k].minutos * fPers * fMasc),
              tone: k === amb ? 'main' : i % 2 ? 'prop' : 'exit',
            };
          }),
        };
      }

      // ── 3. Dilución de lavandina ─────────────────────────────────────────
      if (id === 'lavandina') {
        const uso = String(v.uso || 'superficies');
        const litros = Math.max(0, Number(v.litros) || 0);
        const conc = String(v.concentracion || 'comun');

        const base = ML_POR_LITRO[uso] != null ? ML_POR_LITRO[uso] : 10;
        const factor = conc === 'concentrada' ? 0.5 : 1;
        const ml = base * litros * factor;
        const tapitas = ml / 5;

        return {
          total: nf(ml, 1) + ' ml de lavandina',
          sub:
            'Para ' + (USOS_NOMBRE[uso] || 'desinfectar') + ' con ' + nf(litros, litros % 1 ? 1 : 0) + ' L de agua y lavandina ' +
            (conc === 'concentrada' ? 'concentrada' : 'común (≈25 g/L)') + ': ' + nf(ml, 1) + ' ml (~' + nf(tapitas, 1) +
            ' tapitas de 5 ml). ' + (TIEMPOS_CONTACTO[uso] || '10 minutos') +
            '. NUNCA la mezcles con amoníaco, vinagre ni limpiadores ácidos: libera gases tóxicos.',
          format: 'unit',
          unit: 'ml',
          decimals: 1,
          rows: [
            { k: 'Lavandina a agregar', ref: base + ' ml por litro' + (factor === 0.5 ? ' ÷ 2 por ser concentrada' : ''), v: ml, format: 'unit', unit: 'ml', decimals: 1, extra: true },
            { k: 'Equivalente en tapitas de 5 ml', v: tapitas, format: 'plain', decimals: 1 },
            { k: 'Agua de la preparación', v: litros, format: 'unit', unit: 'L', decimals: 1 },
            { k: 'Preparación total', v: litros * 1000 + ml, format: 'unit', unit: 'ml', decimals: 0 },
            { k: 'Concentración de la dilución', ref: 'ml de lavandina por litro', v: litros > 0 ? ml / litros : 0, format: 'unit', unit: 'ml/L', decimals: 2 },
          ],
          chart: Object.keys(ML_POR_LITRO).map(function (k) {
            return {
              label: USOS_NOMBRE[k],
              value: ML_POR_LITRO[k] * factor,
              tone: k === uso ? 'main' : 'prop',
            };
          }),
        };
      }

      // ── 4. Rendimiento de producto ───────────────────────────────────────
      if (id === 'producto') {
        const prod = String(v.producto || 'limpiador');
        const m2 = Math.max(1, Number(v.m2Producto) || 40);
        const veces = Math.max(1, Number(v.vecesSemana) || 3);

        const mlM2 = ML_POR_M2[prod] || 5;
        const mlUso = m2 * mlM2;
        const mlSemana = mlUso * veces;
        const mlMes = mlUso * veces * SEMANAS_MES;
        const envases = mlMes / 1000;
        const dias = Math.round(1000 / (mlSemana / 7));

        return {
          total: nf(Math.round(mlUso), 0) + ' ml por uso',
          sub:
            mlM2 + ' ml/m² × ' + m2 + ' m² = ' + nf(Math.round(mlUso), 0) + ' ml cada vez · ' + veces +
            (veces === 1 ? ' vez' : ' veces') + ' por semana · un envase de 1 litro te dura ~' + dias + ' días (' +
            nf(envases, 1) + ' envases por mes)',
          format: 'unit',
          unit: 'ml',
          decimals: 0,
          rows: [
            { k: 'Producto por uso', ref: mlM2 + ' ml por m²', v: mlUso, format: 'unit', unit: 'ml', decimals: 0, extra: true },
            { k: 'Producto por semana', v: mlSemana, format: 'unit', unit: 'ml', decimals: 0 },
            { k: 'Producto por mes', ref: SEMANAS_MES + ' semanas/mes', v: mlMes, format: 'unit', unit: 'ml', decimals: 0 },
            { k: 'Duración de un envase de 1 litro', v: dias, format: 'unit', unit: 'días', decimals: 0 },
            { k: 'Envases de 1 litro por mes', v: envases, format: 'plain', decimals: 1 },
            { k: 'Envases de 1 litro por año', v: envases * 12, format: 'plain', decimals: 1 },
          ],
          chart: Object.keys(ML_POR_M2).map(function (k) {
            return { label: k.charAt(0).toUpperCase() + k.slice(1), value: ML_POR_M2[k] * m2, tone: k === prod ? 'main' : 'prop' };
          }),
        };
      }

      // ── 5. Lavar en casa vs lavandería ───────────────────────────────────
      if (id === 'ropa') {
        const lavadosSem = Math.max(1, Number(v.lavadosSemana) || 3);
        const kgLavado = Math.max(1, Number(v.kgPorLavado) || 5);
        const precioKg = Math.max(0, Number(v.precioLavanderiaKg) || 0);
        const agua = Math.max(0, Number(v.costoAgua) || 0);
        const luz = Math.max(0, Number(v.costoLuz) || 0);
        const jabon = Math.max(0, Number(v.costoJabon) || 0);
        const precioEquipo = Math.max(0, Number(v.precioLavarropas) || 0);
        const vidaUtil = Math.max(1, Number(v.vidaUtilAnos) || 10);

        const lavadosMes = lavadosSem * SEMANAS_MES;
        const costoLavanderiaPorLavado = kgLavado * precioKg;
        const costoLavanderiaMes = costoLavanderiaPorLavado * lavadosMes;

        const operativo = agua + luz + jabon;
        const lavadosVidaUtil = lavadosSem * 52 * vidaUtil;
        const amortizacion = lavadosVidaUtil > 0 ? precioEquipo / lavadosVidaUtil : 0;
        const costoCasaPorLavado = operativo + amortizacion;
        const costoCasaMes = costoCasaPorLavado * lavadosMes;

        const ahorro = Math.abs(costoLavanderiaMes - costoCasaMes);
        const gana = costoCasaMes <= costoLavanderiaMes ? 'casa' : 'lavandería';

        return {
          total: H.ars(Math.round(ahorro)) + ' por mes',
          sub:
            'Lavar en ' + gana + ' te ahorra ' + H.ars(Math.round(ahorro)) + ' por mes (' +
            H.ars(Math.round(ahorro * 12)) + ' al año) · ' + nf(lavadosMes, 0) + ' lavados/mes de ' + kgLavado +
            ' kg: en casa ' + H.ars(Math.round(costoCasaMes)) + ' vs lavandería ' + H.ars(Math.round(costoLavanderiaMes)),
          rows: [
            { k: 'Diferencia mensual a favor de ' + gana, v: Math.round(ahorro), extra: true },
            { k: 'Costo por lavado en casa', ref: 'operativo + amortización', v: Math.round(costoCasaPorLavado) },
            { k: 'Costo por lavado en la lavandería', ref: kgLavado + ' kg × ' + H.ars(precioKg) + '/kg', v: Math.round(costoLavanderiaPorLavado) },
            { k: 'Agua, luz y jabón por lavado', v: Math.round(operativo) },
            { k: 'Amortización del lavarropas por lavado', ref: nf(lavadosVidaUtil, 0) + ' lavados de vida útil', v: Math.round(amortizacion) },
            { k: 'Costo mensual lavando en casa', v: Math.round(costoCasaMes) },
            { k: 'Costo mensual en la lavandería', v: Math.round(costoLavanderiaMes) },
            { k: 'Diferencia anual', v: Math.round(ahorro * 12) },
          ],
          chart: [
            { label: 'Agua', value: agua * lavadosMes, tone: 'good' },
            { label: 'Luz', value: luz * lavadosMes, tone: 'warn' },
            { label: 'Jabón', value: jabon * lavadosMes, tone: 'prop' },
            { label: 'Amortización del equipo', value: amortizacion * lavadosMes, tone: 'exit' },
          ],
        };
      }

      // ── 6. Agua y luz del lavarropas ─────────────────────────────────────
      if (id === 'lavarropas') {
        const kg = Math.max(1, Number(v.capacidadKg) || 8);
        const etiq = String(v.etiqueta || 'A').toUpperCase().trim();
        const ciclos = Math.max(0, Number(v.lavadosSemana) || 3);
        const pKwh = Math.max(0, Number(v.precioKwh) || 0);
        const pM3 = Math.max(0, Number(v.precioM3Agua) || 0);

        const litros = (COEF_AGUA[etiq] != null ? COEF_AGUA[etiq] : 9) * kg;
        const kwh = (COEF_KWH[etiq] != null ? COEF_KWH[etiq] : 0.2) * kg;
        const costoAguaCiclo = (litros / 1000) * pM3;
        const costoEnergiaCiclo = kwh * pKwh;
        const ciclosMes = ciclos * SEMANAS_MES;
        const costoAguaMes = costoAguaCiclo * ciclosMes;
        const costoEnergiaMes = costoEnergiaCiclo * ciclosMes;
        const costoMes = costoAguaMes + costoEnergiaMes;

        return {
          total: H.ars(Math.round(costoMes)) + ' por mes',
          sub:
            'Lavarropas ' + etiq + ' de ' + kg + ' kg: ' + nf(litros, 0) + ' L y ' + nf(kwh, 2) +
            ' kWh por ciclo · ' + ciclos + ' ciclos por semana (' + nf(ciclosMes, 0) + ' al mes) = ' +
            nf(litros * ciclosMes, 0) + ' litros de agua y ' + nf(kwh * ciclosMes, 1) + ' kWh mensuales',
          rows: [
            { k: 'Costo mensual de agua y energía', v: Math.round(costoMes), extra: true },
            { k: 'Litros de agua por ciclo', v: litros, format: 'unit', unit: 'L', decimals: 0 },
            { k: 'Energía por ciclo', v: kwh, format: 'unit', unit: 'kWh', decimals: 2 },
            { k: 'Litros de agua al mes', v: litros * ciclosMes, format: 'unit', unit: 'L', decimals: 0 },
            { k: 'Energía al mes', v: kwh * ciclosMes, format: 'unit', unit: 'kWh', decimals: 1 },
            { k: 'Costo de agua al mes', v: Math.round(costoAguaMes) },
            { k: 'Costo de energía al mes', v: Math.round(costoEnergiaMes) },
            { k: 'Costo anual', v: Math.round(costoMes * 12) },
          ],
          chart: [
            { label: 'Agua', value: costoAguaMes, tone: 'good' },
            { label: 'Energía', value: costoEnergiaMes, tone: 'warn' },
          ],
        };
      }

      // ── 7. Secado de ropa al aire ────────────────────────────────────────
      const prenda = String(v.prenda || 'remera');
      const T = Math.min(50, Math.max(-15, Number(v.temperatura)));
      const Hr = Math.min(100, Math.max(1, Number(v.humedad) || 65));
      const viento = Math.min(150, Math.max(0, Number(v.viento) || 0));
      const sol = String(v.sol || 'parcial');

      const fT = factorTemp(T);
      const fH = factorHum(Hr);
      const fV = factorViento(viento);
      const fSol = sol === 'pleno' ? 0.8 : sol === 'parcial' ? 0.95 : 1.2;

      const base = SECADO_BASE[prenda] || 3;
      const horas = Math.max(0.3, base * fT * fH * fV * fSol);

      const factores = [
        { nombre: 'la temperatura', valor: fT },
        { nombre: 'la humedad', valor: fH },
        { nombre: 'el viento', valor: fV },
        { nombre: 'el sol', valor: fSol },
      ];
      const masFrena = factores.reduce(function (a, b) { return b.valor > a.valor ? b : a; });
      const masAyuda = factores.reduce(function (a, b) { return b.valor < a.valor ? b : a; });
      const categoria = horas < 2 ? 'Muy rápido' : horas < 5 ? 'Normal' : horas < 10 ? 'Lento' : 'Muy lento';
      // Sólo hablamos de "lo que más frena" si algo realmente frena (factor > 1).
      const comentario = masFrena.valor > 1.05
        ? 'lo que más frena es ' + masFrena.nombre + ' (×' + nf(masFrena.valor, 2) + ')'
        : 'lo que más ayuda es ' + masAyuda.nombre + ' (×' + nf(masAyuda.valor, 2) + ')';

      return {
        total: '~' + nf(horas, 1) + ' h',
        sub:
          prenda + ' a ' + nf(T, 0) + ' °C, ' + nf(Hr, 0) + '% de humedad, ' + nf(viento, 0) +
          ' km/h de viento y sol ' + sol + ': ~' + nf(horas, 1) + ' h (' + categoria.toLowerCase() + ') · ' + comentario,
        format: 'unit',
        unit: 'h',
        decimals: 1,
        rows: [
          { k: 'Horas de secado estimadas', ref: categoria, v: horas, format: 'unit', unit: 'h', decimals: 1, extra: true },
          { k: 'Base de la prenda', ref: 'en condiciones neutras', v: base, format: 'unit', unit: 'h', decimals: 1 },
          { k: 'Factor temperatura', ref: nf(T, 0) + ' °C', v: fT, format: 'plain', decimals: 2 },
          { k: 'Factor humedad', ref: nf(Hr, 0) + '%', v: fH, format: 'plain', decimals: 2 },
          { k: 'Factor viento', ref: nf(viento, 0) + ' km/h', v: fV, format: 'plain', decimals: 2 },
          { k: 'Factor sol', ref: sol, v: fSol, format: 'plain', decimals: 2 },
        ],
        chart: ['medias', 'remera', 'camisa', 'sabana', 'jean', 'buzo', 'toalla'].filter(function (p) {
          return ['medias', 'remera', 'sabana', 'jean', 'toalla'].indexOf(p) >= 0 || p === prenda;
        }).map(function (p) {
          return {
            label: p.charAt(0).toUpperCase() + p.slice(1),
            value: Math.max(0.3, SECADO_BASE[p] * fT * fH * fV * fSol),
            tone: p === prenda ? 'main' : 'prop',
          };
        }),
      };
    });
  })();
</script>
