---
/**
 * Hub de decisión — "¿Cuál es mi huella de carbono?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/huella.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  CASE_MATH,
  CO2_KM,
  CO2_DIETA,
  CO2_ENERGIA,
  CO2_OTROS,
  PROMEDIO_AR,
  FACTORES_VUELO,
  CORTE_VUELO,
  ARBOL_VUELO_KG,
  CREDITO_USD_TON,
  ESPECIES,
  CO2_ALIMENTO,
  AGUA_ALIMENTO,
  DUCHA_LITROS,
  RESIDUOS,
  BOTELLAS,
  PAPEL,
  BIODEGRADACION,
} from '../../lib/hubs/huella';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    MATH: CASE_MATH,
    KM: CO2_KM,
    DIETA: CO2_DIETA,
    ENERGIA: CO2_ENERGIA,
    OTROS: CO2_OTROS,
    PROM: PROMEDIO_AR,
    FVUELO: FACTORES_VUELO,
    CORTE: CORTE_VUELO,
    ARBOLKG: ARBOL_VUELO_KG,
    CREDITO: CREDITO_USD_TON,
    ESP: ESPECIES,
    CO2AL: CO2_ALIMENTO,
    AGUA: AGUA_ALIMENTO,
    DUCHA: DUCHA_LITROS,
    RES: RESIDUOS,
    BOT: BOTELLAS,
    PAP: PAPEL,
    BIO: BIODEGRADACION,
  }}
>
  (function () {
    const H = window.HC_HUB;

    function r1(n) {
      return Math.round(n * 10) / 10;
    }
    function n0(n) {
      return Math.round(n).toLocaleString('es-AR');
    }
    /** Toneladas anuales de la huella personal, con la misma cuenta de la fórmula original. */
    function huellaPersonal(v) {
      const km = Number(v.kmSemanales);
      const kms = isNaN(km) ? 100 : km;
      const trans = (KM[v.transporte] !== undefined ? KM[v.transporte] : 0.21) * kms * 52 / 1000;
      const dieta = DIETA[v.dieta] !== undefined ? DIETA[v.dieta] : 1.5;
      const ener = ENERGIA[v.energia] !== undefined ? ENERGIA[v.energia] : 1.0;
      const total = Number((trans + dieta + ener + OTROS).toFixed(1));
      return { trans: trans, dieta: dieta, ener: ener, otros: OTROS, total: total };
    }

    H.onCompute(function (v, kase) {
      const modo = (MATH[kase && kase.id] || MATH.personal).modo;

      /* ---------------- Huella anual completa -------------------------- */
      if (modo === 'personal') {
        const p = huellaPersonal(v);
        const diff = r1(p.total - PROM);
        const techo = Math.max(p.total, PROM) * 1.6 * 1000;
        const kg = {
          trans: Math.round(p.trans * 1000),
          dieta: Math.round(p.dieta * 1000),
          ener: Math.round(p.ener * 1000),
          otros: Math.round(p.otros * 1000),
        };

        return {
          total: p.total.toLocaleString('es-AR', { maximumFractionDigits: 1 }) + ' t CO₂/año',
          sub:
            (diff > 0.5
              ? Math.abs(diff) + ' t por encima'
              : diff < -0.5
              ? Math.abs(diff) + ' t por debajo'
              : 'en línea con') +
            ' el promedio per cápita argentino (' + PROM + ' t) · sin contar vuelos',
          rows: [
            { k: 'Transporte', ref: (KM[v.transporte] !== undefined ? KM[v.transporte] : 0.21) + ' kg/km × 52 semanas', v: kg.trans, format: 'unit', unit: 'kg CO₂' },
            { k: 'Alimentación', ref: 'patrón declarado', v: kg.dieta, format: 'unit', unit: 'kg CO₂' },
            { k: 'Energía del hogar', v: kg.ener, format: 'unit', unit: 'kg CO₂' },
            { k: 'Consumo y servicios (difusas)', ref: 'valor de referencia', v: kg.otros, format: 'unit', unit: 'kg CO₂' },
            { k: 'Total anual', v: Math.round(p.total * 1000), format: 'unit', unit: 'kg CO₂', extra: true },
            { k: 'Promedio per cápita argentino', v: Math.round(PROM * 1000), format: 'unit', unit: 'kg CO₂' },
            { k: diff >= 0 ? 'Cuánto estás por encima' : 'Cuánto estás por debajo', v: Math.round(Math.abs(diff) * 1000), format: 'unit', unit: 'kg CO₂', extra: true },
          ],
          format: 'unit',
          unit: 'kg CO₂',
          chart: [
            { label: 'Transporte', value: kg.trans, tone: 'main', from: 0, to: kg.trans },
            { label: 'Alimentación', value: kg.dieta, tone: 'warn', from: kg.trans, to: kg.trans + kg.dieta },
            { label: 'Energía', value: kg.ener, tone: 'prop', from: kg.trans + kg.dieta, to: kg.trans + kg.dieta + kg.ener },
            { label: 'Difusas', value: kg.otros, tone: 'good', from: kg.trans + kg.dieta + kg.ener, to: Math.round(p.total * 1000) },
            { label: 'Margen sobre el promedio', value: Math.max(0, Math.round(techo - p.total * 1000)), tone: 'bad', from: Math.round(p.total * 1000), to: Math.round(techo) },
          ],
          position: Math.min(100, Math.max(0, (p.total * 1000 / techo) * 100)),
          positionLabel: p.total + ' t CO₂/año contra ' + PROM + ' t del promedio argentino',
        };
      }

      /* ---------------- Emisiones de un vuelo -------------------------- */
      if (modo === 'vuelo') {
        const dist = Math.max(1, Number(v.distanciaKm) || 0);
        const radio = dist < CORTE.corto ? 'corto' : dist < CORTE.medio ? 'medio' : 'largo';
        const radioTxt = radio === 'corto' ? 'corto radio' : radio === 'medio' ? 'medio radio' : 'largo radio';
        const tabla = FVUELO[radio];
        const factor = tabla[v.claseVuelo] !== undefined ? tabla[v.claseVuelo] : tabla.economica;
        const iv = v.idaVuelta === 'no' ? 1 : 2;
        const co2 = Math.round(dist * factor * iv);
        const arboles = Math.ceil(co2 / ARBOLKG);
        const ton = co2 / 1000;
        const anual = huellaPersonal(v).total * 1000;
        const techo = Math.max(anual, co2) * 1.25;

        return {
          total: n0(co2) + ' kg CO₂',
          sub:
            n0(dist) + ' km ' + (iv === 2 ? 'ida y vuelta' : 'sólo ida') + ' · ' + radioTxt +
            ' · factor ' + factor.toFixed(3) + ' kg por pasajero y km · ' +
            'compensarlo cuesta USD ' + Math.round(ton * CREDITO.min) + '–' + Math.round(ton * CREDITO.max),
          rows: [
            { k: 'Distancia del tramo', v: dist, format: 'unit', unit: 'km' },
            { k: 'Factor de emisión aplicado', ref: radioTxt + ' · ' + (v.claseVuelo === 'economica' ? 'Económica' : v.claseVuelo === 'premiumeconomy' ? 'Premium Economy' : v.claseVuelo === 'business' ? 'Business' : 'Primera'), v: factor, format: 'unit', unit: 'kg CO₂/km', decimals: 3 },
            { k: 'Emisiones sólo ida', v: Math.round(dist * factor), format: 'unit', unit: 'kg CO₂' },
            { k: 'Emisiones del viaje', ref: iv === 2 ? 'ida y vuelta' : 'sólo ida', v: co2, format: 'unit', unit: 'kg CO₂', extra: true },
            { k: 'Si volaras en Económica', ref: 'comparación', v: Math.round(dist * tabla.economica * iv), format: 'unit', unit: 'kg CO₂' },
            { k: 'Árboles que lo absorben en un año', ref: ARBOLKG + ' kg CO₂ por árbol', v: arboles, format: 'plain' },
            { k: 'Tu huella anual estimada, sin vuelos', v: Math.round(anual), format: 'unit', unit: 'kg CO₂' },
            { k: 'Cuánto pesa este vuelo sobre tu año', v: Math.round((co2 / Math.max(1, anual)) * 100), format: 'unit', unit: '%', extra: true },
          ],
          format: 'unit',
          unit: 'kg CO₂',
          chart: [
            { label: 'Este vuelo', value: co2, tone: 'bad', from: 0, to: co2 },
            { label: 'Resto de tu año', value: Math.max(0, Math.round(techo - co2)), tone: 'good', from: co2, to: Math.round(techo) },
          ],
          position: Math.min(100, Math.max(0, (co2 / techo) * 100)),
          positionLabel: n0(co2) + ' kg CO₂ — ' + Math.round((co2 / Math.max(1, anual)) * 100) + ' % de tu huella anual',
        };
      }

      /* ---------------- Árboles para compensar ------------------------- */
      if (modo === 'arboles') {
        const ton = Math.max(0, Number(v.toneladasCO2) || 0);
        const e = ESP[v.especie] || ESP['mixto-nativo'];
        const kgCO2 = ton * 1000;
        const arboles = kgCO2 > 0 ? Math.ceil(kgCO2 / e.absorcion) : 0;
        const hectareas = arboles / e.densidad;
        const anual = huellaPersonal(v).total * 1000;
        const techo = Math.max(anual, kgCO2) * 1.2;
        const cubre = anual > 0 ? Math.min(100, Math.round((kgCO2 / anual) * 100)) : 0;

        return {
          total: n0(arboles) + ' árboles',
          sub:
            e.nombre + ' · ' + e.absorcion + ' kg CO₂ por árbol y por año · ' +
            hectareas.toLocaleString('es-AR', { maximumFractionDigits: 2 }) + ' ha con densidad de ' + e.densidad + ' por hectárea · ' +
            'tardan unos ' + e.anios + ' años en absorber a ritmo pleno',
          rows: [
            { k: 'CO₂ a compensar', v: Math.round(kgCO2), format: 'unit', unit: 'kg CO₂' },
            { k: 'Absorción de ' + e.nombre, ref: 'árbol maduro', v: e.absorcion, format: 'unit', unit: 'kg CO₂/año' },
            { k: 'Árboles necesarios', v: arboles, format: 'plain', extra: true },
            { k: 'Superficie de la plantación', ref: e.densidad + ' árboles por hectárea', v: hectareas, format: 'unit', unit: 'ha', decimals: 2 },
            { k: 'Años hasta la absorción plena', v: e.anios, format: 'unit', unit: 'años' },
            { k: 'Con la especie de absorción más alta', ref: 'Paulownia, ' + ESP.paulownia.absorcion + ' kg/año', v: kgCO2 > 0 ? Math.ceil(kgCO2 / ESP.paulownia.absorcion) : 0, format: 'plain' },
            { k: 'Con la especie de absorción más baja', ref: 'Cedro, ' + ESP.cedro.absorcion + ' kg/año', v: kgCO2 > 0 ? Math.ceil(kgCO2 / ESP.cedro.absorcion) : 0, format: 'plain' },
            { k: 'Tu huella anual estimada', v: Math.round(anual), format: 'unit', unit: 'kg CO₂' },
          ],
          format: 'plain',
          chart: [
            { label: 'Compensado', value: Math.round(Math.min(kgCO2, anual)), tone: 'good', from: 0, to: Math.round(Math.min(kgCO2, anual)) },
            { label: 'Sin compensar', value: Math.max(0, Math.round(techo - Math.min(kgCO2, anual))), tone: 'bad', from: Math.round(Math.min(kgCO2, anual)), to: Math.round(techo) },
          ],
          position: Math.min(100, Math.max(0, (kgCO2 / techo) * 100)),
          positionLabel: n0(arboles) + ' árboles cubren ' + cubre + ' % de tu huella anual',
        };
      }

      /* ---------------- Alimentación: CO₂ y agua ----------------------- */
      if (modo === 'comida') {
        const kgs = {
          carneRes: Math.max(0, Number(v.carneRes) || 0),
          polloPescado: Math.max(0, Number(v.polloPescado) || 0),
          lacteos: Math.max(0, Number(v.lacteos) || 0),
          vegetales: Math.max(0, Number(v.vegetales) || 0),
        };
        const co2 = {
          carneRes: kgs.carneRes * CO2AL.carneRes,
          polloPescado: kgs.polloPescado * CO2AL.polloPescado,
          lacteos: kgs.lacteos * CO2AL.lacteos,
          vegetales: kgs.vegetales * CO2AL.vegetales,
        };
        const semana = co2.carneRes + co2.polloPescado + co2.lacteos + co2.vegetales;
        const anio = semana * 52;
        const agua =
          kgs.carneRes * AGUA.carneRes +
          kgs.polloPescado * AGUA.polloPescado +
          kgs.lacteos * AGUA.lacteos +
          kgs.vegetales * AGUA.vegetales;
        const aguaAnio = agua * 52;
        const duchas = Math.round(aguaAnio / DUCHA);
        const pctRes = semana > 0 ? Math.round((co2.carneRes / semana) * 100) : 0;

        // Franjas de referencia anuales: dieta baja, media y alta.
        const bajo = 700;
        const medio = 1600;
        const techo = Math.max(2800, anio * 1.15);

        return {
          total: n0(anio) + ' kg CO₂/año',
          sub:
            r1(semana) + ' kg CO₂ por semana · la carne de res explica el ' + pctRes + ' % · ' +
            n0(aguaAnio) + ' litros de agua al año, unas ' + n0(duchas) + ' duchas',
          rows: [
            { k: 'Carne de res', ref: CO2AL.carneRes + ' kg CO₂ y ' + n0(AGUA.carneRes) + ' L por kilo', v: Math.round(co2.carneRes * 52), format: 'unit', unit: 'kg CO₂' },
            { k: 'Pollo y pescado', ref: CO2AL.polloPescado + ' kg CO₂ y ' + n0(AGUA.polloPescado) + ' L por kilo', v: Math.round(co2.polloPescado * 52), format: 'unit', unit: 'kg CO₂' },
            { k: 'Lácteos', ref: CO2AL.lacteos + ' kg CO₂ y ' + n0(AGUA.lacteos) + ' L por kilo', v: Math.round(co2.lacteos * 52), format: 'unit', unit: 'kg CO₂' },
            { k: 'Vegetales y frutas', ref: CO2AL.vegetales + ' kg CO₂ y ' + n0(AGUA.vegetales) + ' L por kilo', v: Math.round(co2.vegetales * 52), format: 'unit', unit: 'kg CO₂' },
            { k: 'Total anual de tu dieta', v: Math.round(anio), format: 'unit', unit: 'kg CO₂', extra: true },
            { k: 'Huella hídrica anual de esa dieta', v: Math.round(aguaAnio), format: 'unit', unit: 'litros', extra: true },
            { k: 'Equivalencia en duchas', ref: DUCHA + ' litros cada una', v: duchas, format: 'plain' },
            { k: 'Si bajaras la carne de res a la mitad', ref: 'ahorro anual', v: Math.round(co2.carneRes * 52 * 0.5), format: 'unit', unit: 'kg CO₂' },
          ],
          format: 'unit',
          unit: 'kg CO₂',
          chart: [
            { label: 'Dieta baja', value: bajo, tone: 'good', from: 0, to: bajo },
            { label: 'Dieta media', value: medio - bajo, tone: 'warn', from: bajo, to: medio },
            { label: 'Dieta alta', value: Math.round(techo - medio), tone: 'bad', from: medio, to: Math.round(techo) },
          ],
          position: Math.min(100, Math.max(0, (anio / techo) * 100)),
          positionLabel: n0(anio) + ' kg CO₂/año — la carne de res explica el ' + pctRes + ' %',
        };
      }

      /* ---------------- Basura, reciclaje y degradación ---------------- */
      const personas = Math.max(1, Number(v.personas) || 1);
      const pct = Math.min(100, Math.max(0, Number(v.porcentajeSeparacion) || 0));
      const kgMes = personas * RES.kgPorPersonaDia * 30;
      const reciclablesMes = kgMes * RES.fraccionReciclable;
      const recicladosMes = reciclablesMes * (pct / 100);
      const co2Mes = recicladosMes * RES.co2PorKgReciclado;
      const co2Anio = co2Mes * 12;
      const co2Potencial = reciclablesMes * RES.co2PorKgReciclado * 12;

      const botellas = Math.max(0, Number(v.botellas) || 0);
      const kgPet = (botellas * BOT.gramosPorBotella * 52) / 1000;
      const co2Pet = kgPet * BOT.co2PorKgPet;

      const hojas = Math.max(0, Number(v.hojasSem) || 0);
      const hojasAhorradas = hojas * 52 * PAP.ahorroDobleFaz;
      const arbolesPapel = hojasAhorradas / PAP.hojasPorArbol;
      const co2Papel = hojasAhorradas * PAP.co2PorHoja;

      const totalEvitado = co2Anio + co2Pet + co2Papel;
      const techoBasura = Math.max(co2Potencial + co2Pet + co2Papel, totalEvitado) * 1.05;

      const rowsBasura = [
        { k: 'Residuos que genera tu casa', ref: RES.kgPorPersonaDia + ' kg por persona y día', v: Math.round(kgMes * 12), format: 'unit', unit: 'kg/año' },
        { k: 'Fracción reciclable', ref: Math.round(RES.fraccionReciclable * 100) + ' % del total', v: Math.round(reciclablesMes * 12), format: 'unit', unit: 'kg/año' },
        { k: 'Lo que reciclás con ' + pct + ' % de separación', v: Math.round(recicladosMes * 12), format: 'unit', unit: 'kg/año' },
        { k: 'CO₂ evitado por separar', ref: RES.co2PorKgReciclado + ' kg CO₂ por kilo reciclado', v: Math.round(co2Anio), format: 'unit', unit: 'kg CO₂' },
        { k: 'CO₂ evitado por las botellas PET', ref: n0(kgPet) + ' kg de PET al año', v: Math.round(co2Pet), format: 'unit', unit: 'kg CO₂' },
        { k: 'CO₂ evitado imprimiendo a doble faz', ref: n0(hojasAhorradas) + ' hojas y ' + arbolesPapel.toFixed(2) + ' árboles', v: Math.round(co2Papel), format: 'unit', unit: 'kg CO₂' },
        { k: 'Total que evitás por año', v: Math.round(totalEvitado), format: 'unit', unit: 'kg CO₂', extra: true },
        { k: 'Lo que evitarías separando todo lo reciclable', v: Math.round(co2Potencial + co2Pet + co2Papel), format: 'unit', unit: 'kg CO₂', extra: true },
      ];

      for (let i = 0; i < BIO.length; i++) {
        rowsBasura.push({
          k: 'Tarda en degradarse: ' + BIO[i].nombre,
          ref: BIO[i].anios < 1 ? Math.round(BIO[i].anios * 12) + ' meses' : null,
          v: BIO[i].anios,
          format: 'unit',
          unit: 'años',
          decimals: BIO[i].anios < 1 ? 1 : 0,
        });
      }

      return {
        total: n0(totalEvitado) + ' kg CO₂/año',
        sub:
          personas + ' persona(s) · ' + n0(kgMes * 12) + ' kg de residuos al año, ' + n0(reciclablesMes * 12) + ' reciclables · ' +
          'separás el ' + pct + ' % · te queda un margen de ' + n0(Math.max(0, co2Potencial - co2Anio)) + ' kg CO₂ sin aprovechar',
        rows: rowsBasura,
        format: 'unit',
        unit: 'kg CO₂',
        chart: [
          { label: 'CO₂ que evitás', value: Math.round(totalEvitado), tone: 'good', from: 0, to: Math.round(totalEvitado) },
          { label: 'Margen que se te escapa', value: Math.max(0, Math.round(techoBasura - totalEvitado)), tone: 'bad', from: Math.round(totalEvitado), to: Math.round(techoBasura) },
        ],
        position: Math.min(100, Math.max(0, (totalEvitado / techoBasura) * 100)),
        positionLabel: n0(totalEvitado) + ' kg CO₂ evitados de ' + n0(co2Potencial + co2Pet + co2Papel) + ' posibles',
      };
    });
  })();
</script>
