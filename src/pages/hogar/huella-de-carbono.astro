---
/**
 * Hub de decisión — "¿Cuál es mi huella de carbono?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/huella.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import HuellaCarbonoHogarExperience from '../../components/generated/HuellaCarbonoHogarExperience.astro';
import {
  hub,
  CASE_MATH,
  CO2_KM,
  CO2_DIETA,
  CO2_ENERGIA,
  CO2_OTROS,
  PROMEDIO_AR,
  FACTORES_VUELO,
  CORTE_VUELO,
  ARBOL_VUELO_KG,
  CREDITO_USD_TON,
  ESPECIES,
  CO2_ALIMENTO,
  AGUA_ALIMENTO,
  DUCHA_LITROS,
  RESIDUOS,
  BOTELLAS,
  PAPEL,
  BIODEGRADACION,
} from '../../lib/hubs/huella';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <HuellaCarbonoHogarExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

