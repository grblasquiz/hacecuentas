---
/**
 * Hub de decisión — "¿Tengo humedad en casa y dónde va a condensar?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer
 * y el ambiente se elige en un select.
 * La página sólo aporta datos (src/lib/hubs/humedad-en-casa.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import HumedadCasaExperience from '../../components/generated/HumedadCasaExperience.astro';
import { hub, AMBIENTES, MAGNUS, BANDAS_TD, ALTURA_M } from '../../lib/hubs/humedad-en-casa';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <HumedadCasaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

