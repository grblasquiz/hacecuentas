---
/**
 * Hub de decisión — "¿Tengo humedad en casa y dónde va a condensar?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer
 * y el ambiente se elige en un select.
 * La página sólo aporta datos (src/lib/hubs/humedad-en-casa.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, AMBIENTES, MAGNUS, BANDAS_TD, ALTURA_M } from '../../lib/hubs/humedad-en-casa';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ AMB: AMBIENTES, MG: MAGNUS, BANDS: BANDAS_TD, ALTURA: ALTURA_M }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay plata. El runtime hace Object.assign: una fila sin `format`
    // propio cae a pesos.
    const C = { format: 'unit', unit: '°C', decimals: 1 };
    const PCT = { format: 'unit', unit: '%', decimals: 0 };
    const GM3 = { format: 'unit', unit: 'g/m³', decimals: 1 };
    const HPA = { format: 'unit', unit: 'hPa', decimals: 2 };
    const M3 = { format: 'unit', unit: 'm³', decimals: 1 };
    const ML = { format: 'unit', unit: 'mL', decimals: 0 };

    const fmt = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    // Eje del gráfico: mismas franjas que punto-de-rocio.ts, de −10 °C a 30 °C.
    const EJE_MIN = BANDS[0].from;
    const EJE_MAX = BANDS[BANDS.length - 1].to;

    function bandaDe(td) {
      for (let i = 0; i < BANDS.length; i++) if (td < BANDS[i].to) return BANDS[i];
      return BANDS[BANDS.length - 1];
    }

    H.onCompute(function (v) {
      const amb = AMB[String(v.ambiente || 'dormitorio')] ? String(v.ambiente) : 'dormitorio';
      const A = AMB[amb];

      const T = Math.min(60, Math.max(-40, v.temperatura === undefined ? 21 : v.temperatura));
      const RH = Math.min(100, Math.max(1, v.humedadRelativa || 0));
      const Ts = Math.min(60, Math.max(-40, v.tempSuperficie === undefined ? T - 5 : v.tempSuperficie));
      const m2 = Math.max(0, v.superficieM2 || 0);

      if (!RH) {
        return {
          total: '0 °C',
          sub: 'Cargá la temperatura y la humedad relativa que marca el higrómetro.',
          rows: [],
          chart: [],
          format: 'unit',
          unit: '°C',
          decimals: 1,
        };
      }

      // ── 1. Humedad absoluta (humedad-absoluta-relativa) ─────────────────
      // es = 6.112 · exp(17.625·T / (T+243.04))   [hPa]
      const es = MG.es0 * Math.exp((MG.a * T) / (T + MG.b));
      const e = (RH / 100) * es;
      const AH = (MG.k * e) / (T + 273.15);

      // ── 2. Punto de rocío (punto-de-rocio) — Magnus-Tetens ──────────────
      const alpha = Math.log(RH / 100) + (MG.a * T) / (MG.b + T);
      const Td = (MG.b * alpha) / (MG.a - alpha);
      const margenAire = T - Td;
      const banda = bandaDe(Td);

      // ── 3. Rango ideal del ambiente (humedad-ideal-ambiente) ────────────
      const dentro = RH >= A.min && RH <= A.max;
      const estado = dentro ? 'dentro del rango ideal' : RH < A.min ? 'demasiado seco' : 'demasiado húmedo';
      const desvio = dentro ? 0 : RH < A.min ? A.min - RH : RH - A.max;

      // ── 4. EXTENSIÓN: condensación en la superficie fría ────────────────
      const margenSuperficie = Ts - Td;
      const condensa = margenSuperficie <= 0;
      // Humedad relativa local sobre esa superficie (mismo agua, aire más frío).
      const esSup = MG.es0 * Math.exp((MG.a * Ts) / (Ts + MG.b));
      const rhSuperficie = Math.min(100, (e / esSup) * 100);

      // ── 5. EXTENSIÓN: agua en el aire del ambiente ──────────────────────
      const volumen = m2 * ALTURA;
      const aguaActualG = AH * volumen;
      // Cuánta agua sobra respecto del techo del rango ideal del ambiente.
      const eObjetivo = (A.max / 100) * es;
      const ahObjetivo = (MG.k * eObjetivo) / (T + 273.15);
      const aguaObjetivoG = ahObjetivo * volumen;
      const aExtraerMl = Math.max(0, aguaActualG - aguaObjetivoG); // 1 g de agua ≈ 1 mL

      const rows = [];
      rows.push(Object.assign({ k: 'Punto de rocío', ref: 'Magnus-Tetens · ' + banda.label, v: Td, extra: true }, C));
      rows.push(Object.assign({ k: 'Humedad absoluta: agua real en el aire', v: AH, extra: true }, GM3));
      rows.push(Object.assign({ k: 'Presión de vapor', v: e }, HPA));
      rows.push(Object.assign({ k: 'Presión de vapor de saturación a ' + fmt(T, 1) + ' °C', v: es }, HPA));

      rows.push(Object.assign({ k: 'Humedad relativa medida', v: RH, extra: true }, PCT));
      rows.push(Object.assign({ k: 'Piso del rango ideal en ' + A.label.toLowerCase(), v: A.min }, PCT));
      rows.push(Object.assign({ k: 'Techo del rango ideal en ' + A.label.toLowerCase(), v: A.max }, PCT));
      rows.push(Object.assign({ k: dentro ? 'Desvío del rango ideal' : 'Puntos fuera del rango ideal', v: desvio }, PCT));

      rows.push(Object.assign({ k: 'Margen del aire hasta condensar', ref: 'temperatura − punto de rocío', v: margenAire }, C));
      rows.push(Object.assign({ k: 'Temperatura de la superficie fría', v: Ts }, C));
      rows.push(Object.assign({ k: condensa ? 'Cuánto le falta para dejar de condensar' : 'Margen de la superficie fría', v: Math.abs(margenSuperficie), extra: condensa }, C));
      rows.push(Object.assign({ k: 'Humedad relativa sobre esa superficie', ref: condensa ? 'satura: ahí condensa' : 'sobre 70% ya prende el moho', v: rhSuperficie }, PCT));

      if (volumen > 0) {
        rows.push(Object.assign({ k: 'Volumen del ambiente', ref: 'cielorraso de ' + String(ALTURA).replace('.', ',') + ' m', v: volumen }, M3));
        rows.push(Object.assign({ k: 'Agua contenida en el aire del ambiente', v: aguaActualG, format: 'unit', unit: 'g', decimals: 0 }));
        rows.push(Object.assign({ k: 'Agua a extraer para llegar al ' + A.max + '%', v: aExtraerMl, extra: aExtraerMl > 0 }, ML));
      }

      const posicion = ((Td - EJE_MIN) / (EJE_MAX - EJE_MIN)) * 100;

      const sub =
        A.label + ' ' + estado + ' (' + fmt(RH, 0) + '% frente a ' + A.min + '–' + A.max + '%) · ' +
        fmt(AH, 1) + ' g/m³ de agua en el aire · ' +
        (condensa
          ? 'la superficie a ' + fmt(Ts, 1) + ' °C ya está condensando'
          : 'la superficie a ' + fmt(Ts, 1) + ' °C tiene ' + fmt(margenSuperficie, 1) + ' °C de margen') +
        ' · aire ' + banda.label.toLowerCase();

      return {
        total: fmt(Td, 1) + ' °C',
        sub: sub,
        rows: rows,
        format: 'unit',
        unit: '°C',
        decimals: 1,
        position: Math.min(100, Math.max(0, posicion)),
        positionLabel: 'Punto de rocío ' + fmt(Td, 1) + ' °C — ' + banda.label,
        chart: BANDS.map(function (b) {
          return { label: b.label, value: b.to - b.from, from: b.from, to: b.to, tone: b.tone };
        }),
      };
    });
  })();
</script>
