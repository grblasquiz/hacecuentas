---
/**
 * Hub de decisión — "¿Cuánto me cuesta la casa además del alquiler o la cuota?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 5 casos (expensas / mantenimiento anual / seguro /
 * reparar o reemplazar / mudanza).
 *
 * OJO con el formato: 4 de las 5 ramas son plata, pero la rama `electro`
 * devuelve porcentajes y años. Todas sus filas declaran `format` explícito
 * ('unit' o 'plain'), porque el runtime hace Object.assign y una fila sin
 * formato propio se imprimiría con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  EXPENSAS_BASE_M2,
  EXPENSAS_ZONA_LABEL,
  EXPENSAS_AMENITIES,
  SEGURO_TASA,
  SEGURO_ZONA,
  SEGURO_COBERTURA_LABEL,
  VIDA_UTIL,
  APARATO_LABEL,
  MUDANZA_BASE,
  MUDANZA_M3_TIPICO,
  MUDANZA_AMB_LABEL,
  MUDANZA_PISO_CON_ASC,
  MUDANZA_PISO_SIN_ASC,
  MUDANZA_PISO_LABEL,
  MUDANZA_KM_CERCA,
  MUDANZA_KM_LEJOS,
} from '../../lib/hubs/gastos-de-la-casa';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    EXPENSAS_BASE_M2,
    EXPENSAS_ZONA_LABEL,
    EXPENSAS_AMENITIES,
    SEGURO_TASA,
    SEGURO_ZONA,
    SEGURO_COBERTURA_LABEL,
    VIDA_UTIL,
    APARATO_LABEL,
    MUDANZA_BASE,
    MUDANZA_M3_TIPICO,
    MUDANZA_AMB_LABEL,
    MUDANZA_PISO_CON_ASC,
    MUDANZA_PISO_SIN_ASC,
    MUDANZA_PISO_LABEL,
    MUDANZA_KM_CERCA,
    MUDANZA_KM_LEJOS,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });

    /** Ajuste por cantidad de unidades. Espejo de expensas-departamento-estimado.ts. */
    function factorUnidades(u) {
      if (u > 40) return 0.85;
      if (u > 20) return 0.92;
      if (u < 10) return 1.15;
      return 1;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'expensas';

      // ── 1. Expensas del departamento ─────────────────────────────────────
      if (id === 'expensas') {
        const m2 = Math.max(1, Number(v.superficieM2) || 45);
        const zona = String(v.zona || 'caba-media');
        const amen = String(v.amenities || 'no');
        const unidades = Math.max(1, Number(v.unidades) || 20);

        const fAmen = EXPENSAS_AMENITIES[amen] != null ? EXPENSAS_AMENITIES[amen] : 1;
        const fUnid = factorUnidades(unidades);
        const baseM2 = EXPENSAS_BASE_M2[zona] != null ? EXPENSAS_BASE_M2[zona] : 800;

        const costoM2 = baseM2 * fAmen * fUnid;
        const expensas = m2 * costoM2;
        const minimo = expensas * 0.75;
        const maximo = expensas * 1.3;

        const amenLabel = amen === 'completo' ? 'amenities completos' : amen === 'basico' ? 'amenities básicos' : 'sin amenities';

        return {
          total: H.ars(Math.round(expensas)) + ' por mes',
          sub:
            m2 + ' m² en ' + (EXPENSAS_ZONA_LABEL[zona] || zona) + ', ' + amenLabel + ', ~' + unidades +
            ' unidades: ' + H.ars(Math.round(costoM2)) + '/m² · esperá entre ' + H.ars(Math.round(minimo)) +
            ' y ' + H.ars(Math.round(maximo)) + ' según el edificio real. Pedí el último balance antes de firmar.',
          rows: [
            { k: 'Expensa mensual estimada', ref: m2 + ' m² × ' + H.ars(Math.round(costoM2)) + '/m²', v: Math.round(expensas), extra: true },
            { k: 'Costo por metro cuadrado', ref: 'base ' + H.ars(baseM2) + '/m² de la zona', v: Math.round(costoM2) },
            { k: 'Piso del rango razonable', ref: '-25%', v: Math.round(minimo) },
            { k: 'Techo del rango razonable', ref: '+30%', v: Math.round(maximo) },
            { k: 'Recargo por amenities', ref: fAmen > 1 ? '×' + nf(fAmen, 2) : 'sin amenities', v: Math.round(m2 * baseM2 * fUnid * (fAmen - 1)) },
            { k: 'Ajuste por cantidad de unidades', ref: '×' + nf(fUnid, 2), v: Math.round(m2 * baseM2 * fAmen * (fUnid - 1)) },
            { k: 'Expensas en un año', v: Math.round(expensas * 12) },
          ],
          chart: Object.keys(EXPENSAS_BASE_M2).map(function (z) {
            return {
              label: EXPENSAS_ZONA_LABEL[z],
              value: Math.round(m2 * EXPENSAS_BASE_M2[z] * fAmen * fUnid),
              tone: z === zona ? 'main' : 'prop',
            };
          }),
        };
      }

      // ── 2. Mantenimiento anual de la casa ────────────────────────────────
      if (id === 'mantenimiento') {
        const expensas = Math.max(0, Number(v.expensasMensual) || 0) * 12;
        const servicios = Math.max(0, Number(v.serviciosMensual) || 0) * 12;
        const impuestos = Math.max(0, Number(v.impuestosAnual) || 0);
        const seguro = Math.max(0, Number(v.seguroAnual) || 0);
        const reparaciones = Math.max(0, Number(v.reparacionesAnual) || 0);
        const limpieza = Math.max(0, Number(v.limpiezaMensual) || 0) * 12;
        const jardineria = Math.max(0, Number(v.jardineriaMensual) || 0) * 12;
        const otros = Math.max(0, Number(v.otrosAnual) || 0);

        const total = expensas + servicios + impuestos + seguro + reparaciones + limpieza + jardineria + otros;
        const mensual = total / 12;
        const diario = total / 365;

        const rubros = [
          { label: 'Expensas', value: expensas, tone: 'main' },
          { label: 'Servicios', value: servicios, tone: 'warn' },
          { label: 'Impuestos', value: impuestos, tone: 'exit' },
          { label: 'Seguro', value: seguro, tone: 'good' },
          { label: 'Reparaciones', value: reparaciones, tone: 'bad' },
          { label: 'Limpieza', value: limpieza, tone: 'prop' },
          { label: 'Jardinería', value: jardineria, tone: 'good' },
          { label: 'Otros', value: otros, tone: 'prop' },
        ].filter(function (r) { return r.value > 0; });

        const mayor = rubros.length ? rubros.reduce(function (a, b) { return b.value > a.value ? b : a; }) : null;
        const pctMayor = mayor && total > 0 ? Math.round((mayor.value / total) * 100) : 0;

        return {
          total: H.ars(Math.round(total)) + ' por año',
          sub:
            'Mantener la casa te sale ' + H.ars(Math.round(mensual)) + ' por mes y ' + H.ars(Math.round(diario)) +
            ' por día' +
            (mayor ? ' · el rubro más pesado es ' + mayor.label.toLowerCase() + ' con ' + H.ars(Math.round(mayor.value)) + ' al año (' + pctMayor + '% del total)' : '') +
            ' · los servicios van como un solo renglón: la boleta de luz y la de gas y agua se desglosan aparte.',
          rows: [
            { k: 'Gasto total del año', v: Math.round(total), extra: true },
            { k: 'Promedio mensual', v: Math.round(mensual) },
            { k: 'Costo por día', v: Math.round(diario) },
            { k: 'Expensas', ref: 'mensual × 12', v: Math.round(expensas) },
            { k: 'Servicios (luz, gas, agua, internet)', ref: 'mensual × 12', v: Math.round(servicios) },
            { k: 'Impuestos (ABL, inmobiliario)', v: Math.round(impuestos) },
            { k: 'Seguro de hogar', v: Math.round(seguro) },
            { k: 'Reparaciones', v: Math.round(reparaciones) },
            { k: 'Limpieza', ref: 'mensual × 12', v: Math.round(limpieza) },
            { k: 'Jardinería y exterior', ref: 'mensual × 12', v: Math.round(jardineria) },
            { k: 'Otros gastos', v: Math.round(otros) },
          ],
          chart: rubros.map(function (r) { return { label: r.label, value: Math.round(r.value), tone: r.tone }; }),
        };
      }

      // ── 3. Seguro de hogar ───────────────────────────────────────────────
      if (id === 'seguro') {
        const m2 = Math.max(1, Number(v.metrosCuadrados) || 70);
        const valorM2 = Math.max(0, Number(v.valorM2) || 0);
        const contenido = Math.max(0, Number(v.valorContenido) || 0);
        const zona = String(v.zonaRiesgo || 'media');
        const cob = String(v.cobertura || 'intermedia');

        const valorEdificio = m2 * valorM2;
        const sumaTotal = valorEdificio + contenido;

        const fZona = SEGURO_ZONA[zona] != null ? SEGURO_ZONA[zona] : 1;
        const tasa = (SEGURO_TASA[cob] != null ? SEGURO_TASA[cob] : 0.008) * fZona;

        const primaAnual = sumaTotal * tasa;
        const primaMensual = primaAnual / 12;
        const pctContenido = sumaTotal > 0 ? (contenido / sumaTotal) * 100 : 0;

        return {
          total: H.ars(Math.round(primaMensual)) + ' por mes',
          sub:
            'Asegurar ' + H.ars(Math.round(sumaTotal)) + ' con cobertura ' + (SEGURO_COBERTURA_LABEL[cob] || cob).toLowerCase() +
            ' en zona de riesgo ' + zona + ' cuesta unos ' + H.ars(Math.round(primaAnual)) + ' al año (tasa ' +
            nf(tasa * 100, 2) + '% anual). El contenido es el ' + nf(pctContenido, 0) +
            '% de la suma asegurada: revisá que alcance para reponer muebles y electrónica a valor de reposición.',
          rows: [
            { k: 'Prima mensual estimada', ref: 'tasa ' + nf(tasa * 100, 2) + '% anual', v: Math.round(primaMensual), extra: true },
            { k: 'Prima anual', v: Math.round(primaAnual) },
            { k: 'Suma asegurada total', v: Math.round(sumaTotal) },
            { k: 'Valor del edificio a reconstruir', ref: m2 + ' m² × ' + H.ars(valorM2) + '/m²', v: Math.round(valorEdificio) },
            { k: 'Valor del contenido', ref: nf(pctContenido, 0) + '% de la suma asegurada', v: Math.round(contenido) },
            { k: 'Prima anual con cobertura básica', ref: '0,40% × zona', v: Math.round(sumaTotal * SEGURO_TASA.basica * fZona) },
            { k: 'Prima anual con cobertura intermedia', ref: '0,80% × zona', v: Math.round(sumaTotal * SEGURO_TASA.intermedia * fZona) },
            { k: 'Prima anual con cobertura completa', ref: '1,20% × zona', v: Math.round(sumaTotal * SEGURO_TASA.completa * fZona) },
          ],
          chart: ['basica', 'intermedia', 'completa'].map(function (c) {
            return {
              label: SEGURO_COBERTURA_LABEL[c],
              value: Math.round(sumaTotal * SEGURO_TASA[c] * fZona),
              tone: c === cob ? 'main' : 'prop',
            };
          }),
        };
      }

      // ── 4. Reparar o reemplazar el electrodoméstico ──────────────────────
      // Única rama que NO es plata: devuelve % de vida útil y años.
      if (id === 'electro') {
        const ap = String(v.aparato || 'heladera');
        const edad = Math.max(0, Number(v.edadAnios) || 0);
        const vida = VIDA_UTIL[ap] != null ? VIDA_UTIL[ap] : 10;
        const pct = Math.min(100, Math.round((edad / vida) * 100));
        const restantes = Math.max(0, Math.round((vida - edad) * 10) / 10);

        const decision = pct < 50 ? 'Reparar conviene' : pct < 80 ? 'Evaluar costo de reparación' : 'Conviene reemplazar';
        const umbral = pct < 50 ? 30 : pct < 80 ? 40 : 0;
        const consejo =
          pct < 50
            ? 'El aparato está en su primera mitad de vida: una reparación de menos del 30% del valor de uno nuevo es buena inversión.'
            : pct < 80
              ? 'Si la reparación cuesta más del 40% de uno nuevo, conviene reemplazar por un equipo de mejor eficiencia energética.'
              : 'Está en la recta final: un equipo nuevo clase A va a ser más eficiente y confiable.';

        return {
          total: pct + '% de vida útil consumida',
          sub:
            decision + ' · con ' + nf(edad, edad % 1 ? 1 : 0) + ' años de uso, tu ' + (APARATO_LABEL[ap] || ap) +
            ' consumió el ' + pct + '% de una vida útil típica de ' + vida + ' años; le quedan ~' + nf(restantes, 1) +
            ' años. ' + consejo,
          format: 'plain',
          decimals: 0,
          rows: [
            { k: 'Vida útil consumida', ref: decision, v: pct, format: 'unit', unit: '%', decimals: 0, extra: true },
            { k: 'Vida útil típica del aparato', v: vida, format: 'unit', unit: 'años', decimals: 0 },
            { k: 'Años de uso que lleva', v: edad, format: 'unit', unit: 'años', decimals: 1 },
            { k: 'Años que le quedan', v: restantes, format: 'unit', unit: 'años', decimals: 1 },
            {
              k: 'Reparación tolerable, sobre el precio de uno nuevo',
              ref: umbral > 0 ? 'umbral de conveniencia' : 'a esta altura conviene reemplazar',
              v: umbral,
              format: 'unit',
              unit: '%',
              decimals: 0,
            },
          ],
          chart: [
            { label: 'Años ya usados', value: Math.min(edad, vida), tone: 'warn' },
            { label: 'Años restantes', value: restantes, tone: 'good' },
          ],
        };
      }

      // ── 5. Mudanza ───────────────────────────────────────────────────────
      // Motor unificado: base por ambientes escalada por m³ + km + recargo de altura.
      const amb = String(v.ambientes || '2-dormitorios');
      const km = Math.max(0, Number(v.distanciaKm) || 0);
      const piso = String(v.piso || 'pb');
      const asc = String(v.ascensor || 'si') === 'no' ? 'no' : 'si';

      const baseAmb = MUDANZA_BASE[amb] != null ? MUDANZA_BASE[amb] : 140000;
      const m3Tipico = MUDANZA_M3_TIPICO[amb] != null ? MUDANZA_M3_TIPICO[amb] : 20;
      const m3Input = Math.max(0, Number(v.m3Carga) || 0);
      const m3 = m3Input > 0 ? m3Input : m3Tipico;
      const factorVolumen = m3 / m3Tipico;

      const base = baseAmb * factorVolumen;
      const costoKm = Math.min(km, 10) * MUDANZA_KM_CERCA + Math.max(0, km - 10) * MUDANZA_KM_LEJOS;

      const tablaPiso = asc === 'no' ? MUDANZA_PISO_SIN_ASC : MUDANZA_PISO_CON_ASC;
      const multPiso = tablaPiso[piso] != null ? tablaPiso[piso] : 1;

      const subtotal = base + costoKm;
      const recargoPiso = subtotal * (multPiso - 1);
      const total = Math.round((subtotal * multPiso) / 1000) * 1000; // redondeo a miles, como la fórmula original

      const pctRecargo = Math.round((multPiso - 1) * 100);
      const sinAscAlto = asc === 'no' && (piso === '4-6' || piso === '7-mas');

      return {
        total: H.ars(total),
        sub:
          'Mudanza de ' + (MUDANZA_AMB_LABEL[amb] || amb) + ' (' + nf(m3, m3 % 1 ? 1 : 0) + ' m³) a ' + nf(km, 0) +
          ' km, ' + (MUDANZA_PISO_LABEL[piso] || piso) + ' ' + (asc === 'no' ? 'sin ascensor' : 'con ascensor') + ': ' +
          H.ars(total) +
          (pctRecargo > 0
            ? ' · el recargo de altura suma un ' + pctRecargo + '%' + (sinAscAlto ? ' porque hay que subir todo a pulso' : '')
            : ' · sin recargo de altura') +
          '. Pedí 3 presupuestos con seguro de la carga incluido: embalaje y guardamuebles se cotizan aparte.',
        rows: [
          { k: 'Costo estimado del flete', ref: 'redondeado a miles', v: total, extra: true },
          {
            k: 'Base por tamaño y volumen',
            ref: H.ars(baseAmb) + ' de ' + (MUDANZA_AMB_LABEL[amb] || amb) + (factorVolumen !== 1 ? ' × ' + nf(factorVolumen, 2) + ' por volumen' : ''),
            v: Math.round(base),
          },
          { k: 'Kilómetros', ref: 'los primeros 10 km a ' + H.ars(MUDANZA_KM_CERCA) + ', el resto a ' + H.ars(MUDANZA_KM_LEJOS), v: Math.round(costoKm) },
          { k: 'Recargo por altura', ref: pctRecargo > 0 ? '+' + pctRecargo + '% (' + (asc === 'no' ? 'sin ascensor' : 'con ascensor') + ')' : 'sin recargo', v: Math.round(recargoPiso) },
          { k: 'Precio por metro cúbico', ref: nf(m3, m3 % 1 ? 1 : 0) + ' m³ de carga', v: m3 > 0 ? Math.round(total / m3) : 0 },
          { k: 'Precio por kilómetro', ref: km > 0 ? nf(km, 0) + ' km' : 'sin distancia cargada', v: km > 0 ? Math.round(total / km) : 0 },
          { k: 'Lo mismo sin recargo de altura', ref: 'si mudás desde planta baja', v: Math.round(subtotal) },
        ],
        chart: [
          { label: 'Base por volumen', value: Math.round(base), tone: 'main' },
          { label: 'Kilómetros', value: Math.round(costoKm), tone: 'prop' },
          { label: 'Recargo por altura', value: Math.round(recargoPiso), tone: sinAscAlto ? 'bad' : 'warn' },
        ],
      };
    });
  })();
</script>
