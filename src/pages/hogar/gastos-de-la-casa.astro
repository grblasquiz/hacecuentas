---
/**
 * Hub de decisión — "¿Cuánto me cuesta la casa además del alquiler o la cuota?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 5 casos (expensas / mantenimiento anual / seguro /
 * reparar o reemplazar / mudanza).
 *
 * OJO con el formato: 4 de las 5 ramas son plata, pero la rama `electro`
 * devuelve porcentajes y años. Todas sus filas declaran `format` explícito
 * ('unit' o 'plain'), porque el runtime hace Object.assign y una fila sin
 * formato propio se imprimiría con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import GastosCasaExperience from '../../components/generated/GastosCasaExperience.astro';
import {
  hub,
  EXPENSAS_BASE_M2,
  EXPENSAS_ZONA_LABEL,
  EXPENSAS_AMENITIES,
  SEGURO_TASA,
  SEGURO_ZONA,
  SEGURO_COBERTURA_LABEL,
  VIDA_UTIL,
  APARATO_LABEL,
  MUDANZA_BASE,
  MUDANZA_M3_TIPICO,
  MUDANZA_AMB_LABEL,
  MUDANZA_PISO_CON_ASC,
  MUDANZA_PISO_SIN_ASC,
  MUDANZA_PISO_LABEL,
  MUDANZA_KM_CERCA,
  MUDANZA_KM_LEJOS,
} from '../../lib/hubs/gastos-de-la-casa';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <GastosCasaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

