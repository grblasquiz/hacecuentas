---
/**
 * Hub de decisión — "Gas y agua: ¿cuánto voy a pagar?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (gas de red / zona fría / garrafa / agua).
 * La página sólo aporta datos (src/lib/hubs/factura-gas-agua.ts) y compute().
 *
 * Sólo tres ramas son plata. Los m³, kg, días, kWh, litros y porcentajes
 * declaran `format: 'unit'` en TODAS sus filas: el runtime hace Object.assign
 * y una fila sin formato propio caería a pesos con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import GasAguaExperience from '../../components/generated/GasAguaExperience.astro';
import {
  hub,
  GAS_CUADRO,
  FACTOR_LITORAL,
  DESCUENTO_SUBSIDIO,
  DESCUENTO_ZONA_FRIA,
  GAS_IVA,
  GAS_TASAS,
  GAS_FACTOR_IMPUESTOS,
  GARRAFA_KG,
  GARRAFA_CONSUMO_BASE,
  GARRAFA_PERSONAS_BASE,
  KWH_POR_M3_GAS_NATURAL,
  KWH_POR_KG_GLP,
  AGUA,
  AGUA_EFICIENTE,
  OMS_LITROS_PERSONA_DIA,
  DIAS_MES,
  MESES_BIMESTRE,
} from '../../lib/hubs/factura-gas-agua';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <GasAguaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

