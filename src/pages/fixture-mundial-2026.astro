                    {d.matches.map((m) => {
                      const t1 = teamLabel(m.team1);
                      const t2 = teamLabel(m.team2);
                      const r = sc(m);
                      const isNext = nextOverall && m.num === nextOverall.num;
                      const st = statusOf(m);
                      const phaseKey = (PHASE_DEFS.find((p) => p.is(m)) || {}).key || '';
                      return (
                        <article
                          id={matchFragment(m)}
                          class={`fx-mcard${isNext ? ' is-next' : ''}${r ? ' is-played' : ''}`}
                          data-match data-num={m.num} data-team1={m.team1} data-team2={m.team2}
                          data-phase={phaseKey} data-teams={`${m.team1 || ''} ${m.team2 || ''}`} data-search={slugTeams(m)}
