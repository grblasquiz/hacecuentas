---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PushOptIn from '../components/PushOptIn.astro';
import WeekendPackCapture from '../components/WeekendPackCapture.astro';
import '../styles/fixture-mundial.css';
// El script se inlinea verbatim (?raw): en este proyecto `astro dev` no sirve
// /public y los assets bundleados-hoisted 404ean; inline funciona en dev y prod.
import fxScript from '../scripts/fixture-mundial.js?raw';
import {
  fixture,
  LIVE_FIXTURE_URL,
  TEAMS,
  teamLabel,
  roundLabel,
  phaseOf,
  artTime,
  artDayKey,
  artDayLabel,
  kickoffUTC,
  result,
  WORLD_CUP_EVENT,
  worldCupMatchEvent,
} from '../lib/data/mundial-2026.ts';

// Calcs de fútbol para el funnel (se resuelven del catálogo para tomar título/icono).
const calcModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });

// Última nota "partidos del finde" (una por semana) — link evergreen.
const findeModules = import.meta.glob<any>('../content/blog/partidos-mundial-finde-*.json', { eager: true });
const findePost = Object.values(findeModules)
  .map((m: any) => m.default ?? m)
  .sort((a: any, b: any) => String(b.date || '').localeCompare(String(a.date || '')))[0];
const bySlug = new Map(
  Object.values(calcModules).map((m: any) => {
    const c = m.default || m;
    return [c.slug, c];
  })
);
// Sólo calcs VIVAS (post-poda del cluster 2026): las que quedaron son las que
// siguen teniendo sentido con el torneo terminado.
const featuredSlugs = [
  'calculadora-premios-mundial-2026-seleccion-por-fase',
  'calculadora-mundial-2026-bonus-jugador-fase',
  'calculadora-mundial-2026-estadios-comparador',
  'calculadora-mundial-2026-predictor-campeon-ranking',
  'calculadora-record-messi-goles-competencia-club-seleccion',
  'calculadora-mundial-2026-cupos-confederacion',
];
const featured = featuredSlugs.map((s) => bySlug.get(s)).filter(Boolean);

// ── Agrupar el fixture por día (hora argentina) ──────────────────────────────
const sorted = [...fixture.matches].sort((a, b) => {
  const ka = kickoffUTC(a.date, a.time)?.getTime() ?? 0;
  const kb = kickoffUTC(b.date, b.time)?.getTime() ?? 0;
  if (ka !== kb) return ka - kb;
  return a.num - b.num;
});

interface Day {
  key: string;
  label: string;
  matches: typeof sorted;
}
const dayMap = new Map<string, Day>();
for (const m of sorted) {
  const key = artDayKey(m.date, m.time);
  if (!dayMap.has(key)) dayMap.set(key, { key, label: artDayLabel(m.date, m.time), matches: [] as any });
  dayMap.get(key)!.matches.push(m);
}
const days = [...dayMap.values()];

// Hoy (al momento del build) en hora argentina
const todayKey = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'America/Argentina/Buenos_Aires',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());

// Estado del torneo
const played = fixture.matches.filter((m) => m.score && m.score.ft).length;
const total = fixture.total || fixture.matches.length;
const teamsCount = 48;

// Día a mostrar destacado: hoy si hay partidos, si no el próximo día con partidos
const todayDay = days.find((d) => d.key === todayKey);
const nextDay = days.find((d) => d.key >= todayKey) || days[days.length - 1];
const featuredDay = todayDay || nextDay;
const isFeaturedToday = !!todayDay;

// Próximo partido global (el primero sin jugar por orden cronológico)
const nextOverall = sorted.find((m) => !(m.score && m.score.ft));

// Chips de fecha (ventana de 6 días desde el destacado)
const fIdx = Math.max(0, days.findIndex((d) => d.key === featuredDay.key));
const chipDays = days.slice(fIdx, fIdx + 6);

// Tira de fechas del calendario (todas las jornadas, scroll horizontal)
const AR_ZONE = 'America/Argentina/Buenos_Aires';
const calChips = days.map((d) => {
  const k = kickoffUTC(d.matches[0].date, d.matches[0].time)!;
  const wd = new Intl.DateTimeFormat('es-AR', { timeZone: AR_ZONE, weekday: 'short' }).format(k).replace('.', '');
  const dm = new Intl.DateTimeFormat('es-AR', { timeZone: AR_ZONE, day: '2-digit', month: 'short' }).format(k).replace('.', '');
  return { key: d.key, label: `${wd} ${dm}`.toUpperCase(), isToday: d.key === todayKey };
});

// Meses presentes (para el filtro del calendario)
const monthLabelFmt = (ym: string) => {
  const [y, mo] = ym.split('-').map(Number);
  const d = new Date(Date.UTC(y, (mo || 1) - 1, 15, 15, 0, 0));
  const l = new Intl.DateTimeFormat('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', month: 'long', year: 'numeric' }).format(d);
  return l.charAt(0).toUpperCase() + l.slice(1);
};
const monthKeys = [...new Set(days.map((d) => d.key.slice(0, 7)))];
const months = monthKeys.map((k) => ({ key: k, label: monthLabelFmt(k) }));

// Selecciones presentes (nombres resueltos) para el filtro
const teamsPresent = [...new Set(sorted.flatMap((m) => [m.team1, m.team2]).filter((t): t is string => !!t && t in TEAMS))]
  .map((name) => ({ name, es: TEAMS[name].es, flag: TEAMS[name].flag }))
  .sort((a, b) => a.es.localeCompare(b.es, 'es'));

// ── Fases / bracket ──────────────────────────────────────────────────────────
const PHASE_DEFS = [
  { key: 'grupos', label: 'Fase de grupos', short: 'Fase de grupos', tiny: 'Grupos', is: (m: any) => /^Matchday/.test(m.round) },
  { key: 'r32', label: 'Dieciseisavos', short: '16avos', tiny: '16avos', is: (m: any) => m.round === 'Round of 32' },
  { key: 'r16', label: 'Octavos de final', short: 'Octavos', tiny: 'Octavos', is: (m: any) => m.round === 'Round of 16' },
  { key: 'qf', label: 'Cuartos de final', short: 'Cuartos', tiny: 'Cuartos', is: (m: any) => m.round === 'Quarter-final' },
  { key: 'sf', label: 'Semifinales', short: 'Semifinales', tiny: 'Semis', is: (m: any) => m.round === 'Semi-final' },
  { key: 'final', label: 'Final', short: 'Final', tiny: 'Final', is: (m: any) => m.round === 'Final' },
];
let currentSeen = false;
const phaseView = PHASE_DEFS.map((p) => {
  const ms = fixture.matches.filter(p.is);
  const pl = ms.filter((m) => m.score && m.score.ft).length;
  let status: 'done' | 'current' | 'upcoming';
  if (ms.length > 0 && pl >= ms.length) status = 'done';
  else if (!currentSeen) { status = 'current'; currentSeen = true; } else status = 'upcoming';
  return { ...p, total: ms.length, played: pl, matches: ms, status };
});
const currentPhase = phaseView.find((p) => p.status === 'current') || phaseView[phaseView.length - 1];

// Bracket: cuartos → semis → final (pairing secuencial estándar del cuadro FIFA)
const qfMatches = fixture.matches.filter((m) => m.round === 'Quarter-final').sort((a, b) => a.num - b.num);
const sfMatches = fixture.matches.filter((m) => m.round === 'Semi-final').sort((a, b) => a.num - b.num);
const finalMatch = fixture.matches.find((m) => m.round === 'Final');
const thirdMatch = fixture.matches.find((m) => m.round === 'Match for third place');
let bracketGroups = sfMatches.map((sf, i) => ({ sf, qfs: [qfMatches[2 * i], qfMatches[2 * i + 1]].filter(Boolean) }));
// El grupo con Argentina va primero (como el mockup)
const hasArg = (g: any) => g.qfs.some((m: any) => m.team1 === 'Argentina' || m.team2 === 'Argentina');
bracketGroups = [...bracketGroups].sort((a, b) => (hasArg(b) ? 1 : 0) - (hasArg(a) ? 1 : 0));

// Vista Lista: fases (más reciente primero) con el tercer puesto justo tras la final.
const listPhases: any[] = [];
for (const p of [...phaseView].reverse()) {
  listPhases.push(p);
  if (p.key === 'final' && thirdMatch) {
    listPhases.push({ key: 'third', label: 'Tercer puesto', short: 'Tercer puesto', total: 1, matches: [thirdMatch] });
  }
}

// ── Argentina ─────────────────────────────────────────────────────────────────
const argMatches = sorted.filter((m) => m.team1 === 'Argentina' || m.team2 === 'Argentina');
const argNext = argMatches.find((m) => !(m.score && m.score.ft)) || argMatches[argMatches.length - 1];
const argNextUtc = argNext ? kickoffUTC(argNext.date, argNext.time)?.toISOString() || '' : '';
const argNextOpp = argNext ? teamLabel(argNext.team1 === 'Argentina' ? argNext.team2 : argNext.team1) : null;
// Progreso de Argentina por fase macro
const argPhaseView = PHASE_DEFS.map((p) => {
  const ms = argMatches.filter(p.is);
  let state: 'done' | 'current' | 'future';
  if (!ms.length) state = 'future';
  else if (ms.every((m) => m.score && m.score.ft)) state = 'done';
  else state = 'current';
  return { ...p, state, matches: ms };
});
const argCurrentIdx = argPhaseView.findIndex((p) => p.state === 'current');

// ── Etiquetas de estado por partido ────────────────────────────────────────────
function statusOf(m: any): string {
  if (m.score && m.score.ft) return 'FINAL';
  if (nextOverall && m.num === nextOverall.num) return 'PRÓXIMO';
  return '';
}
function badgeOf(m: any): string {
  const s = statusOf(m);
  const rl = m.group ? roundLabel(m.round) : roundLabel(m.round);
  return s ? `${s} · ${rl}` : rl;
}
function slugTeams(m: any): string {
  const a = teamLabel(m.team1), b = teamLabel(m.team2);
  return `${a.es} ${b.es}`.toLowerCase();
}
const matchTitle=(m:any)=>`${teamLabel(m.team1).es} - ${teamLabel(m.team2).es}`;
const matchFragment=(m:any)=>`partido-${matchTitle(m).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-')}-${m.num}`;
function groundShort(g: string | null): string {
  if (!g) return '';
  // "Miami (Miami Gardens)" → "Miami Gardens" ; "New York/New Jersey (East Rutherford)" → "East Rutherford"
  const m = g.match(/\(([^)]+)\)/);
  return m ? m[1] : g;
}
// ¿El partido se juega hoy (en hora argentina)?
function argDayIsToday(m: any): boolean {
  return artDayKey(m.date, m.time) === todayKey;
}
// Resultado con marcador DECISIVO (alargue si lo hubo) + detalle corto.
// El mockup muestra "1 – 2 · Tras alargue" (no el 1-1 del tiempo reglamentario).
function sc(m: any): { a: number; b: number; detail: string; winner: 0 | 1 | 2 } | null {
  if (!m.score || !m.score.ft) return null;
  const base = m.score.et || m.score.ft;
  const a = base[0], b = base[1];
  let detail = '';
  let winner: 0 | 1 | 2 = a > b ? 1 : b > a ? 2 : 0;
  if (m.score.et) detail = 'Tras alargue';
  if (m.score.p) { detail = `Penales ${m.score.p[0]}-${m.score.p[1]}`; winner = m.score.p[0] > m.score.p[1] ? 1 : 2; }
  return { a, b, detail, winner };
}

// "Actualizado" en hora argentina
const updatedLabel = new Intl.DateTimeFormat('es-AR', {
  timeZone: 'America/Argentina/Buenos_Aires',
  day: '2-digit',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date(fixture.fetchedAt));
const updatedTime = new Intl.DateTimeFormat('es-AR', {
  timeZone: 'America/Argentina/Buenos_Aires', hour: '2-digit', minute: '2-digit', hour12: false,
}).format(new Date(fixture.fetchedAt));

// ── SEO ──────────────────────────────────────────────────────────────────────
const title = 'Mundial 2026: resultados, campeón y fixture completo';
const description =
  'España campeón del Mundial 2026: consultá los resultados de los 104 partidos, el fixture completo, grupos y cruces de Estados Unidos, México y Canadá.';
const canonical = '/fixture-mundial-2026';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
    { '@type': 'ListItem', position: 2, name: 'Mundial 2026', item: 'https://hacecuentas.com/mundial-2026' },
    { '@type': 'ListItem', position: 3, name: 'Fixture y resultados', item: 'https://hacecuentas.com/fixture-mundial-2026' },
  ],
};
const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Fixture y resultados del Mundial 2026',
  description:
    'Calendario completo de los 104 partidos del Mundial 2026 con fechas, horarios, sedes y resultados finales del torneo.',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  isBasedOn: 'https://github.com/openfootball/worldcup.json',
  temporalCoverage: '2026-06-11/2026-07-19',
  dateModified: fixture.fetchedAt,
  url: 'https://hacecuentas.com/fixture-mundial-2026',
};
const faqItems = [
  {
    q: '¿Cuándo empezó y terminó el Mundial 2026?',
    a: 'El Mundial 2026 arrancó el 11 de junio de 2026 con el partido inaugural de México y terminó con la final el 19 de julio de 2026. Fue el primero con 48 selecciones, 104 partidos y tres países sede: Estados Unidos, México y Canadá.',
  },
  {
    q: '¿En qué grupo jugó Argentina en el Mundial 2026?',
    a: 'Argentina, campeona defensora tras Qatar 2022, integró el Grupo J junto a Argelia, Austria y Jordania. Su camino completo, partido por partido, está en la pestaña Argentina del fixture.',
  },
  {
    q: '¿Cómo funciona el nuevo formato de 48 selecciones?',
    a: 'Hubo 12 grupos de 4 equipos. Clasificaron a la siguiente ronda los dos primeros de cada grupo (24 selecciones) más los 8 mejores terceros: 32 equipos que arrancaron en los dieciseisavos de final (Round of 32). De ahí en adelante fue eliminación directa hasta la final.',
  },
  {
    q: '¿A qué hora juega cada partido en mi país?',
    a: 'Con el selector de país arriba del fixture podés ver todos los horarios en tu hora local: Argentina, México, Colombia, Chile, Perú, Ecuador, Venezuela, Paraguay, Uruguay, Bolivia, Brasil, España y EE.UU. Por defecto se muestran en hora de Argentina (UTC-3). Como las sedes están en zonas horarias de Norteamérica (UTC-4 a UTC-7), un partido del mediodía local suele verse a media tarde o noche en Sudamérica; en España es de madrugada del día siguiente (por eso algunos aparecen con "+1").',
  },
  {
    q: '¿De dónde salen los resultados?',
    a: 'Los datos provienen del proyecto de código abierto openfootball (dominio público). Con el torneo finalizado, los 104 partidos están cargados con sus marcadores definitivos.',
  },
  {
    q: '¿Cuántos partidos hay en total?',
    a: `El Mundial 2026 tuvo ${total} partidos: 72 de fase de grupos y 32 de eliminatorias (dieciseisavos, octavos, cuartos, semifinales, tercer puesto y final). Fue un 60% más de partidos que en Qatar 2022, que tuvo 64.`,
  },
  {
    q: '¿Quién ganó el Mundial 2026?',
    a: 'España ganó el Mundial 2026: venció 1-0 a Argentina en la final del 19 de julio, con gol en el alargue. El detalle completo, con el palmarés histórico, está en la página del campeón del Mundial 2026.',
  },
  {
    q: '¿Cuándo fue la final del Mundial 2026?',
    a: 'La final se jugó el domingo 19 de julio de 2026 en el MetLife Stadium de Nueva Jersey (Estados Unidos). El partido por el tercer puesto fue el día anterior, el sábado 18 de julio.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const matchEvents={'@type':'ItemList',name:'Partidos del Mundial 2026',itemListElement:fixture.matches.map((m:any,index:number)=>({'@type':'ListItem',position:index+1,item:worldCupMatchEvent(m,`https://hacecuentas.com/fixture-mundial-2026#${matchFragment(m)}`)}))};
const schema = { '@context': 'https://schema.org', '@graph': [breadcrumb, WORLD_CUP_EVENT, matchEvents, dataset, faqSchema] };

// Datos para el script client-side (refresh en vivo + re-render de "hoy").
const daysData = days.map((d) => ({
  key: d.key,
  label: d.label,
  matches: d.matches.map((m) => ({
    num: m.num,
    badge: badgeOf(m),
    round: roundLabel(m.round),
    time: artTime(m.date, m.time),
    utc: kickoffUTC(m.date, m.time)?.toISOString() || '',
    team1: m.team1,
    team2: m.team2,
    ground: groundShort(m.ground),
    score: m.score,
    isNext: nextOverall ? m.num === nextOverall.num : false,
  })),
}));
const liveConfig = {
  url: LIVE_FIXTURE_URL,
  teams: TEAMS,
  todayKey,
  days: daysData,
  argNextUtc,
};
---

<Layout title={title} description={description} canonical={canonical} audience="global" schema={schema} domain="life">
  <Header />
  <main class="article-main">
    <article class="fx-page" data-fx>

      <!-- ── Hero ─────────────────────────────────────────────────────────── -->
      <header class="fx-hero">
        <span class="fx-live-pill"><span class="fx-live-dot"></span>Torneo finalizado</span>
        <h1 class="fx-hero-title">Mundial 2026: resultados, campeón y fixture</h1>
        <p class="fx-hero-sub">España campeón · Los 104 partidos, grupos y cruces eliminatorios</p>
        <div class="fx-hero-meta">
          <span class="fx-hm"><svg viewBox="0 0 24 24" class="fx-i" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a15 15 0 0 0 0 18M12 3a15 15 0 0 1 0 18M3.5 9h17M3.5 15h17"/></svg><strong>{total}</strong> partidos</span>
          <span class="fx-hm"><svg viewBox="0 0 24 24" class="fx-i" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M4 20a5 5 0 0 1 10 0M15.5 5.5a3 3 0 0 1 0 5M17 20a5 5 0 0 0-3-4.6"/></svg><strong>{teamsCount}</strong> selecciones</span>
          <span class="fx-hm"><svg viewBox="0 0 24 24" class="fx-i" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Actualizado <strong data-live-updated>{updatedTime}</strong></span>
        </div>
      </header>

      <WeekendPackCapture source="fixture" />

      <!-- ── Tab bar + selector de zona horaria ───────────────────────────── -->
      <div class="fx-tabwrap">
        <div class="fx-tabs" role="tablist" aria-label="Vistas del fixture">
          <button class="fx-tab is-active" role="tab" data-fxtab="hoy" aria-selected="true">Hoy</button>
          <button class="fx-tab" role="tab" data-fxtab="calendario" aria-selected="false">Calendario</button>
          <button class="fx-tab" role="tab" data-fxtab="argentina" aria-selected="false">Argentina</button>
          <button class="fx-tab" role="tab" data-fxtab="fases" aria-selected="false">Fases</button>
        </div>
        <div class="fx-tzpill">
          <span class="fx-tzflag" data-tz-flag>🇦🇷</span>
          <label class="sr-only" for="fx-tz">Elegí tu país para ver los horarios en tu hora local</label>
          <select id="fx-tz" aria-label="Zona horaria">
            <option value="America/Argentina/Buenos_Aires" data-flag="🇦🇷">Hora de Argentina</option>
            <option value="America/Mexico_City" data-flag="🇲🇽">Hora de México</option>
            <option value="America/Bogota" data-flag="🇨🇴">Hora de Colombia</option>
            <option value="America/Santiago" data-flag="🇨🇱">Hora de Chile</option>
            <option value="America/Lima" data-flag="🇵🇪">Hora de Perú</option>
            <option value="America/Guayaquil" data-flag="🇪🇨">Hora de Ecuador</option>
            <option value="America/Caracas" data-flag="🇻🇪">Hora de Venezuela</option>
            <option value="America/Asuncion" data-flag="🇵🇾">Hora de Paraguay</option>
            <option value="America/Montevideo" data-flag="🇺🇾">Hora de Uruguay</option>
            <option value="America/La_Paz" data-flag="🇧🇴">Hora de Bolivia</option>
            <option value="America/Sao_Paulo" data-flag="🇧🇷">Hora de Brasil</option>
            <option value="Europe/Madrid" data-flag="🇪🇸">Hora de España</option>
            <option value="America/New_York" data-flag="🇺🇸">Hora de EE.UU. (Este)</option>
            <option value="America/Los_Angeles" data-flag="🇺🇸">Hora de EE.UU. (Pacífico)</option>
          </select>
          <svg viewBox="0 0 24 24" class="fx-chev" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </div>
      </div>

      <!-- ══════════════ TAB: HOY ══════════════ -->
      <section class="fx-panel is-active" data-fxpanel="hoy" role="tabpanel" aria-label="Hoy">
        <div class="fx-grid">
          <div class="fx-main">
            <div class="fx-sec-head">
              <h2 class="fx-h2" id="fx-hoy-title">{isFeaturedToday ? 'Partidos de hoy' : 'Próximos partidos'}</h2>
              <span class="fx-sec-date" data-hoy-date>{featuredDay.label}</span>
            </div>

            <div class="fx-cards" id="fx-hoy-cards">
              {featuredDay.matches.map((m) => {
                const t1 = teamLabel(m.team1);
                const t2 = teamLabel(m.team2);
                const r = sc(m);
                const isNext = nextOverall && m.num === nextOverall.num;
                const st = statusOf(m);
                return (
                  <article class={`fx-mcard${isNext ? ' is-next' : ''}${r ? ' is-played' : ''}`} data-match data-num={m.num} data-team1={m.team1} data-team2={m.team2}>
                    <div class="fx-mcard-badge">{st && <span class={`fx-st fx-st-${st === 'FINAL' ? 'final' : 'next'}`}>{st}</span>}<span class="fx-mcard-round">{roundLabel(m.round)}</span></div>
                    <div class="fx-mcard-body">
                      <div class="fx-mcard-time">
                        <span class="t" data-time data-utc={kickoffUTC(m.date, m.time)?.toISOString()}>{artTime(m.date, m.time)}</span>
                        <span class="g">{groundShort(m.ground)}</span>
                      </div>
                      <div class="fx-mcard-teams">
                        <span class="fx-side s1" data-side="1"><span class="flag">{t1.flag}</span><span class="name">{t1.es}</span></span>
                        <span class="fx-mcard-score" data-score>{r ? `${r.a} – ${r.b}` : 'vs'}</span>
                        <span class="fx-side s2" data-side="2"><span class="name">{t2.es}</span><span class="flag">{t2.flag}</span></span>
