                      </article>
                    );
                  })}
                </div>
                <div class="fx-bracket-col fx-bracket-final">
                  {finalMatch && (
                    <article class="fx-bcell fx-bcell-final" data-match data-num={finalMatch.num} data-team1={finalMatch.team1} data-team2={finalMatch.team2}>
