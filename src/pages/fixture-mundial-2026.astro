---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  fixture,
  LIVE_FIXTURE_URL,
  TEAMS,
  teamLabel,
  roundLabel,
  phaseOf,
  artTime,
  artDayKey,
  artDayLabel,
  kickoffUTC,
  result,
  WORLD_CUP_EVENT,
} from '../lib/data/mundial-2026.ts';

// Calcs de fútbol para el funnel (se resuelven del catálogo para tomar título/icono).
const calcModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
const bySlug = new Map(
  Object.values(calcModules).map((m: any) => {
    const c = m.default || m;
    return [c.slug, c];
  })
);
const featuredSlugs = [
  'calculadora-mundial-2026-predictor-campeon-ranking',
  'calculadora-mundial-2026-probabilidad-clasificacion-ranking-fifa',
  'calculadora-mundial-2026-puntos-clasificar-octavos',
  'calculadora-mundial-2026-quiniela-pool-probabilidad',
  'calculadora-fantasy-mundial-2026-mejor-once',
  'calculadora-mundial-2026-grupo-muerte-detector',
  'calculadora-mundial-2026-horario-partido-zona-horaria',
  'calculadora-mundial-2026-probabilidad-ganar-penales',
];
const featured = featuredSlugs.map((s) => bySlug.get(s)).filter(Boolean);

// ── Agrupar el fixture por día (hora argentina) ──────────────────────────────
const sorted = [...fixture.matches].sort((a, b) => {
  const ka = kickoffUTC(a.date, a.time)?.getTime() ?? 0;
  const kb = kickoffUTC(b.date, b.time)?.getTime() ?? 0;
  if (ka !== kb) return ka - kb;
  return a.num - b.num;
});

interface Day {
  key: string;
  label: string;
  matches: typeof sorted;
}
const dayMap = new Map<string, Day>();
for (const m of sorted) {
  const key = artDayKey(m.date, m.time);
  if (!dayMap.has(key)) dayMap.set(key, { key, label: artDayLabel(m.date, m.time), matches: [] as any });
  dayMap.get(key)!.matches.push(m);
}
const days = [...dayMap.values()];

// Hoy (al momento del build) en hora argentina
const todayKey = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'America/Argentina/Buenos_Aires',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());

// Estado del torneo
const played = fixture.matches.filter((m) => m.score && m.score.ft).length;
const total = fixture.total || fixture.matches.length;

// Día a mostrar destacado: hoy si hay partidos, si no el próximo día con partidos
const todayDay = days.find((d) => d.key === todayKey);
const nextDay = days.find((d) => d.key >= todayKey) || days[days.length - 1];
const featuredDay = todayDay || nextDay;

// Argentina: próximo / último partido
const argMatches = sorted.filter((m) => m.team1 === 'Argentina' || m.team2 === 'Argentina');
const argNext = argMatches.find((m) => !(m.score && m.score.ft)) || argMatches[0];

// "Actualizado" en hora argentina
const updatedLabel = new Intl.DateTimeFormat('es-AR', {
  timeZone: 'America/Argentina/Buenos_Aires',
  day: '2-digit',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date(fixture.fetchedAt));

// ── SEO ──────────────────────────────────────────────────────────────────────
const title = 'Partidos del Mundial 2026: fixture, calendario y resultados | Hacé Cuentas';
const description =
  'Todos los partidos del Mundial 2026 (USA, México y Canadá): fixture completo con horarios en hora argentina y resultados día a día — los 104 partidos, fase de grupos y eliminatorias, más los partidos de hoy y el calendario de tu selección.';
const canonical = '/fixture-mundial-2026';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
    { '@type': 'ListItem', position: 2, name: 'Mundial 2026', item: 'https://hacecuentas.com/mundial-2026' },
    { '@type': 'ListItem', position: 3, name: 'Fixture y resultados', item: 'https://hacecuentas.com/fixture-mundial-2026' },
  ],
};
const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Fixture y resultados del Mundial 2026',
  description:
    'Calendario completo de los 104 partidos del Mundial 2026 con fechas, horarios, sedes y resultados, actualizado durante el torneo.',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  isBasedOn: 'https://github.com/openfootball/worldcup.json',
  dateModified: fixture.fetchedAt,
  url: 'https://hacecuentas.com/fixture-mundial-2026',
};
const faqItems = [
  {
    q: '¿Cuándo empieza y termina el Mundial 2026?',
    a: 'El Mundial 2026 arranca el 11 de junio de 2026 con el partido inaugural de México y termina con la final el 19 de julio de 2026. Es el primero con 48 selecciones, 104 partidos y tres países sede: Estados Unidos, México y Canadá.',
  },
  {
    q: '¿En qué grupo está Argentina y cuándo debuta?',
    a: `Argentina, vigente campeona, integra el Grupo J junto a Argelia, Austria y Jordania. Su debut es ${argNext ? `el ${artDayLabel(argNext.date, argNext.time)} a las ${artTime(argNext.date, argNext.time)} (hora argentina) ante ${teamLabel(argNext.team1 === 'Argentina' ? argNext.team2 : argNext.team1).es}` : 'en la primera fecha de grupos'}.`,
  },
  {
    q: '¿Cómo funciona el nuevo formato de 48 selecciones?',
    a: 'Hay 12 grupos de 4 equipos. Clasifican a la siguiente ronda los dos primeros de cada grupo (24 selecciones) más los 8 mejores terceros, lo que da 32 equipos que arrancan en los dieciseisavos de final (Round of 32). De ahí en adelante es eliminación directa hasta la final.',
  },
  {
    q: '¿A qué hora juega cada partido en mi país?',
    a: 'Con el selector de país arriba del fixture podés ver todos los horarios en tu hora local: Argentina, México, Colombia, Chile, Perú, Ecuador, Venezuela, Paraguay, Uruguay, Bolivia, Brasil, España y EE.UU. Por defecto se muestran en hora de Argentina (UTC-3). Como las sedes están en zonas horarias de Norteamérica (UTC-4 a UTC-7), un partido del mediodía local suele verse a media tarde o noche en Sudamérica; en España es de madrugada del día siguiente (por eso algunos aparecen con "+1").',
  },
  {
    q: '¿De dónde salen los resultados y cada cuánto se actualizan?',
    a: 'Los datos provienen del proyecto de código abierto openfootball (dominio público) y se actualizan automáticamente durante el torneo: al abrir esta página se recargan los resultados más recientes. El calendario, sedes y horarios ya están confirmados; los marcadores se completan a medida que se juegan los partidos.',
  },
  {
    q: '¿Cuántos partidos hay en total?',
    a: `El Mundial 2026 tiene ${total} partidos: 72 de fase de grupos y 32 de eliminatorias (dieciseisavos, octavos, cuartos, semifinales, tercer puesto y final). Es un 60% más de partidos que en Qatar 2022, que tuvo 64.`,
  },
  {
    q: '¿Dónde calculo las chances de mi selección?',
    a: 'Tenemos calculadoras para estimar la probabilidad de que tu selección pase de fase, los puntos que necesita para clasificar a octavos, el detector de grupo de la muerte, el predictor de campeón y hasta el prode del Mundial. Están enlazadas más abajo y en el hub /mundial-2026.',
  },
  {
    q: '¿Cuándo es la final del Mundial 2026?',
    a: 'La final se juega el domingo 19 de julio de 2026 en el MetLife Stadium de Nueva Jersey (Estados Unidos). El partido por el tercer puesto es el día anterior, el sábado 18 de julio.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const schema = { '@context': 'https://schema.org', '@graph': [breadcrumb, WORLD_CUP_EVENT, dataset, faqSchema] };

// Datos para el script client-side (refresh en vivo).
// `days` va compacto para que el cliente pueda recalcular "hoy" y reconstruir
// el bloque destacado sin redeploy (la página es estática: el todayKey del build
// se congela y queda viejo al día siguiente).
const daysData = days.map((d) => ({
  key: d.key,
  label: d.label,
  matches: d.matches.map((m) => ({
    num: m.num,
    stage: m.group ? roundLabel(m.round) + ' · ' + m.group.replace('Group', 'Grupo') : roundLabel(m.round),
    time: artTime(m.date, m.time),
    utc: kickoffUTC(m.date, m.time)?.toISOString() || '',
    team1: m.team1,
    team2: m.team2,
    ground: m.ground,
    score: m.score,
  })),
}));
const liveConfig = { url: LIVE_FIXTURE_URL, teams: TEAMS, todayKey, days: daysData };
---

<Layout title={title} description={description} canonical={canonical} audience="global" schema={schema}>
  <Header />
  <main class="article-main">
    <article class="fx-page">
      <header class="fx-header">
        <div class="fx-eyebrow">⚽ Fixture en vivo</div>
        <h1>Fixture Mundial 2026: calendario y resultados</h1>
        <p class="lede">
          Los <strong>{total} partidos</strong> del Mundial 2026 (USA · México · Canadá) con
          <strong>horario en hora argentina</strong> y resultados que se actualizan
          <strong>día a día</strong>. Seguí la fase de grupos y las eliminatorias, y calculá las
          chances de tu selección.
        </p>
        <div class="fx-meta">
          <span class="meta-item">📅 <strong>11 jun – 19 jul 2026</strong></span>
          <span class="meta-item">🏆 <strong>48 selecciones</strong>, {total} partidos</span>
          <span class="meta-item" data-live-played><strong>{played}</strong> jugados de {total}</span>
          <span class="meta-item">🔄 Actualizado <strong data-live-updated>{updatedLabel}</strong></span>
        </div>
      </header>

      <!-- Selector de país: convierte TODOS los horarios a la hora local del visitante -->
      <div class="fx-tzbar">
        <label for="fx-tz">🕐 Ver horarios en</label>
        <select id="fx-tz" aria-label="Elegí tu país para ver los horarios del Mundial en tu hora local">
          <option value="America/Argentina/Buenos_Aires">🇦🇷 Argentina</option>
          <option value="America/Mexico_City">🇲🇽 México</option>
          <option value="America/Bogota">🇨🇴 Colombia</option>
          <option value="America/Santiago">🇨🇱 Chile</option>
          <option value="America/Lima">🇵🇪 Perú</option>
          <option value="America/Guayaquil">🇪🇨 Ecuador</option>
          <option value="America/Caracas">🇻🇪 Venezuela</option>
          <option value="America/Asuncion">🇵🇾 Paraguay</option>
          <option value="America/Montevideo">🇺🇾 Uruguay</option>
          <option value="America/La_Paz">🇧🇴 Bolivia</option>
          <option value="America/Sao_Paulo">🇧🇷 Brasil</option>
          <option value="Europe/Madrid">🇪🇸 España</option>
          <option value="America/New_York">🇺🇸 EE.UU. (Este)</option>
          <option value="America/Los_Angeles">🇺🇸 EE.UU. (Pacífico)</option>
        </select>
        <span class="fx-tznote">Mostrando <strong data-tz-current>hora de Argentina</strong></span>
      </div>

      <!-- Bloque destacado: hoy / próximo día -->
      {featuredDay && (
        <section class="fx-today" aria-labelledby="fx-today-h">
          <h2 id="fx-today-h">
            {todayDay ? '⚽ Partidos de hoy' : '⏭️ Próximos partidos'}
            <span class="fx-today-date">{featuredDay.label}</span>
          </h2>
          <div class="fx-today-grid">
            {featuredDay.matches.map((m) => {
              const t1 = teamLabel(m.team1);
              const t2 = teamLabel(m.team2);
              const r = result(m);
              return (
                <div class="fx-card" data-match data-num={m.num} data-team1={m.team1} data-team2={m.team2}>
                  <div class="fx-card-top">
                    <span class="fx-round">{m.group ? roundLabel(m.round) + ' · ' + m.group.replace('Group', 'Grupo') : roundLabel(m.round)}</span>
                    <span class="fx-time" data-time data-utc={kickoffUTC(m.date, m.time)?.toISOString()}>{artTime(m.date, m.time)}</span>
                  </div>
                  <div class="fx-card-teams">
                    <span class="fx-team t1"><span class="flag">{t1.flag}</span><span class="name">{t1.es}</span></span>
                    <span class="fx-score" data-score>{r ? `${r.a} – ${r.b}` : 'vs'}</span>
                    <span class="fx-team t2"><span class="name">{t2.es}</span><span class="flag">{t2.flag}</span></span>
                  </div>
                  <div class="fx-card-foot">
                    <span class="fx-ground">📍 {m.ground}</span>
                    <span class="fx-detail" data-detail>{r?.detail || ''}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- CTA: invitar a las calcs de fútbol -->
      <aside class="fx-cta-strip">
        <p>
          <strong>Antes de cada partido:</strong> calculá las chances reales de tu selección, los
          puntos que necesita para pasar de fase o armá el prode con amigos.
        </p>
        <a class="fx-cta-btn" href="/mundial-2026">Ver todas las calculadoras del Mundial →</a>
        <p class="fx-live-nav" style="margin:0.85rem 0 0;font-size:0.92rem;line-height:1.9">
          <strong>En vivo:</strong>
          <a href="/partidos-hoy-mundial-2026">Partidos de hoy</a> ·
          <a href="/posiciones-mundial-2026">Tabla de posiciones</a> ·
          <a href="/goleadores-mundial-2026">Goleadores</a> ·
          <a href="/llave-mundial-2026">Llave de eliminación</a> ·
          <a href="/cuando-juega-argentina-mundial-2026">¿Cuándo juega Argentina?</a>
        </p>
      </aside>

      <!-- Fixture completo -->
      <section class="fx-full" aria-labelledby="fx-full-h">
        <h2 id="fx-full-h">Calendario completo, día por día</h2>
        <p class="fx-note">
          Elegí tu país arriba para ver los horarios en tu hora local (por defecto, Argentina UTC-3).
          Los marcadores se completan automáticamente a medida que se juegan los partidos.
        </p>
        {days.map((d) => (
          <div class={`fx-day${d.key === todayKey ? ' is-today' : ''}`} data-day={d.key}>
            <h3 class="fx-day-h">
              {d.key === todayKey && <span class="fx-hoy-badge">HOY</span>}
              {d.label}
            </h3>
            <ul class="fx-rows">
              {d.matches.map((m) => {
                const t1 = teamLabel(m.team1);
                const t2 = teamLabel(m.team2);
                const r = result(m);
                return (
                  <li class={`fx-row${r ? ' played' : ''}`} data-match data-num={m.num} data-team1={m.team1} data-team2={m.team2}>
                    <span class="fx-row-time" data-time data-utc={kickoffUTC(m.date, m.time)?.toISOString()}>{artTime(m.date, m.time)}</span>
                    <span class="fx-row-stage">{m.group ? m.group.replace('Group', 'Gr.') : roundLabel(m.round)}</span>
                    <span class={`fx-row-team r-t1${r && r.winner === 1 ? ' win' : ''}`} data-side="1">
                      <span class="name">{t1.es}</span><span class="flag">{t1.flag}</span>
                    </span>
                    <span class="fx-row-score" data-score>{r ? `${r.a} – ${r.b}` : 'vs'}</span>
                    <span class={`fx-row-team r-t2${r && r.winner === 2 ? ' win' : ''}`} data-side="2">
                      <span class="flag">{t2.flag}</span><span class="name">{t2.es}</span>
                    </span>
                    <span class="fx-row-detail" data-detail>{r?.detail || ''}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>

      <!-- Funnel a las calculadoras de fútbol -->
      <section class="fx-calcs" aria-labelledby="fx-calcs-h">
        <h2 id="fx-calcs-h">Calculadoras para vivir el Mundial</h2>
        <p class="group-intro">
          Mientras seguís el fixture, poné números a la ilusión: probabilidades, puntos para
          clasificar, penales, fantasy y el prode del Mundial.
        </p>
        <ul class="fx-calc-grid">
          {featured.map((c: any) => (
            <li>
              <a href={`/${c.slug}`} class="fx-calc-link">
                <span class="fx-calc-icon" aria-hidden="true">{c.icon || '⚽'}</span>
                <span class="fx-calc-body">
                  <strong>{c.h1}</strong>
                  <span>{c.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="fx-calcs-more">
          <a href="/mundial-2026">🏆 Hub Mundial 2026 (34 calculadoras)</a>
          <span class="sep">·</span>
          <a href="/categoria/deportes">⚽ Todas las calculadoras de deportes</a>
        </p>
      </section>

      <!-- FAQ -->
      <section class="fx-faq" aria-labelledby="fx-faq-h">
        <h2 id="fx-faq-h">Preguntas frecuentes</h2>
        {faqItems.map((f) => (
          <details class="fx-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <p class="fx-source">
        Datos del calendario y resultados: proyecto de código abierto
        <a href="https://github.com/openfootball/worldcup.json" rel="noopener" target="_blank">openfootball</a>
        (dominio público) y FIFA. Horarios convertidos a hora de Argentina. Esta página se
        actualiza automáticamente durante el torneo.
      </p>
    </article>
  </main>
  <Footer />
</Layout>

<script type="application/json" id="fx-live-config" set:html={JSON.stringify(liveConfig)}></script>

<script>
  // Refresh client-side: trae el JSON vivo de openfootball y completa marcadores
  // + nombres de equipos que se vayan resolviendo (eliminatorias). Si falla,
  // queda el snapshot server-rendered. No rompe nada: todo defensivo.
  (function () {
    const cfgEl = document.getElementById('fx-live-config');
    if (!cfgEl) return;
    let cfg: any;
    try { cfg = JSON.parse(cfgEl.textContent || '{}'); } catch { return; }
    const TEAMS = cfg.teams || {};

    // ── Horarios por país: convertir el kickoff (UTC, en data-utc) a la zona elegida ──
    const AR_TZ = 'America/Argentina/Buenos_Aires';
    const ZONES = [
      AR_TZ, 'America/Mexico_City', 'America/Bogota', 'America/Santiago', 'America/Lima',
      'America/Guayaquil', 'America/Caracas', 'America/Asuncion', 'America/Montevideo',
      'America/La_Paz', 'America/Sao_Paulo', 'Europe/Madrid', 'America/New_York', 'America/Los_Angeles',
    ];
    function tzLabel(tz: string): string {
      const sel = document.getElementById('fx-tz') as HTMLSelectElement | null;
      if (sel) { const o = Array.from(sel.options).find((o) => o.value === tz); if (o) return o.textContent || tz; }
      return tz === AR_TZ ? '🇦🇷 Argentina' : tz;
    }
    function dayInTZ(d: Date, tz: string): string {
      try { return new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d); }
      catch { return ''; }
    }
    // currentTZ: preferencia guardada > auto-detect (si está en la lista) > Argentina.
    let currentTZ = AR_TZ;
    try {
      const saved = localStorage.getItem('fx-tz');
      if (saved && ZONES.indexOf(saved) >= 0) currentTZ = saved;
      else { const det = Intl.DateTimeFormat().resolvedOptions().timeZone; if (det && ZONES.indexOf(det) >= 0) currentTZ = det; }
    } catch {}
    // Formatea un kickoff UTC (ISO) a la zona actual, con marcador de día (+1/−1)
    // relativo al día del calendario (que está agrupado en hora argentina).
    function fmtTimeTZ(utc: string): string {
      if (!utc) return '';
      const d = new Date(utc);
      if (isNaN(d.getTime())) return '';
      let t: string;
      try { t = new Intl.DateTimeFormat('es-AR', { timeZone: currentTZ, hour: '2-digit', minute: '2-digit', hour12: false }).format(d); }
      catch { return ''; }
      const ar = dayInTZ(d, AR_TZ), loc = dayInTZ(d, currentTZ);
      let off = '';
      if (loc && ar && loc !== ar) off = loc > ar ? ' +1' : ' −1';
      return t + off;
    }
    // Reconvierte TODOS los horarios visibles ([data-time] con data-utc) a la zona actual.
    function reformatTimes() {
      document.querySelectorAll('[data-time][data-utc]').forEach((el) => {
        const utc = el.getAttribute('data-utc');
        if (utc) el.textContent = fmtTimeTZ(utc);
      });
    }

    function label(name: string | null): { es: string; flag: string } {
      if (!name) return { es: 'A definir', flag: '⚽' };
      if (TEAMS[name]) return TEAMS[name];
      let m = name.match(/^([123])([A-L])$/);
      if (m) return { es: m[1] + '.º Grupo ' + m[2], flag: '🏳️' };
      m = name.match(/^3([A-L/]+)$/);
      if (m) return { es: '3.º (' + m[1] + ')', flag: '🏳️' };
      m = name.match(/^W(\d+)$/);
      if (m) return { es: 'Ganador M' + m[1], flag: '🏳️' };
      m = name.match(/^L(\d+)$/);
      if (m) return { es: 'Perdedor M' + m[1], flag: '🏳️' };
      return { es: name, flag: '🏳️' };
    }

    function fmtResult(score: any) {
      if (!score || !score.ft) return null;
      let a = score.ft[0], b = score.ft[1], detail = '';
      if (score.et) { detail = 'tras alargue ' + score.et[0] + '-' + score.et[1]; a = score.et[0]; b = score.et[1]; }
      let winner = a > b ? 1 : b > a ? 2 : 0;
      if (score.p) { detail = (detail ? detail + ', ' : '') + 'penales ' + score.p[0] + '-' + score.p[1]; winner = score.p[0] > score.p[1] ? 1 : 2; }
      return { a: score.ft[0], b: score.ft[1], detail, winner };
    }

    function applyMatch(el: Element, m: any) {
      // nombres de equipos (por si se resolvieron placeholders)
      const sides = [
        { side: '1', team: m.team1 },
        { side: '2', team: m.team2 },
      ];
      for (const s of sides) {
        const lab = label(s.team);
        el.querySelectorAll('[data-side="' + s.side + '"] .name, .fx-team.t' + s.side + ' .name').forEach((n) => { n.textContent = lab.es; });
        el.querySelectorAll('[data-side="' + s.side + '"] .flag, .fx-team.t' + s.side + ' .flag').forEach((n) => { n.textContent = lab.flag; });
      }
      const r = fmtResult(m.score);
      const scoreEl = el.querySelector('[data-score]');
      const detailEl = el.querySelector('[data-detail]');
      if (r && scoreEl) {
        scoreEl.textContent = r.a + ' – ' + r.b;
        el.classList.add('played');
        el.querySelector('.r-t1')?.classList.toggle('win', r.winner === 1);
        el.querySelector('.r-t2')?.classList.toggle('win', r.winner === 2);
        if (detailEl) detailEl.textContent = r.detail;
      }
    }

    // "Hoy" en hora argentina, recalculado en el navegador (no el del build).
    function todayKeyAR() {
      return new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Argentina/Buenos_Aires',
        year: 'numeric', month: '2-digit', day: '2-digit',
      }).format(new Date());
    }

    // Rellena una tarjeta clonada (.fx-card) con los datos de un partido.
    function fillCard(card: Element, m: any) {
      card.setAttribute('data-num', String(m.num));
      card.setAttribute('data-team1', m.team1 || '');
      card.setAttribute('data-team2', m.team2 || '');
      const t1 = label(m.team1), t2 = label(m.team2);
      const set = (sel: string, val: string) => { const e = card.querySelector(sel); if (e) e.textContent = val; };
      set('.fx-round', m.stage || '');
      const timeEl = card.querySelector('.fx-time');
      if (timeEl) {
        if (m.utc) timeEl.setAttribute('data-utc', m.utc);
        timeEl.textContent = m.utc ? fmtTimeTZ(m.utc) : (m.time || '');
      }
      set('.fx-team.t1 .flag', t1.flag);
      set('.fx-team.t1 .name', t1.es);
      set('.fx-team.t2 .flag', t2.flag);
      set('.fx-team.t2 .name', t2.es);
      const r = fmtResult(m.score);
      set('.fx-score', r ? r.a + ' – ' + r.b : 'vs');
      set('.fx-detail', r ? r.detail : '');
      card.classList.toggle('played', !!r);
    }

    // Recalcula "hoy" en el cliente y reubica el resaltado + el bloque destacado.
    // La página es estática: sin esto, el todayKey del build queda viejo al otro día.
    function relocateToday() {
      const days = cfg.days || [];
      if (!days.length) return;
      const realToday = todayKeyAR();
      let featured = days.find((d: any) => d.key === realToday);
      const isToday = !!featured;
      if (!featured) featured = days.find((d: any) => d.key >= realToday) || days[days.length - 1];
      if (!featured) return;

      // 1) Mover el resaltado "HOY" en el calendario completo
      document.querySelectorAll('.fx-day').forEach((el) => {
        const isT = el.getAttribute('data-day') === realToday;
        el.classList.toggle('is-today', isT);
        const h = el.querySelector('.fx-day-h');
        if (!h) return;
        const badge = h.querySelector('.fx-hoy-badge');
        if (isT && !badge) {
          const b = document.createElement('span');
          b.className = 'fx-hoy-badge';
          b.textContent = 'HOY';
          h.insertBefore(b, h.firstChild);
        } else if (!isT && badge) {
          badge.remove();
        }
      });

      // 2) Reconstruir el bloque destacado (hoy / próximos)
      const section = document.querySelector('.fx-today');
      if (!section) return;
      const h2 = section.querySelector('#fx-today-h');
      if (h2) {
        const dateSpan = h2.querySelector('.fx-today-date');
        if (dateSpan) dateSpan.textContent = featured.label;
        // Actualizar el texto del encabezado conservando el <span> (scope de estilos)
        for (const node of Array.from(h2.childNodes)) {
          if (node.nodeType === 3 && (node.textContent || '').trim()) {
            node.textContent = isToday ? '⚽ Partidos de hoy ' : '⏭️ Próximos partidos ';
            break;
          }
        }
      }
      const grid = section.querySelector('.fx-today-grid');
      const template = grid && grid.querySelector('.fx-card');
      if (grid && template) {
        const frag = document.createDocumentFragment();
        featured.matches.forEach((m: any) => {
          const card = template.cloneNode(true) as Element;
          fillCard(card, m);
          frag.appendChild(card);
        });
        grid.innerHTML = '';
        grid.appendChild(frag);
      }
    }

    // Reconstruye el bloque "hoy" sólo cuando cambia el día (evita parpadeo en
    // cada poll; cubre el caso de dejar la pestaña abierta y cruzar la medianoche).
    let lastTodayKey = '';
    function syncToday() {
      const k = todayKeyAR();
      if (k === lastTodayKey) return;
      lastTodayKey = k;
      relocateToday();
    }

    async function refresh() {
      try {
        const res = await fetch(cfg.url, { cache: 'no-store' });
        if (!res.ok) return null;
        const data = await res.json();
        if (!data || !Array.isArray(data.matches)) return null;
        const byNum = new Map<number, any>();
        data.matches.forEach((m: any, i: number) => byNum.set(m.num ?? i + 1, m));
        // Set por num: los partidos de hoy aparecen 2 veces en el DOM (bloque
        // destacado + lista completa); contar elementos inflaría el "jugados de".
        const playedNums = new Set<number>();
        document.querySelectorAll('[data-match]').forEach((el) => {
          const num = Number((el as HTMLElement).dataset.num);
          const m = byNum.get(num);
          if (!m) return;
          applyMatch(el, m);
          if (m.score && m.score.ft) playedNums.add(num);
        });
        const played = playedNums.size;
        const pEl = document.querySelector('[data-live-played]');
        if (pEl) pEl.innerHTML = '<strong>' + played + '</strong> jugados de ' + byNum.size;
        const uEl = document.querySelector('[data-live-updated]');
        if (uEl) uEl.textContent = new Intl.DateTimeFormat('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date());
        return { played, total: byNum.size };
      } catch { /* snapshot server queda válido */ return null; }
    }

    // ── Auto-actualización: los marcadores se completan solos al terminar cada
    // partido. La página es estática; el JSON de openfootball se actualiza durante
    // el torneo, así que repolleamos cada 2 min sin recargar ni redeployar.
    let poll: any = null;
    let stopped = false;
    async function tick() {
      syncToday(); // corrige "hoy" (el del build queda viejo) y cubre el cambio de día
      const st = await refresh();
      if (st && st.total > 0 && st.played >= st.total) {
        stopped = true; // torneo completo → no seguir polleando
        if (poll) { clearInterval(poll); poll = null; }
      }
    }
    // ── Selector de país: restaurar preferencia y reconvertir todos los horarios ──
    const tzSel = document.getElementById('fx-tz') as HTMLSelectElement | null;
    const tzNote = document.querySelector('[data-tz-current]');
    function applyTZ() {
      reformatTimes();
      if (tzNote) tzNote.textContent = 'hora de ' + tzLabel(currentTZ).replace(/^[^\s]+\s/, '');
    }
    if (tzSel) {
      tzSel.value = currentTZ;
      tzSel.addEventListener('change', () => {
        currentTZ = tzSel.value;
        try { localStorage.setItem('fx-tz', currentTZ); } catch {}
        applyTZ();
      });
    }
    applyTZ(); // reconvierte el snapshot SSR (hora Argentina) a la zona detectada/guardada

    tick();
    poll = setInterval(() => { if (!document.hidden && !stopped) tick(); }, 120000);
    // Al volver a la pestaña, actualizar al instante en vez de esperar el próximo poll.
    document.addEventListener('visibilitychange', () => { if (!document.hidden && !stopped) tick(); });
  })();
</script>

