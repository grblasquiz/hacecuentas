                    <article class="fx-bcell fx-bcell-third" data-match data-num={thirdMatch.num} data-team1={thirdMatch.team1} data-team2={thirdMatch.team2}>
                      <div class="fx-bcell-title">Tercer puesto</div>
                      <div class="fx-bcell-row" data-side="1"><span class="flag">{teamLabel(thirdMatch.team1).flag}</span><span class="name">{teamLabel(thirdMatch.team1).es}</span><span class="fx-bcell-sc" data-score-a>{sc(thirdMatch)?.a ?? ''}</span></div>
                      <div class="fx-bcell-row" data-side="2"><span class="flag">{teamLabel(thirdMatch.team2).flag}</span><span class="name">{teamLabel(thirdMatch.team2).es}</span><span class="fx-bcell-sc" data-score-b>{sc(thirdMatch)?.b ?? ''}</span></div>
                      <div class="fx-bcell-foot"><span class="fx-bcell-when">{artDayLabel(thirdMatch.date, thirdMatch.time).split(' ').slice(1, 4).join(' ')}</span></div>
                    </article>
                  )}
                </div>
              </div>
            </div>

            <!-- Vista Lista -->
            <div class="fx-listview" data-viewpanel="lista" hidden>
              {listPhases.map((p) => (
                p.matches.length > 0 && (
                  <div class="fx-listphase">
                    <h3 class="fx-h3">{p.label}</h3>
                    <div class="fx-cards">
                      {p.matches.slice().sort((a: any, b: any) => a.num - b.num).map((m: any) => {
                        const t1 = teamLabel(m.team1), t2 = teamLabel(m.team2);
                        const r = sc(m);
                        return (
                          <article class={`fx-mcard fx-mcard-sm${r ? ' is-played' : ''}`} data-match data-num={m.num} data-team1={m.team1} data-team2={m.team2}>
                            <div class="fx-mcard-body">
                              <div class="fx-mcard-time"><span class="t" data-time data-utc={kickoffUTC(m.date, m.time)?.toISOString()}>{artTime(m.date, m.time)}</span></div>
                              <div class="fx-mcard-teams">
                                <span class="fx-side s1" data-side="1"><span class="flag">{t1.flag}</span><span class="name">{t1.es}</span></span>
                                <span class="fx-mcard-score" data-score>{r ? `${r.a} – ${r.b}` : 'vs'}</span>
                                <span class="fx-side s2" data-side="2"><span class="name">{t2.es}</span><span class="flag">{t2.flag}</span></span>
                              </div>
                              <span class="fx-mcard-detail" data-detail>{r?.detail || ''}</span>
                            </div>
                          </article>
                        );
                      })}
                    </div>
                  </div>
                )
              ))}
            </div>

            <div class="fx-allphases">
              <h3 class="fx-h3">Todas las fases</h3>
              <div class="fx-allphases-grid">
                {phaseView.map((p) => (
                  <div class={`fx-apcard status-${p.status}`}>
                    <span class="fx-apcard-num">{p.key === 'grupos' ? '⚽' : p.total}</span>
                    <span class="fx-apcard-name">{p.short}</span>
                    <span class="fx-apcard-meta">{p.total} {p.total === 1 ? 'partido' : 'partidos'}</span>
                    <span class="fx-apcard-state" aria-hidden="true">{p.status === 'done' ? '✓' : p.status === 'current' ? '◉' : '○'}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <aside class="fx-side-col">
            <div class="fx-scard">
              <h3 class="fx-scard-h">Próximas fases</h3>
              <div class="fx-nextphase">
                <svg viewBox="0 0 24 24" class="fx-i" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>
                <div><strong>Semifinales</strong><span>{sfMatches.length >= 2 ? `${artDayLabel(sfMatches[0].date, sfMatches[0].time).split(' ')[1]} y ${artDayLabel(sfMatches[1].date, sfMatches[1].time).split(' ').slice(1, 4).join(' ')}` : '14 y 15 de julio'}</span></div>
              </div>
              {thirdMatch && (
                <div class="fx-nextphase">
                  <span class="fx-i" style="font-size:1.05rem">🥉</span>
                  <div><strong>Tercer puesto</strong><span>{artDayLabel(thirdMatch.date, thirdMatch.time).split(' ').slice(1, 4).join(' ')}</span></div>
                </div>
              )}
              <div class="fx-nextphase">
                <span class="fx-i" style="font-size:1.1rem">🏆</span>
                <div><strong>Final</strong><span>{finalMatch ? artDayLabel(finalMatch.date, finalMatch.time).split(' ').slice(1, 4).join(' ') : '19 de julio'}</span></div>
              </div>
            </div>
            <div class="fx-scard">
              <h3 class="fx-scard-h">Argentina en el cuadro</h3>
              <ol class="fx-stepper">
                {argPhaseView.filter((p) => ['qf', 'sf', 'final'].includes(p.key)).map((p) => {
                  const st = p.state === 'done' ? 'done' : p.state === 'current' ? 'current' : 'future';
                  const m = p.matches[0];
                  return (
                    <li class={`fx-step ${st}`}>
                      <span class="fx-step-node" aria-hidden="true">{st === 'done' ? '✓' : ''}</span>
                      <span class="fx-step-label">{p.label}<small>{m ? (argDayIsToday(m) ? `Hoy · ${artTime(m.date, m.time)} vs ${teamLabel(m.team1 === 'Argentina' ? m.team2 : m.team1).es}` : artDayLabel(m.date, m.time).split(' ').slice(1, 4).join(' ')) : p.key === 'final' && finalMatch ? artDayLabel(finalMatch.date, finalMatch.time).split(' ').slice(1, 4).join(' ') : 'Por definir'}</small></span>
                    </li>
                  );
                })}
              </ol>
              <button class="fx-btn fx-btn-ghost" data-goto="argentina">Ver camino de Argentina</button>
            </div>
          </aside>
        </div>
      </section>

      <!-- ══════════════ Bloque SEO (siempre visible) ══════════════ -->
      <div class="fx-seo">
        <p class="fx-answer">
          El <strong>fixture del Mundial 2026</strong> tiene los <strong>{total} partidos</strong> completos: arrancó el <strong>11 de junio de 2026</strong> con el partido inaugural de México y terminó con la final el <strong>19 de julio de 2026</strong>, en la que España venció 1-0 a Argentina. Arriba tenés el calendario completo día por día, el camino de Argentina y las llaves de eliminación — con todos los resultados finales.
        </p>

        <div id="fx-avisos">
          <PushOptIn topic="mundial" />
        </div>
        <p class="fx-answer">
          📅 ¿Preferís el calendario? <a href="/calendarios">Suscribite a los partidos de Argentina o al fixture completo</a> en Google/Apple Calendar — se actualiza solo, con la hora de tu país.
        </p>

        <section class="fx-calcs" aria-labelledby="fx-calcs-h">
          <h2 id="fx-calcs-h" class="fx-h2">Calculadoras del Mundial</h2>
          <p class="fx-group-intro">
            Los números del torneo que terminó: probabilidades, premios, récords y goleadores históricos.
          </p>
          <ul class="fx-calc-grid">
            {featured.map((c: any) => (
              <li>
                <a href={`/${c.slug}`} class="fx-calc-link">
                  <span class="fx-calc-icon" aria-hidden="true">{c.icon || '⚽'}</span>
                  <span class="fx-calc-body">
                    <strong>{c.h1}</strong>
                    <span>{c.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="fx-calcs-more">
            <a href="/mundial-2026">🏆 Hub Mundial 2026 (34 calculadoras)</a>
            <span class="sep">·</span>
            <a href="/categoria/deportes">⚽ Todas las calculadoras de deportes</a>
          </p>
          <p class="fx-live-nav">
            <strong>Así terminó:</strong>
            <a href="/campeon-mundial-2026">¿Quién ganó? Campeón y palmarés</a> ·
            <a href="/posiciones-mundial-2026">Tabla de posiciones</a> ·
            <a href="/goleadores-mundial-2026">Goleadores</a> ·
            <a href="/balon-de-oro-mundial-2026">Balón de Oro</a> ·
            <a href="/llave-mundial-2026">Llave de eliminación</a>
            {findePost && (
              <Fragment> · <a href={`/blog/${findePost.slug}`}>Los partidos del finde</a></Fragment>
            )}
          </p>
        </section>

        <section class="fx-faq" aria-labelledby="fx-faq-h">
          <h2 id="fx-faq-h" class="fx-h2">Preguntas frecuentes</h2>
          {faqItems.map((f) => (
            <details class="fx-faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>

        <p class="fx-source">
          Datos del calendario y resultados: proyecto de código abierto
          <a href="https://github.com/openfootball/worldcup.json" rel="noopener" target="_blank">openfootball</a>
          (dominio público) y FIFA. Horarios convertidos a hora de Argentina. Esta página se
          actualiza automáticamente durante el torneo.
        </p>
      </div>

      <!-- Bottom tab bar (mobile) -->
      <nav class="fx-bottomnav" aria-label="Navegación del fixture">
        <button class="fx-bn is-active" data-fxtab="hoy">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>
          <span>Hoy</span>
        </button>
        <button class="fx-bn" data-fxtab="calendario">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4M9 14l2 2 4-4"/></svg>
          <span>Calendario</span>
        </button>
        <button class="fx-bn" data-fxtab="argentina">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8l4-4h8l4 4-3 3v9H7v-9L4 8Z"/></svg>
          <span>Argentina</span>
        </button>
        <button class="fx-bn" data-fxtab="fases">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v3a4 4 0 0 1-8 0V4ZM6 5H4v2a3 3 0 0 0 3 3M18 5h2v2a3 3 0 0 1-3 3M9 14h6M10 20h4M12 14v6"/></svg>
          <span>Fases</span>
        </button>
      </nav>

    </article>
  </main>
  <Footer />

  <script type="application/json" id="fx-live-config" set:html={JSON.stringify(liveConfig)} is:inline></script>
  <script is:inline set:html={fxScript}></script>
</Layout>
<style is:global>
.fx-match-seo{font-size:13px;line-height:1.3;margin:0 0 7px;color:var(--fx-ink,#152033)}.fx-mcard[id^="partido-"]{scroll-margin-top:88px}
</style>
