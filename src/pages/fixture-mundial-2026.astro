                      <span class="fx-argtl-arg"><span class="flag">🇦🇷</span>Argentina</span>
                      <span class="fx-argtl-res" data-score>{r ? `${isArg1 ? r.a : r.b} – ${isArg1 ? r.b : r.a}` : 'vs'}</span>
                      <span class="fx-argtl-opp"><span class="name">{opp.es}</span><span class="flag">{opp.flag}</span></span>
                    </span>
                    <span class="fx-argtl-tag">{done ? 'Resultado' : isNext ? 'Próximo' : 'Programado'}</span>
