                            <div class="fx-bcell-row" data-side="2">
                              <span class="flag">{t2.flag}</span><span class="name">{t2.es}</span>
                              <span class="fx-bcell-sc" data-score-b>{r ? r.b : ''}</span>
                            </div>
                            <div class="fx-bcell-foot">
                              {r ? <span class="fx-bcell-detail" data-detail>{r.detail || 'Final'}</span>
                                 : <span class="fx-bcell-when"><span data-time data-utc={kickoffUTC(m.date, m.time)?.toISOString()}>{argDayIsToday(m) ? 'Hoy · ' : ''}{artTime(m.date, m.time)}</span></span>}
                              {isNext && <span class="fx-st fx-st-next">Próximo</span>}
                            </div>
                          </article>
                        );
                      })}
                    </div>
                  ))}
                </div>
                <div class="fx-bracket-col fx-bracket-sf">
