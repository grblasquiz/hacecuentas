                  <div class="fx-argnext-team" data-side="1"><span class="flag">{teamLabel(argNext.team1).flag}</span><span class="name">{teamLabel(argNext.team1).es}</span></div>
                  <span class="fx-argnext-vs" data-score>VS</span>
                  <div class="fx-argnext-team" data-side="2"><span class="flag">{teamLabel(argNext.team2).flag}</span><span class="name">{teamLabel(argNext.team2).es}</span></div>
                  <div class="fx-argnext-cd">
                    <span class="fx-argnext-cdlabel">Empieza en</span>
                    <strong class="fx-argnext-cdval" data-countdown data-utc={argNextUtc}>—</strong>
                  </div>
                </div>
              </div>
            )}

            <h3 class="fx-h3">Partidos de Argentina</h3>
            <ol class="fx-argtl">
              {argMatches.map((m) => {
                const isArg1 = m.team1 === 'Argentina';
                const opp = teamLabel(isArg1 ? m.team2 : m.team1);
                const r = sc(m);
                const done = !!r;
                const isNext = argNext && m.num === argNext.num;
                return (
                  <li class={`fx-argtl-row${done ? ' done' : ''}${isNext ? ' current' : ''}`} data-match data-num={m.num} data-team1={m.team1} data-team2={m.team2}>
                    <span class="fx-argtl-node" aria-hidden="true">{done ? '✓' : ''}</span>
                    <span class="fx-argtl-badge">{isNext && argDayIsToday(m) ? 'HOY · ' : ''}{isNext ? artTime(m.date, m.time) + ' · ' : ''}{roundLabel(m.round)}</span>
