            <a class="fx-btn fx-btn-ghost fx-btn-inline" href="/calendarios"><svg viewBox="0 0 24 24" class="fx-i" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>Agregar al calendario</a>
          </div>
