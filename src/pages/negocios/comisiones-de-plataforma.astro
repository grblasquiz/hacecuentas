---
/**
 * Hub de decisión — "¿Cuánto me cobra de comisión la plataforma?"
 * Reemplaza 12 URLs de calculadora suelta (ver hub.replaces).
 *
 * El chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan:
 * esta página sólo aporta los datos y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ComisionesPlataformaExperience from '../../components/generated/ComisionesPlataformaExperience.astro';
import { hub, PLATAFORMA_MATH } from '../../lib/hubs/comisiones-plataforma';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ComisionesPlataformaExperience data={hub} />
  <Footer />
</Layout>

