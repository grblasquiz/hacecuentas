---
/**
 * Hub de decisión — "Vendo bien pero no tengo plata: ¿por qué?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (ciclo de efectivo / liquidez / stock / caja).
 * La página sólo aporta datos (src/lib/hubs/capital-de-trabajo.ts) y compute().
 *
 * El hub MEZCLA pesos, días, veces y porcentajes. TODAS las filas declaran
 * `format` de forma explícita —también las de plata— porque el runtime hace
 * Object.assign sobre el formato del resultado y una fila sin formato propio
 * caería al default 'ars' e imprimiría días con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, BANDAS, DIAS_ANIO, MESES_ANIO } from '../../lib/hubs/capital-de-trabajo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ B: BANDAS, DIAS: DIAS_ANIO, MESES: MESES_ANIO }}>
  (function () {
    const H = window.HC_HUB;
    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });
    const pos = (val, min, max) => Math.min(100, Math.max(0, ((val - min) / (max - min)) * 100));

    /**
     * Base común de las cuatro ramas. Es la misma cuenta que cortaban en pedazos
     * dso.ts, dias-promedio-pago-proveedores-dpp.ts, rotacion-inventario.ts,
     * capital-trabajo.ts y ratio-liquidez-corriente-seco.ts.
     */
    function base(v) {
      const ventas = Math.max(0, Number(v.ventas_anuales) || 0);
      const cmv = Math.max(0, Number(v.costo_ventas) || 0);
      const cxc = Math.max(0, Number(v.cuentas_cobrar) || 0);
      const cxp = Math.max(0, Number(v.cuentas_pagar) || 0);
      const inv = Math.max(0, Number(v.inventario) || 0);
      const ac = Math.max(0, Number(v.activo_corriente) || 0);
      const pc = Math.max(0, Number(v.pasivo_corriente) || 0);

      const ventasDiarias = ventas / DIAS;
      const cmvDiario = cmv / DIAS;

      // dso.ts: DSO = cuentas por cobrar / (ventas anuales / 365)
      const dso = ventasDiarias > 0 ? cxc / ventasDiarias : 0;
      // rotacion-inventario.ts: rotación = CMV / inventario; días = 365 / rotación
      const rotacion = inv > 0 ? cmv / inv : 0;
      const dio = rotacion > 0 ? DIAS / rotacion : 0;
      // dias-promedio-pago-proveedores-dpp.ts: DPP = (CxP / CMV) * 365
      const dpp = cmv > 0 ? (cxp / cmv) * DIAS : 0;

      const cce = dso + dio - dpp;

      // capital-trabajo.ts / ratio-liquidez-corriente-seco.ts
      const capital = ac - pc;
      const ratio = pc > 0 ? ac / pc : 0;
      const acida = pc > 0 ? (ac - inv) / pc : 0;

      return {
        ventas, cmv, cxc, cxp, inv, ac, pc,
        ventasDiarias, cmvDiario, dso, rotacion, dio, dpp, cce,
        capital, ratio, acida,
      };
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'ciclo';
      const b = base(v);

      // ── 1. Ciclo de conversión de efectivo ────────────────────────────────
      if (id === 'ciclo') {
        const necesidad = b.cce * b.cmvDiario;
        const zona =
          b.cce <= 0 ? 'ciclo negativo: el proveedor te financia la operación entera'
          : b.cce < B.ciclo.excelente ? 'ciclo corto: la plata vuelve rápido'
          : b.cce < B.ciclo.bueno ? 'ciclo razonable, dentro de lo habitual'
          : b.cce < B.ciclo.regular ? 'ciclo largo: revisá cobranza y stock'
          : 'ciclo crítico: la operación te consume caja todo el tiempo';

        return {
          format: 'unit',
          unit: 'días',
          decimals: 1,
          total: nf(b.cce, 1) + ' días',
          sub:
            'Cobrás a ' + nf(b.dso, 0) + ' días, el stock tarda ' + nf(b.dio, 0) +
            ' y pagás a ' + nf(b.dpp, 0) + ' · necesitás ' + H.ars(Math.max(0, necesidad)) +
            ' de caja propia para que la rueda gire · ' + zona,
          rows: [
            { k: 'DSO — días promedio de cobro', ref: 'cuentas por cobrar sobre ventas diarias', v: b.dso, format: 'unit', unit: 'días', decimals: 1 },
            { k: 'DIO — días que el stock queda parado', ref: '365 sobre la rotación', v: b.dio, format: 'unit', unit: 'días', decimals: 1 },
            { k: 'DPP — días promedio de pago a proveedores', ref: 'cuentas por pagar sobre CMV, por 365', v: b.dpp, format: 'unit', unit: 'días', decimals: 1 },
            { k: 'Ciclo de conversión de efectivo', ref: 'DSO + DIO − DPP', v: b.cce, format: 'unit', unit: 'días', decimals: 1, extra: true },
            { k: 'Ventas de un día', v: b.ventasDiarias, format: 'ars' },
            { k: 'Costo de un día de operación', ref: 'CMV anual sobre 365', v: b.cmvDiario, format: 'ars' },
            { k: 'Caja inmovilizada por el ciclo', ref: 'días de ciclo × costo diario', v: necesidad, format: 'ars' },
            { k: 'Plata parada en cuentas por cobrar', v: b.cxc, format: 'ars' },
            { k: 'Plata parada en mercadería', v: b.inv, format: 'ars' },
            { k: 'Financiamiento que te dan los proveedores', v: b.cxp, format: 'ars' },
          ],
          position: pos(b.cce, B.ciclo.min, B.ciclo.max),
          positionLabel: 'Ciclo de ' + nf(b.cce, 1) + ' días',
          chart: [
            { label: 'Cobrás antes de pagar', from: B.ciclo.min, to: 0, tone: 'good' },
            { label: 'Ciclo corto', from: 0, to: B.ciclo.excelente, tone: 'good' },
            { label: 'Ciclo razonable', from: B.ciclo.excelente, to: B.ciclo.bueno, tone: 'main' },
            { label: 'Ciclo largo', from: B.ciclo.bueno, to: B.ciclo.regular, tone: 'warn' },
            { label: 'Ciclo crítico', from: B.ciclo.regular, to: B.ciclo.max, tone: 'bad' },
          ],
        };
      }

      // ── 2. Capital de trabajo, ratio corriente y prueba ácida ─────────────
      if (id === 'liquidez') {
        const liquido = b.ac - b.inv;
        const dxRatio =
          b.ratio < B.liquidez.riesgo ? 'no cubrís el corto plazo'
          : b.ratio < B.liquidez.ajustada ? 'cubrís, pero con poco margen'
          : b.ratio <= B.liquidez.saludable ? 'liquidez saludable'
          : 'liquidez muy holgada: puede haber capital ocioso';
        const dxAcida =
          b.acida < B.acida.baja ? 'dependés del inventario para pagar'
          : b.acida >= B.acida.solida ? 'cubrís sin necesidad de vender stock'
          : 'la prueba ácida está justa';
        // Cuánto pasivo corriente podés cubrir con la caja de un día de venta.
        const diasVenta = b.ventasDiarias > 0 ? b.pc / b.ventasDiarias : 0;

        return {
          format: 'ars',
          decimals: 0,
          total: H.ars(b.capital),
          sub:
            'Ratio corriente ' + nf(b.ratio, 2) + ' y prueba ácida ' + nf(b.acida, 2) +
            ' · ' + dxRatio + ' · ' + dxAcida,
          rows: [
            { k: 'Activo corriente', v: b.ac, format: 'ars' },
            { k: 'Pasivo corriente', v: b.pc, format: 'ars' },
            { k: 'Capital de trabajo', ref: 'activo corriente menos pasivo corriente', v: b.capital, format: 'ars', extra: true },
            { k: 'Activo corriente sin inventario', ref: 'lo que se hace plata sin vender stock', v: liquido, format: 'ars' },
            { k: 'Ratio de liquidez corriente', ref: 'zona saludable: 1,5 a 2,5', v: b.ratio, format: 'unit', unit: 'veces', decimals: 2 },
            { k: 'Prueba ácida (liquidez seca)', ref: 'por debajo de 0,5 es frágil', v: b.acida, format: 'unit', unit: 'veces', decimals: 2 },
            { k: 'Peso del inventario en el activo corriente', v: b.ac > 0 ? (b.inv / b.ac) * 100 : 0, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Colchón sobre el mínimo saludable', ref: 'activo que sobra para llegar a 1,5', v: b.ac - b.pc * B.liquidez.ajustada, format: 'ars' },
            { k: 'Días de venta que representa el pasivo corriente', v: diasVenta, format: 'unit', unit: 'días', decimals: 1 },
          ],
          position: pos(b.ratio, B.liquidez.min, B.liquidez.max),
          positionLabel: 'Ratio corriente ' + nf(b.ratio, 2),
          chart: [
            { label: 'Riesgo', from: B.liquidez.min, to: B.liquidez.riesgo, tone: 'bad' },
            { label: 'Ajustada', from: B.liquidez.riesgo, to: B.liquidez.ajustada, tone: 'warn' },
            { label: 'Saludable', from: B.liquidez.ajustada, to: B.liquidez.saludable, tone: 'good' },
            { label: 'Holgada', from: B.liquidez.saludable, to: B.liquidez.max, tone: 'main' },
          ],
        };
      }

      // ── 3. Stock: rotación y costo de mantenerlo ──────────────────────────
      if (id === 'stock') {
        const capital = Math.max(0, Number(v.costo_capital_pct) || 0);
        const almacenaje = Math.max(0, Number(v.almacenaje_pct) || 0);
        const seguros = Math.max(0, Number(v.seguros_pct) || 0);
        const merma = Math.max(0, Number(v.merma_pct) || 0);
        // costo-almacenamiento-inventario.ts
        const holdingPct = capital + almacenaje + seguros + merma;
        const costoAnual = (b.inv * holdingPct) / 100;
        const costoMensual = costoAnual / MESES;
        // Lo que cuesta bancar el stock durante los días que tarda en venderse.
        const costoPorCiclo = (costoAnual * b.dio) / DIAS;
        const dx =
          b.rotacion <= B.rotacion.muyLenta ? 'rotación muy lenta: mucho capital parado'
          : b.rotacion <= B.rotacion.lenta ? 'rotación lenta: revisá lo que no sale'
          : b.rotacion <= B.rotacion.saludable ? 'rotación saludable, rango del retail sano'
          : 'rotación muy alta: excelente flujo, cuidado con los quiebres';

        return {
          format: 'ars',
          decimals: 0,
          total: H.ars(costoAnual),
          sub:
            'Rotás ' + nf(b.rotacion, 2) + ' veces al año y el stock tarda ' + nf(b.dio, 0) +
            ' días en venderse · mantenerlo cuesta ' + nf(holdingPct, 1) + '% anual (' +
            H.ars(costoMensual) + ' por mes) · ' + dx,
          rows: [
            { k: 'Valor del inventario promedio', v: b.inv, format: 'ars' },
            { k: 'Rotación anual del inventario', ref: 'CMV sobre inventario promedio', v: b.rotacion, format: 'unit', unit: 'veces', decimals: 2 },
            { k: 'Días de stock', ref: '365 sobre la rotación', v: b.dio, format: 'unit', unit: 'días', decimals: 0 },
            { k: 'Holding cost anual', ref: 'rango habitual: 20% a 30%', v: holdingPct, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Costo de capital inmovilizado', ref: nf(capital, 1) + '% del inventario', v: (b.inv * capital) / 100, format: 'ars' },
            { k: 'Almacenaje', ref: nf(almacenaje, 1) + '%', v: (b.inv * almacenaje) / 100, format: 'ars' },
            { k: 'Seguros', ref: nf(seguros, 1) + '%', v: (b.inv * seguros) / 100, format: 'ars' },
            { k: 'Merma y obsolescencia', ref: nf(merma, 1) + '%', v: (b.inv * merma) / 100, format: 'ars' },
            { k: 'Costo total de mantener el stock por año', v: costoAnual, format: 'ars', extra: true },
            { k: 'Costo por mes', v: costoMensual, format: 'ars' },
            { k: 'Costo de bancar el stock hasta venderlo', ref: 'los ' + nf(b.dio, 0) + ' días que tarda en salir', v: costoPorCiclo, format: 'ars' },
          ],
          position: pos(Math.min(b.rotacion, B.rotacion.max), B.rotacion.min, B.rotacion.max),
          positionLabel: nf(b.rotacion, 2) + ' rotaciones al año',
          chart: [
            { label: 'Muy lenta', from: B.rotacion.min, to: B.rotacion.muyLenta, tone: 'bad' },
            { label: 'Lenta', from: B.rotacion.muyLenta, to: B.rotacion.lenta, tone: 'warn' },
            { label: 'Saludable', from: B.rotacion.lenta, to: B.rotacion.saludable, tone: 'good' },
            { label: 'Muy alta', from: B.rotacion.saludable, to: B.rotacion.max, tone: 'main' },
          ],
        };
      }

      // ── 4. Flujo de caja libre ────────────────────────────────────────────
      const ebit = Math.max(0, Number(v.ebit) || 0);
      const tasa = Math.min(100, Math.max(0, Number(v.tasa_impositiva) || 0));
      const dep = Math.max(0, Number(v.depreciacion) || 0);
      const wc = Number(v.cambio_wc) || 0;
      const capex = Math.max(0, Number(v.capex) || 0);

      // flujo-caja-libre-fcf.ts
      const nopat = ebit * (1 - tasa / 100);
      const fcf = nopat + dep - wc - capex;
      const margenFcf = ebit > 0 ? (fcf / ebit) * 100 : 0;
      const estado =
        fcf > 0 ? 'genera caja libre: podés repagar deuda, reinvertir o repartir'
        : fcf === 0 ? 'la operación queda en equilibrio de caja'
        : 'consume más caja de la que genera: vas a necesitar financiamiento';

      return {
        format: 'ars',
        decimals: 0,
        total: H.ars(fcf),
        sub:
          'Margen de caja libre del ' + nf(margenFcf, 1) + '% sobre el EBIT · ' + estado +
          (b.cce > 0 ? ' · con un ciclo de ' + nf(b.cce, 0) + ' días, crecer te va a exigir más capital de trabajo' : ''),
        rows: [
          { k: 'EBIT — ganancia operativa', v: ebit, format: 'ars' },
          { k: 'Impuesto sobre la ganancia operativa', ref: 'tasa ' + nf(tasa, 0) + '%', v: ebit * (tasa / 100), format: 'ars' },
          { k: 'NOPAT — ganancia operativa después de impuestos', ref: 'EBIT × (1 − tasa)', v: nopat, format: 'ars' },
          { k: 'Depreciación y amortización', ref: 'se suma: no sale de la caja', v: dep, format: 'ars' },
          { k: 'Aumento del capital de trabajo', ref: 'se resta: queda inmovilizado', v: wc, format: 'ars' },
          { k: 'CAPEX — inversión en activos', ref: 'se resta', v: capex, format: 'ars' },
          { k: 'Flujo de caja libre', ref: 'NOPAT + depreciación − capital de trabajo − CAPEX', v: fcf, format: 'ars', extra: true },
          { k: 'Margen de caja libre sobre EBIT', v: margenFcf, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Caja libre por mes', v: fcf / MESES, format: 'ars' },
          { k: 'Caja que ya tenés inmovilizada por el ciclo', ref: nf(b.cce, 0) + ' días de operación', v: b.cce * b.cmvDiario, format: 'ars' },
        ],
        position: pos(Math.max(B.fcf.min, Math.min(B.fcf.max, margenFcf)), B.fcf.min, B.fcf.max),
        positionLabel: 'Margen FCF ' + nf(margenFcf, 1) + '%',
        chart: [
          { label: 'Consume caja', from: B.fcf.min, to: B.fcf.equilibrio, tone: 'bad' },
          { label: 'Justo', from: B.fcf.equilibrio, to: B.fcf.sano, tone: 'warn' },
          { label: 'Sano', from: B.fcf.sano, to: B.fcf.fuerte, tone: 'good' },
          { label: 'Fuerte', from: B.fcf.fuerte, to: B.fcf.max, tone: 'main' },
        ],
      };
    });
  })();
</script>
