---
/**
 * Hub de decisión — "Vendo bien pero no tengo plata: ¿por qué?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (ciclo de efectivo / liquidez / stock / caja).
 * La página sólo aporta datos (src/lib/hubs/capital-de-trabajo.ts) y compute().
 *
 * El hub MEZCLA pesos, días, veces y porcentajes. TODAS las filas declaran
 * `format` de forma explícita —también las de plata— porque el runtime hace
 * Object.assign sobre el formato del resultado y una fila sin formato propio
 * caería al default 'ars' e imprimiría días con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import CapitalTrabajoExperience from '../../components/generated/CapitalTrabajoExperience.astro';
import { hub, BANDAS, DIAS_ANIO, MESES_ANIO } from '../../lib/hubs/capital-de-trabajo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CapitalTrabajoExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

