---
/**
 * Hub de decisión — "¿Cuánto deja vender mi propia obra?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (streaming / ebook / audiolibro / suscriptores).
 * La página sólo aporta datos (src/lib/hubs/vender-mi-contenido.ts) y compute().
 *
 * OJO MONEDA: este negocio liquida en DÓLARES. El runtime formatea en pesos por
 * defecto y hace Object.assign, así que TODA fila declara `format` propio:
 * 'unit' + unit 'USD' para plata, 'plain' para cantidades. La única fila en
 * pesos es la equivalencia informativa al dólar oficial.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VenderContenidoExperience from '../../components/generated/VenderContenidoExperience.astro';
import {
  hub,
  USD_ARS,
  RATES_STREAM,
  RATE_FALLBACK,
  KDP,
  AUDIBLE,
  FEE_PLATAFORMA,
  STRIPE,
  FACTOR_ANUAL,
  MESES,
} from '../../lib/hubs/vender-mi-contenido';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <VenderContenidoExperience data={hub} />
  <Footer />
</Layout>

