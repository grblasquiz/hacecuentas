---
/**
 * Hub de decisión — "CPC, CPM y ROAS: ¿cuánto me cuesta un cliente?"
 * Reemplaza 16 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (embudo / retorno / valor del cliente / fiscal).
 * La página sólo aporta datos (src/lib/hubs/metricas-ads.ts) y compute().
 *
 * El hub MEZCLA unidades: pesos, cantidades, porcentajes, veces y meses. TODAS
 * las filas que no son plata declaran `format` propio: el runtime hace
 * Object.assign y una fila sin formato caería a pesos con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MetricasMarketingExperience from '../../components/generated/MetricasMarketingExperience.astro';
import { hub, PAUTA_EXTERIOR, BENCH, MESES_ANIO } from '../../lib/hubs/metricas-ads';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <MetricasMarketingExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ PAUTA: PAUTA_EXTERIOR, BENCH, MESES_ANIO }}>
  (function () {
    const H = window.HC_HUB;
    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });

    /**
     * El embudo completo. Es la misma cadena que cortaban en pedazos
     * marketing-cpm, marketing-cpc, costo-por-lead, marketing-conversion,
     * cpm-cpc-conversion-ads y cac-costo-adquisicion-sales-funnel.
     */
    function embudo(v) {
      const presupuesto = Math.max(0, Number(v.presupuesto) || 0);
      const cpm = Math.max(0, Number(v.cpm) || 0);
      const ctr = Math.max(0, Number(v.ctr) || 0) / 100;
      const convLead = Math.max(0, Number(v.conv_lead) || 0) / 100;
      const cierre = Math.max(0, Number(v.cierre) || 0) / 100;
      const ticket = Math.max(0, Number(v.ticket) || 0);
      const margen = Math.min(100, Math.max(0, Number(v.margen) || 0)) / 100;

      const impresiones = cpm > 0 ? (presupuesto / cpm) * 1000 : 0;
      const clicks = impresiones * ctr;
      const leads = clicks * convLead;
      const clientes = leads * cierre;
      const cpc = clicks > 0 ? presupuesto / clicks : 0;
      const cpl = leads > 0 ? presupuesto / leads : 0;
      const cac = clientes > 0 ? presupuesto / clientes : 0;
      const ingresos = clientes * ticket;

      return {
        presupuesto: presupuesto, cpm: cpm, ctr: ctr, ticket: ticket, margen: margen,
        impresiones: impresiones, clicks: clicks, leads: leads, clientes: clientes,
        cpc: cpc, cpl: cpl, cac: cac, ingresos: ingresos,
      };
    }

    /** Reparto de unos ingresos en pauta, costo del producto y ganancia. */
    function repartoPL(ingresos, inversion, margen) {
      const costoProducto = ingresos * (1 - margen);
      const ganancia = ingresos * margen - inversion;
      return [
        { label: 'Inversión en pauta', value: Math.max(0, inversion), tone: 'warn' },
        { label: 'Costo del producto', value: Math.max(0, costoProducto), tone: 'prop' },
        { label: ganancia >= 0 ? 'Ganancia neta' : 'Ganancia neta (negativa)', value: Math.max(0, ganancia), tone: ganancia >= 0 ? 'good' : 'bad' },
      ];
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'embudo';
      const e = embudo(v);

      // ── 1. Embudo: de la impresión al cliente ─────────────────────────────
      if (id === 'embudo') {
        return {
          total: H.ars(e.cac),
          sub:
            nf(e.clientes, 1) + ' clientes con ' + H.ars(e.presupuesto) + ' de pauta · CPC ' +
            H.ars(e.cpc) + ' · CPL ' + H.ars(e.cpl) +
            ' · de cada 1.000 impresiones sale ' + nf(e.impresiones > 0 ? (e.clientes / e.impresiones) * 1000 : 0, 2) + ' cliente',
          rows: [
            { k: 'Impresiones que compra el presupuesto', ref: 'CPM ' + H.ars(e.cpm), v: e.impresiones, format: 'plain' },
            { k: 'Clicks', ref: 'CTR ' + nf(e.ctr * 100, 2) + '%', v: e.clicks, format: 'plain' },
            { k: 'CPC — costo por click', v: e.cpc, decimals: 2 },
            { k: 'Leads', ref: 'conversión ' + nf(Number(v.conv_lead), 1) + '%', v: e.leads, format: 'plain' },
            { k: 'CPL — costo por lead', v: e.cpl },
            { k: 'Clientes nuevos', ref: 'cierre ' + nf(Number(v.cierre), 0) + '%', v: e.clientes, format: 'plain', decimals: 1 },
            { k: 'CAC — costo por cliente', ref: 'CPA de la campaña', v: e.cac, extra: true },
            { k: 'Ingresos de la primera compra', ref: 'ticket ' + H.ars(e.ticket), v: e.ingresos },
            { k: 'Conversión total del embudo', ref: 'de impresión a cliente', v: e.impresiones > 0 ? (e.clientes / e.impresiones) * 100 : 0, format: 'unit', unit: '%', decimals: 3 },
          ],
          chart: repartoPL(e.ingresos, e.presupuesto, e.margen),
        };
      }

      // ── 2. ROAS y punto de equilibrio ─────────────────────────────────────
      if (id === 'roas') {
        const roas = e.presupuesto > 0 ? e.ingresos / e.presupuesto : 0;
        const breakEven = e.margen > 0 ? 1 / e.margen : 0;
        const margenPesos = e.ingresos * e.margen;
        const gananciaNeta = margenPesos - e.presupuesto;

        return {
          total: nf(roas, 2) + '×',
          sub:
            'Necesitás ' + nf(breakEven, 2) + '× para no perder (margen ' + nf(e.margen * 100) + '%) · ' +
            (gananciaNeta >= 0
              ? 'te quedan ' + H.ars(gananciaNeta) + ' limpios'
              : 'estás perdiendo ' + H.ars(Math.abs(gananciaNeta))),
          rows: [
            { k: 'Inversión en pauta', v: e.presupuesto },
            { k: 'Ingresos generados', ref: nf(e.clientes, 1) + ' clientes × ' + H.ars(e.ticket), v: e.ingresos },
            { k: 'ROAS', ref: 'ingresos sobre inversión', v: roas, format: 'unit', unit: 'veces', decimals: 2 },
            { k: 'ROAS de equilibrio', ref: '1 sobre el margen bruto', v: breakEven, format: 'unit', unit: 'veces', decimals: 2 },
            { k: 'Margen bruto en pesos', ref: nf(e.margen * 100) + '% de los ingresos', v: margenPesos },
            { k: gananciaNeta >= 0 ? 'Ganancia neta' : 'Pérdida neta', v: Math.abs(gananciaNeta), extra: true },
            { k: 'CAC de esta campaña', v: e.cac },
            { k: 'Margen que deja cada cliente nuevo', v: e.ticket * e.margen - e.cac },
          ],
          chart: repartoPL(e.ingresos, e.presupuesto, e.margen),
        };
      }

      // ── 3. CAC, LTV y churn ───────────────────────────────────────────────
      if (id === 'cliente') {
        const churn = Math.min(100, Math.max(0.1, Number(v.churn) || 0.1)) / 100;
        const comprasAnio = Math.max(0, Number(v.compras_ano) || 0);
        const vidaMeses = 1 / churn;
        const comprasMes = comprasAnio / MESES_ANIO;
        const comprasVida = comprasMes * vidaMeses;
        const ltv = e.ticket * comprasVida;
        const ltvMargen = ltv * e.margen;
        const ratio = e.cac > 0 ? ltv / e.cac : 0;
        const ratioMargen = e.cac > 0 ? ltvMargen / e.cac : 0;
        const ingresoMes = e.ticket * comprasMes;
        const payback = ingresoMes > 0 ? e.cac / ingresoMes : 0;

        return {
          total: H.ars(ltv),
          sub:
            'LTV sobre CAC de ' + nf(ratio, 1) + '× (sobre margen, ' + nf(ratioMargen, 1) + '×) · ' +
            'vida media de ' + nf(vidaMeses, 1) + ' meses · el CAC se recupera en ' + nf(payback, 1) + ' meses' +
            (ratioMargen >= BENCH.ltvCac ? ' · relación sana' : ' · por debajo del 3× de referencia'),
          rows: [
            { k: 'CAC — costo de traer un cliente', v: e.cac },
            { k: 'Retención mensual', ref: 'churn ' + nf(churn * 100, 1) + '%', v: (1 - churn) * 100, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Vida media del cliente', ref: '1 sobre el churn mensual', v: vidaMeses, format: 'unit', unit: 'meses', decimals: 1 },
            { k: 'Compras en toda su vida', v: comprasVida, format: 'plain', decimals: 1 },
            { k: 'LTV en ingresos', ref: 'ticket × compras de toda la vida', v: ltv, extra: true },
            { k: 'LTV a margen', ref: 'lo que de verdad te queda', v: ltvMargen },
            { k: 'Relación LTV sobre CAC', ref: 'referencia sana: 3×', v: ratio, format: 'unit', unit: 'veces', decimals: 1 },
            { k: 'Relación usando el margen', v: ratioMargen, format: 'unit', unit: 'veces', decimals: 1 },
            { k: 'Meses para recuperar el CAC', ref: 'referencia: menos de 12', v: payback, format: 'unit', unit: 'meses', decimals: 1 },
          ],
          chart: [
            { label: 'Costo de adquisición', value: Math.min(e.cac, ltv), tone: 'warn' },
            { label: 'Costo del producto', value: Math.max(0, ltv * (1 - e.margen)), tone: 'prop' },
            { label: 'Lo que te queda', value: Math.max(0, ltvMargen - e.cac), tone: 'good' },
          ],
        };
      }

      // ── 4. Costo real de la pauta del exterior ────────────────────────────
      const monto = e.presupuesto;
      const esRI = v.condicion !== 'monotributista';
      const pagaPesos = v.forma_pago !== 'dolares-propios';
      const iibbPct = Math.max(0, Number(v.iibb_pct) || 0);

      const iva = monto * (PAUTA.ivaPct / 100);
      const percepcion = pagaPesos ? monto * (PAUTA.percepcionGananciasPct / 100) : 0;
      const iibb = pagaPesos ? monto * (iibbPct / 100) : 0;
      const bruto = monto + iva + percepcion + iibb;
      // El RI computa el IVA como crédito fiscal; las percepciones son a cuenta
      // para ambos. El monotributista puro no recupera el IVA.
      const recuperable = (esRI ? iva : 0) + percepcion + iibb;
      const real = bruto - recuperable;
      const recargo = monto > 0 ? ((real - monto) / monto) * 100 : 0;

      const rows = [
        { k: 'Pauta neta que factura la plataforma', v: monto },
        { k: 'IVA de servicios digitales del exterior', ref: PAUTA.ivaPct + '% · RG 4240/2018', v: iva },
        { k: 'Percepción a cuenta de Ganancias y Bienes Personales', ref: pagaPesos ? PAUTA.percepcionGananciasPct + '% · RG 5617/2024' : 'no aplica pagando en dólares propios', v: percepcion },
        { k: 'Percepción de IIBB provincial', ref: pagaPesos ? nf(iibbPct, 1) + '%' : 'no aplica pagando en dólares propios', v: iibb },
        { k: 'Costo bruto que te debitan', v: bruto, extra: true },
        { k: 'Recuperable o computable', ref: esRI ? 'IVA como crédito fiscal + percepciones a cuenta' : 'sólo las percepciones, a cuenta', v: recuperable },
        { k: 'Costo real de la pauta', v: real },
        { k: 'Recargo efectivo sobre la pauta', v: recargo, format: 'unit', unit: '%', decimals: 1 },
      ];
      if (e.cac > 0) rows.push({ k: 'CAC ajustado por el costo real', ref: 'CAC de tu embudo × recargo', v: e.cac * (monto > 0 ? real / monto : 1) });

      return {
        total: H.ars(real),
        sub:
          'Te debitan ' + H.ars(bruto) + ' por ' + H.ars(monto) + ' de pauta · recargo efectivo del ' +
          nf(recargo, 1) + '% · ' +
          (esRI
            ? 'como responsable inscripto recuperás el IVA'
            : 'como monotributista el IVA es costo irrecuperable'),
        rows: rows,
        chart: [
          { label: 'Pauta neta', value: monto, tone: 'main' },
          { label: 'IVA', value: iva, tone: 'warn' },
          { label: 'Percepción Ganancias', value: percepcion, tone: 'bad' },
          { label: 'Percepción IIBB', value: iibb, tone: 'prop' },
        ],
      };
    });
  })();
</script>
