---
/**
 * Hub de decisión — "¿Cuánta plata necesito, cuánto rinde y cuánto vale mi negocio?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 5 casos (abrir / rendir / valer en marcha / valer startup / WACC).
 * La página sólo aporta datos (src/lib/hubs/cuanto-vale-mi-negocio.ts) y compute().
 *
 * El hub MEZCLA unidades: pesos, dólares, meses, años, veces y porcentajes. TODAS
 * las filas que no son pesos declaran `format` propio: el runtime hace
 * Object.assign y una fila sin formato caería a pesos con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import CuantoValeNegocioExperience from '../../components/generated/CuantoValeNegocioExperience.astro';
import {
  hub,
  MULTIPLO_BANDAS,
  RANGO_VALUACION_PCT,
  BERKUS,
  PAYBACK_BANDAS,
  WACC_BANDAS,
  MESES_ANIO,
} from '../../lib/hubs/cuanto-vale-mi-negocio';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CuantoValeNegocioExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

