---
/**
 * Hub de decisión — "¿Cuánta plata necesito, cuánto rinde y cuánto vale mi negocio?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 5 casos (abrir / rendir / valer en marcha / valer startup / WACC).
 * La página sólo aporta datos (src/lib/hubs/cuanto-vale-mi-negocio.ts) y compute().
 *
 * El hub MEZCLA unidades: pesos, dólares, meses, años, veces y porcentajes. TODAS
 * las filas que no son pesos declaran `format` propio: el runtime hace
 * Object.assign y una fila sin formato caería a pesos con "$".
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  MULTIPLO_BANDAS,
  RANGO_VALUACION_PCT,
  BERKUS,
  PAYBACK_BANDAS,
  WACC_BANDAS,
  MESES_ANIO,
} from '../../lib/hubs/cuanto-vale-mi-negocio';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    BANDAS: MULTIPLO_BANDAS,
    RANGO: RANGO_VALUACION_PCT,
    BERKUS,
    PAYBACK: PAYBACK_BANDAS,
    WACCB: WACC_BANDAS,
    MESES_ANIO,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const n = (x) => (isFinite(Number(x)) ? Number(x) : 0);
    const nf = (x, d) =>
      Number(x || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });
    const usd = (x) => 'USD ' + nf(Math.round(x));

    /** Capital para abrir: inversión fija + colchón. Espejo de capitalInicialAbrirNegocio. */
    function capital(v) {
      const fija =
        Math.max(0, n(v.alquiler_deposito)) +
        Math.max(0, n(v.equipamiento)) +
        Math.max(0, n(v.mercaderia)) +
        Math.max(0, n(v.habilitaciones_marketing));
      const colchon = Math.max(0, n(v.meses_colchon)) * Math.max(0, n(v.gastos_mensuales));
      return { fija: fija, colchon: colchon, total: fija + colchon };
    }

    /** Resultado del mes. Espejo de rentabilidadMensual (sin el redondeo de la vieja). */
    function mes(v) {
      const ing = Math.max(0, n(v.ingresos));
      const cv = Math.max(0, n(v.costos_variables));
      const cf = Math.max(0, n(v.costos_fijos));
      const gan = ing - cv - cf;
      return { ing: ing, cv: cv, cf: cf, gan: gan, margen: ing > 0 ? (gan / ing) * 100 : 0 };
    }

    /** Depreciación por línea recta. Espejo de depreciacionActivosLineaRecta. */
    function deprec(v) {
      const compra = Math.max(0, n(v.activo_valor));
      const residual = Math.max(0, n(v.activo_residual));
      const vida = Math.max(1, n(v.activo_vida));
      const base = Math.max(0, compra - residual);
      const anual = base / vida;
      return { compra: compra, residual: residual, vida: vida, base: base, anual: anual, mensual: anual / MESES_ANIO, tasa: (1 / vida) * 100 };
    }

    function banda(lista, x) {
      for (let i = 0; i < lista.length; i++) if (x < lista[i].hasta) return lista[i];
      return lista[lista.length - 1];
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'abrir';
      const cap = capital(v);
      const m = mes(v);
      const dep = deprec(v);

      // ── 1. Cuánta plata necesito para abrir ───────────────────────────────
      if (id === 'abrir') {
        const pctColchon = cap.total > 0 ? (cap.colchon / cap.total) * 100 : 0;
        // payback-inversion: inversión / flujo mensual neto
        const payMeses = m.gan > 0 ? cap.total / m.gan : 0;
        const payAnios = payMeses / MESES_ANIO;
        const retornoAnual = cap.total > 0 ? ((m.gan * MESES_ANIO) / cap.total) * 100 : 0;
        const ev = m.gan > 0 ? banda(PAYBACK, payMeses).nombre : 'sin recupero: el flujo mensual no es positivo';

        return {
          total: H.ars(cap.total),
          sub:
            'Inversión fija ' + H.ars(cap.fija) + ' + colchón de ' + nf(n(v.meses_colchon)) + ' meses ' +
            H.ars(cap.colchon) + ' (' + nf(pctColchon) + '% del total) · ' +
            (m.gan > 0
              ? 'se recupera en ' + nf(payMeses, 1) + ' meses — ' + ev
              : 'con este resultado mensual no hay recupero'),
          rows: [
            { k: 'Alquiler y depósito', v: Math.max(0, n(v.alquiler_deposito)) },
            { k: 'Equipamiento e instalaciones', v: Math.max(0, n(v.equipamiento)) },
            { k: 'Mercadería o insumos iniciales', v: Math.max(0, n(v.mercaderia)) },
            { k: 'Habilitaciones, papeles y marketing', v: Math.max(0, n(v.habilitaciones_marketing)) },
            { k: 'Inversión inicial fija', ref: 'antes de vender el primer peso', v: cap.fija },
            { k: 'Colchón de supervivencia', ref: nf(n(v.meses_colchon)) + ' meses × gastos mensuales', v: cap.colchon },
            { k: 'Capital total para abrir', v: cap.total, extra: true },
            { k: 'Peso del colchón sobre el capital', v: pctColchon, format: 'unit', unit: '%', decimals: 0 },
            { k: 'Flujo de caja mensual neto', ref: 'ingresos − variables − fijos', v: m.gan },
            { k: 'Payback: meses para recuperar el capital', ref: ev, v: payMeses, format: 'unit', unit: 'meses', decimals: 1 },
            { k: 'Payback en años', v: payAnios, format: 'unit', unit: 'años', decimals: 1 },
            { k: 'Retorno anualizado simple', ref: 'flujo × 12 sobre el capital', v: retornoAnual, format: 'unit', unit: '%', decimals: 1 },
          ],
          chart: [
            { label: 'Alquiler y depósito', value: Math.max(0, n(v.alquiler_deposito)), tone: 'main' },
            { label: 'Equipamiento', value: Math.max(0, n(v.equipamiento)), tone: 'exit' },
            { label: 'Mercadería inicial', value: Math.max(0, n(v.mercaderia)), tone: 'prop' },
            { label: 'Habilitaciones y marketing', value: Math.max(0, n(v.habilitaciones_marketing)), tone: 'good' },
            { label: 'Colchón de supervivencia', value: cap.colchon, tone: 'warn' },
          ],
        };
      }

      // ── 2. Cuánto rinde por mes y cómo proyecta ───────────────────────────
      if (id === 'rendir') {
        const rentMensual = cap.total > 0 ? (m.gan / cap.total) * 100 : 0;
        const rentAnual = rentMensual * MESES_ANIO;
        // proyeccion-ventas: ventas × (1 + tasa)^meses
        const tasa = n(v.crecimiento) / 100;
        const meses = Math.min(60, Math.max(1, Math.round(n(v.meses_proyectar)) || 1));
        const proyectadas = m.ing * Math.pow(1 + tasa, meses);
        const crecTotal = m.ing > 0 ? (proyectadas / m.ing - 1) * 100 : 0;
        let acumulado = 0;
        for (let k = 1; k <= meses; k++) acumulado += m.ing * Math.pow(1 + tasa, k);
        const ebitdaMes = m.gan + dep.mensual;

        return {
          total: H.ars(m.gan),
          sub:
            'Margen neto ' + nf(m.margen, 1) + '% · rentabilidad ' + nf(rentMensual, 1) +
            '% mensual sobre ' + H.ars(cap.total) + ' de capital (' + nf(rentAnual, 1) + '% anual simple) · ' +
            'en ' + meses + ' meses las ventas llegarían a ' + H.ars(proyectadas) + ' por mes',
          rows: [
            { k: 'Ingresos del mes', v: m.ing },
            { k: 'Costos variables', v: m.cv },
            { k: 'Costos fijos', v: m.cf },
            { k: m.gan >= 0 ? 'Ganancia neta del mes' : 'Pérdida del mes', v: Math.abs(m.gan), extra: true },
            { k: 'Margen neto sobre ventas', v: m.margen, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Rentabilidad mensual sobre el capital', ref: 'capital invertido ' + H.ars(cap.total), v: rentMensual, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Rentabilidad anual simple', ref: 'la mensual × 12, sin capitalizar', v: rentAnual, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Depreciación mensual del equipamiento', ref: 'línea recta, ' + nf(dep.vida) + ' años', v: dep.mensual },
            { k: 'EBITDA mensual', ref: 'ganancia + depreciación', v: ebitdaMes },
            { k: 'Ventas proyectadas al mes ' + meses, ref: nf(n(v.crecimiento), 1) + '% mensual compuesto', v: proyectadas },
            { k: 'Crecimiento total del período', v: crecTotal, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Facturación acumulada del período', v: acumulado },
          ],
          chart: [
            { label: 'Costos variables', value: m.cv, tone: 'prop' },
            { label: 'Costos fijos', value: m.cf, tone: 'warn' },
            { label: m.gan >= 0 ? 'Ganancia neta' : 'Pérdida', value: Math.abs(m.gan), tone: m.gan >= 0 ? 'good' : 'bad' },
          ],
        };
      }

      // ── 3. Cuánto vale un negocio en marcha (múltiplo de EBITDA) ──────────
      if (id === 'valer-marcha') {
        const ebitdaAnual = m.gan * MESES_ANIO + dep.anual;
        const mult = Math.max(0, n(v.multiplo));
        const ev = ebitdaAnual * mult;
        const deudaNeta = Math.max(0, n(v.deuda_total)) - Math.max(0, n(v.caja));
        const equity = ev - deudaNeta;
        const min = equity * (1 - RANGO / 100);
        const max = equity * (1 + RANGO / 100);
        const ratio = ev > 0 ? (equity / ev) * 100 : 0;
        const b = banda(BANDAS, mult);

        return {
          total: H.ars(equity),
          sub:
            'Enterprise Value ' + H.ars(ev) + ' a ' + nf(mult, 1) + '× EBITDA (' + b.nombre.toLowerCase() +
            ': ' + b.texto + ') · deuda neta ' + H.ars(deudaNeta) +
            ' · rango de negociación ' + H.ars(min) + ' a ' + H.ars(max),
          rows: [
            { k: 'Resultado operativo anual', ref: 'ganancia mensual × 12', v: m.gan * MESES_ANIO },
            { k: 'Depreciación anual que se suma de vuelta', ref: 'línea recta', v: dep.anual },
            { k: 'EBITDA anual', v: ebitdaAnual },
            { k: 'Múltiplo aplicado', ref: b.nombre, v: mult, format: 'unit', unit: 'veces', decimals: 1 },
            { k: 'Enterprise Value', ref: 'EBITDA × múltiplo', v: ev, extra: true },
            { k: 'Deuda total', v: Math.max(0, n(v.deuda_total)) },
            { k: 'Caja y equivalentes', v: Math.max(0, n(v.caja)) },
            { k: deudaNeta >= 0 ? 'Deuda neta' : 'Caja neta (suma valor)', v: Math.abs(deudaNeta) },
            { k: equity >= 0 ? 'Equity Value: lo que cobrás vos' : 'Equity Value negativo', v: Math.abs(equity) },
            { k: 'Piso del rango', ref: '−' + RANGO + '%', v: min },
            { k: 'Techo del rango', ref: '+' + RANGO + '%', v: max },
            { k: 'Equity sobre Enterprise Value', v: ratio, format: 'unit', unit: '%', decimals: 0 },
          ],
          chart: [
            { label: 'Equity Value', value: Math.max(0, equity), tone: 'good' },
            { label: 'Deuda neta que asume el comprador', value: Math.max(0, deudaNeta), tone: 'bad' },
            { label: 'Caja neta que suma', value: Math.max(0, -deudaNeta), tone: 'prop' },
          ],
        };
      }

      // ── 4. Cuánto vale una startup sin facturación (Berkus, en USD) ───────
      if (id === 'valer-startup') {
        const f = [
          { label: 'Idea atractiva y valor base', value: Math.max(0, Math.min(BERKUS.maxPorFactor, n(v.berkus_idea))) },
          { label: 'Prototipo o tecnología', value: Math.max(0, Math.min(BERKUS.maxPorFactor, n(v.berkus_prototipo))) },
          { label: 'Equipo de gestión', value: Math.max(0, Math.min(BERKUS.maxPorFactor, n(v.berkus_equipo))) },
          { label: 'Relaciones estratégicas', value: Math.max(0, Math.min(BERKUS.maxPorFactor, n(v.berkus_relaciones))) },
          { label: 'Ventas o tracción', value: Math.max(0, Math.min(BERKUS.maxPorFactor, n(v.berkus_traccion))) },
        ];
        const val = f.reduce((a, x) => a + x.value, 0);
        const pct = (val / BERKUS.techo) * 100;
        const orden = f.slice().sort((a, b) => b.value - a.value);
        const dg = banda(BERKUS.bandas, pct);

        return {
          total: usd(val),
          format: 'unit',
          unit: 'USD',
          sub:
            dg.nombre + ' · ' + nf(pct) + '% del techo de ' + usd(BERKUS.techo) + ' · ' +
            'lo más fuerte es ' + orden[0].label.toLowerCase() + ' (' + usd(orden[0].value) + ') y lo más flojo ' +
            orden[orden.length - 1].label.toLowerCase() + ' (' + usd(orden[orden.length - 1].value) + ')',
          rows: [
            { k: 'Idea atractiva y valor base', ref: 'tope ' + usd(BERKUS.maxPorFactor), v: f[0].value, format: 'unit', unit: 'USD' },
            { k: 'Prototipo o tecnología', ref: 'reduce el riesgo tecnológico', v: f[1].value, format: 'unit', unit: 'USD' },
            { k: 'Equipo de gestión', ref: 'reduce el riesgo de ejecución', v: f[2].value, format: 'unit', unit: 'USD' },
            { k: 'Relaciones estratégicas', ref: 'reducen el riesgo de mercado', v: f[3].value, format: 'unit', unit: 'USD' },
            { k: 'Ventas o tracción', ref: 'reducen el riesgo de producción', v: f[4].value, format: 'unit', unit: 'USD' },
            { k: 'Valuación pre-money', ref: dg.nombre, v: val, format: 'unit', unit: 'USD', extra: true },
            { k: 'Techo del método Berkus', ref: BERKUS.factores + ' factores × ' + usd(BERKUS.maxPorFactor), v: BERKUS.techo, format: 'unit', unit: 'USD' },
            { k: 'Porcentaje del techo alcanzado', v: pct, format: 'unit', unit: '%', decimals: 0 },
            { k: 'Factores todavía en cero', v: f.filter((x) => x.value === 0).length, format: 'plain' },
          ],
          chart: f.map((x, i) => ({
            label: x.label,
            value: x.value,
            tone: ['main', 'exit', 'prop', 'good', 'warn'][i],
          })),
        };
      }

      // ── 5. Cuánto me cuesta el capital (WACC) ─────────────────────────────
      const equity = Math.max(0, n(v.capital_propio));
      const deuda = Math.max(0, n(v.deuda_total));
      const valorEmpresa = equity + deuda;
      const ke = n(v.costo_equity);
      const kd = n(v.costo_deuda);
      const tax = Math.min(100, Math.max(0, n(v.tasa_impositiva)));
      const pesoE = valorEmpresa > 0 ? equity / valorEmpresa : 0;
      const pesoD = valorEmpresa > 0 ? deuda / valorEmpresa : 0;
      const kdPost = kd * (1 - tax / 100);
      const wacc = pesoE * ke + pesoD * kdPost;
      const aporteE = pesoE * ke;
      const aporteD = pesoD * kdPost;
      const rentAnualNeg = cap.total > 0 ? (m.gan / cap.total) * 100 * MESES_ANIO : 0;
      const spread = rentAnualNeg - wacc;
      const tono = wacc < WACCB.barato ? 'Capital barato' : wacc < WACCB.caro ? 'Costo de capital moderado' : 'Capital caro';

      return {
        total: nf(wacc, 2) + '%',
        format: 'unit',
        unit: '%',
        decimals: 2,
        sub:
          tono + ' · cada proyecto tiene que rendir más de ' + nf(wacc, 2) + '% anual para crear valor · ' +
          'tu negocio rinde ' + nf(rentAnualNeg, 1) + '% anual simple, ' +
          (spread >= 0
            ? 'con un spread positivo de ' + nf(spread, 1) + ' puntos'
            : 'es decir ' + nf(Math.abs(spread), 1) + ' puntos por debajo: destruye valor'),
        rows: [
          { k: 'Capital propio (equity)', v: equity, format: 'ars' },
          { k: 'Deuda total', v: deuda, format: 'ars' },
          { k: 'Valor total del capital empleado', v: valorEmpresa, format: 'ars' },
          { k: 'Peso del capital propio', v: pesoE * 100, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Peso de la deuda', v: pesoD * 100, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Costo del capital propio', v: ke, format: 'unit', unit: '%', decimals: 2 },
          { k: 'Costo de la deuda antes de impuestos', v: kd, format: 'unit', unit: '%', decimals: 2 },
          { k: 'Costo de la deuda después de impuestos', ref: 'tasa × (1 − ' + nf(tax) + '%)', v: kdPost, format: 'unit', unit: '%', decimals: 2 },
          { k: 'Aporte del equity al WACC', v: aporteE, format: 'unit', unit: 'puntos', decimals: 2 },
          { k: 'Aporte de la deuda al WACC', v: aporteD, format: 'unit', unit: 'puntos', decimals: 2 },
          { k: 'WACC', ref: tono, v: wacc, format: 'unit', unit: '%', decimals: 2, extra: true },
          { k: 'Rentabilidad anual simple del negocio', v: rentAnualNeg, format: 'unit', unit: '%', decimals: 1 },
          { k: spread >= 0 ? 'Spread de creación de valor' : 'Spread negativo: destrucción de valor', v: Math.abs(spread), format: 'unit', unit: 'puntos', decimals: 1 },
        ],
        chart: [
          { label: 'Aporte del equity', value: Math.max(0, aporteE), tone: 'main' },
          { label: 'Aporte de la deuda', value: Math.max(0, aporteD), tone: 'exit' },
        ],
      };
    });
  })();
</script>
