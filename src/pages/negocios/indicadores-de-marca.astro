---
/**
 * Hub de decisión — "Mi NPS es 32: ¿está bien o mal?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO de SCORECARD: 4 ramas (NPS / CES / rebote / share of
 * voice). En las cuatro el gráfico es `scale`: bandas de referencia + marcador
 * en `position` (0-100) con su `positionLabel`.
 *
 * NINGUNA fila es plata. El runtime hace Object.assign sobre un default de
 * 'ars', así que TODAS las filas y el resultado declaran `format` propio:
 * 'plain' o 'unit' + `unit`. Una fila sin formato imprimiría "$" sobre un
 * porcentaje.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  NPS_BANDS,
  CES_BANDS,
  REBOTE_BENCH,
  SOV_BANDS,
  ESOV_UMBRALES,
} from '../../lib/hubs/indicadores-de-marca';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    NPS_BANDS: NPS_BANDS,
    CES_BANDS: CES_BANDS,
    REBOTE_BENCH: REBOTE_BENCH,
    SOV_BANDS: SOV_BANDS,
    ESOV: ESOV_UMBRALES,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });

    /** Ubica un valor en un eje [min,max] y lo devuelve como 0-100. */
    const pos = (val, min, max) =>
      Math.min(100, Math.max(0, ((val - min) / (max - min)) * 100));

    /** Convierte una banda del .ts en segmento de gráfico posicional. */
    const segs = (bands) =>
      bands.map((b) => ({ label: b.label, value: b.to - b.from, from: b.from, to: b.to, tone: b.tone }));

    /** Nombre de la banda que contiene a `val` (último tramo incluye el tope). */
    function bandaDe(bands, val) {
      for (let i = 0; i < bands.length; i++) {
        const b = bands[i];
        if (val < b.to || i === bands.length - 1) return b.label;
      }
      return bands[bands.length - 1].label;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'nps';

      // ── 1. NPS — copia fiel de src/lib/formulas/nps.ts ────────────────────
      if (id === 'nps') {
        const p = Math.max(0, Number(v.nps_prom) || 0);
        const pa = Math.max(0, Number(v.nps_pas) || 0);
        const d = Math.max(0, Number(v.nps_det) || 0);
        const total = p + pa + d;

        const pctP = total > 0 ? (p / total) * 100 : 0;
        const pctPa = total > 0 ? (pa / total) * 100 : 0;
        const pctD = total > 0 ? (d / total) * 100 : 0;
        const npsVal = pctP - pctD;
        const npsOut = Math.round(npsVal);

        // Mismos cortes que la fórmula: <0 crítico, <30 mejorable, <50 bueno,
        // <70 excelente, resto extraordinario.
        let msg;
        if (npsVal < 0) msg = 'NPS negativo — más detractores que promotores. Crisis de experiencia.';
        else if (npsVal < 30) msg = 'NPS bajo — margen de mejora grande.';
        else if (npsVal < 50) msg = 'NPS bueno — estás sobre el promedio.';
        else if (npsVal < 70) msg = 'NPS excelente — experiencia muy por encima de la media.';
        else msg = 'NPS extraordinario — nivel Apple / Tesla (70 +).';

        // Palanca de pasivos: si la mitad de los pasivos pasara a promotor.
        const npsSiPasivos = total > 0 ? Math.round(((p + pa / 2) / total) * 100 - pctD) : 0;

        return {
          total: nf(npsOut, 0),
          sub:
            msg +
            ' · ' + nf(pctP, 1) + '% promotores menos ' + nf(pctD, 1) + '% detractores · ' +
            nf(total, 0) + ' respuestas',
          format: 'plain',
          rows: [
            { k: 'Respuestas totales', v: total, format: 'plain' },
            { k: 'Promotores (9 y 10)', ref: nf(p, 0) + ' respuestas', v: pctP, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Pasivos (7 y 8)', ref: nf(pa, 0) + ' respuestas · no suman ni restan', v: pctPa, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Detractores (0 a 6)', ref: nf(d, 0) + ' respuestas', v: pctD, format: 'unit', unit: '%', decimals: 1 },
            { k: 'NPS', ref: 'promotores menos detractores', v: npsOut, format: 'plain', extra: true },
            { k: 'NPS si la mitad de los pasivos pasara a promotor', ref: 'la palanca más rápida', v: npsSiPasivos, format: 'plain' },
            { k: 'Distancia hasta la banda excelente (50)', ref: 'puntos de NPS', v: Math.max(0, 50 - npsOut), format: 'unit', unit: 'puntos' },
          ],
          chart: segs(NPS_BANDS),
          position: pos(npsOut, -100, 100),
          positionLabel: 'NPS ' + nf(npsOut, 0) + ' — ' + bandaDe(NPS_BANDS, npsVal),
        };
      }

      // ── 2. CES — copia fiel de customer-effort-score-ces.ts ───────────────
      if (id === 'ces') {
        const r = [1, 2, 3, 4, 5, 6, 7].map((n) => Math.max(0, Number(v['ces_' + n]) || 0));
        const totalR = r.reduce((a, b) => a + b, 0);
        const suma = r.reduce((a, b, i) => a + b * (i + 1), 0);
        const cesRaw = totalR > 0 ? suma / totalR : 0;
        const ces = Number(cesRaw.toFixed(2));

        const bajo = r[4] + r[5] + r[6];
        const alto = r[0] + r[1] + r[2];
        const pctBajo = totalR > 0 ? (bajo / totalR) * 100 : 0;
        const pctAlto = totalR > 0 ? (alto / totalR) * 100 : 0;

        // Mismos cortes que la fórmula: >=6 excelente, >=5 bueno, >=4 aceptable,
        // >=3 malo, resto crítico.
        let diag;
        if (cesRaw >= 6) diag = 'Excelente: experiencia muy fluida. Tus clientes resuelven con mínimo esfuerzo.';
        else if (cesRaw >= 5) diag = 'Bueno: la experiencia funciona bien. Hay oportunidades de mejora menores.';
        else if (cesRaw >= 4) diag = 'Aceptable: hay fricciones que podés reducir para mejorar la retención.';
        else if (cesRaw >= 3) diag = 'Malo: tus clientes experimentan demasiado esfuerzo. Riesgo alto de churn.';
        else diag = 'Crítico: la experiencia genera frustración significativa. Acción urgente necesaria.';

        return {
          total: nf(ces, 2) + ' / 7',
          sub:
            diag + ' · ' + nf(pctBajo, 1) + '% de bajo esfuerzo (5 a 7) contra ' +
            nf(pctAlto, 1) + '% de alto esfuerzo (1 a 3) sobre ' + nf(totalR, 0) + ' respuestas',
          format: 'plain',
          decimals: 2,
          rows: [
            { k: 'Respuestas totales', v: totalR, format: 'plain' },
            { k: 'CES — promedio ponderado', ref: 'escala 1 a 7, 7 es el mínimo esfuerzo', v: ces, format: 'unit', unit: 'de 7', decimals: 2, extra: true },
            { k: 'Bajo esfuerzo (5 a 7)', ref: nf(bajo, 0) + ' respuestas', v: pctBajo, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Zona neutra (4)', ref: nf(r[3], 0) + ' respuestas', v: totalR > 0 ? (r[3] / totalR) * 100 : 0, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Alto esfuerzo (1 a 3)', ref: nf(alto, 0) + ' respuestas · los que más riesgo de churn tienen', v: pctAlto, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Suma ponderada de puntajes', ref: 'cada respuesta por su valor', v: suma, format: 'plain' },
            { k: 'Distancia hasta la banda excelente (6)', v: Math.max(0, 6 - ces), format: 'unit', unit: 'puntos', decimals: 2 },
          ],
          chart: segs(CES_BANDS),
          position: pos(ces, 1, 7),
          positionLabel: 'CES ' + nf(ces, 2) + ' — ' + bandaDe(CES_BANDS, cesRaw),
        };
      }

      // ── 3. Tasa de rebote — copia fiel de tasa-rebote-benchmark-sitio-web.ts
      if (id === 'rebote') {
        const totalS = Math.max(0, Number(v.web_sesiones) || 0);
        const rebotes = Math.min(totalS, Math.max(0, Number(v.web_rebotes) || 0));
        const tipo = String(v.web_tipo || 'otro');
        const bench = REBOTE_BENCH[tipo] || REBOTE_BENCH.otro;

        const tasaRaw = totalS > 0 ? (rebotes / totalS) * 100 : 0;
        const tasa = Number(tasaRaw.toFixed(1));
        const engagement = Number((100 - tasaRaw).toFixed(1));

        let diag;
        let banda;
        if (tasaRaw < bench.min) {
          banda = 'Bajo el rango';
          diag =
            'Por debajo del rango típico de ' + bench.label + ' (' + bench.min + '-' + bench.max +
            '%). Excelente, pero un valor tan bajo a veces delata un error de tracking: verificalo.';
        } else if (tasaRaw <= bench.max) {
          banda = 'Rango normal';
          diag =
            'Dentro del rango normal para ' + bench.label + ' (' + bench.min + '-' + bench.max +
            '%). Buen engagement, con margen para optimizar.';
        } else {
          banda = 'Sobre el rango';
          diag =
            'Por encima del benchmark de ' + bench.label + ' (' + bench.min + '-' + bench.max +
            '%). Revisá velocidad de carga, relevancia del contenido y experiencia mobile.';
        }

        const excedente = Math.max(0, tasaRaw - bench.max);
        const sesionesAGanar = totalS * (excedente / 100);

        return {
          total: nf(tasa, 1) + '%',
          sub:
            diag + ' · ' + nf(rebotes, 0) + ' rebotes sobre ' + nf(totalS, 0) + ' sesiones',
          format: 'unit',
          unit: '%',
          decimals: 1,
          rows: [
            { k: 'Sesiones totales', v: totalS, format: 'plain' },
            { k: 'Sesiones que rebotaron', v: rebotes, format: 'plain' },
            { k: 'Sesiones con engagement', ref: 'las que sí interactuaron', v: totalS - rebotes, format: 'plain' },
            { k: 'Tasa de rebote', ref: bench.label + ': ' + bench.min + '-' + bench.max + '%', v: tasa, format: 'unit', unit: '%', decimals: 1, extra: true },
            { k: 'Tasa de engagement', ref: 'el complemento a cien', v: engagement, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Piso del rango normal de tu tipo de sitio', v: bench.min, format: 'unit', unit: '%' },
            { k: 'Techo del rango normal de tu tipo de sitio', v: bench.max, format: 'unit', unit: '%' },
            { k: 'Exceso sobre el techo del rango', v: excedente, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Sesiones que recuperarías volviendo al techo del rango', v: sesionesAGanar, format: 'unit', unit: 'sesiones' },
          ],
          chart: [
            { label: 'Bajo el rango', value: bench.min, from: 0, to: bench.min, tone: 'good' },
            { label: 'Rango normal', value: bench.max - bench.min, from: bench.min, to: bench.max, tone: 'main' },
            { label: 'Sobre el rango', value: 100 - bench.max, from: bench.max, to: 100, tone: 'bad' },
          ],
          position: pos(tasa, 0, 100),
          positionLabel: nf(tasa, 1) + '% — ' + banda + ' (' + bench.label + ')',
        };
      }

      // ── 4. Share of voice — copia fiel de share-of-voice-marketing.ts ─────
      const marca = Math.max(0, Number(v.sov_marca) || 0);
      const totalMercado = Math.max(0, Number(v.sov_total) || 0);
      const som = Math.max(0, Number(v.sov_som) || 0);

      const sovRaw = totalMercado > 0 ? Math.min(100, (marca / totalMercado) * 100) : 0;
      const sov = Number(sovRaw.toFixed(2));
      const brecha = Number((sovRaw - som).toFixed(2));

      // Mismos cortes que la fórmula: >=50 dominio, >=25 líder, >=10 relevante,
      // >=3 challenger, resto marginal.
      let diagnostico;
      if (sovRaw >= 50) diagnostico = 'Dominio del mercado en comunicación.';
      else if (sovRaw >= 25) diagnostico = 'Marca líder de un segmento.';
      else if (sovRaw >= 10) diagnostico = 'Jugador relevante.';
      else if (sovRaw >= 3) diagnostico = 'Challenger.';
      else diagnostico = 'Participación marginal — difícil mover la aguja.';

      let sovVsSom;
      if (som === 0) sovVsSom = 'Ingresá tu market share para comparar SOV vs SOM.';
      else if (brecha >= ESOV.gana) sovVsSom = 'SOV > SOM (eSOV+): deberías ganar market share en los próximos meses.';
      else if (brecha >= ESOV.erosiona) sovVsSom = 'SOV ≈ SOM: estás defendiendo tu posición.';
      else sovVsSom = 'SOV < SOM: riesgo de perder participación frente a competidores que invierten más.';

      const rows = [
        { k: 'Métrica de tu marca', ref: 'inversión, impresiones o menciones', v: marca, format: 'plain' },
        { k: 'Total del mercado', ref: 'misma unidad que tu marca', v: totalMercado, format: 'plain' },
        { k: 'Share of voice', ref: diagnostico, v: sov, format: 'unit', unit: '%', decimals: 2, extra: true },
        { k: 'Resto del mercado', ref: 'todo lo que comunican los demás', v: Number((100 - sovRaw).toFixed(2)), format: 'unit', unit: '%', decimals: 2 },
      ];
      if (som > 0) {
        rows.push({ k: 'Share of market declarado', v: som, format: 'unit', unit: '%', decimals: 1 });
        rows.push({ k: 'Brecha SOV menos SOM', ref: 'exceso de share of voice', v: brecha, format: 'unit', unit: 'puntos', decimals: 2 });
        rows.push({ k: 'Métrica que necesitarías para una brecha de +5 puntos', ref: 'umbral de crecimiento', v: totalMercado * ((som + ESOV.gana) / 100), format: 'plain' });
      }
      rows.push({ k: 'Distancia hasta la banda de líder (25%)', v: Math.max(0, 25 - sov), format: 'unit', unit: 'puntos', decimals: 2 });

      return {
        total: nf(sov, 1) + '%',
        sub: diagnostico + ' · ' + sovVsSom,
        format: 'unit',
        unit: '%',
        decimals: 2,
        rows: rows,
        chart: segs(SOV_BANDS),
        position: pos(sov, 0, 100),
        positionLabel: 'SOV ' + nf(sov, 1) + '% — ' + bandaDe(SOV_BANDS, sovRaw),
      };
    });
  })();
</script>
