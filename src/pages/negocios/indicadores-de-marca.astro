---
/**
 * Hub de decisión — "Mi NPS es 32: ¿está bien o mal?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO de SCORECARD: 4 ramas (NPS / CES / rebote / share of
 * voice). En las cuatro el gráfico es `scale`: bandas de referencia + marcador
 * en `position` (0-100) con su `positionLabel`.
 *
 * NINGUNA fila es plata. El runtime hace Object.assign sobre un default de
 * 'ars', así que TODAS las filas y el resultado declaran `format` propio:
 * 'plain' o 'unit' + `unit`. Una fila sin formato imprimiría "$" sobre un
 * porcentaje.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import IndicadoresMarcaExperience from '../../components/generated/IndicadoresMarcaExperience.astro';
import {
  hub,
  NPS_BANDS,
  CES_BANDS,
  REBOTE_BENCH,
  SOV_BANDS,
  ESOV_UMBRALES,
} from '../../lib/hubs/indicadores-de-marca';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <IndicadoresMarcaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

