---
/**
 * Hub de decisión — "¿Cuánto se cobra la hora en mi oficio?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (profesión / seniority / mercado del cliente /
 * por palabra). La página sólo aporta compute(); los datos viven en
 * src/lib/hubs/tarifas-por-hora.ts.
 *
 * OJO MONEDA: tres de las cuatro ramas trabajan en DÓLARES y una en pesos. El
 * runtime hace Object.assign sobre un default 'ars', así que toda fila que no
 * sea peso argentino declara `format` propio ('unit' + unit, o 'plain').
 *
 * `EXP_TRAMOS` NO se pasa por define:vars: tiene un Infinity que se serializa
 * como null. Los tramos de experiencia se resuelven en el script.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import TarifasHoraExperience from '../../components/generated/TarifasHoraExperience.astro';
import {
  hub,
  BASE_OFICIO,
  MERCADOS,
  NIVEL_MULT,
  PALABRA_NIVELES,
  CONTENIDO_MULT,
  DIRECCION_MULT,
  ESPECIALIZACION_MULT,
  BANDA,
  BANDA_SIMETRICA,
  HORAS_PROYECTO,
  USD_ARS_LIQUIDACION,
  USD_ARS_CCL,
} from '../../lib/hubs/tarifas-por-hora';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <TarifasHoraExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

