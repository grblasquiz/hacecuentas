---
/**
 * Hub de decisión — "¿Cuánto vale mi cuenta y cuánto puedo cobrar?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (engagement / tarifa / horario / regalías).
 * La página sólo aporta datos (src/lib/hubs/creador-de-contenido.ts) y compute().
 *
 * El hub MEZCLA unidades: porcentajes, horas, DÓLARES y pesos. TODAS las filas
 * que no son pesos declaran `format` propio: el runtime hace Object.assign y una
 * fila sin formato cae a pesos con "$". Las tarifas y las regalías van en USD
 * (`format:'unit'`, `unit:'USD'`), con una fila aparte de equivalencia en pesos.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CreadorContenidoExperience from '../../components/generated/CreadorContenidoExperience.astro';
import { hub, BASE_RATE_PER_1K, HORAS_UTC, RPS, DIST_PCT, BENCH_ER, USD_ARS } from '../../lib/hubs/creador-de-contenido';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CreadorContenidoExperience data={hub} />
  <Footer />
</Layout>

