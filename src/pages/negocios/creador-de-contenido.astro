---
/**
 * Hub de decisión — "¿Cuánto vale mi cuenta y cuánto puedo cobrar?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 4 casos (engagement / tarifa / horario / regalías).
 * La página sólo aporta datos (src/lib/hubs/creador-de-contenido.ts) y compute().
 *
 * El hub MEZCLA unidades: porcentajes, horas, DÓLARES y pesos. TODAS las filas
 * que no son pesos declaran `format` propio: el runtime hace Object.assign y una
 * fila sin formato cae a pesos con "$". Las tarifas y las regalías van en USD
 * (`format:'unit'`, `unit:'USD'`), con una fila aparte de equivalencia en pesos.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, BASE_RATE_PER_1K, HORAS_UTC, RPS, DIST_PCT, BENCH_ER, USD_ARS } from '../../lib/hubs/creador-de-contenido';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ RATES: BASE_RATE_PER_1K, HORAS: HORAS_UTC, RPS, DIST: DIST_PCT, BENCH: BENCH_ER, USD_ARS }}>
  (function () {
    const H = window.HC_HUB;
    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });
    const usd = (n, d) => 'USD ' + nf(n, d === undefined ? 2 : d);
    const hhmm = (h) => String(h).padStart(2, '0') + ':00';

    /** Engagement rate: (likes + comentarios + compartidos) / seguidores × 100. */
    function engagement(v) {
      const seg = Math.max(0, Number(v.seguidores) || 0);
      const likes = Math.max(0, Number(v.likes) || 0);
      const com = Math.max(0, Number(v.comentarios) || 0);
      const sh = Math.max(0, Number(v.compartidos) || 0);
      const total = likes + com + sh;
      const er = seg > 0 ? (total / seg) * 100 : 0;
      let band = BENCH[BENCH.length - 1];
      for (let i = 0; i < BENCH.length; i++) {
        if (seg < BENCH[i].max) { band = BENCH[i]; break; }
      }
      return { seg: seg, likes: likes, com: com, sh: sh, total: total, er: er, band: band };
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'engagement';
      const e = engagement(v);

      // ── 1. Engagement rate ────────────────────────────────────────────────
      if (id === 'engagement') {
        const nivel = e.er < 1 ? 'bajo' : e.er < 3 ? 'promedio' : e.er < 6 ? 'bueno' : 'excelente';
        const objetivo = (e.band.min + e.band.top) / 2;
        const faltan = Math.max(0, (objetivo / 100) * e.seg - e.total);
        const tope = Math.max(10, Math.ceil(e.er) + 1);

        return {
          total: nf(e.er, 2) + '%',
          sub:
            nf(e.total) + ' interacciones sobre ' + nf(e.seg) + ' seguidores · nivel ' + nivel +
            ' · tu franja es ' + e.band.label + ', que promedia ' + nf(e.band.min, 1) + '% a ' + nf(e.band.top, 1) + '%',
          rows: [
            { k: 'Likes', v: e.likes, format: 'plain' },
            { k: 'Comentarios', v: e.com, format: 'plain' },
            { k: 'Compartidos o guardados', v: e.sh, format: 'plain' },
            { k: 'Interacciones totales', ref: 'lo que suma el numerador', v: e.total, format: 'plain' },
            { k: 'Engagement rate', ref: 'interacciones sobre seguidores', v: e.er, format: 'unit', unit: '%', decimals: 2, extra: true },
            { k: 'Tasa de comentarios', ref: 'la señal más difícil de comprar', v: e.seg > 0 ? (e.com / e.seg) * 100 : 0, format: 'unit', unit: '%', decimals: 3 },
            { k: 'Promedio de referencia de tu franja', ref: e.band.label, v: objetivo, format: 'unit', unit: '%', decimals: 2 },
            { k: 'Interacciones que te faltan para ese promedio', v: faltan, format: 'plain' },
          ],
          chart: [
            { label: 'Bajo (menos de 1%)', value: 1, from: 0, to: 1, tone: 'bad' },
            { label: 'Promedio (1% a 3%)', value: 2, from: 1, to: 3, tone: 'warn' },
            { label: 'Bueno (3% a 6%)', value: 3, from: 3, to: 6, tone: 'good' },
            { label: 'Excelente (más de 6%)', value: tope - 6, from: 6, to: tope, tone: 'main' },
          ],
          position: Math.min(100, (e.er / tope) * 100),
          positionLabel: 'Engagement ' + nf(e.er, 2) + '% — nivel ' + nivel,
        };
      }

      // ── 2. Tarifa por post o colaboración (USD) ───────────────────────────
      if (id === 'tarifa') {
        // Las plataformas sin tarifario propio (LinkedIn, X, Facebook) caen a la
        // referencia de Instagram: es la más cercana en formato de feed.
        const rates = RATES[v.plataforma] || RATES.instagram;
        const baseRate = rates[v.tipo] || rates.post;
        const base = (e.seg / 1000) * baseRate;

        const erMult = e.er > 5 ? 1.5 : e.er > 3 ? 1.2 : e.er > 1.5 ? 1.0 : 0.7;
        const sizeMult = e.seg > 1000000 ? 0.7 : e.seg > 100000 ? 0.85 : e.seg < 10000 ? 1.3 : 1;
        const tarifa = base * erMult * sizeMult;

        const min = Math.round(tarifa * 0.6);
        const est = Math.round(tarifa);
        const max = Math.round(tarifa * 1.5);
        const interacciones = Math.round((e.seg * e.er) / 100);
        const cpe = interacciones > 0 ? est / interacciones : 0;
        const techo = Math.max(1, max);

        return {
          total: usd(est, 0),
          sub:
            'Rango para negociar: ' + usd(min, 0) + ' a ' + usd(max, 0) +
            ' · engagement ' + nf(e.er, 2) + '% (' + (erMult > 1 ? 'suma prima' : erMult === 1 ? 'sin prima' : 'recorta') + ')' +
            (USD_ARS > 0 ? ' · equivale a ' + H.ars(est * USD_ARS) + ' al oficial' : ''),
          rows: [
            { k: 'Tarifa base por tamaño de cuenta', ref: usd(baseRate, 0) + ' cada 1.000 seguidores', v: base, format: 'unit', unit: 'USD', decimals: 0 },
            { k: 'Ajuste por engagement', ref: nf(e.er, 2) + '% de interacción', v: erMult, format: 'unit', unit: 'veces', decimals: 2 },
            { k: 'Ajuste por tamaño', ref: 'las cuentas chicas cobran más por seguidor', v: sizeMult, format: 'unit', unit: 'veces', decimals: 2 },
            { k: 'Piso del rango', ref: 'no bajes de acá', v: min, format: 'unit', unit: 'USD', decimals: 0 },
            { k: 'Tarifa estimada', ref: 'el número para abrir la charla', v: est, format: 'unit', unit: 'USD', decimals: 0, extra: true },
            { k: 'Techo del rango', ref: 'con exclusividad o cesión de derechos', v: max, format: 'unit', unit: 'USD', decimals: 0 },
            { k: 'Interacciones esperadas', v: interacciones, format: 'plain' },
            { k: 'CPE — costo por interacción', ref: 'con esto te compara la marca', v: cpe, format: 'unit', unit: 'USD', decimals: 3 },
            { k: 'Equivalente en pesos al dólar oficial', ref: 'informativo, cambia todos los días', v: est * USD_ARS },
          ],
          chart: [
            { label: 'Por debajo del rango', value: min, from: 0, to: min, tone: 'bad' },
            { label: 'Zona de negociación', value: Math.max(0, est - min), from: min, to: est, tone: 'warn' },
            { label: 'Techo alcanzable', value: Math.max(0, max - est), from: est, to: techo, tone: 'good' },
          ],
          position: Math.min(100, (est / techo) * 100),
          positionLabel: 'Tarifa estimada ' + usd(est, 0) + ' dentro de un rango de ' + usd(min, 0) + ' a ' + usd(max, 0),
        };
      }

      // ── 3. Mejor hora para publicar ───────────────────────────────────────
      if (id === 'horario') {
        const offset = Number(v.gmt);
        const data = HORAS[v.plataforma] || HORAS.instagram;
        const toLocal = (h) => ((((h + (isNaN(offset) ? 0 : offset)) % 24) + 24) % 24);
        const mejores = data.mejor.map(toLocal);
        const peores = data.peor.map(toLocal);
        const plat = v.plataforma.charAt(0).toUpperCase() + v.plataforma.slice(1);

        return {
          total: hhmm(mejores[0]),
          sub:
            plat + ' · mejores ventanas ' + mejores.map(hhmm).join(', ') + ' hora local · días fuertes: ' +
            data.dias + ' · evitá la franja ' + hhmm(peores[0]) + ' a ' + hhmm(peores[2]),
          rows: [
            { k: 'Mejor ventana', ref: 'la de mayor alcance promedio', v: mejores[0], format: 'unit', unit: 'hs', extra: true },
            { k: 'Segunda ventana', v: mejores[1], format: 'unit', unit: 'hs' },
            { k: 'Tercera ventana', v: mejores[2], format: 'unit', unit: 'hs' },
            { k: 'Arranca la franja muerta', ref: 'tu audiencia está durmiendo', v: peores[0], format: 'unit', unit: 'hs' },
            { k: 'Termina la franja muerta', v: peores[2], format: 'unit', unit: 'hs' },
            { k: 'Diferencia con la hora UTC del estudio', v: isNaN(offset) ? 0 : offset, format: 'unit', unit: 'horas' },
            { k: 'Ventanas fuertes por día', v: mejores.length, format: 'plain' },
          ],
          chart: [
            { label: 'Madrugada (00 a 06)', value: 6, from: 0, to: 6, tone: 'bad' },
            { label: 'Mañana (06 a 12)', value: 6, from: 6, to: 12, tone: 'good' },
            { label: 'Tarde (12 a 18)', value: 6, from: 12, to: 18, tone: 'main' },
            { label: 'Noche (18 a 24)', value: 6, from: 18, to: 24, tone: 'warn' },
          ],
          position: (mejores[0] / 24) * 100,
          positionLabel: 'Publicá cerca de las ' + hhmm(mejores[0]) + ' (' + data.dias + ')',
        };
      }

      // ── 4. Regalías de streaming (USD) ────────────────────────────────────
      const streams = Math.max(0, Number(v.streams) || 0);
      const mercado = String(v.mercado || 'promedio').toUpperCase();
      const rps = RPS[mercado] !== undefined ? RPS[mercado] : RPS.promedio;
      const distPct = DIST[String(v.distribuidor || 'distrokid').toLowerCase()] || 0;
      const selloPct = Math.min(100, Math.max(0, Number(v.sello) || 0));

      const gross = streams * rps;
      const comDist = gross * (distPct / 100);
      const comSello = (gross - comDist) * (selloPct / 100);
      const neto = gross - comDist - comSello;
      const paraMil = rps > 0 ? Math.ceil(1000 / rps) : 0;
      const TOPE_RPS = 0.006; // por encima del mercado mejor pago de la tabla

      return {
        total: usd(neto),
        sub:
          nf(streams) + ' streams a ' + usd(rps, 4) + ' por reproducción · bruto ' + usd(gross) +
          ' · para llegar a USD 1.000 necesitás ' + nf(paraMil) + ' streams' +
          (USD_ARS > 0 ? ' · el neto equivale a ' + H.ars(neto * USD_ARS) : ''),
        rows: [
          { k: 'Streams del período', v: streams, format: 'plain' },
          { k: 'Valor por stream del mercado', ref: 'promedio del pozo, no un precio fijo', v: rps, format: 'unit', unit: 'USD', decimals: 4 },
          { k: 'Ingreso bruto', v: gross, format: 'unit', unit: 'USD', decimals: 2 },
          { k: 'Comisión del distribuidor', ref: nf(distPct, 0) + '% del bruto', v: comDist, format: 'unit', unit: 'USD', decimals: 2 },
          { k: 'Comisión de sello o manager', ref: nf(selloPct, 0) + '% de lo que queda', v: comSello, format: 'unit', unit: 'USD', decimals: 2 },
          { k: 'Te queda neto', ref: 'regalía de la grabación', v: neto, format: 'unit', unit: 'USD', decimals: 2, extra: true },
          { k: 'Streams necesarios para USD 1.000', v: paraMil, format: 'plain' },
          { k: 'Equivalente del neto en pesos al oficial', ref: 'informativo', v: neto * USD_ARS },
        ],
        chart: [
          { label: 'Mercados de pozo chico (hasta 0,002)', value: 2, from: 0, to: 0.002, tone: 'bad' },
          { label: 'Mercados intermedios (0,002 a 0,0035)', value: 1.5, from: 0.002, to: 0.0035, tone: 'warn' },
          { label: 'Mercados de pozo grande (más de 0,0035)', value: 2.5, from: 0.0035, to: TOPE_RPS, tone: 'good' },
        ],
        position: Math.min(100, (rps / TOPE_RPS) * 100),
        positionLabel: 'Tu mercado paga ' + usd(rps, 4) + ' por stream',
      };
    });
  })();
</script>
