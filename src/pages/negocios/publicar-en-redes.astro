---
/**
 * Hub de decisión — "¿Cómo publico en cada red para que rinda?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 5 casos (engagement / duración / carrusel / LinkedIn /
 * Pinterest). La página sólo aporta datos (src/lib/hubs/publicar-en-redes.ts) y
 * el compute() de abajo.
 *
 * NO HAY PLATA en ninguna rama. El runtime formatea en pesos por defecto y hace
 * Object.assign, así que TODAS las filas declaran `format` propio ('unit' con su
 * unidad, o 'plain'). Si alguna se olvidara, se imprimiría "$45" para 45
 * comentarios.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import PublicarRedesExperience from '../../components/generated/PublicarRedesExperience.astro';
import {
  hub,
  BANDS_SEGUIDORES,
  BANDS_ALCANCE,
  BENCH_TAMANO,
  DUR_OBJETIVO,
  DUR_NICHO,
  CARR_OBJETIVO,
  CARR_TIPO,
  LI_FORMATO,
  PIN_CUPO_PROGRAMABLE,
} from '../../lib/hubs/publicar-en-redes';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

// Infinity no sobrevive a JSON: se serializa como null. Lo mandamos como número.
const BENCH = BENCH_TAMANO.map((b) => ({ ...b, max: b.max === Infinity ? Number.MAX_SAFE_INTEGER : b.max }));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PublicarRedesExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

