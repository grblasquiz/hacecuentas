---
/**
 * Hub de decisión — "¿Cuánto me paga cada plataforma por mis views?"
 * Reemplaza 13 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: 5 casos (video largo / cortos / en vivo / texto y
 * display / requisitos para monetizar).
 *
 * OJO UNIDADES: este hub es casi todo DÓLARES. El runtime formatea en pesos por
 * defecto y hace Object.assign, así que el resultado declara
 * `format:'unit'`+`unit:'USD'` a nivel raíz y CADA fila que no sea dólares
 * (porcentajes, cantidades, meses, y la equivalencia en pesos) declara el suyo.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import IngresosPlataformaExperience from '../../components/generated/IngresosPlataformaExperience.astro';
import {
  hub,
  USD_ARS,
  YT_CPM_NICHO,
  YT_NICHO_LABEL,
  YT_REV_SHARE,
  YT_CPM_TIER,
  YPP,
  REELS_ORIGINAL,
  REELS_RESUBIDO,
  TIKTOK,
  TWITCH,
  ADSENSE_RPM_NICHO,
  ADSENSE_MULT_PAIS,
  X_RPM,
  X_COSTO_MES,
  MESES_ANIO,
} from '../../lib/hubs/ingresos-por-plataforma';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <IngresosPlataformaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

