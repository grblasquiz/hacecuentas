---
// SSR (prerender=false): el "hoy" se calcula en cada request → nunca queda viejo,
// a diferencia del fixture que lo fija en build. Captura la query de finde
// "partidos de hoy / resultados de hoy / a qué hora juegan". Resultados en vivo
// vía client-refresh del feed openfootball (mismo patrón que el fixture).
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WeekendPackCapture from '../components/WeekendPackCapture.astro';
import {
  fixture, LIVE_FIXTURE_URL, TEAMS,
  teamLabel, roundLabel, artTime, artDayKey, artDayLabel, kickoffUTC, result,
} from '../lib/data/mundial-2026.ts';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=600, stale-while-revalidate=86400');

const SITE = 'https://hacecuentas.com';
const URL = `${SITE}/partidos-hoy-mundial-2026`;

// "Hoy" en hora argentina, calculado AHORA (request time).
const now = new Date();
const todayKey = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'America/Argentina/Buenos_Aires', year: 'numeric', month: '2-digit', day: '2-digit',
}).format(now);

// Agrupar partidos por día (hora argentina), ordenados por kickoff.
const sorted = [...fixture.matches].sort((a, b) => {
  const ka = kickoffUTC(a.date, a.time)?.getTime() ?? 0;
  const kb = kickoffUTC(b.date, b.time)?.getTime() ?? 0;
  return ka !== kb ? ka - kb : a.num - b.num;
});
const dayMap = new Map<string, { key: string; label: string; matches: typeof sorted }>();
for (const m of sorted) {
  const key = artDayKey(m.date, m.time);
  if (!dayMap.has(key)) dayMap.set(key, { key, label: artDayLabel(m.date, m.time), matches: [] as any });
  dayMap.get(key)!.matches.push(m);
}
const days = [...dayMap.values()];

const todayMatches = dayMap.get(todayKey)?.matches ?? [];
const upcoming = days.filter((d) => d.key > todayKey).slice(0, 4);
const torneoTerminado = days.length > 0 && days.every((d) => d.key < todayKey);
const torneoNoEmpezo = days.length > 0 && days.every((d) => d.key > todayKey);

// Argentina: próximo partido (snapshot; el client-refresh lo corrige).
const argMatches = sorted.filter((m) => m.team1 === 'Argentina' || m.team2 === 'Argentina');
const argNext = argMatches.find((m) => !(m.score && m.score.ft)) || argMatches[argMatches.length - 1];
const argNextHoy = argNext && artDayKey(argNext.date, argNext.time) === todayKey;

const updatedLabel = new Intl.DateTimeFormat('es-AR', {
  timeZone: 'America/Argentina/Buenos_Aires', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false,
}).format(now);

const total = fixture.total || fixture.matches.length;

const titleTeams = todayMatches.slice(0, 2).flatMap((m) => [teamLabel(m.team1).es, teamLabel(m.team2).es]);
const titleHook = titleTeams.length ? `${titleTeams.slice(0, 2).join(' vs ')}` : 'horarios y resultados';
const title = `Partidos de hoy Mundial 2026: ${titleHook} | Hacé Cuentas`;
const description = todayMatches.length
  ? `Hoy se juegan ${todayMatches.length} partidos del Mundial 2026. Consultá equipos, horarios convertidos a tu zona y resultados en vivo.`
  : 'Partidos del Mundial 2026 de hoy y próximos días: equipos, horarios convertidos a tu zona y resultados en vivo.';

const faqItems = [
  { q: '¿Qué partidos del Mundial hay hoy?', a: todayMatches.length ? `Hoy se juegan ${todayMatches.length} partido${todayMatches.length > 1 ? 's' : ''} del Mundial 2026. Arriba ves cada uno con el horario en hora argentina y el resultado en vivo.` : 'La lista de arriba muestra los partidos del día (en hora argentina). Si hoy no hay partidos, te mostramos los próximos.' },
  { q: '¿A qué hora juegan hoy?', a: 'La jornada se organiza en hora argentina (UTC-3), pero el navegador convierte cada horario automáticamente a tu zona local. El horario original de Argentina queda disponible al pasar el cursor.' },
  { q: '¿Dónde veo los resultados en vivo?', a: 'Esta misma página actualiza los marcadores automáticamente mientras se juegan los partidos: dejala abierta y el resultado se completa solo, sin recargar.' },
  { q: '¿Juega Argentina hoy?', a: argNextHoy ? '¡Sí! Argentina juega hoy. Mirá el horario en la lista de arriba.' : (argNext ? `Hoy no juega Argentina. Su próximo partido es ${teamLabel(argNext.team1).es} vs ${teamLabel(argNext.team2).es}; mirá la fecha y hora en la calculadora de cuándo juega Argentina.` : 'No: el Mundial 2026 ya terminó. Argentina llegó a la final, que perdió 1-0 con España el 19 de julio.') },
  { q: '¿Qué partidos hay este fin de semana?', a: 'En "Próximos partidos" ves los días que vienen con sus horarios. Los fines de semana suele haber varios partidos por día durante la fase de grupos.' },
  { q: '¿Cómo sigo todo el calendario del Mundial?', a: 'En el fixture completo está el calendario día por día de los 104 partidos, con resultados. También tenés las posiciones de cada grupo, los goleadores y la llave de eliminatorias.' },
  { q: '¿De dónde salen los horarios y resultados?', a: 'Del proyecto de código abierto openfootball (dominio público) y la FIFA. Los horarios se convierten a hora argentina y los marcadores se actualizan durante el torneo.' },
  { q: '¿Cuántos partidos se juegan por día en el Mundial 2026?', a: 'Depende de la etapa. En la fase de grupos suele haber varios partidos por día —y en la última fecha de cada grupo dos se juegan a la misma hora—, mientras que en las eliminatorias baja a uno o dos por jornada. Arriba ves los del día de hoy y en "Próximos partidos" los de los días que vienen.' },
  { q: '¿Qué pasa si un partido termina empatado?', a: 'En la fase de grupos el empate es un resultado válido y cada equipo suma un punto. En las eliminatorias no puede haber empate: si el marcador está igualado a los 90 minutos se juega el alargue y, si sigue la paridad, se define por penales. Cuando eso ocurre, el resultado de arriba lo aclara ("tras alargue" o "penales").' },
  { q: '¿Cuándo fue la final del Mundial 2026?', a: 'El Mundial 2026 se disputó del 11 de junio al 19 de julio de 2026: la final se jugó el 19 de julio en el MetLife Stadium. En la página del campeón está el resultado y el palmarés completo.' },
  { q: '¿Esta página se actualiza sola durante los partidos?', a: 'Sí. El "hoy" se recalcula en cada visita, así que la lista nunca queda vieja, y los marcadores se actualizan automáticamente cada minuto mientras se juega, sin que tengas que recargar la página.' },
];
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Mundial 2026', item: `${SITE}/mundial-2026` },
    { '@type': 'ListItem', position: 3, name: 'Partidos de hoy', item: URL } ] },
  { '@type': 'FAQPage', mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
] };

const liveConfig = { url: LIVE_FIXTURE_URL, teams: TEAMS, todayKey };

// Última nota "partidos del finde" (se publica una por semana) — link evergreen.
const findeModules = import.meta.glob<any>('../content/blog/partidos-mundial-finde-*.json', { eager: true });
const findePost = Object.values(findeModules)
  .map((m: any) => m.default ?? m)
  .sort((a: any, b: any) => String(b.date || '').localeCompare(String(a.date || '')))[0];

const renderCard = (m: any) => {
  const t1 = teamLabel(m.team1); const t2 = teamLabel(m.team2); const r = result(m);
  return { m, t1, t2, r };
};
---

<Layout title={title} description={description} canonical="/partidos-hoy-mundial-2026" audience="global" schema={schema} domain="life">
  <Header slot="header" />
  <main class="article-main">
    <article class="ph-page">
      <header class="ph-header">
        <div class="ph-eyebrow">⚽ Mundial 2026 · en vivo</div>
        <h1>Partidos del Mundial 2026 de hoy</h1>
        <p class="lede">Los partidos del Mundial 2026 que se juegan <strong>hoy</strong> y los próximos días, con <strong>horarios convertidos a tu zona</strong> y <strong>resultados en vivo</strong>.</p>
        <p class="ph-upd">🔄 Actualizado <strong data-live-updated>{updatedLabel}</strong> · hora argentina (UTC-3)</p>
        <p class="ph-zone" data-zone-note>🕐 La jornada se calcula en hora argentina; los horarios se adaptan a tu dispositivo.</p>
      </header>

      <WeekendPackCapture source="partidos-hoy" />

      <p class="ph-answer" data-live-answer>
        {todayMatches.length
          ? <>Hoy se juegan <strong>{todayMatches.length}</strong> partido{todayMatches.length > 1 ? 's' : ''} del Mundial 2026. Debajo tenés cada uno con el horario en hora argentina (UTC-3) y el resultado en vivo.</>
          : torneoNoEmpezo
            ? <>El Mundial 2026 arranca el 11 de junio de 2026. Hoy todavía no hay partidos: debajo ves los próximos, con horario en hora argentina y resultados en vivo.</>
            : torneoTerminado
              ? <>El Mundial 2026 ya terminó: <a href="/campeon-mundial-2026">España salió campeón</a> al ganarle la final 1-0 a Argentina el 19 de julio. Hoy no hay partidos: mirá todos los resultados en el fixture completo.</>
              : <>Hoy no hay partidos del Mundial 2026. Debajo tenés los próximos partidos, con horario en hora argentina (UTC-3) y resultados en vivo.</>}
      </p>

      <section class="ph-today" aria-labelledby="ph-today-h">
        <h2 id="ph-today-h">
          {todayMatches.length ? '⚽ Partidos de hoy' : (torneoTerminado ? '🏁 El Mundial terminó' : torneoNoEmpezo ? '⏳ El Mundial todavía no empezó' : '😴 Hoy no hay partidos')}
        </h2>
        {todayMatches.length === 0 && (
          <p class="ph-empty">
            {torneoTerminado ? 'El torneo ya finalizó. Mirá los resultados en el fixture completo.'
              : torneoNoEmpezo ? 'Todavía no arrancó. Mientras tanto, mirá el calendario completo y armá tu prode.'
              : 'Hoy no se juega. Estos son los próximos partidos:'}
          </p>
        )}
        {todayMatches.length > 0 && (
          <div class="ph-grid">
            {todayMatches.map(renderCard).map(({ m, t1, t2, r }) => (
              <div class="ph-card" data-match data-num={m.num} data-team1={m.team1} data-team2={m.team2}>
                <div class="ph-card-top">
                  <span class="ph-round">{m.group ? roundLabel(m.round) + ' · ' + m.group.replace('Group', 'Grupo') : roundLabel(m.round)}</span>
                  <span class="ph-time" data-time data-local-time data-utc={kickoffUTC(m.date, m.time)?.toISOString()} title={`${artTime(m.date, m.time)} Argentina`}>{artTime(m.date, m.time)}</span>
                </div>
                <div class="ph-teams">
                  <span class="ph-team t1"><span class="flag">{t1.flag}</span><span class="name">{t1.es}</span></span>
                  <span class="ph-score" data-score>{r ? `${r.a} – ${r.b}` : 'vs'}</span>
                  <span class="ph-team t2"><span class="name">{t2.es}</span><span class="flag">{t2.flag}</span></span>
                </div>
                <div class="ph-card-foot"><span>📍 {m.ground}</span><span class="ph-detail" data-detail>{r?.detail || ''}</span></div>
              </div>
            ))}
          </div>
        )}
      </section>

      {argNext && (
        <aside class="ph-arg">
          <span class="ph-arg-flag">🇦🇷</span>
          <p>{argNextHoy ? <><strong>¡Argentina juega hoy!</strong> Mirá el horario arriba.</> : <><strong>Próximo partido de Argentina:</strong> {teamLabel(argNext.team1).es} vs {teamLabel(argNext.team2).es}.</>}</p>
          <a href="/cuando-juega-argentina-mundial-2026">¿Cuándo juega Argentina? →</a>
        </aside>
      )}

      {upcoming.length > 0 && (
        <section class="ph-next" aria-labelledby="ph-next-h">
          <h2 id="ph-next-h">⏭️ Próximos partidos</h2>
          {upcoming.map((d) => (
            <div class="ph-day">
              <h3 class="ph-day-h">{d.label}</h3>
              <ul class="ph-rows">
                {d.matches.map(renderCard).map(({ m, t1, t2, r }) => (
                  <li class={`ph-row${r ? ' played' : ''}`} data-match data-num={m.num} data-team1={m.team1} data-team2={m.team2}>
                    <span class="ph-row-time" data-time data-local-time data-utc={kickoffUTC(m.date, m.time)?.toISOString()} title={`${artTime(m.date, m.time)} Argentina`}>{artTime(m.date, m.time)}</span>
                    <span class="ph-row-stage">{m.group ? m.group.replace('Group', 'Gr.') : roundLabel(m.round)}</span>
                    <span class="ph-row-team"><span class="name">{t1.es}</span><span class="flag">{t1.flag}</span></span>
                    <span class="ph-row-score" data-score>{r ? `${r.a} – ${r.b}` : 'vs'}</span>
                    <span class="ph-row-team"><span class="flag">{t2.flag}</span><span class="name">{t2.es}</span></span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )}

      <section class="ph-explain">
        <h2>Cómo funcionan los partidos del Mundial 2026</h2>
        <p>El Mundial 2026 es el primero con <strong>48 selecciones</strong> y <strong>104 partidos</strong>, repartidos entre <strong>Estados Unidos, México y Canadá</strong> del <strong>11 de junio al 19 de julio de 2026</strong>. Como las sedes están en tres países con husos horarios distintos, cada encuentro puede arrancar en un horario diferente: por eso en esta página <strong>convertimos todo a hora de Argentina (UTC-3)</strong>, para que sepas al toque a qué hora se juega sin hacer cuentas.</p>

        <h3>Fase de grupos: varios partidos por día</h3>
        <p>En la primera etapa se juega casi todos los días y suele haber <strong>varios partidos en la misma jornada</strong>, sobre todo los fines de semana. Cada selección disputa tres encuentros —los vas a ver marcados como <strong>Fecha 1, Fecha 2 y Fecha 3</strong>— y en la última fecha de cada grupo los dos partidos se juegan en simultáneo para que ninguno saque ventaja mirando cómo va el otro. Si un partido de grupos termina empatado, el empate queda así y cada equipo suma un punto.</p>

        <h3>Eliminatorias: menos partidos y definición por penales</h3>
        <p>Cuando termina la fase de grupos empieza la eliminación directa: <strong>dieciseisavos, octavos de final, cuartos de final, semifinales</strong>, el partido por el <strong>tercer puesto</strong> y la <strong>final</strong>. A partir de acá hay menos partidos por día y ya no se puede empatar: si el marcador está igualado a los 90 minutos se juega el <strong>alargue</strong> (prórroga) y, si sigue la paridad, se define por <strong>penales</strong>. En esos casos, junto al resultado te aclaramos si se ganó "tras alargue" o por "penales".</p>

        <h3>Resultados en vivo, sin recargar</h3>
        <p>El "hoy" de esta página se recalcula <strong>en cada visita</strong>, así que la lista de arriba nunca queda vieja: siempre ves los partidos del día real en hora argentina. Mientras se juega, los <strong>marcadores se actualizan solos cada minuto</strong>: dejá la pestaña abierta y el resultado se completa sin que tengas que refrescar. Si hoy no hay partidos, te mostramos automáticamente los de los próximos días para que no te pierdas ninguno.</p>
      </section>

      <section class="ph-links">
        <h2>Seguí el Mundial</h2>
        <ul>
        <li><a href="/campeon-mundial-2026">🏆 ¿Quién ganó? Campeón y palmarés</a></li>
          {findePost && (
            <li><a href={`/blog/${findePost.slug}`}>🗓️ Los partidos de este fin de semana, en hora argentina</a></li>
          )}
          <li><a href="/fixture-mundial-2026">📅 Fixture completo ({total} partidos)</a></li>
          <li><a href="/donde-ver-mundial-2026">📺 Dónde verlo: canales por país</a></li>
          <li><a href="/posiciones-mundial-2026">📊 Posiciones de los grupos</a></li>
          <li><a href="/goleadores-mundial-2026">⚽ Tabla de goleadores</a></li>
          <li><a href="/cuando-juega-argentina-mundial-2026">🇦🇷 Cuándo juega Argentina</a></li>
          <li><a href="/calculadora-mundial-2026-quiniela-pool-probabilidad">🎯 Armá el prode con amigos</a></li>
          <li><a href="/mundial-2026">🏆 Todas las calculadoras del Mundial</a></li>
        </ul>
      </section>

      <section class="ph-faq">
        <h2>Preguntas frecuentes</h2>
        {faqItems.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </section>

      <p class="ph-source">Datos: <a href="https://github.com/openfootball/worldcup.json" rel="noopener" target="_blank">openfootball</a> (dominio público) y FIFA. Horarios en hora de Argentina. Se actualiza solo durante el torneo.</p>
    </article>
  </main>
  <Footer slot="footer" />
</Layout>

<script type="application/json" id="fx-live-config" set:html={JSON.stringify(liveConfig)}></script>
<script>
  (function () {
    const cfgEl = document.getElementById('fx-live-config');
    if (!cfgEl) return;
    let cfg: any;
    try { cfg = JSON.parse(cfgEl.textContent || '{}'); } catch { return; }
    const TEAMS = cfg.teams || {};
    function localizeTimes() {
      const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'tu zona';
      const formatter = new Intl.DateTimeFormat(undefined, {
        hour: '2-digit', minute: '2-digit', timeZoneName: 'short',
      });
      document.querySelectorAll<HTMLElement>('[data-local-time][data-utc]').forEach((el) => {
        const date = new Date(el.dataset.utc || '');
        if (!Number.isNaN(date.getTime())) el.textContent = formatter.format(date);
      });
      const note = document.querySelector('[data-zone-note]');
      if (note) note.textContent = `🕐 Horarios adaptados a ${zone}. La jornada “de hoy” se calcula en hora argentina (UTC-3).`;
    }
    localizeTimes();
    function label(name: string | null): { es: string; flag: string } {
      if (!name) return { es: 'A definir', flag: '⚽' };
      if (TEAMS[name]) return TEAMS[name];
      let m = name.match(/^([123])([A-L])$/);
      if (m) return { es: m[1] + '.º Grupo ' + m[2], flag: '🏳️' };
      m = name.match(/^W(\d+)$/); if (m) return { es: 'Ganador M' + m[1], flag: '🏳️' };
      m = name.match(/^L(\d+)$/); if (m) return { es: 'Perdedor M' + m[1], flag: '🏳️' };
      return { es: name, flag: '🏳️' };
    }
    function fmtResult(score: any) {
      if (!score || !score.ft) return null;
      let a = score.ft[0], b = score.ft[1], detail = '';
      if (score.et) { detail = 'tras alargue ' + score.et[0] + '-' + score.et[1]; }
      let winner = a > b ? 1 : b > a ? 2 : 0;
      if (score.p) { detail = (detail ? detail + ', ' : '') + 'penales ' + score.p[0] + '-' + score.p[1]; winner = score.p[0] > score.p[1] ? 1 : 2; }
      return { a, b, detail, winner };
    }
    function applyMatch(el: Element, m: any) {
      for (const s of [{ side: 't1', team: m.team1 }, { side: 't2', team: m.team2 }]) {
        const lab = label(s.team);
        el.querySelectorAll('.' + s.side + ' .name').forEach((n) => { n.textContent = lab.es; });
        el.querySelectorAll('.' + s.side + ' .flag').forEach((n) => { n.textContent = lab.flag; });
      }
      const r = fmtResult(m.score);
      const scoreEl = el.querySelector('[data-score]');
      const detailEl = el.querySelector('[data-detail]');
      if (r && scoreEl) {
        scoreEl.textContent = r.a + ' – ' + r.b;
        el.classList.add('played');
        if (detailEl) detailEl.textContent = r.detail;
      }
    }
    async function refresh() {
      try {
        const res = await fetch(cfg.url, { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();
        if (!data || !Array.isArray(data.matches)) return;
        const byNum = new Map<number, any>();
        data.matches.forEach((m: any, i: number) => byNum.set(m.num ?? i + 1, m));
        document.querySelectorAll('[data-match]').forEach((el) => {
          const m = byNum.get(Number((el as HTMLElement).dataset.num));
          if (m) applyMatch(el, m);
        });
        const uEl = document.querySelector('[data-live-updated]');
        if (uEl) uEl.textContent = new Intl.DateTimeFormat('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date());
      } catch { /* snapshot server queda válido */ }
    }
    refresh();
    setInterval(refresh, 60000);
  })();
</script>

<style>
  .ph-page { max-width: 820px; margin: 0 auto; padding: 1.25rem 1rem 4rem; }
  .ph-eyebrow { font-size: 0.8rem; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em; }
  .ph-header h1 { font-size: clamp(1.6rem, 4.5vw, 2.1rem); font-weight: 800; margin: 0.3rem 0 0.5rem; }
  .lede { font-size: 1.05rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 0.5rem; }
  .ph-upd { font-size: 0.8rem; color: var(--text-subtle); margin: 0 0 1rem; }
  .ph-zone { font-size: 0.8rem; color: var(--text-subtle); margin: -0.55rem 0 1rem; }
  .ph-answer { font-size: 1rem; line-height: 1.6; color: var(--text); background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.85rem 1rem; margin: 0 0 1.5rem; }
  .ph-page h2 { font-size: 1.3rem; font-weight: 700; margin: 2rem 0 1rem; }
  .ph-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.75rem; }
  .ph-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.9rem 1rem; }
  .ph-card-top { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--text-subtle); margin-bottom: 0.5rem; }
  .ph-time { font-weight: 700; color: var(--accent); }
  .ph-teams { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .ph-team { display: flex; align-items: center; gap: 0.35rem; flex: 1; }
  .ph-team.t2 { justify-content: flex-end; }
  .ph-team .flag { font-size: 1.2rem; }
  .ph-team .name { font-weight: 600; font-size: 0.95rem; }
