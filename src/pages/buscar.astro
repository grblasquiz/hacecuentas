---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProblemInterpreter from '../components/ProblemInterpreter.astro';

// /buscar es noindex: las cards las renderiza el cliente desde search-index.json
// (~80-150KB transferido vs 2.4MB cuando se prerendaban inline). Solo
// computamos counts al build para los chips iniciales.
const calcModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
const calcs = Object.values(calcModules).map((m: any) => m.default || m);
const totalCount = calcs.length;

// Las 26 categorías reales (espeja CATEGORY_LABELS de calculadoras.astro). Antes
// sólo había 12 → las otras 14 (~735 calcs) no se podían filtrar y sus cards
// mostraban el slug crudo sin acento como label.
const categoryLabels: Record<string, string> = {
  finanzas: 'Finanzas',
  negocios: 'Negocios',
  negocio: 'Negocios',
  salud: 'Salud',
  marketing: 'Marketing',
  deportes: 'Deportes',
  viajes: 'Viajes',
  vida: 'Vida cotidiana',
  mascotas: 'Mascotas',
  matematica: 'Matemática',
  construccion: 'Construcción',
  cocina: 'Cocina',
  educacion: 'Educación',
  automotor: 'Automotor',
  tecnologia: 'Tecnología',
  'medio-ambiente': 'Medio Ambiente',
  electronica: 'Electrónica',
  entretenimiento: 'Entretenimiento',
  ciencia: 'Ciencia',
  jardineria: 'Jardinería',
  familia: 'Familia',
  idiomas: 'Idiomas',
  impuestos: 'Impuestos',
  hogar: 'Hogar',
  clima: 'Clima',
  juegos: 'Juegos',
  astronomia: 'Astronomía',
};

const categoryCounts: Record<string, number> = {};
for (const c of calcs as any[]) {
  const k = c.category;
  if (!k) continue;
  categoryCounts[k] = (categoryCounts[k] || 0) + 1;
}
---

<Layout
  title="Buscar calculadoras | Hacé Cuentas"
  description="Buscá entre todas las calculadoras online gratuitas de Hacé Cuentas."
  noindex={true}
>
  <Header slot="header" />

  <nav class="breadcrumbs" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <span class="sep" aria-hidden="true">/</span>
    <span class="current">Buscar</span>
  </nav>

  <header class="page-header">
    <h1>Contame qué necesitás calcular</h1>
    <p>Describí tu situación con tus palabras. Elijo la calculadora, te pido lo que falte y saco el número.</p>
  </header>

  <ProblemInterpreter variant="page" searchHref="#buscar-nombre" autofocus={true} />

  <div class="name-search-divider" id="buscar-nombre">
    <span>o buscá por nombre</span>
  </div>

  <div class="search-wrap">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input id="search-input" type="search" placeholder="Buscar..." autocomplete="off" autofocus />
    <button id="search-clear" type="button" aria-label="Limpiar búsqueda" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <fieldset class="filters" id="filters">
    <legend class="filters-legend">Filtrar por categoría</legend>
    <button class="chip active" data-cat="all" aria-pressed="true">Todas ({totalCount})</button>
    {Object.entries(categoryLabels).map(([cat, label]) => {
      const count = categoryCounts[cat] || 0;
      return count > 0 ? <button class="chip" data-cat={cat} aria-pressed="false">{label} ({count})</button> : null;
    })}
  </fieldset>

  <div class="results-count" id="results-count" aria-live="polite"></div>

  <div class="grid" id="grid" data-loading="true">
    <div class="loading">Cargando calculadoras…</div>
  </div>

  <div class="empty" id="empty" hidden>
    <div class="empty-icon">🔍</div>
    <h3>Sin resultados</h3>
    <p>No encontramos calculadoras que coincidan con tu búsqueda.</p>
  </div>

  <Footer slot="footer" />
</Layout>

<style>
  .breadcrumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    margin-bottom: 1.25rem;
  }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }
  .breadcrumbs .sep { color: var(--border-strong); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }

  .page-header { margin-bottom: 1.5rem; }
  .page-header h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); margin-bottom: 0.5rem; }
  .page-header p { color: var(--text-muted); margin: 0; }

  /* Separador entre el intérprete y el buscador clásico por nombre. */
  .name-search-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 2rem 0 1rem;
    color: var(--text-subtle);
    font-size: 0.8125rem;
  }
  .name-search-divider::before,
  .name-search-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.125rem;
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 1rem;
    color: var(--text-subtle);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .search-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .search-wrap input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1rem;
    color: var(--text);
  }
  #search-clear {
    background: transparent;
    border: none;
    color: var(--text-subtle);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
  }
  #search-clear:hover { color: var(--text); background: var(--bg-muted); }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    /* reset de <fieldset> (lo usamos como grupo a11y de los chips) */
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .filters-legend {
    /* visually-hidden: lo anuncia el lector de pantalla, sin ocupar espacio */
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .chip {
    padding: 0.4375rem 0.875rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .chip:hover { border-color: var(--border-strong); color: var(--text); }
  .chip.active { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .show-more-btn {
    display: block;
    margin: 1.5rem auto 0;
    padding: 0.7rem 1.4rem;
    background: var(--bg-card);
    color: var(--accent);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-full, 999px);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .show-more-btn:hover { background: var(--accent-soft); }

  .results-count {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    margin-bottom: 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 0.875rem;
  }

  .card {
    display: flex;
    gap: 0.875rem;
    padding: 1.125rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .card[hidden] { display: none; }
  .card-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }
  .card-body { flex: 1; min-width: 0; }
  .card-cat {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.25rem;
  }
  .ar-badge {
    margin-left: 0.4em;
    font-size: 1em;
    vertical-align: middle;
    line-height: 1;
    text-transform: none;
  }
  .card-title { font-weight: 600; font-size: 0.9375rem; margin-bottom: 0.25rem; line-height: 1.35; }
  .card-desc { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.5; }

  .empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }
  .empty-icon { font-size: 3rem; margin-bottom: 0.5rem; opacity: 0.6; }
  .empty h3 { margin-bottom: 0.5rem; }

  .loading {
    grid-column: 1 / -1;
    text-align: center;
    padding: 2rem 1rem;
    color: var(--text-subtle);
    font-size: 0.875rem;
  }
</style>

<script define:vars={{ categoryLabels }}>
  // /buscar fetchea el \u00edndice y renderiza cards din\u00e1micamente.
  // Reduce HTML inicial de ~2.4MB \u2192 ~50KB; el JSON es ~100KB gzip.
  //
  // CR\u00cdTICO: este script va dentro de `define:vars` que NO transpila TypeScript.
  // Todo el c\u00f3digo tiene que ser JS puro \u2014 sin `type`, sin `as Type`, sin
  // generics, sin `!` non-null assertions. Bug del 28-may-2026: alguien lo
  // escribi\u00f3 en TS y el browser crasheaba silenciosamente sin lanzar nada al
  // console.error porque el parsing fallaba antes del runtime, dejando el grid
  // colgado en "Cargando calculadoras\u2026" para siempre.

  const input = document.getElementById('search-input');
  const clear = document.getElementById('search-clear');
  const grid = document.getElementById('grid');
  const empty = document.getElementById('empty');
  const count = document.getElementById('results-count');
  const filters = document.getElementById('filters');

  let activeCat = 'all';
  let entries = [];
  let ready = false;

  const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  // Tolerancia a typos: Levenshtein con early-exit por l\u00edmite (devuelve la
  // distancia exacta si <= max, o max+1 si la supera).
  function levenshtein(a, b, max) {
    const la = a.length, lb = b.length;
    if (Math.abs(la - lb) > max) return max + 1;
    if (la === 0) return lb;
    if (lb === 0) return la;
    let prev = new Array(lb + 1);
    let cur = new Array(lb + 1);
    for (let j = 0; j <= lb; j++) prev[j] = j;
    for (let i = 1; i <= la; i++) {
      cur[0] = i;
      let rowMin = cur[0];
      const ai = a.charCodeAt(i - 1);
      for (let j = 1; j <= lb; j++) {
        const cost = ai === b.charCodeAt(j - 1) ? 0 : 1;
        cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
        if (cur[j] < rowMin) rowMin = cur[j];
      }
      if (rowMin > max) return max + 1;
      const tmp = prev; prev = cur; cur = tmp;
    }
    return prev[lb];
  }
  // Umbral de edici\u00f3n segun largo del token (<=1 cortos, <=2 largos).
  const fuzzyTol = (len) => len <= 6 ? 1 : 2;
  // Mejor "cercania" de un token contra una lista de palabras: 0 = sin match.
  // Devuelve 2 si matchea con dist 1, 1 si matchea con dist 2 (mas lejos = menos).
  function fuzzyWordScore(words, token) {
    if (token.length < 4) return 0; // tokens cortos dan falsos positivos
    const tol = fuzzyTol(token.length);
    let best = 0;
    for (const w of words) {
      if (Math.abs(w.length - token.length) > tol) continue;
      const d = levenshtein(w, token, tol);
      if (d <= tol) {
        const s = d === 0 ? 3 : (tol - d + 1); // mas cerca puntua mas
        if (s > best) best = s;
        if (d === 1) break; // ya muy cerca, no hace falta seguir
      }
    }
    return best;
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function cardHtml(e) {
    const label = categoryLabels[e.c] || e.c;
    const ar = e.a === 'AR'
      ? '<span class="ar-badge" title="Espec\u00edfica para Argentina" aria-label="Espec\u00edfica para Argentina">\ud83c\udde6\ud83c\uddf7</span>'
      : '';
    return `<a href="/${e.s}" class="card">
      <div class="card-icon">${escapeHtml(e.i)}</div>
      <div class="card-body">
        <div class="card-cat">${escapeHtml(label)}${ar}</div>
        <div class="card-title">${escapeHtml(e.h)}</div>
        <div class="card-desc">${escapeHtml(e.d)}</div>
      </div>
    </a>`;
  }

  // Score de relevancia por entrada. Usa campos normalizados precomputados
  // (e._h título, e._s slug, e._d desc, e._hw/_sw palabras). Semántica AND:
  // todo token de la query tiene que matchear en algún lado o la entrada se
  // descarta. Prioridad título > slug > descripción; prefijo de palabra (para
  // "sueld" → "sueldo") puntúa más que substring suelto.
  function scoreEntry(e, qNorm, tokens) {
    let score = 0;
    if (e._h.startsWith(qNorm)) score += 45;       // título arranca con la query
    else if (e._h.includes(qNorm)) score += 28;    // frase completa en el título
    for (const t of tokens) {
      let ts = 0;
      if (e._hw.includes(t)) ts = 30;                       // palabra exacta en título
      else if (e._hw.some((w) => w.startsWith(t))) ts = 22; // prefijo en título
      else if (e._h.includes(t)) ts = 14;                   // substring en título
      else if (e._sw.some((w) => w.startsWith(t))) ts = 12; // prefijo en slug
      else if (e._s.includes(t)) ts = 8;                    // substring en slug
      else if (e._d.includes(t)) ts = 4;                    // en descripción
      else {
        // Sin match exacto: fallback fuzzy (typos) contra palabras de título/slug.
        // "agunaldo"→"aguinaldo", "interes"(sin acento ya lo cubre norm).
        const fh = fuzzyWordScore(e._hw, t);
        const fsw = fh ? 0 : fuzzyWordScore(e._sw, t);
        if (fh) ts = 6 + fh * 2;        // fuzzy en título (debajo de un substring real)
        else if (fsw) ts = 3 + fsw;     // fuzzy en slug
        else return 0;                  // token sin match ni siquiera fuzzy → fuera (AND)
      }
      score += ts;
    }
    return score;
  }

  function apply() {
    if (!ready) return;
    const raw = input.value.trim();
    const qNorm = norm(raw);
    const tokens = qNorm.split(/\s+/).filter(Boolean);
    let filtered;
    if (!tokens.length) {
      filtered = entries.filter((e) => activeCat === 'all' || e.c === activeCat);
    } else {
      filtered = entries
        .filter((e) => activeCat === 'all' || e.c === activeCat)
        .map((e) => ({ e, score: scoreEntry(e, qNorm, tokens) }))
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score || a.e.h.length - b.e.h.length)
        .map((x) => x.e);
    }
    grid.removeAttribute('data-loading');
    { const _ex = document.querySelector('.show-more-btn'); if (_ex) _ex.remove(); }
    // Cap inicial: sin query NI filtro, pintar las 2.8k cards de una sola vez es
    // un primer render pesado en mobile y una pared sin jerarquía. Mostramos las
    // primeras 100 + botón "Mostrar más". Con query o chip activo, todo el subset.
    const CAP = 100;
    const capped = (!tokens.length && activeCat === 'all') && filtered.length > CAP;
    const shown = capped ? filtered.slice(0, CAP) : filtered;
    grid.innerHTML = shown.map(cardHtml).join('');
    if (capped) {
      const more = document.createElement('button');
      more.type = 'button';
      more.className = 'show-more-btn';
      more.textContent = `Mostrar las ${filtered.length - CAP} restantes`;
      more.addEventListener('click', () => {
        grid.insertAdjacentHTML('beforeend', filtered.slice(CAP).map(cardHtml).join(''));
        more.remove();
      });
      grid.insertAdjacentElement('afterend', more);
    }
    empty.hidden = filtered.length > 0;
    count.textContent = raw || activeCat !== 'all'
      ? `${filtered.length} resultado${filtered.length === 1 ? '' : 's'}`
      : '';
    clear.hidden = !input.value;
  }

  input.addEventListener('input', apply);
  clear.addEventListener('click', () => { input.value = ''; input.focus(); apply(); });

  filters.querySelectorAll('.chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      filters.querySelectorAll('.chip').forEach((c) => { c.classList.remove('active'); c.setAttribute('aria-pressed', 'false'); });
      chip.classList.add('active');
      chip.setAttribute('aria-pressed', 'true');
      activeCat = chip.dataset.cat || 'all';
      apply();
    });
  });

  // Fetch del \u00edndice. Si falla, mostramos un mensaje en vez de dejar el grid colgado.
  fetch('/search-index.json', { cache: 'force-cache' })
    .then((r) => {
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json();
    })
    .then((data) => {
      entries = data;
      // Precomputar campos normalizados una vez (no por keystroke): título,
      // slug-como-palabras y descripción + listas de palabras para el scoring.
      for (const e of entries) {
        e._h = norm(e.h);
        e._s = norm(e.s).replace(/-/g, ' ');
        e._d = norm(e.d);
        e._hw = e._h.split(/\s+/).filter(Boolean);
        e._sw = e._s.split(/\s+/).filter(Boolean);
      }
      ready = true;
      // Aplicar query y/o categoría inicial si vinieron por URL. Las páginas de
      // categoría enlazan /buscar?cat=<slug> ("Buscar en las N calculadoras…");
      // antes el ?cat= se ignoraba y el usuario caía en la lista completa.
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q) input.value = q;
      const cat = params.get('cat');
      if (cat) {
        const chip = filters.querySelector(`.chip[data-cat="${cat.replace(/[^a-z-]/gi, '')}"]`);
        if (chip) {
          filters.querySelectorAll('.chip').forEach((c) => { c.classList.remove('active'); c.setAttribute('aria-pressed', 'false'); });
          chip.classList.add('active');
          chip.setAttribute('aria-pressed', 'true');
          activeCat = cat;
        }
      }
      apply();
    })
    .catch((err) => {
      console.error('[buscar] index fetch failed', err);
      grid.removeAttribute('data-loading');
      grid.innerHTML = '<div class="loading">No pudimos cargar las calculadoras. Recarg\u00e1 la p\u00e1gina o prob\u00e1 de nuevo en un rato.</div>';
    });
</script>
