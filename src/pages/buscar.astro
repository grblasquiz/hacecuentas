---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BuscarExperience from '../components/generated/BuscarExperience.astro';
const canonical = 'https://hacecuentas.com/buscar';
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:'Buscar calculadoras',url:canonical,applicationCategory:'FinanceApplication',operatingSystem:'Web'};
---
<Layout title="Buscar calculadoras" description="Buscá calculadoras, guías y herramientas de Hacé Cuentas." canonical={canonical} schema={schema} audience="AR" lang="es" ogType="article" articleSection="Búsqueda">
  <Header />
  <BuscarExperience />
  <section class="search-editorial" aria-labelledby="como-buscar">
    <h2 id="como-buscar">Encontrá la herramienta correcta</h2>
    <p>Escribí la decisión, el cálculo o el dato que necesitás resolver. Podés buscar por tema, país o situación cotidiana; los resultados combinan calculadoras, guías y datos vigentes para llevarte a la respuesta más específica disponible.</p>
  </section>
  <Footer />
</Layout>

<style>
  .search-editorial {
    margin: 0 auto;
    max-width: 760px;
    padding: 1.5rem 1.25rem 3rem;
  }
  .search-editorial h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: .75rem;
  }
  .search-editorial p {
    color: #4b5868;
    line-height: 1.7;
  }
</style>
