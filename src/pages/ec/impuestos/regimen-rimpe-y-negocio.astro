---
/**
 * Hub de decisión EC — "¿Qué régimen me toca y cuánto voy a pagar al año?"
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import RimpeNegocioEcuadorExperience from '../../../components/generated/RimpeNegocioEcuadorExperience.astro';
import RegimeJourney from '../../../components/RegimeJourney.astro';
import {
  hub,
  IR_TABLA,
  FRACCION_BASICA,
  TECHO_POPULAR,
  TECHO_EMPRENDEDOR,
  RIMPE_POPULAR,
  RIMPE_EMPRENDEDOR,
  PATENTE_MIN,
  PATENTE_MAX,
  PATENTE_TABLA,
  PATENTE_QUITO_FIJA,
  PATRIMONIO_PRESUNTO,
  TARIFA_ACTIVOS,
  CONSTITUCION,
} from '../../../lib/hubs/ec/regimen-rimpe-y-negocio';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="EC"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <RimpeNegocioEcuadorExperience data={hub} />
  <RegimeJourney country="Ecuador" regime="RIMPE" headline="Negocio Popular, Emprendedor o General: ubicá el salto antes de crecer." intro="La facturación anual define el primer filtro, pero la actividad y las obligaciones de IVA completan la decisión. El recorrido muestra el costo y la salida del régimen." steps={['Proyectá ventas anuales','Validá actividad y permanencia','Simulá impuesto e IVA']} links={[{href:'/ec/calculadora-rimpe-negocio-popular-ecuador',label:'Calcular Negocio Popular',note:'Impuesto anual por ingresos'},{href:'/ec/calculadora-rimpe-emprendedor-ecuador',label:'Calcular Emprendedor',note:'Tabla y pago estimado'},{href:'/ec/impuestos/impuesto-a-la-renta',label:'Comparar régimen general',note:'Base imponible y tarifa'}]} tone="violet" />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>
