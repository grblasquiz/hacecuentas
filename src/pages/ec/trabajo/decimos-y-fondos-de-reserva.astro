---
/**
 * Hub de decisión EC — "Décimos, fondos de reserva y vacaciones".
 * audience="EC" literal: HubData sólo modela 'AR' | 'global' y el mercado viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  SBU,
  FONDOS_RESERVA,
  VACACIONES_BASE,
  VACACIONES_ADICIONALES_MAX,
} from '../../../lib/hubs/ec/decimos-y-fondos-de-reserva';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="EC"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{ SBU, FONDOS_RESERVA, VACACIONES_BASE, VACACIONES_ADICIONALES_MAX }}
>
  (function () {
    const H = window.HC_HUB;
    const usd = (n) =>
      '$' + new Intl.NumberFormat('es-EC', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Math.round((n || 0) * 100) / 100);

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'd13';
      const sueldo = Math.max(0, v.sueldo || 0);
      const otros = Math.max(0, v.otros || 0);
      const meses = Math.min(12, Math.max(0, v.meses === 0 ? 0 : v.meses || 12));
      const anios = Math.max(0, Math.floor(v.anios || 0));
      const horas = Math.min(40, Math.max(0, v.horasSemana === 0 ? 0 : v.horasSemana || 40));

      const base13 = sueldo + otros;
      // Décimo tercero (art. 111): un doceavo de lo percibido en el período 1-dic a 30-nov.
      const d13 = (base13 * meses) / 12;
      const d13Mensualizado = base13 / 12;

      // Décimo cuarto (art. 113): 1 SBU, proporcional a meses y a la jornada sobre 40 h.
      const factorJornada = horas > 0 ? horas / 40 : 0;
      const d14 = ((SBU * meses) / 12) * factorJornada;
      // Mensualizado = acumulación de un mes (no depende de los meses ya trabajados).
      const d14Mensualizado = (SBU / 12) * factorJornada;

      // Fondos de reserva: 8,33% desde el mes 13 con el mismo empleador.
      const tieneFondos = anios >= 1;
      const fondosMes = tieneFondos ? sueldo * FONDOS_RESERVA : 0;
      const fondosAnio = fondosMes * 12;

      // Vacaciones (art. 69): 15 días + 1 por cada año que exceda de los 5, tope 15 adicionales.
      const diasAdicionales = anios > 5 ? Math.min(VACACIONES_ADICIONALES_MAX, anios - 5) : 0;
      const diasAnuales = VACACIONES_BASE + diasAdicionales;
      const valorDia = sueldo / 30;
      const diasProporcionales = (diasAnuales * meses) / 12;
      const vacaciones = diasProporcionales * valorDia;
      const vacacionesAnual = diasAnuales * valorDia;

      const paqueteAnual = d13 + d14 + fondosAnio + vacacionesAnual;

      const rows = [
        { k: 'Base mensual del décimo tercero', ref: 'Sueldo + horas extra + comisiones', v: base13 },
        { k: 'Décimo tercer sueldo del período', ref: 'Art. 111 · un doceavo · ' + meses + ' meses', v: d13, extra: id === 'd13' },
        { k: 'Décimo tercero si lo cobras mensualizado', ref: 'Base ÷ 12 · se suma al rol de cada mes', v: d13Mensualizado },
        {
          k: 'Décimo cuarto sueldo del período',
          ref: 'Art. 113 · 1 SBU · ' + meses + ' meses' + (factorJornada < 1 ? ' · jornada de ' + horas + ' h' : ''),
          v: d14,
          extra: id === 'd14costa' || id === 'd14sierra',
        },
        { k: 'Décimo cuarto si lo cobras mensualizado', ref: '1 SBU ÷ 12' + (factorJornada < 1 ? ' · jornada de ' + horas + ' h' : ''), v: d14Mensualizado },
        {
          k: 'Fondos de reserva mensuales',
          ref: tieneFondos ? '8,33% · desde el mes 13' : 'Aún no corresponde: primer año con el empleador',
          v: fondosMes,
          extra: id === 'fondos',
        },
        { k: 'Fondos de reserva del año', ref: 'Equivalen a un sueldo más al año', v: fondosAnio },
        {
          k: 'Días de vacaciones al año',
          ref: 'Art. 69 · 15 base' + (diasAdicionales > 0 ? ' + ' + diasAdicionales + ' por antigüedad' : ''),
          v: diasAnuales,
          format: 'unit',
          unit: 'días',
        },
        { k: 'Valor de tu día', ref: 'Remuneración ÷ 30', v: valorDia },
        {
          k: 'Vacaciones devengadas en el período',
          ref: diasProporcionales.toFixed(1).replace('.', ',') + ' días · ' + meses + ' meses',
          v: vacaciones,
          extra: id === 'vacaciones',
        },
        { k: 'Vacaciones del año completo', ref: diasAnuales + ' días pagados', v: vacacionesAnual },
        { k: 'Paquete anual de beneficios de ley', ref: 'Décimos + fondos + vacaciones', v: paqueteAnual },
      ];

      let total, sub;
      if (id === 'd13') {
        total = usd(d13);
        sub =
          'Por ' + meses + ' meses con base de ' + usd(base13) + ' · se paga hasta el 24 de diciembre · ' +
          'período del 1 de diciembre al 30 de noviembre · exento de impuesto a la renta';
      } else if (id === 'd14costa') {
        total = usd(d14);
        sub =
          'Régimen Costa e Insular · se paga hasta el 15 de marzo · período del 1 de marzo al 28 o 29 de febrero · ' +
          'un SBU completo son ' + usd(SBU);
      } else if (id === 'd14sierra') {
        total = usd(d14);
        sub =
          'Régimen Sierra y Amazonía · se paga hasta el 15 de agosto · período del 1 de agosto al 31 de julio · ' +
          'un SBU completo son ' + usd(SBU);
      } else if (id === 'fondos') {
        total = usd(fondosMes);
        sub = tieneFondos
          ? '8,33% de ' + usd(sueldo) + ' cada mes · ' + usd(fondosAnio) + ' al año · mensualizados o acumulados en el IESS'
          : 'Todavía no te corresponden: se generan desde el mes 13 con el mismo empleador. Cuando llegues serían ' +
            usd(sueldo * FONDOS_RESERVA) + ' al mes';
      } else {
        total = usd(vacaciones);
        sub =
          diasAnuales + ' días al año (15 base' + (diasAdicionales > 0 ? ' + ' + diasAdicionales + ' por antigüedad' : '') +
          ') · valor día ' + usd(valorDia) + ' · devengados ' + diasProporcionales.toFixed(1).replace('.', ',') + ' días';
      }

      const chart = [
        { label: 'Décimo tercero', value: d13, tone: 'main' },
        { label: 'Décimo cuarto (1 SBU)', value: d14, tone: 'prop' },
        { label: 'Fondos de reserva del año', value: fondosAnio, tone: 'good' },
        { label: 'Vacaciones pagadas del año', value: vacacionesAnual, tone: 'warn' },
      ].filter((s) => s.value > 0);

      return { total: total, sub: sub, rows: rows, chart: chart, decimals: 2 };
    });
  })();
</script>
