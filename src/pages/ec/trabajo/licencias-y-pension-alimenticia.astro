---
/**
 * Hub de decisión EC — "Licencias por hijos o enfermedad y pensión alimenticia".
 * audience="EC" literal: HubData sólo modela 'AR' | 'global' y el mercado viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubSeoAnswer from '../../../components/hub/HubSeoAnswer.astro';
import LicenciasPensionEcuadorExperience from '../../../components/generated/LicenciasPensionEcuadorExperience.astro';
import {
  hub,
  SBU,
  IESS_PERSONAL,
  MATERNIDAD_DIAS,
  MATERNIDAD_EXTRA_MULTIPLE,
  MATERNIDAD_PRENATAL,
  SUBSIDIO_IESS_MATERNIDAD,
  PARTE_EMPLEADOR_MATERNIDAD,
  PATERNIDAD_BASE,
  PATERNIDAD_CESAREA_MULTIPLE,
  PATERNIDAD_PREMATURO,
  PATERNIDAD_ENFERMEDAD_GRAVE,
  ENFERMEDAD_DIAS_EMPLEADOR,
  ENFERMEDAD_MAX_DIAS_IESS,
  ENFERMEDAD_CORTE_TRAMO_1,
  ENFERMEDAD_PCT_TRAMO_1,
  ENFERMEDAD_PCT_TRAMO_2,
  TABLA_ALIMENTOS,
} from '../../../lib/hubs/ec/licencias-y-pension-alimenticia';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="EC"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <LicenciasPensionEcuadorExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

