---
/**
 * Hub de decisión EC — "Licencias por hijos o enfermedad y pensión alimenticia".
 * audience="EC" literal: HubData sólo modela 'AR' | 'global' y el mercado viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LicenciasPensionEcuadorExperience from '../../../components/generated/LicenciasPensionEcuadorExperience.astro';
import {
  hub,
  SBU,
  IESS_PERSONAL,
  MATERNIDAD_DIAS,
  MATERNIDAD_EXTRA_MULTIPLE,
  MATERNIDAD_PRENATAL,
  SUBSIDIO_IESS_MATERNIDAD,
  PARTE_EMPLEADOR_MATERNIDAD,
  PATERNIDAD_BASE,
  PATERNIDAD_CESAREA_MULTIPLE,
  PATERNIDAD_PREMATURO,
  PATERNIDAD_ENFERMEDAD_GRAVE,
  ENFERMEDAD_DIAS_EMPLEADOR,
  ENFERMEDAD_MAX_DIAS_IESS,
  ENFERMEDAD_CORTE_TRAMO_1,
  ENFERMEDAD_PCT_TRAMO_1,
  ENFERMEDAD_PCT_TRAMO_2,
  TABLA_ALIMENTOS,
} from '../../../lib/hubs/ec/licencias-y-pension-alimenticia';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="EC"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <LicenciasPensionEcuadorExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    SBU,
    IESS_PERSONAL,
    MATERNIDAD_DIAS,
    MATERNIDAD_EXTRA_MULTIPLE,
    MATERNIDAD_PRENATAL,
    SUBSIDIO_IESS_MATERNIDAD,
    PARTE_EMPLEADOR_MATERNIDAD,
    PATERNIDAD_BASE,
    PATERNIDAD_CESAREA_MULTIPLE,
    PATERNIDAD_PREMATURO,
    PATERNIDAD_ENFERMEDAD_GRAVE,
    ENFERMEDAD_DIAS_EMPLEADOR,
    ENFERMEDAD_MAX_DIAS_IESS,
    ENFERMEDAD_CORTE_TRAMO_1,
    ENFERMEDAD_PCT_TRAMO_1,
    ENFERMEDAD_PCT_TRAMO_2,
    TABLA: TABLA_ALIMENTOS,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const usd = (n) =>
      '$' + new Intl.NumberFormat('es-EC', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Math.round((n || 0) * 100) / 100);

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'maternidad';
      const remu = Math.max(0, v.remuneracion || 0);
      const tipoParto = String(v.tipoParto || 'normal');
      const circunstancia = String(v.circunstancia || 'normal');
      const diasReposo = Math.max(0, v.diasReposo === 0 ? 0 : v.diasReposo || 0);
      const hijos = Math.max(1, Math.floor(v.hijos || 1));
      const edadHijo = Math.max(0, Math.floor(v.edadHijo === 0 ? 0 : v.edadHijo || 0));

      const diario = remu / 30;

      // --- Maternidad (art. 152): 84 días, +10 por nacimiento múltiple ---
      const diasMaternidad = MATERNIDAD_DIAS + (tipoParto === 'multiple' ? MATERNIDAD_EXTRA_MULTIPLE : 0);
      const pagoMaternidad = remu * (diasMaternidad / 30);
      const pagoIess = pagoMaternidad * SUBSIDIO_IESS_MATERNIDAD;
      const pagoEmpleadorMat = pagoMaternidad * PARTE_EMPLEADOR_MATERNIDAD;

      // --- Paternidad (art. 152 reformado) ---
      let diasPaternidad = PATERNIDAD_BASE;
      if (circunstancia === 'cesarea') diasPaternidad = PATERNIDAD_BASE + PATERNIDAD_CESAREA_MULTIPLE;
      else if (circunstancia === 'prematuro') diasPaternidad = PATERNIDAD_BASE + PATERNIDAD_PREMATURO;
      else if (circunstancia === 'grave') diasPaternidad = PATERNIDAD_ENFERMEDAD_GRAVE;
      const pagoPaternidad = remu * (diasPaternidad / 30);

      // --- Subsidio de enfermedad del IESS ---
      const diasEmpleador = Math.min(diasReposo, ENFERMEDAD_DIAS_EMPLEADOR);
      const pagoEmpleadorEnf = diario * diasEmpleador;
      const diasIess = Math.min(Math.max(diasReposo - ENFERMEDAD_DIAS_EMPLEADOR, 0), ENFERMEDAD_MAX_DIAS_IESS);
      const t1 = Math.min(diasIess, ENFERMEDAD_CORTE_TRAMO_1);
      const t2 = Math.max(diasIess - ENFERMEDAD_CORTE_TRAMO_1, 0);
      const subsidioT1 = diario * ENFERMEDAD_PCT_TRAMO_1 * t1;
      const subsidioT2 = diario * ENFERMEDAD_PCT_TRAMO_2 * t2;
      const subsidioEnfermedad = subsidioT1 + subsidioT2;
      const totalEnfermedad = pagoEmpleadorEnf + subsidioEnfermedad;
      const excedeTope = diasReposo - ENFERMEDAD_DIAS_EMPLEADOR > ENFERMEDAD_MAX_DIAS_IESS;

      // --- Pensión alimenticia (tabla oficial vigente) ---
      const aporteIess = remu * IESS_PERSONAL;
      const baseAlimentos = Math.max(remu - aporteIess, SBU);
      const usaMinimo = remu - aporteIess < SBU;
      const enSBU = baseAlimentos / SBU;
      let tramo = TABLA[TABLA.length - 1];
      for (const t of TABLA) {
        if (t.topeSBU === null || enSBU <= t.topeSBU) {
          tramo = t;
          break;
        }
      }
      const esMayor = edadHijo >= 3;
      const fila = hijos >= 3 ? tramo.tres : hijos === 2 ? tramo.dos : tramo.uno;
      const pct = esMayor ? fila.mayor : fila.joven;
      const pensionTotal = baseAlimentos * pct;
      const pensionPorHijo = pensionTotal / hijos;

      const rows = [
        {
          k: 'Días de licencia de maternidad',
          ref: 'Art. 152 · 12 semanas' + (tipoParto === 'multiple' ? ' + 10 por nacimiento múltiple' : ''),
          v: diasMaternidad,
          format: 'unit',
          unit: 'días',
        },
        { k: 'Total que percibes durante la maternidad', ref: '100% de la remuneración por ' + diasMaternidad + ' días', v: pagoMaternidad },
        { k: 'Lo que pone el IESS', ref: '75% del subsidio de maternidad', v: pagoIess, extra: id === 'maternidad' },
        { k: 'Lo que pone el empleador', ref: '25% restante de la remuneración', v: pagoEmpleadorMat },
        {
          k: 'Días de licencia de paternidad',
          ref: 'Art. 152 · días calendario al 100%',
          v: diasPaternidad,
          format: 'unit',
          unit: 'días',
        },
        { k: 'Lo que cobras durante la paternidad', ref: 'Lo paga íntegro el empleador', v: pagoPaternidad, extra: id === 'paternidad' },
        {
          k: 'Reposo a cargo del empleador',
          ref: diasEmpleador + ' días al 100% de la remuneración',
          v: pagoEmpleadorEnf,
        },
        {
          k: 'Subsidio del IESS por enfermedad',
          ref: t1 + ' días al 75%' + (t2 > 0 ? ' + ' + t2 + ' días al 66,66%' : ''),
          v: subsidioEnfermedad,
        },
        {
          k: 'Total que percibes durante el reposo',
          ref: excedeTope ? 'Supera el tope de ' + ENFERMEDAD_MAX_DIAS_IESS + ' días subsidiados' : diasEmpleador + diasIess + ' días cubiertos',
          v: totalEnfermedad,
          extra: id === 'enfermedad',
        },
        { k: 'Base de cálculo de la pensión alimenticia', ref: 'Ingreso − 9,45% de IESS' + (usaMinimo ? ' · mínimo 1 SBU' : ''), v: baseAlimentos },
        {
          k: 'Porcentaje de la tabla que te aplica',
          ref: 'Nivel ' + tramo.nivel + ' · ' + (esMayor ? '3 años en adelante' : '0 a 2 años') + ' · ' + hijos + (hijos === 1 ? ' hijo' : ' hijos'),
          v: pct * 100,
          format: 'unit',
          unit: '%',
          decimals: 2,
        },
        { k: 'Pensión alimenticia mínima total', ref: 'Piso legal para el conjunto de hijos', v: pensionTotal, extra: id === 'alimenticia' },
        { k: 'Pensión mínima por cada hijo', ref: 'Total ÷ ' + hijos, v: pensionPorHijo },
      ];

      let total, sub, chart;
      if (id === 'paternidad') {
        total = usd(pagoPaternidad);
        sub =
          diasPaternidad + ' días calendario remunerados al 100% · ' +
          (circunstancia === 'grave'
            ? 'régimen especial por enfermedad grave o discapacidad severa del hijo'
            : circunstancia === 'prematuro'
              ? '15 días base + 8 por prematuro o cuidados especiales'
              : circunstancia === 'cesarea'
                ? '15 días base + 5 por cesárea o parto múltiple'
                : '15 días base por parto normal') +
          ' · lo paga el empleador, sin subsidio del IESS';
        chart = [{ label: 'Licencia de paternidad', value: pagoPaternidad, tone: 'main' }];
      } else if (id === 'enfermedad') {
        total = usd(totalEnfermedad);
        sub =
          'De ' + diasReposo + ' días de reposo, el empleador paga ' + diasEmpleador + ' al 100% (' + usd(pagoEmpleadorEnf) +
          ') y el IESS subsidia ' + diasIess + ' (' + usd(subsidioEnfermedad) + ')' +
          (excedeTope ? ' · superaste el tope de ' + ENFERMEDAD_MAX_DIAS_IESS + ' días subsidiados' : '');
        chart = [
          { label: 'Empleador (primeros días, 100%)', value: pagoEmpleadorEnf, tone: 'warn' },
          { label: 'IESS al 75%', value: subsidioT1, tone: 'main' },
          { label: 'IESS al 66,66%', value: subsidioT2, tone: 'prop' },
        ].filter((s) => s.value > 0);
      } else if (id === 'alimenticia') {
        total = usd(pensionTotal);
        sub =
          'Nivel ' + tramo.nivel + ' de la tabla · ' + (pct * 100).toFixed(2).replace('.', ',') + '% de ' + usd(baseAlimentos) +
          ' · ' + usd(pensionPorHijo) + ' por cada uno de los ' + hijos + (hijos === 1 ? ' hijo' : ' hijos') +
          (usaMinimo ? ' · se aplicó la base mínima de 1 SBU' : '') + ' · es el piso legal, el juez puede fijar más';
        chart = [
          { label: 'Pensión alimenticia mínima', value: pensionTotal, tone: 'main' },
          { label: 'Resto del ingreso del alimentante', value: Math.max(0, baseAlimentos - pensionTotal), tone: 'exit' },
        ];
      } else {
        total = usd(pagoMaternidad);
        sub =
          diasMaternidad + ' días de licencia (' + (diasMaternidad / 7).toFixed(1).replace('.', ',') + ' semanas) · ' +
          'el IESS pone ' + usd(pagoIess) + ' (75%) y el empleador ' + usd(pagoEmpleadorMat) + ' (25%) · ' +
          'la licencia arranca ' + MATERNIDAD_PRENATAL + ' días antes de la fecha probable de parto';
        chart = [
          { label: 'Subsidio del IESS (75%)', value: pagoIess, tone: 'main' },
          { label: 'Pago del empleador (25%)', value: pagoEmpleadorMat, tone: 'prop' },
        ];
      }

      return { total: total, sub: sub, rows: rows, chart: chart, decimals: 2 };
    });
  })();
</script>
