---
/**
 * Hub de decisión EC — "IESS: cuánto aporto, cuándo me jubilo y cuánto voy a cobrar".
 * audience="EC" literal: HubData sólo modela 'AR' | 'global' y el mercado viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import {
  hub,
  SBU,
  IESS_PERSONAL,
  IESS_PATRONAL,
  FONDOS_RESERVA,
  TASA_VOLUNTARIO,
  MORA_TASA_ANUAL,
  JUBILACION_PATRONAL_TASA,
  JUBILACION_PATRONAL_ANIOS,
  MONTEPIO_VIUDEZ,
  MONTEPIO_ORFANDAD,
  COEFICIENTES_VEJEZ,
} from '../../../lib/hubs/ec/iess-aportes-y-jubilacion';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="EC"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    SBU,
    IESS_PERSONAL,
    IESS_PATRONAL,
    FONDOS_RESERVA,
    TASA_VOLUNTARIO,
    MORA_TASA_ANUAL,
    JUBILACION_PATRONAL_TASA,
    JUBILACION_PATRONAL_ANIOS,
    MONTEPIO_VIUDEZ,
    MONTEPIO_ORFANDAD,
    COEFICIENTES_VEJEZ,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const usd = (n) =>
      '$' + new Intl.NumberFormat('es-EC', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Math.round((n || 0) * 100) / 100);

    /** Coeficiente de la pensión de vejez sobre el promedio de los 5 mejores años. */
    function coefVejez(anios) {
      let c = 0;
      for (const t of COEFICIENTES_VEJEZ) {
        if (anios >= t.desdeAnios) c = t.coef;
      }
      return anios < 10 ? 0 : c;
    }

    H.onCompute(function (v, caso) {
      const id = (caso && caso.id) || 'dependencia';
      const ingreso = Math.max(0, v.ingreso || 0);
      const anios = Math.max(0, Math.floor(v.anios === 0 ? 0 : v.anios || 0));
      const edad = Math.max(0, Math.floor(v.edad || 0));
      const promedio = Math.max(0, v.promedio || 0);
      const coefEdad = Math.max(1, v.coefEdad || 100);
      const hijos = Math.max(0, Math.floor(v.hijos === 0 ? 0 : v.hijos || 0));
      const mesesMora = Math.max(0, Math.floor(v.mesesMora || 0));

      // --- Aportes ---
      const basePersonal = ingreso * IESS_PERSONAL;
      const basePatronal = ingreso * IESS_PATRONAL;
      const aporteTotal = basePersonal + basePatronal;
      const baseVoluntario = Math.max(ingreso, SBU);
      const aporteVoluntario = baseVoluntario * TASA_VOLUNTARIO;

      // Trabajo del hogar: sueldo mínimo 1 SBU + décimos prorrateados + fondos desde el mes 13.
      const sueldoHogar = Math.max(ingreso, SBU);
      const hogarPersonal = sueldoHogar * IESS_PERSONAL;
      const hogarPatronal = sueldoHogar * IESS_PATRONAL;
      const hogar13 = sueldoHogar / 12;
      const hogar14 = SBU / 12;
      const hogarFondos = anios >= 1 ? sueldoHogar * FONDOS_RESERVA : 0;
      const costoHogar = sueldoHogar + hogarPatronal + hogar13 + hogar14 + hogarFondos;
      const netoHogar = sueldoHogar - hogarPersonal;

      // Mora patronal: interés simple sobre el capital de aportes impagos.
      const capitalMora = aporteTotal * Math.max(1, mesesMora || 1);
      const interesMora = mesesMora > 0 ? capitalMora * (MORA_TASA_ANUAL / 100 / 12) * mesesMora : 0;

      // --- Pensiones ---
      const coef = coefVejez(anios);
      let pensionVejez = promedio * coef;
      const piso = anios >= 40 ? SBU : anios >= 30 ? SBU * 0.75 : SBU * 0.5;
      if (anios >= 10 && pensionVejez < piso) pensionVejez = piso;
      if (anios < 10) pensionVejez = 0;
      const reqEdad = anios >= 30 ? 60 : anios >= 15 ? 65 : 70;
      const cumpleEdad = edad >= reqEdad;

      // Jubilación patronal (art. 216): 5% de la remuneración anual promedio por año de servicio.
      const fondoPatronal = promedio * 12 * JUBILACION_PATRONAL_TASA * anios;
      const pensionPatronal = fondoPatronal / coefEdad;

      // Montepío sobre la pensión estimada del causante.
      const pensionCausante = pensionVejez > 0 ? pensionVejez : promedio * 0.5;
      let viudez = pensionCausante * MONTEPIO_VIUDEZ;
      let orfandadCada = pensionCausante * MONTEPIO_ORFANDAD;
      let grupo = viudez + orfandadCada * hijos;
      let topeado = false;
      if (grupo > pensionCausante && grupo > 0) {
        const factor = pensionCausante / grupo;
        viudez *= factor;
        orfandadCada *= factor;
        grupo = pensionCausante;
        topeado = true;
      }

      const rows = [
        { k: 'Aporte personal al IESS', ref: '9,45% de la materia gravada · se te descuenta', v: basePersonal, extra: id === 'dependencia' },
        { k: 'Aporte patronal al IESS', ref: '11,15% · lo paga la empresa', v: basePatronal },
        { k: 'Total que recibe el IESS cada mes', ref: '20,60% de tu remuneración', v: aporteTotal },
        {
          k: 'Aporte como afiliado voluntario',
          ref: '17,60% sobre ' + usd(baseVoluntario) + (ingreso < SBU ? ' (base mínima 1 SBU)' : ''),
          v: aporteVoluntario,
          extra: id === 'voluntario',
        },
        {
          k: 'Neto que recibe la persona del hogar',
          ref: 'Sueldo ' + usd(sueldoHogar) + ' − 9,45%',
          v: netoHogar,
        },
        {
          k: 'Costo mensual del trabajo del hogar',
          ref: 'Sueldo + patronal + décimos prorrateados' + (hogarFondos > 0 ? ' + fondos' : ''),
          v: costoHogar,
          extra: id === 'domestica',
        },
        {
          k: 'Interés de mora patronal',
          ref:
            mesesMora > 0
              ? String(MORA_TASA_ANUAL).replace('.', ',') + '% anual · ' + mesesMora + ' meses de atraso'
              : 'Sin atraso: la planilla vence el día 15 del mes siguiente',
          v: interesMora,
        },
        {
          k: 'Pensión de vejez estimada',
          ref:
            anios >= 10
              ? 'Coeficiente ' + (coef * 100).toFixed(1).replace('.', ',') + '% · ' + anios + ' años imponibles'
              : 'Sin derecho: hacen falta 10 años (120 aportaciones)',
          v: pensionVejez,
          extra: id === 'jubilacion',
        },
        {
          k: 'Edad que necesitas con esos años de aporte',
          ref: cumpleEdad ? 'Ya la cumples' : 'Te faltan ' + Math.max(0, reqEdad - edad) + ' años',
          v: reqEdad,
          format: 'unit',
          unit: 'años',
        },
        {
          k: 'Fondo global de jubilación patronal',
          ref: '5% × remuneración anual promedio × ' + anios + ' años · art. 216',
          v: fondoPatronal,
        },
        {
          k: 'Pensión patronal mensual estimada',
          ref: 'Fondo ÷ coeficiente de edad ' + coefEdad + ' (tabla del MDT)',
          v: pensionPatronal,
          extra: id === 'patronal',
        },
        { k: 'Pensión de viudez', ref: '60% de la pensión del causante', v: viudez, extra: id === 'montepio' },
        { k: 'Pensión de orfandad por cada hijo', ref: '20% de la pensión del causante', v: orfandadCada },
        { k: 'Total que recibe el grupo familiar', ref: topeado ? 'Topeado al 100% de la pensión del causante' : 'Viudez + orfandad', v: grupo },
      ];

      let total, sub, chart;
      if (id === 'voluntario') {
        total = usd(aporteVoluntario);
        sub =
          '17,60% sobre ' + usd(baseVoluntario) + (ingreso < SBU ? ' (se aplicó la base mínima de 1 SBU)' : '') +
          ' · ' + usd(aporteVoluntario * 12) + ' al año · sin empleador que ponga la parte patronal';
        chart = [
          { label: 'Aporte voluntario (17,60%)', value: aporteVoluntario, tone: 'exit' },
          { label: 'Te queda del ingreso declarado', value: Math.max(0, baseVoluntario - aporteVoluntario), tone: 'main' },
        ];
      } else if (id === 'domestica') {
        total = usd(costoHogar);
        sub =
          'Sueldo ' + usd(sueldoHogar) + (ingreso < SBU ? ' (ajustado al mínimo de 1 SBU)' : '') +
          ' · la trabajadora recibe ' + usd(netoHogar) + ' · al empleador le cuesta ' + usd(costoHogar) + ' al mes';
        chart = [
          { label: 'Sueldo', value: sueldoHogar, tone: 'main' },
          { label: 'Aporte patronal 11,15%', value: hogarPatronal, tone: 'warn' },
          { label: 'Décimo tercero prorrateado', value: hogar13, tone: 'prop' },
          { label: 'Décimo cuarto prorrateado', value: hogar14, tone: 'prop' },
          { label: 'Fondos de reserva', value: hogarFondos, tone: 'good' },
        ].filter((s) => s.value > 0);
      } else if (id === 'jubilacion') {
        total = usd(pensionVejez);
        sub =
          anios >= 10
            ? 'Con ' + anios + ' años de aporte y un promedio de ' + usd(promedio) + ' · coeficiente ' +
              (coef * 100).toFixed(1).replace('.', ',') + '% · ' +
              (cumpleEdad ? 'ya cumples la edad de ' + reqEdad + ' años' : 'necesitas ' + reqEdad + ' años de edad')
            : 'Con ' + anios + ' años de aporte no alcanzas el mínimo de 10 años (120 aportaciones): lo que corresponde es la devolución de aportes';
        chart = [
          { label: 'Pensión estimada', value: pensionVejez, tone: 'main' },
          { label: 'Diferencia contra tu promedio', value: Math.max(0, promedio - pensionVejez), tone: 'exit' },
        ].filter((s) => s.value > 0);
      } else if (id === 'patronal') {
        total = usd(pensionPatronal);
        sub =
          (anios >= JUBILACION_PATRONAL_ANIOS
            ? 'Con ' + anios + ' años en la misma empresa te corresponde jubilación patronal'
            : 'Todavía no: la jubilación patronal plena exige ' + JUBILACION_PATRONAL_ANIOS + ' años con el mismo empleador') +
          ' · fondo global ' + usd(fondoPatronal) + ' ÷ coeficiente ' + coefEdad;
        chart = [
          { label: 'Fondo global de jubilación patronal', value: fondoPatronal, tone: 'main' },
        ];
      } else if (id === 'montepio') {
        total = usd(grupo);
        sub =
          'Sobre una pensión del causante de ' + usd(pensionCausante) + ' · viudez ' + usd(viudez) +
          ' · orfandad ' + usd(orfandadCada) + ' por cada uno de los ' + hijos + ' hijos' +
          (topeado ? ' · reducido proporcionalmente por el tope del 100%' : '');
        chart = [
          { label: 'Viudez (60%)', value: viudez, tone: 'main' },
          { label: 'Orfandad (' + hijos + ' hijos)', value: orfandadCada * hijos, tone: 'prop' },
        ].filter((s) => s.value > 0);
      } else {
        total = usd(basePersonal);
        sub =
          'Sobre ' + usd(ingreso) + ' de materia gravada: te descuentan ' + usd(basePersonal) + ' (9,45%) y la empresa aporta ' +
          usd(basePatronal) + ' (11,15%) · el IESS recibe ' + usd(aporteTotal) + ' al mes' +
          (mesesMora > 0 ? ' · con ' + mesesMora + ' meses de mora el interés suma ' + usd(interesMora) : '');
        chart = [
          { label: 'Aporte personal 9,45%', value: basePersonal, tone: 'exit' },
          { label: 'Aporte patronal 11,15%', value: basePatronal, tone: 'warn' },
        ];
      }

      return { total: total, sub: sub, rows: rows, chart: chart, decimals: 2 };
    });
  })();
</script>
