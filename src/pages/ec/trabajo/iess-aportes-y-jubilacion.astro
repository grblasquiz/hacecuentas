---
/**
 * Hub de decisión EC — "IESS: cuánto aporto, cuándo me jubilo y cuánto voy a cobrar".
 * audience="EC" literal: HubData sólo modela 'AR' | 'global' y el mercado viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import IessAportesJubilacionEcuadorExperience from '../../../components/generated/IessAportesJubilacionEcuadorExperience.astro';
import {
  hub,
  SBU,
  IESS_PERSONAL,
  IESS_PATRONAL,
  FONDOS_RESERVA,
  TASA_VOLUNTARIO,
  MORA_TASA_ANUAL,
  JUBILACION_PATRONAL_TASA,
  JUBILACION_PATRONAL_ANIOS,
  MONTEPIO_VIUDEZ,
  MONTEPIO_ORFANDAD,
  COEFICIENTES_VEJEZ,
} from '../../../lib/hubs/ec/iess-aportes-y-jubilacion';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="EC"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <IessAportesJubilacionEcuadorExperience data={hub} />
  <Footer />
</Layout>

