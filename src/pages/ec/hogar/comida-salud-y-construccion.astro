---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DecisionHub from '../../../components/hub/DecisionHub.astro';
import { hub } from '../../../lib/hubs/ec/comida-salud-y-construccion';
const canonical = `https://hacecuentas.com/${hub.slug}`;
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:hub.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} audience="EC" lang="es" ogType="article" articleSection={hub.silo}>
  <Header /><DecisionHub data={hub} /><Footer />
</Layout>
<script>
  import { formulaMap } from '../../../lib/hub-formulas-generated/ec-comida-salud-y-construccion';
  import { adaptGeneratedHubResult } from '../../../lib/generated-hub-adapter';
  const configs = {"c1":{"formulaId":"inta-calorias-diarias-chile","fields":["pesoKg","alturaCm","edad","sexo","actividad"],"outputs":[{"id":"caloriasMantenimiento","label":"Calorías de mantenimiento","primary":true},{"id":"metabolismoBasal","label":"Metabolismo basal"},{"id":"rangoOrientativo","label":"Rango orientativo"},{"id":"detalle","label":"Detalle"}],"title":"Calculadora de calorías diarias — Ecuador"},"c2":{"formulaId":"costo-construccion-m2-ecuador","fields":["metros","calidad"],"outputs":[{"id":"costoTotal","label":"Costo total estimado de la obra","primary":true},{"id":"costoPorM2","label":"Costo por m²"},{"id":"desglose","label":"Materiales vs mano de obra"},{"id":"detalle","label":"Detalle del cálculo"}],"title":"Calculadora de Costo de Construcción por m² 2026"},"c3":{"formulaId":"conversion-medidas-cocina-tazas-gramos","fields":["ingredient","quantity","from_unit","to_unit"],"outputs":[{"id":"result","label":"Equivalencia","primary":true,"format":"decimal","suffix":""},{"id":"result_label","label":"Resultado completo","format":"text"},{"id":"grams_per_cup","label":"Gramos por taza (referencia)","format":"text"},{"id":"reference_table","label":"Tabla de referencia del ingrediente","format":"text"}],"title":"Convertir tazas a gramos (y viceversa) por ingrediente — Ecuador"}};
  function register() {
    const H = (window as any).HC_HUB;
    if (!H) return;
    H.onCompute((all:any, selected:any) => adaptGeneratedHubResult(all, selected, configs as any, formulaMap, { locale: 'es', format: 'unit' }));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', register, { once: true });
  else register();
</script>
