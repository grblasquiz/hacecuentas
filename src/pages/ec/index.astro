---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EcuadorHomeExperience from '../../components/generated/EcuadorHomeExperience.astro';
import RecoveredHubIntro from '../../components/RecoveredHubIntro.astro';
import { HOME_HREFLANG } from '../../lib/hreflang';
const canonical='https://hacecuentas.com/ec';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Hacé Cuentas Ecuador",url:canonical,operatingSystem:'Web'};
---
<Layout title="Calculadoras de Ecuador: sueldo, impuestos y trámites | Hacé Cuentas" description="Calculá sueldo, décimos, fondos de reserva, impuestos, créditos, auto y trámites en Ecuador con datos y fuentes locales." canonical={canonical} schema={schema} lang="es" hreflang={HOME_HREFLANG}>
  <Header />
  <EcuadorHomeExperience />
  <RecoveredHubIntro headingLevel="h2" eyebrow="Ecuador 2026" h1="Datos y cálculos más consultados" lede="Entrá directo a las referencias laborales, créditos y calendarios con mayor demanda en Ecuador." note="Cada página explica los supuestos y muestra sus fuentes de actualización." links={[
    {href:'/ec/calculadora-prestamo-quirografario-iess-ecuador',title:'Préstamo quirografario IESS',description:'Monto posible, cuota, plazo y tasas referenciales del BIESS.'},
    {href:'/datos-salario-basico-ecuador-2026',title:'Salario básico Ecuador 2026',description:'SBU, neto con IESS, décimos y fondos de reserva.'},
    {href:'/feriados-ecuador-2026',title:'Feriados Ecuador 2026',description:'Calendario nacional, descansos y fines de semana largos.'},
    {href:'/ec/calculadoras',title:'Todas las herramientas de Ecuador',description:'Trabajo, impuestos, créditos, auto y trámites.'}
  ]} />
  <Footer />
</Layout>
