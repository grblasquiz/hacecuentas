---
/**
 * Hub de decisión EC — "Créditos y ahorro: cuánto pagas de verdad".
 * audience="EC" literal: HubData sólo modela 'AR' | 'global' y el mercado viaja en hub.locale.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CreditosAhorroEcuadorExperience from '../../../components/generated/CreditosAhorroEcuadorExperience.astro';
import {
  hub,
  SBU,
  TASA_BIESS,
  TOPE_QUIROGRAFARIO,
  INGRESO_MAX_CREDICASA,
  TEA_MAX_CONSUMO_BCE,
  TEA_VEHICULAR_REF,
  TEA_CONSUMO_REF,
  TEA_PLAZO_FIJO_REF,
  COSEDE_COBERTURA,
  PLAZO_EXONERACION_DIAS,
  RETENCION_RENDIMIENTOS,
  TASAS_QUIROGRAFARIO,
} from '../../../lib/hubs/ec/creditos-y-ahorro';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience="EC"
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CreditosAhorroEcuadorExperience data={hub} />
  <Footer />
</Layout>

