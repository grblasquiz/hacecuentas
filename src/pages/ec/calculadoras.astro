---
export const prerender = true;
import LocaleCatalog from '../../components/LocaleCatalog.astro';
import currentTools from '../../lib/current-tools-index.json';
const localeModules = import.meta.glob<any>('../../content/calcs-ec/*.json', { eager: true });
const mainModules = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
const localeCalcs = Object.values(localeModules).map((m: any) => m.default || m).filter((c: any) => c && c.slug && c.h1 && !c.noindex);
const localeSlugs = new Set(localeCalcs.map((c: any) => c.slug));
const audienceCalcs = Object.values(mainModules).map((m: any) => m.default || m).filter((c: any) => c && c.slug && c.h1 && !c.noindex && c.audience === 'EC');
const all = [...localeCalcs, ...audienceCalcs];
const calcs = all.length
  ? all.map((c: any) => ({ h1: c.h1, slug: c.slug, icon: c.icon, category: c.category, url: localeSlugs.has(c.slug) ? `/ec/${c.slug}` : `/${c.slug}` }))
  : currentTools.filter((tool) => tool.slug.startsWith('ec/') && tool.slug !== 'ec/calculadoras')
      .map((tool) => ({ h1: tool.h1, slug: tool.slug, category: tool.category, url: `/${tool.slug}` }));
---
<LocaleCatalog calcs={calcs} prefix="ec" audience="EC" country="Ecuador" lang="es-EC" topics="salario básico (SBU), IESS, décimos, IVA, impuesto a la renta, utilidades" dataLink="/datos-salario-basico-ecuador-2026" dataLabel="📊 Salario básico, IESS y décimos Ecuador 2026"
  countryContext="Acá encontrás calculadoras adaptadas a Ecuador para ordenar sueldo, décimos, fondos de reserva, aportes al IESS, IVA, impuesto a la renta, vivienda, transporte y gastos cotidianos. La idea es separar el dato oficial de la estimación personal: ingresás tu situación y la herramienta muestra qué supuestos usa."
  countryAdvice="Antes de tomar una decisión, verificá si el cálculo corresponde al año vigente, al tipo de contrato y a tu provincia. Para obligaciones fiscales o laborales, usá también la información del SRI, el Ministerio del Trabajo y el IESS; el resultado de Hacé Cuentas es educativo y no reemplaza una liquidación oficial." />
