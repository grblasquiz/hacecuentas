---
/**
 * Silo Trámites · Ecuador — indice de hubs de decision del mercado EC.
 * El listado sale del registry, no a mano.
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiloIndex from '../../../components/hub/SiloIndex.astro';
import { hubsOfSilo } from '../../../lib/hubs/registry';

const HREF = '/ec/tramites';
const SILO = 'Trámites';
const LEDE =
  'Costos de trámites y actos legales en el Ecuador: pasaporte, multa por no sufragar, honorarios notariales y traspaso de dominio.';
const hubs = hubsOfSilo(HREF);
const CANONICAL = `https://hacecuentas.com${HREF}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${SILO} en Ecuador`,
  description: LEDE,
  url: CANONICAL,
  hasPart: hubs.map((h) => ({
    '@type': 'WebPage',
    name: h.h1,
    url: `https://hacecuentas.com/${h.slug}`,
  })),
};
---

<Layout
  title={`Trámites en Ecuador — pasaporte, multas y notaría | Hacé Cuentas`}
  description={LEDE}
  canonical={CANONICAL}
  schema={schema}
  audience="EC"
  lang="es"
>
  <Header />
  <SiloIndex silo={SILO} href={HREF} lede={LEDE} hubs={hubs} />
  <Footer />
</Layout>
