---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

// Import datasets index (generated by scripts/data-sources/generate-datasets.mjs)
let datasetsIndex: any = { datasets: [] };
try {
  const mod = await import('../../../public/datasets/index.json');
  datasetsIndex = mod.default || mod;
} catch {}

const title = 'Datasets públicos AR — Inflación, dólar, UVA, tasas BCRA';
const description =
  'Datasets descargables CSV + JSON con datos económicos argentinos: inflación mensual histórica (INDEC desde 1943), cotización del dólar oficial y blue, UVA, tasas BCRA. Licencia CC-BY 4.0 — uso libre con atribución.';

const datasetMeta: Record<string, { name: string; description: string; tags: string[] }> = {
  'inflacion-argentina-historica-mensual': {
    name: 'Inflación mensual histórica de Argentina (IPC)',
    description:
      'Variación mensual del Índice de Precios al Consumidor publicado por INDEC. Histórico desde 1943.',
    tags: ['Inflación', 'IPC', 'INDEC'],
  },
  'dolar-oficial-argentina-historico': {
    name: 'Cotización histórica del dólar oficial',
    description: 'Histórico diario del dólar oficial (BNA) compra y venta.',
    tags: ['Dólar', 'BNA', 'Cambio'],
  },
  'dolar-blue-argentina-historico': {
    name: 'Cotización histórica del dólar blue (paralelo)',
    description: 'Histórico diario del dólar blue compra y venta.',
    tags: ['Dólar blue', 'Paralelo', 'Cambio'],
  },
  'uva-argentina-historico': {
    name: 'UVA (Unidad de Valor Adquisitivo) — histórico',
    description: 'Valor diario de la UVA publicado por el BCRA. Se ajusta por inflación CER.',
    tags: ['UVA', 'BCRA', 'Hipotecario'],
  },
  'tasa-plazo-fijo-30dias-argentina-historico': {
    name: 'Tasa plazo fijo a 30 días (TNA) — histórico BCRA',
    description: 'TNA diaria de plazo fijo a 30 días en bancos privados.',
    tags: ['Plazo fijo', 'Tasa', 'BCRA'],
  },
};

// Schema DataCatalog
const datasetSchemas = datasetsIndex.datasets.map((d: any) => {
  const meta = datasetMeta[d.slug] || { name: d.slug, description: '', tags: [] };
  return {
    '@type': 'Dataset',
    '@id': `https://hacecuentas.com/datasets#${d.slug}`,
    name: meta.name,
    description: meta.description,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    creator: {
      '@type': 'Organization',
      name: 'Hacé Cuentas',
      url: 'https://hacecuentas.com',
    },
    keywords: meta.tags,
    isAccessibleForFree: true,
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: d.csv },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: d.json },
    ],
  };
});

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DataCatalog',
      name: 'Hacé Cuentas — Datasets públicos AR',
      description,
      url: 'https://hacecuentas.com/datasets',
      license: 'https://creativecommons.org/licenses/by/4.0/',
      dataset: datasetSchemas,
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="/datasets"
  audience="AR"
  schema={schema}
  domain="data"
>
  <Header />
  <main class="article-main">
    <article class="page-content datasets-page">
      <header class="article-header">
        <h1>Datasets públicos de Argentina</h1>
        <p class="lede">
          Descargá datasets económicos argentinos en CSV y JSON. Inflación INDEC desde 1943,
          cotización del dólar, UVA, tasas BCRA. <strong>Licencia CC-BY 4.0</strong>: uso libre
          con atribución a <a href="https://hacecuentas.com">hacecuentas.com</a>.
        </p>
      </header>

      <section class="datasets-grid">
        {datasetsIndex.datasets.map((d: any) => {
          const meta = datasetMeta[d.slug] || { name: d.slug, description: '', tags: [] };
          return (
            <article class="dataset-card">
              <h2>{meta.name}</h2>
              <p>{meta.description}</p>
              <div class="dataset-tags">
                {meta.tags.map((t: string) => <span class="tag">{t}</span>)}
              </div>
              <div class="dataset-downloads">
                <a href={d.csv} download class="btn-download">
                  📄 Descargar CSV
                </a>
                <a href={d.json} download class="btn-download">
                  🧩 Descargar JSON
                </a>
              </div>
            </article>
          );
        })}
      </section>

      <section class="ref-tables">
        <h2>Tablas de referencia 2026 (fiscal y laboral)</h2>
        <p>
          Además de los datasets descargables, publicamos tablas de referencia citables
          (server-rendered, con fuentes oficiales y licencia CC-BY 4.0):
        </p>
        <ul>
          <li><a href="/datos-monotributo-2026">Monotributo 2026</a> — categorías, topes y cuotas (A a K)</li>
          <li><a href="/datos-ganancias-2026">Ganancias 2026</a> — escala del impuesto y deducciones art. 30</li>
          <li><a href="/datos-topes-sipa-2026">Topes SIPA 2026</a> — base imponible máxima de aportes</li>
          <li><a href="/datos-aguinaldo-2026">Aguinaldo (SAC) 2026</a> — fechas legales, fórmula y ejemplos</li>
          <li><a href="/datos-salario-minimo-latam-2026">Salario mínimo LATAM 2026</a> — AR, BR, PE y EC con fuentes</li>
          <li><a href="/pt/dados-inss-irrf-2026">Dados INSS e IRRF 2026 (Brasil)</a> — tabelas com o redutor da reforma</li>
        </ul>
      </section>

      <section class="cite-instructions">
        <h2>Cómo citar</h2>
        <p>Si usás estos datos en un artículo, paper o app, atribución:</p>
        <pre><code>Fuente: Hacé Cuentas — https://hacecuentas.com/datasets
Licencia: CC-BY 4.0</code></pre>
        <p>
          Los datos se actualizan automáticamente cada día desde fuentes oficiales
          (INDEC, BCRA, BNA). Última actualización del catálogo:
          {' '}<time datetime={datasetsIndex.generatedAt}>{new Date(datasetsIndex.generatedAt).toLocaleDateString('es-AR')}</time>.
        </p>
      </section>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .datasets-page {
    max-width: 880px;
    margin: 0 auto;
    padding: 1rem;
  }
  .lede {
    font-size: 1.1rem;
    color: var(--text-2, #444);
  }
  .datasets-grid {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0;
  }
  .dataset-card {
    border: 1px solid var(--border, #ddd);
    border-radius: 0.6rem;
    padding: 1.25rem;
    background: var(--bg-card, #fafafa);
  }
  .dataset-card h2 {
    margin-top: 0;
    font-size: 1.2rem;
  }
  .dataset-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.75rem 0;
  }
  .tag {
    background: var(--tag-bg, #e6e9ee);
    color: var(--tag-fg, #333);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }
  .dataset-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .btn-download {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    background: var(--btn-bg, #2c5cdc);
    color: white;
    text-decoration: none;
    border-radius: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .btn-download:hover {
    background: var(--btn-hover, #1f47b3);
  }
  .ref-tables { margin-top: 2rem; }
  .ref-tables ul { margin-left: 1.25rem; }
  .ref-tables li { line-height: 1.8; }
  .ref-tables a { color: var(--accent, #2563eb); }
  .cite-instructions {
    margin-top: 2rem;
    padding: 1rem;
    background: var(--bg-soft, #f4f6f9);
    border-radius: 0.5rem;
  }
  .cite-instructions pre {
    background: var(--code-bg, #eaeef3);
    padding: 0.75rem;
    border-radius: 0.35rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }
</style>
