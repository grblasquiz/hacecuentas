</Layout>

<script>
  // ── Motor de cálculo (inline, sin eval() por la CSP) ──────────────────────
  // tokenizer → shunting-yard (RPN) → evaluación. Probado con 49 casos.
  // Convenciones: −3^2 = −9 (la potencia liga más que el menos unario); x% = x/100;
  // n! = factorial (entero ≥ 0). Va inline (no import) para igualar el patrón de
  // las demás páginas interactivas del sitio y garantizar el bundle en producción.
  type AngleMode = 'deg' | 'rad';

  const FUNCS = new Set([
    'sin', 'cos', 'tan', 'asin', 'acos', 'atan',
    'sinh', 'cosh', 'tanh', 'ln', 'log', 'log2',
    'sqrt', 'cbrt', 'abs', 'exp',
  ]);
  const CONSTS: Record<string, number> = { pi: Math.PI, e: Math.E };
  const PREC: Record<string, number> = { '+': 1, '-': 1, '*': 2, '/': 2, ncr: 3, npr: 3, neg: 3, '^': 4 };
  const RIGHT = new Set(['^', 'neg']);

  type TokType = 'num' | 'op' | 'u' | 'func' | 'lp' | 'rp' | 'post';
  interface Tok { t: TokType; v: string | number; }

  function normalize(s: string): string {
    return s
      .replace(/×/g, '*')
      .replace(/÷/g, '/')
      .replace(/[−–—]/g, '-')
      .replace(/,/g, '.')
      .replace(/√/g, 'sqrt')
      .replace(/∛/g, 'cbrt')
      .replace(/π/g, 'pi')
      .toLowerCase()
      .replace(/\s+/g, '');
  }

  function maybeImplicitMul(toks: Tok[]): void {
    const p = toks[toks.length - 1];
    if (p && (p.t === 'num' || p.t === 'rp' || p.t === 'post')) toks.push({ t: 'op', v: '*' });
  }

  function tokenize(src: string): Tok[] {
    const s = normalize(src);
    const toks: Tok[] = [];
    let i = 0;
    const isDigit = (c: string) => c >= '0' && c <= '9';
    const expectOperand = () => {
      const p = toks[toks.length - 1];
      return !p || p.t === 'op' || p.t === 'u' || p.t === 'lp' || p.t === 'func';
    };
    while (i < s.length) {
      const c = s[i];
      if (isDigit(c) || c === '.') {
        let j = i;
        while (j < s.length && (isDigit(s[j]) || s[j] === '.')) j++;
        const numStr = s.slice(i, j);
        if ((numStr.match(/\./g) || []).length > 1) throw new Error('Número inválido');
        maybeImplicitMul(toks);
        toks.push({ t: 'num', v: parseFloat(numStr) });
        i = j;
        continue;
      }
      if (/[a-z]/.test(c)) {
        // nCr / nPr son operadores binarios: detectarlos ANTES del lector de
        // nombres (si no, "5ncr2" se leería como un único símbolo "ncr2").
        if (s.startsWith('ncr', i) || s.startsWith('npr', i)) {
          toks.push({ t: 'op', v: s.slice(i, i + 3) });
          i += 3;
          continue;
        }
        let j = i;
        while (j < s.length && /[a-z0-9]/.test(s[j])) j++;
        const name = s.slice(i, j);
        if (FUNCS.has(name)) { maybeImplicitMul(toks); toks.push({ t: 'func', v: name }); }
        else if (name in CONSTS) { maybeImplicitMul(toks); toks.push({ t: 'num', v: CONSTS[name] }); }
        else throw new Error(`Símbolo desconocido: "${name}"`);
        i = j;
        continue;
      }
      if (c === '(') { maybeImplicitMul(toks); toks.push({ t: 'lp', v: c }); i++; continue; }
      if (c === ')') { toks.push({ t: 'rp', v: c }); i++; continue; }
      if (c === '!' || c === '%') { toks.push({ t: 'post', v: c }); i++; continue; }
      if (c === '+' || c === '-' || c === '*' || c === '/' || c === '^') {
        if ((c === '-' || c === '+') && expectOperand()) {
          if (c === '-') toks.push({ t: 'u', v: 'neg' });
        } else {
          toks.push({ t: 'op', v: c });
        }
        i++;
        continue;
      }
      throw new Error(`Carácter inválido: "${c}"`);
    }
    return toks;
  }

  function toRPN(toks: Tok[]): Tok[] {
    const out: Tok[] = [];
    const stack: Tok[] = [];
    for (const tk of toks) {
      if (tk.t === 'num') out.push(tk);
      else if (tk.t === 'func') stack.push(tk);
      else if (tk.t === 'post') out.push(tk);
      else if (tk.t === 'u') stack.push(tk);
      else if (tk.t === 'op') {
        const o1 = tk.v as string;
        while (stack.length) {
          const top = stack[stack.length - 1];
          if (top.t === 'lp') break;
          if (top.t === 'func') { out.push(stack.pop()!); continue; }
          if (top.t === 'op' || top.t === 'u') {
            const p1 = PREC[o1];
            const p2 = PREC[top.v as string];
            if (p2 > p1 || (p2 === p1 && !RIGHT.has(o1))) { out.push(stack.pop()!); continue; }
          }
          break;
        }
        stack.push(tk);
      } else if (tk.t === 'lp') stack.push(tk);
      else if (tk.t === 'rp') {
        while (stack.length && stack[stack.length - 1].t !== 'lp') out.push(stack.pop()!);
        if (!stack.length) throw new Error('Paréntesis desbalanceado');
        stack.pop();
        if (stack.length && stack[stack.length - 1].t === 'func') out.push(stack.pop()!);
      }
    }
    while (stack.length) {
      const top = stack.pop()!;
      if (top.t === 'lp') throw new Error('Paréntesis desbalanceado');
      out.push(top);
    }
    return out;
  }

  function factorial(n: number): number {
    if (n < 0 || !Number.isInteger(n)) throw new Error('El factorial requiere un entero ≥ 0');
    if (n > 170) return Infinity;
    let r = 1;
    for (let k = 2; k <= n; k++) r *= k;
    return r;
  }

  // Combinaciones (nCr) y permutaciones (nPr). Producto directo (no factoriales
  // sueltos) para no desbordar con n grande: nPr = n·(n−1)···(n−r+1).
  function nPr(n: number, r: number): number {
    if (!Number.isInteger(n) || !Number.isInteger(r) || n < 0 || r < 0 || r > n)
      throw new Error('nPr requiere enteros con 0 ≤ r ≤ n');
    let res = 1;
    for (let k = 0; k < r; k++) res *= n - k;
    return res;
  }
  function nCr(n: number, r: number): number {
    if (!Number.isInteger(n) || !Number.isInteger(r) || n < 0 || r < 0 || r > n)
      throw new Error('nCr requiere enteros con 0 ≤ r ≤ n');
    // Simetría: usar el r más chico reduce iteraciones y error de redondeo.
    const k = Math.min(r, n - r);
    let res = 1;
    for (let i = 0; i < k; i++) res = (res * (n - i)) / (i + 1);
    return Math.round(res);
  }

  function applyFunc(name: string, x: number, mode: AngleMode): number {
    const toRad = (d: number) => (d * Math.PI) / 180;
    const fromRad = (r: number) => (r * 180) / Math.PI;
    switch (name) {
      case 'sin': return Math.sin(mode === 'deg' ? toRad(x) : x);
      case 'cos': return Math.cos(mode === 'deg' ? toRad(x) : x);
      case 'tan': return Math.tan(mode === 'deg' ? toRad(x) : x);
      case 'asin': { const r = Math.asin(x); return mode === 'deg' ? fromRad(r) : r; }
      case 'acos': { const r = Math.acos(x); return mode === 'deg' ? fromRad(r) : r; }
      case 'atan': { const r = Math.atan(x); return mode === 'deg' ? fromRad(r) : r; }
      case 'sinh': return Math.sinh(x);
      case 'cosh': return Math.cosh(x);
      case 'tanh': return Math.tanh(x);
      case 'ln': return Math.log(x);
      case 'log': return Math.log10(x);
      case 'log2': return Math.log2(x);
      case 'sqrt': return Math.sqrt(x);
      case 'cbrt': return Math.cbrt(x);
      case 'abs': return Math.abs(x);
      case 'exp': return Math.exp(x);
      default: throw new Error(`Función desconocida: ${name}`);
    }
  }

  function evalRPN(rpn: Tok[], mode: AngleMode): number {
    const st: number[] = [];
    const pop = () => {
      const v = st.pop();
      if (v === undefined) throw new Error('Expresión incompleta');
      return v;
    };
    for (const tk of rpn) {
      if (tk.t === 'num') st.push(tk.v as number);
      else if (tk.t === 'u') st.push(-pop());
      else if (tk.t === 'func') st.push(applyFunc(tk.v as string, pop(), mode));
      else if (tk.t === 'post') { const a = pop(); st.push(tk.v === '!' ? factorial(a) : a / 100); }
      else if (tk.t === 'op') {
        const b = pop();
        const a = pop();
        switch (tk.v) {
          case '+': st.push(a + b); break;
          case '-': st.push(a - b); break;
          case '*': st.push(a * b); break;
          case '/': if (b === 0) throw new Error('No se puede dividir por cero'); st.push(a / b); break;
          case '^': st.push(Math.pow(a, b)); break;
          case 'ncr': st.push(nCr(a, b)); break;
          case 'npr': st.push(nPr(a, b)); break;
        }
      }
    }
    if (st.length !== 1) throw new Error('Expresión inválida');
    const r = st[0];
    if (Number.isNaN(r)) throw new Error('Resultado indefinido');
    if (!Number.isFinite(r)) throw new Error('Resultado fuera de rango');
    return r;
  }

  function evaluate(expr: string, mode: AngleMode = 'rad'): number {
    const src = (expr ?? '').trim();
    if (!src) throw new Error('Ingresá una expresión');
    return evalRPN(toRPN(tokenize(src)), mode);
  }

  function autoCloseParens(expr: string): string {
    let depth = 0;
    for (const c of expr) {
      if (c === '(') depth++;
      else if (c === ')') depth = Math.max(0, depth - 1);
    }
    return expr + ')'.repeat(depth);
  }
  // ── Fin del motor ─────────────────────────────────────────────────────────

  let sciKeydownHandler: ((ev: KeyboardEvent) => void) | null = null;

  // View Transitions (ClientRouter): los <script> bundleados NO se re-ejecutan al
  // navegar por SPA (ej. clic en la card del home). Inicializamos en initial load
  // + astro:page-load, idempotente vía dataset.sciReady. Patrón de Calculator.astro.
  function setupSciCalc() {
    const pad = document.getElementById('sciPad') as HTMLElement | null;
    if (!pad || pad.dataset.sciReady) return;
    pad.dataset.sciReady = '1';

    const exprEl = document.getElementById('sciExpr')!;
    const outEl = document.getElementById('sciOut')!;
    const modeInd = document.getElementById('sciModeInd')!;
    const modeBtn = document.getElementById('kMode')!;
    const invBtn = document.getElementById('kInv')!;
  const histWrap = document.getElementById('sciHistory') as HTMLElement;
  const histList = document.getElementById('sciHistoryList')!;
  const clearHistBtn = document.getElementById('sciClearHist')!;

  type Mode = 'rad' | 'deg';
  let expr = '';
  let mode: Mode = 'rad';
  let inv = false;
  let justEval = false;
  let ans = 0;
  let mem = 0;

  const MODE_KEY = 'hc-sci-mode';
  const HIST_KEY = 'hc-sci-history';
  const MEM_KEY = 'hc-sci-mem';
  const OP_STARTS = new Set(['+', '−', '×', '÷', '^', '!', '%']);

  try {
    const saved = localStorage.getItem(MODE_KEY);
    if (saved === 'deg' || saved === 'rad') mode = saved;
  } catch {}

  let history: Array<{ e: string; r: string }> = [];
  try {
    history = JSON.parse(localStorage.getItem(HIST_KEY) || '[]');
  } catch {}
  try {
    const m = parseFloat(localStorage.getItem(MEM_KEY) || '0');
    if (isFinite(m)) mem = m;
  } catch {}

  function fmt(n: number): string {
    if (!isFinite(n)) return String(n);
    // 12 cifras significativas, sin ceros sobrantes ni notación científica innecesaria
    const s = Number(n.toPrecision(12)).toString();
    return s;
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
    ));
  }

  function showExpr() {
    outEl.textContent = expr || '0';
    outEl.classList.remove('is-result', 'is-error');
  }

  function append(s: string) {
    if (justEval) {
      justEval = false;
      if (OP_STARTS.has(s[0]) || s.startsWith('^') || s.startsWith('×10')) {
        expr = fmt(ans) + s; // continuar la cuenta desde el último resultado
      } else {
        expr = s; // empezar una cuenta nueva
      }
      exprEl.textContent = '';
    } else {
      expr += s;
    }
    showExpr();
  }

  function backspace() {
    justEval = false;
    expr = expr.slice(0, -1);
    showExpr();
  }

  function clearAll() {
    expr = '';
    justEval = false;
    exprEl.textContent = '';
    outEl.textContent = '0';
    outEl.classList.remove('is-result', 'is-error');
  }

  function equals() {
    if (justEval || !expr.trim()) return;
    const toEval = autoCloseParens(expr);
    try {
      const r = evaluate(toEval, mode);
      ans = r;
      const rStr = fmt(r);
      exprEl.textContent = toEval + ' =';
      outEl.textContent = rStr;
      outEl.classList.add('is-result');
      outEl.classList.remove('is-error');
      pushHistory(toEval, rStr);
      justEval = true;
    } catch (err) {
      exprEl.textContent = expr;
      outEl.textContent = (err as Error).message || 'Error';
      outEl.classList.add('is-error');
      outEl.classList.remove('is-result');
    }
  }

  function applyMode() {
    const label = mode === 'deg' ? 'Deg' : 'Rad';
    modeBtn.textContent = label;
    modeBtn.setAttribute('aria-pressed', mode === 'deg' ? 'true' : 'false');
    modeInd.textContent = mode.toUpperCase();
  }

  function toggleMode() {
    mode = mode === 'deg' ? 'rad' : 'deg';
    try { localStorage.setItem(MODE_KEY, mode); } catch {}
    applyMode();
  }

  function applyInv() {
    invBtn.classList.toggle('active', inv);
    invBtn.setAttribute('aria-pressed', inv ? 'true' : 'false');
    pad.querySelectorAll<HTMLButtonElement>('[data-li]').forEach((b) => {
      const base = b.getAttribute('data-label-base') || '';
      const li = b.getAttribute('data-li') || '';
      const ab = b.getAttribute('data-append-base') || '';
      const ai = b.getAttribute('data-ai') || '';
      b.textContent = inv ? li : base;
      b.setAttribute('data-append', inv ? ai : ab);
    });
  }

  function renderHistory() {
    if (!history.length) { histWrap.hidden = true; return; }
    histWrap.hidden = false;
    histList.innerHTML = '';
    history.forEach((h) => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'sci-hist-item';
      item.innerHTML = `<span class="hist-expr">${escapeHtml(h.e)}</span><span class="hist-res">= ${escapeHtml(h.r)}</span>`;
      item.addEventListener('click', () => {
        expr = h.e.replace(/\s*=\s*$/, '');
        justEval = false;
        exprEl.textContent = '';
        showExpr();
        outEl.scrollIntoView({ block: 'nearest' });
      });
      histList.appendChild(item);
    });
  }

  function pushHistory(e: string, r: string) {
    history.unshift({ e, r });
    history = history.slice(0, 8);
    try { localStorage.setItem(HIST_KEY, JSON.stringify(history)); } catch {}
    renderHistory();
  }

  // ── Memoria y Ans ─────────────────────────────────────────────────────────
  // Insertar un valor en la expresión, entre paréntesis si es negativo para no
  // romper la jerarquía (ej. Ans = −3 → "(-3)").
  function insertValue(v: number) {
    append(v < 0 ? `(${fmt(v)})` : fmt(v));
  }
  // Valor "vivo" para M+: si hay expresión, la evalúa; si no, usa el último Ans.
  function currentValue(): number | null {
    if (expr.trim()) {
      try { return evaluate(autoCloseParens(expr), mode); } catch { return null; }
    }
    return ans;
  }
  function memIndicator() {
    const el = document.getElementById('sciMemInd') as HTMLElement | null;
    if (el) el.hidden = mem === 0;
  }
  function memPlus() {
    const v = currentValue();
    if (v == null || !isFinite(v)) return;
    mem += v;
    try { localStorage.setItem(MEM_KEY, String(mem)); } catch {}
    memIndicator();
  }
  function memClear() {
    mem = 0;
    try { localStorage.removeItem(MEM_KEY); } catch {}
    memIndicator();
  }

  pad.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest('button.sci-key') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    if (action === 'clear') return clearAll();
    if (action === 'back') return backspace();
    if (action === 'equals') return equals();
    if (action === 'mode') return toggleMode();
    if (action === 'inv') { inv = !inv; return applyInv(); }
    if (action === 'ans') return insertValue(ans);
    if (action === 'mr') return insertValue(mem);
    if (action === 'mplus') return memPlus();
    if (action === 'mc') return memClear();
    const ap = btn.getAttribute('data-append');
    if (ap != null) append(ap);
  });

  clearHistBtn.addEventListener('click', () => {
    history = [];
    try { localStorage.removeItem(HIST_KEY); } catch {}
    renderHistory();
  });

  const onKeydown = (ev: KeyboardEvent) => {
    const target = ev.target as HTMLElement;
    if (target && target.matches('input, textarea, [contenteditable]')) return;
    const k = ev.key;
    if (/^[0-9.]$/.test(k)) { append(k); ev.preventDefault(); return; }
    if (k === '+') { append('+'); ev.preventDefault(); return; }
    if (k === '-') { append('−'); ev.preventDefault(); return; }
    if (k === '*') { append('×'); ev.preventDefault(); return; }
    if (k === '/') { append('÷'); ev.preventDefault(); return; }
    if (k === '^') { append('^'); ev.preventDefault(); return; }
    if (k === '(' || k === ')') { append(k); ev.preventDefault(); return; }
    if (k === '%') { append('%'); ev.preventDefault(); return; }
    if (k === '!') { append('!'); ev.preventDefault(); return; }
    if (k === 'Enter' || k === '=') { equals(); ev.preventDefault(); return; }
    if (k === 'Backspace') { backspace(); ev.preventDefault(); return; }
    if (k === 'Escape') { clearAll(); ev.preventDefault(); return; }
  };
  if (sciKeydownHandler) window.removeEventListener('keydown', sciKeydownHandler);
  sciKeydownHandler = onKeydown;
  window.addEventListener('keydown', onKeydown);

  applyMode();
  applyInv();
  renderHistory();
  memIndicator();
  }

  setupSciCalc();
  document.addEventListener('astro:page-load', setupSciCalc);
</script>

