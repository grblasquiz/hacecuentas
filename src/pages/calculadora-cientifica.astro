---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { freeOfferSchema } from '../lib/offer-schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Calculadora Científica Online Gratis 2026 | Hacé Cuentas';
const description =
  'Calculadora científica online gratis para la compu y el celular: seno, coseno, tangente, logaritmos (ln, log, log₂), raíces, potencias, factorial, combinaciones (nCr) y notación científica. Modo grados/radianes, memoria y teclado. Para secundaria, CBC y facultad, sin descargar ni registrarte.';

// Teclado. Cada tecla: append (texto a insertar) o act (acción).
// li/ai = etiqueta y append cuando INV está activo (funciones inversas).
const keys = [
  { l: 'Rad', cls: 'k-ctrl k-mode', act: 'mode', id: 'kMode', title: 'Cambiar entre radianes y grados' },
  { l: 'INV', cls: 'k-ctrl k-inv', act: 'inv', id: 'kInv', title: 'Funciones inversas (sin⁻¹, eˣ…)' },
  { l: '(', cls: 'k-fn', ap: '(' },
  { l: ')', cls: 'k-fn', ap: ')' },
  { l: 'AC', cls: 'k-ctrl k-clear', act: 'clear', title: 'Borrar todo' },

  { l: 'sin', cls: 'k-fn', ap: 'sin(', li: 'sin⁻¹', ai: 'asin(' },
  { l: 'cos', cls: 'k-fn', ap: 'cos(', li: 'cos⁻¹', ai: 'acos(' },
  { l: 'tan', cls: 'k-fn', ap: 'tan(', li: 'tan⁻¹', ai: 'atan(' },
  { l: 'π', cls: 'k-fn', ap: 'π' },
  { l: '⌫', cls: 'k-ctrl', act: 'back', title: 'Borrar el último carácter' },

  { l: 'ln', cls: 'k-fn', ap: 'ln(', li: 'eˣ', ai: 'exp(' },
  { l: 'log', cls: 'k-fn', ap: 'log(', li: '10ˣ', ai: '10^(' },
  { l: '√', cls: 'k-fn', ap: '√(', li: '∛', ai: 'cbrt(' },
  { l: 'x²', cls: 'k-fn', ap: '^2' },
  { l: 'xʸ', cls: 'k-op', ap: '^' },

  { l: 'sinh', cls: 'k-fn', ap: 'sinh(', title: 'Seno hiperbólico' },
  { l: 'cosh', cls: 'k-fn', ap: 'cosh(', title: 'Coseno hiperbólico' },
  { l: 'tanh', cls: 'k-fn', ap: 'tanh(', title: 'Tangente hiperbólica' },
  { l: '|x|', cls: 'k-fn', ap: 'abs(', title: 'Valor absoluto' },
  { l: 'log₂', cls: 'k-fn', ap: 'log2(', title: 'Logaritmo en base 2' },

  { l: 'MC', cls: 'k-ctrl k-mem', act: 'mc', title: 'Borrar memoria' },
  { l: 'MR', cls: 'k-ctrl k-mem', act: 'mr', title: 'Recuperar memoria' },
  { l: 'M+', cls: 'k-ctrl k-mem', act: 'mplus', title: 'Sumar a memoria' },
  { l: 'Ans', cls: 'k-fn', act: 'ans', title: 'Último resultado' },
  { l: 'nCr', cls: 'k-fn', ap: 'nCr', li: 'nPr', ai: 'nPr', title: 'Combinaciones (INV → permutaciones nPr)' },

  { l: '7', cls: 'k-num', ap: '7' },
  { l: '8', cls: 'k-num', ap: '8' },
  { l: '9', cls: 'k-num', ap: '9' },
  { l: '÷', cls: 'k-op', ap: '÷' },
  { l: 'n!', cls: 'k-fn', ap: '!' },

  { l: '4', cls: 'k-num', ap: '4' },
  { l: '5', cls: 'k-num', ap: '5' },
  { l: '6', cls: 'k-num', ap: '6' },
  { l: '×', cls: 'k-op', ap: '×' },
  { l: '%', cls: 'k-fn', ap: '%' },

  { l: '1', cls: 'k-num', ap: '1' },
  { l: '2', cls: 'k-num', ap: '2' },
  { l: '3', cls: 'k-num', ap: '3' },
  { l: '−', cls: 'k-op', ap: '−' },
  { l: 'e', cls: 'k-fn', ap: 'e' },

  { l: '0', cls: 'k-num', ap: '0' },
  { l: '.', cls: 'k-num', ap: '.' },
  { l: 'EXP', cls: 'k-fn', ap: '×10^', title: 'Notación científica (×10ⁿ)' },
  { l: '+', cls: 'k-op', ap: '+' },
  { l: '=', cls: 'k-eq', act: 'equals', title: 'Calcular' },
];

const funcTable = [
  ['sin, cos, tan', 'Funciones trigonométricas. Respetan el modo DEG/RAD elegido.'],
  ['sin⁻¹, cos⁻¹, tan⁻¹', 'Funciones inversas (arcoseno, arcocoseno, arcotangente). Activá INV.'],
  ['sinh, cosh, tanh', 'Funciones hiperbólicas (seno, coseno y tangente hiperbólicos).'],
  ['ln', 'Logaritmo natural (base e).'],
  ['log', 'Logaritmo en base 10. Con INV se vuelve 10ˣ.'],
  ['log₂', 'Logaritmo en base 2. log₂(8) = 3.'],
  ['√', 'Raíz cuadrada. Escribí √(número).'],
  ['∛ (INV de √)', 'Raíz cúbica. Activá INV y tocá √: ∛(27) = 3. También sale como 27^(1÷3).'],
  ['x²  /  xʸ', 'Elevar al cuadrado (^2) o a cualquier potencia (^).'],
  ['|x|', 'Valor absoluto: |−5| = 5.'],
  ['n!', 'Factorial de un entero ≥ 0 (5! = 120).'],
  ['nCr, nPr', 'Combinaciones y permutaciones: 5 nCr 2 = 10; 5 nPr 2 = 20. Con INV, nCr pasa a nPr.'],
  ['%', 'Porcentaje: convierte a decimal (50% = 0,5). Para "el 15% de 200" escribí 200×15%.'],
  ['π, e', 'Constantes pi (3,14159…) y número de Euler (2,71828…).'],
  ['EXP', 'Notación científica: 3 EXP 8 = 3×10⁸.'],
  ['MC, MR, M+', 'Memoria: M+ suma el valor actual, MR lo trae, MC la borra. Aparece "M" en la pantalla.'],
  ['Ans', 'Inserta el último resultado calculado para encadenar cuentas.'],
];

const faqs = [
  {
    q: '¿Cómo se usa esta calculadora científica online?',
    a: 'Escribí la expresión tocando los botones (o usando el teclado de tu compu) y presioná <strong>=</strong> para ver el resultado. Podés encadenar funciones, paréntesis y operaciones como en una calculadora física: por ejemplo <code>2×sin(30)+√(16)</code>. Si vas a usar trigonometría, fijate antes si el modo está en <strong>Rad</strong> o <strong>Deg</strong>.',
  },
  {
    q: '¿Cuál es la diferencia entre grados (DEG) y radianes (RAD)?',
    a: 'Son dos formas de medir ángulos. Una vuelta completa son <strong>360 grados</strong> o <strong>2π radianes</strong>. En modo <strong>Deg</strong>, <code>sin(30)</code> da 0,5; en modo <strong>Rad</strong>, <code>sin(30)</code> interpreta 30 radianes y da otro valor. Tocá el botón <strong>Rad/Deg</strong> arriba a la izquierda para cambiar. La mayoría de los ejercicios escolares usan grados.',
  },
  {
    q: '¿Cómo calculo seno, coseno y tangente?',
    a: 'Tocá <code>sin</code>, <code>cos</code> o <code>tan</code>, escribí el ángulo y cerrá el paréntesis: <code>cos(60)</code>. Para las inversas (arcoseno, etc.) activá el botón <strong>INV</strong> y los botones pasan a <code>sin⁻¹</code>, <code>cos⁻¹</code>, <code>tan⁻¹</code>. Si necesitás solo trigonometría, también tenés nuestra calculadora dedicada de seno, coseno y tangente enlazada abajo.',
  },
  {
    q: '¿Cómo escribo una potencia o una raíz?',
    a: 'Para una potencia usá <code>xʸ</code> (el símbolo ^): <code>2^10</code> = 1024. Para elevar al cuadrado está el atajo <code>x²</code>. Para raíz cuadrada usá <code>√</code>: <code>√(144)</code> = 12. Una raíz cúbica la hacés como potencia fraccionaria: <code>27^(1÷3)</code> = 3.',
  },
  {
    q: '¿Qué hace el botón INV?',
    a: 'El botón <strong>INV</strong> (inverso) cambia las funciones por sus inversas: <code>sin</code> pasa a <code>sin⁻¹</code>, <code>ln</code> a <code>eˣ</code> y <code>log</code> a <code>10ˣ</code>. Es el equivalente a la tecla "Shift" o "2nd" de una calculadora física. Volvé a tocarlo para desactivarlo.',
  },
  {
    q: '¿Cómo calculo un factorial (n!)?',
    a: 'Escribí el número y tocá <code>n!</code>: por ejemplo <code>6!</code> = 720. El factorial solo funciona con enteros mayores o iguales a 0. Para 5! la cuenta es 5×4×3×2×1 = 120.',
  },
  {
    q: '¿Por qué −3² me da −9 y no 9?',
    a: 'Porque la potencia tiene <strong>prioridad sobre el signo menos</strong>: <code>−3²</code> se interpreta como <code>−(3²) = −9</code>, igual que en matemática formal, Python o Google. Si querés el cuadrado de −3, escribilo con paréntesis: <code>(−3)² = 9</code>.',
  },
  {
    q: '¿Puedo usar el teclado de la computadora?',
    a: 'Sí. Los números, <code>+ − * /</code>, paréntesis, <code>^</code>, <code>%</code> y <code>!</code> funcionan directo. <strong>Enter</strong> calcula, <strong>Backspace</strong> borra el último carácter y <strong>Escape</strong> limpia todo. En el celular se usa el teclado en pantalla de la propia calculadora.',
  },
  {
    q: '¿Los cálculos se guardan o se mandan a algún servidor?',
    a: 'No. Todo se calcula <strong>100% en tu navegador</strong>; ninguna operación viaja a internet. El historial se guarda solo en tu dispositivo (almacenamiento local del navegador) y lo podés borrar cuando quieras con el botón "Limpiar historial".',
  },
  {
    q: '¿Es gratis?',
    a: 'Sí, la calculadora científica de Hacé Cuentas es <strong>gratis</strong>, sin registro y sin límite de uso. Tampoco hace falta instalar ninguna app: funciona en el navegador de la compu o del celular.',
  },
  {
    q: '¿Hay una calculadora científica online gratis sin descargar?',
    a: 'Sí: esta misma. Es una <strong>calculadora científica online</strong> que corre dentro del navegador, así que <strong>no tenés que descargar ni instalar nada</strong> ni crear una cuenta. Abrís la página y ya podés calcular senos, logaritmos, raíces, potencias y factoriales. Funciona igual en Windows, Mac, Linux, Android y iPhone.',
  },
  {
    q: '¿Funciona en el celular?',
    a: 'Sí. La calculadora se adapta a la pantalla del <strong>celular o la tablet</strong> y trae su propio teclado en pantalla, así que no dependés del teclado del sistema. Podés guardarla como acceso directo en la pantalla de inicio desde el navegador (Chrome o Safari) para abrirla como si fuera una app.',
  },
  {
    q: '¿Sirve para la secundaria, el CBC o la facultad?',
    a: 'Sí. Cubre lo que se pide en <strong>matemática y física de secundaria</strong>, en el <strong>CBC/ingreso</strong> y en materias universitarias de ciencias e ingeniería: trigonometría (grados y radianes), logaritmos naturales y decimales, potencias, raíces, factoriales y notación científica, respetando la jerarquía de operaciones. Igual, en exámenes presenciales confirmá siempre qué modelo de calculadora permite tu cátedra.',
  },
  {
    q: '¿Funciona sin conexión a internet?',
    a: 'El cálculo se hace <strong>100% en tu dispositivo</strong>, no en un servidor. Necesitás conexión solo para <strong>abrir la página la primera vez</strong>; una vez cargada, las operaciones se resuelven sin internet. El historial también queda guardado localmente en tu navegador.',
  },
  {
    q: '¿Qué funciones tiene una calculadora científica?',
    a: 'Las que incluye esta: <strong>trigonométricas</strong> (sin, cos, tan y sus inversas) e <strong>hiperbólicas</strong> (sinh, cosh, tanh), <strong>logaritmos</strong> (ln, log base 10 y log₂, más eˣ y 10ˣ con INV), <strong>raíz cuadrada y cúbica</strong>, potencias (x², xʸ), <strong>factorial</strong> (n!), <strong>combinaciones y permutaciones</strong> (nCr, nPr), <strong>valor absoluto</strong> (|x|), <strong>porcentajes</strong>, las constantes <strong>π y e</strong>, <strong>notación científica</strong> (EXP), <strong>memoria</strong> (M+, MR, MC) y <strong>Ans</strong>, todo con jerarquía de operaciones y modo grados o radianes.',
  },
  {
    q: '¿Cómo calculo combinaciones (nCr) y permutaciones (nPr)?',
    a: 'Escribí el total, tocá <code>nCr</code> y después la cantidad que elegís: <code>5 nCr 2</code> = 10 combinaciones. Para <strong>permutaciones</strong> (cuando el orden importa) activá <strong>INV</strong> y el botón pasa a <code>nPr</code>: <code>5 nPr 2</code> = 20. Si querés el paso a paso, tenés la <a href="/calculadora-combinaciones-permutaciones-factorial">calculadora de combinaciones y permutaciones</a> dedicada.',
  },
  {
    q: '¿Tiene funciones hiperbólicas, raíz cúbica y log en base 2?',
    a: 'Sí. Están los botones <code>sinh</code>, <code>cosh</code> y <code>tanh</code> para las <strong>funciones hiperbólicas</strong>; la <strong>raíz cúbica</strong> sale activando <strong>INV</strong> y tocando <code>√</code> (se convierte en <code>∛</code>): <code>∛(27)</code> = 3; y tenés <code>log₂</code> para el <strong>logaritmo en base 2</strong> y <code>|x|</code> para el <strong>valor absoluto</strong>.',
  },
  {
    q: '¿Cómo uso la memoria (M+, MR, MC) y el botón Ans?',
    a: 'Con <strong>M+</strong> sumás el valor en pantalla a la memoria (aparece una <strong>M</strong> arriba), con <strong>MR</strong> lo traés de vuelta a la cuenta y con <strong>MC</strong> la borrás. El botón <strong>Ans</strong> inserta el <strong>último resultado</strong> para encadenar operaciones. La memoria queda guardada en tu navegador aunque cierres la página.',
  },
  {
    q: '¿Hace fracciones?',
    a: 'Esta calculadora trabaja con <strong>decimales</strong> (por ejemplo 1÷4 = 0,25). Si necesitás operar y simplificar <strong>fracciones</strong> mostradas como a/b, usá nuestra <a href="/calculadora-fracciones-suma-resta-multiplicacion-division">calculadora de fracciones</a>, que suma, resta, multiplica, divide y simplifica paso a paso.',
  },
];

const related = [
  { href: '/calculadora-derivadas', t: 'Derivadas paso a paso', i: '𝒹/𝒹𝓍' },
  { href: '/resolver-ecuaciones', t: 'Resolver ecuaciones (lineal y cuadrática)', i: '🟰' },
  { href: '/calculadora-integrales', t: 'Integrales paso a paso', i: '∫' },
  { href: '/simplificar-expresiones', t: 'Simplificar expresiones algebraicas', i: '≈' },
  { href: '/calculadora-trigonometria-seno-coseno-tangente', t: 'Trigonometría: seno, coseno y tangente', i: '📐' },
  { href: '/calculadora-logaritmos-base-10-natural-cualquier-base', t: 'Logaritmos (log, ln, log₂)', i: '📊' },
  { href: '/calculadora-raiz-cuadrada-cubica', t: 'Raíz cuadrada, cúbica y n-ésima', i: '√' },
  { href: '/calculadora-factorial-numero-n', t: 'Factorial (n!)', i: '❗' },
  { href: '/calculadora-combinaciones-permutaciones-factorial', t: 'Combinaciones y permutaciones (nCr, nPr)', i: '🎲' },
  { href: '/calculadora-fracciones-suma-resta-multiplicacion-division', t: 'Fracciones: sumar, restar, simplificar', i: '½' },
  { href: '/calculadora-ecuacion-cuadratica-raices-discriminante', t: 'Ecuación cuadrática', i: '🧮' },
  { href: '/calculadora-regla-de-tres-simple-directa-inversa', t: 'Regla de 3 simple', i: '➗' },
  { href: '/calculadora-conversion-porcentaje-fraccion-decimal', t: 'Porcentaje ↔ fracción ↔ decimal', i: '％' },
  { href: '/calculadora-area-perimetro-circulo-sector-circular', t: 'Área y perímetro del círculo', i: '⭕' },
];

const howToSteps = [
  { name: 'Escribí la expresión', text: 'Tocá los botones o usá el teclado para armar la cuenta, por ejemplo 2×sin(45)+3.' },
  { name: 'Elegí grados o radianes', text: 'Si usás funciones trigonométricas, fijate el modo Rad/Deg arriba a la izquierda.' },
  { name: 'Usá las funciones científicas', text: 'Sumá funciones (sin, cos, ln, √, x², n!), constantes (π, e) y paréntesis según necesites.' },
  { name: 'Presioná igual', text: 'Tocá el botón = (o Enter) para obtener el resultado al instante. Queda guardado en el historial.' },
];

const site = 'https://hacecuentas.com';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora científica',
  url: `${site}/calculadora-cientifica`,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  inLanguage: 'es',
  isAccessibleForFree: true,
  offers: freeOfferSchema({ priceCurrency: 'ARS' }),
  featureList: [
    'Funciones trigonométricas, inversas e hiperbólicas',
    'Logaritmo natural, base 10 y base 2',
    'Raíces (cuadrada y cúbica) y potencias',
    'Factorial, combinaciones (nCr) y permutaciones (nPr)',
    'Valor absoluto y notación científica',
    'Constantes π y e',
    'Modo grados / radianes',
    'Memoria (M+, MR, MC) y Ans',
    'Soporte de teclado',
  ],
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Matemática', item: `${site}/categoria/matematica` },
    { '@type': 'ListItem', position: 3, name: 'Calculadora científica', item: `${site}/calculadora-cientifica` },
  ],
};

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};

const schemaHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Cómo usar la calculadora científica',
  step: howToSteps.map((s, idx) => ({
    '@type': 'HowToStep',
    position: idx + 1,
    name: s.name,
    text: s.text,
  })),
};
---

<Layout title={title} description={description} schema={schema} domain="knowledge">
  <Header slot="header" />

  <article class="sci-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/categoria/matematica">Matemática</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Calculadora científica</span>
    </nav>

    <h1>Calculadora científica online</h1>
    <p class="lead">
      Calculadora científica <strong>gratis</strong> con funciones trigonométricas, logaritmos, raíces, potencias,
      factorial y constantes π y e. Cambiá entre <strong>grados y radianes</strong>, escribí con los botones o con el
      teclado, y presioná <strong>=</strong> para ver el resultado. Todo corre en tu navegador, sin instalar nada.
    </p>

    <div class="sci-answer">
      <p>
        <strong>¿Qué es una calculadora científica?</strong> Es una calculadora que, además de las cuatro
        operaciones básicas, resuelve <strong>funciones trigonométricas</strong> (sin, cos, tan) e hiperbólicas,
        <strong>logaritmos</strong> (ln, log, log₂), <strong>raíces y potencias</strong>, <strong>factoriales</strong>,
        <strong>combinaciones y permutaciones</strong> (nCr, nPr) y <strong>notación científica</strong>, respetando la
        jerarquía de operaciones. Esta es <strong>online y gratis</strong>: corre en el navegador de la compu o el
        celular, con modo grados/radianes, memoria (M+, MR) y teclado, <strong>sin instalar ni registrarte</strong>.
      </p>
    </div>

    <div class="sci-card">
      <div class="sci-display" id="sciDisplay">
        <span class="sci-mode-ind" id="sciModeInd" aria-label="Modo de ángulo">RAD</span>
        <span class="sci-mem-ind" id="sciMemInd" aria-label="Hay un valor guardado en memoria" hidden>M</span>
        <div class="sci-expr" id="sciExpr" aria-hidden="true"></div>
        <output class="sci-out" id="sciOut" aria-live="polite" aria-label="Resultado">0</output>
      </div>

      <div class="sci-pad" id="sciPad" role="group" aria-label="Teclado de la calculadora científica">
        {keys.map((k) => (
          <button
            type="button"
            class={`sci-key ${k.cls}`}
            id={k.id}
            data-action={k.act}
            data-append={k.ap}
            data-append-base={k.ap}
            data-ai={k.ai}
            data-li={k.li}
            data-label-base={k.l}
            title={k.title}
            aria-pressed={k.act === 'mode' || k.act === 'inv' ? 'false' : undefined}
          >{k.l}</button>
        ))}
      </div>

      <p class="sci-hint">
        Atajos de teclado: <kbd>Enter</kbd> calcula · <kbd>⌫</kbd> borra · <kbd>Esc</kbd> limpia ·
        <kbd>^</kbd> potencia · <kbd>(</kbd> <kbd>)</kbd> paréntesis.
      </p>

      <div class="sci-history" id="sciHistory" hidden>
        <div class="sci-history-head">
          <span>Historial</span>
          <button type="button" id="sciClearHist" class="sci-clear-hist">Limpiar historial</button>
        </div>
        <div class="sci-history-list" id="sciHistoryList"></div>
      </div>
    </div>

    <section class="sci-section">
      <h2>Cómo usar la calculadora científica</h2>
      <ol class="sci-steps">
        {howToSteps.map((s) => (
          <li><strong>{s.name}.</strong> {s.text}</li>
        ))}
      </ol>
      <p>
        Funciona como una calculadora física: respeta la <strong>jerarquía de operaciones</strong> (primero
        potencias y raíces, después multiplicación y división, por último suma y resta) y los paréntesis. Si dejás un
        paréntesis abierto, al tocar <strong>=</strong> la calculadora lo cierra sola.
      </p>
    </section>

    <section class="sci-section">
      <h2>Qué hace cada función</h2>
      <div class="sci-table-wrap">
        <table class="sci-table">
