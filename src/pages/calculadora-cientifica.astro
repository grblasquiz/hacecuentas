---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CalculadoraCientificaExperience from '../components/generated/CalculadoraCientificaExperience.astro';
const canonical='https://hacecuentas.com/calculadora-cientifica';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Calculadora científica",url:canonical,operatingSystem:'Web'};
---
<Layout title="Calculadora científica | Hacé Cuentas" description="Calculadora científica. Herramienta clara, gratuita y actualizada." canonical={canonical} schema={schema} lang="es">
  <Header />
  <CalculadoraCientificaExperience />
  <Footer />
</Layout>
