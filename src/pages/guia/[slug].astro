---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { md } from '../../lib/markdown';
import { GUIDE_TO_CATEGORIES, CATEGORY_TITLES, CATEGORY_ICONS, GUIDE_TITLES } from '../../lib/category-guide-map';
import { filterByIncremental } from '../../lib/incremental';

export async function getStaticPaths() {
  const guias = import.meta.glob<any>('../../content/guias/*.json', { eager: true });
  const calcs = import.meta.glob<any>('../../content/calcs/*.json', { eager: true });
  const calcsPe = import.meta.glob<any>('../../content/calcs-pe/*.json', { eager: true });
  const calcsEc = import.meta.glob<any>('../../content/calcs-ec/*.json', { eager: true });
  const tag = (mods: any, prefix: string) => Object.values(mods).map((m: any) => ({ ...(m.default || m), _prefix: prefix }));
  const allCalcs = [...tag(calcs, ''), ...tag(calcsPe, 'pe/'), ...tag(calcsEc, 'ec/')];
  const allGuides = Object.values(guias).map((m: any) => m.default || m);

  return filterByIncremental(allGuides, 'guias').map((g: any) => {
    // Resolver calcs referenciadas en cada sección
    const calcMap = new Map(allCalcs.map((c: any) => [c.slug, c]));
    // Otras guías (siblings) para interlinking
    const otherGuides = allGuides
      .filter((og: any) => og.slug !== g.slug)
      .map((og: any) => ({
        slug: og.slug,
        h1: og.h1,
        icon: og.icon,
        category: og.category,
        description: og.description,
      }));
    return {
      params: { slug: g.slug },
      props: { guia: g, calcMap: Array.from(calcMap.entries()), otherGuides },
    };
  });
}

const { guia, calcMap, otherGuides } = Astro.props;
const calcLookup = new Map(calcMap);
const relatedCategories = GUIDE_TO_CATEGORIES[guia.slug] || [];
const guideCalcSlugs = Array.from(new Set((guia.sections || []).flatMap((section: any) => section.calcs || []))) as string[];
const guideCalcCount = guideCalcSlugs.filter((slug: string) => calcLookup.has(slug)).length;
const firstCalcSlug = guideCalcSlugs.find((slug: string) => calcLookup.has(slug));
const firstCalc: any = firstCalcSlug ? calcLookup.get(firstCalcSlug) : null;
const readingText = [
  guia.intro,
  guia.answerSnippet,
  ...(guia.sections || []).map((section: any) => `${section.heading} ${section.content}`),
  ...(guia.faq || []).map((item: any) => `${item.q} ${item.a}`),
].join(' ').replace(/[#*`|\[\]()_-]/g, ' ');
const readingMinutes = Math.max(4, Math.ceil(readingText.split(/\s+/).filter(Boolean).length / 210));
const relatedGuides = [
  ...otherGuides.filter((og: any) => og.category && og.category === guia.category),
  ...otherGuides.filter((og: any) => !og.category || og.category !== guia.category),
].slice(0, 6);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: guia.h1,
      description: guia.description,
      url: `https://hacecuentas.com/guia/${guia.slug}`,
      mainEntityOfPage: `https://hacecuentas.com/guia/${guia.slug}`,
      inLanguage: 'es-AR',
      datePublished: guia.datePublished || '2026-04-19T00:00:00Z',
      dateModified: guia.lastReviewed ? new Date(guia.lastReviewed + 'T00:00:00Z').toISOString() : new Date().toISOString(),
      author: {
        '@type': 'Person',
        name: 'Martín Rodríguez',
        url: 'https://hacecuentas.com/autores/martin-rodriguez',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Hacé Cuentas',
        url: 'https://hacecuentas.com',
        logo: { '@type': 'ImageObject', url: 'https://hacecuentas.com/og-default.png' },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Guías', item: 'https://hacecuentas.com/guias' },
        { '@type': 'ListItem', position: 3, name: guia.h1, item: `https://hacecuentas.com/guia/${guia.slug}` },
      ],
    },
    {
      '@type': 'FAQPage',
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['.faq-list summary', '.faq-list .faq-answer'],
      },
      mainEntity: guia.faq.map((f: any) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    // Course schema: las guías son tutorial-like, este schema da rich result
    // distinto al Article (Google muestra "Course" badge + provider en SERP).
    // hasCourseInstance: la instancia "open" sin fecha fija (always-available).
    {
      '@type': 'Course',
      name: guia.h1,
      description: guia.description,
      url: `https://hacecuentas.com/guia/${guia.slug}`,
      inLanguage: 'es-AR',
      provider: {
        '@type': 'Organization',
        name: 'Hacé Cuentas',
        url: 'https://hacecuentas.com',
        sameAs: 'https://hacecuentas.com',
      },
      educationalLevel: 'Beginner',
      offers: {
        '@type': 'Offer',
        category: 'Free',
        price: '0',
        priceCurrency: 'ARS',
      },
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'Online',
        courseWorkload: 'PT15M',
        inLanguage: 'es-AR',
      },
    },
  ],
};
---
<Layout title={guia.title} description={guia.description} image={`/og/guia-${guia.slug}.png`} schema={schema} domain="knowledge">
  <Header slot="header" />

  <div class="reading-progress" aria-hidden="true"><span id="guide-progress"></span></div>

  <article class="guide-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <a href="/guias">Guías</a>
      <span aria-hidden="true">›</span>
      <span class="current">{guia.h1}</span>
    </nav>

    <header class="guide-hero">
      <div class="hero-main">
        <div class="hero-kicker">
          <span class="hero-icon" aria-hidden="true">{guia.icon}</span>
          <span>Guía práctica de Hacé Cuentas</span>
        </div>
        <h1>{guia.h1}</h1>
        <p class="hero-lead">{guia.description}</p>
        <div class="hero-actions">
          <a href="#overview" class="primary-action">Empezar la guía <span aria-hidden="true">↓</span></a>
          {firstCalc && (
            <a href={`/${firstCalc._prefix || ''}${firstCalc.slug}`} class="secondary-action">
              Ir directo a una calculadora <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>

      <aside class="guide-facts" aria-label="Datos de la guía">
        <span class="facts-label">En esta guía</span>
        <div class="facts-grid">
          <div><strong>{guia.sections.length}</strong><span>capítulos</span></div>
          <div><strong>{guideCalcCount}</strong><span>calculadoras</span></div>
          <div><strong>{readingMinutes} min</strong><span>de lectura</span></div>
          <div><strong>Gratis</strong><span>sin registro</span></div>
        </div>
        <div class="reviewed-by">
          <span class="review-check" aria-hidden="true">✓</span>
          <p>
            Revisada por <a href="/autores/martin-rodriguez">Martín Rodríguez</a><br />
            <small>{new Date((guia.lastReviewed ? guia.lastReviewed + 'T00:00:00' : new Date())).toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' })}</small>
          </p>
        </div>
      </aside>
    </header>

    {guia.answerSnippet && (
      <aside class="quick-answer" aria-label="Respuesta rápida">
        <span class="quick-answer-label">En pocas palabras</span>
        <div set:html={md(guia.answerSnippet)}></div>
      </aside>
    )}

    <details class="mobile-toc">
      <summary><span>Ver contenidos</span><span>{guia.sections.length + 3} temas</span></summary>
      <nav aria-label="Contenidos de la guía">
        <a href="#overview">Antes de empezar</a>
        {guia.sections.map((s: any, i: number) => <a href={`#sec-${i}`}>{s.heading}</a>)}
        <a href="#faq">Preguntas frecuentes</a>
        <a href="#sources">Fuentes y referencias</a>
      </nav>
    </details>

    <div class="guide-layout">
      <aside class="guide-nav" id="guide-toc">
        <div class="nav-heading">
          <span>Tu recorrido</span>
          <small>{readingMinutes} min</small>
        </div>
        <div class="nav-progress" aria-hidden="true"><span id="nav-progress"></span></div>
        <ol class="toc-list">
          <li class="toc-item" data-toc-target="overview"><a href="#overview"><span>00</span>Antes de empezar</a></li>
          {guia.sections.map((s: any, i: number) => (
            <li class="toc-item" data-toc-target={`sec-${i}`}><a href={`#sec-${i}`}><span>{String(i + 1).padStart(2, '0')}</span>{s.heading}</a></li>
          ))}
          <li class="toc-item" data-toc-target="faq"><a href="#faq"><span>?</span>Preguntas frecuentes</a></li>
          <li class="toc-item" data-toc-target="sources"><a href="#sources"><span>↗</span>Fuentes</a></li>
        </ol>
      </aside>

      <main class="guide-content">
        <section class="guide-intro guide-section" id="overview">
          <span class="section-eyebrow">Antes de empezar</span>
          <h2>Qué vas a poder resolver</h2>
          <div class="intro-content" set:html={md(guia.intro)}></div>
        </section>

        {guia.sections.map((s: any, i: number) => (
          <section class="guide-section" id={`sec-${i}`}>
            <header class="section-header">
              <span class="section-number">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <span class="section-eyebrow">Capítulo {i + 1} de {guia.sections.length}</span>
                <h2>{s.heading}</h2>
              </div>
            </header>
            <div class="section-content" set:html={md(s.content)}></div>

            {s.calcs && s.calcs.some((slug: string) => calcLookup.has(slug)) && (
              <div class="section-tools">
                <div class="tools-heading">
                  <div>
                    <span class="section-eyebrow">Pasá a la acción</span>
                    <h3>Calculadoras para este capítulo</h3>
                  </div>
                  <span>{s.calcs.filter((slug: string) => calcLookup.has(slug)).length} herramientas</span>
                </div>
                <div class="calcs-grid">
                  {s.calcs.map((slug: string) => {
                    const c: any = calcLookup.get(slug);
                    if (!c) return null;
                    return (
                      <a href={`/${c._prefix || ''}${c.slug}`} class="calc-card">
                        <span class="calc-icon" aria-hidden="true">{c.icon || '🧮'}</span>
                        <span class="calc-copy">
                          <span class="calc-label">Calculadora</span>
                          <strong class="calc-title">{c.h1}</strong>
                          <span class="calc-desc">{c.description || 'Hacé la cuenta con tus propios datos.'}</span>
                        </span>
                        <span class="calc-arrow" aria-hidden="true">→</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            )}
          </section>
        ))}

        <section class="guide-section faq-section" id="faq">
          <span class="section-eyebrow">Dudas comunes</span>
          <h2>Preguntas frecuentes</h2>
          <div class="faq-list">
            {guia.faq.map((f: any) => (
              <details>
                <summary>{f.q}</summary>
                <div class="faq-answer" set:html={md(f.a)}></div>
              </details>
            ))}
          </div>
        </section>

        <section class="guide-section sources-section" id="sources">
          <span class="section-eyebrow">Transparencia</span>
          <h2>Fuentes y referencias</h2>
          <p>Estas son las fuentes principales que usamos para revisar datos, criterios y fórmulas.</p>
          <ul class="sources">
            {guia.sources.map((s: any) => (
              <li><a href={s.url} rel="noopener nofollow" target="_blank"><span>{s.name}</span><span aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
        </section>
      </main>
    </div>

    {relatedCategories.length > 0 && (
      <section class="related-cats related-section">
        <div class="related-heading">
          <div><span class="section-eyebrow">Seguí resolviendo</span><h2>Explorá por categoría</h2></div>
        </div>
        <div class="cats-grid">
          {relatedCategories.map((cat: string) => (
            <a href={`/categoria/${cat}`} class="cat-card">
              <span class="cat-icon" aria-hidden="true">{CATEGORY_ICONS[cat] || '🧮'}</span>
              <span class="cat-name">{CATEGORY_TITLES[cat] || cat}</span>
              <span class="cat-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="other-guides related-section">
      <div class="related-heading">
        <div><span class="section-eyebrow">También te puede servir</span><h2>Otras guías útiles</h2></div>
        <a href="/guias">Ver todas <span aria-hidden="true">→</span></a>
      </div>
      <div class="guides-grid">
        {relatedGuides.map((og: any) => (
          <a href={`/guia/${og.slug}`} class="guide-card">
            <span class="guide-icon" aria-hidden="true">{og.icon}</span>
            <span class="guide-card-copy">
              <strong>{og.h1}</strong>
              <span>{og.description}</span>
            </span>
            <span class="guide-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  </article>

  <Footer slot="footer" />
</Layout>

<style is:global media="not all">
  .pillar-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1rem 1.25rem 5rem;
    color: var(--text);
  }
  .pillar-page .breadcrumbs { font-size: .875rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .pillar-page .breadcrumbs a { color: var(--accent); text-decoration: none; }
  .pillar-page .breadcrumbs .sep { margin: 0 .5rem; color: var(--text-subtle); }

  .pillar-header {
    padding: 2.5rem 2rem 2rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    margin-bottom: 2.5rem;
    text-align: center;
  }
  .pillar-icon {
    display: block;
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }
  .pillar-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1.25rem;
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.1;
    color: var(--text);
  }
  .pillar-page .lead {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 0 auto 1.5rem;
    line-height: 1.65;
    max-width: 780px;
    text-align: left;
  }
  .pillar-page .lead strong { color: var(--text); font-weight: 600; }
  .pillar-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .5rem;
    font-size: .85rem;
    color: var(--text-subtle);
  }
  .pillar-meta a { color: var(--accent); text-decoration: none; }
  .pillar-meta a:hover { text-decoration: underline; }
  .guide-answer {
    max-width: 760px;
    margin: 0 auto 2rem;
    padding: 1.1rem 1.35rem;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--text);
  }
  .guide-answer p { margin: 0; }
  .guide-answer strong { color: var(--accent-strong); }

  .toc {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    margin: 0 0 3rem;
  }
  @media (min-width: 1180px) {
    .pillar-body {
      display: flex;
      flex-direction: row-reverse;
      gap: 2.5rem;
      align-items: flex-start;
    }
    .pillar-content { flex: 1 1 0; min-width: 0; }
    .toc {
      flex: 0 0 260px;
      position: sticky;
      top: 1rem;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
      margin: 0;
      padding: 1rem 1.1rem;
      font-size: .9rem;
    }
    .toc h2 { font-size: .85rem; margin-bottom: .5rem; }
    .toc ul { grid-template-columns: 1fr !important; }
  }
  .toc-item.is-active > a {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 600;
  }
  .toc-item.is-h3 { padding-left: 1rem; }
  .toc-item.is-h3 > a { font-size: .85rem; opacity: .85; }
  .toc-fab {
    position: fixed;
    right: 1rem;
    bottom: 5rem;
    z-index: 50;
    display: none;
    align-items: center;
    gap: .4rem;
    padding: .65rem .9rem;
    background: var(--accent);
    color: #fff;
    border: 0;
    border-radius: 999px;
    box-shadow: var(--shadow-md, 0 4px 14px rgba(0,0,0,.18));
    font-size: .9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .toc-fab[hidden] { display: none !important; }
  @media (max-width: 1179px) {
    .toc-fab.is-ready { display: inline-flex; }
  }
  .toc-fab-label { line-height: 1; }
  body.toc-open .toc {
    position: fixed;
    inset: 0;
    margin: 0;
    z-index: 60;
    border-radius: 0;
    max-height: 100vh;
    overflow-y: auto;
    padding: 4rem 1.5rem 2rem;
    width: auto;
  }
  body.toc-open .toc-fab {
    z-index: 61;
    background: var(--text);
  }
  .toc h2 {
    font-size: 1rem;
    margin: 0 0 .75rem;
    color: var(--text);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: .25rem .75rem;
  }
  .toc li a {
    display: block;
    padding: .35rem .5rem;
    color: var(--accent);
    text-decoration: none;
    font-size: .92rem;
    border-radius: 4px;
  }
  .toc li a:hover { background: var(--accent-soft); }

  .pillar-section { margin: 0 0 3rem; scroll-margin-top: 80px; }
  .pillar-section h2 {
    font-size: 1.6rem;
    margin: 0 0 1.25rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -.01em;
  }
  .pillar-page .section-content {
    color: var(--text);
    line-height: 1.75;
    font-size: 1.02rem;
  }
  .pillar-page .section-content p { margin: 0 0 1em; }
  .pillar-page .section-content ul, .pillar-page .section-content ol { padding-left: 1.25rem; margin: 0 0 1em; }
  .pillar-page .section-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .pillar-page .section-content th {
    background: var(--bg-soft);
    padding: .7rem .9rem;
    text-align: left;
    font-weight: 700;
    font-size: .88rem;
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }
  .pillar-page .section-content td {
    padding: .7rem .9rem;
    border-bottom: 1px solid var(--border);
    font-size: .92rem;
  }
  .pillar-page .section-content tr:last-child td { border-bottom: 0; }

  .calcs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: .75rem;
    margin-top: 1.5rem;
  }
  .calc-card {
    display: flex;
    gap: .75rem;
    padding: .9rem 1.1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: transform .15s, box-shadow .15s, border-color .15s, background-color .15s, color .15s;
    align-items: flex-start;
  }
  .calc-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }
  .calc-icon { font-size: 1.5rem; flex-shrink: 0; }
  .calc-card > div { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .calc-title { font-weight: 600; color: var(--text); font-size: .95rem; line-height: 1.3; }
  .calc-desc { font-size: .8rem; color: var(--text-subtle); line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

  .faq-list details {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: .5rem;
    overflow: hidden;
    background: var(--bg-card);
  }
  .faq-list summary {
    padding: 1.1rem 1.25rem;
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq-list summary::after {
    content: '';
    width: 10px; height: 10px;
    border: 2px solid var(--text-muted);
    border-top: 0; border-left: 0;
    transform: rotate(45deg);
    transition: transform .2s;
  }
  .faq-list details[open] summary::after { transform: rotate(-135deg); }
  .pillar-page .faq-answer { padding: 0 1.25rem 1.2rem; color: var(--text-muted); line-height: 1.65; font-size: .95rem; }

  .sources {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: .5rem;
  }
  .sources li a {
    display: block;
    padding: .75rem 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--accent);
    text-decoration: none;
