---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import research from '../lib/hubs/citable-research.json';

const URL = 'https://hacecuentas.com/estadisticas-calculadoras-online-2026';
const rows = Object.values(research.hubs as Record<string, any>);
const decisions = rows.filter((row: any) => row.pageType === 'decision');
const collections = rows.filter((row: any) => row.pageType === 'collection');
const sum = (key: string) => decisions.reduce((total: number, row: any) => total + Number(row[key] || 0), 0);
const median = (key: string) => {
  const values = decisions.map((row: any) => Number(row[key] || 0)).sort((a: number, b: number) => a - b);
  const middle = Math.floor(values.length / 2);
  return values.length % 2 ? values[middle] : Math.round((values[middle - 1] + values[middle]) / 2);
};
const localeLabels: Record<string, string> = { es: 'Argentina / español', 'es-AR': 'Argentina', 'es-MX': 'México', 'es-CO': 'Colombia', 'es-CL': 'Chile', 'es-PE': 'Perú', 'es-EC': 'Ecuador', 'es-VE': 'Venezuela', 'es-PY': 'Paraguay', 'es-UY': 'Uruguay', 'es-DO': 'República Dominicana', 'es-ES': 'España', en: 'Inglés', pt: 'Brasil', 'pt-PT': 'Portugal' };
const locales = [...new Set(rows.map((row: any) => row.locale))].map((locale) => ({
  locale,
  label: localeLabels[String(locale)] || String(locale),
  decisions: decisions.filter((row: any) => row.locale === locale).length,
  collections: collections.filter((row: any) => row.locale === locale).length,
})).sort((a, b) => b.decisions + b.collections - (a.decisions + a.collections));
const siloMap = new Map<string, number>();
for (const row of decisions) siloMap.set(row.silo, (siloMap.get(row.silo) || 0) + 1);
const topSilos = [...siloMap].map(([silo, count]) => ({ silo, count })).sort((a, b) => b.count - a.count).slice(0, 10);
const topCollections = collections.slice().sort((a: any, b: any) => b.routes - a.routes).slice(0, 10);
const totalVariables = sum('variables');
const totalSources = sum('sources');
const totalScenarios = sum('scenarios');
const totalRoutes = sum('routes');
const faqs = [
  { q: '¿Cuántas calculadoras online analizó Hacé Cuentas en 2026?', a: `El inventario oficial reúne ${research.methodology.corpusHubs} hubs públicos: ${research.methodology.decisionHubs} hubs de decisión y ${research.methodology.collectionHubs} colecciones temáticas.` },
  { q: '¿Estas estadísticas representan a toda la industria de calculadoras online?', a: 'No. Describen el corpus editorial público de Hacé Cuentas. Sirven para estudiar cobertura, profundidad, fuentes y organización de un catálogo real; no estiman el tamaño de mercado mundial.' },
  { q: '¿Cómo se calculó el percentil de profundidad?', a: `Se aplica la fórmula ${research.methodology.depthScore}. Después se compara cada página con hubs del mismo idioma y tipo.` },
  { q: '¿Se usaron datos personales o cálculos ingresados por usuarios?', a: 'No. El análisis usa exclusivamente metadatos editoriales públicos: variables, escenarios, fuentes, FAQ y rutas. No contiene inputs, resultados ni identificadores de usuarios.' },
  { q: '¿Puedo descargar y reutilizar los datos?', a: 'Sí. El corpus se ofrece en CSV y JSON bajo licencia CC BY 4.0. Se puede reutilizar con atribución y enlace a Hacé Cuentas.' },
  { q: '¿Con qué frecuencia se actualiza el informe?', a: 'El dataset se regenera durante cada build completo del sitio. La fecha de generación figura en esta página y dentro del JSON.' },
  { q: '¿Cómo debo citar estas estadísticas?', a: `Cita sugerida: “Hacé Cuentas, Estadísticas de calculadoras online 2026, corpus de ${research.methodology.corpusHubs} hubs, consultado en hacecuentas.com”.` },
];
const schema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'Article', headline: 'Estadísticas de calculadoras online 2026', description: `Análisis de ${research.methodology.corpusHubs} hubs de cálculo: cobertura, variables, escenarios, fuentes e idiomas.`, url: URL, datePublished: '2026-08-18', dateModified: research.methodology.generatedAt, author: { '@type': 'Person', name: 'Martín Rodríguez', url: 'https://hacecuentas.com/autores/martin-rodriguez' }, publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' } },
    { '@type': 'Dataset', name: 'Estadísticas de calculadoras online 2026 — corpus Hacé Cuentas', description: `Inventario reproducible de ${research.methodology.corpusHubs} hubs públicos.`, url: URL, license: 'https://creativecommons.org/licenses/by/4.0/', creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' }, temporalCoverage: '2026', distribution: [
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datasets/hub-citable-research.csv' },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datasets/hub-citable-research.json' },
    ] },
    { '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' }, { '@type': 'ListItem', position: 2, name: 'Estadísticas de calculadoras online 2026', item: URL }] },
  ],
};
---

<Layout title="Estadísticas de calculadoras online 2026: análisis de 600 hubs" description={`Datos y estadísticas de calculadoras online 2026: análisis reproducible de ${research.methodology.corpusHubs} hubs, ${totalVariables} variables y ${totalSources} fuentes declaradas.`} canonical={URL} schema={schema} lang="es" audience="global" ogType="article" articlePublishedTime="2026-08-18" articleModifiedTime={research.methodology.generatedAt}>
  <Header />
  <main class="stats-page">
    <article>
      <nav aria-label="Migas de pan"><a href="/">Inicio</a><span>›</span><span>Estadísticas 2026</span></nav>
      <header class="hero">
        <p class="eyebrow">Investigación propia · Actualizada {research.methodology.generatedAt}</p>
        <h1>Estadísticas de calculadoras online 2026</h1>
        <p class="lede">Analizamos el inventario público completo de Hacé Cuentas para medir cómo se organiza un sitio de calculadoras online: cuántas decisiones cubre, qué profundidad tiene cada herramienta, cuántas variables modela y qué evidencia declara.</p>
        <p class="scope"><strong>Alcance:</strong> estas cifras describen Hacé Cuentas, no todo el mercado mundial de calculadoras.</p>
      </header>

      <section aria-labelledby="resumen"><h2 id="resumen">Los números principales</h2><div class="metric-grid">
        <div><strong>{research.methodology.corpusHubs}</strong><span>hubs públicos</span></div>
        <div><strong>{research.methodology.decisionHubs}</strong><span>hubs de decisión</span></div>
        <div><strong>{research.methodology.collectionHubs}</strong><span>colecciones temáticas</span></div>
        <div><strong>{totalVariables.toLocaleString('es-AR')}</strong><span>variables modeladas</span></div>
        <div><strong>{totalScenarios.toLocaleString('es-AR')}</strong><span>escenarios de decisión</span></div>
        <div><strong>{totalSources.toLocaleString('es-AR')}</strong><span>fuentes declaradas</span></div>
      </div></section>

      <section><h2>Qué tiene una calculadora típica del corpus</h2><p>La mediana evita que unas pocas herramientas muy grandes deformen el promedio. En los {decisions.length} hubs de decisión, la herramienta central tiene:</p><div class="metric-grid compact">
        <div><strong>{median('variables')}</strong><span>variables</span></div><div><strong>{median('scenarios')}</strong><span>escenarios</span></div><div><strong>{median('sources')}</strong><span>fuentes</span></div><div><strong>{median('faq')}</strong><span>preguntas frecuentes</span></div><div><strong>{median('routes')}</strong><span>rutas consolidadas</span></div>
      </div></section>

      <section><h2>Cobertura por idioma y mercado</h2><div class="table-wrap"><table><thead><tr><th>Idioma o mercado</th><th>Decisiones</th><th>Colecciones</th><th>Total</th></tr></thead><tbody>{locales.map((row) => <tr><th>{row.label}</th><td>{row.decisions}</td><td>{row.collections}</td><td><strong>{row.decisions + row.collections}</strong></td></tr>)}</tbody></table></div></section>

      <section><h2>Temáticas con más herramientas</h2><p>Conteo de hubs de decisión por categoría editorial.</p><ol class="ranking">{topSilos.map((row) => <li><span>{row.silo}</span><strong>{row.count}</strong></li>)}</ol></section>

      <section><h2>Colecciones con mayor cobertura</h2><p>Las colecciones agrupan todos sus hubs descendientes y permiten recorrer una temática o mercado completo.</p><ol class="ranking">{topCollections.map((row: any) => <li><a href={`/${row.slug}`}>{row.title}</a><strong>{row.routes} rutas</strong></li>)}</ol></section>

      <section class="method"><h2>Metodología y límites</h2><p>El análisis se genera directamente desde el inventario oficial del sitio. Para cada hub de decisión cuenta variables editables, escenarios, fuentes, FAQ y rutas consolidadas. Para cada colección agrega los datos de sus descendientes.</p><p><strong>Puntaje de profundidad:</strong> {research.methodology.depthScore}.</p><p>No se capturan datos personales ni valores ingresados en las calculadoras. Las sumas de esta página usan solamente hubs de decisión para no contar dos veces la información agregada en las colecciones.</p><p><a href="/metodologia">Leé la metodología editorial completa</a>.</p></section>

      <section class="downloads"><h2>Descargar el dataset</h2><p>Licencia CC BY 4.0: podés reutilizarlo con atribución y enlace a esta página.</p><div><a href="/datasets/hub-citable-research.csv" download>Descargar CSV</a><a href="/datasets/hub-citable-research.json" download>Descargar JSON</a></div></section>

      <section><h2>Cómo citar</h2><blockquote>Hacé Cuentas (2026). “Estadísticas de calculadoras online 2026”. Corpus de {research.methodology.corpusHubs} hubs públicos. {URL}</blockquote></section>
      <section><h2>Preguntas frecuentes</h2>{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</section>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .stats-page{max-width:1080px;margin:0 auto;padding:clamp(1rem,3vw,2rem);color:var(--text,#18283a)}article>nav{display:flex;gap:.5rem;color:var(--text-muted,#64748b);font-size:.85rem}.hero{padding:clamp(2rem,6vw,4rem) 0}.eyebrow{color:var(--accent,#23648d);font-size:.78rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}h1{max-width:850px;margin:.4rem 0;font-size:clamp(2.3rem,7vw,4.8rem);line-height:1}.lede{max-width:820px;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.65}.scope{max-width:820px;padding:1rem;border-left:4px solid #2e7ca7;background:var(--bg-soft,#eef6fa)}section{margin:clamp(2.5rem,6vw,5rem) 0}h2{font-size:clamp(1.5rem,3vw,2.2rem)}.metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem}.metric-grid>div{display:flex;flex-direction:column;padding:1.2rem;border:1px solid var(--border,#dce3e9);border-radius:15px;background:var(--bg-card,#fff)}.metric-grid strong{font-size:clamp(2rem,4vw,3rem);color:var(--accent,#173c5d)}.metric-grid span{color:var(--text-muted,#526477);font-size:.85rem}.compact strong{font-size:2rem}.table-wrap{overflow-x:auto;border:1px solid var(--border,#dce3e9);border-radius:14px}table{width:100%;border-collapse:collapse}th,td{padding:.8rem 1rem;border-bottom:1px solid var(--border,#e5e7eb);text-align:right}th:first-child{text-align:left}.ranking{display:grid;gap:.55rem;padding:0;list-style:none}.ranking li{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-bottom:1px solid var(--border,#e5e7eb)}.ranking a{color:var(--accent,#23648d);font-weight:700}.method,.downloads{padding:clamp(1.25rem,3vw,2rem);border-radius:18px;background:var(--bg-soft,#f4f7f9)}.downloads div{display:flex;flex-wrap:wrap;gap:.75rem}.downloads a{padding:.8rem 1rem;border-radius:10px;background:#176b91;color:#fff;font-weight:800;text-decoration:none}blockquote{margin:0;padding:1.25rem;border-left:4px solid #2e7ca7;background:var(--bg-soft,#eef6fa);line-height:1.6}details{padding:1rem 0;border-bottom:1px solid var(--border,#dce3e9)}summary{cursor:pointer;font-weight:800}details p{line-height:1.65}@media(max-width:600px){th,td{padding:.65rem .55rem;font-size:.8rem}.ranking li{align-items:flex-start;flex-direction:column}}
</style>
