---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/calc-flagship.css';
import {
  CATEGORIAS,
  TOPES,
  CUOTA_SERVICIOS,
  CUOTA_BIENES,
  PARAMS_FISICOS,
  META,
  fmtARS,
  componentes,
} from '../lib/data/monotributo-2026';

// Página-dato enlazable: tabla de referencia citable del monotributo 2026.
// Toda la data viene de la fuente única src/lib/data/monotributo-2026.ts → nunca queda stale.
// Patrón espejado de /datasets: schema Dataset + licencia CC-BY 4.0 + bloque "Cómo citar"
// → cuando un medio o blog cita la tabla, atribuye con link = backlink editorial.

const ULTIMA_REVISION = '2026-07-09';

// Filas de la tabla maestra (computadas desde la fuente única).
const filas = CATEGORIAS.map((cat) => ({
  cat,
  topeAnual: TOPES[cat],
  topeMensual: TOPES[cat] / 12,
  cuotaServicios: CUOTA_SERVICIOS[cat],
  cuotaBienes: CUOTA_BIENES[cat],
  cuotaAnualServicios: CUOTA_SERVICIOS[cat] * 12,
  desglose: componentes(cat, 'servicios'),
}));

// Datos destacados (los números que un periodista cita / screenshotea).
const topeMin = TOPES.A;
const topeMax = TOPES.K;
const cuotaMin = CUOTA_SERVICIOS.A;
const cuotaMaxServ = CUOTA_SERVICIOS.K;
const cuotaMaxBienes = CUOTA_BIENES.K;
const ratioServBienesK = CUOTA_SERVICIOS.K / CUOTA_BIENES.K;
const facturacionMensualMaxA = TOPES.A / 12;

const title =
  'Categorías monotributo 2026: tabla de topes y cuotas (A a K) | Hacé Cuentas';
const description =
  'Categorías del monotributo 2026: las 11 (A a K) con el tope de facturación anual y mensual, la cuota de servicios y de venta de bienes, y el desglose impositivo. Tabla oficial ARCA vigente desde febrero 2026, descargable (CC-BY 4.0).';

const PAGE_URL = 'https://hacecuentas.com/datos-monotributo-2026';

const faq = [
  {
    q: '¿Cuántas categorías de monotributo hay en 2026?',
    a: `Hay 11 categorías, de la A a la K. La A es la más baja (tope de facturación de ${fmtARS(topeMin)} anuales) y la K la más alta (${fmtARS(topeMax)} anuales).`,
  },
  {
    q: '¿Cuál es el tope de facturación más alto del monotributo 2026?',
    a: `La categoría K, con ${fmtARS(topeMax)} de ingresos brutos anuales. Superado ese límite hay que pasar al Régimen General (responsable inscripto).`,
  },
  {
    q: '¿Cuánto se paga de monotributo por mes en 2026?',
    a: `La cuota total mensual va desde ${fmtARS(cuotaMin)} en la categoría A hasta ${fmtARS(cuotaMaxServ)} en la K para servicios (${fmtARS(cuotaMaxBienes)} para venta de bienes). Incluye impuesto integrado, aporte jubilatorio (SIPA) y obra social.`,
  },
  {
    q: '¿Por qué en las categorías altas servicios paga más que venta de bienes?',
    a: `Por la reforma 2026: las categorías I, J y K dejaron de toparse en H y ahora aplican también a servicios, pero con cuota distinta. En la categoría K, servicios paga ${ratioServBienesK.toFixed(1)}× lo que paga venta de bienes (${fmtARS(cuotaMaxServ)} vs ${fmtARS(cuotaMaxBienes)}). Los topes de facturación son iguales para ambas actividades.`,
  },
  {
    q: '¿Cuándo es la recategorización del monotributo 2026?',
    a: `La recategorización es semestral (enero y julio). La de julio 2026 cierra el 5 de agosto de 2026. Se revisa la facturación de los últimos 12 meses para ubicarte en la categoría correcta.`,
  },
  {
    q: '¿Qué pasa si me excedo del tope de facturación de mi categoría?',
    a: `Depende de cuánto te excedas. Si tus ingresos de los últimos 12 meses superan el tope de tu categoría pero siguen por debajo del de la K (${fmtARS(topeMax)}), en la recategorización pasás a la categoría que corresponda. Si superás el tope máximo de la K, quedás excluido del monotributo y tenés que inscribirte en el Régimen General como responsable inscripto. Para ver hasta cuánto podés facturar sin salir del régimen, usá la calculadora de facturación máxima que enlazamos más abajo.`,
  },
  {
    q: '¿Desde cuándo rigen estos valores?',
    a: `Desde el ${new Date(META.vigencia).toLocaleDateString('es-AR')}. Son los valores oficiales publicados por ARCA (ex AFIP).`,
  },
  {
    q: '¿Qué incluye la cuota mensual del monotributo?',
    a: `Tres componentes: el impuesto integrado (el "impuesto" propiamente dicho), el aporte al SIPA (jubilación) y el aporte a la obra social. En la tabla de desglose de abajo está el detalle por categoría.`,
  },
  {
    q: '¿De dónde salen estos datos?',
    a: `De ARCA (Administración Federal, ex AFIP), fuente oficial del régimen. Los topes están validados además contra C5N y el Estudio Bertora Brown. La fuente está enlazada al final de la página.`,
  },
  {
    q: '¿Puedo usar esta tabla en mi web, nota o trabajo?',
    a: `Sí. Los datos se publican bajo licencia Creative Commons CC-BY 4.0: podés reproducirlos libremente citando la fuente con un enlace a hacecuentas.com. Más abajo está el bloque "Cómo citar".`,
  },
];

const datasetSchema = {
  '@type': 'Dataset',
  '@id': `${PAGE_URL}#dataset`,
  name: 'Monotributo Argentina 2026 — categorías, topes y cuotas',
  description:
    'Tabla de las 11 categorías del monotributo argentino vigentes en 2026 (A a K): tope de facturación anual, cuota mensual de servicios y de venta de bienes, y desglose en impuesto integrado, SIPA y obra social. Fuente: ARCA.',
  url: PAGE_URL,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  inLanguage: 'es-AR',
  dateModified: ULTIMA_REVISION,
  temporalCoverage: '2026',
  spatialCoverage: { '@type': 'Place', name: 'Argentina' },
  creator: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
  },
  sourceOrganization: {
    '@type': 'GovernmentOrganization',
    name: 'ARCA (Administración Federal de Ingresos Públicos)',
    url: META.fuenteUrl,
  },
  keywords: ['Monotributo', 'ARCA', 'Categorías monotributo', 'Topes monotributo', '2026', 'Argentina'],
  variableMeasured: [
    'Tope de facturación anual (ARS)', 'Cuota mensual servicios (ARS)',
    'Cuota mensual venta de bienes (ARS)', 'Impuesto integrado (ARS)',
    'Aporte SIPA (ARS)', 'Aporte obra social (ARS)',
  ],
  identifier: 'https://hacecuentas.com/datos/monotributo-2026.json',
  version: '2026',
  distribution: [
    { '@type': 'DataDownload', name: 'Monotributo 2026 (JSON)', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datos/monotributo-2026.json' },
    { '@type': 'DataDownload', name: 'Monotributo 2026 (CSV)', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datos/monotributo-2026.csv' },
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${PAGE_URL}#webpage`,
      name: title,
      description,
      url: PAGE_URL,
      inLanguage: 'es-AR',
      dateModified: ULTIMA_REVISION,
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
      mainEntity: { '@id': `${PAGE_URL}#dataset` },
    },
    datasetSchema,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Datos', item: 'https://hacecuentas.com/datos-monotributo-2026' },
        { '@type': 'ListItem', position: 3, name: 'Monotributo 2026', item: PAGE_URL },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout image="/og/data-datos-monotributo-2026.jpg" imageWidth={1200} imageHeight={675}
  title={title}
  description={description}
  canonical="/datos-monotributo-2026"
  audience="AR"
  schema={schema}
  domain="knowledge"
>
  <Header slot="header" />

  <main>
    <div class="cf-page mo" data-domain="knowledge">
      <nav class="cf-crumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li aria-hidden="true" class="cf-crumb__sep">›</li>
          <li><a href="/datasets">Datos fiscales</a></li>
          <li aria-hidden="true" class="cf-crumb__sep">›</li>
          <li aria-current="page">Monotributo 2026</li>
        </ol>
      </nav>

      <header class="cf-hero">
        <div class="cf-hero__main">
          <p class="cf-kicker"><span aria-hidden="true">🇦🇷</span> Argentina · valores oficiales 2026</p>
          <h1 class="cf-h1">Categorías del <span class="cf-yr">monotributo 2026</span></h1>
          <p class="cf-sub">Topes de facturación y cuotas mensuales de las 11 categorías, para servicios y venta de bienes.</p>
          <ul class="cf-pills">
            <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Fuente oficial ARCA</li>
            <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Vigentes desde febrero</li>
            <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Datos abiertos CC-BY 4.0</li>
          </ul>
          <p class="mo-updated">
            Última revisión: <time datetime={ULTIMA_REVISION}>{new Date(ULTIMA_REVISION).toLocaleDateString('es-AR')}</time> ·
            Licencia <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC-BY 4.0</a> (uso libre con atribución)
          </p>
        </div>
        <div class="cf-hero__deco" aria-hidden="true">
          <div class="mo-deco-wrap">
            <div class="cf-deco-card">
              <div class="cf-deco-card__label">Tope máximo anual · cat. K</div>
              <div class="cf-deco-card__value">${(topeMax / 1e6).toLocaleString('es-AR', { maximumFractionDigits: 1 })} M</div>
              <div class="cf-deco-card__note">Servicios y venta de bienes</div>
            </div>
            <span class="cf-deco-badge mo-badge">$</span>
          </div>
          <div class="mo-float">
            <span class="mo-float__k">Cuota mínima · cat. A</span>
            <strong class="mo-float__v">{fmtARS(cuotaMin)}</strong>
            <span class="mo-float__n">por mes</span>
          </div>
        </div>
      </header>

      <p class="answer-snippet cf-sr">
        Monotributo 2026: 11 categorías de la A (tope {fmtARS(topeMin)} anuales, cuota {fmtARS(cuotaMin)})
        a la K (tope {fmtARS(topeMax)}, cuota {fmtARS(cuotaMaxServ)} servicios). Valores oficiales de ARCA
        vigentes desde el {new Date(META.vigencia).toLocaleDateString('es-AR')}.
      </p>

      <div class="cf-stats">
        <div class="cf-stat cf-stat--accent">
          <div class="cf-stat__label">Categorías</div>
          <div class="cf-stat__value">11 · A hasta K</div>
          <div class="cf-stat__sub">Escala completa 2026</div>
        </div>
        <div class="cf-stat">
          <div class="cf-stat__label">Cuota más baja</div>
          <div class="cf-stat__value">{fmtARS(cuotaMin)}</div>
          <div class="cf-stat__sub">Categoría A</div>
        </div>
        <div class="cf-stat">
          <div class="cf-stat__label">Tope anual máximo</div>
          <div class="cf-stat__value">{fmtARS(topeMax)}</div>
          <div class="cf-stat__sub">Categoría K</div>
        </div>
        <div class="cf-stat">
          <div class="cf-stat__label">Cuota más alta</div>
          <div class="cf-stat__value">{fmtARS(cuotaMaxServ)}</div>
          <div class="cf-stat__sub">Categoría K · servicios</div>
        </div>
      </div>

      <!-- Escala visual -->
      <section class="cf-section">
        <div class="cf-section__head">
          <div>
            <p class="cf-eyebrow">La escala completa</p>
            <h2 class="cf-section__title">De la categoría A a la K</h2>
          </div>
          <p class="cf-section__lead">Cada escalón aumenta el tope de ingresos brutos de los últimos 12 meses. Las últimas categorías también admiten servicios.</p>
        </div>
        <div class="mo-chart">
          {filas.map((f) => (
            <div class="mo-bar" style={`--h:${Math.max(6, Math.round((f.topeAnual / topeMax) * 100))}%`}>
              <span class="mo-bar__fill" data-cat={f.cat}></span>
              <span class="mo-bar__cat">{f.cat}</span>
              <span class="mo-bar__val">{(f.topeAnual / 1e6).toLocaleString('es-AR', { maximumFractionDigits: 0 })}M</span>
            </div>
          ))}
        </div>
        <p class="mo-foot">Altura = tope anual de facturación. Las categorías I, J y K sólo admiten servicios desde la reforma.</p>
      </section>

      <!-- Tabla maestra -->
      <section class="cf-section" id="tabla">
        <div class="cf-section__head">
          <div>
            <p class="cf-eyebrow">Tabla de referencia</p>
            <h2 class="cf-section__title">Topes y cuotas mensuales</h2>
          </div>
          <p class="cf-section__lead">El tope es igual para ambas actividades. Desde la categoría C, la cuota cambia entre servicios y venta de bienes.</p>
        </div>
        <div class="cf-tablewrap">
          <table class="cf-table">
            <thead>
              <tr><th>Cat.</th><th>Tope anual</th><th>Promedio mensual</th><th>Cuota servicios</th><th>Cuota bienes</th></tr>
            </thead>
            <tbody>
              {filas.map((f) => (
                <tr>
                  <td><strong>{f.cat}</strong></td>
                  <td>{fmtARS(f.topeAnual)}</td>
                  <td>{fmtARS(f.topeMensual)}</td>
                  <td class="cf-td-em">{fmtARS(f.cuotaServicios)}</td>
                  <td>{fmtARS(f.cuotaBienes)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Claves -->
      <section class="cf-section">
        <p class="cf-eyebrow">Claves 2026</p>
        <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Qué tenés que mirar</h2>
        <div class="cf-cards cf-cards--3">
          <div class="cf-minicard cf-minicard--dark">
            <span class="cf-minicard__ico" aria-hidden="true">📈</span>
            <p class="cf-minicard__title">Servicios llega hasta la K</p>
            <p class="cf-minicard__desc">Las categorías I, J y K admiten tanto locaciones y prestaciones de servicios como venta de bienes.</p>
          </div>
          <div class="cf-minicard">
            <span class="cf-minicard__ico" aria-hidden="true">⚖️</span>
            <p class="cf-minicard__title">Mismos topes de ingresos</p>
            <p class="cf-minicard__desc">Servicios y venta de bienes comparten el mismo límite anual en cada categoría.</p>
          </div>
          <div class="cf-minicard">
            <span class="cf-minicard__ico" aria-hidden="true">💳</span>
            <p class="cf-minicard__title">Cuotas diferentes</p>
            <p class="cf-minicard__desc">En las categorías altas, servicios paga una cuota mensual bastante mayor que venta de bienes.</p>
          </div>
        </div>
      </section>

      <!-- Cat K: dos cuotas -->
      <section class="cf-section">
        <div class="mo-2col">
          <div class="mo-hl">
            <p class="cf-side-eyebrow">Categoría K</p>
            <p class="mo-hl__title">La misma facturación, dos cuotas muy distintas</p>
            <p class="mo-hl__desc">El tope anual es idéntico, pero el impuesto integrado cambia según el tipo de actividad.</p>
            <div class="mo-hl__big">{fmtARS(topeMax)}</div>
            <p class="mo-hl__desc">Tope anual ambas actividades</p>
          </div>
          <div class="cf-breakdown">
            <div class="cf-brow">
              <span class="cf-brow__lbl">Servicios</span>
              <span class="cf-brow__val">{fmtARS(cuotaMaxServ)}</span>
              <span class="cf-brow__bar"><span style="width:100%"></span></span>
            </div>
            <p class="mo-note">Cuota mensual · categoría K</p>
            <div class="cf-brow" style="margin-top:1rem">
              <span class="cf-brow__lbl">Venta de bienes</span>
              <span class="cf-brow__val">{fmtARS(cuotaMaxBienes)}</span>
              <span class="cf-brow__bar"><span class="mo-bar--alt" style={`width:${Math.round((cuotaMaxBienes / cuotaMaxServ) * 100)}%`}></span></span>
            </div>
            <p class="mo-note">Cuota mensual · categoría K</p>
            <div class="cf-breakdown__total">
              <span>Servicios paga aproximadamente</span>
              <strong>{ratioServBienesK.toLocaleString('es-AR', { maximumFractionDigits: 1 })}×</strong>
            </div>
          </div>
        </div>
      </section>

      <!-- Composición de la cuota -->
      <section class="cf-section">
        <div class="cf-section__head">
          <div>
            <p class="cf-eyebrow">Qué incluye la cuota</p>
            <h2 class="cf-section__title">Impuesto, jubilación y obra social</h2>
          </div>
          <p class="cf-section__lead">Ejemplo con la categoría C para servicios. La cuota total reúne tres componentes en un único pago mensual.</p>
        </div>
        <div class="mo-2col">
          <div class="mo-donut-card">
            <div class="mo-donut" aria-hidden="true"><span>C</span></div>
            <div>
              <p class="mo-donut__k">Categoría C · servicios</p>
              <p class="mo-donut__v">{fmtARS(componentes('C', 'servicios').total)}</p>
              <p class="mo-donut__n">Cuota mensual total</p>
            </div>
          </div>
          <div class="cf-breakdown">
            <p class="cf-side-eyebrow">Composición aproximada</p>
            {[
              { k: 'Impuesto integrado', v: componentes('C', 'servicios').integrado },
              { k: 'Aporte jubilatorio · SIPA', v: componentes('C', 'servicios').sipa },
              { k: 'Aporte obra social', v: componentes('C', 'servicios').obraSocial },
            ].map((x) => (
              <div class="cf-brow" style="margin-bottom:0.7rem">
                <span class="cf-brow__lbl">{x.k}</span>
                <span class="cf-brow__val">{fmtARS(x.v)}</span>
                <span class="cf-brow__bar"><span style={`width:${Math.round((x.v / componentes('C', 'servicios').total) * 100)}%`}></span></span>
              </div>
            ))}
            <div class="cf-breakdown__total"><span>Cuota total</span><strong>{fmtARS(componentes('C', 'servicios').total)}</strong></div>
            <p class="mo-note" style="margin-top:0.6rem">El dato exacto es el total oficial; el desglose mantiene la proporción aproximada de cada componente.</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Franja: recategorización -->
    <div class="cf-band cf-band--warm" data-domain="knowledge">
      <div class="cf-band__inner">
        <div class="mo-2col">
          <div>
            <p class="cf-eyebrow">Recategorización</p>
            <h2 class="mo-card__title">Revisá tu categoría cada semestre</h2>
            <p class="cf-side-desc">
              La recategorización es {META.recategorizacion}: se comparan los ingresos brutos de los últimos
              12 meses y, si cambian tu situación, corresponde recategorizarse en el portal de ARCA.
            </p>
            <div class="cf-callout cf-callout--warn" style="margin-top:1rem">
              <span class="cf-callout__ico" aria-hidden="true">📅</span>
              <p>Si superás el tope de la categoría K quedás excluido del régimen y pasás a responsable inscripto.</p>
            </div>
          </div>
          <div class="mo-reca">
            <span class="mo-reca__k">Frecuencia</span>
            <strong class="mo-reca__v">Semestral</strong>
            <span class="mo-reca__n">Enero y julio · fuente {META.fuente}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="cf-page mo" data-domain="knowledge">
      <!-- Otros parámetros -->
      <section class="cf-section">
        <div class="cf-section__head">
          <div>
            <p class="cf-eyebrow">No es sólo facturación</p>
            <h2 class="cf-section__title">Otros parámetros de la categoría</h2>
          </div>
          <p class="cf-section__lead">ARCA también considera la superficie afectada, la energía consumida y los alquileres devengados.</p>
        </div>
        <div class="cf-cards cf-cards--3">
          <div class="cf-minicard">
            <span class="cf-minicard__ico" aria-hidden="true">📐</span>
            <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Superficie afectada</p>
            <div class="cf-minicard__big">Hasta {PARAMS_FISICOS.K.superficie} m²</div>
            <p class="cf-minicard__desc" style="margin-top:0.3rem">Tope del régimen (categorías G a K).</p>
          </div>
          <div class="cf-minicard">
            <span class="cf-minicard__ico" aria-hidden="true">⚡</span>
            <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Energía consumida</p>
            <div class="cf-minicard__big">Hasta {PARAMS_FISICOS.K.energia.toLocaleString('es-AR')} kWh</div>
            <p class="cf-minicard__desc" style="margin-top:0.3rem">Consumo eléctrico anual máximo.</p>
          </div>
          <div class="cf-minicard">
            <span class="cf-minicard__ico" aria-hidden="true">🏠</span>
            <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Alquileres</p>
            <div class="cf-minicard__big">{fmtARS(PARAMS_FISICOS.K.alquiler)}</div>
            <p class="cf-minicard__desc" style="margin-top:0.3rem">Devengados al año, categorías superiores.</p>
          </div>
        </div>
