<script>
  import { CATEGORIAS, TOPES, CUOTA_SERVICIOS, CUOTA_BIENES } from '../lib/data/monotributo-2026';

  const form = document.querySelector<HTMLFormElement>('#mono-quick-form');
  const income = document.querySelector<HTMLInputElement>('#mono-income');
  const period = document.querySelector<HTMLSelectElement>('#mono-period');
  const activity = document.querySelector<HTMLSelectElement>('#mono-activity');
  const result = document.querySelector<HTMLElement>('#mono-result');
  const resultCat = document.querySelector<HTMLElement>('#mono-result-cat');
  const resultFee = document.querySelector<HTMLElement>('#mono-result-fee');
  const resultMargin = document.querySelector<HTMLElement>('#mono-result-margin');
  const resultNote = document.querySelector<HTMLElement>('#mono-result-note');
  const ars = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });

  const parseMoney = (value: string) => Number(value.replace(/[^0-9]/g, ''));
  income?.addEventListener('input', () => {
    const value = parseMoney(income.value);
    income.value = value ? value.toLocaleString('es-AR') : '';
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!income || !period || !activity || !result || !resultCat || !resultFee || !resultMargin || !resultNote) return;
    const entered = parseMoney(income.value);
    if (!entered) {
      income.setCustomValidity('Ingresá una facturación mayor a cero.');
      income.reportValidity();
      return;
    }
    income.setCustomValidity('');
    const annual = period.value === 'monthly' ? entered * 12 : entered;
    // El formulario trabaja en pesos enteros, mientras ARCA publica topes con centavos.
    // Aceptamos el peso redondeado que ve el usuario para no excluir el límite oficial.
    const cat = CATEGORIAS.find((key) => annual <= Math.ceil(TOPES[key]));
    result.hidden = false;
    if (!cat) {
      resultCat.textContent = 'Fuera del régimen';
      resultFee.textContent = 'Revisar Régimen General';
      resultMargin.textContent = ars.format(annual - TOPES.K) + ' sobre la K';
      resultNote.textContent = 'La facturación supera el máximo de la categoría K. Verificá la exclusión y el pase a Responsable Inscripto con ARCA o un profesional.';
      result.dataset.state = 'danger';
      return;
    }
    const fee = activity.value === 'bienes' ? CUOTA_BIENES[cat] : CUOTA_SERVICIOS[cat];
    const displayedCap = Math.ceil(TOPES[cat]);
    const margin = Math.max(0, displayedCap - annual);
    const marginPct = (margin / displayedCap) * 100;
    resultCat.textContent = cat;
    resultFee.textContent = ars.format(fee);
    resultMargin.textContent = ars.format(margin);
    resultNote.textContent = marginPct <= 10
      ? `Estás a ${marginPct.toLocaleString('es-AR', { maximumFractionDigits: 1 })}% del tope de la categoría ${cat}. Seguí de cerca la facturación acumulada.`
      : `Tu facturación anualizada representa ${((annual / displayedCap) * 100).toLocaleString('es-AR', { maximumFractionDigits: 1 })}% del tope de la categoría ${cat}.`;
    result.dataset.state = marginPct <= 10 ? 'warning' : 'ok';
  });
</script>

