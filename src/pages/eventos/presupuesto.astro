---
/**
 * Hub de decisión — "¿Cuánto me va a salir la fiesta?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (5 ramas, `cases`).
 * Hermano de /eventos/comida y /eventos/bebidas: aquéllas dicen CUÁNTO comprar,
 * ésta dice CUÁNTO SALE. El casamiento va aparte, en /eventos/casamiento.
 *
 * Los números no están acá: se derivan de las cinco fórmulas reales dentro de
 * src/lib/hubs/presupuesto-fiesta.ts, que además documenta el problema de fondo
 * (tres calculadoras cotizaban en dólares, una en pesos bajos y una sin
 * constantes) y con qué criterio se unificó todo a pesos.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import PresupuestoEventosExperience from '../../components/generated/PresupuestoEventosExperience.astro';
import {
  hub,
  DOLAR,
  COMIDA_PP,
  BEBIDA_PP,
  LUGAR_PP,
  EXTRAS_PP,
  CONFIG_REF,
  BANDA_PP,
  USD_PP,
  RUBROS_QUINCE,
  RUBROS_GRADUACION,
  RUBROS_DESPEDIDA,
  RUBRO_COMIDA,
  RUBRO_LUGAR,
  LOGISTICA_PP,
  MARGEN_INVITADOS,
  NIVEL_CORTES,
  NIVEL_ETIQUETAS,
} from '../../lib/hubs/presupuesto-fiesta';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <PresupuestoEventosExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

