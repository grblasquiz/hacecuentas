---
/**
 * Hub de decisión — "¿Cuánta carne compro para el asado?"
 * Arquetipo RAMIFICADO. Absorbe 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/asado.ts) y su compute(). Todo el
 * chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 *
 * El resultado es accionable: kilos por corte y unidades de chorizo/morcilla, no
 * un total abstracto. Todo va en `unit` (kg, unidades, gramos); lo único en pesos
 * es el presupuesto, y sólo si el usuario carga el precio del kilo.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import AsadoExperience from '../../components/generated/AsadoExperience.astro';
import { hub, RACIONES, REPARTO, PESO_CHORIZO_G, PESO_MORCILLA_G, SPLIT_CHORIZO, FACTOR_COME_POCO } from '../../lib/hubs/asado';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <AsadoExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

