---
/**
 * Hub de decisión — "Empanadas, carbón y guarniciones: ¿cuánto preparo?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (4 ramas, `cases`): empanadas por invitado, rendimiento
 * de la masa a partir de la harina, guarniciones (ensalada y pan) y fuego
 * (carbón, leña y tamaño de parrilla).
 *
 * Es el complemento de /eventos/asado, que resuelve la CARNE. Acá va todo lo
 * demás. Los números se derivan de las fórmulas reales del repo dentro de
 * src/lib/hubs/asado-resto.ts.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EmpanadasGuarnicionesExperience from '../../components/generated/EmpanadasGuarnicionesExperience.astro';
import {
  hub,
  PORCIONES,
  POR_DOCENA,
  HARINA_POR_TAPA,
  RELLENO_POR_EMPANADA_G,
  TAPAS_POR_PAQUETE,
  RECETA_MASA,
  ENSALADA_G,
  LECHUGAS_POR_KG,
  TOMATES_POR_KG,
  CEBOLLA_G_POR_KG,
  PAN_G_ADULTO,
  PAN_FACTOR_NINO,
  MIGNON_G,
  FLAUTA_G,
  CARBON_KG_PERSONA,
  LENA_KG_PERSONA,
  CARBON_POR_PASTILLA,
  MINUTOS_BRASA,
  CM2_POR_PERSONA,
  BANDAS_PARRILLA,
} from '../../lib/hubs/asado-resto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <EmpanadasGuarnicionesExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    PORCIONES,
    POR_DOCENA,
    HARINA_POR_TAPA,
    RELLENO_POR_EMPANADA_G,
    TAPAS_POR_PAQUETE,
    RECETA_MASA,
    ENSALADA_G,
    LECHUGAS_POR_KG,
    TOMATES_POR_KG,
    CEBOLLA_G_POR_KG,
    PAN_G_ADULTO,
    PAN_FACTOR_NINO,
    MIGNON_G,
    FLAUTA_G,
    CARBON_KG_PERSONA,
    LENA_KG_PERSONA,
    CARBON_POR_PASTILLA,
    MINUTOS_BRASA,
    CM2_POR_PERSONA,
    BANDAS_PARRILLA,
  }}
>
  (function () {
    const H = window.HC_HUB;

    // El desglose mezcla unidades, gramos, kilos, cm² y pesos: NINGUNA fila
    // puede quedar sin `format`, porque el runtime hace Object.assign y la que
    // no lo declara cae a pesos. La de plata declara 'ars' explícito.
    const U = (v, unit, decimals) => ({ v: v, format: 'unit', unit: unit, decimals: decimals || 0 });

    const n = (x, d) =>
      Number(x || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });
    const nd = (x, d) => Number(x || 0).toLocaleString('es-AR', { maximumFractionDigits: d === undefined ? 1 : d });

    function plural(x, sing, plur) {
      return x === 1 ? sing : plur;
    }

    /** Banda de tamaño de parrilla que corresponde a una superficie en cm². */
    function bandaParrilla(cm2) {
      for (let i = 0; i < BANDAS_PARRILLA.length; i++) {
        if (cm2 <= BANDAS_PARRILLA[i].hasta) return BANDAS_PARRILLA[i].label;
      }
      return BANDAS_PARRILLA[BANDAS_PARRILLA.length - 1].label;
    }

    H.onCompute(function (v, kase) {
      const rama = (kase && kase.id) || 'empanadas';
      const adultos = Math.max(0, Math.round(v.adultos || 0));
      const ninos = Math.max(0, Math.round(v.ninos || 0));
      const personas = adultos + ninos;
      const rows = [];

      /* ─────────────── Rama 2: tengo la harina, ¿cuántas salen? ─────────────── */
      if (rama === 'harina') {
        const tipo = HARINA_POR_TAPA[v.tipoTapa] ? v.tipoTapa : 'casera_criolla';
        const harina = Math.max(0, v.harina || 0);
        const gPorTapa = HARINA_POR_TAPA[tipo];
        const empanadas = Math.floor(harina / gPorTapa);
        const docenas = Math.ceil(empanadas / POR_DOCENA);
        const relleno = (empanadas * RELLENO_POR_EMPANADA_G) / 1000;
        const receta = RECETA_MASA[tipo];

        rows.push({ k: 'Harina disponible', ref: 'lo que cargaste', ...U(harina, 'g') });
        rows.push({ k: 'Harina por tapa', ref: tipo === 'casera_frita' ? 'masa para freír' : 'masa criolla de horno', ...U(gPorTapa, 'g') });
        rows.push({ k: 'Empanadas que salen', ref: 'redondeo hacia abajo: media tapa no sirve', ...U(empanadas, 'empanadas'), extra: true });
        rows.push({ k: 'Docenas', ref: POR_DOCENA + ' por docena', ...U(docenas, 'docenas') });
        rows.push({ k: 'Relleno necesario', ref: RELLENO_POR_EMPANADA_G + ' g por empanada', ...U(relleno, 'kg', 2), extra: true });

        if (tipo === 'comprada') {
          rows.push({ k: 'Paquetes de tapas', ref: TAPAS_POR_PAQUETE + ' unidades cada uno', ...U(Math.ceil(empanadas / TAPAS_POR_PAQUETE), 'paquetes'), extra: true });
        }

        const grasa = receta ? Math.round(harina * receta.grasa) : 0;
        const agua = receta ? Math.round(harina * receta.agua) : 0;
        const sal = receta ? Math.round(harina * receta.sal) : 0;
        if (receta) {
          rows.push({ k: 'Grasa', ref: Math.round(receta.grasa * 100) + '% del peso de la harina', ...U(grasa, 'g') });
          rows.push({ k: 'Agua', ref: Math.round(receta.agua * 100) + '% del peso de la harina', ...U(agua, 'ml') });
          rows.push({ k: 'Sal', ref: nd(receta.sal * 100, 1) + '% del peso de la harina', ...U(sal, 'g') });
          if (receta.huevo) rows.push({ k: 'Huevo', ref: 'lo lleva la masa para freír', ...U(1, 'huevo') });
        }

        return {
          total: empanadas + ' ' + plural(empanadas, 'empanada', 'empanadas'),
          sub:
            nd(harina, 0) + ' g de harina a ' + nd(gPorTapa, 0) + ' g por tapa · ' + docenas + ' ' +
            plural(docenas, 'docena', 'docenas') + ' · ' + nd(relleno, 2) + ' kg de relleno',
          format: 'plain',
          rows: rows,
          chart: receta
            ? [
                { label: 'Harina (g)', value: Math.round(harina), tone: 'main' },
                { label: 'Grasa (g)', value: grasa, tone: 'prop' },
                { label: 'Agua (ml)', value: agua, tone: 'good' },
                { label: 'Sal (g)', value: sal, tone: 'warn' },
              ]
            : [
                { label: 'Tapas compradas', value: empanadas, tone: 'main' },
                { label: 'Relleno (g)', value: Math.round(relleno * 1000), tone: 'prop' },
              ],
        };
      }

      /* ─────────────────── Rama 3: ensalada y pan ─────────────────── */
      if (rama === 'guarniciones') {
        const rolEns = ENSALADA_G[v.rolEnsalada] ? v.rolEnsalada : 'guarnicion';
        const gEns = ENSALADA_G[rolEns];
        const ensaladaG = personas * gEns;
        const ensaladaKg = personas > 0 ? Math.ceil((ensaladaG / 1000) * 4) / 4 : 0;
        const lechugas = personas > 0 ? Math.max(1, Math.ceil((ensaladaG / 1000) * LECHUGAS_POR_KG)) : 0;
        const tomates = personas > 0 ? Math.max(1, Math.ceil((ensaladaG / 1000) * TOMATES_POR_KG)) : 0;
        const cebollaG = Math.round((ensaladaG / 1000) * CEBOLLA_G_POR_KG);

        const tipoComida = PAN_G_ADULTO[v.tipoComida] ? v.tipoComida : 'asado';
        const gPan = PAN_G_ADULTO[tipoComida];
        const panG = adultos * gPan + ninos * gPan * PAN_FACTOR_NINO;
        const panKg = personas > 0 ? Math.ceil((panG / 1000) * 4) / 4 : 0;
        const mignones = personas > 0 ? Math.ceil(panG / MIGNON_G) : 0;
        const flautas = personas > 0 ? Math.ceil(panG / FLAUTA_G) : 0;

        rows.push({ k: 'Comensales', ref: adultos + ' adultos y ' + ninos + ' chicos', ...U(personas, 'personas') });
        rows.push({ k: 'Ensalada', ref: gEns + ' g por persona (' + (rolEns === 'principal' ? 'plato principal' : 'guarnición') + ')', ...U(ensaladaKg, 'kg', 2), extra: true });
        rows.push({ k: 'Lechugas', ref: 'base de una mixta', ...U(lechugas, 'lechugas'), extra: true });
        rows.push({ k: 'Tomates', ref: 'base de una mixta', ...U(tomates, 'tomates'), extra: true });
        rows.push({ k: 'Cebolla', ref: 'servila aparte, no mezclada', ...U(cebollaG, 'g') });
        rows.push({ k: 'Pan', ref: gPan + ' g por adulto · ' + Math.round(gPan * PAN_FACTOR_NINO) + ' g por chico', ...U(panKg, 'kg', 2), extra: true });
        rows.push({ k: 'Mignones', ref: MIGNON_G + ' g cada uno', ...U(mignones, 'mignones') });
        rows.push({ k: 'Flautas o baguettes', ref: FLAUTA_G + ' g cada una', ...U(flautas, 'flautas') });

        return {
          total: nd(ensaladaKg, 2) + ' kg de ensalada + ' + nd(panKg, 2) + ' kg de pan',
          sub:
            personas + ' ' + plural(personas, 'persona', 'personas') + ' · ' + lechugas + ' ' + plural(lechugas, 'lechuga', 'lechugas') +
            ', ' + tomates + ' ' + plural(tomates, 'tomate', 'tomates') + ' y ' + nd(cebollaG, 0) + ' g de cebolla · ' +
            mignones + ' mignones o ' + flautas + ' flautas',
          format: 'plain',
          rows: rows,
          chart: [
            { label: 'Lechuga (g)', value: Math.round(ensaladaG * 0.4), tone: 'good' },
            { label: 'Tomate (g)', value: Math.round(ensaladaG * 0.45), tone: 'bad' },
            { label: 'Cebolla (g)', value: cebollaG, tone: 'prop' },
            { label: 'Pan (g)', value: Math.round(panG), tone: 'main' },
          ],
        };
      }

      /* ─────────────────── Rama 4: carbón, leña y parrilla ─────────────────── */
      if (rama === 'fuego') {
        const dur = CARBON_KG_PERSONA[v.duracion] !== undefined ? v.duracion : 'normal';
        const conLena = String(v.lena) === 'si';
        const carbon = personas > 0 ? Math.ceil(personas * CARBON_KG_PERSONA[dur] * 2) / 2 : 0;
        const lena = personas > 0 && conLena ? Math.ceil(personas * LENA_KG_PERSONA * 2) / 2 : 0;
        const pastillas = personas > 0 ? Math.max(2, Math.ceil(carbon / CARBON_POR_PASTILLA)) : 0;
        const minutos = personas > 0 ? MINUTOS_BRASA[dur] : 0;

        const tipoP = CM2_POR_PERSONA[v.tipoParrilla] ? v.tipoParrilla : 'estandar';
        const cm2 = Math.ceil(personas * CM2_POR_PERSONA[tipoP]);
        const banda = bandaParrilla(cm2);

        rows.push({ k: 'Comensales', ref: adultos + ' adultos y ' + ninos + ' chicos', ...U(personas, 'personas') });
        rows.push({ k: 'Carbón', ref: nd(CARBON_KG_PERSONA[dur], 2) + ' kg por persona', ...U(carbon, 'kg', 1), extra: true });
        if (conLena) rows.push({ k: 'Leña', ref: nd(LENA_KG_PERSONA, 2) + ' kg por persona', ...U(lena, 'kg', 1), extra: true });
        rows.push({ k: 'Pastillas de encendido', ref: 'una cada ' + nd(CARBON_POR_PASTILLA, 1) + ' kg, mínimo 2', ...U(pastillas, 'pastillas') });
        rows.push({ k: 'Tiempo hasta tener brasa', ref: 'prendé con esta anticipación', ...U(minutos, 'min') });
        rows.push({ k: 'Superficie de parrilla', ref: nd(CM2_POR_PERSONA[tipoP], 0) + ' cm² por persona', ...U(cm2, 'cm²'), extra: true });
        rows.push({ k: 'Equivale a', ref: banda, ...U(cm2 / 10000, 'm²', 2) });

        return {
          total: nd(carbon, 1) + ' kg de carbón' + (conLena ? ' + ' + nd(lena, 1) + ' kg de leña' : ''),
          sub:
            personas + ' ' + plural(personas, 'persona', 'personas') + ' · ' + pastillas + ' pastillas · brasa lista en ~' +
            minutos + ' min · parrilla de ' + nd(cm2, 0) + ' cm² (' + banda.toLowerCase() + ')',
          format: 'plain',
          rows: rows,
          chart: conLena
            ? [
                { label: 'Carbón (kg)', value: carbon, tone: 'main' },
                { label: 'Leña (kg)', value: lena, tone: 'prop' },
              ]
            : [
                { label: 'Carbón encendido de arranque (kg)', value: Math.round(carbon * 0.4 * 10) / 10, tone: 'main' },
                { label: 'Carbón de reposición (kg)', value: Math.round(carbon * 0.6 * 10) / 10, tone: 'prop' },
              ],
        };
      }

      /* ─────────────── Rama 1 (default): empanadas por invitado ─────────────── */
      const rol = PORCIONES[v.rolEmpanada] ? v.rolEmpanada : 'principal';
      const P = PORCIONES[rol];
      const porAdultos = Math.round(adultos * P.adulto);
      const porNinos = Math.round(ninos * P.nino);
      const total = porAdultos + porNinos;
      const docenas = Math.ceil(total / POR_DOCENA);

      const pcts = [
        { label: 'Carne', v: Math.max(0, v.pctCarne || 0), tone: 'main' },
        { label: 'Pollo', v: Math.max(0, v.pctPollo || 0), tone: 'prop' },
        { label: 'Jamón y queso', v: Math.max(0, v.pctJyq || 0), tone: 'good' },
        { label: 'Verdura', v: Math.max(0, v.pctVerdura || 0), tone: 'warn' },
      ];
      const suma = pcts.reduce(function (a, p) { return a + p.v; }, 0);
      const sabores = pcts.map(function (p) {
        return { label: p.label, tone: p.tone, unidades: suma > 0 ? Math.round(total * (p.v / suma)) : 0 };
      });

      const tipo = HARINA_POR_TAPA[v.tipoTapa] ? v.tipoTapa : 'casera_criolla';
      const harinaG = total * HARINA_POR_TAPA[tipo];
      const rellenoKg = (total * RELLENO_POR_EMPANADA_G) / 1000;
      const precioDocena = Math.max(0, v.precioDocena || 0);

      rows.push({ k: 'Empanadas para los adultos', ref: nd(P.adulto, 1) + ' por adulto', ...U(porAdultos, 'empanadas') });
      rows.push({ k: 'Empanadas para los chicos', ref: nd(P.nino, 1) + ' por chico', ...U(porNinos, 'empanadas') });
      rows.push({ k: 'TOTAL DE EMPANADAS', ref: rol === 'principal' ? 'plato principal' : rol === 'picada' ? 'acompañando otra comida' : 'picoteo o entrada', ...U(total, 'empanadas'), extra: true });
      rows.push({ k: 'Docenas', ref: POR_DOCENA + ' por docena, redondeo hacia arriba', ...U(docenas, 'docenas'), extra: true });

      sabores.forEach(function (s) {
        rows.push({ k: 'De ' + s.label.toLowerCase(), ref: suma > 0 ? Math.round((s.unidades / total) * 100 || 0) + '% del pedido' : 'sin reparto', ...U(s.unidades, 'empanadas') });
      });

      if (tipo === 'comprada') {
        rows.push({ k: 'Paquetes de tapas', ref: TAPAS_POR_PAQUETE + ' unidades cada uno', ...U(Math.ceil(total / TAPAS_POR_PAQUETE), 'paquetes'), extra: true });
      } else {
        rows.push({ k: 'Harina para la masa', ref: HARINA_POR_TAPA[tipo] + ' g por tapa', ...U(harinaG, 'g'), extra: true });
      }
      rows.push({ k: 'Relleno', ref: RELLENO_POR_EMPANADA_G + ' g por empanada', ...U(rellenoKg, 'kg', 2), extra: true });
      rows.push({ k: 'Gasto estimado si las encargás', ref: '$' + n(precioDocena) + ' la docena × ' + docenas, v: docenas * precioDocena, format: 'ars' });

      return {
        total: total + ' ' + plural(total, 'empanada', 'empanadas'),
        sub:
          docenas + ' ' + plural(docenas, 'docena', 'docenas') + ' para ' + adultos + ' adultos y ' + ninos +
          ' chicos · ' + (tipo === 'comprada' ? Math.ceil(total / TAPAS_POR_PAQUETE) + ' paquetes de tapas' : nd(harinaG / 1000, 2) + ' kg de harina') +
          ' y ' + nd(rellenoKg, 2) + ' kg de relleno',
        format: 'plain',
        rows: rows,
        chart: sabores.map(function (s) {
          return { label: s.label, value: s.unidades, tone: s.tone };
        }),
      };
    });
  })();
</script>
