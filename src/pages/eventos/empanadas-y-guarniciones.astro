---
/**
 * Hub de decisión — "Empanadas, carbón y guarniciones: ¿cuánto preparo?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (4 ramas, `cases`): empanadas por invitado, rendimiento
 * de la masa a partir de la harina, guarniciones (ensalada y pan) y fuego
 * (carbón, leña y tamaño de parrilla).
 *
 * Es el complemento de /eventos/asado, que resuelve la CARNE. Acá va todo lo
 * demás. Los números se derivan de las fórmulas reales del repo dentro de
 * src/lib/hubs/asado-resto.ts.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EmpanadasGuarnicionesExperience from '../../components/generated/EmpanadasGuarnicionesExperience.astro';
import {
  hub,
  PORCIONES,
  POR_DOCENA,
  HARINA_POR_TAPA,
  RELLENO_POR_EMPANADA_G,
  TAPAS_POR_PAQUETE,
  RECETA_MASA,
  ENSALADA_G,
  LECHUGAS_POR_KG,
  TOMATES_POR_KG,
  CEBOLLA_G_POR_KG,
  PAN_G_ADULTO,
  PAN_FACTOR_NINO,
  MIGNON_G,
  FLAUTA_G,
  CARBON_KG_PERSONA,
  LENA_KG_PERSONA,
  CARBON_POR_PASTILLA,
  MINUTOS_BRASA,
  CM2_POR_PERSONA,
  BANDAS_PARRILLA,
} from '../../lib/hubs/asado-resto';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <EmpanadasGuarnicionesExperience data={hub} />
  <Footer />
</Layout>

