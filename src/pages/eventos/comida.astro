---
/**
 * Hub de decisión — "¿Cuánta comida compro para la fiesta?"
 * Reemplaza 15 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (4 ramas, `cases`).
 * Hermano de /eventos/bebidas: mismo problema y misma solución. Las cantidades
 * NO están acá, se derivan de las fórmulas reales del repo dentro de
 * src/lib/hubs/comida-evento.ts, que además documenta las contradicciones
 * entre las calculadoras absorbidas (torta, sushi, pizza, picada) y con qué
 * criterio se resolvieron.
 *
 * Lo que el hub resuelve y ninguna calc suelta hacía: REPARTE a los invitados
 * entre platos principales (para no comprar el triple), devuelve pizzas,
 * rolls, planchas y kilos en vez de porciones abstractas, y hace que entrada,
 * plato y postre cierren entre sí.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ComidaEventoExperience from '../../components/generated/ComidaEventoExperience.astro';
import {
  hub,
  REPARTO,
  APETITO,
  PIZZA_SLICES_ADULTO,
  PIZZA_SLICES_NINO,
  PORCIONES_PIZZA_GRANDE,
  SUSHI,
  PIEZAS_POR_ROLL,
  PICADA,
  CANAPES_PP,
  CANAPE_FACTOR_LARGO,
  CANAPE_VARIEDADES,
  MIGA_ADULTO,
  MIGA_NINO,
  MIGA_POR_PLANCHA,
  MIGA_POR_DOCENA,
  COFFEE,
  PORCION_TORTA_CM2,
  TORTA,
  HELADO_ML_PP,
  HELADO_FACTOR_CALOR,
  HELADO_FACTOR_FRIO,
  HELADO_FACTOR_NINOS,
  BOMBON,
  BOMBONES_PP,
  CHOCOLATE_G_POR_BOMBON,
  RELLENO_G_POR_BOMBON,
  POSTRE_PP,
} from '../../lib/hubs/comida-evento';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ComidaEventoExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    REPARTO,
    APETITO,
    PIZZA_SLICES_ADULTO,
    PIZZA_SLICES_NINO,
    PORCIONES_PIZZA_GRANDE,
    SUSHI,
    PIEZAS_POR_ROLL,
    PICADA,
    CANAPES_PP,
    CANAPE_FACTOR_LARGO,
    CANAPE_VARIEDADES,
    MIGA_ADULTO,
    MIGA_NINO,
    MIGA_POR_PLANCHA,
    MIGA_POR_DOCENA,
    COFFEE,
    PORCION_TORTA_CM2,
    TORTA,
    HELADO_ML_PP,
    HELADO_FACTOR_CALOR,
    HELADO_FACTOR_FRIO,
    HELADO_FACTOR_NINOS,
    BOMBON,
    BOMBONES_PP,
    CHOCOLATE_G_POR_BOMBON,
    RELLENO_G_POR_BOMBON,
    POSTRE_PP,
  }}
>
  (function () {
    const H = window.HC_HUB;

    // El desglose mezcla piezas, kilos, litros, centímetros y pesos: NINGUNA
    // fila puede quedar sin `format`, porque el runtime hace Object.assign y la
    // que no lo declara cae a pesos. La de plata lo declara igual, explícito.
    const U = (v, unit, decimals) => ({ v: v, format: 'unit', unit: unit, decimals: decimals || 0 });

    const n = (x, d) =>
      Number(x || 0).toLocaleString('es-AR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });

    /** Variedades de canapé según el tamaño del evento, tal como la fórmula. */
    function variedadesCanape(invitados) {
      let v = CANAPE_VARIEDADES[0].variedades;
      for (const paso of CANAPE_VARIEDADES) if (invitados >= paso.desde) v = paso.variedades;
      return v;
    }

    /** Duración del coffee break, en las categorías de su fórmula. */
    function tramoCoffee(horas) {
      if (horas <= 0.5) return 'corto';
      if (horas <= 1) return 'estandar';
      return 'extendido';
    }

    H.onCompute(function (v, kase) {
      const rama = (kase && kase.id) || 'cumple';
      const R = REPARTO[rama] || REPARTO.cumple;

      const invitados = Math.max(1, Math.round(v.invitados || 1));
      const ninos = Math.min(invitados, Math.max(0, Math.round(v.ninos || 0)));
      const adultos = invitados - ninos;
      const horas = Math.min(16, Math.max(0.5, v.horas || 1));
      const k = APETITO[v.apetito] || APETITO.normal;
      const postre = v.postre || 'torta';
      const clima = v.clima === 'calor' || v.clima === 'frio' ? v.clima : 'templado';
      const precioPersona = Math.max(0, v.precioPersona || 0);

      const rows = [];
      let piezas = 0;
      const partes = [];

      /* ── Postre: es igual en todas las ramas ───────────────────────────── */
      let porcionesTorta = 0, diametroTorta = 0, kgTorta = 0;
      let litrosHelado = 0, bombones = 0, kgChocolate = 0;

      if (postre !== 'no') {
        // Porciones por SUPERFICIE (método Wilton). Las capas suben los kilos,
        // no las porciones: por eso el diámetro sale de las porciones y los
        // kilos salen aparte, de la fórmula de la confitería.
        porcionesTorta = Math.ceil(invitados * POSTRE_PP);
        const areaCm2 = porcionesTorta * PORCION_TORTA_CM2[R.porcionTorta];
        diametroTorta = Math.ceil(2 * Math.sqrt(areaCm2 / Math.PI));
        kgTorta = (invitados * TORTA[R.tipoTorta].margen * TORTA[R.tipoTorta].gramos) / 1000;
      }
      if (postre === 'torta_helado') {
        const fClima = clima === 'calor' ? HELADO_FACTOR_CALOR : clima === 'frio' ? HELADO_FACTOR_FRIO : 1;
        const fNinos = ninos > 0 ? HELADO_FACTOR_NINOS : 1;
        litrosHelado = (invitados * HELADO_ML_PP[R.rolHelado] * fClima * fNinos) / 1000;
      }
      if (postre === 'mesa_dulce') {
        bombones = Math.ceil(invitados * BOMBONES_PP);
        kgChocolate = (bombones * CHOCOLATE_G_POR_BOMBON) / 1000;
      }

      /* ── Rama coffee break: su fórmula ya cubre todo el menú ───────────── */
      if (rama === 'coffee') {
        const C = COFFEE[tramoCoffee(horas) + '_manana'];
        const medialunas = Math.ceil(invitados * C.medialunasPP * k);
        const sandwiches = Math.ceil(invitados * C.sandwichesPP * k);
        const masas = Math.ceil(invitados * C.masasPP * k);
        const tortaBreak = Math.ceil(invitados * C.tortaPP * k);
        const frutasKg = invitados * C.frutasKgPP;
        const cafeL = invitados * C.cafeLPP;
        const jugoL = invitados * C.jugoLPP;

        piezas = medialunas + sandwiches + masas + tortaBreak + bombones;

        rows.push({ k: 'Piezas por persona', ref: tramoCoffee(horas) === 'corto' ? 'break de hasta 30 min' : tramoCoffee(horas) === 'estandar' ? 'break de 30 a 60 min' : 'break de 60 a 90 min', ...U(C.piezasPP * k, 'piezas', 1) });
        rows.push({ k: 'Medialunas y facturas', ref: 'la mitad de lo dulce', ...U(medialunas, 'u'), extra: true });
        rows.push({ k: 'Sándwiches mini', ref: 'todo lo salado del break', ...U(sandwiches, 'u'), extra: true });
        rows.push({ k: 'Masas secas y cookies', ref: 'el 30% de lo dulce', ...U(masas, 'u'), extra: true });
        rows.push({ k: 'Porciones de budín o torta', ref: 'el 20% de lo dulce', ...U(tortaBreak, 'porciones'), extra: true });
        if (frutasKg > 0) rows.push({ k: 'Fuente de frutas', ref: n(C.frutasKgPP * 1000) + ' g por persona', ...U(frutasKg, 'kg', 1) });
        rows.push({ k: 'Café', ref: n(C.cafeLPP * 1000) + ' ml por persona — un pocillo corto', ...U(cafeL, 'L', 1) });
        rows.push({ k: 'Jugos y agua', ref: n(C.jugoLPP * 1000) + ' ml por persona', ...U(jugoL, 'L', 1) });

        partes.push(medialunas + ' medialunas', sandwiches + ' sándwiches', masas + ' masas');

        // El budín/torta del break YA cubre el postre, así que no se suma otra
        // torta encima: sería contar dos veces. El helado y la mesa dulce sí se
        // agregan, porque son un renglón aparte que el break no trae.
        if (litrosHelado > 0) {
          rows.push({ k: 'Helado', ref: HELADO_ML_PP[R.rolHelado] + ' ml por persona · clima ' + clima, ...U(litrosHelado, 'L', 1), extra: true });
          partes.push(n(litrosHelado, 1) + ' L de helado');
        }
        if (postre === 'torta' || postre === 'torta_helado') {
          rows.push({ k: 'Torta aparte', ref: 'no hace falta: las ' + tortaBreak + ' porciones de budín del break ya son el postre', ...U(0, 'porciones') });
        }
        if (bombones > 0) {
          rows.push({ k: 'Bombones de la mesa dulce', ref: BOMBONES_PP + ' por invitado, de ' + BOMBON.pesoG + ' g', ...U(bombones, 'u'), extra: true });
          rows.push({ k: 'Chocolate cobertura a comprar', ref: n(CHOCOLATE_G_POR_BOMBON, 2) + ' g por bombón, con ' + BOMBON.mermaPct + '% de merma', ...U(kgChocolate, 'kg', 2) });
          partes.push(bombones + ' bombones');
        }
        rows.push({ k: 'Costo estimado de la comida', ref: '$' + n(precioPersona) + ' por persona', v: invitados * precioPersona, format: 'ars' });

        return {
          total: n(piezas) + ' piezas',
          sub: partes.join(' · ') + ' — para ' + invitados + ' asistentes en un break de ' + n(horas, 1) + ' h',
          format: 'plain',
          rows: rows,
          chart: [
            { label: 'Medialunas', value: medialunas, tone: 'main' },
            { label: 'Sándwiches', value: sandwiches, tone: 'prop' },
            { label: 'Masas secas', value: masas, tone: 'exit' },
            { label: 'Torta o budín', value: tortaBreak, tone: 'good' },
          ],
        };
      }

      /* ── Entrada: es para TODOS los que llegan a la mesa ───────────────── */
      // Acá la superposición es real y buscada: la picada y los canapés no se
      // reparten, se comparten.
      const comenPicada = adultos * R.picada;
      const P = PICADA[R.rolPicada];
      const gFiambre = comenPicada * P.fiambre * k;
      const gQueso = comenPicada * P.queso * k;
      const gAceitunas = comenPicada * P.aceitunas * k;

      const canapes = Math.ceil(
        invitados * R.canapes * CANAPES_PP[R.tipoCanape] * (horas > 2 ? CANAPE_FACTOR_LARGO : 1) * k
      );

      /* ── Plato principal: acá SÍ se reparten los invitados ─────────────── */
      // La misma persona no come pizza y sushi y sándwiches: cada porción de
      // invitados se computa con SU fórmula y las fracciones no se superponen.
      const aPizza = adultos * R.pizza, nPizza = ninos * R.pizza;
      const aSushi = adultos * R.sushi, nSushi = ninos * R.sushi;
      const aMiga = adultos * R.miga, nMiga = ninos * R.miga;
      const soloEntrada = invitados - (aPizza + nPizza + aSushi + nSushi + aMiga + nMiga);

      const slicesPizza = Math.ceil(
        (aPizza * PIZZA_SLICES_ADULTO[R.ocasionPizza] + nPizza * PIZZA_SLICES_NINO[R.ocasionPizza]) * k
      );
      const pizzas = Math.ceil(slicesPizza / PORCIONES_PIZZA_GRANDE);

      const S = SUSHI[R.nivelSushi];
      const piezasSushi = Math.ceil((aSushi * S.adulto + nSushi * S.nino) * S.reserva * k);
      const rolls = Math.ceil(piezasSushi / PIEZAS_POR_ROLL);

      const miga = Math.ceil((aMiga * MIGA_ADULTO[R.momentoMiga] + nMiga * MIGA_NINO[R.momentoMiga]) * k);
      const planchas = Math.ceil(miga / MIGA_POR_PLANCHA);

      /* ── Filas ─────────────────────────────────────────────────────────── */
      rows.push({
        k: 'Invitados repartidos entre platos',
        ref: adultos + ' adultos y ' + ninos + ' chicos · apetito ×' + n(k, 2),
        ...U(invitados, 'personas'),
      });

      if (gFiambre + gQueso > 0) {
        rows.push({ k: 'Fiambre de la picada', ref: P.fiambre + ' g por persona · rol ' + R.rolPicada, ...U(gFiambre / 1000, 'kg', 2), extra: true });
        rows.push({ k: 'Queso de la picada', ref: P.queso + ' g por persona', ...U(gQueso / 1000, 'kg', 2), extra: true });
        rows.push({ k: 'Aceitunas y encurtidos', ref: P.aceitunas + ' g por persona', ...U(gAceitunas / 1000, 'kg', 2) });
        partes.push(n((gFiambre + gQueso + gAceitunas) / 1000, 1) + ' kg de picada');
      }
      if (canapes > 0) {
        rows.push({
          k: 'Canapés',
          ref: n(CANAPES_PP[R.tipoCanape], 1) + ' por invitado' + (horas > 2 ? ' (×' + n(CANAPE_FACTOR_LARGO, 2) + ' por la duración)' : ''),
          ...U(canapes, 'u'),
          extra: true,
        });
        rows.push({ k: 'Variedades de canapé distintas', ref: 'menos variedad, menos consumo', ...U(variedadesCanape(invitados), 'variedades') });
        partes.push(canapes + ' canapés');
      }
      if (pizzas > 0) {
        rows.push({ k: 'Porciones de pizza', ref: n(PIZZA_SLICES_ADULTO[R.ocasionPizza], 1) + ' por adulto · para ' + Math.round(aPizza + nPizza) + ' invitados', ...U(slicesPizza, 'porciones') });
        rows.push({ k: 'Pizzas grandes a encargar', ref: PORCIONES_PIZZA_GRANDE + ' porciones cada una', ...U(pizzas, 'pizzas'), extra: true });
        partes.push(pizzas + ' pizzas');
      }
      if (rolls > 0) {
        rows.push({ k: 'Piezas de sushi', ref: n(S.adulto) + ' por adulto +' + Math.round((S.reserva - 1) * 100) + '% · para ' + Math.round(aSushi + nSushi) + ' invitados', ...U(piezasSushi, 'piezas') });
        rows.push({ k: 'Rolls a encargar', ref: PIEZAS_POR_ROLL + ' piezas por roll', ...U(rolls, 'rolls'), extra: true });
        partes.push(rolls + ' rolls');
      }
      if (miga > 0) {
        rows.push({ k: 'Sándwiches de miga', ref: n(MIGA_ADULTO[R.momentoMiga], 1) + ' por adulto · ' + n(miga / MIGA_POR_DOCENA, 1) + ' docenas', ...U(miga, 'u') });
        rows.push({ k: 'Planchas de miga', ref: MIGA_POR_PLANCHA + ' sándwiches por plancha', ...U(planchas, 'planchas'), extra: true });
        partes.push(planchas + ' planchas de miga');
      }
      if (soloEntrada > 0.5) {
        rows.push({ k: 'Se quedan sólo con la entrada', ref: 'no comen plato principal: por eso no se suman las calculadoras', ...U(Math.round(soloEntrada), 'personas') });
      }

      if (porcionesTorta > 0) {
        rows.push({ k: 'Porciones de torta', ref: n(PORCION_TORTA_CM2[R.porcionTorta], 2) + ' cm² por porción · método Wilton', ...U(porcionesTorta, 'porciones') });
        rows.push({ k: 'Diámetro de torta redonda', ref: 'sumar capas NO agrega porciones, agrega kilos', ...U(diametroTorta, 'cm'), extra: true });
        rows.push({ k: 'Kilos de torta a encargar', ref: TORTA[R.tipoTorta].gramos + ' g por porción + ' + Math.round((TORTA[R.tipoTorta].margen - 1) * 100) + '% de margen', ...U(kgTorta, 'kg', 2), extra: true });
        partes.push(n(kgTorta, 1) + ' kg de torta');
      }
      if (litrosHelado > 0) {
        rows.push({ k: 'Helado', ref: HELADO_ML_PP[R.rolHelado] + ' ml por persona · clima ' + clima + (ninos > 0 ? ' · ×' + n(HELADO_FACTOR_NINOS, 2) + ' por los chicos' : ''), ...U(litrosHelado, 'L', 1), extra: true });
        partes.push(n(litrosHelado, 1) + ' L de helado');
      }
      if (bombones > 0) {
        rows.push({ k: 'Bombones de la mesa dulce', ref: BOMBONES_PP + ' por invitado, de ' + BOMBON.pesoG + ' g con ' + BOMBON.rellenoPct + '% de relleno', ...U(bombones, 'u'), extra: true });
        rows.push({ k: 'Chocolate cobertura a comprar', ref: n(CHOCOLATE_G_POR_BOMBON, 2) + ' g por bombón, con ' + BOMBON.mermaPct + '% de merma', ...U(kgChocolate, 'kg', 2) });
        rows.push({ k: 'Relleno de los bombones', ref: n(RELLENO_G_POR_BOMBON, 1) + ' g por pieza — ganache, dulce de leche o praliné', ...U((bombones * RELLENO_G_POR_BOMBON) / 1000, 'kg', 2) });
        partes.push(bombones + ' bombones');
      }

      piezas = slicesPizza + piezasSushi + miga + canapes + porcionesTorta + bombones;

      rows.push({ k: 'Costo estimado de la comida', ref: '$' + n(precioPersona) + ' por persona', v: invitados * precioPersona, format: 'ars' });

      const chart = [
        { label: 'Comen pizza', value: Math.round(aPizza + nPizza), tone: 'main' },
        { label: 'Comen sushi', value: Math.round(aSushi + nSushi), tone: 'exit' },
        { label: 'Comen sándwiches de miga', value: Math.round(aMiga + nMiga), tone: 'prop' },
        { label: 'Sólo entrada y postre', value: Math.max(0, Math.round(soloEntrada)), tone: 'good' },
      ].filter(function (s) { return s.value > 0; });

      return {
        total: n(piezas) + ' piezas',
        sub:
          partes.join(' · ') + ' — para ' + invitados + ' invitados' +
          (ninos ? ' (' + ninos + ' chicos)' : '') + ' durante ' + n(horas, 1) + ' h',
        format: 'plain',
        rows: rows,
        chart: chart,
      };
    });
  })();
</script>
