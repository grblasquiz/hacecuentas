---
/**
 * Hub de decisión — "¿Cuánta comida compro para la fiesta?"
 * Reemplaza 15 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (4 ramas, `cases`).
 * Hermano de /eventos/bebidas: mismo problema y misma solución. Las cantidades
 * NO están acá, se derivan de las fórmulas reales del repo dentro de
 * src/lib/hubs/comida-evento.ts, que además documenta las contradicciones
 * entre las calculadoras absorbidas (torta, sushi, pizza, picada) y con qué
 * criterio se resolvieron.
 *
 * Lo que el hub resuelve y ninguna calc suelta hacía: REPARTE a los invitados
 * entre platos principales (para no comprar el triple), devuelve pizzas,
 * rolls, planchas y kilos en vez de porciones abstractas, y hace que entrada,
 * plato y postre cierren entre sí.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ComidaEventoExperience from '../../components/generated/ComidaEventoExperience.astro';
import {
  hub,
  REPARTO,
  APETITO,
  PIZZA_SLICES_ADULTO,
  PIZZA_SLICES_NINO,
  PORCIONES_PIZZA_GRANDE,
  SUSHI,
  PIEZAS_POR_ROLL,
  PICADA,
  CANAPES_PP,
  CANAPE_FACTOR_LARGO,
  CANAPE_VARIEDADES,
  MIGA_ADULTO,
  MIGA_NINO,
  MIGA_POR_PLANCHA,
  MIGA_POR_DOCENA,
  COFFEE,
  PORCION_TORTA_CM2,
  TORTA,
  HELADO_ML_PP,
  HELADO_FACTOR_CALOR,
  HELADO_FACTOR_FRIO,
  HELADO_FACTOR_NINOS,
  BOMBON,
  BOMBONES_PP,
  CHOCOLATE_G_POR_BOMBON,
  RELLENO_G_POR_BOMBON,
  POSTRE_PP,
} from '../../lib/hubs/comida-evento';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <ComidaEventoExperience data={hub} />
  <Footer />
</Layout>

