---
/**
 * Hub de decisión — "¿Cuánto de cada cosa para N tragos?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cinco tragos de coctelería + hidromiel + almíbar. Los
 * cinco primeros comparten la misma mecánica (ml por trago × tragos, compra con
 * 15% de margen); hidromiel y almíbar tienen su propia matemática pero la misma
 * pregunta: qué proporción de cada cosa.
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TragosExperience from '../../components/generated/TragosExperience.astro';
import {
  hub, TRAGOS, MARGEN_COMPRA, CLARA_ML_POR_TRAGO, CLARA_ML_POR_HUEVO,
  MENTA_HOJAS_POR_TRAGO, MENTA_HOJAS_POR_ATADO,
  FG_HIDROMIEL, MIEL_APORTE_OG, MIEL_DESPLAZAMIENTO, ABV_DIVISOR, ALMIBAR,
} from '../../lib/hubs/tragos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <TragosExperience data={hub} />
  <Footer />
</Layout>

