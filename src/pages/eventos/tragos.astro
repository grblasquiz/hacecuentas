---
/**
 * Hub de decisión — "¿Cuánto de cada cosa para N tragos?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cinco tragos de coctelería + hidromiel + almíbar. Los
 * cinco primeros comparten la misma mecánica (ml por trago × tragos, compra con
 * 15% de margen); hidromiel y almíbar tienen su propia matemática pero la misma
 * pregunta: qué proporción de cada cosa.
 *
 * Nada de lo que sale acá es plata: cada fila declara `format` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub, TRAGOS, MARGEN_COMPRA, CLARA_ML_POR_TRAGO, CLARA_ML_POR_HUEVO,
  MENTA_HOJAS_POR_TRAGO, MENTA_HOJAS_POR_ATADO,
  FG_HIDROMIEL, MIEL_APORTE_OG, MIEL_DESPLAZAMIENTO, ABV_DIVISOR, ALMIBAR,
} from '../../lib/hubs/tragos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    TRAGOS, MARGEN_COMPRA, CLARA_ML_POR_TRAGO, CLARA_ML_POR_HUEVO,
    MENTA_HOJAS_POR_TRAGO, MENTA_HOJAS_POR_ATADO,
    FG_HIDROMIEL, MIEL_APORTE_OG, MIEL_DESPLAZAMIENTO, ABV_DIVISOR, ALMIBAR,
  }}
>
  (function () {
    const H = window.HC_HUB;

    const n1 = (x, d) => Number(x || 0).toLocaleString('es-AR', {
      minimumFractionDigits: d == null ? 0 : d,
      maximumFractionDigits: d == null ? 0 : d,
    });

    // 0 en un campo de ml = "usá la medida clásica de esta receta".
    const orDefault = (userVal, clasico) => {
      const n = Number(userVal);
      return n > 0 ? n : clasico;
    };

    // ---------- RAMAS 1-5: coctelería ----------
    function calcTrago(v, id) {
      const R = TRAGOS[id] || TRAGOS.gintonic;
      const personas = Math.max(1, Number(v.personas) || 1);
      const tpp = Math.max(1, Number(v.tragosPorPersona) || 1);
      const tragos = personas * tpp;

      const mlAlc = orDefault(v.mlAlcohol, R.alcohol.ml);
      const mlMez = R.mezclador ? orDefault(v.mlMezclador, R.mezclador.ml) : 0;
      const mlCit = R.citrico ? orDefault(v.mlCitrico, R.citrico.ml) : 0;
      const mlJar = R.jarabe ? orDefault(v.mlJarabe, R.jarabe.ml) : 0;

      const totAlc = mlAlc * tragos;
      const totMez = mlMez * tragos;
      const totCit = mlCit * tragos;
      const totJar = mlJar * tragos;

      // Compra con margen y botellas: idéntico a las fórmulas originales.
      const compraAlc = Math.ceil(totAlc * MARGEN_COMPRA);
      const botAlc = Math.ceil(compraAlc / R.alcohol.botellaMl);

      const rows = [
        { k: R.alcohol.nombre + ' — total neto', ref: n1(mlAlc, 0) + ' ml por trago', v: totAlc, format: 'unit', unit: 'ml', decimals: 0, extra: true },
        { k: R.alcohol.nombre + ' — comprar', ref: 'con 15% de margen', v: compraAlc, format: 'unit', unit: 'ml', decimals: 0 },
        { k: 'Botellas de ' + R.alcohol.nombre.toLowerCase(), ref: 'de ' + R.alcohol.botellaMl + ' ml', v: botAlc, format: 'unit', unit: 'botellas', decimals: 0, extra: true },
      ];

      const chart = [
        { label: R.alcohol.nombre, value: Math.round(totAlc), tone: 'main' },
      ];

      if (R.mezclador) {
        rows.push({ k: R.mezclador.nombre + ' — total', ref: n1(mlMez, 0) + ' ml por trago', v: totMez, format: 'unit', unit: 'ml', decimals: 0 });
        if (R.mezclador.botellaMl) {
          const botMez = Math.ceil(totMez * MARGEN_COMPRA / R.mezclador.botellaMl);
          rows.push({ k: 'Botellas de ' + R.mezclador.nombre.toLowerCase(), ref: 'de ' + R.mezclador.botellaMl + ' ml, con margen', v: botMez, format: 'unit', unit: 'botellas', decimals: 0, extra: true });
        }
        chart.push({ label: R.mezclador.nombre, value: Math.round(totMez), tone: 'prop' });
      }

      if (R.citrico) {
        const frutas = Math.ceil(totCit / R.citrico.mlPorFruta);
        rows.push({ k: R.citrico.nombre + ' — total', ref: n1(mlCit, 0) + ' ml por trago', v: totCit, format: 'unit', unit: 'ml', decimals: 0 });
        rows.push({ k: R.citrico.fruta + ' a comprar', ref: R.citrico.mlPorFruta + ' ml de jugo cada una', v: frutas, format: 'plain', decimals: 0, extra: true });
        chart.push({ label: R.citrico.nombre, value: Math.round(totCit), tone: 'good' });
      }

      if (R.jarabe) {
        rows.push({ k: R.jarabe.nombre + ' — total', ref: n1(mlJar, 0) + ' ' + R.jarabe.unidad + ' por trago', v: totJar, format: 'unit', unit: R.jarabe.unidad, decimals: 0 });
        chart.push({ label: R.jarabe.nombre, value: Math.round(totJar), tone: 'warn' });
      }

      // Extras propios de cada trago, con los mismos rendimientos de las fórmulas viejas.
      let extraTexto = '';
      if (id === 'pisco') {
        const totClara = CLARA_ML_POR_TRAGO * tragos;
        const huevos = Math.ceil(totClara / CLARA_ML_POR_HUEVO);
        rows.push({ k: 'Clara de huevo — total', ref: CLARA_ML_POR_TRAGO + ' ml por trago', v: totClara, format: 'unit', unit: 'ml', decimals: 0 });
        rows.push({ k: 'Huevos para la clara', ref: CLARA_ML_POR_HUEVO + ' ml de clara cada uno', v: huevos, format: 'plain', decimals: 0, extra: true });
        chart.push({ label: 'Clara de huevo', value: Math.round(totClara), tone: 'exit' });
        extraTexto = ' · ' + huevos + (huevos === 1 ? ' huevo' : ' huevos') + ' para la clara (¡cruda: usá pasteurizado o aquafaba!)';
      }
      if (id === 'mojito') {
        const hojas = MENTA_HOJAS_POR_TRAGO * tragos;
        const atados = Math.ceil(hojas / MENTA_HOJAS_POR_ATADO);
        rows.push({ k: 'Hojas de menta', ref: MENTA_HOJAS_POR_TRAGO + ' por trago', v: hojas, format: 'plain', decimals: 0 });
        rows.push({ k: 'Atados grandes de menta', ref: MENTA_HOJAS_POR_ATADO + ' hojas por atado', v: atados, format: 'plain', decimals: 0, extra: true });
        extraTexto = ' · ' + atados + (atados === 1 ? ' atado' : ' atados') + ' de menta';
      }
      if (R.deco) {
        const deco = Math.ceil(tragos / R.deco.cadaNTragos);
        rows.push({ k: R.deco.nombre + ' para decorar', ref: 'uno cada ' + R.deco.cadaNTragos + ' tragos', v: deco, format: 'plain', decimals: 0 });
        extraTexto = ' · ' + deco + ' ' + R.deco.nombre.toLowerCase();
      }

      const hielo = personas * R.hieloKgPorPersona;
      rows.push({ k: 'Hielo', ref: n1(R.hieloKgPorPersona, 1) + ' kg por persona', v: hielo, format: 'unit', unit: 'kg', decimals: 1, extra: true });
      rows.push({ k: 'Tragos totales', ref: personas + ' × ' + tpp, v: tragos, format: 'plain', decimals: 0 });

      const mlTotal = totAlc + totMez + totCit + (R.jarabe && R.jarabe.unidad === 'ml' ? totJar : 0);

      return {
        total: n1(tragos, 0) + (tragos === 1 ? ' trago' : ' tragos'),
        sub:
          R.nombre + ' para ' + personas + (personas === 1 ? ' persona' : ' personas') + ': ' +
          n1(mlTotal / 1000, 2) + ' L de mezcla, ' + botAlc + (botAlc === 1 ? ' botella' : ' botellas') +
          ' de ' + R.alcohol.nombre.toLowerCase() + ' y ' + n1(hielo, 1) + ' kg de hielo' + extraTexto +
          ' · la compra ya incluye un 15% de margen',
        rows: rows,
        chart: chart,
        format: 'plain',
        decimals: 0,
      };
    }

    // ---------- RAMA 6: hidromiel ----------
    function calcHidromiel(v) {
      const litros = Math.max(1, Number(v.volumenFinal) || 10);
      const abv = Math.max(1, Number(v.abvObjetivo) || 12);
      const estilo = String(v.estilo || 'medium');
      const fg = FG_HIDROMIEL[estilo] != null ? FG_HIDROMIEL[estilo] : 1;

      const og = fg + abv / ABV_DIVISOR;
      const kgMiel = ((og - 1) * litros) / MIEL_APORTE_OG;
      const litrosAgua = Math.max(0, litros - kgMiel * MIEL_DESPLAZAMIENTO);
      const volMiel = Math.max(0, litros - litrosAgua);

      const levadura =
        abv > 15 ? 'Lalvin EC-1118 (champagne, tolera hasta 18%)'
        : (estilo === 'sweet' || estilo === 'dessert') ? 'Wyeast 4184 Sweet Mead (deja dulzor residual)'
        : abv > 12 ? 'Lalvin D-47 (compleja, frutal)'
        : 'Lalvin 71B (suave, versátil)';

      const rows = [
        { k: 'Miel', ref: 'para ' + n1(litros, 0) + ' L a ' + n1(abv, 1) + '% ABV', v: kgMiel, format: 'unit', unit: 'kg', decimals: 2, extra: true },
        { k: 'Agua', ref: 'descontando lo que ocupa la miel', v: litrosAgua, format: 'unit', unit: 'L', decimals: 2, extra: true },
        { k: 'Densidad inicial (OG)', ref: 'FG + ABV ÷ 131,25', v: og, format: 'plain', decimals: 3 },
        { k: 'Densidad final (FG)', ref: 'estilo elegido', v: fg, format: 'plain', decimals: 3 },
        { k: 'Volumen que ocupa la miel', ref: '0,7 L por kg', v: volMiel, format: 'unit', unit: 'L', decimals: 2 },
        { k: 'Miel por litro de mosto', ref: 'referencia', v: kgMiel / litros, format: 'unit', unit: 'kg/L', decimals: 3 },
        { k: 'Alcohol objetivo', ref: 'lo que buscás', v: abv, format: 'unit', unit: '% ABV', decimals: 1 },
      ];

      return {
        total: n1(kgMiel, 2) + ' kg de miel',
        sub:
          'Para ' + n1(litros, 0) + ' L a ~' + n1(abv, 1) + '% ABV: ' + n1(kgMiel, 2) + ' kg de miel en ' +
          n1(litrosAgua, 2) + ' L de agua, OG ' + n1(og, 3) + ' y FG esperada ' + n1(fg, 3) +
          ' · levadura sugerida: ' + levadura +
          (abv > 15 ? ' · a este alcohol hace falta nutriente en etapas para que termine' : ''),
        rows: rows,
        chart: [
          { label: 'Agua', value: Number(litrosAgua.toFixed(2)), tone: 'prop' },
          { label: 'Miel (volumen)', value: Number(volMiel.toFixed(2)), tone: 'main' },
        ],
        format: 'plain',
        decimals: 2,
      };
    }

    // ---------- RAMA 7: almíbar ----------
    function calcAlmibar(v) {
      const modo = String(v.modoAlmibar || 'azucar');
      const cantidad = Math.max(1, Number(v.cantidadAlmibar) || 500);
      const cfg = ALMIBAR[String(v.tipoAlmibar || 'medio')] || ALMIBAR.medio;

      const densidad = 1 + 0.005 * cfg.brix;
      const azucar = modo === 'volumen' ? cantidad * densidad * (cfg.brix / 100) : cantidad;
      const agua = azucar * cfg.ratioAgua;
      const masaFinal = azucar / (cfg.brix / 100);
      const volumen = masaFinal / densidad;

      const rows = [
        { k: 'Azúcar', ref: cfg.label, v: azucar, format: 'unit', unit: 'g', decimals: 1, extra: true },
        { k: 'Agua', ref: n1(cfg.ratioAgua, 2) + ' ml por gramo de azúcar', v: agua, format: 'unit', unit: 'ml', decimals: 1, extra: true },
        { k: 'Rinde', ref: 'almíbar terminado', v: volumen, format: 'unit', unit: 'ml', decimals: 0, extra: true },
        { k: 'Concentración final', ref: 'azúcar sobre el peso total', v: cfg.brix, format: 'unit', unit: '°Brix', decimals: 1 },
        { k: 'Peso del almíbar terminado', ref: 'azúcar ÷ Brix', v: masaFinal, format: 'unit', unit: 'g', decimals: 0 },
        { k: 'Densidad aproximada', ref: '1 + 0,005 × Brix', v: densidad, format: 'unit', unit: 'g/ml', decimals: 3 },
      ];

      return {
        total: n1(azucar, 0) + ' g + ' + n1(agua, 0) + ' ml',
        sub:
          'Para ' + cfg.label + ': ' + n1(azucar, 1) + ' g de azúcar y ' + n1(agua, 1) + ' ml de agua, que rinden unos ' +
          n1(volumen, 0) + ' ml a ' + n1(cfg.brix, 0) + ' °Brix · cociná hasta ' + cfg.temp +
          ' · una vez que hierve no lo revuelvas: cristaliza',
        rows: rows,
        chart: [
          { label: 'Azúcar (g)', value: Math.round(azucar), tone: 'main' },
          { label: 'Agua (ml)', value: Math.round(agua), tone: 'prop' },
        ],
        format: 'plain',
        decimals: 0,
      };
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'gintonic';
      if (id === 'hidromiel') return calcHidromiel(v);
      if (id === 'almibar') return calcAlmibar(v);
      return calcTrago(v, id);
    });
  })();
</script>
