---
/**
 * Hub de decisión — "¿Cuánta bebida compro para la fiesta?"
 * Reemplaza 11 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (4 ramas, `cases`).
 * Los consumos NO están acá: se derivan de las fórmulas reales del repo
 * (cerveza-invitado-evento, vino-por-invitado-*, fernet-cola-*, whisky-*,
 * gaseosa-*, agua-*, bebidas-evento-*) dentro de src/lib/hubs/bebidas-evento.ts.
 *
 * Lo que el hub resuelve y ninguna calc suelta hacía: reparte a los tomadores
 * entre bebidas (para no comprar el triple), devuelve BOTELLAS y packs en vez
 * de litros abstractos, y suma el hielo.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import BebidasEventoExperience from '../../components/generated/BebidasEventoExperience.astro';
import {
  hub,
  RAMAS,
  CERVEZA_LH,
  FACTOR_VERANO,
  LATA_CERVEZA_ML,
  HIELO_POR_LITRO_CERVEZA,
  CAJON_U,
  VINO,
  COPAS_POR_BOTELLA,
  BOTELLA_VINO_L,
  VASO_FERNET_ML,
  FERNET_PCT,
  BOTELLA_FERNET_L,
  BOTELLA_COLA_L,
  WHISKY_MEDIDAS_PP,
  WHISKY_FACTOR_LARGO,
  WHISKY_FACTOR_CORTO,
  MEDIDA_WHISKY_ML,
  BOTELLA_DESTILADO_L,
  MARGEN_WHISKY,
  GASEOSA_NINO_L,
  GASEOSA_ADULTO_L,
  GASEOSA_FACTOR_LARGO,
  GASEOSA_FACTOR_CORTO,
  BOTELLA_GASEOSA_L,
  AGUA_PP,
  AGUA_FACTOR_LARGO,
  BOTELLA_AGUA_L,
  BIDON_L,
  PERSONAS_POR_KG_HIELO,
} from '../../lib/hubs/bebidas-evento';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <BebidasEventoExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

