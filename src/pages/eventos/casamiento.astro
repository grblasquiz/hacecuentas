---
/**
 * Hub de decisión — "¿Cuánto cuesta casarse?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta compute(). Todos los números vienen de
 * src/lib/hubs/casamiento.ts, que a su vez los deriva de las fórmulas reales.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, CASAMIENTO_MATH } from '../../lib/hubs/casamiento';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ M: CASAMIENTO_MATH }}>
  (function () {
    const H = window.HC_HUB;

    H.onCompute(function (v, kase) {
      const caso = (kase && kase.id) || 'fiesta';

      const nivel = M.cubierto[v.nivel] ? v.nivel : 'medio';
      const musicaId = M.musica[v.musica] ? v.musica : 'dj';
      const inv = Math.max(20, Math.round(v.invitados || 0));
      const sueldo = Math.max(0, v.sueldo || 0);

      // Espejo de costo-boda-argentina.ts: salón variable + cinco rubros fijos.
      const cubierto = M.cubierto[nivel];
      const fij = M.fijos[nivel];
      const salon = inv * cubierto;
      const musica = M.musica[musicaId];
      const fijosTotal = musica + fij.foto + fij.decoracion + fij.torta + fij.varios;
      const total = salon + fijosTotal;
      const porInvitado = Math.round(total / inv);
      const nivelLabel = nivel === 'basico' ? 'básico' : nivel === 'premium' ? 'premium' : 'estándar';

      /* ── El anillo ─────────────────────────────────────────────────── */
      if (caso === 'anillo') {
        const sueldos = M.anilloSueldos[v.regla] || M.anilloSueldos['2meses'];
        const precio = sueldo * sueldos;
        const chart = [];
        for (let i = 0; i < sueldos; i++) {
          chart.push({ label: 'Sueldo ' + (i + 1), value: sueldo, tone: i === 0 ? 'main' : i === 1 ? 'exit' : 'prop' });
        }
        return {
          total: H.ars(precio),
          sub:
            sueldos + (sueldos === 1 ? ' sueldo' : ' sueldos') + ' de ' + H.ars(sueldo) +
            ' · con lab-grown o moissanita, entre ' + H.ars(precio * (1 - M.anilloAhorro.max)) +
            ' y ' + H.ars(precio * (1 - M.anilloAhorro.min)),
          rows: [
            { k: 'Presupuesto del anillo', ref: 'regla elegida', v: precio },
            { k: 'Sueldos que representa', v: sueldos, format: 'unit', unit: sueldos === 1 ? 'sueldo' : 'sueldos' },
            { k: 'Mismo anillo en lab-grown o moissanita (ahorro máximo)', v: precio * (1 - M.anilloAhorro.max), extra: true },
            { k: 'Lo que te ahorrás con la piedra de laboratorio', v: precio * M.anilloAhorro.max },
            { k: 'Cubiertos de la fiesta que equivale', ref: 'nivel ' + nivelLabel, v: precio / cubierto, format: 'unit', unit: 'invitados', decimals: 1 },
            { k: 'Cuánto pesa sobre el total de la boda', v: total > 0 ? (precio / total) * 100 : 0, format: 'unit', unit: '%', decimals: 1 },
          ],
          chart: chart,
        };
      }

      /* ── Cuánto me cuesta cada invitado ────────────────────────────── */
      if (caso === 'por-invitado') {
        return {
          total: H.ars(porInvitado),
          sub:
            'Promedio con ' + inv + ' invitados · el que sacás de la lista ahorra ' + H.ars(cubierto) +
            ' · fijos ' + H.ars(fijosTotal),
          rows: [
            { k: 'Costo promedio por invitado', v: porInvitado },
            { k: 'Costo real de sumar (o sacar) un invitado', ref: 'salón + catering', v: cubierto, extra: true },
            { k: 'Lo que ahorrás si recortás 10 invitados', v: cubierto * 10 },
            { k: 'Costos fijos: no bajan aunque recortes la lista', v: fijosTotal },
            { k: 'Parte fija que carga cada invitado', v: fijosTotal / inv },
            { k: 'Total de la fiesta', v: total },
          ],
          chart: [
            { label: 'Cubiertos (crece con la lista)', value: salon, tone: 'main' },
            { label: 'Costos fijos (no se mueven)', value: fijosTotal, tone: 'prop' },
          ],
        };
      }

      /* ── Soy invitado: cuánto regalo ───────────────────────────────── */
      if (caso === 'invitado') {
        const tabla = M.regaloRatio[v.relacion] || M.regaloRatio.amigo;
        const ratio = tabla[nivel];
        const bruto = cubierto * ratio;
        const tope = sueldo * M.regaloTope;
        const topeado = sueldo > 0 && bruto > tope;
        const regalo = topeado ? tope : bruto;
        const pctSueldo = sueldo > 0 ? (regalo / sueldo) * 100 : 0;
        const chart = regalo <= cubierto
          ? [
              { label: 'Lo que ponés vos', value: regalo, tone: 'main' },
              { label: 'Lo que queda a cargo de la pareja', value: cubierto - regalo, tone: 'prop' },
            ]
          : [
              { label: 'Tu cubierto', value: cubierto, tone: 'main' },
              { label: 'Lo que ponés por encima del cubierto', value: regalo - cubierto, tone: 'good' },
            ];
        return {
          total: H.ars(regalo),
          sub:
            'Cubierto de una boda ' + nivelLabel + ': ' + H.ars(cubierto) +
            ' · tu vínculo lo multiplica por ' + ratio.toLocaleString('es-AR', { maximumFractionDigits: 2 }) +
            (topeado ? ' · recortado al ' + Math.round(M.regaloTope * 100) + '% de tu sueldo' : ''),
          rows: [
            { k: 'Regalo sugerido', v: regalo },
            { k: 'Lo que le cuesta a la pareja tu lugar en la mesa', ref: 'nivel ' + nivelLabel, v: cubierto },
            { k: 'Múltiplo por el vínculo', v: ratio, format: 'unit', unit: 'veces el cubierto', decimals: 2 },
            { k: 'Qué porcentaje de tu sueldo es', v: pctSueldo, format: 'unit', unit: '%', decimals: 1 },
            { k: 'Tope del ' + Math.round(M.regaloTope * 100) + '% del sueldo', v: tope, extra: topeado },
          ],
          chart: chart,
        };
      }

      /* ── Cuándo conviene la fecha ──────────────────────────────────── */
      if (caso === 'fecha') {
        const tabla = M.fechas[v.evitar === 'no' ? 'no' : 'si'];
        const idx = Math.min(11, Math.max(0, (Number(v.mes) || 10) - 1));
        const f = tabla[idx];
        const dif = f.promedio - M.fechaRango.max;
        return {
          total: f.mejorPuntaje + ' / 100',
          format: 'plain',
          sub: 'Mejor sábado de ' + M.meses[idx] + ': ' + f.mejorFecha + (f.nota ? ' — ' + f.nota : ''),
          rows: [
            { k: 'Puntaje del mejor sábado del mes', v: f.mejorPuntaje, format: 'plain' },
            { k: 'Puntaje promedio del mes', v: f.promedio, format: 'plain', decimals: 1 },
            { k: 'Sábados disponibles en el mes', v: f.sabados, format: 'unit', unit: f.sabados === 1 ? 'sábado' : 'sábados' },
            { k: 'Diferencia contra el mejor mes del año', v: dif, format: 'plain', decimals: 1, extra: dif < 0 },
            { k: 'Techo del año', v: M.fechaRango.max, format: 'plain', decimals: 1 },
          ],
          chart: [
            { label: 'Puntaje que logra el mes', value: Math.max(0, f.mejorPuntaje), tone: 'good' },
            { label: 'Lo que le falta para el ideal', value: Math.max(0, 100 - f.mejorPuntaje), tone: 'bad' },
          ],
        };
      }

      /* ── La fiesta entera (caso por defecto) ───────────────────────── */
      const musicaLabel = musicaId === 'banda' ? 'banda en vivo' : musicaId === 'ambos' ? 'banda y DJ' : 'DJ';
      return {
        total: H.ars(total),
        sub:
          inv + ' invitados · nivel ' + nivelLabel + ' con ' + musicaLabel +
          ' · ' + H.ars(porInvitado) + ' por invitado',
        rows: [
          { k: 'Salón y catering', ref: H.ars(cubierto) + ' por invitado', v: salon },
          { k: 'Música (' + musicaLabel + ')', v: musica },
          { k: 'Foto y video', v: fij.foto },
          { k: 'Decoración', v: fij.decoracion },
          { k: 'Torta y mesa dulce', v: fij.torta },
          { k: 'Varios: civil, invitaciones, souvenirs', v: fij.varios },
          { k: 'Costo por invitado', v: porInvitado, extra: true },
        ],
        chart: [
          { label: 'Salón y catering', value: salon, tone: 'main' },
          { label: 'Música', value: musica, tone: 'exit' },
          { label: 'Foto y video', value: fij.foto, tone: 'prop' },
          { label: 'Decoración', value: fij.decoracion, tone: 'good' },
          { label: 'Torta y mesa dulce', value: fij.torta, tone: 'warn' },
          { label: 'Varios', value: fij.varios, tone: 'bad' },
        ],
      };
    });
  })();
</script>
