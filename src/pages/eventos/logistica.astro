---
/**
 * Hub de decisión — "¿Cuántas mesas, sillas, meseros y cosas necesito para la fiesta?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo: ramificado (6 ramas, `cases`).
 * Las ratios NO están acá: se derivan de las fórmulas reales del repo
 * (sillas-mesas-invitados, meseros-necesarios-invitados, vajilla-alquiler-invitados,
 * cotillon-cumple-personas, globos-decoracion-salon-metros, invitaciones-cumple-numero,
 * regalos-invitado-souvenir, karaoke-canciones-por-hora, playlist-duracion-canciones)
 * dentro de src/lib/hubs/logistica-evento.ts.
 *
 * La comida y la bebida viven en /eventos/comida y /eventos/bebidas: acá va todo
 * lo que no se come ni se toma.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LogisticaEventosExperience from '../../components/generated/LogisticaEventosExperience.astro';
import {
  hub,
  RAMAS,
  PERSONAS_POR_MESA,
  MARGEN_SILLAS,
  SILLA_REL,
  PRECIO_MESA_REL,
  INVITADOS_POR_MOZO,
  INVITADOS_POR_BARTENDER,
  MAITRE_DESDE,
  MOZO_REL,
  BARTENDER_REL,
  MAITRE_REL,
  VAJILLA_PP,
  PIEZA_REL,
  COTILLON_PP,
  COTILLON_REL,
  GLOBOS_POR_METRO,
  PCT_GLOBOS_12,
  GLOBO_REL,
  INVITACIONES_PP,
  INVITACION_REL,
  ANTICIPACION_CHICA,
  ANTICIPACION_GRANDE,
  UMBRAL_ANTICIPACION,
  SOUVENIR_PP,
  CANCION_MIN,
  TRANSICION_MIN,
} from '../../lib/hubs/logistica-evento';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <LogisticaEventosExperience data={hub} />
  <Footer />
</Layout>

