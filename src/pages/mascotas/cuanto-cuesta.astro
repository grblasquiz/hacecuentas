---
/**
 * Hub de decisión — "¿Cuánto sale por mes tener un perro o un gato?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces), incluida la de
 * arena sanitaria que había quedado huérfana.
 *
 * Arquetipo ramificado: perro y gato. La página sólo aporta datos
 * (src/lib/hubs/costo-mascota.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CuantoCuestaMascotaExperience from '../../components/generated/CuantoCuestaMascotaExperience.astro';
import { hub, BASE, CALIDAD, CONSULTA, AJUSTE_ESPECIE_VET, ARENAS, FACTOR_GATO_EXTRA } from '../../lib/hubs/costo-mascota';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CuantoCuestaMascotaExperience data={hub} />
  <Footer />
</Layout>

