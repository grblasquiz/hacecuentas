---
/**
 * Hub de decisión — "¿Cuánta comida le doy a mi mascota?"
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: cada caso es una especie. La página sólo aporta datos
 * (src/lib/hubs/cuanta-comida-mascota.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, FACTORES, AJUSTE_TAMANO, DENSIDAD, CONEJO, TORTUGA } from '../../lib/hubs/cuanta-comida-mascota';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ FACTORES, AJUSTE_TAMANO, DENSIDAD, CONEJO, TORTUGA }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay pesos: TODAS las filas declaran su formato.
    const G = { format: 'unit', unit: 'g', decimals: 0 };
    const G1 = { format: 'unit', unit: 'g', decimals: 1 };
    const KCAL = { format: 'unit', unit: 'kcal', decimals: 0 };
    const ML = { format: 'unit', unit: 'ml', decimals: 0 };
    const DIAS = { format: 'unit', unit: 'días', decimals: 0 };
    const VECES = { format: 'unit', unit: 'por día', decimals: 0 };
    const KG1 = { format: 'unit', unit: 'kg', decimals: 1 };
    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    const dec = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    /** Metabolismo en reposo. Idéntico en las 8 fórmulas originales. */
    function rer(pesoKg) {
      return 70 * Math.pow(pesoKg, 0.75);
    }

    /** Factor de mantenimiento del perro adulto/senior (comida-perro-diaria.ts). */
    function factorPerro(etapa, actividad, castrado) {
      const F = FACTORES.perro;
      if (etapa === 'bebe') return F.bebe;
      if (etapa === 'juvenil') return F.juvenil;
      if (etapa === 'senior') return actividad === 'alta' ? F.seniorActivo : F.senior;
      if (castrado) return F.castrado;
      if (actividad === 'alta') return F.adultoAlta;
      if (actividad === 'baja') return F.adultoBaja;
      return F.adultoMedia;
    }

    /** Factor felino (comida-gato-diaria.ts). */
    function factorGato(etapa, actividad, castrado) {
      const F = FACTORES.gato;
      if (etapa === 'bebe') return F.bebe;
      if (etapa === 'juvenil') return F.juvenil;
      if (etapa === 'senior') return F.senior;
      if (castrado) return F.castrado;
      if (actividad === 'alta') return F.adultoActivo;
      return F.adultoInterior;
    }

    /** Factor del cachorro por edad (comida-cachorro-gramos-edad.ts). */
    function factorCachorro(etapa) {
      const F = FACTORES.cachorro;
      return F[etapa] !== undefined ? F[etapa] : F.adulto;
    }

    function tomasPerro(etapa, peso) {
      if (etapa === 'bebe') return peso < 5 ? 4 : 3;
      if (etapa === 'juvenil') return 3;
      return 2;
    }

    H.onCompute(function (v, caso) {
      const especie = String(caso || 'perro');
      const peso = Math.max(0, Math.min(100, Number(v.peso) || 0));
      const etapa = String(v.etapa || 'adulto');
      const actividad = String(v.actividad || 'media');
      const alimento = String(v.alimento || 'estandar');
      const castrado = String(v.castrado || 'no') === 'si';
      const tamano = String(v.tamanoAdulto || 'mediano');

      if (!peso) {
        return { total: '—', sub: 'Ingresá el peso de tu animal.', rows: [], chart: [] };
      }

      // ── Conejo: gramos por kilo, no calorías ──────────────────────────
      if (especie === 'conejo') {
        const heno = peso * CONEJO.henoPorKg;
        const verduras = peso * (etapa === 'bebe' ? CONEJO.verdurasCriaPorKg : CONEJO.verdurasPorKg);
        let pellets = peso * (etapa === 'bebe'
          ? CONEJO.pelletsCriaPorKg
          : etapa === 'senior'
            ? CONEJO.pelletsSeniorPorKg
            : CONEJO.pelletsAdultoPorKg);
        if (actividad === 'alta') pellets *= 1.1;
        else if (actividad === 'baja') pellets *= 0.9;
        const agua = peso * CONEJO.aguaPorKg;
        const total = heno + verduras + pellets;
        const henoMes = (heno * 30 * CONEJO.factorDesperdicioMes) / 1000;
        const pctHeno = Math.round((heno / total) * 100);

        return {
          total: dec(Math.round(pellets), 0) + ' g de pellets',
          sub:
            'Más ' + dec(Math.round(heno), 0) + ' g de heno como piso (va ilimitado) y ' +
            dec(Math.round(verduras), 0) + ' g de verduras · el heno es el ' + pctHeno + '% del plato',
          rows: [
            row('Heno — mínimo diario (siempre disponible)', heno, G, true, '40 g/kg'),
            row('Verduras de hoja', verduras, G, false, etapa === 'bebe' ? '50 g/kg' : '100 g/kg'),
            row('Pellets — la única ración que se mide', pellets, G, true, etapa === 'senior' ? '20 g/kg' : etapa === 'bebe' ? 'casi libre' : '25 g/kg'),
            row('Agua fresca', agua, ML, false, '100 ml/kg'),
            row('Heno que vas a comprar por mes', henoMes, KG1, false, 'con 30% de desperdicio'),
            row('Peso del conejo', peso, KG1, false, etapa),
          ],
          chart: [
            { label: 'Heno', value: Math.round(heno), tone: 'main' },
            { label: 'Verduras', value: Math.round(verduras), tone: 'good' },
            { label: 'Pellets', value: Math.round(pellets), tone: 'prop' },
          ],
          format: 'unit',
          unit: 'g',
          decimals: 0,
        };
      }

      // ── Tortuga: porcentaje del peso corporal ─────────────────────────
      if (especie === 'tortuga') {
        const pct = etapa === 'bebe' ? TORTUGA.cria : etapa === 'juvenil' ? TORTUGA.juvenil : TORTUGA.adulto;
        const pesoGr = peso * 1000;
        const terrestre = pesoGr * pct;
        const acuatica = terrestre * TORTUGA.factorAcuatica;

        return {
          total: dec(terrestre, 1) + ' g por día',
          sub:
            'Terrestre ' + dec(terrestre, 1) + ' g · acuática ' + dec(acuatica, 1) + ' g (comen un 30% menos) · ' +
            'el ' + dec(pct * 100, 1) + '% de su peso corporal',
          rows: [
            row('Ración diaria — tortuga terrestre', terrestre, G1, true, dec(pct * 100, 1) + '% del peso'),
            row('Ración diaria — tortuga acuática', acuatica, G1, true, '30% menos'),
            row('Hojas verdes oscuras (70% del plato)', terrestre * TORTUGA.hojas, G1, false, 'achicoria, berro, diente de león'),
            row('Otros vegetales (20%)', terrestre * TORTUGA.vegetales, G1, false, 'zapallo, calabaza, pimiento'),
            row('Fruta ocasional (hasta 10%)', terrestre * TORTUGA.fruta, G1, false, 'no todos los días'),
            row('Peso de la tortuga', pesoGr, G, false, etapa === 'bebe' ? 'cría' : etapa),
          ],
          chart: [
            { label: 'Hojas verdes', value: Number((terrestre * TORTUGA.hojas).toFixed(1)), tone: 'main' },
            { label: 'Vegetales', value: Number((terrestre * TORTUGA.vegetales).toFixed(1)), tone: 'good' },
            { label: 'Fruta', value: Number((terrestre * TORTUGA.fruta).toFixed(1)), tone: 'prop' },
          ],
          format: 'unit',
          unit: 'g',
          decimals: 1,
        };
      }

      // ── Perro, cachorro y gato: RER × factor ÷ densidad ────────────────
      const base = rer(peso);
      let factor;
      let densidadTabla;
      let tomas;
      let refFactor;

      if (especie === 'gato') {
        factor = factorGato(etapa, actividad, castrado);
        densidadTabla = DENSIDAD.gato;
        tomas = etapa === 'bebe' ? (peso < 2 ? 4 : 3) : 2;
        refFactor = 'factor felino ×' + dec(factor, 2);
      } else if (especie === 'cachorro') {
        factor = factorCachorro(etapa) * (AJUSTE_TAMANO[tamano] || 1);
        densidadTabla = DENSIDAD.cachorro;
        tomas = etapa === 'bebe' ? 4 : etapa === 'juvenil' ? 3 : 2;
        refFactor = 'crecimiento ×' + dec(factor, 2);
      } else {
        factor = factorPerro(etapa, actividad, castrado);
        densidadTabla = DENSIDAD.perro;
        tomas = tomasPerro(etapa, peso);
        refFactor = 'mantenimiento ×' + dec(factor, 2);
      }

      const kcal = base * factor;
      const densidad = densidadTabla[alimento] || densidadTabla.estandar;
      const gramos = kcal / densidad;
      const porToma = gramos / tomas;
      const duracionBolsa = 15000 / gramos;
      const agua = peso * 60;
      const sobrecarga = Math.max(0, kcal - base);

      const rows = [
        row('Energía en reposo (RER = 70 × peso^0,75)', base, KCAL, false, 'metabolismo basal'),
        row('Energía diaria total (MER)', kcal, KCAL, true, refFactor),
        row('Ración diaria', gramos, G, true, dec(densidad, 1) + ' kcal/g'),
        row('Cantidad de tomas', tomas, VECES, false, especie === 'cachorro' ? 'por edad' : 'estándar'),
        row('Gramos por toma', porToma, G, false, 'pesalos, no los midas a ojo'),
        row('Duración de una bolsa de 15 kg', duracionBolsa, DIAS, false, 'para planificar la compra'),
        row('Agua fresca por día', agua, ML, false, '60 ml/kg'),
      ];

      if (especie === 'gato' && alimento !== 'humedo') {
        rows.push(row('Lo mismo en alimento húmedo', kcal / densidadTabla.humedo, G, false, '0,9 kcal/g'));
      }

      const etiquetaEtapa =
        especie === 'cachorro'
          ? (etapa === 'bebe' ? 'cachorro hasta 4 meses' : etapa === 'juvenil' ? 'cachorro de 4 a 12 meses' : 'cachorro grande')
          : etapa === 'bebe'
            ? 'cría'
            : etapa === 'juvenil'
              ? 'juvenil'
              : etapa === 'senior'
                ? 'senior'
                : castrado
                  ? 'adulto castrado'
                  : 'adulto';

      return {
        total: dec(gramos, 0) + ' g por día',
        sub:
          dec(kcal, 0) + ' kcal · ' + etiquetaEtapa + ' de ' + dec(peso, 1) + ' kg · ' +
          tomas + ' tomas de ' + dec(porToma, 0) + ' g · la bolsa de 15 kg dura ' + dec(duracionBolsa, 0) + ' días',
        rows: rows,
        chart: [
          { label: 'Metabolismo en reposo', value: Math.round(base), tone: 'main' },
          { label: 'Etapa y actividad', value: Math.round(sobrecarga), tone: 'prop' },
        ],
        format: 'unit',
        unit: 'g',
        decimals: 0,
      };
    });
  })();
</script>
