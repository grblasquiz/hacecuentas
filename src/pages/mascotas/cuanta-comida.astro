---
/**
 * Hub de decisión — "¿Cuánta comida le doy a mi mascota?"
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: cada caso es una especie. La página sólo aporta datos
 * (src/lib/hubs/cuanta-comida-mascota.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import CuantaComidaMascotaExperience from '../../components/generated/CuantaComidaMascotaExperience.astro';
import { hub, FACTORES, AJUSTE_TAMANO, DENSIDAD, CONEJO, TORTUGA } from '../../lib/hubs/cuanta-comida-mascota';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <CuantaComidaMascotaExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

