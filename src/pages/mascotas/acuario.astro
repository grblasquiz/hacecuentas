---
/**
 * Hub de decisión — "¿De cuántos litros tiene que ser mi acuario?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: peces de comunitario, betta y tortuga acuática.
 * La página sólo aporta datos (src/lib/hubs/acuario.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, CM_POR_PEZ, ESTANDARES, TEMPERATURAS, TORTUGAS, BETTA } from '../../lib/hubs/acuario';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ CM_POR_PEZ, ESTANDARES, TEMPERATURAS, TORTUGAS, BETTA }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay dinero: TODAS las filas declaran su formato.
    const L = { format: 'unit', unit: 'litros', decimals: 0 };
    const W = { format: 'unit', unit: 'W', decimals: 0 };
    const GRADOS = { format: 'unit', unit: '°C', decimals: 0 };
    const CM = { format: 'unit', unit: 'cm', decimals: 0 };
    const CM2 = { format: 'unit', unit: 'cm²', decimals: 0 };
    const LH = { format: 'unit', unit: 'L/h', decimals: 0 };
    const MESES = { format: 'unit', unit: 'meses', decimals: 0 };
    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    const dec = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    /** Watts por litro según la temperatura ambiente (temperatura-acuario-especie.ts). */
    function wattsPorLitro(tempAmb) {
      if (tempAmb <= 14) return 2.5;
      if (tempAmb <= 18) return 2.0;
      if (tempAmb <= 22) return 1.5;
      return 1.0;
    }

    function calefactor(litros, especie, tempAmb) {
      if (especie === 'goldfish' || especie === 'agua-fria') {
        return tempAmb < 14 ? Math.round(litros * 1.0) : 0;
      }
      return Math.round(litros * wattsPorLitro(tempAmb));
    }

    /** Tamaño comercial mínimo y el siguiente (tamano-pecera.ts). */
    function comerciales(litros) {
      let recomendado = litros;
      for (let i = 0; i < ESTANDARES.length; i++) {
        if (ESTANDARES[i] >= litros) { recomendado = ESTANDARES[i]; break; }
      }
      const idx = ESTANDARES.indexOf(recomendado);
      const ideal = idx >= 0 && idx < ESTANDARES.length - 1 ? ESTANDARES[idx + 1] : recomendado;
      return { recomendado: recomendado, ideal: ideal };
    }

    /** UVB por volumen del acuario (tortuga-acuatica-tamano-acuario-filtro-litros.ts). */
    function uvbPorLitros(litros) {
      if (litros < 100) return 13;
      if (litros < 200) return 24;
      if (litros < 400) return 36;
      return 54;
    }

    function bandas(minimo, ideal) {
      const tope = Math.max(ideal * 1.6, minimo * 2);
      return [
        { label: 'Por debajo del mínimo', from: 0, to: Number(minimo.toFixed(0)), tone: 'bad' },
        { label: 'Mínimo justo', from: Number(minimo.toFixed(0)), to: Number(ideal.toFixed(0)), tone: 'warn' },
        { label: 'Volumen holgado', from: Number(ideal.toFixed(0)), to: Number(tope.toFixed(0)), tone: 'good' },
      ];
    }

    H.onCompute(function (v, caso) {
      const modo = String(caso || 'peces');
      const cantidad = Math.max(1, Math.min(60, Math.round(Number(v.cantidad) || 1)));
      const tamanoPez = String(v.tamanoPez || 'pequeno');
      const especie = String(v.especie || 'tropical-comunitario');
      const tempAmb = Math.max(5, Math.min(32, Number(v.tempAmbiente) || 18));
      const caparazon = Math.max(0, Math.min(45, Number(v.caparazon) || 0));
      const sexo = String(v.sexo || 'desconocido');

      const T = TEMPERATURAS[especie] || TEMPERATURAS['tropical-comunitario'];

      // ── Tortuga acuática ──────────────────────────────────────────────
      if (modo === 'tortuga') {
        if (!caparazon) {
          return { total: '—', sub: 'Ingresá el largo del caparazón en centímetros.', rows: [], chart: [] };
        }
        const porTortuga = Math.max(Math.pow(caparazon, 2) * TORTUGAS.factorVolumen, TORTUGAS.minimoLitros);
        const litros = Math.ceil(porTortuga * (1 + TORTUGAS.extraPorTortuga * (cantidad - 1)));
        const caudalMin = Math.ceil(litros * TORTUGAS.caudalMin);
        const caudalMax = Math.ceil(litros * TORTUGAS.caudalMax);
        const largoMin = Math.max(TORTUGAS.largoMinimo, Math.ceil(caparazon * TORTUGAS.largoFactor));
        const areaSeca = Math.ceil(caparazon * (caparazon * TORTUGAS.ratioAncho) * TORTUGAS.areaSecaFactor);
        const uvb = uvbPorLitros(litros);

        const adulto =
          sexo === 'hembra'
            ? TORTUGAS.adultoHembra
            : sexo === 'macho'
              ? TORTUGAS.adultoMacho
              : Math.round(TORTUGAS.adultoHembra * 0.6 + TORTUGAS.adultoMacho * 0.4);
        const litrosAdulto = Math.ceil(
          Math.max(Math.pow(adulto, 2) * TORTUGAS.factorVolumen, TORTUGAS.minimoLitros) *
            (1 + TORTUGAS.extraPorTortuga * (cantidad - 1))
        );

        return {
          total: dec(litros, 0) + ' litros',
          sub:
            'Filtro de ' + dec(caudalMin, 0) + ' a ' + dec(caudalMax, 0) + ' L/h · largo mínimo ' + largoMin + ' cm · ' +
            'zona seca ' + dec(areaSeca, 0) + ' cm² · UVB ' + uvb + ' W · ' +
            (adulto > caparazon + 1
              ? 'de adulta va a necesitar unos ' + dec(litrosAdulto, 0) + ' litros: comprá pensando en eso'
              : 'ya está cerca de su tamaño adulto'),
          rows: [
            row('Litros mínimos hoy', litros, L, true, 'caparazón² × 0,75 · piso de 80 L'),
            row('Litros que va a necesitar de adulta', litrosAdulto, L, true, 'caparazón adulto de ' + adulto + ' cm'),
            row('Caudal del filtro — mínimo', caudalMin, LH, false, '4× el volumen por hora'),
            row('Caudal del filtro — máximo', caudalMax, LH, false, '5× el volumen por hora'),
            row('Largo mínimo del acuario', largoMin, CM, false, '5× el caparazón, nunca menos de 60'),
            row('Zona seca de asoleo', areaSeca, CM2, false, '1,5× el área del caparazón'),
            row('Lámpara UVB', uvb, W, true, 'UVI objetivo de 2,5 a 4'),
            row('Temperatura del agua — mínima', 24, GRADOS, false, 'basking aparte, de 32 a 38 °C'),
            row('Temperatura del agua — máxima', 28, GRADOS, false, 'estable, con termómetro aparte'),
            row('Reemplazo del tubo UVB', 9, MESES, false, 'compacta 6 · T8 9 · T5 y mercurio 12'),
          ],
          chart: bandas(litros, litrosAdulto),
          format: 'unit',
          unit: 'litros',
          decimals: 0,
          position: Math.max(0, Math.min(100, (litros / Math.max(litrosAdulto * 1.6, litros * 2)) * 100)),
          positionLabel: dec(litros, 0) + ' litros hoy · ' + dec(litrosAdulto, 0) + ' litros de adulta',
        };
      }

      // ── Betta ─────────────────────────────────────────────────────────
      if (modo === 'betta') {
        let minimo;
        let ideal;
        let nota;
        if (cantidad <= 1) {
          minimo = BETTA.machoMin;
          ideal = BETTA.machoIdeal;
          nota = 'un ejemplar solo';
        } else {
          const n = Math.max(cantidad, BETTA.sororityBase);
          minimo = BETTA.sororityMin + (n - BETTA.sororityBase) * BETTA.sororityPorExtraMin;
          ideal = BETTA.sororityIdeal + (n - BETTA.sororityBase) * BETTA.sororityPorExtraIdeal;
          nota = 'sorority de ' + n + ' hembras — dos machos NO conviven en ningún volumen';
        }
        const watts = calefactor(ideal, 'betta', tempAmb);
        const cambio = minimo <= 15 ? 30 : minimo <= 40 ? 25 : 22;

        return {
          total: dec(minimo, 0) + ' litros como mínimo',
          sub:
            'Ideal ' + dec(ideal, 0) + ' litros · ' + nota + ' · 25 a 27 °C con calefactor de ' + watts + ' W · ' +
            'filtro suave, plantas y tapa (saltan)',
          rows: [
            row('Volumen mínimo', minimo, L, true, nota),
            row('Volumen ideal', ideal, L, true, 'el que conviene comprar'),
            row('Calefactor', watts, W, true, dec(wattsPorLitro(tempAmb), 1) + ' W/L con ' + tempAmb + ' °C de ambiente'),
            row('Temperatura mínima', 25, GRADOS, false, 'por debajo de 22 °C enferman'),
            row('Temperatura máxima', 27, GRADOS, false, 'constante, sin oscilaciones'),
            row('Cambio de agua semanal', cambio, { format: 'unit', unit: '% del volumen', decimals: 0 }, false, 'siempre con acondicionador de cloro'),
          ],
          chart: bandas(minimo, ideal),
          format: 'unit',
          unit: 'litros',
          decimals: 0,
          position: Math.max(0, Math.min(100, (minimo / Math.max(ideal * 1.6, minimo * 2)) * 100)),
          positionLabel: dec(minimo, 0) + ' litros mínimo · ' + dec(ideal, 0) + ' litros ideal',
        };
      }

      // ── Peces de comunitario ──────────────────────────────────────────
      const cm = CM_POR_PEZ[tamanoPez] || 4;
      const esTropical = especie !== 'goldfish' && especie !== 'agua-fria';
      let litros = cantidad * cm;
      if (esTropical) litros *= 1.2;
      litros = Math.ceil(litros);

      const C = comerciales(litros);
      const watts = calefactor(C.recomendado, especie, tempAmb);
      const tomas = 2;

      const rows = [
        row('Centímetros de pez adulto en total', cantidad * cm, CM, false, cantidad + ' × ' + cm + ' cm'),
        row('Litros mínimos', litros, L, true, esTropical ? '1 L/cm + 20% tropical' : '1 L por cm de pez'),
        row('Tamaño comercial mínimo', C.recomendado, L, true, 'el más chico que sirve'),
        row('Tamaño comercial recomendado', C.ideal, L, true, 'el que conviene comprar'),
        row('Calefactor', watts, W, watts > 0, watts === 0 ? 'agua fría: no lleva' : dec(wattsPorLitro(tempAmb), 1) + ' W/L con ' + tempAmb + ' °C'),
        row('Temperatura ideal — mínima', T.min, GRADOS, false, especie),
        row('Temperatura ideal — máxima', T.max, GRADOS, false, 'lo que daña es la oscilación'),
        row('Tomas de comida por día', tomas, { format: 'unit', unit: 'por día', decimals: 0 }, false, 'lo que coman en 2 minutos'),
        row('Ayuno semanal', 1, { format: 'unit', unit: 'día', decimals: 0 }, false, 'baja nitratos y mejora la digestión'),
        row('Cambio de agua semanal', 25, { format: 'unit', unit: '% del volumen', decimals: 0 }, false, 'nunca lavar el filtro con agua de canilla'),
        row('Ciclado antes de meter peces', 4, { format: 'unit', unit: 'semanas', decimals: 0 }, false, 'hasta amoníaco y nitritos en cero'),
      ];

      return {
        total: dec(litros, 0) + ' litros como mínimo',
        sub:
          'Comprá un acuario de ' + dec(C.ideal, 0) + ' litros · ' + cantidad + ' peces de ' + cm + ' cm de adultos · ' +
          T.min + ' a ' + T.max + ' °C' + (watts > 0 ? ' con calefactor de ' + watts + ' W' : ' sin calefactor') +
          ' · ciclalo 3 a 6 semanas antes',
        rows: rows,
        chart: bandas(litros, C.ideal),
        format: 'unit',
        unit: 'litros',
        decimals: 0,
        position: Math.max(0, Math.min(100, (litros / Math.max(C.ideal * 1.6, litros * 2)) * 100)),
        positionLabel: dec(litros, 0) + ' litros mínimo · comprá ' + dec(C.ideal, 0) + ' litros',
      };
    });
  })();
</script>
