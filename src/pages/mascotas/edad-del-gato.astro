---
/**
 * Hub de decisión — "¿Cuántos años humanos tiene mi gato?"
 * Reemplaza 3 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer.
 * La página sólo aporta datos (src/lib/hubs/edad-del-gato.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EdadGatoExperience from '../../components/generated/EdadGatoExperience.astro';
import { hub, RAZAS, AJUSTES, ETAPAS } from '../../lib/hubs/edad-del-gato';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <EdadGatoExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ RAZAS, AJUSTES, ETAPAS }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay pesos: TODAS las filas declaran su formato.
    const ANIOS = { format: 'unit', unit: 'años', decimals: 1 };
    const HUM = { format: 'unit', unit: 'años humanos', decimals: 0 };
    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    const dec = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    /**
     * Tabla AAFP/AAHA: año 1 = 15 años humanos, el año 2 suma 9 (total 24) y
     * de ahí en más suma 4 por cada año de gato. NO es lineal ni ×7.
     * Idéntica a `edad-gato-humano-formula-anos.ts` y `edad-gato-humano.ts`.
     */
    function humanaAAFP(edad) {
      if (edad <= 0) return 0;
      if (edad <= 1) return edad * 15;
      if (edad <= 2) return 15 + (edad - 1) * 9;
      return 24 + (edad - 2) * 4;
    }

    /** Etapa de vida AAFP por edad del gato. */
    function etapaDe(edad) {
      for (let i = 0; i < ETAPAS.length; i++) {
        if (edad < ETAPAS[i].hasta) return ETAPAS[i].nombre;
      }
      return ETAPAS[ETAPAS.length - 1].nombre;
    }

    /**
     * Esperanza de vida: rango de la raza (indoor y castrado) con los ajustes
     * de `esperanza-vida-gato-raza-indoor.ts` por estilo de vida y castración.
     */
    function esperanza(razaId, estilo, castrado) {
      const R = RAZAS[razaId] || RAZAS.otro;
      let min = R.min;
      let max = R.max;
      if (estilo === 'outdoor') {
        min = Math.max(AJUSTES.outdoor.minPiso, Math.round(min * AJUSTES.outdoor.minFactor));
        max = Math.max(AJUSTES.outdoor.maxPiso, Math.round(max * AJUSTES.outdoor.maxFactor));
      } else if (estilo === 'mixto') {
        min = Math.round(min * AJUSTES.mixto.minFactor);
        max = Math.round(max * AJUSTES.mixto.maxFactor);
      }
      if (!castrado) {
        min = Math.max(min - AJUSTES.sinCastrar.resta, AJUSTES.sinCastrar.minPiso);
        max = Math.max(max - AJUSTES.sinCastrar.resta, AJUSTES.sinCastrar.maxPiso);
      }
      return { min: min, max: max, raza: R };
    }

    H.onCompute(function (v) {
      const edad = Math.max(0, Math.min(30, v.edad || 0));
      const razaId = String(v.raza || 'mestizo');
      const estilo = String(v.estiloVida || 'indoor');
      const castrado = String(v.castrado || 'si') === 'si';

      if (!edad) {
        return { total: '—', sub: 'Ingresá la edad de tu gato.', rows: [], chart: [] };
      }

      const humana = humanaAAFP(edad);
      const mito = edad * 7;
      const etapa = etapaDe(edad);

      const E = esperanza(razaId, estilo, castrado);
      const media = (E.min + E.max) / 2;
      const restante = Math.max(0, media - edad);

      // Comparación accionable: el mismo gato viviendo puertas adentro.
      const indoor = esperanza(razaId, 'indoor', castrado);
      const mediaIndoor = (indoor.min + indoor.max) / 2;
      const gananciaIndoor = Math.max(0, mediaIndoor - media);

      // ── Etapas AAFP, con el final de la barra estirado hasta la esperanza ──
      const fin = Math.max(E.max + 2, edad + 1, 18);
      const cortes = [0.5, 2, 7, 11, 15];
      const tonos = ['good', 'exit', 'main', 'main', 'warn', 'bad'];
      const bandas = [];
      let desde = 0;
      for (let i = 0; i < ETAPAS.length; i++) {
        const hasta = i < cortes.length ? Math.min(cortes[i], fin) : fin;
        if (hasta <= desde) continue;
        bandas.push({
          label: ETAPAS[i].nombre.charAt(0).toUpperCase() + ETAPAS[i].nombre.slice(1),
          from: Number(desde.toFixed(1)),
          to: Number(hasta.toFixed(1)),
          tone: tonos[i],
        });
        desde = hasta;
      }

      const pos = Math.max(0, Math.min(100, (edad / fin) * 100));

      const rows = [
        row('Edad real de tu gato', edad, ANIOS, false, etapa),
        row('Equivalencia en años humanos (AAFP)', humana, HUM, true, 'AAHA/AAFP 2021'),
        row('Lo que daría el mito de multiplicar por 7', mito, HUM, false, 'no lo uses'),
        row('Cuánto suma ahora cada año de gato', edad < 1 ? 15 : edad < 2 ? 9 : 4, HUM, false, 'AAFP'),
        row('Esperanza de vida mínima', E.min, ANIOS, false, E.raza.nombre),
        row('Esperanza de vida máxima', E.max, ANIOS, false, estilo),
        row('Esperanza de vida media estimada', media, ANIOS, true, castrado ? 'castrado' : 'sin castrar'),
        row('Le quedarían por delante', restante, ANIOS, false, 'promedio'),
        row('Lo que sumaría viviendo puertas adentro', gananciaIndoor, ANIOS, false, 'indoor vs actual'),
      ];

      const subPartes = [
        dec(edad, 1) + ' años',
        E.raza.nombre,
        etapa,
        'esperanza ' + E.min + '-' + E.max + ' años',
      ];
      if (restante > 0) subPartes.push('le quedarían unos ' + dec(restante, 1) + ' años');
      else subPartes.push('ya superó la esperanza media: cada año extra es un regalo');

      return {
        total: dec(humana, 0) + ' años humanos',
        sub: subPartes.join(' · '),
        rows: rows,
        chart: bandas,
        // Default del resultado: años (acá no hay pesos).
        format: 'unit',
        unit: 'años',
        decimals: 1,
        position: Number(pos.toFixed(1)),
        positionLabel: dec(edad, 1) + ' años · ' + etapa + ' · equivale a ' + dec(humana, 0) + ' humanos',
      };
    });
  })();
</script>
