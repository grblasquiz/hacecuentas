---
/**
 * Hub de decisión — "¿Cuánto tiene que pesar mi perro o mi gato?"
 * Reemplaza 13 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer.
 * La página sólo aporta datos (src/lib/hubs/peso-ideal-mascota.ts) y compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, RAZAS, CURVAS, CIERRE } from '../../lib/hubs/peso-ideal-mascota';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ RAZAS, CURVAS, CIERRE }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay dinero: TODAS las filas declaran su formato.
    const KG = { format: 'unit', unit: 'kg', decimals: 1 };
    const MESES = { format: 'unit', unit: 'meses', decimals: 0 };
    const ANIOS = { format: 'unit', unit: 'años', decimals: 0 };
    const PCT = { format: 'unit', unit: '%', decimals: 0 };
    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    const dec = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    /** Clasifica la raza por su peso adulto promedio. Calcado de _puppy-growth.ts. */
    function tamanoPorPeso(prom) {
      if (prom < 5) return 'toy';
      if (prom < 11) return 'pequena';
      if (prom < 26) return 'mediana';
      if (prom < 45) return 'grande';
      return 'gigante';
    }

    /** Fracción del peso adulto a `meses`, interpolada linealmente. */
    function fraccionAdulto(meses, tamano) {
      const curva = CURVAS[tamano];
      if (meses <= curva[0][0]) {
        return Math.max(0.02, (meses / curva[0][0]) * curva[0][1]);
      }
      for (let i = 1; i < curva.length; i++) {
        if (meses <= curva[i][0]) {
          const m0 = curva[i - 1][0];
          const f0 = curva[i - 1][1];
          return f0 + ((meses - m0) / (curva[i][0] - m0)) * (curva[i][1] - f0);
        }
      }
      return 1;
    }

    function mesesDeEdad(edad) {
      const m = /^m(\d+)$/.exec(String(edad || ''));
      return m ? Number(m[1]) : null;
    }

    H.onCompute(function (v) {
      const R = RAZAS[String(v.raza || 'labrador')] || RAZAS.labrador;
      const sexo = String(v.sexo || 'macho');
      const contextura = String(v.contextura || 'mediana');
      const edad = String(v.edad || 'adulto');
      const pesoActual = Math.max(0, Number(v.pesoActual) || 0);

      let min = sexo === 'hembra' ? R.hembraMin : R.machoMin;
      let max = sexo === 'hembra' ? R.hembraMax : R.machoMax;
      const rango = max - min;

      // El ajuste de contextura difiere entre perro y gato: son dos fórmulas
      // distintas en el catálogo viejo y se respetan tal cual.
      if (R.especie === 'gato') {
        if (contextura === 'pequena') max = min + rango * 0.4;
        else if (contextura === 'grande') min = min + rango * 0.6;
        else { min = min + rango * 0.25; max = max - rango * 0.25; }
      } else {
        if (contextura === 'pequena') max = min + rango * 0.45;
        else if (contextura === 'grande') min = max - rango * 0.45;
        else { min = min + rango * 0.25; max = max - rango * 0.1; }
      }

      const adultoMin = min;
      const adultoMax = max;
      const adultoProm = (adultoMin + adultoMax) / 2;
      const tamano = tamanoPorPeso((R.machoMin + R.machoMax + R.hembraMin + R.hembraMax) / 4);
      const cierre = CIERRE[tamano];

      // El gato no tiene curva de crecimiento en el catálogo: siempre adulto.
      const meses = R.especie === 'perro' ? mesesDeEdad(edad) : null;
      let porcentaje = 100;
      let etiqueta;

      if (meses !== null) {
        const f = fraccionAdulto(meses, tamano);
        min = adultoMin * f;
        max = adultoMax * f;
        porcentaje = Math.round(f * 100);
        etiqueta = 'a los ' + meses + ' meses';
      } else if (edad === 'senior' && R.especie === 'perro') {
        min = adultoMin * 0.9;
        max = adultoMax;
        etiqueta = 'senior';
      } else {
        etiqueta = 'adulto';
      }

      const prom = (min + max) / 2;
      const marcador = pesoActual > 0 ? pesoActual : prom;

      // Escala del gráfico: 0 → sobrepeso franco (rango ideal ×1,3).
      const tope = max * 1.3;
      const bandas = [
        { label: 'Bajo peso', from: 0, to: Number(min.toFixed(1)), tone: 'warn' },
        { label: 'Peso ideal', from: Number(min.toFixed(1)), to: Number(max.toFixed(1)), tone: 'good' },
        { label: 'Sobrepeso', from: Number(max.toFixed(1)), to: Number(tope.toFixed(1)), tone: 'bad' },
      ];
      const pos = Math.max(0, Math.min(100, (marcador / tope) * 100));

      let estado;
      let diferencia = 0;
      if (pesoActual <= 0) estado = 'sin peso cargado';
      else if (pesoActual < min) { estado = 'por debajo del rango'; diferencia = min - pesoActual; }
      else if (pesoActual > max) { estado = 'por encima del rango'; diferencia = pesoActual - max; }
      else estado = 'dentro del rango';

      const rows = [
        row('Peso ideal mínimo ' + etiqueta, min, KG, false, R.nombre),
        row('Peso ideal máximo ' + etiqueta, max, KG, false, sexo + ' · contextura ' + contextura),
        row('Promedio del rango', prom, KG, true, etiqueta),
        row('Rango adulto de la raza (mínimo)', adultoMin, KG, false, 'FCI/AKC ajustado por contextura'),
        row('Rango adulto de la raza (máximo)', adultoMax, KG, false, 'promedio ' + dec(adultoProm, 1) + ' kg'),
      ];

      if (meses !== null) {
        rows.push(row('Porcentaje del peso adulto que le toca hoy', porcentaje, PCT, false, 'curva WALTHAM · raza ' + tamano));
        rows.push(row('Termina de crecer alrededor de los', cierre, MESES, false, 'raza ' + tamano));
      }

      if (pesoActual > 0) {
        rows.push(row('Peso que marcó la balanza', pesoActual, KG, true, estado));
        if (diferencia > 0) {
          rows.push(row(pesoActual > max ? 'Kilos por encima del rango' : 'Kilos por debajo del rango', diferencia, KG, false, 'objetivo: volver al rango'));
        }
      }

      rows.push(row('Esperanza de vida media de la raza', R.esperanza, ANIOS, false, 'referencia poblacional'));

      const subPartes = [
        R.nombre,
        sexo === 'hembra' ? 'hembra' : 'macho',
        'contextura ' + contextura,
        etiqueta,
      ];
      if (pesoActual > 0) {
        subPartes.push(
          estado === 'dentro del rango'
            ? 'con ' + dec(pesoActual, 1) + ' kg está dentro del rango'
            : 'con ' + dec(pesoActual, 1) + ' kg está ' + estado + ' por ' + dec(diferencia, 1) + ' kg'
        );
      }

      return {
        total: dec(min, 1) + ' a ' + dec(max, 1) + ' kg',
        sub: subPartes.join(' · '),
        rows: rows,
        chart: bandas,
        format: 'unit',
        unit: 'kg',
        decimals: 1,
        position: Number(pos.toFixed(1)),
        positionLabel:
          (pesoActual > 0 ? dec(pesoActual, 1) + ' kg · ' + estado : 'promedio ' + dec(prom, 1) + ' kg') +
          ' · ideal ' + dec(min, 1) + '-' + dec(max, 1) + ' kg',
      };
    });
  })();
</script>
