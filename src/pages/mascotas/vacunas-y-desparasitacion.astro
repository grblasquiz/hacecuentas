---
/**
 * Hub de decisión — "¿Qué vacuna le toca a mi perro o a mi gato?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces). Una de ellas,
 * la dosis genérica de medicamento por peso, se absorbe SÓLO por URL.
 *
 * Arquetipo ramificado: perro y gato. La página sólo aporta datos
 * (src/lib/hubs/vacunas-y-desparasitacion.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VacunasMascotasExperience from '../../components/generated/VacunasMascotasExperience.astro';
import {
  hub,
  CALENDARIO_PERRO,
  CALENDARIO_GATO,
  TALLES_PERRO,
  TALLES_GATO,
  CASTRACION,
} from '../../lib/hubs/vacunas-y-desparasitacion';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <VacunasMascotasExperience data={hub} />
  <Footer />
</Layout>

