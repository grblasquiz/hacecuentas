---
/**
 * Hub de decisión — "¿Cuánto ejercicio y qué cuidados necesita mi perro?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: perro y gato. La página sólo aporta datos
 * (src/lib/hubs/rutina-perro.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RutinaCuidadosMascotasExperience from '../../components/generated/RutinaCuidadosMascotasExperience.astro';
import { hub, RAZAS, BRAQUICEFALAS, PASEO_BASE, FACTOR_EDAD, BANO } from '../../lib/hubs/rutina-perro';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <RutinaCuidadosMascotasExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ RAZAS, BRAQUICEFALAS, PASEO_BASE, FACTOR_EDAD, BANO }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay dinero: TODAS las filas declaran su formato.
    const MIN = { format: 'unit', unit: 'minutos', decimals: 0 };
    const SALIDAS = { format: 'unit', unit: 'por día', decimals: 0 };
    const DIAS = { format: 'unit', unit: 'días', decimals: 0 };
    const SEM = { format: 'unit', unit: 'semanas', decimals: 0 };
    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    const dec = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    /** Energía derivada de los minutos de la raza (ejercicio-diario-raza-perro.ts). */
    function energiaDeRaza(minutos) {
      if (minutos >= 90) return 'alta';
      if (minutos >= 60) return 'media';
      return 'baja';
    }

    /** Frecuencia de baño en días (frecuencia-bano-perro.ts). */
    function diasBano(pelo, actividad, piel) {
      let d = BANO.base[pelo] !== undefined ? BANO.base[pelo] : BANO.base.medio;
      d = Math.round(d * (BANO.actividad[actividad] || 1));
      d = Math.round(d * (BANO.piel[piel] || 1));
      return Math.max(BANO.min, Math.min(BANO.max, d));
    }

    /** Corte de uñas del perro, en semanas (frecuencia-corte-unas-perro-gato.ts). */
    function unasPerro(actividad, superficie, edad) {
      let min, max;
      if (actividad === 'alto') { min = 4; max = 6; }
      else if (actividad === 'moderado') { min = 3; max = 4; }
      else { min = 2; max = 3; }

      if (superficie === 'asfalto') { min += 1; max += 2; }
      else if (superficie === 'blanda') { min = Math.max(2, min - 1); max = Math.max(2, max - 1); }

      if (edad === 'senior') { min = Math.max(2, min - 1); max = Math.max(2, max - 1); }
      else if (edad === 'cachorro') { min = Math.min(min, 3); max = Math.min(max, 4); }
      return { min: min, max: max };
    }

    /** Corte de uñas del gato, en semanas. `rascador` = superficie 'asfalto' o 'mixta'. */
    function unasGato(edad, actividadAlta, rascador) {
      if (edad === 'senior') return { min: 2, max: 2 };
      if (edad === 'cachorro') return { min: 3, max: 4 };
      if (rascador && actividadAlta) return { min: 3, max: 4 };
      if (rascador) return { min: 2, max: 3 };
      return { min: 2, max: 2 };
    }

    H.onCompute(function (v, caso) {
      const especie = String(caso || 'perro');
      const razaId = String(v.raza || 'otra');
      const edad = String(v.edad || 'adulto');
      const pelo = String(v.pelo || 'medio');
      const piel = String(v.piel || 'normal');
      const superficie = String(v.superficie || 'mixta');
      let energia = String(v.energia || 'media');
      let tamano = String(v.tamano || 'mediano');

      // ── Gato: sin paseo. Uñas, cepillado y juego. ─────────────────────
      if (especie === 'gato') {
        const rascador = superficie !== 'blanda';
        const u = unasGato(edad, energia === 'alta', rascador);
        const juego = edad === 'senior' ? 20 : edad === 'cachorro' ? 45 : 30;
        const cepillado = pelo === 'largo' || pelo === 'rizado' ? 7 : pelo === 'doble-capa' ? 4 : 2;

        return {
          total: u.min === u.max ? 'Cada ' + u.min + ' semanas' : 'Cada ' + u.min + ' a ' + u.max + ' semanas',
          sub:
            'Corte de uñas · ' + juego + ' minutos de juego activo por día en 2 o 3 sesiones · ' +
            'cepillado ' + cepillado + ' veces por semana · revisá siempre el espolón',
          rows: [
            row('Corte de uñas — cada (mínimo)', u.min, SEM, true, rascador ? 'con rascador' : 'sin rascador'),
            row('Corte de uñas — cada (máximo)', u.max, SEM, true, edad),
            row('Juego activo por día', juego, MIN, true, '2 o 3 sesiones de 10 a 15 minutos'),
            row('Cepillados por semana', cepillado, { format: 'unit', unit: 'por semana', decimals: 0 }, false, 'pelo ' + pelo),
            row('Revisión del espolón', 1, { format: 'unit', unit: 'cada corte', decimals: 0 }, false, 'no se desgasta nunca'),
          ],
          chart: [
            { label: 'Juego liviano', from: 0, to: 20, tone: 'good' },
            { label: 'Juego recomendado', from: 20, to: 45, tone: 'warn' },
            { label: 'Gato muy activo', from: 45, to: 70, tone: 'bad' },
          ],
          format: 'unit',
          unit: 'minutos',
          decimals: 0,
          position: Math.max(0, Math.min(100, (juego / 70) * 100)),
          positionLabel: juego + ' minutos de juego por día · uñas cada ' + u.min + ' a ' + u.max + ' semanas',
        };
      }

      // ── Perro ─────────────────────────────────────────────────────────
      const R = RAZAS[razaId];
      let minutos;
      let refMinutos;

      if (R) {
        // Ejercicio por raza (ejercicio-diario-raza-perro.ts).
        minutos = R.minutos;
        if (edad === 'cachorro') minutos = Math.min(minutos, 40);
        else if (edad === 'senior') minutos = Math.round(minutos * 0.65);
        energia = energiaDeRaza(R.minutos);
        tamano = R.tamano;
        refMinutos = R.nombre;
      } else {
        // Mestizo: paseo por energía y tamaño (paseos-perro-minutos-raza-energia.ts).
        const base = (PASEO_BASE[energia] || PASEO_BASE.media)[tamano] || 55;
        minutos = Math.max(15, Math.round(base * (FACTOR_EDAD[edad] || 1)));
        refMinutos = 'energía ' + energia + ' · tamaño ' + tamano;
      }

      const salidas = edad === 'adulto' ? 2 : 3;
      const porSalida = minutos / salidas;
      const intensidad = minutos >= 90 ? 'alta' : minutos >= 60 ? 'media' : 'suave';

      const actividadBano = energia === 'alta' ? 'alta' : energia === 'baja' ? 'interior' : 'moderada';
      const bano = diasBano(pelo, actividadBano, piel);

      const actividadUnas = energia === 'alta' ? 'alto' : energia === 'baja' ? 'bajo' : 'moderado';
      const u = unasPerro(actividadUnas, superficie, edad);

      const cepillado = pelo === 'largo' || pelo === 'rizado' ? 7 : pelo === 'doble-capa' ? 4 : 3;
      const braqui = BRAQUICEFALAS.indexOf(razaId) !== -1;

      const rows = [
        row('Ejercicio por día', minutos, MIN, true, refMinutos),
        row('Salidas por día', salidas, SALIDAS, false, edad === 'adulto' ? 'adulto' : 'más cortas y frecuentes'),
        row('Duración de cada salida', porSalida, MIN, true, 'intensidad ' + intensidad),
        row('Baño — cada', bano, DIAS, true, 'pelo ' + pelo + ' · piel ' + piel),
        row('Cepillados por semana', cepillado, { format: 'unit', unit: 'por semana', decimals: 0 }, false, 'hace más por el pelo que el baño'),
        row('Corte de uñas — cada (mínimo)', u.min, SEM, false, 'superficie ' + superficie),
        row('Corte de uñas — cada (máximo)', u.max, SEM, true, 'si hace clic en el piso, ya te pasaste'),
      ];

      if (edad === 'cachorro') {
        rows.push(row('Regla AKC para cachorros', 5, { format: 'unit', unit: 'min por mes de edad', decimals: 0 }, false, 'en 2 o 3 sesiones'));
      }

      const tope = Math.max(130, minutos + 10);
      const bandas = [
        { label: 'Suave', from: 0, to: 60, tone: 'good' },
        { label: 'Media', from: 60, to: 90, tone: 'warn' },
        { label: 'Alta', from: 90, to: tope, tone: 'bad' },
      ];

      const subPartes = [
        (R ? R.nombre : 'mestizo') + ' ' + edad,
        salidas + ' salidas de ' + dec(porSalida, 0) + ' minutos',
        'baño cada ' + bano + ' días',
        'uñas cada ' + u.min + ' a ' + u.max + ' semanas',
      ];
      if (braqui) subPartes.push('raza braquicéfala: nada de esfuerzo intenso ni calor por encima de 25 °C');
      if (edad === 'cachorro') subPartes.push('cachorro: nada de correr en superficie dura');

      return {
        total: dec(minutos, 0) + ' minutos por día',
        sub: subPartes.join(' · '),
        rows: rows,
        chart: bandas,
        format: 'unit',
        unit: 'minutos',
        decimals: 0,
        position: Math.max(0, Math.min(100, (minutos / tope) * 100)),
        positionLabel: dec(minutos, 0) + ' minutos por día · intensidad ' + intensidad,
      };
    });
  })();
</script>
