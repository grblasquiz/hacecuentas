---
/**
 * Hub de decisión — "¿Cuántos años humanos tiene mi perro?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer.
 * La página sólo aporta datos (src/lib/hubs/edad-del-perro.ts) y su compute().
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EdadPerroExperience from '../../components/generated/EdadPerroExperience.astro';
import { hub, TAMANOS, RAZAS, AJUSTES, ETAPAS } from '../../lib/hubs/edad-del-perro';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <EdadPerroExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ TAMANOS, RAZAS, AJUSTES, ETAPAS }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay pesos: TODAS las filas declaran su formato.
    const ANIOS = { format: 'unit', unit: 'años', decimals: 1 };
    const HUM = { format: 'unit', unit: 'años humanos', decimals: 0 };
    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt);

    const dec = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });

    /**
     * Tabla AAHA/AKC ajustada por tamaño: año 1 = 15 años humanos, el año 2
     * suma 9 (total 24) y de ahí en más suma `rate` por año según el tamaño.
     * NO es multiplicar por 7 ni una recta.
     */
    function humanaAAHA(edad, rate) {
      if (edad <= 0) return 0;
      if (edad <= 1) return edad * 15;
      if (edad <= 2) return 15 + (edad - 1) * 9;
      return 24 + (edad - 2) * rate;
    }

    /** Curva epigenética UCSD 2019 (metilación del ADN), ajustada por tamaño. */
    function humanaUCSD(edad, factor) {
      if (edad <= 0) return 0;
      const base = edad < 1 ? 15 * edad : 16 * Math.log(edad) + 31;
      return base * factor;
    }

    H.onCompute(function (v) {
      const edad = Math.max(0, Math.min(25, v.edad || 0));
      const razaId = String(v.raza || 'mestizo');
      const raza = RAZAS[razaId];
      // Si eligió raza, el tamaño sale de la raza; si no, del select de tamaño.
      const tamId = raza ? raza.tamano : String(v.tamano || 'mediano');
      const T = TAMANOS[tamId] || TAMANOS.mediano;

      if (!edad) {
        return { total: '—', sub: 'Ingresá la edad de tu perro.', rows: [], chart: [] };
      }

      // ── Expectativa de vida: base de la raza (o del tamaño) + ajustes ──
      const base = raza ? raza.vida : T.vida;
      let ajuste = 0;
      if (String(v.castrado || 'si') === 'si') ajuste += AJUSTES.castrado;
      const cuidados = String(v.cuidados || 'medios');
      if (cuidados === 'altos') ajuste += AJUSTES.cuidadosAltos;
      else if (cuidados === 'bajos') ajuste += AJUSTES.cuidadosBajos;
      // La expectativa nunca puede caer por debajo del umbral senior + 1 año:
      // rompería el orden de las etapas del gráfico.
      const vida = Math.max(AJUSTES.minimo, T.senior + 1, base + ajuste);

      const aaha = humanaAAHA(edad, T.rate);
      const ucsd = humanaUCSD(edad, T.factor);
      const mito = edad * 7;
      const restante = Math.max(0, vida - edad);

      // ── Etapas de vida, con los cortes ajustados al tamaño ──
      const fin = Math.max(vida + 3, edad + 1);
      const bandas = [
        { label: 'Cachorro', from: 0, to: 1, tone: 'good' },
        { label: 'Adulto joven', from: 1, to: 3, tone: 'exit' },
        { label: 'Adulto', from: 3, to: T.senior, tone: 'main' },
        { label: 'Senior', from: T.senior, to: vida, tone: 'warn' },
        { label: 'Geronte', from: vida, to: fin, tone: 'bad' },
      ];
      let etapa = ETAPAS[0];
      if (edad >= vida) etapa = ETAPAS[4];
      else if (edad >= T.senior) etapa = ETAPAS[3];
      else if (edad >= 3) etapa = ETAPAS[2];
      else if (edad >= 1) etapa = ETAPAS[1];

      const pos = Math.max(0, Math.min(100, (edad / fin) * 100));

      const rows = [
        row('Edad real de tu perro', edad, ANIOS, false, T.label),
        row('Equivalencia en años humanos (AAHA/AKC)', aaha, HUM, true, 'por tamaño'),
        row('Lectura biológica (curva epigenética)', ucsd, HUM, false, 'UCSD 2019'),
        row('Lo que daría el mito de multiplicar por 7', mito, HUM, false, 'no lo uses'),
        row('Cuánto suma ahora cada año de perro', edad < 1 ? 15 : edad < 2 ? 9 : T.rate, HUM, false, 'AAHA'),
        row('Empieza la etapa senior', T.senior, ANIOS, false, T.label),
        row('Expectativa de vida estimada', vida, ANIOS, true, raza ? raza.nombre : 'por tamaño'),
        row('Le quedarían por delante', restante, ANIOS, false, 'promedio'),
      ];

      const subPartes = [
        dec(edad, 1) + ' años',
        raza ? raza.nombre : 'tamaño ' + T.label,
        etapa,
        'expectativa ' + dec(vida, 1) + ' años',
      ];
      if (restante > 0) subPartes.push('le quedarían unos ' + dec(restante, 1) + ' años');
      else subPartes.push('ya superó la expectativa media: cada año extra es un regalo');

      return {
        total: dec(aaha, 0) + ' años humanos',
        sub: subPartes.join(' · '),
        rows: rows,
        chart: bandas,
        // Default del resultado: años (acá no hay pesos).
        format: 'unit',
        unit: 'años',
        decimals: 1,
        position: Number(pos.toFixed(1)),
        positionLabel: dec(edad, 1) + ' años · ' + etapa + ' · equivale a ' + dec(aaha, 0) + ' humanos',
      };
    });
  })();
</script>
