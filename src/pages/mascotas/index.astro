---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MascotasHomeExperience from '../../components/generated/MascotasHomeExperience.astro';
const canonical='https://hacecuentas.com/mascotas';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Mascotas",url:canonical,operatingSystem:'Web'};
---
<Layout title="Calculadoras para perros, gatos y otras mascotas | Hacé Cuentas" description="Calculá edad, alimento, peso, gestación, costos y cuidados de perros, gatos y otras mascotas con referencias veterinarias y límites claros." canonical={canonical} schema={schema} lang="es">
  <Header />
  <MascotasHomeExperience />
  <Footer />
</Layout>
