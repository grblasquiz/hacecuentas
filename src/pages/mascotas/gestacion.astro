---
/**
 * Hub de decisión — "¿Cuánto dura la gestación de mi perra?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer.
 * Acá NO hay pesos: el resultado declara format 'unit' y cada fila el suyo.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GestacionMascotasExperience from '../../components/generated/GestacionMascotasExperience.astro';
import { hub, ESPECIES, RAZAS, BRAQUICEFALAS, ETAPAS } from '../../lib/hubs/reproduccion';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <GestacionMascotasExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ ESPECIES, RAZAS, BRAQUICEFALAS, ETAPAS }}>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay pesos: TODAS las filas declaran su formato.
    const DIAS = { format: 'unit', unit: 'días', decimals: 0 };
    const SEM = { format: 'unit', unit: 'semanas', decimals: 0 };
    const CRIAS = { format: 'unit', unit: 'cachorros', decimals: 0 };
    const MESES = { format: 'unit', unit: 'meses', decimals: 0 };
    const row = (k, v, fmt, extra, ref) => Object.assign({ k: k, v: v, extra: !!extra, ref: ref }, fmt || {});

    const MES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
    const fmtDate = (d) => d.getDate() + ' de ' + MES[d.getMonth()] + ' de ' + d.getFullYear();
    const fmtCorta = (d) => d.getDate() + ' de ' + MES[d.getMonth()];
    const masDias = (d, n) => { const x = new Date(d.getTime()); x.setDate(x.getDate() + n); return x; };

    /**
     * Camada esperada. Espejo exacto de cachorros-camada-raza.ts, incluido el
     * detalle de que el promedio se calcula ANTES de redondear min y max.
     */
    function camada(razaId, primera, edad) {
      const r = RAZAS[razaId] || RAZAS['labrador-retriever'];
      let min = r.min, max = r.max;
      if (primera) { min *= 0.75; max *= 0.75; }
      if (edad === 'mayor') { min *= 0.7; max *= 0.8; }
      return { min: Math.round(min), max: Math.round(max), estimados: Math.round((min + max) / 2), nombre: r.nombre };
    }

    H.onCompute(function (v) {
      const especieId = String(v.especie || 'perro');
      const E = ESPECIES[especieId] || ESPECIES.perro;
      const esPerra = especieId === 'perro';

      const partes = String(v.fechaMonta || '').split('-').map(Number);
      if (partes.length !== 3 || partes.some(isNaN)) {
        return { total: '—', sub: 'Elegí la fecha de la monta arriba.', rows: [], chart: [], format: 'unit', unit: 'días' };
      }
      const monta = new Date(partes[0], partes[1] - 1, partes[2]);
      if (isNaN(monta.getTime())) {
        return { total: '—', sub: 'La fecha de la monta no es válida.', rows: [], chart: [], format: 'unit', unit: 'días' };
      }

      const hoy = new Date();
      hoy.setHours(0, 0, 0, 0);

      const parto = masDias(monta, E.dias);
      const rangoMin = masDias(monta, E.dias - E.margen);
      const rangoMax = masDias(monta, E.dias + E.margen);

      // Espejo de gestacion-perra.ts: Math.round, no Math.floor.
      const transcurridos = Math.round((hoy.getTime() - monta.getTime()) / 86400000);
      const restantes = E.dias - transcurridos;
      const semana = Math.floor(Math.max(transcurridos, 0) / 7) + 1;
      const semanasTotal = Math.ceil(E.dias / 7);

      // ── Etapas: las de la perra son hitos reales (21/35/47/63). Para las
      //    otras especies se escalan proporcionalmente sobre su duración.
      const escala = E.dias / 63;
      const bandas = [];
      let desde = 0;
      for (let i = 0; i < ETAPAS.length; i++) {
        const hasta = i === ETAPAS.length - 1 ? E.dias : Math.round(ETAPAS[i].hasta * escala);
        if (hasta <= desde) continue;
        bandas.push({ label: ETAPAS[i].nombre, from: desde, to: hasta, tone: ETAPAS[i].tone });
        desde = hasta;
      }

      const dentro = Math.max(0, Math.min(transcurridos, E.dias));
      const pos = (dentro / E.dias) * 100;

      const rows = [
        row('Duración de la gestación', E.dias, DIAS, false, E.nombre.toLowerCase() + ' · desde la monta'),
        row('Rango normal de parto', E.margen * 2, DIAS, false, fmtCorta(rangoMin) + ' a ' + fmtCorta(rangoMax)),
        row('Días transcurridos desde la monta', Math.max(transcurridos, 0), DIAS, false, transcurridos < 0 ? 'la monta todavía no ocurrió' : 'hasta hoy'),
        row('Días que faltan para el parto estimado', Math.max(restantes, 0), DIAS, true, restantes < 0 ? 'la fecha estimada ya pasó' : fmtCorta(parto)),
        row('Semana de gestación', transcurridos < 0 ? 0 : Math.min(semana, semanasTotal), SEM, false, 'de ' + semanasTotal),
      ];

      let camadaTxt = '';
      if (esPerra) {
        const C = camada(String(v.raza || 'labrador-retriever'), String(v.primeraCamada || 'no') === 'si', String(v.edadPerra || 'joven'));
        rows.push(row('Cachorros esperados', C.estimados, CRIAS, true, C.nombre + ' · rango ' + C.min + ' a ' + C.max));
        rows.push(row('Mínimo típico de la raza', C.min, CRIAS, false, C.nombre));
        rows.push(row('Máximo típico de la raza', C.max, CRIAS, false, 'la radiografía después del día 45 da el número real'));
        camadaTxt = 'unos ' + C.estimados + ' cachorros (' + C.min + ' a ' + C.max + ')';

        // ── Próximo celo: monta + ciclo, con el margen de ±15 días de fecha-celo-perra.ts
        const ciclo = Number(v.ciclo) || 6;
        const proximoCelo = new Date(monta.getTime());
        proximoCelo.setMonth(proximoCelo.getMonth() + ciclo);
        const faltanCelo = Math.ceil((proximoCelo.getTime() - hoy.getTime()) / 86400000);
        rows.push(row('Ciclo entre celos', ciclo, MESES, false, 'próximo celo estimado: ' + fmtCorta(proximoCelo) + ' ±15 días'));
        rows.push(row('Días hasta el próximo celo', Math.max(faltanCelo, 0), DIAS, false, faltanCelo < 0 ? 'la fecha estimada ya pasó' : 'fase fértil: días 9 a 14 del celo'));
      }

      // ── Línea de contexto: nunca da indicación clínica, siempre manda al veterinario ──
      let sub;
      if (transcurridos < 0) {
        sub = 'La monta todavía no ocurrió. Si se concreta ese día, el parto caería alrededor del ' + fmtDate(parto) +
          ', con rango normal entre el ' + fmtCorta(rangoMin) + ' y el ' + fmtCorta(rangoMax) + '.';
      } else if (transcurridos > E.dias + E.margen) {
        sub = 'Pasaron ' + transcurridos + ' días desde la monta y ya se superó el rango normal. Si tu ' + E.hembra +
          ' todavía no parió, llamá al veterinario hoy: la gestación prolongada es una urgencia.';
      } else if (transcurridos >= E.dias - 16) {
        sub = 'Recta final: semana ' + Math.min(semana, semanasTotal) + ' de ' + semanasTotal + ', faltan unos ' +
          Math.max(restantes, 0) + ' días. Tené el nido armado y el teléfono del veterinario a mano' +
          (esPerra && BRAQUICEFALAS.indexOf(String(v.raza)) >= 0 ? '; en esta raza la cesárea programada es habitual, conversala antes' : '') + '.';
      } else {
        sub = 'Día ' + transcurridos + ' de ' + E.dias + ' · semana ' + Math.min(semana, semanasTotal) + ' de ' + semanasTotal +
          ' · rango de parto entre el ' + fmtCorta(rangoMin) + ' y el ' + fmtCorta(rangoMax) +
          (camadaTxt ? ' · ' + camadaTxt : '') + '. La ecografía va cerca del día 28 y la radiografía después del 45.';
      }

      const etapaHoy = (function () {
        for (let i = 0; i < bandas.length; i++) if (dentro < bandas[i].to) return bandas[i].label;
        return bandas.length ? bandas[bandas.length - 1].label : '';
      })();

      return {
        total: fmtDate(parto),
        sub: sub,
        rows: rows,
        chart: bandas,
        format: 'unit',
        unit: 'días',
        decimals: 0,
        position: Number(pos.toFixed(1)),
        positionLabel:
          transcurridos < 0
            ? 'Todavía no empezó'
            : 'Día ' + dentro + ' de ' + E.dias + ' · semana ' + Math.min(semana, semanasTotal) + ' de ' + semanasTotal + ' · etapa ' + etapaHoy.toLowerCase(),
      };
    });
  })();
</script>
