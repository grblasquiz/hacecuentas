    background: linear-gradient(135deg, var(--bg-soft) 0%, var(--bg) 100%);
    border: 1px solid var(--border);
    border-left: 4px solid var(--cat-color);
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
  }
  .cat-head-text { flex: 1; min-width: 0; }
  /* Banner ilustrado por categoría (decorativo). Oculto en mobile para no
     competir con el título ni empujar el contenido. */
  .cat-banner {
    flex-shrink: 0;
    align-self: center;
    width: clamp(160px, 22vw, 240px);
    height: auto;
    border-radius: var(--radius);
