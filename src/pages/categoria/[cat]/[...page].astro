import { groupCalcs, featuredCalcs, cleanDesc } from '../../../lib/category-layout';
import CategoryIcon from '../../../components/CategoryIcon.astro';
import { categoryColor, categoryDomain } from '../../../lib/category-colors';
import { canDistributeCalc } from '../../../lib/content-policy';
import PillarHub from '../../../components/PillarHub.astro';
