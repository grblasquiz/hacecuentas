  }
  .intro { margin: 0 0 0.9rem; color: var(--text-muted); font-size: 1rem; line-height: 1.6; max-width: 62ch; }
  .count { font-size: 0.8125rem; color: var(--text-subtle); font-weight: 500; }

  .quick-stats {
