// Markdown → HTML. Maneja tablas GFM de verdad: detecta el bloque
// (fila header + fila separadora |---| + filas body), lo convierte a
// <table> con <thead>/<th>, saltea la fila separadora y lo envuelve en
// .tbl-wrap (scroll-x en mobile). Antes: los <tr> salían sin <table> y la
// fila |---| quedaba como texto crudo → la tabla se veía como un string.
function md(text: string): string {
  const tables: string[] = [];
  const lines = text.split('\n');
  const out: string[] = [];
  const isRow = (l: string) => /^\s*\|.*\|\s*$/.test(l);
  const isSep = (l: string) => isRow(l) && l.replace(/[\s|:\-]/g, '') === '';
  const cells = (l: string) => l.trim().replace(/^\|/, '').replace(/\|$/, '').split('|').map((c) => c.trim());
  for (let i = 0; i < lines.length; i++) {
    if (isRow(lines[i]) && i + 1 < lines.length && isSep(lines[i + 1])) {
      const head = cells(lines[i]);
      i += 2;
      const body: string[][] = [];
      while (i < lines.length && isRow(lines[i]) && !isSep(lines[i])) { body.push(cells(lines[i])); i++; }
      i--; // compensar el i++ del for
      const thead = '<thead><tr>' + head.map((c) => `<th>${c}</th>`).join('') + '</tr></thead>';
      const tbody = '<tbody>' + body.map((r) => '<tr>' + r.map((c) => `<td>${c}</td>`).join('') + '</tr>').join('') + '</tbody>';
      tables.push(`<div class="tbl-wrap"><table>${thead}${tbody}</table></div>`);
      out.push(`@@TBL${tables.length - 1}@@`);
    } else {
      out.push(lines[i]);
    }
  }
  let html = out.join('\n')
    .replace(/^### (.+)$/gm, '<h3>$1</h3>')
    .replace(/^## (.+)$/gm, '<h2>$1</h2>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2" rel="noopener">$1</a>')
    .replace(/^\- (.+)$/gm, '<li>$1</li>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/\n/g, '<br>');
  // Restaurar tablas como bloque: cerrar el <p> actual, insertar y reabrir,
  // comiendo los <br> colgantes alrededor del placeholder.
  html = html.replace(/(?:<br>\s*)*@@TBL(\d+)@@(?:\s*<br>)*/g, (_m, n) => '</p>' + tables[+n] + '<p>');
  return html;
}
