  }
  .card:hover .card-arrow { color: var(--cat-color, var(--accent)); transform: translateX(2px); }

  .card-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
  }
  .card:hover .card-icon { background: color-mix(in srgb, var(--cat-color, var(--accent)) 14%, var(--bg-soft)); }
  .card-body { flex: 1; min-width: 0; }
  .card-title { font-weight: 650; font-size: 0.9375rem; margin-bottom: 0.2rem; line-height: 1.3; color: var(--text); }
  .ar-badge {
    margin-left: 0.4em;
    font-size: 0.8em;
    vertical-align: middle;
    line-height: 1;
    display: inline-block;
  }
  .card-desc {
    font-size: 0.8rem;
    color: var(--text-subtle);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-arrow { flex-shrink: 0; color: var(--text-subtle); transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s; margin-top: 0.5rem; }

  /* ===== Filtro por país (Task 4) ===== */
  .cat-country { display: inline-flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; }
  .ctry-label {
    display: inline-flex; align-items: center; gap: 0.28rem;
    font-size: 0.78rem; font-weight: 600; color: var(--text-muted);
    margin-right: 0.1rem; white-space: nowrap;
  }
  .ctry-label svg { color: var(--accent); }
  .ctry-tab {
    padding: 0.32rem 0.65rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
