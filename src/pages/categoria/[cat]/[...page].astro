const PAGE_SIZE = 60;

export async function getStaticPaths() {
  const calcsGlob = import.meta.glob<any>('../../../content/calcs/*.json', { eager: true });
  const all = Object.values(calcsGlob).map((m: any) => m.default || m);
  // Solo regenerar las categorías afectadas en incremental.
  const cats = [...new Set(all.map((c) => c.category))].filter(shouldBuildCategory);
  const paths: any[] = [];
  for (const cat of cats) {
    const filtered = all.filter((c) => c.category === cat && canDistributeCalc(c));
    const totalPages = Math.max(1, Math.ceil(filtered.length / 60));
    for (let i = 1; i <= totalPages; i++) {
      const start = (i - 1) * 60;
      paths.push({
        params: { cat, page: i === 1 ? undefined : String(i) },
        props: {
          cat,
          calcs: filtered.slice(start, start + 60),
          currentPage: i,
          totalPages,
          totalCalcs: filtered.length,
          featured: i === 1 ? featuredCalcs(cat, filtered) : [],
        },
      });
    }
  }
  return paths;
}

const { cat, calcs, currentPage, totalPages, totalCalcs, featured = [] } = Astro.props;
const isFirstPage = currentPage === 1;

