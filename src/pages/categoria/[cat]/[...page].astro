  {groups && (
    <p class="sub-active" id="sub-active" hidden>
      Mostrando solo <strong id="sub-active-name"></strong>.
      <a href={pagePath} id="sub-active-clear">Ver todas las {totalCalcs} de {m.label.toLowerCase()} →</a>
    </p>
  )}

  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="cat-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>
    </symbol>
  </svg>

  <div id="cat-grid" style={`--cat-color: ${m.color}`}>
    {renderGroups.map((g: any) => (
      <section class="cat-group" id={g.id ? `g-${g.id}` : undefined} data-group data-group-title={g.title || undefined}>
        {g.title && (
          <h2 class="group-h">
            <span class="group-icon" aria-hidden="true">{g.icon}</span>
            {g.title}
            <span class="group-n">{g.calcs.length}</span>
          </h2>
        )}
        <div class="grid">
          {g.calcs.map((c: any) => (
            <a
              href={`/${c.slug}`}
              class="card"
              data-title={(c.h1 || '').toLowerCase()}
              data-date={c.lastReviewed || c.dataUpdate?.lastUpdated || ''}
              data-aud={c.audience === 'AR' ? 'AR' : 'global'}
            >
              <div class="card-icon">{c.icon}</div>
              <div class="card-body">
                <div class="card-title">
                  {c.h1}
                  {c.audience === 'AR' && (
                    <span class="ar-badge" title="Específica para Argentina" aria-label="Específica para Argentina">🇦🇷</span>
                  )}
                </div>
                <div class="card-desc">{cleanDesc(c.description)}</div>
              </div>
              <div class="card-arrow" aria-hidden="true">
                <svg width="18" height="18"><use href="#cat-arrow"/></svg>
              </div>
            </a>
          ))}
        </div>
        {g.id && g.title && g.calcs.length > 1 && (
          <div class="group-foot">
            <a class="group-see-all" href={`?sub=${g.id}`} data-sub={g.id}>
              Ver las {g.calcs.length} de {g.title} →
            </a>
          </div>
        )}
      </section>
    ))}
  </div>

  <div class="cat-empty" id="cat-empty" hidden>
    <img class="cat-empty-illu" src="/img/empty-search.webp" alt="Sin resultados para la búsqueda actual" width="200" height="133" decoding="async" />
    <p>No encontramos calculadoras que coincidan. Probá otro término o
    <a href="/buscar">buscá en todo el sitio</a>.</p>
  </div>

  {totalPages > 1 && (
    <nav class="pager" aria-label="Paginación de calculadoras">
      <div class="pager-info">
        Página <strong>{currentPage}</strong> de <strong>{totalPages}</strong> · {totalCalcs} calculadoras
      </div>
      <div class="pager-controls">
        {currentPage > 1 && (
          <a class="pager-btn" rel="prev" href={currentPage === 2 ? `/categoria/${cat}` : `/categoria/${cat}/${currentPage - 1}`}>
            ← Anterior
          </a>
        )}
        <ol class="pager-pages">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <li>
              {n === currentPage ? (
                <span class="pager-current" aria-current="page">{n}</span>
              ) : (
                <a href={n === 1 ? `/categoria/${cat}` : `/categoria/${cat}/${n}`}>{n}</a>
              )}
            </li>
          ))}
        </ol>
        {currentPage < totalPages && (
          <a class="pager-btn" rel="next" href={`/categoria/${cat}/${currentPage + 1}`}>
            Siguiente →
          </a>
        )}
      </div>
    </nav>
  )}

  <script is:inline define:vars={{ catSlug: cat }}>
    (function () {
      var input = document.getElementById('cat-filter-' + catSlug);
      var grid = document.getElementById('cat-grid');
      var counter = document.querySelector('.cat-filter-count');
      var empty = document.getElementById('cat-empty');
      var featured = document.querySelector('.featured');
      var chips = document.querySelector('.chips');
      if (!input || !grid || !counter) return;
      function norm(s) { return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }

      // Texto buscable pre-computado del DOM (title + desc). La normalizaci\u00f3n
      // corre una sola vez al cargar; el filtro per-keystroke s\u00f3lo hace includes().
      // Guardamos tambi\u00e9n posici\u00f3n original (parent + siguiente hermano) para poder
      // restaurar el orden curado tras ordenar A-Z / M\u00e1s nuevas.
      var cards = Array.from(grid.querySelectorAll('.card')).map(function (el, i) {
        var t = el.querySelector('.card-title');
        var d = el.querySelector('.card-desc');
        return {
          el: el,
          idx: i,
          text: norm(((t && t.textContent) || '') + ' ' + ((d && d.textContent) || '')),
          title: norm(el.getAttribute('data-title') || ''),
          date: el.getAttribute('data-date') || '',
          aud: el.getAttribute('data-aud') || 'global',
          parent: el.parentNode,
          next: el.nextSibling,
        };
      });
      // Secciones de sub-tema: se ocultan cuando ninguna card matchea.
      var groupEls = Array.from(grid.querySelectorAll('[data-group]'));
      var total = cards.length;

      // ---- Ordenamiento (Task 4) ----------------------------------------
      var sortTabs = Array.from(document.querySelectorAll('.cat-sort .sort-tab'));
      var sortMode = 'featured';
      // Grilla destino para el modo plano (A-Z / nuevas): la del primer grupo.
      var flatGrid = grid.querySelector('.grid');

      function restoreOrder() {
        // Devolver cada card a su grupo y posici\u00f3n original (orden curado).
        cards.slice().sort(function (a, b) { return a.idx - b.idx; }).forEach(function (c) {
          if (c.next && c.next.parentNode === c.parent) c.parent.insertBefore(c.el, c.next);
          else c.parent.appendChild(c.el);
        });
      }

      function applySort() {
        if (sortMode === 'featured' || !flatGrid) {
          grid.classList.remove('cat-sorting');
          restoreOrder();
          return;
        }
        grid.classList.add('cat-sorting');
        var ordered = cards.slice();
        if (sortMode === 'az') {
          ordered.sort(function (a, b) { return a.title.localeCompare(b.title); });
        } else if (sortMode === 'new') {
          // Fecha desc; sin fecha al final. Comparaci\u00f3n de strings ISO = cronol\u00f3gica.
          ordered.sort(function (a, b) {
            if (a.date === b.date) return a.idx - b.idx;
            if (!a.date) return 1;
            if (!b.date) return -1;
            return a.date < b.date ? 1 : -1;
          });
        }
        // Mover todas las cards a la grilla plana en el nuevo orden.
        ordered.forEach(function (c) { flatGrid.appendChild(c.el); });
      }

      sortTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          sortMode = tab.getAttribute('data-sort') || 'featured';
          sortTabs.forEach(function (t) { t.setAttribute('aria-pressed', String(t === tab)); });
          applySort();
          apply();
        });
      });

      // ---- Filtro por sub-grupo via ?sub= (Task 5) -----------------------
      var subActive = document.getElementById('sub-active');
      var subName = document.getElementById('sub-active-name');
      var subFilter = null; // id de grupo activo o null
      function readSub() {
        try { return new URLSearchParams(location.search).get('sub'); } catch (e) { return null; }
      }
      function setSub(id, push) {
        // Resolver el grupo ANTES de fijar el filtro: si ?sub= apunta a un grupo
        // inexistente (link viejo, grupo podado/renombrado, build stale), lo tratamos
        // como "sin filtro". Si no, subFilter esconde TODAS las cards (visible=0) →
        // "No encontramos…" + banner "Mostrando solo ." vacío, con decenas de calcs.
        var g = id ? grid.querySelector('[data-group][id="g-' + id + '"]') : null;
        subFilter = g ? id : null;
        try {
          var url = new URL(location.href);
          if (subFilter) url.searchParams.set('sub', subFilter); else url.searchParams.delete('sub');
          if (push) history.pushState({}, '', url);
        } catch (e) {}
        if (subActive && subName) {
          subName.textContent = g ? (g.getAttribute('data-group-title') || '') : '';
          subActive.hidden = !g;
        }
      }

      // ---- Filtro por pa\u00eds (Task 4) -------------------------------------
      // all | AR | global. Compone con texto y sub-grupo dentro de apply().
      var ctryTabs = Array.from(document.querySelectorAll('.cat-country .ctry-tab'));
      var ctryFilter = 'all';
      ctryTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          ctryFilter = tab.getAttribute('data-ctry') || 'all';
          ctryTabs.forEach(function (t) { t.setAttribute('aria-pressed', String(t === tab)); });
          apply();
        });
      });

      // ---- Densidad: tarjetas / lista compacta (Task 3) ------------------
      // 100% CSS: alterna una clase en #cat-grid. Las mismas .card siguen en el
      // DOM (crawlable) y el filtro/orden no se enteran.
      var dnsTabs = Array.from(document.querySelectorAll('.cat-density .dns-tab'));
      dnsTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var mode = tab.getAttribute('data-density') || 'cards';
          grid.classList.toggle('cat-compact', mode === 'list');
          dnsTabs.forEach(function (t) {
            var on = t === tab;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-pressed', String(on));
          });
          try { localStorage.setItem('hc-cat-density', mode); } catch (e) {}
        });
      });
      // Restaurar preferencia de densidad.
      try {
        var savedDns = localStorage.getItem('hc-cat-density');
        if (savedDns === 'list') {
          var listTab = document.querySelector('.cat-density .dns-tab[data-density="list"]');
          if (listTab) listTab.click();
        }
      } catch (e) {}

      // ---- Filtro de texto + composici\u00f3n con sub-grupo --------------------
      function apply() {
        var q = norm(input.value.trim());
        var flattening = !!q || sortMode !== 'featured' || ctryFilter !== 'all';
        // Mientras se filtra/ordena en plano, escondemos "M\u00e1s usadas" y los chips:
        // el resultado plano es m\u00e1s claro y evita cards duplicadas. La clase
        // cat-filtering oculta los headers de grupo (cuyo contador es el total del
        // grupo, no el filtrado) \u2192 queda una lista plana.
        if (featured) featured.hidden = flattening || !!subFilter;
        if (chips) chips.hidden = flattening || !!subFilter;
        grid.classList.toggle('cat-filtering', flattening);

        var visible = 0;
        cards.forEach(function (c) {
          var match = !q || c.text.indexOf(q) !== -1;
          if (match && ctryFilter !== 'all' && c.aud !== ctryFilter) match = false;
          if (match && subFilter) {
            var grp = c.el.closest('[data-group]');
            if (!grp || grp.id !== 'g-' + subFilter) match = false;
          }
          c.el.hidden = !match;
          if (match) visible++;
        });
        // En modo curado (sin q, sin orden plano), un grupo se oculta si no le
        // quedan cards visibles (p.ej. por sub-filtro).
        if (!flattening) {
          groupEls.forEach(function (g) { g.hidden = !g.querySelector('.card:not([hidden])'); });
        } else {
          groupEls.forEach(function (g) { g.hidden = false; });
        }
        var catTotal = counter.getAttribute('data-cat-total') || total;
        if (q || subFilter || ctryFilter !== 'all') counter.textContent = 'Mostrando ' + visible + ' de ' + total + ' calculadoras en esta página';
        else counter.textContent = (String(catTotal) !== String(total)) ? ('Mostrando ' + total + ' de ' + catTotal + ' calculadoras') : ('Mostrando las ' + total + ' calculadoras');
        if (empty) empty.hidden = visible > 0;
      }

      input.addEventListener('input', apply);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { input.value = ''; apply(); input.blur(); }
      });

      // Click en "Ver las N de {subgrupo}" \u2192 filtra sin recargar.
      grid.addEventListener('click', function (e) {
        var link = e.target.closest ? e.target.closest('.group-see-all') : null;
        if (!link) return;
        e.preventDefault();
        var id = link.getAttribute('data-sub');
        // Ordenar fuerza modo plano sin grupos \u2192 reseteamos a curado para filtrar.
        if (sortMode !== 'featured') {
          sortMode = 'featured';
          sortTabs.forEach(function (t) { t.setAttribute('aria-pressed', String(t.getAttribute('data-sort') === 'featured')); });
          applySort();
        }
        setSub(id, true);
        apply();
        if (subActive) subActive.scrollIntoView({ block: 'nearest' });
      });

      // Reset del banner de sub-grupo sin recargar.
      var subClear = document.getElementById('sub-active-clear');
      if (subClear) subClear.addEventListener('click', function (e) {
        if (subFilter) { e.preventDefault(); setSub(null, true); apply(); }
      });

      window.addEventListener('popstate', function () { setSub(readSub(), false); apply(); });

      // Estado inicial desde ?sub= (deep-link / refresh).
      setSub(readSub(), false);
      apply();
    })();
  </script>

  {isFirstPage && m.seoContent && (
    <section class="seo-content">
      <Fragment set:html={`<p>${md(m.seoContent)}</p>`} />
    </section>
  )}

  {isFirstPage && m.faq.length > 0 && (
    <section class="faq">
      <h2>Preguntas frecuentes sobre {m.label}</h2>
      <div class="faq-list">
        {m.faq.map((f) => (
          <details>
            <summary>
              <span>{f.q}</span>
              <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div set:html={`<p>${md(f.a)}</p>`} />
          </details>
        ))}
      </div>
    </section>
  )}

  {siblings.length > 0 && (
    <section class="cat-siblings">
      <h2>Categorías relacionadas</h2>
      <div class="sib-grid">
        {siblings.map((sc: string) => (
          <a href={`/categoria/${sc}`} class="sib-card" style={`--cat-color: ${categoryColor(sc)}`}>
            <span class="sib-icon"><CategoryIcon cat={sc} fallback={CATEGORY_ICONS[sc] || '🧮'} size={20} /></span>
            <span class="sib-name">{CATEGORY_TITLES[sc] || sc}</span>
            <span class="sib-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <aside class="cta-back">
    <p>¿Buscás otra categoría?</p>
    <a href="/" class="btn-ghost">Ver todas las calculadoras →</a>
    <a href="/guias" class="btn-ghost-alt">📘 Ver todas las guías</a>
  </aside>

  </div>{/* /.cat-listing */}

  <Footer slot="footer" />
</Layout>

<style>
  /* Página 1: el hub (PillarHub) va full-bleed (pageType="hub" → main sin ancho
     máximo); este contenedor re-centra el listado/SEO/FAQ debajo del hub. */
  .cat-listing.hub-listing {
    width: min(1180px, calc(100% - 40px));
    margin: 2.25rem auto 0;
  }
  .breadcrumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    margin-bottom: 1.75rem;
  }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }
  .breadcrumbs .sep { color: var(--border-strong); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }
  /* Link destacado a la guía pilar, alineado al final del breadcrumb. */
  .breadcrumbs .bc-guide {
    margin-left: auto;
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }
  .breadcrumbs .bc-guide:hover { text-decoration: underline; }
