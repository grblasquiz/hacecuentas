---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PillarHub from '../components/PillarHub.astro';
import { PILLAR_BY_SLUG } from '../lib/pillars';

const pillar = PILLAR_BY_SLUG['sueldos-y-trabajo'];
---

<Layout
  title={pillar.title}
  description={pillar.description}
  canonical={'/' + pillar.slug}
  audience="AR"
  domain={pillar.domain}
  pageType="hub"
>
  <Header slot="header" />
  <PillarHub pillar={pillar} />
  <Footer slot="footer" />
</Layout>
