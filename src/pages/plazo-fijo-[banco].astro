---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { freeOfferSchema } from '../lib/offer-schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPlazoFijoTop } from '../lib/plazo-fijo';

// Páginas por banco para el cluster "plazo fijo [banco]" (Keyword Planner jul-2026:
// nación 60.5k, provincia 18.1k, bbva 4.4k, macro 2.9k + santander/galicia/ciudad).
// La TNA se congela al build y se refresca con cada deploy (cron diario).
export async function getStaticPaths() {
  const BANCOS = [
    { banco: 'banco-nacion', feedKey: 'Nación', nombre: 'Banco Nación', gen: 'del Banco Nación' },
    { banco: 'banco-provincia', feedKey: 'Provincia BA', nombre: 'Banco Provincia', gen: 'del Banco Provincia' },
    { banco: 'bbva', feedKey: 'BBVA', nombre: 'BBVA', gen: 'de BBVA' },
    { banco: 'banco-macro', feedKey: 'Macro', nombre: 'Banco Macro', gen: 'del Banco Macro' },
    { banco: 'santander', feedKey: 'Santander', nombre: 'Santander', gen: 'de Santander' },
    { banco: 'galicia', feedKey: 'Galicia', nombre: 'Banco Galicia', gen: 'del Banco Galicia' },
    { banco: 'banco-ciudad', feedKey: 'Ciudad', nombre: 'Banco Ciudad', gen: 'del Banco Ciudad' },
  ];
  const tasas = await getPlazoFijoTop(14);
  return BANCOS.map((b) => {
    const fila = tasas.find((t) => t.banco === b.feedKey);
    const ranking = tasas.findIndex((t) => t.banco === b.feedKey);
    return {
      params: { banco: b.banco },
      props: {
        ...b,
        tna: fila ? fila.tna : null,
        ranking: ranking >= 0 ? ranking + 1 : null,
        top: tasas.slice(0, 6),
        totalBancos: tasas.length,
      },
    };
  });
}

const { banco, feedKey, nombre, gen, tna, ranking, top, totalBancos } = Astro.props;

const site = 'https://hacecuentas.com';
const PAGE_URL = `${site}/plazo-fijo-${banco}`;
const hoy = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());

const tnaTxt = tna ? `${tna.toLocaleString('es-AR', { maximumFractionDigits: 2 })}%` : null;
const title = tna
  ? `Plazo Fijo ${nombre}: tasa hoy ${tnaTxt} TNA + simulador | Hacé Cuentas`
  : `Plazo Fijo ${nombre}: simulador con la tasa de hoy | Hacé Cuentas`;
const description = tna
  ? `La tasa de plazo fijo ${gen} hoy es ${tnaTxt} TNA (BCRA). Simulá cuánto ganás con tu monto a 30, 60 o 90 días, mirá la TEA con renovación y comparalo con los demás bancos.`
  : `Simulá un plazo fijo ${gen}: cuánto ganás con tu monto a 30, 60 o 90 días, TEA con renovación y comparación con los demás bancos. Tasas oficiales informadas al BCRA.`;

// interés simple 30 días para la tabla de ejemplos
function interes30(monto: number): string {
  if (!tna) return '—';
  const i = monto * (tna / 100) * (30 / 365);
  return '$ ' + Math.round(i).toLocaleString('es-AR');
}

const faqs = [
  {
    q: `¿Cuál es la tasa de plazo fijo ${gen} hoy?`,
    a: tna
      ? `Al ${hoy}, la TNA para plazos fijos online de clientes es <strong>${tnaTxt}</strong> según los datos que el banco informa al BCRA. La tasa cambia seguido: acá se actualiza con cada publicación del BCRA.`
      : `El banco no está publicando su tasa online en el listado del BCRA en este momento. Mirá el <a href="/comparador-plazo-fijo">comparador de plazos fijos</a> para ver las tasas vigentes del resto de los bancos.`,
  },
  {
    q: `¿Cuánto gano con $1.000.000 a 30 días en ${nombre}?`,
    a: tna
      ? `Con la TNA actual de ${tnaTxt}: $1.000.000 × ${tnaTxt} × 30/365 ≈ <strong>${interes30(1000000)}</strong> de interés. El simulador de arriba te lo calcula para cualquier monto y plazo.`
      : `Depende de la tasa vigente del día. Cargá tu monto en el simulador con la TNA que te muestra el home banking y lo calculás al instante.`,
  },
  {
    q: '¿Cómo se calcula el interés de un plazo fijo?',
    a: 'Interés = monto × TNA × días ÷ 365. Por ejemplo, $500.000 al 30% TNA por 30 días: 500.000 × 0,30 × 30/365 = $12.328. La <strong>TNA</strong> (tasa nominal anual) es la que publican los bancos; si renovás todos los meses reinvirtiendo, el rendimiento efectivo anual (<strong>TEA</strong>) es mayor por el interés compuesto.',
  },
  {
    q: '¿Qué diferencia hay entre TNA y TEA?',
    a: 'La <strong>TNA</strong> es la tasa nominal anual: sirve para calcular el interés de un solo período. La <strong>TEA</strong> (tasa efectiva anual) refleja cuánto ganás en un año si renovás el plazo fijo cada vencimiento, reinvirtiendo capital e intereses. Con renovación mensual, TEA = (1 + TNA×30/365)^(365/30) − 1, siempre mayor que la TNA.',
  },
  {
    q: `¿Conviene el plazo fijo ${gen} o hay bancos que pagan más?`,
    a: `Las tasas cambian todos los días y la diferencia entre el banco que más paga y el que menos puede superar varios puntos. ${ranking && tna ? `Hoy ${nombre} está <strong>#${ranking} de ${totalBancos}</strong> bancos relevados.` : ''} Compará todas las tasas vigentes en el <a href="/comparador-plazo-fijo">comparador de plazos fijos</a> — muchos bancos permiten hacer plazo fijo online sin ser cliente.`,
  },
  {
    q: '¿Puedo hacer un plazo fijo online sin ser cliente del banco?',
    a: 'Sí. Desde 2020 el BCRA obliga a los bancos a aceptar <strong>plazos fijos web de no clientes</strong>: transferís desde tu banco, constituís el plazo fijo y al vencimiento el capital más los intereses vuelven a tu cuenta de origen. La tasa para no clientes puede diferir levemente de la de clientes.',
  },
  {
    q: '¿El plazo fijo tradicional le gana a la inflación?',
    a: 'Depende del momento: comparó la TNA contra la inflación mensual esperada (~2% en 2026). Si querés cobertura directa contra inflación, existe el <a href="/calculadora-plazo-fijo-uva-precancelable-rendimiento">plazo fijo UVA</a>, que ajusta el capital por CER y paga un plus, con mínimo de 180 días (precancelable a 30).',
  },
  {
    q: '¿Los intereses del plazo fijo pagan impuestos?',
    a: 'Para personas humanas, los intereses de plazos fijos en pesos están <strong>exentos de Ganancias</strong>. Sí computan para Bienes Personales si tu patrimonio total supera el mínimo no imponible (los depósitos a plazo en pesos están alcanzados; las cajas de ahorro, exentas).',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `Simulador de Plazo Fijo ${nombre}`,
  url: PAGE_URL,
  description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'es-AR',
  isAccessibleForFree: true,
  offers: freeOfferSchema({ priceCurrency: 'ARS' }),
};
const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Comparador de plazos fijos', item: `${site}/comparador-plazo-fijo` },
    { '@type': 'ListItem', position: 3, name: `Plazo fijo ${nombre}`, item: PAGE_URL },
  ],
};
const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
};

const OTROS = [
  { p: 'banco-nacion', n: 'Banco Nación' }, { p: 'banco-provincia', n: 'Banco Provincia' },
  { p: 'bbva', n: 'BBVA' }, { p: 'banco-macro', n: 'Banco Macro' },
  { p: 'santander', n: 'Santander' }, { p: 'galicia', n: 'Banco Galicia' },
  { p: 'banco-ciudad', n: 'Banco Ciudad' },
].filter((o) => o.p !== banco);
---

<Layout title={title} description={description} canonical={PAGE_URL} schema={schema} lang="es" domain="knowledge">
  <Header slot="header" />

  <article class="pfb-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/comparador-plazo-fijo">Plazos fijos</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">{nombre}</span>
    </nav>

    <h1>Plazo fijo {nombre}: tasa de hoy y simulador</h1>

    <div class="pfb-answer">
      {tna ? (
        <p>
          <strong>La tasa de plazo fijo {gen} hoy es {tnaTxt} TNA</strong> (plazo fijo online, datos informados al BCRA
          {ranking ? ` — puesto #${ranking} de ${totalBancos} bancos relevados` : ''}). Con $1.000.000 a 30 días ganás
          ≈ <strong>{interes30(1000000)}</strong>. Simulá tu monto abajo y comparalo con el resto de los bancos.
        </p>
      ) : (
        <p>
          <strong>{nombre} no está publicando su tasa online en el listado del BCRA en este momento.</strong> Cargá la TNA
          que te muestra tu home banking en el simulador, o mirá las tasas vigentes del resto en el
          <a href="/comparador-plazo-fijo"> comparador</a>.
        </p>
      )}
    </div>

    <div id="pfb" class="pfb-card" data-tna={tna ?? ''}>
      <div class="pfb-grid">
        <div class="pfb-field">
          <label for="pfbMonto">¿Cuánto querés depositar?</label>
          <input id="pfbMonto" type="text" inputmode="numeric" value="1.000.000" autocomplete="off" />
        </div>
        <div class="pfb-field">
          <label for="pfbDias">Plazo (días)</label>
          <select id="pfbDias">
            <option value="30" selected>30 días</option>
            <option value="60">60 días</option>
            <option value="90">90 días</option>
            <option value="180">180 días</option>
            <option value="365">365 días</option>
          </select>
        </div>
        <div class="pfb-field">
          <label for="pfbTna">TNA (%)</label>
          <input id="pfbTna" type="number" step="0.01" min="0" max="200" value={tna ?? 30} />
        </div>
      </div>
      <button id="pfbCalcular" type="button" class="pfb-btn">Calcular</button>
      <div id="pfbResultado" class="pfb-resultado" hidden>
        <div class="pfb-res-grid">
          <div><span class="pfb-res-label">Interés ganado</span><span class="pfb-res-num" id="pfbInteres">—</span></div>
          <div><span class="pfb-res-label">Total al vencimiento</span><span class="pfb-res-num" id="pfbTotal">—</span></div>
          <div><span class="pfb-res-label">TEA (renovando)</span><span class="pfb-res-num" id="pfbTea">—</span></div>
        </div>
      </div>
    </div>

    {tna && (
      <section class="pfb-sec">
        <h2>Cuánto ganás en {nombre} a 30 días (TNA {tnaTxt})</h2>
        <div class="pfb-table-wrap">
          <table class="pfb-table">
            <thead><tr><th>Depósito</th><th>Interés a 30 días</th><th>Total al vencimiento</th></tr></thead>
            <tbody>
              {[100000, 500000, 1000000, 5000000, 10000000].map((m) => (
                <tr>
                  <td>$ {m.toLocaleString('es-AR')}</td>
                  <td>{interes30(m)}</td>
                  <td>$ {(m + Math.round(m * (tna / 100) * (30 / 365))).toLocaleString('es-AR')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {top.length > 0 && (
      <section class="pfb-sec">
        <h2>¿Cómo está {nombre} contra los demás bancos hoy?</h2>
        <div class="pfb-table-wrap">
          <table class="pfb-table">
            <thead><tr><th>#</th><th>Banco</th><th>TNA online</th></tr></thead>
            <tbody>
              {top.map((t, i) => (
                <tr class={t.banco === feedKey ? 'pfb-row-hl' : ''}>
                  <td>{i + 1}</td>
                  <td>{t.banco}</td>
                  <td>{t.tna.toLocaleString('es-AR', { maximumFractionDigits: 2 })}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="pfb-nota">Top {top.length} de tasas online informadas al BCRA al último dato disponible. Ver el <a href="/comparador-plazo-fijo">ranking completo</a>.</p>
      </section>
    )}

    <section class="pfb-faq">
      <h2>Preguntas frecuentes</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="pfb-faq-a" set:html={f.a} />
        </details>
      ))}
    </section>

    <section class="pfb-sec">
      <h2>Plazo fijo en otros bancos</h2>
      <div class="pfb-related-grid">
        {OTROS.map((o) => (
          <a href={`/plazo-fijo-${o.p}`} class="pfb-related-card">🏦 <span>{o.n}</span></a>
        ))}
        <a href="/comparador-plazo-fijo" class="pfb-related-card">📊 <span>Comparador completo</span></a>
        <a href="/calculadora-plazo-fijo-uva-precancelable-rendimiento" class="pfb-related-card">📈 <span>Plazo fijo UVA</span></a>
      </div>
    </section>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaFaq)}></script>

  <Footer slot="footer" />
</Layout>

<style is:global>
  .pfb-page { max-width: 780px; margin: 0 auto; padding: 0 16px 48px; }
  .pfb-answer { background: var(--surface-2, #f1f5f9); border-radius: 12px; padding: 14px 18px; margin: 16px 0 20px; }
  .pfb-answer p { margin: 0; line-height: 1.6; }
  .pfb-card { border: 1px solid var(--border, #e2e8f0); border-radius: 16px; padding: 20px; background: var(--surface, #fff); box-shadow: 0 1px 3px rgba(0,0,0,.05); }
  .pfb-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 14px; }
  .pfb-field label { display: block; font-weight: 600; font-size: .85rem; margin-bottom: 6px; color: var(--text-2, #475569); }
  .pfb-field input, .pfb-field select { width: 100%; padding: 11px 12px; font-size: 1.05rem; border: 1px solid var(--border, #cbd5e1); border-radius: 10px; background: var(--surface, #fff); color: var(--text, #0f172a); }
  .pfb-field input:focus, .pfb-field select:focus { outline: 2px solid var(--accent, #2563eb); outline-offset: 1px; }
  .pfb-btn { background: var(--accent, #2563eb); color: #fff; font-weight: 700; border: none; border-radius: 10px; padding: 13px 28px; font-size: 1rem; cursor: pointer; }
  .pfb-btn:hover { filter: brightness(1.08); }
  .pfb-resultado { margin-top: 16px; border-top: 2px solid var(--accent, #2563eb); padding-top: 14px; }
  .pfb-res-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; }
  .pfb-res-label { display: block; font-size: .78rem; color: var(--text-2, #64748b); }
  .pfb-res-num { font-size: 1.45rem; font-weight: 800; color: var(--accent, #2563eb); font-variant-numeric: tabular-nums; }
  .pfb-sec { margin-top: 30px; } .pfb-sec h2, .pfb-faq h2 { font-size: 1.25rem; margin: 0 0 10px; }
  .pfb-table-wrap { overflow-x: auto; }
  .pfb-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .pfb-table th, .pfb-table td { border-bottom: 1px solid var(--border, #e2e8f0); padding: 8px 10px; text-align: left; }
  .pfb-table th { background: var(--surface-2, #f8fafc); }
  .pfb-table td:nth-child(2), .pfb-table td:nth-child(3) { font-variant-numeric: tabular-nums; }
  .pfb-row-hl { background: color-mix(in srgb, var(--accent, #2563eb) 8%, transparent); font-weight: 600; }
  .pfb-nota { font-size: .8rem; color: var(--text-2, #64748b); margin-top: 8px; }
  .pfb-faq { margin-top: 30px; }
  .pfb-faq details { border: 1px solid var(--border, #e2e8f0); border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; background: var(--surface, #fff); }
  .pfb-faq summary { font-weight: 600; cursor: pointer; }
  .pfb-faq-a { margin-top: 8px; line-height: 1.6; color: var(--text-2, #475569); }
  .pfb-faq-a a { color: var(--accent, #2563eb); }
  .pfb-related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
  .pfb-related-card { display: flex; align-items: center; gap: 8px; text-decoration: none; color: inherit; border: 1px solid var(--border, #e2e8f0); border-radius: 12px; padding: 11px 13px; background: var(--surface, #fff); }
  .pfb-related-card:hover { border-color: var(--accent, #2563eb); }
</style>

<script is:inline>
  (function () {
    function init() {
      var root = document.getElementById('pfb');
      if (!root || root.dataset.ready === '1') return;
      root.dataset.ready = '1';

      var monto = document.getElementById('pfbMonto');
      var dias = document.getElementById('pfbDias');
      var tnaInp = document.getElementById('pfbTna');
      var btn = document.getElementById('pfbCalcular');
      var box = document.getElementById('pfbResultado');

      function parseMonto(s) { return parseInt((s || '').replace(/\D/g, ''), 10) || 0; }
      function fmtMiles(n) { return n.toLocaleString('es-AR'); }
      monto.addEventListener('input', function () {
        var n = parseMonto(monto.value);
        monto.value = n ? fmtMiles(n) : '';
      });

      function calcular() {
        var m = parseMonto(monto.value);
        var d = parseInt(dias.value, 10);
        var t = parseFloat(tnaInp.value);
        if (!m || !t || t <= 0) return;
        var interes = m * (t / 100) * (d / 365);
        var total = m + interes;
        var tea = (Math.pow(1 + (t / 100) * (d / 365), 365 / d) - 1) * 100;
        document.getElementById('pfbInteres').textContent = '$ ' + fmtMiles(Math.round(interes));
        document.getElementById('pfbTotal').textContent = '$ ' + fmtMiles(Math.round(total));
        document.getElementById('pfbTea').textContent = tea.toLocaleString('es-AR', { maximumFractionDigits: 1 }) + '%';
        box.hidden = false;
      }
      btn.addEventListener('click', calcular);
      [monto, tnaInp].forEach(function (el) {
        el.addEventListener('keydown', function (e) { if (e.key === 'Enter') calcular(); });
      });
      dias.addEventListener('change', function () { if (!box.hidden) calcular(); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
