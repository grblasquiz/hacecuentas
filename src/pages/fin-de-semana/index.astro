---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { FINDE_HUBS } from '../../lib/fin-de-semana-hubs';

const site = 'https://hacecuentas.com';
const url = `${site}/fin-de-semana`;
const title = 'Fin de semana: hubs de comida, fiestas, escapadas y proyectos | Hacé Cuentas';
const description = 'Los 4 planes del finde con sus calculadoras: comida y juntadas, fiestas y reuniones, escapadas y proyectos en casa. Elegí tu plan y calculá todo sin comprar de más.';

const dateModified = new Date('2026-07-03T00:00:00Z').toISOString();
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Fin de semana' },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: 'Planes de fin de semana',
      description,
      url,
      inLanguage: 'es-AR',
      dateModified,
      isPartOf: { '@id': `${site}/#website` },
      publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: site },
    },
    {
      '@type': 'ItemList',
      numberOfItems: FINDE_HUBS.length,
      itemListElement: FINDE_HUBS.map((h, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${site}/fin-de-semana/${h.slug}`,
        name: h.h1,
      })),
    },
  ],
};
---

<Layout title={title} description={description} canonical="/fin-de-semana" audience="AR" schema={schema} domain="home">
  <Header slot="header" />

  <main class="fweek">
    <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Fin de semana' }]} />

    <header class="fweek-head">
      <span class="fweek-eyebrow">🗓️ Planes de fin de semana</span>
      <h1>Calculadoras para tu fin de semana</h1>
      <p class="fweek-lede">
        Elegí tu plan del finde y calculá todo lo que necesitás sin comprar de más ni quedarte
        corto. Cuatro hubs organizados por lo que vas a hacer: comer con amigos, festejar,
        escaparte o arreglar la casa.
      </p>
    </header>

    <ul class="fweek-grid">
      {FINDE_HUBS.map((h) => (
        <li>
          <a href={`/fin-de-semana/${h.slug}`} class="fweek-card">
            <span class="fweek-icon" aria-hidden="true">{h.icon}</span>
            <span class="fweek-card-title">{h.h1}</span>
            <span class="fweek-card-desc">{h.description}</span>
            <span class="fweek-card-cta">Ver el hub →</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="fweek-more">
      <p>
        ¿Buscás el catálogo completo? Entrá al
        <a href="/calculadoras-fin-de-semana">hub general de calculadoras del fin de semana</a>,
        con asado, entretenimiento en casa y mascotas.
      </p>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .fweek { max-width: 960px; margin: 0 auto; padding: 1.25rem 1rem 3rem; display: flex; flex-direction: column; gap: 1.75rem; }
  .fweek-head { display: flex; flex-direction: column; gap: 0.5rem; }
  .fweek-eyebrow { font-size: 0.8125rem; font-weight: 600; color: var(--accent-strong, #0369a1); text-transform: uppercase; letter-spacing: 0.04em; }
  .fweek-head h1 { margin: 0; font-size: clamp(1.625rem, 5vw, 2.375rem); line-height: 1.15; color: var(--text); }
  .fweek-lede { margin: 0; font-size: 1.0625rem; line-height: 1.6; color: var(--text); max-width: 64ch; }
  .fweek-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .fweek-card { display: flex; flex-direction: column; gap: 0.5rem; height: 100%; padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius-md, 0.75rem); background: var(--bg); text-decoration: none; transition: border-color 0.15s, transform 0.1s, box-shadow 0.15s; }
  .fweek-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.08)); }
  .fweek-icon { font-size: 1.9rem; }
  .fweek-card-title { font-size: 1.1rem; font-weight: 700; color: var(--text); line-height: 1.25; }
  .fweek-card-desc { font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; flex: 1; }
  .fweek-card-cta { font-size: 0.875rem; font-weight: 600; color: var(--accent-strong, #0369a1); }
  .fweek-more p { margin: 0; line-height: 1.6; color: var(--text-muted); }
  .fweek-more a { color: var(--accent-strong, #0369a1); }
</style>
