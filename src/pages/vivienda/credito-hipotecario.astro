---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CreditoHipotecarioExperience from '../../components/generated/CreditoHipotecarioExperience.astro';
import { hub } from '../../lib/hubs/credito-hipotecario';
const canonical='https://hacecuentas.com/vivienda/credito-hipotecario';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:hub.title,url:canonical,operatingSystem:'Web'};
---
<Layout title={hub.title} description={hub.description} canonical={canonical} schema={schema} lang="es">
  <Header />
  <CreditoHipotecarioExperience />
  <Footer />
</Layout>
