---
/**
 * Hub de decisión — "¿Califico para un crédito hipotecario UVA?"
 * Reemplaza 9 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo ramificado: la rama activa llega como segundo argumento de
 * compute() (el objeto HubCase que expone DecisionHub).
 *
 * El valor del UVA viaja desde el módulo del hub, que lo lee del snapshot vivo
 * del BCRA. Acá no hay ningún número de UVA escrito a mano.
 *
 * FORMATOS: el hub SÍ es de plata (default 'ars'), pero toda fila que no sea
 * pesos —UVAs, años, porcentajes, meses— declara su `format`/`unit` explícito.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, TASAS_BANCO, HIPOTECA, UVA_HOY, UVA_FECHA } from '../../lib/hubs/credito-hipotecario';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ TASAS_BANCO, HIPOTECA, UVA_HOY, UVA_FECHA }}>
  (function () {
    const H = window.HC_HUB;

    const nf = (n, d) => Number(n || 0).toLocaleString('es-AR', {
      minimumFractionDigits: d || 0, maximumFractionDigits: d || 0,
    });
    const ars = (n) => '$' + nf(n);
    const uvas = { format: 'unit', unit: 'UVAs', decimals: 0 };
    const pct = { format: 'unit', unit: '%', decimals: 1 };

    /** Cuota del sistema francés. Devuelve la cuota en la misma unidad del capital. */
    function cuotaFrancesa(capital, tnaPct, meses) {
      const i = tnaPct / 100 / 12;
      if (meses <= 0) return 0;
      if (i === 0) return capital / meses;
      return capital * (i * Math.pow(1 + i, meses)) / (Math.pow(1 + i, meses) - 1);
    }

    /** Capital máximo que soporta una cuota dada (francés invertido). */
    function capitalDesdeCuota(cuota, tnaPct, meses) {
      const i = tnaPct / 100 / 12;
      if (meses <= 0) return 0;
      if (i === 0) return cuota * meses;
      return cuota * (1 - Math.pow(1 + i, -meses)) / i;
    }

    H.onCompute(function (v, caso) {
      const rama = (caso && caso.id) || 'cuanto';

      const plazo = Math.max(1, Number(v.plazo) || 20);
      const meses = plazo * 12;
      const tna = Math.max(0, Number(v.tna) || 0);
      const uva = Math.max(1, Number(v.uva) || UVA_HOY);
      const inflacion = Math.max(0, Number(v.inflacion) || 0);
      const infMensual = Math.pow(1 + inflacion / 100, 1 / 12) - 1;
      const iMes = tna / 100 / 12;

      /** Barra apilada: primera cuota partida en interés, capital y seguros. */
      function barraPrimeraCuota(capital, cuotaPura, seguros) {
        const interes1 = capital * iMes;
        const amort1 = Math.max(0, cuotaPura - interes1);
        return {
          chart: [
            { label: 'Interés de la 1ª cuota', value: Math.round(interes1), tone: 'warn' },
            { label: 'Capital de la 1ª cuota', value: Math.round(amort1), tone: 'good' },
            { label: 'Seguros', value: Math.round(seguros), tone: 'prop' },
          ],
          interes1: interes1,
          amort1: amort1,
        };
      }

      // ─────────────── CUÁNTO ME PRESTAN CON MI SUELDO (default) ───────────────
      if (rama === 'cuanto') {
        const ingreso = Math.max(0, Number(v.ingreso) || 0);
        const relacion = Number(v.relacion) || 25;
        const anticipo = Number(v.anticipo) || 25;

        if (!ingreso) {
          return { total: '$0', sub: 'Ingresá tu ingreso neto mensual.', rows: [], chart: [] };
        }

        const cuotaMax = ingreso * (relacion / 100);
        // La cuota tope incluye seguros: los descontamos para el capital puro.
        const capitalMax = capitalDesdeCuota(cuotaMax, tna, meses);
        const segurosAprox = capitalMax * HIPOTECA.SEGURO_MENSUAL;
        const capitalNeto = capitalDesdeCuota(Math.max(0, cuotaMax - segurosAprox), tna, meses);
        const cuotaPura = cuotaFrancesa(capitalNeto, tna, meses);
        const seguros = capitalNeto * HIPOTECA.SEGURO_MENSUAL;

        const propiedad = anticipo < 100 ? capitalNeto / (1 - anticipo / 100) : capitalNeto;
        const gastos = propiedad * HIPOTECA.GASTOS_ESCRITURA;
        const b = barraPrimeraCuota(capitalNeto, cuotaPura, seguros);

        const rows = [
          { k: 'Cuota máxima que te aceptan', ref: relacion + '% del ingreso', v: Math.round(cuotaMax) },
          { k: 'Monto máximo del crédito', v: Math.round(capitalNeto), extra: true },
          Object.assign({ k: 'Ese monto, en UVAs', ref: 'UVA $' + nf(uva, 2), v: Math.round(capitalNeto / uva) }, uvas),
          { k: 'Cuota inicial estimada (con seguros)', v: Math.round(cuotaPura + seguros) },
          { k: 'De esa cuota, interés', v: Math.round(b.interes1) },
          { k: 'De esa cuota, capital', v: Math.round(b.amort1) },
          { k: 'Propiedad que alcanzás con ' + anticipo + '% de anticipo', v: Math.round(propiedad) },
          { k: 'Anticipo que tenés que tener', v: Math.round(propiedad - capitalNeto) },
          { k: 'Gastos de escritura, sellos y comisión', ref: '~8% del valor', v: Math.round(gastos) },
          { k: 'Plazo', v: plazo, format: 'unit', unit: 'años', decimals: 0 },
        ];

        return {
          total: ars(Math.round(capitalNeto)),
          sub: 'Con ' + ars(Math.round(ingreso)) + ' de ingreso y una cuota tope del ' + relacion + '%, te prestan hasta ' +
            ars(Math.round(capitalNeto)) + ' (' + nf(Math.round(capitalNeto / uva)) + ' UVAs) a ' + plazo +
            ' años al ' + nf(tna, 2) + '% TNA. Cuota inicial ' + ars(Math.round(cuotaPura + seguros)) + ', que sube todos los meses con la inflación.',
          rows: rows,
          chart: b.chart,
          format: 'ars',
          decimals: 0,
        };
      }

      // ─────────────────── CUÁNTO VOY A PAGAR DE CUOTA ───────────────────
      const monto = Math.max(0, Number(v.monto) || 0);
      if (!monto) {
        return { total: '$0', sub: 'Ingresá el monto del crédito que querés pedir.', rows: [], chart: [] };
      }
      const capitalUVAs = monto / uva;
      const cuotaUVAs = cuotaFrancesa(capitalUVAs, tna, meses);
      const cuotaPura = cuotaUVAs * uva;
      const seguros = monto * HIPOTECA.SEGURO_MENSUAL;
      const b = barraPrimeraCuota(monto, cuotaPura, seguros);

      if (rama === 'cuota') {
        const ingreso = Math.max(0, Number(v.ingreso) || 0);
        // Total nominal: cada cuota se paga con el UVA del mes (ajustado por inflación).
        let totalNominal = 0;
        for (let m = 0; m < meses; m++) totalNominal += cuotaPura * Math.pow(1 + infMensual, m);
        const totalConstante = cuotaPura * meses;
        const interesesConstantes = Math.max(0, totalConstante - monto);

        const proy = HIPOTECA.PROYECCION_MESES.map((m) => ({
          m: m,
          cuota: cuotaPura * Math.pow(1 + infMensual, m),
        }));

        const rows = [
          { k: 'Cuota inicial (capital + interés)', v: Math.round(cuotaPura), extra: true },
          { k: 'Seguro de vida e incendio', ref: '~0,06% del saldo', v: Math.round(seguros) },
          { k: 'Cuota inicial total', v: Math.round(cuotaPura + seguros) },
          { k: 'De la 1ª cuota, interés', ref: nf((b.interes1 / cuotaPura) * 100, 0) + '%', v: Math.round(b.interes1) },
          { k: 'De la 1ª cuota, capital', ref: nf((b.amort1 / cuotaPura) * 100, 0) + '%', v: Math.round(b.amort1) },
          Object.assign({ k: 'Capital en UVAs', ref: 'UVA $' + nf(uva, 2), v: Math.round(capitalUVAs) }, uvas),
          Object.assign({ k: 'Cuota fija en UVAs', v: Math.round(cuotaUVAs) }, uvas),
        ];
        proy.forEach((p) => {
          rows.push({ k: 'Cuota proyectada a ' + p.m + ' meses', ref: 'inflación ' + nf(inflacion, 1) + '%/año', v: Math.round(p.cuota) });
        });
        rows.push({ k: 'Total a pagar en pesos de hoy', v: Math.round(totalConstante) });
        rows.push({ k: 'Intereses en pesos de hoy', v: Math.round(interesesConstantes) });
        rows.push({ k: 'Total nominal proyectado', ref: 'con inflación ' + nf(inflacion, 1) + '%/año', v: Math.round(totalNominal) });
        if (ingreso > 0) {
          rows.push(Object.assign({ k: 'Relación cuota/ingreso inicial', v: Number((((cuotaPura + seguros) / ingreso) * 100).toFixed(1)) }, pct));
          rows.push(Object.assign({ k: 'Relación cuota/ingreso a 24 meses', ref: 'si tu sueldo no se mueve', v: Number(((cuotaPura * Math.pow(1 + infMensual, 24) + seguros) / ingreso * 100).toFixed(1)) }, pct));
        }

        return {
          total: ars(Math.round(cuotaPura + seguros)),
          sub: 'Cuota inicial de ' + ars(Math.round(cuotaPura + seguros)) + ' · ' + nf((b.interes1 / cuotaPura) * 100, 0) +
            '% es interés puro · con inflación del ' + nf(inflacion, 1) + '% anual, a 24 meses la cuota llega a ' +
            ars(Math.round(cuotaPura * Math.pow(1 + infMensual, 24))) + ' y a 60 meses a ' +
            ars(Math.round(cuotaPura * Math.pow(1 + infMensual, 60))) + '.',
          rows: rows,
          chart: b.chart,
          format: 'ars',
          decimals: 0,
        };
      }

      // ───────────────────────── UVA VS TASA FIJA ─────────────────────────
      if (rama === 'uva-vs-fija') {
        const tnaFija = Math.max(0, Number(v.tnaFija) || 0);
        const cuotaFija = cuotaFrancesa(monto, tnaFija, meses);
        const totalFija = cuotaFija * meses;

        let totalUvaNominal = 0;
        for (let m = 0; m < meses; m++) totalUvaNominal += cuotaPura * Math.pow(1 + infMensual, m);

        // Ambos totales llevados a pesos de hoy para que la comparación sea honesta.
        let vaUva = 0;
        let vaFija = 0;
        for (let m = 0; m < meses; m++) {
          const desc = Math.pow(1 + infMensual, m);
          vaUva += (cuotaPura * Math.pow(1 + infMensual, m)) / desc;
          vaFija += cuotaFija / desc;
        }
        const gana = vaUva <= vaFija ? 'UVA' : 'tasa fija';
        const brecha = Math.abs(vaUva - vaFija);

        const rows = [
          { k: 'Cuota inicial con crédito UVA', v: Math.round(cuotaPura), extra: true },
          { k: 'Cuota con tasa fija en pesos', ref: nf(tnaFija, 1) + '% TNA', v: Math.round(cuotaFija) },
          { k: 'Diferencia de cuota inicial', v: Math.round(Math.abs(cuotaFija - cuotaPura)) },
          { k: 'Total nominal del crédito UVA', ref: 'inflación ' + nf(inflacion, 1) + '%/año', v: Math.round(totalUvaNominal) },
          { k: 'Total nominal con tasa fija', v: Math.round(totalFija) },
          { k: 'Costo del UVA en pesos de hoy', v: Math.round(vaUva) },
          { k: 'Costo de la tasa fija en pesos de hoy', v: Math.round(vaFija) },
          { k: 'Ventaja de la opción que gana', v: Math.round(brecha) },
          Object.assign({ k: 'Tasa fija equivalente al UVA', ref: 'inflación + TNA real', v: Number(((1 + inflacion / 100) * (1 + tna / 100) * 100 - 100).toFixed(1)) }, pct),
        ];

        return {
          total: ars(Math.round(cuotaPura)),
          sub: 'La cuota UVA arranca en ' + ars(Math.round(cuotaPura)) + ' contra ' + ars(Math.round(cuotaFija)) +
            ' de la tasa fija. Con inflación del ' + nf(inflacion, 1) + '% anual gana ' + gana + ' por ' + ars(Math.round(brecha)) +
            ' en pesos de hoy. Cambiá el supuesto de inflación y la conclusión puede darse vuelta.',
          rows: rows,
          chart: b.chart,
          format: 'ars',
          decimals: 0,
        };
      }

      // ────────────────────────── COMPARAR BANCOS ──────────────────────────
      const filas = TASAS_BANCO.map((banco) => {
        const cu = cuotaFrancesa(capitalUVAs, banco.tna, meses) * uva;
        return { label: banco.label, tna: banco.tna, cuota: cu, total: cu * meses };
      }).sort((a, b2) => a.cuota - b2.cuota);

      const barato = filas[0];
      const caro = filas[filas.length - 1];

      const rowsBancos = filas.map((f, idx) => ({
        k: f.label + ' — TNA ' + nf(f.tna, 2) + '%',
        ref: idx === 0 ? 'la más barata' : 'cuota mensual',
        v: Math.round(f.cuota),
        extra: idx === 0,
      }));
      rowsBancos.push({ k: 'Diferencia de cuota entre el mejor y el peor', v: Math.round(caro.cuota - barato.cuota) });
      rowsBancos.push({ k: 'Diferencia de total a pagar', ref: 'en pesos de hoy', v: Math.round(caro.total - barato.total) });
      rowsBancos.push(Object.assign({ k: 'Capital del crédito en UVAs', ref: 'UVA $' + nf(uva, 2), v: Math.round(capitalUVAs) }, uvas));
      rowsBancos.push({ k: 'Seguros que suma el banco', v: Math.round(seguros) });

      const bBanco = barraPrimeraCuota(monto, barato.cuota, seguros);

      return {
        total: ars(Math.round(barato.cuota)),
        sub: 'Con ' + ars(monto) + ' a ' + plazo + ' años, la cuota más baja es la de ' + barato.label + ' (' +
          ars(Math.round(barato.cuota)) + ' al ' + nf(barato.tna, 2) + '% TNA) y la más alta la de ' + caro.label + ' (' +
          ars(Math.round(caro.cuota)) + '): ' + ars(Math.round(caro.cuota - barato.cuota)) +
          ' por mes de diferencia. Confirmá la tasa vigente en cada banco.',
        rows: rowsBancos,
        chart: bBanco.chart,
        format: 'ars',
        decimals: 0,
      };
    });
  })();
</script>
