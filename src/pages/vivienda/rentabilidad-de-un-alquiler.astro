---
/**
 * Hub de decisión — "¿Conviene alquilarla, venderla o alquilar yo?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/rentabilidad-de-un-alquiler.ts)
 * y su compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * Nada de cotizaciones ni tasas hardcodeadas: el dólar sale de
 * src/data/live/dolar.json, la tasa de plazo fijo de src/data/live/tasas.json y
 * la inflación interanual de src/data/live/inflacion.json.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  PRECIO_M2,
  AJUSTE_ESTADO,
  CREDITO_PLAZO_ANIOS,
  CREDITO_PIE_PCT,
  LEASING_PCT_DESCONTABLE,
  ESCALA_MAX,
} from '../../lib/hubs/rentabilidad-de-un-alquiler';
import dolarLive from '../../data/live/dolar.json';
import tasasLive from '../../data/live/tasas.json';
import inflacionLive from '../../data/live/inflacion.json';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const quotes = (dolarLive as any).quotes || {};
// El dólar relevante para pasar el precio de un inmueble a pesos es el
// financiero (MEP/bolsa); si faltara, caemos al oficial.
const DOLAR = Number(quotes?.bolsa?.venta) || Number(quotes?.oficial?.venta) || 0;
const DOLAR_NOMBRE = quotes?.bolsa?.venta ? 'dólar MEP' : 'dólar oficial';

const TNA_PLAZO_FIJO = Number((tasasLive as any)?.plazo_fijo_30d?.valor) || 0;
const INFLACION_12M = Number((inflacionLive as any)?.acumulado_12m_pct) || 0;

const CONST = {
  PRECIO_M2,
  AJUSTE_ESTADO,
  CREDITO_PLAZO_ANIOS,
  CREDITO_PIE_PCT,
  LEASING_PCT_DESCONTABLE,
  ESCALA_MAX,
  DOLAR,
  DOLAR_NOMBRE,
  TNA_PLAZO_FIJO,
  INFLACION_12M,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ K: CONST }}>
  (function () {
    const H = window.HC_HUB;
    const pct = function (n, d) {
      return (Number(n) || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d == null ? 2 : d,
        maximumFractionDigits: d == null ? 2 : d,
      }) + '%';
    };

    H.onCompute(function (v, kase) {
      const caso = (kase && kase.id) || 'rendir';

      // --- valor de la propiedad (precio-m2-zona) ---
      const m2 = Math.max(0, Number(v.m2) || 0);
      const rango = K.PRECIO_M2[String(v.zona)] || K.PRECIO_M2['caballito-almagro'];
      const mult = K.AJUSTE_ESTADO[String(v.estado)] || 1;
      const promedioM2 = ((rango[0] + rango[1]) / 2) * mult;
      const valorUsdInput = Math.max(0, Number(v.valorUsd) || 0);
      const valorUsd = valorUsdInput > 0 ? valorUsdInput : m2 * promedioM2;
      const estimado = valorUsdInput <= 0;
      const valorArs = valorUsd * K.DOLAR;

      // --- flujo del alquiler (rentabilidad-alquiler-vs-venta) ---
      const alq = Math.max(0, Number(v.alquiler) || 0);
      const gastos = Math.max(0, Number(v.gastos) || 0);
      const mesesVacios = Math.min(12, Math.max(0, Number(v.mesesVacios) || 0));
      const apreciacion = Number(v.apreciacion) || 0;
      const anios = Math.max(1, Number(v.anios) || 10);

      const brutoAnual = alq * 12;
      const vacanciaAnual = alq * mesesVacios;
      const gastosAnual = gastos * 12;
      const netoAnual = brutoAnual - vacanciaAnual - gastosAnual;

      const capBruto = valorArs > 0 ? (brutoAnual / valorArs) * 100 : 0;
      const capNeto = valorArs > 0 ? (netoAnual / valorArs) * 100 : 0;
      const retornoTotal = capNeto + apreciacion;
      const repago = netoAnual > 0 ? valorArs / netoAnual : 0;

      // --- alternativa financiera (tasa viva del BCRA) ---
      const tea = Math.pow(1 + K.TNA_PLAZO_FIJO / 100 / 12, 12) - 1;
      const teaPct = tea * 100;
      const realPct = ((1 + tea) / (1 + K.INFLACION_12M / 100) - 1) * 100;

      const rows = [];
      let chart = [];
      let sub = '';

      // Filas comunes a todas las ramas: de dónde sale el rendimiento.
      rows.push({ k: 'Rendimiento bruto anual', ref: 'Alquiler / valor', v: capBruto, format: 'unit', unit: '%', decimals: 2 });
      rows.push({ k: 'Rendimiento neto anual (cap rate)', ref: 'Neto de gastos y vacancia', v: capNeto, format: 'unit', unit: '%', decimals: 2, extra: true });
      rows.push({ k: 'Valor de la propiedad' + (estimado ? ' (estimado por zona)' : ''), ref: K.DOLAR_NOMBRE, v: valorArs, format: 'ars' });
      rows.push({ k: 'Ingreso neto anual del alquiler', ref: 'Bruto menos gastos y vacancia', v: netoAnual, format: 'ars' });

      if (caso === 'vender') {
        const rentaFinanciera = valorArs * tea;
        rows.push({ k: 'Renta anual si vendés y colocás a plazo fijo', ref: 'TEA del BCRA', v: rentaFinanciera, format: 'ars' });
        rows.push({ k: 'Tasa de plazo fijo (TNA)', ref: 'BCRA', v: K.TNA_PLAZO_FIJO, format: 'unit', unit: '%', decimals: 2 });
        rows.push({ k: 'Tasa efectiva anual del plazo fijo', ref: 'Capitalizada a 30 días', v: teaPct, format: 'unit', unit: '%', decimals: 2 });
        rows.push({ k: 'Tasa real del plazo fijo contra la inflación', ref: 'Inflación 12 meses ' + pct(K.INFLACION_12M, 1), v: realPct, format: 'unit', unit: '%', decimals: 2 });
        rows.push({ k: 'Diferencia entre alquilar y colocar el capital', ref: 'En puntos porcentuales', v: capNeto - teaPct, format: 'unit', unit: 'pp', decimals: 2 });
        sub =
          'El alquiler rinde ' + pct(capNeto) + ' neto anual sobre el valor; colocar el capital a plazo fijo rinde ' +
          pct(teaPct) + ' nominal (' + pct(realPct) + ' real contra una inflación de ' + pct(K.INFLACION_12M, 1) +
          '). Son monedas distintas: la renta del ladrillo se mide en dólares y la del plazo fijo, en pesos.';
        chart = [
          { label: 'Bajo', value: 3, from: 0, to: 3, tone: 'bad' },
          { label: 'Normal', value: 2, from: 3, to: 5, tone: 'warn' },
          { label: 'Bueno', value: 3, from: 5, to: 8, tone: 'good' },
          { label: 'Muy bueno', value: 4, from: 8, to: K.ESCALA_MAX, tone: 'good' },
        ];
      } else if (caso === 'comprar') {
        // alquiler-vs-comprar: alquileres ajustados año a año contra
        // anticipo más cuotas de un hipotecario a 20 años.
        // El ajuste del alquiler usa la inflación interanual en vivo.
        let costoAlquilar = 0;
        let alquilerActual = alq;
        for (let a = 0; a < anios; a++) {
          costoAlquilar += alquilerActual * 12;
          alquilerActual *= 1 + K.INFLACION_12M / 100;
        }
        const pie = valorArs * (K.CREDITO_PIE_PCT / 100);
        const monto = valorArs - pie;
        const tm = (Number(v.tasaCredito) || 0) / 100 / 12;
        const n = K.CREDITO_PLAZO_ANIOS * 12;
        const cuota = tm > 0 ? (monto * (tm * Math.pow(1 + tm, n))) / (Math.pow(1 + tm, n) - 1) : monto / n;
        const meses = Math.min(anios, K.CREDITO_PLAZO_ANIOS) * 12;
        const costoComprar = pie + cuota * meses;

        rows.push({ k: 'Costo de alquilar en ' + anios + ' años', ref: 'Con ajuste anual ' + pct(K.INFLACION_12M, 1), v: costoAlquilar, format: 'ars' });
        rows.push({ k: 'Anticipo del ' + K.CREDITO_PIE_PCT + '%', ref: 'Al firmar', v: pie, format: 'ars' });
        rows.push({ k: 'Cuota mensual del crédito', ref: K.CREDITO_PLAZO_ANIOS + ' años', v: cuota, format: 'ars' });
        rows.push({ k: 'Desembolso total comprando en ' + anios + ' años', ref: 'Anticipo más cuotas', v: costoComprar, format: 'ars' });
        rows.push({ k: 'Peso de la cuota sobre el alquiler de hoy', ref: 'Cuota / alquiler', v: alq > 0 ? (cuota / alq) * 100 : 0, format: 'unit', unit: '%', decimals: 0 });
        sub =
          (costoAlquilar > costoComprar
            ? 'En ' + anios + ' años comprar desembolsa ' + H.ars(costoAlquilar - costoComprar) + ' menos que alquilar'
            : 'En ' + anios + ' años alquilar desembolsa ' + H.ars(costoComprar - costoAlquilar) + ' menos que comprar') +
          ', con una cuota estimada de ' + H.ars(cuota) + ' por mes. Comprando además te quedás con la propiedad.';
        chart = [
          { label: 'Bajo', value: 3, from: 0, to: 3, tone: 'bad' },
          { label: 'Normal', value: 2, from: 3, to: 5, tone: 'warn' },
          { label: 'Bueno', value: 3, from: 5, to: 8, tone: 'good' },
          { label: 'Muy bueno', value: 4, from: 8, to: K.ESCALA_MAX, tone: 'good' },
        ];
      } else if (caso === 'vacia') {
        // costo-mantener-propiedad-vacia-mensual: gastos fijos + alquiler no percibido.
        const costoMensual = gastos + alq;
        const gastosVacancia = gastos * mesesVacios;
        const total = costoMensual * mesesVacios;
        const capSinVacancia = valorArs > 0 ? ((brutoAnual - gastosAnual) / valorArs) * 100 : 0;
        rows.push({ k: 'Costo de cada mes vacía', ref: 'Gastos más alquiler no percibido', v: costoMensual, format: 'ars' });
        rows.push({ k: 'Alquiler que dejás de cobrar', ref: mesesVacios + ' meses', v: vacanciaAnual, format: 'ars' });
        rows.push({ k: 'Gastos fijos que corren igual', ref: mesesVacios + ' meses', v: gastosVacancia, format: 'ars' });
        rows.push({ k: 'Costo de oportunidad total de la vacancia', ref: 'Por año', v: total, format: 'ars' });
        rows.push({ k: 'Lo que te cuesta la vacancia en rendimiento', ref: 'Sin vacancia sería ' + pct(capSinVacancia), v: capSinVacancia - capNeto, format: 'unit', unit: 'pp', decimals: 2 });
        sub =
          'Cada mes vacía cuesta ' + H.ars(costoMensual) + ' y ' + mesesVacios +
          ' meses al año se llevan ' + H.ars(total) + ': el rendimiento neto baja de ' + pct(capSinVacancia) +
          ' a ' + pct(capNeto) + '.';
        chart = [
          { label: 'Bajo', value: 3, from: 0, to: 3, tone: 'bad' },
          { label: 'Normal', value: 2, from: 3, to: 5, tone: 'warn' },
          { label: 'Bueno', value: 3, from: 5, to: 8, tone: 'good' },
          { label: 'Muy bueno', value: 4, from: 8, to: K.ESCALA_MAX, tone: 'good' },
        ];
      } else if (caso === 'leasing') {
        const meses = anios * 12;
        const p = K.LEASING_PCT_DESCONTABLE / 100;
        const totalAlquilado = alq * meses;
        const acumulado = totalAlquilado * p;
        const falta = valorArs - acumulado;
        rows.push({ k: 'Total pagado en alquileres en ' + anios + ' años', ref: meses + ' meses', v: totalAlquilado, format: 'ars' });
        rows.push({ k: 'Parte descontable del precio', ref: K.LEASING_PCT_DESCONTABLE + '% de lo pagado', v: acumulado, format: 'ars' });
        rows.push({ k: 'Alquiler puro que no vuelve', ref: 'El resto de lo pagado', v: totalAlquilado - acumulado, format: 'ars' });
        rows.push({ k: 'Falta para ejercer la opción', ref: 'Sobre el valor de hoy', v: Math.max(0, falta), format: 'ars' });
        rows.push({ k: 'Porción del inmueble ya cubierta', ref: 'Acumulado / valor', v: valorArs > 0 ? (acumulado / valorArs) * 100 : 0, format: 'unit', unit: '%', decimals: 1 });
        sub =
          'En ' + anios + ' años pagás ' + H.ars(totalAlquilado) + ' de alquiler y acumulás ' + H.ars(acumulado) +
          ' a cuenta del precio: te faltarían ' + H.ars(Math.max(0, falta)) +
          '. Mientras tanto la propiedad rinde ' + pct(capNeto) + ' neto anual para quien la pone.';
        chart = [
          { label: 'Bajo', value: 3, from: 0, to: 3, tone: 'bad' },
          { label: 'Normal', value: 2, from: 3, to: 5, tone: 'warn' },
          { label: 'Bueno', value: 3, from: 5, to: 8, tone: 'good' },
          { label: 'Muy bueno', value: 4, from: 8, to: K.ESCALA_MAX, tone: 'good' },
        ];
      } else {
        rows.push({ k: 'Gastos anuales a tu cargo', ref: 'Expensas, impuestos y mantenimiento', v: gastosAnual, format: 'ars' });
        rows.push({ k: 'Alquiler perdido por vacancia', ref: mesesVacios + ' meses por año', v: vacanciaAnual, format: 'ars' });
        rows.push({ k: 'Retorno total con apreciación', ref: 'Renta más ' + pct(apreciacion, 1) + ' de apreciación', v: retornoTotal, format: 'unit', unit: '%', decimals: 2 });
        rows.push({ k: 'Años en recuperar el valor con renta pura', ref: 'Valor / ingreso neto', v: repago, format: 'unit', unit: 'años', decimals: 1 });
        sub =
          'Rinde ' + pct(capNeto) + ' neto anual (' + pct(capBruto) + ' bruto) sobre un valor de ' +
          H.ars(valorArs) + ' al ' + K.DOLAR_NOMBRE + '. La renta pura devuelve el capital en ' +
          repago.toLocaleString('es-AR', { maximumFractionDigits: 1 }) + ' años.';
        chart = [
          { label: 'Bajo', value: 3, from: 0, to: 3, tone: 'bad' },
          { label: 'Normal', value: 2, from: 3, to: 5, tone: 'warn' },
          { label: 'Bueno', value: 3, from: 5, to: 8, tone: 'good' },
          { label: 'Muy bueno', value: 4, from: 8, to: K.ESCALA_MAX, tone: 'good' },
        ];
      }

      const lectura =
        capNeto >= 8 ? 'muy bueno' : capNeto >= 5 ? 'bueno' : capNeto >= 3 ? 'dentro del rango del mercado' : 'bajo';

      return {
        total: pct(capNeto),
        sub: sub,
        rows: rows,
        chart: chart,
        format: 'unit',
        unit: '%',
        decimals: 2,
        position: Math.min(100, Math.max(0, (capNeto / K.ESCALA_MAX) * 100)),
        positionLabel: 'Rendimiento neto ' + pct(capNeto) + ' — ' + lectura,
      };
    });
  })();
</script>
