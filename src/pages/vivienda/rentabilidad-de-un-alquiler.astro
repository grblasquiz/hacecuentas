---
/**
 * Hub de decisión — "¿Conviene alquilarla, venderla o alquilar yo?"
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/rentabilidad-de-un-alquiler.ts)
 * y su compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro.
 *
 * Nada de cotizaciones ni tasas hardcodeadas: el dólar sale de
 * src/data/live/dolar.json, la tasa de plazo fijo de src/data/live/tasas.json y
 * la inflación interanual de src/data/live/inflacion.json.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import RentabilidadAlquilerExperience from '../../components/generated/RentabilidadAlquilerExperience.astro';
import {
  hub,
  PRECIO_M2,
  AJUSTE_ESTADO,
  CREDITO_PLAZO_ANIOS,
  CREDITO_PIE_PCT,
  LEASING_PCT_DESCONTABLE,
  ESCALA_MAX,
} from '../../lib/hubs/rentabilidad-de-un-alquiler';
import dolarLive from '../../data/live/dolar.json';
import tasasLive from '../../data/live/tasas.json';
import inflacionLive from '../../data/live/inflacion.json';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const quotes = (dolarLive as any).quotes || {};
// El dólar relevante para pasar el precio de un inmueble a pesos es el
// financiero (MEP/bolsa); si faltara, caemos al oficial.
const DOLAR = Number(quotes?.bolsa?.venta) || Number(quotes?.oficial?.venta) || 0;
const DOLAR_NOMBRE = quotes?.bolsa?.venta ? 'dólar MEP' : 'dólar oficial';

const TNA_PLAZO_FIJO = Number((tasasLive as any)?.plazo_fijo_30d?.valor) || 0;
const INFLACION_12M = Number((inflacionLive as any)?.acumulado_12m_pct) || 0;

const CONST = {
  PRECIO_M2,
  AJUSTE_ESTADO,
  CREDITO_PLAZO_ANIOS,
  CREDITO_PIE_PCT,
  LEASING_PCT_DESCONTABLE,
  ESCALA_MAX,
  DOLAR,
  DOLAR_NOMBRE,
  TNA_PLAZO_FIJO,
  INFLACION_12M,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <RentabilidadAlquilerExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

