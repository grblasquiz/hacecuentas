---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FinanzasHomeExperience from '../../components/generated/FinanzasHomeExperience.astro';
import ThirdWaveBoost from '../../components/ThirdWaveBoost.astro';
const canonical='https://hacecuentas.com/finanzas-personales';
const schema={'@context':'https://schema.org','@graph':[{'@type':'CollectionPage',name:'Calculadoras de finanzas personales',url:canonical,description:'Herramientas para ordenar gastos, ahorro, deudas, préstamos y tarjetas.'},{'@type':'ItemList',name:'Herramientas de finanzas personales',numberOfItems:5,itemListElement:['Gastos del mes','Meta de ahorro','Salir de deudas','Préstamos','Tarjeta de crédito'].map((name,i)=>({'@type':'ListItem',position:i+1,name}))}]};
---
<Layout title="Calculadoras de finanzas personales 2026 | Hacé Cuentas" description="Ordená tus gastos, ahorro, deudas, préstamos y tarjetas con calculadoras gratuitas y guías prácticas de finanzas personales." canonical={canonical} schema={schema} lang="es">
  <Header />
  <FinanzasHomeExperience />
  <ThirdWaveBoost variant="finance" />
  <Footer />
</Layout>
