---
/**
 * Hub de decisión — "¿Cómo salgo de las deudas?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cuatro `cases`, el primero arranca seleccionado.
 * La página sólo aporta los datos (src/lib/hubs/salir-de-deudas.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro
 * y no se tocan.
 *
 * Formato: casi todo es plata, pero las filas de meses/cuotas y el
 * multiplicador NO lo son. Como el runtime hace Object.assign sobre el formato
 * base, una fila sin `format` propio sale con "$" adelante: por eso TODAS las
 * filas declaran su formato.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SalirDeDeudasExperience from '../../components/generated/SalirDeDeudasExperience.astro';
import { hub, SIM, TOPE_COMISION_PRECANCELACION } from '../../lib/hubs/salir-de-deudas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SalirDeDeudasExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ SIM, TOPE_COMISION: TOPE_COMISION_PRECANCELACION }}>
  (function () {
    const H = window.HC_HUB;

    /** Cuota del sistema francés. */
    function cuotaFrancesa(capital, tasaMensual, meses) {
      if (meses <= 0) return 0;
      if (tasaMensual === 0) return capital / meses;
      const f = Math.pow(1 + tasaMensual, meses);
      return (capital * tasaMensual * f) / (f - 1);
    }

    /**
     * Amortización sobre saldo con pago mensual variable.
     * `pagoDe(saldo)` devuelve el pago del mes (mínimo porcentual o cuota fija).
     * Devuelve meses, total pagado e intereses; meses = -1 si nunca se cancela.
     */
    function simular(saldo, tasaMensual, pagoDe) {
      let resto = saldo;
      let total = 0;
      let meses = 0;
      while (resto > 1 && meses < SIM.maxMeses) {
        const interes = resto * tasaMensual;
        let pago = pagoDe(resto);
        if (pago <= interes) return { meses: -1, total: 0, intereses: 0 };
        if (pago > resto + interes) pago = resto + interes;
        total += pago;
        resto -= pago - interes;
        meses++;
      }
      if (meses >= SIM.maxMeses) return { meses: -1, total: total, intereses: total - saldo };
      return { meses: meses, total: total, intereses: total - saldo };
    }

    const money = function (k, v, ref, extra) {
      return { k: k, v: v, ref: ref, format: 'ars', extra: !!extra };
    };
    const unidad = function (k, unit, v, ref, decimals) {
      return { k: k, v: v, ref: ref, format: 'unit', unit: unit, decimals: decimals || 0 };
    };

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'minimo';
      const saldo = Math.max(0, v.saldo || 0);
      const tna = Math.max(0, v.tna || 0);
      const r = tna / 100 / 12;
      const pagoPct = Math.min(100, Math.max(0, v.pagoPct || 0)) / 100;
      const cuotaDisp = Math.max(0, v.cuota || 0);
      const meses = Math.max(1, Math.round(v.meses || 1));
      const rNueva = Math.max(0, v.tnaNueva || 0) / 100 / 12;
      const mesesNuevos = Math.max(1, Math.round(v.mesesNuevos || 1));

      if (saldo <= 0) {
        return { total: H.ars(0), sub: 'Cargá cuánto debés hoy para ver la cuenta.', rows: [], chart: [] };
      }

      // ── Rama 1 y base de comparación: pago mínimo de la tarjeta ────────────
      const minimo = simular(saldo, r, function (resto) {
        return Math.max(resto * pagoPct, SIM.piso);
      });

      if (id === 'minimo') {
        if (minimo.meses < 0) {
          const interesMes = saldo * r;
          const pagoMes = Math.max(saldo * pagoPct, SIM.piso);
          return {
            total: '∞',
            sub:
              'El pago mínimo (' + H.ars(pagoMes) + ') no cubre el interés del mes (' +
              H.ars(interesMes) + '): la deuda nunca se cancela y crece todos los meses.',
            rows: [
              money('Saldo que debés hoy', saldo, 'Capital'),
              money('Interés del primer mes', interesMes, 'TNA ' + tna + '%'),
              money('Pago mínimo del primer mes', pagoMes, pagoPct * 100 + '% del saldo'),
              money('Cuánto crece la deuda en el primer mes', interesMes - pagoMes, 'Saldo', true),
            ],
            chart: [
              { label: 'Capital', value: saldo, tone: 'main' },
              { label: 'Interés que se suma cada mes', value: interesMes, tone: 'bad' },
            ],
            format: 'ars',
          };
        }
        const mult = minimo.total / saldo;
        const anios = Math.floor(minimo.meses / 12);
        const resto = minimo.meses % 12;
        return {
          total: H.ars(minimo.total),
          sub:
            minimo.meses + (minimo.meses === 1 ? ' mes' : ' meses') +
            (anios > 0 ? ' (' + anios + (anios === 1 ? ' año' : ' años') + ' y ' + resto + ' meses)' : '') +
            ' · ' + mult.toFixed(1).replace('.', ',') + ' veces el saldo original · intereses ' +
            Math.round((minimo.intereses / minimo.total) * 100) + '% del total',
          rows: [
            money('Saldo que debés hoy', saldo, 'Capital'),
            money('Primer pago mínimo', Math.max(saldo * pagoPct, SIM.piso), pagoPct * 100 + '% del saldo'),
            unidad('Meses hasta cancelarla', 'meses', minimo.meses, 'Simulación'),
            money('Intereses que vas a pagar', minimo.intereses, 'TNA ' + tna + '%', true),
            money('Total que vas a terminar pagando', minimo.total, 'Capital + intereses', true),
          ],
          chart: [
            { label: 'Capital', value: saldo, tone: 'main' },
            { label: 'Intereses', value: minimo.intereses, tone: 'bad' },
          ],
          format: 'ars',
        };
      }

      // ── Rama 2: varias deudas, qué pagar primero ───────────────────────────
      if (id === 'varias') {
        const plan = simular(saldo, r, function () {
          return cuotaDisp;
        });
        if (plan.meses < 0) {
          return {
            total: H.ars(0),
            sub:
              'Con ' + H.ars(cuotaDisp) + ' por mes no llegás a cubrir el interés del saldo (' +
              H.ars(saldo * r) + '). Subí el pago mensual o refinanciá antes de ordenar las deudas.',
            rows: [
              money('Saldo total de tus deudas', saldo, 'Capital'),
              money('Interés del primer mes', saldo * r, 'TNA ' + tna + '%'),
              money('Lo que podés pagar por mes', cuotaDisp, 'Tu presupuesto'),
            ],
            chart: [
              { label: 'Capital', value: saldo, tone: 'main' },
              { label: 'Interés mensual sin cubrir', value: saldo * r - cuotaDisp, tone: 'bad' },
            ],
            format: 'ars',
          };
        }
        const ahorro = minimo.meses < 0 ? 0 : minimo.intereses - plan.intereses;
        return {
          total: H.ars(plan.total),
          sub:
            'Volcando ' + H.ars(cuotaDisp) + ' por mes a la deuda más cara la cancelás en ' +
            plan.meses + (plan.meses === 1 ? ' mes' : ' meses') +
            (ahorro > 0 ? ' y ahorrás ' + H.ars(ahorro) + ' de intereses frente al pago mínimo' : ''),
          rows: [
            money('Saldo total de tus deudas', saldo, 'Capital'),
            money('Pago mensual que podés sostener', cuotaDisp, 'Tu presupuesto'),
            unidad('Meses volcando todo a la deuda más cara', 'meses', plan.meses, 'Avalancha'),
            money('Intereses con ese plan', plan.intereses, 'Avalancha'),
            money('Intereses si seguís con el mínimo', minimo.meses < 0 ? 0 : minimo.intereses, 'Pago mínimo'),
            money('Lo que te ahorrás ordenando por tasa', Math.max(0, ahorro), 'Avalancha vs mínimo', true),
            money('Total que vas a terminar pagando', plan.total, 'Capital + intereses', true),
          ],
          chart: [
            { label: 'Capital', value: saldo, tone: 'main' },
            { label: 'Intereses', value: plan.intereses, tone: 'bad' },
          ],
          format: 'ars',
        };
      }

      // ── Rama 3: refinanciar ────────────────────────────────────────────────
      if (id === 'refinanciar') {
        const cuotaActual = cuotaFrancesa(saldo, r, meses);
        const cuotaNueva = cuotaFrancesa(saldo, rNueva, mesesNuevos);
        const costoActual = cuotaActual * meses;
        const costoNuevo = cuotaNueva * mesesNuevos;
        const dif = costoActual - costoNuevo;
        const conviene = dif > 0;
        return {
          total: H.ars(costoNuevo),
          sub:
            'La cuota pasa de ' + H.ars(cuotaActual) + ' a ' + H.ars(cuotaNueva) + ', pero el costo total ' +
            (conviene ? 'baja ' : 'sube ') + H.ars(Math.abs(dif)) +
            ' (' + meses + ' cuotas contra ' + mesesNuevos + ')',
          rows: [
            money('Saldo a refinanciar', saldo, 'Capital'),
            money('Cuota que pagás hoy', cuotaActual, 'TNA ' + tna + '% · ' + meses + ' cuotas'),
            money('Cuota de la nueva propuesta', cuotaNueva, 'TNA ' + v.tnaNueva + '% · ' + mesesNuevos + ' cuotas'),
            money('Costo total si seguís como estás', costoActual, 'Cuota × cuotas'),
            money('Costo total refinanciando', costoNuevo, 'Cuota × cuotas', true),
            money(conviene ? 'Lo que te ahorrás refinanciando' : 'Lo que te cuesta de más refinanciar', Math.abs(dif), 'Diferencia', true),
            money('Intereses de la nueva propuesta', Math.max(0, costoNuevo - saldo), 'Capital + intereses'),
          ],
          chart: [
            { label: 'Capital', value: saldo, tone: 'main' },
            { label: 'Intereses', value: Math.max(0, costoNuevo - saldo), tone: 'bad' },
          ],
          format: 'ars',
        };
      }

      // ── Rama 4: cancelar antes ─────────────────────────────────────────────
      const cuotaActual = cuotaFrancesa(saldo, r, meses);
      const costoSeguir = cuotaActual * meses;
      const interesesEvitados = Math.max(0, costoSeguir - saldo);
      const comisionTope = saldo * TOPE_COMISION;
      return {
        total: H.ars(saldo),
        sub:
          'Cancelando hoy pagás ' + H.ars(saldo) + ' en vez de ' + H.ars(costoSeguir) + ' en ' + meses +
          ' cuotas: te ahorrás ' + H.ars(interesesEvitados) + ' de intereses',
        rows: [
          money('Capital que cancelás hoy', saldo, 'Saldo pendiente', true),
          money('Cuota que venís pagando', cuotaActual, 'TNA ' + tna + '% · sistema francés'),
          unidad('Cuotas que te sacás de encima', 'cuotas', meses, 'Precancelación'),
          money('Total si seguís pagando hasta el final', costoSeguir, 'Cuota × cuotas'),
          money('Intereses que te ahorrás', interesesEvitados, 'Precancelación', true),
          money('Comisión máxima que te pueden cobrar', comisionTope, 'Com. "A" 5460: 4% tope'),
        ],
        chart: [
          { label: 'Capital', value: saldo, tone: 'main' },
          { label: 'Intereses que ya no pagás', value: 0, tone: 'bad' },
        ],
        format: 'ars',
      };
    });
  })();
</script>
