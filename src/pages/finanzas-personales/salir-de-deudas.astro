---
/**
 * Hub de decisión — "¿Cómo salgo de las deudas?"
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: cuatro `cases`, el primero arranca seleccionado.
 * La página sólo aporta los datos (src/lib/hubs/salir-de-deudas.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro
 * y no se tocan.
 *
 * Formato: casi todo es plata, pero las filas de meses/cuotas y el
 * multiplicador NO lo son. Como el runtime hace Object.assign sobre el formato
 * base, una fila sin `format` propio sale con "$" adelante: por eso TODAS las
 * filas declaran su formato.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import SalirDeDeudasExperience from '../../components/generated/SalirDeDeudasExperience.astro';
import { hub, SIM, TOPE_COMISION_PRECANCELACION } from '../../lib/hubs/salir-de-deudas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <SalirDeDeudasExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

