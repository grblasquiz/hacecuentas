---
/**
 * Hub de decisión — "¿Cómo dividimos los gastos?"
 * Absorbe siete calculadoras de reparto entre personas (grupo, pareja y propina).
 *
 * OJO: /finanzas-personales ya existe como pillar page (src/pages/finanzas-personales.astro).
 * NO va un index.astro dentro del directorio: sería una ruta duplicada.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import DividirGastosExperience from '../../components/generated/DividirGastosExperience.astro';
import { hub, PROPINA_PAISES } from '../../lib/hubs/gastos-pareja';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DividirGastosExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

