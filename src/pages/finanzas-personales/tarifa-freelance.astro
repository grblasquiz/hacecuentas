---
/**
 * Hub de decisión — "¿Cuánto tengo que cobrar la hora para que me cierre?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * Los números son espejo de las fórmulas reales:
 *   src/lib/formulas/freelance-tarifa-hora.ts                        (rama pesos)
 *   src/lib/formulas/upwork-freelancer-comision-neta-argentina.ts    (rama dolares)
 *   src/lib/formulas/calculadora-cuanto-facturar-cubrir-gastos.ts    (rama facturacion)
 *   src/lib/formulas/obra-social-monotributista-aporte-extra-familiar.ts (adherentes)
 * y de la fuente única del monotributo: src/lib/data/monotributo-2026.ts
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import TarifaFreelanceExperience from '../../components/generated/TarifaFreelanceExperience.astro';
import { hub, COMISIONES, CONVENCIONES } from '../../lib/hubs/tarifa-freelance';
import { CATEGORIAS, TOPES, CUOTA_SERVICIOS, componentes, META } from '../../lib/data/monotributo-2026';
import dolar from '../../data/live/dolar.json';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

/** Escala del monotributo servicios serializada para el runtime. */
const MONOTRIBUTO = CATEGORIAS.map((c) => {
  const comp = componentes(c, 'servicios');
  return { cat: c, tope: TOPES[c], cuota: CUOTA_SERVICIOS[c], obraSocial: comp.obraSocial };
});

/**
 * Tipo de cambio: para exportación de servicios liquidada por banco se usa el
 * OFICIAL en su punta compradora. El CCL va como referencia de la brecha.
 */
const LIVE = {
  oficialCompra: Number(dolar?.quotes?.oficial?.compra) || 0,
  oficialVenta: Number(dolar?.quotes?.oficial?.venta) || 0,
  ccl: Number(dolar?.quotes?.contadoconliqui?.compra) || 0,
  comisiones: COMISIONES,
  conv: CONVENCIONES,
  monotributo: MONOTRIBUTO,
  monotributoVigencia: META.vigencia,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <TarifaFreelanceExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

