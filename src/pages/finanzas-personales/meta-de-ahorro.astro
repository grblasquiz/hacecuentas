---
/**
 * Hub de decisión — "¿Cuánto tengo que ahorrar por mes?"
 * Reemplaza 14 URLs de calculadora suelta (ver hub.replaces).
 *
 * Los números son espejo de las fórmulas reales:
 *   src/lib/formulas/ahorro-meta.ts        (rama meta-fecha)
 *   src/lib/formulas/tiempo-para-ahorrar.ts (rama meta-cuota)
 *   src/lib/formulas/fondo-emergencia-meses.ts (rama fondo-emergencia)
 *   src/lib/formulas/regla-50-30-20.ts     (rama reparto-sueldo)
 *   src/lib/formulas/ahorro-hormiga.ts     (rama gasto-hormiga)
 *   src/lib/formulas/fire-retiro-temprano.ts (rama fire)
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import MetaAhorroExperience from '../../components/generated/MetaAhorroExperience.astro';
import { hub, FIRE, REGLA_503020 } from '../../lib/hubs/meta-de-ahorro';
import tasas from '../../data/live/tasas.json';
import inflacion from '../../data/live/inflacion.json';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

/** Datos vivos que consume compute(). Nunca hardcodear tasa ni inflación. */
const LIVE = {
  tnaPlazoFijo: Number(tasas?.plazo_fijo_30d?.valor) || 0,
  inflacion12m: Number(inflacion?.acumulado_12m_pct) || 0,
  inflacionMes: Number(inflacion?.last_month?.valor) || 0,
  fireTasaRetiro: FIRE.tasaRetiroPct,
  fireRendReal: FIRE.rendimientoRealPct,
  regla: REGLA_503020,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <MetaAhorroExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

