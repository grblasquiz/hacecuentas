---
/**
 * Hub de decisión — "¿Cuánto tengo que ahorrar por mes?"
 * Reemplaza 14 URLs de calculadora suelta (ver hub.replaces).
 *
 * Los números son espejo de las fórmulas reales:
 *   src/lib/formulas/ahorro-meta.ts        (rama meta-fecha)
 *   src/lib/formulas/tiempo-para-ahorrar.ts (rama meta-cuota)
 *   src/lib/formulas/fondo-emergencia-meses.ts (rama fondo-emergencia)
 *   src/lib/formulas/regla-50-30-20.ts     (rama reparto-sueldo)
 *   src/lib/formulas/ahorro-hormiga.ts     (rama gasto-hormiga)
 *   src/lib/formulas/fire-retiro-temprano.ts (rama fire)
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, FIRE, REGLA_503020 } from '../../lib/hubs/meta-de-ahorro';
import tasas from '../../data/live/tasas.json';
import inflacion from '../../data/live/inflacion.json';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

/** Datos vivos que consume compute(). Nunca hardcodear tasa ni inflación. */
const LIVE = {
  tnaPlazoFijo: Number(tasas?.plazo_fijo_30d?.valor) || 0,
  inflacion12m: Number(inflacion?.acumulado_12m_pct) || 0,
  inflacionMes: Number(inflacion?.last_month?.valor) || 0,
  fireTasaRetiro: FIRE.tasaRetiroPct,
  fireRendReal: FIRE.rendimientoRealPct,
  regla: REGLA_503020,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ LIVE }}>
  (function () {
    const H = window.HC_HUB;

    /** VF de una serie de aportes mensuales vencidos. Espejo de ahorro-hormiga.ts */
    function vfAnualidad(aporte, i, n) {
      if (i === 0) return aporte * n;
      return aporte * ((Math.pow(1 + i, n) - 1) / i);
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'meta-fecha';

      const ingreso = Math.max(0, v.ingreso || 0);
      const gastos = Math.max(0, v.gastos || 0);
      const meta = Math.max(0, v.meta || 0);
      const plazo = Math.max(1, Math.round(v.plazo || 1));
      const cuota = Math.max(0, v.cuota || 0);
      const ahorroActual = Math.max(0, v.ahorroActual || 0);
      const mesesColchon = Math.max(1, Math.round(v.mesesColchon || 1));
      const gastoDiario = Math.max(0, v.gastoDiario || 0);
      const tna = Math.max(0, v.tna != null ? v.tna : LIVE.tnaPlazoFijo);

      // TNA con capitalización mensual: espejo de ahorro-meta.ts y ahorro-hormiga.ts.
      const i = tna / 100 / 12;

      // ── 1. Tengo meta y fecha: ¿cuánto por mes?
      if (id === 'meta-fecha') {
        const vfInicial = ahorroActual * Math.pow(1 + i, plazo);
        const faltante = Math.max(0, meta - vfInicial);
        const factor = i === 0 ? plazo : (Math.pow(1 + i, plazo) - 1) / i;
        const aporte = faltante > 0 ? faltante / factor : 0;
        const totalAportado = aporte * plazo;
        const intereses = Math.max(0, meta - totalAportado - ahorroActual);
        // Meta reexpresada al final del plazo con la inflación interanual vigente.
        const metaHoy = meta * Math.pow(1 + LIVE.inflacion12m / 100, plazo / 12);

        const rows = [
          { k: 'Cuota mensual necesaria', v: Math.round(aporte), extra: true },
          { k: 'Total que ponés de tu bolsillo', v: Math.round(totalAportado) },
          { k: 'Lo que ya tenías, con su rendimiento', ref: 'valor futuro', v: Math.round(vfInicial) },
          { k: 'Intereses ganados en el camino', v: Math.round(intereses) },
          { k: 'Meta a alcanzar', v: Math.round(meta) },
          {
            k: 'La misma meta al final del plazo, ajustada por inflación',
            ref: 'IPC 12 meses ' + LIVE.inflacion12m.toFixed(1) + '%',
            v: Math.round(metaHoy),
          },
          { k: 'Peso de la cuota sobre tu ingreso', v: ingreso > 0 ? (aporte / ingreso) * 100 : 0, format: 'unit', unit: '%', decimals: 1 },
        ];

        const chart = [
          { label: 'De tu bolsillo', value: Math.round(totalAportado), tone: 'main' },
          { label: 'Intereses', value: Math.round(intereses), tone: 'good' },
        ];
        if (ahorroActual > 0) chart.push({ label: 'Ya lo tenías', value: Math.round(ahorroActual), tone: 'prop' });

        return {
          total: H.ars(aporte),
          sub:
            'por mes durante ' + plazo + ' meses para llegar a ' + H.ars(meta) +
            (tna > 0 ? ' · rendimiento ' + tna.toFixed(2) + '% TNA' : ' · sin rendimiento'),
          rows: rows,
          chart: chart,
        };
      }

      // ── 2. Puedo poner $X por mes: ¿cuánto tardo?
      if (id === 'meta-cuota') {
        let saldo = ahorroActual;
        let meses = 0;
        const MAX = 1200;
        if (saldo < meta && cuota <= 0) {
          return {
            total: '—',
            sub: 'Cargá una cuota mensual mayor a cero para estimar el plazo.',
            rows: [{ k: 'Te falta juntar', v: Math.round(Math.max(0, meta - saldo)) }],
            chart: [{ label: 'Te falta', value: Math.round(Math.max(0, meta - saldo)), tone: 'warn' }],
          };
        }
        while (saldo < meta && meses < MAX) {
          saldo = saldo * (1 + i) + cuota;
          meses += 1;
        }
        const totalAportado = ahorroActual + cuota * meses;
        const intereses = Math.max(0, saldo - totalAportado);
        const anios = Math.floor(meses / 12);
        const resto = meses % 12;
        const plazoTxt =
          meses === 0
            ? 'ya la tenés cubierta'
            : [anios ? anios + (anios === 1 ? ' año' : ' años') : '', resto ? resto + (resto === 1 ? ' mes' : ' meses') : '']
                .filter(Boolean)
                .join(' y ');

        const rows = [
          { k: 'Meses hasta la meta', v: meses, format: 'unit', unit: meses === 1 ? 'mes' : 'meses', extra: true },
          { k: 'Cuota mensual que ponés', v: Math.round(cuota) },
          { k: 'Total aportado en el camino', v: Math.round(totalAportado) },
          { k: 'Intereses ganados', v: Math.round(intereses) },
          { k: 'Saldo al llegar', v: Math.round(saldo) },
          { k: 'Cuota mensual sobre tu ingreso', v: ingreso > 0 ? (cuota / ingreso) * 100 : 0, format: 'unit', unit: '%', decimals: 1 },
        ];

        const chart = [
          { label: 'Aportado por vos', value: Math.round(cuota * meses), tone: 'main' },
          { label: 'Intereses', value: Math.round(intereses), tone: 'good' },
        ];
        if (ahorroActual > 0) chart.push({ label: 'Punto de partida', value: Math.round(ahorroActual), tone: 'prop' });

        return {
          total: meses + (meses === 1 ? ' mes' : ' meses'),
          sub:
            'con ' + H.ars(cuota) + ' por mes llegás a ' + H.ars(meta) +
            (plazoTxt && meses > 0 ? ' en ' + plazoTxt : '') +
            (meses >= MAX ? ' · con esta cuota la meta demora más de 100 años: subila' : ''),
          rows: rows,
          chart: chart,
        };
      }

      // ── 3. Fondo de emergencia
      if (id === 'fondo-emergencia') {
        const fondoIdeal = gastos * mesesColchon;
        const faltante = Math.max(0, fondoIdeal - ahorroActual);
        const mesesCubiertos = gastos > 0 ? ahorroActual / gastos : 0;
        // Espejo de fondo-emergencia-meses.ts: si no hay aporte propio, sugiere el 20% de los gastos.
        const aporteSugerido = gastos * 0.2;
        const aporteEfectivo = cuota > 0 ? cuota : aporteSugerido;
        const mesesParaCompletarlo = aporteEfectivo > 0 && faltante > 0 ? Math.ceil(faltante / aporteEfectivo) : 0;
        const yaAhorrado = Math.min(ahorroActual, fondoIdeal);

        const rows = [
          { k: 'Fondo objetivo', ref: mesesColchon + ' meses de gastos', v: Math.round(fondoIdeal), extra: true },
          { k: 'Lo que ya tenés', v: Math.round(ahorroActual) },
          { k: 'Te falta juntar', v: Math.round(faltante) },
          { k: 'Meses de gastos que cubrís hoy', v: mesesCubiertos, format: 'unit', unit: 'meses', decimals: 1 },
          { k: 'Aporte mensual considerado', ref: cuota > 0 ? 'el tuyo' : '20% de tus gastos', v: Math.round(aporteEfectivo) },
          {
            k: 'Meses para completarlo a ese ritmo',
            v: mesesParaCompletarlo,
            format: 'unit',
            unit: mesesParaCompletarlo === 1 ? 'mes' : 'meses',
          },
          { k: 'Avance del fondo', v: fondoIdeal > 0 ? (yaAhorrado / fondoIdeal) * 100 : 0, format: 'unit', unit: '%', decimals: 1 },
        ];

        return {
          total: H.ars(fondoIdeal),
          sub:
            faltante > 0
              ? 'te faltan ' + H.ars(faltante) + ' · cubrís ' + mesesCubiertos.toFixed(1) + ' de los ' + mesesColchon + ' meses'
              : 'fondo completo: cubrís ' + mesesCubiertos.toFixed(1) + ' meses de gastos',
          rows: rows,
          chart: [
            { label: 'Ya ahorrado', value: Math.round(yaAhorrado), tone: 'good' },
            { label: 'Faltante', value: Math.round(faltante), tone: 'warn' },
          ],
        };
      }

      // ── 4. Repartir el sueldo con la regla 50/30/20
      if (id === 'reparto-sueldo') {
        const necesidades = ingreso * LIVE.regla.necesidades;
        const deseos = ingreso * LIVE.regla.deseos;
        const ahorro = ingreso * LIVE.regla.ahorro;
        const pctReal = ingreso > 0 ? (cuota / ingreso) * 100 : 0;
        const clasificacion = pctReal < 10 ? 'baja' : pctReal <= 20 ? 'saludable' : 'muy buena';

        const rows = [
          { k: 'Necesidades', ref: '50%', v: Math.round(necesidades) },
          { k: 'Gustos', ref: '30%', v: Math.round(deseos) },
          { k: 'Ahorro', ref: '20%', v: Math.round(ahorro), extra: true },
          { k: 'Ahorro acumulado en un año', v: Math.round(ahorro * 12) },
          { k: 'Lo que apartás hoy', v: Math.round(cuota) },
          { k: 'Tu tasa de ahorro real', ref: clasificacion, v: pctReal, format: 'unit', unit: '%', decimals: 1 },
          { k: 'Diferencia contra el 20% objetivo', v: Math.round(ahorro - cuota) },
          { k: 'Gastos fijos sobre el ingreso', v: ingreso > 0 ? (gastos / ingreso) * 100 : 0, format: 'unit', unit: '%', decimals: 1 },
        ];

        return {
          total: H.ars(ahorro),
          sub:
            'es el 20% de ' + H.ars(ingreso) + ' · hoy apartás ' + H.ars(cuota) +
            ' (' + pctReal.toFixed(1) + '%, tasa ' + clasificacion + ')',
          rows: rows,
          chart: [
            { label: 'Necesidades (50%)', value: Math.round(necesidades), tone: 'main' },
            { label: 'Gustos (30%)', value: Math.round(deseos), tone: 'exit' },
            { label: 'Ahorro (20%)', value: Math.round(ahorro), tone: 'good' },
          ],
        };
      }

      // ── 5. Gasto hormiga
      if (id === 'gasto-hormiga') {
        const mensual = gastoDiario * 30;
        const a1 = vfAnualidad(mensual, i, 12);
        const a5 = vfAnualidad(mensual, i, 60);
        const a10 = vfAnualidad(mensual, i, 120);
        const aportado10 = mensual * 120;
        const interes10 = Math.max(0, a10 - aportado10);

        const rows = [
          { k: 'Ese gasto, al mes', v: Math.round(mensual) },
          { k: 'En 1 año, invertido', v: Math.round(a1) },
          { k: 'En 5 años, invertido', v: Math.round(a5) },
          { k: 'En 10 años, invertido', v: Math.round(a10), extra: true },
          { k: 'De eso, aportado por vos', v: Math.round(aportado10) },
          { k: 'De eso, intereses', v: Math.round(interes10) },
          { k: 'Peso del gasto sobre tu ingreso mensual', v: ingreso > 0 ? (mensual / ingreso) * 100 : 0, format: 'unit', unit: '%', decimals: 1 },
        ];

        return {
          total: H.ars(a10),
          sub:
            'es lo que juntarías en 10 años cortando ' + H.ars(gastoDiario) + ' por día' +
            (tna > 0 ? ' e invirtiéndolo al ' + tna.toFixed(2) + '% TNA' : ' sin invertirlo'),
          rows: rows,
          chart: [
            { label: 'Aportado por vos', value: Math.round(aportado10), tone: 'main' },
            { label: 'Intereses en 10 años', value: Math.round(interes10), tone: 'good' },
          ],
        };
      }

      // ── 6. FIRE: vivir de la renta
      const gastosAnuales = gastos * 12;
      const multiplicador = 100 / LIVE.fireTasaRetiro; // regla del 4% = 25×
      const numeroFire = gastosAnuales * multiplicador;
      const falta = Math.max(0, numeroFire - ahorroActual);
      // Rendimiento REAL (por encima de la inflación): espejo del default de fire-retiro-temprano.ts.
      const rReal = LIVE.fireRendReal / 100 / 12;
      let aniosFire = 0;
      if (falta > 0 && (cuota > 0 || ahorroActual > 0)) {
        let lo = 0, hi = 1200;
        for (let k = 0; k < 80; k++) {
          const mid = (lo + hi) / 2;
          const factor = Math.pow(1 + rReal, mid);
          const vf = ahorroActual * factor + (rReal > 0 ? cuota * ((factor - 1) / rReal) : cuota * mid);
          if (vf < numeroFire) lo = mid; else hi = mid;
        }
        aniosFire = ((lo + hi) / 2) / 12;
      }
      const rentaMensual = (numeroFire * LIVE.fireTasaRetiro) / 100 / 12;
      const progreso = numeroFire > 0 ? Math.min((ahorroActual / numeroFire) * 100, 100) : 0;

      const rowsFire = [
        { k: 'Tu número FIRE', ref: multiplicador + '× gastos anuales', v: Math.round(numeroFire), extra: true },
        { k: 'Gastos de un año', v: Math.round(gastosAnuales) },
        { k: 'Lo que ya tenés', v: Math.round(ahorroActual) },
        { k: 'Te falta juntar', v: Math.round(falta) },
        { k: 'Renta mensual que daría ese capital', ref: LIVE.fireTasaRetiro + '% anual', v: Math.round(rentaMensual) },
        {
          k: 'Años hasta llegar con tu aporte',
          ref: 'rendimiento real ' + LIVE.fireRendReal + '%',
          v: aniosFire,
          format: 'unit',
          unit: 'años',
          decimals: 1,
        },
        { k: 'Avance hacia tu número', v: progreso, format: 'unit', unit: '%', decimals: 1 },
      ];

      return {
        total: H.ars(numeroFire),
        sub:
          aniosFire > 0
            ? 'llevás ' + progreso.toFixed(0) + '% del camino · a tu ritmo llegarías en ' + aniosFire.toFixed(1) + ' años'
            : ahorroActual >= numeroFire
              ? 'ya alcanzaste tu número: la renta cubre tus gastos'
              : 'definí un aporte mensual para estimar en cuánto tiempo llegás',
        rows: rowsFire,
        chart: [
          { label: 'Capital que ya tenés', value: Math.round(Math.min(ahorroActual, numeroFire)), tone: 'good' },
          { label: 'Falta juntar', value: Math.round(falta), tone: 'warn' },
        ],
      };
    });
  })();
</script>
