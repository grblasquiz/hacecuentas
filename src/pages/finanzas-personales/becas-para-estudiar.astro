---
/**
 * Hub de decisión — "¿Cuánto voy a cobrar de beca para estudiar y qué me descuentan?"
 * Reemplaza 4 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/becas-para-estudiar.ts) y su
 * compute(). Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y
 * no se tocan.
 *
 * OJO: el índice del silo lo sirve src/pages/finanzas-personales.astro (pillar
 * page). Acá NO va un index.astro: sería una ruta duplicada.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BecasEstudiarExperience from '../../components/generated/BecasEstudiarExperience.astro';
import { hub, CASE_MATH } from '../../lib/hubs/becas-para-estudiar';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <BecasEstudiarExperience data={hub} />
  <Footer />
</Layout>

