---
/**
 * Hub de decisión — "¿En qué se me va la plata?"
 * Reemplaza 16 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: gastos fijos (default), transporte, suscripciones y
 * delivery, y qué conviene comprar.
 *
 * Lo que se absorbe pero NO se reimplementa, por no responder "¿en qué se me va
 * la plata?" todos los meses:
 *   - costo-recital-festival-argentina: gasto de evento puntual, no recurrente.
 *     Se puede cargar a mano como parte del delivery/ocio del mes.
 *   - ahorro-bicicleta-vs-auto-mensual: es una comparación de escenarios, no un
 *     gasto del mes. El transporte del hub modela SUBE, que es lo que la enorme
 *     mayoría paga.
 *   - costo-hijo-mensual y costo-streaming-argentina: quedan cubiertos por la
 *     canasta (el menor pondera 0,63 de un adulto equivalente) y por el campo de
 *     suscripciones respectivamente.
 * Las cuatro URLs redirigen igual.
 *
 * OJO: la canasta INDEC y la tarifa SUBE vienen de `lib/hubs/gastos-del-mes.ts`,
 * que a su vez espeja los módulos reales de `lib/formulas`. No hardcodear nada
 * acá adentro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GastosDelMesExperience from '../../components/generated/GastosDelMesExperience.astro';
import {
  hub,
  CBA_AE,
  ICE,
  AE_ADULTO,
  AE_MENOR,
  TARIFA_COLECTIVO,
  ESCALA_SUBE,
  TARIFA_SOCIAL_OFF,
  SEMANAS_MES,
  CIGARRILLOS_POR_ATADO,
  PRECIO_ATADO,
} from '../../lib/hubs/gastos-del-mes';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <GastosDelMesExperience data={hub} />
  <Footer />
</Layout>

