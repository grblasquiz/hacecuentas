---
/**
 * Hub de decisión — "¿En qué se me va la plata?"
 * Reemplaza 16 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo RAMIFICADO: gastos fijos (default), transporte, suscripciones y
 * delivery, y qué conviene comprar.
 *
 * Lo que se absorbe pero NO se reimplementa, por no responder "¿en qué se me va
 * la plata?" todos los meses:
 *   - costo-recital-festival-argentina: gasto de evento puntual, no recurrente.
 *     Se puede cargar a mano como parte del delivery/ocio del mes.
 *   - ahorro-bicicleta-vs-auto-mensual: es una comparación de escenarios, no un
 *     gasto del mes. El transporte del hub modela SUBE, que es lo que la enorme
 *     mayoría paga.
 *   - costo-hijo-mensual y costo-streaming-argentina: quedan cubiertos por la
 *     canasta (el menor pondera 0,63 de un adulto equivalente) y por el campo de
 *     suscripciones respectivamente.
 * Las cuatro URLs redirigen igual.
 *
 * OJO: la canasta INDEC y la tarifa SUBE vienen de `lib/hubs/gastos-del-mes.ts`,
 * que a su vez espeja los módulos reales de `lib/formulas`. No hardcodear nada
 * acá adentro.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GastosDelMesExperience from '../../components/generated/GastosDelMesExperience.astro';
import {
  hub,
  CBA_AE,
  ICE,
  AE_ADULTO,
  AE_MENOR,
  TARIFA_COLECTIVO,
  ESCALA_SUBE,
  TARIFA_SOCIAL_OFF,
  SEMANAS_MES,
  CIGARRILLOS_POR_ATADO,
  PRECIO_ATADO,
} from '../../lib/hubs/gastos-del-mes';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <GastosDelMesExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    CBA_AE,
    ICE,
    AE_ADULTO,
    AE_MENOR,
    TARIFA: TARIFA_COLECTIVO,
    ESCALA: ESCALA_SUBE,
    SOCIAL_OFF: TARIFA_SOCIAL_OFF,
    SEMANAS_MES,
    POR_ATADO: CIGARRILLOS_POR_ATADO,
    PRECIO_ATADO,
  }}
>
  (function () {
    const H = window.HC_HUB;

    /** Fila que NO es plata: siempre con unidad explícita. */
    const U = function (k, unit, v, decimals, ref) {
      return { k: k, v: v, format: 'unit', unit: unit, decimals: decimals || 0, ref: ref };
    };
    /** Fila en pesos (formato base del hub). */
    const $ = function (k, v, ref, extra) {
      return { k: k, v: v, ref: ref, extra: !!extra };
    };

    /**
     * Gasto mensual en colectivo con la escala de frecuencia aplicada.
     * El descuento es MARGINAL: cada tramo paga su propio porcentaje.
     * La Tarifa Social Federal se acumula: reduce la tarifa base antes de la escala.
     */
    const gastoSube = function (viajesMes, social) {
      const base = TARIFA * (social ? 1 - SOCIAL_OFF : 1);
      let total = 0;
      const tramos = [];
      for (let i = 0; i < ESCALA.length; i++) {
        const t = ESCALA[i];
        if (viajesMes < t.desde) break;
        const hasta = t.hasta == null ? viajesMes : Math.min(viajesMes, t.hasta);
        const n = hasta - t.desde + 1;
        const precio = base * (1 - t.off);
        total += n * precio;
        tramos.push({ label: t.label, viajes: n, subtotal: n * precio, off: t.off });
      }
      return { total: total, tramos: tramos, base: base, plena: viajesMes * base };
    };

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'fijos';

      // ── entradas ──────────────────────────────────────────────────────────
      const alquiler = Math.max(0, v.alquiler || 0);
      const servicios = Math.max(0, v.servicios || 0);
      const adultos = Math.max(0, Math.round(v.adultos || 0));
      const menores = Math.max(0, Math.round(v.menores || 0));
      const ae = adultos * AE_ADULTO + menores * AE_MENOR;
      const cbtHogar = CBA_AE * ICE * ae;
      const superCargado = Math.max(0, v.supermercado || 0);
      const comida = superCargado > 0 ? superCargado : cbtHogar;
      const comidaEsCanasta = superCargado <= 0;

      const viajesMes = Math.max(0, Math.round((v.viajesDia || 0) * (v.diasMes || 0)));
      const social = v.tarifaSocial === 'si';
      const sube = gastoSube(viajesMes, social);

      const suscripciones = Math.max(0, v.suscripciones || 0);
      const pedidosSemana = Math.max(0, v.pedidosSemana || 0);
      const gastoPedido = Math.max(0, v.gastoPedido || 0);
      const pedidosMes = pedidosSemana * SEMANAS_MES;
      const delivery = pedidosMes * gastoPedido;

      const cigDia = Math.max(0, v.cigarrillosDia || 0);
      const gastoCigDia = (cigDia * PRECIO_ATADO) / POR_ATADO;
      const cigarrillos = gastoCigDia * 30;

      const vivienda = alquiler + servicios;
      const totalMes = vivienda + comida + sube.total + suscripciones + delivery + cigarrillos;

      // ── caso: transporte ──────────────────────────────────────────────────
      if (id === 'transporte') {
        const rows = [
          U('Viajes por mes', 'viajes', viajesMes, 0, 'Viajes por día × días'),
          $('Tarifa aplicada por viaje', sube.base, social ? 'Boleto mínimo AMBA − 55% Tarifa Social' : 'Boleto mínimo AMBA con SUBE'),
        ];
        sube.tramos.forEach(function (t) {
          rows.push($(t.label + (t.off ? ' (−' + Math.round(t.off * 100) + '%)' : ' (tarifa plena)'), t.subtotal, t.viajes + ' viajes'));
        });
        rows.push($('Gasto mensual en colectivo', sube.total, 'Escala SUBE aplicada', true));
        rows.push($('Lo mismo sin la escala de frecuencia', sube.plena, 'Comparación'));
        rows.push($('Ahorro mensual por viajar seguido', Math.max(0, sube.plena - sube.total), 'Red SUBE'));
        rows.push($('Gasto anual en transporte', sube.total * 12, 'Proyección'));
        rows.push(U('Peso del transporte en tu mes', '%', totalMes ? (sube.total / totalMes) * 100 : 0, 1, 'Sobre el gasto total'));

        const chart = sube.tramos.length
          ? sube.tramos.map(function (t, i) {
              return { label: t.label, value: Math.round(t.subtotal), tone: i === 0 ? 'main' : 'good' };
            })
          : [{ label: 'Sin viajes cargados', value: 0, tone: 'warn' }];

        return {
          total: H.ars(sube.total),
          sub:
            viajesMes + ' viajes al mes a ' + H.ars(sube.base) + ' de base' +
            (social ? ' (con Tarifa Social Federal)' : '') +
            ' · ahorrás ' + H.ars(Math.max(0, sube.plena - sube.total)) + ' contra la tarifa plena',
          rows: rows,
          chart: chart,
        };
      }

      // ── caso: suscripciones y delivery ────────────────────────────────────
      if (id === 'suscripciones') {
        const invisible = suscripciones + delivery + cigarrillos;
        const rows = [
          $('Suscripciones del mes', suscripciones, 'Débitos automáticos'),
          U('Pedidos de delivery al mes', 'pedidos', pedidosMes, 1, 'Semanas × 4,33'),
          $('Delivery del mes', delivery, 'Pedidos × gasto promedio'),
        ];
        if (cigDia > 0) {
          rows.push($('Cigarrillos del mes', cigarrillos, cigDia + ' por día · atado de ' + POR_ATADO));
          rows.push($('Lo que ahorrarías en 10 años si dejás', gastoCigDia * 365 * 10, 'Sin contar aumentos'));
        }
        rows.push($('Total de gastos "invisibles" por mes', invisible, 'Suscripciones + delivery + cigarrillos', true));
        rows.push($('Lo mismo por año', invisible * 12, 'Proyección', true));
        rows.push(U('Peso sobre tu gasto mensual', '%', totalMes ? (invisible / totalMes) * 100 : 0, 1, 'Sobre el total'));

        const chart = [
          { label: 'Suscripciones', value: Math.round(suscripciones), tone: 'main' },
          { label: 'Delivery', value: Math.round(delivery), tone: 'warn' },
        ];
        if (cigarrillos > 0) chart.push({ label: 'Cigarrillos', value: Math.round(cigarrillos), tone: 'bad' });

        return {
          total: H.ars(invisible),
          sub:
            'Por mes se te van ' + H.ars(invisible) + ' en cosas que no se ven en el resumen: ' +
            H.ars(invisible * 12) + ' al año.',
          rows: rows,
          chart: chart,
        };
      }

      // ── caso: qué me conviene comprar ─────────────────────────────────────
      if (id === 'compras') {
        const pA = Math.max(0, v.precioA || 0);
        const cA = Math.max(0, v.cantidadA || 0);
        const pB = Math.max(0, v.precioB || 0);
        const cB = Math.max(0, v.cantidadB || 0);

        if (!pA || !cA || !pB || !cB) {
          return {
            total: '—',
            sub: 'Cargá precio y cantidad de los dos productos para comparar por kilo.',
            rows: [],
            chart: [],
          };
        }

        // Normalización a la unidad grande (kilo o litro): la cantidad se carga en g o ml.
        const unitA = (pA / cA) * 1000;
        const unitB = (pB / cB) * 1000;
        const ganaA = unitA <= unitB;
        const caro = Math.max(unitA, unitB);
        const barato = Math.min(unitA, unitB);
        const difPct = barato > 0 ? ((caro - barato) / barato) * 100 : 0;

        const rows = [
          $('Producto A — precio por kilo o litro', unitA, cA + ' g/ml a ' + H.ars(pA), ganaA),
          $('Producto B — precio por kilo o litro', unitB, cB + ' g/ml a ' + H.ars(pB), !ganaA),
          $('Diferencia por kilo o litro', caro - barato, 'A favor del más conveniente'),
          U('Cuánto más caro es el otro', '%', difPct, 1, 'Sobre el más barato'),
          $('Lo que ahorrás llevando 4 kilos o litros al mes', (caro - barato) * 4, 'Compra habitual'),
          $('Lo mismo en un año', (caro - barato) * 4 * 12, 'Proyección'),
        ];

        return {
          total: H.ars(barato),
          sub:
            'Conviene el Producto ' + (ganaA ? 'A' : 'B') + ': ' + H.ars(barato) +
            ' por kilo o litro contra ' + H.ars(caro) + ', un ' +
            difPct.toFixed(1).replace('.', ',') + '% de diferencia.',
          rows: rows,
          chart: [
            { label: 'Producto A por kilo', value: Math.round(unitA), tone: ganaA ? 'good' : 'warn' },
            { label: 'Producto B por kilo', value: Math.round(unitB), tone: ganaA ? 'warn' : 'good' },
          ],
        };
      }

      // ── caso por defecto: mis gastos fijos del mes ─────────────────────────
      const rows = [
        $('Alquiler o cuota + expensas', alquiler, 'Vivienda'),
        $('Servicios del hogar', servicios, 'Luz, gas, agua, internet, celular'),
        $(
          comidaEsCanasta ? 'Comida en casa (Canasta Básica Total del INDEC)' : 'Súper y comida en casa',
          comida,
          comidaEsCanasta ? 'CBA ' + H.ars(CBA_AE) + '/AE × ICE ' + String(ICE).replace('.', ',') : 'Tu dato'
        ),
        U('Adultos equivalentes de tu hogar', 'AE', ae, 2, 'Escala INDEC · menor 0,63'),
        $('Transporte (SUBE con descuentos)', sube.total, viajesMes + ' viajes al mes'),
        $('Suscripciones', suscripciones, 'Débitos automáticos'),
        $('Delivery', delivery, pedidosMes.toFixed(1).replace('.', ',') + ' pedidos al mes'),
      ];
      if (cigarrillos > 0) rows.push($('Cigarrillos', cigarrillos, cigDia + ' por día'));
      rows.push($('Total del mes', totalMes, 'Suma de rubros', true));
      rows.push($('Total del año', totalMes * 12, 'Proyección'));
      rows.push($('Gasto diario promedio', totalMes / 30, 'Total ÷ 30'));

      const segs = [
        { label: 'Vivienda y servicios', value: Math.round(vivienda), tone: 'main' },
        { label: 'Comida en casa', value: Math.round(comida), tone: 'good' },
        { label: 'Transporte', value: Math.round(sube.total), tone: 'prop' },
        { label: 'Suscripciones', value: Math.round(suscripciones), tone: 'warn' },
        { label: 'Delivery', value: Math.round(delivery), tone: 'exit' },
      ];
      if (cigarrillos > 0) segs.push({ label: 'Cigarrillos', value: Math.round(cigarrillos), tone: 'bad' });

      const mayor = segs.slice().sort(function (a, b) { return b.value - a.value; })[0];
      const pctMayor = totalMes ? Math.round((mayor.value / totalMes) * 100) : 0;

      return {
        total: H.ars(totalMes),
        sub:
          'Lo más pesado es ' + mayor.label.toLowerCase() + ': ' + pctMayor + '% de tu mes' +
          (comidaEsCanasta ? ' · comida estimada con la CBT del INDEC para ' + ae.toFixed(2).replace('.', ',') + ' adultos equivalentes' : '') +
          ' · ' + H.ars(totalMes * 12) + ' al año',
        rows: rows,
        chart: segs,
      };
    });
  })();
</script>
