---
/**
 * Hub de decisión — "¿Cuánto voy a pagar por este préstamo?"
 * Reemplaza 10 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/prestamo.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 *
 * OJO: el índice del silo lo sirve src/pages/finanzas-personales.astro (pillar
 * page). Acá NO va un index.astro: sería una ruta duplicada.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, BNA, DTI } from '../../lib/hubs/prestamo';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ BNA, DTI }}>
  (function () {
    const H = window.HC_HUB;

    const nf = (n, d) =>
      Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });
    const pct = (n) => nf(n, 1) + '%';

    /**
     * Motor único del hub. Espejo de src/lib/formulas/costo-financiero-total-cft.ts:
     * cuota pura por sistema francés, IVA sobre el interés de cada mes, seguro
     * mensual fijo, y CFT como TIR del flujo real anualizada (Newton-Raphson).
     */
    function motor(monto, tnaPct, plazo, seguro, gastos, ivaPct) {
      const i = tnaPct / 100 / 12;
      const n = Math.max(1, Math.round(plazo));
      const factor = Math.pow(1 + i, n);
      const cuotaPura = i === 0 ? monto / n : (monto * i * factor) / (factor - 1);

      let saldo = monto;
      let interesTotal = 0;
      let ivaTotal = 0;
      let totalPagado = gastos;
      let cuotaPrimera = 0;
      const flujos = [];
      const montoNeto = monto - gastos;

      for (let m = 1; m <= n; m++) {
        const interesMes = saldo * i;
        const capitalMes = cuotaPura - interesMes;
        const ivaMes = interesMes * (ivaPct / 100);
        const cuotaTotal = cuotaPura + ivaMes + seguro;
        if (m === 1) cuotaPrimera = cuotaTotal;
        interesTotal += interesMes;
        ivaTotal += ivaMes;
        flujos.push(cuotaTotal);
        totalPagado += cuotaTotal;
        saldo -= capitalMes;
      }

      // TIR mensual por Newton-Raphson, arrancando desde la tasa nominal.
      let tir = i > 0 ? i : 0.01;
      for (let iter = 0; iter < 200; iter++) {
        let vpn = -montoNeto;
        let dvpn = 0;
        for (let m = 0; m < flujos.length; m++) {
          vpn += flujos[m] / Math.pow(1 + tir, m + 1);
          dvpn -= ((m + 1) * flujos[m]) / Math.pow(1 + tir, m + 2);
        }
        if (Math.abs(dvpn) < 1e-15) break;
        const delta = vpn / dvpn;
        tir -= delta;
        if (Math.abs(delta) < 1e-10) break;
      }

      return {
        cuotaPura: cuotaPura,
        cuotaPrimera: cuotaPrimera,
        interesTotal: interesTotal,
        ivaTotal: ivaTotal,
        seguroTotal: seguro * n,
        gastos: gastos,
        totalPagado: totalPagado,
        costoTotal: totalPagado - monto,
        tea: (Math.pow(1 + i, 12) - 1) * 100,
        cft: (Math.pow(1 + tir, 12) - 1) * 100,
        n: n,
      };
    }

    /** Monto máximo financiable con una cuota pura dada. */
    function montoDesdeCuota(cuota, tnaPct, plazo) {
      const i = tnaPct / 100 / 12;
      const n = Math.max(1, Math.round(plazo));
      if (i === 0) return cuota * n;
      const factor = Math.pow(1 + i, n);
      return (cuota * (factor - 1)) / (i * factor);
    }

    H.onCompute(function (v, caso) {
      const rama = (caso && caso.id) || 'personal';

      const monto = Math.max(0, Number(v.monto) || 0);
      const tna = Math.max(0, Number(v.tna) || 0);
      const plazo = Math.min(360, Math.max(1, Math.round(Number(v.plazo) || 1)));
      const seguro = Math.max(0, Number(v.seguro) || 0);
      const gastos = Math.max(0, Number(v.gastos) || 0);
      const iva = Math.max(0, Number(v.iva) || 0);
      const ingreso = Math.max(0, Number(v.ingreso) || 0);
      const cuotasActuales = Math.max(0, Number(v.cuotasActuales) || 0);
      const tnaB = Math.max(0, Number(v.tnaB) || 0);
      const plazoB = Math.min(360, Math.max(1, Math.round(Number(v.plazoB) || 1)));

      // ─────────────────── ¿QUÉ CUOTA AGUANTO? ───────────────────
      if (rama === 'capacidad') {
        if (!ingreso) {
          return { total: '—', sub: 'Cargá tu ingreso mensual para ver el límite.', rows: [], chart: [] };
        }
        const limite30 = ingreso * DTI.CONSERVADOR;
        const limite40 = ingreso * DTI.MAXIMO;
        const disponible30 = Math.max(0, limite30 - cuotasActuales);
        const disponible40 = Math.max(0, limite40 - cuotasActuales);
        const ratioActual = (cuotasActuales / ingreso) * 100;

        // Con la cuota disponible, cuánto capital soportaría a esta tasa y plazo.
        // Se descuenta el seguro mensual porque no amortiza capital.
        const cuotaParaCapital = Math.max(0, disponible30 - seguro);
        const montoMax = montoDesdeCuota(cuotaParaCapital / (1 + iva / 100), tna, plazo);
        const ratioConNueva = ((cuotasActuales + disponible30) / ingreso) * 100;

        const rows = [
          { k: 'Tu ingreso mensual', v: Math.round(ingreso) },
          { k: 'Límite conservador de cuotas', ref: '30% del ingreso', v: Math.round(limite30) },
          { k: 'Límite máximo de cuotas', ref: '40% del ingreso', v: Math.round(limite40) },
          { k: 'Cuotas que ya pagás', v: Math.round(cuotasActuales) },
          { k: 'Cuota nueva disponible al 30%', v: Math.round(disponible30), extra: true },
          { k: 'Cuota nueva disponible al 40%', v: Math.round(disponible40) },
          { k: 'Monto máximo que podrías financiar', ref: plazo + ' meses al ' + pct(tna), v: Math.round(Math.max(0, montoMax)) },
          { k: 'Tu ratio de endeudamiento actual', v: Number(ratioActual.toFixed(1)), format: 'unit', unit: '%', decimals: 1 },
          { k: 'Ratio si usás toda la cuota disponible', v: Number(ratioConNueva.toFixed(1)), format: 'unit', unit: '%', decimals: 1 },
        ];

        return {
          total: H.ars(Math.round(disponible30)),
          sub:
            'Con un ingreso de ' + H.ars(Math.round(ingreso)) + ' el límite conservador son ' +
            H.ars(Math.round(limite30)) + ' en cuotas. Hoy pagás ' + H.ars(Math.round(cuotasActuales)) +
            ' (' + pct(ratioActual) + ' del ingreso), así que te queda margen para ' +
            H.ars(Math.round(disponible30)) + ' de cuota nueva: unos ' + H.ars(Math.round(Math.max(0, montoMax))) +
            ' de capital a ' + plazo + ' meses. Es un límite de planificación, no una aprobación.',
          rows: rows,
          chart: [
            { label: 'Cuotas que ya pagás', value: Math.round(cuotasActuales), tone: 'warn' },
            { label: 'Margen para una cuota nueva', value: Math.round(disponible30), tone: 'good' },
            { label: 'Resto del ingreso', value: Math.round(Math.max(0, ingreso - cuotasActuales - disponible30)), tone: 'prop' },
          ],
        };
      }

      if (!monto) {
        return { total: '—', sub: 'Cargá el monto del préstamo para ver la cuota.', rows: [], chart: [] };
      }

      // ─────────────────── COMPARAR DOS OFERTAS ───────────────────
      if (rama === 'comparar') {
        const A = motor(monto, tna, plazo, seguro, gastos, iva);
        const B = motor(monto, tnaB, plazoB, seguro, gastos, iva);
        const ganaA = A.totalPagado <= B.totalPagado;
        const G = ganaA ? A : B;
        const diferencia = Math.abs(A.totalPagado - B.totalPagado);

        const rows = [
          { k: 'Oferta A · cuota total', ref: pct(tna) + ' a ' + plazo + ' meses', v: Math.round(A.cuotaPrimera) },
          { k: 'Oferta A · total a pagar', v: Math.round(A.totalPagado) },
          { k: 'Oferta A · CFT anual', v: Number(A.cft.toFixed(1)), format: 'unit', unit: '%', decimals: 1 },
          { k: 'Oferta B · cuota total', ref: pct(tnaB) + ' a ' + plazoB + ' meses', v: Math.round(B.cuotaPrimera) },
          { k: 'Oferta B · total a pagar', v: Math.round(B.totalPagado) },
          { k: 'Oferta B · CFT anual', v: Number(B.cft.toFixed(1)), format: 'unit', unit: '%', decimals: 1 },
          { k: 'Diferencia entre las dos', v: Math.round(diferencia), extra: true },
        ];

        return {
          total: H.ars(Math.round(G.totalPagado)),
          sub:
            'Conviene la oferta ' + (ganaA ? 'A' : 'B') + ': ' + H.ars(Math.round(G.totalPagado)) +
            ' en total contra ' + H.ars(Math.round(ganaA ? B.totalPagado : A.totalPagado)) + ', o sea ' +
            H.ars(Math.round(diferencia)) + ' de diferencia. CFT ' + pct(G.cft) + ' contra ' +
            pct(ganaA ? B.cft : A.cft) + '. La cuota más baja es la de ' +
            (A.cuotaPrimera <= B.cuotaPrimera ? 'A' : 'B') +
            ', que no siempre es la más barata: mirá el costo total.',
          rows: rows,
          chart: [
            { label: 'Capital', value: Math.round(monto), tone: 'main' },
            { label: 'Intereses de la que conviene', value: Math.round(G.interesTotal), tone: 'exit' },
            { label: 'IVA, seguro y gastos', value: Math.round(G.ivaTotal + G.seguroTotal + G.gastos), tone: 'bad' },
          ],
        };
      }

      // ─────────────────── RAMAS DE CÁLCULO DIRECTO ───────────────────
      // personal · bna · auto · pyme comparten motor; cambian los topes y las
      // filas de contexto que se agregan al desglose.
      let montoUsado = monto;
      let plazoUsado = plazo;
      let topeAviso = '';
      if (rama === 'bna') {
        montoUsado = Math.min(monto, BNA.montoMax);
        plazoUsado = Math.min(plazo, BNA.plazoMaxMeses);
        if (montoUsado < monto) topeAviso += ' El BNA topea el monto en ' + H.ars(BNA.montoMax) + '.';
        if (plazoUsado < plazo) topeAviso += ' El plazo máximo del producto es de ' + BNA.plazoMaxMeses + ' meses.';
      }

      const r = motor(montoUsado, tna, plazoUsado, seguro, gastos, iva);
      const brecha = r.cft - r.tea;
      const sobreCapital = (r.costoTotal / montoUsado) * 100;
      const pctInteres = r.totalPagado > 0 ? (r.costoTotal / r.totalPagado) * 100 : 0;

      const rows = [
        { k: 'Capital que te prestan', v: Math.round(montoUsado) },
        { k: 'Cuota pura', ref: 'sistema francés', v: Math.round(r.cuotaPura) },
      ];
      if (iva > 0) rows.push({ k: 'IVA sobre el interés de la 1ª cuota', ref: pct(iva), v: Math.round(r.cuotaPrimera - r.cuotaPura - seguro) });
      if (seguro > 0) rows.push({ k: 'Seguro de vida mensual', v: Math.round(seguro) });
      rows.push({ k: 'Cuota total de la 1ª cuota', v: Math.round(r.cuotaPrimera), extra: true });
      rows.push({ k: 'Intereses de todo el préstamo', v: Math.round(r.interesTotal) });
      if (r.ivaTotal > 0) rows.push({ k: 'IVA acumulado', v: Math.round(r.ivaTotal) });
      if (r.seguroTotal > 0) rows.push({ k: 'Seguro acumulado', ref: r.n + ' meses', v: Math.round(r.seguroTotal) });
      if (r.gastos > 0) rows.push({ k: 'Gastos de otorgamiento', v: Math.round(r.gastos) });
      rows.push({ k: 'Total a pagar', v: Math.round(r.totalPagado) });
      rows.push({ k: 'Costo del crédito', ref: '+' + nf(sobreCapital, 0) + '% sobre el capital', v: Math.round(r.costoTotal) });
      rows.push({ k: 'TNA de la oferta', v: Number(tna.toFixed(1)), format: 'unit', unit: '%', decimals: 1 });
      rows.push({ k: 'TEA sin cargos', v: Number(r.tea.toFixed(1)), format: 'unit', unit: '%', decimals: 1 });
      rows.push({ k: 'CFT anual real', v: Number(r.cft.toFixed(1)), format: 'unit', unit: '%', decimals: 1, extra: true });

      let sub =
        'Cuota total de ' + H.ars(Math.round(r.cuotaPrimera)) + ' por ' + r.n + ' meses. ' +
        'Devolvés ' + H.ars(Math.round(r.totalPagado)) + ' por ' + H.ars(Math.round(montoUsado)) +
        ' prestados: ' + H.ars(Math.round(r.costoTotal)) + ' de costo (+' + nf(sobreCapital, 0) + '%). ' +
        'El CFT real es ' + pct(r.cft) + ', ' + nf(brecha, 1) + ' puntos por encima de la TEA de ' + pct(r.tea) +
        '. Compará siempre por CFT, no por TNA.';

      if (rama === 'bna') {
        const ingresoMinimo = r.cuotaPrimera / BNA.relacionCuotaIngreso;
        const relacion = ingreso > 0 ? (r.cuotaPrimera / ingreso) * 100 : null;
        rows.push({ k: 'Ingreso neto mínimo a demostrar', ref: 'cuota ÷ 30%', v: Math.round(ingresoMinimo) });
        if (relacion !== null) {
          rows.push({ k: 'Tu relación cuota sobre ingreso', ref: 'tope 30%', v: Number(relacion.toFixed(1)), format: 'unit', unit: '%', decimals: 1 });
        }
        sub +=
          ' El BNA pide que la cuota no supere el 30% del ingreso neto: necesitás demostrar al menos ' +
          H.ars(Math.round(ingresoMinimo)) + ' por mes.' +
          (relacion === null
            ? ''
            : relacion <= BNA.relacionCuotaIngreso * 100
              ? ' Con tu ingreso la cuota representa el ' + pct(relacion) + ': calificás por relación cuota-ingreso.'
              : ' Con tu ingreso la cuota representa el ' + pct(relacion) + ': supera el tope. Bajá el monto o estirá el plazo.') +
          topeAviso +
          ' La TNA preferencial de Nación Sueldo ronda el ' + nf(BNA.tnaClienteSueldo, 0) +
          '% y la de libre destino el ' + nf(BNA.tnaNoCliente, 0) + '%: cargá la que te corresponda.';
      }

      if (rama === 'auto') {
        rows.push({ k: 'Parte del total que es interés y cargos', v: Number(pctInteres.toFixed(1)), format: 'unit', unit: '%', decimals: 1 });
        sub +=
          ' De cada peso que pagás, ' + nf(pctInteres, 0) +
          ' centavos no son el auto: son intereses y cargos. Cancelar anticipado al principio es lo que más ahorra.';
      }

      if (rama === 'pyme') {
        sub +=
          ' Si el crédito lleva garantía, la comisión de la SGR va en gastos de otorgamiento y ya está adentro de este CFT: compará este número contra el CFT de la misma línea sin garantía.';
      }

      return {
        total: H.ars(Math.round(r.totalPagado)),
        sub: sub,
        rows: rows,
        chart: [
          { label: 'Capital', value: Math.round(montoUsado), tone: 'main' },
          { label: 'Intereses', value: Math.round(r.interesTotal), tone: 'exit' },
          { label: 'IVA, seguro y gastos', value: Math.round(r.ivaTotal + r.seguroTotal + r.gastos), tone: 'bad' },
        ],
      };
    });
  })();
</script>
