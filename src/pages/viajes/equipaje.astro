---
/**
 * Hub de decisión — "¿Cuánto equipaje puedo llevar y qué me cobran de más?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/equipaje.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EquipajeExperience from '../../components/generated/EquipajeExperience.astro';
import {
  hub,
  CASE_MATH,
  FRANQUICIAS,
  EXCESO,
  MAX_KG_PIEZA,
  RECARGO_MOMENTO,
  ROPA,
  PESO_PRENDA,
  TREK_DURACION,
  TREK_NIVEL,
} from '../../lib/hubs/equipaje';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <EquipajeExperience data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    MATH: CASE_MATH,
    FRQ: FRANQUICIAS,
    EXC: EXCESO,
    MAXKG: MAX_KG_PIEZA,
    MOMENTO: RECARGO_MOMENTO,
    ROPA,
    PESO: PESO_PRENDA,
    TREKD: TREK_DURACION,
    TREKN: TREK_NIVEL,
  }}
>
  (function () {
    const H = window.HC_HUB;

    /** Resuelve la franquicia de la combinación aerolínea × cabina × ruta. */
    function allowance(v) {
      const air = FRQ[v.aerolinea] || FRQ['aerolineas-argentinas'];
      const cab = air.ruta[v.cabina] ? v.cabina : 'estandar';
      const rut = air.ruta[cab][v.ruta] ? v.ruta : 'internacional';
      return { air: air, a: air.ruta[cab][rut], ruta: rut };
    }

    /** Kilos que podés subir sin pagar nada: personal + mano + despachado. */
    function totalPermitido(a) {
      const personal = a.personalKg == null ? 0 : a.personalKg;
      const mano = a.manoKg == null ? 0 : a.manoKg;
      const desp = a.despachadoPiezas * a.despachadoKg;
      return { personal: personal, mano: mano, desp: desp, total: personal + mano + desp };
    }

    /** Espejo de ropaMaletaDiasViaje(): mismas cantidades, misma redondeada. */
    function armarRopa(v) {
      const dias = Math.max(1, Number(v.dias) || 1);
      const lavar = v.lavar !== 'no';
      const clima = ROPA.clima[v.clima] ? v.clima : 'templado';
      const c = ROPA.clima[clima];
      const factor = ROPA.factorEstilo[v.estilo] !== undefined ? ROPA.factorEstilo[v.estilo] : 1;

      const diasRopa = lavar ? Math.min(dias, ROPA.topeConLavado) : Math.min(dias, ROPA.topeSinLavado);
      const lavados = lavar ? Math.max(0, Math.ceil((dias - diasRopa) / ROPA.cicloLavado)) : 0;

      const remeras = Math.max(c.remerasMin, Math.ceil(diasRopa * c.remerasF * factor));
      const pantalones = Math.max(c.pantMin, Math.ceil(diasRopa * c.pantF * factor));
      const abrigos = c.abrigos;
      const interior = Math.min(Math.max(diasRopa, 5), 10);
      const medias = Math.min(Math.max(Math.ceil(diasRopa * 0.7), 3), 8);

      return {
        dias: dias,
        diasRopa: diasRopa,
        lavados: lavados,
        remeras: remeras,
        pantalones: pantalones,
        interior: interior,
        medias: medias,
        abrigos: abrigos,
      };
    }

    function r1(n) {
      return Math.round(n * 10) / 10;
    }

    H.onCompute(function (v, kase) {
      const modo = (MATH[kase && kase.id] || MATH.armado).modo;

      /* ---------------- Mochila de trekking --------------------------- */
      if (modo === 'mochila') {
        const peso = Math.max(1, Number(v.pesoCorporal) || 0);
        const d = TREKD[v.duracionTrek] || TREKD.semana;
        const aj = TREKN[v.nivelTrek] !== undefined ? TREKN[v.nivelTrek] : 0;

        const pctIdeal = Math.max(8, d.pctIdeal + aj);
        const pctMax = Math.max(10, d.pctMax + aj);
        const pesoIdeal = r1((peso * pctIdeal) / 100);
        const pesoMax = r1((peso * pctMax) / 100);
        const pctLiviana = Math.max(6, pctIdeal - 4);
        const zonaLiviana = r1((peso * pctLiviana) / 100);
        const techo = r1(pesoMax * 1.4);

        return {
          total: pesoIdeal.toLocaleString('es-AR', { maximumFractionDigits: 1 }) + ' kg',
          sub:
            'Objetivo ' + pesoIdeal + ' kg (' + pctIdeal + ' % de tus ' + peso + ' kg) · no pases de ' + pesoMax +
            ' kg (' + pctMax + ' %) · mochila cargada completa, con agua y comida',
          rows: [
            { k: 'Tu peso corporal', v: peso, format: 'unit', unit: 'kg', decimals: 1 },
            { k: 'Porcentaje ideal para esta salida', ref: 'duración + nivel', v: pctIdeal, format: 'unit', unit: '%' },
            { k: 'Peso ideal de la mochila cargada', v: pesoIdeal, format: 'unit', unit: 'kg', decimals: 1, extra: true },
            { k: 'Porcentaje máximo', v: pctMax, format: 'unit', unit: '%' },
            { k: 'Peso máximo recomendado', v: pesoMax, format: 'unit', unit: 'kg', decimals: 1, extra: true },
            { k: 'Techo de la zona liviana', v: zonaLiviana, format: 'unit', unit: 'kg', decimals: 1 },
          ],
          format: 'unit',
          unit: 'kg',
          decimals: 1,
          chart: [
            { label: 'Liviana', value: zonaLiviana, tone: 'good', from: 0, to: zonaLiviana },
            { label: 'Óptima', value: r1(pesoMax - zonaLiviana), tone: 'main', from: zonaLiviana, to: pesoMax },
            { label: 'Sobrecarga', value: r1(techo - pesoMax), tone: 'bad', from: pesoMax, to: techo },
          ],
          position: Math.min(100, Math.max(0, (pesoIdeal / techo) * 100)),
          positionLabel: 'Ideal ' + pesoIdeal + ' kg — máximo ' + pesoMax + ' kg',
        };
      }

      const res = allowance(v);
      const a = res.a;
      const perm = totalPermitido(a);
      const tarifa = EXC[v.aerolinea] || EXC['aerolineas-argentinas'];

      /* ---------------- Franquicia incluida ---------------------------- */
      if (modo === 'franquicia') {
        const maleta = Math.max(0, Number(v.pesoMaleta) || 0);
        const rows = [];

        rows.push({
          k: 'Artículo personal · ' + a.personalDim,
          ref: a.personalKg == null ? 'sin peso declarado' : 'bajo el asiento',
          v: perm.personal,
          format: 'unit',
          unit: 'kg',
          decimals: 1,
        });
        rows.push({
          k:
            a.manoKg == null
              ? 'Equipaje de mano — NO incluido, se paga aparte'
              : a.manoKg === 0
              ? 'Equipaje de mano · ' + a.manoDim + ' (sin tope de peso)'
              : 'Equipaje de mano · ' + a.manoDim,
          v: perm.mano,
          format: 'unit',
          unit: 'kg',
          decimals: 1,
        });
        rows.push({
          k:
            a.despachadoPiezas === 0
              ? 'Equipaje despachado — NO incluido en esta tarifa'
              : a.despachadoPiezas + (a.despachadoPiezas === 1 ? ' pieza despachada de ' : ' piezas despachadas de ') + a.despachadoKg + ' kg',
          ref: a.despachadoPiezas === 0 ? 'se paga aparte' : 'hasta 158 cm lineales',
          v: perm.desp,
          format: 'unit',
          unit: 'kg',
          decimals: 1,
        });
        rows.push({ k: 'Total que podés subir sin pagar extra', v: perm.total, format: 'unit', unit: 'kg', decimals: 1, extra: true });
        rows.push({ k: 'Tope físico por bulto despachado', ref: 'límite de rampa', v: a.topePiezaKg, format: 'unit', unit: 'kg' });
        if (maleta > 0) {
          rows.push({ k: 'Peso de tu valija despachada', v: maleta, format: 'unit', unit: 'kg', decimals: 1 });
        }

        const techo = Math.max(perm.total + 10, maleta + 5, a.topePiezaKg + 5);
        const solamentePersonal = a.manoKg == null && a.despachadoPiezas === 0;

        return {
          total: perm.total.toLocaleString('es-AR', { maximumFractionDigits: 1 }) + ' kg',
          sub:
            res.air.label + ' · ' + (v.cabina === 'basica' ? 'económica básica' : v.cabina === 'estandar' ? 'económica estándar' : v.cabina === 'premium' ? 'Premium Economy' : 'Business') +
            ' · ' + (res.ruta === 'cabotaje' ? 'cabotaje' : res.ruta === 'regional' ? 'regional' : 'internacional') +
            (solamentePersonal ? ' · esta tarifa sólo incluye el artículo personal' : a.despachadoPiezas === 0 ? ' · sin bodega incluida' : ' · con bodega incluida'),
          rows: rows,
          format: 'unit',
          unit: 'kg',
          decimals: 1,
          chart: [
            { label: 'Artículo personal', value: perm.personal, tone: 'good', from: 0, to: perm.personal },
            { label: 'Equipaje de mano', value: perm.mano, tone: 'main', from: perm.personal, to: perm.personal + perm.mano },
            { label: 'Despachado incluido', value: perm.desp, tone: 'prop', from: perm.personal + perm.mano, to: perm.total },
            { label: 'Fuera de franquicia', value: r1(techo - perm.total), tone: 'bad', from: perm.total, to: techo },
          ],
          position: Math.min(100, Math.max(0, ((maleta > 0 ? maleta : perm.total) / techo) * 100)),
          positionLabel:
            maleta > 0
              ? 'Tu valija pesa ' + maleta + ' kg contra ' + perm.total + ' kg permitidos en total'
              : 'Podés subir ' + perm.total + ' kg en total sin pagar extra',
        };
      }

      /* ---------------- Sobrepeso y cargo ------------------------------ */
      if (modo === 'sobrepeso') {
        const maleta = Math.max(0, Number(v.pesoMaleta) || 0);
        const rutaKey = res.ruta;
        const porKg = tarifa.porKg[rutaKey];
        const piezaBase = tarifa.piezaMostrador[rutaKey];
        const factor = MOMENTO[v.momento] !== undefined ? MOMENTO[v.momento] : 1;
        const momentoTxt = v.momento === 'mostrador' ? 'en el mostrador' : v.momento === 'previo' ? 'online después del pasaje' : 'online con el pasaje';

        const franquicia = a.despachadoPiezas > 0 ? a.despachadoKg : 0;
        const rechazado = maleta > MAXKG;
        const rows = [
          { k: 'Peso de tu valija', v: maleta, format: 'unit', unit: 'kg', decimals: 1 },
          {
            k: franquicia > 0 ? 'Franquicia incluida por pieza' : 'Franquicia incluida — esta tarifa no trae bodega',
            ref: res.air.label,
            v: franquicia,
            format: 'unit',
            unit: 'kg',
            decimals: 1,
          },
        ];

        let cargo = 0;
        let exceso = 0;
        let titulo;
        let tone;

        if (rechazado) {
          titulo = 'Bulto rechazado: pasa los ' + MAXKG + ' kg';
          tone = 'bad';
          rows.push({ k: 'Kilos por encima del tope de rampa', v: r1(maleta - MAXKG), format: 'unit', unit: 'kg', decimals: 1, extra: true });
          rows.push({ k: 'No hay cargo posible: hay que sacar peso', v: 0, format: 'unit', unit: 'USD' });
        } else if (franquicia === 0) {
          cargo = Math.round(piezaBase * factor);
          titulo = 'Pieza despachada agregada';
          tone = 'warn';
          rows.push({ k: 'Cargo base por agregar una pieza', ref: tarifa.propio ? 'tarifa de la aerolínea' : 'estimado de servicio completo', v: piezaBase, format: 'unit', unit: 'USD' });
          rows.push({ k: 'Recargo por comprarlo ' + momentoTxt, ref: '×' + factor, v: Math.round(piezaBase * factor - piezaBase), format: 'unit', unit: 'USD' });
          rows.push({ k: 'Total estimado a pagar', v: cargo, format: 'unit', unit: 'USD', extra: true });
        } else {
          exceso = r1(Math.max(0, maleta - franquicia));
          if (exceso > 0) {
            cargo = Math.round(exceso * porKg * factor);
            titulo = exceso + ' kg de exceso';
            tone = 'warn';
            rows.push({ k: 'Kilos de exceso', v: exceso, format: 'unit', unit: 'kg', decimals: 1, extra: true });
            rows.push({ k: 'Tarifa por kilo', ref: tarifa.propio ? 'tarifa de la aerolínea' : 'estimado de servicio completo', v: porKg, format: 'unit', unit: 'USD' });
            rows.push({ k: 'Recargo por pagarlo ' + momentoTxt, ref: '×' + factor, v: Math.round(exceso * porKg * factor - exceso * porKg), format: 'unit', unit: 'USD' });
            rows.push({ k: 'Cargo estimado por sobrepeso', v: cargo, format: 'unit', unit: 'USD', extra: true });
            rows.push({ k: 'Comparación: agregar una pieza entera', ref: 'suele convenir', v: Math.round(piezaBase * factor), format: 'unit', unit: 'USD' });
          } else {
            titulo = 'Sin cargo por sobrepeso';
            tone = 'good';
            rows.push({ k: 'Margen que te queda', v: r1(franquicia - maleta), format: 'unit', unit: 'kg', decimals: 1, extra: true });
            rows.push({ k: 'Cargo estimado', v: 0, format: 'unit', unit: 'USD', extra: true });
          }
        }

        const techo = Math.max(MAXKG + 6, maleta + 3);
        const zonaOk = franquicia > 0 ? franquicia : 0;

        return {
          total: rechazado ? 'No se acepta' : 'USD ' + cargo.toLocaleString('es-AR'),
          sub:
            res.air.label + ' · ' + (res.ruta === 'cabotaje' ? 'cabotaje' : res.ruta === 'regional' ? 'regional' : 'internacional') +
            ' · valija de ' + maleta + ' kg contra ' + (franquicia > 0 ? franquicia + ' kg de franquicia' : 'ninguna franquicia incluida') +
            ' · pagado ' + momentoTxt,
          rows: rows,
          format: 'unit',
          unit: 'USD',
          chart: [
            { label: 'Sin cargo', value: zonaOk, tone: 'good', from: 0, to: zonaOk },
            { label: 'Con cargo por kilo', value: r1(MAXKG - zonaOk), tone: 'warn', from: zonaOk, to: MAXKG },
            { label: 'No se acepta', value: r1(techo - MAXKG), tone: 'bad', from: MAXKG, to: techo },
          ],
          position: Math.min(100, Math.max(0, (maleta / techo) * 100)),
          positionLabel: 'Valija de ' + maleta + ' kg — ' + titulo,
        };
      }

      /* ---------------- Armado de valija ------------------------------- */
      const p = armarRopa(v);
      const pesoRopa =
        p.remeras * PESO.remera +
        p.pantalones * PESO.pantalon +
        p.interior * PESO.interior +
        p.medias * PESO.medias +
        p.abrigos * PESO.abrigo;
      const pesoTotal = r1(pesoRopa + PESO.valijaVacia + PESO.neceser + PESO.calzadoExtra);
      const prendas = p.remeras + p.pantalones + p.interior + p.medias + p.abrigos;

      const franquicia = a.despachadoPiezas > 0 ? a.despachadoKg : perm.total;
      const margen = r1(franquicia - pesoTotal);
      const techo = Math.max(franquicia + 8, pesoTotal + 4);

      const rows = [
        { k: 'Remeras o camisetas', ref: 'clima ' + (v.clima || 'templado'), v: p.remeras, format: 'plain' },
        { k: 'Pantalones o shorts', v: p.pantalones, format: 'plain' },
        { k: 'Mudas de ropa interior', v: p.interior, format: 'plain' },
        { k: 'Pares de medias', v: p.medias, format: 'plain' },
        { k: 'Abrigos o buzos', v: p.abrigos, format: 'plain' },
        { k: 'Total de prendas', ref: p.diasRopa + ' días de ropa' + (p.lavados > 0 ? ' · ' + p.lavados + ' lavado(s)' : ''), v: prendas, format: 'plain', extra: true },
        { k: 'Peso estimado de la ropa', v: r1(pesoRopa), format: 'unit', unit: 'kg', decimals: 1 },
        { k: 'Valija vacía + neceser + calzado extra', ref: 'promedios', v: r1(PESO.valijaVacia + PESO.neceser + PESO.calzadoExtra), format: 'unit', unit: 'kg', decimals: 1 },
        { k: 'Peso estimado de la valija cerrada', v: pesoTotal, format: 'unit', unit: 'kg', decimals: 1, extra: true },
        { k: 'Franquicia de tu tarifa', ref: res.air.label, v: franquicia, format: 'unit', unit: 'kg', decimals: 1 },
        { k: margen >= 0 ? 'Margen que te sobra' : 'Kilos que te pasás', v: Math.abs(margen), format: 'unit', unit: 'kg', decimals: 1, extra: true },
      ];

      return {
        total: pesoTotal.toLocaleString('es-AR', { maximumFractionDigits: 1 }) + ' kg',
        sub:
          prendas + ' prendas para ' + p.dias + ' día(s)' +
          (p.lavados > 0 ? ' lavando ' + p.lavados + ' vez/veces' : v.lavar === 'no' ? ' sin lavar' : '') +
          ' · ' + pesoTotal + ' kg estimados contra ' + franquicia + ' kg de franquicia' +
          (margen >= 0 ? ' · te sobran ' + margen + ' kg' : ' · te pasás ' + Math.abs(margen) + ' kg'),
        rows: rows,
        format: 'unit',
        unit: 'kg',
        decimals: 1,
        chart: [
          { label: 'Dentro de la franquicia', value: franquicia, tone: 'good', from: 0, to: franquicia },
          { label: 'Fuera de la franquicia', value: r1(techo - franquicia), tone: 'bad', from: franquicia, to: techo },
        ],
        position: Math.min(100, Math.max(0, (pesoTotal / techo) * 100)),
        positionLabel: 'Valija estimada en ' + pesoTotal + ' kg — franquicia de ' + franquicia + ' kg',
      };
    });
  })();
</script>
