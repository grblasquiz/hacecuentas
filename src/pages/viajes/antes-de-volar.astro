---
/**
 * Hub de decisión — "Ya tengo el pasaje: qué me falta antes de volar".
 * Reemplaza 7 URLs de calculadora suelta (ver hub.replaces).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, REGIONES, ESCALA, JETLAG, FRANQUICIA } from '../../lib/hubs/antes-de-volar';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ REGIONES, ESCALA, JETLAG, FRANQUICIA }}>
  (function () {
    const H = window.HC_HUB;
    const usd = (n) => 'USD ' + Math.round(n).toLocaleString('es-AR');

    function escalar(tabla, max, dias) {
      for (const t of tabla) if (dias <= t.hasta) return t.factor;
      return max;
    }
    function factorUso(gb) {
      for (const u of ESCALA.uso) if (gb > u.mayorA) return u.factor;
      return ESCALA.usoBase;
    }

    /** Días de adaptación al jet lag, con el ajuste por edad del original. */
    function jetlagDias(zonas, direccion, edad) {
      let dias = zonas * (direccion === 'este' ? JETLAG.este : JETLAG.oeste);
      if (edad > JETLAG.ajusteEdadDesde) dias *= 1 + (edad - JETLAG.ajusteEdadDesde) * JETLAG.ajusteEdadPorAnio;
      return Math.round(dias * 10) / 10;
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'jetlag';

      // ── Jet lag ───────────────────────────────────────────────────────────
      if (id === 'jetlag') {
        const zonas = Math.abs(Math.round(Number(v.zonas) || 0));
        const dir = String(v.direccion || 'este');
        const edad = Math.max(1, Number(v.edad) || 35);
        const dias = jetlagDias(zonas, dir, edad);
        const severidad = zonas < 3 ? 'mínimo' : zonas < 6 ? 'moderado' : zonas < 9 ? 'intenso' : 'máximo';

        return {
          total: String(dias).replace('.', ',') + (dias === 1 ? ' día' : ' días'),
          sub:
            zonas + (zonas === 1 ? ' zona horaria' : ' zonas horarias') + ' hacia el ' + dir +
            ' · jet lag ' + severidad + ' · ' +
            (dir === 'este'
              ? 'al este el reloj interno adelanta ~1 h por día: es la dirección difícil'
              : 'al oeste el reloj retrasa ~1,5 h por día: se lleva mejor') +
            (edad > JETLAG.ajusteEdadDesde ? ' · ajustado por tus ' + edad + ' años' : ''),
          rows: [
            { k: 'Zonas horarias cruzadas', ref: 'Tu dato', v: zonas, format: 'plain' },
            { k: 'Factor por dirección (' + dir + ')', ref: dir === 'este' ? '1 día por zona' : '2/3 de día por zona', v: dir === 'este' ? JETLAG.este : JETLAG.oeste, format: 'plain', decimals: 2 },
            { k: 'Días de adaptación al este', ref: 'CDC Yellow Book', v: jetlagDias(zonas, 'este', edad), format: 'unit', unit: 'días', decimals: 1 },
            { k: 'Días de adaptación al oeste', ref: 'CDC Yellow Book', v: jetlagDias(zonas, 'oeste', edad), format: 'unit', unit: 'días', decimals: 1 },
            { k: 'Tu estimación', ref: 'Zonas × factor × edad', v: dias, format: 'unit', unit: 'días', decimals: 1, extra: true },
          ],
          format: 'unit',
          unit: 'días',
          decimals: 1,
          chart: [
            { label: 'Volando al este', value: jetlagDias(zonas, 'este', edad), tone: dir === 'este' ? 'main' : 'prop' },
            { label: 'Volando al oeste', value: jetlagDias(zonas, 'oeste', edad), tone: dir === 'oeste' ? 'main' : 'prop' },
          ],
        };
      }

      // ── Datos móviles: roaming vs eSIM vs chip local ──────────────────────
      if (id === 'datos') {
        const dias = Math.max(1, Math.round(Number(v.dias) || 15));
        const destino = String(v.destino || 'europa');
        const gb = Math.max(0.1, Number(v.gbDia) || 1);
        const r = REGIONES[destino] || REGIONES.europa;

        const roaming = Math.round(dias * r.roamingDia);
        const esim = Math.round(r.esim15d * escalar(ESCALA.esim, ESCALA.esimMax, dias) * factorUso(gb));
        const chip = Math.round(r.chipLocal * escalar(ESCALA.chip, ESCALA.chipMax, dias));
        const barato = Math.min(roaming, esim, chip);
        const ganador = barato === chip ? 'el chip local' : barato === esim ? 'la eSIM internacional' : 'el roaming';
        const ahorro = roaming - Math.min(esim, chip);

        return {
          total: usd(barato),
          sub:
            dias + ' días en ' + r.nombre + ' con ' + String(gb).replace('.', ',') + ' GB por día · lo más barato es ' +
            ganador + (barato === roaming
              ? ': el viaje es tan corto que no compensa comprar nada'
              : ' · te ahorrás ' + usd(ahorro) + ' contra el roaming (' + (roaming > 0 ? Math.round((ahorro / roaming) * 100) : 0) + '%)'),
          rows: [
            { k: 'Roaming de tu operador', ref: usd(r.roamingDia) + ' por día × ' + dias, v: roaming, format: 'unit', unit: 'USD' },
            { k: 'eSIM internacional', ref: 'Base ' + usd(r.esim15d) + ' escalada por días y consumo', v: esim, format: 'unit', unit: 'USD' },
            { k: 'Chip local comprado al llegar', ref: 'Base ' + usd(r.chipLocal) + ' escalada por días', v: chip, format: 'unit', unit: 'USD' },
            { k: 'Opción más barata', ref: ganador, v: barato, format: 'unit', unit: 'USD', extra: true },
            { k: 'Ahorro contra el roaming', ref: 'Roaming − mejor alternativa', v: Math.max(0, ahorro), format: 'unit', unit: 'USD' },
          ],
          format: 'unit',
          unit: 'USD',
          chart: [
            { label: 'Roaming', value: roaming, tone: barato === roaming ? 'main' : 'prop' },
            { label: 'eSIM', value: esim, tone: barato === esim ? 'main' : 'prop' },
            { label: 'Chip local', value: chip, tone: barato === chip ? 'main' : 'prop' },
          ],
        };
      }

      // ── Franquicia de Aduana ──────────────────────────────────────────────
      if (id === 'aduana') {
        const esAerea = String(v.via || 'aerea') === 'aerea';
        const adultos = Math.min(20, Math.max(1, Math.round(Number(v.adultos) || 1)));
        const menores = Math.min(20, Math.max(0, Math.round(Number(v.menores16) || 0)));
        const compras = Math.max(0, Number(v.valorCompras) || 0);
        const freeShop = esAerea ? Math.max(0, Number(v.compraFreeShop) || 0) : 0;
        const tc = Math.max(1, Number(v.cotizacionDolar) || 1500);

        const base = esAerea ? FRANQUICIA.aereaMaritimaUSD : FRANQUICIA.terrestreFluvialUSD;
        const franqEquipaje = adultos * base + menores * base * FRANQUICIA.menores16Factor;
        const franqFreeShop = esAerea
          ? adultos * FRANQUICIA.freeShopLlegadaUSD + menores * FRANQUICIA.freeShopLlegadaUSD * FRANQUICIA.menores16Factor
          : 0;

        const excEquipaje = Math.max(0, compras - franqEquipaje);
        const excFreeShop = Math.max(0, freeShop - franqFreeShop);
        const excedente = excEquipaje + excFreeShop;
        const impuesto = excedente * FRANQUICIA.alicuotaExcedente;

        return {
          total: impuesto > 0 ? usd(impuesto) : 'No pagás nada',
          sub:
            'Vía ' + (esAerea ? 'aérea o marítima' : 'terrestre o fluvial') + ' · franquicia del grupo ' +
            usd(franqEquipaje) + (esAerea ? ' más ' + usd(franqFreeShop) + ' de free shop de llegada' : '') + ' · ' +
            (impuesto > 0
              ? 'excedente de ' + usd(excedente) + ' al 50% · ' + H.ars(impuesto * tc)
              : 'te quedan ' + usd(Math.max(0, franqEquipaje - compras)) + ' de margen'),
          rows: [
            { k: 'Franquicia por persona', ref: esAerea ? 'Aérea o marítima' : 'Terrestre o fluvial', v: base, format: 'unit', unit: 'USD' },
            { k: 'Franquicia del grupo', ref: adultos + ' mayores + ' + menores + ' menores al 50%', v: franqEquipaje, format: 'unit', unit: 'USD' },
            { k: 'Franquicia del free shop de llegada', ref: esAerea ? 'Adicional' : 'No aplica', v: franqFreeShop, format: 'unit', unit: 'USD' },
            { k: 'Valor de lo que traés', ref: 'Tu dato', v: compras + freeShop, format: 'unit', unit: 'USD' },
            { k: 'Excedente gravado', ref: 'Sobre la franquicia', v: excedente, format: 'unit', unit: 'USD' },
            { k: 'Impuesto a pagar', ref: '50% del excedente', v: impuesto, format: 'unit', unit: 'USD', extra: true },
            { k: 'Impuesto en pesos', ref: 'Al dólar que cargaste', v: impuesto * tc },
          ],
          format: 'unit',
          unit: 'USD',
          chart: [
            { label: 'Franquicia disponible', value: Math.round(franqEquipaje + franqFreeShop), tone: 'main' },
            { label: 'Lo que traés', value: Math.round(compras + freeShop), tone: excedente > 0 ? 'bad' : 'prop' },
            { label: 'Impuesto', value: Math.round(impuesto), tone: 'exit' },
          ],
        };
      }

      // ── Impuestos del pasaje ──────────────────────────────────────────────
      const pasaje = Math.max(0, Number(v.pasajeUsd) || 0);
      const pct = Math.max(0, Number(v.percepcion));
      const percepcionPct = isNaN(pct) ? 30 : pct;
      const percepcion = (pasaje * percepcionPct) / 100;
      const final = pasaje + percepcion;

      return {
        total: usd(final),
        sub:
          'Pasaje de ' + usd(pasaje) + ' más ' + percepcionPct + '% de percepción (' + usd(percepcion) +
          ') · el impuesto PAÍS está derogado desde fines de 2024 · la percepción se computa a cuenta y se puede recuperar',
        rows: [
          { k: 'Tarifa del pasaje', ref: 'Tu dato', v: pasaje, format: 'unit', unit: 'USD' },
          { k: 'Impuesto PAÍS', ref: 'Derogado en diciembre de 2024', v: 0, format: 'unit', unit: 'USD' },
          { k: 'Percepción a cuenta (' + percepcionPct + '%)', ref: 'Ganancias y Bienes Personales', v: percepcion, format: 'unit', unit: 'USD' },
          { k: 'Costo final del pasaje', ref: 'Tarifa + recargos', v: final, format: 'unit', unit: 'USD', extra: true },
          { k: 'Recuperable en la declaración jurada', ref: 'Toda la percepción', v: percepcion, format: 'unit', unit: 'USD' },
        ],
        format: 'unit',
        unit: 'USD',
        chart: [
          { label: 'Tarifa del pasaje', value: Math.round(pasaje), tone: 'main' },
          { label: 'Percepción', value: Math.round(percepcion), tone: 'exit' },
        ],
      };
    });
  })();
</script>
