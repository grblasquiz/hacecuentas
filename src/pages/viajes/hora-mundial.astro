---
/**
 * Hub de decisión — "¿Qué hora es allá?"
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/husos.ts) y su compute().
 * Todo el chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 *
 * NO hay tabla de offsets: cada ciudad viaja con su zona IANA y todo el cálculo
 * lo hace Intl.DateTimeFormat en el cliente. Así el horario de verano sale bien
 * solo y el resultado no caduca cuando un país cambia sus reglas.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HoraMundialExperience from '../../components/generated/HoraMundialExperience.astro';
import { hub, CIUDADES } from '../../lib/hubs/husos';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const LABELS: Record<string, string> = Object.fromEntries(CIUDADES.map((c) => [c.tz, c.label]));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <HoraMundialExperience data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ LABELS }}>
  (function () {
    const H = window.HC_HUB;

    const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
    const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

    /** Componentes de fecha/hora de un instante en una zona IANA. */
    function partsIn(tz, date) {
      const dtf = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        hour12: false,
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', second: '2-digit',
      });
      const p = {};
      dtf.formatToParts(date).forEach((x) => { if (x.type !== 'literal') p[x.type] = x.value; });
      return {
        y: +p.year, mo: +p.month, d: +p.day,
        h: +p.hour % 24, mi: +p.minute, s: +p.second,
      };
    }

    /** Desfasaje de la zona contra UTC, en minutos, para ese instante. */
    function offsetMin(tz, date) {
      const p = partsIn(tz, date);
      const asUTC = Date.UTC(p.y, p.mo - 1, p.d, p.h, p.mi, p.s);
      // date.getTime() lleva milisegundos y `asUTC` no: se descartan antes de restar.
      const instante = date.getTime() - date.getMilliseconds();
      return Math.round((asUTC - instante) / 60000);
    }

    /**
     * Cuánto adelanta el reloj el horario de verano en esta zona, ahora.
     * El offset estándar es el MENOR entre enero y julio: así funciona en los
     * dos hemisferios sin tener que saber cuál es cuál.
     */
    function dstShiftHours(tz, date) {
      const y = date.getUTCFullYear();
      const ene = offsetMin(tz, new Date(Date.UTC(y, 0, 15, 12)));
      const jul = offsetMin(tz, new Date(Date.UTC(y, 6, 15, 12)));
      const estandar = Math.min(ene, jul);
      return (offsetMin(tz, date) - estandar) / 60;
    }

    function offLabel(min) {
      const sign = min < 0 ? '−' : '+';
      const a = Math.abs(min);
      const h = Math.floor(a / 60), m = a % 60;
      return 'UTC' + sign + h + (m ? ':' + String(m).padStart(2, '0') : '');
    }

    const hhmm = (h, m) => String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');

    H.onCompute(function (v) {
      const origen = v.origen || 'America/Argentina/Buenos_Aires';
      const destino = v.destino || 'Europe/Madrid';
      const labOrigen = LABELS[origen] || origen;
      const labDestino = LABELS[destino] || destino;

      const ahora = new Date();
      const pOri = partsIn(origen, ahora);
      const pDes = partsIn(destino, ahora);

      const offOri = offsetMin(origen, ahora);
      const offDes = offsetMin(destino, ahora);
      const difMin = offDes - offOri;
      const difH = difMin / 60;

      const dstDes = dstShiftHours(destino, ahora);
      const dstOri = dstShiftHours(origen, ahora);

      // Día de la semana en el destino, sin depender del locale del navegador.
      const diaDes = new Date(Date.UTC(pDes.y, pDes.mo - 1, pDes.d)).getUTCDay();
      const fechaDes = DIAS[diaDes] + ' ' + pDes.d + ' de ' + MESES[pDes.mo - 1];

      // --- Vuelo: salida en hora local del origen + duración = llegada local del destino.
      const dur = Math.max(0, v.duracion || 0);
      const raw = String(v.horaSalida || '').trim();
      const m = raw.match(/^(\d{1,2})[:.hH]?(\d{2})?$/);
      const salH = m ? Math.min(23, +m[1]) : 0;
      const salM = m && m[2] ? Math.min(59, +m[2]) : 0;
      const horaSalidaOk = !!m;

      // El instante de salida se arma con la fecha de HOY en el origen y su offset
      // vigente; la llegada se vuelve a formatear en la zona del destino, así que
      // si el vuelo cruza un cambio de hora, el resultado ya lo contempla.
      const salidaUTC = Date.UTC(pOri.y, pOri.mo - 1, pOri.d, salH, salM) - offOri * 60000;
      const llegada = new Date(salidaUTC + dur * 3600000);
      const pLle = partsIn(destino, llegada);
      const dLle = Date.UTC(pLle.y, pLle.mo - 1, pLle.d);
      const dSal = Date.UTC(pOri.y, pOri.mo - 1, pOri.d);
      const saltoDias = Math.round((dLle - dSal) / 86400000);
      const diaTxt =
        saltoDias === 0 ? 'del mismo día'
        : saltoDias === 1 ? 'del día siguiente'
        : saltoDias === -1 ? 'del día anterior'
        : 'con ' + Math.abs(saltoDias) + ' días de ' + (saltoDias > 0 ? 'diferencia hacia adelante' : 'diferencia hacia atrás');
      const diaLleSem = new Date(dLle).getUTCDay();

      const fmt = (n, d) => n.toLocaleString('es-AR', { maximumFractionDigits: d == null ? 1 : d });
      const absDif = Math.abs(difH);
      const difTxt =
        difH === 0 ? 'misma hora que ' + labOrigen
        : fmt(absDif) + (absDif === 1 ? ' hora ' : ' horas ') + (difH > 0 ? 'adelante de ' : 'atrás de ') + labOrigen;

      const rows = [
        {
          k: 'Diferencia horaria',
          ref: labDestino + ' está ' + difTxt,
          v: difH,
          format: 'unit',
          unit: absDif === 1 ? 'hora' : 'horas',
          decimals: absDif % 1 === 0 ? 0 : 1,
          extra: true,
        },
        {
          k: 'Ahora en ' + labOrigen + ': ' + hhmm(pOri.h, pOri.mi),
          ref: offLabel(offOri) + (dstOri > 0 ? ' · con horario de verano' : ' · horario estándar'),
          v: offOri / 60,
          format: 'unit',
          unit: 'h contra UTC',
          decimals: offOri % 60 === 0 ? 0 : 1,
        },
        {
          k: 'Ahora en ' + labDestino + ': ' + hhmm(pDes.h, pDes.mi),
          ref: offLabel(offDes) + ' · ' + fechaDes,
          v: offDes / 60,
          format: 'unit',
          unit: 'h contra UTC',
          decimals: offDes % 60 === 0 ? 0 : 1,
          extra: true,
        },
        {
          k: dstDes > 0
            ? 'En ' + labDestino + ' rige ahora el horario de verano'
            : 'En ' + labDestino + ' rige ahora el horario estándar',
          ref: dstDes > 0
            ? 'adelantaron el reloj; lo resuelve la base horaria de tu dispositivo'
            : 'no hay adelanto de reloj vigente en esta fecha',
          v: dstDes,
          format: 'unit',
          unit: 'h de adelanto',
          decimals: dstDes % 1 === 0 ? 0 : 1,
        },
      ];

      if (dur > 0 && horaSalidaOk) {
        rows.push({
          k: 'Salís ' + hhmm(salH, salM) + ' de ' + labOrigen,
          ref: 'hora local del aeropuerto de salida',
          v: dur,
          format: 'unit',
          unit: dur === 1 ? 'hora de vuelo' : 'horas de vuelo',
          decimals: dur % 1 === 0 ? 0 : 2,
        });
        rows.push({
          k: 'Llegás ' + hhmm(pLle.h, pLle.mi) + ' de ' + labDestino + ' (' + DIAS[diaLleSem] + ', ' + diaTxt + ')',
          ref: 'la hora del pasaje ya viene en hora local: no le restes la diferencia',
          v: saltoDias,
          format: 'unit',
          unit: saltoDias === 1 || saltoDias === -1 ? 'día de cambio de fecha' : 'días de cambio de fecha',
          decimals: 0,
          extra: true,
        });
        rows.push({
          k: 'Días de adaptación estimados',
          ref: 'referencia habitual: cerca de una hora de ajuste por día' + (difH > 0 ? ', y al este cuesta más' : ''),
          v: absDif,
          format: 'unit',
          unit: absDif === 1 ? 'día' : 'días',
          decimals: 0,
        });
      }

      // Posición: en qué momento del día están allá (0–24 h).
      const minutosDia = pDes.h * 60 + pDes.mi;
      const pos = (minutosDia / 1440) * 100;
      const franja =
        pDes.h < 7 ? 'madrugada'
        : pDes.h < 9 ? 'temprano a la mañana'
        : pDes.h < 18 ? 'horario laboral'
        : pDes.h < 22 ? 'tarde-noche'
        : 'noche cerrada';

      const sub =
        fechaDes + ' en ' + labDestino + ' · ' + difTxt + ' · ' + offLabel(offDes) +
        (dstDes > 0 ? ' (horario de verano vigente)' : '') +
        (dur > 0 && horaSalidaOk
          ? ' · saliendo ' + hhmm(salH, salM) + ' llegás ' + hhmm(pLle.h, pLle.mi) + ' ' + diaTxt
          : '') +
        (!horaSalidaOk ? ' · revisá la hora de salida, va en formato HH:MM' : '');

      return {
        total: hhmm(pDes.h, pDes.mi),
        sub: sub,
        rows: rows,
        format: 'unit',
        unit: 'h',
        decimals: 1,
        position: pos,
        positionLabel: hhmm(pDes.h, pDes.mi) + ' en ' + labDestino + ' — ' + franja,
        chart: [
          { label: 'Madrugada', value: 7, from: 0, to: 7, tone: 'bad' },
          { label: 'Mañana temprano', value: 2, from: 7, to: 9, tone: 'warn' },
          { label: 'Horario laboral', value: 9, from: 9, to: 18, tone: 'good' },
          { label: 'Tarde-noche', value: 4, from: 18, to: 22, tone: 'warn' },
          { label: 'Noche cerrada', value: 2, from: 22, to: 24, tone: 'bad' },
        ],
      };
    });
  })();
</script>
