---
/**
 * Hub de decisión — "¿Necesito visa para este viaje y cuánto sale?".
 * Reemplaza 12 URLs de calculadora suelta (ver hub.replaces).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import VisasTramitesExperience from '../../components/generated/VisasTramitesExperience.astro';
import {
  hub,
  MRV,
  ESPERA_USA,
  VWP,
  ESTA_USD,
  SCHENGEN_SIN_VISA,
  SCHENGEN,
  BRASIL_MERCOSUR,
  BRASIL_EVISA,
  BRASIL_EVISA_USD,
  JAPON_SIN_VISA,
  JAPON,
  CHINA_BASE,
  CHINA_BASE_DEFAULT,
  CHINA_MULTIPLICADOR,
  CHINA_DIAS_HABILES,
  CANADA_ETA,
  CANADA_VISA_NAC,
  CANADA,
  AUSTRALIA,
  PASAPORTE,
  FIEBRE_AMARILLA_DIAS,
} from '../../lib/hubs/visas-y-tramites';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <VisasTramitesExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

