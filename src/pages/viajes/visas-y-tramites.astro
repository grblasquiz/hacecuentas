---
/**
 * Hub de decisión — "¿Necesito visa para este viaje y cuánto sale?".
 * Reemplaza 12 URLs de calculadora suelta (ver hub.replaces).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  MRV,
  ESPERA_USA,
  VWP,
  ESTA_USD,
  SCHENGEN_SIN_VISA,
  SCHENGEN,
  BRASIL_MERCOSUR,
  BRASIL_EVISA,
  BRASIL_EVISA_USD,
  JAPON_SIN_VISA,
  JAPON,
  CHINA_BASE,
  CHINA_BASE_DEFAULT,
  CHINA_MULTIPLICADOR,
  CHINA_DIAS_HABILES,
  CANADA_ETA,
  CANADA_VISA_NAC,
  CANADA,
  AUSTRALIA,
  PASAPORTE,
  FIEBRE_AMARILLA_DIAS,
} from '../../lib/hubs/visas-y-tramites';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    MRV,
    ESPERA_USA,
    VWP,
    ESTA_USD,
    SCHENGEN_SIN_VISA,
    SCHENGEN,
    BRASIL_MERCOSUR,
    BRASIL_EVISA,
    BRASIL_EVISA_USD,
    JAPON_SIN_VISA,
    JAPON,
    CHINA_BASE,
    CHINA_BASE_DEFAULT,
    CHINA_MULTIPLICADOR,
    CHINA_DIAS_HABILES,
    CANADA_ETA,
    CANADA_VISA_NAC,
    CANADA,
    AUSTRALIA,
    PASAPORTE,
    FIEBRE_AMARILLA_DIAS,
  }}
>
  (function () {
    const H = window.HC_HUB;
    const usd = (n) => 'USD ' + Math.round(n).toLocaleString('es-AR');
    const eur = (n) => 'EUR ' + Math.round(n).toLocaleString('es-AR');

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'usa';
      const nac = String(v.nacionalidad || 'argentino');
      const dias = Math.max(1, Math.round(Number(v.diasEstadia) || 15));
      const meses = Math.max(0, Number(v.mesesPasaporte) || 0);
      const pasaporteOk = meses >= 6;

      // ── Estados Unidos: ESTA o visa B1/B2 ─────────────────────────────────
      if (id === 'usa') {
        const tipo = String(v.tipoVisa || 'b1b2');
        const conEsta = VWP.indexOf(nac) >= 0 && tipo === 'b1b2' && dias <= 90;
        const costo = conEsta ? ESTA_USD : MRV[tipo] || MRV.b1b2;
        const semanas = conEsta ? 0 : ESPERA_USA[nac] != null ? ESPERA_USA[nac] : 8;

        return {
          total: usd(costo),
          sub:
            (conEsta
              ? 'Tu nacionalidad está en el Programa de Exención de Visa: viajás con ESTA, online y sin entrevista, vigencia 2 años'
              : 'Visa ' + tipo.toUpperCase() + ' con entrevista consular · espera estimada de turno ' + semanas + ' semanas') +
            ' · pasaporte ' + (pasaporteOk ? 'OK (' + meses + ' meses de vigencia)' : 'INSUFICIENTE: ' + meses + ' meses, el mínimo son 6'),
          rows: [
            { k: conEsta ? 'ESTA online' : 'Tasa MRV de la visa ' + tipo.toUpperCase(), ref: conEsta ? 'CBP' : 'Department of State', v: costo, format: 'unit', unit: 'USD', extra: true },
            { k: 'Espera estimada de turno', ref: 'Consulado', v: semanas, format: 'unit', unit: 'semanas' },
            { k: 'Vigencia mínima exigida al pasaporte', ref: 'Regla práctica', v: 6, format: 'unit', unit: 'meses' },
            { k: 'Vigencia que le queda al tuyo', ref: 'Tu dato', v: meses, format: 'unit', unit: 'meses' },
            { k: 'Alternativa ESTA (si calificás)', ref: 'Vigencia 2 años', v: ESTA_USD, format: 'unit', unit: 'USD' },
            { k: 'Visa B1/B2 si el ESTA no aplica', ref: 'No reembolsable', v: MRV.b1b2, format: 'unit', unit: 'USD' },
          ],
          format: 'unit',
          unit: 'USD',
          chart: [
            { label: 'ESTA', value: ESTA_USD, tone: conEsta ? 'main' : 'prop' },
            { label: 'Visa B1/B2', value: MRV.b1b2, tone: !conEsta && tipo === 'b1b2' ? 'main' : 'prop' },
            { label: 'Visa H1B', value: MRV.h1b, tone: tipo === 'h1b' ? 'main' : 'prop' },
          ],
        };
      }

      // ── Espacio Schengen ──────────────────────────────────────────────────
      if (id === 'schengen') {
        const larga = dias > 90;
        const exento = SCHENGEN_SIN_VISA.indexOf(nac) >= 0;
        const costo = larga ? SCHENGEN.largaEur : exento ? SCHENGEN.etiasEur : SCHENGEN.visaEur;

        return {
          total: eur(costo),
          sub: larga
            ? 'Tus ' + dias + ' días superan el límite de 90 cada 180: necesitás visa nacional de larga duración del país de destino'
            : exento
              ? 'Sin visa por ' + dias + ' días · sólo la autorización ETIAS, online y de aprobación casi inmediata'
              : 'Visa Schengen de turismo por ' + dias + ' días · exige seguro médico por 30.000 euros y extractos bancarios',
          rows: [
            { k: larga ? 'Visa nacional de larga duración' : exento ? 'Autorización ETIAS' : 'Visa Schengen de turismo', ref: 'Tasa', v: costo, format: 'unit', unit: 'EUR', extra: true },
            { k: 'Días de estadía previstos', ref: 'Tu dato', v: dias, format: 'unit', unit: 'días' },
            { k: 'Límite sin visa', ref: 'Ventana móvil de 180 días', v: 90, format: 'unit', unit: 'días' },
            { k: 'Referencia: ETIAS', ref: 'Gratis <18 y >70 años', v: SCHENGEN.etiasEur, format: 'unit', unit: 'EUR' },
            { k: 'Referencia: visa Schengen', ref: 'Nacionalidades no exentas', v: SCHENGEN.visaEur, format: 'unit', unit: 'EUR' },
            { k: 'Referencia: visa nacional larga', ref: 'Más de 90 días', v: SCHENGEN.largaEur, format: 'unit', unit: 'EUR' },
          ],
          format: 'unit',
          unit: 'EUR',
          chart: [
            { label: 'ETIAS', value: SCHENGEN.etiasEur, tone: !larga && exento ? 'main' : 'prop' },
            { label: 'Visa Schengen', value: SCHENGEN.visaEur, tone: !larga && !exento ? 'main' : 'prop' },
            { label: 'Visa larga duración', value: SCHENGEN.largaEur, tone: larga ? 'main' : 'prop' },
          ],
        };
      }

      // ── Brasil ────────────────────────────────────────────────────────────
      if (id === 'brasil') {
        const larga = dias > 90;
        const mercosur = BRASIL_MERCOSUR.indexOf(nac) >= 0;
        const evisa = BRASIL_EVISA.indexOf(nac) >= 0;
        const costo = larga ? 0 : evisa ? BRASIL_EVISA_USD : 0;

        return {
          total: larga ? 'Visa de larga duración' : evisa ? usd(BRASIL_EVISA_USD) : 'Sin visa',
          sub: larga
            ? 'Tus ' + dias + ' días superan los 90 de turismo: hace falta visa de larga duración cualquiera sea tu nacionalidad'
            : mercosur
              ? 'Por el acuerdo Mercosur entrás con el documento nacional de identidad vigente, sin visa ni pasaporte'
              : evisa
                ? 'Tu nacionalidad necesita eVisa desde 2025: se tramita online antes de viajar, no se emite al llegar'
                : 'Turismo de hasta 90 días sin visa, con pasaporte vigente',
          rows: [
            { k: 'Costo del permiso de ingreso', ref: evisa && !larga ? 'eVisa online' : 'Sin tasa', v: costo, format: 'unit', unit: 'USD', extra: true },
            { k: 'Días de estadía previstos', ref: 'Tu dato', v: dias, format: 'unit', unit: 'días' },
            { k: 'Límite de turismo sin visa', ref: 'Normativa migratoria', v: 90, format: 'unit', unit: 'días' },
            { k: 'Referencia: eVisa para EE.UU., Canadá y Australia', ref: 'Vigente desde 2025', v: BRASIL_EVISA_USD, format: 'unit', unit: 'USD' },
          ],
          format: 'unit',
          unit: 'USD',
          chart: [
            { label: 'Mercosur (sin costo)', value: 0, tone: mercosur ? 'main' : 'prop' },
            { label: 'eVisa', value: BRASIL_EVISA_USD, tone: evisa ? 'main' : 'prop' },
          ],
        };
      }

      // ── Japón ─────────────────────────────────────────────────────────────
      if (id === 'japon') {
        const larga = dias > 90;
        const exento = JAPON_SIN_VISA.indexOf(nac) >= 0;
        const costo = larga ? JAPON.largaUsd : exento ? 0 : JAPON.turistaUsd;

        return {
          total: costo === 0 ? 'Sin visa' : usd(costo),
          sub: larga
            ? 'Tus ' + dias + ' días superan el límite turístico de 90: necesitás visa nacional de estadía larga'
            : exento
              ? 'Ingresás sin visa y sin costo por acuerdo bilateral, hasta 90 días · llevá pasaje de vuelta y reserva de alojamiento'
              : 'Visa de turista consular por ' + dias + ' días · pasaporte, formulario, itinerario y prueba de medios económicos',
          rows: [
            { k: larga ? 'Visa de estadía larga' : exento ? 'Ingreso sin visa' : 'Visa de turista', ref: 'Tasa consular', v: costo, format: 'unit', unit: 'USD', extra: true },
            { k: 'Días de estadía previstos', ref: 'Tu dato', v: dias, format: 'unit', unit: 'días' },
            { k: 'Límite turístico sin visa', ref: 'Acuerdo bilateral', v: 90, format: 'unit', unit: 'días' },
            { k: 'Referencia: visa de turista', ref: 'Nacionalidades no exentas', v: JAPON.turistaUsd, format: 'unit', unit: 'USD' },
            { k: 'Referencia: visa de estadía larga', ref: 'Más de 90 días', v: JAPON.largaUsd, format: 'unit', unit: 'USD' },
          ],
          format: 'unit',
          unit: 'USD',
          chart: [
            { label: 'Sin visa', value: 0, tone: !larga && exento ? 'main' : 'prop' },
            { label: 'Visa turista', value: JAPON.turistaUsd, tone: !larga && !exento ? 'main' : 'prop' },
            { label: 'Estadía larga', value: JAPON.largaUsd, tone: larga ? 'main' : 'prop' },
          ],
        };
      }

      // ── China ─────────────────────────────────────────────────────────────
      if (id === 'china') {
        const ent = String(v.entradas || 'una');
        const base = CHINA_BASE[nac] != null ? CHINA_BASE[nac] : CHINA_BASE_DEFAULT;
        const mult = CHINA_MULTIPLICADOR[ent] || 1;
        const costo = Math.round(base * mult);
        const etiqueta = ent === 'multiple' ? 'múltiples entradas' : ent === 'dos' ? 'doble entrada' : 'una sola entrada';

        return {
          total: usd(costo),
          sub:
            'Visa L de turismo con ' + etiqueta + ' · trámite presencial con toma de huellas · ' +
            CHINA_DIAS_HABILES + ' días hábiles de procesamiento más el turno',
          rows: [
            { k: 'Tasa base según nacionalidad', ref: 'Consulado de China', v: base, format: 'unit', unit: 'USD' },
            { k: 'Multiplicador por entradas (' + etiqueta + ')', ref: '×' + String(mult).replace('.', ','), v: mult, format: 'plain', decimals: 1 },
            { k: 'Costo de la visa', ref: 'Base × multiplicador', v: costo, format: 'unit', unit: 'USD', extra: true },
            { k: 'Procesamiento', ref: 'Sin contar el turno', v: CHINA_DIAS_HABILES, format: 'unit', unit: 'días hábiles' },
          ],
          format: 'unit',
          unit: 'USD',
          chart: ['una', 'dos', 'multiple'].map(function (e) {
            return {
              label: e === 'multiple' ? 'Múltiples' : e === 'dos' ? 'Doble' : 'Una entrada',
              value: Math.round(base * CHINA_MULTIPLICADOR[e]),
              tone: e === ent ? 'main' : 'prop',
            };
          }),
        };
      }

      // ── Canadá ────────────────────────────────────────────────────────────
      if (id === 'canada') {
        const medio = String(v.medio || 'avion');
        const conVisaUsa = String(v.tieneVisaUsa || 'no') === 'si';
        if (medio === 'auto') {
          return {
            total: 'Sin ETA',
            sub: 'La ETA sólo se exige para ingresos aéreos · por tierra o mar llevás pasaporte y la visa si tu nacionalidad la requiere',
            rows: [
              { k: 'ETA por frontera terrestre o marítima', ref: 'No aplica', v: 0, format: 'unit', unit: 'USD', extra: true },
              { k: 'Referencia: ETA aérea', ref: 'Ingreso en avión', v: CANADA.etaUsd, format: 'unit', unit: 'USD' },
              { k: 'Referencia: visa de turista', ref: 'Nacionalidades que la requieren', v: CANADA.visaUsd, format: 'unit', unit: 'USD' },
            ],
            format: 'unit',
            unit: 'USD',
            chart: [
              { label: 'Por tierra o mar', value: 0, tone: 'main' },
              { label: 'ETA aérea', value: CANADA.etaUsd, tone: 'prop' },
              { label: 'Visa de turista', value: CANADA.visaUsd, tone: 'prop' },
            ],
          };
        }
        const conEta = CANADA_ETA.indexOf(nac) >= 0 || conVisaUsa;
        const conVisa = !conEta && CANADA_VISA_NAC.indexOf(nac) >= 0;
        const costo = conEta ? CANADA.etaUsd : conVisa ? CANADA.visaUsd : 0;

        return {
          total: costo === 0 ? 'Consultá al consulado' : usd(costo),
          sub: conEta
            ? (conVisaUsa && CANADA_ETA.indexOf(nac) < 0
                ? 'Tu visa válida de Estados Unidos te habilita la ETA online'
                : 'Tu nacionalidad accede a la ETA online') +
              ' · se aprueba en minutos, hasta 72 horas · tramitala sólo en el sitio oficial'
            : conVisa
              ? 'Tu nacionalidad requiere visa de turista canadiense · la espera ronda las 2 a 4 semanas'
              : 'Tu combinación no entra en las reglas estándar: confirmá con el consulado antes de comprar pasajes',
          rows: [
            { k: conEta ? 'ETA online' : conVisa ? 'Visa de turista' : 'A confirmar con el consulado', ref: 'Government of Canada', v: costo, format: 'unit', unit: 'USD', extra: true },
            { k: 'Referencia: ETA', ref: 'Vigencia 5 años', v: CANADA.etaUsd, format: 'unit', unit: 'USD' },
            { k: 'Referencia: visa de turista', ref: 'Espera de 2 a 4 semanas', v: CANADA.visaUsd, format: 'unit', unit: 'USD' },
            { k: 'Ahorro de tener visa de EE.UU. vigente', ref: 'Visa − ETA', v: CANADA.visaUsd - CANADA.etaUsd, format: 'unit', unit: 'USD' },
          ],
          format: 'unit',
          unit: 'USD',
          chart: [
            { label: 'ETA', value: CANADA.etaUsd, tone: conEta ? 'main' : 'prop' },
            { label: 'Visa de turista', value: CANADA.visaUsd, tone: conVisa ? 'main' : 'prop' },
          ],
        };
      }

      // ── Pasaporte ─────────────────────────────────────────────────────────
      if (id === 'pasaporte') {
        const pais = String(v.paisPasaporte || 'argentina');
        const tipo = String(v.tipoTramite || 'normal');
        const p = PASAPORTE[pais] || PASAPORTE.argentina;
        const express = tipo === 'express';
        const sinExpress = express && p.express === 'N/A';
        const costo = sinExpress ? p.normal : express ? p.express : p.normal;
        const tiempo = sinExpress ? p.tNormal : express ? p.tExpress : p.tNormal;

        return {
          total: costo,
          sub:
            (sinExpress
              ? 'En ese país no existe trámite express: sólo el ordinario, que sale ' + p.normal
              : 'Trámite ' + (express ? 'express' : 'ordinario') + ' por ' + costo) +
            ' · entrega en ' + tiempo + ' · ordinario ' + p.normal + ' en ' + p.tNormal +
            ' · express ' + (p.express === 'N/A' ? 'no disponible' : p.express + ' en ' + p.tExpress) +
            ' · documento de identidad, partida, foto biométrica y turno previo',
          rows: [
            { k: 'Vigencia que le queda a tu pasaporte', ref: 'Tu dato', v: meses, format: 'unit', unit: 'meses', extra: true },
            { k: 'Vigencia mínima que piden los destinos', ref: 'Regla práctica', v: 6, format: 'unit', unit: 'meses' },
            { k: 'Margen antes de tener que renovar', ref: 'Vigencia − 6 meses', v: Math.max(0, meses - 6), format: 'unit', unit: 'meses' },
          ],
          format: 'unit',
          unit: 'meses',
          chart: [
            { label: 'Vigencia de tu pasaporte', value: meses, tone: pasaporteOk ? 'main' : 'bad' },
            { label: 'Mínimo exigido', value: 6, tone: 'exit' },
          ],
        };
      }

      // ── Working Holiday Australia ─────────────────────────────────────────
      if (id === 'working-holiday') {
        const total = AUSTRALIA.visa + AUSTRALIA.fondos + AUSTRALIA.pasaje + AUSTRALIA.vivienda;
        return {
          total: 'AUD ' + total.toLocaleString('es-AR'),
          sub:
            'Costo inicial para arrancar la Working Holiday · sumá un colchón de AUD ' +
            AUSTRALIA.colchonMin.toLocaleString('es-AR') + ' a ' + AUSTRALIA.colchonMax.toLocaleString('es-AR') +
            ' por imprevistos hasta el primer sueldo',
          rows: [
            { k: 'Visa Working Holiday', ref: 'Home Affairs', v: AUSTRALIA.visa, format: 'unit', unit: 'AUD' },
            { k: 'Fondos mínimos a acreditar', ref: 'Requisito migratorio', v: AUSTRALIA.fondos, format: 'unit', unit: 'AUD' },
            { k: 'Pasaje de regreso', ref: 'Requisito migratorio', v: AUSTRALIA.pasaje, format: 'unit', unit: 'AUD' },
            { k: 'Vivienda inicial', ref: 'Primeras semanas', v: AUSTRALIA.vivienda, format: 'unit', unit: 'AUD' },
            { k: 'Costo inicial total', ref: 'Suma', v: total, format: 'unit', unit: 'AUD', extra: true },
            { k: 'Colchón recomendado (mínimo)', ref: 'Hasta el primer sueldo', v: AUSTRALIA.colchonMin, format: 'unit', unit: 'AUD' },
          ],
          format: 'unit',
          unit: 'AUD',
          chart: [
            { label: 'Fondos exigidos', value: AUSTRALIA.fondos, tone: 'main' },
            { label: 'Vivienda inicial', value: AUSTRALIA.vivienda, tone: 'prop' },
            { label: 'Pasaje de vuelta', value: AUSTRALIA.pasaje, tone: 'prop' },
            { label: 'Visa', value: AUSTRALIA.visa, tone: 'exit' },
          ],
        };
      }

      // ── Fiebre amarilla ───────────────────────────────────────────────────
      if (id === 'fiebre-amarilla') {
        const margen = Math.max(0, Math.round(Number(v.diasParaViajar) || 0));
        const llega = margen >= FIEBRE_AMARILLA_DIAS;

        return {
          total: margen + (margen === 1 ? ' día de margen' : ' días de margen'),
          sub: llega
            ? 'Llegás con margen: la dosis necesita ' + FIEBRE_AMARILLA_DIAS +
              ' días para dar inmunidad y el certificado queda válido de por vida'
            : 'No alcanza: faltan ' + margen + ' días y la vacuna necesita ' + FIEBRE_AMARILLA_DIAS +
              ' · si el destino la exige, el certificado no va a ser válido al ingresar',
          rows: [
            { k: 'Días que faltan para el viaje', ref: 'Tu dato', v: margen, format: 'unit', unit: 'días', extra: true },
            { k: 'Días que necesita la vacuna', ref: 'Umbral OMS', v: FIEBRE_AMARILLA_DIAS, format: 'unit', unit: 'días' },
            { k: 'Margen sobre el umbral', ref: 'Días − 10', v: margen - FIEBRE_AMARILLA_DIAS, format: 'unit', unit: 'días' },
            { k: 'Dosis necesarias de por vida', ref: 'Criterio OMS 2016', v: 1, format: 'plain' },
          ],
          format: 'unit',
          unit: 'días',
          chart: [
            { label: 'Tu margen', value: margen, tone: llega ? 'main' : 'bad' },
            { label: 'Umbral OMS', value: FIEBRE_AMARILLA_DIAS, tone: 'exit' },
          ],
        };
      }

      // ── Costo total de una visa genérica ──────────────────────────────────
      const tasa = Math.max(0, Number(v.tasaConsular) || 0);
      const centro = Math.max(0, Number(v.cargoCentro) || 0);
      const seguroDia = Math.max(0, Number(v.seguroDia) || 0);
      const extras = Math.max(0, Number(v.extras) || 0);
      const seguro = Math.round(dias * seguroDia);
      const total = Math.round(tasa + centro + seguro + extras);

      const comps = [
        { label: 'Tasa consular', value: Math.round(tasa) },
        { label: 'Centro de visas', value: Math.round(centro) },
        { label: 'Seguro de viaje', value: seguro },
        { label: 'Fotos, copias y courier', value: Math.round(extras) },
      ];
      const mayor = comps.slice().sort((a, b) => b.value - a.value)[0];

      return {
        total: usd(total),
        sub:
          'Para ' + dias + ' días de estadía · el rubro que más pesa es ' + mayor.label.toLowerCase() + ' (' +
          usd(mayor.value) + ') · la tasa consular no se reembolsa si te rechazan',
        rows: comps
          .map(function (c) {
            return { k: c.label, ref: c.label === 'Seguro de viaje' ? dias + ' días × ' + usd(seguroDia) : 'Tu dato', v: c.value, format: 'unit', unit: 'USD' };
          })
          .concat([{ k: 'Costo total del trámite', ref: 'Suma', v: total, format: 'unit', unit: 'USD', extra: true }]),
        format: 'unit',
        unit: 'USD',
        chart: comps
          .filter((c) => c.value > 0)
          .map(function (c) {
            return { label: c.label, value: c.value, tone: c.label === mayor.label ? 'main' : 'prop' };
          }),
      };
    });
  })();
</script>
