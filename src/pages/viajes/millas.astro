---
/**
 * Hub de decisión — "¿Cuántas millas necesito para este destino?" (arquetipo CATÁLOGO).
 * Reemplaza 5 URLs de calculadora suelta (ver hub.replaces).
 *
 * La página sólo aporta los datos (src/lib/hubs/millas.ts) y su compute().
 * El chrome, el CSS y el runtime viven en DecisionHub.astro y no se tocan.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HubSeoAnswer from '../../components/hub/HubSeoAnswer.astro';
import MillasExperience from '../../components/generated/MillasExperience.astro';
import { hub, PROGRAMAS_MAP, DESTINO_LABEL } from '../../lib/hubs/millas';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <aside class="miles-caveat" aria-label="Alcance de las referencias de millas">
    <strong>Primero mirá el precio real de tu programa.</strong>
    Las tablas son referencias orientativas y no definen un origen universal: ingresá las millas que te pide la web para tu ruta, fecha y cabina. La herramienta compara ese valor con el pasaje en efectivo; no garantiza disponibilidad ni precio.
  </aside>
  <MillasExperience data={hub} />
  <HubSeoAnswer data={hub} />
  <Footer />
</Layout>

<script>
  const improveMilesResult = () => {
    const root = document.querySelector('.mockup-millas');
    if (!root) return;
    const route = root.querySelector('#ticket-route');
    if (route) route.textContent = route.textContent?.replace(/^EZE\s*→/, 'TU ORIGEN →') || '';
    const verdict = root.querySelector('#verdict');
    if (verdict) {
      verdict.textContent = verdict.textContent === 'Buen canje'
        ? 'Supera tu referencia'
        : 'Queda bajo tu referencia';
    }
    const result = root.querySelector('.result');
    result?.setAttribute('aria-live', 'polite');
    root.querySelectorAll('.switch').forEach((button) => {
      button.setAttribute('aria-pressed', button.classList.contains('active') ? 'true' : 'false');
    });
  };
  improveMilesResult();
  document.querySelector('.mockup-millas')?.addEventListener('click', () => queueMicrotask(improveMilesResult));
  document.querySelector('.mockup-millas')?.addEventListener('input', () => queueMicrotask(improveMilesResult));
</script>

<style>
  .miles-caveat{max-width:1160px;margin:20px auto 0;padding:14px 18px;border:1px solid #b9d9e9;border-radius:12px;background:#f1f8fc;color:#29475d;line-height:1.55}
  .miles-caveat strong{display:block;color:#143650}
  @media(max-width:800px){.miles-caveat{margin:14px 14px 0}}
</style>
