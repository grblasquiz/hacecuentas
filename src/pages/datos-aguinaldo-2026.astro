---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { aguinaldo } from '../lib/formulas/aguinaldo';
import { BASE_IMPONIBLE_MAXIMA_APORTES } from '../lib/formulas/sueldo-ar';

// Página-dato enlazable: reglas del SAC (aguinaldo) 2026 — fechas legales, fórmula,
// tope de aportes y ejemplos. Los ejemplos se calculan con la MISMA función
// src/lib/formulas/aguinaldo.ts que usa la calculadora → cero divergencia.
// Patrón espejado de /datos-monotributo-2026: tabla server-rendered + schema Dataset +
// CC-BY 4.0 + bloque "Cómo citar".

const ULTIMA_REVISION = '2026-06-10';

const TOPE_SAC = BASE_IMPONIBLE_MAXIMA_APORTES / 2; // base máxima de aportes del SAC (media base)

const fmtARS = (n: number, dec = 0) =>
  '$' + n.toLocaleString('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec });

// Ejemplos semestre completo (6/6 meses) — calculados con la fórmula de la calculadora.
const EJEMPLOS_SUELDOS = [600_000, 1_000_000, 1_500_000, 2_500_000, 4_414_652.38, 6_000_000, 10_000_000];
const ejemplos = EJEMPLOS_SUELDOS.map((s) => {
  const r = aguinaldo({ mejorSueldo: s, mesesTrabajados: 6 });
  return { sueldo: s, bruto: r.aguinaldoBruto, descuentos: r.descuentos, neto: r.aguinaldoNeto };
});

// Ejemplo proporcional: mejor sueldo $1.500.000, de 1 a 6 meses trabajados.
const SUELDO_PROP = 1_500_000;
const proporcional = [1, 2, 3, 4, 5, 6].map((m) => {
  const r = aguinaldo({ mejorSueldo: SUELDO_PROP, mesesTrabajados: m });
  return { meses: m, bruto: r.aguinaldoBruto, neto: r.aguinaldoNeto };
});

const title =
  'Datos aguinaldo (SAC) 2026: fechas de pago, fórmula, tope y ejemplos | Hacé Cuentas';
const description =
  'Reglas del aguinaldo 2026 en Argentina: fechas legales de pago (30 de junio y 18 de diciembre, Ley 27.073), fórmula del SAC (50% de la mejor remuneración del semestre, art. 121 LCT), proporcional por meses trabajados, tope de aportes y tabla de ejemplos bruto → neto. Uso libre con atribución (CC-BY 4.0).';

const PAGE_URL = 'https://hacecuentas.com/datos-aguinaldo-2026';

const faq = [
  {
    q: '¿Cuándo se paga el aguinaldo en 2026?',
    a: 'En dos cuotas (Ley 27.073, art. 122 LCT): la primera hasta el 30 de junio de 2026 y la segunda hasta el 18 de diciembre de 2026. La LCT admite además una tolerancia de hasta 4 días hábiles (art. 128): 6 de julio para la primera cuota y 24 de diciembre para la segunda.',
  },
  {
    q: '¿Cómo se calcula el aguinaldo?',
    a: 'SAC = 50% de la mayor remuneración mensual devengada del semestre (art. 121 LCT). Cuenta todo concepto remunerativo: básico, horas extra, comisiones, presentismo. Si no se trabajó el semestre completo, se prorratea: (mejor sueldo ÷ 2) × (meses trabajados ÷ 6).',
  },
  {
    q: '¿Qué descuentos tiene el aguinaldo?',
    a: `Los mismos aportes que el sueldo: 17% (jubilación 11% + obra social 3% + PAMI 3%), con base imponible topeada en ${fmtARS(TOPE_SAC, 2)} (media base mensual, porque el SAC es media remuneración). Además puede sufrir retención de Ganancias si tu remuneración supera el mínimo no imponible.`,
  },
  {
    q: '¿El aguinaldo paga Impuesto a las Ganancias?',
    a: 'Sí: el SAC integra la remuneración gravada y la retención se prorratea mes a mes durante el año (RG 4003). Si el empleador no prorrateó, en junio y diciembre la retención puede saltar. Abajo está enlazada la calculadora específica.',
  },
  {
    q: '¿Cómo se calcula el aguinaldo proporcional?',
    a: `Si trabajaste sólo parte del semestre: (mejor sueldo ÷ 2) × (meses trabajados ÷ 6). Ejemplo con mejor sueldo de ${fmtARS(SUELDO_PROP)}: con 3 de 6 meses trabajados, el SAC bruto es ${fmtARS(proporcional[2].bruto)} (la mitad del SAC completo).`,
  },
  {
    q: '¿Qué pasa si me fui o entré a mitad del semestre?',
    a: 'Cobrás el proporcional por los meses (o días) trabajados en el semestre, junto con la liquidación final si hubo egreso. La regla es la misma fórmula proporcional del art. 123 LCT.',
  },
  {
    q: '¿Se toma el sueldo de junio o el mejor del semestre?',
    a: 'El MEJOR (mayor remuneración mensual devengada) del semestre, no el último. Si en marzo cobraste comisiones altas y fue tu mejor mes, el SAC de junio se calcula sobre marzo.',
  },
  {
    q: '¿El aguinaldo cuenta para el tope de aportes?',
    a: `Sí, con media base: la base imponible máxima de aportes del SAC es ${fmtARS(TOPE_SAC, 2)} en junio 2026 (la mitad del tope mensual de ${fmtARS(BASE_IMPONIBLE_MAXIMA_APORTES, 2)}, Ley 24.241). Aguinaldos brutos mayores a ese monto aportan sólo hasta ahí.`,
  },
  {
    q: '¿Puedo usar estos datos en mi web, nota o trabajo?',
    a: 'Sí. Se publican bajo licencia Creative Commons CC-BY 4.0: podés reproducirlos libremente citando la fuente con un enlace a hacecuentas.com. Más abajo está el bloque "Cómo citar".',
  },
];

const datasetSchema = {
  '@type': 'Dataset',
  '@id': `${PAGE_URL}#dataset`,
  name: 'Aguinaldo (SAC) Argentina 2026 — reglas, fechas y tabla de ejemplos',
  description:
    'Reglas del Sueldo Anual Complementario 2026: fechas legales de pago (30/6 y 18/12, Ley 27.073), fórmula del 50% de la mejor remuneración (art. 121 LCT), proporcionalidad, tope de aportes de la Ley 24.241 y ejemplos bruto → neto.',
  url: PAGE_URL,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  inLanguage: 'es-AR',
  dateModified: ULTIMA_REVISION,
  temporalCoverage: '2026',
  spatialCoverage: { '@type': 'Country', name: 'Argentina' },
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
  keywords: ['Aguinaldo', 'SAC', 'Sueldo Anual Complementario', 'LCT', 'Argentina', '2026'],
  variableMeasured: [
    'SAC bruto por mejor sueldo (ARS)', 'Descuentos del SAC (ARS)',
    'SAC neto (ARS)', 'SAC proporcional por meses trabajados (ARS)',
  ],
  identifier: 'https://hacecuentas.com/datos/aguinaldo-2026.json',
  version: '2026',
  distribution: [
    { '@type': 'DataDownload', name: 'Aguinaldo 2026 (JSON)', encodingFormat: 'application/json', contentUrl: 'https://hacecuentas.com/datos/aguinaldo-2026.json' },
    { '@type': 'DataDownload', name: 'Aguinaldo 2026 (CSV)', encodingFormat: 'text/csv', contentUrl: 'https://hacecuentas.com/datos/aguinaldo-2026.csv' },
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${PAGE_URL}#webpage`,
      name: title,
      description,
      url: PAGE_URL,
      inLanguage: 'es-AR',
      dateModified: ULTIMA_REVISION,
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
      mainEntity: { '@id': `${PAGE_URL}#dataset` },
    },
    datasetSchema,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Datos aguinaldo 2026', item: PAGE_URL },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="/datos-aguinaldo-2026"
  audience="AR"
  schema={schema}
>
  <Header slot="header" />

  <main class="article-main">
    <article class="page-content datos-page">
      <header class="article-header">
        <nav class="crumbs" aria-label="Migas de pan">
          <a href="/">Inicio</a> <span>›</span> <span>Datos aguinaldo 2026</span>
        </nav>
        <h1>Aguinaldo (SAC) 2026: fechas, fórmula, tope y ejemplos</h1>
        <p class="lede">
          Referencia completa del <strong>Sueldo Anual Complementario 2026</strong>: cuándo se
          paga (fechas legales de la Ley 27.073), cómo se calcula (art. 121 LCT), cómo se
          prorratea, qué descuentos tiene y dónde topean los aportes. Con tablas de ejemplos
          calculadas con la misma fórmula que nuestra calculadora.
        </p>
        <p class="updated">
          Última revisión: <time datetime={ULTIMA_REVISION}>{new Date(ULTIMA_REVISION).toLocaleDateString('es-AR')}</time> ·
          Tope de aportes al: junio 2026 ·
          Licencia <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC-BY 4.0</a> (uso libre con atribución)
        </p>
      </header>

      <section class="stats-callout" aria-label="Datos destacados">
        <div class="stat">
          <span class="stat-num">30/6 y 18/12</span>
          <span class="stat-label">fechas legales de pago 2026</span>
        </div>
        <div class="stat">
          <span class="stat-num">50%</span>
          <span class="stat-label">de la mejor remuneración del semestre</span>
        </div>
        <div class="stat">
          <span class="stat-num">17%</span>
          <span class="stat-label">aportes descontados (con tope)</span>
        </div>
        <div class="stat">
          <span class="stat-num">{fmtARS(TOPE_SAC, 2)}</span>
          <span class="stat-label">base máxima de aportes del SAC</span>
        </div>
      </section>

      <section>
        <h2>Reglas del aguinaldo 2026</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Regla</th>
                <th>Detalle</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td data-label="Regla">Fórmula</td>
                <td data-label="Detalle" class="td-text">50% de la mayor remuneración mensual devengada del semestre (art. 121 LCT)</td>
              </tr>
              <tr>
                <td data-label="Regla">1ª cuota</td>
                <td data-label="Detalle" class="td-text">Hasta el 30 de junio de 2026 (semestre enero-junio) — tolerancia hasta el 6/7 (4 días hábiles, art. 128 LCT)</td>
              </tr>
              <tr>
                <td data-label="Regla">2ª cuota</td>
                <td data-label="Detalle" class="td-text">Hasta el 18 de diciembre de 2026 (semestre julio-diciembre) — tolerancia hasta el 24/12</td>
              </tr>
              <tr>
                <td data-label="Regla">Proporcional</td>
                <td data-label="Detalle" class="td-text">(Mejor sueldo ÷ 2) × (meses trabajados ÷ 6) si no se trabajó el semestre completo (art. 123 LCT)</td>
              </tr>
              <tr>
                <td data-label="Regla">Descuentos</td>
                <td data-label="Detalle" class="td-text">17% de aportes (11% jubilación + 3% obra social + 3% PAMI) + retención de Ganancias si corresponde</td>
              </tr>
              <tr>
                <td data-label="Regla">Tope de aportes</td>
                <td data-label="Detalle" class="td-text">Base imponible máxima de {fmtARS(TOPE_SAC, 2)} para el SAC (media base mensual de la Ley 24.241, valor junio 2026)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2>Tabla: aguinaldo bruto → neto según tu mejor sueldo</h2>
        <p>
          Semestre completo trabajado (6/6 meses). Calculado con la misma fórmula que la
          calculadora de aguinaldo (aportes 17% con tope; no incluye Ganancias ni cuota sindical):
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Mejor sueldo del semestre</th>
                <th>Aguinaldo bruto</th>
                <th>Aportes (17%)</th>
                <th>Aguinaldo neto</th>
              </tr>
            </thead>
            <tbody>
              {ejemplos.map((e) => (
                <tr>
                  <td data-label="Mejor sueldo"><strong>{fmtARS(e.sueldo, e.sueldo % 1 ? 2 : 0)}</strong></td>
                  <td data-label="SAC bruto">{fmtARS(e.bruto)}</td>
                  <td data-label="Aportes">{fmtARS(e.descuentos)}</td>
                  <td data-label="SAC neto">{fmtARS(e.neto)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          En los dos últimos ejemplos se nota el tope: el aporte queda fijo en
          {' '}{fmtARS(TOPE_SAC * 0.17)} aunque el SAC bruto siga subiendo, porque la base de
          aportes del aguinaldo topea en {fmtARS(TOPE_SAC, 2)}.
        </p>
      </section>

      <section>
        <h2>Aguinaldo proporcional por meses trabajados</h2>
        <p>Ejemplo con mejor sueldo de {fmtARS(SUELDO_PROP)} según los meses trabajados del semestre:</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Meses trabajados</th>
                <th>Aguinaldo bruto</th>
                <th>Aguinaldo neto</th>
              </tr>
            </thead>
            <tbody>
              {proporcional.map((p) => (
                <tr>
                  <td data-label="Meses"><strong>{p.meses} de 6</strong></td>
                  <td data-label="SAC bruto">{fmtARS(p.bruto)}</td>
                  <td data-label="SAC neto">{fmtARS(p.neto)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2>Calculá tu caso</h2>
        <p>Para tu aguinaldo exacto según tu sueldo, meses trabajados y Ganancias:</p>
        <ul class="calc-links">
          <li><a href="/calculadora-aguinaldo-sac">Calculadora de aguinaldo (SAC)</a></li>
          <li><a href="/calculadora-ganancias-aguinaldo-sac-retencion">Ganancias sobre el aguinaldo: cuánto te retienen</a></li>
          <li><a href="/calculadora-cuanto-falta-aguinaldo-junio-diciembre">¿Cuánto falta para el aguinaldo?</a></li>
          <li><a href="/simulador-recibo-de-sueldo-argentina">Simulador de recibo de sueldo</a></li>
        </ul>
        <p>
          Más tablas de datos: <a href="/datos-topes-sipa-2026">topes de aportes SIPA 2026</a> ·
          <a href="/datos-ganancias-2026">escala de Ganancias 2026</a> ·
          <a href="/datos-monotributo-2026">monotributo 2026</a>.
        </p>
      </section>

      <section class="cite-instructions" aria-label="Descargar datos">
        <h2>Descargar estos datos</h2>
        <p>Datos abiertos (CC-BY 4.0), listos para usar en tu app, planilla o análisis:</p>
        <p>
          <a href="/datos/aguinaldo-2026.json" download>⬇ Descargar JSON</a> ·
          <a href="/datos/aguinaldo-2026.csv" download>⬇ Descargar CSV</a>
        </p>
      </section>

      <section class="cite-instructions">
        <h2>Cómo citar esta tabla</h2>
        <p>¿Usás estos datos en una nota, trabajo, app o web? La atribución pedida es:</p>
        <pre><code>Fuente: Hacé Cuentas — https://hacecuentas.com/datos-aguinaldo-2026
LCT arts. 121-123 · Ley 27.073 · Licencia CC-BY 4.0</code></pre>
        <p>
          Si publicás online, te agradecemos el enlace a
          <a href="https://hacecuentas.com/datos-aguinaldo-2026">hacecuentas.com/datos-aguinaldo-2026</a>.
        </p>
      </section>

      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <section class="fuentes">
        <h2>Fuentes</h2>
        <ul>
          <li>Ley de Contrato de Trabajo (20.744), arts. 121 a 123 y 128 — fórmula, proporcionalidad y plazos de pago.</li>
          <li>Ley 27.073 — fechas de pago del SAC (30 de junio y 18 de diciembre).</li>
          <li>Ley 24.241, art. 9 y Resolución ANSES 139/2026 — base imponible máxima de aportes (el SAC topea a media base). Ver <a href="/datos-topes-sipa-2026">datos de topes SIPA 2026</a>.</li>
        </ul>
      </section>
    </article>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .datos-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem 1rem 4rem;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-bottom: 0.75rem;
  }
  .crumbs a { color: var(--accent, #2563eb); text-decoration: none; }
  .datos-page h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text, #222);
  }
  .updated {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-top: 0.5rem;
  }
  .datos-page h2 {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .stats-callout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin: 1.75rem 0;
  }
  .stat {
    background: var(--bg-soft, #f4f6f9);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 0.6rem;
    padding: 0.9rem 1rem;
    text-align: center;
  }
  .stat-num {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent, #2563eb);
    line-height: 1.2;
  }
  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted, #666);
    margin-top: 0.25rem;
  }
  .table-wrap { overflow-x: auto; margin: 1.25rem 0; }
  .datos-page table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    min-width: 540px;
  }
  .datos-page th {
    background: var(--bg-soft, #f1f5f9);
    padding: 0.6rem 0.7rem;
    text-align: right;
    font-weight: 600;
    border-bottom: 2px solid var(--border, #e5e7eb);
    white-space: nowrap;
  }
  .datos-page th:first-child { text-align: left; }
  .datos-page td {
    padding: 0.55rem 0.7rem;
    text-align: right;
    border-bottom: 1px solid var(--border, #eee);
    white-space: nowrap;
  }
  .datos-page td:first-child { text-align: left; }
  .datos-page td.td-text {
    text-align: left;
    white-space: normal;
    line-height: 1.5;
  }
  .datos-page tbody tr:nth-child(odd) { background: var(--bg-card, #fafafa); }
  .note {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-top: 0.5rem;
  }
  .calc-links li, .fuentes li { line-height: 1.7; margin-bottom: 0.5rem; }
  .calc-links, .fuentes ul { margin-left: 1.25rem; }
  .calc-links a, .fuentes a { color: var(--accent, #2563eb); }
  .cite-instructions {
    margin-top: 2.5rem;
    padding: 1.1rem;
    background: var(--bg-soft, #f4f6f9);
    border-radius: 0.6rem;
  }
  .cite-instructions pre {
    background: var(--code-bg, #eaeef3);
    padding: 0.75rem;
    border-radius: 0.4rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }
  .faq details {
    border-bottom: 1px solid var(--border, #e5e7eb);
    padding: 0.75rem 0;
  }
  .faq summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--text, #222);
  }
  .faq details p {
    margin-top: 0.5rem;
    color: var(--text-muted, #555);
    line-height: 1.6;
  }
</style>
