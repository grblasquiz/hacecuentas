---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { NAFTA_NACIONAL, NAFTA_POR_PROVINCIA, NAFTA_POR_BANDERA, NAFTA_META } from '../lib/data/nafta-precios';

const PRODS = ['Nafta Súper', 'Nafta Premium', 'Gasoil', 'Gasoil Premium'] as const;
const fmt = (n: number | null | undefined) => (n == null ? '—' : '$' + Math.round(n).toLocaleString('es-AR'));
const provincias = Object.entries(NAFTA_POR_PROVINCIA);
const banderas = Object.entries(NAFTA_POR_BANDERA);

const SITE = 'https://hacecuentas.com';
const URL = `${SITE}/precio-nafta-hoy`;
const title = 'Precio de la nafta hoy en Argentina: súper, premium y gasoil por provincia | Hacé Cuentas';
const description = `Precio promedio de la nafta y el gasoil hoy en Argentina: súper ${fmt(NAFTA_NACIONAL['Nafta Súper'])}, premium ${fmt(NAFTA_NACIONAL['Nafta Premium'])}, gasoil ${fmt(NAFTA_NACIONAL['Gasoil'])}. Comparación por provincia y por bandera (YPF, Axion, Puma). Datos oficiales de la Secretaría de Energía.`;

const faq = [
  { q: '¿Cuánto cuesta la nafta súper hoy en Argentina?', a: `El precio promedio de la nafta súper hoy es ${fmt(NAFTA_NACIONAL['Nafta Súper'])} por litro (promedio nacional). La premium ronda ${fmt(NAFTA_NACIONAL['Nafta Premium'])} y el gasoil ${fmt(NAFTA_NACIONAL['Gasoil'])}. Varía por provincia y bandera.` },
  { q: '¿Por qué la nafta es más cara en algunas provincias?', a: 'Por los impuestos a los combustibles (que tienen componentes que varían por zona), los costos de flete y, en la Patagonia y Tierra del Fuego, por diferenciales y subsidios que abaratan el precio. Por eso el sur suele tener nafta más barata.' },
  { q: '¿Qué bandera tiene la nafta más barata?', a: banderas.length ? `Según los datos vigentes, ${banderas.sort((a, b) => (a[1]['Nafta Súper'] || 9e9) - (b[1]['Nafta Súper'] || 9e9))[0][0]} tiene el promedio de súper más bajo. Igual conviene comparar por estación: dentro de la misma bandera hay diferencias por ubicación.` : 'Conviene comparar entre YPF, Axion, Puma y Shell, que suelen tener precios distintos.' },
  { q: '¿De dónde salen estos precios?', a: 'De la base oficial de "Precios en surtidor" de la Secretaría de Energía (Res. 314/2016), donde cada estación declara su precio. Son promedios del último relevamiento vigente; el precio exacto puede variar por estación.' },
  { q: '¿Cada cuánto se actualizan?', a: `Se actualizan con el relevamiento oficial. Último dato: ${NAFTA_META.actualizado}. El precio de cada estación se declara dentro de las 8 horas de cualquier cambio.` },
];
const datasetSchema = {
  '@type': 'Dataset', '@id': `${URL}#dataset`,
  name: 'Precios de combustibles en Argentina por provincia',
  description: 'Precio promedio de nafta súper, nafta premium, gasoil y gasoil premium en Argentina, a nivel nacional, por provincia y por bandera. Fuente: Secretaría de Energía.',
  url: URL, license: 'https://creativecommons.org/licenses/by/4.0/', isAccessibleForFree: true,
  inLanguage: 'es-AR', dateModified: NAFTA_META.actualizado, spatialCoverage: { '@type': 'Place', name: 'Argentina' },
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: SITE },
  sourceOrganization: { '@type': 'GovernmentOrganization', name: 'Secretaría de Energía', url: NAFTA_META.fuenteUrl },
  keywords: ['precio nafta', 'precio gasoil', 'combustibles Argentina', 'YPF', 'surtidor'],
};
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Precio de la nafta hoy', item: URL } ] },
  datasetSchema,
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
] };
---

<Layout title={title} description={description} canonical="/precio-nafta-hoy" schema={schema} audience="AR" domain="data">
  <Header slot="header" />
  <main class="wrap">
    <nav class="crumbs"><a href="/">Inicio</a> › <span>Precio de la nafta hoy</span></nav>
    <h1>Precio de la nafta hoy en Argentina ⛽</h1>
    <p class="lede">Promedio de <strong>nafta súper, premium y gasoil</strong> por litro, a nivel nacional, por provincia y por bandera. Datos oficiales de la Secretaría de Energía.</p>
    <p class="updated">Último relevamiento: <time>{NAFTA_META.actualizado}</time> · Fuente: <a href={NAFTA_META.fuenteUrl} rel="noopener" target="_blank">Secretaría de Energía</a> · {NAFTA_META.estaciones.toLocaleString('es-AR')} estaciones</p>

    <section class="stats-callout">
      {PRODS.map((p) => (
        <div class="stat"><span class="stat-num">{fmt(NAFTA_NACIONAL[p])}</span><span class="stat-label">{p} (prom. nacional)</span></div>
      ))}
    </section>

    <section>
      <h2>Precio de la nafta por provincia</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th class="l">Provincia</th>{PRODS.map((p) => <th>{p.replace('Nafta ', '').replace('Gasoil Premium', 'Gasoil Prem.')}</th>)}</tr></thead>
          <tbody>
            {provincias.map(([prov, pr]) => (
              <tr><td class="l">{prov}</td>{PRODS.map((p) => <td>{fmt(pr[p])}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">Promedios del último relevamiento vigente. El precio exacto varía por estación.</p>
    </section>

    {banderas.length > 0 && (
      <section>
        <h2>Precio por bandera</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th class="l">Bandera</th>{PRODS.map((p) => <th>{p.replace('Nafta ', '').replace('Gasoil Premium', 'Gasoil Prem.')}</th>)}</tr></thead>
            <tbody>{banderas.map(([b, pr]) => (<tr><td class="l">{b}</td>{PRODS.map((p) => <td>{fmt(pr[p])}</td>)}</tr>))}</tbody>
          </table>
        </div>
      </section>
    )}

    <section class="links">
      <h2>Calculá tu gasto de combustible</h2>
      <ul>
        <li><a href="/calculadora-costo-viaje-combustible-kilometros">🚗 Costo de un viaje en auto</a></li>
        <li><a href="/calculadora-consumo-nafta-litros-100km">⛽ Consumo de nafta (L/100km)</a></li>
        <li><a href="/calculadora-comparar-nafta-vs-gnc-ahorro">🔵 Nafta vs GNC — ahorro</a></li>
        <li><a href="/calculadora-ahorro-auto-electrico-vs-nafta-anual">🔌 Auto eléctrico vs nafta</a></li>
      </ul>
    </section>

    <section class="faq">
      <h2>Preguntas frecuentes</h2>
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
  </main>
  <Footer slot="footer" />
</Layout>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
  .crumbs { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  .crumbs a { color: var(--accent); text-decoration: none; }
  h1 { font-size: clamp(1.6rem, 4.5vw, 2.1rem); font-weight: 800; margin: 0 0 0.5rem; }
  .lede { font-size: 1.05rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 0.4rem; }
  .updated { font-size: 0.8rem; color: var(--text-subtle); margin: 0 0 1.5rem; }
  .updated a { color: var(--accent); }
  .stats-callout { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin: 0 0 2rem; }
  .stat { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.9rem 1rem; text-align: center; }
  .stat-num { display: block; font-size: 1.5rem; font-weight: 800; color: var(--accent); }
  .stat-label { display: block; font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem; }
  h2 { font-size: 1.25rem; font-weight: 700; margin: 2rem 0 0.75rem; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  th, td { padding: 0.5rem 0.55rem; text-align: right; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th.l, td.l { text-align: left; }
  th { font-size: 0.72rem; text-transform: uppercase; color: var(--text-subtle); font-weight: 700; }
  tbody tr:nth-child(odd) td { background: var(--bg-card); }
  .note { font-size: 0.8rem; color: var(--text-subtle); margin-top: 0.5rem; }
  .links, .faq { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .links h2, .faq h2 { font-size: 1.2rem; }
  .links ul { list-style: none; padding: 0; display: grid; gap: 0.5rem; grid-template-columns: 1fr; }
  @media (min-width: 600px) { .links ul { grid-template-columns: 1fr 1fr; } }
  .links a { color: var(--accent); text-decoration: none; font-weight: 600; }
  .faq details { border-bottom: 1px solid var(--border); padding: 0.75rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq details p { margin-top: 0.5rem; color: var(--text-muted); line-height: 1.6; }
</style>
