---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import inflacion from '../data/live/inflacion.json';

const site = 'https://hacecuentas.com';
const path = '/reloj-inflacion-argentina';

// ── Datos reales del INDEC ──
const meses = ((inflacion as any).last_12_months || []) as { fecha: string; valor: number }[];
const factorAnual = meses.reduce((f, m) => f * (1 + (Number(m.valor) || 0) / 100), 1);
const interanual = (factorAnual - 1) * 100;                       // 33.2
const mensual = Number((inflacion as any)?.last_month?.valor) || 2.1; // 2.1
const interanualStr = interanual.toLocaleString('es-AR', { maximumFractionDigits: 1 });
const mensualStr = mensual.toLocaleString('es-AR', { maximumFractionDigits: 1 });
const fetchedAt = (inflacion as any)?._meta?.fetchedAt;
const updatedStr = fetchedAt
  ? new Date(fetchedAt).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })
  : 'julio de 2026';

// canasta de referencia para el reloj en vivo
const REF = 100000;
const risePerMonth = REF * (mensual / 100);
const risePerDay = risePerMonth / 30;
const risePerHour = risePerDay / 24;
const risePerSec = risePerMonth / (30 * 24 * 3600);

// proyección por defecto (contenido SSR sin JS)
const DEFAULT_PRICE = 100000;
const mFactor = 1 + mensual / 100;
function fmtPeso(n: number) { return '$' + Math.round(n).toLocaleString('es-AR'); }
const proySSR = {
  m3: fmtPeso(DEFAULT_PRICE * Math.pow(mFactor, 3)),
  m6: fmtPeso(DEFAULT_PRICE * Math.pow(mFactor, 6)),
  m12: fmtPeso(DEFAULT_PRICE * factorAnual),
};

// sparkline de los últimos 12 meses
const vals = meses.map((m) => m.valor);
const minV = Math.min(...vals), maxV = Math.max(...vals);
const spW = 300, spH = 60, pad = 4;
const pts = vals.map((v, i) => {
  const x = pad + (i * (spW - 2 * pad)) / Math.max(1, vals.length - 1);
  const y = spH - pad - ((v - minV) / Math.max(0.01, maxV - minV)) * (spH - 2 * pad);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');

const title = `Reloj de la inflación en Argentina: cuánto sube tu plata (${mensualStr}% mensual)`;
const description = `A cuánto corre la inflación en Argentina hoy: ${mensualStr}% mensual y ${interanualStr}% interanual (INDEC). Mirá el reloj en vivo y proyectá cuánto costará dentro de 3, 6 y 12 meses lo que hoy pagás.`;

const relatedCalcs = [
  { href: '/cuanto-perdio-tu-sueldo', emoji: '📉', title: '¿Cuánto perdió tu sueldo?', desc: 'Tu poder de compra en cosas reales: cafés, dólares y nafta, hoy vs hace un año.' },
  { href: '/calculadora-ajuste-sueldo-inflacion', emoji: '📈', title: 'Ajustá tu sueldo por inflación', desc: 'Cuánto debería subir tu sueldo para no perder contra la inflación.' },
  { href: '/inflacion-argentina', emoji: '🇦🇷', title: 'Inflación Argentina hoy', desc: 'El dato mensual e interanual del INDEC, histórico y valor UVA.' },
  { href: '/valores-bcra', emoji: '🏦', title: 'Indicadores del BCRA', desc: 'Dólar, tasas e índices oficiales actualizados, con lectura para tu bolsillo.' },
];

const faq = [
  { q: '¿A cuánto corre la inflación en Argentina hoy?', a: `El último dato mensual del IPC del INDEC es ${mensualStr}% y la inflación interanual (últimos 12 meses) es ${interanualStr}%. A ese ritmo mensual, una canasta de ${fmtPeso(REF)} se encarece unos ${fmtPeso(risePerDay)} por día.` },
  { q: '¿Cuánto costará dentro de un año lo que hoy pago?', a: `Si la inflación se mantiene en el ritmo del último año (${interanualStr}%), lo que hoy sale ${fmtPeso(DEFAULT_PRICE)} costaría alrededor de ${proySSR.m12} dentro de 12 meses. Cargá tu precio arriba para proyectar el tuyo a 3, 6 y 12 meses.` },
  { q: '¿El reloj es una predicción de la inflación?', a: 'No. El reloj muestra a qué ritmo subirían los precios si la inflación se mantuviera en el nivel del último dato del INDEC. No predice el futuro: si la inflación baja o sube, el ritmo cambia. Es una forma de dimensionar la velocidad actual, no un pronóstico.' },
  { q: '¿Cómo se calcula la proyección?', a: `Para 3 y 6 meses componemos la inflación mensual del último dato (${mensualStr}%): precio × (1+${mensualStr}%)^meses. Para 12 meses usamos la inflación interanual acumulada real del INDEC (${interanualStr}%). Todo con datos oficiales.` },
  { q: '¿De dónde salen los datos?', a: `De la serie del IPC del INDEC (índice de precios al consumidor). La inflación interanual se calcula componiendo los últimos 12 datos mensuales publicados. Última actualización: ${updatedStr}.` },
  { q: '¿Por qué mi inflación se siente más alta que la del INDEC?', a: 'El INDEC mide una canasta promedio nacional. Tu inflación personal depende de cuánto pesan en tus gastos el alquiler, la comida, el transporte o la salud, que muchas veces suben más rápido que el promedio. Por eso el número oficial es una referencia, no tu número exacto.' },
  { q: '¿Qué puedo hacer con este dato?', a: 'Sirve para negociar: si los precios corren al ' + interanualStr + '% anual, un aumento de sueldo menor a eso es una pérdida de poder de compra. También para decidir compras: si algo que necesitás va a subir con la inflación, adelantarlo puede convenir. Abajo tenés las calculadoras para ajustar tu sueldo y ver qué perdiste.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Reloj de la inflación en Argentina',
      description,
      url: `${site}${path}`,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      inLanguage: 'es-AR',
      isPartOf: { '@id': `${site}/#website` },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'ARS' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Reloj de la inflación', item: `${site}${path}` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} schema={schema} audience="AR" canonical={path}>
  <Header slot="header" />

  <main class="ri">
    <!-- HERO / RELOJ -->
    <section class="ri-hero" id="ri-app"
      data-ref={REF} data-persec={risePerSec} data-mensual={mensual} data-interanual={interanual} data-factoranual={factorAnual}>
      <p class="ri-eyebrow">🕐 Reloj de la inflación · INDEC {updatedStr}</p>
      <h1>La inflación en Argentina corre a {mensualStr}% por mes</h1>
      <p class="ri-lead">Desde que abriste esta página, una canasta de {fmtPeso(REF)} ya se encareció:</p>
      <div class="ri-ticker" id="ri-ticker" role="status" aria-live="off">+$0,00</div>
      <p class="ri-ticker-sub">
        <strong>{fmtPeso(risePerDay)}</strong> por día · <strong>{fmtPeso(risePerHour)}</strong> por hora ·
        interanual <strong>{interanualStr}%</strong>
      </p>
    </section>

    <!-- PROYECCIÓN -->
    <section class="ri-card">
      <h2 class="ri-card-h">¿Cuánto costará dentro de un año?</h2>
      <label class="ri-field">
        <span>Algo que hoy pagás</span>
        <div class="ri-inwrap">
          <span class="ri-cur">$</span>
          <input id="ri-price" type="text" inputmode="numeric" enterkeyhint="done"
            value={DEFAULT_PRICE.toLocaleString('es-AR')} autocomplete="off" aria-label="Precio actual en pesos" />
        </div>
      </label>
      <div class="ri-proy" id="ri-proy">
        <div class="ri-proy-cell"><span class="ri-proy-lbl">en 3 meses</span><strong class="ri-proy-val" data-h="3">{proySSR.m3}</strong></div>
        <div class="ri-proy-cell"><span class="ri-proy-lbl">en 6 meses</span><strong class="ri-proy-val" data-h="6">{proySSR.m6}</strong></div>
        <div class="ri-proy-cell ri-proy-cell--hl"><span class="ri-proy-lbl">en 12 meses</span><strong class="ri-proy-val" data-h="12">{proySSR.m12}</strong></div>
      </div>
      <p class="ri-method">
        Proyección al ritmo actual: 3 y 6 meses componen la inflación mensual ({mensualStr}%); 12 meses usa la interanual real del INDEC ({interanualStr}%).
        <strong>No es una predicción</strong> — es cuánto costaría si la inflación se mantiene.
      </p>
    </section>

    <!-- SPARKLINE -->
    <section class="ri-spark">
      <h2>Inflación mensual, últimos 12 meses</h2>
      <svg viewBox={`0 0 ${spW} ${spH}`} class="ri-spark-svg" role="img" aria-label={`Evolución de la inflación mensual: de ${vals[0]}% a ${vals[vals.length-1]}%`} preserveAspectRatio="none">
        <polyline points={pts} fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
      </svg>
      <p class="ri-spark-cap">De {meses[0]?.valor?.toLocaleString('es-AR')}% a {meses[meses.length-1]?.valor?.toLocaleString('es-AR')}% mensual · pico {maxV.toLocaleString('es-AR')}% · fuente INDEC.</p>
    </section>

    <!-- RELACIONADAS -->
    <section class="ri-related">
      <h2>Cuidá tu plata de la inflación</h2>
      <div class="ri-related-grid">
        {relatedCalcs.map((c) => (
          <a class="ri-related-card" href={c.href}>
            <span class="ri-related-emoji">{c.emoji}</span>
            <span class="ri-related-title">{c.title}</span>
            <span class="ri-related-desc">{c.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- CONTEXTO -->
    <section class="ri-text">
      <h2>Por qué la inflación "corre"</h2>
      <p>
        La inflación no es un número que aparece una vez por mes: es un proceso continuo. Cuando el INDEC informa {mensualStr}% mensual,
        significa que, en promedio, los precios suben todos los días un poquito. Verlo como un reloj ayuda a dimensionar la velocidad:
        a este ritmo, una canasta de {fmtPeso(REF)} se encarece alrededor de {fmtPeso(risePerDay)} por día sin que hagas nada.
      </p>
      <p>
        Ese goteo es lo que te come el sueldo. Si tu ingreso no sube al menos {interanualStr}% al año, tu poder de compra baja aunque
        el número de pesos siga igual. Por eso conviene pensar en pesos <em>reales</em>: podés
        <a href="/cuanto-perdio-tu-sueldo"> ver cuánto perdió tu sueldo</a> y
        <a href="/calculadora-ajuste-sueldo-inflacion"> cuánto tendría que subir</a> para empatarle a la inflación.
      </p>
    </section>

    <!-- FAQ -->
    <section class="ri-faq">
      <h2>Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details class="ri-faq-item">
          <summary>{f.q}</summary>
          <p set:html={f.a}></p>
        </details>
      ))}
    </section>
  </main>

  <Footer />
</Layout>

<script>
  (function () {
    const app = document.getElementById('ri-app');
    if (!app) return;
    const perSec = parseFloat(app.getAttribute('data-persec') || '0');
    const mensual = parseFloat(app.getAttribute('data-mensual') || '0');
    const factorAnual = parseFloat(app.getAttribute('data-factoranual') || '1');
    const mFactor = 1 + mensual / 100;
    const nf = new Intl.NumberFormat('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const nf0 = new Intl.NumberFormat('es-AR');

    // ── reloj en vivo ──
    const tickerEl = document.getElementById('ri-ticker');
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = performance.now();
    function tick(now: number) {
      const secs = (now - start) / 1000;
      if (tickerEl) tickerEl.textContent = '+$' + nf.format(secs * perSec);
      if (!reduce) requestAnimationFrame(tick);
    }
    if (reduce) { if (tickerEl) tickerEl.textContent = '+$' + nf.format(perSec); }
    else requestAnimationFrame(tick);

    // ── proyección ──
    const priceEl = document.getElementById('ri-price') as HTMLInputElement;
    const cells = Array.from(document.querySelectorAll('#ri-proy .ri-proy-val')) as HTMLElement[];
    function parseNum(v: string) { const c = (v || '').replace(/[^\d]/g, ''); return c ? Number(c) : 0; }
    function fmtPeso(n: number) { return '$' + nf0.format(Math.round(n)); }
    function recompute() {
      const P = parseNum(priceEl.value);
      cells.forEach((cell) => {
        const h = parseInt(cell.getAttribute('data-h') || '0', 10);
        const val = h === 12 ? P * factorAnual : P * Math.pow(mFactor, h);
        cell.textContent = fmtPeso(val);
      });
    }
    priceEl.addEventListener('input', () => {
      const pos = priceEl.selectionStart || 0;
      const before = priceEl.value.length;
      const n = parseNum(priceEl.value);
      priceEl.value = n ? nf0.format(n) : '';
      const after = priceEl.value.length;
      try { priceEl.setSelectionRange(pos + (after - before), pos + (after - before)); } catch (e) {}
      recompute();
    });
    recompute();

    const track = (window as any).hcTrack;
    if (typeof track === 'function') track('calc_view', { calc: 'reloj-inflacion' });
  })();
</script>

<style>
  .ri { max-width: 760px; margin: 0 auto; padding: 1.25rem 1rem 3rem; display: flex; flex-direction: column; gap: 1.75rem; }

  .ri-hero { text-align: center; padding: 1.5rem 1.25rem; border-radius: var(--radius-lg, 1rem); background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, var(--bg-card)), var(--bg-card)); border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border)); }
  .ri-eyebrow { margin: 0 0 0.5rem; font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-subtle); }
  .ri-hero h1 { margin: 0 0 0.4rem; font-size: clamp(1.2rem, 5vw, 1.65rem); line-height: 1.2; color: var(--text); }
  .ri-lead { margin: 0.5rem 0 0.75rem; font-size: 0.95rem; color: var(--text-muted); }
  .ri-ticker { font-size: clamp(2.2rem, 10vw, 3.4rem); font-weight: 800; line-height: 1; color: var(--accent-strong, #b91c1c); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .ri-ticker-sub { margin: 0.65rem 0 0; font-size: 0.85rem; color: var(--text-muted); }
  .ri-ticker-sub strong { color: var(--text); }

  .ri-card { border: 1px solid var(--border); border-radius: var(--radius-lg, 1rem); background: var(--bg-card); padding: 1.25rem; box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,.06)); }
  .ri-card-h { margin: 0 0 0.9rem; font-size: 1.2rem; color: var(--text); }
  .ri-field { display: flex; flex-direction: column; gap: 0.3rem; }
  .ri-field > span { font-size: 0.82rem; font-weight: 600; color: var(--text); }
  .ri-inwrap { display: flex; align-items: center; border: 1px solid var(--border-input, #6b7280); border-radius: var(--radius-md, 0.6rem); background: var(--bg); overflow: hidden; }
  .ri-inwrap:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  .ri-cur { padding: 0 0.55rem; font-weight: 700; color: var(--text-muted); }
  .ri-inwrap input { flex: 1; border: 0; background: transparent; padding: 0.7rem 0.6rem 0.7rem 0; font-size: 1.35rem; font-weight: 700; color: var(--text); width: 100%; outline: none; font-variant-numeric: tabular-nums; }
  .ri-proy { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin-top: 1rem; }
  .ri-proy-cell { border: 1px solid var(--border); border-radius: var(--radius-md, 0.6rem); padding: 0.7rem; text-align: center; background: var(--bg); }
  .ri-proy-cell--hl { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); background: color-mix(in srgb, var(--accent) 6%, var(--bg)); }
  .ri-proy-lbl { display: block; font-size: 0.74rem; color: var(--text-muted); margin-bottom: 0.25rem; }
  .ri-proy-val { font-size: clamp(1rem, 4.5vw, 1.25rem); color: var(--accent-strong, #0369a1); font-variant-numeric: tabular-nums; }
  .ri-method { margin: 0.9rem 0 0; font-size: 0.78rem; line-height: 1.5; color: var(--text-subtle); }

  .ri-spark h2, .ri-related h2, .ri-text h2, .ri-faq h2 { font-size: 1.2rem; margin: 0 0 0.7rem; color: var(--text); }
  .ri-spark-svg { width: 100%; height: 60px; display: block; }
  .ri-spark-cap { margin: 0.4rem 0 0; font-size: 0.78rem; color: var(--text-muted); }

  .ri-related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  .ri-related-card { display: flex; flex-direction: column; gap: 0.25rem; border: 1px solid var(--border); border-radius: var(--radius-md, 0.6rem); padding: 0.8rem; background: var(--bg-card); text-decoration: none; }
  .ri-related-card:hover { border-color: var(--accent); }
  .ri-related-emoji { font-size: 1.3rem; }
  .ri-related-title { font-weight: 700; font-size: 0.92rem; color: var(--text); }
  .ri-related-desc { font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; }

  .ri-text p { margin: 0 0 0.75rem; font-size: 0.95rem; line-height: 1.65; color: var(--text); max-width: 70ch; }
  .ri-text a { color: var(--accent-strong, #0369a1); }

  .ri-faq { display: flex; flex-direction: column; gap: 0.5rem; }
  .ri-faq-item { border: 1px solid var(--border); border-radius: var(--radius-md, 0.6rem); background: var(--bg); padding: 0.75rem 1rem; }
  .ri-faq-item summary { cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--text); }
  .ri-faq-item p { margin: 0.55rem 0 0.1rem; font-size: 0.9rem; line-height: 1.6; color: var(--text-muted); }

  @media (max-width: 460px) {
    .ri-related-grid { grid-template-columns: 1fr; }
  }
</style>
