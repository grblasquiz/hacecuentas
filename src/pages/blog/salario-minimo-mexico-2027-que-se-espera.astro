---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SalarioMinimoMexico2027Experience from '../../components/generated/SalarioMinimoMexico2027Experience.astro';
import TopPagesBoost from '../../components/TopPagesBoost.astro';
const canonical = 'https://hacecuentas.com/blog/salario-minimo-mexico-2027-que-se-espera';
const faq = [
  { q: '¿Cuánto será el salario mínimo de México en 2027?', a: 'Todavía no existe una cifra oficial. CONASAMI suele resolver el valor hacia el cierre del año anterior.' },
  { q: '¿La proyección es un dato oficial?', a: 'No. Los porcentajes de la calculadora son escenarios aplicados sobre la base oficial de 2026.' },
  { q: '¿El aumento será igual en la frontera norte?', a: 'No necesariamente. CONASAMI puede fijar variaciones distintas para el área general y la Zona Libre de la Frontera Norte.' },
];
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'Article',headline:'Salario mínimo México 2027: qué se sabe y qué se espera',description:'Dato oficial, base 2026 y escenarios posibles para el salario mínimo de México en 2027.',datePublished:'2026-07-31',dateModified:'2026-08-04',inLanguage:'es-MX',mainEntityOfPage:canonical,author:{'@type':'Organization',name:'Hacé Cuentas'},publisher:{'@type':'Organization',name:'Hacé Cuentas'}},
  {'@type':'WebApplication',name:'Simulador de salario mínimo México 2027',url:`${canonical}#escenarios`,applicationCategory:'FinanceApplication',operatingSystem:'Web',offers:{'@type':'Offer',price:'0',priceCurrency:'MXN'}},
  {'@type':'FAQPage',mainEntity:faq.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:'https://hacecuentas.com/'},{'@type':'ListItem',position:2,name:'México',item:'https://hacecuentas.com/mx'},{'@type':'ListItem',position:3,name:'Salario mínimo 2027',item:canonical}]}
]};
---
<Layout title="Salario mínimo México 2027: dato oficial y escenarios" description="¿Cuánto será el salario mínimo México 2027? Todavía no hay cifra oficial. Consultá la base 2026, fechas clave y simulá escenarios general y frontera." canonical={canonical} schema={schema} audience="MX" lang="es-MX" ogType="article" articleSection="Trabajo">
  <Header />
  <SalarioMinimoMexico2027Experience />
  <TopPagesBoost variant="salary-mx" />
  <Footer />
</Layout>
