---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Newsletter from '../../components/Newsletter.astro';
import Icon from '../../components/ui/Icon.astro';
import { TOTAL_DISPLAY } from '../../lib/calc-counts';

// Load all published blog posts from content/blog/*.json
const postModules = import.meta.glob('../../content/blog/*.json', { eager: true });

interface BlogPost {
  slug: string;
  title: string;
  description: string;
  category: string;
  date: string;
  readingTime: number;
  heroEmoji: string;
  seoKeywords?: string[];
  author?: string;
  // Dato principal para las notas-análisis: en vez de un emoji decorativo,
  // la card muestra el número que resume la nota (ej: "−23%" · "salario real
  // desde 2017"). Sólo lo definen las notas-dato; el resto cae al heroEmoji.
  stat?: { value: string; label: string };
}

// Autor E-E-A-T por defecto del sitio. Los JSON viejos traen "author" genérico
// ("Hacé Cuentas", "Equipo editorial…") que NO es una persona verificable.
// Para señal E-E-A-T mostramos siempre una persona real como fallback.
const DEFAULT_AUTHOR = 'Martín Rodríguez';
function displayAuthor(p: BlogPost): string {
  const a = (p.author || '').trim();
  // Si el author guardado no es una persona (contiene "Hacé Cuentas"/"Equipo"),
  // caemos al autor real del sitio.
  if (!a || /hac[eé] cuentas|equipo/i.test(a)) return DEFAULT_AUTHOR;
  return a;
}

const allPosts: BlogPost[] = Object.values(postModules) as BlogPost[];

// Sort by date descending
const posts = allPosts.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

// Format date: "15 abril 2026"
function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
}

const hasPosts = posts.length > 0;
// Featured: preferir un post marcado `featured: true` en su JSON; si no, el más
// nuevo que NO sea efímero (partidos/mundial/fixture caducan) para no dejar un
// evento ya pasado como cara del blog; fallback al más nuevo.
const EPHEMERAL_RE = /mundial|partidos|fixture|copa|finde|fin-de-semana/i;
const isEphemeral = (p: BlogPost) => EPHEMERAL_RE.test(p.slug) || p.category === 'deportes';
const featuredPost = hasPosts
  ? (posts.find((p) => (p as any).featured) || posts.find((p) => !isEphemeral(p)) || posts[0])
  : null;
const restPosts = hasPosts ? posts.filter((p) => p !== featuredPost) : [];

// ── Agrupación temática ──────────────────────────────────────────────────────
// El grid plano no da jerarquía. Agrupamos los posts (menos el featured) en
// secciones temáticas según su `category`. Cada sección tiene un ícono del UI
// kit (no emoji). Las categorías que no mapean caen en "Más artículos".
type SectionKey = 'datos' | 'cambios' | 'guias' | 'casos' | 'otros' | 'actualidad';
const SECTIONS: { key: SectionKey; title: string; icon: string; desc: string }[] = [
  { key: 'datos',   title: 'Datos y análisis', icon: 'chart',    desc: 'Informes con números actualizados: inflación, sueldos, costo de vida.' },
  { key: 'cambios', title: 'Qué cambió',       icon: 'calendar', desc: 'Vencimientos, escalas y novedades fiscales del mes.' },
  { key: 'guias',   title: 'Guías',            icon: 'book',     desc: 'Paso a paso para calcular y entender, sin tecnicismos.' },
  { key: 'casos',   title: 'Casos prácticos',  icon: 'target',   desc: 'Decisiones concretas: dónde conviene, cuánto sale, cómo dividir.' },
  { key: 'otros',   title: 'Más artículos',    icon: 'info',     desc: '' },
  // Actualidad va SIEMPRE al final y separada: coberturas de temporada
  // (Mundial, findes largos) que caducan y no son la promesa editorial del
  // blog financiero. No las mezclamos con "Casos prácticos".
  { key: 'actualidad', title: 'Actualidad', icon: 'clock', desc: 'Coberturas de temporada: Mundial, findes largos y eventos. Caducan rápido.' },
];

// Mapeo category → sección temática. Data-driven: se apoya en el `category`
// real de cada JSON. Si aparece una categoría nueva sin mapear, cae en "otros".
const CATEGORY_TO_SECTION: Record<string, SectionKey> = {
  economia: 'datos',
  fiscal: 'cambios',
  salud: 'guias',
  vida: 'guias',
  finanzas: 'casos',
  hogar: 'casos',
  viajes: 'casos',
  deportes: 'casos',
};

// Heurística fina para finanzas (categoría más poblada): informes → datos,
// vencimientos → cambios, guías how-to → guías. El resto queda en casos.
function sectionFor(p: BlogPost): SectionKey {
  const slug = p.slug;
  // Efímeras (deportes/mundial/findes) → Actualidad, sin importar su category.
  if (isEphemeral(p)) return 'actualidad';
  if (/^informe-financiero|^inflacion-|costo-de-vida|sueldo-real|argentino-promedio/.test(slug)) return 'datos';
  if (/vencimiento|recategorizacion|escala-ganancias|prorroga/.test(slug)) return 'cambios';
  if (/^como-|^guia-/.test(slug)) return 'guias';
  return CATEGORY_TO_SECTION[p.category] || 'otros';
}

const grouped = SECTIONS.map((s) => ({
  ...s,
  posts: restPosts.filter((p) => sectionFor(p) === s.key),
})).filter((s) => s.posts.length > 0);

const description = hasPosts
  ? 'Artículos prácticos sobre finanzas, salud y negocios. Cobertura para Argentina (sueldos, impuestos, monotributo). Sin tecnicismos, con ejemplos reales.'
  : 'Próximamente: artículos sobre finanzas, salud y negocios para hispanohablantes. Cobertura para Argentina (sueldos, impuestos). Suscribite al newsletter.';

const blogPostingEntries = posts.map((p) => ({
  '@type': 'BlogPosting',
  headline: p.title,
  description: p.description,
  datePublished: p.date,
  url: `https://hacecuentas.com/blog/${p.slug}`,
  author: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
    logo: 'https://hacecuentas.com/favicon.svg',
  },
  inLanguage: 'es',
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': 'https://hacecuentas.com/blog#blog',
  name: 'Blog de Hacé Cuentas',
  description,
  url: 'https://hacecuentas.com/blog',
  inLanguage: ['es', 'es-AR', 'es-419'],
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: 'https://hacecuentas.com',
    logo: 'https://hacecuentas.com/favicon.svg',
  },
  ...(blogPostingEntries.length > 0 && { blogPost: blogPostingEntries }),
};
---

<Layout
  title="Blog Hacé Cuentas: análisis y guías de finanzas Argentina 2026"
  description={description}
  schema={schema}
  pageType="editorial"
  domain="knowledge"
>
  <Header slot="header" />

  <article class="blog-index">
    <nav class="breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Blog</span>
    </nav>

    <header class="hero">
      <h1>Blog de finanzas personales y cálculos prácticos</h1>
      <p class="lead">
        Análisis, guías paso a paso y research original sobre finanzas personales,
        sueldos, impuestos, monotributo, inflación y salud. Universales para hispanohablantes,
        con cobertura específica para Argentina <span aria-hidden="true">🇦🇷</span> respaldada
        por fuentes oficiales (ARCA, ANSES, BCRA, INDEC). Sin tecnicismos, con ejemplos reales.
      </p>
    </header>

    {hasPosts ? (
      <section class="posts-section">
        {/* Featured post — full width */}
        {featuredPost && (
          <a href={`/blog/${featuredPost.slug}`} class="post-card post-card--featured">
            {featuredPost.stat ? (
              <div class="post-card__stat" aria-hidden="true">
                <span class="stat-value">{featuredPost.stat.value}</span>
                <span class="stat-label">{featuredPost.stat.label}</span>
              </div>
            ) : (
              <div class="post-card__emoji" aria-hidden="true">{featuredPost.heroEmoji}</div>
            )}
            <div class="post-card__body">
              <span class={`cat-tag cat-${featuredPost.category}`}>{featuredPost.category}</span>
              <h2 class="post-card__title">{featuredPost.title}</h2>
              <p class="post-card__desc">{featuredPost.description}</p>
              <div class="post-card__meta">
                <span class="meta-author">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  {displayAuthor(featuredPost)}
                </span>
                <span class="meta-dot" aria-hidden="true">·</span>
                <time datetime={featuredPost.date}>{formatDate(featuredPost.date)}</time>
                <span class="meta-dot" aria-hidden="true">·</span>
                <span>{featuredPost.readingTime} min de lectura</span>
              </div>
            </div>
          </a>
        )}

        {/* Rest of posts — grouped into thematic sections */}
        {grouped.map((section) => (
          <div class={`topic-group${section.key === 'actualidad' ? ' topic-group--actualidad' : ''}`}>
            <div class="topic-head">
              <span class="topic-icon" aria-hidden="true">
                <Icon name={section.icon} size={18} />
              </span>
              <div>
                <h2 class="topic-title">{section.title}</h2>
                {section.desc && <p class="topic-desc">{section.desc}</p>}
              </div>
            </div>
            <ul class="posts-grid">
              {section.posts.map((post) => (
                <li>
                  <a href={`/blog/${post.slug}`} class="post-card">
                    {post.stat ? (
                      <div class="post-card__stat" aria-hidden="true">
                        <span class="stat-value">{post.stat.value}</span>
                        <span class="stat-label">{post.stat.label}</span>
                      </div>
                    ) : (
                      <div class="post-card__emoji" aria-hidden="true">{post.heroEmoji}</div>
                    )}
                    <div class="post-card__body">
                      <span class={`cat-tag cat-${post.category}`}>{post.category}</span>
                      <h3 class="post-card__title">{post.title}</h3>
                      <p class="post-card__desc">{post.description}</p>
                      <div class="post-card__meta">
                        <span class="meta-author">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                          {displayAuthor(post)}
                        </span>
                        <span class="meta-dot" aria-hidden="true">·</span>
                        <time datetime={post.date}>{formatDate(post.date)}</time>
                        <span class="meta-dot" aria-hidden="true">·</span>
                        <span>{post.readingTime} min</span>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ) : null}

    <section class="meanwhile">
      <h2>Mientras tanto</h2>
      <p>
        Tenemos <strong>{TOTAL_DISPLAY} calculadoras gratis</strong> con explicaciones
        paso a paso, fórmulas y fuentes. Cada una incluye un glosario corto y
        ejemplos para que entiendas qué estás calculando, no solo el resultado.
      </p>
      <div class="quick-links">
        <a href="/categoria/finanzas" class="ql-card">
          <span class="ql-icon">💰</span>
          <span class="ql-title">Calculadoras de finanzas</span>
          <span class="ql-arrow">→</span>
        </a>
        <a href="/categoria/salud" class="ql-card">
          <span class="ql-icon">❤️</span>
          <span class="ql-title">Calculadoras de salud</span>
          <span class="ql-arrow">→</span>
        </a>
        <a href="/glosario" class="ql-card">
          <span class="ql-icon">📚</span>
          <span class="ql-title">Glosario de términos</span>
          <span class="ql-arrow">→</span>
        </a>
        <a href="/buscar" class="ql-card">
          <span class="ql-icon">🔎</span>
          <span class="ql-title">Buscar una calculadora</span>
          <span class="ql-arrow">→</span>
        </a>
      </div>
    </section>

    <Newsletter />
  </article>

  <Footer slot="footer" />
</Layout>

<style>
  .blog-index {
    max-width: 880px;
    margin: 1rem auto 2rem;
    padding: 0 1rem;
  }

  /* ── Breadcrumbs ── */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-subtle);
    margin-bottom: 1.5rem;
  }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }

  /* ── Hero ── */
  /* Masthead editorial: a la izquierda, tipografía display, no centrado-directorio. */
  .hero {
    text-align: left;
    padding: 1rem 0 1.75rem;
    border-bottom: 2px solid var(--text);
    margin-bottom: 2.25rem;
  }
  .hero h1 {
    font-family: var(--font-display, inherit);
    font-size: clamp(2.1rem, 5vw, 3rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 0.75rem;
    max-width: 16ch;
  }
  .hero .lead {
    font-size: 1.0625rem;
    color: var(--text-muted);
    max-width: 640px;
    margin: 0;
    line-height: 1.6;
  }

  /* ── Category badges ── */
  .cat-tag {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.1875rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  .cat-finanzas  { background: #fef3c7; color: #92400e; }
  .cat-salud     { background: #fce7f3; color: #9d174d; }
  .cat-marketing { background: #ddd6fe; color: #5b21b6; }
  .cat-negocios  { background: #d1fae5; color: #065f46; }
  .cat-vida      { background: #dbeafe; color: #1e40af; }
  .cat-matematica { background: #fef9c3; color: #713f12; }
  .cat-educacion { background: #e0f2fe; color: #0369a1; }

  :global([data-theme="dark"]) .cat-finanzas   { background: #78350f33; color: #fcd34d; }
  :global([data-theme="dark"]) .cat-salud      { background: #831843aa; color: #f9a8d4; }
  :global([data-theme="dark"]) .cat-marketing  { background: #4c1d9544; color: #c4b5fd; }
  :global([data-theme="dark"]) .cat-negocios   { background: #064e3b44; color: #6ee7b7; }
  :global([data-theme="dark"]) .cat-vida       { background: #1e3a8a44; color: #93c5fd; }
  :global([data-theme="dark"]) .cat-matematica { background: #78350f22; color: #fde68a; }
  :global([data-theme="dark"]) .cat-educacion  { background: #0c4a6e44; color: #7dd3fc; }

  /* ── Posts section ── */
  .posts-section {
    margin-bottom: 3rem;
  }

  /* Lead story editorial: asimétrico, "tapa" tintada con el emoji grande como
     elemento editorial (no decorativo chico), título display. */
  .post-card--featured {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 0;
    align-items: stretch;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
    margin-bottom: 2rem;
    width: 100%;
  }
  .post-card--featured:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    color: inherit;
  }
  .post-card--featured .post-card__emoji {
    font-size: 4.5rem;
    line-height: 1;
    flex-shrink: 0;
    margin: 0;
    display: flex; align-items: center; justify-content: center;
    min-height: 200px;
    background: linear-gradient(150deg, var(--accent-soft), color-mix(in srgb, var(--accent-2, #7c3aed) 14%, var(--accent-soft)));
    border-right: 1px solid var(--border);
  }
  .post-card--featured .post-card__body { padding: 1.85rem 1.9rem; }
  .post-card--featured .post-card__title {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    font-weight: 850;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 0.7rem;
    color: var(--text);
  }
  @media (max-width: 640px) {
    .post-card--featured { grid-template-columns: 1fr; }
    .post-card--featured .post-card__emoji { min-height: 130px; border-right: 0; border-bottom: 1px solid var(--border); }
  }
  .post-card--featured .post-card__desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 0.875rem;
  }

  /* Grid of remaining posts */
  .posts-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  /* Regular post card (in grid) */
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.07);
    text-decoration: none;
    color: inherit;
  }
  .post-card .post-card__emoji {
    font-size: 2rem;
    line-height: 1;
  }

  /* ── Dato principal (reemplaza al emoji en notas-análisis) ── */
  /* Card de grilla: número en línea, compacto, con etiqueta debajo. */
  .post-card .post-card__stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .post-card .stat-value {
    font-family: var(--font-display, inherit);
    font-size: 2rem;
    font-weight: 850;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .post-card .stat-label {
    font-size: 0.75rem;
    color: var(--text-subtle);
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  /* Featured: el dato ocupa el panel tintado como "tapa" editorial. */
  .post-card--featured .post-card__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    text-align: center;
    min-height: 200px;
    padding: 1.5rem;
    background: linear-gradient(150deg, var(--accent-soft), color-mix(in srgb, var(--accent-2, #7c3aed) 14%, var(--accent-soft)));
    border-right: 1px solid var(--border);
  }
  .post-card--featured .stat-value {
    font-size: clamp(3rem, 6vw, 4rem);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .post-card--featured .stat-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    max-width: 22ch;
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  @media (max-width: 640px) {
    .post-card--featured .post-card__stat { min-height: 130px; border-right: 0; border-bottom: 1px solid var(--border); }
  }
  .post-card .post-card__title {
    font-size: 1rem;
    line-height: 1.35;
    margin-bottom: 0.375rem;
    color: var(--text);
  }
  .post-card .post-card__desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
    margin-bottom: 0.5rem;
  }

  /* Shared card body */
  .post-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }
  .meta-dot { opacity: 0.5; }
  .meta-author {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .meta-author svg { flex-shrink: 0; opacity: 0.85; }

  /* ── Thematic groups ── */
  section { margin-bottom: 3rem; }

  .topic-group { margin-top: 2.5rem; }
  .topic-group:first-of-type { margin-top: 0; }

  /* Actualidad: visualmente separada y atenuada — es contenido de temporada,
     no la promesa editorial del blog. Regla arriba + tono apagado. */
  .topic-group--actualidad {
    margin-top: 3.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border);
  }
  .topic-group--actualidad .topic-icon {
    background: var(--bg-subtle, var(--accent-soft));
    color: var(--text-subtle);
  }
  .topic-group--actualidad .topic-title { color: var(--text-muted); }

  .topic-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }
  .topic-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm, 8px);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .topic-title {
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.2;
