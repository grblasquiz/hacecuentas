---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PreferredSourceCta from '../../components/PreferredSourceCta.astro';
import { filterByIncremental } from '../../lib/incremental';
import { ALL_HUBS, allSilos } from '../../lib/hubs/registry';

export async function getStaticPaths() {
  const posts = import.meta.glob<any>('../../content/blog/*.json', { eager: true });
  const all = Object.values(posts).map((mod: any) => mod.default || mod);
  return filterByIncremental(all, 'blog').map((p: any) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props;

const siteUrl = 'https://hacecuentas.com';

// OG / Discover image: generada por scripts/generate-og-images.ts en prebuild
// (blog-<slug>.jpg, 1200×630, JPG). Discover pondera fuerte la imagen y prefiere
// JPG ≥1200px. El generador produce imagen para TODO post con slug/title/
// description (que son required acá), así que siempre existe en el deploy.
// heroImage (foto/ilustración real, ≥1200px) tiene prioridad para og:image + schema.
const ogImage = (post.heroImage as string)?.trim() || `/og/blog-${post.slug}.jpg`;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const inlineHeroImage = (post.heroImage as string)?.trim();
const inlineHeroImageSmall = (post.heroImageSmall as string)?.trim();

// ─── Related calcs ──────────────────────────────────────────────────────────
// Las calcs de país viven en colecciones separadas y se sirven bajo prefijo
// (/co/<slug>, /mx/<slug>); las AR van en la raíz. Resolvemos las tres y
// guardamos el href ya prefijado en __href. Sin esto, un relatedCalcs de
// CO/MX no matchea y `.filter(Boolean)` lo descarta en silencio → se caen
// los 3 CTAs y el sidebar entero. Verificado: 0 colisiones de slug entre las
// colecciones, y AR tiene precedencia por si alguna vez aparece una.
const calcSources = [
  [import.meta.glob<any>('../../content/calcs/*.json', { eager: true }), ''],
  [import.meta.glob<any>('../../content/calcs-co/*.json', { eager: true }), '/co'],
  [import.meta.glob<any>('../../content/calcs-mx/*.json', { eager: true }), '/mx'],
] as const;

const calcBySlug = new Map<string, any>();
for (const [mods, prefix] of calcSources) {
  for (const mod of Object.values(mods)) {
    const c: any = (mod as any).default || mod;
    if (c?.slug && !calcBySlug.has(c.slug)) {
      calcBySlug.set(c.slug, { ...c, __href: `${prefix}/${c.slug}` });
    }
  }
}

// Los hubs de decisión absorbieron el catálogo que el blog citaba: las 177
// referencias de `relatedCalcs` apuntaban a calcs podadas y `filter(Boolean)`
// las descartaba en silencio → NINGÚN post renderizaba el bloque de
// relacionadas ni el CTA del sidebar. Ahora una entrada que arranca con '/'
// es una ruta directa (hub o calc de país) y se resuelve contra el registro
// de hubs; las que no llevan '/' siguen siendo slugs de calc como antes.
const hubByHref = new Map<string, any>(
  ALL_HUBS.map((h) => [
    h.slug.startsWith('/') ? h.slug : `/${h.slug}`,
    { ...h, __href: h.slug.startsWith('/') ? h.slug : `/${h.slug}`, icon: '🧮' },
  ]),
);

// Los índices de silo ('/trabajo', '/co/impuestos') también son destino válido:
// los posts que quedaron con un solo hub relacionado enlazan además su silo
// padre, que es la relación más honesta que hay sin inventar afinidades.
for (const s of allSilos()) {
  if (hubByHref.has(s.href)) continue;
  hubByHref.set(s.href, {
    __href: s.href,
    icon: '🗂️',
    h1: s.silo,
    description: `Todas las calculadoras de ${s.silo.toLowerCase()} en un solo lugar.`,
  });
}

const relatedCalcs = (post.relatedCalcs || [])
  .map((s: string) => (s.startsWith('/') ? hubByHref.get(s) : calcBySlug.get(s)))
  .filter(Boolean);

// Un relacionado que no resuelve es un link perdido, no un detalle cosmético:
// así fue como se cayeron los 177 sin que nadie se enterara. El build falla.
const unresolvedRelated = (post.relatedCalcs || []).filter(
  (s: string) => !(s.startsWith('/') ? hubByHref.has(s) : calcBySlug.has(s)),
);
if (unresolvedRelated.length > 0) {
  throw new Error(
    `[blog/${post.slug}] relatedCalcs sin destino: ${unresolvedRelated.join(', ')}. ` +
      `Apuntá al hub que absorbió esa calc (ruta con '/' inicial).`,
  );
}

// ─── Category labels ─────────────────────────────────────────────────────────
const categoryLabels: Record<string, string> = {
  finanzas: 'Finanzas',
  fiscal: 'Impuestos',
  economia: 'Economía',
  negocios: 'Negocios',
  negocio: 'Negocios',
  salud: 'Salud',
  marketing: 'Marketing',
  deportes: 'Deportes',
  viajes: 'Viajes',
  vida: 'Vida cotidiana',
  hogar: 'Hogar',
  mascotas: 'Mascotas',
  matematica: 'Matemática',
  construccion: 'Construcción',
  cocina: 'Cocina',
  educacion: 'Educación',
  automotor: 'Automotor',
  tecnologia: 'Tecnología',
  'medio-ambiente': 'Medio Ambiente',
  electronica: 'Electrónica',
};

const categoryLabel = categoryLabels[post.category] || post.category;

// ─── Audience / locale ────────────────────────────────────────────────────────
// El blog nació sólo-AR y tenía audience e idioma hardcodeados. Ahora sale del
// post para poder publicar notas CO/MX; AR sigue siendo el default, así que los
// posts que no declaran `audience` se comportan igual que antes.
const AUDIENCE_LOCALES: Record<string, string> = { AR: 'es-AR', CO: 'es-CO', MX: 'es-MX' };
const rawAudience = String(post.audience || 'AR').toUpperCase();
const audience = (AUDIENCE_LOCALES[rawAudience] ? rawAudience : 'AR') as 'AR' | 'CO' | 'MX';
const locale = AUDIENCE_LOCALES[audience];

// Los disclaimers YMYL citaban regulación argentina (Ley 26.831 / RG CNV 840/2020)
// y usaban voseo. En una nota CO/MX eso es normativa del país equivocado, así que
// el marco regulatorio y el imperativo se eligen por audiencia.
const ymylCopy = {
  AR: { regulador: ' en inversión (Ley 26.831, RG CNV 840/2020)', consulta: 'consultá', recorda: 'Recordá', registro: 'no es un asesor financiero registrado ante la CNV' },
  CO: { regulador: ' en inversión', consulta: 'consulte', recorda: 'Recuerde', registro: 'no es un asesor financiero vigilado por la Superintendencia Financiera de Colombia' },
  MX: { regulador: ' en inversión', consulta: 'consulta', recorda: 'Recuerda', registro: 'no es un asesor financiero registrado ante la CNBV' },
}[audience];

// ─── Date formatting ──────────────────────────────────────────────────────────
function formatDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
}
const dateFormatted = formatDate(post.date);
const dateISO = new Date(post.date + 'T00:00:00Z').toISOString();
const reviewedRaw = post.updatedDate || post.lastReviewed || post.date;
const reviewedFormatted = formatDate(reviewedRaw);

// ─── Autor a mostrar ──────────────────────────────────────────────────────────
// Los JSON viejos traen author genérico ("Hacé Cuentas", "Equipo editorial…"),
// que no es una persona verificable. Para E-E-A-T mostramos siempre una persona
// real: el author guardado si es una persona, o "Martín Rodríguez" por defecto.
const rawAuthor = (post.author || '').trim();
const displayAuthor = (!rawAuthor || /hac[eé] cuentas|equipo/i.test(rawAuthor))
  ? 'Martín Rodríguez'
  : rawAuthor;
const authorInitials = displayAuthor
  .split(/\s+/)
  .map((w: string) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();

// ─── TOC: parse h2 headings from HTML content ─────────────────────────────────
interface TocItem { id: string; text: string }
function buildToc(html: string): TocItem[] {
  const toc: TocItem[] = [];
  const re = /<h2[^>]*>(.*?)<\/h2>/gi;
  let match: RegExpExecArray | null;
  while ((match = re.exec(html)) !== null) {
    const rawText = match[1].replace(/<[^>]+>/g, '').trim();
    const id = rawText
      .toLowerCase()
      .normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .slice(0, 80);
    toc.push({ id, text: rawText });
  }
  return toc;
}

// Inject IDs into h2 tags in content so anchor links work (skips h2 que ya traen id)
function injectH2Ids(html: string, toc: TocItem[]): string {
  let idx = 0;
  return html.replace(/<h2([^>]*)>/gi, (_match: string, attrs: string) => {
    const item = toc[idx++];
    if (!item) return `<h2${attrs}>`;
    if (/\bid=/.test(attrs)) return `<h2${attrs}>`;
    return `<h2${attrs} id="${item.id}">`;
  });
}

const autoToc = buildToc(post.content || '');
const contentWithIds = injectH2Ids(post.content || '', autoToc);

// TOC mostrado: preferimos el campo tableOfContents (títulos limpios + anchors
// que ya matchean los id del contenido). Si no existe, caemos al parseo de H2.
const tocItems: TocItem[] = (post.tableOfContents && post.tableOfContents.length)
  ? post.tableOfContents.map((t: any) => ({ id: t.anchor, text: t.title }))
  : autoToc;

// ─── Datos de marca / mockup ─────────────────────────────────────────────────
const kickerStatus = /^(informe|actualizacion|novedades|noticias)/i.test(post.slug)
  ? 'Informe'
  : 'Guía actualizada';

const keyFacts: Array<{ label: string; value: string }> = post.keyFacts || [];
const keyTakeaways: string[] = post.keyTakeaways || [];
const sources: Array<{ title: string; url: string }> = post.sources || [];
const verified = sources.length > 0;

// ─── CTAs a la calculadora principal ──────────────────────────────────────────
const primaryCalc: any = relatedCalcs[0];
const cleanCalcName = (c: any) => String(c?.h1 || c?.title || '').split('|')[0].trim();
const calcCta = {
  eyebrow: post.calcCta?.eyebrow || 'Calculadora recomendada',
  title: post.calcCta?.title || (primaryCalc ? cleanCalcName(primaryCalc) : ''),
  desc: post.calcCta?.desc
    || (primaryCalc?.description ? String(primaryCalc.description).split('|')[0].trim().slice(0, 150) : ''),
  label: post.calcCta?.label || 'Usar la calculadora',
};
const sidebarCta = {
  title: post.sidebarCta?.title || '¿Necesitás el número exacto?',
  desc: post.sidebarCta?.desc || 'Hacé el cálculo gratis con tus propios datos.',
  label: post.sidebarCta?.label || 'Calcular ahora',
};
const answerCtaLabel = post.answerCtaLabel || 'Ir a la calculadora';

// ─── Inyección de bloques de marca en el cuerpo ───────────────────────────────
// "Lo esencial, en 30 segundos" (keyTakeaways) tras el 1er párrafo, y la tarjeta
// violeta de la calculadora justo antes del primer H2 — como en el mockup.
const summaryHtml = keyTakeaways.length
  ? `<aside class="hc-summary" role="note">`
    + `<div class="hc-summary__head"><span class="hc-summary__icon" aria-hidden="true">+</span>`
    + `<span class="hc-summary__title">Lo esencial, en 30 segundos</span></div>`
    + `<ul class="hc-summary__list">`
    + keyTakeaways.map((t) => `<li>${t}</li>`).join('')
    + `</ul></aside>`
  : '';

const calcCardHtml = primaryCalc
  ? `<aside class="hc-calc-cta">`
    + `<div class="hc-calc-cta__body">`
    + `<span class="hc-calc-cta__eyebrow">${calcCta.eyebrow}</span>`
    + `<span class="hc-calc-cta__title">${calcCta.title}</span>`
    + (calcCta.desc ? `<span class="hc-calc-cta__desc">${calcCta.desc}</span>` : '')
    + `<a class="hc-calc-cta__btn" href="${primaryCalc.__href}">${calcCta.label} <span aria-hidden="true">→</span></a>`
    + `</div>`
    + `<span class="hc-calc-cta__glyph" aria-hidden="true">${primaryCalc.icon || '🧮'}</span>`
    + `</aside>`
  : '';

let bodyHtml = contentWithIds;
{
  const h2Pos = bodyHtml.search(/<h2/i);
  const firstPEnd = bodyHtml.indexOf('</p>');
  const inserts: Array<{ pos: number; html: string }> = [];
  if (summaryHtml && firstPEnd !== -1 && (h2Pos === -1 || firstPEnd < h2Pos)) {
    inserts.push({ pos: firstPEnd + 4, html: summaryHtml });
  }
  if (calcCardHtml) {
    inserts.push({ pos: h2Pos !== -1 ? h2Pos : bodyHtml.length, html: calcCardHtml });
  }
  inserts
    .sort((a, b) => b.pos - a.pos)
    .forEach((ins) => {
      bodyHtml = bodyHtml.slice(0, ins.pos) + ins.html + bodyHtml.slice(ins.pos);
    });
}

// ─── Schema.org ──────────────────────────────────────────────────────────────
const isNews = /^(informe|actualizacion|novedades|noticias)/i.test(post.slug) ||
               (post.tags || []).some((t: string) => /news|informe|actualidad/i.test(t));
const articleType = isNews ? 'NewsArticle' : 'BlogPosting';

const articleSchema: any = {
  '@context': 'https://schema.org',
  '@type': articleType,
  headline: post.title,
  description: post.description,
  datePublished: dateISO,
  dateModified: post.updatedDate ? new Date(post.updatedDate + 'T00:00:00Z').toISOString() : dateISO,
  author: displayAuthor === 'Martín Rodríguez' ? {
    '@type': 'Person',
    '@id': `${siteUrl}/autores/martin-rodriguez#person`,
    name: 'Martín Rodríguez',
    url: `${siteUrl}/autores/martin-rodriguez`,
  } : {
    '@type': 'Person',
    name: displayAuthor,
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Hacé Cuentas',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${siteUrl}/blog/${post.slug}`,
  },
  image: [ogImageAbs],
  inLanguage: locale,
  keywords: (post.seoKeywords || []).join(', '),
  articleBody: post.content?.replace(/<[^>]+>/g, '').slice(0, 3000),
  wordCount: post.content?.replace(/<[^>]+>/g, '').split(/\s+/).filter(Boolean).length || 0,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: post.title, item: `${siteUrl}/blog/${post.slug}` },
  ],
};

const faqSchema = post.faq && post.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.faq.map((item: { q: string; a: string }) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    articleSchema,
    breadcrumbSchema,
    ...(faqSchema ? [faqSchema] : []),
  ],
};

const showToc = tocItems.length >= 3;
const showSidebar = showToc || !!primaryCalc;
const isYmylTop = ['finanzas', 'negocios', 'salud', 'familia'].includes(post.category);
const isYmylBottom = ['finanzas', 'negocios'].includes(post.category);
// Breadcrumb corto: último crumb = categoría (como en el mockup), no el título largo.
---

<Layout
  title={post.title}
  description={post.description}
  canonical={`/blog/${post.slug}`}
  schema={pageSchema}
  image={ogImage}
  ogTitle={post.ogTitle}
  noindex={post.noindex === true}
  noAds={post.noindex === true || post.adsenseEligible === false}
  audience={audience}
  ogType="article"
  articleAuthor={displayAuthor}
  articleSection={categoryLabel}
  articleTags={post.tags || post.seoKeywords || []}
  articlePublishedTime={dateISO}
  articleModifiedTime={post.updatedDate ? new Date(post.updatedDate + 'T00:00:00Z').toISOString() : dateISO}
  newsKeywords={isNews ? (post.seoKeywords || post.tags || []) : undefined}
  domain="knowledge"
>
  <Header slot="header" />

  <div class="bp">

    <!-- Breadcrumbs -->
    <nav class="bp-crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li aria-hidden="true" class="sep">›</li>
        <li><a href="/blog">Blog</a></li>
        <li aria-hidden="true" class="sep">›</li>
        <li aria-current="page">{categoryLabel}</li>
      </ol>
    </nav>

    <!-- Hero -->
    <header class="bp-hero">
      <p class="bp-kicker">
        <span class="bp-kicker__cat">{categoryLabel}</span>
        <span class="bp-kicker__dot" aria-hidden="true">·</span>
        <span class="bp-kicker__status">{kickerStatus}</span>
      </p>
      <h1 class="bp-title">{post.h1 || String(post.title).split('|')[0].trim()}</h1>
      <p class="bp-sub">{post.lead || post.description}</p>
      <div class="bp-byline">
        <span class="bp-avatar" aria-hidden="true">{authorInitials}</span>
        <div class="bp-byline__text">
          {displayAuthor === 'Martín Rodríguez' ? (
            <a href="/autores/martin-rodriguez" rel="author" class="bp-byline__author">{displayAuthor}</a>
          ) : (
            <span class="bp-byline__author">{displayAuthor}</span>
          )}
          <div class="bp-byline__meta">
            <time datetime={dateISO}>{dateFormatted}</time>
            <span class="bp-byline__dot" aria-hidden="true">·</span>
            <span>{post.readingTime} min</span>
            {verified && (
              <>
                <span class="bp-byline__dot" aria-hidden="true">·</span>
                <span class="bp-verified">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Verificado con fuentes oficiales
                </span>
              </>
            )}
          </div>
        </div>
      </div>
    </header>

    {inlineHeroImage && inlineHeroImageSmall && (
      <figure class="bp-hero-media">
        <img
          src={inlineHeroImage}
          srcset={`${inlineHeroImageSmall} 720w, ${inlineHeroImage} 1200w`}
          sizes="(max-width: 760px) calc(100vw - 2rem), 820px"
          alt={post.heroImageAlt || post.h1 || String(post.title).split('|')[0].trim()}
          width="1200"
          height="675"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}

    <!-- Answer bar (respuesta corta + CTA) -->
    {keyFacts.length > 0 && (
      <div class="bp-answer">
        <div class="bp-answer__facts">
          {keyFacts.map((f) => (
            <div class="bp-fact">
              <span class="bp-fact__label">{f.label}</span>
              <span class="bp-fact__value">{f.value}</span>
            </div>
          ))}
        </div>
        {primaryCalc && (
          <a class="bp-answer__cta" href={primaryCalc.__href}>
            {answerCtaLabel} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    )}

    <div class={`bp-grid${showSidebar ? '' : ' bp-grid--full'}`}>

      <!-- Main column -->
      <article class="bp-main">

        <!-- TOC mobile -->
        {showToc && (
          <nav class="bp-toc-mobile" aria-label="Tabla de contenidos">
            <details>
              <summary>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                En este artículo
              </summary>
              <ol class="bp-toc__list">
                {tocItems.map((item) => (
                  <li><a href={`#${item.id}`}>{item.text}</a></li>
                ))}
              </ol>
            </details>
          </nav>
        )}

        <!-- Disclaimer YMYL -->
        {isYmylTop && (
          <aside class="bp-disclaimer" role="note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <p>
              <strong>Información educativa, no asesoramiento profesional.</strong> Este artículo es contenido periodístico basado en fuentes públicas. No constituye asesoramiento {post.category === 'salud' ? 'médico' : `financiero${ymylCopy.regulador} ni contable`}. Para decisiones importantes {ymylCopy.consulta} con un/a {post.category === 'salud' ? 'profesional de la salud matriculado/a' : 'contador/a o asesor/a financiero/a matriculado/a'}. <a href="/aviso-legal">Leer aviso legal</a>.
            </p>
          </aside>
        )}

        <!-- Article body (con bloques de marca inyectados) -->
        <div class="bp-body prose" set:html={bodyHtml} />

        {isYmylBottom && (
          <aside class="bp-disclaimer bp-disclaimer--bottom" role="note">
            <p><strong>📌 {ymylCopy.recorda}:</strong> Hacé Cuentas {ymylCopy.registro}. Este contenido es educativo y no sustituye el consejo profesional. Las decisiones de inversión implican riesgo de pérdida de capital y deben tomarse consultando con un profesional matriculado.</p>
          </aside>
        )}

        <!-- Fuentes oficiales -->
        {sources.length > 0 && (
          <section class="bp-sources">
            <p class="bp-eyebrow">Transparencia editorial</p>
            <h2 class="bp-sources__title">Fuentes oficiales</h2>
            <p class="bp-sources__desc">Última revisión editorial: {reviewedFormatted}. Contrastamos montos y procedimiento con documentación pública.</p>
            <div class="bp-sources__list">
              {sources.map((s) => (
                <a class="bp-source" href={s.url} target="_blank" rel="noopener nofollow">
                  <span class="bp-source__title">{s.title}</span>
                  <svg class="bp-source__ico" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- FAQ -->
        {post.faq && post.faq.length > 0 && (
          <section class="bp-faq">
            <h2 class="bp-faq__title">Preguntas frecuentes</h2>
            <div class="bp-faq__list">
              {post.faq.map((item: { q: string; a: string }, i: number) => (
                <details class="bp-faq__item" open={i === 0}>
                  <summary class="bp-faq__q">
                    <span>{item.q}</span>
                    <svg class="bp-faq__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                  </summary>
                  <div class="bp-faq__a">{item.a}</div>
                </details>
              ))}
            </div>
          </section>
        )}

        <PreferredSourceCta lang="es" />

      </article>

      <!-- Sidebar -->
      {showSidebar && (
        <aside class="bp-side" aria-label="Recursos del artículo">
          <div class="bp-side__sticky">
            {showToc && (
              <nav class="bp-toc" aria-label="Tabla de contenidos">
                <div class="bp-toc__head">
                  <span class="bp-eyebrow">En este artículo</span>
                  <span class="bp-toc__pct" aria-hidden="true">0%</span>
                </div>
                <ol class="bp-toc__list">
                  {tocItems.map((item) => (
                    <li><a href={`#${item.id}`}>{item.text}</a></li>
                  ))}
                </ol>
              </nav>
            )}
            {primaryCalc && (
              <div class="bp-side-cta">
                <p class="bp-side-cta__title">{sidebarCta.title}</p>
                <p class="bp-side-cta__desc">{sidebarCta.desc}</p>
                <a class="bp-side-cta__btn" href={primaryCalc.__href}>{sidebarCta.label} <span aria-hidden="true">→</span></a>
                <p class="bp-side-cta__note">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Contenido revisado y actualizado con información oficial
                </p>
              </div>
            )}
          </div>
        </aside>
      )}

    </div><!-- /bp-grid -->

    <!-- Calculadoras relacionadas -->
    {relatedCalcs.length > 0 && (
      <section class="bp-related">
        <p class="bp-eyebrow">Seguí haciendo cuentas</p>
        <h2 class="bp-related__title">Calculadoras relacionadas</h2>
        <div class="bp-related__grid">
          {relatedCalcs.slice(0, 3).map((calc: any) => (
            <a href={calc.__href} class="bp-calc-card">
              <span class="bp-calc-card__icon" aria-hidden="true">{calc.icon || '🧮'}</span>
              <span class="bp-calc-card__title">{cleanCalcName(calc)}</span>
              {calc.description && (
                <span class="bp-calc-card__desc">{String(calc.description).split('|')[0].trim().slice(0, 90)}</span>
              )}
              <span class="bp-calc-card__link">Calcular ahora <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Newsletter -->
    <section class="bp-news" data-nosnippet aria-labelledby="bp-news-title">
      <div class="bp-news__text">
        <h2 id="bp-news-title" class="bp-news__title">Cuando cambie un número clave, te avisamos.</h2>
        <p class="bp-news__sub">Monotributo, dólar, sueldos y vencimientos. Dos minutos, cero spam.</p>
      </div>
      <form class="bp-news__form" id="bp-news-form" novalidate>
        <label class="bp-sr" for="bp-news-email">Tu email</label>
        <input type="email" id="bp-news-email" name="email" placeholder="tu@email.com" required autocomplete="email" aria-describedby="bp-news-msg" />
        <button type="submit" class="bp-news__btn">Quiero recibirlo</button>
        <p class="bp-news__msg" id="bp-news-msg" role="status" aria-live="polite" hidden></p>
      </form>
    </section>

  </div><!-- /bp -->

  <Footer slot="footer" />
</Layout>

<script>
  // ── TOC: highlight de la sección activa + % de lectura ──────────────────────
  (function () {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.bp-toc a, .bp-toc-mobile a');
    const headings = Array.from(document.querySelectorAll<HTMLElement>('.bp-body h2[id]'));
    const pct = document.querySelector<HTMLElement>('.bp-toc__pct');
    const main = document.querySelector<HTMLElement>('.bp-main');

    if (tocLinks.length && headings.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute('id');
              tocLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${id}`));
              break;
            }
          }
        },
        { rootMargin: '0px 0px -70% 0px', threshold: 0 }
      );
      headings.forEach((h) => observer.observe(h));
    }

    // % de lectura del artículo (como en el mockup)
    if (pct && main) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = main.getBoundingClientRect();
        const vh = window.innerHeight;
        const total = rect.height - vh;
        const scrolled = -rect.top;
        const p = total > 0 ? Math.min(100, Math.max(0, Math.round((scrolled / total) * 100))) : (rect.top < vh ? 100 : 0);
        pct.textContent = p + '%';
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    }
  })();

  // ── Newsletter inline (mismo endpoint que el componente global) ─────────────
  (window.requestIdleCallback || function (fn: any) { return setTimeout(fn, 1); })(function () {
    const form = document.getElementById('bp-news-form') as HTMLFormElement | null;
    const msg = document.getElementById('bp-news-msg') as HTMLElement | null;
    if (!form || !msg) return;
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const input = form.querySelector('input[type="email"]') as HTMLInputElement | null;
      const email = input ? input.value.trim() : '';
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (!email || !/^[^@]+@[^@]+\.[^@]+$/.test(email)) {
        msg.hidden = false; msg.textContent = 'Ingresá un email válido.'; msg.className = 'bp-news__msg bp-news__msg--err';
        return;
      }
      if (btn) btn.disabled = true;
      msg.hidden = false; msg.textContent = 'Guardando…'; msg.className = 'bp-news__msg';
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, source: 'blog' }),
        });
        if (res.ok) {
          msg.textContent = '¡Listo! Quedás suscripto.'; msg.className = 'bp-news__msg bp-news__msg--ok';
          if (input) input.value = '';
          if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'newsletter_signup', { method: 'blog' });
        } else {
          const j = await res.json().catch(() => ({}));
          msg.textContent = j.error || 'No se pudo guardar, intentá en un rato.'; msg.className = 'bp-news__msg bp-news__msg--err';
        }
      } catch (err) {
        msg.textContent = 'Error de red. Revisá tu conexión.'; msg.className = 'bp-news__msg bp-news__msg--err';
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  });
</script>

<style>
