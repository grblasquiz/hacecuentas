---
/**
 * Hub de decisión — "Mundial 2026: cupos, premios y récords".
 * Reemplaza 14 URLs de calculadora suelta (ver hub.replaces).
 *
 * Arquetipo cálculo dominante: sin `cases`, la respuesta fija va en hub.answer.
 * La página sólo aporta datos (src/lib/hubs/mundial-2026.ts) y su compute().
 *
 * El torneo ya se jugó (final 19-jul-2026), así que el compute() no proyecta
 * nada del Mundial: informa cupos y premios ya repartidos, y calcula lo único
 * que sigue abierto, los cupos a las copas de clubes.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  CONFEDERACIONES,
  PLAZAS,
  PREMIO_FASE,
  BONUS_PREPARACION,
  REPARTO_FEDERACION,
  PLANTEL,
  BONUS_BASE_FEDERACION,
  BONUS_POR_TITULARIDAD,
} from '../../lib/hubs/mundial-2026';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    CONFEDERACIONES,
    PLAZAS,
    PREMIO_FASE,
    BONUS_PREPARACION,
    REPARTO_FEDERACION,
    PLANTEL,
    BONUS_BASE_FEDERACION,
    BONUS_POR_TITULARIDAD,
  }}
>
  (function () {
    const H = window.HC_HUB;

    // Acá NO hay pesos: cupos, dólares y porcentajes. Cada fila declara su formato.
    const CUPOS = { format: 'unit', unit: 'cupos', decimals: 0 };
    const USD = { format: 'unit', unit: 'USD', decimals: 0 };
    const PCT = { format: 'unit', unit: '%', decimals: 1 };
    const dec1 = (n) => (Math.round(n * 10) / 10).toFixed(1).replace('.', ',');

    /** Cupos del país a la copa elegida + en qué instancia entra el club. */
    function copaDeClubes(copa, paisConmebol, rankingUefa, pos) {
      if (copa === 'libertadores') {
        const grande = paisConmebol === 'argentina' || paisConmebol === 'brasil';
        const cupos = grande ? 8 : 4;
        const directos = grande ? 6 : 1;
        let fase;
        if (grande) fase = pos <= 6 ? 'fase de grupos' : pos <= 8 ? 'fase previa' : 'sin cupo';
        else fase = pos === 1 ? 'fase de grupos' : pos <= 4 ? 'fase previa' : 'sin cupo';
        return { nombre: 'Copa Libertadores', cupos: cupos, directos: directos, fase: fase };
      }
      if (copa === 'sudamericana') {
        const grande = paisConmebol === 'argentina' || paisConmebol === 'brasil';
        const cupos = grande ? 6 : 4;
        let fase;
        if (grande) {
          if (pos <= 8) fase = 'no la necesita: con esa posición va a la Libertadores';
          else if (pos <= 12) fase = 'fase de grupos';
          else if (pos <= 14) fase = 'fase previa';
          else fase = 'sin cupo';
        } else {
          fase = pos >= 2 && pos <= 5 ? 'fase de grupos' : pos === 1 ? 'no la necesita: el campeón va a la Libertadores' : 'sin cupo';
        }
        return { nombre: 'Copa Sudamericana', cupos: cupos, directos: cupos, fase: fase };
      }
      if (copa === 'champions') {
        const r = Math.max(1, Math.min(55, rankingUefa || 20));
        const cupos = r <= 4 ? 4 : r === 5 ? 3 : r <= 15 ? 2 : 1;
        let fase;
        if (pos <= cupos) fase = 'fase de liga (36 equipos)';
        else if (r <= 5 && pos === cupos + 1) fase = 'playoff de acceso (Champions Path)';
        else fase = 'sin cupo: cae a Europa o Conference League';
        return { nombre: 'UEFA Champions League', cupos: cupos, directos: cupos, fase: fase };
      }
      const r = Math.max(1, Math.min(55, rankingUefa || 20));
      const cupos = r <= 4 ? 2 : 1;
      let fase;
      if (r <= 4 && (pos === 3 || pos === 5)) fase = 'fase de liga';
      else if (r >= 5 && r <= 15 && pos >= 3 && pos <= 4) fase = 'fase previa';
      else fase = 'sin cupo: puede quedar la Conference League';
      return { nombre: 'UEFA Europa League', cupos: cupos, directos: cupos, fase: fase };
    }

    H.onCompute(function (v) {
      const conf = CONFEDERACIONES[String(v.confederacion || 'CONMEBOL')] || CONFEDERACIONES.CONMEBOL;
      const faseKey = String(v.fase || 'cuartos');
      const fase = PREMIO_FASE[faseKey] || PREMIO_FASE.cuartos;
      const fed = REPARTO_FEDERACION[String(v.federacion || 'argentina')] || REPARTO_FEDERACION.otra;
      const titulares = Math.max(0, Math.min(8, Math.round(v.titulares || 0)));

      // ── Mundial 2026: cupos ya repartidos (torneo jugado, nada se proyecta) ──
      const totalPotencial = conf.directos + conf.repechaje;
      const pesoSobre48 = (conf.directos / PLAZAS.total) * 100;

      // ── Premio FIFA de la fase alcanzada y lo que llegó al jugador ──
      const premioFederacion = fase.usd + BONUS_PREPARACION;
      const bolsaPlantel = fase.usd * fed.pct;
      const porJugadorFifa = Math.round(bolsaPlantel / PLANTEL);
      const bonusFederacion = BONUS_BASE_FEDERACION + titulares * BONUS_POR_TITULARIDAD;
      const totalJugador = porJugadorFifa + bonusFederacion;

      // ── Lo único que sigue abierto: los cupos de las copas de clubes ──
      const copa = copaDeClubes(
        String(v.copa || 'libertadores'),
        String(v.paisConmebol || 'argentina'),
        Math.round(v.rankingUefa || 5),
        Math.max(1, Math.round(v.posicionLiga || 4))
      );

      const rows = [
        Object.assign({ k: 'Plazas directas de ' + conf.label + ' en el Mundial 2026', ref: 'FIFA Council', v: conf.directos }, CUPOS),
        Object.assign({ k: 'Selecciones que mandó al repechaje intercontinental', ref: 'FIFA', v: conf.repechaje }, CUPOS),
        Object.assign({ k: 'Máximo potencial de ' + conf.label + ' en el torneo', v: totalPotencial, extra: true }, CUPOS),
        Object.assign({ k: 'Plazas totales del Mundial 2026', ref: '48 selecciones', v: PLAZAS.total }, CUPOS),
        Object.assign({ k: 'Premio FIFA a la federación por la fase alcanzada', ref: fase.label, v: fase.usd }, USD),
        Object.assign({ k: 'Aporte FIFA por preparación', ref: 'flat por selección', v: BONUS_PREPARACION }, USD),
        Object.assign({ k: 'Total que cobró la federación', v: premioFederacion, extra: true }, USD),
        Object.assign({ k: 'Reparto FIFA por jugador (plantel de ' + PLANTEL + ')', ref: fed.label + ' ~' + Math.round(fed.pct * 100) + '%', v: porJugadorFifa }, USD),
        Object.assign({ k: 'Bonus de federación por ' + titulares + ' partido(s) de titular', v: bonusFederacion }, USD),
        Object.assign({ k: 'Total estimado por jugador', v: totalJugador, extra: true }, USD),
        Object.assign({ k: 'Cupos del país a la ' + copa.nombre, ref: 'reglamento vigente', v: copa.cupos }, CUPOS),
        Object.assign({ k: 'Peso de ' + conf.label + ' sobre las 48 plazas', v: Number(pesoSobre48.toFixed(1)) }, PCT),
      ];

      // El gráfico compara SIEMPRE las seis confederaciones: es el dato que
      // ninguna calculadora suelta mostraba en una sola vista.
      const orden = ['UEFA', 'CAF', 'AFC', 'CONMEBOL', 'CONCACAF', 'OFC'];
      const chart = orden.map(function (k) {
        return {
          label: CONFEDERACIONES[k].label + ' — ' + CONFEDERACIONES[k].directos,
          value: CONFEDERACIONES[k].directos,
          tone: k === conf.label ? 'main' : 'prop',
        };
      });

      const usd = (n) => 'USD ' + Math.round(n).toLocaleString('es-AR');

      return {
        total: totalPotencial + ' cupos',
        sub:
          conf.label + ': ' + conf.directos + ' plazas directas sobre 48 (' + dec1(pesoSobre48) + '%)' +
          (conf.repechaje > 0 ? ' + ' + conf.repechaje + ' al repechaje' : ', sin repechaje') +
          ' · ' + fase.label.toLowerCase() + ' cobró ' + usd(fase.usd) +
          ' y a cada jugador le quedaron ~' + usd(totalJugador) +
          ' · ' + copa.nombre + ': ' + copa.cupos + ' cupos del país, tu club entra en ' + copa.fase,
        rows: rows,
        chart: chart,
        // Default del resultado: cupos. Cada fila de plata pisa el formato.
        format: 'unit',
        unit: 'cupos',
        decimals: 0,
      };
    });
  })();
</script>
