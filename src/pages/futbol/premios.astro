---
/**
 * Hub de decisión — "¿Cuánto se lleva de premio cada equipo?"
 * Reemplaza 8 URLs de calculadora suelta (ver hub.replaces).
 *
 * OJO: el Mundial 2026 ya se jugó (11-jun a 19-jul de 2026, campeón España).
 * Todo el copy va en pasado. Los premios por fase son los que publicó la FIFA
 * para 2026 (campeón USD 50 M), no los de Qatar 2022 (USD 42 M).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import {
  hub,
  PREMIO_MUNDIAL_2026,
  LABEL_MUNDIAL_2026,
  FIJO_CLASIFICACION,
  FIJO_PREPARACION,
  PREMIO_COPA_ARGENTINA,
  ORDEN_COPA_ARGENTINA,
  LABEL_COPA_ARGENTINA,
  LPF_VICTORIA,
  LPF_EMPATE,
  LPF_CAMPEON,
  LPF_SUBCAMPEON,
  DERECHOS_TV,
  PARTIDOS_MUNDIAL_2026,
  NIVELES_CLAUSULA,
  SOLIDARIDAD_PCT_12_15,
  SOLIDARIDAD_PCT_16_23,
  SOLIDARIDAD_POOL_PCT,
} from '../../lib/hubs/premios-futbol';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const CONST = {
  MUNDIAL: PREMIO_MUNDIAL_2026,
  MUNDIAL_LABEL: LABEL_MUNDIAL_2026,
  FIJO_CLAS: FIJO_CLASIFICACION,
  FIJO_PREP: FIJO_PREPARACION,
  CA: PREMIO_COPA_ARGENTINA,
  CA_ORDEN: ORDEN_COPA_ARGENTINA,
  CA_LABEL: LABEL_COPA_ARGENTINA,
  LPF_VIC: LPF_VICTORIA,
  LPF_EMP: LPF_EMPATE,
  LPF_CAMP: LPF_CAMPEON,
  LPF_SUB: LPF_SUBCAMPEON,
  TV: DERECHOS_TV,
  PARTIDOS: PARTIDOS_MUNDIAL_2026,
  NIVELES: NIVELES_CLAUSULA,
  SOL12: SOLIDARIDAD_PCT_12_15,
  SOL16: SOLIDARIDAD_PCT_16_23,
  SOL_POOL: SOLIDARIDAD_POOL_PCT,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ C: CONST }}>
  (function () {
    const H = window.HC_HUB;

    function nf(n, d) {
      return Number(n || 0).toLocaleString('es-AR', {
        minimumFractionDigits: d || 0,
        maximumFractionDigits: d || 0,
      });
    }
    function money(n, moneda) {
      return moneda + ' ' + nf(n);
    }

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'mundial';

      // --- Mundial 2026 (torneo ya jugado) -----------------------------------
      if (id === 'mundial') {
        const fase = String(v.fase || 'campeon');
        const premio = C.MUNDIAL[fase] || C.MUNDIAL.grupos;
        const fijo = C.FIJO_CLAS + C.FIJO_PREP;
        const total = premio + fijo;
        return {
          total: money(total, 'US$'),
          sub:
            'Una selección ' + C.MUNDIAL_LABEL[fase] + ' cobró ' + money(premio, 'US$') +
            ' de premio por rendimiento más ' + money(fijo, 'US$') + ' fijos. La plata entró a la federación.',
          format: 'unit',
          unit: 'USD',
          rows: [
            { k: 'Premio por rendimiento', ref: 'FIFA 2026', v: premio, format: 'unit', unit: 'USD', extra: true },
            { k: 'Fondo de clasificación', v: C.FIJO_CLAS, format: 'unit', unit: 'USD' },
            { k: 'Fondo de preparación', v: C.FIJO_PREP, format: 'unit', unit: 'USD' },
            { k: 'Total que cobró la federación', v: total, format: 'unit', unit: 'USD' },
            { k: 'Diferencia contra el premio de grupos', v: premio - C.MUNDIAL.grupos, format: 'unit', unit: 'USD' },
          ],
          chart: [
            { label: 'Premio por rendimiento', value: premio, tone: 'main' },
            { label: 'Clasificación y preparación', value: fijo, tone: 'prop' },
          ],
        };
      }

      // --- Copa Argentina ----------------------------------------------------
      // Espejo de src/lib/formulas/premios-copa-argentina.ts: los premios se
      // acumulan desde la ronda de ingreso hasta la ronda alcanzada, y el
      // campeón no cobra además el premio de "final".
      if (id === 'copa-argentina') {
        const ronda = String(v.ronda || 'cuartos');
        const entro = String(v.entro || 't16');
        const iFin = C.CA_ORDEN.indexOf(ronda);
        const iIni = Math.max(0, C.CA_ORDEN.indexOf(entro));
        const rows = [];
        let acumuladoPrevio = 0;
        let premioRonda = 0;
        for (let i = iIni; i <= iFin; i++) {
          const r = C.CA_ORDEN[i];
          if (r === 'final' && ronda === 'campeon') continue;
          rows.push({ k: C.CA_LABEL[r], v: C.CA[r], extra: i === iFin });
          if (i === iFin) premioRonda = C.CA[r];
          else acumuladoPrevio += C.CA[r];
        }
        const total = acumuladoPrevio + premioRonda;
        return {
          total: '$' + nf(total),
          sub:
            'Entró en ' + C.CA_LABEL[entro].toLowerCase() + ' y llegó a ' + C.CA_LABEL[ronda].toLowerCase() +
            ': se lleva la suma de todas las rondas que superó' +
            (ronda === 'campeon' ? ', más el cupo a la Copa Libertadores.' : '.'),
          rows: rows,
          chart: [
            { label: 'Rondas previas', value: acumuladoPrevio, tone: 'prop' },
            { label: 'Ronda alcanzada', value: premioRonda, tone: 'main' },
          ],
        };
      }

      // --- Liga Profesional --------------------------------------------------
      // Espejo de src/lib/formulas/premios-liga-profesional-afa.ts
      if (id === 'liga') {
        const ganados = Math.max(0, Math.round(v.ganados) || 0);
        const empatados = Math.max(0, Math.round(v.empatados) || 0);
        const plantel = Math.max(1, Math.round(v.plantel) || 1);
        const titulo = String(v.titulo || 'ninguno');
        const porVictorias = ganados * C.LPF_VIC;
        const porEmpates = empatados * C.LPF_EMP;
        const bono = titulo === 'campeon' ? C.LPF_CAMP : titulo === 'subcampeon' ? C.LPF_SUB : 0;
        const total = porVictorias + porEmpates + bono;
        const porJugador = total / plantel;
        const rows = [
          { k: ganados + ' victorias × $' + nf(C.LPF_VIC), v: porVictorias },
          { k: empatados + ' empates × $' + nf(C.LPF_EMP), v: porEmpates },
        ];
        if (bono > 0) rows.push({ k: titulo === 'campeon' ? 'Bono de campeón' : 'Bono de subcampeón', v: bono });
        rows.push({ k: 'Bolsa total del plantel', v: total, extra: true });
        rows.push({ k: 'Por jugador, repartiendo entre ' + plantel, v: porJugador });
        const chart = [
          { label: 'Premios por victorias', value: porVictorias, tone: 'main' },
          { label: 'Premios por empates', value: porEmpates, tone: 'exit' },
        ];
        if (bono > 0) chart.push({ label: 'Bono de título', value: bono, tone: 'prop' });
        return {
          total: '$' + nf(total),
          sub:
            'Bolsa del plantel por ' + ganados + ' victorias y ' + empatados + ' empates' +
            (bono > 0 ? (titulo === 'campeon' ? ', más el bono de campeón' : ', más el bono de subcampeón') : '') +
            ' · $' + nf(porJugador) + ' por jugador.',
          rows: rows,
          chart: chart,
        };
      }

      // --- Derechos de TV ----------------------------------------------------
      // Espejo de src/lib/formulas/derechos-tv-mundial-2026.ts
      if (id === 'derechos-tv') {
        const info = C.TV[String(v.pais)] || C.TV.ar;
        const anual = info.anual;
        const porPartido = anual / C.PARTIDOS;
        const perCapita = anual / (info.poblMill * 1000000);
        // El formato de 48 selecciones tuvo 72 partidos de grupos y 32 de eliminatoria.
        const grupos = porPartido * 72;
        const eliminatoria = porPartido * 32;
        return {
          total: money(anual, info.moneda),
          sub:
            info.pais + ': unos ' + nf(anual / 1000000) + ' millones de ' + info.moneda +
            ' por año de contrato · ' + money(Math.round(porPartido), info.moneda) + ' por cada uno de los ' +
            C.PARTIDOS + ' partidos.',
          format: 'unit',
          unit: info.moneda,
          rows: [
            { k: 'Costo anual de los derechos', v: anual, format: 'unit', unit: info.moneda, extra: true },
            { k: 'Partidos del Mundial 2026', v: C.PARTIDOS, format: 'plain' },
            { k: 'Costo por partido', v: porPartido, format: 'unit', unit: info.moneda },
            { k: 'Población del mercado', v: info.poblMill, format: 'unit', unit: 'millones', decimals: 1 },
            { k: 'Costo por habitante', v: perCapita, format: 'unit', unit: info.moneda, decimals: 2 },
          ],
          chart: [
            { label: 'Fase de grupos (72 partidos)', value: grupos, tone: 'main' },
            { label: 'Eliminatoria (32 partidos)', value: eliminatoria, tone: 'exit' },
          ],
        };
      }

      // --- Cláusula de rescisión ---------------------------------------------
      // Espejo de src/lib/formulas/clausula-rescision-valor.ts
      if (id === 'clausula') {
        const valor = Math.max(0, v.monto || 0);
        const anos = Math.max(1, Math.round(v.anosContrato) || 1);
        const nivel = C.NIVELES[String(v.nivel)] || C.NIVELES.estrella;
        const factor = anos >= 4 ? 1 : anos === 3 ? 0.9 : anos === 2 ? 0.75 : 0.55;
        const min = valor * nivel.min * factor;
        const max = valor * nivel.max * factor;
        const rec = (min + max) / 2;
        const prima = Math.max(0, rec - valor);
        return {
          total: money(Math.round(rec), '€'),
          sub:
            nivel.label + ' con ' + anos + (anos === 1 ? ' año' : ' años') + ' de contrato: rango de ' +
            money(Math.round(min), '€') + ' a ' + money(Math.round(max), '€') +
            (factor < 1 ? ' · ajustado ×' + factor + ' por el contrato corto.' : '.'),
          format: 'unit',
          unit: 'EUR',
          rows: [
            { k: 'Valor de mercado', v: valor, format: 'unit', unit: 'EUR' },
            { k: 'Piso del rango', ref: '×' + nivel.min, v: min, format: 'unit', unit: 'EUR' },
            { k: 'Cláusula recomendada', v: rec, format: 'unit', unit: 'EUR', extra: true },
            { k: 'Techo del rango', ref: '×' + nivel.max, v: max, format: 'unit', unit: 'EUR' },
            { k: 'Ajuste por años de contrato', v: factor * 100, format: 'unit', unit: '%' },
            { k: 'Prima sobre el valor de mercado', v: prima, format: 'unit', unit: 'EUR' },
          ],
          chart: [
            { label: 'Valor de mercado', value: valor, tone: 'main' },
            { label: 'Prima de la cláusula', value: prima, tone: 'prop' },
          ],
        };
      }

      // --- Mecanismo de solidaridad ------------------------------------------
      // Espejo de src/lib/formulas/mecanismo-solidaridad-fifa.ts
      const fee = Math.max(0, v.monto || 0);
      const formado = Math.max(0, Math.min(12, Math.round(v.anosFormado) || 0));
      const anos12 = Math.min(4, formado);
      const anos16 = Math.min(8, Math.max(0, formado - 4));
      const pool = (fee * C.SOL_POOL) / 100;
      const tramo12 = (fee * (anos12 * C.SOL12)) / 100;
      const tramo16 = (fee * (anos16 * C.SOL16)) / 100;
      const club = tramo12 + tramo16;
      const resto = Math.max(0, pool - club);
      return {
        total: money(Math.round(club), '€'),
        sub:
          'Sobre una transferencia de ' + money(fee, '€') + ', el pool de solidaridad es ' +
          money(Math.round(pool), '€') + ' (5%) y a este club le corresponden ' +
          anos12 + ' año(s) del tramo 12-15 y ' + anos16 + ' del tramo 16-23.',
        format: 'unit',
        unit: 'EUR',
        rows: [
          { k: 'Monto de la transferencia', v: fee, format: 'unit', unit: 'EUR' },
          { k: 'Pool de solidaridad', ref: '5% FIFA', v: pool, format: 'unit', unit: 'EUR' },
          { k: 'Tramo 12 a 15 años', ref: anos12 + ' × 0,25%', v: tramo12, format: 'unit', unit: 'EUR' },
          { k: 'Tramo 16 a 23 años', ref: anos16 + ' × 0,5%', v: tramo16, format: 'unit', unit: 'EUR' },
          { k: 'Le corresponde al club formador', v: club, format: 'unit', unit: 'EUR', extra: true },
          { k: 'Resto del pool, para los otros clubes', v: resto, format: 'unit', unit: 'EUR' },
        ],
        chart: [
          { label: 'Tramo 12 a 15 años', value: tramo12, tone: 'main' },
          { label: 'Tramo 16 a 23 años', value: tramo16, tone: 'exit' },
          { label: 'Resto del pool', value: resto, tone: 'prop' },
        ],
      };
    });
  })();
</script>
