---
/**
 * Hub de decisión — "¿Le alcanzan los puntos?".
 * Reemplaza 6 URLs de calculadora suelta (ver hub.replaces).
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DecisionHub from '../../components/hub/DecisionHub.astro';
import { hub, MOTOR, LALIGA_SAFETY, MLS_FECHAS } from '../../lib/hubs/puntos-y-campeonato';

const CANONICAL = `https://hacecuentas.com/${hub.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: hub.silo, item: `https://hacecuentas.com${hub.siloHref}` },
        { '@type': 'ListItem', position: 3, name: hub.h1, item: CANONICAL },
      ],
    },
  ],
};
---

<Layout
  title={hub.title}
  description={hub.description}
  canonical={CANONICAL}
  schema={schema}
  audience={hub.audience}
  lang="es"
  ogType="article"
  articleSection={hub.silo}
>
  <Header />
  <DecisionHub data={hub} />
  <Footer />
</Layout>

<script is:inline define:vars={{ MOTOR, LALIGA_SAFETY, MLS_FECHAS }}>
  (function () {
    const H = window.HC_HUB;
    const n0 = (x) => Math.round(x).toLocaleString('es-AR');
    const n3 = (x) => x.toFixed(3).replace('.', ',');

    H.onCompute(function (v, kase) {
      const id = (kase && kase.id) || 'objetivo';
      const puntos = Math.max(0, Math.round(Number(v.puntos) || 0));
      const restantes = Math.max(0, Math.round(Number(v.restantes) || 0));
      const enJuego = restantes * 3;

      // ── Promedios del fútbol argentino ────────────────────────────────────
      if (id === 'promedios') {
        const p1 = Math.max(0, Number(v.puntosT1) || 0);
        const j1 = Math.max(0, Number(v.partidosT1) || 0);
        const p2 = Math.max(0, Number(v.puntosT2) || 0);
        const j2 = Math.max(0, Number(v.partidosT2) || 0);
        const p3 = puntos;
        const j3 = Math.max(0, Math.round(Number(v.partidosT3) || 0));
        const partidosJugados = j1 + j2 + j3;
        const puntosTotales = p1 + p2 + p3;
        const partidosTotales = partidosJugados + restantes;
        const promedioActual = partidosJugados > 0 ? puntosTotales / partidosJugados : 0;
        const promRival = Math.max(0, Number(v.promedioRival) || 0);

        const necesarios = Math.max(0, Math.ceil(promRival * partidosTotales - puntosTotales));
        const proyGana = (puntosTotales + restantes * 3) / partidosTotales;
        const proyEmpata = (puntosTotales + restantes) / partidosTotales;
        const proyPierde = puntosTotales / partidosTotales;
        const muerto = promRival > 0 && necesarios > restantes * 3;

        return {
          total: n3(promedioActual),
          sub:
            puntosTotales + ' pts en ' + partidosJugados + ' partidos de las últimas tres temporadas · rival ' +
            (promRival ? n3(promRival) : '—') + ' · ' +
            (promRival === 0
              ? 'cargá el promedio del rival directo para comparar'
              : muerto
                ? 'no alcanza: hacen falta ' + necesarios + ' pts y sólo hay ' + restantes * 3 + ' en juego'
                : necesarios === 0
                  ? 'tu promedio ya supera al del rival'
                  : 'te faltan ' + necesarios + ' pts en los ' + restantes + ' partidos que quedan'),
          rows: [
            { k: 'Puntos de las tres temporadas', ref: 'Suma', v: puntosTotales, format: 'plain' },
            { k: 'Partidos jugados en el período', ref: 'Divisor del promedio', v: partidosJugados, format: 'plain' },
            { k: 'Promedio actual', ref: 'Puntos ÷ partidos', v: promedioActual, format: 'plain', decimals: 3, extra: true },
            { k: 'Puntos para igualar al rival', ref: 'Rival estático', v: necesarios, format: 'plain' },
            { k: 'Promedio final ganando todo', ref: '+3 por partido', v: proyGana, format: 'plain', decimals: 3 },
            { k: 'Promedio final empatando todo', ref: '+1 por partido', v: proyEmpata, format: 'plain', decimals: 3 },
            { k: 'Promedio final perdiendo todo', ref: 'Sin sumar', v: proyPierde, format: 'plain', decimals: 3 },
          ],
          format: 'plain',
          decimals: 0,
          chart: [
            { label: 'Puntos que tenés', value: puntosTotales, tone: 'main' },
            { label: 'Puntos que faltan', value: necesarios, tone: muerto ? 'bad' : 'exit' },
            { label: 'Puntos en juego', value: restantes * 3, tone: 'prop' },
          ],
        };
      }

      // ── Permanencia en LaLiga ─────────────────────────────────────────────
      if (id === 'laliga') {
        const pts17 = Math.max(0, Math.round(Number(v.puntosRival) || 0));
        const paraAlcanzar = Math.max(0, pts17 - puntos + 1);
        const maxPosible = puntos + enJuego;
        const empatandoTodo = puntos + restantes;
        const difSafety = puntos - LALIGA_SAFETY;
        const descendido = maxPosible < pts17;

        return {
          total: paraAlcanzar === 0 ? 'Ya estás arriba del 17º' : paraAlcanzar + ' pts',
          sub:
            'Con ' + puntos + ' pts y ' + restantes + (restantes === 1 ? ' fecha' : ' fechas') + ' por jugar · 17º con ' +
            pts17 + ' pts · ' +
            (descendido
              ? 'ni ganando todo lo alcanzás: descenso matemático'
              : (difSafety >= 0 ? '+' : '') + difSafety + ' respecto del umbral histórico de ' + LALIGA_SAFETY + ' pts'),
          rows: [
            { k: 'Puntos actuales', ref: 'Tu dato', v: puntos, format: 'plain' },
            { k: 'Puntos del 17º (último salvado)', ref: 'Tu dato', v: pts17, format: 'plain' },
            { k: 'Puntos para superarlo', ref: 'Diferencia + 1', v: paraAlcanzar, format: 'plain', extra: true },
            { k: 'Máximo alcanzable ganando todo', ref: restantes + ' × 3', v: maxPosible, format: 'plain' },
            { k: 'Proyección empatando todo', ref: restantes + ' × 1', v: empatandoTodo, format: 'plain' },
            { k: 'Umbral histórico de salvación', ref: 'Referencia LaLiga', v: LALIGA_SAFETY, format: 'plain' },
          ],
          format: 'plain',
          chart: [
            { label: 'Puntos que tenés', value: puntos, tone: 'main' },
            { label: 'Puntos que faltan', value: paraAlcanzar, tone: descendido ? 'bad' : 'exit' },
            { label: 'Puntos en juego', value: enJuego, tone: 'prop' },
          ],
        };
      }

      // ── Playoffs de la MLS ────────────────────────────────────────────────
      if (id === 'mls') {
        const pts7 = Math.max(0, Math.round(Number(v.puntosRival) || 0));
        const pts9 = Math.max(0, Math.round(Number(v.puntosNoveno) || 0));
        const paraDirecto = Math.max(0, pts7 - puntos + 1);
        const paraWildCard = Math.max(0, pts9 - puntos + 1);
        const maxPosible = puntos + enJuego;
        const jugadas = Math.max(1, MLS_FECHAS - restantes);
        const esperado = Math.round((puntos / jugadas) * MLS_FECHAS);
        const eliminado = maxPosible < pts9;

        return {
          total: paraDirecto === 0 ? 'Top 7: entrás directo' : paraDirecto + ' pts para el top 7',
          sub:
            'Con ' + puntos + ' pts y ' + restantes + (restantes === 1 ? ' fecha' : ' fechas') + ' por jugar · 7º con ' +
            pts7 + ' · 9º con ' + pts9 + ' · ' +
            (eliminado
              ? 'ni ganando todo llegás al 9º: eliminado'
              : paraWildCard === 0
                ? 'hoy estarías dentro de los nueve clasificados'
                : 'te faltan ' + paraWildCard + ' pts para meterte en el Wild Card'),
          rows: [
            { k: 'Puntos actuales', ref: 'Tu dato', v: puntos, format: 'plain' },
            { k: 'Puntos para superar al 7º (cupo directo)', ref: 'Diferencia + 1', v: paraDirecto, format: 'plain', extra: true },
            { k: 'Puntos para superar al 9º (Wild Card)', ref: 'Diferencia + 1', v: paraWildCard, format: 'plain' },
            { k: 'Máximo alcanzable ganando todo', ref: restantes + ' × 3', v: maxPosible, format: 'plain' },
            { k: 'Proyección al cierre de las 34 fechas', ref: 'Ritmo actual', v: esperado, format: 'plain' },
          ],
          format: 'plain',
          chart: [
            { label: 'Puntos que tenés', value: puntos, tone: 'main' },
            { label: 'Faltan para el top 7', value: paraDirecto, tone: 'exit' },
            { label: 'Faltan para el Wild Card', value: paraWildCard, tone: eliminado ? 'bad' : 'warn' },
            { label: 'Puntos en juego', value: enJuego, tone: 'prop' },
          ],
        };
      }

      // ── Campeonatos de motor: Fórmula 1 y MotoGP ──────────────────────────
      if (id === 'f1' || id === 'motogp') {
        const cfg = MOTOR[id];
        const rival = Math.max(0, Math.round(Number(v.puntosRival) || 0));
        const gps = Math.max(0, Math.round(Number(v.gps) || 0));
        const sprints = Math.max(0, Math.round(Number(v.sprints) || 0));
        const diff = puntos - rival;
        const maxPuntos = gps * cfg.gp + sprints * cfg.sprint;
        const maxRival = rival + maxPuntos;
        const cerrado = diff > maxPuntos;
        const aUnPunto = diff === maxPuntos;

        return {
          total: cerrado ? 'Campeón matemático' : aUnPunto ? 'A 1 punto del título' : 'Campeonato abierto',
          sub:
            cfg.nombre + ' · ventaja de ' + diff + ' pts · quedan ' + n0(maxPuntos) + ' pts en juego (' +
            gps + ' GP × ' + cfg.gp + ' + ' + sprints + ' sprints × ' + cfg.sprint + ') · el perseguidor necesita ' +
            (diff + 1) + ' pts netos',
          rows: [
            { k: 'Puntos del líder', ref: 'Tu dato', v: puntos, format: 'plain' },
            { k: 'Puntos del perseguidor', ref: 'Tu dato', v: rival, format: 'plain' },
            { k: 'Ventaja actual', ref: 'Líder − perseguidor', v: diff, format: 'plain', extra: true },
            { k: 'Puntos por Gran Premio', ref: cfg.nombre, v: cfg.gp, format: 'plain' },
            { k: 'Puntos por Sprint', ref: cfg.nombre, v: cfg.sprint, format: 'plain' },
            { k: 'Puntos todavía en juego', ref: 'GP × ' + cfg.gp + ' + sprints × ' + cfg.sprint, v: maxPuntos, format: 'plain' },
            { k: 'Máximo teórico del perseguidor', ref: 'Ganando todo', v: maxRival, format: 'plain' },
          ],
          format: 'plain',
          chart: [
            { label: 'Ventaja del líder', value: Math.max(0, diff), tone: 'main' },
            { label: 'Puntos en juego', value: maxPuntos, tone: cerrado ? 'prop' : 'warn' },
            { label: 'Necesita el perseguidor', value: diff + 1, tone: 'exit' },
          ],
        };
      }

      // ── Objetivo genérico de puntos ───────────────────────────────────────
      const objetivo = Math.max(0, Math.round(Number(v.objetivo) || 0));
      const faltan = Math.max(0, objetivo - puntos);
      const maxAlcanzable = puntos + enJuego;
      const imposible = faltan > enJuego;
      const victorias = Math.ceil(faltan / 3);
      const soloEmpates = faltan > 0 && faltan <= restantes;
      const promedio = restantes > 0 ? faltan / restantes : 0;
      const dificultad =
        promedio >= 2.5 ? 'muy exigente' : promedio >= 1.8 ? 'exigente' : promedio >= 1 ? 'accesible' : 'cómodo';

      return {
        total: faltan === 0 ? 'Objetivo ya alcanzado' : imposible ? 'Matemáticamente imposible' : faltan + ' pts',
        sub:
          faltan === 0
            ? 'Con ' + puntos + ' pts ya superás la marca de ' + objetivo + ': lo que sumes es colchón'
            : imposible
              ? 'Faltan ' + faltan + ' pts pero sólo quedan ' + enJuego + ' en juego (' + restantes + ' × 3): el techo es ' + maxAlcanzable
              : 'Se logra con ' + victorias + (victorias === 1 ? ' victoria' : ' victorias') +
                (soloEmpates ? ' o empatando ' + faltan + ' de los ' + restantes : '') +
                ' · promedio requerido ' + promedio.toFixed(2).replace('.', ',') + ' pts por partido, un ritmo ' + dificultad,
        rows: [
          { k: 'Puntos actuales', ref: 'Tu dato', v: puntos, format: 'plain' },
          { k: 'Puntos objetivo', ref: 'Tu dato', v: objetivo, format: 'plain' },
          { k: 'Puntos que faltan', ref: 'Objetivo − actuales', v: faltan, format: 'plain', extra: true },
          { k: 'Puntos todavía en juego', ref: restantes + ' × 3', v: enJuego, format: 'plain' },
          { k: 'Victorias mínimas necesarias', ref: 'Faltan ÷ 3, redondeado', v: victorias, format: 'plain' },
          { k: 'Promedio requerido por partido', ref: 'Faltan ÷ restantes', v: promedio, format: 'plain', decimals: 2 },
          { k: 'Máximo alcanzable', ref: 'Ganando todo', v: maxAlcanzable, format: 'plain' },
        ],
        format: 'plain',
        chart: [
          { label: 'Puntos que tenés', value: puntos, tone: 'main' },
          { label: 'Puntos que faltan', value: faltan, tone: imposible ? 'bad' : 'exit' },
          { label: 'Puntos en juego', value: enJuego, tone: 'prop' },
        ],
      };
    });
  })();
</script>
