---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SportsLiveNav from '../../components/SportsLiveNav.astro';
import FutbolHomeExperience from '../../components/generated/FutbolHomeExperience.astro';
const canonical='https://hacecuentas.com/futbol';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:"Fútbol",url:canonical,operatingSystem:'Web'};
---
<Layout title="Calculadoras y datos de fútbol: partidos, tablas y torneos | Hacé Cuentas" description="Consultá partidos, resultados, tablas y calendarios, y usá calculadoras de posiciones, puntos, probabilidades y torneos de fútbol." canonical={canonical} schema={schema} lang="es">
  <Header />
  <SportsLiveNav />
  <aside class="football-live-cta"><div><small>DATOS ACTUALIZADOS</small><strong>¿Qué partidos se juegan hoy?</strong><span>Resultados, próximos cruces y tablas de Primera y Primera Nacional.</span></div><div class="football-live-actions"><a href="/futbol-argentino-hoy">Ver fútbol argentino hoy →</a><a class="secondary" href="/futbol-hoy">Elegir otro país →</a></div></aside>
  <FutbolHomeExperience />
  <Footer />
</Layout>
<style>.football-live-cta{width:min(1120px,calc(100% - 32px));margin:28px auto 0;background:#0d1d2a;color:#fff;border-radius:18px;padding:22px 24px;display:flex;align-items:center;gap:28px}.football-live-cta>div:first-child{display:grid;gap:4px}.football-live-cta small{color:#c8ff3d;font-size:10px;font-weight:850;letter-spacing:.12em}.football-live-cta strong{font-size:22px}.football-live-cta span{color:#b8c4cc;font-size:13px}.football-live-actions{display:flex;gap:8px;margin-left:auto}.football-live-cta a{background:#c8ff3d;color:#0d1d2a;border-radius:999px;padding:11px 15px;font-size:12px;font-weight:850;white-space:nowrap}.football-live-cta a.secondary{background:transparent;border:1px solid rgba(255,255,255,.35);color:#fff}@media(max-width:700px){.football-live-cta{align-items:flex-start;flex-direction:column}.football-live-actions{margin-left:0;flex-wrap:wrap}.football-live-cta a{margin-left:0}}</style>
