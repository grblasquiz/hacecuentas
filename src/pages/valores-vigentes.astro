---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  VALORES,
  HISTORIAL,
  PROXIMOS,
  ULTIMA_REVISION,
  type ValorVigente,
} from '../lib/data/valores-vigentes';

// Hub "Valores vigentes en Argentina": qué vale hoy cada número clave
// (SMVM, Ganancias, monotributo, desempleo), qué cambió, desde cuándo,
// valor anterior/nuevo y fuente oficial. Toda la data numérica viene de
// las fuentes únicas del repo (las mismas que usan las calculadoras),
// así que se actualiza sola cuando los fetchers patchean esas fuentes.
// Patrón espejado de /datos-ganancias-2026 (Dataset + CC-BY + cómo citar).

const fmtARS = (n: number) => '$' + Math.round(n).toLocaleString('es-AR');
const fmtValor = (v: ValorVigente) => (v.valor !== null ? fmtARS(v.valor) : v.valorTexto ?? '—');

const SECCIONES = [...new Set(VALORES.map((v) => v.seccion))];

const smvm = VALORES.find((v) => v.id === 'smvm-mensual')!;
const mni = VALORES.find((v) => v.id === 'mni-ganancias')!;
const monoTope = VALORES.find((v) => v.id === 'monotributo-tope-k')!;
const monoCuotaA = VALORES.find((v) => v.id === 'monotributo-cuota-a')!;

const PAGE_URL = 'https://hacecuentas.com/valores-vigentes';
const title = 'Valores vigentes en Argentina 2026: salario mínimo, Ganancias, monotributo y más | Hacé Cuentas';
const description = `Todos los valores oficiales vigentes en Argentina, en una sola página: salario mínimo (${fmtARS(smvm.valor!)}), mínimo de Ganancias (${fmtARS(mni.valor!)}), categorías del monotributo, prestación por desempleo. Qué cambió, desde cuándo, valor anterior y nuevo, con fuente oficial. Se actualiza con cada cambio normativo. CC-BY 4.0.`;

const faq = [
  {
    q: '¿Cuál es el salario mínimo vigente en Argentina?',
    a: `El Salario Mínimo, Vital y Móvil es de ${fmtARS(smvm.valor!)} mensuales para jornada completa (vigencia: ${smvm.vigenciaDesde}, ${smvm.norma}). El valor por hora para jornalizados surge de dividir el mensual por 200.`,
  },
  {
    q: '¿Desde qué sueldo se paga Ganancias hoy?',
    a: `El mínimo efectivo mensual para un empleado soltero sin hijos es de ${fmtARS(mni.valor!)} de ganancia neta (${mni.vigenciaDesde}). Como el mínimo se compara contra el sueldo después de aportes, equivale a un bruto de aproximadamente ${fmtARS(mni.valor! / 0.83)}.`,
  },
  {
    q: '¿Cuánto se paga de monotributo hoy?',
    a: `La cuota mínima (categoría A) es de ${fmtValor(monoCuotaA)} por mes, con obra social y jubilación incluidas. El tope de facturación para permanecer en el régimen (categoría K) es de ${fmtValor(monoTope)} anuales. La tabla completa por categoría está en /datos-monotributo-2026.`,
  },
  {
    q: '¿Cada cuánto cambian estos valores?',
    a: 'Cada uno tiene su propio ciclo: el SMVM lo fija el Consejo del Salario por resolución (el cronograma vigente es mensual), Ganancias se actualiza por IPC cada semestre (Ley 27.743) y el monotributo se recategoriza en enero y julio. Esta página registra cada cambio con fecha, valor anterior y nuevo, y fuente.',
  },
  {
    q: '¿De dónde salen estos datos?',
    a: 'De las fuentes oficiales: resoluciones del CNEPySMVyM (Boletín Oficial), tablas de ARCA (RG 4003, art. 94 y art. 30 LIG) y la escala oficial del monotributo. Cada valor tiene el link a su fuente. Son además los mismos números que usan las calculadoras de este sitio: no pueden divergir.',
  },
  {
    q: '¿Puedo usar estos valores en mi web, nota o trabajo?',
    a: 'Sí. Se publican bajo licencia Creative Commons CC-BY 4.0: uso libre citando la fuente con un enlace a hacecuentas.com/valores-vigentes.',
  },
  {
    q: '¿Qué cambios se esperan próximamente?',
    a: PROXIMOS.map((p) => `${p.titulo} (${p.cuando})`).join(' · ') + '. El detalle está en la sección "Próximos cambios".',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${PAGE_URL}#webpage`,
      name: title,
      description,
      url: PAGE_URL,
      inLanguage: 'es-AR',
      dateModified: ULTIMA_REVISION,
      isPartOf: { '@id': 'https://hacecuentas.com/#website' },
      publisher: { '@id': 'https://hacecuentas.com/#organization' },
      mainEntity: { '@id': `${PAGE_URL}#dataset` },
    },
    {
      '@type': 'Dataset',
      '@id': `${PAGE_URL}#dataset`,
      name: 'Valores oficiales vigentes en Argentina — salario mínimo, Ganancias, monotributo, desempleo',
      description:
        'Registro actualizado de los valores normativos clave de Argentina: SMVM, mínimo y deducciones del Impuesto a las Ganancias, topes y cuotas del monotributo y prestación por desempleo, con historial de cambios (fecha, valor anterior y nuevo, norma y fuente oficial).',
      url: PAGE_URL,
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      inLanguage: 'es-AR',
      dateModified: ULTIMA_REVISION,
      spatialCoverage: { '@type': 'Place', name: 'Argentina' },
      creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: 'https://hacecuentas.com' },
      keywords: [
        'salario mínimo vital y móvil', 'SMVM 2026', 'mínimo no imponible Ganancias',
        'categorías monotributo 2026', 'prestación por desempleo', 'valores vigentes Argentina',
      ],
      variableMeasured: VALORES.map((v) => v.nombre),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hacecuentas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Valores vigentes', item: PAGE_URL },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="/valores-vigentes"
  audience="AR"
  schema={schema}
  domain="data"
>
  <Header slot="header" />

  <main class="article-main">
    <article class="page-content datos-page">
      <header class="article-header">
        <nav class="crumbs" aria-label="Migas de pan">
          <a href="/">Inicio</a> <span>›</span> <span>Valores vigentes</span>
        </nav>
        <h1>Valores vigentes en Argentina</h1>
        <p class="lede">
          Los números oficiales que cambian todo el tiempo, en una sola página: <strong>salario
          mínimo</strong>, <strong>mínimo de Ganancias</strong>, <strong>monotributo</strong> y
          <strong>prestación por desempleo</strong>. Con cada cambio registramos <strong>qué cambió,
          desde cuándo, el valor anterior y el nuevo</strong>, el impacto en un ejemplo real y la
          fuente oficial. Son los mismos valores que usan nuestras calculadoras: no pueden divergir.
        </p>
        <p class="updated">
          Última revisión: <time datetime={ULTIMA_REVISION}>{new Date(ULTIMA_REVISION).toLocaleDateString('es-AR')}</time> ·
          Licencia <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC-BY 4.0</a> (uso libre con atribución)
        </p>
      </header>

      <section class="stats-callout" aria-label="Valores destacados">
        <div class="stat">
          <span class="stat-num">{fmtARS(smvm.valor!)}</span>
          <span class="stat-label">salario mínimo mensual</span>
        </div>
        <div class="stat">
          <span class="stat-num">{fmtARS(mni.valor!)}</span>
          <span class="stat-label">mínimo mensual de Ganancias (soltero)</span>
        </div>
        <div class="stat">
          <span class="stat-num">{fmtValor(monoCuotaA)}</span>
          <span class="stat-label">cuota mínima de monotributo</span>
        </div>
        <div class="stat">
          <span class="stat-num">{fmtValor(monoTope)}</span>
          <span class="stat-label">tope anual del monotributo (K)</span>
        </div>
      </section>

      {SECCIONES.map((seccion) => (
        <section>
          <h2>{seccion}</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Concepto</th>
                  <th>Valor vigente</th>
                  <th>Desde</th>
                  <th>Fuente</th>
                </tr>
              </thead>
              <tbody>
                {VALORES.filter((v) => v.seccion === seccion).map((v) => (
                  <tr>
                    <td data-label="Concepto">
                      <strong>{v.nombre}</strong>
                      <span class="concepto-detalle">{v.detalle}</span>
                      {(v.calcHref || v.datosHref) && (
                        <span class="concepto-links">
                          {v.calcHref && <a href={v.calcHref}>Calculá tu caso</a>}
                          {v.calcHref && v.datosHref && ' · '}
                          {v.datosHref && <a href={v.datosHref}>Tabla completa</a>}
                        </span>
                      )}
                    </td>
                    <td data-label="Valor"><strong>{fmtValor(v)}</strong></td>
                    <td data-label="Desde">{v.vigenciaDesde}</td>
                    <td data-label="Fuente">
                      <a href={v.fuenteUrl} rel="nofollow noopener" target="_blank">{v.fuente}</a>
                      <span class="norma">{v.norma}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}

      <section>
        <h2>Qué cambió (historial)</h2>
        <p>
          Cada cambio normativo, registrado con valor anterior, valor nuevo, impacto en un ejemplo
          real y fuente oficial. Lo nuevo arriba.
        </p>
        <ol class="cambios">
          {HISTORIAL.map((c) => (
            <li class="cambio">
              <div class="cambio-fecha">
                <time datetime={c.fecha}>{new Date(c.fecha + 'T12:00:00').toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
              </div>
              <div class="cambio-body">
                <h3>{c.titulo}</h3>
                <p>{c.queCambio}</p>
                {(c.anterior || c.nuevo) && (
                  <p class="cambio-valores">
                    {c.anterior && <span class="valor-anterior">Antes: {c.anterior}</span>}
                    {c.anterior && c.nuevo && <span class="flecha" aria-hidden="true"> → </span>}
                    {c.nuevo && <span class="valor-nuevo">Ahora: {c.nuevo}</span>}
                  </p>
                )}
                <p class="cambio-impacto"><strong>Impacto:</strong> {c.impacto}</p>
                <p class="cambio-fuente">
                  {c.norma} · <a href={c.fuenteUrl} rel="nofollow noopener" target="_blank">fuente oficial</a>
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h2>Próximos cambios</h2>
        <ul class="proximos">
          {PROXIMOS.map((p) => (
            <li>
              <strong>{p.titulo}</strong> <span class="cuando">({p.cuando})</span>
              <p>{p.detalle}</p>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Tablas completas y calculadoras</h2>
        <p>Este hub muestra los valores clave; el detalle completo está en las páginas de datos:</p>
        <ul class="calc-links">
          <li><a href="/datos-ganancias-2026">Escala de Ganancias y deducciones art. 30 (2026)</a></li>
          <li><a href="/datos-monotributo-2026">Categorías del monotributo 2026: topes y cuotas</a></li>
          <li><a href="/datos-topes-sipa-2026">Topes de aportes SIPA 2026</a></li>
          <li><a href="/datos-aguinaldo-2026">Aguinaldo (SAC) 2026: fechas y fórmula</a></li>
          <li><a href="/valores-bcra">Dólar, inflación y tasas BCRA (hoy)</a></li>
          <li><a href="/que-sueldo-necesito">¿Qué sueldo necesito para…? (guía completa)</a></li>
        </ul>
      </section>

      <section class="cite-instructions">
        <h2>Cómo citar esta página</h2>
        <p>¿Usás estos valores en una nota, trabajo, app o web? La atribución pedida es:</p>
        <pre><code>Fuente: Hacé Cuentas — https://hacecuentas.com/valores-vigentes
Datos oficiales (CNEPySMVyM, ARCA, ANSES) · Licencia CC-BY 4.0</code></pre>
        <p>
          Si publicás online, te agradecemos el enlace a
          <a href="https://hacecuentas.com/valores-vigentes">hacecuentas.com/valores-vigentes</a>.
        </p>
      </section>

      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <section class="fuentes">
        <h2>Fuentes</h2>
        <ul>
          <li><a href="https://www.argentina.gob.ar/trabajo/consejodelsalario" rel="nofollow noopener" target="_blank">Consejo Nacional del Empleo, la Productividad y el SMVM</a> (resoluciones de salario mínimo)</li>
          <li><a href="https://www.afip.gob.ar/gananciasYBienes/ganancias/personas-humanas-sucesiones-indivisas/" rel="nofollow noopener" target="_blank">ARCA — Impuesto a las Ganancias</a> (escala art. 94 y deducciones art. 30)</li>
          <li><a href="https://www.afip.gob.ar/monotributo/categorias.asp" rel="nofollow noopener" target="_blank">ARCA — Monotributo, categorías vigentes</a></li>
          <li><a href="https://www.anses.gob.ar/prestacion-por-desempleo" rel="nofollow noopener" target="_blank">ANSES — Prestación por desempleo</a></li>
        </ul>
      </section>
    </article>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .datos-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem 1rem 4rem;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-bottom: 0.75rem;
  }
  .crumbs a { color: var(--accent, #2563eb); text-decoration: none; }
  .datos-page h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text, #222);
  }
  .updated {
    font-size: 0.85rem;
    color: var(--text-muted, #666);
    margin-top: 0.5rem;
  }
  .datos-page h2 {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .stats-callout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
    margin: 1.75rem 0;
  }
  .stat {
    background: var(--bg-soft, #f4f6f9);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 0.6rem;
    padding: 0.9rem 1rem;
    text-align: center;
  }
  .stat-num {
    display: block;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent, #2563eb);
    line-height: 1.25;
  }
  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted, #666);
    margin-top: 0.25rem;
  }
  .table-wrap { overflow-x: auto; margin: 1.25rem 0; }
  .datos-page table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    min-width: 620px;
  }
  .datos-page th {
    background: var(--bg-soft, #f1f5f9);
    padding: 0.6rem 0.7rem;
    text-align: left;
    font-weight: 600;
    border-bottom: 2px solid var(--border, #e5e7eb);
    white-space: nowrap;
  }
  .datos-page td {
    padding: 0.65rem 0.7rem;
    text-align: left;
    border-bottom: 1px solid var(--border, #eee);
    vertical-align: top;
  }
  .datos-page tbody tr:nth-child(odd) { background: var(--bg-card, #fafafa); }
  .concepto-detalle {
    display: block;
    font-size: 0.82rem;
    color: var(--text-muted, #666);
    font-weight: 400;
    margin-top: 0.2rem;
    line-height: 1.45;
  }
  .concepto-links {
    display: block;
    font-size: 0.82rem;
    margin-top: 0.3rem;
  }
  .concepto-links a { color: var(--accent, #2563eb); }
  .norma {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted, #888);
    margin-top: 0.2rem;
  }
  .datos-page td a { color: var(--accent, #2563eb); }
  .cambios {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .cambio {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border, #e5e7eb);
  }
  @media (max-width: 560px) {
    .cambio { grid-template-columns: 1fr; gap: 0.35rem; }
  }
  .cambio-fecha {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted, #666);
  }
  .cambio-body h3 {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }
  .cambio-body p {
    margin: 0 0 0.5rem;
    line-height: 1.55;
    font-size: 0.95rem;
  }
  .cambio-valores {
    background: var(--bg-soft, #f4f6f9);
    border-radius: 0.4rem;
    padding: 0.45rem 0.7rem;
    display: inline-block;
    font-size: 0.9rem;
  }
  .valor-anterior { color: var(--text-muted, #777); text-decoration: line-through; }
  .valor-nuevo { font-weight: 700; color: var(--accent, #2563eb); }
  .flecha { color: var(--text-muted, #999); }
  .cambio-impacto { font-size: 0.9rem; color: var(--text, #333); }
  .cambio-fuente { font-size: 0.8rem; color: var(--text-muted, #888); }
  .cambio-fuente a { color: var(--accent, #2563eb); }
  .proximos { margin-left: 1.25rem; }
  .proximos li { margin-bottom: 0.9rem; line-height: 1.55; }
  .proximos .cuando { color: var(--text-muted, #666); font-size: 0.9rem; }
  .proximos p { margin: 0.2rem 0 0; font-size: 0.92rem; color: var(--text-muted, #555); }
  .calc-links li, .fuentes li { line-height: 1.7; margin-bottom: 0.5rem; }
  .calc-links, .fuentes ul { margin-left: 1.25rem; }
  .calc-links a, .fuentes a { color: var(--accent, #2563eb); }
  .cite-instructions {
    margin-top: 2.5rem;
    padding: 1.1rem;
    background: var(--bg-soft, #f4f6f9);
    border-radius: 0.6rem;
  }
  .cite-instructions pre {
    background: var(--code-bg, #eaeef3);
    padding: 0.75rem;
    border-radius: 0.4rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }
  .faq details {
    border-bottom: 1px solid var(--border, #e5e7eb);
    padding: 0.75rem 0;
  }
  .faq summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--text, #222);
  }
  .faq details p {
    margin-top: 0.5rem;
    color: var(--text-muted, #555);
    line-height: 1.6;
  }
</style>
