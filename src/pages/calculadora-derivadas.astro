---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { freeOfferSchema } from '../lib/offer-schema';
import { differentiate, renderSolutionHTML } from '../lib/math/derivative';

const title = 'Calculadora de Derivadas Paso a Paso (Online y Gratis) | Hacé Cuentas';
const description =
  'Calculá la derivada de cualquier función y mirá la resolución completa paso a paso: regla de la potencia, del producto, del cociente y de la cadena, con derivadas de seno, coseno, ln, eˣ y raíces. Online, gratis y sin registrarte. Ideal para secundaria, CBC y facultad.';

const site = 'https://hacecuentas.com';

// El ejemplo por defecto se resuelve en build: aunque el JS no corra (SEO, no-JS,
// primera carga), la página ya muestra una derivada resuelta completa.
const DEFAULT_INPUT = 'x^2*sin(x)';
const defaultSolution = renderSolutionHTML(differentiate(DEFAULT_INPUT));

// Ejemplos resueltos prerenderizados (info-gain: MathML real en el HTML estático).
const examples = [
  { label: '5x³ − 2x + 7', input: '5x^3 - 2x + 7', note: 'Polinomio: regla de la potencia término a término.' },
  { label: 'x² · sin(x)', input: 'x^2*sin(x)', note: 'Producto de dos funciones que dependen de x → regla del producto.' },
  { label: '(x² + 1) / (x − 3)', input: '(x^2+1)/(x-3)', note: 'División de funciones → regla del cociente.' },
  { label: 'ln(3x² + 1)', input: 'ln(3*x^2+1)', note: 'Función compuesta → regla de la cadena.' },
  { label: '√(x² + 1)', input: 'sqrt(x^2+1)', note: 'Raíz de una función → cadena con la regla de la raíz.' },
  { label: 'e^(2x)', input: 'e^(2*x)', note: 'Exponencial con exponente variable.' },
].map((ex) => ({ ...ex, html: renderSolutionHTML(differentiate(ex.input)) }));

// Chips de inserción rápida para el teclado de la calculadora.
const chips = [
  { l: 'x', ins: 'x' },
  { l: 'x²', ins: '^2' },
  { l: 'xⁿ', ins: '^' },
  { l: '√', ins: 'sqrt(' },
  { l: '( )', ins: '()' },
  { l: '÷', ins: '/' },
  { l: '·', ins: '*' },
  { l: 'sin', ins: 'sin(' },
  { l: 'cos', ins: 'cos(' },
  { l: 'tan', ins: 'tan(' },
  { l: 'ln', ins: 'ln(' },
  { l: 'eˣ', ins: 'e^' },
  { l: 'π', ins: 'pi' },
];

// Tabla de reglas (referenceTable: alta intención, gran info-gain).
const rules = [
  ['Constante', "c' = 0", 'La derivada de un número solo es 0.'],
  ['Potencia', "(xⁿ)' = n·xⁿ⁻¹", 'Bajás el exponente y le restás 1.'],
  ['Constante por función', "(c·f)' = c·f'", 'El factor numérico queda multiplicando.'],
  ['Suma / resta', "(f ± g)' = f' ± g'", 'Se deriva término por término.'],
  ['Producto', "(f·g)' = f'·g + f·g'", 'Derivás una y dejás la otra, y al revés; se suman.'],
  ['Cociente', "(f/g)' = (f'·g − f·g') / g²", 'Numerador cruzado menos, sobre el denominador al cuadrado.'],
  ['Cadena', "(f(g))' = f'(g)·g'", 'Derivada de afuera por derivada de adentro.'],
  ['Seno', "(sin x)' = cos x", 'El seno deriva en coseno.'],
  ['Coseno', "(cos x)' = −sin x", 'El coseno deriva en menos seno.'],
  ['Tangente', "(tan x)' = sec²x", 'Equivale a 1/cos²x.'],
  ['Logaritmo natural', "(ln x)' = 1/x", 'Muy usada dentro de la regla de la cadena.'],
  ['Exponencial', "(eˣ)' = eˣ", 'La única función que es su propia derivada.'],
  ['Raíz cuadrada', "(√x)' = 1/(2√x)", 'Sale de la potencia con exponente ½.'],
];

const faqs = [
  {
    q: '¿Cómo se calcula una derivada paso a paso?',
    a: 'Se identifica qué <strong>regla</strong> aplica según la forma de la función: si es una suma, se deriva término por término; si es un producto, se usa la <strong>regla del producto</strong>; si es una división, la <strong>regla del cociente</strong>; y si hay una función dentro de otra, la <strong>regla de la cadena</strong>. Esta calculadora detecta la estructura de tu función, aplica la regla correcta en cada paso y te muestra toda la resolución hasta simplificar el resultado.',
  },
  {
    q: '¿Qué funciones puedo derivar?',
    a: 'Polinomios y potencias (<code>x^2</code>, <code>x^5</code>, <code>x^(1/2)</code>), funciones <strong>trigonométricas</strong> (<code>sin</code>, <code>cos</code>, <code>tan</code>, <code>cot</code>, <code>sec</code>, <code>csc</code>) y sus inversas (<code>asin</code>, <code>acos</code>, <code>atan</code>), <strong>hiperbólicas</strong> (<code>sinh</code>, <code>cosh</code>, <code>tanh</code>), <strong>exponenciales</strong> (<code>e^x</code>, <code>2^x</code>), <strong>logaritmos</strong> (<code>ln</code>, <code>log</code>), <strong>raíces</strong> (<code>sqrt</code>, <code>cbrt</code>) y cualquier combinación de ellas mediante sumas, productos, cocientes y composición.',
  },
  {
    q: '¿Cómo escribo la función?',
    a: 'Usá <code>^</code> para potencias (<code>x^3</code>), <code>*</code> o un espacio para multiplicar (<code>3*x</code> o <code>3x</code>), <code>/</code> para dividir y paréntesis para agrupar. Las funciones se escriben con paréntesis: <code>sin(x)</code>, <code>ln(2*x+1)</code>, <code>sqrt(x)</code>. Para el número <em>e</em> escribí <code>e</code> y para pi <code>pi</code>. Por ejemplo, <code>x^2*sin(x)</code> o <code>(x^2+1)/(x-3)</code>.',
  },
  {
    q: '¿Qué es la regla de la cadena?',
    a: 'Es la regla para derivar una <strong>función compuesta</strong>, es decir una función dentro de otra, como <code>sin(x²)</code> o <code>ln(3x+1)</code>. La fórmula es <code>(f(g(x)))′ = f′(g(x)) · g′(x)</code>: se deriva la función de afuera dejando lo de adentro igual, y se multiplica por la derivada de lo de adentro. Es el error más común en los exámenes: olvidarse de multiplicar por la derivada interna.',
  },
  {
    q: '¿Para qué sirve derivar una función?',
    a: 'La derivada mide la <strong>tasa de cambio</strong> de una función: cuánto crece o decrece en cada punto. Geométricamente es la <strong>pendiente de la recta tangente</strong>. Se usa para hallar <strong>máximos y mínimos</strong> (optimización), analizar crecimiento, calcular velocidades y aceleraciones en física, y estudiar el comportamiento de una función. Es la base del cálculo diferencial.',
  },
  {
    q: '¿Puedo derivar respecto de otra variable que no sea x?',
    a: 'Sí. Cambiá la variable en el campo "derivar respecto de" (por ejemplo <code>t</code>). Las demás letras que aparezcan se tratan como <strong>constantes / parámetros</strong>. Así, la derivada de <code>a*t^2</code> respecto de <code>t</code> es <code>2·a·t</code>, dejando la <code>a</code> como constante.',
  },
  {
    q: '¿La calculadora simplifica el resultado?',
    a: 'Sí. Después de aplicar todas las reglas, agrupa términos, resuelve los productos por 1 y las sumas con 0, junta los coeficientes numéricos y combina las fracciones, para darte la derivada lo más limpia posible. Igual te mostramos los pasos intermedios sin simplificar para que veas de dónde sale cada parte.',
  },
  {
    q: '¿Calcula derivadas segundas o de orden superior?',
    a: 'Para la <strong>derivada segunda</strong> (f′′), derivá tu función, copiá el resultado con el botón "Copiar" y volvé a pegarlo en la calculadora para derivarlo otra vez. Repitiendo el proceso obtenés las derivadas de cualquier orden.',
  },
  {
    q: '¿Es gratis y necesito registrarme?',
    a: 'Es <strong>100% gratis</strong>, sin registro y sin límite de uso. Todo el cálculo se hace <strong>en tu navegador</strong>: la función que escribís no se envía a ningún servidor. Funciona en la compu y en el celular, sin instalar nada.',
  },
  {
    q: '¿Sirve para la secundaria, el CBC y la facultad?',
    a: 'Sí. Cubre las derivadas que se piden en <strong>matemática de secundaria</strong>, en el <strong>CBC/ingreso</strong> y en <strong>Análisis Matemático I</strong> de la facultad: reglas de potencia, producto, cociente y cadena, y las derivadas de las funciones elementales. Te muestra el procedimiento completo, así que sirve para estudiar y entender, no solo para copiar el resultado.',
  },
];

const related = [
  { href: '/calculadora-cientifica', t: 'Calculadora científica', i: '🧮' },
  { href: '/calculadora-ecuacion-cuadratica-raices-discriminante', t: 'Ecuación cuadrática', i: '📐' },
  { href: '/calculadora-trigonometria-seno-coseno-tangente', t: 'Trigonometría (seno, coseno, tangente)', i: '📐' },
  { href: '/calculadora-logaritmos-base-10-natural-cualquier-base', t: 'Logaritmos (ln, log, log₂)', i: '📊' },
  { href: '/calculadora-raiz-cuadrada-cubica', t: 'Raíz cuadrada, cúbica y n-ésima', i: '√' },
  { href: '/calculadora-regla-de-tres-simple-directa-inversa', t: 'Regla de 3 simple', i: '➗' },
];

const howToSteps = [
  { name: 'Escribí la función', text: 'Tipeá f(x) con los botones o el teclado, por ejemplo x^2*sin(x). Usá ^ para potencias y paréntesis para agrupar.' },
  { name: 'Elegí la variable', text: 'Por defecto se deriva respecto de x. Cambiala si tu función usa otra letra (t, n…).' },
  { name: 'Tocá "Calcular derivada"', text: 'La calculadora identifica la regla de cada paso y muestra toda la resolución hasta el resultado final.' },
  { name: 'Revisá los pasos', text: 'Cada paso indica qué regla se aplicó (producto, cociente, cadena…). Al final ves f′(x) simplificada.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de derivadas paso a paso',
  url: `${site}/calculadora-derivadas`,
  description,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  inLanguage: 'es',
  isAccessibleForFree: true,
  offers: freeOfferSchema({ priceCurrency: 'ARS' }),
  featureList: [
    'Derivadas paso a paso con la regla aplicada en cada paso',
    'Regla de la potencia, del producto, del cociente y de la cadena',
    'Funciones trigonométricas, exponenciales, logarítmicas y raíces',
    'Derivar respecto de cualquier variable',
    'Resultado simplificado y copiable',
  ],
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Matemática', item: `${site}/categoria/matematica` },
    { '@type': 'ListItem', position: 3, name: 'Calculadora de derivadas', item: `${site}/calculadora-derivadas` },
  ],
};

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};

const schemaHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Cómo calcular una derivada paso a paso',
  step: howToSteps.map((s, idx) => ({
    '@type': 'HowToStep', position: idx + 1, name: s.name, text: s.text,
  })),
};
---

<Layout title={title} description={description} canonical="/calculadora-derivadas" schema={schema}>
  <Header slot="header" />

  <article class="dv-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/categoria/matematica">Matemática</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Calculadora de derivadas</span>
    </nav>

    <h1>Calculadora de derivadas paso a paso</h1>
    <p class="lead">
      Escribí una función y la calculadora te muestra <strong>toda la resolución de la derivada</strong>:
      qué regla se aplica en cada paso (potencia, producto, cociente, cadena) hasta llegar a
      <strong>f′(x)</strong> simplificada. Online, gratis y sin registrarte.
    </p>

    <div class="dv-answer">
      <p>
        <strong>¿Qué es una derivada?</strong> Es la <strong>tasa de cambio</strong> de una función: mide cuánto
        crece o decrece en cada punto y, geométricamente, es la <strong>pendiente de la recta tangente</strong>.
        Derivar consiste en aplicar reglas (potencia, producto, cociente y cadena) sobre la fórmula de la función.
        Esta herramienta lo hace <strong>paso a paso</strong>, mostrando la regla usada en cada renglón.
      </p>
    </div>

    <div class="dv-card">
      <form id="dvForm" class="dv-form" novalidate>
        <label class="dv-label" for="dvInput">Función a derivar &nbsp;<span class="dv-fx">f(x) =</span></label>
        <div class="dv-input-row">
          <input
            id="dvInput"
            class="dv-input"
            type="text"
            inputmode="text"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            value={DEFAULT_INPUT}
            aria-label="Función a derivar"
            placeholder="ej.: x^2*sin(x)"
          />
          <div class="dv-var">
            <label for="dvVar">respecto de</label>
            <input id="dvVar" class="dv-var-input" type="text" value="x" maxlength="1" aria-label="Variable de derivación" />
          </div>
        </div>

        <div class="dv-chips" role="group" aria-label="Inserción rápida">
          {chips.map((c) => (
            <button type="button" class="dv-chip" data-ins={c.ins}>{c.l}</button>
          ))}
          <button type="button" class="dv-chip dv-chip-del" data-act="back" title="Borrar">⌫</button>
          <button type="button" class="dv-chip dv-chip-clear" data-act="clear" title="Limpiar">AC</button>
        </div>

        <button type="submit" id="dvGo" class="dv-go">Calcular derivada</button>
      </form>

      <div class="dv-out" id="dvOut" aria-live="polite" set:html={defaultSolution}></div>
    </div>

    <section class="dv-section">
      <h2>Cómo usar la calculadora de derivadas</h2>
      <ol class="dv-steps-list">
        {howToSteps.map((s) => (
          <li><strong>{s.name}.</strong> {s.text}</li>
        ))}
      </ol>
      <p>
        Para una <strong>derivada segunda</strong>, calculá la primera, tocá <strong>Copiar</strong> y pegá el
        resultado de nuevo en el campo para volver a derivarlo.
      </p>
    </section>

    <section class="dv-section">
      <h2>Tabla de reglas de derivación</h2>
      <p>Estas son las reglas que la calculadora aplica automáticamente. Te sirven para seguir cada paso:</p>
      <div class="dv-table-wrap">
        <table class="dv-table">
          <thead><tr><th>Regla</th><th>Fórmula</th><th>En palabras</th></tr></thead>
          <tbody>
            {rules.map(([name, formula, words]) => (
              <tr><td class="dv-td-name">{name}</td><td class="dv-td-formula">{formula}</td><td>{words}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="dv-section">
      <h2>Ejemplos resueltos paso a paso</h2>
      <p>Mirá cómo se resuelven distintos tipos de derivada. Tocá cada una para ver la resolución completa:</p>
      <div class="dv-examples">
        {examples.map((ex, i) => (
          <details class="dv-example" open={i === 0}>
            <summary>
              <span class="dv-ex-fx">f(x) = {ex.label}</span>
              <span class="dv-ex-note">{ex.note}</span>
            </summary>
            <div class="dv-ex-solution" set:html={ex.html}></div>
          </details>
        ))}
      </div>
    </section>

    <section class="dv-section">
      <h2>La regla de la cadena, sin perderse</h2>
      <p>
        Es la regla que más se traba en los exámenes. Aparece cuando hay una <strong>función dentro de otra</strong>:
        por ejemplo <code>sin(x²)</code> es el seno (función de afuera) de <code>x²</code> (función de adentro). La
        fórmula es <code>(f(g(x)))′ = f′(g(x))·g′(x)</code>: derivás la de afuera dejando lo de adentro igual, y
        después multiplicás por la derivada de lo de adentro.
      </p>
      <p>
        El error clásico es olvidarse del segundo factor (la derivada interna). Con <code>sin(x²)</code>: la derivada
        de afuera es <code>cos(x²)</code> y la de adentro es <code>2x</code>, así que el resultado es
        <code>cos(x²)·2x = 2x·cos(x²)</code>. La calculadora marca explícitamente ese paso de "cadena" para que no se
        te escape.
      </p>
    </section>

    <section class="dv-section dv-related">
      <h2>Calculadoras de matemática relacionadas</h2>
      <div class="dv-related-grid">
        {related.map((r) => (
          <a href={r.href} class="dv-related-card">
            <span class="dv-related-icon" aria-hidden="true">{r.i}</span>
            <span>{r.t}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="dv-section">
      <h2>Preguntas frecuentes</h2>
      <div class="dv-faq">
        {faqs.map((f) => (
          <details class="dv-faq-item">
            <summary>{f.q}</summary>
            <div class="dv-faq-a" set:html={f.a}></div>
          </details>
        ))}
      </div>
    </section>

    <section class="dv-section dv-editorial">
      <p>
        <strong>Revisado por el equipo editorial de Hacé Cuentas.</strong> El motor de derivación se prueba contra
        decenas de casos de referencia (polinomios, producto, cociente, cadena, funciones trigonométricas,
        exponenciales y logarítmicas). Más sobre cómo trabajamos en nuestra
        <a href="/politica-editorial">política editorial</a> y <a href="/metodologia">metodología</a>.
      </p>
      <p class="dv-disclaimer">
        Los resultados son orientativos y pensados para estudiar. Para trabajos académicos, verificá siempre con tu
        material de cátedra.
      </p>
    </section>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaFaq)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaHowTo)}></script>

  <Footer slot="footer" />
</Layout>

<script>
  import { differentiate, renderSolutionHTML } from '../lib/math/derivative';

  function setupDeriv() {
    const form = document.getElementById('dvForm') as HTMLFormElement | null;
    if (!form || form.dataset.dvReady) return;
    form.dataset.dvReady = '1';

    const input = document.getElementById('dvInput') as HTMLInputElement;
    const varInput = document.getElementById('dvVar') as HTMLInputElement;
    const out = document.getElementById('dvOut') as HTMLElement;

    function compute() {
      const expr = input.value.trim();
      const v = (varInput.value.trim() || 'x').slice(0, 1);
      const res = differentiate(expr, v);
      out.innerHTML = renderSolutionHTML(res);
    }

    // Insertar texto en la posición del cursor del input.
    function insertAtCursor(text: string) {
      const start = input.selectionStart ?? input.value.length;
      const end = input.selectionEnd ?? input.value.length;
      input.value = input.value.slice(0, start) + text + input.value.slice(end);
      // Si insertamos "()", dejamos el cursor dentro de los paréntesis.
      let caret = start + text.length;
      if (text === '()') caret = start + 1;
      else if (text.endsWith('(')) caret = start + text.length;
      input.focus();
      input.setSelectionRange(caret, caret);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      compute();
      out.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });

    form.querySelectorAll<HTMLButtonElement>('.dv-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const act = chip.getAttribute('data-act');
        if (act === 'clear') { input.value = ''; input.focus(); return; }
        if (act === 'back') {
          const s = input.selectionStart ?? input.value.length;
          if (s > 0) { input.value = input.value.slice(0, s - 1) + input.value.slice(s); input.focus(); input.setSelectionRange(s - 1, s - 1); }
          return;
        }
        const ins = chip.getAttribute('data-ins');
        if (ins) insertAtCursor(ins);
      });
    });

    // Botón "Copiar" delegado sobre el contenedor de salida.
    out.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.dv-copy') as HTMLElement | null;
      if (!btn) return;
      const text = btn.getAttribute('data-copy') || '';
      const done = () => { const o = btn.textContent; btn.textContent = '✓ Copiado'; setTimeout(() => { btn.textContent = o; }, 1500); };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
      } else {
        fallbackCopy(text, done);
      }
    });

    function fallbackCopy(text: string, done: () => void) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch {}
      document.body.removeChild(ta);
    }

    // Recalcular el ejemplo por defecto en el cliente (idempotente con el SSR).
    compute();
  }

  setupDeriv();
  document.addEventListener('astro:page-load', setupDeriv);
</script>

<style>
  .dv-page { max-width: 760px; margin: 0 auto; padding: 0 0 3rem; }
  .breadcrumbs { font-size: 0.875rem; color: var(--text-subtle); margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .breadcrumbs a { color: var(--text-muted); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }
  .breadcrumbs .sep { color: var(--border-strong); }

  h1 { margin-bottom: 0.75rem; }
  .lead { font-size: 1.0625rem; color: var(--text-muted); margin-bottom: 1.75rem; }
  .dv-answer {
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    padding: 0.875rem 1rem;
    margin-bottom: 1.75rem;
  }
  .dv-answer p { margin: 0; color: var(--text); font-size: 0.96875rem; line-height: 1.65; }

  .dv-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: var(--shadow);
