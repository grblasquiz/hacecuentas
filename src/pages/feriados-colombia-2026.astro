---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeriadosColombiaExperience from '../components/generated/FeriadosColombiaExperience.astro';
import FeriadosLatamLinks from '../components/FeriadosLatamLinks.astro';
const canonical='https://hacecuentas.com/feriados-colombia-2026';
const schema={'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage',name:'Calendario de festivos de Colombia 2026',description:'Los 19 festivos nacionales de Colombia en 2026, con fechas observadas, lunes festivos y puentes de la Ley Emiliani.',url:canonical,inLanguage:'es-CO',dateModified:'2026-08-04'},
  {'@type':'FAQPage',mainEntity:[
    {'@type':'Question',name:'¿Cuántos festivos tiene Colombia en 2026?',acceptedAnswer:{'@type':'Answer',text:'Colombia tiene 19 festivos nacionales en 2026, incluido el nuevo festivo de la Virgen de Chiquinquirá.'}},
    {'@type':'Question',name:'¿Qué significa que un festivo sea trasladable?',acceptedAnswer:{'@type':'Answer',text:'La Ley Emiliani mueve el descanso al lunes siguiente. El calendario muestra directamente la fecha observada en 2026.'}},
    {'@type':'Question',name:'¿Todos los festivos forman puente?',acceptedAnswer:{'@type':'Answer',text:'No. Los festivos que caen lunes o viernes forman naturalmente un fin de semana de tres días.'}}
  ]}
]};
---
<Layout title="Calendario Colombia 2026: 19 festivos y puentes" description="Calendario Colombia 2026 con los 19 festivos nacionales: fechas observadas, lunes festivos, puentes que quedan y aplicación de la Ley Emiliani." canonical={canonical} schema={schema} lang="es" audience="CO">
  <Header />
  <aside class="next-query"><strong>¿Trabajás uno de estos festivos?</strong> <a href="/co/trabajo/horas-extras-y-recargos">Calculá cuánto te pagan por trabajar un festivo o dominical →</a></aside>
  <FeriadosColombiaExperience />
  <FeriadosLatamLinks currentPath="/feriados-colombia-2026" />
  <Footer />
</Layout>
<style>.next-query{max-width:1120px;margin:1rem auto;padding:1rem 1.25rem;border:1px solid #bfdbfe;border-radius:14px;background:#eff6ff}.next-query a{font-weight:800}</style>
