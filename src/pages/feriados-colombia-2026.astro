---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeriadosColombiaExperience from '../components/generated/FeriadosColombiaExperience.astro';
import FeriadosLatamLinks from '../components/FeriadosLatamLinks.astro';
const canonical='https://hacecuentas.com/feriados-colombia-2026';
const schema={'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage',name:'Calendario de festivos de Colombia 2026',description:'Los 19 festivos nacionales de Colombia en 2026, incluido el nuevo festivo de Chiquinquirá, con fechas observadas y puentes.',url:canonical,inLanguage:'es-CO',dateModified:'2026-08-17',citation:['https://www.secretariasenado.gov.co/senado/basedoc/ley_0051_1983.html','https://www.suin-juriscol.gov.co/viewDocument.asp?id=30056513']},
  {'@type':'FAQPage',mainEntity:[
    {'@type':'Question',name:'¿Cuántos festivos tiene Colombia en 2026?',acceptedAnswer:{'@type':'Answer',text:'Colombia tiene 19 festivos nacionales en 2026. La Ley 2578 de 2026 agregó el Día de Nuestra Señora del Rosario de Chiquinquirá; su descanso se observó el lunes 13 de julio por la Ley Emiliani.'}},
    {'@type':'Question',name:'¿Qué significa que un festivo sea trasladable?',acceptedAnswer:{'@type':'Answer',text:'La Ley Emiliani mueve el descanso al lunes siguiente. El calendario muestra directamente la fecha observada en 2026.'}},
    {'@type':'Question',name:'¿Todos los festivos forman puente?',acceptedAnswer:{'@type':'Answer',text:'No. Los festivos que caen lunes o viernes forman naturalmente un fin de semana de tres días.'}}
  ]}
]};
---
<Layout title="Calendario Colombia 2026: 19 festivos y puentes" description="Calendario Colombia 2026 actualizado: 19 festivos, incluido el nuevo festivo de Chiquinquirá, fechas observadas, lunes festivos y puentes." canonical={canonical} schema={schema} lang="es" audience="CO">
  <Header />
  <aside class="legal-update">
    <strong>Actualización 2026:</strong> la
    <a href="https://www.suin-juriscol.gov.co/viewDocument.asp?id=30056513" target="_blank" rel="noopener">
      Ley 2578 de 2026
    </a>
    creó el festivo nacional de Nuestra Señora del Rosario de Chiquinquirá. En 2026 el descanso se observó el
    lunes 13 de julio por aplicación de la Ley Emiliani.
  </aside>
  <aside class="next-query"><strong>¿Trabajás uno de estos festivos?</strong> <a href="/co/trabajo/horas-extras-y-recargos">Calculá cuánto te pagan por trabajar un festivo o dominical →</a></aside>
  <FeriadosColombiaExperience />
  <FeriadosLatamLinks currentPath="/feriados-colombia-2026" />
  <Footer />
</Layout>
<style>
  .legal-update,.next-query{max-width:1120px;margin:1rem auto;padding:1rem 1.25rem;border-radius:14px}
  .legal-update{border:1px solid #fde68a;background:#fffbeb;color:#713f12}
  .legal-update a,.next-query a{font-weight:800}
  .next-query{border:1px solid #bfdbfe;background:#eff6ff}
</style>
