---
export const prerender = true;
import FeriadosLanding from '../components/FeriadosLanding.astro';
import { FERIADOS_LATAM_2026 } from '../lib/data/feriados-latam-2026';

const related = [
  { href: '/dias-entre-dos-fechas', label: 'Días entre dos fechas' },
  { href: '/calculadora-cuenta-regresiva-dias-faltan', label: 'Cuenta regresiva: cuántos días faltan' },
  { href: '/co/calculadora-cesantias-colombia-12-porciento-anual', label: 'Calculadora de cesantías Colombia 2026' },
  { href: '/co', label: 'Más calculadoras para Colombia' },
];

const title = 'Feriados Colombia 2026: los 19 festivos y puentes';
const description = 'Calendario Colombia 2026: los 19 días festivos y feriados nacionales con la fecha exacta, el día de la semana y los puentes de la Ley Emiliani. Mirá cuál es el próximo festivo y armá tus fines de semana largos.';
---
