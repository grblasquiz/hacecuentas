---
import CookieConsent from '../components/CookieConsent.astro';
import { ClientRouter } from 'astro:transitions';

// Self-hosted fonts (subset latin) — elimina render-blocking de Google Fonts.
// Antes (5 weights estáticos): 5 woff2 × ~17 KB = ~85 KB de Inter.
// Ahora (variable single-axis): 1 woff2 ~50 KB que cubre weight 100-900 con
// la misma calidad. Net: -35 KB descargados, menos round-trips, mismo CSS.
// Importamos el CSS único + el woff2 latin-wght-normal (axis: weight, no italic).
import '@fontsource-variable/inter/wght.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import interVariableFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object;
  image?: string;
  audience?: 'AR' | 'MX' | 'CL' | 'CO' | 'ES' | 'BO' | 'PE' | 'UY' | 'BR' | 'US' | 'GB' | 'CA' | 'AU' | 'global'; // país-específica o 'global'
  lang?: 'es' | 'en' | 'pt';
  hreflang?: Array<{lang: string, href: string}>;
  noindex?: boolean;
  keywords?: string[];      // calc.seoKeywords — Bing/Yandex aún leen <meta name=keywords>
  jsonFeed?: string;         // path al JSON Feed por-calc (LLMs parsean sin HTML)
  prevPage?: string;         // pagination — rel=prev
  nextPage?: string;         // pagination — rel=next
  ogType?: 'website' | 'article';  // 'article' para blog/calcs, 'website' para landings
  articleAuthor?: string;     // og:article:author
  articleSection?: string;    // og:article:section + Article.articleSection schema
  articleTags?: string[];     // og:article:tag
  articlePublishedTime?: string;  // og:article:published_time ISO
  articleModifiedTime?: string;   // og:article:modified_time ISO
  newsKeywords?: string[];   // <meta name=news_keywords> — Bing News indexing
}

const {
  title,
  description,
  canonical,
  schema,
  image = '/og-default.png',
  audience = 'global',
  lang,
  hreflang,
  noindex = false,
  keywords,
  jsonFeed,
  prevPage,
  nextPage,
  ogType = 'website',
  articleAuthor,
  articleSection,
  articleTags,
  articlePublishedTime,
  articleModifiedTime,
  newsKeywords,
} = Astro.props;

const siteUrl = 'https://hacecuentas.com';
// Cloudflare Pages sirve /foo.html en /foo — canonical sin .html para matchear sitemap
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const fullCanonical = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${cleanPath}`;
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Lang/locale dinámicos según audience y lang.
const _LANG_BY_AUDIENCE: Record<string, [string, string]> = {
  AR: ['es-AR', 'es_AR'], MX: ['es-MX', 'es_MX'], CL: ['es-CL', 'es_CL'],
  CO: ['es-CO', 'es_CO'], ES: ['es-ES', 'es_ES'], BO: ['es-BO', 'es_BO'],
  PE: ['es-PE', 'es_PE'], UY: ['es-UY', 'es_UY'], BR: ['pt-BR', 'pt_BR'],
  US: ['en-US', 'en_US'], GB: ['en-GB', 'en_GB'], CA: ['en-CA', 'en_CA'],
  AU: ['en-AU', 'en_AU'],
  global: ['es', 'es_419'],
};
const _audByLocale = _LANG_BY_AUDIENCE[audience] || _LANG_BY_AUDIENCE.global;
// htmlLang: para lang='en' usar el locale del audience si existe (en-US, en-GB, etc.)
// Si el audience no es EN-mercado pero lang='en', default a en-US (mercado prioritario Bing).
const htmlLang = lang === 'en'
  ? (['US','GB','CA','AU'].includes(audience) ? _audByLocale[0] : 'en-US')
  : lang === 'pt' ? 'pt-BR' : _audByLocale[0];

// Geo targeting por audience — Bing Local + Yandex usan; Google ignora.
const _GEO_BY_AUDIENCE: Record<string, {region: string; placename: string; icbm: string; country: string}> = {
  AR: { region: 'AR', placename: 'Buenos Aires, Argentina', icbm: '-34.6037, -58.3816', country: 'Argentina' },
  MX: { region: 'MX', placename: 'Ciudad de México, México', icbm: '19.4326, -99.1332', country: 'Mexico' },
  ES: { region: 'ES', placename: 'Madrid, España', icbm: '40.4168, -3.7038', country: 'Spain' },
  CL: { region: 'CL', placename: 'Santiago, Chile', icbm: '-33.4489, -70.6693', country: 'Chile' },
  CO: { region: 'CO', placename: 'Bogotá, Colombia', icbm: '4.7110, -74.0721', country: 'Colombia' },
  BR: { region: 'BR', placename: 'São Paulo, Brasil', icbm: '-23.5505, -46.6333', country: 'Brazil' },
  US: { region: 'US', placename: 'Washington, DC, United States', icbm: '38.8951, -77.0364', country: 'United States' },
  GB: { region: 'GB', placename: 'London, United Kingdom', icbm: '51.5074, -0.1278', country: 'United Kingdom' },
  CA: { region: 'CA', placename: 'Ottawa, Canada', icbm: '45.4215, -75.6972', country: 'Canada' },
  AU: { region: 'AU', placename: 'Canberra, Australia', icbm: '-35.2809, 149.1300', country: 'Australia' },
};
// _geo default: si lang='en' default a US (mercado Bing prioritario); pt → BR; es → AR.
const _geo = _GEO_BY_AUDIENCE[audience] ||
  (lang === 'en' ? _GEO_BY_AUDIENCE.US : lang === 'pt' ? _GEO_BY_AUDIENCE.BR : _GEO_BY_AUDIENCE.AR);
const ogLocale = lang === 'en'
  ? (['US','GB','CA','AU'].includes(audience) ? _audByLocale[1] : 'en_US')
  : lang === 'pt' ? 'pt_BR' : _audByLocale[1];
const schemaLang = htmlLang;

// Schema.org WebSite + Organization global (siempre presente)
const globalSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Hacé Cuentas',
      url: siteUrl,
      logo: `${siteUrl}/logo.png`,
      description: lang === 'en'
        ? 'Free online calculators covering finance, health, cooking, math and more — no signup, private, fast.'
        : lang === 'pt'
        ? 'Calculadoras online grátis de finanças, saúde, cozinha, matemática e mais — sem cadastro, privadas, rápidas.'
        : 'Calculadoras online gratuitas para todo el mundo hispanohablante, con cobertura específica para Argentina.',
      sameAs: [
        'https://x.com/Hacecuentas',
        'https://www.linkedin.com/company/122324467/',
        'https://github.com/grblasquiz/hacecuentas',
        'https://www.wikidata.org/wiki/Q139824747',
      ],
      identifier: {
        '@type': 'PropertyValue',
        propertyID: 'Wikidata',
        value: 'Q139824747',
      },
      // knowsAbout: declara expertise temática para que LLMs (ChatGPT, Claude,
      // Perplexity, Copilot) construyan el grafo de conocimiento de la marca.
      // Cubre las áreas con tráfico real GSC/Bing/GA4 y las categorías core.
      knowsAbout: [
        'Monotributo Argentina',
        'Sueldo neto Argentina',
        'Aguinaldo SAC',
        'Impuesto a las Ganancias 4ta categoría',
        'Ingresos Brutos provinciales Argentina',
        'Indemnización por despido Argentina',
        'Jubilación ANSES',
        'Costos de construcción Argentina',
        'Impuesto de Sellos Argentina',
        'Recategorización Monotributo',
        'Calculadoras financieras',
        'Calculadoras de salud',
        'Conversiones de unidades',
        'Calculadoras de cocina',
        'Cálculos de embarazo',
      ],
      // areaServed: refuerza segmentación geográfica para Bing AI y AI Overviews
      // que priorizan resultados locales.
      areaServed: [
        { '@type': 'Country', name: 'Argentina' },
        { '@type': 'Country', name: 'México' },
        { '@type': 'Country', name: 'Colombia' },
        { '@type': 'Country', name: 'Chile' },
        { '@type': 'Country', name: 'España' },
        { '@type': 'Country', name: 'Perú' },
      ],
      // publishingPrinciples: refuerza E-E-A-T (Article-level y Org-level)
      publishingPrinciples: `${siteUrl}/politica-editorial`,
      // founder + employee: ancla la Person (Martín) al Organization. Google
      // Knowledge Graph usa estos edges para construir entity relationships.
      founder: { '@id': `${siteUrl}/autores/martin-rodriguez#person` },
      employee: { '@id': `${siteUrl}/autores/martin-rodriguez#person` },
    },
    {
      // Person global (Martín Rodríguez) — referenciable por @id desde Article,
      // Recipe, etc. Definición canónica vive en /autores/martin-rodriguez.
      '@type': 'Person',
      '@id': `${siteUrl}/autores/martin-rodriguez#person`,
      name: 'Martín Rodríguez',
      url: `${siteUrl}/autores/martin-rodriguez`,
      jobTitle: 'Fundador y editor responsable',
      worksFor: { '@id': `${siteUrl}/#organization` },
      sameAs: ['https://github.com/grblasquiz'],
      nationality: { '@type': 'Country', name: 'Argentina' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Hacé Cuentas',
      publisher: { '@id': `${siteUrl}/#organization` },
      inLanguage: lang === 'en' ? ['en', 'en-US'] : lang === 'pt' ? ['pt', 'pt-BR', 'pt-PT'] : ['es', 'es-AR', 'es-419'],
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: lang === 'en' ? `${siteUrl}/en?q={search_term_string}` : lang === 'pt' ? `${siteUrl}/pt?q={search_term_string}` : `${siteUrl}/buscar?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    // SiteNavigationElement: ayuda a Google a entender el menú principal
    // y a generar sitelinks en SERP debajo del resultado principal del brand.
    lang === 'en' ? {
      '@type': 'SiteNavigationElement',
      '@id': `${siteUrl}/en/#nav`,
      name: [
        'All calculators', 'Finance', 'Health & Fitness', 'Math', 'Cooking',
        'Sports', 'Pets', 'Family', 'Home & Construction', 'Tech',
      ],
      url: [
        `${siteUrl}/en`,
        `${siteUrl}/en/compound-interest-calculator`,
        `${siteUrl}/en/bmi-calculator`,
        `${siteUrl}/en/percentage-calculator`,
        `${siteUrl}/en/cups-to-grams-converter`,
        `${siteUrl}/en/running-pace-calculator`,
        `${siteUrl}/en/cat-age-to-human-years`,
        `${siteUrl}/en/pregnancy-due-date-calculator`,
        `${siteUrl}/en/ceramic-tile-calculator`,
        `${siteUrl}/en/claude-gemini-tokens-pricing-comparison`,
      ],
    } : lang === 'pt' ? {
      '@type': 'SiteNavigationElement',
      '@id': `${siteUrl}/pt/#nav`,
      name: [
        'Todas as calculadoras', 'Finanças', 'Saúde e Fitness', 'Matemática',
        'Culinária', 'Esportes', 'Animais', 'Família', 'Construção', 'Tecnologia',
      ],
      url: [
        `${siteUrl}/pt`,
        `${siteUrl}/pt`,
        `${siteUrl}/pt`,
        `${siteUrl}/pt`,
        `${siteUrl}/pt`,
        `${siteUrl}/pt`,
        `${siteUrl}/pt`,
        `${siteUrl}/pt`,
        `${siteUrl}/pt`,
        `${siteUrl}/pt`,
      ],
    } : {
      '@type': 'SiteNavigationElement',
      '@id': `${siteUrl}/#nav`,
      name: [
        'Cambio de monedas', 'Cripto', 'Inflación', 'Guías', 'Finanzas',
        'Salud', 'Marketing', 'Viajes', 'Vida diaria', 'Presupuesto familiar',
        'Simulador jubilación', 'Buscador',
      ],
      url: [
        `${siteUrl}/cambio-de-monedas`,
        `${siteUrl}/cotizacion-cripto`,
        `${siteUrl}/inflacion-argentina`,
        `${siteUrl}/guias`,
        `${siteUrl}/categoria/finanzas`,
        `${siteUrl}/categoria/salud`,
        `${siteUrl}/categoria/marketing`,
        `${siteUrl}/categoria/viajes`,
        `${siteUrl}/categoria/vida`,
        `${siteUrl}/presupuesto-familiar`,
        `${siteUrl}/simulador-jubilacion-anses`,
        `${siteUrl}/buscar`,
      ],
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Speculation Rules vacío — Chrome lo respeta y NO hace prefetch
        automático con header `Sec-Purpose: prefetch`. CF Pages rechaza esos
        prefetches con 503 (`cf-speculation-refused: disabled for worker
        requests`) porque todas nuestras rutas pasan por Worker (middleware +
        wrapper.mjs para redirects/410). Esto ensucia consola y desperdicia
        bandwidth sin servir prefetch real. Astro ClientRouter sigue
        haciendo su propio prefetch on-hover vía fetch normal (sin header
        Sec-Purpose). */}
    <script type="speculationrules" is:inline set:html={`{"prefetch":[]}`}></script>
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <!-- Favicon v3 (logo completo sin bandas blancas) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=3" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Theme init: prevent FOUC leyendo localStorage antes del paint.
         Default = light (ignoramos prefers-color-scheme del OS).
         El user puede activar dark con el toggle, se persiste en localStorage. -->
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && (
      <meta name="keywords" content={keywords.slice(0, 10).join(', ')} />
    )}
    {/* Señales legacy — Google las ignora pero Bing/Yandex/Baidu las leen.
        rating=general previene filtrado por safe-search; distribution=global
        confirma que el contenido aplica internacionalmente. */}
    <meta name="rating" content="general" />
    <meta name="distribution" content="global" />
    <meta name="revisit-after" content="7 days" />

    {/* Geo targeting — Bing Local + Yandex usan estos; Google ignora.
        AR es el mercado principal (62%+ del tráfico); para otras audiences
        ajustamos a su país. Map definido en frontmatter (_geo). */}
    <meta name="geo.region" content={_geo.region} />
    <meta name="geo.placename" content={_geo.placename} />
    <meta name="geo.position" content={_geo.icbm.replace(', ', ';')} />
    <meta name="ICBM" content={_geo.icbm} />
    <meta name="country" content={_geo.country} />

    {/* content-language: Bing y crawlers viejos lo leen como señal idioma fuerte
        (separada del <html lang>). Google deprecó este meta pero no penaliza. */}
    <meta http-equiv="content-language" content={htmlLang} />

    {/* Bing Webmaster Tools verification — token setea via env si Martin lo registra.
        PUBLIC_BING_SITE_VERIFICATION en .env (sin token, no se renderiza). */}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}

    {/* News keywords: Bing News indexa este campo prioritariamente. Diferente
        a meta keywords — son comma-separated topical keywords. */}
    {newsKeywords && newsKeywords.length > 0 && (
      <meta name="news_keywords" content={newsKeywords.slice(0, 10).join(', ')} />
    )}
    {/* Robots: max-image-preview:large habilita que Google Discover use
         nuestras OG images en full-width cards del feed Android/Chrome.
         Sin este tag, Discover limita los thumbnails o los omite. Es la
         señal #1 para optar-in a Discover según los docs de Google. */}
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    }
    {/* Bing-specific directives — Bingbot lee este tag y lo prioriza sobre el
       generico "robots". Mantenemos los mismos valores que Google + index/follow
       explicito (Bing a veces es mas conservador).
       2026-05-25: REMOVIDO `noarchive` porque bloqueaba Copilot/grounding results
       (BWT warning "Important URLs visible in search cannot appear in Copilot").
       Bing necesita poder cachear el contenido para usarlo como fuente en AI. */}
    {!noindex && (
      <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <link rel="canonical" href={fullCanonical} />
    {hreflang ? (
      hreflang.map(h => <link rel="alternate" hreflang={h.lang} href={h.href} />)
    ) : lang === 'en' ? (
      /* Página inglés sin alternates conocidos. */
      <>
        <link rel="alternate" hreflang="en" href={fullCanonical} />
        <link rel="alternate" hreflang="x-default" href={fullCanonical} />
      </>
    ) : lang === 'pt' ? (
      /* Página portugués sin alternates conocidos. */
      <>
        <link rel="alternate" hreflang="pt-BR" href={fullCanonical} />
        <link rel="alternate" hreflang="x-default" href={fullCanonical} />
      </>
    ) : audience !== 'global' ? (
      /* País-específico (AR/MX/ES/CL/CO/...): hreflang con código país completo. */
      <>
        <link rel="alternate" hreflang={_audByLocale[0]} href={fullCanonical} />
        <link rel="alternate" hreflang="x-default" href={fullCanonical} />
      </>
    ) : (
      /* Página global (sin variante por país): solo es + x-default. */
      <>
        <link rel="alternate" hreflang="es" href={fullCanonical} />
        <link rel="alternate" hreflang="x-default" href={fullCanonical} />
      </>
    )}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Hacé Cuentas — Calculadoras actualizadas" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="Hacé Cuentas — JSON Feed" href="/feed.json" />
    {/* JSON Feed per-calc (LLMs/scrapers parsean datos sin HTML). */}
    {jsonFeed && <link rel="alternate" type="application/json" title="Calculadora JSON" href={jsonFeed} />}
    {/* Paginación: rel=prev/next aún ayudan a Bing y Yandex con crawl budget. */}
    {prevPage && <link rel="prev" href={prevPage} />}
    {nextPage && <link rel="next" href={nextPage} />}
    <link rel="search" type="application/opensearchdescription+xml" title="Hacé Cuentas" href="/opensearch.xml" />
    <!-- Wikidata entity — identifica al sitio como entidad reconocida en el knowledge graph -->
    <link rel="me" href="https://www.wikidata.org/wiki/Q139824747" />

    <!-- Open Graph — og:type dinámico por tipo de página. Bing News usa
         og:type=article para indexar más rápido + mostrar en News tab. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />

    {/* Article-specific OG tags (cuando ogType='article'). Bing News + LinkedIn
        usan estos para enriquecer el preview + indexar como artículo. */}
    {ogType === 'article' && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {ogType === 'article' && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}
    {ogType === 'article' && articleTags && articleTags.slice(0, 5).map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {/* og:locale:alternate — todas las variantes localizadas declaradas. Permite
        a Facebook/LinkedIn/WhatsApp ofrecer la versión correcta del país del user. */}
    {ogLocale !== 'es_AR' && <meta property="og:locale:alternate" content="es_AR" />}
    {ogLocale !== 'es_MX' && <meta property="og:locale:alternate" content="es_MX" />}
    {ogLocale !== 'es_ES' && <meta property="og:locale:alternate" content="es_ES" />}
    {ogLocale !== 'es_CL' && <meta property="og:locale:alternate" content="es_CL" />}
    {ogLocale !== 'es_CO' && <meta property="og:locale:alternate" content="es_CO" />}
    {ogLocale !== 'en_US' && <meta property="og:locale:alternate" content="en_US" />}
    {ogLocale !== 'pt_BR' && <meta property="og:locale:alternate" content="pt_BR" />}
    <meta property="og:site_name" content="Hacé Cuentas" />

    {/* LinkedIn signals — Microsoft Bing tiene partnership con LinkedIn y
        consume estos tags para enriquecer previews + authority signals.
        Zero JS overhead, solo meta tags estaticos. */}
    <meta property="article:publisher" content="https://www.linkedin.com/company/hacecuentas/" />
    <meta name="linkedin:owner" content="hacecuentas" />

    <!-- Twitter Cards — Bing/Copilot también consumen estos tags directamente
         (Bing es Microsoft + Twitter colab, signals fuertes para News + Discover) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:image:width" content="1200" />
    <meta name="twitter:image:height" content="630" />
    <meta name="twitter:site" content="@hacecuentas" />
    {articleAuthor && <meta name="twitter:creator" content={articleAuthor.startsWith('@') ? articleAuthor : '@hacecuentas'} />}
    <meta name="twitter:domain" content="hacecuentas.com" />

    <!-- Pinterest Rich Pins fallback (cuando page no override via props).
         Si props pasaron articleAuthor/Section, ya se renderizaron arriba. -->
    {!articleAuthor && <meta property="article:author" content="Martín Rodríguez" />}
    <meta property="article:publisher" content="https://hacecuentas.com" />
    {!articleSection && <meta property="article:section" content="Calculadoras" />}
    <meta name="pinterest-rich-pin" content="true" />
    <!-- Verificación Pinterest se hace via Webmaster con tag específico cuando Martin la crea -->
    <link rel="alternate" type="application/json+oembed" href="https://hacecuentas.com/oembed.json" title="oEmbed JSON" />

    <!-- Schema.org global (Organization + WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />
    <!-- Schema.org específico de página -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Fuente Inter Variable single file: cubre todos los weights 100-900.
         Antes: preload del weight 800. Ahora: preload del archivo único
         variable que también sirve a 400/500/600/700. Mismo overhead pero
         fuentes secundarias (body/headings) ya no esperan red al primer
         render. -->
    <link rel="preload" href={interVariableFontUrl} as="font" type="font/woff2" crossorigin />

    <!-- Critical CSS inline para el LCP element (hero-lead en homepage).
         El CSS scoped del index.astro (24KB) es render-blocking y suma ~2s al
         element render delay en mobile 3G (Lighthouse). Inlinear las pocas
         reglas del hero permite que el browser paintee el <p class=hero-lead>
         antes de descargar el CSS completo. Selectores sin data-astro-cid-*
         para matchear cualquier scope hash. -->
    <style>
      .hero { padding: 3.5rem 0 2.5rem; text-align: center; position: relative; }
      .hero-title { font-size: clamp(2rem, 5.5vw, 3.5rem); line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 1.25rem; font-weight: 800; }
      .hero-lead { font-size: 1.0625rem; max-width: 620px; margin: 0 auto 1rem; color: var(--text-muted); line-height: 1.6; }
      .trust-row { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-bottom: 1.5rem; }
      .trust-pill { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.3125rem 0.75rem; background: var(--success-soft); color: var(--success); border-radius: 999px; font-size: 0.8125rem; font-weight: 500; }
    </style>

    <!-- Preconnect: establece conexión (DNS + TCP + TLS) antes de que se necesite.
         Googletagmanager se pide en ~todos los page views. cdn.jsdelivr solo en
         calcs que usan Chart.js, dns-prefetch alcanza. APIs live (BCRA, dolar,
         coingecko) se prefetchean para LiveData.astro — la conexión queda
         caliente antes que el JS la dispare. -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="https://dolarapi.com" />
    <link rel="dns-prefetch" href="https://api.argentinadatos.com" />
    <link rel="dns-prefetch" href="https://api.coingecko.com" />
    <link rel="dns-prefetch" href="https://open.er-api.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />

    <!-- Google Consent Mode v2
         Default 'granted' para analytics (Argentina/LATAM no requiere opt-in bajo Ley 25.326).
         ad_storage denied por default por compliance UE / Google Ads; user lo activa via banner.
         url_passthrough + ads_data_redaction permiten pings cookieless cuando el user rechaza.
         wait_for_update bajado a 500ms — con analytics_storage granted default no
         necesitamos esperar tanto; 2000ms hacía perder sesiones cortas. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'granted',
        functionality_storage: 'granted',
        security_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
      gtag('set', 'url_passthrough', true);
      gtag('set', 'ads_data_redaction', true);
      gtag('js', new Date());
      // send_page_view true (default) + anonymize_ip. Config explícito para debug.
      gtag('config', 'G-789KMTKWX2', {
        anonymize_ip: true,
        send_page_view: true,
      });
      gtag('config', 'AW-18096606872');
      function gtagSendEvent(url) {
        var callback = function () {
          if (typeof url === 'string') { window.location = url; }
        };
        gtag('event', 'conversion_event_default', {
          'event_callback': callback,
          'event_timeout': 2000,
        });
        return false;
      }
      // Helper sin navegación: dispara conversion_event_default sin redirigir.
      // Usado por Calculator.astro al completar cada cálculo (cada uso = 1 conversión).
      function gtagTriggerConversion() {
        if (typeof gtag !== 'function') return;
        gtag('event', 'conversion_event_default', {});
      }
    </script>
    <!-- gtag.js async en <head>. NIVEL 1: el fetch tiene que arrancar ASAP.
         Antes estaba al final del <body> para "no bloquear render", pero async
         no bloquea render desde ninguna posición — y al final del body el request
         recién salía después de parsear todo el DOM, perdiendo pageviews en sesiones
         cortas (bounce <2s, clicks rápidos). Con async en head la red arranca
         inmediato y el inline de arriba ya dejó el pageview encolado en dataLayer.
         IMPORTANTE: un solo <script gtag/js> es suficiente para múltiples productos
         Google (GA4 + Ads). El gtag('config','AW-...') del inline registra el ID de
         Ads en el runtime ya cargado. Cargar 2 scripts de gtag/js duplica 105KB
         de JS unused sin agregar funcionalidad. (PSI audit 2026-05-19: confirmado). -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-789KMTKWX2"></script>

    <!-- Microsoft Clarity (signal positiva para Bing/Copilot rankings) -->
    <!-- Se activa solo si está seteada la env var PUBLIC_MS_CLARITY_ID en build. -->
    {import.meta.env.PUBLIC_MS_CLARITY_ID && (
      <script set:html={`(function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "${import.meta.env.PUBLIC_MS_CLARITY_ID}");`} />
    )}

    {/* Scroll-depth tracker idle/lazy — dispara eventos Clarity en 25/50/75/100%
        del scroll. Bing usa Clarity engagement signals para ranking. Cero overhead
        en LCP/INP: arranca solo despues de window.load + requestIdleCallback,
        scroll listener pasivo, idempotent por umbral. */}
    {import.meta.env.PUBLIC_MS_CLARITY_ID && (
      <script set:html={`window.addEventListener('load',function(){(window.requestIdleCallback||function(f){return setTimeout(f,500)})(function(){var fired={};var thresholds=[25,50,75,100];function send(d){if(fired[d]||typeof clarity!=='function')return;fired[d]=1;try{clarity('event','scroll_'+d);}catch(e){}}function check(){var f=document.body;var h=Math.max(f.scrollHeight,document.documentElement.scrollHeight)-window.innerHeight;if(h<=0){send(100);return;}var p=Math.round((window.scrollY/h)*100);thresholds.forEach(function(t){if(p>=t)send(t);});}window.addEventListener('scroll',check,{passive:true});check();},{timeout:2000});});`} />
    )}

    <!-- View Transitions: navegación SPA-like entre páginas. Reduce flash de
         contenido + mantiene scroll position en navigation. fallback='swap'
         para browsers sin View Transitions API (Safari < 18, Firefox sin flag). -->
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <!-- Print-only header (hidden on screen, visible when printing) -->
    <div class="print-header" aria-hidden="true">{lang === 'en' ? 'Calculator result — hacecuentas.com' : lang === 'pt' ? 'Resultado da calculadora — hacecuentas.com' : 'Resultado de calculadora — hacecuentas.com'}</div>

    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
    <CookieConsent />

    <!-- Core Web Vitals — sample 25%, lazy load, sendBeacon a /api/vitals + GA4.
         Reporta LCP, INP, CLS, FCP, TTFB. La librería web-vitals decide cuándo
         disparar cada métrica (LCP en hidden, INP en pagehide, etc).
         El cliente samplea: si no entra en el 25% no carga el módulo.
         Script sin is:inline → Astro lo bundlea con `web-vitals` local (respeta CSP self). -->
    <script>
      // Sample 25% antes de cargar el módulo (ahorra bytes a 75% de pageviews)
      if (Math.random() <= 0.25) {
        const idle = (window as any).requestIdleCallback || ((fn: () => void) => setTimeout(fn, 1));
        idle(async () => {
          try {
            const { onLCP, onINP, onCLS, onFCP, onTTFB } = await import('web-vitals');
            const url = location.pathname + location.search;
            type Metric = { name: string; value: number; rating: string; id: string; navigationType?: string };
            const report = (m: Metric) => {
              const payload = {
                url,
                metric: m.name,
                value: m.value,
                rating: m.rating,
                id: m.id,
                navigationType: m.navigationType,
              };
              // 1) D1 propio (best-effort, no espera)
              try {
                const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
                if (navigator.sendBeacon) navigator.sendBeacon('/api/vitals', blob);
                else fetch('/api/vitals', { method: 'POST', body: blob, keepalive: true }).catch(() => {});
              } catch {}
              // 2) GA4 mirror — para Looker Studio
              try {
                const g = (window as any).gtag;
                if (typeof g === 'function') {
                  g('event', 'web_vital', {
                    metric_name: m.name,
                    metric_value: m.name === 'CLS' ? m.value * 1000 : m.value,
                    metric_rating: m.rating,
                    metric_id: m.id,
                    page_path: url,
                    non_interaction: true,
                  });
                }
              } catch {}
            };
            onLCP(report);
            onINP(report);
            onCLS(report);
            onFCP(report);
            onTTFB(report);
          } catch {}
        });
      }
    </script>

    <!-- Service Worker — solo en producción y si el browser lo soporta -->
    <!-- SW registration + print-header date: diferidos a idle para no bloquear TBT -->
    <script is:inline>
      (function () {
        var deferFn = window.requestIdleCallback || function (fn) { return setTimeout(fn, 1); };
        deferFn(function () {
          // Service Worker
          if ('serviceWorker' in navigator && location.protocol === 'https:') {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          }
          // Print header date (lang-aware via html lang attr)
          var ph = document.querySelector('.print-header');
          if (ph) {
            var d = new Date();
            var htmlLang = (document.documentElement.lang || '').toLowerCase();
            var isEn = htmlLang.indexOf('en') === 0;
            var isPt = htmlLang.indexOf('pt') === 0;
            var locale = isEn ? 'en-US' : isPt ? 'pt-BR' : 'es-AR';
            var fecha = d.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
            var label = isEn ? 'Calculator result' : isPt ? 'Resultado da calculadora' : 'Resultado de calculadora';
            ph.textContent = label + ' — hacecuentas.com — ' + fecha;
          }
        });
      })();
    </script>

    <style is:global>
      /* Print header: hidden on screen, shown on print */
      .print-header { display: none; }
      :root {
        /* Surfaces */
        --bg: #ffffff;
        --bg-soft: #f8fafc;
        --bg-muted: #f1f5f9;
        --bg-card: #ffffff;

        /* Borders */
        --border: #e2e8f0;
        --border-strong: #cbd5e1;

        /* Text */
        --text: #0f172a;
        --text-muted: #475569;
        --text-subtle: #64748b;

        /* Brand — trust blue */
        --accent: #2563eb;
        --accent-hover: #1d4ed8;
        --accent-soft: #eff6ff;
        --accent-strong: #1e40af;

        /* Status */
        --success: #16a34a;
        --success-soft: #f0fdf4;
        --danger: #dc2626;
        --danger-soft: #fef2f2;
        --warning: #d97706;
        --warning-soft: #fffbeb;

        /* Elevation */
        --shadow-sm: 0 1px 2px 0 rgb(15 23 42 / 0.05);
        --shadow: 0 1px 3px 0 rgb(15 23 42 / 0.08), 0 1px 2px -1px rgb(15 23 42 / 0.06);
        --shadow-md: 0 4px 6px -1px rgb(15 23 42 / 0.08), 0 2px 4px -2px rgb(15 23 42 / 0.05);
        --shadow-lg: 0 10px 15px -3px rgb(15 23 42 / 0.1), 0 4px 6px -4px rgb(15 23 42 / 0.05);

        /* Radii */
        --radius-sm: 6px;
        --radius: 10px;
        --radius-lg: 14px;
        --radius-xl: 20px;

        /* Type */
        --font-body: 'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'JetBrains Mono', 'SF Mono', Monaco, monospace;
      }

      /* Dark mode — data-theme="dark" en <html> */
      html[data-theme="dark"] {
        --bg: #0f172a;
        --bg-soft: #1e293b;
        --bg-muted: #334155;
        --bg-card: #1e293b;

        --border: #334155;
        --border-strong: #475569;

        --text: #f1f5f9;
        --text-muted: #cbd5e1;
        --text-subtle: #94a3b8;

        --accent: #60a5fa;
        --accent-hover: #3b82f6;
        --accent-soft: #1e3a8a33;
        --accent-strong: #93c5fd;

        --success: #4ade80;
        --success-soft: #14532d33;
        --danger: #f87171;
        --danger-soft: #7f1d1d33;
        --warning: #fbbf24;
        --warning-soft: #78350f33;

        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.25);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.35), 0 1px 2px -1px rgb(0 0 0 / 0.25);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.35), 0 2px 4px -2px rgb(0 0 0 / 0.25);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.5), 0 4px 6px -4px rgb(0 0 0 / 0.3);
      }

      html[data-theme="dark"] ::selection {
        background: var(--accent-soft);
        color: var(--accent-strong);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: var(--font-body);
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      body {
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
        font-size: 16px;
      }

      main {
        max-width: 1120px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }

      h1, h2, h3, h4 {
        line-height: 1.2;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.015em;
      }

      h1 {
        font-size: clamp(1.875rem, 4vw, 2.75rem);
        letter-spacing: -0.025em;
        font-weight: 800;
      }

      h2 {
        font-size: clamp(1.375rem, 3vw, 1.875rem);
        margin-bottom: 0.5rem;
      }

      h3 {
        font-size: 1.125rem;
      }

      h4 {
        font-size: 0.9375rem;
        font-weight: 600;
      }

      p {
        color: var(--text-muted);
        line-height: 1.65;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.15s;
      }

      a:hover {
        color: var(--accent-hover);
      }

      button {
        font-family: inherit;
        cursor: pointer;
        border: none;
        background: none;
      }

      input, select, textarea {
        font-family: inherit;
        font-size: 1rem;
        color: inherit;
      }

      ::selection {
        background: var(--accent-soft);
        color: var(--accent-strong);
      }

      /* Focus ring universal */
      *:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      .container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      /* Respect prefers-reduced-motion */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
        html { scroll-behavior: auto; }
      }

      /* ========================================
         Print stylesheet — PDF-friendly output
         ======================================== */
      @media print {
        :root {
          --bg: #fff;
          --bg-soft: #fff;
          --bg-card: #fff;
          --bg-muted: #fff;
          --border: #ccc;
          --border-strong: #999;
          --text: #000;
          --text-muted: #333;
          --text-subtle: #555;
          --accent: #000;
          --accent-soft: #eee;
          --accent-hover: #000;
          --accent-strong: #000;
          --shadow-sm: none;
          --shadow: none;
          --shadow-md: none;
          --shadow-lg: none;
        }

        /* 1. System fonts — remove web fonts for print */
        html {
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif !important;
        }
        * {
          font-family: inherit !important;
        }
        code, pre, .result-value, [data-value] {
          font-family: 'Courier New', Courier, monospace !important;
        }

        /* 2. Clean base — black on white, no decorations */
        body {
          font-size: 11pt;
          color: #000;
          background: #fff !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        main { max-width: 100%; padding: 0; margin: 0; }

        /* 3. Hide non-essential elements */
        header, footer, .skip-link, nav:not(.breadcrumbs),
        .scroll-top, .scroll-progress, .related, .hero-featured, .sources,
        .hero-meta, .explanation, .faq, .key-takeaway, .intro, .use-cases,
        .example-box, .seo-content, .cat-faq, .hc-embed-overlay,
        /* Cookie consent & modal */
        .hc-cookie-banner, .hc-cookie-modal,
        /* Share buttons, embed button */
        .share, .embed-cta,
        /* Feedback section */
        .feedback,
        /* Search overlay */
        #search-modal,
        /* CTA & navigation */
        .cta-back, .mobile-nav,
        /* Theme toggle, menu toggle, search btn */
        #theme-toggle, #menu-toggle, #open-search,
        /* Data update badge (not useful on print) */
        .data-update,
        /* Presets section (already selected) */
        .presets { display: none !important; }

        /* Hide all interactive buttons on print */
        button { display: none !important; }

        /* 4. Show calculator title (h1) prominently */
        .breadcrumbs { font-size: 9pt; color: #666; margin-bottom: 0.5cm; }
        h1 { font-size: 20pt; margin-bottom: 0.3cm; }
        a, a:visited { color: #000; text-decoration: none; }

        /* 5. Calculator container — clean, no shadows/radius */
        .calc-container {
          border: 1px solid #000;
          box-shadow: none !important;
          border-radius: 0 !important;
          page-break-inside: avoid;
          padding: 0.75cm;
        }

        /* 6. Inputs — visible with their values */
        .calc-form {
          page-break-inside: avoid;
        }
        .field-group {
          margin-bottom: 0.3cm;
        }
        input, select, textarea {
          border: 1px solid #999 !important;
          background: #fff !important;
          box-shadow: none !important;
          border-radius: 0 !important;
          padding: 0.15cm 0.25cm;
          font-size: 10pt;
        }
        label {
          font-size: 9pt;
          font-weight: 600;
          color: #000;
        }
        /* Show advanced fields (they might be hidden) */
        .advanced-fields, .advanced-fields[hidden] {
          display: block !important;
        }

        /* 7. Results — prominent display */
        .calc-results, .calc-results[hidden] {
          display: block !important;
        }
        .results-grid {
          gap: 0.3cm;
        }
        .result {
          border: 1px solid #999;
          border-radius: 0 !important;
          box-shadow: none !important;
          padding: 0.3cm 0.4cm;
          page-break-inside: avoid;
          background: #fff !important;
        }
        .result.primary {
          background: #f0f0f0 !important;
          color: #000 !important;
          border: 2px solid #000;
          font-size: 12pt;
        }
        .result-label {
          font-size: 9pt;
          color: #333;
        }
        .result-value {
          font-size: 14pt;
          font-weight: 700;
          color: #000 !important;
        }
        .result.primary .result-value {
          font-size: 18pt;
        }

        /* 8. Chart — show if visible, avoid break */
        .chart-wrap {
          page-break-inside: avoid;
          margin-top: 0.5cm;
        }
        .chart-wrap[hidden] { display: none !important; }

        /* 9. Disclaimer — keep visible */
        .inline-disclaimer {
          font-size: 8pt;
          color: #555;
          border: none;
          padding: 0.2cm 0;
          background: none !important;
        }

        /* 10. Page break rules */
        h1, h2, h3 { page-break-after: avoid; }
        .result { page-break-inside: avoid; }

        /* 11. Remove all shadows, border-radius, decorative elements */
        *, *::before, *::after {
          box-shadow: none !important;
          text-shadow: none !important;
        }

        /* 12. Print header — "Resultado de calculadora" + date via JS-injected element */
        .print-header {
          display: block !important;
          font-size: 9pt;
          color: #666;
          text-align: center;
          padding-bottom: 0.4cm;
          margin-bottom: 0.5cm;
          border-bottom: 1px solid #ccc;
        }

        /* 13. Branding footer on printed pages */
        @page {
          margin: 1.5cm;
        }
        body::after {
          content: "Cálculo generado con hacecuentas.com";
          display: block;
          text-align: center;
          font-size: 9pt;
          color: #666;
          margin-top: 1cm;
          padding-top: 0.5cm;
          border-top: 1px solid #ccc;
        }

        /* 14. Calc container header with slug */
        .calc-container::before {
          content: "Hacé Cuentas · " attr(data-slug);
          display: block;
          font-size: 9pt;
          color: #888;
          margin-bottom: 0.5cm;
          text-transform: uppercase;
          letter-spacing: 0.05em;
        }
      }
    </style>
  </body>
</html>
