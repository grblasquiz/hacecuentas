---
/** Correcciones transversales para templates legacy/generados. */
---

<script is:inline>
  (function () {
    function enhance(root) {
      var scope = root && root.querySelectorAll ? root : document;

      // Un searchbox no admite aria-expanded. Cuando controla un listbox es un
      // combobox real; si no controla nada, aria-expanded se elimina.
      scope.querySelectorAll('input[type="search"][aria-expanded]').forEach(function (input) {
        var controls = input.getAttribute('aria-controls');
        var popup = controls && document.getElementById(controls);
        if (popup && popup.getAttribute('role') === 'listbox') {
          input.setAttribute('role', 'combobox');
          input.setAttribute('aria-autocomplete', 'list');
          input.setAttribute('aria-haspopup', 'listbox');
        } else {
          input.removeAttribute('aria-expanded');
        }
      });

      // Los mockups generados combinan labels reales, spans visuales y matrices
      // compactas. Asociamos primero texto visible; placeholder/title quedan
      // sólo como último recurso para no inventar nombres genéricos.
      var serial = Number(document.body?.dataset.hcA11ySerial || 0);
      function cleanName(value) {
        return String(value || '').replace(/[\s:*]+$/g, '').replace(/\s+/g, ' ').trim().slice(0, 120);
      }
      function validName(value, control) {
        var name = cleanName(value);
        if (name.length < 2) return '';
        if (name === cleanName(control.value) || /^[-+]?[$€£]?\s*[\d.,%]+$/.test(name)) return '';
        return name;
      }
      function visibleText(node, control) {
        if (!node || node === control || node.hidden || node.getAttribute?.('aria-hidden') === 'true') return '';
        return validName(node.textContent, control);
      }
      function ensureId(node, prefix) {
        if (!node.id) node.id = prefix + '-' + (++serial);
        return node.id;
      }
      scope.querySelectorAll('input, select, textarea').forEach(function (control) {
        if (control.type === 'hidden' || control.getAttribute('aria-label') || control.getAttribute('aria-labelledby')) return;
        if (control.id && document.querySelector('label[for="' + CSS.escape(control.id) + '"]')) return;
        if (control.closest('label')) return;
        var wrap = control.parentElement && control.parentElement.closest('.field, .smonth, .input-wrap, .form-group, .control, .calc-field, .input-group, [class*="field"], [class*="input-row"]');
        var label = wrap && wrap.querySelector('label');
        if (label) {
          if (!control.id) control.id = 'hc-auto-field-' + (++serial);
          label.setAttribute('for', control.id);
          return;
        }
        var candidate = wrap && wrap.querySelector('.field-label, .input-label, [class~="label"], [class$="-label"], [data-label], legend, small');
        var name = visibleText(candidate, control);
        if (name && candidate) {
          control.setAttribute('aria-labelledby', ensureId(candidate, 'hc-auto-label'));
          return;
        }
        var previous = control.previousElementSibling;
        name = visibleText(previous, control);
        if (name && previous && !previous.matches('input, select, textarea, button')) {
          control.setAttribute('aria-labelledby', ensureId(previous, 'hc-auto-label'));
          return;
        }
        var cell = control.closest('td, th');
        var row = cell && cell.closest('tr');
        if (cell && row) {
          var cells = Array.from(row.children);
          var column = cells.indexOf(cell);
          var table = row.closest('table');
          var rowName = visibleText(row.querySelector('th, td'), control);
          var header = table && table.querySelector('thead tr');
          var columnName = header && visibleText(header.children[column], control);
          name = cleanName([rowName, columnName].filter(Boolean).join(' — '));
          if (name) {
            control.setAttribute('aria-label', name);
            return;
          }
        }
        var className = Array.from(control.classList || [])
          .filter(function (part) { return !/^(control|input|field|form-control|up|active)$/i.test(part); })
          .join(' ');
        var option = control.closest('label, article, li, .card, .option, .upgrade');
        var optionName = option && visibleText(option.querySelector('strong, b, h2, h3, span'), control);
        name = validName(control.getAttribute('title'), control)
          || validName(control.getAttribute('placeholder'), control)
          || validName(control.getAttribute('name'), control)
          || validName(control.id, control)
          || validName(className, control)
          || optionName;
        if (name) control.setAttribute('aria-label', name.replace(/[-_]+/g, ' '));
      });
      if (document.body) document.body.dataset.hcA11ySerial = String(serial);

      // Los hubs anteriores al componente Calculator no siempre tienen una
      // región viva. Agregamos un anunciador dedicado (sin tocar el resultado
      // visual) y lo actualizamos sólo después de una interacción real.
      if (document.body && document.body.dataset.pageType === 'hub') {
        var roots = scope.querySelectorAll('form.calc, form.calculator, form.lab, form.calc-shell, form.imc-calculator, [data-calculator], .hcm');
        roots.forEach(function (calculator) {
          if (calculator.querySelector('[data-sr-announce], [data-hc-hub-announcer]')) return;
          var result = calculator.querySelector('[data-result], .result, #result, output, .breakdown, .result-box');
          if (!result || result.hasAttribute('aria-live')) return;

          var announcer = document.createElement('div');
          announcer.className = 'hc-sr-only';
          announcer.setAttribute('role', 'status');
          announcer.setAttribute('aria-live', 'polite');
          announcer.setAttribute('aria-atomic', 'true');
          announcer.setAttribute('data-hc-hub-announcer', '');
          calculator.appendChild(announcer);

          var interacted = false;
          var timer = 0;
          calculator.addEventListener('input', function () { interacted = true; }, { capture: true });
          calculator.addEventListener('click', function (event) {
            if (event.target && event.target.closest && event.target.closest('button, [role="button"]')) interacted = true;
          }, { capture: true });
          new MutationObserver(function () {
            if (!interacted) return;
            window.clearTimeout(timer);
            timer = window.setTimeout(function () {
              var text = (result.innerText || result.textContent || '').replace(/\s+/g, ' ').trim();
              if (text && text !== announcer.textContent) announcer.textContent = text.slice(0, 320);
            }, 180);
          }).observe(result, { childList: true, characterData: true, subtree: true });
        });
      }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { enhance(document); }, { once: true });
    else enhance(document);
    document.addEventListener('astro:page-load', function () { enhance(document); });
  })();
</script>

<style is:global>
  /* WCAG 2.5.8: superficie táctil mínima para controles desplegables/FAQ. */
  main details > summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding-block: 10px;
    line-height: 1.35;
  }

  /* Los templates visuales usaban 8–10px en información que sí debe leerse. */
  main :where(.help, .eyebrow, .result-label, .section-label, .semester-head span, .mode small, .tlabs, .stamp, .tag) {
    font-size: 0.75rem !important;
    line-height: 1.4;
  }

  /* Contraste AA para texto secundario sobre superficies claras y oscuras. */
  main :where(.help, .semester-head span, .mode small, .tlabs) {
    color: #536176 !important;
  }
  main :where(.result, [class*="--dark"], [class*="dark-"]) :where(.result-label, .help, .tlabs, small) {
    color: #c6d2df !important;
  }

  /* Los result-box son tarjetas blancas dentro de un resultado oscuro. El
     selector anterior no debe convertir su texto secundario en gris casi
     blanco (1.53:1). */
  main .hcm .result-box :where(small, span) {
    color: #536176 !important;
  }

  /* Paleta AA compartida para la experiencia generada y superficies claras. */
  main .mockup-aguinaldo { --muted: #566176; }
  main .mockup-aguinaldo :where(.eyebrow, .reset) { color: #78480b !important; }
  main .mockup-aguinaldo :where(.section-head p, .best-grid > div > p) { color: #566176 !important; }
  .site-footer .foot-dots,
  .site-footer .foot-dots .fd { color: #596579 !important; }
  .site-footer :where(.foot-legal p, .foot-bottom p, .foot-bottom a, .foot-green) {
    color: #596579 !important;
  }

  /* Home: el mismo piso de contraste y tamaño para cards, método y bloques editoriales. */
  main .hc-home :where(.section-title p, .popular-card p, .fresh-card p, .method-copy p, .world-copy p) {
    color: #536176 !important;
  }
  main .hc-home .popular-card span {
    color: #536176 !important;
    font-size: 0.75rem !important;
  }
  main .hc-home .method-card :where(small, span) {
    color: #536176 !important;
    font-size: 0.75rem !important;
  }
  main .hc-home .method-copy a {
    background-color: #315fca !important;
    color: #fff !important;
  }
  main .hc-home .moments .section-title p {
    color: #cbd5e1 !important;
  }

  /* Links dentro de prosa: no depender solo del color (WCAG 1.4.1). */
  main :where(.prose, .mini p, .answer, .faq .a) a {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  /* Fase 3: los módulos posteriores al cálculo se conservan en el árbol de
     accesibilidad, pero el browser posterga su layout/paint hasta acercarse al
     viewport. La geometría intrínseca evita saltos durante el scroll. */
  @supports (content-visibility: auto) {
    body[data-page-type="hub"] main :where(
      .editorial-trust,
      .hc-trust-card,
      .hub-children,
      .hub-interlinking
    ) {
      content-visibility: auto;
      contain-intrinsic-size: auto 520px;
    }
  }

  body[data-page-type="hub"] main :where(
    .editorial-trust,
    .hc-trust-card,
    .hub-children,
    .hub-interlinking
  ) a:not([class*="button"]):not([class*="btn"]) {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  .hc-sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    body[data-page-type="hub"] main *,
    body[data-page-type="hub"] main *::before,
    body[data-page-type="hub"] main *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* CTA compartido de las experiencias generadas: blanco ≥4.5:1. */
  main .calcbtn {
    background-color: #78480b !important;
    color: #fff !important;
  }

  @media (max-width: 700px) {
    main :where(input, select, textarea) { font-size: 1rem; }
    main :where(button, [role="button"], a.btn, .calcbtn) { min-height: 44px; }
  }
</style>
