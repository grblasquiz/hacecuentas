---
// Fuente literal del mockup v7 aprobado. No se reinterpreta: la home usa el
// mismo HTML y CSS que generaron las capturas desktop/mobile aprobadas.
import approvedSource from '../assets/home-v7-approved.html?raw';
import { TOTAL_DISPLAY, TOTAL_PLAIN, CATEGORY_COUNT } from '../lib/calc-counts';

const css = approvedSource.match(/<style>([\s\S]*?)<\/style>/i)?.[1] || '';
let body = approvedSource.match(/<body>([\s\S]*?)<\/body>/i)?.[1] || '';

// Los recursos del mockup apuntaban a un servidor local sólo para la captura.
body = body.replaceAll('http://127.0.0.1:8766/logo-64.png', '/logo-64.png');
// Layout ya provee el <main>; evitamos anidarlo sin alterar la estructura visual.
body = body
  .replace('<main>', '<div class="mock-main">')
  .replace('</main>', '</div>');
// El mockup traía un <script> inline para reordenar/inyectar secciones, pero al
// entrar por set:html el navegador NO lo ejecuta (los <script> insertados como
// innerHTML quedan inertes). Lo removemos del markup y su lógica se reimplementa
// —junto con el cableado de búsqueda y links— en el <script> real de más abajo,
// que Astro sí bundlea y ejecuta.
body = body.replace(/<script[\s\S]*?<\/script>/i, '');
// El header y el footer del mockup los provee ahora el Header.astro / Footer.astro
// COMPARTIDOS (los mismos que TODO el sitio, vía los slots del Layout) → los
// quitamos del body inyectado para que la home use exactamente los mismos
// componentes que el resto de las páginas. El CSS del mockup para .top/.footer
// queda sin uso (inofensivo).
body = body
  .replace(/<header class="top">[\s\S]*?<\/header>/i, '')
  .replace(/<footer class="footer">[\s\S]*?<\/footer>/i, '');
// Contador de calculadoras: el mockup traía cifras hardcodeadas ("4.100") que
// quedaron viejas tras la poda de calcs. Las sincronizamos con calc-counts
// (fuente única, dinámica) para que la home muestre el MISMO número que
// /sobre-nosotros y el resto del sitio. Nunca dos cifras distintas: una cifra
// que contradice a otra es una señal de falta de revisión editorial (AdSense).
body = body
  .replace(/Más de [\d.]+\+? herramientas/g, `Más de ${TOTAL_PLAIN} herramientas`)
  .replace(/(<strong>)[\d.]+\+?(<\/strong><small>herramientas disponibles)/g, `$1${TOTAL_DISPLAY}$2`)
  .replace(/(<strong>)\d+(<\/strong><small>categorías)/g, `$1${CATEGORY_COUNT}$2`);
// Las seis cards de decisión de portada concentran la cohorte P0. El texto se
// reemplaza sobre la fuente aprobada para conservar exactamente su layout.
body = body
  .replace(
    '<span class="badge">Vivienda</span><h3>¿Me conviene alquilar o comprar?</h3><p>Capital inicial, cuotas, inflación y horizonte de tiempo.</p>',
    '<span class="badge">Vivienda</span><h3>¿Me conviene renovar el alquiler o mudarme?</h3><p>Aumento, depósito, comisión, mudanza y viaje.</p>',
  )
  .replace(
    '<span class="badge">Ahorro</span><h3>¿Qué hago con mis ahorros?</h3><p>Liquidez, riesgo y objetivos personales.</p>',
    '<span class="badge">Trabajo</span><h3>¿Me conviene estar en relación de dependencia o facturar?</h3><p>Neto, aguinaldo, vacaciones, impuestos y obra social.</p>',
  );

// Blog "Últimas notas": el mockup traía 6 notas HARDCODEADAS (fechas congeladas
// al 10-jul + 2 titulares del Mundial ya vencidos "octavos el finde"). Un feed
// estático de "últimas notas" que no se mueve es señal de falta de revisión
// editorial (AdSense) y muestra contenido temporal vencido. Lo reemplazamos por
// las notas reales más recientes que ya computa la home (recentPosts, ordenadas
// por fecha y filtradas de 410-gone). Si aparece una nota del Mundial ahora es un
// post real con su fecha, no un titular fabricado que envejece en la portada.
const { recentPosts = [] } = Astro.props as {
  recentPosts?: Array<{ slug: string; title: string; emoji?: string; date?: string }>;
};
if (recentPosts.length) {
  const esc = (s: string) =>
    String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const blogCards = recentPosts
    .slice(0, 6)
    .map(
      (p) =>
        `<article class="blogFull" data-blog-slug="${esc(p.slug)}"><b>${esc(p.title)}</b><small>${esc(p.date || '')}</small></article>`,
    )
    .join('');
  body = body.replace(/<div class="blogGridFull">[\s\S]*?<\/div>/, `<div class="blogGridFull">${blogCards}</div>`);
}
---

<div class="approved-home-v7" set:html={body}></div>
<style is:global set:html={css}></style>
<style is:global>
  body[data-page-type="home"] {
    background: #f6f7f2 !important;
  }
  body[data-page-type="home"] > main#main {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip;
  }
  .approved-home-v7 { color: #071a3d !important; }
  .approved-home-v7 h1,
  .approved-home-v7 h2,
  .approved-home-v7 h3,
  .approved-home-v7 h4 { color: #071a3d !important; }
  .approved-home-v7 p { color: #61708c; }
  .approved-home-v7 a { color: inherit; }
  .approved-home-v7 .big,
  .approved-home-v7 .big h3,
  .approved-home-v7 .world,
  .approved-home-v7 .world h3,
  .approved-home-v7 .storyMain,
  .approved-home-v7 .storyMain h3,
  .approved-home-v7 .finalCta,
  .approved-home-v7 .finalCta h2,
  .approved-home-v7 .newsletterBox,
  .approved-home-v7 .newsletterBox h3 { color: #fff !important; }
  @media (min-width: 1500px) {
    .approved-home-v7 .wrap {
      width: min(1600px, calc(100% - 96px)) !important;
    }
  }
  /* Buscador predictivo real reubicado en el box .ask del mockup: se neutraliza
     el recuadro del mockup para no duplicar borde/sombra con el form del HeroSearch. */
  .approved-home-v7 .ask.ask-real {
    background: transparent;
    box-shadow: none;
    border: 0;
    padding: 0;
  }
  #hsx-slot[hidden] { display: none; }
  /* FAQ: respuesta que se despliega debajo de la pregunta. */
  .approved-home-v7 .questions .q { flex-wrap: wrap; cursor: pointer; }
  .approved-home-v7 .questions .q .qa {
    flex-basis: 100%;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: #61708c;
  }
  /* ── Fixes de layout en mobile ──────────────────────────────────────────
     En el mockup dos elementos con position:absolute se encimaban con el
     texto en pantallas chicas: el marcador del card "Mundial" (.score) y el
     gráfico decorativo de los "momentos" (.scene). */
  @media (max-width: 700px) {
    /* Mundial: el marcador vuelve al flujo, debajo del subtítulo. */
    .approved-home-v7 .world .score {
      position: relative;
      z-index: 2;
      left: auto;
      bottom: auto;
      margin-top: 16px;
    }
    .approved-home-v7 .world .pitch { opacity: .18; }
    /* Momentos: achicamos el gráfico decorativo, bajamos su opacidad y
       subimos el texto por encima para que el título no quede tapado. */
    .approved-home-v7 .moment .scene { height: 30%; opacity: .5; }
    .approved-home-v7 .moment.big .scene { height: 26%; }
    .approved-home-v7 .moment h3,
    .approved-home-v7 .moment p,
    .approved-home-v7 .moment .go,
    .approved-home-v7 .moment > .eyebrow { z-index: 3; }
    /* La home conserva el acceso a todas las guías, pero en móvil adelanta la
       decisión principal y evita una pared de tarjetas antes del siguiente paso. */
    .approved-home-v7 .contentFull .guideFull:nth-child(n+5),
    .approved-home-v7 .contentFull .blogFull:nth-child(n+4) { display: none; }
  }
  /* Fallback: input simple si HeroSearch no está disponible. */
  .approved-home-v7 .askLine .askInput {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 16px;
    color: #071a3d;
    padding: 2px 0;
  }
  .approved-home-v7 .askLine .askInput::placeholder { color: #8793a9; }
  .approved-home-v7 .askLine .send { border: 0; cursor: pointer; }
  .approved-home-v7 [data-href] { cursor: pointer; }
  /* Ícono de "Monedas": SVG en blanco (el emoji 💱 salía monocromo/oscuro). */
  .approved-home-v7 .converterCard .ico-monedas { display: inline-flex; color: #fff; }
  .approved-home-v7 .converterCard .ico-monedas svg { display: block; }
</style>

<script>
  // El mockup v7 se inyecta como HTML estático (set:html) → sus botones, links y
  // buscador no tienen comportamiento. Este script, que Astro sí ejecuta, le da
  // vida: reordena/inyecta las secciones (lo que hacía el <script> inline del
  // mockup) y cablea la navegación. Cada elemento clickeable recibe su URL real
  // donde la conocemos; el resto cae a /buscar?q=<texto> para que nada quede muerto.
  function wireHome() {
    const root = document.querySelector('.approved-home-v7');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';

    /* ---------- 1) Reordenar + inyectar (portado del mockup) ---------- */
    const moments = root.querySelector('.mock-main > .section');
    const topTen = root.querySelector('.topTen');
    const converters = root.querySelector('.converters');
    const catalogFull = root.querySelector('.catalogFull');
    if (moments && topTen && converters && catalogFull) {
      moments.after(topTen, converters, catalogFull);
      catalogFull.querySelector('.pillarGrid')?.remove();
      const arTitle = [...catalogFull.querySelectorAll('.clusterTitle')]
        .find((el) => el.textContent.includes('Para Argentina'));
      if (arTitle) { arTitle.nextElementSibling?.remove(); arTitle.remove(); }
      const h2 = catalogFull.querySelector('.intro h2');
      if (h2) h2.textContent = 'Explorá todas las herramientas.';
      const sub = catalogFull.querySelector('.intro .sub');
      if (sub) sub.textContent = 'Categorías y novedades, organizadas para encontrar rápido lo que necesitás.';
    }
    const contentFull = root.querySelector('.contentFull');
    root.querySelector('.stories')?.after(contentFull);

    // La maqueta del tablero parecía una funcionalidad cerrada. Aclara el
    // beneficio y deja un paso explícito, sin obligar a registrarse para usar
    // las calculadoras.
    const journeyCopy = root.querySelector('.journey > div:first-child');
    if (journeyCopy && !journeyCopy.querySelector('[data-home-planner-cta]')) {
      const intro = journeyCopy.querySelector('.sub');
      if (intro) intro.textContent = 'Guardá resultados, compará escenarios y volvé cuando cambie un dato. Podés probarlo gratis; crear una cuenta sólo sirve para recuperar tu tablero en otro dispositivo.';
      const cta = document.createElement('a');
      cta.className = 'action';
      cta.href = '/mi-hacecuentas';
      cta.dataset.homePlannerCta = 'true';
      cta.textContent = 'Crear mi tablero gratis →';
      journeyCopy.insertBefore(cta, journeyCopy.querySelector('.steps'));
    }
    const newsletterFull = root.querySelector('.newsletterFull');
    if (newsletterFull) root.querySelector('.finalCta')?.after(newsletterFull);

    root.querySelector('.ticker')?.insertAdjacentHTML('afterend', '<div class="countryRail"><span>🇦🇷 Argentina</span><span>🌎 Global</span><span>🇪🇸 España</span><span>🇲🇽 México</span><span>🇨🇴 Colombia</span><span>🇨🇱 Chile</span><span>🇵🇪 Perú</span><span>🇪🇨 Ecuador</span><span>🇧🇷 Brasil</span><span>English</span></div>');
    root.querySelector('.cases')?.insertAdjacentHTML('beforeend', '<article class="case"><span class="badge">Compras</span><h3>¿Me conviene pagar en cuotas o al contado?</h3><p>Descuento, inflación y rendimiento en pesos de hoy.</p><span class="go">Comparar →</span></article><article class="case"><span class="badge">Trabajo</span><h3>Me despidieron: ¿cuánto deberían pagarme?</h3><p>Indemnización y tiempo de sostén.</p><span class="go">Calcular →</span></article><article class="case"><span class="badge">Vivienda</span><h3>¿Puedo afrontar un crédito UVA?</h3><p>Cuota, inflación e ingresos futuros.</p><span class="go">Evaluar →</span></article>');
    root.querySelector('.questions')?.insertAdjacentHTML('beforeend', '<div class="q"><span>¿Las calculadoras reemplazan a un profesional?</span><b>＋</b></div><div class="q"><span>¿Qué hago si encuentro un error?</span><b>＋</b></div>');
    const footerBrand = root.querySelector('.footer .brand');
    if (footerBrand) footerBrand.innerHTML = '<img src="/logo-64.png" alt=""><span>Hacé Cuentas</span>';
    const footGrid = root.querySelector('.footGrid');
    if (footGrid) {
      footGrid.insertAdjacentHTML('beforeend', '<div class="footCol"><b>Salud & deportes</b><a>IMC</a><a>Calorías (TDEE)</a><a>Semanas de embarazo</a><a>Ritmo de carrera</a><a>1RM fuerza</a></div><div class="footCol"><b>Viajes & vida</b><a>Combustible viaje</a><a>Dividir gastos</a><a>Edad exacta</a><a>Días entre fechas</a><a>Porcentajes</a></div><div class="footCol"><b>Hogar & mascotas</b><a>Edad de tu perro</a><a>Alimento diario perro</a><a>Tazas a gramos</a><a>Ladrillos x m²</a><a>Pintura x m²</a></div><div class="footCol"><b>Más países</b><a>🇵🇪 Perú</a><a>🇪🇨 Ecuador</a><a>🇺🇾 Uruguay</a><a>🇵🇾 Paraguay</a><a>🇩🇴 Rep. Dominicana</a></div>');
      footGrid.insertAdjacentHTML('beforeend', '<div class="footCol"><b>Sitios amigos</b><a href="https://nomaviajes.com">✈️ Noma Viajes</a><a href="https://genfy.net">✨ Genfy.net</a></div>');
      footGrid.insertAdjacentHTML('beforeend', '<div class="footCol"><b>Seguinos</b><div class="socialRow"><a href="https://x.com/Hacecuentas" title="X">𝕏</a><a href="https://www.instagram.com/hacecuentas" title="Instagram">◎</a><a href="https://www.linkedin.com/company/122324467/" title="LinkedIn">in</a><a href="https://www.facebook.com/profile.php?id=61590473465354" title="Facebook">f</a><a href="https://www.youtube.com/@HaceCuentas" title="YouTube">▶</a><a href="https://www.tiktok.com/@hace.cuentas" title="TikTok">♪</a></div></div>');
    }

    /* ---------- 2) Mapas etiqueta → URL real (todos verificados contra el
       índice real de calcs y las rutas reales; NADA cae a búsqueda) ---------- */
    const norm = (s) => (s || '').trim().toLowerCase().replace(/\s+/g, ' ').replace(/→/g, '').trim();
    const stripEmoji = (s) => norm((s || '').replace(/^[^\p{L}\d]+/u, ''));
    const search = (label) => '/buscar?q=' + encodeURIComponent((label || '').trim());

    // Calculadoras (slug real del campo `slug`, no del filename).
    const CALCS = {
      'sueldo neto en mano': '/sueldo-en-mano-argentina',
      'sueldo en mano': '/sueldo-en-mano-argentina',
      'actualización de alquiler por icl': '/calculadora-actualizacion-alquiler-icl',
      'alquiler': '/calculadora-actualizacion-alquiler-icl',
      'aguinaldo (sac)': '/calculadora-aguinaldo-sac',
      'calculadora de aguinaldo (sac)': '/calculadora-aguinaldo-sac',
      'aguinaldo': '/calculadora-aguinaldo-sac',
      'actualización por inflación': '/calculadora-actualizacion-inflacion-ipc',
      'actualización por inflación (ipc)': '/calculadora-actualizacion-inflacion-ipc',
      'monotributo 2026': '/calculadora-monotributo-2026',
      'calculadora de monotributo 2026': '/calculadora-monotributo-2026',
      'costo de impresión 3d': '/calculadora-costo-impresion-3d-pieza',
      'indemnización por despido': '/calculadora-indemnizacion-despido',
      'indemnización': '/calculadora-indemnizacion-despido',
      'interés compuesto': '/calculadora-interes-compuesto',
      'calculadora de interés compuesto': '/calculadora-interes-compuesto',
      'días entre dos fechas': '/dias-entre-dos-fechas',
      'días entre fechas': '/dias-entre-dos-fechas',
      'calculadora de imc': '/calculadora-imc',
      'imc': '/calculadora-imc',
      'impuesto a las ganancias — sueldo': '/calculadora-impuesto-ganancias-sueldo',
      'calculadora de embarazo': '/calculadora-embarazo',
      'calculadora de edad exacta': '/calculadora-edad-exacta',
      'edad exacta': '/calculadora-edad-exacta',
      'liquidación final por renuncia': '/calculadora-liquidacion-final-renuncia',
      'cuota de préstamo': '/calculadora-cuota-prestamo',
      'plazo fijo': '/calculadora-plazo-fijo',
      'ganancias 2026': '/calculadora-ganancias-empleados-4ta-categoria-2026',
      'vacaciones': '/calculadora-dias-vacaciones-ley',
      'margen de ganancia': '/calculadora-margen-ganancia-markup',
      'calculadora de margen de ganancia': '/calculadora-margen-ganancia-markup',
      'punto de equilibrio': '/calculadora-punto-equilibrio-break-even',
      'calculadora de punto de equilibrio': '/calculadora-punto-equilibrio-break-even',
      'precio con iva': '/calculadora-iva-agregar-discriminar',
      'calculadora de iva: agregar o discriminar': '/calculadora-iva-agregar-discriminar',
      'cac / ltv': '/calculadora-cac-ltv-costo-adquisicion-cliente',
      'calorías (tdee)': '/calculadora-calorias-diarias-tdee',
      'semanas de embarazo': '/calculadora-semanas-embarazo',
      'ritmo de carrera': '/calculadora-pace-ritmo-running',
      '1rm fuerza': '/calculadora-1rm-peso-maximo-levantamiento',
      'combustible viaje': '/calculadora-combustible-viaje-auto',
      'dividir gastos': '/calculadora-split-gastos-grupo-amigos',
      'edad de tu perro': '/calculadora-edad-perro-anos-humanos',
      'alimento diario': '/calculadora-alimento-diario-perro',
      'alimento diario perro': '/calculadora-alimento-diario-perro',
      'tazas a gramos': '/conversor-tazas-gramos-cocina-recetas',
      'ladrillos x m²': '/calculadora-cantidad-ladrillos-metro-cuadrado-pared',
      'pintura x m²': '/calculadora-conversor-litros-pintura-por-metro-cuadrado',
      'porcentajes': '/calculadora-porcentajes',
      'valores bcra hoy': '/valores-bcra',
      'dólar': '/valores-bcra',
      'deudas': '/decidir/cancelar-deuda-o-invertir',
    };
    // Conversores (label del card → conversor real).
    const CONVERTERS = {
      'monedas': '/cambio-de-monedas',
      'longitud': '/calculadora-conversor-pies-a-metros',
      'temperatura': '/conversor-celsius-fahrenheit-temperatura',
      'peso': '/conversor-kilogramos-libras-onzas',
      'cocina': '/conversor-tazas-gramos-cocina-recetas',
      'tiempo': '/calculadora-conversor-semanas-a-dias',
    };
    // Categorías (nube de categorías → /categoria/<key>).
    const CATEGORIES = {
      'finanzas': 'finanzas', 'vida cotidiana': 'vida', 'salud': 'salud', 'deportes': 'deportes',
      'matemática': 'matematica', 'cocina': 'cocina', 'construcción': 'construccion', 'viajes': 'viajes',
      'educación': 'educacion', 'negocios': 'negocios', 'tecnología': 'tecnologia', 'mascotas': 'mascotas',
      'impuestos': 'impuestos', 'marketing': 'marketing', 'automotor': 'automotor', 'ciencia': 'ciencia',
      'entretenimiento': 'entretenimiento', 'familia': 'familia', 'jardinería': 'jardineria',
      'electrónica': 'electronica', 'hogar': 'hogar', 'medio ambiente': 'medio-ambiente',
      'idiomas': 'idiomas', 'astronomía': 'astronomia', 'clima': 'clima', 'juegos': 'juegos',
    };
    const catUrl = (label) => { const k = CATEGORIES[stripEmoji(label)]; return k ? '/categoria/' + k : null; };
    // Filtros de la biblioteca (chips) → hub/categoría.
    const FILTERS = {
      'para vos': '/', 'sueldos': '/sueldos-y-trabajo', 'impuestos': '/impuestos-argentina',
      'finanzas': '/finanzas-personales', 'vida cotidiana': '/categoria/vida',
      'negocios': '/negocios-e-independientes', 'salud': '/categoria/salud',
    };
    // Salas de decisión (por el <h3> de la card).
    const SALAS = {
      '¿me conviene aceptar esta oferta laboral?': '/decidir/aceptar-oferta-laboral',
      '¿me conviene renovar el alquiler o mudarme?': '/decidir/renovar-alquiler-o-mudarme',
      '¿me conviene estar en relación de dependencia o facturar?': '/decidir/relacion-dependencia-o-facturar',
      '¿me conviene pagar en cuotas o al contado?': '/decidir/cuotas-o-contado',
      'me despidieron: ¿cuánto deberían pagarme?': '/decidir/me-despidieron',
      '¿puedo afrontar un crédito uva?': '/decidir/puedo-afrontar-un-credito-uva',
    };
    // Momentos ("empezá por tu momento") → hub/tablero.
    const MOMENTS = {
      'armá un plan que puedas sostener.': '/mi-hacecuentas',
      'cobré o cambié de trabajo': '/sueldos-y-trabajo',
      'estoy por mudarme': '/decidir/renovar-alquiler-o-mudarme',
      'tengo un negocio': '/negocios-e-independientes',
      'quiero invertir': '/finanzas-personales',
    };
    // Guías/historias por tema → hub o categoría.
    const GUIDES = {
      'finanzas personales': '/finanzas-personales',
      'sueldos argentina 2026': '/sueldos-y-trabajo',
      'impuestos argentina 2026': '/impuestos-argentina',
      'subsidios anses 2026': '/simulador-jubilacion-anses',
      'salud, nutrición y fitness': '/categoria/salud',
      'embarazo y bebé': '/calculadora-semanas-embarazo',
      'productividad y aprendizaje': '/categoria/educacion',
      'matemáticas y ciencias': '/categoria/matematica',
      'construcción y hogar': '/categoria/construccion',
      'cocina, medidas y recetas': '/categoria/cocina',
      'mascotas': '/categoria/mascotas',
      'viajes y auto': '/categoria/viajes',
      // storyMain / storyMini
      'cómo ordenar tus finanzas sin vivir mirando una planilla': '/finanzas-personales',
      'de bruto a neto, sin sorpresas': '/sueldos-y-trabajo',
      'qué cambia y cómo te afecta': '/impuestos-argentina',
    };
    const COUNTRIES = {
      'argentina': '/', 'global': '/global', 'españa': '/es', 'méxico': '/mx',
      'colombia': '/co', 'chile': '/cl', 'perú': '/pe', 'ecuador': '/ec',
      'brasil': '/pt', 'english': '/en',
      'uruguay': '/uy', 'paraguay': '/py', 'rep. dominicana': '/do',
    };
    // Nav header + footer (explorar / comunidad / legal / empezá por acá).
    const NAV = {
      'resolver': '/calculadoras', 'decidir': '/decidir', 'planificar': '/planificador-de-objetivos',
      'aprender': '/guias', 'blog': '/blog', 'calculadoras': '/calculadoras', 'guías': '/guias',
      'historias': '/historias', 'glosario': '/glosario', 'contacto': '/contacto',
      'aviso legal': '/aviso-legal', 'términos': '/terminos', 'privacidad': '/privacidad',
      'cookies': '/cookies', 'enlazanos': '/enlazanos', 'sugerir una calc': '/sugerir',
      'votar sugerencias': '/sugerencias', 'simulador de jubilación': '/simulador-jubilacion-anses',
      'salas de decisión': '/decidir', 'sueldos y trabajo': '/sueldos-y-trabajo',
      'finanzas': '/finanzas-personales', 'negocios': '/negocios-e-independientes',
    };
    // Respuestas reales de las FAQ (acordeón funcional).
    const FAQ = {
      '¿es gratis? ¿tengo que registrarme?': 'Sí, todas las calculadoras son 100% gratis y no necesitás registrarte ni dejar tus datos para usarlas.',
      '¿qué pasa con mis datos?': 'Las cuentas corren en tu navegador: no guardamos ni enviamos lo que ingresás. Lo que calculás queda en tu dispositivo.',
      '¿las fórmulas son confiables?': 'Cada fórmula usa fuentes oficiales (BCRA, ARCA/AFIP, ANSES, INDEC) y te mostramos de dónde sale el resultado y cuándo se actualizó.',
      '¿cada cuánto se actualizan los datos?': 'Los datos que cambian —dólar, inflación, UVA, topes, salario mínimo— se actualizan a diario de forma automática.',
      '¿puedo sugerir una calculadora?': 'Sí. Podés proponer una calculadora nueva desde la página de sugerencias y la sumamos si hay demanda.',
      '¿las calculadoras reemplazan a un profesional?': 'No. Son una guía para orientarte; para decisiones importantes consultá siempre con un profesional matriculado.',
      '¿qué hago si encuentro un error?': 'Escribinos desde Contacto y lo corregimos lo antes posible. Cada calculadora tiene además su fuente y metodología a la vista.',
    };

    const pick = (map, label) => map[norm(label)] || map[stripEmoji(label)] || null;
    function setHref(el, url) {
      if (!el || !url) return;
      el.dataset.href = url;
      if (el.tagName === 'A') {
        el.setAttribute('href', url);
      } else {
        // El mockup usa tarjetas y chips como disparadores. Exponerlos como
        // enlaces reales a lectores de pantalla y teclado evita CTAs mudos.
        el.setAttribute('role', 'link');
        el.tabIndex = 0;
        if (!el.getAttribute('aria-label')) {
          el.setAttribute('aria-label', `Abrir ${labelOf(el).trim() || 'esta sección'}`);
        }
      }
    }
    const labelOf = (el) => {
      // Preferir <b> sobre <strong>: en .rankCard el <strong> es el número de
      // ranking (1,2,3…) y va antes que el <b> con el nombre real de la calc.
      const b = el.querySelector('b') || el.querySelector('h3') || el.querySelector('strong');
      return (b ? b.textContent : el.textContent) || '';
    };

    /* ---------- 3) Buscador PREDICTIVO real en el hero ---------- */
    // El mockup traía un placeholder estático. Reubicamos el HeroSearch real
    // (motor con índice /search-index.json, fuzzy + dropdown) que index.astro
    // renderiza oculto en #hsx-slot. Mover el nodo conserva sus listeners; su
    // propio <script> ([data-hsx]) lo inicializa igual, en su ubicación final.
    const ask = root.querySelector('.ask');
    const hsx = document.querySelector('#hsx-slot [data-hsx]') || document.querySelector('[data-hsx]');
    if (ask && hsx) {
      ask.querySelector('.askLine')?.remove();
      ask.classList.add('ask-real');
      ask.insertBefore(hsx, ask.firstChild);
      hsx.hidden = false;
    } else {
      // Fallback (si HeroSearch no está): input simple que va a /buscar.
      const askLine = root.querySelector('.ask .askLine');
      if (askLine) {
        askLine.innerHTML = '<b>⌕</b><input class="askInput" type="search" placeholder="Buscá tu calculadora..." aria-label="Buscar calculadora"><button class="send" type="button">Buscar →</button>';
        const input = askLine.querySelector('.askInput');
        const go = () => { const v = input.value.trim(); window.location.href = v ? search(v) : '/buscar'; };
        askLine.querySelector('.send').addEventListener('click', go);
        input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); go(); } });
      }
    }

    /* ---------- 4) Cablear cada sección a su URL real ---------- */
    // Header
    setHref(root.querySelector('.top .brand'), '/');
    root.querySelectorAll('.navlinks a').forEach((a) => setHref(a, NAV[norm(a.textContent)] || '/calculadoras'));
    root.querySelectorAll('.navtools .miniBtn').forEach((b) => {
      const t = b.textContent.toLowerCase();
      setHref(b, /buscar/.test(t) ? '/buscar' : /tablero/.test(t) ? '/mi-hacecuentas' : '/');
    });
    // Calculadoras: tools, top-10, simpleCalc (por su <b>/<h3>).
    root.querySelectorAll('.tool, .rankCard, .simpleCalc').forEach((el) => {
      const u = pick(CALCS, labelOf(el)); if (u) setHref(el, u);
    });
    // Directorio de la biblioteca + "Todos los temas" (calc o categoría).
    root.querySelectorAll('.dir a, .pillarFull a').forEach((a) => {
      const t = a.textContent;
      const u = pick(CALCS, t) || catUrl(t) || (norm(t) === 'vivienda' ? '/decidir/alquilar-o-comprar' : null);
      if (u) setHref(a, u);
    });
    // Conversores
    root.querySelectorAll('.converterCard').forEach((el) => {
      const u = pick(CONVERTERS, labelOf(el)); if (u) setHref(el, u);
    });
    // Momentos + salas de decisión (por el <h3>)
    root.querySelectorAll('.moment').forEach((el) => {
      const u = pick(MOMENTS, (el.querySelector('h3') || {}).textContent); if (u) setHref(el, u);
    });
    root.querySelectorAll('.case').forEach((el) => {
      const u = pick(SALAS, (el.querySelector('h3') || {}).textContent);
      if (u) {
        setHref(el, u);
        el.dataset.decisionEntry = 'home';
        el.dataset.roomSlug = u.split('/').filter(Boolean).pop() || '';
      }
    });
    const decisionCards = root.querySelectorAll('[data-decision-entry="home"]');
    if ('IntersectionObserver' in window) {
      const seen = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const card = entry.target;
          observer.unobserve(card);
          if (typeof window.hcTrack === 'function') {
            window.hcTrack('hc_decision_room_impression', {
              source_page: 'home',
              target_slug: card.dataset.roomSlug || '',
            });
          }
        });
      }, { threshold: 0.35 });
      decisionCards.forEach((card) => seen.observe(card));
    }
    // Guías + historias por tema
    root.querySelectorAll('.guideFull, .storyMain, .storyMini').forEach((el) => {
      const u = pick(GUIDES, labelOf(el)); if (u) setHref(el, u);
    });
    // Blog → índice del blog
    root.querySelectorAll('.blogFull').forEach((el) => {
      const s = el.getAttribute('data-blog-slug');
      setHref(el, s ? '/blog/' + s : '/blog');
    });
    // Chips del hero (Sueldo/Aguinaldo/Alquiler/Deudas)
    root.querySelectorAll('.askBottom .chip').forEach((el) => {
      const u = pick(CALCS, el.textContent); if (u) setHref(el, u);
    });
    // Filtros de la biblioteca → hub/categoría
    root.querySelectorAll('.filters .chip').forEach((el) => {
      const u = FILTERS[norm(el.textContent)]; if (u) setHref(el, u);
    });
    // Nube de categorías → /categoria/<key>
    root.querySelectorAll('.categoryCloud span').forEach((el) => {
      const u = catUrl(el.textContent); if (u) setHref(el, u);
    });
    // Rieles de país
    root.querySelectorAll('.countryRail span').forEach((el) => {
      const u = pick(COUNTRIES, el.textContent); if (u) setHref(el, u);
    });
    // "Lo nuevo" (newCard, por su <h3>)
    const NEWCARD = {
      'valores bcra hoy': '/valores-bcra',
      'comparador de plazo fijo': '/comparador-plazo-fijo',
      '100 conversores nuevos': '/categoria/matematica',
      'calculadora científica': '/calculadora-cientifica',
    };
    root.querySelectorAll('.newCard').forEach((el) => {
      const u = pick(NEWCARD, (el.querySelector('h3') || {}).textContent); if (u) setHref(el, u);
    });
    // Cards de la sección "temas vivos"
    root.querySelectorAll('.live .world').forEach((el) => setHref(el, '/mundial-2026'));
    root.querySelectorAll('.live .tax').forEach((el) => setHref(el, '/recategorizacion-monotributo-julio-2026'));
    // Links "ver todo" y CTAs secundarias (por texto)
    root.querySelectorAll('.link, .converterMore, .action').forEach((el) => {
      const t = el.textContent.toLowerCase();
      let u = null;
      if (/populares/.test(t)) u = '/populares';
      else if (/dashboard/.test(t)) u = '/valores-bcra';
      else if (/bancos/.test(t)) u = '/comparador-plazo-fijo';
      else if (/categoría|categoria/.test(t)) u = '/recategorizacion-monotributo-julio-2026';
      else if (/abrir calculadora/.test(t)) u = '/calculadora-cientifica';
      else if (/conversor/.test(t)) u = '/categoria/matematica';
      else if (/especiales/.test(t)) u = '/calculadoras-evento';
      else if (/guías|guias/.test(t)) u = '/guias';
      else if (/notas/.test(t)) u = '/blog';
      else if (/palabras/.test(t)) u = '/asistente';
      if (u) setHref(el, u);
    });
    // Finder de la biblioteca → buscador
    setHref(root.querySelector('.finder'), '/buscar');
    // Newsletter "Suscribirme" → alertas por email
    root.querySelectorAll('.emailMock b').forEach((el) => setHref(el, '/alertas'));
    // Footer: cada columna a su destino (los enlaces con href ya puesto —Sitios
    // amigos / redes— no se tocan).
    root.querySelectorAll('.footCol a').forEach((a) => {
      if (a.getAttribute('href')) return;
      const t = a.textContent;
      const u = NAV[norm(t)] || FILTERS[norm(t)] || pick(CALCS, t) || pick(COUNTRIES, t) || catUrl(t);
      if (u) setHref(a, u);
    });

    /* ---------- 5) FAQ: acordeón funcional con respuestas reales ---------- */
    root.querySelectorAll('.questions .q').forEach((q) => {
      const span = q.querySelector('span');
      const ans = FAQ[norm(span ? span.textContent : q.textContent)];
      if (ans && !q.querySelector('.qa')) {
        const qa = document.createElement('div');
        qa.className = 'qa';
        qa.hidden = true;
        qa.textContent = ans;
        q.appendChild(qa);
      }
      q.style.cursor = 'pointer';
      q.addEventListener('click', () => {
        const b = q.querySelector('b');
        const open = q.classList.toggle('open');
        const qa = q.querySelector('.qa');
        if (qa) qa.hidden = !open;
        if (b) b.textContent = open ? '－' : '＋';
      });
    });

    /* ---------- 6) Delegación: un solo listener navega por data-href ---------- */
    root.addEventListener('click', (e) => {
      const t = e.target.closest('[data-href]');
      if (!t || !root.contains(t)) return;
      const url = t.dataset.href;
      if (!url) return;
      if (t.dataset.decisionEntry === 'home' && typeof window.hcTrack === 'function') {
        window.hcTrack('hc_decision_room_clicked', {
          source_page: 'home',
          target_slug: t.dataset.roomSlug || '',
        });
      }
      // Respetar cmd/ctrl/click-central para abrir en pestaña nueva en <a>.
      if (t.tagName === 'A' && (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1)) return;
      e.preventDefault();
      window.location.href = url;
    });
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const t = e.target.closest('[data-href]');
      if (!t || !root.contains(t) || t.tagName === 'A') return;
      e.preventDefault();
      const url = t.dataset.href;
      if (url) window.location.href = url;
    });
  }

  wireHome();
  document.addEventListener('astro:page-load', wireHome);
</script>
