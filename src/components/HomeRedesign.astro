---
import HeroSearch from './HeroSearch.astro';
import ProblemInterpreter from './ProblemInterpreter.astro';
import Newsletter from './Newsletter.astro';

const { featuredSalas, totalSalas, popular, recentPosts, mosaicCats, categoryMeta,
  categoryCount, totalResults, showMundialSeasonal, showMonotributoSeasonal } = Astro.props;
const top10 = popular.slice(0, 10);
const guides = [
  ['/guia/finanzas-personales','💰','Finanzas personales','Ahorro, inversiones y presupuesto'],
  ['/guia/sueldos-argentina-2026','💼','Sueldos Argentina 2026','Bruto, neto, aguinaldo, indemnización'],
  ['/guia/impuestos-argentina-2026','🧾','Impuestos Argentina 2026','Ganancias, IVA, IIBB, Monotributo'],
  ['/guia/subsidios-anses-2026','🏛️','Subsidios ANSES 2026','AUH, jubilación, asignaciones'],
  ['/guia/salud-nutricion-fitness','🩺','Salud, nutrición y fitness','IMC, calorías, TDEE, entrenamiento'],
  ['/guia/embarazo-y-bebe','👶','Embarazo y bebé','Semanas, fecha de parto, crecimiento'],
  ['/guia/productividad-aprendizaje','📚','Productividad y aprendizaje','Técnicas, idiomas, tiempo de estudio'],
  ['/guia/matematicas-ciencias','➗','Matemáticas y ciencias','Álgebra, geometría, física'],
  ['/guia/construccion-diy-hogar','🔨','Construcción y hogar','Materiales, m², pintura, electricidad'],
  ['/guia/cocina-medidas-recetas','🍳','Cocina, medidas y recetas','Conversión, porciones, tiempos'],
  ['/guia/mascotas','🐾','Mascotas','Perros, gatos, peces, costos y cuidado'],
  ['/guia/viajes','✈️','Viajes y auto','Nafta, peajes, equipaje, vuelos'],
];
const moments = [
  ['/mi-hacecuentas','plan','Ordenar mi plata','Armá un plan que puedas sostener.','Presupuesto, ahorro, deudas y objetivos en una sola vista.'],
  ['/sueldos-y-trabajo','salary','Trabajo','Cobré o cambié de trabajo','Sueldo neto, aguinaldo e indemnización.'],
  ['/decidir/vivienda','home','Vivienda','Estoy por mudarme','Alquiler, crédito UVA y costo de vida.'],
  ['/negocios-e-independientes','biz','Negocios','Tengo un negocio','Margen, punto de equilibrio e impuestos.'],
  ['/finanzas-personales','save','Ahorro','Quiero invertir','Plazo fijo, interés compuesto y dólar.'],
];
const converters = [
  ['/dolar-hoy','💱','Monedas','Dólar, euro y 160 monedas'],
  ['/conversor-pies-a-metros','📏','Longitud','Metros, pies y pulgadas'],
  ['/conversor-celsius-fahrenheit-temperatura','🌡️','Temperatura','Celsius y Fahrenheit'],
  ['/calculadora-conversion-libras-kilos-onzas-stone','⚖️','Peso','Kilos, libras y onzas'],
  ['/calculadora-conversion-medidas-cocina-tazas-gramos','🥣','Cocina','Tazas, gramos y mililitros'],
  ['/conversor-horas-a-minutos','⏱️','Tiempo','Horas, minutos y días'],
];
---

<div class="hc-new">
  <section class="hero-new">
    <div class="hero-grid-new">
      <div class="hero-copy">
        <span class="eyebrow">✓ Tu vida, más fácil.</span>
        <h1>Tomá mejores decisiones con <em>números claros.</em></h1>
        <p>Contanos qué querés resolver. Hacé Cuentas encuentra la herramienta, cruza los datos y te devuelve una respuesta que podés usar.</p>
        <div class="search-shell"><HeroSearch /></div>
        <details class="assistant"><summary>¿No sabés qué buscar? <b>Contámelo con tus palabras →</b></summary><ProblemInterpreter variant="hero" searchHref="/buscar" showSearchLink={false} /></details>
        <div class="quick"><a href="/sueldo-en-mano-argentina">Sueldo en mano</a><a href="/calculadora-aguinaldo-sac">Aguinaldo</a><a href="/calculadora-actualizacion-alquiler-icl">Alquiler</a><a href="/decidir/cancelar-deuda-o-invertir">Deudas</a></div>
      </div>
      <div class="hero-visual"><div class="orb"></div><div class="dash"><b>Mi panorama mensual</b><div class="balance"><small>Disponible después de gastos</small><strong>$ 486.200</strong><span>Tenés un margen saludable del 24%</span><div class="bars"><i></i><i></i><i></i><i></i><i></i><i></i></div></div></div><div class="result"><small>Próximo paso</small><strong>Podés ahorrar<br>$121.550</strong><span>sin comprometer tus gastos fijos</span></div></div>
    </div>
    <div class="ticker"><b>Hoy en Argentina</b><span><small>Dólar MEP</small><strong data-hoy="mep">···</strong></span><span><small>Inflación mensual</small><strong data-hoy="ipc">···</strong></span><span><small>UVA</small><strong data-hoy="uva">···</strong></span><span><small>Próximo feriado</small><strong id="proxi-feriado-hero">···</strong></span></div>
    <div class="countries"><a href="/">🇦🇷 Argentina</a><a href="/global">🌎 Global</a><a href="/es">🇪🇸 España</a><a href="/mx">🇲🇽 México</a><a href="/co">🇨🇴 Colombia</a><a href="/cl">🇨🇱 Chile</a><a href="/pe">🇵🇪 Perú</a><a href="/ec">🇪🇨 Ecuador</a><a href="/pt">🇧🇷 Brasil</a><a href="/en">English</a></div>
    <div class="meta"><b>{categoryCount}</b> categorías · <b data-live-counter data-initial={totalResults}>{totalResults.toLocaleString('es-AR')}</b> cálculos hechos · <a href="/valores-bcra">● Valores BCRA hoy</a></div>
  </section>

  <section class="block moments"><header><div><span class="eyebrow">Empezá por tu momento</span><h2>¿Qué está pasando hoy?</h2></div><p>Empezá desde la situación que necesitás resolver.</p></header><div class="moment-grid">{moments.map((m,i)=><a href={m[0]} class={`moment ${m[1]} ${i===0?'big':''}`}><div class="art"></div><span class="eyebrow">{m[2]}</span><h3>{m[3]}</h3><p>{m[4]}</p><b>{i===0?'Crear mi tablero':'Ver herramientas'} →</b></a>)}</div></section>

  <section class="block top"><header><div><span class="eyebrow">Las más usadas en Argentina</span><h2>Top 10 calculadoras.</h2></div><a href="/populares">Ver todas las populares →</a></header><div class="rank-grid">{top10.map((c,i)=><a href={`/${c.slug}`} class="rank"><strong>{i+1}</strong><i>{c.icon}</i><div><b>{c.h1}</b><small>{categoryMeta[c.category]?.label||c.category}</small></div><em>→</em></a>)}</div></section>

  <section class="block converter"><div class="converter-box"><header><div><span class="eyebrow">100 conversores gratuitos</span><h2>Convertí lo que necesites.</h2></div><a href="/buscar?q=conversor">Ver todos los conversores →</a></header><div class="converter-grid">{converters.map(c=><a href={c[0]}><i>{c[1]}</i><b>{c[2]}</b><small>{c[3]}</small></a>)}</div></div></section>

  <section class="catalog block"><header><div><span class="eyebrow">Explorá</span><h2>Explorá todas las herramientas.</h2></div><p>Categorías y novedades para encontrar rápido lo que necesitás.</p></header><div class="cat-cloud">{mosaicCats.map(c=><a href={`/categoria/${c}`}>{categoryMeta[c]?.icon} {categoryMeta[c]?.label}</a>)}</div><h3 class="row-title">Lo nuevo en Hacé Cuentas</h3><div class="new-grid"><a href="/valores-bcra"><i>🏦</i><h3>Valores BCRA hoy</h3><p>Dólar oficial, blue, MEP y CCL.</p></a><a href="/comparador-plazo-fijo"><i>📊</i><h3>Comparador de plazo fijo</h3><p>Bancos lado a lado.</p></a><a href="/buscar?q=conversor"><i>📐</i><h3>100 conversores nuevos</h3><p>Factores exactos y ejemplos.</p></a><a href="/calculadora-cientifica"><i>🧮</i><h3>Calculadora científica</h3><p>Trigonometría, raíces y potencias.</p></a></div></section>

  <section class="journey"><div><span class="eyebrow">Una cuenta no termina en el resultado</span><h2>Tu plan continúa.</h2><p>Guardá resultados, compará escenarios y volvé cuando cambie un dato.</p><ol><li><b>Calculá</b><span>Ingresá tus datos una sola vez.</span></li><li><b>Compará</b><span>Probá otro escenario.</span></li><li><b>Actuá</b><span>Recibí próximos pasos.</span></li></ol></div><div class="planner"><header><div><small>MI TABLERO · JULIO</small><b>Objetivo: mudarme solo</b></div><strong>68%</strong></header><div class="progress"><i></i></div><div class="tasks"><article class="hot"><small>LISTO PARA HACER</small><b>Comparar 3 alquileres</b></article><article><small>RESULTADO GUARDADO</small><b>Sueldo neto $1.840.000</b></article><article><small>PRÓXIMO PASO</small><b>Calcular costo de mudanza</b></article><article><small>SEGUIMIENTO</small><b>Alerta de dólar MEP</b></article></div></div></section>

  <section class="block live"><header><div><span class="eyebrow">Lo que está pasando ahora</span><h2>Temas vivos, cuentas actualizadas.</h2></div></header><div class="live-grid"><a href="/mundial-2026" class="world" hidden={!showMundialSeasonal}><span>● MUNDIAL 2026 · EN VIVO</span><h3>Seguí a la Selección<br>con números reales.</h3><p>Fixture, probabilidades, tabla y predictor.</p><strong>ARG — ESP</strong><div class="pitch"></div></a><a href="/calculadora-monotributo-categoria-2026-recategorizacion-julio" class="tax" hidden={!showMonotributoSeasonal}><span>RECATEGORIZACIÓN</span><h3>¿Seguís en la categoría correcta?</h3><p>Sumá tu facturación y proyectá las próximas cuotas.</p><div class="meter">Tu categoría sugerida: H</div></a></div></section>

  <section class="library"><div class="library-in"><header><div><span class="eyebrow">Biblioteca de herramientas</span><h2>Encontrá la cuenta exacta.</h2></div><p>Más de 4.100 herramientas por necesidad, país y momento.</p></header><div class="finder">⌕ Buscá “cuánto cobro si renuncio”, “cuota UVA”... <a href="/buscar">Buscar</a></div><div class="filters"><span>Para vos</span><a href="/categoria/finanzas">Finanzas</a><a href="/categoria/vida">Vida cotidiana</a><a href="/categoria/negocios">Negocios</a><a href="/categoria/salud">Salud</a></div><div class="tool-grid">{popular.slice(0,9).map(c=><a href={`/${c.slug}`}><i>{c.icon}</i><div><b>{c.h1}</b><small>{categoryMeta[c.category]?.label||c.category}</small></div><em>→</em></a>)}</div></div></section>

  <section class="block decisions"><header><div><span class="eyebrow">Salas de decisión</span><h2>Cuando una cuenta sola no alcanza.</h2></div><p>Varias fórmulas, escenarios y próximos pasos.</p></header><div class="decision-grid">{featuredSalas.map((r,i)=><a href={`/decidir/${r.slug}`} class={i===0?'featured':''}><span>DECISIÓN</span><h3>{r.h1}</h3><p>{r.description||'Compará escenarios con números reales.'}</p><b>Abrir la sala →</b></a>)}</div><a class="all" href="/decidir">Explorar las {totalSalas} salas →</a></section>

  <section class="block guides-feature"><header><div><span class="eyebrow">Entender también es decidir</span><h2>Guías que bajan los números a tierra.</h2></div><a href="/guias">Ver todas las guías →</a></header><div class="guide-feature-grid"><a href="/guia/finanzas-personales" class="guide-main"><span>GUÍA DESTACADA</span><h3>Cómo ordenar tus finanzas sin vivir mirando una planilla</h3><p>Un sistema simple para ingresos, gastos, deuda y ahorro.</p></a><div><a href="/guia/sueldos-argentina-2026">SUELDOS 2026<h3>De bruto a neto, sin sorpresas</h3></a><a href="/guia/impuestos-argentina-2026">IMPUESTOS 2026<h3>Qué cambia y cómo te afecta</h3></a></div></div></section>

  <section class="block content"><header><div><span class="eyebrow">Aprendé</span><h2>Todas las guías y últimas notas.</h2></div></header><h3 class="row-title">Guías completas</h3><div class="guide-grid">{guides.map(g=><a href={g[0]}><i>{g[1]}</i><b>{g[2]}</b><small>{g[3]}</small></a>)}</div><h3 class="row-title">Últimas notas del blog</h3><div class="blog-grid">{recentPosts.map((p,i)=><a href={`/blog/${p.slug}`} class={i===0?'featured':''}><span>{p.emoji}</span><b>{p.title}</b><small>{p.date}</small></a>)}</div></section>

  <section class="trust block"><div><span class="eyebrow">Por qué Hacé Cuentas</span><h2>Números que podés defender.</h2><p>Cada resultado muestra de dónde sale, cuándo se actualizó y qué supuestos usa.</p><div class="stats"><article><b>100%</b><small>gratis y sin datos invasivos</small></article><article><b>{categoryCount}</b><small>categorías temáticas</small></article><article><b>Diaria</b><small>actualización de fuentes</small></article><article><b>4.100+</b><small>herramientas disponibles</small></article></div></div><div class="principles"><article><b>⚡ Resultado inmediato</b><span>Sin esperas, registros ni fricción.</span></article><article><b>🛡 Datos privados</b><span>Las cuentas corren en tu navegador.</span></article><article><b>▤ Fórmulas explicadas</b><span>Fuentes oficiales, paso a paso y FAQ.</span></article><article><b>◎ En cualquier dispositivo</b><span>Responsive desde el primer día.</span></article><article><b>↻ Siempre actualizado</b><span>BCRA, ARCA, ANSES, INDEC y más.</span></article><article><b>✓ Próximos pasos</b><span>No te dejamos solo con un número.</span></article></div></section>

  <section class="faq block"><div><span class="eyebrow">Preguntas frecuentes</span><h2>Todo claro antes de empezar.</h2></div><div>{['¿Es gratis? ¿Tengo que registrarme?','¿Qué pasa con mis datos?','¿Las fórmulas son confiables?','¿Cada cuánto se actualizan los datos?','¿Las calculadoras reemplazan a un profesional?','¿Qué hago si encuentro un error?','¿Puedo sugerir una calculadora?'].map(q=><details><summary>{q}</summary><p>Encontrá la explicación completa, las fuentes y el alcance en cada calculadora.</p></details>)}</div></section>
  <section class="final"><div><span class="eyebrow">Empezá ahora</span><h2>¿Qué necesitás resolver hoy?</h2></div><a href="/buscar">Contanos con tus palabras →</a></section>
  <Newsletter />
</div>

<style>
  .hc-new{--ink:#071a3d;--blue:#3157ff;--lime:#c8ff3d;--paper:#f6f7f2;--muted:#61708c;--line:#dce2ed;color:var(--ink);background:var(--paper);font-family:Inter,system-ui,sans-serif}.hc-new *{box-sizing:border-box}.hc-new a{text-decoration:none;color:inherit}.hc-new h1,.hc-new h2,.hc-new h3{font-family:Georgia,serif;letter-spacing:-.045em}.block,.hero-new,.journey,.library,.final{width:min(1180px,calc(100% - 40px));margin:auto}.eyebrow{font-size:11px;font-weight:850;letter-spacing:.12em;text-transform:uppercase;color:var(--blue)}.hc-new h2{font-size:46px;line-height:1.02;margin:8px 0 0}.hc-new p{color:var(--muted);line-height:1.55}.block{padding:82px 0}.block>header,.converter-box>header,.library header{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:30px}.block>header>p,.library header>p{max-width:450px}.hero-new{padding:58px 0 35px}.hero-grid-new{display:grid;grid-template-columns:1.02fr .98fr;gap:50px;align-items:center}.hero-copy h1{font-size:68px;line-height:.92;margin:15px 0 22px}.hero-copy h1 em{font-style:normal;color:var(--blue)}.hero-copy>p{font-size:17px}.search-shell{margin-top:28px;background:white;border:1px solid var(--line);border-radius:18px;padding:9px;box-shadow:0 18px 45px #263b7724}.assistant{font-size:11px;padding:8px 5px}.assistant summary{cursor:pointer}.assistant summary b{color:var(--blue)}.quick{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.quick a,.countries a,.filters>*{border:1px solid var(--line);background:#fff;border-radius:99px;padding:7px 10px;font-size:10px}.hero-visual{position:relative;min-height:470px}.orb{position:absolute;width:350px;height:350px;right:0;top:45px;border-radius:50%;background:linear-gradient(145deg,#5274ff,#11277d)}.dash{position:absolute;left:35px;top:0;width:410px;background:#fff;border-radius:24px;padding:20px;box-shadow:0 30px 70px #05184538;transform:rotate(-2deg)}.balance{background:var(--ink);color:white;border-radius:18px;padding:22px;margin-top:18px}.balance small,.balance span{display:block;color:#afbddb}.balance strong{display:block;font:700 38px Georgia;margin:8px 0}.bars{display:flex;align-items:end;gap:8px;height:70px;margin-top:10px}.bars i{width:15%;height:45%;border-radius:7px 7px 2px 2px;background:#5270db}.bars i:nth-child(2){height:60%}.bars i:nth-child(3){height:83%}.bars i:nth-child(4){height:48%;background:var(--lime)}.bars i:nth-child(5){height:72%}.bars i:nth-child(6){height:95%;background:#fff}.result{position:absolute;right:0;bottom:25px;width:220px;background:var(--lime);border-radius:20px;padding:18px;transform:rotate(3deg);box-shadow:0 18px 40px #061f3c2b}.result strong{display:block;font:700 27px Georgia;margin:7px 0}.result span,.result small{font-size:10px}.ticker{display:grid;grid-template-columns:1.15fr repeat(4,1fr);background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden}.ticker>*{padding:14px 18px;border-left:1px solid var(--line);font-size:12px}.ticker small{display:block;color:var(--muted)}.countries{display:flex;justify-content:center;gap:6px;flex-wrap:wrap;margin-top:18px}.meta{text-align:center;font-size:11px;margin-top:15px}.meta a{color:var(--blue)}.moments header p{max-width:500px}.moment-grid{display:grid;grid-template-columns:1.35fr .65fr .65fr;grid-template-rows:260px 260px;gap:15px}.moment{border:1px solid #071a3d15;border-radius:25px;padding:26px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden;background:#ffe9d7}.moment.big{grid-row:span 2;background:var(--ink);color:#fff}.moment.home{background:#e2f0ff}.moment.biz{background:#eee9ff}.moment.save{background:#dff8ec}.moment .art{position:absolute;right:16px;top:16px;width:54%;height:47%;border-radius:18px;background:#ffffff99}.moment.big .art{width:82%;right:9%;background:linear-gradient(140deg,#2848aa,#0e2a72)}.moment h3,.moment p,.moment b,.moment>.eyebrow{position:relative;z-index:1}.moment h3{font-size:26px;margin:8px 0}.moment.big h3{font-size:42px}.moment p{f