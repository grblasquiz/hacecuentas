---
/**
 * ScenarioComparator — comparar 2 escenarios A vs B inline.
 *
 * Útil para:
 *  - Sueldo (oferta actual vs propuesta)
 *  - Plazo fijo (banco A vs B)
 *  - Monotributo (categoría X vs Y)
 *  - Créditos (UVA vs fijo)
 *
 * Versión 1: escenarios estáticos pre-calculados en el JSON (sin JS).
 * Versión 2 (futura): dispatcher event 'hc-scenario-compute' que el Calculator
 * escucha y recalcula. Pulir cuando haya >1 calc usando esto.
 */

export type Scenario = {
  /** Tag visible arriba del card (ej. "Actual", "Propuesta", "Banco A"). */
  tag: string;
  /** Tag style: 'current' usa --accent, 'alt' usa --accent-2. Default 'current' al primero, 'alt' al segundo. */
  variant?: "current" | "alt";
  /** Inputs visibles del escenario (ej. {"Bruto": "$1.500.000", "Categoría": "B"}). */
  inputs: Array<{ label: string; value: string }>;
  /** Resultado destacado del escenario (ej. "$1.107.250"). */
  result: string;
  /** Label del resultado (ej. "Neto en mano"). */
  resultLabel?: string;
  /** Detalle opcional (ej. "↓ Ganancias $35k"). */
  detail?: string;
};

interface Props {
  /** Título del bloque (ej. "Comparar escenarios"). */
  title?: string;
  /** El escenario actual del usuario. */
  current: Scenario;
  /** El escenario alternativo (a comparar). */
  alternative: Scenario;
  /** Summary inteligente opcional debajo (ej. "La propuesta te deja +$191.150 más por mes (+17.3%)"). */
  summary?: string;
  /** Emoji opcional para el summary. Default 💡. */
  summaryIcon?: string;
}

const { title = "Comparar escenarios", current, alternative, summary, summaryIcon = "💡" } = Astro.props;

const currVariant = current.variant || "current";
const altVariant = alternative.variant || "alt";
---

<section class="scenario-comparator" aria-label={title}>
  {title && <div class="scenario-comparator-title">{title}</div>}
  <div class="scenario-comparator-cards">
    <article class={`scenario-card scenario-card--${currVariant}`}>
      <span class="scenario-card-tag">{current.tag}</span>
      <div class="scenario-card-inputs">
        {current.inputs.map((inp) => (
          <div class="scenario-card-input-row">
            <span class="scenario-card-input-label">{inp.label}</span>
            <span class="scenario-card-input-value">{inp.value}</span>
          </div>
        ))}
      </div>
      <div class="scenario-card-result">{current.result}</div>
      {current.resultLabel && <div class="scenario-card-result-label">{current.resultLabel}</div>}
      {current.detail && <div class="scenario-card-detail">{current.detail}</div>}
    </article>

    <article class={`scenario-card scenario-card--${altVariant}`}>
      <span class="scenario-card-tag">{alternative.tag}</span>
      <div class="scenario-card-inputs">
        {alternative.inputs.map((inp) => (
          <div class="scenario-card-input-row">
            <span class="scenario-card-input-label">{inp.label}</span>
            <span class="scenario-card-input-value">{inp.value}</span>
          </div>
        ))}
      </div>
      <div class="scenario-card-result">{alternative.result}</div>
      {alternative.resultLabel && <div class="scenario-card-result-label">{alternative.resultLabel}</div>}
      {alternative.detail && <div class="scenario-card-detail">{alternative.detail}</div>}
    </article>
  </div>

  {summary && (
    <div class="scenario-summary">
      <span class="scenario-summary-icon" aria-hidden="true">{summaryIcon}</span>
      <span class="scenario-summary-text" set:html={summary}></span>
    </div>
  )}
</section>

<style>
  .scenario-comparator {
    margin: 1.5rem 0;
    padding: 1.125rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .scenario-comparator-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    margin-bottom: 0.875rem;
  }
  .scenario-comparator-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
  }
  @media (max-width: 540px) {
    .scenario-comparator-cards {
      grid-template-columns: 1fr;
    }
  }
  .scenario-card {
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 0.875rem 0.875rem;
    position: relative;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .scenario-card--current {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent);
  }
  .scenario-card-tag {
    position: absolute;
    top: -0.625rem;
    left: 0.875rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.1875rem 0.5rem;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  html[data-theme="dark"] .scenario-card-tag {
    color: var(--bg);
  }
  .scenario-card--alt .scenario-card-tag {
    background: #7c3aed;
  }
  html[data-theme="dark"] .scenario-card--alt .scenario-card-tag {
    background: #a78bfa;
  }
  .scenario-card-inputs {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.625rem;
    padding-top: 0.25rem;
  }
  .scenario-card-input-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.75rem;
    gap: 0.5rem;
  }
  .scenario-card-input-label {
    color: var(--text-subtle);
  }
  .scenario-card-input-value {
    color: var(--text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .scenario-card-result {
    font-size: 1.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 60%, #7c3aed));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 0.25rem;
    font-variant-numeric: tabular-nums;
  }
  .scenario-card-result-label {
    font-size: 0.6875rem;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }
  .scenario-card-detail {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.375rem;
    font-weight: 500;
  }
  .scenario-summary {
    margin-top: 0.875rem;
    padding: 0.75rem 0.875rem;
    background: linear-gradient(135deg, var(--bg-soft), var(--bg-card));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .scenario-summary-icon {
    font-size: 1.125rem;
    flex-shrink: 0;
  }
  .scenario-summary-text strong {
    color: var(--accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  html[data-theme="dark"] .scenario-summary-text strong {
    color: var(--accent-strong);
  }
</style>
