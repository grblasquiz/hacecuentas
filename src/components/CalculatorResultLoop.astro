---
interface RelatedAction { href: string; title: string; description: string; }
interface Props {
  slug: string;
  title: string;
  rootSelector: string;
  completeSelector: string;
  resultSelector: string;
  summarySelector: string;
  reminder?: { date: string; title: string; description: string };
  related: RelatedAction[];
}
const { slug, title, rootSelector, completeSelector, resultSelector, summarySelector, reminder, related } = Astro.props;
---

<section class="result-loop" data-result-loop hidden aria-labelledby="result-loop-title">
  <div class="result-loop__head">
    <div>
      <span class="result-loop__eyebrow">Tu próxima acción</span>
      <h2 id="result-loop-title">No dejes este número suelto.</h2>
      <p data-result-loop-summary>Guardalo, compartilo o seguí con la cuenta que viene.</p>
    </div>
    <a class="result-loop__dashboard" href="/mi">Abrir Mi tablero →</a>
  </div>

  <div class="result-loop__actions">
    <button type="button" data-loop-save><span aria-hidden="true">☆</span><b>Guardar cálculo</b><small>Queda disponible en Mi tablero</small></button>
    <button type="button" data-loop-share><span aria-hidden="true">↗</span><b>Compartir resultado</b><small>Resumen y enlace para recalcular</small></button>
    {reminder && <button type="button" data-loop-reminder><span aria-hidden="true">◷</span><b>Agregar recordatorio</b><small>{reminder.title}</small></button>}
  </div>

  <div class="result-loop__next">
    <span>Seguí con tu situación</span>
    <div>
      {related.map((action) => (
        <a href={action.href} data-loop-related>
          <b>{action.title}</b><small>{action.description}</small><i aria-hidden="true">→</i>
        </a>
      ))}
    </div>
  </div>
  <p class="result-loop__status" data-loop-status role="status" aria-live="polite"></p>
</section>

<script is:inline define:vars={{ slug, title, rootSelector, completeSelector, resultSelector, summarySelector, reminder }}>
  (function () {
    var calculator = document.querySelector(rootSelector);
    var loop = document.querySelector('[data-result-loop]');
    if (!calculator || !loop) return;
    var started = false;
    var completed = false;
    var track = typeof window.hcTrack === 'function' ? window.hcTrack : function () {};
    var base = { calculator_slug: slug, calculator_category: 'trabajo', country: 'AR' };
    function emit(name, extra) { track(name, Object.assign({}, base, extra || {})); }
    function status(message) {
      var el = loop.querySelector('[data-loop-status]');
      if (el) el.textContent = message;
    }
    function resultText() {
      return (calculator.querySelector(resultSelector)?.textContent || '').trim();
    }
    function summaryText() {
      return (calculator.querySelector(summarySelector)?.textContent || '').trim();
    }
    function markStart() {
      if (started) return;
      started = true;
      emit('calculator_start');
    }
    calculator.addEventListener('input', markStart, { once: true, passive: true });
    calculator.addEventListener('change', markStart, { once: true, passive: true });
    calculator.addEventListener('click', function (event) {
      if (event.target && event.target.closest('.mode, .month, #findBest')) markStart();
    }, true);

    var complete = calculator.querySelector(completeSelector);
    if (complete) complete.addEventListener('click', function () {
      markStart();
      setTimeout(function () {
        loop.hidden = false;
        var summary = loop.querySelector('[data-result-loop-summary]');
        if (summary) summary.textContent = resultText() + ' · ' + summaryText();
        emit('calculator_complete');
        completed = true;
        loop.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 30);
    });

    loop.querySelector('[data-loop-save]')?.addEventListener('click', function () {
      if (!completed) return;
      try {
        var entry = {
          nombre: title + ' — ' + new Date().toLocaleDateString('es-AR'),
          slug: slug,
          url: window.location.pathname,
          resultLabel: 'Aguinaldo neto estimado',
          resultado: resultText(),
          ts: Date.now()
        };
        var list = [];
        try { list = JSON.parse(localStorage.getItem('hc:saved-calcs') || '[]'); } catch (e) {}
        if (!Array.isArray(list)) list = [];
        list = list.filter(function (item) { return !(item && item.slug === slug); });
        list.unshift(entry);
        localStorage.setItem('hc:saved-calcs', JSON.stringify(list.slice(0, 50)));
        window.dispatchEvent(new CustomEvent('hc:calc-saved', { detail: entry }));
        emit('save_to_dashboard');
        status('✓ Guardado en Mi tablero.');
      } catch (e) { status('No pudimos guardar en este navegador.'); }
    });

    loop.querySelector('[data-loop-share]')?.addEventListener('click', async function () {
      if (!completed) return;
      var text = title + ': ' + resultText() + '. ' + summaryText();
      var payload = { title: title, text: text, url: window.location.href };
      try {
        if (navigator.share) await navigator.share(payload);
        else {
          await navigator.clipboard.writeText(text + ' ' + window.location.href);
          status('✓ Resultado y enlace copiados.');
        }
        emit('result_share');
      } catch (e) { if (e && e.name !== 'AbortError') status('No pudimos compartir el resultado.'); }
    });

    loop.querySelector('[data-loop-reminder]')?.addEventListener('click', function () {
      if (!reminder) return;
      var day = reminder.date.replace(/-/g, '');
      var next = new Date(reminder.date + 'T12:00:00'); next.setDate(next.getDate() + 1);
      var nextDay = next.toISOString().slice(0, 10).replace(/-/g, '');
      var esc = function (value) { return String(value).replace(/([,;\\])/g, '\\$1').replace(/\n/g, '\\n'); };
      var ics = ['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Hace Cuentas//Recordatorios//ES','BEGIN:VEVENT','UID:' + slug + '-' + day + '@hacecuentas.com','DTSTART;VALUE=DATE:' + day,'DTEND;VALUE=DATE:' + nextDay,'SUMMARY:' + esc(reminder.title),'DESCRIPTION:' + esc(reminder.description + ' ' + window.location.href),'URL:' + window.location.href,'END:VEVENT','END:VCALENDAR'].join('\r\n');
      var a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar;charset=utf-8' }));
      a.download = 'recordatorio-aguinaldo-2026.ics';
      a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
      status('✓ Recordatorio descargado para tu calendario.');
    });

    loop.querySelectorAll('[data-loop-related]').forEach(function (link) {
      link.addEventListener('click', function () {
        emit('related_click', { target_slug: link.getAttribute('href') || '', source_page: 'post_result' });
      });
    });
  })();
</script>

<style>
  .result-loop { width:min(1180px,calc(100% - 48px)); margin:28px auto 70px; padding:28px; border:1px solid #dbe2df; border-radius:22px; background:#fff; color:#10192d; box-shadow:0 18px 44px #25342812; }
  .result-loop__head { display:flex; justify-content:space-between; gap:24px; align-items:end; }
  .result-loop__eyebrow,.result-loop__next>span { color:#9b681f; font-size:10px; font-weight:900; letter-spacing:.13em; text-transform:uppercase; }
  h2 { margin:7px 0 5px; font-size:clamp(25px,3vw,36px); letter-spacing:-.04em; }
  p { margin:0; color:#687487; }
  .result-loop__dashboard { color:#1d674f; font-size:13px; font-weight:850; text-decoration:none; white-space:nowrap; }
  .result-loop__actions { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin:23px 0; }
  .result-loop__actions button { display:grid; grid-template-columns:34px 1fr; gap:1px 10px; text-align:left; padding:15px; border:1px solid #dbe2df; border-radius:14px; background:#f8faf8; color:#10192d; cursor:pointer; }
  .result-loop__actions button:hover { border-color:#b88735; background:#fff8e9; }
  .result-loop__actions span { grid-row:1/3; display:grid; place-items:center; width:32px; height:32px; border-radius:9px; background:#e8f4ef; color:#257159; font-size:18px; }
  .result-loop__actions b { font-size:13px; }.result-loop__actions small { color:#6b7788; font-size:10px; }
  .result-loop__next { padding-top:20px; border-top:1px solid #e2e6e4; }
  .result-loop__next>div { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; margin-top:10px; }
  .result-loop__next a { position:relative; display:flex; flex-direction:column; padding:15px 42px 15px 16px; border-radius:13px; background:#182c49; color:#fff; text-decoration:none; }
  .result-loop__next small { color:#bfccda; font-size:10px; }.result-loop__next i { position:absolute; right:16px; top:50%; transform:translateY(-50%); font-style:normal; }
  .result-loop__status { min-height:20px; margin-top:12px; color:#28745d; font-size:12px; font-weight:750; }
  @media(max-width:700px){.result-loop{width:calc(100% - 30px);padding:21px}.result-loop__head{align-items:start;flex-direction:column}.result-loop__actions,.result-loop__next>div{grid-template-columns:1fr}}
</style>
