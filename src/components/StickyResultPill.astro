---
/**
 * StickyResultPill — pill flotante en mobile cuando el resultado primary sale del viewport.
 *
 * - Solo se activa en pantallas < 768px (matchMedia).
 * - Observa `.result.primary` con IntersectionObserver.
 * - Cuando el primary sale del viewport Y los resultados están visibles,
 *   muestra la pill arriba con el valor actual.
 * - Tap en el pill → scroll smooth al primary.
 * - MutationObserver sobre [data-value] mantiene la pill sincronizada con el valor.
 * - Respeta prefers-reduced-motion.
 *
 * Performance: ~0.8KB minified, sin librerías, lazy (rAF + idle callback).
 */
interface Props { lang?: 'es' | 'en' | 'pt' }
const { lang = 'es' } = Astro.props;
const T = ({
  es: { copy: 'Copiar resultado', back: 'Volver al resultado', label: 'Tu resultado' },
  en: { copy: 'Copy result', back: 'Back to result', label: 'Your result' },
  pt: { copy: 'Copiar resultado', back: 'Voltar ao resultado', label: 'Seu resultado' },
} as const)[lang] || { copy: 'Copiar resultado', back: 'Volver al resultado', label: 'Tu resultado' };
---

<div class="sticky-result-pill" data-sticky-pill hidden aria-live="polite">
  <div class="sticky-result-pill-icon" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="1" x2="12" y2="23"/>
      <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
    </svg>
  </div>
  <div class="sticky-result-pill-content">
    <div class="sticky-result-pill-label" data-pill-label>{T.label}</div>
    <div class="sticky-result-pill-value" data-pill-value>—</div>
  </div>
  <div class="sticky-result-pill-actions">
    <button type="button" class="sticky-result-pill-btn" data-pill-copy aria-label={T.copy}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
    </button>
    <button type="button" class="sticky-result-pill-btn" data-pill-scroll aria-label={T.back}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .sticky-result-pill {
    position: fixed;
    /* DEBE quedar DEBAJO del header sticky (.site-header, top:0, z-index:100,
       ~61px en mobile). Con top:0.625rem el header lo tapaba y los taps caían
       en el botón de país del header. 4.25rem (~68px) lo despeja. */
    top: 4.25rem;
    left: 0.625rem;
    right: 0.625rem;
    z-index: 80;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    transform: translateY(-110%);
    opacity: 0;
    transition:
      transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.2s ease;
    pointer-events: none;
  }
  .sticky-result-pill.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .sticky-result-pill[hidden] {
    display: none !important;
  }
  .sticky-result-pill-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 50%, var(--accent-2)));
    color: var(--on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sticky-result-pill-content {
    flex: 1;
    min-width: 0;
    line-height: 1.15;
  }
  .sticky-result-pill-label {
    font-size: 0.65rem;
    color: var(--text-subtle);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sticky-result-pill-value {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sticky-result-pill-actions {
    display: flex;
    gap: 0.25rem;
  }
  .sticky-result-pill-btn {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
    padding: 0;
  }
  .sticky-result-pill-btn:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }
  .sticky-result-pill-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .sticky-result-pill-btn.is-copied {
    background: var(--success-soft);
    border-color: var(--success);
    color: var(--success);
  }
  /* Solo en mobile */
  @media (min-width: 768px) {
    .sticky-result-pill {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-result-pill {
      transition: opacity 0.15s ease;
    }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var pill = document.querySelector('[data-sticky-pill]');
      if (!pill) return;
      var primary = document.querySelector('.result.primary');
      var resultsBox = document.querySelector('.calc-results');
      if (!primary || !resultsBox) return;

      // Solo mobile
      var mq = window.matchMedia('(max-width: 767px)');
      if (!mq.matches) return;

      var valueEl = primary.querySelector('[data-value]');
      var valueOutEl = pill.querySelector('[data-pill-value]');
      var labelOutEl = pill.querySelector('[data-pill-label]');
      var scrollBtn = pill.querySelector('[data-pill-scroll]');
      var copyBtn = pill.querySelector('[data-pill-copy]');

      function setPillValue() {
        if (!valueEl || !valueOutEl) return;
        var txt = (valueEl.textContent || '').trim();
        if (txt) valueOutEl.textContent = txt;
      }

      // Toma el label del primary si existe
      var labelEl = primary.querySelector('.result-label');
      if (labelEl && labelOutEl) {
        var _defLabel = (labelOutEl.textContent || '').trim() || 'Tu resultado';
        labelOutEl.textContent = (labelEl.textContent || '').trim() || _defLabel;
      }
      setPillValue();

      var visible = false;
      function setVisible(v) {
        if (v === visible) return;
        visible = v;
        if (v) {
          pill.removeAttribute('hidden');
          // doble rAF para asegurar la animación
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { pill.classList.add('is-visible'); });
          });
        } else {
          pill.classList.remove('is-visible');
          setTimeout(function () {
            if (!visible) pill.setAttribute('hidden', '');
          }, 250);
        }
      }

      // Sólo mostrar cuando results visibles
      function resultsAreVisible() {
        return !resultsBox.hasAttribute('hidden');
      }

      var io = new IntersectionObserver(function (entries) {
        var e = entries[0];
        if (!e) return;
        setPillValue();
        if (!resultsAreVisible()) {
          setVisible(false);
          return;
        }
        setVisible(!e.isIntersecting);
      }, { threshold: 0, rootMargin: '-10px 0px 0px 0px' });
      io.observe(primary);

      // MutationObserver: actualiza valor cuando el JS de calc cambia [data-value]
      if (valueEl) {
        var mo = new MutationObserver(setPillValue);
        mo.observe(valueEl, { childList: true, characterData: true, subtree: true });
      }

      // Tap → volver al primary
      if (scrollBtn) {
        scrollBtn.addEventListener('click', function () {
          primary.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      // Copiar resultado (convierte la pill en mini action-bar). Self-contained:
      // copia el valor visible + feedback de check ~1.3s, sin depender del
      // delegation del Calculator.
      if (copyBtn) {
        var copyIconHTML = copyBtn.innerHTML;
        copyBtn.addEventListener('click', function () {
          var txt = ((valueOutEl && valueOutEl.textContent) || '').trim();
          if (!txt) return;
          var done = function () {
            copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
            copyBtn.classList.add('is-copied');
            setTimeout(function () {
              copyBtn.innerHTML = copyIconHTML;
              copyBtn.classList.remove('is-copied');
            }, 1300);
          };
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(txt).then(done).catch(function () {});
            } else {
              var ta = document.createElement('textarea');
              ta.value = txt;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              try { document.execCommand('copy'); } catch (e) {}
              document.body.removeChild(ta);
              done();
            }
          } catch (e) {}
        });
      }

      // Ocultar si results vuelven a estar hidden (cuando user da "Modificar datos")
      var mo2 = new MutationObserver(function () {
        if (!resultsAreVisible()) setVisible(false);
      });
      mo2.observe(resultsBox, { attributes: true, attributeFilter: ['hidden'] });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(init, { timeout: 1500 });
        } else {
          setTimeout(init, 250);
        }
      });
    } else {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(init, { timeout: 1500 });
      } else {
        setTimeout(init, 250);
      }
    }
  })();
</script>
