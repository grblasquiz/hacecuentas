---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
}

const { eyebrow, title, description, href, linkLabel } = Astro.props;
---

<aside class="contextual-tool" aria-label={title}>
  <div>
    <p>{eyebrow}</p>
    <h2>{title}</h2>
    <span>{description}</span>
  </div>
  <a href={href}>{linkLabel} <span aria-hidden="true">→</span></a>
</aside>

<style>
  .contextual-tool {
    width: min(1120px, calc(100% - 40px));
    margin: 36px auto 64px;
    padding: 24px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    border: 1px solid #dfe6ed;
    border-radius: 18px;
    background: #f7f9fc;
    color: #17253a;
  }
  p { margin: 0 0 7px; color: #376cb3; font-size: 11px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  h2 { margin: 0 0 7px; color: inherit; font-size: clamp(20px, 2.4vw, 28px); line-height: 1.15; }
  div > span { color: #59697d; line-height: 1.55; }
  a { flex: 0 0 auto; padding: 13px 17px; border-radius: 11px; background: #254f87; color: white; font-weight: 750; text-decoration: none; }
  a:hover { background: #1d416f; }
  a:focus-visible { outline: 3px solid #82ace3; outline-offset: 3px; }
  @media (max-width: 680px) {
    .contextual-tool { align-items: flex-start; flex-direction: column; padding: 22px; }
  }
</style>
