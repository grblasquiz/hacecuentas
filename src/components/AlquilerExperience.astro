---
interface Props {
  data: any;
  icl: number[];
  iclStart: string;
  iclLastUpdated: string;
  ipcKeys: string[];
  ipcPcts: number[];
  frecuencias: Record<string, number>;
  contratos: Record<string, number>;
}
const { data, icl, iclStart, iclLastUpdated, ipcKeys, ipcPcts, frecuencias, contratos } = Astro.props;
const years = new Intl.DateTimeFormat('es-AR', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(`${iclLastUpdated}T12:00:00`));
const defaultFromDate = (() => { const d = new Date(`${iclLastUpdated}T12:00:00`); d.setFullYear(d.getFullYear() - 1); return d.toISOString().slice(0, 10); })();
---
<main id="main" class="rent">
  <section class="hero">
    <div class="shell crumb"><a href="/alquiler">Alquiler</a><span>/</span>Aumento de alquiler</div>
    <div class="shell hero-grid">
      <div class="intro">
        <span class="eyebrow">Calculadora de alquiler</span>
        <h1>¿Cuánto vas a pagar en tu próximo ajuste?</h1>
        <p>Calculá tu nueva cuota según el índice y las fechas de tu contrato. Usamos datos oficiales del BCRA y del INDEC.</p>
        <div class="trust">
          <span><svg viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z"/></svg>Datos privados</span>
          <span><svg viewBox="0 0 24 24"><path d="M4 20h16M6 17V8h12v9M9 8V4h6v4"/></svg>Fuentes oficiales</span>
          <span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>ICL al {years}</span>
        </div>
        <svg class="hero-art" viewBox="0 0 500 230" role="img" aria-label="Edificio y llave de alquiler">
          <defs><linearGradient id="b" x1="0" x2="1"><stop stop-color="#d9e8ff"/><stop offset="1" stop-color="#eef5ff"/></linearGradient><filter id="s"><feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#17365f" flood-opacity=".12"/></filter></defs>
          <path d="M36 202h315" stroke="#1769e8" stroke-width="7"/>
          <path d="M58 65h188v137H58z" fill="url(#b)" filter="url(#s)"/>
          <path d="M92 101h30v27H92zm59 0h30v27h-30zm59 0h30v27h-30zM92 151h30v27H92zm59 0h30v51h-30zm59 0h30v27h-30z" fill="#fff"/>
          <circle cx="294" cy="127" r="52" fill="none" stroke="#efa62f" stroke-width="15"/>
          <path d="m334 158 114-37m-12 4 12 34m-42-24 11 35" fill="none" stroke="#efa62f" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <form class="calculator" id="rent-form">
        <div class="calc-head"><h2>Calculá tu aumento</h2><span>Resultado instantáneo</span></div>
        <fieldset>
          <legend>¿Cómo se actualiza tu contrato?</legend>
          <div class="modes">
            <label class="active"><input type="radio" name="mode" value="icl" checked><svg viewBox="0 0 40 40"><path d="M7 33h26M10 29V16h20v13M15 16V9h10v7"/></svg><b>ICL · BCRA</b></label>
            <label><input type="radio" name="mode" value="ipc"><svg viewBox="0 0 40 40"><path d="M6 32h28M9 27l8-9 6 5 10-15M27 8h6v6"/></svg><b>IPC · INDEC</b></label>
            <label><input type="radio" name="mode" value="manual"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="14"/><path d="m13 27 14-14M14 14h.1M26 26h.1"/></svg><b>% pactado</b></label>
          </div>
        </fieldset>
        <div class="other-label">Otros escenarios</div>
        <div class="more-modes">
          <label><input type="radio" name="mode" value="frecuencia"><span>Ajuste por frecuencia</span><small>Trimestral, cuatrimestral o semestral</small></label>
          <label><input type="radio" name="mode" value="contrato-2"><span>Contrato de 2 años</span><small>Proyección a 24 meses</small></label>
          <label><input type="radio" name="mode" value="contrato-3"><span>Contrato de 3 años</span><small>Proyección a 36 meses</small></label>
        </div>

        <div class="input-title">Datos del ajuste</div>
        <label class="field amount"><span>Alquiler que pagás hoy</span><div><b>$</b><input id="alquiler" inputmode="numeric" value="600.000" aria-label="Alquiler que pagás hoy"></div></label>
        <div class="field-grid date-fields">
          <label class="field"><span>Último ajuste o firma</span><input id="desde" type="date" value={defaultFromDate} min={iclStart} max={iclLastUpdated}></label>
          <label class="field"><span>Fecha del ajuste</span><input id="hasta" type="date" value={iclLastUpdated} min={iclStart} max={iclLastUpdated}></label>
        </div>
        <div class="field-grid rate-fields" hidden>
          <label class="field"><span>Ajuste mensual estimado</span><div><input id="tasa" type="number" value="2" min="-10" max="100" step=".1"><b>%</b></div></label>
          <label class="field months-field"><span>Meses del período</span><div><input id="meses" type="number" value="12" min="1" max="120"><b>meses</b></div></label>
          <label class="field frequency-field" hidden><span>Frecuencia</span><select id="frecuencia"><option value="trim">Trimestral</option><option value="cuat">Cuatrimestral</option><option value="sem">Semestral</option><option value="anual">Anual</option></select></label>
        </div>
        <details class="manual-coef"><summary>Usar un coeficiente ICL exacto</summary><label class="field"><span>Coeficiente opcional</span><input id="coef" type="text" inputmode="decimal" placeholder="Ej. 1,2941"></label></details>

        <section class="result" aria-live="polite">
          <div class="result-top"><div><span>Tu alquiler nuevo sería</span><strong id="total">$0</strong></div><b id="rise">0%</b></div>
          <div class="comparison"><div><small>Pagás hoy</small><b id="old">$0</b></div><svg viewBox="0 0 28 20"><path d="M2 10h22m-6-6 6 6-6 6"/></svg><div><small id="new-label">Desde el próximo ajuste</small><b id="new">$0</b></div></div>
          <div class="progress"><i id="progress"></i></div>
          <p id="result-detail"></p>
          <div class="actions"><button class="primary" type="submit">Actualizar cálculo</button><button class="share" type="button">Compartir</button></div>
        </section>
        <p class="fineprint"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/><path d="M10 9v5M10 6v.2"/></svg>El contrato manda: índice, frecuencia, moneda y topes tienen que estar escritos ahí.</p>
      </form>
    </div>
  </section>

  <section class="explanation shell">
    <header><span>Resultado explicado</span><h2>Entendé de dónde sale el aumento</h2><p>Sin fórmulas escondidas: te mostramos el índice aplicado, la diferencia en pesos y cómo impacta en tu presupuesto.</p></header>
    <div class="explain-grid">
      <article class="bars-card card"><h3>Antes y después del ajuste</h3><div class="bars">
        <div><b>Alquiler actual</b><i><em id="old-bar"></em></i><strong id="old-row">$0</strong></div>
        <div><b>Aumento</b><i><em id="increase-bar"></em></i><strong id="increase-row">$0</strong></div>
        <div><b>Nueva cuota</b><i><em id="new-bar"></em></i><strong id="new-row">$0</strong></div>
      </div><div class="metrics"><span>Coeficiente aplicado<strong id="coef-value">1,0000</strong></span><span>Aumento porcentual<strong id="pct-value">0%</strong></span></div></article>
      <aside class="legal card"><div class="legal-head"><i><svg viewBox="0 0 32 32"><path d="M7 3h13l5 5v21H7zM20 3v6h5M11 15h10M11 20h10"/></svg></i><div><span>Tu contrato manda</span><h3 id="legal-title">Ajuste por ICL</h3></div></div><p id="legal-copy">Se compara el ICL del próximo ajuste contra el del último ajuste o la firma.</p><div class="formula" id="formula">ICL nuevo ÷ ICL anterior = coeficiente</div><div class="warning"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/><path d="M10 5v6M10 14v.2"/></svg><span id="warning-copy">Revisá que ambas fechas coincidan con las que figuran en tu contrato.</span></div></aside>
    </div>
  </section>

  <section class="guide">
    <div class="shell"><header><span>Elegí bien el índice</span><h2>¿Qué dice tu contrato?</h2><p>Cada modalidad se calcula distinto. Te ayudamos a identificar cuál corresponde en tu caso.</p></header>
      <div class="guide-grid">
        <article><svg viewBox="0 0 48 48"><path d="M7 40h34M11 35V18h26v17M17 18V9h14v9"/></svg><b>El más habitual</b><h3>ICL del BCRA</h3><p>Para contratos que indican “Índice para Contratos de Locación”. Usa la serie diaria oficial.</p></article>
        <article><svg viewBox="0 0 48 48"><path d="M7 39h34M10 33l9-10 7 5 12-17M31 11h7v7"/></svg><b>Inflación</b><h3>IPC del INDEC</h3><p>Para contratos que ajustan por inflación acumulada entre los meses publicados.</p></article>
        <article><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"/><path d="M16 32l16-16M17 17h.1M31 31h.1"/></svg><b>Libre acuerdo</b><h3>Porcentaje pactado</h3><p>Para ajustes trimestrales, cuatrimestrales o semestrales con una tasa definida.</p></article>
      </div>
      <aside class="contract-note"><strong>¿Tu contrato menciona Casa Propia?</strong><span>Algunos contratos firmados durante 2023 usan ese coeficiente y ajuste semestral. No lo reemplaces por ICL o IPC: verificá la cláusula y consultá el índice oficial correspondiente.</span></aside>
    </div>
  </section>

  <section class="timeline shell"><header><span>Tu contrato en el tiempo</span><h2>Qué fecha tenés que usar</h2><p>El error más común es volver a usar la fecha de firma después de haber tenido un ajuste.</p></header><div class="timeline-row">
    <article><i></i><h3>Firma del contrato</h3><p>Es la fecha inicial sólo si todavía no tuviste ningún aumento.</p></article>
    <article><i></i><h3>Último ajuste</h3><p>Desde acá se calcula el próximo si ya hubo aumentos anteriores.</p></article>
    <article><i></i><h3>Próximo ajuste</h3><p>La fecha en la que empieza a regir tu nueva cuota.</p></article>
  </div></section>

  <section class="content shell">
    <article><span>Tu resultado, explicado</span><h2>El índice y las fechas definen cuánto vas a pagar</h2><p>Los contratos anteriores al DNU 70/2023 mantienen las reglas con las que fueron firmados. En los contratos nuevos, las partes pueden acordar plazo, moneda, índice y frecuencia. Por eso esta calculadora parte de lo que dice tu contrato y no de una regla única.</p></article>
    <section class="faq"><h2>Preguntas frecuentes</h2>{data.faq.map((f:any, i:number)=><details open={i===0}><summary>{f.q}<svg viewBox="0 0 20 20"><path d="m5 7 5 5 5-5"/></svg></summary><p>{f.a}</p></details>)}</section>
    <section class="sources"><h2>Fuentes oficiales</h2>{data.sources.map((s:any)=><a href={s.url} target="_blank" rel="noopener"><span>{s.name}<small>{s.publisher}{s.date ? ` · ${s.date}` : ''}</small></span><svg viewBox="0 0 20 20"><path d="M7 5h8v8M15 5 6 14"/></svg></a>)}</section>
  </section>
</main>

<script is:inline define:vars={{ ICL: icl, ICL_START: iclStart, ICL_LAST_UPDATED: iclLastUpdated, IPC_KEYS: ipcKeys, IPC_PCTS: ipcPcts, FREQ: frecuencias, CONTRATO: contratos }}>
(() => {
  const $ = (id) => document.getElementById(id);
  const form = $('rent-form');
  if (!form) return;
  const DAY = 86400000, START = Date.parse(ICL_START + 'T00:00:00Z');
  const money = n => '$' + Math.round(n || 0).toLocaleString('es-AR');
  const dec = (n,d=1) => Number(n).toLocaleString('es-AR',{minimumFractionDigits:d,maximumFractionDigits:d});
  const num = raw => { const s=String(raw||'').replace(/[^\d,-]/g,'').replace(/\./g,'').replace(',','.'); return Number(s)||0 };
  const parseCoef = raw => { const s=String(raw||'').trim().replace(/[^\d.,-]/g,''); const p=Math.max(s.lastIndexOf('.'),s.lastIndexOf(',')); return Number(p<0?s:s.slice(0,p).replace(/[.,]/g,'')+'.'+s.slice(p+1)) };
  const dateOk = s => /^\d{4}-\d{2}-\d{2}$/.test(s);
  const iclAt = iso => { const i=Math.round((Date.parse(iso+'T00:00:00Z')-START)/DAY); if(i<0||i>=ICL.length)return null;return {v:ICL[i],date:new Date(START+i*DAY).toISOString().slice(0,10)} };
  const previousMonth = iso => { const d=new Date(iso+'T12:00:00Z');d.setUTCDate(1);d.setUTCMonth(d.getUTCMonth()-1);return d.toISOString().slice(0,7) };
  const ipcPeriod = (a,b) => { const from=IPC_KEYS.indexOf(a),to=IPC_KEYS.indexOf(b);if(from<0||to<from)return null;let factor=1;for(let i=from;i<=to;i++)factor*=1+IPC_PCTS[i]/100;return {factor,months:to-from+1,from:IPC_KEYS[from],to:IPC_KEYS[to]} };
  const currentMode = () => form.querySelector('input[name=mode]:checked')?.value || 'icl';
  function state() {
    const mode=currentMode(), rent=num($('alquiler').value), from=$('desde').value, to=$('hasta').value, rate=Number($('tasa').value||0)/100, months=Math.max(1,Number($('meses').value||12));
    let factor=1,valid=true,detail='',formula='',title='',copy='',warning='Revisá que los datos coincidan con los que figuran en tu contrato.';
    if(mode==='icl'){ const manual=parseCoef($('coef').value); title='Ajuste por ICL';copy='Se compara el ICL del día del ajuste contra el del último ajuste o la firma.';if(Number.isFinite(manual)&&manual>=.5&&manual<=10){factor=manual;formula='Coeficiente manual = '+dec(factor,4);detail='Usamos el coeficiente exacto que cargaste.'}else if(dateOk(from)&&dateOk(to)&&from<=to){const a=iclAt(from),b=iclAt(to);if(a&&b){factor=b.v/a.v;formula=dec(b.v,4)+' ÷ '+dec(a.v,4)+' = '+dec(factor,4);detail='ICL BCRA del '+a.date+' al '+b.date+'. Último dato disponible: '+ICL_LAST_UPDATED+'.'}else{valid=false;detail='No hay ICL oficial para una de las fechas. La serie disponible llega hasta '+ICL_LAST_UPDATED+'.';warning='No reemplazamos fechas faltantes por valores cercanos.'}}else{valid=false;detail='Completá las dos fechas en orden.'}}
    else if(mode==='ipc'){title='Ajuste por IPC';copy='Se compone el IPC de cada mes completo transcurrido.';const lastMonth=dateOk(to)?previousMonth(to):'',p=dateOk(from)&&dateOk(to)&&from<to?ipcPeriod(from.slice(0,7),lastMonth):null;if(p){factor=p.factor;formula=p.months+' meses compuestos = ×'+dec(factor,4);detail='IPC desde '+p.from+' hasta '+p.to+', ambos incluidos.'}else{valid=false;detail='Falta al menos un IPC mensual para completar ese período.';warning='El INDEC publica cada mes durante el mes siguiente; no estimamos datos faltantes.'}}
    else if(mode==='frecuencia'){const f=$('frecuencia').value,mp=FREQ[f]||3;factor=Math.pow(1+rate,12);title='Ajuste por frecuencia';copy='La tasa mensual se compone durante 12 meses.';formula=Math.floor(12/mp)+' ajustes · ×'+dec(factor,4);detail='Proyección orientativa con inflación mensual constante.'}
    else {const n=mode==='contrato-2'?24:mode==='contrato-3'?36:months;factor=Math.pow(1+rate,n);title=mode==='manual'?'Porcentaje pactado':mode==='contrato-2'?'Contrato de 2 años':'Contrato de 3 años';copy='Cada período se aplica sobre el alquiler ya actualizado.';formula='(1 + '+dec(rate*100,1)+'%)^'+n+' = ×'+dec(factor,4);detail='Proyección de '+n+' meses con tasa constante.'}
    if(!Number.isFinite(factor)||factor<=0){factor=1;valid=false}
    const next=Math.round(rent*factor),inc=next-rent,pct=(factor-1)*100,max=Math.max(1,next);
    $('total').textContent=valid?money(next):'Dato pendiente';$('old').textContent=money(rent);$('new').textContent=valid?money(next):'—';$('rise').textContent=valid?(pct>=0?'↑ ':'↓ ')+dec(Math.abs(pct),1)+'%':'Sin estimar';$('progress').style.width=valid?Math.min(100,rent/max*100)+'%':'0%';$('result-detail').textContent=detail;
    $('old-row').textContent=money(rent);$('increase-row').textContent=valid?(inc>=0?'+':'')+money(inc):'—';$('new-row').textContent=valid?money(next):'—';$('old-bar').style.width=valid?rent/max*100+'%':'0%';$('increase-bar').style.width=valid?Math.max(0,inc)/max*100+'%':'0%';$('new-bar').style.width=valid?'100%':'0%';$('coef-value').textContent=valid?dec(factor,4):'—';$('pct-value').textContent=valid?(pct>=0?'+':'')+dec(pct,1)+'%':'—';$('legal-title').textContent=title;$('legal-copy').textContent=copy;$('formula').textContent=valid?(formula||'Completá los datos para ver la fórmula'):'Esperando datos oficiales';$('warning-copy').textContent=warning;
  }
  function modeUI(){
    const mode=currentMode(),dates=mode==='icl'||mode==='ipc',rate=!dates;
    document.querySelectorAll('.modes label').forEach(l=>l.classList.toggle('active',l.querySelector('input').checked));
    document.querySelector('.date-fields').hidden=!dates;document.querySelector('.rate-fields').hidden=!rate;document.querySelector('.manual-coef').hidden=mode!=='icl';document.querySelector('.months-field').hidden=mode!=='manual';document.querySelector('.frequency-field').hidden=mode!=='frecuencia';
    state();
  }
  form.addEventListener('submit',e=>{e.preventDefault();state()});form.addEventListener('input',state);form.addEventListener('change',e=>{if(e.target.name==='mode')modeUI();else state()});
  document.querySelector('.share').addEventListener('click',async()=>{const text='Mi alquiler actualizado sería '+$('total').textContent;try{if(navigator.share)await navigator.share({title:'Aumento de alquiler',text,url:location.href});else await navigator.clipboard.writeText(text+' '+location.href)}catch{}});
  modeUI();
})();
</script>

<style>
