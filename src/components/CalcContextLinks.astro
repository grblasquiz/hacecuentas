---
/**
 * CalcContextLinks — bloques de linking contextual (blog / tabla de referencia /
 * Web Story) para las calcs BESPOKE, que no pasan por CalcLayoutV2.
 *
 * POR QUÉ: el audit de internal linking (2026-07-24) cableó esos tres bloques
 * dentro de CalcLayoutV2, pero las flagships y el batch de mockups renderizan su
 * propio layout — así que 10 calcs elegidas por los mapas quedaban sin el link
 * (98 de 115 links del blog llegaban a destino, no 115). Es el mismo motivo por
 * el que en su momento el CTA de /decidir no salía en las flagships.
 *
 * Se monta UNA vez en [...slug].astro cuando `flagshipBespoke` es true, así
 * cualquier mockup futuro lo hereda sin tocar el componente.
 *
 * Estilos propios (no hereda las var(--v2-*) de .calc-v2) y visual sobrio para
 * no competir con el diseño de cada mockup.
 */
import blogBacklinks from '../lib/blog-backlinks.json';
import { getTablaForCalc } from '../lib/tablas-map';
import { getHistoriaForArticle } from '../lib/historias-map';

interface Props {
  calc: any;
  /** '' = AR root · 'co' | 'mx' (los locales que resuelve el mapa del blog) */
  lang?: string;
}
const { calc, lang = '' } = Astro.props as Props;

const key = lang ? `${lang}/${calc.slug}` : calc.slug;
const blogPosts: Array<{ slug: string; title: string }> =
  (lang === '' || lang === 'co' || lang === 'mx')
    ? ((blogBacklinks as Record<string, Array<{ slug: string; title: string }>>)[key] || []).slice(0, 2)
    : [];
const tablaRef = getTablaForCalc(calc.slug, lang);
const historia = lang ? null : getHistoriaForArticle(`/${calc.slug}`);

const capitalize = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
const hasAny = blogPosts.length > 0 || !!tablaRef || !!historia;
---

{hasAny && (
  <section class="cxl" aria-label="Más sobre este tema">
    {blogPosts.length > 0 && (
      <div class="cxl-item">
        <span class="cxl-eb">📰 Para seguir leyendo</span>
        <a class="cxl-link" href={`/blog/${blogPosts[0].slug}`}>{capitalize(blogPosts[0].title)}</a>
        {blogPosts.length > 1 && (
          <a class="cxl-sub" href={`/blog/${blogPosts[1].slug}`}>{capitalize(blogPosts[1].title)}</a>
        )}
      </div>
    )}
    {tablaRef && (
      <div class="cxl-item">
        <span class="cxl-eb">📋 Tabla de referencia</span>
        <a class="cxl-link" href={`/tabla/${tablaRef.slug}`}>{tablaRef.label}</a>
      </div>
    )}
    {historia && (
      <div class="cxl-item">
        <span class="cxl-eb">📱 Versión rápida</span>
        <a class="cxl-link" href={`/historias/${historia.slug}`}>{historia.title}</a>
      </div>
    )}
  </section>
)}

<style>
  .cxl {
    width: min(1100px, calc(100% - 32px));
    margin: 28px auto 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 12px;
  }
  .cxl-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 15px 17px;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 14px;
    background: var(--bg-soft, #f8fafc);
    min-width: 0;
  }
  .cxl-eb {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted, #64748b);
  }
  .cxl-link {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--accent, #3157ff);
    text-decoration: none;
  }
  .cxl-sub {
    font-size: 13.5px;
    line-height: 1.35;
    color: var(--accent, #3157ff);
    text-decoration: none;
    opacity: 0.85;
  }
  .cxl-link:hover,
  .cxl-sub:hover { text-decoration: underline; }
</style>
