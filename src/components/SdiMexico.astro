<script is:inline>
  (function () {
    const root = document.querySelector('.sd');
    if (!root) return;
    const FM = Number(root.getAttribute('data-fmensual'));
    const TOPE = Number(root.getAttribute('data-tope'));
    const AGUI_MIN = Number(root.getAttribute('data-aguimin'));
    const PRIMA_MIN = Number(root.getAttribute('data-primamin'));
    const VAC = JSON.parse(root.getAttribute('data-vac'));
    const VAC_INC = Number(root.getAttribute('data-vacinc'));
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => '$' + (Math.round(n * 100) / 100).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const num = (el, d) => { const n = Number(String(el.value || '').replace(/[^\d.]/g, '')); return Number.isFinite(n) && n > 0 ? n : d; };
    const money = (el) => Number((el.value || '').replace(/\D/g, '')) || 0;
    const fmtTh = (v) => { const n = String(v).replace(/\D/g, ''); return n ? Number(n).toLocaleString('es-MX') : ''; };

    function dias(anios) {
      const a = Math.max(1, Math.floor(anios));
      if (a <= VAC.length) return VAC[a - 1];
      return 20 + VAC_INC * Math.ceil((a - VAC.length) / 5);
    }
    function calc() {
      const salario = money($('sd-salario'));
      const periodo = $('sd-periodo').value;
      const anios = Math.max(1, Math.floor(num($('sd-anios'), 1)));
      const agui = Math.max(AGUI_MIN, num($('sd-agui'), AGUI_MIN));
      const prima = Math.max(PRIMA_MIN, num($('sd-prima'), PRIMA_MIN));
      const extras = money($('sd-extras'));
      const salarioDiario = periodo === 'mensual' ? salario / FM : salario;
      const vac = dias(anios);
      const diasInt = 365 + agui + vac * (prima / 100);
      const factor = Math.round((diasInt / 365) * 10000) / 10000;
      const extrasDiario = extras / FM;
      const sdi = salarioDiario * factor + extrasDiario;
      const sbc = Math.min(sdi, TOPE);
      return {
        salario, periodo, salarioDiario, vac, agui, prima, diasInt, factor, sdi, sbc,
        topado: sdi > TOPE, sbcMensual: sbc * FM,
        aguiD: (salarioDiario * agui) / 365, primaD: (salarioDiario * vac * (prima / 100)) / 365,
        integrado: sdi - salarioDiario,
      };
    }
    function render() {
      const c = calc();
      $('sd-big').textContent = fmt(c.sdi);
      $('sd-sub').textContent = `por día · SBC mensual ${fmt(c.sbcMensual)}`;
      $('sd-t-factor').textContent = c.factor.toFixed(4);
      $('sd-t-sbc').textContent = fmt(c.sbcMensual);
      $('sd-t-diario').textContent = fmt(c.salarioDiario);
      $('sd-t-diario-lbl').textContent = c.periodo === 'mensual' ? `Salario diario · ${fmt(c.salario)} ÷ ${FM}` : 'Salario diario · sin prestaciones';
      $('sd-t-vac').textContent = c.vac + ' días';
      $('sd-formula').textContent = `(365 + ${c.agui} + ${c.vac} × ${c.prima}%) ÷ 365 = ${c.factor.toFixed(4)} · ${fmt(c.salarioDiario)} × ${c.factor.toFixed(4)} = ${fmt(c.sdi)}`;
      $('sd-topado').hidden = !c.topado;
      const dv = $('sd-deco-val'); if (dv) dv.textContent = fmt(c.sdi);
      const df = $('sd-deco-factor'); if (df) df.textContent = c.factor.toFixed(4);
    }

    ['sd-salario', 'sd-extras'].forEach((id) => $(id).addEventListener('input', (e) => { e.target.value = fmtTh(e.target.value); render(); }));
    ['sd-anios', 'sd-agui', 'sd-prima'].forEach((id) => $(id).addEventListener('input', render));
    $('sd-periodo').addEventListener('change', render);
    $('sd-calc-btn').addEventListener('click', render);

    function summary() {
      const c = calc();
      return `SDI México: salario diario ${fmt(c.salarioDiario)} × factor ${c.factor.toFixed(4)} = ${fmt(c.sdi)}/día. SBC mensual ${fmt(c.sbcMensual)}, ${c.vac} días de vacaciones. — hacecuentas.com`;
    }
    function shareUrl() { const c = calc(); return `${location.origin}${location.pathname}?salario=${c.salario}&periodo=${c.periodo}&anios=${c.anios || 1}`; }
    function copy(t, btn) { navigator.clipboard?.writeText(t).then(() => { const o = btn.innerHTML; btn.innerHTML = '✓ Copiado'; setTimeout(() => btn.innerHTML = o, 1500); }); }
    $('sd-copy').addEventListener('click', (e) => copy(summary(), e.currentTarget));
    $('sd-detail').addEventListener('click', () => { document.getElementById('como-funciona')?.scrollIntoView({ behavior: 'smooth' }); });
    const s2 = $('sd-share2'); if (s2) s2.addEventListener('click', (e) => copy(shareUrl(), e.currentTarget));

    const q = new URLSearchParams(location.search);
    if (q.get('salario')) $('sd-salario').value = fmtTh(q.get('salario'));
    if (q.get('periodo')) $('sd-periodo').value = q.get('periodo');
    if (q.get('anios')) $('sd-anios').value = q.get('anios');
    render();
  })();
</script>

