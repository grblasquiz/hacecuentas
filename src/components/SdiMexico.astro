---
// Flagship redesign de la calc "salario diario integrado (SDI)" — México (mockup Martin).
// Números del motor real (src/lib/formulas/salario-diario-integrado-sdi-mexico.ts):
// factor = (365 + aguinaldo + vacaciones × prima) ÷ 365 (LFT 76/80/87), SDI = salario
// diario × factor, y SBC topado a 25 UMA (LSS Art. 28). Domain "data" (esmeralda) por
// el mockup, no por la categoría (finanzas→money).
import '../styles/calc-flagship.css';
import { md } from '../lib/markdown';
import { MEXICO_2026, factorIntegracion } from '../lib/data/mexico-2026';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

// fmtMXN (compartido) no fija decimales → "$15,739.5". Acá los montos son
// diarios/quebrados y el mockup los muestra con 2 decimales fijos.
const fmtMXN = (n: number) =>
  '$' + (Math.round(n * 100) / 100).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const { lft, uma, imss, salarioMinimo } = MEXICO_2026;
const F_MENSUAL = salarioMinimo.factorMensual;   // 30.4
const TOPE_SBC = uma.diaria * imss.topeSbcUmas;  // 25 UMA = $2,932.75/día

function diasVacaciones(anios: number): number {
  const a = Math.max(1, Math.floor(anios));
  if (a <= lft.vacacionesPorAnio.length) return lft.vacacionesPorAnio[a - 1];
  return 20 + lft.vacacionesIncrementoQuinquenal * Math.ceil((a - lft.vacacionesPorAnio.length) / 5);
}

function sdiCalc(salario: number, periodo: string, anios: number, aguinaldoDias: number, primaPct: number, extrasMensual: number) {
  const salarioDiario = periodo === 'mensual' ? salario / F_MENSUAL : salario;
  const vac = diasVacaciones(anios);
  const esMinimo = aguinaldoDias === lft.aguinaldoDiasMinimo && primaPct === lft.primaVacacional * 100;
  const factor = esMinimo
    ? factorIntegracion(anios)
    : Math.round(((365 + aguinaldoDias + vac * (primaPct / 100)) / 365) * 10000) / 10000;
  const aguinaldoDiario = (salarioDiario * aguinaldoDias) / 365;
  const primaVacDiaria = (salarioDiario * vac * (primaPct / 100)) / 365;
  const extrasDiario = extrasMensual / F_MENSUAL;
  const sdi = salarioDiario * factor + extrasDiario;
  const sbc = Math.min(sdi, TOPE_SBC);
  return {
    salarioDiario, vac, factor, aguinaldoDiario, primaVacDiaria, extrasDiario,
    sdi, sbc, topado: sdi > TOPE_SBC, sbcMensual: sbc * F_MENSUAL,
    integrado: sdi - salarioDiario, diasIntegrados: 365 + aguinaldoDias + vac * (primaPct / 100),
  };
}

const INIT = { salario: 15000, periodo: 'mensual', anios: 1, aguinaldo: 15, prima: 25, extras: 0 };
const init = sdiCalc(INIT.salario, INIT.periodo, INIT.anios, INIT.aguinaldo, INIT.prima, INIT.extras);

// Tabla de factores por antigüedad (prestaciones mínimas de ley)
const ANTIG = [
  { l: '1 año', a: 1 }, { l: '2 años', a: 2 }, { l: '3 años', a: 3 }, { l: '4 años', a: 4 },
  { l: '5 años', a: 5 }, { l: '6 a 10 años', a: 6 }, { l: '11 a 15 años', a: 11 }, { l: '16 a 20 años', a: 16 },
].map((x) => {
  const v = diasVacaciones(x.a);
  return { ...x, vac: v, dias: 365 + lft.aguinaldoDiasMinimo + v * lft.primaVacacional, factor: factorIntegracion(x.a) };
});

const faq = calc.faq || [];
const explanationHtml = calc.explanation ? md(calc.explanation) : '';
const f4 = (n: number) => n.toFixed(4);
---

<div
  class="cf-page sd"
  data-domain="data"
  data-fmensual={F_MENSUAL}
  data-tope={TOPE_SBC}
  data-aguimin={lft.aguinaldoDiasMinimo}
  data-primamin={lft.primaVacacional * 100}
  data-vac={JSON.stringify(lft.vacacionesPorAnio)}
  data-vacinc={lft.vacacionesIncrementoQuinquenal}
>
  <nav class="cf-crumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/mx/">Inicio</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li><a href="/mx/calculadoras">México</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li aria-current="page">Salario diario integrado</li>
    </ol>
  </nav>

  <header class="cf-hero">
    <div class="cf-hero__main">
      <p class="cf-kicker"><span aria-hidden="true">🇲🇽</span> México · IMSS 2026</p>
      <h1 class="cf-h1">Calculadora de <span class="cf-yr">salario diario integrado</span></h1>
      <p class="cf-sub">Calculá tu SDI y salario base de cotización con aguinaldo, vacaciones, prima vacacional y prestaciones fijas.</p>
      <ul class="cf-pills">
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> LFT 2026</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Factor de integración</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Tope de 25 UMA</li>
      </ul>
    </div>
    <div class="cf-hero__deco" aria-hidden="true">
      <div class="sd-deco-wrap">
        <div class="cf-deco-card">
          <div class="cf-deco-card__label">SDI ejemplo</div>
          <div class="cf-deco-card__value" id="sd-deco-val">{fmtMXN(init.sdi)}</div>
          <div class="cf-deco-card__note">por día · salario mensual {fmtMXN(INIT.salario)}</div>
        </div>
        <span class="cf-deco-badge sd-badge">IMSS</span>
      </div>
      <div class="sd-float">
        <span class="sd-float__k">Factor de integración</span>
        <strong class="sd-float__v" id="sd-deco-factor">{f4(init.factor)}</strong>
        <span class="sd-float__n">primer año · prestaciones mínimas</span>
      </div>
    </div>
  </header>

  <section class="cf-card" id="calc">
    <div class="cf-panel">
      <div class="cf-panel__head">
        <div>
          <p class="cf-panel__eyebrow">Datos laborales</p>
          <h2 class="cf-panel__title">Ingresá tu salario y prestaciones</h2>
        </div>
        <span class="cf-panel__priv"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Cálculo privado</span>
      </div>

      <div class="cf-grid2">
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="sd-salario">Salario</label></div>
          <div class="sd-money"><span class="sd-money__sign">$</span><input class="cf-input cf-input--money" type="text" inputmode="numeric" id="sd-salario" value={INIT.salario.toLocaleString('es-MX')} /></div>
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="sd-periodo">Periodicidad</label></div>
          <select class="cf-input" id="sd-periodo">
            <option value="mensual" selected>Mensual</option>
            <option value="diario">Diario</option>
          </select>
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="sd-anios">Años de antigüedad</label></div>
          <input class="cf-input" type="number" min="1" max="50" step="1" id="sd-anios" value={INIT.anios} />
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="sd-agui">Días de aguinaldo</label></div>
          <input class="cf-input" type="number" min="15" max="90" step="1" id="sd-agui" value={INIT.aguinaldo} />
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="sd-prima">Prima vacacional</label></div>
          <input class="cf-input" type="number" min="25" max="100" step="1" id="sd-prima" value={INIT.prima} />
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="sd-extras">Prestaciones fijas</label><span class="cf-hint">al mes</span></div>
          <div class="sd-money"><span class="sd-money__sign">$</span><input class="cf-input" type="text" inputmode="numeric" id="sd-extras" value="0" /></div>
        </div>
      </div>
      <p class="cf-help" style="margin-bottom:1rem">Mínimos de ley: aguinaldo 15 días (Art. 87) y prima vacacional 25% (Art. 80). Si tu empresa da más, subilo.</p>

      <button class="cf-primary" id="sd-calc-btn" type="button">Calcular mi SDI <span aria-hidden="true">→</span></button>
    </div>

    <div class="cf-result" id="sd-result">
      <p class="cf-result__eyebrow">Tu salario diario integrado</p>
      <div class="cf-result__big" id="sd-big">{fmtMXN(init.sdi)}</div>
      <p class="cf-result__sub" id="sd-sub">por día · SBC mensual {fmtMXN(init.sbcMensual)}</p>
      <div class="cf-tiles cf-tiles--2">
        <div class="cf-tile"><div class="cf-tile__value" id="sd-t-factor">{f4(init.factor)}</div><div class="cf-tile__label">Factor · prestaciones incluidas</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="sd-t-sbc">{fmtMXN(init.sbcMensual)}</div><div class="cf-tile__label">SBC mensual · referencia IMSS</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="sd-t-diario">{fmtMXN(init.salarioDiario)}</div><div class="cf-tile__label" id="sd-t-diario-lbl">Salario diario · {fmtMXN(INIT.salario)} ÷ {F_MENSUAL}</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="sd-t-vac">{init.vac} días</div><div class="cf-tile__label">Vacaciones · LFT Art. 76</div></div>
      </div>
      <div class="cf-result__formula" id="sd-formula">({365} + {INIT.aguinaldo} + {init.vac} × {INIT.prima}%) ÷ 365 = {f4(init.factor)} · {fmtMXN(init.salarioDiario)} × {f4(init.factor)} = {fmtMXN(init.sdi)}</div>
      <p class="cf-result__sub sd-topado" id="sd-topado" hidden>⚠️ Tu SDI supera el tope legal de 25 UMA ({fmtMXN(TOPE_SBC)}/día): el IMSS te registra con ese SBC, no con tu salario real.</p>
      <div class="cf-result__actions cf-result__actions--2">
        <button class="cf-rbtn" type="button" id="sd-copy"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copiar resultado</button>
        <button class="cf-rbtn" type="button" id="sd-detail"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg> Ver desglose</button>
      </div>
    </div>
  </section>

  <div class="cf-quick">
    <span class="cf-quick__ico" aria-hidden="true">⚡</span>
    <p class="cf-quick__txt"><strong>Respuesta rápida.</strong> Con {fmtMXN(INIT.salario)} mensuales y prestaciones mínimas del primer año, tu SDI es <strong>{fmtMXN(init.sdi)}</strong> diarios.</p>
    <span class="cf-formula">factor {f4(init.factor)}</span>
  </div>

  <!-- Cómo se obtiene -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Cálculo paso a paso</p>
        <h2 class="cf-section__title">Cómo se obtiene el SDI</h2>
      </div>
      <p class="cf-section__lead">El salario diario se multiplica por un factor que incorpora las prestaciones anuales fijas.</p>
    </div>
    <div class="cf-steps">
      <div class="cf-step">
        <div class="cf-step__num">1</div>
        <p class="cf-step__title">Convertí a salario diario</p>
        <p class="cf-step__desc">Para un sueldo mensual se divide entre 30.4, el factor que usa el IMSS.</p>
        <p class="sd-chipcalc">{fmtMXN(INIT.salario)} ÷ {F_MENSUAL} = {fmtMXN(init.salarioDiario)}</p>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">2</div>
        <p class="cf-step__title">Calculá el factor</p>
        <p class="cf-step__desc">Sumá aguinaldo y prima sobre tus días de vacaciones, y dividí entre 365.</p>
        <p class="sd-chipcalc">{init.diasIntegrados} ÷ 365 = {f4(init.factor)}</p>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">3</div>
        <p class="cf-step__title">Obtené el SDI</p>
        <p class="cf-step__desc">Multiplicá el salario diario por el factor de integración aplicable.</p>
        <p class="sd-chipcalc">{fmtMXN(init.salarioDiario)} × {f4(init.factor)} = {fmtMXN(init.sdi)}</p>
      </div>
    </div>
  </section>

  <!-- Qué integra el factor -->
  <section class="cf-section">
    <div class="sd-2col">
      <div class="sd-hl">
        <p class="cf-side-eyebrow">Qué integra el factor</p>
        <p class="sd-hl__title">Tu sueldo vale más que el pago base</p>
        <p class="sd-hl__desc">El SDI distribuye día a día el valor proporcional de aguinaldo, vacaciones y prima vacacional.</p>
        <div class="sd-hl__big">+{fmtMXN(init.integrado)} diarios</div>
        <p class="sd-hl__desc">por prestaciones del ejemplo</p>
      </div>
      <div class="cf-breakdown">
        <div class="cf-brow">
          <span class="cf-brow__lbl">Salario diario base</span>
          <span class="cf-brow__val">{fmtMXN(init.salarioDiario)}</span>
          <span class="cf-brow__bar"><span style={`width:${Math.round(init.salarioDiario / init.sdi * 100)}%`}></span></span>
        </div>
        <div class="cf-brow" style="margin-top:0.8rem">
          <span class="cf-brow__lbl">Aguinaldo (parte proporcional)</span>
          <span class="cf-brow__val">{fmtMXN(init.aguinaldoDiario)}</span>
          <span class="cf-brow__bar"><span style={`width:${Math.max(3, Math.round(init.aguinaldoDiario / init.sdi * 100))}%`}></span></span>
        </div>
        <div class="cf-brow" style="margin-top:0.8rem">
          <span class="cf-brow__lbl">Prima vacacional integrada</span>
          <span class="cf-brow__val">{fmtMXN(init.primaVacDiaria)}</span>
          <span class="cf-brow__bar"><span class="sd-bar--alt" style={`width:${Math.max(2, Math.round(init.primaVacDiaria / init.sdi * 100))}%`}></span></span>
        </div>
        <div class="cf-breakdown__total"><span>Salario diario integrado</span><strong>{fmtMXN(init.sdi)}</strong></div>
      </div>
    </div>
  </section>

  <!-- Conceptos clave -->
  <section class="cf-section">
    <p class="cf-eyebrow">Conceptos clave</p>
    <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Salario diario, SDI y SBC</h2>
    <div class="cf-cards cf-cards--3">
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">📄</span>
        <p class="cf-minicard__title">Salario diario</p>
        <p class="cf-minicard__desc">Lo que te pagan por día de trabajo, sin prestaciones integradas.</p>
        <div class="cf-minicard__big" style="margin-top:0.6rem">{fmtMXN(init.salarioDiario)}</div>
      </div>
      <div class="cf-minicard cf-minicard--dark">
        <span class="cf-minicard__ico" aria-hidden="true">✦</span>
        <p class="cf-minicard__title">SDI</p>
        <p class="cf-minicard__desc">Incluye la parte proporcional de aguinaldo, vacaciones y prima.</p>
        <div class="cf-minicard__big" style="margin-top:0.6rem">{fmtMXN(init.sdi)}</div>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">🏥</span>
        <p class="cf-minicard__title">SBC</p>
        <p class="cf-minicard__desc">El SDI reportado al IMSS, topado a 25 UMA por día.</p>
        <div class="cf-minicard__big" style="margin-top:0.6rem">{fmtMXN(init.sbc)}</div>
      </div>
    </div>
  </section>

  <!-- Factores por antigüedad -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Antigüedad</p>
        <h2 class="cf-section__title">Factores con prestaciones mínimas</h2>
      </div>
      <p class="cf-section__lead">Ejemplo orientativo con 15 días de aguinaldo y 25% de prima vacacional.</p>
    </div>
    <div class="cf-tablewrap">
      <table class="cf-table">
        <thead><tr><th>Antigüedad</th><th>Vacaciones</th><th>Días integrados</th><th>Factor</th></tr></thead>
        <tbody>
          {ANTIG.map((r) => (
            <tr>
              <td>{r.l}</td>
              <td>{r.vac} días</td>
              <td>{r.dias.toFixed(2)}</td>
              <td class="cf-td-em">{f4(r.factor)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Banda: tope de cotización -->
<div class="cf-band cf-band--warm" data-domain="data">
  <div class="cf-band__inner">
    <div class="sd-2col">
      <div class="sd-card">
        <p class="cf-eyebrow">Límite de cotización</p>
        <h2 class="sd-card__title">El SBC no puede superar 25 UMA</h2>
        <p class="cf-side-desc">Aunque el SDI matemático sea mayor, para las cuotas del IMSS el salario base queda limitado al máximo legal vigente (Ley del Seguro Social, Art. 28).</p>
        <div class="cf-callout cf-callout--warn" style="margin-top:1rem">
          <span class="cf-callout__ico" aria-hidden="true">💡</span>
          <p>La UMA se actualiza cada año. Confirmá el valor vigente antes de presentar movimientos afiliatorios.</p>
        </div>
      </div>
      <div class="sd-uma">
        <div class="sd-uma__row">
          <span class="sd-uma__k">UMA diaria 2026</span>
          <strong class="sd-uma__v">{fmtMXN(uma.diaria)}</strong>
          <span class="sd-uma__n">valor de referencia</span>
        </div>
        <div class="sd-uma__sep"></div>
        <div class="sd-uma__row">
          <span class="sd-uma__k">Tope SBC · 25 UMA</span>
          <strong class="sd-uma__v">{fmtMXN(TOPE_SBC)}</strong>
          <span class="sd-uma__n">por día</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="cf-page sd" data-domain="data">
  <!-- Qué integra -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Integración del salario</p>
        <h2 class="cf-section__title">Qué suma y qué puede excluirse</h2>
      </div>
      <p class="cf-section__lead">La Ley del Seguro Social establece reglas específicas para cada concepto (Arts. 27 y 28).</p>
    </div>
    <div class="cf-cmp">
      <div class="cf-cmp__col cf-cmp__col--yes">
        <div class="cf-cmp__head"><span aria-hidden="true">✓</span> Normalmente integra</div>
        <ul class="cf-cmp__list">
          <li>Cuota diaria y prestaciones en efectivo.</li>
          <li>Aguinaldo y prima vacacional.</li>
          <li>Bonos fijos y comisiones habituales.</li>
          <li>Alimentación y habitación con valor determinado.</li>
          <li>Prestaciones fijas adicionales (vales, ayudas).</li>
        </ul>
      </div>
      <div class="cf-cmp__col cf-cmp__col--warn">
        <div class="cf-cmp__head"><span aria-hidden="true">⚠️</span> Puede no integrar</div>
        <ul class="cf-cmp__list">
          <li>Instrumentos de trabajo (herramientas, uniformes).</li>
          <li>Fondo de ahorro dentro de los límites de ley.</li>
          <li>Aportaciones adicionales al retiro por el patrón.</li>
          <li>Horas extra dentro del margen legal.</li>
          <li>Despensa hasta el límite exento previsto.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Para qué sirve -->
  <section class="cf-section">
    <p class="cf-eyebrow">Para qué sirve</p>
    <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">El número que impacta tus prestaciones</h2>
    <div class="cf-cards cf-cards--4">
      <div class="cf-minicard"><span class="cf-minicard__ico" aria-hidden="true">🏥</span><p class="cf-minicard__title">Cuotas IMSS</p><p class="cf-minicard__desc">Define lo que aportan patrón y trabajador cada bimestre.</p></div>
      <div class="cf-minicard"><span class="cf-minicard__ico" aria-hidden="true">🏠</span><p class="cf-minicard__title">INFONAVIT</p><p class="cf-minicard__desc">Es la base del 5% patronal y de tu capacidad de crédito.</p></div>
      <div class="cf-minicard"><span class="cf-minicard__ico" aria-hidden="true">🩺</span><p class="cf-minicard__title">Incapacidades</p><p class="cf-minicard__desc">El subsidio que cobrás se calcula sobre tu SBC registrado.</p></div>
      <div class="cf-minicard"><span class="cf-minicard__ico" aria-hidden="true">📑</span><p class="cf-minicard__title">Liquidaciones</p><p class="cf-minicard__desc">Base de indemnizaciones y prima de antigüedad.</p></div>
    </div>
  </section>

  {faq.length > 0 && (
    <section class="cf-section" id="como-funciona">
      <p class="cf-eyebrow">Preguntas frecuentes</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Lo que más se consulta</h2>
      <div class="cf-faq">
        {faq.map((f: any, i: number) => (
          <details class="cf-faq__item" open={i === 0}>
            <summary class="cf-faq__q"><span>{f.q}</span><svg class="cf-faq__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="cf-faq__a" set:html={md(f.a)} />
          </details>
        ))}
      </div>
    </section>
  )}
</div>

