<script is:inline>
  (function () {
    const root = document.querySelector('.ix');
    if (!root) return;
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(Math.round(n));
    const mill = (n) => '$' + (n / 1e6).toLocaleString('es-AR', { maximumFractionDigits: 1 }) + ' M';
    const pct = (n, base) => base > 0 ? ((n / base) * 100).toFixed(1).replace('.', ',') + '%' : '0%';

    const sueldoEl = $('ix-sueldo'), aniosEl = $('ix-anios'), mesesEl = $('ix-meses'),
      diaEl = $('ix-dia'), mesEl = $('ix-mes'), convEl = $('ix-convenio'), topeEl = $('ix-tope');

    function num(el) { return Number((el.value || '').replace(/\D/g, '')) || 0; }
    function fmtThousands(v) { const n = String(v).replace(/\D/g, ''); return n ? Number(n).toLocaleString('es-AR') : ''; }

    // Réplica EXACTA de src/lib/formulas/indemnizacion.ts
    function indem(sueldo, anios, meses, diaDespido, mesDespido, tope) {
      anios = Math.max(0, anios || 0);
      meses = Math.max(0, Math.min(11, meses || 0));
      diaDespido = Math.max(1, Math.min(31, diaDespido || 15));
      tope = Math.max(0, tope || 0);

      const antiguedadTotalMeses = anios * 12 + meses;
      const aniosComputables = meses > 3 ? anios + 1 : anios;

      let baseArt245 = sueldo, vizzotiAplicado = false;
      if (tope > 0) {
        const minConVizzoti = sueldo * 0.67;
        if (tope < minConVizzoti) { baseArt245 = minConVizzoti; vizzotiAplicado = true; }
        else baseArt245 = tope;
      }
      const antiguedad = baseArt245 * aniosComputables;

      let mesesPreaviso;
      if (antiguedadTotalMeses < 3) mesesPreaviso = 0.5;
      else if (antiguedadTotalMeses <= 60) mesesPreaviso = 1;
      else mesesPreaviso = 2;
      const preaviso = sueldo * mesesPreaviso;
      const sacPreaviso = preaviso / 12;

      const diasFaltantes = Math.max(0, 30 - diaDespido);
      const integracionMes = (sueldo / 30) * diasFaltantes;
      const sacIntegracion = integracionMes / 12;

      const mesEnSemestre = ((mesDespido - 1) % 6) + 1;
      const diasSemestre = Math.min(180, (mesEnSemestre - 1) * 30 + diaDespido);
      const sacProporcional = (sueldo / 2) * (diasSemestre / 180);

      let diasVacAnual;
      if (antiguedadTotalMeses <= 60) diasVacAnual = 14;
      else if (antiguedadTotalMeses <= 120) diasVacAnual = 21;
      else if (antiguedadTotalMeses <= 240) diasVacAnual = 28;
      else diasVacAnual = 35;
      const diasVacProp = (diasVacAnual * Math.min(360, (mesDespido - 1) * 30 + diaDespido)) / 360;
      const vacacionesProporcionales = (sueldo / 25) * diasVacProp;
      const sacVacaciones = vacacionesProporcionales / 12;

      const total = antiguedad + preaviso + sacPreaviso + integracionMes + sacIntegracion +
        sacProporcional + vacacionesProporcionales + sacVacaciones;

      // Mismo orden de redondeo que el motor (cada componente aparte, total sobre el float).
      const rAnt = Math.round(antiguedad);
      const rPre = Math.round(preaviso), rSacPre = Math.round(sacPreaviso);
      const rInt = Math.round(integracionMes), rSacInt = Math.round(sacIntegracion);
      const rSacProp = Math.round(sacProporcional);
      const rVac = Math.round(vacacionesProporcionales), rSacVac = Math.round(sacVacaciones);

      return {
        antiguedad: rAnt, preaviso: rPre, sacPreaviso: rSacPre,
        integracionMes: rInt, sacIntegracion: rSacInt, sacProporcional: rSacProp,
        vacacionesProporcionales: rVac, sacVacaciones: rSacVac,
        total: Math.round(total), aniosComputables, baseArt245: Math.round(baseArt245),
        vizzotiAplicado, mesesPreaviso, diasVacAnual,
        gPreaviso: rPre + rSacPre,
        gIntegracion: rInt + rSacInt,
        gSacVac: rSacProp + rVac + rSacVac,
      };
    }

    function state() {
      const sueldo = num(sueldoEl);
      const anios = Math.max(0, Number(aniosEl.value) || 0);
      const meses = Math.max(0, Math.min(11, Number(mesesEl.value) || 0));
      const dia = Math.max(1, Math.min(31, Number(diaEl.value) || 15));
      const mes = Number(mesEl.value) || 6;
      // El motor prioriza el override manual; si está en 0 usa el tope del CCT elegido.
      const topeManual = num(topeEl);
      const topeConv = Number(convEl.value) || 0;
      const tope = topeManual > 0 ? topeManual : topeConv;
      return { sueldo, anios, meses, dia, mes, tope };
    }

    function render() {
      const s = state();
      const ok = s.sueldo > 0 && (s.anios > 0 || s.meses > 0);
      const r = indem(s.sueldo, s.anios, s.meses, s.dia, s.mes, s.tope);
      resultEl && resultEl.removeAttribute('data-stale');

      if (!ok) {
        $('ix-big').textContent = '—';
        $('ix-sub').textContent = s.sueldo <= 0 ? 'Ingresá el sueldo bruto mensual' : 'Ingresá la antigüedad laboral';
        return;
      }

      $('ix-big').textContent = fmt(r.total);
      $('ix-sub').textContent = r.aniosComputables + (r.aniosComputables === 1 ? ' año computable · base ' : ' años computables · base ') + fmt(r.baseArt245);
      $('ix-t-ant').textContent = fmt(r.antiguedad);
      $('ix-t-pre').textContent = fmt(r.gPreaviso);
      $('ix-t-int').textContent = fmt(r.gIntegracion);
      $('ix-t-sac').textContent = fmt(r.gSacVac);
      $('ix-formula').textContent = fmt(r.baseArt245) + ' × ' + r.aniosComputables + (r.aniosComputables === 1 ? ' año = ' : ' años = ') + fmt(r.antiguedad);

      const vz = $('ix-vizzoti');
      vz.hidden = !r.vizzotiAplicado;
      if (r.vizzotiAplicado) $('ix-vizzoti-base').textContent = fmt(r.baseArt245);

      $('ix-quick').textContent = fmt(r.total);
      $('ix-deco-val').textContent = mill(r.total);
      $('ix-deco-chip').textContent = pct(r.antiguedad, r.total);

      // Datos clave
      $('ix-k-anios').textContent = String(r.aniosComputables);
      $('ix-k-base').textContent = fmt(r.baseArt245);
      $('ix-k-preaviso').textContent = r.mesesPreaviso === 0.5 ? '15 días' : (r.mesesPreaviso === 1 ? '1 mes' : '2 meses');
      $('ix-k-vac').textContent = r.diasVacAnual + ' días';

      // Breakdown
      $('ix-hl-big').textContent = pct(r.antiguedad, r.total);
      $('ix-bd-total').textContent = fmt(r.total);
      $('ix-bd-ant').textContent = fmt(r.antiguedad);
      $('ix-bd-pre').textContent = fmt(r.gPreaviso + r.gIntegracion);
      $('ix-bd-sac').textContent = fmt(r.gSacVac);
      $('ix-bd-ant-bar').style.width = (r.total > 0 ? Math.round(r.antiguedad / r.total * 100) : 0) + '%';
      $('ix-bd-pre-bar').style.width = (r.total > 0 ? Math.round((r.gPreaviso + r.gIntegracion) / r.total * 100) : 0) + '%';
      $('ix-bd-sac-bar').style.width = (r.total > 0 ? Math.round(r.gSacVac / r.total * 100) : 0) + '%';

      // Referencia principal (banda)
      $('ix-ref-big').textContent = fmt(r.baseArt245);
      $('ix-ref-sub').textContent = r.vizzotiAplicado
        ? 'Piso Vizzoti: 67% de tu mejor remuneración mensual'
        : (s.tope > 0 ? 'Tope de convenio aplicado sobre la mejor remuneración' : 'Mejor remuneración mensual, normal y habitual del último año');

      // Chips de los pasos
      $('ix-s1').textContent = fmt(s.sueldo) + ' · ' + s.anios + 'a ' + s.meses + 'm';
      $('ix-s2').textContent = fmt(r.baseArt245) + ' × ' + r.aniosComputables + ' = ' + fmt(r.antiguedad);
      $('ix-s3').textContent = 'Total ' + fmt(r.total);
    }

    const resultEl = $('ix-result');
    const stale = () => { resultEl && resultEl.setAttribute('data-stale', '1'); };
    const onEnter = (e) => { if (e.key === 'Enter') { e.preventDefault(); render(); } };

    sueldoEl.addEventListener('input', () => { sueldoEl.value = fmtThousands(sueldoEl.value); stale(); });
    topeEl.addEventListener('input', () => { topeEl.value = fmtThousands(topeEl.value); stale(); });
    [aniosEl, mesesEl, diaEl].forEach((el) => el.addEventListener('input', stale));
    [mesEl, convEl].forEach((el) => el.addEventListener('change', stale));
    [sueldoEl, topeEl, aniosEl, mesesEl, diaEl].forEach((el) => el.addEventListener('keydown', onEnter));
    $('ix-calc-btn').addEventListener('click', render);
    document.querySelectorAll('.ix [data-ej]').forEach((b) => b.addEventListener('click', () => { sueldoEl.value = fmtThousands(b.getAttribute('data-ej')); stale(); }));

    function summary() {
      const s = state();
      const r = indem(s.sueldo, s.anios, s.meses, s.dia, s.mes, s.tope);
      return `Indemnización por despido sin causa (AR): total bruto ${fmt(r.total)} con mejor sueldo ${fmt(s.sueldo)} y ${s.anios} años ${s.meses} meses de antigüedad (${r.aniosComputables} computables). Antigüedad Art. 245 ${fmt(r.antiguedad)}, preaviso + SAC ${fmt(r.gPreaviso)}, integración + SAC ${fmt(r.gIntegracion)}, SAC prop. + vacaciones ${fmt(r.gSacVac)}. — hacecuentas.com`;
    }
    function shareUrl() {
      const s = state();
      return `${location.origin}${location.pathname}?sueldo=${s.sueldo}&anios=${s.anios}&meses=${s.meses}&dia=${s.dia}&mes=${s.mes}&tope=${num(topeEl)}`;
    }
    function copy(t, btn) { navigator.clipboard?.writeText(t).then(() => { const o = btn.innerHTML; btn.innerHTML = '✓ Copiado'; setTimeout(() => btn.innerHTML = o, 1500); }); }
    $('ix-copy').addEventListener('click', (e) => copy(summary(), e.currentTarget));
    $('ix-detail').addEventListener('click', () => { document.getElementById('como-funciona')?.scrollIntoView({ behavior: 'smooth' }); });
    const s2 = $('ix-share2'); if (s2) s2.addEventListener('click', (e) => copy(shareUrl(), e.currentTarget));

    const q = new URLSearchParams(location.search);
    if (q.get('sueldo')) sueldoEl.value = fmtThousands(q.get('sueldo'));
    if (q.get('anios')) aniosEl.value = q.get('anios');
    if (q.get('meses')) mesesEl.value = q.get('meses');
    if (q.get('dia')) diaEl.value = q.get('dia');
    if (q.get('mes')) mesEl.value = q.get('mes');
    if (q.get('tope')) topeEl.value = fmtThousands(q.get('tope'));
    render();
  })();
</script>

<style>
