---
// Flagship redesign de la calc "indemnización por despido sin causa" (mockup Martin).
// Los números salen del motor real (src/lib/formulas/indemnizacion.ts): Art. 245 LCT
// (mejor remuneración × años computables, fracción > 3 meses suma 1 año), tope de
// convenio con piso Vizzoti (67%), preaviso Art. 231, integración del mes Art. 233,
// SAC proporcional Art. 123 y vacaciones no gozadas Arts. 150/155/156.
// Domain "health" (rojo/crimson) por el mockup, no por la categoría (finanzas→money).
// Header/footer = los globales del sitio.
import '../styles/calc-flagship.css';
import { md } from '../lib/markdown';
import PriorityDecisionCta from './PriorityDecisionCta.astro';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

// ── Réplica EXACTA de src/lib/formulas/indemnizacion.ts ─────────────────────
function indem(sueldo: number, anios: number, meses: number, diaDespido: number, mesDespido: number, tope: number) {
  anios = Math.max(0, anios || 0);
  meses = Math.max(0, Math.min(11, meses || 0));
  diaDespido = Math.max(1, Math.min(31, diaDespido || 15));
  tope = Math.max(0, tope || 0);

  const antiguedadTotalMeses = anios * 12 + meses;
  const aniosComputables = meses > 3 ? anios + 1 : anios;

  // Art. 245 + fallo Vizzoti: si el tope reduce la base más del 33%, se usa el 67%.
  let baseArt245 = sueldo;
  let vizzotiAplicado = false;
  if (tope > 0) {
    const minConVizzoti = sueldo * 0.67;
    if (tope < minConVizzoti) { baseArt245 = minConVizzoti; vizzotiAplicado = true; }
    else baseArt245 = tope;
  }
  const antiguedad = baseArt245 * aniosComputables;

  // Preaviso Art. 231: 15 días (<3m) / 1 mes (3m-5a) / 2 meses (>5a)
  let mesesPreaviso: number;
  if (antiguedadTotalMeses < 3) mesesPreaviso = 0.5;
  else if (antiguedadTotalMeses <= 60) mesesPreaviso = 1;
  else mesesPreaviso = 2;
  const preaviso = sueldo * mesesPreaviso;
  const sacPreaviso = preaviso / 12;

  // Integración mes de despido Art. 233 (meses de 30 días)
  const diasFaltantes = Math.max(0, 30 - diaDespido);
  const integracionMes = (sueldo / 30) * diasFaltantes;
  const sacIntegracion = integracionMes / 12;

  // SAC proporcional del semestre en curso Art. 123
  const mesEnSemestre = ((mesDespido - 1) % 6) + 1;
  const diasSemestre = Math.min(180, (mesEnSemestre - 1) * 30 + diaDespido);
  const sacProporcional = (sueldo / 2) * (diasSemestre / 180);

  // Vacaciones no gozadas proporcionales (Art. 150 días/año, Art. 155 jornal ÷25)
  let diasVacAnual: number;
  if (antiguedadTotalMeses <= 60) diasVacAnual = 14;
  else if (antiguedadTotalMeses <= 120) diasVacAnual = 21;
  else if (antiguedadTotalMeses <= 240) diasVacAnual = 28;
  else diasVacAnual = 35;
  const diasVacProp = (diasVacAnual * Math.min(360, (mesDespido - 1) * 30 + diaDespido)) / 360;
  const vacacionesProporcionales = (sueldo / 25) * diasVacProp;
  const sacVacaciones = vacacionesProporcionales / 12;

  const total = antiguedad + preaviso + sacPreaviso + integracionMes + sacIntegracion +
    sacProporcional + vacacionesProporcionales + sacVacaciones;

  // El motor redondea CADA componente por separado (y el total sobre el float).
  // Replicamos ese orden para que lo que mostramos sean literalmente sus salidas y
  // los tiles reconcilien con el total (agrupar floats desviaba $1).
  const rAnt = Math.round(antiguedad);
  const rPre = Math.round(preaviso), rSacPre = Math.round(sacPreaviso);
  const rInt = Math.round(integracionMes), rSacInt = Math.round(sacIntegracion);
  const rSacProp = Math.round(sacProporcional);
  const rVac = Math.round(vacacionesProporcionales), rSacVac = Math.round(sacVacaciones);

  return {
    antiguedad: rAnt, preaviso: rPre, sacPreaviso: rSacPre,
    integracionMes: rInt, sacIntegracion: rSacInt, sacProporcional: rSacProp,
    vacacionesProporcionales: rVac, sacVacaciones: rSacVac,
    total: Math.round(total), aniosComputables, baseArt245: Math.round(baseArt245),
    vizzotiAplicado, mesesPreaviso, diasVacAnual,
    // agrupaciones para los tiles / barras (sobre los componentes ya redondeados)
    gPreaviso: rPre + rSacPre,
    gIntegracion: rInt + rSacInt,
    gSacVac: rSacProp + rVac + rSacVac,
  };
}

const fmtAr = (n: number) => new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(Math.round(n));
const pct = (n: number, base: number) => base > 0 ? ((n / base) * 100).toFixed(1).replace('.', ',') + '%' : '0%';
const millones = (n: number) => '$' + (n / 1_000_000).toLocaleString('es-AR', { maximumFractionDigits: 1 }) + ' M';

// Caso cargado por defecto en el panel
const INIT = { sueldo: 2_000_000, anios: 5, meses: 4, dia: 15, mes: 6, tope: 0 };
const init = indem(INIT.sueldo, INIT.anios, INIT.meses, INIT.dia, INIT.mes, INIT.tope);

// Tabla de referencia: mismo sueldo/fecha, distinta antigüedad (computada con la fórmula)
const refRows = [
  { label: '1 año', a: 1, m: 0 },
  { label: '3 años', a: 3, m: 0 },
  { label: '5 años', a: 5, m: 0 },
  { label: '5 años y 4 meses', a: 5, m: 4 },
  { label: '10 años', a: 10, m: 0 },
  { label: '20 años', a: 20, m: 0 },
].map((r) => ({ ...r, ...indem(INIT.sueldo, r.a, r.m, INIT.dia, INIT.mes, INIT.tope) }));

const MESES_LBL = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const convenioOpts = (calc.fields || []).find((f: any) => f.id === 'convenio')?.options || [];

const faq = calc.faq || [];
const sources = (calc.sources || []).slice(0, 3);
const explanationHtml = calc.explanation ? md(calc.explanation) : '';
---

<div class="cf-page ix" data-domain="health">
  <nav class="cf-crumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Inicio</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li><a href="/sueldos-y-trabajo">Sueldos y trabajo</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li aria-current="page">Indemnización por despido</li>
    </ol>
  </nav>

  <header class="cf-hero">
    <div class="cf-hero__main">
      <p class="cf-kicker"><span aria-hidden="true">⚖️</span> Argentina · Despido sin causa · 2026</p>
      <h1 class="cf-h1">Calculadora de <span class="cf-yr">indemnización por despido</span></h1>
      <p class="cf-sub">Estimá cuánto te corresponde cobrar si te despiden sin causa: antigüedad, preaviso, integración del mes, SAC y vacaciones no gozadas.</p>
      <ul class="cf-pills">
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Datos verificados 2026</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Cálculo privado</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Resultado explicado</li>
      </ul>
    </div>
    <div class="cf-hero__deco" aria-hidden="true">
      <span class="cf-deco-float"><span aria-hidden="true">📋</span> Liquidación final</span>
      <div class="ix-deco-wrap">
        <div class="cf-deco-card">
          <div class="cf-deco-card__label">Dato principal</div>
          <div class="cf-deco-card__value" id="ix-deco-val">{millones(init.total)}</div>
          <div class="cf-deco-card__note">Total bruto estimado</div>
        </div>
        <span class="cf-deco-badge ix-badge" aria-hidden="true">⚖️</span>
      </div>
      <div class="cf-deco-sub"><strong>Antigüedad (Art. 245)</strong> <span class="cf-deco-chip" id="ix-deco-chip">{pct(init.antiguedad, init.total)}</span></div>
    </div>
  </header>

  <section class="cf-card" id="calc">
    <div class="cf-panel">
      <div class="cf-panel__head">
        <div>
          <p class="cf-panel__eyebrow">Calculadora</p>
          <h2 class="cf-panel__title">Contanos tu caso</h2>
        </div>
        <span class="cf-panel__priv"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> No guardamos tus datos</span>
      </div>

      <div class="cf-field">
        <div class="cf-field__row"><label class="cf-label" for="ix-sueldo">Mejor sueldo bruto del último año</label><span class="cf-hint">Normal y habitual</span></div>
        <div class="ix-money"><span class="ix-money__sign">$</span><input class="cf-input cf-input--money" type="text" inputmode="numeric" id="ix-sueldo" value="2.000.000" /></div>
        <p class="cf-help">La mejor remuneración mensual, normal y habitual. No incluyas SAC, vacaciones ni bonos que no sean de pago mensual (Art. 245 LCT, texto s/ Ley 27.802).</p>
      </div>

      <div class="cf-grid2">
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="ix-anios">Años de antigüedad</label></div>
          <input class="cf-input" type="number" inputmode="numeric" id="ix-anios" value="5" min="0" max="50" step="1" />
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="ix-meses">Meses sueltos</label><span class="cf-hint">0 a 11</span></div>
          <input class="cf-input" type="number" inputmode="numeric" id="ix-meses" value="4" min="0" max="11" step="1" />
        </div>
      </div>
      <p class="cf-help" style="margin:-0.6rem 0 1.1rem">Una fracción mayor a 3 meses cuenta como un año entero (Art. 245 LCT).</p>

      <div class="cf-grid2">
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="ix-dia">Día del despido</label></div>
          <input class="cf-input" type="number" inputmode="numeric" id="ix-dia" value="15" min="1" max="31" step="1" />
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="ix-mes">Mes del despido</label></div>
          <select class="cf-input" id="ix-mes">
            {MESES_LBL.map((m, i) => (<option value={String(i + 1)} selected={i + 1 === INIT.mes}>{m}</option>))}
          </select>
        </div>
      </div>
      <p class="cf-help" style="margin:-0.6rem 0 1.1rem">Definen la integración del mes, el SAC proporcional y las vacaciones del año en curso.</p>

      <div class="cf-field">
        <div class="cf-field__row"><label class="cf-label" for="ix-convenio">Convenio (CCT)</label><span class="cf-hint">Tope Art. 245</span></div>
        <select class="cf-input" id="ix-convenio">
          {convenioOpts.map((o: any) => (<option value={o.value} selected={String(o.value) === '0'}>{o.label}</option>))}
        </select>
        <p class="cf-help">Topes de referencia aproximados 2026. El vigente lo fija la última Resolución de tu CCT: verificalo en argentina.gob.ar/trabajo/topes.</p>
      </div>

      <div class="cf-field">
        <div class="cf-field__row"><label class="cf-label" for="ix-tope">Tope exacto (override)</label><span class="cf-hint">Opcional</span></div>
        <div class="ix-money"><span class="ix-money__sign">$</span><input class="cf-input cf-input--money" type="text" inputmode="numeric" id="ix-tope" value="0" /></div>
        <p class="cf-help">Dejá en 0 para no aplicar tope. Si el tope reduce tu base más del 33%, igual se aplica Vizzoti (67% de tu sueldo real).</p>
      </div>

      <button class="cf-primary" id="ix-calc-btn" type="button">Calcular resultado <span aria-hidden="true">→</span></button>

      <div class="cf-shortcuts">
        <span class="cf-shortcuts__lbl">Ejemplos:</span>
        <button class="cf-sc" type="button" data-ej="1000000">$1 M</button>
        <button class="cf-sc" type="button" data-ej="1500000">$1,5 M</button>
        <button class="cf-sc" type="button" data-ej="2500000">$2,5 M</button>
        <button class="cf-sc" type="button" data-ej="3500000">$3,5 M</button>
      </div>
    </div>

    <div class="cf-result" id="ix-result">
      <p class="cf-result__eyebrow">Resultado estimado</p>
      <div class="cf-result__big" id="ix-big">{fmtAr(init.total)}</div>
      <div class="cf-result__biglabel">Indemnización total bruta</div>
      <p class="cf-result__sub" id="ix-sub">{init.aniosComputables} años computables · base {fmtAr(init.baseArt245)}</p>
      <p class="cf-stale-hint">Apretá <strong>Calcular</strong> para actualizar el resultado.</p>
      <div class="cf-tiles cf-tiles--2">
        <div class="cf-tile"><div class="cf-tile__value" id="ix-t-ant">{fmtAr(init.antiguedad)}</div><div class="cf-tile__label">Antigüedad · Art. 245</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="ix-t-pre">{fmtAr(init.gPreaviso)}</div><div class="cf-tile__label">Preaviso + SAC</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="ix-t-int">{fmtAr(init.gIntegracion)}</div><div class="cf-tile__label">Integración + SAC</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="ix-t-sac">{fmtAr(init.gSacVac)}</div><div class="cf-tile__label">SAC prop. + vacaciones</div></div>
      </div>
      <p class="cf-result__sub ix-vizzoti" id="ix-vizzoti" hidden>⚖️ El tope de convenio reducía la base más del 33%: por el fallo <strong>Vizzoti</strong> se tomó el 67% de tu sueldo (<span id="ix-vizzoti-base"></span>).</p>
      <div class="cf-result__formula" id="ix-formula">{fmtAr(init.baseArt245)} × {init.aniosComputables} años = {fmtAr(init.antiguedad)}</div>
      <div class="cf-result__actions cf-result__actions--2">
        <button class="cf-rbtn" type="button" id="ix-copy"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copiar resultado</button>
        <button class="cf-rbtn" type="button" id="ix-detail"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg> Ver desglose</button>
      </div>
    </div>
  </section>

  <div class="cf-quick">
    <span class="cf-quick__ico" aria-hidden="true">⚡</span>
    <p class="cf-quick__txt"><strong>Respuesta rápida.</strong> Con un mejor sueldo de <strong>{fmtAr(INIT.sueldo)}</strong> y {INIT.anios} años y {INIT.meses} meses de antigüedad, la indemnización total ronda <strong id="ix-quick">{fmtAr(init.total)}</strong> brutos, de los cuales {fmtAr(init.antiguedad)} son de antigüedad.</p>
    <span class="cf-formula">mejor sueldo × años computables</span>
  </div>

  <PriorityDecisionCta
    roomSlug="me-despidieron"
    title="Convertí la indemnización en meses de tranquilidad"
    description="Cruzá la liquidación con tus gastos, ahorros y deudas para saber cuánto tiempo real podés sostenerte y qué hacer primero."
    sourcePage="calculadora-indemnizacion-despido"
    label="Calcular cuánto tiempo podés sostenerte →"
  />

  <!-- 5 · Datos clave -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Datos clave</p>
        <h2 class="cf-section__title">Todo lo importante, de un vistazo</h2>
      </div>
      <p class="cf-section__lead">Valores de referencia del caso cargado y reglas principales para interpretar el resultado.</p>
    </div>
    <div class="cf-cards cf-cards--4">
      <div class="cf-minicard cf-minicard--dark">
        <span class="cf-minicard__ico" aria-hidden="true">📆</span>
        <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Años computables</p>
        <div class="cf-minicard__big" id="ix-k-anios">{init.aniosComputables}</div>
        <p class="cf-minicard__desc" style="margin-top:0.3rem">La fracción mayor a 3 meses suma un año entero.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">💼</span>
        <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Base del Art. 245</p>
        <div class="cf-minicard__big" id="ix-k-base">{fmtAr(init.baseArt245)}</div>
        <p class="cf-minicard__desc" style="margin-top:0.3rem">Mejor remuneración mensual, con tope y piso Vizzoti si aplican.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">📨</span>
        <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Preaviso</p>
        <div class="cf-minicard__big" id="ix-k-preaviso">2 meses</div>
        <p class="cf-minicard__desc" style="margin-top:0.3rem">15 días hasta 3 meses, 1 mes hasta 5 años, 2 meses después.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">🏖️</span>
        <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Vacaciones por año</p>
        <div class="cf-minicard__big" id="ix-k-vac">21 días</div>
        <p class="cf-minicard__desc" style="margin-top:0.3rem">14 / 21 / 28 / 35 días según antigüedad (Art. 150 LCT).</p>
      </div>
    </div>
  </section>

  <!-- 6 · Cómo leer el resultado -->
  <section class="cf-section">
    <div class="ix-2col">
      <div class="ix-hl">
        <p class="cf-side-eyebrow ix-hl__eyebrow">Cómo leer el resultado</p>
        <p class="ix-hl__title">La antigüedad es el componente que manda</p>
        <p class="ix-hl__desc">El Art. 245 concentra la mayor parte de la liquidación y crece un sueldo entero por cada año trabajado. Los demás rubros dependen de la fecha del despido, no de la antigüedad.</p>
        <div class="ix-hl__big" id="ix-hl-big">{pct(init.antiguedad, init.total)}</div>
        <p class="ix-hl__note">del total corresponde a la antigüedad</p>
      </div>
      <div class="cf-breakdown">
        <div class="cf-breakdown__big" id="ix-bd-total">{fmtAr(init.total)}</div>
        <div class="cf-brow">
          <span class="cf-brow__lbl">Antigüedad (Art. 245)</span>
          <span class="cf-brow__val" id="ix-bd-ant">{fmtAr(init.antiguedad)}</span>
          <span class="cf-brow__bar"><span id="ix-bd-ant-bar" style={`width:${Math.round(init.antiguedad / init.total * 100)}%`}></span></span>
        </div>
        <div class="cf-brow" style="margin-top:1rem">
          <span class="cf-brow__lbl">Preaviso + integración del mes</span>
          <span class="cf-brow__val" id="ix-bd-pre">{fmtAr(init.gPreaviso + init.gIntegracion)}</span>
          <span class="cf-brow__bar"><span id="ix-bd-pre-bar" style={`width:${Math.round((init.gPreaviso + init.gIntegracion) / init.total * 100)}%`}></span></span>
        </div>
        <div class="cf-brow" style="margin-top:1rem">
          <span class="cf-brow__lbl">SAC proporcional + vacaciones</span>
          <span class="cf-brow__val" id="ix-bd-sac">{fmtAr(init.gSacVac)}</span>
          <span class="cf-brow__bar"><span id="ix-bd-sac-bar" style={`width:${Math.round(init.gSacVac / init.total * 100)}%`}></span></span>
        </div>
        <div class="cf-callout cf-callout--warn" style="margin-top:1.25rem">
          <span class="cf-callout__ico" aria-hidden="true">⚖️</span>
          <p><strong>El tope de convenio puede recortar la base.</strong> Si el tope del CCT reduce tu mejor sueldo más del 33%, el fallo Vizzoti fija un piso del 67% de tu remuneración real.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7 · Paso a paso -->
  <section class="cf-section">
    <p class="cf-eyebrow">Paso a paso</p>
    <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">De tus datos al resultado</h2>
    <div class="cf-steps">
      <div class="cf-step">
        <div class="cf-step__num">1</div>
        <p class="cf-step__title">Ingresá tus datos</p>
        <p class="cf-step__desc">Tu mejor sueldo bruto normal y habitual del último año, la antigüedad y la fecha exacta del despido.</p>
        <p class="ix-chip" id="ix-s1">{fmtAr(INIT.sueldo)} · {INIT.anios}a {INIT.meses}m</p>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">2</div>
        <p class="cf-step__title">Aplicamos la fórmula</p>
        <p class="cf-step__desc">Base del Art. 245 × años computables, más preaviso, integración del mes, SAC proporcional y vacaciones.</p>
        <p class="ix-chip" id="ix-s2">{fmtAr(init.baseArt245)} × {init.aniosComputables} = {fmtAr(init.antiguedad)}</p>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">3</div>
        <p class="cf-step__title">Revisá el resultado</p>
        <p class="cf-step__desc">Es un total bruto. Del preaviso y la integración se descuentan aportes; la indemnización del Art. 245 está exenta.</p>
        <p class="ix-chip" id="ix-s3">Total {fmtAr(init.total)}</p>
      </div>
    </div>
  </section>

  <!-- 8 · Referencias -->
  <section class="cf-section">
    <div class="cf-section__head">
