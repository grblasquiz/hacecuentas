---
import type { HubData } from '../lib/hubs/types';
interface Props { data: HubData }
const { data } = Astro.props;

const stages = [
  {
    id: 'ocurrio', number: '1', label: 'Ocurrió el accidente', title: 'Lo que tenés que hacer hoy',
    summary: 'Denunciá el accidente cuanto antes y armá una carpeta con todo lo que pruebe qué pasó.',
    tasks: [
      { icon: '◌', title: 'Avisá y dejá constancia', copy: 'Informá a tu empleador lo antes posible. Dejá registrado cómo, cuándo y dónde ocurrió el accidente.' },
      { icon: '#', title: 'Pedí el número de siniestro', copy: 'Tu empleador debe emitir la denuncia en la ART y darte el número de siniestro.' },
      { icon: '▱', title: 'Guardá estudios y certificados', copy: 'Conservá todos los estudios, indicaciones y certificados médicos. Sacales foto o guardalos en PDF.' },
    ],
    docs: ['Denuncia del empleador a la ART', 'Número de siniestro', 'Certificado / informe médico', 'Estudios e indicaciones', 'Alta médica o evolución'],
    primary: { label: 'Ver cómo denunciarlo', href: 'https://www.argentina.gob.ar/srt/trabajador' },
    secondary: { label: 'Encontrar mi ART', href: 'https://www.argentina.gob.ar/srt/comisionesmedicas/recursos-trabajador' },
  },
  {
    id: 'tratamiento', number: '2', label: 'Estoy en tratamiento', title: 'Cuidá el tratamiento y controlá la prestación',
    summary: 'La ART debe brindar asistencia y cubrir la prestación dineraria durante la incapacidad temporaria.',
    tasks: [
      { icon: '+', title: 'Cumplí las indicaciones médicas', copy: 'Asistí a los turnos y avisá si no podés concurrir. Pedí copia de cada indicación.' },
      { icon: '$', title: 'Controlá lo que cobrás', copy: 'Compará la prestación con tu remuneración habitual y guardá todos los recibos.' },
      { icon: '!', title: 'Reclamá una prestación insuficiente', copy: 'Si falta tratamiento, traslado o pago, documentá el problema y usá el canal oficial.' },
    ],
    docs: ['Número de siniestro', 'Turnos y prestaciones', 'Recibos de sueldo', 'Comprobantes de traslado', 'Certificados médicos'],
    primary: { label: 'Ver pagos de la ART', href: 'https://www.argentina.gob.ar/srt/art/pagos-art' },
    secondary: { label: 'Consultar o reclamar', href: 'https://www.argentina.gob.ar/srt/trabajador' },
  },
  {
    id: 'alta', number: '3', label: 'Me dieron el alta', title: 'Revisá el alta y registrá cualquier secuela',
    summary: 'Si todavía tenés síntomas o limitaciones, no dejes pasar la constancia: el alta abre la etapa de evaluación.',
    tasks: [
      { icon: '✓', title: 'Leé el alta completa', copy: 'Verificá diagnóstico, fecha, tratamiento recibido y si menciona secuelas.' },
      { icon: '↗', title: 'Actuá si no estás de acuerdo', copy: 'Podés iniciar una divergencia en el alta ante la Comisión Médica.' },
      { icon: '%', title: 'Pedí evaluación de secuelas', copy: 'Si quedaron limitaciones, corresponde evaluar el porcentaje de incapacidad.' },
    ],
    docs: ['Alta médica', 'Historia clínica', 'Estudios anteriores y actuales', 'Recibos de sueldo', 'Descripción de secuelas'],
    primary: { label: 'Ver trámites de Comisión Médica', href: 'https://www.argentina.gob.ar/srt/comisionesmedicas/tramites' },
    secondary: { label: 'Estimar una incapacidad', href: '/trabajo/indemnizacion-por-despido' },
  },
  {
    id: 'rechazo', number: '4', label: 'La ART rechazó el caso', title: 'Documentá el rechazo y elegí el reclamo correcto',
    summary: 'La vía cambia según se haya rechazado el accidente, el tratamiento, el alta o la incapacidad.',
    tasks: [
      { icon: '✉', title: 'Guardá la carta de rechazo', copy: 'Necesitás la fecha, el motivo y la aseguradora que tomó la decisión.' },
      { icon: '≡', title: 'Ordená la prueba médica', copy: 'Reuní certificados, estudios, testigos y la constancia de denuncia.' },
      { icon: '→', title: 'Iniciá el trámite específico', copy: 'La SRT separa rechazo de contingencia, divergencia en alta y divergencia en prestaciones.' },
    ],
    docs: ['Carta o constancia de rechazo', 'Denuncia del accidente', 'Historia clínica', 'Estudios médicos', 'Datos del empleador'],
    primary: { label: 'Elegir el trámite en la SRT', href: 'https://www.argentina.gob.ar/srt/comisionesmedicas/tramites' },
    secondary: { label: 'Ver recursos para trabajadores', href: 'https://www.argentina.gob.ar/srt/trabajador' },
  },
];
---

<header class="al-site-header">
  <a class="al-logo" href="/" aria-label="Hacé Cuentas, inicio"><span>Hacé</span><span>Cuentas</span></a>
  <nav aria-label="Navegación principal"><a href="/trabajo">Trabajo</a><a href="/impuestos">Impuestos</a><a href="/tramites">Trámites</a><a href="/jubilacion">Jubilación</a><a href="/buscar">Más⌄</a></nav>
  <a class="al-search" href="/buscar"><span>Buscar en Hacé Cuentas</span><b>⌕</b></a>
  <a class="al-country" href="/argentina"><span>🇦🇷</span> AR⌄</a>
  <a class="al-board" href="/mi-tablero"><span>♙</span> Mi tablero</a>
</header>
<main class="al" data-accidente data-stages={JSON.stringify(stages)}>
  <div class="al-emergency" role="note"><span aria-hidden="true">▲</span><strong>Si necesitás atención urgente, llamá al 107/911.</strong><span>Esta guía no reemplaza asistencia médica.</span></div>

  <div class="al-wrap">
    <section class="al-hero">
      <div><p class="al-eyebrow">SRT · ART · ARGENTINA</p><h1>Tuve un accidente laboral.<br/>¿Qué hago ahora?</h1><p class="al-lede">Guía práctica paso a paso para cuidar tu salud,<br/>hacer valer tus derechos y no perder tu reclamo.</p></div>
      <aside class="al-health"><div class="al-health-title"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z"/><path d="M12 8v7M8.5 11.5h7"/></svg></span><h2>Primero: cuidá tu salud</h2></div><a href="tel:107"><em><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="7" width="16" height="14" rx="2"/><path d="M9 7V4h6v3M12 11v6M9 14h6"/></svg></em><strong>Pedí atención médica ahora</strong><small>En tu prestador o el centro más cercano</small><b>›</b></a><a href="tel:911"><em><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3 4.5 5.5c-1.8 1.8 2 7.4 5 10.4s8.6 6.8 10.4 5L22 18l-5-3-2 2c-2.7-1.2-5.8-4.3-7-7l2-2-3-5Z"/></svg></em><strong>Llamar al 107/911</strong><small>Emergencias médicas</small><b>›</b></a></aside>
    </section>

    <section class="al-stage-section" aria-labelledby="stage-title">
      <h2 id="stage-title">¿En qué momento estás?</h2>
      <div class="al-stages" role="tablist" aria-label="Etapa del caso">
        {stages.map((stage, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} class:list={['al-stage', { active: index === 0 }]} data-stage={stage.id}><span>{stage.number}</span><strong>{stage.label}</strong></button>)}
      </div>
    </section>

    <section class="al-workspace">
      <article class="al-tasks"><h2 data-stage-title>{stages[0].title}</h2><div data-task-list>{stages[0].tasks.map((task, index) => <label class="al-task"><input type="checkbox" data-task-check={index}/><span class="al-task-num">{index + 1}</span><span class="al-task-icon">{index === 0 ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8 8 0 0 1-9 8 9 9 0 0 1-4-.9L3 21l1.4-4A8 8 0 1 1 21 11.5Z"/><path d="M8 12h.01M12 12h.01M16 12h.01"/></svg> : index === 1 ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h9l4 4v16H6Z"/><path d="M15 2v5h5M10 10l-1 8M15 10l-1 8M8 13h9M8 16h9"/></svg> : <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h7l2 2h9v11H3Z"/><path d="M3 7V5h7l2 2"/></svg>}</span><span><strong>{task.title}</strong><small>{task.copy}</small></span><i aria-hidden="true"></i></label>)}</div><div class="al-actions"><a class="al-primary" href={stages[0].primary.href} data-primary>{stages[0].primary.label}<span>›</span></a><a class="al-secondary" href={stages[0].secondary.href} data-secondary>{stages[0].secondary.label}<span>›</span></a></div><p class="al-reassure">♢ No estás solo. Seguí estos pasos para proteger tu salud y tus derechos.</p></article>

      <aside class="al-folder"><h2>Tu carpeta del caso</h2><div class="al-progress"><div class="al-ring" style="--progress:72"><strong data-progress>1 de 5</strong></div><span>Documentos reunidos</span></div><ul data-doc-list>{stages[0].docs.map((doc, index) => <li><label><input type="checkbox" data-doc-check={index} checked={index === 0}/><span></span>{doc}</label></li>)}</ul><button type="button" class="al-download" data-download>⇩&nbsp;&nbsp; Descargar checklist</button><p>♙ Tus archivos son privados y están seguros.</p></aside>
    </section>

    <section class="al-process"><h2>Qué pasa después</h2><div class="al-process-grid"><article><span>▤</span><b>1. Denuncia</b><p>Tu empleador denuncia el accidente a la ART.</p><small>24–48 hs</small></article><i>⟶</i><article><span>✚</span><b>2. Atención ART</b><p>La ART te asigna un prestador y comienza tu tratamiento.</p><small>Inmediato</small></article><i>⟶</i><article><span>✓</span><b>3. Alta médica</b><p>Cuando finaliza el tratamiento, la ART emite el alta.</p><small>Según evolución</small></article><i>⟶</i><article><span>♙</span><b>4. Evaluación de secuelas</b><p>Si corresponde, se evalúa la incapacidad y el porcentaje.</p><small>Hasta 1 año</small></article></div><p class="al-process-note">ⓘ Tu empleador y la ART son quienes gestionan cada etapa. Vos concentrate en tu recuperación y en guardar los comprobantes.</p></section>

    <section class="al-calcs"><h2>Calculá sólo cuando corresponda</h2><div><a href="https://www.argentina.gob.ar/srt/art/pagos-art"><span>▣</span><strong>Pago durante la baja<small>Conocé cuánto te corresponde cobrar mientras estás de baja médica.</small><b>Ver cuándo corresponde&nbsp;&nbsp; →</b></strong></a><a href="/trabajo/indemnizacion-por-despido"><span>♙<small>$</small></span><strong>Indemnización por incapacidad<small>Estimá tu indemnización si te quedó alguna incapacidad permanente.</small><b>Ver cuándo corresponde&nbsp;&nbsp; →</b></strong></a></div><p>💡 <strong>Importante:</strong> estos cálculos aplican después del alta y según cada caso. <a href="#fuente-srt">Leer más</a></p></section>

    <section class="al-source" id="fuente-srt"><div class="al-srt">SRT<small>Superintendencia de<br/>Riesgos del Trabajo</small></div><div><strong>Información basada en la Superintendencia de Riesgos del Trabajo</strong><small>Sitio oficial: <a href="https://www.argentina.gob.ar/srt">www.argentina.gob.ar/srt ↗</a></small></div><a href="https://www.argentina.gob.ar/srt" target="_blank" rel="noopener noreferrer">Ir al sitio oficial&nbsp;&nbsp; ↗</a></section>

  </div>
</main>

<script is:inline define:vars={{ stages }}>
(() => {
  const root = document.querySelector('[data-accidente]'); if (!root) return;
  const qs = (s) => root.querySelector(s); const qsa = (s) => [...root.querySelectorAll(s)];
  let current = stages[0];
  function progress() { const checks=qsa('[data-doc-check]'); const done=checks.filter((c)=>c.checked).length; qs('[data-progress]').textContent=done+' de '+checks.length; qs('.al-ring').style.setProperty('--progress', String(done/checks.length*360)); }
  function render(id) { current=stages.find((s)=>s.id===id)||stages[0]; qsa('[data-stage]').forEach((b)=>{const on=b.dataset.stage===id;b.classList.toggle('active',on);b.setAttribute('aria-selected',String(on));}); qs('[data-stage-title]').textContent=current.title;
    const list=qs('[data-task-list]'); list.replaceChildren(...current.tasks.map((task,index)=>{const label=document.createElement('label');label.className='al-task';label.innerHTML='<input type="checkbox" data-task-check="'+index+'"><span class="al-task-num">'+(index+1)+'</span><span class="al-task-icon">'+task.icon+'</span><span><strong></strong><small></small></span><i aria-hidden="true"></i>';label.querySelector('strong').textContent=task.title;label.querySelector('small').textContent=task.copy;return label;}));
    const docs=qs('[data-doc-list]');docs.replaceChildren(...current.docs.map((doc,index)=>{const li=document.createElement('li');const label=document.createElement('label');label.innerHTML='<input type="checkbox" data-doc-check="'+index+'"'+(id==='ocurrio'&&index===0?' checked':'')+'><span></span>';label.append(document.createTextNode(doc));li.append(label);return li;}));
    const p=qs('[data-primary]');p.textContent=current.primary.label+' ';p.append(Object.assign(document.createElement('span'),{textContent:'›'}));p.href=current.primary.href;const s=qs('[data-secondary]');s.textContent=current.secondary.label+' ';s.append(Object.assign(document.createElement('span'),{textContent:'›'}));s.href=current.secondary.href;progress();window.hcTrack?.('hc_accident_stage',{stage:id}); }
  qsa('[data-stage]').forEach((button)=>button.addEventListener('click',()=>render(button.dataset.stage)));
  root.addEventListener('change',(event)=>{if(event.target.matches('[data-doc-check]'))progress();if(event.target.matches('[data-task-check]'))event.target.closest('.al-task').classList.toggle('done',event.target.checked);});
  qs('[data-download]').addEventListener('click',()=>{const body=['CHECKLIST — ACCIDENTE LABORAL','Etapa: '+current.label,'',...current.docs.map((d)=>'☐ '+d),'','Fuentes: argentina.gob.ar/srt'].join('\n');const blob=new Blob([body],{type:'text/plain;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='checklist-accidente-laboral.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);});
})();
</script>

<style>
  :global(body > main#main){width:100%;padding-top:0;padding-bottom:0}
  .al-site-header{height:69px;width:100%;padding:0 max(18px,calc((100% - 1212px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid #e4e6e8;color:#101d32;box-sizing:border-box}.al-site-header a{text-decoration:none;color:inherit}.al-logo{width:105px;flex:0 0 105px;color:#064b91!important;font-size:1.38rem;font-weight:950;line-height:.92;letter-spacing:-.04em}.al-logo span{display:block}.al-site-header nav{display:flex;align-items:center;gap:28px;white-space:nowrap}.al-site-header nav a{font-size:.78rem;font-weight:650}.al-search{height:39px;min-width:260px;margin-left:auto;border:1px solid #d8dde2;border-radius:7px;display:flex;align-items:center;justify-content:space-between;padding:0 13px;color:#697382!important;font-size:.75rem}.al-search b{font-size:1.15rem;color:#18283d}.al-country,.al-board{height:39px;border:1px solid #d8dde2;border-radius:7px;display:flex;align-items:center;gap:8px;padding:0 13px;font-size:.75rem;font-weight:750;white-space:nowrap}.al-board{border-color:#9eb9d8;color:#064b91!important}.al-board span{font-size:1.2rem}
  .al{--ink:#101d32;--blue:#064b91;--bright:#0055a8;--amber:#ef7600;--line:#d9d9d5;--muted:#374253;background:#fff;color:var(--ink);padding:22px 0 32px}.al *{box-sizing:border-box}.al a{color:inherit}.al-emergency{height:59px;background:#fff8ef;border:1px solid #f2e4cf;border-radius:9px;display:flex;align-items:center;justify-content:center;gap:9px;margin:0 auto;max-width:1280px;padding:12px 20px;font-size:.89rem}.al-emergency>span:first-child{color:var(--amber);font-size:1rem}.al-wrap{max-width:1212px;margin:0 auto;padding:0 20px}.al-hero{display:grid;grid-template-columns:1.18fr .82fr;gap:76px;align-items:center;margin:12px 0 52px}.al-eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.02em;font-weight:850;color:var(--blue);margin:0 0 27px}.al h1{font-size:2.55rem;line-height:1.13;letter-spacing:-.043em;margin:0 0 26px;max-width:590px}.al-lede{font-size:1rem;line-height:1.55;color:#283345;max-width:550px}.al-health{background:#fff;border:1px solid var(--line);border-radius:11px;padding:25px 28px;box-shadow:none}.al-health-title{display:flex;align-items:center;gap:14px;margin-bottom:13px}.al-health-title>span{display:grid;place-items:center;color:white;background:var(--amber);border-radius:50%;width:42px;height:42px;font-size:1.25rem}.al-health h2{font-size:1.27rem;margin:0}.al-health a{display:grid;grid-template-columns:34px 1fr auto;gap:2px 9px;text-decoration:none;padding:15px 0}.al-health a em{grid-row:1/3;color:var(--amber);font-size:1.45rem;font-style:normal;align-self:center}.al-health a strong,.al-health a small{grid-column:2}.al-health a small{color:var(--muted);margin-top:3px;font-size:.8rem}.al-health a b{grid-column:3;grid-row:1/3;font-size:1.5rem;align-self:center}.al-stage-section>h2,.al-workspace h2,.al-process h2,.al-calcs h2,.al-faq h2{font-size:1.32rem;letter-spacing:-.025em;margin:0 0 22px}.al-stages{display:grid;grid-template-columns:repeat(4,1fr);margin-bottom:60px}.al-stage{min-height:86px;border:1px solid var(--line);border-righ