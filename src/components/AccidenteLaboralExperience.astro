---
import type { HubData } from '../lib/hubs/types';
interface Props { data: HubData }
const { data } = Astro.props;

const stages = [
  {
    id: 'ocurrio', number: '1', label: 'Ocurrió el accidente', title: 'Lo que tenés que hacer hoy',
    summary: 'Denunciá el accidente cuanto antes y armá una carpeta con todo lo que pruebe qué pasó.',
    tasks: [
      { icon: '💬', title: 'Avisá y dejá constancia', copy: 'Informá a tu empleador lo antes posible. Dejá registrado cómo, cuándo y dónde ocurrió.' },
      { icon: '#', title: 'Pedí el número de siniestro', copy: 'La denuncia debe generar un número. Anotalo: identifica tu caso ante la ART.' },
      { icon: '▱', title: 'Guardá estudios y certificados', copy: 'Conservá indicaciones, certificados, estudios y comprobantes de traslados.' },
    ],
    docs: ['Constancia de denuncia', 'Número de siniestro', 'Certificado o informe médico', 'Estudios e indicaciones', 'Datos de testigos'],
    primary: { label: 'Ver cómo denunciarlo', href: 'https://www.argentina.gob.ar/srt/trabajador' },
    secondary: { label: 'Encontrar mi ART', href: 'https://www.argentina.gob.ar/srt/comisionesmedicas/recursos-trabajador' },
  },
  {
    id: 'tratamiento', number: '2', label: 'Estoy en tratamiento', title: 'Cuidá el tratamiento y controlá la prestación',
    summary: 'La ART debe brindar asistencia y cubrir la prestación dineraria durante la incapacidad temporaria.',
    tasks: [
      { icon: '+', title: 'Cumplí las indicaciones médicas', copy: 'Asistí a los turnos y avisá si no podés concurrir. Pedí copia de cada indicación.' },
      { icon: '$', title: 'Controlá lo que cobrás', copy: 'Compará la prestación con tu remuneración habitual y guardá todos los recibos.' },
      { icon: '!', title: 'Reclamá una prestación insuficiente', copy: 'Si falta tratamiento, traslado o pago, documentá el problema y usá el canal oficial.' },
    ],
    docs: ['Número de siniestro', 'Turnos y prestaciones', 'Recibos de sueldo', 'Comprobantes de traslado', 'Certificados médicos'],
    primary: { label: 'Ver pagos de la ART', href: 'https://www.argentina.gob.ar/srt/art/pagos-art' },
    secondary: { label: 'Consultar o reclamar', href: 'https://www.argentina.gob.ar/srt/trabajador' },
  },
  {
    id: 'alta', number: '3', label: 'Me dieron el alta', title: 'Revisá el alta y registrá cualquier secuela',
    summary: 'Si todavía tenés síntomas o limitaciones, no dejes pasar la constancia: el alta abre la etapa de evaluación.',
    tasks: [
      { icon: '✓', title: 'Leé el alta completa', copy: 'Verificá diagnóstico, fecha, tratamiento recibido y si menciona secuelas.' },
      { icon: '↗', title: 'Actuá si no estás de acuerdo', copy: 'Podés iniciar una divergencia en el alta ante la Comisión Médica.' },
      { icon: '%', title: 'Pedí evaluación de secuelas', copy: 'Si quedaron limitaciones, corresponde evaluar el porcentaje de incapacidad.' },
    ],
    docs: ['Alta médica', 'Historia clínica', 'Estudios anteriores y actuales', 'Recibos de sueldo', 'Descripción de secuelas'],
    primary: { label: 'Ver trámites de Comisión Médica', href: 'https://www.argentina.gob.ar/srt/comisionesmedicas/tramites' },
    secondary: { label: 'Estimar una incapacidad', href: '/trabajo/indemnizacion-por-despido' },
  },
  {
    id: 'rechazo', number: '4', label: 'La ART rechazó el caso', title: 'Documentá el rechazo y elegí el reclamo correcto',
    summary: 'La vía cambia según se haya rechazado el accidente, el tratamiento, el alta o la incapacidad.',
    tasks: [
      { icon: '✉', title: 'Guardá la carta de rechazo', copy: 'Necesitás la fecha, el motivo y la aseguradora que tomó la decisión.' },
      { icon: '≡', title: 'Ordená la prueba médica', copy: 'Reuní certificados, estudios, testigos y la constancia de denuncia.' },
      { icon: '→', title: 'Iniciá el trámite específico', copy: 'La SRT separa rechazo de contingencia, divergencia en alta y divergencia en prestaciones.' },
    ],
    docs: ['Carta o constancia de rechazo', 'Denuncia del accidente', 'Historia clínica', 'Estudios médicos', 'Datos del empleador'],
    primary: { label: 'Elegir el trámite en la SRT', href: 'https://www.argentina.gob.ar/srt/comisionesmedicas/tramites' },
    secondary: { label: 'Ver recursos para trabajadores', href: 'https://www.argentina.gob.ar/srt/trabajador' },
  },
];
---

<main class="al" data-accidente data-stages={JSON.stringify(stages)}>
  <div class="al-emergency" role="note"><span aria-hidden="true">▲</span><strong>Si necesitás atención urgente, llamá al 107/911.</strong><span>Esta guía no reemplaza asistencia médica.</span></div>

  <div class="al-wrap">
    <nav class="al-crumb" aria-label="Migas de pan"><a href="/">Inicio</a><span>›</span><a href={data.siloHref}>{data.silo}</a><span>›</span><span>Accidente laboral</span></nav>

    <section class="al-hero">
      <div><p class="al-eyebrow">{data.eyebrow}</p><h1>{data.h1}</h1><p class="al-lede">{data.lede}</p></div>
      <aside class="al-health"><div class="al-health-title"><span>✚</span><h2>Primero: cuidá tu salud</h2></div><a href="tel:107"><strong>Pedí atención médica ahora</strong><small>En tu prestador o el centro más cercano</small><b>›</b></a><a href="tel:911"><strong>Llamar al 107/911</strong><small>Emergencias médicas</small><b>›</b></a></aside>
    </section>

    <section class="al-stage-section" aria-labelledby="stage-title">
      <h2 id="stage-title">¿En qué momento estás?</h2>
      <div class="al-stages" role="tablist" aria-label="Etapa del caso">
        {stages.map((stage, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} class:list={['al-stage', { active: index === 0 }]} data-stage={stage.id}><span>{stage.number}</span><strong>{stage.label}</strong></button>)}
      </div>
    </section>

    <section class="al-workspace">
      <article class="al-tasks"><p class="al-kicker" data-stage-summary>{stages[0].summary}</p><h2 data-stage-title>{stages[0].title}</h2><div data-task-list>{stages[0].tasks.map((task, index) => <label class="al-task"><input type="checkbox" data-task-check={index}/><span class="al-task-num">{index + 1}</span><span class="al-task-icon">{task.icon}</span><span><strong>{task.title}</strong><small>{task.copy}</small></span><i aria-hidden="true"></i></label>)}</div><div class="al-actions"><a class="al-primary" href={stages[0].primary.href} data-primary>{stages[0].primary.label}<span>›</span></a><a class="al-secondary" href={stages[0].secondary.href} data-secondary>{stages[0].secondary.label}<span>›</span></a></div><p class="al-reassure">♢ No estás solo. Seguí estos pasos para proteger tu salud y tus derechos.</p></article>

      <aside class="al-folder"><p class="al-kicker">Documentación</p><h2>Tu carpeta del caso</h2><div class="al-progress"><div class="al-ring" style="--progress:0"><strong data-progress>0 de 5</strong></div><span>Documentos reunidos</span></div><ul data-doc-list>{stages[0].docs.map((doc, index) => <li><label><input type="checkbox" data-doc-check={index}/><span></span>{doc}</label></li>)}</ul><button type="button" class="al-download" data-download>↓ Descargar checklist</button><p>▣ Tus archivos no se suben ni salen de tu dispositivo.</p></aside>
    </section>

    <section class="al-process"><h2>Qué pasa después</h2><div class="al-process-grid"><article><span>▤</span><b>1. Denuncia</b><p>Tu empleador o vos denuncian el accidente a la ART.</p><small>Cuanto antes</small></article><i>→</i><article><span>✚</span><b>2. Atención ART</b><p>La ART asigna prestador y comienza el tratamiento.</p><small>Inmediato</small></article><i>→</i><article><span>✓</span><b>3. Alta médica</b><p>Cuando termina el tratamiento, la ART emite el alta.</p><small>Según evolución</small></article><i>→</i><article><span>◯</span><b>4. Evaluación de secuelas</b><p>Si corresponde, se determina incapacidad y porcentaje.</p><small>Según el caso</small></article></div><p class="al-process-note">ⓘ Tu empleador y la ART gestionan cada etapa. Vos concentrate en recuperarte y guardar los comprobantes.</p></section>

    <section class="al-calcs"><h2>Calculá sólo cuando corresponda</h2><div><a href="https://www.argentina.gob.ar/srt/art/pagos-art"><span>▣</span><strong>Pago durante la baja<small>Conocé qué corresponde cobrar mientras estás con incapacidad temporaria.</small><b>Ver cuándo corresponde →</b></strong></a><a href="/trabajo/indemnizacion-por-despido"><span>%</span><strong>Indemnización por incapacidad<small>Estimá una referencia si quedó una incapacidad permanente.</small><b>Ver cuándo corresponde →</b></strong></a></div><p>💡 <strong>Importante:</strong> estos cálculos aplican después de la denuncia y según cada caso.</p></section>

    <section class="al-source"><div class="al-srt">SRT<small>Superintendencia de<br/>Riesgos del Trabajo</small></div><div><strong>Información basada en la Superintendencia de Riesgos del Trabajo</strong><small>Sitio oficial: www.argentina.gob.ar/srt</small></div><a href="https://www.argentina.gob.ar/srt" target="_blank" rel="noopener noreferrer">Ir al sitio oficial ↗</a></section>

    <section class="al-faq"><p class="al-kicker">Dudas frecuentes</p><h2>Lo que conviene saber antes de avanzar</h2>{data.faq.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>
  </div>
</main>

<script is:inline define:vars={{ stages }}>
(() => {
  const root = document.querySelector('[data-accidente]'); if (!root) return;
  const qs = (s) => root.querySelector(s); const qsa = (s) => [...root.querySelectorAll(s)];
  let current = stages[0];
  function progress() { const checks=qsa('[data-doc-check]'); const done=checks.filter((c)=>c.checked).length; qs('[data-progress]').textContent=done+' de '+checks.length; qs('.al-ring').style.setProperty('--progress', String(done/checks.length*360)); }
  function render(id) { current=stages.find((s)=>s.id===id)||stages[0]; qsa('[data-stage]').forEach((b)=>{const on=b.dataset.stage===id;b.classList.toggle('active',on);b.setAttribute('aria-selected',String(on));}); qs('[data-stage-title]').textContent=current.title; qs('[data-stage-summary]').textContent=current.summary;
    const list=qs('[data-task-list]'); list.replaceChildren(...current.tasks.map((task,index)=>{const label=document.createElement('label');label.className='al-task';label.innerHTML='<input type="checkbox" data-task-check="'+index+'"><span class="al-task-num">'+(index+1)+'</span><span class="al-task-icon">'+task.icon+'</span><span><strong></strong><small></small></span><i aria-hidden="true"></i>';label.querySelector('strong').textContent=task.title;label.querySelector('small').textContent=task.copy;return label;}));
    const docs=qs('[data-doc-list]');docs.replaceChildren(...current.docs.map((doc,index)=>{const li=document.createElement('li');const label=document.createElement('label');label.innerHTML='<input type="checkbox" data-doc-check="'+index+'"><span></span>';label.append(document.createTextNode(doc));li.append(label);return li;}));
    const p=qs('[data-primary]');p.textContent=current.primary.label+' ';p.append(Object.assign(document.createElement('span'),{textContent:'›'}));p.href=current.primary.href;const s=qs('[data-secondary]');s.textContent=current.secondary.label+' ';s.append(Object.assign(document.createElement('span'),{textContent:'›'}));s.href=current.secondary.href;progress();window.hcTrack?.('hc_accident_stage',{stage:id}); }
  qsa('[data-stage]').forEach((button)=>button.addEventListener('click',()=>render(button.dataset.stage)));
  root.addEventListener('change',(event)=>{if(event.target.matches('[data-doc-check]'))progress();if(event.target.matches('[data-task-check]'))event.target.closest('.al-task').classList.toggle('done',event.target.checked);});
  qs('[data-download]').addEventListener('click',()=>{const body=['CHECKLIST — ACCIDENTE LABORAL','Etapa: '+current.label,'',...current.docs.map((d)=>'☐ '+d),'','Fuentes: argentina.gob.ar/srt'].join('\n');const blob=new Blob([body],{type:'text/plain;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='checklist-accidente-laboral.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);});
})();
</script>

<style>
  .al{--ink:#172235;--blue:#174b7a;--bright:#075bb6;--amber:#eb7500;--line:#dfe3e7;--muted:#5e6978;background:#fbfbf8;color:var(--ink);padding-bottom:72px}.al *{box-sizing:border-box}.al a{color:inherit}.al-emergency{min-height:56px;background:#fff8ee;border:1px solid #f5dfc0;border-radius:10px;display:flex;align-items:center;justify-content:center;gap:10px;margin:18px auto 0;max-width:1180px;padding:12px 20px;font-size:.9rem}.al-emergency>span:first-child{color:var(--amber);font-size:1rem}.al-wrap{max-width:1160px;margin:0 auto;padding:0 20px}.al-crumb{display:flex;gap:9px;color:#7a8490;font-size:.78rem;margin:28px 0 36px}.al-crumb a{text-decoration:none}.al-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:center;margin-bottom:50px}.al-eyebrow,.al-kicker{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;font-weight:850;color:var(--blue);margin:0 0 14px}.al h1{font-size:clamp(2.5rem,5vw,4.3rem);line-height:1.02;letter-spacing:-.055em;margin:0 0 22px;max-width:690px}.al-lede{font-size:1.08rem;line-height:1.65;color:var(--muted);max-width:660px}.al-health{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px 24px;box-shadow:0 10px 30px rgba(28,45,65,.04)}.al-health-title{display:flex;align-items:center;gap:12px;margin-bottom:8px}.al-health-title>span{display:grid;place-items:center;color:white;background:var(--amber);border-radius:50%;width:38px;height:38px;font-size:1.25rem}.al-health h2{font-size:1.28rem;margin:0}.al-health a{display:grid;grid-template-columns:1fr auto;gap:2px 12px;text-decoration:none;border-top:1px solid #edf0f2;padding:16px 4px}.al-health a strong,.al-health a small{grid-column:1}.al-health a small{color:var(--muted);margin-top:3px}.al-health a b{grid-column:2;grid-row:1/3;font-size:1.5rem;align-self:center}.al-stage-section>h2,.al-workspace h2,.al-process h2,.al-calcs h2,.al-faq h2{font-size:1.45rem;letter-spacing:-.025em;margin:0 0 20px}.al-stages{display:grid;grid-template-columns:repeat(4,1fr);margin-bottom:22px}.al-stage{min-height:86px;border:1px solid var(--line);border-right:0;background:#fff;color:var(--ink);padding:15px 18px;display:flex;align-items:center;gap:14px;text-align:left;font:inherit;cursor:pointer;position:relative}.al-stage:first-child{border-radius:10px 0 0 10px}.al-stage:last-child{border-radius:0 10px 10px 0;border-right:1px solid var(--line)}.al-stage span{flex:0 0 36px;height:36px;border:1px solid #bfc6cd;border-radius:50%;display:grid;place-items:center;font-weight:850}.al-stage strong{font-size:.9rem;line-height:1.3}.al-stage.active{border:2px solid var(--amber);background:#fffaf4;z-index:2}.al-stage.active span{background:var(--amber);border-color:var(--amber);color:#fff}.al-workspace{display:grid;grid-template-columns:1.65fr .8fr;gap:20px}.al-tasks,.al-folder,.al-process,.al-source,.al-faq{background:#fff;border:1px solid var(--line);border-radius:14px;padding:28px}.al-tasks>.al-kicker{color:var(--muted);text-transform:none;letter-spacing:0;line-height:1.5;font-size:.82rem;font-weight:600}.al-task{display:grid;grid-template-columns:34px 50px 1fr 22px;gap:13px;align-items:center;border-top:1px solid #edf0f2;padding:18px 0;cursor:pointer}.al-task input{position:absolute;opacity:0;pointer-events:none}.al-task-num{font-size:1.45rem;font-weight:900}.al-task-icon{width:50px;height:50px;border-radius:11px;background:#fff4e7;color:var(--amber);display:grid;place-items:center;font-size:1.25rem;font-weight:900}.al-task strong,.al-task small{display:block}.al-task small{font-size:.85rem;color:var(--muted);line-height:1.5;margin-top:5px}.al-task i{width:21px;height:21px;border:1.5px solid #83909f;border-radius:4px}.al-task.done{opacity:.65}.al-task.done i{background:var(--blue);border-color:var(--blue);box-shadow:inset 0 0 0 4px white}.al-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.al-actions a{min-height:52px;display:flex;align-items:center;justify-content:space-between;border-radius:6px;padding:0 18px;text-decoration:none;font-weight:800;font-size:.88rem}.al-primary{background:var(--bright);color:white!important}.al-secondary{border:1.5px solid var(--bright);color:var(--bright)!important}.al-reassure{font-size:.76rem;text-align:center;color:var(--muted);margin:18px 0 0}.al-folder h2{font-size:1.25rem}.al-progress{text-align:center;margin:18px 0}.al-ring{--progress:0;width:112px;height:112px;margin:0 auto 10px;border-radius:50%;background:conic-gradient(var(--amber) calc(var(--progress)*1deg),#e6e8e9 0);display:grid;place-items:center;position:relative}.al-ring:before{content:"";position:absolute;inset:13px;background:#fff;border-radius:50%}.al-ring strong{z-index:1;font-size:1.15rem}.al-progress>span{font-size:.8rem;color:var(--muted)}.al-folder ul{list-style:none;margin:18px 0;padding:0}.al-folder li{margin:11px 0}.al-folder li label{display:flex;align-items:center;gap:9px;font-size:.82rem;cursor:pointer}.al-folder li input{position:absolute;opacity:0}.al-folder li span{width:18px;height:18px;border:1px solid #8793a0;border-radius:50%;display:grid;place-items:center}.al-folder li input:checked+span{background:#16a05d;border-color:#16a05d}.al-folder li input:checked+span:after{content:'✓';color:white;font-size:.7rem}.al-download{width:100%;height:48px;border:1.5px solid var(--bright);background:white;color:var(--bright);border-radius:6px;font-weight:800;cursor:pointer}.al-folder>p:last-child{font-size:.72rem;color:var(--muted);line-height:1.45}.al-process{margin-top:20px;background:#f4f8fc}.al-process-grid{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;align-items:center;gap:12px;text-align:center}.al-process article>span{width:50px;height:50px;margin:0 auto 12px;border:1.5px solid var(--bright);color:var(--bright);border-radius:50%;display:grid;place-items:center;font-size:1.2rem}.al-process article b{display:block;font-size:.86rem}.al-process article p{font-size:.76rem;color:var(--muted);line-height:1.45;min-height:44px}.al-process article small{display:inline-block;background:#e7f1fc;color:var(--bright);padding:5px 10px;border-radius:4px;font-size:.68rem}.al-process-grid>i{color:var(--bright);font-style:normal;font-size:1.4rem}.al-process-note{background:#e8f2fc;color:#496172;border-radius:7px;padding:10px 13px;font-size:.75rem;margin:18px 0 0}.al-calcs{padding:32px 4px 0}.al-calcs>div{display:grid;grid-template-columns:1fr 1fr;gap:14px}.al-calcs a{background:#fff;border:1px solid var(--line);border-radius:10px;padding:20px;display:flex;gap:16px;text-decoration:none}.al-calcs a>span{width:52px;height:52px;flex:0 0 52px;background:var(--bright);color:white;border-radius:50%;display:grid;place-items:center;font-size:1.2rem}.al-calcs a strong,.al-calcs a small,.al-calcs a b{display:block}.al-calcs a small{color:var(--muted);line-height:1.45;margin:5px 0}.al-calcs a b{color:var(--bright);font-size:.78rem}.al-calcs>p{background:#fff7eb;border:1px solid #f5e5cd;border-radius:8px;padding:11px 18px;font-size:.78rem}.al-source{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:22px;margin-top:22px;padding:18px 22px}.al-srt{color:var(--bright);font-size:1.65rem;font-weight:950;line-height:.85;border-right:1px solid var(--line);padding-right:22px}.al-srt small{display:block;font-size:.48rem;line-height:1.1;margin-top:7px}.al-source>div:nth-child(2) strong,.al-source>div:nth-child(2) small{display:block}.al-source>div:nth-child(2) small{color:var(--muted);margin-top:4px}.al-source>a{border:1px solid var(--bright);color:var(--bright);border-radius:6px;padding:11px 16px;text-decoration:none;font-size:.78rem;font-weight:800}.al-faq{margin-top:22px}.al-faq details{border-top:1px solid var(--line);padding:17px 0}.al-faq summary{font-weight:800;cursor:pointer}.al-faq details p{color:var(--muted);line-height:1.65;max-width:820px}.al-stage:focus-visible,.al-download:focus-visible,.al a:focus-visible,.al-task:focus-within,.al-folder li label:focus-within{outline:3px solid #7dc4ff;outline-offset:3px}
  @media(max-width:760px){.al-emergency{margin:10px 12px 0;align-items:flex-start;flex-wrap:wrap;justify-content:flex-start;font-size:.78rem}.al-wrap{padding:0 16px}.al-crumb{margin:22px 0}.al-hero{grid-template-columns:1fr;gap:22px;margin-bottom:32px}.al h1{font-size:2.65rem}.al-health{padding:18px}.al-stages{grid-template-columns:1fr 1fr;gap:8px}.al-stage,.al-stage:first-child,.al-stage:last-child{border:1px solid var(--line);border-radius:9px;min-height:76px}.al-workspace{grid-template-columns:1fr}.al-tasks,.al-folder,.al-process,.al-faq{padding:21px}.al-actions,.al-calcs>div{grid-template-columns:1fr}.al-task{grid-template-columns:25px 44px 1fr 20px;gap:9px}.al-task-icon{width:44px;height:44px}.al-process-grid{grid-template-columns:1fr 1fr;gap:22px}.al-process-grid>i{display:none}.al-process article p{min-height:auto}.al-source{grid-template-columns:1fr;text-align:center}.al-srt{border-right:0;border-bottom:1px solid var(--line);padding:0 0 15px}.al-source>a{justify-self:stretch}.al-calcs{padding-top:28px}}
</style>
