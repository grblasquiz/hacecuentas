</style>

<script>
  function wireHub() {
    document.querySelectorAll('.calc-hub[data-hub]').forEach((root) => {
      if ((root as HTMLElement).dataset.wired) return;
      (root as HTMLElement).dataset.wired = '1';

      // Acceso rápido (variante input): el input/botón abren la calculadora principal.
      const quick = root.querySelector('.quick') as HTMLElement | null;
      const form = root.querySelector('[data-quick-form]') as HTMLFormElement | null;
      if (quick && form) {
        const href = quick.dataset.quickHref;
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          if (href) window.location.href = href;
        });
      }

      // Buscador + filtro local sobre las cards destacadas (sin navegar).
      const search = root.querySelector('.hub-search') as HTMLInputElement | null;
      const filter = root.querySelector('.filter') as HTMLSelectElement | null;
      const cards = Array.from(root.querySelectorAll('.cards .card')) as HTMLElement[];
      const noRes = root.querySelector('.no-results') as HTMLElement | null;
      if (!search && !filter) return;
      const apply = () => {
        const term = (search?.value || '').trim().toLowerCase();
        const b = filter?.value || '';
        let shown = 0;
        cards.forEach((card) => {
          const hay = card.dataset.search || '';
          const okQ = !term || hay.includes(term);
          const okB = !b || card.dataset.badge === b;
          const show = okQ && okB;
          card.hidden = !show;
          if (show) shown++;
        });
        if (noRes) noRes.hidden = shown !== 0;
      };
      search?.addEventListener('input', apply);
      filter?.addEventListener('change', apply);
    });
  }
  wireHub();
  document.addEventListener('astro:page-load', wireHub);
</script>
