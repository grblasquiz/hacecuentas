---
import { tiempoParaAhorrar } from '../lib/formulas/tiempo-para-ahorrar';
import { cancelacionAnticipadaPrestamo } from '../lib/formulas/cancelacion-anticipada-prestamo';
import { refinanciacionPrestamo } from '../lib/formulas/refinanciacion-prestamo';

interface Props { calc: any; }
const { calc } = Astro.props;
const kind = calc.slug === 'calculadora-tiempo-para-ahorrar-meta'
  ? 'ahorro'
  : calc.slug === 'calculadora-cancelacion-anticipada-prestamo'
    ? 'cancelacion'
    : 'refinanciacion';

const money = (n: number) => '$' + Math.round(n).toLocaleString('es-AR');
const plain = (s = '') => s.replace(/\*\*/g, '');

const defaults = kind === 'ahorro'
  ? { meta: 5_000_000, ahorroInicial: 500_000, aporte: 150_000, frecuencia: 'mensual', tasaAnual: 20, inflacionAnual: 15 }
  : kind === 'cancelacion'
    ? { saldoPendiente: 5_000_000, tna: 80, cuotasRestantes: 24, pagoAnticipado: 1_250_000, comisionPorcentaje: 0, estrategia: 'plazo', tasaAlternativa: 0 }
    : { saldoActual: 5_000_000, tasaActual: 80, mesesActuales: 24, tasaNueva: 55, mesesNuevos: 24, gastosNuevo: 100_000, costoCancelacion: 0 };

const initial: any = kind === 'ahorro'
  ? tiempoParaAhorrar(defaults as any)
  : kind === 'cancelacion'
    ? cancelacionAnticipadaPrestamo(defaults as any)
    : refinanciacionPrestamo(defaults as any);

const title = kind === 'ahorro' ? 'Armá tu plan de ahorro'
  : kind === 'cancelacion' ? 'Simulá el pago anticipado'
  : 'Compará el préstamo actual con la oferta nueva';
const subtitle = kind === 'ahorro' ? 'Empezá con un caso de ejemplo y ajustalo a tu objetivo.'
  : kind === 'cancelacion' ? 'Probá cuánto adelantar y elegí si querés bajar plazo o cuota.'
  : 'Mirá cuota y costo total juntos antes de decidir.';
---

<div class="fc" data-fcluster={kind} data-slug={calc.slug} data-formula={calc.formulaId}>
  <div class="fc-head">
    <div>
      <span class="fc-eyebrow">Simulador interactivo</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>
    <span class="fc-privacy" title="El cálculo corre en tu navegador">🔒 Tus datos no salen del dispositivo</span>
  </div>

  {kind === 'ahorro' && (
    <>
      <div class="fc-presets" aria-label="Escenarios rápidos">
        <span>Probá un caso:</span>
        <button type="button" data-preset="viaje">✈️ Viaje</button>
        <button type="button" data-preset="auto">🚗 Anticipo auto</button>
        <button type="button" data-preset="fondo">🛟 Fondo de emergencia</button>
      </div>
      <form class="fc-grid" data-form novalidate>
        <div class="fc-inputs">
          <div class="fc-section-label"><span>1</span> Objetivo y punto de partida</div>
          <div class="fc-two">
            <label class="fc-field"><span>Meta de ahorro</span><span class="fc-money"><b>$</b><input name="meta" type="number" min="1" step="1000" value={(defaults as any).meta} required /></span></label>
            <label class="fc-field"><span>Ya tengo ahorrado</span><span class="fc-money"><b>$</b><input name="ahorroInicial" type="number" min="0" step="1000" value={(defaults as any).ahorroInicial} /></span></label>
          </div>
          <div class="fc-section-label"><span>2</span> Ritmo de ahorro</div>
          <label class="fc-field"><span>Aporte por período</span><span class="fc-money"><b>$</b><input name="aporte" type="number" min="1" step="1000" value={(defaults as any).aporte} required /></span></label>
          <fieldset class="fc-seg-wrap"><legend>¿Cada cuánto aportás?</legend><div class="fc-seg">
            <label><input type="radio" name="frecuencia" value="semanal" /><span>Semanal</span></label>
            <label><input type="radio" name="frecuencia" value="quincenal" /><span>Quincenal</span></label>
            <label><input type="radio" name="frecuencia" value="mensual" checked /><span>Mensual</span></label>
          </div></fieldset>
          <details class="fc-advanced">
            <summary><span>⚙️ Rendimiento e inflación</span><small>Opcional</small></summary>
            <div class="fc-two fc-advanced-body">
              <label class="fc-field"><span>Rendimiento anual estimado</span><span class="fc-suffix"><input name="tasaAnual" type="number" min="0" max="500" step="0.1" value={(defaults as any).tasaAnual} /><b>%</b></span><small>Usá una tasa neta de comisiones e impuestos.</small></label>
              <label class="fc-field"><span>Inflación anual estimada</span><span class="fc-suffix"><input name="inflacionAnual" type="number" min="0" max="1000" step="0.1" value={(defaults as any).inflacionAnual} /><b>%</b></span><small>No cambia la fecha nominal; muestra poder de compra.</small></label>
            </div>
          </details>
          <button class="fc-submit" type="submit">Calcular cuándo llego <span>→</span></button>
          <p class="fc-error" data-error role="alert" hidden></p>
        </div>
        <section class="fc-result" data-result aria-live="polite">
          <div class="fc-result-top"><span>Tiempo estimado</span><span class="fc-status">Caso cargado</span></div>
          <div class="fc-big"><strong data-primary>{initial.mesesNecesarios}</strong><span>meses</span></div>
          <p class="fc-verdict" data-verdict>{initial.detalle}</p>
          <div class="fc-metrics">
            <div><span>Fecha estimada</span><strong data-m1>{initial.fechaEstimada}</strong></div>
            <div><span>Total aportado</span><strong data-m2>{money(initial.totalAportado)}</strong></div>
            <div><span>Rendimiento</span><strong data-m3>{money(initial.interesesGanados)}</strong></div>
            <div><span>Valor de hoy</span><strong data-m4>{money(initial.valorReal)}</strong></div>
          </div>
          <div class="fc-compose"><div><span>Tu dinero</span><span>Rendimiento</span></div><div class="fc-bar"><i data-bar style={`width:${Math.min(100, initial.totalAportado / Math.max(1, initial.totalAportado + initial.interesesGanados) * 100)}%`}></i></div></div>
          <div class="fc-insight" data-insight>{plain(initial._insight?.text)}</div>
          <details class="fc-detail"><summary>Ver evolución del ahorro</summary><div class="fc-table-wrap"><table><thead><tr><th>Mes</th><th>Saldo</th><th>Aportado</th><th>Rendimiento</th></tr></thead><tbody data-table>{initial._table?.rows?.slice(-6).map((row: any[]) => <tr>{row.map((cell: any) => <td>{cell}</td>)}</tr>)}</tbody></table></div></details>
          <button class="fc-copy" type="button" data-copy>⧉ Copiar resumen</button>
        </section>
      </form>
    </>
  )}

  {kind === 'cancelacion' && (
    <>
      <div class="fc-presets" aria-label="Porcentaje a adelantar">
        <span>Adelantar:</span>
        <button type="button" data-share="10">10%</button><button type="button" data-share="25" class="active">25%</button><button type="button" data-share="50">50%</button><button type="button" data-share="100">Todo</button>
      </div>
      <form class="fc-grid" data-form novalidate>
        <div class="fc-inputs">
          <div class="fc-section-label"><span>1</span> Tu préstamo hoy</div>
          <label class="fc-field"><span>Saldo de capital pendiente</span><span class="fc-money"><b>$</b><input name="saldoPendiente" type="number" min="1" step="1000" value={(defaults as any).saldoPendiente} required /></span><small>No uses la suma de cuotas: pedí el saldo de capital.</small></label>
          <div class="fc-two">
            <label class="fc-field"><span>TNA</span><span class="fc-suffix"><input name="tna" type="number" min="0" step="0.1" value={(defaults as any).tna} required /><b>%</b></span></label>
            <label class="fc-field"><span>Cuotas restantes</span><input name="cuotasRestantes" type="number" min="1" step="1" value={(defaults as any).cuotasRestantes} required /></label>
          </div>
          <div class="fc-section-label"><span>2</span> El adelanto</div>
          <label class="fc-field"><span>Monto a pagar ahora</span><span class="fc-money"><b>$</b><input name="pagoAnticipado" type="number" min="1" step="1000" value={(defaults as any).pagoAnticipado} required /></span></label>
          <fieldset class="fc-seg-wrap"><legend>¿Qué querés reducir?</legend><div class="fc-seg">
            <label><input type="radio" name="estrategia" value="plazo" checked /><span>⏱️ Terminar antes</span></label>
            <label><input type="radio" name="estrategia" value="cuota" /><span>💳 Bajar la cuota</span></label>
          </div></fieldset>
          <details class="fc-advanced"><summary><span>⚙️ Costos y alternativa</span><small>Opcional</small></summary><div class="fc-two fc-advanced-body">
            <label class="fc-field"><span>Comisión por cancelar</span><span class="fc-suffix"><input name="comisionPorcentaje" type="number" min="0" step="0.1" value="0" /><b>%</b></span></label>
            <label class="fc-field"><span>Rendimiento alternativo</span><span class="fc-suffix"><input name="tasaAlternativa" type="number" min="0" step="0.1" value="0" /><b>%</b></span></label>
          </div></details>
          <button class="fc-submit" type="submit">Comparar antes y después <span>→</span></button>
          <p class="fc-error" data-error role="alert" hidden></p>
        </div>
        <section class="fc-result" data-result aria-live="polite">
          <div class="fc-result-top"><span>Beneficio neto estimado</span><span class="fc-status" data-share-status>25% cargado</span></div>
          <div class="fc-big fc-big-money"><strong data-primary>{money(initial.beneficioNeto)}</strong></div>
          <p class="fc-verdict" data-verdict>{initial.detalle}</p>
          <div class="fc-metrics">
            <div><span>Intereses evitados</span><strong data-m1>{money(initial.interesesAhorrados)}</strong></div>
            <div><span>Meses que recortás</span><strong data-m2>{initial.mesesAhorrados}</strong></div>
            <div><span>Cuota actual</span><strong data-m3>{money(initial.cuotaActual)}</strong></div>
            <div><span>Cuota nueva</span><strong data-m4>{initial.cuotaNueva ? money(initial.cuotaNueva) : 'Cancelado'}</strong></div>
          </div>
          <div class="fc-compare"><div><span>Sin adelantar</span><b data-before>{money(initial.cuotaActual)}</b></div><em>→</em><div><span>Después</span><b data-after>{initial.cuotaNueva ? money(initial.cuotaNueva) : 'Deuda cancelada'}</b></div></div>
          <div class="fc-insight" data-insight>{plain(initial._insight?.text)}</div>
          <button class="fc-copy" type="button" data-copy>⧉ Copiar comparación</button>
        </section>
      </form>
    </>
  )}

  {kind === 'refinanciacion' && (
    <>
      <div class="fc-presets" aria-label="Escenarios de refinanciación">
        <span>Escenario:</span><button type="button" data-refi="rate" class="active">📉 Menor tasa</button><button type="button" data-refi="payment">🧘 Menor cuota</button><button type="button" data-refi="fees">🧾 Con gastos altos</button>
      </div>
      <form class="fc-grid" data-form novalidate>
        <div class="fc-inputs">
          <div class="fc-loan-card"><div class="fc-loan-head"><span>Préstamo actual</span><small>Lo que falta pagar</small></div>
            <label class="fc-field"><span>Saldo pendiente</span><span class="fc-money"><b>$</b><input name="saldoActual" type="number" min="1" step="1000" value={(defaults as any).saldoActual} required /></span></label>
            <div class="fc-two"><label class="fc-field"><span>TNA actual</span><span class="fc-suffix"><input name="tasaActual" type="number" min="0" step="0.1" value={(defaults as any).tasaActual} required /><b>%</b></span></label><label class="fc-field"><span>Meses restantes</span><input name="mesesActuales" type="number" min="1" step="1" value={(defaults as any).mesesActuales} required /></label></div>
          </div>
          <div class="fc-loan-card fc-loan-card-new"><div class="fc-loan-head"><span>Oferta nueva</span><small>Copiala de la propuesta</small></div>
            <div class="fc-two"><label class="fc-field"><span>TNA nueva</span><span class="fc-suffix"><input name="tasaNueva" type="number" min="0" step="0.1" value={(defaults as any).tasaNueva} required /><b>%</b></span></label><label class="fc-field"><span>Plazo nuevo</span><input name="mesesNuevos" type="number" min="1" step="1" value={(defaults as any).mesesNuevos} required /></label></div>
            <div class="fc-two"><label class="fc-field"><span>Gastos del crédito</span><span class="fc-money"><b>$</b><input name="gastosNuevo" type="number" min="0" step="1000" value={(defaults as any).gastosNuevo} /></span></label><label class="fc-field"><span>Costo de cancelar</span><span class="fc-money"><b>$</b><input name="costoCancelacion" type="number" min="0" step="1000" value="0" /></span></label></div>
          </div>
          <div class="fc-tip">💡 Si tenés el <strong>CFT</strong>, usalo como tasa para acercarte al costo real total.</div>
          <button class="fc-submit" type="submit">Ver si me conviene <span>→</span></button>
          <p class="fc-error" data-error role="alert" hidden></p>
        </div>
        <section class="fc-result" data-result aria-live="polite">
          <div class="fc-result-top"><span>Diferencia de costo total</span><span class="fc-status" data-status>{initial.ahorroTotal > 0 ? 'Conviene' : 'No conviene'}</span></div>
          <div class="fc-big fc-big-money"><strong data-primary>{money(initial.ahorroTotal)}</strong></div>
          <p class="fc-verdict" data-verdict>{initial.recomendacion}</p>
          <div class="fc-metrics">
            <div><span>Cuota actual</span><strong data-m1>{money(initial.cuotaActual)}</strong></div>
            <div><span>Cuota nueva</span><strong data-m2>{money(initial.cuotaNueva)}</strong></div>
            <div><span>Ahorro mensual</span><strong data-m3>{money(initial.ahorroMensual)}</strong></div>
            <div><span>Punto de equilibrio</span><strong data-m4>{initial.puntoEquilibrioMeses ? `${initial.puntoEquilibrioMeses} meses` : 'No aplica'}</strong></div>
          </div>
          <div class="fc-cost-bars">
            <div><span>Seguir como estoy <b data-before>{money(initial.costoTotalActual)}</b></span><i><u data-bar1 style="width:100%"></u></i></div>
            <div><span>Refinanciar <b data-after>{money(initial.costoTotalNuevo)}</b></span><i><u data-bar2 style={`width:${Math.min(100, initial.costoTotalNuevo / initial.costoTotalActual * 100)}%`}></u></i></div>
          </div>
          <div class="fc-insight" data-insight>{plain(initial._insight?.text)}</div>
          <button class="fc-copy" type="button" data-copy>⧉ Copiar comparación</button>
        </section>
      </form>
    </>
  )}
</div>

<script>
  import { tiempoParaAhorrar } from '../lib/formulas/tiempo-para-ahorrar';
  import { cancelacionAnticipadaPrestamo } from '../lib/formulas/cancelacion-anticipada-prestamo';
  import { refinanciacionPrestamo } from '../lib/formulas/refinanciacion-prestamo';

  const fmtMoney = (n: number) => '$' + Math.round(n).toLocaleString('es-AR');
  const plain = (s: string) => s.replace(/\*\*/g, '');
  const setText = (root: Element, selector: string, value: unknown) => { const el = root.querySelector(selector); if (el) el.textContent = String(value); };
  const getNumber = (form: HTMLFormElement, name: string) => Number((form.elements.namedItem(name) as HTMLInputElement)?.value || 0);
  const track = (root: HTMLElement, type: string) => {
    const w = window as any;
    w.hcTrack?.(type, { calculator_slug: root.dataset.slug, calculator_category: 'finanzas', country: 'AR' });
    if (type === 'hc_calculator_success') {
      if (typeof w.gtag === 'function') w.gtag('event', 'calculator_used', { calc_slug: root.dataset.slug, formula_id: root.dataset.formula, value: 1, currency: 'ARS' });
      else { w.dataLayer = w.dataLayer || []; w.dataLayer.push({ event: 'calculator_used', calc_slug: root.dataset.slug, formula_id: root.dataset.formula, value: 1, currency: 'ARS' }); }
    }
  };

  document.querySelectorAll<HTMLElement>('[data-fcluster]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const error = root.querySelector<HTMLElement>('[data-error]')!;
    const kind = root.dataset.fcluster;
    let lastSummary = '';

    const run = (shouldTrack = true) => {
      error.hidden = true;
      try {
        if (kind === 'ahorro') {
          const frequency = (form.querySelector<HTMLInputElement>('input[name="frecuencia"]:checked')?.value || 'mensual') as 'semanal'|'quincenal'|'mensual';
          const r = tiempoParaAhorrar({ meta:getNumber(form,'meta'), ahorroInicial:getNumber(form,'ahorroInicial'), aporte:getNumber(form,'aporte'), frecuencia:frequency, tasaAnual:getNumber(form,'tasaAnual'), inflacionAnual:getNumber(form,'inflacionAnual') });
          setText(root,'[data-primary]',r.mesesNecesarios); setText(root,'[data-verdict]',r.detalle);
          setText(root,'[data-m1]',r.fechaEstimada); setText(root,'[data-m2]',fmtMoney(r.totalAportado)); setText(root,'[data-m3]',fmtMoney(r.interesesGanados)); setText(root,'[data-m4]',fmtMoney(r.valorReal));
          const share = r.totalAportado / Math.max(1, r.totalAportado + r.interesesGanados) * 100;
          const bar = root.querySelector<HTMLElement>('[data-bar]'); if (bar) bar.style.width = Math.min(100, share) + '%';
          setText(root,'[data-insight]',plain(r._insight?.text || ''));
          const tbody = root.querySelector('[data-table]'); if (tbody) tbody.innerHTML = (r._table?.rows || []).slice(-6).map((row:any[]) => '<tr>'+row.map((cell:any)=>'<td>'+String(cell)+'</td>').join('')+'</tr>').join('');
          lastSummary = `Meta de ${fmtMoney(getNumber(form,'meta'))}: ${r.mesesNecesarios} meses, fecha estimada ${r.fechaEstimada}, con ${fmtMoney(r.totalAportado)} aportados y ${fmtMoney(r.interesesGanados)} de rendimiento estimado.`;
        } else if (kind === 'cancelacion') {
          const strategy = (form.querySelector<HTMLInputElement>('input[name="estrategia"]:checked')?.value || 'plazo') as 'plazo'|'cuota';
          const r = cancelacionAnticipadaPrestamo({ saldoPendiente:getNumber(form,'saldoPendiente'), tna:getNumber(form,'tna'), cuotasRestantes:getNumber(form,'cuotasRestantes'), pagoAnticipado:getNumber(form,'pagoAnticipado'), comisionPorcentaje:getNumber(form,'comisionPorcentaje'), estrategia:strategy, tasaAlternativa:getNumber(form,'tasaAlternativa') });
          setText(root,'[data-primary]',fmtMoney(r.beneficioNeto)); setText(root,'[data-verdict]',r.detalle); setText(root,'[data-m1]',fmtMoney(r.interesesAhorrados)); setText(root,'[data-m2]',r.mesesAhorrados); setText(root,'[data-m3]',fmtMoney(r.cuotaActual)); setText(root,'[data-m4]',r.cuotaNueva ? fmtMoney(r.cuotaNueva) : 'Cancelado'); setText(root,'[data-before]',fmtMoney(r.cuotaActual)); setText(root,'[data-after]',r.cuotaNueva ? fmtMoney(r.cuotaNueva) : 'Deuda cancelada'); setText(root,'[data-insight]',plain(r._insight?.text || ''));
          lastSummary = `Pago anticipado: beneficio neto estimado ${fmtMoney(r.beneficioNeto)}, intereses evitados ${fmtMoney(r.interesesAhorrados)} y ${r.mesesAhorrados} meses menos.`;
        } else {
          const r = refinanciacionPrestamo({ saldoActual:getNumber(form,'saldoActual'), tasaActual:getNumber(form,'tasaActual'), mesesActuales:getNumber(form,'mesesActuales'), tasaNueva:getNumber(form,'tasaNueva'), mesesNuevos:getNumber(form,'mesesNuevos'), gastosNuevo:getNumber(form,'gastosNuevo'), costoCancelacion:getNumber(form,'costoCancelacion') });
          setText(root,'[data-primary]',fmtMoney(r.ahorroTotal)); setText(root,'[data-verdict]',r.recomendacion); setText(root,'[data-m1]',fmtMoney(r.cuotaActual)); setText(root,'[data-m2]',fmtMoney(r.cuotaNueva)); setText(root,'[data-m3]',fmtMoney(r.ahorroMensual)); setText(root,'[data-m4]',r.puntoEquilibrioMeses ? r.puntoEquilibrioMeses+' meses' : 'No aplica'); setText(root,'[data-before]',fmtMoney(r.costoTotalActual)); setText(root,'[data-after]',fmtMoney(r.costoTotalNuevo)); setText(root,'[data-insight]',plain(r._insight?.text || ''));
          const max = Math.max(r.costoTotalActual,r.costoTotalNuevo,1); const b1=root.querySelector<HTMLElement>('[data-bar1]'); const b2=root.querySelector<HTMLElement>('[data-bar2]'); if(b1)b1.style.width=(r.costoTotalActual/max*100)+'%'; if(b2)b2.style.width=(r.costoTotalNuevo/max*100)+'%';
          const status=root.querySelector<HTMLElement>('[data-status]'); if(status){status.textContent=r.ahorroTotal>0?'Conviene':'No conviene';status.classList.toggle('bad',r.ahorroTotal<=0);}
          lastSummary = `Refinanciación: diferencia total ${fmtMoney(r.ahorroTotal)}, cuota actual ${fmtMoney(r.cuotaActual)} y cuota nueva ${fmtMoney(r.cuotaNueva)}.`;
        }
        if (shouldTrack) track(root,'hc_calculator_success');
      } catch (e) {
        error.textContent = e instanceof Error ? e.message : 'Revisá los datos ingresados.'; error.hidden = false; if (shouldTrack) track(root,'hc_calculator_validation_error');
      }
    };

    form.addEventListener('submit',(event)=>{event.preventDefault();run();});
    form.addEventListener('input',()=>track(root,'hc_calculator_input_started'),{once:true});
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button)=>button.addEventListener('click',()=>{
      const presets:any={viaje:{meta:2500000,ahorroInicial:250000,aporte:120000,tasaAnual:0,inflacionAnual:0},auto:{meta:8000000,ahorroInicial:1500000,aporte:300000,tasaAnual:20,inflacionAnual:15},fondo:{meta:4500000,ahorroInicial:500000,aporte:250000,tasaAnual:0,inflacionAnual:0}}; const p=presets[button.dataset.preset||'viaje']; Object.entries(p).forEach(([key,value])=>{const el=form.elements.namedItem(key) as HTMLInputElement;if(el)el.value=String(value);}); run();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button)=>button.addEventListener('click',()=>{const share=Number(button.dataset.share);const saldo=getNumber(form,'saldoPendiente');(form.elements.namedItem('pagoAnticipado') as HTMLInputElement).value=String(saldo*share/100);root.querySelectorAll('[data-share]').forEach(x=>x.classList.toggle('active',x===button));setText(root,'[data-share-status]',share+'% cargado');run();}));
    root.querySelectorAll<HTMLButtonElement>('[data-refi]').forEach((button)=>button.addEventListener('click',()=>{const key=button.dataset.refi;const values:any=key==='rate'?{tasaNueva:55,mesesNuevos:24,gastosNuevo:100000}:key==='payment'?{tasaNueva:55,mesesNuevos:36,gastosNuevo:100000}:{tasaNueva:55,mesesNuevos:24,gastosNuevo:750000};Object.entries(values).forEach(([name,value])=>{const el=form.elements.namedItem(name) as HTMLInputElement;if(el)el.value=String(value);});root.querySelectorAll('[data-refi]').forEach(x=>x.classList.toggle('active',x===button));run();}));
    root.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click',async(event)=>{if(!lastSummary)run(false);try{await navigator.clipboard.writeText(lastSummary);(event.currentTarget as HTMLButtonElement).textContent='✓ Resumen copiado';track(root,'hc_result_copy');setTimeout(()=>{(event.currentTarget as HTMLButtonElement).textContent=kind==='ahorro'?'⧉ Copiar resumen':'⧉ Copiar comparación';},1800);}catch{}});
    run(false);
  });
</script>

