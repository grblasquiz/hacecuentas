<script is:inline>
  (function () {
    const root = document.querySelector('.td');
    if (!root) return;
    const FACTORES = JSON.parse(root.getAttribute('data-factores'));
    const LABELS = JSON.parse(root.getAttribute('data-labels'));
    const PISO = JSON.parse(root.getAttribute('data-piso'));

    /* @pure-start — espejo EXACTO de src/lib/formulas/calorias-tdee.ts */
    function compute(peso, altura, edad, sexo, actividad, FAC, PIS) {
      let bmr;
      if (sexo === 'femenino') bmr = 10 * peso + 6.25 * altura - 5 * edad - 161;
      else bmr = 10 * peso + 6.25 * altura - 5 * edad + 5;
      const factor = FAC[actividad] !== undefined ? FAC[actividad] : FAC.moderado;
      const tdee = bmr * factor;
      const tdeeR = Math.round(tdee);
      const bmrR = Math.round(bmr);
      const pisoBajar = sexo === 'femenino' ? PIS.femenino : PIS.masculino;
      const bajarRaw = tdee - 500;
      const bajarClamped = bajarRaw < pisoBajar;
      const bajarR = Math.round(Math.max(bajarRaw, pisoBajar));
      const subirR = Math.round(tdee + 500);
      return { bmr: bmrR, tdee: tdeeR, bajar: bajarR, subir: subirR, factor: factor, clamped: bajarClamped, piso: pisoBajar };
    }
    /* @pure-end */

    const $ = (id) => document.getElementById(id);
    const nf = (n) => Math.round(n).toLocaleString('es-AR');
    const n2 = (n) => n.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 3 });
    let sexo = 'masculino';

    function state() {
      return {
        peso: Number($('td-peso').value) || 0,
        altura: Number($('td-altura').value) || 0,
        edad: Number($('td-edad').value) || 0,
        sexo: sexo,
        actividad: $('td-actividad').value,
      };
    }

    function render() {
      const s = state();
      if (!s.peso || !s.altura || !s.edad) return;
      const r = compute(s.peso, s.altura, s.edad, s.sexo, s.actividad, FACTORES, PISO);
      const actKcal = r.tdee - r.bmr;
      const pctBmr = r.tdee > 0 ? (r.bmr / r.tdee) * 100 : 0;
      const cte = s.sexo === 'femenino' ? '− 161' : '+ 5';
      const sexoTxt = s.sexo === 'femenino' ? 'Una mujer' : 'Un hombre';

      $('td-big').textContent = nf(r.tdee);
      $('td-sub').textContent = 'kcal/día para mantener tu peso · ' + LABELS[s.actividad];
      $('td-t-bmr').textContent = nf(r.bmr);
      $('td-t-factor').textContent = '×' + n2(r.factor);
      $('td-t-bajar').textContent = nf(r.bajar);
      $('td-t-subir').textContent = nf(r.subir);
      $('td-formula').textContent = 'BMR = 10×' + s.peso + ' + 6,25×' + s.altura + ' − 5×' + s.edad + ' ' + cte + ' = ' + nf(r.bmr) + ' · TDEE = ' + nf(r.bmr) + ' × ' + n2(r.factor) + ' = ' + nf(r.tdee);

      $('td-piso').hidden = !r.clamped;
      $('td-piso-val').textContent = nf(r.piso) + ' kcal';

      $('td-deco-val').textContent = nf(r.tdee);
      $('td-deco-bmr').textContent = nf(r.bmr) + ' kcal';

      $('td-quick').innerHTML = sexoTxt + ' de ' + s.edad + ' años, ' + nf(s.peso) + ' kg y ' + nf(s.altura) + ' cm con actividad ' + LABELS[s.actividad].toLowerCase() + ' gasta unas <strong>' + nf(r.tdee) + ' kcal/día</strong>. Para bajar ~0,5 kg por semana: <strong>' + nf(r.bajar) + ' kcal</strong>. Para subir: <strong>' + nf(r.subir) + ' kcal</strong>.';

      $('td-k-factor').textContent = n2(r.factor);
      $('td-k-factor-lbl').textContent = LABELS[s.actividad];
      $('td-k-piso').textContent = nf(r.piso);
      $('td-k-piso-sexo').textContent = s.sexo === 'femenino' ? '1.200 kcal en mujeres' : '1.500 kcal en hombres';

      $('td-hl-big').textContent = nf(r.tdee) + ' kcal';

      $('td-b-bmr').textContent = nf(r.bmr) + ' kcal';
      $('td-b-bmr-bar').style.width = pctBmr.toFixed(1) + '%';
      $('td-b-bmr-pct').textContent = Math.round(pctBmr) + '%';
      $('td-b-act').textContent = nf(actKcal) + ' kcal';
      $('td-b-act-bar').style.width = (r.tdee > 0 ? (actKcal / r.tdee) * 100 : 0).toFixed(1) + '%';
      $('td-b-tdee').textContent = nf(r.tdee) + ' kcal';

      $('td-s1').textContent = nf(s.peso) + ' kg · ' + nf(s.altura) + ' cm · ' + s.edad + ' años · ' + LABELS[s.actividad].toLowerCase();
      $('td-s2').textContent = 'BMR ' + nf(r.bmr) + ' × ' + n2(r.factor);
      $('td-s3').textContent = 'TDEE ' + nf(r.tdee) + ' kcal/día';

      $('td-tbody').innerHTML = Object.keys(FACTORES).map(function (k) {
        const x = compute(s.peso, s.altura, s.edad, s.sexo, k, FACTORES, PISO);
        return '<tr><td>' + LABELS[k] + '</td><td>×' + n2(x.factor) + '</td><td>' + nf(x.tdee) + ' kcal</td><td class="cf-td-em">' + nf(x.bajar) + ' kcal</td></tr>';
      }).join('');
    }

    ['td-peso', 'td-altura', 'td-edad'].forEach((id) => $(id).addEventListener('input', render));
    $('td-actividad').addEventListener('change', render);
    $('td-calc-btn').addEventListener('click', render);
    document.querySelectorAll('[data-sexo]').forEach((b) => b.addEventListener('click', () => {
      sexo = b.getAttribute('data-sexo');
      document.querySelectorAll('[data-sexo]').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
      render();
    }));
    document.querySelectorAll('[data-ej]').forEach((b) => b.addEventListener('click', () => {
      const v = b.getAttribute('data-ej').split('|');
      const sb = document.querySelector('[data-sexo="' + v[0] + '"]');
      if (sb) { sexo = v[0]; document.querySelectorAll('[data-sexo]').forEach((x) => x.setAttribute('aria-pressed', x === sb ? 'true' : 'false')); }
      $('td-peso').value = v[1]; $('td-altura').value = v[2]; $('td-edad').value = v[3]; $('td-actividad').value = v[4];
      render();
    }));

    function summary() {
      const s = state();
      const r = compute(s.peso, s.altura, s.edad, s.sexo, s.actividad, FACTORES, PISO);
      return 'TDEE: ' + nf(r.tdee) + ' kcal/día (BMR ' + nf(r.bmr) + ' × ' + n2(r.factor) + ', ' + LABELS[s.actividad] + '). Bajar ~0,5 kg/sem: ' + nf(r.bajar) + ' kcal. Subir: ' + nf(r.subir) + ' kcal. Orientativo: no reemplaza la consulta médica. — hacecuentas.com';
    }
    function shareUrl() {
      const s = state();
      return location.origin + location.pathname + '?peso=' + s.peso + '&altura=' + s.altura + '&edad=' + s.edad + '&sexo=' + s.sexo + '&actividad=' + s.actividad;
    }
    function copy(t, btn) { navigator.clipboard?.writeText(t).then(() => { const o = btn.innerHTML; btn.innerHTML = '✓ Copiado'; setTimeout(() => btn.innerHTML = o, 1500); }); }
    $('td-copy').addEventListener('click', (e) => copy(summary(), e.currentTarget));
    $('td-detail').addEventListener('click', () => { document.getElementById('como-funciona')?.scrollIntoView({ behavior: 'smooth' }); });
    const s2 = $('td-share2'); if (s2) s2.addEventListener('click', (e) => copy(shareUrl(), e.currentTarget));

    const q = new URLSearchParams(location.search);
    if (q.get('peso')) $('td-peso').value = q.get('peso');
    if (q.get('altura')) $('td-altura').value = q.get('altura');
    if (q.get('edad')) $('td-edad').value = q.get('edad');
    if (q.get('actividad')) $('td-actividad').value = q.get('actividad');
    if (q.get('sexo')) { const b = document.querySelector('[data-sexo="' + q.get('sexo') + '"]'); if (b) b.click(); }
    render();
  })();
</script>

