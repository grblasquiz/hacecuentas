---
// Tablas de referencia server-side (info-gain crawleable). Usado por los routes
// de calcs por locale (/en, /pt, /cl, …). El route AR root y glosario/comparar
// renderizan su propia versión inline.
interface Props { tables?: any[] }
const { tables } = Astro.props;
---
{tables && tables.length > 0 && (
  <section class="calc-ref-tables" aria-label="Tablas de referencia">
    {tables.map((tbl: any) => (
      <figure class="calc-ref-table">
        <figcaption class="calc-ref-table-cap">
          <strong>{tbl.title}</strong>
          {tbl.caption && <span>{tbl.caption}</span>}
        </figcaption>
        <div class="calc-ref-table-scroll">
          <table>
            <thead>
              <tr>{tbl.headers.map((h: string) => <th>{h}</th>)}</tr>
            </thead>
            <tbody>
              {tbl.rows.map((row: (string | number)[]) => (
                <tr>{row.map((cell, ci) => (
                  ci === tbl.highlightCol ? <td class="is-highlight">{cell}</td> : <td>{cell}</td>
                ))}</tr>
              ))}
            </tbody>
          </table>
        </div>
        {tbl.note && <p class="calc-ref-table-note">{tbl.note}</p>}
      </figure>
    ))}
  </section>
)}
<style>
  .calc-ref-tables { display: grid; gap: 1.5rem; margin: 1.5rem 0; }
  .calc-ref-table {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius, 8px);
    overflow: hidden;
    background: var(--bg-card, #fff);
  }
  .calc-ref-table-cap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .calc-ref-table-cap strong { font-size: 0.9375rem; color: var(--text); }
  .calc-ref-table-cap span { font-size: 0.8125rem; color: var(--text-subtle); }
  .calc-ref-table-scroll { overflow-x: auto; }
  .calc-ref-table table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .calc-ref-table th,
  .calc-ref-table td {
    padding: 0.55rem 0.85rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .calc-ref-table th {
    background: var(--bg-subtle, var(--accent-soft, #f4f4f5));
    font-weight: 600;
    color: var(--text);
  }
  .calc-ref-table tbody tr:last-child td { border-bottom: none; }
  .calc-ref-table td.is-highlight { font-weight: 600; color: var(--accent-strong, var(--accent)); }
  .calc-ref-table-note {
    margin: 0;
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-subtle);
    border-top: 1px solid var(--border);
  }
</style>
