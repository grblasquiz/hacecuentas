  .i3 .cf-result[data-stale="1"] .cf-tiles { opacity: 0.45; transition: opacity .15s; }
  .i3 .cf-stale-hint { display: none; font-size: 0.72rem; color: #fbbf24; margin: 0.5rem 0 0; }
  .i3 .cf-result[data-stale="1"] .cf-stale-hint { display: block; }

  .i3-2col { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: start; }
  @media (min-width: 900px) { .i3-2col { grid-template-columns: 0.85fr 1.15fr; } }
  .cf-band .i3-2col--band { gap: 1.25rem; }

  .i3 .i3-hl {
    padding: 1.4rem 1.5rem; border-radius: var(--radius-lg); color: #fff;
    background: linear-gradient(150deg, var(--accent) 0%, var(--accent-2) 100%);
    box-shadow: var(--shadow-md);
  }
  .i3 .i3-hl__eyebrow { color: rgba(255,255,255,0.85); }
  .i3 .i3-hl__title { font-size: 1.3rem; font-weight: 800; line-height: 1.2; margin: 0 0 0.6rem; letter-spacing: -0.015em; }
  .i3 .i3-hl__desc { font-size: 0.82rem; line-height: 1.5; margin: 0; color: rgba(255,255,255,0.86); }
  .i3 .i3-hl__big { font-size: 1.9rem; font-weight: 800; margin: 1.1rem 0 0.15rem; color: #fff; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .cf-band .i3-hl__big { font-size: 1.9rem; font-weight: 800; color: #fff; margin: 0.9rem 0 0.4rem; font-variant-numeric: tabular-nums; line-height: 1.1; }

    /* El chip mono es nowrap: sin min-width:0 infla el track del grid
     (min-width:auto en grid items) y mete scroll-x en mobile. */
  .i3 .cf-steps > .cf-step { min-width: 0; }
.i3 .i3-chip {
    display: inline-block; margin: 0.7rem 0 0; padding: 0.35rem 0.6rem; border-radius: var(--radius-sm);
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent-strong);
    background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    overflow-x: auto; max-width: 100%; white-space: nowrap;
  }
  .cf-band .i3-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
  .cf-band .i3-chip--dark { display: inline-block; padding: 0.35rem 0.6rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: #e7ecf3; }

  .cf-band .i3-card { padding: 1.5rem 1.6rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-card); }
  .cf-band .i3-card__title { font-size: 1.35rem; font-weight: 800; color: var(--text); letter-spacing: -0.02em; margin: 0.35rem 0 0.6rem; line-height: 1.2; }
  .cf-band .i3-src { display: grid; gap: 0.5rem; }
  .cf-band .i3-src__title { font-size: 1.15rem; font-weight: 800; color: #fff; margin: 0 0 0.3rem; }
  .cf-band .i3-src__item { padding: 0.7rem 0.85rem; border-radius: var(--radius); background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); }
  .cf-band .i3-src__item strong { display: block; font-size: 0.82rem; font-weight: 700; color: #fff; }
  .cf-band .i3-src__item span { font-size: 0.72rem; color: #8592a6; }
  .cf-band .i3-src__foot { font-size: 0.72rem; color: color-mix(in srgb, var(--accent-2) 60%, #fff); margin: 0.9rem 0 0; }
</style>
