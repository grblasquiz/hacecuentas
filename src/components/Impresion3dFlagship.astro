  .i3 .i3-mt3, .cf-band .i3-mt3 { margin-top: 1.25rem; }
  .i3 .i3-h2, .cf-band .i3-h2 { margin: 0.35rem 0 1.25rem; }
  .i3 .i3-help { margin: 0 0 1rem; }
  .i3 .i3-note { font-size: 0.72rem; color: var(--text-subtle); margin: 0.15rem 0 0; font-family: var(--font-mono); }
  .i3 .i3-tnote { font-size: 0.78rem; color: var(--text-subtle); margin: 0.75rem 0 0; }
  .i3 .i3-td-nota { display: block; font-size: 0.72rem; color: var(--text-subtle); padding-left: 1.15rem; }
  .i3 .i3-bar--alt { background: linear-gradient(90deg, #f59e0b, #fb923c) !important; }

