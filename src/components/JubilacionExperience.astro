---
import type { HubData } from '../lib/hubs/types';
interface Props { data: HubData; minimo: number; maximo: number; bono: number; pbu: number; coefAnual: number; topeAnios: number; }
const { data, minimo, maximo, bono, pbu, coefAnual, topeAnios } = Astro.props;
const ars = (n:number) => '$' + Math.round(n).toLocaleString('es-AR');
---
<main class="ret" id="main">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="intro">
        <nav aria-label="Migas de pan"><a href="/jubilacion">Jubilación</a><span>/</span><span>Cuánto voy a cobrar</span></nav>
        <h1>Estimá cuánto<br>vas a cobrar de<br>jubilación</h1>
        <p>Calculamos tu haber según tus aportes y remuneraciones, con el mínimo y la movilidad vigentes.</p>
        <div class="trust">
          <span><i><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg></i>Datos privados</span>
          <span><i><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.3 8.5-8 10-4.7-1.5-8-5-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></i>Basado en<br>Ley 24.241</span>
          <span><i><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18M8 14h.01m4 0h.01m4 0h.01"/></svg></i>Actualizado<br>julio 2026</span>
        </div>
        <img class="hero-art" src="/images/jubilacion/planificacion-jubilacion-v2.png" width="1536" height="1024" alt="Pareja planificando su jubilación" loading="eager">
      </div>

      <form class="calculator" id="ret-form">
        <h2>Tu historia laboral</h2>
        <fieldset><legend>¿Cuál es tu régimen?</legend>
          <div class="regimes">
            <label class="active"><input type="radio" name="regime" value="general" checked><b class="check"><svg viewBox="0 0 20 20"><path d="m5 10 3.2 3.2L15 6.7"/></svg></b><svg viewBox="0 0 48 48"><circle cx="18" cy="16" r="7"/><circle cx="33" cy="18" r="6"/><path d="M5 39v-4c0-7 5.8-12 13-12s13 5 13 12v4M29 26c7 0 13 4 13 11v2"/></svg><strong>ANSES ·<br>Régimen general</strong></label>
            <label><input type="radio" name="regime" value="docente"><svg viewBox="0 0 48 48"><circle cx="24" cy="15" r="8"/><path d="M11 41v-5c0-8 5.8-13 13-13s13 5 13 13v5M15 13l9-6 9 6M18 27l6 7 6-7"/></svg><strong>Docente</strong></label>
            <label><input type="radio" name="regime" value="otro"><svg viewBox="0 0 48 48"><rect x="7" y="14" width="34" height="27" rx="4"/><path d="M17 14V9h14v5M7 25h34M20 22h8v6h-8z"/></svg><strong>Otro</strong></label>
          </div>
        </fieldset>
        <div class="fields">
          <label><span>Promedio de remuneraciones<br>actualizadas <i title="Promedio actualizado de los últimos 10 años">i</i></span><div class="money"><b>$</b><input id="salary" value="1.200.000" inputmode="numeric" aria-label="Promedio de remuneraciones actualizadas"></div></label>
          <label><span>Años de aportes <i title="Años reconocidos por ANSES">i</i></span><select id="years" aria-label="Años de aportes">{Array.from({length:31},(_,i)=>20+i).map(y=><option value={y} selected={y===30}>{y} años</option>)}</select></label>
        </div>
        <button class="advanced-toggle" type="button" aria-expanded="false"><span>Agregar aportes anteriores a 1994 <em>(opcional)</em></span><svg viewBox="0 0 24 24"><path d="m7 9 5 5 5-5"/></svg></button>
        <div class="advanced" hidden><label>Años anteriores a 1994 <input id="before" type="number" min="0" max="35" value="0"></label><small>Forman la prestación compensatoria.</small></div>
        <button class="submit" type="submit">Estimar mi jubilación</button>
        <p class="privacy"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Tus datos no se guardan ni se comparten.</p>
      </form>
    </div>
  </section>

  <section class="results-section"><div class="shell results" aria-live="polite">
    <div class="summary"><span>Tu jubilación estimada</span><strong id="total">$862.450</strong><b>por mes</b><div class="rate"><svg viewBox="0 0 24 24"><path d="m4 17 5-5 4 4 7-9M16 7h4v4"/></svg><span id="rate">72% de tu sueldo promedio</span></div><p>Incluye haber + bono vigente</p><div class="pocket"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 16 3-7 5-2-3 7-5 2Z"/></svg>Estimación orientativa<br>de bolsillo</div></div>
    <div class="breakdown"><h2>Cómo se forma tu haber</h2>
      <div class="bar"><span id="pbu-bar">18%</span><span id="pc-bar">0%</span><span id="pap-bar">74%</span><span id="bonus-bar">8%</span></div>
      <div class="legend"><span><i></i><b>PBU</b><small id="pbu">{ars(pbu)}</small></span><span><i></i><b>Compensatoria</b><small id="pc">$0</small></span><span><i></i><b>PAP</b><small id="pap">$633.750</small></span><span><i></i><b>Bono</b><small id="bonus">{ars(bono)}</small></span></div>
      <div class="metrics">
        <article><svg viewBox="0 0 48 48"><path d="M6 39h36M10 18h28M7 18 24 7l17 11M12 21v14m8-14v14m8-14v14m8-14v14"/></svg><b>Haber base</b><strong id="base">$792.450</strong></article>
        <article><svg class="green" viewBox="0 0 48 48"><path d="M7 15h34v25H7zM7 21h34M31 30h6M12 15l22-8v8"/></svg><b>Con bono</b><strong class="green" id="with-bonus">$862.450</strong></article>
        <article><svg class="amber" viewBox="0 0 48 48"><rect x="7" y="18" width="34" height="24" rx="3"/><path d="M24 18v24M7 26h34M24 18c-9 0-12-4-10-8 3-5 10 1 10 8Zm0 0c9 0 12-4 10-8-3-5-10 1-10 8Z"/></svg><b>Aguinaldo estimado</b><strong id="sac">$396.225</strong></article>
      </div>
      <p class="note"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M10 9v5M10 6.2v.3"/></svg> El bono no integra el haber ni genera aguinaldo.</p>
    </div>
  </div></section>

  <section class="gap shell">
    <img src="/images/jubilacion/retiro-planificado.png" width="1806" height="871" alt="Retiro tranquilo frente al mar" loading="lazy">
    <div class="gap-content"><h2>¿Te alcanza para el retiro que imaginás?</h2><div class="gap-row">
      <label><span>Quiero disponer de</span><div><b>$</b><input id="goal" value="1.200.000" inputmode="numeric"></div><small>por mes</small></label>
      <section><span>Te faltarían</span><strong id="gap">$337.550</strong><small>mensuales</small></section>
      <aside><button type="button">Calcular cuánto ahorrar</button><p>Te mostramos cuánto y cómo ahorrar<br>para alcanzar tu objetivo.</p></aside>
    </div></div>
  </section>

  <section class="learn shell"><h2>Entendé tu jubilación</h2><div>
    <article><i><svg viewBox="0 0 48 48"><path d="M6 40h36M9 18h30M6 18 24 6l18 12M12 21v15m8-15v15m8-15v15m8-15v15"/></svg></i><section><h3>Qué es la PBU</h3><p>Es el monto mínimo garantizado por el Estado. Se actualiza todos los meses por movilidad.</p><a href="#details">Saber más →</a></section></article>
    <article><i><svg viewBox="0 0 48 48"><rect x="11" y="8" width="27" height="34" rx="3"/><path d="M18 8V5h13v3M17 17h4m5 0h7M17 24h4m5 0h7M17 31h4m5 0h7"/></svg></i><section><h3>Cómo cuentan tus aportes</h3><p>Se toman tus mejores 120 meses actualizados y los años totales de aportes.</p><a href="#details">Saber más →</a></section></article>
    <article><i><svg viewBox="0 0 48 48"><path d="M8 39h34M12 35V24h7v11M23 35V17h7v18M34 35V9h7v26M10 17l10-6 7 3L40 5"/></svg></i><section><h3>Qué cambia todos los meses</h3><p>La movilidad ajusta tu haber según la inflación y la evolución de los salarios.</p><a href="#details">Saber más →</a></section></article>
  </div></section>
  <section class="timeline shell">
    <article><i><svg viewBox="0 0 48 48"><rect x="8" y="10" width="32" height="30" rx="5"/><path d="M15 6v8m18-8v8M8 19h32M16 27h.01m8 0h.01m8 0h.01"/></svg></i><span><b>Hoy</b><small>Estás construyendo<br>tu futuro.</small></span></article><hr>
    <article><i><svg viewBox="0 0 48 48"><circle cx="24" cy="14" r="7"/><path d="M11 42v-5c0-8 5.8-14 13-14s13 6 13 14v5"/></svg></i><span><b>Te faltan 15 años</b><small>Seguí aportando para<br>mejorar tu haber.</small></span></article><hr>
    <article><i><svg viewBox="0 0 48 48"><path d="M7 37h34M10 34a14 14 0 0 1 28 0M24 8v6M11 15l4 4M37 15l-4 4"/></svg></i><span><b>Jubilación</b><small>Disfrutá tu tiempo con la<br>tranquilidad que buscás.</small></span></article>
  </section>
  <section class="details shell" id="details"><span>Tu resultado, explicado</span><h2>El haber se construye con tus aportes y las reglas vigentes</h2><p>La estimación combina la Prestación Básica Universal, los aportes anteriores y posteriores a 1994, el piso mínimo y el bono vigente. ANSES determina el monto definitivo con tu historia laboral completa.</p></section>
  <section class="faq shell"><h2>Preguntas frecuentes</h2>{data.faq.map((f,i)=><details open={i===0}><summary>{f.q}<b>+</b></summary><p set:html={f.a}/></details>)}</section>
  <section class="sources shell"><h2>Fuentes oficiales</h2><div>{data.sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer"><b>{s.name}</b><span>{s.publisher}{s.date?` · ${s.date}`:''}</span></a>)}</div></section>
</main>

<script define:vars={{minimo,maximo,bono,pbu,coefAnual,topeAnios}}>
  const parse=(v)=>Number(String(v||'').replace(/[^\d]/g,''))||0, fmt=(v)=>'$'+Math.round(v).toLocaleString('es-AR');
  const $=(s)=>document.querySelector(s), salary=$('#salary'), years=$('#years'), before=$('#before'), goal=$('#goal');
  function render(){
    const sal=parse(salary.value), yrs=Math.min(topeAnios,Number(years.value)||0), bef=Math.min(yrs,Number(before.value)||0), aft=yrs-bef;
    const regime=document.querySelector('input[name=regime]:checked')?.value||'general';
    let pc=coefAnual*bef*sal,pap=coefAnual*aft*sal,base=pbu+pc+pap;
    if(regime==='docente'){base=sal*.82;pc=0;pap=Math.max(0,base-pbu)} if(regime==='otro'){base=minimo;pc=0;pap=Math.max(0,base-pbu)}
    base=Math.max(minimo,Math.min(maximo,base)); const bon=base<=minimo?bono:0,total=base+bon, vals=[pbu,pc,pap,bon],sum=vals.reduce((a,b)=>a+b,0)||1;
    ['#pbu-bar','#pc-bar','#pap-bar','#bonus-bar'].forEach((id,i)=>{const e=$(id),pct=vals[i]/sum*100;e.style.width=(vals[i]?Math.max(4,pct):0)+'%';e.textContent=Math.round(pct)+'%'});
    $('#total').textContent=fmt(total);$('#rate').textContent=Math.round(total/Math.max(1,sal)*100)+'% de tu sueldo promedio';$('#pbu').textContent=fmt(pbu);$('#pc').textContent=fmt(pc);$('#pap').textContent=fmt(pap);$('#bonus').textContent=fmt(bon);$('#base').textContent=fmt(base);$('#with-bonus').textContent=fmt(total);$('#sac').textContent=fmt(base/2);$('#gap').textContent=fmt(Math.max(0,parse(goal.value)-total));
  }
  [salary,goal].forEach(e=>e.addEventListener('input',()=>{const n=parse(e.value);e.value=n?n.toLocaleString('es-AR'):'';render()}));[years,before].forEach(e=>e.addEventListener('input',render));
  document.querySelectorAll('input[name=regime]').forEach(e=>e.addEventListener('change',()=>{document.querySelectorAll('.regimes label').forEach(l=>l.classList.toggle('active',l.contains(e)));render()}));
  $('.advanced-toggle').addEventListener('click',e=>{const b=e.currentTarget,o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));$('.advanced').hidden=o});
  $('#ret-form').addEventListener('submit',e=>{e.preventDefault();render();$('.results').scrollIntoView({behavior:'smooth',block:'center'})});render();
</script>

<style>
  :global(body){background:#fff}.ret{--navy:#082b57;--blue:#1769ff;--green:#159667;--amber:#f5a000;color:#0a2a53;font-family:Inter,system-ui,sans-serif}.shell{width:min(1240px,calc(100% - 48px));margin:auto}.hero{padding:58px 0 85px;background:linear-gradient(120deg,#fff 0 65%,#f6faff);overflow:hidden}.hero-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:62px}.intro nav{display:flex;gap:12px;color:#738196;font-size:14px;margin:6px 0 28px}.intro nav a{color:var(--blue);font-weight:700;text-decoration:none}.intro h1{font-size:clamp(48px,4.6vw,68px);line-height:1.04;letter-spacing:-.052em;margin:0 0 22px}.intro>p{font-size:18px;line-height:1.6;color:#475b73;max-width:510px}.trust{display:flex;gap:9px;margin-top:25px}.trust span{display:flex;align-items:center;gap:8px;border:1px solid #dce3eb;border-radius:8px;padding:9px 11px;font-size:11px;background:#fff}.trust i{display:grid;width:24px}.trust svg,.privacy svg{fill:none;stroke:currentColor;stroke-width:1.7}.hero-art{display:block;width:112%;height:auto;margin:10px 0 -88px -9%;mix-blend-mode:multiply}
  .calculator{background:#fff;border:1px solid #e0e5eb;border-radius:18px;padding:38px 40px 29px;box-shadow:0 15px 44px #102c4c1f}.calculator h2{font-size:27px;margin:0 0 22px}.calculator fieldset{border:0;padding:0}.calculator legend{font-size:14px;margin-bottom:10px}.regimes{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:10px}.regimes label{position:relative;min-height:120px;border:1.5px solid #d8dfe8;border-radius:11px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;cursor:pointer}.regimes label.active{border-color:var(--blue);box-shadow:inset 0 0 0 1px var(--blue);background:#f8fbff}.regimes input{position:absolute;opacity:0}.regimes svg{width:42px;height:42px;fill:none;stroke:currentColor;stroke-width:1.7}.regimes strong{font-size:13px}.check{display:none;position:absolute;top:9px;left:9px;width:20px;height:20px;border-radius:50%;background:var(--blue);color:#fff}.check svg{width:14px;height:14px;stroke-width:2.3}.active .check{display:grid;place-items:center}.fields{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;margin-top:26px}.fields label>span{display:block;min-height:38px;font-size:13px}.fields i{display:inline-grid;place-items:center;width:15px;height:15px;border:1px solid;border-radius:50%;font-style:normal;font-size:9px}.money,.fields select{height:58px;border:1.5px solid #d7dee7;border-radius:9px}.money{display:flex;align-items:center}.money b{padding-left:16px}.money input{width:100%;border:0;outline:0;padding:0 12px;font-size:18px}.fields select{width:100%;padding:0 13px;background:#fff;color:inherit;font-size:16px}.advanced-toggle{width:100%;display:flex;justify-content:space-between;align-items:center;margin-top:24px;padding:17px 15px;border:1px solid #dbe2e9;border-radius:9px;background:#fff;color:inherit;cursor:pointer}.advanced-toggle em{font-style:normal;color:#6d7d90}.advanced-toggle svg{width:20px;fill:none;stroke:currentColor;stroke-width:1.8}.advanced{margin-top:10px;padding:16px;background:#f5f8fc;border-radius:9px}.advanced[hidden]{display:none}.advanced input{margin-left:10px;width:70px;padding:8px}.advanced small{display:block;margin-top:8px;color:#66788c}.submit{width:100%;border:0;border-radius:9px;background:var(--blue);color:#fff;font-size:19px;font-weight:700;padding:19px;margin-top:25px;cursor:pointer;box-shadow:0 10px 22px #1769ff38}.privacy{display:flex;align-items:center;justify-content:center;gap:8px;color:#67788b;font-size:11px}.privacy svg{width:16px}
  .results-section{padding-bottom:38px}.results{display:grid;grid-template-columns:330px 1fr;border:1px solid #dfe5ec;border-radius:17px;box-shadow:0 12px 35px #0c274617;padding:38px 36px 0}.summary{padding:0 36px 25px 4px;border-right:1px solid #dce3ea}.summary>span{font-weight:750}.summary>strong{display:block;color:var(--green);font-size:54px;letter-spacing:-.045em;margin-top:20px}.summary>b{display:block;color:var(--green);margin:3px 0 17px}.rate{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--green);color:var(--green);border-radius:99px;padding:7px 12px;font-size:13px;font-weight:700}.rate svg{width:19px;fill:none;stroke:currentColor;stroke-width:1.8}.summary>p{font-size:13px;color:#596b7e}.pocket{display:flex;align-items:center;gap:12px;border:1px solid #f0c06a;background:#fffaf0;border-radius:9px;padding:13px;margin-top:34px;font-size:12px}.pocket svg{width:34px;fill:none;stroke:var(--amber);stroke-width:1.7}.breakdown{padding-left:37px}.breakdown h2{font-size:18px;margin:0 0 24px}.bar{display:flex;height:40px;border-radius:7px;overflow:hidden;color:#fff;font-size:11px;font-weight:800}.bar span{display:grid;place-items:center}.bar span:nth-child(1){background:#082f61}.bar span:nth-child(2){background:#adb8c4}.bar span:nth-child(3){background:#176cff}.bar span:nth-child(4){background:#f5a000}.legend{display:grid;grid-template-columns:repeat(4,1fr);margin:14px 0 28px}.legend span{display:grid;grid-template-columns:12px 1fr;gap:5px 7px}.legend i{width:11px;height:11px;border-radius:50%;background:#082f61}.legend span:nth-child(2) i{background:#adb8c4}.legend span:nth-child(3) i{background:#176cff}.legend span:nth-child(4) i{background:#f5a000}.legend b{font-size:11px}.legend small{grid-column:2;font-size:10px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.metrics article{display:grid;justify-items:center;gap:6px;border:1px solid #dde3ea;border-radius:10px;padding:16px 8px;text-align:center}.metrics svg{width:36px;fill:none;stroke:var(--blue);stroke-width:1.7}.metrics b{font-size:11px}.metrics strong{font-size:18px}.green{color:var(--green)!important;stroke:var(--green)!important}.amber{stroke:var(--amber)!important}.note{display:flex;align-items:center;gap:5px;font-size:11px;color:#627487}.note svg{flex:0 0 auto;width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.6}
  .gap{height:230px;border:1px solid #bcd8ff;border-radius:16px;overflow:hidden;position:relative;background:#eef6ff}.gap>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.gap-content{position:relative;margin-left:31%;padding:34px 30px}.gap h2{font-size:23px;margin:0 0 23px}.gap-row{display:grid;grid-template-columns:1fr 1fr 1.45fr;gap:22px;align-items:end}.gap-row label,.gap-row section{display:grid;justify-items:center;gap:6px;font-size:11px}.gap-row label div{display:flex;align-items:center;width:145px;height:43px;background:#fff;border:1px solid #d7e0eb;border-radius:8px;padding:0 10px}.gap-row input{width:100%;border:0;outline:0;padding-left:7px}.gap-row small{font-size:10px}.gap-row section{border-inline:1px solid #c8d5e3}.gap-row section strong{font-size:24px;color:var(--amber)}.gap-row button{width:100%;border:0;border-radius:8px;background:var(--blue);color:#fff;padding:14px;font-weight:700}.gap-row aside p{font-size:10px;color:#54687d}.learn{padding:50px 0 34px}.learn>h2,.faq>h2,.sources>h2{font-size:30px}.learn>div{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.learn article{display:flex;gap:14px;border:1px solid #dfe5ec;border-radius:13px;padding:24px 19px}.learn article>i{display:grid;place-items:center;flex:0 0 54px;height:54px;border-radius:50%;background:#eaf2ff}.learn svg{width:31px;fill:none;stroke:#145fc7;stroke-width:1.7}.learn h3{font-size:14px}.learn p{font-size:11px;line-height:1.55;color:#5c6f83}.learn a{font-size:11px;color:var(--blue);font-weight:700}.timeline{border:1px solid #dfe5ec;border-radius:14px;padding:23px 27px;display:grid;grid-template-columns:1fr 70px 1fr 70px 1fr;align-items:center}.timeline article{display:flex;align-items:center;gap:13px}.timeline article>i{display:grid;place-items:center;width:56px;height:56px;border:1px solid #8190a1;border-radius:50%}.timeline svg{width:34px;fill:none;stroke:var(--navy);stroke-width:1.6}.timeline article span{display:grid;gap:5px}.timeline b{font-size:12px