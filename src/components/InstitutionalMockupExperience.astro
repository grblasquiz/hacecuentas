---
import type { InstitutionalJourney } from '../lib/institutional-journeys';
interface Props { data: InstitutionalJourney; kind: 'accidente'|'regimen'|'credito'|'hijo'|'energia'|'casas'|'fallecimiento' }
const { data, kind } = Astro.props;
const faqs = data.faq;
const sources = data.sources;
---

<main class={`mh mh-${kind}`} data-mockup-hub={kind}>
  {kind === 'accidente' && <>
    <section class="ac-hero">
      <div class="mh-shell ac-grid">
        <div><p class="mh-route">TRABAJO / ACCIDENTE LABORAL</p><p class="mh-status"><i></i> GUÍA ACTUALIZADA · ARGENTINA</p><h1>Accidente laboral:<br><em>qué hacer</em> y cómo denunciarlo.</h1></div>
        <aside><p>No tenés que resolver todo hoy.<br/>Empezá por ubicarte y seguí un paso a la vez.</p><a href="#ac-momento" class="mh-cta ac-cta">EMPEZAR AHORA <b>↓</b></a><small><strong>3 min</strong> para saber qué hacer</small></aside>
      </div>
      <div class="mh-shell ac-flow"><span>01</span> Atención médica <i></i><span>02</span> Denuncia a la ART <i></i><span>03</span> Seguimiento</div>
    </section>
    <section class="mh-shell ac-body" id="ac-momento">
      <header class="mh-intro"><p>01 — UBICATE</p><h2>¿En qué momento estás?</h2><span>Elegí la situación que más se parece a la tuya. Podés cambiarla después.</span></header>
      <div class="ac-cases" role="tablist" aria-label="Momento del accidente">
        <button class="active" data-ac-case="ahora" role="tab" aria-selected="true"><i>⚡</i><small>PASÓ RECIÉN</small><strong>Necesito actuar ahora</strong><span>Primeros pasos, atención médica y aviso al empleador.</span><b>↗</b></button>
        <button data-ac-case="seguimiento" role="tab" aria-selected="false"><i>▤</i><small>YA AVISÉ</small><strong>Quiero hacer seguimiento</strong><span>Cómo controlar la denuncia, turnos y prestaciones.</span><b>↗</b></button>
        <button data-ac-case="rechazo" role="tab" aria-selected="false"><i>⊘</i><small>ALGO SALIÓ MAL</small><strong>La ART no responde</strong><span>Reclamos, rechazos y cómo escalar tu caso.</span><b>↗</b></button>
      </div>
      <section class="ac-plan">
        <div class="ac-plan-head"><div><p data-ac-eyebrow>RUTA INMEDIATA · 4 PASOS</p><h2 data-ac-title>Primero tu salud. Después, la denuncia.</h2></div><span data-ac-intro>No necesitás saber el nombre de tu ART para empezar. Hacé esto en orden y guardá constancia de todo.</span></div>
        <div class="ac-progress"><i data-ac-bar></i><small><b data-ac-count>0</b> de 4 completados</small></div>
        <div data-ac-steps></div>
      </section>
    </section>
    <section class="ac-emergency"><div class="mh-shell"><i>!</i><div><small>SI HAY RIESGO INMEDIATO</small><h2>La urgencia no espera a la ART.</h2></div><p>Llamá al servicio de emergencias o andá a una guardia. Después se informa como accidente laboral.</p><a href="tel:107">LLAMAR AL 107 ↗</a></div></section>
    <section class="mh-shell ac-rights"><header><p>02 — LO ESENCIAL</p><h2>Esto te corresponde.</h2></header><div><article><b>01</b><h3>Atención sin costo</h3><p>Consultas, estudios, medicación, prótesis y rehabilitación vinculados al accidente.</p></article><article><b>02</b><h3>Traslados cubiertos</h3><p>Cuando tu estado o el tratamiento lo requieran, la ART debe cubrirlos.</p></article><article><b>03</b><h3>Ingresos protegidos</h3><p>Durante la incapacidad laboral temporaria seguís percibiendo la prestación correspondiente.</p></article></div></section>
  </>}

  {kind === 'regimen' && <>
    <section class="rg-top mh-shell"><div class="rg-copy"><p class="mh-route">IMPUESTOS / ELEGIR RÉGIMEN</p><h1>Elegí cómo empezar sin elegir a ciegas.</h1><p>Respondé unas preguntas, compará los regímenes y descubrí cuál se adapta mejor a tu actividad.</p><button data-rg-scenario="solo">EMPEZANDO SOLO · $800.000/mes</button></div>
      <form class="rg-lab" onsubmit="return false"><h2>¿Cuánto estimás facturar por mes?</h2><output data-rg-money>$ 1.200.000</output><input data-rg-range type="range" min="200000" max="5000000" step="100000" value="1200000" aria-label="Facturación mensual estimada"/><div class="rg-scale"><span>$200 mil</span><span>$2,5 M</span><span>$5 M+</span></div><div class="rg-questions"><label>¿Qué actividad realizás?<select data-rg-activity><option>Servicios profesionales</option><option>Comercio</option><option>Oficio</option></select></label><label>¿Vas a tener empleados?<select data-rg-employees><option>No, por ahora</option><option>Sí, 1 a 3</option><option>Sí, más de 3</option></select></label><label>¿Facturás a empresas?<select data-rg-companies><option>Sí, algunas</option><option>No, principalmente personas</option></select></label></div><button class="rg-compare" data-rg-compare>COMPARAR OPCIONES →</button></form>
    </section>
    <section class="mh-shell rg-scenarios"><button data-rg-scenario="solo">♙ Empezando solo <b>$800.000/mes</b></button><button data-rg-scenario="crece">▥ Crecimiento moderado <b>$1.500.000/mes</b></button><button data-rg-scenario="alto">↗ Alto volumen <b>$3.000.000/mes</b></button><button data-rg-scenario="equipo">♟ Con empleados <b>$2.000.000/mes</b></button></section>
    <section class="mh-shell rg-compare-grid" id="rg-comparacion">
      <article class="recommended" data-rg-card="mono"><header>♙ <h2>Monotributo</h2><small>SIMPLE</small></header><p>Ideal para quienes recién empiezan o tienen bajos niveles de facturación.</p><ul><li>Una cuota mensual integrada</li><li>Administración simple</li><li>Topes y parámetros</li><li>Deducciones limitadas</li></ul><footer>Carga fiscal estimada <b>●●○</b></footer></article>
      <article data-rg-card="ri"><header>▣ <h2>Responsable inscripto</h2><small>FLEXIBLE</small></header><p>Para proyectos en crecimiento que operan con empresas o buscan escalar.</p><ul><li>IVA débito y crédito</li><li>Sin tope de facturación</li><li>Deducciones amplias</li><li>Obligaciones completas</li></ul><footer>Carga fiscal estimada <b>●●●</b></footer></article>
      <article data-rg-card="simple"><header>▤ <h2>Régimen simplificado</h2><small>TRANSITORIO</small></header><p>Opción para pequeños contribuyentes con requisitos específicos.</p><ul><li>Según jurisdicción</li><li>Impuestos incluidos</li><li>Alcance limitado</li><li>Gestión simplificada</li></ul><footer>Carga fiscal estimada <b>●○○</b></footer></article>
    </section>
    <section class="mh-shell rg-bottom"><article><h2>✦ Tu mejor punto de partida</h2><p>Según tus respuestas, el régimen que mejor se adapta hoy es:</p><strong data-rg-result>Monotributo</strong><a href="/impuestos/monotributo">REVISAR MI SITUACIÓN →</a></article><article><h2>⚑ Próximos pasos sugeridos</h2><ol><li>Verificá tu situación actual</li><li>Reuní tu información</li><li>Consultá con un profesional</li></ol></article></section>
  </>}

  {kind === 'credito' && <>
    <section class="cr-wrap mh-shell"><header class="cr-title"><p class="mh-route">FINANZAS PERSONALES / PERFIL CREDITICIO</p><h1>Tu crédito cuenta una <em>historia.</em></h1><p>Descubrí qué señales estás dando.</p><aside>⌁ Tu perfil crediticio se construye con hábitos. Entenderlo es tu ventaja.</aside></header>
      <section class="cr-scan"><h2>☷ Simulá tu perfil</h2><div class="cr-gauge" data-cr-gauge><small>TU PUNTAJE ESTIMADO</small><strong data-cr-score>712</strong><span data-cr-label>Bueno</span></div><div class="cr-sliders"><label><b>Historial de pagos</b><span data-cr-pay-label>Muy bueno</span><input data-cr-pay type="range" min="0" max="100" value="88"/></label><label><b>Nivel de deuda</b><span data-cr-debt-label>Moderado</span><input data-cr-debt type="range" min="0" max="100" value="46"/></label><p>Pequeños cambios en tus hábitos pueden generar grandes mejoras en tu puntaje.</p></div></section>
    </section>
    <section class="mh-shell cr-health"><h2>Mapa de salud: 5 factores que importan</h2><div><article><span>▣</span><h3>Historial de pagos</h3><strong data-cr-pay-pct>88%</strong><small>Impacto alto</small><i></i></article><article><span>◔</span><h3>Nivel de deuda</h3><strong data-cr-debt-pct>46%</strong><small>Impacto alto</small><i></i></article><article><span>◷</span><h3>Antigüedad</h3><strong>5 años</strong><small>Impacto medio</small><i></i></article><article><span>⌕</span><h3>Consultas recientes</h3><strong>2</strong><small>Impacto bajo</small><i></i></article><article><span>▭</span><h3>Mezcla de crédito</h3><strong>3 tipos</strong><small>Impacto medio</small><i></i></article></div></section>
    <section class="mh-shell cr-next"><header><h2>Tu próximo mejor paso</h2><a href="/finanzas-personales/salir-de-deudas">MEJORAR MI PERFIL →</a></header><div><article>◎ <b>Pagá siempre a tiempo</b><p>Es el factor que más impacta tu puntaje.</p></article><article>↓ <b>Reducí tu nivel de deuda</b><p>Intentá mantener el uso debajo del 30%.</p></article><article>◷ <b>Construí antigüedad</b><p>Evitá cerrar cuentas antiguas.</p></article><article>⌕ <b>Evitá consultas innecesarias</b><p>Muchas consultas en poco tiempo pueden afectar.</p></article></div></section>
    <section class="mh-shell cr-myth"><h2>Mitos y realidades</h2><div><p><b>MITO</b>Cerrar tarjetas siempre mejora mi puntaje.</p><p><b>REALIDAD</b>Puede reducir tu antigüedad y tu límite disponible.</p><p><b>MITO</b>Consultar mi propio informe me perjudica.</p><p><b>REALIDAD</b>Las consultas propias no afectan tu puntaje.</p></div></section>
  </>}

  {kind === 'hijo' && <>
    <section class="hj-wrap mh-shell"><header><p class="mh-route">FAMILIA / TENER UN HIJO</p><h1>Una vida nueva también se puede planificar.</h1><p>Empezá por donde estás hoy.</p></header><div class="hj-art" aria-hidden="true"><i>♡</i><span>Una decisión compartida</span></div>
      <nav class="hj-road" aria-label="Etapas"><i></i><button class="active" data-hj-stage="antes"><span>▣</span><b>Antes</b></button><button data-hj-stage="embarazo"><span>▤</span><b>Embarazo</b></button><button data-hj-stage="nacimiento"><span>♧</span><b>Nacimiento</b></button><button data-hj-stage="meses"><span>☼</span><b>Primeros meses</b></button></nav>
      <section class="hj-board"><article class="hj-list"><h2>▤ Armar mi recorrido</h2><div data-hj-list></div></article><article class="hj-card"><i>▱</i><h2>Gastos para anticipar</h2><p>Armá un presupuesto flexible y reservá margen para imprevistos.</p><a href="/finanzas-personales/gastos-del-mes">ORDENAR GASTOS →</a></article><article class="hj-card pink"><i>▤</i><h2>Licencias y asignaciones</h2><p>Revisá derechos laborales y ayudas según tu situación.</p><a href="/familia/asignaciones-anses">VER BENEFICIOS →</a></article><aside>♡ <strong>No hace falta resolver todo de una vez.</strong><span>Informate a tu ritmo · Tomá decisiones juntos · Pedí ayuda cuando la necesites</span></aside></section>
    </section>
  </>}

  {kind === 'energia' && <>
    <section class="en-hero mh-shell"><div><p class="mh-route">HOGAR / SUBSIDIOS DE ENERGÍA</p><h1>¿Tu factura tiene el subsidio correcto?</h1><p>Revisalo en <strong>3 minutos.</strong></p></div><article class="en-bill"><div><small>TOTAL A PAGAR</small><strong>$ 24.650,00</strong><span>VENCIMIENTO 20/06/2026</span></div><aside><small>ESTADO DEL SUBSIDIO</small><b data-en-status>SUBSIDIO ACTIVO</b><span>Tu factura incluye el beneficio vigente.</span></aside></article></section>
    <section class="mh-shell en-work"><aside class="en-type"><div><button class="active" data-en-type="luz">☀<b>Luz</b></button><button data-en-type="gas">♨<b>Gas</b></button></div><p>Este control es orientativo y gratuito. No necesitás tener la factura a mano.</p></aside>
      <form class="en-form" onsubmit="return false"><fieldset><legend><i>1</i> Ingresos del hogar</legend><label><input type="radio" name="income" value="1" checked/> Hasta $620.000</label><label><input type="radio" name="income" value="2"/> $620.000 a $930.000</label><label><input type="radio" name="income" value="3"/> $930.000 a $1.550.000</label><label><input type="radio" name="income" value="4"/> Más de $1.550.000</label></fieldset><fieldset><legend><i>2</i> Personas en tu casa</legend><div class="en-counter"><button type="button" data-en-minus>−</button><output data-en-people>3</output><button type="button" data-en-plus>+</button></div><p>Incluí a todas las personas que conviven y comparten gastos.</p></fieldset><fieldset><legend><i>3</i> Nivel de consumo</legend><label><input type="radio" name="usage" value="1" checked/> Bajo</label><label><input type="radio" name="usage" value="2"/> Medio</label><label><input type="radio" name="usage" value="3"/> Alto</label><label><input type="radio" name="usage" value="4"/> Muy alto</label></fieldset><button class="en-check" data-en-check>VERIFICAR MI SITUACIÓN →</button></form>
      <article class="en-result" aria-live="polite"><i>✓</i><h2 data-en-title>Podrías acceder al subsidio</h2><p data-en-copy>Según la información ingresada, tu hogar podría cumplir con los requisitos.</p><a href="https://www.argentina.gob.ar/subsidios" target="_blank" rel="noopener noreferrer">INICIAR TRÁMITE →</a></article></section>
    <section class="mh-shell en-docs"><article><h2>Fechas clave</h2><ol><li><b>Hoy</b> Verificás tu situación</li><li><b>Próximo paso</b> Iniciás el trámite</li><li><b>Después</b> Se actualiza tu subsidio</li></ol></article><article><h2>Qué necesitás para hacer el trámite</h2><div><span>▣ DNI del hogar</span><span>▤ Última factura</span><span>$ Comprobantes</span><span>✉ Email y celular</span></div></article></section>
  </>}

  {kind === 'casas' && <>
    <section class="cp-hero mh-shell"><div class="cp-desk">⌂</div><div><p class="mh-route">TRABAJO / CASAS PARTICULARES</p><h1>Contratar bien es cuidar a las dos partes.</h1><p>Armá la relación laboral paso a paso.</p></div></section>
    <section class="mh-shell cp-work"><nav aria-label="Pasos de contratación"><button data-cp-step="1"><i>1</i><b>Tareas</b></button><button class="active" data-cp-step="2"><i>2</i><b>Horarios</b></button><button data-cp-step="3"><i>3</i><b>Sueldo</b></button><button data-cp-step="4"><i>4</i><b>Registro</b></button><button data-cp-step="5"><i>5</i><b>Aportes</b></button></nav>
      <section class="cp-builder"><h2 data-cp-title>¿Cuántas horas por semana?</h2><div class="cp-presets"><button data-cp-hours="10">12 hs o menos</button><button data-cp-hours="14">12 a 16 hs</button><button class="active" data-cp-hours="20">16 a 20 hs</button><button data-cp-hours="25">20 a 30 hs</button><button data-cp-hours="35">Más de 30 hs</button></div><h3>Distribuí tus días y horarios</h3><div class="cp-calendar"><span></span><b>LUN</b><b>MAR</b><b>MIÉ</b><b>JUE</b><b>VIE</b><b>SÁB</b><b>DOM</b>{['Mañana','Tarde','Noche'].map((label,row)=><><strong>{label}</strong>{Array.from({length:7}).map((_,col)=><button class:list={{ selected: row < 2 && col > 0 && col < 5 }} data-cp-slot aria-label={`${label}, día ${col+1}`}></button>)}</>)}</div><p class="cp-total">Total seleccionado: <b data-cp-total>20 horas por semana</b></p>
        <article class="cp-cost"><h2>Costo mensual estimado</h2><div><span>Sueldo acordado <b data-cp-wage>$ 450.000</b></span><i>+</i><span>Aportes y contribuciones <b data-cp-contrib>$ 103.500</b></span><i>+</i><span>Seguro de riesgos <b>$ 6.500</b></span><i>=</i><span>Total mensual <b data-cp-cost>$ 560.000</b></span></div></article></section>
      <aside class="cp-side"><article><h2>▤ Registrar en ARCA</h2><ul><li>Ingresá los datos del empleador</li><li>Ingresá los datos del trabajador</li><li>Generá el alta</li><li>Obtené el número de CUIL</li></ul></article><article><h2>♢ Derechos del trabajador</h2><ul><li>Sueldo en tiempo y forma</li><li>Descanso semanal</li><li>Vacaciones pagas</li><li>Aguinaldo</li><li>Obra social y ART</li></ul></article><button data-cp-plan>CREAR MI PLAN DE CONTRATACIÓN →</button><small data-cp-message>Todo en regla desde el primer día.</small></aside></section>
  </>}

  {kind === 'fallecimiento' && <>
    <section class="fa-hero mh-shell"><div><p class="mh-route">FAMILIA / FALLECIMIENTO Y TRÁMITES</p><h1>Cuando todo pesa, un paso claro ayuda.</h1><p>Te acompañamos a ordenar los trámites.</p></div><div class="fa-compass" aria-hidden="true">✦<span>N</span><i>Una guía para orientarte</i></div></section>
    <section class="mh-shell fa-content"><nav class="fa-tabs"><button class="active" data-fa-time="hoy">☼ Hoy</button><button data-fa-time="semana">▣ Esta semana</button><button data-fa-time="despues">◷ Más adelante</button></nav>
      <div class="fa-grid"><aside class="fa-docs"><h2>▱ Documentación básica</h2><p>Reuní estos documentos para avanzar.</p><div data-fa-docs></div><progress max="6" value="0" data-fa-progress></progress><small><b data-fa-count>0</b> de 6 reunidos</small></aside>
        <section class="fa-lanes"><article><h2>▥ Trámites civiles</h2><button>Inscripción de defunción <span>›</span></button><button>Acta de defunción <span>›</span></button><button>Declaratoria de herederos <span>›</span></button><a href="https://www.argentina.gob.ar/justicia" target="_blank" rel="noopener noreferrer">Ver trámites civiles →</a></article><article><h2>▤ Bancos y seguros</h2><button>Informar el fallecimiento <span>›</span></button><button>Seguros de vida <span>›</span></button><button>Cuentas y productos <span>›</span></button><a href="https://www.bcra.gob.ar/" target="_blank" rel="noopener noreferrer">Ver información financiera →</a></article><article><h2>⌂ Servicios y cuentas</h2><button>Servicios del hogar <span>›</span></button><button>Telefonía y cable <span>›</span></button><button>Suscripciones y otros <span>›</span></button><a href="#fa-faq">Ver todos los servicios →</a></article></section>
        <aside class="fa-help"><article><h2>¿Quién puede hacerlo?</h2><p>Puede hacerlo un familiar directo o la persona designada. Algunas gestiones requieren poder especial.</p><button data-fa-helper>VER DETALLES →</button></article><article><h2>Estamos para acompañarte</h2><p>Consultá fuentes oficiales y pedí ayuda profesional cuando la necesites.</p><a href="https://www.argentina.gob.ar/miargentina" target="_blank" rel="noopener noreferrer">IR A MI ARGENTINA →</a></article></aside></div>
    </section>
  </>}

  <section class="mh-info mh-shell" id="fa-faq"><div><p class="mh-kicker">FUENTES OFICIALES</p><h2>Información para avanzar con respaldo</h2><div class="mh-source-links">{sources.slice(0,4).map(source => <a href={source.href} target="_blank" rel="noopener noreferrer"><strong>{source.label}</strong><span>{source.publisher} ↗</span></a>)}</div></div><div><p class="mh-kicker">ANTES DE AVANZAR</p><h2>Preguntas frecuentes</h2>{faqs.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
</main>

<script is:inline>
(() => {
  const root=document.querySelector('[data-mockup-hub]'); if(!root) return;
  const one=(s)=>root.querySelector(s), all=(s)=>[...root.querySelectorAll(s)], money=(n)=>'$ '+Math.round(n).toLocaleString('es-AR');
  if(root.dataset.mockupHub==='accidente'){
    const cases={
      ahora:{eye:'RUTA INMEDIATA · 4 PASOS',title:'Primero tu salud. Después, la denuncia.',intro:'No necesitás saber el nombre de tu ART para empezar. Hacé esto en orden y guardá constancia de todo.',steps:[['Pedí atención médica','Si hay riesgo grave, llamá al 107 o al servicio de emergencias.'],['Avisale a tu empleador','Informá qué pasó, dónde y a qué hora. Dejá registro.'],['Denunciá el accidente ante la ART','Pedí siempre un número de siniestro.'],['Armá tu carpeta del caso','Guardá fotos, estudios, certificados y mensajes.']]},
      seguimiento:{eye:'SEGUIMIENTO · CONTROL DEL CASO',title:'Que la denuncia no quede en un número.',intro:'Usá el número de siniestro para seguir cada prestación y registrar cualquier demora.',steps:[['Confirmá la apertura','Pedí número, prestador asignado y próximos turnos.'],['Registrá cada contacto','Anotá fecha, canal y respuesta recibida.'],['Revisá tus prestaciones','Controlá atención, medicación, traslados y rehabilitación.'],['Revisá el alta','Pedí copia y no la firmes sin entenderla.']]},
      rechazo:{eye:'RECLAMO · DEFENSA DE TUS DERECHOS',title:'Si la ART frena, dejá todo por escrito.',intro:'Un rechazo o una demora se puede reclamar. Ordená la evidencia antes de escalar.',steps:[['Pedí el motivo formal','Solicitá la respuesta y sus fundamentos por escrito.'],['Reuní la documentación','DNI, denuncia, estudios y comunicaciones.'],['Iniciá el reclamo','Contactá a la Superintendencia de Riesgos del Trabajo.'],['Buscá asesoramiento','Evaluá asistencia profesional según el caso.']]}
    }; let current='ahora', done=new Set();
    const render=()=>{const c=cases[current];one('[data-ac-eyebrow]').textContent=c.eye;one('[data-ac-title]').textContent=c.title;one('[data-ac-intro]').textContent=c.intro;const box=one('[data-ac-steps]');box.replaceChildren(...c.steps.map((s,i)=>{const a=document.createElement('article');a.className='ac-step'+(done.has(i)?' done':'');a.innerHTML='<button type="button" aria-label="Marcar paso"><i>'+(done.has(i)?'✓':String(i+1).padStart(2,'0'))+'</i></button><div><h3></h3><p></p></div><small>'+(done.has(i)?'HECHO':'PENDIENTE')+'</small>';a.querySelector('h3').textContent=s[0];a.querySelector('p').textContent=s[1];a.querySelector('button').onclick=()=>{done.has(i)?done.delete(i):done.add(i);render()};return a;}));one('[data-ac-count]').textContent=done.size;one('[data-ac-bar]').style.width=(done.size/4*100)+'%';};
    all('[data-ac-case]').forEach(b=>b.onclick=()=>{current=b.dataset.acCase;done.clear();all('[data-ac-case]').forEach(x=>{const on=x===b;x.classList.toggle('active',on);x.setAttribute('aria-selected',on)});render()});render();
  }
  if(root.dataset.mockupHub==='regimen'){
    const range=one('[data-rg-range]'), out=one('[data-rg-money]'); const update=()=>out.textContent=money(+range.value);range.oninput=update;
