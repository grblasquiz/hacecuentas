---
/**
 * Flagship "Día número 10.000" — mockup del batch 23-07-2026 (ola 1), calcado.
 * El script inline replica fecha-10000-dias.ts: suma de días corridos sobre la
 * fecha de nacimiento (los bisiestos entran solos por aritmética de calendario)
 * y los tres hitos 10.000 / 20.000 / 30.000.
 */
import '../../styles/calc-batch-mockup.css';
import CalcMockupSeo from './CalcMockupSeo.astro';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

// SSR: fecha demo del mockup. El cliente recalcula con "hoy" real.
const DEMO = '1999-03-15';
const demoNac = new Date(1999, 2, 15);
const demo10k = new Date(demoNac.getTime() + 10000 * 86400000);
const fmtLargo = (d: Date) => d.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
const fmtCorto = (d: Date) => d.toLocaleDateString('es-AR', { day: 'numeric', month: 'short' });
---

<main class="page hcm fd">
  <div class="crumb">Inicio / <a href="/categoria/vida">Fechas</a> / <b>Día número 10.000</b></div>

  <section class="hero">
    <div>
      <span class="tag">🎂 UNA FECHA PARA CELEBRAR</span>
      <h1>¿Cuándo cumplís 10.000 días de vida?</h1>
      <p>Ingresá tu fecha de nacimiento y descubrí el día exacto, con la edad aproximada de cada hito.</p>
    </div>
    <div class="hero-art">
      <div class="art-icon">🎂</div>
      <div class="hero-stat"><span>10.000 días</span><b>≈ 27 años y 4 meses</b></div>
    </div>
  </section>

  <section class="tool" id="calc">
    <form class="card" id="fd-form">
      <h2>Tu fecha de nacimiento</h2>
      <p class="sub">Contamos días corridos, con años bisiestos incluidos.</p>
      <div class="field">
        <label for="fd-birth">Nacimiento</label>
        <div class="control"><input id="fd-birth" type="date" value={DEMO} max="2100-12-31" /></div>
      </div>
      <button class="cta" type="submit">Descubrir la fecha →</button>
    </form>

    <article class="card result">
      <div>
        <div class="over">Tu día 10.000 es</div>
        <div class="big" id="fd-big">{fmtCorto(demo10k)}</div>
        <p class="answer" id="fd-answer">Tu día número 10.000 cae en {demo10k.getFullYear()}.</p>
        <div class="result-box">
          <span>Fecha completa</span>
          <b id="fd-full">{fmtLargo(demo10k)}</b>
          <small id="fd-note">Cuenta días corridos desde el nacimiento.</small>
        </div>
      </div>
      <div class="equation" id="fd-eq">fecha de nacimiento + 10.000 días</div>
    </article>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Otros hitos curiosos</h2>
      <p>La vida también se puede contar en días.</p>
    </div>
    <div class="cards">
      <article class="mini"><i>🌱</i><h3>5.000 días</h3><p id="fd-h5">Aproximadamente a los 13 años y 8 meses.</p></article>
      <article class="mini"><i>🎉</i><h3>10.000 días</h3><p id="fd-h10">Cerca de los 27 años y 4 meses.</p></article>
      <article class="mini"><i>⭐</i><h3>20.000 días</h3><p id="fd-h20">Alrededor de los 54 años y 9 meses.</p></article>
    </div>
    <div class="notice">
      <span>💡</span>
      <div><b>Los bisiestos están incluidos.</b>Sumamos días de calendario reales, no una aproximación de 365 días por año.</div>
    </div>
  </section>

  <CalcMockupSeo calc={calc} related={related} icon="🎂" />

  <footer class="sources">
    <div><b>Metodología</b><br />Aritmética de fechas del calendario gregoriano.</div>
    <div>Resultado orientativo · Sin registro</div>
  </footer>
</main>

<style is:global>
  .hcm.fd{--brand:#673c63;--accent:#ffd875;--soft:#f7eef5}
  .hcm.fd .hero{background:linear-gradient(135deg,#673c63,#9b657f)}
  .hcm .crumb a{color:inherit;text-decoration:none}
  .hcm .crumb a:hover{text-decoration:underline}
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.hcm.fd');
    if (!root) return;
    var B = document.getElementById('fd-birth');
    var nf = function (x) { return new Intl.NumberFormat('es-AR').format(x); };
    var largo = function (d) { return d.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' }); };
    var corto = function (d) { return d.toLocaleDateString('es-AR', { day: 'numeric', month: 'short' }); };

    function render() {
      var big = document.getElementById('fd-big');
      var ans = document.getElementById('fd-answer');
      var full = document.getElementById('fd-full');
      var note = document.getElementById('fd-note');
      var eq = document.getElementById('fd-eq');
      var parts = String(B.value || '').split('-').map(Number);
      if (parts.length !== 3 || parts.some(isNaN)) {
        big.innerHTML = '—';
        ans.textContent = 'Ingresá una fecha de nacimiento válida.';
        full.textContent = '—'; note.textContent = '';
        eq.innerHTML = 'fecha de nacimiento + 10.000 días';
        return;
      }
      var nac = new Date(parts[0], parts[1] - 1, parts[2]);
      var hoy = new Date(); hoy.setHours(0, 0, 0, 0);
      if (isNaN(nac.getTime()) || nac > hoy) {
        big.innerHTML = '—';
        ans.textContent = nac > hoy ? 'La fecha de nacimiento no puede estar en el futuro.' : 'Ingresá una fecha de nacimiento válida.';
        full.textContent = '—'; note.textContent = '';
        eq.innerHTML = 'fecha de nacimiento + 10.000 días';
        return;
      }
      var vividos = Math.round((hoy.getTime() - nac.getTime()) / 86400000);
      var hito = function (n) { return new Date(nac.getTime() + n * 86400000); };
      var f10 = hito(10000);
      big.innerHTML = corto(f10);
      ans.textContent = vividos >= 10000
        ? 'Ya pasaste los 10.000 días: fue en ' + f10.getFullYear() + ' y llevás ' + nf(vividos) + ' días vividos.'
        : 'Tu día número 10.000 cae en ' + f10.getFullYear() + ': faltan ' + nf(10000 - vividos) + ' días.';
      full.textContent = largo(f10);
      note.textContent = 'Llevás ' + nf(vividos) + ' días vividos (unos ' + (vividos / 365.25).toFixed(1) + ' años).';
      eq.innerHTML = largo(nac) + ' + 10.000 días = <b>' + largo(f10) + '</b>';

      // Hitos de la sección explicativa, recalculados con la fecha real
      var edad = function (n) {
        var f = hito(n);
        var meses = Math.floor(n / 30.4375);
        return largo(f) + ' · ~' + Math.floor(meses / 12) + ' años y ' + (meses % 12) + ' meses.';
      };
      document.getElementById('fd-h5').textContent = edad(5000);
      document.getElementById('fd-h10').textContent = edad(10000);
      document.getElementById('fd-h20').textContent = edad(20000);
    }

    B.addEventListener('input', render);
    B.addEventListener('change', render);
    document.getElementById('fd-form').addEventListener('submit', function (e) { e.preventDefault(); render(); });
    render();
  })();
</script>
