---
/**
 * Flagship "Monotributo 2026" — mockup bespoke.
 * El script inline replica src/lib/formulas/monotributo.ts:
 *   tabla = CATEGORIAS.map(c => ({ letra, limiteAnual: TOPES[c], cuota: round(cuota(c, act)) }))
 *   categoria = primera cuyo limiteAnual >= facturacionAnual
 *   cuotaAnual = cuotaMensual × 12   ·   margen = limite − facturacion
 *   alerta según %uso (>90 / >75 / resto), mismos textos que el motor.
 * Las escalas NO se tipean: se serializan desde src/lib/data/monotributo-2026.ts
 * (escala ARCA vigente 2026-08-01, +16,8%).
 */
import '../../styles/calc-batch-mockup.css';
import CalcMockupSeo from './CalcMockupSeo.astro';
import { TOPES, CUOTA_SERVICIOS, CUOTA_BIENES, CATEGORIAS, META } from '../../lib/data/monotributo-2026';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

const SCALE = CATEGORIAS.map((c) => ({
  letra: c,
  limite: TOPES[c],
  servicios: Math.round(CUOTA_SERVICIOS[c]),
  bienes: Math.round(CUOTA_BIENES[c]),
}));

const money = (x: number) => '$' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(x);

// Primer paint (SSR) con los defaults del JSON: $15.000.000, servicios.
const D = { fact: 15000000, act: 'servicios' as const };
const c0 = SCALE.find((c) => D.fact <= c.limite)!;
const cuota0 = c0.servicios;
const margen0 = c0.limite - D.fact;
const uso0 = Math.round((D.fact / c0.limite) * 100);
const topeK = SCALE[SCALE.length - 1].limite;
---

<main class="page hcm mt">
  <div class="crumb">Inicio / <a href="/categoria/impuestos">Impuestos</a> / <b>Monotributo 2026</b></div>

  <section class="hero">
    <div>
      <span class="tag">🧾 ESCALA ARCA VIGENTE {META.vigencia.split('-').reverse().join('/')}</span>
      <h1>¿En qué categoría de monotributo caés?</h1>
      <p>Poné lo que facturaste en los últimos 12 meses y mirá tu categoría, la cuota mensual y cuánto te falta para saltar a la siguiente.</p>
    </div>
    <div class="hero-art">
      <div class="cat-stack" aria-hidden="true">
        <i>A</i><i>B</i><i class="on" id="mt-chip">B</i><i>J</i><i>K</i>
      </div>
      <div class="hero-stat"><span>Recategorización</span><b>enero y julio</b></div>
    </div>
  </section>

  <section class="tool" id="calc">
    <form class="card" id="mt-form">
      <h2>Tu facturación</h2>
      <p class="sub">Ingresos brutos de los últimos 12 meses, sin IVA discriminado.</p>

      <div class="field">
        <label for="mt-fact">Facturación anual <small>últimos 12 meses</small></label>
        <div class="control"><span>$</span><input id="mt-fact" type="number" min="0" step="100000" value={D.fact} /></div>
      </div>

      <div class="field">
        <label for="mt-act">Tipo de actividad</label>
        <div class="seg" id="mt-act" role="group" aria-label="Tipo de actividad">
          <button type="button" data-act="servicios" class="active">Servicios</button>
          <button type="button" data-act="bienes">Venta de bienes</button>
        </div>
        <p class="hint">Los topes son iguales para ambas; la cuota difiere en las categorías altas (servicios paga más).</p>
      </div>

      <div class="field">
        <label>Chequeo rápido</label>
        <div class="chips" id="mt-chips">
          <button type="button" data-v="8000000">$8 M</button>
          <button type="button" data-v="22000000">$22 M</button>
          <button type="button" data-v="45000000">$45 M</button>
          <button type="button" data-v="100000000">$100 M</button>
        </div>
      </div>

      <button class="cta" type="submit">Ver mi categoría →</button>
    </form>

    <article class="card result">
      <div>
        <div class="over">Te corresponde</div>
        <div class="big" id="mt-big">Categoría {c0.letra}</div>
        <p class="answer" id="mt-answer">✅ Estás holgado en esta categoría.</p>
        <div class="result-box">
          <span>Cuota mensual</span>
          <b id="mt-cuota">{money(cuota0)}</b>
          <small id="mt-note">Son {money(cuota0 * 12)} al año · incluye impuesto integrado, SIPA y obra social.</small>
        </div>
        <div class="usebar">
          <div class="usebar-head"><span id="mt-uso-lbl">Usás el {uso0}% del tope</span><b id="mt-margen">te faltan {money(margen0)}</b></div>
          <div class="progress"><i id="mt-bar" style={`width:${Math.min(100, uso0)}%`}></i></div>
        </div>
      </div>
      <div class="equation" id="mt-eq">Tope de la categoría {c0.letra}: <b>{money(c0.limite)}</b> anuales</div>
    </article>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Las 11 categorías, A → K</h2>
      <p>Tope anual y cuota mensual total. Tu categoría queda resaltada.</p>
    </div>
    <div class="table" id="mt-table">
      {SCALE.map((c) => (
        <div class={'row cat' + (c.letra === c0.letra ? ' on' : '')} data-cat={c.letra}>
          <div><b>Categoría {c.letra}</b><small class="mob">hasta {money(c.limite)}/año</small></div>
          <small class="desk">hasta {money(c.limite)}</small>
          <strong data-serv={c.servicios} data-bien={c.bienes}>{money(c.servicios)}/mes</strong>
        </div>
      ))}
    </div>
    <div class="notice">
      <span>🚪</span>
      <div><b>Arriba de {money(topeK)} anuales quedás fuera del régimen.</b>Si superás el tope de K tenés 5 días hábiles para renunciar al monotributo y pasar a Responsable Inscripto: IVA, Ganancias por escala y Autónomos.</div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Cómo se decide tu categoría</h2>
      <p>Sumás, mirás el tope y recategorizás si cambió.</p>
    </div>
    <div class="timeline">
      <div class="step"><span>Paso 1</span><b>Sumás 12 meses</b><em>Ingresos brutos, todas tus actividades</em></div>
      <div class="step"><span>Paso 2</span><b>Buscás el tope</b><em>La primera categoría que te contiene</em></div>
      <div class="step"><span>Paso 3</span><b>Recategorizás</b><em>Enero y julio, desde el portal ARCA</em></div>
      <div class="step"><span>Paso 4</span><b>Pagás la nueva cuota</b><em>Desde el mes siguiente</em></div>
    </div>
    <div class="cards" style="margin-top:13px">
      <article class="mini"><i>🧮</i><h3>Qué incluye la cuota</h3><p>Impuesto integrado (IVA + Ganancias), aporte jubilatorio SIPA y obra social, todo en un solo pago mensual.</p></article>
      <article class="mini"><i>📏</i><h3>No sólo facturación</h3><p>ARCA también mira alquileres devengados, superficie afectada y energía consumida. Si un parámetro se pasa, subís de categoría.</p></article>
      <article class="mini"><i>🏙️</i><h3>Ingresos Brutos aparte</h3><p>La cuota nacional no cubre IIBB provincial ni tasas municipales: esos se pagan por separado salvo régimen unificado.</p></article>
    </div>
  </section>

  <CalcMockupSeo calc={calc} related={related} icon="📋" />

  <footer class="sources">
    <div><b>Metodología</b><br />Categoría = primer tope de la escala ARCA que contiene tu facturación anual; cuota mensual total según actividad.</div>
    <div>Escala vigente {META.vigencia} · Fuente {META.fuente} · Recategorización {META.recategorizacion}</div>
  </footer>
</main>

<style is:global>
  .hcm.mt{--brand:#0b3c55;--accent:#58e6d9;--soft:#e6f3f5}
  .hcm.mt .hero{background:linear-gradient(135deg,#0b3c55,#1d6b7a)}
  .hcm .crumb a{color:inherit;text-decoration:none}
  .hcm .crumb a:hover{text-decoration:underline}
  .hcm.mt .hint{color:var(--muted);font-size:13px;line-height:1.4;margin:8px 0 0}
  .hcm.mt .cat-stack{display:flex;gap:8px;align-items:center;z-index:1}
  .hcm.mt .cat-stack i{font-style:normal;font:800 26px/1 Manrope,system-ui,sans-serif;width:52px;height:62px;display:grid;place-items:center;border-radius:14px;background:rgba(255,255,255,.12);border:1px solid #ffffff2e;color:#cfe6ea}
  .hcm.mt .cat-stack i.on{background:var(--accent);color:#06303f;transform:scale(1.22);box-shadow:0 12px 26px rgba(0,0,0,.28)}
  .hcm.mt .usebar{margin-top:20px}
  .hcm.mt .usebar-head{display:flex;justify-content:space-between;gap:10px;font-size:13px;color:#c3dde3;flex-wrap:wrap}
  .hcm.mt .usebar-head b{color:var(--accent)}
  .hcm.mt .result .progress{background:rgba(255,255,255,.18);margin:9px 0 0}
  .hcm.mt .row.cat{grid-template-columns:minmax(0,1.3fr) minmax(0,.9fr) minmax(0,.9fr);border-radius:12px;padding-left:12px;padding-right:12px}
  .hcm.mt .row.cat.on{background:var(--soft);border-top-color:transparent;box-shadow:inset 0 0 0 2px var(--brand)}
  .hcm.mt .row.cat.on b{color:var(--brand)}
  .hcm.mt .row.cat .mob{display:none}
  .hcm.mt .row.cat small.desk{color:var(--muted)}
  @media(max-width:760px){
    .hcm.mt .row.cat{grid-template-columns:minmax(0,1fr) minmax(0,auto)}
    .hcm.mt .row.cat .mob{display:block}
    .hcm.mt .row.cat small.desk{display:none}
    .hcm.mt .cat-stack i{width:42px;height:52px;font-size:21px}
  }
</style>

<script is:inline define:vars={{ SCALE }}>
  (function () {
    var root = document.querySelector('.hcm.mt');
    if (!root) return;
    var act = 'servicios';
    var money = function (x) { return '$' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(x); };
    var $ = function (id) { return document.getElementById(id); };

    function render() {
      var fact = Number($('mt-fact').value);
      var big = $('mt-big'), ans = $('mt-answer'), cuotaEl = $('mt-cuota'), note = $('mt-note');
      var eq = $('mt-eq'), bar = $('mt-bar'), usoLbl = $('mt-uso-lbl'), margenEl = $('mt-margen');
      var chip = $('mt-chip');
      var rows = root.querySelectorAll('.row.cat');

      // La tabla muestra siempre la cuota de la actividad elegida.
      for (var r = 0; r < rows.length; r++) {
        var st = rows[r].querySelector('strong');
        st.textContent = money(Number(act === 'bienes' ? st.getAttribute('data-bien') : st.getAttribute('data-serv'))) + '/mes';
      }

      function clear() { for (var i = 0; i < rows.length; i++) rows[i].classList.remove('on'); }

      function fail(msg) {
        big.textContent = '—'; ans.textContent = msg;
        cuotaEl.textContent = '—'; note.textContent = '';
        eq.textContent = 'Revisá la facturación ingresada.';
        bar.style.width = '0%'; usoLbl.textContent = ''; margenEl.textContent = '';
        chip.textContent = '?'; clear();
      }

      // Mismas guardas que src/lib/formulas/monotributo.ts
      if (!fact || fact < 0) return fail('Ingresá tu facturación anual estimada');

      var cat = null;
      for (var i = 0; i < SCALE.length; i++) { if (fact <= SCALE[i].limite) { cat = SCALE[i]; break; } }
      if (!cat) return fail('Facturación supera el límite del monotributo. Debés pasar a Responsable Inscripto.');

      var cuotaMensual = act === 'bienes' ? cat.bienes : cat.servicios;
      var cuotaAnual = cuotaMensual * 12;
      var margen = cat.limite - fact;
      var pct = (fact / cat.limite) * 100;
      var uso = Math.round(pct);

      var alerta = pct > 90
        ? '⚠️ Estás cerca del límite. Si superás, recategorizá o pasá a Responsable Inscripto.'
        : pct > 75
          ? '⚡ Estás en el 75%+ del límite. Monitoreá tu facturación.'
          : '✅ Estás holgado en esta categoría.';

      big.textContent = 'Categoría ' + cat.letra;
      ans.textContent = alerta;
      cuotaEl.textContent = money(cuotaMensual);
      note.textContent = 'Son ' + money(cuotaAnual) + ' al año · incluye impuesto integrado, SIPA y obra social.';
      usoLbl.textContent = 'Usás el ' + uso + '% del tope';
      chip.textContent = cat.letra;

      var idx = SCALE.indexOf(cat);
      var next = SCALE[idx + 1];
      margenEl.textContent = next
        ? 'te faltan ' + money(margen) + ' para ' + next.letra
        : 'te faltan ' + money(margen) + ' para salir del régimen';
      bar.style.width = Math.min(100, uso) + '%';
      eq.innerHTML = 'Tope de la categoría ' + cat.letra + ': <b>' + money(cat.limite) + '</b> anuales' +
        (next ? ' · la siguiente (' + next.letra + ') paga <b>' + money(act === 'bienes' ? next.bienes : next.servicios) + '/mes</b>' : '');

      clear();
      for (var j = 0; j < rows.length; j++) {
        if (rows[j].getAttribute('data-cat') === cat.letra) rows[j].classList.add('on');
      }
    }

    $('mt-fact').addEventListener('input', render);
    $('mt-act').addEventListener('click', function (e) {
      var b = e.target.closest('button[data-act]');
      if (!b) return;
      act = b.getAttribute('data-act');
      var bs = this.querySelectorAll('button');
      for (var i = 0; i < bs.length; i++) bs[i].classList.toggle('active', bs[i] === b);
      render();
    });
    $('mt-chips').addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]');
      if (!b) return;
      $('mt-fact').value = b.getAttribute('data-v');
      var bs = this.querySelectorAll('button');
      for (var i = 0; i < bs.length; i++) bs[i].classList.toggle('active', bs[i] === b);
      render();
    });
    $('mt-form').addEventListener('submit', function (e) { e.preventDefault(); render(); });
    render();
  })();
</script>
