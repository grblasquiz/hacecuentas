---
/**
 * Flagship "Millas LATAM Pass" — mockup del batch 23-07-2026 (ola 3), calcado.
 * Reemplaza al flagship anterior (MillasLatamDestino.astro).
 * El script inline replica millas-latam-destino.ts: tabla DEST_MILES por
 * destino [ida, ida-vuelta, business], referencia editorial de 1,2¢/milla y
 * veredicto por ahorro neto (precio cash − tasas) ÷ millas.
 * La tabla y la referencia se serializan desde el módulo real: una sola fuente.
 */
import '../../styles/calc-batch-mockup.css';
import CalcMockupSeo from './CalcMockupSeo.astro';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

const DEST = {
  'buenos-aires': { label: 'Buenos Aires', m: [7000, 14000, 30000] },
  'santiago': { label: 'Santiago', m: [7000, 14000, 30000] },
  'miami': { label: 'Miami', m: [25000, 50000, 85000] },
  'madrid': { label: 'Madrid', m: [45000, 90000, 150000] },
  'londres': { label: 'Londres', m: [55000, 110000, 170000] },
  'sydney': { label: 'Sídney', m: [60000, 120000, 180000] },
};
const REF_CENT = 1.2;
const TASAS_DEFAULT = 190;
const du = calc.dataUpdate || {};
const nf = (x: number) => new Intl.NumberFormat('es-AR').format(x);
---

<main class="page hcm ml" data-dest={JSON.stringify(DEST)} data-ref={REF_CENT} data-tasas={TASAS_DEFAULT}>
  <div class="crumb">Inicio / <a href="/categoria/viajes">Viajes</a> / <b>Millas LATAM Pass</b></div>

  <section class="hero">
    <div>
      <span class="tag">✈️ CANJE VS CASH</span>
      <h1>¿Hasta dónde te llevan tus millas LATAM?</h1>
      <p>Estimá el canje por destino y cabina, y comparalo con el precio del pasaje para decidir con números.</p>
    </div>
    <div class="hero-art">
      <div class="art-icon">✈️</div>
      <div class="hero-stat"><span>Referencia regional</span><b>desde {nf(14000)} millas</b></div>
    </div>
  </section>

  <section class="tool" id="calc">
    <form class="card" id="ml-form">
      <h2>Armá tu canje</h2>
      <p class="sub">Destino, cabina y costo real del ticket.</p>
      <div class="grid2">
        <div class="field">
          <label for="ml-dest">Destino</label>
          <div class="control">
            <select id="ml-dest">
              <option value="buenos-aires" selected>Buenos Aires</option>
              <option value="santiago">Santiago</option>
              <option value="miami">Miami</option>
              <option value="madrid">Madrid</option>
              <option value="londres">Londres</option>
              <option value="sydney">Sídney</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="ml-cabin">Cabina</label>
          <div class="control">
            <select id="ml-cabin"><option value="economy" selected>Economy</option><option value="business">Business</option></select>
          </div>
        </div>
      </div>
      <div class="field">
        <label for="ml-trip">Viaje</label>
        <div class="control">
          <select id="ml-trip"><option value="ida-vuelta" selected>Ida y vuelta</option><option value="ida">Sólo ida</option></select>
        </div>
      </div>
      <div class="grid2">
        <div class="field">
          <label for="ml-cash">Precio cash <small>opcional</small></label>
          <div class="control"><input id="ml-cash" type="number" min="0" step="any" value="780" /><span>USD</span></div>
        </div>
        <div class="field">
          <label for="ml-tax">Tasas del canje</label>
          <div class="control"><input id="ml-tax" type="number" min="0" step="any" value="190" /><span>USD</span></div>
        </div>
      </div>
      <div class="field">
        <label for="ml-quoted">Millas que te cotiza el programa <small>opcional</small></label>
        <div class="control"><input id="ml-quoted" type="number" min="0" step="1000" placeholder="Dejalo vacío para usar la tabla" /></div>
      </div>
      <button class="cta" type="submit">Comparar opciones →</button>
    </form>

    <article class="card result">
      <div>
        <div class="over">Millas estimadas</div>
        <div class="big" id="ml-big">{nf(14000)} <small>millas</small></div>
        <p class="answer" id="ml-answer">Referencia para Buenos Aires, economy ida y vuelta.</p>
        <div class="result-box">
          <span>Valor obtenido por milla</span>
          <b id="ml-cpm">—</b>
          <small id="ml-note">Ingresá el precio cash del pasaje para comparar.</small>
        </div>
      </div>
      <div class="equation" id="ml-eq">(precio cash − tasas) ÷ millas</div>
    </article>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Antes de usar las millas</h2>
      <p>El canje más barato no siempre es el mejor.</p>
    </div>
    <div class="cards">
      <article class="mini"><i>💵</i><h3>Compará valor por milla</h3><p>Restá tasas y dividí el ahorro real por las millas usadas.</p></article>
      <article class="mini"><i>📅</i><h3>Buscá fechas flexibles</h3><p>La disponibilidad puede cambiar el precio varias veces por día.</p></article>
      <article class="mini"><i>🧳</i><h3>Revisá equipaje</h3><p>Cash y canje pueden incluir condiciones distintas.</p></article>
    </div>
    <div class="notice">
      <span>💡</span>
      <div><b>No hay tarifa fija universal.</b>Los valores son rangos de referencia: confirmá la cotización final en LATAM Pass. El umbral de ~1,2¢ por milla es una referencia editorial de mercado, no un dato oficial del programa.</div>
    </div>
  </section>

  <CalcMockupSeo calc={calc} related={related} icon="✈️" />

  <footer class="sources">
    <div><b>Fuente</b><br />{du.source || 'LATAM — Programa LATAM Pass'}{du.lastUpdated ? ` · actualizado ${du.lastUpdated}` : ''}. Rangos orientativos; la cotización final la define el programa.</div>
    <div>Resultado orientativo · Sin registro</div>
  </footer>
</main>

<style is:global>
  .hcm.ml{--brand:#44245f;--accent:#f3d46c;--soft:#f2edf6}
  .hcm.ml .hero{background:linear-gradient(135deg,#44245f,#7b3f88)}
  .hcm .crumb a{color:inherit;text-decoration:none}
  .hcm .crumb a:hover{text-decoration:underline}
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.hcm.ml');
    if (!root) return;
    var DEST = JSON.parse(root.dataset.dest);
    var REF = Number(root.dataset.ref);
    var TASAS_DEFAULT = Number(root.dataset.tasas);
    var D = document.getElementById('ml-dest'), CB = document.getElementById('ml-cabin'), TR = document.getElementById('ml-trip');
    var CA = document.getElementById('ml-cash'), TX = document.getElementById('ml-tax'), Q = document.getElementById('ml-quoted');
    var nf = function (x) { return new Intl.NumberFormat('es-AR').format(x); };
    var d2 = function (x) { return new Intl.NumberFormat('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(x); };

    function render() {
      var e = DEST[D.value];
      var big = document.getElementById('ml-big');
      var ans = document.getElementById('ml-answer');
      var cpmEl = document.getElementById('ml-cpm');
      var note = document.getElementById('ml-note');
      var eq = document.getElementById('ml-eq');
      if (!e) { big.innerHTML = '—'; ans.textContent = 'Destino inválido.'; return; }

      var cab = CB.value, viaje = TR.value;
      var tabla = cab === 'business' ? e.m[2] : viaje === 'ida-vuelta' ? e.m[1] : e.m[0];
      var cotizadas = Number(Q.value) || 0;
      var millas = cotizadas > 0 ? cotizadas : tabla;
      var tasas = TX.value === '' || Number(TX.value) < 0 ? TASAS_DEFAULT : Number(TX.value);
      var cash = Number(CA.value) || 0;

      big.innerHTML = nf(millas) + ' <small>millas</small>';
      ans.textContent = 'Referencia para ' + e.label + ', ' + (cab === 'business' ? 'business' : 'economy') + ' '
        + (viaje === 'ida-vuelta' ? 'ida y vuelta' : 'sólo ida')
        + (cotizadas > 0 ? ' (usando las millas que te cotizaron).' : ' (según la tabla de referencia por destino).')
        + ' Las tasas (USD ' + nf(tasas) + ') se pagan aparte, en plata.';

      if (cash > 0) {
        var ahorro = cash - tasas;
        var cpm = (ahorro / millas) * 100;
        cpmEl.textContent = d2(cpm) + ' ¢USD/milla';
        if (ahorro <= 0) {
          note.textContent = 'No conviene canjear: las tasas (USD ' + nf(tasas) + ') igualan o superan el precio cash (USD ' + nf(cash) + ').';
        } else if (cpm >= REF) {
          note.textContent = 'Conviene canjear: estás por encima de la referencia de ~' + d2(REF) + '¢/milla (referencia editorial, no oficial).';
        } else {
          note.textContent = 'Conviene pagar cash o esperar mejor canje: estás por debajo de ~' + d2(REF) + '¢/milla (referencia editorial, no oficial).';
        }
        eq.innerHTML = '(USD ' + nf(cash) + ' − USD ' + nf(tasas) + ') ÷ ' + nf(millas) + ' millas = <b>' + d2(cpm) + '¢</b>';
      } else {
        cpmEl.textContent = '—';
        note.textContent = 'Ingresá el precio cash del pasaje para comparar canje contra plata.';
        eq.innerHTML = '(precio cash − tasas) ÷ millas';
      }
    }

    [D, CB, TR].forEach(function (el) { el.addEventListener('change', render); });
    [CA, TX, Q].forEach(function (el) { el.addEventListener('input', render); });
    document.getElementById('ml-form').addEventListener('submit', function (e) { e.preventDefault(); render(); });
    render();
  })();
</script>
