---
/**
 * Flagship "Bonus del jugador por fase — Mundial 2026" — mockup bespoke.
 * Eje visual: la ESCALERA DE FASES (grupos → 16avos → octavos → cuartos →
 * semis → final → campeón) y cuánto acumula el jugador en cada escalón.
 *
 * Todos los números salen del motor real (mundial-2026-bonus-jugador-fase.ts):
 * las constantes PREMIO_FIFA_FASE / REPARTO / PLANTEL_SIZE no están exportadas,
 * así que en vez de duplicarlas a mano se corre la función para cada combinación
 * y se serializa el resultado:
 *   - FIFA[seleccion][fase]  = bonusFifaReparto
 *   - FED_BASE / FED_POR     = derivados de bonusFederacion con 0 y 1 titular
 *   - CMP[total]             = comparacionSueldo tal cual la devuelve el motor
 * El cliente recompone total = FIFA + (FED_BASE + FED_POR × titulares), que es
 * exactamente lo que hace el motor.
 */
import '../../styles/calc-batch-mockup.css';
import CalcMockupSeo from './CalcMockupSeo.astro';
import { mundial2026BonusJugadorFase } from '../../lib/formulas/mundial-2026-bonus-jugador-fase';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

const fieldOf = (id: string) => (calc.fields || []).find((f: any) => f.id === id);
const selecciones: Array<{ value: string; label: string }> = fieldOf('seleccion')?.options || [];
const fases: Array<{ value: string; label: string }> = fieldOf('faseMaxima')?.options || [];

const BANDERAS: Record<string, string> = {
  argentina: '🇦🇷', brasil: '🇧🇷', espana: '🇪🇸', francia: '🇫🇷', inglaterra: '🏴󠁧󠁢󠁥󠁮󠁧󠁿', otra: '🌍',
};
const FASE_CORTA: Record<string, string> = {
  grupos: 'Grupos', dieciseisavos: '16avos', octavos: 'Octavos', cuartos: 'Cuartos',
  semis: 'Semis', subcampeon: 'Final', campeon: 'Campeón',
};
const FASE_PIE: Record<string, string> = {
  grupos: 'Eliminado', dieciseisavos: 'Primera llave', octavos: 'Top 16', cuartos: 'Top 8',
  semis: '3.º/4.º puesto', subcampeon: 'Subcampeón', campeon: 'La copa',
};

// ── Serialización desde el motor real ───────────────────────────────────────
const FIFA: Record<string, Record<string, number>> = {};
const CMP: Record<string, string> = {};
for (const s of selecciones) {
  FIFA[s.value] = {};
  for (const f of fases) {
    for (let t = 0; t <= 8; t++) {
      const r = mundial2026BonusJugadorFase({ seleccion: s.value, faseMaxima: f.value, partidosTitular: t });
      FIFA[s.value][f.value] = r.bonusFifaReparto;
      CMP[String(r.totalEstimado)] = r.comparacionSueldo;
    }
  }
}
const fed0 = mundial2026BonusJugadorFase({ seleccion: 'argentina', faseMaxima: 'grupos', partidosTitular: 0 }).bonusFederacion;
const fed1 = mundial2026BonusJugadorFase({ seleccion: 'argentina', faseMaxima: 'grupos', partidosTitular: 1 }).bonusFederacion;
const FED_BASE = fed0;
const FED_POR = fed1 - fed0;

const DATA = { FIFA, CMP, FED_BASE, FED_POR, FASE_CORTA, FASE_PIE, ORDEN: fases.map((f) => f.value) };

// ── Estado inicial (SSR) ────────────────────────────────────────────────────
const D = { sel: 'argentina', fase: 'cuartos', tit: 5 };
const r0 = mundial2026BonusJugadorFase({ seleccion: D.sel, faseMaxima: D.fase, partidosTitular: D.tit });
const usd = (x: number) => 'USD ' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(x);
const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
const pasos = fases.map((f) => ({
  value: f.value,
  corta: FASE_CORTA[f.value],
  pie: FASE_PIE[f.value],
  total: FIFA[D.sel][f.value] + FED_BASE + FED_POR * D.tit,
}));
---

<main class="page hcm bj" data-bonus={JSON.stringify(DATA)}>
  <div class="crumb">Inicio / <a href="/categoria/deportes">Deportes</a> / Mundial 2026 / <b>Bonus del jugador por fase</b></div>

  <section class="hero">
    <div>
      <span class="tag">🏆 MUNDIAL 2026 · TORNEO FINALIZADO</span>
      <h1>Cuánto se llevó cada jugador, escalón por escalón</h1>
      <p>El Mundial cerró el 19 de julio de 2026 con España campeona. Elegí una selección y mirá cuánto cobró un jugador según hasta qué fase llegó su equipo: el reparto del premio FIFA más el bonus que paga su federación.</p>
    </div>
    <div class="hero-art">
      <div class="art-icon">💵</div>
      <div class="hero-stat"><span>Campeón · reparto por jugador</span><b>{usd(FIFA['argentina']?.campeon ?? 0)}</b></div>
    </div>
  </section>

  <section class="tool" id="calc">
    <form class="card" id="bj-form">
      <h2>Armá el caso</h2>
      <p class="sub">Selección, hasta dónde llegó y cuántos partidos jugó de titular.</p>

      <div class="field">
        <label for="bj-sel">Selección</label>
        <div class="control">
          <select id="bj-sel">
            {selecciones.map((o) => (
              <option value={o.value} selected={o.value === D.sel}>{BANDERAS[o.value] ? BANDERAS[o.value] + ' ' : ''}{o.label}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="field">
        <label for="bj-fase">Fase máxima que superó el equipo</label>
        <div class="control">
          <select id="bj-fase">
            {fases.map((o) => (
              <option value={o.value} selected={o.value === D.fase}>{o.label}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="field">
        <label for="bj-tit">Partidos jugados de titular <small>0 a 8</small></label>
        <div class="control">
          <input id="bj-tit" type="number" min="0" max="8" step="1" value={D.tit} />
          <span>partidos</span>
        </div>
      </div>

      <button class="cta" type="submit">Calcular el bonus →</button>
    </form>

    <article class="card result">
      <div>
        <div class="over">Total estimado bruto</div>
        <div class="big" id="bj-big">{usd(r0.totalEstimado)}</div>
        <p class="answer" id="bj-answer" set:html={bold(r0.comparacionSueldo)}></p>
        <div class="result-box">
          <span>Cómo se compone</span>
          <b id="bj-parts">{usd(r0.bonusFifaReparto)} + {usd(r0.bonusFederacion)}</b>
          <small id="bj-note">Reparto del premio FIFA entre los 26 convocados, más el bonus de federación (base + titularidades).</small>
        </div>
      </div>
      <div class="equation" id="bj-eq">reparto FIFA por jugador + base federación + USD {FED_POR / 1000}k × titularidades</div>
    </article>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>La escalera del torneo</h2>
      <p>Cuánto cobraba el mismo jugador en cada escalón, con los partidos de titular que elegiste.</p>
    </div>
    <div class="timeline" id="bj-timeline">
      {pasos.map((p) => (
        <article class={'step' + (p.value === D.fase ? ' on' : '')} data-fase={p.value}>
          <span>{p.corta}</span>
          <b>{usd(p.total)}</b>
          <em>{p.pie}</em>
        </article>
      ))}
    </div>
    <div class="notice">
      <span>📈</span>
      <div><b>El salto grande está en la final.</b>Pasar de subcampeón a campeón vale más que todos los escalones anteriores juntos: el premio FIFA al equipo campeón casi duplica al del finalista perdedor.</div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>La misma fase, distinta federación</h2>
      <p id="bj-tabla-sub">Lo que cobra un jugador de cada selección llegando a la fase elegida.</p>
    </div>
    <div class="table" id="bj-tabla">
      {selecciones.map((s) => (
        <div class="row" data-sel={s.value}>
          <div><b>{BANDERAS[s.value]} {s.label.split(' (')[0]}</b><br /><small>{(s.label.match(/\(([^)]+)\)/)?.[1] || '')}</small></div>
          <div><small>Reparto FIFA</small><br />{usd(FIFA[s.value][D.fase])}</div>
          <strong>{usd(FIFA[s.value][D.fase] + FED_BASE + FED_POR * D.tit)}</strong>
        </div>
      ))}
    </div>
    <div class="notice">
      <span>⚠️</span>
      <div><b>Son estimaciones, no contratos.</b>Los acuerdos entre federación y plantel son privados: estos montos surgen de los premios FIFA y de repartos declarados públicamente después de Qatar 2022. Todo es bruto, antes de impuestos.</div>
    </div>
  </section>

  <CalcMockupSeo calc={calc} related={related} icon="💵" />

  <footer class="sources">
    <div><b>Metodología</b><br />Reparto FIFA = premio del equipo en la fase × % de la federación ÷ 26 jugadores. Bonus federación = base de convocatoria + monto por partido de titular.</div>
    <div>Montos brutos en USD · Estimación orientativa</div>
  </footer>
</main>

<style is:global>
  .hcm.bj{--brand:#4a1836;--accent:#f7c948;--soft:#f7edf2}
  .hcm.bj .hero{background:linear-gradient(135deg,#3d1129,#7a2b52)}
  .hcm.bj .step{transition:border-color .15s,box-shadow .15s}
  .hcm.bj .step.on{border-color:var(--brand);box-shadow:0 8px 22px rgba(74,24,54,.16)}
  .hcm.bj .step.on em{color:#8a2b56}
  .hcm.bj .row small{font-size:12px}
  .hcm .crumb a{color:inherit;text-decoration:none}
  .hcm .crumb a:hover{text-decoration:underline}
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.hcm.bj');
    if (!root) return;
    var D = JSON.parse(root.getAttribute('data-bonus') || '{}');
    var selEl = document.getElementById('bj-sel');
    var faseEl = document.getElementById('bj-fase');
    var titEl = document.getElementById('bj-tit');

    var usd = function (x) { return 'USD ' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(x); };
    var bold = function (s) { return String(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>'); };

    function render() {
      var sel = selEl.value, fase = faseEl.value;
      // Mismas guardas que mundial-2026-bonus-jugador-fase.ts
      var tit = Math.max(0, Math.min(8, Math.floor(Number(titEl.value || 0)) || 0));
      var porSel = D.FIFA[sel];
      var big = document.getElementById('bj-big');
      var ans = document.getElementById('bj-answer');

      if (!porSel) { big.textContent = '—'; ans.textContent = 'Selección inválida.'; return; }
      if (typeof porSel[fase] !== 'number') { big.textContent = '—'; ans.textContent = 'Fase inválida.'; return; }

      var fifa = porSel[fase];
      var fed = D.FED_BASE + tit * D.FED_POR;
      var total = fifa + fed;

      big.textContent = usd(total);
      ans.innerHTML = bold(D.CMP[String(total)] || '');
      document.getElementById('bj-parts').textContent = usd(fifa) + ' + ' + usd(fed);
      document.getElementById('bj-note').textContent =
        'Reparto FIFA entre los 26 convocados + federación: ' + usd(D.FED_BASE) + ' de base y ' +
        usd(D.FED_POR) + ' por cada uno de los ' + tit + ' partido(s) de titular.';
      document.getElementById('bj-eq').innerHTML =
        usd(fifa) + ' + ' + usd(D.FED_BASE) + ' + ' + tit + ' × ' + usd(D.FED_POR) + ' = <b>' + usd(total) + '</b>';

      // Escalera de fases
      var steps = document.querySelectorAll('#bj-timeline .step');
      for (var i = 0; i < steps.length; i++) {
        var f = steps[i].getAttribute('data-fase');
        steps[i].querySelector('b').textContent = usd(porSel[f] + fed);
        steps[i].className = 'step' + (f === fase ? ' on' : '');
      }

      // Tabla por federación
      var rows = document.querySelectorAll('#bj-tabla .row');
      for (var j = 0; j < rows.length; j++) {
        var s = rows[j].getAttribute('data-sel');
        var rf = D.FIFA[s][fase];
        rows[j].children[1].innerHTML = '<small>Reparto FIFA</small><br>' + usd(rf);
        rows[j].children[2].textContent = usd(rf + fed);
      }

      var sub = document.getElementById('bj-tabla-sub');
      if (sub) sub.textContent = 'Con ' + tit + ' partido(s) de titular, llegando a ' +
        (D.FASE_CORTA[fase] || fase).toLowerCase() + '.';
    }

    [selEl, faseEl, titEl].forEach(function (el) {
      el.addEventListener('input', render);
      el.addEventListener('change', render);
    });
    document.getElementById('bj-form').addEventListener('submit', function (e) { e.preventDefault(); render(); });
    render();
  })();
</script>
