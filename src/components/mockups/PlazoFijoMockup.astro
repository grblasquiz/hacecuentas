---
/**
 * Flagship "Plazo fijo" — mockup bespoke.
 * El script inline replica src/lib/formulas/plazo-fijo.ts:
 *   interes = capital × (TNA/100) × (dias/365)
 *   montoFinal = capital + interes
 *   rendimientoPeriodo = interes/capital × 100
 *   TEA = ((1 + TNA/100/365)^365 − 1) × 100
 *   interesDiario = interes/dias · interesMensualEq = capital × TNA/100 × 30/365
 * Mismas guardas y mismos mensajes de error que la fórmula real.
 *
 * Diferencial: contraste contra la inflación (rendimiento REAL). La inflación
 * mensual y la TNA de referencia salen de src/data/live/*.json, no hardcodeadas.
 */
import '../../styles/calc-batch-mockup.css';
import CalcMockupSeo from './CalcMockupSeo.astro';
import tasas from '../../data/live/tasas.json';
import inflacion from '../../data/live/inflacion.json';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

const LIVE = {
  tna: Number((tasas as any).plazo_fijo_30d?.valor) || 0,
  tnaFecha: String((tasas as any).plazo_fijo_30d?.fecha || ''),
  badlar: Number((tasas as any).badlar?.valor) || 0,
  inflMes: Number((inflacion as any).last_month?.valor) || 0,
  inflFecha: String((inflacion as any).last_month?.fecha || ''),
  infl12: Number((inflacion as any).acumulado_12m_pct) || 0,
};

const D = { capital: 1000000, tna: LIVE.tna || 20.1, dias: 30 };

const money = (x: number) => '$' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(Math.round(x));
const pct = (x: number) => new Intl.NumberFormat('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(x) + '%';
const fecha = (iso: string) => {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return iso;
  const [y, m, d] = iso.split('-');
  return `${d}/${m}/${y}`;
};

// Valores del primer paint (mismos que calcula el script)
const interes0 = D.capital * (D.tna / 100) * (D.dias / 365);
const monto0 = D.capital + interes0;
const rend0 = (interes0 / D.capital) * 100;
const tea0 = (Math.pow(1 + D.tna / 100 / 365, 365) - 1) * 100;
const inflPeriodo0 = (Math.pow(1 + LIVE.inflMes / 100, D.dias / 30) - 1) * 100;
const real0 = ((1 + rend0 / 100) / (1 + inflPeriodo0 / 100) - 1) * 100;

const plazos = [30, 60, 90].map((d) => {
  const i = D.capital * (D.tna / 100) * (d / 365);
  const infl = (Math.pow(1 + LIVE.inflMes / 100, d / 30) - 1) * 100;
  const r = (i / D.capital) * 100;
  return { d, interes: i, rend: r, infl, real: ((1 + r / 100) / (1 + infl / 100) - 1) * 100 };
});
---

<main class="page hcm pf">
  <div class="crumb">Inicio / <a href="/categoria/finanzas">Finanzas</a> / <b>Plazo fijo</b></div>

  <section class="hero">
    <div>
      <span class="tag">🏦 TASA vs INFLACIÓN</span>
      <h1>¿Tu plazo fijo le gana a la inflación?</h1>
      <p>Calculá el interés a 30, 60 o 90 días y, sobre todo, cuánto te queda <b>en términos reales</b> una vez descontada la suba de precios.</p>
    </div>
    <div class="hero-art">
      <div class:list={['pf-dial', real0 < 0 && 'neg']} id="pf-dial" style={`--fill:${Math.max(4, Math.min(100, Math.abs(real0) * 12))}%`}>
        <div class="pf-dial-in">
          <span>Rendimiento real</span>
          <b id="pf-dial-val" class={real0 < 0 ? 'neg' : ''}>{pct(real0)}</b>
          <small id="pf-dial-lbl">a {D.dias} días</small>
        </div>
      </div>
      <div class="hero-stat">
        <span>TNA referencia BCRA</span><b>{pct(LIVE.tna)}</b>
        <small>al {fecha(LIVE.tnaFecha)}</small>
      </div>
    </div>
  </section>

  <section class="tool" id="calc">
    <form class="card" id="pf-form">
      <h2>Tu depósito</h2>
      <p class="sub">TNA precargada con la tasa de plazo fijo a 30 días que publica el BCRA ({fecha(LIVE.tnaFecha)}). Cambiala por la que te ofrece tu banco.</p>

      <div class="field">
        <label for="pf-capital">Capital a invertir</label>
        <div class="control"><span>$</span><input id="pf-capital" type="number" min="1000" step="10000" value={D.capital} /></div>
      </div>

      <div class="grid2">
        <div class="field">
          <label for="pf-tna">TNA</label>
          <div class="control"><input id="pf-tna" type="number" min="0.01" max="500" step="0.1" value={D.tna} /><span>%</span></div>
        </div>
        <div class="field">
          <label for="pf-dias">Plazo</label>
          <div class="control"><input id="pf-dias" type="number" min="30" max="365" step="1" value={D.dias} /><span>días</span></div>
        </div>
      </div>

      <div class="seg three" id="pf-seg">
        <button type="button" data-d="30" class="active">30 días</button>
        <button type="button" data-d="60">60 días</button>
        <button type="button" data-d="90">90 días</button>
      </div>

      <div class="field">
        <label for="pf-infl">Inflación mensual esperada <small>INDEC {fecha(LIVE.inflFecha)}: {pct(LIVE.inflMes)}</small></label>
        <div class="control"><input id="pf-infl" type="number" min="0" max="100" step="0.1" value={LIVE.inflMes} /><span>% / mes</span></div>
      </div>

      <button class="cta" type="submit">Calcular rendimiento →</button>
    </form>

    <article class="card result">
      <div>
        <div class="over">Monto final al vencimiento</div>
        <div class="big" id="pf-big">{money(monto0)}</div>
        <p class="answer" id="pf-answer">
          Ganás {money(interes0)} de interés ({pct(rend0)} del período). Descontada la inflación, tu poder de compra cambia {pct(real0)}.
        </p>
        <div class="pf-boxes">
          <div class="result-box">
            <span>Intereses ganados</span>
            <b id="pf-interes">{money(interes0)}</b>
            <small id="pf-diario">{money(interes0 / D.dias)} por día.</small>
          </div>
          <div class="result-box">
            <span>TEA equivalente</span>
            <b id="pf-tea">{pct(tea0)}</b>
            <small id="pf-mensual">Interés mensual equivalente: {money(D.capital * (D.tna / 100) * (30 / 365))}.</small>
          </div>
        </div>
      </div>
      <div class="equation" id="pf-eq">
        {money(D.capital)} × {D.tna}% × {D.dias}/365 = <b>{money(interes0)}</b>
      </div>
    </article>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Tasa contra inflación</h2>
      <p>Ganar plata en pesos no siempre es ganar poder de compra.</p>
    </div>
    <div class="pf-versus" id="pf-versus">
      <div class="pf-bar">
        <span>Rinde el plazo fijo</span>
        <div class="progress"><i id="pf-bar-tasa" style={`width:${Math.max(3, (rend0 / Math.max(rend0, inflPeriodo0, 0.01)) * 100)}%`}></i></div>
        <b id="pf-val-tasa">{pct(rend0)}</b>
      </div>
      <div class="pf-bar alt">
        <span>Sube la inflación</span>
        <div class="progress"><i id="pf-bar-infl" style={`width:${Math.max(3, (inflPeriodo0 / Math.max(rend0, inflPeriodo0, 0.01)) * 100)}%`}></i></div>
        <b id="pf-val-infl">{pct(inflPeriodo0)}</b>
      </div>
      <div class="pf-verdict" id="pf-verdict">
        <em id="pf-verdict-tag" class={real0 < 0 ? 'bad' : ''}>{real0 >= 0 ? 'Ganás en términos reales' : 'Perdés en términos reales'}</em>
        <b id="pf-verdict-val">{pct(real0)}</b>
        <small id="pf-verdict-txt">Equivale a {money(Math.abs((monto0 * real0) / 100))} de poder de compra {real0 >= 0 ? 'ganado' : 'perdido'} sobre el monto final.</small>
      </div>
    </div>
    <div class="notice">
      <span>📉</span>
      <div><b>El interés simple no se acelera con el plazo, la inflación sí.</b>A la misma TNA, 90 días pagan exactamente el triple que 30 días; los precios, en cambio, capitalizan mes a mes. Por eso plazos largos a tasa fija se vuelven más riesgosos cuando la inflación sube.</div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>30 vs 60 vs 90 días</h2>
      <p>Con {money(D.capital)} a TNA {pct(D.tna)} e inflación {pct(LIVE.inflMes)} mensual.</p>
    </div>
    <div class="timeline pf-three" id="pf-three">
      {plazos.map((p) => (
        <div class="step" data-plazo={p.d}>
          <span>{p.d} días</span>
          <b data-role="interes">{money(p.interes)}</b>
          <small data-role="rend">Nominal {pct(p.rend)} · inflación {pct(p.infl)}</small>
          <em data-role="real" class={p.real >= 0 ? 'ok' : 'bad'}>Real {pct(p.real)}</em>
        </div>
      ))}
    </div>
    <div class="cards" style="margin-top:13px">
      <article class="mini"><i>🔁</i><h3>Renovar capitaliza</h3><p>Dentro del plazo el banco no capitaliza: el interés compuesto aparece sólo si renovás sumando los intereses. Ahí la TEA le gana a la TNA.</p></article>
      <article class="mini"><i>🔒</i><h3>Plata inmovilizada</h3><p>El tradicional no se puede romper antes del vencimiento. Si podés necesitar la plata, mirá el pre-cancelable (paga 3 a 5 puntos menos).</p></article>
      <article class="mini"><i>🛡️</i><h3>Garantía SEDESA</h3><p>Los depósitos están cubiertos por el seguro de la Ley 24.485 hasta el tope vigente, por persona y por banco. Dividir montos grandes multiplica la cobertura.</p></article>
    </div>
  </section>

  <CalcMockupSeo calc={calc} related={related} icon="🏦" />

  <footer class="sources">
    <div>
      <b>Metodología</b><br />
      Interés = capital × TNA/100 × días/365 (interés simple, Comunicación BCRA "A" 3248) · TEA = (1 + TNA/365)<sup>365</sup> − 1.<br />
      Rendimiento real = (1 + rendimiento del período) ÷ (1 + inflación del período) − 1.<br />
      TNA de referencia BCRA al {fecha(LIVE.tnaFecha)} · inflación INDEC de {fecha(LIVE.inflFecha)} ({pct(LIVE.inflMes)} mensual; {pct(LIVE.infl12)} acumulado 12 meses).
    </div>
    <div>Resultado orientativo · Sin registro</div>
  </footer>
</main>

<style is:global>
  .hcm.pf{--brand:#2b1e46;--accent:#6ee7c0;--soft:#efeaf7}
  .hcm.pf .hero{background:linear-gradient(135deg,#2b1e46,#59407f)}
  .hcm .crumb a{color:inherit;text-decoration:none}
  .hcm .crumb a:hover{text-decoration:underline}
  .hcm.pf .pf-dial{width:210px;height:210px;border-radius:50%;display:grid;place-items:center;
    background:conic-gradient(var(--accent) 0 var(--fill,55%),rgba(255,255,255,.16) var(--fill,55%) 100%);
    box-shadow:0 18px 34px rgba(0,0,0,.25)}
  .hcm.pf .pf-dial.neg{--accent:#ff9d9d}
  .hcm.pf .pf-dial-in{width:154px;height:154px;border-radius:50%;background:#2b1e46;display:grid;place-items:center;text-align:center;padding:8px}
  .hcm.pf .pf-dial-in span{display:block;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#c3b6dd;font-weight:800}
  .hcm.pf .pf-dial-in b{display:block;font:800 30px/1.1 Manrope,system-ui,sans-serif;color:#6ee7c0;margin:4px 0}
  .hcm.pf .pf-dial-in b.neg{color:#ff9d9d}
  .hcm.pf .pf-dial-in small{color:#c3b6dd;font-size:12px}
  .hcm.pf .hero-stat{background:rgba(24,14,44,.85)}
  .hcm.pf .hero-stat span{font-size:12px;color:#c3b6dd}
  .hcm.pf .hero-stat small{display:block;color:#a496c2;font-size:11px}
  .hcm.pf .pf-boxes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:22px 0}
  .hcm.pf .pf-boxes .result-box{margin:0}
  .hcm.pf .pf-boxes .result-box small{color:#6b756f;font-size:12px;line-height:1.35;display:block}
  .hcm.pf .pf-versus{background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px;display:grid;gap:16px}
  .hcm.pf .pf-bar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 14px;align-items:center}
  .hcm.pf .pf-bar span{font-weight:700;font-size:14px}
  .hcm.pf .pf-bar b{grid-row:span 2;font:800 24px Manrope,system-ui,sans-serif;color:var(--brand);text-align:right}
  .hcm.pf .pf-bar .progress{margin:0;background:#e6e0f0}
  .hcm.pf .pf-bar i{background:var(--brand)}
  .hcm.pf .pf-bar.alt i{background:#e0709a}
  .hcm.pf .pf-verdict{border-top:1px solid #ece7f4;padding-top:16px}
  .hcm.pf .pf-verdict em{font-style:normal;font-weight:800;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#3f8f74}
  .hcm.pf .pf-verdict em.bad{color:#b23a55}
  .hcm.pf .pf-verdict b{display:block;font:800 40px/1 Manrope,system-ui,sans-serif;color:var(--brand);margin:6px 0}
  .hcm.pf .pf-verdict small{color:var(--muted)}
  .hcm.pf .pf-three{grid-template-columns:repeat(3,minmax(0,1fr))}
  .hcm.pf .pf-three .step small{display:block;color:var(--muted);font-size:12px;margin-bottom:8px}
  .hcm.pf .pf-three em.ok{color:#2f7d64}
  .hcm.pf .pf-three em.bad{color:#b23a55}
  @media(max-width:760px){
    .hcm.pf .pf-three{grid-template-columns:1fr}
    .hcm.pf .pf-boxes{grid-template-columns:1fr}
    .hcm.pf .pf-dial{width:172px;height:172px}
    .hcm.pf .pf-dial-in{width:126px;height:126px}
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.hcm.pf');
    if (!root) return;
    var nf0 = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 });
    var nf2 = new Intl.NumberFormat('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    var money = function (x) { return '$' + nf0.format(Math.round(x)); };
    var pct = function (x) { return nf2.format(x) + '%'; };
    var el = function (id) { return document.getElementById(id); };
    var n = function (id) { return Number(el(id).value); };

    var ids = ['pf-capital', 'pf-tna', 'pf-dias', 'pf-infl'];

    function fail(msg) {
      el('pf-big').textContent = '—';
      el('pf-answer').textContent = msg;
      el('pf-interes').textContent = '—'; el('pf-diario').textContent = '';
      el('pf-tea').textContent = '—'; el('pf-mensual').textContent = '';
      el('pf-eq').innerHTML = 'capital × TNA/100 × días/365';
      el('pf-dial-val').textContent = '—'; el('pf-dial-lbl').textContent = '';
      el('pf-verdict-val').textContent = '—'; el('pf-verdict-txt').textContent = '';
      el('pf-val-tasa').textContent = '—'; el('pf-val-infl').textContent = '—';
      el('pf-bar-tasa').style.width = '0%'; el('pf-bar-infl').style.width = '0%';
    }

    function render() {
      var capital = n('pf-capital'), tna = n('pf-tna'), dias = n('pf-dias');
      var inflMes = n('pf-infl') || 0;

      // Mismas guardas y mensajes que src/lib/formulas/plazo-fijo.ts
      if (!capital || capital <= 0) return fail('Ingresá el capital a invertir');
      if (!tna || tna <= 0) return fail('Ingresá la TNA (tasa nominal anual)');
      if (!dias || dias < 1) return fail('Ingresá los días del plazo (mínimo 30)');

      var tnaDec = tna / 100;
      var interes = capital * tnaDec * (dias / 365);
      var monto = capital + interes;
      var rend = (interes / capital) * 100;
      var tea = (Math.pow(1 + tnaDec / 365, 365) - 1) * 100;
      var interesDiario = interes / dias;
      var interesMensualEq = capital * tnaDec * (30 / 365);

      var inflPer = (Math.pow(1 + inflMes / 100, dias / 30) - 1) * 100;
      var real = ((1 + rend / 100) / (1 + inflPer / 100) - 1) * 100;

      el('pf-big').textContent = money(monto);
      el('pf-answer').textContent = 'Ganás ' + money(interes) + ' de interés (' + pct(rend) +
        ' del período). Descontada la inflación, tu poder de compra cambia ' + pct(real) + '.';
      el('pf-interes').textContent = money(interes);
      el('pf-diario').textContent = money(interesDiario) + ' por día.';
      el('pf-tea').textContent = pct(tea);
      el('pf-mensual').textContent = 'Interés mensual equivalente: ' + money(interesMensualEq) + '.';
      el('pf-eq').innerHTML = money(capital) + ' × ' + nf2.format(tna) + '% × ' + nf0.format(dias) +
        '/365 = <b>' + money(interes) + '</b>';

      // Dial del hero
      var dial = el('pf-dial');
      var fill = Math.max(4, Math.min(100, Math.abs(real) * 12));
      dial.style.setProperty('--fill', fill + '%');
      dial.classList.toggle('neg', real < 0);
      var dv = el('pf-dial-val');
      dv.textContent = pct(real);
      dv.classList.toggle('neg', real < 0);
      el('pf-dial-lbl').textContent = 'a ' + nf0.format(dias) + ' días';

      // Barras tasa vs inflación
      var max = Math.max(rend, inflPer, 0.01);
      el('pf-bar-tasa').style.width = Math.max(3, (rend / max) * 100) + '%';
      el('pf-bar-infl').style.width = Math.max(3, (inflPer / max) * 100) + '%';
      el('pf-val-tasa').textContent = pct(rend);
      el('pf-val-infl').textContent = pct(inflPer);

      var tag = el('pf-verdict-tag');
      tag.textContent = real >= 0 ? 'Ganás en términos reales' : 'Perdés en términos reales';
      tag.classList.toggle('bad', real < 0);
      el('pf-verdict-val').textContent = pct(real);
      el('pf-verdict-txt').textContent = 'Equivale a ' + money(Math.abs(monto * real / 100)) +
        ' de poder de compra ' + (real >= 0 ? 'ganado' : 'perdido') + ' sobre el monto final.';

      // Comparativa 30 / 60 / 90
      Array.prototype.forEach.call(root.querySelectorAll('#pf-three .step'), function (step) {
        var d = Number(step.getAttribute('data-plazo'));
        var i = capital * tnaDec * (d / 365);
        var r = (i / capital) * 100;
        var inf = (Math.pow(1 + inflMes / 100, d / 30) - 1) * 100;
        var rl = ((1 + r / 100) / (1 + inf / 100) - 1) * 100;
        step.querySelector('[data-role=interes]').textContent = money(i);
        step.querySelector('[data-role=rend]').textContent = 'Nominal ' + pct(r) + ' · inflación ' + pct(inf);
        var em = step.querySelector('[data-role=real]');
        em.textContent = 'Real ' + pct(rl);
        em.className = rl >= 0 ? 'ok' : 'bad';
      });

      Array.prototype.forEach.call(root.querySelectorAll('#pf-seg button'), function (b) {
        b.classList.toggle('active', Number(b.getAttribute('data-d')) === dias);
      });
    }

    ids.forEach(function (id) { el(id).addEventListener('input', render); });
    Array.prototype.forEach.call(root.querySelectorAll('#pf-seg button'), function (b) {
      b.addEventListener('click', function () { el('pf-dias').value = b.getAttribute('data-d'); render(); });
    });
    el('pf-form').addEventListener('submit', function (e) { e.preventDefault(); render(); });
    render();
  })();
</script>
