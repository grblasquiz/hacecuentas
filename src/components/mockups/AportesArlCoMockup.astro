---
/**
 * Flagship "Aportes ARL Colombia" — mockup bespoke.
 * El script inline replica aportes-arl-colombia-empleador-empleado-riesgo.ts:
 *   clase   = mapa actividad→clase (dataset Decreto 1607/2002) || clase elegida || 'I'
 *   tarifa  = COLOMBIA_2026.aportes.arl[clase]
 *   aporte  = salario × tarifa   (100% empleador; empleado = 0)
 *   anual   = aporte × 12        ·  empresa = anual × trabajadores (mín. 1)
 * Las tarifas y el mapa actividad→clase se serializan desde los módulos reales.
 */
import '../../styles/calc-batch-mockup.css';
import CalcMockupSeo from './CalcMockupSeo.astro';
import { COLOMBIA_2026 } from '../../lib/data/colombia-2026';
import arlActividades from '../../data/arl-actividades-co.json';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

const ARL: Record<string, number> = COLOMBIA_2026.aportes.arl as any;

// Mismo mapa legacy + data-driven que la fórmula real.
const actividadAClaseLegacy: Record<string, string> = {
  oficina_servicios: 'I',
  comercio_restaurante: 'II',
  transporte_pasajeros: 'II',
  salud_asistencial: 'III',
  construccion_liviana: 'III',
  manufactura_metalmecanica: 'IV',
  trabajo_alturas: 'V',
  mineria_explosivos: 'V',
};
const ACT_CLASE: Record<string, string> = { ...actividadAClaseLegacy };
for (const a of ((arlActividades as any)?.actividades || [])) {
  if (a?.id && ARL[a.claseRiesgo] !== undefined) ACT_CLASE[a.id] = a.claseRiesgo;
}

const DESC: Record<string, string> = {
  I: 'Clase I - Riesgo Mínimo (0,522%). Oficinas, servicios financieros, educación',
  II: 'Clase II - Riesgo Bajo (1,044%). Comercio, servicios, transporte',
  III: 'Clase III - Riesgo Medio (2,436%). Construcción liviana, gastronomía, textiles',
  IV: 'Clase IV - Riesgo Alto (4,350%). Manufactura pesada, metalmecánica, química',
  V: 'Clase V - Riesgo Máximo (6,960%). Minería, explosivos, trabajo en alturas',
};
const NOMBRE: Record<string, string> = {
  I: 'Riesgo mínimo', II: 'Riesgo bajo', III: 'Riesgo medio', IV: 'Riesgo alto', V: 'Riesgo máximo',
};
const OFICIOS: Record<string, string> = {
  I: 'Oficinas, bancos, educación, servicios profesionales',
  II: 'Comercio, hotelería, restaurantes, transporte de pasajeros',
  III: 'Construcción liviana, gastronomía, textiles, imprenta',
  IV: 'Manufactura pesada, metalmecánica, química, papel',
  V: 'Minería, explosivos, obra civil pesada, trabajo en alturas',
};
const CLASES = ['I', 'II', 'III', 'IV', 'V'];
const pct = (c: string) => Math.round(ARL[c] * 100000) / 1000;

const actividadField = (calc.fields || []).find((f: any) => f.id === 'actividad_riesgo');
const opciones = actividadField?.options || [];

// SSR: mismos defaults del JSON (salario 2.500.000, actividad manual, clase III de ejemplo).
const D = { salario: 2500000, clase: 'III', trabajadores: 1 };
const money = (x: number) => '$' + Math.round(x).toLocaleString('es-CO');
const aporte0 = D.salario * ARL[D.clase];
---

<main class="page hcm arl">
  <div class="crumb">Inicio / <a href="/co">Colombia</a> / <b>Aportes ARL por clase de riesgo</b></div>

  <section class="hero">
    <div>
      <span class="tag">🦺 RIESGOS LABORALES · COLOMBIA</span>
      <h1>¿Cuánto se paga de ARL según la clase de riesgo?</h1>
      <p>La tarifa va de 0,522% a 6,96% del salario según la actividad, y la paga <b>100% el empleador</b>: al trabajador no se le descuenta un peso.</p>
    </div>
    <div class="hero-art">
      <div class="art-icon">🦺</div>
      <div class="hero-stat"><span>De oficina a minería</span><b>13× más caro</b></div>
    </div>
  </section>

  <section class="tool" id="calc">
    <form class="card" id="arl-form">
      <h2>Su aporte a la ARL</h2>
      <p class="sub">Elija la actividad y la calculadora sugiere la clase de riesgo; si no, marque la clase a mano.</p>

      <div class="field">
        <label for="arl-salario">Salario base mensual (IBC)</label>
        <div class="control"><span>$</span><input id="arl-salario" type="number" min="0" step="any" value={D.salario} /><span>COP</span></div>
        <small class="hint">IBC mensual por trabajador, en pesos colombianos.</small>
      </div>

      <div class="field">
        <label for="arl-actividad">¿Qué actividad realiza?</label>
        <div class="control">
          <select id="arl-actividad">
            {opciones.map((o: any) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
        <small class="hint">La actividad sugiere una clase I–V. Confírmela con el código CIIU y su ARL.</small>
      </div>

      <div class="field" id="arl-clase-wrap">
        <label for="arl-clase">Clase de riesgo</label>
        <div class="seg five" id="arl-seg">
          {CLASES.map((c) => (
            <button type="button" data-clase={c} class={c === D.clase ? 'active' : ''}>{c}</button>
          ))}
        </div>
        <select id="arl-clase" class="sr-select" tabindex="-1" aria-hidden="true">
          {CLASES.map((c) => <option value={c} selected={c === D.clase}>{`Clase ${c}`}</option>)}
        </select>
        <small class="hint">Solo hace falta elegirla a mano si no seleccionó una actividad.</small>
      </div>

      <div class="field">
        <label for="arl-trab">Cantidad de trabajadores</label>
        <div class="control"><input id="arl-trab" type="number" min="1" step="1" value={D.trabajadores} /><span>pers.</span></div>
      </div>

      <button class="cta" type="submit">Calcular aporte ARL →</button>
    </form>

    <article class="card result">
      <div>
        <div class="over">Aporte mensual · lo paga el empleador</div>
        <div class="big" id="arl-big">{money(aporte0)}</div>
        <p class="answer" id="arl-answer">Clase {D.clase} ({pct(D.clase).toString().replace('.', ',')}%): {DESC[D.clase]}.</p>
        <div class="payer">
          <div class="who"><span>Empleador</span><b id="arl-emp">{money(aporte0)}</b></div>
          <div class="who zero"><span>Trabajador</span><b id="arl-trabajador">$0</b></div>
        </div>
        <div class="result-box">
          <span>Costo anual de toda la empresa</span>
          <b id="arl-anual-empresa">{money(aporte0 * 12 * D.trabajadores)}</b>
          <small id="arl-note">{money(aporte0 * 12)} al año por cada trabajador.</small>
        </div>
      </div>
      <div class="equation" id="arl-eq">{money(D.salario)} × {pct(D.clase).toString().replace('.', ',')}% = <b>{money(aporte0)}/mes</b></div>
    </article>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>La escalera de las cinco clases</h2>
      <p>Mismo salario, cinco precios. La clase la define la actividad, no el cargo.</p>
    </div>
    <div class="ladder" id="arl-ladder">
      {CLASES.map((c, idx) => (
        <div class={'rung' + (c === D.clase ? ' on' : '')} data-clase={c}>
          <div class="rung-bar" style={`height:${18 + idx * 20}px`}></div>
          <div class="rung-body">
            <span class="rung-num">Clase {c}</span>
            <b class="rung-pct">{pct(c).toString().replace('.', ',')}%</b>
            <em>{NOMBRE[c]}</em>
            <p>{OFICIOS[c]}</p>
          </div>
          <div class="rung-cost">
            <span>con su salario</span>
            <strong data-cost={c}>{money(D.salario * ARL[c])}</strong>
            <small>por mes</small>
          </div>
        </div>
      ))}
    </div>
    <div class="notice">
      <span>🚫</span>
      <div><b>Si en el desprendible aparece un descuento por ARL, es un error.</b>La cotización de riesgos laborales está 100% a cargo del empleador (Decreto-Ley 1295 de 1994, art. 16), a diferencia de salud y pensión, donde el trabajador sí aporta 4% + 4%.</div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Tres cosas antes de liquidar</h2>
      <p>Lo que más se equivoca en nómina y en las propuestas de contratación.</p>
    </div>
    <div class="cards">
      <article class="mini"><i>🏷️</i><h3>La clase sale del CIIU</h3><p>La actividad económica principal define la clase (Decreto 1607 de 2002). Si el CIIU declarado no coincide con la actividad real, la ARL puede reclasificar y cobrar retroactivos.</p></article>
      <article class="mini"><i>📉</i><h3>La tarifa se mueve</h3><p>Lo que muestra la calculadora es la cotización inicial de la clase. Con buen SG-SST y baja siniestralidad puede bajar dentro del rango; con accidentalidad alta, sube.</p></article>
      <article class="mini"><i>🧾</i><h3>Independientes</h3><p>Con contrato de prestación de servicios se cotiza sobre el 40% del ingreso vía PILA. En riesgo I a III paga el contratista; en riesgo IV y V, el contratante.</p></article>
    </div>
  </section>

  <CalcMockupSeo calc={calc} related={related} icon="🦺" base="/co" />

  <footer class="sources">
    <div><b>Metodología</b><br />Aporte ARL = salario mensual (IBC) × tarifa de la clase de riesgo (Decreto 1772 de 1994). Anual = ×12 × número de trabajadores.</div>
    <div>Resultado orientativo · Sin registro</div>
  </footer>
</main>

<style is:global>
  .hcm.arl{--brand:#1b2540;--accent:#ffb703;--soft:#eef1f8}
  .hcm.arl .hero{background:linear-gradient(135deg,#1b2540,#3b4a78)}
  .hcm.arl .cta{color:#2a1d00}
  .hcm.arl .tag{background:var(--accent);color:#2a1d00}
  .hcm .crumb a{color:inherit;text-decoration:none}
  .hcm .crumb a:hover{text-decoration:underline}
  .hcm.arl .hint{display:block;color:var(--muted);font-size:13px;margin-top:7px;line-height:1.4}
  .hcm.arl .seg.five{grid-template-columns:repeat(5,minmax(0,1fr))}
  .hcm.arl .seg button{padding:12px 4px;font-family:Manrope,system-ui,sans-serif}
  .hcm.arl .sr-select{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
  .hcm.arl .payer{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;margin-top:20px}
  .hcm.arl .payer .who{background:rgba(255,255,255,.09);border:1px solid #ffffff2e;border-radius:14px;padding:13px}
  .hcm.arl .payer .who span{display:block;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#b9c4e2;font-weight:800}
  .hcm.arl .payer .who b{display:block;font:800 22px Manrope,system-ui,sans-serif;color:#fff;margin-top:5px;overflow-wrap:anywhere}
  .hcm.arl .payer .who.zero b{color:#8fe3b0}
  .hcm.arl .ladder{display:grid;gap:9px}
  .hcm.arl .rung{display:grid;grid-template-columns:14px minmax(0,1fr) auto;gap:16px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px 18px;transition:border-color .15s,box-shadow .15s}
  .hcm.arl .rung.on{border-color:var(--brand);box-shadow:0 10px 26px rgba(27,37,64,.14);background:var(--soft)}
  .hcm.arl .rung-bar{width:14px;border-radius:7px;background:linear-gradient(180deg,#ffb703,#e07b00)}
  .hcm.arl .rung-num{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .hcm.arl .rung-pct{display:inline-block;font:800 26px Manrope,system-ui,sans-serif;color:var(--brand);margin-right:9px}
  .hcm.arl .rung-body em{font-style:normal;font-weight:700;color:#3a4766}
  .hcm.arl .rung-body p{margin:5px 0 0;color:var(--muted);font-size:14px;line-height:1.45}
  .hcm.arl .rung-cost{text-align:right;min-width:0}
  .hcm.arl .rung-cost span,.hcm.arl .rung-cost small{display:block;font-size:11px;color:var(--muted)}
  .hcm.arl .rung-cost strong{display:block;font:800 19px Manrope,system-ui,sans-serif;color:var(--brand);overflow-wrap:anywhere}
  @media(max-width:760px){
    .hcm.arl .rung{grid-template-columns:10px minmax(0,1fr);gap:12px;padding:14px}
    .hcm.arl .rung-bar{height:100%!important;min-height:46px}
    .hcm.arl .rung-cost{grid-column:2;text-align:left;border-top:1px solid var(--line);padding-top:9px}
    .hcm.arl .rung-cost span,.hcm.arl .rung-cost small{display:inline}
    .hcm.arl .payer{grid-template-columns:minmax(0,1fr)}
  }
</style>

<script is:inline define:vars={{ ARL, ACT_CLASE, DESC }}>
  (function () {
    var root = document.querySelector('.hcm.arl');
    if (!root) return;
    var money = function (x) { return '$' + Math.round(x).toLocaleString('es-CO'); };
    var pct = function (c) { return String(Math.round(ARL[c] * 100000) / 1000).replace('.', ','); };

    var salarioEl = document.getElementById('arl-salario');
    var actEl = document.getElementById('arl-actividad');
    var claseEl = document.getElementById('arl-clase');
    var trabEl = document.getElementById('arl-trab');
    var seg = document.getElementById('arl-seg');

    function render() {
      // Réplica de compute() en aportes-arl-colombia-empleador-empleado-riesgo.ts
      var claseSugerida = ACT_CLASE[String(actEl.value || '')];
      var claseBase = claseSugerida || claseEl.value;
      var clase = ARL[claseBase] !== undefined ? claseBase : 'I';
      var tarifa = ARL[clase];
      var trabRaw = trabEl.value;
      var numTrabajadores = trabRaw === '' ? 1 : Math.max(1, Number(trabRaw));
      var salario = Math.max(0, Number(salarioEl.value) || 0);

      var aporteEmpleador = salario * tarifa;
      var aporteAnual = aporteEmpleador * 12;
      var costoEmpresa = aporteAnual * numTrabajadores;

      document.getElementById('arl-big').textContent = money(aporteEmpleador);
      document.getElementById('arl-emp').textContent = money(aporteEmpleador);
      document.getElementById('arl-trabajador').textContent = '$0';
      document.getElementById('arl-anual-empresa').textContent = money(costoEmpresa);
      document.getElementById('arl-note').textContent = salario > 0
        ? money(aporteAnual) + ' al año por cada trabajador.'
        : 'Ingrese el salario base mensual para ver el aporte.';
      document.getElementById('arl-answer').textContent =
        (claseSugerida ? 'La actividad elegida sugiere ' : '') + DESC[clase] + '.';
      document.getElementById('arl-eq').innerHTML =
        money(salario) + ' × ' + pct(clase) + '% = <b>' + money(aporteEmpleador) + '/mes</b>';

      // Sincronizar selector y escalera con la clase efectiva
      claseEl.value = clase;
      Array.prototype.forEach.call(seg.querySelectorAll('button'), function (b) {
        b.classList.toggle('active', b.getAttribute('data-clase') === clase);
      });
      Array.prototype.forEach.call(root.querySelectorAll('.rung'), function (r) {
        var c = r.getAttribute('data-clase');
        r.classList.toggle('on', c === clase);
        r.querySelector('[data-cost]').textContent = money(salario * ARL[c]);
      });
      document.getElementById('arl-clase-wrap').style.opacity = claseSugerida ? '.55' : '1';
    }

    Array.prototype.forEach.call(seg.querySelectorAll('button'), function (b) {
      b.addEventListener('click', function () {
        claseEl.value = b.getAttribute('data-clase');
        actEl.value = 'manual';
        render();
      });
    });
    [salarioEl, trabEl].forEach(function (el) { el.addEventListener('input', render); });
    actEl.addEventListener('change', render);
    document.getElementById('arl-form').addEventListener('submit', function (e) { e.preventDefault(); render(); });
    render();
  })();
</script>
