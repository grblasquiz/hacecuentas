---
/**
 * Mockup bespoke de "IMC infantil con percentiles OMS" (slug
 * calculadora-imc-infantil-percentil). Prefijo CSS/ids: `pk`.
 *
 * MOTOR: replica EXACTAMENTE src/lib/formulas/imc-infantil-percentil.ts
 *   IMC = peso / (talla/100)²  ·  cortes P5/P50/P85/P97 interpolados linealmente
 *   entre las edades tabuladas  ·  mismas guardas y mismos textos de error.
 *
 * Las tablas de percentiles NO se duplican a mano: se leen del propio módulo de
 * la fórmula (exportadas desde el .ts). Ojo: esta calc NO usa las tablas
 * LMS de `_cdc-bmi-lms.ts` (esas son de la calc hermana, IMC pediátrico CDC);
 * tiene sus propias tablas OMS P5/P50/P85/P97 embebidas en el .ts.
 *
 * YMYL — SALUD INFANTIL: se conserva el tono prudente del JSON. La
 * recomendación que se muestra es literalmente la que devuelve el motor
 * (siempre remite al pediatra), y se suma el aviso de que el resultado es
 * orientativo y no reemplaza el criterio médico. No se inventan rangos ni
 * diagnósticos: todo sale de la fórmula.
 *
 * Diferencia deliberada con `ImcPediatricoCdc.astro` (calc hermana, hay
 * canibalización conocida): otro sistema de CSS (.hcm en vez de .cf-*), paleta
 * índigo/ámbar en vez del navy, y como pieza central una BANDA DE PERCENTILES
 * horizontal a escala real con marcador, en lugar de tiles + barras de umbral.
 */
import '../../styles/calc-batch-mockup.css';
import CalcMockupSeo from './CalcMockupSeo.astro';
import { imcVaron, imcMujer } from '../../lib/formulas/imc-infantil-percentil';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

// Tablas OMS importadas del motor real: misma referencia, no una copia.
const TABLA_M = imcVaron;
const TABLA_F = imcMujer;

// ── Espejo del motor (mismo algoritmo de interpolación) ──────────────────────
function cortes(edad: number, sexo: string) {
  const tabla = sexo === 'f' ? TABLA_F : TABLA_M;
  const edades = Object.keys(tabla).map(Number).sort((a, b) => a - b);
  let lower = edades[0];
  let upper = edades[edades.length - 1];
  for (let k = 0; k < edades.length; k++) {
    if (edades[k] <= edad) lower = edades[k];
    if (edades[k] >= edad) { upper = edades[k]; break; }
  }
  const low = tabla[lower];
  const up = tabla[upper];
  const interp = (a: number, b: number) => (upper === lower ? a : a + (b - a) * ((edad - lower) / (upper - lower)));
  return { p5: interp(low[0], up[0]), p50: interp(low[1], up[1]), p85: interp(low[2], up[2]), p97: interp(low[3], up[3]) };
}

const SEG = ['Bajo peso', 'Peso saludable', 'Sobrepeso', 'Obesidad'];
const TXT: Record<string, { pct: string; cls: string; rec: string }> = {
  bajo: { pct: '< percentil 5', cls: 'Bajo peso', rec: 'Consultá con el pediatra para evaluar causas y plan nutricional.' },
  normal: { pct: 'percentil 5-84 (normal)', cls: 'Peso saludable', rec: 'Peso adecuado para la edad. Seguí con alimentación variada y actividad física.' },
  sobre: { pct: 'percentil 85-96', cls: 'Sobrepeso', rec: 'Consultá con el pediatra. Más actividad física y menos ultraprocesados.' },
  obeso: { pct: '≥ percentil 97', cls: 'Obesidad', rec: 'Consultá con pediatra y nutricionista. Plan de alimentación + actividad física.' },
};

function clasificar(imc: number, c: { p5: number; p85: number; p97: number }) {
  if (imc < c.p5) return TXT.bajo;
  if (imc < c.p85) return TXT.normal;
  if (imc < c.p97) return TXT.sobre;
  return TXT.obeso;
}

// Geometría de la banda: mismos límites que el `_chart` del motor.
function banda(imc: number, c: { p5: number; p85: number; p97: number }) {
  const imcVal = Number(imc.toFixed(1));
  const r1 = Number(c.p5.toFixed(1));
  const r2 = Number(c.p85.toFixed(1));
  const r3 = Number(c.p97.toFixed(1));
  const min = Math.min(10, Math.floor(r1));
  const max = Math.max(r3 + 4, Math.ceil(imcVal) + 2);
  const span = max - min;
  const pos = (v: number) => Math.max(0, Math.min(100, ((v - min) / span) * 100));
  return {
    min, max, r1, r2, r3, imcVal,
    w: [pos(r1), pos(r2) - pos(r1), pos(r3) - pos(r2), 100 - pos(r3)],
    marker: pos(imcVal),
  };
}

// ── Caso inicial = el ejemplo documentado del JSON (varón de 7 años, 25 kg, 122 cm)
const D = { peso: 25, talla: 122, edad: 7, sexo: 'm' };
const c0 = cortes(D.edad, D.sexo);
const imc0 = D.peso / ((D.talla / 100) * (D.talla / 100));
const cls0 = clasificar(imc0, c0);
const b0 = banda(imc0, c0);

const n1 = (n: number) => n.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const refAges = [2, 4, 6, 8, 10, 12, 14, 16, 18];
const refRows = refAges.map((a) => ({ edad: a, ...cortes(a, D.sexo) }));
---

<main class="page hcm pk" data-tm={JSON.stringify(TABLA_M)} data-tf={JSON.stringify(TABLA_F)}>
  <div class="crumb">Inicio / <a href="/categoria/salud">Salud</a> / <b>IMC infantil y percentil</b></div>

  <section class="hero">
    <div>
      <span class="tag">👶 PERCENTILES OMS · 2 A 18 AÑOS</span>
      <h1>¿Qué significa el percentil de IMC de tu hijo?</h1>
      <p>En chicos el IMC no se lee con los rangos del adulto: se compara con las tablas de la OMS para su edad y su sexo. Acá ves dónde cae, y qué preguntar en el próximo control.</p>
    </div>
    <div class="hero-art">
      <div class="art-icon">📊</div>
      <div class="hero-stat"><span>Exceso de peso 5 a 17 años (ENNyS 2)</span><b>41,1%</b></div>
    </div>
  </section>

  <section class="tool" id="calc">
    <form class="card" id="pk-form">
      <h2>Datos del chico o la chica</h2>
      <p class="sub">Peso, talla, edad y sexo. Nada se guarda ni se envía.</p>
      <div class="grid2">
        <div class="field">
          <label for="pk-peso">Peso</label>
          <div class="control"><input id="pk-peso" type="number" inputmode="decimal" min="5" max="120" step="0.1" value={D.peso} /><span>kg</span></div>
        </div>
        <div class="field">
          <label for="pk-talla">Talla</label>
          <div class="control"><input id="pk-talla" type="number" inputmode="decimal" min="60" max="200" step="0.1" value={D.talla} /><span>cm</span></div>
        </div>
      </div>
      <div class="grid2">
        <div class="field">
          <label for="pk-edad">Edad <small>2 a 18 años</small></label>
          <div class="control"><input id="pk-edad" type="number" inputmode="decimal" min="2" max="18" step="0.5" value={D.edad} /><span>años</span></div>
        </div>
        <div class="field">
          <label for="pk-sexo">Sexo</label>
          <div class="control">
            <select id="pk-sexo">
              <option value="m" selected>Varón</option>
              <option value="f">Mujer</option>
            </select>
          </div>
        </div>
      </div>
      <p class="pk-help">Las tablas OMS son distintas para varones y mujeres: el mismo IMC puede dar percentiles diferentes. Para menores de 2 años el indicador no es el IMC, sino el peso para la longitud.</p>
      <button class="cta" type="submit">Ver el percentil →</button>
    </form>

    <article class="card result">
      <div>
        <div class="over">IMC calculado</div>
        <div class="big" id="pk-big">{n1(b0.imcVal)} <small>kg/m²</small></div>
        <p class="answer" id="pk-answer">Un IMC de {n1(b0.imcVal)} en un varón de {D.edad} años cae en {cls0.pct}.</p>
        <div class="result-box">
          <span id="pk-box-label">Clasificación · {cls0.pct}</span>
          <b id="pk-cls">{cls0.cls}</b>
          <small id="pk-rec">{cls0.rec}</small>
        </div>
      </div>
      <div class="equation" id="pk-eq">
        {n1(D.peso)} kg ÷ ({n1(D.talla / 100)} m)² = <b>{n1(b0.imcVal)} kg/m²</b> · corte P85 a esa edad: {n1(b0.r2)}
      </div>
    </article>
  </section>

  <!-- ── Pieza central: banda de percentiles a escala con marcador ─────────── -->
  <section class="section">
    <div class="section-head">
      <h2>Dónde cae en la banda</h2>
      <p id="pk-band-ctx">Cortes OMS para varón de {D.edad} años.</p>
    </div>
    <div class="pk-band-card">
      <div class="pk-band" role="img" aria-label="Escala de IMC infantil según percentiles OMS para la edad y sexo" id="pk-band">
        <div class="pk-zones" id="pk-zones">
          {b0.w.map((w, i) => (
            <div class={`pk-zone z${i}`} style={`width:${w.toFixed(2)}%`}><span>{SEG[i]}</span></div>
          ))}
        </div>
        <div class="pk-marker" id="pk-marker" style={`left:${b0.marker.toFixed(2)}%`}>
          <b id="pk-marker-val">IMC {n1(b0.imcVal)}</b>
        </div>
        <div class="pk-ticks" id="pk-ticks">
          <i style={`left:0%`}><em>{n1(b0.min)}</em></i>
          <i style={`left:${b0.w[0].toFixed(2)}%`}><em>P5 · {n1(b0.r1)}</em></i>
          <i style={`left:${(b0.w[0] + b0.w[1]).toFixed(2)}%`}><em>P85 · {n1(b0.r2)}</em></i>
          <i style={`left:${(b0.w[0] + b0.w[1] + b0.w[2]).toFixed(2)}%`}><em>P97 · {n1(b0.r3)}</em></i>
        </div>
      </div>
      <p class="pk-band-note">
        Cada zona es un tramo de percentil de IMC para edad, no un rango fijo de adulto: los cortes se corren con la edad.
        Un chico en el percentil 60 no está “mejor” que uno en el 40 — los dos están en rango saludable.
      </p>
    </div>

    <div class="notice">
      <span>🩺</span>
      <div>
        <b>Este resultado es orientativo y no reemplaza el criterio del pediatra.</b>
        La calculadora no ve al chico, no evalúa su desarrollo puberal ni su historia clínica. Llevá el número al control:
        sirve para hacer preguntas más concretas, no para decidir solo. Nunca pongas a un niño a dieta por tu cuenta.
      </div>
    </div>
  </section>

  <!-- ── Tres advertencias de lectura ───────────────────────────────────────── -->
  <section class="section">
    <div class="section-head">
      <h2>Cómo leerlo sin asustarse</h2>
      <p>Tres cosas que el número solo no dice.</p>
    </div>
    <div class="cards">
      <article class="mini">
        <i>📈</i><h3>La tendencia manda</h3>
        <p>Una suba o caída abrupta de percentil (por ejemplo, de P60 a P90 en 6 meses) importa tanto como el valor absoluto. Un percentil aislado no es un diagnóstico.</p>
      </article>
      <article class="mini">
        <i>💪</i><h3>No distingue músculo de grasa</h3>
        <p>Un chico con entrenamiento intenso puede dar sobrepeso por masa muscular. Es la excepción: se confirma con perímetro de cintura o pliegues, no con “es todo músculo”.</p>
      </article>
      <article class="mini">
        <i>🌱</i><h3>Peso saludable, no dieta</h3>
        <p>La recomendación de la SAP y la OMS en sobrepeso infantil es sostener el peso mientras el chico crece en talla: el percentil baja solo. Mínimo 60 minutos diarios de actividad.</p>
      </article>
    </div>
  </section>

  <!-- ── Tabla de cortes por edad, desde la misma tabla del motor ───────────── -->
  <section class="section">
    <div class="section-head">
      <h2>Cortes de IMC por edad</h2>
      <p id="pk-tbl-ctx">Tabla OMS · varones</p>
    </div>
    <div class="tablewrap">
      <table class="datatable">
        <caption class="pk-sr" id="pk-tbl-cap">Cortes de IMC por percentil y edad según las tablas OMS, sexo masculino</caption>
        <thead>
          <tr><th>Edad</th><th>P5 · bajo peso debajo de</th><th>P50 · mediana</th><th>P85 · sobrepeso desde</th><th>P97 · obesidad desde</th></tr>
        </thead>
        <tbody id="pk-tbody">
          {refRows.map((r) => (
            <tr>
              <td>{r.edad} años</td>
              <td>{n1(r.p5)}</td>
              <td>{n1(r.p50)}</td>
              <td>{n1(r.p85)}</td>
              <td>{n1(r.p97)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="tnote">Valores en kg/m², de las tablas OMS que usa la calculadora (Growth Reference 2007 para 5-19 años y estándares 2006 para 2-5 años). Entre edades tabuladas se interpola. Cambian con el sexo elegido arriba.</p>
  </section>

  <CalcMockupSeo calc={calc} related={related} icon="📊" />

  <footer class="sources">
    <div><b>Metodología</b><br />IMC = peso ÷ talla², comparado con los cortes P5/P50/P85/P97 de IMC para edad y sexo de la OMS.</div>
    <div>Resultado orientativo · No reemplaza la consulta pediátrica</div>
  </footer>
</main>

<style is:global>
  .hcm.pk{--brand:#2f2a52;--accent:#ffd166;--soft:#efedf9}
  .hcm.pk .hero{background:linear-gradient(135deg,#2f2a52,#5b4a8f)}
  .hcm .crumb a{color:inherit;text-decoration:none}
  .hcm .crumb a:hover{text-decoration:underline}
  .hcm.pk .hero-stat b{font-size:30px}
  .hcm.pk .hero-stat span{font-size:12px;color:#dcd7f0}
  .hcm.pk .pk-help{font-size:13px;line-height:1.5;color:var(--muted);margin:14px 0 0}
  .hcm.pk .pk-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}

  /* Banda de percentiles: la pieza distintiva de esta página. */
  .hcm.pk .pk-band-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:26px 22px 20px;box-shadow:0 12px 32px rgba(35,28,72,.06)}
  .hcm.pk .pk-band{position:relative;padding-top:46px;padding-bottom:34px;min-width:0}
  .hcm.pk .pk-zones{display:flex;height:44px;border-radius:12px;overflow:hidden;background:var(--soft)}
  .hcm.pk .pk-zone{display:grid;place-items:center;min-width:0;overflow:hidden}
  .hcm.pk .pk-zone span{font-size:11px;font-weight:800;letter-spacing:.02em;padding:0 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
  .hcm.pk .pk-zone.z0{background:#fde68a;color:#7c4a03}
  .hcm.pk .pk-zone.z1{background:#c7f0d8;color:#14532d}
  .hcm.pk .pk-zone.z2{background:#fed7aa;color:#8a3d0c}
  .hcm.pk .pk-zone.z3{background:#fecaca;color:#991b1b}
  .hcm.pk .pk-marker{position:absolute;top:0;transform:translateX(-50%);text-align:center}
  .hcm.pk .pk-marker b{display:inline-block;background:var(--brand);color:#fff;font:800 13px/1 Manrope,"DM Sans",system-ui,sans-serif;padding:8px 11px;border-radius:9px;white-space:nowrap}
  .hcm.pk .pk-marker:after{content:"";display:block;width:3px;height:26px;background:var(--brand);margin:2px auto 0;border-radius:3px}
  .hcm.pk .pk-ticks{position:absolute;left:0;right:0;bottom:0;height:30px}
  .hcm.pk .pk-ticks i{position:absolute;top:0;width:0}
  .hcm.pk .pk-ticks i:before{content:"";position:absolute;top:-4px;left:0;width:1px;height:8px;background:#b9b3d4}
  .hcm.pk .pk-ticks em{position:absolute;top:7px;left:0;transform:translateX(-50%);font-style:normal;font-size:11px;font-weight:700;color:var(--muted);white-space:nowrap}
  .hcm.pk .pk-ticks i:first-child em{transform:none}
  .hcm.pk .pk-ticks i:last-child em{transform:translateX(-100%)}
  .hcm.pk .pk-band-note{margin:6px 0 0;font-size:13px;line-height:1.6;color:var(--muted)}
  @media(max-width:760px){
    .hcm.pk .pk-band-card{padding:20px 14px 16px}
    .hcm.pk .pk-zones{height:38px}
    .hcm.pk .pk-zone span{font-size:0;padding:0}
    .hcm.pk .pk-ticks em{font-size:10px}
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.hcm.pk');
    if (!root) return;
    var TABLA_M = JSON.parse(root.getAttribute('data-tm'));
    var TABLA_F = JSON.parse(root.getAttribute('data-tf'));

    /* Espejo EXACTO de src/lib/formulas/imc-infantil-percentil.ts (es) */
    var T = {
      errPeso: 'Ingresá el peso',
      errTalla: 'Ingresá la talla',
      errEdad: 'Esta calculadora es para niños de 2 a 18 años',
      bajo:   { pct: '< percentil 5', cls: 'Bajo peso', rec: 'Consultá con el pediatra para evaluar causas y plan nutricional.' },
      normal: { pct: 'percentil 5-84 (normal)', cls: 'Peso saludable', rec: 'Peso adecuado para la edad. Seguí con alimentación variada y actividad física.' },
      sobre:  { pct: 'percentil 85-96', cls: 'Sobrepeso', rec: 'Consultá con el pediatra. Más actividad física y menos ultraprocesados.' },
      obeso:  { pct: '≥ percentil 97', cls: 'Obesidad', rec: 'Consultá con pediatra y nutricionista. Plan de alimentación + actividad física.' }
    };
    var SEG = ['Bajo peso', 'Peso saludable', 'Sobrepeso', 'Obesidad'];

    function cortes(edad, sexo) {
      var tabla = sexo === 'f' ? TABLA_F : TABLA_M;
      var edades = Object.keys(tabla).map(Number).sort(function (a, b) { return a - b; });
      var lower = edades[0], upper = edades[edades.length - 1];
      for (var k = 0; k < edades.length; k++) {
        if (edades[k] <= edad) lower = edades[k];
        if (edades[k] >= edad) { upper = edades[k]; break; }
      }
      var low = tabla[lower], up = tabla[upper];
      var interp = function (a, b) { return upper === lower ? a : a + (b - a) * ((edad - lower) / (upper - lower)); };
      return { p5: interp(low[0], up[0]), p50: interp(low[1], up[1]), p85: interp(low[2], up[2]), p97: interp(low[3], up[3]) };
    }

    var $ = function (id) { return document.getElementById(id); };
    var n1 = function (n) { return n.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }); };
    var num = function (id) { return Number($(id).value); };

    function fail(msg) {
      $('pk-big').innerHTML = '—';
      $('pk-answer').textContent = msg;
      $('pk-box-label').textContent = 'Clasificación';
      $('pk-cls').textContent = '—';
      $('pk-rec').textContent = 'Completá los datos para ver el percentil.';
      $('pk-eq').innerHTML = 'IMC = peso ÷ talla²';
      $('pk-marker').style.display = 'none';
    }

    function render() {
      var peso = num('pk-peso'), talla = num('pk-talla'), edad = num('pk-edad');
      var sexo = $('pk-sexo').value;

      // Mismas guardas y mismos mensajes que el motor.
      if (!peso || peso < 5) return fail(T.errPeso);
      if (!talla || talla < 60) return fail(T.errTalla);
      if (edad < 2 || edad > 18) return fail(T.errEdad);

      var tallaM = talla / 100;
      var imc = peso / (tallaM * tallaM);
      var c = cortes(edad, sexo);
      var r = imc < c.p5 ? T.bajo : imc < c.p85 ? T.normal : imc < c.p97 ? T.sobre : T.obeso;

      var imcVal = Number(imc.toFixed(1));
      var r1 = Number(c.p5.toFixed(1)), r2 = Number(c.p85.toFixed(1)), r3 = Number(c.p97.toFixed(1));
      var min = Math.min(10, Math.floor(r1));
      var max = Math.max(r3 + 4, Math.ceil(imcVal) + 2);
      var span = max - min;
      var pos = function (v) { return Math.max(0, Math.min(100, ((v - min) / span) * 100)); };
      var w = [pos(r1), pos(r2) - pos(r1), pos(r3) - pos(r2), 100 - pos(r3)];
      var sexoLabel = sexo === 'f' ? 'niña' : 'varón';
      var edadTxt = n1(edad).replace(',0', '');

      $('pk-big').innerHTML = n1(imcVal) + ' <small>kg/m²</small>';
      $('pk-answer').textContent = 'Un IMC de ' + n1(imcVal) + ' en ' + (sexo === 'f' ? 'una ' : 'un ') + sexoLabel + ' de ' + edadTxt + ' años cae en ' + r.pct + '.';
      $('pk-box-label').textContent = 'Clasificación · ' + r.pct;
      $('pk-cls').textContent = r.cls;
      $('pk-rec').textContent = r.rec;
      $('pk-eq').innerHTML = n1(peso) + ' kg ÷ (' + n1(tallaM) + ' m)² = <b>' + n1(imcVal) + ' kg/m²</b> · corte P85 a esa edad: ' + n1(r2);

      $('pk-zones').innerHTML = w.map(function (x, i) {
        return '<div class="pk-zone z' + i + '" style="width:' + x.toFixed(2) + '%"><span>' + SEG[i] + '</span></div>';
      }).join('');
      var mk = $('pk-marker');
      mk.style.display = '';
      mk.style.left = pos(imcVal).toFixed(2) + '%';
      $('pk-marker-val').textContent = 'IMC ' + n1(imcVal);
      $('pk-ticks').innerHTML =
        '<i style="left:0%"><em>' + n1(min) + '</em></i>' +
        '<i style="left:' + w[0].toFixed(2) + '%"><em>P5 · ' + n1(r1) + '</em></i>' +
        '<i style="left:' + (w[0] + w[1]).toFixed(2) + '%"><em>P85 · ' + n1(r2) + '</em></i>' +
        '<i style="left:' + (w[0] + w[1] + w[2]).toFixed(2) + '%"><em>P97 · ' + n1(r3) + '</em></i>';
      $('pk-band-ctx').textContent = 'Cortes OMS para ' + (sexo === 'f' ? 'niña' : 'varón') + ' de ' + edadTxt + ' años.';

      $('pk-tbl-ctx').textContent = 'Tabla OMS · ' + (sexo === 'f' ? 'mujeres' : 'varones');
      $('pk-tbl-cap').textContent = 'Cortes de IMC por percentil y edad según las tablas OMS, sexo ' + (sexo === 'f' ? 'femenino' : 'masculino');
      $('pk-tbody').innerHTML = [2, 4, 6, 8, 10, 12, 14, 16, 18].map(function (a) {
        var t = cortes(a, sexo);
        return '<tr><td>' + a + ' años</td><td>' + n1(t.p5) + '</td><td>' + n1(t.p50) + '</td><td>' + n1(t.p85) + '</td><td>' + n1(t.p97) + '</td></tr>';
      }).join('');
    }

    ['pk-peso', 'pk-talla', 'pk-edad', 'pk-sexo'].forEach(function (id) {
      $(id).addEventListener('input', render);
      $(id).addEventListener('change', render);
    });
    $('pk-form').addEventListener('submit', function (e) { e.preventDefault(); render(); });
    render();
  })();
</script>
