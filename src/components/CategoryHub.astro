---
/**
 * CategoryHub — versión genérica/data-driven de HealthHub.
 *
 * Muestra un bloque rico de columnas temáticas que convierte la calc cabecera
 * de una categoría en "entry point" al resto de su cluster. Se monta antes del
 * FAQ en la calc ancla (ver CATEGORY_HUBS en src/lib/category-hubs.ts).
 *
 * Objetivo engagement: que el user que llegó a una calc top descubra 10-15 calcs
 * más de la misma familia sin scrollear al footer ni al related-auto. Sube
 * pages/session y dwell time — señal de helpful content post-HCU.
 */
interface HubCalc {
  label: string;
  slug: string;
}
interface HubSection {
  title: string;
  icon: string;
  calcs: HubCalc[];
}
interface Props {
  title: string;
  subtitle: string;
  sections: HubSection[];
}

const { title, subtitle, sections } = Astro.props;
---

<section class="ch" aria-labelledby="ch-heading">
  <header class="ch-head">
    <h2 id="ch-heading">{title}</h2>
    <p class="ch-sub">{subtitle}</p>
  </header>

  <div class="ch-grid">
    {sections.map((s) => (
      <article class="ch-col">
        <h3 class="ch-col-title">
          <span class="ch-col-icon" aria-hidden="true">{s.icon}</span>
          {s.title}
        </h3>
        <ul class="ch-col-list">
          {s.calcs.map((c) => (
            <li>
              <a href={`/${c.slug}`} class="ch-link">{c.label}</a>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .ch {
    margin: 2rem 0;
    padding: 1.5rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .ch-head { margin-bottom: 1rem; }
  .ch h2 {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
    color: var(--text);
  }
  .ch-sub {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .ch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem;
  }
  .ch-col {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.875rem 1rem;
  }
  .ch-col-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.625rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .ch-col-icon {
    font-size: 1rem;
    line-height: 1;
  }
  .ch-col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .ch-link {
    display: block;
    padding: 0.375rem 0.5rem;
    margin-left: -0.5rem;
    color: var(--text);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.35;
    border-radius: var(--radius-sm);
    transition: background 0.12s ease, color 0.12s ease;
  }
  .ch-link:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent-strong);
  }
  @media (max-width: 520px) {
    .ch-grid { grid-template-columns: 1fr; }
  }
</style>
