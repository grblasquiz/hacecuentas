1fr;gap:9px;margin-bottom:10px}.mockup-consumo-auto .extra.open{display:grid}.mockup-consumo-auto .result{background:#17324f;color:#fff;border-radius:15px;padding:18px 20px}.mockup-consumo-auto .result-top{display:flex;align-items:start;justify-content:space-between;gap:16px}.mockup-consumo-auto .result small{font-size:9px;color:#c5d3df}.mockup-consumo-auto .value{font-size:34px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.mockup-consumo-auto .verdict{background:#e6f6ef;color:#126d51;border-radius:9px;padding:8px 11px;text-align:right}.mockup-consumo-auto .verdict small{color:inherit}.mockup-consumo-auto .verdict strong{display:block;font-size:14px}.mockup-consumo-auto .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #375675;padding-top:12px;margin-top:13px}.mockup-consumo-auto .stats span{font-size:8px;color:#b9cad8}.mockup-consumo-auto .stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.mockup-consumo-auto .go{width:100%;border:0;border-radius:9px;background:linear-gradient(90deg,#19816d,#2c9d77);color:#fff;font-weight:800;padding:12px;margin-top:14px}
