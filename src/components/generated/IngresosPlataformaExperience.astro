---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-ingresos-plataforma" set:html={`<section class="hero"><div class="wrap crumb"><b>Negocios</b> &nbsp;/&nbsp; Ingresos por plataforma</div><div class="wrap grid"><div class="copy"><span class="eyebrow">Monetización de audiencia</span><h1>Un millón de views no vale lo mismo en todos lados.</h1><p>Compará YouTube, Shorts, Reels, TikTok, Twitch, blogs y X. Entendé cuánto deja cada formato después del reparto y qué mueve realmente el RPM.</p><div class="chips"><span>✓ Valores en USD</span><span>✓ Comisión incluida</span><span>✓ Comparación por formato</span></div><div class="art"><div class="screen"><div class="play"></div><div class="stand"></div></div><div class="float"><small>INGRESO ESTIMADO</small><b id="art-value">US$ 556</b><span id="art-copy">100.000 views · video largo</span></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Estimá tus ingresos</h2><p class="muted">Elegí cómo monetizás.</p></div><span class="tag">Escenario mensual</span></div><div class="label">¿Dónde publicás?</div><div class="cases"><button type="button" class="case active" data-mode="video"><i>▶</i>Video largo</button><button type="button" class="case" data-mode="shorts"><i>▯</i>Shorts y Reels</button><button type="button" class="case" data-mode="live"><i>●</i>En vivo</button><button type="button" class="case" data-mode="text"><i>¶</i>Blog y X</button><button type="button" class="case" data-mode="goals"><i>✓</i>Requisitos</button></div><div class="label">Tus datos</div><div class="fields"><div class="field" data-for="video shorts text"><label id="views-label">Vistas por mes</label><input id="views" value="100000"></div><div class="field" data-for="video"><label>Nicho del canal</label><select id="niche"><option value="25">Finanzas</option><option value="20" selected>Tecnología</option><option value="10">Salud</option><option value="7">Viajes</option><option value="4">Gaming</option><option value="2.5">Música</option></select></div><div class="field" data-for="video"><label>Audiencia Tier 1</label><select id="tier"><option value="1">Mayormente EE.UU. / UK</option><option value=".55" selected>Audiencia mixta</option><option value=".25">Mayormente Latinoamérica</option></select></div><div class="field" data-for="video"><label>Vistas con anuncio</label><select id="fill"><option value=".8">80%</option><option value=".65" selected>65%</option><option value=".45">45%</option></select></div><div class="field hide" data-for="shorts"><label>RPM por mil vistas</label><input id="short-rpm" value="0.08"></div><div class="field hide" data-for="shorts"><label>Origen del contenido</label><select id="original"><option value="1">Original</option><option value=".4">Re-subido</option></select></div><div class="field hide" data-for="live"><label>Diamantes de TikTok</label><input id="diamonds" value="50000"></div><div class="field hide" data-for="live"><label>Bits de Twitch</label><input id="bits" value="10000"></div><div class="field hide" data-for="live"><label>Donaciones y subs netas</label><input id="donations" value="180"></div><div class="field hide" data-for="live"><label>Retención TikTok</label><select id="ttfee"><option value=".5">50%</option><option value=".6">60%</option><option value=".7">70%</option></select></div><div class="field hide" data-for="text"><label>RPM del blog</label><input id="blog-rpm" value="8"></div><div class="field hide" data-for="text"><label>País principal</label><select id="country"><option value="1">EE.UU.</option><option value=".45">España</option><option value=".25" selected>Argentina / México / Chile</option></select></div><div class="field hide" data-for="goals"><label>Suscriptores actuales</label><input id="subs" value="650"></div><div class="field hide" data-for="goals"><label>Horas de reproducción</label><input id="hours" value="2800"></div></div><section class="result"><div class="result-top"><div><small id="result-label">INGRESO MENSUAL ESTIMADO</small><div class="value" id="result">US$ 393,25</div></div><div class="badge"><small id="badge-label">RPM efectivo</small><b id="badge">US$ 3,93</b></div></div><div class="stats"><span id="s1l">TU PARTE<b id="s1">55%</b></span><span id="s2l">PLATAFORMA<b id="s2">45%</b></span><span id="s3l">PROYECCIÓN ANUAL<b id="s3">US$ 4.719</b></span></div><button class="go" id="update" type="button">Actualizar estimación</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Las mismas views, distinto resultado</span><h2>Compará por ingreso, no por alcance</h2><p>La barra usa el escenario actual para mostrar por qué formato, nicho y país pesan más que el número bruto de vistas.</p></header><div class="compare"><div class="bars"><div class="barrow"><span>YouTube largo</span><div class="track"><i id="b1" style="width:100%"></i></div><b id="bv1">US$ 393</b></div><div class="barrow"><span>Facebook video</span><div class="track"><i id="b2" style="width:36%"></i></div><b id="bv2">US$ 140</b></div><div class="barrow"><span>Shorts</span><div class="track"><i id="b3" style="width:2%"></i></div><b id="bv3">US$ 8</b></div><div class="barrow"><span>Reels</span><div class="track"><i id="b4" style="width:2%"></i></div><b id="bv4">US$ 8</b></div></div><div class="caption" id="bar-copy">Con 100.000 vistas, el video largo puede dejar decenas de veces más que el formato corto.</div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3 id="detail-title">Tu ingreso, paso a paso</h3><div class="line"><span id="d1l">Vistas mensuales</span><b id="d1">100.000</b></div><div class="line"><span id="d2l">CPM del nicho</span><b id="d2">US$ 20</b></div><div class="line"><span id="d3l">Reparto y fill rate</span><b id="d3">35,8%</b></div><div class="line"><span id="d4l">Ajuste geográfico</span><b id="d4">55%</b></div><div class="line total"><strong id="d5l">Ingreso mensual</strong><b id="d5">US$ 393,25</b></div></article><article class="card"><h3>Qué mueve más el resultado</h3><div class="rule"><i>1</i><div><b>País de la audiencia</b><span>Una vista Tier 1 puede valer varias veces una latinoamericana.</span></div></div><div class="rule"><i>2</i><div><b>Nicho y demanda publicitaria</b><span>Finanzas y tecnología suelen pagar más que entretenimiento.</span></div></div><div class="rule"><i>3</i><div><b>Formato y contenido apto</b><span>Video largo monetiza más y el contenido restringido pierde anuncios.</span></div></div><div class="warning">Son estimaciones para planificar. Usá el RPM real de tu panel cuando ya tengas datos propios.</div></article></div></section>
<section class="platforms"><div class="wrap"><header class="center"><span>Mapa de monetización</span><h2>Qué paga cada plataforma</h2></header><div class="platformgrid"><article class="platform"><i>▶</i><h3>YouTube largo</h3><p>Publicidad, membresías y patrocinios.</p><em>Mayor RPM</em></article><article class="platform"><i>▯</i><h3>Shorts y Reels</h3><p>Gran alcance, ingreso bajo por mil vistas.</p><em>Necesita volumen</em></article><article class="platform"><i>●</i><h3>TikTok y Twitch</h3><p>Regalos, bits, subs y donaciones.</p><em>Depende de comunidad</em></article><article class="platform"><i>¶</i><h3>Blog con AdSense</h3><p>RPM por nicho y procedencia del tráfico.</p><em>Contenido evergreen</em></article><article class="platform"><i>𝕏</i><h3>X Premium</h3><p>Reparto sobre impresiones elegibles.</p><em>Costo mensual</em></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#8edac6">El número que importa</span><h2>El RPM explica cuánto vale tu audiencia.</h2><p>Dos canales con las mismas vistas pueden cobrar cifras completamente distintas. Compará ingreso por mil vistas y no te dejes llevar por el alcance.</p></div><div class="factors"><div><small>ALCANCE</small><b>100.000 views</b><span>Volumen mensual</span></div><div><small>VALOR</small><b id="dark-rpm">US$ 3,93 RPM</b><span>Ingreso por mil</span></div><div><small>COBRO</small><b>Desde US$ 100</b><span>Umbral habitual</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-ingresos-plataforma')?document.currentScript.previousElementSibling:document.querySelector('.mockup-ingresos-plataforma');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),num=id=>Math.max(0,Number($(id).value)||0),usd=n=>"US$ "+n.toLocaleString("es-AR",{minimumFractionDigits:n<100?2:0,maximumFractionDigits:2}),fmt=n=>Math.round(n).toLocaleString("es-AR");let mode="video";function stat(names,vals){["s1l","s2l","s3l"].forEach((id,i)=>$("#"+id).childNodes[0].nodeValue=names[i]);["s1","s2","s3"].forEach((id,i)=>$("#"+id).textContent=vals[i])}function detail(a){a.forEach((x,i)=>{$("#d"+(i+1)+"l").textContent=x[0];$("#d"+(i+1)).textContent=x[1]})}function setBars(long,fb,short,reel){let values=[long,fb,short,reel],max=Math.max(1,...values);values.forEach((v,i)=>{$("#b"+(i+1)).style.width=Math.max(1,v/max*100)+"%";$("#bv"+(i+1)).textContent=usd(v)})}
function calc(){let total=0,badge="";if(mode==="video"){let views=num("#views"),cpm=num("#niche"),tier=num("#tier"),fill=num("#fill"),rpm=cpm*.55*tier*fill;total=views/1000*rpm;let platform=views/1000*cpm*tier*fill*.45,fb=views/1000*1.4,short=views/1000*.08;badge=usd(rpm);$("#result-label").textContent="INGRESO MENSUAL ESTIMADO";$("#badge-label").textContent="RPM efectivo";stat(["TU PARTE","SE QUEDA YOUTUBE","PROYECCIÓN ANUAL"],["55%",usd(platform),usd(total*12)]);detail([["Vistas mensuales",fmt(views)],["CPM del nicho",usd(cpm)],["Reparto y fill rate",Math.round(.55*fill*100)+"%"],["Ajuste geográfico",Math.round(tier*100)+"%"],["Ingreso mensual",usd(total)]]);setBars(total,fb,short,short);$("#bar-copy").textContent=`Con ${fmt(views)} vistas, el video largo puede dejar decenas de veces más que el formato corto.`}else if(mode==="shorts"){let views=num("#views"),rpm=num("#short-rpm"),original=num("#original"),short=views/1000*rpm,reel=short*original;total=short+reel;badge=usd(rpm);$("#result-label").textContent="SHORTS + REELS POR MES";$("#badge-label").textContent="RPM usado";stat(["SHORTS","REELS","VIEWS PARA US$ 1.000"],[usd(short),usd(reel),fmt(1000/rpm*1000)]);detail([["Vistas mensuales",fmt(views)],["RPM de cortos",usd(rpm)],["Shorts",usd(short)],["Reels "+(original===1?"original":"re-subido"),usd(reel)],["Ingreso total",usd(total)]]);setBars(views/1000*3.93,views/1000*1.4,short,reel)}else if(mode==="live"){let diamonds=num("#diamonds"),bits=num("#bits"),don=num("#donations"),fee=num("#ttfee"),tik=diamonds*.005*(1-fee),twitch=bits*.01+don;total=tik+twitch;badge=total>=100?"Supera mínimo":"Saldo pendiente";$("#result-label").textContent="INGRESO NETO EN VIVO";$("#badge-label").textContent="Estado de cobro";stat(["TIKTOK NETO","TWITCH NETO","COMISIÓN TIKTOK"],[usd(tik),usd(twitch),usd(diamonds*.005*fee)]);detail([["Diamantes TikTok",fmt(diamonds)],["Neto TikTok",usd(tik)],["Bits Twitch",fmt(bits)],["Donaciones y subs",usd(don)],["Ingreso total",usd(total)]])}else if(mode==="text"){let views=num("#views"),rpm=num("#blog-rpm"),country=num("#country"),blog=views/1000*rpm*country,x=Math.max(0,views/1e6*3-8);total=blog+x;badge=usd(blog/(views||1)*1000);$("#result-label").textContent="BLOG + X POR MES";$("#badge-label").textContent="RPM efectivo blog";stat(["ADSENSE","X PREMIUM","PROYECCIÓN ANUAL"],[usd(blog),usd(x),usd(total*12)]);detail([["Visitas mensuales",fmt(views)],["RPM del nicho",usd(rpm)],["Ajuste por país",Math.round(country*100)+"%"],["Costo X Premium","US$ 8"],["Ingreso total",usd(total)]])}else{let subs=num("#subs"),hours=num("#hours"),ps=Math.min(100,subs/1000*100),ph=Math.min(100,hours/4000*100),progress=Math.min(ps,ph);total=progress;badge=Math.round(progress)+"%";$("#result-label").textContent=progress>=100?"YA CUMPLÍS LOS REQUISITOS":"AVANCE PARA MONETIZAR";$("#badge-label").textContent="Progreso";stat(["SUSCRIPTORES","HORAS","TE FALTA"],[fmt(subs)+" / 1.000",fmt(hours)+" / 4.000",fmt(Math.max(0,1000-subs))+" subs"]);detail([["Suscriptores actuales",fmt(subs)],["Meta de suscriptores","1.000"],["Horas actuales",fmt(hours)],["Meta de horas","4.000"],["Avance",Math.round(progress)+"%"]])}$("#result").textContent=mode==="goals"?Math.round(total)+"%":usd(total);$("#badge").textContent=badge;$("#art-value").textContent=$("#result").textContent;$("#art-copy").textContent=mode==="goals"?"avance hacia monetización":"estimación mensual";$("#dark-rpm").textContent=(mode==="video"?badge:"Compará tu RPM")}
function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$$(".field[data-for]").forEach(f=>f.classList.toggle("hide",!f.dataset.for.split(" ").includes(m)));calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Estimación actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar estimación",1200)};calc();

})();
</script>
