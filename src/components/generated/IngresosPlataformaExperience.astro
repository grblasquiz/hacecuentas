eight:10px;border-radius:8px;background:#173653;left:-44px;bottom:-5px}.mockup-ingresos-plataforma .float{position:absolute;right:0;top:0;background:#fff;border:1px solid #d9e5e7;border-radius:14px;padding:15px 18px;box-shadow:0 16px 34px #17385818}.mockup-ingresos-plataforma .float small{display:block;font-size:7px;color:#6a7d8f}.mockup-ingresos-plataforma .float b{display:block;color:#16816c;font-size:20px;margin:5px 0}.mockup-ingresos-plataforma .float span{font-size:8px;color:#64788b}
.mockup-ingresos-plataforma .calc{background:#fff;border:1px solid #d8e3e8;border-radius:20px;padding:26px 29px;box-shadow:0 25px 58px #17385817}.mockup-ingresos-plataforma .calc-head{display:flex;justify-content:space-between;gap:16px}.mockup-ingresos-plataforma .calc h2{font-size:23px;margin:0 0 4px}.mockup-ingresos-plataforma .muted{font-size:10px;color:#66798d;margin:0}.mockup-ingresos-plataforma .tag{background:#eaf7f2;color:#16715f;border-radius:99px;padding:7px 10px;font-size:8px;font-weight:850;height:max-content}.mockup-ingresos-plataforma .label{font-size:9px;font-weight:900;margin:17px 0 8px}.mockup-ingresos-plataforma .cases{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.mockup-ingresos-plataforma .case{border:1px solid #dce5e9;background:#fff;border-radius:10px;padding:7px 3px;min-height:65px;font-size:7px;font-weight:800;color:#566b7d;cursor:pointer}.mockup-ingresos-plataforma .case i{display:block;font-style:normal;font-size:16px;margin-bottom:3px}.mockup-ingresos-plataforma .case.active{border:2px solid #16816c;background:#edf9f5;color:#126b59}.mockup-ingresos-plataforma .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-ingresos-plataforma .field{border:1px solid #dce5e9;border-radius:10px;padding:9px 11px}.mockup-ingresos-plataforma .field.hide{display:none}.mockup-ingresos-plataforma .field.wide{grid-column:span 2}.mockup-ingresos-plataforma .field label{display:block;font-size:8px;color:#64788b;margin-bottom:5px}.mockup-ingresos-plataforma .field input,.mockup-ingresos-plataforma .field select{width:100%;border:0;outline:0;background:none;color:#17304b;font-size:13px;font-weight:750}.mockup-ingresos-plataforma .result{background:#173653;color:#fff;border-radius:15px;padding:18px 20px;margin-top:12px}.mockup-ingresos-plataforma .result-top{display:flex;justify-content:space-between;gap:15px}.mockup-ingresos-plataforma .result small{font-size:8px;color:#b9cad6}.mockup-ingresos-plataforma .value{font-size:34px;letter-spaci