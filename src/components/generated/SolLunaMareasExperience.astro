---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-sol-luna-mareas" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Ciencia / Sol, Luna y mareas</div><div class="eyebrow">Calendario del cielo y el mar</div><h1>La fase lunar también mueve el agua.</h1><p class="lead">Ubicá una fecha y una costa para entender fase, iluminación y tipo de marea esperable.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art moon"><i class="earth"></i><i class="luna"></i><div class="tide"></div></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">calendario interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="date">Fecha</label><input id="date" type="date" value="2026-08-15"></div><div class="field"><label for="coast">Tipo de costa</label><select id="coast"><option value="atlantic">Atlántica abierta</option><option value="estuary">Río o estuario</option><option value="med">Mar de poca amplitud</option></select></div><div class="field"><label for="time">Hora local</label><input id="time" type="time" value="18:00"></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sol-luna-mareas')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sol-luna-mareas');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const d=new Date(v("date")+"T12:00:00"),ref=new Date("2000-01-06T18:14:00Z"),cycle=29.530588,age=((d-ref)/86400000%cycle+cycle)%cycle,illum=(1-Math.cos(age/cycle*Math.PI*2))/2*100;let phase=age<1.8||age>27.7?"Luna nueva":age<7.4?"Creciente":age<9.2?"Cuarto creciente":age<14.8?"Gibosa creciente":age<16.6?"Luna llena":age<22.1?"Gibosa menguante":age<24?"Cuarto menguante":"Menguante";const spring=age<2||Math.abs(age-14.77)<2,amp={atlantic:1,estuary:.65,med:.25}[v("coast")];return {big:Math.round(illum)+"%",label:"Iluminación aproximada",badge:phase,metrics:[["Edad lunar",age.toFixed(1)+" días"],["Tipo de marea",spring?"Marea viva":"Marea intermedia"],["Amplitud relativa",Math.round((spring?100:65)*amp)+"%"]],position:age/cycle*100,note:spring?"Sol, Tierra y Luna están casi alineados: suele aumentar la diferencia entre pleamar y bajamar.":"La amplitud real depende muchísimo de la costa; esto explica el patrón astronómico, no reemplaza una tabla de mareas local."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"date":"2026-08-15","coast":"atlantic","time":"18:00"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
