e-columns:1fr 1fr;gap:9px;margin-top:20px;position:relative;z-index:1}.mockup-datos-ganancias .current-grid div{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);border-radius:13px;padding:13px}.mockup-datos-ganancias .current-grid small{display:block;color:#b8c6da;font-size:10px;margin-bottom:5px}.mockup-datos-ganancias .current-grid strong{font-size:17px}.mockup-datos-ganancias .source{color:#aebcd0;font-size:10px;margin-top:15px;position:relative;z-index:1}.mockup-datos-ganancias .quick{margin-top:42px;background:white;border:1px solid var(--line);border-radius:22px;padding:20px;box-shadow:0 12px 35px rgba(28,42,70,.08);display:grid;grid-template-columns:repeat(4,1fr)}.mockup-datos-ganancias .quick div{padding:6px 20px;border-right:1px solid var(--line)}.mockup-datos-ganancias .quick div:last-child{border:0}.mockup-datos-ganancias .quick small{display:block;color:var(--muted);font-size:11px;margin-bottom:7px}.mockup-datos-ganancias .quick strong{font-size:17px}.mockup-datos-ganancias .quick em{display:block;color:var(--green);font-style:normal;font-size:10px;margin-top:4px}
.mockup-datos-ganancias section{padding:80px 0}.mockup-datos-ganancias .head-row{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:29px}.mockup-datos-ganancias .head-row h2{font-size:38px;letter-spacing:-.035em;margin:8px 0 0}.mockup-datos-ganancias .head-row p{max-width:470px;color:var(--muted);line-height:1.55;margin:0}.mockup-datos-ganancias .sim{background:white}.mockup-datos-ganancias .sim-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:23px}.mockup-datos-ganancias .panel{border:1px solid var(--line);border-radius:22px;padding:27px;background:white}.mockup-datos-ganancias .panel h3{font-size:22px;margin:0 0 6px}.mockup-datos-ganancias .panel>p{font-size:14px;color:var(--muted);line-height:1.5;margin:0 0 22px}.mockup-datos-ganancias .field{margin-bottom:16px}.mockup-datos-ganancias .field label{display:block;font-size:11px;font-weight:900;margin-bottom:8px}.mockup-datos-ganancias .money{position:relative}.mockup-datos-ganancias .money span{position:absolute;left:15px;top:14px;color:#687589;font-weight:850}.mockup-datos-ganancias .money input,.mockup-datos-ganancias .field select{height:51px;width:100%;border:1px solid #ccd3de;background:white;border-radius:12px;padding:0 15px;font-weight:800;color:var(--ink);outline:none}.mockup-datos-ganancias .money input{padding-left:34px}.mockup-datos-ganancias .money input:focus,.mockup-datos-ganancias .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #dceaff}.mockup-datos-ganancias .family{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mockup-datos-ganancias .primary{width:100%;height:51px;border:0;border-radius:12px;background:var(--blue);color:white;font-weight:900;cursor:pointer}.mockup-datos-ganancias .primary:hover{background:#105bc5}.mockup-datos-ganancias .privacy{text-align:center!important;font-size:11px!important;margin:10px 0 0!important}.mockup-datos-ganancias .result{background:#f3f7fd;border-color:#cfdaea}.mockup-datos-ganancias .result-top{display: