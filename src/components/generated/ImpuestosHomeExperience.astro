<div class="mockup-impuestos-home" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>Inicio</b> / Impuestos</div><div class="hero-grid"><div><div class="eyebrow">Impuestos en Argentina · 2026</div><h1>Pagá lo que corresponde. Entendé cada peso.</h1><p class="lead">Calculá impuestos, deducciones y retenciones con las escalas vigentes, sin tener que conocer el nombre técnico del trámite.</p><div class="trust"><span>✓ Valores ARCA 2026</span><span>✓ Cálculo privado</span><span>✓ Fuentes oficiales</span></div></div><aside class="control"><div class="control-head"><div><small>TU PANEL IMPOSITIVO</small><h2>¿En qué situación estás?</h2></div><span class="updated">Actualizado</span></div><div class="profile-tabs"><button class="profile active" data-profile="empleado">Empleado</button><button class="profile" data-profile="mono">Monotributista</button><button class="profile" data-profile="negocio">Tengo un negocio</button></div><div class="deadline"><div class="deadline-top"><span>PRÓXIMA FECHA CLAVE</span><em id="profile-badge">Ganancias</em></div><strong id="deadline-title">Carga de deducciones SIRADIG</strong><p id="deadline-copy">Revisá alquiler, prepaga y cargas de familia antes del cierre.</p></div><div class="control-grid"><div><span>Herramienta sugerida</span><b id="suggestion">Ganancias 4ª</b></div><div><span>Podrías revisar</span><b id="review">Deducciones</b></div><div><span>Alertas activas</span><b>2 fechas</b></div></div><button class="primary" id="panel-button">Resolver mi situación ↓</button></aside></div></div></section>
<section class="section"><div class="wrap"><header class="section-head"><span>Empezá por tu pregunta</span><h2>¿Qué necesitás resolver?</h2><p>Elegí una situación cotidiana y te llevamos al cálculo correcto.</p></header><div class="needs" id="needs"><button class="need active" data-filter="iva"><i>％</i><b>Necesito calcular IVA</b><span>Agregar, discriminar o usar otra alícuota.</span><em>→</em></button><button class="need" data-filter="ganancias"><i>↘</i><b>Me descuentan Ganancias</b><span>Retención del sueldo y deducciones.</span><em>→</em></button><button class="need" data-filter="monotributo"><i>▦</i><b>No sé mi categoría</b><span>Facturación, cuota y recategorización.</span><em>→</em></button><button class="need" data-filter="patrimonio"><i>⌂</i><b>Tengo bienes y ahorros</b><span>Bienes Personales y casa-habitación.</span><em>→</em></button><button class="need" data-filter="exterior"><i>◎</i><b>Voy a comprar afuera</b><span>Producto, envío, franquicia e impuestos.</span><em>→</em></button><button class="need" data-filter="retenciones"><i>⇄</i><b>Me depositaron menos</b><span>Retenciones y percepciones aplicadas.</span><em>→</em></button><button class="need" data-filter="iibb"><i>⌖</i><b>Pago Ingresos Brutos</b><span>Provincia, actividad y alícuota.</span><em>→</em></button><button class="need" data-filter="deducciones"><i>−</i><b>Quiero pagar menos legalmente</b><span>Deducciones admitidas y ahorro fiscal.</span><em>→</em></button></div></div></section>
<section class="section tint" id="quick"><div class="wrap quick-calc"><div class="quick-copy"><span>Acceso rápido</span><h2>Resolvé una cuenta frecuente.</h2><p>Probá con IVA o una retención. Después podés abrir el cálculo completo con el desglose legal.</p></div><form class="calc" onsubmit="return false"><div class="calc-head"><h3>Calculadora rápida</h3><b>Resultado en vivo</b></div><div class="modes"><button class="mode active" type="button" data-mode="iva">Discriminar IVA</button><button class="mode" type="button" data-mode="retencion">Calcular retención</button></div><div class="field"><label id="amount-label">Precio final con IVA</label><div class="money"><b>$</b><input id="amount" value="121000"></div></div><div class="field"><label id="rate-label">Alícuota</label><select id="rate"><option value="21">21%</option><option value="10.5">10,5%</option><option value="27">27%</option></select></div><div class="result"><small id="result-label">PRECIO NETO SIN IVA</small><strong id="result">$100.000</strong><div class="result-row"><span>IMPUESTO<b id="tax">$21.000</b></span><span>TASA<b id="rate-result">21%</b></span><span>TOTAL<b id="total">$121.000</b></span></div><button class="calc-go" id="calculate">Actualizar cálculo</button></div></form></div></section>
<section class="section" id="tools"><div class="wrap"><header class="section-head"><span>Herramientas impositivas</span><h2>Todo ordenado por tema.</h2></header><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="ganancias">Ganancias</button><button class="filter" data-filter="monotributo">Monotributo</button><button class="filter" data-filter="iva">IVA</button><button class="filter" data-filter="patrimonio">Patrimonio</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards" id="cards"><article class="card featured" data-cat="monotributo" data-text="monotributo categoría cuota recategorización arca"><div><span class="tag">La más consultada</span><h3>¿Qué categoría de monotributo me corresponde?</h3><p>Facturación anual, alquileres, energía, cuota mensual y comparación contra responsable inscripto.</p><a href="/impuestos/monotributo">Calcular mi categoría →</a></div><div class="mini-result"><span>CATEGORÍA ESTIMADA</span><strong>D</strong><div><span>Cuota mensual</span><b>$63.357</b></div></div></article><article class="card" data-cat="iva" data-text="iva agregar discriminar precio"><span class="tag">IVA</span><h3>Agregar o discriminar IVA</h3><p>Precio neto, final y alícuotas del 21%, 10,5% o 27%.</p><a href="/impuestos/iva">Calcular →</a></article><article class="card" data-cat="ganancias" data-text="ganancias cuarta sueldo retención"><span class="tag">Empleados</span><h3>Ganancias sobre el sueldo</h3><p>Escala vigente, deducciones y retención mensual.</p><a href="/impuestos/ganancias-cuarta-categoria">Calcular →</a></article><article class="card" data-cat="patrimonio" data-text="bienes personales patrimonio casa"><span class="tag">Patrimonio</span><h3>Bienes Personales</h3><p>Mínimo no imponible, escalas y casa-habitación.</p><a href="/impuestos/bienes-personales">Calcular →</a></article><article class="card" data-cat="ganancias deducciones" data-text="deducciones alquiler hijos prepaga"><span class="tag">Ahorro fiscal</span><h3>Deducciones de Ganancias</h3><p>Alquiler, familiares, prepaga y otros conceptos admitidos.</p><a href="/impuestos/deducciones-ganancias">Revisar →</a></article><article class="card" data-cat="iibb retenciones" data-text="ingresos brutos provincia alícuota"><span class="tag">Provincial</span><h3>Ingresos Brutos</h3><p>Calculá según actividad, provincia y régimen.</p><a href="/impuestos/ingresos-brutos">Calcular →</a></article><div class="empty" id="empty">No encontramos herramientas con esa búsqueda.</div></div></div></section>
<section class="section tint"><div class="wrap"><header class="section-head"><span>Calendario y alertas</span><h2>Que una fecha no te cueste intereses.</h2></header><div class="alerts"><article class="calendar"><h3>Próximos vencimientos</h3><p>Referencias orientativas según terminación de CUIT.</p><div class="event"><div class="event-date"><b>05</b><span>AGO</span></div><div><strong>Autónomos</strong><p>Período julio 2026</p></div><em>En 7 días</em></div><div class="event"><div class="event-date"><b>20</b><span>AGO</span></div><div><strong>Monotributo</strong><p>Cuota mensual</p></div><em>En 22 días</em></div><div class="event"><div class="event-date"><b>31</b><span>AGO</span></div><div><strong>SIRADIG</strong><p>Revisá deducciones cargadas</p></div><em>Recomendado</em></div></article><aside class="subscribe"><h3>Te avisamos antes.</h3><p>Elegí sólo los temas que te afectan. Dos minutos, cero spam.</p><label>Tu email</label><input id="email" type="email" placeholder="tu@email.com"><button id="subscribe">Activar alertas</button><small>Podés desactivarlas cuando quieras.</small></aside></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-impuestos-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-impuestos-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR"),profiles={empleado:["Ganancias","Ganancias 4ª","Deducciones","Carga de deducciones SIRADIG","Revisá alquiler, prepaga y cargas de familia antes del cierre."],mono:["Monotributo","Recategorización","Cuota mensual","Recategorización semestral","Controlá ingresos acumulados y parámetros antes de confirmar tu categoría."],negocio:["IVA e IIBB","IVA","Retenciones","Presentación mensual de IVA","Revisá débito, crédito fiscal y percepciones antes del vencimiento."]};let mode="iva";$$(".profile").forEach(b=>b.onclick=()=>{$$(".profile").forEach(x=>x.classList.toggle("active",x===b));const v=profiles[b.dataset.profile];$("#profile-badge").textContent=v[0];$("#suggestion").textContent=v[1];$("#review").textContent=v[2];$("#deadline-title").textContent=v[3];$("#deadline-copy").textContent=v[4]});$("#panel-button").onclick=()=>$("#quick").scrollIntoView({behavior:"smooth"});function calc(){const amount=Math.max(0,Number($("#amount").value.replaceAll(".","").replaceAll(",",""))||0),rate=Number($("#rate").value);let result,tax,total;if(mode==="iva"){total=amount;result=amount/(1+rate/100);tax=total-result}else{total=amount;tax=amount*rate/100;result=amount-tax}$("#result").textContent=money(result);$("#tax").textContent=money(tax);$("#total").textContent=money(total);$("#rate-result").textContent=rate+"%"}$$(".mode").forEach(b=>b.onclick=()=>{mode=b.dataset.mode;$$(".mode").forEach(x=>x.classList.toggle("active",x===b));$("#amount-label").textContent=mode==="iva"?"Precio final con IVA":"Importe sujeto a retención";$("#result-label").textContent=mode==="iva"?"PRECIO NETO SIN IVA":"IMPORTE NETO";calc()});$("#amount").oninput=calc;$("#rate").onchange=calc;$("#calculate").onclick=e=>{calc();e.currentTarget.textContent="✓ Cálculo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar cálculo",1200)};function applyFilter(cat="all"){const q=$("#search").value.toLowerCase(),cards=$$(".card");let n=0;cards.forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));applyFilter(b.dataset.filter)});$("#search").oninput=()=>applyFilter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=$$(".filter").find(x=>x.dataset.filter===b.dataset.filter)||$(".filter[data-filter=all]");$$(".filter").forEach(x=>x.classList.toggle("active",x===f));applyFilter(f.dataset.filter);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1700)}$("#subscribe").onclick=()=>toast($("#email").value?"Alertas activadas":"Ingresá tu email");calc();

})();
</script>
