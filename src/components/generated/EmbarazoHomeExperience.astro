<div class="mockup-embarazo-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Embarazo</div><div class="heroGrid"><div><span class="eyebrow">Cada semana cuenta</span><h1>Ubicate en el embarazo. Entendé lo que viene.</h1><p class="lead">Calculá semanas, trimestre y fecha probable de parto. Una guía simple para ordenar fechas y acompañar cada etapa.</p><div class="trust"><span>✓ Semanas + días</span><span>✓ Próximos hitos</span><span>✓ Fechas orientativas</span></div><div class="scene"><i class="star a"></i><i class="star b">·</i><i class="star c"></i><i class="moon"></i><i class="heart">♥</i></div></div>
<div class="planner"><div class="plannerHead"><div><h2>¿De cuántas semanas estás?</h2><p>Elegí el dato que tengas disponible.</p></div><span class="live">CÁLCULO EN VIVO</span></div><div class="methods"><button class="method active" data-method="fum">Última menstruación</button><button class="method" data-method="due">Fecha probable de parto</button></div><div class="fields"><div class="field fumField"><label>Primer día de la última menstruación</label><div class="input"><input id="fum" type="date"></div></div><div class="field dueField hidden"><label>Fecha probable de parto</label><div class="input"><input id="dueInput" type="date"></div></div><div class="field"><label>Fecha de cálculo</label><div class="input"><input id="today" type="date"></div></div><div class="field"><label>Duración de ciclo</label><select id="cycle"><option value="28">28 días</option><option value="26">26 días</option><option value="27">27 días</option><option value="29">29 días</option><option value="30">30 días</option><option value="31">31 días</option><option value="32">32 días</option></select></div></div><button class="primary" id="calculate">Actualizar semanas</button><div class="result"><div class="resultTop"><div><small>EDAD GESTACIONAL ESTIMADA</small><div class="amount" id="gestation">20 semanas + 0 días</div></div><span class="trimester" id="trimester">Segundo trimestre</span></div><div class="progress"><i id="progress"></i></div><div class="resultGrid"><div class="metric"><span>FECHA PROBABLE</span><b id="dueOut">—</b></div><div class="metric"><span>PROGRESO</span><b id="progressText">50%</b></div><div class="metric"><span>PRÓXIMO HITO</span><b id="next">Semana 24</b></div></div><p class="note" id="note">La fecha es una estimación y puede ajustarse con la ecografía y el seguimiento profesional.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Entrá por el momento que estás viviendo</span><h2>Información para cada etapa.</h2><p>Elegí tu necesidad y encontrá primero la herramienta adecuada.</p></div><div class="stages"><button class="stage active" data-filter="weeks"><span class="icon">1</span><h3>Saber mis semanas</h3><p>Semanas, días, trimestre y fecha probable.</p><em>→</em></button><button class="stage" data-filter="dates"><span class="icon">□</span><h3>Ordenar las fechas</h3><p>Hitos y tiempo que falta para cada etapa.</p><em>→</em></button><button class="stage" data-filter="growth"><span class="icon">↗</span><h3>Seguir el crecimiento</h3><p>Referencias por semana y controles.</p><em>→</em></button><button class="stage" data-filter="planning"><span class="icon">✓</span><h3>Preparar lo que viene</h3><p>Un calendario simple del embarazo.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de embarazo</span><h2>Fechas claras, sin hacer cuentas a mano.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="weeks">Semanas</button><button class="filter" data-filter="dates">Fechas</button><button class="filter" data-filter="growth">Crecimiento</button><button class="filter" data-filter="planning">Planificación</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="weeks dates" data-text="semanas embarazo fecha probable parto trimestre fum"><span class="tag">Calculadora principal</span><h3>Semanas de embarazo</h3><p>Calculá semanas + días, trimestre, progreso y fecha probable de parto.</p><a class="hc-tool-link" href="/embarazo/semanas">Calcular semanas →</a></article><article class="card" data-cat="dates planning" data-text="fecha probable parto cuantos dias faltan calendario"><span class="tag">Calendario</span><h3>Cuenta regresiva al parto</h3><p>Visualizá cuánto falta y los próximos hitos.</p><a class="hc-tool-link" href="/embarazo/fecha-de-parto">Ver calendario →</a></article><article class="card" data-cat="growth weeks" data-text="crecimiento bebe semana tamaño desarrollo"><span class="tag">Seguimiento</span><h3>Crecimiento por semana</h3><p>Una referencia visual simple para cada etapa.</p><a class="hc-tool-link" href="/tracker-embarazo-semana-a-semana">Ver semanas →</a></article><article class="card" data-cat="planning" data-text="trimestres embarazo etapas controles checklist"><span class="tag">Etapas</span><h3>Guía por trimestre</h3><p>Organizá controles y preparativos por período.</p><a class="hc-tool-link" href="/embarazo/semanas">Explorar etapas →</a></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap timeline"><div><span class="eyebrow">Una orientación temporal</span><h2>Los hitos, en una línea simple.</h2><p class="lead">La evolución varía en cada embarazo. Estas referencias sirven para ubicarse, no reemplazan indicaciones médicas.</p><div class="disclaimer">Información orientativa. Para decisiones de salud, fechas clínicas o cualquier síntoma, consultá con tu profesional de atención.</div></div><div class="milestones"><article class="milestone"><span class="week">Sem. 12</span><div><b>Fin del primer trimestre</b><p>Un primer gran punto de referencia.</p></div></article><article class="milestone"><span class="week">Sem. 20</span><div><b>Mitad del embarazo</b><p>La fecha probable queda aproximadamente a 20 semanas.</p></div></article><article class="milestone"><span class="week">Sem. 28</span><div><b>Inicio del tercer trimestre</b><p>Comienza la etapa final del calendario.</p></div></article><article class="milestone"><span class="week">Sem. 40</span><div><b>Fecha probable de parto</b><p>Es una estimación, no una fecha exacta.</p></div></article></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-embarazo-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-embarazo-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let method="fum",day=864e5;const iso=d=>new Date(d-d.getTimezoneOffset()*60000).toISOString().slice(0,10),fmt=d=>d.toLocaleDateString("es-AR",{day:"2-digit",month:"short",year:"numeric"});let now=new Date();now.setHours(12,0,0,0);$("#today").value=iso(now);let initial=new Date(now);initial.setDate(initial.getDate()-140);$("#fum").value=iso(initial);
function calc(){const today=new Date($("#today").value+"T12:00:00"),cycle=+$("#cycle").value;let due,start;if(method==="fum"){start=new Date($("#fum").value+"T12:00:00");if(isNaN(start))return;due=new Date(start);due.setDate(due.getDate()+280+(cycle-28))}else{due=new Date($("#dueInput").value+"T12:00:00");if(isNaN(due))return;start=new Date(due);start.setDate(start.getDate()-280)}let days=Math.round((today-start)/day);days=Math.max(0,Math.min(294,days));const w=Math.floor(days/7),d=days%7,p=Math.round(days/280*100),tri=w<14?"Primer trimestre":w<28?"Segundo trimestre":"Tercer trimestre",milestones=[12,20,24,28,32,37,40],next=milestones.find(x=>x>w)||40;$("#gestation").textContent=`${w} semanas + ${d} días`;$("#trimester").textContent=tri;$("#dueOut").textContent=fmt(due);$("#progressText").textContent=p+"%";$("#progress").style.width=Math.min(100,p)+"%";$("#next").textContent=w>=40?"Fecha probable alcanzada":"Semana "+next}
$$(".planner input,.planner select").forEach(x=>x.oninput=calc);$$(".method").forEach(b=>b.onclick=()=>{method=b.dataset.method;$$(".method").forEach(x=>x.classList.toggle("active",x===b));$(".fumField").classList.toggle("hidden",method!=="fum");$(".dueField").classList.toggle("hidden",method!=="due");if(method==="due"&&!$("#dueInput").value){let d=new Date($("#fum").value+"T12:00:00");d.setDate(d.getDate()+280);$("#dueInput").value=iso(d)}calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Semanas actualizadas";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".stage").forEach(b=>b.onclick=()=>{$$(".stage").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
