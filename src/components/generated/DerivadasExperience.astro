---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-derivadas" set:html={`<div class="crumb">Matemática / Cálculo</div><section class="top"><div><h1>Mové el punto. Mirá cómo cambia la pendiente.</h1><p>La derivada deja de ser una regla abstracta cuando ves la recta tangente girar sobre la curva.</p></div><div class="chooser"><label>Función</label><select id="fn"><option value="square">f(x) = x²</option><option value="cube">f(x) = x³ / 3</option><option value="sin">f(x) = 3 sen(x)</option></select></div></section><section class="lab"><div class="graphcard"><h2>Curva y recta tangente</h2><svg id="graph" class="graph" viewBox="0 0 700 430" role="img" aria-label="Gráfico de función y tangente"></svg></div><aside class="side"><h2>Derivada en x = <span id="xVal"></span></h2><div class="slope" id="slope"></div><span>pendiente instantánea</span><div class="slider"><label>Posición del punto</label><input id="x" type="range" min="-3" max="3" step=".1" value="1"></div><div class="rule" id="rule"></div><div class="interpret" id="meaning"></div></aside></section><section class="steps"><div><b>1. Elegí una curva</b><span>Cada función tiene una regla derivada distinta.</span></div><div><b>2. Deslizá x</b><span>La tangente muestra la dirección local.</span></div><div><b>3. Leé el signo</b><span>Positivo sube, negativo baja, cero se aplana.</span></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-derivadas')?document.currentScript.previousElementSibling:document.querySelector('.mockup-derivadas');

const $=x=>root.querySelector("#"+x),S={square:{f:x=>x*x,d:x=>2*x,r:'f′(x) = 2x'},cube:{f:x=>x*x*x/3,d:x=>x*x,r:'f′(x) = x²'},sin:{f:x=>3*Math.sin(x),d:x=>3*Math.cos(x),r:'f′(x) = 3 cos(x)'}};
function render(){let m=S[$('fn').value],x=+$('x').value,scaleX=90,scaleY=35,cx=350,cy=215,pts=[];for(let px=-3.8;px<=3.8;px+=.04)pts.push(`${cx+px*scaleX},${cy-m.f(px)*scaleY}`);let y=m.f(x),d=m.d(x),x1=-4,x2=4,y1=y+d*(x1-x),y2=y+d*(x2-x);$('graph').innerHTML=`<path class="axis" d="M0 ${cy}H700 M${cx} 0V430"/><polyline class="curve" points="${pts.join(' ')}"/><line class="tangent" x1="${cx+x1*scaleX}" y1="${cy-y1*scaleY}" x2="${cx+x2*scaleX}" y2="${cy-y2*scaleY}"/><circle class="point" cx="${cx+x*scaleX}" cy="${cy-y*scaleY}" r="10"/>`;$('xVal').textContent=x.toFixed(1);$('slope').textContent=d.toFixed(2);$('rule').textContent=m.r;$('meaning').textContent=Math.abs(d)<.08?'La curva está casi horizontal en este punto.':d>0?'La función está creciendo: la tangente sube hacia la derecha.':'La función está decreciendo: la tangente baja hacia la derecha.'}
$('x').oninput=render;$('fn').onchange=render;render();

})();
</script>
<style is:global>

.mockup-derivadas{--blue:#174b7a;--ink:#18272f;--muted:#627179;--line:#d7e1df;--red:#dc624d;--green:#48a47f;--paper:#f5f8f6}.mockup-derivadas *{box-sizing:border-box}.mockup-derivadas{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-derivadas button,.mockup-derivadas input,.mockup-derivadas select{font:inherit}.mockup-derivadas .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-derivadas .crumb{color:var(--blue);font-weight:800}.mockup-derivadas .top{display:flex;justify-content:space-between;gap:25px;align-items:end}.mockup-derivadas .top h1{font-size:clamp(40px,5vw,64px);line-height:1;letter-spacing:-.05em;margin:28px 0 12px}.mockup-derivadas .top p{color:var(--muted);font-size:18px;max-width:650px}.mockup-derivadas .chooser{background:#fff;border:1px solid var(--line);border-radius:14px;padding:13px}.mockup-derivadas .chooser label{display:block;font-size:12px;font-weight:800}.mockup-derivadas .chooser select{border:0;color:var(--blue);font-weight:900;padding-top:5px}.mockup-derivadas .lab{display:grid;grid-template-columns:1fr 290px;gap:20px;margin-top:28px}.mockup-derivadas .graphcard,.mockup-derivadas .side{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-derivadas .graphcard h2{margin:0;font-size:22px}.mockup-derivadas .graph{width:100%;height:430px;margin-top:15px}.mockup-derivadas .axis{stroke:#9fb2b0;stroke-width:1}.mockup-derivadas .curve{fill:none;stroke:var(--blue);stroke-width:5}.mockup-derivadas .tangent{stroke:var(--red);stroke-width:4}.mockup-derivadas .point{fill:var(--red);stroke:#fff;stroke-width:5}.mockup-derivadas .side h2{font-size:14px;text-transform:uppercase;letter-spacing:.12em}.mockup-derivadas .slope{font-size:55px;font-weight:950;color:var(--red);line-height:1}.mockup-derivadas .slider{margin:24px 0}.mockup-derivadas .slider label{display:flex;justify-content:space-between;font-weight:800}.mockup-derivadas .slider input{width:100%;accent-color:var(--red)}.mockup-derivadas .rule{background:#e4f1eb;border-radius:15px;padding:15px;font:700 16px ui-monospace,monospace;margin:20px 0}.mockup-derivadas .interpret{padding:15px;border-left:5px solid var(--green);background:#eef8f4}.mockup-derivadas .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px}.mockup-derivadas .steps div{background:#fff;border:1px solid var(--line);padding:15px;border-radius:15px}.mockup-derivadas .steps b{display:block;color:var(--blue)}@media(max-width:800px){.mockup-derivadas .top{display:block}.mockup-derivadas .lab{grid-template-columns:1fr}.mockup-derivadas .steps{grid-template-columns:1fr}.mockup-derivadas .graph{height:340px}}
.mockup-derivadas { width:100%; overflow:hidden; }
.mockup-derivadas .top, .mockup-derivadas header.top { display:none !important; }
.mockup-derivadas .foot { display:none !important; }
.mockup-derivadas .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-derivadas .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-derivadas .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-derivadas .support-real summary { cursor:pointer; font-weight:750; }
.mockup-derivadas .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-derivadas :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-derivadas input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-derivadas input[type="number"]::-webkit-inner-spin-button, .mockup-derivadas input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-derivadas .support-real-grid{grid-template-columns:1fr}}
.mockup-derivadas .top{display:flex!important}
@media(max-width:800px){.mockup-derivadas .top{display:block!important}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-derivadas support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
