---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-promedio-estudio" set:html={`<div class="wrap hero"><div><div class="crumb">Estudio / Promedio</div><div class="eyebrow">Tus notas, con contexto</div><h1>No es sólo cuánto te da. Es qué necesitás lograr.</h1><p class="lead">Calculá tu promedio, compará créditos, proyectá una nota final o revisá si llegás a una beca.</p><div class="chips"><span class="chip">✓ 7 casos académicos</span><span class="chip">✓ Escala 0–10 y GPA</span><span class="chip">✓ Cuenta paso a paso</span></div></div><div class="visual"><div class="notebook"><div class="formula-art">7 + 8 + 9 + 6 + 10<br>──────────────<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;5<br><b>= 8</b></div></div><div class="grade">8,0</div><div class="pencil"></div></div></div>
<div class="wrap"><form class="calc" id="calculator"><div class="case-label">¿QUÉ NECESITÁS CALCULAR?</div><div class="cases"><button type="button" class="case active" data-mode="simple"><span>➗</span>Promedio simple</button><button type="button" class="case" data-mode="weighted"><span>⚖️</span>Por créditos</button><button type="button" class="case" data-mode="final"><span>📝</span>Nota final</button><button type="button" class="case" data-mode="attendance"><span>📅</span>Faltas</button><button type="button" class="case" data-mode="gpa"><span>🎓</span>GPA 4.0</button><button type="button" class="case" data-mode="scholarship"><span>🏅</span>Beca</button><button type="button" class="case" data-mode="stats"><span>📊</span>Estadística</button></div>
<div class="grid"><div class="panel"><h2 id="formTitle">Promedio simple de tus notas</h2><p class="hint" id="formHint">Sumamos todas y dividimos por la cantidad.</p>
<div class="fields active" data-fields="simple"><div class="field full"><label>Tus notas · separadas por espacio</label><textarea class="control note-list notes">7 8 9 6 10</textarea></div></div>
<div class="fields" data-fields="weighted"><div class="field full"><label>Notas · en el mismo orden</label><textarea class="control note-list notes">7 8 9 6 10</textarea></div><div class="field full"><label>Créditos o carga horaria</label><textarea class="control note-list weights">6 4 8 4 6</textarea></div></div>
<div class="fields" data-fields="final"><div class="field"><label>Promedio de cursada</label><input class="control" id="course" type="number" value="7" step=".1"></div><div class="field"><label>Nota del examen final</label><input class="control" id="exam" type="number" value="8" step=".1"></div><div class="field full"><label>Peso del examen final (%)</label><input class="control" id="examWeight" type="number" value="60"></div></div>
<div class="fields" data-fields="attendance"><div class="field"><label>Clases totales</label><input class="control" id="classes" type="number" value="32"></div><div class="field"><label>Clases a las que fuiste</label><input class="control" id="attended" type="number" value="26"></div><div class="field full"><label>Asistencia mínima exigida (%)</label><input class="control" id="minimum" type="number" value="75"></div></div>
<div class="fields" data-fields="gpa"><div class="field full"><label>Tus notas en escala 0–10</label><textarea class="control note-list notes">7 8 9 6 10</textarea></div></div>
<div class="fields" data-fields="scholarship"><div class="field full"><label>Tus notas</label><textarea class="control note-list notes">7 8 9 6 10</textarea></div><div class="field full"><label>Programa de beca</label><select class="control" id="scholarship"><option value="0">Progresar · regularidad, sin promedio mínimo</option><option value="7">UBA Excelencia Académica · 7+</option><option value="7.5">CONICET doctoral · 7,5+</option><option value="6">Santander Universidades · 6+</option><option value="8">Universidad privada · 8+</option></select></div></div>
<div class="fields" data-fields="stats"><div class="field full"><label>Conjunto de datos</label><textarea class="control note-list notes">7 8 9 6 10</textarea></div></div>
<button class="update" id="updateButton" type="button">Actualizar resultado</button></div>
<div class="panel result"><div class="kicker" id="kicker">TU PROMEDIO</div><div class="big" id="resultValue">8,00</div><div class="sub" id="resultSub">40 puntos ÷ 5 notas.</div><div class="badge" id="resultBadge">Buen rendimiento</div><div class="tiles"><div class="tile"><small id="t1l">Nota más alta</small><strong id="t1v">10</strong></div><div class="tile"><small id="t2l">Nota más baja</small><strong id="t2v">6</strong></div><div class="tile"><small id="t3l">Cantidad</small><strong id="t3v">5 notas</strong></div></div></div></div></form></div>
<section><div class="wrap"><div class="section-head"><div class="eyebrow">Dónde caés</div><h2 id="scaleTitle">Tu promedio dentro de la escala.</h2><p id="scaleCopy">El número cambia de significado cuando cruza un umbral académico.</p></div><div class="scale-card"><div class="scale"><i class="pin" id="pin" data-value="8,00"></i></div><div class="scale-labels"><div><b>Desaprobado</b>0–3,99</div><div><b>Aprobado</b>4–5,99</div><div><b>Bueno</b>6–7,99</div><div><b>Distinguido</b>8–10</div></div></div><div class="break-grid"><div class="breakdown" id="rows"></div><aside class="insight"><h3 id="insightTitle">La lectura útil</h3><div class="number" id="insightValue">8,00</div><p id="insightCopy">Tu promedio está en la franja de distinguido.</p></aside></div></div></section>
<section class="guide"><div class="wrap"><div class="section-head"><div class="eyebrow">Antes de tomar una decisión</div><h2>Cuatro reglas que cambian el resultado.</h2></div><div class="cards"><article class="card"><i>⚖️</i><h3>Créditos distintos</h3><p>Si las materias no pesan igual, usá ponderado.</p></article><article class="card"><i>❌</i><h3>Aplazos</h3><p>Cada universidad decide si entran en el promedio oficial.</p></article><article class="card"><i>🔢</i><h3>Redondeo</h3><p>Un 6,5 puede cerrar en 6 o 7 según la cátedra.</p></article><article class="card"><i>📜</i><h3>Analítico</h3><p>Para trámites vale el promedio certificado por la institución.</p></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><div class="eyebrow">La cuenta detrás del promedio</div><h2>Cada caso usa una pregunta distinta.</h2><div class="formula"><strong id="formula">Promedio = suma de notas ÷ cantidad</strong><p id="formulaCopy">Sirve cuando todas las materias tienen el mismo peso.</p></div></div><div class="checks"><div class="check"><span class="tick">✓</span><span>Promedio simple y ponderado.</span></div><div class="check"><span class="tick">✓</span><span>Nota final por porcentaje.</span></div><div class="check"><span class="tick">✓</span><span>Asistencia y faltas disponibles.</span></div><div class="check"><span class="tick">✓</span><span>GPA, becas y estadística descriptiva.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-promedio-estudio')?document.currentScript.previousElementSibling:document.querySelector('.mockup-promedio-estudio');

const $=id=>root.querySelector("#"+id),set=(id,v)=>$(id).textContent=v,fmt=(n,d=2)=>Number(n).toLocaleString("es-AR",{minimumFractionDigits:d,maximumFractionDigits:d});let mode="simple";const cfg={simple:["Promedio simple de tus notas","Sumamos todas y dividimos por la cantidad."],weighted:["Promedio ponderado por créditos","Cada nota aporta según su carga académica."],final:["Nota final de una materia","Combinamos cursada y examen según sus porcentajes."],attendance:["Cuántas faltas te quedan","Comparamos asistencia actual con el mínimo exigido."],gpa:["Equivalencia orientativa en GPA","Mostramos tabla de letras y métodos lineales."],scholarship:["¿Llegás al promedio de la beca?","Comparamos tu promedio con el umbral del programa."],stats:["Estadística descriptiva","Calculamos media, mediana, moda y desvío poblacional."]};function list(s){return String(s||"").trim().split(/[;\s]+/).map(x=>parseFloat(x.replace(",","."))).filter(Number.isFinite)}function currentNotes(){return list(root.querySelector(`.fields[data-fields="${mode}"] .notes`)?.value)}function rows(a){$("rows").innerHTML=a.map(x=>`<div class="row"><span>${x[0]}</span><b>${x[1]}</b></div>`).join("")}function common(value,max=10){$("pin").style.left=Math.max(1,Math.min(99,value/max*100))+"%";$("pin").dataset.value=fmt(value);set("insightValue",fmt(value))}
function simple(){let a=currentNotes(),sum=a.reduce((x,y)=>x+y,0),avg=a.length?sum/a.length:0,hi=a.length?Math.max(...a):0,lo=a.length?Math.min(...a):0;set("kicker","TU PROMEDIO");set("resultValue",fmt(avg));set("resultSub",`${fmt(sum)} puntos ÷ ${a.length} notas.`);set("resultBadge",avg>=8?"Rendimiento distinguido":avg>=6?"Buen rendimiento":avg>=4?"Promedio aprobado":"Promedio desaprobado");set("t1l","Nota más alta");set("t1v",fmt(hi,1));set("t2l","Nota más baja");set("t2v",fmt(lo,1));set("t3l","Cantidad");set("t3v",a.length+" notas");set("scaleTitle","Tu promedio dentro de la escala.");set("scaleCopy","El número cambia de significado cuando cruza un umbral académico.");set("insightTitle","La lectura útil");set("insightCopy",`Tenés ${a.filter(x=>x<4).length} nota(s) por debajo de 4 y ${a.filter(x=>x<6).length} por debajo de 6.`);set("formula","Promedio = suma de notas ÷ cantidad");set("formulaCopy","Sirve cuando todas las materias tienen el mismo peso.");rows([["Notas cargadas",a.join(" · ")||"—"],["Suma",fmt(sum)],["Cantidad",a.length],["Promedio",fmt(avg)]]);common(avg)}
function weighted(){let f=root.querySelector('[data-fields="weighted"]'),a=list(f.querySelector(".notes").value),w=list(f.querySelector(".weights").value),sw=w.reduce((x,y)=>x+y,0),sum=a.reduce((x,y,i)=>x+y*(w[i]||0),0),avg=a.length===w.length&&sw?sum/sw:0,simpleAvg=a.length?a.reduce((x,y)=>x+y,0)/a.length:0,ok=a.length===w.length;set("kicker",ok?"PROMEDIO PONDERADO":"REVISÁ LOS DATOS");set("resultValue",ok?fmt(avg):"—");set("resultSub",ok?`${fmt(sum)} puntos ponderados ÷ ${sw} créditos.`:`Hay ${a.length} notas y ${w.length} pesos.`);set("resultBadge",ok?(avg>=6?"Ponderado aprobado":"Ponderado bajo"):"La cantidad debe coincidir");set("t1l","Simple");set("t1v",fmt(simpleAvg));set("t2l","Ponderado");set("t2v",ok?fmt(avg):"—");set("t3l","Diferencia");set("t3v",ok?fmt(avg-simpleAvg):"—");set("scaleTitle","El peso puede mover tu promedio.");set("scaleCopy","Las materias con más créditos tienen más influencia.");set("insightTitle","Efecto de los créditos");set("insightCopy",ok?(avg>=simpleAvg?"Tus notas fuertes están en materias de mayor peso.":"Tus notas más bajas están pesando más."):"Corregí la cantidad de pesos.");set("formula","Ponderado = Σ(nota × créditos) ÷ Σ créditos");set("formulaCopy","Los créditos no necesitan sumar 100.");rows([["Notas",a.join(" · ")],["Créditos",w.join(" · ")],["Σ nota × crédito",fmt(sum)],["Total de créditos",sw]]);common(avg)}
function finalGrade(){let c=+$("course").value||0,e=+$("exam").value||0,p=Math.max(0,Math.min(100,+$("examWeight").value||0)),v=c*(100-p)/100+e*p/100,pass=e>=4;set("kicker","NOTA FINAL ESTIMADA");set("resultValue",fmt(v,1));set("resultSub",`${100-p}% cursada + ${p}% examen.`);set("resultBadge",pass?(v>=7?"Promoción probable":"Materia aprobada"):"Examen final desaprobado");$("resultBadge").className="badge"+(pass?"":" bad");set("t1l","Cursada");set("t1v",fmt(c,1));set("t2l","Examen");set("t2v",fmt(e,1));set("t3l","Peso final");set("t3v",p+"%");set("scaleTitle","Tu cierre estimado de materia.");set("scaleCopy","La nota mínima propia del final prevalece sobre el promedio.");set("insightTitle",pass?"Resultado académico":"Atención");set("insightCopy",pass?"El examen supera el mínimo habitual de 4.":"Aunque el promedio alcance, un final menor a 4 suele desaprobar.");set("formula","Final = cursada × peso + examen × peso");set("formulaCopy","Verificá el reparto y el redondeo de tu cátedra.");rows([["Aporte cursada",fmt(c*(100-p)/100)],["Aporte examen",fmt(e*p/100)],["Nota sin redondear",fmt(v)],["Estado del final",pass?"Aprobado":"Desaprobado"]]);common(v)}
function attendance(){let total=Math.max(1,val("classes")),att=Math.min(total,val("attended")),min=val("minimum"),pct=att/total*100,required=Math.ceil(total*min/100),maxMiss=total-required,used=total-att,left=Math.max(0,maxMiss-used);set("kicker","ASISTENCIA ACTUAL");set("resultValue",fmt(pct,1)+"%");set("resultSub",`${att} asistencias sobre ${total} clases.`);set("resultBadge",pct>=min?`Te quedan ${left} faltas disponibles`:"Estás debajo del mínimo");set("t1l","Mínimo");set("t1v",min+"%");set("t2l","Faltas usadas");set("t2v",used);set("t3l","Faltas libres");set("t3v",left);set("scaleTitle","Tu asistencia frente al mínimo.");set("scaleCopy","La escala ahora representa de 0 a 100%.");set("insightTitle","Margen de faltas");set("insightCopy",left?`Podés faltar ${left} clase(s) más sin quedar debajo del mínimo.`:"La próxima falta puede dejarte libre.");set("formula","Faltas máximas = total − clases mínimas");set("formulaCopy","Las clases mínimas se redondean siempre hacia arriba.");rows([["Clases mínimas",required],["Faltas máximas",maxMiss],["Faltas usadas",used],["Faltas disponibles",left]]);common(pct,100)}
function gpa(){let a=currentNotes(),avg=a.length?a.reduce((x,y)=>x+y,0)/a.length:0,n=avg*10,T=[[93,4,"A"],[90,3.7,"A−"],[87,3.3,"B+"],[83,3,"B"],[80,2.7,"B−"],[77,2.3,"C+"],[73,2,"C"],[70,1.7,"C−"],[67,1.3,"D+"],[63,1,"D"],[60,.7,"D−"],[0,0,"F"]],band=T.find(x=>n>=x[0]),linear=avg/10*4,from1=(avg-1)*4/9;set("kicker","EQUIVALENCIA GPA · TABLA DE LETRAS");set("resultValue",fmt(band[1],1));set("resultSub",`${fmt(avg)} sobre 10 = ${fmt(n,0)}/100 = letra ${band[2]}.`);set("resultBadge","Conversión orientativa, no certificada");set("t1l","Letra");set("t1v",band[2]);set("t2l","Lineal directo");set("t2v",fmt(linear,2));set("t3l","Lineal desde 1");set("t3v",fmt(from1,2));set("scaleTitle","Tu resultado en escala 4.0.");set("scaleCopy","Cada institución puede usar una tabla distinta.");set("insightTitle","Método principal");set("insightCopy","La tabla de letras es la referencia más frecuente en admisiones de EE.UU.");set("formula","Nota 0–10 → escala 100 → letra → GPA");set("formulaCopy","Una agencia de convalidación puede aplicar otro criterio.");rows([["Promedio original",fmt(avg)],["Escala 100",fmt(n,0)],["Letra",band[2]],["GPA por tabla",fmt(band[1],1)]]);common(band[1],4)}
function scholarship(){let a=currentNotes(),avg=a.length?a.reduce((x,y)=>x+y,0)/a.length:0,min=+$("scholarship").value||0,name=$("scholarship").selectedOptions[0].textContent,margin=avg-min,ok=min===0||margin>=0;set("kicker","EVALUACIÓN DE PROMEDIO");set("resultValue",min===0?"Sin mínimo":ok?"Llegás":"No llegás");set("resultSub",`${name} · tu promedio es ${fmt(avg)}.`);set("resultBadge",min===0?"Importa la regularidad":ok?`Superás el mínimo por ${fmt(margin)}`:`Te faltan ${fmt(-margin)} puntos`);set("t1l","Tu promedio");set("t1v",fmt(avg));set("t2l","Mínimo");set("t2v",min?fmt(min):"No exige");set("t3l","Margen");set("t3v",min?fmt(margin):"—");set("scaleTitle","Tu promedio frente al requisito.");set("scaleCopy","El promedio es sólo uno de los criterios de admisión.");set("insightTitle",ok?"Cumplís este criterio":"Todavía no alcanza");set("insightCopy","Revisá también regularidad, ingresos, materias aprobadas y fechas.");set("formula","Margen = promedio actual − mínimo exigido");set("formulaCopy","Los requisitos cambian en cada convocatoria.");rows([["Programa",name],["Promedio actual",fmt(avg)],["Promedio mínimo",min?fmt(min):"Sin mínimo"],["Diferencia",min?fmt(margin):"No aplica"]]);common(avg)}
function stats(){let a=currentNotes().sort((x,y)=>x-y),n=a.length,avg=n?a.reduce((x,y)=>x+y,0)/n:0,med=n?(n%2?a[(n-1)/2]:(a[n/2-1]+a[n/2])/2):0,count={};a.forEach(x=>count[x]=(count[x]||0)+1);let max=Math.max(0,...Object.values(count)),modes=max>1?Object.keys(count).filter(k=>count[k]===max).join(" · "):"Sin moda",dev=n?Math.sqrt(a.reduce((s,x)=>s+(x-avg)**2,0)/n):0;set("kicker","MEDIA DEL CONJUNTO");set("resultValue",fmt(avg));set("resultSub",`${n} valores ordenados: ${a.join(" · ")}.`);set("resultBadge",Math.abs(avg-med)<.01?"Distribución centrada":"Media y mediana difieren");set("t1l","Mediana");set("t1v",fmt(med));set("t2l","Moda");set("t2v",modes);set("t3l","Desvío");set("t3v",fmt(dev));set("scaleTitle","Compará el centro y la dispersión.");set("scaleCopy","Los valores extremos mueven la media más que la mediana.");set("insightTitle","Dispersión poblacional");set("insightCopy",`El desvío estándar es ${fmt(dev)} y el rango es ${fmt((a.at(-1)||0)-(a[0]||0))}.`);set("formula","Desvío = √ media de (valor − promedio)²");set("formulaCopy","Esta rama usa desvío poblacional: divide por n.");rows([["Media",fmt(avg)],["Mediana",fmt(med)],["Moda",modes],["Rango",fmt((a.at(-1)||0)-(a[0]||0))],["Desvío poblacional",fmt(dev)]]);common(avg)}
function val(id){return Math.max(0,Number($(id).value)||0)}function calculate(){$("resultBadge").className="badge";({simple,weighted,final:finalGrade,attendance,gpa,scholarship,stats}[mode])()}root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".fields").forEach(x=>x.classList.toggle("active",x.dataset.fields===mode));set("formTitle",cfg[mode][0]);set("formHint",cfg[mode][1]);calculate()}));root.querySelectorAll("input,textarea,select").forEach(x=>x.addEventListener("input",calculate));function confirmCalc(){calculate();set("updateButton","✓ Resultado actualizado");clearTimeout(window.timer);window.timer=setTimeout(()=>set("updateButton","Actualizar resultado"),5000)}$("updateButton").addEventListener("click",confirmCalc);$("calculator").addEventListener("submit",e=>{e.preventDefault();confirmCalc()});calculate();

})();
</script>
<style is:global>

