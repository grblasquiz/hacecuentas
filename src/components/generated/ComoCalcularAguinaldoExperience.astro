(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-como-calcular-aguinaldo')?document.currentScript.previousElementSibling:document.querySelector('.mockup-como-calcular-aguinaldo');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR"),num=id=>Math.max(0,Number($(id).value.replaceAll(".","").replaceAll(",",""))||0);function calc(){const salary=num("#salary"),days=Math.min(181,num("#days")),gross=salary/2*(days/181),rate=.17+($("#union").checked?.02:0),ded=gross*rate,net=gross-ded;$("#gross").textContent=money(gross);$("#ded").textContent="− "+money(ded);$("#net").textContent=money(net);$("#ratio").textContent=Math.round(days/181*100)+"%"}$("#salary").oninput=calc;$("#days").oninput=calc;$("#union").onchange=calc;$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Cálculo actualizado";toast("Resultado actualizado");setTimeout(()=>e.currentTarget.textContent="Actualizar cálculo",1200)};function goCalc(){$("#calculator").scrollIntoView({behavior:"smooth",block:"center"});setTimeout(()=>$("#salary").focus(),500)}$("#hero-calc").onclick=goCalc;$("#side-calc").onclick=goCalc;$$(".checkitem").forEach(x=>x.onclick=()=>x.classList.toggle("done"));function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1700)}$$("[data-share]").forEach(b=>b.onclick=()=>toast(b.dataset.share));window.onscroll=()=>{const max=document.documentElement.scrollHeight-innerHeight,p=max?scrollY/max*100:0;$("#progress").style.width=p+"%";let current="que-es";$$(".article h2").forEach(h=>{if(h.getBoundingClientRect().top<180)current=h.id});$$(".toc a").forEach(a=>a.classList.toggle("active",a.getAttribute("href")==="#"+current))};calc();

})();
</script>
