---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-cuanta-comida-mascota" set:html={`
<div class="shell"><div class="crumb">Mascotas / Alimentación</div><section class="intro"><div><div style="font-weight:900;color:var(--coral);letter-spacing:.12em">PORCIÓN DIARIA ORIENTATIVA</div><h1>No llenes el plato a ojo.</h1><p>Convertí las calorías del alimento en gramos y repartilas durante el día. La condición corporal importa tanto como el peso.</p></div><div class="bowl"><div class="kibble"></div></div></section>
<section class="passport" aria-label="Ficha de la mascota">
<div><label>Especie</label><div class="species"><button class="on" data-species="dog">Perro</button><button data-species="cat">Gato</button></div></div>
<label>Peso actual (kg)<input id="weight" type="number" value="12" min=".5" max="100" step=".1"></label>
<label>Etapa<select id="stage"><option value="1.6">Adulto castrado</option><option value="2">Adulto activo</option><option value="3">Cachorro / gatito</option><option value="1.3">Senior tranquilo</option></select></label>
<label>Condición corporal<select id="condition"><option value="1">Ideal</option><option value=".85">Sobrepeso</option><option value="1.1">Delgado</option></select></label>
<label>Alimento (kcal / 100 g)<input id="density" type="number" value="360" min="150" max="700"></label>
</section>
<section class="day"><div class="schedule"><div class="titleline"><h2>Agenda del plato</h2><div class="meals"><span>Repartir en</span><button data-meals="2" class="on">2</button><button data-meals="3">3</button><button data-meals="4">4</button></div></div><div class="timeline" id="timeline"></div><div class="warning">Pesá la ración completa de cada día. Si usás premios, descontalos del total para no sumar calorías invisibles.</div></div>
<aside class="nutrition" aria-live="polite"><div class="titleline"><h2>Presupuesto diario</h2><div class="total"><span id="grams">—</span> g<small><span id="kcal">—</span> kcal estimadas</small></div></div><div class="caloriebar"><div class="foodbar"></div><div class="treatbar"></div></div><div class="legend"><span>90% alimento completo</span><span>hasta 10% premios</span></div><div class="facts"><div class="fact"><b id="perMeal">—</b><span>gramos por comida</span></div><div class="fact"><b id="treats">—</b><span>kcal máximas en premios</span></div></div><div class="warning" id="advice"></div></aside></section></div>
<section class="method"><div class="shell methodgrid"><div><h2>Qué cálculo hay detrás</h2><p>Primero estimamos el requerimiento energético en reposo y luego aplicamos un factor por etapa y condición.</p></div><div class="formula"><code>RER = 70 × peso⁰·⁷⁵</code><span>Es una referencia general. Crecimiento, gestación, enfermedad, pérdida de peso o cambios bruscos requieren un plan veterinario. Confirmá siempre las kcal de la etiqueta.</span></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-cuanta-comida-mascota')?document.currentScript.previousElementSibling:document.querySelector('.mockup-cuanta-comida-mascota');

let species='dog', meals=2;
const $=id=>root.querySelector("#"+id);
function render(){
 const w=Math.max(.5,+$('weight').value||0), factor=+$('stage').value*(species==='cat'?.88:1), cond=+$('condition').value, density=Math.max(1,+$('density').value||1);
 const kcal=Math.round(70*Math.pow(w,.75)*factor*cond), grams=Math.round(kcal/density*100);
 $('grams').textContent=grams.toLocaleString('es-AR'); $('kcal').textContent=kcal.toLocaleString('es-AR');
 $('perMeal').textContent=Math.round(grams/meals)+' g'; $('treats').textContent=Math.round(kcal*.1)+' kcal';
 $('advice').textContent=$('condition').value==='.85'?'Elegiste sobrepeso: el ajuste es conservador, pero el objetivo y el ritmo de descenso deben definirlos con el veterinario.':'Controlá peso y condición corporal cada 2 a 4 semanas; ajustá gradualmente si cambia.';
 const hours=meals===2?['08:00','20:00']:meals===3?['08:00','14:00','20:00']:['08:00','12:00','17:00','21:00'];
 $('timeline').innerHTML=hours.map((h,i)=>`<div class="meal" style="left:${(i+.5)*100/meals}%"><i></i><b>${Math.round(grams/meals)} g</b><small>${h}</small></div>`).join('');
}
root.querySelectorAll('[data-species]').forEach(b=>b.onclick=()=>{species=b.dataset.species;root.querySelectorAll('[data-species]').forEach(x=>x.classList.toggle('on',x===b));render()});
root.querySelectorAll('[data-meals]').forEach(b=>b.onclick=()=>{meals=+b.dataset.meals;root.querySelectorAll('[data-meals]').forEach(x=>x.classList.toggle('on',x===b));render()});
root.querySelectorAll('input,select').forEach(x=>x.addEventListener('input',render));render();

})();
</script>
<style is:global>

.mockup-cuanta-comida-mascota{--blue:#174b7a;--ink:#1d2b32;--muted:#617078;--line:#d8e1df;--paper:#f4f7f4;--coral:#d7654d;--mint:#dff3e8;--sand:#fff3d8}.mockup-cuanta-comida-mascota *{box-sizing:border-box}.mockup-cuanta-comida-mascota{margin:0;font:15px/1.45 Inter,system-ui;color:var(--ink);background:#fbfcfa}.mockup-cuanta-comida-mascota button,.mockup-cuanta-comida-mascota input,.mockup-cuanta-comida-mascota select{font:inherit}.mockup-cuanta-comida-mascota .shell{max-width:1160px;margin:auto;padding:0 22px}.mockup-cuanta-comida-mascota .crumb{padding-top:34px;color:var(--blue);font-weight:800}.mockup-cuanta-comida-mascota .intro{display:grid;grid-template-columns:1fr .8fr;gap:50px;align-items:center;padding:28px 0 42px}.mockup-cuanta-comida-mascota .intro h1{font-size:clamp(42px,6vw,72px);line-height:.98;letter-spacing:-.055em;margin:8px 0 18px}.mockup-cuanta-comida-mascota .intro p{font-size:18px;color:var(--muted);max-width:650px}.mockup-cuanta-comida-mascota .bowl{height:260px;position:relative;display:grid;place-items:center}.mockup-cuanta-comida-mascota .bowl:before{content:"";width:310px;height:150px;border-radius:20px 20px 150px 150px;background:var(--blue);box-shadow:0 22px 40px #174b7a25}.mockup-cuanta-comida-mascota .bowl:after{content:"COMIDAS DEL DÍA";position:absolute;color:#fff;font-weight:900;letter-spacing:.15em}.mockup-cuanta-comida-mascota .kibble{position:absolute;top:35px;width:230px;height:82px;border-radius:50%;background:radial-gradient(circle,#996943 0 6px,transparent 7px) 0 0/29px 27px,#e7c39b;border:9px solid #fff}.mockup-cuanta-comida-mascota .passport{background:#fff;border:1px solid var(--line);border-radius:22px;padding:20px;display:grid;grid-template-columns:repeat(5,1fr);gap:14px;box-shadow:0 16px 45px #1b3d4820}.mockup-cuanta-comida-mascota .passport label{font-size:12px;font-weight:850;color:var(--muted);display:block}.mockup-cuanta-comida-mascota .passport input,.mockup-cuanta-comida-mascota .passport select{width:100%;border:0;border-bottom:2px solid var(--line);padding:9px 2px;background:#fff;color:var(--ink);font-weight:800}.mockup-cuanta-comida-mascota .species{display:flex;gap:5px}.mockup-cuanta-comida-mascota .species button,.mockup-cuanta-comida-mascota .meals button{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 12px;font-weight:800;cursor:pointer;color:var(--ink)}.mockup-cuanta-comida-mascota .species button.on,.mockup-cuanta-comida-mascota .meals button.on{background:var(--blue);color:#fff;border-color:var(--blue)}.mockup-cuanta-comida-mascota .day{display:grid;grid-template-columns:1.15fr .85fr;gap:22px;margin:24px 0 55px}.mockup-cuanta-comida-mascota .schedule,.mockup-cuanta-comida-mascota .nutrition{background:#fff;border:1px solid var(--line);border-radius:24px;padding:26px}.mockup-cuanta-comida-mascota .titleline{display:flex;justify-content:space-between;align-items:center;gap:15px}.mockup-cuanta-comida-mascota .titleline h2{font-size:27px;margin:0}.mockup-cuanta-comida-mascota .total{font-size:36px;font-weight:950;color:var(--blue)}.mockup-cuanta-comida-mascota .total small{display:block;font-size:12px;color:var(--muted);text-align:right}.mockup-cuanta-comida-mascota .timeline{position:relative;margin:35px 10px 25px;height:140px;border-top:5px solid #cddbd7}.mockup-cuanta-comida-mascota .meal{position:absolute;top:-18px;transform:translateX(-50%);text-align:center}.mockup-cuanta-comida-mascota .meal i{display:block;width:32px;height:32px;border:8px solid var(--coral);background:#fff;border-radius:50%;margin:auto}.mockup-cuanta-comida-mascota .meal b{display:block;margin-top:10px;font-size:18px}.mockup-cuanta-comida-mascota .meal small{color:var(--muted)}.mockup-cuanta-comida-mascota .meals{display:flex;align-items:center;gap:8px}.mockup-cuanta-comida-mascota .meals span{font-weight:850;margin-right:4px}.mockup-cuanta-comida-mascota .caloriebar{height:28px;border-radius:99px;overflow:hidden;display:flex;margin:20px 0 10px}.mockup-cuanta-comida-mascota .foodbar{background:var(--blue);width:90%}.mockup-cuanta-comida-mascota .treatbar{background:var(--coral);width:10%}.mockup-cuanta-comida-mascota .legend{display:flex;justify-content:space-between;font-size:13px}.mockup-cuanta-comida-mascota .facts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:22px}.mockup-cuanta-comida-mascota .fact{padding:15px;border-radius:14px;background:var(--paper)}.mockup-cuanta-comida-mascota .fact b{display:block;font-size:22px}.mockup-cuanta-comida-mascota .fact span{font-size:12px;color:var(--muted)}.mockup-cuanta-comida-mascota .warning{margin-top:18px;padding:14px;border-radius:14px;background:var(--sand);color:#5a431d}.mockup-cuanta-comida-mascota .method{background:var(--mint);padding:35px 0}.mockup-cuanta-comida-mascota .methodgrid{display:grid;grid-template-columns:.8fr 1.2fr;gap:35px;align-items:start}.mockup-cuanta-comida-mascota .method h2{font-size:31px;margin:0}.mockup-cuanta-comida-mascota .formula{background:#fff;border-radius:18px;padding:20px;font-weight:750}.mockup-cuanta-comida-mascota .formula code{display:block;color:var(--blue);font-size:18px;margin-bottom:8px}@media(max-width:820px){.mockup-cuanta-comida-mascota .intro,.mockup-cuanta-comida-mascota .day,.mockup-cuanta-comida-mascota .methodgrid{grid-template-columns:1fr}.mockup-cuanta-comida-mascota .passport{grid-template-columns:1fr 1fr}.mockup-cuanta-comida-mascota .bowl{order:-1}.mockup-cuanta-comida-mascota .intro h1{font-size:48px}}@media(max-width:520px){.mockup-cuanta-comida-mascota .passport{grid-template-columns:1fr}.mockup-cuanta-comida-mascota .facts{grid-template-columns:1fr}.mockup-cuanta-comida-mascota .titleline{align-items:start;flex-direction:column}.mockup-cuanta-comida-mascota .total small{text-align:left}}

.mockup-cuanta-comida-mascota { width:100%; overflow:hidden; }
.mockup-cuanta-comida-mascota .top, .mockup-cuanta-comida-mascota header.top { display:none !important; }
.mockup-cuanta-comida-mascota .foot { display:none !important; }
.mockup-cuanta-comida-mascota .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-cuanta-comida-mascota .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-cuanta-comida-mascota .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-cuanta-comida-mascota .support-real summary { cursor:pointer; font-weight:750; }
.mockup-cuanta-comida-mascota .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-cuanta-comida-mascota :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-cuanta-comida-mascota input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-cuanta-comida-mascota input[type="number"]::-webkit-inner-spin-button, .mockup-cuanta-comida-mascota input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-cuanta-comida-mascota .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-cuanta-comida-mascota support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
