---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-bebidas-evento" set:html={`<section class="hero"><div class="wrap crumb"><b>Eventos</b> &nbsp;/&nbsp; Bebidas</div><div class="wrap grid"><div class="copy"><div class="eyebrow">La compra justa para tu fiesta</div><h1>Que alcance para brindar. No para llenar la despensa.</h1><p>Repartí bien el consumo entre cerveza, vino, tragos, gaseosa y agua. Sumá hielo y obtené una lista concreta.</p><div class="chips"><span>✓ Personas sin duplicar</span><span>▤ Botellas y packs</span><span>❄ Hielo incluido</span></div><div class="art"><div class="table"></div><div class="bottle beer"></div><div class="bottle wine"></div><div class="bottle water"></div><div class="glass"></div><div class="listcard"><small>LISTA DE COMPRA</small><strong id="art-total">86 envases</strong><span id="art-copy">para 50 invitados</span></div></div></div><form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Armá la barra</h2><p class="muted">Elegí el estilo del evento.</p></div><span class="tag">Margen incluido</span></div><div class="label">Tipo de encuentro</div><div class="cases"><button type="button" class="case active" data-mode="party"><i>♫</i>Fiesta de adultos</button><button type="button" class="case" data-mode="dinner"><i>⌂</i>Cena</button><button type="button" class="case" data-mode="family"><i>☺</i>Evento familiar</button><button type="button" class="case" data-mode="toast"><i>♢</i>Brindis</button></div><div class="label">Datos del evento</div><div class="fields"><div class="field"><label>Invitados totales</label><input id="guests" value="50"></div><div class="field"><label>Niños</label><input id="kids" value="8"></div><div class="field"><label>Duración</label><select id="hours"><option value="3">3 horas</option><option value="5" selected>5 horas</option><option value="8">8 horas</option></select></div><div class="field"><label>Adultos que toman alcohol</label><select id="drinkers"><option value=".6">60%</option><option value=".8" selected>80%</option><option value="1">100%</option></select></div><div class="field"><label>Clima</label><select id="weather"><option value="normal">Templado</option><option value="summer">Caluroso / verano</option></select></div><div class="field"><label>Margen extra</label><select id="margin"><option value="1">Sin margen adicional</option><option value="1.1" selected>10% tranquilo</option><option value="1.2">20% holgado</option></select></div></div><section class="result"><div class="result-top"><div><small>TOTAL DE ENVASES</small><div class="value" id="result">86 envases</div></div><div class="ratio"><small>Por invitado</small><b id="ratio">2,6 L</b></div></div><div class="stats"><span>BEBIDAS TOTALES<b id="stat-liters">128 litros</b></span><span>HIELO<b id="stat-ice">13 kg</b></span><span>TOMADORES<b id="stat-drinkers">34 adultos</b></span></div><button class="go" id="update" type="button">Actualizar lista</button></section></form></div></section>
<section class="section"><div class="wrap"><div class="center"><div class="eyebrow">Tu lista, lista</div><h2>Comprá envases, no litros abstractos</h2><p>Redondeamos hacia arriba para que puedas ir directo al supermercado.</p></div><div class="shopping"><div class="item"><i>🍺</i><b id="q-beer">48</b><span>latas de cerveza</span></div><div class="item"><i>🍷</i><b id="q-wine">8</b><span>botellas de vino</span></div><div class="item"><i>🥃</i><b id="q-spirit">3</b><span>botellas de fernet</span></div><div class="item"><i>🥤</i><b id="q-soda">12</b><span>gaseosas de 2,25 L</span></div><div class="item"><i>💧</i><b id="q-water">4</b><span>bidones de agua</span></div><div class="item"><i>❄</i><b id="q-ice">13 kg</b><span>hielo</span></div></div></div></section><section class="break"><div class="wrap cards"><article class="card"><h3>Volúmenes por categoría</h3><div class="line"><span>Cerveza</span><b id="d-beer">23,0 L</b></div><div class="line"><span>Vino</span><b id="d-wine">6,0 L</b></div><div class="line"><span>Fernet y destilados</span><b id="d-spirit">2,1 L</b></div><div class="line"><span>Gaseosas y mezcladores</span><b id="d-soda">27,0 L</b></div><div class="line"><span>Agua</span><b id="d-water">20,0 L</b></div><div class="line total"><strong>Total con margen</strong><b id="d-total">78,1 L</b></div></article><article class="card"><h3>Cómo evita comprar de más</h3><div class="step"><i>1</i><div><b>Separamos niños y adultos</b><span>El agua y la gaseosa cuentan para todos; el alcohol no.</span></div></div><div class="step"><i>2</i><div><b>Repartimos a los tomadores</b><span>No suponemos que cada persona toma cerveza, vino y fernet a la vez.</span></div></div><div class="step"><i>3</i><div><b>Convertimos a envases</b><span>Cada categoría se redondea hacia arriba.</span></div></div><div class="warning">⚠️ No calcules alcohol para quienes manejan. Siempre ofrecé agua y opciones sin alcohol.</div></article></div></section><section class="darksection"><div class="wrap"><div class="rules"><div class="rule"><i>💧</i><h3>Agua siempre visible</h3><p>Dejala fría y accesible durante todo el evento, no sólo al final.</p></div><div class="rule"><i>❄</i><h3>Separá hielo de enfriado</h3><p>El hielo para conservar botellas no debería ser el mismo que va a los vasos.</p></div><div class="rule"><i>＋</i><h3>Margen con criterio</h3><p>Un 10% suele cubrir imprevistos sin transformar la compra en exceso.</p></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-bebidas-evento')?document.currentScript.previousElementSibling:document.querySelector('.mockup-bebidas-evento');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0);let mode="party",cfg={party:[.48,.14,.2],dinner:[.22,.58,.1],family:[.25,.2,.08],toast:[.12,.7,.1]};function fmt(x){return x.toFixed(1).replace(".",",")}function calc(){let guests=Math.max(1,n("#guests")),kids=Math.min(guests,n("#kids")),adults=guests-kids,h=n("#hours"),drinkers=adults*Number($("#drinkers").value),hot=$("#weather").value==="summer"?1.2:1,margin=Number($("#margin").value),c=cfg[mode],beer=drinkers*c[0]*h*.18*hot*margin,wine=drinkers*c[1]*h*.075*margin,spirit=drinkers*c[2]*(h<4?1.5:2.5)*.25*.3*margin,soda=(kids*.55+adults*.35)*(h>=5?1.25:1)*margin+spirit*2.3,water=guests*(hot>1?.75:.5)*(h>=6?1.25:1)*margin,liters=beer+wine+spirit+soda+water,beerC=Math.ceil(beer/.473),wineB=Math.ceil(wine/.75),spiritB=Math.ceil(spirit/.75),sodaB=Math.ceil(soda/2.25),waterB=Math.ceil(water/6),ice=Math.ceil(Math.max(guests/4,beer*.35)),env=beerC+wineB+spiritB+sodaB+waterB;$("#result").textContent=env+" envases";$("#art-total").textContent=env+" envases";$("#art-copy").textContent="para "+guests+" invitados";$("#ratio").textContent=fmt(liters/guests)+" L";$("#stat-liters").textContent=fmt(liters)+" litros";$("#stat-ice").textContent=ice+" kg";$("#stat-drinkers").textContent=Math.round(drinkers)+" adultos";$("#q-beer").textContent=beerC;$("#q-wine").textContent=wineB;$("#q-spirit").textContent=spiritB;$("#q-soda").textContent=sodaB;$("#q-water").textContent=waterB;$("#q-ice").textContent=ice+" kg";$("#d-beer").textContent=fmt(beer)+" L";$("#d-wine").textContent=fmt(wine)+" L";$("#d-spirit").textContent=fmt(spirit)+" L";$("#d-soda").textContent=fmt(soda)+" L";$("#d-water").textContent=fmt(water)+" L";$("#d-total").textContent=fmt(liters)+" L"}
function setMode(m){mode=m;$$(".case").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Lista actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar lista",1200)};calc();

})();
</script>
<style is:global>

.mockup-bebidas-evento *{box-sizing:border-box}.mockup-bebidas-evento{margin:0;color:#16243a;background:#fff;font:15px Inter,system-ui,sans-serif}.mockup-bebidas-evento button,.mockup-bebidas-evento input,.mockup-bebidas-evento select{font:inherit}.mockup-bebidas-evento .wrap{max-width:1170px;margin:auto;padding:0 24px}.mockup-bebidas-evento header{height:82px;border-bottom:1px solid #e4e7e8;display:flex;align-items:center}.mockup-bebidas-evento .nav{display:flex;align-items:center;gap:35px}.mockup-bebidas-evento .brand{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:900}.mockup-bebidas-evento .logo{background:#233d57;color:#fff;padding:9px 7px;border-radius:8px;font-size:11px}.mockup-bebidas-evento .links{display:flex;gap:28px;margin:auto;color:#526174;font-size:12px;font-weight:750}.mockup-bebidas-evento .tools{display:flex;gap:8px}.mockup-bebidas-evento .tools span{padding:11px 13px;border:1px solid #dde4e7;border-radius:10px;font-size:12px;font-weight:750}.mockup-bebidas-evento .tools .dark{background:#233e59;color:#fff}.mockup-bebidas-evento .hero{padding:28px 0 52px;background:linear-gradient(130deg,#fff8f1,#f8f8ff 62%,#f1faf6)}.mockup-bebidas-evento .crumb{font-size:12px;color:#778292;margin-bottom:25px}.mockup-bebidas-evento .crumb b,.mockup-bebidas-evento .eyebrow{color:#b45a40}.mockup-bebidas-evento .grid{display:grid;grid-template-columns:.87fr 1.13fr;gap:50px}.mockup-bebidas-evento .copy{padding-top:10px}.mockup-bebidas-evento .eyebrow{text-transform:uppercase;font-size:11px;letter-spacing:1.7px;font-weight:900}.mockup-bebidas-evento .copy h1{font-size:49px;line-height:1.04;letter-spacing:-2.5px;margin:15px 0}.mockup-bebidas-evento .copy p{font-size:17px;line-height:1.62;color:#5f6c7c}.mockup-bebidas-evento .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.mockup-bebidas-evento .chips span{background:#fff;border:1px solid #e3dfda;padding:9px 11px;border-radius:9px;font-size:10px;font-weight:750}.mockup-bebidas-evento .art{height:230px;position:relative}.mockup-bebidas-evento .table{position:absolute;left:30px;right:30px;bottom:23px;height:17px;background:#b4845b;border-radius:8px}.mockup-bebidas-evento .bottle{position:absolute;bottom:40px;border-radius:12px 12px 5px 5px}.mockup-bebidas-evento .beer{left:75px;width:61px;height:144px;background:#e0aa3d}.mockup-bebidas-evento .beer:before{content:"";position:absolute;left:17px;top:-25px;width:27px;height:35px;background:#d8a135;border-radius:7px}.mockup-bebidas-evento .wine{left:160px;width:53px;height:177px;background:#6d4154}.mockup-bebidas-evento .wine:before{content:"";position:absolute;left:16px;top:-37px;width:21px;height:48px;background:#69404f;border-radius:6px}.mockup-bebidas-evento .water{left:237px;width:61px;height:125px;background:#71b4c9}.mockup-bebidas-evento .water:before{content:"";position:absolute;left:19px;top:-20px;width:23px;height:29px;background:#6aadc2;border-radius:6px}.mockup-bebidas-evento .glass{position:absolute;left:320px;bottom:40px;width:85px;height:105px;background:#e2eef266;clip-path:polygon(12% 0,88% 0,70% 100%,30% 100%);border-bottom:10px solid #c8dce2}.mockup-bebidas-evento .bottle:after{content:"";position:absolute;left:8px;right:8px;top:53px;height:38px;background:#fff8;border-radius:4px}.mockup-bebidas-evento .listcard{position:absolute;right:0;top:22px;background:#fff;border:1px solid #e5ddd7;border-radius:14px;padding:14px 18px;box-shadow:0 18px 40px #49331f1b}.mockup-bebidas-evento .listcard small{font-size:8px;color:#7b7e84}.mockup-bebidas-evento .listcard strong{display:block;font-size:22px;color:#b25a3b;margin:5px 0}.mockup-bebidas-evento .listcard span{font-size:9px;color:#68717b}
.mockup-bebidas-evento .calc{background:#fff;border:1px solid #e2e2df;border-radius:21px;padding:27px 29px;box-shadow:0 27px 60px #49351e14}.mockup-bebidas-evento .calc-head{display:flex;justify-content:space-between}.mockup-bebidas-evento .calc h2{font-size:24px;margin:0 0 5px}.mockup-bebidas-evento .muted{font-size:11px;color:#707985;margin:0}.mockup-bebidas-evento .tag{background:#fff0e5;color:#a65334;border-radius:99px;padding:7px 10px;font-size:9px;font-weight:850;height:max-content}.mockup-bebidas-evento .label{font-size:10px;font-weight:900;margin:18px 0 8px}.mockup-bebidas-evento .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.mockup-bebidas-evento .case{border:1px solid #e2dfdb;background:#fff;border-radius:11px;padding:10px 4px;color:#616e7d;font-size:9px;font-weight:800;cursor:pointer}.mockup-bebidas-evento .case i{display:block;font-style:normal;font-size:18px;margin-bottom:4px}.mockup-bebidas-evento .case.active{border:2px solid #d27750;background:#fff5ed;color:#a34e31;padding:9px 3px}.mockup-bebidas-evento .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-bebidas-evento .field{border:1px solid #e2e0dd;border-radius:11px;padding:10px 12px}.mockup-bebidas-evento .field label{display:block;color:#747d87;font-size:9px;margin-bottom:5px}.mockup-bebidas-evento .field input,.mockup-bebidas-evento .field select{width:100%;border:0;outline:0;background:transparent;color:#1b2d41;font-weight:800}.mockup-bebidas-evento .result{background:#293e54;color:#fff;border-radius:16px;padding:19px 20px;margin-top:13px}.mockup-bebidas-evento .result-top{display:flex;justify-content:space-between}.mockup-bebidas-evento .result small{color:#c3ced8;font-size:9px}.mockup-bebidas-evento .value{font-size:35px;font-weight:900;letter-spacing:-1.3px;margin-top:4px}.mockup-bebidas-evento .ratio{background:#fff0df;color:#a14f2f;border-radius:9px;padding:8px 10px;text-align:right}.mockup-bebidas-evento .ratio small{color:inherit}.mockup-bebidas-evento .ratio b{display:block;font-size:13px}.mockup-bebidas-evento .stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #485e73;margin-top:13px;padding-top:12px;gap:8px}.mockup-bebidas-evento .stats span{color:#becbd6;font-size:8px}.mockup-bebidas-evento .stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.mockup-bebidas-evento .go{width:100%;border:0;border-radius:9px;padding:12px;margin-top:13px;background:linear-gradient(90deg,#cf7048,#e5a25d);color:#fff;font-weight:850;cursor:pointer}.mockup-bebidas-evento .section{padding:68px 0}.mockup-bebidas-evento .center{text-align:center;max-width:700px;margin:0 auto 35px}.mockup-bebidas-evento .center h2{font-size:36px;letter-spacing:-1.4px;margin:9px}.mockup-bebidas-evento .center p{color:#65768a}.mockup-bebidas-evento .shopping{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.mockup-bebidas-evento .item{border:1px solid #e4e1dd;border-radius:15px;padding:18px 10px;text-align:center}.mockup-bebidas-evento .item i{font-style:normal;font-size:29px}.mockup-bebidas-evento .item b{display:block;font-size:18px;margin:9px 0}.mockup-bebidas-evento .item span{color:#727d88;font-size:9px}.mockup-bebidas-evento .break{background:#f8f6f2;padding:64px 0}.mockup-bebidas-evento .cards{display:grid;grid-template-columns:1.08fr .92fr;gap:20px}.mockup-bebidas-evento .card{background:#fff;border:1px solid #e5e1dc;border-radius:17px;padding:24px}.mockup-bebidas-evento .card h3{margin:0 0 16px;font-size:19px}.mockup-bebidas-evento .line{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #ece8e3}.mockup-bebidas-evento .line span{color:#6c7782;font-size:10px}.mockup-bebidas-evento .line b{font-size:12px}.mockup-bebidas-evento .line.total{background:#fff0e4;color:#a65233;margin-top:12px;padding:14px;border:0;border-radius:10px}.mockup-bebidas-evento .step{display:grid;grid-template-columns:34px 1fr;gap:11px;margin:14px 0}.mockup-bebidas-evento .step i{font-style:normal;background:#fff0e5;color:#a75536;width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-weight:900}.mockup-bebidas-evento .step b{font-size:11px}.mockup-bebidas-evento .step span{display:block;color:#697987;font-size:10px;margin-top:3px}.mockup-bebidas-evento .warning{background:#fff5df;color:#76591f;border:1px solid #efd9a6;padding:12px;border-radius:10px;font-size:10px}.mockup-bebidas-evento .darksection{background:#293e53;color:#fff;padding:61px 0}.mockup-bebidas-evento .rules{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-bebidas-evento .rule{border:1px solid #ffffff20;border-radius:15px;padding:18px}.mockup-bebidas-evento .rule i{font-style:normal;font-size:22px}.mockup-bebidas-evento .rule h3{font-size:13px;margin:10px 0 6px}.mockup-bebidas-evento .rule p{font-size:10px;line-height:1.55;color:#c3d0db;margin:0}
@media(max-width:800px){.mockup-bebidas-evento .links{display:none}.mockup-bebidas-evento .tools span:not(.dark){display:none}.mockup-bebidas-evento .grid,.mockup-bebidas-evento .cards{grid-template-columns:1fr}.mockup-bebidas-evento .copy{text-align:center}.mockup-bebidas-evento .copy h1{font-size:40px}.mockup-bebidas-evento .chips{justify-content:center}.mockup-bebidas-evento .art{max-width:470px;margin:auto}.mockup-bebidas-evento .calc{padding:20px 16px}.mockup-bebidas-evento .shopping{grid-template-columns:repeat(3,1fr)}.mockup-bebidas-evento .wrap{padding:0 15px}}@media(max-width:470px){.mockup-bebidas-evento .cases,.mockup-bebidas-evento .fields,.mockup-bebidas-evento .stats,.mockup-bebidas-evento .rules,.mockup-bebidas-evento .shopping{grid-template-columns:1fr}.mockup-bebidas-evento .art{transform:scale(.8);transform-origin:left top;height:185px}}

.mockup-bebidas-evento { width:100%; overflow:hidden; }
.mockup-bebidas-evento .top, .mockup-bebidas-evento header.top { display:none !important; }
.mockup-bebidas-evento .foot { display:none !important; }
.mockup-bebidas-evento .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-bebidas-evento .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-bebidas-evento .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-bebidas-evento .support-real summary { cursor:pointer; font-weight:750; }
.mockup-bebidas-evento .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-bebidas-evento :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-bebidas-evento input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-bebidas-evento input[type="number"]::-webkit-inner-spin-button, .mockup-bebidas-evento input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-bebidas-evento .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-bebidas-evento support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
