---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-premios-futbol" set:html={`
<section class="hero"><div class="heroin"><div><div class="crumb">Fútbol / Premios</div><div class="eyebrow">Torneos, planteles y transferencias</div><h1>Seguí la plata del fútbol, desde la copa hasta el club formador</h1><p class="lead">Premios por fase, bolsas de plantel, derechos, cláusulas y solidaridad FIFA. Cada cuenta con sus componentes visibles.</p><div class="pills"><span>Montos por fase</span><span>Reparto por jugador</span><span>Formación FIFA</span></div></div><div class="scene" aria-label="Trofeo sobre una cancha"><div class="pitch"></div><div class="cup"><div class="cupbody"></div><div class="stem"></div><div class="base"></div></div><div class="tag"><small>Premio estimado</small><strong id="heroAmount">USD 62,5 M</strong></div></div></div></section>
<section class="tool"><div class="wrap"><div class="sectionhead"><div><div class="kicker">Elegí de qué plata hablamos</div><h2>Seis cuentas distintas</h2></div><p>Los casos permanecen visibles porque un premio deportivo y una transferencia no se calculan igual.</p></div><div class="cases"><button class="case active" data-case="world"><strong>Mundial 2026</strong><small>Premio FIFA según fase.</small></button><button class="case" data-case="cup"><strong>Copa Argentina</strong><small>Premios acumulados por ronda.</small></button><button class="case" data-case="squad"><strong>Bolsa del plantel</strong><small>Victorias, empates y título.</small></button><button class="case" data-case="tv"><strong>Derechos de TV</strong><small>Valor total y por partido.</small></button><button class="case" data-case="clause"><strong>Cláusula de rescisión</strong><small>Mercado, rol y contrato.</small></button><button class="case" data-case="solidarity"><strong>Club formador</strong><small>Solidaridad FIFA de una venta.</small></button></div>
<div class="workspace"><div class="panel form"><h3 id="formTitle">Premio del Mundial 2026</h3><p class="sub" id="caseCopy">Sumamos el premio por rendimiento y el monto fijo de preparación.</p><div class="mode active" data-mode="world"><div class="field"><label for="worldPhase">Hasta dónde llegó la selección</label><select id="worldPhase"><option value="9">Fase de grupos · USD 9 M</option><option value="13">16avos · USD 13 M</option><option value="15">Octavos · USD 15 M</option><option value="19">Cuartos · USD 19 M</option><option value="27">Cuarto puesto · USD 27 M</option><option value="35">Subcampeón · USD 35 M</option><option value="50" selected>Campeón · USD 50 M</option></select></div></div><div class="mode" data-mode="cup"><div class="field"><label for="cupRound">Ronda alcanzada</label><select id="cupRound"><option value="20">32avos</option><option value="50">16avos</option><option value="100">Octavos</option><option value="180">Cuartos</option><option value="300">Semifinal</option><option value="500">Final</option><option value="1000">Campeón</option></select></div></div><div class="mode" data-mode="squad"><div class="fields"><div class="field"><label for="wins">Partidos ganados</label><input id="wins" type="number" value="8"></div><div class="field"><label for="draws">Partidos empatados</label><input id="draws" type="number" value="4"></div><div class="field"><label for="champion">¿Salió campeón?</label><select id="champion"><option value="0">No</option><option value="1000000">Sí</option></select></div><div class="field"><label for="players">Jugadores del plantel</label><input id="players" type="number" value="28"></div></div></div><div class="mode" data-mode="tv"><div class="field"><label for="tvCountry">Mercado de derechos</label><select id="tvCountry"><option value="2500,104">Mundial · USD 2.500 M / 104 partidos</option><option value="600,380">Liga grande · USD 600 M / 380 partidos</option><option value="120,420">Liga regional · USD 120 M / 420 partidos</option></select></div></div><div class="mode" data-mode="clause"><div class="fields"><div class="field"><label for="market">Valor de mercado (€)</label><input id="market" type="number" value="15000000"></div><div class="field"><label for="role">Peso en el plantel</label><select id="role"><option value="1.5">Figura</option><option value="1.2" selected>Titular</option><option value=".9">Rotación</option><option value=".7">Suplente</option></select></div><div class="field full"><label for="contract">Años de contrato restantes</label><input id="contract" type="number" min="1" max="5" value="3"></div></div></div><div class="mode" data-mode="solidarity"><div class="fields"><div class="field"><label for="transfer">Monto de transferencia (€)</label><input id="transfer" type="number" value="20000000"></div><div class="field"><label for="early">Años formados entre 12 y 15</label><input id="early" type="number" min="0" max="4" value="3"></div><div class="field full"><label for="late">Años formados entre 16 y 23</label><input id="late" type="number" min="0" max="8" value="4"></div></div></div><div class="actions"><button class="primary" id="calculate">Actualizar estimación</button><button class="reset" id="reset">Reiniciar</button></div></div>
<aside class="panel result" aria-live="polite"><span class="badge" id="badge">Mundial 2026</span><div class="big" id="amount">USD 62,5 M</div><div class="biglabel" id="label">ingreso total de la federación campeona</div><div class="meters"><div class="meter"><small id="m1l">Rendimiento</small><strong id="m1">USD 50 M</strong></div><div class="meter"><small id="m2l">Fijo preparación</small><strong id="m2">USD 12,5 M</strong></div><div class="meter"><small id="m3l">Por convocado</small><strong id="m3">USD 2,4 M</strong></div></div><div class="breakdown"><div class="row"><span id="r1l">Quién paga</span><strong id="r1">FIFA</strong></div><div class="row"><span id="r2l">Quién cobra</span><strong id="r2">Federación</strong></div><div class="row"><span id="r3l">Base usada</span><strong id="r3">Tabla oficial 2026</strong></div></div><div class="tip" id="tip">La FIFA paga a la federación. El bonus individual de cada futbolista depende del acuerdo interno de su selección.</div></aside></div></div></section>
<section class="guide"><div class="wrap guide-grid"><div><div class="kicker">No todo llega al jugador</div><h2>Premio, ingreso y reparto son cosas distintas</h2><p>El organismo paga a una federación o club; después aparecen impuestos, gastos y acuerdos internos.</p></div><div class="checks"><div class="check"><b>Premio del torneo</b><span>Se asigna por rendimiento o participación según el reglamento publicado.</span></div><div class="check"><b>Bolsa del plantel</b><span>Es un acuerdo interno y puede repartirse por igual, minutos o titularidades.</span></div><div class="check"><b>Cláusula</b><span>Es una referencia contractual, no necesariamente el precio final de una venta.</span></div><div class="check"><b>Solidaridad FIFA</b><span>Retiene hasta 5% de una transferencia internacional para clubes formadores.</span></div></div></div></section>
<section class="faq"><div class="wrap"><div class="kicker">Preguntas frecuentes</div><h2>Cómo leer los premios</h2><div class="faq-item open"><button class="faq-q">¿El campeón del Mundial recibe todo para los jugadores?<span>+</span></button><div class="faq-a">No. El pago va a la federación; cada asociación define cuánto reparte al cuerpo técnico y al plantel.</div></div><div class="faq-item"><button class="faq-q">¿Qué es la solidaridad FIFA?<span>+</span></button><div class="faq-a">Es hasta el 5% de una transferencia internacional, distribuido entre clubes que formaron al jugador de los 12 a los 23 años.</div></div><div class="faq-item"><button class="faq-q">¿La cláusula es el valor de mercado?<span>+</span></button><div class="faq-a">No necesariamente. Puede funcionar como protección contractual y quedar muy por encima de una negociación real.</div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-premios-futbol')?document.currentScript.previousElementSibling:document.querySelector('.mockup-premios-futbol');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],usd=n=>"USD "+(n>=1e6?Number((n/1e6).toFixed(1)).toLocaleString("es-AR")+" M":Math.round(n).toLocaleString("es-AR")),eur=n=>"€ "+Math.round(n).toLocaleString("es-AR");let active="world";const titles={world:["Premio del Mundial 2026","Sumamos el premio por rendimiento y el monto fijo de preparación."],cup:["Premios de Copa Argentina","Acumulamos una referencia de premios hasta la ronda alcanzada."],squad:["Bolsa del plantel","Sumamos premios por resultados y dividimos el fondo entre jugadores."],tv:["Derechos de televisión","Comparamos el valor total del contrato con el costo por partido."],clause:["Cláusula de rescisión","Ajustamos el valor de mercado por rol y años de contrato."],solidarity:["Mecanismo de solidaridad FIFA","Aplicamos 0,25% por año temprano y 0,5% por año entre 16 y 23."]};function set(a,b,c,d,e,f,g,h,i,j,k){$("#amount").textContent=a;$("#heroAmount").textContent=a;$("#label").textContent=b;$("#m1l").textContent=c;$("#m1").textContent=d;$("#m2l").textContent=e;$("#m2").textContent=f;$("#m3l").textContent=g;$("#m3").textContent=h;$("#tip").textContent=i;$("#r3").textContent=j;$("#r1").textContent=k}function calculate(){if(active==="world"){const p=+$("#worldPhase").value,total=p+12.5;set("USD "+total.toLocaleString("es-AR")+" M","ingreso total de la federación","Rendimiento","USD "+p+" M","Fijo preparación","USD 12,5 M","Por convocado","USD "+(total/26).toFixed(1).replace(".",",")+" M","La FIFA paga a la federación. El bonus individual depende del acuerdo interno.","Tabla oficial 2026","FIFA")}if(active==="cup"){const v=+$("#cupRound").value*1000;set(usd(v),"premios acumulados estimados","Ronda alcanzada",usd(v),"Instancias previas","Incluidas","Referencia por jugador",usd(v/28),"Son montos orientativos: verificá el reglamento y la comunicación vigente del torneo.","Premios de referencia","Organización")}if(active==="squad"){const wins=+$("#wins").value,draws=+$("#draws").value,ch=+$("#champion").value,players=Math.max(1,+$("#players").value),pool=wins*20000+draws*8000+ch;set(usd(pool),"bolsa total estimada","Victorias",usd(wins*20000),"Empates",usd(draws*8000),"Por jugador",usd(pool/players),"El reparto real puede ponderar minutos, convocatorias o titularidades.","Acuerdo interno","Club")}if(active==="tv"){const [total,games]=$("#tvCountry").value.split(",").map(Number),per=total*1e6/games;set("USD "+total.toLocaleString("es-AR")+" M","valor total de derechos","Partidos",games,"Por partido",usd(per),"Participación del total","100%","El valor del contrato incluye producción, territorio, plataformas y duración.","Contrato de referencia","Broadcasters")}if(active==="clause"){const market=+$("#market").value,role=+$("#role").value,years=+$("#contract").value,factor=role*(.7+years*.1),value=market*factor;set(eur(value),"cláusula estimada","Mercado",eur(market),"Multiplicador",factor.toFixed(2).replace(".",",")+"×","Contrato",years+" años","La cláusula protege al club, pero una transferencia puede cerrarse por otro monto.","Modelo orientativo","Club comprador")}if(active==="solidarity"){const transfer=+$("#transfer").value,early=Math.min(4,+$("#early").value),late=Math.min(8,+$("#late").value),rate=early*.0025+late*.005,value=transfer*rate;set(eur(value),"para este club formador","Transferencia",eur(transfer),"Tasa aplicada",(rate*100).toFixed(2).replace(".",",")+"%","Máximo FIFA","5%","El total se reparte entre todos los clubes formadores según los años acreditados.","Anexo 5 FIFA","Club comprador")}}
$$("[data-case]").forEach(b=>b.addEventListener("click",()=>{active=b.dataset.case;$$("[data-case]").forEach(x=>x.classList.toggle("active",x===b));$$(".mode").forEach(x=>x.classList.toggle("active",x.dataset.mode===active));$("#badge").textContent=b.querySelector("strong").textContent;$("#formTitle").textContent=titles[active][0];$("#caseCopy").textContent=titles[active][1];calculate()}));$$("input,select").forEach(x=>x.addEventListener("input",calculate));$("#calculate").addEventListener("click",calculate);$("#reset").addEventListener("click",()=>$("[data-case=world]").click());$$(".faq-q").forEach(q=>q.addEventListener("click",()=>q.parentElement.classList.toggle("open")));calculate()})();

})();
</script>
<style is:global>

.mockup-premios-futbol{--blue:#174b7a;--blue2:#397f9f;--ink:#172334;--muted:#626d7a;--line:#dce3e4;--gold:#dfa93f;--cream:#fff8e7;--green:#27715b;--mint:#d8eee5;--grass:#dcead8}.mockup-premios-futbol *{box-sizing:border-box}.mockup-premios-futbol{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fbfdfb}.mockup-premios-futbol button,.mockup-premios-futbol input,.mockup-premios-futbol select{font:inherit}.mockup-premios-futbol .head{height:74px;padding:0 max(24px,calc((100% - 1180px)/2));display:flex;align-items:center;justify-content:space-between;background:white;border-bottom:1px solid var(--line)}.mockup-premios-futbol .brand{font-size:19px;font-weight:900}.mockup-premios-futbol .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:10px;background:var(--blue);color:white}.mockup-premios-futbol .nav{display:flex;gap:28px;color:#4e5967;font-size:14px;font-weight:750}.mockup-premios-futbol .search{padding:10px 15px;border:1px solid var(--line);border-radius:11px;background:white}.mockup-premios-futbol .hero{padding:55px 24px 62px;background:linear-gradient(120deg,#fafcf9 0 64%,#e7f1e4 64%)}.mockup-premios-futbol .heroin{max-width:1180px;margin:auto;display:grid;grid-template-columns:1.05fr .95fr;gap:55px;align-items:center}.mockup-premios-futbol .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-premios-futbol .eyebrow{margin-top:27px;text-transform:uppercase;letter-spacing:.14em;color:#a47212;font-size:12px;font-weight:900}.mockup-premios-futbol .hero h1{font-size:clamp(43px,5vw,68px);line-height:.98;letter-spacing:-.05em;margin:10px 0 20px;max-width:700px}.mockup-premios-futbol .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-premios-futbol .pills{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-premios-futbol .pills span{padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:white;font-size:13px;font-weight:800}.mockup-premios-futbol .scene{min-height:340px;position:relative}.mockup-premios-futbol .pitch{position:absolute;inset:38px 3% 25px;background:#4f9865;border:8px solid white;border-radius:22px;box-shadow:0 24px 36px #254a3424}.mockup-premios-futbol .pitch:before{content:"";position:absolute;left:50%;top:0;bottom:0;border-left:4px solid #ffffff99}.mockup-premios-futbol .pitch:after{content:"";position:absolute;width:100px;height:100px;left:50%;top:50%;transform:translate(-50%,-50%);border:4px solid #ffffff99;border-radius:50%}.mockup-premios-futbol .cup{position:absolute;width:155px;height:210px;left:50%;top:35px;transform:translateX(-50%);z-index:2}.mockup-premios-futbol .cupbody{position:absolute;left:30px;right:30px;top:0;height:125px;background:linear-gradient(90deg,#bd8424,#f5d478 48%,#b67b1e);clip-path:polygon(10% 0,90% 0,78% 72%,62% 100%,38% 100%,22% 72%)}.mockup-premios-futbol .cupbody:before,.mockup-premios-futbol .cupbody:after{content:"";position:absolute;width:55px;height:65px;border:12px solid var(--gold);border-radius:50%;top:12px;z-index:-1}.mockup-premios-futbol .cupbody:before{left:-38px}.mockup-premios-futbol .cupbody:after{right:-38px}.mockup-premios-futbol .stem{position:absolute;left:67px;top:115px;width:22px;height:55px;background:var(--gold)}.mockup-premios-futbol .base{position:absolute;left:30px;right:30px;bottom:15px;height:27px;background:var(--gold);border-radius:6px}.mockup-premios-futbol .tag{position:absolute;right:0;bottom:18px;z-index:3;padding:12px 15px;background:white;border:1px solid var(--line);border-radius:13px;box-shadow:0 12px 25px #24433718}.mockup-premios-futbol .tag small{display:block;color:var(--muted)}.mockup-premios-futbol .tag strong{font-size:21px;color:#a47212}
.mockup-premios-futbol .tool{padding:65px 24px}.mockup-premios-futbol .wrap{max-width:1180px;margin:auto}.mockup-premios-futbol .sectionhead{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:23px}.mockup-premios-futbol .kicker{text-transform:uppercase;letter-spacing:.14em;color:#a47212;font-size:12px;font-weight:900}.mockup-premios-futbol .sectionhead h2,.mockup-premios-futbol .guide h2,.mockup-premios-futbol .faq h2{font-size:37px;letter-spacing:-.04em;margin:8px 0}.mockup-premios-futbol .sectionhead p{max-width:510px;color:var(--muted);margin:0}.mockup-premios-futbol .cases{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:22px}.mockup-premios-futbol .case{min-height:96px;padding:16px;text-align:left;border:1px solid var(--line);border-radius:16px;background:white;color:var(--ink);cursor:pointer}.mockup-premios-futbol .case strong{display:block;margin-bottom:4px}.mockup-premios-futbol .case small{color:var(--muted)}.mockup-premios-futbol .case.active{border:2px solid var(--gold);padding:15px;background:#fffaf0;box-shadow:0 9px 22px #a4721212}.mockup-premios-futbol .workspace{display:grid;grid-template-columns:.9fr 1.1fr;gap:20px}.mockup-premios-futbol .panel{padding:28px;border-radius:24px}.mockup-premios-futbol .form{background:white;border:1px solid var(--line);box-shadow:0 16px 40px #17364a0d}.mockup-premios-futbol .panel h3{font-size:21px;margin:0 0 5px}.mockup-premios-futbol .sub{margin:0 0 22px;color:var(--muted);font-size:14px}.mockup-premios-futbol .fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.mockup-premios-futbol .field.full{grid-column:1/-1}.mockup-premios-futbol .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-premios-futbol .field small{display:block;color:var(--muted);font-size:12px;margin-top:6px}.mockup-premios-futbol input,.mockup-premios-futbol select{width:100%;min-height:50px;border:1px solid #d2dbdd;border-radius:12px;background:white;padding:12px 14px;color:var(--ink)}.mockup-premios-futbol .mode{display:none}.mockup-premios-futbol .mode.active{display:block}.mockup-premios-futbol .actions{display:flex;gap:10px;margin-top:22px}.mockup-premios-futbol .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:white;padding:14px;font-weight:900;cursor:pointer}.mockup-premios-futbol .reset{border:1px solid var(--gold);border-radius:12px;background:white;color:#6a5120;padding:13px 17px;font-weight:850;cursor:pointer}.mockup-premios-futbol .result{position:relative;overflow:hidden;background:linear-gradient(140deg,var(--blue),var(--blue2));color:white}.mockup-premios-futbol .result:after{content:"";position:absolute;width:250px;height:250px;border:46px solid #ffffff0b;border-radius:50%;right:-130px;bottom:-120px}.mockup-premios-futbol .badge{display:inline-block;padding:7px 10px;border-radius:999px;background:var(--mint);color:#184f40;font-size:12px;font-weight:900}.mockup-premios-futbol .big{font-size:47px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:14px 0 3px}.mockup-premios-futbol .biglabel{color:#dfedf2;font-size:14px}.mockup-premios-futbol .meters{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:20px 0}.mockup-premios-futbol .meter{position:relative;z-index:1;padding:13px;border:1px solid #ffffff2c;background:#ffffff0e;border-radius:14px}.mockup-premios-futbol .meter small{display:block;color:#dcebf1;font-size:11px}.mockup-premios-futbol .meter strong{font-size:17px}.mockup-premios-futbol .breakdown{position:relative;z-index:1;padding:15px;border:1px solid #ffffff28;background:#ffffff0f;border-radius:15px}.mockup-premios-futbol .row{display:flex;justify-content:space-between;gap:15px;padding:7px 0;border-bottom:1px solid #ffffff20}.mockup-premios-futbol .row:last-child{border:0}.mockup-premios-futbol .row span{color:#dcebf1}.mockup-premios-futbol .tip{position:relative;z-index:1;margin-top:15px;padding:13px 15px;border-radius:12px;background:var(--cream);color:#58482d;font-size:13px;font-weight:750}.mockup-premios-futbol .guide{padding:70px 24px;background:#f2f7f3}.mockup-premios-futbol .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:44px}.mockup-premios-futbol .guide p{color:var(--muted)}.mockup-premios-futbol .checks{display:grid;grid-template-columns:1fr 1fr;gap:12px}.mockup-premios-futbol .check{padding:18px;border:1px solid var(--line);border-radius:16px;background:white}.mockup-premios-futbol .check b{display:block;color:var(--green);margin-bottom:5px}.mockup-premios-futbol .check span{font-size:14px;color:var(--muted)}.mockup-premios-futbol .faq{padding:70px 24px}.mockup-premios-futbol .faq-item{border-top:1px solid var(--line)}.mockup-premios-futbol .faq-q{width:100%;display:flex;justify-content:space-between;padding:18px 0;border:0;background:none;text-align:left;color:var(--ink);font-weight:850;cursor:pointer}.mockup-premios-futbol .faq-a{display:none;padding:0 0 20px;color:var(--muted);max-width:820px}.mockup-premios-futbol .faq-item.open .faq-a{display:block}.mockup-premios-futbol .foot{padding:30px;text-align:center;border-top:1px solid var(--line);background:white;color:var(--muted)}@media(max-width:870px){.mockup-premios-futbol .nav{display:none}.mockup-premios-futbol .heroin,.mockup-premios-futbol .workspace,.mockup-premios-futbol .guide-grid{grid-template-columns:1fr}.mockup-premios-futbol .cases{grid-template-columns:1fr 1fr}.mockup-premios-futbol .sectionhead{flex-direction:column;align-items:start}}@media(max-width:540px){.mockup-premios-futbol .cases,.mockup-premios-futbol .fields,.mockup-premios-futbol .checks,.mockup-premios-futbol .meters{grid-template-columns:1fr}.mockup-premios-futbol .hero h1{font-size:44px}.mockup-premios-futbol .actions{flex-direction:column}}

.mockup-premios-futbol { width:100%; overflow:hidden; }
.mockup-premios-futbol .top, .mockup-premios-futbol header.top { display:none !important; }
.mockup-premios-futbol .foot { display:none !important; }
.mockup-premios-futbol .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-premios-futbol .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-premios-futbol .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-premios-futbol .support-real summary { cursor:pointer; font-weight:750; }
.mockup-premios-futbol .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-premios-futbol :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
