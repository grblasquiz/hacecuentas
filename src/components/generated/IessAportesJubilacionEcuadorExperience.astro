---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-iess-aportes-jubilacion-ecuador" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>Ecuador</b> / Trabajo / IESS, aportes y jubilación</div><div class="hero-grid"><div><span class="eyebrow">Tu historia laboral, explicada</span><h1>Lo que aportás hoy define lo que podés cobrar mañana.</h1><p class="lead">Calculá tu aporte al IESS, proyectá cuándo podrías jubilarte y entendé la pensión, la jubilación patronal y el montepío sin mezclar beneficios.</p><div class="pills"><span class="pill">✓ Aporte personal y patronal</span><span class="pill">✓ Requisitos por edad</span><span class="pill">✓ Pensión estimada</span></div></div><aside class="hero-card"><span class="eyebrow" style="color:#bfd3ef">El camino completo</span><div class="road"><i class="point one"></i><i class="point two"></i><i class="point three"></i><span class="s1">APORTAR</span><span class="s2">CUMPLIR</span><span class="s3">COBRAR</span></div><h2>Aportes → requisitos → pensión</h2><p>Cada etapa usa una base distinta. Acá las ves separadas.</p><div class="hero-mini"><div><small>APORTE PERSONAL</small><strong>9,45%</strong></div><div><small>APORTE PATRONAL</small><strong>11,15%</strong></div></div></aside></div></div></section>
<section class="tool"><div class="wrap"><header class="section-head"><span class="eyebrow">Elegí tu situación</span><h2>¿Qué necesitás saber del IESS?</h2><p>Mostramos todos los casos, pero cada uno carga únicamente los datos que cambian el resultado.</p></header><div class="group-label">LO QUE SE APORTA</div><div class="cases"><button class="case active" data-case="dependencia"><strong>Relación de dependencia</strong><small>Tu parte + la de la empresa</small></button><button class="case" data-case="voluntario"><strong>Afiliación voluntaria</strong><small>17,60% sobre la base declarada</small></button><button class="case" data-case="hogar"><strong>Trabajo remunerado del hogar</strong><small>Sueldo, aportes, décimos y fondos</small></button></div><div class="group-label">LO QUE SE COBRA</div><div class="cases"><button class="case" data-case="jubilacion"><strong>Pensión de vejez IESS</strong><small>Edad, aportes y promedio salarial</small></button><button class="case" data-case="patronal"><strong>Jubilación patronal</strong><small>25 años con el mismo empleador</small></button><button class="case" data-case="montepio"><strong>Montepío familiar</strong><small>Viudez y orfandad</small></button></div>
<div class="calc-grid"><article class="panel"><h3 id="formTitle">Datos de tu aporte</h3><p class="intro" id="formIntro">Todo en dólares. Usá la materia gravada del mes.</p><div class="fields"><div class="field full income"><label id="incomeLabel" for="income">Remuneración mensual</label><div class="money"><span>$</span><input id="income" value="800" inputmode="decimal"></div><div class="help" id="incomeHelp">Incluye sueldo, horas extra y comisiones; no incluye décimos.</div></div><div class="field years hidden"><label for="years">Años de aportación</label><input id="years" type="number" min="0" max="50" value="25"></div><div class="field age hidden"><label for="age">Tu edad</label><input id="age" type="number" min="16" max="100" value="60"></div><div class="field average hidden"><label for="average">Promedio de los 5 mejores años</label><div class="money"><span>$</span><input id="average" value="900" inputmode="decimal"></div></div><div class="field coefficient hidden"><label for="coefficient">Coeficiente de edad MDT</label><input id="coefficient" type="number" min="1" max="200" value="100"></div><div class="field children hidden"><label for="children">Hijos con derecho</label><input id="children" type="number" min="0" max="10" value="2"></div><div class="field mora"><label for="mora">Meses de mora patronal</label><input id="mora" type="number" min="0" max="60" value="0"></div></div><button class="go" id="calculate">Actualizar cálculo</button><p class="privacy">Estimación informativa. La historia laboral oficial del IESS es la que manda.</p></article>
<article class="panel result"><div class="result-top"><div><h3 id="resultTitle">Tu aporte personal</h3><p class="intro" id="resultCaption">Descuento mensual en relación de dependencia.</p></div><span class="status" id="status">APORTE</span></div><div class="big-label" id="mainLabel">SALE DE TU SUELDO</div><div class="big" id="mainValue">$75,60</div><div class="sub" id="mainSub"></div><div class="progress"><div class="progress-head"><span id="progressLabel">Cómo se completa el aporte</span><strong id="progressValue">20,60%</strong></div><div class="track"><i id="progressBar"></i></div><p id="progressText">Vos aportás 9,45% y la empresa completa 11,15%.</p></div><div class="rows" id="rows"></div><div class="notice" id="notice"></div></article></div></div></section>
<section class="explain"><div class="wrap"><div class="split-head"><div><span class="eyebrow">No es una sola cuenta</span><h2>Tres bases, tres resultados distintos.</h2></div><p>El aporte se calcula sobre la materia gravada; la pensión usa los mejores años; la patronal exige permanencia con la misma empresa.</p></div><div class="cards"><article class="info dark"><span>APORTE MENSUAL</span><h3>Tu remuneración gravada</h3><p>Sueldo, horas extra y comisiones. Los décimos quedan afuera de la base.</p></article><article class="info"><span>PENSIÓN IESS</span><h3>Los cinco mejores años</h3><p>Al promedio se le aplica un coeficiente creciente según tus años imponibles.</p></article><article class="info"><span>JUBILACIÓN PATRONAL</span><h3>La misma empresa</h3><p>La plena se consolida al llegar a 25 años con el mismo empleador y es adicional al IESS.</p></article></div></div></section>
<section class="requirements"><div class="wrap"><header class="section-head"><span class="eyebrow">Requisitos de vejez</span><h2>Más aportes permiten jubilarte antes.</h2></header><div class="req-grid"><article class="req"><b>60</b><span>AÑOS DE EDAD</span><p>Con 30 años o más de aportación.</p></article><article class="req"><b>65</b><span>AÑOS DE EDAD</span><p>Con al menos 15 años de aportación.</p></article><article class="req"><b>70</b><span>AÑOS DE EDAD</span><p>Con el mínimo de 10 años aportados.</p></article><article class="req"><b>40</b><span>AÑOS APORTADOS</span><p>Coeficiente referencial del 100% del promedio.</p></article></div></div></section>
<section class="faq"><div class="wrap faq-grid"><div class="faq-intro"><span class="eyebrow">Preguntas frecuentes</span><h2>Tu jubilación, sin atajos confusos.</h2><p>Las diferencias que más cambian la proyección.</p></div><div><div class="faq-item open"><button><span>¿Cuántos años necesito para jubilarme?</span><b>+</b></button><div class="answer">El mínimo son 10 años de aportes y exige 70 años de edad. Con 15 años podés acceder a los 65 y con 30 años, a los 60.</div></div><div class="faq-item"><button><span>¿La jubilación patronal reemplaza al IESS?</span><b>+</b></button><div class="answer">No. Son beneficios independientes y pueden cobrarse juntos cuando se cumplen los requisitos de cada uno.</div></div><div class="faq-item"><button><span>¿Conviene declarar el mínimo como voluntario?</span><b>+</b></button><div class="answer">Baja el aporte actual, pero también puede reducir el promedio utilizado para calcular la pensión futura.</div></div><div class="faq-item"><button><span>¿Dónde reviso mis aportaciones reales?</span><b>+</b></button><div class="answer">En la Historia Laboral del portal del IESS. Ese registro oficial prevalece sobre cualquier estimación.</div></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-iess-aportes-jubilacion-ecuador')?document.currentScript.previousElementSibling:document.querySelector('.mockup-iess-aportes-jubilacion-ecuador');

const $=s=>root.querySelector(s),usd=n=>"$"+new Intl.NumberFormat("es-EC",{minimumFractionDigits:2,maximumFractionDigits:2}).format(n||0),num=v=>Number(String(v).replace(/\./g,"").replace(",","."))||0;let mode="dependencia";const SBU=482,personal=.0945,patronal=.1115,voluntary=.176;
function coef(y){return y>=40?1:y>=35?.9:y>=30?.8:y>=25?.7:y>=20?.6:y>=15?.5:y>=10?.435:0}function rows(a){return a.map(x=>`<div class="row"><span>${x[0]}</span><strong class="${x[2]||""}">${x[1]}</strong></div>`).join("")}
function show(name,on){root.querySelectorAll("."+name).forEach(x=>x.classList.toggle("hidden",!on))}
function fields(){const pension=mode==="jubilacion",pat=mode==="patronal",mon=mode==="montepio",benefit=pension||pat||mon;show("income",!benefit);show("mora",mode==="dependencia"||mode==="hogar");show("years",pension||pat||mode==="hogar");show("age",pension);show("average",benefit);show("coefficient",pat);show("children",mon);$("#formTitle").textContent=benefit?"Datos para proyectar el beneficio":"Datos de tu aporte";$("#formIntro").textContent=benefit?"La pensión oficial depende de tu historia laboral real.":"Todo en dólares. Usá la materia gravada del mes.";calculate()}
function calculate(){const income=num($("#income").value),years=Math.max(0,+$("#years").value||0),age=Math.max(0,+$("#age").value||0),avg=num($("#average").value),children=Math.max(0,+$("#children").value||0),co=Math.max(1,+$("#coefficient").value||100),mora=Math.max(0,+$("#mora").value||0);
if(mode==="dependencia"){const mine=income*personal,company=income*patronal,total=mine+company,interest=total*Math.max(1,mora)*(.1126/12)*mora;$("#resultTitle").textContent="Tu aporte personal";$("#resultCaption").textContent="Descuento mensual en relación de dependencia.";$("#status").textContent="APORTE";$("#mainLabel").textContent="SALE DE TU SUELDO";$("#mainValue").textContent=usd(mine);$("#mainSub").textContent=`Sobre ${usd(income)} de materia gravada, el IESS recibe ${usd(total)}.`;progress("Cómo se completa el aporte","20,60%",46,"Vos aportás 9,45% y la empresa completa 11,15%.");$("#rows").innerHTML=rows([["Aporte personal · 9,45%",usd(mine),""],["Aporte patronal · 11,15%",usd(company),"good"],["Total mensual al IESS",usd(total),""],["Interés estimado por mora",usd(interest),mora?"warn":""]]);$("#notice").innerHTML=mora?`<b>Mora patronal:</b> cargaste ${mora} meses de atraso. También puede existir responsabilidad patronal.`:"<b>Al día:</b> la planilla vence el día 15 del mes siguiente.";return}
if(mode==="voluntario"){const base=Math.max(SBU,income),payment=base*voluntary;$("#resultTitle").textContent="Tu aporte voluntario";$("#resultCaption").textContent="Pagás la parte completa, sin empleador.";$("#status").textContent="VOLUNTARIO";$("#mainLabel").textContent="APORTE MENSUAL";$("#mainValue").textContent=usd(payment);$("#mainSub").textContent=`17,60% sobre una base de ${usd(base)}.`;progress("Ingreso que queda disponible",(82.4).toFixed(1).replace(".",",")+"%",82.4,"El aporte sostiene salud, pensiones y riesgos.");$("#rows").innerHTML=rows([["Ingreso declarado",usd(income),""],["Base aplicada",usd(base),income<SBU?"warn":""],["Aporte anual",usd(payment*12),""],["Ingreso luego del aporte",usd(base-payment),"good"]]);$("#notice").innerHTML=income<SBU?"<b>Base mínima:</b> se aplicó un SBU porque declaraste menos de $482.":"<b>Decisión de largo plazo:</b> una base menor reduce el aporte y puede reducir la pensión.";return}
if(mode==="hogar"){const salary=Math.max(SBU,income),mine=salary*personal,company=salary*patronal,d13=salary/12,d14=SBU/12,reserve=years>=1?salary*.0833:0,cost=salary+company+d13+d14+reserve;$("#resultTitle").textContent="Costo total del trabajo del hogar";$("#resultCaption").textContent="Sueldo, aporte patronal y beneficios prorrateados.";$("#status").textContent="EMPLEADOR";$("#mainLabel").textContent="COSTO MENSUAL";$("#mainValue").textContent=usd(cost);$("#mainSub").textContent=`La persona recibe ${usd(salary-mine)} después del aporte personal.`;progress("Sueldo dentro del costo",Math.round(salary/cost*100)+"%",salary/cost*100,"La afiliación es obligatoria desde el primer día.");$("#rows").innerHTML=rows([["Sueldo base",usd(salary),""],["Aporte patronal",usd(company),""],["Décimos prorrateados",usd(d13+d14),""],["Fondos de reserva",usd(reserve),reserve?"good":""],["Costo total",usd(cost),""]]);$("#notice").innerHTML=income<SBU?"<b>Ajuste:</b> se aplicó el SBU como remuneración mínima de jornada completa.":"<b>Incluido:</b> fondos de reserva desde el mes 13 con el mismo empleador.";return}
if(mode==="jubilacion"){const c=coef(years),floor=years>=40?SBU:years>=30?SBU*.75:SBU*.5,pension=years>=10?Math.max(avg*c,floor):0,req=years>=30?60:years>=15?65:70,ready=years>=10&&age>=req,missingYears=Math.max(0,10-years),missingAge=Math.max(0,req-age);$("#resultTitle").textContent=ready?"Ya cumplís los requisitos":"Todavía te falta para jubilarte";$("#resultCaption").textContent=years<10?"No alcanzás las 120 aportaciones mínimas.":`Con ${years} años aportados, la edad requerida es ${req}.`;$("#status").textContent=ready?"CUMPLE":"EN PROGRESO";$("#mainLabel").textContent="PENSIÓN MENSUAL ESTIMADA";$("#mainValue").textContent=usd(pension);$("#mainSub").textContent=years>=10?`${(c*100).toFixed(1).replace(".",",")}% sobre un promedio de ${usd(avg)}, con piso referencial.`:"Con menos de 10 años corresponde revisar la devolución de aportes.";progress("Años mínimos cumplidos",Math.min(100,years/30*100).toFixed(0)+"%",Math.min(100,years/30*100),ready?"Edad y aportes cumplidos.":missingYears?`Te faltan ${missingYears} años de aportación mínima.`:`Te faltan ${missingAge} años de edad.`);$("#rows").innerHTML=rows([["Años aportados",years+" años",years>=10?"good":"warn"],["Edad requerida",req+" años",""],["Edad actual",age+" años",ready?"good":""],["Coeficiente referencial",(c*100).toFixed(1).replace(".",",")+"%",""],["Diferencia vs. promedio",usd(Math.max(0,avg-pension)),""]]);$("#notice").innerHTML="<b>Importante:</b> el cálculo vinculante lo hace el IESS con tu historia laboral completa.";return}
if(mode==="patronal"){const fund=avg*12*.05*years,pension=fund/co,ready=years>=25;$("#resultTitle").textContent=ready?"Tenés derecho a jubilación patronal":"Todavía no llegás a la jubilación plena";$("#resultCaption").textContent="Beneficio adicional e independiente de la pensión IESS.";$("#status").textContent=ready?"CONSOLIDADO":"EN PROGRESO";$("#mainLabel").textContent="PENSIÓN PATRONAL ESTIMADA";$("#mainValue").textContent=usd(pension);$("#mainSub").textContent=`Fondo global de ${usd(fund)} dividido por coeficiente ${co}.`;progress("Permanencia requerida",Math.min(100,years/25*100).toFixed(0)+"%",Math.min(100,years/25*100),ready?"Cumpliste 25 años con el mismo empleador.":`Te faltan ${25-years} años con la misma empresa.`);$("#rows").innerHTML=rows([["Años con el empleador",years+" años",ready?"good":"warn"],["Promedio mensual",usd(avg),""],["Fondo global",usd(fund),""],["Coeficiente MDT",co.toFixed(0),""],["Pensión estimada",usd(pension),""]]);$("#notice").innerHTML=years>=20&&years<25?"<b>Entre 20 y 25 años:</b> puede corresponder parte proporcional si el empleador termina la relación.":"<b>Art. 216:</b> verificá el coeficiente oficial del Ministerio del Trabajo.";return}
const causant=avg*.5,rawWidow=causant*.6,rawChild=causant*.2,raw=rawWidow+rawChild*children,factor=raw>causant?causant/raw:1,widow=rawWidow*factor,child=rawChild*factor,total=widow+child*children;$("#resultTitle").textContent="Pensión para el grupo familiar";$("#resultCaption").textContent=raw>causant?"La suma fue reducida al tope del 100%.":"Viudez y orfandad sobre la pensión del causante.";$("#status").textContent="MONTEPÍO";$("#mainLabel").textContent="TOTAL DEL GRUPO";$("#mainValue").textContent=usd(total);$("#mainSub").textContent=`Sobre una pensión estimada del causante de ${usd(causant)}.`;progress("Porción del grupo",Math.min(100,total/causant*100).toFixed(0)+"%",Math.min(100,total/causant*100),raw>causant?"Se aplicó reducción proporcional por el tope.":"La suma no supera la pensión del causante.");$("#rows").innerHTML=rows([["Pensión de viudez",usd(widow),""],["Por cada hijo",usd(child),""],["Hijos con derecho",children.toFixed(0),""],["Total orfandad",usd(child*children),""],["Total familiar",usd(total),"good"]]);$("#notice").innerHTML="<b>Verificación:</b> el IESS controla parentesco, convivencia y derecho de cada beneficiario."}
function progress(label,value,width,text){$("#progressLabel").textContent=label;$("#progressValue").textContent=value;$("#progressBar").style.width=Math.max(0,Math.min(100,width))+"%";$("#progressText").textContent=text}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(x=>x.classList.remove("active"));b.classList.add("active");mode=b.dataset.case;fields()}));$("#calculate").addEventListener("click",calculate);["income","years","age","average","coefficient","children","mora"].forEach(id=>$("#"+id).addEventListener("change",calculate));root.querySelectorAll(".faq-item button").forEach(b=>b.addEventListener("click",()=>b.parentElement.classList.toggle("open")));fields();

})();
</script>
<style is:global>

