---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-humedad-casa" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Hogar / Humedad en casa</div><div class="eyebrow">Diagnóstico por evidencias</div><h1>La mancha no dice sola de dónde viene el agua.</h1><p class="lead">Elegí dónde aparece, cuándo empeora y cuánto marca el higrómetro. El mockup distingue condensación, filtración, capilaridad y pérdidas.</p></div><div class="wall"><i class="stain a"></i><i class="stain b"></i><div class="window"></div></div></div></section>
<section class="diagnosis"><div class="diagnosis-grid"><aside class="evidence"><h2>¿Qué observás?</h2><p>Elegí la evidencia que más se parece. No hace falta conocer términos técnicos.</p><div class="evidence-list"><button class="evidence-btn active" data-type="condensation"><b>Esquinas, vidrios o muebles</b><small>Empeora con frío, ducha o cocina.</small></button><button class="evidence-btn" data-type="leak"><b>Techo o pared después de lluvia</b><small>La mancha crece con tormentas.</small></button><button class="evidence-btn" data-type="rising"><b>Sube desde el piso</b><small>Revoque flojo y sales blancas.</small></button><button class="evidence-btn" data-type="pipe"><b>Cerca de baño o cañería</b><small>Aparece aunque no llueva.</small></button></div><div class="room-data"><label for="humidity"><span>HUMEDAD AMBIENTE</span><output id="humidityOut">72%</output></label><input id="humidity" type="range" min="25" max="100" value="72"></div></aside><section class="case" aria-live="polite"><div class="case-head"><div><small>ORIGEN MÁS PROBABLE</small><h2 id="caseTitle">Condensación superficial</h2><p id="caseText" style="margin:0;color:#dceaf0;font-size:13px">El vapor interior se enfría sobre superficies frías. No implica necesariamente que entre agua desde afuera.</p></div><div class="confidence" id="confidence">82%</div></div><div class="clues"><div class="clue"><small>SEÑAL QUE COINCIDE</small><b id="clue1">Vidrios mojados</b></div><div class="clue"><small>MEDICIÓN ÚTIL</small><b id="clue2">Higrómetro 7 días</b></div><div class="clue"><small>PRIMER OBJETIVO</small><b id="clue3">Bajar a 40–60%</b></div></div><div class="action-plan"><h3>Qué hacer en orden</h3><div class="actions" id="actions"></div><div class="avoid" id="avoid">No pintes encima antes de controlar el vapor: la mancha probablemente vuelva.</div></div></section></div></section>
<section class="monitor"><div class="wrap monitor-grid"><div><div class="kicker">Confirmá con una semana de datos</div><h2>Medir evita arreglos equivocados</h2><p>Registrá humedad al levantarte y después de ventilar. La tendencia ayuda a confirmar condensación.</p></div><div class="week" id="week"></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-humedad-casa')?document.currentScript.previousElementSibling:document.querySelector('.mockup-humedad-casa');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let type="condensation";const cases={condensation:{title:"Condensación superficial",text:"El vapor interior se enfría sobre superficies frías. No implica necesariamente que entre agua desde afuera.",clues:["Vidrios mojados","Higrómetro 7 días","Bajar a 40–60%"],actions:[["Ventilar en forma cruzada","10–15 minutos, especialmente después de cocinar o bañarse."],["Separar muebles del muro","Dejá circular aire en esquinas y paredes exteriores."],["Revisar puente térmico","Si persiste con humedad normal, evaluar aislación."]],avoid:"No pintes encima antes de controlar el vapor: la mancha probablemente vuelva."},leak:{title:"Filtración desde el exterior",text:"La relación con la lluvia indica un ingreso puntual por cubierta, sellado o fachada.",clues:["Crece con tormentas","Inspección bajo lluvia","Detener ingreso"],actions:[["Documentar el recorrido","Fotos antes, durante y después de llover."],["Revisar desde arriba","Canaletas, babetas, membrana y encuentros."],["Secar recién después","Repará terminaciones cuando el soporte esté seco."]],avoid:"No impermeabilices sólo la cara interior: podés encerrar el agua dentro del muro."},rising:{title:"Humedad ascendente",text:"El agua del suelo sube por materiales porosos cuando falla o no existe una barrera hidrófuga.",clues:["Sales y revoque flojo","Altura de la mancha","Cortar ascenso"],actions:[["Medir altura y perímetro","Marcá hasta dónde llega en distintos ambientes."],["Descartar pérdidas","Revisá instalaciones cercanas antes de intervenir."],["Evaluar barrera y revoque","La solución suele requerir obra específica."]],avoid:"No uses placas para taparla sin cortar el ascenso: sólo ocultás el deterioro."},pipe:{title:"Pérdida de instalación",text:"Una mancha persistente junto a cañerías o zonas húmedas puede venir de una unión o desagüe.",clues:["No depende del clima","Prueba de presión","Localizar pérdida"],actions:[["Cerrar consumos y observar","Mirá si el medidor sigue avanzando."],["Probar por sectores","Aislá agua fría, caliente y desagües."],["Abrir sólo donde corresponde","Usá detección antes de romper revestimientos."]],avoid:"No esperes a que se seque sola si el medidor o la mancha siguen avanzando."}};function render(){const c=cases[type],h=+$("#humidity").value;$("#humidityOut").textContent=h+"%";$("#caseTitle").textContent=c.title;$("#caseText").textContent=c.text;$("#clue1").textContent=c.clues[0];$("#clue2").textContent=c.clues[1];$("#clue3").textContent=c.clues[2];const conf=Math.min(95,(type==="condensation"?55+(h-50)*1.2:78));$("#confidence").textContent=Math.round(conf)+"%";$("#actions").innerHTML=c.actions.map((a,i)=>`<div class="action"><span class="num">${i+1}</span><div><b>${a[0]}</b><small>${a[1]}</small></div><span>${i===0?"HOY":i===1?"DESPUÉS":"SI PERSISTE"}</span></div>`).join("");$("#avoid").textContent=c.avoid;const vals=[h,h-4,h-7,h-5,h-9,h-11,h-8];$("#week").innerHTML=vals.map((v,i)=>`<div class="day"><b>${v}%</b><i style="--h:${v*1.6}px;--c:${v>65?"#d99a35":"#4d9a78"}"></i><small>${["L","M","X","J","V","S","D"][i]}</small></div>`).join("")}$$("[data-type]").forEach(b=>b.addEventListener("click",()=>{type=b.dataset.type;$$("[data-type]").forEach(x=>x.classList.toggle("active",x===b));render()}));$("#humidity").addEventListener("input",render);render()})();
})();
</script>
<style is:global>

.mockup-humedad-casa{--blue:#174b7a;--cyan:#2f8291;--sky:#e9f5f7;--mint:#e2f1e9;--amber:#d99a35;--cream:#fff7e0;--ink:#182332;--muted:#5f6977;--line:#d9e2e4;--red:#ae514a}.mockup-humedad-casa *{box-sizing:border-box}.mockup-humedad-casa{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#f7faf9}.mockup-humedad-casa button,.mockup-humedad-casa input{font:inherit}.mockup-humedad-casa .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-humedad-casa .brand{font-size:19px;font-weight:950}.mockup-humedad-casa .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-humedad-casa .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-humedad-casa .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-humedad-casa .hero{padding:42px 22px 32px;background:linear-gradient(120deg,#fff 0 65%,var(--sky) 65%)}.mockup-humedad-casa .hero-grid,.mockup-humedad-casa .wrap{max-width:1180px;margin:auto}.mockup-humedad-casa .hero-grid{display:grid;grid-template-columns:1fr .8fr;gap:55px;align-items:center}.mockup-humedad-casa .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-humedad-casa .eyebrow{margin-top:25px;color:var(--cyan);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-humedad-casa .hero h1{font-size:clamp(43px,5vw,64px);line-height:.98;letter-spacing:-.05em;margin:9px 0 18px}.mockup-humedad-casa .lead{font-size:19px;color:var(--muted)}.mockup-humedad-casa .wall{height:310px;background:#fff;border:8px solid var(--blue);position:relative;overflow:hidden;box-shadow:0 22px 45px #17374a17}.mockup-humedad-casa .stain{position:absolute;border-radius:50%;background:radial-gradient(circle,#66aab955 0,#66aab922 55%,transparent 70%);filter:blur(3px)}.mockup-humedad-casa .stain.a{width:210px;height:210px;left:-65px;bottom:-60px}.mockup-humedad-casa .stain.b{width:130px;height:130px;right:-25px;top:-30px}.mockup-humedad-casa .window{position:absolute;right:35px;bottom:38px;width:120px;height:145px;border:7px solid var(--blue);background:#dff1f5}.mockup-humedad-casa .window:after,.mockup-humedad-casa .window:before{content:"";position:absolute;background:var(--blue)}.mockup-humedad-casa .window:before{left:50%;top:0;bottom:0;width:5px}.mockup-humedad-casa .window:after{left:0;right:0;top:50%;height:5px}.mockup-humedad-casa .diagnosis{padding:52px 22px 68px}.mockup-humedad-casa .diagnosis-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:280px 1fr;gap:22px;align-items:start}.mockup-humedad-casa .evidence{background:#fff;border:1px solid var(--line);border-radius:20px;padding:20px;position:sticky;top:16px}.mockup-humedad-casa .evidence h2{font-size:20px;margin:0 0 5px}.mockup-humedad-casa .evidence>p{font-size:12px;color:var(--muted);margin:0 0 18px}.mockup-humedad-casa .evidence-list{display:grid;gap:9px}.mockup-humedad-casa .evidence-btn{padding:13px;border:1px solid var(--line);border-radius:12px;background:#fff;text-align:left;color:var(--ink);cursor:pointer}.mockup-humedad-casa .evidence-btn b,.mockup-humedad-casa .evidence-btn small{display:block}.mockup-humedad-casa .evidence-btn b{font-size:13px}.mockup-humedad-casa .evidence-btn small{font-size:10px;color:var(--muted);margin-top:3px}.mockup-humedad-casa .evidence-btn.active{border:2px solid var(--cyan);padding:12px;background:#f3fafb}.mockup-humedad-casa .room-data{margin-top:17px;padding-top:15px;border-top:1px solid var(--line)}.mockup-humedad-casa .room-data label{display:flex;justify-content:space-between;font-size:11px;font-weight:900;margin-bottom:7px}.mockup-humedad-casa .room-data input{width:100%;accent-color:var(--cyan)}.mockup-humedad-casa .case{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden}.mockup-humedad-casa .case-head{padding:23px 25px;background:var(--blue);color:#fff;display:flex;justify-content:space-between;gap:20px;align-items:start}.mockup-humedad-casa .case-head small{display:block;color:#dceaf0;font-size:10px}.mockup-humedad-casa .case-head h2{font-size:27px;margin:5px 0}.mockup-humedad-casa .confidence{display:grid;place-items:center;width:74px;height:74px;border-radius:50%;border:8px solid #ffffff2e;font-size:20px;font-weight:950}.mockup-humedad-casa .clues{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line)}.mockup-humedad-casa .clue{padding:17px;border-right:1px solid var(--line)}.mockup-humedad-casa .clue:last-child{border:0}.mockup-humedad-casa .clue small{display:block;color:var(--muted);font-size:10px}.mockup-humedad-casa .clue b{font-size:14px}.mockup-humedad-casa .action-plan{padding:23px 25px}.mockup-humedad-casa .action-plan h3{font-size:18px;margin:0 0 14px}.mockup-humedad-casa .actions{display:grid;gap:10px}.mockup-humedad-casa .action{display:grid;grid-template-columns:38px 1fr auto;gap:12px;align-items:center;padding:13px;border:1px solid var(--line);border-radius:13px}.mockup-humedad-casa .num{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;background:var(--sky);color:var(--cyan);font-weight:950}.mockup-humedad-casa .action b,.mockup-humedad-casa .action small{display:block}.mockup-humedad-casa .action b{font-size:13px}.mockup-humedad-casa .action small{font-size:10px;color:var(--muted)}.mockup-humedad-casa .action span{font-size:10px;color:var(--muted)}.mockup-humedad-casa .avoid{margin-top:18px;padding:13px 15px;border-left:5px solid var(--red);background:#fff1ef;color:#743d39;font-size:12px}.mockup-humedad-casa .monitor{padding:60px 22px;background:#edf4f3}.mockup-humedad-casa .monitor-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:40px}.mockup-humedad-casa .kicker{color:var(--cyan);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-humedad-casa .monitor h2{font-size:35px;letter-spacing:-.04em;margin:6px 0}.mockup-humedad-casa .monitor p{color:var(--muted)}.mockup-humedad-casa .week{display:grid;grid-template-columns:repeat(7,1fr);gap:7px;align-items:end;height:190px}.mockup-humedad-casa .day{height:100%;display:flex;flex-direction:column;justify-content:end;align-items:center;gap:6px}.mockup-humedad-casa .day i{display:block;width:70%;height:var(--h);background:var(--c);border-radius:7px 7px 0 0}.mockup-humedad-casa .day b{font-size:10px}.mockup-humedad-casa .day small{font-size:9px;color:var(--muted)}.mockup-humedad-casa .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-humedad-casa .nav{display:none}.mockup-humedad-casa .hero-grid,.mockup-humedad-casa .diagnosis-grid,.mockup-humedad-casa .monitor-grid{grid-template-columns:1fr}.mockup-humedad-casa .evidence{position:static}.mockup-humedad-casa .clues{grid-template-columns:1fr}.mockup-humedad-casa .clue{border-right:0;border-bottom:1px solid var(--line)}}@media(max-width:560px){.mockup-humedad-casa .hero h1{font-size:42px}.mockup-humedad-casa .case-head{flex-direction:column}.mockup-humedad-casa .action{grid-template-columns:38px 1fr}.mockup-humedad-casa .action>span{grid-column:2}}

.mockup-humedad-casa { width:100%; overflow:hidden; }
.mockup-humedad-casa .top, .mockup-humedad-casa header.top { display:none !important; }
.mockup-humedad-casa .foot { display:none !important; }
.mockup-humedad-casa .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-humedad-casa .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-humedad-casa .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-humedad-casa .support-real summary { cursor:pointer; font-weight:750; }
.mockup-humedad-casa .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-humedad-casa :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-humedad-casa input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-humedad-casa input[type="number"]::-webkit-inner-spin-button, .mockup-humedad-casa input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-humedad-casa .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-humedad-casa support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
