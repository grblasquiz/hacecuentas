<div class="mockup-conversor-temperatura" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>Conversores</b> / Temperatura</div><div class="hero-grid"><div><span class="eyebrow">Celsius · Fahrenheit · Kelvin · Rankine</span><h1>Una temperatura, en todas las escalas.</h1><p class="lede">Escribí en cualquier campo y los demás se actualizan al instante. Sin elegir origen, destino ni repetir la cuenta.</p><div class="chips"><span class="chip">Conversión bidireccional</span><span class="chip">Acepta negativos</span><span class="chip">Valida el cero absoluto</span><span class="chip">Lectura de clima opcional</span></div></div><aside class="thermo"><div class="t-head"><b>TEMPERATURA ACTUAL</b><span>20 °C</span></div><div class="t-main">68 °F</div><div class="t-sub">293,15 K · ambiente templado</div><div class="t-scale"><i></i></div><div class="ticks"><span>−40°</span><span>0°</span><span>20°</span><span>40°</span><span>60°</span></div></aside></div></div></section>
<section class="convert"><div class="wrap"><div class="head"><div><span class="eyebrow">Conversión instantánea</span><h2>Editá la escala que conocés</h2></div><p>No hay un botón de “intercambiar”: cualquiera de los cuatro campos puede ser el punto de partida.</p></div><div class="converter"><article class="panel"><div class="scale-fields"><div class="temp-field"><label for="c">Celsius <span>°C</span></label><input id="c" data-scale="c" inputmode="decimal" value="20"><div class="helper">Agua congela a 0 °C</div></div><div class="temp-field"><label for="f">Fahrenheit <span>°F</span></label><input id="f" data-scale="f" inputmode="decimal" value="68"><div class="helper">Agua congela a 32 °F</div></div><div class="temp-field"><label for="k">Kelvin <span>K</span></label><input id="k" data-scale="k" inputmode="decimal" value="293,15"><div class="helper">Empieza en el cero absoluto</div></div><div class="temp-field"><label for="r">Rankine <span>°R</span></label><input id="r" data-scale="r" inputmode="decimal" value="527,67"><div class="helper">Escala absoluta en Fahrenheit</div></div></div><div class="error" id="error"></div><div class="actions"><button class="primary" id="copy">Copiar resultados</button><button class="secondary" id="reset">Restablecer</button></div><div class="quick"><div class="quick-title">Valores frecuentes</div><div class="quick-grid"><button data-c="-18"><b>Freezer</b><span>−18 °C</span></button><button data-c="0"><b>Congelación</b><span>0 °C</span></button><button data-c="37"><b>Cuerpo</b><span>37 °C</span></button><button data-c="100"><b>Ebullición</b><span>100 °C</span></button></div></div></article>
<article class="panel reading"><div class="reading-top"><small>LECTURA RÁPIDA</small><span class="pill" id="pill">TEMPLADO</span></div><div class="reading-main" id="mainReading">20 °C = 68 °F</div><div class="reading-sub" id="readingSub">Una temperatura ambiente confortable.</div><div class="range"><i id="marker"></i></div><div class="range-label" id="rangeLabel">20 °C dentro de la escala climática</div><div class="rows"><div class="row"><span>Celsius</span><strong id="rowC">20 °C</strong></div><div class="row"><span>Fahrenheit</span><strong id="rowF">68 °F</strong></div><div class="row"><span>Kelvin</span><strong id="rowK">293,15 K</strong></div><div class="row"><span>Rankine</span><strong id="rowR">527,67 °R</strong></div></div><div class="insight" id="insight"><strong>Referencia cercana: ambiente interior.</strong>La percepción real también depende de viento, humedad, sol y actividad.</div></article></div></div></section>
<section class="climate"><div class="wrap"><div class="climate-card"><div><span class="eyebrow">Opcional · lectura meteorológica</span><h3>¿Cuánto se siente?</h3><p>Agregá viento cuando hace frío o humedad cuando hace calor. Solo aplicamos las fórmulas dentro de su rango válido.</p></div><div class="weather-fields"><div class="weather-field"><label for="wind">Viento</label><div class="control"><input id="wind" type="number" min="0" max="250" value="15"><span>km/h</span></div></div><div class="weather-field"><label for="humidity">Humedad</label><div class="control"><input id="humidity" type="number" min="0" max="100" value="60"><span>%</span></div></div></div><div class="weather-result" id="weatherResult">A 20 °C no corresponde aplicar sensación por viento ni índice de calor.</div></div></div></section>
<section class="refs"><div class="wrap"><div class="head"><div><span class="eyebrow">Para ubicarte rápido</span><h2>Cinco temperaturas reconocibles</h2></div><p>Las referencias ayudan a detectar un error de escala antes de cocinar, viajar o interpretar un pronóstico.</p></div><div class="ref-grid"><article class="ref"><small>FREEZER</small><strong>−18 °C</strong><span>−0,4 °F · 255,15 K</span></article><article class="ref"><small>AGUA CONGELA</small><strong>0 °C</strong><span>32 °F · 273,15 K</span></article><article class="ref"><small>AMBIENTE</small><strong>20 °C</strong><span>68 °F · 293,15 K</span></article><article class="ref"><small>CUERPO</small><strong>37 °C</strong><span>98,6 °F · 310,15 K</span></article><article class="ref"><small>AGUA HIERVE</small><strong>100 °C</strong><span>212 °F · 373,15 K</span></article></div></div></section>
<section class="faq"><div class="wrap faq-wrap"><span class="eyebrow">Preguntas frecuentes</span><h2>Las conversiones que conviene recordar</h2><div class="faq-item open"><button class="faq-q">¿Cuándo Celsius y Fahrenheit son iguales?<span>−</span></button><div class="faq-a">A −40 grados: −40 °C equivale exactamente a −40 °F.</div></div><div class="faq-item"><button class="faq-q">¿Kelvin lleva el símbolo de grado?<span>+</span></button><div class="faq-a">No. Se escribe 293,15 K, sin el símbolo °. Kelvin es una escala absoluta.</div></div><div class="faq-item"><button class="faq-q">¿Puede existir una temperatura Kelvin negativa?<span>+</span></button><div class="faq-a">No en la escala termodinámica convencional. 0 K equivale al cero absoluto: −273,15 °C.</div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-conversor-temperatura')?document.currentScript.previousElementSibling:document.querySelector('.mockup-conversor-temperatura');if(!root)return;

const $=id=>root.querySelector("#"+id),inputs=[...root.querySelectorAll("[data-scale]")];let lastC=20,updating=false;function parse(v){let s=String(v).trim().replace(/\s/g,"");if(!s)return null;if(s.includes(","))s=s.replace(/\./g,"").replace(",",".");const n=Number(s.replace("−","-"));return Number.isFinite(n)?n:null}function fmt(n,d=2){return new Intl.NumberFormat("es-AR",{maximumFractionDigits:d,minimumFractionDigits:Math.abs(n%1)>1e-9?Math.min(2,d):0}).format(n)}function toC(v,s){return s==="c"?v:s==="f"?(v-32)*5/9:s==="k"?v-273.15:(v-491.67)*5/9}function vals(c){return{c,f:c*9/5+32,k:c+273.15,r:(c+273.15)*9/5}}function label(c){return c<0?["BAJO CERO","Riesgo de hielo o congelación."]:c<15?["FRESCO","Una temperatura fresca; probablemente necesites abrigo."]:c<27?["TEMPLADO","Una temperatura ambiente confortable."]:c<35?["CALUROSO","Hace calor; hidratate y evitá exposición prolongada."]:["CALOR INTENSO","Temperatura elevada: prestá atención al índice de calor."]}function update(source,value){if(updating)return;const v=parse(value);if(v===null){$("error").textContent="Escribí una temperatura válida.";$("error").style.display="block";return}const c=toC(v,source);if(c< -273.15-1e-9){$("error").textContent="Ese valor está por debajo del cero absoluto. El mínimo es −273,15 °C, 0 K o 0 °R.";$("error").style.display="block";return}$("error").style.display="none";lastC=c;const o=vals(c);updating=true;inputs.forEach(i=>{if(i.dataset.scale!==source)i.value=fmt(o[i.dataset.scale],4)});updating=false;render(o)}
function render(o){const l=label(o.c),pos=Math.max(0,Math.min(100,(o.c+40)/100*100));$("pill").textContent=l[0];$("mainReading").textContent=fmt(o.c)+" °C = "+fmt(o.f)+" °F";$("readingSub").textContent=l[1];$("marker").style.left=pos+"%";$("rangeLabel").textContent=fmt(o.c)+" °C "+(o.c< -40||o.c>60?"fuera del rango visual":"dentro de la escala climática");$("rowC").textContent=fmt(o.c,4)+" °C";$("rowF").textContent=fmt(o.f,4)+" °F";$("rowK").textContent=fmt(o.k,4)+" K";$("rowR").textContent=fmt(o.r,4)+" °R";const refs=[[-18,"freezer"],[0,"agua congelada"],[20,"ambiente interior"],[37,"temperatura corporal"],[100,"agua hirviendo"]].sort((a,b)=>Math.abs(a[0]-o.c)-Math.abs(b[0]-o.c))[0];$("insight").innerHTML="<strong>Referencia cercana: "+refs[1]+".</strong>Está a "+fmt(Math.abs(o.c-refs[0]),1)+" °C de ese punto.";weather()}
function weather(){const c=lastC,w=Math.max(0,Number($("wind").value)||0),h=Math.max(0,Math.min(100,Number($("humidity").value)||0));let text;if(c<=10&&w>4.8){const st=13.12+.6215*c-11.37*Math.pow(w,.16)+.3965*c*Math.pow(w,.16);text="Con "+fmt(w,0)+" km/h de viento, la sensación térmica estimada es "+fmt(st,1)+" °C."}else if(c>=27){const f=c*9/5+32,hi=-42.379+2.04901523*f+10.14333127*h-.22475541*f*h-.00683783*f*f-.05481717*h*h+.00122874*f*f*h+.00085282*f*h*h-.00000199*f*f*h*h;text="Con "+fmt(h,0)+"% de humedad, el índice de calor estimado es "+fmt((hi-32)*5/9,1)+" °C."}else text="A "+fmt(c,1)+" °C no corresponde aplicar sensación por viento ni índice de calor.";$("weatherResult").textContent=text}
inputs.forEach(i=>i.addEventListener("input",()=>update(i.dataset.scale,i.value)));root.querySelectorAll("[data-c]").forEach(b=>b.onclick=()=>{$("c").value=b.dataset.c;update("c",b.dataset.c)});$("wind").oninput=weather;$("humidity").oninput=weather;$("reset").onclick=()=>{$("c").value=20;update("c","20");$("wind").value=15;$("humidity").value=60;weather()};$("copy").onclick=async()=>{const text=inputs.map(i=>i.value+" "+({c:"°C",f:"°F",k:"K",r:"°R"}[i.dataset.scale])).join(" · ");try{await navigator.clipboard.writeText(text)}catch(e){}$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1200)};root.querySelectorAll(".faq-q").forEach(q=>q.onclick=()=>{const item=q.parentElement;item.classList.toggle("open");q.lastElementChild.textContent=item.classList.contains("open")?"−":"+"});update("c","20");

})();
</script>
