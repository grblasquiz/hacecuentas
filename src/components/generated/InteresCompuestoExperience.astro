.mockup-interes-compuesto .calc{background:#fff;border:1px solid #dbe4e8;border-radius:21px;padding:27px 29px;box-shadow:0 27px 60px #193a5b18}.mockup-interes-compuesto .calc-head{display:flex;justify-content:space-between}.mockup-interes-compuesto .calc h2{font-size:24px;margin:0 0 5px}.mockup-interes-compuesto .muted{font-size:11px;color:#68798d;margin:0}.mockup-interes-compuesto .tag{background:#e8f6f1;color:#20735f;border-radius:99px;padding:7px 10px;font-size:9px;font-weight:850;height:max-content}.mockup-interes-compuesto .label{font-size:10px;font-weight:900;margin:18px 0 8px}.mockup-interes-compuesto .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.mockup-interes-compuesto .case{border:1px solid #dce5e9;background:#fff;border-radius:11px;padding:10px 4px;color:#54677d;font-size:9px;font-weight:800;cursor:pointer}.mockup-interes-compuesto .case i{display:block;font-style:normal;font-size:18px;margin-bottom:4px}.mockup-interes-compuesto .case.active{border:2px solid #268b78;background:#edf9f5;color:#176e5e;padding:9px 3px}.mockup-interes-compuesto .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-interes-compuesto .field{border:1px solid #dbe4e9;border-radius:11px;padding:10px 12px}.mockup-interes-compuesto .field label{display:block;color:#697b8e;font-size:9px;margin-bottom:5px}.mockup-interes-compuesto .field input,.mockup-interes-compuesto .field select{width:100%;border:0;outline:0;background:transparent;color:#152a43;font-weight:800}.mockup-interes-compuesto .money{display:flex;gap:6px}.mockup-interes-compuesto .money b{font-size:12px}.mockup-interes-compuesto .hidden{display:none}.mockup-interes-compuesto .result{background:#203d5b;color:#fff;border-radius:16px;padding:19px 20px;margin-top:13px}.mockup-interes-compuesto .result-top{display:flex;justify-content:space-between}.mockup-interes-compuesto .result small{color:#bfd0de;font-size:9px}.mockup-interes-compuesto .value{font-size:35px;font-weight:900;letter-spacing:-1.3px;margin-top:4px}.mockup-interes-compuesto .ratio{background:#e8f6ef;color:#176f58;border-radius:9px;padding:8px 10px;text-align:right}.mockup-interes-compuesto .ratio small{color:inherit}.mockup-interes-compuesto .ratio b{display:block;font-size:13px}.mockup-interes-compuesto .stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #3c5874;margin-top:13px;padding-top:12px;gap:8px}.mockup-interes-compuesto .stats span{color:#b9cad8;font-size:8px}.mockup-interes-compuesto .stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.mockup-interes-compuesto .go{width:100%;border:0;border-radius:9px;padding:12px;margin-top:13px;background:linear-gradient(90deg,#268b78,#54a98e);color:#fff;font-weight:850;cursor:pointer}.mockup-interes-compuesto .section{padding:68px 0}.mockup-interes-compuesto .center{text-align:center;max-width:700px;margin:0 auto 35px}.mockup-interes-compuesto .center h2{font-size:36px;letter-spacing:-1.4px;margin:9px}.mockup-interes-compuesto .center p{color:#65768a}.mockup-interes-compuesto .chart{height:340px;border:1px solid #dce5e9;border-radius:18px;padding:28px;box-shadow:0 15px 35px #1738580d;position:relative}.mockup-interes-compuesto .chart svg{width:100%;height:235px;overflow:visible}.mockup-interes-compuesto .gridline{stroke:#e7ecef;stroke-width:1}.mockup-interes-compuesto .area{fill:url(#grad)}.mockup-interes-compuesto .curve{fill:none;stroke:#21806a;stroke-width:4;stroke-linecap:round}.mockup-interes-compuesto .chart-labels{display:flex;justify-content:space-between;color:#758498;font-size:9px}.mockup-interes-compuesto .legend{display:flex;justify-content:center;gap:22px;margin-top:15px;font-size:10px}.mockup-interes-compuesto .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}.mockup-interes-compuesto .break{background:#f4f8fb;padding:64px 0}.mockup-interes-compuesto .breakgrid{display:grid;grid-template-columns:1.05fr .95fr;gap:20px}.mockup-interes-compuesto .card{background:#fff;border:1px solid #dce5e9;border-radius:17px;padding:24px}.mockup-interes-compuesto .card h3{margin:0 0 16px;font-size:19px}.mockup-interes-compuesto .line{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #e6ebee}.mockup-interes-compuesto .line span{color:#65778b;font-size:10px}.mockup-interes-compuesto .line b{font-size:12px}.mockup-interes-compuesto .line.total{background:#eaf7f2;color:#176f59;margin-top:12px;padding:14px;border:0;border-radius:10px}.mockup-interes-compuesto .insight{background:#eef7ff;border-left:4px solid #5e86be;border-radius:10px;padding:14px;color:#3d5878;font-size:11px;line-height:1.6}.mockup-interes-compuesto .compare{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.mockup-interes-compuesto .option{border:1px solid #dde5e8;border-radius:12px;padding:15px;text-align:center}.mockup-interes-compuesto .option small{color:#6e7e91;font-size:8px}.mockup-interes-compuesto .option b{display:block;font-size:17px;margin:7px}.mockup-interes-compuesto .option.winner{border:2px solid #49a185;background:#eef8f4}.mockup-interes-compuesto .darksection{background:#19324d;color:#fff;padding:61px 0}.mockup-interes-compuesto .rules{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-interes-compuesto .rule{border:1px solid #ffffff20;border-radius:15px;padding:18px}.mockup-interes-compuesto .rule i{font-style:normal;font-size:22px}.mockup-interes-compuesto .rule h3{font-size:13px;margin:10px 0 6px}.mockup-interes-compuesto .rule p{font-size:10px;line-height:1.55;color:#c3d0db;margin:0}
@media(max-width:800px){.mockup-interes-compuesto .links{display:none}.mockup-interes-compuesto .tools span:not(.dark){display:none}.mockup-interes-compuesto .grid,.mockup-interes-compuesto .breakgrid{grid-template-columns:1fr}.mockup-interes-compuesto .copy{text-align:center}.mockup-interes-compuesto .copy h1{font-size:40px}.mockup-interes-compuesto .chips{justify-content:center}.mockup-interes-compuesto .art{max-width:460px;margin:auto}.mockup-interes-compuesto .calc{padding:20px 16px}.mockup-interes-compuesto .wrap{padding:0 15px}}@media(max-width:470px){.mockup-interes-compuesto .cases,.mockup-interes-compuesto .fields,.mockup-interes-compuesto .stats,.mockup-interes-compuesto .rules{grid-template-columns:1fr}.mockup-interes-compuesto .art{transform:scale(.8);transform-origin:left top;height:185px}.mockup-interes-compuesto .compare{grid-template-columns:1fr}}

.mockup-interes-compuesto { width:100%; overflow:hidden; }
.mockup-interes-compuesto .top, .mockup-interes-compuesto header.top { display:none !important; }
.mockup-interes-compuesto .foot { display:none !important; }
.mockup-interes-compuesto .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-interes-compuesto .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-interes-compuesto .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-interes-compuesto .support-real summary { cursor:pointer; font-weight:750; }
.mockup-interes-compuesto .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-interes-compuesto :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-interes-compuesto input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-interes-compuesto input[type="number"]::-webkit-inner-spin-button, .mockup-interes-compuesto input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-interes-compuesto .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-interes-compuesto support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
