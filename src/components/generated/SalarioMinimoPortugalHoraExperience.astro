---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-salario-minimo-portugal-hora" set:html={`
<section class="hero"><div class="wrap"><div class="crumb"><b>Portugal</b> / Trabalho / Salário mínimo por hora</div><div class="grid"><div><div class="eyebrow">RMMG · Portugal 2026</div><h1>Quanto vale uma hora do salário mínimo?</h1><p class="lede">Transforme os 920 € mensais num valor por hora e veja quanto corresponde por semana, mês e ano — incluindo os 14 pagamentos.</p><div class="checks"><span class="check">✓ Continente e regiões autónomas</span><span class="check">✓ Horário ajustável</span><span class="check">✓ Subsídios incluídos</span></div><article class="highlight"><div class="highlight-top"><b>Retribuição mínima mensal</b><span class="year">2026</span></div><div class="big" id="hero-month">920,00 €</div><div class="mini"><div><span>POR HORA</span><b id="hero-hour">5,31 €</b></div><div><span>POR SEMANA</span><b id="hero-week">212,31 €</b></div><div><span>POR ANO</span><b id="hero-year">12 880,00 €</b></div></div></article></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calcule o valor por hora</h2><p>Escolha a região e o seu horário semanal.</p></div><span class="tag">Valores oficiais 2026</span></div><div class="label">Onde trabalha?</div><div class="options"><button class="option active" data-region="continente">Continente</button><button class="option" data-region="acores">Açores</button><button class="option" data-region="madeira">Madeira</button></div><div class="label">Dados do contrato</div><div class="fields"><div class="field"><label>Salário mínimo mensal</label><input id="salary" value="920"></div><div class="field"><label>Horas por semana</label><input id="hours" value="40"></div></div><div class="result"><small>VALOR BASE POR HORA</small><div class="value" id="result">5,31 € / hora</div><div class="stats"><div><span>HORAS/MÊS</span><b id="month-hours">173,33 h</b></div><div><span>EQUIVALENTE SEMANAL</span><b id="week">212,31 €</b></div><div><span>TOTAL ANUAL · 14×</span><b id="annual">12 880,00 €</b></div></div></div><button class="go" id="update">Atualizar cálculo</button></form></div></div></section>
<section class="section"><div class="wrap"><header class="center"><span>A conta transparente</span><h2>Do salário mensal ao valor por hora</h2><p>Em Portugal, o salário mínimo é definido por mês. Para comparar horários, convertemos as horas semanais numa média mensal.</p></header><div class="formula"><div><span>HORAS SEMANAIS</span><b id="f-hours">40 h</b></div><i>×</i><div><span>SEMANAS MÉDIAS / MÊS</span><b>52 ÷ 12</b></div><i>=</i><div><span>HORAS MENSAIS</span><b id="f-month-hours">173,33 h</b></div><i>→</i><div><span>SALÁRIO ÷ HORAS</span><b id="f-result">5,31 €</b></div></div></div></section>
<section class="section tint"><div class="wrap"><header class="center"><span>O seu resultado</span><h2>Veja cada período sem misturar as contas</h2></header><div class="breakdown"><article class="card"><h3>Equivalências do salário mínimo</h3><div class="row"><span>Retribuição mensal</span><b id="b-month">920,00 €</b></div><div class="row"><span>Valor semanal médio</span><b id="b-week">212,31 €</b></div><div class="row"><span>Valor diário · 8 horas</span><b id="b-day">42,46 €</b></div><div class="row"><span>Subsídio de férias</span><b id="b-holiday">920,00 €</b></div><div class="row"><span>Subsídio de Natal</span><b id="b-christmas">920,00 €</b></div><div class="row total"><span>Total bruto anual</span><b id="b-year">12 880,00 €</b></div></article><article class="card"><h3>Compare as regiões</h3><div class="compare"><article class="active" data-compare="continente"><small>CONTINENTE</small><strong>920 €</strong><p>Retribuição mínima mensal garantida nacional.</p></article><article data-compare="acores"><small>AÇORES</small><strong id="azores-card">966 €</strong><p>Acréscimo regional sobre o valor nacional.</p></article><article data-compare="madeira"><small>MADEIRA</small><strong id="madeira-card">968 €</strong><p>Valor mínimo regional aplicável na Madeira.</p></article></div><div class="note">ⓘ Os subsídios de férias e de Natal correspondem, em regra, a mais duas remunerações. O valor por hora mostrado é uma equivalência do salário base mensal, não soma esses subsídios à hora normal.</div></article></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-salario-minimo-portugal-hora')?document.currentScript.previousElementSibling:document.querySelector('.mockup-salario-minimo-portugal-hora');

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],eur=n=>n.toLocaleString("pt-PT",{style:"currency",currency:"EUR"}),n=id=>Math.max(0,Number($(id).value.replace(",","."))||0);
const regions={continente:920,acores:966,madeira:968};let region="continente";
function calc(){const salary=n("#salary"),hours=Math.min(80,Math.max(1,n("#hours"))),monthHours=hours*52/12,hour=salary/monthHours,week=hour*hours,annual=salary*14,day=hour*8;$("#result").textContent=`${eur(hour)} / hora`;$("#month-hours").textContent=monthHours.toLocaleString("pt-PT",{minimumFractionDigits:2,maximumFractionDigits:2})+" h";$("#week").textContent=eur(week);$("#annual").textContent=eur(annual);$("#hero-month").textContent=eur(salary);$("#hero-hour").textContent=eur(hour);$("#hero-week").textContent=eur(week);$("#hero-year").textContent=eur(annual);$("#f-hours").textContent=hours.toLocaleString("pt-PT")+" h";$("#f-month-hours").textContent=monthHours.toLocaleString("pt-PT",{minimumFractionDigits:2,maximumFractionDigits:2})+" h";$("#f-result").textContent=eur(hour);$("#b-month").textContent=eur(salary);$("#b-week").textContent=eur(week);$("#b-day").textContent=eur(day);$("#b-holiday").textContent=eur(salary);$("#b-christmas").textContent=eur(salary);$("#b-year").textContent=eur(annual)}
$$(".option").forEach(b=>b.onclick=()=>{region=b.dataset.region;$$(".option").forEach(x=>x.classList.toggle("active",x===b));$$("[data-compare]").forEach(x=>x.classList.toggle("active",x.dataset.compare===region));$("#salary").value=regions[region];calc()});$$("input").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Cálculo atualizado";setTimeout(()=>e.currentTarget.textContent="Atualizar cálculo",1200)};calc();

})();
</script>
<style is:global>

.mockup-salario-minimo-portugal-hora{--ink:#12233f;--muted:#68788a;--blue:#176e87;--navy:#173b55;--mint:#e9f6f2;--lime:#dff09d;--cream:#fbfaf5;--line:#dce5e6;--gold:#f4c86a;--red:#d56550}.mockup-salario-minimo-portugal-hora *{box-sizing:border-box}.mockup-salario-minimo-portugal-hora{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);background:#fff}.mockup-salario-minimo-portugal-hora .wrap{width:min(1180px,calc(100% - 48px));margin:auto}.mockup-salario-minimo-portugal-hora button,.mockup-salario-minimo-portugal-hora input{font:inherit}.mockup-salario-minimo-portugal-hora .top{height:78px;border-bottom:1px solid #e7ecec;background:#fff}.mockup-salario-minimo-portugal-hora .top .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-salario-minimo-portugal-hora .brand{display:flex;align-items:center;gap:10px;font-weight:900;font-size:18px}.mockup-salario-minimo-portugal-hora .mark{width:34px;height:34px;border-radius:8px;background:var(--navy);color:white;display:grid;place-items:center;font-size:11px}.mockup-salario-minimo-portugal-hora .nav{display:flex;gap:28px;margin:auto;font-size:13px;color:#536274;font-weight:750}.mockup-salario-minimo-portugal-hora .actions{display:flex;gap:9px}.mockup-salario-minimo-portugal-hora .chip{border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 14px;font-weight:800;font-size:12px;color:#4c6070}.mockup-salario-minimo-portugal-hora .chip.primary{background:var(--navy);color:#fff}.mockup-salario-minimo-portugal-hora .hero{background:linear-gradient(120deg,#f3faf7 0%,#f8fbfb 52%,#edf7fb 100%);padding:34px 0 66px}.mockup-salario-minimo-portugal-hora .crumb{font-size:12px;color:#778899;margin-bottom:35px}.mockup-salario-minimo-portugal-hora .crumb b{color:var(--blue)}.mockup-salario-minimo-portugal-hora .grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:62px;align-items:start}.mockup-salario-minimo-portugal-hora .eyebrow{color:var(--blue);font-size:11px;letter-spacing:.16em;font-weight:900;text-transform:uppercase;display:flex;gap:10px;align-items:center}.mockup-salario-minimo-portugal-hora .eyebrow:before{content:"";width:28px;height:2px;background:var(--blue)}.mockup-salario-minimo-portugal-hora h1{font-size:55px;line-height:.98;letter-spacing:-.055em;margin:20px 0 22px;max-width:520px}.mockup-salario-minimo-portugal-hora .lede{font-size:18px;line-height:1.55;color:var(--muted);max-width:500px}.mockup-salario-minimo-portugal-hora .checks{display:flex;flex-wrap:wrap;gap:8px;margin:27px 0}.mockup-salario-minimo-portugal-hora .check{background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 11px;font-size:10px;color:#657584}.mockup-salario-minimo-portugal-hora .highlight{margin-top:32px;border:1px solid #d8e4e3;border-radius:20px;background:#ffffffd9;padding:20px;box-shadow:0 18px 45px #193d3010}.mockup-salario-minimo-portugal-hora .highlight-top{display:flex;align-items:center;justify-content:space-between}.mockup-salario-minimo-portugal-hora .highlight small{color:#68798a}.mockup-salario-minimo-portugal-hora .year{background:#eaf6ef;color:#33745e;border-radius:99px;padding:6px 9px;font-weight:900;font-size:10px}.mockup-salario-minimo-portugal-hora .big{font-size:38px;font-weight:950;letter-spacing:-.04em;margin:12px 0 15px}.mockup-salario-minimo-portugal-hora .mini{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mockup-salario-minimo-portugal-hora .mini div{background:#f3f7f7;border-radius:10px;padding:10px}.mockup-salario-minimo-portugal-hora .mini span{display:block;color:#7b8997;font-size:8px}.mockup-salario-minimo-portugal-hora .mini b{display:block;margin-top:4px;font-size:12px}.mockup-salario-minimo-portugal-hora .calc{background:#fff;border:1px solid #d9e4e2;border-radius:23px;padding:27px;box-shadow:0 24px 60px #193d3016}.mockup-salario-minimo-portugal-hora .calc-head{display:flex;justify-content:space-between}.mockup-salario-minimo-portugal-hora .calc h2{font-size:25px;letter-spacing:-.04em;margin:0}.mockup-salario-minimo-portugal-hora .calc-head p{font-size:12px;color:var(--muted);margin:5px 0}.mockup-salario-minimo-portugal-hora .tag{background:#edf7fb;color:var(--blue);border-radius:99px;padding:7px 10px;height:max-content;font-size:10px;font-weight:850}.mockup-salario-minimo-portugal-hora .label{font-size:10px;font-weight:900;margin:19px 0 8px}.mockup-salario-minimo-portugal-hora .options{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.mockup-salario-minimo-portugal-hora .option{border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 5px;color:#617180;font-size:9px;font-weight:850;cursor:pointer}.mockup-salario-minimo-portugal-hora .option.active{border:2px solid var(--blue);background:#eff8fb;color:#1f6d8c;padding:9px 4px}.mockup-salario-minimo-portugal-hora .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-salario-minimo-portugal-hora .field{border:1px solid var(--line);border-radius:11px;padding:10px 11px}.mockup-salario-minimo-portugal-hora .field label{display:block;font-size:8px;color:#6e7e8e;margin-bottom:5px}.mockup-salario-minimo-portugal-hora .field input{width:100%;border:0;outline:0;background:transparent;color:var(--ink);font-weight:850}.mockup-salario-minimo-portugal-hora .result{background:var(--navy);color:#fff;border-radius:16px;padding:20px;margin-top:15px}.mockup-salario-minimo-portugal-hora .result small{font-size:9px;color:#bfd0da}.mockup-salario-minimo-portugal-hora .value{font-size:37px;letter-spacing:-.05em;font-weight:950;margin:4px 0 13px}.mockup-salario-minimo-portugal-hora .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #ffffff25;padding-top:13px}.mockup-salario-minimo-portugal-hora .stats span{font-size:8px;color:#bdced8}.mockup-salario-minimo-portugal-hora .stats b{display:block;color:#fff;font-size:11px;margin-top:4px}.mockup-salario-minimo-portugal-hora .go{width:100%;border:0;border-radius:10px;background:var(--lime);color:#234b3e;padding:12px;margin-top:14px;font-weight:900;cursor:pointer}.mockup-salario-minimo-portugal-hora .section{padding:75px 0}.mockup-salario-minimo-portugal-hora .section.tint{background:var(--cream)}.mockup-salario-minimo-portugal-hora .center{text-align:center;max-width:700px;margin:0 auto 38px}.mockup-salario-minimo-portugal-hora .center span{color:var(--blue);font-size:10px;text-transform:uppercase;letter-spacing:.15em;font-weight:900}.mockup-salario-minimo-portugal-hora .center h2{font-size:39px;letter-spacing:-.045em;margin:10px 0}.mockup-salario-minimo-portugal-hora .center p{color:var(--muted);line-height:1.55}.mockup-salario-minimo-portugal-hora .breakdown{display:grid;grid-template-columns:1.05fr .95fr;gap:20px}.mockup-salario-minimo-portugal-hora .card{border:1px solid var(--line);border-radius:18px;background:#fff;padding:24px}.mockup-salario-minimo-portugal-hora .card h3{font-size:19px;margin:0 0 18px}.mockup-salario-minimo-portugal-hora .row{display:flex;justify-content:space-between;align-items:center;padding:13px 0;border-bottom:1px solid #edf1f1}.mockup-salario-minimo-portugal-hora .row:last-child{border:0}.mockup-salario-minimo-portugal-hora .row span{font-size:12px;color:#667687}.mockup-salario-minimo-portugal-hora .row b{font-size:13px}.mockup-salario-minimo-portugal-hora .row.total{background:#eff8f4;margin:10px -10px -10px;padding:15px 10px;border-radius:10px;color:#275d4b}.mockup-salario-minimo-portugal-hora .compare{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.mockup-salario-minimo-portugal-hora .compare article{border:1px solid var(--line);border-radius:15px;padding:19px;background:#fff}.mockup-salario-minimo-portugal-hora .compare article.active{background:var(--navy);color:#fff;border-color:var(--navy)}.mockup-salario-minimo-portugal-hora .compare small{font-size:9px;color:#718090}.mockup-salario-minimo-portugal-hora .compare .active small{color:#bed0db}.mockup-salario-minimo-portugal-hora .compare strong{display:block;font-size:23px;margin:8px 0}.mockup-salario-minimo-portugal-hora .compare p{font-size:10px;line-height:1.5;color:#718090;margin:0}.mockup-salario-minimo-portugal-hora .compare .active p{color:#d0dde4}.mockup-salario-minimo-portugal-hora .note{margin-top:15px;background:#fff8e8;border:1px solid #efdaa4;border-radius:12px;padding:13px;font-size:10px;color:#7d6735}.mockup-salario-minimo-portugal-hora .formula{display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap}.mockup-salario-minimo-portugal-hora .formula div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:17px;text-align:center;min-width:150px}.mockup-salario-minimo-portugal-hora .formula span{font-size:9px;color:#778899;display:block}.mockup-salario-minimo-portugal-hora .formula b{font-size:20px;display:block;margin-top:6px}.mockup-salario-minimo-portugal-hora .formula i{font-style:normal;color:var(--blue);font-weight:900}.mockup-salario-minimo-portugal-hora .footer{background:#142c42;color:#cbd8df;padding:35px 0;font-size:11px}.mockup-salario-minimo-portugal-hora .footer .wrap{display:flex;justify-content:space-between}
@media(max-width:850px){.mockup-salario-minimo-portugal-hora .nav{display:none}.mockup-salario-minimo-portugal-hora .grid,.mockup-salario-minimo-portugal-hora .breakdown{grid-template-columns:1fr}.mockup-salario-minimo-portugal-hora h1{font-size:44px}.mockup-salario-minimo-portugal-hora .hero{padding-bottom:45px}}@media(max-width:560px){.mockup-salario-minimo-portugal-hora .wrap{width:calc(100% - 24px)}.mockup-salario-minimo-portugal-hora .actions .chip:first-child{display:none}.mockup-salario-minimo-portugal-hora .top .wrap{gap:12px}.mockup-salario-minimo-portugal-hora .grid{gap:30px}.mockup-salario-minimo-portugal-hora h1{font-size:38px}.mockup-salario-minimo-portugal-hora .options,.mockup-salario-minimo-portugal-hora .fields,.mockup-salario-minimo-portugal-hora .stats,.mockup-salario-minimo-portugal-hora .mini,.mockup-salario-minimo-portugal-hora .compare{grid-template-columns:1fr}.mockup-salario-minimo-portugal-hora .section{padding:55px 0}.mockup-salario-minimo-portugal-hora .value{font-size:31px}}

.mockup-salario-minimo-portugal-hora { width:100%; overflow:hidden; }
.mockup-salario-minimo-portugal-hora .top, .mockup-salario-minimo-portugal-hora header.top { display:none !important; }
.mockup-salario-minimo-portugal-hora .foot { display:none !important; }
.mockup-salario-minimo-portugal-hora .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-salario-minimo-portugal-hora .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-salario-minimo-portugal-hora .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-salario-minimo-portugal-hora .support-real summary { cursor:pointer; font-weight:750; }
.mockup-salario-minimo-portugal-hora .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-salario-minimo-portugal-hora :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-salario-minimo-portugal-hora input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-salario-minimo-portugal-hora input[type="number"]::-webkit-inner-spin-button, .mockup-salario-minimo-portugal-hora input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-salario-minimo-portugal-hora .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-salario-minimo-portugal-hora support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
