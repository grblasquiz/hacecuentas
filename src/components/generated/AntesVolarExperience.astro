---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-antes-volar" set:html={`
<section class="top"><div class="crumb">Viajes / Antes de volar</div><h1>Tu vuelo empieza antes de llegar al aeropuerto.</h1><p class="lead">Convertí la hora de despegue en una cuenta regresiva concreta: cuándo salir, qué resolver y qué todavía puede hacerte perder tiempo.</p></section>
<section class="board">
<div class="strip"><div class="flight"><b id="route">Buenos Aires → Río de Janeiro</b><span id="flightText">Vuelo internacional · 15 ago · 18:30</span></div><div class="status" id="status">3 de 5 listos</div></div>
<div class="setup">
<div><label for="departure">Salida del vuelo</label><input id="departure" type="datetime-local" value="2026-08-15T18:30"></div>
<div><label for="kind">Tipo</label><select id="kind"><option value="180">Internacional</option><option value="120">Nacional</option></select></div>
<div><label for="drive">Viaje al aeropuerto</label><input id="drive" type="number" value="55" min="0"></div>
<div><label for="buffer">Margen de tránsito</label><input id="buffer" type="number" value="30" min="0"></div>
<div><label for="bag">Equipaje</label><select id="bag"><option value="20">Valija despachada</option><option value="0">Sólo equipaje de mano</option></select></div>
</div>
<div class="runway">
<div class="runway-head"><div><h2>La pista de salida</h2><span style="color:var(--muted);font-size:12px">Cada punto depende del anterior.</span></div><div class="leave">Salí de casa a las<strong id="leave">14:05</strong></div></div>
<div class="line"></div><div class="stations">
<div class="station done"><div class="dot"></div><b>Documentos</b><small>Vigencia y requisitos</small></div>
<div class="station done"><div class="dot"></div><b>Check-in</b><small>Asiento confirmado</small></div>
<div class="station warn"><div class="dot"></div><b>Equipaje</b><small>Peso y líquidos</small></div>
<div class="station"><div class="dot"></div><b>Salir de casa</b><small id="road">85 min de viaje</small></div>
<div class="station"><div class="dot"></div><b>Despegue</b><small id="takeoff">18:30</small></div>
</div></div>
<div class="taskdeck"><div class="tasks"><h3>Control previo</h3>
<label class="task"><input class="check" type="checkbox" checked><span>Documento y requisitos de ingreso</span><time>48 h antes</time></label>
<label class="task"><input class="check" type="checkbox" checked><span>Check-in y asiento</span><time>24 h antes</time></label>
<label class="task"><input class="check" type="checkbox"><span>Pesar equipaje y separar líquidos</span><time>La noche anterior</time></label>
<label class="task"><input class="check" type="checkbox" checked><span>Confirmar terminal y estado del vuelo</span><time>Antes de salir</time></label>
<label class="task"><input class="check" type="checkbox"><span>Guardar reservas sin conexión</span><time>Antes de salir</time></label>
</div><aside class="side"><h3>Margen total</h3><div class="clock" id="margin">4 h 25</div><p id="explain">Incluye 3 horas de anticipación, 20 minutos por despacho y 85 minutos de traslado.</p><div class="actions"><button class="primary" id="update">Actualizar plan</button><button class="ghost" id="all">Marcar todo</button></div></aside></div>
</section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-antes-volar')?document.currentScript.previousElementSibling:document.querySelector('.mockup-antes-volar');

(()=>{const $=id=>root.querySelector("#"+id),pad=n=>String(n).padStart(2,"0"),fmt=d=>`${pad(d.getHours())}:${pad(d.getMinutes())}`;function run(){const d=new Date($("departure").value);if(isNaN(d)){ $("leave").textContent="Elegí fecha";return}const airport=+$("kind").value,bag=+$("bag").value,road=Math.max(0,+$("drive").value||0)+Math.max(0,+$("buffer").value||0),total=airport+bag+road,leave=new Date(d-total*60000),ready=[...root.querySelectorAll(".check")].filter(x=>x.checked).length;$("leave").textContent=fmt(leave);$("takeoff").textContent=fmt(d);$("road").textContent=`${road} min de viaje`;$("margin").textContent=`${Math.floor(total/60)} h ${total%60}`;$("explain").textContent=`Incluye ${airport/60} horas de anticipación, ${bag} minutos por despacho y ${road} minutos de traslado.`;$("status").textContent=`${ready} de 5 listos`;root.querySelector(".line").style.setProperty("--progress",`${ready/5*100}%`)}root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",run));$("update").onclick=run;$("all").onclick=()=>{root.querySelectorAll(".check").forEach(x=>x.checked=true);run()};run()})();

})();
</script>
<style is:global>

.mockup-antes-volar{--blue:#174b7a;--ink:#172331;--muted:#607080;--line:#d8e2e7;--cloud:#f4f8f8;--mint:#2fa98c;--sand:#fff3d9;--coral:#df735f}.mockup-antes-volar *{box-sizing:border-box}.mockup-antes-volar{margin:0;background:#f8faf8;color:var(--ink);font-family:Inter,system-ui,sans-serif}.mockup-antes-volar button,.mockup-antes-volar input,.mockup-antes-volar select{font:inherit}.mockup-antes-volar .wrap{max-width:1160px;margin:auto;padding:0 24px}.mockup-antes-volar .top{padding:34px 0 22px}.mockup-antes-volar .crumb{font-size:13px;font-weight:800;color:var(--blue)}.mockup-antes-volar h1{font-size:clamp(38px,6vw,72px);line-height:.98;letter-spacing:-.055em;max-width:820px;margin:22px 0 16px}.mockup-antes-volar .lead{font-size:18px;color:var(--muted);max-width:680px;line-height:1.6}.mockup-antes-volar .board{margin:34px 0 64px;background:#fff;border:1px solid var(--line);border-radius:28px;overflow:hidden;box-shadow:0 24px 60px #174b7a12}.mockup-antes-volar .strip{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;padding:22px 26px;background:var(--blue);color:#fff}.mockup-antes-volar .flight{display:flex;gap:26px;align-items:center}.mockup-antes-volar .flight b{font-size:22px}.mockup-antes-volar .flight span{color:#d4eaf4;font-size:12px}.mockup-antes-volar .status{padding:9px 12px;border-radius:99px;background:#dff8ef;color:#136651;font-size:12px;font-weight:900}.mockup-antes-volar .setup{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;padding:20px 24px;border-bottom:1px solid var(--line);background:var(--cloud)}.mockup-antes-volar label{display:block;font-size:11px;font-weight:850;margin-bottom:7px}.mockup-antes-volar input,.mockup-antes-volar select{width:100%;height:44px;border:1px solid #c8d4da;border-radius:10px;background:#fff;padding:0 11px;color:var(--ink)}.mockup-antes-volar .runway{padding:28px 24px 34px}.mockup-antes-volar .runway-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.mockup-antes-volar .runway-head h2{font-size:27px;margin:0}.mockup-antes-volar .leave{font-size:13px;text-align:right;color:var(--muted)}.mockup-antes-volar .leave strong{display:block;font-size:30px;color:var(--blue)}.mockup-antes-volar .line{height:5px;background:#dce6e9;margin:48px 34px 0;position:relative}.mockup-antes-volar .line:before{content:"";position:absolute;left:0;top:0;height:100%;width:var(--progress,70%);background:var(--mint)}.mockup-antes-volar .stations{display:grid;grid-template-columns:repeat(5,1fr);margin-top:-32px}.mockup-antes-volar .station{text-align:center;position:relative;padding:0 8px}.mockup-antes-volar .dot{width:28px;height:28px;border-radius:50%;background:#fff;border:4px solid var(--blue);margin:auto}.mockup-antes-volar .station.done .dot{background:var(--mint);border-color:var(--mint)}.mockup-antes-volar .station.warn .dot{background:var(--sand);border-color:#d99b2b}.mockup-antes-volar .station b{display:block;margin-top:12px;font-size:12px}.mockup-antes-volar .station small{display:block;color:var(--muted);font-size:10px;line-height:1.4;margin-top:5px}.mockup-antes-volar .taskdeck{display:grid;grid-template-columns:1.25fr .75fr;border-top:1px solid var(--line)}.mockup-antes-volar .tasks{padding:24px}.mockup-antes-volar .tasks h3,.mockup-antes-volar .side h3{margin:0 0 15px}.mockup-antes-volar .task{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid #e7edef}.mockup-antes-volar .task input{width:18px;height:18px}.mockup-antes-volar .task span{font-size:13px}.mockup-antes-volar .task time{font-size:11px;color:var(--muted)}.mockup-antes-volar .side{padding:24px;background:#eef6f5}.mockup-antes-volar .clock{font-size:50px;font-weight:950;letter-spacing:-.05em;color:var(--blue)}.mockup-antes-volar .side p{font-size:12px;line-height:1.55;color:var(--muted)}.mockup-antes-volar .actions{display:flex;gap:10px;margin-top:18px}.mockup-antes-volar .actions button{border:0;border-radius:11px;padding:12px 14px;font-weight:850;cursor:pointer}.mockup-antes-volar .primary{background:var(--blue);color:#fff}.mockup-antes-volar .ghost{background:#fff;color:var(--blue);border:1px solid #bcd0da!important}@media(max-width:850px){.mockup-antes-volar .setup{grid-template-columns:1fr 1fr}.mockup-antes-volar .taskdeck{grid-template-columns:1fr}.mockup-antes-volar .stations{overflow:auto}.mockup-antes-volar .station{min-width:120px}.mockup-antes-volar .strip{grid-template-columns:1fr}.mockup-antes-volar .flight{flex-wrap:wrap}}@media(max-width:520px){.mockup-antes-volar .setup{grid-template-columns:1fr}.mockup-antes-volar .runway{overflow:hidden}.mockup-antes-volar .line{width:570px}.mockup-antes-volar .stations{width:650px}.mockup-antes-volar .wrap{padding:0 15px}}

.mockup-antes-volar { width:100%; overflow:hidden; }
.mockup-antes-volar .top, .mockup-antes-volar header.top { display:none !important; }
.mockup-antes-volar .foot { display:none !important; }
.mockup-antes-volar .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-antes-volar .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-antes-volar .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-antes-volar .support-real summary { cursor:pointer; font-weight:750; }
.mockup-antes-volar .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-antes-volar :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-antes-volar input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-antes-volar input[type="number"]::-webkit-inner-spin-button, .mockup-antes-volar input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-antes-volar .support-real-grid{grid-template-columns:1fr}}
.mockup-antes-volar .top{display:block!important}
@media(max-width:520px){.mockup-antes-volar .runway{overflow-x:auto;scrollbar-width:thin}}
</style>
{data && <section class="mockup-antes-volar support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
