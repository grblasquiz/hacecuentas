---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-riego-jardin" set:html={`<section class="hero"><div class="shell hero-grid"><div><div class="crumb">Jardín / Riego</div><div class="eyebrow">Plan de riego semanal</div><h1>Regá lo necesario, sin ahogar las plantas ni desperdiciar agua.</h1><p class="lede">Calculá litros, frecuencia y minutos según el espacio, el clima y cómo drena tu suelo.</p><div class="chips"><span class="chip">Litros por riego</span><span class="chip">Duración estimada</span><span class="chip">Ajuste por clima y suelo</span></div></div><div class="art" aria-hidden="true"><div class="orb"></div><div class="card-art"><div class="art-tag">PRÓXIMO RIEGO</div><div class="art-value" id="heroValue">120 L</div><div class="art-line"></div></div></div></div></section><section class="section"><div class="shell"><div class="head"><div class="eyebrow">¿Qué estás regando?</div><h2>Cada espacio necesita un plan distinto</h2><p>Elegí el caso y después ajustá los valores reales de tu jardín.</p></div><div class="cases"><button class="case active" data-case="0"><b>Césped</b><small>Riego profundo y menos frecuente para favorecer raíces.</small></button><button class="case" data-case="1"><b>Huerta</b><small>Más regularidad durante floración y formación de frutos.</small></button><button class="case" data-case="2"><b>Macetas</b><small>Menos reserva de agua y control más frecuente.</small></button><button class="case" data-case="3"><b>Cantero con goteo</b><small>Entrega lenta, localizada y con menor pérdida.</small></button></div><div class="calc"><div class="panel"><h3>Datos de tu riego</h3><p class="intro" id="caseIntro">Para césped conviene concentrar el agua en pocos riegos profundos.</p><div class="fields"><div class="field"><label for="area">Superficie a regar (m²)</label><input id="area" type="number" min="0.1" step="0.1" value="45"></div><div class="field"><label for="weekly">Necesidad semanal (mm)</label><input id="weekly" type="number" min="1" step="1" value="20"></div><div class="field"><label for="frequency">Riegos por semana</label><input id="frequency" type="number" min="1" max="14" step="1" value="3"></div><div class="field"><label for="flow">Caudal del sistema (L/min)</label><input id="flow" type="number" min="0.1" step="0.1" value="18"></div><div class="field"><label for="climate">Clima de esta semana</label><select id="climate"><option value=".75">Fresco o nublado</option><option value="1" selected>Templado</option><option value="1.3">Caluroso o ventoso</option><option value=".45">Con lluvias</option></select></div><div class="field"><label for="soil">Tipo de suelo o sustrato</label><select id="soil"><option value=".9">Arcilloso, retiene más</option><option value="1" selected>Intermedio</option><option value="1.15">Arenoso, drena rápido</option></select></div></div><div class="buttons"><button class="primary" id="calculate">Actualizar plan</button><button class="secondary" id="reset">Reiniciar</button></div></div><div class="panel result" aria-live="polite"><div class="res-top"><div><div class="label">Agua por cada riego</div><div class="amount" id="amount">—</div></div><span class="pill" id="scenario">Césped</span></div><p class="summary" id="summary"></p><div class="metrics"><div class="metric"><span>Agua por semana</span><strong id="m1">—</strong></div><div class="metric"><span>Duración por riego</span><strong id="m2">—</strong></div><div class="metric"><span>Frecuencia</span><strong id="m3">—</strong></div><div class="metric"><span>Estimación mensual</span><strong id="m4">—</strong></div></div><div class="progress"><i id="bar"></i></div><div class="note" id="note">Regá temprano y comprobá la humedad a 5–8 cm antes de repetir.</div></div></div></div></section><section class="section support"><div class="shell"><div class="head"><div class="eyebrow">Ajustá con observación</div><h2>La planta siempre tiene la última palabra</h2></div><div class="support-grid"><article class="support-card"><span>SUELO</span><h3>Revisá antes de regar</h3><p>Si la tierra sigue húmeda debajo de la superficie, postergá el próximo riego.</p></article><article class="support-card"><span>HORARIO</span><h3>Preferí la mañana</h3><p>Hay menos evaporación y las hojas no quedan mojadas durante toda la noche.</p></article><article class="support-card"><span>LLUVIA</span><h3>Descontá el agua recibida</h3><p>Un milímetro de lluvia equivale aproximadamente a un litro por metro cuadrado.</p></article></div></div></section><section class="section"><div class="shell faq"><div class="head"><div class="eyebrow">Preguntas frecuentes</div><h2>Lo importante, sin vueltas</h2></div><div class="faq-item open"><button class="faq-q">¿Por qué se calcula en milímetros?<span>+</span></button><div class="faq-a">Porque 1 mm aplicado sobre 1 m² equivale a 1 litro de agua. Así se convierte fácilmente a toda la superficie.</div></div><div class="faq-item"><button class="faq-q">¿Más riegos significa más agua?<span>+</span></button><div class="faq-a">No necesariamente. La frecuencia reparte el total semanal en aplicaciones más pequeñas.</div></div><div class="faq-item"><button class="faq-q">¿Cómo sé el caudal de mi sistema?<span>+</span></button><div class="faq-a">Medí durante un minuto cuántos litros entrega en un recipiente o sumá el caudal nominal de los goteros activos.</div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-riego-jardin')?document.currentScript.previousElementSibling:document.querySelector('.mockup-riego-jardin');

(()=>{const $=id=>root.querySelector("#"+id),cases=["Césped","Huerta","Macetas","Cantero con goteo"],presets=[{a:45,w:20,f:3,flow:18,intro:"Para césped conviene concentrar el agua en pocos riegos profundos."},{a:18,w:25,f:4,flow:10,intro:"La huerta agradece humedad pareja, especialmente cuando florece y fructifica."},{a:6,w:28,f:6,flow:5,intro:"Las macetas se secan rápido: revisá el sustrato antes de cada aplicación."},{a:24,w:18,f:3,flow:8,intro:"El goteo aplica agua despacio y cerca de la raíz, con pocas pérdidas."}];let active=0;const n=id=>Math.max(0,Number($(id).value)||0),fmt=v=>Math.round(v).toLocaleString("es-AR");function compute(){const area=Math.max(.1,n("area")),mm=n("weekly"),freq=Math.max(1,Math.round(n("frequency"))),flow=Math.max(.1,n("flow")),climate=n("climate"),soil=n("soil"),weekly=area*mm*climate*soil,per=weekly/freq,minutes=per/flow;$("amount").textContent=fmt(per)+" L";$("heroValue").textContent=fmt(per)+" L";$("scenario").textContent=cases[active];$("summary").textContent=`Repartí ${fmt(weekly)} litros semanales en ${freq} riegos de ${fmt(per)} litros. Con el caudal cargado, cada uno dura cerca de ${Math.ceil(minutes)} minutos.`;$("m1").textContent=fmt(weekly)+" L";$("m2").textContent=Math.ceil(minutes)+" min";$("m3").textContent=freq+" por semana";$("m4").textContent=fmt(weekly*4.33)+" L";$("bar").style.width=Math.max(10,Math.min(96,minutes*4))+"%";$("note").textContent=climate<.6?"Hay lluvia prevista: confirmá la humedad antes de activar el riego.":active===2?"En macetas, frená si el agua escurre enseguida por los orificios.":"Regá temprano y comprobá la humedad a 5–8 cm antes de repetir."}function applyPreset(i){active=i;const p=presets[i];$("area").value=p.a;$("weekly").value=p.w;$("frequency").value=p.f;$("flow").value=p.flow;$("caseIntro").textContent=p.intro;root.querySelectorAll("[data-case]").forEach((b,j)=>b.classList.toggle("active",i===j));compute()}root.querySelectorAll("[data-case]").forEach(b=>b.addEventListener("click",()=>applyPreset(Number(b.dataset.case))));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",compute));$("calculate").addEventListener("click",compute);$("reset").addEventListener("click",()=>{$("climate").value="1";$("soil").value="1";applyPreset(0)});root.querySelectorAll(".faq-q").forEach(q=>q.addEventListener("click",()=>q.parentElement.classList.toggle("open")));compute()})();

})();
</script>
<style is:global>

.mockup-riego-jardin{--ink:#182231;--muted:#657386;--blue:#174b7a;--blue2:#eaf4fb;--mint:#39b799;--mint2:#e7f8f3;--coral:#e77c67;--sun:#f4bd55;--line:#dce4e9;--paper:#fbfcfa;--white:#fff;--shadow:0 18px 48px rgba(23,75,122,.1)}.mockup-riego-jardin *{box-sizing:border-box}.mockup-riego-jardin{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-riego-jardin button,.mockup-riego-jardin input,.mockup-riego-jardin select{font:inherit}.mockup-riego-jardin .shell{max-width:1180px;margin:auto;padding:0 24px}.mockup-riego-jardin .header{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-riego-jardin .nav{display:flex;justify-content:space-between;align-items:center}.mockup-riego-jardin .brand{display:flex;align-items:center;gap:10px;font-weight:900}.mockup-riego-jardin .logo{width:31px;height:35px;border-radius:7px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:12px}.mockup-riego-jardin .links{display:flex;gap:24px;color:#526074;font-size:13px;font-weight:750}.mockup-riego-jardin .navbtn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 12px;color:#46566a}.mockup-riego-jardin .hero{padding:52px 0 47px;background:linear-gradient(135deg,#eef9f6,#fff7e7 58%,#edf6fb)}.mockup-riego-jardin .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:50px;align-items:center}.mockup-riego-jardin .crumb{color:var(--blue);font-size:13px;font-weight:800}.mockup-riego-jardin .eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:900;color:var(--blue);margin-top:18px}.mockup-riego-jardin .hero h1{font-size:52px;line-height:1.03;letter-spacing:-.05em;margin:12px 0 17px}.mockup-riego-jardin .lede{font-size:18px;line-height:1.55;color:#536174}.mockup-riego-jardin .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.mockup-riego-jardin .chip{background:#fff;border:1px solid #d4e2df;border-radius:99px;padding:8px 11px;font-size:11px;color:#46655e;font-weight:800}.mockup-riego-jardin .art{height:310px;position:relative}.mockup-riego-jardin .orb{position:absolute;width:265px;height:265px;border-radius:50%;right:35px;top:18px;background:#dceef2}.mockup-riego-jardin .card-art{position:absolute;left:20px;top:64px;width:250px;height:164px;border-radius:23px;background:#fff;border:3px solid var(--blue);box-shadow:14px 16px 0 rgba(57,183,153,.22);padding:25px}.mockup-riego-jardin .art-tag{font-size:10px;color:var(--blue);font-weight:900;letter-spacing:.08em}.mockup-riego-jardin .art-value{font-size:37px;font-weight:950;color:var(--blue);margin:17px 0}.mockup-riego-jardin .art-line{height:9px;border-radius:9px;background:linear-gradient(90deg,var(--mint) 0 67%,#e5ebee 67%)}.mockup-riego-jardin .section{padding:62px 0}.mockup-riego-jardin .head{text-align:center;max-width:790px;margin:0 auto 29px}.mockup-riego-jardin .head h2{font-size:36px;letter-spacing:-.04em;margin:8px 0}.mockup-riego-jardin .head p{color:var(--muted);line-height:1.6}.mockup-riego-jardin .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:22px}.mockup-riego-jardin .case{border:1px solid var(--line);background:#fff;border-radius:17px;padding:16px;text-align:left;cursor:pointer;color:var(--ink);min-height:108px}.mockup-riego-jardin .case.active{border:2px solid var(--blue);background:var(--blue2)}.mockup-riego-jardin .case b{display:block;font-size:13px;margin-bottom:6px}.mockup-riego-jardin .case small{color:var(--muted);font-size:10px;line-height:1.4}.mockup-riego-jardin .calc{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px;align-items:start}.mockup-riego-jardin .panel{background:#fff;border:1px solid var(--line);border-radius:23px;padding:27px;box-shadow:var(--shadow)}.mockup-riego-jardin .panel h3{font-size:21px;margin:0 0 7px}.mockup-riego-jardin .intro{font-size:13px;color:var(--muted);line-height:1.5;margin:0 0 20px}.mockup-riego-jardin .fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-riego-jardin .field.full{grid-column:1/-1}.mockup-riego-jardin .field label{display:block;font-size:12px;font-weight:850;margin-bottom:7px}.mockup-riego-jardin .field input,.mockup-riego-jardin .field select{width:100%;height:48px;border:1px solid #cbd5df;border-radius:12px;background:#fff;color:var(--ink);padding:0 12px;outline:none}.mockup-riego-jardin .field input:focus,.mockup-riego-jardin .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,75,122,.12)}.mockup-riego-jardin .buttons{display:flex;gap:9px;margin-top:20px}.mockup-riego-jardin .primary,.mockup-riego-jardin .secondary{border-radius:12px;padding:13px 16px;font-weight:900;cursor:pointer}.mockup-riego-jardin .primary{border:1px solid var(--blue);background:var(--blue);color:#fff;flex:1}.mockup-riego-jardin .secondary{border:1px solid #ccd6df;background:#fff;color:#47576b}.mockup-riego-jardin .result{background:linear-gradient(145deg,#174b7a,#287b9b);color:#fff}.mockup-riego-jardin .result .intro{color:#d8eaf2}.mockup-riego-jardin .res-top{display:flex;justify-content:space-between;gap:12px}.mockup-riego-jardin .label{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#c6e3ed;font-weight:900}.mockup-riego-jardin .amount{font-size:42px;font-weight:950;letter-spacing:-.05em;margin:9px 0}.mockup-riego-jardin .pill{height:max-content;background:#e5faf3;color:#155e4e;border-radius:99px;padding:8px 10px;font-size:10px;font-weight:900}.mockup-riego-jardin .summary{font-size:13px;line-height:1.55;color:#eff7f9}.mockup-riego-jardin .metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:17px}.mockup-riego-jardin .metric{border:1px solid rgba(255,255,255,.23);background:rgba(255,255,255,.1);border-radius:14px;padding:14px}.mockup-riego-jardin .metric span{display:block;color:#d3e7ee;font-size:10px}.mockup-riego-jardin .metric strong{display:block;color:#fff;font-size:18px;margin-top:4px}.mockup-riego-jardin .progress{height:12px;background:rgba(255,255,255,.18);border-radius:99px;overflow:hidden;margin-top:18px}.mockup-riego-jardin .progress i{display:block;height:100%;width:68%;background:var(--sun);border-radius:99px;transition:.25s}.mockup-riego-jardin .note{margin-top:14px;background:#fff2d7;color:#684817;border-radius:12px;padding:11px 13px;font-size:11px;font-weight:750}.mockup-riego-jardin .support{background:#f1f7f5}.mockup-riego-jardin .support-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-riego-jardin .support-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.mockup-riego-jardin .support-card span{display:inline-block;background:var(--mint2);color:#176d5b;border-radius:8px;padding:5px 7px;font-size:9px;font-weight:900}.mockup-riego-jardin .support-card h3{font-size:15px;margin:11px 0 6px}.mockup-riego-jardin .support-card p{font-size:11px;line-height:1.5;color:var(--muted);margin:0}.mockup-riego-jardin .faq{max-width:850px;margin:auto}.mockup-riego-jardin .faq-item{border-bottom:1px solid var(--line)}.mockup-riego-jardin .faq-q{width:100%;border:0;background:transparent;color:var(--ink);display:flex;justify-content:space-between;text-align:left;padding:19px 3px;font-weight:850;cursor:pointer}.mockup-riego-jardin .faq-a{display:none;color:var(--muted);line-height:1.6;padding:0 35px 18px 3px}.mockup-riego-jardin .faq-item.open .faq-a{display:block}.mockup-riego-jardin .footer{height:100px;background:#fff;border-top:1px solid var(--line);display:grid;place-items:center;color:var(--muted);font-size:12px}@media(max-width:900px){.mockup-riego-jardin .links{display:none}.mockup-riego-jardin .hero-grid,.mockup-riego-jardin .calc{grid-template-columns:1fr}.mockup-riego-jardin .cases{grid-template-columns:1fr 1fr}.mockup-riego-jardin .support-grid{grid-template-columns:1fr}.mockup-riego-jardin .hero h1{font-size:43px}}@media(max-width:560px){.mockup-riego-jardin .shell{padding:0 16px}.mockup-riego-jardin .hero h1{font-size:35px}.mockup-riego-jardin .art{display:none}.mockup-riego-jardin .cases,.mockup-riego-jardin .fields,.mockup-riego-jardin .metrics{grid-template-columns:1fr}.mockup-riego-jardin .panel{padding:21px}.mockup-riego-jardin .res-top{display:block}.mockup-riego-jardin .pill{display:inline-block;margin-top:8px}}

.mockup-riego-jardin { width:100%; overflow:hidden; }
.mockup-riego-jardin .top, .mockup-riego-jardin header.top { display:none !important; }
.mockup-riego-jardin .foot { display:none !important; }
.mockup-riego-jardin .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-riego-jardin .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-riego-jardin .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-riego-jardin .support-real summary { cursor:pointer; font-weight:750; }
.mockup-riego-jardin .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-riego-jardin :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-riego-jardin input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-riego-jardin input[type="number"]::-webkit-inner-spin-button, .mockup-riego-jardin input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-riego-jardin .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-riego-jardin support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
