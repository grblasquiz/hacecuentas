---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-examenes-idioma" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Estudio / Exámenes de idioma</div><div class="eyebrow">Preparación con objetivo</div><h1>Traducí tu examen a un plan semanal.</h1><p class="lead">Elegí certificación, fecha y nivel actual. Priorizamos habilidades, simulacros y horas pendientes.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art exam"><div class="sheet"><b>A</b><i></i><i></i><i></i></div><div class="timer">45:00</div></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">preparación interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="exam">Examen</label><select id="exam"><option value="ielts">IELTS</option><option value="toefl">TOEFL iBT</option><option value="cambridge">Cambridge B2 First</option><option value="dele">DELE español</option><option value="goethe">Goethe-Zertifikat</option></select></div><div class="field"><label for="date">Fecha del examen</label><input id="date" type="date" value="2026-11-20"></div><div class="field"><label for="level">Nivel actual</label><select id="level"><option value="low">Un nivel por debajo</option><option value="near">Cerca del objetivo</option><option value="ready">Ya alcancé el nivel</option></select></div><div class="field"><label for="hours">Horas por semana</label><input id="hours" type="number" value="6" min="1" max="30" step="1"></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-examenes-idioma')?document.currentScript.previousElementSibling:document.querySelector('.mockup-examenes-idioma');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const now=new Date(),date=new Date(v("date")+"T12:00:00"),weeks=Math.max(1,Math.ceil((date-now)/604800000)),need={low:160,near:90,ready:45}[v("level")],capacity=weeks*vn("hours"),ratio=capacity/need;return {big:weeks+" semanas",label:"Tiempo hasta el examen",badge:ratio>=1?"Carga suficiente":ratio>.65?"Plan ajustado":"Faltan horas",metrics:[["Horas necesarias",need],["Capacidad",capacity+" h"],["Simulacros",Math.max(2,Math.floor(weeks/3))]],position:Math.min(100,ratio*100),note:ratio>=1?"Distribuí práctica entre comprensión, producción y simulacros cronometrados.":"Con esta disponibilidad no alcanza la referencia. Mové fecha, sumá horas o acotá el objetivo."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"exam":"ielts","date":"2026-11-20","level":"low","hours":"6"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
<style is:global>

.mockup-examenes-idioma{--blue:#174b7a;--accent:#805ca7;--soft:#f2edfa;--ink:#172331;--muted:#5e6977;--line:#d9e2e5;--paper:#f5f7f6;--cream:#fff8e2;--mint:#d9eee6}.mockup-examenes-idioma *{box-sizing:border-box}.mockup-examenes-idioma{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fff}.mockup-examenes-idioma button,.mockup-examenes-idioma input,.mockup-examenes-idioma select{font:inherit}.mockup-examenes-idioma .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:27px;border-bottom:1px solid var(--line)}.mockup-examenes-idioma .brand{font-weight:950;font-size:19px}.mockup-examenes-idioma .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-examenes-idioma .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-examenes-idioma .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-examenes-idioma .hero{padding:50px 22px 45px;background:linear-gradient(110deg,#fbfcfa 0 57%,var(--soft) 57%)}.mockup-examenes-idioma .hero-grid,.mockup-examenes-idioma .wrap{max-width:1180px;margin:auto}.mockup-examenes-idioma .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:57px;align-items:center}.mockup-examenes-idioma .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-examenes-idioma .eyebrow{margin-top:27px;color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-examenes-idioma .hero h1{font-size:clamp(43px,5vw,67px);line-height:.98;letter-spacing:-.05em;margin:10px 0 19px}.mockup-examenes-idioma .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-examenes-idioma .pills{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-examenes-idioma .pills span{padding:8px 12px;border:1px solid var(--line);border-radius:99px;background:#fff;font-size:13px;font-weight:800}.mockup-examenes-idioma .art{height:330px;border:1px solid color-mix(in srgb,var(--accent),#fff 62%);background:#fff;border-radius:50% 50% 24px 24px;box-shadow:0 24px 50px #17374a18;position:relative;overflow:hidden;display:grid;place-items:center}.mockup-examenes-idioma .phscale{position:absolute;left:12%;right:12%;bottom:38px;height:24px;border-radius:99px;background:linear-gradient(90deg,#d4424d,#ea943a,#eadf55,#58ad67,#3c83b8,#7251a2);display:flex;justify-content:space-between;padding:30px 0 0;font-size:10px;font-weight:850}.mockup-examenes-idioma .tube{width:65px;height:170px;border:6px solid var(--blue);border-top:0;border-radius:0 0 35px 35px;position:absolute;top:40px}.mockup-examenes-idioma .tube i{position:absolute;left:0;right:0;bottom:0;height:62%;background:var(--accent);border-radius:0 0 27px 27px}.mockup-examenes-idioma .orbit:before,.mockup-examenes-idioma .orbit:after{content:"";position:absolute;border:1px solid #6684ad66;border-radius:50%}.mockup-examenes-idioma .orbit:before{width:210px;height:210px}.mockup-examenes-idioma .orbit:after{width:300px;height:300px}.mockup-examenes-idioma .sun{width:65px;height:65px;background:#f1bd48;border-radius:50%;box-shadow:0 0 35px #e9a52a99}.mockup-examenes-idioma .planet{position:absolute;border-radius:50%;background:var(--accent)}.mockup-examenes-idioma .p1{width:20px;height:20px;left:28%;top:29%}.mockup-examenes-idioma .p2{width:30px;height:30px;right:18%;top:45%}.mockup-examenes-idioma .p3{width:25px;height:25px;left:32%;bottom:13%}.mockup-examenes-idioma .ship{position:absolute;right:26%;top:25%;font-size:38px;color:var(--blue);transform:rotate(-25deg)}.mockup-examenes-idioma .moon .earth{width:130px;height:130px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#7ec9a4 0 20%,#3987af 22% 100%)}.mockup-examenes-idioma .moon .luna{position:absolute;width:62px;height:62px;border-radius:50%;right:16%;top:20%;background:#eee6cf;box-shadow:inset -18px 3px #aaa49a}.mockup-examenes-idioma .tide{position:absolute;left:12%;right:12%;bottom:34px;height:35px;background:repeating-radial-gradient(ellipse at 20px 30px,#3994b9 0 12px,transparent 13px 25px)}.mockup-examenes-idioma .coffee .cup{font-size:110px}.mockup-examenes-idioma .steam{position:absolute;top:50px;width:18px;height:80px;border-left:5px solid var(--accent);border-radius:50%}.mockup-examenes-idioma .s1{left:43%}.mockup-examenes-idioma .s2{left:55%;top:65px}.mockup-examenes-idioma .beer .glass{width:130px;height:205px;border:7px solid var(--blue);border-top-width:12px;border-radius:12px 12px 35px 35px;position:relative;overflow:hidden}.mockup-examenes-idioma .beer .glass i{position:absolute;inset:35px 0 0;background:#e5a63f}.mockup-examenes-idioma .beer .glass b{position:absolute;left:0;right:0;top:18px;height:38px;background:#fff4d5;border-radius:50%;z-index:2}.mockup-examenes-idioma .beer>span{position:absolute;bottom:20px;font-weight:950;color:var(--blue)}.mockup-examenes-idioma .cup{grid-template-columns:1fr auto 1fr;gap:18px}.mockup-examenes-idioma .measurecup{width:125px;height:155px;border:6px solid var(--blue);border-radius:10px 10px 35px 35px;position:relative}.mockup-examenes-idioma .measurecup i{position:absolute;inset:45% 0 0;background:var(--accent)}.mockup-examenes-idioma .measurecup b{position:absolute;top:18px;left:0;right:0;text-align:center;font-size:12px}.mockup-examenes-idioma .cup>span{font-size:45px;color:var(--accent)}.mockup-examenes-idioma .weight{padding:25px 18px;background:var(--soft);border-radius:18px;font-size:25px;font-weight:950}.mockup-examenes-idioma .wall{display:flex;width:240px;height:210px;border:8px solid var(--blue)}.mockup-examenes-idioma .wall i{flex:1;border-right:2px solid #fff;background:repeating-linear-gradient(45deg,var(--accent) 0 8px,var(--soft) 9px 17px)}.mockup-examenes-idioma .cold,.mockup-examenes-idioma .warm{position:absolute;font-size:25px;font-weight:950}.mockup-examenes-idioma .cold{left:18px;color:#3182a0}.mockup-examenes-idioma .warm{right:18px;color:#c26734}.mockup-examenes-idioma .dial{width:215px;height:215px;border-radius:50%;border:18px solid var(--blue);display:grid;place-items:center;position:relative}.mockup-examenes-idioma .dial i{position:absolute;width:7px;height:75px;background:var(--accent);bottom:50%;transform-origin:bottom;transform:rotate(35deg)}.mockup-examenes-idioma .dial b{font-size:52px;margin-top:30px}.mockup-examenes-idioma .dial small{position:absolute;bottom:38px}.mockup-examenes-idioma .clockface{width:210px;height:210px;border:12px solid var(--blue);border-radius:50%;position:relative}.mockup-examenes-idioma .clockface i,.mockup-examenes-idioma .clockface b{position:absolute;left:50%;bottom:50%;width:7px;background:var(--accent);transform-origin:bottom}.mockup-examenes-idioma .clockface i{height:72px;transform:rotate(90deg)}.mockup-examenes-idioma .clockface b{height:55px;transform:rotate(10deg)}.mockup-examenes-idioma .clock>span{position:absolute;bottom:24px;font-size:23px;font-weight:950}.mockup-examenes-idioma .drop i{width:150px;height:190px;background:var(--accent);border-radius:70% 30% 70% 30%;transform:rotate(45deg)}.mockup-examenes-idioma .drop span{position:absolute;color:#fff;font-size:32px;font-weight:950}.mockup-examenes-idioma .bubble{position:absolute;padding:18px 24px;border-radius:24px;background:var(--soft);border:2px solid var(--accent);font-weight:950;font-size:23px}.mockup-examenes-idioma .bubble.a{left:9%;top:20%}.mockup-examenes-idioma .bubble.b{right:9%;top:34%}.mockup-examenes-idioma .bubble.c{left:28%;bottom:16%}.mockup-examenes-idioma .pages{width:240px;height:175px;display:flex;perspective:500px}.mockup-examenes-idioma .pages i{width:50%;background:#fff;border:6px solid var(--blue)}.mockup-examenes-idioma .pages i:first-child{transform:rotateY(14deg)}.mockup-examenes-idioma .pages i:last-child{transform:rotateY(-14deg)}.mockup-examenes-idioma .book>span{position:absolute;bottom:27px;font-weight:950;color:var(--accent)}.mockup-examenes-idioma .sheet{width:180px;height:230px;border:5px solid var(--blue);background:#fff;border-radius:12px;padding:25px}.mockup-examenes-idioma .sheet b{font-size:55px;color:var(--accent)}.mockup-examenes-idioma .sheet i{display:block;border-top:6px solid #cbd7db;margin-top:17px}.mockup-examenes-idioma .timer{position:absolute;right:22px;bottom:24px;padding:12px;background:var(--blue);color:#fff;border-radius:10px;font-weight:950}.mockup-examenes-idioma .target{width:220px;height:220px;border:24px solid var(--accent);border-radius:50%;box-shadow:inset 0 0 0 26px #fff,inset 0 0 0 48px var(--blue);display:grid;place-items:center}.mockup-examenes-idioma .target b{font-size:44px;background:#fff;border-radius:50%;padding:18px}.mockup-examenes-idioma .parrilla{width:245px;height:160px;border:10px solid var(--blue);border-radius:18px;display:flex;gap:12px;padding:28px}.mockup-examenes-idioma .parrilla i{flex:1;border-radius:30px;background:var(--accent)}.mockup-examenes-idioma .fire{position:absolute;bottom:12px;font-size:60px;color:#e78a35}.mockup-examenes-idioma .timeline .line{position:absolute;left:12%;right:12%;top:50%;height:8px;background:var(--blue);display:flex;justify-content:space-between}.mockup-examenes-idioma .timeline .line i{width:29px;height:29px;border:7px solid var(--blue);background:#fff;border-radius:50%;transform:translateY(-11px)}.mockup-examenes-idioma .truck{position:absolute;left:30%;top:38%;font-size:50px;color:var(--accent)}.mockup-examenes-idioma .donut{width:220px;height:220px;border-radius:50%;background:conic-gradient(var(--accent) 0 40%,#e7af53 40% 65%,#4d98a1 65% 80%,#dce4e4 80%);position:relative}.mockup-examenes-idioma .donut:after{content:"";position:absolute;inset:55px;background:#fff;border-radius:50%}.mockup-examenes-idioma .budget>span{position:absolute;font-size:50px;font-weight:950;color:var(--blue)}
.mockup-examenes-idioma .tool{padding:62px 22px}.mockup-examenes-idioma .tool-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.mockup-examenes-idioma .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-examenes-idioma .tool h2,.mockup-examenes-idioma .guide h2{font-size:37px;letter-spacing:-.04em;margin:7px 0}.mockup-examenes-idioma .tool-head p{max-width:510px;color:var(--muted);margin:0}.mockup-examenes-idioma .workspace{display:grid;grid-template-columns:.88fr 1.12fr;gap:20px}.mockup-examenes-idioma .panel{border-radius:24px;padding:27px}.mockup-examenes-idioma .form{border:1px solid var(--line);box-shadow:0 16px 40px #18374a0c}.mockup-examenes-idioma .panel h3{font-size:21px;margin:0 0 5px}.mockup-examenes-idioma .hint{color:var(--muted);font-size:14px;margin:0 0 20px}.mockup-examenes-idioma .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-examenes-idioma .field{margin-bottom:2px}.mockup-examenes-idioma .field label{display:flex;justify-content:space-between;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-examenes-idioma .field output{color:var(--accent)}.mockup-examenes-idioma input,.mockup-examenes-idioma select{width:100%;min-height:49px;border:1px solid #ccd7da;border-radius:12px;background:#fff;padding:12px 14px;color:var(--ink)}.mockup-examenes-idioma input[type=range]{padding:0;accent-color:var(--accent)}.mockup-examenes-idioma .actions{display:flex;gap:9px;margin-top:21px}.mockup-examenes-idioma .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:14px;font-weight:900;cursor:pointer}.mockup-examenes-idioma .reset{border:1px solid #d7aa58;border-radius:12px;background:#fff;color:#654a1f;padding:13px 16px;font-weight:850;cursor:pointer}.mockup-examenes-idioma .result{background:linear-gradient(145deg,var(--blue),color-mix(in srgb,var(--blue),var(--accent) 35%));color:#fff;position:relative;overflow:hidden}.mockup-examenes-idioma .badge{display:inline-block;padding:7px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:950}.mockup-examenes-idioma .big{font-size:48px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:14px 0 5px}.mockup-examenes-idioma .caption{color:#dceaf0;font-size:14px}.mockup-examenes-idioma .meter{height:13px;border-radius:99px;background:#ffffff2d;margin:24px 0;position:relative}.mockup-examenes-idioma .meter i{position:absolute;left:var(--position);top:50%;width:24px;height:24px;border:5px solid #fff;background:var(--accent);border-radius:50%;transform:translate(-50%,-50%);transition:.25s}.mockup-examenes-idioma .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.mockup-examenes-idioma .metric{padding:13px;border:1px solid #ffffff2b;background:#ffffff0e;border-radius:13px}.mockup-examenes-idioma .metric small{display:block;color:#dceaf0;font-size:10px}.mockup-examenes-idioma .metric b{font-size:16px}.mockup-examenes-idioma .note{margin-top:17px;padding:14px 15px;border-radius:12px;background:var(--cream);color:#58461f;font-size:13px}.mockup-examenes-idioma .guide{padding:65px 22px;background:var(--paper)}.mockup-examenes-idioma .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px}.mockup-examenes-idioma .guide p{color:var(--muted)}.mockup-examenes-idioma .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.mockup-examenes-idioma .step{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff}.mockup-examenes-idioma .step b{display:block;color:var(--accent);margin-bottom:5px}.mockup-examenes-idioma .step span{font-size:14px;color:var(--muted)}.mockup-examenes-idioma .foot{padding:30px;text-align:center;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-examenes-idioma .nav{display:none}.mockup-examenes-idioma .hero-grid,.mockup-examenes-idioma .workspace,.mockup-examenes-idioma .guide-grid{grid-template-columns:1fr}.mockup-examenes-idioma .tool-head{flex-direction:column;align-items:start}}@media(max-width:550px){.mockup-examenes-idioma .fields,.mockup-examenes-idioma .metrics,.mockup-examenes-idioma .steps{grid-template-columns:1fr}.mockup-examenes-idioma .hero h1{font-size:43px}.mockup-examenes-idioma .actions{flex-direction:column}.mockup-examenes-idioma .art{height:290px}}

.mockup-examenes-idioma { width:100%; overflow:hidden; }
.mockup-examenes-idioma .top, .mockup-examenes-idioma header.top { display:none !important; }
.mockup-examenes-idioma .foot { display:none !important; }
.mockup-examenes-idioma .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-examenes-idioma .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-examenes-idioma .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-examenes-idioma .support-real summary { cursor:pointer; font-weight:750; }
.mockup-examenes-idioma .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-examenes-idioma :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-examenes-idioma input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-examenes-idioma input[type="number"]::-webkit-inner-spin-button, .mockup-examenes-idioma input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-examenes-idioma .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-examenes-idioma support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
