---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-habitos-salud" set:html={`<section class="hero"><div class="wrap crumb"><b>Salud</b> &nbsp;/&nbsp; Hábitos</div><div class="wrap grid"><div class="copy"><div class="eyebrow">Decisiones cotidianas, con contexto</div><h1>Medí el hábito. Entendé el riesgo. Elegí mejor.</h1><p>Estimaciones claras para alcohol, exposición solar, ayuno y pantallas. Sin promesas mágicas ni falsos permisos.</p><div class="chips"><span>✓ Recomendaciones explicadas</span><span>◎ Riesgo visible</span><span>▤ Fuentes de salud</span></div><div class="art"><div class="sun"></div><div class="leaf"></div><div class="screen"></div><div class="badge"><small>REGLA ACTIVA</small><strong id="art-main">20 · 20 · 20</strong><span id="art-sub">pausas para la vista</span></div></div></div><form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Elegí el hábito</h2><p class="muted">Mostramos sólo los datos que corresponden.</p></div><span class="tag">Orientación personalizada</span></div><div class="label">¿Qué querés revisar?</div><div class="cases"><button type="button" class="case active" data-mode="screen"><i>▣</i>Pantallas</button><button type="button" class="case" data-mode="sun"><i>☀</i>Sol y protector</button><button type="button" class="case" data-mode="fast"><i>◷</i>Ayuno</button><button type="button" class="case" data-mode="alcohol"><i>!</i>Alcohol</button></div><div class="label">Tus datos</div><div class="fields"><div class="field" data-for="screen"><label>Horas de pantalla por día</label><input id="screen-hours" value="8"></div><div class="field" data-for="screen"><label>Pausas que hacés</label><input id="breaks" value="8"></div><div class="field" data-for="screen"><label>Distancia al monitor</label><input id="distance" value="60"></div><div class="field" data-for="screen"><label>Pasos por día</label><input id="steps" value="6500"></div><div class="field hide" data-for="sun"><label>Fototipo de piel</label><select id="skin"><option value="10">I · muy clara</option><option value="15">II · clara</option><option value="20" selected>III · intermedia</option><option value="30">IV · morena</option></select></div><div class="field hide" data-for="sun"><label>Protector solar</label><select id="spf"><option>30</option><option selected>50</option></select></div><div class="field hide" data-for="fast"><label>Protocolo</label><select id="protocol"><option value="12">12/12</option><option value="14">14/10</option><option value="16" selected>16/8</option><option value="18">18/6</option></select></div><div class="field hide" data-for="fast"><label>Última comida</label><input id="lastmeal" type="time" value="20:00"></div><div class="field hide" data-for="alcohol"><label>Peso corporal</label><input id="weight" value="75"></div><div class="field hide" data-for="alcohol"><label>Sexo biológico para Widmark</label><select id="sex"><option value=".68">Masculino</option><option value=".55">Femenino</option></select></div><div class="field hide" data-for="alcohol"><label>Bebidas estándar</label><input id="drinks" value="2"></div><div class="field hide" data-for="alcohol"><label>Horas desde la última</label><input id="hours-since" value="1"></div></div><section class="result"><div class="result-top"><div><small id="result-label">PAUSAS RECOMENDADAS</small><div class="value" id="result">24 pausas</div></div><div class="status"><small>Nivel orientativo</small><b id="status">Moderado</b></div></div><div class="stats"><span id="s1l">TE FALTAN<b id="s1">16 pausas</b></span><span id="s2l">PAUSA LARGA<b id="s2">4 por día</b></span><span id="s3l">META DE PASOS<b id="s3">8.000</b></span></div><div class="alert" id="alert" style="display:none">Si tomaste, no manejés. Esta estimación no habilita a conducir.</div><button class="go" id="update" type="button">Actualizar orientación</button></section></form></div></section>
<section class="section"><div class="wrap"><div class="center"><div class="eyebrow">Tu posición en contexto</div><h2 id="scale-title">Fatiga visual estimada</h2><p id="scale-copy">No es un diagnóstico: sirve para detectar qué ajuste cotidiano puede ayudarte más.</p></div><div class="scale"><div class="track"><i class="pin" id="pin" data-value="Moderado"></i></div><div class="labels"><span><b>Bajo</b>Buen margen</span><span><b>Moderado</b>Conviene ajustar</span><span><b>Alto</b>Pedí orientación</span></div></div></div></section><section class="break"><div class="wrap cards"><article class="card"><h3 id="detail-title">Tu día de pantalla</h3><div class="line"><span id="d1l">Tiempo total</span><b id="d1">8 horas</b></div><div class="line"><span id="d2l">Pausas mínimas</span><b id="d2">24</b></div><div class="line"><span id="d3l">Pausas actuales</span><b id="d3">8</b></div><div class="line"><span id="d4l">Distancia</span><b id="d4">60 cm</b></div></article><article class="card"><h3>Qué hacer con este resultado</h3><div class="steps" id="advice"></div><div class="warning">⚠️ Es una estimación educativa. Si hay síntomas, embarazo, medicación o una condición previa, consultá a un profesional.</div></article></div></section><section class="darksection"><div class="wrap"><div class="rules"><div class="rule"><i>!</i><h3>Alcohol: riesgo cero no existe</h3><p>La OMS advierte que ninguna cantidad está libre de riesgo. Si tomaste, no manejes.</p></div><div class="rule"><i>☀</i><h3>El protector no dura todo el día</h3><p>Reaplicalo cada dos horas y después de nadar o transpirar.</p></div><div class="rule"><i>▣</i><h3>La pausa también cuenta</h3><p>Cada 20 minutos, mirá 20 segundos a una distancia de unos 6 metros.</p></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-habitos-salud')?document.currentScript.previousElementSibling:document.querySelector('.mockup-habitos-salud');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0);let mode="screen";const advice={screen:[["1","Programá pausas","Usá la regla 20-20-20 sin esperar a sentir cansancio."],["2","Alejá la pantalla","Mantené unos 50–70 cm y evitá reflejos."],["3","Movete","Sumá caminatas breves durante el día."]],sun:[["1","Aplicá cantidad suficiente","SPF alto no compensa una capa demasiado fina."],["2","Reaplicá","Cada dos horas y después de agua o sudor."],["3","Buscá sombra","Especialmente en las horas de mayor radiación."]],fast:[["1","Empezá gradual","Probá primero 12/12 antes de una ventana exigente."],["2","Priorizá calidad","La ventana no reemplaza una alimentación adecuada."],["3","Frená ante síntomas","Mareo o debilidad requieren revisar el plan."]],alcohol:[["1","No conduzcas","Ningún cálculo individual garantiza seguridad al volante."],["2","No acelera con café","El cuerpo necesita tiempo para metabolizar alcohol."],["3","Pedí ayuda","Ante confusión, vómitos persistentes o somnolencia extrema, buscá asistencia."]]};
function put(label,result,status,vals,detail,lines,pos){$("#result-label").textContent=label;$("#result").textContent=result;$("#status").textContent=status;["#s1","#s2","#s3"].forEach((x,i)=>$(x).textContent=vals[i]);$("#detail-title").textContent=detail;lines.forEach((v,i)=>{$("#d"+(i+1)+"l").textContent=v[0];$("#d"+(i+1)).textContent=v[1]});$("#pin").style.left=pos+"%";$("#pin").dataset.value=status;$("#advice").innerHTML=advice[mode].map(x=>`<div class="step"><i>${x[0]}</i><div><b>${x[1]}</b><span>${x[2]}</span></div></div>`).join("")}
function calc(){if(mode==="screen"){let h=n("#screen-hours"),br=n("#breaks"),dist=n("#distance"),st=n("#steps"),need=Math.floor(h*3),def=Math.max(0,need-br),score=(h>6?2:0)+(h>9?2:0)+(br<need/2?2:0)+(dist<50?2:0)+(st<8000?1:0),status=score<=2?"Bajo":score<=5?"Moderado":"Alto";put("PAUSAS RECOMENDADAS",need+" pausas",status,[def+" pausas",Math.floor(h/2)+" por día","8.000"],"Tu día de pantalla",[["Tiempo total",h+" horas"],["Pausas mínimas",need],["Pausas actuales",br],["Distancia",dist+" cm"]],score/9*100);$("#art-main").textContent="20 · 20 · 20";$("#art-sub").textContent="pausas para la vista"}if(mode==="sun"){let skin=n("#skin"),spf=n("#spf"),protected=Math.round(skin*spf*.6);put("TIEMPO SIN PROTECTOR",skin+" min","Precaución",[protected+" min","Cada 2 h",spf>=30?"Alta":"Baja"],"Tu exposición solar",[["Fototipo",$("#skin").selectedOptions[0].text],["Sin protector",skin+" min"],["Protección teórica",protected+" min"],["Reaplicación","Cada 2 h"]],38);$("#art-main").textContent="SPF "+spf;$("#art-sub").textContent="reaplicá cada 2 horas"}if(mode==="fast"){let hrs=n("#protocol"),last=$("#lastmeal").value.split(":").map(Number),end=(last[0]+hrs)%24,window=24-hrs;put("DURACIÓN DEL AYUNO",hrs+" horas",hrs<=14?"Gradual":hrs<=16?"Intermedio":"Exigente",[window+" h",""+String(end).padStart(2,"0")+":"+String(last[1]).padStart(2,"0"),Math.floor(window/3)+" comidas"],"Tu ventana diaria",[["Última comida",$("#lastmeal").value],["Rompés el ayuno",String(end).padStart(2,"0")+":"+String(last[1]).padStart(2,"0")],["Ventana para comer",window+" horas"],["Parte del día",Math.round(hrs/24*100)+"%"]],hrs/24*100);$("#art-main").textContent=hrs+"/"+window;$("#art-sub").textContent="protocolo elegido"}if(mode==="alcohol"){let w=n("#weight"),dr=n("#drinks"),elapsed=n("#hours-since"),r=Number($("#sex").value),grams=dr*14,bac=Math.max(0,grams/(w*r)-.15*elapsed),zero=bac/.15,status=bac===0?"Cero estimado":bac<.5?"Riesgo presente":bac<.8?"Sobre límite":"Alto riesgo";put("ALCOHOLEMIA ESTIMADA",bac.toFixed(2).replace(".",",")+" g/L",status,[grams+" g",zero.toFixed(1).replace(".",",")+" h","No manejar"],"Estimación Widmark",[["Alcohol ingerido",grams+" g"],["Peso informado",w+" kg"],["Tiempo transcurrido",elapsed+" h"],["Hasta cero",zero.toFixed(1)+" h"]],Math.min(100,bac/1.5*100));$("#art-main").textContent=bac.toFixed(2)+" g/L";$("#art-sub").textContent="estimación, no permiso";}$("#alert").style.display=mode==="alcohol"?"block":"none"}
function setMode(m){mode=m;$$(".case").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));$$("[data-for]").forEach(x=>x.classList.toggle("hide",x.dataset.for!==m));calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Orientación actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar orientación",1200)};setMode("screen");

})();
</script>
<style is:global>

.mockup-habitos-salud *{box-sizing:border-box}.mockup-habitos-salud{margin:0;color:#16253a;background:#fff;font:15px Inter,system-ui,sans-serif}.mockup-habitos-salud button,.mockup-habitos-salud input,.mockup-habitos-salud select{font:inherit}.mockup-habitos-salud .wrap{max-width:1170px;margin:auto;padding:0 24px}.mockup-habitos-salud header{height:82px;border-bottom:1px solid #e2e8e6;display:flex;align-items:center}.mockup-habitos-salud .nav{display:flex;align-items:center;gap:35px}.mockup-habitos-salud .brand{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:900}.mockup-habitos-salud .logo{background:#234058;color:#fff;padding:9px 7px;border-radius:8px;font-size:11px}.mockup-habitos-salud .links{display:flex;gap:28px;margin:auto;color:#516174;font-size:12px;font-weight:750}.mockup-habitos-salud .tools{display:flex;gap:8px}.mockup-habitos-salud .tools span{padding:11px 13px;border:1px solid #dce5e3;border-radius:10px;font-size:12px;font-weight:750}.mockup-habitos-salud .tools .dark{background:#234058;color:#fff}.mockup-habitos-salud .hero{padding:28px 0 52px;background:linear-gradient(130deg,#f3faf7,#f7f9ff 68%,#fff9f2)}.mockup-habitos-salud .crumb{font-size:12px;color:#748497;margin-bottom:25px}.mockup-habitos-salud .crumb b,.mockup-habitos-salud .eyebrow{color:#1c7967}.mockup-habitos-salud .grid{display:grid;grid-template-columns:.87fr 1.13fr;gap:50px}.mockup-habitos-salud .copy{padding-top:10px}.mockup-habitos-salud .eyebrow{text-transform:uppercase;font-size:11px;letter-spacing:1.7px;font-weight:900}.mockup-habitos-salud .copy h1{font-size:49px;line-height:1.04;letter-spacing:-2.4px;margin:15px 0}.mockup-habitos-salud .copy p{font-size:17px;line-height:1.62;color:#5d6e80}.mockup-habitos-salud .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.mockup-habitos-salud .chips span{background:#fff;border:1px solid #dce6e3;padding:9px 11px;border-radius:9px;font-size:10px;font-weight:750}.mockup-habitos-salud .art{height:225px;position:relati