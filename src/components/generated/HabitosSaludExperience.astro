.mockup-habitos-salud .calc{background:#fff;border:1px solid #dbe4e8;border-radius:21px;padding:27px 29px;box-shadow:0 27px 60px #193a5b18}.mockup-habitos-salud .calc-head{display:flex;justify-content:space-between}.mockup-habitos-salud .calc h2{font-size:24px;margin:0 0 5px}.mockup-habitos-salud .muted{font-size:11px;color:#68798d;margin:0}.mockup-habitos-salud .tag{background:#e8f6f1;color:#20735f;border-radius:99px;padding:7px 10px;font-size:9px;font-weight:850;height:max-content}.mockup-habitos-salud .label{font-size:10px;font-weight:900;margin:18px 0 8px}.mockup-habitos-salud .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.mockup-habitos-salud .case{border:1px solid #dce5e9;background:#fff;border-radius:11px;padding:10px 4px;color:#54677d;font-size:9px;font-weight:800;cursor:pointer}.mockup-habitos-salud .case i{display:block;font-style:normal;font-size:18px;margin-bottom:4px}.mockup-habitos-salud .case.active{border:2px solid #268b78;background:#edf9f5;color:#176e5e;padding:9px 3px}.mockup-habitos-salud .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-habitos-salud .field{border:1px solid #dbe4e9;border-radius:11px;padding:10px 12px}.mockup-habitos-salud .field.wide{grid-column:span 2}.mockup-habitos-salud .field label{display:block;color:#697b8e;font-size:9px;margin-bottom:5px}.mockup-habitos-salud .field input,.mockup-habitos-salud .field select{width:100%;border:0;outline:0;background:transparent;color:#152a43;font-weight:800}.mockup-habitos-salud .field.hide{display:none}.mockup-habitos-salud .result{background:#203d5b;color:#fff;border-radius:16px;padding:19px 20px;margin-top:13px}.mockup-habitos-salud .result-top{display:flex;justify-content:space-between}.mockup-habitos-salud .result small{color:#bfd0de;font-size:9px}.mockup-habitos-salud .value{font-size:35px;font-weight:900;letter-spacing:-1.3px;margin-top:4px}.mockup-habitos-salud .status{background:#e8f6ef;color:#176f58;border-radius:9px;padding:8px 10px;text-align:right}.mockup-habitos-salud .status small{color:inherit}.mockup-habitos-salud .status b{display:block;font-size:13px}.mockup-habitos-salud .stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #3c5874;margin-top:13px;padding-top:12px;gap:8px}.mockup-habitos-salud .stats span{color:#b9cad8;font-size:8px}.mockup-habitos-salud .stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.mockup-habitos-salud .go{width:100%;border:0;border-radius:9px;padding:12px;margin-top:13px;background:linear-gradient(90deg,#268b78,#54a98e);color:#fff;font-weight:850;cursor:pointer}.mockup-habitos-salud .alert{background:#7e3838;color:#fff;border-radius:10px;padding:11px;margin-top:10px;font-size:10px;font-weight:800}.mockup-habitos-salud .section{padding:68px 0}.mockup-habitos-salud .center{text-align:center;max-width:700px;margin:0 auto 35px}.mockup-habitos-salud .center h2{font-size:36px;letter-spacing:-1.4px;margin:9px}.mockup-habitos-salud .center p{color:#65768a}.mockup-habitos-salud .scale{border:1px solid #dce5e9;border-radius:18px;padding:28px;box-shadow:0 15px 35px #1738580d}.mockup-habitos-salud .track{height:20px;border-radius:99px;background:linear-gradient(90deg,#74b596 0 35%,#efc568 35% 65%,#dc7774 65%);position:relative;margin:50px 5px 18px}.mockup-habitos-salud .pin{position:absolute;left:35%;top:50%;transform:translate(-50%,-50%);width:31px;height:31px;border-radius:50%;background:#233f59;border:6px solid #fff;box-shadow:0 5px 14px #293b5040}.mockup-habitos-salud .pin:before{content:attr(data-value);position:absolute;bottom:33px;left:50%;transform:translateX(-50%);background:#233f59;color:#fff;padding:6px 8px;border-radius:7px;white-space:nowrap;font-size:9px;font-weight:850}.mockup-habitos-salud .labels{display:grid;grid-template-columns:repeat(3,1fr);text-align:center;color:#758598;font-size:9px}.mockup-habitos-salud .labels b{display:block;color:#263b50;font-size:11px}.mockup-habitos-salud .break{background:#f4f8fb;padding:64px 0}.mockup-habitos-salud .cards{display:grid;grid-template-columns:1.05fr .95fr;gap:20px}.mockup-habitos-salud .card{background:#fff;border:1px solid #dce5e9;border-radius:17px;padding:24px}.mockup-habitos-salud .card h3{margin:0 0 16px;font-size:19px}.mockup-habitos-salud .line{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #e6ebee}.mockup-habitos-salud .line span{color:#65778b;font-size:10px}.mockup-habitos-salud .line b{font-size:12px}.mockup-habitos-salud .steps{display:grid;gap:13px}.mockup-habitos-salud .step{display:grid;grid-template-columns:34px 1fr;gap:11px}.mockup-habitos-salud .step i{font-style:normal;background:#e8f5f1;color:#1c7a65;width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-weight:900}.mockup-habitos-salud .step b{font-size:11px}.mockup-habitos-salud .step span{display:block;color:#65788c;font-size:10px;margin-top:3px}.mockup-habitos-salud .warning{background:#fff5df;color:#76591f;border:1px solid #efd9a6;padding:12px;border-radius:10px;font-size:10px;margin-top:15px}.mockup-habitos-salud .darksection{background:#19324d;color:#fff;padding:61px 0}.mockup-habitos-salud .rules{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-habitos-salud .rule{border:1px solid #ffffff20;border-radius:15px;padding:18px}.mockup-habitos-salud .rule i{font-style:normal;font-size:22px}.mockup-habitos-salud .rule h3{font-size:13px;margin:10px 0 6px}.mockup-habitos-salud .rule p{font-size:10px;line-height:1.55;color:#c3d0db;margin:0}
@media(max-width:800px){.mockup-habitos-salud .links{display:none}.mockup-habitos-salud .tools span:not(.dark){display:none}.mockup-habitos-salud .grid,.mockup-habitos-salud .cards{grid-template-columns:1fr}.mockup-habitos-salud .copy{text-align:center}.mockup-habitos-salud .copy h1{font-size:40px}.mockup-habitos-salud .chips{justify-content:center}.mockup-habitos-salud .art{max-width:460px;margin:auto}.mockup-habitos-salud .calc{padding:20px 16px}.mockup-habitos-salud .wrap{padding:0 15px}}@media(max-width:470px){.mockup-habitos-salud .cases,.mockup-habitos-salud .fields,.mockup-habitos-salud .stats,.mockup-habitos-salud .rules{grid-template-columns:1fr}.mockup-habitos-salud .field.wide{grid-column:auto}.mockup-habitos-salud .art{transform:scale(.82);transform-origin:left top;height:180px}}

.mockup-habitos-salud { width:100%; overflow:hidden; }
.mockup-habitos-salud .top, .mockup-habitos-salud header.top { display:none !important; }
.mockup-habitos-salud .foot { display:none !important; }
.mockup-habitos-salud .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-habitos-salud .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-habitos-salud .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-habitos-salud .support-real summary { cursor:pointer; font-weight:750; }
.mockup-habitos-salud .support-real p { color:#687a8f; line-height:1.65; }
@media(max-width:800px){.mockup-habitos-salud .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-habitos-salud support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
