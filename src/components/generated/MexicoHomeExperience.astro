---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-mexico-home" set:html={`
    <section class="hero"><div class="wrap hero-grid"><div><div class="eyebrow">Cuentas claras para México</div><h1>De tu nómina a tu próxima decisión.</h1><p class="lead">Calculá sueldo, prestaciones, ISR, IMSS, vivienda, trámites y gastos cotidianos con datos mexicanos actualizados.</p><div class="search-box"><input id="heroSearch" placeholder="¿Qué necesitás calcular?"><button id="heroFind">Encontrar</button></div><div class="trust"><span>Datos 2026</span><span>Sin registro</span><span>Cálculos privados</span><span>Fuentes oficiales</span></div></div>
      <aside class="start"><h2>Empezá por tu situación</h2><p>No necesitás saber el nombre de la calculadora.</p><div class="situations">
        <button class="situation active" data-hub="work"><span>●</span><b>Recibí o comparo un sueldo</b><small>Nómina, prestaciones y liquidación</small></button>
        <button class="situation" data-hub="tax"><span>%</span><b>Tengo que pagar impuestos</b><small>ISR, IVA y declaración anual</small></button>
        <button class="situation" data-hub="home"><span>⌂</span><b>Quiero comprar o rentar</b><small>Crédito, Infonavit y capacidad</small></button>
        <button class="situation" data-hub="daily"><span>▤</span><b>Necesito ordenar mis gastos</b><small>Deudas, auto y costo de vida</small></button>
      </div><div class="recommend"><small>TE RECOMENDAMOS EMPEZAR POR</small><strong id="recTitle">Sueldo y prestaciones</strong><p id="recText">Entendé cuánto te queda y cuánto valen realmente tus beneficios.</p><button id="recButton">Ver herramientas →</button></div></aside>
    </div></section>

    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Hubs de decisión</div><h2>Todo lo que necesitás para resolver una situación.</h2><p>En vez de dejarte con una cuenta aislada, agrupamos cálculos relacionados y te mostramos qué revisar después.</p></div><div class="decision-grid" id="decisions"></div></div></section>
    <section class="tint" id="detail"><div class="wrap"><div class="section-head"><div class="eyebrow">Dentro del hub</div><h2 id="detailHeading">Trabajo: entendé el valor completo de tu empleo.</h2></div><div class="detail-grid"><article class="detail-intro"><small>RECORRIDO RECOMENDADO</small><h3 id="detailTitle">Primero mirá lo que recibís hoy.</h3><p id="detailCopy">Calculá tu neto y después sumá prestaciones, aguinaldo, vacaciones y PTU para comparar bien.</p><button id="startHub">Empezar este recorrido →</button></article><div class="tools" id="tools"></div></div></div></section>

    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Accesos rápidos</div><h2>Las herramientas más usadas en México</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-cat="all">Todas</button><button class="filter" data-cat="work">Trabajo</button><button class="filter" data-cat="tax">Impuestos</button><button class="filter" data-cat="home">Vivienda</button><button class="filter" data-cat="daily">Vida diaria</button></div><input class="tool-search" id="toolSearch" placeholder="Buscar herramienta…"></div><div class="popular" id="popular"></div><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></section>
    <section class="tint"><div class="wrap official"><article class="panel"><h3>Datos con fuente y fecha</h3><p>Cada herramienta mexicana identifica la regla usada y cuándo fue actualizada.</p><div class="row"><span>Impuestos</span><b>SAT</b></div><div class="row"><span>Trabajo y salario</span><b>STPS · CONASAMI</b></div><div class="row"><span>Seguridad social</span><b>IMSS · Infonavit</b></div></article><article class="panel dark"><h3>No necesitás compartir tus datos</h3><p>Los cálculos se hacen en tu dispositivo. Podés explorar escenarios sin crear una cuenta.</p><div class="row"><span>Registro</span><b>No requerido</b></div><div class="row"><span>Datos personales</span><b>No se guardan</b></div></article></div></section>
  <button type="button" id="overlay" hidden aria-hidden="true"></button><button type="button" id="globalSearch" hidden aria-hidden="true"></button><button type="button" id="results" hidden aria-hidden="true"></button><button type="button" id="openSearch" hidden aria-hidden="true"></button><button type="button" id="close" hidden aria-hidden="true"></button><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-mexico-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-mexico-home');

    const hubs={
      work:{icon:"$",name:"Trabajo y prestaciones",short:"Sueldo, derechos y costo laboral.",heading:"Trabajo: entendé el valor completo de tu empleo.",title:"Primero mirá lo que recibís hoy.",copy:"Calculá tu neto y después sumá prestaciones, aguinaldo, vacaciones y PTU para comparar bien.",tools:[["Sueldo neto","ISR, IMSS y deducciones de nómina."],["Aguinaldo, prima y PTU","Prestaciones anuales y proporcionales."],["Finiquito y liquidación","Conceptos según la forma de salida."],["Salario diario integrado","Base salarial para IMSS y prestaciones."]]},
      tax:{icon:"%",name:"Impuestos y SAT",short:"ISR, IVA y obligaciones frecuentes.",heading:"Impuestos: calculá antes de declarar.",title:"Ubicá primero de dónde viene el ingreso.",copy:"Las obligaciones cambian según seas empleado, independiente, arrendador o tengas una empresa.",tools:[["ISR por mi cuenta","Pagos provisionales para independientes."],["Declaración anual","Ingresos, retenciones y deducciones."],["IVA","Trasladado, acreditable y saldo."],["Impuestos de mi empresa","Escenarios y obligaciones del negocio."]]},
      home:{icon:"⌂",name:"Vivienda y patrimonio",short:"Renta, crédito y compra de vivienda.",heading:"Vivienda: calculá el costo completo.",title:"Empezá por tu capacidad mensual real.",copy:"Compará renta o compra sumando enganche, crédito, seguros, mantenimiento e impuestos.",tools:[["Crédito de vivienda","Mensualidad, plazo y costo financiero."],["Rentar o comprar","Comparación de costo total."],["Rentar mi departamento","Ingreso neto como arrendador."],["Vender o heredar un inmueble","Impuestos y gastos de operación."]]},
      daily:{icon:"▤",name:"Dinero y vida diaria",short:"Deudas, auto, trámites y costo de vida.",heading:"Vida diaria: ordená lo que sale cada mes.",title:"Identificá primero tus gastos fijos.",copy:"Después compará deudas, movilidad, documentos y objetivos de ahorro sin mezclar horizontes.",tools:[["Deudas y crédito","Cuotas, intereses y estrategia de pago."],["Gasto de usar el auto","Combustible, seguro y mantenimiento."],["Costo de mis documentos","Pasaporte y trámites por estado."],["Cuánto cuesta vivir","Presupuesto según ciudad y hogar."]]},
      family:{icon:"♥",name:"Familia y apoyos",short:"Pensiones, licencias, becas y cuidados.",heading:"Familia: anticipá fechas y presupuesto.",title:"Elegí el cambio que estás atravesando.",copy:"Reunimos derechos laborales, apoyos y gastos para que puedas armar un escenario completo.",tools:[["Pensión alimenticia","Estimación y variables relevantes."],["Licencias e incapacidades","Días, pago y requisitos."],["Apoyos del Bienestar","Programas y criterios generales."],["Escuela y becas","Costos, calendario y apoyos."]]},
      auto:{icon:"●",name:"Auto y movilidad",short:"Compra, uso, tenencia y licencias.",heading:"Auto: compará el costo anual, no solo el precio.",title:"Calculá cuánto cuesta tenerlo en movimiento.",copy:"Sumá compra, depreciación, combustible, seguro, tenencia, verificación y trámites.",tools:[["Comprar o vender auto","Precio, financiamiento y depreciación."],["Gasto de usar el auto","Costo mensual y por kilómetro."],["Tenencia, verificación y placas","Costo según entidad."],["Licencia por estado","Costo y vigencia comparados."]]}
    };
    const popularData=[
      ["work","$","Sueldo neto","ISR, IMSS y deducciones."],["work","▤","Salario diario integrado","SBC, prestaciones e IMSS."],["work","●","Finiquito y liquidación","Conceptos de salida laboral."],["tax","%","ISR por mi cuenta","Pagos provisionales estimados."],
      ["tax","▦","Declaración anual","Ingresos y deducciones."],["home","⌂","Crédito de vivienda","Cuota, plazo e intereses."],["daily","▤","Costo de documentos","Pasaporte y trámites."],["daily","●","Licencia por estado","Costo y vigencia."]
    ];
    let active="work";const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];
    function renderDecisions(){$("#decisions").innerHTML=Object.entries(hubs).map(([k,h],i)=>`<button class="decision ${k===active?"active":""}" data-hub="${k}"><span class="dicon">${h.icon}</span><span class="index">0${i+1}</span><h3>${h.name}</h3><p>${h.short}</p><ul><li>Ver opciones</li><li>Comparar escenarios</li></ul></button>`).join("");$$(".decision").forEach(b=>b.onclick=()=>selectHub(b.dataset.hub,true))}
    function selectHub(k,scroll=false){active=k;const h=hubs[k];$$("[data-hub]").forEach(b=>b.classList.toggle("active",b.dataset.hub===k));$("#recTitle").textContent=h.name;$("#recText").textContent=h.short;$("#detailHeading").textContent=h.heading;$("#detailTitle").textContent=h.title;$("#detailCopy").textContent=h.copy;$("#tools").innerHTML=h.tools.map(t=>`<article class="tool"><small>HERRAMIENTA RECOMENDADA</small><h4>${t[0]}</h4><p>${t[1]}</p><button data-open="${t[0]}">Abrir →</button></article>`).join("");$$("[data-open]").forEach(b=>b.onclick=()=>showToast("Abriendo: "+b.dataset.open));if(scroll)$("#detail").scrollIntoView({behavior:"smooth"})}
    $$(".situation").forEach(b=>b.onclick=()=>selectHub(b.dataset.hub));$("#recButton").onclick=()=>selectHub(active,true);$("#startHub").onclick=()=>showToast("Iniciando recorrido: "+hubs[active].name);
    function renderPopular(){ $("#popular").innerHTML=popularData.map(x=>`<article class="pop" data-cat="${x[0]}" data-text="${(x[2]+" "+x[3]).toLowerCase()}"><i>${x[1]}</i><h3>${x[2]}</h3><p>${x[3]}</p><button data-open="${x[2]}">Abrir →</button></article>`).join("");$$("[data-open]").forEach(b=>b.onclick=()=>showToast("Abriendo: "+b.dataset.open))}
    function filter(){const cat=$(".filter.active").dataset.cat,q=$("#toolSearch").value.toLowerCase();let n=0;$$(".pop").forEach(c=>{const ok=(cat==="all"||c.dataset.cat===cat)&&c.dataset.text.includes(q);c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}
    $$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter()});$("#toolSearch").oninput=filter;
    const names=[...popularData.map(x=>x[2]),...Object.values(hubs).flatMap(h=>h.tools.map(t=>t[0]))];
    function openSearch(q=""){$("#overlay").classList.add("open");$("#globalSearch").value=q;searchResults()}function searchResults(){const q=$("#globalSearch").value.toLowerCase();const found=[...new Set(names)].filter(n=>!q||n.toLowerCase().includes(q)).slice(0,8);$("#results").innerHTML=found.map(n=>`<button data-result="${n}"><strong>${n}</strong><br><small>Abrir herramienta →</small></button>`).join("")||"<p>No encontramos resultados.</p>";$$("[data-result]").forEach(b=>b.onclick=()=>showToast("Abriendo: "+b.dataset.result))}
    $("#openSearch").onclick=()=>openSearch();$("#heroFind").onclick=()=>openSearch($("#heroSearch").value);$("#heroSearch").onkeydown=e=>{if(e.key==="Enter")openSearch(e.currentTarget.value)};$("#globalSearch").oninput=searchResults;$("#close").onclick=()=>$("#overlay").classList.remove("open");
    function showToast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1400)}
    renderDecisions();renderPopular();selectHub("work");
  
})();
</script>
<style is:global>

    .mockup-mexico-home{--ink:#10203b;--muted:#657287;--green:#14775a;--green2:#dff5eb;--navy:#174B7A;--red:#c64a50;--cream:#f7f8f3;--line:#dfe5e3;--white:#fff;--yellow:#f5d36c}
    .mockup-mexico-home *{box-sizing:border-box}.mockup-mexico-home{scroll-behavior:smooth}.mockup-mexico-home{margin:0;background:var(--cream);color:var(--ink);font:16px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-mexico-home button,.mockup-mexico-home input{font:inherit}.mockup-mexico-home .flag{height:5px;background:linear-gradient(90deg,#14775a 0 33.3%,#fff 33.3% 66.6%,#c64a50 66.6%)}.mockup-mexico-home .wrap{max-width:1180px;margin:auto;padding:0 24px}
    .mockup-mexico-home header{height:78px;background:#fffffff2;border-bottom:1px solid var(--line);display:flex;align-items:center;position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)}.mockup-mexico-home nav{display:flex;align-items:center;gap:30px}.mockup-mexico-home .brand{font-size:19px;font-weight:900;display:flex;gap:10px;align-items:center}.mockup-mexico-home .logo{width:33px;height:37px;background:var(--navy);color:#fff;border-radius:9px;display:grid;place-items:center}.mockup-mexico-home .links{display:flex;gap:23px;font-size:13px;color:#526075;font-weight:700}.mockup-mexico-home .actions{margin-left:auto;display:flex;gap:8px}.mockup-mexico-home .btn-sm{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 13px;color:var(--ink);font-weight:750}
    .mockup-mexico-home .hero{padding:58px 0 72px;background:radial-gradient(circle at 4% 8%,#daf3e7 0,transparent 31%),radial-gradient(circle at 97% 90%,#f9e6e6 0,transparent 26%)}.mockup-mexico-home .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:58px;align-items:center}.mockup-mexico-home .eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--green);font-weight:900}.mockup-mexico-home h1{font-size:58px;line-height:1;letter-spacing:-.055em;margin:14px 0 19px}.mockup-mexico-home .lead{font-size:19px;color:var(--muted);max-width:640px}.mockup-mexico-home .search-box{display:flex;background:#fff;border:1px solid #d5dfdb;border-radius:16px;padding:7px;box-shadow:0 20px 55px #173c3020;margin-top:27px}.mockup-mexico-home .search-box input{border:0;outline:0;flex:1;min-width:0;padding:12px}.mockup-mexico-home .search-box button{border:0;background:var(--green);color:#fff;border-radius:11px;padding:0 19px;font-weight:850;cursor:pointer}.mockup-mexico-home .trust{display:flex;gap:15px;flex-wrap:wrap;margin-top:17px;color:#68758a;font-size:12px}.mockup-mexico-home .trust span:before{content:"✓";color:var(--green);font-weight:900;margin-right:5px}
    .mockup-mexico-home .start{background:#fff;border:1px solid var(--line);border-radius:27px;padding:27px;box-shadow:0 25px 60px #153a2e1a}.mockup-mexico-home .start h2{font-size:24px;margin:0 0 5px}.mockup-mexico-home .start>p{font-size:13px;color:var(--muted);margin:0 0 18px}.mockup-mexico-home .situations{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-mexico-home .situation{border:1px solid var(--line);background:#fbfcfb;border-radius:14px;padding:14px;text-align:left;cursor:pointer;color:var(--ink);min-height:82px}.mockup-mexico-home .situation b{display:block;font-size:13px;margin:7px 0 2px}.mockup-mexico-home .situation small{font-size:10px;color:var(--muted)}.mockup-mexico-home .situation.active{border:2px solid var(--green);padding:13px;background:var(--green2)}.mockup-mexico-home .recommend{background:var(--navy);color:#fff;border-radius:16px;padding:17px;margin-top:12px}.mockup-mexico-home .recommend small{color:#9fc2d0;font-size:9px;font-weight:850;letter-spacing:.1em}.mockup-mexico-home .recommend strong{display:block;font-size:18px;margin:5px 0}.mockup-mexico-home .recommend p{margin:0;color:#b9cad3;font-size:11px}.mockup-mexico-home .recommend button{border:0;background:var(--yellow);color:#594718;border-radius:9px;padding:10px 12px;font-size:11px;font-weight:900;margin-top:12px;cursor:pointer}
    .mockup-mexico-home section{padding:74px 0}.mockup-mexico-home .section-head{text-align:center;max-width:720px;margin:0 auto 38px}.mockup-mexico-home .section-head h2{font-size:40px;letter-spacing:-.045em;line-height:1.1;margin:10px 0}.mockup-mexico-home .section-head p{color:var(--muted);margin:0}.mockup-mexico-home .decision-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.mockup-mexico-home .decision{border:1px solid var(--line);background:#fff;border-radius:21px;padding:23px;text-align:left;cursor:pointer;color:var(--ink);min-height:230px;position:relative;transition:.2s}.mockup-mexico-home .decision:hover,.mockup-mexico-home .decision.active{transform:translateY(-4px);border-color:var(--green);box-shadow:0 18px 40px #173a301a}.mockup-mexico-home .decision.active{background:var(--navy);color:#fff}.mockup-mexico-home .decision.active p,.mockup-mexico-home .decision.active li{color:#bfd0d8}.mockup-mexico-home .dicon{width:44px;height:44px;background:var(--green2);color:var(--green);display:grid;place-items:center;border-radius:13px;font-size:20px;font-weight:850}.mockup-mexico-home .decision h3{font-size:21px;margin:16px 0 6px}.mockup-mexico-home .decision p{font-size:12px;color:var(--muted);margin:0}.mockup-mexico-home .decision ul{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:5px}.mockup-mexico-home .decision li{font-size:11px;color:#56677b}.mockup-mexico-home .decision li:before{content:"→ ";color:#41bd91;font-weight:900}.mockup-mexico-home .index{position:absolute;right:20px;top:21px;color:var(--green);font-weight:900}
    .mockup-mexico-home .tint{background:#edf5f1}.mockup-mexico-home .detail-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:18px}.mockup-mexico-home .detail-intro{background:var(--navy);color:#fff;border-radius:23px;padding:28px}.mockup-mexico-home .detail-intro small{color:#70d6b1;font-size:10px;font-weight:850}.mockup-mexico-home .detail-intro h3{font-size:28px;line-height:1.15;margin:13px 0 10px}.mockup-mexico-home .detail-intro p{color:#bdcdd4;font-size:13px}.mockup-mexico-home .detail-intro button{border:0;background:var(--yellow);color:#594718;border-radius:10px;padding:12px 14px;font-weight:900;margin-top:10px;cursor:pointer}.mockup-mexico-home .tools{display:grid;grid-template-columns:1fr 1fr;gap:11px}.mockup-mexico-home .tool{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;min-height:145px;display:flex;flex-direction:column}.mockup-mexico-home .tool small{color:var(--green);font-size:9px;font-weight:900}.mockup-mexico-home .tool h4{font-size:16px;margin:9px 0 5px}.mockup-mexico-home .tool p{color:var(--muted);font-size:11px;margin:0}.mockup-mexico-home .tool button{margin-top:auto;padding:12px 0 0;text-align:left;border:0;background:transparent;color:var(--green);font-weight:850;font-size:11px;cursor:pointer}
    .mockup-mexico-home .toolbar{display:flex;gap:12px;justify-content:space-between;margin-bottom:20px}.mockup-mexico-home .filters{display:flex;gap:7px;flex-wrap:wrap}.mockup-mexico-home .filter{border:1px solid var(--line);background:#fff;border-radius:99px;padding:9px 13px;font-size:11px;font-weight:800;color:#68758a;cursor:pointer}.mockup-mexico-home .filter.active{background:var(--navy);color:#fff;border-color:var(--navy)}.mockup-mexico-home .tool-search{min-width:260px;border:1px solid var(--line);border-radius:12px;padding:10px 13px}.mockup-mexico-home .popular{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.mockup-mexico-home .pop{background:#fff;border:1px solid var(--line);border-radius:18px;padding:19px;min-height:174px;display:flex;flex-direction:column}.mockup-mexico-home .pop i{font-style:normal;color:var(--green);font-size:21px;font-weight:900}.mockup-mexico-home .pop h3{font-size:16px;margin:12px 0 5px}.mockup-mexico-home .pop p{font-size:11px;color:var(--muted);margin:0}.mockup-mexico-home .pop button{border:0;background:transparent;color:var(--green);font-weight:850;text-align:left;padding:14px 0 0;margin-top:auto;font-size:11px;cursor:pointer}.mockup-mexico-home .empty{display:none;text-align:center;color:var(--muted);padding:30px}
    .mockup-mexico-home .official{display:grid;grid-template-columns:1fr 1fr;gap:16px}.mockup-mexico-home .panel{background:#fff;border:1px solid var(--line);border-radius:21px;padding:25px}.mockup-mexico-home .panel.dark{background:var(--navy);color:#fff;border:0}.mockup-mexico-home .panel h3{font-size:23px;margin:0 0 7px}.mockup-mexico-home .panel p{font-size:12px;color:var(--muted)}.mockup-mexico-home .dark p{color:#b9cbd3}.mockup-mexico-home .row{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:12px 0;font-size:11px}.mockup-mexico-home .dark .row{border-color:#ffffff1d}.mockup-mexico-home .row b{color:var(--green)}.mockup-mexico-home .dark .row b{color:var(--yellow)}.mockup-mexico-home footer{background:var(--navy);color:#bdcad7;padding:42px 0}.mockup-mexico-home .footer{display:flex;justify-content:space-between}.mockup-mexico-home .footer strong{color:#fff}
    .mockup-mexico-home .overlay{display:none;position:fixed;inset:0;background:#102d48ec;z-index:50;padding-top:110px}.mockup-mexico-home .overlay.open{display:block}.mockup-mexico-home .search-modal{width:min(650px,calc(100% - 30px));margin:auto;background:#fff;border-radius:20px;padding:22px}.mockup-mexico-home .modal-top{display:flex;justify-content:space-between;align-items:center}.mockup-mexico-home .modal-top h2{margin:0}.mockup-mexico-home .close{border:0;background:#eef1f3;border-radius:9px;padding:8px 10px;cursor:pointer}.mockup-mexico-home .search-modal input{width:100%;border:1px solid var(--line);border-radius:12px;padding:14px;margin:16px 0 10px}.mockup-mexico-home .results{display:grid;gap:7px}.mockup-mexico-home .results button{border:1px solid var(--line);background:#fbfcfb;border-radius:11px;padding:12px;text-align:left;cursor:pointer}.mockup-mexico-home .toast{position:fixed;right:22px;bottom:22px;background:var(--navy);color:#fff;border-radius:12px;padding:13px 17px;opacity:0;transform:translateY(70px);transition:.25s;z-index:80;font-size:12px}.mockup-mexico-home .toast.show{opacity:1;transform:none}
