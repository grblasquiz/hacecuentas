---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-prestamo-anses" set:html={`<section class="hero"><div class="shell hero-grid"><div><div class="crumb">Jubilación / Créditos</div><div class="eyebrow">Situación vigente y simulador</div><h1>Antes de aceptar un préstamo, mirá cuánto te queda del haber.</h1><p class="lede">Revisá una cuota existente o compará una oferta bancaria por costo total y peso sobre tus ingresos.</p><div class="chips"><span class="chip">No hay nuevos Créditos ANSES</span><span class="chip">Cuota sobre el haber</span><span class="chip">Costo financiero editable</span></div></div><div class="art" aria-hidden="true"><div class="orb"></div><div class="card-art"><div class="art-tag">CUOTA ESTIMADA</div><div class="art-value" id="heroValue">$111.239</div><div class="art-line"></div></div></div></div></section><section class="section"><div class="shell"><div class="head"><div class="eyebrow">Probá cuatro decisiones</div><h2>La cuota puede ser parecida, el costo total no</h2><p>Los escenarios cambian plazo y tasa; después podés reemplazarlos por la propuesta que recibiste.</p></div><div class="cases"><button class="case active" data-case="0"><b>Cuidar el haber</b><small>Busca una cuota cercana al 10% del ingreso neto.</small></button><button class="case" data-case="1"><b>Tope del 20%</b><small>Muestra el máximo histórico de afectación de Créditos ANSES.</small></button><button class="case" data-case="2"><b>Plazo corto</b><small>Cuota mayor para pagar menos intereses totales.</small></button><button class="case" data-case="3"><b>Oferta bancaria</b><small>Cargá el CFT informado y compará el costo completo.</small></button></div><div class="calc"><div class="panel"><h3>Datos del préstamo</h3><p class="intro" id="caseIntro">Una cuota más baja deja margen para gastos médicos, vivienda y aumentos.</p><div class="fields"><div class="field"><label for="amountLoan">Monto a financiar</label><input id="amountLoan" type="number" min="0" step="10000" value="1500000"></div><div class="field"><label for="income">Haber neto mensual</label><input id="income" type="number" min="1" step="1000" value="850000"></div><div class="field"><label for="months">Cantidad de cuotas</label><select id="months"><option value="12">12 meses</option><option value="24" selected>24 meses</option><option value="36">36 meses</option><option value="48">48 meses</option></select></div><div class="field"><label for="rate">Costo financiero total anual (%)</label><input id="rate" type="number" min="0" step="0.1" value="72"></div></div><div class="buttons"><button class="primary" id="calculate">Actualizar comparación</button><button class="secondary" id="reset">Reiniciar</button></div></div><div class="panel result" aria-live="polite"><div class="res-top"><div><div class="label">Cuota mensual estimada</div><div class="amount" id="amount">—</div></div><span class="pill" id="scenario">Cuidar el haber</span></div><p class="summary" id="summary"></p><div class="metrics"><div class="metric"><span>Cuota / haber</span><strong id="m1">—</strong></div><div class="metric"><span>Haber disponible</span><strong id="m2">—</strong></div><div class="metric"><span>Total a devolver</span><strong id="m3">—</strong></div><div class="metric"><span>Costo financiero</span><strong id="m4">—</strong></div></div><div class="progress"><i id="bar"></i></div><div class="note" id="note">ANSES ya no otorga nuevos créditos con fondos del FGS. Verificá cualquier oferta directamente con la entidad que la emite.</div></div></div></div></section><section class="section support"><div class="shell"><div class="head"><div class="eyebrow">Antes de firmar</div><h2>Tres números que deben estar claros</h2></div><div class="support-grid"><article class="support-card"><span>CUOTA</span><h3>Cuánto te queda disponible</h3><p>No mires sólo si la cuota “entra”: restala del haber y comparala con tus gastos esenciales.</p></article><article class="support-card"><span>CFT</span><h3>El costo completo</h3><p>Usá el costo financiero total, no solamente la tasa nominal anunciada.</p></article><article class="support-card"><span>ORIGEN</span><h3>Quién ofrece el crédito</h3><p>ANSES no solicita claves ni datos bancarios por teléfono o mensajería. Confirmá la entidad y el contrato.</p></article></div></div></section><section class="section"><div class="shell faq"><div class="head"><div class="eyebrow">Preguntas frecuentes</div><h2>Lo importante, sin vueltas</h2></div><div class="faq-item open"><button class="faq-q">¿ANSES está otorgando créditos nuevos?<span>+</span></button><div class="faq-a">No mediante el esquema anterior financiado por el Fondo de Garantía de Sustentabilidad. La página debe mantener este aviso actualizado con información oficial.</div></div><div class="faq-item"><button class="faq-q">¿Qué representa el 20%?<span>+</span></button><div class="faq-a">Era el límite de afectación mensual indicado para Créditos ANSES. En ofertas de terceros puede regir otra condición contractual.</div></div><div class="faq-item"><button class="faq-q">¿La primera cuota puede ser distinta?<span>+</span></button><div class="faq-a">En créditos ANSES existentes podía incluir gastos de seguro. Para una oferta bancaria, revisá el detalle contractual.</div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-prestamo-anses')?document.currentScript.previousElementSibling:document.querySelector('.mockup-prestamo-anses');

(()=>{const $=id=>root.querySelector("#"+id),cases=["Cuidar el haber","Tope del 20%","Plazo corto","Oferta bancaria"],intros=["Una cuota más baja deja margen para gastos médicos, vivienda y aumentos.","Acercarse al 20% reduce el margen mensual: mirá el haber disponible.","Un plazo más corto eleva la cuota pero baja el interés acumulado.","Reemplazá el CFT por el de la propuesta formal de la entidad."];let active=0;const n=id=>Math.max(0,Number($(id).value)||0),money=v=>"$"+Math.round(v).toLocaleString("es-AR");function compute(){const principal=n("amountLoan"),income=Math.max(1,n("income")),months=Math.max(1,n("months")),annual=n("rate"),r=Math.pow(1+annual/100,1/12)-1,installment=r?principal*r*Math.pow(1+r,months)/(Math.pow(1+r,months)-1):principal/months,total=installment*months,cost=total-principal,share=installment/income*100,remaining=income-installment;$("amount").textContent=money(installment);$("heroValue").textContent=money(installment);$("scenario").textContent=cases[active];$("summary").textContent=`La cuota usaría ${share.toLocaleString("es-AR",{maximumFractionDigits:1})}% del haber. Después del descuento quedarían ${money(Math.max(0,remaining))} por mes.`;$("m1").textContent=share.toLocaleString("es-AR",{maximumFractionDigits:1})+"%";$("m2").textContent=money(Math.max(0,remaining));$("m3").textContent=money(total);$("m4").textContent=money(cost);$("bar").style.width=Math.min(100,share*4)+"%";$("note").textContent=share>20?"La cuota supera el 20% del haber: compará un monto menor o un plazo diferente.":"La cuota queda dentro de la referencia del 20%, pero igual revisá tus gastos esenciales y el contrato."}function preset(i){active=i;const configs=[[24,72],[36,78],[12,68],[24,110]][i];$("months").value=String(configs[0]);$("rate").value=configs[1];$("caseIntro").textContent=intros[i];root.querySelectorAll("[data-case]").forEach((b,j)=>b.classList.toggle("active",i===j));compute()}root.querySelectorAll("[data-case]").forEach(b=>b.addEventListener("click",()=>preset(Number(b.dataset.case))));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",compute));$("calculate").addEventListener("click",compute);$("reset").addEventListener("click",()=>{$("amountLoan").value=1500000;$("income").value=850000;preset(0)});root.querySelectorAll(".faq-q").forEach(q=>q.addEventListener("click",()=>q.parentElement.classList.toggle("open")));compute()})();

})();
</script>
<style is:global>

.mockup-prestamo-anses{--ink:#182231;--muted:#657386;--blue:#174b7a;--blue2:#eaf4fb;--mint:#39b799;--mint2:#e7f8f3;--coral:#e77c67;--sun:#f4bd55;--line:#dce4e9;--paper:#fbfcfa;--white:#fff;--shadow:0 18px 48px rgba(23,75,122,.1)}.mockup-prestamo-anses *{box-sizing:border-box}.mockup-prestamo-anses{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-prestamo-anses button,.mockup-prestamo-anses input,.mockup-prestamo-anses select{font:inherit}.mockup-prestamo-anses .shell{max-width:1180px;margin:auto;padding:0 24px}.mockup-prestamo-anses .header{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-prestamo-anses .nav{display:flex;justify-content:space-between;align-items:center}.mockup-prestamo-anses .brand{display:flex;align-items:center;gap:10px;font-weight:900}.mockup-prestamo-anses .logo{width:31px;height:35px;border-radius:7px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:12px}.mockup-prestamo-anses .links{display:flex;gap:24px;color:#526074;font-size:13px;font-weight:750}.mockup-prestamo-anses .navbtn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 12px;color:#46566a}.mockup-prestamo-anses .hero{padding:52px 0 47px;background:linear-gradient(135deg,#eef9f6,#fff7e7 58%,#edf6fb)}.mockup-prestamo-anses .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:50px;align-items:center}.mockup-prestamo-anses .crumb{color:var(--blue);font-size:13px;font-weight:800}.mockup-prestamo-anses .eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:900;color:var(--blue);margin-top:18px}.mockup-prestamo-anses .hero h1{font-size:52px;line-height:1.03;letter-spacing:-.05em;margin:12px 0 17px}.mockup-prestamo-anses .lede{font-size:18px;line-height:1.55;color:#536174}.mockup-prestamo-anses .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.mockup-prestamo-anses .chip{background:#fff;border:1px solid #d4e2df;border-radius:99px;padding:8px 11px;font-size:11px;color:#46655e;font-weight:800}.mockup-prestamo-anses .art{height:310px;position:relative}.mockup-prestamo-anses .orb{position:absolute;width:265px;height:265px;border-radius:50%;right:35px;top:18px;background:#dceef2}.mockup-prestamo-anses .card-art{position:absolute;left:20px;top:64px;width:250px;height:164px;border-radius:23px;background:#fff;border:3px solid var(--blue);box-shadow:14px 16px 0 rgba(57,183,153,.22);padding:25px}.mockup-prestamo-anses .art-tag{font-size:10px;color:var(--blue);font-weight:900;letter-spacing:.08em}.mockup-prestamo-anses .art-value{font-size:37px;font-weight:950;color:var(--blue);margin:17px 0}.mockup-prestamo-anses .art-line{height:9px;border-radius:9px;background:linear-gradient(90deg,var(--mint) 0 67%,#e5ebee 67%)}.mockup-prestamo-anses .section{padding:62px 0}.mockup-prestamo-anses .head{text-align:center;max-width:790px;margin:0 auto 29px}.mockup-prestamo-anses .head h2{font-size:36px;letter-spacing:-.04em;margin:8px 0}.mockup-prestamo-anses .head p{color:var(--muted);line-height:1.6}.mockup-prestamo-anses .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:22px}.mockup-prestamo-anses .case{border:1px solid var(--line);background:#fff;border-radius:17px;padding:16px;text-align:left;cursor:pointer;color:var(--ink);min-height:108px}.mockup-prestamo-anses .case.active{border:2px solid var(--blue);background:var(--blue2)}.mockup-prestamo-anses .case b{display:block;font-size:13px;margin-bottom:6px}.mockup-prestamo-anses .case small{color:var(--muted);font-size:10px;line-height:1.4}.mockup-prestamo-anses .calc{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px;align-items:start}.mockup-prestamo-anses .panel{background:#fff;border:1px solid var(--line);border-radius:23px;padding:27px;box-shadow:var(--shadow)}.mockup-prestamo-anses .panel h3{font-size:21px;margin:0 0 7px}.mockup-prestamo-anses .intro{font-size:13px;color:var(--muted);line-height:1.5;margin:0 0 20px}.mockup-prestamo-anses .fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-prestamo-anses .field.full{grid-column:1/-1}.mockup-prestamo-anses .field label{display:block;font-size:12px;font-weight:850;margin-bottom:7px}.mockup-prestamo-anses .field input,.mockup-prestamo-anses .field select{width:100%;height:48px;border:1px solid #cbd5df;border-radius:12px;background:#fff;color:var(--ink);padding:0 12px;outline:none}.mockup-prestamo-anses .field input:focus,.mockup-prestamo-anses .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,75,122,.12)}.mockup-prestamo-anses .buttons{display:flex;gap:9px;margin-top:20px}.mockup-prestamo-anses .primary,.mockup-prestamo-anses .secondary{border-radius:12px;padding:13px 16px;font-weight:900;cursor:pointer}.mockup-prestamo-anses .primary{border:1px solid var(--blue);background:var(--blue);color:#fff;flex:1}.mockup-prestamo-anses .secondary{border:1px solid #ccd6df;background:#fff;color:#47576b}.mockup-prestamo-anses .result{background:linear-gradient(145deg,#174b7a,#287b9b);color:#fff}.mockup-prestamo-anses .result .intro{color:#d8eaf2}.mockup-prestamo-anses .res-top{display:flex;justify-content:space-between;gap:12px}.mockup-prestamo-anses .label{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#c6e3ed;font-weight:900}.mockup-prestamo-anses .amount{font-size:42px;font-weight:950;letter-spacing:-.05em;margin:9px 0}.mockup-prestamo-anses .pill{height:max-content;background:#e5faf3;color:#155e4e;border-radius:99px;padding:8px 10px;font-size:10px;font-weight:900}.mockup-prestamo-anses .summary{font-size:13px;line-height:1.55;color:#eff7f9}.mockup-prestamo-anses .metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:17px}.mockup-prestamo-anses .metric{border:1px solid rgba(255,255,255,.23);background:rgba(255,255,255,.1);border-radius:14px;padding:14px}.mockup-prestamo-anses .metric span{display:block;color:#d3e7ee;font-size:10px}.mockup-prestamo-anses .metric strong{display:block;color:#fff;font-size:18px;margin-top:4px}.mockup-prestamo-anses .progress{height:12px;background:rgba(255,255,255,.18);border-radius:99px;overflow:hidden;margin-top:18px}.mockup-prestamo-anses .progress i{display:block;height:100%;width:68%;background:var(--sun);border-radius:99px;transition:.25s}.mockup-prestamo-anses .note{margin-top:14px;background:#fff2d7;color:#684817;border-radius:12px;padding:11px 13px;font-size:11px;font-weight:750}.mockup-prestamo-anses .support{background:#f1f7f5}.mockup-prestamo-anses .support-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-prestamo-anses .support-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.mockup-prestamo-anses .support-card span{display:inline-block;background:var(--mint2);color:#176d5b;border-radius:8px;padding:5px 7px;font-size:9px;font-weight:900}.mockup-prestamo-anses .support-card h3{font-size:15px;margin:11px 0 6px}.mockup-prestamo-anses .support-card p{font-size:11px;line-height:1.5;color:var(--muted);margin:0}.mockup-prestamo-anses .faq{max-width:850px;margin:auto}.mockup-prestamo-anses .faq-item{border-bottom:1px solid var(--line)}.mockup-prestamo-anses .faq-q{width:100%;border:0;background:transparent;color:var(--ink);display:flex;justify-content:space-between;text-align:left;padding:19px 3px;font-weight:850;cursor:pointer}.mockup-prestamo-anses .faq-a{display:none;color:var(--muted);line-height:1.6;padding:0 35px 18px 3px}.mockup-prestamo-anses .faq-item.open .faq-a{display:block}.mockup-prestamo-anses .footer{height:100px;background:#fff;border-top:1px solid var(--line);display:grid;place-items:center;color:var(--muted);font-size:12px}@media(max-width:900px){.mockup-prestamo-anses .links{display:none}.mockup-prestamo-anses .hero-grid,.mockup-prestamo-anses .calc{grid-template-columns:1fr}.mockup-prestamo-anses .cases{grid-template-columns:1fr 1fr}.mockup-prestamo-anses .support-grid{grid-template-columns:1fr}.mockup-prestamo-anses .hero h1{font-size:43px}}@media(max-width:560px){.mockup-prestamo-anses .shell{padding:0 16px}.mockup-prestamo-anses .hero h1{font-size:35px}.mockup-prestamo-anses .art{display:none}.mockup-prestamo-anses .cases,.mockup-prestamo-anses .fields,.mockup-prestamo-anses .metrics{grid-template-columns:1fr}.mockup-prestamo-anses .panel{padding:21px}.mockup-prestamo-anses .res-top{display:block}.mockup-prestamo-anses .pill{display:inline-block;margin-top:8px}}

.mockup-prestamo-anses { width:100%; overflow:hidden; }
.mockup-prestamo-anses .top, .mockup-prestamo-anses header.top { display:none !important; }
.mockup-prestamo-anses .foot { display:none !important; }
.mockup-prestamo-anses .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-prestamo-anses .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-prestamo-anses .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-prestamo-anses .support-real summary { cursor:pointer; font-weight:750; }
.mockup-prestamo-anses .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-prestamo-anses :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-prestamo-anses input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-prestamo-anses input[type="number"]::-webkit-inner-spin-button, .mockup-prestamo-anses input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-prestamo-anses .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-prestamo-anses support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
