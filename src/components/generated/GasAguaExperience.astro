---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-gas-agua" set:html={`
<section class="hero"><div class="wrap"><div class="crumb">Hogar / Gas y agua</div><div class="hero-grid"><div><div class="eyebrow">Dos servicios, una cuenta clara</div><h1>Entendé qué consumís y qué te cobran.</h1><p class="lead">Estimá gas de red, zona fría, garrafa y consumo de agua. Separá cargos fijos, uso e impuestos para saber dónde vale la pena ahorrar.</p><div class="chips"><span class="chip">✓ Factura bimestral</span><span class="chip">✓ Zona fría</span><span class="chip">✓ Litros y m³</span></div></div><div class="visual"><div class="meter"><span class="needle"></span><span class="dot"></span><strong>m³</strong></div><span class="pipe-gas"></span><span class="pipe-water"></span><div class="bubble"><small>REFERENCIA DE AGUA</small><strong>100 L/persona/día</strong></div></div></div></div></section>
<section class="wrap"><div class="tool"><div class="cases" id="cases"></div><div class="calc"><div class="form"><h2 id="formTitle">Estimá tu factura de gas</h2><p class="hint" id="formHint"></p><div class="fields" id="fields"></div><button class="primary" id="calculate">Actualizar estimación</button></div><div class="result"><div class="caps" id="resultLabel">FACTURA BIMESTRAL ESTIMADA</div><div class="big" id="mainResult">$39.886</div><div class="sub" id="resultText"></div><span class="status" id="status">Equivale a $19.943 por mes</span><div class="rows" id="rows"></div></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">Leé la factura por capas</div><h2>No todo lo que pagás depende del consumo.</h2><p>En un uso moderado, los cargos fijos y los impuestos explican una parte grande del total.</p></div><div class="bill-grid"><article class="bill"><h3>Ejemplo de factura de gas</h3><p>Categoría R2-3 · 200 m³ por bimestre · sin subsidio</p><div class="bar"><span>Gas PIST</span><div class="track"><div class="fill" style="width:47%;background:var(--gas)"></div></div><b>$14.500</b></div><div class="bar"><span>Distribución</span><div class="track"><div class="fill" style="width:53%;background:#e6ad54"></div></div><b>$16.300</b></div><div class="bar"><span>IVA y tasas</span><div class="track"><div class="fill" style="width:30%;background:#88776d"></div></div><b>$9.086</b></div></article><article class="water-card"><div><div class="eyebrow" style="color:#bfe9fa">El agua de tu casa</div><h3>La ducha suele explicar la mitad.</h3><p>Cada minuto menos en cuatro duchas diarias ahorra 1.080 litros por mes. Un cabezal eficiente baja el caudal de 9 a 6 litros por minuto.</p></div><div class="water-stat"><div class="circle"><div><strong>100 L</strong><span>POR PERSONA<br>POR DÍA</span></div></div></div></article></div></div></section>
<section class="alerts"><div class="wrap alerts-grid"><div><div class="eyebrow">Antes de culpar a la tarifa</div><h2>Cuatro señales para revisar.</h2><p>Una lectura estimada o una fuga puede explicar una suba mejor que el precio unitario.</p></div><div class="checks"><div class="check"><span class="mark">1</span><b>Lectura real o estimada</b><span>Compará los números del medidor con los de la boleta.</span></div><div class="check"><span class="mark">2</span><b>Cambio de categoría</b><span>Un invierno alto puede subirte de R2 a R3.</span></div><div class="check"><span class="mark">3</span><b>Medidor de agua en movimiento</b><span>Con todo cerrado, indica una fuga interna.</span></div><div class="check"><span class="mark">4</span><b>Inodoro perdiendo</b><span>Puede desperdiciar más de 200 litros por día.</span></div></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-gas-agua')?document.currentScript.previousElementSibling:document.querySelector('.mockup-gas-agua');

const table={R11:[2800,28,3200,32],R12:[3100,31,3500,35],R13:[3400,34,3900,38],R21:[3800,38,4400,43],R22:[4200,43,4900,48],R23:[4700,49,5500,54],R31:[5400,57,6300,62],R32:[6100,65,7100,70],R34:[7200,76,8400,82]};
const configs=[
{id:"gas",icon:"◐",title:"Factura de gas",desc:"Red natural · bimestre",form:"Estimá tu factura de gas",hint:"Sumamos cargos fijos, consumo, distribución e impuestos.",label:"FACTURA BIMESTRAL ESTIMADA",fields:[["m3","Consumo del bimestre","number",200],["cat","Categoría","select","R23",Object.keys(table)],["sub","Subsidio","select","Sin subsidio",["Sin subsidio","Bonificación 40%","Bonificación 55%"]],["zone","Distribuidora","select","AMBA",["AMBA","Litoral / interior"]]],calc:v=>{let t=table[v.cat],fd=v.zone==="AMBA"?1:1.08,discount={"Sin subsidio":0,"Bonificación 40%":.4,"Bonificación 55%":.55}[v.sub],gas=t[0]+t[1]*+v.m3,dist=(t[2]+t[3]*+v.m3)*fd,net=(gas+dist)*(1-discount),tax=net*.295,total=net+tax;return R("$"+Math.round(total).toLocaleString("es-AR"),`${v.m3} m³ · categoría ${v.cat} · ${v.sub.toLowerCase()}.`,`Equivale a $${Math.round(total/2).toLocaleString("es-AR")} por mes`,[["Gas (fijo + consumo)","$"+Math.round(gas).toLocaleString("es-AR")],["Distribución","$"+Math.round(dist).toLocaleString("es-AR")],["IVA y tasas","$"+Math.round(tax).toLocaleString("es-AR")],["Precio efectivo por m³","$"+(total/+v.m3).toFixed(2).replace(".",",")]])}},
{id:"cold",icon:"❄",title:"Zona fría",desc:"Bonificación 30% o 50%",form:"Calculá tu bonificación de zona fría",hint:"El régimen se suma al subsidio general si corresponde.",label:"TOTAL CON ZONA FRÍA",fields:[["m3","Consumo del bimestre","number",200],["cat","Categoría","select","R23",Object.keys(table)],["coldPct","Beneficio de zona fría","select","30%",["30%","50%","No corresponde"]],["sub","Subsidio general","select","Sin subsidio",["Sin subsidio","Bonificación 40%","Bonificación 55%"]]],calc:v=>{let t=table[v.cat],base=t[0]+t[1]*+v.m3+t[2]+t[3]*+v.m3,sd={"Sin subsidio":0,"Bonificación 40%":.4,"Bonificación 55%":.55}[v.sub],zf={"30%":.3,"50%":.5,"No corresponde":0}[v.coldPct],without=base*(1-sd)*1.295,total=without*(1-zf),save=without-total;return R("$"+Math.round(total).toLocaleString("es-AR"),zf?`La zona fría reduce ${v.coldPct} sobre la tarifa ya subsidiada.`:"No se aplicó bonificación de zona fría.",zf?`Ahorrás $${Math.round(save).toLocaleString("es-AR")} por bimestre`:"Tarifa completa",[["Sin zona fría","$"+Math.round(without).toLocaleString("es-AR")],["Bonificación","$"+Math.round(save).toLocaleString("es-AR")],["Descuento efectivo",Math.round((1-(1-sd)*(1-zf))*100)+"%"],["Total por mes","$"+Math.round(total/2).toLocaleString("es-AR")]])}},
{id:"bottle",icon:"▰",title:"Garrafa",desc:"Duración y costo mensual",form:"¿Cuánto te dura la garrafa?",hint:"Usamos tu envase, el uso real y el precio que pagás.",label:"DURACIÓN ESTIMADA",fields:[["people","Personas en la casa","number",3],["size","Envase","select","10 kg",["10 kg","15 kg","45 kg"]],["use","Uso","select","Cocina y calefón",["Sólo cocina","Cocina y calefón","Cocina y estufa"]],["price","Precio del envase","number",12000]],calc:v=>{let kg=parseInt(v.size),base={"Sólo cocina":6,"Cocina y calefón":12,"Cocina y estufa":18}[v.use],monthly=base*(+v.people/3),days=kg/monthly*30,units=monthly/kg,cost=units*+v.price;return R(Math.round(days)+" días",`Una garrafa de ${v.size} con este uso dura aproximadamente ${Math.round(days)} días.`,`Costo mensual: $${Math.round(cost).toLocaleString("es-AR")}`,[["Consumo mensual",monthly.toFixed(1).replace(".",",")+" kg"],["Envases por mes",units.toFixed(2).replace(".",",")],["Precio por envase","$"+(+v.price).toLocaleString("es-AR")],["Costo mensual","$"+Math.round(cost).toLocaleString("es-AR")]])}},
{id:"water",icon:"●",title:"Consumo de agua",desc:"Litros, m³ y ahorro",form:"¿Cuánta agua usa tu casa?",hint:"Sumamos duchas, inodoro, cocina, lavarropas y otros usos.",label:"CONSUMO MENSUAL ESTIMADO",fields:[["people","Personas","number",4],["showers","Duchas por día","number",4],["minutes","Minutos por ducha","number",8],["washes","Lavados por semana","number",3],["priceM3","Valor del m³ medido","number",200]],calc:v=>{let p=+v.people,day=+v.showers*+v.minutes*9+p*5*8+p*12+(+v.washes*60/7)+p*8,month=day*30,m3=month/1000,cost=m3*+v.priceM3,efficient=(+v.showers*(+v.minutes*.5)*6+p*5*6+(p*12+(+v.washes*60/7)+p*8)*.75)*30,save=month-efficient;return R(Math.round(month).toLocaleString("es-AR")+" litros",`${m3.toFixed(1).replace(".",",")} m³ por mes · ${Math.round(day/p)} litros por persona por día.`,`Podrías ahorrar ${Math.round(save).toLocaleString("es-AR")} L/mes`,[["Duchas",Math.round(+v.showers*+v.minutes*9*30).toLocaleString("es-AR")+" L"],["Otros usos",Math.round(month-+v.showers*+v.minutes*9*30).toLocaleString("es-AR")+" L"],["Costo si tenés medidor","$"+Math.round(cost).toLocaleString("es-AR")],["Escenario eficiente",Math.round(efficient).toLocaleString("es-AR")+" L"]])}}
];let active="gas";const $=id=>root.querySelector("#"+id),R=(value,text,status,rows)=>({value,text,status,rows});function current(){return configs.find(x=>x.id===active)}
function drawCases(){$("cases").innerHTML=configs.map(x=>`<button class="case ${x.id===active?"active":""}" data-id="${x.id}"><div class="ico">${x.icon}</div><b>${x.title}</b><span>${x.desc}</span></button>`).join("");root.querySelectorAll(".case").forEach(b=>b.onclick=()=>{active=b.dataset.id;render()})}
function drawFields(m){$("fields").innerHTML=m.fields.map(f=>{let[id,label,type,val,opts]=f;return type==="select"?`<div class="field"><label for="${id}">${label}</label><select id="${id}">${opts.map(o=>`<option ${o===val?"selected":""}>${o}</option>`).join("")}</select></div>`:`<div class="field"><label for="${id}">${label}</label><input id="${id}" type="number" step="any" value="${val}"></div>`}).join("");$("fields").querySelectorAll("input,select").forEach(x=>x.addEventListener("input",compute))}
function compute(){let m=current(),v=Object.fromEntries(m.fields.map(f=>[f[0],$(f[0]).value])),r=m.calc(v);$("mainResult").textContent=r.value;$("resultText").textContent=r.text;$("status").textContent=r.status;$("rows").innerHTML=r.rows.map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
function render(){drawCases();let m=current();$("formTitle").textContent=m.form;$("formHint").textContent=m.hint;$("resultLabel").textContent=m.label;drawFields(m);compute()}$("calculate").onclick=()=>{compute();let b=$("calculate"),old=b.textContent;b.textContent="✓ Estimación actualizada";setTimeout(()=>b.textContent=old,1300)};render();

})();
</script>
<style is:global>

.mockup-gas-agua{--ink:#122033;--muted:#687386;--paper:#f4f7f6;--card:#fff;--navy:#174B7A;--water:#247eb5;--water2:#e4f3fb;--gas:#e9823b;--gas2:#fff0e5;--teal:#288978;--line:#dce3e6}
.mockup-gas-agua *{box-sizing:border-box}.mockup-gas-agua [hidden]{display:none!important}.mockup-gas-agua{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-gas-agua button,.mockup-gas-agua input,.mockup-gas-agua select{font:inherit}.mockup-gas-agua .wrap{max-width:1180px;margin:auto;padding:0 28px}
.mockup-gas-agua header{height:84px;background:#fff;border-bottom:1px solid var(--line)}.mockup-gas-agua header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-gas-agua .brand{display:flex;align-items:center;gap:12px;font-weight:850;font-size:20px}.mockup-gas-agua .logo{width:35px;height:35px;border-radius:8px;background:var(--navy);display:grid;place-items:center;color:#fff;font-size:14px}.mockup-gas-agua .nav{display:flex;gap:26px;color:#4d5869;font-weight:700;font-size:14px}.mockup-gas-agua .actions{margin-left:auto;display:flex;gap:10px}.mockup-gas-agua .ghost{border:1px solid var(--line);background:#fff;padding:11px 15px;border-radius:12px;font-weight:750;color:var(--ink)}
.mockup-gas-agua .hero{padding:58px 0 50px;background:linear-gradient(115deg,#fff8f3 0 50%,#f2faff 50%)}.mockup-gas-agua .crumb{color:#3476c2;font-size:14px;margin-bottom:20px}.mockup-gas-agua .hero-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:65px;align-items:center}.mockup-gas-agua .eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.16em;font-weight:900;color:var(--teal)}.mockup-gas-agua h1{font-size:56px;line-height:1.02;letter-spacing:-.05em;margin:14px 0 19px}.mockup-gas-agua .lead{font-size:19px;color:var(--muted);max-width:670px}.mockup-gas-agua .chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.mockup-gas-agua .chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 13px;font-size:13px;font-weight:780}
.mockup-gas-agua .visual{height:350px;position:relative}.mockup-gas-agua .meter{position:absolute;left:64px;top:24px;width:245px;height:245px;border-radius:50%;background:#fff;border:20px solid #e9eef0;box-shadow:0 25px 50px #27425d1a;display:grid;place-items:center}.mockup-gas-agua .meter:before{content:"";position:absolute;inset:27px;border:3px solid #dce4e8;border-radius:50%}.mockup-gas-agua .needle{position:absolute;width:83px;height:5px;background:var(--navy);left:50%;top:50%;transform-origin:left center;transform:rotate(-38deg);border-radius:4px}.mockup-gas-agua .dot{position:absolute;width:17px;height:17px;border-radius:50%;background:var(--navy)}.mockup-gas-agua .meter strong{position:absolute;bottom:42px;font-size:19px}.mockup-gas-agua .pipe-gas,.mockup-gas-agua .pipe-water{position:absolute;width:118px;height:42px;border-radius:22px;right:8px}.mockup-gas-agua .pipe-gas{top:72px;background:var(--gas)}.mockup-gas-agua .pipe-water{top:132px;background:var(--water)}.mockup-gas-agua .pipe-gas:after,.mockup-gas-agua .pipe-water:after{content:"";position:absolute;width:46px;height:46px;border-radius:50%;right:-10px;top:-2px;background:inherit;border:7px solid #fff}.mockup-gas-agua .bubble{position:absolute;right:3px;bottom:22px;background:#fff;border-radius:16px;padding:15px 18px;box-shadow:0 15px 35px #26435b1d}.mockup-gas-agua .bubble small{display:block;color:var(--muted);font-size:10px;font-weight:900;letter-spacing:.1em}.mockup-gas-agua .bubble strong{font-size:25px}
.mockup-gas-agua .tool{background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden;box-shadow:0 20px 55px #253c5010;margin-bottom:70px}.mockup-gas-agua .cases{padding:22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.mockup-gas-agua .case{min-height:86px;text-align:left;border:1px solid var(--line);background:#fbfcfc;border-radius:14px;padding:14px;cursor:pointer;color:var(--ink)}.mockup-gas-agua .case b{display:block;font-size:14px;margin:3px 0}.mockup-gas-agua .case span{font-size:11px;color:var(--muted)}.mockup-gas-agua .case.active{border:2px solid var(--water);background:#eef7fc;padding:13px}.mockup-gas-agua .ico{font-size:18px}
.mockup-gas-agua .calc{display:grid;grid-template-columns:.94fr 1.06fr}.mockup-gas-agua .form{padding:31px}.mockup-gas-agua .form h2{font-size:26px;letter-spacing:-.03em;margin:0 0 7px}.mockup-gas-agua .hint{color:var(--muted);margin:0 0 23px}.mockup-gas-agua .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-gas-agua .field{display:flex;flex-direction:column;gap:7px}.mockup-gas-agua .field.full{grid-column:1/-1}.mockup-gas-agua .field label{font-size:13px;font-weight:800}.mockup-gas-agua .field input,.mockup-gas-agua .field select{border:1px solid #ccd5db;border-radius:12px;background:#fff;padding:14px;outline:none;color:var(--ink)}.mockup-gas-agua .field input:focus,.mockup-gas-agua .field select:focus{border-color:var(--water);box-shadow:0 0 0 3px #247eb51a}.mockup-gas-agua .primary{width:100%;border:0;border-radius:13px;padding:15px;background:var(--water);color:#fff;font-weight:850;margin-top:20px;cursor:pointer}
.mockup-gas-agua .result{background:var(--navy);color:#fff;padding:31px;position:relative;overflow:hidden}.mockup-gas-agua .result:after{content:"";position:absolute;width:270px;height:270px;border-radius:50%;border:48px solid #ffffff08;right:-155px;bottom:-150px}.mockup-gas-agua .caps{color:#a6d7e2;font-size:10px;font-weight:900;letter-spacing:.13em}.mockup-gas-agua .big{font-size:46px;line-height:1.05;letter-spacing:-.045em;font-weight:920;margin:15px 0 7px}.mockup-gas-agua .sub{color:#d3dfeb;min-height:48px}.mockup-gas-agua .status{display:inline-block;background:#dff3e9;color:#176449;border-radius:99px;padding:8px 12px;font-size:13px;font-weight:850;margin:12px 0 22px}.mockup-gas-agua .rows{border-top:1px solid #ffffff24}.mockup-gas-agua .row{display:flex;justify-content:space-between;gap:20px;padding:13px 0;border-bottom:1px solid #ffffff1b;color:#d5deea}.mockup-gas-agua .row strong{color:#fff;text-align:right}
.mockup-gas-agua .section{padding:10px 0 68px}.mockup-gas-agua .section-head{text-align:center;max-width:720px;margin:0 auto 30px}.mockup-gas-agua .section-head h2{font-size:39px;letter-spacing:-.04em;margin:8px 0}.mockup-gas-agua .section-head p{color:var(--muted)}.mockup-gas-agua .bill-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:16px}.mockup-gas-agua .bill{background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px}.mockup-gas-agua .bill h3{margin:0 0 4px}.mockup-gas-agua .bill>p{color:var(--muted);font-size:13px;margin:0 0 23px}.mockup-gas-agua .bar{display:grid;grid-template-columns:110px 1fr 65px;align-items:center;gap:10px;margin:15px 0;font-size:13px}.mockup-gas-agua .track{height:10px;background:#edf0f2;border-radius:99px;overflow:hidden}.mockup-gas-agua .fill{height:100%;border-radius:99px}.mockup-gas-agua .bar b{text-align:right}.mockup-gas-agua .water-card{background:linear-gradient(145deg,#1f74ac,#2695c5);color:#fff;border-radius:20px;padding:24px;display:grid;grid-template-columns:1fr .8fr;gap:28px}.mockup-gas-agua .water-card h3{font-size:27px;margin:0 0 8px}.mockup-gas-agua .water-card p{color:#d8edf7}.mockup-gas-agua .water-stat{display:grid;place-items:center}.mockup-gas-agua .circle{width:175px;height:175px;border-radius:50%;border:18px solid #ffffff30;display:grid;place-items:center;text-align:center}.mockup-gas-agua .circle strong{font-size:31px;display:block}.mockup-gas-agua .circle span{font-size:11px;color:#d8edf7}
.mockup-gas-agua .alerts{background:#e9efec;padding:67px 0}.mockup-gas-agua .alerts-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:65px}.mockup-gas-agua .alerts h2{font-size:40px;line-height:1.08;margin:10px 0}.mockup-gas-agua .alerts p{color:var(--muted)}.mockup-gas-agua .checks{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-gas-agua .check{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px}.mockup-gas-agua .check .mark{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;background:var(--gas2);color:var(--gas);font-weight:900;margin-bottom:12px}.mockup-gas-agua .check b{display:block;margin-bottom:5px}.mockup-gas-agua .check span{font-size:13px;color:var(--muted)}
.mockup-gas-agua footer{background:#fff;border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:13px}
@media(max-width:850px){.mockup-gas-agua .nav{display:none}.mockup-gas-agua .hero-grid,.mockup-gas-agua .calc,.mockup-gas-agua .bill-grid,.mockup-gas-agua .alerts-grid{grid-template-columns:1fr}.mockup-gas-agua .cases{display:flex;overflow:auto}.mockup-gas-agua .case{min-width:190px}.mockup-gas-agua .visual{height:290px}.mockup-gas-agua .checks{grid-template-columns:1fr 1fr}.mockup-gas-agua h1{font-size:45px}}@media(max-width:540px){.mockup-gas-agua .wrap{padding:0 18px}.mockup-gas-agua .hero{padding-top:35px;background:#f7fbfd}.mockup-gas-agua .visual{display:none}.mockup-gas-agua h1{font-size:39px}.mockup-gas-agua .fields,.mockup-gas-agua .checks{grid-template-columns:1fr}.mockup-gas-agua .field.full{grid-column:auto}.mockup-gas-agua .water-card{grid-template-columns:1fr}.mockup-gas-agua .tool{border-radius:18px}.mockup-gas-agua .form,.mockup-gas-agua .result{padding:25px 20px}}

.mockup-gas-agua { width:100%; overflow:hidden; }
.mockup-gas-agua .top, .mockup-gas-agua header.top { display:none !important; }
.mockup-gas-agua .foot { display:none !important; }
.mockup-gas-agua .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-gas-agua .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-gas-agua .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-gas-agua .support-real summary { cursor:pointer; font-weight:750; }
.mockup-gas-agua .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-gas-agua :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-gas-agua input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-gas-agua input[type="number"]::-webkit-inner-spin-button, .mockup-gas-agua input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-gas-agua .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-gas-agua support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
