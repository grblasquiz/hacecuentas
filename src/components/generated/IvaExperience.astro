.mockup-iva .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-iva .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-iva .support-real summary { cursor:pointer; font-weight:750; }
.mockup-iva .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
