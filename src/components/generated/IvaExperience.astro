d #d7dfe7;background:white;border-radius:99px;padding:8px 11px;font-size:12px;font-weight:800;color:#45536a}.mockup-iva .receipt{background:var(--navy);color:white;border-radius:26px;padding:30px;box-shadow:0 24px 55px rgba(24,51,82,.19);position:relative;overflow:hidden}.mockup-iva .receipt:after{content:"";position:absolute;width:190px;height:190px;border:44px solid rgba(255,255,255,.035);border-radius:50%;right:-88px;top:-90px}.mockup-iva .receipt-top{display:flex;justify-content:space-between;position:relative;z-index:1}.mockup-iva .receipt small{font-size:10px;letter-spacing:.13em;color:#b9cce0;font-weight:900}.mockup-iva .badge{background:#dff4ea;color:#11634e;padding:7px 10px;border-radius:99px;font-size:10px;font-weight:950}.mockup-iva .ticket{position:relative;z-index:1;background:white;color:var(--ink);border-radius:17px;padding:21px;margin-top:18px}.mockup-iva .ticket-row{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px dashed #d7dce3;font-size:13px}.mockup-iva .ticket-row:last-child{border:0;font-size:18px;font-weight:950}.mockup-iva .ticket-row span{color:#68758a}.mockup-iva .ticket-row strong.teal{color:var(--teal)}.mockup-iva .formula{position:relative;z-index:1;margin-top:17px;display:flex;align-items:center;gap:11px;color:#dbe8f3;font-size:13px}.mockup-iva .formula b{color:white;font-size:17px}.mockup-iva .calc{padding:78px 0;background:white}.mockup-iva .section-head{display:flex;justify-content:space-between;gap:40px;align-items:end;margin-bottom:27px}.mockup-iva .section-head h2{font-size:38px;letter-spacing:-.04em;margin:8px 0 0}.mockup-iva .section-head p{max-width:470px;color:var(--muted);line-height:1.55;margin:0}.mockup-iva .work{display:grid;grid-template-columns:1.04fr .96fr;gap:20px}.mockup-iva .panel{border:1px solid var(--line);border-radius:23px;padding:28px;background:white}.mockup-iva .cases{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mockup-iva .case{min-height:87px;border:1px solid #d7dde6;border-radius:14px;background:#fafbfc;text-align:left;padding:14px;display:flex;gap:12px;align-items:flex-start;cursor:pointer;color:var(--ink)}.mockup-iva .case:hover{border-color:#8aaee2}.mockup-iva .case.active{border:2px solid var(--blue);background:#f0f6ff;padding:13px}.mockup-iva .case-num{width:31px;height:31px;border-radius:9px;background:#e9eef5;color:#465a75;display:grid;place-items:center;flex:none;font-size:11px;font-weight:950}.mockup-iva .case.active .case-num{background:var(--blue);color:white}.mockup-iva .case strong{display:block;font-size:13px;margin:2px 0 4px}.mockup-iva .case span{display:block;font-size:11px;color:#6b778a;line-height:1.35}.mockup-iva .case-note{background:#eef8f6;color:#315e59;border-radius:13px;padding:14px 16px;margin:18px 0;font-size:13px;line-height:1.5}.mockup-iva .fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-iva .field label{display:block;font-size:11px;font-weight:900;color:#5a667b;margin-bottom:8px;text-transform:uppercase;letter-spacing:.03em}.mockup-iva .input{height:52px;border:1px solid #cfd6df;border-radius:12px;background:white;display:flex;align-items:center;overflow:hidden}.mockup-iva .input:focus-within{border-color:var(--blue);box-shadow:0 0 0 3px #e6f0ff}.mockup-iva .input span{padding-left:14px;color:#6a778b;font-weight:800}.mockup-iva .input input,.mockup-iva .input select{border:0;outline:0;width:100%;height:100%;padding:0 13px;background:transparent;color:var(--ink);font-weight:850}.mockup-iva .input select{cursor:pointer}.mockup-iva .hidden{display:none!important}.mockup-iva .actions{display:flex;gap:10px;margin-top:20px}.mockup-iva .primary,.mockup-iva .secondary{height:48px;border-radius:12px;padding:0 19px;font-weight:900;cursor:pointer}.mockup-iva .primary{background:var(--blue);color:white;border:0;flex:1}.mockup-iva .secondary{background:white;color:#495770;border:1px solid #ccd5df}.mockup-iva .error{display:none;margin-top:12px;border-radius:10px;background:#fff0ed;color:var(--red);