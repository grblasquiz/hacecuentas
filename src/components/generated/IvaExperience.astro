---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-iva" set:html={`
<section class="hero"><div class="wrap"><div class="crumb"><b>Impuestos</b> / IVA</div><div class="hero-grid"><div><span class="eyebrow">IVA · Argentina · Ley 23.349</span><h1>El IVA no se resta. Se discrimina.</h1><p class="lede">Pasá de precio final a neto —o de neto a precio final— sin confundir la base. Vas a ver cuánto es impuesto, qué fórmula usamos y por qué la cuenta cierra.</p><div class="chips"><span class="chip">21% general</span><span class="chip">10,5% reducida</span><span class="chip">27% servicios a RI</span><span class="chip">Comparación regional</span></div></div><aside class="receipt"><div class="receipt-top"><small>FACTURA · EJEMPLO</small><span class="badge">CUENTA CORRECTA</span></div><div class="ticket"><div class="ticket-row"><span>Precio neto</span><strong>$100.000</strong></div><div class="ticket-row"><span>IVA 21%</span><strong class="teal">$21.000</strong></div><div class="ticket-row"><span>Total</span><strong>$121.000</strong></div></div><div class="formula"><span>Precio final</span><b>÷ 1,21</b><span>= neto gravado</span></div></aside></div></div></section>
<section class="calc"><div class="wrap"><div class="section-head"><div><span class="eyebrow">Calculadora interactiva</span><h2>¿Qué necesitás hacer?</h2></div><p>Todos los casos quedan visibles. Al elegir uno, mostramos únicamente los datos que intervienen en esa cuenta.</p></div><div class="work"><article class="panel"><div class="cases">
<button class="case active" data-case="sacar"><span class="case-num">÷</span><span><strong>Sacar IVA del precio final</strong><span>Ya tenés el total con impuesto</span></span></button>
<button class="case" data-case="agregar"><span class="case-num">+</span><span><strong>Agregar IVA al neto</strong><span>Querés formar el precio final</span></span></button>
<button class="case" data-case="reducida"><span class="case-num">10,5</span><span><strong>Alícuota reducida</strong><span>Discriminar con tasa fija</span></span></button>
<button class="case" data-case="paises"><span class="case-num">%</span><span><strong>Comparar por país</strong><span>Elegí el impuesto local</span></span></button>
</div><div class="case-note" id="caseNote"><b>Precio final:</b> lo dividimos por 1,21. El IVA contenido es la diferencia, no el 21% del total.</div><div class="fields"><div class="field"><label id="amountLabel" for="amount">Precio final con IVA</label><div class="input"><span>$</span><input id="amount" value="121000" inputmode="decimal"><span id="currency">ARS</span></div></div><div class="field" id="fieldRate"><label for="rate">Alícuota</label><div class="input"><select id="rate"><option value="21">21% — general</option><option value="10.5">10,5% — reducida</option><option value="27">27% — servicios públicos a RI</option><option value="2.5">2,5% — diarios y revistas</option></select></div></div><div class="field hidden" id="fieldCountry"><label for="country">País</label><div class="input"><select id="country"><option value="argentina">Argentina — IVA 21%</option><option value="uruguay">Uruguay — IVA 22%</option><option value="colombia">Colombia — IVA 19%</option><option value="chile">Chile — IVA 19%</option><option value="peru">Perú — IGV 18%</option><option value="dominicana">Rep. Dominicana — ITBIS 18%</option><option value="brasil">Brasil — ICMS 17%</option><option value="mexico">México — IVA 16%</option><option value="mexico-frontera">México frontera — IVA 8%</option><option value="ecuador">Ecuador — IVA 15%</option><option value="paraguay">Paraguay — IVA 10%</option><option value="panama">Panamá — ITBMS 7%</option></select></div></div></div><div class="actions"><button class="primary" id="calculate">Actualizar cálculo</button><button class="secondary" id="reset">Restablecer</button></div><div class="error" id="error"></div></article>
<article class="panel result"><div class="result-head"><small id="resultTop">IVA CONTENIDO</small><span class="pill" id="pill">21% GENERAL</span></div><div class="result-value" id="taxValue">$21.000</div><div class="result-label" id="resultLabel">de un precio final de $121.000</div><div class="bar"><span class="bar-net" id="netBar" style="width:82.64%"></span><span class="bar-tax" id="taxBar" style="width:17.36%"></span></div><div class="legend"><span><i style="background:#52c6b4"></i>Neto</span><span><i style="background:var(--amber)"></i>Impuesto</span></div><div class="result-rows"><div class="rrow"><span>Precio neto</span><strong id="netValue">$100.000</strong></div><div class="rrow"><span id="taxRowLabel">IVA 21%</span><strong id="taxRow">$21.000</strong></div><div class="rrow"><span>Precio final</span><strong id="totalValue">$121.000</strong></div><div class="rrow"><span>Impuesto dentro del total</span><strong id="shareValue">17,3554%</strong></div></div><div class="mistake" id="mistake"><strong>Si restaras 21%, te daría $95.590.</strong>Ese neto es incorrecto: queda $4.410 por debajo del valor real.</div></article></div></div></section>
<section class="compare"><div class="wrap"><span class="eyebrow">Una misma cuenta, distintas tasas</span><div class="section-head"><h2>Qué cambia según la alícuota</h2><p>Sobre un precio final de $121.000, el porcentaje contenido siempre es menor que la tasa aplicada sobre el neto.</p></div><div class="compare-grid"><article class="rate-card"><small>REDUCIDA</small><h3>Alimentos y otros</h3><strong>10,5%</strong><p>El impuesto representa 9,5023% del precio final.</p></article><article class="rate-card"><small>GENERAL</small><h3>Mayoría de operaciones</h3><strong>21%</strong><p>El impuesto representa 17,3554% del precio final.</p></article><article class="rate-card"><small>INCREMENTADA</small><h3>Servicios a RI</h3><strong>27%</strong><p>El impuesto representa 21,2598% del precio final.</p></article><article class="rate-card"><small>EXENTO</small><h3>Sin débito fiscal</h3><strong>0%</strong><p>No es lo mismo que una operación no gravada.</p></article></div></div></section>
<section class="steps"><div class="wrap"><span class="eyebrow">Para no equivocarte</span><div class="section-head"><h2>Tres preguntas antes de calcular</h2><p>La fórmula es simple. Lo importante es identificar bien qué monto tenés y qué tasa corresponde.</p></div><div class="step-grid"><article class="step"><b>1</b><h3>¿El monto ya incluye IVA?</h3><p>Si es precio final, dividí por 1 + alícuota. Si es neto, multiplicá por ese mismo factor.</p></article><article class="step"><b>2</b><h3>¿Qué alícuota tiene el bien?</h3><p>La tasa depende de la operación. Un mismo comercio puede facturar productos al 21% y al 10,5%.</p></article><article class="step"><b>3</b><h3>¿Hay percepciones aparte?</h3><p>No las mezcles con el IVA discriminado. Son pagos a cuenta y deben aparecer en renglones separados.</p></article></div></div></section>
<section class="faq"><div class="wrap faq-wrap"><span class="eyebrow">Preguntas frecuentes</span><h2>Lo que más confunde del IVA</h2><div class="faq-item open"><button class="faq-q">¿Por qué no puedo restar el 21%?<span>−</span></button><div class="faq-a">Porque el 21% se calcula sobre el neto, no sobre el precio final. Si el total es $121.000, el neto correcto es $121.000 ÷ 1,21 = $100.000.</div></div><div class="faq-item"><button class="faq-q">¿El IVA de mis compras se pierde?<span>+</span></button><div class="faq-a">Si sos responsable inscripto y la compra está vinculada a tu actividad, normalmente se computa como crédito fiscal contra el IVA de tus ventas.</div></div><div class="faq-item"><button class="faq-q">¿Exento y tasa cero son lo mismo?<span>+</span></button><div class="faq-a">No. En una operación exenta normalmente no computás el crédito fiscal asociado; la tasa cero puede conservar ese crédito, como ocurre con exportaciones.</div></div></div></section>
<button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-iva')?document.currentScript.previousElementSibling:document.querySelector('.mockup-iva');

const $=id=>root.querySelector("#"+id),money=(n,c="ARS")=>new Intl.NumberFormat("es-AR",{style:"currency",currency:c,maximumFractionDigits:0}).format(n),pct=n=>n.toLocaleString("es-AR",{minimumFractionDigits:4,maximumFractionDigits:4})+"%";
const countries={argentina:{name:"Argentina",rate:21,tax:"IVA",currency:"ARS"},uruguay:{name:"Uruguay",rate:22,tax:"IVA",currency:"UYU"},colombia:{name:"Colombia",rate:19,tax:"IVA",currency:"COP"},chile:{name:"Chile",rate:19,tax:"IVA",currency:"CLP"},peru:{name:"Perú",rate:18,tax:"IGV",currency:"PEN"},dominicana:{name:"Rep. Dominicana",rate:18,tax:"ITBIS",currency:"DOP"},brasil:{name:"Brasil",rate:17,tax:"ICMS",currency:"BRL"},mexico:{name:"México",rate:16,tax:"IVA",currency:"MXN"},"mexico-frontera":{name:"México frontera",rate:8,tax:"IVA",currency:"MXN"},ecuador:{name:"Ecuador",rate:15,tax:"IVA",currency:"USD"},paraguay:{name:"Paraguay",rate:10,tax:"IVA",currency:"PYG"},panama:{name:"Panamá",rate:7,tax:"ITBMS",currency:"USD"}};
let current="sacar";
const configs={sacar:{note:"<b>Precio final:</b> lo dividimos por 1,21. El IVA contenido es la diferencia, no el 21% del total.",label:"Precio final con IVA"},agregar:{note:"<b>Precio neto:</b> el IVA sí se calcula multiplicando la base por la alícuota.",label:"Precio neto sin IVA"},reducida:{note:"<b>Alícuota reducida:</b> el precio final se divide por 1,105. La tasa queda fija en 10,5%.",label:"Precio final con IVA 10,5%"},paises:{note:"<b>Comparación regional:</b> elegí el país y aplicamos el nombre, la moneda y la tasa general local.",label:"Precio final con impuesto"}};
function setCase(k){current=k;root.querySelectorAll(".case").forEach(b=>b.classList.toggle("active",b.dataset.case===k));$("caseNote").innerHTML=configs[k].note;$("amountLabel").textContent=configs[k].label;$("fieldCountry").classList.toggle("hidden",k!=="paises");$("fieldRate").classList.toggle("hidden",k==="paises"||k==="reducida");compute()}
function compute(){const amount=Number(String($("amount").value).replace(/\./g,"").replace(",","."));if(!Number.isFinite(amount)||amount<=0){$("error").style.display="block";$("error").textContent="Ingresá un monto mayor que cero.";return}$("error").style.display="none";let rate=Number($("rate").value),taxName="IVA",currency="ARS",place="Argentina";if(current==="reducida")rate=10.5;if(current==="paises"){const c=countries[$("country").value];rate=c.rate;taxName=c.tax;currency=c.currency;place=c.name}let net,tax,total;if(current==="agregar"){net=amount;tax=net*rate/100;total=net+tax}else{total=amount;net=total/(1+rate/100);tax=total-net}const share=tax/total*100;$("currency").textContent=currency;$("taxValue").textContent=money(tax,currency);$("resultTop").textContent=current==="agregar"?"IVA A AGREGAR":taxName+" CONTENIDO";$("resultLabel").textContent=(current==="agregar"?"sobre un precio neto de ":"de un precio final de ")+money(amount,currency);$("pill").textContent=place.toUpperCase()+" · "+String(rate).replace(".",",")+"%";$("netValue").textContent=money(net,currency);$("taxRowLabel").textContent=taxName+" "+String(rate).replace(".",",")+"%";$("taxRow").textContent=money(tax,currency);$("totalValue").textContent=money(total,currency);$("shareValue").textContent=pct(share);$("netBar").style.width=(100-share)+"%";$("taxBar").style.width=share+"%";const wrong=total*(1-rate/100),diff=net-wrong;$("mistake").classList.toggle("hidden",current==="agregar");$("mistake").innerHTML="<strong>Si restaras "+String(rate).replace('.',',')+"%, te daría "+money(wrong,currency)+".</strong>Ese neto es incorrecto: queda "+money(Math.abs(diff),currency)+" por debajo del valor real."}
root.querySelectorAll(".case").forEach(b=>b.onclick=()=>setCase(b.dataset.case));$("calculate").onclick=()=>{compute();$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1200)};$("reset").onclick=()=>{$("amount").value="121000";$("rate").value="21";$("country").value="argentina";setCase("sacar")};$("rate").onchange=compute;$("country").onchange=compute;$("amount").addEventListener("keydown",e=>{if(e.key==="Enter")compute()});root.querySelectorAll(".faq-q").forEach(q=>q.onclick=()=>{const item=q.parentElement;item.classList.toggle("open");q.lastElementChild.textContent=item.classList.contains("open")?"−":"+"});compute();

})();
</script>
<style is:global>

