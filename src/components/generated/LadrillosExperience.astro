---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-ladrillos" set:html={`<div class="wrap hero"><div><div class="crumb">Construcción / Ladrillos</div><div class="eyebrow">Comprá lo justo, construí sin pausas</div><h1>Contá paredes, no viajes al corralón.</h1><p class="lead">Calculá piezas, mezcla, arena y desperdicio descontando puertas y ventanas antes de comprar.</p><div class="chips"><span class="chip">✓ Aberturas descontadas</span><span class="chip">✓ Rotura incluida</span><span class="chip">✓ Lista de compra</span></div></div><div class="visual"><div class="wall" id="wallBricks"></div><div class="opening"></div><div class="trowel"></div><div class="badge-visual"><small>PARA COMPRAR</small><b id="heroPieces">1.733 ladrillos</b></div></div></div>
<div class="wrap"><form class="calc" id="calculator"><div class="case-label">¿QUÉ VAS A CONSTRUIR?</div><div class="cases"><button type="button" class="case active" data-mode="brick"><span>▦</span>Pared de ladrillos</button><button type="button" class="case" data-mode="block"><span>▤</span>Pared de bloques</button><button type="button" class="case" data-mode="fence"><span></span>Cerco de alambre</button><button type="button" class="case" data-mode="pavers"><span>▧</span>Piso de adoquines</button></div>
<div class="grid"><div class="panel"><h2 id="formTitle">Medí la pared</h2><p class="hint" id="formHint">Restamos puertas y ventanas antes de sumar desperdicio.</p>
<div class="fields active" data-fields="brick"><div class="field"><label for="brickLength">Largo (m)</label><input class="control" id="brickLength" type="number" value="10" min="0" step=".1"></div><div class="field"><label for="brickHeight">Alto (m)</label><input class="control" id="brickHeight" type="number" value="2.7" min="0" step=".1"></div><div class="field"><label for="brickOpen">Puertas y ventanas (m²)</label><input class="control" id="brickOpen" type="number" value="2" min="0" step=".1"></div><div class="field"><label for="brickType">Tipo de ladrillo</label><select class="control" id="brickType"><option value="63">Común 24×12×6 cm</option><option value="70">Visto 24×11×5 cm</option><option value="16">Hueco 18×12×33 cm</option></select></div><div class="field"><label for="brickWaste">Desperdicio (%)</label><input class="control" id="brickWaste" type="number" value="10" min="0" max="30"></div><div class="field"><label for="brickJoint">Junta de mortero (cm)</label><input class="control" id="brickJoint" type="number" value="1.5" min=".5" max="3" step=".1"></div></div>
<div class="fields" data-fields="block"><div class="field"><label for="blockLength">Largo (m)</label><input class="control" id="blockLength" type="number" value="10" min="0"></div><div class="field"><label for="blockHeight">Alto (m)</label><input class="control" id="blockHeight" type="number" value="2.7" min="0"></div><div class="field"><label for="blockOpen">Aberturas (m²)</label><input class="control" id="blockOpen" type="number" value="2" min="0"></div><div class="field"><label for="blockType">Tipo de bloque</label><select class="control" id="blockType"><option value="12.5">20×20×40 cm</option><option value="12.5">15×20×40 cm</option><option value="12.5">10×20×40 cm</option></select></div><div class="field full"><label for="blockWaste">Desperdicio (%)</label><input class="control" id="blockWaste" type="number" value="7" min="0" max="30"></div></div>
<div class="fields" data-fields="fence"><div class="field"><label for="perimeter">Perímetro (m)</label><input class="control" id="perimeter" type="number" value="80" min="0"></div><div class="field"><label for="wires">Hilos de alambre</label><input class="control" id="wires" type="number" value="5" min="1" max="15"></div></div>
<div class="fields" data-fields="pavers"><div class="field"><label for="floorLength">Largo (m)</label><input class="control" id="floorLength" type="number" value="8" min="0"></div><div class="field"><label for="floorWidth">Ancho (m)</label><input class="control" id="floorWidth" type="number" value="4" min="0"></div><div class="field"><label for="paverType">Tipo de adoquín</label><select class="control" id="paverType"><option value="50">Rectangular 10×20 cm</option><option value="25">Cuadrado 20×20 cm</option><option value="42">Hueso 6×24 cm</option></select></div><div class="field"><label for="paverWaste">Cortes y rotura (%)</label><input class="control" id="paverWaste" type="number" value="8" min="0" max="30"></div></div>
<button class="update" id="updateButton" type="button">Actualizar cálculo</button></div>
<div class="panel result"><div class="kicker" id="kicker">LADRILLOS A COMPRAR</div><div class="big" id="resultValue">1.733 ladrillos</div><div class="sub" id="resultSub">25 m² netos × 63 ladrillos/m², más 10% de rotura.</div><div class="badge" id="resultBadge">Incluye 158 piezas extra</div><div class="tiles"><div class="tile"><small id="t1l">Superficie neta</small><strong id="t1v">25 m²</strong></div><div class="tile"><small id="t2l">Cemento</small><strong id="t2v">8 bolsas</strong></div><div class="tile"><small id="t3l">Arena</small><strong id="t3v">0,75 m³</strong></div></div></div></div></form></div>
<section><div class="wrap"><div class="section-head"><div class="eyebrow">La lista para el corralón</div><h2 id="matTitle">Todo lo que necesitás para levantar la pared.</h2><p id="matCopy">Las cantidades redondean hacia arriba porque no se puede comprar una fracción de bolsa.</p></div><div class="materials"><div class="list" id="matRows"></div><aside class="buy"><h3 id="buyTitle">Margen incluido</h3><div class="bigbuy" id="buyValue">+10%</div><p id="buyCopy">Cubre roturas, cortes y piezas que llegan dañadas. En un muro con muchas esquinas conviene subirlo.</p></aside></div></div></section>
<section class="method"><div class="wrap"><div class="section-head"><div class="eyebrow">Medí una vez, comprá una vez</div><h2>La cuenta correcta sigue cuatro pasos.</h2></div><div class="steps"><article class="step"><i>1</i><h3>Superficie bruta</h3><p>Largo por alto, o largo por ancho en pisos.</p></article><article class="step"><i>2</i><h3>Descontá vanos</h3><p>Puertas y ventanas no llevan ladrillos.</p></article><article class="step"><i>3</i><h3>Aplicá rendimiento</h3><p>Cada pieza tiene unidades por m² distintas.</p></article><article class="step"><i>4</i><h3>Sumá desperdicio</h3><p>Redondeá siempre hacia arriba antes de comprar.</p></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><div class="eyebrow">La fórmula transparente</div><h2>La abertura se descuenta antes del desperdicio.</h2><div class="rule"><strong id="rule">Piezas = (largo × alto − vanos) × rendimiento</strong><p id="ruleCopy">Al final se multiplica por 1 + desperdicio y se redondea hacia arriba.</p></div></div><div class="checks"><div class="check"><span class="tick">✓</span><span>Rendimiento según formato de pieza.</span></div><div class="check"><span class="tick">✓</span><span>Mortero ajustado al espesor de junta.</span></div><div class="check"><span class="tick">✓</span><span>Bolsas y rollos redondeados para compra.</span></div><div class="check"><span class="tick">✓</span><span>Superficie neta siempre visible.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-ladrillos')?document.currentScript.previousElementSibling:document.querySelector('.mockup-ladrillos');

const $=id=>root.querySelector("#"+id),set=(id,v)=>$(id).textContent=v,fmt=(n,d=1)=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:d});let mode="brick";for(let i=0;i<25;i++)$("wallBricks").insertAdjacentHTML("beforeend",'<div class="brick"></div>');const cfg={brick:["Medí la pared","Restamos puertas y ventanas antes de sumar desperdicio."],block:["Medí la pared de bloques","Los bloques rinden más por unidad y usan menos mortero."],fence:["Medí el perímetro","Calculamos alambre, rollos, postes intermedios y esquineros."],pavers:["Medí el piso","Sumamos adoquines, cama de arena y cordón perimetral."]};function rows(a){$("matRows").innerHTML=a.map(x=>`<div class="mat-row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
function calculate(){if(mode==="brick"||mode==="block"){let pre=mode==="brick"?"brick":"block",l=+$(pre+"Length").value||0,h=+$(pre+"Height").value||0,o=+$(pre+"Open").value||0,rate=+$(mode==="brick"?"brickType":"blockType").value,w=+$(mode==="brick"?"brickWaste":"blockWaste").value||0,area=Math.max(0,l*h-o),net=Math.ceil(area*rate),pieces=Math.ceil(net*(1+w/100)),cement=Math.ceil(area*(mode==="brick"?15:9)/50),sand=area*(mode==="brick"?.03:.018);set("kicker",mode==="brick"?"LADRILLOS A COMPRAR":"BLOQUES A COMPRAR");set("resultValue",pieces+" "+(mode==="brick"?"ladrillos":"bloques"));set("resultSub",`${fmt(area)} m² netos × ${fmt(rate)} piezas/m², más ${w}% de rotura.`);set("resultBadge","Incluye "+(pieces-net)+" piezas extra");set("t1l","Superficie neta");set("t1v",fmt(area)+" m²");set("t2l","Cemento");set("t2v",cement+" bolsas");set("t3l","Arena");set("t3v",fmt(sand,2)+" m³");set("heroPieces",pieces+" piezas");set("matTitle","Todo lo que necesitás para levantar la pared.");set("matCopy","Las cantidades redondean hacia arriba porque no se puede comprar una fracción de bolsa.");set("buyTitle","Margen incluido");set("buyValue","+"+w+"%");set("buyCopy","Cubre roturas, cortes y piezas que llegan dañadas.");set("rule","Piezas = (largo × alto − vanos) × rendimiento");set("ruleCopy","Al final se multiplica por 1 + desperdicio y se redondea hacia arriba.");rows([["Superficie neta",fmt(area)+" m²"],["Piezas netas",net],["Extra por desperdicio",pieces-net],["Piezas a comprar",pieces],["Bolsas de cemento",cement],["Arena gruesa",fmt(sand,2)+" m³"]])}
if(mode==="fence"){let p=+$("perimeter").value||0,w=+$("wires").value||1,meters=p*w,rolls=Math.ceil(meters/100),posts=Math.ceil(p/3);set("kicker","ALAMBRE NECESARIO");set("resultValue",meters+" m de alambre");set("resultSub",`${fmt(p)} m de perímetro × ${w} hilos.`);set("resultBadge",rolls+" rollos de 100 m");set("t1l","Postes");set("t1v",posts+" unidades");set("t2l","Esquineros");set("t2v","4 reforzados");set("t3l","Sobrante");set("t3v",rolls*100-meters+" m");set("heroPieces",rolls+" rollos");set("matTitle","Alambre, postes y refuerzos para el cerco.");set("matCopy","Los postes intermedios se estiman cada 3 metros.");set("buyTitle","Compra mínima");set("buyValue",rolls+" rollos");set("buyCopy","El último rollo deja "+(rolls*100-meters)+" m disponibles.");set("rule","Alambre = perímetro × cantidad de hilos");set("ruleCopy","Los rollos se redondean hacia arriba y los postes se ubican cada 3 m.");rows([["Perímetro",p+" m"],["Hilos",w],["Alambre",meters+" m"],["Rollos de 100 m",rolls],["Postes intermedios",posts],["Esquineros","4"]])}
if(mode==="pavers"){let l=+$("floorLength").value||0,wid=+$("floorWidth").value||0,rate=+$("paverType").value||50,w=+$("paverWaste").value||0,area=l*wid,net=Math.ceil(area*rate),pieces=Math.ceil(net*(1+w/100)),sand=area*.04,edge=2*(l+wid);set("kicker","ADOQUINES A COMPRAR");set("resultValue",pieces+" adoquines");set("resultSub",`${fmt(area)} m² × ${rate} piezas/m², más ${w}% de cortes.`);set("resultBadge","Cama de arena de 4 cm");set("t1l","Superficie");set("t1v",fmt(area)+" m²");set("t2l","Arena");set("t2v",fmt(sand,2)+" m³");set("t3l","Cordón");set("t3v",fmt(edge)+" m");set("heroPieces",pieces+" piezas");set("matTitle","Todo lo necesario para adoquinar.");set("matCopy","La contención perimetral evita que el piso se abra con el uso.");set("buyTitle","Cortes incluidos");set("buyValue","+"+w+"%");set("buyCopy","El desperdicio cubre bordes, encuentros y piezas dañadas.");set("rule","Adoquines = largo × ancho × rendimiento");set("ruleCopy","Se suma el porcentaje de cortes y una cama de arena de 4 cm.");rows([["Superficie",area+" m²"],["Adoquines netos",net],["Extra por cortes",pieces-net],["Adoquines a comprar",pieces],["Arena",fmt(sand,2)+" m³"],["Cordón perimetral",fmt(edge)+" m"]])}}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".fields").forEach(x=>x.classList.toggle("active",x.dataset.fields===mode));set("formTitle",cfg[mode][0]);set("formHint",cfg[mode][1]);calculate()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calculate));function confirmCalc(){calculate();set("updateButton","✓ Cálculo actualizado");clearTimeout(window.timer);window.timer=setTimeout(()=>set("updateButton","Actualizar cálculo"),5000)}$("updateButton").addEventListener("click",confirmCalc);$("calculator").addEventListener("submit",e=>{e.preventDefault();confirmCalc()});calculate();

})();
</script>
<style is:global>

.mockup-ladrillos{--ink:#111b33;--muted:#637085;--line:#dfe4ea;--bg:#f6f6f2;--blue:#286be7;--brick:#c9654c;--sand:#e4b45d;--mint:#42a98f;--navy:#102746}.mockup-ladrillos *{box-sizing:border-box}.mockup-ladrillos{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.mockup-ladrillos .wrap{width:min(1160px,calc(100% - 40px));margin:auto}.mockup-ladrillos header{height:86px;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-ladrillos .nav{display:flex;align-items:center;gap:28px}.mockup-ladrillos .logo{width:28px;height:35px;border-radius:4px;background:var(--navy);color:#fff;display:grid;place-items:center}.mockup-ladrillos .brand{font-size:18px;font-weight:950}.mockup-ladrillos .links{display:flex;gap:24px;color:#4e5a6c;font-size:13px;font-weight:800}.mockup-ladrillos .tools{margin-left:auto;display:flex;gap:8px}.mockup-ladrillos .tool{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px;font-weight:800}
.mockup-ladrillos .hero{display:grid;grid-template-columns:1.03fr .97fr;gap:48px;align-items:center;padding:62px 0 48px}.mockup-ladrillos .crumb{color:var(--blue);font-size:14px}.mockup-ladrillos .eyebrow{margin-top:18px;color:#187c77;font-size:12px;font-weight:950;letter-spacing:.13em;text-transform:uppercase}.mockup-ladrillos h1{font-size:clamp(46px,5.2vw,70px);line-height:.98;letter-spacing:-.055em;margin:11px 0 20px}.mockup-ladrillos .lead{font-size:18px;color:var(--muted);max-width:680px}.mockup-ladrillos .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-ladrillos .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:12px;font-weight:850}
.mockup-ladrillos .visual{height:350px;position:relative}.mockup-ladrillos .wall{position:absolute;left:28px;right:25px;top:34px;bottom:20px;display:grid;grid-template-columns:repeat(5,1fr);grid-auto-rows:54px;gap:7px;align-content:end}.mockup-ladrillos .brick{background:var(--brick);border-radius:7px;box-shadow:inset 0 -7px #9d4637}.mockup-ladrillos .brick:nth-child(10n+6),.mockup-ladrillos .brick:nth-child(10n+7),.mockup-ladrillos .brick:nth-child(10n+8),.mockup-ladrillos .brick:nth-child(10n+9),.mockup-ladrillos .brick:nth-child(10n+10){transform:translateX(-35px)}.mockup-ladrillos .opening{position:absolute;left:165px;bottom:20px;width:120px;height:170px;background:var(--bg);border-radius:70px 70px 0 0;z-index:2}.mockup-ladrillos .trowel{position:absolute;right:58px;top:5px;width:150px;height:70px;background:#c6d1db;clip-path:polygon(0 15%,100% 0,78% 100%,12% 78%);transform:rotate(-15deg);z-index:4}.mockup-ladrillos .trowel:after{content:"";position:absolute;width:100px;height:18px;background:#d79a43;right:-65px;top:24px}.mockup-ladrillos .badge-visual{position:absolute;right:0;bottom:6px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:13px 18px;box-shadow:0 12px 30px #24354b25;z-index:5}.mockup-ladrillos .badge-visual small{display:block;color:#718095;font-size:9px;font-weight:900}.mockup-ladrillos .badge-visual b{font-size:23px}
.mockup-ladrillos .calc{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:68px}.mockup-ladrillos .case-label{font-size:12px;font-weight:950;color:#5b6778;margin-bottom:11px}.mockup-ladrillos .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:25px}.mockup-ladrillos .case{border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:13px 8px;color:#505d70;font-size:12px;font-weight:900;cursor:pointer}.mockup-ladrillos .case span{display:block;font-size:18px;margin-bottom:3px}.mockup-ladrillos .case.active{background:#fff0eb;color:#a84937;border-color:#c8634c;box-shadow:inset 0 0 0 1px #c8634c}.mockup-ladrillos .grid{display:grid;grid-template-columns:1.03fr .97fr;gap:23px}.mockup-ladrillos .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-ladrillos .panel h2{font-size:22px;margin:0 0 5px}.mockup-ladrillos .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-ladrillos .fields{display:none;grid-template-columns:1fr 1fr;gap:14px}.mockup-ladrillos .fields.active{display:grid}.mockup-ladrillos .field.full{grid-column:1/-1}.mockup-ladrillos .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-ladrillos .control{width:100%;height:50px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-ladrillos .control:focus{border-color:var(--blue);box-shadow:0 0 0 3px #286be718}.mockup-ladrillos .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
.mockup-ladrillos .result{background:linear-gradient(145deg,#563329,#261d23);border:0;color:#fff;position:relative;overflow:hidden}.mockup-ladrillos .result:after{content:"";position:absolute;width:220px;height:220px;border:45px solid #dfa74a20;border-radius:50%;right:-125px;bottom:-130px}.mockup-ladrillos .kicker{font-size:11px;letter-spacing:.13em;color:#f2caa0;font-weight:950}.mockup-ladrillos .big{font-size:43px;line-height:1.05;font-weight:950;letter-spacing:-.045em;margin:15px 0 7px}.mockup-ladrillos .sub{color:#dbcac5}.mockup-ladrillos .badge{display:inline-flex;margin-top:16px;padding:8px 11px;border-radius:99px;background:#704a3e;border:1px solid #9b6d5d;font-size:12px;font-weight:850}.mockup-ladrillos .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}.mockup-ladrillos .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px;position:relative;z-index:1}.mockup-ladrillos .tile small{display:block;color:#d5bbb3;text-transform:uppercase;font-size:9px;letter-spacing:.07em}.mockup-ladrillos .tile strong{display:block;margin-top:5px;font-size:14px}
.mockup-ladrillos section{padding:70px 0}.mockup-ladrillos .section-head{max-width:760px;margin-bottom:28px}.mockup-ladrillos .section-head h2,.mockup-ladrillos .dark h2{font-size:39px;line-height:1.05;letter-spacing:-.04em;margin:9px 0}.mockup-ladrillos .section-head p{font-size:17px;color:var(--muted)}.mockup-ladrillos .materials{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}.mockup-ladrillos .list,.mockup-ladrillos .buy{background:#fff;border:1px solid var(--line);border-radius:22px;padding:24px}.mockup-ladrillos .mat-row{display:grid;grid-template-columns:1fr auto;gap:12px;padding:13px 0;border-bottom:1px solid #edf0f3}.mockup-ladrillos .mat-row:last-child{border:0}.mockup-ladrillos .mat-row span{color:#59667a}.mockup-ladrillos .buy{background:#fff8e9;border-color:#eed39f}.mockup-ladrillos .buy h3{font-size:23px;margin:0}.mockup-ladrillos .buy .bigbuy{font-size:36px;font-weight:950;color:#9a6420;margin:12px 0}.mockup-ladrillos .buy p{color:#745e3d}.mockup-ladrillos .method{background:#eef3f5;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.mockup-ladrillos .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.mockup-ladrillos .step{background:#fff;border:1px solid var(--line);border-radius:19px;padding:21px}.mockup-ladrillos .step i{display:grid;place-items:center;width:39px;height:39px;border-radius:12px;background:#fff0eb;color:#a64937;font-style:normal;font-weight:950}.mockup-ladrillos .step h3{margin:15px 0 6px}.mockup-ladrillos .step p{margin:0;color:var(--muted);font-size:13px}.mockup-ladrillos .dark{background:#0c203d;color:#fff}.mockup-ladrillos .dark-grid{display:grid;grid-template-columns:1fr 1fr;gap:55px}.mockup-ladrillos .rule{border:1px solid #ffffff20;background:#ffffff09;border-radius:20px;padding:24px}.mockup-ladrillos .rule strong{font-size:26px}.mockup-ladrillos .rule p{color:#b8c9dc}.mockup-ladrillos .checks{display:grid;gap:12px}.mockup-ladrillos .check{display:flex;gap:12px;color:#d4e0ee}.mockup-ladrillos .tick{flex:0 0 26px;height:26px;border-radius:50%;background:#2eaa98;display:grid;place-items:center;color:#071d2c;font-weight:950}.mockup-ladrillos footer{padding:30px;text-align:center;color:#687589;font-size:12px;background:#fff}
@media(max-width:920px){.mockup-ladrillos .links{display:none}.mockup-ladrillos .hero,.mockup-ladrillos .grid,.mockup-ladrillos .materials,.mockup-ladrillos .dark-grid{grid-template-columns:1fr}.mockup-ladrillos .cases,.mockup-ladrillos .steps{grid-template-columns:repeat(2,1fr)}.mockup-ladrillos .visual{height:315px}.mockup-ladrillos .tiles{grid-template-columns:1fr}}@media(max-width:520px){.mockup-ladrillos .wrap{width:calc(100% - 24px)}.mockup-ladrillos header{height:70px}.mockup-ladrillos .tools .tool:first-child{display:none}.mockup-ladrillos h1{font-size:42px}.mockup-ladrillos .visual{transform:scale(.84);margin:-25px}.mockup-ladrillos .calc{padding:14px}.mockup-ladrillos .panel{padding:18px}.mockup-ladrillos .fields,.mockup-ladrillos .cases,.mockup-ladrillos .steps{grid-template-columns:1fr}.mockup-ladrillos .field.full{grid-column:auto}.mockup-ladrillos .section-head h2,.mockup-ladrillos .dark h2{font-size:32px}}

.mockup-ladrillos { width:100%; overflow:hidden; }
.mockup-ladrillos .top, .mockup-ladrillos header.top { display:none !important; }
.mockup-ladrillos .foot { display:none !important; }
.mockup-ladrillos .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-ladrillos .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-ladrillos .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-ladrillos .support-real summary { cursor:pointer; font-weight:750; }
.mockup-ladrillos .support-real p { color:#687a8f; line-height:1.65; }
@media(max-width:800px){.mockup-ladrillos .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-ladrillos support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
