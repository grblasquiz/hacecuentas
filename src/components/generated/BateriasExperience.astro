---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-baterias" set:html={`<div class="wrap hero"><div><div class="crumb">Tecnología / Baterías</div><div class="eyebrow">La autonomía real, no la de la caja</div><h1>Sabé cuánto dura antes de quedarte sin energía.</h1><p class="lead">Calculá autonomía, carga y capacidad útil contemplando eficiencia, profundidad de descarga y consumo real.</p><div class="chips"><span class="chip">✓ mAh, Ah y Wh</span><span class="chip">✓ UPS y bancos</span><span class="chip">✓ LiPo seguro</span></div></div><div class="visual"><div class="battery"><div class="charge"></div><div class="bolt">ϟ</div></div><div class="percent"><div><b id="heroPct">80%</b><small>APROVECHABLE</small></div></div><div class="runtime"><small>AUTONOMÍA</small><b id="heroRuntime">8 h</b></div></div></div>
<div class="wrap"><form class="calc" id="calculator"><div class="case-label">¿QUÉ QUERÉS CALCULAR?</div><div class="cases"><button type="button" class="case active" data-mode="device"><span>📱</span>Dispositivo en mAh</button><button type="button" class="case" data-mode="bank"><span>▥</span>Banco en Ah</button><button type="button" class="case" data-mode="ups"><span>▣</span>UPS y equipos</button><button type="button" class="case" data-mode="charge"><span>↯</span>Tiempo de carga</button><button type="button" class="case" data-mode="lipo"><span>🚁</span>Pack LiPo</button></div>
<div class="grid"><div class="panel"><h2 id="formTitle">Autonomía de un dispositivo</h2><p class="hint" id="formHint">Capacidad útil dividida por consumo promedio.</p>
<div class="fields active" data-fields="device"><div class="field"><label for="mah">Capacidad (mAh)</label><input class="control" id="mah" type="number" value="5000" min="0"></div><div class="field"><label for="ma">Consumo (mA)</label><input class="control" id="ma" type="number" value="500" min="0"></div><div class="field full"><label for="deviceEff">Eficiencia (%)</label><input class="control" id="deviceEff" type="number" value="80" min="1" max="100"></div></div>
<div class="fields" data-fields="bank"><div class="field"><label for="ah">Capacidad (Ah)</label><input class="control" id="ah" type="number" value="100" min="0"></div><div class="field"><label for="voltage">Tensión (V)</label><select class="control" id="voltage"><option>12</option><option>24</option><option>48</option></select></div><div class="field"><label for="watts">Consumo (W)</label><input class="control" id="watts" type="number" value="300" min="0"></div><div class="field"><label for="dod">Descarga segura (%)</label><input class="control" id="dod" type="number" value="50" min="1" max="100"></div><div class="field full"><label for="bankEff">Eficiencia del sistema (%)</label><input class="control" id="bankEff" type="number" value="85" min="1" max="100"></div></div>
<div class="fields" data-fields="ups"><div class="field"><label for="va">Capacidad del UPS (VA)</label><input class="control" id="va" type="number" value="1000" min="0"></div><div class="field"><label for="upsW">Carga conectada (W)</label><input class="control" id="upsW" type="number" value="300" min="0"></div><div class="field"><label for="upsAh">Batería interna (Ah, opcional)</label><input class="control" id="upsAh" type="number" value="9" min="0"></div><div class="field"><label for="upsV">Tensión batería (V)</label><input class="control" id="upsV" type="number" value="12" min="0"></div></div>
<div class="fields" data-fields="charge"><div class="field"><label for="chargeAh">Capacidad (Ah)</label><input class="control" id="chargeAh" type="number" value="100" min="0"></div><div class="field"><label for="currentPct">Carga actual (%)</label><input class="control" id="currentPct" type="number" value="20" min="0" max="100"></div><div class="field"><label for="charger">Corriente del cargador (A)</label><input class="control" id="charger" type="number" value="10" min="0"></div><div class="field"><label for="chemistry">Química</label><select class="control" id="chemistry"><option value="1.2">Plomo-ácido</option><option value="1.08">Li-Ion</option><option value="1.05">LiFePO4</option><option value="1.15">NiMH</option></select></div></div>
<div class="fields" data-fields="lipo"><div class="field"><label for="lipoMah">Capacidad (mAh)</label><input class="control" id="lipoMah" type="number" value="2200" min="0"></div><div class="field"><label for="cells">Celdas (S)</label><input class="control" id="cells" type="number" value="3" min="1" max="12"></div><div class="field"><label for="cRate">Tasa de descarga (C)</label><input class="control" id="cRate" type="number" value="30" min="1"></div><div class="field"><label for="flightA">Consumo en vuelo (A)</label><input class="control" id="flightA" type="number" value="18" min="0"></div><div class="field full"><label for="safePct">Descarga segura (%)</label><input class="control" id="safePct" type="number" value="80" min="1" max="100"></div></div>
<button class="update" id="updateButton" type="button">Actualizar cálculo</button></div>
<div class="panel result"><div class="kicker" id="kicker">AUTONOMÍA ESTIMADA</div><div class="big" id="resultValue">8 h</div><div class="sub" id="resultSub">4.000 mAh útiles ÷ 500 mA de consumo.</div><div class="badge" id="resultBadge">Se pierden 1.000 mAh por eficiencia</div><div class="tiles"><div class="tile"><small id="t1l">Capacidad útil</small><strong id="t1v">4.000 mAh</strong></div><div class="tile"><small id="t2l">Energía</small><strong id="t2v">14,8 Wh</strong></div><div class="tile"><small id="t3l">Sin pérdidas</small><strong id="t3v">10 h</strong></div></div></div></div></form></div>
<section><div class="wrap"><div class="section-head"><div class="eyebrow">Nominal no es utilizable</div><h2 id="energyTitle">De la etiqueta a la energía que realmente llega.</h2><p id="energyCopy">Eficiencia, electrónica y margen de seguridad reducen la capacidad aprovechable.</p></div><div class="energy"><div class="energy-card"><h3>Capacidad de la batería</h3><div class="energy-bar"><div class="energy-fill" id="energyFill"></div></div><div class="energy-legend"><div><b id="usable">80%</b><span>Utilizable</span></div><div><b id="lost">20%</b><span>No aprovechable</span></div></div></div><aside class="warning"><h3 id="warningTitle">No descargues hasta cero</h3><p id="warningCopy">En muchas químicas, agotar la batería acelera la degradación y reduce drásticamente su vida útil.</p></aside></div></div></section>
<section class="chem"><div class="wrap"><div class="section-head"><div class="eyebrow">La química cambia las reglas</div><h2>La misma capacidad no significa el mismo uso.</h2></div><div class="chem-grid"><article class="chem-card"><h3>Plomo-ácido</h3><p>Económica y pesada. Evitá superar 50% de descarga habitual.</p><b>DoD recomendado 50%</b></article><article class="chem-card"><h3>Li-Ion</h3><p>Alta densidad. Requiere BMS y control térmico.</p><b>DoD recomendado 80%</b></article><article class="chem-card"><h3>LiFePO4</h3><p>Muchos ciclos, estable y apta para solar.</p><b>DoD recomendado 90%</b></article><article class="chem-card"><h3>LiPo</h3><p>Gran potencia, sensible a golpes y sobrecarga.</p><b>Guardar a 3,8 V/celda</b></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><div class="eyebrow">La cuenta detrás del resultado</div><h2>Convertí capacidad en energía antes de dividir.</h2><div class="rule"><strong id="rule">Horas = mAh × eficiencia ÷ mA</strong><p id="ruleCopy">Para bancos usamos Wh = Ah × V × DoD × eficiencia.</p></div></div><div class="checks"><div class="check"><span class="tick">✓</span><span>Capacidad nominal y útil separadas.</span></div><div class="check"><span class="tick">✓</span><span>Potencia real del UPS, no sólo VA.</span></div><div class="check"><span class="tick">✓</span><span>Descarga segura según química.</span></div><div class="check"><span class="tick">✓</span><span>LiPo con tasa C y corriente máxima.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-baterias')?document.currentScript.previousElementSibling:document.querySelector('.mockup-baterias');

const $=id=>root.querySelector("#"+id),set=(id,v)=>$(id).textContent=v,fmt=(n,d=1)=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:d});let mode="device";const cfg={device:["Autonomía de un dispositivo","Capacidad útil dividida por consumo promedio."],bank:["Autonomía de un banco","Convertimos Ah a Wh y aplicamos descarga segura y eficiencia."],ups:["Respaldo de un UPS","Comparamos carga conectada contra potencia útil real."],charge:["Tiempo hasta completar la carga","Corregimos la cuenta ideal según la química."],lipo:["Autonomía y seguridad del pack","Validamos corriente, tasa C y descarga segura."]};function duration(h){if(h<1)return Math.round(h*60)+" min";if(h<48)return Math.floor(h)+" h "+Math.round((h%1)*60)+" min";return fmt(h/24)+" días"}function energy(pct,title,copy){$("energyFill").style.width=Math.max(0,Math.min(100,pct))+"%";set("usable",fmt(pct,0)+"%");set("lost",fmt(100-pct,0)+"%");set("warningTitle",title);set("warningCopy",copy);set("heroPct",fmt(pct,0)+"%")}
function calculate(){if(mode==="device"){let cap=+$("mah").value||0,ma=+$("ma").value||1,eff=+$("deviceEff").value||0,use=cap*eff/100,h=use/ma;set("kicker","AUTONOMÍA ESTIMADA");set("resultValue",duration(h));set("resultSub",`${fmt(use,0)} mAh útiles ÷ ${fmt(ma,0)} mA de consumo.`);set("resultBadge","Se pierden "+fmt(cap-use,0)+" mAh por eficiencia");set("t1l","Capacidad útil");set("t1v",fmt(use,0)+" mAh");set("t2l","Energía");set("t2v",fmt(use*3.7/1000)+" Wh");set("t3l","Sin pérdidas");set("t3v",duration(cap/ma));set("heroRuntime",duration(h));set("rule","Horas = mAh × eficiencia ÷ mA");set("ruleCopy","La cuenta ideal sobreestima la duración porque ignora pérdidas.");energy(eff,"La eficiencia importa","Conversión, regulación y autoconsumo reducen lo que llega al dispositivo.")}
if(mode==="bank"){let ah=+$("ah").value||0,v=+$("voltage").value||12,w=+$("watts").value||1,dod=+$("dod").value||0,eff=+$("bankEff").value||0,nom=ah*v,use=nom*dod/100*eff/100,h=use/w,pct=use/(nom||1)*100;set("kicker","AUTONOMÍA DEL BANCO");set("resultValue",duration(h));set("resultSub",`${fmt(use,0)} Wh útiles para una carga de ${fmt(w,0)} W.`);set("resultBadge",fmt(nom-use,0)+" Wh quedan fuera del uso");set("t1l","Energía nominal");set("t1v",fmt(nom,0)+" Wh");set("t2l","Energía útil");set("t2v",fmt(use,0)+" Wh");set("t3l","Corriente");set("t3v",fmt(w/v)+" A");set("heroRuntime",duration(h));set("rule","Horas = Ah × V × DoD × eficiencia ÷ W");set("ruleCopy","La profundidad de descarga preserva la vida del banco.");energy(pct,"Respetá el DoD","Usar más energía de la recomendada acelera el desgaste de la batería.")}
if(mode==="ups"){let va=+$("va").value||0,w=+$("upsW").value||1,ah=+$("upsAh").value||0,v=+$("upsV").value||12,max=va*.6,usePct=w/(max||1)*100,wh=ah?v*ah*.8:va*.028,min=wh/w*60,over=w>max;set("kicker",over?"UPS SOBRECARGADO":"RESPALDO DEL UPS");set("resultValue",over?"No es seguro":Math.round(min)+" min");set("resultSub",`${fmt(w,0)} W conectados sobre ${fmt(max,0)} W útiles.`);set("resultBadge",over?"La carga supera la potencia útil":fmt(usePct,0)+"% de utilización");$("resultBadge").className="badge"+(over?" bad":"");set("t1l","Potencia útil");set("t1v",fmt(max,0)+" W");set("t2l","Carga");set("t2v",fmt(w,0)+" W");set("t3l","Margen");set("t3v",fmt(max-w,0)+" W");set("heroRuntime",over?"Sobrecarga":Math.round(min)+" min");set("rule","Minutos = Wh útiles ÷ W × 60");set("ruleCopy","Los VA se convierten a watts usando el factor de potencia.");energy(Math.min(100,usePct),over?"Desconectá equipos":"Dejá margen de potencia",over?"El UPS puede cortar de golpe o dañarse.":"Trabajar por debajo del 80% mejora la respuesta ante picos.")}
if(mode==="charge"){let ah=+$("chargeAh").value||0,current=+$("currentPct").value||0,a=+$("charger").value||1,f=+$("chemistry").value||1,missing=ah*(1-current/100),h=missing/a*f;set("kicker","TIEMPO DE CARGA");set("resultValue",duration(h));set("resultSub",`${fmt(missing)} Ah por reponer con un cargador de ${fmt(a)} A.`);set("resultBadge","Incluye la etapa final de absorción");set("t1l","Carga faltante");set("t1v",fmt(100-current,0)+"%");set("t2l","Ah por reponer");set("t2v",fmt(missing)+" Ah");set("t3l","Tiempo ideal");set("t3v",duration(missing/a));set("heroRuntime",duration(h));set("rule","Carga = Ah faltantes ÷ amperes × factor");set("ruleCopy","El último tramo de carga no mantiene la corriente máxima.");energy(current,"Usá un cargador compatible","La tensión y el perfil de carga deben coincidir con la química.")}
if(mode==="lipo"){let mah=+$("lipoMah").value||0,cells=+$("cells").value||1,c=+$("cRate").value||1,a=+$("flightA").value||1,safe=+$("safePct").value||80,ah=mah/1000,use=ah*safe/100,min=use/a*60,maxA=ah*c,ok=a<=maxA;set("kicker","AUTONOMÍA DEL PACK LIPO");set("resultValue",fmt(min)+" min");set("resultSub",`${cells}S · ${fmt(c,0)}C · ${fmt(a)} A de consumo promedio.`);set("resultBadge",ok?"La descarga está dentro del límite":"Consumo superior a la tasa C");$("resultBadge").className="badge"+(ok?"":" bad");set("t1l","Tensión nominal");set("t1v",fmt(cells*3.7)+" V");set("t2l","Corriente máxima");set("t2v",fmt(maxA)+" A");set("t3l","Energía");set("t3v",fmt(ah*cells*3.7)+" Wh");set("heroRuntime",fmt(min)+" min");set("rule","Minutos = Ah útiles ÷ A × 60");set("ruleCopy","La tasa C define la corriente máxima segura del pack.");energy(safe,ok?"No bajes de 3,3 V por celda":"Pack insuficiente",ok?"Usá alarma o telemetría y aterrizá con margen.":"Elegí más capacidad o mayor tasa C.")}}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".fields").forEach(x=>x.classList.toggle("active",x.dataset.fields===mode));set("formTitle",cfg[mode][0]);set("formHint",cfg[mode][1]);$("resultBadge").className="badge";calculate()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calculate));function confirmCalc(){calculate();set("updateButton","✓ Cálculo actualizado");clearTimeout(window.timer);window.timer=setTimeout(()=>set("updateButton","Actualizar cálculo"),5000)}$("updateButton").addEventListener("click",confirmCalc);$("calculator").addEventListener("submit",e=>{e.preventDefault();confirmCalc()});calculate();

})();
</script>
<style is:global>

.mockup-baterias{--ink:#111b33;--muted:#637085;--line:#dfe4ea;--bg:#f6f6f2;--blue:#286be7;--mint:#35aa98;--amber:#efad45;--red:#df665b;--navy:#174B7A}.mockup-baterias *{box-sizing:border-box}.mockup-baterias{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.mockup-baterias .wrap{width:min(1160px,calc(100% - 40px));margin:auto}.mockup-baterias header{height:86px;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-baterias .nav{display:flex;align-items:center;gap:28px}.mockup-baterias .logo{width:28px;height:35px;border-radius:4px;background:var(--navy);color:#fff;display:grid;place-items:center}.mockup-baterias .brand{font-size:18px;font-weight:950}.mockup-baterias .links{display:flex;gap:24px;color:#4e5a6c;font-size:13px;font-weight:800}.mockup-baterias .tools{margin-left:auto;display:flex;gap:8px}.mockup-baterias .tool{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px;font-weight:800}
.mockup-baterias .hero{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center;padding:62px 0 48px}.mockup-baterias .crumb{color:var(--blue);font-size:14px}.mockup-baterias .eyebrow{margin-top:18px;color:#187c77;font-size:12px;font-weight:950;letter-spacing:.13em;text-transform:uppercase}.mockup-baterias h1{font-size:clamp(46px,5.2vw,70px);line-height:.98;letter-spacing:-.055em;margin:11px 0 20px}.mockup-baterias .lead{font-size:18px;color:var(--muted);max-width:680px}.mockup-baterias .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-baterias .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:12px;font-weight:850}
.mockup-baterias .visual{height:350px;position:relative}.mockup-baterias .battery{position:absolute;left:45px;right:50px;top:70px;height:205px;background:#fff;border:12px solid #17314e;border-radius:29px;box-shadow:0 22px 55px #26374b28;overflow:hidden}.mockup-baterias .battery:after{content:"";position:absolute;right:-28px;top:60px;width:30px;height:65px;border-radius:0 12px 12px 0;background:#17314e}.mockup-baterias .charge{position:absolute;left:0;top:0;bottom:0;width:76%;background:linear-gradient(90deg,#37a990,#55c8a8)}.mockup-baterias .charge:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(120deg,transparent 0 25px,#ffffff12 25px 45px)}.mockup-baterias .bolt{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:95px;color:#fff;z-index:2}.mockup-baterias .percent{position:absolute;right:8px;top:8px;width:137px;height:137px;border-radius:50%;background:#fff;border:13px solid #e8edf2;box-shadow:0 13px 35px #27384c25;display:grid;place-items:center;text-align:center}.mockup-baterias .percent b{font-size:31px;line-height:1}.mockup-baterias .percent small{display:block;color:#6d798b;font-size:9px}.mockup-baterias .runtime{position:absolute;left:20px;bottom:7px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:13px 18px;box-shadow:0 12px 30px #24354b25}.mockup-baterias .runtime small{display:block;color:#718095;font-size:9px;font-weight:900}.mockup-baterias .runtime b{font-size:24px}
.mockup-baterias .calc{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:68px}.mockup-baterias .case-label{font-size:12px;font-weight:950;color:#5b6778;margin-bottom:11px}.mockup-baterias .cases{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:25px}.mockup-baterias .case{border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:13px 7px;color:#505d70;font-size:11px;font-weight:900;cursor:pointer}.mockup-baterias .case span{display:block;font-size:18px;margin-bottom:3px}.mockup-baterias .case.active{background:#eef8f5;color:#177660;border-color:#45ab94;box-shadow:inset 0 0 0 1px #45ab94}.mockup-baterias .grid{display:grid;grid-template-columns:1.03fr .97fr;gap:23px}.mockup-baterias .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-baterias .panel h2{font-size:22px;margin:0 0 5px}.mockup-baterias .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-baterias .fields{display:none;grid-template-columns:1fr 1fr;gap:14px}.mockup-baterias .fields.active{display:grid}.mockup-baterias .field.full{grid-column:1/-1}.mockup-baterias .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-baterias .control{width:100%;height:50px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-baterias .control:focus{border-color:var(--blue);box-shadow:0 0 0 3px #286be718}.mockup-baterias .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
.mockup-baterias .result{background:linear-gradient(145deg,#143a57,#0b2435);border:0;color:#fff;position:relative;overflow:hidden}.mockup-baterias .result:after{content:"";position:absolute;width:220px;height:220px;border:45px solid #48bca421;border-radius:50%;right:-125px;bottom:-130px}.mockup-baterias .kicker{font-size:11px;letter-spacing:.13em;color:#9fe1d6;font-weight:950}.mockup-baterias .big{font-size:45px;line-height:1.05;font-weight:950;letter-spacing:-.045em;margin:15px 0 7px}.mockup-baterias .sub{color:#c2d2e4}.mockup-baterias .badge{display:inline-flex;margin-top:16px;padding:8px 11px;border-radius:99px;background:#1e5b61;border:1px solid #3f8586;font-size:12px;font-weight:850}.mockup-baterias .badge.bad{background:#713539;border-color:#a35657}.mockup-baterias .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}.mockup-baterias .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px;position:relative;z-index:1}.mockup-baterias .tile small{display:block;color:#b6c7db;text-transform:uppercase;font-size:9px;letter-spacing:.07em}.mockup-baterias .tile strong{display:block;margin-top:5px;font-size:14px}
