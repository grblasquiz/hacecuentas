---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-becas-estudiar" set:html={`<section class="hero"><div class="hero-inner"><div class="crumb">Finanzas personales / Becas para estudiar</div><div class="hero-title"><div><div class="eyebrow">Radar de oportunidades</div><h1>No busques “becas”. Buscá las que encajan con vos.</h1><p class="lead">Armá tu perfil una vez. Te mostramos qué oportunidades priorizar, qué requisito te falta y cuándo empezar cada postulación.</p></div><aside class="hero-side"><b>Una beca se gana antes de que abra.</b><span>Promedio, idioma, cartas y documentos llevan tiempo. El mockup pone primero la preparación.</span></aside></div><div class="radar"><div class="radar-cell"><small>NIVEL</small><b id="heroLevel">Grado</b></div><div class="radar-cell"><small>DESTINO</small><b id="heroDestination">Exterior</b></div><div class="radar-cell"><small>PROMEDIO</small><b id="heroAverage">8,2</b></div><div class="radar-cell"><small>IDIOMA</small><b id="heroLanguage">B2</b></div><div class="radar-cell"><small>ANTICIPACIÓN</small><b>6–12 meses</b></div></div></div></section>
<section class="finder"><div class="wrap finder-layout"><aside class="profile"><h2>Tu perfil</h2><p>No pedimos datos personales: sólo lo que cambia la elegibilidad.</p><div class="field"><label for="level">QUÉ QUERÉS ESTUDIAR</label><select id="level"><option value="undergrad">Carrera de grado</option><option value="postgrad">Posgrado o maestría</option><option value="course">Curso o certificación</option><option value="research">Investigación</option></select></div><div class="field"><label for="destination">DÓNDE</label><select id="destination"><option value="abroad">En el exterior</option><option value="local">En Argentina</option><option value="latam">En Latinoamérica</option></select></div><div class="field"><label for="average">PROMEDIO</label><input id="average" type="number" value="8.2" min="1" max="10" step=".1"></div><div class="field"><label for="language">NIVEL DE IDIOMA</label><select id="language"><option value="b2">B2 o equivalente</option><option value="c1">C1 o superior</option><option value="a2">A2–B1</option><option value="none">Sin certificado</option></select></div><label class="check"><input id="need" type="checkbox" checked><span>Necesito que cubra manutención, no sólo matrícula.</span></label><label class="check"><input id="leadership" type="checkbox"><span>Tengo experiencia de liderazgo, voluntariado o investigación.</span></label><button class="refresh" id="refresh">Actualizar radar</button></aside><section class="board"><div class="board-head"><div><div class="kicker">Tablero de oportunidades</div><h2>Qué hacer con cada tipo de beca</h2></div><span class="match" id="match">3 para priorizar</span></div><div class="lanes"><div class="lane"><div class="lane-head"><b>Postular ahora</b><span id="nowCount">2</span></div><article class="card good" data-card="merit"><span class="tag">MÉRITO</span><h3>Beca académica institucional</h3><p>Buen encaje por promedio y nivel. Suele cubrir matrícula total o parcial.</p><div class="card-foot"><span>Encaje: alto</span><span>Preparación: 4 semanas</span></div></article><article class="card good" data-card="need"><span class="tag">NECESIDAD ECONÓMICA</span><h3>Ayuda integral de universidad</h3><p>Priorizar si necesitás matrícula y manutención.</p><div class="card-foot"><span>Encaje: alto</span><span>Requiere ingresos</span></div></article></div><div class="lane"><div class="lane-head"><b>Preparar requisitos</b><span>2</span></div><article class="card prepare" data-card="government"><span class="tag">GOBIERNO / PAÍS</span><h3>Programa internacional completo</h3><p>Mayor cobertura, pero exige idioma, cartas y postulación temprana.</p><div class="card-foot"><span>Encaje: medio</span><span>6–12 meses</span></div></article><article class="card prepare" data-card="leadership"><span class="tag">LIDERAZGO</span><h3>Beca de impacto y comunidad</h3><p>El promedio ayuda, pero pesa más la trayectoria demostrable.</p><div class="card-foot"><span>Encaje: revisar</span><span>Portfolio narrativo</span></div></article></div><div class="lane"><div class="lane-head"><b>No priorizar todavía</b><span>2</span></div><article class="card later" data-card="research"><span class="tag">INVESTIGACIÓN</span><h3>Financiamiento con director</h3><p>Primero necesitás proyecto y contacto académico.</p><div class="card-foot"><span>Falta: propuesta</span><span>Etapa posterior</span></div></article><article class="card later" data-card="language"><span class="tag">IDIOMA</span><h3>Beca con C1 obligatorio</h3><p>Conviene invertir primero en certificación.</p><div class="card-foot"><span>Falta: C1</span><span>Reevaluar después</span></div></article></div></div><div class="drawer" id="drawer"><div><div class="kicker">Ficha de preparación</div><h3 id="drawerTitle">Beca académica institucional</h3><p id="drawerText">El punto fuerte es tu promedio. Buscá universidades donde la beca se solicite junto con la admisión.</p></div><div class="requirements" id="requirements"></div></div></section></div></section>
<section class="calendar"><div class="wrap calendar-grid"><div><div class="kicker">Calendario inverso</div><h2>Trabajá desde la fecha límite hacia atrás</h2><p>No dependas de que la convocatoria ya esté abierta para empezar.</p></div><div class="weeks"><div class="week"><b>Mes 1</b><span>Mapa de programas, costos totales y criterios excluyentes.</span></div><div class="week"><b>Mes 2</b><span>Idioma, analítico, traducciones y referencias.</span></div><div class="week"><b>Mes 3</b><span>Carta de motivación adaptada y revisión externa.</span></div><div class="week"><b>Mes 4</b><span>Postulación, copias, seguimiento y plan alternativo.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-becas-estudiar')?document.currentScript.previousElementSibling:document.querySelector('.mockup-becas-estudiar');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];const cards={merit:["Beca académica institucional","El punto fuerte es tu promedio. Buscá universidades donde la beca se solicite junto con la admisión.",["Analítico actualizado","Carta centrada en logros verificables","Confirmar si la admisión activa la beca"]],need:["Ayuda integral de universidad","La cobertura importa tanto como la elegibilidad. Compará matrícula, vivienda, seguro, viaje y duración.",["Documentación de ingresos","Presupuesto completo del destino","Explicar contexto sin sobreactuar"]],government:["Programa internacional completo","Son competitivas y suelen tener ciclos anuales. Prepará idioma y referencias con mucha anticipación.",["Certificado de idioma válido","Dos referencias sólidas","Ensayo adaptado al objetivo del programa"]],leadership:["Beca de impacto y comunidad","No alcanza con decir que lideraste: mostrales problema, acción, escala y resultado.",["Tres experiencias con impacto","Evidencia o referencias","Proyecto futuro coherente"]],research:["Financiamiento con director","El primer paso no es el formulario: es alinear tema, grupo y posible dirección.",["Resumen de proyecto","CV académico","Mapa de docentes y laboratorios"]],language:["Beca con C1 obligatorio","Si el idioma es excluyente, postular antes de certificarlo suele desperdiciar tiempo.",["Fecha de examen","Plan de preparación","Convocatorias del ciclo siguiente"]]};function update(){const level=$("#level").value,dest=$("#destination").value,avg=+$("#average").value||0,lang=$("#language").value,need=$("#need").checked,lead=$("#leadership").checked;$("#heroLevel").textContent={undergrad:"Grado",postgrad:"Posgrado",course:"Curso",research:"Investigación"}[level];$("#heroDestination").textContent={abroad:"Exterior",local:"Argentina",latam:"Latinoamérica"}[dest];$("#heroAverage").textContent=avg.toFixed(1).replace(".",",");$("#heroLanguage").textContent=lang.toUpperCase();let count=(avg>=8?1:0)+(need?1:0)+(lang==="b2"||lang==="c1"?1:0)+(lead?1:0);$("#match").textContent=Math.max(1,count)+" para priorizar";$("#nowCount").textContent=Math.max(1,Math.min(3,count-1));$$("[data-card=merit]")[0].style.opacity=avg>=8?"1":".58";$$("[data-card=leadership]")[0].style.opacity=lead?"1":".58";$$("[data-card=language]")[0].style.opacity=lang==="c1"?".45":"1"}$$("[data-card]").forEach(c=>c.addEventListener("click",()=>{const d=cards[c.dataset.card];$("#drawerTitle").textContent=d[0];$("#drawerText").textContent=d[1];$("#requirements").innerHTML=d[2].map(x=>`<div class="req"><i>✓</i><span>${x}</span></div>`).join("");$("#drawer").classList.add("open");$("#drawer").scrollIntoView?.({behavior:"smooth",block:"nearest"})}));$$("input,select").forEach(x=>x.addEventListener("input",update));$("#refresh").addEventListener("click",update);update()})();
})();
</script>
<style is:global>

.mockup-becas-estudiar{--blue:#174b7a;--teal:#347e87;--mint:#e5f2ed;--sky:#ebf4f7;--gold:#d79a35;--cream:#fff7df;--ink:#182332;--muted:#5e6977;--line:#d9e2e4}.mockup-becas-estudiar *{box-sizing:border-box}.mockup-becas-estudiar{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fafcfb}.mockup-becas-estudiar button,.mockup-becas-estudiar input,.mockup-becas-estudiar select{font:inherit}.mockup-becas-estudiar .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-becas-estudiar .brand{font-size:19px;font-weight:950}.mockup-becas-estudiar .brand b{display:inline-grid;place-items:center;width:36px;height:36px;border-radius:9px;margin-right:10px;background:var(--blue);color:#fff}.mockup-becas-estudiar .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-becas-estudiar .search{margin-left:auto;padding:10px 15px;border:1px solid var(--line);border-radius:11px;background:#fff}.mockup-becas-estudiar .hero{padding:48px 22px 35px;background:linear-gradient(180deg,#fff 0 78%,var(--sky) 78%)}.mockup-becas-estudiar .hero-inner,.mockup-becas-estudiar .wrap{max-width:1180px;margin:auto}.mockup-becas-estudiar .crumb{color:var(--blue);font-size:14px;font-weight:850}.mockup-becas-estudiar .hero-title{display:grid;grid-template-columns:1fr .7fr;gap:45px;align-items:end;margin-top:25px}.mockup-becas-estudiar .eyebrow{color:var(--teal);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-becas-estudiar .hero h1{font-size:clamp(44px,5vw,67px);line-height:.98;letter-spacing:-.05em;margin:9px 0 18px}.mockup-becas-estudiar .lead{font-size:19px;color:var(--muted);max-width:660px}.mockup-becas-estudiar .hero-side{padding:20px;border:1px solid #cfe0e3;border-radius:18px;background:#fff}.mockup-becas-estudiar .hero-side b{display:block;font-size:18px}.mockup-becas-estudiar .hero-side span{color:var(--muted);font-size:13px}.mockup-becas-estudiar .radar{margin-top:34px;display:grid;grid-template-columns:repeat(5,1fr);border:1px solid #cfdfe2;border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 18px 40px #17374a0d}.mockup-becas-estudiar .radar-cell{padding:16px;border-right:1px solid var(--line)}.mockup-becas-estudiar .radar-cell:last-child{border:0}.mockup-becas-estudiar .radar-cell small{display:block;color:var(--muted);font-size:10px}.mockup-becas-estudiar .radar-cell b{font-size:18px}.mockup-becas-estudiar .finder{padding:62px 22px}.mockup-becas-estudiar .finder-layout{display:grid;grid-template-columns:330px 1fr;gap:26px;align-items:start}.mockup-becas-estudiar .profile{background:#fff;border:1px solid var(--line);border-radius:22px;padding:24px;position:sticky;top:16px}.mockup-becas-estudiar .profile h2{font-size:25px;letter-spacing:-.03em;margin:0 0 5px}.mockup-becas-estudiar .profile>p{margin:0 0 20px;color:var(--muted);font-size:13px}.mockup-becas-estudiar .field{margin:15px 0}.mockup-becas-estudiar .field label{display:block;font-size:12px;font-weight:900;margin-bottom:6px}.mockup-becas-estudiar .field select,.mockup-becas-estudiar .field input{width:100%;min-height:47px;border:1px solid #ccd7da;border-radius:11px;background:#fff;padding:11px 13px;color:var(--ink)}.mockup-becas-estudiar .check{display:flex;gap:9px;align-items:start;margin:12px 0}.mockup-becas-estudiar .check input{width:18px;height:18px;accent-color:var(--teal)}.mockup-becas-estudiar .check span{font-size:13px}.mockup-becas-estudiar .refresh{width:100%;padding:13px;border:0;border-radius:11px;background:var(--blue);color:#fff;font-weight:900;cursor:pointer;margin-top:7px}.mockup-becas-estudiar .board-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.mockup-becas-estudiar .kicker{color:var(--teal);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-becas-estudiar .board h2{font-size:34px;letter-spacing:-.04em;margin:6px 0 0}.mockup-becas-estudiar .match{padding:8px 11px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:900}.mockup-becas-estudiar .lanes{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.mockup-becas-estudiar .lane{min-height:480px;padding:14px;border:1px solid var(--line);border-radius:18px;background:#f3f6f5}.mockup-becas-estudiar .lane-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.mockup-becas-estudiar .lane-head b{font-size:14px}.mockup-becas-estudiar .lane-head span{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#fff;color:var(--teal);font-weight:900;font-size:12px}.mockup-becas-estudiar .card{padding:16px;background:#fff;border:1px solid var(--line);border-radius:14px;margin-bottom:10px;cursor:pointer;transition:.15s}.mockup-becas-estudiar .card:hover{transform:translateY(-2px);box-shadow:0 10px 22px #17374a12}.mockup-becas-estudiar .card .tag{display:inline-block;padding:5px 8px;border-radius:99px;background:var(--sky);color:var(--blue);font-size:10px;font-weight:900}.mockup-becas-estudiar .card h3{font-size:15px;margin:9px 0 5px}.mockup-becas-estudiar .card p{font-size:12px;color:var(--muted);margin:0}.mockup-becas-estudiar .card-foot{display:flex;justify-content:space-between;gap:8px;margin-top:12px;padding-top:10px;border-top:1px solid #edf0f1;font-size:10px;color:var(--muted)}.mockup-becas-estudiar .card.good{border-left:5px solid #4d9a77}.mockup-becas-estudiar .card.prepare{border-left:5px solid var(--gold)}.mockup-becas-estudiar .card.later{opacity:.72}.mockup-becas-estudiar .drawer{display:none;margin-top:18px;padding:22px;border:1px solid #cddcdf;border-radius:18px;background:#fff}.mockup-becas-estudiar .drawer.open{display:grid;grid-template-columns:1fr 1fr;gap:22px}.mockup-becas-estudiar .drawer h3{font-size:22px;margin:0 0 6px}.mockup-becas-estudiar .drawer p{color:var(--muted);font-size:13px}.mockup-becas-estudiar .requirements{display:grid;gap:8px}.mockup-becas-estudiar .req{display:flex;gap:9px;padding:10px;background:#f5f7f6;border-radius:10px;font-size:12px}.mockup-becas-estudiar .req i{font-style:normal;color:#22735b;font-weight:950}.mockup-becas-estudiar .calendar{padding:65px 22px;background:#eef5f4}.mockup-becas-estudiar .calendar-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:44px}.mockup-becas-estudiar .calendar h2{font-size:36px;letter-spacing:-.04em;margin:7px 0}.mockup-becas-estudiar .calendar p{color:var(--muted)}.mockup-becas-estudiar .weeks{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.mockup-becas-estudiar .week{padding:17px;background:#fff;border:1px solid var(--line);border-radius:15px}.mockup-becas-estudiar .week b{display:block;color:var(--teal);margin-bottom:5px}.mockup-becas-estudiar .week span{font-size:13px;color:var(--muted)}.mockup-becas-estudiar .foot{padding:30px;text-align:center;border-top:1px solid var(--line);background:#fff;color:var(--muted)}@media(max-width:900px){.mockup-becas-estudiar .nav{display:none}.mockup-becas-estudiar .hero-title,.mockup-becas-estudiar .finder-layout,.mockup-becas-estudiar .calendar-grid{grid-template-columns:1fr}.mockup-becas-estudiar .profile{position:static}.mockup-becas-estudiar .lanes{grid-template-columns:1fr}.mockup-becas-estudiar .lane{min-height:0}.mockup-becas-estudiar .radar{grid-template-columns:1fr 1fr}.mockup-becas-estudiar .drawer.open{grid-template-columns:1fr}}@media(max-width:560px){.mockup-becas-estudiar .hero h1{font-size:42px}.mockup-becas-estudiar .weeks,.mockup-becas-estudiar .radar{grid-template-columns:1fr}}

.mockup-becas-estudiar { width:100%; overflow:hidden; }
.mockup-becas-estudiar .top, .mockup-becas-estudiar header.top { display:none !important; }
.mockup-becas-estudiar .foot { display:none !important; }
.mockup-becas-estudiar .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-becas-estudiar .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-becas-estudiar .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-becas-estudiar .support-real summary { cursor:pointer; font-weight:750; }
.mockup-becas-estudiar .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-becas-estudiar :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-becas-estudiar input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-becas-estudiar input[type="number"]::-webkit-inner-spin-button, .mockup-becas-estudiar input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-becas-estudiar .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-becas-estudiar support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
