---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-geometria-analitica" set:html={`<div class="crumb">Matemática / Geometría analítica</div><h1>Dos puntos cuentan toda una recta.</h1><p class="lead">Ubicá A y B para leer distancia, punto medio, pendiente y ecuación en el mismo plano.</p><section class="studio"><div class="board"><svg id="plane" viewBox="0 0 600 500" aria-label="Plano cartesiano"></svg></div><aside class="inspector"><div class="coords"><div class="pointbox"><b>Punto A</b><div class="pair"><input id="ax" type="number" value="-3"><input id="ay" type="number" value="2"></div></div><div class="pointbox"><b>Punto B</b><div class="pair"><input id="bx" type="number" value="4"><input id="by" type="number" value="-2"></div></div></div><div class="metric">Distancia<b id="distance"></b></div><div class="metric">Punto medio<b id="middle"></b></div><div class="metric">Pendiente<b id="slope"></b></div><div class="equation" id="equation"></div><div class="preset"><button data-preset="-4,0,4,0">Horizontal</button><button data-preset="0,-4,0,4">Vertical</button><button data-preset="-3,-3,3,3">Diagonal</button></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-geometria-analitica')?document.currentScript.previousElementSibling:document.querySelector('.mockup-geometria-analitica');

const $=x=>root.querySelector("#"+x);function render(){let ax=+$('ax').value,ay=+$('ay').value,bx=+$('bx').value,by=+$('by').value,s=40,cx=300,cy=250,grid='';for(let i=-7;i<=7;i++){grid+=`<line class="grid" x1="${cx+i*s}" y1="0" x2="${cx+i*s}" y2="500"/><line class="grid" x1="0" y1="${cy+i*s}" x2="600" y2="${cy+i*s}"/>`}$('plane').innerHTML=`${grid}<line class="axis" x1="0" y1="${cy}" x2="600" y2="${cy}"/><line class="axis" x1="${cx}" y1="0" x2="${cx}" y2="500"/><line class="segment" x1="${cx+ax*s}" y1="${cy-ay*s}" x2="${cx+bx*s}" y2="${cy-by*s}"/><circle class="point" cx="${cx+ax*s}" cy="${cy-ay*s}" r="11"/><circle class="point" cx="${cx+bx*s}" cy="${cy-by*s}" r="11"/><circle class="point mid" cx="${cx+(ax+bx)/2*s}" cy="${cy-(ay+by)/2*s}" r="8"/>`;let dx=bx-ax,dy=by-ay,m=dx?dy/dx:null;$('distance').textContent=Math.hypot(dx,dy).toFixed(2);$('middle').textContent=`(${((ax+bx)/2).toFixed(1)}, ${((ay+by)/2).toFixed(1)})`;$('slope').textContent=m===null?'indefinida':m.toFixed(2);$('equation').textContent=m===null?`x = ${ax}`:`y = ${m.toFixed(2)}x ${ay-m*ax>=0?'+':'−'} ${Math.abs(ay-m*ax).toFixed(2)}`}
root.querySelectorAll('input').forEach(x=>x.oninput=render);root.querySelectorAll('[data-preset]').forEach(b=>b.onclick=()=>{[$('ax').value,$('ay').value,$('bx').value,$('by').value]=b.dataset.preset.split(',');render()});render();

})();
</script>
<style is:global>

.mockup-geometria-analitica{--blue:#174b7a;--ink:#172832;--muted:#65747d;--line:#d5dfdd;--red:#dc5f52;--green:#38a27c;--paper:#f4f7f5}.mockup-geometria-analitica *{box-sizing:border-box}.mockup-geometria-analitica{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-geometria-analitica input,.mockup-geometria-analitica button{font:inherit}.mockup-geometria-analitica .shell{max-width:1180px;margin:auto;padding:34px 22px}.mockup-geometria-analitica .crumb{color:var(--blue);font-weight:850}.mockup-geometria-analitica h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-geometria-analitica .lead{font-size:18px;color:var(--muted)}.mockup-geometria-analitica .studio{margin-top:25px;display:grid;grid-template-columns:1fr 310px;gap:20px}.mockup-geometria-analitica .board,.mockup-geometria-analitica .inspector{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-geometria-analitica .board svg{width:100%;height:500px}.mockup-geometria-analitica .grid{stroke:#dce5e2;stroke-width:1}.mockup-geometria-analitica .axis{stroke:#7d908b;stroke-width:2}.mockup-geometria-analitica .segment{stroke:var(--blue);stroke-width:6}.mockup-geometria-analitica .point{fill:var(--red);stroke:#fff;stroke-width:5;cursor:pointer}.mockup-geometria-analitica .mid{fill:var(--green)}.mockup-geometria-analitica .coords{display:grid;grid-template-columns:1fr 1fr;gap:12px}.mockup-geometria-analitica .pointbox{border-radius:16px;background:#f1f5f3;padding:14px}.mockup-geometria-analitica .pointbox b{color:var(--red)}.mockup-geometria-analitica .pair{display:flex;gap:6px}.mockup-geometria-analitica .pair input{width:50%;border:1px solid var(--line);border-radius:9px;padding:9px}.mockup-geometria-analitica .metric{border-top:1px solid var(--line);padding:18px 0}.mockup-geometria-analitica .metric b{display:block;font-size:32px;color:var(--blue)}.mockup-geometria-analitica .equation{font:700 15px ui-monospace,monospace;background:#e2f1eb;padding:14px;border-radius:13px}.mockup-geometria-analitica .preset{display:flex;gap:7px;margin-top:17px}.mockup-geometria-analitica .preset button{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px;cursor:pointer;color:var(--ink)}@media(max-width:800px){.mockup-geometria-analitica .studio{grid-template-columns:1fr}.mockup-geometria-analitica .board svg{height:380px}}
.mockup-geometria-analitica { width:100%; overflow:hidden; }
.mockup-geometria-analitica .top, .mockup-geometria-analitica header.top { display:none !important; }
.mockup-geometria-analitica .foot { display:none !important; }
.mockup-geometria-analitica .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-geometria-analitica .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-geometria-analitica .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-geometria-analitica .support-real summary { cursor:pointer; font-weight:750; }
.mockup-geometria-analitica .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-geometria-analitica :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-geometria-analitica input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-geometria-analitica input[type="number"]::-webkit-inner-spin-button, .mockup-geometria-analitica input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-geometria-analitica .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-geometria-analitica support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
