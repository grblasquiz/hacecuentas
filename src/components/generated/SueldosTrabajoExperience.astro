<div class="mockup-sueldos-trabajo" set:html={`
<section class="hero"><div class="wrap"><div class="crumb"><b>Inicio</b> / Sueldos y trabajo</div><div class="hero-grid"><div><div class="eyebrow">Trabajo en Argentina · 2026</div><h1>Entendé tu sueldo. Defendé mejor tu trabajo.</h1><p class="lead">De lo que cobrás en mano a una indemnización: resolvé cada decisión laboral con números claros y sin conocer la fórmula.</p><div class="trust"><span>✓ Normativa 2026</span><span>✓ Fórmulas verificadas</span><span>✓ Tus datos quedan acá</span></div><div class="mini-board"><div><small>Tu último cálculo</small><b id="last-result">$1.245.000 netos</b></div><div class="good"><small>Poder de compra</small><b>+2,4% real</b></div><div><small>Próximo hito</small><b>Aguinaldo · 19 días</b></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>¿Cuánto te queda en mano?</h2><p>Una estimación inmediata para empezar.</p></div><span class="live">Cálculo en vivo</span></div><div class="role-picks"><button type="button" class="role active" data-role="empleado">En relación de dependencia</button><button type="button" class="role" data-role="monotributo">Monotributista</button><button type="button" class="role" data-role="casa">Casas particulares</button></div><div class="fields"><div class="field wide"><label>Ingreso bruto mensual</label><div class="money"><b>$</b><input id="salary" inputmode="numeric" value="1500000"></div></div><div class="field"><label>Hijos a cargo</label><select id="children"><option>0</option><option>1</option><option>2</option><option>3</option></select></div><div class="field"><label>Otros descuentos</label><div class="money"><b>$</b><input id="extras" inputmode="numeric" value="0"></div></div></div><div class="switch-line"><span>Aplicar Ganancias si corresponde</span><button type="button" class="switch on" id="tax-switch" aria-label="Aplicar Ganancias"></button></div><section class="result"><div class="result-top"><div><small>SUELDO NETO ESTIMADO</small><div class="amount" id="net">$1.245.000</div></div><div class="ratio"><small>Te queda</small><b id="ratio">83% del bruto</b></div></div><div class="bars"><i class="net" id="bar-net" style="width:83%"></i><i class="ded" id="bar-ded" style="width:17%"></i><i class="tax" id="bar-tax" style="width:0"></i></div><div class="result-grid"><span>APORTES<b id="deductions">− $255.000</b></span><span>GANANCIAS<b id="tax">− $0</b></span><span>OTROS<b id="other">− $0</b></span></div><button class="go" id="calculate">Ver cálculo completo →</button></section></form></div></div></section>
<section class="section"><div class="wrap"><header class="section-head"><span>Empezá por tu situación</span><h2>¿Qué necesitás resolver hoy?</h2><p>No hace falta saber el nombre de la calculadora. Elegí lo que te está pasando.</p></header><div class="needs" id="needs"><button class="need active" data-filter="sueldo"><i>💵</i><b>Quiero entender cuánto cobro</b><span>Bruto, neto, descuentos y Ganancias.</span><em>→</em></button><button class="need" data-filter="derechos"><i>⚖️</i><b>Terminó mi trabajo</b><span>Renuncia, despido y liquidación final.</span><em>→</em></button><button class="need" data-filter="tiempo"><i>⏱</i><b>Quiero calcular días y horas</b><span>Vacaciones, extras y antigüedad.</span><em>→</em></button><button class="need" data-filter="aumento"><i>📈</i><b>Voy a pedir un aumento</b><span>Inflación, paritarias y poder de compra.</span><em>→</em></button><button class="need" data-filter="aguinaldo"><i>🎁</i><b>Quiero calcular el aguinaldo</b><span>SAC completo o proporcional.</span><em>→</em></button><button class="need" data-filter="jubilacion"><i>🧭</i><b>Estoy pensando en jubilarme</b><span>Aportes, edad y haber estimado.</span><em>→</em></button></div></div></section>
<section class="section tint" id="tools"><div class="wrap"><header class="section-head"><span>Herramientas laborales</span><h2>Todo lo que necesitás, ordenado.</h2></header><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="sueldo">Sueldo</button><button class="filter" data-filter="derechos">Derechos</button><button class="filter" data-filter="tiempo">Tiempo</button><button class="filter" data-filter="aumento">Aumentos</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards" id="cards"><article class="card featured" data-cat="sueldo" data-text="sueldo neto bruto descuentos ganancias"><div><span class="tag">La más usada</span><h3>Calculadora de sueldo neto</h3><p>Pasá del bruto a lo que realmente recibís, con aportes, Ganancias y deducciones vigentes.</p><a href="/trabajo/sueldo-bruto-y-neto">Calcular mi sueldo →</a></div><div class="preview"><small>SUELDO ESTIMADO</small><strong>$1.245.000</strong><div><span>Bruto</span><b>$1.500.000</b></div><div><span>Aportes</span><b>− $255.000</b></div></div></article><article class="card" data-cat="aguinaldo sueldo" data-text="aguinaldo sac completo proporcional"><span class="tag">Popular</span><h3>Aguinaldo (SAC)</h3><p>Calculá el medio aguinaldo completo o proporcional y sus descuentos.</p><a href="/trabajo/aguinaldo">Calcular →</a></article><article class="card" data-cat="derechos" data-text="indemnización despido liquidación"><span class="tag">Derechos laborales</span><h3>Indemnización por despido</h3><p>Antigüedad, preaviso, integración y liquidación final.</p><a href="/trabajo/indemnizacion-por-despido">Calcular →</a></article><article class="card" data-cat="tiempo" data-text="vacaciones plus días antigüedad"><span class="tag">Vacaciones</span><h3>Días y plus vacacional</h3><p>Lo que te corresponde por antigüedad y el monto estimado.</p><a href="/trabajo/vacaciones">Calcular →</a></article><article class="card" data-cat="tiempo" data-text="horas extra 50 100 jornada"><span class="tag">Tiempo trabajado</span><h3>Horas extra al 50% y 100%</h3><p>Valor según día, horario y modalidad de trabajo.</p><a href="/trabajo/horas-extra">Calcular →</a></article><article class="card" data-cat="aumento sueldo" data-text="inflación aumento sueldo poder compra"><span class="tag">Poder adquisitivo</span><h3>¿Tu sueldo le ganó a la inflación?</h3><p>Compará la evolución real de tu ingreso.</p><a href="/trabajo/sueldo-vs-inflacion">Comparar →</a></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="section"><div class="wrap"><header class="section-head"><span>Salas de decisión</span><h2>Una respuesta, no cinco cálculos sueltos.</h2><p>Combinamos herramientas y contexto para ayudarte a decidir.</p></header><div class="rooms"><article class="room"><small>SALA 01 · AUMENTO</small><h3>¿Cuánto aumento tengo que pedir?</h3><p>Inflación, mercado y objetivo neto en una sola cuenta.</p><button data-room="Aumento">Entrar a la sala →</button></article><article class="room"><small>SALA 02 · OFERTA</small><h3>¿Me conviene cambiar de trabajo?</h3><p>Compará sueldo, beneficios, viaje y tiempo real.</p><button data-room="Oferta laboral">Comparar una oferta →</button></article><article class="room"><small>SALA 03 · DESPIDO</small><h3>Me despidieron: ¿qué hago ahora?</h3><p>Liquidación estimada, gastos y meses de respaldo.</p><button data-room="Despido">Armar mi plan →</button></article></div></div></section>
<section class="section tint"><div class="wrap references"><article class="guide"><span class="eyebrow">Guía esencial 2026</span><h3>Cómo se forma tu sueldo, explicado sin letra chica.</h3><p>Bruto, neto, aportes, Ganancias, aguinaldo, vacaciones y horas extra en un recorrido simple.</p><button id="guide-button">Leer la guía completa →</button></article><article class="data"><h3>Datos de referencia</h3><div class="data-row"><span>Salario mínimo vigente</span><b>Consultar →</b></div><div class="data-row"><span>Topes SIPA 2026</span><b>Ver valores →</b></div><div class="data-row"><span>Fechas del aguinaldo</span><b>Ver calendario →</b></div></article></div></section>
<button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sueldos-trabajo')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sueldos-trabajo');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR"),num=id=>Math.max(0,Number($(id).value.replaceAll(".","").replaceAll(",",""))||0);let role="empleado",taxOn=true;
function calculate(){const gross=num("#salary"),extra=num("#extras"),kids=Number($("#children").value),rates={empleado:.17,monotributo:.105,casa:.14},ded=gross*rates[role],taxable=Math.max(0,gross-ded-2400000-kids*120000),tax=taxOn?taxable*.19:0,net=Math.max(0,gross-ded-tax-extra),ratio=gross?net/gross*100:0;$("#net").textContent=money(net);$("#ratio").textContent=Math.round(ratio)+"% del bruto";$("#deductions").textContent="− "+money(ded);$("#tax").textContent="− "+money(tax);$("#other").textContent="− "+money(extra);$("#bar-net").style.width=ratio+"%";$("#bar-ded").style.width=(gross?ded/gross*100:0)+"%";$("#bar-tax").style.width=(gross?tax/gross*100:0)+"%";$("#last-result").textContent=money(net)+" netos"}
$$(".role").forEach(b=>b.onclick=()=>{role=b.dataset.role;$$(".role").forEach(x=>x.classList.toggle("active",x===b));calculate()});$$(".calc input,.calc select").forEach(x=>x.oninput=calculate);$("#tax-switch").onclick=e=>{taxOn=!taxOn;e.currentTarget.classList.toggle("on",taxOn);calculate()};$("#calculate").onclick=e=>{calculate();e.currentTarget.textContent="✓ Cálculo actualizado";toast("Resultado actualizado");setTimeout(()=>e.currentTarget.textContent="Ver cálculo completo →",1300)};
function applyFilter(cat="all"){const q=$("#search").value.toLowerCase().trim();let visible=0;$$(".card").forEach(c=>{const okCat=cat==="all"||c.dataset.cat.includes(cat),okText=!q||c.dataset.text.includes(q);c.style.display=okCat&&okText?"":"none";if(okCat&&okText)visible++});$("#empty").style.display=visible?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));applyFilter(b.dataset.filter)});$("#search").oninput=()=>applyFilter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,$target=$$(".filter").find(x=>x.dataset.filter===f)||$(".filter[data-filter=all]");$$(".filter").forEach(x=>x.classList.toggle("active",x===$target));applyFilter(f);$("#tools").scrollIntoView({behavior:"smooth"})});
function toast(msg){$("#toast").textContent=msg;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1800)}$$(".card a").forEach(a=>a.onclick=e=>{e.preventDefault();toast("Abriendo: "+a.closest(".card").querySelector("h3").textContent)});$$("[data-room]").forEach(b=>b.onclick=()=>toast("Abriendo sala: "+b.dataset.room));$("#guide-button").onclick=()=>toast("Abriendo guía laboral 2026");calculate();

})();
</script>
