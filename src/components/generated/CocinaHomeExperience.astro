.mockup-cocina-home .planner{background:#fff;border:1px solid var(--line);border-radius:25px;padding:27px;box-shadow:var(--shadow)}.mockup-cocina-home .plannerHead{display:flex;justify-content:space-between;gap:14px}.mockup-cocina-home .planner h2{font-size:25px;letter-spacing:-.035em;margin:0}.mockup-cocina-home .plannerHead p{font-size:13px;color:var(--muted);margin:5px 0 0}.mockup-cocina-home .live{background:var(--green);color:#3c6650;padding:7px 9px;border-radius:99px;font-size:9px;font-weight:950;height:max-content}.mockup-cocina-home .recipeTabs{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:18px 0 14px}.mockup-cocina-home .recipeTab{border:1px solid var(--line);background:#fcfbf8;border-radius:10px;padding:10px 4px;font-size:9px;font-weight:900;color:var(--muted);cursor:pointer}.mockup-cocina-home .recipeTab.active{background:var(--cream);border-color:#e4b55c;color:#8b5d13}.mockup-cocina-home .fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mockup-cocina-home .field label{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.07em;color:#796f66;font-weight:900;margin-bottom:6px}.mockup-cocina-home .input,.mockup-cocina-home .field select{height:47px;width:100%;border:1px solid #ded7ce;border-radius:11px;padding:0 11px;background:#fff;display:flex;align-items:center;gap:7px}.mockup-cocina-home .input input{border:0;outline:0;width:100%;min-width:0;font-weight:850;color:var(--ink)}.mockup-cocina-home .field select{font-weight:850;color:var(--ink)}.mockup-cocina-home .primary{height:50px;width:100%;border:0;border-radius:12px;background:var(--tomato);color:#fff;font-weight:950;margin-top:13px;cursor:pointer}.mockup-cocina-home .result{margin-top:14px;background:var(--brown);color:#fff;border-radius:18px;padding:20px}.mockup-cocina-home .result small{font-size:8px;letter-spacing:.09em;color:#dbcac0}.mockup-cocina-home .amount{font-size:34px;font-weight:950;letter-spacing:-.045em;margin:4px 0}.mockup-cocina-home .resultGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:13px}.mockup-cocina-home .metric{background:#ffffff0d;border:1px solid #ffffff14;border-radius:9px;padding:9px}.mockup-cocina-home .metric span{font-size:7px;color:#d8c7bc;display:block}.mockup-cocina-home .metric b{font-size:11px}.mockup-cocina-home .note{font-size:9px;color:#ddcec4;margin:11px 0 0}
.mockup-cocina-home section{padding:76px 0}.mockup-cocina-home .sectionHead{text-align:center;max-width:730px;margin:0 auto 38px}.mockup-cocina-home .sectionHead h2{font-size:40px;letter-spacing:-.045em;margin:10px 0}.mockup-cocina-home .sectionHead p{color:var(--muted);line-height:1.55}.mockup-cocina-home .needs{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.mockup-cocina-home .need{text-align:left;border:1px solid var(--line);background:#fff;border-radius:19px;padding:21px;min-height:188px;position:relative;color:var(--ink);cursor:pointer;transition:.2s}.mockup-cocina-home .need:hover,.mockup-cocina-home .need.active{transform:translateY(-3px);border-color:#d8826f;box-shadow:0 15px 35px #6b392415}.mockup-cocina-home .need.active{background:var(--brown);color:#fff}.mockup-cocina-home .need.active p{color:#dfcec3}.mockup-cocina-home .icon{width:39px;height:39px;border-radius:11px;background:var(--cream);color:var(--tomato);display:grid;place-items:center;font-weight:950}.mockup-cocina-home .need h3{font-size:17px;margin:16px 0 7px}.mockup-cocina-home .need p{font-size:11px;line-height:1.5;color:var(--muted);margin:0}.mockup-cocina-home .need em{position:absolute;right:17px;bottom:15px;font-style:normal;color:var(--tomato);font-weight:950}
