ple h3{font-size:19px;margin:0 0 8px}.mockup-ciencia-home .principle p{font-size:11px;color:var(--muted);line-height:1.55}.mockup-ciencia-home .principle.dark p{color:#bdcdd4}.mockup-ciencia-home .line{padding:10px 0;border-top:1px solid var(--line);font-size:10px}.mockup-ciencia-home .dark .line{border-color:#ffffff18}.mockup-ciencia-home .toast{position:fixed;right:22px;bottom:22px;background:var(--navy);color:#fff;padding:13px 16px;border-radius:12px;font-size:11px;font-weight:850;transform:translateY(80px);opacity:0;transition:.25s}.mockup-ciencia-home .toast.show{opacity:1;transform:none}.mockup-ciencia-home footer{background:var(--navy);color:#fff;padding:46px 0}.mockup-ciencia-home .foot{display:flex;justify-content:space-between;color:#b9c9d1}.mockup-ciencia-home .foot strong{color:#fff}@media(max-width:900px){.mockup-ciencia-home .links{display:none}.mockup-ciencia-home .heroGrid{grid-template-columns:1fr}.mockup-ciencia-home .areas{grid-template-columns:1fr 1fr}.mockup-ciencia-home .cards{grid-template-columns:1fr 1fr}.mockup-ciencia-home .card.featured{grid-column:1/-1}}@media(max-width:600px){.mockup-ciencia-home .wrap{width:calc(100% - 24px)}.mockup-ciencia-home h1{font-size:41px}.mockup-ciencia-home .solve,.mockup-ciencia-home .fields,.mockup-ciencia-home .areas,.mockup-ciencia-home .cards,.mockup-ciencia-home .principles{grid-template-columns:1fr}.mockup-ciencia-home .card.featured{grid-column:auto}.mockup-ciencia-home .toolbar{flex-direction:column}.mockup-ciencia-home .search{width:100%}.mockup-ciencia-home .resultGrid{grid-template-columns:1fr}.mockup-ciencia-home .actions .sm:first-child{display:none}}

