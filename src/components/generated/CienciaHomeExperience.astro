<div class="mockup-ciencia-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Ciencia</div><div class="heroGrid"><div><span class="eyebrow">Fórmulas que podés explorar</span><h1>De la pregunta al resultado, sin saltarte el método.</h1><p class="lead">Calculadoras de química, física, astronomía y laboratorio con unidades, fórmulas y pasos visibles. Para estudiar, comprobar y entender.</p><div class="trust"><span>✓ Unidades consistentes</span><span>✓ Fórmula explicada</span><span>✓ Resultado reproducible</span></div><div class="atom"><i class="orbit"></i><i class="orbit two"></i><i class="orbit three"></i><i class="nucleus"></i><i class="electron"></i></div></div>
<div class="calc"><div class="calcHead"><div><h2>Ley de los gases ideales</h2><p>Elegí qué variable querés despejar.</p></div><span class="live">LABORATORIO EN VIVO</span></div><div class="solve"><button class="active" data-solve="p">Presión P</button><button data-solve="v">Volumen V</button><button data-solve="n">Moles n</button><button data-solve="t">Temperatura T</button></div><div class="fields"><div class="field disabled" data-field="p"><label>Presión</label><div class="input"><input id="p" value=""><span>atm</span></div></div><div class="field" data-field="v"><label>Volumen</label><div class="input"><input id="v" value="10"><span>L</span></div></div><div class="field" data-field="n"><label>Cantidad</label><div class="input"><input id="n" value="0.5"><span>mol</span></div></div><div class="field" data-field="t"><label>Temperatura</label><div class="input"><input id="t" value="298.15"><span>K</span></div></div></div><div class="formula" id="formula">P = n × R × T ÷ V</div><button class="primary" id="calculate">Actualizar resultado</button><div class="result"><small>RESULTADO CALCULADO</small><div class="amount" id="answer">1,22 atm</div><div class="resultGrid"><div class="metric"><span>CONSTANTE R</span><b>0,082057 L·atm/mol·K</b></div><div class="metric"><span>TEMPERATURA</span><b id="celsius">25,0 °C</b></div><div class="metric"><span>CONTROL</span><b id="check">Datos consistentes</b></div></div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Elegí un área</span><h2>¿Qué querés investigar?</h2><p>Filtramos las herramientas para que encuentres la fórmula adecuada sin conocer su nombre.</p></div><div class="areas"><button class="area active" data-filter="chemistry"><span class="icon">⚗</span><h3>Química</h3><p>Soluciones, concentración, gases, pH y estequiometría.</p><em>→</em></button><button class="area" data-filter="physics"><span class="icon">≈</span><h3>Física</h3><p>Movimiento, fuerza, energía, electricidad y ondas.</p><em>→</em></button><button class="area" data-filter="astro"><span class="icon"></span><h3>Astronomía</h3><p>Distancias, órbitas, magnitud y escalas del universo.</p><em>→</em></button><button class="area" data-filter="lab"><span class="icon">▤</span><h3>Laboratorio</h3><p>Conversiones, incertidumbre, diluciones y medición.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas científicas</span><h2>Calculá y comprobá cada paso.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="chemistry">Química</button><button class="filter" data-filter="physics">Física</button><button class="filter" data-filter="astro">Astronomía</button><button class="filter" data-filter="lab">Laboratorio</button></div><input class="search" id="search" placeholder="Buscar fórmula o magnitud…"></div><div class="cards"><article class="card featured" data-cat="chemistry lab" data-text="química soluciones molaridad dilución concentración"><span class="tag">Laboratorio completo</span><h3>Química de soluciones</h3><p>Molaridad, diluciones, concentración porcentual y titulaciones con unidades controladas.</p><button>Abrir laboratorio →</button></article><article class="card" data-cat="chemistry physics" data-text="presión gases ideal boyle charles"><span class="tag">Termodinámica</span><h3>Presión y gases</h3><p>Ley ideal, Boyle, Charles y transformaciones.</p><button>Calcular →</button></article><article class="card" data-cat="chemistry" data-text="ph poh hidrogeno acidez base"><span class="tag">Química</span><h3>pH y pOH</h3><p>Concentración de iones y clasificación ácido-base.</p><button>Calcular →</button></article><article class="card" data-cat="physics" data-text="velocidad distancia tiempo movimiento"><span class="tag">Movimiento</span><h3>Velocidad, distancia y tiempo</h3><p>Despejá cualquier variable y convertí unidades.</p><button>Calcular →</button></article><article class="card" data-cat="physics" data-text="electricidad ley ohm voltaje corriente resistencia"><span class="tag">Electricidad</span><h3>Ley de Ohm</h3><p>Voltaje, corriente, resistencia y potencia.</p><button>Calcular →</button></article><article class="card" data-cat="astro physics" data-text="richter energía joules tnt terremoto magnitud"><span class="tag">Escalas</span><h3>Magnitud Richter a energía</h3><p>Convertí magnitud en joules y equivalente TNT.</p><button>Calcular →</button></article><article class="card" data-cat="astro" data-text="años luz parsec distancia astronomía"><span class="tag">Astronomía</span><h3>Distancias astronómicas</h3><p>Años luz, parsecs, UA y kilómetros.</p><button>Convertir →</button></article><article class="card" data-cat="lab" data-text="error incertidumbre medición propagación"><span class="tag">Medición</span><h3>Error e incertidumbre</h3><p>Error absoluto, relativo y propagación básica.</p><button>Calcular →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Método y confianza</span><h2>Un resultado científico necesita contexto.</h2></div><div class="principles"><article class="principle dark"><h3>Unidades primero</h3><p>Cada fórmula declara el sistema de unidades y convierte antes de operar.</p><div class="line">✓ Control dimensional</div><div class="line">✓ Conversión visible</div></article><article class="principle"><h3>Fórmula reproducible</h3><p>Mostramos la ecuación despejada, los valores reemplazados y el redondeo aplicado.</p><div class="line">✓ Constantes identificadas</div><div class="line">✓ Precisión configurable</div></article><article class="principle"><h3>Límites honestos</h3><p>Indicamos cuándo el modelo ideal no representa bien un sistema real o necesita datos experimentales.</p><div class="line">✓ Supuestos explícitos</div><div class="line">✓ Uso educativo</div></article></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-ciencia-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-ciencia-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],R=.082057;let solve="p";const formulas={p:"P = n × R × T ÷ V",v:"V = n × R × T ÷ P",n:"n = P × V ÷ (R × T)",t:"T = P × V ÷ (n × R)"},units={p:"atm",v:"L",n:"mol",t:"K"};
function calc(){const p=Number($("#p").value)||0,v=Number($("#v").value)||0,n=Number($("#n").value)||0,t=Number($("#t").value)||0;let r=0;if(solve==="p")r=n*R*t/v;if(solve==="v")r=n*R*t/p;if(solve==="n")r=p*v/(R*t);if(solve==="t")r=p*v/(n*R);$("#answer").textContent=(Number.isFinite(r)?r:0).toLocaleString("es-AR",{maximumFractionDigits:3})+" "+units[solve];$("#celsius").textContent=(solve==="t"?r-273.15:t-273.15).toLocaleString("es-AR",{maximumFractionDigits:1})+" °C";$("#check").textContent=r>0&&Number.isFinite(r)?"Datos consistentes":"Revisá los datos"}
function setSolve(s){solve=s;$$("[data-solve]").forEach(x=>x.classList.toggle("active",x.dataset.solve===s));$$("[data-field]").forEach(x=>{const off=x.dataset.field===s;x.classList.toggle("disabled",off);x.querySelector("input").disabled=off;if(off)x.querySelector("input").value=""});$("#formula").textContent=formulas[s];calc()}$$("[data-solve]").forEach(b=>b.onclick=()=>setSolve(b.dataset.solve));$$(".calc input").forEach(x=>x.oninput=calc);$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Resultado actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".area").forEach(b=>b.onclick=()=>{$$(".area").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent="Abriendo: "+t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast(b.closest(".card").querySelector("h3").textContent));calc();

})();
</script>
<style is:global>

