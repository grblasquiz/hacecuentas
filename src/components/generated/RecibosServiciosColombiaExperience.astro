<div class="mockup-recibos-servicios-colombia" set:html={`<section class="hero"><div class="wrap crumb"><b>Colombia</b> &nbsp;/&nbsp; Vida &nbsp;/&nbsp; Recibos de servicios</div><div class="wrap grid"><div class="copy"><span class="eyebrow">CREG · CRA · Subsidios por estrato</span><h1>Entendé por qué subió el recibo antes de recortar todo.</h1><p>Separá cargo fijo, consumo, subsidio o contribución y otros cobros. Mirá cuánto cambia la factura si bajás kWh o metros cúbicos.</p><div class="chips"><span>✓ Estratos 1 a 6</span><span>✓ Bloque de subsistencia</span><span>✓ Ahorro posible</span></div><div class="art"><div class="bill"><strong>Servicios del hogar</strong><i></i><i></i><i></i><div class="icons"><span>ϟ</span><span>◒</span><span>≈</span><span></span></div></div><div class="float"><small>FACTURA ESTIMADA</small><b id="art-value">$205.500</b><span id="art-copy">energía · estrato 3</span></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Revisá tu recibo</h2><p class="muted">Elegí el servicio y usá tu tarifa.</p></div><span class="tag">Referencia 2026-07</span></div><div class="label">¿Qué recibo estás mirando?</div><div class="cases"><button type="button" class="case active" data-mode="power"><i>ϟ</i>Energía</button><button type="button" class="case" data-mode="gas"><i>◒</i>Gas natural</button><button type="button" class="case" data-mode="water"><i>≈</i>Agua</button><button type="button" class="case" data-mode="internet"><i></i>Internet</button></div><div class="label">Datos de la factura</div><div class="fields"><div class="field"><label>Estrato de la vivienda</label><select id="stratum"><option value="1">Estrato 1 · subsidio hasta 60%</option><option value="2">Estrato 2 · subsidio hasta 50%</option><option value="3" selected>Estrato 3 · subsidio hasta 15%</option><option value="4">Estrato 4 · tarifa plena</option><option value="5">Estrato 5 · contribución 20%</option><option value="6">Estrato 6 · contribución 20%</option></select></div><div class="field utility"><label>Altura de la ciudad</label><select id="altitude"><option value="high">Ciudad alta</option><option value="low">Tierra caliente</option></select></div><div class="field utility"><label id="consumption-label">Consumo mensual</label><input id="consumption" value="200"></div><div class="field utility"><label id="rate-label">Tarifa por unidad</label><input id="rate" value="950"></div><div class="field utility"><label>Cargo fijo mensual</label><input id="fixed" value="12500"></div><div class="field utility"><label>Otros cargos del recibo</label><input id="others" value="18000"></div><div class="field utility"><label>Consumo que querés bajar</label><input id="saving" value="30"></div><div class="field hide internet"><label>Precio mensual del plan</label><input id="plan" value="79900"></div><div class="field hide internet"><label>Cargo de instalación</label><input id="installation" value="0"></div></div><section class="result"><div class="result-top"><div><small id="result-label">FACTURA ESTIMADA DEL MES</small><div class="value" id="result">$205.500</div></div><div class="badge"><small id="badge-label">Ajuste por estrato</small><b id="badge">-$18.525</b></div></div><div class="stats"><span id="s1l">CONSUMO VALORIZADO<b id="s1">$190.000</b></span><span id="s2l">BLOQUE SUBSIDIADO<b id="s2">130 kWh</b></span><span id="s3l">AHORRO POSIBLE<b id="s3">$28.500</b></span></div><button class="go" id="update" type="button">Actualizar recibo</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Tu factura, por componentes</span><h2>Qué parte es consumo y qué parte no</h2><p>El total mezcla cargos fijos, unidades consumidas, ajuste por estrato y otros conceptos de la misma factura.</p></header><div class="stack"><div class="bar"><i class="fixed" id="bar-fixed">Cargo fijo</i><i class="consume" id="bar-consume">Consumo</i><i class="adjust" id="bar-adjust">Estrato</i><i class="other" id="bar-other">Otros</i></div><div class="legend"><span>CARGO FIJO<b id="leg-fixed">$12.500</b></span><span>CONSUMO CON AJUSTE<b id="leg-consume">$175.000</b></span><span>SUBSIDIO / CONTRIBUCIÓN<b id="leg-adjust">$18.525</b></span><span>OTROS CARGOS<b id="leg-other">$18.000</b></span></div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3>Tu recibo, línea por línea</h3><div class="line"><span id="d1l">Consumo del mes</span><b id="d1">200 kWh</b></div><div class="line"><span id="d2l">Tarifa aplicada</span><b id="d2">$950</b></div><div class="line"><span id="d3l">Ajuste por estrato</span><b id="d3">-$18.525</b></div><div class="line"><span id="d4l">Cargo fijo y otros</span><b id="d4">$30.500</b></div><div class="line total"><strong id="d5l">Total estimado</strong><b id="d5">$201.975</b></div></article><article class="card"><h3>Antes de reclamar</h3><div class="rule"><i>1</i><div><b>Compará el consumo</b><span>Si subieron las unidades, buscá fuga o equipo nuevo.</span></div></div><div class="rule"><i>2</i><div><b>Compará la tarifa</b><span>Si el consumo es igual, revisá CU y nuevos cargos.</span></div></div><div class="rule"><i>3</i><div><b>Separá lo que no es servicio</b><span>Aseo, alumbrado y financiaciones no son consumo.</span></div></div><div class="warning">Las tarifas cambian por operador y mes. Reemplazá siempre el valor de referencia por el de tu factura.</div></article></div></section>
<section class="services"><div class="wrap"><header class="center"><span>Cuatro recibos, una misma lectura</span><h2>Qué mirar en cada servicio</h2></header><div class="servicegrid"><article class="service"><i>ϟ</i><h3>Energía</h3><p>CU por kWh y bloque de 130 o 173 kWh.</p><em>Regula CREG</em></article><article class="service"><i>◒</i><h3>Gas natural</h3><p>Tarifa por m³ y bloque subsidiado de 20 m³.</p><em>Regula CREG</em></article><article class="service"><i>≈</i><h3>Agua</h3><p>Acueducto + alcantarillado sobre el mismo m³.</p><em>Regula CRA</em></article><article class="service"><i></i><h3>Internet</h3><p>Precio comercial, instalación y costo anual.</p><em>Sin subsidio directo</em></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#9dd9cc">El estrato cambia la cuenta</span><h2>El subsidio termina antes que tu consumo.</h2><p>En estratos 1, 2 y 3 sólo se descuenta el bloque de subsistencia. Lo que excede ese límite se paga a tarifa plena.</p></div><div class="facts"><div><small>ESTRATO 1</small><b>Hasta 60%</b><span>Sobre el bloque</span></div><div><small>ESTRATO 4</small><b>Tarifa plena</b><span>Sin ajuste</span></div><div><small>ESTRATOS 5 Y 6</small><b>+20%</b><span>Sobre todo el consumo</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-recibos-servicios-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-recibos-servicios-colombia');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0),cop=x=>"$"+Math.round(x).toLocaleString("es-CO");let mode="power";const cfg={power:{name:"energía",unit:"kWh",rate:950,high:130,low:173},gas:{name:"gas natural",unit:"m³",rate:2450,high:20,low:20},water:{name:"agua",unit:"m³",rate:7200,high:11,low:16}};function stat(names,vals){["s1l","s2l","s3l"].forEach((id,i)=>$("#"+id).childNodes[0].nodeValue=names[i]);["s1","s2","s3"].forEach((id,i)=>$("#"+id).textContent=vals[i])}function calc(){let str=Number($("#stratum").value);if(mode==="internet"){let plan=n("#plan"),install=n("#installation"),monthly=plan+install/12,iva=str<=2?0:plan-plan/1.19,cheapest=55990,save=Math.max(0,plan-cheapest)*12;$("#result-label").textContent="COSTO MENSUAL REAL";$("#result").textContent=cop(monthly);$("#badge-label").textContent=str<=2?"IVA excluido":"IVA incluido";$("#badge").textContent=cop(iva);stat(["COSTO ANUAL","INSTALACIÓN PRORRATEADA","AHORRO ANUAL POSIBLE"],[cop(monthly*12),cop(install/12),cop(save)]);detail([["Plan mensual",cop(plan)],["Instalación",cop(install)],["IVA dentro del precio",cop(iva)],["Referencia más barata",cop(cheapest)],["Costo anual",cop(monthly*12)]]);updateVisual(plan,monthly,iva,install/12);$("#art-copy").textContent="internet · estrato "+str;return}let c=cfg[mode],cons=n("#consumption"),rate=n("#rate"),fixed=n("#fixed"),others=n("#others"),saving=n("#saving"),block=$("#altitude").value==="high"?c.high:c.low,factor={1:-.6,2:-.5,3:-.15,4:0,5:.2,6:.2}[str],full=cons*rate,subsidized=Math.min(cons,block),adjust=factor<0?subsidized*rate*factor:full*factor,service=full+adjust,total=fixed+service+others,outside=Math.max(0,cons-block),saveOutside=Math.min(saving,outside),saveInside=Math.max(0,saving-saveOutside),saved=factor<0?saveOutside*rate+saveInside*rate*(1+factor):saving*rate*(1+factor);$("#result-label").textContent="FACTURA ESTIMADA DEL MES";$("#result").textContent=cop(total);$("#badge-label").textContent=factor<0?"Subsidio estimado":factor>0?"Contribución":"Ajuste por estrato";$("#badge").textContent=(factor<0?"-":factor>0?"+":"")+cop(Math.abs(adjust));stat(["CONSUMO VALORIZADO","BLOQUE SUBSIDIADO","AHORRO POSIBLE"],[cop(full),block+" "+c.unit,cop(saved)]);detail([["Consumo del mes",cons+" "+c.unit],["Tarifa aplicada",cop(rate)],["Ajuste por estrato",(adjust<0?"-":"+")+cop(Math.abs(adjust))],["Cargo fijo y otros",cop(fixed+others)],["Total estimado",cop(total)]]);updateVisual(fixed,service,Math.abs(adjust),others);$("#art-copy").textContent=c.name+" · estrato "+str}
function detail(a){a.forEach((x,i)=>{$("#d"+(i+1)+"l").textContent=x[0];$("#d"+(i+1)).textContent=x[1]})}function updateVisual(fixed,consume,adjust,other){let total=Math.max(1,fixed+consume+other);$("#art-value").textContent=$("#result").textContent;$("#leg-fixed").textContent=cop(fixed);$("#leg-consume").textContent=cop(consume);$("#leg-adjust").textContent=cop(adjust);$("#leg-other").textContent=cop(other);[["fixed",fixed],["consume",consume],["adjust",adjust],["other",other]].forEach(x=>$("#bar-"+x[0]).style.width=Math.max(2,x[1]/total*100)+"%")}
function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$$(".utility").forEach(x=>x.classList.toggle("hide",m==="internet"));$$(".internet").forEach(x=>x.classList.toggle("hide",m!=="internet"));if(m!=="internet"){let c=cfg[m];$("#rate").value=c.rate;$("#consumption").value=m==="power"?200:m==="gas"?28:18;$("#consumption-label").textContent="Consumo mensual ("+c.unit+")";$("#rate-label").textContent="Tarifa por "+c.unit}calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Recibo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar recibo",1200)};setMode("power");

})();
</script>
