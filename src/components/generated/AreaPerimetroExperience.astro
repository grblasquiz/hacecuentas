---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-area-perimetro" set:html={`<div class="shell"><section class="hero"><div class="crumb">Matemática / Geometría</div><h1>Dibujá la medida antes de calcularla.</h1><p>Compará superficie, borde y cantidad de cuadrados sobre una misma mesa de trabajo.</p></section><section class="bench"><aside class="tools"><h2>Forma</h2><div><button class="shape on" data-shape="rect">Rectángulo</button><button class="shape" data-shape="circle">Círculo</button><button class="shape" data-shape="triangle">Triángulo</button></div></aside><section class="canvas"><div class="figure" id="figure"><span class="dimension dimw" id="dw"></span><span class="dimension dimh" id="dh"></span></div></section><aside class="result"><h2>Medidas del dibujo</h2><div class="field"><label><span id="labelA">Base</span><output id="outA">8 m</output></label><input id="a" type="range" min="1" max="15" value="8"></div><div class="field" id="fieldB"><label><span id="labelB">Altura</span><output id="outB">5 m</output></label><input id="b" type="range" min="1" max="12" value="5"></div><div class="formula" id="formula"></div><div class="number" id="area"></div><span>de superficie</span><div class="tiles">Borde completo: <b id="perimeter"></b><p id="explain"></p></div></aside></section></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-area-perimetro')?document.currentScript.previousElementSibling:document.querySelector('.mockup-area-perimetro');

let shape='rect';const $=x=>root.querySelector("#"+x);
function draw(){let a=+$('a').value,b=+$('b').value,A,P,f; if(shape==='rect'){A=a*b;P=2*(a+b);f=`${a} × ${b}`;$('labelA').textContent='Base';$('labelB').textContent='Altura';$('fieldB').hidden=false}
if(shape==='circle'){A=Math.PI*a*a;P=2*Math.PI*a;f=`π × ${a}²`;$('labelA').textContent='Radio';$('fieldB').hidden=true}
if(shape==='triangle'){A=a*b/2;P=a+2*Math.sqrt((a/2)**2+b**2);f=`(${a} × ${b}) ÷ 2`;$('labelA').textContent='Base';$('labelB').textContent='Altura';$('fieldB').hidden=false}
$('figure').className='figure '+(shape==='rect'?'':shape);$('figure').style.width=(160+a*18)+'px';if(shape!=='circle')$('figure').style.height=(110+b*18)+'px';$('dw').textContent=(shape==='circle'?'r = ':'')+a+' m';$('dh').textContent=shape==='circle'?'':b+' m';$('outA').textContent=a+' m';$('outB').textContent=b+' m';$('formula').textContent=f;$('area').innerHTML=`${A.toFixed(1)} <small>m²</small>`;$('perimeter').textContent=P.toFixed(1)+' m';$('explain').textContent='El área cubre el interior; el perímetro recorre únicamente el contorno.'}
root.querySelectorAll('.shape').forEach(x=>x.onclick=()=>{shape=x.dataset.shape;root.querySelectorAll('.shape').forEach(y=>y.classList.toggle('on',y===x));draw()});root.querySelectorAll('input').forEach(x=>x.oninput=draw);draw();

})();
</script>
<style is:global>

.mockup-area-perimetro{--blue:#174b7a;--ink:#172a34;--muted:#63727a;--line:#d9e2df;--yellow:#ffd567;--coral:#dd684f;--paper:#f4f7f5}.mockup-area-perimetro *{box-sizing:border-box}.mockup-area-perimetro{margin:0;background:var(--paper);color:var(--ink);font:15px/1.4 Inter,system-ui}.mockup-area-perimetro button,.mockup-area-perimetro input{font:inherit}.mockup-area-perimetro .shell{max-width:1180px;margin:auto;padding:0 22px}.mockup-area-perimetro .hero{padding:38px 0 24px}.mockup-area-perimetro .crumb{color:var(--blue);font-weight:800}.mockup-area-perimetro .hero h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:28px 0 12px}.mockup-area-perimetro .hero p{font-size:18px;color:var(--muted)}.mockup-area-perimetro .bench{display:grid;grid-template-columns:180px 1fr 280px;min-height:570px;background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden;margin:20px 0 55px;box-shadow:0 20px 50px #173f4b12}.mockup-area-perimetro .tools{padding:20px;border-right:1px solid var(--line)}.mockup-area-perimetro .tools h2,.mockup-area-perimetro .result h2{font-size:13px;text-transform:uppercase;letter-spacing:.12em}.mockup-area-perimetro .shape{width:100%;padding:13px;border:1px solid var(--line);border-radius:13px;background:#fff;text-align:left;font-weight:850;margin:5px 0;cursor:pointer;color:var(--ink)}.mockup-area-perimetro .shape.on{background:var(--blue);color:#fff}.mockup-area-perimetro .canvas{position:relative;background-image:linear-gradient(#dce6e2 1px,transparent 1px),linear-gradient(90deg,#dce6e2 1px,transparent 1px);background-size:25px 25px;display:grid;place-items:center;padding:45px}.mockup-area-perimetro .figure{width:300px;height:200px;background:color-mix(in srgb,var(--yellow),#fff 20%);border:6px solid var(--blue);position:relative;transition:.25s}.mockup-area-perimetro .figure.circle{width:230px!important;height:230px!important;border-radius:50%}.mockup-area-perimetro .figure.triangle{background:transparent;border:0;width:300px;height:230px;clip-path:polygon(50% 0,100% 100%,0 100%);background:var(--blue)}.mockup-area-perimetro .figure.triangle:after{content:"";position:absolute;inset:8px;clip-path:inherit;background:var(--yellow)}.mockup-area-perimetro .dimension{position:absolute;background:#fff;border:2px solid var(--coral);border-radius:9px;padding:5px 8px;font-weight:900;z-index:2}.mockup-area-perimetro .dimw{left:50%;bottom:-25px;transform:translateX(-50%)}.mockup-area-perimetro .dimh{right:-28px;top:50%;transform:translateY(-50%)}.mockup-area-perimetro .result{padding:22px;border-left:1px solid var(--line);background:#fcfdfc}.mockup-area-perimetro .field{margin:18px 0}.mockup-area-perimetro .field label{display:flex;justify-content:space-between;font-weight:800}.mockup-area-perimetro .field input{width:100%;accent-color:var(--coral)}.mockup-area-perimetro .number{font-size:38px;font-weight:950;color:var(--blue);margin:4px 0}.mockup-area-perimetro .number small{font-size:13px;color:var(--muted)}.mockup-area-perimetro .formula{padding:15px;border-radius:14px;background:#e4f0eb;font:700 16px ui-monospace,monospace}.mockup-area-perimetro .tiles{margin-top:20px;padding-top:18px;border-top:1px solid var(--line)}.mockup-area-perimetro .tiles b{font-size:22px}@media(max-width:850px){.mockup-area-perimetro .bench{grid-template-columns:1fr}.mockup-area-perimetro .tools{border:0}.mockup-area-perimetro .tools div{display:flex;gap:7px}.mockup-area-perimetro .canvas{min-height:390px}.mockup-area-perimetro .result{border:0}.mockup-area-perimetro .figure{transform:scale(.8)}}
.mockup-area-perimetro { width:100%; overflow:hidden; }
.mockup-area-perimetro .top, .mockup-area-perimetro header.top { display:none !important; }
.mockup-area-perimetro .foot { display:none !important; }
.mockup-area-perimetro .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-area-perimetro .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-area-perimetro .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-area-perimetro .support-real summary { cursor:pointer; font-weight:750; }
.mockup-area-perimetro .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-area-perimetro :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-area-perimetro input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-area-perimetro input[type="number"]::-webkit-inner-spin-button, .mockup-area-perimetro input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-area-perimetro .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-area-perimetro support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
