---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-liquidacion-latam" set:html={`<div class="crumb">Trabajo / Liquidación LATAM</div><h1>Primero identificá conceptos. Después elegí el país.</h1><p class="lead">La estructura de una liquidación se parece en la región, pero las reglas, topes y nombres cambian por jurisdicción.</p><div class="case"><label>País<select id="country"><option value="ar">Argentina</option><option value="mx">México</option><option value="co">Colombia</option><option value="cl">Chile</option></select></label><label>Sueldo mensual<input id="salary" type="number" value="1500000"></label><label>Meses trabajados<input id="months" type="number" value="30"></label><label>Salida<select id="exit"><option value="dismissal">Despido sin causa</option><option value="resign">Renuncia</option></select></label></div><section class="map"><div class="concepts" id="concepts"></div><aside class="total"><span>Estimación educativa</span><strong id="amount"></strong><p id="reading"></p><div class="legal">No es asesoramiento legal ni reemplaza una liquidación profesional. Convenio, salario base, topes, causa y fechas cambian el cálculo.</div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-liquidacion-latam')?document.currentScript.previousElementSibling:document.querySelector('.mockup-liquidacion-latam');

const $=x=>root.querySelector("#"+x),rules={ar:{annual:'SAC proporcional',leave:'Vacaciones no gozadas/proporcionales',dismiss:'Art. 245, preaviso e integración si corresponden',source:'Ley de Contrato de Trabajo actualizada'},mx:{annual:'Aguinaldo proporcional',leave:'Vacaciones y prima vacacional',dismiss:'Indemnización constitucional, 20 días/año y prima de antigüedad según el caso',source:'PROFEDET / Ley Federal del Trabajo'},co:{annual:'Prima de servicios proporcional',leave:'Vacaciones pendientes/proporcionales',dismiss:'Indemnización según contrato, salario y antigüedad',source:'Ministerio del Trabajo de Colombia'},cl:{annual:'Beneficios pendientes',leave:'Feriado pendiente y proporcional',dismiss:'Aviso previo y años de servicio si la causal da derecho',source:'Dirección del Trabajo de Chile'}};function render(){let s=+$('salary').value,m=+$('months').value,dismiss=$('exit').value==='dismissal',r=rules[$('country').value],items=[['Remuneración pendiente','Días trabajados y conceptos ya devengados',true],[r.annual,'Pago anual propio del país',true],[r.leave,'Descanso pendiente al terminar',true],[r.dismiss,'Depende de causal, contrato y topes',dismiss],['Descuentos y aportes','Comprobar deducciones y seguridad social',true]];$('concepts').innerHTML=items.map(x=>`<div class=\"concept ${x[2]?'':'off'}\"><i>${x[2]?'✓':'—'}</i><span><b>${x[0]}</b><br><small>${x[1]}</small></span><b>${x[2]?'Revisar':'No asumir'}</b></div>`).join('');$('amount').textContent=dismiss?'Puede haber indemnización':'Finiquito, no siempre indemnización';$('reading').textContent=`Cargaste ${m} meses y un sueldo de ${s.toLocaleString('es-AR')}. No generamos un total falso: la base y la fórmula cambian por país. Fuente base: ${r.source}.`}
root.querySelectorAll('input,select').forEach(x=>x.oninput=render);render();
})();
</script>
<style is:global>
.mockup-liquidacion-latam{--blue:#174b7a;--ink:#182a32;--muted:#65747c;--line:#d7e1df;--orange:#e47a45;--green:#3d9d77;--paper:#f5f7f5}.mockup-liquidacion-latam *{box-sizing:border-box}.mockup-liquidacion-latam{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-liquidacion-latam input,.mockup-liquidacion-latam select{font:inherit}.mockup-liquidacion-latam .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-liquidacion-latam .crumb{color:var(--blue);font-weight:850}.mockup-liquidacion-latam h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-liquidacion-latam .lead{font-size:18px;color:var(--muted)}.mockup-liquidacion-latam .case{display:flex;gap:10px;flex-wrap:wrap;margin:25px 0}.mockup-liquidacion-latam .case label{background:#fff;border:1px solid var(--line);border-radius:14px;padding:10px 14px;font-size:12px;font-weight:850}.mockup-liquidacion-latam .case input,.mockup-liquidacion-latam .case select{display:block;border:0;padding-top:6px;font-weight:900;color:var(--ink)}.mockup-liquidacion-latam .map{display:grid;grid-template-columns:1fr 330px;gap:20px}.mockup-liquidacion-latam .concepts,.mockup-liquidacion-latam .total{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-liquidacion-latam .concept{display:grid;grid-template-columns:35px 1fr auto;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}.mockup-liquidacion-latam .concept i{width:30px;height:30px;border-radius:50%;background:#dff2e9;color:var(--green);display:grid;place-items:center;font-style:normal}.mockup-liquidacion-latam .concept.off{opacity:.45}.mockup-liquidacion-latam .concept b:last-child{color:var(--blue)}.mockup-liquidacion-latam .total{background:var(--blue);color:#fff}.mockup-liquidacion-latam .total strong{font-size:40px;display:block}.mockup-liquidacion-latam .total p{color:#dce9ef}.mockup-liquidacion-latam .legal{margin-top:16px;padding:14px;background:#fff2dd;color:var(--ink);border-radius:14px}@media(max-width:760px){.mockup-liquidacion-latam .map{grid-template-columns:1fr}}
.mockup-liquidacion-latam { width:100%; overflow:hidden; }
.mockup-liquidacion-latam .top, .mockup-liquidacion-latam header.top { display:none !important; }
.mockup-liquidacion-latam .foot { display:none !important; }
.mockup-liquidacion-latam .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-liquidacion-latam .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-liquidacion-latam .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-liquidacion-latam .support-real summary { cursor:pointer; font-weight:750; }
.mockup-liquidacion-latam .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-liquidacion-latam :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-liquidacion-latam input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-liquidacion-latam input[type="number"]::-webkit-inner-spin-button, .mockup-liquidacion-latam input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-liquidacion-latam .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-liquidacion-latam support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
