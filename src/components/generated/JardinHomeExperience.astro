<div class="mockup-jardin-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Jardín</div><div class="heroGrid"><div><span class="eyebrow">Cuidar mejor, usar lo justo</span><h1>Un jardín sano no necesita agua de más. Necesita la cuenta correcta.</h1><p class="lead">Riego, tierra, macetas, césped y calendario. Calculá cantidades para cuidar tus plantas sin desperdiciar recursos.</p><div class="trust"><span>✓ Clima considerado</span><span>✓ Pérdidas visibles</span><span>✓ Litros y minutos</span></div><div class="scene"><i class="sun"></i><i class="stem"></i><i class="leafA"></i><i class="leafB"></i><i class="leafC"></i><i class="pot"></i></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Cuánta agua necesita?</h2><p>Superficie, clima y sistema de riego.</p></div><span class="live">RIEGO EN VIVO</span></div><div class="presets"><button class="preset active" data-preset="lawn">Césped</button><button class="preset" data-preset="bed">Cantero</button><button class="preset" data-preset="pots">Macetas</button></div><div class="fields"><div class="field"><label>Superficie regada</label><div class="input"><input id="area" type="number" min=".1" step=".1" value="30"><span>m²</span></div></div><div class="field"><label>Necesidad base semanal</label><div class="input"><input id="need" type="number" min="1" value="25"><span>L/m²</span></div></div><div class="field"><label>Clima actual</label><select id="climate"><option value=".75">Fresco o húmedo</option><option value="1" selected>Templado</option><option value="1.3">Caluroso o seco</option></select></div><div class="field"><label>Riegos por semana</label><div class="input"><input id="frequency" type="number" min="1" max="14" value="3"><span>veces</span></div></div><div class="field"><label>Eficiencia del sistema</label><select id="efficiency"><option value=".6">Manguera · 60%</option><option value=".75" selected>Aspersión · 75%</option><option value=".9">Goteo · 90%</option></select></div><div class="field"><label>Caudal disponible</label><div class="input"><input id="flow" type="number" min=".1" step=".1" value="12"><span>L/min</span></div></div></div><button class="primary" id="calculate">Actualizar riego</button><div class="result"><div class="resultTop"><div><small>AGUA APLICADA POR SEMANA</small><div class="amount" id="weekly">1.000 litros</div></div><span class="badge" id="presetLabel">Césped</span></div><div class="resultGrid"><div class="metric"><span>POR CADA RIEGO</span><b id="perWatering">333 L</b></div><div class="metric"><span>TIEMPO POR RIEGO</span><b id="minutes">28 min</b></div><div class="metric"><span>AGUA EFECTIVA</span><b id="effective">750 L</b></div></div><div class="water"><i id="waterBar"></i></div><p class="note" id="note">Regá temprano y revisá la humedad real del suelo antes de repetir.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por tu espacio</span><h2>¿Qué necesitás resolver?</h2><p>Elegí una necesidad y encontrá primero las herramientas relacionadas.</p></div><div class="needs"><button class="need active" data-filter="water"><span class="icon">≈</span><h3>Organizar el riego</h3><p>Litros, frecuencia y tiempo.</p><em>→</em></button><button class="need" data-filter="pots"><span class="icon">⌑</span><h3>Elegir macetas</h3><p>Volumen, sustrato y drenaje.</p><em>→</em></button><button class="need" data-filter="lawn"><span class="icon">≋</span><h3>Cuidar el césped</h3><p>Semilla, riego y superficie.</p><em>→</em></button><button class="need" data-filter="soil"><span class="icon">▰</span><h3>Calcular tierra</h3><p>Litros y bolsas para canteros.</p><em>→</em></button><button class="need" data-filter="calendar"><span class="icon">□</span><h3>Planificar tareas</h3><p>Siembra, poda y mantenimiento.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas para el jardín</span><h2>Las cantidades justas para que crezca mejor.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="water">Riego</button><button class="filter" data-filter="pots">Macetas</button><button class="filter" data-filter="lawn">Césped</button><button class="filter" data-filter="soil">Tierra</button><button class="filter" data-filter="calendar">Calendario</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="water lawn pots" data-text="riego agua litros jardín césped macetas"><span class="tag">Uso eficiente</span><h3>Calculadora de riego</h3><p>Estimá litros y minutos según superficie, clima y sistema.</p><a class="hc-tool-link" href="/jardin/riego">Calcular riego →</a></article><article class="card" data-cat="soil pots" data-text="tierra sustrato cantero maceta volumen bolsas"><span class="tag">Sustrato</span><h3>Tierra para macetas y canteros</h3><p>Convertí medidas en litros y bolsas necesarias.</p><a class="hc-tool-link" href="/jardin/tierra-y-macetas">Calcular tierra →</a></article><article class="card" data-cat="pots" data-text="maceta volumen diámetro altura planta drenaje"><span class="tag">Contenedores</span><h3>Volumen de maceta</h3><p>Estimá capacidad según forma y medidas.</p><a class="hc-tool-link" href="/jardin/tierra-y-macetas">Calcular volumen →</a></article><article class="card" data-cat="lawn water" data-text="césped semilla superficie riego jardín"><span class="tag">Césped</span><h3>Césped por superficie</h3><p>Semilla, tierra y agua para cubrir un área.</p><a class="hc-tool-link" href="/jardin/cuantas-plantas">Planificar césped →</a></article><article class="card" data-cat="calendar" data-text="calendario jardín siembra poda fertilizar estación"><span class="tag">Estaciones</span><h3>Calendario del jardín</h3><p>Ordená siembra, trasplante, poda y fertilización.</p><a class="hc-tool-link" href="/jardin/huerta">Ver calendario →</a></article><article class="card" data-cat="soil calendar" data-text="compost abono fertilizante proporción tierra"><span class="tag">Suelo</span><h3>Mezcla de sustrato</h3><p>Calculá proporciones de tierra, compost y drenaje.</p><a class="hc-tool-link" href="/jardin/tierra-y-macetas">Armar mezcla →</a></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="season"><div class="wrap seasonGrid"><div><span class="eyebrow" style="color:var(--yellow)">La estación cambia la cuenta</span><h2>El jardín no necesita lo mismo todo el año.</h2><p>Ajustá riego, poda y nutrientes al clima real. Un calendario rígido sirve menos que observar suelo y plantas.</p></div><div class="seasonList"><button class="seasonBtn active" data-season="Verano"><span><b>Verano · controlar humedad</b><small>Regá temprano y reducí evaporación.</small></span><b>→</b></button><button class="seasonBtn" data-season="Otoño"><span><b>Otoño · preparar y limpiar</b><small>Compost, hojas y menor frecuencia.</small></span><b>→</b></button><button class="seasonBtn" data-season="Invierno"><span><b>Invierno · proteger</b><small>Heladas, drenaje y riego moderado.</small></span><b>→</b></button><button class="seasonBtn" data-season="Primavera"><span><b>Primavera · activar</b><small>Siembra, trasplante y crecimiento.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-jardin-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-jardin-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],fmt=n=>n.toLocaleString("es-AR",{maximumFractionDigits:1});let current="lawn";function calc(){const area=Math.max(.1,+$("#area").value||.1),need=Math.max(1,+$("#need").value||1),climate=+$("#climate").value,freq=Math.max(1,+$("#frequency").value||1),eff=+$("#efficiency").value,flow=Math.max(.1,+$("#flow").value||.1),effective=area*need*climate,applied=effective/eff,per=applied/freq,min=per/flow;$("#weekly").textContent=fmt(applied)+" litros";$("#perWatering").textContent=fmt(per)+" L";$("#minutes").textContent=fmt(min)+" min";$("#effective").textContent=fmt(effective)+" L";$("#presetLabel").textContent={lawn:"Césped",bed:"Cantero",pots:"Macetas"}[current];$("#waterBar").style.width=Math.min(100,eff*100)+"%";$("#note").textContent=`El sistema entrega aproximadamente el ${Math.round(eff*100)}% del agua aplicada. Revisá la humedad real antes de repetir.`}
$$(".calc input,.calc select").forEach(x=>x.oninput=calc);const presets={lawn:[30,25,1,3,.75,12],bed:[12,18,1,3,.9,4],pots:[3,12,1.3,4,.6,8]};$$(".preset").forEach(b=>b.onclick=()=>{current=b.dataset.preset;$$(".preset").forEach(x=>x.classList.toggle("active",x===b));const v=presets[current],ids=["area","need","climate","frequency","efficiency","flow"];ids.forEach((id,i)=>$("#"+id).value=v[i]);calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Riego actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".seasonBtn").forEach(b=>b.onclick=()=>{$$(".seasonBtn").forEach(x=>x.classList.toggle("active",x===b));toast("Estación seleccionada: "+b.dataset.season)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
<style is:global>

