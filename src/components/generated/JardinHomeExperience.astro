.mockup-jardin-home .calc{background:#fff;border:1px solid var(--line);border-radius:25px;padding:25px;box-shadow:var(--shadow)}.mockup-jardin-home .calcHead{display:flex;justify-content:space-between;gap:14px}.mockup-jardin-home .calc h2{font-size:24px;letter-spacing:-.035em;margin:0}.mockup-jardin-home .calcHead p{font-size:12px;color:var(--muted);margin:5px 0 0}.mockup-jardin-home .live{background:var(--mint);color:#326c43;padding:7px 9px;border-radius:99px;font-size:9px;font-weight:950;height:max-content}.mockup-jardin-home .presets{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:17px 0 13px}.mockup-jardin-home .preset{border:1px solid var(--line);background:#fbfcfa;border-radius:10px;padding:10px 4px;font-size:9px;font-weight:900;color:var(--muted);cursor:pointer}.mockup-jardin-home .preset.active{background:var(--mint);border-color:#8cb58a;color:#356d43}.mockup-jardin-home .fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mockup-jardin-home .field label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:900;margin-bottom:5px}.mockup-jardin-home .input,.mockup-jardin-home .field select{height:44px;width:100%;border:1px solid #d7dfd5;border-radius:10px;padding:0 10px;background:#fff;display:flex;align-items:center;gap:7px}.mockup-jardin-home .input input{border:0;outline:0;width:100%;min-width:0;font-weight:850;color:var(--ink)}.mockup-jardin-home .field select{font-weight:850;color:var(--ink)}.mockup-jardin-home .primary{height:49px;width:100%;border:0;border-radius:12px;background:var(--green);color:#fff;font-weight:950;margin-top:12px;cursor:pointer}.mockup-jardin-home .result{margin-top:13px;background:var(--dark);color:#fff;border-radius:18px;padding:18px}.mockup-jardin-home .resultTop{display:flex;justify-content:space-between;align-items:end;gap:10px}.mockup-jardin-home .result small{font-size:8px;letter-spacing:.09em;color:#c3d5c8}.mockup-jardin-home .amount{font-size:37px;font-weight:950;letter-spacing:-.05em;margin:3px 0}.mockup-jardin-home .badge{background:#ffffff14;border:1px solid #ffffff1c;padding:8px 10px;border-radius:99px;font-size:9px;font-weight:900}.mockup-jardin-home .resultGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.mockup-jardin-home .metric{background:#ffffff0c;border:1px solid #ffffff14;border-radius:9px;padding:9px}.mockup-jardin-home .metric span{font-size:7px;color:#c3d4c7;display:block}.mockup-jardin-home .metric b{font-size:10px}.mockup-jardin-home .water{height:9px;border-radius:9px;background:#ffffff17;margin-top:12px;overflow:hidden}.mockup-jardin-home .water i{display:block;height:100%;width:78%;background:#72b9c4;border-radius:9px;transition:.3s}.mockup-jardin-home .note{font-size:9px;color:#c7d5ca;margin:9px 0 0}
.mockup-jardin-home section{padding:76px 0}.mockup-jardin-home .sectionHead{text-align:center;max-width:730px;margin:0 auto 38px}.mockup-jardin-home .sectionHead h2{font-size:40px;letter-spacing:-.045em;margin:10px 0}.mockup-jardin-home .sectionHead p{color:var(--muted);line-height:1.55}.mockup-jardin-home .needs{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.mockup-jardin-home .need{text-align:left;border:1px solid var(--line);background:#fff;border-radius:19px;padding:20px;min-height:185px;position:relative;color:var(--ink);cursor:pointer;transition:.2s}.mockup-jardin-home .need:hover,.mockup-jardin-home .need.active{transform:translateY(-3px);border-color:#81a97c;box-shadow:0 15px 35px #31502e15}.mockup-jardin-home .need.active{background:var(--dark);color:#fff}.mockup-jardin-home .need.active p{color:#cbd8cd}.mockup-jardin-home .icon{width:39px;height:39px;border-radius:11px;background:var(--mint);color:var(--green);display:grid;place-items:center;font-weight:950}.mockup-jardin-home .need h3{font-size:16px;margin:16px 0 7px}.mockup-jardin-home .need p{font-size:10px;line-height:1.5;color:var(--muted);margin:0}.mockup-jardin-home .need em{position:absolute;right:16px;bottom:14px;font-style:normal;color:var(--clay);font-weight:950}
