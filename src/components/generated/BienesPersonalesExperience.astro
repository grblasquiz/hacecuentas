---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-bienes-personales" set:html={`
<section class="hero"><div class="wrap"><div class="crumb">Impuestos / Bienes Personales</div><div class="hero-grid"><div><div class="eyebrow">Primero si pagás. Después cuánto.</div><h1>¿Tu patrimonio supera el mínimo?</h1><p class="lead">Sumá los bienes al 31 de diciembre, aplicá la deducción de vivienda y mirá si quedás alcanzado. Sólo el excedente tributa.</p><div class="chips"><span class="chip">✓ Período fiscal 2025</span><span class="chip">✓ Ley 27.743</span><span class="chip">✓ Bienes locales y exterior</span></div></div><div class="balance"><span class="stand"></span><span class="beam"></span><span class="pan left"></span><span class="pan right"></span><span class="base"></span><div class="mni"><small>MÍNIMO NO IMPONIBLE</small><strong>$384,7 millones</strong></div></div></div></div></section>
<section class="wrap"><div class="tool"><div class="cases" id="cases"></div><div class="calc"><div class="form"><h2 id="formTitle">Tu patrimonio al 31 de diciembre</h2><p class="hint" id="formHint">Cargá valores fiscales, no valores de mercado.</p><div class="fields" id="fields"></div><button class="primary" id="calculate">Actualizar patrimonio</button></div><div class="result"><div class="caps">RESULTADO DEL PERÍODO</div><div class="answer good" id="mainResult">No pagás</div><div class="sub" id="resultText"></div><span class="status" id="status">Estás debajo del mínimo</span><div class="scale-labels"><span>Exento</span><span>0,50%</span><span>0,75%</span><span>1,00%</span></div><div class="scale"><span class="marker" id="marker"></span></div><div class="rows" id="rows"></div></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">La cuenta en orden</div><h2>Cuatro pasos, sin gravar dos veces.</h2><p>La vivienda y el mínimo no imponible cumplen funciones distintas y se aplican en ese orden.</p></div><div class="steps"><article class="step"><span class="num">1</span><b>Sumá los bienes</b><p>Valores fiscales y cotizaciones al 31 de diciembre.</p></article><article class="step"><span class="num">2</span><b>Deducí tu vivienda</b><p>Hasta $1.346,5 millones si es casa-habitación.</p></article><article class="step"><span class="num">3</span><b>Restá el mínimo</b><p>$384,7 millones sobre la base restante.</p></article><article class="step"><span class="num">4</span><b>Aplicá la escala</b><p>Sólo al excedente, tramo por tramo.</p></article></div></div></section>
<section class="rates"><div class="wrap rates-grid"><div><div class="eyebrow">Escala progresiva</div><h2>No aplicás una tasa a todo.</h2><p>Cada alícuota se usa únicamente sobre la porción que cae dentro de ese tramo. Por eso la tasa efectiva es menor que la marginal.</p></div><div class="rate-cards"><article class="rate"><small>PRIMER TRAMO</small><strong>0,50%</strong><span>Hasta $52,7 M de excedente</span></article><article class="rate"><small>SEGUNDO TRAMO</small><strong>0,75%</strong><span>Hasta $114,1 M de excedente</span></article><article class="rate"><small>TRAMO SUPERIOR</small><strong>1,00%</strong><span>Sobre el excedente restante</span></article></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-bienes-personales')?document.currentScript.previousElementSibling:document.querySelector('.mockup-bienes-personales');

const MNI=384728044.57,HOUSE_CAP=1346548155.99,T1=52664283.73,T2=114105948.16;
const modes=[
{id:"base",icon:"⌂",title:"Casa, auto y ahorros",desc:"Caso habitual",house:true,reibp:false},
{id:"rent",icon:"▤",title:"Alquilo",desc:"Sin deducción vivienda",house:false,reibp:false},
{id:"invest",icon:"↗",title:"Cripto y acciones",desc:"Activos financieros",house:true,reibp:false},
{id:"foreign",icon:"◎",title:"Bienes afuera",desc:"Misma escala",house:true,reibp:false},
{id:"reibp",icon:"◆",title:"Entré al REIBP",desc:"Cinco años anticipados",house:true,reibp:true},
{id:"value",icon:"▥",title:"Sólo valuación",desc:"Casa y auto fiscal",house:true,reibp:false,valuation:true}
];let active="base";const fieldsBase=[["house","Casa-habitación",900000000],["otherHomes","Otros inmuebles",0],["car","Auto 0 km / tabla",30000000],["age","Antigüedad del auto",5,false],["investments","Plazos fijos, fondos y acciones",40000000],["crypto","Cripto al 31 de diciembre",5000000],["foreign","Bienes en el exterior",0],["other","Efectivo y otros bienes",3000000]];
const $=id=>root.querySelector("#"+id),ars=n=>"$"+Math.round(n).toLocaleString("es-AR"),mode=()=>modes.find(x=>x.id===active);
function tax(excess){if(excess<=0)return 0;if(excess<=T1)return excess*.005;if(excess<=T2)return 263321.42+(excess-T1)*.0075;return 724133.89+(excess-T2)*.01}
function drawCases(){$("cases").innerHTML=modes.map(x=>`<button class="case ${x.id===active?"active":""}" data-id="${x.id}"><div class="ico">${x.icon}</div><b>${x.title}</b><span>${x.desc}</span></button>`).join("");root.querySelectorAll(".case").forEach(b=>b.onclick=()=>{active=b.dataset.id;render()})}
function drawFields(){let m=mode(),list=m.valuation?fieldsBase.slice(0,4):fieldsBase;$("fields").innerHTML=list.map(f=>`<div class="field"><label for="${f[0]}">${f[1]}</label><div class="${f[3]===false?"":"prefix"}"><input id="${f[0]}" type="number" step="1" min="0" value="${f[2]}"></div></div>`).join("");$("fields").querySelectorAll("input").forEach(x=>x.addEventListener("input",compute))}
function val(id){return $(id)?Math.max(0,+$(id).value||0):0}
function compute(){let m=mode(),auto=val("car")*Math.max(.4,1-val("age")*.08),house=val("house"),gross=house+val("otherHomes")+auto+val("investments")+val("crypto")+val("foreign")+val("other"),ded=m.house?Math.min(house,HOUSE_CAP):0,base=Math.max(0,gross-ded),excess=Math.max(0,base-MNI),due=m.reibp&&excess>0?base*.0045*5:tax(excess),pays=due>0,eff=base?due/base*100:0;if(m.valuation){$("mainResult").textContent=ars(house+auto);$("mainResult").className="answer good";$("resultText").textContent="Valuación fiscal combinada de casa y auto.";$("status").textContent="Es el insumo, no el impuesto";$("status").className="status";$("marker").style.left="12%";$("rows").innerHTML=`<div class="row"><span>Casa-habitación</span><strong>${ars(house)}</strong></div><div class="row"><span>Auto depreciado</span><strong>${ars(auto)}</strong></div><div class="row"><span>Factor del auto</span><strong>${Math.max(40,100-val("age")*8)}%</strong></div><div class="row"><span>Total fiscal</span><strong>${ars(house+auto)}</strong></div>`;return}$("mainResult").textContent=pays?ars(due):"No pagás";$("mainResult").className="answer "+(pays?"bad":"good");$("resultText").textContent=pays?`Tu base supera el mínimo por ${ars(excess)}. Sólo ese excedente tributa.`:`Tu base de ${ars(base)} queda por debajo del mínimo de ${ars(MNI)}.`;$("status").textContent=pays?(m.reibp?"REIBP · cinco años adelantados":`Alícuota efectiva ${eff.toFixed(3).replace(".",",")}%`):"Estás debajo del mínimo";$("status").className="status "+(pays?"bad":"");let marker=Math.min(97,base/(MNI+T2*2)*100);$("marker").style.left=`calc(${marker}% - 2px)`;$("rows").innerHTML=`<div class="row"><span>Patrimonio declarado</span><strong>${ars(gross)}</strong></div><div class="row"><span>Deducción casa</span><strong>− ${ars(ded)}</strong></div><div class="row"><span>Base imponible</span><strong>${ars(base)}</strong></div><div class="row"><span>Excedente gravado</span><strong>${ars(excess)}</strong></div><div class="row"><span>Impuesto estimado</span><strong>${pays?ars(due):"$0"}</strong></div>`}
function render(){drawCases();let m=mode();$("formTitle").textContent=m.valuation?"Valuación fiscal de tus bienes":m.reibp?"Tu base para el REIBP":"Tu patrimonio al 31 de diciembre";$("formHint").textContent=m.valuation?"La valuación fiscal es el insumo, no Bienes Personales.":m.house?"La casa-habitación se deduce hasta su tope.":"Al alquilar no se aplica la deducción de vivienda.";drawFields();compute()}$("calculate").onclick=()=>{compute();let b=$("calculate"),old=b.textContent;b.textContent="✓ Patrimonio actualizado";setTimeout(()=>b.textContent=old,1300)};render();

})();
</script>
<style is:global>

.mockup-bienes-personales{--ink:#121b30;--muted:#687184;--paper:#f6f5f1;--card:#fff;--violet:#6551ae;--violet2:#eeeafd;--green:#278269;--green2:#def2e9;--amber:#dd9f3e;--red:#c85c55;--line:#e0dfdc;--navy:#172b49}
.mockup-bienes-personales *{box-sizing:border-box}.mockup-bienes-personales [hidden]{display:none!important}.mockup-bienes-personales{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-bienes-personales button,.mockup-bienes-personales input,.mockup-bienes-personales select{font:inherit}.mockup-bienes-personales .wrap{max-width:1180px;margin:auto;padding:0 28px}
.mockup-bienes-personales header{height:84px;background:#fff;border-bottom:1px solid var(--line)}.mockup-bienes-personales header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-bienes-personales .brand{display:flex;align-items:center;gap:12px;font-weight:850;font-size:20px}.mockup-bienes-personales .logo{width:35px;height:35px;border-radius:8px;background:var(--navy);display:grid;place-items:center;color:#fff;font-size:14px}.mockup-bienes-personales .nav{display:flex;gap:26px;color:#4f5767;font-weight:700;font-size:14px}.mockup-bienes-personales .actions{margin-left:auto;display:flex;gap:10px}.mockup-bienes-personales .ghost{border:1px solid var(--line);background:#fff;padding:11px 15px;border-radius:12px;font-weight:750;color:var(--ink)}
.mockup-bienes-personales .hero{padding:58px 0 50px;background:linear-gradient(135deg,#faf9f6,#f1eef9)}.mockup-bienes-personales .crumb{color:#4e73c5;font-size:14px;margin-bottom:19px}.mockup-bienes-personales .hero-grid{display:grid;grid-template-columns:1.14fr .86fr;gap:65px;align-items:center}.mockup-bienes-personales .eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:900;color:var(--violet)}.mockup-bienes-personales h1{font-size:56px;line-height:1.02;letter-spacing:-.05em;margin:14px 0 19px}.mockup-bienes-personales .lead{font-size:19px;color:var(--muted);max-width:680px}.mockup-bienes-personales .chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.mockup-bienes-personales .chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 13px;font-size:13px;font-weight:780}
.mockup-bienes-personales .balance{height:340px;position:relative;display:grid;place-items:center}.mockup-bienes-personales .stand{position:absolute;width:13px;height:190px;background:var(--navy);top:54px;border-radius:10px}.mockup-bienes-personales .beam{position:absolute;width:300px;height:12px;background:var(--navy);top:75px;border-radius:10px}.mockup-bienes-personales .beam:after{content:"";position:absolute;width:33px;height:33px;border-radius:50%;background:var(--violet);left:50%;top:50%;transform:translate(-50%,-50%)}.mockup-bienes-personales .pan{position:absolute;top:86px;width:118px;height:82px;border:4px solid #8390a2;border-top:0;border-radius:0 0 70px 70px}.mockup-bienes-personales .pan.left{left:35px}.mockup-bienes-personales .pan.right{right:35px}.mockup-bienes-personales .pan:before,.mockup-bienes-personales .pan:after{content:"";position:absolute;width:2px;height:70px;background:#8390a2;top:-62px}.mockup-bienes-personales .pan:before{left:18px;transform:rotate(15deg)}.mockup-bienes-personales .pan:after{right:18px;transform:rotate(-15deg)}.mockup-bienes-personales .base{position:absolute;width:120px;height:24px;border-radius:10px;background:var(--navy);bottom:55px}.mockup-bienes-personales .mni{position:absolute;right:0;bottom:15px;background:#fff;border-radius:16px;padding:15px 18px;box-shadow:0 15px 35px #2d29461c}.mockup-bienes-personales .mni small{display:block;color:var(--muted);font-weight:900;font-size:10px;letter-spacing:.1em}.mockup-bienes-personales .mni strong{font-size:23px;color:var(--violet)}
.mockup-bienes-personales .tool{background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden;box-shadow:0 20px 55px #27233d10;margin-bottom:70px}.mockup-bienes-personales .cases{padding:22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.mockup-bienes-personales .case{min-height:92px;text-align:left;border:1px solid var(--line);background:#fbfbfb;border-radius:14px;padding:13px;cursor:pointer;color:var(--ink)}.mockup-bienes-personales .case b{display:block;font-size:12px;margin:4px 0}.mockup-bienes-personales .case span{font-size:10px;color:var(--muted)}.mockup-bienes-personales .case.active{border:2px solid var(--violet);background:#f3f0fd;padding:12px}.mockup-bienes-personales .ico{font-size:18px}
.mockup-bienes-personales .calc{display:grid;grid-template-columns:1fr 1fr}.mockup-bienes-personales .form{padding:31px}.mockup-bienes-personales .form h2{font-size:26px;letter-spacing:-.03em;margin:0 0 7px}.mockup-bienes-personales .hint{color:var(--muted);margin:0 0 23px}.mockup-bienes-personales .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-bienes-personales .field{display:flex;flex-direction:column;gap:7px}.mockup-bienes-personales .field label{font-size:13px;font-weight:800}.mockup-bienes-personales .field input,.mockup-bienes-personales .field select{width:100%;border:1px solid #cfd3da;border-radius:12px;background:#fff;padding:14px;outline:none;color:var(--ink)}.mockup-bienes-personales .field input:focus,.mockup-bienes-personales .field select:focus{border-color:var(--violet);box-shadow:0 0 0 3px #6551ae1a}.mockup-bienes-personales .prefix{position:relative}.mockup-bienes-personales .prefix:before{content:"$";position:absolute;left:14px;top:13px;color:var(--muted);font-weight:800}.mockup-bienes-personales .prefix input{padding-left:30px}.mockup-bienes-personales .primary{width:100%;border:0;background:var(--violet);color:#fff;border-radius:13px;padding:15px;font-weight:850;margin-top:20px;cursor:pointer}
.mockup-bienes-personales .result{background:var(--navy);color:#fff;padding:31px;position:relative;overflow:hidden}.mockup-bienes-personales .result:after{content:"";position:absolute;width:270px;height:270px;border-radius:50%;border:48px solid #ffffff08;right:-150px;bottom:-150px}.mockup-bienes-personales .caps{color:#c9c1ef;font-size:10px;letter-spacing:.13em;font-weight:900}.mockup-bienes-personales .answer{font-size:44px;line-height:1.04;font-weight:930;letter-spacing:-.045em;margin:15px 0 7px}.mockup-bienes-personales .answer.good{color:#76dbb7}.mockup-bienes-personales .answer.bad{color:#ffb099}.mockup-bienes-personales .sub{color:#d6dfea;min-height:49px}.mockup-bienes-personales .status{display:inline-block;padding:8px 12px;border-radius:99px;background:var(--green2);color:#17654e;font-size:13px;font-weight:850;margin:12px 0 22px}.mockup-bienes-personales .status.bad{background:#ffe3dd;color:#9a3b35}.mockup-bienes-personales .scale-labels{display:flex;justify-content:space-between;color:#b9c5d4;font-size:10px;font-weight:800}.mockup-bienes-personales .scale{height:12px;border-radius:99px;background:linear-gradient(90deg,#58b88f 0 54%,#e5b04e 54% 69%,#d7804e 69% 83%,#c75b58 83%);position:relative;margin:8px 0 23px}.mockup-bienes-personales .marker{position:absolute;width:5px;height:27px;background:#fff;border-radius:5px;top:-7px;left:13%;box-shadow:0 0 0 3px var(--navy)}.mockup-bienes-personales .rows{border-top:1px solid #ffffff24}.mockup-bienes-personales .row{display:flex;justify-content:space-between;gap:20px;padding:12px 0;border-bottom:1px solid #ffffff1b;color:#d5dfeb}.mockup-bienes-personales .row strong{color:#fff;text-align:right}
.mockup-bienes-personales .section{padding:10px 0 70px}.mockup-bienes-personales .section-head{text-align:center;max-width:720px;margin:0 auto 31px}.mockup-bienes-personales .section-head h2{font-size:39px;letter-spacing:-.04em;margin:8px 0}.mockup-bienes-personales .section-head p{color:var(--muted)}.mockup-bienes-personales .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.mockup-bienes-personales .step{background:#fff;border:1px solid var(--line);border-radius:18px;padding:21px}.mockup-bienes-personales .num{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;background:var(--violet2);color:var(--violet);font-weight:900;margin-bottom:15px}.mockup-bienes-personales .step b{display:block;margin-bottom:6px}.mockup-bienes-personales .step p{font-size:13px;color:var(--muted);margin:0}
.mockup-bienes-personales .rates{background:#edeaf5;padding:66px 0}.mockup-bienes-personales .rates-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:65px}.mockup-bienes-personales .rates h2{font-size:40px;line-height:1.08;margin:10px 0}.mockup-bienes-personales .rates p{color:var(--muted)}.mockup-bienes-personales .rate-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.mockup-bienes-personales .rate{background:#fff;border:1px solid var(--line);border-radius:17px;padding:21px}.mockup-bienes-personales .rate small{font-size:11px;color:var(--muted);font-weight:800}.mockup-bienes-personales .rate strong{display:block;font-size:29px;color:var(--violet);margin:8px 0}.mockup-bienes-personales .rate span{font-size:12px;color:var(--muted)}
.mockup-bienes-personales footer{background:#fff;border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:13px}
@media(max-width:850px){.mockup-bienes-personales .nav{display:none}.mockup-bienes-personales .hero-grid,.mockup-bienes-personales .calc,.mockup-bienes-personales .rates-grid{grid-template-columns:1fr}.mockup-bienes-personales .cases{display:flex;overflow:auto}.mockup-bienes-personales .case{min-width:160px}.mockup-bienes-personales .balance{height:280px}.mockup-bienes-personales .steps{grid-template-columns:1fr 1fr}.mockup-bienes-personales h1{font-size:45px}}@media(max-width:540px){.mockup-bienes-personales .wrap{padding:0 18px}.mockup-bienes-personales .hero{padding-top:35px}.mockup-bienes-personales .balance{display:none}.mockup-bienes-personales h1{font-size:39px}.mockup-bienes-personales .fields,.mockup-bienes-personales .steps,.mockup-bienes-personales .rate-cards{grid-template-columns:1fr}.mockup-bienes-personales .tool{border-radius:18px}.mockup-bienes-personales .form,.mockup-bienes-personales .result{padding:25px 20px}}

.mockup-bienes-personales { width:100%; overflow:hidden; }
.mockup-bienes-personales .top, .mockup-bienes-personales header.top { display:none !important; }
.mockup-bienes-personales .foot { display:none !important; }
.mockup-bienes-personales .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-bienes-personales .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-bienes-personales .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-bienes-personales .support-real summary { cursor:pointer; font-weight:750; }
.mockup-bienes-personales .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-bienes-personales :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-bienes-personales input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-bienes-personales input[type="number"]::-webkit-inner-spin-button, .mockup-bienes-personales input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-bienes-personales .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-bienes-personales support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
