---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-cuanta-leche-bebe" set:html={`
<section class="hero"><div class="hero-grid"><div><div class="crumb">Bebés / Cuánta leche toma</div><div class="eyebrow">Una referencia, no una obligación</div><h1>¿Cuánta leche puede tomar hoy?</h1><p class="lead">Estimá un rango diario y por toma según peso, edad y alimentación. Después mirá las señales del bebé: no todos toman lo mismo.</p><div class="trust"><span>Rango, no cifra rígida</span><span>Lactancia, fórmula o mixta</span><span>Señales de hambre y saciedad</span></div></div><div class="visual"><div class="bottle"><div class="milk" id="milk"></div><div class="scale"><i>240</i><i>180</i><i>120</i><i>60</i></div></div><div class="bubble"><small>Por toma</small><strong id="bubble">120–150 ml</strong></div></div></div></section>
<section class="tool"><div class="wrap"><div class="head2"><div><div class="kicker">Primero, su situación</div><h2>Calculá una guía para hoy</h2></div><p>Mostramos todas las formas de alimentación. Elegir una ajusta la explicación y los datos necesarios.</p></div><div class="cases"><button class="case active" data-case="formula"><b>Fórmula en mamadera</b><small>Estimar mililitros diarios y por toma.</small></button><button class="case" data-case="mixed"><b>Alimentación mixta</b><small>Orientar el complemento, sin medir el pecho.</small></button><button class="case" data-case="breast"><b>Lactancia directa</b><small>Usar frecuencia y señales, no mililitros.</small></button><button class="case" data-case="solids"><b>Ya empezó sólidos</b><small>La leche sigue siendo parte central del día.</small></button></div><div class="workspace"><section class="panel form"><h3>Datos del bebé</h3><p class="hint" id="hint">Para fórmula, el peso ayuda a estimar un rango diario orientativo.</p><div class="fields"><div class="field"><label for="age">Edad</label><input id="age" type="number" min="0" max="24" step=".5" value="4"><small>En meses.</small></div><div class="field"><label for="weight">Peso actual</label><input id="weight" type="number" min="2" max="18" step=".1" value="6.5"><small>En kilogramos.</small></div><div class="field"><label for="feeds">Tomas aproximadas</label><select id="feeds"><option>5</option><option selected>6</option><option>7</option><option>8</option><option>9</option><option>10</option></select></div><div class="field"><label for="premature">¿Nació prematuro?</label><select id="premature"><option value="no">No</option><option value="yes">Sí</option></select></div><div class="field full"><label for="observed">Cuánto suele tomar por vez</label><input id="observed" type="number" min="0" max="400" value="130"><small>Opcional: lo usamos para ubicarlo dentro del rango, no para juzgar una toma aislada.</small></div></div><div class="actions"><button class="primary" id="calculate">Actualizar orientación</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><div class="result-top"><div><span class="badge" id="badge">Dentro del rango esperable</span><div class="big" id="daily">780–975 ml</div><div class="caption" id="caption">Rango diario orientativo de fórmula.</div></div></div><div class="day" id="day"></div><div class="range"><b><span>Rango por toma</span><span id="perFeed">130–163 ml</span></b><div class="track"><i id="marker"></i></div><small id="compare">Los 130 ml que cargaste están dentro del rango orientativo.</small></div><div class="note" id="note">No hace falta que todas las tomas sean iguales. Mirá hambre, saciedad, pañales y evolución del peso.</div></aside></div></div></section>
<section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Lo que vale más que el número</div><h2>Señales para observar</h2><p>Una calculadora no reemplaza el seguimiento pediátrico, especialmente en prematuros, recién nacidos o si hay dificultad para alimentarse.</p></div><div class="signals"><div class="signal"><b>Hambre</b><span>Busca, gira la cabeza, abre la boca o lleva manos a la cara. El llanto suele ser una señal tardía.</span></div><div class="signal"><b>Saciedad</b><span>Afloja la succión, gira la cabeza, cierra la boca o se relaja. No conviene forzar a terminar.</span></div><div class="signal"><b>Va bien</b><span>Mojar pañales, estar activo y crecer según su curva pesan más que una toma puntual.</span></div><div class="signal warning"><b>Consultá pronto</b><span>Menos pañales mojados, decaimiento, vómitos repetidos, rechazo persistente o preocupación por el peso.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-cuanta-leche-bebe')?document.currentScript.previousElementSibling:document.querySelector('.mockup-cuanta-leche-bebe');
(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let mode="formula";const fmt=n=>Math.round(n).toLocaleString("es-AR");function calc(){const age=+$("[id=age]").value||0,w=+$("[id=weight]").value||0,feeds=+$("[id=feeds]").value||6,seen=+$("[id=observed]").value||0;let low=w*(age<1?150:age<6?120:100),high=w*(age<1?180:age<6?150:130);if(mode==="mixed"){low*=.35;high*=.7}if(mode==="solids"){low*=.75;high*=.9}const pl=low/feeds,ph=high/feeds;const direct=mode==="breast";$("#daily").textContent=direct?"8–12 tomas":"≈ "+fmt(low)+"–"+fmt(high)+" ml";$("#caption").textContent=direct?"Frecuencia frecuente en los primeros meses; puede variar mucho.":mode==="mixed"?"Complemento diario orientativo: la cantidad tomada al pecho no se mide.":mode==="solids"?"Leche diaria orientativa durante la incorporación de alimentos.":"Rango diario orientativo de fórmula.";$("#perFeed").textContent=direct?"A demanda":fmt(pl)+"–"+fmt(ph)+" ml";$("#bubble").textContent=direct?"A demanda":fmt(pl)+"–"+fmt(ph)+" ml";$("#milk").style.height=direct?"45%":Math.min(86,Math.max(24,ph/2.4))+"%";const within=direct||!seen||seen>=pl*.8&&seen<=ph*1.2;$("#badge").textContent=direct?"Mirá señales, no mililitros":within?"Dentro del rango orientativo":"Revisá el patrón completo";$("#badge").style.background=within?"#dcefe7":"#ffe0db";$("#badge").style.color=within?"#17513f":"#842d28";$("#compare").textContent=direct?"La duración de la toma no dice exactamente cuánto tomó. Observá deglución, saciedad y pañales.":!seen?"Cargá cuánto suele tomar para compararlo con el rango.":within?"Los "+fmt(seen)+" ml que cargaste están cerca del rango orientativo.":"Los "+fmt(seen)+" ml quedan fuera del rango orientativo, pero una toma aislada no alcanza para evaluar.";$("#note").textContent=$("[id=premature]").value==="yes"?"En bebés prematuros se usa edad corregida y un plan individual. Confirmá cantidades y fortificación con pediatría.":"No hace falta que todas las tomas sean iguales. Mirá hambre, saciedad, pañales y evolución del peso.";$("#day").innerHTML="";for(let i=0;i<Math.min(feeds,8);i++){$("#day").insertAdjacentHTML("beforeend",`<div class=\"feed\"><small>TOMA ${i+1}</small><strong>${direct?"A demanda":fmt((pl+ph)/2)+" ml"}</strong></div>`)}}
$$("[data-case]").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.case;$$("[data-case]").forEach(x=>x.classList.toggle("active",x===b));$("#hint").textContent={formula:"Para fórmula, el peso ayuda a estimar un rango diario orientativo.",mixed:"No intentamos medir la leche del pecho: estimamos sólo un complemento posible.",breast:"En lactancia directa importan frecuencia, deglución, pañales y crecimiento.",solids:"La incorporación de alimentos es progresiva; la leche sigue siendo importante."}[mode];calc()}));$$("input,select").forEach(x=>x.addEventListener("input",calc));$("#calculate").addEventListener("click",calc);$("#reset").addEventListener("click",()=>{$("#age").value=4;$("#weight").value=6.5;$("#feeds").value=6;$("#premature").value="no";$("#observed").value=130;mode="formula";$$("[data-case]").forEach((x,i)=>x.classList.toggle("active",i===0));calc()});calc()})();
})();
</script>
<style is:global>

.mockup-cuanta-leche-bebe{--blue:#174b7a;--coral:#d96862;--rose:#fff0ec;--mint:#dcefe7;--cream:#fff9e9;--ink:#192332;--muted:#5e6977;--line:#dce3e5}.mockup-cuanta-leche-bebe *{box-sizing:border-box}.mockup-cuanta-leche-bebe{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fff}.mockup-cuanta-leche-bebe button,.mockup-cuanta-leche-bebe input,.mockup-cuanta-leche-bebe select{font:inherit}.mockup-cuanta-leche-bebe .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;border-bottom:1px solid var(--line)}.mockup-cuanta-leche-bebe .brand{font-weight:950;font-size:19px}.mockup-cuanta-leche-bebe .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-cuanta-leche-bebe .nav{display:flex;gap:26px;color:#505b6a;font-size:14px;font-weight:750}.mockup-cuanta-leche-bebe .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-cuanta-leche-bebe .hero{padding:52px 22px;background:linear-gradient(120deg,#fff 0 63%,var(--rose) 63%)}.mockup-cuanta-leche-bebe .hero-grid,.mockup-cuanta-leche-bebe .wrap{max-width:1180px;margin:auto}.mockup-cuanta-leche-bebe .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center}.mockup-cuanta-leche-bebe .crumb{color:var(--blue);font-size:14px;font-weight:850}.mockup-cuanta-leche-bebe .eyebrow{margin-top:27px;color:var(--coral);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-cuanta-leche-bebe .hero h1{font-size:clamp(43px,5vw,67px);line-height:.98;letter-spacing:-.05em;margin:10px 0 19px;max-width:690px}.mockup-cuanta-leche-bebe .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-cuanta-leche-bebe .trust{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-cuanta-leche-bebe .trust span{padding:8px 12px;background:#fff;border:1px solid var(--line);border-radius:99px;font-size:13px;font-weight:800}.mockup-cuanta-leche-bebe .visual{height:340px;display:grid;place-items:center;position:relative}.mockup-cuanta-leche-bebe .bottle{width:150px;height:260px;border:7px solid var(--blue);border-radius:27px 27px 48px 48px;background:#fff;position:relative;overflow:hidden;box-shadow:0 24px 50px #793e4a20}.mockup-cuanta-leche-bebe .bottle:before{content:"";position:absolute;width:88px;height:54px;left:24px;top:-48px;border:7px solid var(--blue);border-bottom:0;border-radius:50% 50% 8px 8px;background:#f0d1bf}.mockup-cuanta-leche-bebe .milk{position:absolute;left:0;right:0;bottom:0;height:62%;background:#fff2c8;transition:.3s}.mockup-cuanta-leche-bebe .scale{position:absolute;inset:24px 18px 24px auto;width:35px;display:flex;flex-direction:column;justify-content:space-between;z-index:2;color:var(--blue);font-size:10px;font-weight:900}.mockup-cuanta-leche-bebe .scale i{display:block;border-top:2px solid var(--blue);font-style:normal;padding-top:1px}.mockup-cuanta-leche-bebe .bubble{position:absolute;right:8px;top:40px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:13px 16px;box-shadow:0 15px 30px #5c405519}.mockup-cuanta-leche-bebe .bubble small{display:block;color:var(--muted)}.mockup-cuanta-leche-bebe .bubble strong{font-size:24px;color:var(--coral)}.mockup-cuanta-leche-bebe .tool{padding:62px 22px}.mockup-cuanta-leche-bebe .head2{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.mockup-cuanta-leche-bebe .kicker{color:var(--coral);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-cuanta-leche-bebe .head2 h2,.mockup-cuanta-leche-bebe .guide h2{font-size:37px;letter-spacing:-.04em;margin:7px 0}.mockup-cuanta-leche-bebe .head2 p{max-width:500px;color:var(--muted);margin:0}.mockup-cuanta-leche-bebe .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:21px}.mockup-cuanta-leche-bebe .case{min-height:100px;border:1px solid var(--line);border-radius:16px;background:#fff;text-align:left;padding:16px;color:var(--ink);cursor:pointer}.mockup-cuanta-leche-bebe .case b{display:block;margin-bottom:5px}.mockup-cuanta-leche-bebe .case small{color:var(--muted)}.mockup-cuanta-leche-bebe .case.active{border:2px solid var(--coral);padding:15px;background:#fff8f6}.mockup-cuanta-leche-bebe .workspace{display:grid;grid-template-columns:.88fr 1.12fr;gap:20px}.mockup-cuanta-leche-bebe .panel{border-radius:24px;padding:27px}.mockup-cuanta-leche-bebe .form{border:1px solid var(--line);box-shadow:0 16px 40px #17364a0d}.mockup-cuanta-leche-bebe .panel h3{font-size:21px;margin:0 0 5px}.mockup-cuanta-leche-bebe .hint{font-size:14px;color:var(--muted);margin:0 0 21px}.mockup-cuanta-leche-bebe .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-cuanta-leche-bebe .field.full{grid-column:1/-1}.mockup-cuanta-leche-bebe .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-cuanta-leche-bebe .field small{display:block;color:var(--muted);font-size:12px;margin-top:5px}.mockup-cuanta-leche-bebe input,.mockup-cuanta-leche-bebe select{width:100%;min-height:49px;border:1px solid #cfd9dc;border-radius:12px;background:#fff;padding:12px 14px;color:var(--ink)}.mockup-cuanta-leche-bebe .actions{display:flex;gap:9px;margin-top:21px}.mockup-cuanta-leche-bebe .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:14px;font-weight:900;cursor:pointer}.mockup-cuanta-leche-bebe .reset{border:1px solid #e0ad70;border-radius:12px;background:#fff;color:#67451c;padding:13px 16px;font-weight:850;cursor:pointer}.mockup-cuanta-leche-bebe .result{background:linear-gradient(145deg,#fff3ef,#fff);border:1px solid #f0cbc5}.mockup-cuanta-leche-bebe .result-top{display:flex;justify-content:space-between;gap:15px}.mockup-cuanta-leche-bebe .badge{display:inline-block;padding:7px 10px;border-radius:99px;background:var(--mint);color:#17513f;font-size:12px;font-weight:900}.mockup-cuanta-leche-bebe .big{font-size:48px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:13px 0 4px;color:var(--blue)}.mockup-cuanta-leche-bebe .caption{color:var(--muted);font-size:14px}.mockup-cuanta-leche-bebe .day{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:22px 0}.mockup-cuanta-leche-bebe .feed{background:#fff;border:1px solid var(--line);border-radius:13px;padding:12px;text-align:center}.mockup-cuanta-leche-bebe .feed small{display:block;color:var(--muted);font-size:10px}.mockup-cuanta-leche-bebe .feed strong{font-size:16px}.mockup-cuanta-leche-bebe .range{padding:15px;border-radius:14px;background:var(--blue);color:#fff}.mockup-cuanta-leche-bebe .range b{display:flex;justify-content:space-between;font-size:13px}.mockup-cuanta-leche-bebe .track{height:9px;border-radius:99px;background:#ffffff35;margin:13px 0 5px;position:relative}.mockup-cuanta-leche-bebe .track:before{content:"";position:absolute;left:18%;right:18%;height:100%;background:#f7cf83;border-radius:99px}.mockup-cuanta-leche-bebe .track i{position:absolute;left:50%;top:50%;width:20px;height:20px;border:4px solid #fff;background:var(--coral);border-radius:50%;transform:translate(-50%,-50%)}.mockup-cuanta-leche-bebe .note{margin-top:16px;padding:13px 15px;border-radius:12px;background:var(--cream);color:#594923;font-size:13px}.mockup-cuanta-leche-bebe .guide{padding:68px 22px;background:#f4f7f5}.mockup-cuanta-leche-bebe .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px}.mockup-cuanta-leche-bebe .guide p{color:var(--muted)}.mockup-cuanta-leche-bebe .signals{display:grid;grid-template-columns:1fr 1fr;gap:11px}.mockup-cuanta-leche-bebe .signal{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px}.mockup-cuanta-leche-bebe .signal b{display:block;margin-bottom:5px}.mockup-cuanta-leche-bebe .signal span{font-size:14px;color:var(--muted)}.mockup-cuanta-leche-bebe .warning{border-color:#efc2bd;background:#fff7f5}.mockup-cuanta-leche-bebe .foot{padding:30px;text-align:center;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-cuanta-leche-bebe .nav{display:none}.mockup-cuanta-leche-bebe .hero-grid,.mockup-cuanta-leche-bebe .workspace,.mockup-cuanta-leche-bebe .guide-grid{grid-template-columns:1fr}.mockup-cuanta-leche-bebe .head2{align-items:start;flex-direction:column}.mockup-cuanta-leche-bebe .cases{grid-template-columns:1fr 1fr}}@media(max-width:550px){.mockup-cuanta-leche-bebe .cases,.mockup-cuanta-leche-bebe .fields,.mockup-cuanta-leche-bebe .signals{grid-template-columns:1fr}.mockup-cuanta-leche-bebe .day{grid-template-columns:1fr 1fr}.mockup-cuanta-leche-bebe .hero h1{font-size:43px}.mockup-cuanta-leche-bebe .actions{flex-direction:column}}

.mockup-cuanta-leche-bebe { width:100%; overflow:hidden; }
.mockup-cuanta-leche-bebe .top, .mockup-cuanta-leche-bebe header.top { display:none !important; }
.mockup-cuanta-leche-bebe .foot { display:none !important; }
.mockup-cuanta-leche-bebe .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-cuanta-leche-bebe .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-cuanta-leche-bebe .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-cuanta-leche-bebe .support-real summary { cursor:pointer; font-weight:750; }
.mockup-cuanta-leche-bebe .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-cuanta-leche-bebe :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-cuanta-leche-bebe input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-cuanta-leche-bebe input[type="number"]::-webkit-inner-spin-button, .mockup-cuanta-leche-bebe input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-cuanta-leche-bebe .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-cuanta-leche-bebe support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
