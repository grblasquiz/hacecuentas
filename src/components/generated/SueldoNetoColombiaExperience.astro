<div class="mockup-sueldo-neto-colombia" set:html={`<section class="hero"><div class="wrap crumb"><b>Colombia</b> &nbsp;/&nbsp; Trabajo &nbsp;/&nbsp; Sueldo neto</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Tu nómina, sin sorpresas</span><h1>Pasá de salario<br>bruto a lo que<br>realmente recibís.</h1><p>Calculá salud, pensión, Fondo de Solidaridad, retención y auxilio de transporte. Revisá cada línea de tu desprendible.</p><div class="chips"><span>🏥 Salud 4%</span><span>🛡️ Pensión 4%</span><span>✓ Auxilio automático</span></div><div class="car-art"><div class="road"></div><div style="position:absolute;left:95px;bottom:55px;width:235px;height:155px;background:#fff;border:1px solid #d8e4eb;border-radius:18px;box-shadow:0 18px 35px #17385818"></div><div style="position:absolute;left:120px;bottom:160px;width:185px;height:15px;background:#75cbb9;border-radius:8px;box-shadow:0 -30px 0 #75cbb9"></div><div class="fuel-card"><small>TE LLEGA ESTE MES</small><strong id="art-value">$3.009.095</strong><span id="art-place">Contrato laboral ordinario</span></div></div></div>
<form class="calc"><div class="calc-title"><div><h2>Calculá tu sueldo líquido</h2><p>Elegí cómo te pagan.</p></div><span class="tag">Valores 2026</span></div><div class="section-label">Tu modalidad</div><div class="cases"><button type="button" class="case active" data-mode="ordinary"><i>👔</i>Contrato laboral</button><button type="button" class="case" data-mode="integral"><i>💼</i>Salario integral</button><button type="button" class="case" data-mode="apprentice"><i>🎓</i>Aprendiz SENA</button><button type="button" class="case" data-mode="compare"><i>↔️</i>Bruto vs. neto</button></div><div class="section-label">Tus números del mes</div><div class="fields"><div class="field wide"><label>Salario mensual pactado</label><div class="inline"><b>$</b><input id="salary" type="number" value="3000000"></div></div><div class="field"><label>Deducciones informadas</label><div class="inline"><b>$</b><input id="deductions" type="number" value="0"></div></div><div class="field"><label>Otros descuentos</label><div class="inline"><b>$</b><input id="other" type="number" value="0"></div></div><div class="field wide"><label>Auxilio de transporte</label><select id="transport"><option value="auto">Sí, si corresponde por ley</option><option value="no">No incluir</option></select></div></div><div class="advanced"><span>Salud 4% + pensión 4% sobre la base de cotización</span><button type="button" id="advanced-toggle">+ Afinar retención</button></div><div class="extra" id="extra-fields"><div class="field"><label>Aportes voluntarios / AFC</label><div class="inline"><b>$</b><input id="voluntary" type="number" value="0"></div></div><div class="field"><label>Etapa aprendiz</label><select id="stage"><option value=".75">Lectiva · 75%</option><option value="1" selected>Productiva · 100%</option></select></div></div><section class="result"><div class="result-top"><div><small id="result-label">Lo que te llega este mes</small><div class="value" id="result-value">$3.009.095</div></div><div class="verdict"><small>Te queda</small><strong id="verdict">92,6% del total</strong></div></div><div class="stats"><span>Descuentos de ley<b id="s1">$240.000</b></span><span>Auxilio transporte<b id="s2">$249.095</b></span><span>Retención estimada<b id="s3">$0</b></span></div><button class="go" id="update" type="button">Actualizar sueldo</button></section></form></div></section>
<section class="scale-section"><div class="wrap"><header class="center"><span>Tu sueldo, peso por peso</span><h2>¿Cuánto llega realmente a tu cuenta?</h2><p>El marcador muestra el porcentaje neto después de aportes y descuentos.</p></header><div class="scale-card"><div class="meter"><i class="pin" id="pin" data-value="92,6%"></i></div><div class="meter-labels"><div><b>Más descuentos</b>Menos de 80%</div><div><b>Rango habitual</b>80% a 92%</div><div><b>Descuento básico</b>Más de 92%</div></div><div class="meter-summary"><span id="scale-copy">El auxilio suma al neto y no paga aportes.</span><b id="scale-result">Recibís $3.009.095</b></div></div></div></section>
<section class="breakdown"><div class="wrap break-grid"><article class="card"><h3>Tu desprendible, línea por línea</h3><div class="line"><span>Salario bruto</span><b id="d1">$3.000.000</b></div><div class="line"><span>Salud · 4%</span><b id="d2">− $120.000</b></div><div class="line"><span>Pensión · 4%</span><b id="d3">− $120.000</b></div><div class="line"><span>Fondo + retención + otros</span><b id="d4">$0</b></div><div class="line total"><strong>Neto con auxilio</strong><b id="df">$3.009.095</b></div></article><article class="card"><h3>Qué entra y qué no</h3><div class="step"><i>1</i><div><b>Salud y pensión</b><span>4% cada una sobre el ingreso base.</span></div></div><div class="step"><i>2</i><div><b>Auxilio de transporte</b><span>Hasta 2 salarios mínimos y fuera de aportes.</span></div></div><div class="step"><i>3</i><div><b>Retención</b><span>Se calcula sobre una base depurada, no el bruto.</span></div></div><div class="warning">⚠️ Prima, cesantías e intereses se liquidan aparte. Compará esta estimación con tu desprendible real.</div></article></div></section>
<section class="tips"><div class="wrap"><header class="center"><span>Referencias 2026</span><h2>Los números que definen tu nómina</h2></header><div class="tip-grid"><article class="tip"><i>💵</i><h3>Salario mínimo</h3><p>Base legal mensual vigente.</p><span class="impact">$1.750.905</span></article><article class="tip"><i>🚌</i><h3>Auxilio transporte</h3><p>Para ingresos de hasta 2 SMLMV.</p><span class="impact">$249.095</span></article><article class="tip"><i>🛡️</i><h3>Solidaridad</h3><p>Comienza cuando el IBC supera 4 SMLMV.</p><span class="impact">Desde 1%</span></article><article class="tip"><i>📐</i><h3>UVT</h3><p>Unidad para depurar la retención.</p><span class="impact">$52.374</span></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">No todo descuento es tuyo</span><h2>La empresa aporta además de lo que ves en tu nómina.</h2><p>Tu 4% de salud y 4% de pensión son sólo la parte del trabajador; el empleador paga aportes adicionales.</p></div><div class="compare"><div><small>TU SALUD</small><b>4%</b><span>Descuento del trabajador</span></div><div><small>TU PENSIÓN</small><b>4%</b><span>Descuento del trabajador</span></div><div><small>DESCUENTO BÁSICO</small><b>8%</b><span>Antes de retención</span></div></div></div></section><div class="foot"></div><button type="button" id="date-result" hidden aria-hidden="true"></button><button type="button" id="progress-result" hidden aria-hidden="true"></button><button type="button" id="fund-result" hidden aria-hidden="true"></button><button type="button" id="art-consumption" hidden aria-hidden="true"></button><button type="button" id="art-cost" hidden aria-hidden="true"></button><button type="button" id="scale-verdict" hidden aria-hidden="true"></button><button type="button" id="detail-last" hidden aria-hidden="true"></button><button type="button" id="detail-interval" hidden aria-hidden="true"></button><button type="button" id="detail-used" hidden aria-hidden="true"></button><button type="button" id="detail-next" hidden aria-hidden="true"></button><button type="button" id="detail-left" hidden aria-hidden="true"></button><button type="button" id="cmp-low" hidden aria-hidden="true"></button><button type="button" id="cmp-current" hidden aria-hidden="true"></button><button type="button" id="cmp-high" hidden aria-hidden="true"></button><button type="button" id="cmp-current-cost" hidden aria-hidden="true"></button><button type="button" id="province" hidden aria-hidden="true"></button><button type="button" id="rate" hidden aria-hidden="true"></button><button type="button" id="quota-value" hidden aria-hidden="true"></button><button type="button" id="cash-value" hidden aria-hidden="true"></button><button type="button" id="month-value" hidden aria-hidden="true"></button><button type="button" id="d-valuation" hidden aria-hidden="true"></button><button type="button" id="d-rate" hidden aria-hidden="true"></button><button type="button" id="d-year" hidden aria-hidden="true"></button><button type="button" id="d-discount" hidden aria-hidden="true"></button><button type="button" id="d-final" hidden aria-hidden="true"></button><button type="button" id="cmp-name" hidden aria-hidden="true"></button><button type="button" id="digits" hidden aria-hidden="true"></button><button type="button" id="formula-note" hidden aria-hidden="true"></button><button type="button" id="d1l" hidden aria-hidden="true"></button><button type="button" id="d2l" hidden aria-hidden="true"></button><button type="button" id="d3l" hidden aria-hidden="true"></button><button type="button" id="d4l" hidden aria-hidden="true"></button><button type="button" id="df-label" hidden aria-hidden="true"></button><button type="button" id="pre2" hidden aria-hidden="true"></button><button type="button" id="pre3" hidden aria-hidden="true"></button><button type="button" id="cmp1" hidden aria-hidden="true"></button><button type="button" id="cmp2" hidden aria-hidden="true"></button><button type="button" id="cmp3" hidden aria-hidden="true"></button><button type="button" id="date" hidden aria-hidden="true"></button><button type="button" id="night-sunday" hidden aria-hidden="true"></button><button type="button" id="limit-warning" hidden aria-hidden="true"></button><button type="button" id="cl-search" hidden aria-hidden="true"></button><button type="button" id="no-results" hidden aria-hidden="true"></button><button type="button" id="cl-search-btn" hidden aria-hidden="true"></button><button type="button" id="salary-a" hidden aria-hidden="true"></button><button type="button" id="salary-b" hidden aria-hidden="true"></button><button type="button" id="salary-answer" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sueldo-neto-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sueldo-neto-colombia');


let salaryMode="ordinary";const s$=s=>root.querySelector(s),sn=id=>Math.max(0,Number(s$(id).value)||0),sm=x=>"$"+new Intl.NumberFormat("es-CO",{maximumFractionDigits:0}).format(x);function salaryCalc(){let salary=sn("#salary"),ded=sn("#deductions"),other=sn("#other"),vol=sn("#voluntary"),sml=1750905,aux=s$("#transport").value==="auto"&&salary<=2*sml?249095:0,base=salary,health,pension,fund=0,withhold=0,label;if(salaryMode==="apprentice"){salary=sml*Number(s$("#stage").value);base=salary;health=0;pension=0;aux=0;label="Apoyo de sostenimiento neto"}else{if(salaryMode==="integral")base=salary*.7;health=base*.04;pension=base*.04;if(base>=4*sml)fund=base*(base>=20*sml?.02:.01);let taxable=Math.max(0,salary-health-pension-ded-vol)*.75;withhold=Math.max(0,(taxable-95*52374)*.19);label=salaryMode==="compare"?"Resultado bruto vs. neto":"Lo que te llega este mes"}let net=salary+aux-health-pension-fund-withhold-other-vol,ratio=(salary+aux)?net/(salary+aux)*100:0;s$("#result-label").textContent=label;s$("#result-value").textContent=sm(net);s$("#verdict").textContent=ratio.toFixed(1).replace(".",",")+"% del total";s$("#s1").textContent=sm(health+pension+fund);s$("#s2").textContent=sm(aux);s$("#s3").textContent=sm(withhold);s$("#art-value").textContent=sm(net);s$("#art-place").textContent=salaryMode==="integral"?"Salario integral":salaryMode==="apprentice"?"Aprendiz SENA":"Contrato laboral ordinario";s$("#pin").style.left=Math.max(3,Math.min(97,ratio))+"%";s$("#pin").dataset.value=ratio.toFixed(1).replace(".",",")+"%";s$("#scale-result").textContent="Recibís "+sm(net);s$("#d1").textContent=sm(salary);s$("#d2").textContent="− "+sm(health);s$("#d3").textContent="− "+sm(pension);s$("#d4").textContent="− "+sm(fund+withhold+other+vol);s$("#df").textContent=sm(net)}
root.querySelectorAll(".case").forEach(x=>x.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(y=>y.classList.remove("active"));x.classList.add("active");salaryMode=x.dataset.mode;salaryCalc()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",salaryCalc));s$("#advanced-toggle").addEventListener("click",e=>{s$("#extra-fields").classList.toggle("open");e.currentTarget.textContent=s$("#extra-fields").classList.contains("open")?"− Ocultar ajustes":"+ Afinar retención"});s$("#update").addEventListener("click",e=>{e.preventDefault();salaryCalc();e.currentTarget.textContent="✓ Sueldo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar sueldo",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());salaryCalc();


const salaryCompare=document.createElement("div");salaryCompare.className="salary-compare";salaryCompare.innerHTML='<div class="field"><label>Oferta A · salario bruto</label><div class="inline"><b>$</b><input id="salary-a" type="number" value="3000000"></div></div><div class="field"><label>Oferta B · salario bruto</label><div class="inline"><b>$</b><input id="salary-b" type="number" value="4000000"></div></div><div class="salary-answer" id="salary-answer"></div>';root.querySelector(".calc .fields").after(salaryCompare);
function simpleNetSalary(v){const aux=v<=3501810?249095:0,base=v,health=base*.04,pension=base*.04,fund=base>=7003620?base*.01:0,taxable=Math.max(0,v-health-pension)*.75,withhold=Math.max(0,(taxable-95*52374)*.19);return v+aux-health-pension-fund-withhold}
function compareSalaries(){if(salaryMode!=="compare")return;const a=Number(root.querySelector("#salary-a").value)||0,b=Number(root.querySelector("#salary-b").value)||0,na=simpleNetSalary(a),nb=simpleNetSalary(b),diff=Math.abs(na-nb),winner=na>=nb?"Oferta A":"Oferta B";root.querySelector("#result-label").textContent="Diferencia neta entre ofertas";root.querySelector("#result-value").textContent=sm(diff);root.querySelector("#verdict").textContent=`Conviene ${winner}`;root.querySelector("#s1").textContent=`A: ${sm(na)}`;root.querySelector("#s2").textContent=`B: ${sm(nb)}`;root.querySelector("#s3").textContent=`${sm(diff*12)}/año`;root.querySelector("#salary-answer").textContent=`${winner} deja ${sm(diff)} más por mes, o ${sm(diff*12)} al año.`}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{salaryCompare.classList.toggle("open",b.dataset.mode==="compare");setTimeout(compareSalaries,0)}));salaryCompare.querySelectorAll("input").forEach(i=>i.addEventListener("input",compareSalaries));root.querySelector("#update").addEventListener("click",()=>setTimeout(compareSalaries,0));

})();
</script>
