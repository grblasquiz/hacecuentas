<div class="mockup-nutricion-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Nutrición</div><div class="heroGrid"><div><span class="eyebrow">Entender antes que restringir</span><h1>Comer mejor empieza por conocer lo que necesitás.</h1><p class="lead">Estimá tus necesidades diarias, entendé los alimentos y convertí objetivos generales en números claros.</p><div class="trust"><span>✓ Gasto estimado</span><span>✓ Objetivo visible</span><span>✓ Referencias, no recetas</span></div><div class="scene"><i class="leaf"></i><i class="plate"></i><i class="fork">⋮</i></div></div>
<div class="calc"><div class="calcHead"><div><h2>Estimá tus calorías diarias</h2><p>Metabolismo, actividad y objetivo.</p></div><span class="live">CÁLCULO EN VIVO</span></div><div class="sexes"><button class="sex active" data-sex="female">Mujer</button><button class="sex" data-sex="male">Varón</button></div><div class="fields"><div class="field"><label>Edad</label><div class="input"><input id="age" type="number" min="18" max="100" value="34"><span>años</span></div></div><div class="field"><label>Peso</label><div class="input"><input id="weight" type="number" min="30" step=".1" value="68"><span>kg</span></div></div><div class="field"><label>Altura</label><div class="input"><input id="height" type="number" min="120" value="165"><span>cm</span></div></div><div class="field"><label>Actividad</label><select id="activity"><option value="1.2">Sedentaria</option><option value="1.375">Ligera · 1–3 días</option><option value="1.55" selected>Moderada · 3–5 días</option><option value="1.725">Alta · 6–7 días</option></select></div><div class="field"><label>Objetivo</label><select id="goal"><option value="-300">Bajar gradualmente</option><option value="0" selected>Mantener</option><option value="250">Aumentar gradualmente</option></select></div><div class="field"><label>Proteína de referencia</label><select id="proteinRate"><option value="1.2">1,2 g/kg</option><option value="1.6" selected>1,6 g/kg</option><option value="2">2,0 g/kg</option></select></div></div><button class="primary" id="calculate">Actualizar estimación</button><div class="result"><div class="resultTop"><div><small>OBJETIVO DIARIO ESTIMADO</small><div class="amount" id="target">2.109 kcal</div></div><span class="badge" id="goalLabel">Mantener</span></div><div class="resultGrid"><div class="metric"><span>METABOLISMO BASAL</span><b id="bmr">1.385 kcal</b></div><div class="metric"><span>MANTENIMIENTO</span><b id="tdee">2.147 kcal</b></div><div class="metric"><span>PROTEÍNA</span><b id="protein">109 g</b></div></div><div class="macrobar"><i id="proteinBar"></i><i id="carbBar"></i><i id="fatBar"></i></div><p class="note" id="note">Referencia: 109 g de proteína, 269 g de carbohidratos y 67 g de grasas.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por tu pregunta</span><h2>¿Qué necesitás entender hoy?</h2><p>Elegí una necesidad y encontrá primero la herramienta adecuada.</p></div><div class="needs"><button class="need active" data-filter="needs"><span class="icon">k</span><h3>Mis necesidades</h3><p>Calorías diarias y gasto estimado.</p><em>→</em></button><button class="need" data-filter="foods"><span class="icon">◉</span><h3>Un alimento</h3><p>Calorías y nutrientes por porción.</p><em>→</em></button><button class="need" data-filter="goal"><span class="icon">↗</span><h3>Mi objetivo</h3><p>Mantener, bajar o aumentar.</p><em>→</em></button><button class="need" data-filter="portions"><span class="icon">½</span><h3>Entender porciones</h3><p>Comparar cantidades reales.</p><em>→</em></button><button class="need" data-filter="activity"><span class="icon"></span><h3>Actividad y gasto</h3><p>Calorías estimadas al moverte.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de nutrición</span><h2>Números claros para decisiones cotidianas.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="needs">Necesidades</button><button class="filter" data-filter="foods">Alimentos</button><button class="filter" data-filter="goal">Objetivos</button><button class="filter" data-filter="portions">Porciones</button><button class="filter" data-filter="activity">Actividad</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="needs goal" data-text="calorias diarias metabolismo actividad objetivo"><span class="tag">Punto de partida</span><h3>Calorías diarias</h3><p>Estimá metabolismo basal, mantenimiento y un objetivo general.</p><button>Calcular necesidades →</button></article><article class="card" data-cat="foods portions" data-text="calorias alimentos porcion nutrientes comida"><span class="tag">Alimentos</span><h3>Calorías de los alimentos</h3><p>Buscá y compará porciones equivalentes.</p><button>Explorar alimentos →</button></article><article class="card" data-cat="activity needs" data-text="calorias quemadas ejercicio actividad gasto"><span class="tag">Movimiento</span><h3>Calorías quemadas</h3><p>Estimá gasto según actividad, tiempo y peso.</p><button>Estimar actividad →</button></article><article class="card" data-cat="goal" data-text="habitos salud objetivos agua sueño movimiento"><span class="tag">Hábitos</span><h3>Hábitos saludables</h3><p>Convertí objetivos generales en acciones medibles.</p><button>Armar hábitos →</button></article><article class="card" data-cat="portions foods" data-text="porciones medidas gramos tazas alimento"><span class="tag">Cantidades</span><h3>Porciones y equivalencias</h3><p>Pasá de medidas caseras a cantidades comparables.</p><button>Comparar porciones →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="guide"><div class="wrap guideGrid"><div><span class="eyebrow" style="color:var(--yellow)">Usá el número como orientación</span><h2>Tu cuerpo no es una fórmula.</h2><p>El sueño, la salud, la composición corporal y la rutina cambian las necesidades. Una estimación sirve para empezar a observar, no para imponer una regla.</p><div class="disclaimer">Información educativa y orientativa. Si tenés una condición de salud, estás embarazada, sos menor o necesitás un plan alimentario, consultá con un profesional.</div></div><div class="steps"><button class="step active" data-step="Estimación"><span><b>1. Estimá un punto de partida</b><small>Usá datos actuales y actividad realista.</small></span><b>→</b></button><button class="step" data-step="Observación"><span><b>2. Observá tendencias</b><small>No saques conclusiones por un solo día.</small></span><b>→</b></button><button class="step" data-step="Ajuste"><span><b>3. Ajustá con contexto</b><small>Priorizá hábitos sostenibles y seguimiento.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-nutricion-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-nutricion-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let sex="female";const fmt=n=>Math.round(n).toLocaleString("es-AR");function calc(){const age=Math.max(18,+$("#age").value||18),w=Math.max(30,+$("#weight").value||30),h=Math.max(120,+$("#height").value||120),act=+$("#activity").value,goal=+$("#goal").value,pr=+$("#proteinRate").value,bmr=10*w+6.25*h-5*age+(sex==="male"?5:-161),tdee=bmr*act,target=Math.max(1200,tdee+goal),protein=w*pr,proteinCal=protein*4,fatCal=target*.28,carbCal=Math.max(0,target-proteinCal-fatCal),carbs=carbCal/4,fat=fatCal/9;$("#target").textContent=fmt(target)+" kcal";$("#bmr").textContent=fmt(bmr)+" kcal";$("#tdee").textContent=fmt(tdee)+" kcal";$("#protein").textContent=fmt(protein)+" g";const labels={"-300":"Bajar gradualmente","0":"Mantener","250":"Aumentar gradualmente"};$("#goalLabel").textContent=labels[String(goal)];$("#proteinBar").style.width=proteinCal/target*100+"%";$("#carbBar").style.width=carbCal/target*100+"%";$("#fatBar").style.width=fatCal/target*100+"%";$("#note").textContent=`Referencia: ${fmt(protein)} g de proteína, ${fmt(carbs)} g de carbohidratos y ${fmt(fat)} g de grasas.`}
$$(".calc input,.calc select").forEach(x=>x.oninput=calc);$$(".sex").forEach(b=>b.onclick=()=>{sex=b.dataset.sex;$$(".sex").forEach(x=>x.classList.toggle("active",x===b));calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Estimación actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".step").forEach(b=>b.onclick=()=>{$$(".step").forEach(x=>x.classList.toggle("active",x===b));toast("Paso seleccionado: "+b.dataset.step)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
<style is:global>

.mockup-nutricion-home{--ink:#233226;--muted:#718075;--line:#dfe5dc;--paper:#fafaf5;--green:#4c8052;--mint:#e4f0df;--orange:#e8914d;--peach:#ffead7;--dark:#294736;--yellow:#f2c766;--white:#fff;--shadow:0 25px 68px rgba(49,78,50,.12)}.mockup-nutricion-home *{box-sizing:border-box}.mockup-nutricion-home{scroll-behavior:smooth}.mockup-nutricion-home{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.mockup-nutricion-home button,.mockup-nutricion-home input,.mockup-nutricion-home select{font:inherit}.mockup-nutricion-home .wrap{width:min(1180px,calc(100% - 40px));margin:auto}.mockup-nutricion-home header{height:80px;border-bottom:1px solid var(--line);display:flex;align-items:center;background:#fafaf5ed;position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)}.mockup-nutricion-home nav{display:flex;align-items:center;gap:28px}.mockup-nutricion-home .brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:950}.mockup-nutricion-home .logo{width:34px;height:38px;border-radius:9px;background:var(--dark);color:#fff;display:grid;place-items:center}.mockup-nutricion-home .links{display:flex;gap:23px;color:#637067;font-size:13px;font-weight:750}.mockup-nutricion-home .links b{color:var(--green)}.mockup-nutricion-home .actions{margin-left:auto;display:flex;gap:8px}.mockup-nutricion-home .sm{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 13px;font-weight:800;color:var(--ink);cursor:pointer}
