---
<div class="mockup-cuanto-tardo-leer" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Estudio / Cuánto tardo en leer</div><div class="eyebrow">Planificador de lectura</div><h1>¿Lo terminás hoy o necesitás un plan?</h1><p class="lead">Pegá páginas o palabras, elegí el tipo de texto y calculá lectura, pausas y fecha de finalización.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art book"><div class="pages"><i></i><i></i></div><span>180 páginas</span></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">lectura interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="pages">Páginas</label><input id="pages" type="number" value="180" min="1" max="10000" step="1"></div><div class="field"><label for="density">Palabras por página</label><select id="density"><option value="250">Novela aireada</option><option value="350">Libro general</option><option value="500">Texto académico</option></select></div><div class="field"><label for="speed">Velocidad (palabras/min)</label><input id="speed" type="number" value="220" min="60" max="800" step="10"></div><div class="field"><label for="daily">Minutos por día</label><input id="daily" type="number" value="35" min="5" max="600" step="5"></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-cuanto-tardo-leer')?document.currentScript.previousElementSibling:document.querySelector('.mockup-cuanto-tardo-leer');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const words=vn("pages")*vn("density"),mins=words/Math.max(1,vn("speed")),days=Math.ceil(mins/Math.max(1,vn("daily")));return {big:Math.round(mins/60*10)/10+" horas",label:"Tiempo neto de lectura",badge:days===1?"Lo terminás hoy":days<8?"Plan de una semana":"Lectura de varias semanas",metrics:[["Palabras",Math.round(words).toLocaleString("es-AR")],["Días",days],["Páginas por día",Math.ceil(vn("pages")/days)]],position:Math.min(100,vn("daily")/90*100),note:"Para estudiar, sumá entre 30% y 70% de tiempo para subrayar, tomar notas y repasar. Leer rápido no siempre es comprender mejor."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"pages":"180","density":"250","speed":"220","daily":"35"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
