<div class="mockup-liquidacion-lottt" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><span>Venezuela</span> / Trabajo / Liquidación LOTTT</div><div class="heroGrid"><div><div class="eyebrow">Fin de la relación laboral</div><h1>Me voy o me sacan. ¿Cuánto me tienen que pagar?</h1><p class="lead">Calculá tu liquidación concepto por concepto y compará los dos métodos de prestaciones que exige la LOTTT.</p><div class="pills"><span class="pill">✓ Todos los conceptos visibles</span><span class="pill">✓ Art. 142 comparado</span><span class="pill">✓ Renuncia y despido</span></div></div><aside class="heroCard"><small>La regla más importante</small><h3>Se paga el cálculo mayor</h3><p>La garantía trimestral y el retroactivo de 30 días por año se calculan por separado. Te corresponde el monto más alto.</p><span class="art">LOTTT · Artículo 142</span></aside></div></div></section>
<section class="calc"><div class="wrap"><div class="shell"><div class="cases"><button class="case active" data-case="resign"><b>Renuncié</b><span>Sin indemnización</span></button><button class="case" data-case="unfair"><b>Despido injustificado</b><span>Incluye Art. 92</span></button><button class="case" data-case="fair"><b>Despido justificado</b><span>Sin indemnización</span></button><button class="case" data-case="advance"><b>Quiero un anticipo</b><span>Hasta 75% garantía</span></button></div><div class="body"><div class="form"><div class="formHead"><div><h2>Tus datos laborales</h2><p>Usá el salario que realmente tiene carácter salarial.</p></div><span class="caseTag" id="caseTag">Renuncia</span></div><div class="grid2"><div class="field"><label>Salario normal mensual</label><div class="inputWrap"><span class="currency">Bs</span><input id="salary" type="number" value="15000"><span class="unit">/ mes</span></div></div><div class="field"><label>Años completos</label><div class="inputWrap"><input id="years" type="number" value="4" min="0"><span class="unit">años</span></div></div><div class="field"><label>Meses adicionales</label><div class="inputWrap"><input id="months" type="number" value="7" min="0" max="11"><span class="unit">meses</span></div></div><div class="field"><label>Días de utilidades</label><div class="inputWrap"><input id="profitDays" type="number" value="30"><span class="unit">días</span></div></div><div class="field"><label>Días de bono vacacional</label><div class="inputWrap"><input id="vacBonusDays" type="number" value="19"><span class="unit">días</span></div></div><div class="field"><label>Anticipos ya cobrados</label><div class="inputWrap"><span class="currency">Bs</span><input id="advances" type="number" value="0"></div></div><div class="field"><label>Tasa anual de intereses</label><div class="inputWrap"><input id="interestRate" type="number" value="0"><span class="unit">%</span></div></div></div><label class="check"><input id="pendingPreNotice" type="checkbox"><span><b>Hay preaviso pendiente de pago o descuento</b>Se estima según la antigüedad y el motivo de salida.</span></label><button class="calculate" id="calculate">Actualizar liquidación</button></div><aside class="result"><div class="resultTop"><h3>Tu liquidación estimada</h3><span class="live">● EN VIVO</span></div><div class="totalCard"><small id="totalLabel">Total a recibir</small><div class="total" id="total">Bs 0</div><p id="verdict"></p></div><div class="comparison"><div class="compareCard" id="guaranteeCard"><span>Garantía acumulada</span><strong id="guarantee">Bs 0</strong><span class="badge" id="guaranteeBadge"></span></div><div class="compareCard" id="retroCard"><span>Retroactivo 30 días/año</span><strong id="retro">Bs 0</strong><span class="badge" id="retroBadge"></span></div></div><div class="breakdown"><div class="row"><span>Prestaciones sociales (mayor)</span><strong id="benefits">Bs 0</strong></div><div class="row"><span>Vacaciones fraccionadas</span><strong id="vacation">Bs 0</strong></div><div class="row"><span>Bono vacacional fraccionado</span><strong id="vacBonus">Bs 0</strong></div><div class="row"><span>Utilidades fraccionadas</span><strong id="profits">Bs 0</strong></div><div class="row"><span>Indemnización Art. 92</span><strong id="indemnity">Bs 0</strong></div><div class="row"><span>Preaviso</span><strong id="notice">Bs 0</strong></div><div class="row"><span>Intereses estimados</span><strong id="interest">Bs 0</strong></div><div class="row"><span>Anticipos descontados</span><strong id="advanceOut">Bs 0</strong></div></div><div class="warning">⚠ El cestaticket y los bonos sin carácter salarial no se incorporan automáticamente. Revisá cómo aparece cada pago en tus recibos.</div></aside></div></div></div></section>
<section class="concepts"><div class="wrap"><div class="center"><div class="eyebrow">Concepto por concepto</div><h2>Qué debería aparecer en tu finiquito</h2><p>Aunque un rubro dé cero, tiene que quedar claro por qué no aplica.</p></div><div class="cards"><article class="card"><div class="icon">142</div><h3>Prestaciones sociales</h3><p>El mayor entre la garantía trimestral y 30 días por año al último salario integral.</p></article><article class="card"><div class="icon">☀</div><h3>Vacaciones y bono</h3><p>Se pagan en proporción al período trabajado y aumentan con la antigüedad.</p></article><article class="card"><div class="icon">%</div><h3>Utilidades</h3><p>La fracción del ejercicio se calcula según los días que reconozca la empresa.</p></article><article class="card"><div class="icon">92</div><h3>Indemnización</h3><p>En despido injustificado equivale al monto de las prestaciones sociales.</p></article></div></div></section>
<section class="flow"><div class="wrap flowGrid"><div><div class="eyebrow">Antes de firmar</div><h2>Revisá la cuenta en este orden.</h2><p>Una base salarial incompleta cambia todos los conceptos posteriores. Empezá por los recibos y después compará cada rubro.</p></div><div class="steps"><div class="step"><i>1</i><div><b>Confirmá el salario normal</b><span>Separá pagos salariales de beneficios sin incidencia.</span></div></div><div class="step"><i>2</i><div><b>Armá el salario integral</b><span>Sumá alícuotas de utilidades y bono vacacional.</span></div></div><div class="step"><i>3</i><div><b>Compará ambos métodos</b><span>La empresa no puede mostrar solo el que le conviene.</span></div></div><div class="step"><i>4</i><div><b>Descontá únicamente lo acreditado</b><span>Verificá anticipos y preaviso con respaldo.</span></div></div></div></div></section>
<section class="faq"><div class="wrap"><div class="center"><div class="eyebrow">Preguntas frecuentes</div><h2>Lo que más cambia la liquidación</h2></div><div class="faqWrap"><div class="faqItem open"><button class="faqQ">¿Qué método de prestaciones me tienen que pagar?<span>−</span></button><div class="faqA">Se calculan la garantía acumulada y el retroactivo de 30 días por año o fracción superior a seis meses. El trabajador recibe el monto mayor.</div></div><div class="faqItem"><button class="faqQ">¿El bono de guerra entra en la liquidación?<span>+</span></button><div class="faqA">Los beneficios sin carácter salarial no generan prestaciones. Lo decisivo es la naturaleza jurídica del pago y cómo figura en los recibos.</div></div><div class="faqItem"><button class="faqQ">¿Cuándo corresponde la indemnización del Art. 92?<span>+</span></button><div class="faqA">En el despido injustificado, y equivale a las prestaciones sociales. Renuncia y despido justificado no la generan.</div></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-liquidacion-lottt')?document.currentScript.previousElementSibling:document.querySelector('.mockup-liquidacion-lottt');if(!root)return;

const $=id=>root.querySelector("#"+id),fmt=n=>'Bs '+Math.max(0,Math.round(n)).toLocaleString('es-VE'),val=id=>Math.max(0,Number($(id).value)||0);let exitCase='resign';
function calculate(show=false){const salary=val('salary'),daily=salary/30,years=Math.floor(val('years')),months=Math.min(11,Math.floor(val('months'))),profitDays=val('profitDays'),bonusDays=val('vacBonusDays'),integral=daily+(daily*profitDays/360)+(daily*bonusDays/360),totalMonths=years*12+months,quarters=Math.ceil(totalMonths/3),additional=Math.min(30,Math.max(0,years-1)*2),guarantee=integral*(quarters*15+additional),retroYears=years+(months>6?1:0),retro=integral*Math.max(retroYears*30,totalMonths<3?totalMonths*5:0),benefits=Math.max(guarantee,retro),fraction=months/12,vacDays=Math.min(30,15+Math.max(0,years-1)),vacation=daily*vacDays*fraction,vacBonus=daily*Math.min(30,bonusDays)*fraction,profits=daily*profitDays*fraction,indemnity=exitCase==='unfair'?benefits:0,noticeDays=totalMonths<1?0:totalMonths<6?7:totalMonths<12?15:30,notice=$('pendingPreNotice').checked?daily*noticeDays*(exitCase==='resign'?-1:1):0,interest=guarantee*val('interestRate')/100,adv=val('advances');let total=benefits+vacation+vacBonus+profits+indemnity+notice+interest-adv;if(exitCase==='advance')total=Math.max(0,guarantee*.75-adv);$('total').textContent=fmt(total);$('guarantee').textContent=fmt(guarantee);$('retro').textContent=fmt(retro);$('benefits').textContent=fmt(benefits);$('vacation').textContent=exitCase==='advance'?'Bs 0':fmt(vacation);$('vacBonus').textContent=exitCase==='advance'?'Bs 0':fmt(vacBonus);$('profits').textContent=exitCase==='advance'?'Bs 0':fmt(profits);$('indemnity').textContent=fmt(indemnity);$('notice').textContent=(notice<0?'− ':'')+fmt(Math.abs(notice));$('interest').textContent=fmt(interest);$('advanceOut').textContent=adv?'− '+fmt(adv):'Bs 0';const gWin=guarantee>=retro;$('guaranteeCard').classList.toggle('winner',gWin);$('retroCard').classList.toggle('winner',!gWin);$('guaranteeBadge').textContent=gWin?'MÉTODO MAYOR':'';$('retroBadge').textContent=!gWin?'MÉTODO MAYOR':'';$('totalLabel').textContent=exitCase==='advance'?'Anticipo máximo estimado':'Total a recibir';$('verdict').textContent=exitCase==='advance'?'Hasta el 75% de la garantía acumulada, menos anticipos previos.':exitCase==='unfair'?'Incluye indemnización por despido injustificado equivalente a las prestaciones.':exitCase==='resign'?'Incluye prestaciones y conceptos fraccionados; no incluye indemnización del Art. 92.':'Incluye prestaciones y fraccionados, sin indemnización por despido.';if(show){$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1500)}}
function setCase(c){exitCase=c;root.querySelectorAll('.case').forEach(b=>b.classList.toggle('active',b.dataset.case===c));$('caseTag').textContent={resign:'Renuncia',unfair:'Despido injustificado',fair:'Despido justificado',advance:'Anticipo Art. 144'}[c];calculate()}
root.querySelectorAll('.case').forEach(b=>b.onclick=()=>setCase(b.dataset.case));root.querySelectorAll('input').forEach(x=>x.addEventListener('input',()=>calculate()));$('calculate').onclick=()=>calculate(true);root.querySelectorAll('.faqQ').forEach(q=>q.onclick=()=>{q.parentElement.classList.toggle('open');q.lastElementChild.textContent=q.parentElement.classList.contains('open')?'−':'+'});$('search').onclick=()=>{const q=prompt('¿Qué querés calcular?');if(q){$('toast').textContent='Buscando “'+q+'”…';$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1400)}};$('contrast').onclick=()=>{document.body.style.filter=document.body.style.filter?'':'contrast(1.05)';$('toast').textContent='Contraste ajustado';$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1400)};calculate();

})();
</script>
<style is:global>

