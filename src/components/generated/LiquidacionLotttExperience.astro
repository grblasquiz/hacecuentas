:#fff;padding:18px;text-align:left;color:var(--ink);font-weight:800;display:flex;justify-content:space-between}.mockup-liquidacion-lottt .faqA{display:none;padding:0 18px 18px;color:#68758a;font-size:14px;line-height:1.6}.mockup-liquidacion-lottt .faqItem.open .faqA{display:block}.mockup-liquidacion-lottt .footer{padding:30px 0 45px;color:#788397;font-size:12px}.mockup-liquidacion-lottt .toast{position:fixed;right:22px;bottom:22px;background:#16243f;color:#fff;border-radius:12px;padding:13px 17px;font-size:13px;opacity:0;transform:translateY(12px);transition:.25s}.mockup-liquidacion-lottt .toast.show{opacity:1;transform:none}
