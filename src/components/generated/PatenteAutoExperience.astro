---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-patente-auto" set:html={`<section class="hero"><div class="wrap crumb"><b>Auto</b> &nbsp;/&nbsp; Patente</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Impuesto automotor 2026</span><h1>Calculá tu patente<br>y entendé cada<br>peso que pagás.</h1><p>Compará provincias, estimá cada cuota y descubrí cuánto cambia el impuesto según la valuación fiscal de tu vehículo.</p><div class="chips"><span>🚘 Autos y motos</span><span>🗺️ 24 provincias</span><span>✓ Cuota y total anual</span></div><div class="car-art"><div class="road"></div><div class="car"><div class="car-body"></div><div class="glass"></div><i class="wheel one"></i><i class="wheel two"></i></div><div class="fuel-card"><small>PATENTE ANUAL ESTIMADA</small><strong id="art-value">$750.000</strong><span id="art-place">Buenos Aires · 3,0%</span></div></div></div>
<form class="calc"><div class="calc-title"><div><h2>Estimá tu patente</h2><p>Elegí el caso que querés calcular.</p></div><span class="tag">Escalas 2026</span></div><div class="section-label">¿Qué necesitás saber?</div><div class="cases"><button type="button" class="case active" data-mode="auto"><i>🚘</i>Patente de auto</button><button type="button" class="case" data-mode="moto"><i>🏍️</i>Patente de moto</button><button type="button" class="case" data-mode="quota"><i>🧾</i>Valor de cada cuota</button><button type="button" class="case" data-mode="compare"><i>🗺️</i>Comparar provincias</button></div><div class="section-label">Datos del vehículo</div><div class="fields"><div class="field wide"><label>Valuación fiscal</label><div class="inline"><b>$</b><input id="valuation" inputmode="numeric" value="25000000"></div></div><div class="field"><label>Provincia de radicación</label><select id="province"><option value=".03">Buenos Aires</option><option value=".035">CABA</option><option value=".028">Córdoba</option><option value=".027">Santa Fe</option><option value=".025">Mendoza</option><option value=".018">Tierra del Fuego</option></select></div><div class="field"><label>Cuotas por año</label><input id="quotas" type="number" min="1" max="12" value="5"></div><div class="field wide"><label>Cilindrada · solo motos</label><div class="inline"><input id="cc" type="number" min="50" value="150"><b>cc</b></div></div></div><div class="advanced"><span>✓ Usá la valuación DNRPA, no el precio de venta</span><button type="button" id="advanced-toggle">+ Ver descuentos</button></div><div class="extra" id="extra-fields"><div class="field"><label>Descuento pago anual</label><div class="inline"><input id="discount" type="number" min="0" max="30" value="10"><b>%</b></div></div><div class="field"><label>Bonificación buen contribuyente</label><div class="inline"><input id="bonus" type="number" min="0" max="30" value="5"><b>%</b></div></div></div><section class="result"><div class="result-top"><div><small id="result-label">Patente anual estimada</small><div class="value" id="result-value">$750.000</div></div><div class="verdict"><small>Alícuota usada</small><strong id="rate">3,0%</strong></div></div><div class="stats"><span>Valor por cuota<b id="quota-value">$150.000</b></span><span>Pago anual con descuento<b id="cash-value">$641.250</b></span><span>Peso mensual<b id="month-value">$62.500</b></span></div><button class="go" id="update" type="button">Actualizar patente</button></section></form></div></section>
<section class="scale-section"><div class="wrap"><header class="center"><span>Tu provincia en contexto</span><h2>El mismo auto puede pagar muy distinto</h2><p>La radicación define la alícuota. La escala ubica tu estimación entre las jurisdicciones de menor y mayor carga.</p></header><div class="scale-card"><div class="meter"><i class="pin" id="pin" data-value="3,0%"></i></div><div class="meter-labels"><div><b>Carga baja</b>1,8% a 2,3%</div><div><b>Carga media</b>2,3% a 3,0%</div><div><b>Carga alta</b>3,0% a 3,5%</div></div><div class="meter-summary"><span id="scale-copy">Buenos Aires aplica una referencia del 3,0%.</span><b id="scale-result">Tu patente representa $62.500 por mes</b></div></div></div></section>
<section class="breakdown"><div class="wrap break-grid"><article class="card"><h3>Cómo se forma tu patente</h3><div class="line"><span>Valuación fiscal</span><b id="d-valuation">$25.000.000</b></div><div class="line"><span>Alícuota de referencia</span><b id="d-rate">3,0%</b></div><div class="line"><span>Impuesto anual</span><b id="d-year">$750.000</b></div><div class="line"><span>Descuentos seleccionados</span><b id="d-discount">− $108.750</b></div><div class="line total"><strong>Pago anual estimado</strong><b id="d-final">$641.250</b></div></article><article class="card"><h3>Antes de pagar</h3><div class="step"><i>1</i><div><b>Buscá la valuación fiscal</b><span>Está en la tabla oficial DNRPA.</span></div></div><div class="step"><i>2</i><div><b>Confirmá la radicación</b><span>Importa dónde está registrado, no dónde circula.</span></div></div><div class="step"><i>3</i><div><b>Revisá beneficios</b><span>Pago anual, débito y buen contribuyente.</span></div></div><div class="warning">⚠️ Es una estimación comparativa. La boleta oficial puede incluir escalas, topes, tasas municipales o exenciones.</div></article></div></section>
<section class="tips"><div class="wrap"><header class="center"><span>Cuatro respuestas rápidas</span><h2>Lo importante, sin letra chica</h2></header><div class="tip-grid"><article class="tip"><i>📋</i><h3>Valuación fiscal</h3><p>No es el precio publicado ni lo que pagaste por el vehículo.</p><span class="impact">Base del cálculo</span></article><article class="tip"><i>🗺️</i><h3>Radicación</h3><p>Una mudanza no cambia el impuesto hasta transferir el dominio.</p><span class="impact">Define la provincia</span></article><article class="tip"><i>🏍️</i><h3>Motos</h3><p>La alícuota suele variar según la cilindrada.</p><span class="impact">Desde 1,5%</span></article><article class="tip"><i>💳</i><h3>Pago anual</h3><p>Compará el descuento contra financiar las cuotas.</p><span class="impact">Puede ahorrar 10%</span></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">Comparación nacional</span><h2>La provincia puede cambiar la cuenta casi al doble.</h2><p>Para la misma valuación fiscal, la diferencia anual entre los extremos es significativa.</p></div><div class="compare"><div><small>TIERRA DEL FUEGO · 1,8%</small><b id="cmp-low">$450.000</b><span>Carga de referencia baja</span></div><div><small>TU PROVINCIA</small><b id="cmp-current">$750.000</b><span id="cmp-name">Buenos Aires · 3,0%</span></div><div><small>CABA · 3,5%</small><b id="cmp-high">$875.000</b><span>Carga de referencia alta</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-patente-auto')?document.currentScript.previousElementSibling:document.querySelector('.mockup-patente-auto');


let patentMode="auto";const p$=s=>root.querySelector(s),pn=id=>Math.max(0,Number(p$(id).value)||0),pm=v=>"$"+new Intl.NumberFormat("es-AR",{maximumFractionDigits:0}).format(v);
function patentCalc(){let valuation=pn("#valuation"),rate=Number(p$("#province").value),cc=pn("#cc"),quotas=Math.max(1,pn("#quotas")),disc=pn("#discount")/100,bonus=pn("#bonus")/100;if(patentMode==="moto")rate=cc<100?.015:cc<250?.025:cc<500?.035:.05;let annual=valuation*rate,final=annual*(1-disc)*(1-bonus),name=p$("#province").selectedOptions[0].text,label=patentMode==="quota"?"Valor estimado de cada cuota":patentMode==="compare"?"Patente anual para comparar":patentMode==="moto"?"Patente anual de la moto":"Patente anual estimada",main=patentMode==="quota"?annual/quotas:annual;p$("#result-label").textContent=label;p$("#result-value").textContent=pm(main);p$("#rate").textContent=(rate*100).toFixed(1).replace(".",",")+"%";p$("#quota-value").textContent=pm(annual/quotas);p$("#cash-value").textContent=pm(final);p$("#month-value").textContent=pm(annual/12);p$("#art-value").textContent=pm(annual);p$("#art-place").textContent=(patentMode==="moto"?cc+" cc":name)+" · "+(rate*100).toFixed(1).replace(".",",")+"%";p$("#pin").style.left=Math.max(2,Math.min(98,(rate-.015)/.025*100))+"%";p$("#pin").dataset.value=(rate*100).toFixed(1).replace(".",",")+"%";p$("#scale-copy").textContent=name+" aplica una referencia del "+(rate*100).toFixed(1).replace(".",",")+"%.";p$("#scale-result").textContent="Tu patente representa "+pm(annual/12)+" por mes";p$("#d-valuation").textContent=pm(valuation);p$("#d-rate").textContent=(rate*100).toFixed(1).replace(".",",")+"%";p$("#d-year").textContent=pm(annual);p$("#d-discount").textContent="− "+pm(annual-final);p$("#d-final").textContent=pm(final);p$("#cmp-low").textContent=pm(valuation*.018);p$("#cmp-current").textContent=pm(annual);p$("#cmp-name").textContent=name+" · "+(rate*100).toFixed(1).replace(".",",")+"%";p$("#cmp-high").textContent=pm(valuation*.035)}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(x=>x.classList.remove("active"));b.classList.add("active");patentMode=b.dataset.mode;patentCalc()}));root.querySelectorAll("input,select").forEach(e=>e.addEventListener("input",patentCalc));p$("#advanced-toggle").addEventListener("click",e=>{p$("#extra-fields").classList.toggle("open");e.currentTarget.textContent=p$("#extra-fields").classList.contains("open")?"− Ocultar descuentos":"+ Ver descuentos"});p$("#update").addEventListener("click",e=>{e.preventDefault();patentCalc();e.currentTarget.textContent="✓ Patente actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar patente",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());patentCalc();


const provinceCompare=document.createElement("div");provinceCompare.className="province-compare";provinceCompare.innerHTML='<div class="field"><label>Provincia A</label><select id="province-a"><option value=".03">Buenos Aires</option><option value=".035">CABA</option><option value=".028">Córdoba</option><option value=".027">Santa Fe</option><option value=".025">Mendoza</option><option value=".018">Tierra del Fuego</option></select></div><div class="field"><label>Provincia B</label><select id="province-b"><option value=".035">CABA</option><option value=".03">Buenos Aires</option><option value=".028">Córdoba</option><option value=".027">Santa Fe</option><option value=".025">Mendoza</option><option value=".018">Tierra del Fuego</option></select></div><div class="province-answer" id="province-answer"></div>';root.querySelector(".calc .fields").after(provinceCompare);
function compareProvinces(){if(patentMode!=="compare")return;const val=Number(root.querySelector("#valuation").value)||0,a=root.querySelector("#province-a"),b=root.querySelector("#province-b"),taxA=val*Number(a.value),taxB=val*Number(b.value),diff=Math.abs(taxA-taxB),cheaper=taxA<=taxB?a.selectedOptions[0].text:b.selectedOptions[0].text;root.querySelector("#result-label").textContent="Diferencia anual entre provincias";root.querySelector("#result-value").textContent="$"+new Intl.NumberFormat("es-AR").format(diff);root.querySelector("#rate").textContent=`Conviene ${cheaper}`;root.querySelector("#quota-value").textContent=`A: $${new Intl.NumberFormat("es-AR").format(taxA)}`;root.querySelector("#cash-value").textContent=`B: $${new Intl.NumberFormat("es-AR").format(taxB)}`;root.querySelector("#month-value").textContent=`$${new Intl.NumberFormat("es-AR").format(diff/12)}/mes`;root.querySelector("#province-answer").textContent=`${cheaper} resulta $${new Intl.NumberFormat("es-AR").format(diff)} más barata por año para la misma valuación.`}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{provinceCompare.classList.toggle("open",b.dataset.mode==="compare");setTimeout(compareProvinces,0)}));provinceCompare.querySelectorAll("select").forEach(s=>s.addEventListener("input",compareProvinces));root.querySelector("#valuation").addEventListener("input",compareProvinces);root.querySelector("#update").addEventListener("click",()=>setTimeout(compareProvinces,0));

})();
</script>
