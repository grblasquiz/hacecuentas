.mockup-patente-auto .car-art{height:235px;margin-top:18px;position:relative}.mockup-patente-auto .road{position:absolute;left:15px;right:20px;bottom:31px;height:54px;border-radius:50%;background:#dce8ec;transform:skewX(-13deg)}.mockup-patente-auto .road:after{content:"";position:absolute;left:8%;right:8%;top:25px;border-top:3px dashed #fff}.mockup-patente-auto .car{position:absolute;left:35px;bottom:58px;width:330px;height:100px}.mockup-patente-auto .car-body{position:absolute;inset:35px 0 0;background:linear-gradient(135deg,#2b8d7a,#166b61);border-radius:45px 58px 18px 20px;box-shadow:0 18px 30px #17385828}.mockup-patente-auto .car-body:before{content:"";position:absolute;width:145px;height:65px;left:75px;top:-42px;background:#258473;clip-path:polygon(22% 0,78% 0,100% 100%,0 100%)}.mockup-patente-auto .glass{position:absolute;left:109px;top:2px;width:78px;height:38px;background:#d7edf1;clip-path:polygon(15% 0,79% 0,100% 100%,0 100%);z-index:2}.mockup-patente-auto .wheel{position:absolute;bottom:-13px;width:48px;height:48px;border:9px solid #17324f;border-radius:50%;background:#c9d5dd;z-index:3}.mockup-patente-auto .wheel.one{left:47px}.mockup-patente-auto .wheel.two{right:42px}.mockup-patente-auto .fuel-card{position:absolute;right:5px;top:5px;background:#fff;border:1px solid #d8e4eb;border-radius:14px;padding:16px 18px;box-shadow:0 18px 40px #17385817}.mockup-patente-auto .fuel-card small{display:block;font-size:8px;color:#697d90}.mockup-patente-auto .fuel-card strong{display:block;color:#147762;font-size:24px;margin:5px 0}.mockup-patente-auto .fuel-card span{font-size:9px;color:#536a7f}
