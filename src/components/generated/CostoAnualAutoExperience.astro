---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-costo-anual-auto" set:html={`<div class="wrap hero"><div><div class="crumb">Auto / Costo anual</div><div class="eyebrow">El precio de tenerlo, no de comprarlo</div><h1>Tu auto cuesta incluso cuando está estacionado.</h1><p class="lead">Sumá combustible, seguro, patente, mantenimiento y depreciación para descubrir el costo anual, mensual y por kilómetro.</p><div class="chips"><span class="chip">✓ Costos fijos y variables</span><span class="chip">✓ Depreciación visible</span><span class="chip">✓ Precio por km</span></div></div><div class="visual"><div class="road"></div><div class="car"><div class="headlight a"></div><div class="headlight b"></div><div class="wheel a"></div><div class="wheel b"></div><div class="plate">HC 2026</div></div><div class="dial"><span id="heroMonthly">$ 554 mil<small>POR MES</small></span></div></div></div>
<div class="wrap"><form class="calc" id="calculator"><div class="case-label">¿CÓMO USÁS EL AUTO?</div><div class="cases"><button type="button" class="case active" data-mode="used"><span>🚙</span>Usado · uso cotidiano</button><button type="button" class="case" data-mode="new"><span>✨</span>0 km o primer año</button><button type="button" class="case" data-mode="work"><span>🧰</span>Trabajo intensivo</button><button type="button" class="case" data-mode="stored"><span>🅿</span>Casi siempre guardado</button></div>
<div class="grid"><div class="panel"><h2 id="formTitle">Contame sobre tu auto</h2><p class="hint" id="formHint">Usamos el valor actual: no el precio que pagaste cuando lo compraste.</p><div class="fields"><div class="field"><label for="value">Valor actual ($)</label><input class="control" id="value" type="number" value="25000000" min="0"></div><div class="field"><label for="age">Antigüedad (años)</label><input class="control" id="age" type="number" value="5" min="0"></div><div class="field"><label for="km">Kilómetros por año</label><input class="control" id="km" type="number" value="15000" min="0"></div><div class="field"><label for="consumption">Consumo (L/100 km)</label><input class="control" id="consumption" type="number" value="8" min="1" step=".1"></div><div class="field"><label for="fuel">Combustible</label><select class="control" id="fuel"><option value="1200">Nafta súper</option><option value="1450">Nafta premium</option><option value="1270">Gasoil</option><option value="1510">Gasoil premium</option></select></div><div class="field"><label for="province">Provincia</label><select class="control" id="province"><option value=".035">Buenos Aires</option><option value=".032">CABA</option><option value=".03">Córdoba</option><option value=".027">Mendoza</option></select></div><div class="field"><label for="insurance">Seguro mensual ($)</label><input class="control" id="insurance" type="number" value="60000" min="0"></div><div class="field"><label for="garage">Cochera mensual ($)</label><input class="control" id="garage" type="number" value="0" min="0"></div></div><button class="update" id="updateButton" type="button">Actualizar cálculo</button></div>
<div class="panel result"><div class="kicker">COSTO TOTAL REAL POR AÑO</div><div class="big" id="resultValue">$ 6.650.000</div><div class="sub" id="resultSub">Incluye la plata que sale de tu bolsillo y el valor que pierde el auto.</div><div class="badge" id="resultBadge">Lo que más pesa: depreciación</div><div class="tiles"><div class="tile"><small>Por mes</small><strong id="monthly">$ 554.167</strong></div><div class="tile"><small>Por día</small><strong id="daily">$ 18.219</strong></div><div class="tile"><small>Por kilómetro</small><strong id="perKm">$ 443</strong></div></div></div></div></form></div>
<section><div class="wrap"><div class="section-head"><div class="eyebrow">La composición completa</div><h2>No es sólo nafta: mirá dónde se va el año.</h2><p>Los gastos silenciosos —depreciación, patente y seguro— siguen corriendo aunque uses poco el auto.</p></div><div class="cost-grid"><div class="donut-card"><div class="donut-wrap"><div class="donut"></div><div class="legend"><div><i class="dot" style="background:var(--red)"></i>Depreciación</div><div><i class="dot" style="background:var(--blue)"></i>Combustible</div><div><i class="dot" style="background:var(--amber)"></i>Seguro</div><div><i class="dot" style="background:var(--mint)"></i>Patente</div><div><i class="dot" style="background:#9f79c7"></i>Mantenimiento</div></div></div></div><div class="costs" id="costRows"></div></div></div></section>
<section class="compare"><div class="wrap"><div class="section-head"><div class="eyebrow">Dos costos distintos</div><h2>Lo que pagás hoy versus lo que realmente te cuesta.</h2></div><div class="compare-grid"><article class="compare-card"><small>COSTO DE BOLSILLO · SIN DEPRECIACIÓN</small><b id="pocket">$ 4.650.000</b><p>Combustible, seguro, patente, service, VTV y cochera.</p></article><article class="compare-card real"><small>COSTO REAL · CON PÉRDIDA DE VALOR</small><b id="real">$ 6.650.000</b><p>Es el número correcto para comparar contra taxi, Uber o transporte público.</p></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><div class="eyebrow">La cuenta detrás del total</div><h2>El kilómetro barato puede esconder un auto caro.</h2><div class="rule"><strong>Total = uso + tenencia + depreciación</strong><p>Cuanto menos lo usás, más pesan los costos fijos en cada kilómetro recorrido.</p></div></div><div class="checks"><div class="check"><span class="tick">✓</span><span>Combustible según consumo y kilómetros reales.</span></div><div class="check"><span class="tick">✓</span><span>Patente estimada sobre el valor actual.</span></div><div class="check"><span class="tick">✓</span><span>Mantenimiento ajustado por edad e intensidad.</span></div><div class="check"><span class="tick">✓</span><span>Depreciación separada del flujo de caja.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-costo-anual-auto')?document.currentScript.previousElementSibling:document.querySelector('.mockup-costo-anual-auto');

const $=id=>root.querySelector("#"+id),money=n=>"$ "+Math.round(n).toLocaleString("es-AR"),set=(id,v)=>$(id).textContent=v;let mode="used";const cfg={used:["Contame sobre tu auto","Usamos el valor actual: no el precio que pagaste cuando lo compraste."],new:["Calculá el costo del primer año","La depreciación inicial suele ser el gasto más grande y menos visible."],work:["Medí el costo de producir kilómetros","El uso intensivo eleva service, combustible y desgaste."],stored:["Medí cuánto cuesta tenerlo disponible","Con pocos kilómetros, los costos fijos pesan muchísimo por viaje."]};function rows(a){$("costRows").innerHTML=a.map(x=>`<div class="cost-row"><span>${x[0]}</span><strong>${money(x[1])}</strong></div>`).join("")}
function calculate(){let value=+$("value").value||0,age=+$("age").value||0,km=+$("km").value||0,cons=+$("consumption").value||0,fuel=+$("fuel").value||0,alic=+$("province").value||0,insurance=(+$("insurance").value||0)*12,garage=(+$("garage").value||0)*12,profile={used:{dep:.08,mult:1},new:{dep:.20,mult:.75},work:{dep:.12,mult:1.45},stored:{dep:.06,mult:.8}}[mode],profileKm=mode==="work"?Math.max(km,30000):mode==="stored"?Math.min(km,5000):km,fuelYear=profileKm*cons/100*fuel,patent=value*alic,maint=value*Math.min(.1,(.03+age*.005+Math.max(0,(profileKm-15000)/15000)*.01)*profile.mult),vtv=age>=3?45000:0,dep=value*profile.dep,pocket=fuelYear+insurance+patent+maint+vtv+garage,total=pocket+dep,monthly=total/12,daily=total/365,per=profileKm?total/profileKm:0,parts=[["Combustible",fuelYear],["Seguro",insurance],["Patente",patent],["Mantenimiento",maint],["VTV",vtv],["Cochera",garage],["Depreciación",dep]],major=parts.slice().sort((a,b)=>b[1]-a[1])[0];set("resultValue",money(total));set("resultSub",`${money(pocket)} salen de tu bolsillo y ${money(dep)} son pérdida de valor.`);set("resultBadge","Lo que más pesa: "+major[0].toLowerCase());set("monthly",money(monthly));set("daily",money(daily));set("perKm",money(per));set("pocket",money(pocket));set("real",money(total));set("heroMonthly",money(monthly).replace("$ ","$ ")+"");rows(parts);$("heroMonthly").innerHTML=money(monthly/1000)+" mil<small>POR MES</small>"}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));set("formTitle",cfg[mode][0]);set("formHint",cfg[mode][1]);calculate()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calculate));function confirmCalc(){calculate();set("updateButton","✓ Cálculo actualizado");clearTimeout(window.timer);window.timer=setTimeout(()=>set("updateButton","Actualizar cálculo"),5000)}$("updateButton").addEventListener("click",confirmCalc);$("calculator").addEventListener("submit",e=>{e.preventDefault();confirmCalc()});calculate();

})();
</script>
<style is:global>

.mockup-costo-anual-auto{--ink:#111b33;--muted:#637085;--line:#dfe4ea;--bg:#f6f6f2;--blue:#286be7;--mint:#35ab98;--amber:#efad45;--red:#e36c5f;--navy:#174B7A}.mockup-costo-anual-auto *{box-sizing:border-box}.mockup-costo-anual-auto{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.mockup-costo-anual-auto .wrap{width:min(1160px,calc(100% - 40px));margin:auto}.mockup-costo-anual-auto header{height:86px;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-costo-anual-auto .nav{display:flex;align-items:center;gap:28px}.mockup-costo-anual-auto .logo{width:28px;height:35px;border-radius:4px;background:var(--navy);color:#fff;display:grid;place-items:center}.mockup-costo-anual-auto .brand{font-size:18px;font-weight:950}.mockup-costo-anual-auto .links{display:flex;gap:24px;color:#4e5a6c;font-size:13px;font-weight:800}.mockup-costo-anual-auto .tools{margin-left:auto;display:flex;gap:8px}.mockup-costo-anual-auto .tool{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px;font-weight:800}
.mockup-costo-anual-auto .hero{display:grid;grid-template-columns:1.06fr .94fr;gap:48px;align-items:center;padding:62px 0 48px}.mockup-costo-anual-auto .crumb{color:#286be7;font-size:14px}.mockup-costo-anual-auto .eyebrow{margin-top:18px;color:#187c77;font-size:12px;font-weight:950;letter-spacing:.13em;text-transform:uppercase}.mockup-costo-anual-auto h1{font-size:clamp(45px,5.2vw,69px);line-height:.98;letter-spacing:-.055em;margin:11px 0 20px}.mockup-costo-anual-auto .lead{font-size:18px;color:var(--muted);max-width:680px}.mockup-costo-anual-auto .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-costo-anual-auto .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:12px;font-weight:850}
.mockup-costo-anual-auto .visual{height:350px;position:relative}.mockup-costo-anual-auto .road{position:absolute;left:28px;right:20px;bottom:28px;height:94px;background:#18314e;border-radius:50% 50% 20px 20px;transform:perspective(350px) rotateX(40deg)}.mockup-costo-anual-auto .road:after{content:"";position:absolute;left:49%;top:12px;bottom:5px;border-left:6px dashed #fff}.mockup-costo-anual-auto .car{position:absolute;left:48px;right:36px;top:70px;height:150px;background:#347bd9;border-radius:75px 105px 35px 35px;box-shadow:0 25px 35px #20344b2d}.mockup-costo-anual-auto .car:before{content:"";position:absolute;left:72px;right:58px;top:-45px;height:83px;background:#bfe2eb;border:13px solid #347bd9;border-radius:75px 85px 5px 5px}.mockup-costo-anual-auto .headlight{position:absolute;top:57px;width:48px;height:24px;background:#fff4b4;border-radius:50%}.mockup-costo-anual-auto .headlight.a{left:24px}.mockup-costo-anual-auto .headlight.b{right:24px}.mockup-costo-anual-auto .wheel{position:absolute;bottom:-22px;width:62px;height:62px;border:16px solid #15253a;border-radius:50%;background:#b9c5d2}.mockup-costo-anual-auto .wheel.a{left:42px}.mockup-costo-anual-auto .wheel.b{right:42px}.mockup-costo-anual-auto .plate{position:absolute;left:50%;bottom:17px;transform:translateX(-50%);background:#fff;border-radius:5px;padding:5px 15px;font-weight:900}.mockup-costo-anual-auto .dial{position:absolute;right:0;top:5px;width:137px;height:137px;border-radius:50%;background:conic-gradient(var(--red) 0 31%,var(--blue) 31% 62%,var(--amber) 62% 79%,var(--mint) 79%);border:12px solid #fff;box-shadow:0 12px 36px #24324b2c;display:grid;place-items:center}.mockup-costo-anual-auto .dial:before{content:"";position:absolute;inset:21px;border-radius:50%;background:#fff}.mockup-costo-anual-auto .dial span{position:relative;text-align:center;font-size:21px;font-weight:950;line-height:1}.mockup-costo-anual-auto .dial small{display:block;font-size:8px;color:#687589;margin-top:5px}
.mockup-costo-anual-auto .calc{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:68px}.mockup-costo-anual-auto .case-label{font-size:12px;font-weight:950;color:#5b6778;margin-bottom:11px}.mockup-costo-anual-auto .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:25px}.mockup-costo-anual-auto .case{border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:13px 8px;color:#505d70;font-size:11px;font-weight:900;cursor:pointer}.mockup-costo-anual-auto .case span{display:block;font-size:18px;margin-bottom:3px}.mockup-costo-anual-auto .case.active{background:#eef4ff;color:#1c5fcd;border-color:#286be7;box-shadow:inset 0 0 0 1px #286be7}.mockup-costo-anual-auto .grid{display:grid;grid-template-columns:1.03fr .97fr;gap:23px}.mockup-costo-anual-auto .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-costo-anual-auto .panel h2{font-size:22px;margin:0 0 5px}.mockup-costo-anual-auto .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-costo-anual-auto .fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.mockup-costo-anual-auto .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-costo-anual-auto .control{width:100%;height:50px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-costo-anual-auto .control:focus{border-color:#286be7;box-shadow:0 0 0 3px #286be718}.mockup-costo-anual-auto .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
.mockup-costo-anual-auto .result{background:linear-gradient(145deg,#13365f,#0b1e3b);border:0;color:#fff;position:relative;overflow:hidden}.mockup-costo-anual-auto .result:after{content:"";position:absolute;width:220px;height:220px;border:45px solid #2ab6aa20;border-radius:50%;right:-125px;bottom:-130px}.mockup-costo-anual-auto .kicker{font-size:11px;letter-spacing:.13em;color:#9fe1d6;font-weight:950}.mockup-costo-anual-auto .big{font-size:42px;line-height:1.05;font-weight:950;letter-spacing:-.045em;margin:15px 0 7px}.mockup-costo-anual-auto .sub{color:#c2d2e4}.mockup-costo-anual-auto .badge{display:inline-flex;margin-top:16px;padding:8px 11px;border-radius:99px;background:#1e4777;border:1px solid #416992;font-size:12px;font-weight:850}.mockup-costo-anual-auto .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}.mockup-costo-anual-auto .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px;position:relative;z-index:1}.mockup-costo-anual-auto .tile small{display:block;color:#b6c7db;text-transform:uppercase;font-size:9px;letter-spacing:.07em}.mockup-costo-anual-auto .tile strong{display:block;margin-top:5px;font-size:14px}
.mockup-costo-anual-auto section{padding:70px 0}.mockup-costo-anual-auto .section-head{max-width:760px;margin-bottom:28px}.mockup-costo-anual-auto .section-head h2,.mockup-costo-anual-auto .dark h2{font-size:39px;line-height:1.05;letter-spacing:-.04em;margin:9px 0}.mockup-costo-anual-auto .section-head p{font-size:17px;color:var(--muted)}.mockup-costo-anual-auto .cost-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}.mockup-costo-anual-auto .donut-card,.mockup-costo-anual-auto .costs{background:#fff;border:1px solid var(--line);border-radius:22px;padding:25px}.mockup-costo-anual-auto .donut-wrap{display:flex;align-items:center;gap:26px}.mockup-costo-anual-auto .donut{width:190px;height:190px;border-radius:50%;background:conic-gradient(var(--red) 0 29%,var(--blue) 29% 51%,var(--amber) 51% 67%,var(--mint) 67% 83%,#9f79c7 83%);display:grid;place-items:center}.mockup-costo-anual-auto .donut:after{content:"";width:108px;height:108px;border-radius:50%;background:#fff}.mockup-costo-anual-auto .legend{display:grid;gap:9px}.mockup-costo-anual-auto .legend div{display:flex;align-items:center;gap:8px;font-size:13px}.mockup-costo-anual-auto .dot{width:10px;height:10px;border-radius:50%}.mockup-costo-anual-auto .cost-row{display:grid;grid-template-columns:1fr auto;gap:10px;padding:12px 0;border-bottom:1px solid #edf0f3}.mockup-costo-anual-auto .cost-row:last-child{border:0}.mockup-costo-anual-auto .cost-row span{color:#59667a}.mockup-costo-anual-auto .cost-row strong{font-size:15px}.mockup-costo-anual-auto .compare{background:#eef3f5;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.mockup-costo-anual-auto .compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.mockup-costo-anual-auto .compare-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:25px}.mockup-costo-anual-auto .compare-card small{font-weight:900;color:#657286}.mockup-costo-anual-auto .compare-card b{display:block;font-size:34px;margin:8px 0}.mockup-costo-anual-auto .compare-card p{color:var(--muted);margin:0}.mockup-costo-anual-auto .compare-card.real{border-color:#c9a0a0;background:#fff9f8}.mockup-costo-anual-auto .dark{background:#0c203d;color:#fff}.mockup-costo-anual-auto .dark-grid{display:grid;grid-template-columns:1fr 1fr;gap:55px}.mockup-costo-anual-auto .rule{border:1px solid #ffffff20;background:#ffffff09;border-radius:20px;padding:24px}.mockup-costo-anual-auto .rule strong{font-size:26px}.mockup-costo-anual-auto .rule p{color:#b8c9dc}.mockup-costo-anual-auto .checks{display:grid;gap:12px}.mockup-costo-anual-auto .check{display:flex;gap:12px;color:#d4e0ee}.mockup-costo-anual-auto .tick{flex:0 0 26px;height:26px;border-radius:50%;background:#2eaa98;display:grid;place-items:center;color:#071d2c;font-weight:950}.mockup-costo-anual-auto footer{padding:30px;text-align:center;color:#687589;font-size:12px;background:#fff}
@media(max-width:920px){.mockup-costo-anual-auto .links{display:none}.mockup-costo-anual-auto .hero,.mockup-costo-anual-auto .grid,.mockup-costo-anual-auto .cost-grid,.mockup-costo-anual-auto .dark-grid{grid-template-columns:1fr}.mockup-costo-anual-auto .cases{grid-template-columns:repeat(2,1fr)}.mockup-costo-anual-auto .visual{height:315px}.mockup-costo-anual-auto .tiles{grid-template-columns:1fr}}@media(max-width:520px){.mockup-costo-anual-auto .wrap{width:calc(100% - 24px)}.mockup-costo-anual-auto header{height:70px}.mockup-costo-anual-auto .tools .tool:first-child{display:none}.mockup-costo-anual-auto h1{font-size:42px}.mockup-costo-anual-auto .visual{transform:scale(.84);margin:-25px}.mockup-costo-anual-auto .calc{padding:14px}.mockup-costo-anual-auto .panel{padding:18px}.mockup-costo-anual-auto .fields,.mockup-costo-anual-auto .cases,.mockup-costo-anual-auto .compare-grid{grid-template-columns:1fr}.mockup-costo-anual-auto .donut-wrap{flex-direction:column}.mockup-costo-anual-auto .section-head h2,.mockup-costo-anual-auto .dark h2{font-size:32px}}

.mockup-costo-anual-auto { width:100%; overflow:hidden; }
.mockup-costo-anual-auto .top, .mockup-costo-anual-auto header.top { display:none !important; }
.mockup-costo-anual-auto .foot { display:none !important; }
.mockup-costo-anual-auto .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-costo-anual-auto .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-costo-anual-auto .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-costo-anual-auto .support-real summary { cursor:pointer; font-weight:750; }
.mockup-costo-anual-auto .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-costo-anual-auto :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-costo-anual-auto input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-costo-anual-auto input[type="number"]::-webkit-inner-spin-button, .mockup-costo-anual-auto input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-costo-anual-auto .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-costo-anual-auto support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
