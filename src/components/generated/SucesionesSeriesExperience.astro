---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-sucesiones-series" set:html={`<div class="crumb">Matemática / Sucesiones y series</div><h1>Descubrí el patrón antes de sumar.</h1><p class="lead">Construí una sucesión, mirá sus términos crecer y compará el término n con la suma acumulada.</p><div class="composer"><label>Tipo<select id="type"><option value="ar">Aritmética</option><option value="geo">Geométrica</option></select></label><label>Primer término<input id="first" type="number" value="3"></label><label id="stepLabel">Diferencia<input id="step" type="number" value="2" step=".1"></label><label>Hasta n<input id="count" type="number" value="10" min="2" max="20"></label><button id="next">Agregar un término</button></div><section class="sequence" id="sequence"></section><section class="strip"><div class="card"><span>Término n</span><b id="nth"></b><code id="formula"></code></div><div class="card"><span>Suma parcial</span><b id="sum"></b><code>Sₙ = a₁ + … + aₙ</code></div><div class="card verdict"><span>Comportamiento</span><b id="trend"></b><p id="meaning"></p></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sucesiones-series')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sucesiones-series');

const $=x=>root.querySelector("#"+x);function render(){let type=$('type').value,a=+$('first').value,r=+$('step').value,n=Math.max(2,Math.min(20,+$('count').value||2)),arr=Array.from({length:n},(_,i)=>type==='ar'?a+i*r:a*r**i),max=Math.max(...arr.map(Math.abs),1);$('stepLabel').childNodes[0].textContent=type==='ar'?'Diferencia':'Razón';$('sequence').innerHTML=arr.map((v,i)=>`<div class="term ${i===n-1?'hot':''}" style="height:${30+Math.abs(v)/max*220}px">${Number(v.toFixed(2))}</div>`).join('');let last=arr.at(-1),sum=arr.reduce((x,y)=>x+y,0);$('nth').textContent=Number(last.toFixed(3));$('sum').textContent=Number(sum.toFixed(3));$('formula').textContent=type==='ar'?`aₙ = ${a} + (n−1)·${r}`:`aₙ = ${a}·${r}ⁿ⁻¹`;let conv=type==='geo'&&Math.abs(r)<1;$('trend').textContent=conv?'Converge':r===0?'Constante':Math.abs(last)>Math.abs(a)?'Crece':'Decrece';$('meaning').textContent=conv?'La suma infinita se acerca a un valor finito.':'La suma parcial cambia cada vez que agregás términos.'}
$('next').onclick=()=>{$('count').value=Math.min(20,+$('count').value+1);render()};root.querySelectorAll('input,select').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-sucesiones-series{--blue:#174b7a;--ink:#182a32;--muted:#65757d;--line:#d7e1df;--coral:#db684f;--mint:#dff2e9;--paper:#f5f7f5}.mockup-sucesiones-series *{box-sizing:border-box}.mockup-sucesiones-series{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-sucesiones-series input,.mockup-sucesiones-series select,.mockup-sucesiones-series button{font:inherit}.mockup-sucesiones-series .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-sucesiones-series .crumb{color:var(--blue);font-weight:850}.mockup-sucesiones-series h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-sucesiones-series .lead{font-size:18px;color:var(--muted)}.mockup-sucesiones-series .composer{display:flex;gap:12px;flex-wrap:wrap;margin:25px 0}.mockup-sucesiones-series .composer label{background:#fff;border:1px solid var(--line);border-radius:14px;padding:10px 14px;font-size:12px;font-weight:800}.mockup-sucesiones-series .composer input,.mockup-sucesiones-series .composer select{display:block;border:0;background:transparent;font-weight:900;color:var(--ink);padding-top:5px}.mockup-sucesiones-series .composer button{border:0;border-radius:14px;background:var(--blue);color:#fff;padding:13px 18px;font-weight:900}.mockup-sucesiones-series .sequence{height:310px;background:#fff;border:1px solid var(--line);border-radius:26px;padding:30px;display:flex;align-items:flex-end;gap:10px;overflow:hidden}.mockup-sucesiones-series .term{flex:1;min-width:45px;background:var(--mint);border-top:5px solid var(--blue);border-radius:10px 10px 0 0;display:flex;align-items:flex-start;justify-content:center;padding-top:8px;font-weight:900;transition:.25s}.mockup-sucesiones-series .term.hot{background:#ffe4da;border-color:var(--coral)}.mockup-sucesiones-series .strip{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:18px}.mockup-sucesiones-series .card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:18px}.mockup-sucesiones-series .card b{display:block;font-size:27px;color:var(--blue)}.mockup-sucesiones-series .card code{display:block;margin-top:8px;color:var(--coral)}.mockup-sucesiones-series .verdict{background:var(--blue);color:#fff}.mockup-sucesiones-series .verdict b{color:#fff}.mockup-sucesiones-series .verdict p{color:#dce9ef}@media(max-width:700px){.mockup-sucesiones-series .strip{grid-template-columns:1fr}.mockup-sucesiones-series .sequence{height:250px;padding:18px}.mockup-sucesiones-series .term{min-width:35px}}
.mockup-sucesiones-series { width:100%; overflow:hidden; }
.mockup-sucesiones-series .top, .mockup-sucesiones-series header.top { display:none !important; }
.mockup-sucesiones-series .foot { display:none !important; }
.mockup-sucesiones-series .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-sucesiones-series .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-sucesiones-series .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-sucesiones-series .support-real summary { cursor:pointer; font-weight:750; }
.mockup-sucesiones-series .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-sucesiones-series :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-sucesiones-series input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-sucesiones-series input[type="number"]::-webkit-inner-spin-button, .mockup-sucesiones-series input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-sucesiones-series .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-sucesiones-series support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
