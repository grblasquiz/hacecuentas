---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-pension-imss-mexico" set:html={`
    <section class="hero"><div class="wrap"><div class="crumb">México / Trabajo / Mi pensión IMSS</div><div class="hero-grid"><div><div class="eyebrow">Pensión IMSS e ISSSTE 2026</div><h1>Tu pensión empieza por saber qué ley te corresponde.</h1><p>Estimá cuánto podrías cobrar, cuántas semanas te faltan y qué cambia si esperás o seguís cotizando.</p></div><aside class="detector"><h2>¿Cuándo empezaste a cotizar?</h2><p>Esta fecha cambia por completo la forma de calcular tu pensión.</p><div class="detector-choice"><button class="detect active" data-detect="73"><b>Antes del 1 de julio de 1997</b><small>Te corresponde comparar bajo Ley 73</small></button><button class="detect" data-detect="97"><b>Desde el 1 de julio de 1997</b><small>Tu referencia principal es Ley 97</small></button></div><div class="regime"><small>RÉGIMEN ORIENTATIVO</small><strong id="detectedLaw">Ley 73</strong><p id="detectedText">Mandan tu salario promedio, semanas cotizadas y edad de retiro.</p></div></aside></div></div></section>

    <section class="wrap calculator"><div class="card"><h2>¿Cuál es tu situación?</h2><p class="helper">Todos los casos están disponibles. Elegí el que necesitás resolver.</p><div class="cases">
      <button class="case active" data-case="ley73"><span>73</span>Ley 73</button><button class="case" data-case="ley97"><span>97</span>Ley 97</button><button class="case" data-case="m40"><span>40</span>Modalidad 40</button><button class="case" data-case="issste"><span>I</span>ISSSTE</button><button class="case" data-case="invalidez"><span>+</span>Invalidez</button><button class="case" data-case="viudez"><span>♥</span>Viudez</button>
    </div><div class="case-note" id="caseNote"><strong>Ley 73:</strong> usa el salario promedio de las últimas 250 semanas, semanas cotizadas y edad de retiro.</div><div class="fields">
      <div class="field" id="fieldSalary"><label id="labelSalary">Salario promedio mensual</label><div class="input"><span class="unit">$</span><input id="salary" value="18000" inputmode="decimal"><span class="unit">MXN</span></div></div>
      <div class="field" id="fieldWeeks"><label>Semanas cotizadas</label><div class="input"><input id="weeks" value="900" inputmode="numeric"><span class="unit">semanas</span></div></div>
      <div class="field" id="fieldRetireAge"><label>Edad de retiro</label><div class="input"><select id="retireAge"><option>60</option><option>61</option><option>62</option><option>63</option><option>64</option><option selected>65</option><option>66</option><option>67</option><option>68</option><option>70</option></select><span class="unit">años</span></div></div>
      <div class="field" id="fieldSpouse"><label>¿Tenés cónyuge?</label><div class="input"><select id="spouse"><option value="no">No</option><option value="si">Sí</option></select></div></div>
      <div class="field" id="fieldChildren"><label>Hijos con derecho</label><div class="input"><input id="children" value="0" inputmode="numeric"><span class="unit">hijos</span></div></div>
      <div class="field hidden" id="fieldAfore"><label>Saldo actual de tu Afore</label><div class="input"><span class="unit">$</span><input id="afore" value="450000" inputmode="decimal"><span class="unit">MXN</span></div></div>
      <div class="field hidden" id="fieldCurrentAge"><label>Tu edad actual</label><div class="input"><input id="currentAge" value="45" inputmode="numeric"><span class="unit">años</span></div></div>
      <div class="field hidden" id="fieldYield"><label>Rendimiento anual esperado</label><div class="input"><input id="yieldRate" value="5" inputmode="decimal"><span class="unit">%</span></div></div>
      <div class="field hidden" id="fieldUma"><label>Salario elegido en Modalidad 40</label><div class="input"><input id="uma" value="10" inputmode="decimal"><span class="unit">UMA</span></div></div>
      <div class="field hidden" id="fieldM40Years"><label>Tiempo en Modalidad 40</label><div class="input"><input id="m40Years" value="5" inputmode="numeric"><span class="unit">años</span></div></div>
      <div class="field hidden" id="fieldService"><label>Años de servicio público</label><div class="input"><input id="service" value="30" inputmode="numeric"><span class="unit">años</span></div></div>
      <div class="field hidden" id="fieldSex"><label>Sexo para requisito ISSSTE</label><div class="input"><select id="sex"><option value="h">Hombre</option><option value="m">Mujer</option></select></div></div>
      <div class="field hidden" id="fieldBasePension"><label>Pensión del asegurado</label><div class="input"><span class="unit">$</span><input id="basePension" value="12000" inputmode="decimal"><span class="unit">MXN</span></div></div>
      <div class="field hidden" id="fieldInvalidity"><label>Grado de invalidez dictaminado</label><div class="input"><input id="invalidity" value="75" inputmode="decimal"><span class="unit">%</span></div></div>
    </div><div class="error" id="error"></div><div class="buttons"><button class="primary" id="calculate">Actualizar pensión</button><button class="secondary" id="reset">Restablecer</button></div></div>
    <aside class="card result" aria-live="polite"><div class="result-top"><span class="kicker">Estimación mensual</span><span class="pill" id="resultPill">LEY 73</span></div><div class="total" id="total">$12,495</div><div class="total-label" id="totalLabel">pensión mensual estimada</div><div class="progress"><div class="progress-head"><span id="progressLabel">Semanas para el requisito</span><b id="progressValue">900 / 500</b></div><div class="bar"><i id="progressBar" style="width:100%"></i></div></div><div class="rows"><div class="row"><span id="row1k">Semanas excedentes</span><b id="row1v">400</b></div><div class="row"><span id="row2k">Factor por edad</span><b id="row2v">100%</b></div><div class="row"><span id="row3k">Tasa de reemplazo</span><b id="row3v">69%</b></div><div class="row"><span id="row4k">Pensión anual + aguinaldo</span><b id="row4v">$162,435</b></div></div><div class="next"><small>SIGUIENTE PASO</small><strong id="nextText">Descargá tu constancia oficial de semanas cotizadas.</strong></div><div class="warning">Estimación informativa. El IMSS, ISSSTE o la aseguradora determinan el monto definitivo según tu expediente.</div></aside>
    </section>

    <section class="info tint"><div class="wrap"><div class="section-head"><div class="eyebrow">La diferencia clave</div><h2>Ley 73 y Ley 97 calculan cosas distintas</h2></div><div class="timeline"><article class="law"><h3>Ley 73</h3><p>Para quienes cotizaron antes del 1 de julio de 1997.</p><ul><li>Promedio de las últimas 250 semanas</li><li>Mínimo de 500 semanas</li><li>La edad modifica el porcentaje</li><li>Modalidad 40 puede elevar el promedio</li></ul></article><article class="law"><h3>Ley 97</h3><p>Para quienes empezaron desde el 1 de julio de 1997.</p><ul><li>Depende del saldo acumulado en la Afore</li><li>En 2026 exige 875 semanas</li><li>Puede aplicar una pensión garantizada</li><li>El retiro depende de saldo y rendimiento</li></ul></article></div></div></section>
    <section class="info"><div class="wrap"><div class="section-head"><div class="eyebrow">Antes de planear</div><h2>Cuatro datos que conviene verificar</h2></div><div class="steps"><article class="step"><div class="num">1</div><h3>Régimen correcto</h3><p>Confirmá tu fecha de primera cotización y si conservás derechos.</p></article><article class="step"><div class="num">2</div><h3>Semanas reconocidas</h3><p>Usá la constancia oficial del IMSS, no una estimación de años.</p></article><article class="step"><div class="num">3</div><h3>Salario registrado</h3><p>Revisá el salario base con el que tu patrón te dio de alta.</p></article><article class="step"><div class="num">4</div><h3>Beneficiarios</h3><p>Cónyuge e hijos pueden cambiar asignaciones y protección.</p></article></div></div></section>
    <section class="info tint"><div class="wrap"><div class="section-head"><h2>Preguntas frecuentes</h2></div><div class="faq"><div class="faq-item open"><button class="faq-q">¿Cómo sé si soy Ley 73 o Ley 97?<span>−</span></button><div class="faq-a">La referencia es tu primera cotización al IMSS: antes del 1 de julio de 1997 corresponde revisar Ley 73; desde esa fecha, Ley 97.</div></div><div class="faq-item"><button class="faq-q">¿Cuántas semanas necesito en 2026?<span>+</span></button><div class="faq-a">Ley 73 exige al menos 500 semanas. Para la pensión garantizada de Ley 97, en 2026 se requieren 875.</div></div><div class="faq-item"><button class="faq-q">¿Modalidad 40 sirve para todos?<span>+</span></button><div class="faq-a">Es especialmente relevante para Ley 73. Antes de inscribirte conviene comparar el costo total con el aumento estimado de pensión.</div></div></div></div></section>
  `} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-pension-imss-mexico')?document.currentScript.previousElementSibling:document.querySelector('.mockup-pension-imss-mexico');

    const $=id=>root.querySelector("#"+id),money=n=>new Intl.NumberFormat("es-MX",{style:"currency",currency:"MXN",maximumFractionDigits:0}).format(n||0),num=id=>Number($(id).value.replace(/,/g,""));
    let current="ley73";const UMA=3566.22,SM=9577.22;
    const configs={
      ley73:{show:["Salary","Weeks","RetireAge","Spouse","Children"],pill:"LEY 73",note:"<strong>Ley 73:</strong> usa el salario promedio de las últimas 250 semanas, semanas cotizadas y edad de retiro."},
      ley97:{show:["Salary","Weeks","RetireAge","Afore","CurrentAge","Yield"],pill:"LEY 97",note:"<strong>Ley 97:</strong> proyecta tu saldo Afore y comprueba si alcanzás las 875 semanas requeridas en 2026."},
      m40:{show:["Weeks","RetireAge","Uma","M40Years"],pill:"MODALIDAD 40",note:"<strong>Modalidad 40:</strong> compará cuánto aportarías con el aumento estimado de pensión bajo Ley 73."},
      issste:{show:["Salary","RetireAge","Service","Sex"],pill:"ISSSTE",note:"<strong>Décimo Transitorio:</strong> estima el porcentaje según edad, sexo y años de servicio público."},
      invalidez:{show:["Salary","Weeks","Spouse","Children","Invalidity"],pill:"INVALIDEZ",note:"<strong>Invalidez:</strong> usa el salario promedio de 500 semanas, el dictamen y tus beneficiarios."},
      viudez:{show:["BasePension","Weeks","Children"],pill:"VIUDEZ",note:"<strong>Viudez:</strong> el 90% se calcula sobre la pensión del asegurado, no sobre su salario."}
    };
    function ageFactor(a){return a>=65?1:({60:.75,61:.8,62:.85,63:.9,64:.95}[a]||.75)}
    function pension73(salary,weeks,age,spouse,children){if(weeks<500)return 0;const extra=Math.floor((weeks-500)/52),base=salary*(.35+extra*.012),family=base*((spouse?.15:.15)+children*.10),raw=Math.min(salary,(base+family)*ageFactor(age)*1.11);return Math.max(raw,SM*1.11)}
    function setRows(rows){rows.forEach((r,i)=>{$(`row${i+1}k`).textContent=r[0];$(`row${i+1}v`).textContent=r[1]})}
    function setCase(k){current=k;root.querySelectorAll(".case").forEach(b=>b.classList.toggle("active",b.dataset.case===k));const c=configs[k];["Salary","Weeks","RetireAge","Spouse","Children","Afore","CurrentAge","Yield","Uma","M40Years","Service","Sex","BasePension","Invalidity"].forEach(f=>$("field"+f).classList.toggle("hidden",!c.show.includes(f)));$("caseNote").innerHTML=c.note;$("resultPill").textContent=c.pill;$("labelSalary").textContent=k==="issste"?"Sueldo básico promedio":"Salario promedio mensual";$("error").style.display="none";compute()}
    function fail(t){$("error").textContent=t;$("error").style.display="block";$("total").textContent="—"}
    function compute(){
      $("error").style.display="none";const salary=num("salary"),weeks=num("weeks"),age=num("retireAge"),spouse=$("spouse").value==="si",children=num("children"),afore=num("afore"),currentAge=num("currentAge"),yieldRate=num("yieldRate"),uma=num("uma"),m40Years=num("m40Years"),service=num("service"),sex=$("sex").value,basePension=num("basePension"),invalidity=num("invalidity");
      let total,label="pensión mensual estimada",rows,next,progress=0,progressLabel="Semanas para el requisito",progressValue="";
      const values={ley73:[salary,weeks,age,children],ley97:[salary,weeks,age,afore,currentAge,yieldRate],m40:[weeks,age,uma,m40Years],issste:[salary,age,service],invalidez:[salary,weeks,children,invalidity],viudez:[basePension,weeks,children]}[current];if(values.some(v=>!Number.isFinite(v)||v<0))return fail("Revisá los valores ingresados.");
      if(current==="ley73"){const req=500;progress=Math.min(100,weeks/req*100);progressValue=`${weeks} / ${req}`;if(weeks<req){total=0;label="todavía no cumplís el requisito";rows=[["Semanas cotizadas",weeks],["Semanas mínimas",req],["Semanas que faltan",req-weeks],["Años aproximados",(req-weeks)/52+""]];next="Seguí cotizando y verificá que todas tus semanas estén reconocidas."}else{total=pension73(salary,weeks,age,spouse,children);rows=[["Semanas excedentes",weeks-req],["Factor por edad",(ageFactor(age)*100).toFixed(0)+"%"],["Tasa de reemplazo",(total/salary*100).toFixed(0)+"%"],["Pensión anual + aguinaldo",money(total*13)]];next="Descargá tu constancia oficial de semanas cotizadas."}}
      else if(current==="ley97"){const req=875,years=Math.max(0,age-currentAge),final=afore*(1+yieldRate/100/12)**(years*12),byBalance=final*.004,pmg=3500+Math.min(1,Math.max(0,(salary/UMA-1)/11))*7100,eligible=weeks>=req&&age>=60;total=eligible?Math.max(byBalance,pmg):byBalance;progress=Math.min(100,weeks/req*100);progressValue=`${weeks} / ${req}`;rows=[["Saldo proyectado",money(final)],["Pensión por saldo",money(byBalance)],["Pensión garantizada estimada",money(pmg)],["Semanas que faltan",Math.max(0,req-weeks)]];next=eligible?"Pedí a tu Afore escenarios de retiro y renta vitalicia.":"Revisá cuántas semanas te faltan para la pensión garantizada."}
      else if(current==="m40"){if(uma<1||uma>25)return fail("El salario de Modalidad 40 debe estar entre 1 y 25 UMA.");const monthly=uma*UMA*.147,added=m40Years*52,totalWeeks=weeks+added,projected=pension73(uma*UMA,totalWeeks,age,false,0);total=monthly;label="cuota mensual estimada";progress=Math.min(100,totalWeeks/500*100);progressValue=`${totalWeeks} semanas`;progressLabel="Semanas al finalizar";rows=[["Salario base elegido",money(uma*UMA)],["Aporte total",money(monthly*m40Years*12)],["Semanas nuevas",added],["Pensión Ley 73 proyectada",money(projected)]];next="Compará el aporte total con los meses necesarios para recuperarlo."}
      else if(current==="issste"){const req=sex==="m"?28:30,minAge=sex==="m"?56:58,capped=Math.min(salary,10*UMA),factor=service>=req&&age>=minAge?1:Math.min(.95,Math.max(.5,.5+(service-15)*.025));total=Math.max(SM,capped*factor);progress=Math.min(100,service/req*100);progressLabel="Años de servicio";progressValue=`${service} / ${req}`;rows=[["Sueldo básico topado",money(capped)],["Porcentaje aplicado",(factor*100).toFixed(1)+"%"],["Edad mínima",minAge+" años"],["Pensión anual",money(total*12)]];next="Confirmá que elegiste Décimo Transitorio y revisá tu hoja única de servicios."}
      else if(current==="invalidez"){const req=invalidity>=75?150:250,base=salary*.35,family=base*((spouse?.15:0)+children*.10);total=Math.max(3500,base+family);progress=Math.min(100,weeks/req*100);progressValue=`${weeks} / ${req}`;rows=[["Cuantía básica",money(base)],["Asignaciones familiares",money(family)],["Semanas requeridas",req],["Pensión anual",money(total*13)]];next=weeks>=req?"El monto definitivo depende del dictamen del IMSS.":"Todavía no alcanzás las semanas requeridas para este dictamen."}
      else{const widow=basePension*.9,orphans=basePension*.2*children,totalFamily=Math.min(basePension,widow+orphans);total=widow;label="pensión mensual de viudez";progress=Math.min(100,weeks/150*100);progressValue=`${weeks} / 150`;rows=[["Base del asegurado",money(basePension)],["Viudez 90%",money(widow)],["Orfandad estimada",money(orphans)],["Total familiar topado",money(totalFamily)]];next=weeks>=150?"Reuní acta de defunción, vínculo y constancia de semanas.":"Revisá las excepciones por riesgo de trabajo o hijos en común."}
      $("total").textContent=money(total);$("totalLabel").textContent=label;$("progressLabel").textContent=progressLabel;$("progressValue").textContent=progressValue;$("progressBar").style.width=Math.max(4,progress)+"%";setRows(rows);$("nextText").textContent=next;
    }
    root.querySelectorAll(".case").forEach(b=>b.onclick=()=>setCase(b.dataset.case));root.querySelectorAll(".detect").forEach(b=>b.onclick=()=>{root.querySelectorAll(".detect").forEach(x=>x.classList.toggle("active",x===b));const law=b.dataset.detect;$("detectedLaw").textContent="Ley "+law;$("detectedText").textContent=law==="73"?"Mandan tu salario promedio, semanas cotizadas y edad de retiro.":"Mandan tu saldo Afore, semanas y modalidad de pensión.";setCase("ley"+law)});$("calculate").onclick=compute;$("reset").onclick=()=>{Object.entries({salary:18000,weeks:900,retireAge:65,spouse:"no",children:0,afore:450000,currentAge:45,yieldRate:5,uma:10,m40Years:5,service:30,sex:"h",basePension:12000,invalidity:75}).forEach(([k,v])=>$(k).value=v);setCase("ley73")};root.querySelectorAll("input,select").forEach(i=>i.addEventListener("keydown",e=>{if(e.key==="Enter")compute()}));root.querySelectorAll(".faq-q").forEach(q=>q.onclick=()=>{const p=q.parentElement;p.classList.toggle("open");q.lastElementChild.textContent=p.classList.contains("open")?"−":"+"});compute();
  
})();
</script>
<style is:global>

    .mockup-pension-imss-mexico{--ink:#101f3a;--muted:#68758a;--green:#17755b;--soft:#e0f5ec;--navy:#102e4b;--cream:#f7f8f3;--line:#dfe4e2;--yellow:#f2d06e;--orange:#e98e5d;--white:#fff}
    .mockup-pension-imss-mexico *{box-sizing:border-box}.mockup-pension-imss-mexico{margin:0;background:var(--cream);color:var(--ink);font:16px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-pension-imss-mexico button,.mockup-pension-imss-mexico input,.mockup-pension-imss-mexico select{font:inherit}.mockup-pension-imss-mexico .flag{height:5px;background:linear-gradient(90deg,#17755b 0 33%,#fff 33% 66%,#c54d52 66%)}.mockup-pension-imss-mexico .wrap{max-width:1180px;margin:auto;padding:0 24px}
    .mockup-pension-imss-mexico header{height:78px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-pension-imss-mexico .nav{display:flex;align-items:center;gap:29px}.mockup-pension-imss-mexico .brand{font-size:19px;font-weight:900;display:flex;align-items:center;gap:10px}.mockup-pension-imss-mexico .logo{width:34px;height:37px;background:var(--navy);color:#fff;border-radius:9px;display:grid;place-items:center}.mockup-pension-imss-mexico .links{display:flex;gap:23px;color:#526075;font-size:13px;font-weight:700}.mockup-pension-imss-mexico .actions{margin-left:auto;display:flex;gap:8px}.mockup-pension-imss-mexico .sm{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 13px;font-weight:750;color:var(--ink)}
