---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-liquidacion-apalancamiento" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Inversiones / Liquidación con apalancamiento</div><div class="eyebrow">Mapa de riesgo antes de abrir</div><h1>No mires sólo la ganancia potencial. Ubicá primero dónde desaparece tu margen.</h1><p class="lead">Entrada, apalancamiento, margen de mantenimiento y stop aparecen sobre la misma escala de precio.</p></div><div class="risk-scale"><div class="vertical"></div><span class="marker" style="--top:28%">ENTRADA</span><span class="label" style="--top:28%">US$ 100</span><span class="marker" style="--top:72%;background:#a34843">LIQ.</span><span class="label left" style="--top:72%">US$ 90,50</span></div></div></section>
<section class="terminal"><div class="screen"><div class="screen-head"><div class="pair">BTC / USDT <span>PERPETUO</span></div><div class="direction"><button class="long active" data-side="long">LONG</button><button class="short" data-side="short">SHORT</button></div></div><div class="trade-grid"><aside class="ticket"><h2>Definí la posición</h2><div class="field"><label for="entry"><span>PRECIO DE ENTRADA</span><output id="entryOut">100,00</output></label><input id="entry" type="number" value="100" min=".01" step=".01"></div><div class="field"><label for="margin"><span>MARGEN APORTADO</span><output id="marginOut">US$ 500</output></label><input id="margin" type="number" value="500" min="1" step="10"></div><div class="field"><label><span>APALANCAMIENTO</span><output id="leverageOut">10×</output></label><div class="leverage-pills"><button class="lev" data-lev="2">2×</button><button class="lev" data-lev="5">5×</button><button class="lev active" data-lev="10">10×</button><button class="lev" data-lev="20">20×</button><button class="lev" data-lev="50">50×</button></div></div><div class="field"><label for="maintenance"><span>MARGEN DE MANTENIMIENTO</span><output id="maintenanceOut">0,5%</output></label><input id="maintenance" type="number" value=".5" min="0" max="20" step=".1"></div><div class="field"><label for="stop"><span>STOP ELEGIDO</span><output id="stopOut">94,00</output></label><input id="stop" type="number" value="94" min=".01" step=".01"></div><div class="ticket-note">La fórmula exacta cambia por exchange, modo de margen, comisiones y funding. Este mapa es educativo.</div></aside><section class="map" aria-live="polite"><div class="map-top"><div><small>PRECIO DE LIQUIDACIÓN APROXIMADO</small><strong id="liquidation">90,50</strong></div><span class="badge" id="badge">Riesgo alto</span></div><div class="price-map"><div class="track"></div><i class="point market" id="marketPoint" style="--y:5%" data-price="105,00"></i><i class="point entry" id="entryPoint" style="--y:25%" data-price="100,00"></i><i class="point stop" id="stopPoint" style="--y:52%" data-price="94,00"></i><i class="point liq" id="liqPoint" style="--y:88%" data-price="90,50"></i></div><div class="risk-readout"><div class="readout"><small>EXPOSICIÓN</small><b id="exposure">US$ 5.000</b></div><div class="readout"><small>DISTANCIA A LIQ.</small><b id="distance">9,50%</b></div><div class="readout"><small>PÉRDIDA EN EL STOP</small><b id="stopLoss">US$ 300</b></div></div><div class="warning" id="warning">El stop está antes de la liquidación, pero arriesga 60% del margen aportado.</div></section></div></div></section>
<section class="learn"><div class="wrap learn-grid"><div><div class="kicker">Tres controles antes de abrir</div><h2>El riesgo se define antes de entrar</h2><p>Una liquidación no es un stop: es el cierre forzado cuando el margen deja de sostener la posición.</p></div><div class="checks"><div class="check"><b>Distancia</b><span>Compará entrada, stop y liquidación. El stop necesita margen para deslizamiento y comisiones.</span></div><div class="check"><b>Pérdida monetaria</b><span>Convertí el porcentaje en dinero sobre tu capital total, no sólo sobre la operación.</span></div><div class="check"><b>Reglas del exchange</b><span>Verificá margen aislado o cruzado, mantenimiento, funding y fórmula exacta.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-liquidacion-apalancamiento')?document.currentScript.previousElementSibling:document.querySelector('.mockup-liquidacion-apalancamiento');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let side="long",lev=10;const fmt=n=>n.toLocaleString("es-AR",{minimumFractionDigits:2,maximumFractionDigits:2}),usd=n=>"US$ "+Math.round(Math.abs(n)).toLocaleString("es-AR");function calc(){const entry=Math.max(.01,+$("#entry").value||0),margin=Math.max(1,+$("#margin").value||0),maintenance=Math.max(0,+$("#maintenance").value||0)/100,stop=Math.max(.01,+$("#stop").value||0),move=1/lev-maintenance,liq=side==="long"?entry*(1-move):entry*(1+move),distance=Math.abs(liq-entry)/entry*100,exposure=margin*lev,stopMove=(side==="long"?(entry-stop):(stop-entry))/entry,loss=Math.max(0,stopMove*exposure),risk=loss/margin*100;$("#entryOut").textContent=fmt(entry);$("#marginOut").textContent=usd(margin);$("#leverageOut").textContent=lev+"×";$("#maintenanceOut").textContent=(maintenance*100).toFixed(1).replace(".",",")+"%";$("#stopOut").textContent=fmt(stop);$("#liquidation").textContent=fmt(liq);$("#exposure").textContent=usd(exposure);$("#distance").textContent=fmt(distance)+"%";$("#stopLoss").textContent=usd(loss);$("#entryPoint").dataset.price=fmt(entry);$("#stopPoint").dataset.price=fmt(stop);$("#liqPoint").dataset.price=fmt(liq);const values=[entry*1.05,entry,stop,liq],max=Math.max(...values),min=Math.min(...values),pos=v=>(max-v)/Math.max(.0001,max-min)*83+5;$("#marketPoint").dataset.price=fmt(values[0]);$("#marketPoint").style.setProperty("--y",pos(values[0])+"%");$("#entryPoint").style.setProperty("--y",pos(entry)+"%");$("#stopPoint").style.setProperty("--y",pos(stop)+"%");$("#liqPoint").style.setProperty("--y",pos(liq)+"%");$("#badge").textContent=distance<4?"Riesgo extremo":distance<10?"Riesgo alto":"Margen amplio";$("#warning").textContent=loss===0?"El stop cargado está del lado de la ganancia; revisá la dirección de la posición.":stopMove>=move?"El stop queda más allá de la liquidación: no podría proteger la posición.":`El stop está antes de la liquidación, pero arriesga ${Math.round(risk)}% del margen aportado.`}$$("[data-side]").forEach(b=>b.addEventListener("click",()=>{side=b.dataset.side;$$("[data-side]").forEach(x=>x.classList.toggle("active",x===b));calc()}));$$("[data-lev]").forEach(b=>b.addEventListener("click",()=>{lev=+b.dataset.lev;$$("[data-lev]").forEach(x=>x.classList.toggle("active",x===b));calc()}));$$("input").forEach(x=>x.addEventListener("input",calc));calc()})();
})();
</script>
<style is:global>

.mockup-liquidacion-apalancamiento{--blue:#174b7a;--red:#b6534d;--rose:#fff0ee;--green:#2c8067;--mint:#e2f1e9;--amber:#d99b35;--ink:#182332;--muted:#5f6977;--line:#d9e2e4}.mockup-liquidacion-apalancamiento *{box-sizing:border-box}.mockup-liquidacion-apalancamiento{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#faf9f9}.mockup-liquidacion-apalancamiento button,.mockup-liquidacion-apalancamiento input{font:inherit}.mockup-liquidacion-apalancamiento .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-liquidacion-apalancamiento .brand{font-size:19px;font-weight:950}.mockup-liquidacion-apalancamiento .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-liquidacion-apalancamiento .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-liquidacion-apalancamiento .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-liquidacion-apalancamiento .hero{padding:42px 22px 45px;background:linear-gradient(112deg,#fff 0 67%,var(--rose) 67%)}.mockup-liquidacion-apalancamiento .hero-grid,.mockup-liquidacion-apalancamiento .wrap{max-width:1180px;margin:auto}.mockup-liquidacion-apalancamiento .hero-grid{display:grid;grid-template-columns:1fr .85fr;gap:55px;align-items:center}.mockup-liquidacion-apalancamiento .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-liquidacion-apalancamiento .eyebrow{margin-top:25px;color:var(--red);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-liquidacion-apalancamiento .hero h1{font-size:clamp(43px,5vw,64px);line-height:.98;letter-spacing:-.05em;margin:9px 0 18px}.mockup-liquidacion-apalancamiento .lead{font-size:19px;color:var(--muted)}.mockup-liquidacion-apalancamiento .risk-scale{height:320px;position:relative;padding:35px 65px}.mockup-liquidacion-apalancamiento .vertical{position:absolute;left:50%;top:30px;bottom:30px;width:24px;border-radius:99px;background:linear-gradient(180deg,#5bb78d 0 52%,#e4b44d 52% 70%,#c95a54 70%)}.mockup-liquidacion-apalancamiento .marker{position:absolute;left:50%;top:var(--top);transform:translate(-50%,-50%);width:64px;height:38px;border:5px solid #fff;background:var(--blue);border-radius:12px;color:#fff;display:grid;place-items:center;font-size:10px;font-weight:950;box-shadow:0 6px 18px #17374a2b}.mockup-liquidacion-apalancamiento .label{position:absolute;left:calc(50% + 45px);top:var(--top);transform:translateY(-50%);font-size:11px;font-weight:900}.mockup-liquidacion-apalancamiento .label.left{right:calc(50% + 45px);left:auto;text-align:right}.mockup-liquidacion-apalancamiento .terminal{padding:0 22px 70px}.mockup-liquidacion-apalancamiento .screen{max-width:1180px;margin:auto;background:#1d2934;color:#fff;border-radius:22px;overflow:hidden;box-shadow:0 22px 50px #18263225}.mockup-liquidacion-apalancamiento .screen-head{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:18px 23px;border-bottom:1px solid #ffffff1c}.mockup-liquidacion-apalancamiento .pair{font-weight:950}.mockup-liquidacion-apalancamiento .pair span{color:#aebeca;font-size:11px;margin-left:8px}.mockup-liquidacion-apalancamiento .direction{display:flex;gap:6px}.mockup-liquidacion-apalancamiento .direction button{border:1px solid #ffffff2c;background:#ffffff0d;color:#fff;border-radius:9px;padding:8px 13px;font-weight:900;cursor:pointer}.mockup-liquidacion-apalancamiento .direction button.active.long{background:#226f59}.mockup-liquidacion-apalancamiento .direction button.active.short{background:#923f3b}.mockup-liquidacion-apalancamiento .trade-grid{display:grid;grid-template-columns:330px 1fr}.mockup-liquidacion-apalancamiento .ticket{padding:22px;border-right:1px solid #ffffff1c}.mockup-liquidacion-apalancamiento .ticket h2{font-size:18px;margin:0 0 17px}.mockup-liquidacion-apalancamiento .field{margin:15px 0}.mockup-liquidacion-apalancamiento .field label{display:flex;justify-content:space-between;font-size:10px;color:#bdcbd4;font-weight:900;margin-bottom:6px}.mockup-liquidacion-apalancamiento .field input{width:100%;border:1px solid #ffffff2d;border-radius:9px;background:#ffffff0d;color:#fff;padding:10px}.mockup-liquidacion-apalancamiento .leverage-pills{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}.mockup-liquidacion-apalancamiento .lev{border:1px solid #ffffff29;background:#ffffff0c;color:#fff;border-radius:7px;padding:8px 4px;font-size:10px;font-weight:900;cursor:pointer}.mockup-liquidacion-apalancamiento .lev.active{background:var(--blue);border-color:#67a3c5}.mockup-liquidacion-apalancamiento .ticket-note{padding:11px;background:#ffffff0b;border-radius:9px;color:#bdcbd4;font-size:10px;margin-top:16px}.mockup-liquidacion-apalancamiento .map{padding:22px}.mockup-liquidacion-apalancamiento .map-top{display:flex;justify-content:space-between;gap:15px;align-items:start}.mockup-liquidacion-apalancamiento .map-top small{display:block;color:#aebeca;font-size:9px}.mockup-liquidacion-apalancamiento .map-top strong{font-size:31px}.mockup-liquidacion-apalancamiento .badge{padding:7px 10px;border-radius:99px;background:#ffe0dc;color:#792923;font-size:11px;font-weight:900}.mockup-liquidacion-apalancamiento .price-map{margin:25px 0 18px;position:relative;height:260px}.mockup-liquidacion-apalancamiento .track{position:absolute;left:110px;top:0;bottom:0;width:12px;border-radius:99px;background:linear-gradient(180deg,#3fa076,#d8a843 60%,#b94f49)}.mockup-liquidacion-apalancamiento .point{position:absolute;left:95px;top:var(--y);width:42px;height:5px;background:#fff}.mockup-liquidacion-apalancamiento .point:before{content:"";position:absolute;left:-90px;top:-12px;width:80px;text-align:right;color:#c4d1da;font-size:10px;font-weight:900}.mockup-liquidacion-apalancamiento .point:after{position:absolute;left:55px;top:-13px;white-space:nowrap;font-size:11px;font-weight:900}.mockup-liquidacion-apalancamiento .point.market:before{content:attr(data-price)}.mockup-liquidacion-apalancamiento .point.market:after{content:"Precio actual"}.mockup-liquidacion-apalancamiento .point.entry:before{content:attr(data-price)}.mockup-liquidacion-apalancamiento .point.entry:after{content:"Entrada"}.mockup-liquidacion-apalancamiento .point.stop:before{content:attr(data-price)}.mockup-liquidacion-apalancamiento .point.stop:after{content:"Stop elegido";color:#f2ca6f}.mockup-liquidacion-apalancamiento .point.liq:before{content:attr(data-price)}.mockup-liquidacion-apalancamiento .point.liq:after{content:"Liquidación aprox.";color:#ffaaa3}.mockup-liquidacion-apalancamiento .risk-readout{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mockup-liquidacion-apalancamiento .readout{padding:12px;border:1px solid #ffffff22;background:#ffffff0a;border-radius:10px}.mockup-liquidacion-apalancamiento .readout small{display:block;color:#aebeca;font-size:9px}.mockup-liquidacion-apalancamiento .readout b{font-size:14px}.mockup-liquidacion-apalancamiento .warning{margin-top:15px;padding:12px;background:#552e2d;color:#ffd6d2;border-radius:10px;font-size:11px}.mockup-liquidacion-apalancamiento .learn{padding:60px 22px;background:#f5eeee}.mockup-liquidacion-apalancamiento .learn-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:40px}.mockup-liquidacion-apalancamiento .kicker{color:var(--red);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-liquidacion-apalancamiento .learn h2{font-size:35px;letter-spacing:-.04em;margin:6px 0}.mockup-liquidacion-apalancamiento .learn p{color:var(--muted)}.mockup-liquidacion-apalancamiento .checks{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-liquidacion-apalancamiento .check{padding:16px;background:#fff;border:1px solid var(--line);border-radius:14px}.mockup-liquidacion-apalancamiento .check b{display:block;margin-bottom:5px;color:var(--red)}.mockup-liquidacion-apalancamiento .check span{font-size:12px;color:var(--muted)}.mockup-liquidacion-apalancamiento .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:880px){.mockup-liquidacion-apalancamiento .nav{display:none}.mockup-liquidacion-apalancamiento .hero-grid,.mockup-liquidacion-apalancamiento .trade-grid,.mockup-liquidacion-apalancamiento .learn-grid{grid-template-columns:1fr}.mockup-liquidacion-apalancamiento .ticket{border-right:0;border-bottom:1px solid #ffffff1c}.mockup-liquidacion-apalancamiento .checks{grid-template-columns:1fr}}@media(max-width:560px){.mockup-liquidacion-apalancamiento .hero h1{font-size:42px}.mockup-liquidacion-apalancamiento .risk-readout{grid-template-columns:1fr}.mockup-liquidacion-apalancamiento .price-map{margin-left:-40px}}

.mockup-liquidacion-apalancamiento { width:100%; overflow:hidden; }
.mockup-liquidacion-apalancamiento .top, .mockup-liquidacion-apalancamiento header.top { display:none !important; }
.mockup-liquidacion-apalancamiento .foot { display:none !important; }
.mockup-liquidacion-apalancamiento .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-liquidacion-apalancamiento .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-liquidacion-apalancamiento .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-liquidacion-apalancamiento .support-real summary { cursor:pointer; font-weight:750; }
.mockup-liquidacion-apalancamiento .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-liquidacion-apalancamiento :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-liquidacion-apalancamiento input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-liquidacion-apalancamiento input[type="number"]::-webkit-inner-spin-button, .mockup-liquidacion-apalancamiento input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-liquidacion-apalancamiento .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-liquidacion-apalancamiento support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
