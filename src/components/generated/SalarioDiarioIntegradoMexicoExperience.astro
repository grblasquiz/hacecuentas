---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-salario-diario-integrado-mexico" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>México</b> / Trabajo / Salario Diario Integrado</div><div class="grid"><div><div class="eyebrow">IMSS · LFT 2026</div><h1>Tu sueldo diario no es tu SDI.</h1><p class="lead">Integrá aguinaldo, vacaciones, prima vacacional y prestaciones fijas para conocer la base que usa el IMSS.</p><div class="chips"><span>✓ Vacaciones por antigüedad</span><span>✓ Factor de integración</span><span>✓ Tope de 25 UMA</span></div><article class="formula-card"><div class="formula-top"><b>Tu factor de integración</b><span id="hero-years">1 año</span></div><div class="formula-main"><strong id="hero-factor">1.0493</strong><small id="hero-vacation">12 días de vacaciones</small></div><div class="formula-row"><div><span>Salario diario</span><b id="hero-daily">$986.84</b></div><div><span>SDI diario</span><b id="hero-sdi">$1,035.49</b></div><div><span>SBC mensual</span><b id="hero-monthly">$31,478.90</b></div></div></article></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá tu SDI</h2><p>Usá tu salario nominal antes de descuentos.</p></div><span class="tag">Valores mínimos LFT</span></div><div class="label">¿Cómo tenés expresado el salario?</div><div class="periods"><button class="period active" data-period="mensual">Salario mensual</button><button class="period" data-period="diario">Salario diario</button></div><div class="label">Datos de tu empleo</div><div class="fields"><div class="field wide"><label id="salary-label">Salario mensual</label><div class="money"><b>$</b><input id="salary" value="30000"></div></div></div><div class="label">Años cumplidos de antigüedad</div><div class="years"><button class="year active" data-years="1">1 año</button><button class="year" data-years="2">2 años</button><button class="year" data-years="5">5 años</button><button class="year" data-years="10">10 años</button><button class="year" data-years="20">20 años</button></div><div class="fields" style="margin-top:10px"><div class="field"><label>Días de aguinaldo</label><input id="bonus-days" value="15"></div><div class="field"><label>Prima vacacional (%)</label><input id="vacation-premium" value="25"></div><div class="field wide"><label>Prestaciones fijas que integran · mensuales</label><div class="money"><b>$</b><input id="extras" value="0"></div></div></div>
<section class="result"><div class="result-top"><div><small>SALARIO DIARIO INTEGRADO</small><div class="value" id="result">$1,035.49 por día</div></div><div class="verdict"><small>Factor aplicado</small><b id="factor">1.0493</b></div></div><div class="stats"><span>SALARIO DIARIO<b id="daily">$986.84</b></span><span>SBC PARA IMSS<b id="sbc">$1,035.49/día</b></span><span>EQUIVALENTE MENSUAL<b id="monthly">$31,478.90</b></span></div><button class="go" id="update">Actualizar SDI</button></section></form></div></div></section>
<section class="section"><div class="wrap"><header class="center"><span>La integración diaria</span><h2>De dónde sale tu SDI</h2><p>Las prestaciones anuales se convierten en una proporción diaria y se suman al salario.</p></header><div class="composition"><div class="donut" id="donut"><div class="donut-center"><small>SDI POR DÍA</small><b id="donut-total">$1,035.49</b></div></div><div class="parts"><article class="part p1"><i></i><span>SALARIO DIARIO</span><b id="part-salary">$986.84</b></article><article class="part p2"><i></i><span>AGUINALDO DIARIO</span><b id="part-bonus">$40.56</b></article><article class="part p3"><i></i><span>PRIMA VACACIONAL</span><b id="part-vacation">$8.11</b></article><article class="part p4"><i></i><span>PRESTACIONES EXTRA</span><b id="part-extras">$0</b></article></div></div></div></section>
<section class="section tint"><div class="wrap breakdown"><article class="card"><h3>Tu fórmula, línea por línea</h3><div class="line"><span>Días del año</span><b>365</b></div><div class="line"><span>Días de aguinaldo</span><b id="d-bonus-days">+ 15</b></div><div class="line"><span>Vacaciones × prima</span><b id="d-vacation">+ 12 × 25%</b></div><div class="line"><span>Factor de integración</span><b id="d-factor">1.0493</b></div><div class="line"><span>Salario diario × factor</span><b id="d-base">$1,035.49</b></div><div class="line"><span>Prestaciones extra diarias</span><b id="d-extras">+ $0</b></div><div class="line total"><strong>SDI diario</strong><b id="d-total">$1,035.49</b></div></article><article class="card"><h3>Qué usa cada concepto</h3><div class="rule"><i>SD</i><div><b>Salario diario</b><span>Es tu sueldo mensual dividido entre 30.4 o el monto diario pactado.</span></div></div><div class="rule"><i>SDI</i><div><b>Salario Diario Integrado</b><span>Suma la proporción diaria de prestaciones. Sirve como referencia laboral y de integración.</span></div></div><div class="rule"><i>SBC</i><div><b>Salario Base de Cotización</b><span>Es la base reportada al IMSS, limitada a un máximo de 25 UMA diarias.</span></div></div><div class="warning">Si el SDI supera $2,932.75 diarios, el SBC se topa a 25 UMA para 2026. El salario real no baja: solo se limita la base de cotización.</div></article></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Vacaciones dignas</span><h2>Cómo cambia el factor con la antigüedad</h2></header><div class="seniority" id="seniority"></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-salario-diario-integrado-mexico')?document.currentScript.previousElementSibling:document.querySelector('.mockup-salario-diario-integrado-mexico');

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],mx=n=>"$"+n.toLocaleString("es-MX",{minimumFractionDigits:2,maximumFractionDigits:2}),num=id=>Math.max(0,Number($(id).value.replaceAll(",",""))||0);let period="mensual",years=1;function vacationDays(y){y=Math.max(1,Math.floor(y));return y<=5?10+y*2:20+2*Math.ceil((y-5)/5)}
function factorFor(y,bonus=15,premium=25){return(365+bonus+vacationDays(y)*premium/100)/365}
function calc(){const salary=num("#salary"),bonus=Math.max(15,num("#bonus-days")),premium=Math.max(25,num("#vacation-premium")),extrasMonthly=num("#extras"),daily=period==="mensual"?salary/30.4:salary,vac=vacationDays(years),factor=factorFor(years,bonus,premium),bonusDaily=daily*bonus/365,vacDaily=daily*vac*premium/100/365,extrasDaily=extrasMonthly/30.4,sdi=daily*factor+extrasDaily,cap=117.31*25,sbc=Math.min(sdi,cap),monthly=sbc*30.4,top=sdi>cap;$("#result").textContent=`${mx(sdi)} por día`;$("#factor").textContent=factor.toFixed(4);$("#daily").textContent=mx(daily);$("#sbc").textContent=top?`${mx(sbc)}/día · topado`:mx(sbc)+"/día";$("#monthly").textContent=mx(monthly);$("#hero-years").textContent=years===1?"1 año":`${years} años`;$("#hero-factor").textContent=factor.toFixed(4);$("#hero-vacation").textContent=`${vac} días de vacaciones`;$("#hero-daily").textContent=mx(daily);$("#hero-sdi").textContent=mx(sdi);$("#hero-monthly").textContent=mx(monthly);$("#donut-total").textContent=mx(sdi);$("#part-salary").textContent=mx(daily);$("#part-bonus").textContent=mx(bonusDaily);$("#part-vacation").textContent=mx(vacDaily);$("#part-extras").textContent=mx(extrasDaily);const salaryPct=daily/sdi*100,bonusPct=(daily+bonusDaily)/sdi*100,vacPct=(daily+bonusDaily+vacDaily)/sdi*100;$("#donut").style.setProperty("--salary-pct",salaryPct+"%");$("#donut").style.setProperty("--bonus-pct",bonusPct+"%");$("#donut").style.setProperty("--vac-pct",vacPct+"%");$("#d-bonus-days").textContent=`+ ${bonus}`;$("#d-vacation").textContent=`+ ${vac} × ${premium}%`;$("#d-factor").textContent=factor.toFixed(4);$("#d-base").textContent=mx(daily*factor);$("#d-extras").textContent="+ "+mx(extrasDaily);$("#d-total").textContent=mx(sdi);renderSeniority()}
function renderSeniority(){$("#seniority").innerHTML=[1,2,5,10,20].map(y=>`<article class="${y===years?"active":""}"><small>${y} ${y===1?"AÑO":"AÑOS"}</small><b>${factorFor(y).toFixed(4)}</b><span>${vacationDays(y)} días de vacaciones</span></article>`).join("")}
$$(".period").forEach(b=>b.onclick=()=>{period=b.dataset.period;$$(".period").forEach(x=>x.classList.toggle("active",x===b));$("#salary-label").textContent=period==="mensual"?"Salario mensual":"Salario diario";$("#salary").value=period==="mensual"?"30000":"1000";calc()});$$(".year").forEach(b=>b.onclick=()=>{years=+b.dataset.years;$$(".year").forEach(x=>x.classList.toggle("active",x===b));calc()});$$("input").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ SDI actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar SDI",1200)};calc();

})();
</script>
