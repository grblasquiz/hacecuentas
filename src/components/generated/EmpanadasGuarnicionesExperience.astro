---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-empanadas-guarniciones" set:html={`<section class="hero"><div class="wrap crumb"><b>Eventos</b> &nbsp;/&nbsp; Empanadas y guarniciones</div><div class="wrap grid"><div class="copy"><span class="eyebrow">La compra completa, sin adivinar</span><h1>Que sobren algunas. No cinco docenas.</h1><p>Calculá empanadas, masa, relleno, ensalada, pan y fuego según quiénes comen y qué lugar ocupa cada cosa en el menú.</p><div class="chips"><span>✓ Adultos y chicos</span><span>✓ Sabores repartidos</span><span>✓ Todo redondeado para comprar</span></div><div class="art"><div class="board"><div class="plate"><div class="emp-shape e1"></div><div class="emp-shape e2"></div><div class="emp-shape e3"></div></div><div class="fork">🍴</div></div><div class="note"><small id="art-label">EMPANADAS TOTALES</small><b id="art-value">108 unidades</b><span id="art-copy">9 docenas · plato principal</span></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Armá la compra</h2><p class="muted">Elegí qué parte querés resolver.</p></div><span class="tag">Cantidades reales</span></div><div class="label">¿Qué necesitás calcular?</div><div class="cases"><button type="button" class="case active" data-mode="emp"><i>🥟</i>Empanadas por persona</button><button type="button" class="case" data-mode="dough"><i>🌾</i>Rendimiento de masa</button><button type="button" class="case" data-mode="sides"><i>🥗</i>Ensalada y pan</button><button type="button" class="case" data-mode="fire"><i>🔥</i>Carbón y parrilla</button></div><div class="label">Datos de tu evento</div><div class="fields">
<div class="field emp sides fire"><label>Adultos</label><input id="adults" value="16"></div><div class="field emp sides fire"><label>Chicos</label><input id="kids" value="8"></div>
<div class="field emp"><label>Las empanadas son</label><select id="role"><option value="main">Plato principal</option><option value="side">Acompañan otra comida</option><option value="entry">Entrada o picoteo</option></select></div><div class="field emp"><label>Margen extra</label><select id="margin"><option value="1">Sin margen</option><option value="1.1" selected>10% · recomendado</option><option value="1.2">20% · comen abundante</option></select></div><div class="field emp wide"><label>Reparto de sabores</label><div style="display:flex;gap:7px"><input id="meat" value="40" title="Carne %"><input id="chicken" value="25" title="Pollo %"><input id="jyq" value="25" title="Jamón y queso %"><input id="veg" value="10" title="Verdura %"></div></div>
<div class="field dough hide"><label>Harina disponible (g)</label><input id="flour" value="1000"></div><div class="field dough hide"><label>Tipo de tapa</label><select id="doughType"><option value="45">Casera criolla al horno</option><option value="50">Casera para freír</option><option value="0">Tapas compradas</option></select></div>
<div class="field sides hide"><label>La ensalada funciona como</label><select id="saladRole"><option value="150">Guarnición</option><option value="300">Plato principal</option></select></div><div class="field sides hide"><label>Tipo de comida para el pan</label><select id="mealType"><option value="120">Asado</option><option value="80">Comida con otras guarniciones</option><option value="50">Picada</option></select></div>
<div class="field fire hide"><label>Duración del fuego</label><select id="duration"><option value=".35">Corta</option><option value=".5" selected>Normal</option><option value=".7">Larga</option></select></div><div class="field fire hide"><label>¿También usás leña?</label><select id="wood"><option value="0">No, sólo carbón</option><option value=".25">Sí, carbón y leña</option></select></div><div class="field fire hide"><label>Uso de la parrilla</label><select id="grillUse"><option value="500">Estándar</option><option value="700">Todo junto</option><option value="350">En tandas</option></select></div></div>
<section class="result"><div class="result-top"><div><small id="result-label">EMPANADAS A PREPARAR</small><div class="value" id="result">108 empanadas</div></div><div class="badge"><small id="badge-label">Compra sugerida</small><b id="badge">9 docenas</b></div></div><div class="stats"><span id="s1l">PARA ADULTOS<b id="s1">96</b></span><span id="s2l">PARA CHICOS<b id="s2">48</b></span><span id="s3l">RELLENO TOTAL<b id="s3">7,6 kg</b></span></div><button class="go" id="update" type="button">Actualizar cantidades</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span id="composition-kicker">Variedad sin improvisar</span><h2 id="composition-title">Cómo repartir los sabores</h2><p id="composition-copy">Los porcentajes se normalizan aunque no sumen cien, para que la cantidad final siempre cierre.</p></header><div class="stack"><div class="bar"><i class="b1" id="bar1">Carne</i><i class="b2" id="bar2">Pollo</i><i class="b3" id="bar3">Jamón y queso</i><i class="b4" id="bar4">Verdura</i></div><div class="legend"><span id="l1p">CARNE<b id="l1">44 unidades</b></span><span id="l2p">POLLO<b id="l2">27 unidades</b></span><span id="l3p">JAMÓN Y QUESO<b id="l3">27 unidades</b></span><span id="l4p">VERDURA<b id="l4">10 unidades</b></span></div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3 id="detail-title">Tu compra, línea por línea</h3><div class="line"><span id="d1l">Comensales</span><b id="d1">24 personas</b></div><div class="line"><span id="d2l">Consumo base</span><b id="d2">144 empanadas</b></div><div class="line"><span id="d3l">Margen elegido</span><b id="d3">10%</b></div><div class="line"><span id="d4l">Relleno necesario</span><b id="d4">7,6 kg</b></div><div class="line total"><strong id="d5l">Compra sugerida</strong><b id="d5">9 docenas</b></div></article><article class="card"><h3>Para que la cuenta funcione</h3><div class="rule"><i>1</i><div><b>Definí el rol</b><span>No se come lo mismo si es entrada que si reemplaza la cena.</span></div></div><div class="rule"><i>2</i><div><b>Separá chicos</b><span>Comen menos empanadas, pero cuentan completos para guarniciones livianas.</span></div></div><div class="rule"><i>3</i><div><b>Redondeá para comprar</b><span>Docenas, paquetes, kilos y bolsas completas evitan faltantes.</span></div></div><div class="warning">Ajustá vegetarianas, sin TACC y alergias antes de encargar. El total no reemplaza ese reparto.</div></article></div></section>
<section class="modes"><div class="wrap"><header class="center"><span>Todo lo que acompaña</span><h2>Cuatro cuentas, una sola juntada</h2></header><div class="modegrid"><article class="modecard"><i>🥟</i><h3>Empanadas</h3><p>Adultos, chicos, rol en el menú, margen y reparto de sabores.</p><em>En docenas</em></article><article class="modecard"><i>🌾</i><h3>Masa y relleno</h3><p>Rendimiento de harina, grasa, agua, sal y kilos de relleno.</p><em>Sin medias tapas</em></article><article class="modecard"><i>🥗</i><h3>Guarniciones</h3><p>Ensalada, lechuga, tomate, cebolla, pan y equivalencias.</p><em>Redondeo de compra</em></article><article class="modecard"><i>🔥</i><h3>Fuego</h3><p>Carbón, leña, pastillas, anticipación y superficie de parrilla.</p><em>Todo listo a tiempo</em></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#ffc6aa">La regla que evita el exceso</span><h2>Entrada no es plato principal.</h2><p>Si las empanadas acompañan un asado o una picada, la cantidad por persona cae fuerte. Elegir el rol correcto mueve más la compra que cualquier margen.</p></div><div class="facts"><div><small>PLATO PRINCIPAL</small><b>6 por adulto</b><span>4 por chico</span></div><div><small>ACOMPAÑAMIENTO</small><b>3 por adulto</b><span>2 por chico</span></div><div><small>ENTRADA</small><b>2 por adulto</b><span>1 por chico</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-empanadas-guarniciones')?document.currentScript.previousElementSibling:document.querySelector('.mockup-empanadas-guarniciones');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0),fmt=(x,d=1)=>Number(x||0).toLocaleString("es-AR",{minimumFractionDigits:d,maximumFractionDigits:d});let mode="emp";
function txt(id,v){$("#"+id).textContent=v}function stats(labels,vals){["s1l","s2l","s3l"].forEach((id,i)=>{$("#"+id).childNodes[0].nodeValue=labels[i];txt("s"+(i+1),vals[i])})}function details(title,rows){txt("detail-title",title);rows.forEach((r,i)=>{txt("d"+(i+1)+"l",r[0]);txt("d"+(i+1),r[1])})}
function compose(k,t,c,vals,labels,out){txt("composition-kicker",k);txt("composition-title",t);txt("composition-copy",c);labels.forEach((x,i)=>{$("#l"+(i+1)+"p").childNodes[0].nodeValue=x;txt("l"+(i+1),out[i])});let total=Math.max(1,vals.reduce((a,b)=>a+Math.abs(b),0));vals.forEach((v,i)=>$("#bar"+(i+1)).style.width=Math.max(3,Math.abs(v)/total*100)+"%")}
function art(l,v,c){txt("art-label",l);txt("art-value",v);txt("art-copy",c)}
function calc(){let adults=Math.round(n("#adults")),kids=Math.round(n("#kids")),people=adults+kids;
 if(mode==="emp"){let role=$("#role").value,P=role==="main"?[6,4]:role==="side"?[3,2]:[2,1],base=adults*P[0]+kids*P[1],total=Math.ceil(base*n("#margin")/12)*12,dozens=total/12,fill=total*70/1000,pcts=[n("#meat"),n("#chicken"),n("#jyq"),n("#veg")],sum=pcts.reduce((a,b)=>a+b,0)||1,units=pcts.map(x=>Math.round(total*x/sum));units[0]+=total-units.reduce((a,b)=>a+b,0);txt("result-label","EMPANADAS A PREPARAR");txt("result",total+" empanadas");txt("badge-label","Compra sugerida");txt("badge",dozens+" docenas");stats(["BASE ADULTOS","BASE CHICOS","RELLENO TOTAL"],[adults*P[0]+" unidades",kids*P[1]+" unidades",fmt(fill,1)+" kg"]);details("Tu compra, línea por línea",[["Comensales",people+" personas"],["Consumo base",base+" empanadas"],["Margen elegido",Math.round((n("#margin")-1)*100)+"%"],["Relleno necesario",fmt(fill,1)+" kg"],["Compra sugerida",dozens+" docenas"]]);compose("Variedad sin improvisar","Cómo repartir los sabores","Los porcentajes se normalizan aunque no sumen cien, para que la cantidad final siempre cierre.",units,["CARNE","POLLO","JAMÓN Y QUESO","VERDURA"],units.map(x=>x+" unidades"));art("EMPANADAS TOTALES",total+" unidades",dozens+" docenas · "+(role==="main"?"plato principal":role==="side"?"acompañamiento":"entrada"));return}
 if(mode==="dough"){let flour=n("#flour"),per=n("#doughType"),emp=per?Math.floor(flour/per):Math.floor(flour/45),dozens=Math.ceil(emp/12),fill=emp*.07,grease=per===50?flour*.18:per===45?flour*.15:0,water=per===50?flour*.35:per===45?flour*.42:0,salt=per?flour*.02:0;txt("result-label","RENDIMIENTO DE LA HARINA");txt("result",emp+" empanadas");txt("badge-label","Equivale a");txt("badge",dozens+" docenas");stats(["HARINA POR TAPA","RELLENO NECESARIO","PAQUETES DE 12"],[per?per+" g":"Tapas compradas",fmt(fill,2)+" kg",dozens+" paquetes"]);details("Tu masa, línea por línea",[["Harina disponible",flour+" g"],["Harina por tapa",per?per+" g":"No aplica"],["Grasa",Math.round(grease)+" g"],["Agua",Math.round(water)+" ml"],["Empanadas que salen",emp+" unidades"]]);compose("La receta completa","Qué agregar a la harina",per?"Proporciones estimadas para una masa pareja y fácil de estirar.":"Con tapas compradas, concentrá la cuenta en paquetes y relleno.",[flour,grease,water,salt],["HARINA","GRASA","AGUA","SAL"],[flour+" g",Math.round(grease)+" g",Math.round(water)+" ml",Math.round(salt)+" g"]);art("RENDIMIENTO",emp+" empanadas",fmt(fill,2)+" kg de relleno");return}
 if(mode==="sides"){let saladG=people*n("#saladRole"),saladKg=Math.ceil(saladG/250)/4,lettuces=Math.max(people?1:0,Math.ceil(saladKg*2)),tomatoes=Math.max(people?1:0,Math.ceil(saladKg*5)),onion=Math.round(saladKg*180),breadG=adults*n("#mealType")+kids*n("#mealType")*.6,breadKg=Math.ceil(breadG/250)/4,mignons=Math.ceil(breadG/70);txt("result-label","GUARNICIONES A PREPARAR");txt("result",fmt(saladKg,2)+" kg + "+fmt(breadKg,2)+" kg");txt("badge-label","Para servir");txt("badge",people+" personas");stats(["LECHUGAS","TOMATES","PAN"],[lettuces+" unidades",tomatoes+" unidades",fmt(breadKg,2)+" kg"]);details("Tus guarniciones, línea por línea",[["Comensales",people+" personas"],["Ensalada total",fmt(saladKg,2)+" kg"],["Lechuga y tomate",lettuces+" + "+tomatoes],["Cebolla",onion+" g"],["Pan",fmt(breadKg,2)+" kg"]]);compose("La fuente y la panera","Qué comprar para acompañar","Redondeamos a cuartos de kilo para que la compra sea práctica.",[saladKg*.4,saladKg*.45,onion/1000,breadKg],["LECHUGA","TOMATE","CEBOLLA","PAN"],[fmt(saladKg*.4,2)+" kg",fmt(saladKg*.45,2)+" kg",onion+" g",fmt(breadKg,2)+" kg"]);art("GUARNICIONES",fmt(saladKg,2)+" kg ensalada",mignons+" mignones · "+fmt(breadKg,2)+" kg de pan");return}
 let carbon=Math.ceil(people*n("#duration")*2)/2,wood=Math.ceil(people*n("#wood")*2)/2,pills=Math.max(people?2:0,Math.ceil(carbon/2.5)),minutes=n("#duration")<=.35?35:n("#duration")<=.5?45:60,area=people*n("#grillUse"),width=Math.ceil(Math.sqrt(area*1.6)),depth=Math.ceil(area/width);txt("result-label","COMBUSTIBLE PARA EL FUEGO");txt("result",fmt(carbon,1)+" kg de carbón");txt("badge-label","Brasa lista en");txt("badge","~"+minutes+" minutos");stats(["LEÑA","PASTILLAS","SUPERFICIE"],[wood?fmt(wood,1)+" kg":"Sin leña",pills+" unidades",area.toLocaleString("es-AR")+" cm²"]);details("Tu fuego, línea por línea",[["Comensales",people+" personas"],["Carbón",fmt(carbon,1)+" kg"],["Leña",fmt(wood,1)+" kg"],["Pastillas",pills+" unidades"],["Parrilla mínima",width+" × "+depth+" cm"]]);compose("Antes de prender","Cómo repartir el combustible","Separá una parte para encender y el resto para sostener el fuego.",[carbon*.4,carbon*.6,wood,pills*.15],["CARBÓN INICIAL","REPOSICIÓN","LEÑA","ENCENDIDO"],[fmt(carbon*.4,1)+" kg",fmt(carbon*.6,1)+" kg",fmt(wood,1)+" kg",pills+" pastillas"]);art("COMBUSTIBLE",fmt(carbon,1)+" kg carbón",wood?"+ "+fmt(wood,1)+" kg de leña":"sin leña")}
function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$$(".field.emp,.field.dough,.field.sides,.field.fire").forEach(x=>x.classList.toggle("hide",!x.classList.contains(m)));calc()}
$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Cantidades actualizadas";setTimeout(()=>e.currentTarget.textContent="Actualizar cantidades",1200)};setMode("emp");

})();
</script>
<style is:global>

