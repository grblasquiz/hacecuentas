.mockup-empanadas-guarniciones .hero{background:radial-gradient(circle at 16% 77%,#fff0d8 0,transparent 27%),linear-gradient(135deg,#fffaf5,#fff7ef);padding:27px 0 64px}.mockup-empanadas-guarniciones .crumb{font-size:11px;color:#748194;margin-bottom:34px}.mockup-empanadas-guarniciones .crumb b,.mockup-empanadas-guarniciones .eyebrow{color:#c45f3d}.mockup-empanadas-guarniciones .grid{display:grid;grid-template-columns:.87fr 1.13fr;gap:50px;align-items:start}.mockup-empanadas-guarniciones .copy{padding-top:6px}.mockup-empanadas-guarniciones .eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.15em;font-weight:900;display:flex;align-items:center;gap:9px}.mockup-empanadas-guarniciones .eyebrow:before{content:"";width:27px;border-top:2px solid}.mockup-empanadas-guarniciones .copy h1{font-size:51px;line-height:1.03;letter-spacing:-.055em;margin:17px 0}.mockup-empanadas-guarniciones .copy>p{font-size:16px;line-height:1.65;color:#5d6e81}.mockup-empanadas-guarniciones .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:21px}.mockup-empanadas-guarniciones .chips span{background:#fff;border:1px solid #e6ded7;border-radius:9px;padding:8px 10px;font-size:9px;color:#566678}
.mockup-empanadas-guarniciones .art{height:250px;position:relative;margin-top:21px}.mockup-empanadas-guarniciones .board{position:absolute;left:35px;top:30px;width:290px;height:180px;border-radius:95px;background:#c88954;box-shadow:0 22px 44px #5d351d24;transform:rotate(-3deg)}.mockup-empanadas-guarniciones .plate{position:absolute;left:48px;top:18px;width:176px;height:145px;background:#fff;border:12px solid #f1ede8;border-radius:50%}.mockup-empanadas-guarniciones .emp-shape{position:absolute;width:70px;height:41px;background:#efb849;border:3px solid #db9630;border-radius:70px 70px 10px 10px;transform:rotate(13deg)}.mockup-empanadas-guarniciones .e1{left:63px;top:46px}.mockup-empanadas-guarniciones .e2{left:113px;top:78px;transform:rotate(-9deg)}.mockup-empanadas-guarniciones .e3{left:62px;top:103px;transform:rotate(7deg)}.mockup-empanadas-guarniciones .fork{position:absolute;right:26px;top:31px;font-size:55px;transform:rotate(15deg)}.mockup-empanadas-guarniciones .note{position:absolute;right:0;bottom:0;background:#fff;border:1px solid #e7ddd4;border-radius:13px;padding:14px 17px;box-shadow:0 15px 31px #5d351d1d}.mockup-empanadas-guarniciones .note small{display:block;font-size:7px;color:#738295}.mockup-empanadas-guarniciones .note b{display:block;color:#c45f3d;font-size:20px;margin:4px 0}.mockup-empanadas-guarniciones .note span{font-size:8px;color:#647487}
