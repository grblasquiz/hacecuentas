<div class="mockup-mascotas-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Mascotas</div><div class="heroGrid"><div><span class="eyebrow">Entender su etapa también es cuidar</span><h1>Sus años cuentan distinto. Su cuidado también.</h1><p class="lead">Calculá edades, ubicá etapas de vida y encontrá herramientas para acompañar a perros, gatos y otras mascotas.</p><div class="trust"><span>✓ Edad exacta</span><span>✓ Tamaño considerado</span><span>✓ Referencias orientativas</span></div><div class="scene"><img src="/cat-img/mascotas.webp" alt="Ilustración de un perro y un gato juntos"></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Qué edad tiene en años humanos?</h2><p>La equivalencia cambia según especie y tamaño.</p></div><span class="live">EDAD EN VIVO</span></div><div class="species"><button class="speciesBtn active" data-species="dog">🐶 Perro</button><button class="speciesBtn" data-species="cat">🐱 Gato</button></div><div class="fields"><div class="field"><label>Fecha de nacimiento</label><div class="input"><input id="birth" type="date"></div></div><div class="field"><label>Fecha de cálculo</label><div class="input"><input id="today" type="date"></div></div><div class="field" id="sizeField"><label>Tamaño adulto</label><select id="size"><option value="small">Pequeño · hasta 10 kg</option><option value="medium" selected>Mediano · 10 a 25 kg</option><option value="large">Grande · más de 25 kg</option></select></div><div class="field"><label>Nombre, si querés</label><div class="input"><input id="petName" value="Milo" placeholder="Tu mascota"></div></div></div><button class="primary" id="calculate">Actualizar edad</button><div class="result"><div class="resultTop"><div><small>EDAD EQUIVALENTE APROXIMADA</small><div class="amount" id="humanAge">32 años humanos</div></div><span class="badge" id="stage">Adulto</span></div><div class="resultGrid"><div class="metric"><span>EDAD REAL</span><b id="realAge">4 años, 0 meses</b></div><div class="metric"><span>PRÓXIMO CUMPLE</span><b id="birthday">en 365 días</b></div><div class="metric"><span>ETAPA</span><b id="stageOut">Adulto</b></div></div><div class="life"><i id="lifeBar"></i></div><p class="note" id="note">En perros medianos, la equivalencia se acelera después de los primeros dos años.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por quien cuidás</span><h2>Una herramienta para cada compañero.</h2><p>Elegí el tipo de consulta y encontrá primero lo relevante.</p></div><div class="needs"><button class="need active" data-filter="dogs"><span class="icon">P</span><h3>Mi perro</h3><p>Edad, tamaño y etapa de vida.</p><em>→</em></button><button class="need" data-filter="cats"><span class="icon">G</span><h3>Mi gato</h3><p>Edad felina y ciclo vital.</p><em>→</em></button><button class="need" data-filter="gestation"><span class="icon">♥</span><h3>Gestación</h3><p>Fechas y etapas orientativas.</p><em>→</em></button><button class="need" data-filter="aquarium"><span class="icon">≈</span><h3>Mi acuario</h3><p>Volumen, agua y población.</p><em>→</em></button><button class="need" data-filter="care"><span class="icon">✓</span><h3>Organizar cuidados</h3><p>Rutinas y calendario básico.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas para mascotas</span><h2>Más claridad para cuidar mejor.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="dogs">Perros</button><button class="filter" data-filter="cats">Gatos</button><button class="filter" data-filter="gestation">Gestación</button><button class="filter" data-filter="aquarium">Acuario</button><button class="filter" data-filter="care">Cuidados</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="dogs care" data-text="edad perro años humanos tamaño etapa vida"><span class="tag">Perros</span><h3>Edad del perro</h3><p>Una equivalencia que contempla la edad real y el tamaño adulto.</p><button>Calcular edad →</button></article><article class="card" data-cat="cats care" data-text="edad gato años humanos felino etapa"><span class="tag">Gatos</span><h3>Edad del gato</h3><p>Convertí su edad y ubicá la etapa de vida.</p><button>Calcular edad →</button></article><article class="card" data-cat="gestation dogs cats" data-text="gestacion mascotas fecha probable parto semanas"><span class="tag">Gestación</span><h3>Gestación de mascotas</h3><p>Fechas y evolución orientativa para perros y gatos.</p><button>Calcular fechas →</button></article><article class="card" data-cat="aquarium care" data-text="acuario volumen litros peces agua mantenimiento"><span class="tag">Acuario</span><h3>Calculadora de acuario</h3><p>Volumen real, población y cambios de agua.</p><button>Calcular acuario →</button></article><article class="card" data-cat="care dogs cats" data-text="cuidados alimento vacunas turnos calendario mascota"><span class="tag">Organización</span><h3>Calendario de cuidados</h3><p>Ordená controles, vacunas y rutinas periódicas.</p><button>Organizar →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="care"><div class="wrap careGrid"><div><span class="eyebrow" style="color:#ffc08d">Una cuenta no reemplaza observar</span><h2>La etapa orienta. Cada animal es único.</h2><p>La raza, el tamaño, la historia clínica y el estilo de vida modifican el envejecimiento. Usá estas referencias como punto de partida.</p><div class="disclaimer">Información orientativa. Para alimentación, síntomas, gestación o decisiones de salud, consultá siempre con un profesional veterinario.</div></div><div class="checks"><button class="check active" data-check="Etapa"><span><b>1. Identificá su etapa</b><small>Cachorro, adulto o senior.</small></span><b>→</b></button><button class="check" data-check="Rutina"><span><b>2. Ajustá la rutina</b><small>Actividad, alimentación y descanso.</small></span><b>→</b></button><button class="check" data-check="Controles"><span><b>3. Ordená sus controles</b><small>La frecuencia cambia con la edad.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-mascotas-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-mascotas-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let species="dog",day=864e5;const iso=d=>new Date(d-d.getTimezoneOffset()*60000).toISOString().slice(0,10);let now=new Date();now.setHours(12,0,0,0);$("#today").value=iso(now);let born=new Date(now);born.setFullYear(born.getFullYear()-4);$("#birth").value=iso(born);
function calc(){const birth=new Date($("#birth").value+"T12:00:00"),today=new Date($("#today").value+"T12:00:00");if(isNaN(birth)||isNaN(today))return;let months=Math.max(0,Math.floor((today-birth)/(day*30.4375))),years=Math.floor(months/12),rem=months%12,decimal=months/12,human;if(species==="cat")human=decimal<=1?decimal*15:decimal<=2?15+(decimal-1)*9:24+(decimal-2)*4;else{const rate={small:4,medium:5,large:6}[$("#size").value];human=decimal<=1?decimal*15:decimal<=2?15+(decimal-1)*9:24+(decimal-2)*rate}human=Math.round(human);let stage=decimal<1?"Cachorro":decimal<(species==="cat"?7:$("#size").value==="large"?6:8)?"Adulto":"Senior";let next=new Date(today.getFullYear(),birth.getMonth(),birth.getDate(),12);if(next<today)next.setFullYear(next.getFullYear()+1);const days=Math.ceil((next-today)/day),name=$("#petName").value.trim()||"Tu mascota";$("#humanAge").textContent=human+" años humanos";$("#realAge").textContent=`${years} años, ${rem} meses`;$("#birthday").textContent=days===0?"hoy":`en ${days} días`;$("#stage").textContent=stage;$("#stageOut").textContent=stage;$("#lifeBar").style.width=Math.min(100,decimal/(species==="cat"?18:15)*100)+"%";$("#note").textContent=species==="cat"?`${name} tiene una equivalencia felina estimada; los primeros dos años concentran el mayor salto.`:`En perros ${$("#size").value==="small"?"pequeños":$("#size").value==="large"?"grandes":"medianos"}, la equivalencia se acelera después de los primeros dos años.`}
$$(".calc input,.calc select").forEach(x=>x.oninput=calc);$$(".speciesBtn").forEach(b=>b.onclick=()=>{species=b.dataset.species;$$(".speciesBtn").forEach(x=>x.classList.toggle("active",x===b));$("#sizeField").style.display=species==="dog"?"":"none";calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Edad actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".check").forEach(b=>b.onclick=()=>{$$(".check").forEach(x=>x.classList.toggle("active",x===b));toast("Paso seleccionado: "+b.dataset.check)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
