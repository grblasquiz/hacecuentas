---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-liquidacion-dominicana" set:html={`<section class="hero"><div class="wrap crumb"><b>República Dominicana</b> &nbsp;/&nbsp; Trabajo &nbsp;/&nbsp; Liquidación</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Código de Trabajo · Ley 16-92</span><h1>Terminó tu contrato.<br>Veamos qué deben<br>pagarte.</h1><p>Calcula cesantía, preaviso, vacaciones, regalía y salarios pendientes. El motivo de salida define qué conceptos te corresponden.</p><div class="chips"><span>✓ Arts. 76 y 80</span><span>◷ Plazo de 10 días</span><span>+ Penalidad Art. 86</span></div><div class="art"><div class="doc"><small>LIQUIDACIÓN ESTIMADA</small><strong id="art-total">RD$ 288.038</strong><div class="doc-line"></div><div class="doc-line"></div><div class="doc-line"></div></div><div class="stamp">DERECHOS<br>LABORALES</div><span class="deadline">Pago máximo: 10 días</span></div></div>
<form class="calc" onsubmit="return false"><div class="calc-title"><div><h2>Calcula tu liquidación</h2><p>Empieza por cómo terminó el contrato.</p></div><span class="tag">Resultado instantáneo</span></div><div class="section-label">Motivo de salida</div><div class="cases"><button type="button" class="case active" data-case="dismissal"><i>✓</i>Despido injustificado</button><button type="button" class="case" data-case="desahucio"><i>↗</i>Desahucio del empleador</button><button type="button" class="case" data-case="dimision"><i>⚖</i>Dimisión justificada</button><button type="button" class="case" data-case="resignation"><i>→</i>Renuncia sin causa</button></div><div class="section-label">Tus datos laborales</div><div class="fields"><div class="field wide"><label>Salario ordinario mensual</label><input id="salary" inputmode="numeric" value="45.000"></div><div class="field"><label>Años completos</label><input id="years" type="number" min="0" max="50" value="3"></div><div class="field"><label>Meses adicionales</label><input id="months-extra" type="number" min="0" max="11" value="4"></div><div class="field"><label>Meses trabajados este año</label><input id="christmas-months" type="number" min="0" max="12" value="7"></div><div class="field"><label>Salarios o comisiones pendientes</label><input id="pending" inputmode="numeric" value="0"></div><div class="field wide"><label>Días transcurridos desde la salida</label><input id="days-out" type="number" min="0" max="720" value="0"></div></div><section class="result"><div class="result-top"><div><small>Total estimado a cobrar</small><div class="value" id="total">RD$ 288.038</div></div><div class="verdict"><small>Te corresponde</small><strong id="verdict">Liquidación completa</strong></div></div><div class="stats"><span>Cesantía<b id="stat-ces">RD$ 118.968</b></span><span>Preaviso<b id="stat-pre">RD$ 52.874</b></span><span>Plazo de pago<b id="stat-days">10 días</b></span></div><button class="go" id="update" type="button">Actualizar liquidación</button></section></form>
</div></section>
<section class="breakdown"><div class="wrap"><header class="center"><span>Tu liquidación, concepto por concepto</span><h2>Entiende cómo se forma el total</h2><p>Cada rubro tiene una regla distinta. Separarlos permite comparar el cálculo con el descargo que te entreguen.</p></header><div class="break-grid"><article class="card"><h3>Desglose estimado</h3><div class="line"><span>Auxilio de cesantía</span><b id="d-ces">RD$ 118.968</b></div><div class="line"><span>Preaviso en dinero</span><b id="d-pre">RD$ 52.874</b></div><div class="line"><span>Vacaciones no disfrutadas</span><b id="d-vac">RD$ 26.437</b></div><div class="line"><span>Regalía pascual proporcional</span><b id="d-reg">RD$ 26.250</b></div><div class="line"><span>Salario y comisiones pendientes</span><b id="d-pending">RD$ 0</b></div><div class="line"><span>Penalidad por retraso · Art. 86</span><b id="d-penalty">RD$ 0</b></div><div class="line total"><strong>Total a cobrar</strong><b id="d-total">RD$ 224.529</b></div></article><article class="card"><h3>De qué está hecho</h3><div class="donut-wrap"><div class="donut" id="donut"><span class="donut-center"><span>EQUIVALE A<b id="salary-count">5,0 sueldos</b></span></span></div><div class="legend"><div><i style="background:#247fc1"></i>Cesantía</div><div><i style="background:#26a584"></i>Preaviso</div><div><i style="background:#f0ae55"></i>Vacaciones</div><div><i style="background:#c57ccf"></i>Regalía y otros</div></div></div></article></div></div></section>
<section class="cases-info"><div class="wrap"><header class="center"><span>Los cuatro escenarios, siempre visibles</span><h2>El motivo cambia la liquidación</h2></header><div class="case-grid"><article class="info active" data-info="dismissal"><i>✓</i><h3>Despido injustificado</h3><p>El empleador termina el contrato sin una causa probada.</p><strong>Cesantía + preaviso</strong><span>También vacaciones y regalía</span></article><article class="info" data-info="desahucio"><i>↗</i><h3>Desahucio</h3><p>El empleador termina el contrato sin invocar causa.</p><strong>Cesantía + preaviso</strong><span>Mismo efecto económico</span></article><article class="info" data-info="dimision"><i>⚖</i><h3>Dimisión justificada</h3><p>Renuncias por incumplimiento grave del empleador.</p><strong>Cesantía + preaviso</strong><span>Debes probar y comunicar la causa</span></article><article class="info" data-info="resignation"><i>→</i><h3>Renuncia sin causa</h3><p>Decides retirarte sin falta atribuible al empleador.</p><strong>Sin cesantía ni preaviso</strong><span>Conservas vacaciones y regalía</span></article></div></div></section>
<section class="deadline-section"><div class="wrap deadline-grid"><div><span class="eyebrow">El reloj del Artículo 86</span><h2>Después del día 10, la deuda crece a diario.</h2><p>Por cada día de retraso el empleador debe sumar un día de salario ordinario. La penalidad no reemplaza las prestaciones: se agrega al total.</p></div><div class="days-box"><div class="days-head"><div><small>DÍAS DESDE LA SALIDA</small><b id="days-value">0 días</b></div><div style="text-align:right"><small>PENALIDAD ACUMULADA</small><b id="penalty-value">RD$ 0</b></div></div><div class="days-track"><i id="days-progress"></i></div><div class="days-labels"><span>Salida</span><span>Día 10 · vence</span><span>Día 30</span></div><div class="warning">⚠️ Las acciones por despido o dimisión prescriben a los dos meses. No esperes a que termine una negociación informal para asesorarte.</div></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">Antes de firmar el descargo</span><h2>Tres cosas que debes verificar.</h2><p>Una firma apresurada puede complicar el reclamo. Compara el documento con el cálculo y exige constancia del pago.</p></div><div class="rules"><div><small>SALARIO</small><b>Divisor 23,83</b><span>No uses 30 para calcular el día laboral.</span></div><div><small>ANTIGÜEDAD</small><b>Historia de la TSS</b><span>Confirma fecha de ingreso y salario cotizado.</span></div><div><small>PAGO</small><b>Dinero acreditado</b><span>Firma cuando el monto esté disponible.</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-liquidacion-dominicana')?document.currentScript.previousElementSibling:document.querySelector('.mockup-liquidacion-dominicana');

const $=s=>root.querySelector(s),fmt=n=>"RD$ "+new Intl.NumberFormat("es-DO",{maximumFractionDigits:0}).format(Math.round(n)),num=v=>Number(String(v).replace(/\./g,""))||0;let mode="dismissal";function daysCes(m){if(m<=3)return 0;if(m<=6)return 6;if(m<=12)return 13;const y=Math.floor(m/12);return y*(m<=60?21:23)}function daysPre(m){return m<=3?0:m<=6?7:m<=12?14:28}function calc(){const salary=num($("#salary").value),years=Math.max(0,Math.floor(Number($("#years").value)||0)),extra=Math.max(0,Math.min(11,Math.floor(Number($("#months-extra").value)||0))),regMonths=Math.max(0,Math.min(12,Number($("#christmas-months").value)||0)),pending=num($("#pending").value),days=Math.max(0,Math.floor(Number($("#days-out").value)||0)),months=years*12+extra,daily=salary/23.83,full=mode!=="resignation",ces=full?daysCes(months)*daily:0,pre=full?daysPre(months)*daily:0,vacDays=months>=60?18:months>=12?14:months>=5?months+1:0,vac=vacDays*daily,reg=salary*regMonths/12,penalty=Math.max(0,days-10)*daily,total=ces+pre+vac+reg+pending+penalty,count=salary?total/salary:0;$("#total").textContent=fmt(total);$("#art-total").textContent=fmt(total);$("#verdict").textContent=full?"Liquidación completa":"Vacaciones y regalía";$("#stat-ces").textContent=fmt(ces);$("#stat-pre").textContent=fmt(pre);$("#stat-days").textContent=days>10?`${days-10} días de mora`:"10 días";$("#d-ces").textContent=fmt(ces);$("#d-pre").textContent=fmt(pre);$("#d-vac").textContent=fmt(vac);$("#d-reg").textContent=fmt(reg);$("#d-pending").textContent=fmt(pending);$("#d-penalty").textContent=fmt(penalty);$("#d-total").textContent=fmt(total);$("#salary-count").textContent=`${count.toFixed(1).replace(".",",")} sueldos`;$("#days-value").textContent=`${days} días`;$("#penalty-value").textContent=fmt(penalty);$("#days-progress").style.width=Math.min(100,days/30*100)+"%";const parts=[ces,pre,vac,Math.max(0,total-ces-pre-vac)],sum=Math.max(1,total),p1=parts[0]/sum*100,p2=p1+parts[1]/sum*100,p3=p2+parts[2]/sum*100;$("#donut").style.background=`conic-gradient(#247fc1 0 ${p1}%,#26a584 ${p1}% ${p2}%,#f0ae55 ${p2}% ${p3}%,#c57ccf ${p3}% 100%)`;root.querySelectorAll("[data-info]").forEach(x=>x.classList.toggle("active",x.dataset.info===mode))}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(x=>x.classList.remove("active"));b.classList.add("active");mode=b.dataset.case;calc()}));root.querySelectorAll("input").forEach(x=>x.addEventListener("input",calc));$("#update").addEventListener("click",e=>{calc();e.currentTarget.textContent="✓ Liquidación actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar liquidación",1200)});calc();

})();
</script>
