<div class="mockup-dados-inss-irrf" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><span>Brasil</span> / Dados / INSS e IRRF 2026</div><div class="heroGrid"><div><div class="eyebrow">Tabelas oficiais 2026</div><h1>INSS e IRRF sem precisar decifrar a tabela.</h1><p class="lead">Consulte as faixas atualizadas e veja como cada desconto afeta o seu salário, passo a passo.</p><div class="pills"><span class="pill">✓ Cálculo progressivo</span><span class="pill">✓ Redução do IR 2026</span><span class="pill">✓ Fontes oficiais</span></div></div><aside class="heroCard"><small>Novidade no IRRF 2026</small><strong>Isenção até R$ 5.000</strong><p>A redução mensal zera o imposto para rendimentos tributáveis de até R$ 5 mil e diminui gradualmente até R$ 7.350.</p><span class="updated">Atualizado em julho de 2026</span></aside></div></div></section>
<section class="calculator"><div class="wrap"><div class="shell"><div class="head"><h2>Simule os descontos no seu salário</h2><span>Resultado instantâneo · valores mensais</span></div><div class="body"><div class="form"><div class="field"><label>Salário bruto mensal</label><div class="inputWrap"><span class="currency">R$</span><input id="salary" type="number" value="6000"><span class="unit">/ mês</span></div></div><div class="grid2"><div class="field"><label>Dependentes</label><div class="inputWrap"><input id="dependents" type="number" value="0" min="0"><span class="unit">pessoas</span></div></div><div class="field"><label>Outras deduções legais</label><div class="inputWrap"><span class="currency">R$</span><input id="deductions" type="number" value="0"></div></div></div><label class="switchRow"><input id="simplified" type="checkbox"><span><b>Usar desconto simplificado mensal</b>Compara o limite de R$ 607,20 com as deduções legais e usa a opção mais vantajosa.</span></label><label class="switchRow"><input id="otherDiscounts" type="checkbox"><span><b>Incluir outros descontos no líquido</b>Simula R$ 120 de benefícios ou descontos internos, sem alterar a base tributária.</span></label><button class="calculate" id="calculate">Atualizar resultado</button></div><aside class="result"><div class="resultTop"><h3>Seu salário estimado</h3><span class="live">● AO VIVO</span></div><div class="net"><small>Salário líquido após INSS e IRRF</small><div class="netValue" id="net">R$ 0,00</div><p id="verdict">Calculando a melhor dedução para você.</p></div><div class="breakdown"><div class="row"><span>Salário bruto</span><strong id="gross">R$ 0,00</strong></div><div class="row"><span>INSS progressivo</span><strong id="inss">− R$ 0,00</strong></div><div class="row"><span>Base de cálculo do IRRF</span><strong id="base">R$ 0,00</strong></div><div class="row"><span>IRRF antes da redução</span><strong id="irBefore">R$ 0,00</strong></div><div class="row"><span>Redução especial 2026</span><strong id="reduction">− R$ 0,00</strong></div><div class="row total"><span>IRRF final</span><strong id="irrf">− R$ 0,00</strong></div></div><div class="effective"><div class="metric"><strong id="rate">0%</strong><span>Desconto efetivo total</span></div><div class="metric"><strong id="annual">R$ 0</strong><span>Líquido em 12 meses</span></div></div><p class="note">Estimativa educacional para empregado, doméstico ou trabalhador avulso. Benefícios, pensão, múltiplos vínculos e regras da folha podem alterar o valor.</p></aside></div></div></div></section>
<section class="tables"><div class="wrap"><div class="center"><div class="eyebrow">Consulte as faixas</div><h2>Tabelas oficiais de 2026</h2><p>As alíquotas são aplicadas por faixa, não sobre o salário inteiro.</p></div><div class="tableGrid"><article class="tableCard"><div class="tableHead"><h3>Contribuição ao INSS</h3><span class="tag">Empregado</span></div><div class="tr head"><span>Salário de contribuição</span><strong>Alíquota</strong><strong>Parcela máx.</strong></div><div class="tr"><span>Até R$ 1.621,00</span><strong>7,5%</strong><strong>R$ 121,58</strong></div><div class="tr"><span>R$ 1.621,01 a R$ 2.902,84</span><strong>9%</strong><strong>R$ 115,37</strong></div><div class="tr"><span>R$ 2.902,85 a R$ 4.354,27</span><strong>12%</strong><strong>R$ 174,17</strong></div><div class="tr"><span>R$ 4.354,28 a R$ 8.475,55</span><strong>14%</strong><strong>R$ 576,98</strong></div><div class="reduction">Teto de contribuição: o salário acima de R$ 8.475,55 não aumenta o desconto previdenciário.</div></article><article class="tableCard"><div class="tableHead"><h3>Incidência mensal do IRRF</h3><span class="tag">Pessoa física</span></div><div class="tr head"><span>Base de cálculo</span><strong>Alíquota</strong><strong>Dedução</strong></div><div class="tr"><span>Até R$ 2.428,80</span><strong>0%</strong><strong>R$ 0</strong></div><div class="tr"><span>R$ 2.428,81 a R$ 2.826,65</span><strong>7,5%</strong><strong>R$ 182,16</strong></div><div class="tr"><span>R$ 2.826,66 a R$ 3.751,05</span><strong>15%</strong><strong>R$ 394,16</strong></div><div class="tr"><span>R$ 3.751,06 a R$ 4.664,68</span><strong>22,5%</strong><strong>R$ 675,49</strong></div><div class="tr"><span>Acima de R$ 4.664,68</span><strong>27,5%</strong><strong>R$ 908,73</strong></div><div class="reduction">Depois da tabela, aplica-se a redução de 2026 para rendimentos de até R$ 7.350.</div></article></div></div></section>
<section class="explain"><div class="wrap"><div class="center"><div class="eyebrow">Entenda o cálculo</div><h2>Quatro passos, na ordem certa</h2></div><div class="cards"><article class="card"><div class="icon">1</div><h3>Calcule o INSS</h3><p>Cada pedaço do salário entra em uma faixa progressiva até o teto.</p></article><article class="card"><div class="icon">2</div><h3>Defina a dedução</h3><p>Compare INSS, dependentes e outras deduções com o simplificado mensal.</p></article><article class="card"><div class="icon">3</div><h3>Aplique a tabela</h3><p>Use a alíquota e a parcela a deduzir sobre a base já reduzida.</p></article><article class="card"><div class="icon">4</div><h3>Reduza o IR de 2026</h3><p>Zere até R$ 5 mil ou aplique a redução decrescente até R$ 7.350.</p></article></div></div></section>
<section class="faq"><div class="wrap"><div class="center"><div class="eyebrow">Perguntas frequentes</div><h2>Sem dúvida na folha</h2></div><div class="faqWrap"><div class="faqItem open"><button class="faqQ">A alíquota do INSS vale sobre o salário inteiro?<span>−</span></button><div class="faqA">Não. O cálculo é progressivo: cada parcela do salário paga a alíquota da respectiva faixa, até o teto previdenciário.</div></div><div class="faqItem"><button class="faqQ">Quem ganha R$ 5 mil não paga IRRF em 2026?<span>+</span></button><div class="faqA">A redução mensal limita o imposto a zero para rendimentos tributáveis de até R$ 5.000. Entre R$ 5.000,01 e R$ 7.350, a redução diminui gradualmente.</div></div><div class="faqItem"><button class="faqQ">O desconto simplificado sempre é melhor?<span>+</span></button><div class="faqA">Não. Ele substitui as deduções legais. A melhor opção depende do INSS, do número de dependentes e das demais deduções permitidas.</div></div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="search" hidden aria-hidden="true"></button><button type="button" id="contrast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-dados-inss-irrf')?document.currentScript.previousElementSibling:document.querySelector('.mockup-dados-inss-irrf');if(!root)return;

const $=id=>root.querySelector("#"+id),brl=n=>n.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}),val=id=>Math.max(0,Number($(id).value)||0);
function calcInss(s){const bands=[[1621,.075],[2902.84,.09],[4354.27,.12],[8475.55,.14]];let total=0,prev=0;for(const [cap,rate] of bands){const slice=Math.max(0,Math.min(s,cap)-prev);total+=slice*rate;prev=cap;if(s<=cap)break}return total}
function calcIR(base){if(base<=2428.8)return 0;if(base<=2826.65)return base*.075-182.16;if(base<=3751.05)return base*.15-394.16;if(base<=4664.68)return base*.225-675.49;return base*.275-908.73}
function calculate(show=false){const salary=val('salary'),ins=calcInss(salary),legal=ins+val('dependents')*189.59+val('deductions'),used=$('simplified').checked?Math.max(607.2,legal):legal,base=Math.max(0,salary-used),before=Math.max(0,calcIR(base));let red=0;if(salary<=5000)red=before;else if(salary<=7350)red=Math.min(before,Math.max(0,978.62-.133145*salary));const ir=Math.max(0,before-red),other=$('otherDiscounts').checked?120:0,net=salary-ins-ir-other;$('net').textContent=brl(net);$('gross').textContent=brl(salary);$('inss').textContent='− '+brl(ins);$('base').textContent=brl(base);$('irBefore').textContent=brl(before);$('reduction').textContent='− '+brl(red);$('irrf').textContent='− '+brl(ir);$('rate').textContent=(salary?((salary-net)/salary*100):0).toLocaleString('pt-BR',{maximumFractionDigits:1})+'%';$('annual').textContent=brl(net*12);$('verdict').textContent=ir===0?'Com a redução de 2026, não há IRRF neste cenário.':red>0?'A redução especial de 2026 diminuiu o seu IRRF.':'Seu rendimento está acima da faixa de redução especial.';if(show){$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1500)}}
root.querySelectorAll('input').forEach(x=>x.addEventListener('input',()=>calculate()));$('calculate').onclick=()=>calculate(true);root.querySelectorAll('.faqQ').forEach(q=>q.onclick=()=>{q.parentElement.classList.toggle('open');q.lastElementChild.textContent=q.parentElement.classList.contains('open')?'−':'+'});$('search').onclick=()=>{const q=prompt('O que você quer calcular?');if(q){$('toast').textContent='Buscando “'+q+'”…';$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1400)}};$('contrast').onclick=()=>{document.body.style.filter=document.body.style.filter?'':'contrast(1.05)';$('toast').textContent='Contraste ajustado';$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1400)};calculate();

})();
</script>
<style is:global>

