ox-shadow:0 9px 20px rgba(40,104,238,.22)}.mockup-dados-inss-irrf .resultTop{display:flex;justify-content:space-between;align-items:center}.mockup-dados-inss-irrf .resultTop h3{font-size:18px;margin:0}.mockup-dados-inss-irrf .live{font-size:10px;color:var(--green);background:var(--green2);border-radius:99px;padding:6px 9px;font-weight:850}.mockup-dados-inss-irrf .net{background:linear-gradient(145deg,#152440,#233d64);color:#fff;border-radius:18px;padding:21px;margin-top:16px}.mockup-dados-inss-irrf .net small{font-size:11px;color:#bdcadc}.mockup-dados-inss-irrf .netValue{font-size:37px;font-weight:900;letter-spacing:-.05em;margin:7px 0}.mockup-dados-inss-irrf .net p{font-size:12px;color:#d5deeb;margin:0}.mockup-dados-inss-irrf .breakdown{margin-top:16px}.mockup-dados-inss-irrf .row{display:flex;justify-content:space-between;padding:11px 2px;border-bottom:1px solid #e0e5ed;font-size:13px;color:#657187}.mockup-dados-inss-irrf .row strong{color:var(--ink)}.mockup-dados-inss-irrf .row.total{font-weight:850;border:0;font-size:14px}.mockup-dados-inss-irrf .effective{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:13px}.mockup-dados-inss-irrf .metric{background:#fff;border:1px solid #dde3ec;border-radius:12px;padding:13px}.mockup-dados-inss-irrf .metric strong{display:block;font-size:17px}.mockup-dados-inss-irrf .metric span{font-size:10px;color:#7b8799}.mockup-dados-inss-irrf .note{font-size:11px;color:#7a8698;line-height:1.5;margin-top:14px}
