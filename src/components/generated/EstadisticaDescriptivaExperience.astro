---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-estadistica-descriptiva" set:html={`<div class="crumb">Matemática / Estadística descriptiva</div><h1>Convertí una fila de números en una historia visible.</h1><p class="lead">Pegá datos separados por coma. La distribución, el centro y los valores atípicos aparecen juntos.</p><section class="dataset"><label>Tu muestra<textarea id="data" rows="2">12, 14, 14, 15, 17, 18, 18, 19, 22, 24, 25, 25, 27, 31, 48</textarea></label><button id="analyze">Analizar datos</button></section><section class="dashboard"><div class="chart"><h2>Forma de la distribución</h2><div class="hist" id="hist"></div><div class="boxplot"><i class="whisker"></i><i class="box" id="box"></i><i class="median" id="medline"></i></div></div><aside class="summary"><h2>Radiografía</h2><div class="stats" id="stats"></div><div class="outliers" id="outliers"></div><div class="insight" id="insight"></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-estadistica-descriptiva')?document.currentScript.previousElementSibling:document.querySelector('.mockup-estadistica-descriptiva');

const $=x=>root.querySelector("#"+x),quant=(a,q)=>{let p=(a.length-1)*q,b=Math.floor(p),r=p-b;return a[b+1]!==undefined?a[b]+r*(a[b+1]-a[b]):a[b]};
function render(){let a=$('data').value.split(/[,;\s]+/).map(Number).filter(Number.isFinite).sort((x,y)=>x-y);if(!a.length)return;let n=a.length,mean=a.reduce((s,x)=>s+x,0)/n,med=quant(a,.5),q1=quant(a,.25),q3=quant(a,.75),sd=Math.sqrt(a.reduce((s,x)=>s+(x-mean)**2,0)/n),iqr=q3-q1,out=a.filter(x=>x<q1-1.5*iqr||x>q3+1.5*iqr),min=a[0],max=a[n-1],bins=Math.min(8,Math.max(4,Math.ceil(Math.sqrt(n)))),counts=Array(bins).fill(0);a.forEach(x=>counts[Math.min(bins-1,Math.floor((x-min)/(max-min||1)*bins))]++);let peak=Math.max(...counts);$('hist').innerHTML=counts.map((c,i)=>`<div class="bar" style="height:${c/peak*100}%"><span>${c}</span></div>`).join('');$('box').style.left=(q1-min)/(max-min||1)*84+8+'%';$('box').style.width=(q3-q1)/(max-min||1)*84+'%';$('medline').style.left=(med-min)/(max-min||1)*84+8+'%';$('stats').innerHTML=[['Media',mean],['Mediana',med],['Desvío',sd],['Rango',max-min]].map(x=>`<div class="stat"><span>${x[0]}</span><b>${x[1].toFixed(2)}</b></div>`).join('');$('outliers').innerHTML=`Atípicos detectados: <b>${out.length?out.join(', '):'ninguno'}</b>`;$('insight').textContent=Math.abs(mean-med)>sd*.25?'Media y mediana se separan: la distribución parece sesgada.':'Media y mediana están cerca: el centro es bastante estable.'}
$('analyze').onclick=render;$('data').onkeydown=e=>{if((e.ctrlKey||e.metaKey)&&e.key==='Enter')render()};render();

})();
</script>
<style is:global>

.mockup-estadistica-descriptiva{--blue:#174b7a;--ink:#19292f;--muted:#63727a;--line:#d7e1df;--orange:#e77d45;--green:#48a47c;--paper:#f4f7f5}.mockup-estadistica-descriptiva *{box-sizing:border-box}.mockup-estadistica-descriptiva{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-estadistica-descriptiva button,.mockup-estadistica-descriptiva textarea{font:inherit}.mockup-estadistica-descriptiva .shell{max-width:1180px;margin:auto;padding:36px 22px}.mockup-estadistica-descriptiva .crumb{color:var(--blue);font-weight:800}.mockup-estadistica-descriptiva h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-estadistica-descriptiva .lead{font-size:18px;color:var(--muted)}.mockup-estadistica-descriptiva .dataset{margin:28px 0 16px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:18px;display:grid;grid-template-columns:1fr auto;gap:12px}.mockup-estadistica-descriptiva .dataset label{font-size:12px;font-weight:850}.mockup-estadistica-descriptiva .dataset textarea{display:block;width:100%;border:0;resize:none;font-weight:800;color:var(--ink);padding:8px 0}.mockup-estadistica-descriptiva .dataset button{border:0;background:var(--blue);color:#fff;border-radius:12px;padding:0 20px;font-weight:900}.mockup-estadistica-descriptiva .dashboard{display:grid;grid-template-columns:1.2fr .8fr;gap:20px}.mockup-estadistica-descriptiva .chart,.mockup-estadistica-descriptiva .summary{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-estadistica-descriptiva .chart h2,.mockup-estadistica-descriptiva .summary h2{margin:0;font-size:23px}.mockup-estadistica-descriptiva .hist{height:260px;display:flex;align-items:end;gap:8px;padding:28px 5px 0;border-bottom:2px solid #aab9b5}.mockup-estadistica-descriptiva .bar{flex:1;min-width:14px;background:var(--blue);border-radius:8px 8px 0 0;position:relative}.mockup-estadistica-descriptiva .bar span{position:absolute;top:-21px;width:100%;text-align:center;font-size:11px}.mockup-estadistica-descriptiva .boxplot{height:100px;position:relative;margin-top:20px}.mockup-estadistica-descriptiva .whisker{position:absolute;left:8%;right:8%;top:50%;border-top:3px solid var(--ink)}.mockup-estadistica-descriptiva .box{position:absolute;left:25%;width:50%;top:25px;height:50px;background:#dff1e9;border:3px solid var(--green)}.mockup-estadistica-descriptiva .median{position:absolute;left:50%;top:20px;height:60px;border-left:5px solid var(--orange)}.mockup-estadistica-descriptiva .stats{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:20px}.mockup-estadistica-descriptiva .stat{padding:14px;background:var(--paper);border-radius:14px}.mockup-estadistica-descriptiva .stat b{display:block;font-size:27px;color:var(--blue)}.mockup-estadistica-descriptiva .insight{margin-top:15px;padding:15px;border-left:5px solid var(--orange);background:#fff6df}.mockup-estadistica-descriptiva .outliers{margin-top:15px}.mockup-estadistica-descriptiva .outliers b{color:var(--orange)}@media(max-width:800px){.mockup-estadistica-descriptiva .dashboard{grid-template-columns:1fr}.mockup-estadistica-descriptiva .dataset{grid-template-columns:1fr}.mockup-estadistica-descriptiva .dataset button{padding:13px}}
.mockup-estadistica-descriptiva { width:100%; overflow:hidden; }
.mockup-estadistica-descriptiva .top, .mockup-estadistica-descriptiva header.top { display:none !important; }
.mockup-estadistica-descriptiva .foot { display:none !important; }
.mockup-estadistica-descriptiva .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-estadistica-descriptiva .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-estadistica-descriptiva .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-estadistica-descriptiva .support-real summary { cursor:pointer; font-weight:750; }
.mockup-estadistica-descriptiva .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-estadistica-descriptiva :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-estadistica-descriptiva input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-estadistica-descriptiva input[type="number"]::-webkit-inner-spin-button, .mockup-estadistica-descriptiva input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-estadistica-descriptiva .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-estadistica-descriptiva support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
