---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-licencia-conducir-mexico" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>México</b> / Auto / Costo de licencia por estado</div><div class="grid"><div><div class="eyebrow">Trámite y renovaciones</div><h1>Tu licencia cuesta más que el primer pago.</h1><p class="lead">Compará el costo por estado, sumá examen y extras, y proyectá cuánto vas a gastar si tenés que renovarla durante los próximos años.</p><div class="chips"><span>✓ Tarifas editables</span><span>✓ Temporal o permanente</span><span>✓ Comparador multiselección</span></div><article class="license-card"><div class="license-top"><b id="hero-state">Ciudad de México</b><span id="hero-type">Permanente</span></div><div class="license-main"><strong id="hero-total">$1,500</strong><small id="hero-year">$50 por año</small></div><div class="license-foot"><div><span>Costo del trámite</span><b id="hero-process">$1,500</b></div><div><span>Pagos proyectados</span><b id="hero-renewals">1 vez</b></div></div></article></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá el costo real</h2><p>Elegí una referencia y ajustá el importe.</p></div><span class="tag">Valores editables</span></div><div class="label">Estado y tipo de licencia</div><div class="fields"><div class="field wide"><label>Estado</label><select id="state"></select></div></div><div class="types"><button class="type active" data-type="permanente">Licencia permanente</button><button class="type" data-type="temporal">Licencia temporal</button></div><div class="label">Datos del trámite</div><div class="fields"><div class="field"><label>Costo de la licencia</label><div class="money"><b>$</b><input id="cost" value="1500"></div></div><div class="field" id="years-field"><label>Años de vigencia</label><input id="validity" value="3"></div><div class="field"><label>Examen médico</label><div class="money"><b>$</b><input id="medical" value="0"></div></div><div class="field"><label>Otros gastos</label><div class="money"><b>$</b><input id="extras" value="0"></div></div><div class="field wide"><label>¿Cuántos años pensás seguir manejando?</label><input id="driving" value="30"></div></div><p class="hint">Los costos cambian por ejercicio fiscal y municipio. Usá el valor de tu línea de captura si ya lo tenés.</p>
<section class="result"><div class="result-top"><div><small>COSTO PROYECTADO</small><div class="value" id="result">$1,500</div></div><div class="verdict"><small>Equivalente anual</small><b id="annual">$50 por año</b></div></div><div class="stats"><span>COSTO POR TRÁMITE<b id="process">$1,500</b></span><span>PAGOS EN EL PERÍODO<b id="renewals">1</b></span><span>VIGENCIA<b id="validity-label">Permanente</b></span></div><button class="go" id="update">Actualizar proyección</button></section></form></div></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Comparación de verdad</span><h2>Elegí varios estados y miralos juntos</h2><p>La tabla usa la misma vigencia temporal y horizonte de manejo para que la comparación sea consistente.</p></header><article class="compare-box"><div class="compare-head"><div><h3>Estados seleccionados</h3><p>Podés activar o quitar cualquiera.</p></div><span class="badge">Multiselección</span></div><div class="state-picks" id="picks"></div><div class="table-wrap"><table><thead><tr><th>Estado</th><th>Referencia editable</th><th>Tipo disponible</th><th>Costo en 30 años</th><th>Costo anual</th></tr></thead><tbody id="compare-body"></tbody></table></div></article></div></section>
<section class="section tint"><div class="wrap"><header class="center"><span>La cuenta completa</span><h2>Qué cambia el costo final</h2></header><div class="flow"><article><i>1</i><h3>Tarifa estatal</h3><p>Es el derecho principal y cambia según estado, tipo de licencia y ejercicio fiscal.</p></article><article><i>2</i><h3>Vigencia</h3><p>Una temporal vuelve a pagarse cada 2, 3, 4 o 5 años según la opción elegida.</p></article><article><i>3</i><h3>Requisitos extra</h3><p>Examen médico, toxicológico, fotografía o constancias pueden sumar costos.</p></article><article><i>4</i><h3>Horizonte de manejo</h3><p>La permanente se amortiza cuanto más tiempo la uses.</p></article></div></div></section>
<section class="section"><div class="wrap breakdown"><article class="card"><h3>Tu proyección, línea por línea</h3><div class="line"><span>Derecho de licencia</span><b id="d-cost">$1,500</b></div><div class="line"><span>Examen médico</span><b id="d-medical">$0</b></div><div class="line"><span>Otros gastos</span><b id="d-extras">$0</b></div><div class="line"><span>Costo de cada trámite</span><b id="d-process">$1,500</b></div><div class="line"><span>Cantidad de pagos</span><b id="d-renewals">1</b></div><div class="line total"><strong>Total proyectado</strong><b id="d-total">$1,500</b></div></article><article class="card"><h3>Antes de pagar</h3><div class="rule"><i>1</i><div><b>Confirmá el portal oficial</b><span>La tarifa puede actualizarse durante el año o variar por modalidad.</span></div></div><div class="rule"><i>2</i><div><b>Revisá requisitos</b><span>Primera expedición, renovación y licencia profesional no siempre piden lo mismo.</span></div></div><div class="rule"><i>3</i><div><b>No confundas vigencia con cita</b><span>El pago no garantiza disponibilidad inmediata de módulos o turnos.</span></div></div><div class="warning">Las tarifas del selector son referencias editables para el mockup, no una constancia oficial. Verificá monto y requisitos en la secretaría de movilidad de tu estado.</div></article></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-licencia-conducir-mexico')?document.currentScript.previousElementSibling:document.querySelector('.mockup-licencia-conducir-mexico');

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],mx=n=>"$"+Math.round(n).toLocaleString("es-MX"),num=id=>Math.max(0,Number($(id).value.replaceAll(",",""))||0),states={cdmx:{name:"Ciudad de México",cost:1500,permanent:true},edomex:{name:"Estado de México",cost:712,permanent:false},jalisco:{name:"Jalisco",cost:900,permanent:false},nuevoleon:{name:"Nuevo León",cost:870,permanent:false},puebla:{name:"Puebla",cost:950,permanent:false},queretaro:{name:"Querétaro",cost:1100,permanent:false}};let type="permanente",selected=new Set(["cdmx","edomex","jalisco"]);
$("#state").innerHTML=Object.entries(states).map(([k,s])=>`<option value="${k}">${s.name}</option>`).join("");$("#picks").innerHTML=Object.entries(states).map(([k,s])=>`<button type="button" class="pick ${selected.has(k)?"active":""}" data-state="${k}">${s.name}</button>`).join("");
function calc(){const state=states[$("#state").value],cost=num("#cost"),medical=num("#medical"),extras=num("#extras"),validity=Math.max(1,Math.round(num("#validity"))),driving=Math.max(1,Math.round(num("#driving"))),permanent=type==="permanente",process=cost+medical+extras,renewals=permanent?1:Math.ceil(driving/validity),total=process*renewals,annual=permanent?total/driving:process/validity;$("#result").textContent=mx(total);$("#annual").textContent=`${mx(annual)} por año`;$("#process").textContent=mx(process);$("#renewals").textContent=renewals;$("#validity-label").textContent=permanent?"Permanente":`${validity} años`;$("#hero-state").textContent=state.name;$("#hero-type").textContent=permanent?"Permanente":`Temporal · ${validity} años`;$("#hero-total").textContent=mx(total);$("#hero-year").textContent=`${mx(annual)} por año`;$("#hero-process").textContent=mx(process);$("#hero-renewals").textContent=renewals===1?"1 vez":`${renewals} veces`;$("#d-cost").textContent=mx(cost);$("#d-medical").textContent=mx(medical);$("#d-extras").textContent=mx(extras);$("#d-process").textContent=mx(process);$("#d-renewals").textContent=renewals;$("#d-total").textContent=mx(total);renderCompare()}
function renderCompare(){const validity=Math.max(1,Math.round(num("#validity"))),driving=Math.max(1,Math.round(num("#driving"))),rows=[...selected].map(k=>{const s=states[k],usePermanent=s.permanent,total=s.cost*(usePermanent?1:Math.ceil(driving/validity)),annual=usePermanent?total/driving:s.cost/validity;return{k,s,total,annual,usePermanent}}).sort((a,b)=>a.total-b.total),best=rows[0]?.k;$("#compare-body").innerHTML=rows.map(r=>`<tr class="${r.k===best?"best":""}"><td>${r.s.name} ${r.k===best?'<span class="best-tag">Menor proyección</span>':""}</td><td>${mx(r.s.cost)}</td><td>${r.usePermanent?"Permanente":`Temporal · ${validity} años`}</td><td>${mx(r.total)}</td><td>${mx(r.annual)}</td></tr>`).join("")||'<tr><td colspan="5">Elegí al menos un estado para comparar.</td></tr>'}
$("#state").oninput=e=>{const s=states[e.currentTarget.value];$("#cost").value=s.cost;type=s.permanent?"permanente":"temporal";$$(".type").forEach(b=>b.classList.toggle("active",b.dataset.type===type));calc()};$$(".type").forEach(b=>b.onclick=()=>{type=b.dataset.type;$$(".type").forEach(x=>x.classList.toggle("active",x===b));calc()});$$("input").forEach(i=>i.oninput=calc);$$(".pick").forEach(b=>b.onclick=()=>{selected.has(b.dataset.state)?selected.delete(b.dataset.state):selected.add(b.dataset.state);b.classList.toggle("active");renderCompare()});$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Proyección actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar proyección",1200)};calc();

})();
</script>
