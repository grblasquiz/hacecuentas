:right}.mockup-licencia-conducir-mexico tr.best{background:#edf8f4;color:#176b58;font-weight:850}.mockup-licencia-conducir-mexico .best-tag{background:#d9eee6;border-radius:99px;padding:4px 7px;font-size:8px}
