r(--muted)}.mockup-licencia-conducir-mexico .license-foot{display:grid;grid-template-columns:1fr 1fr;gap:8px}.mockup-licencia-conducir-mexico .license-foot div{background:#f3f7f7;border-radius:9px;padding:9px}.mockup-licencia-conducir-mexico .license-foot span{display:block;font-size:8px;color:var(--muted)}.mockup-licencia-conducir-mexico .license-foot b{font-size:11px}
.mockup-licencia-conducir-mexico .calc{background:#fff;border:1px solid #d9e4e2;border-radius:23px;padding:27px;box-shadow:0 24px 60px #193d3016}.mockup-licencia-conducir-mexico .calc-head{display:flex;justify-content:space-between}.mockup-licencia-conducir-mexico .calc h2{font-size:25px;letter-spacing:-.04em;margin:0}.mockup-licencia-conducir-mexico .calc-head p{font-size:12px;color:var(--muted);margin:5px 0}.mockup-licencia-conducir-mexico .tag{background:var(--sky);color:var(--blue);border-radius:99px;padding:7px 10px;height:max-content;font-size:10px;font-weight:850}.mockup-licencia-conducir-mexico .label{font-size:10px;font-weight:900;margin:19px 0 8px}.mockup-licencia-conducir-mexico .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-licencia-conducir-mexico .field{border:1px solid var(--line);border-radius:11px;padding:9px 11px}.mockup-licencia-conducir-mexico .field.wide{grid-column:1/-1}.mockup-licencia-conducir-mexico .field label{display:block;font-size:8px;color:#6e7e8e;margin-bottom:5px}.mockup-licencia-conducir-mexico .field input,.mockup-licencia-conducir-mexico .field select{width:100%;border:0;outline:0;background:transparent;color:var(--ink);font-weight:850}.mockup-licencia-conducir-mexico .money{display:flex;align-items:center;gap:6px}.mockup-licencia-conducir-mexico .money b{font-size:12px}.mockup-licencia-conducir-mexico .types{display:grid;grid-template-columns:1fr 1fr;gap:8px}.mockup-licencia-conducir-mexico .type{border:1px solid var(--line);background:#fff;border-radius:11px;padding:11px;color:#5c6e7f;font-size:9px;font-weight:850;cursor:pointer}.mockup-licencia-conducir-mexico .type.active{border:2px solid var(--blue);background:#eff8fb;color:#1f6d8c;padding:10px}.mockup-licencia-conducir-mexico .hint{font-size:9px;color:#778695;margin-top:7px}.mockup-licencia-conducir-mexico .result{background:var(--navy);color:#fff;border-radius:16px;padding:19px;margin-top:14px}.mockup-licencia-conducir-mexico .result-top{display:flex;jus