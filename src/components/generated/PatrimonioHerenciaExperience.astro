.mockup-patrimonio-herencia header{height:78px;border-bottom:1px solid #e1e4df;display:flex;align-items:center;background:rgba(247,247,242,.94)}.mockup-patrimonio-herencia .nav{display:flex;align-items:center;gap:29px}.mockup-patrimonio-herencia .brand{font-weight:850;font-size:18px;display:flex;align-items:center;gap:10px}.mockup-patrimonio-herencia .logo{width:31px;height:38px;border-radius:7px;background:linear-gradient(145deg,#13223e,#647b93);display:grid;place-items:center;color:white}.mockup-patrimonio-herencia .links{display:flex;gap:24px;color:#4d586e;font-size:14px;font-weight:650}.mockup-patrimonio-herencia .actions{margin-left:auto;display:flex;gap:8px}.mockup-patrimonio-herencia .navBtn{border:1px solid var(--line);background:white;padding:10px 13px;border-radius:11px;color:#586378}
.mockup-patrimonio-herencia .hero{padding:47px 0 38px}.mockup-patrimonio-herencia .crumb{font-size:14px;color:#727e93;margin-bottom:23px}.mockup-patrimonio-herencia .crumb span{color:var(--blue)}.mockup-patrimonio-herencia .heroGrid{display:grid;grid-template-columns:1.12fr .88fr;gap:45px;align-items:center}.mockup-patrimonio-herencia .eyebrow{font-size:12px;font-weight:850;letter-spacing:.11em;text-transform:uppercase;color:var(--blue)}.mockup-patrimonio-herencia h1{font-size:52px;line-height:1.03;letter-spacing:-.055em;margin:12px 0 17px}.mockup-patrimonio-herencia .lead{font-size:18px;line-height:1.55;color:#606c82;margin:0;max-width:680px}.mockup-patrimonio-herencia .trust{display:flex;gap:9px;flex-wrap:wrap;margin-top:22px}.mockup-patrimonio-herencia .pill{background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 12px;font-size:12px;font-weight:750}.mockup-patrimonio-herencia .heroCard{border-radius:24px;background:#15233e;color:white;padding:26px;position:relative;overflow:hidden;box-shadow:var(--shadow)}.mockup-patrimonio-herencia .heroCard:after{content:"";position:absolute;width:170px;height:170px;border-radius:50%;background:#2f74f4;opacity:.18;right:-70px;top:-75px}.mockup-patrimonio-herencia .uvtLabel{font-size:11px;color:#aebdd2;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.mockup-patrimonio-herencia .uvtValue{font-size:34px;font-weight:900;letter-spacing:-.04em;margin:7px 0}.mockup-patrimonio-herencia .heroCard p{color:#c8d3e2;font-size:13px;line-height:1.55;margin:0}.mockup-patrimonio-herencia .sourceTag{display:inline-flex;margin-top:17px;background:#263754;border-radius:99px;padding:7px 10px;font-size:11px;color:#dce7f5}
.mockup-patrimonio-herencia .calcSection{padding:13px 0 76px}.mockup-patrimonio-herencia .calcShell{background:#fff;border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow);overflow:hidden}.mockup-patrimonio-herencia .choice{display:grid;grid-template-columns:1fr 1fr;background:#f2f4f7;padding:7px;gap:7px}.mockup-patrimonio-herencia .choiceBtn{border:0;background:transparent;border-radius:14px;padding:17px;text-align:left;color:#606c81}.mockup-patrimonio-herencia .choiceBtn b{display:block;font-size:15px;color:inherit;margin-bottom:4px}.mockup-patrimonio-herencia .choiceBtn span{font-size:12px}.mockup-patrimonio-herencia .choiceBtn.active{background:#fff;color:var(--blue);box-shadow:0 5px 18px rgba(27,42,75,.09)}.mockup-patrimonio-herencia .calcBody{display:grid;grid-template-columns:1.08fr .92fr}.mockup-patrimonio-herencia .formPane{padding:30px;border-right:1px solid var(--line)}.mockup-patrimonio-herencia .resultPane{padding:30px;background:#f8faff}.mockup-patrimonio-herencia .formTitle{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px}.mockup-patrimonio-herencia .formTitle h2{font-size:24px;margin:0 0 5px}.mockup-patrimonio-herencia .formTitle p{font-size:13px;color:#727e92;margin:0}.mockup-patrimonio-herencia .year{border:1px solid var(--line);border-radius:10px;padding:9px 12px;background:#fff;font-weight:750}.mockup-patrimonio-herencia .grid2{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-patrimonio-herencia .field{margin-bottom:14px}.mockup-patrimonio-herencia .field label{font-size:13px;font-weight:750;color:#455169;display:block;margin-bottom:7px}.mockup-patrimonio-herencia .inputWrap{position:relative}.mockup-patrimonio-herencia .inputWrap input,.mockup-patrimonio-herencia .field select{width:100%;border:1px solid #d7dce5;border-radius:11px;padding:13px;background:#fff;color:var(--ink);font-weight:700;outline:none}.mockup-patrimonio-herencia .inputWrap input{padding-left:31px}.mockup-patrimon