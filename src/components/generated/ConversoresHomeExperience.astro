<div class="mockup-conversores-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Conversores</div><div class="heroGrid"><div><span class="eyebrow">Una medida, cualquier unidad</span><h1>Convertí lo que necesitás, sin buscar la fórmula.</h1><p class="lead">Medidas, temperatura, datos, talles, cocina, monedas y texto. Resultado instantáneo, equivalencias claras y unidades intercambiables.</p><div class="trust"><span>✓ Conversión bidireccional</span><span>✓ Precisión controlada</span><span>✓ Sin registro</span></div><div class="ruler"></div></div>
<div class="converter"><div class="converterHead"><div><h2>Conversor universal</h2><p>Elegí el tipo y escribí en cualquiera de los campos.</p></div><span class="live">RESULTADO EN VIVO</span></div><div class="types"><button class="type active" data-type="length">Longitud</button><button class="type" data-type="mass">Peso</button><button class="type" data-type="temp">Temperatura</button><button class="type" data-type="data">Datos</button></div><div class="convertGrid"><div class="field"><label>Valor de origen</label><div class="valueBox"><input id="fromValue" value="12.5"><select id="fromUnit"></select></div></div><button class="swap" id="swap">⇄</button><div class="field"><label>Resultado</label><div class="valueBox"><input id="toValue" value="31.75"><select id="toUnit"></select></div></div></div><div class="formula" id="formula">12,5 pulgadas × 2,54 = 31,75 centímetros</div><button class="primary" id="copy">Copiar resultado</button><div class="quick"><button data-preset="1">1 unidad</button><button data-preset="10">10 unidades</button><button data-preset="100">100 unidades</button></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Encontrá el conversor correcto</span><h2>¿Qué querés convertir?</h2><p>Elegí una familia y priorizamos las herramientas relacionadas.</p></div><div class="categories"><button class="category active" data-filter="measure"><span class="catIcon">↔</span><h3>Medidas</h3><p>Longitud, peso, área y volumen.</p></button><button class="category" data-filter="money"><span class="catIcon">$</span><h3>Moneda</h3><p>Tipo de cambio e inversa.</p></button><button class="category" data-filter="sizes"><span class="catIcon">♢</span><h3>Talles</h3><p>Ropa, calzado y anillos.</p></button><button class="category" data-filter="cooking"><span class="catIcon">♨</span><h3>Cocina</h3><p>Tazas, gramos y horno.</p></button><button class="category" data-filter="data"><span class="catIcon">▦</span><h3>Datos</h3><p>Bytes, velocidad y almacenamiento.</p></button><button class="category" data-filter="text"><span class="catIcon">Aa</span><h3>Texto</h3><p>Números, palabras y formatos.</p></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Todos los conversores</span><h2>Rápidos, explicados y ordenados.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todos</button><button class="filter" data-filter="measure">Medidas</button><button class="filter" data-filter="money">Moneda</button><button class="filter" data-filter="sizes">Talles</button><button class="filter" data-filter="cooking">Cocina</button><button class="filter" data-filter="data">Datos</button><button class="filter" data-filter="text">Texto</button></div><input class="search" id="search" placeholder="Buscar un conversor…"></div><div class="cards"><article class="card featured" data-cat="measure" data-text="longitud metros centímetros pulgadas pies millas"><span class="tag">Más usado</span><h3>Conversor de longitud</h3><p>Metros, kilómetros, centímetros, pulgadas, pies, yardas y millas en ambas direcciones.</p><a class="hc-tool-link" href="/conversores/longitud">Abrir conversor →</a></article><article class="card" data-cat="sizes" data-text="talles ropa calzado zapatillas internacional"><span class="tag">Compras</span><h3>Conversor de talles</h3><p>Equivalencias de ropa y calzado entre países.</p><a class="hc-tool-link" href="/conversores/talles">Convertir →</a></article><article class="card" data-cat="text" data-text="números letras escribir monto palabras"><span class="tag">Texto</span><h3>Números a letras</h3><p>Escribí montos y números completos en palabras.</p><a class="hc-tool-link" href="/conversores/numeros-a-letras">Convertir →</a></article><article class="card" data-cat="cooking" data-text="temperatura horno celsius fahrenheit gas"><span class="tag">Cocina</span><h3>Temperatura del horno</h3><p>°C, °F, gas mark y tipo de horno.</p><a class="hc-tool-link" href="/cocina/temperatura-del-horno">Convertir →</a></article><article class="card" data-cat="cooking measure" data-text="tazas gramos mililitros ingredientes cocina"><span class="tag">Ingredientes</span><h3>Tazas a gramos</h3><p>Equivalencias específicas según ingrediente.</p><a class="hc-tool-link" href="/cocina/tazas-y-gramos">Convertir →</a></article><article class="card" data-cat="money" data-text="moneda tipo cambio dólar euro conversor"><span class="tag">Finanzas</span><h3>Conversor de moneda</h3><p>Ingresá la cotización exacta de tu banco o plataforma.</p><a class="hc-tool-link" href="/cambio-de-monedas">Convertir →</a></article><article class="card" data-cat="data" data-text="bytes kilobytes megabytes gigabytes terabytes"><span class="tag">Tecnología</span><h3>Bytes y almacenamiento</h3><p>KB, MB, GB, TB y sistema binario o decimal.</p><a class="hc-tool-link" href="/tecnologia/almacenamiento">Convertir →</a></article><article class="card" data-cat="measure" data-text="área metros cuadrados hectáreas acres"><span class="tag">Superficie</span><h3>Área y superficie</h3><p>m², hectáreas, acres, pies y pulgadas cuadradas.</p><a class="hc-tool-link" href="/matematica/area-y-perimetro">Convertir →</a></article><div class="empty" id="empty">No encontramos un conversor con esa búsqueda.</div></div></div></section>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Conversión confiable</span><h2>Qué cuidamos en cada resultado.</h2></div><div class="tips"><article class="tip dark"><h3>La unidad importa</h3><p>Mostramos símbolo, nombre completo y sistema para evitar confundir magnitudes parecidas.</p><div class="line">✓ SI e imperial</div><div class="line">✓ Conversión inversa</div></article><article class="tip"><h3>La precisión también</h3><p>Redondeamos para leer mejor, pero conservamos suficiente precisión en el cálculo interno.</p><div class="line">✓ Decimales razonables</div><div class="line">✓ Fórmula visible</div></article><article class="tip"><h3>No todo es una regla fija</h3><p>Talles e ingredientes usan tablas de referencia porque no existe una equivalencia matemática universal.</p><div class="line">✓ Fuente y margen</div><div class="line">✓ Advertencias claras</div></article></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-conversores-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-conversores-home');if(!root)return;

const sets={length:{units:{m:1,cm:.01,km:1000,in:.0254,ft:.3048,mi:1609.344},labels:{m:"Metros",cm:"Centímetros",km:"Kilómetros",in:"Pulgadas",ft:"Pies",mi:"Millas"},from:"in",to:"cm"},mass:{units:{kg:1,g:.001,lb:.45359237,oz:.0283495,t:1000},labels:{kg:"Kilogramos",g:"Gramos",lb:"Libras",oz:"Onzas",t:"Toneladas"},from:"kg",to:"lb"},data:{units:{B:1,KB:1000,MB:1e6,GB:1e9,TB:1e12},labels:{B:"Bytes",KB:"Kilobytes",MB:"Megabytes",GB:"Gigabytes",TB:"Terabytes"},from:"GB",to:"MB"},temp:{units:{C:"C",F:"F",K:"K"},labels:{C:"Celsius",F:"Fahrenheit",K:"Kelvin"},from:"C",to:"F"}},$=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let type="length";
function options(){const s=sets[type],h=Object.keys(s.units).map(u=>`<option value="${u}">${s.labels[u]}</option>`).join("");$("#fromUnit").innerHTML=h;$("#toUnit").innerHTML=h;$("#fromUnit").value=s.from;$("#toUnit").value=s.to;convert("from")}
function temperature(v,a,b){let c=a==="C"?v:a==="F"?(v-32)*5/9:v-273.15;return b==="C"?c:b==="F"?c*9/5+32:c+273.15}
function convert(origin){const a=$("#fromUnit").value,b=$("#toUnit").value,s=sets[type];if(origin==="to"){const v=Number(String($("#toValue").value).replace(",","."))||0,r=type==="temp"?temperature(v,b,a):v*s.units[b]/s.units[a];$("#fromValue").value=clean(r)}else{const v=Number(String($("#fromValue").value).replace(",","."))||0,r=type==="temp"?temperature(v,a,b):v*s.units[a]/s.units[b];$("#toValue").value=clean(r)}$("#formula").textContent=`${$("#fromValue").value} ${s.labels[a]} = ${$("#toValue").value} ${s.labels[b]}`}
function clean(n){return Number(n.toPrecision(8)).toLocaleString("es-AR",{maximumFractionDigits:8,useGrouping:false})}$$(".type").forEach(b=>b.onclick=()=>{type=b.dataset.type;$$(".type").forEach(x=>x.classList.toggle("active",x===b));options()});$("#fromValue").oninput=()=>convert("from");$("#toValue").oninput=()=>convert("to");$("#fromUnit").oninput=$("#toUnit").oninput=()=>convert("from");$("#swap").onclick=()=>{const a=$("#fromUnit").value;$("#fromUnit").value=$("#toUnit").value;$("#toUnit").value=a;convert("from")};$$("[data-preset]").forEach(b=>b.onclick=()=>{$("#fromValue").value=b.dataset.preset;convert("from")});$("#copy").onclick=e=>{navigator.clipboard?.writeText($("#toValue").value);const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Resultado copiado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".category").forEach(b=>b.onclick=()=>{$$(".category").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent="Abriendo: "+t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast(b.closest(".card").querySelector("h3").textContent));options();

})();
</script>
