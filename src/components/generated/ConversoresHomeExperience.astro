ockup-conversores-home .primary{height:50px;width:100%;border:0;border-radius:12px;background:var(--orange);color:#fff;font-weight:900;margin-top:12px;cursor:pointer}.mockup-conversores-home .quick{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.mockup-conversores-home .quick :is(button, a.hc-tool-link){border:1px solid var(--line);background:#fff;border-radius:9px;padding:9px 4px;font-size:9px;color:var(--muted);cursor:pointer}
