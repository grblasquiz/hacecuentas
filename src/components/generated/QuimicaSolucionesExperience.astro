---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-quimica-soluciones" set:html={`<section class="hero"><div class="wrap crumb"><b>Ciencia</b> &nbsp;/&nbsp; Química de soluciones</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Calculadora de laboratorio</span><h1>Prepará soluciones<br>con la concentración<br>exacta.</h1><p>Pasá de gramos a moles, calculá molaridad, resolvé diluciones y verificá titulaciones sin perderte entre unidades.</p><div class="chips"><span>⚗️ 4 cálculos</span><span>✓ Unidades consistentes</span><span>∑ Fórmula explicada</span></div><div class="car-art"><div class="road" style="height:18px"></div><div style="position:absolute;left:70px;bottom:48px;width:210px;height:170px;background:linear-gradient(180deg,transparent 0 35%,#75d4c8 36%);clip-path:polygon(34% 0,66% 0,66% 34%,95% 100%,5% 100%,34% 34%);border-radius:0 0 35px 35px"></div><div style="position:absolute;left:156px;bottom:130px;width:38px;height:38px;border-radius:50%;background:#fff8;box-shadow:55px 25px 0 -8px #fff9,-35px 30px 0 -11px #fff"></div><div class="fuel-card"><small>CONCENTRACIÓN CALCULADA</small><strong id="art-value">0,200 mol/L</strong><span id="art-place">NaCl · 500 mL</span></div></div></div>
<form class="calc"><div class="calc-title"><div><h2>¿Qué querés calcular?</h2><p>Mostramos sólo los datos que necesitás.</p></div><span class="tag">Resultado instantáneo</span></div><div class="section-label">Elegí tu caso</div><div class="cases"><button type="button" class="case active" data-mode="molarity"><i>⚗️</i>Molaridad</button><button type="button" class="case" data-mode="dilution"><i>💧</i>Dilución</button><button type="button" class="case" data-mode="percent"><i>🧪</i>Concentración %</button><button type="button" class="case" data-mode="titration"><i>滴</i>Titulación</button></div><div class="section-label" id="field-title">Datos de la solución</div><div class="fields"><div class="field"><label id="l1">Masa de soluto</label><div class="inline"><input id="v1" type="number" step=".001" value="5.844"><b id="u1">g</b></div></div><div class="field"><label id="l2">Masa molar</label><div class="inline"><input id="v2" type="number" step=".001" value="58.44"><b id="u2">g/mol</b></div></div><div class="field wide"><label id="l3">Volumen final</label><div class="inline"><input id="v3" type="number" step=".001" value="0.5"><b id="u3">L</b></div></div></div><div class="advanced"><span id="formula-note">M = (masa ÷ masa molar) ÷ volumen</span><button type="button" id="advanced-toggle">+ Ver precisión</button></div><div class="extra" id="extra-fields"><div class="field"><label>Cifras decimales</label><select id="digits"><option>2</option><option selected>3</option><option>4</option><option>5</option></select></div><div class="field"><label>Temperatura de referencia</label><div class="inline"><input id="temp" type="number" value="20"><b>°C</b></div></div></div><section class="result"><div class="result-top"><div><small id="result-label">Molaridad de la solución</small><div class="value" id="result-value">0,200 mol/L</div></div><div class="verdict"><small>Control</small><strong id="verdict">Datos consistentes</strong></div></div><div class="stats"><span id="s1l">Cantidad de sustancia<b id="s1">0,100 mol</b></span><span id="s2l">Concentración en g/L<b id="s2">11,688 g/L</b></span><span id="s3l">Partículas estimadas<b id="s3">6,022 × 10²²</b></span></div><button class="go" id="update" type="button">Actualizar cálculo</button></section></form></div></section>
<section class="scale-section"><div class="wrap"><header class="center"><span>La concentración en contexto</span><h2>¿Dónde cae tu solución?</h2><p>Una escala clara ayuda a detectar rápidamente resultados improbables o errores de unidad.</p></header><div class="scale-card"><div class="meter"><i class="pin" id="pin" data-value="0,200 M"></i></div><div class="meter-labels"><div><b>Muy diluida</b>Menos de 0,01 M</div><div><b>Uso habitual</b>0,01 a 1 M</div><div><b>Concentrada</b>Más de 1 M</div></div><div class="meter-summary"><span id="scale-copy">5,844 g de NaCl llevados a 500 mL.</span><b id="scale-result">Resultado: 0,200 mol/L</b></div></div></div></section>
<section class="breakdown"><div class="wrap break-grid"><article class="card"><h3>La cuenta, paso por paso</h3><div class="line"><span id="d1l">Masa de soluto</span><b id="d1">5,844 g</b></div><div class="line"><span id="d2l">Masa molar</span><b id="d2">58,440 g/mol</b></div><div class="line"><span id="d3l">Moles calculados</span><b id="d3">0,100 mol</b></div><div class="line"><span id="d4l">Volumen final</span><b id="d4">0,500 L</b></div><div class="line total"><strong id="df-label">Molaridad</strong><b id="df">0,200 mol/L</b></div></article><article class="card"><h3>Regla de oro</h3><div class="step"><i>1</i><div><b>Elegí una sola unidad</b><span>Convertí mL a L antes de calcular molaridad.</span></div></div><div class="step"><i>2</i><div><b>Usá el volumen final</b><span>No el volumen de solvente que agregaste.</span></div></div><div class="step"><i>3</i><div><b>Conservá cifras significativas</b><span>El dato menos preciso limita el resultado.</span></div></div><div class="warning">⚠️ En laboratorio, verificá pureza del reactivo, temperatura, material volumétrico y procedimiento de seguridad.</div></article></div></section>
<section class="tips"><div class="wrap"><header class="center"><span>Cuatro cálculos, una lógica</span><h2>Elegí el camino correcto</h2></header><div class="tip-grid"><article class="tip"><i>⚗️</i><h3>Molaridad</h3><p>Moles de soluto por litro de solución terminada.</p><span class="impact">M = n / V</span></article><article class="tip"><i>💧</i><h3>Dilución</h3><p>Conserva la cantidad de soluto entre stock y final.</p><span class="impact">C₁V₁ = C₂V₂</span></article><article class="tip"><i>🧪</i><h3>Porcentaje</h3><p>Gramos de soluto cada 100 mL de solución.</p><span class="impact">% p/v</span></article><article class="tip"><i>滴</i><h3>Titulación</h3><p>La equivalencia revela la concentración desconocida.</p><span class="impact">CₐVₐ = CᵦVᵦ</span></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">Unidades que no se mezclan</span><h2>La mayoría de los errores no son de química: son de conversión.</h2><p>Antes de usar la fórmula, hacé compatibles masa, volumen y concentración.</p></div><div class="compare"><div><small>VOLUMEN</small><b>1 L = 1.000 mL</b><span>Convertí antes de dividir</span></div><div><small>CANTIDAD</small><b>n = m / M</b><span>Gramos a moles</span></div><div><small>AVOGADRO</small><b>6,022 × 10²³</b><span>Partículas por mol</span></div></div></div></section><div class="foot"></div><button type="button" id="date-result" hidden aria-hidden="true"></button><button type="button" id="progress-result" hidden aria-hidden="true"></button><button type="button" id="fund-result" hidden aria-hidden="true"></button><button type="button" id="art-consumption" hidden aria-hidden="true"></button><button type="button" id="art-cost" hidden aria-hidden="true"></button><button type="button" id="scale-verdict" hidden aria-hidden="true"></button><button type="button" id="detail-last" hidden aria-hidden="true"></button><button type="button" id="detail-interval" hidden aria-hidden="true"></button><button type="button" id="detail-used" hidden aria-hidden="true"></button><button type="button" id="detail-next" hidden aria-hidden="true"></button><button type="button" id="detail-left" hidden aria-hidden="true"></button><button type="button" id="cmp-low" hidden aria-hidden="true"></button><button type="button" id="cmp-current" hidden aria-hidden="true"></button><button type="button" id="cmp-high" hidden aria-hidden="true"></button><button type="button" id="cmp-current-cost" hidden aria-hidden="true"></button><button type="button" id="province" hidden aria-hidden="true"></button><button type="button" id="rate" hidden aria-hidden="true"></button><button type="button" id="quota-value" hidden aria-hidden="true"></button><button type="button" id="cash-value" hidden aria-hidden="true"></button><button type="button" id="month-value" hidden aria-hidden="true"></button><button type="button" id="d-valuation" hidden aria-hidden="true"></button><button type="button" id="d-rate" hidden aria-hidden="true"></button><button type="button" id="d-year" hidden aria-hidden="true"></button><button type="button" id="d-discount" hidden aria-hidden="true"></button><button type="button" id="d-final" hidden aria-hidden="true"></button><button type="button" id="cmp-name" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-quimica-soluciones')?document.currentScript.previousElementSibling:document.querySelector('.mockup-quimica-soluciones');


let chemMode="molarity";const c$=s=>root.querySelector(s),cv=id=>Math.max(0,Number(c$(id).value)||0),cd=x=>x.toFixed(Number(c$("#digits").value)||3).replace(".",",");
const chemCases={molarity:{labels:["Masa de soluto","Masa molar","Volumen final"],units:["g","g/mol","L"],vals:[5.844,58.44,.5],formula:"M = (masa ÷ masa molar) ÷ volumen"},dilution:{labels:["Concentración inicial C₁","Concentración final C₂","Volumen final V₂"],units:["mol/L","mol/L","mL"],vals:[1,.1,250],formula:"V₁ = C₂ × V₂ ÷ C₁"},percent:{labels:["Masa de soluto","Volumen final","Densidad opcional"],units:["g","mL","g/mL"],vals:[5,100,1],formula:"% p/v = masa ÷ volumen × 100"},titration:{labels:["Concentración titulante","Volumen titulante","Volumen de muestra"],units:["mol/L","mL","mL"],vals:[.1,23.4,25],formula:"C muestra = C titulante × V titulante ÷ V muestra"}};
function setChem(m){chemMode=m;let x=chemCases[m];["1","2","3"].forEach((k,i)=>{c$("#l"+k).textContent=x.labels[i];c$("#u"+k).textContent=x.units[i];c$("#v"+k).value=x.vals[i]});c$("#formula-note").textContent=x.formula;chemCalc()}
function chemCalc(){let a=cv("#v1"),b=Math.max(.000001,cv("#v2")),c=Math.max(.000001,cv("#v3")),r,label,unit,stats;if(chemMode==="molarity"){let mol=a/b;r=mol/c;label="Molaridad de la solución";unit="mol/L";stats=[cd(mol)+" mol",cd(a/c)+" g/L",(mol*6.02214076e23).toExponential(3).replace("e+"," × 10^")+" partículas"]}else if(chemMode==="dilution"){r=b*c/a;label="Volumen de solución madre";unit="mL";stats=[cd(c-r)+" mL solvente",cd(a/b)+"× dilución",cd(b)+" mol/L final"]}else if(chemMode==="percent"){r=a/b*100;label="Concentración porcentual";unit="% p/v";stats=[cd(a/b*1000)+" g/L",cd(a/b*1e6)+" ppm",cd(a/(b*c)*100)+"% m/m"]}else{r=a*b/c;label="Concentración de la muestra";unit="mol/L";stats=[cd(a*b/1000)+" mol usados",cd(b)+" mL titulante",cd(c)+" mL muestra"]}let out=cd(r)+" "+unit;c$("#result-label").textContent=label;c$("#result-value").textContent=out;c$("#art-value").textContent=out;c$("#art-place").textContent=chemCases[chemMode].formula;c$("#s1").textContent=stats[0];c$("#s2").textContent=stats[1];c$("#s3").textContent=stats[2];c$("#pin").style.left=Math.max(3,Math.min(97,20+Math.log10(Math.max(.001,r))*22))+"%";c$("#pin").dataset.value=cd(r);c$("#scale-result").textContent="Resultado: "+out;c$("#scale-copy").textContent=chemCases[chemMode].formula;c$("#d1l").textContent=chemCases[chemMode].labels[0];c$("#d2l").textContent=chemCases[chemMode].labels[1];c$("#d3l").textContent=chemCases[chemMode].labels[2];c$("#d1").textContent=cd(a)+" "+chemCases[chemMode].units[0];c$("#d2").textContent=cd(b)+" "+chemCases[chemMode].units[1];c$("#d3").textContent=cd(c)+" "+chemCases[chemMode].units[2];c$("#d4l").textContent="Fórmula aplicada";c$("#d4").textContent=chemCases[chemMode].formula;c$("#df-label").textContent=label;c$("#df").textContent=out}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(x=>x.classList.remove("active"));b.classList.add("active");setChem(b.dataset.mode)}));root.querySelectorAll("input,select").forEach(e=>e.addEventListener("input",chemCalc));c$("#advanced-toggle").addEventListener("click",e=>{c$("#extra-fields").classList.toggle("open");e.currentTarget.textContent=c$("#extra-fields").classList.contains("open")?"− Ocultar precisión":"+ Ver precisión"});c$("#update").addEventListener("click",e=>{e.preventDefault();chemCalc();e.currentTarget.textContent="✓ Cálculo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar cálculo",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());chemCalc();

})();
</script>
<style is:global>

