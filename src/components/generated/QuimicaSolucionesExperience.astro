.mockup-quimica-soluciones .hero{background:linear-gradient(128deg,#f5f9fd 0%,#f5f9fd 60%,#eef8f3 100%);padding:25px 0 62px;overflow:hidden}.mockup-quimica-soluciones .crumb{font-size:12px;color:#718299;margin-bottom:31px}.mockup-quimica-soluciones .crumb b{color:#127e67}.mockup-quimica-soluciones .hero-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:52px;align-items:start}.mockup-quimica-soluciones .hero-grid>*{min-width:0}.mockup-quimica-soluciones .copy{padding-top:8px}.mockup-quimica-soluciones .eyebrow{font-size:11px;font-weight:850;letter-spacing:.14em;text-transform:uppercase;color:#127e67;display:flex;align-items:center;gap:9px}.mockup-quimica-soluciones .eyebrow:before{content:"";width:28px;height:2px;background:#127e67}.mockup-quimica-soluciones .copy h1{font-size:51px;line-height:1.03;letter-spacing:-.052em;margin:18px 0;color:#10213a}.mockup-quimica-soluciones .copy>p{font-size:17px;line-height:1.65;color:#53677e;max-width:510px}.mockup-quimica-soluciones .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:23px}.mockup-quimica-soluciones .chips span{background:#fff;border:1px solid #dbe5ed;border-radius:9px;padding:9px 11px;color:#4d6279;font-size:10px}
.mockup-quimica-soluciones .car-art{height:235px;margin-top:18px;position:relative}.mockup-quimica-soluciones .road{position:absolute;left:15px;right:20px;bottom:31px;height:54px;border-radius:50%;background:#dce8ec;transform:skewX(-13deg)}.mockup-quimica-soluciones .road:after{content:"";position:absolute;left:8%;right:8%;top:25px;border-top:3px dashed #fff}.mockup-quimica-soluciones .car{position:absolute;left:35px;bottom:58px;width:330px;height:100px}.mockup-quimica-soluciones .car-body{position:absolute;inset:35px 0 0;background:linear-gradient(135deg,#2b8d7a,#166b61);border-radius:45px 58px 18px 20px;box-shadow:0 18px 30px #17385828}.mockup-quimica-soluciones .car-body:before{content:"";position:absolute;width:145px;height:65px;left:75px;top:-42px;background:#258473;clip-path:polygon(22% 0,78% 0,100% 100%,0 100%)}.mockup-quimica-soluciones .glass{position:absolute;left:109px;top:2px;width:78px;height:38px;background:#d7edf1;clip-path:polygon(15% 0,79% 0,100% 100%,0 100%);z-index:2}.mockup-quimica-soluciones .wheel{position:absolute;bottom:-13px;width:48px;height:48px;border:9px solid #17324f;border-radius:50%;background:#c9d5dd;z-index:3}.mockup-quimica-soluciones .wheel.one{left:47px}.mockup-quimica-soluciones .wheel.two{right:42px}.mockup-quimica-soluciones .fuel-card{position:absolute;right:5px;top:5px;background:#fff;border:1px solid #d8e4eb;border-radius:14px;padding:16px 18px;box-shadow:0 18px 40px #17385817}.mockup-quimica-soluciones .fuel-card small{display:block;font-size:8px;color:#697d90}.mockup-quimica-soluciones .fuel-card strong{display:block;color:#147762;font-size:24px;margin:5px 0}.mockup-quimica-soluciones .fuel-card span{font-size:9px;color:#536a7f}
.mockup-quimica-soluciones .calc{background:#fff;border:1px solid #d8e4eb;border-radius:20px;padding:26px 29px;box-shadow:0 25px 60px #173b6418;position:relative;z-index:2}.mockup-quimica-soluciones .calc-title{display:flex;justify-content:space-between;gap:20px}.mockup-quimica-soluciones .calc h2{font-size:23px;margin:0 0 4px}.mockup-quimica-soluciones .calc-title p{font-size:10px;color:#60758c;margin:0}.mockup-quimica-soluciones .tag{font-size:9px;color:#14775b;background:#e6f6ef;border-radius:99px;padding:7px 10px;font-weight:800;height:max-content;white-space:nowrap}.mockup-quimica-soluciones .section-label{font-size:10px;font-weight:850;color:#293b53;margin:17px 0 8px}.mockup-quimica-soluciones .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.mockup-quimica-soluciones .case{border:1px solid #dce5ec;background:#fff;border-radius:10px;padding:9px 4px;color:#52677f;font-size:8px;font-weight:750;min-height:66px}.mockup-quimica-soluciones .case i{display:block;font-style:normal;font-size:17px;margin-bottom:3px}.mockup-quimica-soluciones .case.active{border:2px solid #19816d;background:#eef9f5;color:#116c5a}.mockup-quimica-soluciones .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-quimica-soluciones .field{border:1px solid #dbe4eb;border-radius:10px;padding:9px 11px;min-height:57px}.mockup-quimica-soluciones .field.wide{grid-column:span 2}.mockup-quimica-soluciones .field label{display:block;color:#63788e;font-size:8px;margin-bottom:5px}.mockup-quimica-soluciones .field input,.mockup-quimica-soluciones .field select{border:0;outline:0;background:none;width:100%;color:#142641;font-weight:750;font-size:13px}.mockup-quimica-soluciones .inline{display:flex;align-items:center;gap:5px}.mockup-quimica-soluciones .inline b{font-size:11px;color:#51667d}.mockup-quimica-soluciones .advanced{display:flex;justify-content:space-between;margin:11px 0;color:#566d84;font-size:9px}.mockup-quimica-soluciones .advanced button{border:0;background:none;c