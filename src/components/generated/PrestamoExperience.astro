---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-prestamo" set:html={`<section class="hero"><div class="wrap crumb"><b>Finanzas personales</b> &nbsp;/&nbsp; Préstamo</div><div class="wrap grid"><div class="copy"><span class="eyebrow">Antes de firmar</span><h1>La cuota entra. ¿Pero cuánto vas a pagar de verdad?</h1><p>Calculá cuota, costo total y CFT con IVA, seguro y gastos. Compará ofertas y mirá si el préstamo cabe en tu ingreso sin ahogarte.</p><div class="chips"><span>✓ Cuota real</span><span>✓ CFT con cargos</span><span>✓ Comparación de ofertas</span></div><div class="art"><div class="wallet"><div class="coin"></div></div><div class="float"><small>PRIMERA CUOTA</small><b id="art-value">$511.843</b><span id="art-copy">36 meses · sistema francés</span></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Revisá tu préstamo</h2><p class="muted">Elegí el caso y completá la oferta.</p></div><span class="tag">Cálculo con CFT</span></div><div class="label">¿Qué tipo de préstamo es?</div><div class="cases"><button type="button" class="case active" data-mode="personal"><i>$</i>Personal</button><button type="button" class="case" data-mode="bna"><i>BN</i>Nación</button><button type="button" class="case" data-mode="auto"><i>▰</i>Prendario</button><button type="button" class="case" data-mode="compare"><i>⇄</i>Comparar</button><button type="button" class="case" data-mode="capacity"><i>◔</i>Qué aguanto</button><button type="button" class="case" data-mode="pyme"><i>▦</i>Pyme</button></div><div class="label">Datos de la oferta</div><div class="fields"><div class="field" data-for="loan compare"><label>Monto del préstamo</label><input id="amount" value="5000000"></div><div class="field" data-for="loan compare capacity"><label>TNA de la oferta</label><input id="rate" value="85"></div><div class="field" data-for="loan compare capacity"><label>Plazo en meses</label><input id="months" value="36"></div><div class="field" data-for="loan compare"><label>IVA sobre intereses</label><select id="vat"><option value=".21">21% consumidor final</option><option value=".105">10,5% responsable inscripto</option><option value="0">Ya incluido / exento</option></select></div><div class="field" data-for="loan compare"><label>Seguro mensual</label><input id="insurance" value="0"></div><div class="field" data-for="loan compare"><label>Gastos de otorgamiento</label><input id="fees" value="120000"></div><div class="field hide" data-for="compare"><label>TNA de oferta B</label><input id="rate-b" value="72"></div><div class="field hide" data-for="compare"><label>Plazo de oferta B</label><input id="months-b" value="48"></div><div class="field hide" data-for="capacity"><label>Ingreso mensual neto</label><input id="income" value="1800000"></div><div class="field hide" data-for="capacity"><label>Cuotas que ya pagás</label><input id="existing" value="180000"></div></div><section class="result"><div class="result-top"><div><small id="result-label">PRIMERA CUOTA ESTIMADA</small><div class="value" id="result">$511.843</div></div><div class="badge"><small id="badge-label">CFT anual</small><b id="badge">145,8%</b></div></div><div class="stats"><span id="s1l">TOTAL A PAGAR<b id="s1">$18.295.000</b></span><span id="s2l">COSTO DEL CRÉDITO<b id="s2">$13.295.000</b></span><span id="s3l">CUOTA / INGRESO<b id="s3">28,4%</b></span></div><button class="go" id="update" type="button">Actualizar préstamo</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Lo que la TNA no muestra</span><h2>De qué está hecho todo lo que pagás</h2><p>El capital es lo que recibís. Intereses, IVA, seguro y gastos forman el costo verdadero.</p></header><div class="composition"><div class="donut" id="donut"></div><div class="legend"><div><i style="background:#356fbe"></i><span>Capital recibido</span><b id="leg-capital">$5.000.000</b></div><div><i style="background:#efbc58"></i><span>Intereses</span><b id="leg-interest">$9.820.000</b></div><div><i style="background:#62b89b"></i><span>IVA y seguro</span><b id="leg-tax">$2.062.000</b></div><div><i style="background:#d98273"></i><span>Gastos iniciales</span><b id="leg-fees">$120.000</b></div></div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3 id="detail-title">Tu préstamo, línea por línea</h3><div class="line"><span id="d1l">Monto recibido</span><b id="d1">$5.000.000</b></div><div class="line"><span id="d2l">Cuota pura</span><b id="d2">$430.000</b></div><div class="line"><span id="d3l">IVA de la primera cuota</span><b id="d3">$74.000</b></div><div class="line"><span id="d4l">Gastos y seguro</span><b id="d4">$120.000</b></div><div class="line total"><strong id="d5l">Total a pagar</strong><b id="d5">$18.295.000</b></div></article><article class="card"><h3>Antes de decidir</h3><div class="rule"><i>1</i><div><b>Pedí el CFT por escrito</b><span>Es el único número que incorpora todos los cargos.</span></div></div><div class="rule"><i>2</i><div><b>Compará el mismo monto y plazo</b><span>Una cuota menor puede esconder muchos meses más.</span></div></div><div class="rule"><i>3</i><div><b>Dejá margen en tu ingreso</b><span>Tomá 30% como límite conservador para todas tus cuotas.</span></div></div><div class="warning">Estimación informativa. Las tasas y cargos reales dependen de la entidad y del contrato.</div></article></div></section>
<section class="steps"><div class="wrap"><header class="center"><span>La decisión completa</span><h2>Cuatro números antes de firmar</h2></header><div class="stepgrid"><article class="step"><i>1</i><h3>Cuota real</h3><p>Capital, interés, IVA y seguro del mes.</p><em>¿Entra en mi sueldo?</em></article><article class="step"><i>2</i><h3>Costo total</h3><p>Todo lo que sale de tu bolsillo hasta terminar.</p><em>¿Cuánto devuelvo?</em></article><article class="step"><i>3</i><h3>CFT anual</h3><p>La tasa comparable con todos los cargos dentro.</p><em>¿Cuál oferta conviene?</em></article><article class="step"><i>4</i><h3>Plazo</h3><p>Más meses baja la cuota, pero agranda el total.</p><em>¿Cuánto quiero deber?</em></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#9dc5ed">No mires sólo la cuota</span><h2>Una cuota cómoda puede ser el préstamo más caro.</h2><p>Cuando el plazo cambia, compará costo total y CFT. La cuota sólo dice si podés pagar este mes.</p></div><div class="comparebox"><div><small>TNA</small><b id="dark-tna">85%</b><span>La vidriera</span></div><div><small>CFT</small><b id="dark-cft">145,8%</b><span>El costo real</span></div><div><small>PLAZO</small><b id="dark-term">36 meses</b><span>Tiempo endeudado</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-prestamo')?document.currentScript.previousElementSibling:document.querySelector('.mockup-prestamo');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0),ars=x=>"$"+Math.round(x).toLocaleString("es-AR"),pct=x=>x.toLocaleString("es-AR",{maximumFractionDigits:1})+"%";let mode="personal";function loan(amount,rate,months,insurance,fees,vat){let i=rate/100/12,m=Math.max(1,Math.round(months)),factor=(1+i)**m,pure=i?amount*i*factor/(factor-1):amount/m,balance=amount,interest=0,tax=0,total=fees,first=0;for(let x=1;x<=m;x++){let im=balance*i,capital=pure-im,iv=im*vat,payment=pure+iv+insurance;if(x===1)first=payment;interest+=im;tax+=iv;total+=payment;balance-=capital}let tea=((1+i)**12-1)*100,cft=tea+(tax+insurance*m+fees)/Math.max(1,amount)*100;return{pure,first,interest,tax,total,cost:total-amount,cft,m,insurance:insurance*m,fees}}function stat(names,vals){["s1l","s2l","s3l"].forEach((id,i)=>$("#"+id).childNodes[0].nodeValue=names[i]);["s1","s2","s3"].forEach((id,i)=>$("#"+id).textContent=vals[i])}function detail(a){a.forEach((x,i)=>{$("#d"+(i+1)+"l").textContent=x[0];$("#d"+(i+1)).textContent=x[1]})}
function calc(){let amount=n("#amount"),rate=n("#rate"),months=n("#months"),insurance=n("#insurance"),fees=n("#fees"),vat=n("#vat"),r;if(mode==="capacity"){let income=n("#income"),existing=n("#existing"),limit=income*.3,available=Math.max(0,limit-existing),i=rate/100/12,f=(1+i)**months,max=i?available*(f-1)/(i*f):available*months;$("#result-label").textContent="CUOTA NUEVA CONSERVADORA";$("#result").textContent=ars(available);$("#badge-label").textContent="Límite usado";$("#badge").textContent="30%";stat(["CUOTAS ACTUALES","MONTO FINANCIABLE","MARGEN AL 40%"],[ars(existing),ars(max),ars(Math.max(0,income*.4-existing))]);detail([["Ingreso mensual",ars(income)],["Límite al 30%",ars(limit)],["Cuotas actuales",ars(existing)],["Cuota nueva disponible",ars(available)],["Monto posible",ars(max)]]);$("#art-value").textContent=ars(available);$("#art-copy").textContent="cuota nueva conservadora";return}r=loan(amount,rate,months,insurance,fees,vat);if(mode==="compare"){let b=loan(amount,n("#rate-b"),n("#months-b"),insurance,fees,vat),aWins=r.total<=b.total,diff=Math.abs(r.total-b.total);$("#result-label").textContent="AHORRO CON LA MEJOR OFERTA";$("#result").textContent=ars(diff);$("#badge-label").textContent="Conviene";$("#badge").textContent=aWins?"Oferta A":"Oferta B";stat(["TOTAL OFERTA A","TOTAL OFERTA B","DIFERENCIA"],[ars(r.total),ars(b.total),ars(diff)]);detail([["Oferta A · primera cuota",ars(r.first)],["Oferta A · total",ars(r.total)],["Oferta B · primera cuota",ars(b.first)],["Oferta B · total",ars(b.total)],["Mejor opción",aWins?"Oferta A":"Oferta B"]])}else{let title={personal:"PRIMERA CUOTA ESTIMADA",bna:"CUOTA ESTIMADA BANCO NACIÓN",auto:"CUOTA DEL PRENDARIO",pyme:"CUOTA DEL CRÉDITO PYME"}[mode];$("#result-label").textContent=title;$("#result").textContent=ars(r.first);$("#badge-label").textContent="CFT anual estimado";$("#badge").textContent=pct(r.cft);let income=1800000;stat(["TOTAL A PAGAR","COSTO DEL CRÉDITO","CUOTA / INGRESO"],[ars(r.total),ars(r.cost),pct(r.first/income*100)]);detail([["Monto recibido",ars(amount)],["Cuota pura",ars(r.pure)],["IVA primera cuota",ars((r.first-r.pure-insurance))],["Gastos y seguro",ars(fees+r.insurance)],["Total a pagar",ars(r.total)]]);$("#dark-cft").textContent=pct(r.cft)}$("#art-value").textContent=$("#result").textContent;$("#art-copy").textContent=months+" meses · sistema francés";$("#dark-tna").textContent=pct(rate);$("#dark-term").textContent=months+" meses";$("#leg-capital").textContent=ars(amount);$("#leg-interest").textContent=ars(r.interest);$("#leg-tax").textContent=ars(r.tax+r.insurance);$("#leg-fees").textContent=ars(fees);let total=Math.max(1,r.total),p1=amount/total*100,p2=r.interest/total*100,p3=(r.tax+r.insurance)/total*100;$("#donut").style.background=`conic-gradient(#356fbe 0 ${p1}%,#efbc58 ${p1}% ${p1+p2}%,#62b89b ${p1+p2}% ${p1+p2+p3}%,#d98273 ${p1+p2+p3}% 100%)`}
function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$$(".field[data-for]").forEach(f=>{let base=["personal","bna","auto","pyme"].includes(m)?"loan":m;f.classList.toggle("hide",!f.dataset.for.split(" ").includes(base))});if(m==="bna")$("#rate").value=62;if(m==="auto")$("#rate").value=70;if(m==="pyme")$("#rate").value=58;calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Préstamo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar préstamo",1200)};calc();

})();
</script>
