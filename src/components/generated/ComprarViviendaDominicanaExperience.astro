---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-comprar-vivienda-dominicana" set:html={`<section class="hero"><div class="wrap crumb"><b>República Dominicana</b> &nbsp;/&nbsp; Impuestos &nbsp;/&nbsp; Comprar vivienda</div><div class="wrap grid"><div class="copy"><span class="eyebrow">DGII · vivienda · cuenta completa</span><h1>La casa cuesta una cifra. Tener las llaves, un poco más.</h1><p>Calculá el efectivo para cerrar, la cuota del préstamo y los impuestos que aparecen al comprar, tener o vender una propiedad.</p><div class="chips"><span>✓ Transferencia 3%</span><span>✓ IPI 1% anual</span><span>✓ Crédito hipotecario</span></div><div class="art"><div class="house"><div class="roof"></div><div class="window left"></div><div class="door"></div><div class="window right"></div></div><div class="key">🔑</div><div class="paper"><small id="art-label">EFECTIVO PARA CERRAR</small><b id="art-value">RD$ 1.620.000</b><span id="art-copy">préstamo · inicial 20%</span></div></div></div>
  <form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Hacé la cuenta completa</h2><p class="muted">Elegí en qué momento estás.</p></div><span class="tag">Parámetros DGII</span></div><div class="label">¿Qué querés calcular?</div><div class="cases"><button type="button" class="case active" data-mode="loan"><i>🏦</i>Compro con préstamo</button><button type="button" class="case" data-mode="cash"><i>🔑</i>Compro al contado</button><button type="button" class="case" data-mode="owner"><i>🏠</i>Ya soy propietario</button><button type="button" class="case" data-mode="sell"><i>🤝</i>Voy a vender</button></div><div class="label">Datos del inmueble</div><div class="fields"><div class="field wide"><label id="price-label">Precio del inmueble</label><input id="price" value="6500000"></div><div class="field buying"><label>Valor tasado por la DGII</label><input id="dgii" value="0"></div><div class="field loan"><label>Pago inicial</label><input id="down" value="20"></div><div class="field loan"><label>Tasa anual del préstamo</label><input id="rate" value="11"></div><div class="field loan"><label>Plazo del préstamo (años)</label><input id="years" value="20"></div><div class="field buying"><label>Honorarios legales (%)</label><input id="legal" value="1"></div><div class="field buying"><label>Deslinde, certificaciones y registro</label><input id="other" value="60000"></div><div class="field sell hide"><label>Costo de adquisición</label><input id="cost" value="3500000"></div><div class="field sell hide"><label>Multiplicador de inflación DGII</label><input id="factor" value="1.35"></div></div><section class="result"><div class="result-top"><div><small id="result-label">EFECTIVO QUE NECESITÁS PARA CERRAR</small><div class="value" id="result">RD$ 1.620.000</div></div><div class="badge"><small id="badge-label">Gastos sobre precio</small><b id="badge">4,92%</b></div></div><div class="stats"><span id="s1l">PAGO INICIAL<b id="s1">RD$ 1.300.000</b></span><span id="s2l">CUOTA MENSUAL<b id="s2">RD$ 53.673</b></span><span id="s3l">GASTOS DE CIERRE<b id="s3">RD$ 320.000</b></span></div><button class="go" id="update" type="button">Actualizar cálculo</button></section></form></div></section>
  <section class="section"><div class="wrap"><header class="center"><span id="composition-kicker">El día de la firma</span><h2 id="composition-title">De dónde sale el efectivo inicial</h2><p id="composition-copy">El banco financia una parte del precio. El inicial y los gastos de cierre salen de tu bolsillo.</p></header><div class="stack"><div class="bar"><i class="initial" id="bar-initial">Inicial</i><i class="tax" id="bar-tax">Transferencia</i><i class="legal" id="bar-legal">Legales</i><i class="register" id="bar-register">Registro</i></div><div class="legend"><span id="l1l">PAGO INICIAL<b id="l1">RD$ 1.300.000</b></span><span id="l2l">TRANSFERENCIA 3%<b id="l2">RD$ 195.000</b></span><span id="l3l">HONORARIOS LEGALES<b id="l3">RD$ 65.000</b></span><span id="l4l">REGISTRO Y DESLINDE<b id="l4">RD$ 60.000</b></span></div></div></div></section>
  <section class="break"><div class="wrap breakgrid"><article class="card"><h3 id="detail-title">Tu compra, línea por línea</h3><div class="line"><span id="d1l">Precio del inmueble</span><b id="d1">RD$ 6.500.000</b></div><div class="line"><span id="d2l">Base de transferencia</span><b id="d2">RD$ 6.500.000</b></div><div class="line"><span id="d3l">Impuesto de transferencia</span><b id="d3">RD$ 195.000</b></div><div class="line"><span id="d4l">Honorarios y registro</span><b id="d4">RD$ 125.000</b></div><div class="line total"><strong id="d5l">Efectivo para cerrar</strong><b id="d5">RD$ 1.620.000</b></div></article><article class="card"><h3>Antes de pagar una reserva</h3><div class="rule"><i>1</i><div><b>Confirmá el mayor valor</b><span>La transferencia se calcula sobre precio o tasación DGII, el que sea mayor.</span></div></div><div class="rule"><i>2</i><div><b>Pedí el título limpio</b><span>Verificá deslinde individual, cargas y certificación de estado jurídico.</span></div></div><div class="rule"><i>3</i><div><b>Separá los gastos</b><span>El inicial puede financiarse parcialmente; transferencia y cierre, no.</span></div></div><div class="warning">Estimación informativa. Las escalas y exenciones se actualizan; confirmá el expediente con la DGII y un profesional.</div></article></div></section>
  <section class="moments"><div class="wrap"><header class="center"><span>El inmueble en cuatro momentos</span><h2>La cuenta cambia según tu decisión</h2></header><div class="momentgrid"><article class="moment"><i>🏦</i><h3>Comprar financiado</h3><p>Inicial, 3% de transferencia, cierre, cuota e intereses.</p><em>Necesitás efectivo</em></article><article class="moment"><i>🔑</i><h3>Comprar al contado</h3><p>Sin cuota, pero con transferencia y gastos legales completos.</p><em>El 3% sigue igual</em></article><article class="moment"><i>🏠</i><h3>Tener la propiedad</h3><p>IPI del 1% sobre el excedente del mínimo exento anual.</p><em>Dos cuotas</em></article><article class="moment"><i>🤝</i><h3>Vender</h3><p>Ganancia calculada contra el costo ajustado por inflación.</p><em>No sobre la venta total</em></article></div></div></section>
  <section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#9fc8ff">Carpeta lista, firma tranquila</span><h2>No llegues a la firma con una sola cifra.</h2><p>Pedí por escrito el precio, la base DGII, el impuesto, los honorarios y cada gasto administrativo. Así sabés qué puede cambiar y qué no.</p></div><div class="checklist"><div class="check"><i>✓</i><div><b>Pago inicial</b><span>Parte del precio que no financia el banco</span></div><strong id="c1">RD$ 1.300.000</strong></div><div class="check"><i>✓</i><div><b>Impuesto de transferencia</b><span>3% sobre la base imponible</span></div><strong id="c2">RD$ 195.000</strong></div><div class="check"><i>✓</i><div><b>Honorarios y registro</b><span>Presupuestados por separado</span></div><strong id="c3">RD$ 125.000</strong></div><div class="check"><i>→</i><div><b>Total para cerrar</b><span>Efectivo necesario el día de la firma</span></div><strong id="c4">RD$ 1.620.000</strong></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-comprar-vivienda-dominicana')?document.currentScript.previousElementSibling:document.querySelector('.mockup-comprar-vivienda-dominicana');

    const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),num=id=>Math.max(0,Number($(id).value)||0),dop=x=>"RD$ "+Math.round(x).toLocaleString("es-DO");let mode="loan";const IPI_EXEMPT=10695494;
    function payment(amount,annual,years){const n=years*12,i=annual/100/12;if(!amount||!n)return 0;return i?(amount*i)/(1-Math.pow(1+i,-n)):amount/n}
    function setText(id,v){$("#"+id).textContent=v} function line(i,l,v){setText("d"+i+"l",l);setText("d"+i,v)}
    function bars(vals){const total=Math.max(1,vals.reduce((a,b)=>a+b,0));["initial","tax","legal","register"].forEach((id,i)=>$("#bar-"+id).style.width=Math.max(3,vals[i]/total*100)+"%")}
    function calc(){const price=num("#price"),dgii=num("#dgii"),legal=price*num("#legal")/100,other=num("#other"),base=Math.max(price,dgii),tax=base*.03,closing=tax+legal+other;
      if(mode==="owner"){const excess=Math.max(0,price-IPI_EXEMPT),annual=excess*.01,half=annual/2;setText("result-label","IPI ANUAL ESTIMADO");setText("result",dop(annual));setText("badge-label","Mínimo exento");setText("badge",dop(IPI_EXEMPT));stats(["EXCEDENTE GRAVADO","CUOTA SEMESTRAL","TASA ANUAL"],[dop(excess),dop(half),"1%"]);details("Tu IPI, línea por línea",[["Valor del patrimonio",dop(price)],["Mínimo exento",dop(IPI_EXEMPT)],["Excedente gravado",dop(excess)],["Tasa del IPI","1%"],["IPI anual",dop(annual)]]);composition("Mientras sos propietario","Cómo se forma el IPI anual","Sólo se grava el valor que supera el mínimo exento publicado por la DGII.",[price-excess,excess,annual,half],["VALOR EXENTO","EXCEDENTE GRAVADO","IPI ANUAL","CUOTA SEMESTRAL"],[dop(price-excess),dop(excess),dop(annual),dop(half)]);art("IPI ANUAL",dop(annual),"propiedad · dos cuotas");check(0,0,annual,annual);return}
      if(mode==="sell"){const cost=num("#cost"),factor=Math.max(1,num("#factor")),adjusted=cost*factor,gain=Math.max(0,price-adjusted),taxPerson=gain<=416220?0:gain<=624329?(gain-416220)*.15:gain<=867123?31216+(gain-624329)*.2:79776+(gain-867123)*.25;setText("result-label","ISR ESTIMADO SOBRE LA GANANCIA");setText("result",dop(taxPerson));setText("badge-label","Ganancia gravable");setText("badge",dop(gain));stats(["COSTO AJUSTADO","IMPUESTO PERSONA FÍSICA","PERSONA JURÍDICA 27%"],[dop(adjusted),dop(taxPerson),dop(gain*.27)]);details("Tu venta, línea por línea",[["Precio de venta",dop(price)],["Costo de adquisición",dop(cost)],["Costo ajustado por inflación",dop(adjusted)],["Ganancia gravable",dop(gain)],["ISR estimado",dop(taxPerson)]]);composition("Cuando vendés","Precio, costo ajustado y ganancia","La ganancia no es todo lo que cobrás: primero se descuenta el costo actualizado.",[Math.min(adjusted,price),Math.max(0,gain-taxPerson),taxPerson,0],["COSTO AJUSTADO","GANANCIA NETA","ISR PERSONA FÍSICA","OTROS"],[dop(adjusted),dop(Math.max(0,gain-taxPerson)),dop(taxPerson),dop(0)]);art("ISR ESTIMADO",dop(taxPerson),"venta · persona física");check(0,0,taxPerson,taxPerson);return}
      const cash=mode==="cash",initial=cash?price:price*num("#down")/100,financed=Math.max(0,price-initial),monthly=cash?0:payment(financed,num("#rate"),num("#years")),needed=initial+closing;setText("result-label","EFECTIVO QUE NECESITÁS PARA CERRAR");setText("result",dop(needed));setText("badge-label","Gastos sobre precio");setText("badge",(price?closing/price*100:0).toFixed(2).replace(".",",")+"%");stats(["PAGO INICIAL","CUOTA MENSUAL","GASTOS DE CIERRE"],[dop(initial),cash?"Sin préstamo":dop(monthly),dop(closing)]);details("Tu compra, línea por línea",[["Precio del inmueble",dop(price)],["Base de transferencia",dop(base)],["Impuesto de transferencia",dop(tax)],["Honorarios y registro",dop(legal+other)],["Efectivo para cerrar",dop(needed)]]);composition("El día de la firma","De dónde sale el efectivo inicial",cash?"Pagás el precio completo más los gastos de cierre.": "El banco financia una parte del precio. El inicial y los gastos de cierre salen de tu bolsillo.",[initial,tax,legal,other],["PAGO INICIAL","TRANSFERENCIA 3%","HONORARIOS LEGALES","REGISTRO Y DESLINDE"],[dop(initial),dop(tax),dop(legal),dop(other)]);art("EFECTIVO PARA CERRAR",dop(needed),cash?"compra al contado":"préstamo · inicial "+num("#down")+"%");check(initial,tax,legal+other,needed)}
    function stats(labels,vals){["s1l","s2l","s3l"].forEach((id,i)=>{$("#"+id).childNodes[0].nodeValue=labels[i];setText("s"+(i+1),vals[i])})}
    function details(title,rows){setText("detail-title",title);rows.forEach((r,i)=>line(i+1,r[0],r[1]))}
    function composition(k,t,c,vals,labels,out){setText("composition-kicker",k);setText("composition-title",t);setText("composition-copy",c);labels.forEach((x,i)=>{const parent=$("#l"+(i+1)+"l");parent.childNodes[0].nodeValue=x;setText("l"+(i+1),out[i])});bars(vals)}
    function art(l,v,c){setText("art-label",l);setText("art-value",v);setText("art-copy",c)}function check(a,b,c,d){["c1","c2","c3","c4"].forEach((id,i)=>setText(id,dop([a,b,c,d][i])))}
    function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$$(".loan").forEach(x=>x.classList.toggle("hide",m!=="loan"));$$(".buying").forEach(x=>x.classList.toggle("hide",m==="owner"||m==="sell"));$$(".sell").forEach(x=>x.classList.toggle("hide",m!=="sell"));setText("price-label",m==="sell"?"Precio de venta":m==="owner"?"Valor total del patrimonio inmobiliario":"Precio del inmueble");calc()}
    $$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Cálculo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar cálculo",1200)};setMode("loan");
  
})();
</script>
<style is:global>

