    .mockup-comprar-vivienda-dominicana .art{height:252px;position:relative;margin-top:20px}.mockup-comprar-vivienda-dominicana .house{position:absolute;left:42px;top:34px;width:245px;height:158px;background:#fff;border:1px solid #d6e2eb;border-radius:12px;box-shadow:0 21px 40px #17385818}.mockup-comprar-vivienda-dominicana .roof{position:absolute;left:25px;top:-49px;width:185px;height:100px;background:#dcecff;clip-path:polygon(50% 0,100% 65%,100% 100%,0 100%,0 65%);border-radius:18px}.mockup-comprar-vivienda-dominicana .door{position:absolute;width:52px;height:82px;background:#286bc0;left:96px;bottom:0;border-radius:22px 22px 0 0}.mockup-comprar-vivienda-dominicana .window{position:absolute;width:44px;height:39px;border-radius:8px;background:#e6f4f1;border:7px solid #fff;bottom:41px}.mockup-comprar-vivienda-dominicana .window.left{left:25px}.mockup-comprar-vivienda-dominicana .window.right{right:25px}.mockup-comprar-vivienda-dominicana .key{position:absolute;right:28px;top:0;font-size:65px;transform:rotate(-15deg);filter:drop-shadow(0 9px 10px #714d1420)}.mockup-comprar-vivienda-dominicana .paper{position:absolute;right:18px;bottom:4px;background:#fff;border:1px solid #d9e4eb;border-radius:13px;padding:15px 18px;box-shadow:0 16px 32px #17385818}.mockup-comprar-vivienda-dominicana .paper small{display:block;font-size:7px;color:#718397}.mockup-comprar-vivienda-dominicana .paper b{display:block;font-size:20px;color:#276bc1;margin:4px 0}.mockup-comprar-vivienda-dominicana .paper span{font-size:8px;color:#63768a}
