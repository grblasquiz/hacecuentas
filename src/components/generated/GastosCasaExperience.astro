---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-gastos-casa" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Hogar / Gastos de la casa</div><div class="eyebrow">Libro mensual del hogar</div><h1>La casa cuesta más que el alquiler.</h1><p class="lead">Ordená gastos fijos, variables y mantenimiento. Ves cuánto cuesta vivir ahí, qué vence primero y qué reserva necesitás.</p></div><div class="floorplan"><div class="room living"><b>Vivienda</b><span id="floorHousing">$700.000</span></div><div class="room kitchen"><b>Consumo</b><span id="floorFood">$420.000</span></div><div class="room service"><b>Servicios</b><span id="floorServices">$180.000</span></div></div></div></section>
<section class="dashboard"><div class="dash"><section class="house-book"><div class="book-head"><div><h2>Libro de agosto</h2><p>Separado por comportamiento, no sólo por proveedor.</p></div><div class="month-switch"><button aria-label="Mes anterior">‹</button><button aria-label="Mes siguiente">›</button></div></div><div class="category"><div class="cat-head"><b>Vivienda</b><span id="housingTotal">$700.000</span><button class="toggle">Fijo</button></div><div class="items"><div class="item"><label for="rent">Alquiler o cuota<small>Pago principal de vivienda.</small></label><input class="amount housing" id="rent" type="number" value="700000" min="0"><output>$700.000</output></div></div></div><div class="category"><div class="cat-head"><b>Servicios</b><span id="servicesTotal">$180.000</span><button class="toggle">Variable</button></div><div class="items"><div class="item"><label for="electricity">Electricidad<small>Compará con meses de clima similar.</small></label><input class="amount services" id="electricity" type="number" value="70000" min="0"><output>$70.000</output></div><div class="item"><label for="gas">Gas y agua</label><input class="amount services" id="gas" type="number" value="65000" min="0"><output>$65.000</output></div><div class="item"><label for="internet">Internet y telefonía</label><input class="amount services" id="internet" type="number" value="45000" min="0"><output>$45.000</output></div></div></div><div class="category"><div class="cat-head"><b>Consumo cotidiano</b><span id="foodTotal">$420.000</span><button class="toggle">Variable</button></div><div class="items"><div class="item"><label for="food">Comida y supermercado</label><input class="amount food" id="food" type="number" value="350000" min="0"><output>$350.000</output></div><div class="item"><label for="cleaning">Limpieza y reposición</label><input class="amount food" id="cleaning" type="number" value="70000" min="0"><output>$70.000</output></div></div></div><div class="category"><div class="cat-head"><b>Mantenimiento y reserva</b><span id="maintenanceTotal">$100.000</span><button class="toggle">Previsión</button></div><div class="items"><div class="item"><label for="maintenance">Arreglos y equipamiento<small>Aunque no se gaste todos los meses.</small></label><input class="amount maintenance" id="maintenance" type="number" value="100000" min="0"><output>$100.000</output></div></div></div></section><aside class="month-summary" aria-live="polite"><h2>Costo real del hogar</h2><div class="big" id="grand">$1.400.000</div><div class="per" id="perPerson">$700.000 por persona</div><div style="margin-top:15px"><label for="people" style="font-size:10px;color:#dceaf0">PERSONAS EN LA CASA</label><input id="people" type="number" value="2" min="1" max="20" style="width:100%;margin-top:5px;border:1px solid #ffffff44;border-radius:9px;background:#ffffff12;color:#fff;padding:9px"></div><div class="split" id="split"></div><div class="reserve" id="reserve">La previsión mensual para mantenimiento representa 7% del costo total.</div></aside></div></section>
<section class="pay-calendar"><div class="wrap cal-grid"><div><div class="kicker">Calendario de vencimientos</div><h2>Distribuí pagos dentro del mes</h2><p>El total importa, pero también importa si todo vence en la misma semana.</p></div><div class="dates"><div class="date"><b>1–5</b><span>Alquiler o cuota y expensas.</span></div><div class="date"><b>6–12</b><span>Tarjetas y servicios principales.</span></div><div class="date"><b>13–20</b><span>Internet, seguros y suscripciones.</span></div><div class="date"><b>21–31</b><span>Reserva de mantenimiento y próximo mes.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-gastos-casa')?document.currentScript.previousElementSibling:document.querySelector('.mockup-gastos-casa');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR");function sum(cls){return $$("."+cls).reduce((s,x)=>s+(+x.value||0),0)}function calc(){const housing=sum("housing"),services=sum("services"),food=sum("food"),maintenance=sum("maintenance"),total=housing+services+food+maintenance,people=Math.max(1,+$("#people").value||1);$("#housingTotal").textContent=money(housing);$("#servicesTotal").textContent=money(services);$("#foodTotal").textContent=money(food);$("#maintenanceTotal").textContent=money(maintenance);$("#floorHousing").textContent=money(housing);$("#floorServices").textContent=money(services);$("#floorFood").textContent=money(food);$("#grand").textContent=money(total);$("#perPerson").textContent=money(total/people)+" por persona";$$(".item").forEach(row=>{const input=row.querySelector("input"),out=row.querySelector("output");out.textContent=money(+input.value||0)});const parts=[["Vivienda",housing,"#f0c76d"],["Servicios",services,"#61b1bf"],["Consumo",food,"#e38a61"],["Reserva",maintenance,"#85c29f"]];$("#split").innerHTML=parts.map(p=>`<div class="part"><span>${p[0]}</span><div class="track"><i style="--w:${total?p[1]/total*100:0}%;--c:${p[2]}"></i></div><b>${total?Math.round(p[1]/total*100):0}%</b></div>`).join("");$("#reserve").textContent=`La previsión mensual para mantenimiento representa ${total?Math.round(maintenance/total*100):0}% del costo total.`}$$("input").forEach(x=>x.addEventListener("input",calc));calc()})();
})();
</script>
<style is:global>

.mockup-gastos-casa{--blue:#174b7a;--terr:#bd6e4e;--peach:#fff0e8;--mint:#e5f2ec;--ink:#182332;--muted:#5f6977;--line:#d9e2e4;--cream:#fff8e2}.mockup-gastos-casa *{box-sizing:border-box}.mockup-gastos-casa{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#f8faf9}.mockup-gastos-casa button,.mockup-gastos-casa input{font:inherit}.mockup-gastos-casa .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-gastos-casa .brand{font-size:19px;font-weight:950}.mockup-gastos-casa .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-gastos-casa .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-gastos-casa .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-gastos-casa .hero{padding:43px 22px 50px;background:#fff}.mockup-gastos-casa .hero-grid,.mockup-gastos-casa .wrap{max-width:1180px;margin:auto}.mockup-gastos-casa .hero-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:58px;align-items:center}.mockup-gastos-casa .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-gastos-casa .eyebrow{margin-top:25px;color:var(--terr);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-gastos-casa .hero h1{font-size:clamp(43px,5vw,65px);line-height:.98;letter-spacing:-.05em;margin:9px 0 18px}.mockup-gastos-casa .lead{font-size:19px;color:var(--muted)}.mockup-gastos-casa .floorplan{display:grid;grid-template-columns:1.2fr .8fr;grid-template-rows:1fr .8fr;width:100%;height:320px;border:7px solid var(--blue);background:#fff;box-shadow:0 22px 50px #17374a18}.mockup-gastos-casa .room{position:relative;border:3px solid var(--blue);padding:18px;display:flex;align-items:end;justify-content:space-between}.mockup-gastos-casa .room b{font-size:14px}.mockup-gastos-casa .room span{font-size:11px;color:var(--muted)}.mockup-gastos-casa .room.living{grid-row:1/3;background:#f4f7f6}.mockup-gastos-casa .room.kitchen{background:var(--peach)}.mockup-gastos-casa .room.service{background:#edf4f7}.mockup-gastos-casa .dashboard{padding:0 22px 70px}.mockup-gastos-casa .dash{max-width:1180px;margin:auto;display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:start}.mockup-gastos-casa .house-book{background:#fff;border:1px solid var(--line);border-radius:22px;overflow:hidden}.mockup-gastos-casa .book-head{padding:22px 24px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;align-items:center}.mockup-gastos-casa .book-head h2{font-size:23px;margin:0}.mockup-gastos-casa .book-head p{font-size:12px;color:var(--muted);margin:3px 0 0}.mockup-gastos-casa .month-switch{display:flex;gap:5px}.mockup-gastos-casa .month-switch button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:8px 10px;cursor:pointer}.mockup-gastos-casa .category{border-top:1px solid var(--line)}.mockup-gastos-casa .cat-head{display:grid;grid-template-columns:1fr auto auto;gap:10px;align-items:center;padding:14px 22px;background:#fafbfa}.mockup-gastos-casa .cat-head b{font-size:14px}.mockup-gastos-casa .cat-head span{font-size:12px;color:var(--muted)}.mockup-gastos-casa .toggle{border:0;background:none;color:var(--blue);font-weight:900;cursor:pointer}.mockup-gastos-casa .items{padding:0 22px}.mockup-gastos-casa .item{display:grid;grid-template-columns:1fr 150px 110px;gap:12px;align-items:center;padding:12px 0;border-top:1px solid #edf0f1}.mockup-gastos-casa .item:first-child{border:0}.mockup-gastos-casa .item label{font-size:13px}.mockup-gastos-casa .item label small{display:block;color:var(--muted);font-size:10px}.mockup-gastos-casa .item input{width:100%;border:1px solid #ccd7da;border-radius:9px;padding:9px 10px;color:var(--ink)}.mockup-gastos-casa .item output{text-align:right;font-weight:900}.mockup-gastos-casa .add-item{margin:10px 0 17px;border:1px dashed #9baeb4;background:#fff;color:var(--blue);border-radius:9px;padding:8px 11px;font-weight:850;cursor:pointer}.mockup-gastos-casa .month-summary{background:var(--blue);color:#fff;border-radius:22px;padding:24px;position:sticky;top:16px}.mockup-gastos-casa .month-summary small{color:#dceaf0}.mockup-gastos-casa .month-summary h2{margin:0 0 17px;font-size:15px;text-transform:uppercase;letter-spacing:.1em;color:#dceaf0}.mockup-gastos-casa .big{font-size:41px;line-height:1;font-weight:950;letter-spacing:-.04em}.mockup-gastos-casa .per{font-size:13px;color:#dceaf0;margin-top:5px}.mockup-gastos-casa .split{display:grid;gap:10px;margin:22px 0}.mockup-gastos-casa .part{display:grid;grid-template-columns:95px 1fr 55px;align-items:center;gap:8px;font-size:10px}.mockup-gastos-casa .track{height:9px;border-radius:99px;background:#ffffff26;overflow:hidden}.mockup-gastos-casa .track i{display:block;height:100%;width:var(--w);background:var(--c);border-radius:99px}.mockup-gastos-casa .part b{text-align:right}.mockup-gastos-casa .reserve{margin-top:18px;padding:13px;border-radius:11px;background:var(--cream);color:#58461f;font-size:12px}.mockup-gastos-casa .pay-calendar{padding:60px 22px;background:#edf4f2}.mockup-gastos-casa .cal-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:42px}.mockup-gastos-casa .kicker{color:var(--terr);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-gastos-casa .pay-calendar h2{font-size:35px;letter-spacing:-.04em;margin:7px 0}.mockup-gastos-casa .pay-calendar p{color:var(--muted)}.mockup-gastos-casa .dates{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.mockup-gastos-casa .date{padding:16px;background:#fff;border:1px solid var(--line);border-radius:14px}.mockup-gastos-casa .date b{display:block;color:var(--terr);margin-bottom:5px}.mockup-gastos-casa .date span{font-size:12px;color:var(--muted)}.mockup-gastos-casa .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:880px){.mockup-gastos-casa .nav{display:none}.mockup-gastos-casa .hero-grid,.mockup-gastos-casa .dash,.mockup-gastos-casa .cal-grid{grid-template-columns:1fr}.mockup-gastos-casa .month-summary{position:static}.mockup-gastos-casa .floorplan{max-width:650px}.mockup-gastos-casa .dates{grid-template-columns:1fr 1fr}}@media(max-width:580px){.mockup-gastos-casa .hero h1{font-size:42px}.mockup-gastos-casa .item{grid-template-columns:1fr 110px}.mockup-gastos-casa .item output{grid-column:2}.mockup-gastos-casa .dates{grid-template-columns:1fr}}

.mockup-gastos-casa { width:100%; overflow:hidden; }
.mockup-gastos-casa .top, .mockup-gastos-casa header.top { display:none !important; }
.mockup-gastos-casa .foot { display:none !important; }
.mockup-gastos-casa .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-gastos-casa .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-gastos-casa .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-gastos-casa .support-real summary { cursor:pointer; font-weight:750; }
.mockup-gastos-casa .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-gastos-casa :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-gastos-casa input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-gastos-casa input[type="number"]::-webkit-inner-spin-button, .mockup-gastos-casa input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-gastos-casa .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-gastos-casa support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
