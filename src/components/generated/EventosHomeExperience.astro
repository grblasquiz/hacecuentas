---
---
<div class="mockup-eventos-home" set:html={`
      <div class="hero">
        <div class="wrap">
          <div class="crumb">Inicio / Eventos</div>
          <div class="heroGrid">
            <div>
              <span class="eyebrow">Planificá sin comprar de más</span>
              <h1>Que alcance para todos. Y no sobre una fiesta entera.</h1>
              <p class="lead">
                Calculá comida, bebidas, hielo y presupuesto según invitados,
                duración y tipo de evento. Todo en un mismo plan.
              </p>
              <div class="trust">
                <span>✓ Adultos y menores</span><span>✓ Margen incluido</span
                ><span>✓ Todos los casos visibles</span>
              </div>
              <div class="eventScene">
                <div class="sceneTable">
                  <i class="scenePlate p1"></i><i class="scenePlate p2"></i
                  ><i class="scenePlate p3"></i><i class="scenePlate p4"></i
                  ><i class="sceneGlass g1"></i><i class="sceneGlass g2"></i
                  ><i class="sceneCake"><b>45</b></i
                  ><i class="sceneFork f1"></i><i class="sceneFork f2"></i>
                </div>
                <div class="guestCard">
                  <small>PLAN PARA</small><strong>45 invitados</strong
                  ><span>comida · bebidas · hielo</span>
                </div>
              </div>
            </div>
            <div class="planner">
              <div class="plannerHead">
                <div>
                  <h2>Armá tu evento</h2>
                  <p>Cambiá los datos y actualizamos todo.</p>
                </div>
                <span class="live">PLAN EN VIVO</span>
              </div>
              <div class="eventTypes">
                <button class="eventType active" data-event="birthday">
                  Cumpleaños</button
                ><button class="eventType" data-event="meeting">Reunión</button
                ><button class="eventType" data-event="wedding">
                  Casamiento</button
                ><button class="eventType" data-event="corporate">
                  Corporativo
                </button>
              </div>
              <div class="fields">
                <div class="field">
                  <label>Invitados adultos</label>
                  <div class="input">
                    <input id="adults" type="number" min="1" value="35" /><span
                      >personas</span
                    >
                  </div>
                </div>
                <div class="field">
                  <label>Menores</label>
                  <div class="input">
                    <input id="kids" type="number" min="0" value="10" /><span
                      >personas</span
                    >
                  </div>
                </div>
                <div class="field">
                  <label>Duración</label>
                  <div class="input">
                    <input
                      id="hours"
                      type="number"
                      min="1"
                      max="12"
                      value="5"
                    /><span>horas</span>
                  </div>
                </div>
                <div class="field">
                  <label>Comida principal</label
                  ><select id="foodType">
                    <option value="mixed">Picada + comida</option>
                    <option value="finger">Solo finger food</option>
                    <option value="meal">Plato principal</option>
                    <option value="empanadas">Empanadas</option>
                  </select>
                </div>
                <div class="field">
                  <label>Consumo de alcohol</label
                  ><select id="alcohol">
                    <option value=".6">Moderado</option>
                    <option value="1">Alto</option>
                    <option value="0">Sin alcohol</option>
                  </select>
                </div>
                <div class="field">
                  <label>Margen de seguridad</label
                  ><select id="margin">
                    <option value="1.1">10%</option>
                    <option value="1.15" selected>15%</option>
                    <option value="1.2">20%</option>
                  </select>
                </div>
              </div>
              <button class="primary" id="calculate">
                Actualizar cantidades
              </button>
              <div class="result">
                <small
                  >PLAN PARA <span id="guestTotal">45</span> INVITADOS</small
                >
                <div class="amount" id="headline">
                  Comida para 40 adultos equivalentes
                </div>
                <div class="resultGrid">
                  <div class="metric">
                    <span>COMIDA TOTAL</span><b id="food">18,4 kg</b>
                  </div>
                  <div class="metric">
                    <span>BEBIDAS</span><b id="drinks">69 L</b>
                  </div>
                  <div class="metric">
                    <span>HIELO</span><b id="ice">23 kg</b>
                  </div>
                  <div class="metric">
                    <span>MARGEN</span><b id="marginText">15% incluido</b>
                  </div>
                </div>
                <p class="note" id="note">
                  Incluye bebidas con y sin alcohol; el desglose se ajusta por
                  duración.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <section>
        <div class="wrap">
          <div class="sectionHead">
            <span class="eyebrow">Empezá por el momento</span>
            <h2>¿Qué parte necesitás resolver?</h2>
            <p>
              Elegí una necesidad y mostramos primero las herramientas
              adecuadas.
            </p>
          </div>
          <div class="moments">
            <button class="moment active" data-filter="food">
              <span class="icon">♨</span>
              <h3>Comida para todos</h3>
              <p>Porciones, menú, empanadas y guarniciones.</p>
              <em>→</em></button
            ><button class="moment" data-filter="drinks">
              <span class="icon">◫</span>
              <h3>Bebidas y hielo</h3>
              <p>Alcohol, agua, gaseosa, vino y hielo.</p>
              <em>→</em></button
            ><button class="moment" data-filter="budget">
              <span class="icon">$</span>
              <h3>Presupuesto total</h3>
              <p>Costo por invitado y distribución por rubro.</p>
              <em>→</em></button
            ><button class="moment" data-filter="planning">
              <span class="icon">▦</span>
              <h3>Organización</h3>
              <p>Mesas, tiempos, compras y contingencias.</p>
              <em>→</em>
            </button>
          </div>
        </div>
      </section>
      <section class="tint" id="tools">
        <div class="wrap">
          <div class="sectionHead">
            <span class="eyebrow">Herramientas para eventos</span>
            <h2>Cada compra, respaldada por una cuenta.</h2>
          </div>
          <div class="toolbar">
            <div class="filters">
              <button class="filter active" data-filter="all">Todas</button
              ><button class="filter" data-filter="food">Comida</button
              ><button class="filter" data-filter="drinks">Bebidas</button
              ><button class="filter" data-filter="budget">Presupuesto</button
              ><button class="filter" data-filter="planning">
                Organización
              </button>
            </div>
            <input
              class="search"
              id="search"
              placeholder="Buscar una herramienta…"
            />
          </div>
          <div class="cards">
            <article
              class="card featured"
              data-cat="food budget planning"
              data-text="comida evento invitados menú porciones presupuesto"
            >
              <span class="tag">Plan completo</span>
              <h3>Comida para un evento</h3>
              <p>
                Entradas, principal, guarnición, postre y margen para todos los
                invitados.
              </p>
              <a class="hc-tool-link" href="/eventos/comida">Calcular comida →</a>
            </article>
            <article
              class="card"
              data-cat="drinks budget"
              data-text="bebidas alcohol vino cerveza gaseosa agua hielo"
            >
              <span class="tag">Bebidas</span>
              <h3>Bebidas para una fiesta</h3>
              <p>Desglose por tipo, duración, clima y consumo.</p>
              <a class="hc-tool-link" href="/eventos/bebidas">Calcular bebidas →</a>
            </article>
            <article
              class="card"
              data-cat="food"
              data-text="empanadas guarniciones invitados sabores"
            >
              <span class="tag">Menú</span>
              <h3>Empanadas y guarniciones</h3>
              <p>Cantidad por persona, sabores y acompañamientos.</p>
              <a class="hc-tool-link" href="/eventos/empanadas-y-guarniciones">Calcular →</a>
            </article>
            <article
              class="card"
              data-cat="food drinks"
              data-text="asado carne bebida ensalada pan"
            >
              <span class="tag">Reuniones</span>
              <h3>Asado para invitados</h3>
              <p>Carne, achuras, pan, ensalada, bebida y hielo.</p>
              <a class="hc-tool-link" href="/eventos/asado">Calcular →</a>
            </article>
            <article
              class="card"
              data-cat="budget"
              data-text="presupuesto evento costo invitado salón comida bebida"
            >
              <span class="tag">Costo</span>
              <h3>Presupuesto por invitado</h3>
              <p>Distribuí salón, comida, bebida, música y extras.</p>
              <a class="hc-tool-link" href="/eventos/presupuesto">Armar presupuesto →</a>
            </article>
            <article
              class="card"
              data-cat="planning"
              data-text="mesas sillas invitados distribución evento"
            >
              <span class="tag">Espacio</span>
              <h3>Mesas y capacidad</h3>
              <p>Distribución según invitados y formato del salón.</p>
              <a class="hc-tool-link" href="/eventos/logistica">Planificar →</a>
            </article>
            <div class="empty" id="empty">
              No encontramos una herramienta con esa búsqueda.
            </div>
          </div>
        </div>
      </section>
      <section>
        <div class="wrap">
          <div class="sectionHead">
            <span class="eyebrow">Un orden que evita olvidos</span>
            <h2>Del número de invitados a la lista de compras.</h2>
          </div>
          <div class="timeline">
            <article class="step">
              <span class="num">1</span>
              <h3>Confirmá personas</h3>
              <p>Separá adultos, menores y restricciones alimentarias.</p>
            </article>
            <article class="step">
              <span class="num">2</span>
              <h3>Definí el formato</h3>
              <p>Sentados, buffet, finger food o comida principal.</p>
            </article>
            <article class="step">
              <span class="num">3</span>
              <h3>Calculá cantidades</h3>
              <p>Usá duración, clima y horario para ajustar.</p>
            </article>
            <article class="step">
              <span class="num">4</span>
              <h3>Sumá un margen</h3>
              <p>Entre 10% y 15% suele cubrir cambios razonables.</p>
            </article>
          </div>
        </div>
      </section>
    <button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-eventos-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-eventos-home');if(!root)return;

      const $ = (s) => root.querySelector(s),
        $$ = (s) => [...root.querySelectorAll(s)];
      let event = "birthday";
      function calc() {
        const a = Math.max(1, Number($("#adults").value) || 1),
          k = Math.max(0, Number($("#kids").value) || 0),
          h = Math.max(1, Number($("#hours").value) || 1),
          m = Number($("#margin").value),
          alc = Number($("#alcohol").value),
          equiv = a + k * 0.5,
          foodRates = { mixed: 0.4, finger: 0.32, meal: 0.45, empanadas: 0.36 },
          food = equiv * foodRates[$("#foodType").value] * m,
          soft = equiv * (0.65 + 0.12 * h) * m,
          alcohol = a * alc * (0.35 + 0.1 * h) * m,
          drinks = soft + alcohol,
          ice = Math.ceil((drinks * 0.25 + a * 0.15) * m);
        $("#guestTotal").textContent = a + k;
        $("#headline").textContent =
          "Comida para " + Math.round(equiv) + " adultos equivalentes";
        $("#food").textContent =
          food.toLocaleString("es-AR", { maximumFractionDigits: 1 }) + " kg";
        $("#drinks").textContent = Math.ceil(drinks) + " L";
        $("#ice").textContent = ice + " kg";
        $("#marginText").textContent = Math.round((m - 1) * 100) + "% incluido";
        $("#note").textContent = alc
          ? "Incluye bebidas con y sin alcohol; el desglose se ajusta por duración."
          : "El plan no incluye alcohol y refuerza agua y bebidas sin alcohol.";
      }
      $$(".planner input,.planner select").forEach((x) => (x.oninput = calc));
      $$(".eventType").forEach(
        (b) =>
          (b.onclick = () => {
            event = b.dataset.event;
            $$(".eventType").forEach((x) =>
              x.classList.toggle("active", x === b),
            );
            const defaults = {
              birthday: [35, 10, 5],
              meeting: [20, 5, 4],
              wedding: [90, 10, 8],
              corporate: [70, 0, 6],
            }[event];
            $("#adults").value = defaults[0];
            $("#kids").value = defaults[1];
            $("#hours").value = defaults[2];
            calc();
          }),
      );
      $("#calculate").onclick = (e) => {
        calc();
        const t = e.currentTarget.textContent;
        e.currentTarget.textContent = "✓ Cantidades actualizadas";
        setTimeout(() => (e.currentTarget.textContent = t), 1100);
      };
      function filter(cat = "all") {
        const q = $("#search").value.toLowerCase().trim();
        let n = 0;
        $$(".card").forEach((c) => {
          const ok =
            (cat === "all" || c.dataset.cat.includes(cat)) &&
            (!q || c.dataset.text.includes(q));
          c.style.display = ok ? "" : "none";
          if (ok) n++;
        });
        $("#empty").style.display = n ? "none" : "block";
      }
      $$(".filter").forEach(
        (b) =>
          (b.onclick = () => {
            $$(".filter").forEach((x) => x.classList.toggle("active", x === b));
            filter(b.dataset.filter);
          }),
      );
      $("#search").oninput = () => filter($(".filter.active").dataset.filter);
      $$(".moment").forEach(
        (b) =>
          (b.onclick = () => {
            $$(".moment").forEach((x) => x.classList.toggle("active", x === b));
            const f = b.dataset.filter,
              t = $$(".filter").find((x) => x.dataset.filter === f);
            $$(".filter").forEach((x) => x.classList.toggle("active", x === t));
            filter(f);
            $("#tools").scrollIntoView({ behavior: "smooth" });
          }),
      );
      function toast(t) {
        $("#toast").textContent = "Abriendo: " + t;
        $("#toast").classList.add("show");
        setTimeout(() => $("#toast").classList.remove("show"), 1500);
      }
      $$(".card button").forEach(
        (b) =>
          (b.onclick = () =>
            toast(b.closest(".card").querySelector("h3").textContent)),
      );
      calc();

})();
</script>
<style is:global>

      .mockup-eventos-home {
        --ink: #14213d;
        --muted: #68758a;
        --line: #e2e3e5;
        --paper: #faf9f7;
        --coral: #e96f5a;
        --peach: #fff0ea;
        --purple: #7658d5;
        --lilac: #eeeaff;
        --green: #14765b;
        --navy: #174B7A;
        --yellow: #f5ce6b;
        --white: #fff;
