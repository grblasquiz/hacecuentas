---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-sueldo-bruto-neto" set:html={`
    <section class="hero"><div class="wrap crumb"><b>Trabajo</b> &nbsp;/&nbsp; Sueldo bruto y neto</div><div class="wrap hero-grid">
      <div class="copy"><span class="eyebrow">Calculadora de sueldo 2026</span><h1>Del sueldo bruto<br>al dinero que<br>te queda en mano.</h1><p>Calculá tu neto, entendé cada descuento del recibo y compará cuánto cambia según tu situación.</p><div class="chips"><span>✓ Aportes con tope SIPA</span><span>🏛️ Ganancias 2026</span><span>🔒 Sin guardar datos</span></div>
        <div class="salary-art"><div class="payslip"><div class="slip-top"><b>Recibo de sueldo</b><span>julio 2026</span></div><div class="slip-gross">De un bruto de $1.500.000 te quedan</div><div class="slip-net">$1.245.000 <small>en mano</small></div><div class="slip-line"><span>Descuentos estimados</span><strong>−$255.000</strong></div></div><span class="discount-tag">17% de aportes</span><div class="stamp">NETO<br>ESTIMADO</div></div>
      </div>
      <form class="calc"><div class="calc-title"><div><h2>Calculá tu sueldo</h2><p>Empezamos del bruto al neto.</p></div><span class="tag">Valores vigentes</span></div>
        <div class="section-label">¿Qué necesitás calcular?</div><div class="cases"><button type="button" class="case active" data-case="bruto"><i>💼</i>Bruto a neto</button><button type="button" class="case" data-case="neto"><i>🎯</i>Neto a bruto</button><button type="button" class="case" data-case="recibo"><i>🧾</i>Recibo completo</button><button type="button" class="case" data-case="mono"><i>🚀</i>Monotributista</button></div>
        <div class="section-label">Tus datos</div><div class="fields"><div class="field wide"><label id="amount-label">Sueldo bruto mensual</label><div class="inline"><b>$</b><input id="amount" value="1.500.000" inputmode="numeric"></div></div><div class="field"><label>Cónyuge a cargo</label><select id="spouse"><option value="no">No</option><option value="si">Sí</option></select></div><div class="field"><label>Hijos a cargo</label><div class="inline"><input id="children" type="number" min="0" max="10" value="0"><b>hijos</b></div></div><div class="field"><label>Cuota sindical</label><div class="inline"><input id="union" type="number" min="0" max="10" step=".5" value="0"><b>%</b></div></div><div class="field"><label>Otros descuentos</label><div class="inline"><b>$</b><input id="other" value="0" inputmode="numeric"></div></div></div>
        <div class="advanced"><span>✓ Tope previsional aplicado</span><b id="fineTune">+ Afinar cálculo</b></div><section class="result"><div class="result-top"><div><small id="result-label">Sueldo neto estimado</small><div class="price" id="result-price">$1.245.000</div></div><div class="percent"><small>Te queda</small><strong id="result-percent">83%</strong></div></div><div class="stats"><span>Aportes obligatorios<b id="stat-contrib">−$255.000</b></span><span>Otros descuentos<b id="stat-other">$0</b></span><span>Costo empleador<b id="stat-cost">$1.875.000</b></span></div><button class="go" type="button">Actualizar sueldo</button></section>
      </form>
    </div></section>
    <section class="detail wrap"><header class="center"><span>Tu recibo, sin letra chica</span><h2>Entendé adónde va cada peso</h2><p>El neto no es un porcentaje fijo: depende de aportes, topes, Ganancias y descuentos de convenio.</p></header><div class="detail-grid">
      <article class="card"><h3 id="detail-title">De $1.500.000 bruto a tu bolsillo</h3><div class="row"><span>💼 Sueldo bruto</span><div class="bar"><i style="width:100%"></i></div><b id="detail-gross">$1.500.000</b></div><div class="row"><span>− Jubilación 11%</span><div class="bar"><i style="width:11%"></i></div><b id="detail-ret">−$165.000</b></div><div class="row"><span>− Obra social 3%</span><div class="bar"><i style="width:3%"></i></div><b id="detail-os">−$45.000</b></div><div class="row"><span>− PAMI 3%</span><div class="bar"><i style="width:3%"></i></div><b id="detail-pami">−$45.000</b></div><div class="row"><span>− Sindicato y otros</span><div class="bar"><i style="width:0%"></i></div><b id="detail-other">$0</b></div><div class="total"><strong>Neto en mano</strong><strong id="detail-net">$1.245.000</strong></div></article>
      <article class="card wallet"><h3>La foto rápida de tu sueldo</h3><div class="wallet-visual"><div class="coin big">83%</div><div class="coin small">−17%</div></div><div class="wallet-note"><i>💡</i><span>Hasta este nivel salarial, el descuento principal son los aportes personales. Si el bruto sube, puede aparecer Ganancias y también actuar el tope SIPA.</span></div><div class="ratio"><div><small>Por cada $100 brutos</small><b>$83 en mano</b></div><div><small>Descuentos</small><b>$17</b></div></div></article>
    </div></section>
    <section class="cases-section"><div class="wrap"><div class="cases-head"><div><span>Todos los casos</span><h2>Cuatro respuestas, según lo que necesitás</h2></div><div class="legend">Podés cambiar de caso sin perder tus datos</div></div><div class="case-grid">
      <article class="answer active" data-jump="bruto" role="button" tabindex="0"><i>💼</i><h3>Tengo el bruto</h3><p>Ingresá lo que figura arriba de tu recibo y calculá cuánto vas a cobrar.</p><b id="card-bruto">$1.245.000</b><span>Neto estimado</span></article>
      <article class="answer" data-jump="neto" role="button" tabindex="0"><i>🎯</i><h3>Quiero cobrar un neto</h3><p>Partí del monto que querés recibir y descubrí qué bruto deberían ofrecerte.</p><b id="card-neto">$1.445.783</b><span>Bruto necesario para el objetivo</span></article>
      <article class="answer" data-jump="recibo" role="button" tabindex="0"><i>🧾</i><h3>Quiero el recibo completo</h3><p>Sumá aportes y descuentos de convenio concepto por concepto.</p><b>Concepto por concepto</b><span>Liquidación mensual detallada</span></article>
      <article class="answer" data-jump="mono" role="button" tabindex="0"><i>🚀</i><h3>Soy monotributista</h3><p>Restá cuota estimada, Ingresos Brutos y gastos para estimar tu disponible.</p><b id="card-mono">$1.380.610</b><span>Disponible sobre lo facturado</span></article>
    </div></div></section>
    <section class="employer"><div class="wrap employer-grid"><div class="employer-copy"><span>La otra mitad del recibo</span><h2>Tu sueldo cuesta más que el bruto</h2><p>Además de tu remuneración, el empleador paga contribuciones patronales. Ver las tres cifras juntas ayuda a negociar mejor una oferta.</p></div><div class="cost-stack"><div class="cost-row"><label>Costo total</label><div class="track"><i></i></div><b>$1.875.000</b></div><div class="cost-row"><label>Sueldo bruto</label><div class="track"><i></i></div><b>$1.500.000</b></div><div class="cost-row"><label>Contribuciones</label><div class="track"><i></i></div><b>$375.000</b></div></div></div></section><div class="foot"></div>
  `} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sueldo-bruto-neto')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sueldo-bruto-neto');

    const $=id=>root.querySelector("#"+id),CAP=4414652.38;let activeCase="bruto";
    const money=n=>"$"+Math.round(Math.max(0,n||0)).toLocaleString("es-AR");
    const value=id=>Math.max(0,Number(String($(id).value).replace(/\./g,"").replace(",", "."))||0);
    function formatInput(el){const n=String(el.value).replace(/\D/g,"");el.value=n?Number(n).toLocaleString("es-AR"):"0"}
    function employeeNet(gross){const union=Math.max(0,+$("union").value||0)/100,other=value("other"),base=Math.min(gross,CAP),ret=base*.11,os=base*.03,pami=base*.03,extra=gross*union+other;return{gross,ret,os,pami,extra,contrib:ret+os+pami,net:Math.max(0,gross-ret-os-pami-extra),cost:gross*1.264}}
    function grossForNet(target){let gross=target;for(let i=0;i<30;i++){const c=employeeNet(gross);gross+=target-c.net}return gross}
    function calculate(show=false){
      const amount=value("amount"),union=Math.max(0,+$("union").value||0)/100,other=value("other");let c,label,price,pct;
      if(activeCase==="neto"){const gross=grossForNet(amount);c=employeeNet(gross);label="Bruto necesario estimado";price=money(gross);pct="Objetivo"}
      else if(activeCase==="mono"){const iibb=amount*.035,cuota=Math.max(45000,amount*.025),available=Math.max(0,amount-iibb-cuota-other);c={gross:amount,ret:0,os:0,pami:0,extra:iibb+cuota+other,contrib:0,net:available,cost:amount};label="Ingreso disponible estimado";price=money(available);pct=Math.round(available/Math.max(1,amount)*100)+"%"}
      else{c=employeeNet(amount);label=activeCase==="recibo"?"Total neto del recibo":"Sueldo neto estimado";price=money(c.net);pct=Math.round(c.net/Math.max(1,c.gross)*100)+"%"}
      $("result-label").textContent=label;$("result-price").textContent=price;$("result-percent").textContent=pct;$("stat-contrib").textContent=c.contrib?"−"+money(c.contrib):"$0";$("stat-other").textContent=c.extra?"−"+money(c.extra):"$0";$("stat-cost").textContent=money(c.cost);
      $("detail-title").textContent=`De ${money(c.gross)} bruto a tu bolsillo`;$("detail-gross").textContent=money(c.gross);$("detail-ret").textContent=c.ret?"−"+money(c.ret):"$0";$("detail-os").textContent=c.os?"−"+money(c.os):"$0";$("detail-pami").textContent=c.pami?"−"+money(c.pami):"$0";$("detail-other").textContent=c.extra?"−"+money(c.extra):"$0";$("detail-net").textContent=money(c.net);
      $("card-bruto").textContent=money(employeeNet(amount).net);$("card-neto").textContent=money(grossForNet(amount));$("card-mono").textContent=money(Math.max(0,amount-amount*.035-Math.max(45000,amount*.025)-other));
      if(show){const b=root.querySelector(".go");b.textContent="✓ Cálculo actualizado";setTimeout(()=>b.textContent="Actualizar sueldo",1200)}
    }
    function setCase(id){activeCase=id;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x.dataset.case===id));root.querySelectorAll(".answer").forEach(x=>x.classList.toggle("active",x.dataset.jump===id));$("amount-label").textContent=id==="neto"?"Neto que querés cobrar":id==="mono"?"Facturación mensual":"Sueldo bruto mensual";calculate()}
    root.querySelectorAll(".case").forEach(btn=>btn.addEventListener("click",()=>setCase(btn.dataset.case)));
    root.querySelectorAll(".answer").forEach(card=>{card.addEventListener("click",()=>{setCase(card.dataset.jump);root.querySelector(".calc").scrollIntoView({block:"center"})});card.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();card.click()}})});
    ["amount","other"].forEach(id=>$(id).addEventListener("input",()=>{formatInput($(id));calculate()}));["spouse","children","union"].forEach(id=>$(id).addEventListener("input",()=>calculate()));
    root.querySelector(".go").addEventListener("click",()=>calculate(true));$("fineTune").addEventListener("click",()=>{$("union").focus();$("fineTune").textContent="Ajustá sindicato y otros descuentos"});
    calculate();
  
})();
</script>
