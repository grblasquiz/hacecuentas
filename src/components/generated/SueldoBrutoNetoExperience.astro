t{background:#17324f;color:#fff;border-radius:15px;padding:18px 20px}.mockup-sueldo-bruto-neto .result-top{display:flex;align-items:start;justify-content:space-between}.mockup-sueldo-bruto-neto .result small{font-size:9px;color:#b9cbdd}.mockup-sueldo-bruto-neto .price{font-size:34px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.mockup-sueldo-bruto-neto .percent{background:#dff5f1;color:#08776d;border-radius:9px;padding:8px 11px;text-align:right}.mockup-sueldo-bruto-neto .percent strong{display:block;font-size:15px}.mockup-sueldo-bruto-neto .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #375675;padding-top:12px;margin-top:13px}.mockup-sueldo-bruto-neto .stats span{font-size:8px;color:#afc0d1}.mockup-sueldo-bruto-neto .stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.mockup-sueldo-bruto-neto .go{width:100%;border:0;border-radius:9px;background:#0a9587;color:#fff;font-weight:800;padding:12px;margin-top:14px;cursor:pointer}
