---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-costo-bebe" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Familia / Costo de un bebé</div><div class="eyebrow">Presupuesto del primer año</div><h1>Prepará el bolsillo sin comprar todo de golpe.</h1><p class="lead">Separá lo que se compra una vez de lo que vuelve todos los meses. Ves qué cambia en cada etapa y dónde está la decisión grande.</p><div class="trust"><span>Compras iniciales separadas</span><span>0 a 12 meses</span><span>Cuidado y alimentación visibles</span></div></div><div class="mobile"><div class="arch"></div><span class="string a"><i></i></span><span class="string b"><i></i></span><span class="string c"><i></i></span><div class="crib"></div></div></div></section>
<section class="budget"><div class="wrap"><div class="budget-intro"><div><div class="kicker">Tu etapa, tus números</div><h2>Armá el primer año</h2></div><p>No usamos un gasto promedio único: el costo cambia especialmente por cuidado, alimentación y cuánto equipamiento ya tenés.</p></div><div class="stage-tabs"><button class="stage active" data-stage="arrival"><b>Antes de que llegue</b><small>Equipamiento y preparación.</small></button><button class="stage" data-stage="newborn"><b>0 a 3 meses</b><small>Mayor frecuencia de consumo.</small></button><button class="stage" data-stage="middle"><b>4 a 6 meses</b><small>Cambios y primeras rutinas.</small></button><button class="stage" data-stage="older"><b>7 a 12 meses</b><small>Comida, movilidad y cuidado.</small></button></div><div class="planner"><section class="ledger"><div class="ledger-head"><h3 id="stageTitle">Preparar la llegada</h3><span>Mové cantidades y precios</span></div><div class="row"><label for="equipment">Equipamiento inicial<small>Cuna, cochecito, silla, bañera y ropa.</small></label><input id="equipment" type="number" value="1200000" min="0" step="10000"><output id="equipmentOut">$1.200.000</output></div><div class="row"><label for="diapers">Pañales por día<small>Se multiplica por 30 días.</small></label><input id="diapers" type="number" value="8" min="0" max="20"><output id="diapersOut">240/mes</output></div><div class="row"><label for="diaperPrice">Precio por pañal<small>Usá el precio real del paquete.</small></label><input id="diaperPrice" type="number" value="650" min="0"><output id="diaperPriceOut">$156.000</output></div><div class="row"><label for="feeding">Alimentación mensual<small>Fórmula, lactancia mixta o accesorios.</small></label><input id="feeding" type="number" value="120000" min="0" step="5000"><output id="feedingOut">$120.000</output></div><div class="row"><label for="care">Cuidado mensual<small>Guardería, niñera o ayuda familiar paga.</small></label><input id="care" type="number" value="0" min="0" step="10000"><output id="careOut">$0</output></div><div class="row"><label for="health">Salud y farmacia<small>Copagos, higiene y medicamentos frecuentes.</small></label><input id="health" type="number" value="80000" min="0" step="5000"><output id="healthOut">$80.000</output></div><div class="row"><label for="income">Ingreso familiar mensual<small>Para medir impacto, no elegibilidad.</small></label><input id="income" type="number" value="2500000" min="1" step="10000"><output id="incomeOut">$2.500.000</output></div></section><aside class="summary" aria-live="polite"><span class="badge" id="badge">Preparación inicial</span><div class="total" id="monthly">$356.000</div><small>gasto mensual de esta etapa</small><div class="split"><div class="mini"><small>COMPRA ÚNICA</small><b id="oneTime">$1.200.000</b></div><div class="mini"><small>PRIMER AÑO</small><b id="year">$5.472.000</b></div></div><div class="impact"><i id="impact"></i></div><small id="impactText">14% del ingreso mensual</small><div class="summary-note" id="note">Antes de comprar, separá seguridad de conveniencia. Cuna y silla para el auto requieren especial atención; mucha ropa y accesorios pueden esperar.</div></aside></div></div></section>
<section class="timeline"><div class="wrap timeline-grid"><div><div class="kicker">Cuándo aparecen los gastos</div><h2>No todo se paga el mismo mes</h2><p>Planificá por hitos para evitar que las compras iniciales, la licencia y el comienzo del cuidado se superpongan.</p></div><div class="months"><div class="month"><span>−2</span><b>Preparar</b><small>Seguridad, descanso, traslado y ropa básica.</small></div><div class="month"><span>1</span><b>Ajustar</b><small>Probá cantidades antes de stockear pañales o fórmula.</small></div><div class="month"><span>4</span><b>Rutinas</b><small>Revisá cuidado y retorno al trabajo.</small></div><div class="month"><span>7</span><b>Movimiento</b><small>Alimentación, seguridad de la casa y movilidad.</small></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-costo-bebe')?document.currentScript.previousElementSibling:document.querySelector('.mockup-costo-bebe');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR");let stage="arrival";const presets={arrival:[8,120000,0,80000,"Preparar la llegada","Preparación inicial"],newborn:[9,200000,0,100000,"Primeros tres meses","Consumo más frecuente"],middle:[7,160000,250000,90000,"De 4 a 6 meses","Rutina en transición"],older:[6,180000,350000,110000,"De 7 a 12 meses","Más comida y cuidado"]};function calc(){const eq=+$("[id=equipment]").value||0,diapers=+$("[id=diapers]").value||0,dp=+$("[id=diaperPrice]").value||0,feed=+$("[id=feeding]").value||0,care=+$("[id=care]").value||0,health=+$("[id=health]").value||0,income=Math.max(1,+$("[id=income]").value||1),diaperMonth=diapers*30*dp,monthly=diaperMonth+feed+care+health,year=eq+monthly*12,impact=monthly/income*100;$("#equipmentOut").textContent=money(eq);$("#diapersOut").textContent=diapers*30+"/mes";$("#diaperPriceOut").textContent=money(diaperMonth);$("#feedingOut").textContent=money(feed);$("#careOut").textContent=money(care);$("#healthOut").textContent=money(health);$("#incomeOut").textContent=money(income);$("#monthly").textContent=money(monthly);$("#oneTime").textContent=money(eq);$("#year").textContent=money(year);$("#impact").style.setProperty("--w",Math.min(100,impact)+"%");$("#impactText").textContent=Math.round(impact)+"% del ingreso mensual";$("#note").textContent=impact>35?"El gasto mensual queda muy alto para el ingreso informado. Revisá alternativas de cuidado, equipamiento prestado y compras escalonadas.":stage==="arrival"?"Antes de comprar, separá seguridad de conveniencia. Cuna y silla para el auto requieren especial atención; mucha ropa y accesorios pueden esperar.":"No compres todo para seis meses con precios de hoy: primero observá qué usa realmente y cómo cambia su rutina."}$$("input").forEach(x=>x.addEventListener("input",calc));$$("[data-stage]").forEach(b=>b.addEventListener("click",()=>{stage=b.dataset.stage;$$("[data-stage]").forEach(x=>x.classList.toggle("active",x===b));const p=presets[stage];$("#diapers").value=p[0];$("#feeding").value=p[1];$("#care").value=p[2];$("#health").value=p[3];$("#stageTitle").textContent=p[4];$("#badge").textContent=p[5];calc()}));calc()})();
})();
</script>
<style is:global>

.mockup-costo-bebe{--blue:#174b7a;--coral:#d56f72;--peach:#fff0ed;--mint:#dcefe7;--cream:#fff8e7;--ink:#182332;--muted:#5e6876;--line:#dce3e5}.mockup-costo-bebe *{box-sizing:border-box}.mockup-costo-bebe{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fbfcfb}.mockup-costo-bebe button,.mockup-costo-bebe input,.mockup-costo-bebe select{font:inherit}.mockup-costo-bebe .head{height:74px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:28px;padding:0 max(22px,calc((100% - 1180px)/2))}.mockup-costo-bebe .brand{font-size:19px;font-weight:950}.mockup-costo-bebe .brand b{display:inline-grid;place-items:center;width:36px;height:36px;border-radius:9px;background:var(--blue);color:#fff;margin-right:10px}.mockup-costo-bebe .nav{display:flex;gap:25px;color:#4e5967;font-size:14px;font-weight:750}.mockup-costo-bebe .search{margin-left:auto;border:1px solid var(--line);border-radius:11px;background:#fff;padding:10px 15px}.mockup-costo-bebe .hero{padding:48px 22px 58px;background:linear-gradient(110deg,#fff 0 68%,var(--peach) 68%)}.mockup-costo-bebe .hero-grid,.mockup-costo-bebe .wrap{max-width:1180px;margin:auto}.mockup-costo-bebe .hero-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:58px;align-items:center}.mockup-costo-bebe .crumb{color:var(--blue);font-size:14px;font-weight:850}.mockup-costo-bebe .eyebrow{margin-top:26px;color:var(--coral);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-costo-bebe .hero h1{font-size:clamp(44px,5vw,68px);line-height:.98;letter-spacing:-.05em;margin:10px 0 19px}.mockup-costo-bebe .lead{font-size:19px;color:var(--muted);max-width:660px}.mockup-costo-bebe .trust{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-costo-bebe .trust span{padding:8px 12px;border:1px solid var(--line);border-radius:99px;background:#fff;font-size:13px;font-weight:800}.mockup-costo-bebe .mobile{width:420px;max-width:100%;height:330px;margin:auto;position:relative}.mockup-costo-bebe .arch{position:absolute;left:50%;top:8px;width:250px;height:250px;border:9px solid var(--blue);border-bottom:0;border-radius:140px 140px 0 0;transform:translateX(-50%)}.mockup-costo-bebe .string{position:absolute;top:65px;width:3px;background:var(--blue);transform-origin:top}.mockup-costo-bebe .string i{position:absolute;left:50%;bottom:-25px;width:48px;height:48px;border-radius:50%;background:var(--coral);transform:translateX(-50%);box-shadow:0 9px 20px #8c45451f}.mockup-costo-bebe .string.a{left:30%;height:105px;transform:rotate(-10deg)}.mockup-costo-bebe .string.b{left:50%;height:150px}.mockup-costo-bebe .string.c{right:29%;height:90px;transform:rotate(10deg)}.mockup-costo-bebe .crib{position:absolute;left:10%;right:10%;bottom:18px;height:95px;border:8px solid var(--blue);border-radius:15px;background:#fff}.mockup-costo-bebe .crib:before{content:"";position:absolute;inset:15px;background:repeating-linear-gradient(90deg,var(--peach) 0 13px,#fff 14px 28px)}.mockup-costo-bebe .budget{padding:62px 22px}.mockup-costo-bebe .budget-intro{display:grid;grid-template-columns:.65fr 1.35fr;gap:45px;align-items:end;margin-bottom:25px}.mockup-costo-bebe .kicker{color:var(--coral);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-costo-bebe .budget h2,.mockup-costo-bebe .timeline h2{font-size:37px;line-height:1.05;letter-spacing:-.04em;margin:7px 0}.mockup-costo-bebe .budget-intro p{color:var(--muted);margin:0}.mockup-costo-bebe .stage-tabs{display:flex;gap:9px;overflow:auto;padding-bottom:5px;margin-bottom:18px}.mockup-costo-bebe .stage{min-width:185px;text-align:left;border:1px solid var(--line);background:#fff;border-radius:15px;padding:15px;color:var(--ink);cursor:pointer}.mockup-costo-bebe .stage b,.mockup-costo-bebe .stage small{display:block}.mockup-costo-bebe .stage small{color:var(--muted);margin-top:3px}.mockup-costo-bebe .stage.active{border:2px solid var(--coral);padding:14px;background:#fff7f5}.mockup-costo-bebe .planner{display:grid;grid-template-columns:1.2fr .8fr;gap:20px}.mockup-costo-bebe .ledger{background:#fff;border:1px solid var(--line);border-radius:24px;overflow:hidden}.mockup-costo-bebe .ledger-head{padding:23px 25px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.mockup-costo-bebe .ledger-head h3{margin:0;font-size:21px}.mockup-costo-bebe .ledger-head span{font-size:12px;color:var(--muted)}.mockup-costo-bebe .row{display:grid;grid-template-columns:1fr 170px 110px;align-items:center;gap:12px;padding:14px 25px;border-bottom:1px solid #edf0f1}.mockup-costo-bebe .row:last-child{border:0}.mockup-costo-bebe .row label{font-weight:820}.mockup-costo-bebe .row label small{display:block;color:var(--muted);font-weight:500;font-size:11px}.mockup-costo-bebe .row input{width:100%;border:1px solid #ccd6da;border-radius:10px;padding:10px 12px;color:var(--ink)}.mockup-costo-bebe .row output{text-align:right;font-weight:900;color:var(--blue)}.mockup-costo-bebe .summary{border-radius:24px;padding:26px;background:var(--blue);color:#fff;align-self:start;position:sticky;top:16px}.mockup-costo-bebe .badge{display:inline-block;padding:7px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:900}.mockup-costo-bebe .total{font-size:48px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:15px 0 5px}.mockup-costo-bebe .summary>small{color:#dceaf0}.mockup-costo-bebe .split{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:22px 0}.mockup-costo-bebe .mini{border:1px solid #ffffff2b;background:#ffffff0e;border-radius:13px;padding:13px}.mockup-costo-bebe .mini small{display:block;color:#dceaf0;font-size:10px}.mockup-costo-bebe .mini b{font-size:16px}.mockup-costo-bebe .impact{height:12px;background:#ffffff2b;border-radius:99px;overflow:hidden;margin:18px 0 7px}.mockup-costo-bebe .impact i{display:block;height:100%;width:var(--w);background:#f5c876}.mockup-costo-bebe .summary-note{margin-top:17px;background:var(--cream);color:#57461f;border-radius:12px;padding:13px;font-size:13px}.mockup-costo-bebe .timeline{padding:67px 22px;background:#f4f7f5}.mockup-costo-bebe .timeline-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:43px}.mockup-costo-bebe .timeline p{color:var(--muted)}.mockup-costo-bebe .months{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.mockup-costo-bebe .month{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px}.mockup-costo-bebe .month span{display:grid;place-items:center;width:35px;height:35px;border-radius:11px;background:var(--peach);color:var(--coral);font-weight:950}.mockup-costo-bebe .month b{display:block;margin:10px 0 4px}.mockup-costo-bebe .month small{color:var(--muted)}.mockup-costo-bebe .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-costo-bebe .nav{display:none}.mockup-costo-bebe .hero-grid,.mockup-costo-bebe .budget-intro,.mockup-costo-bebe .planner,.mockup-costo-bebe .timeline-grid{grid-template-columns:1fr}.mockup-costo-bebe .summary{position:static}.mockup-costo-bebe .months{grid-template-columns:1fr 1fr}}@media(max-width:570px){.mockup-costo-bebe .hero h1{font-size:43px}.mockup-costo-bebe .row{grid-template-columns:1fr 105px}.mockup-costo-bebe .row output{grid-column:1/-1;text-align:left}.mockup-costo-bebe .months{grid-template-columns:1fr}.mockup-costo-bebe .split{grid-template-columns:1fr}}

.mockup-costo-bebe { width:100%; overflow:hidden; }
.mockup-costo-bebe .top, .mockup-costo-bebe header.top { display:none !important; }
.mockup-costo-bebe .foot { display:none !important; }
.mockup-costo-bebe .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-costo-bebe .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-costo-bebe .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-costo-bebe .support-real summary { cursor:pointer; font-weight:750; }
.mockup-costo-bebe .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-costo-bebe :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-costo-bebe input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-costo-bebe input[type="number"]::-webkit-inner-spin-button, .mockup-costo-bebe input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-costo-bebe .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-costo-bebe support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
