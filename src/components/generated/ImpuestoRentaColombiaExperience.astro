---
<div class="mockup-impuesto-renta-colombia" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>Colombia</b> / Impuestos / Renta persona natural 2026</div><div class="grid"><div><div class="eyebrow">Declaración anual · DIAN</div><h1>De tus ingresos al saldo final de renta.</h1><p class="lead">Sumá todas tus fuentes, aplicá aportes y deducciones, restá retenciones y entendé si te queda impuesto por pagar o saldo a favor.</p><div class="chips"><span>✓ Ingresos por cédula</span><span>✓ Deducciones con topes</span><span>✓ Anticipo 2027</span></div><article class="summary-card"><div class="summary-top"><b>Tu declaración estimada</b><span id="hero-status">Saldo por pagar</span></div><strong id="hero-total">$6.329.760</strong><small id="hero-copy">Impuesto neto después de retenciones</small><div class="summary-row"><div><span>Base gravable</span><b id="hero-base">$96.400.000</b></div><div><span>Tarifa marginal</span><b id="hero-rate">26%</b></div></div></article></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá tu declaración</h2><p>Cargá totales anuales en pesos.</p></div><span class="tag">UVT 2026 · $52.374</span></div><div class="label">Empezá con un perfil o editá todo</div><div class="presets"><button class="preset active" data-preset="salary">Solo salario</button><button class="preset" data-preset="mixed">Salario + otros ingresos</button><button class="preset" data-preset="pension">Pensionado</button></div><div class="label">Ingresos del año</div><div class="fields"><div class="field"><label>Ingresos cédula general</label><div class="money"><b>$</b><input id="general" value="120000000"></div></div><div class="field"><label>Ingresos por pensiones</label><div class="money"><b>$</b><input id="pensions" value="0"></div></div><div class="field"><label>Ingresos no laborales</label><div class="money"><b>$</b><input id="nonlabor" value="0"></div></div><div class="field"><label>Dividendos e intereses</label><div class="money"><b>$</b><input id="dividends" value="0"></div></div></div><div class="label">Aportes y pagos ya hechos</div><div class="fields"><div class="field"><label>Aporte obligatorio AFP</label><div class="money"><b>$</b><input id="afp" value="4800000"></div></div><div class="field"><label>Aporte obligatorio salud</label><div class="money"><b>$</b><input id="health" value="4800000"></div></div><div class="field"><label>Retenciones / impuestos pagados</label><div class="money"><b>$</b><input id="paid" value="3500000"></div></div><div class="field"><label>Deducciones y exentas generales</label><div class="money"><b>$</b><input id="exempt" value="10000000"></div></div></div><div class="label"><button class="more" id="more" type="button">+ Ver deducciones detalladas</button></div><div class="deductions" id="deductions"><div class="field"><label>Pensión voluntaria</label><div class="money"><b>$</b><input id="voluntary" value="0"></div></div><div class="field"><label>Dependientes</label><div class="money"><b>$</b><input id="dependents" value="0"></div></div><div class="field"><label>Salud prepagada</label><div class="money"><b>$</b><input id="prepaid" value="0"></div></div><div class="field"><label>Educación</label><div class="money"><b>$</b><input id="education" value="0"></div></div></div>
<section class="result"><div class="result-top"><div><small id="result-label">SALDO ESTIMADO POR PAGAR</small><div class="value" id="result">$6.329.760</div></div><div class="verdict"><small>Tu situación</small><b id="verdict">Impuesto a cargo</b></div></div><div class="stats"><span>BASE GRAVABLE<b id="base">$100.400.000</b></span><span>TASA EFECTIVA<b id="effective">8,19%</b></span><span>ANTICIPO 2027<b id="advance">$3.164.880</b></span></div><button class="go" id="update">Actualizar declaración</button></section></form></div></div></section>
<section class="section"><div class="wrap"><header class="center"><span>La depuración completa</span><h2>Cómo se transforma tu ingreso</h2><p>Cada bloque responde una pregunta distinta: cuánto recibiste, cuánto podés restar, qué base queda y cuánto ya anticipaste.</p></header><div class="flow"><article class="f1"><small>INGRESO BRUTO</small><b id="f-income">$120.000.000</b><p>Todas las fuentes</p></article><article class="f2"><small>DEDUCCIONES</small><b id="f-deductions">$19.600.000</b><p>Aportes, exentas y beneficios</p></article><article class="f3"><small>BASE GRAVABLE</small><b id="f-base">$100.400.000</b><p>Lo que entra a la tabla</p></article><article class="f4"><small>IMPUESTO CALCULADO</small><b id="f-tax">$9.829.760</b><p>Antes de retenciones</p></article></div></div></section>
<section class="section tint"><div class="wrap breakdown"><article class="card"><h3>Tu declaración, línea por línea</h3><div class="line"><span>Ingresos brutos</span><b id="d-income">$120.000.000</b></div><div class="line"><span>Aportes obligatorios</span><b id="d-mandatory">− $9.600.000</b></div><div class="line"><span>Otras deducciones y exentas</span><b id="d-other">− $10.000.000</b></div><div class="line"><span>Base gravable</span><b id="d-base">$100.400.000</b></div><div class="line"><span>Impuesto calculado</span><b id="d-tax">$9.829.760</b></div><div class="line"><span>Retenciones e impuestos pagados</span><b id="d-paid">− $3.500.000</b></div><div class="line total"><strong id="d-total-label">Saldo por pagar</strong><b id="d-total">$6.329.760</b></div></article><article class="card"><h3>Topes aplicados automáticamente</h3><div class="rule"><i>1</i><div><b>Pensión voluntaria</b><span>Hasta el 30% del ingreso de la cédula general.</span></div></div><div class="rule"><i>2</i><div><b>Salud prepagada</b><span>Hasta 8 UVT con la regla utilizada por esta estimación.</span></div></div><div class="rule"><i>3</i><div><b>Educación</b><span>Hasta 20 UVT dentro del cálculo orientativo.</span></div></div><div class="warning">Estimación informativa. La depuración real puede variar por cédula, límites globales, patrimonio, dividendos, ganancias ocasionales y situación personal. Verificá el formulario con un contador.</div></article></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Tarifa progresiva aplicada</span><h2>Tu base cae en uno de estos seis tramos</h2></header><div class="rates"><article class="rate" data-rate="0"><small>HASTA 95 UVT</small><b>0%</b><span>Exento</span></article><article class="rate" data-rate="5"><small>95–150 UVT</small><b>5%</b><span>Sobre excedente</span></article><article class="rate" data-rate="12"><small>150–360 UVT</small><b>12%</b><span>Marginal</span></article><article class="rate" data-rate="17"><small>360–816 UVT</small><b>17%</b><span>Marginal</span></article><article class="rate" data-rate="26"><small>816–2.630 UVT</small><b>26%</b><span>Marginal</span></article><article class="rate" data-rate="37"><small>MÁS DE 2.630</small><b>37%</b><span>Marginal</span></article></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-impuesto-renta-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-impuesto-renta-colombia');

const U=52374,$=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],cop=n=>"$"+Math.round(n).toLocaleString("es-CO"),n=id=>Math.max(0,Number($(id).value.replaceAll(".","").replace(",","."))||0);
function tax(base){let t=0,r=0;if(base<=95*U)return{t,r};if(base<=150*U){t=(base-95*U)*.05;r=5}else if(base<=360*U){t=55*U*.05+(base-150*U)*.12;r=12}else if(base<=816*U){t=55*U*.05+210*U*.12+(base-360*U)*.17;r=17}else if(base<=2630*U){t=55*U*.05+210*U*.12+456*U*.17+(base-816*U)*.26;r=26}else{t=55*U*.05+210*U*.12+456*U*.17+1814*U*.26+(base-2630*U)*.37;r=37}return{t,r}}
function calc(){const general=n("#general"),income=general+n("#pensions")+n("#nonlabor")+n("#dividends"),mandatory=n("#afp")+n("#health"),other=Math.min(n("#voluntary"),general*.3)+n("#dependents")+Math.min(n("#prepaid"),8*U)+Math.min(n("#education"),20*U)+n("#exempt"),ded=mandatory+other,base=Math.max(0,income-ded),x=tax(base),paid=n("#paid"),pay=Math.max(0,x.t-paid),favor=Math.max(0,paid-x.t),total=pay||favor,eff=income?x.t/income*100:0,advance=pay*.5,isFavor=favor>0;$("#result-label").textContent=isFavor?"SALDO ESTIMADO A FAVOR":"SALDO ESTIMADO POR PAGAR";$("#result").textContent=cop(total);$("#verdict").textContent=isFavor?"Retenciones a favor":pay>0?"Impuesto a cargo":"Sin saldo";$("#base").textContent=cop(base);$("#effective").textContent=eff.toLocaleString("es-CO",{maximumFractionDigits:2})+"%";$("#advance").textContent=cop(advance);$("#hero-status").textContent=isFavor?"Saldo a favor":pay>0?"Saldo por pagar":"Sin saldo";$("#hero-total").textContent=cop(total);$("#hero-copy").textContent=isFavor?"Retenciones superiores al impuesto":"Impuesto neto después de retenciones";$("#hero-base").textContent=cop(base);$("#hero-rate").textContent=x.r+"%";$("#f-income").textContent=cop(income);$("#f-deductions").textContent=cop(ded);$("#f-base").textContent=cop(base);$("#f-tax").textContent=cop(x.t);$("#d-income").textContent=cop(income);$("#d-mandatory").textContent="− "+cop(mandatory);$("#d-other").textContent="− "+cop(other);$("#d-base").textContent=cop(base);$("#d-tax").textContent=cop(x.t);$("#d-paid").textContent="− "+cop(paid);$("#d-total-label").textContent=isFavor?"Saldo a favor":"Saldo por pagar";$("#d-total").textContent=cop(total);$$(".rate").forEach(e=>e.classList.toggle("active",+e.dataset.rate===x.r))}
const presets={salary:{general:120000000,pensions:0,nonlabor:0,dividends:0,afp:4800000,health:4800000,paid:3500000,exempt:10000000},mixed:{general:100000000,pensions:0,nonlabor:30000000,dividends:12000000,afp:4000000,health:4000000,paid:5000000,exempt:12000000},pension:{general:0,pensions:90000000,nonlabor:0,dividends:5000000,afp:0,health:0,paid:1000000,exempt:15000000}};function preset(k){Object.entries(presets[k]).forEach(([id,v])=>$("#"+id).value=v);["voluntary","dependents","prepaid","education"].forEach(id=>$("#"+id).value=0);calc()}$$(".preset").forEach(b=>b.onclick=()=>{$$(".preset").forEach(x=>x.classList.toggle("active",x===b));preset(b.dataset.preset)});$$("input").forEach(i=>i.oninput=()=>{$$(".preset").forEach(x=>x.classList.remove("active"));calc()});$("#more").onclick=e=>{$("#deductions").classList.toggle("open");e.currentTarget.textContent=$("#deductions").classList.contains("open")?"− Ocultar deducciones detalladas":"+ Ver deducciones detalladas"};$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Declaración actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar declaración",1200)};calc();

})();
</script>
