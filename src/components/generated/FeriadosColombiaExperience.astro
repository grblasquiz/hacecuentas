 10px;font-size:10px;font-weight:950}.mockup-feriados-colombia .badge.trasladable{background:#e5f2fb;color:#25618d}.mockup-feriados-colombia .badge.fijo{background:#fff0ca;color:#80601d}.mockup-feriados-colombia .badge.religioso{background:#eee9fa;color:#654d8d}.mockup-feriados-colombia .empty{display:none;padding:50px;text-align:center;border:1px dashed #cbd5dd;border-radius:16px;color:#68768a}.mockup-feriados-colombia .weekends{padding:76px 0}.mockup-feriados-colombia .weekend-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:27px}.mockup-feriados-colombia .weekend{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.mockup-feriados-colombia .weekend small{font-size:10px;color:#657489;font-weight:900}.mockup-feriados-colombia .weekend strong{display:block;font-size:22px;margin:8px 0}.mockup-feriados-colombia .weekend span{font-size:11px;color:#68768a;line-height:1.45}.mockup-feriados-colombia .law{padding:76px 0;background:#fff}.mockup-feriados-colombia .law-card{display:grid;grid-template-columns:.8fr 1.2fr;gap:34px;background:var(--navy);color:#fff;border-radius:24px;padding:30px;align-items:center}.mockup-feriados-colombia .law-card h2{font-size:34px;margin:8px 0}.mockup-feriados-colombia .law-card p{color:#c5d4df;line-height:1.6;font-size:14px}.mockup-feriados-colombia .law-points{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mockup-feriados-colombia .law-point{background:#fff;color:var(--ink);border-radius:14px;padding:16px}.mockup-feriados-colombia .law-point b{display:block;font-size:13px;margin-bottom:5px}.mockup-feriados-colombia .law-point span{font-size:11px;color:#68768a;line-height:1.4}.mockup-feriados-colombia .faq{padding:76px 0;background:#edf3f5}.mockup-feriados-colombia .faq-wrap{max-width:870px}.mockup-feriados-colombia .faq h2{font-size:38px;letter-spacing:-.04em}.mockup-feriados-colombia .faq-item{border-bottom:1px solid #cad5dd}.mockup-feriados-colombia .faq-q{width:100%;border:0;backgro