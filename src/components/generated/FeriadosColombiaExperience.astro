<div class="mockup-feriados-colombia" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>Colombia</b> / Calendario 2026</div><div class="hero-grid"><div><span class="eyebrow">Actualizado · Ley 2578 de 2026</span><h1>Calendario Colombia 2026: 19 festivos y puentes</h1><p class="lede">Fechas observadas, lunes festivos, puentes y días que quedan. Incluye el nuevo festivo nacional de Chiquinquirá.</p><div class="chips"><span class="chip">19 festivos nacionales</span><span class="chip">16 caen lunes o viernes</span><span class="chip">Ley 51 de 1983</span></div></div><aside class="next"><div class="next-head"><b>PRÓXIMO FESTIVO</b><span data-next-day>LUNES</span></div><div class="next-date" data-next-date>17 AGO</div><div class="next-name" data-next-name>Asunción de la Virgen</div><div class="next-meta" data-next-meta>Festivo trasladable · fin de semana de 3 días</div><div class="countdown"><span data-countdown-label>Desde hoy, 17 de agosto</span><strong data-countdown-days>Hoy</strong></div></aside></div></div></section>
<section class="calendar"><div class="wrap"><div class="head"><div><span class="eyebrow">Calendario completo</span><h2>Todos los festivos, sin desplegar nada</h2></div><p>“Todos” está seleccionado de entrada. Filtrá solo si querés buscar un mes o un tipo específico.</p></div><div class="toolbar"><div class="filter"><label for="month">Mes</label><select id="month"><option value="all" selected>Todos los meses · 19 festivos</option><option value="01">Enero</option><option value="03">Marzo</option><option value="04">Abril</option><option value="05">Mayo</option><option value="06">Junio</option><option value="07">Julio</option><option value="08">Agosto</option><option value="10">Octubre</option><option value="11">Noviembre</option><option value="12">Diciembre</option></select></div><div class="filter"><label for="type">Tipo</label><select id="type"><option value="all" selected>Todos los tipos</option><option value="Trasladable">Trasladables · Ley Emiliani</option><option value="Fijo">Fecha fija</option><option value="Religioso">Religiosos no trasladados</option></select></div><button class="clear" id="clear">Ver todos</button></div><div class="summary"><b id="count">Mostrando los 19 festivos</b><span>Fechas ya observadas con los traslados aplicados</span></div><div class="holiday-list" id="list"></div><div class="empty" id="empty">No hay festivos para esa combinación de filtros.</div></div></section>
<section class="weekends"><div class="wrap"><div class="head"><div><span class="eyebrow">Para planear descansos</span><h2>Todos los puentes que quedan en 2026</h2></div><p>Contamos tres días cuando el festivo cae lunes o viernes, sin asumir días libres adicionales.</p></div><div class="weekend-grid"><article class="weekend"><small>7–9 AGOSTO</small><strong>3 días</strong><span>Batalla de Boyacá · viernes</span></article><article class="weekend"><small>15–17 AGOSTO</small><strong>3 días</strong><span>Asunción de la Virgen · lunes</span></article><article class="weekend"><small>10–12 OCTUBRE</small><strong>3 días</strong><span>Día de la Raza · lunes</span></article><article class="weekend"><small>31 OCT–2 NOV</small><strong>3 días</strong><span>Todos los Santos · lunes</span></article><article class="weekend"><small>14–16 NOVIEMBRE</small><strong>3 días</strong><span>Independencia de Cartagena · lunes</span></article><article class="weekend"><small>25–27 DICIEMBRE</small><strong>3 días</strong><span>Navidad · viernes</span></article></div></div></section>
<section class="law"><div class="wrap"><div class="law-card"><div><span class="eyebrow">Cómo funciona</span><h2>La Ley Emiliani mueve la fecha, no la celebración.</h2><p>Varios festivos religiosos y civiles se observan el lunes siguiente para formar puentes. En esta página mostramos directamente el día de descanso de 2026 según la <a href="https://www.secretariasenado.gov.co/senado/basedoc/ley_0051_1983.html" target="_blank" rel="noopener">Ley 51 de 1983</a>.</p></div><div class="law-points"><div class="law-point"><b>Trasladable</b><span>Se corre al lunes siguiente aunque la fecha histórica sea otra.</span></div><div class="law-point"><b>Fijo</b><span>Se celebra en la fecha exacta, caiga el día que caiga.</span></div><div class="law-point"><b>Trabajo en festivo</b><span>La remuneración depende de la legislación laboral y de tu jornada.</span></div></div></div></div></section>
<section class="faq"><div class="wrap faq-wrap"><span class="eyebrow">Preguntas frecuentes</span><h2>Lo que más se consulta</h2><div class="faq-item open"><button class="faq-q">¿Cuántos festivos tiene Colombia en 2026?<span>−</span></button><div class="faq-a">Colombia tiene 19 festivos nacionales en 2026. La Ley 2578 agregó el festivo de Chiquinquirá y la Ley Emiliani trasladó el descanso al lunes 13 de julio.</div></div><div class="faq-item"><button class="faq-q">¿Qué significa que un festivo sea trasladable?<span>+</span></button><div class="faq-a">Que la Ley Emiliani mueve el descanso al lunes siguiente. La lista ya muestra la fecha observada, no la fecha religiosa o histórica original.</div></div><div class="faq-item"><button class="faq-q">¿Todos los festivos forman puente?<span>+</span></button><div class="faq-a">No. Los que caen lunes o viernes forman naturalmente un fin de semana de tres días; los martes, miércoles o jueves no lo hacen sin tomar días adicionales.</div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-feriados-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-feriados-colombia');if(!root)return;

const holidays=[["2026-01-01","Jueves","Año Nuevo","Fijo",""],["2026-01-12","Lunes","Reyes Magos","Trasladable",""],["2026-03-23","Lunes","San José","Trasladable",""],["2026-04-02","Jueves","Jueves Santo","Religioso",""],["2026-04-03","Viernes","Viernes Santo","Religioso",""],["2026-05-01","Viernes","Día del Trabajo","Fijo",""],["2026-05-18","Lunes","Ascensión del Señor","Trasladable",""],["2026-06-08","Lunes","Corpus Christi","Trasladable",""],["2026-06-15","Lunes","Sagrado Corazón","Trasladable",""],["2026-06-29","Lunes","San Pedro y San Pablo","Trasladable",""],["2026-07-13","Lunes","Nuestra Señora del Rosario de Chiquinquirá","Trasladable","Nuevo festivo nacional · Ley 2578 de 2026"],["2026-07-20","Lunes","Día de la Independencia","Fijo",""],["2026-08-07","Viernes","Batalla de Boyacá","Fijo",""],["2026-08-17","Lunes","Asunción de la Virgen","Trasladable",""],["2026-10-12","Lunes","Día de la Raza","Trasladable",""],["2026-11-02","Lunes","Todos los Santos","Trasladable",""],["2026-11-16","Lunes","Independencia de Cartagena","Trasladable",""],["2026-12-08","Martes","Inmaculada Concepción","Fijo",""],["2026-12-25","Viernes","Navidad","Fijo",""]],months=["ENE","FEB","MAR","ABR","MAY","JUN","JUL","AGO","SEP","OCT","NOV","DIC"],today=new Intl.DateTimeFormat("en-CA",{timeZone:"America/Bogota",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date()),$=id=>root.querySelector("#"+id);
function updateNext(){const next=holidays.find(h=>h[0]>=today);if(!next)return;const start=new Date(today+"T12:00:00Z"),end=new Date(next[0]+"T12:00:00Z"),days=Math.max(0,Math.round((end-start)/86400000)),date=new Date(next[0]+"T12:00:00Z"),todayDate=new Date(today+"T12:00:00Z"),longMonths=["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];root.querySelector("[data-next-day]").textContent=next[1].toUpperCase();root.querySelector("[data-next-date]").textContent=date.getUTCDate()+" "+months[date.getUTCMonth()];root.querySelector("[data-next-name]").textContent=next[2];root.querySelector("[data-next-meta]").textContent=next[3]+(next[1]==="Lunes"||next[1]==="Viernes"?" · fin de semana de 3 días":"");root.querySelector("[data-countdown-label]").textContent="Desde hoy, "+todayDate.getUTCDate()+" de "+longMonths[todayDate.getUTCMonth()];root.querySelector("[data-countdown-days]").textContent=days===0?"Hoy":days+" día"+(days===1?"":"s")}
function render(){const m=$("month").value,t=$("type").value,shown=holidays.filter(h=>(m==="all"||h[0].slice(5,7)===m)&&(t==="all"||h[3]===t));$("list").innerHTML=shown.map(h=>{const d=new Date(h[0]+"T12:00:00"),past=h[0]<today;return `<article class="holiday ${past?"past":""}" data-date="${h[0]}" data-type="${h[3]}"><div class="datebox"><strong>${d.getDate()}</strong><span>${months[d.getMonth()]}</span></div><div class="hname"><b>${h[2]}</b><small>${h[4]|| (past?"Ya pasó":"Festivo nacional")}</small></div><div class="day">${h[1]}${h[1]==="Lunes"||h[1]==="Viernes"?" · puente":""}</div><span class="badge ${h[3].toLowerCase()}">${h[3]}</span></article>`}).join("");$("count").textContent=shown.length===holidays.length?"Mostrando los "+holidays.length+" festivos":"Mostrando "+shown.length+" de "+holidays.length+" festivos";$("empty").style.display=shown.length?"none":"block"}
$("month").onchange=render;$("type").onchange=render;$("clear").onclick=()=>{$("month").value="all";$("type").value="all";render();$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1200)};root.querySelectorAll(".faq-q").forEach(q=>q.onclick=()=>{const item=q.parentElement;item.classList.toggle("open");q.lastElementChild.textContent=item.classList.contains("open")?"−":"+"});render();updateNext();

})();
</script>
