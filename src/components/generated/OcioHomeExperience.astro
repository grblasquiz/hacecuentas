<div class="mockup-ocio-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Ocio</div><div class="heroGrid"><div><span class="eyebrow">Disfrutar también se puede planificar</span><h1>Más planes que valen la pena. Menos gastos que sorprenden.</h1><p class="lead">Organizá salidas, hobbies, viajes y eventos sin perder de vista tu tiempo ni tu presupuesto.</p><div class="trust"><span>✓ Presupuesto mensual</span><span>✓ Tiempo disponible</span><span>✓ Ahorro para planes grandes</span></div><div class="scene"><i class="ticket"><b>PLAY</b><i></i><em>★</em></i><i class="spark"></i></div></div>
<div class="calc"><div class="calcHead"><div><h2>Armá tu presupuesto de ocio</h2><p>Planes de hoy y objetivos de mañana.</p></div><span class="live">PLAN EN VIVO</span></div><div class="presets"><button class="preset active" data-preset="home">Más en casa</button><button class="preset" data-preset="social">Más salidas</button><button class="preset" data-preset="travel">Ahorrar para viajar</button></div><div class="fields"><div class="field"><label>Presupuesto libre mensual</label><div class="input"><span>$</span><input id="budget" type="number" min="0" value="420000"></div></div><div class="field"><label>Personas</label><div class="input"><input id="people" type="number" min="1" value="2"><span>personas</span></div></div><div class="field"><label>Salidas al mes</label><div class="input"><input id="outings" type="number" min="0" value="2"><span>planes</span></div></div><div class="field"><label>Costo promedio por salida</label><div class="input"><span>$</span><input id="outingCost" type="number" min="0" value="75000"></div></div><div class="field"><label>Suscripciones + hobbies</label><div class="input"><span>$</span><input id="subscriptions" type="number" min="0" value="60000"></div></div><div class="field"><label>Ahorro para un plan grande</label><div class="input"><span>$</span><input id="saving" type="number" min="0" value="100000"></div></div></div><button class="primary" id="calculate">Actualizar plan</button><div class="result"><div class="resultTop"><div><small>DISPONIBLE DESPUÉS DE TUS PLANES</small><div class="amount" id="available">$110.000</div></div><span class="badge" id="status">Plan equilibrado</span></div><div class="resultGrid"><div class="metric"><span>GASTO DEL MES</span><b id="spent">$210.000</b></div><div class="metric"><span>POR SALIDA / PERSONA</span><b id="perPlan">$37.500</b></div><div class="metric"><span>AHORRO PARA DESPUÉS</span><b id="savingOut">$100.000</b></div></div><div class="budgetbar"><i id="budgetBar"></i></div><p class="note" id="note">El 74% del presupuesto libre está asignado entre planes y ahorro.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Elegí el tipo de plan</span><h2>¿Qué tenés ganas de hacer?</h2><p>Entrá por la experiencia y encontrá las herramientas relacionadas.</p></div><div class="needs"><button class="need active" data-filter="travel"><span class="icon">✈</span><h3>Viajar</h3><p>Presupuesto, millas y equipaje.</p><em>→</em></button><button class="need" data-filter="events"><span class="icon">★</span><h3>Juntarse</h3><p>Comida, bebidas y cantidades.</p><em>→</em></button><button class="need" data-filter="sports"><span class="icon">⚽</span><h3>Seguir deportes</h3><p>Fútbol, estadísticas y torneos.</p><em>→</em></button><button class="need" data-filter="gaming"><span class="icon">＋</span><h3>Jugar</h3><p>Gaming y rendimiento del equipo.</p><em>→</em></button><button class="need" data-filter="home"><span class="icon">⌂</span><h3>Planes en casa</h3><p>Cocina, foto y proyectos maker.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas para tu tiempo libre</span><h2>Planificá lo necesario. Disfrutá el resto.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="travel">Viajes</button><button class="filter" data-filter="events">Eventos</button><button class="filter" data-filter="sports">Deportes</button><button class="filter" data-filter="gaming">Gaming</button><button class="filter" data-filter="home">En casa</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="travel" data-text="viaje presupuesto millas equipaje aeropuerto"><span class="tag">Próximo viaje</span><h3>Planificar un viaje</h3><p>Presupuesto, gastos diarios, traslados, millas y equipaje.</p><button>Armar viaje →</button></article><article class="card" data-cat="events home" data-text="comida evento invitados cantidades fiesta"><span class="tag">Encuentros</span><h3>Comida para un evento</h3><p>Porciones, menú y margen según invitados.</p><button>Calcular comida →</button></article><article class="card" data-cat="events" data-text="bebidas evento alcohol agua hielo invitados"><span class="tag">Fiesta</span><h3>Bebidas para invitados</h3><p>Cantidades según personas, duración y consumo.</p><button>Calcular bebidas →</button></article><article class="card" data-cat="sports" data-text="futbol estadisticas mundial equipos partido"><span class="tag">Fútbol</span><h3>Estadísticas y Mundial</h3><p>Compará equipos, partidos y escenarios de torneo.</p><button>Explorar fútbol →</button></article><article class="card" data-cat="gaming home" data-text="gaming fps latencia monitor rendimiento"><span class="tag">Gaming</span><h3>Analizar tu setup</h3><p>FPS, Hz, latencia y equilibrio del equipo.</p><button>Analizar →</button></article><article class="card" data-cat="home" data-text="fotografia camara impresion 3d cocina proyectos"><span class="tag">Hobbies</span><h3>Proyectos en casa</h3><p>Fotografía, impresión 3D, cocina y tecnología.</p><button>Ver proyectos →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="balance"><div class="wrap balanceGrid"><div><span class="eyebrow" style="color:var(--yellow)">Equilibrio, no optimización</span><h2>El mejor plan no siempre es el más barato.</h2><p>Compará costo, tiempo, compañía y ganas. El presupuesto pone un marco; la decisión sigue siendo tuya.</p></div><div class="choices"><button class="choice active" data-choice="Costo"><span><b>1. ¿Cuánto cuesta de verdad?</b><small>Entradas, traslados, comida y extras.</small></span><b>→</b></button><button class="choice" data-choice="Tiempo"><span><b>2. ¿Cuánto tiempo pide?</b><small>Preparación, viaje y recuperación.</small></span><b>→</b></button><button class="choice" data-choice="Valor"><span><b>3. ¿Cuánto lo vas a disfrutar?</b><small>No todo valor entra en una cuenta.</small></span><b>→</b></button></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-ocio-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-ocio-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>(n<0?"−":"")+"$"+Math.round(Math.abs(n)).toLocaleString("es-AR");let current="home";function calc(){const budget=Math.max(0,+$("#budget").value||0),people=Math.max(1,+$("#people").value||1),outings=Math.max(0,+$("#outings").value||0),cost=Math.max(0,+$("#outingCost").value||0),subs=Math.max(0,+$("#subscriptions").value||0),saving=Math.max(0,+$("#saving").value||0),spent=outings*cost+subs,assigned=spent+saving,available=budget-assigned,pct=budget?Math.round(assigned/budget*100):100;$("#available").textContent=money(available);$("#spent").textContent=money(spent);$("#perPlan").textContent=money(outings?outings*cost/(outings*people):0);$("#savingOut").textContent=money(saving);$("#budgetBar").style.width=Math.min(100,pct)+"%";let status=available<0?"No entra todavía":pct>90?"Margen muy justo":pct>60?"Plan equilibrado":"Te queda margen";$("#status").textContent=status;$("#status").style.background=available<0?"#a8504b":pct>90?"#976835":"#327066";$("#note").textContent=`El ${pct}% del presupuesto libre está asignado entre planes y ahorro.`}
$$(".calc input").forEach(x=>x.oninput=calc);const presets={home:[420000,2,2,75000,60000,100000],social:[520000,2,5,85000,45000,30000],travel:[450000,2,2,65000,40000,220000]};$$(".preset").forEach(b=>b.onclick=()=>{current=b.dataset.preset;$$(".preset").forEach(x=>x.classList.toggle("active",x===b));const v=presets[current],ids=["budget","people","outings","outingCost","subscriptions","saving"];ids.forEach((id,i)=>$("#"+id).value=v[i]);calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Plan actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".choice").forEach(b=>b.onclick=()=>{$$(".choice").forEach(x=>x.classList.toggle("active",x===b));toast("Criterio seleccionado: "+b.dataset.choice)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
