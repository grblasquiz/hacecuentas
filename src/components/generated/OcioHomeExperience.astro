nt-size:9px;font-weight:900}.mockup-ocio-home .resultGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.mockup-ocio-home .metric{background:#ffffff0c;border:1px solid #ffffff14;border-radius:9px;padding:9px}.mockup-ocio-home .metric span{font-size:7px;color:#c0c8d8;display:block}.mockup-ocio-home .metric b{font-size:10px}.mockup-ocio-home .budgetbar{height:8px;border-radius:9px;background:#ffffff17;margin-top:12px;overflow:hidden}.mockup-ocio-home .budgetbar i{display:block;height:100%;width:67%;background:var(--yellow);border-radius:9px;transition:.3s}.mockup-ocio-home .note{font-size:9px;color:#c7cedb;margin:9px 0 0}
