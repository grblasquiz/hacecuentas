.mockup-presupuesto-eventos .tool{padding:62px 22px}.mockup-presupuesto-eventos .tool-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.mockup-presupuesto-eventos .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-presupuesto-eventos .tool h2,.mockup-presupuesto-eventos .guide h2{font-size:37px;letter-spacing:-.04em;margin:7px 0}.mockup-presupuesto-eventos .tool-head p{max-width:510px;color:var(--muted);margin:0}.mockup-presupuesto-eventos .workspace{display:grid;grid-template-columns:1.05fr .95fr;gap:20px}.mockup-presupuesto-eventos .panel{border-radius:24px;padding:27px}.mockup-presupuesto-eventos .form{border:1px solid var(--line);box-shadow:0 16px 40px #18374a0c}.mockup-presupuesto-eventos .panel h3{font-size:21px;margin:0 0 5px}.mockup-presupuesto-eventos .hint{color:var(--muted);font-size:14px;margin:0 0 20px}.mockup-presupuesto-eventos .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-presupuesto-eventos .field{margin-bottom:2px}.mockup-presupuesto-eventos .field label{display:flex;justify-content:space-between;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-presupuesto-eventos .field output{color:var(--accent)}.mockup-presupuesto-eventos input,.mockup-presupuesto-eventos select{width:100%;min-height:49px;border:1px solid #ccd7da;border-radius:12px;background:#fff;padding:12px 14px;color:var(--ink)}.mockup-presupuesto-eventos input[type=range]{padding:0;accent-color:var(--accent)}.mockup-presupuesto-eventos .actions{display:flex;gap:9px;margin-top:21px}.mockup-presupuesto-eventos .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:14px;font-weight:900;cursor:pointer}.mockup-presupuesto-eventos .reset{border:1px solid #d7aa58;border-radius:12px;background:#fff;color:#654a1f;padding:13px 16px;font-weight:850;cursor:pointer}.mockup-presupuesto-eventos .result{background:linear-gradient(145deg,var(--