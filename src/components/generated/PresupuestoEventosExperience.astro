---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-presupuesto-eventos" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Eventos / Presupuesto</div><div class="eyebrow">Presupuesto con prioridades</div><h1>Decidí dónde gastar antes de pedir presupuestos.</h1><p class="lead">Distribuí un monto total según tipo de evento y prioridad. Mirá topes por rubro y colchón para imprevistos.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art budget"><div class="donut"></div><span>$</span></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">presupuesto interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="total">Presupuesto total ($)</label><input id="total" type="number" value="3000000" min="10000" max="1000000000" step="10000"></div><div class="field"><label for="guests">Invitados</label><input id="guests" type="number" value="100" min="5" max="5000" step="5"></div><div class="field"><label for="priority">Prioridad principal</label><select id="priority"><option value="food">Comida y bebida</option><option value="place">Lugar y ambientación</option><option value="music">Música y experiencia</option><option value="balanced">Equilibrado</option></select></div><div class="field"><label for="buffer">Imprevistos (%)</label><input id="buffer" type="number" value="10" min="0" max="30" step="1"></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-presupuesto-eventos')?document.currentScript.previousElementSibling:document.querySelector('.mockup-presupuesto-eventos');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const total=vn("total"),guests=vn("guests"),buffer=vn("buffer")/100,usable=total*(1-buffer),p={food:[.48,.2,.12,.2],place:[.34,.34,.12,.2],music:[.34,.2,.26,.2],balanced:[.4,.25,.15,.2]}[v("priority")],money=n=>"$"+Math.round(n).toLocaleString("es-AR");return {big:money(total/guests),label:"Presupuesto por invitado",badge:Math.round(buffer*100)+"% reservado",metrics:[["Comida",money(usable*p[0])],["Lugar",money(usable*p[1])],["Experiencia",money(usable*p[2])]],position:Math.min(100,buffer*400),note:"Quedan "+money(usable*p[3])+" para foto, traslados, invitaciones y otros rubros. Cerrá primero los dos gastos que más impactan."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"total":"3000000","guests":"100","priority":"food","buffer":"10"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
<style is:global>

