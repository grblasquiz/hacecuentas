.mockup-monotributo { width:100%; overflow:hidden; }
.mockup-monotributo .top, .mockup-monotributo header.top { display:none !important; }
.mockup-monotributo .foot { display:none !important; }
.mockup-monotributo .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-monotributo .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-monotributo .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-monotributo .support-real summary { cursor:pointer; font-weight:750; }
.mockup-monotributo .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-monotributo :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-monotributo input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-monotributo input[type="number"]::-webkit-inner-spin-button, .mockup-monotributo input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-monotributo .support-real-grid{grid-template-columns:1fr}}
