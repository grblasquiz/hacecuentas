---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-longitud" set:html={`<div class="wrap hero"><div><div class="crumb">Conversores / Longitud</div><div class="eyebrow">Una medida, todos los sistemas</div><h1>Convertí una vez. Entendé todas las escalas.</h1><p class="lead">Pasá entre sistema métrico e imperial, convertí superficies o calculá metros cuadrados desde un rollo.</p><div class="chips"><span class="chip">✓ Resultado instantáneo</span><span class="chip">✓ 20 unidades</span><span class="chip">✓ Coma o punto decimal</span></div></div><div class="visual"><div class="ruler"></div><div class="tape"><span>25 m</span></div><div class="measure"><small>EQUIVALE A</small><b id="heroResult">82,02 pies</b></div></div></div>
<div class="wrap"><form class="calc" id="calculator"><div class="case-label">¿QUÉ ESTÁS MIDIENDO?</div><div class="cases"><button type="button" class="case active" data-mode="length"><span>↔</span>Longitud o distancia</button><button type="button" class="case" data-mode="area"><span>▧</span>Superficie o área</button><button type="button" class="case" data-mode="linear"><span>▥</span>Metros lineales → m²</button></div>
<div class="grid"><div class="panel"><h2 id="formTitle">Convertí la medida</h2><p class="hint" id="formHint">Escribí un valor y elegí las dos unidades.</p>
<div class="fields active" data-fields="length"><div class="convert-row"><div class="field"><label for="lengthValue">Cantidad</label><input class="control value" id="lengthValue" value="25" inputmode="decimal"><select class="control" id="lengthFrom"></select></div><button class="swap" id="lengthSwap" type="button" aria-label="Intercambiar unidades">⇄</button><div class="field"><label for="lengthTo">Convertir a</label><select class="control" id="lengthTo"></select></div></div><div class="quick"><button type="button" data-quick="1,mi,km">1 milla → km</button><button type="button" data-quick="1,m,ft">1 metro → pies</button><button type="button" data-quick="1,in,cm">1 pulgada → cm</button><button type="button" data-quick="100,km,mi">100 km → millas</button></div></div>
<div class="fields" data-fields="area"><div class="convert-row"><div class="field"><label for="areaValue">Cantidad</label><input class="control value" id="areaValue" value="100" inputmode="decimal"><select class="control" id="areaFrom"></select></div><button class="swap" id="areaSwap" type="button" aria-label="Intercambiar unidades de superficie">⇄</button><div class="field"><label for="areaTo">Convertir a</label><select class="control" id="areaTo"></select></div></div><div class="quick"><button type="button" data-areaquick="1,ha,m2">1 ha → m²</button><button type="button" data-areaquick="1,acre,m2">1 acre → m²</button><button type="button" data-areaquick="100,m2,ft2">100 m² → ft²</button></div></div>
<div class="fields" data-fields="linear"><div class="linear-grid"><div class="field"><label for="linearLength">Metros lineales</label><input class="control value" id="linearLength" value="25" inputmode="decimal"></div><div class="field"><label for="linearWidth">Ancho del rollo (m)</label><input class="control value" id="linearWidth" value="1.4" inputmode="decimal"></div></div><div class="quick"><button type="button" data-linear="10,1.4">Tela · 1,40 m</button><button type="button" data-linear="20,0.53">Papel · 0,53 m</button><button type="button" data-linear="15,2">Alfombra · 2 m</button></div></div>
<button class="update" id="updateButton" type="button">Actualizar conversión</button></div>
<div class="panel result"><div class="kicker" id="kicker">RESULTADO</div><div class="big" id="resultValue">82,02 ft</div><div class="sub" id="resultSub">25 m × 3,28084 = 82,02 pies.</div><div class="badge" id="resultBadge">Aproximadamente 12 puertas de alto</div><div class="tiles"><div class="tile"><small id="t1l">Metros</small><strong id="t1v">25 m</strong></div><div class="tile"><small id="t2l">Centímetros</small><strong id="t2v">2.500 cm</strong></div><div class="tile"><small id="t3l">Pulgadas</small><strong id="t3v">984,25 in</strong></div></div></div></div></form></div>
<section><div class="wrap"><div class="section-head"><div class="eyebrow">Todas las equivalencias</div><h2 id="equivTitle">La misma longitud en ocho unidades.</h2><p>Cada tarjeta se actualiza mientras escribís. La unidad elegida queda destacada.</p></div><div class="equivs" id="equivs"></div></div></section>
<section class="scale"><div class="wrap"><div class="section-head"><div class="eyebrow">Poné la medida en contexto</div><h2 id="scaleTitle">¿Qué tan largo es?</h2><p id="scaleCopy">Una referencia visual ayuda a detectar errores de unidad antes de usar el resultado.</p></div><div class="scale-line"><div class="marker" id="marker"></div></div><div class="labels"><span>1 mm</span><span>1 cm</span><span>1 m</span><span>100 m</span><span>1 km</span></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><div class="eyebrow">La regla detrás de la conversión</div><h2>Todo pasa por una unidad base.</h2><div class="rule"><strong id="rule">Destino = valor × factor de origen ÷ factor de destino</strong><p id="ruleCopy">Para longitudes usamos el metro; para superficies, el metro cuadrado.</p></div></div><div class="checks"><div class="check"><span class="tick">✓</span><span>Sistema métrico e imperial.</span></div><div class="check"><span class="tick">✓</span><span>Millas terrestres y náuticas diferenciadas.</span></div><div class="check"><span class="tick">✓</span><span>Longitud y superficie nunca se mezclan.</span></div><div class="check"><span class="tick">✓</span><span>Precisión adaptada al tamaño del resultado.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-longitud')?document.currentScript.previousElementSibling:document.querySelector('.mockup-longitud');

const $=id=>root.querySelector("#"+id),set=(id,v)=>$(id).textContent=v,parse=s=>{let t=String(s).trim().replace(/\s/g,"");if(t.includes(","))t=t.replace(/\./g,"").replace(",",".");return Number(t)||0},fmt=n=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:Math.abs(n)<.01?8:Math.abs(n)<10?5:2});let mode="length";const lengthUnits={mm:["Milímetro","mm",.001],cm:["Centímetro","cm",.01],m:["Metro","m",1],km:["Kilómetro","km",1000],in:["Pulgada","in",.0254],ft:["Pie","ft",.3048],yd:["Yarda","yd",.9144],mi:["Milla","mi",1609.344],nmi:["Milla náutica","M",1852],vara:["Vara argentina","vara",.866]},areaUnits={cm2:["Centímetro cuadrado","cm²",.0001],m2:["Metro cuadrado","m²",1],km2:["Kilómetro cuadrado","km²",1e6],ha:["Hectárea","ha",10000],acre:["Acre","acre",4046.8564224],in2:["Pulgada cuadrada","in²",.00064516],ft2:["Pie cuadrado","ft²",.09290304]};function fill(id,obj,selected){$(id).innerHTML=Object.entries(obj).map(([k,u])=>`<option value="${k}" ${k===selected?"selected":""}>${u[0]} (${u[1]})</option>`).join("")}fill("lengthFrom",lengthUnits,"m");fill("lengthTo",lengthUnits,"ft");fill("areaFrom",areaUnits,"m2");fill("areaTo",areaUnits,"ft2");
function cards(obj,base,dest){$("equivs").innerHTML=Object.entries(obj).slice(0,8).map(([k,u])=>`<article class="equiv ${k===dest?"active":""}"><small>${u[0]}</small><b>${fmt(base/u[2])} ${u[1]}</b></article>`).join("")}
function calculate(){if(mode==="length"){let v=parse($("lengthValue").value),from=lengthUnits[$("lengthFrom").value],to=lengthUnits[$("lengthTo").value],base=v*from[2],out=base/to[2];set("kicker","LONGITUD CONVERTIDA");set("resultValue",fmt(out)+" "+to[1]);set("resultSub",`${fmt(v)} ${from[1]} = ${fmt(out)} ${to[1]} · factor ${fmt(from[2]/to[2])}`);set("resultBadge",base<1?"Menos de un metro":base<10?"Similar al largo de una habitación":base<100?"Comparable a una pileta o cancha":"Una distancia de recorrido");set("t1l","Metros");set("t1v",fmt(base)+" m");set("t2l","Centímetros");set("t2v",fmt(base*100)+" cm");set("t3l","Pulgadas");set("t3v",fmt(base/.0254)+" in");set("heroResult",fmt(out)+" "+to[1]);set("equivTitle","La misma longitud en ocho unidades.");set("scaleTitle","¿Qué tan largo es?");set("rule","Destino = valor × factor de origen ÷ factor de destino");cards(lengthUnits,base,$("lengthTo").value);let pos=Math.max(0,Math.min(100,(Math.log10(Math.max(base,.001))+3)/6*100));$("marker").style.left=pos+"%"}
if(mode==="area"){let v=parse($("areaValue").value),from=areaUnits[$("areaFrom").value],to=areaUnits[$("areaTo").value],base=v*from[2],out=base/to[2],side=Math.sqrt(base);set("kicker","SUPERFICIE CONVERTIDA");set("resultValue",fmt(out)+" "+to[1]);set("resultSub",`${fmt(v)} ${from[1]} = ${fmt(out)} ${to[1]}.`);set("resultBadge","Equivale a un cuadrado de "+fmt(side)+" m de lado");set("t1l","Metros cuadrados");set("t1v",fmt(base)+" m²");set("t2l","Hectáreas");set("t2v",fmt(base/10000)+" ha");set("t3l","Pies cuadrados");set("t3v",fmt(base/.09290304)+" ft²");set("heroResult",fmt(out)+" "+to[1]);set("equivTitle","La misma superficie en siete unidades.");set("scaleTitle","¿Qué tamaño de superficie es?");set("rule","Área destino = m² ÷ factor de destino");cards(areaUnits,base,$("areaTo").value);$("marker").style.left=Math.max(0,Math.min(100,(Math.log10(Math.max(side,.001))+3)/6*100))+"%"}
if(mode==="linear"){let l=parse($("linearLength").value),w=parse($("linearWidth").value),base=l*w,side=Math.sqrt(base);set("kicker","SUPERFICIE DEL ROLLO");set("resultValue",fmt(base)+" m²");set("resultSub",`${fmt(l)} metros lineales × ${fmt(w)} m de ancho.`);set("resultBadge","Equivale a un cuadrado de "+fmt(side)+" m de lado");set("t1l","Metros lineales");set("t1v",fmt(l)+" m");set("t2l","Ancho");set("t2v",fmt(w)+" m");set("t3l","Pies cuadrados");set("t3v",fmt(base/.09290304)+" ft²");set("heroResult",fmt(base)+" m²");set("equivTitle","La superficie resultante en distintas unidades.");set("scaleTitle","¿Qué tamaño de superficie es?");set("rule","Superficie = metros lineales × ancho");cards(areaUnits,base,"m2");$("marker").style.left=Math.max(0,Math.min(100,(Math.log10(Math.max(side,.001))+3)/6*100))+"%"}}
function swap(a,b){let x=$(a).value;$(a).value=$(b).value;$(b).value=x;calculate()}$("lengthSwap").addEventListener("click",()=>swap("lengthFrom","lengthTo"));$("areaSwap").addEventListener("click",()=>swap("areaFrom","areaTo"));root.querySelectorAll("[data-quick]").forEach(b=>b.addEventListener("click",()=>{let [v,a,z]=b.dataset.quick.split(",");$("lengthValue").value=v;$("lengthFrom").value=a;$("lengthTo").value=z;calculate()}));root.querySelectorAll("[data-areaquick]").forEach(b=>b.addEventListener("click",()=>{let [v,a,z]=b.dataset.areaquick.split(",");$("areaValue").value=v;$("areaFrom").value=a;$("areaTo").value=z;calculate()}));root.querySelectorAll("[data-linear]").forEach(b=>b.addEventListener("click",()=>{let [l,w]=b.dataset.linear.split(",");$("linearLength").value=l;$("linearWidth").value=w;calculate()}));
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".fields").forEach(x=>x.classList.toggle("active",x.dataset.fields===mode));set("formTitle",mode==="linear"?"Calculá la superficie del rollo":"Convertí la medida");set("formHint",mode==="linear"?"Multiplicamos metros lineales por el ancho real.":"Escribí un valor y elegí las dos unidades.");calculate()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calculate));function confirmCalc(){calculate();set("updateButton","✓ Conversión actualizada");clearTimeout(window.timer);window.timer=setTimeout(()=>set("updateButton","Actualizar conversión"),5000)}$("updateButton").addEventListener("click",confirmCalc);$("calculator").addEventListener("submit",e=>{e.preventDefault();confirmCalc()});calculate();

})();
</script>
<style is:global>

.mockup-longitud{--ink:#111b33;--muted:#637085;--line:#dfe4ea;--bg:#f6f6f2;--blue:#286be7;--mint:#35aa98;--amber:#efad45;--navy:#174B7A}.mockup-longitud *{box-sizing:border-box}.mockup-longitud{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.mockup-longitud .wrap{width:min(1160px,calc(100% - 40px));margin:auto}.mockup-longitud header{height:86px;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-longitud .nav{display:flex;align-items:center;gap:28px}.mockup-longitud .logo{width:28px;height:35px;border-radius:4px;background:var(--navy);color:#fff;display:grid;place-items:center}.mockup-longitud .brand{font-size:18px;font-weight:950}.mockup-longitud .links{display:flex;gap:24px;color:#4e5a6c;font-size:13px;font-weight:800}.mockup-longitud .tools{margin-left:auto;display:flex;gap:8px}.mockup-longitud .tool{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px;font-weight:800}
.mockup-longitud .hero{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center;padding:62px 0 48px}.mockup-longitud .crumb{color:var(--blue);font-size:14px}.mockup-longitud .eyebrow{margin-top:18px;color:#187c77;font-size:12px;font-weight:950;letter-spacing:.13em;text-transform:uppercase}.mockup-longitud h1{font-size:clamp(46px,5.2vw,70px);line-height:.98;letter-spacing:-.055em;margin:11px 0 20px}.mockup-longitud .lead{font-size:18px;color:var(--muted);max-width:680px}.mockup-longitud .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-longitud .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:12px;font-weight:850}
.mockup-longitud .visual{height:350px;position:relative}.mockup-longitud .ruler{position:absolute;left:15px;right:12px;top:114px;height:112px;background:#efb34c;border-radius:18px;transform:rotate(-6deg);box-shadow:0 20px 45px #303b471f;overflow:hidden}.mockup-longitud .ruler:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 25px,#6e5023 25px 28px,transparent 28px 50px)}.mockup-longitud .ruler:after{content:"0      10      20      30      40";position:absolute;left:24px;right:0;bottom:15px;color:#6e5023;font-weight:950;word-spacing:26px}.mockup-longitud .tape{position:absolute;right:16px;top:45px;width:168px;height:168px;border-radius:50%;background:#3678d3;border:14px solid #fff;box-shadow:0 15px 40px #26374c2e;display:grid;place-items:center}.mockup-longitud .tape:before{content:"";position:absolute;inset:34px;background:#17314e;border-radius:50%}.mockup-longitud .tape span{position:relative;color:#fff;font-size:26px;font-weight:950}.mockup-longitud .measure{position:absolute;left:28px;bottom:21px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:13px 18px;box-shadow:0 12px 30px #24354b25}.mockup-longitud .measure small{display:block;color:#738095;font-size:9px;font-weight:900}.mockup-longitud .measure b{font-size:24px}
.mockup-longitud .calc{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:68px}.mockup-longitud .case-label{font-size:12px;font-weight:950;color:#5b6778;margin-bottom:11px}.mockup-longitud .cases{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:25px}.mockup-longitud .case{border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:14px;color:#505d70;font-size:12px;font-weight:900;cursor:pointer}.mockup-longitud .case span{display:block;font-size:18px;margin-bottom:3px}.mockup-longitud .case.active{background:#eef4ff;color:#1c5fcd;border-color:var(--blue);box-shadow:inset 0 0 0 1px var(--blue)}.mockup-longitud .grid{display:grid;grid-template-columns:1fr 1fr;gap:23px}.mockup-longitud .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-longitud .panel h2{font-size:22px;margin:0 0 5px}.mockup-longitud .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-longitud .fields{display:none}.mockup-longitud .fields.active{display:block}.mockup-longitud .convert-row{display:grid;grid-template-columns:1fr 58px 1fr;gap:10px;align-items:end}.mockup-longitud .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-longitud .control{width:100%;height:52px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-longitud .control:focus{border-color:var(--blue);box-shadow:0 0 0 3px #286be718}.mockup-longitud .value{font-size:24px;font-weight:900}.mockup-longitud .swap{height:52px;width:52px;border-radius:50%;border:1px solid #bfcbd7;background:#fff;color:var(--blue);font-size:21px;font-weight:950;cursor:pointer}.mockup-longitud .linear-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.mockup-longitud .quick{display:flex;flex-wrap:wrap;gap:7px;margin-top:17px}.mockup-longitud .quick button{border:1px solid var(--line);background:#fff;border-radius:99px;padding:8px 11px;font-size:11px;font-weight:850;cursor:pointer}.mockup-longitud .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
.mockup-longitud .result{background:linear-gradient(145deg,#13365f,#0b1e3b);border:0;color:#fff;position:relative;overflow:hidden}.mockup-longitud .result:after{content:"";position:absolute;width:220px;height:220px;border:45px solid #2ab6aa20;border-radius:50%;right:-125px;bottom:-130px}.mockup-longitud .kicker{font-size:11px;letter-spacing:.13em;color:#9fe1d6;font-weight:950}.mockup-longitud .big{font-size:48px;line-height:1.05;font-weight:950;letter-spacing:-.045em;margin:15px 0 7px}.mockup-longitud .sub{color:#c2d2e4}.mockup-longitud .badge{display:inline-flex;margin-top:16px;padding:8px 11px;border-radius:99px;background:#1e4777;border:1px solid #416992;font-size:12px;font-weight:850}.mockup-longitud .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}.mockup-longitud .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px;position:relative;z-index:1}.mockup-longitud .tile small{display:block;color:#b6c7db;text-transform:uppercase;font-size:9px;letter-spacing:.07em}.mockup-longitud .tile strong{display:block;margin-top:5px;font-size:14px}
.mockup-longitud section{padding:70px 0}.mockup-longitud .section-head{max-width:760px;margin-bottom:28px}.mockup-longitud .section-head h2,.mockup-longitud .dark h2{font-size:39px;line-height:1.05;letter-spacing:-.04em;margin:9px 0}.mockup-longitud .section-head p{font-size:17px;color:var(--muted)}.mockup-longitud .equivs{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.mockup-longitud .equiv{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.mockup-longitud .equiv small{display:block;color:#718095;font-weight:900}.mockup-longitud .equiv b{display:block;font-size:22px;margin-top:7px;overflow-wrap:anywhere}.mockup-longitud .equiv.active{background:#eef4ff;border-color:#9dbce8}.mockup-longitud .scale{background:#eef3f5;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.mockup-longitud .scale-line{height:15px;border-radius:99px;background:linear-gradient(90deg,#b7d9df,#42ac98,#efb04a,#286be7);position:relative;margin:45px 0 35px}.mockup-longitud .marker{position:absolute;left:50%;top:-15px;width:8px;height:45px;background:#102746;border-radius:5px}.mockup-longitud .marker:after{content:"Tu medida";position:absolute;left:50%;top:-32px;transform:translateX(-50%);white-space:nowrap;background:#102746;color:#fff;padding:5px 8px;border-radius:7px;font-size:10px;font-weight:900}.mockup-longitud .labels{display:flex;justify-content:space-between;color:#5f6d80;font-size:12px}.mockup-longitud .dark{background:#0c203d;color:#fff}.mockup-longitud .dark-grid{display:grid;grid-template-columns:1fr 1fr;gap:55px}.mockup-longitud .rule{border:1px solid #ffffff20;background:#ffffff09;border-radius:20px;padding:24px}.mockup-longitud .rule strong{font-size:26px}.mockup-longitud .rule p{color:#b8c9dc}.mockup-longitud .checks{display:grid;gap:12px}.mockup-longitud .check{display:flex;gap:12px;color:#d4e0ee}.mockup-longitud .tick{flex:0 0 26px;height:26px;border-radius:50%;background:#2eaa98;display:grid;place-items:center;color:#071d2c;font-weight:950}.mockup-longitud footer{padding:30px;text-align:center;color:#687589;font-size:12px;background:#fff}
@media(max-width:920px){.mockup-longitud .links{display:none}.mockup-longitud .hero,.mockup-longitud .grid,.mockup-longitud .dark-grid{grid-template-columns:1fr}.mockup-longitud .equivs{grid-template-columns:1fr 1fr}.mockup-longitud .visual{height:315px}.mockup-longitud .tiles{grid-template-columns:1fr}}@media(max-width:520px){.mockup-longitud .wrap{width:calc(100% - 24px)}.mockup-longitud header{height:70px}.mockup-longitud .tools .tool:first-child{display:none}.mockup-longitud h1{font-size:42px}.mockup-longitud .visual{transform:scale(.84);margin:-25px}.mockup-longitud .calc{padding:14px}.mockup-longitud .panel{padding:18px}.mockup-longitud .cases,.mockup-longitud .convert-row,.mockup-longitud .linear-grid,.mockup-longitud .equivs{grid-template-columns:1fr}.mockup-longitud .swap{margin:auto;transform:rotate(90deg)}.mockup-longitud .section-head h2,.mockup-longitud .dark h2{font-size:32px}}

.mockup-longitud { width:100%; overflow:hidden; }
.mockup-longitud .top, .mockup-longitud header.top { display:none !important; }
.mockup-longitud .foot { display:none !important; }
.mockup-longitud .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-longitud .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-longitud .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-longitud .support-real summary { cursor:pointer; font-weight:750; }
.mockup-longitud .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-longitud :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-longitud input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-longitud input[type="number"]::-webkit-inner-spin-button, .mockup-longitud input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-longitud .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-longitud support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
