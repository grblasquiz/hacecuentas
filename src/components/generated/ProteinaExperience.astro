.mockup-proteina .foot { display:none !important; }
.mockup-proteina .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-proteina .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
