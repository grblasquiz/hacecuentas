.mockup-proteina :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-proteina input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
