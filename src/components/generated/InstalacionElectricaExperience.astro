---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-instalacion-electrica" set:html={`
    <div class="wrap hero"><div><div class="crumb">Tecnología / Instalación eléctrica</div><div class="eyebrow">Electricidad sin adivinanzas</div><h1>El cable correcto.<br>La protección correcta.</h1><p class="lead">Dimensioná corriente, sección, térmica y caída de tensión antes de comprar materiales o intervenir un tablero.</p><div class="chips"><span class="chip">✓ IRAM / IEC</span><span class="chip">✓ Mono y trifásica</span><span class="chip">✓ Cobre y aluminio</span></div></div><div class="visual"><div class="board"><div class="rail"></div><div class="breaker one"><div class="switch"></div><small>10 A</small></div><div class="breaker two"><div class="switch"></div><small>16 A</small></div><div class="breaker three"><div class="switch"></div><small>25 A</small></div><div class="wire a"></div><div class="wire b"></div><div class="wire c"></div></div><div class="bolt">ϟ</div><div class="meter"><span id="heroA">15,9 A</span></div></div></div>
    <div class="wrap"><form class="calc" id="calculator"><div class="case-label">¿QUÉ NECESITÁS RESOLVER?</div><div class="cases">
      <button type="button" class="case active" data-mode="cable"><span></span>Cable y térmica</button>
      <button type="button" class="case" data-mode="drop"><span>↘</span>Caída de tensión</button>
      <button type="button" class="case" data-mode="ohm"><span>Ω</span>Ley de Ohm</button>
      <button type="button" class="case" data-mode="power"><span>φ</span>Factor de potencia</button>
      <button type="button" class="case" data-mode="trafo"><span>⇄</span>Transformador</button>
    </div><div class="grid"><div class="panel"><h2 id="formTitle">Dimensioná el circuito</h2><p class="hint" id="formHint">La protección se elige por corriente y el cable debe soportar esa protección.</p>
      <div class="fields active" data-fields="cable"><div class="field"><label for="watts">Potencia total (W)</label><input class="control" id="watts" type="number" value="3500" min="1"></div><div class="field"><label for="volts">Tensión (V)</label><select class="control" id="volts"><option value="220">220 V</option><option value="230">230 V</option><option value="110">110 V</option><option value="380">380 V</option></select></div><div class="field"><label for="system">Sistema</label><select class="control" id="system"><option value="mono">Monofásico</option><option value="tri">Trifásico</option></select></div><div class="field"><label for="margin">Margen de seguridad</label><select class="control" id="margin"><option value="1.25">25% recomendado</option><option value="1.15">15%</option><option value="1.4">40%</option></select></div></div>
      <div class="fields" data-fields="drop"><div class="field"><label for="dropA">Corriente (A)</label><input class="control" id="dropA" type="number" value="20" min=".1" step=".1"></div><div class="field"><label for="length">Longitud de ida (m)</label><input class="control" id="length" type="number" value="35" min="1"></div><div class="field"><label for="section">Sección (mm²)</label><select class="control" id="section"><option>1.5</option><option selected>2.5</option><option>4</option><option>6</option><option>10</option><option>16</option></select></div><div class="field"><label for="material">Conductor</label><select class="control" id="material"><option value=".0206">Cobre · 70 °C</option><option value=".0338">Aluminio · 70 °C</option></select></div></div>
      <div class="fields" data-fields="ohm"><div class="field"><label for="ohmV">Tensión (V)</label><input class="control" id="ohmV" type="number" value="12" min="0" step=".1"></div><div class="field"><label for="ohmR">Resistencia (Ω)</label><input class="control" id="ohmR" type="number" value="10" min=".001" step=".1"></div></div>
      <div class="fields" data-fields="power"><div class="field"><label for="kw">Potencia activa (kW)</label><input class="control" id="kw" type="number" value="30" min=".1" step=".1"></div><div class="field"><label for="fpFrom">Factor actual</label><input class="control" id="fpFrom" type="number" value=".72" min=".1" max=".99" step=".01"></div><div class="field"><label for="fpTo">Factor objetivo</label><input class="control" id="fpTo" type="number" value=".95" min=".2" max="1" step=".01"></div><div class="field"><label for="freq">Frecuencia</label><select class="control" id="freq"><option value="50">50 Hz</option><option value="60">60 Hz</option></select></div></div>
      <div class="fields" data-fields="trafo"><div class="field"><label for="primaryV">Tensión primaria (V)</label><input class="control" id="primaryV" type="number" value="220" min="1"></div><div class="field"><label for="primaryN">Espiras primarias</label><input class="control" id="primaryN" type="number" value="1000" min="1"></div><div class="field"><label for="secondaryN">Espiras secundarias</label><input class="control" id="secondaryN" type="number" value="55" min="1"></div><div class="field"><label for="va">Potencia (VA)</label><input class="control" id="va" type="number" value="120" min="1"></div></div>
      <button class="update" id="updateButton" type="button">Actualizar cálculo</button></div>
      <div class="panel result"><div class="kicker" id="kicker">RECOMENDACIÓN DEL CIRCUITO</div><div class="big" id="resultValue">2,5 mm² + térmica 20 A</div><div class="sub" id="resultSub">Para 3.500 W en 220 V monofásicos, con 25% de margen.</div><div class="badge" id="resultBadge">Cable protegido correctamente</div><div class="tiles"><div class="tile"><small id="t1l">Corriente real</small><strong id="t1v">15,9 A</strong></div><div class="tile"><small id="t2l">Corriente de diseño</small><strong id="t2v">19,9 A</strong></div><div class="tile"><small id="t3l">Capacidad del cable</small><strong id="t3v">21 A</strong></div></div></div>
    </div></form></div>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">La secuencia que evita errores</div><h2>Primero la carga. Después la protección. Al final, el cable.</h2><p>La térmica no protege el electrodoméstico: protege el conductor. Y el diferencial protege a las personas.</p></div><div class="steps"><article class="step"><div class="step-num">1</div><h3>Calculá la corriente</h3><p>Sumá las cargas que pueden funcionar juntas y contemplá arranques de motores.</p></article><article class="step"><div class="step-num">2</div><h3>Elegí la térmica</h3><p>Subí al escalón normalizado inmediato y agregá margen para carga continua.</p></article><article class="step"><div class="step-num">3</div><h3>Dimensioná el conductor</h3><p>Debe tolerar la térmica y cumplir la sección mínima del tipo de circuito.</p></article></div></div></section>
    <section class="diagram"><div class="wrap diagram-grid"><div class="section-head"><div class="eyebrow">El sistema completo</div><h2>Una térmica sola no alcanza.</h2><p>La seguridad aparece cuando cada componente cumple una función distinta y coordinada.</p></div><div class="circuit"><div class="flow"><div class="flow-item"><i>⚡</i><b>Red</b></div><div class="arrow">→</div><div class="flow-item"><i>△</i><b>Diferencial</b></div><div class="arrow">→</div><div class="flow-item"><i>▥</i><b>Térmica</b></div><div class="arrow">→</div><div class="flow-item"><i></i><b>Cable</b></div></div><div class="safety"><strong>Importante:</strong> el disyuntor diferencial de 30 mA protege ante fugas. La puesta a tierra sigue siendo indispensable.</div></div></div></section>
    <section class="dark"><div class="wrap dark-grid"><div><div class="eyebrow">La cuenta detrás del resultado</div><h2>Fórmulas claras, supuestos visibles.</h2><div class="formula"><strong id="formula">I = P ÷ V</strong><p id="formulaCopy">En trifásica se usa I = P ÷ (√3 × V × cos φ). Después se aplica el margen de diseño.</p></div></div><div class="checks"><div class="check"><span class="tick">✓</span><span>Secciones normalizadas y térmicas IEC 60898.</span></div><div class="check"><span class="tick">✓</span><span>Caída monofásica con ida y vuelta; trifásica con √3.</span></div><div class="check"><span class="tick">✓</span><span>Resistividad corregida a temperatura de servicio.</span></div><div class="check"><span class="tick">✓</span><span>Advertencias de seguridad siempre visibles.</span></div></div></div></section>
  `} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-instalacion-electrica')?document.currentScript.previousElementSibling:document.querySelector('.mockup-instalacion-electrica');

    const $=id=>root.querySelector("#"+id),fmt=(n,d=1)=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:d}),sections=[{s:1.5,a:15},{s:2.5,a:21},{s:4,a:28},{s:6,a:36},{s:10,a:50},{s:16,a:68},{s:25,a:89}],breakers=[6,10,16,20,25,32,40,50,63];let mode="cable";
    const config={cable:["Dimensioná el circuito","La protección se elige por corriente y el cable debe soportar esa protección."],drop:["Revisá el tramo más desfavorable","La longitud, la corriente y la sección determinan lo que llega al equipo."],ohm:["Relacioná tensión, corriente y resistencia","Con dos datos calculamos corriente y potencia disipada."],power:["Compensá potencia reactiva","Estimá el banco de capacitores necesario para liberar capacidad."],trafo:["Calculá la relación de transformación","La tensión sigue a las espiras; la corriente cambia en sentido inverso."]};
    function set(id,v){$(id).textContent=v}function result(k,v,s,b,t1,v1,t2,v2,t3,v3,f,fc){set("kicker",k);set("resultValue",v);set("resultSub",s);set("resultBadge",b);set("t1l",t1);set("t1v",v1);set("t2l",t2);set("t2v",v2);set("t3l",t3);set("t3v",v3);set("formula",f);set("formulaCopy",fc)}
    function calc(){if(mode==="cable"){let p=+$("watts").value||0,v=+$("volts").value||220,tri=$("system").value==="tri",i=p/(v*(tri?Math.sqrt(3):1)),design=i*(+$("margin").value||1.25),br=breakers.find(x=>x>=design)||63,sec=sections.find(x=>x.a>=br)||sections.at(-1);result("RECOMENDACIÓN DEL CIRCUITO",`${fmt(sec.s)} mm² + térmica ${br} A`,`${fmt(p,0)} W en ${v} V ${tri?"trifásicos":"monofásicos"}, con margen de seguridad.`,sec.a>=br?"Cable protegido correctamente":"Requiere revisión profesional","Corriente real",fmt(i)+" A","Corriente de diseño",fmt(design)+" A","Capacidad del cable",sec.a+" A","I = P ÷ V","En trifásica se divide también por √3 y por el factor de potencia.");set("heroA",fmt(i)+" A")}
      if(mode==="drop"){let i=+$("dropA").value||0,l=+$("length").value||0,s=+$("section").value||1,rho=+$("material").value||.0206,dv=2*rho*l*i/s,pct=dv/220*100;result("CAÍDA DE TENSIÓN",`${fmt(dv,2)} V · ${fmt(pct,2)}%`,`Al final del tramo llegan aproximadamente ${fmt(220-dv,1)} V.`,pct<=3?"Dentro del 3% recomendado":pct<=5?"Aceptable sólo para fuerza":"Caída excesiva","Tensión final",fmt(220-dv,1)+" V","Pérdida",fmt(i*dv,0)+" W","Sección actual",s+" mm²","ΔV = 2ρLI ÷ S","La cuenta monofásica incluye ida y vuelta del conductor.");set("heroA",fmt(i)+" A")}
      if(mode==="ohm"){let v=+$("ohmV").value||0,r=+$("ohmR").value||1,i=v/r,p=v*i;result("LEY DE OHM",`${fmt(i,3)} A`,`${fmt(v,1)} V sobre ${fmt(r,2)} Ω disipan ${fmt(p,2)} W.`,`Verificá la potencia nominal de la resistencia`,"Tensión",fmt(v,1)+" V","Resistencia",fmt(r,2)+" Ω","Potencia",fmt(p,2)+" W","V = I × R","La potencia también puede calcularse como I²R o V²/R.");set("heroA",fmt(i,2)+" A")}
      if(mode==="power"){let p=+$("kw").value||0,a=Math.min(.99,Math.max(.1,+$("fpFrom").value||.72)),b=Math.min(1,Math.max(a,+$("fpTo").value||.95)),q=p*(Math.tan(Math.acos(a))-Math.tan(Math.acos(b))),uf=q*1000000000/(2*Math.PI*(+$("freq").value||50)*220*220);result("COMPENSACIÓN NECESARIA",`${fmt(q,2)} kVAR`,`Para pasar de cos φ ${fmt(a,2)} a ${fmt(b,2)} con ${fmt(p,1)} kW.`,`No reduce los kWh: reduce corriente y penalización`,"Aparente antes",fmt(p/a,1)+" kVA","Aparente después",fmt(p/b,1)+" kVA","Capacitor estimado",fmt(uf,0)+" µF","Qc = P(tan φ₁ − tan φ₂)","El banco debe ser verificado por un profesional, especialmente si hay armónicos.");set("heroA",fmt(p/a,1)+" kVA")}
      if(mode==="trafo"){let vp=+$("primaryV").value||0,np=+$("primaryN").value||1,ns=+$("secondaryN").value||1,va=+$("va").value||0,vs=vp*ns/np,isec=va/vs;result("TENSIÓN SECUNDARIA",`${fmt(vs,2)} V`,`Relación ${fmt(np/ns,2)}:1 para ${fmt(va,0)} VA.`,vs<vp?"Transformador reductor":vs>vp?"Transformador elevador":"Transformador de aislación","Corriente secundaria",fmt(isec,2)+" A","Corriente primaria",fmt(va/vp,2)+" A","Relación",fmt(ns/np,3),"Vs = Vp × Ns ÷ Np","En un transformador ideal la potencia se conserva y la corriente escala al revés.");set("heroA",fmt(vs,1)+" V")}}
    root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".fields").forEach(x=>x.classList.toggle("active",x.dataset.fields===mode));set("formTitle",config[mode][0]);set("formHint",config[mode][1]);calc()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calc));function confirmCalc(){calc();set("updateButton","✓ Cálculo actualizado");clearTimeout(window.timer);window.timer=setTimeout(()=>set("updateButton","Actualizar cálculo"),5000)}$("calculator").addEventListener("submit",e=>{e.preventDefault();confirmCalc()});$("updateButton").addEventListener("click",confirmCalc);calc();
  
})();
</script>
<style is:global>

    .mockup-instalacion-electrica{--ink:#101b34;--muted:#627087;--line:#dfe5ec;--bg:#f5f6f2;--blue:#286be7;--cyan:#26a9ad;--amber:#f0ae48;--navy:#102747;--white:#fff}
    .mockup-instalacion-electrica *{box-sizing:border-box}.mockup-instalacion-electrica{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.mockup-instalacion-electrica .wrap{width:min(1160px,calc(100% - 40px));margin:auto}
    .mockup-instalacion-electrica header{height:86px;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-instalacion-electrica .nav{display:flex;align-items:center;gap:28px}.mockup-instalacion-electrica .brand{font-size:18px;font-weight:950}.mockup-instalacion-electrica .logo{width:28px;height:35px;background:var(--navy);border-radius:4px;display:grid;place-items:center;color:#fff}.mockup-instalacion-electrica .links{display:flex;gap:24px;color:#4e5a6d;font-size:13px;font-weight:800}.mockup-instalacion-electrica .tools{margin-left:auto;display:flex;gap:8px}.mockup-instalacion-electrica .tool{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px;font-weight:750}
    .mockup-instalacion-electrica .hero{display:grid;grid-template-columns:1.08fr .92fr;gap:48px;align-items:center;padding:62px 0 46px}.mockup-instalacion-electrica .crumb{color:#286be7;font-size:14px}.mockup-instalacion-electrica .eyebrow{margin-top:18px;color:#087f84;font-size:12px;font-weight:950;letter-spacing:.13em;text-transform:uppercase}.mockup-instalacion-electrica h1{font-size:clamp(44px,5vw,67px);line-height:.98;letter-spacing:-.055em;margin:11px 0 20px}.mockup-instalacion-electrica .lead{font-size:18px;color:var(--muted);max-width:690px}.mockup-instalacion-electrica .chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.mockup-instalacion-electrica .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:12px;font-weight:850}
    .mockup-instalacion-electrica .visual{height:350px;position:relative}.mockup-instalacion-electrica .board{position:absolute;inset:12px 35px 12px 28px;background:#fff;border:1px solid var(--line);border-radius:30px;box-shadow:0 25px 65px #25334b18}.mockup-instalacion-electrica .rail{position:absolute;left:68px;right:68px;top:74px;height:11px;border-radius:20px;background:#dfe5eb}.mockup-instalacion-electrica .breaker{position:absolute;top:48px;width:81px;height:135px;border-radius:11px;background:#f5f7f9;border:2px solid #d8dfe6;box-shadow:0 8px 15px #1d2c4414}.mockup-instalacion-electrica .breaker.one{left:77px}.mockup-instalacion-electrica .breaker.two{left:167px}.mockup-instalacion-electrica .breaker.three{left:257px}.mockup-instalacion-electrica .switch{width:40px;height:62px;margin:27px auto 0;background:#173a69;border-radius:5px;box-shadow:inset 0 20px #fff}.mockup-instalacion-electrica .breaker.two .switch{background:#e2a23e}.mockup-instalacion-electrica .breaker small{display:block;text-align:center;margin-top:9px;font-weight:900}.mockup-instalacion-electrica .wire{position:absolute;width:12px;border-radius:12px;top:180px;bottom:28px}.mockup-instalacion-electrica .wire.a{left:112px;background:#256ce7}.mockup-instalacion-electrica .wire.b{left:202px;background:#9b7540}.mockup-instalacion-electrica .wire.c{left:292px;background:#e6c241}.mockup-instalacion-electrica .wire.c:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 14px,#41a26f 14px 28px)}.mockup-instalacion-electrica .meter{position:absolute;right:8px;bottom:24px;width:142px;height:142px;border-radius:50%;background:conic-gradient(#29a99e 0 32%,#efb14e 32% 66%,#286be7 66%);border:13px solid #fff;box-shadow:0 12px 36px #24324b2a;display:grid;place-items:center;font-size:25px;font-weight:950}.mockup-instalacion-electrica .meter:before{content:"";position:absolute;inset:22px;background:#fff;border-radius:50%}.mockup-instalacion-electrica .meter span{position:relative}.mockup-instalacion-electrica .bolt{position:absolute;right:26px;top:9px;font-size:58px;color:#e9a331;transform:rotate(8deg)}
    .mockup-instalacion-electrica .calc{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:68px}.mockup-instalacion-electrica .case-label{font-size:12px;font-weight:950;color:#5b6778;margin-bottom:11px}.mockup-instalacion-electrica .cases{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:25px}.mockup-instalacion-electrica .case{min-height:66px;border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:10px;font-size:12px;font-weight:900;color:#505d70;cursor:pointer}.mockup-instalacion-electrica .case span{display:block;font-size:18px;margin-bottom:3px}.mockup-instalacion-electrica .case.active{background:#eef4ff;color:#1b5dca;border-color:#246be7;box-shadow:inset 0 0 0 1px #246be7}.mockup-instalacion-electrica .grid{display:grid;grid-template-columns:1.04fr .96fr;gap:23px}.mockup-instalacion-electrica .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-instalacion-electrica .panel h2{font-size:22px;margin:0 0 5px}.mockup-instalacion-electrica .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-instalacion-electrica .fields{display:none;grid-template-columns:1fr 1fr;gap:14px}.mockup-instalacion-electrica .fields.active{display:grid}.mockup-instalacion-electrica .field.full{grid-column:1/-1}.mockup-instalacion-electrica .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-instalacion-electrica .control{width:100%;height:50px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-instalacion-electrica .control:focus{border-color:#286fe8;box-shadow:0 0 0 3px #286fe818}.mockup-instalacion-electrica .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
    .mockup-instalacion-electrica .result{background:linear-gradient(145deg,#12345f,#0b1e3b);border:0;color:#fff;position:relative;overflow:hidden}.mockup-instalacion-electrica .result:after{content:"";position:absolute;width:220px;height:220px;border:45px solid #2ab6aa20;border-radius:50%;right:-125px;bottom:-130px}.mockup-instalacion-electrica .kicker{font-size:11px;letter-spacing:.13em;color:#9fe1d6;font-weight:950}.mockup-instalacion-electrica .big{font-size:38px;line-height:1.08;font-weight:950;letter-spacing:-.035em;margin:15px 0 7px;max-width:460px}.mockup-instalacion-electrica .sub{color:#c2d2e4;max-width:500px}.mockup-instalacion-electrica .badge{display:inline-flex;margin-top:16px;padding:8px 11px;border-radius:99px;background:#1e4777;border:1px solid #416992;font-size:12px;font-weight:850}.mockup-instalacion-electrica .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}.mockup-instalacion-electrica .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px;position:relative;z-index:1}.mockup-instalacion-electrica .tile small{display:block;color:#b6c7db;text-transform:uppercase;font-size:9px;letter-spacing:.07em}.mockup-instalacion-electrica .tile strong{display:block;margin-top:5px;font-size:15px}
    .mockup-instalacion-electrica section{padding:70px 0}.mockup-instalacion-electrica .section-head{max-width:760px;margin-bottom:27px}.mockup-instalacion-electrica .section-head h2,.mockup-instalacion-electrica .dark h2{font-size:39px;line-height:1.05;letter-spacing:-.04em;margin:9px 0}.mockup-instalacion-electrica .section-head p{color:var(--muted);font-size:17px}.mockup-instalacion-electrica .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.mockup-instalacion-electrica .step{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px}.mockup-instalacion-electrica .step-num{width:37px;height:37px;border-radius:11px;background:#eaf2ff;color:#286be7;display:grid;place-items:center;font-weight:950}.mockup-instalacion-electrica .step h3{margin:16px 0 7px}.mockup-instalacion-electrica .step p{margin:0;color:var(--muted)}
