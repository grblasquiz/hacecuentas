---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-sistemas-matrices" set:html={`<div class="crumb">Matemática / Álgebra lineal</div><h1>Hacé cero lo que molesta.</h1><p class="lead">Editá la matriz aumentada y seguí cómo la eliminación transforma dos ecuaciones en una solución.</p><section class="board"><div><div class="matrix" id="matrix"><input class="cell" id="a" value="2" type="number"><input class="cell" id="b" value="1" type="number"><input class="cell" id="e" value="7" type="number"><input class="cell" id="c" value="1" type="number"><input class="cell" id="d" value="-1" type="number"><input class="cell" id="f" value="2" type="number"></div><div class="rows"><div class="row"><i>1</i><span id="eq1"></span></div><div class="row"><i>2</i><span id="eq2"></span></div></div></div><div class="operations"><button id="swap">R₁ ↔ R₂</button><button id="eliminate">Eliminar x</button><button id="reset">Restaurar ejemplo</button></div><aside class="solution"><h2>Diagnóstico del sistema</h2><b id="answer"></b><p id="detail"></p><div class="status" id="status"></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sistemas-matrices')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sistemas-matrices');

const $=x=>root.querySelector("#"+x),ids=['a','b','e','c','d','f'];function render(){let [a,b,e,c,d,f]=ids.map(x=>+$((x)).value),det=a*d-b*c;$('eq1').textContent=`${a}x ${b>=0?'+':'−'} ${Math.abs(b)}y = ${e}`;$('eq2').textContent=`${c}x ${d>=0?'+':'−'} ${Math.abs(d)}y = ${f}`;if(Math.abs(det)<1e-9){let same=Math.abs(a*f-c*e)<1e-9&&Math.abs(b*f-d*e)<1e-9;$('answer').textContent=same?'∞ soluciones':'sin solución';$('detail').textContent=same?'Las filas representan la misma recta.':'Las rectas son paralelas.';$('status').textContent='Determinante = 0'}else{let x=(e*d-b*f)/det,y=(a*f-e*c)/det;$('answer').textContent=`x = ${x.toFixed(2)}`;$('detail').textContent=`y = ${y.toFixed(2)}`;$('status').textContent=`Determinante ${det.toFixed(2)}: solución única.`}}
$('swap').onclick=()=>{for(const [x,y] of [['a','c'],['b','d'],['e','f']])[$(x).value,$(y).value]=[$(y).value,$(x).value];render()};$('eliminate').onclick=()=>{$('status').textContent=`R₂ ← R₂ − (${$('c').value}/${$('a').value})R₁. La primera columna queda en cero.`};$('reset').onclick=()=>{[2,1,7,1,-1,2].forEach((v,i)=>$(ids[i]).value=v);render()};root.querySelectorAll('input').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-sistemas-matrices{--blue:#174b7a;--ink:#182a32;--muted:#64737b;--line:#d7e1df;--green:#399c76;--yellow:#ffd46d;--red:#d95f54;--paper:#f4f7f5}.mockup-sistemas-matrices *{box-sizing:border-box}.mockup-sistemas-matrices{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-sistemas-matrices input,.mockup-sistemas-matrices button{font:inherit}.mockup-sistemas-matrices .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-sistemas-matrices .crumb{color:var(--blue);font-weight:850}.mockup-sistemas-matrices h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-sistemas-matrices .lead{font-size:18px;color:var(--muted)}.mockup-sistemas-matrices .board{margin-top:28px;background:#fff;border:1px solid var(--line);border-radius:26px;padding:28px;display:grid;grid-template-columns:1fr 210px 1fr;gap:22px;align-items:center}.mockup-sistemas-matrices .matrix{display:grid;grid-template-columns:repeat(3,80px);gap:8px;justify-content:center;position:relative;padding:12px 20px}.mockup-sistemas-matrices .matrix:before,.mockup-sistemas-matrices .matrix:after{content:"";position:absolute;top:0;bottom:0;width:12px;border-top:4px solid var(--blue);border-bottom:4px solid var(--blue)}.mockup-sistemas-matrices .matrix:before{left:0;border-left:4px solid var(--blue)}.mockup-sistemas-matrices .matrix:after{right:0;border-right:4px solid var(--blue)}.mockup-sistemas-matrices .cell{border:1px solid var(--line);border-radius:10px;padding:12px;text-align:center;font-weight:900;color:var(--ink)}.mockup-sistemas-matrices input.cell{width:80px}.mockup-sistemas-matrices .operations{display:grid;gap:8px}.mockup-sistemas-matrices .operations button{border:1px solid var(--line);border-radius:12px;background:#fff;padding:11px;font-weight:800;color:var(--ink)}.mockup-sistemas-matrices .operations button:hover{background:var(--yellow)}.mockup-sistemas-matrices .solution{background:var(--blue);color:#fff;border-radius:22px;padding:23px}.mockup-sistemas-matrices .solution h2{font-size:14px;text-transform:uppercase;letter-spacing:.12em;margin:0}.mockup-sistemas-matrices .solution b{display:block;font-size:38px;margin:13px 0}.mockup-sistemas-matrices .solution p{color:#dbe9ef}.mockup-sistemas-matrices .status{padding:12px;border-radius:12px;background:#ffffff18}.mockup-sistemas-matrices .rows{margin-top:22px;display:grid;gap:8px}.mockup-sistemas-matrices .row{display:grid;grid-template-columns:40px 1fr;gap:10px;align-items:center}.mockup-sistemas-matrices .row i{width:32px;height:32px;border-radius:50%;background:var(--green);display:grid;place-items:center;color:#fff;font-style:normal}@media(max-width:850px){.mockup-sistemas-matrices .board{grid-template-columns:1fr}.mockup-sistemas-matrices .matrix{grid-template-columns:repeat(3,64px)}.mockup-sistemas-matrices input.cell{width:64px}}
.mockup-sistemas-matrices { width:100%; overflow:hidden; }
.mockup-sistemas-matrices .top, .mockup-sistemas-matrices header.top { display:none !important; }
.mockup-sistemas-matrices .foot { display:none !important; }
.mockup-sistemas-matrices .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-sistemas-matrices .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-sistemas-matrices .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-sistemas-matrices .support-real summary { cursor:pointer; font-weight:750; }
.mockup-sistemas-matrices .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-sistemas-matrices :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-sistemas-matrices input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-sistemas-matrices input[type="number"]::-webkit-inner-spin-button, .mockup-sistemas-matrices input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-sistemas-matrices .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-sistemas-matrices support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
