---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-fracciones" set:html={`<div class="crumb">Matemática / Fracciones</div><h1>Si podés verlo, podés operarlo.</h1><p class="lead">Armá dos porciones, elegí la operación y seguí cómo se llega al denominador común.</p><div class="counter"><input id="a" type="number" value="2" min="0"><span>/</span><input id="b" type="number" value="3" min="1"><button id="swap">Invertir</button></div><section class="table"><div class="plate"><div class="pie" id="pie1"></div><div id="label1"></div></div><div class="operator"><span id="opSign">+</span><select id="op"><option value="+">Sumar</option><option value="-">Restar</option><option value="*">Multiplicar</option><option value="/">Dividir</option></select></div><div><div class="counter"><input id="c" type="number" value="1" min="0"><span>/</span><input id="d" type="number" value="4" min="1"></div><div class="plate"><div class="pie" id="pie2"></div></div></div></section><div class="answer">Resultado simplificado: <b id="result"></b></div><div class="steps" id="steps"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-fracciones')?document.currentScript.previousElementSibling:document.querySelector('.mockup-fracciones');

const $=x=>root.querySelector("#"+x),gcd=(a,b)=>b?gcd(b,a%b):Math.abs(a);function render(){let a=+$('a').value,b=Math.max(1,+$('b').value),c=+$('c').value,d=Math.max(1,+$('d').value),op=$('op').value,n,q,ex;if(op==='+'){n=a*d+c*b;q=b*d;ex=[`${a*d}/${b*d}`,`${c*b}/${d*b}`,'Sumamos numeradores']}if(op==='-'){n=a*d-c*b;q=b*d;ex=[`${a*d}/${b*d}`,`${c*b}/${d*b}`,'Restamos numeradores']}if(op==='*'){n=a*c;q=b*d;ex=['Numerador × numerador','Denominador × denominador','Simplificamos']}if(op==='/'){n=a*d;q=b*c||1;ex=['Invertimos la segunda','Multiplicamos en cruz','Simplificamos']}let g=gcd(n,q)||1;$('result').textContent=`${n/g}/${q/g}`;$('opSign').textContent=op;$('pie1').style.setProperty('--fill',Math.min(100,a/b*100)+'%');$('pie1').dataset.label=`${a}/${b}`;$('pie2').style.setProperty('--fill',Math.min(100,c/d*100)+'%');$('pie2').dataset.label=`${c}/${d}`;$('steps').innerHTML=ex.map((x,i)=>`<div class="step"><b>${i+1}</b>${x}</div>`).join('')}
$('swap').onclick=()=>{[$('a').value,$('b').value]=[$('b').value,$('a').value];render()};root.querySelectorAll('input,select').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-fracciones{--blue:#174b7a;--ink:#182830;--muted:#64727a;--line:#d8e1df;--orange:#e77745;--cream:#fff2d6;--paper:#f5f7f5}.mockup-fracciones *{box-sizing:border-box}.mockup-fracciones{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-fracciones button,.mockup-fracciones input{font:inherit}.mockup-fracciones .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-fracciones .crumb{color:var(--blue);font-weight:850}.mockup-fracciones h1{font-size:clamp(42px,6vw,70px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-fracciones .lead{font-size:18px;color:var(--muted);max-width:740px}.mockup-fracciones .counter{display:flex;gap:8px;align-items:center;margin:28px 0}.mockup-fracciones .counter input{width:72px;border:2px solid var(--line);border-radius:12px;padding:11px;text-align:center;font-weight:900}.mockup-fracciones .counter span{font-size:32px}.mockup-fracciones .counter button{border:0;background:var(--blue);color:#fff;border-radius:12px;padding:12px 18px;font-weight:900}.mockup-fracciones .table{display:grid;grid-template-columns:1fr 180px 1fr;gap:20px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px}.mockup-fracciones .plate{display:grid;place-items:center}.mockup-fracciones .pie{width:260px;height:260px;border-radius:50%;background:conic-gradient(var(--orange) 0 var(--fill),#e8eeeb var(--fill));border:12px solid #fff;box-shadow:0 15px 40px #173d4c20;position:relative}.mockup-fracciones .pie:after{content:attr(data-label);position:absolute;inset:72px;border-radius:50%;background:#fff;display:grid;place-items:center;font-size:34px;font-weight:950;color:var(--blue)}.mockup-fracciones .operator{text-align:center;font-size:48px;font-weight:950;color:var(--orange)}.mockup-fracciones .operator select{display:block;width:100%;border:1px solid var(--line);border-radius:12px;padding:10px;margin-top:12px;font-weight:800;color:var(--ink)}.mockup-fracciones .answer{margin-top:20px;background:var(--cream);border-radius:18px;padding:18px;text-align:center}.mockup-fracciones .answer b{font-size:30px;color:var(--blue)}.mockup-fracciones .steps{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}.mockup-fracciones .step{flex:1;min-width:210px;background:#fff;border:1px solid var(--line);border-radius:15px;padding:15px}.mockup-fracciones .step b{display:block;color:var(--orange);margin-bottom:5px}@media(max-width:760px){.mockup-fracciones .table{grid-template-columns:1fr}.mockup-fracciones .operator{font-size:30px}.mockup-fracciones .pie{width:210px;height:210px}.mockup-fracciones .pie:after{inset:58px}}
.mockup-fracciones { width:100%; overflow:hidden; }
.mockup-fracciones .top, .mockup-fracciones header.top { display:none !important; }
.mockup-fracciones .foot { display:none !important; }
.mockup-fracciones .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-fracciones .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-fracciones .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-fracciones .support-real summary { cursor:pointer; font-weight:750; }
.mockup-fracciones .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-fracciones :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-fracciones input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-fracciones input[type="number"]::-webkit-inner-spin-button, .mockup-fracciones input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-fracciones .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-fracciones support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
