<div class="mockup-horas-extras-colombia" set:html={`<section class="hero"><div class="wrap crumb"><b>Colombia</b> &nbsp;/&nbsp; Trabajo &nbsp;/&nbsp; Horas extras y recargos</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Nómina laboral 2026</span><h1>Calculá cuánto<br>vale cada hora que<br>trabajaste de más.</h1><p>Separá extras diurnas, nocturnas, dominicales y festivas. Te mostramos el valor unitario y el total que debería aparecer en tu nómina.</p><div class="chips"><span>🕖 Noche desde 19:00</span><span>📅 Dominical 90%</span><span>✓ Jornada de 42 h</span></div><div class="car-art"><div class="road"></div><div style="position:absolute;left:95px;bottom:55px;width:195px;height:195px;border-radius:50%;background:#fff;border:18px solid #75cbb9;box-shadow:0 18px 35px #17385818"></div><div style="position:absolute;left:189px;bottom:143px;width:7px;height:66px;background:#17324f;transform-origin:bottom;transform:rotate(28deg);border-radius:9px"></div><div style="position:absolute;left:189px;bottom:143px;width:55px;height:7px;background:#17324f;border-radius:9px"></div><div class="fuel-card"><small>TOTAL POR ESAS HORAS</small><strong id="art-value">$83.376</strong><span id="art-place">8 horas extra diurnas</span></div></div></div>
<form class="calc"><div class="calc-title"><div><h2>Liquidá tus horas</h2><p>Elegí el tipo que trabajaste.</p></div><span class="tag">Ley 2466 · 2025</span></div><div class="section-label">¿Qué tipo de hora fue?</div><div class="cases"><button type="button" class="case active" data-mode="dayextra"><i>☀️</i>Extra diurna</button><button type="button" class="case" data-mode="nightextra"><i>🌙</i>Extra nocturna</button><button type="button" class="case" data-mode="night"><i>🕖</i>Recargo nocturno</button><button type="button" class="case" data-mode="sunday"><i>📅</i>Domingo o festivo</button></div><div class="section-label">Datos de tu jornada</div><div class="fields"><div class="field wide"><label>Salario mensual</label><div class="inline"><b>$</b><input id="salary" type="number" value="1750905"></div></div><div class="field"><label>Horas trabajadas</label><div class="inline"><input id="hours" type="number" step=".5" value="8"><b>horas</b></div></div><div class="field"><label>Fecha en que las trabajaste</label><input id="date" type="date" value="2026-07-28"></div><div class="field wide"><label>¿Fue también de noche?</label><select id="night-sunday"><option value="0">No, fue de día</option><option value=".35">Sí, entre 19:00 y 06:00</option></select></div><div class="field wide"><label>¿Cuánto te pagaron por esas horas? · opcional</label><div class="inline"><b>$</b><input id="paid" type="number" min="0" placeholder="Dejalo vacío si todavía no cobraste"></div></div></div><div class="advanced"><span id="formula-note">Hora ordinaria × 1,25 × horas</span><button type="button" id="advanced-toggle">+ Ver límites</button></div><div class="extra" id="extra-fields"><div class="field"><label>Horas extra esta semana</label><input id="weekly" type="number" value="8"></div><div class="field"><label>Horas extra en el día</label><input id="daily" type="number" value="2"></div></div><section class="result"><div class="result-top"><div><small id="result-label">Total por horas extra diurnas</small><div class="value" id="result-value">$83.376</div></div><div class="verdict"><small>Recargo aplicado</small><strong id="verdict">25%</strong></div></div><div class="stats"><span>Hora ordinaria<b id="s1">$8.338</b></span><span>Valor de cada hora<b id="s2">$10.422</b></span><span>Extra sobre tu salario<b id="s3">$16.675</b></span></div><div class="paid-verdict" id="paid-verdict" hidden></div><button class="go" id="update" type="button">Actualizar liquidación</button></section></form></div></section>
<section class="scale-section"><div class="wrap"><header class="center"><span>La escalera de recargos</span><h2>Cada tipo de hora tiene un multiplicador distinto</h2><p>El marcador muestra el porcentaje adicional sobre la hora ordinaria.</p></header><div class="scale-card"><div class="meter"><i class="pin" id="pin" data-value="+25%"></i></div><div class="meter-labels"><div><b>Recargo nocturno</b>+35%</div><div><b>Extra diurna</b>+25% · factor 1,25</div><div><b>Extra nocturna / dominical</b>Hasta +110%</div></div><div class="meter-summary"><span id="scale-copy">La hora base usa divisor 210 desde el 15-jul-2026.</span><b id="scale-result">$10.422 por hora</b></div></div></div></section>
<section class="breakdown"><div class="wrap break-grid"><article class="card"><h3>De tu salario a esa hora</h3><div class="line"><span>Salario mensual</span><b id="d1">$1.750.905</b></div><div class="line"><span>Divisor de jornada</span><b id="d2">210 horas</b></div><div class="line"><span>Hora ordinaria</span><b id="d3">$8.338</b></div><div class="line"><span id="d4l">Factor aplicado</span><b id="d4">1,25</b></div><div class="line total"><strong>Total por 8 horas</strong><b id="df">$83.376</b></div></article><article class="card"><h3>No confundas estos casos</h3><div class="step"><i>1</i><div><b>Recargo nocturno</b><span>Está dentro de tu jornada normal, pero de noche.</span></div></div><div class="step"><i>2</i><div><b>Hora extra nocturna</b><span>Supera tu jornada y además ocurre de noche.</span></div></div><div class="step"><i>3</i><div><b>Domingo o festivo</b><span>Puede acumular recargo nocturno si corresponde.</span></div></div><div class="warning" id="limit-warning">⚠️ Límite general: 2 horas extra al día y 12 por semana. Guardá registros de entrada y salida.</div></article></div></section>
<section class="tips"><div class="wrap"><header class="center"><span>Porcentajes vigentes</span><h2>La guía rápida para revisar tu nómina</h2></header><div class="tip-grid"><article class="tip"><i>☀️</i><h3>Extra diurna</h3><p>Por encima de la jornada, en horario diurno.</p><span class="impact">+25%</span></article><article class="tip"><i>🌙</i><h3>Extra nocturna</h3><p>Por encima de la jornada, entre 19:00 y 06:00.</p><span class="impact">+75%</span></article><article class="tip"><i>🕖</i><h3>Nocturno ordinario</h3><p>Turno habitual dentro del horario nocturno.</p><span class="impact">+35%</span></article><article class="tip"><i>📅</i><h3>Dominical 2026</h3><p>Trabajo habitual u ocasional en domingo o festivo.</p><span class="impact">+90%</span></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">El cambio de julio</span><h2>La misma hora vale más desde el 15 de julio de 2026.</h2><p>Al bajar el divisor mensual de 220 a 210, subió el valor de la hora ordinaria y todos sus recargos.</p></div><div class="compare"><div><small>ANTES DEL 15-JUL</small><b id="cmp1">$7.959</b><span>Salario ÷ 220</span></div><div><small>DESDE EL 15-JUL</small><b id="cmp2">$8.338</b><span>Salario ÷ 210</span></div><div><small>DIFERENCIA</small><b id="cmp3">+4,76%</b><span>Sin cambiar el salario</span></div></div></div></section><div class="foot"></div><button type="button" id="date-result" hidden aria-hidden="true"></button><button type="button" id="progress-result" hidden aria-hidden="true"></button><button type="button" id="fund-result" hidden aria-hidden="true"></button><button type="button" id="art-consumption" hidden aria-hidden="true"></button><button type="button" id="art-cost" hidden aria-hidden="true"></button><button type="button" id="scale-verdict" hidden aria-hidden="true"></button><button type="button" id="detail-last" hidden aria-hidden="true"></button><button type="button" id="detail-interval" hidden aria-hidden="true"></button><button type="button" id="detail-used" hidden aria-hidden="true"></button><button type="button" id="detail-next" hidden aria-hidden="true"></button><button type="button" id="detail-left" hidden aria-hidden="true"></button><button type="button" id="cmp-low" hidden aria-hidden="true"></button><button type="button" id="cmp-current" hidden aria-hidden="true"></button><button type="button" id="cmp-high" hidden aria-hidden="true"></button><button type="button" id="cmp-current-cost" hidden aria-hidden="true"></button><button type="button" id="province" hidden aria-hidden="true"></button><button type="button" id="rate" hidden aria-hidden="true"></button><button type="button" id="quota-value" hidden aria-hidden="true"></button><button type="button" id="cash-value" hidden aria-hidden="true"></button><button type="button" id="month-value" hidden aria-hidden="true"></button><button type="button" id="d-valuation" hidden aria-hidden="true"></button><button type="button" id="d-rate" hidden aria-hidden="true"></button><button type="button" id="d-year" hidden aria-hidden="true"></button><button type="button" id="d-discount" hidden aria-hidden="true"></button><button type="button" id="d-final" hidden aria-hidden="true"></button><button type="button" id="cmp-name" hidden aria-hidden="true"></button><button type="button" id="digits" hidden aria-hidden="true"></button><button type="button" id="d1l" hidden aria-hidden="true"></button><button type="button" id="d2l" hidden aria-hidden="true"></button><button type="button" id="d3l" hidden aria-hidden="true"></button><button type="button" id="df-label" hidden aria-hidden="true"></button><button type="button" id="pre2" hidden aria-hidden="true"></button><button type="button" id="pre3" hidden aria-hidden="true"></button><button type="button" id="cl-search" hidden aria-hidden="true"></button><button type="button" id="no-results" hidden aria-hidden="true"></button><button type="button" id="cl-search-btn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-horas-extras-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-horas-extras-colombia');


let hourMode="dayextra";const h$=s=>root.querySelector(s),hn=id=>Math.max(0,Number(h$(id).value)||0),hm=x=>"$"+new Intl.NumberFormat("es-CO",{maximumFractionDigits:0}).format(x),hourCfg={dayextra:{label:"horas extra diurnas",factor:1.25,rec:25},nightextra:{label:"horas extra nocturnas",factor:1.75,rec:75},night:{label:"recargo nocturno",factor:.35,rec:35},sunday:{label:"horas dominicales o festivas",factor:1.9,rec:90}};
function hourCalc(){let salary=hn("#salary"),hours=hn("#hours"),date=h$("#date").value,divisor=date>="2026-07-15"?210:220,c=hourCfg[hourMode],extraNight=hourMode==="sunday"?Number(h$("#night-sunday").value):0,factor=c.factor+extraNight,ordinary=salary/divisor,each=ordinary*factor,total=each*hours,weekly=hn("#weekly"),daily=hn("#daily");h$("#result-label").textContent="Total por "+c.label;h$("#result-value").textContent=hm(total);h$("#verdict").textContent=(c.rec+extraNight*100).toFixed(0)+"%";h$("#s1").textContent=hm(ordinary);h$("#s2").textContent=hm(each);h$("#s3").textContent=hm(Math.max(0,total-ordinary*hours));h$("#art-value").textContent=hm(total);h$("#art-place").textContent=hours+" "+c.label;h$("#formula-note").textContent="Hora ordinaria × "+factor.toFixed(2).replace(".",",")+" × horas";h$("#pin").style.left=Math.max(3,Math.min(97,(c.rec+extraNight*100)/120*100))+"%";h$("#pin").dataset.value="+"+(c.rec+extraNight*100).toFixed(0)+"%";h$("#scale-result").textContent=hm(each)+" por hora";h$("#d1").textContent=hm(salary);h$("#d2").textContent=divisor+" horas";h$("#d3").textContent=hm(ordinary);h$("#d4").textContent=factor.toFixed(2).replace(".",",");h$("#df").textContent=hm(total);h$("#cmp1").textContent=hm(salary/220);h$("#cmp2").textContent=hm(salary/210);h$("#limit-warning").textContent=weekly>12||daily>2?"⚠️ Superás el límite general de 2 horas por día o 12 por semana. Igual deben pagarlas.":"⚠️ Límite general: 2 horas extra al día y 12 por semana. Guardá registros de entrada y salida.";const paidRaw=h$("#paid").value,pv=h$("#paid-verdict");if(paidRaw===""||!(Number(paidRaw)>0)){pv.hidden=true}else{const paid=Number(paidRaw),diff=total-paid;pv.hidden=false;if(diff<=total*.01){pv.className="paid-verdict ok";pv.textContent="Te pagaron bien ✓ — lo cobrado cubre lo que corresponde por ley."}else{pv.className="paid-verdict owe";pv.innerHTML="Te deben <b>"+hm(diff)+"</b> de diferencia — el reclamo prescribe a los 3 años. Podés reclamar ante el <a href=\"https://www.mintrabajo.gov.co\" target=\"_blank\" rel=\"noopener\">Ministerio del Trabajo</a>."}}}
root.querySelectorAll(".case").forEach(x=>x.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(y=>y.classList.remove("active"));x.classList.add("active");hourMode=x.dataset.mode;hourCalc()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",hourCalc));h$("#advanced-toggle").addEventListener("click",e=>{h$("#extra-fields").classList.toggle("open");e.currentTarget.textContent=h$("#extra-fields").classList.contains("open")?"− Ocultar límites":"+ Ver límites"});h$("#update").addEventListener("click",e=>{e.preventDefault();hourCalc();e.currentTarget.textContent="✓ Liquidación actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar liquidación",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());hourCalc();

})();
</script>
