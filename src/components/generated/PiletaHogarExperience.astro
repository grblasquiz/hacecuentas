---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-pileta-hogar" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Hogar / Pileta</div><div class="eyebrow">Plano de agua y filtrado</div><h1>Primero calculá cuánta agua tenés.</h1><p class="lead">La capacidad define bomba, tiempo de filtrado y dosificación. Dibujá la forma y usá profundidad media, no la máxima.</p></div><div class="pool-top"><span class="dimension long" id="topLong">8,0 m</span><span class="dimension wide" id="topWide">4,0 m</span></div></div></section>
<section class="workbench"><div class="bench"><aside class="measurements"><h2>Medidas de la pileta</h2><p>Elegí la forma que más se aproxima. Para formas irregulares, dividila en sectores.</p><div class="shapes"><button class="shape active" data-shape="rect"><i></i>RECTANGULAR</button><button class="shape" data-shape="round"><i></i>CIRCULAR</button><button class="shape" data-shape="oval"><i></i>OVALADA</button></div><div class="field"><label for="length"><span id="lengthLabel">LARGO</span><output id="lengthOut">8,0 m</output></label><input id="length" type="number" value="8" min=".5" max="100" step=".1"></div><div class="field" id="widthField"><label for="width"><span>ANCHO</span><output id="widthOut">4,0 m</output></label><input id="width" type="number" value="4" min=".5" max="100" step=".1"></div><div class="field"><label for="shallow"><span>PROFUNDIDAD MENOR</span><output id="shallowOut">1,0 m</output></label><input id="shallow" type="number" value="1" min=".2" max="10" step=".1"></div><div class="field"><label for="deep"><span>PROFUNDIDAD MAYOR</span><output id="deepOut">1,8 m</output></label><input id="deep" type="number" value="1.8" min=".2" max="10" step=".1"><small>Promediamos ambos extremos.</small></div><div class="field"><label for="turnover"><span>RECIRCULACIONES POR DÍA</span><output id="turnoverOut">2</output></label><input id="turnover" type="range" value="2" min="1" max="4"></div></aside><section class="blueprint" aria-live="polite"><div class="blueprint-head"><div><small>CAPACIDAD APROXIMADA</small><h2 id="volumeM3">44,8 m³</h2></div><div class="liters" id="liters">44.800 L</div></div><div class="section-view"><div class="waterline"></div><div class="depth-line"><span id="avgDepth">1,40 m media</span></div></div><div class="system"><div class="system-card"><small>CAUDAL MÍNIMO EN 6 H</small><b id="flow">7,5 m³/h</b></div><div class="system-card"><small>FILTRADO DIARIO</small><b id="filterHours">12 horas</b></div><div class="system-card"><small>REPOSICIÓN DEL 5%</small><b id="refill">2.240 L</b></div></div><div class="maintenance"><b id="maintenanceTitle">Dimensioná productos para 44.800 litros</b><span>No mostramos una dosis universal: medí pH y desinfectante y seguí la etiqueta del producto específico.</span></div></section></div></section>
<section class="routine"><div class="wrap routine-grid"><div><div class="kicker">Rutina basada en mediciones</div><h2>Volumen para dimensionar; análisis para dosificar</h2><p>El agua cambia con temperatura, lluvia, bañistas y exposición solar.</p></div><div class="routine-cards"><div class="routine-card"><b>Cada día de uso</b><span>Retirá residuos y observá claridad, circulación y nivel.</span></div><div class="routine-card"><b>Varias veces por semana</b><span>Medí pH y desinfectante antes de agregar productos.</span></div><div class="routine-card"><b>Después de lluvia o mucha gente</b><span>Volvé a medir y revisá presión del filtro; no dosifiques a ciegas.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-pileta-hogar')?document.currentScript.previousElementSibling:document.querySelector('.mockup-pileta-hogar');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let shape="rect";const fmt=(n,d=1)=>n.toLocaleString("es-AR",{minimumFractionDigits:d,maximumFractionDigits:d});function calc(){const l=Math.max(.1,+$("#length").value||0),w=Math.max(.1,+$("#width").value||0),s=Math.max(.1,+$("#shallow").value||0),d=Math.max(.1,+$("#deep").value||0),avg=(s+d)/2,turn=+$("#turnover").value||1,factor=shape==="rect"?1:Math.PI/4,area=shape==="round"?l*l*factor:l*w*factor,vol=area*avg,liters=vol*1000,flow=vol/6;$("#lengthOut").textContent=fmt(l)+" m";$("#widthOut").textContent=fmt(w)+" m";$("#shallowOut").textContent=fmt(s)+" m";$("#deepOut").textContent=fmt(d)+" m";$("#turnoverOut").textContent=turn;$("#topLong").textContent=fmt(l)+" m";$("#topWide").textContent=shape==="round"?"diámetro":fmt(w)+" m";$("#avgDepth").textContent=fmt(avg,2)+" m media";$("#volumeM3").textContent=fmt(vol)+" m³";$("#liters").textContent=Math.round(liters).toLocaleString("es-AR")+" L";$("#flow").textContent=fmt(flow)+" m³/h";$("#filterHours").textContent=turn*6+" horas";$("#refill").textContent=Math.round(liters*.05).toLocaleString("es-AR")+" L";$("#maintenanceTitle").textContent="Dimensioná productos para "+Math.round(liters).toLocaleString("es-AR")+" litros";$("#widthField").style.display=shape==="round"?"none":"block";$("#lengthLabel").textContent=shape==="round"?"DIÁMETRO":"LARGO"}$$("[data-shape]").forEach(b=>b.addEventListener("click",()=>{shape=b.dataset.shape;$$("[data-shape]").forEach(x=>x.classList.toggle("active",x===b));calc()}));$$("input").forEach(x=>x.addEventListener("input",calc));calc()})();
})();
</script>
<style is:global>

.mockup-pileta-hogar{--blue:#174b7a;--water:#2788a8;--aqua:#e4f5f9;--sand:#fff7e6;--green:#e1f1e9;--ink:#182332;--muted:#5f6977;--line:#d7e1e4}.mockup-pileta-hogar *{box-sizing:border-box}.mockup-pileta-hogar{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#f6fafb}.mockup-pileta-hogar button,.mockup-pileta-hogar input,.mockup-pileta-hogar select{font:inherit}.mockup-pileta-hogar .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-pileta-hogar .brand{font-size:19px;font-weight:950}.mockup-pileta-hogar .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-pileta-hogar .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-pileta-hogar .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-pileta-hogar .hero{padding:42px 22px 50px;background:#fff}.mockup-pileta-hogar .hero-grid,.mockup-pileta-hogar .wrap{max-width:1180px;margin:auto}.mockup-pileta-hogar .hero-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:55px;align-items:center}.mockup-pileta-hogar .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-pileta-hogar .eyebrow{margin-top:25px;color:var(--water);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-pileta-hogar .hero h1{font-size:clamp(43px,5vw,64px);line-height:.98;letter-spacing:-.05em;margin:9px 0 18px}.mockup-pileta-hogar .lead{font-size:19px;color:var(--muted)}.mockup-pileta-hogar .pool-top{height:320px;border:9px solid #fff;outline:3px solid var(--blue);border-radius:105px 28px 105px 28px;background:repeating-radial-gradient(ellipse at 30px 20px,#4aaac8 0 18px,#57b5d0 19px 35px);position:relative;box-shadow:0 22px 45px #17374a17}.mockup-pileta-hogar .pool-top:before,.mockup-pileta-hogar .pool-top:after{content:"";position:absolute;background:#fff}.mockup-pileta-hogar .pool-top:before{width:80px;height:14px;right:40px;top:40px;border-radius:10px}.mockup-pileta-hogar .pool-top:after{width:14px;height:80px;right:40px;top:40px;border-radius:10px}.mockup-pileta-hogar .dimension{position:absolute;padding:6px 9px;background:#fff;color:var(--blue);border-radius:8px;font-size:11px;font-weight:950}.mockup-pileta-hogar .dimension.long{left:50%;bottom:20px;transform:translateX(-50%)}.mockup-pileta-hogar .dimension.wide{left:20px;top:50%;transform:translateY(-50%) rotate(-90deg)}.mockup-pileta-hogar .workbench{padding:0 22px 70px}.mockup-pileta-hogar .bench{max-width:1180px;margin:auto;display:grid;grid-template-columns:380px 1fr;gap:22px;align-items:start}.mockup-pileta-hogar .measurements{background:#fff;border:1px solid var(--line);border-radius:20px;padding:23px}.mockup-pileta-hogar .measurements h2{font-size:23px;margin:0 0 5px}.mockup-pileta-hogar .measurements>p{font-size:12px;color:var(--muted);margin:0 0 19px}.mockup-pileta-hogar .shapes{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:17px}.mockup-pileta-hogar .shape{height:76px;border:1px solid var(--line);border-radius:11px;background:#fff;color:var(--ink);cursor:pointer;display:grid;place-items:center;font-size:10px;font-weight:900}.mockup-pileta-hogar .shape i{display:block;width:44px;height:28px;border:3px solid var(--water);margin:auto;border-radius:3px}.mockup-pileta-hogar .shape[data-shape=round] i{border-radius:50%}.mockup-pileta-hogar .shape[data-shape=oval] i{border-radius:50%}.mockup-pileta-hogar .shape.active{border:2px solid var(--water);background:var(--aqua)}.mockup-pileta-hogar .field{margin:14px 0}.mockup-pileta-hogar .field label{display:flex;justify-content:space-between;font-size:11px;font-weight:900;margin-bottom:6px}.mockup-pileta-hogar .field input{width:100%;border:1px solid #ccd7da;border-radius:10px;padding:10px 12px;color:var(--ink)}.mockup-pileta-hogar .field small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.mockup-pileta-hogar .blueprint{background:#173d50;color:#fff;border-radius:20px;padding:24px;overflow:hidden}.mockup-pileta-hogar .blueprint-head{display:flex;justify-content:space-between;gap:20px;align-items:start}.mockup-pileta-hogar .blueprint-head small{display:block;color:#bcd9e4;font-size:10px}.mockup-pileta-hogar .blueprint h2{font-size:26px;margin:5px 0}.mockup-pileta-hogar .liters{font-size:36px;font-weight:950;letter-spacing:-.04em}.mockup-pileta-hogar .section-view{height:210px;margin:20px 0;position:relative;border-bottom:5px solid #fff;border-left:5px solid #fff;border-right:5px solid #fff;background:linear-gradient(180deg,transparent 0 18%,#50b2cf 18%)}.mockup-pileta-hogar .waterline{position:absolute;left:0;right:0;top:18%;border-top:3px dashed #d8f7ff}.mockup-pileta-hogar .depth-line{position:absolute;right:20px;top:18%;bottom:0;border-left:2px solid #fff}.mockup-pileta-hogar .depth-line span{position:absolute;right:8px;top:45%;white-space:nowrap;font-size:10px}.mockup-pileta-hogar .system{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.mockup-pileta-hogar .system-card{padding:13px;border:1px solid #ffffff2a;background:#ffffff0e;border-radius:12px}.mockup-pileta-hogar .system-card small{display:block;color:#bcd9e4;font-size:9px}.mockup-pileta-hogar .system-card b{font-size:15px}.mockup-pileta-hogar .maintenance{margin-top:20px;padding:16px;background:var(--sand);color:#584820;border-radius:13px}.mockup-pileta-hogar .maintenance b{display:block;margin-bottom:5px}.mockup-pileta-hogar .maintenance span{font-size:12px}.mockup-pileta-hogar .routine{padding:60px 22px;background:#eaf4f5}.mockup-pileta-hogar .routine-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:42px}.mockup-pileta-hogar .kicker{color:var(--water);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-pileta-hogar .routine h2{font-size:35px;letter-spacing:-.04em;margin:6px 0}.mockup-pileta-hogar .routine p{color:var(--muted)}.mockup-pileta-hogar .routine-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-pileta-hogar .routine-card{padding:16px;background:#fff;border:1px solid var(--line);border-radius:14px}.mockup-pileta-hogar .routine-card b{display:block;margin-bottom:5px}.mockup-pileta-hogar .routine-card span{font-size:12px;color:var(--muted)}.mockup-pileta-hogar .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:870px){.mockup-pileta-hogar .nav{display:none}.mockup-pileta-hogar .hero-grid,.mockup-pileta-hogar .bench,.mockup-pileta-hogar .routine-grid{grid-template-columns:1fr}.mockup-pileta-hogar .pool-top{max-width:650px}.mockup-pileta-hogar .routine-cards{grid-template-columns:1fr}}@media(max-width:560px){.mockup-pileta-hogar .hero h1{font-size:42px}.mockup-pileta-hogar .system{grid-template-columns:1fr}.mockup-pileta-hogar .blueprint-head{flex-direction:column}}

.mockup-pileta-hogar { width:100%; overflow:hidden; }
.mockup-pileta-hogar .top, .mockup-pileta-hogar header.top { display:none !important; }
.mockup-pileta-hogar .foot { display:none !important; }
.mockup-pileta-hogar .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-pileta-hogar .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-pileta-hogar .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-pileta-hogar .support-real summary { cursor:pointer; font-weight:750; }
.mockup-pileta-hogar .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-pileta-hogar :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-pileta-hogar input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-pileta-hogar input[type="number"]::-webkit-inner-spin-button, .mockup-pileta-hogar input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-pileta-hogar .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-pileta-hogar support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
