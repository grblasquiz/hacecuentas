---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-ganancia-cripto" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Inversiones / Ganancia con cripto</div><div class="eyebrow">Libro de operaciones</div><h1>Tu ganancia depende de cada compra, venta y comisión.</h1><p class="lead">Cargá lotes en lugar de un único precio promedio. Separá lo realizado de lo que todavía sigue expuesto al mercado.</p></div><div class="portfolio"><div class="portfolio-top"><div><small>VALOR ACTUAL</small><strong id="heroValue">US$ 5.760</strong></div><span class="ticker">BTC / USD</span></div><div class="chart"><svg viewBox="0 0 500 150" preserveAspectRatio="none"><path d="M0 125 L55 115 L90 128 L135 92 L180 101 L225 68 L270 82 L315 45 L365 60 L410 24 L455 39 L500 12"/></svg></div></div></div></section>
<section class="journal"><div class="journal-grid"><section class="ledger"><div class="ledger-head"><div><h2>Operaciones</h2><p>Cada fila conserva cantidad, precio y comisión.</p></div><button class="add" id="add">+ Agregar operación</button></div><div class="tabs"><button class="tab active" data-view="all">Todas</button><button class="tab" data-view="buy">Compras</button><button class="tab" data-view="sell">Ventas</button></div><div class="lot-head"><span>TIPO</span><span>CANTIDAD</span><span>PRECIO USD</span><span>COMISIÓN %</span><span></span></div><div id="lots"></div><div class="market"><div class="field"><label for="market">PRECIO ACTUAL USD</label><input id="market" type="number" value="72000" min="0" step="10"></div><div class="field"><label for="usdRate">DÓLAR DE REFERENCIA ($)</label><input id="usdRate" type="number" value="1450" min="0" step="1"></div></div></section><aside class="snapshot" aria-live="polite"><h2>Foto de la posición</h2><div class="pnl positive" id="pnl">+US$ 742</div><div class="pnl-label" id="pnlLabel">resultado total antes de impuestos</div><div class="metrics"><div class="metric"><small>CANTIDAD ABIERTA</small><b id="open">0,080 BTC</b></div><div class="metric"><small>COSTO PROMEDIO</small><b id="average">US$ 61.986</b></div><div class="metric"><small>RESULTADO REALIZADO</small><b id="realized">US$ 0</b></div><div class="metric"><small>VALOR EN PESOS</small><b id="ars">$8.352.000</b></div></div><div class="snapshot-note" id="note">El resultado no realizado cambia con el mercado. No lo confundas con efectivo disponible.</div></aside></div></section>
<section class="explain"><div class="wrap explain-grid"><div><div class="kicker">Qué separa el libro</div><h2>Tres resultados distintos</h2><p>La forma de asignar costo a una venta puede depender del criterio contable o fiscal aplicable.</p></div><div class="concepts"><div class="concept"><b>No realizado</b><span>Diferencia entre valor actual y costo de la posición que todavía mantenés.</span></div><div class="concept"><b>Realizado</b><span>Resultado de las unidades vendidas, neto de comisiones cargadas.</span></div><div class="concept"><b>En pesos</b><span>Agrega el tipo de cambio de referencia; no reemplaza el análisis impositivo.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-ganancia-cripto')?document.currentScript.previousElementSibling:document.querySelector('.mockup-ganancia-cripto');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],usd=n=>(n<0?"−":"") + "US$ "+Math.abs(n).toLocaleString("es-AR",{maximumFractionDigits:2});let view="all",lots=[{type:"buy",qty:.05,price:58000,fee:1},{type:"buy",qty:.03,price:64000,fee:1},{type:"sell",qty:.02,price:69000,fee:1.2}];function calculate(){let qty=0,cost=0,realized=0;for(const l of lots){if(l.type==="buy"){const c=l.qty*l.price*(1+l.fee/100);qty+=l.qty;cost+=c}else{const sold=Math.min(qty,l.qty),avg=qty?cost/qty:0,proceeds=sold*l.price*(1-l.fee/100);realized+=proceeds-sold*avg;qty-=sold;cost-=sold*avg}}const market=+$("#market").value||0,rate=+$("#usdRate").value||0,value=qty*market,unrealized=value-cost,total=realized+unrealized,avg=qty?cost/qty:0;$("#pnl").textContent=(total>=0?"+":"−")+usd(Math.abs(total));$("#pnl").className="pnl "+(total>=0?"positive":"negative");$("#open").textContent=qty.toLocaleString("es-AR",{maximumFractionDigits:6})+" BTC";$("#average").textContent=usd(avg);$("#realized").textContent=usd(realized);$("#ars").textContent="$"+Math.round(value*rate).toLocaleString("es-AR");$("#heroValue").textContent=usd(value);$("#note").textContent=qty>0?"El resultado no realizado cambia con el mercado. No lo confundas con efectivo disponible.":"La posición quedó cerrada: el resultado mostrado es realizado según costo promedio.";renderLots()}function renderLots(){$("#lots").innerHTML=lots.map((l,i)=>`<div class="lot" data-i="${i}" style="${view!=="all"&&view!==l.type?"display:none":""}"><span class="type" style="--c:${l.type==="buy"?"#2c8067":"#ae4f49"}">${l.type==="buy"?"Compra":"Venta"}</span><input class="qty" type="number" value="${l.qty}" step=".001" min="0" aria-label="Cantidad"><input class="price" type="number" value="${l.price}" min="0" aria-label="Precio"><input class="fee" type="number" value="${l.fee}" min="0" step=".1" aria-label="Comisión"><button class="remove" aria-label="Eliminar">×</button></div>`).join("");$$(".lot").forEach(row=>{const i=+row.dataset.i,inputs=row.querySelectorAll("input");inputs[0].addEventListener("input",()=>{lots[i].qty=+inputs[0].value||0;calculate()});inputs[1].addEventListener("input",()=>{lots[i].price=+inputs[1].value||0;calculate()});inputs[2].addEventListener("input",()=>{lots[i].fee=+inputs[2].value||0;calculate()});row.querySelector(".remove").addEventListener("click",()=>{lots.splice(i,1);calculate()})})}$("#add").addEventListener("click",()=>{lots.push({type:"buy",qty:.01,price:+$("#market").value||0,fee:1});calculate()});$$("[data-view]").forEach(b=>b.addEventListener("click",()=>{view=b.dataset.view;$$("[data-view]").forEach(x=>x.classList.toggle("active",x===b));renderLots()}));$("#market").addEventListener("input",calculate);$("#usdRate").addEventListener("input",calculate);calculate()})();
})();
</script>
<style is:global>

.mockup-ganancia-cripto{--blue:#174b7a;--violet:#6d61a2;--lav:#f0eef8;--green:#2c8067;--mint:#e1f2e9;--orange:#dd844a;--ink:#182332;--muted:#5f6977;--line:#d9e2e4;--red:#ae4f49}.mockup-ganancia-cripto *{box-sizing:border-box}.mockup-ganancia-cripto{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#f7f8fa}.mockup-ganancia-cripto button,.mockup-ganancia-cripto input{font:inherit}.mockup-ganancia-cripto .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-ganancia-cripto .brand{font-size:19px;font-weight:950}.mockup-ganancia-cripto .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-ganancia-cripto .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-ganancia-cripto .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-ganancia-cripto .hero{padding:42px 22px 45px;background:linear-gradient(115deg,#fff 0 62%,var(--lav) 62%)}.mockup-ganancia-cripto .hero-grid,.mockup-ganancia-cripto .wrap{max-width:1180px;margin:auto}.mockup-ganancia-cripto .hero-grid{display:grid;grid-template-columns:1fr .9fr;gap:55px;align-items:center}.mockup-ganancia-cripto .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-ganancia-cripto .eyebrow{margin-top:25px;color:var(--violet);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-ganancia-cripto .hero h1{font-size:clamp(43px,5vw,64px);line-height:.98;letter-spacing:-.05em;margin:9px 0 18px}.mockup-ganancia-cripto .lead{font-size:19px;color:var(--muted)}.mockup-ganancia-cripto .portfolio{padding:23px;background:#1c2936;color:#fff;border-radius:20px;box-shadow:0 24px 50px #17263830}.mockup-ganancia-cripto .portfolio-top{display:flex;justify-content:space-between;gap:15px}.mockup-ganancia-cripto .portfolio-top small{display:block;color:#bbcad5;font-size:10px}.mockup-ganancia-cripto .portfolio-top strong{font-size:29px}.mockup-ganancia-cripto .ticker{padding:6px 9px;border-radius:9px;background:#ffffff12;font-size:12px;font-weight:900}.mockup-ganancia-cripto .chart{height:150px;margin-top:18px;position:relative;border-bottom:1px solid #ffffff22;background:repeating-linear-gradient(0deg,transparent 0 36px,#ffffff0b 37px)}.mockup-ganancia-cripto .chart svg{width:100%;height:100%}.mockup-ganancia-cripto .chart path{fill:none;stroke:#7ad2b0;stroke-width:6}.mockup-ganancia-cripto .journal{padding:55px 22px 70px}.mockup-ganancia-cripto .journal-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:1.25fr .75fr;gap:20px;align-items:start}.mockup-ganancia-cripto .ledger{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden}.mockup-ganancia-cripto .ledger-head{padding:20px 22px;display:flex;justify-content:space-between;gap:20px;align-items:center;border-bottom:1px solid var(--line)}.mockup-ganancia-cripto .ledger h2{font-size:22px;margin:0}.mockup-ganancia-cripto .ledger-head p{margin:3px 0 0;color:var(--muted);font-size:11px}.mockup-ganancia-cripto .add{border:0;border-radius:10px;background:var(--blue);color:#fff;padding:10px 13px;font-weight:900;cursor:pointer}.mockup-ganancia-cripto .tabs{display:flex;gap:6px;padding:13px 20px;background:#f4f6f7}.mockup-ganancia-cripto .tab{border:1px solid var(--line);border-radius:99px;background:#fff;color:var(--ink);padding:7px 10px;font-size:11px;font-weight:850;cursor:pointer}.mockup-ganancia-cripto .tab.active{background:var(--lav);border-color:#988abe;color:#514477}.mockup-ganancia-cripto .lot-head,.mockup-ganancia-cripto .lot{display:grid;grid-template-columns:70px 1fr 1fr 1fr 38px;gap:10px;align-items:center}.mockup-ganancia-cripto .lot-head{padding:10px 20px;background:#fafbfb;color:var(--muted);font-size:9px;font-weight:900}.mockup-ganancia-cripto .lot{padding:12px 20px;border-top:1px solid #edf0f1}.mockup-ganancia-cripto .lot .type{font-size:10px;font-weight:950;color:var(--c);text-transform:uppercase}.mockup-ganancia-cripto .lot input{width:100%;border:1px solid #ced8db;border-radius:9px;padding:9px;color:var(--ink)}.mockup-ganancia-cripto .remove{border:0;background:none;color:#88929c;font-size:19px;cursor:pointer}.mockup-ganancia-cripto .market{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:18px 20px;border-top:1px solid var(--line);background:#fafbfb}.mockup-ganancia-cripto .field label{display:block;font-size:10px;font-weight:900;margin-bottom:5px}.mockup-ganancia-cripto .field input{width:100%;border:1px solid #ccd7da;border-radius:9px;padding:10px;color:var(--ink)}.mockup-ganancia-cripto .snapshot{padding:22px;border-radius:20px;background:var(--blue);color:#fff;position:sticky;top:16px}.mockup-ganancia-cripto .snapshot h2{font-size:14px;text-transform:uppercase;letter-spacing:.1em;color:#dceaf0;margin:0 0 14px}.mockup-ganancia-cripto .pnl{font-size:42px;line-height:1;font-weight:950;letter-spacing:-.04em}.mockup-ganancia-cripto .pnl.negative{color:#ffbbb5}.mockup-ganancia-cripto .pnl.positive{color:#a5e6c7}.mockup-ganancia-cripto .pnl-label{font-size:12px;color:#dceaf0;margin-top:5px}.mockup-ganancia-cripto .metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:22px 0}.mockup-ganancia-cripto .metric{padding:12px;border:1px solid #ffffff2a;background:#ffffff0d;border-radius:11px}.mockup-ganancia-cripto .metric small{display:block;color:#dceaf0;font-size:9px}.mockup-ganancia-cripto .metric b{font-size:14px}.mockup-ganancia-cripto .snapshot-note{padding:12px;background:#fff7df;color:#58461f;border-radius:10px;font-size:11px}.mockup-ganancia-cripto .explain{padding:60px 22px;background:#eeeff5}.mockup-ganancia-cripto .explain-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:42px}.mockup-ganancia-cripto .kicker{color:var(--violet);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-ganancia-cripto .explain h2{font-size:35px;letter-spacing:-.04em;margin:6px 0}.mockup-ganancia-cripto .explain p{color:var(--muted)}.mockup-ganancia-cripto .concepts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-ganancia-cripto .concept{padding:16px;background:#fff;border:1px solid var(--line);border-radius:14px}.mockup-ganancia-cripto .concept b{display:block;margin-bottom:5px}.mockup-ganancia-cripto .concept span{font-size:12px;color:var(--muted)}.mockup-ganancia-cripto .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:860px){.mockup-ganancia-cripto .nav{display:none}.mockup-ganancia-cripto .hero-grid,.mockup-ganancia-cripto .journal-grid,.mockup-ganancia-cripto .explain-grid{grid-template-columns:1fr}.mockup-ganancia-cripto .snapshot{position:static}.mockup-ganancia-cripto .concepts{grid-template-columns:1fr}}@media(max-width:620px){.mockup-ganancia-cripto .hero h1{font-size:42px}.mockup-ganancia-cripto .lot-head{display:none}.mockup-ganancia-cripto .lot{grid-template-columns:60px 1fr 1fr}.mockup-ganancia-cripto .lot input:nth-of-type(3){grid-column:2}.mockup-ganancia-cripto .market,.mockup-ganancia-cripto .metrics{grid-template-columns:1fr}}

.mockup-ganancia-cripto { width:100%; overflow:hidden; }
.mockup-ganancia-cripto .top, .mockup-ganancia-cripto header.top { display:none !important; }
.mockup-ganancia-cripto .foot { display:none !important; }
.mockup-ganancia-cripto .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-ganancia-cripto .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-ganancia-cripto .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-ganancia-cripto .support-real summary { cursor:pointer; font-weight:750; }
.mockup-ganancia-cripto .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-ganancia-cripto :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-ganancia-cripto input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-ganancia-cripto input[type="number"]::-webkit-inner-spin-button, .mockup-ganancia-cripto input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-ganancia-cripto .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-ganancia-cripto support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
