<div class="mockup-salario-minimo-latam" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Datos / Trabajo / Latinoamérica</div><div class="heroGrid"><div><span class="eyebrow">Observatorio laboral 2026</span><h1>El salario mínimo, país por país.</h1><p class="lead">Compará el piso legal de ingresos en Latinoamérica en moneda local y dólares. Con fuentes, vigencia y advertencias para entender qué sí se puede comparar.</p><div class="trust"><span>✓ 11 países</span><span>✓ Fuentes oficiales</span><span>✓ Fecha de vigencia visible</span></div><div class="mapBars"><i></i><i></i><i></i><i></i><i></i><span><strong>Una región.</strong><small>Reglas muy distintas.</small></span></div></div>
<div class="compare"><h2>Compará dos países</h2><p>La conversión a USD usa un tipo de cambio de referencia.</p><div class="selectors"><div class="field"><label>Primer país</label><select id="countryA"></select></div><span class="vs">VS</span><div class="field"><label>Segundo país</label><select id="countryB"></select></div></div><button class="primary" id="compare">Actualizar comparación</button><div class="result"><small>COMPARACIÓN NOMINAL MENSUAL</small><div class="countryResult"><div class="rBox"><span id="nameA">🇨🇱 Chile</span><div class="usd" id="usdA">US$ 602</div><p id="localA">$539.000 CLP por mes</p></div><div class="rBox"><span id="nameB">🇲🇽 México</span><div class="usd" id="usdB">US$ 534</div><p id="localB">$9.582 MXN por mes</p></div></div><div class="difference" id="difference">Chile queda US$ 68 por encima en la conversión nominal.</div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Tabla comparativa</span><h2>Salarios mínimos de Latinoamérica</h2><p>Ordená por valor nominal o buscá un país. “USD” no mide poder de compra ni costo de vida.</p></div><div class="controls"><div class="filters"><button class="filter active" data-sort="usd">Mayor USD</button><button class="filter" data-sort="country">País A–Z</button><button class="filter" data-sort="local">Mayor valor local</button></div><input class="search" id="search" placeholder="Buscar país…"></div><div class="tableShell"><div class="tableScroll"><table><thead><tr><th>País</th><th>Valor legal</th><th>Base</th><th>USD estimado</th><th>Comparación visual</th><th>Vigencia / fuente</th></tr></thead><tbody id="rows"></tbody></table></div><div class="empty" id="empty">No encontramos ese país.</div></div></div></section>
<section class="tint"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Cómo leer el ranking</span><h2>Un número parecido puede significar otra cosa.</h2></div><div class="insights"><article class="card dark"><span class="icon">≠</span><h3>USD no es poder de compra</h3><p>Dos salarios convertidos al mismo dólar pueden comprar cantidades muy diferentes de vivienda, comida y transporte.</p></article><article class="card"><span class="icon">▤</span><h3>La base legal cambia</h3><p>Algunos países fijan un monto mensual; otros diario, por hora, zona geográfica, tamaño de empresa o actividad.</p></article><article class="card"><span class="icon">↻</span><h3>Las fechas importan</h3><p>Argentina puede actualizar varias veces al año. Otros países fijan el monto para todo el calendario anual.</p></article></div></div></section>
<section><div class="wrap"><div class="method"><article class="panel"><h3>Qué incluye la tabla</h3><p>El salario general nacional para adultos cuando existe. Los complementos obligatorios se muestran separados si modifican materialmente el ingreso.</p><div class="line"><span>Moneda local</span><b>Dato legal</b></div><div class="line"><span>Conversión USD</span><b>Estimación</b></div><div class="line"><span>Fuente y vigencia</span><b>Siempre visibles</b></div></article><article class="panel"><h3>Qué no debería concluirse</h3><p>No es un ranking de calidad de vida, salario promedio ni capacidad de ahorro. Tampoco describe informalidad, cobertura real o carga tributaria.</p><div class="line"><span>Comparación recomendada</span><b>Poder de compra</b></div><div class="line"><span>Decisiones personales</span><b>Usar sueldo neto</b></div><div class="line"><span>Actualización</span><b>Al cambiar la norma</b></div></article></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-salario-minimo-latam')?document.currentScript.previousElementSibling:document.querySelector('.mockup-salario-minimo-latam');if(!root)return;

const data=[{flag:"🇨🇷",country:"Costa Rica",local:"₡367.108",raw:367108,base:"Mensual · ocupación no calificada",usd:725,note:"Por categoría",source:"MTSS · 2026"},{flag:"🇺🇾",country:"Uruguay",local:"$24.572",raw:24572,base:"Mensual",usd:615,note:"Nacional",source:"MTSS · ene 2026"},{flag:"🇨🇱",country:"Chile",local:"$539.000",raw:539000,base:"Mensual · 18 a 65 años",usd:602,note:"Nacional",source:"Mintrab · ene 2026"},{flag:"🇨🇴",country:"Colombia",local:"$1.750.905",raw:1750905,base:"Mensual · sin auxilio",usd:477,note:"Auxilio separado",source:"Mintrab · 2026"},{flag:"🇪🇨",country:"Ecuador",local:"US$482",raw:482,base:"Mensual",usd:482,note:"Dolarizado",source:"MDT · 2026"},{flag:"🇲🇽",country:"México",local:"$9.582",raw:9582,base:"Equivalente mensual · zona general",usd:534,note:"Fijado por día",source:"CONASAMI · ene 2026"},{flag:"🇧🇴",country:"Bolivia",local:"Bs 2.750",raw:2750,base:"Mensual",usd:395,note:"Nacional",source:"Ministerio · 2026"},{flag:"🇵🇾",country:"Paraguay",local:"₲2.899.048",raw:2899048,base:"Mensual",usd:455,note:"Nacional",source:"MTESS · 2026"},{flag:"🇵🇪",country:"Perú",local:"S/1.130",raw:1130,base:"Mensual",usd:322,note:"RMV",source:"MTPE · 2026"},{flag:"🇧🇷",country:"Brasil",local:"R$1.621",raw:1621,base:"Mensual",usd:296,note:"Nacional",source:"Governo Federal · 2026"},{flag:"🇦🇷",country:"Argentina",local:"$322.000",raw:322000,base:"Mensual · jornada completa",usd:230,note:"Ajustes escalonados",source:"Consejo del Salario · 2026"}],$=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let sort="usd";
function options(){const h=data.map((x,i)=>`<option value="${i}">${x.flag} ${x.country}</option>`).join("");$("#countryA").innerHTML=h;$("#countryB").innerHTML=h;$("#countryA").value=2;$("#countryB").value=5}function compare(){const a=data[$("#countryA").value],b=data[$("#countryB").value];$("#nameA").textContent=a.flag+" "+a.country;$("#nameB").textContent=b.flag+" "+b.country;$("#usdA").textContent="US$ "+a.usd;$("#usdB").textContent="US$ "+b.usd;$("#localA").textContent=a.local+" · "+a.base;$("#localB").textContent=b.local+" · "+b.base;const hi=a.usd>=b.usd?a:b,d=Math.abs(a.usd-b.usd);$("#difference").textContent=hi.country+" queda US$ "+d+" por encima en la conversión nominal."}
function render(){const q=$("#search").value.toLowerCase(),arr=data.filter(x=>x.country.toLowerCase().includes(q)).sort((a,b)=>sort==="country"?a.country.localeCompare(b.country):sort==="local"?b.raw-a.raw:b.usd-a.usd),max=Math.max(...data.map(x=>x.usd));$("#rows").innerHTML=arr.map(x=>`<tr><td class="country">${x.flag} ${x.country}</td><td class="local">${x.local}<div class="note">${x.note}</div></td><td>${x.base}</td><td class="dollar">US$ ${x.usd}</td><td><div class="bar"><i style="width:${x.usd/max*100}%"></i></div></td><td><span class="source">${x.source}</span></td></tr>`).join("");$("#empty").style.display=arr.length?"none":"block"}options();compare();render();$("#compare").onclick=e=>{compare();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Comparación actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};$$(".filter").forEach(b=>b.onclick=()=>{sort=b.dataset.sort;$$(".filter").forEach(x=>x.classList.toggle("active",x===b));render()});$("#search").oninput=render;$("#countryA").oninput=$("#countryB").oninput=compare;

})();
</script>
