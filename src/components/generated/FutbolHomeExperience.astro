<div class="mockup-futbol-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Fútbol</div><div class="heroGrid"><div><span class="eyebrow">Los números detrás del juego</span><h1>Menos intuición. Más lectura del partido.</h1><p class="lead">Compará equipos, entendé estadísticas y seguí torneos con cuentas simples. Los datos no juegan, pero ayudan a mirar mejor.</p><div class="trust"><span>✓ Comparación real</span><span>✓ Forma reciente</span><span>✓ Resultados orientativos</span></div><div class="scene"><i class="pitch"></i><i class="ball">⚽</i></div></div>
<div class="compare"><div class="compareHead"><div><h2>Compará dos equipos</h2><p>Usá sus últimos partidos para leer el cruce.</p></div><span class="live">ANÁLISIS EN VIVO</span></div><div class="teams"><div class="team"><label>LOCAL</label><select id="teamA"><option>Argentina</option><option>Brasil</option><option>España</option><option>Francia</option><option>Colombia</option></select></div><span class="vs">VS</span><div class="team"><label>VISITANTE</label><select id="teamB"><option>Brasil</option><option>Argentina</option><option>España</option><option>Francia</option><option>Colombia</option></select></div></div><div class="stats"><div class="side"><strong id="nameA">Argentina · últimos partidos</strong><div class="mini"><div class="field"><label>Partidos</label><div class="input"><input id="gamesA" type="number" min="1" value="10"></div></div><div class="field"><label>Puntos</label><div class="input"><input id="pointsA" type="number" min="0" value="24"></div></div><div class="field"><label>Goles a favor</label><div class="input"><input id="gfA" type="number" min="0" value="21"></div></div><div class="field"><label>Goles en contra</label><div class="input"><input id="gaA" type="number" min="0" value="6"></div></div></div></div><div class="side"><strong id="nameB">Brasil · últimos partidos</strong><div class="mini"><div class="field"><label>Partidos</label><div class="input"><input id="gamesB" type="number" min="1" value="10"></div></div><div class="field"><label>Puntos</label><div class="input"><input id="pointsB" type="number" min="0" value="17"></div></div><div class="field"><label>Goles a favor</label><div class="input"><input id="gfB" type="number" min="0" value="16"></div></div><div class="field"><label>Goles en contra</label><div class="input"><input id="gaB" type="number" min="0" value="11"></div></div></div></div></div><button class="primary" id="calculate">Actualizar comparación</button><div class="result"><small>PROBABILIDAD ORIENTATIVA DEL RESULTADO</small><div class="probRow"><div class="prob" id="boxA"><span id="labelA">ARGENTINA</span><b id="probA">52%</b></div><div class="prob" id="boxD"><span>EMPATE</span><b id="probD">25%</b></div><div class="prob" id="boxB"><span id="labelB">BRASIL</span><b id="probB">23%</b></div></div><div class="meter"><i id="meterA"></i><i id="meterD"></i><i id="meterB"></i></div><p class="summary" id="summary">Argentina llega con mejor forma y mayor diferencia de gol reciente.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Elegí cómo querés mirar el juego</span><h2>¿Qué necesitás entender?</h2><p>Entrá por tu pregunta y encontrá primero la herramienta adecuada.</p></div><div class="needs"><button class="need active" data-filter="stats"><span class="icon">%</span><h3>Comparar equipos</h3><p>Forma, goles, puntos y rendimiento.</p><em>→</em></button><button class="need" data-filter="match"><span class="icon">⚽</span><h3>Leer un partido</h3><p>Posesión, remates y efectividad.</p><em>→</em></button><button class="need" data-filter="table"><span class="icon">≡</span><h3>Entender la tabla</h3><p>Puntos, posiciones y clasificación.</p><em>→</em></button><button class="need" data-filter="worldcup"><span class="icon">★</span><h3>Seguir el Mundial</h3><p>Grupos, cruces y escenarios 2026.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de fútbol</span><h2>De la cancha a los números.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="stats">Estadísticas</button><button class="filter" data-filter="match">Partidos</button><button class="filter" data-filter="table">Tablas</button><button class="filter" data-filter="worldcup">Mundial 2026</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="stats match" data-text="estadisticas futbol equipos comparar goles puntos rendimiento"><span class="tag">Análisis completo</span><h3>Estadísticas de fútbol</h3><p>Compará rendimiento, efectividad, posesión, remates y forma reciente.</p><button>Comparar equipos →</button></article><article class="card" data-cat="worldcup table" data-text="mundial 2026 grupos clasificacion cruces fixture"><span class="tag">Torneo</span><h3>Mundial 2026</h3><p>Grupos, formato, clasificación y posibles cruces.</p><button>Explorar Mundial →</button></article><article class="card" data-cat="table" data-text="tabla posiciones puntos diferencia gol promedio"><span class="tag">Posiciones</span><h3>Calculadora de tabla</h3><p>Probá resultados y mirá cómo cambia una posición.</p><button>Simular tabla →</button></article><article class="card" data-cat="match stats" data-text="probabilidad partido local empate visitante goles"><span class="tag">Comparador</span><h3>Probabilidad de resultado</h3><p>Una estimación basada en forma y goles recientes.</p><button>Estimar partido →</button></article><article class="card" data-cat="match" data-text="posesion remates efectividad tiros gol partido"><span class="tag">Partido</span><h3>Efectividad de ataque</h3><p>Convertí remates y llegadas en tasas comparables.</p><button>Analizar →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="guide"><div class="wrap guideGrid"><div><span class="eyebrow" style="color:var(--lime)">Leer bien antes de concluir</span><h2>Un dato aislado cuenta poco.</h2><p>La posesión no es dominio por sí sola y una racha corta puede engañar. Compará contexto, volumen, eficacia y rivales antes de sacar una conclusión.</p></div><div class="steps"><button class="step active" data-step="Contexto"><span><b>1. Mirá el contexto</b><small>Localía, rivales y cantidad de partidos.</small></span><b>→</b></button><button class="step" data-step="Volumen"><span><b>2. Compará volumen</b><small>Remates, llegadas y posesión útil.</small></span><b>→</b></button><button class="step" data-step="Eficacia"><span><b>3. Medí la eficacia</b><small>Cuánto convierte y cuánto concede.</small></span><b>→</b></button></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-futbol-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-futbol-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],n=id=>Math.max(0,+$("#"+id).value||0);const presets={Argentina:[10,24,21,6],Brasil:[10,17,16,11],España:[10,23,24,7],Francia:[10,21,19,8],Colombia:[10,19,15,8]};function calc(){const a=$("#teamA").value,b=$("#teamB").value;if(a===b){const options=[...$("#teamB").options].map(x=>x.value);$("#teamB").value=options.find(x=>x!==a);return calc()}$("#nameA").textContent=a+" · últimos partidos";$("#nameB").textContent=b+" · últimos partidos";$("#labelA").textContent=a.toUpperCase();$("#labelB").textContent=b.toUpperCase();const gA=Math.max(1,n("gamesA")),gB=Math.max(1,n("gamesB")),formA=n("pointsA")/(gA*3),formB=n("pointsB")/(gB*3),attackA=n("gfA")/gA,attackB=n("gfB")/gB,defA=1/(1+n("gaA")/gA),defB=1/(1+n("gaB")/gB),scoreA=formA*1.5+attackA*.55+defA*.8+.18,scoreB=formB*1.5+attackB*.55+defB*.8,draw=.72+Math.max(0,.35-Math.abs(scoreA-scoreB)*.25),total=scoreA+scoreB+draw,pA=Math.round(scoreA/total*100),pD=Math.round(draw/total*100),pB=100-pA-pD;$("#probA").textContent=pA+"%";$("#probD").textContent=pD+"%";$("#probB").textContent=pB+"%";$("#meterA").style.width=pA+"%";$("#meterD").style.width=pD+"%";$("#meterB").style.width=pB+"%";const vals=[[pA,"boxA"],[pD,"boxD"],[pB,"boxB"]],best=vals.sort((x,y)=>y[0]-x[0])[0][1];$$(".prob").forEach(x=>x.classList.toggle("best",x.id===best));const leader=pA>pB?a:b,diff=Math.abs((n("gfA")-n("gaA"))/gA-(n("gfB")-n("gaB"))/gB);$("#summary").textContent=diff<.25?"El cruce aparece parejo: el empate gana peso por la similitud reciente.":leader+" llega con mejor combinación de forma y diferencia de gol reciente."}
$$(".compare input").forEach(x=>x.oninput=calc);function load(side){const team=$("#team"+side).value,v=presets[team];["games","points","gf","ga"].forEach((k,i)=>$("#"+k+side).value=v[i]);calc()}$("#teamA").onchange=()=>load("A");$("#teamB").onchange=()=>load("B");$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Comparación actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".step").forEach(b=>b.onclick=()=>{$$(".step").forEach(x=>x.classList.toggle("active",x===b));toast("Lectura seleccionada: "+b.dataset.step)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
