<div class="mockup-tecnologia-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Tecnología</div><div class="heroGrid"><div><span class="eyebrow">Traducimos especificaciones a decisiones</span><h1>Menos siglas. Más respuestas útiles.</h1><p class="lead">Baterías, electricidad, fotografía, gaming e impresión 3D. Calculadoras para entender qué necesitás y cuánto alcanza.</p><div class="trust"><span>✓ Unidades claras</span><span>✓ Pérdidas visibles</span><span>✓ Supuestos editables</span></div><div class="scene"><i class="device"></i><i class="code">&lt;/&gt;</i><i class="spark"></i></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Cuánto dura esta batería?</h2><p>Capacidad, consumo y pérdidas reales.</p></div><span class="live">AUTONOMÍA EN VIVO</span></div><div class="presets"><button class="preset active" data-preset="notebook">Notebook</button><button class="preset" data-preset="router">Router</button><button class="preset" data-preset="camera">Cámara</button><button class="preset" data-preset="console">Consola</button></div><div class="fields"><div class="field"><label>Capacidad de batería</label><div class="input"><input id="capacity" type="number" min="1" value="60"><span>Wh</span></div></div><div class="field"><label>Consumo promedio</label><div class="input"><input id="power" type="number" min=".1" step=".1" value="35"><span>W</span></div></div><div class="field"><label>Eficiencia del sistema</label><select id="efficiency"><option value=".75">75%</option><option value=".85" selected>85%</option><option value=".9">90%</option><option value=".95">95%</option></select></div><div class="field"><label>Reserva que no querés usar</label><select id="reserve"><option value="0">0%</option><option value=".1" selected>10%</option><option value=".2">20%</option></select></div><div class="field"><label>Uso que necesitás cubrir</label><div class="input"><input id="needed" type="number" min=".1" step=".5" value="1.5"><span>horas</span></div></div><div class="field"><label>Unidades de capacidad</label><select id="capacityUnit"><option value="wh">Wh directos</option><option value="mah">mAh a 3,7 V</option></select></div></div><button class="primary" id="calculate">Actualizar autonomía</button><div class="result"><div class="resultTop"><div><small>AUTONOMÍA ÚTIL ESTIMADA</small><div class="amount" id="runtime">1 h 19 min</div></div><span class="badge" id="status">No alcanza</span></div><div class="resultGrid"><div class="metric"><span>ENERGÍA UTILIZABLE</span><b id="usable">45,9 Wh</b></div><div class="metric"><span>PÉRDIDAS + RESERVA</span><b id="loss">14,1 Wh</b></div><div class="metric"><span>PARA TU OBJETIVO</span><b id="coverage">88%</b></div></div><div class="battery"><i id="batteryBar"></i></div><p class="note" id="note">La autonomía real también cambia con temperatura, picos de consumo y degradación.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por lo que querés resolver</span><h2>¿En qué proyecto estás?</h2><p>Elegí un área y te mostramos primero las herramientas relacionadas.</p></div><div class="needs"><button class="need active" data-filter="energy"><span class="icon">⚡</span><h3>Energía y baterías</h3><p>Autonomía, capacidad y consumo.</p><em>→</em></button><button class="need" data-filter="electric"><span class="icon">W</span><h3>Instalación eléctrica</h3><p>Carga, cables y protecciones.</p><em>→</em></button><button class="need" data-filter="photo"><span class="icon">◎</span><h3>Foto y cámara</h3><p>Exposición, lente y ajustes.</p><em>→</em></button><button class="need" data-filter="gaming"><span class="icon">＋</span><h3>Gaming</h3><p>FPS, latencia y rendimiento.</p><em>→</em></button><button class="need" data-filter="maker"><span class="icon">3D</span><h3>Fabricación 3D</h3><p>Material, tiempo y costo.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de tecnología</span><h2>Especificaciones que se vuelven respuestas.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="energy">Energía</button><button class="filter" data-filter="electric">Electricidad</button><button class="filter" data-filter="photo">Fotografía</button><button class="filter" data-filter="gaming">Gaming</button><button class="filter" data-filter="maker">3D</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="energy electric" data-text="baterias autonomia capacidad voltaje consumo mah wh"><span class="tag">Energía</span><h3>Baterías y autonomía</h3><p>Convertí capacidad y consumo en horas reales estimadas.</p><button>Calcular autonomía →</button></article><article class="card" data-cat="electric energy" data-text="instalacion electrica potencia cable termica consumo"><span class="tag">Electricidad</span><h3>Instalación eléctrica</h3><p>Sumá cargas y estimá corriente, cable y protección.</p><button>Dimensionar →</button></article><article class="card" data-cat="photo" data-text="ajustes camara apertura velocidad iso exposicion"><span class="tag">Cámara</span><h3>Ajustes de cámara</h3><p>Entendé la relación entre apertura, velocidad e ISO.</p><button>Ajustar exposición →</button></article><article class="card" data-cat="photo" data-text="fotografia lente sensor focal profundidad campo"><span class="tag">Fotografía</span><h3>Calculadora fotográfica</h3><p>Distancia focal, sensor y profundidad de campo.</p><button>Explorar fotografía →</button></article><article class="card" data-cat="gaming" data-text="gaming fps latencia monitor hardware rendimiento"><span class="tag">Rendimiento</span><h3>Gaming</h3><p>FPS, Hz, latencia y equilibrio del equipo.</p><button>Analizar setup →</button></article><article class="card" data-cat="maker" data-text="impresion 3d filamento tiempo costo material"><span class="tag">Maker</span><h3>Impresión 3D</h3><p>Material, horas de máquina, energía y costo final.</p><button>Calcular impresión →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="logic"><div class="wrap logicGrid"><div><span class="eyebrow" style="color:var(--cyan)">Una especificación sola no alcanza</span><h2>Primero la necesidad. Después el número.</h2><p>Más capacidad, potencia o resolución no siempre mejora el resultado. El contexto de uso define qué especificación importa.</p></div><div class="paths"><button class="path active" data-path="Uso"><span><b>1. Definí el uso real</b><small>Duración, carga, distancia o calidad necesaria.</small></span><b>→</b></button><button class="path" data-path="Unidad"><span><b>2. Unificá las unidades</b><small>Wh, W, V, mm, FPS o tiempo.</small></span><b>→</b></button><button class="path" data-path="Margen"><span><b>3. Sumá pérdidas y margen</b><small>El mundo real nunca entrega el 100% teórico.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-tecnologia-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-tecnologia-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let current="notebook";const fmt=n=>n.toLocaleString("es-AR",{maximumFractionDigits:1});function calc(){let cap=Math.max(.1,+$("#capacity").value||.1);if($("#capacityUnit").value==="mah")cap=cap*3.7/1000;const power=Math.max(.1,+$("#power").value||.1),eff=+$("#efficiency").value,res=+$("#reserve").value,needed=Math.max(.1,+$("#needed").value||.1),usable=cap*eff*(1-res),runtime=usable/power,h=Math.floor(runtime),m=Math.round((runtime-h)*60),coverage=Math.round(runtime/needed*100),ok=runtime>=needed;$("#runtime").textContent=`${h} h ${m} min`;$("#usable").textContent=fmt(usable)+" Wh";$("#loss").textContent=fmt(cap-usable)+" Wh";$("#coverage").textContent=coverage+"%";$("#status").textContent=ok?"Alcanza":"No alcanza";$("#status").style.background=ok?"#246a55":"#a9534a";$("#batteryBar").style.width=Math.min(100,coverage)+"%";$("#note").textContent=`Estimación para ${current}. La autonomía real también cambia con temperatura, picos de consumo y degradación.`}
$$(".calc input,.calc select").forEach(x=>x.oninput=calc);const presets={notebook:[60,35,.85,.1,1.5,"wh"],router:[100,12,.85,.1,6,"wh"],camera:[1800,4,.9,.1,1.5,"mah"],console:[500,180,.85,.1,2,"wh"]};$$(".preset").forEach(b=>b.onclick=()=>{current=b.dataset.preset;$$(".preset").forEach(x=>x.classList.toggle("active",x===b));const v=presets[current],ids=["capacity","power","efficiency","reserve","needed","capacityUnit"];ids.forEach((id,i)=>$("#"+id).value=v[i]);calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Autonomía actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".path").forEach(b=>b.onclick=()=>{$$(".path").forEach(x=>x.classList.toggle("active",x===b));toast("Paso seleccionado: "+b.dataset.path)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
