pacing:.09em;color:#b8c9d8}.mockup-tecnologia-home .amount{font-size:37px;font-weight:950;letter-spacing:-.05em;margin:3px 0}.mockup-tecnologia-home .badge{background:#246a55;padding:8px 10px;border-radius:99px;font-size:9px;font-weight:900}.mockup-tecnologia-home .resultGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.mockup-tecnologia-home .metric{background:#ffffff0c;border:1px solid #ffffff14;border-radius:9px;padding:9px}.mockup-tecnologia-home .metric span{font-size:7px;color:#b8c9d8;display:block}.mockup-tecnologia-home .metric b{font-size:10px}.mockup-tecnologia-home .battery{height:10px;border:2px solid #ffffff45;border-radius:4px;margin-top:12px;padding:1px;position:relative}.mockup-tecnologia-home .battery:after{content:"";position:absolute;right:-6px;top:1px;width:4px;height:5px;background:#ffffff45;border-radius:0 2px 2px 0}.mockup-tecnologia-home .battery i{display:block;height:100%;width:78%;background:var(--lime);border-radius:2px;transition:.3s}.mockup-tecnologia-home .note{font-size:9px;color:#c1d0dc;margin:9px 0 0}
