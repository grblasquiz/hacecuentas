@media(max-width:900px){.mockup-tecnologia-home .links{display:none}.mockup-tecnologia-home .heroGrid,.mockup-tecnologia-home .logicGrid{grid-template-columns:1fr}.mockup-tecnologia-home .needs{grid-template-columns:repeat(3,1fr)}.mockup-tecnologia-home .cards{grid-template-columns:1fr 1fr}.mockup-tecnologia-home .card.featured{grid-column:1/-1}}@media(max-width:600px){.mockup-tecnologia-home .wrap{width:calc(100% - 24px)}.mockup-tecnologia-home h1{font-size:42px}.mockup-tecnologia-home .presets,.mockup-tecnologia-home .fields,.mockup-tecnologia-home .resultGrid,.mockup-tecnologia-home .needs,.mockup-tecnologia-home .cards{grid-template-columns:1fr}.mockup-tecnologia-home .card.featured{grid-column:auto}.mockup-tecnologia-home .toolbar{flex-direction:column}.mockup-tecnologia-home .search{width:100%}.mockup-tecnologia-home .actions .sm:first-child{display:none}.mockup-tecnologia-home .scene{transform:scale(.82);transform-origin:left}}

