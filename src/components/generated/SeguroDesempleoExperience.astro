ng:24px}.mockup-seguro-desempleo .card h3{margin:0 0 16px;font-size:19px}.mockup-seguro-desempleo .line{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #e6ebee}.mockup-seguro-desempleo .line span{color:#65778b;font-size:10px}.mockup-seguro-desempleo .line b{font-size:12px}.mockup-seguro-desempleo .line.total{background:#eaf7f2;color:#176f59;margin-top:12px;padding:14px;border:0;border-radius:10px}.mockup-seguro-desempleo .step{display:grid;grid-template-columns:34px 1fr;gap:11px;margin:14px 0}.mockup-seguro-desempleo .step i{font-style:normal;background:#e8f5f1;color:#1c7a65;width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-weight:900}.mockup-seguro-desempleo .step b{font-size:11px}.mockup-seguro-desempleo .step span{display:block;color:#65788c;font-size:10px;margin-top:3px}.mockup-seguro-desempleo .warning{background:#fff5df;color:#76591f;border:1px solid #efd9a6;padding:12px;border-radius:10px;font-size:10px}.mockup-seguro-desempleo .darksection{background:#19324d;color:#fff;padding:61px 0}.mockup-seguro-desempleo .rules{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-seguro-desempleo .rule{border:1px solid #ffffff20;border-radius:15px;padding:18px}.mockup-seguro-desempleo .rule i{font-style:normal;font-size:22px}.mockup-seguro-desempleo .rule h3{font-size:13px;margin:10px 0 6px}.mockup-seguro-desempleo .rule p{font-size:10px;line-height:1.55;color:#c3d0db;margin:0}
