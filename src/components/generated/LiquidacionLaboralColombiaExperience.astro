const { data } = Astro.props;
---
<div class="mockup-liquidacion-laboral-colombia" set:html={`<section class="hero"><div class="wrap crumb"><b>Colombia</b> &nbsp;/&nbsp; Trabajo &nbsp;/&nbsp; Liquidación laboral</div><div class="wrap grid"><div class="copy"><div class="eyebrow">Tu salida, concepto por concepto</div><h1>Que el total no esconda lo que te corresponde.</h1><p>Calculá cesantías, intereses, prima, vacaciones e indemnización según cómo terminó el contrato.</p><div class="chips"><span>✓ Desglose completo</span><span>▤ Artículos del CST</span><span>◷ Fechas reales</span></div><div class="art"><div class="paper"><b>Liquidación final</b><i></i><i></i><i></i><i></i></div><div class="stamp">REVISADO</div><div class="totalcard"><small>TOTAL ESTIMADO</small><strong id="art-total">$16.582.500</strong><span id="art-copy">incluye indemnización</span></div></div></div><form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá tu liquidación</h2><p class="muted">Elegí cómo terminó la relación laboral.</p></div><span class="tag">Colombia · 2026</span></div><div class="label">Motivo de salida</div><div class="cases"><button type="button" class="case active" data-mode="resign"><i>→</i>Renuncia</button><button type="button" class="case" data-mode="dismiss"><i>!</i>Despido injusto</button><button type="button" class="case" data-mode="fixed"><i>◷</i>Contrato fijo</button><button type="button" class="case" data-mode="home"><i>⌂</i>Trabajo doméstico</button></div><div class="label">Datos del contrato</div><div class="fields"><div class="field wide"><label id="salary-label">Salario mensual</label><div class="money"><b>$</b><input id="salary" value="3000000"></div></div><div class="field"><label>Fecha de ingreso</label><input id="start" type="date" value="2024-01-15"></div><div class="field"><label>Fecha de salida</label><input id="end" type="date" value="2026-07-29"></div><div class="field"><label>Vacaciones pendientes anteriores</label><input id="vac-days" value="0"></div><div class="field"><label>Días de mora en el pago</label><input id="delay" value="0"></div><div class="field hide" id="f-fixed"><label>Fin pactado del contrato</label><input id="fixed-end" type="date" value="2026-12-31"></div><div class="field hide" id="f-home"><label>Días trabajados por semana</label><select id="days-week"><option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option></select></div></div><section class="result"><div class="result-top"><div><small>TOTAL DE LA LIQUIDACIÓN</small><div class="value" id="result">$16.582.500</div></div><div class="verdict"><small>Tiempo trabajado</small><b id="tenure">2 años y 6 meses</b></div></div><div class="stats"><span>PRESTACIONES<b id="stat-benefits">$8.082.500</b></span><span>VACACIONES<b id="stat-vac">$3.750.000</b></span><span>INDEMNIZACIÓN<b id="stat-indem">$4.750.000</b></span></div><button class="go" id="update" type="button">Actualizar liquidación</button></section></form></div></section>
<section class="section"><div class="wrap"><div class="center"><div class="eyebrow">El total por partes</div><h2>Cada concepto tiene su propia fórmula</h2><p>La barra muestra qué pesa más dentro de la liquidación estimada.</p></div><div class="stack"><i class="ces" id="bar-ces">Cesantías</i><i class="prime" id="bar-prime">Prima</i><i class="vac" id="bar-vac">Vacaciones</i><i class="indem" id="bar-indem">Indemnización</i></div><div class="legend"><span>CESANTÍAS + INTERESES<b id="leg-ces">$4.300.000</b></span><span>PRIMA DE SERVICIOS<b id="leg-prime">$3.780.000</b></span><span>VACACIONES<b id="leg-vac">$3.750.000</b></span><span>INDEMNIZACIÓN<b id="leg-indem">$4.750.000</b></span></div></div></section><section class="break"><div class="wrap cards"><article class="card"><h3>Tu liquidación, línea por línea</h3><div class="line"><span>Cesantías</span><b id="d-ces">$3.900.000</b></div><div class="line"><span>Intereses de cesantías</span><b id="d-interest">$400.000</b></div><div class="line"><span>Prima de servicios</span><b id="d-prime">$3.780.000</b></div><div class="line"><span>Vacaciones</span><b id="d-vac">$3.750.000</b></div><div class="line"><span>Indemnización</span><b id="d-indem">$4.750.000</b></div><div class="line"><span>Sanción por mora</span><b id="d-delay">$0</b></div><div class="line total"><strong>Total estimado</strong><b id="d-total">$16.582.500</b></div></article><article class="card"><h3>Cómo revisar el pago</h3><div class="step"><i>1</i><div><b>Separá prestaciones e indemnización</b><span>La indemnización sólo aparece cuando la causa legal corresponde.</span></div></div><div class="step"><i>2</i><div><b>Controlá las bases</b><span>El auxilio entra en cesantías y prima, pero no en vacaciones.</span></div></div><div class="step"><i>3</i><div><b>Compará las fechas</b><span>Un día de diferencia modifica todos los conceptos proporcionales.</span></div></div><div class="warning" id="warning">⚠️ Esta estimación no reemplaza la revisión del contrato, desprendibles y causa de terminación.</div></article></div></section><section class="darksection"><div class="wrap"><div class="rules"><div class="rule"><i>▤</i><h3>Cesantías</h3><p>Un mes de salario por año, con auxilio de transporte cuando corresponde.</p></div><div class="rule"><i>◷</i><h3>Vacaciones</h3><p>Quince días hábiles por año, calculados sólo sobre el salario.</p></div><div class="rule"><i>!</i><h3>Indemnización</h3><p>Depende del tipo de contrato, el salario y la causa real de terminación.</p></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-liquidacion-laboral-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-liquidacion-laboral-colombia');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0),cop=x=>"$"+Math.round(x).toLocaleString("es-CO"),date=id=>new Date($(id).value+"T12:00:00");let mode="resign",SML=1750905,AUX=249095;
function calc(){let salary=n("#salary"),start=date("#start"),end=date("#end");if(end<start)end=start;let days=Math.max(0,Math.round((end-start)/86400000)),years=days/360,baseSalary=salary,aux=salary<=2*SML?AUX:0;if(mode==="home"){let dw=Number($("#days-week").value),daysMonth=dw*52/12,auxDay=AUX/30;baseSalary=Math.max(0,salary-auxDay)*daysMonth;aux=Math.min(salary,auxDay)*daysMonth}let base=baseSalary+aux,ces=base*years,daysYear=days%360||(days?360:0),cesYear=base*daysYear/360,interest=cesYear*daysYear*.12/360,prime=base*years,vac=baseSalary*days/720+baseSalary/30*n("#vac-days"),indem=0;if(mode==="dismiss"){const firstDays=baseSalary<10*SML?30:20;const extraDays=baseSalary<10*SML?20:15;const indemnityDays=years<=1?firstDays:firstDays+extraDays*(years-1);indem=indemnityDays*(baseSalary/30)}if(mode==="fixed"){let fend=date("#fixed-end"),left=fend>end?Math.round((fend-end)/86400000):0;indem=left*baseSalary/30}let delay=n("#delay")*baseSalary/30,total=ces+interest+prime+vac+indem,benefits=ces+interest+prime,full=total+delay,whole=Math.max(1,total);$("#result").textContent=cop(total);$("#art-total").textContent=cop(total);$("#art-copy").textContent=indem?"incluye indemnización":"prestaciones y vacaciones";$("#tenure").textContent=Math.floor(years)+" años y "+Math.floor((years%1)*12)+" meses";$("#stat-benefits").textContent=cop(benefits);$("#stat-vac").textContent=cop(vac);$("#stat-indem").textContent=cop(indem);$("#d-ces").textContent=cop(ces);$("#d-interest").textContent=cop(interest);$("#d-prime").textContent=cop(prime);$("#d-vac").textContent=cop(vac);$("#d-indem").textContent=cop(indem);$("#d-delay").textContent=cop(delay);$("#d-total").textContent=cop(full);$("#leg-ces").textContent=cop(ces+interest);$("#leg-prime").textContent=cop(prime);$("#leg-vac").textContent=cop(vac);$("#leg-indem").textContent=cop(indem);$("#bar-ces").style.width=(ces+interest)/whole*100+"%";$("#bar-prime").style.width=prime/whole*100+"%";$("#bar-vac").style.width=vac/whole*100+"%";$("#bar-indem").style.width=indem/whole*100+"%";$("#warning").textContent=delay?`⚠️ La sanción por ${n("#delay")} días de mora se muestra aparte: ${cop(delay)}.`:"⚠️ Esta estimación no reemplaza la revisión del contrato, desprendibles y causa de terminación."}
function setMode(m){mode=m;$$(".case").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));$("#f-fixed").classList.toggle("hide",m!=="fixed");$("#f-home").classList.toggle("hide",m!=="home");$("#salary-label").textContent=m==="home"?"Pago por día trabajado":"Salario mensual";if(m==="home"&&n("#salary")>500000)$("#salary").value=80000;if(m!=="home"&&n("#salary")<500000)$("#salary").value=3000000;calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Liquidación actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar liquidación",1200)};calc();

})();
</script>
