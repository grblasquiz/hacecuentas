rder-radius:15px;padding:18px 20px}.mockup-madera .result-top{display:flex;align-items:start;justify-content:space-between;gap:16px}.mockup-madera .result small{font-size:9px;color:#c5d3df}.mockup-madera .value{font-size:34px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.mockup-madera .verdict{background:#e6f6ef;color:#126d51;border-radius:9px;padding:8px 11px;text-align:right}.mockup-madera .verdict small{color:inherit}.mockup-madera .verdict strong{display:block;font-size:14px}.mockup-madera .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #375675;padding-top:12px;margin-top:13px}.mockup-madera .stats span{font-size:8px;color:#b9cad8}.mockup-madera .stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.mockup-madera .go{width:100%;border:0;border-radius:9px;background:linear-gradient(90deg,#19816d,#2c9d77);color:#fff;font-weight:800;padding:12px;margin-top:14px}
