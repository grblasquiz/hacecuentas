---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-madera" set:html={`<section class="hero"><div class="wrap crumb"><b>Construcción</b> &nbsp;/&nbsp; Madera</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Plan de corte inteligente</span><h1>Diseñá el mueble<br>y sabé cuántas<br>placas comprar.</h1><p>Pasá de las medidas exteriores a un despiece listo para el corralón, contemplando espesor, ancho de sierra y desperdicio real.</p><div class="chips"><span>📐 Despiece automático</span><span>🪚 Corte incluido</span><span>✓ Lista para comprar</span></div><div class="car-art"><div class="road"></div><div style="position:absolute;left:80px;bottom:52px;width:250px;height:175px;background:#b87f50;border:10px solid #8c5e39;box-shadow:0 20px 35px #17385818"></div><div style="position:absolute;left:92px;bottom:105px;width:226px;height:8px;background:#8c5e39;box-shadow:0 52px 0 #8c5e39"></div><div class="fuel-card"><small>PLACAS A COMPRAR</small><strong id="art-value">1 placa</strong><span id="art-place">Biblioteca · melamina 18 mm</span></div></div></div>
<form class="calc"><div class="calc-title"><div><h2>Armá tu despiece</h2><p>Elegí el mueble que querés hacer.</p></div><span class="tag">Placa 1,83 × 2,60 m</span></div><div class="section-label">Tipo de proyecto</div><div class="cases"><button type="button" class="case active" data-mode="library"><i>📚</i>Biblioteca</button><button type="button" class="case" data-mode="desk"><i>🖥️</i>Escritorio</button><button type="button" class="case" data-mode="drawers"><i>🗄️</i>Cajonera</button><button type="button" class="case" data-mode="cut"><i>🪚</i>Plan de corte</button></div><div class="section-label">Medidas exteriores</div><div class="fields"><div class="field"><label id="l1">Ancho</label><div class="inline"><input id="width" type="number" value="80"><b>cm</b></div></div><div class="field"><label id="l2">Alto</label><div class="inline"><input id="height" type="number" value="180"><b>cm</b></div></div><div class="field"><label id="l3">Profundidad</label><div class="inline"><input id="depth" type="number" value="30"><b>cm</b></div></div><div class="field"><label id="l4">Estantes / cajones / piezas</label><input id="pieces" type="number" value="4"></div><div class="field"><label>Formato de placa</label><select id="sheet"><option value="4.758">1,83 × 2,60 m</option><option value="5.033">1,83 × 2,75 m</option><option value="2.977">2,44 × 1,22 m</option></select></div><div class="field"><label>Espesor</label><div class="inline"><input id="thickness" type="number" value="18"><b>mm</b></div></div></div><div class="advanced"><span>La sierra también consume material en cada corte</span><button type="button" id="advanced-toggle">+ Afinar corte</button></div><div class="extra" id="extra-fields"><div class="field"><label>Ancho de sierra</label><div class="inline"><input id="kerf" type="number" value="3"><b>mm</b></div></div><div class="field"><label>Precio por placa</label><div class="inline"><b>$</b><input id="price" type="number" value="65000"></div></div></div><section class="result"><div class="result-top"><div><small id="result-label">Placas enteras a comprar</small><div class="value" id="result-value">1 placa</div></div><div class="verdict"><small>Aprovechamiento</small><strong id="verdict">58%</strong></div></div><div class="stats"><span>Superficie neta<b id="s1">2,77 m²</b></span><span>Desperdicio estimado<b id="s2">1,99 m²</b></span><span>Costo de placas<b id="s3">$65.000</b></span></div><button class="go" id="update" type="button">Actualizar despiece</button></section></form></div></section>
<section class="scale-section"><div class="wrap"><header class="center"><span>Aprovechamiento de placa</span><h2>¿Cuánta madera termina en el mueble?</h2><p>El marcador compara la superficie útil del despiece contra las placas completas que comprás.</p></header><div class="scale-card"><div class="meter"><i class="pin" id="pin" data-value="58%"></i></div><div class="meter-labels"><div><b>Mucho descarte</b>Menos de 55%</div><div><b>Aprovechamiento normal</b>55% a 80%</div><div><b>Muy buen corte</b>Más de 80%</div></div><div class="meter-summary"><span id="scale-copy">Rotar las piezas puede mejorar el rendimiento.</span><b id="scale-result">58% de la placa queda en el mueble</b></div></div></div></section>
<section class="breakdown"><div class="wrap break-grid"><article class="card"><h3>Despiece para el corralón</h3><div class="line"><span>Laterales</span><b id="d1">2 × 180 × 30 cm</b></div><div class="line"><span>Techo y base</span><b id="d2">2 × 76,4 × 30 cm</b></div><div class="line"><span id="d3l">Estantes</span><b id="d3">4 × 76,4 × 30 cm</b></div><div class="line"><span>Fondo fino sugerido</span><b id="d4">1 × 80 × 180 cm</b></div><div class="line total"><strong>Placas principales</strong><b id="df">1 placa</b></div></article><article class="card"><h3>Antes de mandar a cortar</h3><div class="step"><i>1</i><div><b>Confirmá el espesor</b><span>Las medidas interiores cambian con cada placa.</span></div></div><div class="step"><i>2</i><div><b>Marcá el sentido de veta</b><span>Puede impedir rotar algunas piezas.</span></div></div><div class="step"><i>3</i><div><b>Separá el fondo</b><span>Usá placa fina para bajar peso y costo.</span></div></div><div class="warning">⚠️ Validá el plano de corte con el corralón: su máquina y formato disponible pueden cambiar el rendimiento.</div></article></div></section>
<section class="tips"><div class="wrap"><header class="center"><span>Cuatro errores caros</span><h2>Medí dos veces, cortá una</h2></header><div class="tip-grid"><article class="tip"><i>🪚</i><h3>Olvidar la sierra</h3><p>Cada pasada consume entre 2,5 y 4 mm.</p><span class="impact">Descuenta material</span></article><article class="tip"><i>↔️</i><h3>Ignorar el espesor</h3><p>Dos laterales reducen el ancho interior útil.</p><span class="impact">Ajustá las piezas</span></article><article class="tip"><i>📚</i><h3>Estante muy largo</h3><p>Más de 80 cm con libros puede pandear.</p><span class="impact">Agregá apoyo</span></article><article class="tip"><i>🧩</i><h3>Fondo grueso</h3><p>Suele alcanzar con MDF fino bien clavado.</p><span class="impact">Menos peso</span></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">La superficie sola no alcanza</span><h2>Dos muebles con los mismos m² pueden necesitar placas distintas.</h2><p>El largo, la orientación y la posibilidad de rotar piezas definen el rendimiento real del corte.</p></div><div class="compare"><div><small>SUPERFICIE NETA</small><b id="cmp1">2,77 m²</b><span>Material que queda</span></div><div><small>SUPERFICIE COMPRADA</small><b id="cmp2">4,76 m²</b><span>Placas completas</span></div><div><small>PESO APROX.</small><b id="cmp3">36 kg</b><span>Melamina de 18 mm</span></div></div></div></section><div class="foot"></div><button type="button" id="date-result" hidden aria-hidden="true"></button><button type="button" id="progress-result" hidden aria-hidden="true"></button><button type="button" id="fund-result" hidden aria-hidden="true"></button><button type="button" id="art-consumption" hidden aria-hidden="true"></button><button type="button" id="art-cost" hidden aria-hidden="true"></button><button type="button" id="scale-verdict" hidden aria-hidden="true"></button><button type="button" id="detail-last" hidden aria-hidden="true"></button><button type="button" id="detail-interval" hidden aria-hidden="true"></button><button type="button" id="detail-used" hidden aria-hidden="true"></button><button type="button" id="detail-next" hidden aria-hidden="true"></button><button type="button" id="detail-left" hidden aria-hidden="true"></button><button type="button" id="cmp-low" hidden aria-hidden="true"></button><button type="button" id="cmp-current" hidden aria-hidden="true"></button><button type="button" id="cmp-high" hidden aria-hidden="true"></button><button type="button" id="cmp-current-cost" hidden aria-hidden="true"></button><button type="button" id="province" hidden aria-hidden="true"></button><button type="button" id="rate" hidden aria-hidden="true"></button><button type="button" id="quota-value" hidden aria-hidden="true"></button><button type="button" id="cash-value" hidden aria-hidden="true"></button><button type="button" id="month-value" hidden aria-hidden="true"></button><button type="button" id="d-valuation" hidden aria-hidden="true"></button><button type="button" id="d-rate" hidden aria-hidden="true"></button><button type="button" id="d-year" hidden aria-hidden="true"></button><button type="button" id="d-discount" hidden aria-hidden="true"></button><button type="button" id="d-final" hidden aria-hidden="true"></button><button type="button" id="cmp-name" hidden aria-hidden="true"></button><button type="button" id="digits" hidden aria-hidden="true"></button><button type="button" id="formula-note" hidden aria-hidden="true"></button><button type="button" id="d1l" hidden aria-hidden="true"></button><button type="button" id="d2l" hidden aria-hidden="true"></button><button type="button" id="d4l" hidden aria-hidden="true"></button><button type="button" id="df-label" hidden aria-hidden="true"></button><button type="button" id="pre2" hidden aria-hidden="true"></button><button type="button" id="pre3" hidden aria-hidden="true"></button><button type="button" id="date" hidden aria-hidden="true"></button><button type="button" id="night-sunday" hidden aria-hidden="true"></button><button type="button" id="limit-warning" hidden aria-hidden="true"></button><button type="button" id="transport" hidden aria-hidden="true"></button><button type="button" id="stage" hidden aria-hidden="true"></button><button type="button" id="grade" hidden aria-hidden="true"></button><button type="button" id="cmp-truck" hidden aria-hidden="true"></button><button type="button" id="cl-search" hidden aria-hidden="true"></button><button type="button" id="no-results" hidden aria-hidden="true"></button><button type="button" id="cl-search-btn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-madera')?document.currentScript.previousElementSibling:document.querySelector('.mockup-madera');


let woodMode="library";const w$=s=>root.querySelector(s),wn=id=>Math.max(0,Number(w$(id).value)||0),wm=x=>"$"+new Intl.NumberFormat("es-AR",{maximumFractionDigits:0}).format(x),wd=x=>x.toFixed(2).replace(".",",");function woodCalc(){let W=wn("#width")/100,H=wn("#height")/100,D=wn("#depth")/100,N=Math.max(1,wn("#pieces")),t=wn("#thickness")/1000,kerf=wn("#kerf")/1000,area;if(woodMode==="library")area=2*H*D+(N+2)*Math.max(.01,W-2*t)*D+W*H*.15;else if(woodMode==="desk")area=W*D+2*H*D;else if(woodMode==="drawers")area=2*H*D+2*W*D+W*H+(N*W*H/N*.45);else area=N*W*H;area*=1+Math.min(.18,kerf*12);let sheet=Number(w$("#sheet").value),plates=Math.ceil(area/sheet*1.08),bought=plates*sheet,use=Math.min(100,area/bought*100),discard=bought-area,price=wn("#price"),weight=area*wn("#thickness")*.72;w$("#result-value").textContent=plates+" placa"+(plates===1?"":"s");w$("#verdict").textContent=Math.round(use)+"%";w$("#s1").textContent=wd(area)+" m²";w$("#s2").textContent=wd(discard)+" m²";w$("#s3").textContent=wm(plates*price);w$("#art-value").textContent=plates+" placa"+(plates===1?"":"s");w$("#art-place").textContent=woodMode==="library"?"Biblioteca · melamina "+wn("#thickness")+" mm":"Proyecto · "+wn("#thickness")+" mm";w$("#pin").style.left=Math.max(3,Math.min(97,use))+"%";w$("#pin").dataset.value=Math.round(use)+"%";w$("#scale-result").textContent=Math.round(use)+"% de la placa queda en el mueble";w$("#d1").textContent="2 × "+wn("#height")+" × "+wn("#depth")+" cm";w$("#d2").textContent="2 × "+Math.max(0,wn("#width")-2*wn("#thickness")/10).toFixed(1).replace(".",",")+" × "+wn("#depth")+" cm";w$("#d3").textContent=N+" × "+Math.max(0,wn("#width")-2*wn("#thickness")/10).toFixed(1).replace(".",",")+" × "+wn("#depth")+" cm";w$("#d4").textContent="1 × "+wn("#width")+" × "+wn("#height")+" cm";w$("#df").textContent=plates+" placas";w$("#cmp1").textContent=wd(area)+" m²";w$("#cmp2").textContent=wd(bought)+" m²";w$("#cmp3").textContent=Math.round(weight)+" kg"}
root.querySelectorAll(".case").forEach(x=>x.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(y=>y.classList.remove("active"));x.classList.add("active");woodMode=x.dataset.mode;woodCalc()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",woodCalc));w$("#advanced-toggle").addEventListener("click",e=>{w$("#extra-fields").classList.toggle("open");e.currentTarget.textContent=w$("#extra-fields").classList.contains("open")?"− Ocultar corte":"+ Afinar corte"});w$("#update").addEventListener("click",e=>{e.preventDefault();woodCalc();e.currentTarget.textContent="✓ Despiece actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar despiece",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());woodCalc();

})();
</script>
