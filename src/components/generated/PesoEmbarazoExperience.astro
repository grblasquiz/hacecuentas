---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-peso-embarazo" set:html={`<div class="crumb">Salud / Embarazo</div><h1>Seguimiento, no juicio: mirá la curva completa.</h1><p class="lead">Compará el aumento acumulado con un rango orientativo basado en el IMC previo y la semana gestacional.</p><section class="tracker"><aside class="profile"><h2>Datos de seguimiento</h2><label>Peso antes del embarazo (kg)<input id="pre" type="number" value="62"></label><label>Altura (cm)<input id="height" type="number" value="165"></label><label>Semana actual<input id="week" type="number" value="24" min="1" max="40"></label><label>Peso actual (kg)<input id="now" type="number" value="69"></label><div class="result" id="result"></div><p class="care">Embarazos múltiples, vómitos persistentes, edema, diabetes, hipertensión u otras condiciones necesitan objetivos personalizados por el equipo obstétrico.</p></aside><section class="chart"><h2>Rango acumulado orientativo</h2><svg id="svg" viewBox="0 0 700 390"></svg></section></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-peso-embarazo')?document.currentScript.previousElementSibling:document.querySelector('.mockup-peso-embarazo');

const $=x=>root.querySelector("#"+x);function range(bmi,w){let total=bmi<18.5?[12.5,18]:bmi<25?[11.5,16]:bmi<30?[7,11.5]:[5,9];let first=[.5,2],p=Math.max(0,(w-13)/27);return[first[0]+p*(total[0]-first[0]),first[1]+p*(total[1]-first[1])]};function render(){let pre=+$('pre').value,h=+$('height').value/100,w=+$('week').value,now=+$('now').value,bmi=pre/(h*h),r=range(bmi,w),gain=now-pre,cx=50,base=340,sx=15,sy=15,upper=[],lower=[];for(let i=1;i<=40;i++){let z=range(bmi,i);lower.push(`${cx+i*sx},${base-z[0]*sy}`);upper.unshift(`${cx+i*sx},${base-z[1]*sy}`)}$('svg').innerHTML=`<line class=\"axis\" x1=\"${cx}\" y1=\"${base}\" x2=\"680\" y2=\"${base}\"/><polygon class=\"band\" points=\"${lower.concat(upper).join(' ')}\"/><polyline class=\"curve\" points=\"${cx},${base} ${cx+w*sx},${base-gain*sy}\"/><circle class=\"dot\" cx=\"${cx+w*sx}\" cy=\"${base-gain*sy}\" r=\"10\"/>`;$('result').innerHTML=`IMC previo ${bmi.toFixed(1)} · aumento ${gain.toFixed(1)} kg<br>Rango acumulado orientativo a semana ${w}: ${r[0].toFixed(1)}–${r[1].toFixed(1)} kg. La evolución fetal y clínica manda sobre la curva.`}
root.querySelectorAll('input').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-peso-embarazo{--blue:#174b7a;--ink:#182a32;--muted:#65747c;--line:#d7e1df;--rose:#d96c83;--green:#3d9d77;--paper:#f5f7f5}.mockup-peso-embarazo *{box-sizing:border-box}.mockup-peso-embarazo{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-peso-embarazo input{font:inherit}.mockup-peso-embarazo .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-peso-embarazo .crumb{color:var(--blue);font-weight:850}.mockup-peso-embarazo h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-peso-embarazo .lead{font-size:18px;color:var(--muted)}.mockup-peso-embarazo .tracker{display:grid;grid-template-columns:300px 1fr;gap:20px;margin-top:26px}.mockup-peso-embarazo .profile,.mockup-peso-embarazo .chart{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-peso-embarazo .profile label{display:block;font-size:12px;font-weight:850;margin:14px 0}.mockup-peso-embarazo .profile input{display:block;width:100%;border:0;border-bottom:2px solid var(--line);padding:8px 0;color:var(--ink);font-weight:900}.mockup-peso-embarazo .chart svg{width:100%;height:390px}.mockup-peso-embarazo .axis{stroke:#a1b1ad}.mockup-peso-embarazo .band{fill:#dff2e9}.mockup-peso-embarazo .curve{fill:none;stroke:var(--rose);stroke-width:5}.mockup-peso-embarazo .dot{fill:var(--rose);stroke:#fff;stroke-width:5}.mockup-peso-embarazo .result{margin-top:14px;padding:15px;border-left:5px solid var(--rose);background:#fff0f3}.mockup-peso-embarazo .care{font-size:12px;color:var(--muted);margin-top:15px}@media(max-width:760px){.mockup-peso-embarazo .tracker{grid-template-columns:1fr}}
.mockup-peso-embarazo { width:100%; overflow:hidden; }
.mockup-peso-embarazo .top, .mockup-peso-embarazo header.top { display:none !important; }
.mockup-peso-embarazo .foot { display:none !important; }
.mockup-peso-embarazo .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-peso-embarazo .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-peso-embarazo .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-peso-embarazo .support-real summary { cursor:pointer; font-weight:750; }
.mockup-peso-embarazo .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-peso-embarazo :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-peso-embarazo input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-peso-embarazo input[type="number"]::-webkit-inner-spin-button, .mockup-peso-embarazo input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-peso-embarazo .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-peso-embarazo support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
