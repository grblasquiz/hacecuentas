---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-costo-ia" set:html={`<div class="crumb">Tecnología / Inteligencia artificial</div><h1>El costo está en el flujo, no en una sola llamada.</h1><p class="lead">Sumá usuarios, frecuencia, tokens de entrada y salida para presupuestar cada etapa del producto.</p><section class="pipeline"><div class="flow"><h2>Flujo por solicitud</h2><div id="steps"></div></div><aside class="budget"><span>Costo mensual estimado</span><div class="bill" id="bill"></div><div class="breakdown" id="breakdown"></div><div class="saving" id="saving"></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-costo-ia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-costo-ia');

let stages=[['Clasificar',800,150,.15,.6],['Generar respuesta',2500,700,.8,3.2],['Revisar',900,220,.15,.6]],$=x=>root.querySelector("#"+x);function render(){$('steps').innerHTML=stages.map((s,i)=>`<div class=\"step\"><b>${s[0]}</b><label>Entrada<input data-i=\"${i}\" data-k=\"1\" value=\"${s[1]}\"></label><label>Salida<input data-i=\"${i}\" data-k=\"2\" value=\"${s[2]}\"></label></div>`).join('');let requests=30000,costs=stages.map(s=>requests*((s[1]/1e6)*s[3]+(s[2]/1e6)*s[4])),total=costs.reduce((a,b)=>a+b,0);$('bill').textContent='US$ '+total.toFixed(2);$('breakdown').innerHTML=stages.map((s,i)=>`<div class=\"line\"><span>${s[0]}</span><b>US$ ${costs[i].toFixed(2)}</b></div>`).join('');let max=Math.max(...costs),idx=costs.indexOf(max);$('saving').textContent=`Mayor costo: ${stages[idx][0]}. Antes de cambiar de modelo, reducí contexto repetido, cacheá y medí reintentos.`;root.querySelectorAll('[data-i]').forEach(x=>x.oninput=()=>{stages[+x.dataset.i][+x.dataset.k]=+x.value;render()})}render();

})();
</script>
<style is:global>
.mockup-costo-ia{--blue:#174b7a;--ink:#182a32;--muted:#65747c;--line:#d7e1df;--orange:#e47a45;--green:#3d9d77;--paper:#f5f7f5}.mockup-costo-ia *{box-sizing:border-box}.mockup-costo-ia{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-costo-ia input,.mockup-costo-ia select{font:inherit}.mockup-costo-ia .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-costo-ia .crumb{color:var(--blue);font-weight:850}.mockup-costo-ia h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-costo-ia .lead{font-size:18px;color:var(--muted)}.mockup-costo-ia .pipeline{display:grid;grid-template-columns:1fr 300px;gap:20px;margin-top:26px}.mockup-costo-ia .flow,.mockup-costo-ia .budget{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-costo-ia .step{display:grid;grid-template-columns:1fr 120px 120px;gap:10px;padding:13px 0;border-bottom:1px solid var(--line)}.mockup-costo-ia .step input,.mockup-costo-ia .step select{width:100%;border:1px solid var(--line);border-radius:9px;padding:8px}.mockup-costo-ia .bill{font-size:45px;font-weight:950;color:var(--blue)}.mockup-costo-ia .breakdown{margin-top:18px}.mockup-costo-ia .line{display:flex;justify-content:space-between;padding:10px 0;border-top:1px solid var(--line)}.mockup-costo-ia .saving{margin-top:15px;background:#e3f1eb;border-radius:14px;padding:14px}@media(max-width:760px){.mockup-costo-ia .pipeline{grid-template-columns:1fr}.mockup-costo-ia .step{grid-template-columns:1fr}}
.mockup-costo-ia { width:100%; overflow:hidden; }
.mockup-costo-ia .top, .mockup-costo-ia header.top { display:none !important; }
.mockup-costo-ia .foot { display:none !important; }
.mockup-costo-ia .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-costo-ia .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-costo-ia .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-costo-ia .support-real summary { cursor:pointer; font-weight:750; }
.mockup-costo-ia .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-costo-ia :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-costo-ia input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-costo-ia input[type="number"]::-webkit-inner-spin-button, .mockup-costo-ia input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-costo-ia .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-costo-ia support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
