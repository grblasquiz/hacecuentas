<div class="mockup-vivienda-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Vivienda</div><div class="heroGrid"><div><span class="eyebrow">La casa empieza antes de tener la llave</span><h1>Entrar, mantener y mejorar. Con todas las cuentas claras.</h1><p class="lead">Alquiler, compra, escritura, servicios y obra. Entendé el costo completo antes de tomar una decisión grande.</p><div class="trust"><span>✓ Entrada desglosada</span><span>✓ Gastos visibles</span><span>✓ Alquilar o comprar</span></div><div class="scene"><i class="home"><i class="window"></i></i><i class="key">⌕</i></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Cuánto necesitás para entrar?</h2><p>Cambiá entre alquiler y compra.</p></div><span class="live">COSTO EN VIVO</span></div><div class="modes"><button class="mode active" data-mode="rent">Alquilar</button><button class="mode" data-mode="buy">Comprar</button></div><div class="fields"><div class="field"><label id="valueLabel">Alquiler mensual</label><div class="input"><span>$</span><input id="value" type="number" min="0" value="650000"></div></div><div class="field"><label id="firstLabel">Depósito</label><div class="input"><input id="first" type="number" min="0" step=".1" value="1"><span id="firstUnit">mes</span></div></div><div class="field"><label id="secondLabel">Meses adelantados</label><div class="input"><input id="second" type="number" min="0" step=".1" value="1"><span id="secondUnit">mes</span></div></div><div class="field"><label id="thirdLabel">Comisión</label><div class="input"><input id="third" type="number" min="0" step=".1" value="4.15"><span>%</span></div></div><div class="field"><label>Informes, mudanza y altas</label><div class="input"><span>$</span><input id="extras" type="number" min="0" value="380000"></div></div><div class="field"><label id="monthlyLabel">Expensas + servicios mensuales</label><div class="input"><span>$</span><input id="monthly" type="number" min="0" value="210000"></div></div></div><button class="primary" id="calculate">Actualizar costo de entrada</button><div class="result"><div class="resultTop"><div><small>TOTAL NECESARIO PARA ENTRAR</small><div class="amount" id="total">$2.357.000</div></div><span class="badge" id="modeLabel">Alquiler</span></div><div class="resultGrid"><div class="metric"><span id="mainMetricLabel">DEPÓSITO + ADELANTO</span><b id="mainMetric">$1.300.000</b></div><div class="metric"><span>GASTOS NO RECUPERABLES</span><b id="fees">$407.000</b></div><div class="metric"><span>COSTO MENSUAL</span><b id="monthlyOut">$860.000</b></div></div><div class="stack"><i id="mainBar"></i><i id="feeBar"></i><i id="extraBar"></i></div><p class="note" id="note">Incluye depósito, adelanto, comisión, mudanza y altas. Los requisitos pueden variar.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por tu decisión</span><h2>¿En qué momento de la vivienda estás?</h2><p>Elegí una necesidad y encontrá primero las herramientas relacionadas.</p></div><div class="needs"><button class="need active" data-filter="rent"><span class="icon">⌂</span><h3>Quiero alquilar</h3><p>Entrada, aumentos y costo mensual.</p><em>→</em></button><button class="need" data-filter="buy"><span class="icon">$</span><h3>Quiero comprar</h3><p>Escritura, anticipo y gastos.</p><em>→</em></button><button class="need" data-filter="services"><span class="icon">⚡</span><h3>Ordenar servicios</h3><p>Luz, gas, agua y climatización.</p><em>→</em></button><button class="need" data-filter="build"><span class="icon">▦</span><h3>Construir o mejorar</h3><p>Materiales, superficie y terminaciones.</p><em>→</em></button><button class="need" data-filter="compare"><span class="icon">⇄</span><h3>Comparar opciones</h3><p>Costo total, no solo cuota o alquiler.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de vivienda</span><h2>Cada decisión, con el costo completo.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="rent">Alquiler</button><button class="filter" data-filter="buy">Compra</button><button class="filter" data-filter="services">Servicios</button><button class="filter" data-filter="build">Obra</button><button class="filter" data-filter="compare">Comparar</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="rent compare" data-text="entrar alquiler deposito comision adelanto mudanza"><span class="tag">Alquiler</span><h3>Entrar a un alquiler</h3><p>Depósito, adelanto, comisión, informes, mudanza y costo mensual.</p><button>Calcular entrada →</button></article><article class="card" data-cat="buy compare" data-text="gastos escritura compra inmueble honorarios impuestos"><span class="tag">Compra</span><h3>Gastos de escritura</h3><p>Estimá escritura, comisión e impuestos de la operación.</p><button>Calcular escritura →</button></article><article class="card" data-cat="rent" data-text="aumento alquiler indice contrato actualizacion"><span class="tag">Contrato</span><h3>Aumento de alquiler</h3><p>Calculá el nuevo valor según fecha e índice.</p><button>Actualizar alquiler →</button></article><article class="card" data-cat="services" data-text="factura luz consumo kwh tarifa hogar"><span class="tag">Servicios</span><h3>Factura de luz</h3><p>Entendé consumo, cargos y costo estimado.</p><button>Calcular factura →</button></article><article class="card" data-cat="services" data-text="climatizacion potencia aire calefaccion ambiente"><span class="tag">Confort</span><h3>Climatización</h3><p>Dimensioná potencia según ambiente y condiciones.</p><button>Dimensionar →</button></article><article class="card" data-cat="build compare" data-text="costo construccion metro cuadrado materiales obra"><span class="tag">Obra</span><h3>Costo por m²</h3><p>Estimá obra por superficie, sistema y terminación.</p><button>Estimar obra →</button></article><article class="card" data-cat="build" data-text="pintura pisos ladrillos hormigon materiales"><span class="tag">Materiales</span><h3>Calculadoras de materiales</h3><p>Pintura, pisos, ladrillos, hormigón y madera.</p><button>Ver materiales →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="pathSection"><div class="wrap pathGrid"><div><span class="eyebrow" style="color:var(--sand)">Una cuota no es el costo completo</span><h2>Miralo en tres capas.</h2><p>Separá el dinero inicial, los gastos que no recuperás y el costo mensual. Así dos opciones se vuelven realmente comparables.</p></div><div class="paths"><button class="path active" data-path="Entrada"><span><b>1. Dinero para entrar</b><small>Anticipo, depósito o adelanto.</small></span><b>→</b></button><button class="path" data-path="Gastos"><span><b>2. Gastos de la operación</b><small>Comisiones, escritura, informes y mudanza.</small></span><b>→</b></button><button class="path" data-path="Mensual"><span><b>3. Costo de sostenerla</b><small>Cuota o alquiler, servicios y mantenimiento.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-vivienda-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-vivienda-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let mode="rent";const money=n=>"$"+Math.round(n).toLocaleString("es-AR");function calc(){const value=Math.max(0,+$("#value").value||0),first=Math.max(0,+$("#first").value||0),second=Math.max(0,+$("#second").value||0),third=Math.max(0,+$("#third").value||0),extras=Math.max(0,+$("#extras").value||0),monthly=Math.max(0,+$("#monthly").value||0);let main,fees,total,monthlyCost;if(mode==="rent"){main=value*(first+second);fees=value*third/100;total=main+fees+extras;monthlyCost=value+monthly;$("#note").textContent="Incluye depósito, adelanto, comisión, mudanza y altas. Los requisitos pueden variar."}else{main=value*first/100;fees=value*(second+third)/100;total=main+fees+extras;monthlyCost=monthly;$("#note").textContent="Incluye anticipo, escritura, comisión y otros gastos estimados. No incluye financiación."}$("#total").textContent=money(total);$("#mainMetric").textContent=money(main);$("#fees").textContent=money(fees+extras);$("#monthlyOut").textContent=money(monthlyCost);$("#modeLabel").textContent=mode==="rent"?"Alquiler":"Compra";const denom=total||1;$("#mainBar").style.width=main/denom*100+"%";$("#feeBar").style.width=fees/denom*100+"%";$("#extraBar").style.width=extras/denom*100+"%"}
function configure(){const buy=mode==="buy";$("#valueLabel").textContent=buy?"Precio de la propiedad":"Alquiler mensual";$("#firstLabel").textContent=buy?"Anticipo":"Depósito";$("#firstUnit").textContent=buy?"%":"mes";$("#secondLabel").textContent=buy?"Escritura e impuestos":"Meses adelantados";$("#secondUnit").textContent=buy?"%":"mes";$("#thirdLabel").textContent="Comisión";$("#monthlyLabel").textContent=buy?"Cuota + gastos mensuales":"Expensas + servicios mensuales";$("#mainMetricLabel").textContent=buy?"ANTICIPO":"DEPÓSITO + ADELANTO";const vals=buy?[85000000,30,6,3,1200000,950000]:[650000,1,1,4.15,380000,210000],ids=["value","first","second","third","extras","monthly"];ids.forEach((id,i)=>$("#"+id).value=vals[i]);calc()}$$(".calc input").forEach(x=>x.oninput=calc);$$(".mode").forEach(b=>b.onclick=()=>{mode=b.dataset.mode;$$(".mode").forEach(x=>x.classList.toggle("active",x===b));configure()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Costo actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".path").forEach(b=>b.onclick=()=>{$$(".path").forEach(x=>x.classList.toggle("active",x===b));toast("Capa seleccionada: "+b.dataset.path)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
