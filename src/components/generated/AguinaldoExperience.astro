.mockup-aguinaldo .best{background:#eef1ec;padding:68px 0}.mockup-aguinaldo .best-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:65px}.mockup-aguinaldo .best h2{font-size:40px;line-height:1.08;letter-spacing:-.04em;margin:9px 0}.mockup-aguinaldo .best p{color:var(--muted)}.mockup-aguinaldo .salary-list{background:#fff;border:1px solid var(--line);border-radius:18px;padding:19px}.mockup-aguinaldo .salary-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.mockup-aguinaldo .salary-head b{font-size:14px}.mockup-aguinaldo .salary-head span{font-size:9px;color:var(--muted)}.mockup-aguinaldo .salary-months{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.mockup-aguinaldo .smonth label{display:block;font-size:9px;color:var(--muted);font-weight:850;margin-bottom:5px}.mockup-aguinaldo .smonth input{width:100%;min-width:0;border:1px solid var(--line);border-radius:9px;padding:9px 6px;font-size:10px;font-weight:800}.mockup-aguinaldo .findbtn{width:100%;border:1px solid #d1a149;background:var(--gold2);color:#80551c;border-radius:10px;padding:11px;margin-top:13px;font-size:11px;font-weight:900;cursor:pointer}.mockup-aguinaldo .best-result{margin-top:11px;font-size:11px;color:var(--muted)}.mockup-aguinaldo .best-result b{color:var(--green)}.mockup-aguinaldo .law{padding:65px 0}.mockup-aguinaldo .law-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-aguinaldo .law-card{background:#fff;border:1px solid var(--line);border-radius:17px;padding:19px}.mockup-aguinaldo .law-card small{font-size:9px;color:#a16a20;font-weight:900;letter-spacing:.08em}.mockup-aguinaldo .law-card b{display:block;font-size:16px;margin:8px 0 5px}.mockup-aguinaldo .law-card p{font-size:11px;color:var(--muted);margin:0}.mockup-aguinaldo .toast{position:fixed;left:50%;bottom:25px;transform:translate(-50%,20px);background:#111b2b;color:#fff;border-radius:11px;padding:12px 17px;font-size:12px;font-weight:850;opacity:0;transition:.2s;pointer-events:none}.mockup-aguinaldo .toast.show{opacity:1;transform:translate(-50%,0)}.mockup-aguinaldo footer{background:#fff;border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:12px}
@media(max-width:900px){.mockup-aguinaldo .nav{display:none}.mockup-aguinaldo .hero-grid,.mockup-aguinaldo .shell,.mockup-aguinaldo .best-grid{grid-template-columns:1fr}.mockup-aguinaldo .visual{display:none}.mockup-aguinaldo .case-grid{grid-template-columns:1fr 1fr}.mockup-aguinaldo .result{min-height:540px}}@media(max-width:560px){.mockup-aguinaldo .wrap{width:calc(100% - 30px)}.mockup-aguinaldo h1{font-size:42px}.mockup-aguinaldo .hero{padding-top:32px}.mockup-aguinaldo .modes{grid-template-columns:1fr 1fr}.mockup-aguinaldo .fields,.mockup-aguinaldo .branch,.mockup-aguinaldo .case-grid,.mockup-aguinaldo .law-grid{grid-template-columns:1fr}.mockup-aguinaldo .form,.mockup-aguinaldo .result{padding:24px 20px}.mockup-aguinaldo .main-result{font-size:39px}.mockup-aguinaldo .month-grid,.mockup-aguinaldo .salary-months{grid-template-columns:repeat(3,1fr)}.mockup-aguinaldo .actions .ghost:first-child{display:none}}

.mockup-aguinaldo { width:100%; overflow:hidden; }
.mockup-aguinaldo .top, .mockup-aguinaldo header.top { display:none !important; }
.mockup-aguinaldo .foot { display:none !important; }
.mockup-aguinaldo .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-aguinaldo .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-aguinaldo .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-aguinaldo .support-real summary { cursor:pointer; font-weight:750; }
.mockup-aguinaldo .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-aguinaldo :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-aguinaldo input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-aguinaldo input[type="number"]::-webkit-inner-spin-button, .mockup-aguinaldo input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
