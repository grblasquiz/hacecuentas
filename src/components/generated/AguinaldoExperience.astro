---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-aguinaldo" set:html={`<section class="hero"><div class="wrap"><div class="crumb">Trabajo / Sueldo / Aguinaldo</div><div class="hero-grid"><div><div class="eyebrow">Sueldo Anual Complementario · Argentina</div><h1>Tu mejor sueldo tiene una segunda mitad.</h1><p class="lead">Calculá cuánto te corresponde de aguinaldo, qué descuentos lleva y cómo cambia si no trabajaste el semestre completo.</p><div class="stamps"><span class="stamp">LCT art. 121–123</span><span class="stamp">Fechas legales 2026</span><span class="stamp">Bruto y neto</span></div></div><div class="visual"><div class="envelope"></div><div class="receipt"><div class="rhead"><b>Recibo de SAC</b><span>2° CUOTA 2026</span></div><div class="rrow"><span>Mejor sueldo</span><b>$1.200.000</b></div><div class="rrow"><span>SAC bruto</span><b>$600.000</b></div><div class="rrow minus"><span>Aportes · 17%</span><b>− $102.000</b></div><div class="rtotal"><small>NETO A COBRAR</small><b>$498.000</b></div></div><div class="date-card"><small>FECHA LÍMITE</small><b>18 DIC</b></div><div class="half-card"><small>LA REGLA CLAVE</small><b>50% del mejor mes</b></div></div></div></div></section>
<section class="calculator"><div class="wrap"><div class="shell"><div class="form"><div class="form-head"><div><h2>Calculá tu aguinaldo</h2><p>Usamos el mejor sueldo del semestre, nunca el promedio.</p></div><button class="reset" id="resetBtn">Reiniciar</button></div><div class="modes"><button class="mode active" data-mode="dependencia"><b>En relación</b><small>Caso general</small></button><button class="mode" data-mode="casas"><b>Casas particulares</b><small>Aportes fijos</small></button><button class="mode" data-mode="proporcional"><b>Proporcional</b><small>Alta o egreso</small></button><button class="mode" data-mode="jubilado"><b>Jubilado ANSES</b><small>Haber + SAC</small></button></div><div class="fields"><div class="field"><label id="salaryLabel" for="salary">Mejor remuneración bruta del semestre</label><div class="input"><span class="prefix">$</span><input id="salary" inputmode="numeric" value="1.200.000"></div><div class="help">Incluye horas extra, comisiones y premios remunerativos.</div></div><div class="field"><label for="months">Meses completos</label><div class="input"><input id="months" type="number" min="0" max="6" value="6"><span class="suffix">de 6</span></div></div><div class="field"><label for="days">Días adicionales</label><div class="input"><input id="days" type="number" min="0" max="30" value="0"></div></div></div><div class="semester"><div class="semester-head"><b>Semestre computado</b><span>También podés tocar los meses</span></div><div class="month-grid"><button class="month on" data-month="1">MES 1</button><button class="month on" data-month="2">MES 2</button><button class="month on" data-month="3">MES 3</button><button class="month on" data-month="4">MES 4</button><button class="month on" data-month="5">MES 5</button><button class="month on" data-month="6">MES 6</button></div></div><div class="branch" id="jubiladoFields"><div class="field"><label for="bonus">Bono o refuerzo</label><div class="input"><span class="prefix">$</span><input id="bonus" inputmode="numeric" value="0"></div><div class="help">Se cobra aparte y no genera SAC.</div></div><div class="field"><label for="sac-discount-status">Descuento sobre SAC</label><div class="input"><input id="sac-discount-status" value="Sin aportes del régimen activo" readonly></div></div></div><button class="calcbtn" id="calcBtn">Actualizar mi aguinaldo</button></div>
<aside class="result" aria-live="polite"><span class="result-label">AGUINALDO NETO ESTIMADO</span><strong class="main-result" id="net">$498.000</strong><div class="result-sub" id="summary">Semestre completo · base $1.200.000 · SAC bruto $600.000.</div><div class="timeline"><div class="tbar"><span class="worked" id="workedBar"></span></div><div class="tlabs"><span id="workedLabel">6 meses computados</span><span id="outsideLabel">0 afuera</span></div></div><div class="breakdown"><div class="row"><span id="baseLabel">Mejor remuneración</span><b id="baseOut">$1.200.000</b></div><div class="row add"><span>50% del mejor mes</span><b id="halfOut">$600.000</b></div><div class="row"><span>Proporción trabajada</span><b id="ratioOut">100%</b></div><div class="row add"><span>SAC bruto proporcional</span><b id="grossOut">$600.000</b></div><div class="row minus"><span id="contribLabel">Aportes personales · 17%</span><b id="contribOut">− $102.000</b></div><div class="row total"><span>Neto a cobrar</span><b id="netOut">$498.000</b></div></div><div class="deadline"><div><small id="deadlineLabel">SEGUNDA CUOTA</small><b id="deadlineText">Vence el 18 de diciembre</b></div><strong id="deadlineDay">18 DIC</strong></div></aside></div></div></section>
<section class="cases"><div class="wrap"><div class="section-head"><div class="eyebrow">Todos los casos, a la vista</div><h2>La fórmula es parecida. Los descuentos no.</h2><p>Elegir arriba cambia la cuenta, pero ninguna situación desaparece de la página.</p></div><div class="case-grid"><article class="case"><span class="case-icon">½</span><h3>Relación de dependencia</h3><p>El 50% de la mejor remuneración del semestre, proporcional al tiempo.</p><ul><li>Aportes personales del 17%</li><li>Horas extra y comisiones entran</li><li>30 de junio / 18 de diciembre</li></ul></article><article class="case"><span class="case-icon">⌂</span><h3>Casas particulares</h3><p>Medio mejor sueldo, incluso por hora, por día o jornada parcial.</p><ul><li>Cada empleador paga su parte</li><li>Sin retención porcentual del 17%</li><li>Recibo y registración</li></ul></article><article class="case"><span class="case-icon">%</span><h3>SAC proporcional</h3><p>Si entraste, renunciaste o te despidieron durante el semestre.</p><ul><li>Se calcula por días</li><li>Va en la liquidación final</li><li>No lo absorbe la indemnización</li></ul></article><article class="case"><span class="case-icon">A</span><h3>Jubilados y pensionados</h3><p>El 50% del mejor haber; bonos y refuerzos se suman aparte.</p><ul><li>Se cobra con junio o diciembre</li><li>Calendario según DNI</li><li>Cada prestación genera SAC</li></ul></article></div></div></section>
<section class="best"><div class="wrap best-grid"><div><div class="eyebrow">¿No sabés cuál fue el mejor?</div><h2>Cargá los seis meses y lo encontramos.</h2><p>No uses un promedio. Un solo mes con horas extra o comisiones puede subir todo el aguinaldo.</p></div><div class="salary-list"><div class="salary-head"><b>Remuneración bruta de cada mes</b><span>Opcional</span></div><div class="salary-months"><div class="smonth"><label>MES 1</label><input class="salary-month" value="1050000"></div><div class="smonth"><label>MES 2</label><input class="salary-month" value="1100000"></div><div class="smonth"><label>MES 3</label><input class="salary-month" value="1080000"></div><div class="smonth"><label>MES 4</label><input class="salary-month" value="1200000"></div><div class="smonth"><label>MES 5</label><input class="salary-month" value="1150000"></div><div class="smonth"><label>MES 6</label><input class="salary-month" value="1180000"></div></div><button class="findbtn" id="findBest">Usar el mejor sueldo</button><div class="best-result" id="bestResult">El mejor del ejemplo es <b>$1.200.000</b> en el mes 4.</div></div></div></section>
<section class="law"><div class="wrap"><div class="section-head"><div class="eyebrow">Lo que manda la ley</div><h2>Tres reglas para revisar tu recibo.</h2></div><div class="law-grid"><article class="law-card"><small>REGLA 01</small><b>Se toma el mejor mes.</b><p>No el promedio, no el último sueldo y no la mejor quincena aislada.</p></article><article class="law-card"><small>REGLA 02</small><b>Lo remunerativo suma.</b><p>Horas extra, premios y comisiones del mejor mes integran la base.</p></article><article class="law-card"><small>REGLA 03</small><b>El proporcional no se pierde.</b><p>Corresponde aunque hayas ingresado o egresado durante el semestre.</p></article></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="searchBtn" hidden aria-hidden="true"></button><button type="button" id="countryBtn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-aguinaldo')?document.currentScript.previousElementSibling:document.querySelector('.mockup-aguinaldo');

const $=id=>root.querySelector("#"+id),CAP=4414652.38;let mode="dependencia";const money=n=>"$"+Math.round(Math.max(0,n||0)).toLocaleString("es-AR");const num=id=>Math.max(0,Number(String($(id).value).replace(/\./g,"").replace(",", "."))||0);
function formatInput(el){let n=String(el.value).replace(/\D/g,"");el.value=n?Number(n).toLocaleString("es-AR"):"0"}
function calculate(show=false){let salary=num("salary"),months=Math.max(0,Math.min(6,+$("months").value||0)),days=Math.max(0,Math.min(30,+$("days").value||0)),ratio=Math.min(1,months/6+days/181),half=salary/2,gross=half*ratio,rate=mode==="dependencia"||mode==="proporcional"?.17:0,contrib=Math.min(gross,CAP/2)*rate,net=gross-contrib,bonus=mode==="jubilado"?num("bonus"):0;
 $("net").textContent=$("netOut").textContent=money(net);$("baseOut").textContent=money(salary);$("halfOut").textContent=money(half);$("ratioOut").textContent=Math.round(ratio*100)+"%";$("grossOut").textContent=money(gross);$("contribOut").textContent=rate?"− "+money(contrib):"$0";$("contribLabel").textContent=rate?"Aportes personales · 17%":mode==="casas"?"Sin retención porcentual":"Sin aportes del régimen activo";$("workedBar").style.width=ratio*100+"%";let monthsText=(ratio*6).toLocaleString("es-AR",{maximumFractionDigits:1}),outsideText=((1-ratio)*6).toLocaleString("es-AR",{maximumFractionDigits:1});$("workedLabel").textContent=`${monthsText} meses computados`;$("outsideLabel").textContent=`${outsideText} afuera`;$("summary").textContent=`${ratio===1?"Semestre completo":"SAC proporcional"} · base ${money(salary)} · SAC bruto ${money(gross)}${bonus?` · bono aparte ${money(bonus)}`:""}.`;
 root.querySelectorAll(".month").forEach((b,i)=>b.classList.toggle("on",i<Math.ceil(months)));if(show)toast("✓ Aguinaldo actualizado")}
function setMode(m){mode=m;root.querySelectorAll(".mode").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$("jubiladoFields").classList.toggle("active",m==="jubilado");$("salaryLabel").textContent=m==="jubilado"?"Mejor haber del semestre":m==="casas"?"Mejor sueldo mensual del semestre":"Mejor remuneración bruta del semestre";$("baseLabel").textContent=m==="jubilado"?"Mejor haber":m==="casas"?"Mejor sueldo mensual":"Mejor remuneración";$("deadlineText").textContent=m==="jubilado"?"Se cobra con el haber según DNI":m==="casas"?"Hasta el último día hábil":"Vence el 18 de diciembre";calculate()}
function toast(t){$("toast").textContent=t;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1700)}
root.querySelectorAll(".mode").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));root.querySelectorAll(".month").forEach(b=>b.onclick=()=>{$("months").value=+b.dataset.month;calculate(true)});["salary","bonus"].forEach(id=>$(id).addEventListener("input",()=>{formatInput($(id));calculate()}));["months","days"].forEach(id=>$(id).addEventListener("input",()=>calculate()));$("calcBtn").onclick=()=>calculate(true);$("resetBtn").onclick=()=>{$("salary").value="1.200.000";$("months").value=6;$("days").value=0;$("bonus").value=0;setMode("dependencia");toast("Datos reiniciados")};$("findBest").onclick=()=>{let vals=[...root.querySelectorAll(".salary-month")].map(i=>Math.max(0,+String(i.value).replace(/\D/g,"")||0)),max=Math.max(...vals),idx=vals.indexOf(max);$("salary").value=max.toLocaleString("es-AR");$("bestResult").innerHTML=`El mejor sueldo es <b>${money(max)}</b> en el mes ${idx+1}. Ya lo usamos en la cuenta.`;calculate(true);root.querySelector(".calculator").scrollIntoView({block:"center"})};$("searchBtn").onclick=()=>toast("Buscar calculadoras");$("countryBtn").onclick=()=>toast("Argentina seleccionada 🇦🇷");calculate();

})();
</script>
