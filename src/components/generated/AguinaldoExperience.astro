ne);border-radius:14px;padding:14px}.mockup-aguinaldo .semester-head{display:flex;justify-content:space-between;gap:20px;font-size:11px;font-weight:850;margin-bottom:10px}.mockup-aguinaldo .semester-head span{color:var(--muted);font-size:9px}.mockup-aguinaldo .month-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}.mockup-aguinaldo .month{border:1px solid var(--line);background:#f7f8f5;border-radius:9px;padding:9px 4px;text-align:center;font-size:9px;font-weight:850;cursor:pointer}.mockup-aguinaldo .month.on{background:var(--green2);border-color:#73af9d;color:#276c5a}.mockup-aguinaldo .branch{display:none;margin-top:13px;padding:13px;border:1px solid var(--line);background:#f7f8f5;border-radius:13px;grid-template-columns:1fr 1fr;gap:12px}.mockup-aguinaldo .branch.active{display:grid}.mockup-aguinaldo .calcbtn{width:100%;border:0;border-radius:12px;background:#b77a21;color:#fff;padding:14px;margin-top:17px;font-weight:900;cursor:pointer}
