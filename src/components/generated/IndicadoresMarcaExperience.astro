---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-indicadores-marca" set:html={`<div class="crumb">Negocios / Marca</div><h1>Una marca fuerte deja señales antes de vender.</h1><p class="lead">Reuní recuerdo, preferencia, recomendación, búsqueda y recompra para encontrar el cuello de botella real.</p><section class="radarroom"><div class="radar"><svg id="radar" viewBox="0 0 500 470"></svg></div><aside class="signals"><h2>Señales observables</h2><div id="sliders"></div><div class="headline"><span>Índice compuesto</span><b id="score"></b><p id="reading"></p></div><div class="priority" id="priority"></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-indicadores-marca')?document.currentScript.previousElementSibling:document.querySelector('.mockup-indicadores-marca');

const names=['Recuerdo','Preferencia','Recomendación','Búsqueda','Recompra'],vals=[45,38,62,54,31],$=x=>root.querySelector("#"+x);$('sliders').innerHTML=names.map((n,i)=>`<div class=\"signal\"><label>${n}<output id=\"o${i}\">${vals[i]}</output></label><input data-i=\"${i}\" type=\"range\" min=\"0\" max=\"100\" value=\"${vals[i]}\"></div>`).join('');function render(){let cx=250,cy=235,R=175,pts=[];const point=(i,r)=>{let a=-Math.PI/2+i*Math.PI*2/5;return[cx+Math.cos(a)*r,cy+Math.sin(a)*r]};let web='';for(let level=1;level<=4;level++)web+=`<polygon class=\"web\" points=\"${names.map((_,i)=>point(i,R*level/4).join(',')).join(' ')}\"/>`;for(let i=0;i<5;i++){let p=point(i,R);web+=`<line class=\"axis\" x1=\"${cx}\" y1=\"${cy}\" x2=\"${p[0]}\" y2=\"${p[1]}\"/><text x=\"${p[0]}\" y=\"${p[1]}\" text-anchor=\"middle\">${names[i]}</text>`;pts.push(point(i,R*vals[i]/100).join(','))}$('radar').innerHTML=web+`<polygon class=\"shape\" points=\"${pts.join(' ')}\"/>`;let score=Math.round(vals.reduce((a,b)=>a+b)/5),min=Math.min(...vals),idx=vals.indexOf(min);$('score').textContent=score+'/100';$('reading').textContent=score<40?'Hay reconocimiento aislado, pero todavía no una marca consistente.':score<70?'La marca tiene tracción; cerrar la brecha más débil puede mejorar el conjunto.':'Las señales son sólidas y relativamente equilibradas.';$('priority').textContent=`Prioridad: ${names[idx]} (${min}). Diseñá la próxima medición alrededor de esta señal.`}
root.querySelectorAll('[data-i]').forEach(x=>x.oninput=()=>{vals[+x.dataset.i]=+x.value;$('o'+x.dataset.i).textContent=x.value;render()});render();

})();
</script>
<style is:global>

.mockup-indicadores-marca{--blue:#174b7a;--ink:#182a32;--muted:#64747c;--line:#d7e1df;--purple:#7959a7;--orange:#e37848;--paper:#f5f7f5}.mockup-indicadores-marca *{box-sizing:border-box}.mockup-indicadores-marca{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-indicadores-marca input,.mockup-indicadores-marca button{font:inherit}.mockup-indicadores-marca .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-indicadores-marca .crumb{color:var(--blue);font-weight:850}.mockup-indicadores-marca h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-indicadores-marca .lead{font-size:18px;color:var(--muted)}.mockup-indicadores-marca .radarroom{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:26px}.mockup-indicadores-marca .radar,.mockup-indicadores-marca .signals{background:#fff;border:1px solid var(--line);border-radius:24px;padding:23px}.mockup-indicadores-marca .radar svg{width:100%;height:470px}.mockup-indicadores-marca .web{fill:none;stroke:#d4dfdc}.mockup-indicadores-marca .shape{fill:#7959a755;stroke:var(--purple);stroke-width:4}.mockup-indicadores-marca .axis{stroke:#9eb0ab}.mockup-indicadores-marca .signals h2{margin:0}.mockup-indicadores-marca .signal{margin:17px 0}.mockup-indicadores-marca .signal label{display:flex;justify-content:space-between;font-weight:800}.mockup-indicadores-marca .signal input{width:100%;accent-color:var(--purple)}.mockup-indicadores-marca .headline{background:var(--blue);color:#fff;border-radius:17px;padding:17px;margin-top:18px}.mockup-indicadores-marca .headline b{display:block;font-size:27px}.mockup-indicadores-marca .headline p{color:#dbe8ee}.mockup-indicadores-marca .priority{border-left:5px solid var(--orange);padding:13px;background:#fff2df;margin-top:12px}@media(max-width:780px){.mockup-indicadores-marca .radarroom{grid-template-columns:1fr}.mockup-indicadores-marca .radar svg{height:360px}}
.mockup-indicadores-marca { width:100%; overflow:hidden; }
.mockup-indicadores-marca .top, .mockup-indicadores-marca header.top { display:none !important; }
.mockup-indicadores-marca .foot { display:none !important; }
.mockup-indicadores-marca .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-indicadores-marca .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-indicadores-marca .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-indicadores-marca .support-real summary { cursor:pointer; font-weight:750; }
.mockup-indicadores-marca .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-indicadores-marca :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-indicadores-marca input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-indicadores-marca input[type="number"]::-webkit-inner-spin-button, .mockup-indicadores-marca input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-indicadores-marca .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-indicadores-marca support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
