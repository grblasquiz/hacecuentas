<div class="mockup-negocios-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Negocios</div><div class="heroGrid"><div><span class="eyebrow">Números para hacer crecer el negocio</span><h1>Vender más sirve si también te queda más.</h1><p class="lead">Precio, margen, comisiones, marketing, caja y equipo en una misma lógica. Entendé qué mueve el resultado antes de decidir.</p><div class="trust"><span>✓ Margen ≠ markup</span><span>✓ Costos completos</span><span>✓ Escenarios comparables</span></div><div class="chart"><i></i><i></i><i></i><i></i></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Tu precio es rentable?</h2><p>Calculá margen y punto de equilibrio.</p></div><span class="live">EN VIVO</span></div><div class="fields"><div class="field"><label>Costo variable por unidad</label><div class="input"><span>$</span><input id="cost" value="8500"></div></div><div class="field"><label>Precio de venta</label><div class="input"><span>$</span><input id="price" value="15000"></div></div><div class="field"><label>Comisión del canal</label><div class="input"><input id="fee" value="12"><span>%</span></div></div><div class="field"><label>Costos fijos mensuales</label><div class="input"><span>$</span><input id="fixed" value="1800000"></div></div><div class="field wide"><label>Unidades vendidas por mes</label><div class="input"><input id="units" value="500"><span>unidades</span></div></div></div><button class="primary" id="calculate">Actualizar rentabilidad</button><div class="result"><div class="resultTop"><div><small>MARGEN DE CONTRIBUCIÓN POR UNIDAD</small><div class="amount" id="contribution">$4.700</div></div><span class="badge" id="verdict">Negocio rentable</span></div><div class="bar"><i id="costBar"></i><i id="marginBar"></i></div><div class="resultGrid"><div class="metric"><span>MARGEN SOBRE VENTA</span><b id="margin">31,3%</b></div><div class="metric"><span>MARKUP SOBRE COSTO</span><b id="markup">76,5%</b></div><div class="metric"><span>PUNTO DE EQUILIBRIO</span><b id="breakEven">383 unidades</b></div></div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por la decisión</span><h2>¿Qué necesitás resolver ahora?</h2><p>Elegí la pregunta y priorizamos las herramientas adecuadas.</p></div><div class="needs"><button class="need active" data-filter="pricing"><span class="icon">$</span><h3>¿A qué precio vendo?</h3><p>Margen, markup, IVA y comisiones.</p><em>→</em></button><button class="need" data-filter="cash"><span class="icon">⇄</span><h3>Vendo pero no tengo caja</h3><p>Cobranza, stock y proveedores.</p><em>→</em></button><button class="need" data-filter="marketing"><span class="icon">↗</span><h3>¿Funciona mi marketing?</h3><p>CAC, ROAS, CPA y conversión.</p><em>→</em></button><button class="need" data-filter="channels"><span class="icon">▤</span><h3>¿Qué canal conviene?</h3><p>Comisiones y neto por plataforma.</p><em>→</em></button><button class="need" data-filter="team"><span class="icon">＋</span><h3>¿Puedo contratar?</h3><p>Costo laboral y productividad.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de negocio</span><h2>Cada decisión, con su cuenta completa.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="pricing">Precio</button><button class="filter" data-filter="cash">Caja</button><button class="filter" data-filter="marketing">Marketing</button><button class="filter" data-filter="channels">Canales</button><button class="filter" data-filter="team">Equipo</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="cash" data-text="capital trabajo ciclo conversión caja stock cobranza proveedores"><span class="tag">Diagnóstico completo</span><h3>Capital de trabajo</h3><p>Entendé por qué la caja tarda en volver y cuánto dinero necesita financiar la operación.</p><button>Diagnosticar mi caja →</button></article><article class="card" data-cat="pricing" data-text="margen markup precio rentabilidad costo"><span class="tag">Precio</span><h3>Margen y markup</h3><p>Separá ambos conceptos y definí un precio rentable.</p><button>Calcular →</button></article><article class="card" data-cat="pricing" data-text="punto equilibrio unidades ventas costo fijo"><span class="tag">Rentabilidad</span><h3>Punto de equilibrio</h3><p>Cuántas unidades y ventas necesitás para no perder.</p><button>Calcular →</button></article><article class="card" data-cat="channels" data-text="comisiones plataforma marketplace mercadolibre tienda neto"><span class="tag">Canales</span><h3>Comisiones de plataforma</h3><p>Compará lo que realmente recibís en cada canal.</p><button>Comparar →</button></article><article class="card" data-cat="channels cash" data-text="ingresos plataforma comisiones retenciones neto"><span class="tag">Liquidación</span><h3>Ingresos por plataforma</h3><p>Ventas, descuentos, retenciones y depósito final.</p><button>Revisar →</button></article><article class="card" data-cat="marketing" data-text="marketing cac cpa roas ctr conversión"><span class="tag">Adquisición</span><h3>Métricas de marketing</h3><p>CAC, ROAS, CPA, CTR y tasa de conversión.</p><button>Calcular →</button></article><article class="card" data-cat="team" data-text="costo empleado contratar sueldo cargas"><span class="tag">Equipo</span><h3>Costo de un empleado</h3><p>Sueldo, contribuciones, ART y costo total.</p><button>Calcular →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Tablero esencial</span><h2>Cuatro números para no manejar a ciegas.</h2></div><div class="dashboard"><article class="panel"><h3>Lo que conviene mirar cada mes</h3><p>No hace falta empezar con veinte indicadores.</p><div class="line"><span>Margen de contribución</span><b>¿Cada venta suma?</b></div><div class="line"><span>Punto de equilibrio</span><b>¿Cuánto falta?</b></div><div class="line"><span>Ciclo de caja</span><b>¿Cuándo vuelve?</b></div><div class="line"><span>Costo de adquisición</span><b>¿Cuánto cuesta crecer?</b></div></article><article class="panel dark"><h3>Una advertencia útil</h3><p>Ganancia y caja no son lo mismo. Podés tener ventas rentables y quedarte sin efectivo si cobrás tarde, acumulás stock o pagás antes a proveedores.</p><div class="line"><span>Resultado económico</span><b>Margen</b></div><div class="line"><span>Supervivencia diaria</span><b>Caja</b></div><div class="line"><span>Escala sostenible</span><b>Ambos</b></div></article></div><div class="decision"><article class="room"><h3>¿Subo el precio?</h3><p>Demanda, margen y volumen necesario después del cambio.</p><button data-room="Precio">Comparar escenarios →</button></article><article class="room"><h3>¿Vendo en otra plataforma?</h3><p>Comisión, logística, conversión y plazo de cobro.</p><button data-room="Canal">Comparar canales →</button></article><article class="room"><h3>¿Contrato ahora?</h3><p>Costo total, ventas adicionales y meses de respaldo.</p><button data-room="Contratación">Evaluar contratación →</button></article></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-negocios-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-negocios-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],num=id=>Math.max(0,Number($(id).value.replaceAll(".","").replaceAll(",",""))||0),money=n=>"$"+Math.round(n).toLocaleString("es-AR");
function calc(){const cost=num("#cost"),price=num("#price"),fee=num("#fee")/100,fixed=num("#fixed"),units=num("#units"),netPrice=price*(1-fee),contribution=netPrice-cost,margin=price?contribution/price*100:0,markup=cost?(price-cost)/cost*100:0,be=contribution>0?Math.ceil(fixed/contribution):0,profit=contribution*units-fixed;$("#contribution").textContent=money(contribution);$("#margin").textContent=margin.toLocaleString("es-AR",{maximumFractionDigits:1})+"%";$("#markup").textContent=markup.toLocaleString("es-AR",{maximumFractionDigits:1})+"%";$("#breakEven").textContent=be?be+" unidades":"Sin equilibrio";$("#verdict").textContent=contribution<=0?"Cada venta pierde plata":profit<0?"Aún no cubre costos fijos":"Negocio rentable";const cp=price?Math.min(100,(price-contribution)/price*100):100;$("#costBar").style.width=cp+"%";$("#marginBar").style.width=Math.max(0,100-cp)+"%"}
$$(".calc input").forEach(x=>x.oninput=calc);$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Rentabilidad actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$("#search").value="";$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$("[data-room]").forEach(b=>b.onclick=()=>toast("Abriendo sala: "+b.dataset.room));$$("header .sm").forEach((b,i)=>b.onclick=()=>toast(i===0?"Abriendo buscador de herramientas":"Selector de país: Argentina"));$$(".calc input").forEach(i=>i.addEventListener("keydown",e=>{if(e.key==="Enter")calc()}));calc();

})();
</script>
