---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-fotografia" set:html={`<section class="hero"><div class="wrap"><div class="crumb">Tecnología / Fotografía / Archivos e impresión</div><div class="hero-grid"><div><div class="eyebrow">Planificador de fotografía y video</div><h1>De la cámara a la pared, sin adivinar.</h1><p class="lead">Calculá cuántas fotos entran, cuánto pesa tu video, hasta qué tamaño podés imprimir y cuánto necesita una secuencia.</p><div class="stamps"><span class="stamp">Tarjetas y discos</span><span class="stamp">Video por bitrate</span><span class="stamp">Impresión por DPI</span></div></div><div class="photo-stack"><div class="print one"><div class="scene"><span class="sun"></span><span class="hill"></span><span class="hill b"></span><span class="road"></span></div><span class="caption">24 MP · 6000 × 4000 px</span></div><div class="print two"><div class="scene"><span class="sun"></span><span class="hill"></span><span class="hill b"></span><span class="road"></span></div><span class="caption">RAW · 26,4 MB</span></div><div class="storage"><small>TARJETA 64 GB</small><b>2.424 fotos</b></div><div class="mp"><small>IMPRESIÓN 300 DPI</small><b>50,8 × 33,9 cm</b></div></div></div></div></section>
<section class="calculator"><div class="wrap"><div class="shell"><div class="form"><div class="form-head"><div><h2>Planificá tu sesión</h2><p>Cargá una vez los datos. Cambiá la pregunta sin empezar de nuevo.</p></div><button class="reset" id="resetBtn">Reiniciar</button></div><div class="modes"><button class="mode active" data-mode="tarjeta"><b>Tarjeta</b><small>Cuántas fotos entran</small></button><button class="mode" data-mode="video"><b>Video</b><small>Peso por bitrate</small></button><button class="mode" data-mode="impresion"><b>Impresión</b><small>Tamaño y DPI</small></button><button class="mode" data-mode="secuencia"><b>Secuencia</b><small>Time-lapse / stop motion</small></button></div><div class="fields"><div class="field"><label for="capacity">Capacidad</label><div class="input"><input id="capacity" type="number" min="1" value="64"><span class="suffix">GB</span></div></div><div class="field"><label for="mp">Resolución</label><div class="input"><input id="mp" type="number" min=".1" step=".1" value="24"><span class="suffix">MP</span></div></div><div class="field"><label for="format">Formato</label><div class="input"><select id="format"><option value=".3">JPG media</option><option value=".5">JPG alta</option><option value="1.1" selected>RAW comprimido</option><option value="1.5">RAW sin comprimir</option><option value="2">RAW + JPG</option></select></div></div></div>
<div class="branch active" id="tarjetaFields"><div class="field"><label for="planned">Fotos previstas</label><div class="input"><input id="planned" type="number" min="0" value="800"><span class="suffix">fotos</span></div></div><div class="field"><label for="videoMin">Video previsto</label><div class="input"><input id="videoMin" type="number" min="0" value="20"><span class="suffix">min</span></div></div><div class="field"><label for="bitrate">Bitrate del video</label><div class="input"><input id="bitrate" type="number" min=".1" value="100"><span class="suffix">Mbps</span></div></div></div><div class="branch" id="videoFields"><div class="field"><label for="videoDuration">Duración</label><div class="input"><input id="videoDuration" type="number" min="1" value="20"><span class="suffix">min</span></div></div><div class="field"><label for="videoRate">Bitrate</label><div class="input"><input id="videoRate" type="number" min=".1" value="100"><span class="suffix">Mbps</span></div></div><div class="field"><label for="audioRate">Audio</label><div class="input"><input id="audioRate" type="number" min="0" value="192"><span class="suffix">kbps</span></div></div></div><div class="branch" id="impresionFields"><div class="field"><label for="ratio">Relación</label><div class="input"><select id="ratio"><option value="1.5" selected>3:2 · cámara</option><option value="1.333">4:3 · celular</option><option value="1.778">16:9 · pantalla</option><option value="1">1:1 · cuadrado</option></select></div></div><div class="field"><label for="dpi">Calidad</label><div class="input"><select id="dpi"><option value="300" selected>300 DPI · foto</option><option value="240">240 DPI · alta</option><option value="150">150 DPI · póster</option><option value="72">72 DPI · gran formato</option></select></div></div><div class="field"><label for="printWidth">Ancho deseado</label><div class="input"><input id="printWidth" type="number" min="1" value="30"><span class="suffix">cm</span></div></div></div><div class="branch" id="secuenciaFields"><div class="field"><label for="finalDuration">Video final</label><div class="input"><input id="finalDuration" type="number" min="1" value="30"><span class="suffix">s</span></div></div><div class="field"><label for="fps">Cuadros por segundo</label><div class="input"><input id="fps" type="number" min="1" value="12"><span class="suffix">fps</span></div></div><div class="field"><label for="interval">Intervalo</label><div class="input"><input id="interval" type="number" min=".1" step=".5" value="5"><span class="suffix">s</span></div></div></div><button class="calcbtn" id="calcBtn">Actualizar mi plan</button></div>
<aside class="result" aria-live="polite"><span class="result-label" id="resultLabel">ENTRAN EN TU TARJETA</span><strong class="main-result" id="mainResult">2.424 fotos</strong><div class="result-sub" id="resultSub">RAW comprimido de 24 MP: 26,4 MB por foto. Tu plan deja espacio de sobra.</div><div class="capacity"><div class="capbar"><span class="used" id="usedBar"></span></div><div class="caplabels"><span id="usedLabel">36,2 GB ocupados</span><span id="freeLabel">27,8 GB libres</span></div></div><div class="metrics"><div class="metric"><small id="metric1Label">PESO POR FOTO</small><b id="metric1">26,4 MB</b></div><div class="metric"><small id="metric2Label">FOTOS RESTANTES</small><b id="metric2">1.054</b></div><div class="metric full"><div><small id="metric3Label">ESTADO DEL PLAN</small><b id="metric3">Tenés margen</b></div><strong id="metric3Value">43% libre</strong></div></div><div class="detail"><div class="drow"><span id="detail1Label">Capacidad nominal</span><b id="detail1">64 GB</b></div><div class="drow"><span id="detail2Label">La computadora muestra</span><b id="detail2">59,6 GiB</b></div><div class="drow"><span id="detail3Label">Capacidad útil estimada</span><b id="detail3">62,1 GB</b></div></div></aside></div></div></section>
<section class="cases"><div class="wrap"><div class="section-head"><div class="eyebrow">Cuatro preguntas, los mismos datos</div><h2>Todo lo que pasa después de disparar.</h2><p>Las cuatro herramientas quedan visibles y conectadas para que puedas planificar la sesión completa.</p></div><div class="case-grid"><article class="case"><span class="case-icon">SD</span><h3>¿Me alcanza la tarjeta?</h3><p>Fotos, video previsto, formato y espacio que todavía queda libre.</p><strong>64 GB + 24 MP RAW → 2.424 fotos</strong></article><article class="case"><span class="case-icon">4K</span><h3>¿Cuánto pesa el video?</h3><p>El bitrate manda sobre el tamaño, no la etiqueta 4K o Full HD.</p><strong>100 Mbps → 45 GB por hora</strong></article><article class="case"><span class="case-icon">DPI</span><h3>¿Hasta cuánto imprimo?</h3><p>Píxeles, proporción y distancia de visualización determinan el tamaño.</p><strong>24 MP → 50,8 cm a 300 DPI</strong></article><article class="case"><span class="case-icon">24</span><h3>¿Cuántos cuadros necesito?</h3><p>Time-lapse y stop motion con tiempo de captura y almacenamiento.</p><strong>30 s × 24 fps → 720 fotos</strong></article></div></div></section>
<section class="formats"><div class="wrap format-grid"><div><div class="eyebrow">Elegí el formato con intención</div><h2>Calidad, peso y velocidad no crecen igual.</h2><p>El promedio cambia por cámara y escena, pero esta comparación te da una base útil antes de salir.</p></div><div><div class="format-list"><div class="frow head"><span>FORMATO</span><span>MB POR MP</span><span>EN 64 GB · 24 MP</span></div><div class="frow"><b>JPG calidad media</b><span>0,3</span><strong>8.888 fotos</strong></div><div class="frow"><b>JPG calidad alta</b><span>0,5</span><strong>5.333 fotos</strong></div><div class="frow"><b>RAW comprimido</b><span>1,1</span><strong>2.424 fotos</strong></div><div class="frow"><b>RAW sin comprimir</b><span>1,5</span><strong>1.777 fotos</strong></div><div class="frow"><b>RAW + JPG</b><span>2,0</span><strong>1.333 fotos</strong></div></div><div class="tip">Los RAW reales pueden variar hasta un 30% por compresión y detalle de la escena.</div></div></div></section>
<section class="related"><div class="wrap"><div class="related-card"><div><div class="eyebrow" style="color:#6fddd5">Antes de guardar la foto</div><h2>¿Todavía estás eligiendo ISO, apertura y velocidad?</h2><p>Usá el asistente de ajustes de cámara para resolver la exposición y volver acá con el archivo final.</p></div><button id="cameraBtn">Ver ajustes de cámara →</button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="searchBtn" hidden aria-hidden="true"></button><button type="button" id="countryBtn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-fotografia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-fotografia');

const $=id=>root.querySelector("#"+id);let mode="tarjeta";const formatNames={".3":"JPG media",".5":"JPG alta","1.1":"RAW comprimido","1.5":"RAW sin comprimir","2":"RAW + JPG"};const nf=(n,d=0)=>Number(n||0).toLocaleString("es-AR",{minimumFractionDigits:d,maximumFractionDigits:d});
function setText(id,v){$(id).textContent=v}function status(p){return p>100?"No entra":p>80?"Casi llena":p>50?"Revisá el margen":"Tenés margen"}
function calculate(show=false){let cap=Math.max(0,+$("capacity").value||0),mp=Math.max(0,+$("mp").value||0),factor=+$("format").value,mbPhoto=mp*factor,capMB=cap*1000,used=0,main="",sub="",m1="",m2="",m3="",m3v="",d1="",d2="",d3="";
 if(mode==="tarjeta"){let planned=Math.max(0,+$("planned").value||0),mins=Math.max(0,+$("videoMin").value||0),rate=Math.max(0,+$("bitrate").value||0);used=planned*mbPhoto+mins*rate*60/8;let free=capMB-used,total=Math.floor(capMB/mbPhoto);main=`${nf(total)} fotos`;sub=`${formatNames[$("format").value]} de ${nf(mp,1)} MP: ${nf(mbPhoto,1)} MB por foto. ${free>=0?"Tu plan deja espacio disponible.":"Tu plan supera la tarjeta."}`;m1=`${nf(mbPhoto,1)} MB`;m2=`${nf(Math.max(0,free)/mbPhoto)} fotos`;m3=status(used/capMB*100);m3v=`${nf(Math.max(0,free/capMB*100))}% libre`;d1=`${nf(cap)} GB`;d2=`${nf(cap/1.0737,1)} GiB`;d3=`${nf(cap*.97,1)} GB`;setText("resultLabel","ENTRAN EN TU TARJETA");setText("metric1Label","PESO POR FOTO");setText("metric2Label","FOTOS RESTANTES");setText("metric3Label","ESTADO DEL PLAN");setText("detail1Label","Capacidad nominal");setText("detail2Label","La computadora muestra");setText("detail3Label","Capacidad útil estimada")}
 if(mode==="video"){let mins=+$("videoDuration").value||0,rate=+$("videoRate").value||0,audio=+$("audioRate").value||0,perMin=rate*60/8+(audio/1000)*60/8;used=perMin*mins;main=`${nf(used/1000,2)} GB`;sub=`${nf(mins)} minutos a ${nf(rate)} Mbps. El bitrate define el peso final, aunque cambie la resolución.`;m1=`${nf(perMin,1)} MB`;m2=`${nf(perMin*60/1000,1)} GB`;m3=status(used/capMB*100);m3v=`${nf(used/capMB*100)}% tarjeta`;d1=`${nf(capMB/perMin,1)} min`;d2=`${nf(Math.max(0,capMB-used)/1000,1)} GB`;d3=`${nf(used/1024,2)} GiB`;setText("resultLabel","PESO ESTIMADO DEL VIDEO");setText("metric1Label","POR MINUTO");setText("metric2Label","POR HORA");setText("metric3Label","EN TU TARJETA");setText("detail1Label","Minutos que entran");setText("detail2Label","Espacio restante");setText("detail3Label","Archivo en base binaria")}
 if(mode==="impresion"){let ratio=+$("ratio").value||1.5,dpi=+$("dpi").value||300,want=+$("printWidth").value||30,total=mp*1e6,pxW=Math.sqrt(total*ratio),pxH=pxW/ratio,w=pxW/dpi*2.54,h=pxH/dpi*2.54,realDpi=pxW/(want/2.54);used=want/w*100;main=`${nf(w,1)} × ${nf(h,1)} cm`;sub=`Máximo a ${nf(dpi)} DPI. Impresa a ${nf(want)} cm de ancho queda en ${nf(realDpi)} DPI reales.`;m1=`${nf(pxW)} px`;m2=`${nf(pxH)} px`;m3=realDpi>=300?"Calidad foto":realDpi>=150?"Buen póster":"Ver de lejos";m3v=`${nf(realDpi)} DPI`;d1=`${nf(pxW/300*2.54,1)} cm`;d2=`${nf(pxW/150*2.54,1)} cm`;d3=`${nf((want/2.54*dpi)*(want/ratio/2.54*dpi)/1e6,1)} MP`;setText("resultLabel","TAMAÑO MÁXIMO DE IMPRESIÓN");setText("metric1Label","ANCHO EN PÍXELES");setText("metric2Label","ALTO EN PÍXELES");setText("metric3Label","CALIDAD AL ANCHO PEDIDO");setText("detail1Label","Máximo a 300 DPI");setText("detail2Label","Máximo a 150 DPI");setText("detail3Label","MP necesarios al tamaño pedido")}
 if(mode==="secuencia"){let sec=+$("finalDuration").value||0,fps=+$("fps").value||0,int=+$("interval").value||0,photos=Math.ceil(sec*fps);used=photos*mbPhoto;let hours=photos*int/3600;main=`${nf(photos)} fotos`;sub=`Para ${nf(sec)} segundos a ${nf(fps)} fps. La captura dura ${nf(hours,1)} horas y ocupa ${nf(used/1000,1)} GB.`;m1=`${nf(hours,1)} h`;m2=`${nf(used/1000,1)} GB`;m3=status(used/capMB*100);m3v=`${nf(used/capMB*100)}% tarjeta`;d1=`${nf(photos/24,1)} s`;d2=`${nf(Math.max(0,capMB-used)/1000,1)} GB`;d3=`${nf(Math.floor(capMB/mbPhoto))} fotos`;setText("resultLabel","FOTOS PARA LA SECUENCIA");setText("metric1Label","TIEMPO DE CAPTURA");setText("metric2Label","ESPACIO NECESARIO");setText("metric3Label","EN TU TARJETA");setText("detail1Label","Duración final a 24 fps");setText("detail2Label","Espacio restante");setText("detail3Label","Capacidad total en fotos")}
 setText("mainResult",main);setText("resultSub",sub);setText("metric1",m1);setText("metric2",m2);setText("metric3",m3);setText("metric3Value",m3v);setText("detail1",d1);setText("detail2",d2);setText("detail3",d3);let pct=capMB?Math.max(0,Math.min(100,used/capMB*100)):0;$("usedBar").style.width=pct+"%";setText("usedLabel",`${nf(used/1000,1)} GB ocupados`);setText("freeLabel",`${nf(Math.max(0,capMB-used)/1000,1)} GB libres`);if(show)toast("✓ Plan actualizado")}
function setMode(m){mode=m;root.querySelectorAll(".mode").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));["tarjeta","video","impresion","secuencia"].forEach(x=>$(x+"Fields").classList.toggle("active",x===m));calculate()}
function toast(t){$("toast").textContent=t;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1700)}
root.querySelectorAll(".mode").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));root.querySelectorAll("input,select").forEach(el=>el.addEventListener("input",()=>calculate()));$("calcBtn").onclick=()=>calculate(true);$("resetBtn").onclick=()=>{$("capacity").value=64;$("mp").value=24;$("format").value="1.1";setMode("tarjeta");toast("Datos reiniciados")};$("cameraBtn").onclick=()=>toast("Abriría: Ajustes de cámara");$("searchBtn").onclick=()=>toast("Buscar calculadoras");$("countryBtn").onclick=()=>toast("Región seleccionada");calculate();

})();
</script>
<style is:global>

.mockup-fotografia{--ink:#101827;--muted:#697486;--paper:#f5f6f2;--card:#fff;--cyan:#4fc5c1;--cyan2:#e5f8f6;--coral:#f0785c;--yellow:#ffd461;--navy:#17283f;--line:#dce2df;--green:#32816b}.mockup-fotografia *{box-sizing:border-box}.mockup-fotografia [hidden]{display:none!important}.mockup-fotografia{scroll-behavior:smooth}.mockup-fotografia{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-fotografia button,.mockup-fotografia input,.mockup-fotografia select{font:inherit}.mockup-fotografia .wrap{width:min(1180px,calc(100% - 48px));margin:auto}.mockup-fotografia header{height:82px;background:#fff;border-bottom:1px solid var(--line)}.mockup-fotografia header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-fotografia .brand{display:flex;align-items:center;gap:11px;font-size:19px;font-weight:900}.mockup-fotografia .logo{width:34px;height:34px;border-radius:8px;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:14px}.mockup-fotografia .nav{display:flex;gap:25px;color:#515b69;font-size:14px;font-weight:750}.mockup-fotografia .actions{margin-left:auto;display:flex;gap:9px}.mockup-fotografia .ghost{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px;font-weight:750;cursor:pointer}
.mockup-fotografia .hero{padding:48px 0 67px;background:linear-gradient(128deg,#fff 25%,#e8f8f5)}.mockup-fotografia .crumb{font-size:14px;color:#43847f;margin-bottom:27px}.mockup-fotografia .hero-grid{display:grid;grid-template-columns:1.06fr .94fr;gap:68px;align-items:center}.mockup-fotografia .eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:11px;font-weight:900;color:#34847f}.mockup-fotografia h1{font-size:56px;line-height:1.01;letter-spacing:-.055em;margin:13px 0 18px}.mockup-fotografia .lead{font-size:19px;color:var(--muted);max-width:660px}.mockup-fotografia .stamps{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.mockup-fotografia .stamp{background:#fff;border:1px solid #d4e7e3;border-radius:99px;padding:8px 11px;font-size:11px;font-weight:800;color:#506460}
.mockup-fotografia .photo-stack{height:350px;position:relative}.mockup-fotografia .print{position:absolute;width:290px;height:225px;background:#fff;padding:12px 12px 39px;box-shadow:0 22px 55px #213e3a28}.mockup-fotografia .print.one{left:65px;top:35px;transform:rotate(-7deg)}.mockup-fotografia .print.two{right:10px;top:65px;transform:rotate(8deg)}.mockup-fotografia .scene{height:100%;position:relative;overflow:hidden;background:linear-gradient(#a8dfdf 0 55%,#d7b078 55%)}.mockup-fotografia .sun{position:absolute;right:27px;top:23px;width:44px;height:44px;background:var(--yellow);border-radius:50%}.mockup-fotografia .hill{position:absolute;bottom:44%;left:-15px;border-left:95px solid transparent;border-right:95px solid transparent;border-bottom:110px solid #537f7b}.mockup-fotografia .hill.b{left:100px;border-left-width:120px;border-right-width:120px;border-bottom:140px solid #3c6867}.mockup-fotografia .road{position:absolute;bottom:-20px;left:42%;width:75px;height:150px;background:#d9c9a4;transform:perspective(80px) rotateX(20deg)}.mockup-fotografia .print.two .scene{background:linear-gradient(#1f3452 0 55%,#46636e 55%)}.mockup-fotografia .print.two .hill{border-bottom-color:#293d51}.mockup-fotografia .print.two .hill.b{border-bottom-color:#172b40}.mockup-fotografia .print.two .sun{background:#f4eee0}.mockup-fotografia .caption{position:absolute;bottom:11px;left:15px;font-size:10px;font-weight:850}.mockup-fotografia .storage{position:absolute;left:8px;bottom:5px;background:var(--navy);color:#fff;border-radius:14px;padding:13px 16px;box-shadow:0 15px 30px #1d344452}.mockup-fotografia .storage small{display:block;color:#adc2d2;font-size:9px;font-weight:900;letter-spacing:.1em}.mockup-fotografia .storage b{font-size:20px}.mockup-fotografia .mp{position:absolute;right:2px;top:10px;background:#fff;border-radius:13px;padding:12px 14px;box-shadow:0 13px 30px #20454024}.mockup-fotografia .mp small{display:block;font-size:9px;color:var(--muted);font-weight:900}.mockup-fotografia .mp b{font-size:21px;color:#32938c}
.mockup-fotografia .calculator{margin-top:-28px;position:relative;z-index:3}.mockup-fotografia .shell{display:grid;grid-template-columns:1.05fr .95fr;background:#fff;border:1px solid var(--line);border-radius:24px;box-shadow:0 22px 60px #203b3715;overflow:hidden}.mockup-fotografia .form{padding:31px 33px}.mockup-fotografia .form-head{display:flex;justify-content:space-between;align-items:start;gap:20px}.mockup-fotografia .form h2{font-size:28px;letter-spacing:-.04em;margin:0 0 5px}.mockup-fotografia .form-head p{font-size:13px;color:var(--muted);margin:0}.mockup-fotografia .reset{border:0;background:transparent;color:#328681;font-weight:850;font-size:12px;cursor:pointer}.mockup-fotografia .modes{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:21px 0}.mockup-fotografia .mode{border:1px solid var(--line);background:#f8f9f6;border-radius:12px;padding:11px 9px;text-align:left;cursor:pointer}.mockup-fotografia .mode b{display:block;font-size:12px}.mockup-fotografia .mode small{font-size:9px;color:var(--muted)}.mockup-fotografia .mode.active{background:var(--cyan2);border-color:#55aaa6;box-shadow:inset 0 0 0 1px #55aaa6}.mockup-fotografia .fields{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.mockup-fotografia .field label{display:block;font-size:11px;font-weight:850;margin-bottom:6px}.mockup-fotografia .input{display:flex;border:1px solid #cbd3d0;border-radius:11px;overflow:hidden}.mockup-fotografia .input:focus-within{border-color:#50a8a3;box-shadow:0 0 0 3px #4fc5c11b}.mockup-fotografia .input input,.mockup-fotografia .input select{width:100%;min-width:0;border:0;outline:0;padding:12px;background:transparent;color:var(--ink);font-weight:750}.mockup-fotografia .suffix{padding:12px 10px 12px 0;font-size:11px;color:var(--muted)}.mockup-fotografia .branch{display:none;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:13px;padding:13px;border:1px solid var(--line);border-radius:13px;background:#f7f8f5}.mockup-fotografia .branch.active{display:grid}.mockup-fotografia .calcbtn{width:100%;border:0;border-radius:12px;background:#24857f;color:#fff;padding:14px;margin-top:17px;font-weight:900;cursor:pointer}
.mockup-fotografia .result{background:var(--navy);color:#fff;padding:31px 33px;display:flex;flex-direction:column}.mockup-fotografia .result-label{font-size:10px;letter-spacing:.14em;color:#abc0d2;font-weight:900}.mockup-fotografia .main-result{font-size:49px;line-height:1;letter-spacing:-.05em;margin:9px 0}.mockup-fotografia .result-sub{font-size:12px;color:#cad6e0;min-height:38px}.mockup-fotografia .capacity{margin:23px 0}.mockup-fotografia .capbar{height:14px;background:#2c425d;border-radius:99px;overflow:hidden}.mockup-fotografia .used{display:block;height:100%;width:52%;background:linear-gradient(90deg,var(--coral),var(--yellow));border-radius:99px}.mockup-fotografia .caplabels{display:flex;justify-content:space-between;font-size:9px;color:#9cb0c4;margin-top:7px}.mockup-fotografia .metrics{display:grid;grid-template-columns:1fr 1fr;gap:8px}.mockup-fotografia .metric{background:#233b58;border-radius:13px;padding:12px}.mockup-fotografia .metric small{display:block;color:#aebed0;font-size:9px;font-weight:850}.mockup-fotografia .metric b{font-size:18px}.mockup-fotografia .metric.full{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center}.mockup-fotografia .detail{margin-top:auto;padding-top:18px}.mockup-fotografia .drow{display:flex;justify-content:space-between;gap:18px;padding:9px 0;border-bottom:1px solid #2b435e;font-size:11px}.mockup-fotografia .drow:last-child{border:0}.mockup-fotografia .drow span{color:#b3c3d2}
.mockup-fotografia .cases{padding:70px 0}.mockup-fotografia .section-head{text-align:center;max-width:760px;margin:0 auto 28px}.mockup-fotografia .section-head h2{font-size:40px;letter-spacing:-.045em;margin:9px 0}.mockup-fotografia .section-head p{color:var(--muted);margin:0}.mockup-fotografia .case-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.mockup-fotografia .case{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.mockup-fotografia .case-icon{width:41px;height:41px;border-radius:11px;background:var(--cyan2);display:grid;place-items:center;color:#2d827d;font-weight:900}.mockup-fotografia .case h3{font-size:17px;margin:13px 0 6px}.mockup-fotografia .case p{font-size:11px;color:var(--muted);min-height:48px}.mockup-fotografia .case strong{display:block;font-size:12px;color:#267b76;margin-top:12px}
.mockup-fotografia .formats{background:#ebf0ec;padding:68px 0}.mockup-fotografia .format-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:65px}.mockup-fotografia .formats h2{font-size:40px;line-height:1.08;letter-spacing:-.04em;margin:9px 0}.mockup-fotografia .formats p{color:var(--muted)}.mockup-fotografia .format-list{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden}.mockup-fotografia .frow{display:grid;grid-template-columns:1fr .65fr .65fr;gap:15px;padding:15px 18px;border-bottom:1px solid var(--line);font-size:12px;align-items:center}.mockup-fotografia .frow:last-child{border:0}.mockup-fotografia .frow.head{background:#f7f8f6;color:var(--muted);font-size:9px;font-weight:900;letter-spacing:.08em}.mockup-fotografia .frow b{color:#277d78}.mockup-fotografia .tip{font-size:10px;color:#7b8583;margin-top:11px}.mockup-fotografia .related{padding:65px 0}.mockup-fotografia .related-card{background:linear-gradient(110deg,#262b43,#273f4f);color:#fff;border-radius:22px;padding:30px 34px;display:flex;align-items:center;justify-content:space-between;gap:30px}.mockup-fotografia .related h2{font-size:28px;margin:5px 0}.mockup-fotografia .related p{color:#c6d2dc;margin:0}.mockup-fotografia .related button{border:0;background:var(--yellow);color:#222b36;border-radius:11px;padding:13px 16px;font-weight:900;cursor:pointer;white-space:nowrap}.mockup-fotografia .toast{position:fixed;left:50%;bottom:25px;transform:translate(-50%,20px);background:#111b2b;color:#fff;border-radius:11px;padding:12px 17px;font-size:12px;font-weight:850;opacity:0;transition:.2s;pointer-events:none}.mockup-fotografia .toast.show{opacity:1;transform:translate(-50%,0)}.mockup-fotografia footer{background:#fff;border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:12px}
@media(max-width:900px){.mockup-fotografia .nav{display:none}.mockup-fotografia .hero-grid,.mockup-fotografia .shell,.mockup-fotografia .format-grid{grid-template-columns:1fr}.mockup-fotografia .photo-stack{display:none}.mockup-fotografia .case-grid{grid-template-columns:1fr 1fr}.mockup-fotografia .result{min-height:540px}}@media(max-width:560px){.mockup-fotografia .wrap{width:calc(100% - 30px)}.mockup-fotografia h1{font-size:42px}.mockup-fotografia .hero{padding-top:32px}.mockup-fotografia .modes{grid-template-columns:1fr 1fr}.mockup-fotografia .fields,.mockup-fotografia .branch,.mockup-fotografia .case-grid{grid-template-columns:1fr}.mockup-fotografia .form,.mockup-fotografia .result{padding:24px 20px}.mockup-fotografia .main-result{font-size:41px}.mockup-fotografia .frow{grid-template-columns:1fr 1fr}.mockup-fotografia .frow>*:nth-child(2){display:none}.mockup-fotografia .related-card{display:block}.mockup-fotografia .related button{margin-top:18px}.mockup-fotografia .actions .ghost:first-child{display:none}}

.mockup-fotografia { width:100%; overflow:hidden; }
.mockup-fotografia .top, .mockup-fotografia header.top { display:none !important; }
.mockup-fotografia .foot { display:none !important; }
.mockup-fotografia .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-fotografia .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-fotografia .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-fotografia .support-real summary { cursor:pointer; font-weight:750; }
.mockup-fotografia .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-fotografia :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-fotografia input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-fotografia input[type="number"]::-webkit-inner-spin-button, .mockup-fotografia input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-fotografia .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-fotografia support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
