<div class="mockup-viajes-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Viajes</div><div class="heroGrid"><div><span class="eyebrow">Tu viaje empieza con una cuenta clara</span><h1>Disfrutá el destino. Nosotros hacemos las cuentas.</h1><p class="lead">Presupuesto, millas, equipaje, traslados y horarios. Todo lo que necesitás decidir antes de salir, en un solo lugar.</p><div class="trust"><span>✓ Costos por persona</span><span>✓ Margen para imprevistos</span><span>✓ Herramientas simples</span></div><div class="scene"><i class="sun"></i><i class="mountain"></i><i class="road"></i><i class="plane">✈</i></div></div>
<div class="planner"><div class="plannerHead"><div><h2>¿Cuánto necesitás?</h2><p>Armá una primera estimación del viaje.</p></div><span class="live">PRESUPUESTO EN VIVO</span></div><div class="tripTypes"><button class="tripType active" data-trip="escapada">Escapada</button><button class="tripType" data-trip="vacaciones">Vacaciones</button><button class="tripType" data-trip="internacional">Internacional</button><button class="tripType" data-trip="familiar">En familia</button></div><div class="fields"><div class="field"><label>Personas</label><div class="input"><input id="people" type="number" min="1" value="2"><span>viajeros</span></div></div><div class="field"><label>Noches</label><div class="input"><input id="nights" type="number" min="1" value="7"><span>noches</span></div></div><div class="field"><label>Gasto diario por persona</label><div class="input"><span>$</span><input id="daily" type="number" min="1" value="85000"></div></div><div class="field"><label>Traslado total</label><div class="input"><span>$</span><input id="transport" type="number" min="0" value="450000"></div></div><div class="field"><label>Moneda</label><select id="currency"><option value="ARS">Pesos ARS</option><option value="USD">Dólares USD</option><option value="EUR">Euros EUR</option></select></div><div class="field"><label>Reserva para imprevistos</label><select id="reserve"><option value="1.1">10%</option><option value="1.15" selected>15%</option><option value="1.2">20%</option></select></div></div><button class="primary" id="calculate">Actualizar presupuesto</button><div class="result"><div class="resultTop"><div><small>PRESUPUESTO TOTAL ESTIMADO</small><div class="amount" id="total">$1.886.500</div></div><span class="signal" id="signal">Plan equilibrado</span></div><div class="resultGrid"><div class="metric"><span>POR PERSONA</span><b id="perPerson">$943.250</b></div><div class="metric"><span>BASE DEL VIAJE</span><b id="base">$1.640.000</b></div><div class="metric"><span>RESERVA</span><b id="reserveOut">$246.000</b></div></div><div class="bar"><i id="budgetBar"></i></div><p class="note" id="note">Incluye traslado, gastos diarios y una reserva del 15%.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por tu duda</span><h2>¿Qué necesitás resolver ahora?</h2><p>Elegí un momento del viaje y te mostramos las herramientas indicadas.</p></div><div class="moments"><button class="moment active" data-filter="budget"><span class="icon">$</span><h3>Armar presupuesto</h3><p>Costos, cambio, gastos diarios y reservas.</p><em>→</em></button><button class="moment" data-filter="flight"><span class="icon">✈</span><h3>Antes de volar</h3><p>Aeropuerto, equipaje y tiempos clave.</p><em>→</em></button><button class="moment" data-filter="miles"><span class="icon">M</span><h3>Usar mis millas</h3><p>Cuándo convienen y cuánto valen.</p><em>→</em></button><button class="moment" data-filter="time"><span class="icon">◷</span><h3>Coordinar horarios</h3><p>Husos horarios sin hacer cuentas mentales.</p><em>→</em></button><button class="moment" data-filter="road"><span class="icon"></span><h3>Viajar en auto</h3><p>Nafta, peajes, distancia y consumo.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Caja de herramientas</span><h2>Una cuenta para cada decisión del viaje.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="budget">Presupuesto</button><button class="filter" data-filter="flight">Vuelo</button><button class="filter" data-filter="miles">Millas</button><button class="filter" data-filter="time">Horarios</button><button class="filter" data-filter="road">Ruta</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="budget" data-text="presupuesto viaje gastos moneda cambio diario"><span class="tag">Plan completo</span><h3>Presupuesto de viaje</h3><p>Alojamiento, comida, traslados, actividades e imprevistos, ordenados por persona y por día.</p><button>Armar mi presupuesto →</button></article><article class="card" data-cat="flight" data-text="aeropuerto llegada check in embarque traslado"><span class="tag">Vuelo</span><h3>¿A qué hora salir al aeropuerto?</h3><p>Calculá check-in, viaje, controles y margen.</p><button>Calcular horario →</button></article><article class="card" data-cat="flight" data-text="equipaje valija peso medidas cabina bodega"><span class="tag">Equipaje</span><h3>Equipaje para el viaje</h3><p>Checklist, peso estimado y distribución de valijas.</p><button>Preparar equipaje →</button></article><article class="card" data-cat="miles budget" data-text="millas puntos canje valor vuelo conveniencia"><span class="tag">Millas</span><h3>¿Valen la pena estas millas?</h3><p>Compará el canje con pagar el pasaje.</p><button>Comparar →</button></article><article class="card" data-cat="miles" data-text="millas viaje puntos canje tramos"><span class="tag">Puntos</span><h3>Millas para viajar</h3><p>Estimá cuántas necesitás según el tramo.</p><button>Estimar millas →</button></article><article class="card" data-cat="time" data-text="hora mundial zona horaria diferencia llamada"><span class="tag">Horarios</span><h3>Hora mundial</h3><p>Compará ciudades y encontrá horarios cómodos.</p><button>Comparar ciudades →</button></article><article class="card" data-cat="road budget" data-text="nafta peajes ruta auto combustible costo"><span class="tag">En auto</span><h3>Nafta y peajes</h3><p>Costo total de ruta, por tramo y por persona.</p><button>Calcular ruta →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="mapSection"><div class="wrap mapGrid"><div><span class="eyebrow" style="color:var(--sun)">Planificá en el orden correcto</span><h2>Una buena decisión cambia la siguiente.</h2><p>Primero definí cuánto podés gastar. Después elegí cómo llegar, qué llevar y dónde conviene usar tus millas. Así evitás optimizar una parte y encarecer todo el viaje.</p></div><div class="routes"><button class="route active" data-room="Presupuesto"><span><b>1. Presupuesto y moneda</b><small>Definí el límite total y la reserva.</small></span><b>→</b></button><button class="route" data-room="Traslado"><span><b>2. Traslado y tiempos</b><small>Compará avión, auto y aeropuerto.</small></span><b>→</b></button><button class="route" data-room="Equipaje"><span><b>3. Equipaje y logística</b><small>Llevá lo necesario sin pagar extras.</small></span><b>→</b></button><button class="route" data-room="Millas"><span><b>4. Millas y oportunidades</b><small>Usalas solo cuando el valor cierre.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-viajes-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-viajes-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];const money=(n,c)=>new Intl.NumberFormat("es-AR",{style:"currency",currency:c,maximumFractionDigits:c==="ARS"?0:2}).format(n);
function calc(){const p=Math.max(1,+$("#people").value||1),n=Math.max(1,+$("#nights").value||1),d=Math.max(0,+$("#daily").value||0),t=Math.max(0,+$("#transport").value||0),r=+$("#reserve").value,c=$("#currency").value,base=p*n*d+t,res=base*(r-1),total=base*r;$("#total").textContent=money(total,c);$("#perPerson").textContent=money(total/p,c);$("#base").textContent=money(base,c);$("#reserveOut").textContent=money(res,c);$("#note").textContent=`Incluye traslado, ${n} noches de gastos y una reserva del ${Math.round((r-1)*100)}%.`;const level=d<50000?"Presupuesto ajustado":d>160000?"Plan holgado":"Plan equilibrado";$("#signal").textContent=level;$("#signal").style.background=d<50000?"#a75742":d>160000?"#176b87":"#1d735f";$("#budgetBar").style.width=Math.min(100,Math.max(25,d/2000))+"%"}
$$(".planner input,.planner select").forEach(x=>x.oninput=calc);const presets={escapada:[2,3,70000,180000],vacaciones:[2,7,85000,450000],internacional:[2,12,120,1400,"USD"],familiar:[4,10,70000,600000]};$$(".tripType").forEach(b=>b.onclick=()=>{$$(".tripType").forEach(x=>x.classList.toggle("active",x===b));const v=presets[b.dataset.trip];$("#people").value=v[0];$("#nights").value=v[1];$("#daily").value=v[2];$("#transport").value=v[3];if(v[4])$("#currency").value=v[4];else $("#currency").value="ARS";calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Presupuesto actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".moment").forEach(b=>b.onclick=()=>{$$(".moment").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});
function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".route").forEach(b=>b.onclick=()=>{$$(".route").forEach(x=>x.classList.toggle("active",x===b));toast("Paso seleccionado: "+b.dataset.room)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
