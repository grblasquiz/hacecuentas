---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-edad-gato" set:html={`<section class="hero"><div class="wrap crumb"><b>Mascotas</b> &nbsp;/&nbsp; Edad del gato</div><div class="wrap grid"><div class="copy"><span class="eyebrow">Etapa de vida felina</span><h1>Su edad no se multiplica por siete.</h1><p>Traducí sus años a una etapa real y entendé qué cambia en controles, cuidados y expectativa según cómo vive.</p><div class="chips"><span>✓ Tabla AAHA / AAFP</span><span>✓ Raza y estilo de vida</span><span>✓ Cuidados por etapa</span></div><div class="art"><div class="cat"><div class="tail"></div><div class="ear l"></div><div class="ear r"></div><div class="eye l"></div><div class="eye r"></div><div class="nose"></div><div class="whiskers"></div><div class="chest"></div></div><div class="ageball"><div><b id="art-age">44</b><small>AÑOS HUMANOS</small></div></div><div class="note"><strong id="art-stage">Adulto maduro</strong> · 7 años reales</div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Contanos de tu gato</h2><p class="muted">Con la edad alcanza; el resto mejora la expectativa.</p></div><span class="tag">AAHA / AAFP 2021</span></div><div class="fields"><div class="field"><label>Edad del gato (años)</label><input id="age" value="7"></div><div class="field"><label>Raza</label><select id="breed"><option value="14,18">Mestizo o no la sé</option><option value="15,20">Siamés</option><option value="12,17">Persa</option><option value="12,16">Maine Coon</option><option value="12,17">Ragdoll</option><option value="12,16">Bengalí</option><option value="16,20">Azul ruso</option><option value="12,15">Sphynx</option></select></div><div class="field"><label>¿Sale a la calle?</label><select id="lifestyle"><option value="indoor">No, vive puertas adentro</option><option value="mixed">Salidas controladas</option><option value="outdoor">Entra y sale libremente</option></select></div><div class="field"><label>¿Está castrado?</label><select id="neutered"><option value="yes">Sí</option><option value="no">No</option></select></div></div><section class="result"><div class="result-top"><div><small>EDAD HUMANA EQUIVALENTE</small><div class="value" id="result">44 años</div></div><div class="badge"><small>Etapa actual</small><b id="badge">Adulto maduro</b></div></div><div class="stats"><span>ESPERANZA ESTIMADA<b id="s1">14–18 años</b></span><span>MEDIA POR DELANTE<b id="s2">9 años</b></span><span>PRÓXIMO CONTROL<b id="s3">En 6 meses</b></span></div><button class="go" id="update" type="button">Calculá su edad humana</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Su vida, etapa por etapa</span><h2 id="timeline-title">Está en la etapa adulta madura.</h2><p>El primer año concentra muchísimo desarrollo. Después de los dos, cada año felino suma aproximadamente cuatro años humanos.</p></header><div class="timeline"><div class="bar"><span class="kitten">Gatito</span><span class="junior">Junior</span><span class="young">Adulto joven</span><span class="mature">Maduro</span><span class="senior">Senior</span><span class="geriatric">Geronte</span></div><div class="track"><i class="needle" id="needle"></i></div><div class="timeline-foot"><span>0 años</span><span id="timeline-end">20 años</span></div><div class="stagegrid"><article class="stage" data-stage="Gatito"><b>Gatito</b><span>0–6 meses</span></article><article class="stage" data-stage="Junior"><b>Junior</b><span>6 meses–2 años</span></article><article class="stage" data-stage="Adulto joven"><b>Adulto joven</b><span>2–7 años</span></article><article class="stage active" data-stage="Adulto maduro"><b>Adulto maduro</b><span>7–11 años</span></article><article class="stage" data-stage="Senior"><b>Senior</b><span>11–15 años</span></article><article class="stage" data-stage="Geronte"><b>Geronte</b><span>15 años o más</span></article></div></div></div></section>
<section class="care"><div class="wrap"><header class="center"><span>Qué cambia ahora</span><h2>La edad sirve para anticiparse.</h2></header><div class="caregrid"><article class="card"><h3>En casa</h3><div class="line"><i>⚖</i><div><b>Control de peso</b><span id="home1">Pesalo una vez por mes y registrá cambios.</span></div></div><div class="line"><i>💧</i><div><b>Agua y apetito</b><span>Más sed o pérdida de peso ameritan consulta.</span></div></div><div class="line"><i>🪜</i><div><b>Movilidad</b><span id="home3">Observá si duda antes de saltar.</span></div></div></article><article class="card"><h3>Con el veterinario</h3><div class="line"><i>🩺</i><div><b>Frecuencia</b><span id="vet1">Control clínico cada 6 meses.</span></div></div><div class="line"><i>🔬</i><div><b>Chequeo preventivo</b><span id="vet2">Sangre, orina y presión desde esta etapa.</span></div></div><div class="line"><i>🦷</i><div><b>Salud dental</b><span>Revisión de encías, sarro y dolor oral.</span></div></div></article></div></div></section>
<section class="compare"><div class="wrap"><header class="center"><span>Los factores que más pesan</span><h2>La raza importa. La calle, mucho más.</h2></header><div class="comparegrid"><article class="comparecard"><i>🏠</i><h3>Puertas adentro</h3><strong id="indoor-life">14–18 años</strong><p>Menor exposición a atropellos, peleas, tóxicos y virus.</p></article><article class="comparecard"><i>🌿</i><h3>Salidas controladas</h3><strong id="mixed-life">13–16 años</strong><p>Queda entre el indoor y el acceso libre, según supervisión.</p></article><article class="comparecard"><i>🌙</i><h3>Acceso libre</h3><strong id="outdoor-life">5–7 años</strong><p>El riesgo externo recorta mucho más que la genética.</p></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#9edbcf">La fórmula correcta</span><h2>El primer año vale quince, no siete.</h2><p>El gato madura muy rápido al principio y luego envejece de forma más estable.</p></div><div class="formula">1 año = 15 humanos<span>2 años = 24 humanos</span>Después, +4 por cada año<small>Un gato de 15 equivale aproximadamente a una persona de 76.</small></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-edad-gato')?document.currentScript.previousElementSibling:document.querySelector('.mockup-edad-gato');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),num=id=>Math.max(0,Number($(id).value)||0);function human(a){if(a<=1)return a*15;if(a<=2)return 15+(a-1)*9;return 24+(a-2)*4}function stage(a){return a<.5?"Gatito":a<2?"Junior":a<7?"Adulto joven":a<11?"Adulto maduro":a<15?"Senior":"Geronte"}function range(base,life,neutered){let min=base[0],max=base[1];if(life==="mixed"){min=Math.round(min*.9);max=Math.round(max*.9)}if(life==="outdoor"){min=Math.max(5,Math.round(min*.38));max=Math.max(7,Math.round(max*.42))}if(!neutered){min=Math.max(4,min-2);max=Math.max(6,max-2)}return[min,max]}function txt(id,v){$("#"+id).textContent=v}
function calc(){let age=Math.min(30,num("#age")),base=$("#breed").value.split(",").map(Number),life=$("#lifestyle").value,neutered=$("#neutered").value==="yes",r=range(base,life,neutered),indoor=range(base,"indoor",neutered),mixed=range(base,"mixed",neutered),outdoor=range(base,"outdoor",neutered),h=Math.round(human(age)),st=stage(age),mean=(r[0]+r[1])/2,left=Math.max(0,mean-age),end=Math.max(18,r[1]+2,age+1);txt("result",h+" años");txt("badge",st);txt("s1",r[0]+"–"+r[1]+" años");txt("s2",left?left.toFixed(1).replace(".",",")+" años":"Superó la media");txt("s3",age>=7?"En 6 meses":"En 12 meses");txt("art-age",h);txt("art-stage",st);txt("timeline-title","Está en la etapa "+st.toLowerCase()+".");txt("timeline-end",Math.ceil(end)+" años");$("#needle").style.left=Math.min(99,age/end*100)+"%";$$(".stage").forEach(x=>x.classList.toggle("active",x.dataset.stage===st));txt("indoor-life",indoor[0]+"–"+indoor[1]+" años");txt("mixed-life",mixed[0]+"–"+mixed[1]+" años");txt("outdoor-life",outdoor[0]+"–"+outdoor[1]+" años");txt("vet1",age>=7?"Control clínico cada 6 meses.":"Control clínico al menos una vez al año.");txt("vet2",age>=7?"Sangre, orina y presión desde esta etapa.":"Laboratorio según antecedentes y criterio veterinario.");txt("home1",age>=11?"Pesalo semanalmente: perder peso puede ser una señal temprana.":"Pesalo una vez por mes y registrá cambios.");txt("home3",age>=11?"Sumá escalones, superficies antideslizantes y bandeja baja.":"Observá si duda antes de saltar.")}
$$("input,select").forEach(x=>x.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Edad actualizada";setTimeout(()=>e.currentTarget.textContent="Calculá su edad humana",1200)};calc();

})();
</script>
<style is:global>

