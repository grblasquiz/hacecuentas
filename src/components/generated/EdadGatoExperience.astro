th:129px;height:129px;border-radius:50%;background:#fff;border:12px solid #e3efec;box-shadow:0 15px 32px #1738581c;display:grid;place-items:center;text-align:center}.mockup-edad-gato .ageball b{display:block;font-size:32px}.mockup-edad-gato .ageball small{display:block;font-size:8px;color:#748397}.mockup-edad-gato .note{position:absolute;right:8px;bottom:1px;background:#fff;border:1px solid #dbe5e2;border-radius:12px;padding:11px 14px;font-size:9px;color:#617386;box-shadow:0 14px 28px #17385816}.mockup-edad-gato .note strong{color:#278879}
.mockup-edad-gato .calc{background:#fff;border:1px solid #d8e3e0;border-radius:20px;padding:27px 29px;box-shadow:0 25px 58px #17385817}.mockup-edad-gato .calc-head{display:flex;justify-content:space-between;gap:16px}.mockup-edad-gato .calc h2{font-size:23px;margin:0 0 4px}.mockup-edad-gato .muted{font-size:10px;color:#687b8d;margin:0}.mockup-edad-gato .tag{background:#e6f5f0;color:#278879;border-radius:99px;padding:7px 10px;font-size:8px;font-weight:850;height:max-content}.mockup-edad-gato .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:18px}.mockup-edad-gato .field{border:1px solid #dce5e2;border-radius:10px;padding:10px 11px}.mockup-edad-gato .field label{display:block;font-size:8px;color:#68798b;margin-bottom:5px}.mockup-edad-gato .field input,.mockup-edad-gato .field select{width:100%;border:0;outline:0;background:none;font-size:13px;font-weight:750;color:#17304b}.mockup-edad-gato .result{background:#183653;color:#fff;border-radius:15px;padding:18px 20px;margin-top:12px}.mockup-edad-gato .result-top{display:flex;justify-content:space-between;gap:15px}.mockup-edad-gato .result small{font-size:8px;color:#b9cad6}.mockup-edad-gato .value{font-size:34px;letter-spacing:-.04em;font-weight:900;margin-top:4px}.mockup-edad-gato .badge{background:#e7f5f0;color:#24715f;border-radius:9px;padding:9px 11px;text-align:right;height:max-content}.mockup-edad-gato .badge small{color:#24715f}.mockup-edad-gato .badge b{display:block;font-size:12px;margin-top:3px}.mockup-edad-gato .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #385772;padding-top:12px;margin-top:13px}.mockup-edad-gato .stats span{font-size:7px;color:#b9c9d4}.mockup-edad-gato .stats b{display:block;color:#fff;font-size:10px;margin-top:4px}.mockup-edad-gato .go{width:100%;border:0;border-radius:9px;background:linear-gradient(90deg,#278879,#4eaa96);color:#fff;padding:12px;font-size:11px;font-weight:900;margin-top:14px;cursor:pointer}
