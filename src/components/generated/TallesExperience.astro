---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-talles" set:html={`<section class="hero"><div class="wrap"><div class="crumb">Conversores &nbsp;/&nbsp; Talles</div><div class="hero-grid"><div><div class="eyebrow">Guía de talles y equivalencias</div><h1>Tu talle no es una letra.<br>Es una medida.</h1><p class="lead">Medite una vez y compará el equivalente correcto en Argentina, Europa, Estados Unidos y Reino Unido.</p><div class="chips"><span>✓ 4 tipos de producto</span><span>◎ Equivalencias por país</span><span>↔ Cómo medirte</span></div></div><div class="art"><div class="shirt"></div><div class="tape"></div><div class="sizecard"><small>TU RESULTADO</small><strong id="hero-size">M · AR 42</strong><em>Según tus medidas, no la etiqueta</em></div></div></div></div></section>
<section class="calculator"><div class="wrap"><div class="calc"><div class="calc-head"><div><h2>¿Qué estás por comprar?</h2><p class="muted">Elegí el producto: te pedimos sólo las medidas necesarias.</p></div><span class="badge">Resultado inmediato</span></div><div class="label">Tipo de talle</div><div class="modes"><button class="mode active" data-mode="ropa"><i>◫</i>Ropa y jeans</button><button class="mode" data-mode="calzado"><i>◡</i>Zapatillas</button><button class="mode" data-mode="corpino"><i>♡</i>Corpiño</button><button class="mode" data-mode="anillo"><i>○</i>Anillo</button></div><div class="bodygrid"><div class="inputbox"><div class="field" id="f-genero"><label>Tabla de talles</label><select id="genero"><option value="mujer">Mujer</option><option value="hombre">Hombre</option><option value="nino">Niño/a</option></select></div><div class="field measure" id="f-busto"><label>Contorno de busto o pecho</label><input id="busto" value="92" inputmode="decimal"><span>cm</span></div><div class="field measure" id="f-cintura"><label>Contorno de cintura</label><input id="cintura" value="74" inputmode="decimal"><span>cm</span></div><div class="field measure" id="f-cadera"><label>Contorno de cadera</label><input id="cadera" value="98" inputmode="decimal"><span>cm</span></div><div class="field measure hidden" id="f-pie"><label>Largo del pie</label><input id="pie" value="25" inputmode="decimal"><span>cm</span></div><div class="field hidden" id="f-marca"><label>Marca de la zapatilla</label><select id="marca"><option value="gen">Genérica / otra</option><option value="nike">Nike</option></select></div><div class="field measure hidden" id="f-bajo"><label>Contorno bajo el busto</label><input id="bajo" value="78" inputmode="decimal"><span>cm</span></div><div class="field measure hidden" id="f-dedo"><label>Circunferencia del dedo</label><input id="dedo" value="54" inputmode="decimal"><span>mm</span></div><div class="tip" id="measure-tip">💡 Medí sobre ropa interior, con la cinta paralela al piso y sin apretar.</div></div><div class="result"><small id="result-label">TU TALLE ESTIMADO</small><div class="big" id="result">M · AR 42</div><div class="equiv"><span><small>ARGENTINA</small><b id="ar">42 / M</b></span><span><small>EUROPA</small><b id="eu">40</b></span><span><small>ESTADOS UNIDOS</small><b id="us">8</b></span><span><small>REINO UNIDO</small><b id="uk">12</b></span></div><div class="scale"><div class="scale-top"><span id="scale-a">XS</span><b id="scale-mid">Tu medida: 92 cm</b><span id="scale-b">XXL</span></div><div class="track"><div class="fill" id="fill"></div><div class="pin" id="pin"></div></div><div class="scale-note" id="scale-note">Estás en el centro del rango M. Si caés en un borde, probá ambos talles.</div></div><button class="go" id="update">Actualizar mi talle</button></div></div></div></div></section>
<section class="section"><div class="wrap"><div class="center"><div class="eyebrow">Medirte bien cambia el resultado</div><h2>Del centímetro a una compra más segura</h2><p class="muted">La tabla orienta. La ficha de cada marca sigue siendo la referencia final.</p></div><div class="guide"><article class="card"><h3>Cómo tomar la medida</h3><div class="steps" id="steps"></div></article><article class="card"><h3>Equivalencias cercanas</h3><table class="table"><thead><tr><th>Medida</th><th>AR</th><th>EU</th><th>US</th></tr></thead><tbody id="table"></tbody></table><div class="warning">⚠️ Si dos medidas te dan talles distintos, elegí el mayor. Achicar una prenda es más simple que agrandarla.</div></article></div></div></section>
<section class="darksection"><div class="wrap"><div class="eyebrow">Antes de comprar</div><h2>La etiqueta orienta. El cuerpo decide.</h2><div class="rules"><div class="rule"><i>↔</i><h3>Medí los dos lados</h3><p>En calzado, usá el pie más largo. En anillos, controlá también el nudillo.</p></div><div class="rule"><i>◷</i><h3>Elegí bien el momento</h3><p>Pie y dedos se hinchan durante el día. Medilos por la tarde y en reposo.</p></div><div class="rule"><i>▤</i><h3>Revisá cada marca</h3><p>Dos prendas con la misma letra pueden tener varios centímetros de diferencia.</p></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-talles')?document.currentScript.previousElementSibling:document.querySelector('.mockup-talles');

const $=s=>root.querySelector(s), $$=s=>root.querySelectorAll(s);let mode="ropa";const val=id=>Number($(id).value.replace(",","."))||0, half=x=>Math.round(x*2)/2, show=(id,on)=>$(id).classList.toggle("hidden",!on);
const content={ropa:{tip:"💡 Medí sobre ropa interior, con la cinta paralela al piso y sin apretar.",steps:[["Busto o pecho","Rodeá la parte más ancha, con brazos relajados."],["Cintura","Buscá la zona más angosta del torso."],["Cadera","Medí la parte más ancha y usá el talle mayor."]]},calzado:{tip:"💡 Apoyá el talón contra una pared, marcá el dedo más largo y medí ambos pies.",steps:[["Prepará una hoja","Ponela contra la pared y apoyá el pie descalzo."],["Marcá el largo","Desde el talón hasta el dedo más largo."],["Usá el mayor","Si difieren, comprá según el pie más largo."]]},corpino:{tip:"💡 Medite sin relleno: la banda va ceñida debajo del busto y la copa sin apretar.",steps:[["Bajo busto","Cinta horizontal y firme justo debajo del pecho."],["Contorno de busto","Medí la parte más prominente sin comprimir."],["Calculá la diferencia","Cada 2 cm aproximadamente cambia una copa."]]},anillo:{tip:"💡 Rodeá la base del dedo con papel, marcá el cierre y medí el largo en milímetros.",steps:[["Rodeá el dedo","Usá una tira fina de papel sin apretar."],["Marcá el cierre","Hacé una marca exacta donde se superpone."],["Medí y controlá","Compará la base con el nudillo y usá el mayor."]]}};
function calc(){let r={};if(mode==="ropa"){let b=val("#busto"),c=val("#cintura"),h=val("#cadera"),score=Math.max(b,(c+18),(h-6)),sizes=[["XS",36,34,2,6,84],["S",38,36,4,8,90],["M",42,40,8,12,96],["L",46,44,12,16,104],["XL",48,46,16,20,112],["XXL",50,48,20,24,999]],x=sizes.find(z=>score<=z[5])||sizes.at(-1);r={main:`${x[0]} · AR ${x[1]}`,ar:`${x[1]} / ${x[0]}`,eu:x[2],us:x[3],uk:x[4],mid:`Busto: ${b} cm`,pos:Math.max(4,Math.min(96,(b-78)/40*100)),note:`Tu medida corresponde a ${x[0]}. Si cintura o cadera piden más, manda el talle mayor.`,rows:sizes.slice(Math.max(0,sizes.indexOf(x)-1),sizes.indexOf(x)+2).map(z=>[z[0],z[1],z[2],z[3]])};}if(mode==="calzado"){let p=val("#pie"),g=$("#genero").value,raw=(p+1.5)*1.5,eu=half(raw),us=half(p-(g==="mujer"?16.5:g==="nino"?7:18)),uk=half(us-(g==="mujer"?2:.5)),marca=$("#marca").value,frac=raw-Math.floor(raw),lo=Math.floor(raw),borde=Math.abs(frac-.5)<.3&&lo>=1,note=borde?`Estás justo entre ${lo} y ${lo+1} — pedí los dos o andá al más grande.`:"Para running o medias gruesas, sumá medio talle de holgura.";if(marca==="nike")note+=` Nike suele calzar medio número más chico: para Nike pedí AR/EU ${eu+.5} · US ${us+.5}.`;r={main:`AR/EU ${eu}`,ar:eu,eu,us,uk,mid:`Pie: ${p} cm`,pos:Math.max(3,Math.min(97,(p-15)/20*100)),note,rows:[[p-0.5,half((p+1)*1.5),half((p+1)*1.5),half(us-.5)],[p,eu,eu,us],[p+.5,half((p+2)*1.5),half((p+2)*1.5),half(us+.5)]]};}if(mode==="corpino"){let bajo=val("#bajo"),b=val("#busto"),band=Math.round(bajo/5)*5,d=b-bajo,copas=["AA","A","B","C","D","DD","F","G"],copa=copas[Math.max(0,Math.min(7,Math.round((d-10)/2)))],ar=band+15,us=Math.round(bajo/2.54)+(Math.round(bajo/2.54)%2?5:4);r={main:`${ar}${copa}`,ar:`${ar}${copa}`,eu:`${band}${copa}`,us:`${us}${copa}`,uk:`${us}${copa}`,mid:`Diferencia: ${d} cm`,pos:Math.max(4,Math.min(96,(d-8)/18*100)),note:"Si la banda sube por la espalda, bajá una banda y subí una copa.",rows:[[d-2,`${ar} ${copas[Math.max(0,copas.indexOf(copa)-1)]}`,band,us],[d,`${ar} ${copa}`,band,us],[d+2,`${ar} ${copas[Math.min(7,copas.indexOf(copa)+1)]}`,band,us]]};}if(mode==="anillo"){let d=val("#dedo"),diam=d/Math.PI,us=(d-36.7)/2.55,es=d-40;r={main:`AR ${Math.round(d)}`,ar:Math.round(d),eu:Math.round(d),us:half(us),uk:String.fromCharCode(64+Math.max(1,Math.round(us+5))),mid:`Dedo: ${d} mm`,pos:Math.max(4,Math.min(96,(d-40)/30*100)),note:`Diámetro interior aproximado: ${diam.toFixed(1).replace(".",",")} mm · España ${Math.round(es)}.`,rows:[[d-1,Math.round(d-1),Math.round(d-1),half(us-.5)],[d,Math.round(d),Math.round(d),half(us)],[d+1,Math.round(d+1),Math.round(d+1),half(us+.5)]]};}$("#result").textContent=r.main;$("#hero-size").textContent=r.main;$("#ar").textContent=r.ar;$("#eu").textContent=r.eu;$("#us").textContent=r.us;$("#uk").textContent=r.uk;$("#scale-mid").textContent=r.mid;$("#scale-note").textContent=r.note;$("#fill").style.width=r.pos+"%";$("#pin").style.left=r.pos+"%";$("#table").innerHTML=r.rows.map((z,i)=>`<tr class="${i===1?"active":""}">${z.map(v=>`<td>${v}</td>`).join("")}</tr>`).join("");$("#steps").innerHTML=content[mode].steps.map((s,i)=>`<div class="step"><span class="num">${i+1}</span><div><b>${s[0]}</b><p>${s[1]}</p></div></div>`).join("");$("#measure-tip").textContent=content[mode].tip}
function setMode(m){mode=m;$$(".mode").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));show("#f-genero",m!=="anillo");show("#f-busto",m==="ropa"||m==="corpino");show("#f-cintura",m==="ropa");show("#f-cadera",m==="ropa");show("#f-pie",m==="calzado");show("#f-marca",m==="calzado");show("#f-bajo",m==="corpino");show("#f-dedo",m==="anillo");$("#scale-a").textContent=m==="ropa"?"XS":"Menor";$("#scale-b").textContent=m==="ropa"?"XXL":"Mayor";calc()}
$$(".mode").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(x=>x.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Talle actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar mi talle",1200)};setMode("ropa");

})();
</script>
<style is:global>

.mockup-talles *{box-sizing:border-box}.mockup-talles{margin:0;background:#f7f8f4;color:#14223a;font:15px Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.mockup-talles .wrap{max-width:1180px;margin:auto;padding:0 24px}.mockup-talles header{height:82px;background:#fff;border-bottom:1px solid #e3e8e8;display:flex;align-items:center}.mockup-talles header .wrap{width:100%;display:flex;align-items:center;gap:38px}.mockup-talles .brand{display:flex;align-items:center;gap:10px;font-weight:850;font-size:18px}.mockup-talles .logo{background:#243e59;color:#fff;border-radius:9px;padding:9px 7px;font-size:12px}.mockup-talles nav{display:flex;gap:30px;margin:auto;color:#49566a;font-size:13px;font-weight:700}.mockup-talles .actions{display:flex;gap:9px}.mockup-talles .actions span{padding:12px 15px;background:#fff;border:1px solid #dfe5e8;border-radius:11px;font-weight:700}.mockup-talles .actions .dark{background:#243e59;color:#fff}
.mockup-talles .hero{padding:35px 0 54px;background:linear-gradient(135deg,#f6fbfa 0,#f5f7ff 100%)}.mockup-talles .crumb{color:#56809b;font-size:13px;margin-bottom:25px}.mockup-talles .hero-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:55px;align-items:center}.mockup-talles .eyebrow{color:#2b7b73;font-size:12px;letter-spacing:1.8px;font-weight:900;text-transform:uppercase}.mockup-talles h1{font-size:55px;line-height:1.03;letter-spacing:-2.5px;margin:14px 0 19px}.mockup-talles .lead{font-size:18px;line-height:1.65;color:#59677b;max-width:540px}.mockup-talles .chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.mockup-talles .chips span{background:#fff;border:1px solid #dae5e5;border-radius:9px;padding:9px 12px;font-size:12px;font-weight:700}.mockup-talles .art{height:295px;position:relative}.mockup-talles .shirt{position:absolute;left:75px;top:21px;width:205px;height:230px;background:#6780db;clip-path:polygon(25% 0,41% 11%,59% 11%,75% 0,100% 20%,84% 44%,77% 37%,77% 100%,23% 100%,23% 37%,16% 44%,0 20%);filter:drop-shadow(0 22px 21px #394b8240)}.mockup-talles .shirt:after{content:"M";position:absolute;left:76px;top:102px;color:#fff;font-size:53px;font-weight:900}.mockup-talles .tape{position:absolute;right:25px;top:25px;width:200px;height:200px;border:22px solid #f2b85a;border-radius:50%;box-shadow:0 20px 42px #83632925}.mockup-talles .tape:before{content:"78  •  92  •  104";position:absolute;top:66px;left:-13px;width:180px;transform:rotate(-12deg);font-weight:900;color:#8c5a19;letter-spacing:3px;font-size:11px}.mockup-talles .sizecard{position:absolute;right:15px;bottom:5px;background:#fff;border:1px solid #dbe4e7;border-radius:16px;padding:15px 20px;box-shadow:0 18px 40px #183b5a1d}.mockup-talles .sizecard small{color:#728196}.mockup-talles .sizecard strong{display:block;font-size:21px;margin:5px 0;color:#293d83}.mockup-talles .sizecard em{font-style:normal;color:#16755c;font-size:11px}
.mockup-talles .calculator{margin-top:-18px}.mockup-talles .calc{background:#fff;border:1px solid #dce4e7;border-radius:24px;padding:29px;box-shadow:0 26px 70px #19365114}.mockup-talles .calc-head{display:flex;justify-content:space-between;align-items:start}.mockup-talles .calc h2,.mockup-talles .section h2{font-size:30px;letter-spacing:-1px;margin:0 0 6px}.mockup-talles .muted{color:#6b788a;margin:0}.mockup-talles .badge{background:#e7f6ef;color:#247259;padding:8px 12px;border-radius:99px;font-size:11px;font-weight:850}.mockup-talles .label{font-size:11px;text-transform:uppercase;letter-spacing:1.3px;font-weight:900;color:#607183;margin:25px 0 11px}.mockup-talles .modes{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.mockup-talles .mode{border:1px solid #dce4e8;background:#fff;border-radius:14px;padding:15px 9px;cursor:pointer;color:#39495e;font:700 13px inherit}.mockup-talles .mode i{display:block;font-style:normal;font-size:23px;margin-bottom:6px}.mockup-talles .mode.active{border:2px solid #5485d1;background:#f0f6ff;color:#315c9a;padding:14px 8px}.mockup-talles .bodygrid{display:grid;grid-template-columns:.88fr 1.12fr;gap:18px;margin-top:20px}.mockup-talles .inputbox{background:#f8faf9;border:1px solid #e0e7e7;border-radius:18px;padding:20px}.mockup-talles .field{margin-bottom:14px}.mockup-talles .field.hidden{display:none}.mockup-talles .field label{display:block;font-size:12px;font-weight:800;margin-bottom:7px}.mockup-talles .field select,.mockup-talles .field input{width:100%;border:1px solid #d6dfe2;border-radius:11px;padding:13px 14px;background:#fff;color:#18283d;font:750 15px inherit}.mockup-talles .measure{position:relative}.mockup-talles .measure span{position:absolute;right:13px;top:39px;color:#7b8997;font-weight:700}.mockup-talles .tip{background:#fff5df;border:1px solid #f1dcaa;border-radius:11px;color:#795b20;padding:11px;font-size:11px;line-height:1.45}.mockup-talles .result{background:#243f5d;color:#fff;border-radius:18px;padding:22px}.mockup-talles .result small{color:#b9cadb}.mockup-talles .big{font-size:43px;font-weight:900;margin:7px 0 16px;letter-spacing:-1.5px}.mockup-talles .equiv{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.mockup-talles .equiv span{background:#ffffff10;border:1px solid #ffffff1d;border-radius:11px;padding:10px}.mockup-talles .equiv small{display:block;font-size:9px}.mockup-talles .equiv b{display:block;font-size:18px;margin-top:4px}.mockup-talles .go{width:100%;margin-top:17px;border:0;border-radius:11px;padding:14px;background:linear-gradient(90deg,#64a5d7,#7d73df);color:#fff;font:850 14px inherit;cursor:pointer}.mockup-talles .scale{margin-top:18px}.mockup-talles .scale-top{display:flex;justify-content:space-between;font-size:11px;color:#c2d0dc}.mockup-talles .track{position:relative;height:13px;background:#fff3;border-radius:20px;margin:9px 0}.mockup-talles .fill{height:100%;width:55%;border-radius:20px;background:#f0bd60}.mockup-talles .pin{position:absolute;left:55%;top:-6px;width:3px;height:25px;background:#fff;box-shadow:0 0 0 3px #243f5d}.mockup-talles .scale-note{font-size:10px;color:#c3d1dc}
.mockup-talles .section{padding:70px 0}.mockup-talles .center{text-align:center}.mockup-talles .guide{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px}.mockup-talles .card{background:#fff;border:1px solid #dce5e5;border-radius:20px;padding:24px}.mockup-talles .card h3{font-size:21px;margin:0 0 15px}.mockup-talles .steps{display:grid;gap:14px}.mockup-talles .step{display:grid;grid-template-columns:34px 1fr;gap:11px}.mockup-talles .num{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#edf2ff;color:#4e67c1;font-weight:900}.mockup-talles .step b{display:block;margin-bottom:3px}.mockup-talles .step p{margin:0;color:#68778a;font-size:13px;line-height:1.5}.mockup-talles .table{width:100%;border-collapse:collapse}.mockup-talles .table th,.mockup-talles .table td{text-align:left;padding:11px 8px;border-bottom:1px solid #e5eaeb;font-size:12px}.mockup-talles .table th{color:#768596;font-size:10px;text-transform:uppercase}.mockup-talles .table tr.active td{background:#edf7f3;color:#1f6d58;font-weight:850}.mockup-talles .warning{margin-top:14px;background:#fff4df;color:#745724;padding:12px;border-radius:10px;font-size:11px}.mockup-talles .darksection{background:#172b42;color:#fff;padding:60px 0}.mockup-talles .rules{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-top:28px}.mockup-talles .rule{background:#fff0;border:1px solid #ffffff20;border-radius:17px;padding:20px}.mockup-talles .rule i{font-style:normal;font-size:24px}.mockup-talles .rule h3{margin:11px 0 6px}.mockup-talles .rule p{margin:0;color:#b9c7d5;font-size:13px;line-height:1.55}
@media(max-width:800px){.mockup-talles nav{display:none}.mockup-talles .actions span:not(.dark){display:none}.mockup-talles .hero-grid,.mockup-talles .bodygrid,.mockup-talles .guide{grid-template-columns:1fr}.mockup-talles .hero-grid{gap:15px}.mockup-talles h1{font-size:42px}.mockup-talles .art{transform:scale(.86);transform-origin:left top;height:250px}.mockup-talles .modes{grid-template-columns:1fr 1fr}.mockup-talles .equiv,.mockup-talles .rules{grid-template-columns:1fr 1fr}.mockup-talles .calc{padding:18px}.mockup-talles .wrap{padding:0 16px}}@media(max-width:470px){.mockup-talles .rules{grid-template-columns:1fr}.mockup-talles .art{margin-left:-28px}}

.mockup-talles { width:100%; overflow:hidden; }
.mockup-talles .top, .mockup-talles header.top { display:none !important; }
.mockup-talles .foot { display:none !important; }
.mockup-talles .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-talles .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-talles .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-talles .support-real summary { cursor:pointer; font-weight:750; }
.mockup-talles .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-talles :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-talles input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-talles input[type="number"]::-webkit-inner-spin-button, .mockup-talles input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-talles .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-talles support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
