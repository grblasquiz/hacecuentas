<section class="tint" id="detail"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Dentro do centro</span><h2 id="detailHeading"></h2></div><div class="detail"><article class="detailIntro"><small id="detailLabel"></small><h3 id="detailTitle"></h3><p id="detailCopy"></p><button id="start">Começar esta decisão →</button></article><div class="toolGrid" id="tools"></div></div></div></section>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Calculadoras populares em Portugal</span><h2>Respostas rápidas quando basta um número.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-cat="all">Todas</button><button class="filter" data-cat="work">Trabalho</button><button class="filter" data-cat="finance">Finanças</button><button class="filter" data-cat="home">Casa</button><button class="filter" data-cat="daily">Vida diária</button></div><input class="search" id="toolSearch" placeholder="Pesquisar calculadoras…"></div><div class="cards"><article class="card" data-cat="work" data-text="salário líquido irs segurança social"><i>€</i><h3>Salário líquido</h3><p>IRS, Segurança Social e subsídios.</p><button>Calcular →</button></article><article class="card" data-cat="work" data-text="salário mínimo portugal hora"><i>⏱</i><h3>Salário mínimo por hora</h3><p>Valor mensal, diário e horário.</p><button>Calcular →</button></article><article class="card" data-cat="finance" data-text="juros compostos poupança investimento"><i>↗</i><h3>Juros compostos</h3><p>Capital, reforços mensais e prazo.</p><button>Calcular →</button></article><article class="card" data-cat="home" data-text="crédito habitação prestação casa"><i>⌂</i><h3>Prestação da casa</h3><p>Capital, taxa, prazo e seguros.</p><button>Calcular →</button></article><article class="card" data-cat="home" data-text="imt imposto selo comprar casa"><i>%</i><h3>IMT e Imposto do Selo</h3><p>Custos fiscais da compra do imóvel.</p><button>Calcular →</button></article><article class="card" data-cat="finance" data-text="orçamento mensal despesas poupança"><i>▤</i><h3>Orçamento mensal</h3><p>Receitas, despesas e margem livre.</p><button>Calcular →</button></article><article class="card" data-cat="daily" data-text="dias entre datas úteis"><i>▦</i><h3>Dias entre datas</h3><p>Dias corridos e dias úteis.</p><button>Calcular →</button></article><article class="card" data-cat="daily" data-text="percentagem desconto aumento"><i>%</i><h3>Percentagens</h3><p>Descontos, aumentos e variações.</p><button>Calcular →</button></article><div class="empty" id="empty">Não encontrámos uma calculadora com essa pesquisa.</div></div></div></section>
<section class="tint"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Confiança e metodologia</span><h2>Fórmulas abertas, fontes locais e limites claros.</h2></div><div class="proof"><div><strong>6</strong><span>centros de decisão completos</span></div><div><strong>100%</strong><span>cálculos privados no navegador</span></div><div><strong>2026</strong><span>tabelas e referências atuais</span></div><div><strong>0</strong><span>contas necessárias</span></div><div class="sources" style="grid-column:1/-1"><article class="panel"><h3>Fontes portuguesas</h3><p>As ferramentas locais identificam a regra, a data e o organismo responsável.</p><div class="line"><span>IRS e impostos</span><b>Autoridade Tributária</b></div><div class="line"><span>Trabalho e salário</span><b>Diário da República</b></div></article><article class="panel dark"><h3>Desenhado para decidir</h3><p>Os centros ligam calculadoras relacionadas para comparar cenários e perceber o próximo passo.</p><div class="line"><span>Estrutura</span><b>Problema → opções → ação</b></div><div class="line"><span>Dados pessoais</span><b>Ficam no dispositivo</b></div></article></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-portugal-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-portugal-home');if(!root)return;

const D={money:{rec:"Veja a fotografia completa do seu mês",rc:"Perceba para onde vai o rendimento antes de escolher uma estratégia.",heading:"O meu dinheiro: do orçamento ao objetivo.",title:"Comece pela margem mensal.",copy:"Junte rendimentos, despesas, prestações e poupança para escolher o próximo passo.",tools:[["Orçamento mensal","Receitas, despesas e margem livre."],["Plano para dívidas","Prioridade, juros e data final."],["Fundo de emergência","Meta baseada na estabilidade."],["Objetivo de poupança","Reforço mensal necessário."]]},work:{rec:"Descubra quanto vale realmente o seu trabalho",rc:"Compare salário líquido, subsídios, horário e deslocação.",heading:"O meu trabalho: compare o pacote completo.",title:"O bruto não conta a história toda.",copy:"Coloque IRS, Segurança Social, subsídios e tempo na mesma base.",tools:[["Salário líquido","IRS e Segurança Social."],["Comparar propostas","Salário, benefícios e deslocação."],["Recibos verdes","Líquido e obrigações."],["Horas extraordinárias","Valor por hora e acréscimos."]]},home:{rec:"Saiba que casa cabe no seu orçamento",rc:"Some prestação, impostos, seguros, condomínio e manutenção.",heading:"A minha casa: capacidade antes do compromisso.",title:"Comece pelo custo mensal total.",copy:"Compare compra e arrendamento no mesmo horizonte.",tools:[["Capacidade de compra","Preço possível por rendimento."],["Crédito habitação","Prestação, taxa e prazo."],["IMT e Selo","Impostos de aquisição."],["Comprar ou arrendar","Custo líquido comparado."]]},family:{rec:"Planeie o próximo momento familiar",rc:"Junte calendário, apoios e despesas recorrentes.",heading:"A minha família: tempo, cuidado e orçamento.",title:"Um plano partilhado para uma mudança grande.",copy:"Use intervalos realistas e reveja os apoios aplicáveis.",tools:[["Orçamento do bebé","Custos iniciais e mensais."],["Semanas de gravidez","Datas e trimestres."],["Abono de família","Estimativa por escalão."],["Despesas de cuidados","Comparar alternativas."]]},travel:{rec:"Calcule o custo total antes de reservar",rc:"Voo, bagagem, hotel, transferes e despesas diárias.",heading:"As minhas viagens: custo porta a porta.",title:"A tarifa mais baixa pode não ser a viagem mais barata.",copy:"Compare todos os custos e o tempo no mesmo cenário.",tools:[["Orçamento de viagem","Transporte, estadia e dia a dia."],["Milhas ou dinheiro","Valor real por milha."],["Custo de bagagem","Tarifas e extras."],["Hora mundial","Sobreposição entre fusos."]]},business:{rec:"Encontre o número que guia a decisão",rc:"Ligue preço, IVA, margem, comissões e contratação.",heading:"O meu negócio: preço, equilíbrio e crescimento.",title:"Faturação não é lucro.",copy:"Siga o dinheiro da venda até à margem e ao fluxo de caixa.",tools:[["Margem e markup","Definir um preço sustentável."],["IVA","Adicionar ou retirar imposto."],["Ponto de equilíbrio","Vendas necessárias."],["Custo de contratar","Salário e encargos."]]}},$=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let hub="money";
function render(h,scroll=false){hub=h;const d=D[h];$$("[data-hub]").forEach(x=>x.classList.toggle("active",x.dataset.hub===h));$("#recTitle").textContent=d.rec;$("#recCopy").textContent=d.rc;$("#detailHeading").textContent=d.heading;$("#detailLabel").textContent="CENTRO DE DECISÃO";$("#detailTitle").textContent=d.title;$("#detailCopy").textContent=d.copy;$("#tools").innerHTML=d.tools.map(t=>`<article class="tool"><small>FERRAMENTA RECOMENDADA</small><h4>${t[0]}</h4><p>${t[1]}</p><button data-tool="${t[0]}">Abrir calculadora →</button></article>`).join("");$$("[data-tool]").forEach(b=>b.onclick=()=>toast("A abrir: "+b.dataset.tool));if(scroll)$("#detail").scrollIntoView({behavior:"smooth"})}$$("[data-hub]").forEach(b=>b.onclick=()=>render(b.dataset.hub,b.classList.contains("hub")));$("#recOpen").onclick=()=>render(hub,true);$("#start").onclick=()=>toast("A iniciar o centro de decisão");
function filter(){const cat=$(".filter.active").dataset.cat,q=$("#toolSearch").value.toLowerCase();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat===cat)&&(!q||c.dataset.text.includes(q)||c.textContent.toLowerCase().includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter()});$("#toolSearch").oninput=filter;$$(".card button").forEach(b=>b.onclick=()=>toast("A abrir: "+b.closest(".card").querySelector("h3").textContent));
const items=[...Object.values(D).flatMap(x=>x.tools.map(t=>t[0])),...$$(".card h3").map(x=>x.textContent)];function openSearch(q=""){$("#searchPanel").classList.add("show");$("#globalSearch").value=q;search();$("#globalSearch").focus()}function search(){const q=$("#globalSearch").value.toLowerCase();$("#results").innerHTML=items.filter(x=>!q||x.toLowerCase().includes(q)).slice(0,7).map(x=>`<button data-r="${x}">${x}<br><small>Abrir →</small></button>`).join("")||"<p>Sem resultados. Tente um termo mais geral.</p>";$$("[data-r]").forEach(b=>b.onclick=()=>toast("A abrir: "+b.dataset.r))}$("#heroBtn").onclick=()=>openSearch($("#heroSearch").value);$("#heroSearch").onkeydown=e=>{if(e.key==="Enter")openSearch(e.currentTarget.value)};$("#headerSearch").onclick=()=>openSearch();$("#close").onclick=()=>$("#searchPanel").classList.remove("show");$("#globalSearch").oninput=search;function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1600)}render("money");

})();
</script>
