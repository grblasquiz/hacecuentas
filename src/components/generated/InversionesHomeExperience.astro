<div class="mockup-inversiones-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Inversiones</div><div class="heroGrid"><div><span class="eyebrow">Invertir empieza por entender</span><h1>Tu plata puede crecer. Primero hacé las cuentas.</h1><p class="lead">Simulá escenarios, compará alternativas y entendé riesgo, plazo y rendimiento antes de decidir dónde invertir.</p><div class="trust"><span>✓ Aportes separados</span><span>✓ Inflación visible</span><span>✓ Supuestos editables</span></div><div class="scene"><i class="bars"><i></i><i></i><i></i><i></i></i><i class="trend"></i></div></div>
<div class="sim"><div class="simHead"><div><h2>Proyectá tu inversión</h2><p>Un escenario simple para entender el tiempo.</p></div><span class="live">SIMULACIÓN EN VIVO</span></div><div class="profiles"><button class="profile active" data-profile="conservador">Conservador</button><button class="profile" data-profile="moderado">Moderado</button><button class="profile" data-profile="dinamico">Dinámico</button></div><div class="fields"><div class="field"><label>Capital inicial</label><div class="input"><span>$</span><input id="initial" type="number" min="0" value="1000000"></div></div><div class="field"><label>Aporte mensual</label><div class="input"><span>$</span><input id="monthly" type="number" min="0" value="150000"></div></div><div class="field"><label>Plazo</label><div class="input"><input id="years" type="number" min="1" max="40" value="5"><span>años</span></div></div><div class="field"><label>Rendimiento anual estimado</label><div class="input"><input id="rate" type="number" min="0" step=".1" value="35"><span>%</span></div></div><div class="field"><label>Inflación anual estimada</label><div class="input"><input id="inflation" type="number" min="0" step=".1" value="25"><span>%</span></div></div><div class="field"><label>Moneda de referencia</label><select id="currency"><option value="ARS">Pesos ARS</option><option value="USD">Dólares USD</option><option value="EUR">Euros EUR</option></select></div></div><button class="primary" id="calculate">Actualizar proyección</button><div class="result"><div class="resultTop"><div><small>CAPITAL FINAL ESTIMADO</small><div class="amount" id="final">$23.397.448</div></div><span class="badge" id="profileLabel">Perfil conservador</span></div><div class="resultGrid"><div class="metric"><span>APORTADO</span><b id="contributed">$10.000.000</b></div><div class="metric"><span>RENDIMIENTO</span><b id="earnings">$13.397.448</b></div><div class="metric"><span>VALOR REAL ESTIMADO</span><b id="real">$7.668.604</b></div></div><div class="stack"><i id="capitalBar"></i><i id="earningBar"></i></div><p class="note" id="note">Escenario ilustrativo con capitalización mensual. No incluye impuestos, comisiones ni variaciones del mercado.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por tu objetivo</span><h2>¿Qué querés que haga tu plata?</h2><p>El objetivo y el plazo vienen antes que el instrumento.</p></div><div class="needs"><button class="need active" data-filter="yield"><span class="icon">%</span><h3>Hacer rendir pesos</h3><p>Tasas, plazo fijo y alternativas simples.</p><em>→</em></button><button class="need" data-filter="growth"><span class="icon">↗</span><h3>Crecer a largo plazo</h3><p>Interés compuesto y aportes periódicos.</p><em>→</em></button><button class="need" data-filter="dollar"><span class="icon">US</span><h3>Invertir en dólares</h3><p>CEDEARs y exposición internacional.</p><em>→</em></button><button class="need" data-filter="risk"><span class="icon">◇</span><h3>Entender mi riesgo</h3><p>Concentración, volatilidad y horizonte.</p><em>→</em></button><button class="need" data-filter="compare"><span class="icon">⇄</span><h3>Comparar opciones</h3><p>Mismo plazo, supuestos comparables.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de inversión</span><h2>Compará escenarios, no promesas.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="yield">Rendimiento</button><button class="filter" data-filter="growth">Largo plazo</button><button class="filter" data-filter="dollar">Dólares</button><button class="filter" data-filter="risk">Riesgo</button><button class="filter" data-filter="compare">Comparar</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="growth compare" data-text="interes compuesto inversion aportes rendimiento capital"><span class="tag">Plan a largo plazo</span><h3>Interés compuesto</h3><p>Separá lo aportado de la ganancia y mirá cómo influye el tiempo.</p><button>Simular crecimiento →</button></article><article class="card" data-cat="yield compare" data-text="plazo fijo bancos tasa tradicional uva"><span class="tag">Tasas</span><h3>Plazo fijo</h3><p>Elegí tipo y banco para comparar rendimientos diferentes.</p><button>Comparar bancos →</button></article><article class="card" data-cat="dollar growth" data-text="cedears acciones dolar empresas dividendos"><span class="tag">Mercado</span><h3>CEDEARs</h3><p>Entendé precio, ratio, dólar implícito y rendimiento.</p><button>Explorar CEDEARs →</button></article><article class="card" data-cat="risk compare" data-text="riesgo cartera concentracion diversificacion activos"><span class="tag">Cartera</span><h3>Riesgo de mi cartera</h3><p>Visualizá concentración, diversificación y exposición.</p><button>Analizar cartera →</button></article><article class="card" data-cat="compare yield" data-text="tasa nominal efectiva inflacion rendimiento real"><span class="tag">Conceptos</span><h3>Tasa real y nominal</h3><p>Separá crecimiento nominal de poder de compra.</p><button>Comparar tasas →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="rules"><div class="wrap rulesGrid"><div><span class="eyebrow" style="color:var(--gold)">Antes de elegir un activo</span><h2>Tres preguntas que ordenan todo.</h2><p>Una inversión puede ser buena y aun así no ser adecuada para tu plazo, necesidad de liquidez o tolerancia a las caídas.</p><div class="disclaimer">Contenido educativo y resultados orientativos. No constituye recomendación financiera ni reemplaza asesoramiento profesional.</div></div><div class="ruleList"><button class="rule active" data-rule="Plazo"><span><b>1. ¿Cuándo necesitás la plata?</b><small>El horizonte define cuánto riesgo podés asumir.</small></span><b>→</b></button><button class="rule" data-rule="Liquidez"><span><b>2. ¿Podés tolerar no disponer de ella?</b><small>Revisá rescate, vencimiento y emergencia.</small></span><b>→</b></button><button class="rule" data-rule="Caída"><span><b>3. ¿Qué caída podrías sostener?</b><small>El riesgo real aparece cuando el precio baja.</small></span><b>→</b></button></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-inversiones-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-inversiones-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=(n,c)=>new Intl.NumberFormat("es-AR",{style:"currency",currency:c,maximumFractionDigits:c==="ARS"?0:2}).format(n);let current="conservador";function calc(){const initial=Math.max(0,+$("#initial").value||0),monthly=Math.max(0,+$("#monthly").value||0),years=Math.max(1,+$("#years").value||1),rate=Math.max(0,+$("#rate").value||0)/100,infl=Math.max(0,+$("#inflation").value||0)/100,c=$("#currency").value,months=years*12,mr=Math.pow(1+rate,1/12)-1;let final=initial*Math.pow(1+mr,months);if(mr)final+=monthly*((Math.pow(1+mr,months)-1)/mr);else final+=monthly*months;const contributed=initial+monthly*months,earnings=final-contributed,real=final/Math.pow(1+infl,years),capPct=final?contributed/final*100:100;$("#final").textContent=money(final,c);$("#contributed").textContent=money(contributed,c);$("#earnings").textContent=money(earnings,c);$("#real").textContent=money(real,c);$("#capitalBar").style.width=Math.min(100,capPct)+"%";$("#earningBar").style.width=Math.max(0,100-capPct)+"%";$("#profileLabel").textContent="Perfil "+current;$("#note").textContent=`Escenario ilustrativo a ${years} años con capitalización mensual. No incluye impuestos, comisiones ni variaciones del mercado.`}
$$(".sim input,.sim select").forEach(x=>x.oninput=calc);const profiles={conservador:[1000000,150000,5,35,25],moderado:[1000000,150000,8,48,30],dinamico:[1000000,150000,12,62,35]};$$(".profile").forEach(b=>b.onclick=()=>{current=b.dataset.profile;$$(".profile").forEach(x=>x.classList.toggle("active",x===b));const v=profiles[current],ids=["initial","monthly","years","rate","inflation"];ids.forEach((id,i)=>$("#"+id).value=v[i]);calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Proyección actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".rule").forEach(b=>b.onclick=()=>{$$(".rule").forEach(x=>x.classList.toggle("active",x===b));toast("Criterio seleccionado: "+b.dataset.rule)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
