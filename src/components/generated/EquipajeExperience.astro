---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-equipaje" set:html={`<div class="wrap hero"><div><div class="crumb">Viajes / Equipaje</div><div class="eyebrow">Todo lo necesario, ningún kilo de más</div><h1>Armá la valija con criterio, no con ansiedad.</h1><p class="lead">Planificá la ropa, revisá la franquicia y anticipá sobrepeso antes de llegar al aeropuerto.</p><div class="chips"><span class="chip">✓ Aerolínea y tarifa</span><span class="chip">✓ Lista por días</span><span class="chip">✓ Recargos visibles</span></div></div><div class="visual"><div class="case-visual"><div class="handle"></div><div class="wheel a"></div><div class="wheel b"></div><div class="tag"><small>DESTINO</small><b>MAD</b></div></div><div class="scale-icon"><div><b id="heroWeight">12 kg</b><small>PESO ESTIMADO</small></div></div></div></div>
<div class="wrap"><form class="calc" id="calculator"><div class="case-label">¿QUÉ NECESITÁS RESOLVER?</div><div class="cases"><button type="button" class="case active" data-mode="packing"><span>👕</span>Qué ropa llevar</button><button type="button" class="case" data-mode="allowance"><span>✈</span>Qué incluye mi tarifa</button><button type="button" class="case" data-mode="overweight"><span>⚖</span>Cuánto pago de más</button><button type="button" class="case" data-mode="trek"><span>🎒</span>Mochila de trekking</button></div>
<div class="grid"><div class="panel"><h2 id="formTitle">Armá la ropa del viaje</h2><p class="hint" id="formHint">Ajustamos cantidades por días, clima, lavado y estilo.</p>
<div class="fields active" data-fields="packing"><div class="field"><label for="days">Días de viaje</label><input class="control" id="days" type="number" value="10" min="1"></div><div class="field"><label for="weather">Clima</label><select class="control" id="weather"><option value="warm">Cálido</option><option value="mild" selected>Templado</option><option value="cold">Frío</option><option value="mixed">Mixto</option></select></div><div class="field"><label for="wash">¿Podés lavar ropa?</label><select class="control" id="wash"><option value="yes">Sí</option><option value="no">No</option></select></div><div class="field"><label for="style">Estilo</label><select class="control" id="style"><option value=".8">Mochilero · mínimo</option><option value="1" selected>Casual</option><option value="1.25">Formal o eventos</option></select></div></div>
<div class="fields" data-fields="allowance"><div class="field"><label for="airline">Aerolínea</label><select class="control" id="airline"><option value="ar">Aerolíneas Argentinas</option><option value="latam">LATAM</option><option value="fly">Flybondi</option><option value="smart">JetSMART</option><option value="avianca">Avianca</option><option value="iberia">Iberia</option></select></div><div class="field"><label for="fareType">Tarifa</label><select class="control" id="fareType"><option value="basic">Básica o light</option><option value="standard" selected>Estándar o full</option><option value="premium">Premium Economy</option><option value="business">Business</option></select></div><div class="field"><label for="route">Ruta</label><select class="control" id="route"><option value="domestic">Cabotaje</option><option value="regional">Regional</option><option value="international" selected>Internacional</option></select></div><div class="field"><label for="bagWeight">Peso de tu valija (kg)</label><input class="control" id="bagWeight" type="number" value="20" min="0"></div></div>
<div class="fields" data-fields="overweight"><div class="field"><label for="overAirline">Aerolínea</label><select class="control" id="overAirline"><option value="65">Aerolíneas Argentinas</option><option value="70">LATAM</option><option value="55">Flybondi</option><option value="60">JetSMART</option><option value="75">Iberia</option></select></div><div class="field"><label for="overBag">Peso de la valija (kg)</label><input class="control" id="overBag" type="number" value="27" min="0"></div><div class="field"><label for="included">Franquicia por pieza (kg)</label><select class="control" id="included"><option value="0">No incluye bodega</option><option value="15">15 kg</option><option value="20">20 kg</option><option value="23" selected>23 kg</option></select></div><div class="field"><label for="moment">Cuándo pagás</label><select class="control" id="moment"><option value=".7">Con el pasaje</option><option value=".85">Online después</option><option value="1" selected>En mostrador</option></select></div></div>
<div class="fields" data-fields="trek"><div class="field"><label for="bodyWeight">Tu peso corporal (kg)</label><input class="control" id="bodyWeight" type="number" value="70" min="1"></div><div class="field"><label for="trekDays">Duración</label><select class="control" id="trekDays"><option value="10,15">Salida de un día</option><option value="15,20">2 a 3 días</option><option value="18,25" selected>Una semana</option><option value="20,28">Más de una semana</option></select></div><div class="field full"><label for="trekLevel">Equipo y experiencia</label><select class="control" id="trekLevel"><option value="2">Principiante · equipo pesado</option><option value="0" selected>Intermedio</option><option value="-3">Avanzado · ultraliviano</option></select></div></div>
<button class="update" id="updateButton" type="button">Actualizar equipaje</button></div>
<div class="panel result"><div class="kicker" id="kicker">LISTA RECOMENDADA</div><div class="big" id="resultValue">≈ 8,1 kg</div><div class="sub" id="resultSub">Ropa para 7 días, con un lavado durante el viaje.</div><div class="badge" id="resultBadge">Entra cómodamente en una valija de cabina</div><div class="tiles"><div class="tile"><small id="t1l">Remeras</small><strong id="t1v">6</strong></div><div class="tile"><small id="t2l">Pantalones</small><strong id="t2v">3</strong></div><div class="tile"><small id="t3l">Ropa interior</small><strong id="t3v">7</strong></div></div></div></div></form></div>
<section><div class="wrap"><div class="section-head"><div class="eyebrow">El detalle que evita el “por las dudas”</div><h2 id="listTitle">Tu lista de equipaje, ordenada.</h2><p id="listCopy">Las cantidades se adaptan al viaje y redondean hacia arriba.</p></div><div class="checklist"><div class="packing" id="packRows"></div><aside class="tip"><h3 id="tipTitle">El peso objetivo</h3><div class="number" id="tipValue">8–10 kg</div><p id="tipCopy">Dejá al menos 15% de espacio libre para compras y para no forzar cierres.</p></aside></div></div></section>
<section class="rules"><div class="wrap"><div class="section-head"><div class="eyebrow">Cuatro límites que importan</div><h2>El peso no es la única regla.</h2></div><div class="rule-cards"><article class="rule-card"><i>📐</i><h3>Medidas</h3><p>Cabina suele rondar 55 × 35 × 25 cm; verificá tu aerolínea.</p></article><article class="rule-card"><i>🧴</i><h3>Líquidos</h3><p>Envases de hasta 100 ml dentro de una bolsa transparente.</p></article><article class="rule-card"><i>🔋</i><h3>Baterías</h3><p>Powerbanks y litio suelto van en cabina, nunca despachados.</p></article><article class="rule-card"><i>⚖️</i><h3>32 kg máximo</h3><p>Por encima suele rechazarse la pieza aunque quieras pagar.</p></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><div class="eyebrow">La cuenta detrás del equipaje</div><h2>Planificar pesa menos que improvisar.</h2><div class="formula"><strong id="formula">Ropa = días útiles × clima × estilo</strong><p id="formulaCopy">Si lavás, no hace falta empacar una muda completa por cada día.</p></div></div><div class="checks"><div class="check"><span class="tick">✓</span><span>Franquicia por aerolínea, tarifa y ruta.</span></div><div class="check"><span class="tick">✓</span><span>Sobrepeso y momento de compra diferenciados.</span></div><div class="check"><span class="tick">✓</span><span>Lista de ropa adaptada al clima.</span></div><div class="check"><span class="tick">✓</span><span>Mochila vinculada al peso corporal.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-equipaje')?document.currentScript.previousElementSibling:document.querySelector('.mockup-equipaje');

const $=id=>root.querySelector("#"+id),set=(id,v)=>$(id).textContent=v,fmt=(n,d=1)=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:d}),money=n=>"USD "+Math.round(n).toLocaleString("es-AR");let mode="packing";const cfg={packing:["Armá la ropa del viaje","Ajustamos cantidades por días, clima, lavado y estilo."],allowance:["Revisá qué incluye tu tarifa","Comparamos artículo personal, cabina y bodega."],overweight:["Anticipá el recargo","Pagar antes suele ser mucho más barato que hacerlo en mostrador."],trek:["Dimensioná la mochila","El peso recomendado depende de tu cuerpo, la duración y el equipo."]};function rows(a){$("packRows").innerHTML=a.map(x=>`<div class="pack-row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
function calculate(){if(mode==="packing"){let days=+$("days").value||1,wash=$("wash").value==="yes",usable=wash?Math.min(days,7):Math.min(days,14),style=+$("style").value||1,weather=$("weather").value,shirts=Math.ceil(usable*(weather==="cold"?.55:weather==="warm"?.85:.7)*style),pants=Math.ceil(usable*.32*style),under=Math.ceil(usable*style),socks=Math.ceil(usable*.75),coats=weather==="cold"?2:weather==="mixed"?2:1,kg=shirts*.22+pants*.55+under*.08+socks*.07+coats*1.1+4;set("kicker","LISTA RECOMENDADA");set("resultValue","≈ "+fmt(kg)+" kg");set("resultSub",`Ropa para ${usable} días${wash?", con lavado durante el viaje":", sin lavar"}.`);set("resultBadge",kg<=10?"Entra en una valija de cabina":"Conviene equipaje despachado");set("t1l","Remeras");set("t1v",shirts);set("t2l","Pantalones");set("t2v",pants);set("t3l","Ropa interior");set("t3v",under);set("heroWeight",fmt(kg)+" kg");set("listTitle","Tu lista de equipaje, ordenada.");set("listCopy","Las cantidades se adaptan al viaje y redondean hacia arriba.");set("tipTitle","El peso objetivo");set("tipValue",fmt(kg-1)+"–"+fmt(kg+1)+" kg");set("tipCopy","Dejá al menos 15% de espacio libre para compras.");set("formula","Ropa = días útiles × clima × estilo");set("formulaCopy","Si lavás, no hace falta empacar una muda completa por cada día.");rows([["Remeras o camisas",shirts],["Pantalones",pants],["Ropa interior",under],["Pares de medias",socks],["Abrigos",coats],["Peso total estimado",fmt(kg)+" kg"]])}
if(mode==="allowance"){let air=$("airline").value,fare=$("fareType").value,route=$("route").value,personal=3,carry=fare==="basic"?(["fly","smart"].includes(air)?0:8):fare==="business"?12:10,checked=fare==="basic"?0:fare==="business"?46:fare==="premium"?32:23,total=personal+carry+checked,bag=+$("bagWeight").value||0,ok=checked>0&&bag<=checked;set("kicker","FRANQUICIA INCLUIDA");set("resultValue",total+" kg totales");set("resultSub",`${personal} kg personales + ${carry} kg de cabina + ${checked} kg de bodega.`);set("resultBadge",checked===0?"Esta tarifa no incluye bodega":ok?"Tu valija entra en la franquicia":"Tu valija supera la franquicia");set("t1l","Artículo personal");set("t1v",personal+" kg");set("t2l","Cabina");set("t2v",carry?carry+" kg":"No incluida");set("t3l","Bodega");set("t3v",checked?checked+" kg":"No incluida");set("heroWeight",total+" kg");set("listTitle","Cómo se reparte tu franquicia.");set("listCopy","Cada tipo de equipaje tiene peso, medidas y ubicación propios.");set("tipTitle",ok?"Tu valija está bien":"Revisá antes de volar");set("tipValue",bag+" / "+checked+" kg");set("tipCopy",checked===0?"Comprá bodega online antes del aeropuerto.":ok?"Todavía tenés "+(checked-bag)+" kg disponibles.":"Tenés "+(bag-checked)+" kg de exceso.");set("formula","Total = personal + cabina + bodega");set("formulaCopy","Que el total alcance no permite repartir kilos entre piezas.");rows([["Artículo personal",personal+" kg"],["Equipaje de mano",carry?carry+" kg":"No incluido"],["Equipaje despachado",checked?checked+" kg":"No incluido"],["Tu valija",bag+" kg"],["Total sin pagar extra",total+" kg"]])}
if(mode==="overweight"){let rate=+$("overAirline").value||0,bag=+$("overBag").value||0,included=+$("included").value||0,factor=+$("moment").value||1,excess=Math.max(0,bag-included),rejected=bag>32,cost=included===0?rate*factor:excess*rate*factor;set("kicker",rejected?"BULTO RECHAZADO":"RECARGO ESTIMADO");set("resultValue",rejected?"Más de 32 kg":money(cost));set("resultSub",rejected?"Redistribuí el contenido en dos piezas.":`${fmt(excess)} kg por encima de la franquicia.`);set("resultBadge",rejected?"No se acepta aunque pagues":factor<1?"Ahorrás comprando online":"Tarifa más alta en aeropuerto");$("resultBadge").className="badge"+(rejected?" bad":"");set("t1l","Peso actual");set("t1v",bag+" kg");set("t2l","Incluido");set("t2v",included+" kg");set("t3l","Exceso");set("t3v",excess+" kg");set("heroWeight",bag+" kg");set("listTitle","Qué genera el recargo.");set("listCopy","El momento de compra modifica el precio aunque el peso sea el mismo.");set("tipTitle",rejected?"Dividí la valija":"La opción más barata");set("tipValue",factor<1?"Online":"Antes del aeropuerto");set("tipCopy","El mostrador suele ser el canal más caro y con menos margen para reorganizar.");set("formula","Recargo = exceso × tarifa × momento");set("formulaCopy","Si la tarifa no incluye bodega, se cobra la pieza completa.");rows([["Peso de la valija",bag+" kg"],["Franquicia",included+" kg"],["Exceso",excess+" kg"],["Factor por momento","×"+factor],["Recargo estimado",money(cost)]])}
if(mode==="trek"){let body=+$("bodyWeight").value||1,[ideal,max]=$("trekDays").value.split(",").map(Number),adj=+$("trekLevel").value||0,ip=Math.max(8,ideal+adj),mp=Math.max(10,max+adj),kg=body*ip/100,maxKg=body*mp/100;set("kicker","PESO IDEAL DE MOCHILA");set("resultValue",fmt(kg)+" kg");set("resultSub",`${ip}% de tus ${fmt(body)} kg, con agua y comida incluidas.`);set("resultBadge","No superes "+fmt(maxKg)+" kg");set("t1l","Porcentaje ideal");set("t1v",ip+"%");set("t2l","Máximo");set("t2v",mp+"%");set("t3l","Margen");set("t3v",fmt(maxKg-kg)+" kg");set("heroWeight",fmt(kg)+" kg");set("listTitle","Repartí el peso por función.");set("listCopy","Agua, comida y abrigo deben contemplarse desde el inicio.");set("tipTitle","Zona óptima");set("tipValue",fmt(kg)+"–"+fmt(maxKg)+" kg");set("tipCopy","Más peso aumenta fatiga, riesgo de lesión y tiempo de marcha.");set("formula","Mochila = peso corporal × porcentaje");set("formulaCopy","Duración y experiencia modifican el porcentaje recomendado.");rows([["Tu peso corporal",body+" kg"],["Objetivo",ip+"%"],["Peso ideal",fmt(kg)+" kg"],["Máximo",fmt(maxKg)+" kg"],["Margen disponible",fmt(maxKg-kg)+" kg"]])}}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".fields").forEach(x=>x.classList.toggle("active",x.dataset.fields===mode));set("formTitle",cfg[mode][0]);set("formHint",cfg[mode][1]);$("resultBadge").className="badge";calculate()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calculate));function confirmCalc(){calculate();set("updateButton","✓ Equipaje actualizado");clearTimeout(window.timer);window.timer=setTimeout(()=>set("updateButton","Actualizar equipaje"),5000)}$("updateButton").addEventListener("click",confirmCalc);$("calculator").addEventListener("submit",e=>{e.preventDefault();confirmCalc()});calculate();

})();
</script>
<style is:global>

.mockup-equipaje{--ink:#111b33;--muted:#637085;--line:#dfe4ea;--bg:#f6f6f2;--blue:#286be7;--mint:#35aa98;--amber:#efad45;--coral:#de6c60;--navy:#102746}.mockup-equipaje *{box-sizing:border-box}.mockup-equipaje{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.mockup-equipaje .wrap{width:min(1160px,calc(100% - 40px));margin:auto}.mockup-equipaje header{height:86px;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-equipaje .nav{display:flex;align-items:center;gap:28px}.mockup-equipaje .logo{width:28px;height:35px;border-radius:4px;background:var(--navy);color:#fff;display:grid;place-items:center}.mockup-equipaje .brand{font-size:18px;font-weight:950}.mockup-equipaje .links{display:flex;gap:24px;color:#4e5a6c;font-size:13px;font-weight:800}.mockup-equipaje .tools{margin-left:auto;display:flex;gap:8px}.mockup-equipaje .tool{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px;font-weight:800}
.mockup-equipaje .hero{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center;padding:62px 0 48px}.mockup-equipaje .crumb{color:var(--blue);font-size:14px}.mockup-equipaje .eyebrow{margin-top:18px;color:#187c77;font-size:12px;font-weight:950;letter-spacing:.13em;text-transform:uppercase}.mockup-equipaje h1{font-size:clamp(46px,5.2vw,70px);line-height:.98;letter-spacing:-.055em;margin:11px 0 20px}.mockup-equipaje .lead{font-size:18px;color:var(--muted);max-width:680px}.mockup-equipaje .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-equipaje .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:12px;font-weight:850}
.mockup-equipaje .visual{height:350px;position:relative}.mockup-equipaje .case-visual{position:absolute;left:94px;top:42px;width:255px;height:283px;background:#3478d4;border-radius:54px 54px 30px 30px;box-shadow:0 23px 55px #26374b29}.mockup-equipaje .case-visual:before{content:"";position:absolute;left:75px;right:75px;top:-35px;height:58px;border:12px solid #17314e;border-bottom:0;border-radius:25px 25px 0 0}.mockup-equipaje .case-visual:after{content:"";position:absolute;left:22px;right:22px;top:65px;height:4px;background:#ffffff38;box-shadow:0 70px #ffffff38,0 140px #ffffff38}.mockup-equipaje .wheel{position:absolute;bottom:-18px;width:42px;height:42px;border-radius:50%;background:#17314e;border:10px solid #fff}.mockup-equipaje .wheel.a{left:37px}.mockup-equipaje .wheel.b{right:37px}.mockup-equipaje .handle{position:absolute;left:50%;top:24px;transform:translateX(-50%);width:85px;height:19px;border-radius:9px;background:#17314e}.mockup-equipaje .tag{position:absolute;right:-33px;top:89px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px 16px;transform:rotate(7deg);box-shadow:0 12px 28px #26374b20;z-index:3}.mockup-equipaje .tag:before{content:"";position:absolute;width:45px;border-top:2px solid #8996a7;left:-36px;top:17px}.mockup-equipaje .tag small{display:block;color:#718095;font-size:9px;font-weight:900}.mockup-equipaje .tag b{font-size:22px}.mockup-equipaje .scale-icon{position:absolute;left:6px;bottom:8px;width:142px;height:142px;border-radius:50%;background:#fff;border:13px solid #e9eef2;box-shadow:0 13px 35px #27384c25;display:grid;place-items:center;text-align:center}.mockup-equipaje .scale-icon b{font-size:29px;line-height:1}.mockup-equipaje .scale-icon small{display:block;color:#6d798b;font-size:9px}
.mockup-equipaje .calc{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:68px}.mockup-equipaje .case-label{font-size:12px;font-weight:950;color:#5b6778;margin-bottom:11px}.mockup-equipaje .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:25px}.mockup-equipaje .case{border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:13px 8px;color:#505d70;font-size:12px;font-weight:900;cursor:pointer}.mockup-equipaje .case span{display:block;font-size:18px;margin-bottom:3px}.mockup-equipaje .case.active{background:#eef4ff;color:#1c5fcd;border-color:var(--blue);box-shadow:inset 0 0 0 1px var(--blue)}.mockup-equipaje .grid{display:grid;grid-template-columns:1.03fr .97fr;gap:23px}.mockup-equipaje .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-equipaje .panel h2{font-size:22px;margin:0 0 5px}.mockup-equipaje .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-equipaje .fields{display:none;grid-template-columns:1fr 1fr;gap:14px}.mockup-equipaje .fields.active{display:grid}.mockup-equipaje .field.full{grid-column:1/-1}.mockup-equipaje .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-equipaje .control{width:100%;height:50px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-equipaje .control:focus{border-color:var(--blue);box-shadow:0 0 0 3px #286be718}.mockup-equipaje .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
.mockup-equipaje .result{background:linear-gradient(145deg,#13365f,#0b1e3b);border:0;color:#fff;position:relative;overflow:hidden}.mockup-equipaje .result:after{content:"";position:absolute;width:220px;height:220px;border:45px solid #2ab6aa20;border-radius:50%;right:-125px;bottom:-130px}.mockup-equipaje .kicker{font-size:11px;letter-spacing:.13em;color:#9fe1d6;font-weight:950}.mockup-equipaje .big{font-size:43px;line-height:1.05;font-weight:950;letter-spacing:-.045em;margin:15px 0 7px}.mockup-equipaje .sub{color:#c2d2e4}.mockup-equipaje .badge{display:inline-flex;margin-top:16px;padding:8px 11px;border-radius:99px;background:#1e4777;border:1px solid #416992;font-size:12px;font-weight:850}.mockup-equipaje .badge.bad{background:#74363a;border-color:#a95a58}.mockup-equipaje .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}.mockup-equipaje .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px;position:relative;z-index:1}.mockup-equipaje .tile small{display:block;color:#b6c7db;text-transform:uppercase;font-size:9px;letter-spacing:.07em}.mockup-equipaje .tile strong{display:block;margin-top:5px;font-size:14px}
