---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-mundial-2026" set:html={`
<section class="hero"><div class="wrap"><div class="crumb">Fútbol / Mundial 2026</div><div class="hero-grid"><div><div class="eyebrow">El Mundial que cambió la escala</div><h1>48 selecciones. 104 partidos. Una campeona.</h1><p class="lead">El Mundial 2026 terminó con España levantando la copa. Explorá los cupos, los premios y los récords que dejó el torneo más grande de la historia.</p><div class="chips"><span class="chip">11 JUN — 19 JUL 2026</span><span class="chip">Estados Unidos · México · Canadá</span><span class="chip">✓ Datos finales</span></div></div><div class="champion"><div class="trophy"><span class="stem"></span><span class="base"></span></div><div class="winner"><small>CAMPEÓN 2026</small><strong>🇪🇸 España</strong></div></div></div></div></section>
<nav class="jump"><div class="wrap"><button class="active" data-go="resumen">Resumen</button><button data-go="calculadora">Premios y cupos</button><button data-go="plazas">48 plazas</button><button data-go="records">Récords</button></div></nav>
<section class="summary" id="resumen"><div class="wrap"><div class="headline"><div><div class="eyebrow" style="color:var(--wine)">El torneo en cuatro números</div><h2>Lo esencial, sin buscar en diez lugares.</h2></div><p>El primer Mundial con dieciseisavos sumó una ronda y llevó al campeón de siete a ocho partidos.</p></div><div class="cards"><article class="stat"><small>SELECCIONES</small><strong>48</strong><span>16 más que en Qatar 2022</span></article><article class="stat"><small>PARTIDOS</small><strong>104</strong><span>40 encuentros adicionales</span></article><article class="stat"><small>PREMIO CAMPEÓN</small><strong>USD 50 M</strong><span>Más USD 1,5 M de preparación</span></article><article class="stat"><small>SEDES</small><strong>16</strong><span>En tres países anfitriones</span></article></div></div></section>
<section class="wrap" id="calculadora"><div class="panel"><div class="panel-head"><div><h2 id="panelTitle">Explorá el reparto del Mundial</h2><p id="panelIntro">Elegí confederación y campaña para ver cupos y premios.</p></div><div class="switch"><button class="active" id="worldBtn">Mundial</button><button id="clubBtn">Copas de clubes</button></div></div><div class="panel-body"><div class="form"><div class="fields" id="worldFields"><div class="field full"><label>Confederación</label><select id="conf"><option value="CONMEBOL">CONMEBOL — Sudamérica</option><option value="UEFA">UEFA — Europa</option><option value="CAF">CAF — África</option><option value="AFC">AFC — Asia</option><option value="CONCACAF">CONCACAF — Norte y Centroamérica</option><option value="OFC">OFC — Oceanía</option></select></div><div class="field full"><label>Fase alcanzada</label><select id="fase"><option value="grupos">Fase de grupos</option><option value="dieciseisavos">Dieciseisavos</option><option value="octavos">Octavos</option><option value="cuartos" selected>Cuartos de final</option><option value="cuarto">Cuarto puesto</option><option value="tercero">Tercer puesto</option><option value="subcampeon">Subcampeón</option><option value="campeon">Campeón del mundo</option></select></div><div class="field"><label>Federación</label><select id="fed"><option value=".65">Argentina · 65%</option><option value=".55">España · 55%</option><option value=".50">Brasil · 50%</option><option value=".50">Francia · 50%</option><option value=".45">Otra · 45%</option></select></div><div class="field"><label>Partidos como titular</label><input id="games" type="number" min="0" max="8" value="5"></div></div><div class="fields" id="clubFields" hidden><div class="field full"><label>Copa continental</label><select id="copa"><option value="libertadores">Copa Libertadores</option><option value="sudamericana">Copa Sudamericana</option><option value="champions">UEFA Champions League</option><option value="europa">UEFA Europa League</option></select></div><div class="field"><label>País o ranking</label><select id="pais"><option value="grande">Argentina / Brasil</option><option value="otro">Otro país CONMEBOL</option><option value="top4">Top 4 UEFA</option><option value="quinto">5.º UEFA</option></select></div><div class="field"><label>Posición en la liga</label><input id="posLiga" type="number" min="1" max="25" value="4"></div></div><button class="primary" id="update">Actualizar números</button></div><div class="result"><small id="resultLabel">RESULTADO DE TU SELECCIÓN</small><div class="big" id="mainResult">7 cupos</div><div class="sub" id="resultText">CONMEBOL tuvo 6 plazas directas y una oportunidad de repechaje.</div><span class="pill" id="resultPill">Cuartos · USD 19 millones</span><div class="rows" id="resultRows"></div></div></div></div></section>
<section class="section" id="plazas"><div class="wrap"><div class="section-title"><div class="eyebrow" style="color:var(--wine)">Las 48 plazas</div><h2>Así se repartió el mapa del Mundial.</h2><p>Las confederaciones sumaron 46 cupos directos y dos más salieron del repechaje intercontinental.</p></div><div class="cupos" id="cupos"><div class="cupo"><span class="flag">🇪🇺</span><b>16</b><span>UEFA · Europa</span></div><div class="cupo"><span class="flag">🌍</span><b>9</b><span>CAF · África</span></div><div class="cupo"><span class="flag">🌏</span><b>8</b><span>AFC · Asia</span></div><div class="cupo active"><span class="flag">🌎</span><b>6</b><span>CONMEBOL</span></div><div class="cupo"><span class="flag">🌎</span><b>6</b><span>CONCACAF</span></div><div class="cupo"><span class="flag">🌊</span><b>1</b><span>OFC · Oceanía</span></div></div></div></section>
<section class="records" id="records"><div class="wrap records-grid"><div><div class="eyebrow">Lo que quedó en la historia</div><h2>Récords que sobrevivieron al torneo.</h2><p>El formato cambió, pero algunos nombres y marcas siguen siendo la vara.</p></div><div class="record-list"><article class="record"><small>MÁXIMO GOLEADOR HISTÓRICO</small><strong>Miroslav Klose</strong><span>16 goles · Alemania</span></article><article class="record"><small>MÁS MUNDIALES DISPUTADOS</small><strong>Lionel Messi</strong><span>6 ediciones · 2006–2026</span></article><article class="record"><small>PARTIDOS DEL CAMPEÓN</small><strong>8 encuentros</strong><span>Uno más por los dieciseisavos</span></article><article class="record"><small>MAYOR ESTADIO</small><strong>Estadio Azteca</strong><span>≈83.000 espectadores</span></article></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-mundial-2026')?document.currentScript.previousElementSibling:document.querySelector('.mockup-mundial-2026');

const confs={UEFA:{direct:16,rep:0,name:"UEFA"},CAF:{direct:9,rep:1,name:"CAF"},AFC:{direct:8,rep:1,name:"AFC"},CONMEBOL:{direct:6,rep:1,name:"CONMEBOL"},CONCACAF:{direct:6,rep:2,name:"CONCACAF"},OFC:{direct:1,rep:1,name:"OFC"}};
const phases={grupos:{name:"Fase de grupos",usd:9},dieciseisavos:{name:"Dieciseisavos",usd:11},octavos:{name:"Octavos",usd:15},cuartos:{name:"Cuartos",usd:19},cuarto:{name:"Cuarto puesto",usd:27},tercero:{name:"Tercer puesto",usd:29},subcampeon:{name:"Subcampeón",usd:33},campeon:{name:"Campeón",usd:50}};
const $=x=>root.querySelector("#"+x),money=n=>"USD "+Math.round(n).toLocaleString("es-AR")+" M";let mode="world";
function computeClub(){let copa=$("copa").value,pais=$("pais").value,pos=Math.max(1,+$("posLiga").value||1),cupos=copa==="libertadores"?(pais==="grande"?8:4):copa==="sudamericana"?(pais==="grande"?6:4):copa==="champions"?(pais==="top4"?4:pais==="quinto"?3:2):(pais==="top4"?2:1),fase=pos<=cupos?(copa==="libertadores"&&pos>6?"fase previa":"clasificación directa"):"sin cupo por posición";$("mainResult").textContent=cupos+" cupos";$("resultText").textContent=`El país seleccionado reparte ${cupos} lugares en esta competencia.`;$("resultPill").textContent=pos<=cupos?"Tu club clasifica":"Tu club queda afuera";$("resultRows").innerHTML=`<div class="row"><span>Competencia</span><strong>${$("copa").selectedOptions[0].text}</strong></div><div class="row"><span>Posición cargada</span><strong>${pos}.ª</strong></div><div class="row"><span>Ingreso estimado</span><strong>${fase}</strong></div><div class="row"><span>Cupos del país</span><strong>${cupos}</strong></div>`}
function compute(){if(mode==="club"){computeClub();return}let c=confs[$("conf").value],p=phases[$("fase").value],pct=+$("fed").value,g=Math.max(0,Math.min(8,+$("games").value||0)),total=c.direct+c.rep,plantel=p.usd*pct,perPlayer=plantel*1000000/26+15000+g*7500;$("mainResult").textContent=total+" cupos";$("resultText").textContent=`${c.name} tuvo ${c.direct} plazas directas${c.rep?` y ${c.rep} oportunidad${c.rep>1?"es":""} de repechaje`:" y no disputó repechaje"}.`;$("resultPill").textContent=`${p.name} · ${money(p.usd)}`;$("resultRows").innerHTML=`<div class="row"><span>Plazas directas</span><strong>${c.direct}</strong></div><div class="row"><span>Peso sobre las 48</span><strong>${(c.direct/48*100).toFixed(1).replace(".",",")}%</strong></div><div class="row"><span>Premio + preparación</span><strong>${money(p.usd+1.5)}</strong></div><div class="row"><span>Estimado por jugador</span><strong>USD ${Math.round(perPlayer).toLocaleString("es-AR")}</strong></div>`;root.querySelectorAll(".cupo").forEach((x,i)=>x.classList.toggle("active",["UEFA","CAF","AFC","CONMEBOL","CONCACAF","OFC"][i]===$("conf").value))}
[$("conf"),$("fase"),$("fed"),$("games"),$("copa"),$("pais"),$("posLiga")].forEach(x=>x.addEventListener("input",compute));$("update").onclick=()=>{compute();let b=$("update"),old=b.textContent;b.textContent="✓ Números actualizados";setTimeout(()=>b.textContent=old,1300)};
root.querySelectorAll(".jump button").forEach(b=>b.onclick=()=>{root.querySelectorAll(".jump button").forEach(x=>x.classList.remove("active"));b.classList.add("active");root.querySelector("#"+b.dataset.go).scrollIntoView({behavior:"smooth"})});
function setMode(next){mode=next;$("worldFields").hidden=mode!=="world";$("clubFields").hidden=mode!=="club";$("worldBtn").classList.toggle("active",mode==="world");$("clubBtn").classList.toggle("active",mode==="club");$("panelTitle").textContent=mode==="world"?"Explorá el reparto del Mundial":"¿Tu club entra a la copa?";$("panelIntro").textContent=mode==="world"?"Elegí confederación y campaña para ver cupos y premios.":"Elegí competencia, país y posición final en la liga.";$("resultLabel").textContent=mode==="world"?"RESULTADO DE TU SELECCIÓN":"RESULTADO DE TU CLUB";compute()}$("clubBtn").onclick=()=>setMode("club");$("worldBtn").onclick=()=>setMode("world");compute();

})();
</script>
<style is:global>

.mockup-mundial-2026{--ink:#151324;--muted:#6f6975;--paper:#f7f2ea;--card:#fffdfa;--wine:#7c1735;--wine2:#a82d4c;--gold:#dcad48;--mint:#dcebdc;--line:#e4ddd4;--navy:#182640}
.mockup-mundial-2026 *{box-sizing:border-box}.mockup-mundial-2026 [hidden]{display:none!important}.mockup-mundial-2026{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-mundial-2026 button,.mockup-mundial-2026 select,.mockup-mundial-2026 input{font:inherit}.mockup-mundial-2026 .wrap{max-width:1180px;margin:auto;padding:0 28px}
.mockup-mundial-2026 header{height:84px;background:#fff;border-bottom:1px solid var(--line)}.mockup-mundial-2026 header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-mundial-2026 .brand{display:flex;align-items:center;gap:12px;font-weight:850;font-size:20px}.mockup-mundial-2026 .logo{width:35px;height:35px;border-radius:8px;background:var(--navy);display:grid;place-items:center;color:#fff;font-size:14px}.mockup-mundial-2026 .nav{display:flex;gap:26px;color:#4e5361;font-weight:700;font-size:14px}.mockup-mundial-2026 .actions{margin-left:auto;display:flex;gap:10px}.mockup-mundial-2026 .ghost{border:1px solid var(--line);background:#fff;padding:11px 15px;border-radius:12px;font-weight:750;color:var(--ink)}
.mockup-mundial-2026 .hero{background:linear-gradient(135deg,#59102a,#8d1b3c 58%,#a72948);color:#fff;padding:56px 0 48px;position:relative;overflow:hidden}.mockup-mundial-2026 .hero:after{content:"26";position:absolute;right:-25px;top:-85px;font-size:420px;line-height:1;font-weight:950;color:#ffffff08;letter-spacing:-.1em}.mockup-mundial-2026 .crumb{font-size:14px;color:#f0b8c7;margin-bottom:20px}.mockup-mundial-2026 .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:center}.mockup-mundial-2026 .eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:900;color:#f0c76d}.mockup-mundial-2026 h1{font-size:58px;line-height:1.02;letter-spacing:-.05em;margin:14px 0 18px}.mockup-mundial-2026 .lead{color:#f2dfe5;font-size:19px;max-width:680px}.mockup-mundial-2026 .chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.mockup-mundial-2026 .chip{border:1px solid #ffffff35;background:#ffffff10;border-radius:999px;padding:9px 13px;font-weight:750;font-size:13px}
.mockup-mundial-2026 .champion{min-height:340px;position:relative;display:grid;place-items:center}.mockup-mundial-2026 .trophy{position:relative;width:145px;height:160px;background:linear-gradient(90deg,#bd8229,#f5d780 45%,#d29b38);border-radius:24px 24px 62px 62px;box-shadow:0 25px 65px #27000d80}.mockup-mundial-2026 .trophy:before,.mockup-mundial-2026 .trophy:after{content:"";position:absolute;top:20px;width:68px;height:83px;border:15px solid #d8a846}.mockup-mundial-2026 .trophy:before{right:110px;border-right:0;border-radius:50px 0 0 50px}.mockup-mundial-2026 .trophy:after{left:110px;border-left:0;border-radius:0 50px 50px 0}.mockup-mundial-2026 .stem{position:absolute;width:45px;height:65px;background:#e3b64f;left:50%;bottom:-53px;transform:translateX(-50%)}.mockup-mundial-2026 .base{position:absolute;width:150px;height:28px;background:#d19b3d;border-radius:8px;left:50%;bottom:-67px;transform:translateX(-50%)}.mockup-mundial-2026 .winner{position:absolute;right:0;bottom:2px;background:#fff;color:var(--ink);border-radius:17px;padding:16px 20px;box-shadow:0 15px 35px #32000c66}.mockup-mundial-2026 .winner small{display:block;color:var(--wine);font-weight:900;letter-spacing:.12em;font-size:10px}.mockup-mundial-2026 .winner strong{font-size:27px}
.mockup-mundial-2026 .jump{background:#fff;border-bottom:1px solid var(--line)}.mockup-mundial-2026 .jump .wrap{display:flex;gap:6px;padding-top:12px;padding-bottom:12px;overflow:auto}.mockup-mundial-2026 .jump button{border:0;background:transparent;padding:11px 16px;border-radius:11px;font-weight:800;color:#6c6570;white-space:nowrap;cursor:pointer}.mockup-mundial-2026 .jump button.active{background:#f5e9ec;color:var(--wine)}
.mockup-mundial-2026 .summary{padding:52px 0}.mockup-mundial-2026 .headline{display:flex;align-items:end;justify-content:space-between;margin-bottom:24px}.mockup-mundial-2026 .headline h2{font-size:38px;letter-spacing:-.035em;margin:5px 0}.mockup-mundial-2026 .headline p{color:var(--muted);max-width:520px}.mockup-mundial-2026 .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.mockup-mundial-2026 .stat{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px}.mockup-mundial-2026 .stat small{display:block;color:var(--muted);font-weight:800;font-size:11px;letter-spacing:.08em}.mockup-mundial-2026 .stat strong{display:block;font-size:32px;letter-spacing:-.04em;margin:8px 0 4px}.mockup-mundial-2026 .stat span{font-size:13px;color:var(--muted)}
.mockup-mundial-2026 .panel{background:var(--card);border:1px solid var(--line);border-radius:26px;overflow:hidden;box-shadow:0 20px 55px #3b24180d;margin-bottom:68px}.mockup-mundial-2026 .panel-head{padding:25px 28px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;align-items:center}.mockup-mundial-2026 .panel-head h2{font-size:27px;margin:0}.mockup-mundial-2026 .panel-head p{color:var(--muted);margin:4px 0 0}.mockup-mundial-2026 .switch{display:flex;background:#eee8e1;padding:4px;border-radius:12px}.mockup-mundial-2026 .switch button{border:0;background:transparent;padding:9px 13px;border-radius:9px;font-weight:800;color:#706874;cursor:pointer}.mockup-mundial-2026 .switch button.active{background:#fff;color:var(--wine);box-shadow:0 2px 8px #30190b18}
.mockup-mundial-2026 .panel-body{display:grid;grid-template-columns:.95fr 1.05fr}.mockup-mundial-2026 .form{padding:30px}.mockup-mundial-2026 .fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.mockup-mundial-2026 .field{display:flex;flex-direction:column;gap:7px}.mockup-mundial-2026 .field.full{grid-column:1/-1}.mockup-mundial-2026 .field label{font-size:13px;font-weight:800}.mockup-mundial-2026 .field select,.mockup-mundial-2026 .field input{border:1px solid #d5cec6;border-radius:12px;padding:14px;background:#fff;color:var(--ink);outline:none}.mockup-mundial-2026 .field select:focus,.mockup-mundial-2026 .field input:focus{border-color:var(--wine2);box-shadow:0 0 0 3px #a82d4c1a}.mockup-mundial-2026 .primary{width:100%;margin-top:21px;border:0;background:var(--wine);color:#fff;font-weight:850;padding:15px;border-radius:13px;cursor:pointer}
.mockup-mundial-2026 .result{padding:30px;background:var(--navy);color:#fff;position:relative;overflow:hidden}.mockup-mundial-2026 .result:after{content:"";position:absolute;width:250px;height:250px;border-radius:50%;border:48px solid #ffffff08;right:-145px;bottom:-145px}.mockup-mundial-2026 .result small{color:#bad2d1;letter-spacing:.12em;font-weight:900;font-size:10px}.mockup-mundial-2026 .big{font-size:47px;font-weight:930;letter-spacing:-.05em;margin:12px 0 6px}.mockup-mundial-2026 .sub{color:#d6dfeb;min-height:48px}.mockup-mundial-2026 .pill{display:inline-block;background:#e7c15c;color:#3d2b05;padding:8px 12px;border-radius:99px;font-weight:900;font-size:13px;margin:12px 0 22px}.mockup-mundial-2026 .rows{border-top:1px solid #ffffff24}.mockup-mundial-2026 .row{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid #ffffff1a;color:#d7dfeb}.mockup-mundial-2026 .row strong{color:#fff}
.mockup-mundial-2026 .section{padding:15px 0 70px}.mockup-mundial-2026 .section-title{text-align:center;max-width:720px;margin:0 auto 30px}.mockup-mundial-2026 .section-title h2{font-size:39px;letter-spacing:-.04em;margin:8px 0}.mockup-mundial-2026 .section-title p{color:var(--muted)}
.mockup-mundial-2026 .cupos{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.mockup-mundial-2026 .cupo{background:#fff;border:1px solid var(--line);border-radius:17px;padding:18px;text-align:center}.mockup-mundial-2026 .flag{font-size:24px}.mockup-mundial-2026 .cupo b{font-size:27px;display:block;margin-top:8px}.mockup-mundial-2026 .cupo span{font-size:12px;color:var(--muted)}.mockup-mundial-2026 .cupo.active{border:2px solid var(--wine);padding:17px;background:#fcf2f4}
.mockup-mundial-2026 .records{background:#151b2b;color:#fff;padding:68px 0}.mockup-mundial-2026 .records-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:65px}.mockup-mundial-2026 .records h2{font-size:41px;line-height:1.08;margin:10px 0}.mockup-mundial-2026 .records p{color:#adb8c9}.mockup-mundial-2026 .record-list{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-mundial-2026 .record{background:#ffffff0b;border:1px solid #ffffff18;border-radius:16px;padding:19px}.mockup-mundial-2026 .record small{color:#aeb9c9}.mockup-mundial-2026 .record strong{display:block;font-size:23px;margin:6px 0}.mockup-mundial-2026 .record span{font-size:13px;color:#c5ccda}
.mockup-mundial-2026 footer{background:#fff;border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:13px}
@media(max-width:850px){.mockup-mundial-2026 .nav{display:none}.mockup-mundial-2026 .hero-grid,.mockup-mundial-2026 .panel-body,.mockup-mundial-2026 .records-grid{grid-template-columns:1fr}.mockup-mundial-2026 .champion{min-height:290px}.mockup-mundial-2026 .cards{grid-template-columns:1fr 1fr}.mockup-mundial-2026 .cupos{grid-template-columns:repeat(3,1fr)}.mockup-mundial-2026 h1{font-size:44px}}@media(max-width:540px){.mockup-mundial-2026 .wrap{padding:0 18px}.mockup-mundial-2026 .hero{padding-top:36px}.mockup-mundial-2026 .champion{display:none}.mockup-mundial-2026 .headline{display:block}.mockup-mundial-2026 .cards,.mockup-mundial-2026 .fields,.mockup-mundial-2026 .record-list{grid-template-columns:1fr}.mockup-mundial-2026 .field.full{grid-column:auto}.mockup-mundial-2026 .cupos{grid-template-columns:1fr 1fr}.mockup-mundial-2026 .switch{display:none}.mockup-mundial-2026 h1{font-size:40px}.mockup-mundial-2026 .panel-head{padding:22px 20px}.mockup-mundial-2026 .form,.mockup-mundial-2026 .result{padding:25px 20px}}

.mockup-mundial-2026 { width:100%; overflow:hidden; }
.mockup-mundial-2026 .top, .mockup-mundial-2026 header.top { display:none !important; }
.mockup-mundial-2026 .foot { display:none !important; }
.mockup-mundial-2026 .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-mundial-2026 .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-mundial-2026 .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-mundial-2026 .support-real summary { cursor:pointer; font-weight:750; }
.mockup-mundial-2026 .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-mundial-2026 :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-mundial-2026 input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-mundial-2026 input[type="number"]::-webkit-inner-spin-button, .mockup-mundial-2026 input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-mundial-2026 .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-mundial-2026 support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
