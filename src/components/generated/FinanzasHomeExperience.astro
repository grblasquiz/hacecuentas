<div class="mockup-finanzas-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Finanzas personales</div><div class="heroGrid"><div><span class="eyebrow">Tu plata, en una sola imagen</span><h1>Que el mes no te pase por encima.</h1><p class="lead">Entendé adónde va tu ingreso, ordená deudas y convertí lo que sobra en objetivos concretos. Sin planillas complicadas ni consejos genéricos.</p><div class="trust"><span>✓ Todo queda en tu dispositivo</span><span>✓ Escenarios comparables</span><span>✓ Paso a paso</span></div><div class="visual"><i class="barV"><span>Gastos</span></i><i class="barV"><span>Deuda</span></i><i class="barV"><span>Ahorro</span></i><i class="barV"><span>Meta</span></i><div class="visualCopy"><strong>Primero la foto.</strong><small>Después, el plan.</small></div></div></div>
<div class="calc"><div class="calcHead"><div><h2>Tu foto financiera del mes</h2><p>Cargá cuatro números para empezar.</p></div><span class="live">EN VIVO</span></div><div class="fields"><div class="field wide"><label>Ingresos netos del hogar</label><div class="input"><b>$</b><input id="income" value="2500000"></div></div><div class="field"><label>Gastos fijos</label><div class="input"><b>$</b><input id="fixed" value="1250000"></div></div><div class="field"><label>Gastos variables</label><div class="input"><b>$</b><input id="variable" value="550000"></div></div><div class="field"><label>Cuotas de deudas</label><div class="input"><b>$</b><input id="debt" value="250000"></div></div><div class="field"><label>Ahorro mensual actual</label><div class="input"><b>$</b><input id="saving" value="200000"></div></div></div><button class="primary" id="calculate">Actualizar mi foto</button><div class="result"><div class="resultTop"><div><small>CAPACIDAD LIBRE DEL MES</small><div class="amount" id="free">$450.000</div></div><span class="health" id="health">Margen saludable</span></div><div class="progress"><i id="expenseBar"></i><i id="debtBar"></i><i id="freeBar"></i></div><div class="resultGrid"><div class="metric"><span>GASTOS / INGRESOS</span><b id="expenseRatio">72%</b></div><div class="metric"><span>DEUDA / INGRESOS</span><b id="debtRatio">10%</b></div><div class="metric"><span>AHORRO POTENCIAL</span><b id="savingRatio">18%</b></div></div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Elegí tu prioridad</span><h2>¿Qué querés mejorar primero?</h2><p>No hace falta resolver todo junto. Empezá por el problema que más presión genera hoy.</p></div><div class="goals"><button class="goal active" data-filter="ordenar"><span class="icon">▤</span><h3>Quiero ordenar mis gastos</h3><p>Presupuesto, categorías y cierre del mes.</p><em>→</em></button><button class="goal" data-filter="deudas"><span class="icon">↓</span><h3>Quiero salir de deudas</h3><p>Priorización, cuotas y fecha de salida.</p><em>→</em></button><button class="goal" data-filter="credito"><span class="icon">%</span><h3>Necesito financiarme</h3><p>Préstamos, cuotas y costo financiero real.</p><em>→</em></button><button class="goal" data-filter="ahorro"><span class="icon">↗</span><h3>Quiero ahorrar e invertir</h3><p>Metas, dólar, interés y crecimiento.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas personales</span><h2>Una calculadora para cada decisión.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="ordenar">Presupuesto</button><button class="filter" data-filter="deudas">Deudas</button><button class="filter" data-filter="credito">Crédito</button><button class="filter" data-filter="ahorro">Ahorro</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="ordenar" data-text="gastos del mes presupuesto ingresos categorías"><span class="tag">Punto de partida</span><h3>Gastos del mes</h3><p>Registrá, agrupá y compará gastos contra tu ingreso para saber cuánto margen real te queda.</p><button>Ordenar mi mes →</button></article><article class="card" data-cat="deudas" data-text="salir de deudas bola nieve avalancha cuotas"><span class="tag">Plan personal</span><h3>Salir de deudas</h3><p>Compará bola de nieve y avalancha con una fecha concreta de salida.</p><button>Armar mi plan →</button></article><article class="card" data-cat="credito" data-text="préstamo cuota tasa cft interés"><span class="tag">Financiación</span><h3>Préstamo personal</h3><p>Cuota, intereses y costo total para comparar ofertas de verdad.</p><button>Comparar préstamo →</button></article><article class="card" data-cat="ahorro" data-text="dólar pesos ahorro cotización poder compra"><span class="tag">Moneda</span><h3>Dólar y poder de compra</h3><p>Convertí escenarios y entendé cuánto necesitás para una meta dolarizada.</p><button>Calcular →</button></article><article class="card" data-cat="ahorro" data-text="interés compuesto inversión capital plazo tasa"><span class="tag">Crecimiento</span><h3>Interés compuesto</h3><p>Proyectá capital inicial, aportes mensuales y distintos plazos.</p><button>Proyectar ahorro →</button></article><article class="card" data-cat="ordenar credito" data-text="tarjeta crédito resumen cuotas pago mínimo"><span class="tag">Tarjeta</span><h3>Costo de financiar la tarjeta</h3><p>Entendé el efecto del pago mínimo y de refinanciar el saldo.</p><button>Ver costo →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap"><div class="split"><article class="panel"><h3>Una secuencia simple</h3><p>El orden ayuda a no mezclar urgencias con objetivos.</p><div class="line"><span>1 · Cubrir gastos esenciales</span><b>Primero</b></div><div class="line"><span>2 · Frenar deuda cara</span><b>Después</b></div><div class="line"><span>3 · Crear fondo de emergencia</span><b>3–6 meses</b></div><div class="line"><span>4 · Ahorrar e invertir</span><b>A largo plazo</b></div></article><article class="panel dark"><h3>Tu indicador más útil</h3><p>La capacidad libre es lo que queda después de gastos y cuotas. Si es negativa, el primer objetivo es recuperar margen; si es positiva, podés repartirla entre colchón, metas e inversión.</p><div class="line"><span>Margen ajustado</span><b>Menos de 10%</b></div><div class="line"><span>Margen razonable</span><b>10–20%</b></div><div class="line"><span>Margen amplio</span><b>Más de 20%</b></div></article></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-finanzas-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-finanzas-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],num=id=>Math.max(0,Number($(id).value.replaceAll(".","").replaceAll(",",""))||0),money=n=>(n<0?"− ":"")+"$"+Math.abs(Math.round(n)).toLocaleString("es-AR");
function calc(){const income=num("#income"),fixed=num("#fixed"),variable=num("#variable"),debt=num("#debt"),saving=num("#saving"),expenses=fixed+variable,free=income-expenses-debt,ep=income?expenses/income*100:0,dp=income?debt/income*100:0,fp=income?Math.max(0,free)/income*100:0;$("#free").textContent=money(free);$("#expenseRatio").textContent=Math.round(ep)+"%";$("#debtRatio").textContent=Math.round(dp)+"%";$("#savingRatio").textContent=Math.round(fp)+"%";$("#expenseBar").style.width=Math.min(100,ep)+"%";$("#debtBar").style.width=Math.min(100-ep,dp)+"%";$("#freeBar").style.width=Math.max(0,100-ep-dp)+"%";const h=$("#health");h.textContent=free<0?"Mes en déficit":fp<10?"Margen ajustado":fp<20?"Margen razonable":"Margen saludable";h.style.background=free<0?"#713d3c":fp<10?"#705a28":"#2b6655"}
$$(".calc input").forEach(x=>x.oninput=calc);$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Foto actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".goal").forEach(b=>b.onclick=()=>{$$(".goal").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent="Abriendo: "+t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1600)}$$(".card button").forEach(b=>b.onclick=()=>toast(b.closest(".card").querySelector("h3").textContent));calc();

})();
</script>
