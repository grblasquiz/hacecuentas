---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-empleada-domestica" set:html={`<section class="hero"><div class="wrap crumb"><b>Trabajo</b> &nbsp;/&nbsp; Empleada doméstica</div><div class="wrap grid"><div class="copy"><span class="eyebrow">Casas particulares, sin dudas</span><h1>Sabé cuánto cobra ella y cuánto te cuesta a vos.</h1><p>Calculá sueldo por hora o mensual, aportes a ARCA, ART y las provisiones de aguinaldo y vacaciones según la escala vigente.</p><div class="chips"><span>✓ Escala CNTCP</span><span>✓ Aportes por tramo</span><span>✓ Costo mensual completo</span></div><div class="art"><div class="house"><i class="window one"></i><i class="window two"></i></div><div class="float"><small>COSTO TOTAL DEL MES</small><b id="art-value">$220.630</b><span id="art-copy">12 hs por semana · sin retiro</span></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá el costo mensual</h2><p class="muted">Elegí cómo está contratada.</p></div><span class="tag">Escala 2026</span></div><div class="label">Modalidad de trabajo</div><div class="cases"><button type="button" class="case active" data-mode="hour-out"><i>◷</i>Por hora · sin retiro</button><button type="button" class="case" data-mode="hour-in"><i>⌂</i>Por hora · con retiro</button><button type="button" class="case" data-mode="monthly"><i>$</i>Sueldo mensual</button><button type="button" class="case" data-mode="contrib"><i>▤</i>Sólo aportes</button></div><div class="label">Datos del trabajo</div><div class="fields"><div class="field"><label>Categoría CNTCP</label><select id="category"><option value="3862.18|3600.66">Tareas generales</option><option value="4295.26|3862.18">Cuidado de personas</option><option value="4597.18|4223.25">Tareas específicas / cocina</option><option value="3996.45|3996.45">Caseros</option><option value="4683.64|4297.33">Supervisor/a</option></select></div><div class="field"><label>Horas por semana</label><input id="hours" value="12"></div><div class="field" id="salary-field"><label>Sueldo mensual pactado</label><input id="salary-fixed" value="850000"></div><div class="field"><label>Años de antigüedad</label><input id="seniority" value="2"></div><div class="field"><label>Cuota mensual de ART</label><input id="art" value="3500"></div><div class="field"><label>Zona desfavorable</label><select id="zone"><option value="1">No corresponde</option><option value="1.3">Patagonia · +30%</option></select></div></div><section class="result"><div class="result-top"><div><small id="result-label">COSTO TOTAL DEL MES</small><div class="value" id="result">$220.630</div></div><div class="badge"><small id="badge-label">Ella cobra</small><b id="badge">$200.697</b></div></div><div class="stats"><span id="s1l">ARCA + ART<b id="s1">$6.600</b></span><span id="s2l">PROVISIÓN SAC<b id="s2">$16.725</b></span><span id="s3l">PROVISIÓN VACACIONES<b id="s3">$9.365</b></span></div><button class="go" id="update" type="button">Actualizar cálculo</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span>El costo completo</span><h2>Lo que cobra ella vs. lo que pagás vos</h2><p>Además del sueldo, conviene separar cada mes aportes, ART, aguinaldo y vacaciones.</p></header><div class="stack"><div class="bar"><i class="salary" id="bar-salary" style="width:84%">Sueldo</i><i class="arca" id="bar-arca" style="width:5%">ARCA</i><i class="artc" id="bar-art" style="width:3%">ART</i><i class="provision" id="bar-prov" style="width:8%">Provisiones</i></div><div class="legend"><span>SUELDO DE BOLSILLO<b id="leg-salary">$200.697</b></span><span>APORTES ARCA<b id="leg-arca">$3.100</b></span><span>ART<b id="leg-art">$3.500</b></span><span>SAC + VACACIONES<b id="leg-prov">$26.090</b></span></div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3>Cómo se arma el mes</h3><div class="line"><span id="d1l">Valor hora de escala</span><b id="d1">$3.862,18</b></div><div class="line"><span id="d2l">Horas mensuales estimadas</span><b id="d2">52 horas</b></div><div class="line"><span id="d3l">Sueldo de bolsillo</span><b id="d3">$200.697</b></div><div class="line"><span id="d4l">Cargas y provisiones</span><b id="d4">$26.690</b></div><div class="line total"><strong id="d5l">Costo total</strong><b id="d5">$227.387</b></div></article><article class="card"><h3>Antes de pagar</h3><div class="rule"><i>1</i><div><b>Confirmá la categoría real</b><span>La tarea que efectivamente realiza define la escala.</span></div></div><div class="rule"><i>2</i><div><b>Revisá el tramo de horas</b><span>Los aportes cambian en 12 y 16 horas semanales.</span></div></div><div class="rule"><i>3</i><div><b>Guardá la provisión mensual</b><span>Así aguinaldo y vacaciones no aparecen como sorpresa.</span></div></div><div class="warning">La escala CNTCP y los importes de aportes pueden cambiar durante el año. Verificá la vigencia antes de liquidar.</div></article></div></section>
<section class="guide"><div class="wrap"><header class="center"><span>Cuatro obligaciones separadas</span><h2>Qué corresponde pagar</h2></header><div class="guidegrid"><article class="guidecard"><i>$</i><h3>Sueldo</h3><p>Nunca puede quedar por debajo de la escala CNTCP.</p><em>Hasta el 4º día hábil</em></article><article class="guidecard"><i>▤</i><h3>Aportes y ART</h3><p>Se registran y pagan mensualmente en ARCA.</p><em>Obligatorio desde 1 hora</em></article><article class="guidecard"><i>½</i><h3>Aguinaldo</h3><p>50% del mejor sueldo del semestre, proporcional.</p><em>Junio y diciembre</em></article><article class="guidecard"><i>☼</i><h3>Vacaciones</h3><p>De 14 a 35 días según antigüedad, con divisor 25.</p><em>Descanso pago</em></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#efbf98">Registrar protege a las dos partes</span><h2>El valor hora es sólo el comienzo de la cuenta.</h2><p>La registración suma cobertura de ART, obra social, jubilación y comprobantes claros para empleadora y trabajadora.</p></div><div class="facts"><div><small>JORNADA MÁXIMA</small><b>48 hs semanales</b><span>8 horas diarias</span></div><div><small>VACACIONES</small><b id="dark-days">14 días</b><span>Según antigüedad</span></div><div><small>APORTES</small><b id="dark-band">12 a 16 hs</b><span>Tramo ARCA</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-empleada-domestica')?document.currentScript.previousElementSibling:document.querySelector('.mockup-empleada-domestica');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),num=id=>Math.max(0,Number($(id).value)||0),ars=x=>"$"+Math.round(x).toLocaleString("es-AR");let mode="hour-out";function setStat(names,vals){["s1l","s2l","s3l"].forEach((id,i)=>$("#"+id).childNodes[0].nodeValue=names[i]);["s1","s2","s3"].forEach((id,i)=>$("#"+id).textContent=vals[i])}function calc(){let [outv,inv]=$("#category").value.split("|").map(Number),hours=Math.min(48,num("#hours")),sen=num("#seniority"),art=num("#art"),zone=num("#zone"),hourRate=(mode==="hour-in"?inv:outv)*zone,piso=hourRate*hours*4.33,fixed=num("#salary-fixed"),salary=mode==="monthly"?Math.max(fixed,piso):piso,arca=hours<12?1900:hours<16?3100:4500,days=sen<5?14:sen<10?21:sen<20?28:35,sac=salary/12,vac=salary/25*days/12,charges=arca+art+sac+vac,total=salary+charges,only=mode==="contrib";$("#result-label").textContent=only?"ARCA + ART POR MES":"COSTO TOTAL DEL MES";$("#result").textContent=ars(only?arca+art:total);$("#badge-label").textContent=only?"Sueldo aparte":"Ella cobra";$("#badge").textContent=ars(salary);if(only)setStat(["APORTES ARCA","ART","TRAMO"],[ars(arca),ars(art),hours<12?"Menos de 12 hs":hours<16?"12 a 16 hs":"16 hs o más"]);else setStat(["ARCA + ART","PROVISIÓN SAC","PROVISIÓN VACACIONES"],[ars(arca+art),ars(sac),ars(vac)]);$("#art-value").textContent=$("#result").textContent;$("#art-copy").textContent=hours+" hs por semana · "+(mode==="hour-in"?"con retiro":mode==="monthly"?"mensual":mode==="contrib"?"sólo aportes":"sin retiro");let rows=[["Valor hora de escala",ars(hourRate)],["Horas mensuales estimadas",(hours*4.33).toFixed(0)+" horas"],["Sueldo de bolsillo",ars(salary)],["Cargas y provisiones",ars(charges)],["Costo total",ars(total)]];rows.forEach((x,i)=>{$("#d"+(i+1)+"l").textContent=x[0];$("#d"+(i+1)).textContent=x[1]});$("#leg-salary").textContent=ars(salary);$("#leg-arca").textContent=ars(arca);$("#leg-art").textContent=ars(art);$("#leg-prov").textContent=ars(sac+vac);let t=Math.max(1,total);$("#bar-salary").style.width=salary/t*100+"%";$("#bar-arca").style.width=arca/t*100+"%";$("#bar-art").style.width=art/t*100+"%";$("#bar-prov").style.width=(sac+vac)/t*100+"%";$("#dark-days").textContent=days+" días";$("#dark-band").textContent=hours<12?"Menos de 12 hs":hours<16?"12 a 16 hs":"16 hs o más"}
function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$("#salary-field").classList.toggle("hide",m!=="monthly");calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Cálculo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar cálculo",1200)};setMode("hour-out");

})();
</script>
