---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-ecuaciones-polinomios" set:html={`<div class="crumb">Matemática / Álgebra</div><section class="hero"><h1>Encontrá dónde el polinomio toca el piso.</h1><p>Cambiá los coeficientes, mirá la curva y seguí la decisión del discriminante hasta sus raíces.</p></section><section class="equation"><input id="a" type="number" value="1" aria-label="Coeficiente a">x² + <input id="b" type="number" value="-3" aria-label="Coeficiente b">x + <input id="c" type="number" value="2" aria-label="Coeficiente c"> = 0</section><section class="work"><div class="plot"><h2>Mapa de intersecciones</h2><svg id="svg" viewBox="0 0 650 370"></svg></div><aside class="solver"><h2>Ruta de resolución</h2><div class="delta"><span>Discriminante<br><small>b² − 4ac</small></span><b id="delta"></b></div><div class="branches"><div class="branch" id="neg">Δ &lt; 0<br><b>sin raíces reales</b></div><div class="branch" id="zero">Δ = 0<br><b>una raíz doble</b></div><div class="branch" id="pos">Δ &gt; 0<br><b>dos raíces</b></div></div><div class="roots" id="roots"></div><div class="factor" id="factor"></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-ecuaciones-polinomios')?document.currentScript.previousElementSibling:document.querySelector('.mockup-ecuaciones-polinomios');

const $=x=>root.querySelector("#"+x);
function render(){let a=+$('a').value,b=+$('b').value,c=+$('c').value,D=b*b-4*a*c; if(!a){$('delta').textContent='—';$('factor').textContent='a no puede ser 0 en una cuadrática';return}$('delta').textContent=D.toFixed(2);['neg','zero','pos'].forEach(x=>$(x).classList.remove('on'));$(D<0?'neg':Math.abs(D)<1e-9?'zero':'pos').classList.add('on');let rs=D<0?[]:[(-b+Math.sqrt(Math.max(0,D)))/(2*a),(-b-Math.sqrt(Math.max(0,D)))/(2*a)];if(D===0)rs=[rs[0]];$('roots').innerHTML=rs.length?rs.map((r,i)=>`<div class="rootcard"><span>x${i+1}</span><b>${r.toFixed(3)}</b></div>`).join(''):'<div class="rootcard">La curva no corta el eje x.</div>';$('factor').textContent=rs.length===2?`a · (x − ${rs[0].toFixed(2)}) · (x − ${rs[1].toFixed(2)})`:rs.length===1?`a · (x − ${rs[0].toFixed(2)})²`:'No se factoriza en números reales';let pts=[],cx=325,cy=185,sx=50,sy=14;for(let x=-6.4;x<=6.4;x+=.05){let y=a*x*x+b*x+c;pts.push(`${cx+x*sx},${cy-y*sy}`)}$('svg').innerHTML=`<path class="axis" d="M0 ${cy}H650 M${cx} 0V370"/><polyline class="curve" points="${pts.join(' ')}"/>${rs.map(r=>`<circle class="root" cx="${cx+r*sx}" cy="${cy}" r="10"/>`).join('')}`}
root.querySelectorAll('input').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-ecuaciones-polinomios{--blue:#174b7a;--ink:#19282f;--muted:#637179;--line:#d8e1df;--orange:#e57f45;--mint:#dff2e9;--paper:#f5f7f5}.mockup-ecuaciones-polinomios *{box-sizing:border-box}.mockup-ecuaciones-polinomios{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-ecuaciones-polinomios input,.mockup-ecuaciones-polinomios button{font:inherit}.mockup-ecuaciones-polinomios .shell{max-width:1160px;margin:auto;padding:36px 22px}.mockup-ecuaciones-polinomios .crumb{color:var(--blue);font-weight:800}.mockup-ecuaciones-polinomios .hero h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-ecuaciones-polinomios .hero p{font-size:18px;color:var(--muted)}.mockup-ecuaciones-polinomios .equation{margin:30px 0 18px;background:#fff;border:1px solid var(--line);border-radius:22px;padding:18px 24px;display:flex;gap:9px;align-items:center;justify-content:center;font-size:25px;font-weight:900}.mockup-ecuaciones-polinomios .equation input{width:78px;border:0;border-bottom:3px solid var(--orange);text-align:center;font-size:25px;font-weight:900;color:var(--blue)}.mockup-ecuaciones-polinomios .work{display:grid;grid-template-columns:1.1fr .9fr;gap:20px}.mockup-ecuaciones-polinomios .plot,.mockup-ecuaciones-polinomios .solver{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-ecuaciones-polinomios .plot svg{width:100%;height:370px}.mockup-ecuaciones-polinomios .axis{stroke:#a6b5b1}.mockup-ecuaciones-polinomios .curve{fill:none;stroke:var(--blue);stroke-width:5}.mockup-ecuaciones-polinomios .root{fill:var(--orange);stroke:#fff;stroke-width:4}.mockup-ecuaciones-polinomios .solver h2,.mockup-ecuaciones-polinomios .plot h2{margin:0;font-size:23px}.mockup-ecuaciones-polinomios .delta{display:flex;justify-content:space-between;align-items:center;margin:22px 0;padding:16px;border-radius:15px;background:var(--mint)}.mockup-ecuaciones-polinomios .delta b{font-size:30px}.mockup-ecuaciones-polinomios .branches{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.mockup-ecuaciones-polinomios .branch{padding:13px;border:1px solid var(--line);border-radius:13px;color:var(--muted)}.mockup-ecuaciones-polinomios .branch.on{background:var(--blue);color:#fff;border-color:var(--blue)}.mockup-ecuaciones-polinomios .roots{margin-top:20px;display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-ecuaciones-polinomios .rootcard{background:#fff5dc;border-radius:14px;padding:16px}.mockup-ecuaciones-polinomios .rootcard b{font-size:26px;display:block}.mockup-ecuaciones-polinomios .factor{margin-top:18px;padding:15px;border-left:5px solid var(--orange);background:#fff8e9;font:700 16px ui-monospace,monospace}@media(max-width:800px){.mockup-ecuaciones-polinomios .work{grid-template-columns:1fr}.mockup-ecuaciones-polinomios .equation{font-size:17px}.mockup-ecuaciones-polinomios .equation input{width:56px;font-size:18px}.mockup-ecuaciones-polinomios .branches{grid-template-columns:1fr}}
.mockup-ecuaciones-polinomios { width:100%; overflow:hidden; }
.mockup-ecuaciones-polinomios .top, .mockup-ecuaciones-polinomios header.top { display:none !important; }
.mockup-ecuaciones-polinomios .foot { display:none !important; }
.mockup-ecuaciones-polinomios .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-ecuaciones-polinomios .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-ecuaciones-polinomios .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-ecuaciones-polinomios .support-real summary { cursor:pointer; font-weight:750; }
.mockup-ecuaciones-polinomios .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-ecuaciones-polinomios :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-ecuaciones-polinomios input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-ecuaciones-polinomios input[type="number"]::-webkit-inner-spin-button, .mockup-ecuaciones-polinomios input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-ecuaciones-polinomios .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-ecuaciones-polinomios support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
