---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-master-oficial-titulo-propio" set:html={`
<section class="hero"><div class="wrap crumb"><b>España</b> &nbsp;/&nbsp; Educación &nbsp;/&nbsp; Máster oficial o título propio</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Elegí el título, no sólo el nombre</span><h1>¿Máster oficial<br>o título propio?<br>Compará antes.</h1><p>Calculá el coste real, comprobá qué reconocimiento tiene cada opción y descubrí si podrías acceder a una beca MEC.</p><div class="chips"><span>🎓 Reconocimiento oficial</span><span>€ Coste neto</span><span>✓ Beca y financiación</span></div><div class="degree-art"><div class="desk"></div><div class="diploma"><i class="seal"></i></div><div class="cap"><i class="cap-top"></i><i class="cap-band"></i><i class="cap-tassel"></i></div><div class="art-card"><small>COSTE NETO ESTIMADO</small><strong id="art-cost">0 €</strong><span id="art-type">Máster oficial público</span></div></div></div>
<form class="calc"><div class="calc-title"><div><h2>Calculá tu máster</h2><p>Elegí la alternativa que estás evaluando.</p></div><span class="tag">Resultado instantáneo</span></div><div class="section-label">Tipo de programa</div><div class="cases"><button type="button" class="case active" data-type="officialPublic"><i>🏛️</i>Oficial público</button><button type="button" class="case" data-type="officialPrivate"><i>🎓</i>Oficial privado</button><button type="button" class="case" data-type="own"><i>📜</i>Título propio</button><button type="button" class="case" data-type="mba"><i>💼</i>MBA top</button></div><div class="section-label">Datos del programa</div><div class="fields"><div class="field"><label>Créditos ECTS</label><div class="inline"><input id="credits" type="number" min="30" max="180" value="60"><b>ECTS</b></div></div><div class="field"><label>Precio por crédito</label><div class="inline"><b>€</b><input id="rate" type="number" min="0" value="27"></div></div><div class="field"><label>Duración</label><div class="inline"><input id="years" type="number" min=".5" max="3" step=".5" value="1"><b>años</b></div></div><div class="field"><label>Otros gastos</label><div class="inline"><b>€</b><input id="extras" type="number" min="0" value="600"></div></div><div class="field wide"><label>Renta familiar anual</label><div class="inline"><b>€</b><input id="income" type="number" min="0" value="22000"></div></div></div><label class="checkrow"><input id="scholarship" type="checkbox" checked> Quiero estimar si la beca MEC reduce el coste</label><section class="result"><div class="result-top"><div><small>Lo que pagarías de tu bolsillo</small><div class="value" id="net-cost">0 €</div></div><div class="verdict"><small>Reconocimiento</small><strong id="recognition">Oficial · RUCT</strong></div></div><div class="stats"><span>Coste bruto<b id="gross-cost">0 €</b></span><span>Beca estimada<b id="scholarship-value">0 €</b></span><span>Coste mensual<b id="monthly-cost">0 €</b></span></div><button class="go" id="update" type="button">Actualizar cálculo</button></section></form>
</div></section>
<section class="decision"><div class="wrap"><header class="center"><span>La decisión importante</span><h2>No son el mismo título con distinto precio</h2><p>El reconocimiento cambia lo que podés hacer después. Revisalo antes de comparar cuotas o financiación.</p></header><div class="decision-grid"><article class="decision-card recommended"><span class="badge">MÁS VERSÁTIL</span><i>🏛️</i><h3>Máster oficial</h3><p>Verificado y registrado. Puede ser habilitante o dar acceso al doctorado.</p><ul><li class="yes">✓ Acceso al doctorado</li><li class="yes">✓ Puntúa en oposiciones</li><li class="yes">✓ Puede acceder a beca MEC</li></ul></article><article class="decision-card"><i>📜</i><h3>Título propio</h3><p>Formación diseñada por la universidad con orientación profesional específica.</p><ul><li class="no">— No da acceso al doctorado</li><li class="no">— No equivale a título oficial</li><li class="yes">✓ Puede tener buena conexión empresarial</li></ul></article><article class="decision-card"><i>💼</i><h3>MBA de prestigio</h3><p>El valor suele estar en la red, la marca y el acceso profesional, no en la oficialidad.</p><ul><li class="yes">✓ Red de contactos</li><li class="yes">✓ Proyección internacional</li><li class="no">— Inversión muy elevada</li></ul></article></div></div></section>
<section class="breakdown"><div class="wrap break-grid"><article class="card"><h3>Tu coste, línea por línea</h3><div class="line"><span>Matrícula · créditos × tarifa</span><b id="d-tuition">0 €</b></div><div class="line"><span>Materiales, reserva y tasas</span><b id="d-extras">0 €</b></div><div class="line"><span>Beca MEC estimada</span><b id="d-scholarship">− 0 €</b></div><div class="line"><span>Coste medio por año</span><b id="d-year">0 €</b></div><div class="line total"><strong>Coste neto estimado</strong><b id="d-net">0 €</b></div></article><article class="card"><h3>Antes de pagar una reserva</h3><div class="step"><i>1</i><div><b>Buscá el título en el RUCT</b><span>Si no aparece, no es un máster oficial.</span></div></div><div class="step"><i>2</i><div><b>Confirmá si es habilitante</b><span>Es imprescindible para algunas profesiones reguladas.</span></div></div><div class="step"><i>3</i><div><b>Pedí el coste completo</b><span>Incluí reserva, expedición, materiales y prácticas.</span></div></div><div class="warning">⚠️ La palabra “máster” en la publicidad no garantiza reconocimiento oficial. Verificá el programa exacto y su código en el RUCT.</div></article></div></section>
<section class="compare-section"><div class="wrap"><header class="center"><span>Comparación real</span><h2>Poné dos alternativas frente a frente</h2><p>Usamos los mismos créditos y gastos para mostrar cuánto cambia el coste y qué reconocimiento conserva cada opción.</p></header><div class="compare-box"><div class="compare-controls"><label>Alternativa A<select id="compare-a"><option value="officialPublic">Oficial público</option><option value="officialPrivate">Oficial privado</option><option value="own">Título propio</option><option value="mba">MBA top</option></select></label><span class="versus">VS</span><label>Alternativa B<select id="compare-b"><option value="own">Título propio</option><option value="officialPrivate">Oficial privado</option><option value="officialPublic">Oficial público</option><option value="mba">MBA top</option></select></label></div><div class="compare-result"><div><small id="compare-a-label">OFICIAL PÚBLICO</small><b id="compare-a-cost">0 €</b><span id="compare-a-note">Oficial · beca posible</span></div><div class="winner"><small>LECTURA RÁPIDA</small><b id="compare-winner">Calculando…</b><span id="compare-diff">Diferencia total</span></div><div><small id="compare-b-label">TÍTULO PROPIO</small><b id="compare-b-cost">0 €</b><span id="compare-b-note">No oficial</span></div></div><button type="button" class="compare-button" id="compare-update">Actualizar comparación</button></div></div></section>
<section class="faq"><div class="wrap faq-grid"><div><span class="eyebrow" style="color:#bfa6f2">Sin letra pequeña</span><h2>Las preguntas que cambian la decisión</h2><p>Precio, reconocimiento y salida profesional deben mirarse juntos. Ningún indicador aislado decide por vos.</p></div><div><details open><summary>¿Cómo sé si un máster es oficial?</summary><p>Buscá la denominación exacta en el Registro de Universidades, Centros y Títulos (RUCT). La universidad debe informar también el código del título.</p></details><details><summary>¿Un título propio sirve para oposiciones?</summary><p>Puede contar como formación complementaria según el baremo, pero no equivale automáticamente a un máster universitario oficial.</p></details><details><summary>¿La beca MEC cubre cualquier máster?</summary><p>No. Se orienta a estudios oficiales y además exige requisitos económicos y académicos. Un título propio no accede por esa vía.</p></details><details><summary>¿Siempre conviene el oficial?</summary><p>No necesariamente. Si buscás una especialización muy concreta y el título propio tiene una red empresarial fuerte, puede ser útil. La clave es no pagar creyendo que ofrece efectos académicos que no tiene.</p></details></div></div></section><div class="foot"></div>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-master-oficial-titulo-propio')?document.currentScript.previousElementSibling:document.querySelector('.mockup-master-oficial-titulo-propio');

const $=s=>root.querySelector(s),money=v=>Math.round(v||0).toLocaleString("es-ES")+" €";
const programs={
 officialPublic:{label:"Máster oficial público",short:"OFICIAL PÚBLICO",rate:27,recognition:"Oficial · RUCT",note:"Oficial · beca posible",mec:true},
 officialPrivate:{label:"Máster oficial privado",short:"OFICIAL PRIVADO",rate:180,recognition:"Oficial · RUCT",note:"Oficial · coste libre",mec:false},
 own:{label:"Título propio",short:"TÍTULO PROPIO",rate:90,recognition:"No oficial",note:"No oficial · enfoque profesional",mec:false},
 mba:{label:"MBA de prestigio",short:"MBA TOP",rate:1000,recognition:"Marca y networking",note:"Valor de marca y red",mec:false}
};
let selected="officialPublic";
function scholarshipFor(type,gross){if(!$("#scholarship").checked||!programs[type].mec)return 0;const income=Math.max(0,Number($("#income").value)||0);return income<22500?Math.min(gross,3500):income<35500?gross*.5:0}
function costFor(type){const credits=Math.max(1,Number($("#credits").value)||60),extras=Math.max(0,Number($("#extras").value)||0),rate=type===selected?Math.max(0,Number($("#rate").value)||0):programs[type].rate,tuition=credits*rate,gross=tuition+extras,scholarship=scholarshipFor(type,gross);return{rate,tuition,gross,scholarship,net:Math.max(0,gross-scholarship)}}
function calculate(){const p=programs[selected],years=Math.max(.5,Number($("#years").value)||1),r=costFor(selected);$("#net-cost").textContent=money(r.net);$("#gross-cost").textContent=money(r.gross);$("#scholarship-value").textContent=r.scholarship?"− "+money(r.scholarship):"No aplica";$("#monthly-cost").textContent=money(r.net/(years*12));$("#recognition").textContent=p.recognition;$("#art-cost").textContent=money(r.net);$("#art-type").textContent=p.label;$("#d-tuition").textContent=money(r.tuition);$("#d-extras").textContent=money(Number($("#extras").value)||0);$("#d-scholarship").textContent="− "+money(r.scholarship);$("#d-year").textContent=money(r.net/years);$("#d-net").textContent=money(r.net);compare()}
function choose(type){selected=type;root.querySelectorAll(".case").forEach(b=>b.classList.toggle("active",b.dataset.type===type));$("#rate").value=programs[type].rate;calculate()}
function compare(){const a=$("#compare-a").value,b=$("#compare-b").value,ra=costFor(a),rb=costFor(b),diff=Math.abs(ra.net-rb.net),cheaper=ra.net<=rb.net?a:b;$("#compare-a-label").textContent=programs[a].short;$("#compare-b-label").textContent=programs[b].short;$("#compare-a-cost").textContent=money(ra.net);$("#compare-b-cost").textContent=money(rb.net);$("#compare-a-note").textContent=programs[a].note;$("#compare-b-note").textContent=programs[b].note;$("#compare-winner").textContent=a===b?"Elegí dos opciones distintas":programs[cheaper].label+" cuesta menos";$("#compare-diff").textContent=a===b?"":money(diff)+" de diferencia total"}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>choose(b.dataset.type)));root.querySelectorAll(".calc input").forEach(el=>el.addEventListener("input",calculate));$("#update").addEventListener("click",e=>{e.preventDefault();calculate();e.currentTarget.textContent="✓ Cálculo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar cálculo",1200)});$("#compare-a").addEventListener("change",compare);$("#compare-b").addEventListener("change",compare);$("#compare-update").addEventListener("click",e=>{compare();e.currentTarget.textContent="✓ Comparación actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar comparación",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());calculate();

})();
</script>
