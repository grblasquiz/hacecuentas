---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-tierra-macetas" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Jardín / Tierra y macetas</div><div class="eyebrow">Volumen por recipiente</div><h1>Comprá litros de sustrato, no “bolsas a ojo”.</h1><p class="lead">Sumá macetas de distintas formas y tamaños. Descontamos borde libre y mostramos cuántas bolsas completas necesitás.</p></div><div class="pot-hero"><div class="plant"><i></i><i></i><i></i></div><div class="pot"></div><span class="pot-label">Sustrato útil</span></div></div></section>
<section class="calculator"><div class="calc-grid"><section class="inventory"><div class="inventory-head"><h2>Macetas a llenar</h2><button class="add" id="add">+ Agregar maceta</button></div><div class="pot-list" id="potList"></div><div class="assumptions"><div class="field"><label for="bag">TAMAÑO DE BOLSA (L)</label><input id="bag" type="number" value="20" min="1"></div><div class="field"><label for="reserve">RESERVA EXTRA (%)</label><input id="reserve" type="number" value="10" min="0" max="50"></div></div></section><aside class="cutaway" aria-live="polite"><div class="cutaway-head"><div><small>SUSTRATO TOTAL A COMPRAR</small><h2 id="total">98 litros</h2></div><span class="bag-count" id="bags">5 bolsas</span></div><div class="layers"><div class="layer air">10% borde libre</div><div class="layer substrate" id="substrateLayer">89 L de sustrato útil</div><div class="layer drain">Drenaje y orificios libres</div></div><div class="summary"><div class="metric"><small>VOLUMEN GEOMÉTRICO</small><b id="geometric">98 L</b></div><div class="metric"><small>RESERVA</small><b id="reserveValue">9 L</b></div><div class="metric"><small>SOBRANTE APROX.</small><b id="leftover">3 L</b></div></div><div class="note">No uses una capa gruesa de piedras para “mejorar” drenaje. Priorizá orificios libres y un sustrato adecuado.</div></aside></div></section>
<section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Qué volumen usar</div><h2>La forma cambia la cuenta</h2><p>Una maceta troncocónica contiene bastante menos que un cilindro con el mismo diámetro superior.</p></div><div class="rules"><div class="rule"><b>Redonda</b><span>Usamos diámetro y altura, con factor por forma troncocónica.</span></div><div class="rule"><b>Jardinera</b><span>Largo × ancho × alto, descontando borde libre.</span></div><div class="rule"><b>Trasplante</b><span>No todo el volumen nuevo se llena: el pan de raíces ocupa espacio.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-tierra-macetas')?document.currentScript.previousElementSibling:document.querySelector('.mockup-tierra-macetas');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let pots=[{shape:"round",a:35,b:25,h:32,count:2},{shape:"rect",a:60,b:20,h:22,count:2}];function volume(p){return p.shape==="round"?Math.PI*p.h*(p.a*p.a+p.a*p.b+p.b*p.b)/12/1000:p.a*p.b*p.h/1000}function render(){$("#potList").innerHTML=pots.map((p,i)=>`<div class="pot-row" data-i="${i}"><div><select class="shape"><option value="round" ${p.shape==="round"?"selected":""}>Redonda</option><option value="rect" ${p.shape==="rect"?"selected":""}>Jardinera</option></select><small>Forma</small></div><div><input class="dims" value="${p.a} × ${p.b} × ${p.h}"><small>${p.shape==="round"?"Diámetro sup. × base × alto":"Largo × ancho × alto"} en cm</small></div><div><input class="count" type="number" value="${p.count}" min="1"><small>Cantidad</small></div><button class="remove" aria-label="Eliminar">×</button></div>`).join("");$$(".pot-row").forEach(row=>{const i=+row.dataset.i,shape=row.querySelector(".shape"),dims=row.querySelector(".dims"),count=row.querySelector(".count");shape.addEventListener("change",()=>{pots[i].shape=shape.value;render()});dims.addEventListener("change",()=>{const n=dims.value.split(/[x×]/i).map(Number);if(n.length===3&&n.every(Number.isFinite)){[pots[i].a,pots[i].b,pots[i].h]=n;calculate()}});count.addEventListener("input",()=>{pots[i].count=+count.value||1;calculate()});row.querySelector(".remove").addEventListener("click",()=>{if(pots.length>1){pots.splice(i,1);render()}})});calculate()}function calculate(){const geometric=pots.reduce((s,p)=>s+volume(p)*p.count,0),useful=geometric*.9,reserve=useful*(+$("#reserve").value||0)/100,total=useful+reserve,bag=Math.max(1,+$("#bag").value||1),bags=Math.ceil(total/bag),left=bags*bag-total;$("#total").textContent=Math.ceil(total)+" litros";$("#bags").textContent=bags+" "+(bags===1?"bolsa":"bolsas");$("#substrateLayer").textContent=Math.round(useful)+" L de sustrato útil";$("#geometric").textContent=Math.round(geometric)+" L";$("#reserveValue").textContent=Math.round(reserve)+" L";$("#leftover").textContent=Math.round(left)+" L"}$("#add").addEventListener("click",()=>{pots.push({shape:"round",a:30,b:22,h:28,count:1});render()});$("#bag").addEventListener("input",calculate);$("#reserve").addEventListener("input",calculate);render()})();
})();
</script>
<style is:global>

.mockup-tierra-macetas{--blue:#174b7a;--soil:#805c3b;--terr:#b66c48;--sand:#f7efe5;--leaf:#3f835e;--mint:#e8f3ea;--ink:#182332;--muted:#5f6977;--line:#d9e2e4}.mockup-tierra-macetas *{box-sizing:border-box}.mockup-tierra-macetas{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#faf8f5}.mockup-tierra-macetas button,.mockup-tierra-macetas input,.mockup-tierra-macetas select{font:inherit}.mockup-tierra-macetas .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-tierra-macetas .brand{font-size:19px;font-weight:950}.mockup-tierra-macetas .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-tierra-macetas .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-tierra-macetas .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-tierra-macetas .hero{padding:42px 22px 45px;background:linear-gradient(120deg,#fff 0 63%,var(--sand) 63%)}.mockup-tierra-macetas .hero-grid,.mockup-tierra-macetas .wrap{max-width:1180px;margin:auto}.mockup-tierra-macetas .hero-grid{display:grid;grid-template-columns:1fr .8fr;gap:55px;align-items:center}.mockup-tierra-macetas .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-tierra-macetas .eyebrow{margin-top:25px;color:var(--terr);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-tierra-macetas .hero h1{font-size:clamp(43px,5vw,64px);line-height:.98;letter-spacing:-.05em;margin:9px 0 18px}.mockup-tierra-macetas .lead{font-size:19px;color:var(--muted)}.mockup-tierra-macetas .pot-hero{height:330px;display:grid;place-items:center;position:relative}.mockup-tierra-macetas .plant{position:absolute;top:0;width:160px;height:160px}.mockup-tierra-macetas .plant i{position:absolute;width:70px;height:110px;border-radius:70% 15% 70% 15%;background:var(--leaf)}.mockup-tierra-macetas .plant i:nth-child(1){left:10px;transform:rotate(-35deg)}.mockup-tierra-macetas .plant i:nth-child(2){right:10px;transform:scaleX(-1) rotate(-35deg)}.mockup-tierra-macetas .plant i:nth-child(3){left:48px;top:-30px}.mockup-tierra-macetas .pot{position:absolute;bottom:0;width:260px;height:220px;clip-path:polygon(8% 0,92% 0,76% 100%,24% 100%);background:linear-gradient(180deg,#86613f 0 78%,#cbb79d 78%);border-top:14px solid var(--terr)}.mockup-tierra-macetas .pot:after{content:"";position:absolute;left:20%;right:20%;top:45%;border-top:3px dashed #ead9c4}.mockup-tierra-macetas .pot-label{position:absolute;color:#fff;font-weight:900;z-index:1;bottom:95px}.mockup-tierra-macetas .calculator{padding:52px 22px 70px}.mockup-tierra-macetas .calc-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}.mockup-tierra-macetas .inventory{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden}.mockup-tierra-macetas .inventory-head{padding:20px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:15px;align-items:center}.mockup-tierra-macetas .inventory h2{font-size:21px;margin:0}.mockup-tierra-macetas .add{border:0;border-radius:10px;background:var(--blue);color:#fff;padding:10px 12px;font-weight:900;cursor:pointer}.mockup-tierra-macetas .pot-list{padding:0 20px}.mockup-tierra-macetas .pot-row{display:grid;grid-template-columns:85px 1fr 80px 35px;gap:10px;align-items:center;padding:13px 0;border-top:1px solid #edf0f1}.mockup-tierra-macetas .pot-row:first-child{border:0}.mockup-tierra-macetas .pot-row select,.mockup-tierra-macetas .pot-row input{width:100%;border:1px solid #ced8db;border-radius:8px;padding:8px;color:var(--ink)}.mockup-tierra-macetas .pot-row small{display:block;color:var(--muted);font-size:9px}.mockup-tierra-macetas .remove{border:0;background:none;color:#88929c;font-size:18px;cursor:pointer}.mockup-tierra-macetas .assumptions{padding:17px 20px;background:#fafbfa;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:12px}.mockup-tierra-macetas .field label{display:block;font-size:10px;font-weight:900;margin-bottom:5px}.mockup-tierra-macetas .field input{width:100%;border:1px solid #ccd7da;border-radius:9px;padding:9px;color:var(--ink)}.mockup-tierra-macetas .cutaway{background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px}.mockup-tierra-macetas .cutaway-head{display:flex;justify-content:space-between;gap:15px;align-items:start}.mockup-tierra-macetas .cutaway small{display:block;color:var(--muted);font-size:10px}.mockup-tierra-macetas .cutaway h2{font-size:27px;margin:4px 0}.mockup-tierra-macetas .bag-count{padding:8px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:11px;font-weight:900}.mockup-tierra-macetas .layers{height:270px;margin:20px 0;display:grid;grid-template-rows:10% 72% 18%;clip-path:polygon(8% 0,92% 0,78% 100%,22% 100%)}.mockup-tierra-macetas .layer{display:grid;place-items:center;color:#fff;font-size:12px;font-weight:900}.mockup-tierra-macetas .layer.air{background:#d9c4a9}.mockup-tierra-macetas .layer.substrate{background:var(--soil)}.mockup-tierra-macetas .layer.drain{background:#b8ab9c;color:#4e4237}.mockup-tierra-macetas .summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mockup-tierra-macetas .metric{padding:12px;background:var(--sand);border-radius:11px}.mockup-tierra-macetas .metric small{display:block;color:var(--muted);font-size:9px}.mockup-tierra-macetas .metric b{font-size:14px}.mockup-tierra-macetas .note{margin-top:15px;padding:12px;border-left:5px solid var(--terr);background:#fff8ef;color:#664831;font-size:11px}.mockup-tierra-macetas .guide{padding:60px 22px;background:#f1ece6}.mockup-tierra-macetas .guide-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:40px}.mockup-tierra-macetas .kicker{color:var(--terr);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-tierra-macetas .guide h2{font-size:35px;letter-spacing:-.04em;margin:6px 0}.mockup-tierra-macetas .guide p{color:var(--muted)}.mockup-tierra-macetas .rules{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-tierra-macetas .rule{padding:16px;background:#fff;border:1px solid var(--line);border-radius:14px}.mockup-tierra-macetas .rule b{display:block;margin-bottom:5px}.mockup-tierra-macetas .rule span{font-size:12px;color:var(--muted)}.mockup-tierra-macetas .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-tierra-macetas .nav{display:none}.mockup-tierra-macetas .hero-grid,.mockup-tierra-macetas .calc-grid,.mockup-tierra-macetas .guide-grid{grid-template-columns:1fr}.mockup-tierra-macetas .rules{grid-template-columns:1fr}.mockup-tierra-macetas .pot-hero{max-width:500px}}@media(max-width:580px){.mockup-tierra-macetas .hero h1{font-size:42px}.mockup-tierra-macetas .pot-row{grid-template-columns:75px 1fr 35px}.mockup-tierra-macetas .pot-row>div:nth-child(3){grid-column:2}.mockup-tierra-macetas .assumptions,.mockup-tierra-macetas .summary{grid-template-columns:1fr}}

.mockup-tierra-macetas { width:100%; overflow:hidden; }
.mockup-tierra-macetas .top, .mockup-tierra-macetas header.top { display:none !important; }
.mockup-tierra-macetas .foot { display:none !important; }
.mockup-tierra-macetas .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-tierra-macetas .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-tierra-macetas .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-tierra-macetas .support-real summary { cursor:pointer; font-weight:750; }
.mockup-tierra-macetas .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-tierra-macetas :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-tierra-macetas input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-tierra-macetas input[type="number"]::-webkit-inner-spin-button, .mockup-tierra-macetas input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-tierra-macetas .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-tierra-macetas support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
