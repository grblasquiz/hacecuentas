<div class="mockup-estudio-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Estudio</div><div class="heroGrid"><div><span class="eyebrow">Hacé visible lo que ya avanzaste</span><h1>Tu carrera no es solo lo que falta. También es todo lo que hiciste.</h1><p class="lead">Progreso, promedio, tiempo y escritura. Herramientas para estudiar con una imagen más clara del camino.</p><div class="trust"><span>✓ Aprobadas separadas</span><span>✓ Ritmo real</span><span>✓ Fecha estimada</span></div><div class="scene"><i class="book"></i><i class="pencil"></i><i class="mark">✓</i></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Cuánto falta para terminar?</h2><p>Materias, ritmo y períodos de cursada.</p></div><span class="live">PROGRESO EN VIVO</span></div><div class="profiles"><button class="profile active" data-profile="university">Universitaria</button><button class="profile" data-profile="tertiary">Terciario</button><button class="profile" data-profile="course">Curso</button></div><div class="fields"><div class="field"><label>Materias totales</label><div class="input"><input id="totalSubjects" type="number" min="1" value="40"><span>materias</span></div></div><div class="field"><label>Materias aprobadas</label><div class="input"><input id="passed" type="number" min="0" value="21"><span>aprobadas</span></div></div><div class="field"><label>Cursando ahora</label><div class="input"><input id="current" type="number" min="0" value="3"><span>materias</span></div></div><div class="field"><label>Ritmo por semestre</label><div class="input"><input id="pace" type="number" min=".5" step=".5" value="4"><span>materias</span></div></div><div class="field"><label>Semestres que cursás por año</label><div class="input"><input id="periods" type="number" min="1" max="4" value="2"><span>períodos</span></div></div><div class="field"><label>Mes de próximo período</label><div class="input"><input id="startMonth" type="month"></div></div></div><button class="primary" id="calculate">Actualizar progreso</button><div class="result"><div class="resultTop"><div><small>PROGRESO DE LA CARRERA</small><div class="amount" id="progressText">53% completado</div></div><span class="badge" id="profileLabel">Universitaria</span></div><div class="resultGrid"><div class="metric"><span>FALTAN APROBAR</span><b id="remaining">19 materias</b></div><div class="metric"><span>PERÍODOS ESTIMADOS</span><b id="semesters">5 semestres</b></div><div class="metric"><span>POSIBLE FINALIZACIÓN</span><b id="finish">dic 2028</b></div></div><div class="progress"><i id="progressBar"></i></div><p class="note" id="note">Las materias que cursás todavía no se cuentan como aprobadas en el progreso.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por lo que necesitás resolver</span><h2>¿En qué parte del estudio estás?</h2><p>Elegí una necesidad y encontrá primero la herramienta adecuada.</p></div><div class="needs"><button class="need active" data-filter="progress"><span class="icon">↗</span><h3>Medir mi avance</h3><p>Materias, porcentaje y fecha posible.</p><em>→</em></button><button class="need" data-filter="grades"><span class="icon">10</span><h3>Calcular promedio</h3><p>Simple o ponderado por créditos.</p><em>→</em></button><button class="need" data-filter="writing"><span class="icon">Aa</span><h3>Revisar un texto</h3><p>Palabras, caracteres y tiempo de lectura.</p><em>→</em></button><button class="need" data-filter="planning"><span class="icon">□</span><h3>Planificar cursada</h3><p>Carga, ritmo y próximos períodos.</p><em>→</em></button><button class="need" data-filter="degree"><span class="icon">★</span><h3>Elegir formación</h3><p>Duración, costo y tipo de título.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de estudio</span><h2>Del esfuerzo diario a una imagen completa.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="progress">Progreso</button><button class="filter" data-filter="grades">Notas</button><button class="filter" data-filter="writing">Escritura</button><button class="filter" data-filter="planning">Planificación</button><button class="filter" data-filter="degree">Formación</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="progress planning" data-text="cuanto falta recibirme carrera materias progreso fecha"><span class="tag">Tu carrera</span><h3>¿Cuánto falta para recibirme?</h3><p>Progreso, materias restantes y fecha estimada según tu ritmo.</p><button>Calcular progreso →</button></article><article class="card" data-cat="grades" data-text="promedio notas ponderado créditos materias"><span class="tag">Notas</span><h3>Calculadora de promedio</h3><p>Promedio simple o ponderado, con nota objetivo.</p><button>Calcular promedio →</button></article><article class="card" data-cat="writing" data-text="contador palabras caracteres lectura texto"><span class="tag">Texto</span><h3>Contador de palabras</h3><p>Palabras, caracteres, oraciones y tiempo de lectura.</p><button>Analizar texto →</button></article><article class="card" data-cat="planning" data-text="plan cursada materias semestre carga estudio"><span class="tag">Organización</span><h3>Plan de cursada</h3><p>Distribuí materias según tiempo y dificultad.</p><button>Armar plan →</button></article><article class="card" data-cat="degree" data-text="master oficial titulo propio precio españa formación"><span class="tag">Posgrado</span><h3>Máster oficial o título propio</h3><p>Compará costo, duración y reconocimiento.</p><button>Comparar opciones →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="method"><div class="wrap methodGrid"><div><span class="eyebrow" style="color:var(--yellow)">Una estimación que sirve, no que presiona</span><h2>El ritmo sostenible gana a la fecha perfecta.</h2><p>Usá la proyección para planificar, no para castigarte. Trabajo, correlatividades y vida personal pueden cambiar cualquier calendario.</p></div><div class="methodList"><button class="methodBtn active" data-step="Real"><span><b>1. Partí de tu ritmo real</b><small>No del máximo que hiciste una sola vez.</small></span><b>→</b></button><button class="methodBtn" data-step="Dificultad"><span><b>2. Combiná dificultades</b><small>No todas las materias pesan igual.</small></span><b>→</b></button><button class="methodBtn" data-step="Margen"><span><b>3. Dejá margen</b><small>Finales, pausas y correlatividades existen.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-estudio-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-estudio-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let currentProfile="university";const isoMonth=d=>d.toISOString().slice(0,7);let start=new Date();start.setMonth(start.getMonth()+1);$("#startMonth").value=isoMonth(start);function calc(){const total=Math.max(1,+$("#totalSubjects").value||1),passed=Math.min(total,Math.max(0,+$("#passed").value||0)),current=Math.max(0,+$("#current").value||0),pace=Math.max(.5,+$("#pace").value||.5),periods=Math.max(1,+$("#periods").value||1),remaining=Math.max(0,total-passed),terms=Math.ceil(remaining/pace),progress=Math.round(passed/total*100),startDate=new Date($("#startMonth").value+"-01T12:00:00"),monthsPerTerm=12/periods,finish=new Date(startDate);finish.setMonth(finish.getMonth()+Math.max(0,terms-1)*monthsPerTerm+4);$("#progressText").textContent=progress+"% completado";$("#remaining").textContent=remaining+" materias";$("#semesters").textContent=terms+" "+(periods===2?"semestres":"períodos");$("#finish").textContent=remaining?finish.toLocaleDateString("es-AR",{month:"short",year:"numeric"}):"Ya completaste";$("#progressBar").style.width=progress+"%";$("#profileLabel").textContent={university:"Universitaria",tertiary:"Terciario",course:"Curso"}[currentProfile];$("#note").textContent=current?`Las ${current} materias que cursás todavía no se cuentan como aprobadas en el progreso.`:"El progreso considera únicamente materias ya aprobadas."}
$$(".calc input").forEach(x=>x.oninput=calc);const profiles={university:[40,21,3,4,2],tertiary:[28,13,4,5,2],course:[12,5,2,2,4]};$$(".profile").forEach(b=>b.onclick=()=>{currentProfile=b.dataset.profile;$$(".profile").forEach(x=>x.classList.toggle("active",x===b));const v=profiles[currentProfile],ids=["totalSubjects","passed","current","pace","periods"];ids.forEach((id,i)=>$("#"+id).value=v[i]);calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Progreso actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".methodBtn").forEach(b=>b.onclick=()=>{$$(".methodBtn").forEach(x=>x.classList.toggle("active",x===b));toast("Criterio seleccionado: "+b.dataset.step)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
<style is:global>

