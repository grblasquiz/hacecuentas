.mockup-estudio-home .calc{background:#fff;border:1px solid var(--line);border-radius:25px;padding:25px;box-shadow:var(--shadow)}.mockup-estudio-home .calcHead{display:flex;justify-content:space-between;gap:14px}.mockup-estudio-home .calc h2{font-size:24px;letter-spacing:-.035em;margin:0}.mockup-estudio-home .calcHead p{font-size:12px;color:var(--muted);margin:5px 0 0}.mockup-estudio-home .live{background:var(--soft);color:#31679d;padding:7px 9px;border-radius:99px;font-size:9px;font-weight:950;height:max-content}.mockup-estudio-home .profiles{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:17px 0 13px}.mockup-estudio-home .profile{border:1px solid var(--line);background:#fbfcfd;border-radius:10px;padding:10px 4px;font-size:9px;font-weight:900;color:var(--muted);cursor:pointer}.mockup-estudio-home .profile.active{background:var(--soft);border-color:#82a6ca;color:#306497}.mockup-estudio-home .fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mockup-estudio-home .field label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:900;margin-bottom:5px}.mockup-estudio-home .input{height:44px;width:100%;border:1px solid #d8dfe6;border-radius:10px;padding:0 10px;background:#fff;display:flex;align-items:center;gap:7px}.mockup-estudio-home .input input{border:0;outline:0;width:100%;min-width:0;font-weight:850;color:var(--ink)}.mockup-estudio-home .primary{height:49px;width:100%;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:12px;cursor:pointer}.mockup-estudio-home .result{margin-top:13px;background:var(--navy);color:#fff;border-radius:18px;padding:18px}.mockup-estudio-home .resultTop{display:flex;justify-content:space-between;align-items:end;gap:10px}.mockup-estudio-home .result small{font-size:8px;letter-spacing:.09em;color:#becdd9}.mockup-estudio-home .amount{font-size:37px;font-weight:950;letter-spacing:-.05em;margin:3px 0}.mockup-estudio-home .badge{background:#ffffff14;border:1px solid #ffffff1c;padding:8px 10px;border-radius:99px;font-size:9px;font-weight:900}.mockup-estudio-home .resultGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.mockup-estudio-home .metric{background:#ffffff0c;border:1px solid #ffffff14;border-radius:9px;padding:9px}.mockup-estudio-home .metric span{font-size:7px;color:#becdd9;display:block}.mockup-estudio-home .metric b{font-size:10px}.mockup-estudio-home .progress{height:9px;border-radius:9px;background:#ffffff17;margin-top:12px;overflow:hidden}.mockup-estudio-home .progress i{display:block;height:100%;width:50%;background:var(--yellow);border-radius:9px;transition:.3s}.mockup-estudio-home .note{font-size:9px;color:#c4d1da;margin:9px 0 0}
