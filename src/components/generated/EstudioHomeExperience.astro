@media(max-width:900px){.mockup-estudio-home .links{display:none}.mockup-estudio-home .heroGrid,.mockup-estudio-home .methodGrid{grid-template-columns:1fr}.mockup-estudio-home .needs{grid-template-columns:repeat(3,1fr)}.mockup-estudio-home .cards{grid-template-columns:1fr 1fr}.mockup-estudio-home .card.featured{grid-column:1/-1}}@media(max-width:600px){.mockup-estudio-home .wrap{width:calc(100% - 24px)}.mockup-estudio-home h1{font-size:42px}.mockup-estudio-home .profiles,.mockup-estudio-home .fields,.mockup-estudio-home .resultGrid,.mockup-estudio-home .needs,.mockup-estudio-home .cards{grid-template-columns:1fr}.mockup-estudio-home .card.featured{grid-column:auto}.mockup-estudio-home .toolbar{flex-direction:column}.mockup-estudio-home .search{width:100%}.mockup-estudio-home .actions .sm:first-child{display:none}.mockup-estudio-home .scene{transform:scale(.82);transform-origin:left}}

.mockup-estudio-home{width:100%;overflow:hidden}
/* Keep the legacy site's global typography palette from overriding text that
   intentionally inherits a light color inside dark mockup surfaces. */
