-size:10px;font-weight:850;cursor:pointer}
.mockup-validar-nit-colombia .result{background:var(--navy);color:#fff;border-radius:16px;padding:20px;margin-top:14px}.mockup-validar-nit-colombia .result.ok{background:linear-gradient(135deg,#183e49,#176a5b)}.mockup-validar-nit-colombia .result.bad{background:linear-gradient(135deg,#522d39,#813c48)}.mockup-validar-nit-colombia .result-top{display:flex;justify-content:space-between;align-items:start}.mockup-validar-nit-colombia .result small{font-size:9px;color:#c0d1da}.mockup-validar-nit-colombia .result-value{font-size:34px;letter-spacing:.04em;font-weight:900;margin-top:5px}.mockup-validar-nit-colombia .status{background:#ffffff17;border:1px solid #ffffff20;border-radius:10px;padding:9px 11px;text-align:right}.mockup-validar-nit-colombia .status small{display:block}.mockup-validar-nit-colombia .status b{font-size:13px}.mockup-validar-nit-colombia .result-note{font-size:10px;color:#d1dde2;line-height:1.5;border-top:1px solid #ffffff24;margin-top:14px;padding-top:12px}.mockup-validar-nit-colombia .result-actions{display:flex;gap:8px;margin-top:13px}.mockup-validar-nit-colombia .result-actions button{flex:1;border:1px solid #ffffff25;background:#ffffff10;color:#fff;border-radius:9px;padding:10px;font-size:9px;font-weight:850;cursor:pointer}
