---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-validar-nit-colombia" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>Colombia</b> / Validar NIT</div><div class="grid"><div><div class="eyebrow">Algoritmo oficial DIAN</div><h1>Validá un NIT antes de facturar.</h1><p class="lead">Calculá el dígito de verificación o comprobá un NIT completo. Detectá errores de digitación en un segundo, sin enviar el número a ningún servidor.</p><div class="chips"><span>✓ Módulo 11</span><span>✓ Funciona con puntos y guion</span><span>🔒 100% en tu navegador</span></div><article class="sample-card"><div class="sample-top"><b>Ejemplo válido</b><span>DV correcto</span></div><strong>890.903.938-8</strong><small>El último número es el dígito de verificación.</small><div class="sample-digits"><i>8</i><i>9</i><i>0</i><i>9</i><i>0</i><i>3</i><i>9</i><i>3</i><i>8</i><i>DV 8</i></div></article></div>
<section class="validator"><div class="val-head"><div><h2>Validar o calcular NIT</h2><p>Elegí qué dato tenés.</p></div><span class="tag">Gratis e ilimitado</span></div><div class="label">¿Qué querés hacer?</div><div class="modes"><button class="mode active" data-mode="validate">Validar NIT completo</button><button class="mode" data-mode="calculate">Calcular el DV</button></div><div class="label" id="input-label">NIT con dígito de verificación</div><div class="input-shell"><span>▣</span><input id="nit" autocomplete="off" inputmode="numeric" value="890.903.938-8" maxlength="20"></div><p class="help" id="help">Podés escribirlo con o sin puntos. Incluí el dígito después del guion.</p><div class="actions"><button class="validate" id="validate">Validar NIT</button><button class="clear" id="clear">Limpiar</button></div>
<div class="result ok" id="result"><div class="result-top"><div><small id="result-label">NIT BIEN FORMADO</small><div class="result-value" id="complete">890.903.938-8</div></div><div class="status"><small>Dígito verificador</small><b id="dv">8 · coincide</b></div></div><div class="result-note" id="note">La suma ponderada es 1081; su residuo módulo 11 es 3. Como es mayor que 1, el DV es 11 − 3 = 8.</div><div class="result-actions"><button id="copy">Copiar NIT</button><button id="example">Probar otro ejemplo</button></div></div></section></div></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Qué valida exactamente</span><h2>Un chequeo matemático en cuatro pasos</h2><p>El algoritmo confirma que el dígito después del guion corresponde al número base.</p></header><div class="steps"><article class="step"><i>1</i><h3>Limpiamos el número</h3><p>Quitamos puntos, espacios y guiones para trabajar solo con dígitos.</p></article><article class="step"><i>2</i><h3>Aplicamos los pesos</h3><p>Multiplicamos de derecha a izquierda por 3, 7, 13, 17, 19, 23…</p></article><article class="step"><i>3</i><h3>Calculamos módulo 11</h3><p>Sumamos todos los productos y obtenemos el residuo de dividir por 11.</p></article><article class="step"><i>4</i><h3>Comparamos el DV</h3><p>Si el dígito ingresado coincide con el calculado, el formato es válido.</p></article></div></div></section>
<section class="section tint"><div class="wrap math-grid"><article class="card"><h3>El cálculo del ejemplo</h3><div class="digits-row"><span>8×41</span><span>9×37</span><span>0×29</span><span>9×23</span><span>0×19</span><span>3×17</span><span>9×13</span><span>3×7</span><span>8×3</span></div><div class="math-line"><span>Suma ponderada</span><b>1081</b></div><div class="math-line"><span>Residuo de 1081 ÷ 11</span><b>3</b></div><div class="math-line"><span>Regla aplicada</span><b>11 − 3</b></div><div class="math-line total"><strong>Dígito de verificación</strong><b>8</b></div></article><article class="card"><h3>Importante: formato no es existencia</h3><div class="rule"><i>✓</i><div><b>Esta herramienta confirma</b><span>Que el número y su dígito verificador son matemáticamente coherentes.</span></div></div><div class="rule"><i>×</i><div><b>No confirma</b><span>Razón social, actividad económica, responsabilidades ni estado del contribuyente.</span></div></div><div class="rule"><i>↗</i><div><b>Para eso, consultá la DIAN</b><span>El RUT oficial es la fuente para verificar existencia y estado.</span></div></div><div class="warning">Un NIT puede estar bien formado y no corresponder a una empresa activa. Antes de contratar o facturar, contrastalo con el RUT.</div></article></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Tres datos diferentes</span><h2>NIT, RUT y cédula no son lo mismo</h2></header><div class="compare"><article><i>▣</i><h3>NIT</h3><p>Es tu número de identificación tributaria: número base más dígito de verificación.</p><b>Lo asigna la DIAN</b></article><article><i>📄</i><h3>RUT</h3><p>Es el registro y documento que contiene el NIT, responsabilidades y actividad económica.</p><b>Lo administra la DIAN</b></article><article><i>🪪</i><h3>Cédula</h3><p>Identifica a la persona como ciudadano. Para personas naturales suele ser la base del NIT.</p><b>La emite la Registraduría</b></article></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-validar-nit-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-validar-nit-colombia');

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],W=[71,67,59,53,47,43,41,37,29,23,19,17,13,7,3];let mode="validate",exampleIndex=0;const examples=["900123456-8","860002964-4","830092718-4"];
function compute(base){const padded=base.padStart(15,"0").slice(-15),sum=[...padded].reduce((a,d,i)=>a+Number(d)*W[i],0),mod=sum%11,dv=mod===0||mod===1?mod:11-mod;return{sum,mod,dv}}
function format(base,dv){const rev=[...base].reverse().join("").match(/.{1,3}/g).join(".");return [...rev].reverse().join("")+"-"+dv}
function show(){const raw=$("#nit").value.replace(/\D/g,"");if(!raw){$("#result").className="result bad";$("#result-label").textContent="FALTA EL NÚMERO";$("#complete").textContent="Ingresá un NIT";$("#dv").textContent="—";$("#note").textContent="Escribí al menos un dígito para poder calcular.";return}let base,supplied=null;if(mode==="validate"){if(raw.length<2){$("#result").className="result bad";$("#result-label").textContent="NIT INCOMPLETO";$("#complete").textContent=raw;$("#dv").textContent="Falta DV";$("#note").textContent="En modo validación, el último dígito se interpreta como DV.";return}base=raw.slice(0,-1);supplied=+raw.at(-1)}else base=raw;const r=compute(base),ok=supplied===null||supplied===r.dv;$("#result").className="result "+(ok?"ok":"bad");$("#result-label").textContent=supplied===null?"DÍGITO DE VERIFICACIÓN CALCULADO":ok?"NIT BIEN FORMADO":"EL DÍGITO NO COINCIDE";$("#complete").textContent=format(base,r.dv);$("#dv").textContent=supplied===null?String(r.dv):ok?`${r.dv} · coincide`:`Ingresaste ${supplied} · debe ser ${r.dv}`;$("#note").textContent=`La suma ponderada es ${r.sum}; su residuo módulo 11 es ${r.mod}. ${r.mod<=1?`El DV es el mismo residuo: ${r.dv}.`:`Como es mayor que 1, el DV es 11 − ${r.mod} = ${r.dv}.`}`}
function setMode(m){mode=m;$$(".mode").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$("#input-label").textContent=m==="validate"?"NIT con dígito de verificación":"NIT o cédula sin dígito de verificación";$("#help").textContent=m==="validate"?"Podés escribirlo con o sin puntos. Incluí el dígito después del guion.":"Ingresá solo el número base; calculamos y agregamos el DV.";$("#validate").textContent=m==="validate"?"Validar NIT":"Calcular dígito";show()}$$(".mode").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$("#validate").onclick=e=>{show();e.currentTarget.textContent=mode==="validate"?"✓ NIT validado":"✓ Dígito calculado";setTimeout(()=>e.currentTarget.textContent=mode==="validate"?"Validar NIT":"Calcular dígito",1200)};$("#nit").oninput=show;$("#clear").onclick=()=>{$("#nit").value="";show();$("#nit").focus()};$("#copy").onclick=async e=>{try{await navigator.clipboard.writeText($("#complete").textContent)}catch{}e.currentTarget.textContent="✓ Copiado";setTimeout(()=>e.currentTarget.textContent="Copiar NIT",1200)};$("#example").onclick=()=>{$("#nit").value=examples[exampleIndex++%examples.length];setMode("validate")};show();

})();
</script>
<style is:global>

