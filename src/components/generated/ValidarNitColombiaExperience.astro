.mockup-validar-nit-colombia .compare{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-validar-nit-colombia .compare article{border:1px solid var(--line);border-radius:17px;padding:20px}.mockup-validar-nit-colombia .compare i{font-style:normal;width:36px;height:36px;border-radius:10px;background:var(--mint);display:grid;place-items:center}.mockup-validar-nit-colombia .compare h3{font-size:16px;margin:14px 0 6px}.mockup-validar-nit-colombia .compare p{font-size:10px;color:var(--muted);line-height:1.5;margin:0}.mockup-validar-nit-colombia .compare b{display:block;color:var(--green);font-size:9px;margin-top:11px}
