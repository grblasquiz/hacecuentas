---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-rentabilidad-alquiler" set:html={`<div class="crumb">Vivienda / Rentabilidad de un alquiler</div><section class="mast"><h1>Del alquiler publicado a lo que realmente te queda.</h1><p>Un estado de resultados anual que separa renta bruta, meses vacíos, costos y capital inmovilizado.</p></section>
<section class="ledger"><aside class="inputs"><h2>Supuestos de la propiedad</h2>
<div class="field"><label>Valor del inmueble <span>misma moneda</span></label><input id="price" type="number" value="120000" min="0"></div>
<div class="field"><label>Gastos iniciales <span>compra + arreglos</span></label><input id="initial" type="number" value="10000" min="0"></div>
<div class="field"><label>Alquiler mensual</label><input id="rent" type="number" value="650" min="0"></div>
<div class="field"><label>Costos mensuales del dueño</label><input id="monthly" type="number" value="55" min="0"></div>
<div class="field"><label>Mantenimiento anual</label><input id="maintenance" type="number" value="750" min="0"></div>
<div class="field"><label>Impuestos y seguro anual</label><input id="taxes" type="number" value="520" min="0"></div>
<div class="field"><label>Administración <span>% de lo cobrado</span></label><input id="admin" type="number" value="0" min="0" max="100"></div>
<button id="calculate">Recalcular estado</button></aside>
<div class="statement"><div class="statement-head"><div><small style="color:var(--muted)">ESTADO ANUAL DEL ALQUILER</small><h2>Resultado operativo</h2></div><div class="yield"><span>Rentabilidad neta</span><strong id="netYield">—</strong></div></div>
<div class="row"><span>Alquiler potencial · 12 meses</span><b id="potential">—</b></div>
<div class="row minus"><span>Vacancia seleccionada</span><b id="vacancyLoss">—</b></div>
<div class="row minus"><span>Gastos recurrentes</span><b id="recurring">—</b></div>
<div class="row minus"><span>Mantenimiento, impuestos y administración</span><b id="otherCosts">—</b></div>
<div class="row total"><span>Ingreso neto anual</span><b id="netIncome">—</b></div>
<div class="grossnet"><div class="meter"><span>Rendimiento bruto</span><strong id="gross">—</strong><div class="track"><i id="grossBar"></i></div></div><div class="meter"><span>Recupero simple</span><strong id="payback">—</strong><div class="track"><i id="netBar"></i></div></div></div>
<div class="occupancy"><h3>Marcá los meses en los que esperás no cobrar</h3><div class="months" id="months"></div><div class="legend"><span><i></i>Cobrado</span><span><i class="e"></i>Vacío</span></div></div>
<p class="note" id="note">La cuenta mide renta. No incluye revalorización del inmueble, financiación ni impuestos personales.</p></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-rentabilidad-alquiler')?document.currentScript.previousElementSibling:document.querySelector('.mockup-rentabilidad-alquiler');

(()=>{const $=id=>root.querySelector("#"+id),names=["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"];let empty=new Set([1]);$("months").innerHTML=names.map((n,i)=>`<button class="month ${empty.has(i)?"empty":""}" data-month="${i}">${n}</button>`).join("");const num=id=>Math.max(0,+$(id).value||0),money=v=>Math.round(v).toLocaleString("es-AR"),pct=v=>`${v.toLocaleString("es-AR",{maximumFractionDigits:2})}%`;function run(){const price=num("price"),initial=num("initial"),rent=num("rent"),monthly=num("monthly"),maint=num("maintenance"),tax=num("taxes"),admin=num("admin"),investment=price+initial,potential=rent*12,lost=rent*empty.size,collected=potential-lost,rec=monthly*12,other=maint+tax+collected*admin/100,net=Math.max(0,collected-rec-other),gross=price?potential/price*100:0,ny=investment?net/investment*100:0;$("potential").textContent=money(potential);$("vacancyLoss").textContent=`− ${money(lost)}`;$("recurring").textContent=`− ${money(rec)}`;$("otherCosts").textContent=`− ${money(other)}`;$("netIncome").textContent=money(net);$("gross").textContent=pct(gross);$("netYield").textContent=pct(ny);$("payback").textContent=net?`${(investment/net).toLocaleString("es-AR",{maximumFractionDigits:1})} años`:"Sin recupero";$("grossBar").style.width=`${Math.min(100,gross*10)}%`;$("netBar").style.width=`${Math.min(100,ny*10)}%`;$("note").textContent=empty.size>2?`La vacancia de ${empty.size} meses está reduciendo fuerte el resultado. Probá el punto de equilibrio antes de decidir.`:"La cuenta mide renta. No incluye revalorización del inmueble, financiación ni impuestos personales."}root.querySelectorAll(".month").forEach(b=>b.onclick=()=>{const i=+b.dataset.month;empty.has(i)?empty.delete(i):empty.add(i);b.classList.toggle("empty");run()});root.querySelectorAll("input").forEach(x=>x.addEventListener("input",run));$("calculate").onclick=run;run()})();

})();
</script>
<style is:global>

.mockup-rentabilidad-alquiler{--blue:#174b7a;--ink:#172331;--muted:#63717e;--line:#d9e2e5;--mint:#35ad8f;--sand:#fff4dc;--red:#d96e5d}.mockup-rentabilidad-alquiler *{box-sizing:border-box}.mockup-rentabilidad-alquiler{margin:0;background:#f6f8f6;color:var(--ink);font-family:Inter,system-ui,sans-serif}.mockup-rentabilidad-alquiler button,.mockup-rentabilidad-alquiler input{font:inherit}.mockup-rentabilidad-alquiler .shell{max-width:1170px;margin:auto;padding:34px 24px 70px}.mockup-rentabilidad-alquiler .crumb{font-size:13px;color:var(--blue);font-weight:850}.mockup-rentabilidad-alquiler .mast{display:flex;justify-content:space-between;align-items:end;gap:40px;margin:22px 0 34px}.mockup-rentabilidad-alquiler .mast h1{font-size:clamp(38px,6vw,68px);line-height:1;letter-spacing:-.05em;margin:0;max-width:760px}.mockup-rentabilidad-alquiler .mast p{max-width:300px;color:var(--muted);line-height:1.55}.mockup-rentabilidad-alquiler .ledger{display:grid;grid-template-columns:330px 1fr;background:#fff;border:1px solid var(--line);border-radius:24px;overflow:hidden;box-shadow:0 22px 55px #174b7a10}.mockup-rentabilidad-alquiler .inputs{padding:24px;background:#edf5f4}.mockup-rentabilidad-alquiler .inputs h2{font-size:19px;margin:0 0 18px}.mockup-rentabilidad-alquiler .field{margin-bottom:13px}.mockup-rentabilidad-alquiler .field label{display:flex;justify-content:space-between;font-size:11px;font-weight:850;margin-bottom:6px}.mockup-rentabilidad-alquiler .field label span{color:var(--muted);font-weight:600}.mockup-rentabilidad-alquiler .field input{width:100%;height:43px;border:1px solid #c6d3d7;border-radius:10px;padding:0 11px;color:var(--ink);background:#fff}.mockup-rentabilidad-alquiler .inputs button{width:100%;border:0;background:var(--blue);color:#fff;border-radius:11px;padding:12px;font-weight:900;cursor:pointer;margin-top:6px}.mockup-rentabilidad-alquiler .statement{padding:25px 30px}.mockup-rentabilidad-alquiler .statement-head{display:flex;justify-content:space-between;align-items:start;border-bottom:2px solid var(--ink);padding-bottom:15px}.mockup-rentabilidad-alquiler .statement-head h2{margin:0;font-size:24px}.mockup-rentabilidad-alquiler .yield{text-align:right}.mockup-rentabilidad-alquiler .yield span{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:850}.mockup-rentabilidad-alquiler .yield strong{font-size:38px;color:var(--blue)}.mockup-rentabilidad-alquiler .row{display:grid;grid-template-columns:1fr 120px;gap:18px;padding:12px 0;border-bottom:1px solid var(--line);font-size:13px}.mockup-rentabilidad-alquiler .row b{text-align:right}.mockup-rentabilidad-alquiler .row.minus b{color:var(--red)}.mockup-rentabilidad-alquiler .row.total{font-size:16px;border-bottom:2px solid var(--ink);font-weight:900}.mockup-rentabilidad-alquiler .grossnet{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:22px}.mockup-rentabilidad-alquiler .meter{padding:16px;border-radius:15px;background:#f2f6f7}.mockup-rentabilidad-alquiler .meter span{font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:850}.mockup-rentabilidad-alquiler .meter strong{display:block;font-size:26px;margin:5px 0}.mockup-rentabilidad-alquiler .track{height:9px;background:#dbe5e8;border-radius:99px;overflow:hidden}.mockup-rentabilidad-alquiler .track i{display:block;height:100%;background:var(--mint);border-radius:99px}.mockup-rentabilidad-alquiler .occupancy{margin-top:22px}.mockup-rentabilidad-alquiler .occupancy h3{font-size:14px;margin:0 0 12px}.mockup-rentabilidad-alquiler .months{display:grid;grid-template-columns:repeat(12,1fr);gap:6px}.mockup-rentabilidad-alquiler .month{border:0;border-radius:8px;background:#dff2ec;color:#17644f;padding:9px 2px;font-size:10px;font-weight:900;cursor:pointer}.mockup-rentabilidad-alquiler .month.empty{background:var(--sand);color:#835f1a}.mockup-rentabilidad-alquiler .note{margin-top:18px;font-size:11px;color:var(--muted);line-height:1.5}.mockup-rentabilidad-alquiler .legend{display:flex;gap:16px;margin-top:8px;font-size:10px;color:var(--muted)}.mockup-rentabilidad-alquiler .legend i{display:inline-block;width:10px;height:10px;border-radius:3px;background:#dff2ec;margin-right:4px}.mockup-rentabilidad-alquiler .legend .e{background:var(--sand)}@media(max-width:850px){.mockup-rentabilidad-alquiler .ledger{grid-template-columns:1fr}.mockup-rentabilidad-alquiler .mast{display:block}.mockup-rentabilidad-alquiler .mast p{max-width:650px}.mockup-rentabilidad-alquiler .grossnet{grid-template-columns:1fr}}@media(max-width:520px){.mockup-rentabilidad-alquiler .shell{padding:24px 14px}.mockup-rentabilidad-alquiler .statement{padding:20px 16px}.mockup-rentabilidad-alquiler .months{grid-template-columns:repeat(6,1fr)}}

.mockup-rentabilidad-alquiler { width:100%; overflow:hidden; }
.mockup-rentabilidad-alquiler .top, .mockup-rentabilidad-alquiler header.top { display:none !important; }
.mockup-rentabilidad-alquiler .foot { display:none !important; }
.mockup-rentabilidad-alquiler .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-rentabilidad-alquiler .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-rentabilidad-alquiler .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-rentabilidad-alquiler .support-real summary { cursor:pointer; font-weight:750; }
.mockup-rentabilidad-alquiler .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-rentabilidad-alquiler :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-rentabilidad-alquiler input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-rentabilidad-alquiler input[type="number"]::-webkit-inner-spin-button, .mockup-rentabilidad-alquiler input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-rentabilidad-alquiler .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-rentabilidad-alquiler support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
