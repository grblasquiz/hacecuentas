<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">La boleta tiene una historia</span><h2>Separá lo que podés bajar de lo que es fijo.</h2><p>Consumo, tarifa, cargo fijo e impuestos explican aumentos distintos y requieren decisiones diferentes.</p></div><div class="compare"><div><small>CONSUMO</small><b id="cmp1">$38.750</b><span>Lo que sí controlás</span></div><div><small>CARGOS FIJOS</small><b id="cmp2">$4.200</b><span>Se pagan igual</span></div><div><small>IMPUESTOS</small><b id="cmp3">$8.161</b><span>IVA incluido</span></div></div></div></section><div class="foot"></div><button type="button" id="date-result" hidden aria-hidden="true"></button><button type="button" id="progress-result" hidden aria-hidden="true"></button><button type="button" id="fund-result" hidden aria-hidden="true"></button><button type="button" id="art-consumption" hidden aria-hidden="true"></button><button type="button" id="art-cost" hidden aria-hidden="true"></button><button type="button" id="scale-verdict" hidden aria-hidden="true"></button><button type="button" id="detail-last" hidden aria-hidden="true"></button><button type="button" id="detail-interval" hidden aria-hidden="true"></button><button type="button" id="detail-used" hidden aria-hidden="true"></button><button type="button" id="detail-next" hidden aria-hidden="true"></button><button type="button" id="detail-left" hidden aria-hidden="true"></button><button type="button" id="cmp-low" hidden aria-hidden="true"></button><button type="button" id="cmp-current" hidden aria-hidden="true"></button><button type="button" id="cmp-high" hidden aria-hidden="true"></button><button type="button" id="cmp-current-cost" hidden aria-hidden="true"></button><button type="button" id="province" hidden aria-hidden="true"></button><button type="button" id="rate" hidden aria-hidden="true"></button><button type="button" id="quota-value" hidden aria-hidden="true"></button><button type="button" id="cash-value" hidden aria-hidden="true"></button><button type="button" id="month-value" hidden aria-hidden="true"></button><button type="button" id="d-valuation" hidden aria-hidden="true"></button><button type="button" id="d-rate" hidden aria-hidden="true"></button><button type="button" id="d-year" hidden aria-hidden="true"></button><button type="button" id="d-discount" hidden aria-hidden="true"></button><button type="button" id="d-final" hidden aria-hidden="true"></button><button type="button" id="cmp-name" hidden aria-hidden="true"></button><button type="button" id="digits" hidden aria-hidden="true"></button><button type="button" id="cl-search" hidden aria-hidden="true"></button><button type="button" id="no-results" hidden aria-hidden="true"></button><button type="button" id="cl-search-btn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-cuentas-casa-chile')?document.currentScript.previousElementSibling:document.querySelector('.mockup-cuentas-casa-chile');


let billMode="light";const b$=s=>root.querySelector(s),bn=id=>Math.max(0,Number(b$(id).value)||0),bm=x=>"$"+new Intl.NumberFormat("es-CL",{maximumFractionDigits:0}).format(x);const billCases={light:{labels:["Consumo del mes","Precio unitario sin IVA","Cargo fijo sin IVA"],units:["kWh","/kWh",""],vals:[250,155,4200],formula:"Consumo × tarifa + cargo fijo + IVA 19%"},gas:{labels:["Consumo mensual","Precio por m³ sin IVA","Cargo fijo sin IVA"],units:["m³","/m³",""],vals:[30,600,15200],formula:"Consumo × tarifa + cargo fijo + IVA 19%"},internet:{labels:["Precio mensual normal","Velocidad contratada","Meses de permanencia"],units:["CLP","Mbps","meses"],vals:[19990,600,12],formula:"Precio mensual × meses de permanencia"},cut:{labels:["Horas sin suministro","Monto última boleta","Tramo RSH"],units:["horas","CLP","%"],vals:[8,45000,40],formula:"Compensación orientativa según duración y gasto diario"}};
function setBill(m){billMode=m;let x=billCases[m];["1","2","3"].forEach((k,i)=>{b$("#l"+k).textContent=x.labels[i];b$("#u"+k).textContent=x.units[i];b$("#v"+k).value=x.vals[i]});b$("#pre2").textContent=m==="light"||m==="gas"?"$":"";b$("#pre3").textContent=m==="light"||m==="gas"?"$":"";b$("#formula-note").textContent=x.formula;billCalc()}
function billCalc(){let a=bn("#v1"),b=bn("#v2"),c=bn("#v3"),disc=bn("#discount")/100,people=Math.max(1,bn("#people")),base,fix,tax,total,label,read;if(billMode==="light"||billMode==="gas"){base=a*b;fix=c;tax=(base+fix)*.19;total=(base+fix+tax)*(1-disc);label=billMode==="light"?"Total estimado de la luz":"Total estimado del gas";read=a>(billMode==="light"?300:45)?"Consumo alto":"Consumo habitual"}else if(billMode==="internet"){base=a*c;fix=0;tax=0;total=base*(1-disc);label="Costo total del contrato";read=b>=600?"Buen costo por Mbps":"Compará velocidad"}else{base=b/30*a;fix=0;tax=0;total=base*.5;label="Compensación orientativa";read=c<=40?"Revisá subsidio":"Revisá tu boleta"}b$("#result-label").textContent=label;b$("#result-value").textContent=bm(total);b$("#verdict").textContent=read;b$("#s1").textContent=bm(base);b$("#s2").textContent=billMode==="internet"?bm(a/Math.max(1,b))+"/Mbps":bm(tax);b$("#s3").textContent=bm(total/people);b$("#art-value").textContent=bm(total);b$("#art-place").textContent=billCases[billMode].formula;b$("#pin").style.left=Math.max(4,Math.min(96,billMode==="light"?a/500*100:billMode==="gas"?a/70*100:50))+"%";b$("#pin").dataset.value=a;b$("#scale-copy").textContent=billCases[billMode].formula;b$("#scale-result").textContent=label+": "+bm(total);b$("#d1").textContent=a+" "+billCases[billMode].units[0];b$("#d2").textContent=bm(base);b$("#d3").textContent=bm(fix);b$("#d4").textContent=bm(tax);b$("#df-label").textContent=label;b$("#df").textContent=bm(total);b$("#cmp1").textContent=bm(base);b$("#cmp2").textContent=bm(fix);b$("#cmp3").textContent=bm(tax)}
root.querySelectorAll(".case").forEach(x=>x.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(y=>y.classList.remove("active"));x.classList.add("active");setBill(x.dataset.mode)}));root.querySelectorAll("input").forEach(x=>x.addEventListener("input",billCalc));b$("#advanced-toggle").addEventListener("click",e=>{b$("#extra-fields").classList.toggle("open");e.currentTarget.textContent=b$("#extra-fields").classList.contains("open")?"− Ocultar beneficio":"+ Agregar beneficio"});b$("#update").addEventListener("click",e=>{e.preventDefault();billCalc();e.currentTarget.textContent="✓ Cuenta actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar cuenta",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());billCalc();

})();
</script>
