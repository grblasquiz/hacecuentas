---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-pintura" set:html={`
    <div class="wrap">
      <div class="hero"><div><div class="crumb">Construcción / Pintura</div><div class="eyebrow">Comprá lo justo, sin quedarte corto</div><h1>De las medidas a las latas que necesitás.</h1><p class="lead">Calculá superficie, manos, rendimiento y margen. Te decimos cuántos litros comprar y cuánto te va a sobrar.</p><div class="chips"><span class="chip">✓ Descuenta aberturas</span><span class="chip">✓ Suma techo</span><span class="chip">✓ Arma la compra en latas</span></div></div><div class="visual"><div class="wall"><div class="painted"></div><div class="roller"></div></div><div class="bucket">20 L</div><div class="swatch s1"></div><div class="swatch s2"></div><div class="note n1">2 manos + 10%</div><div class="note n2">Litros → latas reales</div></div></div>
      <form class="calc" id="calculator"><div class="case-label">¿QUÉ VAS A PINTAR?</div><div class="cases"><button type="button" class="case active" data-mode="interior">Paredes interiores</button><button type="button" class="case" data-mode="exterior">Frente o exterior</button><button type="button" class="case" data-mode="wood">Madera</button><button type="button" class="case" data-mode="metal">Rejas y metal</button></div>
        <div class="grid"><div class="panel"><h2 id="formTitle">Medí el ambiente</h2><p class="hint" id="formHint">Usá el perímetro total de las paredes, no sólo el largo de una.</p>
          <div class="fields"><div class="field"><label for="length" id="lengthLabel">Perímetro a pintar (m)</label><input class="control" id="length" type="number" value="14" min="0" step=".1"></div><div class="field"><label for="height">Altura (m)</label><input class="control" id="height" type="number" value="2.6" min="0" step=".1"></div></div>
          <div class="fields mode-only active" data-only="wall"><div class="field"><label for="doors">Puertas</label><input class="control" id="doors" type="number" value="1" min="0"></div><div class="field"><label for="windows">Ventanas</label><input class="control" id="windows" type="number" value="2" min="0"></div><div class="field"><label for="ceiling">¿También el techo?</label><select class="control" id="ceiling"><option value="no">No, sólo paredes</option><option value="yes">Sí, sumar techo</option></select></div><div class="field"><label for="ceilingArea">Superficie del techo (m²)</label><input class="control" id="ceilingArea" type="number" value="12" min="0" step=".1"></div></div>
          <div class="fields mode-only" data-only="wood"><div class="field full"><label for="porosity">Porosidad de la madera</label><select class="control" id="porosity"><option value="1.1">Baja — madera dura y sellada</option><option value="1.25" selected>Media — pino tratado</option><option value="1.45">Alta — madera nueva o porosa</option></select></div></div>
          <div class="fields mode-only" data-only="metal"><div class="field full"><label for="metalType">Tipo de reja</label><select class="control" id="metalType"><option value="1.6">Barrotes</option><option value="2.2">Tejido romboidal o malla</option><option value="2">Portón de chapa</option></select></div></div>
          <div class="fields"><div class="field"><label for="coats">Manos o capas</label><input class="control" id="coats" type="number" value="2" min="1" max="6"></div><div class="field"><label for="price">Precio por litro ($)</label><input class="control" id="price" inputmode="numeric" value="9.500"></div></div>
          <button class="update" id="updateButton" type="submit">Actualizar cálculo</button>
        </div>
        <div class="panel result"><div class="kicker">COMPRA RECOMENDADA</div><div class="big" id="resultValue">2 latas de 4 L</div><div class="sub" id="resultSub">7,3 L necesarios para 32,6 m² netos</div><div class="badge" id="resultBadge">Incluye 10% para retoques</div><div class="tiles"><div class="tile"><small>Litros necesarios</small><strong id="litersTile">6,0 L</strong></div><div class="tile"><small>Te sobran</small><strong id="leftTile">2,0 L</strong></div><div class="tile"><small>Costo estimado</small><strong id="costTile">$76.000</strong></div></div></div></div>
      </form>
    </div>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Tu pedido, claro</div><h2>De litros teóricos a envases reales</h2><p>Lo que llevás de la pinturería son latas completas. El sobrante queda visible.</p></div><div class="purchase"><div class="purchase-head"><div><h3 id="purchaseTitle">Paredes interiores</h3><p id="purchaseSub">Látex interior · rendimiento 12 m²/L</p></div><div class="purchase-total" id="purchaseTotal">$76.000</div></div><div class="bars"><div class="bar-row"><span>Litros sin margen</span><div class="track"><div class="fill f-blue" id="barNet"></div></div><strong id="barNetVal"></strong></div><div class="bar-row"><span>Litros con 10%</span><div class="track"><div class="fill f-mint" id="barNeed"></div></div><strong id="barNeedVal"></strong></div><div class="bar-row"><span>Litros comprados</span><div class="track"><div class="fill f-yellow" id="barBuy"></div></div><strong id="barBuyVal"></strong></div></div></div></div></section>
    <section><div class="wrap two"><div class="info"><div class="eyebrow">Cálculo transparente</div><h3>Superficie y consumo</h3><div class="rows" id="breakRows"></div></div><div class="info notice"><div class="notice-icon">◉</div><h3>El rendimiento de la lata es una referencia</h3><p>Una pared áspera, nueva o muy porosa puede consumir hasta 20% más. El margen ayuda, pero el fijador se calcula como otro producto.</p><div class="rows"><div class="row"><span>Cambio oscuro → claro</span><strong>Usá 3 manos</strong></div><div class="row"><span>Pared nueva</span><strong>Fijador primero</strong></div></div></div></div></section>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Rendimientos de referencia</div><h2>No todos los productos cubren igual</h2></div><div class="refs"><div class="ref"><div class="ref-icon">🏠</div><b>12 m²/L</b><span>Látex interior por mano</span></div><div class="ref"><div class="ref-icon">🌦️</div><b>10 m²/L</b><span>Látex exterior por mano</span></div><div class="ref"><div class="ref-icon">🪵</div><b>8–11 m²/L</b><span>Barniz según porosidad</span></div><div class="ref"><div class="ref-icon">🚧</div><b>12 m²/L</b><span>Esmalte para metal</span></div></div></div></section>
    <div class="dark"><div class="wrap dark-grid"><div class="formula">Superficie × manos<span>÷ rendimiento × 1,10</span>= litros a comprar<small>Después se redondea a presentaciones reales de 20 L, 4 L o 1 L.</small></div><div><div class="eyebrow" style="color:#6ad4c3">Antes de pintar</div><h2>Medir bien evita una segunda visita a la pinturería.</h2><p>Descontá aberturas grandes, sumá el techo sólo si corresponde y guardá el sobrante del mismo lote para retoques.</p><div class="checks"><div class="check"><span class="tick">✓</span><span>Dos manos sobre colores similares; tres para cambios exigentes.</span></div><div class="check"><span class="tick">✓</span><span>No pintes exterior si hay lluvia prevista dentro de 24 horas.</span></div><div class="check"><span class="tick">✓</span><span>En metal, el factor ya contempla caras y barrotes.</span></div></div></div></div></div>
  `} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-pintura')?document.currentScript.previousElementSibling:document.querySelector('.mockup-pintura');

    const $=id=>root.querySelector("#"+id),fmt=(n,d=1)=>Number(n).toLocaleString("es-AR",{minimumFractionDigits:d,maximumFractionDigits:d}),money=n=>"$"+Math.round(n).toLocaleString("es-AR"),digits=v=>Number(String(v).replace(/\D/g,""))||0;let mode="interior";
    const cfg={interior:{title:"Medí el ambiente",hint:"Usá el perímetro total de las paredes, no sólo el largo de una.",rend:12,name:"Paredes interiores",product:"Látex interior"},exterior:{title:"Medí el frente o la medianera",hint:"Cargá el largo total y la altura de la superficie exterior.",rend:10,name:"Frente o exterior",product:"Látex exterior"},wood:{title:"Medí la pieza de madera",hint:"Usá largo por alto y elegí cuánto absorbe la madera.",rend:10,name:"Madera",product:"Barniz poliuretánico"},metal:{title:"Medí el frente de la reja",hint:"El tipo de reja convierte el frente aparente en superficie real de metal.",rend:12,name:"Rejas y metal",product:"Esmalte sintético"}};
    function set(id,v){$(id).textContent=v}function rows(a){$("breakRows").innerHTML=a.map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
    function cans(liters){if(mode==="metal"){const one=Math.ceil(liters);return{large:0,small:one,bought:one,text:`${one} lata${one===1?"":"s"} de 1 L`}}let large=Math.floor(liters/20),small=Math.ceil((liters-large*20)/4-1e-9);if(small>=5){large++;small=0}const bought=large*20+small*4,parts=[];if(large)parts.push(`${large} balde${large===1?"":"s"} de 20 L`);if(small)parts.push(`${small} lata${small===1?"":"s"} de 4 L`);return{large,small,bought,text:parts.join(" + ")||"Nada para comprar"}}
    function calculate(){
      const length=Math.max(0,Number($("length").value)||0),height=Math.max(0,Number($("height").value)||0),coats=Math.max(1,Number($("coats").value)||1),price=digits($("price").value),gross=length*height;let area=gross,rend=cfg[mode].rend,discount=0,detail="";
      if(mode==="interior"||mode==="exterior"){discount=Math.max(0,Number($("doors").value)||0)*1.8+Math.max(0,Number($("windows").value)||0)*1.5;const ceil=$("ceiling").value==="yes"?Math.max(0,Number($("ceilingArea").value)||0):0;area=Math.max(0,gross-discount)+ceil;detail=ceil?` + ${fmt(ceil)} m² de techo`:""}
      if(mode==="wood"){const por=Number($("porosity").value)||1.25;rend=12/por}
      if(mode==="metal"){const factor=Number($("metalType").value)||1.6;area=gross*factor;detail=` × factor ${fmt(factor)}`}
      const net=area*coats/rend,need=net*1.10,C=cans(need),left=C.bought-need,cost=C.bought*price,max=Math.max(C.bought,need,net,1);
      set("resultValue",C.text);set("resultSub",`${fmt(need)} L necesarios para ${fmt(area)} m²`);set("resultBadge",mode==="metal"?"Superficie real de metal incluida":"Incluye 10% para retoques");set("litersTile",fmt(need)+" L");set("leftTile",fmt(left)+" L");set("costTile",money(cost));set("purchaseTitle",cfg[mode].name);set("purchaseSub",`${cfg[mode].product} · rendimiento ${fmt(rend)} m²/L`);set("purchaseTotal",money(cost));
      [["barNet",net],["barNeed",need],["barBuy",C.bought]].forEach(x=>$(x[0]).style.width=(x[1]/max*100)+"%");set("barNetVal",fmt(net)+" L");set("barNeedVal",fmt(need)+" L");set("barBuyVal",fmt(C.bought)+" L");
      const base=mode==="metal"?[["Frente aparente",fmt(gross)+" m²"],["Superficie real",fmt(area)+" m²"+detail]]:mode==="wood"?[["Superficie de madera",fmt(area)+" m²"],["Rendimiento ajustado",fmt(rend)+" m²/L"]]:[["Pared bruta",fmt(gross)+" m²"],["Aberturas descontadas","− "+fmt(discount)+" m²"],["Superficie a pintar",fmt(area)+" m²"+detail]];rows(base.concat([["Cantidad de manos",coats],["Consumo sin margen",fmt(net)+" L"],["Margen para retoques",fmt(need-net)+" L"],["Compra recomendada",C.text],["Sobrante",fmt(left)+" L"]]));
    }
    root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".mode-only").forEach(x=>x.classList.toggle("active",(mode==="interior"||mode==="exterior")?x.dataset.only==="wall":x.dataset.only===mode));set("formTitle",cfg[mode].title);set("formHint",cfg[mode].hint);set("lengthLabel",mode==="interior"?"Perímetro a pintar (m)":"Largo de la superficie (m)");calculate()}));
    root.querySelectorAll("input[type=number],select").forEach(x=>x.addEventListener("input",calculate));$("price").addEventListener("input",e=>{const n=digits(e.target.value);e.target.value=n?n.toLocaleString("es-AR"):"";calculate()});
    function confirm(){calculate();$("updateButton").textContent="✓ Cálculo actualizado";clearTimeout(window.paintTimer);window.paintTimer=setTimeout(()=>$("updateButton").textContent="Actualizar cálculo",1200)}$("calculator").addEventListener("submit",e=>{e.preventDefault();confirm()});$("updateButton").addEventListener("click",e=>{e.preventDefault();confirm()});calculate();
  
})();
</script>
<style is:global>

    .mockup-pintura{--ink:#121a31;--muted:#667187;--blue:#2268e7;--coral:#f27c66;--mint:#28b6a4;--yellow:#f5b947;--paper:#f7f6f1;--line:#dfe3e9;--navy:#174B7A}
    .mockup-pintura *{box-sizing:border-box}.mockup-pintura{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-pintura button,.mockup-pintura input,.mockup-pintura select{font:inherit}.mockup-pintura .wrap{width:min(1180px,calc(100% - 40px));margin:auto}
    .mockup-pintura header{height:86px;border-bottom:1px solid #e1e4e6;display:flex;align-items:center}.mockup-pintura .nav{display:flex;align-items:center;gap:28px}.mockup-pintura .brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:900}.mockup-pintura .logo{width:29px;height:38px;border-radius:6px;background:linear-gradient(145deg,#18355c,#527a99);display:grid;place-items:center;color:white}.mockup-pintura .links{display:flex;gap:25px;color:#505b6d;font-size:14px;font-weight:750}.mockup-pintura .tools{margin-left:auto;display:flex;gap:9px}.mockup-pintura .tool{height:42px;padding:0 14px;border:1px solid #dce1e7;background:white;border-radius:11px;color:#526075;font-weight:750}
    .mockup-pintura .hero{display:grid;grid-template-columns:1.08fr .92fr;gap:45px;align-items:center;padding:62px 0 45px}.mockup-pintura .crumb{color:#3167c4;font-size:14px;margin-bottom:17px}.mockup-pintura .eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:#2374b8;font-weight:900}.mockup-pintura h1{font-size:clamp(43px,5vw,67px);line-height:1;letter-spacing:-.05em;margin:13px 0 20px}.mockup-pintura .lead{font-size:19px;color:var(--muted);max-width:680px}.mockup-pintura .chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:25px}.mockup-pintura .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:9px 13px;font-size:13px;font-weight:800}
    .mockup-pintura .visual{height:330px;position:relative}.mockup-pintura .wall{position:absolute;left:35px;top:30px;width:315px;height:250px;background:#f4e8d6;border-radius:22px;box-shadow:0 24px 55px #29334c1b;overflow:hidden}.mockup-pintura .painted{position:absolute;inset:0 44% 0 0;background:linear-gradient(160deg,#5aa7e9,#3a78d8)}.mockup-pintura .painted:after{content:"";position:absolute;right:-14px;top:0;width:28px;height:100%;background:repeating-linear-gradient(#4a8ee0 0 34px,#65aceb 34px 68px);border-radius:12px}.mockup-pintura .roller{position:absolute;right:14px;top:41px;width:105px;height:42px;border:9px solid #17385f;border-radius:12px;background:#f2b447}.mockup-pintura .roller:after{content:"";position:absolute;right:-15px;top:34px;width:10px;height:116px;background:#17385f;transform:rotate(-10deg);border-radius:6px}.mockup-pintura .bucket{position:absolute;right:0;bottom:5px;width:125px;height:105px;background:#fff;border:7px solid #17385f;border-radius:12px 12px 28px 28px;display:grid;place-items:center;font-size:28px;font-weight:950;color:#ef785f}.mockup-pintura .swatch{position:absolute;width:48px;height:48px;border-radius:50%;box-shadow:0 10px 25px #1c355a26}.mockup-pintura .s1{background:#f27c66;right:4px;top:3px}.mockup-pintura .s2{background:#28b6a4;left:2px;bottom:13px}.mockup-pintura .note{position:absolute;background:white;border-radius:13px;padding:11px 14px;font-size:13px;font-weight:850;box-shadow:0 15px 34px #17385f1d}.mockup-pintura .n1{left:0;top:3px}.mockup-pintura .n2{right:2px;bottom:0;color:#1763d5}
    .mockup-pintura .calc{background:white;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:65px}.mockup-pintura .case-label{font-size:13px;font-weight:900;color:#5b677a;margin-bottom:11px}.mockup-pintura .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-bottom:25px}.mockup-pintura .case{border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:14px 9px;font-weight:850;color:#505d70;cursor:pointer}.mockup-pintura .case.active{background:#edf4ff;color:#1c60d2;border-color:#246be7;box-shadow:inset 0 0 0 1px #246be7}.mockup-pintura .grid{display:grid;grid-template-columns:1.04fr .96fr;gap:23px}.mockup-pintura .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-pintura .panel h2{font-size:22px;margin:0 0 5px}.mockup-pintura .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-pintura .fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.mockup-pintura .field.full{grid-column:1/-1}.mockup-pintura .field label{display:block;font-size:13px;font-weight:800;margin-bottom:7px}.mockup-pintura .control{width:100%;height:50px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-pintura .control:focus{border-color:#286fe8;box-shadow:0 0 0 3px #286fe818}.mockup-pintura .mode-only{display:none}.mockup-pintura .mode-only.active{display:grid}.mockup-pintura .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:white;font-weight:900;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
    .mockup-pintura .result{background:linear-gradient(145deg,#102c55,#0b1c38);border:0;color:white;position:relative;overflow:hidden}.mockup-pintura .result:after{content:"";position:absolute;width:210px;height:210px;border:44px solid #4aa8e420;border-radius:50%;right:-115px;bottom:-125px}.mockup-pintura .kicker{font-size:12px;text-transform:uppercase;letter-spacing:.13em;color:#a5ddeb;font-weight:900}.mockup-pintura .big{font-size:39px;line-height:1.08;font-weight:950;letter-spacing:-.04em;margin:14px 0 5px}.mockup-pintura .sub{color:#c3d2e4}.mockup-pintura .badge{display:inline-flex;margin-top:17px;padding:8px 11px;border-radius:99px;background:#1e4777;border:1px solid #3d6591;font-size:12px;font-weight:850}.mockup-pintura .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:24px}.mockup-pintura .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px}.mockup-pintura .tile small{display:block;color:#adc0d6;text-transform:uppercase;font-size:10px;letter-spacing:.07em}.mockup-pintura .tile strong{display:block;margin-top:5px;font-size:15px}
    .mockup-pintura section{padding:52px 0}.mockup-pintura .section-head{text-align:center;max-width:730px;margin:0 auto 30px}.mockup-pintura .section-head h2{font-size:39px;line-height:1.08;letter-spacing:-.04em;margin:8px 0 10px}.mockup-pintura .section-head p{color:var(--muted)}.mockup-pintura .purchase{background:white;border:1px solid var(--line);border-radius:23px;padding:27px}.mockup-pintura .purchase-head{display:flex;justify-content:space-between;align-items:end}.mockup-pintura .purchase-head h3{font-size:23px;margin:0}.mockup-pintura .purchase-head p{margin:4px 0 0;color:var(--muted)}.mockup-pintura .purchase-total{color:#2368d8;font-weight:950}.mockup-pintura .bars{display:grid;gap:14px;margin-top:26px}.mockup-pintura .bar-row{display:grid;grid-template-columns:200px 1fr 90px;gap:15px;align-items:center}.mockup-pintura .track{height:13px;background:#edf0f4;border-radius:99px;overflow:hidden}.mockup-pintura .fill{height:100%;border-radius:99px;transition:width .25s}.mockup-pintura .f-blue{background:#2b70e7}.mockup-pintura .f-mint{background:#28b6a4}.mockup-pintura .f-yellow{background:#f4b84b}.mockup-pintura .bar-row strong{text-align:right}.mockup-pintura .bar-row span{font-size:13px;color:#5f6b7f;font-weight:750}
    .mockup-pintura .two{display:grid;grid-template-columns:1.15fr .85fr;gap:22px}.mockup-pintura .info{background:#fff;border:1px solid var(--line);border-radius:22px;padding:25px}.mockup-pintura .info h3{font-size:22px;margin:0 0 17px}.mockup-pintura .rows{display:grid;gap:12px}.mockup-pintura .row{display:flex;justify-content:space-between;gap:18px;padding-bottom:12px;border-bottom:1px solid #edf0f3}.mockup-pintura .row:last-child{padding:0;border:0}.mockup-pintura .row span{color:#657186}.mockup-pintura .row strong{text-align:right}.mockup-pintura .notice{background:#fff6e8;border-color:#f1d2a0}.mockup-pintura .notice p{color:#725934}.mockup-pintura .notice-icon{font-size:28px}.mockup-pintura .refs{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.mockup-pintura .ref{background:#fff;border:1px solid var(--line);border-radius:19px;padding:20px}.mockup-pintura .ref-icon{font-size:27px}.mockup-pintura .ref b{display:block;font-size:23px;margin:10px 0 3px}.mockup-pintura .ref span{font-size:13px;color:var(--muted)}
    .mockup-pintura .dark{background:#0d1e39;color:white;margin-top:55px;padding:70px 0}.mockup-pintura .dark-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:55px;align-items:center}.mockup-pintura .formula{background:#15305a;border:1px solid #34537c;border-radius:24px;padding:33px;text-align:center;font-size:28px;font-weight:950}.mockup-pintura .formula span{display:block;color:#79d9ca;font-size:18px;margin:11px}.mockup-pintura .formula small{display:block;color:#adbed2;font-size:12px;font-weight:650}.mockup-pintura .dark h2{font-size:40px;line-height:1.08;margin:9px 0}.mockup-pintura .dark p{color:#b8c5d6}.mockup-pintura .checks{display:grid;gap:10px;margin-top:20px}.mockup-pintura .check{display:flex;gap:11px}.mockup-pintura .tick{width:23px;height:23px;border-radius:50%;background:#1ba18e;display:grid;place-items:center;flex:0 0 auto;font-size:12px}.mockup-pintura footer{text-align:center;padding:35px;color:#748095;font-size:13px}
