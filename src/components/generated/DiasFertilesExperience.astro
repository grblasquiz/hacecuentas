.mockup-dias-fertiles .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-dias-fertiles .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-dias-fertiles .support-real summary { cursor:pointer; font-weight:750; }
.mockup-dias-fertiles .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-dias-fertiles :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
