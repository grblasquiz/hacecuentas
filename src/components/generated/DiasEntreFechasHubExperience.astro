.mockup-dias-entre-fechas-hub :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td){color:inherit}
.mockup-dias-entre-fechas-hub input[type="number"]{-moz-appearance:textfield;appearance:textfield}
.mockup-dias-entre-fechas-hub input[type="number"]::-webkit-inner-spin-button,.mockup-dias-entre-fechas-hub input[type="number"]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
