<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-dias-entre-fechas-hub')?document.currentScript.previousElementSibling:document.querySelector('.mockup-dias-entre-fechas-hub');if(!root)return;

