---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-ritmo-pace" set:html={`<div class="crumb">Salud / Ritmo de carrera</div><h1>Tu ritmo se entiende mejor vuelta por vuelta.</h1><p class="lead">Convertí distancia y tiempo en pace, velocidad y parciales constantes para salir con un plan.</p><section class="stadium"><div class="trackCard"><div class="track"><i class="runner"></i><b id="center"></b></div><div class="splits" id="splits"></div></div><aside class="watch"><h2>Marca objetivo</h2><label>Distancia (km)<input id="distance" type="number" value="10" step=".1"></label><label>Horas<input id="hours" type="number" value="0"></label><label>Minutos<input id="minutes" type="number" value="52"></label><label>Segundos<input id="seconds" type="number" value="0"></label><div class="pace" id="pace"></div><span>min/km</span><div class="projections" id="projections"></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-ritmo-pace')?document.currentScript.previousElementSibling:document.querySelector('.mockup-ritmo-pace');

const $=x=>root.querySelector("#"+x),fmt=s=>`${Math.floor(s/60)}:${String(Math.round(s%60)).padStart(2,'0')}`;function render(){let d=Math.max(.1,+$('distance').value),total=+$('hours').value*3600 + +$('minutes').value*60 + +$('seconds').value,pace=total/d;$('pace').textContent=fmt(pace);$('center').textContent=`${(3600/pace).toFixed(1)} km/h`;$('splits').innerHTML=Array.from({length:Math.min(5,Math.ceil(d))},(_,i)=>`<div class=\"split\"><b>Km ${Math.round((i+1)*d/Math.min(5,Math.ceil(d)))}</b><br>${fmt(pace*(i+1)*d/Math.min(5,Math.ceil(d)))}</div>`).join('');$('projections').innerHTML=[5,10,21.1,42.2].map(x=>`<div class=\"projection\"><span>${x} km</span><b>${fmt(pace*x)}</b></div>`).join('')}
root.querySelectorAll('input').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-ritmo-pace{--blue:#174b7a;--ink:#182a32;--muted:#65747c;--line:#d7e1df;--orange:#e47a45;--track:#d66b52;--paper:#f5f7f5}.mockup-ritmo-pace *{box-sizing:border-box}.mockup-ritmo-pace{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-ritmo-pace input,.mockup-ritmo-pace button{font:inherit}.mockup-ritmo-pace .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-ritmo-pace .crumb{color:var(--blue);font-weight:850}.mockup-ritmo-pace h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-ritmo-pace .lead{font-size:18px;color:var(--muted)}.mockup-ritmo-pace .stadium{display:grid;grid-template-columns:1fr 300px;gap:20px;margin-top:26px}.mockup-ritmo-pace .trackCard,.mockup-ritmo-pace .watch{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-ritmo-pace .track{height:360px;border:55px solid var(--track);border-radius:180px;position:relative;display:grid;place-items:center;background:#dff0e8}.mockup-ritmo-pace .runner{position:absolute;width:24px;height:24px;border-radius:50%;background:var(--blue);left:50%;top:-40px}.mockup-ritmo-pace .splits{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:15px}.mockup-ritmo-pace .split{padding:11px;border-radius:11px;background:#f2f6f4;text-align:center}.mockup-ritmo-pace .watch label{display:block;font-size:12px;font-weight:850;margin:14px 0}.mockup-ritmo-pace .watch input{display:block;width:100%;border:0;border-bottom:2px solid var(--line);padding:8px 0;color:var(--ink);font-weight:900}.mockup-ritmo-pace .pace{font-size:48px;font-weight:950;color:var(--blue)}.mockup-ritmo-pace .projections{margin-top:15px}.mockup-ritmo-pace .projection{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:10px 0}@media(max-width:760px){.mockup-ritmo-pace .stadium{grid-template-columns:1fr}.mockup-ritmo-pace .track{height:260px;border-width:38px}.mockup-ritmo-pace .splits{grid-template-columns:1fr}}
.mockup-ritmo-pace { width:100%; overflow:hidden; }
.mockup-ritmo-pace .top, .mockup-ritmo-pace header.top { display:none !important; }
.mockup-ritmo-pace .foot { display:none !important; }
.mockup-ritmo-pace .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-ritmo-pace .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-ritmo-pace .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-ritmo-pace .support-real summary { cursor:pointer; font-weight:750; }
.mockup-ritmo-pace .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-ritmo-pace :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-ritmo-pace input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-ritmo-pace input[type="number"]::-webkit-inner-spin-button, .mockup-ritmo-pace input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-ritmo-pace .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-ritmo-pace support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
