.mockup-aeropuerto { width:100%; overflow:hidden; }
.mockup-aeropuerto .top, .mockup-aeropuerto header.top { display:none !important; }
.mockup-aeropuerto .foot { display:none !important; }
.mockup-aeropuerto .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-aeropuerto .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-aeropuerto .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-aeropuerto .support-real summary { cursor:pointer; font-weight:750; }
.mockup-aeropuerto .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-aeropuerto :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-aeropuerto input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-aeropuerto input[type="number"]::-webkit-inner-spin-button, .mockup-aeropuerto input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-aeropuerto .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-aeropuerto support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
