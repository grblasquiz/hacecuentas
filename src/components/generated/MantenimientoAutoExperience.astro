.mockup-mantenimiento-auto :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-mantenimiento-auto input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-mantenimiento-auto input[type="number"]::-webkit-inner-spin-button, .mockup-mantenimiento-auto input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
