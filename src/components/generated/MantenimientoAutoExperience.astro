---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-mantenimiento-auto" set:html={`<section class="hero"><div class="wrap crumb"><b>Auto</b> &nbsp;/&nbsp; Mantenimiento</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Tu auto al día</span><h1>Sabé qué toca<br>hacer y cuándo,<br>sin adivinar.</h1><p>Convertí kilómetros, tiempo y uso en un plan claro. Anticipá services, evitá olvidos caros y reservá lo justo cada mes.</p><div class="chips"><span>✓ Próximo service</span><span>🔔 Alertas claras</span><span>$ Fondo mensual</span></div><div class="car-art"><div class="road"></div><div class="car"><div class="car-body"></div><div class="glass"></div><i class="wheel one"></i><i class="wheel two"></i></div><div class="fuel-card"><small>PRÓXIMO MANTENIMIENTO</small><strong id="art-consumption">en 2.500 km</strong><span id="art-cost">Aceite y filtro</span></div></div></div>
<form class="calc"><div class="calc-title"><div><h2>Armá tu plan</h2><p>Elegí qué querés revisar.</p></div><span class="tag">Checklist personalizado</span></div><div class="section-label">¿Qué necesitás resolver?</div><div class="cases"><button type="button" class="case active" data-case="service"><i>🛢️</i>Aceite y service</button><button type="button" class="case" data-case="tires"><i>🛞</i>Neumáticos</button><button type="button" class="case" data-case="belt"><i>⚙️</i>Correa o cadena</button><button type="button" class="case" data-case="battery"><i>🔋</i>Batería</button></div><div class="section-label">Datos de tu auto</div><div class="fields"><div class="field"><label>Kilómetros actuales</label><div class="inline"><input id="km" type="number" min="0" value="85000"><b>km</b></div></div><div class="field"><label>Último cambio / revisión</label><div class="inline"><input id="last" type="number" min="0" value="80000"><b>km</b></div></div><div class="field"><label>Uso anual estimado</label><div class="inline"><input id="annual" type="number" min="1" value="12000"><b>km</b></div></div><div class="field"><label>Antigüedad de la pieza</label><div class="inline"><input id="age" type="number" min="0" step=".5" value=".5"><b>años</b></div></div><div class="field wide"><label>Tipo de mantenimiento</label><select id="type"><option value="5000">Aceite mineral · 5.000 km</option><option value="7500" selected>Semisintético · 7.500 km</option><option value="10000">Sintético · 10.000 km</option><option value="15000">Service extendido · 15.000 km</option></select></div></div><div class="advanced"><span>✓ Te mostramos kilometraje y tiempo, el que llegue primero</span><button type="button" id="advanced-toggle">+ Agregar costos</button></div><div class="extra" id="extra-fields"><div class="field"><label>Costo estimado del trabajo</label><div class="inline"><b>$</b><input id="cost" type="number" min="0" value="180000"></div></div><div class="field"><label>Meses para ahorrar</label><div class="inline"><input id="months" type="number" min="1" value="6"><b>meses</b></div></div></div><section class="result"><div class="result-top"><div><small id="result-label">Próximo cambio de aceite</small><div class="value" id="result-value">en 2.500 km</div></div><div class="verdict"><small>Estado</small><strong id="verdict">Todo en orden</strong></div></div><div class="stats"><span>Fecha estimada<b id="date-result">en 3 meses</b></span><span>Avance del intervalo<b id="progress-result">67%</b></span><span>Reserva sugerida<b id="fund-result">$30.000/mes</b></span></div><button class="go" id="update" type="button">Actualizar plan</button></section></form>
</div></section>
<section class="scale-section"><div class="wrap"><header class="center"><span>La respuesta en una escala</span><h2>¿Cuánto margen te queda?</h2><p>El marcador muestra cuánto consumiste del intervalo recomendado para el mantenimiento elegido.</p></header><div class="scale-card"><div class="meter"><i class="pin" id="pin" data-value="67%"></i></div><div class="meter-labels"><div><b>Al día</b>Hasta 70% del intervalo</div><div><b>Conviene agendar</b>70% a 100%</div><div><b>Está vencido</b>Superó el intervalo</div></div><div class="meter-summary"><span id="scale-copy">Recorriste 5.000 km desde la última revisión.</span><b id="scale-verdict">Te quedan 2.500 km</b></div></div></div></section>
<section class="breakdown"><div class="wrap break-grid"><article class="card"><h3>Tu plan, punto por punto</h3><div class="line"><span>Última revisión registrada</span><b id="detail-last">80.000 km</b></div><div class="line"><span>Intervalo recomendado</span><b id="detail-interval">7.500 km</b></div><div class="line"><span>Kilómetros recorridos</span><b id="detail-used">5.000 km</b></div><div class="line"><span>Próximo objetivo</span><b id="detail-next">87.500 km</b></div><div class="line total"><strong>Margen disponible</strong><b id="detail-left">2.500 km</b></div></article><article class="card"><h3>Antes de decidir</h3><div class="step"><i>1</i><div><b>Revisá el manual</b><span>El fabricante manda sobre cualquier regla general.</span></div></div><div class="step"><i>2</i><div><b>Considerá el tiempo</b><span>Poco kilometraje no evita que aceite y gomas envejezcan.</span></div></div><div class="step"><i>3</i><div><b>Registrá cada trabajo</b><span>Fecha, kilometraje, repuestos y comprobantes.</span></div></div><div class="warning">⚠️ Si hay ruidos, vibraciones, luces de alerta o pérdida de fluidos, no esperes al intervalo: revisalo cuanto antes.</div></article></div></section>
<section class="tips"><div class="wrap"><header class="center"><span>Checklist esencial</span><h2>Cuatro controles que evitan sorpresas</h2></header><div class="tip-grid"><article class="tip"><i>🛢️</i><h3>Aceite y filtros</h3><p>Nivel mensual e intervalo según lubricante y manual.</p><span class="impact">Cada 5–15 mil km</span></article><article class="tip"><i>🛞</i><h3>Neumáticos</h3><p>Presión mensual, rotación y profundidad del dibujo.</p><span class="impact">Revisión mensual</span></article><article class="tip"><i>⚙️</i><h3>Distribución</h3><p>Una correa vencida puede provocar una rotura costosa.</p><span class="impact">Prioridad alta</span></article><article class="tip"><i>🔋</i><h3>Batería</h3><p>Controlá bornes, arranque y antigüedad antes del invierno.</p><span class="impact">Vida típica 3–5 años</span></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">Un auto cuidado cuesta menos</span><h2>Anticiparse siempre sale más barato que reparar.</h2><p>Separar una suma chica por mes transforma un gasto imprevisible en un mantenimiento planificado.</p></div><div class="compare"><div><small>RESERVA MENSUAL</small><b id="cmp-low">$30.000</b><span>Fondo de mantenimiento</span></div><div><small>PRÓXIMO OBJETIVO</small><b id="cmp-current">87.500 km</b><span>Agendalo con tiempo</span></div><div><small>MARGEN ACTUAL</small><b id="cmp-high">2.500 km</b><span id="cmp-current-cost">Aproximadamente 3 meses</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-mantenimiento-auto')?document.currentScript.previousElementSibling:document.querySelector('.mockup-mantenimiento-auto');

const $=s=>root.querySelector(s),num=id=>Math.max(0,Number($(id).value)||0),fmt=v=>new Intl.NumberFormat("es-AR").format(Math.round(v)),money=v=>"$"+fmt(v);let mode="service";const config={service:{label:"Próximo cambio de aceite",name:"Aceite y filtro",interval:()=>num("#type"),years:1},tires:{label:"Próxima revisión de neumáticos",name:"Rotación y desgaste",interval:()=>10000,years:5},belt:{label:"Próximo control de distribución",name:"Correa o cadena",interval:()=>60000,years:5},battery:{label:"Próximo control de batería",name:"Batería y arranque",interval:()=>30000,years:4}};
function calc(){const km=num("#km"),last=Math.min(km,num("#last")),annual=Math.max(1,num("#annual")),age=num("#age"),cost=num("#cost"),months=Math.max(1,num("#months")),c=config[mode],interval=c.interval(),used=Math.max(km-last,interval*(age/c.years)),left=interval-used,next=last+interval,progress=used/interval*100,monthLeft=Math.max(0,left/annual*12),status=left<=0?"Revisalo ahora":progress>=70?"Conviene agendar":"Todo en orden";$("#result-label").textContent=c.label;$("#result-value").textContent=left<=0?`vencido por ${fmt(-left)} km`:`en ${fmt(left)} km`;$("#verdict").textContent=status;$("#date-result").textContent=left<=0?"Ahora":`en ${Math.max(1,Math.round(monthLeft))} meses`;$("#progress-result").textContent=`${Math.round(progress)}%`;$("#fund-result").textContent=`${money(cost/months)}/mes`;$("#art-consumption").textContent=left<=0?"Revisión pendiente":`en ${fmt(left)} km`;$("#art-cost").textContent=c.name;$("#pin").style.left=`${Math.max(2,Math.min(98,progress/130*100))}%`;$("#pin").dataset.value=`${Math.round(progress)}%`;$("#scale-copy").textContent=`Usaste ${fmt(used)} km equivalentes desde la última revisión.`;$("#scale-verdict").textContent=left<=0?`Superaste ${fmt(-left)} km`:`Te quedan ${fmt(left)} km`;$("#detail-last").textContent=`${fmt(last)} km`;$("#detail-interval").textContent=`${fmt(interval)} km`;$("#detail-used").textContent=`${fmt(used)} km`;$("#detail-next").textContent=`${fmt(next)} km`;$("#detail-left").textContent=left<=0?`−${fmt(-left)} km`:`${fmt(left)} km`;$("#cmp-low").textContent=money(cost/months);$("#cmp-current").textContent=`${fmt(next)} km`;$("#cmp-high").textContent=left<=0?"Ahora":`${fmt(left)} km`;$("#cmp-current-cost").textContent=left<=0?"Necesita revisión":`Aproximadamente ${Math.max(1,Math.round(monthLeft))} meses`}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(x=>x.classList.remove("active"));b.classList.add("active");mode=b.dataset.case;calc()}));root.querySelectorAll("input,select").forEach(el=>el.addEventListener("input",calc));$("#advanced-toggle").addEventListener("click",e=>{$("#extra-fields").classList.toggle("open");e.currentTarget.textContent=$("#extra-fields").classList.contains("open")?"− Ocultar costos":"+ Agregar costos"});$("#update").addEventListener("click",e=>{e.preventDefault();calc();e.currentTarget.textContent="✓ Plan actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar plan",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());calc();

})();
</script>
