<div class="mockup-construccion-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Construcción</div><div class="heroGrid"><div><span class="eyebrow">Antes de comprar, medí</span><h1>Materiales, mano de obra y margen. Todo entra en la cuenta.</h1><p class="lead">Estimá costos y cantidades para obra gruesa, terminaciones y reformas sin depender de un único precio por metro cuadrado.</p><div class="trust"><span>✓ Rubros separados</span><span>✓ Imprevistos visibles</span><span>✓ Supuestos editables</span></div><div class="scene"><i class="wall"></i><i class="helmet"></i></div></div>
<div class="calc"><div class="calcHead"><div><h2>Armá un presupuesto inicial</h2><p>Superficie, materiales y costos asociados.</p></div><span class="live">PRESUPUESTO EN VIVO</span></div><div class="presets"><button class="preset active" data-preset="renovation">Refacción</button><button class="preset" data-preset="standard">Obra estándar</button><button class="preset" data-preset="premium">Terminación premium</button></div><div class="fields"><div class="field"><label>Superficie</label><div class="input"><input id="area" type="number" min="1" value="80"><span>m²</span></div></div><div class="field"><label>Materiales por m²</label><div class="input"><span>$</span><input id="materialRate" type="number" min="0" value="680000"></div></div><div class="field"><label>Mano de obra sobre materiales</label><div class="input"><input id="laborRate" type="number" min="0" step=".1" value="55"><span>%</span></div></div><div class="field"><label>Honorarios y permisos</label><div class="input"><input id="feesRate" type="number" min="0" step=".1" value="10"><span>%</span></div></div><div class="field"><label>Margen para imprevistos</label><div class="input"><input id="contingency" type="number" min="0" step=".1" value="15"><span>%</span></div></div><div class="field"><label>Duración estimada</label><div class="input"><input id="months" type="number" min="1" value="6"><span>meses</span></div></div></div><button class="primary" id="calculate">Actualizar presupuesto</button><div class="result"><div class="resultTop"><div><small>COSTO TOTAL ESTIMADO</small><div class="amount" id="total">$105.037.600</div></div><span class="badge" id="presetLabel">Refacción</span></div><div class="resultGrid"><div class="metric"><span>MATERIALES</span><b id="materials">$54.400.000</b></div><div class="metric"><span>MANO DE OBRA</span><b id="labor">$29.920.000</b></div><div class="metric"><span>HONORARIOS</span><b id="fees">$8.432.000</b></div><div class="metric"><span>IMPREVISTOS</span><b id="reserve">$12.285.600</b></div></div><div class="stack"><i id="barMaterials"></i><i id="barLabor"></i><i id="barFees"></i><i id="barReserve"></i></div><p class="note" id="note">Equivale a $1.312.970 por m² y $17.506.267 por mes de obra.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Entrá por la etapa de obra</span><h2>¿Qué necesitás calcular?</h2><p>Elegí una necesidad y encontrá primero las herramientas relacionadas.</p></div><div class="needs"><button class="need active" data-filter="budget"><span class="icon">$</span><h3>Presupuestar la obra</h3><p>Costo por m² y rubros principales.</p><em>→</em></button><button class="need" data-filter="structure"><span class="icon">▦</span><h3>Resolver estructura</h3><p>Hormigón, ladrillos y madera.</p><em>→</em></button><button class="need" data-filter="finish"><span class="icon">◫</span><h3>Calcular terminaciones</h3><p>Pisos, pintura y revestimientos.</p><em>→</em></button><button class="need" data-filter="materials"><span class="icon">≡</span><h3>Comprar materiales</h3><p>Cantidad, desperdicio y bolsas.</p><em>→</em></button><button class="need" data-filter="compare"><span class="icon">⇄</span><h3>Comparar alternativas</h3><p>Sistemas, costos y rendimiento.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de construcción</span><h2>Cada material, en su unidad correcta.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="budget">Presupuesto</button><button class="filter" data-filter="structure">Obra gruesa</button><button class="filter" data-filter="finish">Terminaciones</button><button class="filter" data-filter="materials">Materiales</button><button class="filter" data-filter="compare">Comparar</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="budget compare" data-text="costo por metro cuadrado obra presupuesto superficie"><span class="tag">Presupuesto completo</span><h3>Costo de construcción por m²</h3><p>Superficie, sistema, terminación, mano de obra y margen.</p><button>Estimar costo →</button></article><article class="card" data-cat="structure materials" data-text="hormigón cemento arena piedra volumen"><span class="tag">Estructura</span><h3>Hormigón</h3><p>Volumen, dosificación y materiales para la mezcla.</p><button>Calcular hormigón →</button></article><article class="card" data-cat="structure materials" data-text="ladrillos pared mortero desperdicio cantidad"><span class="tag">Mampostería</span><h3>Ladrillos</h3><p>Unidades, mortero y desperdicio según pared.</p><button>Calcular ladrillos →</button></article><article class="card" data-cat="structure materials compare" data-text="madera tablas vigas volumen pies cuadrado"><span class="tag">Madera</span><h3>Madera para obra</h3><p>Tablas, vigas, volumen y costo estimado.</p><button>Calcular madera →</button></article><article class="card" data-cat="finish materials" data-text="pintura litros manos rendimiento pared techo"><span class="tag">Terminación</span><h3>Pintura</h3><p>Litros por superficie, manos y rendimiento.</p><button>Calcular pintura →</button></article><article class="card" data-cat="finish materials" data-text="pisos cajas metros cuadrados desperdicio zocalo"><span class="tag">Revestimiento</span><h3>Pisos</h3><p>Metros, cajas, zócalos y recortes.</p><button>Calcular pisos →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="plan"><div class="wrap planGrid"><div><span class="eyebrow" style="color:var(--yellow)">La secuencia también cuesta</span><h2>Medir, presupuestar, reservar.</h2><p>Comprar antes de definir cantidades inmoviliza plata; comprar sin margen detiene la obra. La cuenta correcta incluye orden y contingencia.</p></div><div class="planList"><button class="planBtn active" data-step="Medición"><span><b>1. Medí el trabajo real</b><small>Superficie, volumen, largos y encuentros.</small></span><b>→</b></button><button class="planBtn" data-step="Rendimiento"><span><b>2. Usá el rendimiento correcto</b><small>Cada sistema y material cambia la cuenta.</small></span><b>→</b></button><button class="planBtn" data-step="Desperdicio"><span><b>3. Sumá desperdicio e imprevistos</b><small>No son lo mismo, pero ambos existen.</small></span><b>→</b></button></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-construccion-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-construccion-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR");let current="renovation";function calc(){const area=Math.max(1,+$("#area").value||1),mr=Math.max(0,+$("#materialRate").value||0),lr=Math.max(0,+$("#laborRate").value||0)/100,fr=Math.max(0,+$("#feesRate").value||0)/100,cr=Math.max(0,+$("#contingency").value||0)/100,months=Math.max(1,+$("#months").value||1),materials=area*mr,labor=materials*lr,fees=(materials+labor)*fr,base=materials+labor+fees,reserve=base*cr,total=base+reserve,vals=[materials,labor,fees,reserve],ids=["barMaterials","barLabor","barFees","barReserve"];$("#total").textContent=money(total);$("#materials").textContent=money(materials);$("#labor").textContent=money(labor);$("#fees").textContent=money(fees);$("#reserve").textContent=money(reserve);ids.forEach((id,i)=>$("#"+id).style.width=total?vals[i]/total*100+"%":"0%");$("#presetLabel").textContent={renovation:"Refacción",standard:"Obra estándar",premium:"Premium"}[current];$("#note").textContent=`Equivale a ${money(total/area)} por m² y ${money(total/months)} por mes de obra.`}
$$(".calc input").forEach(x=>x.oninput=calc);const presets={renovation:[80,680000,55,10,15,6],standard:[120,920000,65,12,12,12],premium:[180,1450000,72,14,18,18]};$$(".preset").forEach(b=>b.onclick=()=>{current=b.dataset.preset;$$(".preset").forEach(x=>x.classList.toggle("active",x===b));const v=presets[current],ids=["area","materialRate","laborRate","feesRate","contingency","months"];ids.forEach((id,i)=>$("#"+id).value=v[i]);calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Presupuesto actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".planBtn").forEach(b=>b.onclick=()=>{$$(".planBtn").forEach(x=>x.classList.toggle("active",x===b));toast("Paso seleccionado: "+b.dataset.step)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
