---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-creador-contenido" set:html={`<div class="crumb">Negocios / Creador de contenido</div><h1>Publicar más no siempre hace crecer más.</h1><p class="lead">Convertí un objetivo en una semana editorial posible, con tiempo para crear, reutilizar y medir.</p><section class="studio"><aside class="brief"><h2>Brief de la semana</h2><label>Objetivo<select id="goal"><option value="reach">Alcance</option><option value="trust">Confianza</option><option value="sales">Ventas</option></select></label><label>Horas disponibles<input id="hours" type="number" value="8" min="1" max="40"></label><label>Canales<input id="channels" type="number" value="2" min="1" max="4"></label><button id="plan">Rearmar semana</button><div class="load"><i id="load"></i></div><p class="diagnosis" id="diagnosis"></p></aside><section class="calendar"><div class="days" id="days"></div><p class="calendarHint" aria-hidden="true">Deslizá para ver el resto de la semana →</p></section></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-creador-contenido')?document.currentScript.previousElementSibling:document.querySelector('.mockup-creador-contenido');

const $=x=>root.querySelector("#"+x),names=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];function render(){let h=+$('hours').value,c=+$('channels').value,g=$('goal').value,budget=Math.max(1,Math.floor(h*60/75)),pieces=[];let types=g==='reach'?['Video corto','Carrusel','Trend']:g==='trust'?['Guía','Caso real','Detrás de escena']:['Oferta','Prueba social','Demo'];for(let i=0;i<budget;i++)pieces.push(types[i%types.length]);$('days').innerHTML=names.map((n,i)=>`<div class=\"day\"><b>${n}</b>${pieces.filter((_,j)=>j%7===i).map((p,k)=>`<div class=\"piece ${k===0&&i===2?'hero':''}\">${p}<br><small>${c} canal${c>1?'es':''}</small></div>`).join('')}</div>`).join('');let used=pieces.length*75;$('load').style.width=Math.min(100,used/(h*60)*100)+'%';$('diagnosis').textContent=`${pieces.length} piezas base · ${Math.round(used/60)} h de producción. Cada pieza se adapta, no se duplica sin criterio.`}
$('plan').onclick=render;root.querySelectorAll('input,select').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-creador-contenido{--blue:#174b7a;--ink:#192a32;--muted:#65747c;--line:#d7e1df;--pink:#db6480;--mint:#dff2e9;--paper:#f5f7f5}.mockup-creador-contenido *{box-sizing:border-box}.mockup-creador-contenido{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-creador-contenido button,.mockup-creador-contenido input,.mockup-creador-contenido select{font:inherit}.mockup-creador-contenido .shell{max-width:1180px;margin:auto;padding:34px 22px}.mockup-creador-contenido .crumb{color:var(--blue);font-weight:850}.mockup-creador-contenido h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-creador-contenido .lead{font-size:18px;color:var(--muted)}.mockup-creador-contenido .studio{display:grid;grid-template-columns:280px 1fr;gap:20px;margin-top:26px}.mockup-creador-contenido .brief,.mockup-creador-contenido .calendar{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-creador-contenido .brief label{display:block;font-size:12px;font-weight:850;margin:15px 0}.mockup-creador-contenido .brief input,.mockup-creador-contenido .brief select{display:block;width:100%;border:1px solid var(--line);border-radius:10px;padding:10px;margin-top:6px;color:var(--ink)}.mockup-creador-contenido .brief button{width:100%;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:13px;font-weight:900}.mockup-creador-contenido .days{display:grid;grid-template-columns:repeat(7,1fr);gap:7px}.mockup-creador-contenido .day{min-height:280px;background:#f4f7f5;border-radius:14px;padding:10px}.mockup-creador-contenido .day b{display:block;font-size:12px;margin-bottom:9px}.mockup-creador-contenido .piece{padding:9px;border-radius:10px;background:var(--mint);font-size:11px;margin-bottom:7px;border-left:4px solid var(--blue)}.mockup-creador-contenido .piece.hero{background:#ffe5ec;border-color:var(--pink)}.mockup-creador-contenido .load{margin-top:16px;height:16px;background:#e2e8e5;border-radius:99px;overflow:hidden}.mockup-creador-contenido .load i{display:block;height:100%;background:var(--pink)}.mockup-creador-contenido .diagnosis{margin-top:10px;color:var(--muted)}@media(max-width:900px){.mockup-creador-contenido .studio{grid-template-columns:1fr}.mockup-creador-contenido .days{overflow-x:auto}.mockup-creador-contenido .day{min-width:120px}}
.mockup-creador-contenido { width:100%; overflow:hidden; }
.mockup-creador-contenido .top, .mockup-creador-contenido header.top { display:none !important; }
.mockup-creador-contenido .foot { display:none !important; }
.mockup-creador-contenido .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-creador-contenido .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-creador-contenido .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-creador-contenido .support-real summary { cursor:pointer; font-weight:750; }
.mockup-creador-contenido .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-creador-contenido :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-creador-contenido input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-creador-contenido input[type="number"]::-webkit-inner-spin-button, .mockup-creador-contenido input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-creador-contenido .support-real-grid{grid-template-columns:1fr}}
</style>
<style is:global>
  @media (max-width: 900px) {
    .mockup-creador-contenido .studio { grid-template-columns: minmax(0, 1fr); }
    .mockup-creador-contenido .studio > * { min-width: 0; }
    .mockup-creador-contenido .calendar { min-width: 0; overflow: hidden; }
    .mockup-creador-contenido .days {
      width: 100%; max-width: 100%; overflow-x: auto;
      grid-template-columns: repeat(7, minmax(112px, 1fr));
      padding-bottom: 8px; scrollbar-width: thin;
    }
    .mockup-creador-contenido .day { min-width: 0; }
    .mockup-creador-contenido .calendarHint {
      display: block; margin: 9px 0 0; color: var(--muted);
      font-size: 12px; font-weight: 750;
    }
  }
  .mockup-creador-contenido .calendarHint { display: none; }
</style>
{data && <section class="mockup-creador-contenido support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
