---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-retencion-fuente-colombia" set:html={`<section class="hero"><div class="wrap crumb"><b>Colombia</b> &nbsp;/&nbsp; Impuestos &nbsp;/&nbsp; Retención en la fuente</div><div class="wrap grid"><div class="copy"><span class="eyebrow">DIAN · Retención en la fuente</span><h1>Sabé cuánto te retienen antes de recibir el pago.</h1><p>Calculá salarios, honorarios, servicios, compras y arriendos con la UVT vigente. Entendé la base, la tarifa aplicada y el neto que finalmente se paga.</p><div class="chips"><span>✓ UVT 2026</span><span>✓ Base mínima vigente</span><span>✓ Neto a pagar</span></div><div class="art"><div class="sheet"><i></i><i></i><i></i></div><div class="stamp">RETENCIÓN</div><div class="float"><small>RETENCIÓN DEL PERÍODO</small><b id="art-value">$660.000</b><span id="art-copy">servicios · declarante</span></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá la retención</h2><p class="muted">Elegí el tipo de pago.</p></div><span class="tag">UVT $52.374</span></div><div class="label">¿Qué pago estás mirando?</div><div class="cases"><button type="button" class="case active" data-mode="employee1"><i>1</i>Empleado · proc. 1</button><button type="button" class="case" data-mode="employee2"><i>2</i>Empleado · proc. 2</button><button type="button" class="case" data-mode="provider"><i>▤</i>Proveedor</button><button type="button" class="case" data-mode="rent"><i>⌂</i>Arrendamiento</button></div><div class="label">Datos del pago</div><div class="fields"><div class="field"><label>Ingreso, factura o canon</label><input id="income" value="6000000"></div><div class="field employee"><label>Aportes de salud y pensión</label><input id="contrib" value="480000"></div><div class="field employee"><label>¿Tenés dependientes?</label><select id="deps"><option value="1">Sí</option><option value="0">No</option></select></div><div class="field employee"><label>Vivienda y medicina prepagada</label><input id="deductions" value="400000"></div><div class="field hide provider"><label>Concepto del proveedor</label><select id="concept"><option value="services">Servicios generales</option><option value="purchases">Compras generales</option><option value="fees">Honorarios y comisiones</option></select></div><div class="field hide provider"><label>Condición del proveedor</label><select id="declarant"><option value="yes">Declarante / persona jurídica</option><option value="no">Persona natural no declarante</option></select></div><div class="field hide rent"><label>Tipo de arrendamiento</label><select id="rent-kind"><option value="real">Bien inmueble</option><option value="movable">Bien mueble</option></select></div><div class="field hide rent"><label>¿Quien paga es agente retenedor?</label><select id="agent"><option value="yes">Sí</option><option value="no">No</option></select></div></div><section class="result"><div class="result-top"><div><small>RETENCIÓN DEL PERÍODO</small><div class="value" id="result">$0</div></div><div class="badge"><small id="badge-label">Tasa efectiva</small><b id="badge">0%</b></div></div><div class="stats"><span id="s1l">BASE GRAVABLE<b id="s1">$0</b></span><span id="s2l">BASE EN UVT<b id="s2">0 UVT</b></span><span id="s3l">NETO DEL PAGO<b id="s3">$0</b></span></div><button class="go" id="update" type="button">Actualizar retención</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Del valor bruto al neto</span><h2>Cómo se reparte el pago</h2><p>En salario primero se depura la base. En proveedores y arriendos se controla la cuantía mínima y se aplica una tarifa fija.</p></header><div class="stack"><div class="bar"><i class="ded" id="bar-ded">Deducciones</i><i class="base" id="bar-base">Base</i><i class="ret" id="bar-ret">Retención</i><i class="net" id="bar-net">Neto</i></div><div class="legend"><span>DEDUCCIONES / APORTES<b id="leg-ded">$0</b></span><span>BASE GRAVABLE<b id="leg-base">$0</b></span><span>RETENCIÓN<b id="leg-ret">$0</b></span><span>NETO A PAGAR<b id="leg-net">$0</b></span></div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3>La cuenta, paso a paso</h3><div class="line"><span id="d1l">Valor bruto</span><b id="d1">$6.000.000</b></div><div class="line"><span id="d2l">Conceptos que se restan</span><b id="d2">$0</b></div><div class="line"><span id="d3l">Base gravable</span><b id="d3">$0</b></div><div class="line"><span id="d4l">Tarifa aplicada</span><b id="d4">0%</b></div><div class="line total"><strong id="d5l">Retención</strong><b id="d5">$0</b></div></article><article class="card"><h3>Antes de practicarla</h3><div class="rule"><i>1</i><div><b>Confirmá si sos agente retenedor</b><span>No todo el que paga una factura debe retener.</span></div></div><div class="rule"><i>2</i><div><b>Usá el valor sin IVA</b><span>La retención de renta se calcula antes del IVA.</span></div></div><div class="rule"><i>3</i><div><b>Entregá el certificado</b><span>El beneficiario lo necesita para acreditar el anticipo.</span></div></div><div class="warning">Estimación informativa. Verificá normas, bases y condición tributaria con la DIAN o un contador.</div></article></div></section>
<section class="concepts"><div class="wrap"><header class="center"><span>Tarifas por concepto</span><h2>No todos los pagos retienen igual</h2></header><div class="conceptgrid"><article class="concept"><i>▤</i><h3>Compras generales</h3><p>Base mínima 27 UVT. Tarifa según declarante.</p><em>2,5% o 3,5%</em></article><article class="concept"><i>⌁</i><h3>Servicios generales</h3><p>Base mínima 4 UVT sobre el pago sin IVA.</p><em>4% o 6%</em></article><article class="concept"><i>§</i><h3>Honorarios</h3><p>Sin base mínima; se retiene desde el primer peso.</p><em>11% o 10%</em></article><article class="concept"><i>⌂</i><h3>Arrendamiento</h3><p>Inmuebles con base de 27 UVT; muebles sin mínimo.</p><em>3,5% o 4%</em></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#f0d47e">Un anticipo, no otro impuesto</span><h2>Lo retenido se descuenta de tu renta anual.</h2><p>Guardá cada certificado: es la prueba del dinero que ya pagaste por anticipado y puede convertirse en saldo a favor.</p></div><div class="facts"><div><small>UVT 2026</small><b>$52.374</b><span>Resolución DIAN</span></div><div><small>SALARIO</small><b>Tabla progresiva</b><span>Art. 383 ET</span></div><div><small>PROVEEDORES</small><b>Tarifa fija</b><span>Con base mínima</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-retencion-fuente-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-retencion-fuente-colombia');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0),cop=x=>"$"+Math.round(x).toLocaleString("es-CO"),pct=x=>x.toLocaleString("es-CO",{maximumFractionDigits:2})+"%";let mode="employee1",UVT=52374;function salaryTable(base){let u=base/UVT,r=0,marg=0;if(u>2300){r=((u-2300)*.39+770)*UVT;marg=39}else if(u>945){r=((u-945)*.37+268)*UVT;marg=37}else if(u>640){r=((u-640)*.35+162)*UVT;marg=35}else if(u>360){r=((u-360)*.33+69)*UVT;marg=33}else if(u>150){r=((u-150)*.28+10)*UVT;marg=28}else if(u>95){r=(u-95)*.19*UVT;marg=19}return{r,u,marg}}function calc(){let income=n("#income"),base=0,ret=0,ded=0,rate=0,label="",sub="";if(mode.startsWith("employee")){let contrib=Math.min(income,n("#contrib")),dep=n("#deps")?Math.min(income*.1,32*UVT):0,other=Math.min(n("#deductions"),116*UVT),subtotal=Math.max(0,income-contrib-dep-other),exempt=Math.min(subtotal*.25,790/12*UVT),benefits=Math.min(dep+other+exempt,(income-contrib)*.4,1340/12*UVT);ded=contrib+benefits;base=Math.max(0,income-ded);let t=salaryTable(base);ret=t.r;rate=mode==="employee2"?(base?ret/base*100:0):t.marg;label=mode==="employee2"?"Porcentaje fijo":"Tarifa marginal";sub=mode==="employee2"?"Procedimiento 2":"Procedimiento 1"}else if(mode==="provider"){let c=$("#concept").value,decl=$("#declarant").value==="yes",cfg={services:{min:4,yes:.04,no:.06,name:"Servicios"},purchases:{min:27,yes:.025,no:.035,name:"Compras"},fees:{min:0,yes:.11,no:.10,name:"Honorarios"}}[c];base=income;rate=(decl?cfg.yes:cfg.no)*100;ret=income>=cfg.min*UVT?income*rate/100:0;label="Tarifa aplicada";sub=cfg.name+" · "+(decl?"declarante":"no declarante")}else{let movable=$("#rent-kind").value==="movable",agent=$("#agent").value==="yes";base=income;rate=movable?4:3.5;ret=agent&&(movable||income>=27*UVT)?income*rate/100:0;label="Tarifa aplicada";sub=movable?"Bien mueble":"Bien inmueble"}let net=Math.max(0,income-ret-(mode.startsWith("employee")?n("#contrib"):0));$("#result").textContent=cop(ret);$("#badge-label").textContent=label;$("#badge").textContent=pct(rate);$("#s1").textContent=cop(base);$("#s2").textContent=(base/UVT).toLocaleString("es-CO",{maximumFractionDigits:1})+" UVT";$("#s3").textContent=cop(net);$("#art-value").textContent=cop(ret);$("#art-copy").textContent=sub;let rows=[["Valor bruto",cop(income)],["Conceptos que se restan",cop(ded)],["Base gravable",cop(base)],["Tarifa aplicada",pct(rate)],["Retención",cop(ret)]];rows.forEach((x,i)=>{$("#d"+(i+1)+"l").textContent=x[0];$("#d"+(i+1)).textContent=x[1]});$("#leg-ded").textContent=cop(ded);$("#leg-base").textContent=cop(base);$("#leg-ret").textContent=cop(ret);$("#leg-net").textContent=cop(net);let total=Math.max(1,income+base+net),parts=[ded,base,ret,net];["ded","base","ret","net"].forEach((id,i)=>$("#bar-"+id).style.width=Math.max(2,parts[i]/total*100)+"%")}
function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$$(".employee").forEach(x=>x.classList.toggle("hide",!m.startsWith("employee")));$$(".provider").forEach(x=>x.classList.toggle("hide",m!=="provider"));$$(".rent").forEach(x=>x.classList.toggle("hide",m!=="rent"));calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Retención actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar retención",1200)};calc();

})();
</script>
