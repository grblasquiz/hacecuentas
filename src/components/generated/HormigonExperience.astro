.mockup-hormigon .hero{background:linear-gradient(128deg,#f5f9fd 0%,#f5f9fd 60%,#eef8f3 100%);padding:25px 0 62px;overflow:hidden}.mockup-hormigon .crumb{font-size:12px;color:#718299;margin-bottom:31px}.mockup-hormigon .crumb b{color:#127e67}.mockup-hormigon .hero-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:52px;align-items:start}.mockup-hormigon .hero-grid>*{min-width:0}.mockup-hormigon .copy{padding-top:8px}.mockup-hormigon .eyebrow{font-size:11px;font-weight:850;letter-spacing:.14em;text-transform:uppercase;color:#127e67;display:flex;align-items:center;gap:9px}.mockup-hormigon .eyebrow:before{content:"";width:28px;height:2px;background:#127e67}.mockup-hormigon .copy h1{font-size:51px;line-height:1.03;letter-spacing:-.052em;margin:18px 0;color:#10213a}.mockup-hormigon .copy>p{font-size:17px;line-height:1.65;color:#53677e;max-width:510px}.mockup-hormigon .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:23px}.mockup-hormigon .chips span{background:#fff;border:1px solid #dbe5ed;border-radius:9px;padding:9px 11px;color:#4d6279;font-size:10px}
.mockup-hormigon .car-art{height:235px;margin-top:18px;position:relative}.mockup-hormigon .road{position:absolute;left:15px;right:20px;bottom:31px;height:54px;border-radius:50%;background:#dce8ec;transform:skewX(-13deg)}.mockup-hormigon .road:after{content:"";position:absolute;left:8%;right:8%;top:25px;border-top:3px dashed #fff}.mockup-hormigon .car{position:absolute;left:35px;bottom:58px;width:330px;height:100px}.mockup-hormigon .car-body{position:absolute;inset:35px 0 0;background:linear-gradient(135deg,#2b8d7a,#166b61);border-radius:45px 58px 18px 20px;box-shadow:0 18px 30px #17385828}.mockup-hormigon .car-body:before{content:"";position:absolute;width:145px;height:65px;left:75px;top:-42px;background:#258473;clip-path:polygon(22% 0,78% 0,100% 100%,0 100%)}.mockup-hormigon .glass{position:absolute;left:109px;top:2px;width:78px;height:38px;background:#d7edf1;clip-path:polygon(15% 0,79% 0,100% 100%,0 100%);z-index:2}.mockup-hormigon .wheel{position:absolute;bottom:-13px;width:48px;height:48px;border:9px solid #17324f;border-radius:50%;background:#c9d5dd;z-index:3}.mockup-hormigon .wheel.one{left:47px}.mockup-hormigon .wheel.two{right:42px}.mockup-hormigon .fuel-card{position:absolute;right:5px;top:5px;background:#fff;border:1px solid #d8e4eb;border-radius:14px;padding:16px 18px;box-shadow:0 18px 40px #17385817}.mockup-hormigon .fuel-card small{display:block;font-size:8px;color:#697d90}.mockup-hormigon .fuel-card strong{display:block;color:#147762;font-size:24px;margin:5px 0}.mockup-hormigon .fuel-card span{font-size:9px;color:#536a7f}
.mockup-hormigon .calc{background:#fff;border:1px solid #d8e4eb;border-radius:20px;padding:26px 29px;box-shadow:0 25px 60px #173b6418;position:relative;z-index:2}.mockup-hormigon .calc-title{display:flex;justify-content:space-between;gap:20px}.mockup-hormigon .calc h2{font-size:23px;margin:0 0 4px}.mockup-hormigon .calc-title p{font-size:10px;color:#60758c;margin:0}.mockup-hormigon .tag{font-size:9px;color:#14775b;background:#e6f6ef;border-radius:99px;padding:7px 10px;font-weight:800;height:max-content;white-space:nowrap}.mockup-hormigon .section-label{font-size:10px;font-weight:850;color:#293b53;margin:17px 0 8px}.mockup-hormigon .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.mockup-hormigon .case{border:1px solid #dce5ec;background:#fff;border-radius:10px;padding:9px 4px;color:#52677f;font-size:8px;font-weight:750;min-height:66px}.mockup-hormigon .case i{display:block;font-style:normal;font-size:17px;margin-bottom:3px}.mockup-hormigon .case.active{border:2px solid #19816d;background:#eef9f5;color:#116c5a}.mockup-hormigon .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-hormigon .field{border:1px solid #dbe4eb;border-radius:10px;padding:9px 11px;min-height:57px}.mockup-hormigon .field.wide{grid-column:span 2}.mockup-hormigon .field label{display:block;color:#63788e;font-size:8px;margin-bottom:5px}.mockup-hormigon .field input,.mockup-hormigon .field select{border:0;outline:0;background:none;width:100%;color:#142641;font-weight:750;font-size:13px}.mockup-hormigon .inline{display:flex;align-items:center;gap:5px}.mockup-hormigon .inline b{font-size:11px;color:#51667d}.mockup-hormigon .advanced{display:flex;justify-content:space-between;margin:11px 0;color:#566d84;font-size:9px}.mockup-hormigon .advanced button{border:0;background:none;color:#127e67;font-size:9px;font-weight:800;padding:0}.mockup-hormigon .extra{display:none;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:10px}.mockup-hormigon .extra.open{display:grid}.mockup-hor