---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-hormigon" set:html={`<section class="hero"><div class="wrap crumb"><b>Construcción</b> &nbsp;/&nbsp; Hormigón</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Cómputo de obra</span><h1>Calculá el hormigón<br>y comprá sólo lo<br>que necesitás.</h1><p>Elegí la pieza, cargá sus medidas y obtené volumen, desperdicio, bolsas de cemento, arena, piedra y agua.</p><div class="chips"><span>📐 Volumen automático</span><span>🧱 H-13 a H-30</span><span>✓ Lista para el corralón</span></div><div class="car-art"><div class="road"></div><div style="position:absolute;left:65px;bottom:52px;width:285px;height:145px;background:linear-gradient(145deg,#aebbc2,#788992);clip-path:polygon(15% 15%,100% 0,85% 85%,0 100%);box-shadow:0 20px 35px #17385820"></div><div style="position:absolute;left:100px;bottom:97px;width:220px;height:6px;background:#dce5e8;transform:rotate(-7deg)"></div><div class="fuel-card"><small>HORMIGÓN A PEDIR</small><strong id="art-value">3,15 m³</strong><span id="art-place">Losa · H-21 · +5%</span></div></div></div>
<form class="calc"><div class="calc-title"><div><h2>Calculá tu mezcla</h2><p>Elegí qué vas a hormigonar.</p></div><span class="tag">Bolsas de 50 kg</span></div><div class="section-label">Tipo de pieza</div><div class="cases"><button type="button" class="case active" data-mode="slab"><i>▰</i>Losa o platea</button><button type="button" class="case" data-mode="column"><i>▮</i>Columna</button><button type="button" class="case" data-mode="beam"><i>▬</i>Viga o zapata</button><button type="button" class="case" data-mode="volume"><i>m³</i>Ya sé el volumen</button></div><div class="section-label" id="field-title">Medidas de la losa</div><div class="fields"><div class="field"><label id="l1">Largo</label><div class="inline"><input id="v1" type="number" step=".1" value="10"><b id="u1">m</b></div></div><div class="field"><label id="l2">Ancho</label><div class="inline"><input id="v2" type="number" step=".1" value="3"><b id="u2">m</b></div></div><div class="field wide"><label id="l3">Espesor</label><div class="inline"><input id="v3" type="number" step=".1" value="10"><b id="u3">cm</b></div></div><div class="field"><label>Resistencia</label><select id="grade"><option value="250">H-13 · contrapiso</option><option value="300">H-17 · platea liviana</option><option value="350" selected>H-21 · estructura estándar</option><option value="400">H-25 · resistente</option><option value="450">H-30 · alta resistencia</option></select></div><div class="field"><label>Desperdicio</label><div class="inline"><input id="waste" type="number" value="5"><b>%</b></div></div></div><div class="advanced"><span id="formula-note">Largo × ancho × espesor</span><button type="button" id="advanced-toggle">+ Agregar precio</button></div><div class="extra" id="extra-fields"><div class="field"><label>Precio del m³ elaborado</label><div class="inline"><b>$</b><input id="price" type="number" value="180000"></div></div><div class="field"><label>Capacidad del camión</label><div class="inline"><input id="truck" type="number" value="8"><b>m³</b></div></div></div><section class="result"><div class="result-top"><div><small id="result-label">Hormigón total con desperdicio</small><div class="value" id="result-value">3,15 m³</div></div><div class="verdict"><small>Pedido sugerido</small><strong id="verdict">3,2 m³</strong></div></div><div class="stats"><span>Volumen geométrico<b id="s1">3,00 m³</b></span><span>Cemento<b id="s2">23 bolsas</b></span><span>Costo elaborado<b id="s3">$567.000</b></span></div><button class="go" id="update" type="button">Actualizar cómputo</button></section></form></div></section>
<section class="scale-section"><div class="wrap"><header class="center"><span>La mezcla completa</span><h2>De metros cúbicos a materiales</h2><p>La resistencia elegida define cuánto cemento lleva cada metro cúbico.</p></header><div class="scale-card"><div class="meter"><i class="pin" id="pin" data-value="H-21"></i></div><div class="meter-labels"><div><b>H-13 / H-17</b>No estructural o liviano</div><div><b>H-21</b>Estructura estándar</div><div><b>H-25 / H-30</b>Mayor resistencia</div></div><div class="meter-summary"><span id="scale-copy">H-21 usa 350 kg de cemento por m³.</span><b id="scale-result">1.103 kg de cemento total</b></div></div></div></section>
<section class="breakdown"><div class="wrap break-grid"><article class="card"><h3>Tu lista para el corralón</h3><div class="line"><span>Cemento</span><b id="d1">23 bolsas de 50 kg</b></div><div class="line"><span>Arena</span><b id="d2">1,58 m³</b></div><div class="line"><span>Piedra partida</span><b id="d3">2,36 m³</b></div><div class="line"><span>Agua de amasado</span><b id="d4">567 litros</b></div><div class="line total"><strong>Hormigón total</strong><b id="df">3,15 m³</b></div></article><article class="card"><h3>Antes de pedir</h3><div class="step"><i>1</i><div><b>Confirmá la resistencia</b><span>La define el proyecto estructural, no el precio.</span></div></div><div class="step"><i>2</i><div><b>Medí en obra</b><span>Revisá espesores y secciones reales.</span></div></div><div class="step"><i>3</i><div><b>Coordiná la descarga</b><span>Acceso, bomba, personal y curado listos.</span></div></div><div class="warning">⚠️ Predimensionado orientativo. No reemplaza cálculo estructural ni dirección profesional.</div></article></div></section>
<section class="tips"><div class="wrap"><header class="center"><span>Cuatro decisiones de obra</span><h2>Lo que más cambia el resultado</h2></header><div class="tip-grid"><article class="tip"><i>📏</i><h3>Espesor real</h3><p>Dos centímetros extra en una losa grande pesan mucho.</p><span class="impact">Medí varias zonas</span></article><article class="tip"><i>🧱</i><h3>Resistencia</h3><p>No bajes la clase para ahorrar cemento.</p><span class="impact">Seguridad primero</span></article><article class="tip"><i>➕</i><h3>Desperdicio</h3><p>En obra chica suele usarse entre 5% y 10%.</p><span class="impact">Evitá quedarte corto</span></article><article class="tip"><i>💧</i><h3>Agua y curado</h3><p>Agregar agua de más reduce la resistencia final.</p><span class="impact">Curá 7 días</span></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">¿Mezcla o elaborado?</span><h2>Desde 1 m³ suele convenir hormigón elaborado.</h2><p>Llega dosificado, con resistencia controlada y reduce la variabilidad del mezclado manual.</p></div><div class="compare"><div><small>VOLUMEN A PEDIR</small><b id="cmp1">3,2 m³</b><span>Incluye desperdicio</span></div><div><small>CAMIONES</small><b id="cmp2">1 viaje</b><span id="cmp-truck">Capacidad 8 m³</span></div><div><small>COSTO REFERENCIAL</small><b id="cmp3">$567.000</b><span>Editá el precio local</span></div></div></div></section><div class="foot"></div><button type="button" id="date-result" hidden aria-hidden="true"></button><button type="button" id="progress-result" hidden aria-hidden="true"></button><button type="button" id="fund-result" hidden aria-hidden="true"></button><button type="button" id="art-consumption" hidden aria-hidden="true"></button><button type="button" id="art-cost" hidden aria-hidden="true"></button><button type="button" id="scale-verdict" hidden aria-hidden="true"></button><button type="button" id="detail-last" hidden aria-hidden="true"></button><button type="button" id="detail-interval" hidden aria-hidden="true"></button><button type="button" id="detail-used" hidden aria-hidden="true"></button><button type="button" id="detail-next" hidden aria-hidden="true"></button><button type="button" id="detail-left" hidden aria-hidden="true"></button><button type="button" id="cmp-low" hidden aria-hidden="true"></button><button type="button" id="cmp-current" hidden aria-hidden="true"></button><button type="button" id="cmp-high" hidden aria-hidden="true"></button><button type="button" id="cmp-current-cost" hidden aria-hidden="true"></button><button type="button" id="province" hidden aria-hidden="true"></button><button type="button" id="rate" hidden aria-hidden="true"></button><button type="button" id="quota-value" hidden aria-hidden="true"></button><button type="button" id="cash-value" hidden aria-hidden="true"></button><button type="button" id="month-value" hidden aria-hidden="true"></button><button type="button" id="d-valuation" hidden aria-hidden="true"></button><button type="button" id="d-rate" hidden aria-hidden="true"></button><button type="button" id="d-year" hidden aria-hidden="true"></button><button type="button" id="d-discount" hidden aria-hidden="true"></button><button type="button" id="d-final" hidden aria-hidden="true"></button><button type="button" id="cmp-name" hidden aria-hidden="true"></button><button type="button" id="digits" hidden aria-hidden="true"></button><button type="button" id="d1l" hidden aria-hidden="true"></button><button type="button" id="d2l" hidden aria-hidden="true"></button><button type="button" id="d3l" hidden aria-hidden="true"></button><button type="button" id="d4l" hidden aria-hidden="true"></button><button type="button" id="df-label" hidden aria-hidden="true"></button><button type="button" id="pre2" hidden aria-hidden="true"></button><button type="button" id="pre3" hidden aria-hidden="true"></button><button type="button" id="date" hidden aria-hidden="true"></button><button type="button" id="night-sunday" hidden aria-hidden="true"></button><button type="button" id="limit-warning" hidden aria-hidden="true"></button><button type="button" id="transport" hidden aria-hidden="true"></button><button type="button" id="stage" hidden aria-hidden="true"></button><button type="button" id="cl-search" hidden aria-hidden="true"></button><button type="button" id="no-results" hidden aria-hidden="true"></button><button type="button" id="cl-search-btn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-hormigon')?document.currentScript.previousElementSibling:document.querySelector('.mockup-hormigon');


let concreteMode="slab";const q$=s=>root.querySelector(s),qn=id=>Math.max(0,Number(q$(id).value)||0),qm=x=>"$"+new Intl.NumberFormat("es-AR",{maximumFractionDigits:0}).format(x),qd=x=>x.toFixed(2).replace(".",",");const shapes={slab:{labels:["Largo","Ancho","Espesor"],units:["m","m","cm"],vals:[10,3,10],formula:"Largo × ancho × espesor"},column:{labels:["Cantidad","Lado de la columna","Altura"],units:["unid.","cm","m"],vals:[4,30,3],formula:"Cantidad × lado² × altura"},beam:{labels:["Largo total","Ancho","Alto"],units:["m","cm","cm"],vals:[12,40,30],formula:"Largo × ancho × alto"},volume:{labels:["Volumen conocido","No se usa","No se usa"],units:["m³","",""],vals:[3,0,0],formula:"Volumen informado"}};
function setConcrete(m){concreteMode=m;let x=shapes[m];["1","2","3"].forEach((k,i)=>{q$("#l"+k).textContent=x.labels[i];q$("#u"+k).textContent=x.units[i];q$("#v"+k).value=x.vals[i]});q$("#formula-note").textContent=x.formula;concreteCalc()}
function concreteCalc(){let a=qn("#v1"),b=qn("#v2"),c=qn("#v3"),vol=concreteMode==="slab"?a*b*c/100:concreteMode==="column"?a*(b/100)**2*c:concreteMode==="beam"?a*(b/100)*(c/100):a,waste=qn("#waste")/100,total=vol*(1+waste),cementKg=total*Number(q$("#grade").value),bags=Math.ceil(cementKg/50),sand=total*.5,stone=total*.75,water=total*180,price=qn("#price"),truck=Math.max(.1,qn("#truck")),trips=Math.ceil(total/truck),grade=q$("#grade").selectedOptions[0].text.split(" · ")[0];q$("#result-value").textContent=qd(total)+" m³";q$("#verdict").textContent=(Math.ceil(total*10)/10).toFixed(1).replace(".",",")+" m³";q$("#s1").textContent=qd(vol)+" m³";q$("#s2").textContent=bags+" bolsas";q$("#s3").textContent=qm(total*price);q$("#art-value").textContent=qd(total)+" m³";q$("#art-place").textContent=grade+" · +"+qn("#waste")+"%";q$("#pin").style.left=({"H-13":10,"H-17":27,"H-21":50,"H-25":72,"H-30":92}[grade]||50)+"%";q$("#pin").dataset.value=grade;q$("#scale-copy").textContent=grade+" usa "+q$("#grade").value+" kg de cemento por m³.";q$("#scale-result").textContent=new Intl.NumberFormat("es-AR").format(Math.round(cementKg))+" kg de cemento total";q$("#d1").textContent=bags+" bolsas de 50 kg";q$("#d2").textContent=qd(sand)+" m³";q$("#d3").textContent=qd(stone)+" m³";q$("#d4").textContent=Math.round(water)+" litros";q$("#df").textContent=qd(total)+" m³";q$("#cmp1").textContent=(Math.ceil(total*10)/10).toFixed(1).replace(".",",")+" m³";q$("#cmp2").textContent=trips+" viaje"+(trips===1?"":"s");q$("#cmp-truck").textContent="Capacidad "+truck+" m³";q$("#cmp3").textContent=qm(total*price)}
root.querySelectorAll(".case").forEach(x=>x.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(y=>y.classList.remove("active"));x.classList.add("active");setConcrete(x.dataset.mode)}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",concreteCalc));q$("#advanced-toggle").addEventListener("click",e=>{q$("#extra-fields").classList.toggle("open");e.currentTarget.textContent=q$("#extra-fields").classList.contains("open")?"− Ocultar precio":"+ Agregar precio"});q$("#update").addEventListener("click",e=>{e.preventDefault();concreteCalc();e.currentTarget.textContent="✓ Cómputo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar cómputo",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());concreteCalc();

})();
</script>
<style is:global>

