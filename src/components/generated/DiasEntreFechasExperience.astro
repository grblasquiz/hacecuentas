---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-dias-entre-fechas" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>Fechas</b> / Días entre dos fechas</div><div class="grid"><div><div class="eyebrow">Calculadora de fechas</div><h1>¿Cuántos días hay entre dos fechas?</h1><p class="lead">Contá días corridos y hábiles, incluí o excluí los extremos y entendé el período en semanas. Sin cuentas manuales ni errores de calendario.</p><div class="chips"><span>✓ Años bisiestos</span><span>✓ Fines de semana</span><span>✓ Feriados nacionales 2026</span></div></div>
<section class="calc"><div class="form"><div class="calc-head"><div><h2>Elegí las fechas</h2><p>Podés invertirlas o usar un plazo rápido.</p></div><span class="tag">Privado</span></div><div class="dates"><div class="field"><label>Fecha inicial</label><input id="start" type="date" value="2026-07-01"></div><button class="swap" id="swap" type="button" aria-label="Intercambiar fechas">⇄</button><div class="field"><label>Fecha final</label><input id="end" type="date" value="2026-07-31"></div></div><div class="options"><button class="switch" id="inclusive" type="button" aria-label="Incluir ambas fechas"></button><span>Incluir la fecha inicial y la final</span></div><div class="presets"><small>PLAZOS RÁPIDOS</small><button class="preset" data-days="7">+7 días</button><button class="preset" data-days="15">+15 días</button><button class="preset" data-days="30">+30 días</button><button class="preset" id="monthEnd">Fin de mes</button></div><button class="calculate" id="calculate" type="button">Calcular diferencia</button></div>
<div class="result"><small>ENTRE LAS DOS FECHAS HAY</small><div class="result-top"><div><div class="big"><b id="totalDays">31</b> <span>días</span></div><div class="range" id="rangeLabel">Del 1 al 31 de julio de 2026 · incluyendo ambas fechas</div></div></div><div class="stats"><div class="stat"><b id="businessDays">22</b><span>DÍAS HÁBILES</span></div><div class="stat"><b id="nonBusinessDays">9</b><span>NO LABORABLES</span></div><div class="stat"><b id="weeksLabel">4 + 3</b><span>SEMANAS + DÍAS</span></div></div><div class="bar"></div><div class="ends"><span id="startLabel">1 jul</span><span id="endLabel">31 jul</span></div></div></section></div></div></section>
<section class="section"><div class="wrap"><header class="section-head"><span>Planificá sin volver a contar</span><h2>Plazos frecuentes desde una fecha</h2><p>Cambiá la fecha base y mirá vencimientos habituales al instante.</p></header><article class="deadline"><div class="deadline-top"><div><h3>¿En qué fecha cae?</h3><p>Días corridos desde la fecha base.</p></div><div class="base"><label>FECHA BASE</label><input id="base" type="date" value="2026-07-01"></div></div><div class="deadline-grid" id="deadlineGrid"></div></article></div></section>
<section class="section tint"><div class="wrap"><header class="section-head"><span>Cómo leer el resultado</span><h2>Una diferencia, tres formas de contarla</h2></header><div class="info-grid"><article class="info"><i>31</i><h3>Días corridos</h3><p>Incluyen sábados, domingos y feriados. Son los días de calendario entre ambos extremos.</p></article><article class="info"><i>✓</i><h3>Días hábiles</h3><p>Excluyen fines de semana y los feriados nacionales cargados para Argentina.</p></article><article class="info"><i>⇄</i><h3>Conteo inclusivo</h3><p>Cuando está activo, cuenta tanto el día inicial como el final. Apagalo si el plazo empieza al día siguiente.</p></article></div><div class="note">Para plazos judiciales, administrativos o laborales, verificá ferias, asuetos y reglas específicas del organismo correspondiente.</div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-dias-entre-fechas')?document.currentScript.previousElementSibling:document.querySelector('.mockup-dias-entre-fechas');

const $=s=>root.querySelector(s),start=$("#start"),end=$("#end"),holidays=new Set(["2026-01-01","2026-02-16","2026-02-17","2026-03-24","2026-04-02","2026-04-03","2026-05-01","2026-05-25","2026-06-15","2026-06-20","2026-07-09","2026-08-17","2026-10-12","2026-11-20","2026-12-08","2026-12-25"]);let inclusive=true;
function parse(v){if(!/^\d{4}-\d{2}-\d{2}$/.test(v||""))return null;const [y,m,d]=v.split("-").map(Number),date=new Date(y,m-1,d,12);return date.getFullYear()===y&&date.getMonth()===m-1&&date.getDate()===d?date:null}function iso(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`}function short(d){return new Intl.DateTimeFormat("es-AR",{day:"numeric",month:"short"}).format(d).replace(".","")}function long(d){return new Intl.DateTimeFormat("es-AR",{day:"numeric",month:"long",year:"numeric"}).format(d)}
function calc(){let a=parse(start.value),b=parse(end.value);if(!a||!b)return;if(a>b)[a,b]=[b,a];const raw=Math.round((b-a)/864e5),total=raw+(inclusive?1:0);let business=0,c=new Date(a);if(!inclusive)c.setDate(c.getDate()+1);while(c<=b){if(c.getDay()!==0&&c.getDay()!==6&&!holidays.has(iso(c)))business++;c.setDate(c.getDate()+1)}$("#totalDays").textContent=total;$("#businessDays").textContent=business;$("#nonBusinessDays").textContent=Math.max(0,total-business);$("#weeksLabel").textContent=`${Math.floor(total/7)} + ${total%7}`;$("#rangeLabel").textContent=`Del ${long(a)} al ${long(b)} · ${inclusive?"incluyendo ambas fechas":"sin contar el día inicial"}`;$("#startLabel").textContent=short(a);$("#endLabel").textContent=short(b)}
function deadlines(){const base=parse($("#base").value),items=[7,10,15,30,60,90];if(!base)return;$("#deadlineGrid").innerHTML=items.map(n=>{const d=new Date(base);d.setDate(d.getDate()+n);return `<div class="deadline-card ${n===30?"featured":""}"><small>EN ${n} DÍAS</small><b>${short(d)}</b><span>${d.getFullYear()}</span></div>`}).join("")}
$("#calculate").onclick=e=>{const button=e.currentTarget;calc();button.textContent="✓ Diferencia calculada";setTimeout(()=>button.textContent="Calcular diferencia",1200)};$("#swap").onclick=()=>{const v=start.value;start.value=end.value;end.value=v;calc()};$("#inclusive").onclick=e=>{inclusive=!inclusive;e.currentTarget.classList.toggle("off",!inclusive);calc()};root.querySelectorAll("[data-days]").forEach(b=>b.onclick=()=>{const d=parse(start.value);if(!d)return;d.setDate(d.getDate()+Number(b.dataset.days));end.value=iso(d);calc()});$("#monthEnd").onclick=()=>{const d=parse(start.value);if(!d)return;end.value=iso(new Date(d.getFullYear(),d.getMonth()+1,0,12));calc()};start.oninput=end.oninput=calc;$("#base").oninput=deadlines;calc();deadlines();

})();
</script>
<style is:global>

.mockup-dias-entre-fechas{--ink:#14223a;--muted:#68758a;--line:#dfe5ea;--navy:#172f4c;--teal:#1193a3;--blue:#4667dd;--mint:#e4f7f5;--amber:#ffbd64;--wash:#f6f9fb}.mockup-dias-entre-fechas *{box-sizing:border-box}.mockup-dias-entre-fechas{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:var(--ink)}.mockup-dias-entre-fechas button,.mockup-dias-entre-fechas input{font:inherit}.mockup-dias-entre-fechas .wrap{width:min(1180px,calc(100% - 40px));margin:auto}.mockup-dias-entre-fechas .top{height:80px;border-bottom:1px solid var(--line)}.mockup-dias-entre-fechas .nav,.mockup-dias-entre-fechas .brand,.mockup-dias-entre-fechas .links,.mockup-dias-entre-fechas .tools{display:flex;align-items:center}.mockup-dias-entre-fechas .nav{height:100%;justify-content:space-between}.mockup-dias-entre-fechas .brand{gap:10px;font-size:18px;font-weight:900}.mockup-dias-entre-fechas .logo{width:32px;height:32px;border-radius:8px;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:11px}.mockup-dias-entre-fechas .links{gap:27px;color:#566378;font-size:12px;font-weight:750}.mockup-dias-entre-fechas .tools{gap:10px}.mockup-dias-entre-fechas .tool{border:1px solid var(--line);border-radius:11px;padding:10px 14px;font-size:11px;font-weight:700}.mockup-dias-entre-fechas .dark{background:var(--navy);color:#fff}
.mockup-dias-entre-fechas .hero{padding:30px 0 73px;background:radial-gradient(circle at 12% 30%,#e2f8f7 0,transparent 30%),radial-gradient(circle at 90% 5%,#e6edff 0,transparent 27%),linear-gradient(180deg,#fcfefe,#f4f8fb)}.mockup-dias-entre-fechas .crumb{font-size:12px;color:#758196;margin-bottom:34px}.mockup-dias-entre-fechas .crumb b{color:var(--teal)}.mockup-dias-entre-fechas .grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:56px}.mockup-dias-entre-fechas .eyebrow{color:#087d8a;text-transform:uppercase;letter-spacing:.16em;font-size:11px;font-weight:900;display:flex;align-items:center;gap:10px;margin:8px 0 18px}.mockup-dias-entre-fechas .eyebrow:before{content:"";width:28px;height:2px;background:var(--teal)}.mockup-dias-entre-fechas h1{font-size:56px;line-height:.98;letter-spacing:-.058em;margin:0 0 22px}.mockup-dias-entre-fechas .lead{font-size:18px;line-height:1.55;color:var(--muted)}.mockup-dias-entre-fechas .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:25px}.mockup-dias-entre-fechas .chips span{border:1px solid var(--line);background:#fff;border-radius:99px;padding:8px 11px;font-size:10px;color:#596c7e}
.mockup-dias-entre-fechas .calc{background:#fff;border:1px solid #d9e2e8;border-radius:23px;overflow:hidden;box-shadow:0 24px 62px #17304c16}.mockup-dias-entre-fechas .form{padding:27px}.mockup-dias-entre-fechas .calc-head{display:flex;justify-content:space-between}.mockup-dias-entre-fechas .calc h2{font-size:26px;letter-spacing:-.04em;margin:0}.mockup-dias-entre-fechas .calc-head p{font-size:12px;color:var(--muted);margin:5px 0}.mockup-dias-entre-fechas .tag{background:var(--mint);color:#08776e;border-radius:99px;padding:7px 10px;height:max-content;font-size:10px;font-weight:850}.mockup-dias-entre-fechas .dates{display:grid;grid-template-columns:1fr 42px 1fr;align-items:end;gap:10px;margin-top:21px}.mockup-dias-entre-fechas .field label{font-size:10px;font-weight:850;color:#56657a;display:block;margin:0 0 7px}.mockup-dias-entre-fechas .field input{width:100%;height:52px;padding:0 12px;border:1px solid #ccd6de;border-radius:12px;color:var(--ink);font-weight:800;outline:none}.mockup-dias-entre-fechas .field input:focus{border-color:var(--teal);box-shadow:0 0 0 3px #1193a31a}.mockup-dias-entre-fechas .swap{height:42px;margin-bottom:5px;border:1px solid var(--line);border-radius:11px;background:#f5fbfb;color:var(--teal);font-size:19px;font-weight:900;cursor:pointer}.mockup-dias-entre-fechas .options{display:flex;align-items:center;gap:11px;border-top:1px solid #edf1f3;margin-top:18px;padding-top:16px}.mockup-dias-entre-fechas .switch{width:40px;height:23px;border:0;border-radius:99px;background:var(--teal);position:relative;cursor:pointer}.mockup-dias-entre-fechas .switch:after{content:"";width:17px;height:17px;position:absolute;right:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.mockup-dias-entre-fechas .switch.off{background:#c7d0d7}.mockup-dias-entre-fechas .switch.off:after{right:20px}.mockup-dias-entre-fechas .options span{font-size:11px;color:#536277;font-weight:750}.mockup-dias-entre-fechas .presets{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:16px}.mockup-dias-entre-fechas .presets small{font-size:9px;color:#8691a0;font-weight:850}.mockup-dias-entre-fechas .preset{border:1px solid var(--line);background:#fff;border-radius:99px;padding:7px 10px;font-size:9px;color:#5f6c7f;font-weight:800;cursor:pointer}.mockup-dias-entre-fechas .calculate{width:100%;border:0;border-radius:12px;background:linear-gradient(120deg,var(--teal),var(--blue));color:#fff;padding:14px;font-weight:900;margin-top:17px;cursor:pointer}
.mockup-dias-entre-fechas .result{background:linear-gradient(135deg,#142a49,#183c59 58%,#087d88);color:#fff;padding:23px 27px}.mockup-dias-entre-fechas .result small{font-size:9px;color:#bcd4dd;letter-spacing:.1em}.mockup-dias-entre-fechas .result-top{display:flex;justify-content:space-between;align-items:end}.mockup-dias-entre-fechas .big{font-size:59px;line-height:1;font-weight:900;letter-spacing:-.06em}.mockup-dias-entre-fechas .big span{font-size:16px;letter-spacing:0;color:#d3e2e7}.mockup-dias-entre-fechas .range{font-size:10px;color:#aac0ca;margin-top:5px}.mockup-dias-entre-fechas .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:17px}.mockup-dias-entre-fechas .stat{border:1px solid #ffffff1d;background:#ffffff0d;border-radius:11px;padding:12px}.mockup-dias-entre-fechas .stat b{display:block;font-size:19px}.mockup-dias-entre-fechas .stat span{font-size:8px;color:#bacbd3;letter-spacing:.07em}.mockup-dias-entre-fechas .bar{height:6px;border-radius:99px;background:linear-gradient(90deg,#55d7b0 0 71%,var(--amber) 71%);margin-top:17px}.mockup-dias-entre-fechas .ends{display:flex;justify-content:space-between;font-size:9px;color:#aebfc9;margin-top:7px}
.mockup-dias-entre-fechas .section{padding:74px 0}.mockup-dias-entre-fechas .section.tint{background:var(--wash)}.mockup-dias-entre-fechas .section-head{text-align:center;max-width:690px;margin:0 auto 36px}.mockup-dias-entre-fechas .section-head span{color:var(--teal);font-size:10px;letter-spacing:.15em;text-transform:uppercase;font-weight:900}.mockup-dias-entre-fechas .section-head h2{font-size:38px;letter-spacing:-.045em;margin:9px 0}.mockup-dias-entre-fechas .section-head p{color:var(--muted);line-height:1.55}.mockup-dias-entre-fechas .deadline{border:1px solid var(--line);border-radius:20px;padding:25px;background:#fff}.mockup-dias-entre-fechas .deadline-top{display:flex;justify-content:space-between;align-items:end}.mockup-dias-entre-fechas .deadline h3{font-size:22px;margin:0}.mockup-dias-entre-fechas .deadline p{font-size:11px;color:var(--muted);margin:4px 0}.mockup-dias-entre-fechas .base label{font-size:9px;color:var(--muted);font-weight:850;display:block;margin-bottom:5px}.mockup-dias-entre-fechas .base input{height:40px;border:1px solid var(--line);border-radius:10px;padding:0 10px;font-weight:750}.mockup-dias-entre-fechas .deadline-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-top:21px}.mockup-dias-entre-fechas .deadline-card{border:1px solid var(--line);border-radius:13px;padding:14px}.mockup-dias-entre-fechas .deadline-card.featured{border-color:#8fd5d8;background:#eafafa}.mockup-dias-entre-fechas .deadline-card small{font-size:8px;color:#7d8999}.mockup-dias-entre-fechas .deadline-card b{display:block;font-size:14px;margin:5px 0}.mockup-dias-entre-fechas .deadline-card span{font-size:9px;color:var(--muted)}
.mockup-dias-entre-fechas .info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.mockup-dias-entre-fechas .info{border:1px solid var(--line);border-radius:18px;padding:21px;background:#fff}.mockup-dias-entre-fechas .info i{font-style:normal;width:37px;height:37px;border-radius:11px;background:var(--mint);color:var(--teal);display:grid;place-items:center;font-weight:900}.mockup-dias-entre-fechas .info h3{font-size:16px;margin:15px 0 7px}.mockup-dias-entre-fechas .info p{font-size:11px;line-height:1.55;color:var(--muted);margin:0}.mockup-dias-entre-fechas .note{margin-top:18px;background:#fff8e8;border:1px solid #efd79e;border-radius:13px;padding:14px;color:#70582a;font-size:11px}
@media(max-width:850px){.mockup-dias-entre-fechas .links{display:none}.mockup-dias-entre-fechas .grid{grid-template-columns:1fr}.mockup-dias-entre-fechas h1{font-size:44px}.mockup-dias-entre-fechas .deadline-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:560px){.mockup-dias-entre-fechas .wrap{width:calc(100% - 24px)}.mockup-dias-entre-fechas .tools .tool:first-child{display:none}.mockup-dias-entre-fechas h1{font-size:39px}.mockup-dias-entre-fechas .dates{grid-template-columns:1fr}.mockup-dias-entre-fechas .swap{width:42px;margin:auto;transform:rotate(90deg)}.mockup-dias-entre-fechas .stats,.mockup-dias-entre-fechas .info-grid{grid-template-columns:1fr}.mockup-dias-entre-fechas .deadline-top{display:block}.mockup-dias-entre-fechas .base{margin-top:15px}.mockup-dias-entre-fechas .deadline-grid{grid-template-columns:1fr 1fr}.mockup-dias-entre-fechas .big{font-size:49px}.mockup-dias-entre-fechas .section{padding:54px 0}}

.mockup-dias-entre-fechas { width:100%; overflow:hidden; }
.mockup-dias-entre-fechas .top, .mockup-dias-entre-fechas header.top { display:none !important; }
.mockup-dias-entre-fechas .foot { display:none !important; }
.mockup-dias-entre-fechas .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-dias-entre-fechas .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-dias-entre-fechas .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-dias-entre-fechas .support-real summary { cursor:pointer; font-weight:750; }
.mockup-dias-entre-fechas .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-dias-entre-fechas :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-dias-entre-fechas input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-dias-entre-fechas input[type="number"]::-webkit-inner-spin-button, .mockup-dias-entre-fechas input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-dias-entre-fechas .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-dias-entre-fechas support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
