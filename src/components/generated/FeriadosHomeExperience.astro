---
import { MESES, META } from '../../lib/data/feriados-ar-2026';
import {
  CALENDARIO_COMPLETO, FIN, INICIO, calcularCalendario, diaSemana, diasHasta, fechaCorta,
  hoyEnBuenosAires, intervaloValido, proximoFeriado, resultadoCalendario,
} from '../../lib/feriados-calendario';

const hoy = hoyEnBuenosAires();
const desde = intervaloValido(hoy, FIN) ? hoy : '';
const siguiente = proximoFeriado(hoy);
const inicial = resultadoCalendario('next', desde, FIN, 'nacional', false, 1);
const escapadas = desde ? calcularCalendario(desde, FIN, 'nacional', false, 1).findes : [];
const faltan = siguiente ? diasHasta(hoy, siguiente.fecha) : 0;
const tipos: Record<string, string> = {
  nacional: 'Feriado nacional',
  puente: 'Día no laborable turístico',
  'no-laborable': 'Día no laborable',
  bancario: 'Feriado bancario',
};
---
<div class="mockup-feriados-home">
  <div class="hero">
    <div class="wrap">
      <div class="crumb">Fechas / Feriados nacionales</div>
      <div class="heroGrid">
        <div>
          <span class="eyebrow">Calendario argentino {META.anio}</span>
          <h1>¿Cuándo es el próximo feriado?</h1>
          <p class="lead">Consultá los feriados nacionales, los días no laborables turísticos y los cierres bancarios. Calculá días hábiles y planificá fines de semana largos.</p>
          {siguiente ? (
            <div class="miniCalendar">
              <time class="dateSheet" id="next-national-holiday" datetime={siguiente.fecha}>
                <b>{MESES[siguiente.mes]}</b>
                <strong>{Number(siguiente.fecha.slice(-2))}</strong>
                <span>{diaSemana(siguiente.fecha)}</span>
              </time>
              <div class="miniCopy">
                <strong>{faltan ? 'Próximo feriado nacional' : 'Hoy es feriado nacional'}</strong>
                <span>{siguiente.nombre}</span>
                {faltan > 0 && <span>Faltan {faltan} {faltan === 1 ? 'día' : 'días'}.</span>}
              </div>
            </div>
          ) : (
            <p class="lead">Ya pasaron los feriados nacionales de {META.anio}. Consultá el calendario de 2027 más abajo.</p>
          )}
        </div>

        <div class="planner">
          <div class="plannerHead"><div><h2>¿Qué querés saber?</h2><p>La fecha inicial es la de Buenos Aires.</p></div></div>
          <div class="views" aria-label="Vista de la calculadora">
            <button type="button" class="view active" data-view="next" aria-pressed="true">Próximo feriado</button>
            <button type="button" class="view" data-view="business" aria-pressed="false">Días hábiles</button>
            <button type="button" class="view" data-view="long" aria-pressed="false">Findes largos</button>
          </div>
          <form class="calendar-form">
            <div class="fields">
              <div class="field">
                <label for="from">Contar desde</label>
                <input id="from" type="date" value={desde} min={INICIO} max={FIN} required />
              </div>
              <div class="field">
                <label for="to">Contar hasta</label>
                <input id="to" type="date" value={FIN} min={INICIO} max={FIN} required />
              </div>
              <div class="field">
                <label for="calendar">Calendario</label>
                <select id="calendar" aria-describedby="calendar-help">
                  <option value="nacional">Nacional · feriados</option>
                  <option value="no-laborables">Nacional · también turísticos</option>
                  <option value="bancario">Bancario · BCRA</option>
                </select>
              </div>
              <div class="field">
                <label for="saturday">¿Trabajás los sábados?</label>
                <select id="saturday"><option value="0">No</option><option value="1">Sí</option></select>
              </div>
              <div class="field">
                <label for="leave">Días de licencia por finde</label>
                <input id="leave" type="number" min="0" max="30" value="1" />
              </div>
            </div>
            <p id="calendar-help">Si tu empleador da los días no laborables turísticos, elegí «Nacional · también turísticos». El calendario bancario siempre excluye los sábados.</p>
            <button class="primary" type="submit">Actualizar calendario</button>
          </form>
          <div class="result" aria-live="polite">
            <small id="resultLabel">{inicial.titulo}</small>
            <div class="answer">
              <div class="big" id="answer">{inicial.texto}</div>
              <span class="badge" id="badge" hidden={!inicial.badge}>{inicial.badge}</span>
            </div>
            <p id="description">{inicial.detalle}</p>
            <div class="stats">
              <div class="stat"><span>FERIADOS NACIONALES</span><b id="remaining">{inicial.feriados}</b></div>
              <div class="stat"><span>DÍAS HÁBILES</span><b id="business">{inicial.habiles}</b></div>
              <div class="stat"><span>FINES LARGOS</span><b id="longCount">{inicial.findes}</b></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="sectionHead">
        <h2>Calendario de feriados {META.anio}</h2>
        <p>Filtrá por tipo o mes. Las fechas trasladables figuran el día que se observan.</p>
      </div>
      <div class="toolbar">
        <div class="filters" aria-label="Tipo de fecha">
          <button type="button" class="filter active" data-type="all" aria-pressed="true">Todos</button>
          <button type="button" class="filter" data-type="nacional" aria-pressed="false">Feriados nacionales</button>
          <button type="button" class="filter" data-type="no-laborable" aria-pressed="false">No laborables</button>
          <button type="button" class="filter" data-type="bancario" aria-pressed="false">Solo bancarios</button>
          <button type="button" class="filter" data-type="upcoming" aria-pressed="false">Próximos</button>
        </div>
        <select class="monthSelect" id="month" aria-label="Mes del calendario">
          <option value="all">Todos los meses</option>
          {MESES.slice(1).map((mes, indice) => <option value={String(indice + 1).padStart(2, '0')}>{mes}</option>)}
        </select>
      </div>
      <div class="holidays" id="holidayList">
        {CALENDARIO_COMPLETO.map(({ fecha, nombre, grupo, trasladadoDe }) => (
          <article class:list={['holiday', grupo === 'puente' && 'bridge']} data-date={fecha} data-group={grupo}>
            <time class="date" datetime={fecha}>
              <span>{MESES[Number(fecha.slice(5, 7))].slice(0, 3)}</span>
              <b>{Number(fecha.slice(-2))}</b>
            </time>
            <div>
              <h3>{nombre}</h3>
              <p>{diaSemana(fecha)}{trasladadoDe && ` · trasladado del ${fechaCorta(trasladadoDe)}`}</p>
            </div>
            <span class="kind">{tipos[grupo]}</span>
          </article>
        ))}
      </div>
      <p class="empty" id="empty" hidden>No hay fechas para ese filtro.</p>
    </div>
  </section>

  {escapadas.length > 0 && (
    <section class="tint">
      <div class="wrap">
        <div class="sectionHead">
          <h2>Próximos fines de semana largos</h2>
          <p>Con sábados y domingos libres, hasta un día de licencia y los días turísticos laborables.</p>
        </div>
        <div class="weekends">
          {escapadas.map((finde) => (
            <article class="trip">
              <small>{finde.licencias ? 'Con un día de licencia' : 'Sin pedir licencia'}</small>
              <h3>Del {fechaCorta(finde.desde)} al {fechaCorta(finde.hasta)}</h3>
              <p>{finde.dias} días seguidos de descanso.</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <div class="info">
        <article class="panel">
          <h3>Feriado nacional</h3>
          <p>El lunes 23 de noviembre se observa el Día de la Soberanía Nacional, trasladado del viernes 20. El martes 8 de diciembre es feriado inamovible por la Inmaculada Concepción de María.</p>
          <p><a href="https://www.argentina.gob.ar/normativa/nacional/ley-27399-281835/texto">Ley 27.399, artículos 1 y 6</a></p>
        </article>
        <article class="panel">
          <h3>Día no laborable turístico</h3>
          <p>El lunes 7 de diciembre es un día no laborable con fines turísticos. En general, el empleador decide si se trabaja.</p>
          <p><a href="https://www.argentina.gob.ar/normativa/nacional/norma-421799/texto">Resolución JGM 164/2025</a></p>
        </article>
        <article class="panel">
          <h3>Calendario bancario</h3>
          <p>El BCRA incluye el 23 de noviembre y el 7 y 8 de diciembre entre las fechas de cierre. La herramienta cubre el calendario nacional y bancario de 2026 y excluye las fechas locales.</p>
          <p><a href="https://www.bcra.gob.ar/consulta-feriados-bancarios-2026/">Feriados bancarios 2026 del BCRA</a></p>
        </article>
      </div>
    </div>
  </section>
</div>

<script>
  import { hoyEnBuenosAires, resultadoCalendario } from '../../lib/feriados-calendario';
  import type { Calendario, Vista } from '../../lib/feriados-calendario';

  const root = document.querySelector<HTMLElement>('.mockup-feriados-home');
  if (root) {
    const from = root.querySelector<HTMLInputElement>('#from')!;
    const to = root.querySelector<HTMLInputElement>('#to')!;
    const calendar = root.querySelector<HTMLSelectElement>('#calendar')!;
    const saturday = root.querySelector<HTMLSelectElement>('#saturday')!;
    const leave = root.querySelector<HTMLInputElement>('#leave')!;
    const month = root.querySelector<HTMLSelectElement>('#month')!;
    const empty = root.querySelector<HTMLElement>('#empty')!;
    const rows = Array.from(root.querySelectorAll<HTMLElement>('#holidayList [data-date]'));
    const views = root.querySelectorAll<HTMLButtonElement>('.view');
    const filters = root.querySelectorAll<HTMLButtonElement>('.filter');
    let view: Vista = 'next';
    let filter = 'all';

    function activate(buttons: NodeListOf<HTMLButtonElement>, active: HTMLButtonElement) {
      buttons.forEach((button) => {
        button.classList.toggle('active', button === active);
        button.setAttribute('aria-pressed', String(button === active));
      });
    }

    function update() {
      saturday.disabled = calendar.value === 'bancario';
      const result = resultadoCalendario(
        view, from.value, to.value, calendar.value as Calendario, saturday.value === '1',
        Math.max(0, Math.min(30, Math.floor(leave.valueAsNumber || 0))),
      );
      const fields = {
        resultLabel: result.titulo, answer: result.texto, badge: result.badge,
        description: result.detalle, remaining: result.feriados, business: result.habiles,
        longCount: result.findes,
      };
      for (const [id, value] of Object.entries(fields)) {
        root!.querySelector<HTMLElement>(`#${id}`)!.textContent = String(value);
      }
      root!.querySelector<HTMLElement>('#badge')!.hidden = !result.badge;
    }

    function renderCalendar() {
      let count = 0;
      const today = hoyEnBuenosAires();
      for (const row of rows) {
        const { date, group } = row.dataset;
        const matchesType = filter === 'all' || filter === group ||
          (filter === 'upcoming' && date! >= today) || (filter === 'no-laborable' && group === 'puente');
        row.hidden = !matchesType || (month.value !== 'all' && date!.slice(5, 7) !== month.value);
        if (!row.hidden) count++;
      }
      empty.hidden = count !== 0;
    }

    views.forEach((button) => button.addEventListener('click', () => {
      view = button.dataset.view as Vista;
      activate(views, button);
      update();
    }));
    filters.forEach((button) => button.addEventListener('click', () => {
      filter = button.dataset.type!;
      activate(filters, button);
      renderCalendar();
    }));
    root.querySelector('.calendar-form')!.addEventListener('input', update);
    root.querySelector('.calendar-form')!.addEventListener('submit', (event) => {
      event.preventDefault();
      update();
    });
    month.addEventListener('change', renderCalendar);
  }
</script>
<style is:global>

