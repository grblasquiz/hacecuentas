<div class="mockup-feriados-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Fechas / Feriados nacionales</div><div class="heroGrid"><div><span class="eyebrow">Calendario argentino 2026</span><h1>El próximo descanso, a la vista.</h1><p class="lead">Consultá feriados, días no laborables y fines de semana largos. Descubrí cómo estirar una escapada usando la menor cantidad de vacaciones.</p><div class="trust"><span>✓ Traslados aplicados</span><span>✓ Calendario nacional</span><span>✓ Planificación de licencia</span></div><div class="miniCalendar"><div class="dateSheet"><b>AGOSTO</b><strong>17</strong><span>LUNES</span></div><div class="miniCopy"><strong>Próximo feriado</strong><span>Paso a la Inmortalidad del Gral. San Martín</span></div></div></div>
<div class="planner"><div class="plannerHead"><div><h2>¿Qué querés saber?</h2><p>Elegí una vista del calendario.</p></div><span class="official">CALENDARIO OFICIAL</span></div><div class="views"><button class="view active" data-view="next">Próximo feriado</button><button class="view" data-view="business">Días hábiles</button><button class="view" data-view="long">Findes largos</button></div><div class="fields"><div class="field"><label>Contar desde</label><input id="from" type="date" value="2026-07-29"></div><div class="field"><label>Contar hasta</label><input id="to" type="date" value="2026-12-31"></div><div class="field"><label>¿Trabajás los sábados?</label><select id="saturday"><option value="0">No</option><option value="1">Sí</option></select></div><div class="field"><label>Días de licencia disponibles</label><input id="leave" type="number" min="0" max="30" value="1"></div></div><button class="primary" id="calculate">Actualizar calendario</button><div class="result"><small id="resultLabel">PRÓXIMO FERIADO NACIONAL</small><div class="answer"><div class="big" id="answer">17 de agosto</div><span class="badge" id="badge">En 19 días</span></div><p id="description">Paso a la Inmortalidad del General José de San Martín · cae lunes.</p><div class="stats"><div class="stat"><span>FERIADOS RESTANTES</span><b id="remaining">5</b></div><div class="stat"><span>DÍAS HÁBILES</span><b id="business">106</b></div><div class="stat"><span>FINES LARGOS</span><b id="longCount">3</b></div></div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Todo el año</span><h2>Calendario de feriados 2026</h2><p>Filtrá por tipo o mes. Los puentes y días no laborables se distinguen de los feriados nacionales.</p></div><div class="toolbar"><div class="filters"><button class="filter active" data-type="all">Todos</button><button class="filter" data-type="holiday">Feriados</button><button class="filter" data-type="bridge">No laborables</button><button class="filter" data-type="upcoming">Próximos</button></div><select class="monthSelect" id="month"><option value="all">Todos los meses</option><option value="7">Agosto</option><option value="9">Octubre</option><option value="10">Noviembre</option><option value="11">Diciembre</option></select></div><div class="holidays" id="holidayList"></div><div class="empty" id="empty">No hay fechas para ese filtro.</div></div></section>
<section class="tint"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Planificá una escapada</span><h2>Convertí un feriado en más descanso</h2><p>Verde: días libres. Amarillo: día de licencia sugerido.</p></div><div class="weekends"><article class="trip featured"><small>Sin pedir licencia</small><h3>Del 15 al 17 de agosto</h3><p>Tres días seguidos aprovechando el feriado del lunes.</p><div class="days"><i class="off">SÁB</i><i class="off">DOM</i><i class="off">LUN</i></div><button>Agregar al calendario</button></article><article class="trip"><small>Sin pedir licencia</small><h3>Del 10 al 12 de octubre</h3><p>Otro fin de semana de tres días con feriado el lunes.</p><div class="days"><i class="off">SÁB</i><i class="off">DOM</i><i class="off">LUN</i></div><button>Agregar al calendario</button></article><article class="trip"><small>Usando 1 día</small><h3>Del 5 al 8 de diciembre</h3><p>Pedí el lunes y conectá el fin de semana con el martes 8.</p><div class="days"><i class="off">SÁB</i><i class="off">DOM</i><i class="leave">LUN</i><i class="off">MAR</i></div><button>Usar esta idea</button></article></div></div></section>
<section><div class="wrap"><div class="info"><article class="panel"><h3>Feriado nacional</h3><p>Rige el descanso dominical. Si trabajás, corresponde la remuneración del día más una cantidad igual: en términos generales, se paga doble.</p><div class="line">Los feriados trasladables ya aparecen en su fecha efectiva.</div></article><article class="panel dark"><h3>Día no laborable</h3><p>La decisión de trabajar queda, en general, a criterio del empleador y el pago no funciona igual que un feriado nacional. También puede variar según actividad.</p><div class="line">La herramienta usa calendario nacional; no suma asuetos provinciales o municipales.</div></article></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-feriados-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-feriados-home');if(!root)return;

const holidays=[{d:"2026-08-17",name:"Paso a la Inmortalidad del Gral. San Martín",type:"holiday"},{d:"2026-10-12",name:"Día del Respeto a la Diversidad Cultural",type:"holiday"},{d:"2026-11-20",name:"Día de la Soberanía Nacional",type:"holiday"},{d:"2026-12-08",name:"Inmaculada Concepción de María",type:"holiday"},{d:"2026-12-25",name:"Navidad",type:"holiday"}],$=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],parse=v=>{const [y,m,d]=v.split("-").map(Number);return new Date(y,m-1,d,12)},fmt=d=>new Intl.DateTimeFormat("es-AR",{day:"numeric",month:"long"}).format(d);let view="next",type="all";
function business(a,b,sat){let n=0,d=new Date(a);while(d<=b){if(d.getDay()!==0&&(sat||d.getDay()!==6)&&!holidays.some(h=>h.d===iso(d)))n++;d.setDate(d.getDate()+1)}return n}function iso(d){return d.toISOString().slice(0,10)}function update(){const from=parse($("#from").value),to=parse($("#to").value),next=holidays.find(h=>parse(h.d)>=from),remain=holidays.filter(h=>parse(h.d)>=from&&parse(h.d)<=to).length,biz=business(from,to,$("#saturday").value==="1");$("#remaining").textContent=remain;$("#business").textContent=biz;if(view==="business"){$("#resultLabel").textContent="DÍAS HÁBILES DEL PERÍODO";$("#answer").textContent=biz+" días";$("#badge").textContent="Hasta "+fmt(to);$("#description").textContent="Descontamos domingos, feriados nacionales y "+($("#saturday").value==="1"?"mantenemos":"descontamos")+" los sábados."}else if(view==="long"){$("#resultLabel").textContent="FINES DE SEMANA LARGOS";$("#answer").textContent="3 oportunidades";$("#badge").textContent=$("#leave").value+" día de licencia";$("#description").textContent="Agosto y octubre no requieren licencia; diciembre puede extenderse usando un lunes."}else if(next){const d=parse(next.d),days=Math.ceil((d-from)/864e5);$("#resultLabel").textContent="PRÓXIMO FERIADO NACIONAL";$("#answer").textContent=fmt(d);$("#badge").textContent="En "+days+" días";$("#description").textContent=next.name+" · cae "+new Intl.DateTimeFormat("es-AR",{weekday:"long"}).format(d)+"."}else{$("#answer").textContent="No quedan";$("#badge").textContent="En el período";$("#description").textContent="Probá ampliando las fechas."}}
function render(){const month=$("#month").value;const rows=holidays.filter(h=>(type==="all"||type==="upcoming"||h.type===type)&&(month==="all"||parse(h.d).getMonth()==month)&&(type!=="upcoming"||parse(h.d)>=parse($("#from").value)));$("#holidayList").innerHTML=rows.map(h=>{const d=parse(h.d);return `<article class="holiday ${h.type}"><div class="date"><span>${new Intl.DateTimeFormat("es-AR",{month:"short"}).format(d)}</span><b>${d.getDate()}</b></div><div><h3>${h.name}</h3><p>${new Intl.DateTimeFormat("es-AR",{weekday:"long"}).format(d)} · alcance nacional</p></div><span class="kind">Feriado nacional</span></article>`}).join("");$("#empty").style.display=rows.length?"none":"block"}
$$(".view").forEach(b=>b.onclick=()=>{view=b.dataset.view;$$(".view").forEach(x=>x.classList.toggle("active",x===b));update()});$$(".planner input,.planner select").forEach(x=>x.oninput=()=>{update();render()});$("#calculate").onclick=e=>{update();render();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Calendario actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};$$(".filter").forEach(b=>b.onclick=()=>{type=b.dataset.type;$$(".filter").forEach(x=>x.classList.toggle("active",x===b));render()});$("#month").oninput=render;function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".trip button").forEach(b=>b.onclick=()=>toast("✓ Plan guardado en el mockup"));update();render();

})();
</script>
