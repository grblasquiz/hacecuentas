---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-auto-o-uber" set:html={`<section class="hero"><div class="wrap crumb"><b>Auto</b> &nbsp;/&nbsp; Auto o Uber</div><div class="wrap grid"><div class="copy"><span class="eyebrow">Tu movilidad, costo completo</span><h1>¿Te conviene tener auto o pedir un viaje?</h1><p>Sumá todos los costos del auto y comparalos con Uber, DiDi, Cabify, taxi o colectivo. Encontrá el punto exacto donde cambia la respuesta.</p><div class="chips"><span>✓ Depreciación incluida</span><span>✓ Costos fijos y variables</span><span>✓ Punto de equilibrio</span></div><div class="art"><div class="road"></div><div class="car"><div class="body"></div><div class="glass"></div><i class="wheel w1"></i><i class="wheel w2"></i></div><div class="float"><small>PUNTO DE EQUILIBRIO</small><b id="art-value">127 viajes/mes</b><span id="art-copy">debajo conviene Uber</span></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Compará tu movilidad</h2><p class="muted">Elegí la alternativa al auto.</p></div><span class="tag">Escenario mensual</span></div><div class="label">¿Con qué lo comparás?</div><div class="cases"><button type="button" class="case active" data-mode="uber"><i>U</i>Uber</button><button type="button" class="case" data-mode="peak"><i>↑</i>Uber hora pico</button><button type="button" class="case" data-mode="didi"><i>D</i>DiDi</button><button type="button" class="case" data-mode="cabify"><i>C</i>Cabify</button><button type="button" class="case" data-mode="taxi"><i>T</i>Taxi / remis</button><button type="button" class="case" data-mode="public"><i>▤</i>Transporte público</button><button type="button" class="case" data-mode="garage"><i>⌂</i>Sin medido</button></div><div class="label">Tu uso y tu auto</div><div class="fields"><div class="field"><label>Viajes por mes</label><input id="trips" value="90"></div><div class="field"><label>Km por viaje</label><input id="km" value="6"></div><div class="field"><label>Minutos por viaje</label><input id="minutes" value="18"></div><div class="field"><label>Valor del auto 0 km</label><input id="car-value" value="22000000"></div><div class="field"><label>Antigüedad del auto</label><input id="age" value="5"></div><div class="field"><label>Consumo L/100 km</label><input id="consumption" value="8.5"></div><div class="field"><label>Seguro por mes</label><input id="insurance" value="95000"></div><div class="field"><label>Service y cubiertas por año</label><input id="service" value="1400000"></div><div class="field"><label>Boleto / viaje</label><input id="ticket" value="1200"></div></div><section class="result"><div class="result-top"><div><small>PUNTO DE EQUILIBRIO</small><div class="value" id="result">127 viajes/mes</div></div><div class="badge"><small id="badge-label">Hoy te conviene</small><b id="badge">Uber</b></div></div><div class="stats"><span>AUTO POR MES<b id="s1">$1.055.000</b></span><span id="s2l">UBER POR MES<b id="s2">$688.000</b></span><span>AHORRO MENSUAL<b id="s3">$367.000</b></span></div><button class="go" id="update" type="button">Actualizar comparación</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span>La respuesta cambia con el uso</span><h2>¿En qué punto empieza a convenir el auto?</h2><p>Antes del cruce gana la alternativa por viaje. Después, los costos fijos del auto se reparten entre más usos.</p></header><div class="scale"><div class="meter"><i class="pin" id="pin" data-value="90 viajes"></i></div><div class="labels"><div><b id="left-label">Conviene Uber</b>Pocos viajes por mes</div><div><b>Conviene el auto</b>Muchos viajes por mes</div></div><div class="summary"><span id="scale-copy">Hoy hacés 90 viajes por mes.</span><b id="scale-result">El equilibrio está en 127 viajes</b></div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3>El costo del auto, línea por línea</h3><div class="line"><span>Patente y depreciación</span><b id="d1">$260.000</b></div><div class="line"><span>Seguro</span><b id="d2">$95.000</b></div><div class="line"><span>Service, cubiertas y VTV</span><b id="d3">$116.667</b></div><div class="line"><span>Nafta y estacionamiento</span><b id="d4">$140.000</b></div><div class="line total"><strong>Total del auto por mes</strong><b id="d5">$1.055.000</b></div></article><article class="card"><h3>Qué suele olvidarse</h3><div class="rule"><i>1</i><div><b>La depreciación</b><span>El auto pierde valor aunque no salga del garage.</span></div></div><div class="rule"><i>2</i><div><b>El estacionamiento</b><span>Medido o cochera pueden pesar más que el service.</span></div></div><div class="rule"><i>3</i><div><b>El valor de tu tiempo</b><span>La cuenta económica no mide esperas ni combinaciones.</span></div></div><div class="warning">Las tarifas de apps son dinámicas. Usá un promedio de tus últimos viajes para ajustar el resultado.</div></article></div></section>
<section class="costs"><div class="wrap"><header class="center"><span>Dos estructuras distintas</span><h2>Por qué se cruzan los costos</h2></header><div class="costgrid"><article class="cost"><i>▰</i><h3>Auto: costos fijos</h3><p>Seguro, patente y depreciación corren aunque no viajes.</p><em>Pesan con poco uso</em></article><article class="cost"><i>⛽</i><h3>Auto: costo variable</h3><p>Nafta y estacionamiento crecen con los kilómetros.</p><em>Sube más lento</em></article><article class="cost"><i>U</i><h3>Apps: por viaje</h3><p>Sin costo fijo, pero cada trayecto suma completo.</p><em>Convienen con poco uso</em></article><article class="cost"><i>▤</i><h3>Transporte público</h3><p>Casi siempre gana en plata; la diferencia está en tiempo.</p><em>Menor costo</em></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#9fd3e6">No hay una respuesta universal</span><h2>La pregunta correcta es cuántos viajes hacés.</h2><p>El auto compra disponibilidad y tiempo. Las apps compran flexibilidad sin inmovilizar capital. El punto de equilibrio pone precio a esa diferencia.</p></div><div class="facts"><div><small>USO ACTUAL</small><b id="dark-trips">90 viajes</b><span>Por mes</span></div><div><small>EQUILIBRIO</small><b id="dark-equilibrium">127 viajes</b><span>Donde se cruzan</span></div><div><small>EMISIONES AUTO</small><b id="dark-co2">106 kg CO₂</b><span>Por mes</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-auto-o-uber')?document.currentScript.previousElementSibling:document.querySelector('.mockup-auto-o-uber');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0),ars=x=>"$"+Math.round(x).toLocaleString("es-AR"),fmt=x=>Math.round(x).toLocaleString("es-AR");let mode="uber";const alt={uber:{name:"Uber",factor:1},peak:{name:"Uber hora pico",factor:1.45},didi:{name:"DiDi",factor:.82},cabify:{name:"Cabify",factor:1.18},taxi:{name:"Taxi / remis",factor:1.05},public:{name:"Transporte público",factor:0},garage:{name:"Uber",factor:1}};function calc(){let trips=n("#trips"),km=n("#km"),mins=n("#minutes"),value=n("#car-value"),age=n("#age"),cons=n("#consumption"),insurance=n("#insurance"),service=n("#service"),ticket=n("#ticket"),a=alt[mode],valuation=value*Math.max(.4,1-age*.08),patent=valuation*.035/12,depreciation=age<8?value*.08/12:0,nafta=trips*km*cons/100*1450,parking=mode==="garage"?0:12*2*7500,autoFixed=patent+insurance+service/12+depreciation+parking,autoCost=autoFixed+nafta,perTrip=mode==="public"?ticket:mode==="taxi"?Math.max(2800+km*1100,6500):(1800+km*720+mins*85)*a.factor,altCost=perTrip*trips,fuelTrip=km*cons/100*1450,margin=perTrip-fuelTrip,equilibrium=margin>0?Math.ceil(autoFixed/margin):0,carWins=autoCost<altCost,diff=Math.abs(autoCost-altCost),max=Math.max(equilibrium*1.35,trips*1.15,10);$("#result").textContent=equilibrium?fmt(equilibrium)+" viajes/mes":"Nunca";$("#badge").textContent=carWins?"El auto":a.name;$("#s1").textContent=ars(autoCost);$("#s2l").childNodes[0].nodeValue=a.name.toUpperCase()+" POR MES";$("#s2").textContent=ars(altCost);$("#s3").textContent=ars(diff);$("#art-value").textContent=$("#result").textContent;$("#art-copy").textContent="debajo conviene "+a.name;$("#pin").style.left=Math.min(98,trips/max*100)+"%";$("#pin").dataset.value=fmt(trips)+" viajes";$("#left-label").textContent="Conviene "+a.name;$("#scale-copy").textContent="Hoy hacés "+fmt(trips)+" viajes por mes.";$("#scale-result").textContent=equilibrium?"El equilibrio está en "+fmt(equilibrium)+" viajes":"No hay punto de equilibrio";$("#d1").textContent=ars(patent+depreciation);$("#d2").textContent=ars(insurance);$("#d3").textContent=ars(service/12);$("#d4").textContent=ars(nafta+parking);$("#d5").textContent=ars(autoCost);$("#dark-trips").textContent=fmt(trips)+" viajes";$("#dark-equilibrium").textContent=equilibrium?fmt(equilibrium)+" viajes":"Nunca";$("#dark-co2").textContent=fmt(trips*km*cons/100*2.31)+" kg CO₂"}
function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Comparación actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar comparación",1200)};calc();

})();
</script>
