.mockup-auto-o-uber .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-auto-o-uber .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-auto-o-uber .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-auto-o-uber .support-real summary { cursor:pointer; font-weight:750; }
.mockup-auto-o-uber .support-real p { color:#687a8f; line-height:1.65; }
@media(max-width:800px){.mockup-auto-o-uber .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-auto-o-uber support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
