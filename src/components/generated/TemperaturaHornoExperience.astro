---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-temperatura-horno" set:html={`<section class="hero"><div class="wrap crumb"><b>Cocina</b> &nbsp;/&nbsp; Temperatura del horno</div><div class="wrap grid"><div class="copy"><div class="eyebrow">La receta, en tu horno</div><h1>La temperatura correcta, sin adivinar la perilla.</h1><p>Convertí °C, °F y número de gas. Ajustá por convección y entendé si la receta pide horno suave, moderado o fuerte.</p><div class="chips"><span>✓ Celsius ↔ Fahrenheit</span><span>◉ Número de gas</span><span>≋ Ajuste con ventilador</span></div><div class="art"><div class="heat">〰 〰</div><div class="oven"></div><div class="tray"></div><div class="tempcard"><small>PONÉ TU HORNO EN</small><strong id="art-temp">180 °C</strong><span id="art-zone">horno moderado</span></div></div></div><form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Convertí la receta</h2><p class="muted">Ingresá lo que dice y elegí tu horno.</p></div><span class="tag">Resultado inmediato</span></div><div class="label">La receta está en</div><div class="cases"><button type="button" class="case active" data-unit="c"><i>°C</i>Celsius</button><button type="button" class="case" data-unit="f"><i>°F</i>Fahrenheit</button><button type="button" class="case" data-unit="gas"><i>●</i>Número de gas</button></div><div class="label">Datos de cocción</div><div class="fields"><div class="field"><label>Temperatura indicada</label><input id="value" value="180" inputmode="decimal"></div><div class="field"><label>Tipo de horno</label><select id="oven"><option value="normal">Convencional</option><option value="fan">Con ventilador / convección</option></select></div><div class="field wide"><label>¿Qué vas a cocinar?</label><select id="food"><option value="cake">Bizcochuelo o torta</option><option value="bread">Pan o pizza</option><option value="chicken">Pollo entero</option><option value="meringue">Merengue</option><option value="gratin">Gratinar</option></select></div></div><section class="result"><div class="result-top"><div><small>PONÉ TU HORNO EN</small><div class="value" id="result">180 °C</div></div><div class="zone"><small>La receta pide</small><b id="zone">Horno moderado</b></div></div><div class="stats"><span>EQUIVALE A<b id="f-val">356 °F</b></span><span>PERILLA DE GAS<b id="gas-val">Gas 4</b></span><span>PRECALENTÁ<b id="preheat">15 minutos</b></span></div><button class="go" id="update" type="button">Actualizar temperatura</button></section></form></div></section>
<section class="section"><div class="wrap"><div class="center"><div class="eyebrow">La escala del horno</div><h2>De suave a muy fuerte, de un vistazo</h2><p>El marcador muestra dónde cae la temperatura original de la receta.</p></div><div class="scale"><div class="track"><i class="pin" id="pin" data-temp="180 °C"></i></div><div class="labels"><span><b>Muy suave</b>100–139 °C</span><span><b>Suave</b>140–164 °C</span><span><b>Moderado</b>165–194 °C</span><span><b>Fuerte</b>195 °C o más</span></div></div></div></section><section class="break"><div class="wrap breakgrid"><article class="card"><h3>Tu conversión, paso a paso</h3><div class="line"><span>Temperatura original</span><b id="d-origin">180 °C</b></div><div class="line"><span>Equivalencia en Celsius</span><b id="d-c">180 °C</b></div><div class="line"><span>Equivalencia en Fahrenheit</span><b id="d-f">356 °F</b></div><div class="line"><span>Ajuste por ventilador</span><b id="d-fan">Sin ajuste</b></div><div class="line total"><strong>Temperatura para tu horno</strong><b id="d-result">180 °C</b></div></article><article class="card"><h3>Atajos por preparación</h3><div class="foods"><button class="food active" data-food="cake"><b>🍰 Bizcochuelo</b><span>170–180 °C</span></button><button class="food" data-food="bread"><b>🍞 Pan y pizza</b><span>200–240 °C</span></button><button class="food" data-food="chicken"><b>🍗 Pollo</b><span>180–200 °C</span></button><button class="food" data-food="meringue"><b>☁ Merengue</b><span>100–130 °C</span></button></div><div class="tip" id="tip">💡 Para bizcochuelos, evitá abrir el horno durante los primeros 25 minutos.</div></article></div></section><section class="darksection"><div class="wrap"><div class="eyebrow" style="color:#f0ad80">Tres reglas que sí importan</div><div class="rules"><div class="rule"><i>◷</i><h3>Precalentá de verdad</h3><p>Esperá 10 a 20 minutos después de encenderlo antes de meter la preparación.</p></div><div class="rule"><i>≋</i><h3>Con ventilador: −20 °C</h3><p>La circulación de aire cocina más rápido y de manera más pareja.</p></div><div class="rule"><i></i><h3>La perilla no siempre acierta</h3><p>Un termómetro de horno revela diferencias reales de 10 a 30 grados.</p></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-temperatura-horno')?document.currentScript.previousElementSibling:document.querySelector('.mockup-temperatura-horno');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s);let unit="c";const gasTable={1:140,2:150,3:165,4:180,5:190,6:200,7:220,8:230,9:240},tips={cake:"💡 Para bizcochuelos, evitá abrir el horno durante los primeros 25 minutos.",bread:"💡 Pan y pizza necesitan un horno bien precalentado y una bandeja caliente.",chicken:"💡 El pollo está seguro cuando el centro llega a 74 °C.",meringue:"💡 El merengue se seca con temperatura baja; más calor lo dora y agrieta.",gratin:"💡 Para gratinar, usá calor fuerte y vigilá de cerca los últimos minutos."};const num=()=>Number($("#value").value.replace(",","."))||0,round=x=>Math.round(x);
function gasOf(c){return Object.keys(gasTable).reduce((a,b)=>Math.abs(gasTable[b]-c)<Math.abs(gasTable[a]-c)?b:a,"1")}function zone(c){return c<140?"Horno muy suave":c<165?"Horno suave":c<195?"Horno moderado":c<235?"Horno fuerte":"Horno muy fuerte"}function calc(){let v=num(),c=unit==="c"?v:unit==="f"?(v-32)*5/9:gasTable[Math.max(1,Math.min(9,Math.round(v)))]||180,f=c*9/5+32,g=gasOf(c),fan=$("#oven").value==="fan",put=c-(fan?20:0),pre=c<160?10:c<220?15:20,origin=unit==="c"?`${v} °C`:unit==="f"?`${v} °F`:`Gas ${v}`;$("#result").textContent=round(put)+" °C";$("#art-temp").textContent=round(put)+" °C";$("#zone").textContent=zone(c);$("#art-zone").textContent=zone(c).toLowerCase();$("#f-val").textContent=round(f)+" °F";$("#gas-val").textContent="Gas "+g;$("#preheat").textContent=pre+" minutos";$("#d-origin").textContent=origin;$("#d-c").textContent=round(c)+" °C";$("#d-f").textContent=round(f)+" °F";$("#d-fan").textContent=fan?"−20 °C":"Sin ajuste";$("#d-result").textContent=round(put)+" °C";let pos=Math.max(2,Math.min(98,(c-100)/180*100));$("#pin").style.left=pos+"%";$("#pin").dataset.temp=round(c)+" °C";$("#tip").textContent=tips[$("#food").value]}
function setUnit(u){unit=u;$$(".case").forEach(x=>x.classList.toggle("active",x.dataset.unit===u));$("#value").value=u==="c"?180:u==="f"?350:4;calc()}$$(".case").forEach(b=>b.onclick=()=>setUnit(b.dataset.unit));$$("input,select").forEach(x=>x.oninput=calc);$$(".food").forEach(b=>b.onclick=()=>{$$(".food").forEach(x=>x.classList.remove("active"));b.classList.add("active");$("#food").value=b.dataset.food;calc()});$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Temperatura actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar temperatura",1200)};calc();

})();
</script>
<style is:global>

