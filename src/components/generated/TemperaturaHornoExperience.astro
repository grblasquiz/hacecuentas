r-radius:9px;font-size:10px;font-weight:750}.mockup-temperatura-horno .art{height:232px;position:relative}.mockup-temperatura-horno .oven{position:absolute;left:50px;bottom:9px;width:285px;height:207px;border-radius:18px;background:#425467;box-shadow:0 24px 40px #2a39472c}.mockup-temperatura-horno .oven:before{content:"";position:absolute;left:20px;right:20px;top:58px;bottom:20px;border:8px solid #283a4d;border-radius:9px;background:radial-gradient(circle at 50% 65%,#f2b257 0 8%,transparent 9%),linear-gradient(#e8874f55,#1f3040)}.mockup-temperatura-horno .oven:after{content:"●   ●   ●";position:absolute;left:28px;top:19px;color:#e6edf1;letter-spacing:27px}.mockup-temperatura-horno .tray{position:absolute;left:105px;bottom:50px;width:174px;height:38px;border-bottom:5px solid #b7c0c6;z-index:2}.mockup-temperatura-horno .tray:after{content:"●  ●  ●  ●";color:#e7a35a;font-size:24px;letter-spacing:4px;position:absolute;top:-15px}.mockup-temperatura-horno .heat{position:absolute;left:138px;top:2px;color:#e07843;font-size:29px;letter-spacing:14px}.mockup-temperatura-horno .tempcard{position:absolute;right:0;top:18px;background:#fff;border:1px solid #e6ddd4;border-radius:14px;padding:14px 18px;box-shadow:0 18px 40px #4c36221b}.mockup-temperatura-horno .tempcard small{font-size:8px;color:#7d7b78}.mockup-temperatura-horno .tempcard strong{display:block;font-size:25px;color:#bd6138;margin:5px 0}.mockup-temperatura-horno .tempcard span{font-size:9px;color:#69727b}
.mockup-temperatura-horno .calc{background:#fff;border:1px solid #e4e1dc;border-radius:21px;padding:27px 29px;box-shadow:0 27px 60px #4c3a2514}.mockup-temperatura-horno .calc-head{display:flex;justify-content:space-between}.mockup-temperatura-horno .calc h2{font-size:24px;margin:0 0 5px}.mockup-temperatura-horno .muted{font-size:11px;color:#747b84;margin:0}.mockup-temperatura-horno .tag{background:#fff1e4;color:#a9542d;border-radius:99px;padding:7px 10px;font-size:9px;font-weight:850;height:max-content}.mockup-temperatura-horno .label{font-size:10px;font-weight:900;margin:18px 0 8px}.mockup-temperatura-horno .cases{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mockup-temperatura-horno .case{border:1px solid #e3dfda;background:#fff;border-radius:11px;padding:11px 5px;color:#66717e;font-size:10px;font-weight:800;cursor:pointer}.mockup-temperatura-horno .case i{display:block;font-style:normal;font-size:19px;margin-bottom:4px}.mockup-temperatura-horno .case.active{border:2px solid #db7b49;background:#fff5eb;color:#a7502d;padding:10px 4px}.mockup-temperatura-horno .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-temperatura-horno .field{border:1px solid #e3e0dc;border-radius:11px;padding:10px 12px}.mockup-temperatura-horno .field.wide{grid-column:span 2}.mockup-temperatura-horno .field label{display:block;color:#777e86;font-size:9px;margin-bottom:5px}.mockup-temperatura-horno .field input,.mockup-temperatura-horno .field select{width:100%;border:0;outline:0;background:transparent;color:#1e3044;font-weight:800}.mockup-temperatura-horno .result{background:#2c4055;color:#fff;border-radius:16px;padding:19px 20px;margin-top:13px}.mockup-temperatura-horno .result-top{display:flex;justify-content:space-between}.mockup-temperatura-horno .result small{color:#c5d0da;font-size:9px}.mockup-temperatura-horno .value{font-size:37px;font-weight:900;letter-spacing:-1.3px;margin-top:4px}.mockup-temperatura-horno .zone{background:#fff0df;color:#a34f2c;border-radius:9px;padding:8px 10px;text-align:right}.mockup-temperatura-horno .zone small{color:inherit}.mockup-temperatura-horno .zone b{display:block;font-size:13px}.mockup-temperatura-horno .stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #496078;margin-top:13px;padding-top:12px;gap:8px}.mockup-temperatura-horno .stats span{color:#bdcbd7;font-size:8px}.mockup-temperatura-horno .stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.mockup-temperatura-horno .go{width:100%;border:0;border-radius:9px;padding:12px;margin-top:13px;background:linear-gradient(90deg,#d87543,#eba65b);color:#fff;font-weight:850;cursor:pointer}.mockup-temperatura-horno .section{padding:68px 0}.mockup-temperatura-horno .center{text-align:center;max-width:700px;margin:0 auto 35px}.mockup-temperatura-horno .center h2{font-size:36px;letter-spacing:-1.4px;margin:9px}.mockup-temperatura-horno .center p{color:#697580}.mockup-temperatura-horno .scale{border:1px solid #e5e1dc;border-radius:18px;padding:28px;box-shadow:0 15px 35px #4133220d}.mockup-temperatura-horno .track{height:22px;border-radius:99px;background:linear-gradient(90deg,#d7e8f1 0 22%,#f7df9a 22% 48%,#f1b26a 48% 75%,#dc7850 75%);position:relative;margin:48px 5px 18px}.mockup-temperatura-horno .pin{position:absolute;left:44%;top:50%;transform:translate(-50%,-50%);width:31px;height:31px;border-radius:50%;background:#2c4055;border:6px solid #fff;box-shadow:0 5px 14px #293b5040}.mockup-temperatura-horno .pin:before{content:attr(data-temp);position:absolute;bottom:33px;left:50%;transform:translateX(-50%);background:#2c4055;color:#fff;padding:6px 8px;border-radius:7px;white-space:nowrap;font-size:9px;font-weight:850}.mockup-temperatura-horno .labels{display:grid;grid-template-columns:repeat(4,1fr);text-align:center;color:#77828c;font-size:9px}.mockup-temperatura-horno .labels b{display:block;color:#2a3a4d;font-size:11px}.mockup-temperatura-horno .break{background:#f8f6f2;padding:64px 0}.mockup-temperatura-horno .breakgrid{display:grid;grid-template-columns:1.05fr .95fr;gap:20px}.mockup-temperatura-horno .card{background:#fff;border:1px solid #e5e1dc;border-radius:17px;padding:24px}.mockup-temperatura-horno .card h3{margin:0 0 16px;font-size:19px}.mockup-temperatura-horno .line{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #ece8e3}.mockup-temperatura-horno .line span{color:#707a84;font-size:10px}.mockup-temperatura-horno .line b{font-size:12px}.mockup-temperatura-horno .line.total{background:#fff1e5;color:#a9542e;border:0;border-radius:10px;margin-top:12px;padding:14px}.mockup-temperatura-horno .foods{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-temperatura-horno .food{border:1px solid #e8e3dd;border-radius:12px;padding:13px;cursor:pointer;background:#fff;text-align:left}.mockup-temperatura-horno .food.active{border:2px solid #db7b49;background:#fff6ed}.mockup-temperatura-horno .food b{display:block;font-size:11px}.mockup-temperatura-horno .food span{font-size:9px;color:#727c86}.mockup-temperatura-horno .tip{background:#fff4df;color:#795c25;border:1px solid #efdcad;border-radius:10px;padding:12px;margin-top:13px;font-size:10px}.mockup-temperatura-horno .darksection{background:#293e53;color:#fff;padding:60px 0}.mockup-temperatura-horno .rules{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:25px}.mockup-temperatura-horno .rule{border:1px solid #ffffff20;border-radius:15px;padding:18px}.mockup-temperatura-horno .rule i{font-style:normal;font-size:22px}.mockup-temperatura-horno .rule h3{font-size:13px;margin:10px 0 6px}.mockup-temperatura-horno .rule p{font-size:10px;line-height:1.55;color:#c3d0db;margin:0}
@media(max-width:800px){.mockup-temperatura-horno .links{display:none}.mockup-temperatura-horno .tools span:not(.dark){display:none}.mockup-temperatura-horno .grid,.mockup-temperatura-horno .breakgrid{grid-template-columns:1fr}.mockup-temperatura-horno .copy{text-align:center}.mockup-temperatura-horno .copy h1{font-size:40px}.mockup-temperatura-horno .chips{justify-content:center}.mockup-temperatura-horno .art{max-width:460px;margin:auto}.mockup-temperatura-horno .calc{padding:20px 16px}.mockup-temperatura-horno .wrap{padding:0 15px}}@media(max-width:470px){.mockup-temperatura-horno .cases,.mockup-temperatura-horno .fields,.mockup-temperatura-horno .stats,.mockup-temperatura-horno .rules{grid-template-columns:1fr}.mockup-temperatura-horno .field.wide{grid-column:auto}.mockup-temperatura-horno .art{transform:scale(.8);transform-origin:left top;height:185px}}

.mockup-temperatura-horno { width:100%; overflow:hidden; }
.mockup-temperatura-horno .top, .mockup-temperatura-horno header.top { display:none !important; }
.mockup-temperatura-horno .foot { display:none !important; }
.mockup-temperatura-horno .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-temperatura-horno .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-temperatura-horno .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-temperatura-horno .support-real summary { cursor:pointer; font-weight:750; }
.mockup-temperatura-horno .support-real p { color:#687a8f; line-height:1.65; }
@media(max-width:800px){.mockup-temperatura-horno .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-temperatura-horno support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
