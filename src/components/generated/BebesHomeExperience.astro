<div class="mockup-bebes-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Bebés</div><div class="heroGrid"><div><span class="eyebrow">Cada mes trae algo nuevo</span><h1>Ubicá su edad. Acompañá su propio ritmo.</h1><p class="lead">Edad cronológica, edad corregida, crecimiento y organización cotidiana. Referencias claras para una etapa llena de cambios.</p><div class="trust"><span>✓ Edad en meses y días</span><span>✓ Corrección visible</span><span>✓ Sin comparar diagnósticos</span></div><div class="scene"><i class="moon"></i><i class="cloud"></i><i class="star a"></i><i class="star b">·</i><i class="heart">♥</i></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Qué edad tiene?</h2><p>Cronológica y corregida cuando corresponde.</p></div><span class="live">EDAD EN VIVO</span></div><div class="birthTypes"><button class="birthType active" data-type="term">Nació a término</button><button class="birthType" data-type="preterm">Nació antes de término</button></div><div class="fields"><div class="field"><label>Fecha de nacimiento</label><div class="input"><input id="birth" type="date"></div></div><div class="field"><label>Fecha de cálculo</label><div class="input"><input id="today" type="date"></div></div><div class="field hidden" id="gestationField"><label>Semana gestacional al nacer</label><select id="gestationalWeek"><option value="28">Semana 28</option><option value="30">Semana 30</option><option value="32">Semana 32</option><option value="34" selected>Semana 34</option><option value="36">Semana 36</option><option value="37">Semana 37</option></select></div><div class="field"><label>Nombre, si querés</label><div class="input"><input id="babyName" value="Emma" placeholder="Tu bebé"></div></div></div><button class="primary" id="calculate">Actualizar edad</button><div class="result"><div class="resultTop"><div><small>EDAD CRONOLÓGICA</small><div class="amount" id="chronological">8 meses + 0 días</div></div><span class="badge" id="birthLabel">A término</span></div><div class="resultGrid"><div class="metric"><span>EDAD CORREGIDA</span><b id="corrected">No corresponde</b></div><div class="metric"><span>PRÓXIMO MES CUMPLIDO</span><b id="nextMonth">en 30 días</b></div><div class="metric"><span>PRIMER CUMPLEAÑOS</span><b id="birthday">en 122 días</b></div></div><div class="progress"><i id="progressBar"></i></div><p class="note" id="note">La edad corregida se usa como referencia en bebés nacidos antes de término y suele considerarse durante los primeros años.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Entrá por lo que necesitás organizar</span><h2>Una herramienta para cada momento.</h2><p>Elegí una necesidad y encontrá primero las referencias relacionadas.</p></div><div class="needs"><button class="need active" data-filter="age"><span class="icon">+</span><h3>Calcular su edad</h3><p>Meses, días y edad corregida.</p><em>→</em></button><button class="need" data-filter="growth"><span class="icon">↗</span><h3>Seguir crecimiento</h3><p>Peso y altura por edad.</p><em>→</em></button><button class="need" data-filter="feeding"><span class="icon">◉</span><h3>Organizar alimentación</h3><p>Cantidades y rutinas generales.</p><em>→</em></button><button class="need" data-filter="sleep"><span class="icon">☾</span><h3>Entender el sueño</h3><p>Registro y ventanas orientativas.</p><em>→</em></button><button class="need" data-filter="family"><span class="icon">✓</span><h3>Ordenar beneficios</h3><p>Asignaciones y fechas familiares.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas para bebés</span><h2>Fechas y referencias, en un solo lugar.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="age">Edad</button><button class="filter" data-filter="growth">Crecimiento</button><button class="filter" data-filter="feeding">Alimentación</button><button class="filter" data-filter="sleep">Sueño</button><button class="filter" data-filter="family">Familia</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="age growth" data-text="edad bebé corregida cronologica prematuro meses"><span class="tag">Edad y etapa</span><h3>Edad cronológica y corregida</h3><p>Calculá meses y días, contemplando semana gestacional si corresponde.</p><a class="hc-tool-link" href="/fechas/edad-exacta">Calcular edad →</a></article><article class="card" data-cat="growth" data-text="crecimiento infantil peso altura percentil edad"><span class="tag">Crecimiento</span><h3>Crecimiento infantil</h3><p>Referencias de peso y altura según edad.</p><a class="hc-tool-link" href="/bebes/crecimiento">Ver crecimiento →</a></article><article class="card" data-cat="feeding" data-text="alimentación bebé porciones leche comidas edad"><span class="tag">Alimentación</span><h3>Organizar comidas</h3><p>Un registro simple de horarios y cantidades.</p><a class="hc-tool-link" href="/familia/costo-de-un-bebe">Armar registro →</a></article><article class="card" data-cat="sleep age" data-text="sueño bebé siestas horas registro"><span class="tag">Rutina</span><h3>Registro de sueño</h3><p>Visualizá horas, siestas y tendencias.</p><a class="hc-tool-link" href="/salud/sueno-y-pantallas">Registrar sueño →</a></article><article class="card" data-cat="family" data-text="asignaciones anses hijos bebé beneficios"><span class="tag">Beneficios</span><h3>Asignaciones familiares</h3><p>Identificá prestaciones y fechas relacionadas.</p><a class="hc-tool-link" href="/familia/asignaciones-anses">Consultar →</a></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="guide"><div class="wrap guideGrid"><div><span class="eyebrow" style="color:var(--yellow)">Una referencia no es una carrera</span><h2>Los hitos tienen ventanas, no fechas exactas.</h2><p>La edad ayuda a ubicarse, pero cada bebé tiene su ritmo. La edad corregida aporta contexto cuando nació antes de término.</p><div class="disclaimer">Información orientativa. Para alimentación, crecimiento, sueño, desarrollo o cualquier preocupación de salud, consultá con el equipo pediátrico.</div></div><div class="guideList"><button class="guideBtn active" data-step="Edad"><span><b>1. Ubicá la edad correcta</b><small>Cronológica y corregida si corresponde.</small></span><b>→</b></button><button class="guideBtn" data-step="Tendencia"><span><b>2. Mirá tendencias</b><small>No saques conclusiones por una medición.</small></span><b>→</b></button><button class="guideBtn" data-step="Consulta"><span><b>3. Llevá dudas concretas</b><small>Fechas y registros ayudan en la consulta.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-bebes-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-bebes-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let birthType="term",day=864e5;const iso=d=>new Date(d-d.getTimezoneOffset()*60000).toISOString().slice(0,10);let now=new Date();now.setHours(12,0,0,0);$("#today").value=iso(now);let born=new Date(now);born.setMonth(born.getMonth()-8);$("#birth").value=iso(born);function ageParts(from,to){let months=(to.getFullYear()-from.getFullYear())*12+to.getMonth()-from.getMonth(),anchor=new Date(from);anchor.setMonth(anchor.getMonth()+months);if(anchor>to){months--;anchor=new Date(from);anchor.setMonth(anchor.getMonth()+months)}return{months:Math.max(0,months),days:Math.max(0,Math.round((to-anchor)/day))}}
function calc(){const birth=new Date($("#birth").value+"T12:00:00"),today=new Date($("#today").value+"T12:00:00");if(isNaN(birth)||isNaN(today))return;const chrono=ageParts(birth,today),weeksEarly=birthType==="preterm"?Math.max(0,40-(+$("#gestationalWeek").value||40)):0,correctedStart=new Date(birth.getTime()+weeksEarly*7*day),corr=ageParts(correctedStart,today),name=$("#babyName").value.trim()||"Tu bebé";let nextMonth=new Date(birth);nextMonth.setMonth(birth.getMonth()+chrono.months+1);let firstBirthday=new Date(birth);firstBirthday.setFullYear(birth.getFullYear()+1);const daysNext=Math.max(0,Math.ceil((nextMonth-today)/day)),daysBirthday=Math.ceil((firstBirthday-today)/day);$("#chronological").textContent=`${chrono.months} meses + ${chrono.days} días`;$("#corrected").textContent=birthType==="preterm"?`${corr.months} meses + ${corr.days} días`:"No corresponde";$("#nextMonth").textContent=`en ${daysNext} días`;$("#birthday").textContent=daysBirthday>0?`en ${daysBirthday} días`:"Ya cumplió 1 año";$("#birthLabel").textContent=birthType==="preterm"?`Semana ${$("#gestationalWeek").value}`:"A término";$("#progressBar").style.width=Math.min(100,chrono.months/12*100)+"%";$("#note").textContent=birthType==="preterm"?`${name} nació ${weeksEarly} semanas antes de la semana 40; por eso se muestran ambas edades.`:"La edad cronológica se calcula desde la fecha de nacimiento."}
$$(".calc input,.calc select").forEach(x=>x.oninput=calc);$$(".birthType").forEach(b=>b.onclick=()=>{birthType=b.dataset.type;$$(".birthType").forEach(x=>x.classList.toggle("active",x===b));$("#gestationField").classList.toggle("hidden",birthType!=="preterm");calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Edad actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".guideBtn").forEach(b=>b.onclick=()=>{$$(".guideBtn").forEach(x=>x.classList.toggle("active",x===b));toast("Paso seleccionado: "+b.dataset.step)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
