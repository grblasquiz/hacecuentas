---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-buscar" set:html={`
    <section class="hero"><div class="wrap"><div class="crumb">Inicio / Mapa de decisiones</div><div class="hero-copy"><div class="eyebrow">Hubs para decisiones reales</div><h1>Contanos qué necesitás resolver.</h1><p>Escribí la decisión que tenés por delante o explicá tu situación con tus propias palabras.</p></div><div class="search-panel"><div class="search-main"><div class="search-icon">⌕</div><textarea id="problem" placeholder="Ejemplo: me despidieron después de 8 años y quiero revisar la liquidación"></textarea><button id="interpret">Encontrar solución</button></div><div class="suggestions"><span>Probá con:</span><button class="suggestion">Quiero saber cuánto cobro en mano</button><button class="suggestion">¿Cuánta pintura necesito?</button><button class="suggestion">Comparar plazo fijo</button><button class="suggestion">Revisar semanas de embarazo</button></div></div><div class="trust"><span><b>✓</b> Entiende errores de escritura</span><span><b>✓</b> Busca por problema</span><span><b>✓</b> Resultados de tu país</span></div>
      <div class="recommendations" id="recommendations"><div class="rec-head"><small>Encontramos estas opciones para vos</small><button id="closeRec">Cerrar</button></div><div class="rec-grid" id="recGrid"></div></div>
    </div></section>
    <section class="catalog"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Decisiones destacadas</div><h2>O buscá por tema.</h2><p>Filtrá por situación y país. Los resultados se actualizan mientras escribís.</p></div><div class="name-search"><span>⌕</span><input id="nameSearch" placeholder="Sueldo, alquiler, salud…"><button class="clear" id="clear">×</button></div></div>
      <div class="toolbar"><div><div class="filters" id="categoryFilters"><button class="filter active" data-cat="all">Todas</button><button class="filter" data-cat="trabajo">Trabajo</button><button class="filter" data-cat="impuestos">Impuestos</button><button class="filter" data-cat="finanzas">Finanzas</button><button class="filter" data-cat="hogar">Hogar</button><button class="filter" data-cat="salud">Salud</button><button class="filter" data-cat="otros">Más temas</button></div><div class="filters" id="countryFilters" style="margin-top:8px"><button class="country active" data-country="all">Todos los países</button><button class="country" data-country="ar">🇦🇷 Argentina</button><button class="country" data-country="mx">🇲🇽 México</button><button class="country" data-country="co">🇨🇴 Colombia</button><button class="country" data-country="br">🇧🇷 Brasil</button></div></div><span class="count" id="count">14 resultados destacados</span></div>
      <div class="grid" id="grid"></div><div class="empty" id="empty"><div style="font-size:33px">⌕</div><h3>No encontramos una coincidencia exacta</h3><p>Probá describiendo qué querés resolver en el buscador principal.</p><button id="emptyAction">Describir mi problema</button></div>
    </div></section>
    <section class="discover"><div class="wrap discover-grid"><article class="panel"><h3>Búsquedas populares</h3><p>Las herramientas que más se consultan hoy.</p><div class="quick-list"><button class="quick-item" data-query="sueldo neto">Sueldo bruto y neto <span>→</span></button><button class="quick-item" data-query="aguinaldo">Aguinaldo 2026 <span>→</span></button><button class="quick-item" data-query="días entre fechas">Días entre fechas <span>→</span></button><button class="quick-item" data-query="aumento alquiler">Aumento de alquiler <span>→</span></button></div></article><article class="panel dark"><h3>Explorá por una decisión</h3><p>Si todavía no sabés qué calcular, empezá por la situación.</p><div class="quick-list"><button class="quick-item" data-problem="quiero ordenar mis gastos y salir de deudas">Ordenar mis finanzas <span>→</span></button><button class="quick-item" data-problem="quiero saber cuánto cuesta contratar un empleado">Contratar una persona <span>→</span></button><button class="quick-item" data-problem="quiero comprar una vivienda y calcular el crédito">Comprar una vivienda <span>→</span></button><button class="quick-item" data-problem="quiero organizar comida y bebidas para una fiesta">Organizar un evento <span>→</span></button></div></article></div></section>
  <button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-buscar')?document.currentScript.previousElementSibling:document.querySelector('.mockup-buscar');

    let data=[
      {href:"/trabajo/sueldo-bruto-y-neto",cat:"trabajo",country:"ar",icon:"$",title:"Sueldo bruto y neto",desc:"Aportes, Ganancias y sueldo de bolsillo.",keys:"sueldo salario neto bruto cobro mano descuentos argentina"},
      {href:"/trabajo/indemnizacion-por-despido",cat:"trabajo",country:"ar",icon:"L",title:"Indemnización por despido",desc:"Antigüedad, preaviso y liquidación.",keys:"despido indemnizacion echaron liquidacion final trabajo años"},
      {href:"/trabajo/aguinaldo",cat:"trabajo",country:"ar",icon:"½",title:"Aguinaldo",desc:"SAC completo o proporcional y descuentos.",keys:"aguinaldo sac sueldo semestre"},
      {href:"/impuestos/ganancias-cuarta-categoria",cat:"impuestos",country:"ar",icon:"%",title:"Ganancias cuarta categoría",desc:"Escala, deducciones y retención estimada.",keys:"ganancias impuesto arca sueldo retencion"},
      {href:"/inversiones/plazo-fijo",cat:"finanzas",country:"ar",icon:"↗",title:"Plazo fijo",desc:"Interés, tasa efectiva y comparación de bancos.",keys:"plazo fijo banco interes tasa inversion comparar"},
      {href:"/alquiler/aumento-de-alquiler",cat:"hogar",country:"ar",icon:"⌂",title:"Aumento de alquiler",desc:"Actualización por ICL, IPC o contrato.",keys:"alquiler aumento renta contrato icl ipc"},
      {href:"/construccion/pintura",cat:"hogar",country:"ar",icon:"P",title:"Pintura para una obra",desc:"Litros, manos, superficie y desperdicio.",keys:"pintura litros pared metros obra construcción"},
      {href:"/salud/peso-ideal-imc",cat:"salud",country:"ar",icon:"♥",title:"Peso ideal e IMC",desc:"IMC, rango orientativo y evolución.",keys:"peso imc altura salud ideal"},
      {href:"/embarazo/fecha-de-parto",cat:"salud",country:"ar",icon:"40",title:"Semanas de embarazo",desc:"Semana actual, trimestre y fecha probable.",keys:"embarazo semanas parto fum bebe"},
      {href:"/fechas/dias-entre-fechas",cat:"otros",country:"ar",icon:"D",title:"Días entre fechas",desc:"Días corridos, hábiles, meses y semanas.",keys:"dias fechas calendario diferencia"},
      {href:"/finanzas-personales/salir-de-deudas",cat:"finanzas",country:"ar",icon:"↓",title:"Salir de deudas",desc:"Orden de pago, cuotas y fecha de salida.",keys:"deudas finanzas gastos cuotas credito ordenar"},
      {href:"/trabajo/costo-de-un-empleado",cat:"trabajo",country:"ar",icon:"E",title:"Costo de un empleado",desc:"Sueldo, cargas, ART y costo total.",keys:"contratar empleado persona costo cargas empleador"},
      {href:"/eventos",cat:"otros",country:"ar",icon:"12",title:"Comida y bebidas para un evento",desc:"Cantidades según invitados, menú y duración.",keys:"evento fiesta comida bebidas invitados organizar"},
      {href:"/mx/trabajo/sueldo-neto",cat:"trabajo",country:"mx",icon:"MX",title:"Sueldo neto México",desc:"ISR, IMSS y prestaciones.",keys:"mexico sueldo salario neto imss isr"},
      {href:"/mx/vivienda",cat:"finanzas",country:"mx",icon:"⌂",title:"Crédito de vivienda México",desc:"Infonavit, FOVISSSTE o banco.",keys:"mexico vivienda credito infonavit hipoteca casa"},
      {href:"/co/trabajo/liquidacion-laboral",cat:"trabajo",country:"co",icon:"CO",title:"Liquidación laboral Colombia",desc:"Cesantías, prima, vacaciones e indemnización.",keys:"colombia liquidacion laboral cesantias prima"},
      {href:"/pt/trabalho/salario-liquido",cat:"impuestos",country:"br",icon:"BR",title:"INSS e IRRF Brasil",desc:"Descuentos progresivos y salário líquido.",keys:"brasil inss irrf salario liquido imposto"}
    ];
    const $=id=>root.querySelector("#"+id);let activeCat="all",activeCountry="all";
    function norm(s){return s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"")}
    function distance(a,b){const row=Array.from({length:b.length+1},(_,i)=>i);for(let i=1;i<=a.length;i++){let prev=row[0];row[0]=i;for(let j=1;j<=b.length;j++){const old=row[j];row[j]=Math.min(row[j]+1,row[j-1]+1,prev+(a[i-1]===b[j-1]?0:1));prev=old}}return row[b.length]}
    function fuzzyMatch(text,q){if(!q)return true;const hay=norm(text),tokens=q.split(/\s+/).filter(Boolean),words=hay.split(/\s+/);return tokens.every(t=>hay.includes(t)||(t.length>4&&words.some(w=>Math.abs(w.length-t.length)<=1&&distance(w,t)<=1)))}
    function render(){const q=norm($("nameSearch").value.trim());const matches=data.filter(x=>(activeCat==="all"||x.cat===activeCat)&&(activeCountry==="all"||x.country===activeCountry)&&fuzzyMatch(x.title+" "+x.desc+" "+x.keys,q));$("grid").innerHTML=matches.slice(0,60).map((x,i)=>`<article class="card"><div class="icon">${x.icon}</div><div class="card-body"><span class="meta">${x.cat} · ${x.country.toUpperCase()}</span><h3>${x.title}</h3><p>${x.desc}</p><a href="${x.href}" data-search-rank="${i+1}">Abrir herramienta →</a></div></article>`).join("");$("empty").style.display=matches.length?"none":"block";$("count").textContent=matches.length===1?"1 resultado":`${matches.length} resultados${matches.length>60?' · mostrando 60':''}`;$("clear").style.display=q?"block":"none"}
    function recommendations(text){const q=norm(text),countryHint=q.includes("mexic")?"mx":q.includes("colomb")?"co":q.includes("brasil")||q.includes("irrf")||q.includes("inss")?"br":"ar",score=x=>{let n=x.country===countryHint?2:-1;norm(x.keys+" "+x.title).split(" ").forEach(w=>{if(q.includes(w)&&w.length>3)n+=5});return n},ranked=[...data].sort((a,b)=>score(b)-score(a)).slice(0,3);$("recGrid").innerHTML=ranked.map((x,i)=>`<article class="rec"><small>${i===0?"Mejor coincidencia":"También puede servirte"}</small><b>${x.title}</b><span>${x.desc}</span><a href="${x.href}">Abrir →</a></article>`).join("");$("recommendations").classList.add("show");$("recommendations").scrollIntoView({behavior:"smooth",block:"nearest"})}
    $("interpret").onclick=()=>{const q=$("problem").value.trim();if(!q){$("problem").focus();toast("Contanos brevemente qué necesitás resolver");return}recommendations(q)};$("problem").addEventListener("keydown",e=>{if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();$("interpret").click()}});$("closeRec").onclick=()=>$("recommendations").classList.remove("show");root.querySelectorAll(".suggestion").forEach(b=>b.onclick=()=>{$("problem").value=b.textContent;recommendations(b.textContent)});
    root.querySelectorAll(".filter").forEach(b=>b.onclick=()=>{activeCat=b.dataset.cat;root.querySelectorAll(".filter").forEach(x=>x.classList.toggle("active",x===b));render()});root.querySelectorAll(".country").forEach(b=>b.onclick=()=>{activeCountry=b.dataset.country;root.querySelectorAll(".country").forEach(x=>x.classList.toggle("active",x===b));render()});const initialQuery=new URLSearchParams(location.search).get("q")||"";$("nameSearch").value=initialQuery;$("nameSearch").oninput=render;$("clear").onclick=()=>{$("nameSearch").value="";render();$("nameSearch").focus()};$("emptyAction").onclick=()=>{window.scrollTo({top:0,behavior:"smooth"});$("problem").focus()};root.querySelectorAll("[data-query]").forEach(b=>b.onclick=()=>{$("nameSearch").value=b.dataset.query;activeCat="all";activeCountry="all";root.querySelectorAll(".filter").forEach(x=>x.classList.toggle("active",x.dataset.cat==="all"));root.querySelectorAll(".country").forEach(x=>x.classList.toggle("active",x.dataset.country==="all"));render();$("nameSearch").scrollIntoView({behavior:"smooth"})});root.querySelectorAll("[data-problem]").forEach(b=>b.onclick=()=>{$("problem").value=b.dataset.problem;recommendations(b.dataset.problem)});root.addEventListener('click',e=>{const a=e.target.closest('[data-search-rank]');if(a&&typeof window.gtag==='function')window.gtag('event','search_result_click',{result_rank:Number(a.dataset.searchRank),destination:a.getAttribute('href')})});function toast(t){$("toast").textContent=t;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1500)}render();fetch('/search-index.json').then(r=>r.ok?r.json():Promise.reject()).then(rows=>{data=rows.map(x=>({href:'/'+x.s,cat:norm(x.c||'otros'),country:String(x.a||'AR').toLowerCase(),icon:x.i||'🧮',title:x.h||x.s,desc:x.d||'',keys:[x.h,x.d,x.s,x.c,x.a].filter(Boolean).join(' ')}));render()}).catch(()=>{});
  
})();
</script>
<style is:global>

    .mockup-buscar{--ink:#101d35;--muted:#68758a;--blue:#2462df;--blue2:#eaf1ff;--navy:#102d4d;--mint:#e1f6ee;--green:#167657;--cream:#f7f8f4;--line:#dfe4e6;--white:#fff;--yellow:#f3d16f}
    .mockup-buscar *{box-sizing:border-box}.mockup-buscar{margin:0;background:var(--cream);color:var(--ink);font:16px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-buscar button,.mockup-buscar input,.mockup-buscar textarea{font:inherit}.mockup-buscar .wrap{max-width:1180px;margin:auto;padding:0 24px}
    .mockup-buscar header{height:78px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-buscar .nav{display:flex;align-items:center;gap:29px}.mockup-buscar .brand{font-size:19px;font-weight:900;display:flex;align-items:center;gap:10px}.mockup-buscar .logo{width:34px;height:37px;border-radius:9px;background:var(--navy);color:#fff;display:grid;place-items:center}.mockup-buscar .links{display:flex;gap:23px;color:#526075;font-size:13px;font-weight:700}.mockup-buscar .actions{margin-left:auto;display:flex;gap:8px}.mockup-buscar .sm{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 13px;font-weight:750;color:var(--ink)}
    .mockup-buscar .hero{padding:49px 0 55px;background:radial-gradient(circle at 4% 8%,#e3ecff 0,transparent 30%),radial-gradient(circle at 96% 85%,#ddf3e9 0,transparent 28%)}.mockup-buscar .crumb{font-size:13px;color:var(--blue);font-weight:750;margin-bottom:25px}.mockup-buscar .hero-copy{text-align:center;max-width:760px;margin:auto}.mockup-buscar .eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--blue);font-weight:900}.mockup-buscar .hero h1{font-size:52px;line-height:1.03;letter-spacing:-.052em;margin:13px 0 15px}.mockup-buscar .hero-copy p{font-size:18px;color:var(--muted);margin:0}.mockup-buscar .search-panel{max-width:880px;margin:31px auto 0;background:#fff;border:1px solid var(--line);border-radius:23px;padding:14px;box-shadow:0 24px 58px #1838591a}.mockup-buscar .search-main{display:flex;align-items:center;gap:12px}.mockup-buscar .search-icon{width:45px;height:45px;flex:none;border-radius:13px;background:var(--blue2);color:var(--blue);display:grid;place-items:center;font-size:20px}.mockup-buscar .search-main textarea{height:66px;resize:none;flex:1;border:0;outline:0;padding:11px 4px;color:var(--ink);font-weight:650}.mockup-buscar .search-main button{border:0;background:var(--blue);color:#fff;border-radius:13px;padding:15px 19px;font-weight:900;cursor:pointer}.mockup-buscar .suggestions{display:flex;gap:7px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:12px;margin-top:7px}.mockup-buscar .suggestions span{font-size:10px;color:#7b8798;margin:8px 3px 0 5px}.mockup-buscar .suggestion{border:1px solid var(--line);background:#fafbfc;border-radius:99px;padding:7px 10px;color:#566579;font-size:10px;font-weight:750;cursor:pointer}.mockup-buscar .trust{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;margin-top:17px;font-size:11px;color:#6f7b8c}.mockup-buscar .trust b{color:var(--green)}
    .mockup-buscar .recommendations{display:none;max-width:880px;margin:15px auto 0;background:var(--navy);color:#fff;border-radius:19px;padding:20px}.mockup-buscar .recommendations.show{display:block}.mockup-buscar .rec-head{display:flex;justify-content:space-between;align-items:center}.mockup-buscar .rec-head small{color:#9fb8ca;font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:900}.mockup-buscar .rec-head button{border:0;background:#ffffff16;color:#fff;border-radius:8px;padding:7px 9px;cursor:pointer}.mockup-buscar .rec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:14px}.mockup-buscar .rec{background:#fff;color:var(--ink);border-radius:14px;padding:15px;display:flex;flex-direction:column;min-height:128px}.mockup-buscar .rec small{font-size:9px;color:var(--blue);font-weight:900;text-transform:uppercase}.mockup-buscar .rec b{font-size:14px;margin:7px 0 4px}.mockup-buscar .rec span{font-size:10px;color:var(--muted)}.mockup-buscar .rec button,.mockup-buscar .rec a{margin-top:auto;border:0;background:transparent;color:var(--blue);font-size:10px;font-weight:900;text-align:left;padding:10px 0 0;cursor:pointer}
    .mockup-buscar .catalog{padding:70px 0}.mockup-buscar .section-head{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:25px}.mockup-buscar .section-head h2{font-size:37px;line-height:1.1;letter-spacing:-.04em;margin:8px 0}.mockup-buscar .section-head p{color:var(--muted);margin:0;max-width:500px}.mockup-buscar .name-search{display:flex;align-items:center;gap:9px;background:#fff;border:1px solid #ccd4dc;border-radius:13px;padding:0 13px;min-width:330px}.mockup-buscar .name-search:focus-within{border-color:var(--blue);box-shadow:0 0 0 3px #2462df16}.mockup-buscar .name-search input{border:0;outline:0;background:transparent;width:100%;padding:13px 0;color:var(--ink)}.mockup-buscar .clear{display:none;border:0;background:#eef1f4;border-radius:7px;color:#5e6b7f;padding:4px 7px;cursor:pointer}.mockup-buscar .toolbar{display:flex;justify-content:space-between;gap:14px;margin-bottom:19px}.mockup-buscar .filters{display:flex;gap:7px;flex-wrap:wrap}.mockup-buscar .filter,.mockup-buscar .country{border:1px solid var(--line);background:#fff;border-radius:99px;padding:9px 12px;color:#637085;font-size:10px;font-weight:800;cursor:pointer}.mockup-buscar .filter.active{background:var(--navy);border-color:var(--navy);color:#fff}.mockup-buscar .country.active{background:var(--mint);border-color:#7bc7ad;color:#105e49}.mockup-buscar .count{font-size:11px;color:#798596;align-self:center;white-space:nowrap}.mockup-buscar .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-buscar .card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;min-height:176px;display:flex;gap:14px;transition:.2s}.mockup-buscar .card:hover{transform:translateY(-3px);border-color:#a9bfe9;box-shadow:0 15px 35px #17376412}.mockup-buscar .icon{width:43px;height:43px;flex:none;border-radius:13px;background:var(--blue2);color:var(--blue);display:grid;place-items:center;font-weight:900}.mockup-buscar .card-body{display:flex;flex-direction:column;min-width:0}.mockup-buscar .meta{font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:var(--blue);font-weight:900}.mockup-buscar .card h3{font-size:16px;margin:7px 0 5px}.mockup-buscar .card p{font-size:10px;color:var(--muted);margin:0}.mockup-buscar .card button,.mockup-buscar .card a{margin-top:auto;border:0;background:transparent;color:var(--blue);font-size:10px;font-weight:900;text-align:left;padding:12px 0 0;cursor:pointer}.mockup-buscar .empty{display:none;grid-column:1/-1;background:#fff;border:1px solid var(--line);border-radius:20px;padding:38px;text-align:center}.mockup-buscar .empty h3{margin:10px 0 5px}.mockup-buscar .empty p{color:var(--muted);margin:0}.mockup-buscar .empty button{border:0;background:var(--blue);color:#fff;border-radius:10px;padding:10px 13px;font-weight:850;margin-top:15px;cursor:pointer}
    .mockup-buscar .discover{padding:70px 0;background:#edf3f0}.mockup-buscar .discover-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.mockup-buscar .panel{background:#fff;border:1px solid var(--line);border-radius:21px;padding:24px}.mockup-buscar .panel.dark{background:var(--navy);color:#fff;border:0}.mockup-buscar .panel h3{font-size:22px;margin:0 0 7px}.mockup-buscar .panel p{font-size:12px;color:var(--muted)}.mockup-buscar .dark p{color:#bdcdd5}.mockup-buscar .quick-list{display:grid;gap:8px;margin-top:15px}.mockup-buscar .quick-item{border:1px solid var(--line);background:#fbfcfb;border-radius:12px;padding:12px;text-align:left;color:var(--ink);display:flex;justify-content:space-between;font-size:11px;font-weight:750;cursor:pointer}.mockup-buscar .dark .quick-item{background:#ffffff0d;border-color:#ffffff19;color:#fff}.mockup-buscar .quick-item span{color:var(--blue)}.mockup-buscar .dark .quick-item span{color:var(--yellow)}.mockup-buscar footer{background:var(--navy);color:#bacad5;padding:40px 0}.mockup-buscar .foot{display:flex;justify-content:space-between}.mockup-buscar .foot strong{color:#fff}.mockup-buscar .toast{position:fixed;right:22px;bottom:22px;background:var(--navy);color:#fff;border-radius:12px;padding:13px 17px;font-size:12px;opacity:0;transform:translateY(70px);transition:.25s;z-index:30}.mockup-buscar .toast.show{opacity:1;transform:none}
    @media(max-width:900px){.mockup-buscar .links{display:none}.mockup-buscar .grid{grid-template-columns:1fr 1fr}.mockup-buscar .section-head{display:block}.mockup-buscar .name-search{margin-top:20px;min-width:0;max-width:520px}.mockup-buscar .rec-grid{grid-template-columns:1fr}.mockup-buscar .discover-grid{grid-template-columns:1fr}}@media(max-width:590px){.mockup-buscar .wrap{padding:0 16px}.mockup-buscar .hero h1{font-size:39px}.mockup-buscar .search-main{align-items:stretch;flex-wrap:wrap}.mockup-buscar .search-main textarea{width:calc(100% - 60px)}.mockup-buscar .search-main button{width:100%}.mockup-buscar .grid{grid-template-columns:1fr}.mockup-buscar .toolbar{display:block}.mockup-buscar .count{display:block;margin-top:12px}.mockup-buscar .actions .sm:first-child{display:none}.mockup-buscar .foot{display:grid;gap:8px}}
  
.mockup-buscar { width:100%; overflow:hidden; }
.mockup-buscar .top, .mockup-buscar header.top { display:none !important; }
.mockup-buscar .foot { display:none !important; }
.mockup-buscar .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-buscar .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-buscar .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-buscar .support-real summary { cursor:pointer; font-weight:750; }
.mockup-buscar .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-buscar :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-buscar input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-buscar input[type="number"]::-webkit-inner-spin-button, .mockup-buscar input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-buscar .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-buscar support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
