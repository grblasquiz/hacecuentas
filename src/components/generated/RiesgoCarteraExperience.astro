---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-riesgo-cartera" set:html={`
    <div class="wrap">
      <div class="hero"><div><div class="crumb">Inversiones / Riesgo de mi cartera</div><div class="eyebrow">Rendimiento sin contexto no alcanza</div><h1>¿El retorno compensa el riesgo que tomás?</h1><p class="lead">Medí la eficiencia de tu cartera, el beneficio real de diversificar y el riesgo implícito de un bono o una acción.</p><div class="chips"><span class="chip">✓ Sharpe ratio</span><span class="chip">✓ Correlación</span><span class="chip">✓ Bonos y valuación</span></div></div><div class="visual"><div class="donut"></div><div class="arrow"><div class="axis"></div></div><div class="note n1">Retorno ≠ eficiencia</div><div class="note n2">Diversificar es combinar movimientos</div></div></div>
      <form class="calc" id="calculator"><div class="case-label">¿QUÉ QUERÉS MEDIR?</div><div class="cases"><button type="button" class="case active" data-mode="sharpe">Mi cartera entera</button><button type="button" class="case" data-mode="diversify">Diversificación real</button><button type="button" class="case" data-mode="bond">Un bono argentino</button><button type="button" class="case" data-mode="stock">Una acción</button></div>
        <div class="grid"><div class="panel"><h2 id="formTitle">Retorno ajustado por riesgo</h2><p class="hint" id="formHint">Rendimiento, tasa y volatilidad deben estar en la misma moneda y período.</p>
          <div class="fields active" data-fields="sharpe"><div class="field"><label for="return">Rendimiento anual (%)</label><input class="control" id="return" type="number" value="35" step=".1"></div><div class="field"><label for="riskFree">Tasa libre de riesgo (%)</label><input class="control" id="riskFree" type="number" value="20.93" step=".01"></div><div class="field full"><label for="volatility">Volatilidad anual (%)</label><input class="control" id="volatility" type="number" value="18" min=".01" step=".1"></div></div>
          <div class="fields" data-fields="diversify"><div class="field"><label for="weight1">Peso activo 1 (%)</label><input class="control" id="weight1" type="number" value="60" min="0" max="100"></div><div class="field"><label for="correlation">Correlación (−1 a 1)</label><input class="control" id="correlation" type="number" value=".3" min="-1" max="1" step=".05"></div><div class="field"><label for="return1">Retorno activo 1 (%)</label><input class="control" id="return1" type="number" value="40" step=".1"></div><div class="field"><label for="vol1">Volatilidad activo 1 (%)</label><input class="control" id="vol1" type="number" value="25" min="0" step=".1"></div><div class="field"><label for="return2">Retorno activo 2 (%)</label><input class="control" id="return2" type="number" value="20" step=".1"></div><div class="field"><label for="vol2">Volatilidad activo 2 (%)</label><input class="control" id="vol2" type="number" value="12" min="0" step=".1"></div></div>
          <div class="fields" data-fields="bond"><div class="field"><label for="bondPrice">Precio por VN 100 (US$)</label><input class="control" id="bondPrice" type="number" value="62" min=".01" step=".01"></div><div class="field"><label for="bondFinal">Capital al vencimiento</label><input class="control" id="bondFinal" type="number" value="100" min="0"></div><div class="field"><label for="coupon">Cupón anual (US$)</label><input class="control" id="coupon" type="number" value="1.5" min="0" step=".01"></div><div class="field"><label for="bondYears">Años al vencimiento</label><input class="control" id="bondYears" type="number" value="5" min=".1" step=".1"></div></div>
          <div class="fields" data-fields="stock"><div class="field"><label for="stockPrice">Precio de la acción ($)</label><input class="control" id="stockPrice" type="number" value="1200" min=".01"></div><div class="field"><label for="equity">Patrimonio neto ($)</label><input class="control" id="equity" type="number" value="500000000000"></div><div class="field"><label for="shares">Acciones en circulación</label><input class="control" id="shares" type="number" value="600000000" min="1"></div><div class="field"><label for="sectorPB">P/B promedio del sector</label><input class="control" id="sectorPB" type="number" value="1.5" min=".01" step=".1"></div></div>
          <button class="update" id="updateButton" type="submit">Actualizar diagnóstico</button>
        </div>
        <div class="panel result"><div class="kicker" id="kicker">SHARPE RATIO</div><div class="big" id="resultValue">0,78</div><div class="sub" id="resultSub">exceso de retorno de 14,07 puntos sobre 18% de volatilidad</div><div class="badge" id="resultBadge">Normal: eficiencia intermedia</div><div class="tiles"><div class="tile"><small id="t1l">Rendimiento</small><strong id="t1v">35%</strong></div><div class="tile"><small id="t2l">Tasa libre</small><strong id="t2v">20,93%</strong></div><div class="tile"><small id="t3l">Volatilidad</small><strong id="t3v">18%</strong></div></div></div></div>
      </form>
    </div>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Lectura, no sólo fórmula</div><h2 id="scaleTitle">En qué banda cae tu Sharpe</h2><p id="scaleCopy">El resultado mide exceso de retorno por cada punto de volatilidad.</p></div><div class="scale"><div class="scale-top"><div><h3 id="scaleName">Banda normal</h3><p id="scaleDetail">La mayoría de las carteras diversificadas cae entre 0,5 y 1.</p></div><div class="scale-value" id="scaleValue">0,78</div></div><div class="scale-line"><div class="marker" id="marker"></div></div><div class="ticks"><span>Débil / negativo</span><span>Intermedio</span><span>Bueno / alto</span></div></div></div></section>
    <section><div class="wrap two"><div class="info"><div class="eyebrow">Cálculo transparente</div><h3 id="breakTitle">Cómo se arma el número</h3><div class="rows" id="breakRows"></div></div><div class="info notice"><div class="notice-icon">◉</div><h3>Un solo ratio nunca alcanza</h3><p>El Sharpe castiga también las subas bruscas; la correlación cambia en las crisis; un bono de rendimiento alto incluye riesgo de crédito y un P/B bajo puede anticipar pérdidas.</p><div class="rows"><div class="row"><span>Ventana comparable</span><strong>Mismo período</strong></div><div class="row"><span>Moneda comparable</span><strong>Misma moneda</strong></div></div></div></div></section>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Tres preguntas antes de decidir</div><h2>Qué puede estar escondiendo el resultado</h2></div><div class="cards"><div class="card"><div class="card-icon">↕️</div><b>Volatilidad</b><span>Cuánto oscila el valor, no cuánto podés perder como máximo.</span></div><div class="card"><div class="card-icon">🔗</div><b>Correlación</b><span>Si todos caen juntos, tener muchos activos no protege.</span></div><div class="card"><div class="card-icon">⚠️</div><b>Riesgo de crédito</b><span>Una tasa alta en dólares suele descontar una probabilidad de incumplimiento.</span></div></div></div></section>
    <div class="dark"><div class="wrap dark-grid"><div class="formula">Retorno − tasa libre<span>÷ volatilidad</span>= Sharpe ratio<small>La misma ganancia puede ser mejor o peor según el riesgo necesario para obtenerla.</small></div><div><div class="eyebrow" style="color:#70d5c5">Usalo como diagnóstico</div><h2>Medir riesgo no convierte una inversión en segura.</h2><p>Los cálculos describen datos y supuestos. No predicen precios ni garantizan que una relación histórica siga funcionando.</p><div class="checks"><div class="check"><span class="tick">✓</span><span>Probá correlaciones más altas para simular una crisis.</span></div><div class="check"><span class="tick">✓</span><span>En bonos, verificá el cronograma real de pagos.</span></div><div class="check"><span class="tick">✓</span><span>Herramienta educativa: no es una recomendación de inversión.</span></div></div></div></div></div>
  `} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-riesgo-cartera')?document.currentScript.previousElementSibling:document.querySelector('.mockup-riesgo-cartera');

    const $=id=>root.querySelector("#"+id),fmt=(n,d=2)=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:d,minimumFractionDigits:d});let mode="sharpe";
    const cfg={sharpe:["Retorno ajustado por riesgo","Rendimiento, tasa y volatilidad deben estar en la misma moneda y período."],diversify:["Diversificación entre dos activos","Repartir sólo ayuda si los activos no se mueven igual."],bond:["Rendimiento y paridad del bono","El rendimiento supone que todos los pagos ocurren en tiempo y forma."],stock:["Price to book de la acción","Compará el precio contra el patrimonio por acción y el múltiplo sectorial."]};
    function set(id,v){$(id).textContent=v}function rows(a){$("breakRows").innerHTML=a.map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
    function scale(pos,title,name,detail,value){const copies={"En qué banda cae tu Sharpe":"El resultado mide exceso de retorno por cada punto de volatilidad.","Qué tan juntos se mueven":"La correlación muestra si dos activos aportan movimientos realmente distintos.","Rendimiento y riesgo implícito":"Una tasa alta en dólares suele reflejar mayor riesgo de crédito.","Valuación contra patrimonio":"El múltiplo compara el precio con el patrimonio contable por acción."};$("marker").style.left=Math.min(96,Math.max(4,pos))+"%";set("scaleTitle",title);set("scaleCopy",copies[title]||"Interpretá el resultado dentro de su propia escala.");set("scaleName",name);set("scaleDetail",detail);set("scaleValue",value)}
    function calculate(){const rf=Number($("riskFree").value)||0;
      if(mode==="sharpe"){const ret=Number($("return").value)||0,vol=Math.max(.01,Number($("volatility").value)||.01),excess=ret-rf,sh=excess/vol,reading=sh<0?"Negativo: no superó la tasa libre":sh<.5?"Bajo: poco retorno para el riesgo":sh<1?"Normal: eficiencia intermedia":sh<2?"Bueno: retorno compensa el riesgo":"Muy bueno: revisá los datos";set("kicker","SHARPE RATIO");set("resultValue",fmt(sh));set("resultSub",`exceso de retorno de ${fmt(excess)} puntos sobre ${fmt(vol)}% de volatilidad`);set("resultBadge",reading);set("t1l","Rendimiento");set("t1v",fmt(ret)+"%");set("t2l","Tasa libre");set("t2v",fmt(rf)+"%");set("t3l","Volatilidad");set("t3v",fmt(vol)+"%");scale((sh+1)/4*100,"En qué banda cae tu Sharpe",sh>=1?"Banda buena":sh>=.5?"Banda normal":"Banda baja",reading,fmt(sh));rows([["Rendimiento del portafolio",fmt(ret)+"%"],["Tasa libre de riesgo",fmt(rf)+"%"],["Exceso de retorno",fmt(excess)+" puntos"],["Volatilidad anual",fmt(vol)+"%"],["Sharpe ratio",fmt(sh)]])}
      if(mode==="diversify"){const w1=Math.min(100,Math.max(0,Number($("weight1").value)||0))/100,w2=1-w1,r1=Number($("return1").value)||0,r2=Number($("return2").value)||0,v1=Math.max(0,Number($("vol1").value)||0),v2=Math.max(0,Number($("vol2").value)||0),corr=Math.min(1,Math.max(-1,Number($("correlation").value)||0)),variance=(w1*v1)**2+(w2*v2)**2+2*w1*w2*v1*v2*corr,risk=Math.sqrt(Math.max(0,variance)),noDiv=w1*v1+w2*v2,benefit=noDiv-risk,reduction=noDiv?benefit/noDiv*100:0,ret=w1*r1+w2*r2;set("kicker","RIESGO DE LA COMBINACIÓN");set("resultValue",fmt(risk)+"%");set("resultSub",`${fmt(noDiv)}% sin beneficio de diversificar`);set("resultBadge",corr>=.8?"Casi no diversifica":corr>=.3?"Diversificación parcial":"Buena diversificación");set("t1l","Reducción");set("t1v",fmt(reduction,1)+"%");set("t2l","Retorno esperado");set("t2v",fmt(ret)+"%");set("t3l","Correlación");set("t3v",fmt(corr));scale((corr+1)/2*100,"Qué tan juntos se mueven","Correlación "+fmt(corr),corr<.3?"Los movimientos se compensan parcialmente.":"Los activos comparten buena parte del movimiento.",fmt(corr));rows([["Peso activo 1",fmt(w1*100,0)+"%"],["Peso activo 2",fmt(w2*100,0)+"%"],["Riesgo sin diversificar",fmt(noDiv)+"%"],["Riesgo combinado",fmt(risk)+"%"],["Beneficio",fmt(benefit)+" puntos"],["Retorno esperado",fmt(ret)+"%"]])}
      if(mode==="bond"){const price=Math.max(.01,Number($("bondPrice").value)||.01),final=Math.max(0,Number($("bondFinal").value)||0),coupon=Math.max(0,Number($("coupon").value)||0),years=Math.max(.1,Number($("bondYears").value)||.1),coupons=coupon*years,gain=final-price,current=coupon/price*100,simple=((final+coupons-price)/price)/years*100,parity=final?price/final*100:0;set("kicker","RENDIMIENTO ANUAL SIMPLE");set("resultValue",fmt(simple)+"%");set("resultSub",`comprando a ${fmt(price)} por cada 100 nominales`);set("resultBadge",simple>=15?"Riesgo alto implícito en el precio":simple>=8?"Riesgo intermedio":"Rendimiento bajo/intermedio");set("t1l","Paridad");set("t1v",fmt(parity,1)+"%");set("t2l","Cupón corriente");set("t2v",fmt(current)+"%");set("t3l","Ganancia capital");set("t3v","US$ "+fmt(gain));scale(Math.min(100,simple/30*100),"Rendimiento y riesgo implícito",simple>=15?"Banda de riesgo alto":"Banda intermedia","Una tasa alta supone riesgo de cobro.",fmt(simple)+"%");rows([["Precio de compra","US$ "+fmt(price)],["Capital al vencimiento","US$ "+fmt(final)],["Cupones totales","US$ "+fmt(coupons)],["Ganancia de capital","US$ "+fmt(gain)],["Paridad",fmt(parity,1)+"%"],["Rendimiento anual simple",fmt(simple)+"%"]])}
      if(mode==="stock"){const price=Math.max(.01,Number($("stockPrice").value)||.01),equity=Number($("equity").value)||0,shares=Math.max(1,Number($("shares").value)||1),sector=Math.max(.01,Number($("sectorPB").value)||1.5),book=equity/shares,pb=book?price/book:0,fair=book*sector,diff=fair?(price/fair-1)*100:0;set("kicker","PRICE TO BOOK");set("resultValue",fmt(pb)+" veces");set("resultSub",`contra ${fmt(sector)} veces del sector`);set("resultBadge",pb<1?"Cotiza bajo valor libro":pb<sector*.8?"Debajo del sector":pb>sector*1.3?"Por encima del sector":"En rango sectorial");set("t1l","Valor libro/acción");set("t1v","$"+fmt(book));set("t2l","Precio implícito");set("t2v","$"+fmt(fair));set("t3l","Diferencia");set("t3v",(diff>=0?"+":"")+fmt(diff,1)+"%");scale(Math.min(100,pb/(sector*2)*100),"Valuación contra patrimonio",pb>sector*1.3?"Por encima del sector":pb<sector*.8?"Por debajo del sector":"En rango","No distingue oportunidad de deterioro futuro.",fmt(pb)+"×");rows([["Precio de la acción","$"+fmt(price)],["Patrimonio neto","$"+equity.toLocaleString("es-AR")],["Acciones en circulación",shares.toLocaleString("es-AR")],["Valor libro por acción","$"+fmt(book)],["Price to book",fmt(pb)+"×"],["Precio al múltiplo sectorial","$"+fmt(fair)]])}}
    root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".fields").forEach(x=>x.classList.toggle("active",x.dataset.fields===mode));set("formTitle",cfg[mode][0]);set("formHint",cfg[mode][1]);calculate()}));root.querySelectorAll("input").forEach(x=>x.addEventListener("input",calculate));function confirm(){calculate();$("updateButton").textContent="✓ Diagnóstico actualizado";clearTimeout(window.riskTimer);window.riskTimer=setTimeout(()=>$("updateButton").textContent="Actualizar diagnóstico",1200)}$("calculator").addEventListener("submit",e=>{e.preventDefault();confirm()});$("updateButton").addEventListener("click",e=>{e.preventDefault();confirm()});calculate();
  
})();
</script>
<style is:global>

    .mockup-riesgo-cartera{--ink:#111a32;--muted:#667187;--blue:#2168e8;--teal:#25b3a0;--amber:#efad4b;--red:#e86e69;--paper:#f6f7f3;--line:#dfe4ea;--deepblue:#10264a}
    .mockup-riesgo-cartera *{box-sizing:border-box}.mockup-riesgo-cartera{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-riesgo-cartera button,.mockup-riesgo-cartera input{font:inherit}.mockup-riesgo-cartera .wrap{width:min(1180px,calc(100% - 40px));margin:auto}
    .mockup-riesgo-cartera header{height:86px;border-bottom:1px solid #e0e4e7;display:flex;align-items:center}.mockup-riesgo-cartera .nav{display:flex;align-items:center;gap:28px}.mockup-riesgo-cartera .brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:900}.mockup-riesgo-cartera .logo{width:29px;height:38px;border-radius:6px;background:linear-gradient(145deg,#18355c,#527a99);display:grid;place-items:center;color:white}.mockup-riesgo-cartera .links{display:flex;gap:25px;color:#505b6d;font-size:14px;font-weight:750}.mockup-riesgo-cartera .tools{margin-left:auto;display:flex;gap:9px}.mockup-riesgo-cartera .tool{height:42px;padding:0 14px;border:1px solid #dce1e7;background:#fff;border-radius:11px;color:#526075;font-weight:750}
    .mockup-riesgo-cartera .hero{display:grid;grid-template-columns:1.08fr .92fr;gap:45px;align-items:center;padding:62px 0 45px}.mockup-riesgo-cartera .crumb{color:#3167c4;font-size:14px;margin-bottom:17px}.mockup-riesgo-cartera .eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:#24749e;font-weight:900}.mockup-riesgo-cartera h1{font-size:clamp(43px,5vw,67px);line-height:1;letter-spacing:-.05em;margin:13px 0 20px}.mockup-riesgo-cartera .lead{font-size:19px;color:var(--muted);max-width:690px}.mockup-riesgo-cartera .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:25px}.mockup-riesgo-cartera .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:9px 13px;font-size:13px;font-weight:800}
    .mockup-riesgo-cartera .visual{height:330px;position:relative}.mockup-riesgo-cartera .donut{position:absolute;left:66px;top:31px;width:230px;height:230px;border-radius:50%;background:conic-gradient(#2770e7 0 43%,#26b3a0 43% 68%,#efad4b 68% 84%,#e86f69 84%);box-shadow:0 25px 55px #24385320}.mockup-riesgo-cartera .donut:after{content:"RIESGO";position:absolute;inset:55px;background:var(--paper);border-radius:50%;display:grid;place-items:center;color:#17385f;font-weight:950;letter-spacing:.08em}.mockup-riesgo-cartera .arrow{position:absolute;right:15px;top:48px;width:126px;height:105px;background:#fff;border-radius:15px;box-shadow:0 14px 30px #17385f20;padding:18px}.mockup-riesgo-cartera .axis{width:100%;height:100%;border-left:4px solid #dce3eb;border-bottom:4px solid #dce3eb;position:relative}.mockup-riesgo-cartera .axis:after{content:"";position:absolute;left:7px;right:3px;bottom:18px;height:5px;background:#e86f69;transform:rotate(-28deg);transform-origin:left;border-radius:5px;box-shadow:27px -20px 0 #efad4b,58px -34px 0 #26b3a0}.mockup-riesgo-cartera .note{position:absolute;background:#fff;border-radius:13px;padding:11px 14px;font-size:13px;font-weight:850;box-shadow:0 15px 34px #17385f1d}.mockup-riesgo-cartera .n1{left:0;top:4px}.mockup-riesgo-cartera .n2{right:0;bottom:9px;color:#1762d4}
    .mockup-riesgo-cartera .calc{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:65px}.mockup-riesgo-cartera .case-label{font-size:13px;font-weight:900;color:#5b677a;margin-bottom:11px}.mockup-riesgo-cartera .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-bottom:25px}.mockup-riesgo-cartera .case{border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:14px 9px;font-weight:850;color:#505d70;cursor:pointer}.mockup-riesgo-cartera .case.active{background:#edf4ff;color:#1c60d2;border-color:#246be7;box-shadow:inset 0 0 0 1px #246be7}.mockup-riesgo-cartera .grid{display:grid;grid-template-columns:1.04fr .96fr;gap:23px}.mockup-riesgo-cartera .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-riesgo-cartera .panel h2{font-size:22px;margin:0 0 5px}.mockup-riesgo-cartera .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-riesgo-cartera .fields{display:none;grid-template-columns:1fr 1fr;gap:14px}.mockup-riesgo-cartera .fields.active{display:grid}.mockup-riesgo-cartera .field.full{grid-column:1/-1}.mockup-riesgo-cartera .field label{display:block;font-size:13px;font-weight:800;margin-bottom:7px}.mockup-riesgo-cartera .control{width:100%;height:50px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-riesgo-cartera .control:focus{border-color:#286fe8;box-shadow:0 0 0 3px #286fe818}.mockup-riesgo-cartera .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:white;font-weight:900;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
    .mockup-riesgo-cartera .result{background:linear-gradient(145deg,#102c55,#0b1c38);border:0;color:#fff;position:relative;overflow:hidden}.mockup-riesgo-cartera .result:after{content:"";position:absolute;width:215px;height:215px;border:44px solid #27b4a122;border-radius:50%;right:-115px;bottom:-125px}.mockup-riesgo-cartera .kicker{font-size:12px;text-transform:uppercase;letter-spacing:.13em;color:#9ce0d4;font-weight:900}.mockup-riesgo-cartera .big{font-size:43px;line-height:1.07;font-weight:950;letter-spacing:-.04em;margin:14px 0 5px}.mockup-riesgo-cartera .sub{color:#c3d2e4}.mockup-riesgo-cartera .badge{display:inline-flex;margin-top:17px;padding:8px 11px;border-radius:99px;background:#1e4777;border:1px solid #3d6591;font-size:12px;font-weight:850}.mockup-riesgo-cartera .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:24px}.mockup-riesgo-cartera .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px}.mockup-riesgo-cartera .tile small{display:block;color:#adc0d6;text-transform:uppercase;font-size:10px;letter-spacing:.07em}.mockup-riesgo-cartera .tile strong{display:block;margin-top:5px;font-size:15px}
