---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-tarjeta-credito" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Finanzas personales / Tarjeta de crédito</div><div class="eyebrow">Proyector del próximo resumen</div><h1>Elegí cuánto pagar mirando el mes siguiente.</h1><p class="lead">El pago mínimo evita intereses punitorios, pero financia el resto. Este mockup muestra cómo evoluciona el saldo si no agregás compras nuevas.</p></div><aside class="statement"><div class="statement-top"><div><b>RESUMEN AGOSTO</b><span>•••• 2048</span></div><span>Vence 12/08</span></div><div class="statement-total"><small>TOTAL A PAGAR</small><strong id="paperTotal">$850.000</strong></div><div class="statement-lines"><div class="statement-line"><span>Pago mínimo</span><b id="paperMinimum">$127.500</b></div><div class="statement-line"><span>Tasa mensual informada</span><b id="paperRate">7,5%</b></div><div class="statement-line"><span>Próximo cierre</span><b>28/08</b></div></div></aside></div></section>
<section class="simulator"><div class="sim"><div class="sim-head"><div><h2>¿Qué pasa si pagás…?</h2><p>Comparamos escenarios sobre el mismo resumen.</p></div><span class="status" id="status">Pago intermedio</span></div><div class="pay-choice"><h3>Elegí un punto de partida</h3><div class="choices"><button class="choice" data-pay="minimum"><small>PAGO MÍNIMO</small><b id="minimumLabel">$127.500</b><span>Evita punitorios, financia casi todo.</span></button><button class="choice active" data-pay="custom"><small>MONTO ELEGIDO</small><b id="customLabel">$300.000</b><span>Reduce capital desde el primer mes.</span></button><button class="choice" data-pay="total"><small>PAGO TOTAL</small><b id="totalLabel">$850.000</b><span>No queda saldo para financiar.</span></button></div></div><div class="custom"><div class="field"><label for="balance">TOTAL DEL RESUMEN</label><input id="balance" type="number" value="850000" min="0" step="1000"></div><div class="field"><label for="payment">CUÁNTO PODÉS PAGAR</label><input id="payment" type="number" value="300000" min="0" step="1000"></div><div class="field"><label for="rate">TASA MENSUAL DEL RESUMEN (%)</label><input id="rate" type="number" value="7.5" min="0" max="50" step=".1"></div></div><div class="projection"><div><h3>Saldo proyectado si repetís ese pago</h3><p>Sin consumos nuevos, cargos adicionales ni cambios de tasa.</p><div class="months" id="months"></div></div><aside class="cost"><small>COSTO DE FINANCIAR</small><strong id="interest">$103.400</strong><p id="costText">Intereses acumulados hasta cancelar o completar seis meses.</p><dl><div><dt>Saldo después del pago</dt><dd id="after">$550.000</dd></div><div><dt>Meses estimados</dt><dd id="duration">3</dd></div><div><dt>Peso sobre ingreso</dt><dd id="burden">—</dd></div></dl></aside></div><div class="warning" id="warning">Pagar más que el mínimo acorta el plazo y baja el interés. Confirmá tasa, impuestos y cargos en tu resumen real.</div></div></section>
<section class="read"><div class="wrap read-grid"><div><div class="kicker">Qué mirar en el resumen</div><h2>Cuatro datos antes de decidir</h2><p>La tasa del ejemplo no reemplaza la que informa tu emisor.</p><div class="source">Orientación basada en la Ley 25.065 y material educativo del BCRA.</div></div><div class="keys"><div class="key"><b>Pago mínimo</b><span>Es el importe que evita punitorios; no cancela el saldo ni evita intereses financieros.</span></div><div class="key"><b>Tasa compensatoria</b><span>Se aplica al saldo financiado. Usá la tasa indicada en tu resumen.</span></div><div class="key"><b>Fecha de vencimiento</b><span>No pagar al menos el mínimo puede generar mora, punitorios e inhabilitación.</span></div><div class="key"><b>Consumos cuestionados</b><span>Un error o gasto desconocido tiene un procedimiento de impugnación; no lo mezcles con una decisión de financiación.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-tarjeta-credito')?document.currentScript.previousElementSibling:document.querySelector('.mockup-tarjeta-credito');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.max(0,Math.round(n)).toLocaleString("es-AR");let mode="custom";function calc(){const balance=Math.max(0,+$("#balance").value||0),rate=Math.max(0,+$("#rate").value||0)/100,minimum=balance*.15;let payment=mode==="minimum"?minimum:mode==="total"?balance:Math.max(0,+$("#payment").value||0);if(mode!=="custom")$("#payment").value=Math.round(payment);$("#paperTotal").textContent=money(balance);$("#paperMinimum").textContent=money(minimum);$("#paperRate").textContent=(rate*100).toFixed(1).replace(".",",")+"%";$("#minimumLabel").textContent=money(minimum);$("#customLabel").textContent=money(+$("#payment").value||0);$("#totalLabel").textContent=money(balance);let debt=balance,totalInterest=0,series=[];for(let i=0;i<6&&debt>.5;i++){const paid=Math.min(payment,debt),remaining=Math.max(0,debt-paid),interest=remaining*rate;totalInterest+=interest;debt=remaining+interest;series.push({month:i+1,debt,interest});if(payment<=interest&&remaining>0){while(series.length<6)series.push({month:series.length+1,debt,interest});break}}const max=Math.max(balance,...series.map(x=>x.debt),1);$("#months").innerHTML=series.map(x=>`<div class="month"><b>${money(x.debt)}</b><div class="bar" style="--h:${Math.max(3,x.debt/max*175)}px"></div><small>MES ${x.month}</small></div>`).join("")||`<div class="month"><b>$0</b><div class="bar" style="--h:3px"></div><small>CANCELADO</small></div>`;$("#interest").textContent=money(totalInterest);$("#after").textContent=money(Math.max(0,balance-payment));const impossible=payment>0&&payment<=Math.max(0,balance-payment)*rate;$("#duration").textContent=debt<=.5?series.length:impossible?"No baja":"Más de 6";$("#status").textContent=mode==="total"?"Resumen cancelado":mode==="minimum"?"Financiación larga":"Pago intermedio";$("#status").style.background=mode==="total"?"#e1f1e8":mode==="minimum"?"#ffe1db":"#fff0bc";$("#status").style.color=mode==="total"?"#174f40":mode==="minimum"?"#7b2823":"#674d08";$("#warning").textContent=impossible?"Con este pago, el interés puede absorber todo el esfuerzo mensual. La deuda no bajaría de forma sostenida.":mode==="total"?"Al pagar el total no queda saldo para financiar, siempre que no haya cargos posteriores.":"Pagar más que el mínimo acorta el plazo y baja el interés. Confirmá tasa, impuestos y cargos en tu resumen real."}$$("[data-pay]").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.pay;$$("[data-pay]").forEach(x=>x.classList.toggle("active",x===b));calc()}));$$("input").forEach(x=>x.addEventListener("input",()=>{if(x.id==="payment"){mode="custom";$$("[data-pay]").forEach(y=>y.classList.toggle("active",y.dataset.pay==="custom"))}calc()}));calc()})();
})();
</script>
<style is:global>

.mockup-tarjeta-credito{--blue:#174b7a;--orange:#d97946;--peach:#fff0e8;--mint:#e1f1e8;--ink:#182332;--muted:#5f6977;--line:#dae2e4;--red:#ad4d47;--cream:#fff8df}.mockup-tarjeta-credito *{box-sizing:border-box}.mockup-tarjeta-credito{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#f7f8f7}.mockup-tarjeta-credito button,.mockup-tarjeta-credito input{font:inherit}.mockup-tarjeta-credito .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-tarjeta-credito .brand{font-size:19px;font-weight:950}.mockup-tarjeta-credito .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-tarjeta-credito .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-tarjeta-credito .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-tarjeta-credito .hero{padding:45px 22px 55px;background:#fff}.mockup-tarjeta-credito .hero-grid,.mockup-tarjeta-credito .wrap{max-width:1180px;margin:auto}.mockup-tarjeta-credito .hero-grid{display:grid;grid-template-columns:1fr .85fr;gap:60px;align-items:center}.mockup-tarjeta-credito .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-tarjeta-credito .eyebrow{margin-top:26px;color:var(--orange);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-tarjeta-credito .hero h1{font-size:clamp(43px,5vw,65px);line-height:.98;letter-spacing:-.05em;margin:10px 0 18px}.mockup-tarjeta-credito .lead{font-size:19px;color:var(--muted);max-width:660px}.mockup-tarjeta-credito .statement{padding:25px;border:1px solid var(--line);border-radius:20px;background:#fff;box-shadow:0 25px 55px #17374a17;transform:rotate(1.5deg)}.mockup-tarjeta-credito .statement-top{display:flex;justify-content:space-between;gap:15px;border-bottom:1px dashed #bac5c9;padding-bottom:15px}.mockup-tarjeta-credito .statement-top b{font-size:18px}.mockup-tarjeta-credito .statement-top span{font-size:12px;color:var(--muted)}.mockup-tarjeta-credito .statement-total{padding:22px 0}.mockup-tarjeta-credito .statement-total small{display:block;color:var(--muted)}.mockup-tarjeta-credito .statement-total strong{font-size:40px;letter-spacing:-.04em}.mockup-tarjeta-credito .statement-lines{display:grid;gap:8px}.mockup-tarjeta-credito .statement-line{display:flex;justify-content:space-between;font-size:12px}.mockup-tarjeta-credito .statement-line b{color:var(--blue)}.mockup-tarjeta-credito .simulator{padding:0 22px 70px}.mockup-tarjeta-credito .sim{max-width:1180px;margin:auto;background:#fff;border:1px solid var(--line);border-radius:24px;overflow:hidden}.mockup-tarjeta-credito .sim-head{display:flex;justify-content:space-between;gap:25px;align-items:center;padding:23px 27px;background:var(--blue);color:#fff}.mockup-tarjeta-credito .sim-head h2{font-size:24px;margin:0}.mockup-tarjeta-credito .sim-head p{margin:3px 0 0;color:#dceaf0;font-size:13px}.mockup-tarjeta-credito .status{padding:7px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:900}.mockup-tarjeta-credito .pay-choice{padding:25px 27px;border-bottom:1px solid var(--line)}.mockup-tarjeta-credito .pay-choice h3{margin:0 0 15px;font-size:16px}.mockup-tarjeta-credito .choices{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-tarjeta-credito .choice{padding:16px;border:1px solid var(--line);border-radius:14px;background:#fff;text-align:left;color:var(--ink);cursor:pointer}.mockup-tarjeta-credito .choice small,.mockup-tarjeta-credito .choice b{display:block}.mockup-tarjeta-credito .choice small{color:var(--muted);font-size:10px}.mockup-tarjeta-credito .choice b{font-size:20px;margin:4px 0}.mockup-tarjeta-credito .choice span{font-size:11px;color:var(--muted)}.mockup-tarjeta-credito .choice.active{border:2px solid var(--orange);padding:15px;background:#fff8f4}.mockup-tarjeta-credito .custom{display:grid;grid-template-columns:1fr 1fr 1fr;gap:15px;padding:23px 27px;background:#fafbfa;border-bottom:1px solid var(--line)}.mockup-tarjeta-credito .field label{display:block;font-size:11px;font-weight:900;margin-bottom:6px}.mockup-tarjeta-credito .field input{width:100%;min-height:46px;border:1px solid #ccd6da;border-radius:10px;background:#fff;padding:10px 12px;color:var(--ink)}.mockup-tarjeta-credito .projection{display:grid;grid-template-columns:1.4fr .6fr;gap:25px;padding:27px}.mockup-tarjeta-credito .projection h3{font-size:18px;margin:0 0 4px}.mockup-tarjeta-credito .projection>div>p{font-size:12px;color:var(--muted);margin:0 0 19px}.mockup-tarjeta-credito .months{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;align-items:end;height:245px;border-bottom:2px solid #cbd5d8;padding:10px 5px 0}.mockup-tarjeta-credito .month{height:100%;display:flex;flex-direction:column;justify-content:end;align-items:center;gap:7px}.mockup-tarjeta-credito .bar{width:70%;height:var(--h);min-height:5px;border-radius:7px 7px 0 0;background:var(--orange);transition:.25s}.mockup-tarjeta-credito .month small{font-size:9px;color:var(--muted)}.mockup-tarjeta-credito .month b{font-size:10px}.mockup-tarjeta-credito .cost{padding:20px;border-radius:18px;background:var(--peach);align-self:start}.mockup-tarjeta-credito .cost small{display:block;color:#7f5140;font-size:10px}.mockup-tarjeta-credito .cost strong{display:block;font-size:34px;color:var(--red);letter-spacing:-.04em}.mockup-tarjeta-credito .cost p{font-size:12px;color:#745345}.mockup-tarjeta-credito .cost dl{margin:17px 0 0}.mockup-tarjeta-credito .cost dl div{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid #e8c9ba;font-size:12px}.mockup-tarjeta-credito .cost dt{color:#745345}.mockup-tarjeta-credito .cost dd{margin:0;font-weight:900}.mockup-tarjeta-credito .warning{margin:0 27px 27px;padding:14px 16px;border-left:5px solid var(--orange);background:var(--cream);font-size:13px}.mockup-tarjeta-credito .read{padding:63px 22px;background:#eef3f2}.mockup-tarjeta-credito .read-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:42px}.mockup-tarjeta-credito .kicker{color:var(--orange);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-tarjeta-credito .read h2{font-size:36px;letter-spacing:-.04em;margin:7px 0}.mockup-tarjeta-credito .read p{color:var(--muted)}.mockup-tarjeta-credito .keys{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mockup-tarjeta-credito .key{padding:17px;background:#fff;border:1px solid var(--line);border-radius:14px}.mockup-tarjeta-credito .key b{display:block;margin-bottom:5px}.mockup-tarjeta-credito .key span{font-size:12px;color:var(--muted)}.mockup-tarjeta-credito .source{margin-top:14px;color:var(--muted);font-size:11px}.mockup-tarjeta-credito .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:880px){.mockup-tarjeta-credito .nav{display:none}.mockup-tarjeta-credito .hero-grid,.mockup-tarjeta-credito .projection,.mockup-tarjeta-credito .read-grid{grid-template-columns:1fr}.mockup-tarjeta-credito .statement{max-width:520px}.mockup-tarjeta-credito .months{height:210px}.mockup-tarjeta-credito .custom{grid-template-columns:1fr}.mockup-tarjeta-credito .choices{grid-template-columns:1fr}}@media(max-width:560px){.mockup-tarjeta-credito .hero h1{font-size:42px}.mockup-tarjeta-credito .keys{grid-template-columns:1fr}.mockup-tarjeta-credito .months{grid-template-columns:repeat(3,1fr);height:auto}.mockup-tarjeta-credito .month{height:160px}}

.mockup-tarjeta-credito { width:100%; overflow:hidden; }
.mockup-tarjeta-credito .top, .mockup-tarjeta-credito header.top { display:none !important; }
.mockup-tarjeta-credito .foot { display:none !important; }
.mockup-tarjeta-credito .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-tarjeta-credito .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-tarjeta-credito .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-tarjeta-credito .support-real summary { cursor:pointer; font-weight:750; }
.mockup-tarjeta-credito .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-tarjeta-credito :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-tarjeta-credito input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-tarjeta-credito input[type="number"]::-webkit-inner-spin-button, .mockup-tarjeta-credito input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-tarjeta-credito .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-tarjeta-credito support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
