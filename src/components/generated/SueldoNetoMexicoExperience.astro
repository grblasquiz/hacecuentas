---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-sueldo-neto-mexico" set:html={`<section class="hero"><div class="wrap crumb"><b>México</b> &nbsp;/&nbsp; Trabajo &nbsp;/&nbsp; Sueldo neto</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">Nómina mexicana 2026</span><h1>Del sueldo bruto<br>al dinero que<br>sí recibes.</h1><p>Entiende tu nómina sin descifrar tablas. Calculamos ISR, cuota obrera del IMSS, Infonavit y prestaciones para mostrarte qué llega a tu cuenta.</p><div class="chips"><span>✓ ISR Art. 96</span><span>✚ Cuota obrera IMSS</span><span>▣ Subsidio al empleo</span></div><div class="pay-art"><div class="sheet"><small>DEPÓSITO DE NÓMINA</small><strong id="art-net">$16,272</strong><div class="receipt-line"><span>ISR</span><b id="art-isr">− $2,356</b></div><div class="receipt-line"><span>IMSS</span><b id="art-imss">− $475</b></div></div><div class="coin">$</div><span class="mx-tag">MXN · mensual</span></div></div>
<form class="calc" onsubmit="return false"><div class="calc-title"><div><h2>Calcula tu sueldo</h2><p>Elige qué necesitas resolver.</p></div><span class="tag">Cálculo instantáneo</span></div><div class="section-label">¿Qué quieres saber?</div><div class="cases"><button type="button" class="case active" data-case="net"><i>💳</i>Mi sueldo neto</button><button type="button" class="case" data-case="gross"><i>↗</i>Neto a bruto</button><button type="button" class="case" data-case="isr"><i>%</i>Solo ISR</button><button type="button" class="case" data-case="hour"><i>◷</i>Valor por hora</button><button type="button" class="case" data-case="compare"><i>⚖️</i>Comparar ofertas</button></div><div class="section-label">Datos de tu nómina</div><div class="fields"><div class="field"><label id="salary-label">Sueldo bruto</label><input id="salary" inputmode="numeric" value="20,000"></div><div class="field"><label>Período de pago</label><select id="period"><option value="1">Mensual</option><option value="2">Quincenal</option><option value="4.333">Semanal</option></select></div><div class="field"><label>Descuento Infonavit</label><input id="infonavit" type="number" min="0" max="50" step=".5" value="0"></div><div class="field"><label>Vales de despensa</label><input id="vouchers" inputmode="numeric" value="0"></div><div class="field wide"><label>Horas trabajadas por semana</label><input id="hours" type="number" min="1" max="60" value="48"></div></div><div class="compare-fields" id="compare-fields"><div class="field"><label>Oferta B · sueldo bruto (mismo período)</label><input id="offer-b" inputmode="numeric" value="23,000"></div><div class="field"><label>Referencia</label><div style="font-size:11px;color:#63788e;line-height:1.5;padding-top:4px">La oferta A es el sueldo bruto de arriba. Ambas se calculan con la misma tarifa de ISR e IMSS.</div></div><div class="compare-answer" id="compare-answer"></div></div><section class="result"><div class="result-top"><div><small id="result-label">Sueldo neto estimado</small><div class="value" id="result-value">$16,272</div></div><div class="verdict"><small>Te queda</small><strong id="keep">81.4% del bruto</strong></div></div><div class="stats"><span>ISR retenido<b id="stat-isr">$2,356</b></span><span>Cuota IMSS<b id="stat-imss">$475</b></span><span>Descuento total<b id="stat-discount">$3,728</b></span></div><button class="go" id="update" type="button">Actualizar cálculo</button></section></form>
</div></section>
<section class="receipt"><div class="wrap"><header class="center"><span>Tu recibo, sin letra chica</span><h2>Concepto por concepto</h2><p>Separamos el dinero que llega a tu cuenta de cada retención para que puedas revisar tu recibo real.</p></header><div class="receipt-grid"><article class="card"><h3>Desglose mensual</h3><div class="line"><span>Sueldo bruto</span><b id="d-gross">$20,000</b></div><div class="line"><span>ISR después del subsidio</span><b id="d-isr">− $2,356</b></div><div class="line"><span>Cuota obrera IMSS</span><b id="d-imss">− $475</b></div><div class="line"><span>Infonavit</span><b id="d-infonavit">− $0</b></div><div class="line"><span>Vales de despensa</span><b id="d-vouchers">+ $0</b></div><div class="line total"><strong>Sueldo neto estimado</strong><b id="d-net">$16,272</b></div></article><article class="card"><h3>A dónde va tu sueldo</h3><div class="donut-wrap"><div class="donut" id="donut"><span class="donut-center"><span>RECIBES<b id="donut-pct">81%</b></span></span></div><div class="legend"><div><i style="background:#25a180"></i>Neto depositado</div><div><i style="background:#f0ae55"></i>ISR retenido</div><div><i style="background:#719ac2"></i>IMSS e Infonavit</div></div></div></article></div></div></section>
<section class="benefits"><div class="wrap"><header class="center"><span>Lo que tu sueldo también genera</span><h2>Prestaciones mínimas de ley</h2><p>No llegan cada mes a tu cuenta, pero forman parte del valor real de tu trabajo.</p></header><div class="benefit-grid"><article class="benefit"><i>🎁</i><h3>Aguinaldo</h3><p>Mínimo 15 días de salario.</p><strong id="annual-bonus">$10,000</strong><span>estimado anual</span></article><article class="benefit"><i>☀️</i><h3>Vacaciones</h3><p>Desde 12 días el primer año.</p><strong>12 días</strong><span>piso legal inicial</span></article><article class="benefit"><i>＋</i><h3>Prima vacacional</h3><p>Mínimo 25% sobre vacaciones.</p><strong id="vac-premium">$2,000</strong><span>estimado anual</span></article><article class="benefit"><i>📈</i><h3>PTU</h3><p>Participación en utilidades.</p><strong>Variable</strong><span>según empresa y antigüedad</span></article></div></div></section>
<section class="employer"><div class="wrap employer-grid"><div><span class="eyebrow">La otra cara de la nómina</span><h2>Tu sueldo cuesta más que tu bruto.</h2><p>Además de depositarte el bruto, la empresa paga cuotas patronales, aportaciones de vivienda y prestaciones. Verlo ayuda a negociar una compensación completa.</p></div><div class="cost-box"><div class="cost-head"><div><span>COSTO MENSUAL ESTIMADO</span><b id="employer-cost">$27,200</b></div><div style="text-align:right"><span>SOBRE TU BRUTO</span><b id="employer-pct">+36%</b></div></div><div class="cost-list"><div><small>CUOTAS PATRONALES</small><b id="employer-imss">$5,200</b></div><div><small>INFONAVIT</small><b id="employer-inf">$1,000</b></div><div><small>PRESTACIONES</small><b id="employer-benefits">$1,000</b></div></div></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">Tres números para negociar</span><h2>No compares ofertas solamente por el bruto.</h2><p>El período, las prestaciones superiores a ley y los beneficios exentos pueden cambiar mucho dos propuestas que parecen iguales.</p></div><div class="rules"><div><small>DEPÓSITO</small><b>Neto real</b><span>Lo que efectivamente recibes cada período.</span></div><div><small>PRESTACIONES</small><b>Valor anual</b><span>Aguinaldo, vacaciones, vales y fondo.</span></div><div><small>EMPRESA</small><b>Costo total</b><span>La referencia completa para negociar.</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sueldo-neto-mexico')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sueldo-neto-mexico');

const $=s=>root.querySelector(s),fmt=n=>"$"+new Intl.NumberFormat("es-MX",{maximumFractionDigits:0}).format(Math.round(n)),num=v=>Number(String(v).replace(/,/g,""))||0;let mode="net";
const brackets=[[0,746.04,0,.0192],[746.05,6332.05,14.32,.064],[6332.06,11128.01,371.83,.1088],[11128.02,12935.82,893.63,.16],[12935.83,15487.71,1182.88,.1792],[15487.72,31236.49,1640.18,.2136],[31236.5,49233,5004.12,.2352],[49233.01,93993.9,9236.89,.3],[93993.91,125325.2,22665.17,.32],[125325.21,375975.61,32691.18,.34],[375975.62,1e12,117912.32,.35]];
function tax(g){const b=brackets.find(x=>g>=x[0]&&g<=x[1])||brackets.at(-1);return Math.max(0,b[2]+(g-b[0])*b[3])}function deduct(g,inf=0){const isr=tax(g),imss=Math.min(g,84000)*.02375+Math.max(0,Math.min(g,84000)-10000)*.004,infonavit=g*inf/100;return{isr,imss,infonavit,net:g-isr-imss-infonavit}}
function grossForNet(target,inf){let lo=target,hi=target*2;for(let i=0;i<80;i++){let mid=(lo+hi)/2;if(deduct(mid,inf).net<target)lo=mid;else hi=mid}return hi}
function calc(){const period=Number($("#period").value),input=num($("#salary").value),inf=Number($("#infonavit").value)||0,vouchers=num($("#vouchers").value)*period,hours=Math.max(1,Number($("#hours").value)||48);let gross=input*period;if(mode==="gross")gross=grossForNet(input*period,inf);let d=deduct(gross,mode==="isr"||mode==="hour"?0:inf);if(mode==="hour")d={isr:0,imss:0,infonavit:0,net:gross};let net=d.net+vouchers,label="Sueldo neto estimado",value=net;if(mode==="gross"){label="Sueldo bruto que debes pedir";value=gross}if(mode==="isr"){label="ISR mensual estimado";value=d.isr}if(mode==="hour"){label="Valor de tu hora ordinaria";value=gross/(hours*52/12)}const shown=value/period,netShown=net/period,grossShown=gross/period,isrShown=d.isr/period,imssShown=(mode==="isr"?0:d.imss)/period,infShown=(mode==="isr"||mode==="hour"?0:d.infonavit)/period,vouchShown=vouchers/period,keep=gross?net/gross*100:0;$("#result-label").textContent=label;$("#result-value").textContent=fmt(shown);$("#keep").textContent=mode==="hour"?`${hours} h por semana`:`${keep.toFixed(1)}% del bruto`;$("#stat-isr").textContent=fmt(isrShown);$("#stat-imss").textContent=fmt(imssShown);$("#stat-discount").textContent=fmt(isrShown+imssShown+infShown);$("#art-net").textContent=fmt(netShown);$("#art-isr").textContent="− "+fmt(isrShown);$("#art-imss").textContent="− "+fmt(imssShown);$("#d-gross").textContent=fmt(grossShown);$("#d-isr").textContent="− "+fmt(isrShown);$("#d-imss").textContent="− "+fmt(imssShown);$("#d-infonavit").textContent="− "+fmt(infShown);$("#d-vouchers").textContent="+ "+fmt(vouchShown);$("#d-net").textContent=fmt(netShown);$("#donut-pct").textContent=Math.round(keep)+"%";const pNet=Math.max(0,Math.min(100,keep)),pIsr=Math.max(0,Math.min(100-pNet,isrShown/grossShown*100));$("#donut").style.background=`conic-gradient(#25a180 0 ${pNet}%,#f0ae55 ${pNet}% ${pNet+pIsr}%,#719ac2 ${pNet+pIsr}% 100%)`;$("#annual-bonus").textContent=fmt(gross/2);$("#vac-premium").textContent=fmt(gross/10);$("#employer-imss").textContent=fmt(gross*.26);$("#employer-inf").textContent=fmt(gross*.05);$("#employer-benefits").textContent=fmt(gross*.05);$("#employer-cost").textContent=fmt(gross*1.36);$("#employer-pct").textContent="+36%";if(mode==="compare"){const gA=num($("#salary").value)*period,gB=num($("#offer-b").value)*period,dA=deduct(gA,inf),dB=deduct(gB,inf),diffY=(dB.net-dA.net)*12,win=diffY>=0?"B":"A",abs=Math.abs(diffY);$("#result-label").textContent="Diferencia anual entre ofertas";$("#result-value").textContent=fmt(abs);$("#keep").textContent="Gana la oferta "+win;$("#compare-answer").textContent=`La oferta ${win} te deja ${fmt(abs)} más al año (${fmt(abs/12)} al mes). Neto mensual A: ${fmt(dA.net)} · Neto mensual B: ${fmt(dB.net)}.`}}
root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(x=>x.classList.remove("active"));b.classList.add("active");mode=b.dataset.case;$("#salary-label").textContent=mode==="gross"?"Sueldo neto que quieres recibir":mode==="compare"?"Oferta A · sueldo bruto":"Sueldo bruto";$("#compare-fields").classList.toggle("open",mode==="compare");calc()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calc));$("#update").addEventListener("click",e=>{calc();e.currentTarget.textContent="✓ Cálculo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar cálculo",1200)});calc();

})();
</script>
