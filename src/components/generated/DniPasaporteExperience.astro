---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-dni-pasaporte" set:html={`<section class="hero"><div class="shell hero-grid"><div><div class="crumb">Trámites / DNI y pasaporte</div><div class="eyebrow">Tarifas RENAPER 2026</div><h1>Elegí la modalidad justa para llegar a tiempo.</h1><p class="lede">Compará costo, entrega y vigencia para una persona o para todo el grupo familiar.</p><div class="chips"><span class="chip">Aranceles oficiales</span><span class="chip">Demoras por modalidad</span><span class="chip">Costo familiar</span></div></div><div class="art" aria-hidden="true"><div class="orb"></div><div class="card-art"><div class="art-tag">TOTAL DEL TRÁMITE</div><div class="art-value" id="heroValue">$10.000</div><div class="art-line"></div></div></div></div></section><section class="section"><div class="shell"><div class="head"><div class="eyebrow">Cuatro necesidades frecuentes</div><h2>No pagues urgencia si no la necesitás</h2><p>Cada caso carga el arancel oficial correspondiente; luego podés cambiar documento, modalidad y cantidad.</p></div><div class="cases"><button class="case active" data-case="0"><b>DNI regular</b><small>Nuevo ejemplar o actualización sin urgencia.</small></button><button class="case" data-case="1"><b>DNI al instante</b><small>Retiro entre 2 y 6 horas, sólo en sedes habilitadas.</small></button><button class="case" data-case="2"><b>Pasaporte regular</b><small>Para viajes planificados con suficiente anticipación.</small></button><button class="case" data-case="3"><b>Pasaporte exprés</b><small>Entrega dentro de las 96 horas hábiles.</small></button></div><div class="calc"><div class="panel"><h3>Armá el trámite</h3><p class="intro" id="caseIntro">Nuevo ejemplar o actualización de DNI argentino.</p><div class="fields"><div class="field"><label for="document">Documento</label><select id="document"><option value="dni">DNI argentino</option><option value="foreign">DNI para extranjeros</option><option value="passport">Pasaporte argentino</option></select></div><div class="field"><label for="modality">Modalidad</label><select id="modality"></select></div><div class="field"><label for="people">Cantidad de personas</label><input id="people" type="number" min="1" max="20" step="1" value="1"></div><div class="field"><label for="age">Edad del titular principal</label><select id="age"><option value="adult">18 años o más</option><option value="minor">Menor de 18 años</option></select></div></div><div class="buttons"><button class="primary" id="calculate">Actualizar presupuesto</button><button class="secondary" id="reset">Reiniciar</button></div></div><div class="panel result" aria-live="polite"><div class="res-top"><div><div class="label">Costo total oficial</div><div class="amount" id="amount">—</div></div><span class="pill" id="scenario">DNI regular</span></div><p class="summary" id="summary"></p><div class="metrics"><div class="metric"><span>Costo por persona</span><strong id="m1">—</strong></div><div class="metric"><span>Entrega informada</span><strong id="m2">—</strong></div><div class="metric"><span>Vigencia</span><strong id="m3">—</strong></div><div class="metric"><span>Personas incluidas</span><strong id="m4">—</strong></div></div><div class="progress"><i id="bar"></i></div><div class="note" id="note">Los trámites urgentes y al instante sólo están disponibles en oficinas habilitadas. Confirmá sede y turno en Mi Argentina.</div></div></div></div></section><section class="section support"><div class="shell"><div class="head"><div class="eyebrow">Antes del turno</div><h2>Qué revisar para no volver</h2></div><div class="support-grid"><article class="support-card"><span>DNI</span><h3>Nuevo ejemplar</h3><p>Si tenés el DNI anterior, llevalo. La denuncia por robo o extravío puede presentarse, pero no es excluyente para mayores.</p></article><article class="support-card"><span>MENORES</span><h3>Acompañamiento y vínculo</h3><p>Los menores deben presentarse con padre, madre o representante legal y la documentación correspondiente.</p></article><article class="support-card"><span>PASAPORTE</span><h3>Revisá el destino</h3><p>Para países miembros o asociados del Mercosur puede utilizarse DNI argentino vigente; otros destinos requieren pasaporte.</p></article></div></div></section><section class="section"><div class="shell faq"><div class="head"><div class="eyebrow">Preguntas frecuentes</div><h2>Lo importante, sin vueltas</h2></div><div class="faq-item open"><button class="faq-q">¿Cuánto cuesta el DNI regular?<span>+</span></button><div class="faq-a">$10.000 para nuevo ejemplar o actualizaciones de DNI argentino, según el tarifario RENAPER vigente desde marzo de 2026.</div></div><div class="faq-item"><button class="faq-q">¿Cuánto demora el pasaporte exprés?<span>+</span></button><div class="faq-a">La entrega informada es dentro de las 96 horas hábiles posteriores al trámite, sujeta a verificaciones.</div></div><div class="faq-item"><button class="faq-q">¿El pasaporte dura lo mismo para menores?<span>+</span></button><div class="faq-a">No. La vigencia informada es de 10 años para mayores de 18 y de 5 años para menores.</div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-dni-pasaporte')?document.currentScript.previousElementSibling:document.querySelector('.mockup-dni-pasaporte');

(()=>{const $=id=>root.querySelector("#"+id),money=v=>"$"+Math.round(v).toLocaleString("es-AR"),catalog={dni:{regular:{name:"DNI regular",price:10000,time:"Entrega por correo",progress:25},express:{name:"DNI exprés",price:26000,time:"48–96 h hábiles",progress:55},day:{name:"DNI 24 horas",price:41000,time:"24 h hábiles",progress:75},instant:{name:"DNI al instante",price:57000,time:"2–6 horas",progress:96}},foreign:{regular:{name:"DNI extranjero regular",price:20000,time:"Entrega regular",progress:25}},passport:{regular:{name:"Pasaporte regular",price:100000,time:"Entrega regular",progress:25},express:{name:"Pasaporte exprés",price:200000,time:"Hasta 96 h hábiles",progress:65},instant:{name:"Pasaporte al instante",price:330000,time:"Dentro de 6 horas",progress:96}}},presets=[["dni","regular"],["dni","instant"],["passport","regular"],["passport","express"]],intros=["Nuevo ejemplar o actualización de DNI argentino.","Disponible únicamente en sedes habilitadas con retiro presencial.","Pasaporte argentino con entrega regular.","Entrega prioritaria sujeta a controles y sede habilitada."];let active=0;function renderModalities(preferred){const doc=$("document").value,options=catalog[doc];$("modality").innerHTML=Object.entries(options).map(([key,v])=>`<option value="${key}">${v.name} · ${money(v.price)}</option>`).join("");$("modality").value=options[preferred]?preferred:Object.keys(options)[0]}function compute(){const doc=$("document").value,mod=$("modality").value,item=catalog[doc][mod],people=Math.max(1,Math.round(Number($("people").value)||1)),total=item.price*people,isPassport=doc==="passport",validity=isPassport?($("age").value==="minor"?"5 años":"10 años"):($("age").value==="minor"?"Hasta próxima actualización":"15 años");$("amount").textContent=money(total);$("heroValue").textContent=money(total);$("scenario").textContent=item.name;$("summary").textContent=`${people} ${people===1?"trámite":"trámites"} de ${item.name.toLowerCase()} cuestan ${money(total)} según el tarifario vigente.`;$("m1").textContent=money(item.price);$("m2").textContent=item.time;$("m3").textContent=validity;$("m4").textContent=String(people);$("bar").style.width=item.progress+"%";$("note").textContent=mod==="regular"?"Sacá turno y verificá la entrega informada para tu sede antes de pagar.":"La modalidad urgente sólo está disponible en oficinas habilitadas. Confirmá sede y turno en Mi Argentina."}function preset(i){active=i;const p=presets[i];$("document").value=p[0];renderModalities(p[1]);$("people").value=1;$("caseIntro").textContent=intros[i];root.querySelectorAll("[data-case]").forEach((b,j)=>b.classList.toggle("active",i===j));compute()}root.querySelectorAll("[data-case]").forEach(b=>b.addEventListener("click",()=>preset(Number(b.dataset.case))));$("document").addEventListener("change",()=>{active=-1;renderModalities();compute()});$("modality").addEventListener("change",compute);$("people").addEventListener("input",compute);$("age").addEventListener("change",compute);$("calculate").addEventListener("click",compute);$("reset").addEventListener("click",()=>{$("age").value="adult";preset(0)});root.querySelectorAll(".faq-q").forEach(q=>q.addEventListener("click",()=>q.parentElement.classList.toggle("open")));renderModalities("regular");compute()})();

})();
</script>
<style is:global>

.mockup-dni-pasaporte{--ink:#182231;--muted:#657386;--blue:#174b7a;--blue2:#eaf4fb;--mint:#39b799;--mint2:#e7f8f3;--coral:#e77c67;--sun:#f4bd55;--line:#dce4e9;--paper:#fbfcfa;--white:#fff;--shadow:0 18px 48px rgba(23,75,122,.1)}.mockup-dni-pasaporte *{box-sizing:border-box}.mockup-dni-pasaporte{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-dni-pasaporte button,.mockup-dni-pasaporte input,.mockup-dni-pasaporte select{font:inherit}.mockup-dni-pasaporte .shell{max-width:1180px;margin:auto;padding:0 24px}.mockup-dni-pasaporte .header{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-dni-pasaporte .nav{display:flex;justify-content:space-between;align-items:center}.mockup-dni-pasaporte .brand{display:flex;align-items:center;gap:10px;font-weight:900}.mockup-dni-pasaporte .logo{width:31px;height:35px;border-radius:7px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:12px}.mockup-dni-pasaporte .links{display:flex;gap:24px;color:#526074;font-size:13px;font-weight:750}.mockup-dni-pasaporte .navbtn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 12px;color:#46566a}.mockup-dni-pasaporte .hero{padding:52px 0 47px;background:linear-gradient(135deg,#eef9f6,#fff7e7 58%,#edf6fb)}.mockup-dni-pasaporte .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:50px;align-items:center}.mockup-dni-pasaporte .crumb{color:var(--blue);font-size:13px;font-weight:800}.mockup-dni-pasaporte .eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:900;color:var(--blue);margin-top:18px}.mockup-dni-pasaporte .hero h1{font-size:52px;line-height:1.03;letter-spacing:-.05em;margin:12px 0 17px}.mockup-dni-pasaporte .lede{font-size:18px;line-height:1.55;color:#536174}.mockup-dni-pasaporte .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.mockup-dni-pasaporte .chip{background:#fff;border:1px solid #d4e2df;border-radius:99px;padding:8px 11px;font-size:11px;color:#46655e;font-weight:800}.mockup-dni-pasaporte .art{height:310px;position:relative}.mockup-dni-pasaporte .orb{position:absolute;width:265px;height:265px;border-radius:50%;right:35px;top:18px;background:#dceef2}.mockup-dni-pasaporte .card-art{position:absolute;left:20px;top:64px;width:250px;height:164px;border-radius:23px;background:#fff;border:3px solid var(--blue);box-shadow:14px 16px 0 rgba(57,183,153,.22);padding:25px}.mockup-dni-pasaporte .art-tag{font-size:10px;color:var(--blue);font-weight:900;letter-spacing:.08em}.mockup-dni-pasaporte .art-value{font-size:37px;font-weight:950;color:var(--blue);margin:17px 0}.mockup-dni-pasaporte .art-line{height:9px;border-radius:9px;background:linear-gradient(90deg,var(--mint) 0 67%,#e5ebee 67%)}.mockup-dni-pasaporte .section{padding:62px 0}.mockup-dni-pasaporte .head{text-align:center;max-width:790px;margin:0 auto 29px}.mockup-dni-pasaporte .head h2{font-size:36px;letter-spacing:-.04em;margin:8px 0}.mockup-dni-pasaporte .head p{color:var(--muted);line-height:1.6}.mockup-dni-pasaporte .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:22px}.mockup-dni-pasaporte .case{border:1px solid var(--line);background:#fff;border-radius:17px;padding:16px;text-align:left;cursor:pointer;color:var(--ink);min-height:108px}.mockup-dni-pasaporte .case.active{border:2px solid var(--blue);background:var(--blue2)}.mockup-dni-pasaporte .case b{display:block;font-size:13px;margin-bottom:6px}.mockup-dni-pasaporte .case small{color:var(--muted);font-size:10px;line-height:1.4}.mockup-dni-pasaporte .calc{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px;align-items:start}.mockup-dni-pasaporte .panel{background:#fff;border:1px solid var(--line);border-radius:23px;padding:27px;box-shadow:var(--shadow)}.mockup-dni-pasaporte .panel h3{font-size:21px;margin:0 0 7px}.mockup-dni-pasaporte .intro{font-size:13px;color:var(--muted);line-height:1.5;margin:0 0 20px}.mockup-dni-pasaporte .fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-dni-pasaporte .field.full{grid-column:1/-1}.mockup-dni-pasaporte .field label{display:block;font-size:12px;font-weight:850;margin-bottom:7px}.mockup-dni-pasaporte .field input,.mockup-dni-pasaporte .field select{width:100%;height:48px;border:1px solid #cbd5df;border-radius:12px;background:#fff;color:var(--ink);padding:0 12px;outline:none}.mockup-dni-pasaporte .field input:focus,.mockup-dni-pasaporte .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,75,122,.12)}.mockup-dni-pasaporte .buttons{display:flex;gap:9px;margin-top:20px}.mockup-dni-pasaporte .primary,.mockup-dni-pasaporte .secondary{border-radius:12px;padding:13px 16px;font-weight:900;cursor:pointer}.mockup-dni-pasaporte .primary{border:1px solid var(--blue);background:var(--blue);color:#fff;flex:1}.mockup-dni-pasaporte .secondary{border:1px solid #ccd6df;background:#fff;color:#47576b}.mockup-dni-pasaporte .result{background:linear-gradient(145deg,#174b7a,#287b9b);color:#fff}.mockup-dni-pasaporte .result .intro{color:#d8eaf2}.mockup-dni-pasaporte .res-top{display:flex;justify-content:space-between;gap:12px}.mockup-dni-pasaporte .label{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#c6e3ed;font-weight:900}.mockup-dni-pasaporte .amount{font-size:42px;font-weight:950;letter-spacing:-.05em;margin:9px 0}.mockup-dni-pasaporte .pill{height:max-content;background:#e5faf3;color:#155e4e;border-radius:99px;padding:8px 10px;font-size:10px;font-weight:900}.mockup-dni-pasaporte .summary{font-size:13px;line-height:1.55;color:#eff7f9}.mockup-dni-pasaporte .metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:17px}.mockup-dni-pasaporte .metric{border:1px solid rgba(255,255,255,.23);background:rgba(255,255,255,.1);border-radius:14px;padding:14px}.mockup-dni-pasaporte .metric span{display:block;color:#d3e7ee;font-size:10px}.mockup-dni-pasaporte .metric strong{display:block;color:#fff;font-size:18px;margin-top:4px}.mockup-dni-pasaporte .progress{height:12px;background:rgba(255,255,255,.18);border-radius:99px;overflow:hidden;margin-top:18px}.mockup-dni-pasaporte .progress i{display:block;height:100%;width:68%;background:var(--sun);border-radius:99px;transition:.25s}.mockup-dni-pasaporte .note{margin-top:14px;background:#fff2d7;color:#684817;border-radius:12px;padding:11px 13px;font-size:11px;font-weight:750}.mockup-dni-pasaporte .support{background:#f1f7f5}.mockup-dni-pasaporte .support-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-dni-pasaporte .support-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.mockup-dni-pasaporte .support-card span{display:inline-block;background:var(--mint2);color:#176d5b;border-radius:8px;padding:5px 7px;font-size:9px;font-weight:900}.mockup-dni-pasaporte .support-card h3{font-size:15px;margin:11px 0 6px}.mockup-dni-pasaporte .support-card p{font-size:11px;line-height:1.5;color:var(--muted);margin:0}.mockup-dni-pasaporte .faq{max-width:850px;margin:auto}.mockup-dni-pasaporte .faq-item{border-bottom:1px solid var(--line)}.mockup-dni-pasaporte .faq-q{width:100%;border:0;background:transparent;color:var(--ink);display:flex;justify-content:space-between;text-align:left;padding:19px 3px;font-weight:850;cursor:pointer}.mockup-dni-pasaporte .faq-a{display:none;color:var(--muted);line-height:1.6;padding:0 35px 18px 3px}.mockup-dni-pasaporte .faq-item.open .faq-a{display:block}.mockup-dni-pasaporte .footer{height:100px;background:#fff;border-top:1px solid var(--line);display:grid;place-items:center;color:var(--muted);font-size:12px}@media(max-width:900px){.mockup-dni-pasaporte .links{display:none}.mockup-dni-pasaporte .hero-grid,.mockup-dni-pasaporte .calc{grid-template-columns:1fr}.mockup-dni-pasaporte .cases{grid-template-columns:1fr 1fr}.mockup-dni-pasaporte .support-grid{grid-template-columns:1fr}.mockup-dni-pasaporte .hero h1{font-size:43px}}@media(max-width:560px){.mockup-dni-pasaporte .shell{padding:0 16px}.mockup-dni-pasaporte .hero h1{font-size:35px}.mockup-dni-pasaporte .art{display:none}.mockup-dni-pasaporte .cases,.mockup-dni-pasaporte .fields,.mockup-dni-pasaporte .metrics{grid-template-columns:1fr}.mockup-dni-pasaporte .panel{padding:21px}.mockup-dni-pasaporte .res-top{display:block}.mockup-dni-pasaporte .pill{display:inline-block;margin-top:8px}}

.mockup-dni-pasaporte { width:100%; overflow:hidden; }
.mockup-dni-pasaporte .top, .mockup-dni-pasaporte header.top { display:none !important; }
.mockup-dni-pasaporte .foot { display:none !important; }
.mockup-dni-pasaporte .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-dni-pasaporte .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-dni-pasaporte .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-dni-pasaporte .support-real summary { cursor:pointer; font-weight:750; }
.mockup-dni-pasaporte .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-dni-pasaporte :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-dni-pasaporte input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-dni-pasaporte input[type="number"]::-webkit-inner-spin-button, .mockup-dni-pasaporte input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-dni-pasaporte .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-dni-pasaporte support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
