---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-dni-pasaporte" set:html={`<div class="crumb">Trámites / Documentos</div><h1>El documento no vence cuando viajás: vence antes.</h1><p class="lead">Compará cada documento con la fecha del viaje sin aplicar reglas de pasaporte al DNI.</p><section class="wallet"><div class="documents"><h2>Tu billetera</h2><div class="doc"><i class="photo"></i><div><b>DNI físico</b><br>Vence <input id="dni" type="date" value="2028-05-10"></div><span class="status" id="dniStatus"></span></div><div class="doc pass"><i class="photo"></i><div><b>Pasaporte</b><br>Vence <input id="passport" type="date" value="2027-02-15"></div><span class="status" id="passStatus"></span></div></div><aside class="trip"><h2>Próximo viaje</h2><label>Salida<input id="travel" type="date" value="2026-12-10"></label><label>Documento que admite el destino<select id="document"><option value="passport">Pasaporte</option><option value="dni">DNI físico</option></select></label><label>Vigencia posterior exigida al pasaporte<select id="buffer"><option value="0">Ninguna adicional</option><option value="3">3 meses</option><option value="6" selected>6 meses</option></select></label><div id="timeline"></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-dni-pasaporte')?document.currentScript.previousElementSibling:document.querySelector('.mockup-dni-pasaporte');

const $=x=>root.querySelector("#"+x);function render(){const trip=new Date($('travel').value+'T12:00:00'),need=new Date(trip);need.setMonth(need.getMonth()+ +$('buffer').value);const dni=new Date($('dni').value+'T12:00:00'),pass=new Date($('passport').value+'T12:00:00'),doc=$('document').value;$('dniStatus').textContent=dni>=trip?'Vigente en la fecha':'Renovar';$('passStatus').textContent=pass>=need?'Cumple el margen':'Renovar/revisar';$('timeline').innerHTML=`<div class="task">Viaje: ${trip.toLocaleDateString('es-AR')}</div><div class="task urgent">${doc==='dni'?`El destino admite DNI físico: debe estar vigente el día del viaje. El DNI digital no reemplaza el documento.`:`El destino exige pasaporte: con el margen elegido debe cubrir hasta ${need.toLocaleDateString('es-AR')}.`}</div><div class="task">Confirmá documento admitido y vigencia en la fuente oficial del destino.</div>`}root.querySelectorAll('input,select').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-dni-pasaporte{--blue:#174b7a;--ink:#182a32;--muted:#65747c;--line:#d7e1df;--orange:#e47a45;--green:#397b67;--paper:#f5f7f5}.mockup-dni-pasaporte *{box-sizing:border-box}.mockup-dni-pasaporte{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-dni-pasaporte input,.mockup-dni-pasaporte select{font:inherit}.mockup-dni-pasaporte .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-dni-pasaporte .crumb{color:var(--blue);font-weight:850}.mockup-dni-pasaporte h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-dni-pasaporte .lead{font-size:18px;color:var(--muted)}.mockup-dni-pasaporte .wallet{display:grid;grid-template-columns:1fr 340px;gap:20px;margin-top:26px}.mockup-dni-pasaporte .documents,.mockup-dni-pasaporte .trip{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-dni-pasaporte .doc{border-radius:18px;padding:19px;margin-bottom:12px;background:var(--blue);color:#fff;display:grid;grid-template-columns:55px 1fr auto;gap:14px}.mockup-dni-pasaporte .doc.pass{background:var(--green)}.mockup-dni-pasaporte .photo{width:50px;height:60px;border-radius:8px;background:#dbe6e1}.mockup-dni-pasaporte .doc input{border:0;border-bottom:2px solid #ffffff70;background:transparent;color:#fff}.mockup-dni-pasaporte .status{font-weight:900}.mockup-dni-pasaporte .trip label{display:block;font-size:12px;font-weight:850;margin:14px 0}.mockup-dni-pasaporte .trip input,.mockup-dni-pasaporte .trip select{display:block;width:100%;border:0;border-bottom:2px solid var(--line);padding:8px 0}.mockup-dni-pasaporte .task{padding:12px;border-left:5px solid var(--green);background:#e3f1eb;margin-top:8px}.mockup-dni-pasaporte .task.urgent{border-color:var(--orange);background:#fff2dd}@media(max-width:760px){.mockup-dni-pasaporte .wallet{grid-template-columns:1fr}.mockup-dni-pasaporte .doc{grid-template-columns:50px 1fr}.mockup-dni-pasaporte .status{grid-column:2}}
.mockup-dni-pasaporte { width:100%; overflow:hidden; }
.mockup-dni-pasaporte .top, .mockup-dni-pasaporte header.top { display:none !important; }
.mockup-dni-pasaporte .foot { display:none !important; }
.mockup-dni-pasaporte .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-dni-pasaporte .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-dni-pasaporte .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-dni-pasaporte .support-real summary { cursor:pointer; font-weight:750; }
.mockup-dni-pasaporte .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-dni-pasaporte :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-dni-pasaporte input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-dni-pasaporte input[type="number"]::-webkit-inner-spin-button, .mockup-dni-pasaporte input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-dni-pasaporte .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-dni-pasaporte support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
