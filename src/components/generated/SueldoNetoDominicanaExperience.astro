---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-sueldo-neto-dominicana" set:html={`<section class="hero"><div class="wrap crumb"><b>República Dominicana</b> &nbsp;/&nbsp; Trabajo &nbsp;/&nbsp; Sueldo neto</div><div class="wrap grid"><div class="copy"><div class="eyebrow">Tu nómina, peso por peso</div><h1>Del salario acordado a lo que llega a tu cuenta.</h1><p>Calculá AFP, SFS e ISR con las reglas dominicanas. Entendé cuánto se descuenta y por qué.</p><div class="chips"><span>✓ AFP 2,87%</span><span>✚ SFS 3,04%</span><span>▤ ISR por escala anual</span></div><div class="art"><div class="wallet"></div><div class="paper"><small>COMPROBANTE</small><b>Sueldo del mes</b>AFP &nbsp;·&nbsp; SFS &nbsp;·&nbsp; ISR</div><div class="netcard"><small>TE LLEGA ESTE MES</small><strong id="art-net">RD$ 47.045</strong><span id="art-copy">sobre RD$ 50.000 brutos</span></div></div></div><form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá tu salario neto</h2><p class="muted">Contanos cómo fue tu mes.</p></div><span class="tag">Valores 2026</span></div><div class="label">¿Qué querés calcular?</div><div class="cases"><button type="button" class="case active" data-mode="monthly"><i>▣</i>Sueldo mensual</button><button type="button" class="case" data-mode="extras"><i>◷</i>Con horas extra</button><button type="button" class="case" data-mode="compare"><i>↔</i>Comparar ofertas</button></div><div class="label">Tus números del mes</div><div class="fields"><div class="field wide"><label>Salario bruto mensual</label><div class="money"><b>RD$</b><input id="salary" value="50000" inputmode="decimal"></div></div><div class="field" id="f-hours"><label>Horas por semana</label><input id="weekly" value="44" inputmode="decimal"></div><div class="field" id="f-extra"><label>Horas extra del mes</label><input id="extra" value="0" inputmode="decimal"></div><div class="field" id="f-night"><label>Horas nocturnas del mes</label><input id="night" value="0" inputmode="decimal"></div><div class="field"><label>Otros descuentos autorizados</label><div class="money"><b>RD$</b><input id="other" value="0" inputmode="decimal"></div></div><div class="field wide" id="f-offer" style="display:none"><label>Segunda oferta bruta</label><div class="money"><b>RD$</b><input id="offer" value="65000" inputmode="decimal"></div></div></div><section class="result"><div class="result-top"><div><small id="result-label">LO QUE TE LLEGA ESTE MES</small><div class="value" id="net">RD$ 47.045</div></div><div class="ratio"><small>Te queda</small><b id="ratio">94,1% del bruto</b></div></div><div class="stats"><span>AFP + SFS<b id="stat-tss">RD$ 2.955</b></span><span>Retención ISR<b id="stat-isr">RD$ 0</b></span><span>Regalía estimada<b id="stat-regalia">RD$ 50.000</b></span></div><button class="go" id="update" type="button">Actualizar mi sueldo</button></section></form></div></section>
<section class="section"><div class="wrap"><div class="center"><div class="eyebrow">Tu sueldo, sin letra chica</div><h2>Cada peso tiene un destino</h2><p>El gráfico separa lo que cobrás de los aportes y la retención.</p></div><div class="salarybar"><div class="bar"><i class="net" id="bar-net"></i><i class="tss" id="bar-tss"></i><i class="isr" id="bar-isr"></i></div><div class="legend"><span>NETO EN MANO<b id="leg-net">RD$ 47.045</b></span><span>AFP + SFS<b id="leg-tss">RD$ 2.955</b></span><span>ISR<b id="leg-isr">RD$ 0</b></span></div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3>Tu nómina, línea por línea</h3><div class="line"><span>Salario ordinario devengado</span><b id="d-gross">RD$ 50.000</b></div><div class="line"><span>AFP · 2,87%</span><b id="d-afp">− RD$ 1.435</b></div><div class="line"><span>SFS · 3,04%</span><b id="d-sfs">− RD$ 1.520</b></div><div class="line"><span>ISR mensual estimado</span><b id="d-isr">− RD$ 0</b></div><div class="line"><span>Otros descuentos</span><b id="d-other">− RD$ 0</b></div><div class="line total"><strong>Salario neto</strong><b id="d-net">RD$ 47.045</b></div></article><article class="card"><h3>Cómo llegamos al resultado</h3><div class="step"><i>1</i><div><b>Calculamos el ingreso del mes</b><span>Jornada, extras y recargos nocturnos.</span></div></div><div class="step"><i>2</i><div><b>Restamos TSS</b><span>AFP 2,87% y SFS 3,04% sobre la base cotizable.</span></div></div><div class="step"><i>3</i><div><b>Aplicamos la escala del ISR</b><span>La base mensual se anualiza y se divide nuevamente por 12.</span></div></div><div class="warning" id="warning">⚠️ La regalía pascual va aparte: no paga ISR ni cotiza a la TSS.</div></article></div></section>
<section class="darksection"><div class="wrap darkgrid"><div><div class="eyebrow" style="color:#7bd0b4">Las tres claves</div><h2>No todo lo que descuenta la nómina es impuesto.</h2><p>AFP financia pensiones, SFS cubre salud e ISR aparece sólo cuando la base anual supera la exención.</p></div><div class="refs"><div class="ref"><small>AFP EMPLEADO</small><b>2,87%</b><span>Sobre salario cotizable</span></div><div class="ref"><small>SFS EMPLEADO</small><b>3,04%</b><span>Seguro de salud</span></div><div class="ref"><small>TSS TOTAL</small><b>5,91%</b><span>Antes del ISR</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sueldo-neto-dominicana')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sueldo-neto-dominicana');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value.replace(",","."))||0),money=x=>"RD$ "+Math.round(x).toLocaleString("es-DO");let mode="monthly";
function isrAnnual(base){if(base<=416220)return 0;if(base<=624329)return(base-416220)*.15;if(base<=867123)return 31216+(base-624329)*.2;return 79776+(base-867123)*.25}
function oneNet(base,includeExtras=true){let weekly=Math.min(44,Math.max(1,n("#weekly"))),ordinary=base*weekly/44,hour=ordinary/190.6,extra=includeExtras?n("#extra")*hour*1.35:0,night=includeExtras?n("#night")*hour*.15:0,gross=ordinary+extra+night,afp=gross*.0287,sfs=gross*.0304,isr=isrAnnual(Math.max(0,gross-afp-sfs)*12)/12,other=n("#other"),net=gross-afp-sfs-isr-other;return{gross,afp,sfs,isr,other,net,ordinary}}
function calc(){let a=oneNet(n("#salary"));if(mode==="compare"){let b=oneNet(n("#offer"),false),diff=Math.abs(a.net-b.net),winner=a.net>=b.net?"Oferta A":"Oferta B";$("#result-label").textContent="DIFERENCIA NETA ENTRE OFERTAS";$("#net").textContent=money(diff);$("#ratio").textContent=`Conviene ${winner}`;$("#warning").textContent=`✓ ${winner} deja ${money(diff)} más por mes, o ${money(diff*12)} al año.`}else{$("#result-label").textContent="LO QUE TE LLEGA ESTE MES";$("#net").textContent=money(a.net);$("#ratio").textContent=(a.gross?a.net/a.gross*100:0).toFixed(1).replace(".",",")+"% del bruto";$("#warning").textContent="⚠️ La regalía pascual va aparte: no paga ISR ni cotiza a la TSS."}$("#art-net").textContent=mode==="compare"?$("#net").textContent:money(a.net);$("#art-copy").textContent=mode==="compare"?"diferencia neta entre ofertas":"sobre "+money(a.gross)+" brutos";$("#stat-tss").textContent=money(a.afp+a.sfs);$("#stat-isr").textContent=money(a.isr);$("#stat-regalia").textContent=money(a.ordinary);$("#leg-net").textContent=money(a.net);$("#leg-tss").textContent=money(a.afp+a.sfs);$("#leg-isr").textContent=money(a.isr);$("#d-gross").textContent=money(a.gross);$("#d-afp").textContent="− "+money(a.afp);$("#d-sfs").textContent="− "+money(a.sfs);$("#d-isr").textContent="− "+money(a.isr);$("#d-other").textContent="− "+money(a.other);$("#d-net").textContent=money(a.net);let total=Math.max(1,a.gross),np=Math.max(0,a.net/total*100),tp=(a.afp+a.sfs)/total*100,ip=a.isr/total*100;$("#bar-net").style.width=np+"%";$("#bar-tss").style.width=tp+"%";$("#bar-isr").style.width=ip+"%"}
function setMode(m){mode=m;$$(".case").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));$("#f-offer").style.display=m==="compare"?"block":"none";$("#f-extra").style.opacity=m==="monthly"?.5:1;$("#f-night").style.opacity=m==="monthly"?.5:1;if(m==="monthly"){$("#extra").value=0;$("#night").value=0}calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Sueldo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar mi sueldo",1200)};setMode("monthly");

})();
</script>
