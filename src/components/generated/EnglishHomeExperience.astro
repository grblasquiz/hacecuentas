<div class="mockup-english-home" set:html={`<div class="hero"><div class="wrap"><div class="heroGrid"><div><span class="eyebrow">Free tools for real-life decisions</span><h1>Don't just calculate. Know what to do next.</h1><p class="lead">Accurate, private calculators for money, work, home, family, travel and business — organized around the decision you're actually trying to make.</p><div class="searchHero"><input id="heroSearch" placeholder="What do you need to figure out?"><button id="heroSearchBtn">Find a tool</button></div><div class="trust"><span>✓ 239 calculators</span><span>✓ Updated for 2026</span><span>✓ No signup</span><span>✓ Your data stays on your device</span></div></div>
<aside class="decisionMap"><h2>Start with your situation</h2><p>You don't need to know the calculator's name.</p><div class="mapGrid"><button class="mapBtn active" data-hub="money"><i>💵</i><b>My money</b><span>Budget, debt, saving</span></button><button class="mapBtn" data-hub="work"><i>⏱</i><b>My work</b><span>Pay, offers, freelance</span></button><button class="mapBtn" data-hub="home"><i>⌂</i><b>My home</b><span>Rent, buy, utilities</span></button><button class="mapBtn" data-hub="family"><i>♥</i><b>My family</b><span>Baby, care, planning</span></button><button class="mapBtn" data-hub="travel"><i>✈</i><b>My travel</b><span>Trip cost, miles, time</span></button><button class="mapBtn" data-hub="business"><i>↗</i><b>My business</b><span>Pricing, margin, hiring</span></button></div><div class="mapResult"><small>Your recommended starting point</small><strong id="mapTitle">Get a clear monthly money snapshot</strong><p id="mapCopy">See where your income goes before choosing a debt or savings strategy.</p><button id="mapOpen">Open My Money hub →</button></div></aside></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Six decision hubs</span><h2>One place for the whole decision.</h2><p>Each hub combines the calculators, comparisons and next steps that belong together.</p></div><div class="hubs" id="hubs"><button class="hub active" data-hub="money"><span class="hubIcon">💵</span><h3>My Money</h3><p>Move from monthly cash flow to debt freedom, emergency savings and long-term goals.</p><ul><li>Build a monthly plan</li><li>Choose a debt strategy</li><li>Set savings targets</li></ul><em>01</em></button><button class="hub" data-hub="work"><span class="hubIcon">⏱</span><h3>My Work</h3><p>Understand your real pay, compare job offers and price your time.</p><ul><li>Take-home pay</li><li>Employee vs freelance</li><li>Overtime and severance</li></ul><em>02</em></button><button class="hub" data-hub="home"><span class="hubIcon">⌂</span><h3>My Home</h3><p>Decide what you can afford and compare renting, buying and running costs.</p><ul><li>Home affordability</li><li>Rent vs buy</li><li>Utilities and projects</li></ul><em>03</em></button><button class="hub" data-hub="family"><span class="hubIcon">♥</span><h3>My Family</h3><p>Plan the costs and timing around children, care and major family events.</p><ul><li>Baby and childcare costs</li><li>Pregnancy planning</li><li>Events and support</li></ul><em>04</em></button><button class="hub" data-hub="travel"><span class="hubIcon">✈</span><h3>My Travel</h3><p>Turn routes, miles, baggage and local costs into one trip budget.</p><ul><li>True trip cost</li><li>Miles vs cash</li><li>Time zones and baggage</li></ul><em>05</em></button><button class="hub" data-hub="business"><span class="hubIcon">↗</span><h3>My Business</h3><p>Price profitably, understand platform fees and decide when to hire.</p><ul><li>Margins and markup</li><li>Break-even point</li><li>Marketing and hiring</li></ul><em>06</em></button></div></div></section>
<section class="tint" id="hubDetail"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Inside the hub</span><h2 id="hubHeading">My Money: from stress to a clear plan.</h2></div><div class="hubView"><article class="hubIntro"><small id="hubLabel">MY MONEY · DECISION HUB</small><h3 id="hubIntroTitle">See the full picture first.</h3><p id="hubIntroCopy">Start with income, fixed costs, debt payments and savings. Then choose the next move based on your real monthly margin.</p><button id="startHub">Start this decision →</button></article><div class="toolsGrid" id="hubTools"></div></div></div></section>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Popular calculators</span><h2>Fast answers when one number is enough.</h2></div><div class="popularControls"><div class="filters"><button class="filter active" data-cat="all">All</button><button class="filter" data-cat="finance">Finance</button><button class="filter" data-cat="health">Health</button><button class="filter" data-cat="daily">Daily life</button><button class="filter" data-cat="business">Business</button></div><input class="search" id="toolSearch" placeholder="Search calculators…"></div><div class="cards" id="cards"><article class="card" data-cat="finance" data-text="compound interest savings investment"><i>↗</i><h3>Compound Interest</h3><p>Project a balance with monthly contributions.</p><button>Calculate →</button></article><article class="card" data-cat="finance" data-text="credit card debt payoff"><i>↓</i><h3>Credit Card Payoff</h3><p>See your debt-free date and total interest.</p><button>Calculate →</button></article><article class="card" data-cat="health" data-text="bmi weight body mass"><i>♥</i><h3>BMI & Healthy Range</h3><p>Get your BMI and a weight range in seconds.</p><button>Calculate →</button></article><article class="card" data-cat="daily" data-text="days between dates business"><i>▦</i><h3>Days Between Dates</h3><p>Calendar days, weekdays and exact duration.</p><button>Calculate →</button></article><article class="card" data-cat="finance" data-text="mortgage monthly home payment"><i>⌂</i><h3>Mortgage Payment</h3><p>Principal, interest, tax and insurance.</p><button>Calculate →</button></article><article class="card" data-cat="business" data-text="profit margin markup price"><i>%</i><h3>Margin & Markup</h3><p>Price products without confusing both metrics.</p><button>Calculate →</button></article><article class="card" data-cat="health" data-text="tdee calorie daily energy"><i>●</i><h3>Daily Calories</h3><p>Maintenance, deficit and surplus targets.</p><button>Calculate →</button></article><article class="card" data-cat="daily" data-text="tip split bill restaurant"><i>$</i><h3>Tip & Bill Split</h3><p>Tip, total and amount per person.</p><button>Calculate →</button></article><div class="empty" id="empty">No calculator matches that search.</div></div></div></section>
<section class="tint"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Why trust the result</span><h2>Clear inputs. Open formulas. Honest limits.</h2></div><div class="proof"><div><strong>239</strong><span>free calculators in English</span></div><div><strong>100%</strong><span>browser-based private calculations</span></div><div><strong>2026</strong><span>current tax and reference data</span></div><div><strong>0</strong><span>accounts required to calculate</span></div><div class="method" style="grid-column:1/-1"><article class="panel"><h3>Every result explains itself</h3><p>We show the formula, assumptions, units, source date and the cases where a professional or an official source should take over.</p><div class="line"><span>Primary sources first</span><b>IRS · WHO · government data</b></div><div class="line"><span>Calculation method</span><b>Visible and reproducible</b></div></article><article class="panel dark"><h3>Made for decisions, not pageviews</h3><p>Decision hubs bring related tools together so you can compare scenarios and understand the next step without opening five disconnected tabs.</p><div class="line"><span>Hub structure</span><b>Problem → options → action</b></div><div class="line"><span>Your data</span><b>Stays in the browser</b></div></article></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-english-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-english-home');if(!root)return;

const hubData={money:{title:"Get a clear monthly money snapshot",copy:"See where your income goes before choosing a debt or savings strategy.",heading:"My Money: from stress to a clear plan.",intro:"See the full picture first.",desc:"Start with income, fixed costs, debt payments and savings. Then choose the next move based on your real monthly margin.",tools:[["Monthly Budget","Income, expenses and free cash flow."],["Debt Payoff Plan","Snowball vs avalanche, side by side."],["Emergency Fund","A target based on job and dependents."],["Savings Goal","Required monthly amount and target date."]]},work:{title:"Know what your time is really worth",copy:"Compare take-home pay, benefits, commute and freelance costs.",heading:"My Work: compare the whole offer.",intro:"Turn compensation into one honest number.",desc:"Salary alone hides taxes, benefits, travel time and unpaid costs. Put them on the same basis before deciding.",tools:[["Take-Home Pay","Taxes and deductions."],["Job Offer Comparison","Pay, benefits and commute."],["Employee vs Freelance","Annual net income comparison."],["Overtime Pay","Regular, 1.5× and double time."]]},home:{title:"Find the home cost you can safely carry",copy:"Combine payment, taxes, insurance, maintenance and utilities.",heading:"My Home: affordability before commitment.",intro:"Start with the monthly cost, not the listing price.",desc:"Compare renting, buying and running costs over the same time horizon.",tools:[["Home Affordability","Price range from income and debt."],["Rent vs Buy","Five-year net cost comparison."],["Mortgage Payment","P&I, taxes, insurance and PMI."],["Home Running Costs","Utilities and maintenance budget."]]},family:{title:"Plan the next family milestone",copy:"Bring timing, recurring costs and one-time expenses together.",heading:"My Family: plan care, time and cost.",intro:"Big life changes deserve one shared plan.",desc:"Use practical ranges and timing tools without pretending personal choices are just numbers.",tools:[["Baby Budget","One-time and monthly costs."],["Pregnancy Week","Dates and trimester timeline."],["Childcare Cost","Compare care options."],["Event Budget","Guests, food and contingency."]]},travel:{title:"Build the trip budget before booking",copy:"Compare airfare, miles, baggage, transfers and daily spend.",heading:"My Travel: the true door-to-door cost.",intro:"The cheapest fare is not always the cheapest trip.",desc:"Bring every cost and time tradeoff into the same comparison.",tools:[["Trip Cost","Transport, stay and daily spend."],["Miles vs Cash","Value per mile and fees."],["Baggage Cost","Airline and fare comparison."],["World Time","Overlap across time zones."]]},business:{title:"Find the number that drives the decision",copy:"Connect price, margin, platform fees, marketing and payroll.",heading:"My Business: price, grow and hire with context.",intro:"Revenue is not the same thing as profit.",desc:"Follow the money from sale to contribution margin, break-even and cash flow.",tools:[["Margin & Markup","Set a profitable price."],["Platform Fees","Net revenue by channel."],["Break-Even Point","Units and revenue required."],["Cost to Hire","Salary plus employer costs."]]}},$=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let activeHub="money";
function renderHub(h,scroll=false){activeHub=h;const d=hubData[h];$$("[data-hub]").forEach(x=>x.classList.toggle("active",x.dataset.hub===h));$("#mapTitle").textContent=d.title;$("#mapCopy").textContent=d.copy;$("#mapOpen").textContent="Open "+h[0].toUpperCase()+h.slice(1)+" hub →";$("#hubHeading").textContent=d.heading;$("#hubLabel").textContent="MY "+h.toUpperCase()+" · DECISION HUB";$("#hubIntroTitle").textContent=d.intro;$("#hubIntroCopy").textContent=d.desc;$("#hubTools").innerHTML=d.tools.map(x=>`<article class="tool"><small>RECOMMENDED TOOL</small><h4>${x[0]}</h4><p>${x[1]}</p><button data-tool="${x[0]}">Open calculator →</button></article>`).join("");$$("[data-tool]").forEach(b=>b.onclick=()=>toast("Opening: "+b.dataset.tool));if(scroll)$("#hubDetail").scrollIntoView({behavior:"smooth"})}
$$("[data-hub]").forEach(b=>b.onclick=()=>renderHub(b.dataset.hub,b.classList.contains("hub")));$("#mapOpen").onclick=()=>renderHub(activeHub,true);$("#startHub").onclick=()=>toast("Starting "+activeHub+" decision hub");
function filter(){const cat=$(".filter.active").dataset.cat,q=$("#toolSearch").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat===cat)&&(!q||c.dataset.text.includes(q)||c.textContent.toLowerCase().includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter()});$("#toolSearch").oninput=filter;$$(".card button").forEach(b=>b.onclick=()=>toast("Opening: "+b.closest(".card").querySelector("h3").textContent));
const searchItems=[...Object.values(hubData).flatMap(x=>x.tools.map(t=>t[0])),...$$(".card h3").map(x=>x.textContent)];function openSearch(q=""){$("#searchPanel").classList.add("show");$("#globalSearch").value=q;searchNow();$("#globalSearch").focus()}function searchNow(){const q=$("#globalSearch").value.toLowerCase();$("#searchResults").innerHTML=searchItems.filter(x=>!q||x.toLowerCase().includes(q)).slice(0,7).map(x=>`<button data-result="${x}">${x}<br><small>Open calculator →</small></button>`).join("")||"<p>No exact match. Try a broader term.</p>";$$("[data-result]").forEach(b=>b.onclick=()=>toast("Opening: "+b.dataset.result))}$("#heroSearchBtn").onclick=()=>openSearch($("#heroSearch").value);$("#heroSearch").onkeydown=e=>{if(e.key==="Enter")openSearch(e.currentTarget.value)};$("#headerSearch").onclick=()=>openSearch();$("#closeSearch").onclick=()=>$("#searchPanel").classList.remove("show");$("#globalSearch").oninput=searchNow;function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1600)}renderHub("money");

})();
</script>
