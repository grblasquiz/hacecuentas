55px;align-items:center}.mockup-presupuesto-hogar-colombia .eyebrow{text-transform:uppercase;letter-spacing:.15em;font-weight:900;font-size:10px;color:var(--blue)}.mockup-presupuesto-hogar-colombia h1{font-size:51px;line-height:1.03;letter-spacing:-.05em;margin:14px 0 18px;max-width:680px}.mockup-presupuesto-hogar-colombia .lead{font-size:17px;line-height:1.65;color:#5e6879;max-width:670px}.mockup-presupuesto-hogar-colombia .stamps{display:flex;gap:9px;flex-wrap:wrap;margin-top:25px}.mockup-presupuesto-hogar-colombia .stamp{border:1px solid var(--line);background:white;border-radius:99px;padding:9px 13px;font-size:11px;color:#596474}.mockup-presupuesto-hogar-colombia .hero-card{background:var(--navy);color:white;border-radius:26px;padding:31px;box-shadow:0 18px 45px #20365927;position:relative;overflow:hidden}.mockup-presupuesto-hogar-colombia .hero-card:before{content:"";width:190px;height:190px;border-radius:50%;background:#ffffff0a;position:absolute;right:-50px;top:-70px}.mockup-presupuesto-hogar-colombia .wallet{height:105px;display:grid;place-items:center}.mockup-presupuesto-hogar-colombia .wallet-shape{width:150px;height:83px;border-radius:18px;background:#3d5983;position:relative}.mockup-presupuesto-hogar-colombia .wallet-shape:before{content:"";position:absolute;left:15px;top:-18px;width:107px;height:37px;border-radius:10px;background:#5677a5}.mockup-presupuesto-hogar-colombia .wallet-shape:after{content:"";position:absolute;right:-4px;top:28px;width:51px;height:31px;border-radius:9px;background:#91baf3}.mockup-presupuesto-hogar-colombia .hero-card h2{text-align:center;font-size:24px;margin:10px 0 7px}.mockup-presupuesto-hogar-colombia .hero-card p{text-align:center;color:#c8d4e6;font-size:13px;line-height:1.5}.mockup-presupuesto-hogar-colombia .mini{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px}.mockup-presupuesto-hogar-colombia .mini div{background:#ffffff12;border-radius:13px;padding:14px}.mockup-presupuesto-hogar-colombia .mini span