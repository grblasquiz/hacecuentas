---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-gestacion-mascotas" set:html={`
<section class="hero"><div class="wrap"><div class="crumb">Mascotas / Gestación</div><div class="hero-grid"><div><div class="eyebrow">Una fecha orientativa. Un seguimiento útil.</div><h1>Prepará la llegada, semana por semana.</h1><p class="lead">Ingresá la primera monta para estimar el parto, ubicar la etapa actual y saber qué controles y preparativos vienen después.</p><div class="chips"><span class="chip">✓ Perra, gata, coneja y hámster</span><span class="chip">✓ Rango normal</span><span class="chip">✓ Señales de alarma</span></div></div><div class="visual"><div class="pet"><span class="head"><span class="ear"></span><span class="snout"></span><span class="eye"></span></span><span class="leg one"></span><span class="leg two"></span><span class="belly"><span class="paws"></span></span></div><div class="calendar"><small>GESTACIÓN CANINA</small><strong>63 días ± 5</strong></div></div></div></div></section>
<section class="wrap"><div class="tool"><div class="species" id="species"></div><div class="calc"><div class="form"><h2 id="formTitle"></h2><p class="hint" id="formHint"></p><div class="fields" id="fields"></div><button class="primary" id="calculate">Actualizar seguimiento</button></div><div class="result"><div class="caps">FECHA PROBABLE DE PARTO</div><div class="date" id="mainResult"></div><div class="sub" id="resultText"></div><span class="status" id="status"></span><div class="timeline-labels"><span>Implantación</span><span>Embrionaria</span><span>Fetal</span><span>Recta final</span></div><div class="timeline"><span class="marker" id="marker"></span></div><div class="rows" id="rows"></div></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">Hitos de la gestación canina</div><h2>Qué pasa y cuándo controlarlo.</h2><p>La fecha de monta ubica el calendario; los estudios veterinarios confirman la preñez y el número de crías.</p></div><div class="milestones"><article class="mile"><span class="day">DÍAS 21–28</span><b>Ecografía</b><p>Confirma la preñez y evalúa viabilidad; no cuenta con precisión.</p></article><article class="mile"><span class="day">SEMANA 5</span><b>Cambio visible</b><p>Empieza a crecer el abdomen y aumenta gradualmente la demanda.</p></article><article class="mile"><span class="day">DESDE DÍA 45</span><b>Radiografía</b><p>Los esqueletos permiten contar mejor la camada.</p></article><article class="mile"><span class="day">ÚLTIMA SEMANA</span><b>Nido listo</b><p>Lugar tranquilo, limpio y teléfono veterinario a mano.</p></article></div></div></section>
<section class="urgent"><div class="wrap urgent-grid"><div><div class="eyebrow">No esperes a que se pase</div><h2>Estas señales son consulta inmediata.</h2><p>La calculadora organiza fechas; no diagnostica ni reemplaza el seguimiento veterinario.</p></div><div class="alerts"><article class="alert"><span class="mark">!</span><b>Fuera del rango</b><span>En perras, más de 68 días desde la monta sin parto.</span></article><article class="alert"><span class="mark">!</span><b>Contracciones sin nacimiento</b><span>Más de dos horas de contracciones fuertes.</span></article><article class="alert"><span class="mark">!</span><b>Demora entre crías</b><span>Más de cuatro horas entre un nacimiento y el siguiente.</span></article><article class="alert"><span class="mark">!</span><b>Secreción o decaimiento</b><span>Color oscuro, olor fuerte, temblores o debilidad marcada.</span></article></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-gestacion-mascotas')?document.currentScript.previousElementSibling:document.querySelector('.mockup-gestacion-mascotas');

const animals={dog:{name:"Perra",days:63,margin:5,icon:"◖"},cat:{name:"Gata",days:65,margin:2,icon:"◒"},rabbit:{name:"Coneja",days:31,margin:2,icon:"♢"},hamster:{name:"Hámster",days:16,margin:1,icon:"●"}};let active="dog";const TODAY=new Date(2026,6,28),$=id=>root.querySelector("#"+id),months=["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];function add(d,n){let x=new Date(d);x.setDate(x.getDate()+n);return x}function fmt(d,year=true){return `${d.getDate()} de ${months[d.getMonth()]}${year?" de "+d.getFullYear():""}`}function parseDate(s){let p=s.split("-").map(Number);return new Date(p[0],p[1]-1,p[2])}
const breeds={"Labrador retriever":[6,8],"Golden retriever":[6,10],"Bulldog francés":[3,5],"Pastor alemán":[6,9],"Beagle":[4,7],"Caniche / poodle":[3,6],"Chihuahua":[2,4],"Rottweiler":[8,12],"Bóxer":[5,8]};
function drawSpecies(){$("species").innerHTML=Object.entries(animals).map(([id,a])=>`<button class="animal ${id===active?"active":""}" data-id="${id}"><div class="ico">${a.icon}</div><b>${a.name}</b><span>${a.days} días ± ${a.margin}</span></button>`).join("");root.querySelectorAll(".animal").forEach(b=>b.onclick=()=>{active=b.dataset.id;render()})}
function getConfig(){let a=animals[active],fields=[["mating","Fecha de la primera monta","date","2026-06-01"]];if(active==="dog")fields.push(["breed","Raza","select","Labrador retriever",Object.keys(breeds)],["first","¿Es la primera camada?","select","No",["No","Sí"]],["age","Edad reproductiva","select","Joven / adulta",["Joven / adulta","Mayor"]]);return{title:`Seguimiento de la ${a.name.toLowerCase()}`,hint:`Duración de referencia: ${a.days} días, con margen normal de ±${a.margin}.`,fields}}
function drawFields(c){$("fields").innerHTML=c.fields.map(f=>{let[id,label,type,val,opts]=f;return type==="select"?`<div class="field"><label for="${id}">${label}</label><select id="${id}">${opts.map(o=>`<option ${o===val?"selected":""}>${o}</option>`).join("")}</select></div>`:`<div class="field full"><label for="${id}">${label}</label><input id="${id}" type="${type}" value="${val}"></div>`}).join("");$("fields").querySelectorAll("input,select").forEach(x=>x.addEventListener("input",compute))}
function compute(){let a=animals[active],mating=parseDate($("mating").value),due=add(mating,a.days),lo=add(mating,a.days-a.margin),hi=add(mating,a.days+a.margin),elapsed=Math.round((TODAY-mating)/86400000),remaining=a.days-elapsed,week=Math.max(1,Math.min(Math.ceil(a.days/7),Math.floor(Math.max(0,elapsed)/7)+1)),pos=Math.max(0,Math.min(100,elapsed/a.days*100)),stage=pos<33?"Implantación":pos<56?"Desarrollo embrionario":pos<75?"Crecimiento fetal":"Recta final";let litter="";if(active==="dog"){let [min,max]=breeds[$("breed").value],factor=$("first").value==="Sí"?.75:1,age=$("age").value==="Mayor"?.75:1;min=Math.round(min*factor*age);max=Math.round(max*factor*age);litter=`${min}–${max} cachorros`}else litter=active==="cat"?"3–5 gatitos":active==="rabbit"?"4–12 gazapos":"4–12 crías";$("mainResult").textContent=fmt(due);$("resultText").textContent=elapsed<0?`Si la monta ocurre ese día, el rango será del ${fmt(lo,false)} al ${fmt(hi,false)}.`:remaining>=0?`Día ${elapsed} de ${a.days} · faltan unos ${remaining} días · rango normal del ${fmt(lo,false)} al ${fmt(hi,false)}.`:`La fecha estimada ya pasó por ${Math.abs(remaining)} días.`;$("status").textContent=elapsed>a.days+a.margin?"Fuera del rango: llamá al veterinario":`${stage} · semana ${week}`;$("marker").style.left=`calc(${pos}% - 2px)`;$("rows").innerHTML=`<div class="row"><span>Duración de referencia</span><strong>${a.days} días</strong></div><div class="row"><span>Días transcurridos</span><strong>${Math.max(0,elapsed)}</strong></div><div class="row"><span>Días restantes</span><strong>${Math.max(0,remaining)}</strong></div><div class="row"><span>Rango de parto</span><strong>${fmt(lo,false)} – ${fmt(hi,false)}</strong></div><div class="row"><span>Camada orientativa</span><strong>${litter}</strong></div>`}
function render(){drawSpecies();let c=getConfig();$("formTitle").textContent=c.title;$("formHint").textContent=c.hint;drawFields(c);compute()}$("calculate").onclick=()=>{compute();let b=$("calculate"),old=b.textContent;b.textContent="✓ Seguimiento actualizado";setTimeout(()=>b.textContent=old,1300)};render();

})();
</script>
<style is:global>

.mockup-gestacion-mascotas{--ink:#172036;--muted:#6e7382;--paper:#f8f5f2;--card:#fff;--rose:#c65f72;--rose2:#f9e7ea;--plum:#613b6d;--green:#3b8b72;--amber:#df9c42;--navy:#1a304e;--line:#e5dfdc}
.mockup-gestacion-mascotas *{box-sizing:border-box}.mockup-gestacion-mascotas [hidden]{display:none!important}.mockup-gestacion-mascotas{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-gestacion-mascotas button,.mockup-gestacion-mascotas input,.mockup-gestacion-mascotas select{font:inherit}.mockup-gestacion-mascotas .wrap{max-width:1180px;margin:auto;padding:0 28px}
.mockup-gestacion-mascotas header{height:84px;background:#fff;border-bottom:1px solid var(--line)}.mockup-gestacion-mascotas header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-gestacion-mascotas .brand{display:flex;align-items:center;gap:12px;font-weight:850;font-size:20px}.mockup-gestacion-mascotas .logo{width:35px;height:35px;border-radius:8px;background:var(--navy);display:grid;place-items:center;color:#fff;font-size:14px}.mockup-gestacion-mascotas .nav{display:flex;gap:26px;color:#505867;font-weight:700;font-size:14px}.mockup-gestacion-mascotas .actions{margin-left:auto;display:flex;gap:10px}.mockup-gestacion-mascotas .ghost{border:1px solid var(--line);background:#fff;padding:11px 15px;border-radius:12px;font-weight:750;color:var(--ink)}
.mockup-gestacion-mascotas .hero{padding:57px 0 50px;background:linear-gradient(135deg,#fffaf7,#f7edf2)}.mockup-gestacion-mascotas .crumb{font-size:14px;color:#4b76c5;margin-bottom:19px}.mockup-gestacion-mascotas .hero-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:65px;align-items:center}.mockup-gestacion-mascotas .eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:900;color:var(--rose)}.mockup-gestacion-mascotas h1{font-size:56px;line-height:1.02;letter-spacing:-.05em;margin:14px 0 19px}.mockup-gestacion-mascotas .lead{font-size:19px;color:var(--muted);max-width:680px}.mockup-gestacion-mascotas .chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.mockup-gestacion-mascotas .chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 13px;font-size:13px;font-weight:780}
.mockup-gestacion-mascotas .visual{height:345px;position:relative}.mockup-gestacion-mascotas .pet{position:absolute;width:222px;height:145px;border-radius:52% 48% 42% 48%;background:linear-gradient(145deg,#b86b70,#d98b89);left:75px;top:105px}.mockup-gestacion-mascotas .head{position:absolute;width:108px;height:105px;border-radius:52% 48% 50% 50%;background:#bd7275;right:-47px;top:-42px}.mockup-gestacion-mascotas .ear{position:absolute;width:43px;height:65px;border-radius:60% 10% 50% 50%;background:#89505a;top:-35px;left:14px;transform:rotate(-23deg)}.mockup-gestacion-mascotas .snout{position:absolute;width:54px;height:37px;border-radius:50%;background:#dda09a;right:-23px;top:48px}.mockup-gestacion-mascotas .snout:after{content:"";position:absolute;width:10px;height:8px;border-radius:50%;background:#563a44;right:7px;top:8px}.mockup-gestacion-mascotas .eye{position:absolute;width:8px;height:8px;background:#33263a;border-radius:50%;right:20px;top:32px}.mockup-gestacion-mascotas .leg{position:absolute;width:32px;height:85px;background:#b96b71;border-radius:0 0 16px 16px;bottom:-56px}.mockup-gestacion-mascotas .leg.one{left:38px}.mockup-gestacion-mascotas .leg.two{right:27px}.mockup-gestacion-mascotas .belly{position:absolute;width:112px;height:79px;border-radius:50%;background:#e8a39a;left:51px;bottom:-3px}.mockup-gestacion-mascotas .paws{position:absolute;width:7px;height:7px;border-radius:50%;background:#f5c2b5;box-shadow:23px 4px 0 #f5c2b5,46px -2px 0 #f5c2b5;left:25px;top:36px}.mockup-gestacion-mascotas .calendar{position:absolute;right:0;bottom:12px;background:#fff;border-radius:16px;padding:15px 18px;box-shadow:0 15px 35px #4733451c}.mockup-gestacion-mascotas .calendar small{display:block;color:var(--muted);font-size:10px;font-weight:900;letter-spacing:.1em}.mockup-gestacion-mascotas .calendar strong{font-size:26px;color:var(--rose)}
.mockup-gestacion-mascotas .tool{background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden;box-shadow:0 20px 55px #3c273410;margin-bottom:70px}.mockup-gestacion-mascotas .species{padding:22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.mockup-gestacion-mascotas .animal{min-height:82px;text-align:left;border:1px solid var(--line);background:#fcfbfb;border-radius:14px;padding:14px;cursor:pointer;color:var(--ink)}.mockup-gestacion-mascotas .animal b{display:block;margin:3px 0}.mockup-gestacion-mascotas .animal span{font-size:11px;color:var(--muted)}.mockup-gestacion-mascotas .animal.active{border:2px solid var(--rose);background:#fdf0f2;padding:13px}.mockup-gestacion-mascotas .ico{font-size:19px}
.mockup-gestacion-mascotas .calc{display:grid;grid-template-columns:.94fr 1.06fr}.mockup-gestacion-mascotas .form{padding:31px}.mockup-gestacion-mascotas .form h2{font-size:26px;letter-spacing:-.03em;margin:0 0 7px}.mockup-gestacion-mascotas .hint{color:var(--muted);margin:0 0 23px}.mockup-gestacion-mascotas .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-gestacion-mascotas .field{display:flex;flex-direction:column;gap:7px}.mockup-gestacion-mascotas .field.full{grid-column:1/-1}.mockup-gestacion-mascotas .field label{font-size:13px;font-weight:800}.mockup-gestacion-mascotas .field input,.mockup-gestacion-mascotas .field select{width:100%;border:1px solid #d3ccd1;background:#fff;border-radius:12px;padding:14px;outline:none;color:var(--ink)}.mockup-gestacion-mascotas .field input:focus,.mockup-gestacion-mascotas .field select:focus{border-color:var(--rose);box-shadow:0 0 0 3px #c65f721a}.mockup-gestacion-mascotas .primary{width:100%;border:0;background:var(--rose);color:#fff;border-radius:13px;padding:15px;font-weight:850;margin-top:20px;cursor:pointer}
.mockup-gestacion-mascotas .result{background:var(--navy);color:#fff;padding:31px;position:relative;overflow:hidden}.mockup-gestacion-mascotas .result:after{content:"";position:absolute;width:270px;height:270px;border-radius:50%;border:48px solid #ffffff08;right:-155px;bottom:-150px}.mockup-gestacion-mascotas .caps{color:#e5b7c5;font-size:10px;font-weight:900;letter-spacing:.13em}.mockup-gestacion-mascotas .date{font-size:43px;line-height:1.06;letter-spacing:-.045em;font-weight:920;margin:15px 0 7px}.mockup-gestacion-mascotas .sub{color:#d6dfeb;min-height:51px}.mockup-gestacion-mascotas .status{display:inline-block;background:#fff0cf;color:#77500e;padding:8px 12px;border-radius:99px;font-size:13px;font-weight:850;margin:12px 0 22px}.mockup-gestacion-mascotas .timeline-labels{display:flex;justify-content:space-between;color:#bbc5d2;font-size:10px;font-weight:800}.mockup-gestacion-mascotas .timeline{height:12px;border-radius:99px;background:linear-gradient(90deg,#59b789 0 33%,#59a5bb 33% 56%,#9e80c3 56% 75%,#e2a247 75%);position:relative;margin:8px 0 22px}.mockup-gestacion-mascotas .marker{position:absolute;width:5px;height:27px;background:#fff;border-radius:5px;top:-7px;left:90%;box-shadow:0 0 0 3px var(--navy)}.mockup-gestacion-mascotas .rows{border-top:1px solid #ffffff24}.mockup-gestacion-mascotas .row{display:flex;justify-content:space-between;gap:18px;padding:12px 0;border-bottom:1px solid #ffffff1b;color:#d5deea}.mockup-gestacion-mascotas .row strong{color:#fff;text-align:right}
.mockup-gestacion-mascotas .section{padding:10px 0 70px}.mockup-gestacion-mascotas .section-head{text-align:center;max-width:720px;margin:0 auto 30px}.mockup-gestacion-mascotas .section-head h2{font-size:39px;letter-spacing:-.04em;margin:8px 0}.mockup-gestacion-mascotas .section-head p{color:var(--muted)}.mockup-gestacion-mascotas .milestones{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.mockup-gestacion-mascotas .mile{background:#fff;border:1px solid var(--line);border-radius:18px;padding:21px}.mockup-gestacion-mascotas .day{display:inline-block;background:var(--rose2);color:var(--rose);border-radius:99px;padding:6px 9px;font-size:11px;font-weight:900;margin-bottom:14px}.mockup-gestacion-mascotas .mile b{display:block;margin-bottom:6px}.mockup-gestacion-mascotas .mile p{font-size:13px;color:var(--muted);margin:0}
.mockup-gestacion-mascotas .urgent{background:#efe9ed;padding:66px 0}.mockup-gestacion-mascotas .urgent-grid{display:grid;grid-template-columns:.76fr 1.24fr;gap:65px}.mockup-gestacion-mascotas .urgent h2{font-size:40px;line-height:1.08;margin:10px 0}.mockup-gestacion-mascotas .urgent p{color:var(--muted)}.mockup-gestacion-mascotas .alerts{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-gestacion-mascotas .alert{background:#fff;border:1px solid #ead5d9;border-radius:16px;padding:19px}.mockup-gestacion-mascotas .mark{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;background:#fde5e5;color:#b94b4b;font-weight:900;margin-bottom:12px}.mockup-gestacion-mascotas .alert b{display:block;margin-bottom:5px}.mockup-gestacion-mascotas .alert span{font-size:13px;color:var(--muted)}
.mockup-gestacion-mascotas footer{background:#fff;border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:13px}
@media(max-width:850px){.mockup-gestacion-mascotas .nav{display:none}.mockup-gestacion-mascotas .hero-grid,.mockup-gestacion-mascotas .calc,.mockup-gestacion-mascotas .urgent-grid{grid-template-columns:1fr}.mockup-gestacion-mascotas .visual{height:290px}.mockup-gestacion-mascotas .milestones{grid-template-columns:1fr 1fr}.mockup-gestacion-mascotas h1{font-size:45px}}@media(max-width:540px){.mockup-gestacion-mascotas .wrap{padding:0 18px}.mockup-gestacion-mascotas .hero{padding-top:35px}.mockup-gestacion-mascotas .visual{display:none}.mockup-gestacion-mascotas h1{font-size:39px}.mockup-gestacion-mascotas .species{display:flex;overflow:auto}.mockup-gestacion-mascotas .animal{min-width:170px}.mockup-gestacion-mascotas .fields,.mockup-gestacion-mascotas .milestones,.mockup-gestacion-mascotas .alerts{grid-template-columns:1fr}.mockup-gestacion-mascotas .field.full{grid-column:auto}.mockup-gestacion-mascotas .tool{border-radius:18px}.mockup-gestacion-mascotas .form,.mockup-gestacion-mascotas .result{padding:25px 20px}}

.mockup-gestacion-mascotas { width:100%; overflow:hidden; }
.mockup-gestacion-mascotas .top, .mockup-gestacion-mascotas header.top { display:none !important; }
.mockup-gestacion-mascotas .foot { display:none !important; }
.mockup-gestacion-mascotas .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-gestacion-mascotas .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-gestacion-mascotas .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-gestacion-mascotas .support-real summary { cursor:pointer; font-weight:750; }
.mockup-gestacion-mascotas .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-gestacion-mascotas :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-gestacion-mascotas input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-gestacion-mascotas input[type="number"]::-webkit-inner-spin-button, .mockup-gestacion-mascotas input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-gestacion-mascotas .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-gestacion-mascotas support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
