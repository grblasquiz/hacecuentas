---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-cuanto-vale-negocio" set:html={`<div class="crumb">Negocios / Valuación</div><h1>Un negocio no vale sólo por lo que factura.</h1><p class="lead">Compará múltiplos sobre ganancia y ajustá el rango por recurrencia, dependencia y concentración.</p><section class="valuation"><aside class="ledger"><h2>Números normalizados</h2><label>Facturación anual<input id="revenue" type="number" value="48000000"></label><label>Ganancia operativa anual<input id="profit" type="number" value="9600000"></label><label>Deuda neta<input id="debt" type="number" value="1500000"></label><div class="quality"><button class="on" data-score="1.2">Ingresos recurrentes</button><button data-score=".8">Depende del dueño</button><button data-score=".85">Cliente concentrado</button><button data-score="1.1">Marca fuerte</button></div></aside><section class="range"><h2>Rango de conversación</h2><div class="scale"><i id="marker"></i></div><div class="figures"><span>Piso<br><b id="low"></b></span><span>Centro<br><b id="mid"></b></span><span>Techo<br><b id="high"></b></span></div><div class="methods"><div class="method"><b>2× ganancia</b><span>Escenario conservador</span></div><div class="method"><b>3× ganancia</b><span>Empresa estable</span></div><div class="method"><b>4× ganancia</b><span>Calidad y crecimiento</span></div></div><div class="note">Es una referencia para negociar, no una tasación. Contratos, activos, impuestos y contingencias requieren revisión profesional.</div></section></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-cuanto-vale-negocio')?document.currentScript.previousElementSibling:document.querySelector('.mockup-cuanto-vale-negocio');

let factor=1.2;const $=x=>root.querySelector("#"+x),money=n=>'$ '+Math.round(n).toLocaleString('es-AR');function render(){let p=+$('profit').value,d=+$('debt').value,mid=Math.max(0,p*3*factor-d),low=Math.max(0,p*2*factor-d),high=Math.max(0,p*4*factor-d);$('low').textContent=money(low);$('mid').textContent=money(mid);$('high').textContent=money(high);$('marker').style.left='50%'}
root.querySelectorAll('[data-score]').forEach(b=>b.onclick=()=>{b.classList.toggle('on');factor=[...root.querySelectorAll('[data-score].on')].reduce((p,x)=>p*+x.dataset.score,1);render()});root.querySelectorAll('input').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-cuanto-vale-negocio{--blue:#174b7a;--ink:#182932;--muted:#65747c;--line:#d6e0de;--gold:#d69a3d;--green:#3b9b76;--paper:#f4f7f5}.mockup-cuanto-vale-negocio *{box-sizing:border-box}.mockup-cuanto-vale-negocio{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-cuanto-vale-negocio input,.mockup-cuanto-vale-negocio button{font:inherit}.mockup-cuanto-vale-negocio .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-cuanto-vale-negocio .crumb{color:var(--blue);font-weight:850}.mockup-cuanto-vale-negocio h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-cuanto-vale-negocio .lead{font-size:18px;color:var(--muted)}.mockup-cuanto-vale-negocio .valuation{display:grid;grid-template-columns:.8fr 1.2fr;gap:20px;margin-top:28px}.mockup-cuanto-vale-negocio .ledger,.mockup-cuanto-vale-negocio .range{background:#fff;border:1px solid var(--line);border-radius:24px;padding:23px}.mockup-cuanto-vale-negocio .ledger label{display:block;font-size:12px;font-weight:850;margin:14px 0}.mockup-cuanto-vale-negocio .ledger input{display:block;width:100%;border:0;border-bottom:2px solid var(--line);padding:8px 0;font-weight:900;color:var(--ink)}.mockup-cuanto-vale-negocio .quality{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:18px}.mockup-cuanto-vale-negocio .quality button{border:1px solid var(--line);border-radius:11px;background:#fff;padding:10px;color:var(--ink)}.mockup-cuanto-vale-negocio .quality button.on{background:var(--blue);color:#fff}.mockup-cuanto-vale-negocio .range h2{margin:0}.mockup-cuanto-vale-negocio .scale{height:70px;margin:35px 0;position:relative;background:linear-gradient(90deg,#dce8e3,var(--gold));border-radius:16px}.mockup-cuanto-vale-negocio .scale i{position:absolute;top:-12px;width:5px;height:94px;background:var(--blue)}.mockup-cuanto-vale-negocio .figures{display:flex;justify-content:space-between}.mockup-cuanto-vale-negocio .figures b{font-size:25px;color:var(--blue)}.mockup-cuanto-vale-negocio .methods{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mockup-cuanto-vale-negocio .method{padding:15px;border:1px solid var(--line);border-radius:14px}.mockup-cuanto-vale-negocio .method b{display:block}.mockup-cuanto-vale-negocio .method span{color:var(--muted);font-size:12px}.mockup-cuanto-vale-negocio .note{margin-top:16px;background:#e2f1ea;padding:14px;border-radius:13px}@media(max-width:760px){.mockup-cuanto-vale-negocio .valuation{grid-template-columns:1fr}.mockup-cuanto-vale-negocio .methods{grid-template-columns:1fr}}
.mockup-cuanto-vale-negocio { width:100%; overflow:hidden; }
.mockup-cuanto-vale-negocio .top, .mockup-cuanto-vale-negocio header.top { display:none !important; }
.mockup-cuanto-vale-negocio .foot { display:none !important; }
.mockup-cuanto-vale-negocio .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-cuanto-vale-negocio .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-cuanto-vale-negocio .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-cuanto-vale-negocio .support-real summary { cursor:pointer; font-weight:750; }
.mockup-cuanto-vale-negocio .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-cuanto-vale-negocio :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-cuanto-vale-negocio input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-cuanto-vale-negocio input[type="number"]::-webkit-inner-spin-button, .mockup-cuanto-vale-negocio input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-cuanto-vale-negocio .support-real-grid{grid-template-columns:1fr}}
</style>
<style is:global>
  .mockup-cuanto-vale-negocio .valuation > * { min-width: 0; }
  .mockup-cuanto-vale-negocio .ledger input { min-width: 0; }
  .mockup-cuanto-vale-negocio .quality { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mockup-cuanto-vale-negocio .quality button {
    min-width: 0; overflow-wrap: anywhere; line-height: 1.25;
  }
  .mockup-cuanto-vale-negocio .figures { gap: 10px; }
  .mockup-cuanto-vale-negocio .figures span { min-width: 0; flex: 1; }
  .mockup-cuanto-vale-negocio .figures b {
    display: inline-block; max-width: 100%; font-size: clamp(17px, 6vw, 25px);
    overflow-wrap: anywhere;
  }
  .mockup-cuanto-vale-negocio .methods { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .mockup-cuanto-vale-negocio .method { min-width: 0; }
  .mockup-cuanto-vale-negocio .method b,
  .mockup-cuanto-vale-negocio .method span { overflow-wrap: anywhere; }
</style>
{data && <section class="mockup-cuanto-vale-negocio support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
