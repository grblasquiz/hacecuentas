---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-comisiones-plataforma" set:html={`
<section class="hero"><div class="wrap"><div class="crumb">Negocios / Comisiones de plataforma</div><div class="hero-grid"><div><div class="eyebrow">Facturar no es cobrar</div><h1>De cada venta, ¿cuánto te queda de verdad?</h1><p class="lead">Separá comisión, retenciones y costos operativos. Compará plataformas o calculá cuánto cobrar para llegar al neto que necesitás.</p><div class="chips"><span class="chip">✓ 10 modelos de plataforma</span><span class="chip">✓ Varias monedas</span><span class="chip">✓ Bruto ↔ neto</span></div></div><div class="visual"><div class="receipt"><h3>Liquidación</h3><div class="rline"><span>Venta bruta</span><strong>$100</strong></div><div class="rline"><span>Plataforma</span><strong>− $25</strong></div><div class="rline"><span>Costos</span><strong>− $20</strong></div><div class="rline total"><span>Te queda</span><strong>$55</strong></div><span class="stamp">COMISIÓN<br>DESCONTADA</span></div><div class="net-card"><small>EL NÚMERO QUE IMPORTA</small><strong>Neto real</strong></div></div></div></div></section>
<section class="wrap"><div class="tool"><div class="platform-head"><b>¿Con qué plataforma trabajás?</b><span class="eyebrow">Todas las opciones</span></div><div class="platforms" id="platforms"></div><div class="calc"><div class="form"><div class="form-top"><h2 id="formTitle">Tu venta, de bruto a neto</h2><div class="toggle"><button class="active" id="grossMode">Sé cuánto facturo</button><button id="targetMode">Quiero un neto</button></div></div><p class="hint" id="formHint">Usamos la tarifa de la plataforma; podés reemplazarla.</p><div class="fields" id="fields"></div><button class="primary" id="calculate">Actualizar cuenta</button></div><div class="result"><div class="caps" id="resultLabel">TE QUEDA EN EL BOLSILLO</div><div class="big" id="mainResult"></div><div class="sub" id="resultText"></div><span class="status" id="status"></span><div class="distribution" id="distribution"></div><div class="rows" id="rows"></div></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">El mismo millón, cuatro negocios</div><h2>La comisión sola nunca cuenta toda la historia.</h2><p>Ejemplo sobre $1.000.000 brutos y $200.000 de costos operativos, sin agregar impuestos particulares.</p></div><div class="compare"><article class="compare-card best"><span class="badge">MAYOR NETO</span><small>AIRBNB · 3%</small><strong>$770.000</strong><p>La limpieza y los gastos fijos suelen pesar más que la plataforma.</p></article><article class="compare-card"><span class="badge">TIENDA PROPIA</span><small>ECOMMERCE · 7,04%</small><strong>$729.600</strong><p>Plataforma más procesamiento de pago.</p></article><article class="compare-card"><span class="badge">MARKETPLACE</span><small>AMAZON · 15%</small><strong>$650.000</strong><p>Antes de fulfillment y almacenamiento.</p></article><article class="compare-card"><span class="badge">DELIVERY</span><small>APP · 25%</small><strong>$550.000</strong><p>El menú tiene que absorber la comisión.</p></article></div></div></section>
<section class="formula"><div class="wrap formula-grid"><div><div class="eyebrow">La cuenta completa</div><h2>No confundas venta con margen.</h2><p>La plataforma retiene antes de que tus costos entren en escena. El precio debe cubrir las dos capas y todavía dejar utilidad.</p></div><div class="steps"><article class="step"><span class="num">1</span><b>Partí del bruto</b><span>Todo lo que paga el cliente en el período.</span></article><article class="step"><span class="num">2</span><b>Restá plataforma</b><span>Porcentaje y cargos fijos por operación.</span></article><article class="step"><span class="num">3</span><b>Separá impuestos</b><span>Retenciones no son siempre impuesto definitivo.</span></article><article class="step"><span class="num">4</span><b>Restá operar</b><span>Insumos, combustible, envío, limpieza y abonos.</span></article></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-comisiones-plataforma')?document.currentScript.previousElementSibling:document.querySelector('.mockup-comisiones-plataforma');

const platforms=[
{id:"delivery",name:"Restaurante delivery",sub:"Rappi · PedidosYa · Eats",fee:25,tax:0,currency:"AR$"},
{id:"ecommerce",name:"Tienda propia",sub:"Tienda Nube + Mercado Pago",fee:7.04,tax:0,currency:"AR$"},
{id:"etsy",name:"Etsy",sub:"Handmade · dólares",fee:9.5,tax:0,currency:"US$"},
{id:"amazon",name:"Amazon FBA",sub:"Referral + logística",fee:15,tax:0,currency:"US$"},
{id:"airbnb",name:"Airbnb host",sub:"Tarifa dividida",fee:3,tax:0,currency:"AR$"},
{id:"uber-ar",name:"Uber Argentina",sub:"Comisión + aportes",fee:25,tax:21,currency:"AR$"},
{id:"uber-cl",name:"Uber Chile",sub:"Comisión + boleta",fee:25,tax:14.5,netTax:true,currency:"CLP $"},
{id:"uber-mx",name:"Uber México",sub:"Comisión + SAT",fee:25,tax:10.1,currency:"MXN "},
{id:"rider",name:"Repartidor",sub:"Pago por pedido",fee:0,tax:0,currency:"AR$"},
{id:"seller",name:"Cobro comisión",sub:"Agente · freelance",fee:5,tax:21,side:true,currency:"AR$"}
];let active="delivery",calcMode="gross";const $=id=>root.querySelector("#"+id),current=()=>platforms.find(x=>x.id===active),money=(c,n)=>c+Math.round(n).toLocaleString("es-AR");
function drawPlatforms(){$("platforms").innerHTML=platforms.map(x=>`<button class="platform ${x.id===active?"active":""}" data-id="${x.id}"><b>${x.name}</b><span>${x.sub}</span></button>`).join("");root.querySelectorAll(".platform").forEach(b=>b.onclick=()=>{active=b.dataset.id;render()})}
function fields(){let p=current(),first=calcMode==="gross"?["amount","Facturación bruta",1500000]:["amount","Neto que querés recibir",1000000];return[first,["fee","Comisión de plataforma (%)",p.fee],["tax","Retenciones / impuestos (%)",p.tax],["fixed","Costos fijos del período",0],["variable","Costos variables del período",300000],["hours","Horas trabajadas (opcional)",0]]}
function drawFields(){let list=fields();$("fields").innerHTML=list.map((f,i)=>`<div class="field"><label for="${f[0]}">${f[1]}</label><div class="${i===0||i>2&&i<5?"prefix":""}"><input id="${f[0]}" type="number" min="0" step="any" value="${f[2]}"></div></div>`).join("");$("fields").querySelectorAll("input").forEach(x=>x.addEventListener("input",compute))}
function compute(){let p=current(),a=+$("amount").value||0,fee=(+$("fee").value||0)/100,tax=(+$("tax").value||0)/100,fixed=+$("fixed").value||0,variable=+$("variable").value||0,cost=fixed+variable,hours=+$("hours").value||0,gross,commission,ret,net;if(calcMode==="target"){if(p.side){gross=(a+cost)/Math.max(.001,fee);commission=gross*fee;ret=commission*tax;net=commission-cost}else{let keep=1-fee-(p.netTax?(1-fee)*tax:tax);gross=(a+cost)/Math.max(.001,keep);commission=gross*fee;ret=(p.netTax?gross-commission:gross)*tax;net=gross-commission-ret-cost}}else{gross=a;commission=gross*fee;ret=(p.side?commission:p.netTax?gross-commission:gross)*tax;net=p.side?commission-cost:gross-commission-ret-cost}let ref=p.side?Math.max(commission,1):Math.max(gross,1),keepPct=Math.max(0,net/ref*100),feePct=p.side?0:commission/ref*100,taxPct=ret/ref*100,costPct=cost/ref*100;$("resultLabel").textContent=calcMode==="target"?"TENÉS QUE FACTURAR":"TE QUEDA EN EL BOLSILLO";$("mainResult").textContent=money(p.currency,calcMode==="target"?gross:net);$("resultText").textContent=p.side?`Tu comisión es ${money(p.currency,commission)} sobre una operación de ${money(p.currency,gross)}.`:`De cada 100 que paga el cliente te quedan ${Math.max(0,keepPct).toFixed(0)}.`;$("status").textContent=hours>0?`${money(p.currency,net/hours)} netos por hora`:`Comisión ${(+$("fee").value).toLocaleString("es-AR")}%`;$("distribution").innerHTML=`<span class="segment net" style="width:${Math.max(0,keepPct)}%"></span><span class="segment fee" style="width:${feePct}%"></span><span class="segment tax" style="width:${taxPct}%"></span><span class="segment cost" style="width:${costPct}%"></span>`;$("rows").innerHTML=`<div class="row"><span>${p.side?"Monto de la operación":"Facturación bruta"}</span><strong>${money(p.currency,gross)}</strong></div><div class="row"><span>${p.side?"Tu comisión":"Comisión de plataforma"}</span><strong>${money(p.currency,commission)}</strong></div><div class="row"><span>Retenciones</span><strong>${money(p.currency,ret)}</strong></div><div class="row"><span>Costos operativos</span><strong>${money(p.currency,cost)}</strong></div><div class="row"><span>Neto real</span><strong>${money(p.currency,net)}</strong></div>`}
function setMode(m){calcMode=m;$("grossMode").classList.toggle("active",m==="gross");$("targetMode").classList.toggle("active",m==="target");render()}function render(){drawPlatforms();let p=current();$("formTitle").textContent=calcMode==="gross"?"Tu venta, de bruto a neto":"¿Cuánto tenés que cobrar?";$("formHint").textContent=`${p.name}: tarifa de referencia ${p.fee}%${p.tax?` + ${p.tax}% de retención`:""}. Podés reemplazarla.`;drawFields();compute()}$("grossMode").onclick=()=>setMode("gross");$("targetMode").onclick=()=>setMode("target");$("calculate").onclick=()=>{compute();let b=$("calculate"),old=b.textContent;b.textContent="✓ Cuenta actualizada";setTimeout(()=>b.textContent=old,1300)};render();

})();
</script>
<style is:global>

.mockup-comisiones-plataforma{--ink:#111c31;--muted:#677184;--paper:#f5f6f2;--card:#fff;--green:#218166;--green2:#e0f2e9;--blue:#3267c7;--blue2:#e9f0ff;--orange:#e98a44;--red:#d45d58;--navy:#172e4d;--line:#dde2df}
.mockup-comisiones-plataforma *{box-sizing:border-box}.mockup-comisiones-plataforma [hidden]{display:none!important}.mockup-comisiones-plataforma{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-comisiones-plataforma button,.mockup-comisiones-plataforma input,.mockup-comisiones-plataforma select{font:inherit}.mockup-comisiones-plataforma .wrap{max-width:1180px;margin:auto;padding:0 28px}
.mockup-comisiones-plataforma header{height:84px;background:#fff;border-bottom:1px solid var(--line)}.mockup-comisiones-plataforma header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-comisiones-plataforma .brand{display:flex;align-items:center;gap:12px;font-weight:850;font-size:20px}.mockup-comisiones-plataforma .logo{width:35px;height:35px;border-radius:8px;background:var(--navy);display:grid;place-items:center;color:#fff;font-size:14px}.mockup-comisiones-plataforma .nav{display:flex;gap:26px;color:#4e5868;font-weight:700;font-size:14px}.mockup-comisiones-plataforma .actions{margin-left:auto;display:flex;gap:10px}.mockup-comisiones-plataforma .ghost{border:1px solid var(--line);background:#fff;padding:11px 15px;border-radius:12px;font-weight:750;color:var(--ink)}
.mockup-comisiones-plataforma .hero{padding:58px 0 50px;background:linear-gradient(135deg,#f8fbf7,#eef4fb)}.mockup-comisiones-plataforma .crumb{font-size:14px;color:#3c73c6;margin-bottom:19px}.mockup-comisiones-plataforma .hero-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:65px;align-items:center}.mockup-comisiones-plataforma .eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:900;color:var(--green)}.mockup-comisiones-plataforma h1{font-size:56px;line-height:1.02;letter-spacing:-.05em;margin:14px 0 19px}.mockup-comisiones-plataforma .lead{font-size:19px;color:var(--muted);max-width:680px}.mockup-comisiones-plataforma .chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.mockup-comisiones-plataforma .chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 13px;font-size:13px;font-weight:780}
.mockup-comisiones-plataforma .visual{height:345px;position:relative}.mockup-comisiones-plataforma .receipt{position:absolute;width:250px;min-height:295px;background:#fff;left:75px;top:10px;border-radius:13px 13px 4px 4px;box-shadow:0 25px 55px #273d561b;padding:27px}.mockup-comisiones-plataforma .receipt:after{content:"";position:absolute;left:0;right:0;bottom:-11px;height:13px;background:linear-gradient(135deg,transparent 7px,#fff 0) 0 0/14px 14px repeat-x}.mockup-comisiones-plataforma .receipt h3{font-size:17px;margin:0 0 18px}.mockup-comisiones-plataforma .rline{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px dashed #d9dfe2;color:var(--muted);font-size:13px}.mockup-comisiones-plataforma .rline strong{color:var(--ink)}.mockup-comisiones-plataforma .rline.total{font-size:17px;color:var(--ink);border:0;margin-top:7px}.mockup-comisiones-plataforma .rline.total strong{color:var(--green)}.mockup-comisiones-plataforma .stamp{position:absolute;right:-12px;top:65px;width:95px;height:95px;border:4px double var(--red);color:var(--red);border-radius:50%;display:grid;place-items:center;text-align:center;font-size:11px;font-weight:950;transform:rotate(10deg);background:#fff}.mockup-comisiones-plataforma .net-card{position:absolute;right:0;bottom:10px;background:var(--navy);color:#fff;border-radius:16px;padding:15px 18px;box-shadow:0 15px 35px #20334b2b}.mockup-comisiones-plataforma .net-card small{display:block;color:#afc2d8;font-size:10px;font-weight:900;letter-spacing:.1em}.mockup-comisiones-plataforma .net-card strong{font-size:25px}
.mockup-comisiones-plataforma .tool{background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden;box-shadow:0 20px 55px #263b4e10;margin-bottom:70px}.mockup-comisiones-plataforma .platform-head{padding:21px 23px 12px;display:flex;align-items:center;justify-content:space-between}.mockup-comisiones-plataforma .platform-head b{font-size:13px}.mockup-comisiones-plataforma .platforms{padding:0 22px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.mockup-comisiones-plataforma .platform{min-height:72px;text-align:left;border:1px solid var(--line);background:#fbfcfb;border-radius:13px;padding:12px;cursor:pointer;color:var(--ink)}.mockup-comisiones-plataforma .platform b{display:block;font-size:12px}.mockup-comisiones-plataforma .platform span{font-size:10px;color:var(--muted)}.mockup-comisiones-plataforma .platform.active{border:2px solid var(--green);background:#edf8f3;padding:11px}
.mockup-comisiones-plataforma .calc{display:grid;grid-template-columns:.94fr 1.06fr}.mockup-comisiones-plataforma .form{padding:31px}.mockup-comisiones-plataforma .form-top{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:6px}.mockup-comisiones-plataforma .form h2{font-size:26px;letter-spacing:-.03em;margin:0}.mockup-comisiones-plataforma .toggle{display:flex;background:#eef1ef;border-radius:10px;padding:3px}.mockup-comisiones-plataforma .toggle button{border:0;background:transparent;border-radius:8px;padding:7px 9px;font-size:11px;font-weight:850;color:var(--muted);cursor:pointer}.mockup-comisiones-plataforma .toggle button.active{background:#fff;color:var(--green);box-shadow:0 2px 7px #17332618}.mockup-comisiones-plataforma .hint{color:var(--muted);margin:0 0 23px}.mockup-comisiones-plataforma .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-comisiones-plataforma .field{display:flex;flex-direction:column;gap:7px}.mockup-comisiones-plataforma .field label{font-size:13px;font-weight:800}.mockup-comisiones-plataforma .field input{width:100%;border:1px solid #cdd5d2;background:#fff;border-radius:12px;padding:14px;outline:none;color:var(--ink)}.mockup-comisiones-plataforma .field input:focus{border-color:var(--green);box-shadow:0 0 0 3px #2181661a}.mockup-comisiones-plataforma .prefix{position:relative}.mockup-comisiones-plataforma .prefix:before{content:"$";position:absolute;left:14px;top:13px;color:var(--muted);font-weight:800}.mockup-comisiones-plataforma .prefix input{padding-left:31px}.mockup-comisiones-plataforma .primary{width:100%;border:0;background:var(--green);color:#fff;border-radius:13px;padding:15px;font-weight:850;margin-top:20px;cursor:pointer}
.mockup-comisiones-plataforma .result{background:var(--navy);color:#fff;padding:31px;position:relative;overflow:hidden}.mockup-comisiones-plataforma .result:after{content:"";position:absolute;width:270px;height:270px;border-radius:50%;border:48px solid #ffffff08;right:-155px;bottom:-150px}.mockup-comisiones-plataforma .caps{font-size:10px;color:#acd7cc;letter-spacing:.13em;font-weight:900}.mockup-comisiones-plataforma .big{font-size:46px;line-height:1.05;letter-spacing:-.045em;font-weight:920;margin:15px 0 7px}.mockup-comisiones-plataforma .sub{color:#d4dfeb;min-height:49px}.mockup-comisiones-plataforma .status{display:inline-block;background:#dff3e9;color:#17634a;padding:8px 12px;border-radius:99px;font-size:13px;font-weight:850;margin:12px 0 21px}.mockup-comisiones-plataforma .distribution{height:13px;border-radius:99px;display:flex;overflow:hidden;margin-bottom:20px;background:#4b5b70}.mockup-comisiones-plataforma .segment.net{background:#55b48a}.mockup-comisiones-plataforma .segment.fee{background:#e46b62}.mockup-comisiones-plataforma .segment.tax{background:#e4aa4d}.mockup-comisiones-plataforma .segment.cost{background:#7687a0}.mockup-comisiones-plataforma .rows{border-top:1px solid #ffffff24}.mockup-comisiones-plataforma .row{display:flex;justify-content:space-between;gap:18px;padding:12px 0;border-bottom:1px solid #ffffff1b;color:#d5dfeb}.mockup-comisiones-plataforma .row strong{color:#fff;text-align:right}
.mockup-comisiones-plataforma .section{padding:10px 0 70px}.mockup-comisiones-plataforma .section-head{text-align:center;max-width:750px;margin:0 auto 30px}.mockup-comisiones-plataforma .section-head h2{font-size:39px;letter-spacing:-.04em;margin:8px 0}.mockup-comisiones-plataforma .section-head p{color:var(--muted)}.mockup-comisiones-plataforma .compare{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.mockup-comisiones-plataforma .compare-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:21px}.mockup-comisiones-plataforma .compare-card.best{border:2px solid var(--green);padding:20px}.mockup-comisiones-plataforma .badge{display:inline-block;background:var(--green2);color:var(--green);border-radius:99px;padding:5px 8px;font-size:10px;font-weight:900;margin-bottom:11px}.mockup-comisiones-plataforma .compare-card small{display:block;color:var(--muted);font-size:11px}.mockup-comisiones-plataforma .compare-card strong{display:block;font-size:26px;margin:8px 0}.mockup-comisiones-plataforma .compare-card p{font-size:13px;color:var(--muted);margin:0}
.mockup-comisiones-plataforma .formula{background:#e9eeeb;padding:66px 0}.mockup-comisiones-plataforma .formula-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:65px}.mockup-comisiones-plataforma .formula h2{font-size:40px;line-height:1.08;margin:10px 0}.mockup-comisiones-plataforma .formula p{color:var(--muted)}.mockup-comisiones-plataforma .steps{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-comisiones-plataforma .step{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px}.mockup-comisiones-plataforma .num{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;background:var(--blue2);color:var(--blue);font-weight:900;margin-bottom:12px}.mockup-comisiones-plataforma .step b{display:block;margin-bottom:5px}.mockup-comisiones-plataforma .step span{font-size:13px;color:var(--muted)}
.mockup-comisiones-plataforma footer{background:#fff;border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:13px}
@media(max-width:850px){.mockup-comisiones-plataforma .nav{display:none}.mockup-comisiones-plataforma .hero-grid,.mockup-comisiones-plataforma .calc,.mockup-comisiones-plataforma .formula-grid{grid-template-columns:1fr}.mockup-comisiones-plataforma .visual{height:300px}.mockup-comisiones-plataforma .platforms{display:flex;overflow:auto}.mockup-comisiones-plataforma .platform{min-width:150px}.mockup-comisiones-plataforma .compare{grid-template-columns:1fr 1fr}.mockup-comisiones-plataforma h1{font-size:45px}}@media(max-width:540px){.mockup-comisiones-plataforma .wrap{padding:0 18px}.mockup-comisiones-plataforma .hero{padding-top:35px}.mockup-comisiones-plataforma .visual{display:none}.mockup-comisiones-plataforma h1{font-size:39px}.mockup-comisiones-plataforma .fields,.mockup-comisiones-plataforma .compare,.mockup-comisiones-plataforma .steps{grid-template-columns:1fr}.mockup-comisiones-plataforma .tool{border-radius:18px}.mockup-comisiones-plataforma .form,.mockup-comisiones-plataforma .result{padding:25px 20px}.mockup-comisiones-plataforma .form-top{display:block}.mockup-comisiones-plataforma .toggle{margin-top:12px;width:max-content}}

.mockup-comisiones-plataforma { width:100%; overflow:hidden; }
.mockup-comisiones-plataforma .top, .mockup-comisiones-plataforma header.top { display:none !important; }
.mockup-comisiones-plataforma .foot { display:none !important; }
.mockup-comisiones-plataforma .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-comisiones-plataforma .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-comisiones-plataforma .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-comisiones-plataforma .support-real summary { cursor:pointer; font-weight:750; }
.mockup-comisiones-plataforma .support-real p { color:#687a8f; line-height:1.65; }
@media(max-width:800px){.mockup-comisiones-plataforma .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-comisiones-plataforma support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
