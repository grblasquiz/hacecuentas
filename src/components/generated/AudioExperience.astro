---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-audio" set:html={`<div class="crumb">Tecnología / Audio</div><h1>El ruido entra donde la señal llega demasiado baja.</h1><p class="lead">Ajustá ganancia, distancia, compresión y salida siguiendo la cadena completa, no un control aislado.</p><section class="console"><div class="chain"><div class="unit"><b>Micrófono</b><label>Distancia cm<input id="distance" type="range" min="2" max="80" value="15"></label></div><div class="unit"><b>Preamp</b><label>Ganancia dB<input id="gain" type="range" min="0" max="60" value="35"></label></div><div class="unit"><b>Compresor</b><label>Ratio<input id="ratio" type="range" min="1" max="10" value="3"></label></div><div class="unit"><b>Salida</b><label>Nivel %<input id="output" type="range" min="0" max="100" value="75"></label></div></div><div class="meter" id="meter"></div><div class="diagnosis" id="diagnosis"></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-audio')?document.currentScript.previousElementSibling:document.querySelector('.mockup-audio');
const $=x=>root.querySelector("#"+x);function render(){let d=+$('distance').value,g=+$('gain').value,r=+$('ratio').value,o=+$('output').value,level=Math.max(0,g-(d/3)+o/5),clip=level>48,noise=level<25;$('meter').innerHTML=Array.from({length:18},(_,i)=>`<i class=\"${clip&&i>14?'clip':''}\" style=\"height:${Math.min(100,Math.max(5,level*2-i*2))}%\"></i>`).join('');$('diagnosis').innerHTML=`<b>${clip?'Riesgo de clipping':noise?'Señal baja':'Cadena equilibrada'}</b><br>${clip?'Bajá el preamp antes que la salida.':noise?'Acercá el micrófono antes de sumar ganancia y ruido.':`El compresor ${r}:1 controla picos sin reemplazar una buena captura.`}`}root.querySelectorAll('input').forEach(x=>x.oninput=render);render();
})();
</script>
<style is:global>
.mockup-audio{--blue:#174b7a;--ink:#182a32;--muted:#65747c;--line:#d7e1df;--green:#3d9d77;--red:#d75f55;--paper:#f5f7f5}.mockup-audio *{box-sizing:border-box}.mockup-audio{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-audio input,.mockup-audio button{font:inherit}.mockup-audio .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-audio .crumb{color:var(--blue);font-weight:850}.mockup-audio h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-audio .lead{font-size:18px;color:var(--muted)}.mockup-audio .console{margin-top:26px;background:#fff;border:1px solid var(--line);border-radius:24px;padding:25px}.mockup-audio .chain{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.mockup-audio .unit{border:2px solid var(--line);border-radius:17px;padding:16px;position:relative}.mockup-audio .unit:not(:last-child):after{content:"→";position:absolute;right:-19px;top:42%;font-size:25px;color:var(--blue)}.mockup-audio .unit label{display:block;font-size:12px;font-weight:850;margin-top:12px}.mockup-audio .unit input{width:100%;accent-color:var(--blue)}.mockup-audio .meter{display:flex;gap:3px;height:160px;align-items:end;justify-content:center;margin-top:22px}.mockup-audio .meter i{width:14px;background:var(--green);border-radius:3px}.mockup-audio .meter i.clip{background:var(--red)}.mockup-audio .diagnosis{margin-top:18px;background:#e3f1eb;border-radius:15px;padding:16px}.mockup-audio .diagnosis b{color:var(--blue)}@media(max-width:800px){.mockup-audio .chain{grid-template-columns:1fr 1fr}.mockup-audio .unit:after{display:none}}
.mockup-audio { width:100%; overflow:hidden; }
.mockup-audio .top, .mockup-audio header.top { display:none !important; }
.mockup-audio .foot { display:none !important; }
.mockup-audio .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-audio .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-audio .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-audio .support-real summary { cursor:pointer; font-weight:750; }
.mockup-audio .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-audio :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-audio input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-audio input[type="number"]::-webkit-inner-spin-button, .mockup-audio input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-audio .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-audio support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
