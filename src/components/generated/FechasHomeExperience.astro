<div class="mockup-fechas-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Fechas</div><div class="heroGrid"><div><span class="eyebrow">El tiempo, contado como lo necesitás</span><h1>Días, meses y años. Sin perderse en el calendario.</h1><p class="lead">Calculá diferencias, edades, cuentas regresivas y feriados. Fechas claras para organizar decisiones reales.</p><div class="trust"><span>✓ Días corridos o hábiles</span><span>✓ Sumar y restar</span><span>✓ Resultados exactos</span></div><div class="scene"><i class="calendar"></i><i class="rings"></i><i class="dateArt">29</i><i class="spark"></i></div></div>
<div class="calc"><div class="calcHead"><div><h2>Hacé una cuenta con fechas</h2><p>Elegí qué querés saber.</p></div><span class="live">RESULTADO EN VIVO</span></div><div class="modes"><button class="mode active" data-mode="difference">Días entre fechas</button><button class="mode" data-mode="add">Sumar o restar</button><button class="mode" data-mode="countdown">Cuánto falta</button></div><div class="fields"><div class="field"><label id="labelStart">Fecha inicial</label><div class="input"><input id="start" type="date"></div></div><div class="field" id="endField"><label id="labelEnd">Fecha final</label><div class="input"><input id="end" type="date"></div></div><div class="field hidden" id="daysField"><label>Cantidad de días</label><div class="input"><input id="daysToAdd" type="number" value="30"><span>días</span></div></div><div class="field"><label>Cómo contar</label><select id="dayType"><option value="calendar">Todos los días</option><option value="weekdays">Solo lunes a viernes</option></select></div></div><button class="primary" id="calculate">Actualizar cuenta</button><div class="result"><div class="resultTop"><div><small id="resultLabel">DIFERENCIA ENTRE LAS FECHAS</small><div class="amount" id="answer">45 días</div></div><span class="badge" id="modeLabel">Días corridos</span></div><div class="resultGrid"><div class="metric"><span id="metricOneLabel">SEMANAS + DÍAS</span><b id="metricOne">6 sem. + 3 días</b></div><div class="metric"><span id="metricTwoLabel">MESES APROX.</span><b id="metricTwo">1,5 meses</b></div><div class="metric"><span id="metricThreeLabel">FECHA FINAL</span><b id="metricThree">—</b></div></div><div class="timeline"><i id="timelineBar"></i></div><p class="note" id="note">El cálculo no incluye la fecha inicial; sí llega hasta la fecha final.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por tu pregunta</span><h2>¿Qué necesitás ubicar en el tiempo?</h2><p>Elegí una necesidad y encontrá primero la herramienta adecuada.</p></div><div class="needs"><button class="need active" data-filter="difference"><span class="icon">↔</span><h3>Comparar dos fechas</h3><p>Días corridos, hábiles y semanas.</p><em>→</em></button><button class="need" data-filter="age"><span class="icon">+</span><h3>Calcular una edad</h3><p>Años, meses y días exactos.</p><em>→</em></button><button class="need" data-filter="holidays"><span class="icon">★</span><h3>Ver feriados</h3><p>Fines de semana largos y laborables.</p><em>→</em></button><button class="need" data-filter="generation"><span class="icon">G</span><h3>Saber una generación</h3><p>Contexto según año de nacimiento.</p><em>→</em></button><button class="need" data-filter="countdown"><span class="icon">⌛</span><h3>Hacer una cuenta regresiva</h3><p>Cuánto falta para una fecha.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de fechas</span><h2>Todo el calendario, sin cuentas mentales.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="difference">Diferencias</button><button class="filter" data-filter="age">Edades</button><button class="filter" data-filter="holidays">Feriados</button><button class="filter" data-filter="generation">Generaciones</button><button class="filter" data-filter="countdown">Cuenta regresiva</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="difference countdown" data-text="dias entre fechas diferencia corridos habiles"><span class="tag">Calculadora principal</span><h3>Días entre fechas</h3><p>Contá días corridos o lunes a viernes, con semanas y meses.</p><button>Comparar fechas →</button></article><article class="card" data-cat="age" data-text="edad exacta años meses dias nacimiento cumpleaños"><span class="tag">Edad</span><h3>Edad exacta</h3><p>Años, meses, días y próximo cumpleaños.</p><button>Calcular edad →</button></article><article class="card" data-cat="holidays countdown" data-text="feriados argentina calendario fin semana largo"><span class="tag">Calendario</span><h3>Feriados</h3><p>Próximas fechas, días puente y fines de semana largos.</p><button>Ver feriados →</button></article><article class="card" data-cat="generation age" data-text="generaciones año nacimiento millennial gen z x"><span class="tag">Contexto</span><h3>¿De qué generación soy?</h3><p>Ubicá tu año en una generación y su contexto.</p><button>Ver generación →</button></article><article class="card" data-cat="countdown" data-text="cuenta regresiva cuantos dias faltan evento fecha"><span class="tag">Objetivo</span><h3>Cuánto falta para…</h3><p>Creá una cuenta regresiva para cualquier fecha.</p><button>Crear cuenta →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="order"><div class="wrap orderGrid"><div><span class="eyebrow" style="color:var(--yellow)">Antes de contar</span><h2>Tres decisiones cambian el resultado.</h2><p>Definí si incluís los extremos, qué entendés por día hábil y en qué zona horaria ocurre la fecha.</p></div><div class="orderList"><button class="orderBtn active" data-step="Extremos"><span><b>1. ¿Incluís fecha inicial y final?</b><small>La diferencia puede cambiar en un día.</small></span><b>→</b></button><button class="orderBtn" data-step="Hábiles"><span><b>2. ¿Qué días cuentan?</b><small>Corridos, lunes a viernes o con feriados.</small></span><b>→</b></button><button class="orderBtn" data-step="Zona"><span><b>3. ¿Importa la zona horaria?</b><small>Para horas y viajes, puede ser decisiva.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-fechas-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-fechas-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let mode="difference",day=864e5;const iso=d=>new Date(d-d.getTimezoneOffset()*60000).toISOString().slice(0,10),fmtDate=d=>d.toLocaleDateString("es-AR",{day:"2-digit",month:"short",year:"numeric"});let today=new Date();today.setHours(12,0,0,0);$("#start").value=iso(today);let future=new Date(today);future.setDate(future.getDate()+45);$("#end").value=iso(future);
function weekdays(a,b){let sign=b>=a?1:-1,c=0,d=new Date(a);while((sign>0&&d<b)||(sign<0&&d>b)){d.setDate(d.getDate()+sign);if(d.getDay()!==0&&d.getDay()!==6)c+=sign}return c}function addWeekdays(d,n){let out=new Date(d),left=Math.abs(n),dir=n>=0?1:-1;while(left){out.setDate(out.getDate()+dir);if(out.getDay()!==0&&out.getDay()!==6)left--}return out}
function calc(){const start=new Date($("#start").value+"T12:00:00"),type=$("#dayType").value;if(isNaN(start))return;let count,end;if(mode==="add"){count=+$("#daysToAdd").value||0;end=type==="weekdays"?addWeekdays(start,count):new Date(start.getTime()+count*day)}else{end=new Date($("#end").value+"T12:00:00");if(isNaN(end))return;count=type==="weekdays"?weekdays(start,end):Math.round((end-start)/day)}const abs=Math.abs(count),weeks=Math.floor(abs/7),rem=abs%7;$("#modeLabel").textContent=type==="weekdays"?"Lunes a viernes":"Días corridos";$("#timelineBar").style.width=Math.min(100,Math.max(10,abs/3))+"%";if(mode==="add"){$("#resultLabel").textContent="FECHA RESULTANTE";$("#answer").textContent=fmtDate(end);$("#metricOneLabel").textContent="DÍAS APLICADOS";$("#metricOne").textContent=count+" días";$("#metricTwoLabel").textContent="SEMANAS APROX.";$("#metricTwo").textContent=(Math.abs(count)/7).toLocaleString("es-AR",{maximumFractionDigits:1});$("#metricThreeLabel").textContent="DÍA DE LA SEMANA";$("#metricThree").textContent=end.toLocaleDateString("es-AR",{weekday:"long"});$("#note").textContent=count>=0?"Sumamos días desde la fecha inicial.":"Restamos días desde la fecha inicial."}else{$("#resultLabel").textContent=mode==="countdown"?"TIEMPO HASTA LA FECHA":"DIFERENCIA ENTRE LAS FECHAS";$("#answer").textContent=abs+" días";$("#metricOneLabel").textContent="SEMANAS + DÍAS";$("#metricOne").textContent=`${weeks} sem. + ${rem} días`;$("#metricTwoLabel").textContent="MESES APROX.";$("#metricTwo").textContent=(abs/30.4375).toLocaleString("es-AR",{maximumFractionDigits:1})+" meses";$("#metricThreeLabel").textContent="FECHA FINAL";$("#metricThree").textContent=fmtDate(end);$("#note").textContent=count<0?"La fecha elegida ya pasó.":"El cálculo no incluye la fecha inicial; sí llega hasta la fecha final."}}
$$(".calc input,.calc select").forEach(x=>x.oninput=calc);$$(".mode").forEach(b=>b.onclick=()=>{mode=b.dataset.mode;$$(".mode").forEach(x=>x.classList.toggle("active",x===b));$("#endField").classList.toggle("hidden",mode==="add");$("#daysField").classList.toggle("hidden",mode!=="add");$("#labelStart").textContent=mode==="countdown"?"Desde":"Fecha inicial";if(mode==="countdown")$("#start").value=iso(today);calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Cuenta actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".orderBtn").forEach(b=>b.onclick=()=>{$$(".orderBtn").forEach(x=>x.classList.toggle("active",x===b));toast("Criterio seleccionado: "+b.dataset.step)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
