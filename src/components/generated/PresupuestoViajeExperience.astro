.mockup-presupuesto-viaje { width:100%; overflow:hidden; }
.mockup-presupuesto-viaje .top, .mockup-presupuesto-viaje header.top { display:none !important; }
.mockup-presupuesto-viaje .foot { display:none !important; }
.mockup-presupuesto-viaje .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-presupuesto-viaje .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-presupuesto-viaje .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-presupuesto-viaje .support-real summary { cursor:pointer; font-weight:750; }
.mockup-presupuesto-viaje .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-presupuesto-viaje :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-presupuesto-viaje input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-presupuesto-viaje input[type="number"]::-webkit-inner-spin-button, .mockup-presupuesto-viaje input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
