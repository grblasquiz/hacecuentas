a .head{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:27px}.mockup-ingresos-brutos-cordoba .head h2{font-size:38px;letter-spacing:-.04em;margin:8px 0 0}.mockup-ingresos-brutos-cordoba .head p{max-width:480px;color:var(--muted);line-height:1.55;margin:0}.mockup-ingresos-brutos-cordoba .cases{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:20px}.mockup-ingresos-brutos-cordoba .case{min-height:101px;border:1px solid #d6dee6;border-radius:15px;background:#fafbfa;padding:15px;text-align:left;cursor:pointer;color:var(--ink)}.mockup-ingresos-brutos-cordoba .case.active{border:2px solid var(--red);padding:14px;background:#fff2f1}.mockup-ingresos-brutos-cordoba .case b{display:block;font-size:13px;margin:8px 0 4px}.mockup-ingresos-brutos-cordoba .case span{display:block;font-size:11px;color:#69768a;line-height:1.4}.mockup-ingresos-brutos-cordoba .case-code{width:34px;height:30px;border-radius:9px;background:#e8eef0;display:grid!important;place-items:center;font-size:10px!important;font-weight:950}.mockup-ingresos-brutos-cordoba .case.active .case-code{background:var(--red);color:#fff}.mockup-ingresos-brutos-cordoba .work{display:grid;grid-template-columns:1fr 1fr;gap:20px}.mockup-ingresos-brutos-cordoba .panel{border:1px solid var(--line);border-radius:23px;padding:28px;background:#fff}.mockup-ingresos-brutos-cordoba .case-note{background:#fff1ef;color:#744a49;border-radius:13px;padding:14px 16px;font-size:13px;line-height:1.5;margin-bottom:20px}.mockup-ingresos-brutos-cordoba .fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-ingresos-brutos-cordoba .field label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:#59677b;font-weight:950;margin-bottom:8px}.mockup-ingresos-brutos-cordoba .control{height:52px;border:1px solid #cad4dd;border-radius:12px;display:flex;align-items:center;overflow:hidden;background:#fff}.mockup-ingresos-brutos-cordoba .control:focus-within{bord