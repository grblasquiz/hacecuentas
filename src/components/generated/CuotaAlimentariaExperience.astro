up-cuota-alimentaria .lead{font-size:17px;line-height:1.62;color:#5d687a}.mockup-cuota-alimentaria .pills{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-cuota-alimentaria .pill{border:1px solid var(--line);background:white;border-radius:99px;padding:9px 13px;font-size:11px;color:#596575}.mockup-cuota-alimentaria .hero-card{background:var(--navy);color:white;border-radius:26px;padding:29px;box-shadow:0 20px 46px #20375829;position:relative;overflow:hidden}.mockup-cuota-alimentaria .hero-card:before{content:"";position:absolute;width:220px;height:220px;border-radius:50%;background:#ffffff08;right:-70px;top:-80px}.mockup-cuota-alimentaria .family{height:124px;display:flex;justify-content:center;align-items:end;gap:12px}.mockup-cuota-alimentaria .person{width:61px;height:78px;background:#54719b;border-radius:30px 30px 13px 13px;position:relative}.mockup-cuota-alimentaria .person:before{content:"";width:36px;height:36px;border-radius:50%;background:#7798c7;position:absolute;left:12px;top:-23px}.mockup-cuota-alimentaria .person.child{height:55px;width:45px;background:#56a688}.mockup-cuota-alimentaria .person.child:before{width:29px;height:29px;left:8px;top:-19px;background:#79cab0}.mockup-cuota-alimentaria .hero-card h2{text-align:center;font-size:23px;margin:10px 0 6px}.mockup-cuota-alimentaria .hero-card p{text-align:center;color:#c8d4e3;font-size:12px;line-height:1.55}.mockup-cuota-alimentaria .hero-mini{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:21px}.mockup-cuota-alimentaria .hero-mini div{background:#ffffff11;padding:14px;border-radius:13px}.mockup-cuota-alimentaria .hero-mini small{display:block;font-size:8px;color:#b9c9dc;margin-bottom:5px}.mockup-cuota-alimentaria .hero-mini strong{font-size:16px}.mockup-cuota-alimentaria .tool{padding:75px 0}.mockup-cuota-alimentaria .section-head{text-align:center;max-width:680px;margin:0 auto 30px}.mockup-cuota-alimentaria .section-head h2{font-size:39px;letter-spacing:-.04em;margin:9px 0}.mockup-cuota-alimentaria .section-head p{color:var(--muted);line-height:1.55}.mockup-cuota-alimentaria .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:24px}.mockup-cuota-alimentaria .case{min-height:86px;padding:16px;border:1px solid var(--line);border-radius:15px;background:#fff;text-align:left;color:var(--ink)}.mockup-cuota-alimentaria .case strong,.mockup-cuota-alimentaria .case small{display:block}.mockup-cuota-alimentaria .case strong{font-size:12px;margin-bottom:6px}.mockup-cuota-alimentaria .case small{font-size:9px;color:#748095;line-height:1.4}.mockup-cuota-alimentaria .case.active{border:2px solid var(--blue);background:var(--sky);padding:15px}.mockup-cuota-alimentaria .calc-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:20px;align-items:start}.mockup-cuota-alimentaria .panel{border:1px solid var(--line);border-radius:22px;padding:27px}.mockup-cuota-alimentaria .panel h3{font-size:20px;margin:0 0 5px}.mockup-cuota-alimentaria .intro{font-size:11px;color:var(--muted);line-height:1.5;margin:0 0 21px}.mockup-cuota-alimentaria .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-cuota-alimentaria .field.full{grid-column:1/-1}.mockup-cuota-alimentaria .field label{display:block;font-size:11px;font-weight:850;margin-bottom:7px}.mockup-cuota-alimentaria .field input,.mockup-cuota-alimentaria .field select{width:100%;height:48px;border:1px solid #d4dae3;border-radius:11px;background:white;padding:0 13px;outline:none;color:var(--ink)}.mockup-cuota-alimentaria .field input:focus,.mockup-cuota-alimentaria .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #4178cc19}.mockup-cuota-alimentaria .money{position:relative}.mockup-cuota-alimentaria .money span{position:absolute;left:13px;top:14px;color:#7b8596}.mockup-cuota-alimentaria .money input{padding-left:29px}.mockup-cuota-alimentaria .help{font-size:9px;color:#8791a0;line-height:1.4;margin-top:5px}.mockup-cuota-alimentaria .hidden{display:none!important}.mockup-cuota-alimentaria .go{height:51px;width:100%;border:0;border-radius:12px;background:var(--blue);color:white;font-weight:850;margin-top:20px}.mockup-cuota-alimentaria .privacy{text-align:center;color:#8993a2;font-size:9px}.mockup-cuota-alimentaria .result{background:var(--navy);border-color:var(--navy);color:white;position:sticky;top:18px}.mockup-cuota-alimentaria .result-top{display:flex;justify-content:space-between;gap:18px}.mockup-cuota-alimentaria .result h3{color:white}.mockup-cuota-alimentaria .result .intro{color:#c6d2e1}.mockup-cuota-alimentaria .status{height:max-content;background:#ffffff13;color:#c3d5ed;border-radius:8px;padding:8px 10px;font-size:9px;letter-spacing:.1em;font-weight:900}.mockup-cuota-alimentaria .big-label{font-size:9px;letter-spacing:.13em;color:#afc0d6;margin-top:22px}.mockup-cuota-alimentaria .range{font-size:37px;font-weight:900;letter-spacing:-.045em;margin:5px 0}.mockup-cuota-alimentaria .sub{font-size:11px;color:#d1dbe8;line-height:1.5}.mockup-cuota-alimentaria .suggestion{margin:20px 0 17px;background:#ffffff0e;border-radius:14px;padding:16px}.mockup-cuota-alimentaria .suggestion span{font-size:9px;color:#aec0d6}.mockup-cuota-alimentaria .suggestion strong{display:block;font-size:24px;margin:4px 0 7px}.mockup-cuota-alimentaria .suggestion p{font-size:9px;color:#c6d2e1;line-height:1.45;margin:0}.mockup-cuota-alimentaria .rows{border-top:1px solid #ffffff1a}.mockup-cuota-alimentaria .row{display:flex;justify-content:space-between;gap:20px;padding:12px 0;border-bottom:1px solid #ffffff12;font-size:11px;color:#c6d2e1}.mockup-cuota-alimentaria .row strong{color:white;text-align:right}.mockup-cuota-alimentaria .row .good{color:#6fe0b8}.mockup-cuota-alimentaria .row .warn{color:#ffc083}.mockup-cuota-alimentaria .notice{background:#ffffff0c;border-radius:11px;padding:13px;margin-top:17px;color:#cbd8e7;font-size:10px;line-height:1.45}.mockup-cuota-alimentaria .explain{padding:75px 0;background:var(--cream)}.mockup-cuota-alimentaria .split-head{display:flex;align-items:end;justify-content:space-between;gap:45px;margin-bottom:27px}.mockup-cuota-alimentaria .split-head h2{font-size:38px;letter-spacing:-.04em;margin:9px 0 0}.mockup-cuota-alimentaria .split-head p{max-width:470px;color:var(--muted);line-height:1.55}.mockup-cuota-alimentaria .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.mockup-cuota-alimentaria .info{background:white;border:1px solid var(--line);border-radius:18px;padding:22px}.mockup-cuota-alimentaria .info span{font-size:9px;font-weight:900;letter-spacing:.08em;color:var(--blue)}.mockup-cuota-alimentaria .info h3{font-size:17px;margin:9px 0}.mockup-cuota-alimentaria .info p{font-size:11px;color:var(--muted);line-height:1.55}.mockup-cuota-alimentaria .info.dark{background:var(--navy);border-color:var(--navy);color:white}.mockup-cuota-alimentaria .info.dark span,.mockup-cuota-alimentaria .info.dark p{color:#c4d1e2}.mockup-cuota-alimentaria .steps{padding:75px 0}.mockup-cuota-alimentaria .step-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.mockup-cuota-alimentaria .step{border:1px solid var(--line);border-radius:18px;padding:21px}.mockup-cuota-alimentaria .step b{width:29px;height:29px;display:grid;place-items:center;border-radius:50%;background:var(--sky);color:var(--blue);font-size:11px}.mockup-cuota-alimentaria .step h3{font-size:15px;margin:13px 0 7px}.mockup-cuota-alimentaria .step p{font-size:10px;color:var(--muted);line-height:1.5}.mockup-cuota-alimentaria .faq{padding:75px 0;background:var(--cream)}.mockup-cuota-alimentaria .faq-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:60px}.mockup-cuota-alimentaria .faq h2{font-size:37px;letter-spacing:-.04em}.mockup-cuota-alimentaria .faq-intro p{color:var(--muted);line-height:1.6}.mockup-cuota-alimentaria .faq-item{border-bottom:1px solid #d7dce4}.mockup-cuota-alimentaria .faq-item button{width:100%;border:0;background:transparent;padding:19px 0;display:flex;justify-content:space-between;text-align:left;color:var(--ink);font-weight:850}.mockup-cuota-alimentaria .faq-item button b{font-size:20px;color:var(--blue)}.mockup-cuota-alimentaria .answer{display:none;padding:0 30px 19px 0;font-size:12px;color:#616d80;line-height:1.6}.mockup-cuota-alimentaria .faq-item.open .answer{display:block}.mockup-cuota-alimentaria .faq-item.open button b{transform:rotate(45deg)}.mockup-cuota-alimentaria footer{background:#111d31;color:#bdc9d9;padding:38px 0;font-size:11px}.mockup-cuota-alimentaria footer .wrap{display:flex;justify-content:space-between}.mockup-cuota-alimentaria footer strong{color:white}
