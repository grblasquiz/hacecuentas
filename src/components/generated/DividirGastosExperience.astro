---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-dividir-gastos" set:html={`<section class="hero"><div class="hero-inner"><div class="crumb">Finanzas personales / Dividir gastos</div><div class="hero-row"><div><div class="eyebrow">Mesa de saldos</div><h1>Cerrá la cuenta con menos transferencias.</h1><p class="lead">Cargá cuánto debía poner y cuánto pagó cada persona. El tablero calcula saldos y propone quién le transfiere a quién.</p></div><div class="avatars"><span class="avatar">A</span><span class="avatar">L</span><span class="avatar">M</span><span class="avatar">S</span></div></div></div></section>
<section class="desk"><div class="desk-grid"><section class="sheet"><div class="sheet-top"><div><h2>Personas y aportes</h2><p>Podés usar partes iguales o editar cuánto corresponde a cada una.</p></div><button class="add" id="addPerson">+ Agregar persona</button></div><div class="table-head"><span>PERSONA</span><span>PAGÓ</span><span>SALDO</span><span></span></div><div id="people"></div><div class="rules"><button class="rule active" data-rule="equal">Partes iguales</button><button class="rule" data-rule="custom">Montos personalizados</button><button class="rule" data-rule="income">Según porcentajes</button></div></section><aside class="summary" aria-live="polite"><h2>Cómo cerrar la cuenta</h2><div class="grand" id="total">$180.000</div><div class="per" id="perPerson">$45.000 por persona</div><div class="settle"><h3>Transferencias sugeridas</h3><div id="transfers"></div></div><button class="copy" id="copy">Copiar resumen</button><div class="tip" id="tip">Con cuatro personas alcanza con dos transferencias para que todos queden en cero.</div></aside></div><section class="expenses"><div class="expenses-head"><h2>¿De dónde sale el total?</h2><span>Opcional, pero ayuda a detectar gastos olvidados.</span></div><div class="expense-list"><div class="expense"><label for="food">Comida</label><input id="food" type="number" value="95000" min="0"><small>Restaurante, supermercado o delivery.</small></div><div class="expense"><label for="transport">Traslados</label><input id="transport" type="number" value="35000" min="0"><small>Nafta, peajes, taxi o transporte.</small></div><div class="expense"><label for="other">Otros</label><input id="other" type="number" value="50000" min="0"><small>Entradas, alojamiento o compras comunes.</small></div></div></section></section>
<section class="principles"><div class="wrap principles-grid"><div><div class="kicker">Acuerdos antes de calcular</div><h2>Una cuenta justa necesita una regla clara</h2><p>El algoritmo reduce transferencias; no decide qué reparto es justo para el grupo.</p></div><div class="cards"><div class="card"><b>Partes iguales</b><span>Sirve cuando todos consumieron parecido y nadie necesita una excepción.</span></div><div class="card"><b>Por consumo</b><span>Editá la parte de quien no tomó alcohol, llegó después o pagó algo personal.</span></div><div class="card"><b>Por ingresos</b><span>Definan porcentajes antes del gasto y dejalos visibles para todo el grupo.</span></div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-dividir-gastos')?document.currentScript.previousElementSibling:document.querySelector('.mockup-dividir-gastos');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(Math.abs(n)).toLocaleString("es-AR");let rule="equal",people=[{name:"Ana",paid:90000,color:"#397d95"},{name:"Leo",paid:25000,color:"#d77e57"},{name:"Mica",paid:65000,color:"#6f63a0"},{name:"Santi",paid:0,color:"#4c956c"}];function expenses(){return ["food","transport","other"].reduce((s,id)=>s+(+$("#"+id).value||0),0)}function settle(balances){const debtors=balances.filter(x=>x.balance<-.01).map(x=>({...x,amount:-x.balance})),creditors=balances.filter(x=>x.balance>.01).map(x=>({...x,amount:x.balance})),out=[];let i=0,j=0;while(i<debtors.length&&j<creditors.length){const amount=Math.min(debtors[i].amount,creditors[j].amount);out.push({from:debtors[i].name,to:creditors[j].name,amount});debtors[i].amount-=amount;creditors[j].amount-=amount;if(debtors[i].amount<.01)i++;if(creditors[j].amount<.01)j++}return out}function render(){const total=expenses(),equal=total/people.length;$("#people").innerHTML=people.map((p,i)=>`<div class="person-row" data-i="${i}"><div class="name-wrap"><span class="dot" style="--c:${p.color}">${p.name[0]||"?"}</span><input class="person-name" value="${p.name}" aria-label="Nombre"></div><input class="paid" type="number" min="0" value="${p.paid}" aria-label="Cuánto pagó"><span class="balance"></span><button class="remove" aria-label="Eliminar">×</button></div>`).join("");$$(".person-row").forEach(row=>{const i=+row.dataset.i,name=row.querySelector(".person-name"),paid=row.querySelector(".paid"),remove=row.querySelector(".remove");name.addEventListener("input",()=>{people[i].name=name.value;calculate()});paid.addEventListener("input",()=>{people[i].paid=+paid.value||0;calculate()});remove.addEventListener("click",()=>{if(people.length>2){people.splice(i,1);render()}})});calculate()}function calculate(){const total=expenses(),share=total/people.length,balances=people.map((p,i)=>({name:p.name||"Persona "+(i+1),balance:p.paid-share}));$("#total").textContent=money(total);$("#perPerson").textContent=rule==="equal"?money(share)+" por persona":"Editá los porcentajes en la versión completa";$$(".person-row").forEach((row,i)=>{const b=balances[i].balance,el=row.querySelector(".balance");el.textContent=(b>=0?"+":"−")+money(b);el.className="balance "+(b>=0?"positive":"negative")});const tx=settle(balances);$("#transfers").innerHTML=tx.length?tx.map(t=>`<div class="transfer"><i>→</i><span><b>${t.from}</b> le paga a ${t.to}</span><b>${money(t.amount)}</b></div>`).join(""):`<div class="transfer"><i>✓</i><span>Todos están en cero</span><b></b></div>`;$("#tip").textContent=tx.length?`Con ${people.length} personas alcanza con ${tx.length} ${tx.length===1?"transferencia":"transferencias"} para cerrar la cuenta.`:"No hace falta transferir dinero."}["food","transport","other"].forEach(id=>$("#"+id).addEventListener("input",calculate));$("#addPerson").addEventListener("click",()=>{people.push({name:"Persona "+(people.length+1),paid:0,color:["#bc7256","#4b8e7d","#7d6cad"][people.length%3]});render()});$$("[data-rule]").forEach(b=>b.addEventListener("click",()=>{rule=b.dataset.rule;$$("[data-rule]").forEach(x=>x.classList.toggle("active",x===b));calculate()}));$("#copy").addEventListener("click",async()=>{const text=$("#transfers").innerText;try{await navigator.clipboard?.writeText(text)}catch{}$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1400)});render()})();
})();
</script>
<style is:global>

.mockup-dividir-gastos{--blue:#174b7a;--green:#2d8068;--mint:#e5f3ed;--peach:#fff1e9;--ink:#182332;--muted:#5f6977;--line:#dae2e4;--red:#b6534c}.mockup-dividir-gastos *{box-sizing:border-box}.mockup-dividir-gastos{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#f7faf8}.mockup-dividir-gastos button,.mockup-dividir-gastos input,.mockup-dividir-gastos select{font:inherit}.mockup-dividir-gastos .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-dividir-gastos .brand{font-size:19px;font-weight:950}.mockup-dividir-gastos .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-dividir-gastos .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-dividir-gastos .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-dividir-gastos .hero{padding:42px 22px 35px;background:#fff}.mockup-dividir-gastos .hero-inner,.mockup-dividir-gastos .wrap{max-width:1180px;margin:auto}.mockup-dividir-gastos .crumb{color:var(--blue);font-size:14px;font-weight:850}.mockup-dividir-gastos .hero-row{display:grid;grid-template-columns:1fr auto;gap:45px;align-items:end;margin-top:25px}.mockup-dividir-gastos .eyebrow{color:var(--green);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:950}.mockup-dividir-gastos .hero h1{font-size:clamp(43px,5vw,64px);line-height:.98;letter-spacing:-.05em;margin:9px 0 17px}.mockup-dividir-gastos .lead{font-size:19px;color:var(--muted);max-width:680px}.mockup-dividir-gastos .avatars{display:flex;align-items:center;padding:20px}.mockup-dividir-gastos .avatar{width:72px;height:72px;border-radius:50%;border:6px solid #fff;display:grid;place-items:center;color:#fff;font-size:22px;font-weight:950;margin-left:-14px;box-shadow:0 8px 20px #17374a20}.mockup-dividir-gastos .avatar:nth-child(1){background:#397d95}.mockup-dividir-gastos .avatar:nth-child(2){background:#d77e57}.mockup-dividir-gastos .avatar:nth-child(3){background:#6f63a0}.mockup-dividir-gastos .avatar:nth-child(4){background:#4c956c}.mockup-dividir-gastos .desk{padding:30px 22px 70px}.mockup-dividir-gastos .desk-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:1fr 330px;gap:22px;align-items:start}.mockup-dividir-gastos .sheet{background:#fff;border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 18px 45px #17374a0b}.mockup-dividir-gastos .sheet-top{padding:20px 23px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:15px}.mockup-dividir-gastos .sheet-top h2{font-size:24px;margin:0}.mockup-dividir-gastos .sheet-top p{margin:3px 0 0;color:var(--muted);font-size:12px}.mockup-dividir-gastos .add{border:0;border-radius:10px;background:var(--blue);color:#fff;padding:10px 13px;font-weight:900;cursor:pointer}.mockup-dividir-gastos .table-head,.mockup-dividir-gastos .person-row{display:grid;grid-template-columns:1.2fr 1fr .8fr 45px;gap:12px;align-items:center}.mockup-dividir-gastos .table-head{padding:11px 22px;background:#f3f6f5;color:var(--muted);font-size:10px;font-weight:900}.mockup-dividir-gastos .person-row{padding:13px 22px;border-top:1px solid #edf0f1}.mockup-dividir-gastos .name-wrap{display:flex;align-items:center;gap:9px}.mockup-dividir-gastos .dot{width:30px;height:30px;border-radius:50%;background:var(--c);color:#fff;display:grid;place-items:center;font-size:11px;font-weight:950}.mockup-dividir-gastos .person-row input{width:100%;min-height:42px;border:1px solid #ced8db;border-radius:9px;padding:9px 11px;color:var(--ink)}.mockup-dividir-gastos .balance{text-align:right;font-weight:950}.mockup-dividir-gastos .balance.positive{color:var(--green)}.mockup-dividir-gastos .balance.negative{color:var(--red)}.mockup-dividir-gastos .remove{border:0;background:none;color:#8a939e;font-size:20px;cursor:pointer}.mockup-dividir-gastos .rules{display:flex;gap:8px;flex-wrap:wrap;padding:18px 22px;border-top:1px solid var(--line);background:#fbfcfb}.mockup-dividir-gastos .rule{border:1px solid var(--line);border-radius:99px;background:#fff;padding:8px 11px;color:var(--ink);font-size:12px;font-weight:850;cursor:pointer}.mockup-dividir-gastos .rule.active{background:var(--mint);border-color:#69a78f;color:#174f40}.mockup-dividir-gastos .summary{padding:22px;background:var(--blue);border-radius:22px;color:#fff;position:sticky;top:16px}.mockup-dividir-gastos .summary small{color:#dceaf0}.mockup-dividir-gastos .summary h2{font-size:14px;text-transform:uppercase;letter-spacing:.1em;margin:0 0 14px;color:#dceaf0}.mockup-dividir-gastos .grand{font-size:40px;line-height:1;font-weight:950;letter-spacing:-.04em}.mockup-dividir-gastos .per{margin-top:5px;color:#dceaf0;font-size:13px}.mockup-dividir-gastos .settle{margin-top:23px}.mockup-dividir-gastos .settle h3{font-size:16px;margin:0 0 11px}.mockup-dividir-gastos .transfer{display:grid;grid-template-columns:34px 1fr auto;gap:9px;align-items:center;padding:11px 0;border-top:1px solid #ffffff24}.mockup-dividir-gastos .transfer:first-child{border:0}.mockup-dividir-gastos .transfer i{width:32px;height:32px;border-radius:50%;background:#ffffff18;display:grid;place-items:center;font-style:normal}.mockup-dividir-gastos .transfer span{font-size:12px}.mockup-dividir-gastos .transfer b{font-size:13px}.mockup-dividir-gastos .copy{width:100%;border:1px solid #ffffff42;background:#ffffff0d;color:#fff;padding:11px;border-radius:10px;font-weight:850;cursor:pointer;margin-top:16px}.mockup-dividir-gastos .tip{margin-top:14px;padding:12px;border-radius:10px;background:#fff7df;color:#58461f;font-size:12px}.mockup-dividir-gastos .expenses{max-width:1180px;margin:22px auto 0;background:#fff;border:1px solid var(--line);border-radius:22px;padding:22px}.mockup-dividir-gastos .expenses-head{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:15px}.mockup-dividir-gastos .expenses h2{font-size:22px;margin:0}.mockup-dividir-gastos .expenses-head span{font-size:12px;color:var(--muted)}.mockup-dividir-gastos .expense-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-dividir-gastos .expense{padding:14px;border:1px solid var(--line);border-radius:13px}.mockup-dividir-gastos .expense label{display:block;font-size:12px;font-weight:850;margin-bottom:6px}.mockup-dividir-gastos .expense input{width:100%;border:0;border-bottom:2px solid var(--line);padding:8px 0;font-size:18px;font-weight:900;color:var(--ink);outline:none}.mockup-dividir-gastos .expense small{display:block;color:var(--muted);font-size:10px;margin-top:5px}.mockup-dividir-gastos .principles{padding:60px 22px;background:#edf5f2}.mockup-dividir-gastos .principles-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:40px}.mockup-dividir-gastos .kicker{color:var(--green);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-dividir-gastos .principles h2{font-size:35px;letter-spacing:-.04em;margin:7px 0}.mockup-dividir-gastos .principles p{color:var(--muted)}.mockup-dividir-gastos .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-dividir-gastos .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px}.mockup-dividir-gastos .card b{display:block;margin-bottom:5px}.mockup-dividir-gastos .card span{font-size:12px;color:var(--muted)}.mockup-dividir-gastos .toast{position:fixed;right:20px;bottom:20px;padding:12px 16px;border-radius:10px;background:#173247;color:#fff;transform:translateY(80px);opacity:0;transition:.2s}.mockup-dividir-gastos .toast.show{transform:none;opacity:1}.mockup-dividir-gastos .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:880px){.mockup-dividir-gastos .nav{display:none}.mockup-dividir-gastos .hero-row,.mockup-dividir-gastos .desk-grid,.mockup-dividir-gastos .principles-grid{grid-template-columns:1fr}.mockup-dividir-gastos .summary{position:static}.mockup-dividir-gastos .expense-list,.mockup-dividir-gastos .cards{grid-template-columns:1fr}.mockup-dividir-gastos .avatars{display:none}}@media(max-width:600px){.mockup-dividir-gastos .hero h1{font-size:42px}.mockup-dividir-gastos .table-head{display:none}.mockup-dividir-gastos .person-row{grid-template-columns:1fr 1fr 35px}.mockup-dividir-gastos .name-wrap{grid-column:1/-1}.mockup-dividir-gastos .balance{display:none}}

.mockup-dividir-gastos { width:100%; overflow:hidden; }
.mockup-dividir-gastos .top, .mockup-dividir-gastos header.top { display:none !important; }
.mockup-dividir-gastos .foot { display:none !important; }
.mockup-dividir-gastos .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-dividir-gastos .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-dividir-gastos .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-dividir-gastos .support-real summary { cursor:pointer; font-weight:750; }
.mockup-dividir-gastos .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-dividir-gastos :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-dividir-gastos input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-dividir-gastos input[type="number"]::-webkit-inner-spin-button, .mockup-dividir-gastos input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-dividir-gastos .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-dividir-gastos support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
