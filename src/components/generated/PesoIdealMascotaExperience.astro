---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-peso-ideal-mascota" set:html={`<section class="hero"><div class="shell hero-grid"><div><div class="crumb">Mascotas / Peso ideal</div><div class="eyebrow">Condición corporal BCS</div><h1>El peso saludable no depende sólo de la raza.</h1><p class="lede">Observá cintura, costillas y abdomen para estimar la condición corporal de tu perro o gato.</p><div class="chips"><span class="chip">Escala de 1 a 9</span><span class="chip">Ideal: BCS 4–5</span><span class="chip">Objetivo orientativo</span></div></div><div class="art" aria-hidden="true"><div class="orb"></div><div class="card-art"><div class="art-tag">CONDICIÓN CORPORAL</div><div class="art-value" id="heroValue">BCS 7/9</div><div class="art-line"></div></div></div></div></section><section class="section"><div class="shell"><div class="head"><div class="eyebrow">Elegí la silueta más parecida</div><h2>Miralo desde arriba y de costado</h2><p>La palpación de las costillas es tan importante como la forma visual.</p></div><div class="cases"><button class="case" data-case="0"><b>Bajo peso · BCS 2</b><small>Costillas muy visibles, poca grasa y cintura marcada.</small></button><button class="case" data-case="1"><b>Ideal · BCS 5</b><small>Costillas palpables, cintura visible y abdomen recogido.</small></button><button class="case active" data-case="2"><b>Sobrepeso · BCS 7</b><small>Cuesta palpar costillas y la cintura se vuelve poco visible.</small></button><button class="case" data-case="3"><b>Obesidad · BCS 9</b><small>Depósitos de grasa evidentes y ausencia de cintura.</small></button></div><div class="calc"><div class="panel"><h3>Evaluá a tu mascota</h3><p class="intro" id="caseIntro">Las costillas se palpan con dificultad y la cintura es poco evidente.</p><div class="fields"><div class="field"><label for="species">Especie</label><select id="species"><option value="dog">Perro</option><option value="cat">Gato</option></select></div><div class="field"><label for="weight">Peso actual (kg)</label><input id="weight" type="number" min="0.1" step="0.1" value="18"></div><div class="field full"><label for="bcs">Puntaje corporal BCS (1–9)</label><input id="bcs" type="range" min="1" max="9" step="1" value="7"></div><div class="field"><label for="pace">Cambio semanal máximo orientativo</label><select id="pace"><option value=".005">0,5% del peso</option><option value=".01" selected>1% del peso</option></select></div><div class="field"><label for="age">Etapa de vida</label><select id="age"><option>Adulto</option><option>Cachorro o gatito</option><option>Senior</option></select></div></div><div class="buttons"><button class="primary" id="calculate">Actualizar evaluación</button><button class="secondary" id="reset">Reiniciar</button></div></div><div class="panel result" aria-live="polite"><div class="res-top"><div><div class="label">Peso objetivo orientativo</div><div class="amount" id="amount">—</div></div><span class="pill" id="scenario">Sobrepeso · BCS 7</span></div><p class="summary" id="summary"></p><div class="metrics"><div class="metric"><span>Condición corporal</span><strong id="m1">—</strong></div><div class="metric"><span>Diferencia estimada</span><strong id="m2">—</strong></div><div class="metric"><span>Cambio semanal máximo</span><strong id="m3">—</strong></div><div class="metric"><span>Tiempo orientativo</span><strong id="m4">—</strong></div></div><div class="progress"><i id="bar"></i></div><div class="note" id="note">El BCS debe confirmarse palpando al animal. No reduzcas alimento sin revisar dieta, salud y masa muscular con el veterinario.</div></div></div></div></section><section class="section support"><div class="shell"><div class="head"><div class="eyebrow">Cómo observar</div><h2>Tres señales valen más que una tabla de razas</h2></div><div class="support-grid"><article class="support-card"><span>COSTILLAS</span><h3>Palpables, no prominentes</h3><p>En condición ideal se sienten fácilmente con una cobertura fina de grasa.</p></article><article class="support-card"><span>CINTURA</span><h3>Visible desde arriba</h3><p>Detrás de las costillas debe existir una cintura perceptible, sin ser extrema.</p></article><article class="support-card"><span>ABDOMEN</span><h3>Recogido de costado</h3><p>El abdomen sube hacia las patas traseras; pelo, edad y raza pueden alterar la apariencia.</p></article></div></div></section><section class="section"><div class="shell faq"><div class="head"><div class="eyebrow">Preguntas frecuentes</div><h2>Lo importante, sin vueltas</h2></div><div class="faq-item open"><button class="faq-q">¿Cuál es el BCS ideal?<span>+</span></button><div class="faq-a">En la escala de 9 puntos, el rango ideal suele ser 4–5 para perros y 5 para gatos.</div></div><div class="faq-item"><button class="faq-q">¿El pelo puede engañar?<span>+</span></button><div class="faq-a">Sí. Por eso hay que mirar y palpar costillas, cintura y abdomen.</div></div><div class="faq-item"><button class="faq-q">¿La herramienta prescribe una dieta?<span>+</span></button><div class="faq-a">No. Estima un objetivo para conversar con el veterinario; no reemplaza el examen clínico ni la evaluación muscular.</div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-peso-ideal-mascota')?document.currentScript.previousElementSibling:document.querySelector('.mockup-peso-ideal-mascota');

(()=>{const $=id=>root.querySelector("#"+id),cases=["Bajo peso · BCS 2","Ideal · BCS 5","Sobrepeso · BCS 7","Obesidad · BCS 9"],intros=["Costillas y prominencias óseas muy visibles: requiere evaluación clínica.","Costillas palpables, cintura visible y abdomen recogido.","Las costillas se palpan con dificultad y la cintura es poco evidente.","Depósitos grasos evidentes y ausencia de cintura: requiere acompañamiento veterinario."];let active=2;const n=id=>Math.max(0,Number($(id).value)||0),kg=v=>v.toLocaleString("es-AR",{minimumFractionDigits:1,maximumFractionDigits:1})+" kg";function compute(){const weight=Math.max(.1,n("weight")),bcs=Math.max(1,Math.min(9,Math.round(n("bcs")))),pace=n("pace"),excess=(bcs-5)*.1,target=weight/Math.max(.4,1+excess),difference=target-weight,weekly=weight*pace,weeks=weekly?Math.ceil(Math.abs(difference)/weekly):0,state=bcs<4?"Bajo peso":bcs<=5?"Condición ideal":bcs<=7?"Sobrepeso":"Obesidad";$("amount").textContent=kg(target);$("heroValue").textContent="BCS "+bcs+"/9";$("scenario").textContent=state;$("summary").textContent=bcs>=4&&bcs<=5?`El peso actual de ${kg(weight)} está dentro de una condición corporal visualmente ideal. Mantené el seguimiento.`:`La estimación sugiere una diferencia de ${kg(Math.abs(difference))} respecto de una condición corporal 5/9.`;$("m1").textContent=state+" · "+bcs+"/9";$("m2").textContent=(difference>0?"+":"−")+kg(Math.abs(difference));$("m3").textContent=kg(weekly);$("m4").textContent=weeks?weeks+" semanas":"Mantener";$("bar").style.width=(bcs/9*100)+"%";$("note").textContent=$("age").value!=="Adulto"?"En crecimiento o etapa senior, no uses una meta automática: el veterinario debe definirla.":"El objetivo es orientativo y debe confirmarse con palpación, masa muscular e historia clínica."}function preset(i){active=i;const scores=[2,5,7,9];$("bcs").value=scores[i];$("caseIntro").textContent=intros[i];root.querySelectorAll("[data-case]").forEach((b,j)=>b.classList.toggle("active",i===j));compute()}root.querySelectorAll("[data-case]").forEach(b=>b.addEventListener("click",()=>preset(Number(b.dataset.case))));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",compute));$("calculate").addEventListener("click",compute);$("reset").addEventListener("click",()=>{$("species").value="dog";$("weight").value=18;$("pace").value=".01";$("age").value="Adulto";preset(2)});root.querySelectorAll(".faq-q").forEach(q=>q.addEventListener("click",()=>q.parentElement.classList.toggle("open")));compute()})();

})();
</script>
<style is:global>

.mockup-peso-ideal-mascota{--ink:#182231;--muted:#657386;--blue:#174b7a;--blue2:#eaf4fb;--mint:#39b799;--mint2:#e7f8f3;--coral:#e77c67;--sun:#f4bd55;--line:#dce4e9;--paper:#fbfcfa;--white:#fff;--shadow:0 18px 48px rgba(23,75,122,.1)}.mockup-peso-ideal-mascota *{box-sizing:border-box}.mockup-peso-ideal-mascota{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-peso-ideal-mascota button,.mockup-peso-ideal-mascota input,.mockup-peso-ideal-mascota select{font:inherit}.mockup-peso-ideal-mascota .shell{max-width:1180px;margin:auto;padding:0 24px}.mockup-peso-ideal-mascota .header{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-peso-ideal-mascota .nav{display:flex;justify-content:space-between;align-items:center}.mockup-peso-ideal-mascota .brand{display:flex;align-items:center;gap:10px;font-weight:900}.mockup-peso-ideal-mascota .logo{width:31px;height:35px;border-radius:7px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:12px}.mockup-peso-ideal-mascota .links{display:flex;gap:24px;color:#526074;font-size:13px;font-weight:750}.mockup-peso-ideal-mascota .navbtn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 12px;color:#46566a}.mockup-peso-ideal-mascota .hero{padding:52px 0 47px;background:linear-gradient(135deg,#eef9f6,#fff7e7 58%,#edf6fb)}.mockup-peso-ideal-mascota .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:50px;align-items:center}.mockup-peso-ideal-mascota .crumb{color:var(--blue);font-size:13px;font-weight:800}.mockup-peso-ideal-mascota .eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:900;color:var(--blue);margin-top:18px}.mockup-peso-ideal-mascota .hero h1{font-size:52px;line-height:1.03;letter-spacing:-.05em;margin:12px 0 17px}.mockup-peso-ideal-mascota .lede{font-size:18px;line-height:1.55;color:#536174}.mockup-peso-ideal-mascota .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.mockup-peso-ideal-mascota .chip{background:#fff;border:1px solid #d4e2df;border-radius:99px;padding:8px 11px;font-size:11px;color:#46655e;font-weight:800}.mockup-peso-ideal-mascota .art{height:310px;position:relative}.mockup-peso-ideal-mascota .orb{position:absolute;width:265px;height:265px;border-radius:50%;right:35px;top:18px;background:#dceef2}.mockup-peso-ideal-mascota .card-art{position:absolute;left:20px;top:64px;width:250px;height:164px;border-radius:23px;background:#fff;border:3px solid var(--blue);box-shadow:14px 16px 0 rgba(57,183,153,.22);padding:25px}.mockup-peso-ideal-mascota .art-tag{font-size:10px;color:var(--blue);font-weight:900;letter-spacing:.08em}.mockup-peso-ideal-mascota .art-value{font-size:37px;font-weight:950;color:var(--blue);margin:17px 0}.mockup-peso-ideal-mascota .art-line{height:9px;border-radius:9px;background:linear-gradient(90deg,var(--mint) 0 67%,#e5ebee 67%)}.mockup-peso-ideal-mascota .section{padding:62px 0}.mockup-peso-ideal-mascota .head{text-align:center;max-width:790px;margin:0 auto 29px}.mockup-peso-ideal-mascota .head h2{font-size:36px;letter-spacing:-.04em;margin:8px 0}.mockup-peso-ideal-mascota .head p{color:var(--muted);line-height:1.6}.mockup-peso-ideal-mascota .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:22px}.mockup-peso-ideal-mascota .case{border:1px solid var(--line);background:#fff;border-radius:17px;padding:16px;text-align:left;cursor:pointer;color:var(--ink);min-height:108px}.mockup-peso-ideal-mascota .case.active{border:2px solid var(--blue);background:var(--blue2)}.mockup-peso-ideal-mascota .case b{display:block;font-size:13px;margin-bottom:6px}.mockup-peso-ideal-mascota .case small{color:var(--muted);font-size:10px;line-height:1.4}.mockup-peso-ideal-mascota .calc{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px;align-items:start}.mockup-peso-ideal-mascota .panel{background:#fff;border:1px solid var(--line);border-radius:23px;padding:27px;box-shadow:var(--shadow)}.mockup-peso-ideal-mascota .panel h3{font-size:21px;margin:0 0 7px}.mockup-peso-ideal-mascota .intro{font-size:13px;color:var(--muted);line-height:1.5;margin:0 0 20px}.mockup-peso-ideal-mascota .fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-peso-ideal-mascota .field.full{grid-column:1/-1}.mockup-peso-ideal-mascota .field label{display:block;font-size:12px;font-weight:850;margin-bottom:7px}.mockup-peso-ideal-mascota .field input,.mockup-peso-ideal-mascota .field select{width:100%;height:48px;border:1px solid #cbd5df;border-radius:12px;background:#fff;color:var(--ink);padding:0 12px;outline:none}.mockup-peso-ideal-mascota .field input:focus,.mockup-peso-ideal-mascota .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,75,122,.12)}.mockup-peso-ideal-mascota .buttons{display:flex;gap:9px;margin-top:20px}.mockup-peso-ideal-mascota .primary,.mockup-peso-ideal-mascota .secondary{border-radius:12px;padding:13px 16px;font-weight:900;cursor:pointer}.mockup-peso-ideal-mascota .primary{border:1px solid var(--blue);background:var(--blue);color:#fff;flex:1}.mockup-peso-ideal-mascota .secondary{border:1px solid #ccd6df;background:#fff;color:#47576b}.mockup-peso-ideal-mascota .result{background:linear-gradient(145deg,#174b7a,#287b9b);color:#fff}.mockup-peso-ideal-mascota .result .intro{color:#d8eaf2}.mockup-peso-ideal-mascota .res-top{display:flex;justify-content:space-between;gap:12px}.mockup-peso-ideal-mascota .label{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#c6e3ed;font-weight:900}.mockup-peso-ideal-mascota .amount{font-size:42px;font-weight:950;letter-spacing:-.05em;margin:9px 0}.mockup-peso-ideal-mascota .pill{height:max-content;background:#e5faf3;color:#155e4e;border-radius:99px;padding:8px 10px;font-size:10px;font-weight:900}.mockup-peso-ideal-mascota .summary{font-size:13px;line-height:1.55;color:#eff7f9}.mockup-peso-ideal-mascota .metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:17px}.mockup-peso-ideal-mascota .metric{border:1px solid rgba(255,255,255,.23);background:rgba(255,255,255,.1);border-radius:14px;padding:14px}.mockup-peso-ideal-mascota .metric span{display:block;color:#d3e7ee;font-size:10px}.mockup-peso-ideal-mascota .metric strong{display:block;color:#fff;font-size:18px;margin-top:4px}.mockup-peso-ideal-mascota .progress{height:12px;background:rgba(255,255,255,.18);border-radius:99px;overflow:hidden;margin-top:18px}.mockup-peso-ideal-mascota .progress i{display:block;height:100%;width:68%;background:var(--sun);border-radius:99px;transition:.25s}.mockup-peso-ideal-mascota .note{margin-top:14px;background:#fff2d7;color:#684817;border-radius:12px;padding:11px 13px;font-size:11px;font-weight:750}.mockup-peso-ideal-mascota .support{background:#f1f7f5}.mockup-peso-ideal-mascota .support-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-peso-ideal-mascota .support-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.mockup-peso-ideal-mascota .support-card span{display:inline-block;background:var(--mint2);color:#176d5b;border-radius:8px;padding:5px 7px;font-size:9px;font-weight:900}.mockup-peso-ideal-mascota .support-card h3{font-size:15px;margin:11px 0 6px}.mockup-peso-ideal-mascota .support-card p{font-size:11px;line-height:1.5;color:var(--muted);margin:0}.mockup-peso-ideal-mascota .faq{max-width:850px;margin:auto}.mockup-peso-ideal-mascota .faq-item{border-bottom:1px solid var(--line)}.mockup-peso-ideal-mascota .faq-q{width:100%;border:0;background:transparent;color:var(--ink);display:flex;justify-content:space-between;text-align:left;padding:19px 3px;font-weight:850;cursor:pointer}.mockup-peso-ideal-mascota .faq-a{display:none;color:var(--muted);line-height:1.6;padding:0 35px 18px 3px}.mockup-peso-ideal-mascota .faq-item.open .faq-a{display:block}.mockup-peso-ideal-mascota .footer{height:100px;background:#fff;border-top:1px solid var(--line);display:grid;place-items:center;color:var(--muted);font-size:12px}@media(max-width:900px){.mockup-peso-ideal-mascota .links{display:none}.mockup-peso-ideal-mascota .hero-grid,.mockup-peso-ideal-mascota .calc{grid-template-columns:1fr}.mockup-peso-ideal-mascota .cases{grid-template-columns:1fr 1fr}.mockup-peso-ideal-mascota .support-grid{grid-template-columns:1fr}.mockup-peso-ideal-mascota .hero h1{font-size:43px}}@media(max-width:560px){.mockup-peso-ideal-mascota .shell{padding:0 16px}.mockup-peso-ideal-mascota .hero h1{font-size:35px}.mockup-peso-ideal-mascota .art{display:none}.mockup-peso-ideal-mascota .cases,.mockup-peso-ideal-mascota .fields,.mockup-peso-ideal-mascota .metrics{grid-template-columns:1fr}.mockup-peso-ideal-mascota .panel{padding:21px}.mockup-peso-ideal-mascota .res-top{display:block}.mockup-peso-ideal-mascota .pill{display:inline-block;margin-top:8px}}

.mockup-peso-ideal-mascota { width:100%; overflow:hidden; }
.mockup-peso-ideal-mascota .top, .mockup-peso-ideal-mascota header.top { display:none !important; }
.mockup-peso-ideal-mascota .foot { display:none !important; }
.mockup-peso-ideal-mascota .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-peso-ideal-mascota .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-peso-ideal-mascota .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-peso-ideal-mascota .support-real summary { cursor:pointer; font-weight:750; }
.mockup-peso-ideal-mascota .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-peso-ideal-mascota :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-peso-ideal-mascota input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-peso-ideal-mascota input[type="number"]::-webkit-inner-spin-button, .mockup-peso-ideal-mascota input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-peso-ideal-mascota .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-peso-ideal-mascota support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
