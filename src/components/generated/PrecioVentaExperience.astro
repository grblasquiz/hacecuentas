---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-precio-venta" set:html={`<section class="hero"><div class="shell hero-grid"><div><div class="crumb">Negocios / Precio de venta</div><div class="eyebrow">Precio rentable por canal</div><h1>Que vender más no signifique ganar menos.</h1><p class="lede">Sumá costos reales, comisiones e impuestos para encontrar un precio que conserve tu margen.</p><div class="chips"><span class="chip">Costo completo</span><span class="chip">Margen sobre venta</span><span class="chip">Promoción sostenible</span></div></div><div class="art" aria-hidden="true"><div class="orb"></div><div class="card-art"><div class="art-tag">PRECIO SUGERIDO</div><div class="art-value" id="heroValue">$39.300</div><div class="art-line"></div></div></div></div></section><section class="section"><div class="shell"><div class="head"><div class="eyebrow">¿Dónde lo vas a vender?</div><h2>El mismo producto necesita precios distintos</h2><p>Los cuatro canales quedan visibles y cargan supuestos editables.</p></div><div class="cases"><button class="case active" data-case="0"><b>Venta directa</b><small>Sin comisión de plataforma y con margen minorista.</small></button><button class="case" data-case="1"><b>Marketplace</b><small>Incluye comisión y mayor costo por operación.</small></button><button class="case" data-case="2"><b>Mayorista</b><small>Menor margen unitario, pensado para más volumen.</small></button><button class="case" data-case="3"><b>Precio con promoción</b><small>Calcula el precio de lista necesario antes del descuento.</small></button></div><div class="calc"><div class="panel"><h3>Costos y objetivo</h3><p class="intro" id="caseIntro">Venta propia sin comisión de plataforma.</p><div class="fields"><div class="field"><label for="variable">Costo variable por unidad</label><input id="variable" type="number" min="0" step="100" value="18000"></div><div class="field"><label for="fixed">Costos fijos mensuales</label><input id="fixed" type="number" min="0" step="1000" value="450000"></div><div class="field"><label for="units">Unidades esperadas por mes</label><input id="units" type="number" min="1" step="1" value="100"></div><div class="field"><label for="margin">Margen neto deseado (%)</label><input id="margin" type="number" min="0" max="90" step="1" value="30"></div><div class="field"><label for="commission">Comisión sobre la venta (%)</label><input id="commission" type="number" min="0" max="90" step="0.1" value="0"></div><div class="field"><label for="tax">Impuestos/cargos sobre venta (%)</label><input id="tax" type="number" min="0" max="90" step="0.1" value="8"></div><div class="field full"><label for="discount">Descuento promocional (%)</label><input id="discount" type="number" min="0" max="90" step="1" value="0"></div></div><div class="buttons"><button class="primary" id="calculate">Actualizar precio</button><button class="secondary" id="reset">Reiniciar</button></div></div><div class="panel result" aria-live="polite"><div class="res-top"><div><div class="label">Precio de lista sugerido</div><div class="amount" id="amount">—</div></div><span class="pill" id="scenario">Venta directa</span></div><p class="summary" id="summary"></p><div class="metrics"><div class="metric"><span>Precio cobrado</span><strong id="m1">—</strong></div><div class="metric"><span>Costo completo unitario</span><strong id="m2">—</strong></div><div class="metric"><span>Ganancia neta por unidad</span><strong id="m3">—</strong></div><div class="metric"><span>Ganancia mensual estimada</span><strong id="m4">—</strong></div></div><div class="progress"><i id="bar"></i></div><div class="note" id="note">El margen se calcula sobre el precio efectivamente cobrado, no como un simple recargo sobre el costo.</div></div></div></div></section><section class="section support"><div class="shell"><div class="head"><div class="eyebrow">La cuenta correcta</div><h2>No confundas margen con recargo</h2></div><div class="support-grid"><article class="support-card"><span>COSTO</span><h3>Asigná también los costos fijos</h3><p>Alquiler, software, administración y servicios deben repartirse entre las unidades que esperás vender.</p></article><article class="support-card"><span>CANAL</span><h3>Comisión e impuestos salen del precio</h3><p>Por eso no alcanza con sumarlos al costo: reducen el dinero que te queda de cada venta.</p></article><article class="support-card"><span>PROMO</span><h3>Diseñá el descuento de antemano</h3><p>El precio de lista debe permitir aplicar la promoción sin perder el margen objetivo.</p></article></div></div></section><section class="section"><div class="shell faq"><div class="head"><div class="eyebrow">Preguntas frecuentes</div><h2>Lo importante, sin vueltas</h2></div><div class="faq-item open"><button class="faq-q">¿Margen y markup son lo mismo?<span>+</span></button><div class="faq-a">No. El margen divide la ganancia por el precio de venta; el markup o recargo la compara con el costo.</div></div><div class="faq-item"><button class="faq-q">¿Qué pasa si comisión, impuestos y margen suman 100%?<span>+</span></button><div class="faq-a">No existe un precio finito que cumpla ese objetivo. La calculadora lo advierte para que ajustes los porcentajes.</div></div><div class="faq-item"><button class="faq-q">¿Incluye IVA?<span>+</span></button><div class="faq-a">Podés cargar los impuestos que realmente afecten tu precio. La configuración definitiva debe adaptarse a tu condición fiscal.</div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-precio-venta')?document.currentScript.previousElementSibling:document.querySelector('.mockup-precio-venta');

(()=>{const $=id=>root.querySelector("#"+id),cases=["Venta directa","Marketplace","Mayorista","Precio con promoción"],intros=["Venta propia sin comisión de plataforma.","La comisión del canal reduce el ingreso que queda por unidad.","Menor margen unitario con expectativa de más volumen.","El precio de lista absorbe el descuento sin sacrificar el margen."],presets=[[30,0,8,0,100],[30,16,8,0,100],[18,0,8,0,300],[30,0,8,20,100]];let active=0;const n=id=>Math.max(0,Number($(id).value)||0),money=v=>"$"+Math.round(v).toLocaleString("es-AR");function compute(){const variable=n("variable"),fixed=n("fixed"),units=Math.max(1,n("units")),margin=n("margin")/100,commission=n("commission")/100,tax=n("tax")/100,discount=n("discount")/100,cost=variable+fixed/units,denominator=1-margin-commission-tax;if(denominator<=0||discount>=1){$("amount").textContent="Revisá %";$("heroValue").textContent="Sin precio";$("summary").textContent="Margen, comisión e impuestos no pueden consumir el 100% del precio.";["m1","m3","m4"].forEach(id=>$(id).textContent="—");$("m2").textContent=money(cost);$("bar").style.width="100%";return}const charged=cost/denominator,list=charged/(1-discount),profit=charged-cost-charged*(commission+tax);$("amount").textContent=money(list);$("heroValue").textContent=money(list);$("scenario").textContent=cases[active];$("summary").textContent=discount?`Publicá a ${money(list)} para cobrar ${money(charged)} después del ${Math.round(discount*100)}% de descuento y conservar el margen.`:`Con este precio, cada venta cubre ${money(cost)} de costo completo y deja ${money(profit)} netos.`;$("m1").textContent=money(charged);$("m2").textContent=money(cost);$("m3").textContent=money(profit);$("m4").textContent=money(profit*units);$("bar").style.width=Math.min(96,margin*200)+"%";$("note").textContent=`Margen neto objetivo: ${(margin*100).toLocaleString("es-AR",{maximumFractionDigits:1})}% sobre el precio cobrado.`}function preset(i){active=i;const p=presets[i];["margin","commission","tax","discount","units"].forEach((id,j)=>$(id).value=p[j]);$("caseIntro").textContent=intros[i];root.querySelectorAll("[data-case]").forEach((b,j)=>b.classList.toggle("active",i===j));compute()}root.querySelectorAll("[data-case]").forEach(b=>b.addEventListener("click",()=>preset(Number(b.dataset.case))));root.querySelectorAll("input").forEach(x=>x.addEventListener("input",compute));$("calculate").addEventListener("click",compute);$("reset").addEventListener("click",()=>{$("variable").value=18000;$("fixed").value=450000;preset(0)});root.querySelectorAll(".faq-q").forEach(q=>q.addEventListener("click",()=>q.parentElement.classList.toggle("open")));compute()})();

})();
</script>
<style is:global>

.mockup-precio-venta{--ink:#182231;--muted:#657386;--blue:#174b7a;--blue2:#eaf4fb;--mint:#39b799;--mint2:#e7f8f3;--coral:#e77c67;--sun:#f4bd55;--line:#dce4e9;--paper:#fbfcfa;--white:#fff;--shadow:0 18px 48px rgba(23,75,122,.1)}.mockup-precio-venta *{box-sizing:border-box}.mockup-precio-venta{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-precio-venta button,.mockup-precio-venta input,.mockup-precio-venta select{font:inherit}.mockup-precio-venta .shell{max-width:1180px;margin:auto;padding:0 24px}.mockup-precio-venta .header{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-precio-venta .nav{display:flex;justify-content:space-between;align-items:center}.mockup-precio-venta .brand{display:flex;align-items:center;gap:10px;font-weight:900}.mockup-precio-venta .logo{width:31px;height:35px;border-radius:7px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:12px}.mockup-precio-venta .links{display:flex;gap:24px;color:#526074;font-size:13px;font-weight:750}.mockup-precio-venta .navbtn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 12px;color:#46566a}.mockup-precio-venta .hero{padding:52px 0 47px;background:linear-gradient(135deg,#eef9f6,#fff7e7 58%,#edf6fb)}.mockup-precio-venta .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:50px;align-items:center}.mockup-precio-venta .crumb{color:var(--blue);font-size:13px;font-weight:800}.mockup-precio-venta .eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:900;color:var(--blue);margin-top:18px}.mockup-precio-venta .hero h1{font-size:52px;line-height:1.03;letter-spacing:-.05em;margin:12px 0 17px}.mockup-precio-venta .lede{font-size:18px;line-height:1.55;color:#536174}.mockup-precio-venta .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.mockup-precio-venta .chip{background:#fff;border:1px solid #d4e2df;border-radius:99px;padding:8px 11px;font-size:11px;color:#46655e;font-weight:800}.mockup-precio-venta .art{height:310px;position:relative}.mockup-precio-venta .orb{position:absolute;width:265px;height:265px;border-radius:50%;right:35px;top:18px;background:#dceef2}.mockup-precio-venta .card-art{position:absolute;left:20px;top:64px;width:250px;height:164px;border-radius:23px;background:#fff;border:3px solid var(--blue);box-shadow:14px 16px 0 rgba(57,183,153,.22);padding:25px}.mockup-precio-venta .art-tag{font-size:10px;color:var(--blue);font-weight:900;letter-spacing:.08em}.mockup-precio-venta .art-value{font-size:37px;font-weight:950;color:var(--blue);margin:17px 0}.mockup-precio-venta .art-line{height:9px;border-radius:9px;background:linear-gradient(90deg,var(--mint) 0 67%,#e5ebee 67%)}.mockup-precio-venta .section{padding:62px 0}.mockup-precio-venta .head{text-align:center;max-width:790px;margin:0 auto 29px}.mockup-precio-venta .head h2{font-size:36px;letter-spacing:-.04em;margin:8px 0}.mockup-precio-venta .head p{color:var(--muted);line-height:1.6}.mockup-precio-venta .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:22px}.mockup-precio-venta .case{border:1px solid var(--line);background:#fff;border-radius:17px;padding:16px;text-align:left;cursor:pointer;color:var(--ink);min-height:108px}.mockup-precio-venta .case.active{border:2px solid var(--blue);background:var(--blue2)}.mockup-precio-venta .case b{display:block;font-size:13px;margin-bottom:6px}.mockup-precio-venta .case small{color:var(--muted);font-size:10px;line-height:1.4}.mockup-precio-venta .calc{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px;align-items:start}.mockup-precio-venta .panel{background:#fff;border:1px solid var(--line);border-radius:23px;padding:27px;box-shadow:var(--shadow)}.mockup-precio-venta .panel h3{font-size:21px;margin:0 0 7px}.mockup-precio-venta .intro{font-size:13px;color:var(--muted);line-height:1.5;margin:0 0 20px}.mockup-precio-venta .fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-precio-venta .field.full{grid-column:1/-1}.mockup-precio-venta .field label{display:block;font-size:12px;font-weight:850;margin-bottom:7px}.mockup-precio-venta .field input,.mockup-precio-venta .field select{width:100%;height:48px;border:1px solid #cbd5df;border-radius:12px;background:#fff;color:var(--ink);padding:0 12px;outline:none}.mockup-precio-venta .field input:focus,.mockup-precio-venta .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,75,122,.12)}.mockup-precio-venta .buttons{display:flex;gap:9px;margin-top:20px}.mockup-precio-venta .primary,.mockup-precio-venta .secondary{border-radius:12px;padding:13px 16px;font-weight:900;cursor:pointer}.mockup-precio-venta .primary{border:1px solid var(--blue);background:var(--blue);color:#fff;flex:1}.mockup-precio-venta .secondary{border:1px solid #ccd6df;background:#fff;color:#47576b}.mockup-precio-venta .result{background:linear-gradient(145deg,#174b7a,#287b9b);color:#fff}.mockup-precio-venta .result .intro{color:#d8eaf2}.mockup-precio-venta .res-top{display:flex;justify-content:space-between;gap:12px}.mockup-precio-venta .label{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#c6e3ed;font-weight:900}.mockup-precio-venta .amount{font-size:42px;font-weight:950;letter-spacing:-.05em;margin:9px 0}.mockup-precio-venta .pill{height:max-content;background:#e5faf3;color:#155e4e;border-radius:99px;padding:8px 10px;font-size:10px;font-weight:900}.mockup-precio-venta .summary{font-size:13px;line-height:1.55;color:#eff7f9}.mockup-precio-venta .metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:17px}.mockup-precio-venta .metric{border:1px solid rgba(255,255,255,.23);background:rgba(255,255,255,.1);border-radius:14px;padding:14px}.mockup-precio-venta .metric span{display:block;color:#d3e7ee;font-size:10px}.mockup-precio-venta .metric strong{display:block;color:#fff;font-size:18px;margin-top:4px}.mockup-precio-venta .progress{height:12px;background:rgba(255,255,255,.18);border-radius:99px;overflow:hidden;margin-top:18px}.mockup-precio-venta .progress i{display:block;height:100%;width:68%;background:var(--sun);border-radius:99px;transition:.25s}.mockup-precio-venta .note{margin-top:14px;background:#fff2d7;color:#684817;border-radius:12px;padding:11px 13px;font-size:11px;font-weight:750}.mockup-precio-venta .support{background:#f1f7f5}.mockup-precio-venta .support-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-precio-venta .support-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.mockup-precio-venta .support-card span{display:inline-block;background:var(--mint2);color:#176d5b;border-radius:8px;padding:5px 7px;font-size:9px;font-weight:900}.mockup-precio-venta .support-card h3{font-size:15px;margin:11px 0 6px}.mockup-precio-venta .support-card p{font-size:11px;line-height:1.5;color:var(--muted);margin:0}.mockup-precio-venta .faq{max-width:850px;margin:auto}.mockup-precio-venta .faq-item{border-bottom:1px solid var(--line)}.mockup-precio-venta .faq-q{width:100%;border:0;background:transparent;color:var(--ink);display:flex;justify-content:space-between;text-align:left;padding:19px 3px;font-weight:850;cursor:pointer}.mockup-precio-venta .faq-a{display:none;color:var(--muted);line-height:1.6;padding:0 35px 18px 3px}.mockup-precio-venta .faq-item.open .faq-a{display:block}.mockup-precio-venta .footer{height:100px;background:#fff;border-top:1px solid var(--line);display:grid;place-items:center;color:var(--muted);font-size:12px}@media(max-width:900px){.mockup-precio-venta .links{display:none}.mockup-precio-venta .hero-grid,.mockup-precio-venta .calc{grid-template-columns:1fr}.mockup-precio-venta .cases{grid-template-columns:1fr 1fr}.mockup-precio-venta .support-grid{grid-template-columns:1fr}.mockup-precio-venta .hero h1{font-size:43px}}@media(max-width:560px){.mockup-precio-venta .shell{padding:0 16px}.mockup-precio-venta .hero h1{font-size:35px}.mockup-precio-venta .art{display:none}.mockup-precio-venta .cases,.mockup-precio-venta .fields,.mockup-precio-venta .metrics{grid-template-columns:1fr}.mockup-precio-venta .panel{padding:21px}.mockup-precio-venta .res-top{display:block}.mockup-precio-venta .pill{display:inline-block;margin-top:8px}}

.mockup-precio-venta { width:100%; overflow:hidden; }
.mockup-precio-venta .top, .mockup-precio-venta header.top { display:none !important; }
.mockup-precio-venta .foot { display:none !important; }
.mockup-precio-venta .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-precio-venta .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-precio-venta .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-precio-venta .support-real summary { cursor:pointer; font-weight:750; }
.mockup-precio-venta .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-precio-venta :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-precio-venta input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-precio-venta input[type="number"]::-webkit-inner-spin-button, .mockup-precio-venta input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-precio-venta .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-precio-venta support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
