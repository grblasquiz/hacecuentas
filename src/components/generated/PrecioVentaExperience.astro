---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-precio-venta" set:html={`<div class="crumb">Negocios / Precio de venta</div><h1>El margen se calcula desde lo que te queda, no desde lo que cobrás.</h1><p class="lead">Construí el precio hacia atrás para cubrir costo, comisión, impuestos y utilidad real.</p><section class="priceLab"><aside class="costs"><h2>Economía por unidad</h2><label>Costo completo<input id="cost" type="number" value="18000"></label><label>Comisión del canal (%)<input id="fee" type="number" value="13"></label><label>Impuestos sobre venta (%)<input id="tax" type="number" value="8"></label><label>Margen neto deseado (%)<input id="margin" type="number" value="25"></label><div class="target" id="check"></div></aside><section class="waterfall"><h2>De qué está hecho el precio</h2><div class="bars" id="bars"></div><div class="final"><span>Precio mínimo sugerido</span><b id="price"></b></div></section></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-precio-venta')?document.currentScript.previousElementSibling:document.querySelector('.mockup-precio-venta');

const $=x=>root.querySelector("#"+x),money=n=>'$ '+Math.ceil(n).toLocaleString('es-AR');function render(){let c=+$('cost').value,f=+$('fee').value/100,t=+$('tax').value/100,m=+$('margin').value/100,den=1-f-t-m,p=den>0?c/den:0,parts=[['Costo',c,''],['Comisión',p*f,'fee'],['Impuestos',p*t,'fee'],['Utilidad',p*m,'profit']],max=Math.max(...parts.map(x=>x[1]),1);$('bars').innerHTML=parts.map(x=>`<div class=\"column\"><div class=\"bar ${x[2]}\" style=\"height:${40+x[1]/max*210}px\"></div><b>${x[0]}<br>${money(x[1])}</b></div>`).join('');$('price').textContent=den>0?money(p):'Revisar %';$('check').textContent=den>0?`Por cada venta te quedarían ${money(p*m)} antes de costos fijos.`:'Los porcentajes consumen 100% o más del precio.'}
root.querySelectorAll('input').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-precio-venta{--blue:#174b7a;--ink:#182a32;--muted:#65747c;--line:#d7e1df;--green:#3c9d77;--orange:#e47a45;--paper:#f5f7f5}.mockup-precio-venta *{box-sizing:border-box}.mockup-precio-venta{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-precio-venta input{font:inherit}.mockup-precio-venta .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-precio-venta .crumb{color:var(--blue);font-weight:850}.mockup-precio-venta h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-precio-venta .lead{font-size:18px;color:var(--muted)}.mockup-precio-venta .priceLab{display:grid;grid-template-columns:330px 1fr;gap:20px;margin-top:26px}.mockup-precio-venta .costs,.mockup-precio-venta .waterfall{background:#fff;border:1px solid var(--line);border-radius:24px;padding:23px}.mockup-precio-venta .costs label{display:block;font-size:12px;font-weight:850;margin:15px 0}.mockup-precio-venta .costs input{display:block;width:100%;border:0;border-bottom:2px solid var(--line);padding:8px 0;font-weight:900;color:var(--ink)}.mockup-precio-venta .target{background:#e3f1eb;border-radius:14px;padding:14px}.mockup-precio-venta .waterfall h2{margin:0}.mockup-precio-venta .bars{display:flex;align-items:end;gap:9px;height:300px;margin-top:25px}.mockup-precio-venta .column{flex:1;text-align:center}.mockup-precio-venta .bar{background:var(--blue);border-radius:9px 9px 0 0;min-height:10px}.mockup-precio-venta .bar.fee{background:var(--orange)}.mockup-precio-venta .bar.profit{background:var(--green)}.mockup-precio-venta .column b{display:block;font-size:12px;margin-top:7px}.mockup-precio-venta .final{margin-top:20px;border-top:1px solid var(--line);padding-top:17px;display:flex;justify-content:space-between}.mockup-precio-venta .final b{font-size:35px;color:var(--blue)}@media(max-width:760px){.mockup-precio-venta .priceLab{grid-template-columns:1fr}}
.mockup-precio-venta { width:100%; overflow:hidden; }
.mockup-precio-venta .top, .mockup-precio-venta header.top { display:none !important; }
.mockup-precio-venta .foot { display:none !important; }
.mockup-precio-venta .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-precio-venta .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-precio-venta .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-precio-venta .support-real summary { cursor:pointer; font-weight:750; }
.mockup-precio-venta .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-precio-venta :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-precio-venta input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-precio-venta input[type="number"]::-webkit-inner-spin-button, .mockup-precio-venta input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-precio-venta .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-precio-venta support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
