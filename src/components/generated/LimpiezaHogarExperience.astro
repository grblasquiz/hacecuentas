<div class="mockup-limpieza-hogar" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>Hogar</b> / Limpieza</div><div class="hero-grid"><div><span class="eyebrow">Tiempo · productos · ropa</span><h1>Una casa limpia, con un plan que sí entra en tu semana.</h1><p class="lede">Calculá tiempos, frecuencia, cantidades de producto y costo de lavado sin mezclar tareas ni comprar de más.</p><div class="chips"><span class="chip">7 herramientas en una página</span><span class="chip">Rutina por metros</span><span class="chip">Diluciones seguras</span><span class="chip">Lavado y secado</span></div></div><aside class="plan"><div class="plan-head"><b>RUTINA SEMANAL</b><span>70 M²</span></div><strong>2 h 20 min</strong><p>Limpieza de mantenimiento · dos bloques por semana</p><div class="plan-list"><div><span>Cocina y baño</span><b>55 min</b></div><div><span>Pisos y polvo</span><b>65 min</b></div><div><span>Orden rápido</span><b>20 min</b></div></div></aside></div></div></section>
<section class="tools"><div class="wrap"><div class="head"><div><span class="eyebrow">Elegí qué querés calcular</span><h2>Siete herramientas, todas visibles</h2></div><p>Cada opción abre solo los datos necesarios y conserva una explicación completa del resultado.</p></div><div class="cases"><button class="case active" data-case="rutina"><span class="case-code">M²</span><b>Rutina general</b><span>Horas por semana</span></button><button class="case" data-case="ambiente"><span class="case-code">AMB</span><b>Por ambiente</b><span>Frecuencia y minutos</span></button><button class="case" data-case="lavandina"><span class="case-code">ML</span><b>Diluir lavandina</b><span>Cantidad segura</span></button><button class="case" data-case="producto"><span class="case-code">PRO</span><b>Rendimiento</b><span>Cuánto producto usar</span></button><button class="case" data-case="ropa"><span class="case-code">$</span><b>Casa o lavandería</b><span>Comparar costo</span></button><button class="case" data-case="lavarropas"><span class="case-code">KWH</span><b>Consumo lavado</b><span>Agua y energía</span></button><button class="case" data-case="secado"><span class="case-code">SOL</span><b>Secado al aire</b><span>Horas estimadas</span></button></div>
<div class="work"><article class="panel"><div class="case-note" id="caseNote"></div><div class="fields" id="fields"></div><div class="actions"><button class="primary" id="calculate">Actualizar cálculo</button><button class="secondary" id="reset">Restablecer</button></div><div class="error" id="error"></div><p class="fine">Estimación orientativa. Leé siempre la etiqueta del producto y las instrucciones del fabricante del equipo.</p></article><article class="panel result"><div class="result-top"><small>RESULTADO ESTIMADO</small><span class="pill" id="pill">RUTINA</span></div><div class="total" id="total"></div><div class="total-sub" id="sub"></div><div class="rows" id="rows"></div><div class="insight" id="insight"></div></article></div></div></section>
<section class="routines"><div class="wrap"><div class="head"><div><span class="eyebrow">Una rutina sostenible</span><h2>Qué hacer según el tiempo que tenés</h2></div><p>La limpieza funciona mejor como mantenimiento frecuente que como una jornada agotadora cada tanto.</p></div><div class="routine-grid"><article class="routine"><small>10 MINUTOS</small><h3>Rescate rápido</h3><p>Ventilar, juntar objetos, despejar mesadas y barrer la zona más usada.</p></article><article class="routine"><small>30 MINUTOS</small><h3>Zona prioritaria</h3><p>Cocina o baño completos, sin intentar resolver toda la casa.</p></article><article class="routine"><small>60 MINUTOS</small><h3>Mantenimiento</h3><p>Polvo, pisos, superficies y sanitarios de una vivienda pequeña.</p></article><article class="routine"><small>2 BLOQUES</small><h3>Semana equilibrada</h3><p>Separá zonas húmedas de dormitorios y espacios comunes.</p></article></div></div></section>
<section class="safety"><div class="wrap"><div class="safety-card"><div><span class="eyebrow">Seguridad primero</span><h2>La lavandina no se mezcla.</h2><p>Prepará la dilución con agua, ventilá el ambiente y respetá el tiempo de contacto indicado en la etiqueta.</p></div><div class="donts"><div class="dont"><b>No mezclar con amoníaco</b>Puede liberar gases muy tóxicos.</div><div class="dont"><b>No mezclar con vinagre</b>Los ácidos pueden liberar cloro gaseoso.</div><div class="dont"><b>No usar “a ojo”</b>Más concentración no significa mejor desinfección.</div><div class="dont"><b>No guardar diluida</b>Prepará solo lo que vas a usar durante el día.</div></div></div></div></section>
<section class="faq"><div class="wrap faq-wrap"><span class="eyebrow">Preguntas frecuentes</span><h2>Lo que más ayuda a ahorrar tiempo</h2><div class="faq-item open"><button class="faq-q">¿Conviene limpiar toda la casa el mismo día?<span>−</span></button><div class="faq-a">No necesariamente. Dividir la rutina en dos o tres bloques suele ser más sostenible y evita que las zonas críticas acumulen suciedad.</div></div><div class="faq-item"><button class="faq-q">¿Cuánto producto hay que usar?<span>+</span></button><div class="faq-a">La cantidad depende de la concentración y de la superficie. Usar de más puede dejar residuos y no mejora el resultado.</div></div><div class="faq-item"><button class="faq-q">¿Qué hace que la ropa tarde más en secarse?<span>+</span></button><div class="faq-a">La baja temperatura, la humedad alta, poco viento, falta de sol, tejidos gruesos y un centrifugado débil.</div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-limpieza-hogar')?document.currentScript.previousElementSibling:document.querySelector('.mockup-limpieza-hogar');if(!root)return;

const $=id=>root.querySelector("#"+id),money=n=>"$"+new Intl.NumberFormat("es-AR",{maximumFractionDigits:0}).format(Math.round(n)),num=(n,d=1)=>new Intl.NumberFormat("es-AR",{maximumFractionDigits:d}).format(n);let current="rutina";const configs={rutina:{note:"Calculá cuántas horas semanales requiere tu casa según los metros y la profundidad.",fields:[["m2","Metros cuadrados","number",70,"m²"],["depth","Profundidad","select","mantenimiento",[["mantenimiento","Mantenimiento · 2 min/m²"],["media","Media · 3 min/m²"],["fondo","A fondo · 6 min/m²"]]],["hour","Valor hora servicio","number",8000,"$"]]},ambiente:{note:"Estimá minutos y frecuencia para un ambiente, ajustados por personas y mascotas.",fields:[["room","Ambiente","select","cocina",[["cocina","Cocina"],["bano","Baño"],["dormitorio","Dormitorio"],["living","Living"]]],["people","Personas","number",3,""],["pets","Mascotas","select","no",[["no","No"],["si","Sí"]]]]},lavandina:{note:"Prepará una dilución orientativa y revisá siempre la concentración de la etiqueta.",fields:[["use","Uso","select","superficies",[["superficies","Superficies"],["bano","Baño"],["pisos","Pisos"]]],["liters","Agua","number",5,"L"],["concentrated","Concentración","select","comun",[["comun","Común"],["concentrada","Concentrada"]]]]},producto:{note:"Calculá producto por uso, por mes y duración de un envase de un litro.",fields:[["surface","Superficie","number",40,"m²"],["times","Usos por semana","number",3,""],["dose","Dosis","number",5,"ml/m²"]]},ropa:{note:"Compará lavar en casa contra enviar la misma cantidad a una lavandería.",fields:[["washes","Lavados por semana","number",3,""],["kg","Kilos por lavado","number",5,"kg"],["laundry","Lavandería por kilo","number",2500,"$"],["home","Costo en casa por lavado","number",900,"$"]]},lavarropas:{note:"Estimá agua, energía y costo mensual según eficiencia y frecuencia.",fields:[["loads","Lavados por semana","number",3,""],["water","Agua por ciclo","number",55,"L"],["kwh","Energía por ciclo","number",0.65,"kWh"],["cycleCost","Costo por ciclo","number",1100,"$"]]},secado:{note:"Estimá el tiempo de secado al aire según prenda, temperatura, humedad y viento.",fields:[["garment","Prenda","select","remera",[["remera","Remera"],["jean","Jean"],["toalla","Toalla"],["sabanas","Sábanas"]]],["temp","Temperatura","number",22,"°C"],["humidity","Humedad","number",65,"%"],["wind","Viento","number",10,"km/h"]]}};
function build(){const c=configs[current];$("caseNote").textContent=c.note;$("fields").innerHTML=c.fields.map(f=>`<div class="field"><label for="${f[0]}">${f[1]}</label><div class="control">${f[2]==="select"?`<select id="${f[0]}">${f[4].map(o=>`<option value="${o[0]}" ${o[0]===f[3]?"selected":""}>${o[1]}</option>`).join("")}</select>`:`<input id="${f[0]}" type="number" value="${f[3]}"><span>${f[4]||""}</span>`}</div></div>`).join("");root.querySelectorAll("#fields input,#fields select").forEach(i=>i.addEventListener("keydown",e=>{if(e.key==="Enter")compute()}));compute()}function val(id){return Number($(id)?.value)||0}function row(k,v){return `<div class="row"><span>${k}</span><strong>${v}</strong></div>`}
function compute(){let total,sub,rows,insight;if(current==="rutina"){const m=val("m2"),d=$("depth").value,minRate={mantenimiento:2,media:3,fondo:6}[d];if(m<=0)return fail("Ingresá una superficie mayor que cero.");const min=m*minRate,h=min/60,cost=h*val("hour");total=num(h)+" h/semana";sub=num(min,0)+" minutos · "+(m<50?"1 bloque":m<100?"2 bloques":"3 bloques")+" recomendados";rows=row("Minutos semanales",num(min,0)+" min")+row("Horas mensuales",num(h*4.33)+" h")+row("Costo tercerizado",money(cost)+"/semana");insight="<strong>Dividí la rutina.</strong>Dos bloques cortos suelen ser más sostenibles que una jornada larga."}else if(current==="ambiente"){const data={cocina:[30,"3–5 veces por semana"],bano:[25,"2–3 veces por semana"],dormitorio:[20,"1 vez por semana"],living:[25,"1–2 veces por semana"]}[$("room").value],factor=(val("people")>3?1.3:1)*($("pets").value==="si"?1.4:1),min=Math.round(data[0]*factor);total=min+" min/sesión";sub=data[1];rows=row("Tiempo base",data[0]+" min")+row("Ajuste del hogar",num((factor-1)*100,0)+"%")+row("Tiempo final",min+" min");insight="<strong>Priorizá cocina y baño.</strong>La frecuencia importa más que una limpieza profunda ocasional."}else if(current==="lavandina"){const base={superficies:10,bano:20,pisos:5}[$("use").value],factor=$("concentrated").value==="concentrada"?.5:1,ml=base*val("liters")*factor;total=num(ml)+" ml";sub="Para "+num(val("liters"))+" L de agua · "+num(ml/5)+" tapitas de 5 ml";rows=row("Lavandina",num(ml)+" ml")+row("Agua",num(val("liters"))+" L")+row("Dosis",num(base*factor)+" ml/L");insight="<strong>Nunca mezcles lavandina.</strong>Usala solo con agua y respetá la etiqueta."}else if(current==="producto"){const use=val("surface")*val("dose"),month=use*val("times")*4.33,days=1000/(use*val("times")/7);total=num(use,0)+" ml/uso";sub=num(month,0)+" ml por mes";rows=row("Consumo semanal",num(use*val("times"),0)+" ml")+row("Duración envase 1 L",num(days,0)+" días")+row("Envases por mes",num(month/1000));insight="<strong>Más producto no limpia mejor.</strong>Medir evita residuos y compras innecesarias."}else if(current==="ropa"){const loads=val("washes")*4.33,lav=loads*val("kg")*val("laundry"),home=loads*val("home"),save=Math.abs(lav-home),winner=home<=lav?"Lavar en casa":"Lavandería";total=winner;sub="Ahorro estimado: "+money(save)+"/mes";rows=row("Casa por mes",money(home))+row("Lavandería por mes",money(lav))+row("Diferencia anual",money(save*12));insight="<strong>Sumá tu tiempo al comparar.</strong>El costo monetario no incluye traslado, tendido ni planchado."}else if(current==="lavarropas"){const cycles=val("loads")*4.33;total=money(cycles*val("cycleCost"))+"/mes";sub=num(cycles,0)+" ciclos mensuales";rows=row("Agua mensual",num(cycles*val("water"),0)+" L")+row("Energía mensual",num(cycles*val("kwh"))+" kWh")+row("Costo anual",money(cycles*val("cycleCost")*12));insight="<strong>Usá cargas completas.</strong>Reducir ciclos suele ahorrar más que elegir un programa apenas más corto."}else{const base={remera:3,jean:8,toalla:7,sabanas:5}[$("garment").value],tf=val("temp")>=25?.7:val("temp")>=15?1:1.4,hf=val("humidity")>80?1.5:val("humidity")>60?1.2:.9,wf=val("wind")<3?1.4:val("wind")<10?1.1:.85,h=base*tf*hf*wf;total=num(h)+" horas";sub="Secado al aire estimado";rows=row("Tiempo base",base+" h")+row("Factor clima",num(tf*hf*wf,2)+"×")+row("Rango prudente",num(h*.8)+"–"+num(h*1.25)+" h");insight="<strong>Separá bien las prendas.</strong>El aire entre tejidos acelera más el secado que amontonarlas al sol."}$("total").textContent=total;$("sub").textContent=sub;$("rows").innerHTML=rows;$("insight").innerHTML=insight;$("pill").textContent={rutina:"RUTINA",ambiente:"AMBIENTE",lavandina:"DILUCIÓN",producto:"PRODUCTO",ropa:"COSTO",lavarropas:"CONSUMO",secado:"SECADO"}[current];$("error").style.display="none"}function fail(m){$("error").textContent=m;$("error").style.display="block"}
root.querySelectorAll(".case").forEach(b=>b.onclick=()=>{current=b.dataset.case;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));build()});$("calculate").onclick=()=>{compute();$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1200)};$("reset").onclick=build;root.querySelectorAll(".faq-q").forEach(q=>q.onclick=()=>{const item=q.parentElement;item.classList.toggle("open");q.lastElementChild.textContent=item.classList.contains("open")?"−":"+"});build();

})();
</script>
<style is:global>

