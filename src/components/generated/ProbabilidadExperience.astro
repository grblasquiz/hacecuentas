---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-probabilidad" set:html={`<section class="hero"><div class="wrap crumb"><b>Matemática</b> &nbsp;/&nbsp; Probabilidad</div><div class="wrap grid"><div class="copy"><span class="eyebrow">Azar explicado, no adivinado</span><h1>¿Qué puede pasar y qué tan probable es?</h1><p>Resolvé sorteos, eventos repetidos, combinaciones, binomial y campana normal con la fórmula y la lectura en el mismo lugar.</p><div class="chips"><span>✓ Cinco tipos de problema</span><span>✓ Resultado visual</span><span>✓ Fórmula explicada</span></div><div class="art"><div class="dice d1"><i class="dot a"></i><i class="dot c"></i><i class="dot e"></i></div><div class="dice d2"><i class="dot a"></i><i class="dot b"></i><i class="dot d"></i><i class="dot e"></i></div><div class="formula-note"><small id="art-label">PROBABILIDAD POR CARA</small><b id="art-value">16,67%</b><span id="art-copy">1 resultado entre 6 posibles</span></div><div class="curve"><svg viewBox="0 0 310 75" preserveAspectRatio="none"><path d="M0 72 C60 72 82 68 112 43 C138 20 143 5 155 4 C167 5 172 20 198 43 C228 68 250 72 310 72" fill="#63aee233" stroke="#2877bf" stroke-width="3"/></svg></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Elegí tu problema</h2><p class="muted">Cada caso muestra sólo los datos que necesita.</p></div><span class="tag">Cálculo exacto</span></div><div class="label">¿Qué querés calcular?</div><div class="cases"><button type="button" class="case active" data-mode="draw"><i>⚄</i>Dado o sorteo</button><button type="button" class="case" data-mode="event"><i>◎</i>Evento repetido</button><button type="button" class="case" data-mode="combo"><i>▦</i>Combinatoria</button><button type="button" class="case" data-mode="binomial"><i>∑</i>Binomial</button><button type="button" class="case" data-mode="normal"><i>⌒</i>Campana normal</button></div><div class="label">Tus datos</div><div class="fields">
<div class="field draw"><label>Qué querés sortear</label><select id="drawType"><option value="6">Dado de 6 caras</option><option value="12">Dado de 12 caras</option><option value="20">Dado de 20 caras</option><option value="2">Moneda</option><option value="custom">Rango a medida</option></select></div><div class="field draw"><label>Cantidad de resultados</label><input id="drawCount" value="1"></div><div class="field draw custom hide"><label>Mínimo</label><input id="min" value="1"></div><div class="field draw custom hide"><label>Máximo</label><input id="max" value="100"></div><div class="field draw"><label>¿Sin repetir?</label><select id="unique"><option value="no">Se pueden repetir</option><option value="yes">Todos distintos</option></select></div>
<div class="field event hide"><label>Casos favorables</label><input id="fav" value="1"></div><div class="field event hide"><label>Casos posibles</label><input id="possible" value="100"></div><div class="field event hide"><label>O probabilidad directa (%)</label><input id="direct" value="0"></div><div class="field event hide"><label>Número de intentos</label><input id="attempts" value="10"></div>
<div class="field combo hide wide"><label>Tipo de conteo</label><select id="countType"><option value="comb">Combinación · el orden no importa</option><option value="perm">Permutación · el orden importa</option><option value="combRep">Combinación con repetición</option><option value="permRep">Permutación con repetición</option><option value="fact">Factorial n!</option></select></div><div class="field combo hide"><label>n · elementos disponibles</label><input id="n" value="45"></div><div class="field combo hide"><label>r · elementos elegidos</label><input id="r" value="6"></div>
<div class="field binomial hide"><label>n · cantidad de ensayos</label><input id="trials" value="10"></div><div class="field binomial hide"><label>k · éxitos exactos</label><input id="successes" value="5"></div><div class="field binomial hide wide"><label>p · probabilidad por ensayo (%)</label><input id="p" value="50"></div>
<div class="field normal hide"><label>Media μ</label><input id="mean" value="100"></div><div class="field normal hide"><label>Desvío estándar σ</label><input id="sd" value="15"></div><div class="field normal hide"><label>Límite inferior</label><input id="lower" value="85"></div><div class="field normal hide"><label>Límite superior</label><input id="upper" value="115"></div></div>
<section class="result"><div class="result-top"><div><small id="result-label">RESULTADO DEL SORTEO</small><div class="value" id="result">—</div></div><div class="badge"><small id="badge-label">Chance por valor</small><b id="badge">16,67%</b></div></div><div class="stats"><span id="s1l">VALORES POSIBLES<b id="s1">6</b></span><span id="s2l">PROMEDIO TEÓRICO<b id="s2">3,5</b></span><span id="s3l">MODALIDAD<b id="s3">Con repetidos</b></span></div><button class="go" id="update" type="button">Sortear de nuevo</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span id="visual-kicker">Todo el espacio posible</span><h2 id="visual-title">Cómo se reparte la probabilidad</h2><p id="visual-copy">En un dado justo, cada cara ocupa exactamente la misma parte del total.</p></header><div class="probbar"><div class="bar"><i class="success" id="bar1">Resultado</i><i class="failure" id="bar2">Resto</i><i class="neutral" id="bar3">Referencia</i><i class="other" id="bar4">Otros</i></div><div class="legend"><span id="l1p">FAVORABLE<b id="l1">16,67%</b></span><span id="l2p">NO FAVORABLE<b id="l2">83,33%</b></span><span id="l3p">TOTAL<b id="l3">100%</b></span><span id="l4p">LECTURA<b id="l4">1 entre 6</b></span></div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3 id="detail-title">La cuenta, línea por línea</h3><div class="line"><span id="d1l">Resultados posibles</span><b id="d1">6</b></div><div class="line"><span id="d2l">Casos favorables</span><b id="d2">1</b></div><div class="line"><span id="d3l">Fórmula</span><b id="d3">1 ÷ 6</b></div><div class="line"><span id="d4l">Complemento</span><b id="d4">83,33%</b></div><div class="line total"><strong id="d5l">Probabilidad</strong><b id="d5">16,67%</b></div></article><article class="card"><h3>Antes de usar la fórmula</h3><div class="rule"><i>1</i><div><b>Definí el experimento</b><span>Qué resultados son posibles y cuál cuenta como éxito.</span></div></div><div class="rule"><i>2</i><div><b>Revisá independencia</b><span>Sin reposición o con “piedad”, la chance cambia entre intentos.</span></div></div><div class="rule"><i>3</i><div><b>Elegí la pregunta exacta</b><span>“Exactamente”, “al menos” y “como máximo” no son lo mismo.</span></div></div><div class="warning">Azar no significa compensación. Una mala racha no obliga al próximo intento a salir bien.</div></article></div></section>
<section class="concepts"><div class="wrap"><header class="center"><span>Cinco preguntas distintas</span><h2>Elegí el modelo antes de calcular</h2></header><div class="conceptgrid"><article class="concept"><i>⚄</i><h3>Sorteo uniforme</h3><p>Todos los valores tienen la misma chance.</p><em>Dados y rifas</em></article><article class="concept"><i>◎</i><h3>Evento repetido</h3><p>Chance de que ocurra al menos una vez.</p><em>1 − (1 − p)ⁿ</em></article><article class="concept"><i>▦</i><h3>Combinatoria</h3><p>Cuántas formas hay de elegir u ordenar.</p><em>C(n,r) o P(n,r)</em></article><article class="concept"><i>∑</i><h3>Binomial</h3><p>Exactamente k éxitos en n ensayos.</p><em>Ensayos independientes</em></article><article class="concept"><i>⌒</i><h3>Distribución normal</h3><p>Área de la campana entre dos límites.</p><em>Media y desvío</em></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#9fcef0">La idea fundamental</span><h2>La probabilidad siempre vive entre cero y uno.</h2><p>Puede escribirse como decimal, fracción o porcentaje. Cambia la forma, no la chance.</p></div><div class="formula">casos favorables<span>÷ casos posibles</span>= probabilidad<small>Siempre que todos los resultados elementales sean igual de probables.</small></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-probabilidad')?document.currentScript.previousElementSibling:document.querySelector('.mockup-probabilidad');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),num=id=>Number($(id).value)||0,fmt=(x,d=2)=>Number(x||0).toLocaleString("es-AR",{minimumFractionDigits:d,maximumFractionDigits:d}),pct=x=>fmt(x*100,2)+"%";let mode="draw";
function txt(id,v){$("#"+id).textContent=v}function stats(labels,vals){["s1l","s2l","s3l"].forEach((id,i)=>{$("#"+id).childNodes[0].nodeValue=labels[i];txt("s"+(i+1),vals[i])})}function details(title,rows){txt("detail-title",title);rows.forEach((r,i)=>{txt("d"+(i+1)+"l",r[0]);txt("d"+(i+1),r[1])})}
function visual(k,t,c,vals,labels,out){txt("visual-kicker",k);txt("visual-title",t);txt("visual-copy",c);labels.forEach((x,i)=>{$("#l"+(i+1)+"p").childNodes[0].nodeValue=x;txt("l"+(i+1),out[i])});let total=Math.max(.000001,vals.reduce((a,b)=>a+Math.abs(b),0));vals.forEach((v,i)=>$("#bar"+(i+1)).style.width=Math.max(1,Math.abs(v)/total*100)+"%")}
function choose(n,r){if(r<0||r>n)return 0n;r=Math.min(r,n-r);let v=1n;for(let i=1;i<=r;i++)v=v*BigInt(n-r+i)/BigInt(i);return v}function perm(n,r){if(r<0||r>n)return 0n;let v=1n;for(let i=0;i<r;i++)v*=BigInt(n-i);return v}function fact(n){let v=1n;for(let i=2;i<=n;i++)v*=BigInt(i);return v}function combNum(n,k){if(k<0||k>n)return 0;let r=1;for(let i=1;i<=k;i++)r=r*(n-k+i)/i;return r}function binProb(n,k,p){return combNum(n,k)*Math.pow(p,k)*Math.pow(1-p,n-k)}function erf(x){let s=x<0?-1:1,a=Math.abs(x),t=1/(1+.3275911*a);return s*(1-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-.284496736)*t+.254829592)*t*Math.exp(-a*a))}function cdf(x){return .5*(1+erf(x/Math.SQRT2))}
function calc(){if(mode==="draw"){let type=$("#drawType").value,min=1,max=type==="custom"?Math.trunc(num("#max")):Number(type),count=Math.max(1,Math.trunc(num("#drawCount"))),unique=$("#unique").value==="yes";if(type==="custom")min=Math.trunc(num("#min"));if(max<min)[min,max]=[max,min];let possible=max-min+1;if(unique)count=Math.min(count,possible);let pool=Array.from({length:possible},(_,i)=>min+i),res=[];for(let i=0;i<count;i++){let ix=Math.floor(Math.random()*pool.length);res.push(pool[ix]);if(unique)pool.splice(ix,1)}let labels=type==="2"?res.map(x=>x===1?"Cara":"Cruz"):res.map(String),p=1/possible;txt("result-label","RESULTADO DEL SORTEO");txt("result",labels.join(", "));txt("badge-label","Chance por valor");txt("badge",pct(p));stats(["VALORES POSIBLES","PROMEDIO TEÓRICO","MODALIDAD"],[possible.toLocaleString("es-AR"),fmt((min+max)/2,1),unique?"Sin repetir":"Con repetidos"]);details("El sorteo, línea por línea",[["Rango",min+" a "+max],["Resultados pedidos",count.toString()],["Valores posibles",possible.toString()],["Probabilidad por valor","1 ÷ "+possible],["Resultado",labels.join(", ")]]);visual("Todo el espacio posible","Cómo se reparte la probabilidad","Cada valor del rango tiene exactamente la misma porción del total.",[p,1-p,0,0],["UN VALOR","RESTO DE VALORES","TOTAL","LECTURA"],[pct(p),pct(1-p),"100%","1 entre "+possible]);txt("art-label","PROBABILIDAD POR VALOR");txt("art-value",pct(p));txt("art-copy","1 resultado entre "+possible+" posibles");return}
if(mode==="event"){let direct=Math.max(0,num("#direct")),fav=Math.max(0,num("#fav")),possible=Math.max(1,num("#possible")),p=direct>0?Math.min(100,direct)/100:Math.min(fav,possible)/possible,n=Math.max(1,Math.floor(num("#attempts"))),none=Math.pow(1-p,n),some=1-none,i50=p>=1?1:Math.ceil(Math.log(.5)/Math.log(1-p)),i90=p>=1?1:Math.ceil(Math.log(.1)/Math.log(1-p));txt("result-label","AL MENOS UNA VEZ");txt("result",pct(some));txt("badge-label","Chance por intento");txt("badge",pct(p));stats(["QUE NO OCURRA","INTENTOS PARA 50%","INTENTOS PARA 90%"],[pct(none),i50.toLocaleString("es-AR"),i90.toLocaleString("es-AR")]);details("Tu evento, línea por línea",[["Probabilidad individual",pct(p)],["Intentos",n.toString()],["Que no ocurra",pct(none)],["Fórmula","1 − (1 − p)ⁿ"],["Al menos una vez",pct(some)]]);visual("Intentos acumulados","Ocurre o no ocurre","La probabilidad acumulada crece, pero cada intento individual conserva la misma chance.",[some,none,0,0],["AL MENOS UNA VEZ","NINGUNA VEZ","ESPERADOS","CHANCE INDIVIDUAL"],[pct(some),pct(none),fmt(n*p,2),pct(p)]);return}
if(mode==="combo"){let n=Math.max(0,Math.min(170,Math.floor(num("#n")))),r=Math.max(0,Math.floor(num("#r"))),type=$("#countType").value,big,formula;if(type==="fact"){big=fact(n);formula=n+"!"}else if(type==="perm"){big=perm(n,r);formula="n! ÷ (n−r)!"}else if(type==="combRep"){big=choose(n+r-1,r);formula="C(n+r−1,r)"}else if(type==="permRep"){big=BigInt(n)**BigInt(r);formula="nʳ"}else{big=choose(n,r);formula="n! ÷ r!(n−r)!"}let out=big.toString().replace(/\B(?=(\d{3})+(?!\d))/g,"."),chance=big>0n?1/Number(big):0;txt("result-label","CANTIDAD DE FORMAS");txt("result",out);txt("badge-label","Chance de una forma");txt("badge",chance>0?pct(chance):"—");stats(["n DISPONIBLES","r ELEGIDOS","¿IMPORTA EL ORDEN?"],[n.toString(),r.toString(),type==="perm"||type==="permRep"||type==="fact"?"Sí":"No"]);details("Tu conteo, línea por línea",[["Elementos disponibles",n.toString()],["Elementos elegidos",r.toString()],["Tipo",$("#countType").selectedOptions[0].textContent],["Fórmula",formula],["Formas posibles",out]]);visual("Contar antes de dividir","El universo de resultados","La probabilidad de acertar una opción puntual es uno sobre el conteo total.",[1,Math.min(999,Number(big)-1),0,0],["UNA FORMA","OTRAS FORMAS","TOTAL","CHANCE"],["1",out,out,chance>0?pct(chance):"—"]);return}
if(mode==="binomial"){let n=Math.max(1,Math.floor(num("#trials"))),k=Math.max(0,Math.min(n,Math.floor(num("#successes")))),p=Math.max(0,Math.min(100,num("#p")))/100,exact=binProb(n,k,p),less=0;for(let i=0;i<k;i++)less+=binProb(n,i,p);let more=Math.max(0,1-less-exact),expected=n*p,sd=Math.sqrt(n*p*(1-p));txt("result-label","EXACTAMENTE "+k+" ÉXITOS");txt("result",pct(exact));txt("badge-label","Valor esperado");txt("badge",fmt(expected,2)+" éxitos");stats(["MENOS DE k","EXACTAMENTE k","MÁS DE k"],[pct(less),pct(exact),pct(more)]);details("Tu binomial, línea por línea",[["Ensayos",n.toString()],["Probabilidad por ensayo",pct(p)],["Éxitos exactos",k.toString()],["Desvío estándar",fmt(sd,2)],["P(X = k)",pct(exact)]]);visual("Tres zonas que suman 100%","Menos, exactamente y más","La distribución reparte todos los resultados posibles alrededor del valor esperado.",[less,exact,more,0],["MENOS DE k","EXACTAMENTE k","MÁS DE k","VALOR ESPERADO"],[pct(less),pct(exact),pct(more),fmt(expected,2)]);return}
let mean=num("#mean"),sd=Math.abs(num("#sd"))||1,a=num("#lower"),b=num("#upper");if(a>b)[a,b]=[b,a];let za=(a-mean)/sd,zb=(b-mean)/sd,left=cdf(za),inside=cdf(zb)-left,right=1-cdf(zb);txt("result-label","ÁREA ENTRE LOS LÍMITES");txt("result",pct(inside));txt("badge-label","Intervalo en z");txt("badge",fmt(za,2)+" a "+fmt(zb,2));stats(["COLA IZQUIERDA","DENTRO DEL INTERVALO","COLA DERECHA"],[pct(left),pct(inside),pct(right)]);details("Tu campana, línea por línea",[["Media μ",fmt(mean,2)],["Desvío σ",fmt(sd,2)],["Límite inferior · z",a+" · "+fmt(za,2)],["Límite superior · z",b+" · "+fmt(zb,2)],["Área central",pct(inside)]]);visual("Toda el área bajo la curva","Qué queda dentro y fuera","Las dos colas y el intervalo central suman el 100% de la distribución.",[left,inside,right,0],["COLA IZQUIERDA","INTERVALO","COLA DERECHA","TOTAL"],[pct(left),pct(inside),pct(right),"100%"])}
function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$$(".field.draw,.field.event,.field.combo,.field.binomial,.field.normal").forEach(x=>x.classList.toggle("hide",!x.classList.contains(m)));if(m==="draw"){$$(".custom").forEach(x=>x.classList.toggle("hide",$("#drawType").value!=="custom"));txt("update","Sortear de nuevo")}else txt("update","Actualizar cálculo");calc()}
$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=()=>{if(i.id==="drawType")$$(".custom").forEach(x=>x.classList.toggle("hide",i.value!=="custom"));calc()});$("#update").onclick=e=>{calc();let t=mode==="draw"?"✓ Nuevo sorteo":"✓ Cálculo actualizado";e.currentTarget.textContent=t;setTimeout(()=>e.currentTarget.textContent=mode==="draw"?"Sortear de nuevo":"Actualizar cálculo",1200)};setMode("draw");

})();
</script>
<style is:global>

.mockup-probabilidad *{box-sizing:border-box}.mockup-probabilidad{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:#13243b;background:#fff}.mockup-probabilidad button,.mockup-probabilidad input,.mockup-probabilidad select{font:inherit}.mockup-probabilidad .wrap{width:min(1180px,calc(100% - 40px));margin:auto}.mockup-probabilidad .top{height:82px;border-bottom:1px solid #e0e6ea;display:flex;align-items:center}.mockup-probabilidad .nav{display:flex;align-items:center;justify-content:space-between}.mockup-probabilidad .brand{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:900}.mockup-probabilidad .logo{width:31px;height:31px;border-radius:8px;background:#183653;color:#fff;display:grid;place-items:center;font-size:12px}.mockup-probabilidad .links,.mockup-probabilidad .tools{display:flex;align-items:center;gap:25px}.mockup-probabilidad .links span{font-size:12px;font-weight:750;color:#526276}.mockup-probabilidad .tools span{border:1px solid #dbe3e8;border-radius:10px;padding:10px 13px;font-size:11px}.mockup-probabilidad .tools .dark{background:#183653;color:#fff}
