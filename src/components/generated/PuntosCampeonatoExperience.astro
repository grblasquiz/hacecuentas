---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-puntos-campeonato" set:html={`<section class="score-hero"><div class="hero-grid"><div><div class="crumb">Fútbol / Puntos y campeonato</div><div class="eyebrow">Simulador de definición</div><h1>Probá el fixture. Mirá qué necesita tu equipo.</h1><p class="lead">Elegí resultados de las fechas que faltan y la tabla se actualiza. Ves si depende de sí mismo, de otros o del desempate.</p></div><div class="scoreboard"><small>TABLA EN VIVO · FECHA 26</small><div class="scoreline"><span>1. Deportivo Norte</span><b id="heroLeader">66</b></div><div class="scoreline"><span>2. Tu equipo</span><b id="heroYou">62</b></div></div></div></section>
<section class="season"><div class="season-grid"><aside class="table-card"><h2>Tabla proyectada</h2><div class="table-head"><span>#</span><span>EQUIPO</span><span>PTS</span><span>DG</span></div><div id="standings"></div><div class="controls"><div class="control"><label for="youPoints"><span>TUS PUNTOS ACTUALES</span><span id="youOut">62</span></label><input id="youPoints" type="number" value="62" min="0" max="150"></div><div class="control"><label for="leaderPoints"><span>PUNTOS DEL LÍDER</span><span id="leaderOut">66</span></label><input id="leaderPoints" type="number" value="66" min="0" max="150"></div><div class="control"><label for="goalDiff"><span>TU DIFERENCIA DE GOL</span><span id="goalOut">12</span></label><input id="goalDiff" type="number" value="12" min="-100" max="100"></div></div></aside><section class="fixture"><div class="fixture-head"><div><div class="kicker">Cuatro fechas por jugar</div><h2>Armá el cierre</h2></div><span class="scenario" id="scenario">Escenario: 8 puntos</span></div><div class="matches" id="matches"></div><div class="outcome"><div class="path"><small>RESULTADO DEL ESCENARIO</small><strong id="pathTitle">Llega con chances</strong><p id="pathText">Tu equipo termina con 70 puntos. Necesita que el líder deje al menos 1 punto.</p></div><div class="chances"><small>MÁXIMO POSIBLE</small><strong id="maximum">74 pts</strong><p id="chanceText">Todavía puede superar al líder actual.</p></div></div></section></div></section>
<section class="combinations"><div class="wrap comb-grid"><div><div class="kicker">Cómo leer el escenario</div><h2>No alcanza con contar victorias</h2><p>Importan los puntos que deja el rival y el criterio de desempate del torneo.</p></div><div class="cards"><div class="card"><b>Depende de sí mismo</b><span>Ocurre si ganando todos sus partidos supera el máximo que puede lograr el rival directo.</span></div><div class="card"><b>Necesita resultados</b><span>Puede llegar, pero requiere que el líder empate o pierda cierta cantidad de puntos.</span></div><div class="card"><b>Va a desempate</b><span>Si igualan puntos, revisá diferencia de gol, goles a favor o enfrentamientos según el reglamento.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-puntos-campeonato')?document.currentScript.previousElementSibling:document.querySelector('.mockup-puntos-campeonato');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let results=["W","D","W","D"];const rivals=["Atlético Sur","Unión Central","Racing del Oeste","Deportivo Norte"];function renderMatches(){$("#matches").innerHTML=rivals.map((r,i)=>`<article class="match"><span class="date">F${27+i}</span><div><strong>Tu equipo vs. ${r}</strong><small>${i%2?"Visitante":"Local"} · resultado proyectado</small></div><div class="result-buttons" data-i="${i}"><button data-r="W" class="${results[i]==="W"?"active":""}">G</button><button data-r="D" class="${results[i]==="D"?"active":""}">E</button><button data-r="L" class="${results[i]==="L"?"active":""}">P</button></div></article>`).join("");$$(".result-buttons").forEach(g=>g.querySelectorAll("button").forEach(b=>b.addEventListener("click",()=>{results[+g.dataset.i]=b.dataset.r;renderMatches();calculate()})))}function calculate(){const you=+$("#youPoints").value||0,leader=+$("#leaderPoints").value||0,dg=+$("#goalDiff").value||0,gained=results.reduce((s,r)=>s+(r==="W"?3:r==="D"?1:0),0),projected=you+gained,max=you+12,gap=Math.max(0,projected-leader),need=Math.max(0,projected>leader?0:leader-projected+1);$("#youOut").textContent=you;$("#leaderOut").textContent=leader;$("#goalOut").textContent=dg;$("#heroYou").textContent=you;$("#heroLeader").textContent=leader;$("#scenario").textContent="Escenario: "+gained+" puntos";$("#maximum").textContent=max+" pts";let title,text;if(projected>leader){title="Termina arriba hoy";text=`Tu equipo llega a ${projected} puntos y supera la línea actual del líder por ${gap}.`}else if(max>leader){title="Llega con chances";text=`Tu equipo termina con ${projected} puntos. Necesita que el líder deje al menos ${need} ${need===1?"punto":"puntos"}.`}else if(max===leader){title="Sólo puede igualar";text=`El máximo es ${max}. El desempate puede definir el campeonato.`}else{title="Ya no alcanza";text=`Aun ganando todo, llega a ${max} y queda debajo del líder actual.`}$("#pathTitle").textContent=title;$("#pathText").textContent=text;$("#chanceText").textContent=max>leader?"Todavía puede superar al líder actual.":max===leader?"El desempate es la única vía.":"No llega con los partidos restantes.";const teams=[["Deportivo Norte",leader,18,"#d39a3c"],["Tu equipo",projected,dg,"#2f8065"],["Unión Central",60,9,"#6f63a0"],["Atlético Sur",58,4,"#b85c52"]].sort((a,b)=>b[1]-a[1]||b[2]-a[2]);$("#standings").innerHTML=teams.map((t,i)=>`<div class="team ${t[0]==="Tu equipo"?"you":""}"><span class="pos">${i+1}</span><span style="display:flex;align-items:center;gap:7px"><i style="--c:${t[3]}"></i>${t[0]}</span><b>${t[1]}</b><b>${t[2]}</b></div>`).join("")}renderMatches();$$("input").forEach(x=>x.addEventListener("input",calculate));calculate()})();
})();
</script>
<style is:global>

.mockup-puntos-campeonato{--blue:#174b7a;--green:#24765d;--pitch:#e9f4ed;--gold:#d99c32;--ink:#172331;--muted:#5f6977;--line:#d9e2e4;--red:#ac4d47}.mockup-puntos-campeonato *{box-sizing:border-box}.mockup-puntos-campeonato{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#f6f8f6}.mockup-puntos-campeonato button,.mockup-puntos-campeonato input{font:inherit}.mockup-puntos-campeonato .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:28px;background:#fff;border-bottom:1px solid var(--line)}.mockup-puntos-campeonato .brand{font-size:19px;font-weight:950}.mockup-puntos-campeonato .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-puntos-campeonato .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-puntos-campeonato .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-puntos-campeonato .score-hero{padding:38px 22px 42px;background:linear-gradient(120deg,#fff 0 60%,var(--pitch) 60%)}.mockup-puntos-campeonato .hero-grid,.mockup-puntos-campeonato .wrap{max-width:1180px;margin:auto}.mockup-puntos-campeonato .hero-grid{display:grid;grid-template-columns:1fr .8fr;gap:55px;align-items:center}.mockup-puntos-campeonato .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-puntos-campeonato .eyebrow{margin-top:25px;color:var(--green);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-puntos-campeonato .score-hero h1{font-size:clamp(43px,5vw,65px);line-height:.98;letter-spacing:-.05em;margin:9px 0 18px}.mockup-puntos-campeonato .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-puntos-campeonato .scoreboard{background:#183b31;color:#fff;border:10px solid #fff;outline:2px solid #6c9b83;border-radius:12px;padding:23px;box-shadow:0 25px 45px #19352b24}.mockup-puntos-campeonato .scoreboard small{display:block;color:#bfe0d0;letter-spacing:.12em;font-weight:900}.mockup-puntos-campeonato .scoreline{display:grid;grid-template-columns:1fr 55px;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid #ffffff21}.mockup-puntos-campeonato .scoreline:last-child{border:0}.mockup-puntos-campeonato .scoreline span{font-weight:900}.mockup-puntos-campeonato .scoreline b{display:grid;place-items:center;background:#102b24;height:44px;font-size:25px}.mockup-puntos-campeonato .season{padding:55px 22px 68px}.mockup-puntos-campeonato .season-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:300px 1fr;gap:20px;align-items:start}.mockup-puntos-campeonato .table-card{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;position:sticky;top:16px}.mockup-puntos-campeonato .table-card h2{font-size:18px;margin:0;padding:18px 20px;border-bottom:1px solid var(--line)}.mockup-puntos-campeonato .table-head,.mockup-puntos-campeonato .team{display:grid;grid-template-columns:28px 1fr 38px 38px;gap:7px;align-items:center;padding:10px 15px}.mockup-puntos-campeonato .table-head{font-size:9px;color:var(--muted);background:#f2f5f3;font-weight:900}.mockup-puntos-campeonato .team{border-top:1px solid #edf0ef;font-size:12px}.mockup-puntos-campeonato .team.you{background:#edf7f1;border-left:5px solid var(--green);padding-left:10px}.mockup-puntos-campeonato .team i{width:22px;height:22px;border-radius:50%;background:var(--c);display:block}.mockup-puntos-campeonato .team b{text-align:center}.mockup-puntos-campeonato .team .pos{color:var(--muted)}.mockup-puntos-campeonato .controls{padding:17px 20px;border-top:1px solid var(--line)}.mockup-puntos-campeonato .control{margin:12px 0}.mockup-puntos-campeonato .control label{display:flex;justify-content:space-between;font-size:11px;font-weight:900;margin-bottom:6px}.mockup-puntos-campeonato .control input{width:100%;border:1px solid #ccd7da;border-radius:9px;padding:9px 10px}.mockup-puntos-campeonato .fixture{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px}.mockup-puntos-campeonato .fixture-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:20px}.mockup-puntos-campeonato .kicker{color:var(--green);text-transform:uppercase;letter-spacing:.14em;font-size:11px;font-weight:950}.mockup-puntos-campeonato .fixture h2{font-size:30px;letter-spacing:-.04em;margin:5px 0}.mockup-puntos-campeonato .scenario{padding:7px 10px;border-radius:99px;background:#e3f1e9;color:#174f40;font-size:11px;font-weight:900}.mockup-puntos-campeonato .matches{display:grid;gap:10px}.mockup-puntos-campeonato .match{display:grid;grid-template-columns:42px 1fr auto;gap:12px;align-items:center;padding:14px;border:1px solid var(--line);border-radius:13px}.mockup-puntos-campeonato .date{display:grid;place-items:center;width:40px;height:40px;border-radius:10px;background:#f0f4f2;color:var(--green);font-size:11px;font-weight:950}.mockup-puntos-campeonato .match strong,.mockup-puntos-campeonato .match small{display:block}.mockup-puntos-campeonato .match small{color:var(--muted);font-size:10px}.mockup-puntos-campeonato .result-buttons{display:flex;gap:5px}.mockup-puntos-campeonato .result-buttons button{width:36px;height:34px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);font-weight:950;cursor:pointer}.mockup-puntos-campeonato .result-buttons button.active{background:var(--blue);border-color:var(--blue);color:#fff}.mockup-puntos-campeonato .outcome{margin-top:20px;display:grid;grid-template-columns:1.2fr .8fr;gap:12px}.mockup-puntos-campeonato .path{padding:18px;border-radius:15px;background:var(--blue);color:#fff}.mockup-puntos-campeonato .path small{display:block;color:#dceaf0;font-size:10px}.mockup-puntos-campeonato .path strong{display:block;font-size:30px;line-height:1;margin:7px 0}.mockup-puntos-campeonato .path p{font-size:12px;color:#dceaf0;margin:0}.mockup-puntos-campeonato .chances{padding:18px;border:1px solid var(--line);border-radius:15px}.mockup-puntos-campeonato .chances small{display:block;color:var(--muted);font-size:10px}.mockup-puntos-campeonato .chances strong{display:block;font-size:30px;margin:7px 0}.mockup-puntos-campeonato .chances p{font-size:12px;color:var(--muted);margin:0}.mockup-puntos-campeonato .combinations{padding:60px 22px;background:#edf4f0}.mockup-puntos-campeonato .comb-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:40px}.mockup-puntos-campeonato .combinations h2{font-size:35px;letter-spacing:-.04em;margin:6px 0}.mockup-puntos-campeonato .combinations p{color:var(--muted)}.mockup-puntos-campeonato .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-puntos-campeonato .card{padding:16px;background:#fff;border:1px solid var(--line);border-radius:14px}.mockup-puntos-campeonato .card b{display:block;color:var(--green);margin-bottom:5px}.mockup-puntos-campeonato .card span{font-size:12px;color:var(--muted)}.mockup-puntos-campeonato .foot{padding:30px;text-align:center;background:#fff;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-puntos-campeonato .nav{display:none}.mockup-puntos-campeonato .hero-grid,.mockup-puntos-campeonato .season-grid,.mockup-puntos-campeonato .comb-grid{grid-template-columns:1fr}.mockup-puntos-campeonato .table-card{position:static}.mockup-puntos-campeonato .outcome{grid-template-columns:1fr}}@media(max-width:560px){.mockup-puntos-campeonato .score-hero h1{font-size:42px}.mockup-puntos-campeonato .match{grid-template-columns:42px 1fr}.mockup-puntos-campeonato .result-buttons{grid-column:2}.mockup-puntos-campeonato .cards{grid-template-columns:1fr}}

.mockup-puntos-campeonato { width:100%; overflow:hidden; }
.mockup-puntos-campeonato .top, .mockup-puntos-campeonato header.top { display:none !important; }
.mockup-puntos-campeonato .foot { display:none !important; }
.mockup-puntos-campeonato .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-puntos-campeonato .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-puntos-campeonato .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-puntos-campeonato .support-real summary { cursor:pointer; font-weight:750; }
.mockup-puntos-campeonato .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-puntos-campeonato :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-puntos-campeonato input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-puntos-campeonato input[type="number"]::-webkit-inner-spin-button, .mockup-puntos-campeonato input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-puntos-campeonato .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-puntos-campeonato support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
