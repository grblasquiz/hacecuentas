---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-edad-perro" set:html={`<div class="wrap hero"><div><div class="crumb">Mascotas / Edad del perro</div><div class="eyebrow">Su edad no se multiplica por siete</div><h1>Entendé en qué momento de su vida está.</h1><p class="lead">Convertí su edad a años humanos según tamaño y descubrí su etapa, expectativa y cuidados recomendados.</p><div class="chips"><span class="chip">✓ Tabla AAHA / AKC</span><span class="chip">✓ Ajuste por tamaño</span><span class="chip">✓ Etapa de vida</span></div></div><div class="visual"><div class="dog"><div class="face"><div class="eye a"></div><div class="eye b"></div><div class="snout"></div><div class="nose"></div><div class="tongue"></div><div class="collar"></div><div class="tag"></div></div></div><div class="age-bubble"><div><b id="heroAge">49</b><small>AÑOS HUMANOS</small></div></div><div class="paws">● ●</div></div></div>
<div class="wrap"><form class="calc" id="calculator"><div class="case-label">¿QUÉ TAMAÑO TIENE DE ADULTO?</div><div class="sizes"><button type="button" class="size" data-size="toy"><span>•</span>Toy<br>&lt; 5 kg</button><button type="button" class="size" data-size="small"><span>●</span>Pequeño<br>5–10 kg</button><button type="button" class="size active" data-size="medium"><span>●</span>Mediano<br>10–25 kg</button><button type="button" class="size" data-size="large"><span>⬤</span>Grande<br>25–45 kg</button><button type="button" class="size" data-size="giant"><span>⬤</span>Gigante<br>&gt; 45 kg</button></div>
<div class="grid"><div class="panel"><h2>Contame sobre tu perro</h2><p class="hint">Si elegís una raza conocida, corregimos automáticamente el tamaño.</p><div class="fields"><div class="field"><label for="dogAge">Edad (años)</label><input class="control age-input" id="dogAge" type="number" value="7" min=".1" max="25" step=".1"></div><div class="field"><label for="breed">Raza</label><select class="control" id="breed"><option value="">Mestizo o no la sé</option><option value="labrador,large,12">Labrador Retriever</option><option value="golden,large,11">Golden Retriever</option><option value="french,small,11">Bulldog Francés</option><option value="german,large,10">Pastor Alemán</option><option value="beagle,medium,13">Beagle</option><option value="poodle,small,15">Caniche / Poodle</option><option value="chihuahua,toy,16">Chihuahua</option><option value="rottweiler,giant,9">Rottweiler</option><option value="yorkshire,toy,15">Yorkshire Terrier</option><option value="boxer,large,10">Boxer</option><option value="dachshund,small,14">Dachshund</option><option value="husky,large,12">Husky Siberiano</option></select></div><div class="field"><label for="neutered">Castrado o esterilizado</label><select class="control" id="neutered"><option value=".8">Sí</option><option value="0">No</option></select></div><div class="field"><label for="care">Nivel de cuidados</label><select class="control" id="care"><option value="1">Altos · controles y peso ideal</option><option value="0" selected>Medios · habituales</option><option value="-1.5">Bajos · sobrepeso y pocos controles</option></select></div></div><button class="update" id="updateButton" type="button">Actualizar edad</button></div>
<div class="panel result"><div class="kicker">EQUIVALENCIA ESTIMADA</div><div class="big" id="resultValue">49 años humanos</div><div class="sub" id="resultSub">7 años reales · tamaño mediano · etapa adulta.</div><div class="badge" id="resultBadge">Todavía no llegó a senior</div><div class="tiles"><div class="tile"><small>Etapa</small><strong id="stageValue">Adulto</strong></div><div class="tile"><small>Senior desde</small><strong id="seniorValue">9 años</strong></div><div class="tile"><small>Expectativa</small><strong id="lifeValue">12,8 años</strong></div></div></div></div></form></div>
<section><div class="wrap"><div class="section-head"><div class="eyebrow">Su vida, etapa por etapa</div><h2 id="lifeTitle">Está en la etapa adulta.</h2><p>Los perros grandes envejecen antes; los pequeños suelen llegar más tarde a senior.</p></div><div class="life"><article class="stage" data-stage="Puppy"><i>1</i><h3>Cachorro</h3><p>Hasta 1 año. Crecimiento, vacunas y socialización.</p></article><article class="stage" data-stage="Young"><i>2</i><h3>Adulto joven</h3><p>De 1 a 3 años. Mucha energía y hábitos.</p></article><article class="stage active" data-stage="Adult"><i>3</i><h3>Adulto</h3><p>Control anual, peso estable y actividad.</p></article><article class="stage" data-stage="Senior"><i>4</i><h3>Senior</h3><p>Chequeos semestrales y detección temprana.</p></article><article class="stage" data-stage="Geriatric"><i>5</i><h3>Geronte</h3><p>Confort, movilidad y calidad de vida.</p></article></div></div></section>
<section class="care"><div class="wrap"><div class="section-head"><div class="eyebrow">Qué cambia en esta etapa</div><h2>La edad sirve para anticiparse, no para etiquetarlo.</h2></div><div class="care-grid"><article class="care-card"><h3>En casa</h3><div class="item"><span>⚖️</span><span>Controlá el peso una vez por mes.</span></div><div class="item"><span>🦷</span><span>Revisá dientes, encías y aliento.</span></div><div class="item"><span>🚶</span><span>Mantené actividad adaptada, no la elimines.</span></div></article><article class="care-card"><h3>Con el veterinario</h3><div class="item"><span>🩺</span><span id="checkFrequency">Control clínico anual.</span></div><div class="item"><span>💉</span><span>Vacunas y antiparasitarios al día.</span></div><div class="item"><span>🔬</span><span id="labAdvice">Laboratorio según antecedentes.</span></div></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><div class="eyebrow">Por qué ×7 no funciona</div><h2>El primer año vale quince, no siete.</h2><div class="rule"><strong id="rule">1 año = 15 · 2 años = 24 · luego cambia por tamaño</strong><p>Después de los dos años, cada año suma entre 4 y 7 años humanos.</p></div></div><div class="checks"><div class="check"><span class="tick">✓</span><span>Curva no lineal durante los primeros años.</span></div><div class="check"><span class="tick">✓</span><span>Tasa distinta según tamaño adulto.</span></div><div class="check"><span class="tick">✓</span><span>Raza y cuidados ajustan expectativa, no edad.</span></div><div class="check"><span class="tick">✓</span><span>Resultado orientativo, no pronóstico individual.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-edad-perro')?document.currentScript.previousElementSibling:document.querySelector('.mockup-edad-perro');

const $=id=>root.querySelector("#"+id),set=(id,v)=>$(id).textContent=v,fmt=n=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:1});let size="medium";const sizes={toy:{rate:4,senior:11,life:15,factor:.9,label:"toy"},small:{rate:4,senior:11,life:14,factor:.95,label:"pequeño"},medium:{rate:5,senior:9,life:12,factor:1,label:"mediano"},large:{rate:6,senior:8,life:10,factor:1.1,label:"grande"},giant:{rate:7,senior:6,life:8,factor:1.15,label:"gigante"}};function human(age,rate){if(age<=1)return age*15;if(age<=2)return 15+(age-1)*9;return 24+(age-2)*rate}
function calculate(){let age=Math.max(.1,+$("dogAge").value||0),breed=$("breed").value.split(","),chosen=breed.length>1?breed[1]:size,T=sizes[chosen],baseLife=breed.length>2?+breed[2]:T.life,life=Math.max(T.senior+1,baseLife+(+$("neutered").value||0)+(+$("care").value||0)),h=Math.round(human(age,T.rate)),stage=age<1?"Puppy":age<3?"Young":age<T.senior?"Adult":age<life?"Senior":"Geriatric",labels={Puppy:"Cachorro",Young:"Adulto joven",Adult:"Adulto",Senior:"Senior",Geriatric:"Geronte"},phrases={Puppy:"cachorro",Young:"adulta joven",Adult:"adulta",Senior:"senior",Geriatric:"geronte"};set("resultValue",h+" años humanos");set("resultSub",`${fmt(age)} años reales · tamaño ${T.label} · etapa ${phrases[stage]}.`);set("resultBadge",age<T.senior?`Llega a senior cerca de los ${T.senior} años`:stage==="Senior"?"Ya está en etapa senior":"Superó la expectativa media");set("stageValue",labels[stage]);set("seniorValue",T.senior+" años");set("lifeValue",fmt(life)+" años");set("heroAge",h);set("lifeTitle","Está en la etapa "+phrases[stage]+".");root.querySelectorAll(".stage").forEach(x=>x.classList.toggle("active",x.dataset.stage===stage));set("checkFrequency",stage==="Senior"||stage==="Geriatric"?"Control clínico cada 6 meses.":"Control clínico anual.");set("labAdvice",stage==="Senior"||stage==="Geriatric"?"Laboratorio preventivo al menos anual.":"Laboratorio según antecedentes.");set("rule",`1 año = 15 · 2 años = 24 · luego +${T.rate} por año`)}
root.querySelectorAll(".size").forEach(b=>b.addEventListener("click",()=>{size=b.dataset.size;$("breed").value="";root.querySelectorAll(".size").forEach(x=>x.classList.toggle("active",x===b));calculate()}));$("breed").addEventListener("change",()=>{let parts=$("breed").value.split(",");if(parts.length>1){size=parts[1];root.querySelectorAll(".size").forEach(x=>x.classList.toggle("active",x.dataset.size===size))}calculate()});root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calculate));function confirmCalc(){calculate();set("updateButton","✓ Edad actualizada");clearTimeout(window.timer);window.timer=setTimeout(()=>set("updateButton","Actualizar edad"),5000)}$("updateButton").addEventListener("click",confirmCalc);$("calculator").addEventListener("submit",e=>{e.preventDefault();confirmCalc()});calculate();

})();
</script>
<style is:global>

.mockup-edad-perro{--ink:#111b33;--muted:#637085;--line:#dfe4ea;--bg:#f6f6f2;--blue:#286be7;--mint:#3fa98e;--amber:#efad45;--coral:#dd725f;--navy:#174B7A}.mockup-edad-perro *{box-sizing:border-box}.mockup-edad-perro{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.mockup-edad-perro .wrap{width:min(1160px,calc(100% - 40px));margin:auto}.mockup-edad-perro header{height:86px;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-edad-perro .nav{display:flex;align-items:center;gap:28px}.mockup-edad-perro .logo{width:28px;height:35px;border-radius:4px;background:var(--navy);color:#fff;display:grid;place-items:center}.mockup-edad-perro .brand{font-size:18px;font-weight:950}.mockup-edad-perro .links{display:flex;gap:24px;color:#4e5a6c;font-size:13px;font-weight:800}.mockup-edad-perro .tools{margin-left:auto;display:flex;gap:8px}.mockup-edad-perro .tool{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px;font-weight:800}
.mockup-edad-perro .hero{display:grid;grid-template-columns:1.04fr .96fr;gap:48px;align-items:center;padding:62px 0 48px}.mockup-edad-perro .crumb{color:var(--blue);font-size:14px}.mockup-edad-perro .eyebrow{margin-top:18px;color:#187c77;font-size:12px;font-weight:950;letter-spacing:.13em;text-transform:uppercase}.mockup-edad-perro h1{font-size:clamp(46px,5.2vw,70px);line-height:.98;letter-spacing:-.055em;margin:11px 0 20px}.mockup-edad-perro .lead{font-size:18px;color:var(--muted);max-width:680px}.mockup-edad-perro .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-edad-perro .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:12px;font-weight:850}
.mockup-edad-perro .visual{height:350px;position:relative}.mockup-edad-perro .dog{position:absolute;left:85px;top:65px;width:260px;height:220px;background:#c88952;border-radius:48% 52% 42% 45%;box-shadow:0 22px 55px #26374b1d}.mockup-edad-perro .face{position:absolute;inset:0;z-index:2}.mockup-edad-perro .eye{position:absolute;top:75px;width:17px;height:20px;border-radius:50%;background:#1a2636}.mockup-edad-perro .eye.a{left:69px}.mockup-edad-perro .eye.b{right:69px}.mockup-edad-perro .snout{position:absolute;left:50%;top:111px;transform:translateX(-50%);width:92px;height:75px;border-radius:50%;background:#e3b27e}.mockup-edad-perro .nose{position:absolute;left:50%;top:108px;transform:translateX(-50%);width:39px;height:28px;border-radius:50%;background:#172437}.mockup-edad-perro .tongue{position:absolute;left:50%;top:161px;transform:translateX(-50%);width:39px;height:48px;background:#df766f;border-radius:6px 6px 25px 25px}.mockup-edad-perro .collar{position:absolute;left:22px;right:22px;bottom:23px;height:18px;background:#286be7;border-radius:9px}.mockup-edad-perro .tag{position:absolute;left:50%;bottom:-19px;transform:translateX(-50%);width:48px;height:48px;background:#efb04a;border:7px solid #fff;border-radius:50%;box-shadow:0 7px 18px #23354b2c}.mockup-edad-perro .age-bubble{position:absolute;right:5px;top:25px;width:145px;height:145px;border-radius:50%;background:#fff;border:13px solid #e9eef3;box-shadow:0 14px 38px #26374b25;display:grid;place-items:center;text-align:center}.mockup-edad-perro .age-bubble b{font-size:32px;line-height:1}.mockup-edad-perro .age-bubble small{display:block;color:#6d7a8c;font-size:9px;margin-top:4px}.mockup-edad-perro .paws{position:absolute;left:55px;bottom:2px;color:#d9a072;font-size:38px;letter-spacing:18px}
.mockup-edad-perro .calc{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:68px}.mockup-edad-perro .case-label{font-size:12px;font-weight:950;color:#5b6778;margin-bottom:11px}.mockup-edad-perro .sizes{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:25px}.mockup-edad-perro .size{border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:13px 7px;color:#505d70;font-size:11px;font-weight:900;cursor:pointer}.mockup-edad-perro .size span{display:block;font-size:21px;line-height:1;margin-bottom:6px}.mockup-edad-perro .size.active{background:#fff5ea;color:#9b6226;border-color:#e0a64b;box-shadow:inset 0 0 0 1px #e0a64b}.mockup-edad-perro .grid{display:grid;grid-template-columns:1.03fr .97fr;gap:23px}.mockup-edad-perro .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-edad-perro .panel h2{font-size:22px;margin:0 0 5px}.mockup-edad-perro .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-edad-perro .fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.mockup-edad-perro .field.full{grid-column:1/-1}.mockup-edad-perro .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-edad-perro .control{width:100%;height:50px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-edad-perro .control:focus{border-color:var(--blue);box-shadow:0 0 0 3px #286be718}.mockup-edad-perro .age-input{font-size:22px;font-weight:900}.mockup-edad-perro .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
.mockup-edad-perro .result{background:linear-gradient(145deg,#17365b,#0c203b);border:0;color:#fff;position:relative;overflow:hidden}.mockup-edad-perro .result:after{content:"";position:absolute;width:220px;height:220px;border:45px solid #e2a74c18;border-radius:50%;right:-125px;bottom:-130px}.mockup-edad-perro .kicker{font-size:11px;letter-spacing:.13em;color:#a5dfd5;font-weight:950}.mockup-edad-perro .big{font-size:46px;line-height:1.05;font-weight:950;letter-spacing:-.045em;margin:15px 0 7px}.mockup-edad-perro .sub{color:#c2d2e4}.mockup-edad-perro .badge{display:inline-flex;margin-top:16px;padding:8px 11px;border-radius:99px;background:#1e4777;border:1px solid #416992;font-size:12px;font-weight:850}.mockup-edad-perro .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}.mockup-edad-perro .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px;position:relative;z-index:1}.mockup-edad-perro .tile small{display:block;color:#b6c7db;text-transform:uppercase;font-size:9px;letter-spacing:.07em}.mockup-edad-perro .tile strong{display:block;margin-top:5px;font-size:14px}
.mockup-edad-perro section{padding:70px 0}.mockup-edad-perro .section-head{max-width:760px;margin-bottom:28px}.mockup-edad-perro .section-head h2,.mockup-edad-perro .dark h2{font-size:39px;line-height:1.05;letter-spacing:-.04em;margin:9px 0}.mockup-edad-perro .section-head p{font-size:17px;color:var(--muted)}.mockup-edad-perro .life{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.mockup-edad-perro .stage{background:#fff;border:1px solid var(--line);border-radius:18px;padding:19px}.mockup-edad-perro .stage i{display:block;width:37px;height:37px;border-radius:11px;background:#edf4ff;color:var(--blue);font-style:normal;font-weight:950;display:grid;place-items:center}.mockup-edad-perro .stage h3{margin:14px 0 5px}.mockup-edad-perro .stage p{color:var(--muted);font-size:12px;margin:0}.mockup-edad-perro .stage.active{background:#fff6e9;border-color:#e3b463}.mockup-edad-perro .care{background:#eef3f5;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.mockup-edad-perro .care-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.mockup-edad-perro .care-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px}.mockup-edad-perro .care-card h3{font-size:23px;margin:0 0 15px}.mockup-edad-perro .item{display:flex;gap:12px;padding:11px 0;border-top:1px solid #edf0f3}.mockup-edad-perro .item span:first-child{font-size:20px}.mockup-edad-perro .dark{background:#0c203d;color:#fff}.mockup-edad-perro .dark-grid{display:grid;grid-template-columns:1fr 1fr;gap:55px}.mockup-edad-perro .rule{border:1px solid #ffffff20;background:#ffffff09;border-radius:20px;padding:24px}.mockup-edad-perro .rule strong{font-size:26px}.mockup-edad-perro .rule p{color:#b8c9dc}.mockup-edad-perro .checks{display:grid;gap:12px}.mockup-edad-perro .check{display:flex;gap:12px;color:#d4e0ee}.mockup-edad-perro .tick{flex:0 0 26px;height:26px;border-radius:50%;background:#2eaa98;display:grid;place-items:center;color:#071d2c;font-weight:950}.mockup-edad-perro footer{padding:30px;text-align:center;color:#687589;font-size:12px;background:#fff}
@media(max-width:920px){.mockup-edad-perro .links{display:none}.mockup-edad-perro .hero,.mockup-edad-perro .grid,.mockup-edad-perro .dark-grid{grid-template-columns:1fr}.mockup-edad-perro .sizes,.mockup-edad-perro .life{grid-template-columns:repeat(3,1fr)}.mockup-edad-perro .visual{height:315px}.mockup-edad-perro .tiles{grid-template-columns:1fr}.mockup-edad-perro .care-grid{grid-template-columns:1fr}}@media(max-width:520px){.mockup-edad-perro .wrap{width:calc(100% - 24px)}.mockup-edad-perro header{height:70px}.mockup-edad-perro .tools .tool:first-child{display:none}.mockup-edad-perro h1{font-size:42px}.mockup-edad-perro .visual{transform:scale(.84);margin:-25px}.mockup-edad-perro .calc{padding:14px}.mockup-edad-perro .panel{padding:18px}.mockup-edad-perro .fields,.mockup-edad-perro .sizes,.mockup-edad-perro .life{grid-template-columns:1fr}.mockup-edad-perro .field.full{grid-column:auto}.mockup-edad-perro .section-head h2,.mockup-edad-perro .dark h2{font-size:32px}}

.mockup-edad-perro { width:100%; overflow:hidden; }
.mockup-edad-perro .top, .mockup-edad-perro header.top { display:none !important; }
.mockup-edad-perro .foot { display:none !important; }
.mockup-edad-perro .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-edad-perro .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-edad-perro .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-edad-perro .support-real summary { cursor:pointer; font-weight:750; }
.mockup-edad-perro .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-edad-perro :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-edad-perro input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-edad-perro input[type="number"]::-webkit-inner-spin-button, .mockup-edad-perro input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-edad-perro .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-edad-perro support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
