<div class="mockup-dominicana-home-v2" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Hacé Cuentas / República Dominicana</div><div class="heroGrid"><div><span class="eyebrow">Cuentas claras para Dominicana</span><h1>De tu nómina a tu próxima decisión.</h1><p class="lead">Calculá salario, TSS, ISR, prestaciones, impuestos, vivienda y negocio con reglas dominicanas y fuentes locales.</p><div class="trust"><span>✓ Datos DGII y TSS</span><span>✓ Montos en pesos dominicanos</span><span>✓ Sin registro</span></div><div class="refs"><div class="ref"><small>AFP empleado</small><b>2,87%</b></div><div class="ref"><small>SFS empleado</small><b>3,04%</b></div><div class="ref"><small>Regalía pascual</small><b>1/12 anual</b></div></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Cuánto cobrás neto?</h2><p>Separá aportes, ISR y regalía.</p></div><span class="live">EN VIVO</span></div><div class="fields"><div class="field wide"><label>Salario bruto mensual</label><div class="input"><b>RD$</b><input id="salary" value="60000"></div></div><div class="field"><label>Otros descuentos</label><div class="input"><b>RD$</b><input id="other" value="0"></div></div><div class="field"><label>Ingreso adicional gravado</label><div class="input"><b>RD$</b><input id="extra" value="0"></div></div></div><div class="option"><span>Mostrar provisión mensual de regalía pascual</span><button class="switch" id="bonusSwitch"></button></div><button class="primary" id="calculate">Actualizar mi nómina</button><div class="result"><small>SALARIO NETO ESTIMADO</small><div class="amount" id="net">RD$56.454</div><div class="resultGrid"><div class="metric"><span>AFP + SFS</span><b id="tss">− RD$3.546</b></div><div class="metric"><span>ISR ESTIMADO</span><b id="tax">− RD$0</b></div><div class="metric"><span>REGALÍA PROVISIONADA</span><b id="bonus">RD$0</b></div></div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por tu situación</span><h2>¿Qué necesitás resolver hoy?</h2><p>Elegí una necesidad y te mostramos primero las herramientas dominicanas adecuadas.</p></div><div class="needs"><button class="need active" data-filter="trabajo"><span class="icon">$</span><h3>Mi salario y prestaciones</h3><p>Neto, regalía, horas extra y liquidación.</p><em>→</em></button><button class="need" data-filter="impuestos"><span class="icon">%</span><h3>Mis impuestos</h3><p>ISR, ITBIS, retenciones y obligaciones DGII.</p><em>→</em></button><button class="need" data-filter="vivienda"><span class="icon">⌂</span><h3>Quiero comprar vivienda</h3><p>Inicial, préstamo, transferencia e impuestos.</p><em>→</em></button><button class="need" data-filter="negocio"><span class="icon">▤</span><h3>Tengo un negocio</h3><p>DGII, costos, ventas y contratación.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas dominicanas</span><h2>Todo lo importante, ordenado.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="trabajo">Trabajo</button><button class="filter" data-filter="impuestos">Impuestos</button><button class="filter" data-filter="vivienda">Vivienda</button><button class="filter" data-filter="negocio">Negocio</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="trabajo" data-text="sueldo neto tss afp sfs isr nómina"><span class="tag">La más usada</span><h3>Calculadora de sueldo neto</h3><p>Descontá AFP, SFS, ISR y otros conceptos para entender tu pago mensual.</p><button>Calcular sueldo →</button></article><article class="card" data-cat="trabajo" data-text="liquidación prestaciones cesantía preaviso vacaciones regalía"><span class="tag">Derechos laborales</span><h3>Liquidación laboral</h3><p>Cesantía, preaviso, vacaciones y regalía proporcional.</p><button>Calcular liquidación →</button></article><article class="card" data-cat="trabajo" data-text="regalía pascual salario navidad proporcional"><span class="tag">Beneficio anual</span><h3>Regalía pascual</h3><p>Calculá el salario de Navidad completo o proporcional.</p><button>Calcular regalía →</button></article><article class="card" data-cat="impuestos negocio" data-text="negocio dgii itbis isr anticipo retenciones"><span class="tag">DGII</span><h3>Impuestos de mi negocio</h3><p>ITBIS, ISR, anticipos y obligaciones frecuentes.</p><button>Ordenar impuestos →</button></article><article class="card" data-cat="vivienda impuestos" data-text="comprar vivienda inicial préstamo transferencia inmueble"><span class="tag">Vivienda</span><h3>Comprar una vivienda</h3><p>Inicial, gastos legales, transferencia y cuota hipotecaria.</p><button>Calcular compra →</button></article><article class="card" data-cat="negocio" data-text="costo empleado contratar tss aportes empresa"><span class="tag">Empleadores</span><h3>Costo de contratar</h3><p>Salario, TSS patronal, prestaciones y costo anual.</p><button>Ver costo →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap"><div class="sources"><article class="panel"><h3>Cómo se forma la nómina</h3><p>Una lectura rápida de los principales conceptos.</p><div class="line"><span>AFP del trabajador</span><b>2,87%</b></div><div class="line"><span>Seguro Familiar de Salud</span><b>3,04%</b></div><div class="line"><span>ISR</span><b>Escala progresiva</b></div><div class="line"><span>Regalía pascual</span><b>Exenta dentro del límite legal</b></div></article><article class="panel dark"><h3>Fuentes dominicanas</h3><p>Cada herramienta identifica la norma, escala y fecha aplicada.</p><div class="line"><span>Impuestos</span><b>DGII</b></div><div class="line"><span>Seguridad social</span><b>TSS</b></div><div class="line"><span>Trabajo</span><b>Ministerio de Trabajo</b></div><div class="line"><span>Moneda y tasas</span><b>Banco Central</b></div></article></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-dominicana-home-v2')?document.currentScript.previousElementSibling:document.querySelector('.mockup-dominicana-home-v2');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],num=id=>Math.max(0,Number($(id).value.replaceAll(".","").replaceAll(",",""))||0),money=n=>"RD$"+Math.round(n).toLocaleString("es-DO");let showBonus=false;
function calc(){const s=num("#salary"),extra=num("#extra"),other=num("#other"),gross=s+extra,tss=Math.min(gross,500000)*.0591,annual=Math.max(0,(gross-tss)*12-416220),tax=annual<=0?0:annual<=208000?annual*.15/12:annual<=312000?(31200+(annual-208000)*.2)/12:(52000+(annual-312000)*.25)/12,net=Math.max(0,gross-tss-tax-other),bonus=showBonus?s/12:0;$("#net").textContent=money(net);$("#tss").textContent="− "+money(tss);$("#tax").textContent="− "+money(tax);$("#bonus").textContent=money(bonus)}
$$(".calc input").forEach(x=>x.oninput=calc);$("#bonusSwitch").onclick=e=>{showBonus=!showBonus;e.currentTarget.classList.toggle("on",showBonus);calc()};$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Nómina actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent="Abriendo: "+t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1600)}$$(".card button").forEach(b=>b.onclick=()=>toast(b.closest(".card").querySelector("h3").textContent));calc();

})();
</script>
