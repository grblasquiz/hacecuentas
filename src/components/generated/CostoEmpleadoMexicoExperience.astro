---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-costo-empleado-mexico" set:html={`<section class="hero"><div class="wrap crumb"><b>México</b> &nbsp;/&nbsp; Trabajo &nbsp;/&nbsp; Costo de un empleado</div><div class="wrap grid"><div class="copy"><div class="eyebrow">El costo real de contratar</div><h1>El sueldo es sólo una parte de la nómina.</h1><p>Sumá IMSS, INFONAVIT, impuesto estatal y prestaciones para saber cuánto cuesta realmente cada puesto.</p><div class="chips"><span>✓ Cuotas patronales</span><span>⌂ INFONAVIT</span><span>▤ Prestaciones LFT</span></div><div class="art"><div class="desk"></div><div class="person"></div><div class="screen"></div><div class="costcard"><small>COSTO TOTAL MENSUAL</small><strong id="art-cost">$37,038</strong><span id="art-copy">por un sueldo de $30,000</span></div></div></div><form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá el costo patronal</h2><p class="muted">Elegí el tipo de contratación.</p></div><span class="tag">México · 2026</span></div><div class="label">Escenario</div><div class="cases"><button type="button" class="case active" data-mode="payroll"><i>▣</i>Empleado en nómina</button><button type="button" class="case" data-mode="home"><i>⌂</i>Persona del hogar</button><button type="button" class="case" data-mode="compare"><i>↔</i>Comparar salarios</button></div><div class="label">Datos del puesto</div><div class="fields"><div class="field wide"><label>Sueldo bruto mensual</label><div class="money"><b>$</b><input id="salary" value="30000" inputmode="decimal"></div></div><div class="field"><label>Estado</label><select id="state"><option value=".03">CDMX · ISN 3%</option><option value=".03">Estado de México · 3%</option><option value=".025">Jalisco · 2,5%</option><option value=".02">Nuevo León · 2%</option></select></div><div class="field"><label>Antigüedad</label><select id="years"><option value="1">1 año</option><option value="2">2 años</option><option value="5">5 años</option><option value="10">10 años</option></select></div><div class="field"><label>Días de aguinaldo</label><input id="bonus" value="15" inputmode="decimal"></div><div class="field"><label>Prima de riesgo</label><select id="risk"><option value=".0054355">Clase I · 0,54355%</option><option value=".0113065">Clase II · 1,13065%</option><option value=".025984">Clase III · 2,59840%</option></select></div><div class="field wide hidden" id="f-compare"><label>Segundo sueldo bruto</label><div class="money"><b>$</b><input id="salary2" value="45000" inputmode="decimal"></div></div></div><section class="result"><div class="result-top"><div><small id="result-label">COSTO TOTAL MENSUAL</small><div class="value" id="total">$37,038</div></div><div class="ratio"><small>Carga adicional</small><b id="ratio">23,5% del sueldo</b></div></div><div class="stats"><span>IMSS + INFONAVIT<b id="stat-social">$5,240</b></span><span>Prestaciones provisionadas<b id="stat-benefits">$898</b></span><span>Impuesto estatal<b id="stat-tax">$927</b></span></div><button class="go" id="update" type="button">Actualizar costo</button></section></form></div></section>
<section class="section"><div class="wrap"><div class="center"><div class="eyebrow">Más que el sueldo</div><h2>Así se reparte el costo del puesto</h2><p>La barra muestra qué peso tiene cada componente en el presupuesto mensual.</p></div><div class="barcard"><div class="bar"><i class="salary" id="bar-salary"></i><i class="imss" id="bar-social"></i><i class="benefits" id="bar-benefits"></i><i class="tax" id="bar-tax"></i></div><div class="legend"><span>SUELDO BRUTO<b id="leg-salary">$30,000</b></span><span>SEGURIDAD SOCIAL<b id="leg-social">$5,240</b></span><span>PRESTACIONES<b id="leg-benefits">$898</b></span><span>ISN<b id="leg-tax">$927</b></span></div></div></div></section><section class="break"><div class="wrap breakgrid"><article class="card"><h3>Presupuesto, línea por línea</h3><div class="line"><span>Sueldo bruto mensual</span><b id="d-salary">$30,000</b></div><div class="line"><span>Cuotas patronales IMSS</span><b id="d-imss">+ $3,740</b></div><div class="line"><span>INFONAVIT · 5% SBC</span><b id="d-infonavit">+ $1,500</b></div><div class="line"><span>Aguinaldo + prima vacacional</span><b id="d-benefits">+ $898</b></div><div class="line"><span>Impuesto sobre nómina</span><b id="d-tax">+ $927</b></div><div class="line total"><strong>Costo mensual completo</strong><b id="d-total">$37,038</b></div></article><article class="card"><h3>Qué estamos contemplando</h3><div class="step"><i>1</i><div><b>Salario base de cotización</b><span>Integra aguinaldo, vacaciones y prima vacacional.</span></div></div><div class="step"><i>2</i><div><b>Seguridad social patronal</b><span>IMSS, retiro, CEAV, riesgo e INFONAVIT.</span></div></div><div class="step"><i>3</i><div><b>Prestaciones e impuesto local</b><span>Provisión mensual e ISN según el estado.</span></div></div><div class="warning" id="warning">⚠️ No incluye equipo, reclutamiento, bonos ni PTU. Sumalos al presupuesto si corresponden.</div></article></div></section><section class="darksection"><div class="wrap darkgrid"><div><div class="eyebrow" style="color:#80d3b8">Tres pisos legales</div><h2>Lo obligatorio no termina en el IMSS.</h2><p>El presupuesto completo incluye aportes de seguridad social, vivienda y prestaciones mínimas de la LFT.</p></div><div class="refs"><div class="ref"><small>INFONAVIT</small><b>5% SBC</b><span>Aporte patronal</span></div><div class="ref"><small>AGUINALDO</small><b>15 días</b><span>Mínimo legal</span></div><div class="ref"><small>PRIMA VACACIONAL</small><b>25%</b><span>Sobre vacaciones</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-costo-empleado-mexico')?document.currentScript.previousElementSibling:document.querySelector('.mockup-costo-empleado-mexico');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value.replace(",","."))||0),mx=x=>"$"+Math.round(x).toLocaleString("es-MX");let mode="payroll";
function vacations(y){return y<=5?10+y*2:20+Math.ceil((y-5)/5)*2}function cost(s){let y=Number($("#years").value),bonus=Math.max(15,n("#bonus")),daily=s/30.4,vac=vacations(y),factor=(365+bonus+vac*.25)/365,sbc=s*factor,risk=Number($("#risk").value),state=Number($("#state").value),imss=sbc*(.075+risk),infonavit=sbc*.05,benefits=(bonus*daily+vac*daily*.25)/12,tax=(s+benefits)*state;if(mode==="home"){imss=sbc*.105;infonavit=sbc*.05;tax=0}let total=s+imss+infonavit+benefits+tax;return{s,imss,infonavit,benefits,tax,total}}
function calc(){let a=cost(n("#salary"));if(mode==="compare"){let b=cost(n("#salary2")),diff=Math.abs(a.total-b.total),winner=a.total<=b.total?"Escenario A":"Escenario B";$("#result-label").textContent="DIFERENCIA DE COSTO MENSUAL";$("#total").textContent=mx(diff);$("#ratio").textContent=`Menor costo: ${winner}`;$("#warning").textContent=`✓ La diferencia anual entre ambos salarios es ${mx(diff*12)}.`}else{$("#result-label").textContent="COSTO TOTAL MENSUAL";$("#total").textContent=mx(a.total);$("#ratio").textContent=((a.total/a.s-1)*100).toFixed(1).replace(".",",")+"% del sueldo";$("#warning").textContent=mode==="home"?"⚠️ En trabajo del hogar el patrón absorbe la cuota obrera dentro de la línea de captura.":"⚠️ No incluye equipo, reclutamiento, bonos ni PTU. Sumalos al presupuesto si corresponden."}let social=a.imss+a.infonavit;$("#art-cost").textContent=$("#total").textContent;$("#art-copy").textContent=mode==="compare"?"diferencia entre escenarios":"por un sueldo de "+mx(a.s);$("#stat-social").textContent=mx(social);$("#stat-benefits").textContent=mx(a.benefits);$("#stat-tax").textContent=mx(a.tax);$("#leg-salary").textContent=mx(a.s);$("#leg-social").textContent=mx(social);$("#leg-benefits").textContent=mx(a.benefits);$("#leg-tax").textContent=mx(a.tax);$("#d-salary").textContent=mx(a.s);$("#d-imss").textContent="+ "+mx(a.imss);$("#d-infonavit").textContent="+ "+mx(a.infonavit);$("#d-benefits").textContent="+ "+mx(a.benefits);$("#d-tax").textContent="+ "+mx(a.tax);$("#d-total").textContent=mx(a.total);let t=Math.max(1,a.total);$("#bar-salary").style.width=a.s/t*100+"%";$("#bar-social").style.width=social/t*100+"%";$("#bar-benefits").style.width=a.benefits/t*100+"%";$("#bar-tax").style.width=a.tax/t*100+"%"}
function setMode(m){mode=m;$$(".case").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));$("#f-compare").classList.toggle("hidden",m!=="compare");calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Costo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar costo",1200)};setMode("payroll");

})();
</script>
