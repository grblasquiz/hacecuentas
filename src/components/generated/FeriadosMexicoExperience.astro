);color:var(--red);font-weight:900;cursor:pointer}.mockup-feriados-mexico .day.optional{background:var(--cream);color:#996817;font-weight:900;cursor:pointer}.mockup-feriados-mexico .day.school{background:var(--sky);color:#3d6b81;font-weight:900;cursor:pointer}.mockup-feriados-mexico .day.required:after,.mockup-feriados-mexico .day.optional:after,.mockup-feriados-mexico .day.school:after{content:"";width:3px;height:3px;border-radius:50%;background:currentColor;position:absolute;bottom:3px}.mockup-feriados-mexico .legend{display:flex;justify-content:center;gap:18px;margin-top:20px;flex-wrap:wrap}.mockup-feriados-mexico .legend span{font-size:8px;color:var(--muted)}.mockup-feriados-mexico .legend i{display:inline-block;width:8px;height:8px;border-radius:3px;margin-right:5px}.mockup-feriados-mexico .legend .r{background:var(--rose)}.mockup-feriados-mexico .legend .o{background:var(--cream)}.mockup-feriados-mexico .legend .s{background:var(--sky)}
