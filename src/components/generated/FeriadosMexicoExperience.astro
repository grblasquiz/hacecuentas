<div class="mockup-feriados-mexico" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>México</b> / Fechas / Feriados 2026</div><div class="hero-grid"><div><div class="eyebrow">Calendario laboral oficial</div><h1>Feriados México 2026, sin confundir descanso con costumbre.</h1><p class="lead">Todos los descansos obligatorios, puentes, Semana Santa y fechas escolares en un calendario que podés filtrar y usar para planear.</p><div class="trust"><span>✓ Art. 74 LFT</span><span>✓ Pago triple si trabajás</span><span>✓ Calendario descargable</span></div></div><aside class="next"><div class="next-top"><small>PRÓXIMO DESCANSO OBLIGATORIO</small><span class="official">Federal</span></div><div class="date-card"><div class="date"><span>Miércoles</span><strong>16</strong><i>septiembre</i></div><div class="date-copy"><span>EN 49 DÍAS</span><b>Independencia de México</b><p>No forma fin de semana largo automático en 2026.</p></div></div><div class="countdown"><div><span>Obligatorios restantes</span><b>3 días</b></div><div><span>Próximo puente</span><b>16 de noviembre</b></div><div><span>Fin de año</span><b>25 de diciembre</b></div></div><button class="jump" id="calendar-button">Ver calendario completo ↓</button></aside></div></div></section>
<section class="section" id="calendar"><div class="wrap"><header class="section-head"><span>Calendario 2026</span><h2>Elegí qué fechas querés ver.</h2><p>Rojo: descanso obligatorio. Dorado: fecha habitual no obligatoria. Azul: referencia escolar.</p></header><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todos</button><button class="filter" data-filter="required">Obligatorios</button><button class="filter" data-filter="optional">No obligatorios</button><button class="filter" data-filter="school">Escolares</button></div><select id="month-jump"><option value="">Ir a un mes…</option><option value="m9">Septiembre</option><option value="m11">Noviembre</option><option value="m12">Diciembre</option></select></div><div class="months" id="months"></div><div class="legend"><span><i class="r"></i>Descanso obligatorio</span><span><i class="o"></i>Fecha habitual</span><span><i class="s"></i>Calendario escolar</span></div></div></section>
<section class="section tint"><div class="wrap"><header class="section-head"><span>Fechas clave</span><h2>Los días que cambian tu semana.</h2></header><div class="list" id="holiday-list"></div></div></section>
<section class="section"><div class="wrap"><header class="section-head"><span>Planeador de puentes</span><h2>Convertí un feriado en descanso largo.</h2><p>Elegí una fecha y los días de vacaciones que podés usar.</p></header><div class="planner"><div class="planner-form"><h3>Armá tu descanso</h3><p>La propuesta usa sábado y domingo como descanso habitual.</p><div class="field"><label>Feriado</label><select id="plan-holiday"><option value="sep">16 de septiembre · miércoles</option><option value="nov">16 de noviembre · lunes</option><option value="dec">25 de diciembre · viernes</option></select></div><div class="field"><label>Días de vacaciones disponibles</label><input id="vacation-days" type="number" value="2" min="0" max="5"></div><button class="plan-button" id="plan">Armar el mejor puente</button></div><div class="planner-result"><small>PROPUESTA</small><strong id="plan-title">5 días libres</strong><span id="plan-copy">Pedí jueves 17 y viernes 18 de septiembre.</span><div class="timeline" id="timeline"></div></div></div></div></section>
<section class="section tint"><div class="wrap"><header class="section-head"><span>Derechos laborales</span><h2>Qué pasa si te toca trabajar.</h2></header><div class="rights"><article class="right"><i>1×</i><h3>Tu salario diario</h3><p>Se paga normalmente porque el feriado es descanso con goce de sueldo.</p></article><article class="right"><i>+2×</i><h3>Pago doble adicional</h3><p>Si trabajás, recibís dos salarios diarios extra por el servicio prestado.</p></article><article class="right"><i>=3×</i><h3>Total triple</h3><p>En el recibo debe verse un total equivalente a tres veces tu salario diario.</p></article></div><div class="callout"><b>Semana Santa no es descanso obligatorio federal.</b> Jueves 2 y viernes 3 de abril de 2026 sólo se descansan si lo establece tu empleador, contrato o régimen aplicable.</div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-feriados-mexico')?document.currentScript.previousElementSibling:document.querySelector('.mockup-feriados-mexico');if(!root)return;

const holidays=[{m:1,d:1,n:"Año Nuevo",t:"required"},{m:2,d:2,n:"Constitución Mexicana",t:"required"},{m:3,d:16,n:"Natalicio de Benito Juárez",t:"required"},{m:4,d:2,n:"Jueves Santo",t:"optional"},{m:4,d:3,n:"Viernes Santo",t:"optional"},{m:5,d:1,n:"Día del Trabajo",t:"required"},{m:5,d:5,n:"Batalla de Puebla",t:"school"},{m:9,d:16,n:"Independencia de México",t:"required"},{m:11,d:2,n:"Día de Muertos",t:"optional"},{m:11,d:16,n:"Revolución Mexicana",t:"required"},{m:12,d:12,n:"Día de la Virgen de Guadalupe",t:"optional"},{m:12,d:25,n:"Navidad",t:"required"}],names=["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"],week=["L","M","M","J","V","S","D"],$=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let filter="all";function render(){let html="";for(let m=1;m<=12;m++){const first=(new Date(2026,m-1,1).getDay()+6)%7,days=new Date(2026,m,0).getDate();html+=`<article class="month" id="m${m}"><div class="month-head"><h3>${names[m-1]}</h3><span>${holidays.filter(h=>h.m===m&&(filter==="all"||h.t===filter)).length} fechas</span></div><div class="week">${week.map(x=>`<b>${x}</b>`).join("")}${Array(first).fill('<span class="day muted"></span>').join("")}`;for(let d=1;d<=days;d++){const h=holidays.find(x=>x.m===m&&x.d===d&&(filter==="all"||x.t===filter));html+=`<button class="day ${h?h.t:""}" ${h?`data-name="${h.n}"`:""}>${d}</button>`}html+="</div></article>"}$("#months").innerHTML=html;$$("[data-name]").forEach(b=>b.onclick=()=>toast(b.dataset.name))}function renderList(){const labels={required:"Obligatorio · LFT",optional:"No obligatorio",school:"Referencia escolar"};$("#holiday-list").innerHTML=holidays.map(h=>`<article class="holiday" data-type="${h.t}"><div class="holiday-date"><strong>${h.d}</strong><span>${names[h.m-1]}</span></div><div><h3>${h.n}</h3><p>${h.t==="required"?"Descanso obligatorio federal. Si trabajás, corresponde pago triple.":"No es descanso obligatorio federal; puede depender de escuela, contrato o empleador."}</p></div><span class="type ${h.t==="required"?"":"optional"}">${labels[h.t]}</span></article>`).join("")}$$(".filter").forEach(b=>b.onclick=()=>{filter=b.dataset.filter;$$(".filter").forEach(x=>x.classList.toggle("active",x===b));render()});$("#month-jump").onchange=e=>{if(e.target.value)$("#"+e.target.value).scrollIntoView({behavior:"smooth",block:"center"})};$("#calendar-button").onclick=()=>$("#calendar").scrollIntoView({behavior:"smooth"});const plans={sep:{base:3,days:["L14","M15","X16","J17","V18","S19","D20"],off:[2,3,4,5,6],copy:"Pedí jueves 17 y viernes 18 de septiembre."},nov:{base:3,days:["S14","D15","L16","M17","X18"],off:[0,1,2],copy:"No necesitás pedir días para tener un fin de semana de 3 días."},dec:{base:3,days:["J24","V25","S26","D27","L28"],off:[1,2,3],copy:"Pedí jueves 24 o lunes 28 para extender el descanso."}};function plan(){const p=plans[$("#plan-holiday").value],extra=Math.min(5,Math.max(0,Number($("#vacation-days").value)||0)),count=Math.min(p.days.length,p.base+extra);$("#plan-title").textContent=count+" días libres";$("#plan-copy").textContent=p.copy;$("#timeline").innerHTML=p.days.map((d,i)=>`<i class="${p.off.includes(i)||i<count?"off":""}">${d}</i>`).join("")}$("#plan").onclick=e=>{plan();e.currentTarget.textContent="✓ Puente armado";setTimeout(()=>e.currentTarget.textContent="Armar el mejor puente",1200)};function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1600)}render();renderList();plan();

})();
</script>
<style is:global>

