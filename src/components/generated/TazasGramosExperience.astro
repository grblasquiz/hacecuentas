0px 30px,#3994b9 0 12px,transparent 13px 25px)}.mockup-tazas-gramos .coffee .cup{font-size:110px}.mockup-tazas-gramos .steam{position:absolute;top:50px;width:18px;height:80px;border-left:5px solid var(--accent);border-radius:50%}.mockup-tazas-gramos .s1{left:43%}.mockup-tazas-gramos .s2{left:55%;top:65px}.mockup-tazas-gramos .beer .glass{width:130px;height:205px;border:7px solid var(--blue);border-top-width:12px;border-radius:12px 12px 35px 35px;position:relative;overflow:hidden}.mockup-tazas-gramos .beer .glass i{position:absolute;inset:35px 0 0;background:#e5a63f}.mockup-tazas-gramos .beer .glass b{position:absolute;left:0;right:0;top:18px;height:38px;background:#fff4d5;border-radius:50%;z-index:2}.mockup-tazas-gramos .beer>span{position:absolute;bottom:20px;font-weight:950;color:var(--blue)}.mockup-tazas-gramos .cup{grid-template-columns:1fr auto 1fr;gap:18px}.mockup-tazas-gramos .measurecup{width:125px;height:155px;border:6px solid var(--blue);border-radius:10px 10px 35px 35px;position:relative}.mockup-tazas-gramos .measurecup i{position:absolute;inset:45% 0 0;background:var(--accent)}.mockup-tazas-gramos .measurecup b{position:absolute;top:18px;left:0;right:0;text-align:center;font-size:12px}.mockup-tazas-gramos .cup>span{font-size:45px;color:var(--accent)}.mockup-tazas-gramos .weight{padding:25px 18px;background:var(--soft);border-radius:18px;font-size:25px;font-weight:950}.mockup-tazas-gramos .wall{display:flex;width:240px;height:210px;border:8px solid var(--blue)}.mockup-tazas-gramos .wall i{flex:1;border-right:2px solid #fff;background:repeating-linear-gradient(45deg,var(--accent) 0 8px,var(--soft) 9px 17px)}.mockup-tazas-gramos .cold,.mockup-tazas-gramos .warm{position:absolute;font-size:25px;font-weight:950}.mockup-tazas-gramos .cold{left:18px;color:#3182a0}.mockup-tazas-gramos .warm{right:18px;color:#c26734}.mockup-tazas-gramos .dial{width:215px;height:215px;border-radius:50%;border:18px solid var(--blue);display:grid;place-items:center;position:relative}.mockup-tazas-gramos .dial i{position:absolute;width:7px;height:75px;background:var(--accent);bottom:50%;transform-origin:bottom;transform:rotate(35deg)}.mockup-tazas-gramos .dial b{font-size:52px;margin-top:30px}.mockup-tazas-gramos .dial small{position:absolute;bottom:38px}.mockup-tazas-gramos .clockface{width:210px;height:210px;border:12px solid var(--blue);border-radius:50%;position:relative}.mockup-tazas-gramos .clockface i,.mockup-tazas-gramos .clockface b{position:absolute;left:50%;bottom:50%;width:7px;background:var(--accent);transform-origin:bottom}.mockup-tazas-gramos .clockface i{height:72px;transform:rotate(90deg)}.mockup-tazas-gramos .clockface b{height:55px;transform:rotate(10deg)}.mockup-tazas-gramos .clock>span{position:absolute;bottom:24px;font-size:23px;font-weight:950}.mockup-tazas-gramos .drop i{width:150px;height:190px;background:var(--accent);border-radius:70% 30% 70% 30%;transform:rotate(45deg)}.mockup-tazas-gramos .drop span{position:absolute;color:#fff;font-size:32px;font-weight:950}.mockup-tazas-gramos .bubble{position:absolute;padding:18px 24px;border-radius:24px;background:var(--soft);border:2px solid var(--accent);font-weight:950;font-size:23px}.mockup-tazas-gramos .bubble.a{left:9%;top:20%}.mockup-tazas-gramos .bubble.b{right:9%;top:34%}.mockup-tazas-gramos .bubble.c{left:28%;bottom:16%}.mockup-tazas-gramos .pages{width:240px;height:175px;display:flex;perspective:500px}.mockup-tazas-gramos .pages i{width:50%;background:#fff;border:6px solid var(--blue)}.mockup-tazas-gramos .pages i:first-child{transform:rotateY(14deg)}.mockup-tazas-gramos .pages i:last-child{transform:rotateY(-14deg)}.mockup-tazas-gramos .book>span{position:absolute;bottom:27px;font-weight:950;color:var(--accent)}.mockup-tazas-gramos .sheet{width:180px;height:230px;border:5px solid var(--blue);background:#fff;border-radius:12px;padding:25px}.mockup-tazas-gramos .sheet b{font-size:55px;color:var(--accent)}.mockup-tazas-gramos .sheet i{display:block;border-top:6px solid #cbd7db;margin-top:17px}.mockup-tazas-gramos .timer{position:absolute;right:22px;bottom:24px;padding:12px;background:var(--blue);color:#fff;border-radius:10px;font-weight:950}.mockup-tazas-gramos .target{width:220px;height:220px;border:24px solid var(--accent);border-radius:50%;box-shadow:inset 0 0 0 26px #fff,inset 0 0 0 48px var(--blue);display:grid;place-items:center}.mockup-tazas-gramos .target b{font-size:44px;background:#fff;border-radius:50%;padding:18px}.mockup-tazas-gramos .parrilla{width:245px;height:160px;border:10px solid var(--blue);border-radius:18px;display:flex;gap:12px;padding:28px}.mockup-tazas-gramos .parrilla i{flex:1;border-radius:30px;background:var(--accent)}.mockup-tazas-gramos .fire{position:absolute;bottom:12px;font-size:60px;color:#e78a35}.mockup-tazas-gramos .timeline .line{position:absolute;left:12%;right:12%;top:50%;height:8px;background:var(--blue);display:flex;justify-content:space-between}.mockup-tazas-gramos .timeline .line i{width:29px;height:29px;border:7px solid var(--blue);background:#fff;border-radius:50%;transform:translateY(-11px)}.mockup-tazas-gramos .truck{position:absolute;left:30%;top:38%;font-size:50px;color:var(--accent)}.mockup-tazas-gramos .donut{width:220px;height:220px;border-radius:50%;background:conic-gradient(var(--accent) 0 40%,#e7af53 40% 65%,#4d98a1 65% 80%,#dce4e4 80%);position:relative}.mockup-tazas-gramos .donut:after{content:"";position:absolute;inset:55px;background:#fff;border-radius:50%}.mockup-tazas-gramos .budget>span{position:absolute;font-size:50px;font-weight:950;color:var(--blue)}
.mockup-tazas-gramos .tool{padding:62px 22px}.mockup-tazas-gramos .tool-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.mockup-tazas-gramos .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-tazas-gramos .tool h2,.mockup-tazas-gramos .guide h2{font-size:37px;letter-spacing:-.04em;margin:7px 0}.mockup-tazas-gramos .tool-head p{max-width:510px;color:var(--muted);margin:0}.mockup-tazas-gramos .workspace{display:grid;grid-template-columns:.88fr 1.12fr;gap:20px}.mockup-tazas-gramos .panel{border-radius:24px;padding:27px}.mockup-tazas-gramos .form{border:1px solid var(--line);box-shadow:0 16px 40px #18374a0c}.mockup-tazas-gramos .panel h3{font-size:21px;margin:0 0 5px}.mockup-tazas-gramos .hint{color:var(--muted);font-size:14px;margin:0 0 20px}.mockup-tazas-gramos .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-tazas-gramos .field{margin-bottom:2px}.mockup-tazas-gramos .field label{display:flex;justify-content:space-between;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-tazas-gramos .field output{color:var(--accent)}.mockup-tazas-gramos input,.mockup-tazas-gramos select{width:100%;min-height:49px;border:1px solid #ccd7da;border-radius:12px;background:#fff;padding:12px 14px;color:var(--ink)}.mockup-tazas-gramos input[type=range]{padding:0;accent-color:var(--accent)}.mockup-tazas-gramos .actions{display:flex;gap:9px;margin-top:21px}.mockup-tazas-gramos .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:14px;font-weight:900;cursor:pointer}.mockup-tazas-gramos .reset{border:1px solid #d7aa58;border-radius:12px;background:#fff;color:#654a1f;padding:13px 16px;font-weight:850;cursor:pointer}.mockup-tazas-gramos .result{background:linear-gradient(145deg,var(--blue),color-mix(in srgb,var(--blue),var(--accent) 35%));color:#fff;position:relative;overflow:hidden}.mockup-tazas-gramos .badge{display:inline-block;padding:7px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:950}.mockup-tazas-gramos .big{font-size:48px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:14px 0 5px}.mockup-tazas-gramos .caption{color:#dceaf0;font-size:14px}.mockup-tazas-gramos .meter{height:13px;border-radius:99px;background:#ffffff2d;margin:24px 0;position:relative}.mockup-tazas-gramos .meter i{position:absolute;left:var(--position);top:50%;width:24px;height:24px;border:5px solid #fff;background:var(--accent);border-radius:50%;transform:translate(-50%,-50%);transition:.25s}.mockup-tazas-gramos .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.mockup-tazas-gramos .metric{padding:13px;border:1px solid #ffffff2b;background:#ffffff0e;border-radius:13px}.mockup-tazas-gramos .metric small{display:block;color:#dceaf0;font-size:10px}.mockup-tazas-gramos .metric b{font-size:16px}.mockup-tazas-gramos .note{margin-top:17px;padding:14px 15px;border-radius:12px;background:var(--cream);color:#58461f;font-size:13px}.mockup-tazas-gramos .guide{padding:65px 22px;background:var(--paper)}.mockup-tazas-gramos .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px}.mockup-tazas-gramos .guide p{color:var(--muted)}.mockup-tazas-gramos .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.mockup-tazas-gramos .step{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff}.mockup-tazas-gramos .step b{display:block;color:var(--accent);margin-bottom:5px}.mockup-tazas-gramos .step span{font-size:14px;color:var(--muted)}.mockup-tazas-gramos .foot{padding:30px;text-align:center;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-tazas-gramos .nav{display:none}.mockup-tazas-gramos .hero-grid,.mockup-tazas-gramos .workspace,.mockup-tazas-gramos .guide-grid{grid-template-columns:1fr}.mockup-tazas-gramos .tool-head{flex-direction:column;align-items:start}}@media(max-width:550px){.mockup-tazas-gramos .fields,.mockup-tazas-gramos .metrics,.mockup-tazas-gramos .steps{grid-template-columns:1fr}.mockup-tazas-gramos .hero h1{font-size:43px}.mockup-tazas-gramos .actions{flex-direction:column}.mockup-tazas-gramos .art{height:290px}}

.mockup-tazas-gramos { width:100%; overflow:hidden; }
.mockup-tazas-gramos .top, .mockup-tazas-gramos header.top { display:none !important; }
.mockup-tazas-gramos .foot { display:none !important; }
.mockup-tazas-gramos .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-tazas-gramos .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-tazas-gramos .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-tazas-gramos .support-real summary { cursor:pointer; font-weight:750; }
.mockup-tazas-gramos .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-tazas-gramos :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-tazas-gramos input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-tazas-gramos input[type="number"]::-webkit-inner-spin-button, .mockup-tazas-gramos input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-tazas-gramos .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-tazas-gramos support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
