---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-tazas-gramos" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Cocina / Tazas y gramos</div><div class="eyebrow">Conversor por ingrediente</div><h1>Una taza no pesa siempre lo mismo.</h1><p class="lead">Elegí ingrediente, medida y cantidad. Convertimos usando la densidad correcta y mostramos equivalencias útiles.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art cup"><div class="measurecup"><i></i><b>1 CUP</b></div><span>≠</span><div class="weight">120 g</div></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">conversión interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="ingredient">Ingrediente</label><select id="ingredient"><option value="flour">Harina común</option><option value="sugar">Azúcar</option><option value="butter">Manteca</option><option value="rice">Arroz crudo</option><option value="cocoa">Cacao</option><option value="milk">Leche</option></select></div><div class="field"><label for="from">Medida de origen</label><select id="from"><option value="cup">Taza</option><option value="tbsp">Cucharada</option><option value="tsp">Cucharadita</option><option value="grams">Gramos</option></select></div><div class="field"><label for="amount">Cantidad</label><input id="amount" type="number" value="1" min="0.1" max="1000" step="0.1"></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-tazas-gramos')?document.currentScript.previousElementSibling:document.querySelector('.mockup-tazas-gramos');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const dens={flour:[120,"Harina"],sugar:[200,"Azúcar"],butter:[227,"Manteca"],rice:[190,"Arroz"],cocoa:[85,"Cacao"],milk:[245,"Leche"]}[v("ingredient")],u=v("from"),a=vn("amount"),grams=u==="grams"?a:a*dens[0]*(u==="cup"?1:u==="tbsp"?1/16:1/48),cups=grams/dens[0];return {big:Math.round(grams)+" g",label:dens[1]+" equivalente",badge:"Conversión por ingrediente",metrics:[["Tazas",cups.toFixed(2)],["Cucharadas",(cups*16).toFixed(1)],["Cucharaditas",(cups*48).toFixed(1)]],position:Math.min(100,cups*40),note:"Las medidas caseras cambian según cómo llenás la taza. Para pastelería precisa, pesá directamente en gramos."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"ingredient":"flour","from":"cup","amount":"1"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
<style is:global>

.mockup-tazas-gramos{--blue:#174b7a;--accent:#ca5f54;--soft:#fff0ec;--ink:#172331;--muted:#5e6977;--line:#d9e2e5;--paper:#f5f7f6;--cream:#fff8e2;--mint:#d9eee6}.mockup-tazas-gramos *{box-sizing:border-box}.mockup-tazas-gramos{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fff}.mockup-tazas-gramos button,.mockup-tazas-gramos input,.mockup-tazas-gramos select{font:inherit}.mockup-tazas-gramos .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:27px;border-bottom:1px solid var(--line)}.mockup-tazas-gramos .brand{font-weight:950;font-size:19px}.mockup-tazas-gramos .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-tazas-gramos .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-tazas-gramos .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-tazas-gramos .hero{padding:50px 22px 45px;background:linear-gradient(118deg,#fbfcfa 0 65%,var(--soft) 65%)}.mockup-tazas-gramos .hero-grid,.mockup-tazas-gramos .wrap{max-width:1180px;margin:auto}.mockup-tazas-gramos .hero-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:57px;align-items:center}.mockup-tazas-gramos .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-tazas-gramos .eyebrow{margin-top:27px;color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-tazas-gramos .hero h1{font-size:clamp(43px,5vw,67px);line-height:.98;letter-spacing:-.05em;margin:10px 0 19px}.mockup-tazas-gramos .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-tazas-gramos .pills{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-tazas-gramos .pills span{padding:8px 12px;border:1px solid var(--line);border-radius:99px;background:#fff;font-size:13px;font-weight:800}.mockup-tazas-gramos .art{height:330px;bo