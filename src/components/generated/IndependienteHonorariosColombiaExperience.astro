.mockup-independiente-honorarios-colombia .hero{padding:27px 0 65px;background:linear-gradient(125deg,#f5f9fc 0 62%,#edf8f4 100%);overflow:hidden}.mockup-independiente-honorarios-colombia .crumb{font-size:11px;color:#738297;margin-bottom:31px}.mockup-independiente-honorarios-colombia .crumb b{color:var(--teal)}.mockup-independiente-honorarios-colombia .heroGrid{display:grid;grid-template-columns:1fr .92fr;gap:70px;align-items:center}.mockup-independiente-honorarios-colombia .eyebrow{font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--teal);font-weight:950}.mockup-independiente-honorarios-colombia .hero h1{font-size:53px;line-height:1.01;letter-spacing:-.055em;margin:16px 0 18px;max-width:650px}.mockup-independiente-honorarios-colombia .hero p{font-size:16px;line-height:1.65;color:#53687e;max-width:590px}.mockup-independiente-honorarios-colombia .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.mockup-independiente-honorarios-colombia .chip{padding:8px 10px;border-radius:9px;background:#fff;border:1px solid #dce5ea;font-size:9px;color:#526579;font-weight:750}
.mockup-independiente-honorarios-colombia .visual{height:340px;position:relative}.mockup-independiente-honorarios-colombia .sheet{position:absolute;left:62px;top:16px;width:300px;height:282px;border-radius:20px;background:#fff;border:1px solid #d6e2e9;box-shadow:0 27px 60px #174b7a20;padding:25px;transform:rotate(-2deg)}.mockup-independiente-honorarios-colombia .sheet:after{content:"";position:absolute;width:112px;height:112px;border-radius:50%;background:#e5f5f0;right:-48px;bottom:-45px;z-index:-1}.mockup-independiente-honorarios-colombia .sheetHead{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e4e9ed;padding-bottom:16px}.mockup-independiente-honorarios-colombia .sheetHead span{font-size:9px;font-weight:950;letter-spacing:.12em;color:var(--blue)}.mockup-independiente-honorarios-colombia .flag{width:43px;height:27px;border-radius:5px;background:linear-gradient(#f7d247 0 50%,#1f68a1 50% 75%,#ce4650 75%)}.mockup-independiente-honorarios-colombia .sheetValue{font-size:35px;font-weight:950;letter-spacing:-.05em;margin:25px 0 4px;color:var(--blue)}.mockup-independiente-honorarios-colombia .sheetLabel{font-size:10px;color:#6d7e90}.mockup-independiente-honorarios-colombia .sheetRows{margin-top:18px}.mockup-independiente-honorarios-colombia .sheetRow{display:flex;justify-content:space-between;border-top:1px dashed #d7e0e5;padding:11px 0;font-size:10px}.mockup-independiente-honorarios-colombia .sheetRow span{color:#718194}.mockup-independiente-honorarios-colombia .sheetRow b{color:#263c53}.mockup-independiente-honorarios-colombia .stamp{position:absolute;right:2px;bottom:14px;width:155px;background:var(--blue);color:#fff;border-radius:16px;padding:17px;box-shadow:0 17px 36px #174b7a31;transform:rotate(3deg)}.mockup-independiente-honorarios-colombia .stamp small{font-size:8px;color:#c7dbea;letter-spacing:.08em}.mockup-independiente-honorarios-colombia .stamp strong{display:block;font-size:25px;margin:7px 0}.mockup-independiente-honorar