.mockup-tarifa-taxi-bogota .header{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-tarifa-taxi-bogota .nav{display:flex;align-items:center;justify-content:space-between}.mockup-tarifa-taxi-bogota .brand{display:flex;align-items:center;gap:10px;font-weight:900}.mockup-tarifa-taxi-bogota .logo{width:31px;height:35px;border-radius:7px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:13px}.mockup-tarifa-taxi-bogota .links{display:flex;gap:25px;color:#4d596b;font-size:14px;font-weight:700}.mockup-tarifa-taxi-bogota .actions{display:flex;gap:8px}.mockup-tarifa-taxi-bogota .nav-btn{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 13px;color:#465467}
.mockup-tarifa-taxi-bogota .hero{padding:54px 0 48px;background:linear-gradient(135deg,#fff9df,#eef8f5 58%,#eef6fb)}.mockup-tarifa-taxi-bogota .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:50px;align-items:center}.mockup-tarifa-taxi-bogota .crumb{font-size:14px;color:var(--blue);font-weight:800}.mockup-tarifa-taxi-bogota .eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:12px;font-weight:900;color:var(--blue);margin-top:19px}.mockup-tarifa-taxi-bogota .hero h1{font-size:53px;line-height:1.03;letter-spacing:-.052em;margin:13px 0 18px}.mockup-tarifa-taxi-bogota .lede{font-size:19px;color:#536174;line-height:1.55}.mockup-tarifa-taxi-bogota .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-tarifa-taxi-bogota .chip{border:1px solid #d8d5b4;background:#fff;border-radius:999px;padding:8px 12px;color:#5f5b35;font-size:12px;font-weight:850}
.mockup-tarifa-taxi-bogota .art{height:335px;position:relative}.mockup-tarifa-taxi-bogota .city{position:absolute;inset:29px 5px 20px 5px;border-radius:50%;background:#dceef3;overflow:hidden}.mockup-tarifa-taxi-bogota .mountain{position:absolute;width:330px;height:210px;background:#acd9cb;transform:rotate(45deg);left:108px;top:118px}.mockup-tarifa-taxi-bogota .road{position:absolute;width:370px;height:105px;background:#6d7d87;bottom:-10px;left:-20px;transform:rotate(-9deg)}.mockup-tarifa-taxi-bogota .road:after{content:"";position:absolute;left:0;right:0;top:47px;border-top:4px dashed #fff}.mockup-tarifa-taxi-bogota .taxi{position:absolute;width:185px;height:76px;background:var(--yellow);border:4px solid var(--ink);border-radius:25px 34px 17px 17px;left:30px;bottom:55px;box-shadow:0 16px 26px rgba(24,34,49,.18)}.mockup-tarifa-taxi-bogota .taxi:before{content:"";position:absolute;width:104px;height:44px;border:4px solid var(--ink);background:#dff2f7;left:34px;top:-38px;border-radius:35px 35px 0 0}.mockup-tarifa-taxi-bogota .wheel{position:absolute;width:31px;height:31px;border:6px solid var(--ink);background:#fff;border-radius:50%;bottom:-19px}.mockup-tarifa-taxi-bogota .wheel.a{left:24px}.mockup-tarifa-taxi-bogota .wheel.b{right:24px}.mockup-tarifa-taxi-bogota .taxi-sign{position:absolute;left:70px;top:-57px;background:#fff;border:3px solid var(--ink);border-radius:8px 8px 3px 3px;padding:4px 10px;font-size:9px;font-weight:950}.mockup-tarifa-taxi-bogota .meter{position:absolute;right:0;top:30px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:13px 16px;box-shadow:var(--shadow);font-size:11px;color:var(--muted)}.mockup-tarifa-taxi-bogota .meter strong{display:block;font-size:19px;color:var(--blue);margin-top:4px}
.mockup-tarifa-taxi-bogota .section{padding:64px 0}.mockup-tarifa-taxi-bogota .head{text-align:center;max-width:790px;margin:0 auto 30px}.mockup-tarifa-taxi-bogota .head .eyebrow{margin-top:0}.mockup-tarifa-taxi-bogota .head h2{font-size:37px;letter-spacing:-.04em;margin:9px 0}.mockup-tarifa-taxi-bogota .head p{color:var(--muted);line-height:1.6}.mockup-tarifa-taxi-bogota .preset-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:23px}.mockup-tarifa-taxi-bogota .preset{border:1px solid var(--line);background:#fff;border-radius:17px;padding:16px;text-align:left;cursor:pointer;color:var(--ink);transition:.18s}.mockup-tarifa-taxi-bogota .preset:hover{transform:translateY(-2px)}.mockup-tarifa-taxi-bogota .preset.active{border:2px solid var(--blue);background:var(--blue2)}.mockup-tarifa-taxi-bogota .preset span{display:inline-block;background:var(--yellow2);color:#725a08;border-radius:8px;padding:5px 7px;font-size:10px;font-weight:950}.mockup-tarifa-taxi-bogota .preset strong{display:block;margin:10px 0 4px;font-size:14px}.mockup-tarifa-taxi-bogota .preset small{color:var(--muted);font-size:11px}
.mockup-tarifa-taxi-bogota .calc{display:grid;grid-template-columns:.92fr 1.08fr;gap:22px;align-items:start}.mockup-tarifa-taxi-bogota .panel{background:#fff;border:1px solid var(--line);border-radius:24px;padding:28px;box-shadow:var(--shadow)}.mockup-tarifa-taxi-bogota .panel h3{font-size:22px;margin:0 0 7px}.mockup-tarifa-taxi-bogota .intro{font-size:14px;line-height:1.5;color:var(--muted);margin:0 0 21px}.mockup-tarifa-taxi-bogota .fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.mockup-tarifa-taxi-bogota .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-tarifa-taxi-bogota .field input,.mockup-tarifa-taxi-bogota .field select{width:100%;height:49px;border:1px solid #cbd5df;border-radius:12px;background:#fff;color:var(--ink);padding:0 12px;outline:none}.mockup-tarifa-taxi-bogota .field input:focus,.mockup-tarifa-taxi-bogota .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,75,122,.12)}.mockup-tarifa-taxi-bogota .full{grid-column:1/-1}.mockup-tarifa-taxi-bogota .help{font-size:11px;color:#778392;margin-top:5px}.mockup-tarifa-taxi-bogota .toggle-title{font-size:13px;font-weight:850;margin:20px 0 9px}.mockup-tarifa-taxi-bogota .toggle-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-tarifa-taxi-bogota .toggle{border:1px solid var(--line);background:#fff;border-radius:13px;padding:12px;display:flex;align-items:center;gap:10px;text-align:left;color:var(--ink);cursor:pointer}.mockup-tarifa-taxi-bogota .toggle .box{width:21px;height:21px;border:2px solid #afbbc5;border-radius:6px;display:grid;place-items:center;color:#fff;font-size:12px;font-weight:900;flex:0 0 21px}.mockup-tarifa-taxi-bogota .toggle.on{border-color:var(--mint);background:var(--mint2)}.mockup-tarifa-taxi-bogota .toggle.on .box{background:var(--mint);border-color:var(--mint)}.mockup-tarifa-taxi-bogota .toggle small{display:block;color:var(--muted);font-size:10px;margin-top:2px}.mockup-tarifa-taxi-bogota .buttons{display:flex;gap:10px;margin-top:20px}.mockup-tarifa-taxi-bogota .primary,.mockup-tarifa-taxi-bogota .secondary{border-radius:12px;padding:13px 17px;font-weight:900;cursor:pointer}.mockup-tarifa-taxi-bogota .primary{border:1px solid var(--blue);background:var(--blue);color:#fff;flex:1}.mockup-tarifa-taxi-bogota .secondary{border:1px solid #cbd5df;background:#fff;color:#465568}
.mockup-tarifa-taxi-bogota .result{background:linear-gradient(145deg,#174b7a,#287b9b);color:#fff}.mockup-tarifa-taxi-bogota .result .intro{color:#d7eaf2}.mockup-tarifa-taxi-bogota .res-top{display:flex;justify-content:space-between;gap:13px}.mockup-tarifa-taxi-bogota .res-label{text-transform:uppercase;letter-spacing:.12em;font-size:11px;color:#c6e4ee;font-weight:900}.mockup-tarifa-taxi-bogota .amount{font-size:46px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:9px 0}.mockup-tarifa-taxi-bogota .badge{height:max-content;background:#fff4c9;color:#654e05;border-radius:999px;padding:8px 11px;font-size:11px;font-weight:900}.mockup-tarifa-taxi-bogota .summary{color:#f1f8fa;font-size:14px;line-height:1.55}.mockup-tarifa-taxi-bogota .metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.mockup-tarifa-taxi-bogota .metric{border:1px solid rgba(255,255,255,.23);background:rgba(255,255,255,.11);border-radius:15px;padding:15px}.mockup-tarifa-taxi-bogota .metric span{display:block;color:#d4e9ef;font-size:11px}.mockup-tarifa-taxi-bogota .metric strong{display:block;color:#fff;font-size:19px;margin-top:4px}.mockup-tarifa-taxi-bogota .bar-title{display:flex;justify-content:space-between;color:#dcecf2;font-size:11px;margin:18px 0 8px}.mockup-tarifa-taxi-bogota .bar{height:13px;border-radius:99px;background:rgba(255,255,255,.18);overflow:hidden;display:flex}.mockup-tarifa-taxi-bogota .bar i{height:100%;display:block}.mockup-tarifa-taxi-bogota .basebar{background:#58cfad}.mockup-tarifa-taxi-bogota .recbar{background:#f6c744}.mockup-tarifa-taxi-bogota .detail{margin-top:15px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:14px;padding:14px}.mockup-tarifa-taxi-bogota .detail-row{display:flex;justify-content:space-between;gap:15px;padding:7px 0;color:#e7f2f5;font-size:12px;border-bottom:1px solid rgba(255,255,255,.14)}.mockup-tarifa-taxi-bogota .detail-row:last-child{border:0}.mockup-tarifa-taxi-bogota .detail-row strong{color:#fff}.mockup-tarifa-taxi-bogota .notice{display:none;margin-top:13px;background:#fff2d3;color:#674916;border-radius:12px;padding:11px 13px;font-size:12px;font-weight:800}
