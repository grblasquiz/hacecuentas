---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-tarifa-taxi-bogota" set:html={`<section class="hero"><div class="shell hero-grid"><div><div class="crumb">Colombia / Movilidad / Taxi en Bogotá</div><div class="eyebrow">Tarifas oficiales 2026</div><h1>Que el taxímetro no te tome por sorpresa.</h1><p class="lede">Calculá la tarifa de tu taxi en Bogotá, sumá cada recargo y entendé cuántas unidades debería marcar.</p><div class="chips"><span class="chip">1 unidad cada 100 m</span><span class="chip">Espera cada 24 segundos</span><span class="chip">Recargos separados</span></div></div><div class="art" aria-hidden="true"><div class="city"><i class="mountain"></i><i class="road"></i></div><div class="taxi"><i class="taxi-sign">TAXI</i><i class="wheel a"></i><i class="wheel b"></i></div><div class="meter">TOTAL ESTIMADO<strong>$ 20.624</strong></div></div></div></section>
<section class="section"><div class="shell"><div class="head"><div class="eyebrow">Empezá con un recorrido</div><h2>Elegí un caso o armá el tuyo</h2><p>Los cuatro escenarios quedan siempre a la vista. Podés modificar distancia, espera, nivel y recargos después.</p></div><div class="preset-grid">
<button class="preset active" data-preset="corta"><span>CORTA</span><strong>Trayecto de barrio</strong><small>3 km · sin espera</small></button>
<button class="preset" data-preset="media"><span>MEDIA</span><strong>Recorrido urbano</strong><small>8 km · 5 min de espera</small></button>
<button class="preset" data-preset="aeropuerto"><span>AEROPUERTO</span><strong>Hacia El Dorado</strong><small>14 km · con recargo</small></button>
<button class="preset" data-preset="noche"><span>NOCHE</span><strong>Salida nocturna</strong><small>10 km · recargo nocturno</small></button>
</div><div class="calc"><div class="panel"><h3>Calculá tu carrera</h3><p class="intro">Ingresá el recorrido estimado y activá solamente los recargos que correspondan.</p><div class="fields"><div class="field"><label for="km">Distancia del recorrido</label><input id="km" type="number" min=".1" step=".1" value="3"><div class="help">En kilómetros, según tu ruta estimada.</div></div><div class="field"><label for="espera">Minutos de espera</label><input id="espera" type="number" min="0" step="1" value="0"><div class="help">Tráfico detenido o espera del vehículo.</div></div><div class="field full"><label for="nivel">Nivel de servicio</label><select id="nivel"><option value="basico">Taxi básico · unidad $159</option><option value="experiencial">Factor de excelencia · unidad $172</option></select></div></div><div class="toggle-title">Recargos aplicables</div><div class="toggle-grid"><button class="toggle" data-toggle="nocturno"><span class="box">✓</span><span><b>Nocturno / domingo</b><small>20:00 a 05:00 o festivo</small></span></button><button class="toggle" data-toggle="aeropuerto"><span class="box">✓</span><span><b>Aeropuerto</b><small>El Dorado o Puente Aéreo</small></span></button><button class="toggle" data-toggle="puerta"><span class="box">✓</span><span><b>Puerta a puerta</b><small>Solicitud por teléfono o app</small></span></button></div><div class="buttons"><button class="primary" id="calculate">Actualizar tarifa</button><button class="secondary" id="reset">Reiniciar</button></div></div>
<div class="panel result" aria-live="polite"><div class="res-top"><div><div class="res-label">Total estimado</div><div class="amount" id="amount">$ 9.270</div></div><span class="badge" id="badge">58 unidades</span></div><p class="summary" id="summary">Carrera básica de 3 km, sin tiempo de espera ni recargos.</p><div class="metrics"><div class="metric"><span>Carrera base</span><strong id="base">$ 9.270</strong></div><div class="metric"><span>Recargos fijos</span><strong id="recargos">$ 0</strong></div><div class="metric"><span>Unidades por distancia</span><strong id="uDist">30</strong></div><div class="metric"><span>Unidades por espera</span><strong id="uWait">0</strong></div></div><div class="bar-title"><span>Carrera base</span><span>Recargos</span></div><div class="bar"><i class="basebar" id="basebar"></i><i class="recbar" id="recbar"></i></div><div class="detail"><div class="detail-row"><span>Banderazo · 28 unidades</span><strong id="banderazo">$ 4.500</strong></div><div class="detail-row"><span>Distancia recorrida</span><strong id="distancia">$ 4.770</strong></div><div class="detail-row"><span>Tiempo de espera</span><strong id="wait">$ 0</strong></div><div class="detail-row"><span>Recargos seleccionados</span><strong id="recDetail">$ 0</strong></div></div><div class="notice" id="notice">Se aplica la carrera mínima.</div></div></div></div></section>
<section class="section explain"><div class="shell"><div class="head"><div class="eyebrow">Así se forma la tarifa</div><h2>Del recorrido al precio final</h2></div><div class="steps"><article class="step"><span class="n">1</span><h3>Arranca el taxímetro</h3><p>El banderazo equivale a 28 unidades: $4.500 en taxi básico.</p></article><article class="step"><span class="n">2</span><h3>Suma recorrido</h3><p>Cada 100 metros agrega una unidad al valor de la carrera.</p></article><article class="step"><span class="n">3</span><h3>Suma espera</h3><p>Cada 24 segundos completos detenido agrega otra unidad.</p></article><article class="step"><span class="n">4</span><h3>Agrega recargos</h3><p>Nocturno, aeropuerto y puerta a puerta se suman al final.</p></article></div><div class="rates"><div class="rate-row head"><span>Concepto</span><span>Taxi básico</span><span>Excelencia</span></div><div class="rate-row"><span>Valor de una unidad</span><strong>$ 159</strong><strong>$ 172</strong></div><div class="rate-row"><span>Banderazo · 28 unidades</span><strong>$ 4.500</strong><strong>$ 4.800</strong></div><div class="rate-row"><span>Carrera mínima</span><strong>$ 8.000</strong><strong>$ 8.600</strong></div><div class="rate-row"><span>Nocturno / domingo / festivo</span><strong>$ 3.800</strong><strong>$ 4.100</strong></div><div class="rate-row"><span>Aeropuerto</span><strong>$ 8.000</strong><strong>$ 8.600</strong></div><div class="rate-row"><span>Puerta a puerta</span><strong>$ 1.400</strong><strong>$ 1.500</strong></div></div></div></section>
<section class="section"><div class="shell faq"><div class="head"><div class="eyebrow">Preguntas frecuentes</div><h2>Antes de subir al taxi</h2></div><div class="faq-item open"><button class="faq-q">¿Cuándo se cobra la carrera mínima?<span class="plus">+</span></button><div class="faq-a">Si banderazo, distancia y espera suman menos de $8.000 en nivel básico o $8.600 con factor de excelencia, se cobra ese mínimo antes de recargos.</div></div><div class="faq-item"><button class="faq-q">¿Los recargos se pueden acumular?<span class="plus">+</span></button><div class="faq-a">Sí. Si corresponden por las condiciones del viaje, el nocturno, aeropuerto y puerta a puerta pueden sumarse a la misma carrera.</div></div><div class="faq-item"><button class="faq-q">¿La calculadora reemplaza el taxímetro?<span class="plus">+</span></button><div class="faq-a">No. Es una estimación para controlar el orden de magnitud. La distancia real, las detenciones y las condiciones del servicio determinan la tarifa final.</div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-tarifa-taxi-bogota')?document.currentScript.previousElementSibling:document.querySelector('.mockup-tarifa-taxi-bogota');

(()=>{
const $=id=>root.querySelector("#"+id),cop=v=>'$ '+Math.round(v||0).toLocaleString('es-CO'),n=id=>Math.max(0,Number($(id).value)||0);
const rates={basico:{unit:159,flag:4500,min:8000,night:3800,airport:8000,door:1400},experiencial:{unit:172,flag:4800,min:8600,night:4100,airport:8600,door:1500}};
const presets={corta:{km:3,wait:0,level:'basico',on:[]},media:{km:8,wait:5,level:'basico',on:['puerta']},aeropuerto:{km:14,wait:8,level:'basico',on:['aeropuerto','puerta']},noche:{km:10,wait:4,level:'experiencial',on:['nocturno','puerta']}};
function enabled(id){return root.querySelector(`[data-toggle="${id}"]`).classList.contains('on')}
function compute(){const km=n('km'),wait=n('espera'),level=$('nivel').value,r=rates[level],ud=Math.round(km*10),uw=Math.floor(wait*60/24),distance=ud*r.unit,waiting=uw*r.unit,raw=r.flag+distance+waiting,base=Math.max(raw,r.min),isMin=raw<r.min,rec=(enabled('nocturno')?r.night:0)+(enabled('aeropuerto')?r.airport:0)+(enabled('puerta')?r.door:0),total=base+rec,totalU=28+ud+uw;
$('amount').textContent=cop(total);$('badge').textContent=totalU+' unidades';$('summary').textContent=`Carrera ${level==='basico'?'básica':'con factor de excelencia'} de ${km.toLocaleString('es-CO')} km${wait?`, con ${wait} min de espera`:''}${rec?' y recargos seleccionados':', sin recargos'}.`;$('base').textContent=cop(base);$('recargos').textContent=cop(rec);$('uDist').textContent=ud;$('uWait').textContent=uw;$('banderazo').textContent=cop(r.flag);$('distancia').textContent=cop(distance);$('wait').textContent=cop(waiting);$('recDetail').textContent=cop(rec);$('basebar').style.width=(base/Math.max(1,total)*100)+'%';$('recbar').style.width=(rec/Math.max(1,total)*100)+'%';$('notice').style.display=isMin?'block':'none';$('notice').textContent=`El cálculo por unidades da ${cop(raw)}; se aplica la carrera mínima de ${cop(r.min)}.`}
function setPreset(id){const p=presets[id];$('km').value=p.km;$('espera').value=p.wait;$('nivel').value=p.level;root.querySelectorAll('[data-toggle]').forEach(b=>b.classList.toggle('on',p.on.includes(b.dataset.toggle)));root.querySelectorAll('[data-preset]').forEach(b=>b.classList.toggle('active',b.dataset.preset===id));compute()}
root.querySelectorAll('[data-preset]').forEach(b=>b.addEventListener('click',()=>setPreset(b.dataset.preset)));root.querySelectorAll('[data-toggle]').forEach(b=>b.addEventListener('click',()=>{b.classList.toggle('on');root.querySelectorAll('[data-preset]').forEach(x=>x.classList.remove('active'));compute()}));root.querySelectorAll('input,select').forEach(x=>{x.addEventListener('input',compute);x.addEventListener('change',compute)});$('calculate').addEventListener('click',compute);$('reset').addEventListener('click',()=>setPreset('corta'));root.querySelectorAll('.faq-q').forEach(q=>q.addEventListener('click',()=>q.parentElement.classList.toggle('open')));setPreset('corta');
})();

})();
</script>
<style is:global>

.mockup-tarifa-taxi-bogota{--ink:#182231;--muted:#667385;--blue:#174b7a;--blue2:#eaf4fb;--yellow:#f6c744;--yellow2:#fff8dc;--mint:#3bb99a;--mint2:#e7f8f3;--coral:#e87c65;--line:#dce4e9;--paper:#fbfcfa;--white:#fff;--shadow:0 18px 48px rgba(23,75,122,.1)}
