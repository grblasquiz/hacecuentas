---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-sueldo-recargos-venezuela" set:html={`
<section class="hero"><div class="wrap"><div class="crumb"><b>Venezuela</b> / Trabajo / Sueldo y recargos</div><div class="hero-grid">
<div><div class="eyebrow">LOTTT · recibo del mes</div><h1>Tu sueldo no es solo el salario.</h1><p class="lead">Sumá horas extra, nocturnas, feriados, cestaticket y bono de guerra. Entendé cuánto te corresponde y qué parte realmente genera prestaciones.</p><div class="chips"><span class="chip">✓ Art. 117 · nocturno</span><span class="chip">✓ Art. 118 · extras</span><span class="chip">✓ Art. 120 · feriados</span></div>
<article class="month-card"><div class="month-top"><b>Tu ingreso · este mes</b><span class="live">Cálculo actualizado</span></div><div class="income"><strong id="hero-total">Bs. 99.475</strong><span id="hero-usd">USD 165,79</span></div><div class="coverage"><i id="coverage-bar"></i></div><div class="month-foot"><span>0% de la canasta</span><span id="coverage-label">33,2% cubierto</span><span>100%</span></div></article></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Armá tu recibo real</h2><p>Elegí tu caso y cargá los datos del mes.</p></div><span class="tag">Todo editable</span></div>
<div class="label">¿Cómo trabajaste este mes? · podés marcar varios</div><div class="cases"><button type="button" class="case" data-mode="normal"><i>○</i>Sin recargos</button><button type="button" class="case active" data-mode="extras"><i>＋</i>Horas extra</button><button type="button" class="case active" data-mode="night"><i>☾</i>Nocturno</button><button type="button" class="case active" data-mode="holiday"><i>◇</i>Feriados</button></div>
<div class="label">Tus datos</div><div class="fields">
<div class="field"><label>Salario normal mensual (Bs.)</label><input id="salary" inputmode="decimal" value="3000"></div><div class="field"><label>Horas de jornada diaria</label><input id="dayHours" inputmode="numeric" value="8"></div>
<div class="field mode extras"><label>Horas extra diurnas</label><input id="extraHours" inputmode="numeric" value="6"></div><div class="field mode night"><label>Horas nocturnas</label><input id="nightHours" inputmode="numeric" value="20"></div>
<div class="field mode holiday"><label>Feriados o domingos trabajados</label><input id="holidays" inputmode="numeric" value="2"></div><div class="field highlight"><label>Tasa BCV (Bs. por USD)</label><input id="bcv" inputmode="decimal" value="600"></div>
<div class="field"><label>Cestaticket del mes (USD)</label><input id="ticket" inputmode="decimal" value="40"></div><div class="field"><label>Bono de guerra (USD)</label><input id="warBonus" inputmode="decimal" value="120"></div>
<div class="field wide"><label>Canasta básica familiar (USD)</label><input id="basket" inputmode="decimal" value="500"></div></div>
<section class="result"><div class="result-top"><div><small>TU INGRESO TOTAL DEL MES</small><div class="value" id="total">Bs. 99.475</div><div class="usd" id="total-usd">≈ USD 165,79 a la tasa cargada</div></div><div class="result-side"><small>Canasta cubierta</small><b id="covered">33,2%</b></div></div><div class="stats"><span>VALOR HORA<b id="hour">Bs. 12,50</b></span><span>GENERA PRESTACIONES<b id="liability">3,5%</b></span><span>DESCANSOS GANADOS<b id="days-off">2 días</b></span></div><button class="go" id="update" type="button">Actualizar mi recibo</button></section>
</form></div></div></section>
<section class="section"><div class="wrap"><header class="section-head"><span>El ingreso, pieza por pieza</span><h2>Qué te pagan y qué genera prestaciones</h2><p>El salario y los recargos forman tu base laboral. El cestaticket y el bono completan el ingreso, pero no se cuentan igual.</p></header><div class="flow">
<article class="salary"><small>SALARIO NORMAL</small><b id="flow-salary">Bs. 3.000</b><p>Base de prestaciones</p></article><article class="extras"><small>RECARGOS DE JORNADA</small><b id="flow-extras">Bs. 475</b><p>Extras, noche y feriados</p></article><article class="ticket"><small>CESTATICKET</small><b id="flow-ticket">Bs. 24.000</b><p>No es salario</p></article><article class="war"><small>BONO DE GUERRA</small><b id="flow-war">Bs. 72.000</b><p>No es salario</p></article></div></div></section>
<section class="section tint"><div class="wrap detail-grid"><article class="card"><h3>Tu recibo, línea por línea</h3><div class="line"><span>Salario diario</span><b id="daily">Bs. 100</b></div><div class="line"><span>Hora extra diurna · +50%</span><b id="extra-value">Bs. 18,75</b></div><div class="line"><span>Pago por horas extra</span><b id="extra-pay">Bs. 112,50</b></div><div class="line"><span>Bono nocturno · +30%</span><b id="night-pay">Bs. 75</b></div><div class="line"><span>Feriados trabajados · día +50%</span><b id="holiday-pay">Bs. 300</b></div><div class="line"><span>Salario y recargos</span><b id="salary-plus">Bs. 3.487,50</b></div><div class="line"><span>Beneficios indexados</span><b id="indexed">Bs. 96.000</b></div><div class="line total"><strong>Total del mes</strong><b id="detail-total">Bs. 99.487,50</b></div></article>
<article class="card"><h3>Antes de comparar tu recibo</h3><div class="rule"><i>1</i><div><b>Usá la tasa BCV del día de pago</b><span>El mismo beneficio en dólares cambia de monto en bolívares según cuándo se acredita.</span></div></div><div class="rule"><i>2</i><div><b>Separá ingreso de salario</b><span>Cestaticket y bono suman al bolsillo, pero no elevan prestaciones, vacaciones ni utilidades.</span></div></div><div class="rule"><i>3</i><div><b>Guardá un registro de jornada</b><span>Fecha, horario y autorización ayudan a respaldar horas extra y trabajo nocturno.</span></div></div><div class="notice">Cálculo orientativo. Convenios, topes y situaciones particulares pueden cambiar el resultado; verificá con RR. HH. o un profesional.</div></article></div></section>
<section class="section"><div class="wrap"><header class="section-head"><span>Reglas que cambian la cuenta</span><h2>Tres recargos, tres tratamientos</h2></header><div class="metrics"><article class="metric"><i>＋</i><h3>Hora extra diurna</h3><p>Se paga a 1,5 veces la hora normal. La calculadora parte del salario mensual dividido por 30 y por tu jornada diaria.</p><em>LOTTT Art. 118 · +50%</em></article><article class="metric"><i>☾</i><h3>Bono nocturno</h3><p>Por cada hora entre las 7 p. m. y las 5 a. m. se suma un 30% sobre el valor de la hora normal.</p><em>LOTTT Art. 117 · +30%</em></article><article class="metric"><i>◇</i><h3>Feriado o descanso</h3><p>El día trabajado se paga con 50% de recargo. Si era tu descanso semanal, también corresponde compensatorio.</p><em>LOTTT Arts. 119–120</em></article></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sueldo-recargos-venezuela')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sueldo-recargos-venezuela');

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];
const n=id=>Math.max(0,parseFloat($(id).value.replace(",","."))||0);
const bs=v=>"Bs. "+new Intl.NumberFormat("es-VE",{maximumFractionDigits:2}).format(v);
const usd=v=>"USD "+new Intl.NumberFormat("es-VE",{minimumFractionDigits:2,maximumFractionDigits:2}).format(v);
const defaults={extras:6,night:20,holiday:2};
function calc(){
 const salary=n("#salary"),dayHours=Math.max(1,n("#dayHours")),extraHours=n("#extraHours"),nightHours=n("#nightHours"),holidays=n("#holidays"),bcv=n("#bcv"),ticket=n("#ticket"),war=n("#warBonus"),basket=n("#basket");
 const daily=salary/30,hour=daily/dayHours,extraValue=hour*1.5,extraPay=extraHours*extraValue,nightPay=nightHours*hour*.3,holidayPay=holidays*daily*1.5,recarges=extraPay+nightPay+holidayPay;
 const salaryPlus=salary+recarges,ticketBs=ticket*bcv,warBs=war*bcv,indexed=ticketBs+warBs,total=salaryPlus+indexed,totalUsd=bcv?total/bcv:0,covered=basket?totalUsd/basket*100:0,liability=total?salaryPlus/total*100:0;
 $("#total").textContent=bs(total);$("#total-usd").textContent="≈ "+usd(totalUsd)+" a la tasa cargada";$("#covered").textContent=covered.toFixed(1).replace(".",",")+"%";$("#hour").textContent=bs(hour);$("#liability").textContent=liability.toFixed(1).replace(".",",")+"%";$("#days-off").textContent=holidays+" "+(holidays===1?"día":"días");
 $("#hero-total").textContent=bs(total);$("#hero-usd").textContent=usd(totalUsd);$("#coverage-label").textContent=covered.toFixed(1).replace(".",",")+"% cubierto";$("#coverage-bar").style.width=Math.min(100,covered)+"%";
 $("#flow-salary").textContent=bs(salary);$("#flow-extras").textContent=bs(recarges);$("#flow-ticket").textContent=bs(ticketBs);$("#flow-war").textContent=bs(warBs);
 $("#daily").textContent=bs(daily);$("#extra-value").textContent=bs(extraValue);$("#extra-pay").textContent=bs(extraPay);$("#night-pay").textContent=bs(nightPay);$("#holiday-pay").textContent=bs(holidayPay);$("#salary-plus").textContent=bs(salaryPlus);$("#indexed").textContent=bs(indexed);$("#detail-total").textContent=bs(total);
}
function setMode(next){
 const map={extras:"#extraHours",night:"#nightHours",holiday:"#holidays"};
 if(next==="normal"){
  Object.values(map).forEach(id=>$(id).value=0);
  $$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode==="normal"));
 }else{
  const button=$(`[data-mode="${next}"]`),input=$(map[next]),turningOn=!button.classList.contains("active");
  button.classList.toggle("active",turningOn);input.value=turningOn?defaults[next]:0;
  $('[data-mode="normal"]').classList.toggle("active",!$$('.case[data-mode]:not([data-mode="normal"]).active').length);
  input.closest(".field").scrollIntoView({behavior:"smooth",block:"nearest"});
 }
 calc();
}
$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input").forEach(i=>i.oninput=calc);
$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Recibo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar mi recibo",1200)};
calc();

})();
</script>
