.mockup-credito-hipotecario .calc{background:#fff;border:1px solid var(--line);border-radius:25px;padding:25px;box-shadow:var(--shadow)}.mockup-credito-hipotecario .calcHead{display:flex;justify-content:space-between;gap:14px}.mockup-credito-hipotecario .calc h2{font-size:24px;letter-spacing:-.035em;margin:0}.mockup-credito-hipotecario .calcHead p{font-size:12px;color:var(--muted);margin:5px 0 0}.mockup-credito-hipotecario .live{background:var(--mint);color:#326d57;padding:7px 9px;border-radius:99px;font-size:9px;font-weight:950;height:max-content}.mockup-credito-hipotecario .modes{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:17px 0 13px}.mockup-credito-hipotecario .mode{border:1px solid var(--line);background:#fafcfc;border-radius:10px;padding:10px 5px;font-size:9px;font-weight:900;color:var(--muted);cursor:pointer}.mockup-credito-hipotecario .mode.active{background:var(--sky);border-color:#7ca6b8;color:#316b89}.mockup-credito-hipotecario .fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mockup-credito-hipotecario .field label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:900;margin-bottom:5px}.mockup-credito-hipotecario .input,.mockup-credito-hipotecario .field select{height:44px;width:100%;border:1px solid #d8dfdf;border-radius:10px;padding:0 10px;background:#fff;display:flex;align-items:center;gap:7px}.mockup-credito-hipotecario .input input{border:0;outline:0;width:100%;min-width:0;font-weight:850;color:var(--ink)}.mockup-credito-hipotecario .field select{font-weight:850;color:var(--ink)}.mockup-credito-hipotecario .primary{height:49px;width:100%;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:12px;cursor:pointer}.mockup-credito-hipotecario .result{margin-top:13px;background:var(--navy);color:#fff;border-radius:18px;padding:18px}.mockup-credito-hipotecario .resultTop{display:flex;justify-content:space-between;align-items:end;gap:10px