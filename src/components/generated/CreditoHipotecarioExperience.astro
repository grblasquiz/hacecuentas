<div class="mockup-credito-hipotecario" set:html={`<section class="hero"><div class="wrap"><div class="crumb">Inicio / Vivienda / Crédito hipotecario</div><div class="heroGrid"><div><span class="eyebrow">La cuota inicial es solo el comienzo</span><h1>¿Podés sostener el crédito, no solo conseguirlo?</h1><p class="lead">Calculá cuánto te prestan, la primera cuota y cómo podría evolucionar. Después compará UVA con tasa fija usando tus propios supuestos.</p><div class="trust"><span>✓ Cuota / ingreso visible</span><span>✓ UVA proyectada</span><span>✓ Anticipo considerado</span></div><div class="scene"><i class="home"></i><i class="key">⌕</i></div></div>
<div class="calc"><div class="calcHead"><div><h2 id="calcTitle">¿Cuánto te pueden prestar?</h2><p id="calcSubtitle">Partimos de la cuota que admite tu ingreso.</p></div><span class="live">SIMULACIÓN EN VIVO</span></div><div class="modes"><button class="mode active" data-mode="borrow">Cuánto me prestan</button><button class="mode" data-mode="payment">Cuánto pago</button><button class="mode" data-mode="compare">UVA vs. fija</button></div><div class="fields"><div class="field"><label>Ingreso neto familiar</label><div class="input"><span>$</span><input id="income" type="number" min="0" value="2800000"></div></div><div class="field"><label>Relación cuota / ingreso</label><select id="ratio"><option value=".2">20% · prudente</option><option value=".25" selected>25% · estándar</option><option value=".3">30% · exigente</option></select></div><div class="field"><label>Monto del crédito</label><div class="input"><span>$</span><input id="loan" type="number" min="0" value="85000000"></div></div><div class="field"><label>Plazo</label><div class="input"><input id="years" type="number" min="1" max="40" value="20"><span>años</span></div></div><div class="field"><label>TNA real del crédito UVA</label><div class="input"><input id="uvaRate" type="number" min="0" step=".05" value="5.5"><span>%</span></div></div><div class="field"><label>Inflación anual estimada</label><div class="input"><input id="inflation" type="number" min="0" step=".1" value="30"><span>%</span></div></div><div class="field"><label>TNA fija en pesos</label><div class="input"><input id="fixedRate" type="number" min="0" step=".1" value="42"><span>%</span></div></div><div class="field"><label>Anticipo disponible</label><select id="downPayment"><option value=".2">20%</option><option value=".25" selected>25%</option><option value=".3">30%</option></select></div></div><button class="primary" id="calculate">Actualizar simulación</button><div class="result"><div class="resultTop"><div><small id="resultLabel">CRÉDITO MÁXIMO ESTIMADO</small><div class="amount" id="headline">$101.710.000</div></div><span class="badge" id="status">Relación saludable</span></div><div class="resultGrid"><div class="metric"><span id="metricALabel">CUOTA MÁXIMA</span><b id="metricA">$700.000</b></div><div class="metric"><span id="metricBLabel">VALOR DE PROPIEDAD</span><b id="metricB">$135.613.000</b></div><div class="metric"><span id="metricCLabel">ANTICIPO NECESARIO</span><b id="metricC">$33.903.000</b></div></div><div class="ratioBar"><i id="ratioBar"></i></div><p class="note" id="note">La estimación usa sistema francés y no incluye seguros, gastos ni comisiones.</p></div></div></div></div></section>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Tres preguntas, en el orden correcto</span><h2>Empezá por la decisión que tenés hoy.</h2><p>Los datos se conservan al cambiar de vista para que puedas explorar sin volver a cargarlos.</p></div><div class="decisions"><article class="decision active" data-mode="borrow"><span>Punto de partida</span><h3>¿Cuánto me prestan?</h3><p>Convertí el límite de cuota de tu ingreso en monto de crédito.</p><b>Simular →</b></article><article class="decision" data-mode="payment"><span>Mi crédito</span><h3>¿Cuánto pago?</h3><p>Cuota inicial y una proyección simple con inflación.</p><b>Ver cuota →</b></article><article class="decision" data-mode="compare"><span>Alternativas</span><h3>¿UVA o tasa fija?</h3><p>Compará cuota inicial y costo nominal bajo tus supuestos.</p><b>Comparar →</b></article></div></div></section>
<section class="tint"><div class="wrap anatomy"><div><span class="eyebrow">Lo que la cuota esconde</span><h2>Al principio, casi todo es interés.</h2><p>En el sistema francés la cuota en UVAs es estable, pero su composición cambia: al comienzo pesa más el interés y con los años aumenta la amortización de capital.</p><div class="warning"><b>UVA no significa cuota fija en pesos.</b> La cuota queda expresada en UVAs y sube en pesos cuando aumenta el valor de la unidad.</div></div><div class="paymentCard"><h3>Anatomía de la primera cuota</h3><div class="paymentRow"><span>Interés</span><b id="interestPart">$389.583</b></div><div class="paymentRow"><span>Capital amortizado</span><b id="capitalPart">$194.414</b></div><div class="paymentRow"><span>Seguros estimados</span><b id="insurancePart">$8.500</b></div><div class="paymentStack"><i id="interestStack"></i><i id="capitalStack"></i><i></i></div><div class="legend"><span><i style="background:var(--gold)"></i>Interés</span><span><i style="background:var(--blue)"></i>Capital</span><span><i style="background:var(--green)"></i>Seguros</span></div></div></div></section>
<section class="compareSection"><div class="wrap compareGrid"><div><span class="eyebrow" style="color:var(--gold)">Sensibilidad, no predicción</span><h2>La inflación cambia la película.</h2><p>Probá distintos supuestos. La comparación no intenta adivinar veinte años: muestra qué variable hace que una alternativa gane o pierda.</p></div><div class="scenarioCards"><article class="scenario active"><span>CRÉDITO UVA</span><strong id="uvaScenario">$583.997</strong><p id="uvaScenarioText">Cuota inicial; en un año sería $759.196 con 30% de inflación.</p></article><article class="scenario"><span>TASA FIJA</span><strong id="fixedScenario">$2.983.247</strong><p>Cuota nominal inicial y futura estable, sujeta al contrato.</p></article></div></div></section>
<section><div class="wrap faq"><div class="sectionHead"><span class="eyebrow">Preguntas frecuentes</span><h2>Antes de firmar.</h2></div><div class="faqItem open"><button>¿Por qué miramos cuota sobre ingreso? <b>−</b></button><p>Porque es el criterio que muestra si el pago mensual entra de forma sostenible. Muchos bancos usan alrededor del 25%, aunque cada entidad define sus condiciones.</p></div><div class="faqItem"><button>¿La cuota UVA sube todos los meses? <b>+</b></button><p>La cuota permanece estable en UVAs, pero su valor en pesos cambia cuando se actualiza la unidad por CER.</p></div><div class="faqItem"><button>¿El anticipo es todo el efectivo necesario? <b>+</b></button><p>No. También hay escritura, tasación, comisión, impuestos y otros gastos que normalmente no se financian.</p></div><div class="faqItem"><button>¿Esta simulación es una oferta bancaria? <b>+</b></button><p>No. Es orientativa. La tasa, relación de ingresos, seguros y condiciones finales dependen de cada banco y contrato.</p></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-credito-hipotecario')?document.currentScript.previousElementSibling:document.querySelector('.mockup-credito-hipotecario');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR");let mode="borrow";const pmt=(pv,annual,months)=>{const r=annual/100/12;return r?pv*r*Math.pow(1+r,months)/(Math.pow(1+r,months)-1):pv/months},pvFromPayment=(pay,annual,months)=>{const r=annual/100/12;return r?pay*(Math.pow(1+r,months)-1)/(r*Math.pow(1+r,months)):pay*months};
function calc(){const income=Math.max(0,+$("#income").value||0),ratio=+$("#ratio").value,loan=Math.max(0,+$("#loan").value||0),years=Math.max(1,+$("#years").value||1),uva=Math.max(0,+$("#uvaRate").value||0),infl=Math.max(0,+$("#inflation").value||0),fixed=Math.max(0,+$("#fixedRate").value||0),down=+$("#downPayment").value,n=years*12,maxPay=income*ratio,uvaPay=pmt(loan,uva,n),fixedPay=pmt(loan,fixed,n),maxLoan=pvFromPayment(maxPay,uva,n),property=maxLoan/(1-down),downCash=property*down,yearPay=uvaPay*(1+infl/100),relation=income?uvaPay/income*100:0,insurance=loan*.0001,monthlyRate=uva/100/12,interest=loan*monthlyRate,capital=Math.max(0,uvaPay-interest);if(mode==="borrow"){$("#resultLabel").textContent="CRÉDITO MÁXIMO ESTIMADO";$("#headline").textContent=money(maxLoan);$("#metricALabel").textContent="CUOTA MÁXIMA";$("#metricA").textContent=money(maxPay);$("#metricBLabel").textContent="VALOR DE PROPIEDAD";$("#metricB").textContent=money(property);$("#metricCLabel").textContent="ANTICIPO NECESARIO";$("#metricC").textContent=money(downCash);$("#ratioBar").style.width=ratio*100+"%";setStatus(ratio*100)}else if(mode==="payment"){$("#resultLabel").textContent="PRIMERA CUOTA UVA ESTIMADA";$("#headline").textContent=money(uvaPay+insurance);$("#metricALabel").textContent="CUOTA EN 1 AÑO";$("#metricA").textContent=money(yearPay+insurance*(1+infl/100));$("#metricBLabel").textContent="CUOTA / INGRESO HOY";$("#metricB").textContent=relation.toLocaleString("es-AR",{maximumFractionDigits:1})+"%";$("#metricCLabel").textContent="TOTAL NOMINAL AÑO 1";$("#metricC").textContent=money((uvaPay+insurance)*12);$("#ratioBar").style.width=Math.min(100,relation)+"%";setStatus(relation)}else{$("#resultLabel").textContent="DIFERENCIA DE CUOTA INICIAL";$("#headline").textContent=money(Math.abs(fixedPay-uvaPay));$("#metricALabel").textContent="CUOTA UVA INICIAL";$("#metricA").textContent=money(uvaPay);$("#metricBLabel").textContent="CUOTA FIJA";$("#metricB").textContent=money(fixedPay);$("#metricCLabel").textContent="UVA EN 1 AÑO";$("#metricC").textContent=money(yearPay);$("#ratioBar").style.width=Math.min(100,uvaPay/fixedPay*100)+"%";$("#status").textContent=fixedPay>uvaPay?"UVA arranca más baja":"Fija arranca más baja";$("#status").style.background="#397b63"}$("#interestPart").textContent=money(interest);$("#capitalPart").textContent=money(capital);$("#insurancePart").textContent=money(insurance);const total=uvaPay+insurance;$("#interestStack").style.width=interest/total*100+"%";$("#capitalStack").style.width=capital/total*100+"%";$("#uvaScenario").textContent=money(uvaPay);$("#uvaScenarioText").textContent=`Cuota inicial; en un año sería ${money(yearPay)} con ${infl}% de inflación.`;$("#fixedScenario").textContent=money(fixedPay);$("#note").textContent=`Sistema francés a ${years} años. No incluye gastos de escritura, otorgamiento ni variaciones de ingreso.`}
function setStatus(r){$("#status").textContent=r<=25?"Relación saludable":r<=30?"Relación exigente":"Cuota muy alta";$("#status").style.background=r<=25?"#397b63":r<=30?"#927136":"#a84f49"}function setMode(m){mode=m;$$(".mode").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));$$(".decision").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));const copy={borrow:["¿Cuánto te pueden prestar?","Partimos de la cuota que admite tu ingreso."],payment:["¿Cuánto vas a pagar?","Proyectamos la primera cuota y su evolución."],compare:["UVA vs. tasa fija","Mismo monto y plazo, distinta lógica."]}[m];$("#calcTitle").textContent=copy[0];$("#calcSubtitle").textContent=copy[1];calc()}$$(".calc input,.calc select").forEach(x=>x.oninput=calc);$$(".mode").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$(".decision").forEach(b=>b.onclick=()=>{setMode(b.dataset.mode);$(".calc").scrollIntoView({behavior:"smooth"})});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Simulación actualizada";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".scenario").forEach(s=>s.onclick=()=>{$$(".scenario").forEach(x=>x.classList.toggle("active",x===s));toast("Escenario seleccionado: "+s.querySelector("span").textContent)});$$(".faqItem button").forEach(b=>b.onclick=()=>{const p=b.parentElement;p.classList.toggle("open");b.querySelector("b").textContent=p.classList.contains("open")?"−":"+"});$("#navSearch").onclick=()=>toast("Buscador listo");$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
