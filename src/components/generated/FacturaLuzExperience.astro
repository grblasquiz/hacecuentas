.mockup-factura-luz .calc{background:#fff;border:1px solid #dbe4e8;border-radius:21px;padding:27px 29px;box-shadow:0 27px 60px #193a5b18}.mockup-factura-luz .calc-head{display:flex;justify-content:space-between}.mockup-factura-luz .calc h2{font-size:24px;margin:0 0 5px}.mockup-factura-luz .muted{font-size:11px;color:#68798d;margin:0}.mockup-factura-luz .tag{background:#eaf1fb;color:#416da8;border-radius:99px;padding:7px 10px;font-size:9px;font-weight:850;height:max-content}.mockup-factura-luz .label{font-size:10px;font-weight:900;margin:18px 0 8px}.mockup-factura-luz .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.mockup-factura-luz .case{border:1px solid #dce5e9;background:#fff;border-radius:11px;padding:10px 4px;color:#54677d;font-size:9px;font-weight:800;cursor:pointer}.mockup-factura-luz .case i{display:block;font-style:normal;font-size:18px;margin-bottom:4px}.mockup-factura-luz .case.active{border:2px solid #5b83bd;background:#f0f5fc;color:#3d659e;padding:9px 3px}.mockup-factura-luz .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mockup-factura-luz .field{border:1px solid #dbe4e9;border-radius:11px;padding:10px 12px}.mockup-factura-luz .field label{display:block;color:#697b8e;font-size:9px;margin-bottom:5px}.mockup-factura-luz .field input,.mockup-factura-luz .field select{width:100%;border:0;outline:0;background:transparent;color:#152a43;font-weight:800}.mockup-factura-luz .field.hide{display:none}.mockup-factura-luz .result{background:#203d5b;color:#fff;border-radius:16px;padding:19px 20px;margin-top:13px}.mockup-factura-luz .result-top{display:flex;justify-content:space-between}.mockup-factura-luz .result small{color:#bfd0de;font-size:9px}.mockup-factura-luz .value{font-size:35px;font-weight:900;letter-spacing:-1.3px;margin-top:4px}.mockup-factura-luz .ratio{background:#edf3fc;color:#3e68a2;border-radius:9px;padding:8px 10px;text-align:right}.mockup-factura-luz .ratio small{color:inherit}.mockup-factura-luz .ratio b{display:block;font-size:13px}.mockup-factura-luz .stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #3c5874;margin-top:13px;padding-top:12px;gap:8px}.mockup-factura-luz .stats span{color:#b9cad8;font-size:8px}.mockup-factura-luz .stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.mockup-factura-luz .go{width:100%;border:0;border-radius:9px;padding:12px;margin-top:13px;background:linear-gradient(90deg,#507cb7,#72a0d2);color:#fff;font-weight:850;cursor:pointer}.mockup-factura-luz .section{padding:68px 0}.mockup-factura-luz .center{text-align:center;max-width:700px;margin:0 auto 35px}.mockup-factura-luz .center h2{font-size:36px;letter-spacing:-1.4px;margin:9px}.mockup-factura-luz .center p{color:#65768a}.mockup-factura-luz .bar{display:flex;height:52px;border-radius:13px;overflow:hidden;box-shadow:0 12px 30px #17385815}.mockup-factura-luz .bar i{display:grid;place-items:center;color:#fff;font-style:normal;font-size:9px;font-weight:850;min-width:5px}.mockup-factura-luz .energy{background:#4d79ab}.mockup-factura-luz .tax{background:#d97a73}.mockup-factura-luz .fixed{background:#e5b75a}.mockup-factura-luz .legend{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}.mockup-factura-luz .legend span{background:#f6f8fa;border-radius:10px;padding:12px;font-size:9px;color:#687a8d}.mockup-factura-luz .legend b{display:block;color:#1c334c;font-size:13px;margin-top:4px}.mockup-factura-luz .break{background:#f4f8fb;padding:64px 0}.mockup-factura-luz .cards{display:grid;grid-template-columns:1.08fr .92fr;gap:20px}.mockup-factura-luz .card{background:#fff;border:1px solid #dce5e9;border-radius:17px;padding:24px}.mockup-factura-luz .card h3{margin:0 0 16px;font-size:19px}.mockup-factura-luz .line{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #e6ebee}.mockup-factura-luz .line span{color:#65778b;font-size:10px}.mockup-factura-luz .line b{font-size:12px}.mockup-factura-luz .line.total{background:#eaf1fb;color:#3e68a3;margin-top:12px;padding:14px;border:0;border-radius:10px}.mockup-factura-luz .appliances{display:grid;gap:10px}.mockup-factura-luz .appliance{display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:10px}.mockup-factura-luz .appliance i{font-style:normal;width:42px;height:42px;border-radius:11px;background:#edf3fa;display:grid;place-items:center;font-size:20px}.mockup-factura-luz .appliance b{font-size:11px}.mockup-factura-luz .appliance span{font-size:9px;color:#718195}.mockup-factura-luz .appliance strong{font-size:11px}.mockup-factura-luz .warning{background:#fff5df;color:#76591f;border:1px solid #efd9a6;padding:12px;border-radius:10px;font-size:10px;margin-top:15px}.mockup-factura-luz .darksection{background:#19324d;color:#fff;padding:61px 0}.mockup-factura-luz .rules{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mockup-factura-luz .rule{border:1px solid #ffffff20;border-radius:15px;padding:18px}.mockup-factura-luz .rule i{font-style:normal;font-size:22px}.mockup-factura-luz .rule h3{font-size:13px;margin:10px 0 6px}.mockup-factura-luz .rule p{font-size:10px;line-height:1.55;color:#c3d0db;margin:0}
@media(max-width:800px){.mockup-factura-luz .links{display:none}.mockup-factura-luz .tools span:not(.dark){display:none}.mockup-factura-luz .grid,.mockup-factura-luz .cards{grid-template-columns:1fr}.mockup-factura-luz .copy{text-align:center}.mockup-factura-luz .copy h1{font-size:40px}.mockup-factura-luz .chips{justify-content:center}.mockup-factura-luz .art{max-width:460px;margin:auto}.mockup-factura-luz .calc{padding:20px 16px}.mockup-factura-luz .wrap{padding:0 15px}}@media(max-width:470px){.mockup-factura-luz .cases,.mockup-factura-luz .fields,.mockup-factura-luz .stats,.mockup-factura-luz .rules,.mockup-factura-luz .legend{grid-template-columns:1fr}.mockup-factura-luz .art{transform:scale(.82);transform-origin:left top;height:185px}}

.mockup-factura-luz { width:100%; overflow:hidden; }
.mockup-factura-luz .top, .mockup-factura-luz header.top { display:none !important; }
.mockup-factura-luz .foot { display:none !important; }
.mockup-factura-luz .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-factura-luz .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-factura-luz .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-factura-luz .support-real summary { cursor:pointer; font-weight:750; }
.mockup-factura-luz .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-factura-luz :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-factura-luz input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-factura-luz input[type="number"]::-webkit-inner-spin-button, .mockup-factura-luz input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-factura-luz .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-factura-luz support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
