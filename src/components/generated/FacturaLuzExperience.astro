---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-factura-luz" set:html={`<section class="hero"><div class="wrap crumb"><b>Hogar</b> &nbsp;/&nbsp; Factura de luz</div><div class="wrap grid"><div class="copy"><div class="eyebrow">Tu boleta, sin zonas oscuras</div><h1>Entendé por qué subió antes de empezar a apagar todo.</h1><p>Separá consumo, cargo fijo, subsidio e impuestos. Después identificá qué aparato mueve realmente la factura.</p><div class="chips"><span>✓ Factura desglosada</span><span>⚡ Costo por aparato</span><span>↘ Ahorro posible</span></div><div class="art"><div class="bill"><b>Factura de energía</b><i></i><i></i><i></i><i></i></div><div class="bolt">ϟ</div><div class="totalcard"><small>TOTAL ESTIMADO</small><strong id="art-total">$55.880</strong><span id="art-copy">por 350 kWh</span></div></div></div><form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Revisá tu consumo</h2><p class="muted">Elegí qué querés entender.</p></div><span class="tag">Tarifas 2026</span></div><div class="label">Tu pregunta</div><div class="cases"><button type="button" class="case active" data-mode="bill"><i>▤</i>Estimar factura</button><button type="button" class="case" data-mode="device"><i></i>Un aparato</button><button type="button" class="case" data-mode="standby"><i>◉</i>Consumo fantasma</button><button type="button" class="case" data-mode="led"><i>☼</i>Cambiar a LED</button></div><div class="label">Datos de energía</div><div class="fields"><div class="field" data-for="all"><label>Consumo del período</label><input id="kwh" value="350"></div><div class="field" data-for="all"><label>Distribuidora</label><select id="dist"><option value="145">Edenor</option><option value="151">Edesur</option></select></div><div class="field" data-for="bill"><label>Condición</label><select id="subsidy"><option value=".5">Con subsidio</option><option value="1">Tarifa plena</option></select></div><div class="field" data-for="bill"><label>Temporada</label><select id="season"><option value="350">Alta demanda</option><option value="300">Templada</option></select></div><div class="field hide" data-for="device"><label>Potencia del aparato</label><input id="watts" value="1500"></div><div class="field hide" data-for="device"><label>Horas de uso por día</label><input id="device-hours" value="4"></div><div class="field hide" data-for="standby"><label>Aparatos enchufados</label><input id="standby-count" value="8"></div><div class="field hide" data-for="standby"><label>Watts en espera por aparato</label><input id="standby-watts" value="4"></div><div class="field hide" data-for="led"><label>Cantidad de focos</label><input id="bulbs" value="10"></div><div class="field hide" data-for="led"><label>Watts del foco viejo</label><input id="old-watts" value="60"></div></div><section class="result"><div class="result-top"><div><small id="result-label">TOTAL ESTIMADO</small><div class="value" id="result">$55.880</div></div><div class="ratio"><small id="ratio-label">Precio efectivo</small><b id="ratio">$160/kWh</b></div></div><div class="stats"><span id="s1l">ENERGÍA<b id="s1">$38.000</b></span><span id="s2l">IMPUESTOS Y TASAS<b id="s2">$14.500</b></span><span id="s3l">SUBSIDIO ESTIMADO<b id="s3">$18.000</b></span></div><button class="go" id="update" type="button">Actualizar cálculo</button></section></form></div></section>
<section class="section"><div class="wrap"><div class="center"><div class="eyebrow">Peso por peso</div><h2 id="bar-title">Cómo se forma tu factura</h2><p id="bar-copy">El consumo no es el único componente del total.</p></div><div class="bar"><i class="energy" id="bar-energy">Energía</i><i class="tax" id="bar-tax">Impuestos</i><i class="fixed" id="bar-fixed">Cargo fijo</i></div><div class="legend"><span>ENERGÍA CONSUMIDA<b id="leg-energy">$38.000</b></span><span>IMPUESTOS Y TASAS<b id="leg-tax">$14.500</b></span><span>CARGO FIJO<b id="leg-fixed">$3.380</b></span></div></div></section><section class="break"><div class="wrap cards"><article class="card"><h3 id="detail-title">Tu boleta, línea por línea</h3><div class="line"><span id="d1l">Consumo del período</span><b id="d1">350 kWh</b></div><div class="line"><span id="d2l">Cargo fijo</span><b id="d2">$3.380</b></div><div class="line"><span id="d3l">Energía</span><b id="d3">$38.000</b></div><div class="line"><span id="d4l">Impuestos y tasas</span><b id="d4">$14.500</b></div><div class="line total"><strong id="d5l">Total estimado</strong><b id="d5">$55.880</b></div></article><article class="card"><h3>Qué suele pesar más</h3><div class="appliances"><div class="appliance"><i>❄</i><div><b>Aire acondicionado</b><span>Alto consumo por hora</span></div><strong>Revisá temperatura</strong></div><div class="appliance"><i>♨</i><div><b>Termotanque eléctrico</b><span>Consumo sostenido</span></div><strong>Programalo</strong></div><div class="appliance"><i>▣</i><div><b>Heladera</b><span>Funciona todo el día</span></div><strong>Chequeá burletes</strong></div></div><div class="warning">⚠️ Usá el precio efectivo de tu propia boleta para afinar el costo por aparato.</div></article></div></section><section class="darksection"><div class="wrap"><div class="rules"><div class="rule"><i>⚡</i><h3>Atacá los consumos grandes</h3><p>Una hora menos de aire mueve más que desenchufar cargadores durante semanas.</p></div><div class="rule"><i>◉</i><h3>El standby suma</h3><p>Muchos aparatos pequeños conectados todo el año forman un gasto visible.</p></div><div class="rule"><i>☼</i><h3>LED es ahorro directo</h3><p>La misma luz requiere una fracción de la potencia de una lámpara incandescente.</p></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-factura-luz')?document.currentScript.previousElementSibling:document.querySelector('.mockup-factura-luz');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0),ars=x=>"$"+Math.round(x).toLocaleString("es-AR");let mode="bill";function baseBill(){let k=n("#kwh"),price=Number($("#dist").value),sub=Number($("#subsidy").value),block=Number($("#season").value),fixed=3380,energy=Math.min(k,block)*price*sub+Math.max(0,k-block)*price,subtotal=fixed+energy,tax=subtotal*.356,total=subtotal+tax;return{k,price,fixed,energy,tax,total,save:Math.min(k,block)*price*(1-sub)}}function labels(result,ratio,s1,s2,s3,rows){let names={bill:["ENERGÍA","IMPUESTOS Y TASAS","SUBSIDIO ESTIMADO"],device:["POTENCIA","USO DIARIO","COSTO ANUAL"],standby:["APARATOS","POTENCIA FANTASMA","COSTO MENSUAL"],led:["FOCO ANTERIOR","LED EQUIVALENTE","AHORRO ANUAL"]}[mode];["s1l","s2l","s3l"].forEach((id,i)=>$("#"+id).childNodes[0].nodeValue=names[i]);$("#result").textContent=result;$("#art-total").textContent=result;$("#ratio").textContent=ratio;$("#s1").textContent=s1;$("#s2").textContent=s2;$("#s3").textContent=s3;rows.forEach((x,i)=>{$("#d"+(i+1)+"l").textContent=x[0];$("#d"+(i+1)).textContent=x[1]})}
function calc(){let b=baseBill(),total=b.total;if(mode==="bill"){labels(ars(total),ars(total/Math.max(1,b.k))+"/kWh",ars(b.energy),ars(b.tax),ars(b.save),[["Consumo del período",b.k+" kWh"],["Cargo fijo",ars(b.fixed)],["Energía",ars(b.energy)],["Impuestos y tasas",ars(b.tax)],["Total estimado",ars(total)]]);$("#result-label").textContent="TOTAL ESTIMADO";$("#art-copy").textContent="por "+b.k+" kWh"}if(mode==="device"){let w=n("#watts"),h=n("#device-hours"),km=w*h/1000*30,cost=km*(total/Math.max(1,b.k));labels(ars(cost),km.toFixed(1).replace(".",",")+" kWh/mes",w+" W",h+" h/día",ars(cost*12),[["Potencia",w+" W"],["Uso diario",h+" horas"],["Consumo mensual",km.toFixed(1)+" kWh"],["Costo anual",ars(cost*12)],["Costo mensual",ars(cost)]]);$("#result-label").textContent="COSTO MENSUAL DEL APARATO";$("#art-copy").textContent="un aparato en tu tarifa"}if(mode==="standby"){let c=n("#standby-count"),w=n("#standby-watts"),ka=c*w/1000*20*365,cost=ka*(total/Math.max(1,b.k));labels(ars(cost),ka.toFixed(0)+" kWh/año",c+" aparatos",c*w+" W",ars(cost/12)+"/mes",[["Aparatos",c],["Potencia fantasma",c*w+" W"],["Consumo anual",ka.toFixed(0)+" kWh"],["Costo mensual",ars(cost/12)],["Costo anual",ars(cost)]]);$("#result-label").textContent="COSTO ANUAL DEL STANDBY";$("#art-copy").textContent="consumo fantasma"}if(mode==="led"){let c=n("#bulbs"),old=n("#old-watts"),led=Math.max(3,Math.round(old/7)),saved=(old-led)*c*4*365/1000,cost=saved*(total/Math.max(1,b.k));labels(ars(cost),saved.toFixed(0)+" kWh/año",old+" W",led+" W",ars(cost),[["Focos a cambiar",c],["Potencia anterior",old+" W"],["LED equivalente",led+" W"],["Ahorro de energía",saved.toFixed(0)+" kWh"],["Ahorro anual",ars(cost)]]);$("#result-label").textContent="AHORRO ANUAL ESTIMADO";$("#art-copy").textContent="cambiando a LED"}$("#art-total").textContent=$("#result").textContent;let t=Math.max(1,b.total);$("#bar-energy").style.width=b.energy/t*100+"%";$("#bar-tax").style.width=b.tax/t*100+"%";$("#bar-fixed").style.width=b.fixed/t*100+"%";$("#leg-energy").textContent=ars(b.energy);$("#leg-tax").textContent=ars(b.tax);$("#leg-fixed").textContent=ars(b.fixed)}
function setMode(m){mode=m;$$(".case").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));$$(".field[data-for]").forEach(x=>x.classList.toggle("hide",!["all",m].includes(x.dataset.for)));calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Cálculo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar cálculo",1200)};calc();

})();
</script>
<style is:global>

