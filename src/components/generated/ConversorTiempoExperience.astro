ld{left:18px;color:#3182a0}.mockup-conversor-tiempo .warm{right:18px;color:#c26734}.mockup-conversor-tiempo .dial{width:215px;height:215px;border-radius:50%;border:18px solid var(--blue);display:grid;place-items:center;position:relative}.mockup-conversor-tiempo .dial i{position:absolute;width:7px;height:75px;background:var(--accent);bottom:50%;transform-origin:bottom;transform:rotate(35deg)}.mockup-conversor-tiempo .dial b{font-size:52px;margin-top:30px}.mockup-conversor-tiempo .dial small{position:absolute;bottom:38px}.mockup-conversor-tiempo .clockface{width:210px;height:210px;border:12px solid var(--blue);border-radius:50%;position:relative}.mockup-conversor-tiempo .clockface i,.mockup-conversor-tiempo .clockface b{position:absolute;left:50%;bottom:50%;width:7px;background:var(--accent);transform-origin:bottom}.mockup-conversor-tiempo .clockface i{height:72px;transform:rotate(90deg)}.mockup-conversor-tiempo .clockface b{height:55px;transform:rotate(10deg)}.mockup-conversor-tiempo .clock>span{position:absolute;bottom:24px;font-size:23px;font-weight:950}.mockup-conversor-tiempo .drop i{width:150px;height:190px;background:var(--accent);border-radius:70% 30% 70% 30%;transform:rotate(45deg)}.mockup-conversor-tiempo .drop span{position:absolute;color:#fff;font-size:32px;font-weight:950}.mockup-conversor-tiempo .bubble{position:absolute;padding:18px 24px;border-radius:24px;background:var(--soft);border:2px solid var(--accent);font-weight:950;font-size:23px}.mockup-conversor-tiempo .bubble.a{left:9%;top:20%}.mockup-conversor-tiempo .bubble.b{right:9%;top:34%}.mockup-conversor-tiempo .bubble.c{left:28%;bottom:16%}.mockup-conversor-tiempo .pages{width:240px;height:175px;display:flex;perspective:500px}.mockup-conversor-tiempo .pages i{width:50%;background:#fff;border:6px solid var(--blue)}.mockup-conversor-tiempo .pages i:first-child{transform:rotateY(14deg)}.mockup-conversor-tiempo .pages i:last-child{transform:rotateY(-14deg)}.mockup-conversor-tiempo .book>span{position:a