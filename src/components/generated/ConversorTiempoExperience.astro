.mockup-conversor-tiempo .tool{padding:62px 22px}.mockup-conversor-tiempo .tool-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.mockup-conversor-tiempo .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-conversor-tiempo .tool h2,.mockup-conversor-tiempo .guide h2{font-size:37px;letter-spacing:-.04em;margin:7px 0}.mockup-conversor-tiempo .tool-head p{max-width:510px;color:var(--muted);margin:0}.mockup-conversor-tiempo .workspace{display:grid;grid-template-columns:.88fr 1.12fr;gap:20px}.mockup-conversor-tiempo .panel{border-radius:24px;padding:27px}.mockup-conversor-tiempo .form{border:1px solid var(--line);box-shadow:0 16px 40px #18374a0c}.mockup-conversor-tiempo .panel h3{font-size:21px;margin:0 0 5px}.mockup-conversor-tiempo .hint{color:var(--muted);font-size:14px;margin:0 0 20px}.mockup-conversor-tiempo .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-conversor-tiempo .field{margin-bottom:2px}.mockup-conversor-tiempo .field label{display:flex;justify-content:space-between;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-conversor-tiempo .field output{color:var(--accent)}.mockup-conversor-tiempo input,.mockup-conversor-tiempo select{width:100%;min-height:49px;border:1px solid #ccd7da;border-radius:12px;background:#fff;padding:12px 14px;color:var(--ink)}.mockup-conversor-tiempo input[type=range]{padding:0;accent-color:var(--accent)}.mockup-conversor-tiempo .actions{display:flex;gap:9px;margin-top:21px}.mockup-conversor-tiempo .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:14px;font-weight:900;cursor:pointer}.mockup-conversor-tiempo .reset{border:1px solid #d7aa58;border-radius:12px;background:#fff;color:#654a1f;padding:13px 16px;font-weight:850;cursor:pointer}.mockup-conversor-tiempo .result{background:linear-gradient(145deg,var(--blue),color-mix(in srgb,var(--blue),var(--accent) 35%));color:#fff;position:relative;overflow:hidden}.mockup-conversor-tiempo .badge{display:inline-block;padding:7px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:950}.mockup-conversor-tiempo .big{font-size:48px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:14px 0 5px}.mockup-conversor-tiempo .caption{color:#dceaf0;font-size:14px}.mockup-conversor-tiempo .meter{height:13px;border-radius:99px;background:#ffffff2d;margin:24px 0;position:relative}.mockup-conversor-tiempo .meter i{position:absolute;left:var(--position);top:50%;width:24px;height:24px;border:5px solid #fff;background:var(--accent);border-radius:50%;transform:translate(-50%,-50%);transition:.25s}.mockup-conversor-tiempo .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.mockup-conversor-tiempo .metric{padding:13px;border:1px solid #ffffff2b;background:#ffffff0e;border-radius:13px}.mockup-conversor-tiempo .metric small{display:block;color:#dceaf0;font-size:10px}.mockup-conversor-tiempo .metric b{font-size:16px}.mockup-conversor-tiempo .note{margin-top:17px;padding:14px 15px;border-radius:12px;background:var(--cream);color:#58461f;font-size:13px}.mockup-conversor-tiempo .guide{padding:65px 22px;background:var(--paper)}.mockup-conversor-tiempo .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px}.mockup-conversor-tiempo .guide p{color:var(--muted)}.mockup-conversor-tiempo .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.mockup-conversor-tiempo .step{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff}.mockup-conversor-tiempo .step b{display:block;color:var(--accent);margin-bottom:5px}.mockup-conversor-tiempo .step span{font-size:14px;color:var(--muted)}.mockup-conversor-tiempo .foot{padding:30px;text-align:center;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-conversor-tiempo .nav{display:none}.mockup-conversor-tiempo .hero-grid,.mockup-conversor-tiempo .workspace,.mockup-conversor-tiempo .guide-grid{grid-template-columns:1fr}.mockup-conversor-tiempo .tool-head{flex-direction:column;align-items:start}}@media(max-width:550px){.mockup-conversor-tiempo .fields,.mockup-conversor-tiempo .metrics,.mockup-conversor-tiempo .steps{grid-template-columns:1fr}.mockup-conversor-tiempo .hero h1{font-size:43px}.mockup-conversor-tiempo .actions{flex-direction:column}.mockup-conversor-tiempo .art{height:290px}}

.mockup-conversor-tiempo { width:100%; overflow:hidden; }
.mockup-conversor-tiempo .top, .mockup-conversor-tiempo header.top { display:none !important; }
.mockup-conversor-tiempo .foot { display:none !important; }
.mockup-conversor-tiempo .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-conversor-tiempo .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-conversor-tiempo .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-conversor-tiempo .support-real summary { cursor:pointer; font-weight:750; }
.mockup-conversor-tiempo .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-conversor-tiempo :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-conversor-tiempo input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-conversor-tiempo input[type="number"]::-webkit-inner-spin-button, .mockup-conversor-tiempo input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-conversor-tiempo .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-conversor-tiempo support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
