---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-conversor-tiempo" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Conversores / Tiempo</div><div class="eyebrow">Duraciones comparables</div><h1>Convertí tiempo y ubicá cuánto representa.</h1><p class="lead">Segundos, horas, días, semanas o años: además del número, te mostramos una escala humana.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art clock"><div class="clockface"><i></i><b></b></div><span>90 min</span></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">duración interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="amount">Cantidad</label><input id="amount" type="number" value="90" min="0" max="10000000" step="0.01"></div><div class="field"><label for="from">Desde</label><select id="from"><option value="min">Minutos</option><option value="sec">Segundos</option><option value="hour">Horas</option><option value="day">Días</option><option value="week">Semanas</option><option value="year">Años</option></select></div><div class="field"><label for="to">Hacia</label><select id="to"><option value="hour">Horas</option><option value="min">Minutos</option><option value="day">Días</option><option value="week">Semanas</option><option value="year">Años</option></select></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-conversor-tiempo')?document.currentScript.previousElementSibling:document.querySelector('.mockup-conversor-tiempo');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const s={sec:1,min:60,hour:3600,day:86400,week:604800,year:31557600},n={sec:"segundos",min:"minutos",hour:"horas",day:"días",week:"semanas",year:"años"},sec=vn("amount")*s[v("from")],out=sec/s[v("to")];return {big:out.toLocaleString("es-AR",{maximumFractionDigits:4})+" "+n[v("to")],label:"Duración equivalente",badge:sec<3600?"Menos de una hora":sec<86400?"Dentro del día":sec<604800?"Varios días":"Escala larga",metrics:[["Horas",(sec/3600).toFixed(2)],["Días",(sec/86400).toFixed(2)],["Semanas",(sec/604800).toFixed(2)]],position:Math.min(100,Math.log10(sec+1)*15),note:sec<86400?"Podés leerlo dentro de un día completo.":"Para calendarios reales, los meses no tienen una duración fija; por eso usamos días y años promedio."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"amount":"90","from":"min","to":"hour"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
<style is:global>

