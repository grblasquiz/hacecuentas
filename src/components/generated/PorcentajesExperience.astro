.mockup-porcentajes .calc{background:#fff;border:1px solid #d8e4eb;border-radius:20px;padding:25px 27px;box-shadow:0 25px 60px #173b6418}.mockup-porcentajes .calc-title{display:flex;justify-content:space-between;gap:15px}.mockup-porcentajes .calc h2{font-size:23px;margin:0 0 4px}.mockup-porcentajes .calc-title p{font-size:10px;color:#60758c;margin:0}.mockup-porcentajes .tag{font-size:9px;color:#14775b;background:#e6f6ef;border-radius:99px;padding:7px 10px;font-weight:800;height:max-content}.mockup-porcentajes .section-label{font-size:10px;font-weight:850;margin:16px 0 8px}.mockup-porcentajes .cases{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.mockup-porcentajes .case{border:1px solid #dce5ec;background:#fff;border-radius:10px;padding:9px 5px;color:#52677f;font-size:8px;font-weight:750;min-height:61px}.mockup-porcentajes .case i{display:block;font-style:normal;font-size:15px;margin-bottom:3px}.mockup-porcentajes .case.active{border:2px solid #247fc1;background:#eff7fd;color:#166aa4}.mockup-porcentajes .fields{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.mockup-porcentajes .field{border:1px solid #dbe4eb;border-radius:10px;padding:9px 11px;min-height:58px}.mockup-porcentajes .field label{display:block;color:#63788e;font-size:8px;margin-bottom:5px}.mockup-porcentajes .field input{border:0;outline:0;background:none;width:100%;font-weight:750;font-size:13px;color:#142641}.mockup-porcentajes .field.hidden{opacity:.38}.mockup-porcentajes .result{background:#17324f;color:#fff;border-radius:15px;padding:18px 20px;margin-top:13px}.mockup-porcentajes .result-top{display:flex;justify-content:space-between;gap:14px}.mockup-porcentajes .result small{font-size:9px;color:#c5d3df}.mockup-porcentajes .value{font-size:35px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.mockup-porcentajes .formula{background:#eef2ff;color:#5368cb;border-radius:9px;padding:8px 11px;text-align:right}.mockup-porcentajes .formula small{color:inherit}.mockup-porcentajes .for