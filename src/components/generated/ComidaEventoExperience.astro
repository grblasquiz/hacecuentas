.mockup-comida-evento .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-comida-evento .support-real summary { cursor:pointer; font-weight:750; }
.mockup-comida-evento .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
