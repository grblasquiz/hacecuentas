---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-pisos" set:html={`
    <div class="wrap">
      <div class="hero"><div><div class="crumb">Construcción / Pisos</div><div class="eyebrow">Del ambiente al pedido del corralón</div><h1>Calculá cajas, no sólo metros cuadrados.</h1><p class="lead">Sumamos cortes, redondeamos a cajas enteras y te mostramos cuánto pegamento, pastina y zócalo necesitás.</p><div class="chips"><span class="chip">✓ Desperdicio incluido</span><span class="chip">✓ Cajas enteras</span><span class="chip">✓ Sobrante como repuesto</span></div></div><div class="visual"><div class="floor"><div class="tiles-art"></div></div><div class="piece"></div><div class="box">60 × 60<small>1,44 m² por caja</small></div><div class="note n1">20 m² + cortes</div><div class="note n2">Nunca mezcles lotes</div></div></div>
      <form class="calc" id="calculator"><div class="case-label">¿QUÉ VAS A COLOCAR?</div><div class="cases"><button type="button" class="case active" data-mode="ceramic">Cerámico</button><button type="button" class="case" data-mode="floating">Piso flotante</button><button type="button" class="case" data-mode="mosaic">Venecitas</button><button type="button" class="case" data-mode="wood">Machimbre</button><button type="button" class="case" data-mode="epoxy">Porcelanato líquido</button></div>
        <div class="grid"><div class="panel"><h2 id="formTitle">Medí el ambiente</h2><p class="hint" id="formHint">Si no es rectangular, dividilo en sectores y sumá las superficies.</p>
          <div class="fields"><div class="field"><label for="length">Largo (m)</label><input class="control" id="length" type="number" value="5" min="0" step=".1"></div><div class="field"><label for="width">Ancho (m)</label><input class="control" id="width" type="number" value="4" min="0" step=".1"></div></div>
          <div class="fields mode-only active" data-only="ceramic"><div class="field"><label for="format">Formato</label><select class="control" id="format"><option value="1.44">30 × 30 cm</option><option value="1.62">45 × 45 cm</option><option value="1.44" selected>60 × 60 cm</option><option value="1.44">60 × 120 cm</option><option value="1.28">80 × 80 cm</option></select></div><div class="field"><label for="boxArea">m² por caja</label><input class="control" id="boxArea" type="number" value="1.44" min=".1" step=".01"></div><div class="field"><label for="joint">Junta (mm)</label><input class="control" id="joint" type="number" value="3" min=".5" step=".5"></div><div class="field"><label for="glue">Encolado</label><select class="control" id="glue"><option value="4.5">Simple</option><option value="7.5">Doble encolado</option></select></div></div>
          <div class="fields mode-only" data-only="floating"><div class="field"><label for="laying">Colocación</label><select class="control" id="laying"><option value="5">Recta — 5%</option><option value="12">Diagonal — 12%</option></select></div><div class="field"><label for="floatingBox">m² por caja</label><input class="control" id="floatingBox" type="number" value="2.2" min=".1" step=".01"></div><div class="field full"><label for="doors">Puertas a descontar del zócalo</label><input class="control" id="doors" type="number" value="1" min="0"></div></div>
          <div class="fields mode-only" data-only="other"><div class="field full"><label for="waste">Desperdicio por cortes (%)</label><input class="control" id="waste" type="number" value="10" min="0" max="30"></div></div>
          <div class="fields mode-only" data-only="wood"><div class="field full"><label for="boardWidth">Ancho útil de tabla (cm)</label><input class="control" id="boardWidth" type="number" value="10" min="5" step=".5"></div></div>
          <div class="fields mode-only" data-only="epoxy"><div class="field full"><label for="thickness">Espesor de resina (mm)</label><input class="control" id="thickness" type="number" value="1.5" min=".5" max="5" step=".5"></div></div>
          <div class="fields mode-only active" data-only="priced"><div class="field full"><label for="price">Precio por caja ($)</label><input class="control" id="price" inputmode="numeric" value="45.000"></div></div>
          <button class="update" id="updateButton" type="submit">Actualizar cálculo</button>
        </div>
        <div class="panel result"><div class="kicker" id="kicker">PEDIDO AL CORRALÓN</div><div class="big" id="resultValue">16 cajas</div><div class="sub" id="resultSub">22 m² con desperdicio para un ambiente de 20 m²</div><div class="badge" id="resultBadge">Comprá todo del mismo lote</div><div class="tiles"><div class="tile"><small id="t1l">Superficie comprada</small><strong id="t1v">23,04 m²</strong></div><div class="tile"><small id="t2l">Te sobra</small><strong id="t2v">3,04 m²</strong></div><div class="tile"><small id="t3l">Costo cajas</small><strong id="t3v">$720.000</strong></div></div></div></div>
      </form>
    </div>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">El redondeo, explicado</div><h2>De los metros a la compra real</h2><p>Primero se suma el desperdicio. Después se redondea porque una caja cerrada no se divide.</p></div><div class="flow"><div class="flow-head"><div><h3 id="flowTitle">Cerámico 60 × 60</h3><p id="flowSub">Cada paso queda visible.</p></div><div class="flow-total" id="flowTotal">16 cajas</div></div><div class="steps"><div class="step"><small>1 · Ambiente</small><b id="s1">20 m²</b><span>Largo × ancho</span></div><div class="step"><small>2 · Con cortes</small><b id="s2">22 m²</b><span>Desperdicio incluido</span></div><div class="step"><small>3 · Compra</small><b id="s3">23,04 m²</b><span>Cajas enteras</span></div><div class="step"><small>4 · Reserva</small><b id="s4">3,04 m²</b><span>Para futuras roturas</span></div></div></div></div></section>
    <section><div class="wrap two"><div class="info"><div class="eyebrow">Lista completa</div><h3 id="breakTitle">Tu pedido al corralón</h3><div class="rows" id="breakRows"></div></div><div class="info notice"><div class="notice-icon">◉</div><h3>El lote importa tanto como la cantidad</h3><p>Dos cajas del mismo modelo pero de lotes distintos pueden cambiar de tono y calibre. Revisá el código impreso antes de retirarlas.</p><div class="rows"><div class="row"><span>Ambiente con muchos cortes</span><strong>Usá 15%</strong></div><div class="row"><span>Repuesto recomendado</span><strong>1 caja cerrada</strong></div></div></div></div></section>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Además del revestimiento</div><h2>Los materiales que suelen olvidarse</h2></div><div class="refs"><div class="ref"><div class="ref-icon">🧱</div><b>25 kg</b><span>Bolsa estándar de adhesivo</span></div><div class="ref"><div class="ref-icon">〰️</div><b>3 mm</b><span>Junta típica en porcelanato</span></div><div class="ref"><div class="ref-icon">📏</div><b>2,4 m</b><span>Varilla habitual de zócalo</span></div><div class="ref"><div class="ref-icon">📦</div><b>+10%</b><span>Desperdicio estándar</span></div></div></div></section>
    <div class="dark"><div class="wrap dark-grid"><div class="formula">m² × (1 + desperdicio)<span>÷ m² por caja → redondear ↑</span>= cajas a comprar<small>El sobrante no es un error: es la reserva del mismo lote.</small></div><div><div class="eyebrow" style="color:#6ad4c3">Antes de encargar</div><h2>La última caja es la que salva la obra.</h2><p>Verificá los m² reales de la etiqueta, el lote y el tipo de adhesivo compatible con la pieza.</p><div class="checks"><div class="check"><span class="tick">✓</span><span>Gran formato: revisá nivelación y doble encolado.</span></div><div class="check"><span class="tick">✓</span><span>Flotante: sumá manta y junta de dilatación.</span></div><div class="check"><span class="tick">✓</span><span>Epoxi: comprá kits completos y respetá el tiempo de trabajo.</span></div></div></div></div></div>
  `} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-pisos')?document.currentScript.previousElementSibling:document.querySelector('.mockup-pisos');

    const $=id=>root.querySelector("#"+id),fmt=(n,d=2)=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:d,minimumFractionDigits:d}),money=n=>"$"+Math.round(n).toLocaleString("es-AR"),digits=v=>Number(String(v).replace(/\D/g,""))||0;let mode="ceramic";
    const cfg={ceramic:["Medí el ambiente","Si no es rectangular, dividilo en sectores y sumá las superficies."],floating:["Calculá piso y zócalos","La colocación diagonal tiene más recortes que la recta."],mosaic:["Calculá las planchas de venecita","La malla estándar mide 30 × 30 cm y la pastina pesa mucho en la compra."],wood:["Calculá tablas de machimbre","Usá el ancho útil colocado, sin contar la lengüeta."],epoxy:["Calculá el kit de resina","El consumo cambia directamente con el espesor final."]};
    function set(id,v){$(id).textContent=v}function rows(a){$("breakRows").innerHTML=a.map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
    function common(title,total,area,withWaste,bought,left){set("flowTitle",title);set("flowTotal",total);set("s1",fmt(area)+" m²");set("s2",fmt(withWaste)+" m²");set("s3",fmt(bought)+" m²");set("s4",fmt(left)+" m²")}
    function calculate(){const L=Math.max(0,Number($("length").value)||0),W=Math.max(0,Number($("width").value)||0),area=L*W,waste=Math.max(0,Number($("waste").value)||10)/100,price=digits($("price").value);
      if(mode==="ceramic"){const box=Math.max(.01,Number($("boxArea").value)||Number($("format").value)||1.44),withWaste=area*1.1,boxes=Math.ceil(withWaste/box),bought=boxes*box,left=bought-area,glueRate=Number($("glue").value)||4.5,bags=Math.ceil(area*glueRate*1.1/25),joint=Math.max(.5,Number($("joint").value)||3),pastina=area*.136*(joint/3)*1.1;set("kicker","PEDIDO AL CORRALÓN");set("resultValue",boxes+" cajas");set("resultSub",`${fmt(withWaste)} m² con desperdicio para un ambiente de ${fmt(area)} m²`);set("resultBadge","Comprá todo del mismo lote");set("t1l","Superficie comprada");set("t1v",fmt(bought)+" m²");set("t2l","Te sobra");set("t2v",fmt(left)+" m²");set("t3l","Costo cajas");set("t3v",money(boxes*price));common("Cerámico o porcelanato",boxes+" cajas",area,withWaste,bought,left);rows([["Superficie del ambiente",fmt(area)+" m²"],["Desperdicio por cortes","10%"],["m² por caja",fmt(box)+" m²"],["Cajas a comprar",boxes],["Pegamento",bags+" bolsas de 25 kg"],["Pastina estimada",fmt(pastina,1)+" kg"],["Sobrante",fmt(left)+" m²"]])}
      if(mode==="floating"){const desp=Number($("laying").value)||5,box=Math.max(.01,Number($("floatingBox").value)||2.2),withWaste=area*(1+desp/100),boxes=Math.ceil(withWaste/box),bought=boxes*box,left=bought-area,doors=Math.max(0,Number($("doors").value)||0),zml=Math.max(0,2*(L+W)-doors*.8),bars=Math.ceil(zml*1.05/2.4);set("kicker","PISO FLOTANTE");set("resultValue",boxes+" cajas");set("resultSub",`${fmt(withWaste)} m² con ${desp}% de desperdicio`);set("resultBadge","Sumá la manta de base por separado");set("t1l","Zócalo");set("t1v",bars+" varillas");set("t2l","Te sobra");set("t2v",fmt(left)+" m²");set("t3l","Costo cajas");set("t3v",money(boxes*price));common("Piso flotante",boxes+" cajas",area,withWaste,bought,left);rows([["Superficie",fmt(area)+" m²"],["Colocación",desp===12?"Diagonal":"Recta"],["Cajas a comprar",boxes],["Zócalo neto",fmt(zml,1)+" m"],["Varillas de 2,4 m",bars],["Sobrante",fmt(left)+" m²"]])}
      if(mode==="mosaic"){const withWaste=area*(1+waste),sheets=Math.ceil(withWaste/.09),bought=sheets*.09,left=bought-area,pastina=Math.ceil(area*1.5*10)/10,adh=Math.ceil(area*4);set("kicker","VENECITAS EN MALLA");set("resultValue",sheets+" planchas");set("resultSub",`${fmt(area)} m² a revestir con ${Math.round(waste*100)}% de desperdicio`);set("resultBadge","En pileta usá productos impermeables");set("t1l","Pastina");set("t1v",fmt(pastina,1)+" kg");set("t2l","Adhesivo");set("t2v",adh+" kg");set("t3l","Te sobra");set("t3v",fmt(left)+" m²");common("Venecitas",sheets+" planchas",area,withWaste,bought,left);rows([["Superficie",fmt(area)+" m²"],["Plancha estándar","0,09 m²"],["Planchas a comprar",sheets],["Pastina",fmt(pastina,1)+" kg"],["Adhesivo",adh+" kg"],["Sobrante",fmt(left)+" m²"]])}
      if(mode==="wood"){const withWaste=area*(1+waste),bw=Math.max(1,Number($("boardWidth").value)||10),linear=withWaste/(bw/100),boards=Math.ceil(linear/3),bought=boards*3*bw/100,left=bought-area;set("kicker","MACHIMBRE");set("resultValue",boards+" tablas de 3 m");set("resultSub",`${fmt(linear,1)} metros lineales de tabla`);set("resultBadge","Usá el ancho útil, no el de catálogo");set("t1l","Con desperdicio");set("t1v",fmt(withWaste)+" m²");set("t2l","Comprado");set("t2v",fmt(bought)+" m²");set("t3l","Te sobra");set("t3v",fmt(left)+" m²");common("Machimbre",boards+" tablas",area,withWaste,bought,left);rows([["Superficie",fmt(area)+" m²"],["Desperdicio",Math.round(waste*100)+"%"],["Ancho útil",fmt(bw,1)+" cm"],["Metros lineales",fmt(linear,1)+" m"],["Tablas de 3 m",boards],["Sobrante",fmt(left)+" m²"]])}
      if(mode==="epoxy"){const thick=Math.max(.5,Number($("thickness").value)||1.5),resin=area*thick*1.1,primer=area*.2*1.1,sealer=area*.15*1.1;set("kicker","PORCELANATO LÍQUIDO");set("resultValue",fmt(resin,1)+" L de resina");set("resultSub",`${fmt(area)} m² a ${fmt(thick,1)} mm de espesor`);set("resultBadge","Comprá kits cerrados y redondeá hacia arriba");set("t1l","Primer");set("t1v",fmt(primer,1)+" L");set("t2l","Sellador UV");set("t2v",fmt(sealer,1)+" L");set("t3l","Desperdicio");set("t3v","10% incluido");common("Porcelanato líquido",fmt(resin,1)+" L",area,area*1.1,area*1.1,area*.1);rows([["Superficie",fmt(area)+" m²"],["Espesor",fmt(thick,1)+" mm"],["Resina epoxi",fmt(resin,1)+" L"],["Primer",fmt(primer,1)+" L"],["Sellador UV",fmt(sealer,1)+" L"],["Margen incluido","10%"]])}}
    root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".mode-only").forEach(x=>{const o=x.dataset.only;x.classList.toggle("active",o===mode||(o==="other"&&(mode==="mosaic"||mode==="wood"))||(o==="priced"&&(mode==="ceramic"||mode==="floating")))});set("formTitle",cfg[mode][0]);set("formHint",cfg[mode][1]);calculate()}));
    root.querySelectorAll("input[type=number],select").forEach(x=>x.addEventListener("input",calculate));$("price").addEventListener("input",e=>{const n=digits(e.target.value);e.target.value=n?n.toLocaleString("es-AR"):"";calculate()});function confirm(){calculate();$("updateButton").textContent="✓ Cálculo actualizado";clearTimeout(window.floorTimer);window.floorTimer=setTimeout(()=>$("updateButton").textContent="Actualizar cálculo",1200)}$("calculator").addEventListener("submit",e=>{e.preventDefault();confirm()});$("updateButton").addEventListener("click",e=>{e.preventDefault();confirm()});calculate();
  
})();
</script>
<style is:global>

    .mockup-pisos{--ink:#111a32;--muted:#667187;--blue:#2168e8;--teal:#24b3a1;--amber:#f1ae4c;--paper:#f6f6f2;--line:#dfe4ea;--navy:#10264a}
    .mockup-pisos *{box-sizing:border-box}.mockup-pisos{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-pisos button,.mockup-pisos input,.mockup-pisos select{font:inherit}.mockup-pisos .wrap{width:min(1180px,calc(100% - 40px));margin:auto}
    .mockup-pisos header{height:86px;border-bottom:1px solid #e0e4e7;display:flex;align-items:center}.mockup-pisos .nav{display:flex;align-items:center;gap:28px}.mockup-pisos .brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:900}.mockup-pisos .logo{width:29px;height:38px;border-radius:6px;background:linear-gradient(145deg,#18355c,#527a99);display:grid;place-items:center;color:white}.mockup-pisos .links{display:flex;gap:25px;color:#505b6d;font-size:14px;font-weight:750}.mockup-pisos .tools{margin-left:auto;display:flex;gap:9px}.mockup-pisos .tool{height:42px;padding:0 14px;border:1px solid #dce1e7;background:white;border-radius:11px;color:#526075;font-weight:750}
    .mockup-pisos .hero{display:grid;grid-template-columns:1.08fr .92fr;gap:45px;align-items:center;padding:62px 0 45px}.mockup-pisos .crumb{color:#3167c4;font-size:14px;margin-bottom:17px}.mockup-pisos .eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:#2274b7;font-weight:900}.mockup-pisos h1{font-size:clamp(43px,5vw,67px);line-height:1;letter-spacing:-.05em;margin:13px 0 20px}.mockup-pisos .lead{font-size:19px;color:var(--muted);max-width:690px}.mockup-pisos .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:25px}.mockup-pisos .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:9px 13px;font-size:13px;font-weight:800}
    .mockup-pisos .visual{height:330px;position:relative}.mockup-pisos .floor{position:absolute;left:25px;top:47px;width:325px;height:235px;background:#dce9ef;transform:skewY(-9deg);border-radius:18px;overflow:hidden;box-shadow:0 25px 55px #24385320}.mockup-pisos .tiles-art{position:absolute;inset:0;background:linear-gradient(90deg,transparent 49%,#fff 50%,transparent 51%),linear-gradient(0deg,transparent 49%,#fff 50%,transparent 51%);background-size:82px 82px}.mockup-pisos .box{position:absolute;right:2px;bottom:0;width:145px;height:105px;background:#1d65d6;border:7px solid #17385f;border-radius:12px;color:white;display:grid;place-items:center;text-align:center;font-weight:950;font-size:24px}.mockup-pisos .box small{font-size:11px;display:block}.mockup-pisos .piece{position:absolute;left:7px;top:8px;width:73px;height:73px;background:#f1b151;border:6px solid white;transform:rotate(-12deg);box-shadow:0 10px 25px #21355330}.mockup-pisos .note{position:absolute;background:#fff;border-radius:13px;padding:11px 14px;font-size:13px;font-weight:850;box-shadow:0 15px 34px #17385f1d}.mockup-pisos .n1{right:0;top:4px}.mockup-pisos .n2{left:0;bottom:3px;color:#1762d4}
    .mockup-pisos .calc{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 26px 70px #26354e13;margin-bottom:65px}.mockup-pisos .case-label{font-size:13px;font-weight:900;color:#5b677a;margin-bottom:11px}.mockup-pisos .cases{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:25px}.mockup-pisos .case{border:1px solid var(--line);border-radius:14px;background:#fafbfc;padding:13px 7px;font-size:13px;font-weight:850;color:#505d70;cursor:pointer}.mockup-pisos .case.active{background:#edf4ff;color:#1c60d2;border-color:#246be7;box-shadow:inset 0 0 0 1px #246be7}.mockup-pisos .grid{display:grid;grid-template-columns:1.04fr .96fr;gap:23px}.mockup-pisos .panel{background:#fafbfc;border:1px solid #e4e7ec;border-radius:20px;padding:24px}.mockup-pisos .panel h2{font-size:22px;margin:0 0 5px}.mockup-pisos .hint{font-size:14px;color:var(--muted);margin:0 0 20px}.mockup-pisos .fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.mockup-pisos .field.full{grid-column:1/-1}.mockup-pisos .field label{display:block;font-size:13px;font-weight:800;margin-bottom:7px}.mockup-pisos .control{width:100%;height:50px;border:1px solid #cad3dd;border-radius:11px;background:#fff;padding:0 13px;color:var(--ink);font-weight:750;outline:none}.mockup-pisos .control:focus{border-color:#286fe8;box-shadow:0 0 0 3px #286fe818}.mockup-pisos .mode-only{display:none}.mockup-pisos .mode-only.active{display:grid}.mockup-pisos .update{width:100%;height:53px;border:0;border-radius:12px;background:var(--blue);color:white;font-weight:900;margin-top:20px;cursor:pointer;box-shadow:0 10px 22px #1e67e82c}
    .mockup-pisos .result{background:linear-gradient(145deg,#102c55,#0b1c38);border:0;color:white;position:relative;overflow:hidden}.mockup-pisos .result:after{content:"";position:absolute;width:215px;height:215px;border:44px solid #45b8a721;border-radius:50%;right:-115px;bottom:-125px}.mockup-pisos .kicker{font-size:12px;text-transform:uppercase;letter-spacing:.13em;color:#a3ddd3;font-weight:900}.mockup-pisos .big{font-size:42px;line-height:1.07;font-weight:950;letter-spacing:-.04em;margin:14px 0 5px}.mockup-pisos .sub{color:#c3d2e4}.mockup-pisos .badge{display:inline-flex;margin-top:17px;padding:8px 11px;border-radius:99px;background:#1e4777;border:1px solid #3d6591;font-size:12px;font-weight:850}.mockup-pisos .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:24px}.mockup-pisos .tile{background:#ffffff0c;border:1px solid #ffffff18;border-radius:12px;padding:12px}.mockup-pisos .tile small{display:block;color:#adc0d6;text-transform:uppercase;font-size:10px;letter-spacing:.07em}.mockup-pisos .tile strong{display:block;margin-top:5px;font-size:15px}
