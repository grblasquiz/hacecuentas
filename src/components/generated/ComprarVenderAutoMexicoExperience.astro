<div class="mockup-comprar-vender-auto-mexico" set:html={`<section class="hero"><div class="wrap"><div class="crumb">México / Auto / Comprar o vender</div><div class="heroGrid"><div><span class="eyebrow">La cuenta completa del auto</span><h1>El precio de publicación es sólo el comienzo.</h1><p class="lead">Compará contado y crédito, calculá impuestos, estimá cuánto vale tu usado y conocé el costo de importar antes de cerrar la operación.</p><div class="chips"><span class="chip">Mensualidad real</span><span class="chip">CAT y seguro</span><span class="chip">ISAN</span><span class="chip">Depreciación e ISR</span></div></div><aside class="carCard"><div class="carTop"><b>ESCENARIO DE EJEMPLO</b><span>FINANCIADO CONVIENE</span></div><div class="car"><i class="bodyCar"></i><i class="window"></i><i class="wheel a"></i><i class="wheel b"></i></div><div class="carResult"><small>DIFERENCIA A 48 MESES</small><strong>$29,865 MXN</strong><p>El rendimiento estimado supera el costo financiero del escenario.</p></div></aside></div></div></section>
<section class="calc" id="calculadora"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">Primero elegí la decisión</span><h2>Comprar, financiar, vender o importar.</h2></div><p>Cada caso usa sólo los datos necesarios y muestra el costo final desglosado, sin esconder impuestos ni gastos.</p></div>
<div class="cases"><button class="case active" data-case="contado"><span class="caseCode">VS</span><b>Contado o crédito</b><span>Intereses contra rendimiento del dinero.</span></button><button class="case" data-case="credito"><span class="caseCode">CAT</span><b>Mensualidad real</b><span>Cuota, seguro e intereses totales.</span></button><button class="case" data-case="isan"><span class="caseCode">ISAN</span><b>Auto nuevo</b><span>Impuesto y precio final de agencia.</span></button><button class="case" data-case="vender"><span class="caseCode">ISR</span><b>Vender mi usado</b><span>Valor actual, ganancia e impuesto.</span></button><button class="case" data-case="importar"><span class="caseCode">US</span><b>Importar de EE.UU.</b><span>IGI, DTA, IVA y agente aduanal.</span></button></div>
<div class="workspace"><article class="card"><div class="caseNote" id="caseNote"></div><div class="fields" id="fields"></div><div class="error" id="error"></div><div class="actionsRow"><button class="primary" id="calculate">Actualizar cálculo</button><button class="secondary" id="reset">Restablecer</button></div><p class="fine">Estimación informativa. Las tasas, impuestos, placas, avalúos y condiciones del crédito deben verificarse en la cotización y con la autoridad aplicable.</p></article>
<aside class="card result" aria-live="polite"><div class="resultTop"><small>RESULTADO DEL ESCENARIO</small><span class="pill" id="pill"></span></div><div class="answer" id="answer"></div><div class="answerLabel" id="answerLabel"></div><div class="bar"><i id="b1"></i><i id="b2"></i><i id="b3"></i><i id="b4"></i></div><div class="legend" id="legend">Precio · entrada · costos · impuestos</div><div class="rows" id="rows"></div><div class="decision" id="decision"></div></aside></div></div></section>
<section class="guide"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">Antes de firmar</span><h2>Cuatro números que hay que pedir por escrito.</h2></div></div><div class="guideGrid"><article class="guideCard"><small>01 · CRÉDITO</small><h3>CAT, no sólo la tasa</h3><p>El CAT incorpora comisiones y otros costos. Compará la misma entrada y el mismo plazo.</p></article><article class="guideCard"><small>02 · SEGURO</small><h3>Prima durante todo el plazo</h3><p>La cobertura amplia suele ser obligatoria y puede cambiar mucho la mensualidad real.</p></article><article class="guideCard"><small>03 · COMPRA</small><h3>Precio final llave en mano</h3><p>Pedí que separen IVA, ISAN, placas, comisión de apertura y accesorios.</p></article><article class="guideCard"><small>04 · VENTA</small><h3>Valor neto que recibís</h3><p>Restá adeudos, comisión, reparación pendiente e impuesto estimado sobre la ganancia.</p></article></div></div></section>
<section class="compareSec"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">No compares sólo mensualidades</span><h2>Tres formas de tener auto.</h2></div><p>La opción más barata depende del uso, del plazo y de si podés deducir la operación.</p></div><div class="compareGrid"><article class="compareCard"><h3>Compra de contado</h3><p>Más capital inmovilizado, sin intereses.</p><ul><li>Propiedad inmediata</li><li>Sin CAT ni comisión financiera</li><li>Costo de oportunidad del dinero</li></ul></article><article class="compareCard"><h3>Crédito automotriz</h3><p>Conservás liquidez, pero asumís CAT y seguro.</p><ul><li>Enganche configurable</li><li>Auto queda como garantía</li><li>Mayor costo total</li></ul></article><article class="compareCard"><h3>Leasing o renting</h3><p>Puede servir a negocios que aprovechan deducciones.</p><ul><li>Cuota periódica</li><li>Condiciones de kilometraje</li><li>No siempre terminás siendo dueño</li></ul></article></div></div></section>
<section class="faqSec"><div class="wrap faq"><span class="eyebrow">Preguntas frecuentes</span><h2>Lo que más cambia la decisión</h2><div class="faqItem open"><button class="faqQ">¿Cuándo conviene pagar de contado?<span>−</span></button><div class="faqA">Cuando los intereses y costos del crédito superan lo que el dinero realmente rendiría invertido durante el mismo plazo, y pagar no compromete tu fondo de emergencia.</div></div><div class="faqItem"><button class="faqQ">¿La tasa anual y el CAT son lo mismo?<span>+</span></button><div class="faqA">No. La tasa mide intereses; el CAT intenta expresar el costo total anual incorporando comisiones y otros cargos para facilitar comparaciones.</div></div><div class="faqItem"><button class="faqQ">¿Cómo estimo el valor de mi usado?<span>+</span></button><div class="faqA">La depreciación sirve como primera referencia, pero hay que contrastarla con anuncios del mismo modelo, versión, año, kilometraje, historial y ciudad.</div></div><div class="faqItem"><button class="faqQ">¿Un auto importado siempre puede emplacarse?<span>+</span></button><div class="faqA">No. Antes de comprar verificá origen, antigüedad, pedimento, restricciones ambientales y requisitos de la entidad donde querés registrarlo.</div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-comprar-vender-auto-mexico')?document.currentScript.previousElementSibling:document.querySelector('.mockup-comprar-vender-auto-mexico');if(!root)return;

const $=id=>root.querySelector("#"+id),$$=s=>[...root.querySelectorAll(s)],mxn=n=>"$"+new Intl.NumberFormat("es-MX",{maximumFractionDigits:0}).format(Math.round(n)),pct=n=>new Intl.NumberFormat("es-MX",{maximumFractionDigits:2}).format(n)+"%",num=id=>Number($(id)?.value||0);let current="contado";
const configs={
contado:{note:"Compará el sobreprecio financiero contra lo que el enganche y las mensualidades podrían rendir invertidos.",pill:"CONTADO VS CRÉDITO",fields:[["price","Precio del auto",450000,"$"],["down","Enganche",20,"%"],["months","Plazo",48,"meses"],["rate","Tasa anual",14,"%"],["yield","Rendimiento CETES",7.1,"%"]]},
credito:{note:"La mensualidad visible debe sumar seguro y permitir ver cuánto terminás pagando por encima del precio.",pill:"MENSUALIDAD REAL",fields:[["price","Precio del auto",450000,"$"],["down","Enganche",20,"%"],["months","Plazo",48,"meses"],["cat","CAT anual",19,"%"],["insurance","Seguro anual",13,"%"]]},
isan:{note:"El ISAN se calcula sobre el precio sin IVA. Mostramos por separado precio, IVA, impuesto y total.",pill:"AUTO NUEVO · ISAN",fields:[["net","Precio sin IVA",420000,"$"],["vat","IVA",16,"%"]]},
vender:{note:"Estimá el valor actual por depreciación y comparalo contra tu precio de venta para detectar una ganancia gravable.",pill:"VENTA DE USADO",fields:[["original","Precio de compra",450000,"$"],["age","Antigüedad",4,"años"],["km","Kilometraje",68000,"km"],["depreciation","Depreciación anual",12,"%"],["sale","Precio de venta",260000,"$"],["improvements","Mejoras comprobables",15000,"$"]]},
importar:{note:"El precio en dólares se convierte a pesos y luego acumula IGI, DTA, IVA, honorarios y traslado.",pill:"IMPORTACIÓN DEFINITIVA",fields:[["usd","Valor del auto",12000,"US$"],["fx","Tipo de cambio",18.5,"MXN/USD"],["igi","IGI",10,"%"],["dta","DTA",0.8,"%"],["agent","Agente y traslado",42000,"$"]]}
};
function field([id,label,value,unit]){return `<div class="field"><label for="${id}">${label}</label><div class="control">${unit==="$"||unit==="US$"?`<span>${unit}</span>`:""}<input id="${id}" type="number" step="any" value="${value}">${unit!=="$"&&unit!=="US$"?`<span>${unit}</span>`:""}</div></div>`}
function row(k,v){return `<div class="row"><span>${k}</span><strong>${v}</strong></div>`}function fail(m){$("error").textContent=m;$("error").style.display="block";return false}function cuota(capital,rateMonthly,months){return rateMonthly===0?capital/months:capital*rateMonthly/(1-Math.pow(1+rateMonthly,-months))}
function paint(total,sub,rows,decision,parts){$("answer").textContent=total;$("answerLabel").textContent=sub;$("rows").innerHTML=rows;$("decision").innerHTML=decision;const sum=parts.reduce((a,b)=>a+Math.max(0,b),0)||1;["b1","b2","b3","b4"].forEach((id,i)=>$(id).style.width=(Math.max(0,parts[i]||0)/sum*100)+"%")}
function calculate(){const vals=[...$("fields").querySelectorAll("input")].map(i=>Number(i.value));if(vals.some(v=>!Number.isFinite(v)||v<0))return fail("Revisá los datos: todos deben ser números válidos y no negativos.");$("error").style.display="none";
if(current==="contado"){const p=num("price"),down=p*num("down")/100,m=Math.round(num("months")),annual=num("rate")/100,cap=p-down,pay=cuota(cap,annual/12,m),interest=pay*m-cap,opportunity=p*(Math.pow(1+num("yield")/100,m/12)-1),diff=interest-opportunity,win=diff>0?"CONTADO":"FINANCIADO";paint(mxn(Math.abs(diff)),win+" tiene una ventaja estimada en "+m+" meses",row("Enganche",mxn(down))+row("Mensualidad",mxn(pay))+row("Intereses totales",mxn(interest))+row("Rendimiento potencial",mxn(opportunity))+row("Pago total financiado",mxn(down+pay*m)),`<strong>${win==="CONTADO"?"Pagar de contado cuesta menos.":"Financiar conserva más valor."}</strong>${win==="CONTADO"?"Los intereses superan el rendimiento alternativo.":"El rendimiento estimado supera el costo financiero."}`,[down,cap,interest,opportunity])}
else if(current==="credito"){const p=num("price"),down=p*num("down")/100,m=Math.round(num("months")),cap=p-down,cat=num("cat")/100,monthly=Math.pow(1+cat,1/12)-1,pay=cuota(cap,monthly,m),insurance=p*num("insurance")/100/12,interest=pay*m-cap,total=down+(pay+insurance)*m;paint(mxn(pay+insurance),"mensualidad con seguro durante "+m+" meses",row("Enganche",mxn(down))+row("Monto financiado",mxn(cap))+row("Mensualidad sin seguro",mxn(pay))+row("Seguro mensual",mxn(insurance))+row("Intereses totales",mxn(interest))+row("Desembolso total",mxn(total)),`<strong>El auto termina costando ${mxn(total-p)} más.</strong>Pedí la tabla de amortización para comparar esta estimación con la oferta real.`,[down,cap,interest,insurance*m])}
else if(current==="isan"){const net=num("net"),vat=net*num("vat")/100;let isan=net<=356934?0:net<=452116?(7678+(net-383940)*.05)*.5:net<=537516?11518+(net-460728)*.10:19197+Math.max(0,net-537516)*.15;isan=Math.max(0,isan);const total=net+vat+isan;paint(mxn(total),"precio final estimado con IVA e ISAN",row("Precio sin IVA",mxn(net))+row("IVA",mxn(vat))+row("ISAN estimado",mxn(isan))+row("Precio final",mxn(total))+row("Tasa efectiva ISAN",pct(isan/net*100)),`<strong>${isan===0?"Este precio queda exento en la estimación.":"El ISAN representa "+pct(isan/net*100)+" del precio sin IVA."}</strong>Confirmá los umbrales del ejercicio y el desglose de la agencia.`,[net,vat,isan,0])}
else if(current==="vender"){const original=num("original"),age=Math.round(num("age")),km=num("km"),dep=num("depreciation")/100,market=original*(age>0?.8*Math.pow(1-dep,Math.max(0,age-1)):1),excess=Math.max(0,km-age*15000),kmPenalty=Math.min(.2,excess/100000),value=market*(1-kmPenalty),sale=num("sale"),gain=Math.max(0,sale-original-num("improvements")),exempt=118000,taxable=Math.max(0,gain-exempt),isr=taxable*.21,net=sale-isr;paint(mxn(net),"neto estimado después de ISR",row("Valor de mercado orientativo",mxn(value))+row("Precio de venta",mxn(sale))+row("Ganancia estimada",mxn(gain))+row("Ganancia exenta estimada",mxn(Math.min(gain,exempt)))+row("ISR estimado",mxn(isr))+row("Neto para vos",mxn(net)),`<strong>${Math.abs(sale-value)<value*.1?"Tu precio está cerca de la referencia.":sale>value?"Tu precio está arriba de la referencia.":"Tu precio está abajo de la referencia."}</strong>Contrastá modelo, versión, ciudad, estado y anuncios reales antes de publicar.`,[value,isr,Math.max(0,sale-value),0])}
else{const base=num("usd")*num("fx"),igi=base*num("igi")/100,dta=base*num("dta")/100,vat=(base+igi+dta)*.16,agent=num("agent"),total=base+igi+dta+vat+agent;paint(mxn(total),"costo estimado puesto en México",row("Valor convertido a MXN",mxn(base))+row("IGI",mxn(igi))+row("DTA",mxn(dta))+row("IVA de importación",mxn(vat))+row("Agente y traslado",mxn(agent))+row("Costo total",mxn(total)),`<strong>El sobrecosto es ${mxn(total-base)}.</strong>Antes de comprar, verificá origen, elegibilidad, pedimento y requisitos de emplacamiento en tu estado.`,[base,igi+dta,vat,agent])}}
function setCase(id){current=id;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.case===id));$("caseNote").textContent=configs[id].note;$("pill").textContent=configs[id].pill;$("fields").innerHTML=configs[id].fields.map(field).join("");$$("#fields input").forEach(i=>i.onkeydown=e=>{if(e.key==="Enter")calculate()});calculate()}
$$(".case").forEach(b=>b.onclick=()=>setCase(b.dataset.case));$("calculate").onclick=()=>{calculate();$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1100)};$("reset").onclick=()=>setCase("contado");$$(".faqQ").forEach(q=>q.onclick=()=>{const item=q.parentElement;item.classList.toggle("open");q.lastElementChild.textContent=item.classList.contains("open")?"−":"+"});setCase("contado");

})();
</script>
<style is:global>

