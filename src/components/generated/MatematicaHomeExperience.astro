.mockup-matematica-home section{padding:76px 0;background:#f8fafce8}.mockup-matematica-home .sectionHead{text-align:center;max-width:730px;margin:0 auto 38px}.mockup-matematica-home .sectionHead h2{font-size:40px;letter-spacing:-.045em;margin:10px 0}.mockup-matematica-home .sectionHead p{color:var(--muted);line-height:1.55}.mockup-matematica-home .needs{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.mockup-matematica-home .need{text-align:left;border:1px solid var(--line);background:#fff;border-radius:19px;padding:20px;min-height:185px;position:relative;color:var(--ink);cursor:pointer;transition:.2s}.mockup-matematica-home .need:hover,.mockup-matematica-home .need.active{transform:translateY(-3px);border-color:#7a9fc9;box-shadow:0 15px 35px #28476d15}.mockup-matematica-home .need.active{background:var(--navy);color:#fff}.mockup-matematica-home .need.active p{color:#c3d1dc}.mockup-matematica-home .icon{width:39px;height:39px;border-radius:11px;background:var(--soft);color:var(--blue);display:grid;place-items:center;font-weight:950}.mockup-matematica-home .need h3{font-size:16px;margin:16px 0 7px}.mockup-matematica-home .need p{font-size:10px;line-height:1.5;color:var(--muted);margin:0}.mockup-matematica-home .need em{position:absolute;right:16px;bottom:14px;font-style:normal;color:var(--coral);font-weight:950}
