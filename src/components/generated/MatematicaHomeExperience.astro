<div class="mockup-matematica-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Matemática</div><div class="heroGrid"><div><span class="eyebrow">Del problema a la cuenta</span><h1>No memorices la fórmula. Entendé qué estás buscando.</h1><p class="lead">Porcentajes, proporciones, geometría y probabilidad explicados paso a paso, con resultados que podés revisar.</p><div class="trust"><span>✓ Fórmula visible</span><span>✓ Paso a paso</span><span>✓ Distintas preguntas</span></div><div class="scene"><i class="board"></i><i class="formulaArt">x² + y²</i><i class="triangle"></i><i class="dots">∴</i></div></div>
<div class="calc"><div class="calcHead"><div><h2>Resolvé un porcentaje</h2><p>Elegí la pregunta que se parece a la tuya.</p></div><span class="live">RESULTADO EN VIVO</span></div><div class="modes"><button class="mode active" data-mode="part">X% de Y</button><button class="mode" data-mode="ratio">X es qué % de Y</button><button class="mode" data-mode="change">Variación %</button></div><div class="question" id="question">¿Cuánto es el 18% de 250?</div><div class="fields"><div class="field"><label id="labelA">Porcentaje</label><div class="input"><input id="a" type="number" step=".01" value="18"><span id="unitA">%</span></div></div><div class="field"><label id="labelB">Total</label><div class="input"><input id="b" type="number" step=".01" value="250"><span id="unitB"></span></div></div></div><button class="primary" id="calculate">Actualizar resultado</button><div class="result"><div class="resultTop"><div><small>RESULTADO</small><div class="amount" id="answer">45</div></div><span class="badge" id="modeLabel">Parte del total</span></div><div class="steps"><div class="step"><b id="stepOne">1.</b> <span id="stepOneText">Convertimos 18% en 0,18.</span></div><div class="step"><b id="stepTwo">2.</b> <span id="stepTwoText">Multiplicamos 0,18 × 250.</span></div></div><div class="formula" id="formula">18 ÷ 100 × 250 = 45</div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por el problema</span><h2>¿Qué tipo de cuenta necesitás?</h2><p>No hace falta conocer el nombre de la fórmula.</p></div><div class="needs"><button class="need active" data-filter="percent"><span class="icon">%</span><h3>Calcular porcentajes</h3><p>Partes, descuentos y variaciones.</p><em>→</em></button><button class="need" data-filter="geometry"><span class="icon">△</span><h3>Medir figuras</h3><p>Áreas, lados, ángulos y triángulos.</p><em>→</em></button><button class="need" data-filter="probability"><span class="icon">?</span><h3>Entender chances</h3><p>Casos posibles y probabilidad.</p><em>→</em></button><button class="need" data-filter="proportion"><span class="icon">⇄</span><h3>Resolver proporciones</h3><p>Regla de tres y escalas.</p><em>→</em></button><button class="need" data-filter="convert"><span class="icon">=</span><h3>Convertir unidades</h3><p>Longitud, medidas y equivalencias.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas matemáticas</span><h2>La cuenta, el resultado y el porqué.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="percent">Porcentajes</button><button class="filter" data-filter="geometry">Geometría</button><button class="filter" data-filter="probability">Probabilidad</button><button class="filter" data-filter="proportion">Proporciones</button><button class="filter" data-filter="convert">Unidades</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="percent proportion" data-text="porcentajes descuento aumento variacion regla tres"><span class="tag">La más práctica</span><h3>Calculadora de porcentajes</h3><p>Resolvé partes, proporciones, aumentos, descuentos y variaciones.</p><button>Calcular porcentaje →</button></article><article class="card" data-cat="geometry" data-text="triangulos trigonometria lados angulos seno coseno"><span class="tag">Geometría</span><h3>Triángulos y trigonometría</h3><p>Lados, ángulos, área, seno, coseno y tangente.</p><button>Resolver triángulo →</button></article><article class="card" data-cat="probability" data-text="probabilidad casos posibles combinaciones porcentaje"><span class="tag">Azar</span><h3>Probabilidad</h3><p>Casos favorables, combinaciones y eventos.</p><button>Calcular probabilidad →</button></article><article class="card" data-cat="proportion" data-text="regla de tres proporcion escala directa inversa"><span class="tag">Proporciones</span><h3>Regla de tres</h3><p>Relaciones directas e inversas paso a paso.</p><button>Resolver proporción →</button></article><article class="card" data-cat="convert" data-text="longitud metros centimetros pulgadas millas unidades"><span class="tag">Conversión</span><h3>Longitud y unidades</h3><p>Convertí medidas con la equivalencia visible.</p><button>Convertir →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="method"><div class="wrap methodGrid"><div><span class="eyebrow" style="color:var(--yellow)">Una forma simple de no perderse</span><h2>Pregunta, datos, operación.</h2><p>Antes de tocar la calculadora, nombrá qué buscás y qué información tenés. Elegir la operación correcta suele ser la parte más importante.</p></div><div class="methodSteps"><button class="methodStep active" data-step="Pregunta"><span><b>1. Escribí la pregunta</b><small>¿Qué valor concreto querés encontrar?</small></span><b>→</b></button><button class="methodStep" data-step="Datos"><span><b>2. Separá los datos</b><small>Identificá unidades y valores conocidos.</small></span><b>→</b></button><button class="methodStep" data-step="Control"><span><b>3. Revisá si tiene sentido</b><small>Estimá el orden de magnitud del resultado.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-matematica-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-matematica-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];let mode="part";const fmt=n=>Number.isFinite(n)?n.toLocaleString("es-AR",{maximumFractionDigits:4}):"No definido";function calc(){const a=+$("#a").value||0,b=+$("#b").value||0;let ans,q,s1,s2,f,label;if(mode==="part"){ans=a/100*b;q=`¿Cuánto es el ${fmt(a)}% de ${fmt(b)}?`;s1=`Convertimos ${fmt(a)}% en ${fmt(a/100)}.`;s2=`Multiplicamos ${fmt(a/100)} × ${fmt(b)}.`;f=`${fmt(a)} ÷ 100 × ${fmt(b)} = ${fmt(ans)}`;label="Parte del total"}else if(mode==="ratio"){ans=b? a/b*100:NaN;q=`¿Qué porcentaje representa ${fmt(a)} de ${fmt(b)}?`;s1=`Dividimos ${fmt(a)} por ${fmt(b)}.`;s2=`Multiplicamos el resultado por 100.`;f=`${fmt(a)} ÷ ${fmt(b)} × 100 = ${fmt(ans)}%`;label="Porcentaje del total"}else{ans=a? (b-a)/a*100:NaN;q=`¿Cuánto varió de ${fmt(a)} a ${fmt(b)}?`;s1=`Calculamos la diferencia: ${fmt(b)} − ${fmt(a)}.`;s2=`La dividimos por el valor inicial y multiplicamos por 100.`;f=`(${fmt(b)} − ${fmt(a)}) ÷ ${fmt(a)} × 100 = ${fmt(ans)}%`;label=ans>=0?"Aumento":"Disminución"}$("#question").textContent=q;$("#answer").textContent=fmt(ans)+(mode==="part"?"":"%");$("#stepOneText").textContent=s1;$("#stepTwoText").textContent=s2;$("#formula").textContent=f;$("#modeLabel").textContent=label}
$$(".calc input").forEach(x=>x.oninput=calc);$$(".mode").forEach(b=>b.onclick=()=>{mode=b.dataset.mode;$$(".mode").forEach(x=>x.classList.toggle("active",x===b));if(mode==="part"){$("#labelA").textContent="Porcentaje";$("#labelB").textContent="Total";$("#unitA").textContent="%"}else if(mode==="ratio"){$("#labelA").textContent="Parte";$("#labelB").textContent="Total";$("#unitA").textContent=""}else{$("#labelA").textContent="Valor inicial";$("#labelB").textContent="Valor final";$("#unitA").textContent=""}calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Resultado actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".methodStep").forEach(b=>b.onclick=()=>{$$(".methodStep").forEach(x=>x.classList.toggle("active",x===b));toast("Paso seleccionado: "+b.dataset.step)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
<style is:global>

