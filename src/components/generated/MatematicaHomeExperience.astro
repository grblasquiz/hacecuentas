.mockup-matematica-home .calc{background:#fff;border:1px solid var(--line);border-radius:25px;padding:25px;box-shadow:var(--shadow)}.mockup-matematica-home .calcHead{display:flex;justify-content:space-between;gap:14px}.mockup-matematica-home .calc h2{font-size:24px;letter-spacing:-.035em;margin:0}.mockup-matematica-home .calcHead p{font-size:12px;color:var(--muted);margin:5px 0 0}.mockup-matematica-home .live{background:var(--soft);color:#2e66a8;padding:7px 9px;border-radius:99px;font-size:9px;font-weight:950;height:max-content}.mockup-matematica-home .modes{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:17px 0 13px}.mockup-matematica-home .mode{border:1px solid var(--line);background:#fafcfd;border-radius:10px;padding:10px 4px;font-size:9px;font-weight:900;color:var(--muted);cursor:pointer}.mockup-matematica-home .mode.active{background:var(--soft);border-color:#7fa4d1;color:#2e64a3}.mockup-matematica-home .question{background:#f8fafc;border:1px solid var(--line);border-radius:12px;padding:12px;font-size:12px;font-weight:850;margin-bottom:10px}.mockup-matematica-home .fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mockup-matematica-home .field label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:900;margin-bottom:5px}.mockup-matematica-home .input{height:46px;width:100%;border:1px solid #d8dfe7;border-radius:10px;padding:0 10px;background:#fff;display:flex;align-items:center;gap:7px}.mockup-matematica-home .input input{border:0;outline:0;width:100%;min-width:0;font-weight:850;color:var(--ink);font-size:17px}.mockup-matematica-home .primary{height:49px;width:100%;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:950;margin-top:12px;cursor:pointer}.mockup-matematica-home .result{margin-top:13px;background:var(--navy);color:#fff;border-radius:18px;padding:18px}.mockup-matematica-home .resultTop{display:flex;justify-content:space-between;align-items:end;gap:1