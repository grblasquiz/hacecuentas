<div class="mockup-isr-cuenta-propia-mexico" set:html={`<section class="hero"><div class="wrap"><div class="crumb">México / Impuestos / ISR por mi cuenta</div><div class="heroGrid"><div><span class="eyebrow">Facturás por tu cuenta</span><h1>Del ingreso facturado al dinero que realmente te queda.</h1><p class="lead">Compará regímenes, calculá retenciones y entendé el pago mensual de ISR antes de emitir la factura o recibir el depósito.</p><div class="chips"><span class="chip">Honorarios</span><span class="chip">RESICO</span><span class="chip">Régimen general</span><span class="chip">Plataformas</span></div></div><aside class="invoice"><div class="invoiceTop"><b>FACTURA DE EJEMPLO</b><span>CLIENTE EMPRESA</span></div><div class="ticket"><div class="ticketHead"><div><small>SUBTOTAL</small><strong>$40,000</strong></div><small>MXN</small></div><div class="ticketRow"><span>IVA trasladado</span><b>+$6,400</b></div><div class="ticketRow"><span>ISR retenido</span><b>−$4,000</b></div><div class="ticketRow"><span>IVA retenido</span><b>−$4,267</b></div><div class="ticketTotal"><small>DEPÓSITO NETO</small><strong>$38,133</strong></div></div></aside></div></div></section>
<section class="calc" id="calculadora"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">¿Qué necesitás resolver?</span><h2>Todos los caminos del ISR, separados.</h2></div><p>Elegí tu caso. La cuenta muestra ingreso, IVA, gastos, impuesto, retenciones y neto sin mezclar conceptos.</p></div><div class="cases"><button class="case active" data-case="factura"><span class="caseCode">CFDI</span><b>Neto de honorarios</b><span>IVA y retenciones según el cliente.</span></button><button class="case" data-case="resico"><span class="caseCode">1%</span><b>Cuota RESICO</b><span>Tasa sobre ingreso cobrado.</span></button><button class="case" data-case="general"><span class="caseCode">ISR</span><b>Régimen general</b><span>Ingresos menos gastos deducibles.</span></button><button class="case" data-case="plataformas"><span class="caseCode">APP</span><b>Retención de app</b><span>Uber, Didi, Airbnb o marketplace.</span></button><button class="case" data-case="asimilados"><span class="caseCode">VS</span><b>Asimilados u honorarios</b><span>Comparación de neto mensual.</span></button></div>
<div class="workspace"><article class="card"><div class="caseNote" id="caseNote"></div><div class="fields" id="fields"></div><div class="error" id="error"></div><div class="actionsRow"><button class="primary" id="calculate">Actualizar cálculo</button><button class="secondary" id="reset">Restablecer</button></div><p class="fine">Estimación informativa. Verificá régimen, CFDI, acumulados, acreditamientos y obligaciones con un contador antes de presentar una declaración.</p></article><aside class="card result" aria-live="polite"><div class="resultTop"><small>RESULTADO DEL MES</small><span class="pill" id="pill"></span></div><div class="answer" id="answer"></div><div class="answerLabel" id="answerLabel"></div><div class="meter"><i id="m1"></i><i id="m2"></i><i id="m3"></i><i id="m4"></i></div><div class="meterLegend">Neto · ISR · IVA · gastos</div><div class="rows" id="rows"></div><div class="insight" id="insight"></div></aside></div></div></section>
<section class="compare"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">La diferencia está en la base</span><h2>RESICO y general no cobran sobre lo mismo.</h2></div></div><div class="compareGrid"><article class="compareCard"><small>RESICO</small><h3>Tasa baja sobre ingresos</h3><p>No resta gastos. Suele ser fuerte para servicios con márgenes altos y pocos costos deducibles.</p></article><article class="compareCard"><small>RÉGIMEN GENERAL</small><h3>Tarifa sobre utilidad fiscal</h3><p>Resta gastos indispensables con CFDI. Puede convenir cuando el negocio tiene costos elevados.</p></article><article class="compareCard"><small>RETENCIONES</small><h3>Son pagos a cuenta</h3><p>Lo que retiene una empresa o plataforma se acredita en la declaración; no es un impuesto adicional.</p></article></div></div></section>
<section class="calendar"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">Orden mensual</span><h2>Cuatro pasos para no perder el control.</h2></div></div><div class="calendarGrid"><article class="calendarCard"><b>01</b><h3>Separá el IVA</h3><p>No lo confundas con ingreso disponible.</p></article><article class="calendarCard"><b>02</b><h3>Guardá CFDI y pagos</h3><p>Un gasto sin requisitos puede no ser deducible.</p></article><article class="calendarCard"><b>03</b><h3>Conciliá retenciones</h3><p>Compará constancias contra depósitos y facturas.</p></article><article class="calendarCard"><b>17</b><h3>Fecha de referencia</h3><p>Los pagos mensuales suelen vencer el día 17 siguiente.</p></article></div></div></section>
<section class="faqSec"><div class="wrap faq"><span class="eyebrow">Preguntas frecuentes</span><h2>Lo que más se confunde</h2><div class="faqItem open"><button class="faqQ">¿Me conviene RESICO o régimen general?<span>−</span></button><div class="faqA">Depende de tu margen. RESICO aplica una tasa baja sobre ingresos sin deducir gastos; general aplica una tarifa más alta sobre la utilidad después de deducciones autorizadas.</div></div><div class="faqItem"><button class="faqQ">¿Las retenciones son un impuesto extra?<span>+</span></button><div class="faqA">No. Son anticipos acreditables contra el impuesto que te corresponde declarar.</div></div><div class="faqItem"><button class="faqQ">¿Qué pasa si no doy mi RFC a una plataforma?<span>+</span></button><div class="faqA">Las tasas de retención pueden aumentar de forma muy importante: el ejemplo calcula 20% de ISR y el IVA completo.</div></div><div class="faqItem"><button class="faqQ">¿Una persona física me retiene honorarios?<span>+</span></button><div class="faqA">Por regla general no aplica las retenciones de ISR e IVA que sí practica una persona moral en honorarios profesionales.</div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-isr-cuenta-propia-mexico')?document.currentScript.previousElementSibling:document.querySelector('.mockup-isr-cuenta-propia-mexico');if(!root)return;

const $=id=>root.querySelector("#"+id),$$=s=>[...root.querySelectorAll(s)],mxn=n=>"$"+new Intl.NumberFormat("es-MX",{maximumFractionDigits:0}).format(Math.round(n)),pct=n=>new Intl.NumberFormat("es-MX",{maximumFractionDigits:2}).format(n)+"%",num=id=>Number($(id)?.value||0);let current="factura";
const cfg={factura:{note:"De una factura a empresa cobrás subtotal más IVA, menos ISR y dos tercios del IVA retenidos. A persona física no le aplicamos esas retenciones.",pill:"HONORARIOS",fields:[["income","Subtotal sin IVA",40000,"$","number"],["client","Tipo de cliente","moral","","select",[["moral","Persona moral · empresa"],["physical","Persona física"]]],["regime","Tu régimen","general","","select",[["general","Régimen general"],["resico","RESICO"]]]]},resico:{note:"RESICO aplica una tasa de 1% a 2.5% sobre el ingreso cobrado completo. Los gastos no reducen esta base.",pill:"CUOTA RESICO",fields:[["income","Ingreso cobrado sin IVA",40000,"$","number"],["expenses","Gastos del mes",10000,"$","number"],["retained","ISR ya retenido",0,"$","number"]]},general:{note:"El régimen general calcula una utilidad fiscal: ingresos cobrados menos gastos deducibles, y aplica la tarifa progresiva mensual.",pill:"PAGO PROVISIONAL",fields:[["income","Ingreso cobrado sin IVA",40000,"$","number"],["expenses","Gastos deducibles",10000,"$","number"],["retained","ISR ya retenido",4000,"$","number"],["previous","Pagos previos acreditables",0,"$","number"]]},plataformas:{note:"La app retiene ISR según la actividad y parte del IVA. Sin RFC usamos las tasas más altas.",pill:"PLATAFORMA DIGITAL",fields:[["income","Ingreso antes de retenciones",40000,"$","number"],["activity","Actividad","transport","","select",[["transport","Transporte o entregas"],["lodging","Hospedaje"],["goods","Venta de bienes o servicios"]]],["rfc","¿RFC registrado?","yes","","select",[["yes","Sí"],["no","No"]]]]},asimilados:{note:"Comparamos el ISR sobre ingreso completo como asimilado contra honorarios en régimen general, donde sí se restan gastos.",pill:"ASIMILADOS VS HONORARIOS",fields:[["income","Ingreso mensual",40000,"$","number"],["expenses","Gastos deducibles",10000,"$","number"]]}};
function field([id,label,value,unit,type,options]){let c=type==="select"?`<select id="${id}">${options.map(o=>`<option value="${o[0]}"${o[0]===value?" selected":""}>${o[1]}</option>`).join("")}</select>`:`${unit==="$"?`<span>$</span>`:""}<input id="${id}" type="number" step="any" value="${value}">`;return `<div class="field"><label for="${id}">${label}</label><div class="control">${c}</div></div>`}function row(k,v){return `<div class="row"><span>${k}</span><strong>${v}</strong></div>`}function fail(m){$("error").textContent=m;$("error").style.display="block";return false}
const brackets=[[0,746.04,0,.0192],[746.05,6332.05,14.32,.064],[6332.06,11128.01,371.83,.1088],[11128.02,12935.82,893.63,.16],[12935.83,15487.71,1182.88,.1792],[15487.72,31236.49,1640.18,.2136],[31236.5,49233,5004.12,.2352],[49233.01,93993.9,9236.89,.3],[93993.91,125325.2,22665.17,.32],[125325.21,375975.61,32691.18,.34],[375975.62,1e20,117912.32,.35]];function tariff(base){if(base<=0)return 0;const b=brackets.find(x=>base>=x[0]&&base<=x[1])||brackets.at(-1);return b[2]+(base-b[0])*b[3]}function resicoRate(i){return i<=25000?.01:i<=50000?.011:i<=83333.33?.015:i<=208333.33?.02:.025}
function paint(total,label,rows,insight,parts){$("answer").textContent=total;$("answerLabel").textContent=label;$("rows").innerHTML=rows;$("insight").innerHTML=insight;const s=parts.reduce((a,b)=>a+Math.max(0,b),0)||1;["m1","m2","m3","m4"].forEach((id,i)=>$(id).style.width=Math.max(0,parts[i]||0)/s*100+"%")}
function calculate(){const inputs=[...$("fields").querySelectorAll("input")].map(i=>Number(i.value));if(inputs.some(v=>!Number.isFinite(v)||v<0))return fail("Revisá los datos: deben ser números válidos y no negativos.");$("error").style.display="none";
if(current==="factura"){const income=num("income"),iva=income*.16,moral=$("client").value==="moral",resico=$("regime").value==="resico",retIsr=moral?income*(resico?.0125:.10):0,retIva=moral?iva*2/3:0,net=income+iva-retIsr-retIva;paint(mxn(net),"depósito neto de una factura de "+mxn(income),row("Subtotal",mxn(income))+row("IVA trasladado",mxn(iva))+row("ISR retenido",mxn(retIsr))+row("IVA retenido",mxn(retIva))+row("Total facturado",mxn(income+iva))+row("Depósito neto",mxn(net)),`<strong>${moral?"El cliente retiene y entera impuestos.":"El cliente no practica retenciones."}</strong>Las retenciones son acreditables; no las trates como un costo perdido.`,[net,retIsr,retIva,0])}
else if(current==="resico"){const income=num("income"),rate=resicoRate(income),gross=income*rate,ret=Math.min(gross,num("retained")),due=Math.max(0,gross-ret),general=Math.max(0,tariff(Math.max(0,income-num("expenses")))),projection=income*12;paint(mxn(due),"ISR RESICO a pagar después de retenciones",row("Ingreso cobrado",mxn(income))+row("Tasa RESICO",pct(rate*100))+row("Cuota del mes",mxn(gross))+row("ISR retenido",mxn(ret))+row("Pago del mes",mxn(due))+row("General estimado",mxn(general)),`<strong>${gross<=general?"RESICO resulta menor en este escenario.":"El régimen general resulta menor con estos gastos."}</strong>${projection>3500000?" La proyección anual rebasa el tope de $3.5 millones.":" La proyección anual queda bajo el tope de $3.5 millones."}`,[income-due,due,0,num("expenses")])}
else if(current==="general"){const income=num("income"),expenses=num("expenses"),profit=Math.max(0,income-expenses),gross=tariff(profit),credits=num("retained")+num("previous"),due=Math.max(0,gross-credits),resico=income*resicoRate(income);paint(mxn(due),"pago provisional estimado del mes",row("Ingresos cobrados",mxn(income))+row("Gastos deducibles",mxn(expenses))+row("Utilidad fiscal",mxn(profit))+row("ISR por tarifa",mxn(gross))+row("Retenciones y pagos",mxn(credits))+row("ISR a pagar",mxn(due))+row("RESICO comparativo",mxn(resico)),`<strong>${resico<gross?"RESICO sería menor antes de acreditamientos.":"General aprovecha mejor tus deducciones."}</strong>El cálculo real suele ser acumulado y resta pagos anteriores.`,[Math.max(0,income-expenses-due),due,0,expenses])}
else if(current==="plataformas"){const income=num("income"),has=$("rfc").value==="yes",rates={transport:.021,lodging:.04,goods:.025},isr=income*(has?rates[$("activity").value]:.20),iva=income*.16,retIva=income*(has?.08:.16),net=income+iva-isr-retIva;paint(mxn(net),"depósito después de retenciones de la app",row("Ingreso sin IVA",mxn(income))+row("IVA cobrado",mxn(iva))+row("ISR retenido",mxn(isr))+row("IVA retenido",mxn(retIva))+row("Neto depositado",mxn(net))+row("Retención total",mxn(isr+retIva)),`<strong>${has?"Tu RFC evita las tasas de castigo.":"Registrar el RFC reduce fuertemente la retención."}</strong>Conservá la constancia mensual para acreditar lo retenido.`,[net,isr,retIva,0])}
else{const income=num("income"),expenses=num("expenses"),assimilated=tariff(income),honorarios=tariff(Math.max(0,income-expenses)),netA=income-assimilated,netH=income-expenses-honorarios,diff=netH-netA;paint(mxn(Math.abs(diff)),(diff>=0?"honorarios":"asimilados")+" deja más neto en este escenario",row("ISR como asimilado",mxn(assimilated))+row("Neto como asimilado",mxn(netA))+row("Gastos en honorarios",mxn(expenses))+row("ISR por honorarios",mxn(honorarios))+row("Neto honorarios",mxn(netH))+row("Diferencia",mxn(Math.abs(diff))),`<strong>${diff>=0?"Honorarios deja "+mxn(diff)+" más.":"Asimilados deja "+mxn(-diff)+" más."}</strong>La modalidad también cambia obligaciones, IVA y protección laboral.`,[Math.max(netA,netH),Math.min(assimilated,honorarios),0,expenses])}}
function setCase(id){current=id;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.case===id));$("caseNote").textContent=cfg[id].note;$("pill").textContent=cfg[id].pill;$("fields").innerHTML=cfg[id].fields.map(field).join("");$$("#fields input").forEach(i=>i.onkeydown=e=>{if(e.key==="Enter")calculate()});calculate()}$$(".case").forEach(b=>b.onclick=()=>setCase(b.dataset.case));$("calculate").onclick=()=>{calculate();$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1100)};$("reset").onclick=()=>setCase("factura");$$(".faqQ").forEach(q=>q.onclick=()=>{const item=q.parentElement;item.classList.toggle("open");q.lastElementChild.textContent=item.classList.contains("open")?"−":"+"});setCase("factura");

})();
</script>
