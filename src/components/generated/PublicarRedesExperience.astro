---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-publicar-redes" set:html={`<section class="hero"><div class="shell hero-grid"><div><div class="crumb">Negocios / Publicar en redes</div><div class="eyebrow">Plan editorial sostenible</div><h1>Publicá con un sistema, no con culpa.</h1><p class="lede">Convertí ideas originales en un calendario posible de producir y sostener semana a semana.</p><div class="chips"><span class="chip">Piezas originales</span><span class="chip">Contenido reutilizado</span><span class="chip">Horas reales de trabajo</span></div></div><div class="art" aria-hidden="true"><div class="orb"></div><div class="card-art"><div class="art-tag">PLAN SEMANAL</div><div class="art-value" id="heroValue">7 piezas</div><div class="art-line"></div></div></div></div></section><section class="section"><div class="shell"><div class="head"><div class="eyebrow">Elegí el canal principal</div><h2>Una frecuencia distinta para cada forma de comunicar</h2><p>Los presets son un punto de partida: adaptalos a tu capacidad y objetivo.</p></div><div class="cases"><button class="case active" data-case="0"><b>Instagram</b><small>Reels, carruseles, historias y conversación diaria.</small></button><button class="case" data-case="1"><b>TikTok</b><small>Más pruebas en video corto y producción ágil.</small></button><button class="case" data-case="2"><b>LinkedIn</b><small>Menos piezas, más profundidad y autoridad profesional.</small></button><button class="case" data-case="3"><b>Plan multicanal</b><small>Una idea central adaptada sin copiar exactamente lo mismo.</small></button></div><div class="calc"><div class="panel"><h3>Diseñá tu ritmo</h3><p class="intro" id="caseIntro">Mix sugerido: 2 videos, 1 carrusel y 4 historias o piezas breves.</p><div class="fields"><div class="field"><label for="originals">Ideas originales por semana</label><input id="originals" type="number" min="1" step="1" value="3"></div><div class="field"><label for="reuse">Adaptaciones por cada idea</label><input id="reuse" type="number" min="0" max="10" step="1" value="1"></div><div class="field"><label for="minutes">Minutos por pieza original</label><input id="minutes" type="number" min="1" step="5" value="55"></div><div class="field"><label for="community">Minutos semanales de comunidad</label><input id="community" type="number" min="0" step="10" value="90"></div><div class="field"><label for="weeks">Duración del plan (semanas)</label><input id="weeks" type="number" min="1" step="1" value="8"></div><div class="field"><label for="goal">Objetivo principal</label><select id="goal"><option>Vender</option><option>Crecer audiencia</option><option>Construir autoridad</option><option>Lanzar algo</option></select></div></div><div class="buttons"><button class="primary" id="calculate">Actualizar calendario</button><button class="secondary" id="reset">Reiniciar</button></div></div><div class="panel result" aria-live="polite"><div class="res-top"><div><div class="label">Piezas publicadas por semana</div><div class="amount" id="amount">—</div></div><span class="pill" id="scenario">Instagram</span></div><p class="summary" id="summary"></p><div class="metrics"><div class="metric"><span>Ideas originales</span><strong id="m1">—</strong></div><div class="metric"><span>Adaptaciones</span><strong id="m2">—</strong></div><div class="metric"><span>Trabajo semanal</span><strong id="m3">—</strong></div><div class="metric"><span>Total del plan</span><strong id="m4">—</strong></div></div><div class="progress"><i id="bar"></i></div><div class="note" id="note">Agrupá guiones, grabación y edición en bloques. Publicar menos de forma constante suele ser mejor que un pico imposible de sostener.</div></div></div></div></section><section class="section support"><div class="shell"><div class="head"><div class="eyebrow">Un calendario que trabaja</div><h2>Cada pieza necesita una función</h2></div><div class="support-grid"><article class="support-card"><span>DESCUBRIMIENTO</span><h3>Atraé a la persona correcta</h3><p>Problemas frecuentes, errores, comparaciones y demostraciones ayudan a que te encuentren.</p></article><article class="support-card"><span>CONFIANZA</span><h3>Mostrá criterio y prueba</h3><p>Casos, procesos, respuestas y detrás de escena convierten atención en credibilidad.</p></article><article class="support-card"><span>ACCIÓN</span><h3>Pedí un siguiente paso claro</h3><p>Reservar, comprar, consultar o guardar: cada publicación debería priorizar una acción.</p></article></div></div></section><section class="section"><div class="shell faq"><div class="head"><div class="eyebrow">Preguntas frecuentes</div><h2>Lo importante, sin vueltas</h2></div><div class="faq-item open"><button class="faq-q">¿Tengo que publicar todos los días?<span>+</span></button><div class="faq-a">No. La frecuencia útil es la que podés sostener con calidad y respuesta a la comunidad.</div></div><div class="faq-item"><button class="faq-q">¿Reutilizar es repetir?<span>+</span></button><div class="faq-a">No si adaptás formato, apertura, duración y llamada a la acción al contexto de cada canal.</div></div><div class="faq-item"><button class="faq-q">¿Cuándo aumento la frecuencia?<span>+</span></button><div class="faq-a">Cuando el proceso actual es sostenible y los datos muestran que más piezas aportan alcance, consultas o ventas.</div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-publicar-redes')?document.currentScript.previousElementSibling:document.querySelector('.mockup-publicar-redes');

(()=>{const $=id=>root.querySelector("#"+id),cases=["Instagram","TikTok","LinkedIn","Plan multicanal"],intros=["Mix sugerido: 2 videos, 1 carrusel y 4 historias o piezas breves.","Mix sugerido: videos cortos frecuentes, respuestas y variaciones de aperturas.","Mix sugerido: análisis, caso práctico y conversación profesional.","Mix sugerido: una idea central adaptada a tres contextos distintos."],presets=[[3,1,55,90],[4,1,35,75],[2,1,75,60],[3,3,65,120]];let active=0;const n=id=>Math.max(0,Number($(id).value)||0),hours=v=>v.toLocaleString("es-AR",{minimumFractionDigits:1,maximumFractionDigits:1})+" h";function compute(){const originals=Math.max(1,Math.round(n("originals"))),reuse=Math.round(n("reuse")),minutes=n("minutes"),community=n("community"),weeks=Math.max(1,Math.round(n("weeks"))),adaptations=originals*reuse,pieces=originals+adaptations,weeklyMinutes=originals*minutes+adaptations*12+community,totalPieces=pieces*weeks;$("amount").textContent=pieces+" piezas";$("heroValue").textContent=pieces+" piezas";$("scenario").textContent=cases[active];$("summary").textContent=`Para “${$("goal").value.toLowerCase()}”, vas a producir ${originals} ideas originales y convertirlas en ${adaptations} adaptaciones cada semana.`;$("m1").textContent=originals+" por semana";$("m2").textContent=adaptations+" por semana";$("m3").textContent=hours(weeklyMinutes/60);$("m4").textContent=totalPieces+" piezas · "+hours(weeklyMinutes*weeks/60);$("bar").style.width=Math.min(96,weeklyMinutes/6)+"%";$("note").textContent=weeklyMinutes>600?"El plan supera 10 horas semanales. Reducí piezas o aumentá reutilización para hacerlo sostenible.":"Reservá un bloque para crear, otro para adaptar y otro para responder a la comunidad."}function preset(i){active=i;["originals","reuse","minutes","community"].forEach((id,j)=>$(id).value=presets[i][j]);$("caseIntro").textContent=intros[i];root.querySelectorAll("[data-case]").forEach((b,j)=>b.classList.toggle("active",i===j));compute()}root.querySelectorAll("[data-case]").forEach(b=>b.addEventListener("click",()=>preset(Number(b.dataset.case))));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",compute));$("calculate").addEventListener("click",compute);$("reset").addEventListener("click",()=>{$("weeks").value=8;$("goal").value="Vender";preset(0)});root.querySelectorAll(".faq-q").forEach(q=>q.addEventListener("click",()=>q.parentElement.classList.toggle("open")));compute()})();

})();
</script>
<style is:global>

.mockup-publicar-redes{--ink:#182231;--muted:#657386;--blue:#174b7a;--blue2:#eaf4fb;--mint:#39b799;--mint2:#e7f8f3;--coral:#e77c67;--sun:#f4bd55;--line:#dce4e9;--paper:#fbfcfa;--white:#fff;--shadow:0 18px 48px rgba(23,75,122,.1)}.mockup-publicar-redes *{box-sizing:border-box}.mockup-publicar-redes{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-publicar-redes button,.mockup-publicar-redes input,.mockup-publicar-redes select{font:inherit}.mockup-publicar-redes .shell{max-width:1180px;margin:auto;padding:0 24px}.mockup-publicar-redes .header{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center}.mockup-publicar-redes .nav{display:flex;justify-content:space-between;align-items:center}.mockup-publicar-redes .brand{display:flex;align-items:center;gap:10px;font-weight:900}.mockup-publicar-redes .logo{width:31px;height:35px;border-radius:7px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:12px}.mockup-publicar-redes .links{display:flex;gap:24px;color:#526074;font-size:13px;font-weight:750}.mockup-publicar-redes .navbtn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 12px;color:#46566a}.mockup-publicar-redes .hero{padding:52px 0 47px;background:linear-gradient(135deg,#eef9f6,#fff7e7 58%,#edf6fb)}.mockup-publicar-redes .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:50px;align-items:center}.mockup-publicar-redes .crumb{color:var(--blue);font-size:13px;font-weight:800}.mockup-publicar-redes .eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:900;color:var(--blue);margin-top:18px}.mockup-publicar-redes .hero h1{font-size:52px;line-height:1.03;letter-spacing:-.05em;margin:12px 0 17px}.mockup-publicar-redes .lede{font-size:18px;line-height:1.55;color:#536174}.mockup-publicar-redes .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.mockup-publicar-redes .chip{background:#fff;border:1px solid #d4e2df;border-radius:99px;padding:8px 11px;font-size:11px;color:#46655e;font-weight:800}.mockup-publicar-redes .art{height:310px;position:relative}.mockup-publicar-redes .orb{position:absolute;width:265px;height:265px;border-radius:50%;right:35px;top:18px;background:#dceef2}.mockup-publicar-redes .card-art{position:absolute;left:20px;top:64px;width:250px;height:164px;border-radius:23px;background:#fff;border:3px solid var(--blue);box-shadow:14px 16px 0 rgba(57,183,153,.22);padding:25px}.mockup-publicar-redes .art-tag{font-size:10px;color:var(--blue);font-weight:900;letter-spacing:.08em}.mockup-publicar-redes .art-value{font-size:37px;font-weight:950;color:var(--blue);margin:17px 0}.mockup-publicar-redes .art-line{height:9px;border-radius:9px;background:linear-gradient(90deg,var(--mint) 0 67%,#e5ebee 67%)}.mockup-publicar-redes .section{padding:62px 0}.mockup-publicar-redes .head{text-align:center;max-width:790px;margin:0 auto 29px}.mockup-publicar-redes .head h2{font-size:36px;letter-spacing:-.04em;margin:8px 0}.mockup-publicar-redes .head p{color:var(--muted);line-height:1.6}.mockup-publicar-redes .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:22px}.mockup-publicar-redes .case{border:1px solid var(--line);background:#fff;border-radius:17px;padding:16px;text-align:left;cursor:pointer;color:var(--ink);min-height:108px}.mockup-publicar-redes .case.active{border:2px solid var(--blue);background:var(--blue2)}.mockup-publicar-redes .case b{display:block;font-size:13px;margin-bottom:6px}.mockup-publicar-redes .case small{color:var(--muted);font-size:10px;line-height:1.4}.mockup-publicar-redes .calc{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px;align-items:start}.mockup-publicar-redes .panel{background:#fff;border:1px solid var(--line);border-radius:23px;padding:27px;box-shadow:var(--shadow)}.mockup-publicar-redes .panel h3{font-size:21px;margin:0 0 7px}.mockup-publicar-redes .intro{font-size:13px;color:var(--muted);line-height:1.5;margin:0 0 20px}.mockup-publicar-redes .fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-publicar-redes .field.full{grid-column:1/-1}.mockup-publicar-redes .field label{display:block;font-size:12px;font-weight:850;margin-bottom:7px}.mockup-publicar-redes .field input,.mockup-publicar-redes .field select{width:100%;height:48px;border:1px solid #cbd5df;border-radius:12px;background:#fff;color:var(--ink);padding:0 12px;outline:none}.mockup-publicar-redes .field input:focus,.mockup-publicar-redes .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,75,122,.12)}.mockup-publicar-redes .buttons{display:flex;gap:9px;margin-top:20px}.mockup-publicar-redes .primary,.mockup-publicar-redes .secondary{border-radius:12px;padding:13px 16px;font-weight:900;cursor:pointer}.mockup-publicar-redes .primary{border:1px solid var(--blue);background:var(--blue);color:#fff;flex:1}.mockup-publicar-redes .secondary{border:1px solid #ccd6df;background:#fff;color:#47576b}.mockup-publicar-redes .result{background:linear-gradient(145deg,#174b7a,#287b9b);color:#fff}.mockup-publicar-redes .result .intro{color:#d8eaf2}.mockup-publicar-redes .res-top{display:flex;justify-content:space-between;gap:12px}.mockup-publicar-redes .label{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#c6e3ed;font-weight:900}.mockup-publicar-redes .amount{font-size:42px;font-weight:950;letter-spacing:-.05em;margin:9px 0}.mockup-publicar-redes .pill{height:max-content;background:#e5faf3;color:#155e4e;border-radius:99px;padding:8px 10px;font-size:10px;font-weight:900}.mockup-publicar-redes .summary{font-size:13px;line-height:1.55;color:#eff7f9}.mockup-publicar-redes .metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:17px}.mockup-publicar-redes .metric{border:1px solid rgba(255,255,255,.23);background:rgba(255,255,255,.1);border-radius:14px;padding:14px}.mockup-publicar-redes .metric span{display:block;color:#d3e7ee;font-size:10px}.mockup-publicar-redes .metric strong{display:block;color:#fff;font-size:18px;margin-top:4px}.mockup-publicar-redes .progress{height:12px;background:rgba(255,255,255,.18);border-radius:99px;overflow:hidden;margin-top:18px}.mockup-publicar-redes .progress i{display:block;height:100%;width:68%;background:var(--sun);border-radius:99px;transition:.25s}.mockup-publicar-redes .note{margin-top:14px;background:#fff2d7;color:#684817;border-radius:12px;padding:11px 13px;font-size:11px;font-weight:750}.mockup-publicar-redes .support{background:#f1f7f5}.mockup-publicar-redes .support-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-publicar-redes .support-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.mockup-publicar-redes .support-card span{display:inline-block;background:var(--mint2);color:#176d5b;border-radius:8px;padding:5px 7px;font-size:9px;font-weight:900}.mockup-publicar-redes .support-card h3{font-size:15px;margin:11px 0 6px}.mockup-publicar-redes .support-card p{font-size:11px;line-height:1.5;color:var(--muted);margin:0}.mockup-publicar-redes .faq{max-width:850px;margin:auto}.mockup-publicar-redes .faq-item{border-bottom:1px solid var(--line)}.mockup-publicar-redes .faq-q{width:100%;border:0;background:transparent;color:var(--ink);display:flex;justify-content:space-between;text-align:left;padding:19px 3px;font-weight:850;cursor:pointer}.mockup-publicar-redes .faq-a{display:none;color:var(--muted);line-height:1.6;padding:0 35px 18px 3px}.mockup-publicar-redes .faq-item.open .faq-a{display:block}.mockup-publicar-redes .footer{height:100px;background:#fff;border-top:1px solid var(--line);display:grid;place-items:center;color:var(--muted);font-size:12px}@media(max-width:900px){.mockup-publicar-redes .links{display:none}.mockup-publicar-redes .hero-grid,.mockup-publicar-redes .calc{grid-template-columns:1fr}.mockup-publicar-redes .cases{grid-template-columns:1fr 1fr}.mockup-publicar-redes .support-grid{grid-template-columns:1fr}.mockup-publicar-redes .hero h1{font-size:43px}}@media(max-width:560px){.mockup-publicar-redes .shell{padding:0 16px}.mockup-publicar-redes .hero h1{font-size:35px}.mockup-publicar-redes .art{display:none}.mockup-publicar-redes .cases,.mockup-publicar-redes .fields,.mockup-publicar-redes .metrics{grid-template-columns:1fr}.mockup-publicar-redes .panel{padding:21px}.mockup-publicar-redes .res-top{display:block}.mockup-publicar-redes .pill{display:inline-block;margin-top:8px}}

.mockup-publicar-redes { width:100%; overflow:hidden; }
.mockup-publicar-redes .top, .mockup-publicar-redes header.top { display:none !important; }
.mockup-publicar-redes .foot { display:none !important; }
.mockup-publicar-redes .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-publicar-redes .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-publicar-redes .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-publicar-redes .support-real summary { cursor:pointer; font-weight:750; }
.mockup-publicar-redes .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-publicar-redes :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-publicar-redes input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-publicar-redes input[type="number"]::-webkit-inner-spin-button, .mockup-publicar-redes input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-publicar-redes .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-publicar-redes support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
