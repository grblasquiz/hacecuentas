---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-publicar-redes" set:html={`<div class="crumb">Negocios / Publicar en redes</div><h1>Una idea, adaptada. No copiada y pegada.</h1><p class="lead">Prepará el mensaje central y decidí qué versión necesita cada canal antes de programar.</p><section class="dispatch"><div class="draft"><h2>Mensaje madre</h2><textarea id="text">Lanzamos una guía práctica para poner precios sin perder margen.</textarea><label>Objetivo<select id="goal"><option>Visitas</option><option>Conversación</option><option>Ventas</option></select></label><label>Fecha de publicación<input id="date" type="date"></label><div class="preview"><b id="chars"></b><span id="tip"></span></div></div><aside class="channels"><h2>Versiones por canal</h2><div class="channel"><i>IG</i><span><b>Instagram</b><small>Gancho visual + carrusel</small></span><button class="on">Incluir</button></div><div class="channel"><i>LI</i><span><b>LinkedIn</b><small>Aprendizaje + contexto</small></span><button>Incluir</button></div><div class="channel"><i>TK</i><span><b>TikTok</b><small>Problema en 2 segundos</small></span><button>Incluir</button></div><div class="queue" id="queue"></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-publicar-redes')?document.currentScript.previousElementSibling:document.querySelector('.mockup-publicar-redes');

const $=x=>root.querySelector("#"+x);function render(){let text=$('text').value.trim(),n=text.length,goal=$('goal').value,active=[...root.querySelectorAll('.channel button.on')].map(x=>x.parentElement.querySelector('b').textContent),versions={Instagram:`Carrusel: “${text}” · Abrí con el problema, mostrá 3 pasos y cerrá con ${goal.toLowerCase()}.`,LinkedIn:`Post: contexto profesional → aprendizaje → “${text}” → pregunta concreta para generar ${goal.toLowerCase()}.`,TikTok:`Guion: problema en 2 segundos → demostración breve → resultado → CTA de ${goal.toLowerCase()}.`};$('chars').textContent=`${n} caracteres en el mensaje madre`;$('tip').textContent=n<50?'Sumá contexto suficiente para poder adaptarlo.':n>280?'Recortá la idea central antes de hacer versiones.':'Longitud útil para derivar formatos.';$('queue').innerHTML=active.length?active.map((x,i)=>`<div class=\"slot\"><span><b>${x}</b><br><small>${versions[x]}</small></span><b>${i*45} min</b></div>`).join(''):'<div class=\"slot\"><span>Elegí al menos un canal para generar su versión.</span></div>'}
root.querySelectorAll('.channel button').forEach(b=>b.onclick=()=>{b.classList.toggle('on');render()});$('text').oninput=render;$('goal').oninput=render;render();

})();
</script>
<style is:global>

.mockup-publicar-redes{--blue:#174b7a;--ink:#192a32;--muted:#65747c;--line:#d7e1df;--orange:#e47a45;--mint:#dff2e9;--paper:#f5f7f5}.mockup-publicar-redes *{box-sizing:border-box}.mockup-publicar-redes{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-publicar-redes button,.mockup-publicar-redes input,.mockup-publicar-redes select{font:inherit}.mockup-publicar-redes .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-publicar-redes .crumb{color:var(--blue);font-weight:850}.mockup-publicar-redes h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-publicar-redes .lead{font-size:18px;color:var(--muted)}.mockup-publicar-redes .dispatch{margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:20px}.mockup-publicar-redes .draft,.mockup-publicar-redes .channels{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-publicar-redes .draft textarea{width:100%;min-height:150px;border:1px solid var(--line);border-radius:14px;padding:14px;resize:vertical}.mockup-publicar-redes .draft label{display:block;font-weight:800;margin:14px 0}.mockup-publicar-redes .draft select,.mockup-publicar-redes .draft input{width:100%;border:1px solid var(--line);border-radius:10px;padding:10px}.mockup-publicar-redes .channel{display:grid;grid-template-columns:45px 1fr auto;gap:12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}.mockup-publicar-redes .channel i{width:40px;height:40px;border-radius:12px;background:var(--blue);color:#fff;display:grid;place-items:center;font-style:normal;font-weight:900}.mockup-publicar-redes .channel button{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px;color:var(--ink)}.mockup-publicar-redes .channel button.on{background:var(--mint);border-color:#79ba9e}.mockup-publicar-redes .preview{margin-top:20px;background:#fff2dd;border-radius:16px;padding:17px}.mockup-publicar-redes .preview b{display:block;color:var(--blue)}.mockup-publicar-redes .queue{margin-top:15px}.mockup-publicar-redes .slot{display:flex;justify-content:space-between;padding:10px;border-left:4px solid var(--orange);background:#fafcfb;margin-top:7px}@media(max-width:760px){.mockup-publicar-redes .dispatch{grid-template-columns:1fr}}
.mockup-publicar-redes { width:100%; overflow:hidden; }
.mockup-publicar-redes .top, .mockup-publicar-redes header.top { display:none !important; }
.mockup-publicar-redes .foot { display:none !important; }
.mockup-publicar-redes .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-publicar-redes .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-publicar-redes .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-publicar-redes .support-real summary { cursor:pointer; font-weight:750; }
.mockup-publicar-redes .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-publicar-redes :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-publicar-redes input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-publicar-redes input[type="number"]::-webkit-inner-spin-button, .mockup-publicar-redes input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-publicar-redes .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-publicar-redes support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
