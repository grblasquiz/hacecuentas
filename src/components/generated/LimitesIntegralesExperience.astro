---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-limites-integrales" set:html={`<div class="crumb">Matemática / Cálculo</div><h1>Aproximarse y acumular son dos formas de entender una curva.</h1><p class="lead">Alterná entre límite e integral: en uno acercás puntos; en el otro llenás el área con rectángulos.</p><div class="switch"><button class="on" data-mode="limit">Explorar límite</button><button data-mode="integral">Aproximar integral</button></div><section class="lab"><div class="graph"><svg id="svg" viewBox="0 0 700 450"></svg></div><aside class="control"><div id="limitCtl"><h2>Acercate a x = 1</h2><div class="field"><label>Distancia al punto <output id="epsOut"></output></label><input id="eps" type="range" min="-2" max="-0.02" step=".02" value="-1"></div><div class="big" id="limitVal"></div><div class="explain">La función puede tener un hueco y aun así acercarse a un valor preciso desde ambos lados.</div></div><div id="intCtl" class="hidden"><h2>Llená el área</h2><div class="field"><label>Rectángulos <output id="nOut"></output></label><input id="n" type="range" min="2" max="40" value="8"></div><div class="big" id="areaVal"></div><div class="explain">Más rectángulos reducen el espacio que queda entre la suma y la curva.</div></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-limites-integrales')?document.currentScript.previousElementSibling:document.querySelector('.mockup-limites-integrales');

let mode='limit';const $=x=>root.querySelector("#"+x),f=x=>.5*x*x+1;function draw(){let cx=350,cy=340,sx=80,sy=65,curve=[];for(let x=-4;x<=4;x+=.04)curve.push(`${cx+x*sx},${cy-f(x)*sy}`);let extras='';if(mode==='limit'){let e=+$('eps').value,x1=1+e,x2=1-e,y=f(x1);extras=`<line class="approach" x1="${cx+x1*sx}" y1="${cy-f(x1)*sy}" x2="${cx+x2*sx}" y2="${cy-f(x2)*sy}"/><circle class="hole" cx="${cx+sx}" cy="${cy-f(1)*sy}" r="9"/>`;$('epsOut').textContent=Math.abs(e).toFixed(2);$('limitVal').textContent=f(x1).toFixed(3)}else{let n=+$('n').value,w=3/n,sum=0;for(let i=0;i<n;i++){let x=i*w,y=f(x);sum+=y*w;extras+=`<rect class="rect" x="${cx+x*sx}" y="${cy-y*sy}" width="${w*sx}" height="${y*sy}"/>`}$('nOut').textContent=n;$('areaVal').textContent=sum.toFixed(3)}$('svg').innerHTML=`<line class="axis" x1="0" y1="${cy}" x2="700" y2="${cy}"/><line class="axis" x1="${cx}" y1="0" x2="${cx}" y2="450"/>${extras}<polyline class="curve" points="${curve.join(' ')}"/>`}
root.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode;root.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('on',x===b));$('limitCtl').classList.toggle('hidden',mode!=='limit');$('intCtl').classList.toggle('hidden',mode!=='integral');draw()});$('eps').oninput=draw;$('n').oninput=draw;draw();

})();
</script>
<style is:global>

.mockup-limites-integrales{--blue:#174b7a;--ink:#192932;--muted:#64747c;--line:#d8e1df;--violet:#7257a5;--orange:#e47a45;--paper:#f4f7f5}.mockup-limites-integrales *{box-sizing:border-box}.mockup-limites-integrales{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-limites-integrales button,.mockup-limites-integrales input,.mockup-limites-integrales select{font:inherit}.mockup-limites-integrales .shell{max-width:1180px;margin:auto;padding:34px 22px}.mockup-limites-integrales .crumb{color:var(--blue);font-weight:850}.mockup-limites-integrales h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-limites-integrales .lead{font-size:18px;color:var(--muted)}.mockup-limites-integrales .switch{display:flex;gap:8px;margin:25px 0}.mockup-limites-integrales .switch button{border:1px solid var(--line);border-radius:99px;background:#fff;padding:11px 17px;font-weight:850;color:var(--ink)}.mockup-limites-integrales .switch button.on{background:var(--blue);color:#fff}.mockup-limites-integrales .lab{display:grid;grid-template-columns:1fr 300px;gap:20px}.mockup-limites-integrales .graph,.mockup-limites-integrales .control{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-limites-integrales .graph svg{width:100%;height:450px}.mockup-limites-integrales .axis{stroke:#9bada8}.mockup-limites-integrales .curve{fill:none;stroke:var(--blue);stroke-width:5}.mockup-limites-integrales .approach{stroke:var(--orange);stroke-width:3;stroke-dasharray:8 7}.mockup-limites-integrales .rect{fill:#7257a544;stroke:var(--violet)}.mockup-limites-integrales .hole{fill:#fff;stroke:var(--orange);stroke-width:5}.mockup-limites-integrales .control h2{margin:0 0 18px}.mockup-limites-integrales .field{margin:18px 0}.mockup-limites-integrales .field label{display:flex;justify-content:space-between;font-weight:800}.mockup-limites-integrales .field input,.mockup-limites-integrales .field select{width:100%;margin-top:7px}.mockup-limites-integrales .field input{accent-color:var(--violet)}.mockup-limites-integrales .field select{border:1px solid var(--line);border-radius:10px;padding:10px}.mockup-limites-integrales .big{font-size:48px;font-weight:950;color:var(--violet)}.mockup-limites-integrales .explain{padding:15px;background:#fff2dd;border-radius:14px}.mockup-limites-integrales .hidden{display:none}@media(max-width:780px){.mockup-limites-integrales .lab{grid-template-columns:1fr}.mockup-limites-integrales .graph svg{height:350px}}
.mockup-limites-integrales { width:100%; overflow:hidden; }
.mockup-limites-integrales .top, .mockup-limites-integrales header.top { display:none !important; }
.mockup-limites-integrales .foot { display:none !important; }
.mockup-limites-integrales .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-limites-integrales .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-limites-integrales .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-limites-integrales .support-real summary { cursor:pointer; font-weight:750; }
.mockup-limites-integrales .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-limites-integrales :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-limites-integrales input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-limites-integrales input[type="number"]::-webkit-inner-spin-button, .mockup-limites-integrales input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-limites-integrales .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-limites-integrales support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
