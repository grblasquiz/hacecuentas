---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-gaming" set:html={`<section class="hero"><div class="wrap"><div class="crumb">Tecnología / Gaming / Rendimiento de PC</div><div class="hero-grid"><div><div class="eyebrow">Gaming y hardware</div><h1>Tu PC, medida en lo que realmente importa.</h1><p class="lead">Estimá FPS, detectá el cuello de botella, elegí la fuente correcta y entendé cuánto pesan la red y el consumo.</p><div class="stamps"><span class="stamp">FPS y frametime</span><span class="stamp">Fuente con margen</span><span class="stamp">Ping por género</span></div></div><div class="setup"><div class="monitor"><div class="game"><span class="moon"></span><span class="city"></span><span class="road"></span><div class="hud">FPS<b>97</b>10,3 ms</div></div></div><div class="pc"><div class="glass"><span class="fan"></span><span class="fan two"></span></div></div><div class="fps-card"><small>RENDIMIENTO ESTIMADO</small><b>97 FPS</b></div><div class="hz-card"><small>TU MONITOR</small><b>144 Hz</b></div></div></div></div></section>
<section class="calculator"><div class="wrap"><div class="shell"><div class="form"><div class="form-head"><div><h2>Contanos tu setup</h2><p>Partimos de un juego AAA moderno. Después lo ajustamos a tu caso.</p></div><button class="reset" id="resetBtn">Reiniciar</button></div><div class="modes"><button class="mode active" data-mode="fps" onclick="setMode('fps')"><b>Rendimiento</b><small>FPS y cuello</small></button><button class="mode" data-mode="fuente" onclick="setMode('fuente')"><b>Fuente</b><small>Watts y margen</small></button><button class="mode" data-mode="costo" onclick="setMode('costo')"><b>Costo mensual</b><small>Energía y uso</small></button><button class="mode" data-mode="ping" onclick="setMode('ping')"><b>Ping</b><small>Latencia real</small></button></div><div class="fields"><div class="field"><label for="gpu">Placa de video</label><div class="input"><select id="gpu"><option value="igpu">Gráficos integrados</option><option value="gtx1650">GTX 1650 / RX 6400</option><option value="rtx3050">RTX 3050 / RX 6600</option><option value="rtx4060" selected>RTX 4060 / RX 7600</option><option value="rtx4060ti">RTX 4060 Ti / RX 7700 XT</option><option value="rtx4070s">RTX 4070 Super</option><option value="rtx4070tis">RTX 4070 Ti Super</option><option value="rtx4080s">RTX 4080 Super</option><option value="rtx4090">RTX 4090</option></select></div></div><div class="field"><label for="cpu">Procesador</label><div class="input"><select id="cpu"><option value="basico">Básico · i3 / Ryzen 3</option><option value="medio" selected>Medio · Ryzen 5 5600 / i5-12400</option><option value="alto">Alto · Ryzen 5 7600 / i5-13600K</option><option value="top">Top · 7800X3D / i7-14700K</option></select></div></div><div class="field"><label for="resolution">Resolución</label><div class="input"><select id="resolution"><option value="720p">720p</option><option value="1080p" selected>1080p · Full HD</option><option value="1440p">1440p · QHD</option><option value="4k">4K · UHD</option></select></div></div><div class="field"><label for="quality">Calidad gráfica</label><div class="input"><select id="quality"><option value="bajo">Baja · competitivo</option><option value="medio">Media</option><option value="alto" selected>Alta</option><option value="ultra">Ultra / ray tracing</option></select></div></div></div>
<div class="branch active" id="fpsFields"><div class="field"><label for="genre">Tipo de juego</label><div class="input"><select id="genre"><option value="competitivo">Competitivo / esports</option><option value="accion" selected>Acción / RPG AAA</option><option value="simulacion">Simulación pesada</option><option value="casual">Casual / indie</option></select></div></div><div class="field"><label for="upscale">DLSS / FSR / XeSS</label><div class="input"><select id="upscale"><option value="off" selected>Desactivado</option><option value="calidad">Calidad</option><option value="balanceado">Balanceado</option><option value="rendimiento">Rendimiento</option></select></div></div><div class="field"><label for="hz">Monitor</label><div class="input"><input id="hz" type="number" min="24" value="144"><span class="suffix">Hz</span></div></div></div><div class="branch" id="fuenteFields"><div class="field"><label for="ram">Memoria RAM</label><div class="input"><input id="ram" type="number" min="4" step="4" value="16"><span class="suffix">GB</span></div></div><div class="field"><label for="disks">SSD / discos</label><div class="input"><input id="disks" type="number" min="1" value="2"></div></div><div class="field"><label for="cooling">Refrigeración</label><div class="input"><select id="cooling"><option value="5">Cooler stock</option><option value="8" selected>Torre de aire</option><option value="15">AIO 240</option><option value="22">AIO 360</option></select></div></div></div><div class="branch" id="costoFields"><div class="field"><label for="playHours">Juego por día</label><div class="input"><input id="playHours" type="number" min="0" step=".5" value="4"><span class="suffix">h</span></div></div><div class="field"><label for="idleHours">Prendida sin jugar</label><div class="input"><input id="idleHours" type="number" min="0" step=".5" value="6"><span class="suffix">h</span></div></div><div class="field"><label for="kwhPrice">Precio final del kWh</label><div class="input"><span class="suffix" style="padding-left:10px;padding-right:0">$</span><input id="kwhPrice" type="number" min="0" value="145"></div></div></div><div class="branch" id="pingFields"><div class="field"><label for="distance">Servidor a</label><div class="input"><input id="distance" type="number" min="1" value="900"><span class="suffix">km</span></div></div><div class="field"><label for="ping">Ping medido</label><div class="input"><input id="ping" type="number" min="0" value="45"><span class="suffix">ms</span></div></div><div class="field"><label for="pingGenre">Tipo de juego</label><div class="input"><select id="pingGenre"><option value="fps" selected>FPS competitivo</option><option value="battle">Battle Royale</option><option value="moba">MOBA</option><option value="mmo">MMORPG</option><option value="casual">Casual / estrategia</option></select></div></div></div><button class="calcbtn" id="calcBtn">Actualizar análisis</button></div>
<aside class="result" aria-live="polite"><span class="result-label" id="resultLabel">FPS ESTIMADOS</span><strong class="main-result" id="mainResult">97 FPS</strong><div class="result-sub" id="resultSub">RTX 4060 / RX 7600 en 1080p alto. La GPU es el límite principal.</div><div class="versus"><div class="vbox"><small id="leftLabel">TU PC GENERA</small><b id="leftValue">97 FPS</b></div><span class="vs">VS</span><div class="vbox"><small id="rightLabel">TU MONITOR MUESTRA</small><b id="rightValue">144 Hz</b></div></div><div class="bars"><div class="barrow"><span id="bar1Label">PC</span><div class="bar"><i id="bar1" style="width:67%"></i></div><b id="bar1Value">97</b></div><div class="barrow"><span id="bar2Label">Monitor</span><div class="bar"><i id="bar2" style="width:100%"></i></div><b id="bar2Value">144</b></div></div><div class="metrics"><div class="metric"><small id="metric1Label">FRAMETIME</small><b id="metric1">10,3 ms</b></div><div class="metric"><small id="metric2Label">CUELLO DE BOTELLA</small><b id="metric2">GPU · 39%</b></div><div class="metric"><small id="metric3Label">FPS QUE FALTAN</small><b id="metric3">47 FPS</b></div><div class="metric"><small id="metric4Label">MONITOR APROVECHADO</small><b id="metric4">67%</b></div></div><div class="advice"><small>QUÉ HARÍA PRIMERO</small><b id="advice">Activá DLSS/FSR en calidad o bajá un nivel gráfico antes de cambiar hardware.</b></div></aside></div></div></section>
<section class="cases"><div class="wrap"><div class="section-head"><div class="eyebrow">El setup completo, siempre visible</div><h2>Cuatro decisiones que se afectan entre sí.</h2><p>Cambiá la pregunta arriba sin volver a cargar GPU, CPU ni resolución.</p></div><div class="case-grid"><article class="case"><span class="case-icon">FPS</span><h3>Rendimiento real</h3><p>FPS, frametime, cuello de botella y cuánto aprovecha el monitor.</p><strong>GPU + CPU + resolución + calidad</strong></article><article class="case"><span class="case-icon">W</span><h3>Fuente necesaria</h3><p>Consumo componente por componente con 35% de margen seguro.</p><strong>Consumo × 1,35 → watts comerciales</strong></article><article class="case"><span class="case-icon">$</span><h3>Costo de uso</h3><p>Juego, idle, eficiencia de la fuente y precio real de tu kWh.</p><strong>kWh mensuales + costo por hora</strong></article><article class="case"><span class="case-icon">ms</span><h3>Latencia de red</h3><p>Ping mínimo físico, overhead de la ruta y tolerancia por género.</p><strong>Ping + frametime = respuesta percibida</strong></article></div></div></section>
<section class="targets"><div class="wrap target-grid"><div><div class="eyebrow">No todos necesitan 240 FPS</div><h2>El objetivo cambia según lo que jugás.</h2><p>Más importante que perseguir un número enorme es sostener un frametime estable y acompañarlo con el monitor correcto.</p></div><div><div class="target-list"><div class="trow head"><span>TIPO DE JUEGO</span><span>MÍNIMO</span><span>IDEAL</span><span>PRIORIDAD</span></div><div class="trow"><b>Competitivo / esports</b><span>120 FPS</span><span>240 FPS</span><span class="tag">Latencia</span></div><div class="trow"><b>Acción / RPG AAA</b><span>45 FPS</span><span>120 FPS</span><span class="tag">Equilibrio</span></div><div class="trow"><b>Simulación pesada</b><span>30 FPS</span><span>90 FPS</span><span class="tag">CPU y estabilidad</span></div><div class="trow"><b>Casual / indie</b><span>30 FPS</span><span>60 FPS</span><span class="tag">Calidad visual</span></div></div><div class="tip">La estimación parte de juegos modernos; el benchmark del título específico siempre manda.</div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="searchBtn" hidden aria-hidden="true"></button><button type="button" id="countryBtn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-gaming')?document.currentScript.previousElementSibling:document.querySelector('.mockup-gaming');

const $=id=>root.querySelector("#"+id);
const GPUs={igpu:{name:"Gráficos integrados",fps:22,w:15},gtx1650:{name:"GTX 1650 / RX 6400",fps:42,w:130},rtx3050:{name:"RTX 3050 / RX 6600",fps:62,w:170},rtx4060:{name:"RTX 4060 / RX 7600",fps:82,w:200},rtx4060ti:{name:"RTX 4060 Ti / RX 7700 XT",fps:104,w:200},rtx4070s:{name:"RTX 4070 Super",fps:132,w:320},rtx4070tis:{name:"RTX 4070 Ti Super",fps:158,w:320},rtx4080s:{name:"RTX 4080 Super",fps:196,w:355},rtx4090:{name:"RTX 4090",fps:246,w:450}},CPUs={basico:{cap:72,w:65},medio:{cap:158,w:125},alto:{cap:228,w:180},top:{cap:318,w:253}},res={"720p":1.48,"1080p":1,"1440p":.68,"4k":.42},quality={bajo:1.8,medio:1.45,alto:1.18,ultra:1},genres={competitivo:{factor:3.1,rec:144},accion:{factor:1,rec:60},simulacion:{factor:.72,rec:60},casual:{factor:2.4,rec:60}},ups={off:1,calidad:1.35,balanceado:1.55,rendimiento:1.85};let mode="fps";
const nf=(n,d=0)=>Number(n||0).toLocaleString("es-AR",{minimumFractionDigits:d,maximumFractionDigits:d});function set(id,v){$(id).textContent=v}
function perf(){let g=GPUs[$("gpu").value],c=CPUs[$("cpu").value],ge=genres[$("genre").value],gpuF=g.fps*res[$("resolution").value]*quality[$("quality").value]*ge.factor*ups[$("upscale").value],cpuF=c.cap*ge.factor,fps=Math.min(gpuF,cpuF);return{g,c,gpuF,cpuF,fps,limit:cpuF<gpuF?"CPU":"GPU",bottleneck:Math.abs(gpuF-cpuF)/Math.max(gpuF,cpuF)*100}}
function watts(){let g=GPUs[$("gpu").value],c=CPUs[$("cpu").value],ram=+$("ram").value||16,disks=+$("disks").value||2,cool=+$("cooling").value||8,total=g.w+c.w+ram*.6+disks*5+cool+40;return{g,c,total,psu:Math.ceil(total*1.35/50)*50}}
function calculate(show=false){let p=perf(),main="",sub="",left="",right="",m1="",m2="",m3="",m4="",advice="",b1=0,b2=0,l1="",l2="";
 if(mode==="fps"){let hz=+$("hz").value||60,f=p.fps,shown=Math.min(f,hz);main=`${nf(f)} FPS`;sub=`${p.g.name} en ${$("resolution").value} ${$("quality").selectedOptions[0].text.toLowerCase()}. ${p.limit} es el límite principal.`;left=`${nf(f)} FPS`;right=`${nf(hz)} Hz`;l1="PC";l2="Monitor";b1=f/Math.max(f,hz)*100;b2=hz/Math.max(f,hz)*100;m1=`${nf(1000/f,1)} ms`;m2=`${p.limit} · ${nf(p.bottleneck)}%`;m3=`${nf(Math.max(0,hz-f))} FPS`;m4=`${nf(shown/hz*100)}%`;advice=f<hz?"Activá DLSS/FSR en calidad o bajá un nivel gráfico antes de cambiar hardware.":"Tu PC genera más frames de los que muestra el monitor: subí calidad o Hz.";set("resultLabel","FPS ESTIMADOS");set("leftLabel","TU PC GENERA");set("rightLabel","TU MONITOR MUESTRA");set("metric1Label","FRAMETIME");set("metric2Label","CUELLO DE BOTELLA");set("metric3Label","FPS QUE FALTAN");set("metric4Label","MONITOR APROVECHADO")}
 if(mode==="fuente"){let w=watts();main=`${nf(w.psu)} W`;sub=`El equipo consume cerca de ${nf(w.total)} W a plena carga. La recomendación ya incluye 35% para picos y upgrades.`;left=`${nf(w.total)} W`;right=`${nf(w.psu)} W`;l1="Consumo";l2="Fuente";b1=w.total/w.psu*100;b2=100;m1=`${nf(w.g.w)} W`;m2=`${nf(w.c.w)} W`;m3=`${nf(w.psu-w.total)} W`;m4=w.psu>=750?"80 PLUS Gold":"Bronze / Gold";advice=w.psu>=750?"Buscá ATX 3.1 y conector nativo para la GPU. No uses una fuente genérica.":"Una fuente certificada de buena marca te deja margen suficiente.";set("resultLabel","FUENTE RECOMENDADA");set("leftLabel","CONSUMO REAL");set("rightLabel","POTENCIA DE FUENTE");set("metric1Label","GPU");set("metric2Label","CPU");set("metric3Label","MARGEN DISPONIBLE");set("metric4Label","CERTIFICACIÓN")}
 if(mode==="costo"){let w=watts(),play=+$("playHours").value||0,idle=+$("idleHours").value||0,price=+$("kwhPrice").value||0,kwh=((w.total/.87)/1000*play+(w.total*.22/.87)/1000*idle)*30,cost=kwh*price;main=`$${nf(cost)}`;sub=`${nf(kwh,1)} kWh por mes con ${nf(play,1)} h diarias de juego y ${nf(idle,1)} h en reposo.`;left=`${nf(kwh,1)} kWh`;right=`$${nf(price)}/kWh`;l1="Consumo";l2="Tarifa";b1=Math.min(100,kwh/100*100);b2=Math.min(100,price/300*100);m1=`$${nf(cost/(play*30||1),1)}`;m2=`${nf(w.total/.87)} W`;m3=`${nf(w.total*.22/.87)} W`;m4=`${nf(play*30)} h`;advice="Usá el precio final por kWh de tu boleta. Apagar la PC en vez de dejarla idle también mueve el total.";set("resultLabel","COSTO ELÉCTRICO MENSUAL");set("leftLabel","CONSUMO DEL MES");set("rightLabel","PRECIO CARGADO");set("metric1Label","LUZ POR HORA DE JUEGO");set("metric2Label","DESDE LA PARED JUGANDO");set("metric3Label","EN REPOSO");set("metric4Label","HORAS DE JUEGO")}
 if(mode==="ping"){let dist=+$("distance").value||0,ping=+$("ping").value||0,min=dist/200000*2*1000,thresholds={fps:[15,30,50],battle:[30,50,70],moba:[30,50,80],mmo:[50,80,150],casual:[100,150,250]}[$("pingGenre").value],rating=ping<=thresholds[0]?"Excelente":ping<=thresholds[1]?"Bueno":ping<=thresholds[2]?"Aceptable":"Malo";main=`${nf(ping)} ms`;sub=`Para ${$("pingGenre").selectedOptions[0].text}: ${rating.toLowerCase()}. El piso físico por distancia ronda ${nf(min,1)} ms.`;left=`${nf(ping)} ms`;right=`${nf(min,1)} ms`;l1="Ping real";l2="Piso físico";b1=Math.min(100,ping/200*100);b2=Math.min(100,min/200*100);m1=rating;m2=`${nf(Math.max(0,ping-min),1)} ms`;m3=`${nf(ping/(1000/p.fps),1)} frames`;m4=`${nf(1000/p.fps,1)} ms`;advice=ping>thresholds[2]?"Probá por cable y medí en horario pico. Si sigue alto, el problema puede ser el ruteo del ISP.":"La latencia es adecuada; priorizá estabilidad y bajo jitter.";set("resultLabel","PING PARA TU JUEGO");set("leftLabel","LATENCIA MEDIDA");set("rightLabel","MÍNIMO POR DISTANCIA");set("metric1Label","VEREDICTO");set("metric2Label","OVERHEAD DE LA RUTA");set("metric3Label","DESVENTAJA EN FRAMES");set("metric4Label","FRAMETIME DE TU PC")}
 set("mainResult",main);set("resultSub",sub);set("leftValue",left);set("rightValue",right);set("bar1Label",l1);set("bar2Label",l2);set("bar1Value",left.split(" ")[0]);set("bar2Value",right.split(" ")[0]);$("bar1").style.width=Math.max(2,b1)+"%";$("bar2").style.width=Math.max(2,b2)+"%";set("metric1",m1);set("metric2",m2);set("metric3",m3);set("metric4",m4);set("advice",advice);if(show)toast("✓ Análisis actualizado")}
function setMode(m){mode=m;root.querySelectorAll(".mode").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));["fps","fuente","costo","ping"].forEach(x=>$(x+"Fields").classList.toggle("active",x===m));calculate()}
function toast(t){$("toast").textContent=t;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1700)}
root.querySelectorAll(".mode").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));root.querySelectorAll("input,select").forEach(el=>el.addEventListener("input",()=>calculate()));$("calcBtn").onclick=()=>calculate(true);$("resetBtn").onclick=()=>{$("gpu").value="rtx4060";$("cpu").value="medio";$("resolution").value="1080p";$("quality").value="alto";$("genre").value="accion";$("upscale").value="off";$("hz").value=144;setMode("fps");toast("Setup reiniciado")};$("searchBtn").onclick=()=>toast("Buscar calculadoras");$("countryBtn").onclick=()=>toast("Región seleccionada");calculate();

})();
</script>
<style is:global>

.mockup-gaming{--ink:#111827;--muted:#6c7688;--paper:#f4f5f2;--card:#fff;--violet:#7555e9;--violet2:#eeeafd;--cyan:#42d6cf;--lime:#b8ed5e;--coral:#ff725d;--navy:#111a31;--panel:#192642;--line:#dce1df;--green:#2f876f}.mockup-gaming *{box-sizing:border-box}.mockup-gaming [hidden]{display:none!important}.mockup-gaming{scroll-behavior:smooth}.mockup-gaming{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-gaming button,.mockup-gaming input,.mockup-gaming select{font:inherit}.mockup-gaming .wrap{width:min(1180px,calc(100% - 48px));margin:auto}.mockup-gaming header{height:82px;background:#fff;border-bottom:1px solid var(--line)}.mockup-gaming header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-gaming .brand{display:flex;align-items:center;gap:11px;font-size:19px;font-weight:900}.mockup-gaming .logo{width:34px;height:34px;border-radius:8px;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:14px}.mockup-gaming .nav{display:flex;gap:25px;color:#515b69;font-size:14px;font-weight:750}.mockup-gaming .actions{margin-left:auto;display:flex;gap:9px}.mockup-gaming .ghost{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px;font-weight:750;cursor:pointer}
.mockup-gaming .hero{padding:48px 0 67px;background:linear-gradient(128deg,#fff 20%,#eeeaff)}.mockup-gaming .crumb{font-size:14px;color:#6756aa;margin-bottom:27px}.mockup-gaming .hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:65px;align-items:center}.mockup-gaming .eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:11px;color:var(--violet);font-weight:900}.mockup-gaming h1{font-size:57px;line-height:1.01;letter-spacing:-.055em;margin:13px 0 18px}.mockup-gaming .lead{font-size:19px;color:var(--muted);max-width:660px}.mockup-gaming .stamps{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.mockup-gaming .stamp{background:#fff;border:1px solid #dcd6f0;border-radius:99px;padding:8px 11px;font-size:11px;font-weight:800;color:#5c5870}
.mockup-gaming .setup{height:350px;position:relative}.mockup-gaming .monitor{position:absolute;left:18px;top:25px;width:360px;height:230px;background:#171d2c;border:12px solid #222b3a;border-radius:18px;box-shadow:0 25px 60px #30295631}.mockup-gaming .monitor:after{content:"";position:absolute;left:135px;bottom:-66px;width:70px;height:55px;background:#293341;border-radius:0 0 8px 8px}.mockup-gaming .monitor:before{content:"";position:absolute;left:94px;bottom:-75px;width:150px;height:14px;background:#293341;border-radius:50%}.mockup-gaming .game{height:100%;position:relative;overflow:hidden;background:linear-gradient(#203558 0 55%,#283346 55%)}.mockup-gaming .moon{position:absolute;right:28px;top:25px;width:44px;height:44px;border-radius:50%;background:#b8f3ed;box-shadow:0 0 28px #69e9df}.mockup-gaming .city{position:absolute;left:0;right:0;bottom:34%;height:80px;background:repeating-linear-gradient(90deg,#151d32 0 25px,#24304a 25px 45px);clip-path:polygon(0 45%,8% 45%,8% 10%,16% 10%,16% 55%,25% 55%,25% 0,35% 0,35% 35%,43% 35%,43% 15%,55% 15%,55% 60%,66% 60%,66% 22%,76% 22%,76% 42%,85% 42%,85% 5%,94% 5%,94% 50%,100% 50%,100% 100%,0 100%)}.mockup-gaming .road{position:absolute;bottom:-30px;left:28%;width:170px;height:150px;background:#162039;transform:perspective(90px) rotateX(18deg)}.mockup-gaming .road:after{content:"";position:absolute;left:50%;top:0;width:3px;height:100%;background:repeating-linear-gradient(#f7dc62 0 16px,transparent 16px 30px)}.mockup-gaming .hud{position:absolute;left:12px;top:10px;color:#fff;font:800 10px monospace}.mockup-gaming .hud b{display:block;font-size:24px;color:var(--lime)}.mockup-gaming .pc{position:absolute;right:0;top:58px;width:125px;height:235px;background:#1b2434;border-radius:16px;border:5px solid #303a4a;box-shadow:0 22px 45px #20263b39}.mockup-gaming .glass{position:absolute;inset:12px;background:#151c2a;border:1px solid #555f72;border-radius:8px;overflow:hidden}.mockup-gaming .fan{position:absolute;width:62px;height:62px;bo