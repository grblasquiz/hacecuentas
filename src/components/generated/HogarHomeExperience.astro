<div class="mockup-hogar-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Hogar</div><div class="heroGrid"><div><span class="eyebrow">Que sostener la casa no sea una caja negra</span><h1>Entendé qué consume tu hogar. Y dónde podés mejorar.</h1><p class="lead">Luz, gas, agua, climatización y gastos compartidos. Todas las cuentas de la casa, ordenadas en un solo lugar.</p><div class="trust"><span>✓ Gastos por rubro</span><span>✓ Costo por persona</span><span>✓ Proyección anual</span></div><div class="scene"><i class="home"><i class="window"></i></i><i class="smoke">≈</i></div></div>
<div class="calc"><div class="calcHead"><div><h2>La foto mensual de tu casa</h2><p>Servicios, conectividad y mantenimiento.</p></div><span class="live">COSTO EN VIVO</span></div><div class="profiles"><button class="profile active" data-profile="apartment">Departamento</button><button class="profile" data-profile="house">Casa</button><button class="profile" data-profile="shared">Compartida</button></div><div class="fields"><div class="field"><label>Electricidad</label><div class="input"><span>$</span><input id="electricity" type="number" min="0" value="85000"></div></div><div class="field"><label>Gas + agua</label><div class="input"><span>$</span><input id="utilities" type="number" min="0" value="72000"></div></div><div class="field"><label>Internet + conectividad</label><div class="input"><span>$</span><input id="internet" type="number" min="0" value="52000"></div></div><div class="field"><label>Expensas / mantenimiento</label><div class="input"><span>$</span><input id="maintenance" type="number" min="0" value="240000"></div></div><div class="field"><label>Otros gastos del hogar</label><div class="input"><span>$</span><input id="other" type="number" min="0" value="65000"></div></div><div class="field"><label>Personas en la vivienda</label><div class="input"><input id="people" type="number" min="1" value="2"><span>personas</span></div></div></div><button class="primary" id="calculate">Actualizar costo del hogar</button><div class="result"><div class="resultTop"><div><small>COSTO MENSUAL ESTIMADO</small><div class="amount" id="total">$514.000</div></div><span class="badge" id="profileLabel">Departamento</span></div><div class="resultGrid"><div class="metric"><span>POR PERSONA</span><b id="perPerson">$257.000</b></div><div class="metric"><span>PROYECCIÓN ANUAL</span><b id="annual">$6.168.000</b></div><div class="metric"><span>RUBRO PRINCIPAL</span><b id="largest">Mantenimiento</b></div></div><div class="stack"><i id="barA"></i><i id="barB"></i><i id="barC"></i><i id="barD"></i></div><p class="note" id="note">Expensas o mantenimiento representan el 47% del costo mensual relevado.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Entrá por la cuenta que te preocupa</span><h2>¿Qué necesitás resolver en casa?</h2><p>Elegí una necesidad y encontrá primero las herramientas relacionadas.</p></div><div class="needs"><button class="need active" data-filter="electric"><span class="icon">⚡</span><h3>Entender la luz</h3><p>Consumo, tarifa y electrodomésticos.</p><em>→</em></button><button class="need" data-filter="gas"><span class="icon">≈</span><h3>Gas y agua</h3><p>Consumo, cargos y usos principales.</p><em>→</em></button><button class="need" data-filter="climate"><span class="icon">°</span><h3>Climatizar ambientes</h3><p>Potencia, consumo y confort.</p><em>→</em></button><button class="need" data-filter="share"><span class="icon">÷</span><h3>Repartir las cuentas</h3><p>Partes iguales o según ingresos.</p><em>→</em></button><button class="need" data-filter="maintain"><span class="icon">⌂</span><h3>Mantener la casa</h3><p>Reserva, tareas y mejoras.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas para el hogar</span><h2>Del medidor a una decisión concreta.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="electric">Electricidad</button><button class="filter" data-filter="gas">Gas y agua</button><button class="filter" data-filter="climate">Climatización</button><button class="filter" data-filter="share">Cuentas</button><button class="filter" data-filter="maintain">Mantenimiento</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="electric" data-text="factura luz consumo kwh tarifa cargos"><span class="tag">Electricidad</span><h3>Factura de luz</h3><p>Entendé consumo, cargos, tarifa y costo estimado del período.</p><button>Analizar factura →</button></article><article class="card" data-cat="gas" data-text="gas agua consumo factura metros cubicos"><span class="tag">Servicios</span><h3>Gas y agua</h3><p>Separá cargos fijos, consumo y usos del hogar.</p><button>Calcular consumo →</button></article><article class="card" data-cat="climate electric gas" data-text="climatizacion aire calefaccion potencia ambiente"><span class="tag">Confort</span><h3>Climatización</h3><p>Dimensioná potencia según ambiente y condiciones.</p><button>Dimensionar equipo →</button></article><article class="card" data-cat="share" data-text="cuentas casa repartir gastos personas ingresos"><span class="tag">Compartido</span><h3>Cuentas de la casa</h3><p>Repartí servicios y gastos de manera transparente.</p><button>Repartir cuentas →</button></article><article class="card" data-cat="electric maintain" data-text="instalacion electrica potencia cable termica hogar"><span class="tag">Seguridad</span><h3>Instalación eléctrica</h3><p>Sumá cargas y revisá necesidades de la instalación.</p><button>Calcular cargas →</button></article><article class="card" data-cat="maintain" data-text="mantenimiento hogar fondo reserva reparaciones"><span class="tag">Previsión</span><h3>Fondo de mantenimiento</h3><p>Mensualizá reparaciones y mejoras futuras.</p><button>Armar reserva →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section class="order"><div class="wrap orderGrid"><div><span class="eyebrow" style="color:var(--yellow)">Antes de recortar, entendé</span><h2>Consumo, tarifa y hábito no son lo mismo.</h2><p>Una factura puede subir porque usaste más, cambió el precio o apareció un cargo. Separar las causas evita decisiones equivocadas.</p></div><div class="orderList"><button class="orderBtn active" data-step="Consumo"><span><b>1. Mirá cuánto consumiste</b><small>kWh, m³ o litros, no solo pesos.</small></span><b>→</b></button><button class="orderBtn" data-step="Tarifa"><span><b>2. Revisá la tarifa</b><small>Precio unitario, tramo y cargos.</small></span><b>→</b></button><button class="orderBtn" data-step="Hábito"><span><b>3. Identificá qué hábito pesa</b><small>Climatización, agua caliente o equipos.</small></span><b>→</b></button></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-hogar-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-hogar-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR");let current="apartment";function calc(){const values=[Math.max(0,+$("#electricity").value||0),Math.max(0,+$("#utilities").value||0),Math.max(0,+$("#internet").value||0),Math.max(0,+$("#maintenance").value||0),Math.max(0,+$("#other").value||0)],people=Math.max(1,+$("#people").value||1),total=values.reduce((a,b)=>a+b,0),names=["Electricidad","Gas y agua","Internet","Mantenimiento","Otros"],max=Math.max(...values),index=values.indexOf(max);$("#total").textContent=money(total);$("#perPerson").textContent=money(total/people);$("#annual").textContent=money(total*12);$("#largest").textContent=names[index];$("#profileLabel").textContent={apartment:"Departamento",house:"Casa",shared:"Compartida"}[current];const grouped=[values[0],values[1],values[2],values[3]+values[4]],ids=["barA","barB","barC","barD"];ids.forEach((id,i)=>$("#"+id).style.width=(total?grouped[i]/total*100:0)+"%");$("#note").textContent=`${names[index]} representa el ${total?Math.round(max/total*100):0}% del costo mensual relevado.`}
$$(".calc input").forEach(x=>x.oninput=calc);const profiles={apartment:[85000,72000,52000,240000,65000,2],house:[145000,128000,56000,180000,110000,4],shared:[120000,90000,65000,0,90000,3]};$$(".profile").forEach(b=>b.onclick=()=>{current=b.dataset.profile;$$(".profile").forEach(x=>x.classList.toggle("active",x===b));const v=profiles[current],ids=["electricity","utilities","internet","maintenance","other","people"];ids.forEach((id,i)=>$("#"+id).value=v[i]);calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Costo actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".orderBtn").forEach(b=>b.onclick=()=>{$$(".orderBtn").forEach(x=>x.classList.toggle("active",x===b));toast("Paso seleccionado: "+b.dataset.step)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
