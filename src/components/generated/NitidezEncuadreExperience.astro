---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-nitidez-encuadre" set:html={`<div class="crumb">Tecnología / Fotografía</div><h1>La cámara enfoca un punto; vos decidís qué importa.</h1><p class="lead">Probá posición, velocidad y apertura para separar problemas de encuadre de problemas de nitidez.</p><section class="camera"><div class="view"><div class="finder" id="finder"><i class="grid"></i><i class="subject"></i><i class="focus"></i></div></div><aside class="panel"><h2>Decisiones de toma</h2><label>Posición horizontal<input id="x" type="range" min="5" max="75" value="58"></label><label>Posición vertical<input id="y" type="range" min="5" max="45" value="22"></label><label>Velocidad<select id="speed"><option value="0">1/1000</option><option value=".8">1/125</option><option value="2.5">1/30</option></select></label><label>Movimiento del sujeto<input id="motion" type="range" min="0" max="3" step=".2" value="1"></label><div class="verdict" id="verdict"></div></aside></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-nitidez-encuadre')?document.currentScript.previousElementSibling:document.querySelector('.mockup-nitidez-encuadre');
const $=x=>root.querySelector("#"+x);function render(){let x=+$('x').value,y=+$('y').value,blur=Math.max(0,+$('speed').value*+$('motion').value);$('finder').style.setProperty('--x',x+'%');$('finder').style.setProperty('--y',y+'%');$('finder').style.setProperty('--blur',blur+'px');$('verdict').textContent=blur>3?'Hay riesgo de trepidación o movimiento: subí velocidad, estabilizá o acompañá al sujeto.':x>45&&x<70?'Sujeto cerca del tercio: el encuadre deja aire en la dirección opuesta.':'Revisá si centrarlo es una decisión o sólo el valor por defecto.'}root.querySelectorAll('input,select').forEach(x=>x.oninput=render);render();
})();
</script>
<style is:global>
.mockup-nitidez-encuadre{--blue:#174b7a;--ink:#182a32;--muted:#65747c;--line:#d7e1df;--orange:#e47a45;--paper:#f5f7f5}.mockup-nitidez-encuadre *{box-sizing:border-box}.mockup-nitidez-encuadre{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-nitidez-encuadre input,.mockup-nitidez-encuadre select{font:inherit}.mockup-nitidez-encuadre .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-nitidez-encuadre .crumb{color:var(--blue);font-weight:850}.mockup-nitidez-encuadre h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-nitidez-encuadre .lead{font-size:18px;color:var(--muted)}.mockup-nitidez-encuadre .camera{display:grid;grid-template-columns:1fr 300px;gap:20px;margin-top:26px}.mockup-nitidez-encuadre .view,.mockup-nitidez-encuadre .panel{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-nitidez-encuadre .finder{height:420px;background:linear-gradient(#b9deea 0 60%,#89b877 60%);position:relative;overflow:hidden}.mockup-nitidez-encuadre .grid{position:absolute;inset:0;background:linear-gradient(90deg,transparent 33%,#fff8 33% 33.5%,transparent 33.5% 66%,#fff8 66% 66.5%,transparent 66.5%),linear-gradient(transparent 33%,#fff8 33% 33.5%,transparent 33.5% 66%,#fff8 66% 66.5%,transparent 66.5%)}.mockup-nitidez-encuadre .subject{position:absolute;width:120px;height:190px;border-radius:60px 60px 20px 20px;background:var(--blue);left:var(--x);top:var(--y);filter:blur(var(--blur))}.mockup-nitidez-encuadre .focus{position:absolute;width:145px;height:110px;border:4px solid var(--orange);left:calc(var(--x) - 13px);top:calc(var(--y) + 25px)}.mockup-nitidez-encuadre .panel label{display:block;font-size:12px;font-weight:850;margin:15px 0}.mockup-nitidez-encuadre .panel input,.mockup-nitidez-encuadre .panel select{display:block;width:100%;margin-top:7px}.mockup-nitidez-encuadre .panel input{accent-color:var(--orange)}.mockup-nitidez-encuadre .panel select{border:1px solid var(--line);border-radius:9px;padding:9px}.mockup-nitidez-encuadre .verdict{padding:14px;background:#fff2dd;border-radius:14px;margin-top:15px}@media(max-width:760px){.mockup-nitidez-encuadre .camera{grid-template-columns:1fr}.mockup-nitidez-encuadre .finder{height:330px}}
.mockup-nitidez-encuadre { width:100%; overflow:hidden; }
.mockup-nitidez-encuadre .top, .mockup-nitidez-encuadre header.top { display:none !important; }
.mockup-nitidez-encuadre .foot { display:none !important; }
.mockup-nitidez-encuadre .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-nitidez-encuadre .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-nitidez-encuadre .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-nitidez-encuadre .support-real summary { cursor:pointer; font-weight:750; }
.mockup-nitidez-encuadre .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-nitidez-encuadre :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-nitidez-encuadre input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-nitidez-encuadre input[type="number"]::-webkit-inner-spin-button, .mockup-nitidez-encuadre input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-nitidez-encuadre .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-nitidez-encuadre support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
