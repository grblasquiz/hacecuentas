---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-costo-contratar-colombia" set:html={`<section class="hero"><div class="wrap crumb"><b>Colombia</b> &nbsp;/&nbsp; Trabajo &nbsp;/&nbsp; Costo de contratar</div><div class="wrap grid"><div class="copy"><span class="eyebrow">El costo completo de la nómina</span><h1>El salario acordado no es lo que cuesta el empleado.</h1><p>Sumá prestaciones, seguridad social, ARL, caja y parafiscales. Compará exoneración, salario integral y el costo de una terminación.</p><div class="chips"><span>✓ Prestaciones completas</span><span>✓ Exoneración art. 114-1</span><span>✓ Costo por hora real</span></div><div class="art"><div class="desk"></div><div class="laptop"></div><div class="float"><small>COSTO MENSUAL REAL</small><b id="art-value">$4.237.987</b><span id="art-copy">empresa exonerada · riesgo I</span></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá el costo laboral</h2><p class="muted">Elegí el tipo de contratación.</p></div><span class="tag">Colombia 2026</span></div><div class="label">Situación del empleador</div><div class="cases"><button type="button" class="case active" data-mode="exempt"><i>✓</i>Empresa exonerada</button><button type="button" class="case" data-mode="full"><i>+</i>Sin exoneración</button><button type="button" class="case" data-mode="integral"><i>∑</i>Salario integral</button><button type="button" class="case" data-mode="dismissal"><i>×</i>Costo de despido</button></div><div class="label">Datos del puesto</div><div class="fields"><div class="field"><label>Salario mensual pactado</label><input id="salary" value="3000000"></div><div class="field regular"><label>Clase de riesgo ARL</label><select id="risk"><option value=".00522">Clase I · 0,522%</option><option value=".01044">Clase II · 1,044%</option><option value=".02436">Clase III · 2,436%</option><option value=".0435">Clase IV · 4,35%</option><option value=".0696">Clase V · 6,96%</option></select></div><div class="field regular"><label>Industria de la construcción</label><select id="construction"><option value="0">No</option><option value=".01">Sí · sumar FIC 1%</option></select></div><div class="field regular"><label>Horas productivas por mes</label><input id="productive" value="190"></div><div class="field hide dismissal"><label>Antigüedad · años</label><input id="years" value="3"></div><div class="field hide dismissal"><label>Antigüedad · meses adicionales</label><input id="extra-months" value="6"></div><div class="field hide dismissal"><label>Meses con prestaciones pendientes</label><input id="pending" value="6"></div></div><section class="result"><div class="result-top"><div><small id="result-label">COSTO MENSUAL REAL</small><div class="value" id="result">$4.237.987</div></div><div class="badge"><small id="badge-label">Factor sobre salario</small><b id="badge">1,41×</b></div></div><div class="stats"><span id="s1l">SOBRECOSTO MENSUAL<b id="s1">$1.237.987</b></span><span id="s2l">COSTO POR HORA<b id="s2">$22.305</b></span><span id="s3l">AUXILIO TRANSPORTE<b id="s3">$249.095</b></span></div><button class="go" id="update" type="button">Actualizar costo</button></section></form></div></section>
<section class="section"><div class="wrap"><header class="center"><span>Cada peso desembolsado</span><h2>De qué está hecho el costo laboral</h2><p>El trabajador ve el salario. La empresa también paga prestaciones, seguridad social y parafiscales.</p></header><div class="composition"><div class="donut" id="donut"></div><div class="legend"><div><i style="background:#287d55"></i><span>Salario y auxilio</span><b id="leg-salary">$3.249.095</b></div><div><i style="background:#efb95e"></i><span>Prestaciones sociales</span><b id="leg-benefits">$680.000</b></div><div><i style="background:#4d8bb7"></i><span>Seguridad social</span><b id="leg-social">$375.660</b></div><div><i style="background:#ce7566"></i><span>Parafiscales y FIC</span><b id="leg-para">$120.000</b></div></div></div></div></section>
<section class="break"><div class="wrap breakgrid"><article class="card"><h3>El costo, concepto por concepto</h3><div class="line"><span id="d1l">Salario pactado</span><b id="d1">$3.000.000</b></div><div class="line"><span id="d2l">Auxilio de transporte</span><b id="d2">$249.095</b></div><div class="line"><span id="d3l">Prestaciones sociales</span><b id="d3">$680.000</b></div><div class="line"><span id="d4l">Seguridad y parafiscales</span><b id="d4">$496.000</b></div><div class="line total"><strong id="d5l">Costo mensual real</strong><b id="d5">$4.237.987</b></div></article><article class="card"><h3>Qué cambia más la cuenta</h3><div class="rule"><i>1</i><div><b>La exoneración</b><span>Puede sacar salud patronal, SENA e ICBF.</span></div></div><div class="rule"><i>2</i><div><b>La clase de riesgo</b><span>La ARL va de 0,522% a 6,96% del IBC.</span></div></div><div class="rule"><i>3</i><div><b>Las horas productivas</b><span>Para cotizar, dividí por horas realmente facturables.</span></div></div><div class="warning">Estimación informativa. Confirmá exoneración, IBC y clasificación ARL con tu contador y operador PILA.</div></article></div></section>
<section class="concepts"><div class="wrap"><header class="center"><span>La mochila laboral</span><h2>Cuatro bloques que hay que provisionar</h2></header><div class="conceptgrid"><article class="concept"><i>◷</i><h3>Prestaciones</h3><p>Cesantías, intereses, prima y vacaciones.</p><em>≈ 21,8%</em></article><article class="concept"><i>+</i><h3>Seguridad social</h3><p>Salud, pensión y ARL sobre el IBC.</p><em>Según exoneración</em></article><article class="concept"><i>▦</i><h3>Parafiscales</h3><p>Caja, SENA e ICBF; la caja siempre se paga.</p><em>4% a 9%</em></article><article class="concept"><i>×</i><h3>Terminación</h3><p>Indemnización más prestaciones pendientes.</p><em>Art. 64 CST</em></article></div></div></section>
<section class="darksec"><div class="wrap darkgrid"><div><span class="eyebrow" style="color:#9dd8b8">El factor 1,5 no sirve para todos</span><h2>El costo real depende de tu empresa y del puesto.</h2><p>Una empresa exonerada y un empleador sin exoneración pueden pagar una diferencia de más de trece puntos por el mismo salario.</p></div><div class="facts"><div><small>SMLMV 2026</small><b>$1.750.905</b><span>Base legal</span></div><div><small>AUXILIO</small><b>$249.095</b><span>Hasta 2 SMLMV</span></div><div><small>JORNADA</small><b>42 horas</b><span>Desde 15-jul-2026</span></div></div></div></section><div class="foot"></div>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-costo-contratar-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-costo-contratar-colombia');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value)||0),cop=x=>"$"+Math.round(x).toLocaleString("es-CO");let mode="exempt",SMLMV=1750905,AUX=249095;function stat(names,vals){["s1l","s2l","s3l"].forEach((id,i)=>$("#"+id).childNodes[0].nodeValue=names[i]);["s1","s2","s3"].forEach((id,i)=>$("#"+id).textContent=vals[i])}function rows(a){a.forEach((x,i)=>{$("#d"+(i+1)+"l").textContent=x[0];$("#d"+(i+1)).textContent=x[1]})}function calc(){let salary=n("#salary"),risk=n("#risk"),construction=n("#construction"),productive=Math.max(1,n("#productive"));if(mode==="dismissal"){let years=n("#years")+n("#extra-months")/12,pending=Math.min(12,n("#pending")),days=years<=1?30:30+20*(years-1),ind=days*salary/30,prop=pending/12,benefits=(salary*prop)+(salary/12*.12*prop*pending)+(salary*prop)+(salary*.041667*pending),total=ind+benefits;$("#result-label").textContent="DESEMBOLSO TOTAL DEL DESPIDO";$("#result").textContent=cop(total);$("#badge-label").textContent="Días de indemnización";$("#badge").textContent=days.toLocaleString("es-CO",{maximumFractionDigits:1})+" días";stat(["INDEMNIZACIÓN","PRESTACIONES PENDIENTES","EQUIVALE A"],[cop(ind),cop(benefits),(total/salary).toFixed(1).replace(".",",")+" sueldos"]);rows([["Salario de base",cop(salary)],["Antigüedad",years.toFixed(1)+" años"],["Indemnización",cop(ind)],["Prestaciones pendientes",cop(benefits)],["Desembolso total",cop(total)]]);$("#art-value").textContent=cop(total);$("#art-copy").textContent="despido sin justa causa";return}let integral=mode==="integral",exempt=mode==="exempt"&&salary<10*SMLMV,aux=!integral&&salary<=2*SMLMV?AUX:0,ibc=Math.min((integral?salary*.7:salary),25*SMLMV),health=exempt?0:ibc*.085,pension=ibc*.12,arl=ibc*risk,social=health+pension+arl,ccf=ibc*.04,icbf=exempt?0:ibc*.03,sena=exempt?0:ibc*.02,fic=salary*construction,para=ccf+icbf+sena+fic,base=salary+aux,ces=integral?0:base/12,interest=ces*.12,prime=integral?0:base/12,vac=salary*.041667,benefits=ces+interest+prime+vac,total=salary+aux+social+para+benefits,over=total-salary;$("#result-label").textContent="COSTO MENSUAL REAL";$("#result").textContent=cop(total);$("#badge-label").textContent="Factor sobre salario";$("#badge").textContent=(total/salary).toFixed(2).replace(".",",")+"×";stat(["SOBRECOSTO MENSUAL","COSTO POR HORA","AUXILIO TRANSPORTE"],[cop(over),cop(total/productive),cop(aux)]);rows([["Salario pactado",cop(salary)],["Auxilio de transporte",cop(aux)],["Prestaciones sociales",cop(benefits)],["Seguridad y parafiscales",cop(social+para)],["Costo mensual real",cop(total)]]);$("#leg-salary").textContent=cop(salary+aux);$("#leg-benefits").textContent=cop(benefits);$("#leg-social").textContent=cop(social);$("#leg-para").textContent=cop(para);let p1=(salary+aux)/total*100,p2=benefits/total*100,p3=social/total*100;$("#donut").style.background=`conic-gradient(#287d55 0 ${p1}%,#efb95e ${p1}% ${p1+p2}%,#4d8bb7 ${p1+p2}% ${p1+p2+p3}%,#ce7566 ${p1+p2+p3}% 100%)`;$("#art-value").textContent=cop(total);$("#art-copy").textContent=exempt?"empresa exonerada · riesgo elegido":integral?"salario integral":"sin exoneración"}
function setMode(m){mode=m;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));$$(".regular").forEach(x=>x.classList.toggle("hide",m==="dismissal"));$$(".dismissal").forEach(x=>x.classList.toggle("hide",m!=="dismissal"));if(m==="integral"&&n("#salary")<13*SMLMV)$("#salary").value=13*SMLMV;calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Costo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar costo",1200)};calc();

})();
</script>
