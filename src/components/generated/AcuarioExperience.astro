---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-acuario" set:html={`
<section class="hero"><div class="wrap"><div class="crumb">Mascotas / Acuario</div><div class="hero-grid"><div><div class="eyebrow">Primero los animales. Después la pecera.</div><h1>Un acuario donde puedan vivir bien.</h1><p class="lead">Calculá litros, filtración, temperatura y mantenimiento según lo que realmente vas a poner adentro. Con tamaño adulto, no el de la tienda.</p><div class="chips"><span class="chip">✓ Peces comunitarios</span><span class="chip">✓ Betta</span><span class="chip">✓ Tortuga acuática</span></div></div><div class="tank"><div class="glass"><span class="plant"></span><span class="fish"></span><span class="fish two"></span><span class="bubble"></span></div><div class="liters"><small>REGLA BASE</small><strong>1 L por cm adulto</strong></div></div></div></div></section>
<section class="wrap"><div class="tool"><div class="cases" id="cases"></div><div class="calc"><div class="form"><h2 id="formTitle"></h2><p class="hint" id="formHint"></p><div class="fields" id="fields"></div><button class="primary" id="calculate">Actualizar acuario</button></div><div class="result"><div class="caps">VOLUMEN QUE NECESITÁS</div><div class="big" id="mainResult"></div><div class="sub" id="resultText"></div><span class="status" id="status"></span><div class="scale-labels"><span>Insuficiente</span><span>Mínimo justo</span><span>Volumen holgado</span></div><div class="scale"><span class="marker" id="marker"></span></div><div class="rows" id="rows"></div></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">Antes de sumar habitantes</div><h2>El acuario se arma en este orden.</h2><p>El agua transparente puede ser tóxica. Lo que protege a los animales es el ciclo biológico, no sólo el filtro encendido.</p></div><div class="cycle"><article class="step"><span class="num">1</span><b>Armá y llená</b><p>Agua acondicionada, sustrato, plantas y escondites.</p></article><article class="step"><span class="num">2</span><b>Ciclá 3–6 semanas</b><p>Dejá que se establezcan las bacterias del filtro.</p></article><article class="step"><span class="num">3</span><b>Medí el agua</b><p>Amoníaco y nitrito tienen que dar cero.</p></article><article class="step"><span class="num">4</span><b>Ingresá de a poco</b><p>No cargues toda la población el mismo día.</p></article></div></div></section>
<section class="care"><div class="wrap care-grid"><div><div class="eyebrow">La rutina que mantiene vivo el sistema</div><h2>Más agua estable. Menos intervenciones.</h2><p>Un acuario grande cambia más lento y perdona más errores. Nunca reemplaces toda el agua ni laves el material filtrante bajo la canilla.</p></div><div class="cards"><article class="care-card"><span class="care-icon">↻</span><b>Cambio parcial semanal</b><span>20–25% en comunitarios y 25–30% en bettas pequeños.</span></article><article class="care-card"><span class="care-icon">≋</span><b>Filtro siempre encendido</b><span>Ahí vive la colonia bacteriana que procesa el amoníaco.</span></article><article class="care-card"><span class="care-icon">◌</span><b>Comida en dos minutos</b><span>Lo que sobra se descompone y empeora el agua.</span></article><article class="care-card"><span class="care-icon"></span><b>Temperatura estable</b><span>La oscilación daña más que un grado de diferencia.</span></article></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-acuario')?document.currentScript.previousElementSibling:document.querySelector('.mockup-acuario');

const standards=[10,15,20,30,40,60,80,100,120,150,180,200,250,300,400,500,600];const modes=[
{id:"fish",icon:"◁",title:"Peces comunitarios",desc:"Cantidad × tamaño adulto"},
{id:"betta",icon:"◇",title:"Betta",desc:"Solo, hembras o comunitario"},
{id:"turtle",icon:"⬡",title:"Tortuga acuática",desc:"Caparazón, filtro y UVB"}
];let active="fish";const $=id=>root.querySelector("#"+id),mode=()=>modes.find(x=>x.id===active);function commercial(n){return standards.find(x=>x>=n)||Math.ceil(n/100)*100}function heater(l,temp,cold=false){if(cold)return temp<14?Math.round(l):0;let w=temp<=14?2.5:temp<=18?2:temp<=22?1.5:1;return Math.round(l*w)}function R(value,text,status,rows,pos=50){return{value,text,status,rows,pos}}
function configs(){if(active==="fish")return{title:"Planificá tu acuario comunitario",hint:"Usamos la cantidad y el tamaño adulto de cada pez.",fields:[["count","Cantidad de peces","number",10],["size","Tamaño adulto","select","Pequeños · 4 cm",["Pequeños · 4 cm","Medianos · 8 cm","Grandes · 18 cm"]],["kind","Tipo de agua","select","Tropical · 24–26 °C",["Tropical · 24–26 °C","Goldfish · 18–22 °C","Agua fría · 14–22 °C"]],["room","Temperatura ambiente","number",18]],calc:v=>{let cm=parseInt(v.size.match(/\d+/)[0]),tropical=v.kind.startsWith("Tropical"),min=+v.count*cm*(tropical?1.2:1),buy=commercial(min),ideal=standards[standards.indexOf(buy)+1]||buy,w=heater(ideal,+v.room,!tropical),filter=buy*4;return R(buy+" litros",`Mínimo calculado ${Math.ceil(min)} L · conviene comprar ${ideal} L para tener margen.`,`Acuario comercial recomendado`,[["Población adulta",(+v.count*cm)+" cm de pez"],["Volumen mínimo",Math.ceil(min)+" L"],["Volumen ideal",ideal+" L"],["Filtro mínimo",filter+" L/h"],["Calefactor",w?w+" W":"No hace falta"],["Cambio semanal",Math.round(buy*.25)+" L"]],55)}};if(active==="betta")return{title:"Elegí cómo va a vivir tu betta",hint:"Dos machos no conviven en ningún volumen.",fields:[["setup","Convivencia","select","Macho solo",["Macho solo","Hembra sola","Grupo de hembras","Con otros peces"]],["count","Cantidad de bettas","number",1],["room","Temperatura ambiente","number",18]],calc:v=>{let min=10,ideal=20,note="un ejemplar solo";if(v.setup==="Hembra sola")ideal=15;if(v.setup==="Grupo de hembras"){let n=Math.max(5,+v.count);min=40+(n-5)*5;ideal=60+(n-5)*8;note=`sorority de ${n} hembras`}if(v.setup==="Con otros peces"){min=40;ideal=70;note="comunitario compatible"}let w=heater(ideal,+v.room);return R(min+" litros mínimo",`Ideal ${ideal} L · ${note} · agua estable entre 25 y 27 °C.`,`Filtro suave y tapa obligatoria`,[["Volumen mínimo",min+" L"],["Volumen ideal",ideal+" L"],["Calefactor",w+" W"],["Temperatura","25–27 °C"],["Cambio semanal",Math.round(min*.3)+" L"],["Corriente","Suave"]],46)}};return{title:"Dimensioná el hábitat de tu tortuga",hint:"Comprá pensando en el tamaño adulto, no sólo en el actual.",fields:[["count","Cantidad de tortugas","number",1],["shell","Largo del caparazón","number",12],["sex","Sexo","select","No lo sé",["No lo sé","Macho","Hembra"]],["room","Temperatura ambiente","number",18]],calc:v=>{let c=+v.shell,n=Math.max(1,+v.count),liters=Math.ceil(Math.max(c*c*.75,80)*(1+.5*(n-1))),adult=v.sex==="Hembra"?30:v.sex==="Macho"?20:26,adultLiters=Math.ceil(Math.max(adult*adult*.75,80)*(1+.5*(n-1))),filterMin=liters*4,filterMax=liters*5,uvb=liters<100?13:liters<200?24:liters<400?36:54,largo=Math.max(60,Math.ceil(c*5)),dry=Math.ceil(c*(c*.75)*1.5);return R(liters+" litros hoy",`De adulta necesitará cerca de ${adultLiters} L · planificá el mueble y el filtro para ese volumen.`,`Filtro potente + zona seca + UVB`,[["Filtro",`${filterMin}–${filterMax} L/h`],["Largo mínimo",largo+" cm"],["Zona seca",dry+" cm²"],["Lámpara UVB",uvb+" W"],["Agua","24–28 °C"],["Volumen adulto",adultLiters+" L"]],42)}}}
function drawCases(){$("cases").innerHTML=modes.map(x=>`<button class="case ${x.id===active?"active":""}" data-id="${x.id}"><div class="ico">${x.icon}</div><b>${x.title}</b><span>${x.desc}</span></button>`).join("");root.querySelectorAll(".case").forEach(b=>b.onclick=()=>{active=b.dataset.id;render()})}
function drawFields(c){$("fields").innerHTML=c.fields.map(f=>{let[id,label,type,val,opts]=f;return type==="select"?`<div class="field"><label for="${id}">${label}</label><select id="${id}">${opts.map(o=>`<option ${o===val?"selected":""}>${o}</option>`).join("")}</select></div>`:`<div class="field"><label for="${id}">${label}</label><input id="${id}" type="number" min="1" step="any" value="${val}"></div>`}).join("");$("fields").querySelectorAll("input,select").forEach(x=>x.addEventListener("input",compute))}
function compute(){let c=configs(),v=Object.fromEntries(c.fields.map(f=>[f[0],$(f[0]).value])),r=c.calc(v);$("mainResult").textContent=r.value;$("resultText").textContent=r.text;$("status").textContent=r.status;$("marker").style.left=`calc(${r.pos}% - 2px)`;$("rows").innerHTML=r.rows.map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
function render(){drawCases();let c=configs();$("formTitle").textContent=c.title;$("formHint").textContent=c.hint;drawFields(c);compute()}$("calculate").onclick=()=>{compute();let b=$("calculate"),old=b.textContent;b.textContent="✓ Acuario actualizado";setTimeout(()=>b.textContent=old,1300)};render();

})();
</script>
<style is:global>

.mockup-acuario{--ink:#102133;--muted:#677487;--paper:#f3f8f7;--card:#fff;--aqua:#168e9c;--aqua2:#ddf3f2;--coral:#ef7a68;--sand:#e9c676;--navy:#163551;--green:#3b9672;--line:#d9e4e4}
.mockup-acuario *{box-sizing:border-box}.mockup-acuario [hidden]{display:none!important}.mockup-acuario{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-acuario button,.mockup-acuario input,.mockup-acuario select{font:inherit}.mockup-acuario .wrap{max-width:1180px;margin:auto;padding:0 28px}
.mockup-acuario header{height:84px;background:#fff;border-bottom:1px solid var(--line)}.mockup-acuario header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-acuario .brand{display:flex;align-items:center;gap:12px;font-weight:850;font-size:20px}.mockup-acuario .logo{width:35px;height:35px;border-radius:8px;background:var(--navy);display:grid;place-items:center;color:#fff;font-size:14px}.mockup-acuario .nav{display:flex;gap:26px;color:#4f5b6c;font-weight:700;font-size:14px}.mockup-acuario .actions{margin-left:auto;display:flex;gap:10px}.mockup-acuario .ghost{border:1px solid var(--line);background:#fff;padding:11px 15px;border-radius:12px;font-weight:750;color:var(--ink)}
.mockup-acuario .hero{padding:57px 0 50px;background:linear-gradient(145deg,#f8fcfb,#eaf7f8)}.mockup-acuario .crumb{color:#3b77c1;font-size:14px;margin-bottom:19px}.mockup-acuario .hero-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:65px;align-items:center}.mockup-acuario .eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:900;color:var(--aqua)}.mockup-acuario h1{font-size:56px;line-height:1.02;letter-spacing:-.05em;margin:14px 0 19px}.mockup-acuario .lead{font-size:19px;color:var(--muted);max-width:680px}.mockup-acuario .chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.mockup-acuario .chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 13px;font-size:13px;font-weight:780}
.mockup-acuario .tank{height:340px;position:relative}.mockup-acuario .glass{position:absolute;inset:28px 0 20px 20px;border:8px solid #fff;border-top:13px solid #173d58;border-radius:7px 7px 28px 28px;background:linear-gradient(#8cdbdf,#4ab3bd 70%,#d9bb77 70%,#e7cb89);box-shadow:0 25px 55px #184d5a25;overflow:hidden}.mockup-acuario .glass:before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,#ffffff2b 0 16%,transparent 16% 40%,#ffffff12 40% 53%,transparent 53%)}.mockup-acuario .plant{position:absolute;width:12px;height:95px;background:#2c926e;bottom:27%;left:14%;border-radius:50% 50% 0 0;transform:rotate(-10deg)}.mockup-acuario .plant:before,.mockup-acuario .plant:after{content:"";position:absolute;width:34px;height:15px;background:#45a87f;border-radius:50%;left:-27px}.mockup-acuario .plant:before{top:23px;transform:rotate(25deg)}.mockup-acuario .plant:after{top:55px;left:5px;transform:rotate(-25deg)}.mockup-acuario .fish{position:absolute;width:72px;height:39px;border-radius:55% 45% 45% 55%;background:var(--coral);left:45%;top:35%}.mockup-acuario .fish:before{content:"";position:absolute;border-right:27px solid var(--coral);border-top:19px solid transparent;border-bottom:19px solid transparent;left:-22px}.mockup-acuario .fish:after{content:"";position:absolute;width:6px;height:6px;border-radius:50%;background:#163551;right:15px;top:11px}.mockup-acuario .fish.two{transform:scale(.65);left:67%;top:56%;background:#f0bf54}.mockup-acuario .fish.two:before{border-right-color:#f0bf54}.mockup-acuario .bubble{position:absolute;border:2px solid #fff;border-radius:50%;width:12px;height:12px;left:59%;top:21%;box-shadow:18px -20px 0 -2px #ffffff99,5px -45px 0 -3px #fff}.mockup-acuario .liters{position:absolute;right:-8px;bottom:5px;background:#fff;border-radius:16px;padding:15px 18px;box-shadow:0 14px 35px #244d591e}.mockup-acuario .liters small{display:block;color:var(--muted);font-weight:900;font-size:10px;letter-spacing:.1em}.mockup-acuario .liters strong{font-size:26px;color:var(--aqua)}
.mockup-acuario .tool{background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden;box-shadow:0 20px 55px #1f4e5610;margin-bottom:70px}.mockup-acuario .cases{padding:22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.mockup-acuario .case{min-height:88px;text-align:left;border:1px solid var(--line);background:#fbfcfc;border-radius:15px;padding:15px;cursor:pointer;color:var(--ink)}.mockup-acuario .case b{display:block;margin:3px 0}.mockup-acuario .case span{font-size:12px;color:var(--muted)}.mockup-acuario .case.active{border:2px solid var(--aqua);background:#ebf8f7;padding:14px}.mockup-acuario .ico{font-size:20px}
.mockup-acuario .calc{display:grid;grid-template-columns:.94fr 1.06fr}.mockup-acuario .form{padding:31px}.mockup-acuario .form h2{font-size:26px;letter-spacing:-.03em;margin:0 0 7px}.mockup-acuario .hint{color:var(--muted);margin:0 0 23px}.mockup-acuario .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-acuario .field{display:flex;flex-direction:column;gap:7px}.mockup-acuario .field.full{grid-column:1/-1}.mockup-acuario .field label{font-size:13px;font-weight:800}.mockup-acuario .field input,.mockup-acuario .field select{width:100%;border:1px solid #cbd7db;background:#fff;border-radius:12px;padding:14px;outline:none;color:var(--ink)}.mockup-acuario .field input:focus,.mockup-acuario .field select:focus{border-color:var(--aqua);box-shadow:0 0 0 3px #168e9c1a}.mockup-acuario .primary{width:100%;border:0;background:var(--aqua);color:#fff;border-radius:13px;padding:15px;font-weight:850;margin-top:20px;cursor:pointer}
.mockup-acuario .result{background:var(--navy);color:#fff;padding:31px;position:relative;overflow:hidden}.mockup-acuario .result:after{content:"";position:absolute;width:270px;height:270px;border-radius:50%;border:48px solid #ffffff08;right:-155px;bottom:-155px}.mockup-acuario .caps{font-size:10px;color:#a8dedd;letter-spacing:.13em;font-weight:900}.mockup-acuario .big{font-size:46px;line-height:1.05;letter-spacing:-.045em;font-weight:920;margin:15px 0 7px}.mockup-acuario .sub{color:#d2dfeb;min-height:49px}.mockup-acuario .status{display:inline-block;background:#ddf3e8;color:#17634c;padding:8px 12px;border-radius:99px;font-size:13px;font-weight:850;margin:12px 0 21px}.mockup-acuario .scale-labels{display:flex;justify-content:space-between;color:#bbc8d5;font-size:10px;font-weight:800}.mockup-acuario .scale{height:12px;border-radius:99px;background:linear-gradient(90deg,#d76461 0 33%,#e5b452 33% 66%,#4cb585 66%);position:relative;margin:8px 0 22px}.mockup-acuario .marker{position:absolute;width:5px;height:27px;background:#fff;border-radius:5px;top:-7px;left:50%;box-shadow:0 0 0 3px var(--navy)}.mockup-acuario .rows{border-top:1px solid #ffffff24}.mockup-acuario .row{display:flex;justify-content:space-between;gap:18px;padding:12px 0;border-bottom:1px solid #ffffff1b;color:#d5dfeb}.mockup-acuario .row strong{color:#fff;text-align:right}
.mockup-acuario .section{padding:10px 0 70px}.mockup-acuario .section-head{text-align:center;max-width:720px;margin:0 auto 30px}.mockup-acuario .section-head h2{font-size:39px;letter-spacing:-.04em;margin:8px 0}.mockup-acuario .section-head p{color:var(--muted)}.mockup-acuario .cycle{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.mockup-acuario .step{background:#fff;border:1px solid var(--line);border-radius:18px;padding:21px;position:relative}.mockup-acuario .step:not(:last-child):after{content:"→";position:absolute;right:-12px;top:45%;z-index:2;color:var(--aqua);font-weight:900}.mockup-acuario .num{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;background:var(--aqua2);color:var(--aqua);font-weight:900;margin-bottom:14px}.mockup-acuario .step b{display:block;margin-bottom:6px}.mockup-acuario .step p{font-size:13px;color:var(--muted);margin:0}
.mockup-acuario .care{background:#e7f0ed;padding:66px 0}.mockup-acuario .care-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:65px}.mockup-acuario .care h2{font-size:40px;line-height:1.08;margin:10px 0}.mockup-acuario .care p{color:var(--muted)}.mockup-acuario .cards{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-acuario .care-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px}.mockup-acuario .care-card b{display:block;margin:8px 0 5px}.mockup-acuario .care-card span{font-size:13px;color:var(--muted)}.mockup-acuario .care-icon{color:var(--aqua);font-size:20px}
.mockup-acuario footer{background:#fff;border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:13px}
@media(max-width:850px){.mockup-acuario .nav{display:none}.mockup-acuario .hero-grid,.mockup-acuario .calc,.mockup-acuario .care-grid{grid-template-columns:1fr}.mockup-acuario .tank{height:290px}.mockup-acuario .cycle{grid-template-columns:1fr 1fr}.mockup-acuario .step:after{display:none}.mockup-acuario h1{font-size:45px}}@media(max-width:540px){.mockup-acuario .wrap{padding:0 18px}.mockup-acuario .hero{padding-top:35px}.mockup-acuario .tank{display:none}.mockup-acuario h1{font-size:39px}.mockup-acuario .cases{display:flex;overflow:auto}.mockup-acuario .case{min-width:200px}.mockup-acuario .fields,.mockup-acuario .cycle,.mockup-acuario .cards{grid-template-columns:1fr}.mockup-acuario .field.full{grid-column:auto}.mockup-acuario .tool{border-radius:18px}.mockup-acuario .form,.mockup-acuario .result{padding:25px 20px}}

.mockup-acuario { width:100%; overflow:hidden; }
.mockup-acuario .top, .mockup-acuario header.top { display:none !important; }
.mockup-acuario .foot { display:none !important; }
.mockup-acuario .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-acuario .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-acuario .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-acuario .support-real summary { cursor:pointer; font-weight:750; }
.mockup-acuario .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-acuario :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-acuario input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-acuario input[type="number"]::-webkit-inner-spin-button, .mockup-acuario input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-acuario .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-acuario support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
