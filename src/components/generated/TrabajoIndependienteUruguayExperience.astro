<div class="mockup-trabajo-independiente-uruguay" set:html={`<section class="hero"><div class="wrap"><div class="crumb">Uruguay / Impuestos / Trabajo independiente</div><div class="heroGrid"><div><span class="eyebrow">DGI · BPS · Facturación independiente</span><h1>Facturar no es lo mismo que ganar.</h1><p class="lead">Compará IRPF, monotributo, IRAE e IVA para saber cuánto reservar, cuánto pagar y cuánto te queda de verdad.</p><div class="chips"><span class="chip">IRPF Cat. II</span><span class="chip">Monotributo BPS</span><span class="chip">IRAE 25%</span><span class="chip">IVA 22% / 10%</span></div></div><aside class="summary"><div class="summaryTop"><b>EJEMPLO · SERVICIOS PERSONALES</b><span>FICTO 30%</span></div><div class="summaryValue">$U 838.042</div><div class="summaryLabel">neto anual después de gastos e IRPF estimado</div><div class="summaryRows"><div class="summaryRow"><span>Facturación</span><strong>$U 1.200.000</strong></div><div class="summaryRow"><span>Gastos usados</span><strong>$U 360.000</strong></div><div class="summaryRow"><span>IRPF estimado</span><strong>$U 1.958</strong></div></div></aside></div></div></section>
<section class="calc" id="calculadora"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">¿Bajo qué régimen facturás?</span><h2>Cuatro caminos, comparados con los mismos números.</h2></div><p>Cada régimen calcula una base distinta. Mostramos gasto, impuesto, cuota o IVA y el neto final sin mezclar conceptos.</p></div><div class="cases"><button class="case active" data-case="services"><span class="caseCode">IRPF</span><b>Servicios personales</b><span>Ficto 30% o gastos reales.</span></button><button class="case" data-case="mono"><span class="caseCode">BPS</span><b>Monotributo</b><span>Cuota, gradualidad y cobertura.</span></button><button class="case" data-case="irae"><span class="caseCode">25%</span><b>Empresa · IRAE</b><span>Renta neta fiscal.</span></button><button class="case" data-case="iva"><span class="caseCode">IVA</span><b>Calcular IVA</b><span>Agregar o quitar tasa básica/mínima.</span></button></div>
<div class="workspace"><article class="card"><div class="caseNote" id="caseNote"></div><div class="fields" id="fields"></div><div class="error" id="error"></div><div class="actionsRow"><button class="primary" id="calculate">Actualizar cálculo</button><button class="secondary" id="reset">Restablecer</button></div><p class="fine">Estimación informativa. Verificá topes, actividades habilitadas, anticipos y tablas vigentes con DGI, BPS o un contador.</p></article><aside class="card result" aria-live="polite"><div class="resultTop"><small>RESULTADO ANUAL</small><span class="pill" id="pill"></span></div><div class="answer" id="answer"></div><div class="answerLabel" id="answerLabel"></div><div class="bar"><i id="b1"></i><i id="b2"></i><i id="b3"></i><i id="b4"></i></div><div class="barLegend">Neto · gastos · impuesto · aportes/IVA</div><div class="rows" id="rows"></div><div class="insight" id="insight"></div></aside></div></div></section>
<section class="compare"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">Qué cambia entre regímenes</span><h2>La tasa sola no alcanza para comparar.</h2></div></div><div class="compareGrid"><article class="compareCard"><small>IRPF</small><h3>Escala progresiva</h3><p>Servicios personales con ficto o gastos reales y crédito por deducciones.</p></article><article class="compareCard"><small>MONOTRIBUTO</small><h3>Cuota única</h3><p>Simplifica tributos y aportes, pero tiene topes y condiciones de actividad.</p></article><article class="compareCard"><small>IRAE</small><h3>25% sobre renta</h3><p>No es sobre facturación: descuenta gastos fiscales documentados.</p></article><article class="compareCard"><small>IVA</small><h3>No es ingreso</h3><p>Lo cobrás para DGI y descontás el IVA admitido de tus compras.</p></article></div></div></section>
<section class="order"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">Orden de caja</span><h2>Separá el dinero antes del vencimiento.</h2></div><p>La cuenta sirve si el impuesto no se mezcla con el gasto cotidiano.</p></div><div class="orderGrid"><article class="orderCard"><h3>Cuenta de impuestos</h3><p>Reservá IVA y anticipos cuando cobrás.</p><ul><li>No esperes al cierre</li><li>Conciliá facturas y cobros</li><li>Guardá comprobantes</li></ul></article><article class="orderCard"><h3>Aportes por separado</h3><p>BPS o Caja profesional impactan en tu neto real.</p><ul><li>Cuota mensual</li><li>Cobertura Fonasa</li><li>Gradualidad inicial</li></ul></article><article class="orderCard"><h3>Revisá el tope</h3><p>Anticipá el cambio de régimen antes de superarlo.</p><ul><li>Facturación móvil</li><li>Nueva forma de facturar</li><li>Impacto en precios</li></ul></article></div></div></section>
<section class="faqSec"><div class="wrap faq"><span class="eyebrow">Preguntas frecuentes</span><h2>Lo que más se confunde</h2><div class="faqItem open"><button class="faqQ">¿Qué es la deducción ficta del 30%?<span>−</span></button><div class="faqA">En servicios personales permite descontar 30% de los ingresos como gasto presunto, sin comprobantes. Conviene compararlo con tus gastos reales documentados.</div></div><div class="faqItem"><button class="faqQ">¿El monotributo incluye todo?<span>+</span></button><div class="faqA">Simplifica tributos y aportes dentro de condiciones específicas, pero exige cumplir topes de facturación, actividad, local y personas ocupadas.</div></div><div class="faqItem"><button class="faqQ">¿IRAE se calcula sobre lo facturado?<span>+</span></button><div class="faqA">No. Se aplica sobre la renta neta fiscal: ingresos gravados menos gastos deducibles.</div></div><div class="faqItem"><button class="faqQ">¿Cómo saco el IVA de un precio final?<span>+</span></button><div class="faqA">Dividí el precio final por 1,22 o 1,10 según la tasa. Restar 22% o 10% directamente da un neto incorrecto.</div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-trabajo-independiente-uruguay')?document.currentScript.previousElementSibling:document.querySelector('.mockup-trabajo-independiente-uruguay');if(!root)return;

const $=id=>root.querySelector("#"+id),$$=s=>[...root.querySelectorAll(s)],uyu=n=>"$U "+new Intl.NumberFormat("es-UY",{maximumFractionDigits:0}).format(Math.round(n)),dec=(n,d=1)=>new Intl.NumberFormat("es-UY",{maximumFractionDigits:d}).format(n),num=id=>Number($(id)?.value||0);let current="services";const BPC=6864;
const common=[["income","Facturación anual sin IVA",1200000,"$U","number"],["expenses","Gastos documentados",250000,"$U","number"]];
const cfg={services:{note:"Para servicios personales comparamos el ficto del 30% contra gastos reales y usamos la deducción mayor.",pill:"IRPF · SERVICIOS",fields:[...common,["contributions","Aportes BPS o Caja",180000,"$U","number"],["children","Hijos menores a cargo",0,"","number"]]},mono:{note:"El monotributo usa una cuota fija con gradualidad jubilatoria. Los montos son referenciales y deben verificarse en BPS.",pill:"MONOTRIBUTO BPS",fields:[["income","Facturación anual",900000,"$U","number"],["months","Antigüedad",6,"meses","number"],["coverage","Cobertura de salud","individual","","select",[["none","Sin Fonasa"],["individual","Sólo titular"],["spouse","Titular y cónyuge"],["children","Titular, cónyuge e hijos"]]]]},irae:{note:"IRAE es 25% de la renta neta fiscal. No se aplica sobre la facturación completa.",pill:"IRAE · EMPRESA",fields:common},iva:{note:"Calculá IVA sobre un neto o separalo de un precio que ya lo incluye. El IVA cobrado no es ingreso propio.",pill:"IVA",fields:[["amount","Monto",100000,"$U","number"],["rate","Tasa","basic","","select",[["basic","Básica · 22%"],["minimum","Mínima · 10%"]]],["operation","Operación","add","","select",[["add","Agregar IVA a un neto"],["remove","Quitar IVA de un precio final"]]]]}};
function field([id,label,value,unit,type,options]){let c=type==="select"?`<select id="${id}">${options.map(o=>`<option value="${o[0]}"${o[0]===value?" selected":""}>${o[1]}</option>`).join("")}</select>`:`${unit==="$U"?`<span>$U</span>`:""}<input id="${id}" type="number" step="any" value="${value}">${unit&&unit!=="$U"?`<span>${unit}</span>`:""}`;return `<div class="field"><label for="${id}">${label}</label><div class="control">${c}</div></div>`}function row(k,v){return `<div class="row"><span>${k}</span><strong>${v}</strong></div>`}function fail(m){$("error").textContent=m;$("error").style.display="block";return false}
const bands=[[7,0],[10,.10],[15,.15],[30,.24],[50,.25],[75,.27],[115,.31],[Infinity,.36]];function irpfAnnual(base){let remaining=Math.max(0,base),prev=0,tax=0;for(const [top,rate] of bands){const limit=top*BPC*12,portion=Math.max(0,Math.min(remaining,limit-prev));tax+=portion*rate;remaining-=portion;prev=limit;if(remaining<=0)break}return tax}function paint(total,label,rows,insight,parts){$("answer").textContent=total;$("answerLabel").textContent=label;$("rows").innerHTML=rows;$("insight").innerHTML=insight;const s=parts.reduce((a,b)=>a+Math.max(0,b),0)||1;["b1","b2","b3","b4"].forEach((id,i)=>$(id).style.width=Math.max(0,parts[i]||0)/s*100+"%")}
function calculate(){const inputs=[...$("fields").querySelectorAll("input")].map(i=>Number(i.value));if(inputs.some(v=>!Number.isFinite(v)||v<0))return fail("Revisá los datos: deben ser números válidos y no negativos.");$("error").style.display="none";
if(current==="services"){const income=num("income"),real=num("expenses"),fict=income*.30,used=Math.max(real,fict),base=Math.max(0,income-used),primary=irpfAnnual(base),deductions=num("contributions")+num("children")*20*BPC,creditRate=income/12<15*BPC?.14:.08,credit=deductions*creditRate,tax=Math.max(0,primary-credit),net=income-used-tax;paint(uyu(net),"neto anual después de gastos usados e IRPF",row("Facturación",uyu(income))+row("Gasto ficticio · 30%",uyu(fict))+row("Gastos reales",uyu(real))+row("Deducción usada",uyu(used))+row("IRPF antes de créditos",uyu(primary))+row("Crédito por deducciones",uyu(credit))+row("IRPF estimado",uyu(tax))+row("Neto estimado",uyu(net)),`<strong>Conviene usar ${real>fict?"gastos reales":"el ficto del 30%"} en esta comparación.</strong>Los aportes obligatorios siguen afectando tu caja aunque generen crédito.`,[net,used,tax,num("contributions")])}
else if(current==="mono"){const income=num("income"),months=Math.round(num("months")),coverage=$("coverage").value,full={none:3900,individual:6500,spouse:8600,children:9300}[coverage],factor=months<=12?.25:months<=24?.5:1,pension=3900*factor,health=Math.max(0,full-3900),monthly=pension+health,annual=monthly*12,net=income-annual,tope=1175537;paint(uyu(annual),"cuota anual estimada · "+uyu(monthly)+" por mes",row("Facturación anual",uyu(income))+row("Componente jubilatorio",uyu(pension)+" / mes")+row("Cobertura de salud",uyu(health)+" / mes")+row("Factor de gradualidad",dec(factor*100,0)+"%")+row("Cuota mensual",uyu(monthly))+row("Cuota anual",uyu(annual))+row("Neto después de cuota",uyu(net)),`<strong>${income>tope?"La facturación supera el tope referencial.":"La facturación queda bajo el tope referencial."}</strong>Verificá cuota, actividad y tope vigente directamente en BPS.`,[net,0,0,annual])}
else if(current==="irae"){const income=num("income"),expenses=num("expenses"),profit=Math.max(0,income-expenses),tax=profit*.25,net=profit-tax;paint(uyu(tax),"IRAE anual · 25% sobre renta neta",row("Ingresos gravados",uyu(income))+row("Gastos deducibles",uyu(expenses))+row("Renta neta fiscal",uyu(profit))+row("Tasa IRAE","25%")+row("IRAE estimado",uyu(tax))+row("Resultado después de IRAE",uyu(net)),`<strong>La tasa efectiva sobre facturación es ${income?dec(tax/income*100,1):0}%.</strong>La deducibilidad real exige documentación y vínculo con la renta gravada.`,[net,expenses,tax,0])}
else{const amount=num("amount"),rate=$("rate").value==="basic"?.22:.10,add=$("operation").value==="add",net=add?amount:amount/(1+rate),vat=add?amount*rate:amount-net,total=net+vat;paint(add?uyu(total):uyu(net),add?"precio final con IVA":"neto sin IVA contenido",row("Tasa aplicada",dec(rate*100,0)+"%")+row("Neto sin IVA",uyu(net))+row("IVA",uyu(vat))+row("Precio final",uyu(total)),`<strong>${add?"El IVA a reservar es "+uyu(vat)+".":"El precio contenía "+uyu(vat)+" de IVA."}</strong>Para quitar IVA se divide por 1 más la tasa; no se resta el porcentaje.`,[net,0,0,vat])}}
function setCase(id){current=id;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.case===id));$("caseNote").textContent=cfg[id].note;$("pill").textContent=cfg[id].pill;$("fields").innerHTML=cfg[id].fields.map(field).join("");$$("#fields input").forEach(i=>i.onkeydown=e=>{if(e.key==="Enter")calculate()});calculate()}$$(".case").forEach(b=>b.onclick=()=>setCase(b.dataset.case));$("calculate").onclick=()=>{calculate();$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1100)};$("reset").onclick=()=>setCase("services");$$(".faqQ").forEach(q=>q.onclick=()=>{const item=q.parentElement;item.classList.toggle("open");q.lastElementChild.textContent=item.classList.contains("open")?"−":"+"});setCase("services");

})();
</script>
