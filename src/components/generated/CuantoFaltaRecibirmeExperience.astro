---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-cuanto-falta-recibirme" set:html={`
    <div class="wrap">
      <div class="hero"><div><div class="crumb">Estudio / Cuánto falta para recibirme</div><div class="eyebrow">Tu carrera, en un mapa posible</div><h1>¿Cuánto te falta para recibirte?</h1><p class="lead">Medí tu avance real, proyectá cuándo terminás y entendé qué cambia si ajustás el ritmo de cursada.</p><div class="chips"><span class="chip">✓ Materias y créditos</span><span class="chip">✓ Fecha estimada</span><span class="chip">✓ Escenarios de ritmo</span></div></div><div class="visual"><div class="book"></div><div class="cap"></div><div class="path"><div class="path-fill"></div></div><div class="milestone m1"></div><div class="milestone m2"></div><div class="milestone m3"></div><div class="note n1">60% aprobado</div><div class="note n2">La recta final se planifica</div></div></div>
      <form class="calc" id="calculator"><div class="case-label">¿CÓMO QUERÉS MEDIR TU AVANCE?</div><div class="cases"><button type="button" class="case active" data-mode="subjects">Materias</button><button type="button" class="case" data-mode="terms">Cuatrimestres</button><button type="button" class="case" data-mode="duration">Duración total</button><button type="button" class="case" data-mode="credits">Créditos</button><button type="button" class="case" data-mode="hours">Horas de estudio</button></div>
        <div class="grid"><div class="panel"><h2 id="formTitle">Tu avance en materias</h2><p class="hint" id="formHint">Separá lo aprobado de lo que todavía estás cursando.</p>
          <div class="fields mode-only active" data-only="subjects"><div class="field"><label for="total">Materias del plan</label><input class="control" id="total" type="number" value="40" min="1"></div><div class="field"><label for="passed">Materias aprobadas</label><input class="control" id="passed" type="number" value="24" min="0"></div><div class="field full"><label for="current">Materias en curso</label><input class="control" id="current" type="number" value="4" min="0"></div></div>
          <div class="fields mode-only" data-only="pace"><div class="field"><label for="perTerm">Materias que cursás por cuatrimestre</label><input class="control" id="perTerm" type="number" value="4" min="1"></div><div class="field"><label for="passRate">Tasa de aprobación (%)</label><input class="control" id="passRate" type="number" value="70" min="10" max="100" step="5"></div><div class="field full"><label for="termsYear">Cuatrimestres por año</label><select class="control" id="termsYear"><option value="2">2 — calendario normal</option><option value="3">3 — incluye verano</option></select></div></div>
          <div class="fields mode-only" data-only="duration"><div class="field"><label for="yearsDone">Años que llevás cursando</label><input class="control" id="yearsDone" type="number" value="4" min="0" step=".5"></div><div class="field"><label for="officialYears">Duración teórica del plan</label><input class="control" id="officialYears" type="number" value="5" min="1" step=".5"></div></div>
          <div class="fields mode-only" data-only="credits"><div class="field"><label for="creditsTotal">Créditos totales</label><input class="control" id="creditsTotal" type="number" value="240" min="1"></div><div class="field"><label for="creditsPassed">Créditos aprobados</label><input class="control" id="creditsPassed" type="number" value="180" min="0"></div><div class="field full"><label for="creditsTerm">Créditos por cuatrimestre</label><input class="control" id="creditsTerm" type="number" value="30" min="1"></div></div>
          <div class="fields mode-only" data-only="hours"><div class="field"><label for="classHours">Horas de clase por materia</label><input class="control" id="classHours" type="number" value="6" min="1"></div><div class="field"><label for="studyFactor">Factor de estudio</label><select class="control" id="studyFactor"><option value="2">2 — materia liviana</option><option value="2.5" selected>2,5 — cursada normal</option><option value="3">3 — materia técnica</option><option value="4">4 — alta demanda</option></select></div><div class="field full"><label for="subjectCount">Materias que cursás</label><input class="control" id="subjectCount" type="number" value="4" min="1"></div></div>
          <button class="update" id="updateButton" type="submit">Actualizar proyección</button>
        </div>
        <div class="panel result"><div class="kicker" id="kicker">TU AVANCE REAL</div><div class="big" id="resultValue">12 materias</div><div class="sub" id="resultSub">te faltan después de las 4 que cursás ahora</div><div class="badge" id="resultBadge">Llevás 60% aprobado</div><div class="tiles"><div class="tile"><small id="t1l">Aprobadas</small><strong id="t1v">24 de 40</strong></div><div class="tile"><small id="t2l">En curso</small><strong id="t2v">4 materias</strong></div><div class="tile"><small id="t3l">Avance optimista</small><strong id="t3v">70%</strong></div></div></div></div>
      </form>
    </div>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Tu posición hoy</div><h2 id="progressTitle">El recorrido de tu carrera</h2><p id="progressCopy">Contamos como avance real sólo las materias aprobadas.</p></div><div class="progress-card"><div class="progress-top"><div><h3 id="progressName">Segunda mitad</h3><p id="progressDetail">24 de 40 materias aprobadas.</p></div><div class="progress-value" id="progressValue">60%</div></div><div class="progress"><div class="progress-fill" id="progressFill"></div></div><div class="ticks"><span>Inicio</span><span>25%</span><span>Mitad</span><span>75%</span><span>Título</span></div></div></div></section>
    <section><div class="wrap two"><div class="info"><div class="eyebrow">La cuenta, sin magia</div><h3 id="breakTitle">Cómo llegamos al resultado</h3><div class="rows" id="breakRows"></div></div><div class="info notice"><div class="notice-icon">◉</div><h3>Una materia en curso todavía no está aprobada</h3><p>Por eso separamos el avance real del optimista. También conviene revisar optativas, idiomas, prácticas y tesis que pueden quedar fuera de la grilla principal.</p><div class="rows"><div class="row"><span>Dato oficial</span><strong>Certificado analítico</strong></div><div class="row"><span>Mayor incertidumbre</span><strong>Correlatividades</strong></div></div></div></div></section>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Probá otro ritmo</div><h2>Qué cambia con tu carga por cuatrimestre</h2></div><div class="scenarios"><div class="scenario"><div class="scenario-tag">Ritmo más liviano</div><b id="slowScenario">8 cuatrimestres</b><span>Una materia menos por período.</span></div><div class="scenario recommended"><div class="scenario-tag">Tu ritmo actual</div><b id="currentScenario">5 cuatrimestres</b><span>Con tu tasa de aprobación real.</span></div><div class="scenario"><div class="scenario-tag">Ritmo intensivo</div><b id="fastScenario">4 cuatrimestres</b><span>Una materia más por período.</span></div></div></div></section>
    <div class="dark"><div class="wrap dark-grid"><div class="formula">Materias que faltan<span>÷ aprobadas efectivas por cuatrimestre</span>= cuatrimestres restantes<small>El redondeo siempre es hacia arriba: media materia también necesita un período.</small></div><div><div class="eyebrow" style="color:#70d5c5">Planificar sin castigarte</div><h2>El ritmo sostenible vale más que el ritmo ideal.</h2><p>Cursar más no siempre acelera: si baja tu tasa de aprobación, podés terminar tardando más.</p><div class="checks"><div class="check"><span class="tick">✓</span><span>Usá tu tasa real de los últimos cuatrimestres.</span></div><div class="check"><span class="tick">✓</span><span>Revisá correlatividades antes de armar la proyección.</span></div><div class="check"><span class="tick">✓</span><span>Por encima de 45 horas semanales, la carga suele ser difícil de sostener.</span></div></div></div></div></div>
  `} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-cuanto-falta-recibirme')?document.currentScript.previousElementSibling:document.querySelector('.mockup-cuanto-falta-recibirme');

    const $=id=>root.querySelector("#"+id),fmt=(n,d=1)=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:d,minimumFractionDigits:d});let mode="subjects";
    const cfg={subjects:["Tu avance en materias","Separá lo aprobado de lo que todavía estás cursando."],terms:["Cuándo terminás a tu ritmo","La tasa de aprobación evita una proyección demasiado optimista."],duration:["Duración real frente al plan","Sumamos lo cursado y lo que falta a tu ritmo actual."],credits:["Tu avance por créditos","Los créditos ponderan la carga de cada materia."],hours:["Carga semanal de estudio","Estimá clases y estudio propio para todo el cuatrimestre."]};
    function set(id,v){$(id).textContent=v}function rows(a){$("breakRows").innerHTML=a.map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
    function shared(){const total=Math.max(1,Number($("total").value)||40),passed=Math.min(total,Math.max(0,Number($("passed").value)||0)),current=Math.min(total-passed,Math.max(0,Number($("current").value)||0)),left=Math.max(0,total-passed-current),per=Math.max(1,Number($("perTerm").value)||4),rate=Math.min(100,Math.max(1,Number($("passRate").value)||70))/100,ty=Math.max(1,Number($("termsYear").value)||2);return{total,passed,current,left,per,rate,ty,effective:per*rate,terms:left?Math.ceil(left/(per*rate)):0,progress:passed/total*100}}
    function scenarios(r){const calc=p=>r.left?Math.ceil(r.left/(Math.max(1,p)*r.rate)):0;set("slowScenario",calc(Math.max(1,r.per-1))+" cuatrimestres");set("currentScenario",calc(r.per)+" cuatrimestres");set("fastScenario",calc(r.per+1)+" cuatrimestres")}
    function progress(value,name,detail){const v=Math.min(100,Math.max(0,value));$("progressFill").style.width=v+"%";set("progressValue",fmt(v,0)+"%");set("progressName",name);set("progressDetail",detail)}
    function calculate(){const r=shared();scenarios(r);
      if(mode==="subjects"){const optimistic=(r.passed+r.current)/r.total*100;set("kicker","TU AVANCE REAL");set("resultValue",r.left+" materias");set("resultSub",`te faltan después de las ${r.current} que cursás ahora`);set("resultBadge",`Llevás ${fmt(r.progress,0)}% aprobado`);set("t1l","Aprobadas");set("t1v",`${r.passed} de ${r.total}`);set("t2l","En curso");set("t2v",r.current+" materias");set("t3l","Avance optimista");set("t3v",fmt(optimistic,0)+"%");progress(r.progress,r.progress>=75?"Recta final":r.progress>=50?"Segunda mitad":"En camino",`${r.passed} de ${r.total} materias aprobadas.`);rows([["Total del plan",r.total+" materias"],["Aprobadas",r.passed+" materias"],["En curso",r.current+" materias"],["Pendientes después de este cuatrimestre",r.left+" materias"],["Avance real",fmt(r.progress,1)+"%"],["Avance si aprobás las actuales",fmt(optimistic,1)+"%"]])}
      if(mode==="terms"){const years=r.terms/r.ty,months=Math.round(years*12);set("kicker","TIEMPO ESTIMADO");set("resultValue",r.terms+" cuatrimestres");set("resultSub",`${fmt(years,1)} años a tu ritmo actual`);set("resultBadge",`Aprobás ${fmt(r.effective,1)} materias por cuatrimestre`);set("t1l","Materias pendientes");set("t1v",r.left);set("t2l","En meses");set("t2v",months+" meses");set("t3l","Tasa de aprobación");set("t3v",fmt(r.rate*100,0)+"%");progress(r.progress,"Proyección de egreso",`Te quedan ${r.terms} cuatrimestres según tu ritmo.`);rows([["Materias que faltan",r.left],["Cursadas por cuatrimestre",r.per],["Tasa de aprobación",fmt(r.rate*100,0)+"%"],["Aprobadas efectivas",fmt(r.effective,1)],["Cuatrimestres restantes",r.terms],["Equivalente",fmt(years,1)+" años"]])}
      if(mode==="duration"){const done=Math.max(0,Number($("yearsDone").value)||0),official=Math.max(.5,Number($("officialYears").value)||5),remaining=r.terms/r.ty,real=done+remaining,diff=real-official;set("kicker","DURACIÓN REAL ESTIMADA");set("resultValue",fmt(real,1)+" años");set("resultSub",`${fmt(done,1)} cursados + ${fmt(remaining,1)} restantes`);set("resultBadge",diff>0?`${fmt(diff,1)} años sobre el plan`:"Dentro de la duración teórica");set("t1l","Plan teórico");set("t1v",fmt(official,1)+" años");set("t2l","Tiempo restante");set("t2v",fmt(remaining,1)+" años");set("t3l","Diferencia");set("t3v",(diff>=0?"+":"")+fmt(diff,1)+" años");progress(real?done/real*100:0,"Recorrido total estimado",`Llevás ${fmt(done,1)} de ${fmt(real,1)} años.`);rows([["Años ya cursados",fmt(done,1)],["Materias pendientes",r.left],["Cuatrimestres restantes",r.terms],["Años restantes",fmt(remaining,1)],["Duración teórica",fmt(official,1)],["Duración real estimada",fmt(real,1)]])}
      if(mode==="credits"){const total=Math.max(1,Number($("creditsTotal").value)||240),passed=Math.min(total,Math.max(0,Number($("creditsPassed").value)||0)),per=Math.max(1,Number($("creditsTerm").value)||30),left=total-passed,terms=left?Math.ceil(left/per):0,p=passed/total*100;set("kicker","AVANCE EN CRÉDITOS");set("resultValue",left+" créditos");set("resultSub",`te faltan de ${total} créditos del plan`);set("resultBadge",`Llevás ${fmt(p,0)}% aprobado`);set("t1l","Cuatrimestres");set("t1v",terms);set("t2l","Ritmo");set("t2v",per+" créditos");set("t3l","En años");set("t3v",fmt(terms/r.ty,1));progress(p,p>=75?"Recta final en créditos":"Avance por créditos",`${passed} de ${total} créditos aprobados.`);rows([["Créditos totales",total],["Créditos aprobados",passed],["Créditos pendientes",left],["Avance",fmt(p,1)+"%"],["Créditos por cuatrimestre",per],["Cuatrimestres restantes",terms]])}
      if(mode==="hours"){const cls=Math.max(1,Number($("classHours").value)||6),factor=Math.max(1,Number($("studyFactor").value)||2.5),count=Math.max(1,Number($("subjectCount").value)||4),per=cls*factor,total=per*count,own=(per-cls)*count;set("kicker","CARGA SEMANAL");set("resultValue",fmt(total,0)+" horas");set("resultSub",`por semana para ${count} materias`);set("resultBadge",total>45?"Carga alta: revisá si es sostenible":"Carga dentro de un rango posible");set("t1l","Horas de clase");set("t1v",cls*count+" h");set("t2l","Estudio propio");set("t2v",fmt(own,0)+" h");set("t3l","Por materia");set("t3v",fmt(per,0)+" h");progress(Math.min(100,total/60*100),total>45?"Carga semanal alta":"Carga semanal estimada",`${fmt(total,0)} horas sobre una escala de 60.`);rows([["Horas de clase por materia",cls],["Factor de estudio",fmt(factor,1)],["Carga por materia",fmt(per,1)+" h/semana"],["Cantidad de materias",count],["Estudio propio total",fmt(own,1)+" h/semana"],["Carga semanal total",fmt(total,1)+" h"]])}}
    root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));root.querySelectorAll(".mode-only").forEach(x=>{const o=x.dataset.only;x.classList.toggle("active",o===mode||(o==="subjects"&&(mode==="subjects"||mode==="terms"||mode==="duration"))||(o==="pace"&&(mode==="terms"||mode==="duration")))});set("formTitle",cfg[mode][0]);set("formHint",cfg[mode][1]);calculate()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calculate));function confirm(){calculate();$("updateButton").textContent="✓ Proyección actualizada";clearTimeout(window.gradTimer);window.gradTimer=setTimeout(()=>$("updateButton").textContent="Actualizar proyección",1200)}$("calculator").addEventListener("submit",e=>{e.preventDefault();confirm()});$("updateButton").addEventListener("click",e=>{e.preventDefault();confirm()});calculate();
  
})();
</script>
<style is:global>

    .mockup-cuanto-falta-recibirme{--ink:#111a34;--muted:#667187;--blue:#2168e8;--violet:#725ae6;--teal:#25b4a0;--amber:#f1ae4c;--paper:#f6f6f2;--line:#dfe4ea;--navy:#174B7A}
    .mockup-cuanto-falta-recibirme *{box-sizing:border-box}.mockup-cuanto-falta-recibirme{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-cuanto-falta-recibirme button,.mockup-cuanto-falta-recibirme input,.mockup-cuanto-falta-recibirme select{font:inherit}.mockup-cuanto-falta-recibirme .wrap{width:min(1180px,calc(100% - 40px));margin:auto}
    .mockup-cuanto-falta-recibirme header{height:86px;border-bottom:1px solid #e0e4e7;display:flex;align-items:center}.mockup-cuanto-falta-recibirme .nav{display:flex;align-items:center;gap:28px}.mockup-cuanto-falta-recibirme .brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:900}.mockup-cuanto-falta-recibirme .logo{width:29px;height:38px;border-radius:6px;background:linear-gradient(145deg,#18355c,#527a99);display:grid;place-items:center;color:white}.mockup-cuanto-falta-recibirme .links{display:flex;gap:25px;color:#505b6d;font-size:14px;font-weight:750}.mockup-cuanto-falta-recibirme .tools{margin-left:auto;display:flex;gap:9px}.mockup-cuanto-falta-recibirme .tool{height:42px;padding:0 14px;border:1px solid #dce1e7;background:white;border-radius:11px;color:#526075;font-weight:750}
    .mockup-cuanto-falta-recibirme .hero{display:grid;grid-template-columns:1.08fr .92fr;gap:45px;align-items:center;padding:62px 0 45px}.mockup-cuanto-falta-recibirme .crumb{color:#3167c4;font-size:14px;margin-bottom:17px}.mockup-cuanto-falta-recibirme .eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:#2572b4;font-weight:900}.mockup-cuanto-falta-recibirme h1{font-size:clamp(43px,5vw,67px);line-height:1;letter-spacing:-.05em;margin:13px 0 20px}.mockup-cuanto-falta-recibirme .lead{font-size:19px;color:var(--muted);max-width:690px}.mockup-cuanto-falta-recibirme .chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:25px}.mockup-cuanto-falta-recibirme .chip{background:#fff;border:1px solid var(--line);border-radius:99px;padding:9px 13px;font-size:13px;font-weight:800}
