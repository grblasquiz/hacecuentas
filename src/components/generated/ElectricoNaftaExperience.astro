<div class="mockup-electrico-nafta" set:html={`
<section class="hero"><div class="wrap"><div class="crumb"><span>Auto</span> / Eléctrico vs. nafta</div><div class="heroGrid"><div><div class="eyebrow">Comparador de costo total</div><h1>¿El eléctrico se paga solo? Hacé la cuenta completa.</h1><p>Compará compra, consumo, mantenimiento y reventa. Descubrí cuánto cuesta cada kilómetro y cuándo recuperás la diferencia.</p><div class="badges"><span class="badge">⚡ Carga en casa y pública</span><span class="badge">↗ Punto de equilibrio</span><span class="badge">✓ Todos los costos</span></div></div><div class="visual"><div class="moon"></div><div class="bolt">ϟ</div><div class="car gasCar"></div><div class="car evCar"></div><div class="road"></div><div class="labels"><span>NAFTA</span><span>ELÉCTRICO</span></div></div></div></div></section>
<section class="calcSection"><div class="wrap"><div class="calcShell"><div class="calcHead"><h2>Compará tus dos autos</h2><span class="steps">Completá tus datos · resultado instantáneo</span></div><div class="calcBody"><div class="formPane"><div class="presetRow"><button class="preset active" data-preset="city">Uso ciudad</button><button class="preset" data-preset="mixed">Uso mixto</button><button class="preset" data-preset="intensive">Uso intensivo</button></div><div class="sectionLabel">Tu uso</div><div class="grid2"><div class="field"><label>Kilómetros por año</label><div class="inputWrap"><input id="km" type="number" value="15000" min="1000"><span class="unit">km</span></div></div><div class="field"><label>Tiempo que lo vas a tener</label><div class="inputWrap"><input id="years" type="number" value="5" min="1" max="20"><span class="unit">años</span></div></div></div><div class="sectionLabel">Auto a nafta</div><div class="grid2"><div class="field"><label>Precio de compra</label><div class="inputWrap"><input id="gasPriceCar" type="number" value="32000000"><span class="unit">$</span></div></div><div class="field"><label>Consumo</label><div class="inputWrap"><input id="gasConsumption" type="number" value="8" step=".1"><span class="unit">L/100</span></div></div><div class="field"><label>Precio de la nafta</label><div class="inputWrap"><input id="gasPrice" type="number" value="1425"><span class="unit">$/L</span></div></div><div class="field"><label>Mantenimiento anual</label><div class="inputWrap"><input id="gasMaint" type="number" value="900000"><span class="unit">$</span></div></div></div><div class="sectionLabel">Auto eléctrico</div><div class="grid2"><div class="field"><label>Precio de compra</label><div class="inputWrap"><input id="evPriceCar" type="number" value="46000000"><span class="unit">$</span></div></div><div class="field"><label>Consumo</label><div class="inputWrap"><input id="evConsumption" type="number" value="16" step=".1"><span class="unit">kWh/100</span></div></div><div class="field"><label>Precio carga en casa</label><div class="inputWrap"><input id="kwhPrice" type="number" value="130"><span class="unit">$/kWh</span></div></div><div class="field"><label>Carga pública</label><div class="inputWrap"><input id="publicShare" type="number" value="15" min="0" max="100"><span class="unit">%</span></div></div><div class="field"><label>Precio carga pública</label><div class="inputWrap"><input id="publicPrice" type="number" value="450"><span class="unit">$/kWh</span></div></div><div class="field"><label>Mantenimiento anual</label><div class="inputWrap"><input id="evMaint" type="number" value="450000"><span class="unit">$</span></div></div></div><button class="calculate" id="calculate">Actualizar comparación</button></div><aside class="resultPane"><div class="resultTitle"><h3>Costo total estimado</h3><span class="live">● EN VIVO</span></div><div class="compare"><div class="vehicleResult"><div class="vehicleName">Nafta <span class="dot"></span></div><div class="amount" id="tcoGas">$ 0</div><div class="small" id="gasPerKm">$0 por km</div></div><div class="vehicleResult ev"><div class="vehicleName">Eléctrico <span class="dot"></span></div><div class="amount" id="tcoEv">$ 0</div><div class="small" id="evPerKm">$0 por km</div></div></div><div class="bars"><div class="barLabel"><span>Nafta</span><span id="gasBarValue"></span></div><div class="barTrack"><div class="barFill" id="gasBar"></div></div><div class="barLabel"><span>Eléctrico</span><span id="evBarValue"></span></div><div class="barTrack"><div class="barFill ev" id="evBar"></div></div></div><div class="verdict"><div class="verdictTop"><span class="check">✓</span><h4 id="verdictTitle">Calculando tu mejor opción…</h4></div><p id="verdictText"></p></div><div class="metricRow"><div class="metric"><strong id="annualSave">$ 0</strong><span>Ahorro operativo anual</span></div><div class="metric"><strong id="payback">—</strong><span>Punto de equilibrio</span></div><div class="metric"><strong id="energyGas">$ 0</strong><span>Energía anual nafta</span></div><div class="metric"><strong id="energyEv">$ 0</strong><span>Energía anual eléctrico</span></div></div><p class="finePrint">Estimación orientativa en pesos. Incluye compra, energía, mantenimiento y valor de reventa supuesto (55% nafta y 50% eléctrico). Seguro y patente dependen del modelo y la jurisdicción.</p></aside></div></div></div></section>
<section class="content"><div class="wrap"><div class="center"><div class="eyebrow">Las cuatro variables clave</div><h2>Lo que realmente cambia la decisión</h2><p>No alcanza con mirar cuánto cuesta llenar el tanque.</p></div><div class="factorGrid"><article class="factor"><div class="icon">↗</div><h3>Cuánto manejás</h3><p>Más kilómetros hacen que el menor costo de energía del eléctrico pese mucho más.</p></article><article class="factor"><div class="icon">⌂</div><h3>Dónde cargás</h3><p>Cargar en casa suele ser mucho más barato que depender de cargadores públicos.</p></article><article class="factor"><div class="icon">$</div><h3>Diferencia de compra</h3><p>Cuanto menor sea la brecha inicial, antes llega el punto de equilibrio.</p></article><article class="factor"><div class="icon">◷</div><h3>Cuántos años lo tenés</h3><p>El ahorro se acumula: una decisión cara al inicio puede ganar con el tiempo.</p></article></div></div></section>
<section class="breakdown"><div class="wrap breakGrid"><div><div class="eyebrow" style="color:#75dcb9">Sin letra chica</div><h2>¿Qué incluye la comparación?</h2><p>El resultado separa inversión y uso. Así podés entender si el ahorro diario alcanza para compensar el precio inicial.</p></div><div class="table"><div class="row head"><span>Concepto</span><strong>Nafta</strong><strong>Eléctrico</strong></div><div class="row"><span>Compra inicial</span><strong id="tableGasBuy"></strong><strong id="tableEvBuy"></strong></div><div class="row"><span>Energía del período</span><strong id="tableGasEnergy"></strong><strong class="green" id="tableEvEnergy"></strong></div><div class="row"><span>Mantenimiento</span><strong id="tableGasMaint"></strong><strong id="tableEvMaint"></strong></div><div class="row"><span>Valor recuperado al vender</span><strong id="tableGasResale"></strong><strong id="tableEvResale"></strong></div><div class="row"><span><b>Costo total</b></span><strong id="tableGasTotal"></strong><strong id="tableEvTotal"></strong></div></div></div></section>
<section class="faq"><div class="wrap"><div class="center"><div class="eyebrow">Dudas frecuentes</div><h2>Antes de decidir</h2></div><div class="faqWrap"><div class="faqItem open"><button class="faqQ">¿El eléctrico siempre termina siendo más barato?<span>−</span></button><div class="faqA">No. Depende de la diferencia de precio de compra, los kilómetros recorridos, el costo de la carga y cuánto tiempo conserves el auto. Por eso mostramos el punto de equilibrio.</div></div><div class="faqItem"><button class="faqQ">¿Por qué importa tanto cargar en casa?<span>+</span></button><div class="faqA">Porque la tarifa residencial puede ser sensiblemente menor a la carga rápida pública. Si dependés mucho de cargadores, el ahorro operativo se reduce.</div></div><div class="faqItem"><button class="faqQ">¿La batería está incluida en la cuenta?<span>+</span></button><div class="faqA">Está contemplada indirectamente en el valor de reventa estimado. Un reemplazo extraordinario no está incluido porque depende de garantía, modelo, uso y degradación.</div></div><div class="faqItem"><button class="faqQ">¿Qué costos debería sumar antes de comprar?<span>+</span></button><div class="faqA">Cotizá seguro, patente, instalación del cargador y financiación para ambos modelos. Esos valores cambian mucho según vehículo, banco y jurisdicción.</div></div></div></div></section>
<button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="searchBtn" hidden aria-hidden="true"></button><button type="button" id="themeBtn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-electrico-nafta')?document.currentScript.previousElementSibling:document.querySelector('.mockup-electrico-nafta');if(!root)return;

const $=id=>root.querySelector("#"+id);
const ids=['km','years','gasPriceCar','gasConsumption','gasPrice','gasMaint','evPriceCar','evConsumption','kwhPrice','publicShare','publicPrice','evMaint'];
const money=n=>'$ '+Math.round(n).toLocaleString('es-AR');
const val=id=>Math.max(0,Number($(id).value)||0);
function calculate(showToast=false){
 const km=val('km'),years=Math.max(1,val('years')),gasBuy=val('gasPriceCar'),evBuy=val('evPriceCar');
 const gasEnergyYear=km/100*val('gasConsumption')*val('gasPrice');
 const share=Math.min(100,val('publicShare'))/100;
 const avgKwh=val('kwhPrice')*(1-share)+val('publicPrice')*share;
 const evEnergyYear=km/100*val('evConsumption')*avgKwh;
 const gasMaintYear=val('gasMaint'),evMaintYear=val('evMaint');
 const gasResale=gasBuy*.55,evResale=evBuy*.50;
 const gasTco=gasBuy+years*(gasEnergyYear+gasMaintYear)-gasResale;
 const evTco=evBuy+years*(evEnergyYear+evMaintYear)-evResale;
 const totalKm=Math.max(1,km*years),annualOperatingSave=(gasEnergyYear+gasMaintYear)-(evEnergyYear+evMaintYear);
 const upfrontGap=evBuy-gasBuy;
 const payback=annualOperatingSave>0&&upfrontGap>0?upfrontGap/annualOperatingSave:0;
 $('tcoGas').textContent=money(gasTco);$('tcoEv').textContent=money(evTco);
 $('gasPerKm').textContent=money(gasTco/totalKm)+' por km';$('evPerKm').textContent=money(evTco/totalKm)+' por km';
 const max=Math.max(gasTco,evTco,1);$('gasBar').style.width=(gasTco/max*100)+'%';$('evBar').style.width=(evTco/max*100)+'%';
 $('gasBarValue').textContent=money(gasTco);$('evBarValue').textContent=money(evTco);
 $('annualSave').textContent=money(Math.abs(annualOperatingSave));
 $('payback').textContent=payback>0&&isFinite(payback)?(payback.toLocaleString('es-AR',{maximumFractionDigits:1})+' años'):'No recupera';
 $('energyGas').textContent=money(gasEnergyYear);$('energyEv').textContent=money(evEnergyYear);
 const diff=Math.abs(gasTco-evTco);
 if(evTco<gasTco){$('verdictTitle').textContent='El eléctrico gana en este escenario';$('verdictText').textContent='En '+years+' años gastarías '+money(diff)+' menos. '+(payback&&payback<=years?'La diferencia de compra se recupera cerca del año '+payback.toFixed(1)+'.':'El costo total ya contempla el valor de reventa estimado.')}
 else{$('verdictTitle').textContent='La nafta todavía conviene más';$('verdictText').textContent='En este plazo cuesta '+money(diff)+' menos. Probá más kilómetros, más años o una menor diferencia de compra para encontrar el punto de equilibrio.'}
 $('tableGasBuy').textContent=money(gasBuy);$('tableEvBuy').textContent=money(evBuy);
 $('tableGasEnergy').textContent=money(gasEnergyYear*years);$('tableEvEnergy').textContent=money(evEnergyYear*years);
 $('tableGasMaint').textContent=money(gasMaintYear*years);$('tableEvMaint').textContent=money(evMaintYear*years);
 $('tableGasResale').textContent='− '+money(gasResale);$('tableEvResale').textContent='− '+money(evResale);
 $('tableGasTotal').textContent=money(gasTco);$('tableEvTotal').textContent=money(evTco);
 if(showToast){$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1800)}
}
const presets={city:{km:12000,years:5,publicShare:8},mixed:{km:18000,years:6,publicShare:18},intensive:{km:30000,years:7,publicShare:30}};
root.querySelectorAll('.preset').forEach(btn=>btn.addEventListener('click',()=>{root.querySelectorAll('.preset').forEach(x=>x.classList.remove('active'));btn.classList.add('active');Object.entries(presets[btn.dataset.preset]).forEach(([k,v])=>$(k).value=v);calculate(true)}));
ids.forEach(id=>$(id).addEventListener('input',()=>calculate()));
$('calculate').addEventListener('click',()=>calculate(true));
root.querySelectorAll('.faqQ').forEach(q=>q.addEventListener('click',()=>{const item=q.parentElement;item.classList.toggle('open');q.lastElementChild.textContent=item.classList.contains('open')?'−':'+'}));
$('searchBtn').addEventListener('click',()=>{const q=prompt('¿Qué querés calcular?');if(q)$('toast').textContent='Buscando “'+q+'”…',$('toast').classList.add('show'),setTimeout(()=>$('toast').classList.remove('show'),1800)});
$('themeBtn').addEventListener('click',()=>{document.body.style.filter=document.body.style.filter?'':'contrast(1.04)';$('toast').textContent='Contraste ajustado';$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1400)});
calculate();

})();
</script>
<style is:global>

