ht:-35px;top:-55px;opacity:.17}.mockup-electrico-nafta .road{position:absolute;left:0;right:0;bottom:0;height:92px;background:#0d172a;transform:skewY(-4deg);transform-origin:left}.mockup-electrico-nafta .car{position:absolute;bottom:82px;width:182px;height:60px;border-radius:38px 55px 13px 14px}.mockup-electrico-nafta .car:before{content:"";position:absolute;left:41px;top:-34px;width:91px;height:44px;border-radius:45px 45px 3px 3px;transform:skewX(-17deg)}.mockup-electrico-nafta .car:after{content:"";position:absolute;inset:auto 20px -14px;width:28px;height:28px;border:7px solid #ecf0f7;border-radius:50%;box-shadow:105px 0 0 -7px #152039,105px 0 0 0 #ecf0f7}.mockup-electrico-nafta .gasCar{left:37px;background:#f28e35}.mockup-electrico-nafta .gasCar:before{background:#ffbd75}.mockup-electrico-nafta .evCar{right:38px;bottom:143px;background:#3cc99a}.mockup-electrico-nafta .evCar:before{background:#8ce0c3}.mockup-electrico-nafta .bolt{position:absolute;right:92px;top:38px;font-size:43px;color:#bff9e6}.mockup-electrico-nafta .labels{position:absolute;left:28px;right:28px;bottom:22px;display:flex;justify-content:space-between;color:#d8e2f3;font-size:12px;font-weight:800}
.mockup-electrico-nafta .calcSection{padding:22px 0 74px}.mockup-electrico-nafta .calcShell{background:#fff;border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow);overflow:hidden}.mockup-electrico-nafta .calcHead{padding:27px 30px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.mockup-electrico-nafta .calcHead h2{font-size:25px;margin:0}.mockup-electrico-nafta .steps{font-size:13px;color:#69758b}.mockup-electrico-nafta .calcBody{display:grid;grid-template-columns:1.08fr .92fr}.mockup-electrico-nafta .formPane{padding:30px;border-right:1px solid var(--line)}.mockup-electrico-nafta .resultPane{padding:30px;background:#f8faff}.mockup-electrico-nafta .presetRow{display:flex;gap:8px;margin-bottom:28px}.mockup-electrico-nafta .preset{padding:9px 13px;border:1px solid var(--line);border-radius:10px;background:#fff;color:#566176;font-size:13px;font-weight:750}.mockup-electrico-nafta .preset.active{background:var(--ink);border-color:var(--ink);color:#fff}.mockup-electrico-nafta .sectionLabel{font-size:12px;font-weight:850;text-transform:uppercase;letter-spacing:.1em;color:#738096;margin:21px 0 12px}.mockup-electrico-nafta .grid2{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-electrico-nafta .field label{display:block;font-size:13px;font-weight:750;margin-bottom:7px;color:#445068}.mockup-electrico-nafta .inputWrap{position:relative}.mockup-electrico-nafta .inputWrap input{width:100%;border:1px solid #d7dce6;border-radius:11px;padding:13px 45px 13px 13px;background:#fff;color:var(--ink);font-weight:700;outline:none}.mockup-electrico-nafta .inputWrap input:focus{border-color:var(--blue);box-shadow:0 0 0 3px #e8efff}.mockup-electrico-nafta .unit{position:absolute;right:13px;top:14px;color:#7b8699;font-size:12px;font-weight:750}.mockup-electrico-nafta .calculate{width:100%;border:0;background:var(--blue);color:#fff;padding:15px;border-radius:12px;font-weight:850;margin-top:24px;box-shadow:0 9px 20px