.mockup-calculadora-cientifica .workspace{padding:16px 0 72px}.mockup-calculadora-cientifica .calcLayout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:18px}.mockup-calculadora-cientifica .calculator{background:#17233b;border-radius:27px;padding:22px;box-shadow:var(--shadow);border:1px solid #263550}.mockup-calculadora-cientifica .screen{background:linear-gradient(145deg,#f9fbff,#eef4fb);border-radius:18px;padding:19px 21px 17px;min-height:132px;display:flex;flex-direction:column;box-shadow:inset 0 0 0 1px #d7e0eb}.mockup-calculadora-cientifica .screenTop{display:flex;justify-content:space-between;color:#69778d;font-size:11px;font-weight:850;letter-spacing:.06em}.mockup-calculadora-cientifica .indicators{display:flex;gap:7px}.mockup-calculadora-cientifica .indicator{padding:4px 7px;border-radius:6px;background:#dce7f5}.mockup-calculadora-cientifica .indicator.on{background:#d8f4e9;color:#0c875d}.mockup-calculadora-cientifica .expression{margin-top:17px;text-align:right;min-height:28px;font-size:19px;color:#56647a;white-space:nowrap;overflow-x:auto}.mockup-calculadora-cientifica .result{text-align:right;font-size:40px;font-weight:850;letter-spacing:-.04em;margin-top:2px;overflow-x:auto;white-space:nowrap}.mockup-calculadora-cientifica .calcTools{display:grid;grid-template-columns:1fr auto;gap:10px;margin:15px 0 12px}.mockup-calculadora-cientifica .toggleGroup{display:flex;gap:7px}.mockup-calculadora-cientifica .modeBtn{border:1px solid #3a4964;background:#202e48;color:#cdd8e8;padding:9px 12px;border-radius:10px;font-size:12px;font-weight:800}.mockup-calculadora-cientifica .modeBtn.active{background:#edf3ff;color:#1c4da8;border-color:#edf3ff}.mockup-calculadora-cientifica .copyBtn{border:1px solid #3a4964;background:transparent;color:#c9d4e4;border-radius:10px;padding:9px 13px}.mockup-calculadora-cientifica .keyboard{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.mockup-calculadora-cientifica .key{min-height:48px;border:0;border-radius:11px;back