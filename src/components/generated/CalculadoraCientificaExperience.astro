<div class="mockup-calculadora-cientifica" set:html={`
<section class="hero"><div class="wrap"><div class="crumb"><span>Matemática</span> / Calculadora científica</div><div class="heroGrid"><div><div class="eyebrow">Gratis · precisa · sin instalar</div><h1>Todo el poder de una científica, sin complicarte.</h1><p>Trigonometría, logaritmos, raíces, potencias y memoria en una calculadora clara que funciona con botones o teclado.</p><div class="trust"><span class="pill">✓ Grados y radianes</span><span class="pill">✓ Historial privado</span><span class="pill">✓ Funciona en celular</span></div></div><aside class="heroTip"><b>También podés usar el teclado</b><p><span class="kbd">Enter</span> calcula · <span class="kbd">Esc</span> limpia · <span class="kbd">⌫</span> borra · <span class="kbd">^</span> potencia</p></aside></div></div></section>
<section class="workspace"><div class="wrap calcLayout"><div class="calculator"><div class="screen"><div class="screenTop"><div class="indicators"><span class="indicator" id="memoryFlag">M</span><span class="indicator on" id="angleFlag">DEG</span><span class="indicator" id="invFlag">INV</span></div><span>CIENTÍFICA</span></div><div class="expression" id="expression">2 × sin(45) + √(16)</div><div class="result" id="result">5,414213562</div></div><div class="calcTools"><div class="toggleGroup"><button class="modeBtn active" id="degBtn">DEG</button><button class="modeBtn" id="radBtn">RAD</button><button class="modeBtn" id="invBtn">INV</button></div><button class="copyBtn" id="copyBtn">⧉ Copiar resultado</button></div><div class="keyboard" id="keyboard">
<button class="key science" data-action="mc">MC</button><button class="key science" data-action="mr">MR</button><button class="key science" data-action="mplus">M+</button><button class="key science" data-value="(">(</button><button class="key science" data-value=")">)</button><button class="key danger" data-action="clear">AC</button>
<button class="key science invswap" data-fn="sin">sin</button><button class="key science invswap" data-fn="cos">cos</button><button class="key science invswap" data-fn="tan">tan</button><button class="key science" data-value="π">π</button><button class="key science" data-action="back">⌫</button><button class="key operator" data-value="÷">÷</button>
<button class="key science invswap" data-fn="ln">ln</button><button class="key science invswap" data-fn="log">log</button><button class="key science invswap" data-fn="sqrt">√</button><button class="key science" data-action="square">x²</button><button class="key science" data-value="^">xʸ</button><button class="key operator" data-value="×">×</button>
<button class="key science" data-fn="sinh">sinh</button><button class="key science" data-fn="cosh">cosh</button><button class="key science" data-fn="tanh">tanh</button><button class="key science" data-fn="abs">|x|</button><button class="key science" data-fn="log2">log₂</button><button class="key operator" data-value="−">−</button>
<button class="key science" data-action="ans">Ans</button><button class="key science invswap" data-value=" nCr ">nCr</button><button class="key number" data-value="7">7</button><button class="key number" data-value="8">8</button><button class="key number" data-value="9">9</button><button class="key equals" data-action="equals">=</button>
<button class="key science" data-action="factorial">n!</button><button class="key science" data-value="%">%</button><button class="key number" data-value="4">4</button><button class="key number" data-value="5">5</button><button class="key number" data-value="6">6</button>
<button class="key science" data-value="e">e</button><button class="key science" data-action="exp">EXP</button><button class="key number" data-value="1">1</button><button class="key number" data-value="2">2</button><button class="key number" data-value="3">3</button><button class="key operator" data-value="+">+</button>
<button class="key science" data-action="negate">±</button><button class="key number zero" data-value="0">0</button><button class="key number" data-value=".">.</button><button class="key operator" data-action="equals">=</button>
</div></div><aside class="history"><div class="historyHead"><h2>Historial</h2><button class="clearHistory" id="clearHistory">Limpiar</button></div><div class="historyList" id="historyList"></div><div class="privacy">🔒 Tus cuentas se procesan y guardan solamente en este navegador.</div></aside></div></section>
<section class="guide"><div class="wrap"><div class="center"><div class="eyebrow">Diseñada para estudiar y trabajar</div><h2>Encontrá todo a primera vista</h2><p>Las funciones están agrupadas como en una calculadora física.</p></div><div class="cards"><article class="card"><div class="icon">∿</div><h3>Trigonometría</h3><p>Seno, coseno y tangente en grados o radianes, incluyendo sus inversas.</p></article><article class="card"><div class="icon">log</div><h3>Logaritmos</h3><p>Logaritmo natural, base 10 y base 2, además de exponenciales.</p></article><article class="card"><div class="icon">x²</div><h3>Potencias y raíces</h3><p>Cuadrados, potencias libres, raíz cuadrada y cúbica usando INV.</p></article><article class="card"><div class="icon">M+</div><h3>Memoria e historial</h3><p>Guardá valores, recuperá respuestas y retomá cualquier cálculo anterior.</p></article></div></div></section>
<section class="examples"><div class="wrap exampleGrid"><div><div class="eyebrow">Probá con un ejemplo</div><h2>Una cuenta, un toque.</h2><p>Elegí un caso y la calculadora lo resuelve. Después podés modificar la expresión y seguir calculando.</p></div><div class="exampleList"><div class="example" data-example="2×sin(45)+√(16)"><code>2 × sin(45) + √(16)</code><strong>Trigonometría</strong></div><div class="example" data-example="log(1000)+ln(e)"><code>log(1000) + ln(e)</code><strong>Logaritmos</strong></div><div class="example" data-example="5!÷(2!×3!)"><code>5! ÷ (2! × 3!)</code><strong>Factoriales</strong></div><div class="example" data-example="2^10−24"><code>2¹⁰ − 24</code><strong>Potencias</strong></div></div></div></section>
<section class="faq"><div class="wrap"><div class="center"><div class="eyebrow">Preguntas frecuentes</div><h2>Usala con confianza</h2></div><div class="faqWrap"><div class="faqItem open"><button class="faqQ">¿Cuándo uso DEG y cuándo RAD?<span>−</span></button><div class="faqA">Usá grados para ejercicios escolares expresados en °. Elegí radianes en cálculo, física o programación cuando los ángulos estén expresados con π.</div></div><div class="faqItem"><button class="faqQ">¿Qué hace el botón INV?<span>+</span></button><div class="faqA">Cambia las funciones por sus inversas: sin pasa a sin⁻¹, ln a eˣ, log a 10ˣ, raíz cuadrada a raíz cúbica y nCr a nPr.</div></div><div class="faqItem"><button class="faqQ">¿Puedo usar el teclado de la computadora?<span>+</span></button><div class="faqA">Sí. Escribí números y operaciones directamente. Enter calcula, Backspace borra y Escape limpia la pantalla.</div></div></div></div></section>
<button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="search" hidden aria-hidden="true"></button><button type="button" id="contrast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-calculadora-cientifica')?document.currentScript.previousElementSibling:document.querySelector('.mockup-calculadora-cientifica');if(!root)return;

const $=id=>root.querySelector("#"+id);let expr='2×sin(45)+√(16)',answer=5.414213562,memory=0,angle='DEG',inverse=false,history=[];
const pretty=n=>{if(!Number.isFinite(n))throw Error('Resultado no definido');return Number(n.toPrecision(12)).toLocaleString('es-AR',{maximumFractionDigits:12})};
const factorial=n=>{if(n<0||n%1)throw Error('El factorial requiere un entero positivo');if(n>170)throw Error('Número demasiado grande');let r=1;for(let i=2;i<=n;i++)r*=i;return r};
const comb=(n,r)=>factorial(n)/(factorial(r)*factorial(n-r)),perm=(n,r)=>factorial(n)/factorial(n-r);
function compute(raw){
 let s=raw.replaceAll('×','*').replaceAll('÷','/').replaceAll('−','-').replaceAll('π','PI').replaceAll('√','sqrt').replace(/\bEXP\b/g,'*10^').replace(/\be\b/g,'E');
 const trig=x=>angle==='DEG'?x*Math.PI/180:x,invTrig=x=>angle==='DEG'?x*180/Math.PI:x;
 const scope={PI:Math.PI,E:Math.E,sin:x=>Math.sin(trig(x)),cos:x=>Math.cos(trig(x)),tan:x=>Math.tan(trig(x)),asin:x=>invTrig(Math.asin(x)),acos:x=>invTrig(Math.acos(x)),atan:x=>invTrig(Math.atan(x)),sinh:Math.sinh,cosh:Math.cosh,tanh:Math.tanh,ln:Math.log,log:Math.log10,log2:Math.log2,sqrt:Math.sqrt,cbrt:Math.cbrt,abs:Math.abs,exp:Math.exp,pow10:x=>10**x,factorial,comb,perm};
 const tokens=s.match(/\d+(?:\.\d+)?(?:e[+\-]?\d+)?|[A-Za-z][A-Za-z0-9]*|[()+\-*/^!,%]/g)||[];
 if(tokens.join('').toLowerCase()!==s.replace(/\s+/g,'').toLowerCase())throw Error('Expresión no válida');
 let pos=0,peek=()=>tokens[pos],take=t=>peek()===t?(pos++,true):false;
 const primary=()=>{const t=peek();if(t===undefined)throw Error('Falta completar la cuenta');if(take('(')){const v=sum();if(!take(')'))throw Error('Falta cerrar un paréntesis');return v}if(/^\d/.test(t)){pos++;return Number(t)}if(/^[A-Za-z]/.test(t)){pos++;if(Object.hasOwn(scope,t)&&typeof scope[t]==='number')return scope[t];const fn=scope[t];if(typeof fn!=='function'||!take('('))throw Error('Función no válida');const args=[sum()];while(take(','))args.push(sum());if(!take(')'))throw Error('Falta cerrar un paréntesis');return fn(...args)}throw Error('Expresión no válida')};
 const postfix=()=>{let v=primary();while(true){if(take('!'))v=factorial(v);else if(take('%'))v/=100;else break}return v};
 const unary=()=>take('+')?unary():take('-')?-unary():postfix();
 const power=()=>{const left=unary();return take('^')?left**power():left};
 const product=()=>{let v=power();while(true){if(take('*'))v*=power();else if(take('/')){const d=power();if(d===0)throw Error('No se puede dividir por cero');v/=d}else if(take('nCr'))v=comb(v,power());else if(take('nPr'))v=perm(v,power());else break}return v};
 const sum=()=>{let v=product();while(true){if(take('+'))v+=product();else if(take('-'))v-=product();else break}return v};
 const value=sum();if(pos!==tokens.length)throw Error('Expresión no válida');if(!Number.isFinite(value))throw Error('Resultado no definido');return value;
}
function render(){ $('expression').textContent=expr||'0';$('result').textContent=expr?(()=>{try{return pretty(answer)}catch{return '—'}})():'0';$('memoryFlag').classList.toggle('on',memory!==0);$('angleFlag').textContent=angle;$('invFlag').classList.toggle('on',inverse)}
function evaluate(add=true){try{answer=compute(expr);if(add){history.unshift({e:expr,r:pretty(answer)});history=history.slice(0,12);renderHistory()}render()}catch(e){$('result').textContent=e.message;$('toast').textContent='Revisá la expresión';showToast()}}
function append(v){expr=(expr==='0'?'':expr)+v;try{answer=compute(expr)}catch{}render()}
function fn(name){let f=name;if(inverse){f={sin:'asin',cos:'acos',tan:'atan',ln:'exp',log:'pow10',sqrt:'cbrt'}[name]||name;inverse=false;syncInv()}append(f+'(')}
function syncInv(){$('invBtn').classList.toggle('active',inverse);$('invFlag').classList.toggle('on',inverse);const map=inverse?{sin:'sin⁻¹',cos:'cos⁻¹',tan:'tan⁻¹',ln:'eˣ',log:'10ˣ',sqrt:'∛'}:{sin:'sin',cos:'cos',tan:'tan',ln:'ln',log:'log',sqrt:'√'};root.querySelectorAll('[data-fn]').forEach(b=>{if(map[b.dataset.fn])b.textContent=map[b.dataset.fn]});root.querySelector('[data-value=" nCr "]').textContent=inverse?'nPr':'nCr'}
function renderHistory(){const list=$('historyList');list.innerHTML=history.length?'':'<div class="historyEmpty">Todavía no hay cuentas.<br>Tu historial aparecerá acá.</div>';history.forEach(h=>{const d=document.createElement('div');d.className='historyItem';d.innerHTML='<div class="historyExpr">'+h.e+'</div><div class="historyRes">= '+h.r+'</div>';d.onclick=()=>{expr=h.e;evaluate(false)};list.appendChild(d)})}
function showToast(){ $('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1500)}
$('keyboard').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.value){let v=b.dataset.value;if(v.includes('nCr')&&inverse){v=' nPr ';inverse=false;syncInv()}append(v)}else if(b.dataset.fn)fn(b.dataset.fn);else{const a=b.dataset.action;if(a==='clear'){expr='';answer=0}else if(a==='back')expr=expr.slice(0,-1);else if(a==='equals'){evaluate();return}else if(a==='square')append('^2');else if(a==='factorial')append('!');else if(a==='exp')append('EXP');else if(a==='negate')expr=expr.startsWith('−')?expr.slice(1):'−'+expr;else if(a==='ans')append(String(answer));else if(a==='mc')memory=0;else if(a==='mr')append(String(memory));else if(a==='mplus')memory+=Number(answer)||0;render()}});
$('degBtn').onclick=()=>{angle='DEG';$('degBtn').classList.add('active');$('radBtn').classList.remove('active');evaluate(false)};$('radBtn').onclick=()=>{angle='RAD';$('radBtn').classList.add('active');$('degBtn').classList.remove('active');evaluate(false)};$('invBtn').onclick=()=>{inverse=!inverse;syncInv()};
$('clearHistory').onclick=()=>{history=[];renderHistory()};$('copyBtn').onclick=async()=>{try{await navigator.clipboard.writeText(String(answer))}catch{}$('toast').textContent='Resultado copiado';showToast()};
root.querySelectorAll('.example').forEach(x=>x.onclick=()=>{expr=x.dataset.example;evaluate();root.querySelector('.workspace').scrollIntoView({behavior:'smooth'})});
root.querySelectorAll('.faqQ').forEach(q=>q.onclick=()=>{q.parentElement.classList.toggle('open');q.lastElementChild.textContent=q.parentElement.classList.contains('open')?'−':'+'});
document.addEventListener('keydown',e=>{if(/[0-9+\-*/().%^!]/.test(e.key)&&e.key.length===1)append({'*':'×','/':'÷','-':'−'}[e.key]||e.key);else if(e.key==='Enter')evaluate();else if(e.key==='Backspace'){expr=expr.slice(0,-1);render()}else if(e.key==='Escape'){expr='';answer=0;render()}});
$('search').onclick=()=>{const q=prompt('¿Qué querés calcular?');if(q){$('toast').textContent='Buscando “'+q+'”…';showToast()}};$('contrast').onclick=()=>{document.body.style.filter=document.body.style.filter?'':'contrast(1.05)';$('toast').textContent='Contraste ajustado';showToast()};
renderHistory();evaluate(false);

})();
</script>
<style is:global>

.mockup-calculadora-cientifica{--ink:#121a30;--muted:#657086;--blue:#2868f6;--blue2:#edf3ff;--violet:#7357e8;--cream:#f6f7f3;--line:#dfe3ea;--card:#fff;--green:#14a977;--shadow:0 22px 65px rgba(29,42,77,.1)}
