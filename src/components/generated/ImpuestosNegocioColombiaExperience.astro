---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-impuestos-negocio-colombia" set:html={`<section class="hero"><div class="wrap crumb"><b>Colombia</b> &nbsp;/&nbsp; Impuestos &nbsp;/&nbsp; Mi negocio</div><div class="wrap hero-grid">
<div class="copy"><span class="eyebrow">DIAN + impuesto municipal</span><h1>Entendé cuánto<br>debe reservar tu<br>negocio.</h1><p>Calculá IVA, ICA, Régimen SIMPLE o renta de sociedad en un solo tablero. Mirá quién cobra cada impuesto y cuándo prepararlo.</p><div class="chips"><span>🧾 IVA 19%</span><span>🏛️ ICA municipal</span><span>✓ Reserva mensual</span></div><div class="car-art"><div class="road"></div><div style="position:absolute;left:75px;bottom:45px;width:245px;height:170px;background:#fff;border:1px solid #d8e4eb;clip-path:polygon(15% 18%,85% 18%,100% 100%,0 100%);box-shadow:0 20px 35px #17385818"></div><div style="position:absolute;left:105px;bottom:75px;width:185px;height:18px;background:#75cbb9;box-shadow:0 -35px 0 #75cbb9,0 -70px 0 #75cbb9"></div><div class="fuel-card"><small>CARGA TRIBUTARIA ESTIMADA</small><strong id="art-value">$37.044.000</strong><span id="art-place">Ordinario · IVA + ICA</span></div></div></div>
<form class="calc"><div class="calc-title"><div><h2>Calculá tus impuestos</h2><p>Elegí cómo está inscrito el negocio.</p></div><span class="tag">UVT 2026 · $52.374</span></div><div class="section-label">¿Qué querés revisar?</div><div class="cases"><button type="button" class="case active" data-mode="overview"><i>📊</i>Panorama total</button><button type="button" class="case" data-mode="ordinary"><i>🧾</i>Régimen ordinario</button><button type="button" class="case" data-mode="simple"><i>⚡</i>Régimen SIMPLE</button><button type="button" class="case" data-mode="company"><i>🏢</i>Sociedad</button></div><div class="section-label">Cifras anuales del negocio</div><div class="fields"><div class="field wide"><label>Ingresos brutos sin IVA</label><div class="inline"><b>$</b><input id="sales" type="number" value="300000000"></div></div><div class="field"><label>Compras gravadas sin IVA</label><div class="inline"><b>$</b><input id="purchases" type="number" value="150000000"></div></div><div class="field"><label>Ventas gravadas con IVA</label><div class="inline"><input id="taxed" type="number" min="0" max="100" value="100"><b>%</b></div></div><div class="field"><label>Tarifa ICA</label><div class="inline"><input id="ica-rate" type="number" step=".01" value="8.48"><b>‰</b></div></div><div class="field"><label>Utilidad fiscal</label><div class="inline"><b>$</b><input id="profit" type="number" value="60000000"></div></div></div><div class="advanced"><span id="formula-note">IVA neto + ICA + renta estimada</span><button type="button" id="advanced-toggle">+ Ajustar SIMPLE</button></div><div class="extra" id="extra-fields"><div class="field"><label>Tarifa Régimen SIMPLE</label><div class="inline"><input id="simple-rate" type="number" step=".1" value="3.4"><b>%</b></div></div><div class="field"><label>Retenciones ya practicadas</label><div class="inline"><b>$</b><input id="withheld" type="number" value="0"></div></div></div><section class="result"><div class="result-top"><div><small id="result-label">Carga tributaria estimada</small><div class="value" id="result-value">$37.044.000</div></div><div class="verdict"><small>Régimen</small><strong id="verdict">Ordinario</strong></div></div><div class="stats"><span>Para la DIAN<b id="s1">$34.500.000</b></span><span>Para el municipio<b id="s2">$2.544.000</b></span><span>Reserva mensual<b id="s3">$3.087.000</b></span></div><button class="go" id="update" type="button">Actualizar impuestos</button></section></form></div></section>
<section class="scale-section"><div class="wrap"><header class="center"><span>Tu carga en contexto</span><h2>¿Qué porcentaje de tus ingresos representa?</h2><p>El marcador compara la carga tributaria estimada contra la facturación anual.</p></header><div class="scale-card"><div class="meter"><i class="pin" id="pin" data-value="12,3%"></i></div><div class="meter-labels"><div><b>Menor carga</b>Hasta 5%</div><div><b>Carga media</b>5% a 15%</div><div><b>Carga alta</b>Más de 15%</div></div><div class="meter-summary"><span id="scale-copy">IVA neto, ICA y renta no usan la misma base.</span><b id="scale-result">12,3% de los ingresos</b></div></div></div></section>
<section class="breakdown"><div class="wrap break-grid"><article class="card"><h3>Impuesto por impuesto</h3><div class="line"><span>IVA generado</span><b id="d1">$57.000.000</b></div><div class="line"><span>IVA descontable</span><b id="d2">− $28.500.000</b></div><div class="line"><span>ICA municipal</span><b id="d3">$2.544.000</b></div><div class="line"><span id="d4l">Renta / SIMPLE</span><b id="d4">$6.000.000</b></div><div class="line total"><strong>Total estimado</strong><b id="df">$37.044.000</b></div></article><article class="card"><h3>Quién cobra qué</h3><div class="step"><i>D</i><div><b>DIAN</b><span>IVA, renta o anticipos del Régimen SIMPLE.</span></div></div><div class="step"><i>M</i><div><b>Municipio</b><span>ICA según actividad y jurisdicción.</span></div></div><div class="step"><i>R</i><div><b>Tu reserva</b><span>Separá el dinero cobrado antes de gastarlo.</span></div></div><div class="warning">⚠️ Es una estimación educativa. Tarifas, periodicidad, costos aceptados, saldos y retenciones deben validarse con RUT, municipio y contador.</div></article></div></section>
<section class="tips"><div class="wrap"><header class="center"><span>Cuatro conceptos clave</span><h2>No todos los impuestos salen del mismo lugar</h2></header><div class="tip-grid"><article class="tip"><i>🧾</i><h3>IVA</h3><p>Cobrás en ventas y descontás el pagado en compras.</p><span class="impact">DIAN</span></article><article class="tip"><i>🏛️</i><h3>ICA</h3><p>Se calcula sobre ingresos y cambia por municipio.</p><span class="impact">Municipal</span></article><article class="tip"><i>⚡</i><h3>SIMPLE</h3><p>Tarifa sobre ingresos brutos según grupo y UVT.</p><span class="impact">Unificado</span></article><article class="tip"><i>🏢</i><h3>Renta sociedad</h3><p>La referencia general es 35% sobre utilidad fiscal.</p><span class="impact">Sobre utilidad</span></article></div></div></section>
<section class="dark"><div class="wrap dark-grid"><div><span class="eyebrow" style="color:#8fd9c6">Separá antes de gastar</span><h2>El IVA cobrado nunca fue ingreso del negocio.</h2><p>Crear una reserva tributaria mensual evita usar dinero que después hay que girar a la DIAN o al municipio.</p></div><div class="compare"><div><small>IVA NETO</small><b id="cmp1">$28.500.000</b><span>Ventas menos compras</span></div><div><small>ICA</small><b id="cmp2">$2.544.000</b><span>Según municipio</span></div><div><small>RENTA / SIMPLE</small><b id="cmp3">$6.000.000</b><span>Según régimen</span></div></div></div></section><div class="foot"></div><button type="button" id="date-result" hidden aria-hidden="true"></button><button type="button" id="progress-result" hidden aria-hidden="true"></button><button type="button" id="fund-result" hidden aria-hidden="true"></button><button type="button" id="art-consumption" hidden aria-hidden="true"></button><button type="button" id="art-cost" hidden aria-hidden="true"></button><button type="button" id="scale-verdict" hidden aria-hidden="true"></button><button type="button" id="detail-last" hidden aria-hidden="true"></button><button type="button" id="detail-interval" hidden aria-hidden="true"></button><button type="button" id="detail-used" hidden aria-hidden="true"></button><button type="button" id="detail-next" hidden aria-hidden="true"></button><button type="button" id="detail-left" hidden aria-hidden="true"></button><button type="button" id="cmp-low" hidden aria-hidden="true"></button><button type="button" id="cmp-current" hidden aria-hidden="true"></button><button type="button" id="cmp-high" hidden aria-hidden="true"></button><button type="button" id="cmp-current-cost" hidden aria-hidden="true"></button><button type="button" id="province" hidden aria-hidden="true"></button><button type="button" id="rate" hidden aria-hidden="true"></button><button type="button" id="quota-value" hidden aria-hidden="true"></button><button type="button" id="cash-value" hidden aria-hidden="true"></button><button type="button" id="month-value" hidden aria-hidden="true"></button><button type="button" id="d-valuation" hidden aria-hidden="true"></button><button type="button" id="d-rate" hidden aria-hidden="true"></button><button type="button" id="d-year" hidden aria-hidden="true"></button><button type="button" id="d-discount" hidden aria-hidden="true"></button><button type="button" id="d-final" hidden aria-hidden="true"></button><button type="button" id="cmp-name" hidden aria-hidden="true"></button><button type="button" id="digits" hidden aria-hidden="true"></button><button type="button" id="d1l" hidden aria-hidden="true"></button><button type="button" id="d2l" hidden aria-hidden="true"></button><button type="button" id="d3l" hidden aria-hidden="true"></button><button type="button" id="df-label" hidden aria-hidden="true"></button><button type="button" id="pre2" hidden aria-hidden="true"></button><button type="button" id="pre3" hidden aria-hidden="true"></button><button type="button" id="cl-search" hidden aria-hidden="true"></button><button type="button" id="no-results" hidden aria-hidden="true"></button><button type="button" id="cl-search-btn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-impuestos-negocio-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-impuestos-negocio-colombia');


let taxMode="overview";const t$=s=>root.querySelector(s),tn=id=>Math.max(0,Number(t$(id).value)||0),tm=x=>"$"+new Intl.NumberFormat("es-CO",{maximumFractionDigits:0}).format(x);function taxCalc(){let sales=tn("#sales"),purchases=tn("#purchases"),taxed=tn("#taxed")/100,ica=sales*tn("#ica-rate")/1000,ivaOut=sales*taxed*.19,ivaIn=purchases*taxed*.19,iva=Math.max(0,ivaOut-ivaIn),profit=tn("#profit"),simple=sales*tn("#simple-rate")/100,withheld=tn("#withheld"),income=profit*.35,third,regime;if(taxMode==="simple"){third=simple;regime="Régimen SIMPLE"}else if(taxMode==="company"){third=income;regime="Sociedad · renta 35%"}else{third=taxMode==="ordinary"?0:profit*.10;regime=taxMode==="ordinary"?"Ordinario · IVA + ICA":"Panorama estimado"}let dian=Math.max(0,iva+third-withheld),total=dian+ica,burden=sales?total/sales*100:0;t$("#result-label").textContent=taxMode==="ordinary"?"IVA + ICA estimados":taxMode==="simple"?"Carga en Régimen SIMPLE":taxMode==="company"?"Carga tributaria de la sociedad":"Carga tributaria estimada";t$("#result-value").textContent=tm(total);t$("#verdict").textContent=regime;t$("#s1").textContent=tm(dian);t$("#s2").textContent=tm(ica);t$("#s3").textContent=tm(total/12);t$("#art-value").textContent=tm(total);t$("#art-place").textContent=regime;t$("#pin").style.left=Math.max(3,Math.min(97,burden/25*100))+"%";t$("#pin").dataset.value=burden.toFixed(1).replace(".",",")+"%";t$("#scale-result").textContent=burden.toFixed(1).replace(".",",")+"% de los ingresos";t$("#d1").textContent=tm(ivaOut);t$("#d2").textContent="− "+tm(ivaIn);t$("#d3").textContent=tm(ica);t$("#d4").textContent=tm(third);t$("#df").textContent=tm(total);t$("#cmp1").textContent=tm(iva);t$("#cmp2").textContent=tm(ica);t$("#cmp3").textContent=tm(third)}
root.querySelectorAll(".case").forEach(x=>x.addEventListener("click",()=>{root.querySelectorAll(".case").forEach(y=>y.classList.remove("active"));x.classList.add("active");taxMode=x.dataset.mode;taxCalc()}));root.querySelectorAll("input").forEach(x=>x.addEventListener("input",taxCalc));t$("#advanced-toggle").addEventListener("click",e=>{t$("#extra-fields").classList.toggle("open");e.currentTarget.textContent=t$("#extra-fields").classList.contains("open")?"− Ocultar ajustes":"+ Ajustar SIMPLE"});t$("#update").addEventListener("click",e=>{e.preventDefault();taxCalc();e.currentTarget.textContent="✓ Impuestos actualizados";setTimeout(()=>e.currentTarget.textContent="Actualizar impuestos",1200)});root.querySelector("form").addEventListener("submit",e=>e.preventDefault());taxCalc();

})();
</script>
