---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-planetas-viaje" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Ciencia / Planetas y viaje espacial</div><div class="eyebrow">Planificador interplanetario</div><h1>¿Cuánto tardaríamos en llegar?</h1><p class="lead">Elegí destino, velocidad y ventana. Compará distancias, tiempo de viaje y demora de comunicación.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art orbit"><i class="sun"></i><i class="planet p1"></i><i class="planet p2"></i><i class="planet p3"></i><span class="ship">›</span></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">misión interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="planet">Destino</label><select id="planet"><option value="moon">Luna</option><option value="mars">Marte</option><option value="jupiter">Júpiter</option><option value="saturn">Saturno</option></select></div><div class="field"><label for="speed">Velocidad media (km/s)</label><input id="speed" type="number" value="25" min="1" max="100" step="1"></div><div class="field"><label for="stay">Días de permanencia</label><input id="stay" type="number" value="30" min="0" max="1000" step="1"></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-planetas-viaje')?document.currentScript.previousElementSibling:document.querySelector('.mockup-planetas-viaje');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const data={moon:["Luna",384400],mars:["Marte",225000000],jupiter:["Júpiter",778000000],saturn:["Saturno",1430000000]},d=data[v("planet")],s=Math.max(1,vn("speed")),days=d[1]/s/86400,signal=d[1]/299792.458/60;return {big:(days<2?days.toFixed(1):Math.round(days).toLocaleString("es-AR"))+" días",label:"Tiempo de viaje idealizado",badge:"Misión a "+d[0],metrics:[["Distancia media",(d[1]/1e6).toFixed(1)+" M km"],["Señal de radio",signal<60?signal.toFixed(1)+" min":(signal/60).toFixed(1)+" h"],["Misión total",Math.round(days*2+vn("stay"))+" días"]],position:Math.min(100,Math.log10(d[1])/10*100),note:"Es una comparación idealizada a velocidad constante. Las misiones reales usan órbitas de transferencia, ventanas de lanzamiento y maniobras."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"planet":"moon","speed":"25","stay":"30"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
<style is:global>

.mockup-planetas-viaje{--blue:#174b7a;--accent:#5678b8;--soft:#edf2fb;--ink:#172331;--muted:#5e6977;--line:#d9e2e5;--paper:#f5f7f6;--cream:#fff8e2;--mint:#d9eee6}.mockup-planetas-viaje *{box-sizing:border-box}.mockup-planetas-viaje{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fff}.mockup-planetas-viaje button,.mockup-planetas-viaje input,.mockup-planetas-viaje select{font:inherit}.mockup-planetas-viaje .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:27px;border-bottom:1px solid var(--line)}.mockup-planetas-viaje .brand{font-weight:950;font-size:19px}.mockup-planetas-viaje .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-planetas-viaje .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-planetas-viaje .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-planetas-viaje .hero{padding:50px 22px 45px;background:linear-gradient(118deg,#fbfcfa 0 61%,var(--soft) 61%)}.mockup-planetas-viaje .hero-grid,.mockup-planetas-viaje .wrap{max-width:1180px;margin:auto}.mockup-planetas-viaje .hero-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:57px;align-items:center}.mockup-planetas-viaje .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-planetas-viaje .eyebrow{margin-top:27px;color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-planetas-viaje .hero h1{font-size:clamp(43px,5vw,67px);line-height:.98;letter-spacing:-.05em;margin:10px 0 19px}.mockup-planetas-viaje .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-planetas-viaje .pills{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-planetas-viaje .pills span{padding:8px 12px;border:1px solid var(--line);border-radius:99px;background:#fff;font-size:13px;font-weight:800