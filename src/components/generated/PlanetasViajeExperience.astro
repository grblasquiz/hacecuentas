h:215px;height:215px;border-radius:50%;border:18px solid var(--blue);display:grid;place-items:center;position:relative}.mockup-planetas-viaje .dial i{position:absolute;width:7px;height:75px;background:var(--accent);bottom:50%;transform-origin:bottom;transform:rotate(35deg)}.mockup-planetas-viaje .dial b{font-size:52px;margin-top:30px}.mockup-planetas-viaje .dial small{position:absolute;bottom:38px}.mockup-planetas-viaje .clockface{width:210px;height:210px;border:12px solid var(--blue);border-radius:50%;position:relative}.mockup-planetas-viaje .clockface i,.mockup-planetas-viaje .clockface b{position:absolute;left:50%;bottom:50%;width:7px;background:var(--accent);transform-origin:bottom}.mockup-planetas-viaje .clockface i{height:72px;transform:rotate(90deg)}.mockup-planetas-viaje .clockface b{height:55px;transform:rotate(10deg)}.mockup-planetas-viaje .clock>span{position:absolute;bottom:24px;font-size:23px;font-weight:950}.mockup-planetas-viaje .drop i{width:150px;height:190px;background:var(--accent);border-radius:70% 30% 70% 30%;transform:rotate(45deg)}.mockup-planetas-viaje .drop span{position:absolute;color:#fff;font-size:32px;font-weight:950}.mockup-planetas-viaje .bubble{position:absolute;padding:18px 24px;border-radius:24px;background:var(--soft);border:2px solid var(--accent);font-weight:950;font-size:23px}.mockup-planetas-viaje .bubble.a{left:9%;top:20%}.mockup-planetas-viaje .bubble.b{right:9%;top:34%}.mockup-planetas-viaje .bubble.c{left:28%;bottom:16%}.mockup-planetas-viaje .pages{width:240px;height:175px;display:flex;perspective:500px}.mockup-planetas-viaje .pages i{width:50%;background:#fff;border:6px solid var(--blue)}.mockup-planetas-viaje .pages i:first-child{transform:rotateY(14deg)}.mockup-planetas-viaje .pages i:last-child{transform:rotateY(-14deg)}.mockup-planetas-viaje .book>span{position:absolute;bottom:27px;font-weight:950;color:var(--accent)}.mockup-planetas-viaje .sheet{width:180px;height:230px;border:5px solid var(--blue);background:#fff;border-radius:12px;padding:25px}.mockup-planetas-viaje .sheet b{font-size:55px;color:var(--accent)}.mockup-planetas-viaje .sheet i{display:block;border-top:6px solid #cbd7db;margin-top:17px}.mockup-planetas-viaje .timer{position:absolute;right:22px;bottom:24px;padding:12px;background:var(--blue);color:#fff;border-radius:10px;font-weight:950}.mockup-planetas-viaje .target{width:220px;height:220px;border:24px solid var(--accent);border-radius:50%;box-shadow:inset 0 0 0 26px #fff,inset 0 0 0 48px var(--blue);display:grid;place-items:center}.mockup-planetas-viaje .target b{font-size:44px;background:#fff;border-radius:50%;padding:18px}.mockup-planetas-viaje .parrilla{width:245px;height:160px;border:10px solid var(--blue);border-radius:18px;display:flex;gap:12px;padding:28px}.mockup-planetas-viaje .parrilla i{flex:1;border-radius:30px;background:var(--accent)}.mockup-planetas-viaje .fire{position:absolute;bottom:12px;font-size:60px;color:#e78a35}.mockup-planetas-viaje .timeline .line{position:absolute;left:12%;right:12%;top:50%;height:8px;background:var(--blue);display:flex;justify-content:space-between}.mockup-planetas-viaje .timeline .line i{width:29px;height:29px;border:7px solid var(--blue);background:#fff;border-radius:50%;transform:translateY(-11px)}.mockup-planetas-viaje .truck{position:absolute;left:30%;top:38%;font-size:50px;color:var(--accent)}.mockup-planetas-viaje .donut{width:220px;height:220px;border-radius:50%;background:conic-gradient(var(--accent) 0 40%,#e7af53 40% 65%,#4d98a1 65% 80%,#dce4e4 80%);position:relative}.mockup-planetas-viaje .donut:after{content:"";position:absolute;inset:55px;background:#fff;border-radius:50%}.mockup-planetas-viaje .budget>span{position:absolute;font-size:50px;font-weight:950;color:var(--blue)}
.mockup-planetas-viaje .tool{padding:62px 22px}.mockup-planetas-viaje .tool-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.mockup-planetas-viaje .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-planetas-viaje .tool h2,.mockup-planetas-viaje .guide h2{font-size:37px;letter-spacing:-.04em;margin:7px 0}.mockup-planetas-viaje .tool-head p{max-width:510px;color:var(--muted);margin:0}.mockup-planetas-viaje .workspace{display:grid;grid-template-columns:1.05fr .95fr;gap:20px}.mockup-planetas-viaje .panel{border-radius:24px;padding:27px}.mockup-planetas-viaje .form{border:1px solid var(--line);box-shadow:0 16px 40px #18374a0c}.mockup-planetas-viaje .panel h3{font-size:21px;margin:0 0 5px}.mockup-planetas-viaje .hint{color:var(--muted);font-size:14px;margin:0 0 20px}.mockup-planetas-viaje .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-planetas-viaje .field{margin-bottom:2px}.mockup-planetas-viaje .field label{display:flex;justify-content:space-between;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-planetas-viaje .field output{color:var(--accent)}.mockup-planetas-viaje input,.mockup-planetas-viaje select{width:100%;min-height:49px;border:1px solid #ccd7da;border-radius:12px;background:#fff;padding:12px 14px;color:var(--ink)}.mockup-planetas-viaje input[type=range]{padding:0;accent-color:var(--accent)}.mockup-planetas-viaje .actions{display:flex;gap:9px;margin-top:21px}.mockup-planetas-viaje .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:14px;font-weight:900;cursor:pointer}.mockup-planetas-viaje .reset{border:1px solid #d7aa58;border-radius:12px;background:#fff;color:#654a1f;padding:13px 16px;font-weight:850;cursor:pointer}.mockup-planetas-viaje .result{background:linear-gradient(145deg,var(--blue),color-mix(in srgb,var(--blue),var(--accent) 35%));color:#fff;position:relative;overflow:hidden}.mockup-planetas-viaje .badge{display:inline-block;padding:7px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:950}.mockup-planetas-viaje .big{font-size:48px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:14px 0 5px}.mockup-planetas-viaje .caption{color:#dceaf0;font-size:14px}.mockup-planetas-viaje .meter{height:13px;border-radius:99px;background:#ffffff2d;margin:24px 0;position:relative}.mockup-planetas-viaje .meter i{position:absolute;left:var(--position);top:50%;width:24px;height:24px;border:5px solid #fff;background:var(--accent);border-radius:50%;transform:translate(-50%,-50%);transition:.25s}.mockup-planetas-viaje .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.mockup-planetas-viaje .metric{padding:13px;border:1px solid #ffffff2b;background:#ffffff0e;border-radius:13px}.mockup-planetas-viaje .metric small{display:block;color:#dceaf0;font-size:10px}.mockup-planetas-viaje .metric b{font-size:16px}.mockup-planetas-viaje .note{margin-top:17px;padding:14px 15px;border-radius:12px;background:var(--cream);color:#58461f;font-size:13px}.mockup-planetas-viaje .guide{padding:65px 22px;background:var(--paper)}.mockup-planetas-viaje .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px}.mockup-planetas-viaje .guide p{color:var(--muted)}.mockup-planetas-viaje .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.mockup-planetas-viaje .step{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff}.mockup-planetas-viaje .step b{display:block;color:var(--accent);margin-bottom:5px}.mockup-planetas-viaje .step span{font-size:14px;color:var(--muted)}.mockup-planetas-viaje .foot{padding:30px;text-align:center;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-planetas-viaje .nav{display:none}.mockup-planetas-viaje .hero-grid,.mockup-planetas-viaje .workspace,.mockup-planetas-viaje .guide-grid{grid-template-columns:1fr}.mockup-planetas-viaje .tool-head{flex-direction:column;align-items:start}}@media(max-width:550px){.mockup-planetas-viaje .fields,.mockup-planetas-viaje .metrics,.mockup-planetas-viaje .steps{grid-template-columns:1fr}.mockup-planetas-viaje .hero h1{font-size:43px}.mockup-planetas-viaje .actions{flex-direction:column}.mockup-planetas-viaje .art{height:290px}}

.mockup-planetas-viaje { width:100%; overflow:hidden; }
.mockup-planetas-viaje .top, .mockup-planetas-viaje header.top { display:none !important; }
.mockup-planetas-viaje .foot { display:none !important; }
.mockup-planetas-viaje .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-planetas-viaje .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-planetas-viaje .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-planetas-viaje .support-real summary { cursor:pointer; font-weight:750; }
.mockup-planetas-viaje .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-planetas-viaje :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-planetas-viaje input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-planetas-viaje input[type="number"]::-webkit-inner-spin-button, .mockup-planetas-viaje input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-planetas-viaje .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-planetas-viaje support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
