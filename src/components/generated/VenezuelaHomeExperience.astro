---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-venezuela-home" set:html={`<section class="hero"><div class="wrap"><div class="crumb">Hacé Cuentas / Venezuela</div><div class="hero-grid"><div><span class="eyebrow">Venezuela · datos locales 2026</span><h1>Tus cuentas en bolívares, sin perder de vista el dólar.</h1><p class="lead">Sueldo, prestaciones, dólar BCV y paralelo, ISLR, IVA e IGTF. Herramientas claras con reglas venezolanas.</p><div class="search"><input id="search" placeholder="¿Qué necesitás calcular?"><button id="searchBtn">Buscar</button></div></div><div class="flag-art"><div class="flag"><span class="stars">★★★★★★★★</span></div><div class="fx"><small>DÓLAR BCV DE REFERENCIA</small><strong>Bs. 125,32</strong></div></div></div></div></section>
<section class="quick wrap"><div class="quick-grid"><div class="form"><h2>¿Cuánto valen tus bolívares?</h2><p>Compará al instante la conversión oficial y la de mercado.</p><div class="fields"><div class="field"><label>Monto en bolívares</label><input id="ves" type="number" value="10000"></div><div class="field"><label>Tasa paralela</label><input id="parallel" type="number" value="165.30" step=".01"></div><button class="primary" id="convert">Convertir</button></div></div><div class="result"><small>VALOR AL DÓLAR PARALELO</small><strong id="usd">USD 60,50</strong><span id="gap">A tasa BCV serían USD 79,80 · brecha 31,9%</span></div></div></section>
<section class="main"><div class="wrap"><div class="head"><div><span class="eyebrow">Más usadas en Venezuela</span><h2>Empezá por la cuenta que necesitás.</h2></div><p>Filtrá por tema. Todas las herramientas usan bolívares y normativa local.</p></div><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="trabajo">Trabajo</button><button class="filter" data-filter="finanzas">Dólar y finanzas</button><button class="filter" data-filter="impuestos">Impuestos</button><button class="filter" data-filter="vida">Vida cotidiana</button></div><div class="cards">
<article class="card" data-cat="finanzas"><i>$</i><h3>Dólar BCV y paralelo</h3><p>Convertí bolívares, dólares, euros y USDT.</p><button data-page="Dólar y bolívares">Calcular ahora →</button></article>
<article class="card" data-cat="trabajo"><i>✓</i><h3>Prestaciones LOTTT</h3><p>Garantía trimestral o retroactivo: el monto mayor.</p><button data-page="Prestaciones sociales">Calcular ahora →</button></article>
<article class="card" data-cat="trabajo"><i>15</i><h3>Vacaciones y utilidades</h3><p>Días, bono vacacional y aguinaldo.</p><button data-page="Vacaciones y utilidades">Calcular ahora →</button></article>
<article class="card" data-cat="trabajo"><i>+</i><h3>Sueldo y recargos</h3><p>Horas extra, bono nocturno y salario integral.</p><button data-page="Sueldo y recargos">Calcular ahora →</button></article>
<article class="card" data-cat="impuestos"><i>%</i><h3>ISLR y tributos</h3><p>ISLR, IVA, IGTF y retenciones SENIAT.</p><button data-page="ISLR y tributos">Calcular ahora →</button></article>
<article class="card" data-cat="trabajo"><i>IV</i><h3>IVSS y deducciones</h3><p>Aportes, paro forzoso y sueldo neto.</p><button data-page="IVSS y deducciones">Calcular ahora →</button></article>
<article class="card" data-cat="vida"><i>▣</i><h3>Pasaporte SAIME</h3><p>Costo estimado y equivalencia en divisas.</p><button data-page="Trámites y SAIME">Calcular ahora →</button></article>
<article class="card" data-cat="finanzas"><i>⛽</i><h3>Crédito y gasolina</h3><p>Cuotas bancarias y cupo subsidiado.</p><button data-page="Crédito y gasolina">Calcular ahora →</button></article>
<article class="card" data-cat="vida"><i>20</i><h3>Promedio de notas</h3><p>Escala venezolana de 0 a 20 puntos.</p><button data-page="Promedio de notas">Calcular ahora →</button></article>
</div></div></section>
<section class="facts"><div class="wrap facts-grid"><div><span class="eyebrow">Venezuela 2026 de un vistazo</span><h2>Los valores detrás de cada cuenta.</h2><p>Las referencias se muestran para que siempre sepas qué dato usa el resultado.</p></div><div class="fact-list"><div class="fact"><span>Dólar oficial</span><b>BCV · actualización diaria</b></div><div class="fact"><span>IVA general</span><b>16%</b></div><div class="fact"><span>IGTF en divisas</span><b>3%</b></div><div class="fact"><span>Vacaciones · primer año</span><b>15 días hábiles</b></div><div class="fact"><span>Utilidades</span><b>15 a 120 días</b></div><div class="fact"><span>Prestaciones sociales</span><b>LOTTT Art. 142</b></div></div></div></section><div class="foot"></div><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-venezuela-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-venezuela-home');

const $=s=>root.querySelector(s),cards=[...root.querySelectorAll(".card")],filters=[...root.querySelectorAll(".filter")],fmt=n=>new Intl.NumberFormat("es-VE",{minimumFractionDigits:2,maximumFractionDigits:2}).format(n);function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}function convert(){const ves=Math.max(0,+$("#ves").value||0),par=Math.max(.01,+$("#parallel").value||1),bcv=125.32,uPar=ves/par,uBcv=ves/bcv,gap=(par/bcv-1)*100;$("#usd").textContent=`USD ${fmt(uPar)}`;$("#gap").textContent=`A tasa BCV serían USD ${fmt(uBcv)} · brecha ${fmt(gap)}%`}function filter(cat,term=""){const q=term.toLowerCase().trim();cards.forEach(c=>c.hidden=!(cat==="all"||c.dataset.cat===cat)||!!q&&!c.textContent.toLowerCase().includes(q));filters.forEach(f=>f.classList.toggle("active",f.dataset.filter===cat))}$("#convert").onclick=()=>{convert();toast("✓ Conversión actualizada")};["#ves","#parallel"].forEach(s=>$(s).addEventListener("input",convert));filters.forEach(f=>f.onclick=()=>filter(f.dataset.filter));$("#searchBtn").onclick=()=>{filter("all",$("#search").value);$(".main").scrollIntoView({behavior:"smooth"})};root.querySelectorAll(".card button").forEach(b=>b.onclick=()=>toast(`Abriría: ${b.dataset.page}`));convert();

})();
</script>
<style is:global>

.mockup-venezuela-home *{box-sizing:border-box}.mockup-venezuela-home{margin:0;font:16px/1.5 Inter,ui-sans-serif,system-ui;color:#111c32;background:#f7f8f5}.mockup-venezuela-home button,.mockup-venezuela-home input{font:inherit}.mockup-venezuela-home .wrap{width:min(1160px,calc(100% - 40px));margin:auto}.mockup-venezuela-home .top{height:84px;background:#fff;border-bottom:1px solid #dde4e7;display:flex;align-items:center}.mockup-venezuela-home .nav{display:flex;align-items:center;justify-content:space-between}.mockup-venezuela-home .brand{font-size:19px;font-weight:850;display:flex;align-items:center;gap:11px}.mockup-venezuela-home .logo{width:34px;height:34px;border-radius:8px;background:#173451;color:#fff;display:grid;place-items:center;font-size:12px}.mockup-venezuela-home .links{display:flex;gap:26px;font-size:13px;font-weight:750;color:#4c5a6c}.mockup-venezuela-home .tools{display:flex;gap:9px}.mockup-venezuela-home .tools span{padding:10px 13px;border:1px solid #d9e1e5;border-radius:10px;font-size:12px;font-weight:750}
.mockup-venezuela-home .hero{padding:58px 0 65px;background:linear-gradient(128deg,#fff 0 58%,#eef5ff);overflow:hidden}.mockup-venezuela-home .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:62px;align-items:center}.mockup-venezuela-home .crumb{font-size:12px;color:#678099;margin-bottom:25px}.mockup-venezuela-home .eyebrow{font-size:11px;color:#2868c7;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.mockup-venezuela-home .hero h1{font-size:56px;line-height:1.03;letter-spacing:-.052em;margin:14px 0 18px}.mockup-venezuela-home .lead{font-size:18px;color:#607186;max-width:640px}.mockup-venezuela-home .search{display:flex;background:#fff;border:1px solid #d9e2e8;border-radius:14px;padding:6px;box-shadow:0 16px 38px #17345112;margin-top:25px}.mockup-venezuela-home .search input{border:0;outline:0;flex:1;padding:12px;min-width:0}.mockup-venezuela-home .search button,.mockup-venezuela-home .primary{border:0;background:#2868c7;color:#fff;border-radius:10px;padding:12px 18px;font-weight:850;cursor:pointer}.mockup-venezuela-home .flag-art{height:320px;position:relative;display:grid;place-items:center}.mockup-venezuela-home .flag{width:350px;height:220px;border-radius:24px;background:linear-gradient(#f2d73c 0 33.3%,#285fc5 33.3% 66.6%,#d83b49 66.6%);box-shadow:0 27px 58px #17345120;position:relative}.mockup-venezuela-home .stars{position:absolute;left:0;right:0;top:94px;text-align:center;color:#fff;font-size:21px;letter-spacing:7px}.mockup-venezuela-home .fx{position:absolute;right:-5px;bottom:5px;background:#fff;border-radius:15px;padding:14px 17px;box-shadow:0 14px 36px #17345122}.mockup-venezuela-home .fx small{display:block;font-size:9px;color:#718197;font-weight:850}.mockup-venezuela-home .fx strong{font-size:23px;color:#2868c7}
.mockup-venezuela-home .quick{margin-top:-22px;position:relative}.mockup-venezuela-home .quick-grid{display:grid;grid-template-columns:1.15fr .85fr;background:#fff;border:1px solid #dbe3e7;border-radius:20px;overflow:hidden;box-shadow:0 20px 50px #18354f14}.mockup-venezuela-home .form{padding:26px 29px}.mockup-venezuela-home .form h2{margin:0 0 5px;font-size:24px}.mockup-venezuela-home .form p{margin:0 0 18px;color:#64758a;font-size:13px}.mockup-venezuela-home .fields{display:grid;grid-template-columns:1fr 1fr auto;gap:9px}.mockup-venezuela-home .field label{font-size:10px;font-weight:850;display:block;margin-bottom:5px}.mockup-venezuela-home .field input{width:100%;border:1px solid #d5dee3;border-radius:10px;padding:12px;outline:0}.mockup-venezuela-home .result{background:#173451;color:#fff;padding:26px 29px;display:flex;flex-direction:column;justify-content:center}.mockup-venezuela-home .result small{color:#a8bed3;font-size:9px;font-weight:900;letter-spacing:.12em}.mockup-venezuela-home .result strong{font-size:32px;margin:5px 0}.mockup-venezuela-home .result span{color:#d4dfeb;font-size:12px}
.mockup-venezuela-home .main{padding:70px 0}.mockup-venezuela-home .head{display:flex;justify-content:space-between;align-items:end;margin-bottom:23px}.mockup-venezuela-home .head h2{font-size:37px;letter-spacing:-.04em;margin:8px 0}.mockup-venezuela-home .head p{color:#65758a;max-width:500px}.mockup-venezuela-home .filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}.mockup-venezuela-home .filter{border:1px solid #d9e2e6;background:#fff;color:#607084;border-radius:99px;padding:9px 13px;font-size:11px;font-weight:850;cursor:pointer}.mockup-venezuela-home .filter.active{background:#173451;color:#fff}.mockup-venezuela-home .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-venezuela-home .card{background:#fff;border:1px solid #dce4e7;border-radius:17px;padding:20px;min-height:175px;display:flex;flex-direction:column}.mockup-venezuela-home .card i{font-style:normal;width:39px;height:39px;border-radius:11px;background:#eaf2ff;color:#2868c7;display:grid;place-items:center;font-weight:900}.mockup-venezuela-home .card h3{font-size:17px;margin:13px 0 5px}.mockup-venezuela-home .card p{font-size:12px;color:#65758a;margin:0 0 15px}.mockup-venezuela-home .card button{margin-top:auto;border:0;background:none;color:#2868c7;text-align:left;padding:0;font-weight:850;cursor:pointer}.mockup-venezuela-home .facts{padding:67px 0;background:#edf1ee}.mockup-venezuela-home .facts-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:55px}.mockup-venezuela-home .facts h2{font-size:38px;line-height:1.1}.mockup-venezuela-home .facts p{color:#637488}.mockup-venezuela-home .fact-list{background:#fff;border:1px solid #dae3e4;border-radius:18px;overflow:hidden}.mockup-venezuela-home .fact{display:flex;justify-content:space-between;gap:20px;padding:15px 19px;border-bottom:1px solid #e1e7e8}.mockup-venezuela-home .fact:last-child{border:0}.mockup-venezuela-home .fact span{font-size:12px;color:#65758a}.mockup-venezuela-home .fact b{text-align:right}.mockup-venezuela-home .toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);opacity:0;background:#173451;color:#fff;border-radius:11px;padding:12px 17px;font-weight:750;transition:.2s}.mockup-venezuela-home .toast.show{opacity:1;transform:translate(-50%,0)}.mockup-venezuela-home .foot{height:90px}
@media(max-width:850px){.mockup-venezuela-home .links{display:none}.mockup-venezuela-home .hero-grid,.mockup-venezuela-home .quick-grid,.mockup-venezuela-home .facts-grid{grid-template-columns:1fr}.mockup-venezuela-home .flag-art{height:280px}.mockup-venezuela-home .cards{grid-template-columns:1fr 1fr}.mockup-venezuela-home .hero h1{font-size:44px}}@media(max-width:520px){.mockup-venezuela-home .wrap{width:min(100% - 28px,1160px)}.mockup-venezuela-home .flag-art{display:none}.mockup-venezuela-home .hero h1{font-size:39px}.mockup-venezuela-home .fields,.mockup-venezuela-home .cards{grid-template-columns:1fr}.mockup-venezuela-home .head{display:block}.mockup-venezuela-home .tools span:first-child{display:none}}

.mockup-venezuela-home { width:100%; overflow:hidden; }
.mockup-venezuela-home .top, .mockup-venezuela-home header.top { display:none !important; }
.mockup-venezuela-home .foot { display:none !important; }
.mockup-venezuela-home .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-venezuela-home .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-venezuela-home .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-venezuela-home .support-real summary { cursor:pointer; font-weight:750; }
.mockup-venezuela-home .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-venezuela-home :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-venezuela-home input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-venezuela-home input[type="number"]::-webkit-inner-spin-button, .mockup-venezuela-home input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-venezuela-home .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-venezuela-home support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
