---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-climatizacion" set:html={`
<section class="hero"><div class="wrap"><div class="crumb">Hogar / Climatización</div><div class="hero-grid"><div><div class="eyebrow">Confort sin sorpresas en la boleta</div><h1>La temperatura justa. El equipo justo.</h1><p class="lead">Calculá qué potencia necesita tu ambiente y cuánto vas a gastar para enfriarlo o calentarlo. Con las unidades y costos separados, para decidir sin adivinar.</p><div class="chips"><span class="chip">✓ Frigorías y BTU</span><span class="chip">✓ Costo por mes</span><span class="chip">✓ Gas vs. electricidad</span></div></div><div class="home"><div class="house"><span class="roof"></span><span class="split"></span><span class="window"></span><span class="heater"></span><span class="flow"></span></div><div class="temp"><small>CONFORT RECOMENDADO</small><strong>24 °C</strong></div></div></div></div></section>
<section class="wrap"><div class="tool"><div class="cases" id="cases"></div><div class="calc"><div class="form"><h2 id="formTitle">¿Qué aire necesita tu ambiente?</h2><p class="hint" id="formHint">Dimensionamos el equipo y estimamos su consumo real.</p><div class="fields" id="fields"></div><button class="primary" id="calculate">Actualizar cálculo</button></div><div class="result"><div class="caps" id="resultLabel">EQUIPO RECOMENDADO</div><div class="big" id="mainResult">3.000 frigorías</div><div class="sub" id="resultText"></div><span class="status" id="status">Tamaño comercial correcto</span><div class="rows" id="rows"></div></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">Para un ambiente de 20 m² · 8 h por día</div><h2>El calor no cuesta lo mismo.</h2><p>Una bomba de calor mueve energía; una resistencia eléctrica tiene que generarla.</p></div><div class="compare" id="comparison"><article class="option best"><span class="badge">MÁS BARATO</span><span class="icon">◉</span><h3>Gas natural</h3><div class="cost" id="gasCost">$9.605/mes</div><p>Red domiciliaria · 0,3 m³/h</p></article><article class="option"><span class="icon">↻</span><h3>Aire modo calor</h3><div class="cost" id="heatCost">$64.397/mes</div><p>Bomba de calor · 650 W</p></article><article class="option"><span class="icon">▥</span><h3>Leña</h3><div class="cost" id="woodCost">$21.600/mes</div><p>Salamandra · 3 kg/h</p></article><article class="option"><span class="icon">≈</span><h3>Eléctrico</h3><div class="cost" id="electricCost">$148.781/mes</div><p>Resistencia · 1.500 W</p></article></div></div></section>
<section class="guide"><div class="wrap guide-grid"><div><div class="eyebrow">Cuatro decisiones que ahorran</div><h2>El consumo empieza antes de prender.</h2><p>Un equipo mal dimensionado y una casa que pierde temperatura pueden costar más que elegir una tecnología menos eficiente.</p></div><div class="tips"><div class="tip"><span class="num">1</span><b>Dimensioná primero</b><span>Grande de más tampoco conviene: corta y arranca seguido.</span></div><div class="tip"><span class="num">2</span><b>Sellá filtraciones</b><span>Burletes y cortinas reducen horas de funcionamiento.</span></div><div class="tip"><span class="num">3</span><b>Usá el termostato</b><span>Cada grado puede mover cerca de 7% el consumo.</span></div><div class="tip"><span class="num">4</span><b>Mantené los filtros</b><span>Un filtro sucio baja el caudal y fuerza el equipo.</span></div></div></div></section>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-climatizacion')?document.currentScript.previousElementSibling:document.querySelector('.mockup-climatizacion');

const configs=[
{id:"equipo",icon:"▣",title:"Elegir equipo",desc:"Frigorías y kcal/h",form:"¿Qué equipo necesita tu ambiente?",hint:"Calculamos frío y calor según superficie, orientación y aislación.",label:"EQUIPO RECOMENDADO",fields:[["m2","Superficie del ambiente","number",20],["altura","Altura del techo","number",2.6],["sol","Orientación y sol","select","Sol medio",["Poco sol","Sol medio","Mucho sol"]],["aisla","Aislación","select","Normal",["Buena","Normal","Mala"]]],calc:v=>{let factorSol={"Poco sol":.9,"Sol medio":1.1,"Mucho sol":1.25}[v.sol],factorA={Buena:.85,Normal:1,Mala:1.2}[v.aisla],exact=+v.m2*600*(+v.altura/2.6)*factorSol*factorA,commercial=[6000,9000,12000,18000,24000,30000,36000,48000,60000].find(x=>x>=exact)||60000,frig=Math.round(commercial/4),kcal=Math.round(+v.m2*+v.altura*50/500)*500;return res(frig.toLocaleString("es-AR")+" frigorías",`${v.m2} m² · elegí un equipo de ${commercial.toLocaleString("es-AR")} BTU.`,`Tamaño comercial correcto`,[["Necesidad calculada",Math.round(exact).toLocaleString("es-AR")+" BTU"],["Equipo comercial",commercial.toLocaleString("es-AR")+" BTU"],["Calefacción sugerida",kcal.toLocaleString("es-AR")+" kcal/h"],["Aislación",v.aisla]])}},
{id:"frio",icon:"❄",title:"Costo del aire",desc:"Hora, mes y verano",form:"¿Cuánto cuesta tener el aire prendido?",hint:"Estimamos el consumo según ambiente, equipo y horas.",label:"COSTO ESTIMADO DEL MES",fields:[["m2","Superficie","number",20],["hours","Horas por día","number",8],["type","Tipo de equipo","select","Inverter",["Inverter","On/off"]],["months","Meses de temporada","number",4]],calc:v=>{let btu=Math.ceil(+v.m2*660/3000)*3000,frig=btu/4,eer=v.type==="Inverter"?4.5:3,w=frig*1.163/eer,kwh=w/1000*+v.hours*30,c=kwh*303.07;return res("$"+Math.round(c).toLocaleString("es-AR"),`${kwh.toFixed(1).replace(".",",")} kWh · ${v.hours} horas por día.`,v.type==="Inverter"?"Inverter: menor consumo":"On/off: consume más",[["Equipo",frig.toLocaleString("es-AR")+" frigorías"],["Potencia eléctrica",Math.round(w)+" W"],["Costo por hora","$"+Math.round(c/(+v.hours*30)).toLocaleString("es-AR")],["Temporada","$"+Math.round(c*+v.months).toLocaleString("es-AR")]])}},
{id:"calor",icon:"☀",title:"Comparar calor",desc:"Gas, aire, leña y eléctrico",form:"¿Con qué calefacción gastás menos?",hint:"Comparamos las cuatro fuentes para el mismo ambiente y uso.",label:"OPCIÓN MÁS BARATA",fields:[["m2","Superficie","number",20],["hours","Horas por día","number",8],["wood","Precio de la leña por kg","number",30],["months","Meses de invierno","number",4]],calc:v=>{let size=+v.m2<=15?"small":+v.m2<=30?"medium":"large",d={small:[.3,1500,650],medium:[.4,2000,850],large:[.6,2500,1200]}[size],h=+v.hours*30,ops=[["Gas natural",d[0]*h*133.39],["Aire modo calor",d[2]/1000*h*303.07],["Leña",3*h*+v.wood],["Calefactor eléctrico",d[1]/1000*h*303.07]].sort((a,b)=>a[1]-b[1]);updateCompare(d,h,+v.wood);return res("$"+Math.round(ops[0][1]).toLocaleString("es-AR"),`${ops[0][0]} es la opción más barata para este uso.`,"Ahorro mensual: $"+Math.round(ops[3][1]-ops[0][1]).toLocaleString("es-AR"),ops.map(x=>[x[0],"$"+Math.round(x[1]).toLocaleString("es-AR")]))}},
{id:"agua",icon:"◒",title:"Agua caliente",desc:"Termo eléctrico vs. gas",form:"¿Termotanque eléctrico o a gas?",hint:"Calculamos la energía para calentar el agua diaria.",label:"OPCIÓN MÁS BARATA",fields:[["liters","Litros calientes por día","number",120],["people","Personas en el hogar","number",3],["days","Días del mes","number",30]],calc:v=>{let kcal=+v.liters*40*+v.days,kwh=kcal/860/.95,gas=kcal/9300/.8,ce=kwh*303.07,cg=gas*133.39;return res("$"+Math.round(cg).toLocaleString("es-AR"),"El termotanque a gas cuesta menos por mes.","Gas natural gana",[["Consumo eléctrico",kwh.toFixed(1).replace(".",",")+" kWh"],["Costo eléctrico","$"+Math.round(ce).toLocaleString("es-AR")],["Consumo de gas",gas.toFixed(1).replace(".",",")+" m³"],["Costo a gas","$"+Math.round(cg).toLocaleString("es-AR")]])}},
{id:"clima",icon:"",title:"Demanda de zona",desc:"Grados-día HDD y CDD",form:"¿Cuánta demanda térmica tuvo tu zona?",hint:"Los grados-día separan el efecto del clima del hábito de uso.",label:"DEMANDA DEL PERÍODO",fields:[["temp","Temperatura media","number",11],["days","Días del período","number",30],["baseHeat","Base de calefacción","number",18],["baseCool","Base de refrigeración","number",24]],calc:v=>{let h=Math.max(0,+v.baseHeat-+v.temp)*+v.days,c=Math.max(0,+v.temp-+v.baseCool)*+v.days;return res(h+" HDD",h>0?"El período exigió calefacción.":c>0?"El período exigió refrigeración.":"El período estuvo dentro de la zona neutra.",h>300?"Demanda alta":"Demanda moderada",[["Calefacción",h+" HDD"],["Refrigeración",c+" CDD"],["Temperatura media",v.temp+" °C"],["Días analizados",v.days]])}}
];let active="equipo";const $=id=>root.querySelector("#"+id),ars=n=>"$"+Math.round(n).toLocaleString("es-AR");function res(value,text,status,rows){return{value,text,status,rows}}
function updateCompare(d=[.3,1500,650],h=240,wood=30){$("gasCost").textContent=ars(d[0]*h*133.39)+"/mes";$("heatCost").textContent=ars(d[2]/1000*h*303.07)+"/mes";$("woodCost").textContent=ars(3*h*wood)+"/mes";$("electricCost").textContent=ars(d[1]/1000*h*303.07)+"/mes"}
function current(){return configs.find(x=>x.id===active)}function drawCases(){$("cases").innerHTML=configs.map(x=>`<button class="case ${x.id===active?"active":""}" data-id="${x.id}"><div class="ico">${x.icon}</div><b>${x.title}</b><span>${x.desc}</span></button>`).join("");root.querySelectorAll(".case").forEach(b=>b.onclick=()=>{active=b.dataset.id;render()})}
function drawFields(m){$("fields").innerHTML=m.fields.map(f=>{let[id,label,type,val,opts]=f;return type==="select"?`<div class="field"><label for="${id}">${label}</label><select id="${id}">${opts.map(o=>`<option ${o===val?"selected":""}>${o}</option>`).join("")}</select></div>`:`<div class="field"><label for="${id}">${label}</label><input id="${id}" type="number" step="any" value="${val}"></div>`}).join("");$("fields").querySelectorAll("input,select").forEach(x=>x.addEventListener("input",compute))}
function compute(){let m=current(),v=Object.fromEntries(m.fields.map(f=>[f[0],$(f[0]).value])),r=m.calc(v);$("mainResult").textContent=r.value;$("resultText").textContent=r.text;$("status").textContent=r.status;$("rows").innerHTML=r.rows.map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
function render(){drawCases();let m=current();$("formTitle").textContent=m.form;$("formHint").textContent=m.hint;$("resultLabel").textContent=m.label;drawFields(m);compute()}$("calculate").onclick=()=>{compute();let b=$("calculate"),old=b.textContent;b.textContent="✓ Cálculo actualizado";setTimeout(()=>b.textContent=old,1300)};render();updateCompare();

})();
</script>
<style is:global>

.mockup-climatizacion{--ink:#111b2d;--muted:#667085;--paper:#f5f7f4;--card:#fff;--blue:#2766c4;--blue2:#e7f1ff;--orange:#ea8747;--orange2:#fff0e4;--teal:#2e8d87;--line:#dde3e7;--navy:#183354}
.mockup-climatizacion *{box-sizing:border-box}.mockup-climatizacion [hidden]{display:none!important}.mockup-climatizacion{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-climatizacion button,.mockup-climatizacion input,.mockup-climatizacion select{font:inherit}.mockup-climatizacion .wrap{max-width:1180px;margin:auto;padding:0 28px}
.mockup-climatizacion header{height:84px;background:#fff;border-bottom:1px solid var(--line)}.mockup-climatizacion header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-climatizacion .brand{display:flex;align-items:center;gap:12px;font-weight:850;font-size:20px}.mockup-climatizacion .logo{width:35px;height:35px;border-radius:8px;background:var(--navy);display:grid;place-items:center;color:#fff;font-size:14px}.mockup-climatizacion .nav{display:flex;gap:26px;color:#4e5667;font-weight:700;font-size:14px}.mockup-climatizacion .actions{margin-left:auto;display:flex;gap:10px}.mockup-climatizacion .ghost{border:1px solid var(--line);background:#fff;padding:11px 15px;border-radius:12px;font-weight:750;color:var(--ink)}
.mockup-climatizacion .hero{padding:58px 0 48px;background:linear-gradient(125deg,#f8fbff 0 53%,#fff7ef 53%)}.mockup-climatizacion .crumb{font-size:14px;color:#3275cb;margin-bottom:19px}.mockup-climatizacion .hero-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:65px;align-items:center}.mockup-climatizacion .eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:900;color:var(--teal)}.mockup-climatizacion h1{font-size:56px;line-height:1.02;letter-spacing:-.05em;margin:14px 0 19px}.mockup-climatizacion .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-climatizacion .chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.mockup-climatizacion .chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 13px;font-size:13px;font-weight:780}
.mockup-climatizacion .home{height:345px;position:relative}.mockup-climatizacion .house{position:absolute;left:45px;right:15px;bottom:12px;height:230px;background:#fff;border:3px solid #d5dde2;border-radius:8px 8px 24px 24px;box-shadow:0 25px 55px #30455b1c}.mockup-climatizacion .roof{position:absolute;left:17px;right:-13px;top:-73px;height:95px;background:#314763;clip-path:polygon(50% 0,100% 75%,92% 100%,50% 31%,8% 100%,0 75%)}.mockup-climatizacion .split{position:absolute;left:38px;top:34px;width:115px;height:42px;border-radius:9px;background:#edf4f8;border:2px solid #cbd8df}.mockup-climatizacion .split:after{content:"";position:absolute;left:16px;right:16px;bottom:9px;border-bottom:4px solid #75bce2;border-radius:9px}.mockup-climatizacion .heater{position:absolute;right:42px;bottom:22px;width:70px;height:112px;border-radius:9px;background:#f2e4d4;border:2px solid #d7c2aa}.mockup-climatizacion .heater:before{content:"";position:absolute;inset:14px;border:3px solid #e9a264;border-radius:5px}.mockup-climatizacion .window{position:absolute;left:45px;bottom:35px;width:105px;height:70px;background:linear-gradient(135deg,#cce8f7,#effaff);border:5px solid #90a7b7}.mockup-climatizacion .flow{position:absolute;left:85px;top:28px;width:160px;height:70px;border:4px dashed #58a9dd;border-left:0;border-bottom:0;border-radius:0 80px 0 0}.mockup-climatizacion .temp{position:absolute;right:-3px;top:2px;background:#fff;border-radius:16px;padding:14px 17px;box-shadow:0 13px 35px #243b521f}.mockup-climatizacion .temp small{display:block;color:var(--muted);font-size:10px;font-weight:900;letter-spacing:.1em}.mockup-climatizacion .temp strong{font-size:26px;color:var(--blue)}
.mockup-climatizacion .tool{background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden;box-shadow:0 20px 55px #1a314713;margin:0 auto 70px}.mockup-climatizacion .cases{padding:22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.mockup-climatizacion .case{min-height:78px;text-align:left;border:1px solid var(--line);background:#fbfcfc;border-radius:14px;padding:13px;cursor:pointer;color:var(--ink)}.mockup-climatizacion .case b{display:block;font-size:13px}.mockup-climatizacion .case span{font-size:11px;color:var(--muted)}.mockup-climatizacion .case.active{border:2px solid var(--blue);padding:12px;background:#eef5ff}.mockup-climatizacion .case .ico{font-size:18px;margin-bottom:4px}
.mockup-climatizacion .calc{display:grid;grid-template-columns:.94fr 1.06fr}.mockup-climatizacion .form{padding:31px}.mockup-climatizacion .form h2{font-size:26px;margin:0 0 7px;letter-spacing:-.03em}.mockup-climatizacion .hint{color:var(--muted);margin:0 0 23px}.mockup-climatizacion .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-climatizacion .field{display:flex;flex-direction:column;gap:7px}.mockup-climatizacion .field.full{grid-column:1/-1}.mockup-climatizacion .field label{font-size:13px;font-weight:800}.mockup-climatizacion .field input,.mockup-climatizacion .field select{width:100%;border:1px solid #cdd5dc;background:#fff;border-radius:12px;padding:14px;outline:none;color:var(--ink)}.mockup-climatizacion .field input:focus,.mockup-climatizacion .field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #2766c419}.mockup-climatizacion .primary{width:100%;border:0;background:var(--blue);color:#fff;border-radius:13px;padding:15px;font-weight:850;margin-top:20px;cursor:pointer}
.mockup-climatizacion .result{background:var(--navy);color:#fff;padding:31px;position:relative;overflow:hidden}.mockup-climatizacion .result:after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;border:45px solid #ffffff08;right:-145px;bottom:-145px}.mockup-climatizacion .caps{color:#9fd1e0;letter-spacing:.13em;font-size:10px;font-weight:900}.mockup-climatizacion .big{font-size:45px;line-height:1.05;font-weight:920;letter-spacing:-.045em;margin:15px 0 7px}.mockup-climatizacion .sub{color:#d5e0ec;min-height:45px}.mockup-climatizacion .status{display:inline-block;background:#dff3e7;color:#176947;padding:8px 12px;border-radius:999px;font-size:13px;font-weight:850;margin:13px 0 22px}.mockup-climatizacion .rows{border-top:1px solid #ffffff24}.mockup-climatizacion .row{display:flex;justify-content:space-between;gap:20px;padding:13px 0;border-bottom:1px solid #ffffff1b;color:#d6dfeb}.mockup-climatizacion .row strong{color:#fff;text-align:right}
.mockup-climatizacion .section{padding:12px 0 68px}.mockup-climatizacion .section-head{text-align:center;max-width:720px;margin:0 auto 30px}.mockup-climatizacion .section-head h2{font-size:39px;letter-spacing:-.04em;margin:8px 0}.mockup-climatizacion .section-head p{color:var(--muted)}.mockup-climatizacion .compare{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.mockup-climatizacion .option{background:#fff;border:1px solid var(--line);border-radius:18px;padding:21px;position:relative}.mockup-climatizacion .option.best{border:2px solid var(--teal);padding:20px}.mockup-climatizacion .badge{position:absolute;right:13px;top:13px;background:#dff3e7;color:#176947;border-radius:99px;padding:5px 8px;font-size:10px;font-weight:900}.mockup-climatizacion .option .icon{font-size:24px}.mockup-climatizacion .option h3{margin:11px 0 4px}.mockup-climatizacion .option .cost{font-size:25px;font-weight:900;margin:13px 0 2px}.mockup-climatizacion .option p{font-size:13px;color:var(--muted);margin:0}
.mockup-climatizacion .guide{background:#e9eef0;padding:66px 0}.mockup-climatizacion .guide-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px}.mockup-climatizacion .guide h2{font-size:40px;line-height:1.08;margin:10px 0}.mockup-climatizacion .guide p{color:var(--muted)}.mockup-climatizacion .tips{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-climatizacion .tip{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px}.mockup-climatizacion .num{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:var(--blue2);color:var(--blue);font-weight:900;margin-bottom:12px}.mockup-climatizacion .tip b{display:block;margin-bottom:5px}.mockup-climatizacion .tip span{font-size:13px;color:var(--muted)}
.mockup-climatizacion footer{background:#fff;border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:13px}
@media(max-width:850px){.mockup-climatizacion .nav{display:none}.mockup-climatizacion .hero-grid,.mockup-climatizacion .calc,.mockup-climatizacion .guide-grid{grid-template-columns:1fr}.mockup-climatizacion .home{height:290px}.mockup-climatizacion .cases{display:flex;overflow:auto}.mockup-climatizacion .case{min-width:165px}.mockup-climatizacion .compare{grid-template-columns:1fr 1fr}.mockup-climatizacion h1{font-size:45px}}@media(max-width:540px){.mockup-climatizacion .wrap{padding:0 18px}.mockup-climatizacion .hero{padding-top:35px;background:#f8fbff}.mockup-climatizacion .home{display:none}.mockup-climatizacion h1{font-size:39px}.mockup-climatizacion .fields,.mockup-climatizacion .compare,.mockup-climatizacion .tips{grid-template-columns:1fr}.mockup-climatizacion .field.full{grid-column:auto}.mockup-climatizacion .tool{border-radius:18px}.mockup-climatizacion .form,.mockup-climatizacion .result{padding:25px 20px}}

.mockup-climatizacion { width:100%; overflow:hidden; }
.mockup-climatizacion .top, .mockup-climatizacion header.top { display:none !important; }
.mockup-climatizacion .foot { display:none !important; }
.mockup-climatizacion .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-climatizacion .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-climatizacion .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-climatizacion .support-real summary { cursor:pointer; font-weight:750; }
.mockup-climatizacion .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-climatizacion :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-climatizacion input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-climatizacion input[type="number"]::-webkit-inner-spin-button, .mockup-climatizacion input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-climatizacion .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-climatizacion support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
