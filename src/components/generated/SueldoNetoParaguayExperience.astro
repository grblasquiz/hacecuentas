.mockup-sueldo-neto-paraguay .calculator{margin-top:-26px;position:relative;z-index:3}.mockup-sueldo-neto-paraguay .calc-shell{display:grid;grid-template-columns:1.05fr .95fr;background:#fff;border:1px solid var(--line);border-radius:24px;overflow:hidden;box-shadow:0 22px 60px #20344c14}.mockup-sueldo-neto-paraguay .form{padding:31px 33px}.mockup-sueldo-neto-paraguay .form-head{display:flex;justify-content:space-between;gap:20px;align-items:start;margin-bottom:22px}.mockup-sueldo-neto-paraguay .form h2{font-size:28px;letter-spacing:-.035em;margin:0 0 5px}.mockup-sueldo-neto-paraguay .form-head p{margin:0;color:var(--muted);font-size:13px}.mockup-sueldo-neto-paraguay .clear{border:0;background:transparent;color:var(--blue);font-weight:800;font-size:12px;cursor:pointer;padding:7px}
