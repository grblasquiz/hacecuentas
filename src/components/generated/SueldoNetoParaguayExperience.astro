---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-sueldo-neto-paraguay" set:html={`
<section class="hero"><div class="wrap"><div class="crumb">Paraguay / Trabajo / Sueldo neto</div><div class="hero-grid"><div><div class="eyebrow">Paraguay · recibo de sueldo 2026</div><h1>Tu bruto dice una cosa. Tu cuenta recibe otra.</h1><p class="lead">Calculá cuánto cobrás después del IPS, sumá horas extra y bonificación familiar, y entendé cada línea del recibo.</p><div class="stamps"><span class="stamp">IPS obrero 9%</span><span class="stamp">Salario mínimo Gs. 3.044.000</span><span class="stamp">Ley 213/93 actualizada</span></div></div><div class="pay-visual"><div class="receipt"><div class="rhead"><b>Recibo del mes</b><span class="flag"></span></div><div class="rline"><span>Salario bruto</span><strong>Gs. 3.500.000</strong></div><div class="rline"><span>Horas extra</span><strong>Gs. 175.000</strong></div><div class="rline"><span>Bonif. familiar</span><strong>Gs. 152.200</strong></div><div class="rline minus"><span>IPS obrero · 9%</span><strong>− Gs. 330.750</strong></div><div class="rtotal"><div><small>Neto depositado</small>31 JUL 2026</div><strong>Gs. 3.496.450</strong></div></div><div class="deposit"><small>DEPÓSITO CONFIRMADO</small><b>✓ Ya sabés de dónde sale</b></div></div></div></div></section>
<section class="calculator"><div class="wrap"><div class="calc-shell"><div class="form"><div class="form-head"><div><h2>Armá tu recibo de este mes</h2><p>Dejá en cero lo que no te corresponda.</p></div><button class="clear" id="clearBtn">Limpiar</button></div>
<div class="modes" role="group" aria-label="Modalidad"><button class="mode active" data-mode="mensualero"><b>Mensual</b><span>Sueldo fijo</span></button><button class="mode" data-mode="jornalero"><b>Jornal</b><span>Pago diario</span></button><button class="mode" data-mode="domestica"><b>Doméstico</b><span>100% del mínimo</span></button><button class="mode" data-mode="embargado"><b>Embargo</b><span>Ver tope legal</span></button></div>
<div class="fields"><div class="field full"><label id="salaryLabel" for="salary">Salario bruto mensual</label><div class="inputwrap"><span class="prefix">Gs.</span><input id="salary" inputmode="numeric" value="3.500.000"></div><div class="help" id="salaryHelp">Antes de descuentos. Mínimo vigente: Gs. 3.044.000.</div></div><div class="field"><label for="children">Hijos con bonificación</label><div class="inputwrap"><input id="children" type="number" min="0" max="12" value="1"></div><div class="help">Menores de 17 años.</div></div><div class="field"><label for="extraDay">Horas extra diurnas</label><div class="inputwrap"><input id="extraDay" type="number" min="0" max="200" value="8"></div><div class="help">Se pagan al +50%.</div></div></div>
<details class="extras"><summary>Agregar nocturnas, feriados y descuentos</summary><div class="extra-grid"><div class="field"><label for="extraNight">Extra nocturnas</label><div class="inputwrap"><input id="extraNight" type="number" min="0" value="0"></div><div class="help">+100%</div></div><div class="field"><label for="night">Nocturnas normales</label><div class="inputwrap"><input id="night" type="number" min="0" value="0"></div><div class="help">+30%</div></div><div class="field"><label for="holiday">Feriados trabajados</label><div class="inputwrap"><input id="holiday" type="number" min="0" value="0"></div><div class="help">100% adicional</div></div><div class="field"><label for="absence">Faltas sin goce</label><div class="inputwrap"><input id="absence" type="number" min="0" max="30" value="0"></div></div><div class="field"><label for="other">Otros descuentos</label><div class="inputwrap"><span class="prefix">Gs.</span><input id="other" inputmode="numeric" value="0"></div></div><div class="field"><label for="embargoType">Tipo de embargo</label><div class="inputwrap"><input id="embargoType" value="Otras deudas" readonly></div></div></div></details>
<button class="calcbtn" id="calcBtn">Actualizar mi sueldo neto</button></div>
<aside class="result" aria-live="polite"><div class="result-label">NETO ESTIMADO A COBRAR</div><strong class="net" id="net">Gs. 3.496.450</strong><div class="net-sub" id="netSub">Equivale al 95,1% de todo lo que ganaste este mes.</div><div class="bar"><span class="bar-net" id="netBar" style="width:91%"></span><span class="bar-ips" id="ipsBar" style="width:9%"></span></div><div class="legend"><span><i style="background:#4bd0a5"></i>Para vos</span><span><i style="background:#f2aa52"></i>IPS</span></div><div class="breakdown"><div class="row"><span>Salario devengado</span><strong id="baseOut">Gs. 3.500.000</strong></div><div class="row add"><span>Horas y recargos</span><strong id="extrasOut">+ Gs. 175.000</strong></div><div class="row add"><span>Bonificación familiar</span><strong id="bonusOut">+ Gs. 152.200</strong></div><div class="row minus"><span>IPS obrero · 9%</span><strong id="ipsOut">− Gs. 330.750</strong></div><div class="row minus"><span>Otros descuentos</span><strong id="discountOut">− Gs. 0</strong></div><div class="row total"><span>Neto a cobrar</span><strong id="netOut">Gs. 3.496.450</strong></div></div><div class="cost"><div><small>APORTE PATRONAL · 16,5%</small><b id="patronOut">Gs. 606.375</b></div><div><small>COSTO PARA LA EMPRESA</small><strong id="costOut">Gs. 4.281.375</strong></div></div></aside></div></div></section>
<section class="cases"><div class="wrap"><div class="section-head"><div class="eyebrow">Todos los casos, a la vista</div><h2>La cuenta cambia según cómo trabajás.</h2><p>Elegir arriba ajusta el cálculo, pero acá podés comparar las cuatro situaciones sin perder ninguna.</p></div><div class="case-grid"><article class="case"><span class="case-icon">30</span><h3>Sueldo mensual</h3><p>Tu día vale bruto ÷ 30 y tu hora bruto ÷ 240.</p><ul><li>IPS obrero 9%</li><li>Feriado: 100% adicional</li><li>Bonificación si cobrás hasta 2 mínimos</li></ul></article><article class="case"><span class="case-icon">8h</span><h3>Pago por jornal</h3><p>El jornal mínimo vigente es Gs. 117.077 por 8 horas.</p><ul><li>También aporta 9% al IPS</li><li>Feriado trabajado: día al 200%</li><li>Liquidación por días trabajados</li></ul></article><article class="case"><span class="case-icon">⌂</span><h3>Trabajo doméstico</h3><p>Desde la Ley 6338/19 corresponde el 100% del salario mínimo.</p><ul><li>IPS obligatorio</li><li>Aguinaldo y vacaciones</li><li>Bonificación familiar</li></ul></article><article class="case"><span class="case-icon">§</span><h3>Con embargo</h3><p>La retención depende del tipo de deuda y de la orden judicial.</p><ul><li>Otras deudas: hasta 25%</li><li>Vivienda/alimentos: hasta 40%</li><li>Alimentaria: hasta 50%</li></ul></article></div></div></section>
<section class="explain"><div class="wrap explain-grid"><div><div class="eyebrow">La diferencia clave</div><h2>Tu 9% sí se descuenta. El 16,5% no.</h2><p>En el recibo sólo debe restarse tu aporte obrero al IPS. El aporte patronal es un costo adicional que paga la empresa.</p><div class="note">La calculadora es orientativa. Convenios, topes y situaciones particulares pueden cambiar el resultado.</div></div><div><div class="compare"><div class="compare-head"><span>CONCEPTO</span><span>QUIÉN LO PAGA</span><span>EJEMPLO ACTUAL</span></div><div class="compare-row"><b>IPS obrero · 9%</b><span>Trabajador</span><b id="cmpWorker">Gs. 330.750</b></div><div class="compare-row"><b>IPS patronal · 16,5%</b><span>Empleador</span><b id="cmpEmployer">Gs. 606.375</b></div><div class="compare-row"><b>Bonificación por hijo</b><span>Empleador</span><b>Gs. 152.200</b></div><div class="compare-row"><b>Hora extra diurna</b><span>Empleador</span><b id="cmpExtra">Gs. 21.875</b></div></div><div class="source">Fuentes: IPS, MTESS, Código del Trabajo Ley 213/93 y Decreto N° 6225. Valores vigentes en 2026.</div></div></div></section>
<button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="searchBtn" hidden aria-hidden="true"></button><button type="button" id="countryBtn" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-sueldo-neto-paraguay')?document.currentScript.previousElementSibling:document.querySelector('.mockup-sueldo-neto-paraguay');

const $=id=>root.querySelector("#"+id),SM=3044000,BONUS=152200,MAX_BONUS=6088000;
let mode="mensualero";
const money=n=>"Gs. "+Math.round(Math.max(0,n||0)).toLocaleString("de-DE");
const numberValue=id=>Math.max(0,Number(String($(id).value).replace(/\./g,"").replace(",", "."))||0);
function formatMoneyInput(el){let n=String(el.value).replace(/\D/g,"");el.value=n?Number(n).toLocaleString("de-DE"):"0"}
function compute(showMessage=false){
 let gross=numberValue("salary"),children=Math.floor(numberValue("children")),exDay=numberValue("extraDay"),exNight=numberValue("extraNight"),night=numberValue("night"),holidays=Math.floor(numberValue("holiday")),absences=Math.floor(numberValue("absence")),other=numberValue("other");
 let hour=gross/240,day=gross/30,absenceDiscount=absences*day,earned=Math.max(0,gross-absenceDiscount);
 let dayExtra=exDay*hour*1.5,nightExtra=exNight*hour*2,nightBonus=night*hour*.3,holiday=holidays*day*(mode==="jornalero"?2:1);
 let extras=dayExtra+nightExtra+nightBonus+holiday,remunerative=earned+extras,ips=remunerative*.09,bonus=gross<=MAX_BONUS?children*BONUS:0,net=Math.max(0,remunerative-ips+bonus-other),patron=remunerative*.165,cost=remunerative+patron;
 $("net").textContent=$("netOut").textContent=money(net);$("baseOut").textContent=money(earned);$("extrasOut").textContent="+ "+money(extras);$("bonusOut").textContent="+ "+money(bonus);$("ipsOut").textContent="− "+money(ips);$("discountOut").textContent="− "+money(other+absenceDiscount);$("patronOut").textContent=$("cmpEmployer").textContent=money(patron);$("costOut").textContent=money(cost);$("cmpWorker").textContent=money(ips);$("cmpExtra").textContent=money(hour*1.5);
 let pct=remunerative+bonus>0?net/(remunerative+bonus)*100:0;$("netSub").textContent=bonus===0&&children>0&&gross>MAX_BONUS?"No suma bonificación: el salario supera 2 mínimos.":`Equivale al ${pct.toFixed(1).replace(".",",")}% de todo lo que ganaste este mes.`;
 $("netBar").style.width=Math.max(0,Math.min(100,100-9))+"%";$("ipsBar").style.width="9%";
 if(mode==="embargado"){$("netSub").textContent+=` Tope estimado por otras deudas: ${money(net*.25)}.`}
 if(showMessage)toast("✓ Tu recibo se actualizó");
}
function setMode(next){mode=next;root.querySelectorAll(".mode").forEach(b=>b.classList.toggle("active",b.dataset.mode===mode));let journal=mode==="jornalero";$("salaryLabel").textContent=journal?"Ingreso bruto del período":"Salario bruto mensual";$("salaryHelp").textContent=journal?"Cargá el total bruto de los jornales del período. Jornal mínimo: Gs. 117.077.":mode==="domestica"?"Para jornada completa corresponde al menos el 100% del mínimo: Gs. 3.044.000.":"Antes de descuentos. Mínimo vigente: Gs. 3.044.000.";compute()}
function toast(t){$("toast").textContent=t;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1700)}
root.querySelectorAll(".mode").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));
["salary","children","extraDay","extraNight","night","holiday","absence","other"].forEach(id=>{$(id).addEventListener("input",()=>{if(id==="salary"||id==="other")formatMoneyInput($(id));compute()})});
$("calcBtn").onclick=()=>compute(true);
$("clearBtn").onclick=()=>{["children","extraDay","extraNight","night","holiday","absence","other"].forEach(id=>$(id).value="0");$("salary").value="3.044.000";setMode("mensualero");toast("Campos reiniciados")};
$("searchBtn").onclick=()=>toast("Buscar calculadoras");$("countryBtn").onclick=()=>toast("Paraguay seleccionado 🇵🇾");compute();

})();
</script>
