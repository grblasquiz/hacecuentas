<div class="mockup-resistencias" set:html={`<section class="hero"><div class="wrap"><div class="crumb">Tecnología / Resistencias</div><div class="heroGrid"><div><span class="eyebrow">Electrónica, con el circuito explicado</span><h1>La resistencia correcta protege el componente y hace predecible el circuito.</h1><p class="lead">Leé colores, calculá un LED, combiná valores o diseñá un divisor. Te mostramos fórmula, valor comercial y potencia.</p><div class="chips"><span class="chip">IEC 60062</span><span class="chip">Serie E12/E24</span><span class="chip">Ley de Ohm</span><span class="chip">Potencia segura</span></div></div><aside class="bench"><div class="benchTop"><b>RESISTENCIA DE EJEMPLO</b><span>4 BANDAS</span></div><div class="resistorArt"><i class="wire"></i><i class="bodyR"></i><i class="band a"></i><i class="band b"></i><i class="band c"></i><i class="band d"></i></div><div class="benchResult"><div><small>MARRÓN · NEGRO · ROJO · DORADO</small><strong>1 kΩ</strong></div><span>±5%<br>950–1.050 Ω</span></div></aside></div></div></section>
<section class="calc" id="calculadora"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">¿Qué estás resolviendo?</span><h2>Cuatro problemas, una misma pieza.</h2></div><p>Elegí el caso. Los campos cambian y el resultado incluye la fórmula, el rango o el componente comercial sugerido.</p></div><div class="cases"><button class="case active" data-case="colors"><span class="caseCode">IEC</span><b>Código de colores</b><span>4, 5 y 6 bandas con tolerancia.</span></button><button class="case" data-case="led"><span class="caseCode">LED</span><b>Resistencia para LED</b><span>Corriente, valor E12 y potencia.</span></button><button class="case" data-case="equivalent"><span class="caseCode">RΣ</span><b>Serie o paralelo</b><span>Hasta cuatro resistencias.</span></button><button class="case" data-case="divider"><span class="caseCode">Vout</span><b>Divisor de tensión</b><span>Salida, corriente y consumo.</span></button></div>
<div class="workspace"><article class="card"><div class="caseNote" id="caseNote"></div><div class="fields" id="fields"></div><div class="error" id="error"></div><div class="actionsRow"><button class="primary" id="calculate">Actualizar circuito</button><button class="secondary" id="reset">Restablecer</button></div><p class="fine">Valores nominales. Verificá tolerancia, potencia y tensión máxima de la pieza real antes de conectar.</p></article><aside class="card result" aria-live="polite"><div class="resultTop"><small>RESULTADO</small><span class="pill" id="pill"></span></div><div class="answer" id="answer"></div><div class="answerLabel" id="answerLabel"></div><div class="circuit"><small>FÓRMULA Y REEMPLAZO</small><strong id="formula"></strong></div><div class="rows" id="rows"></div><div class="insight" id="insight"></div></aside></div></div></section>
<section class="tableSec"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">Una secuencia que se aprende una vez</span><h2>Los diez colores y sus cifras.</h2></div><p>Como multiplicador, cada color desplaza la coma según su potencia de diez.</p></div><div class="colorGrid"><div class="colorCard"><i class="swatch" style="background:#111"></i>Negro · 0</div><div class="colorCard"><i class="swatch" style="background:#70452b"></i>Marrón · 1</div><div class="colorCard"><i class="swatch" style="background:#d64b40"></i>Rojo · 2</div><div class="colorCard"><i class="swatch" style="background:#e78432"></i>Naranja · 3</div><div class="colorCard"><i class="swatch" style="background:#efd347"></i>Amarillo · 4</div><div class="colorCard"><i class="swatch" style="background:#4a9b58"></i>Verde · 5</div><div class="colorCard"><i class="swatch" style="background:#3976c4"></i>Azul · 6</div><div class="colorCard"><i class="swatch" style="background:#7552b9"></i>Violeta · 7</div><div class="colorCard"><i class="swatch" style="background:#8b929c"></i>Gris · 8</div><div class="colorCard"><i class="swatch" style="background:#fff"></i>Blanco · 9</div></div></div></section>
<section class="rules"><div class="wrap"><div class="sectionHead"><div><span class="eyebrow">Las fórmulas que importan</span><h2>Antes de reemplazar, entendé el circuito.</h2></div></div><div class="ruleGrid"><article class="rule"><code>R = (Vin − Vf) / I</code><h3>LED</h3><p>La resistencia absorbe la tensión que sobra a la corriente elegida.</p></article><article class="rule"><code>Req = R1 + R2 + …</code><h3>Serie</h3><p>La corriente es la misma y las resistencias se suman.</p></article><article class="rule"><code>1/Req = Σ 1/R</code><h3>Paralelo</h3><p>El equivalente siempre queda por debajo de la más chica.</p></article><article class="rule"><code>Vout = Vin · R2/(R1+R2)</code><h3>Divisor</h3><p>La salida se toma sobre R2 y cae cuando conectás una carga.</p></article></div></div></section>
<section class="faqSec"><div class="wrap faq"><span class="eyebrow">Preguntas frecuentes</span><h2>Lo que más se confunde</h2><div class="faqItem open"><button class="faqQ">¿Desde qué lado se leen las bandas?<span>−</span></button><div class="faqA">Desde el extremo donde están más juntas. La tolerancia suele quedar separada y frecuentemente es dorada o plateada.</div></div><div class="faqItem"><button class="faqQ">¿Por qué el LED se redondea al valor superior?<span>+</span></button><div class="faqA">Una resistencia mayor reduce un poco la corriente; una menor puede superar la corriente nominal y acortar la vida del LED.</div></div><div class="faqItem"><button class="faqQ">¿Puedo usar una sola resistencia para LED en paralelo?<span>+</span></button><div class="faqA">No es recomendable. Cada rama debe tener su propia resistencia para evitar que un LED concentre la corriente.</div></div><div class="faqItem"><button class="faqQ">¿Un divisor sirve como fuente de alimentación?<span>+</span></button><div class="faqA">No. Es adecuado para señales o referencias de alta impedancia; una carga importante modifica la tensión de salida.</div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-resistencias')?document.currentScript.previousElementSibling:document.querySelector('.mockup-resistencias');if(!root)return;

const $=id=>root.querySelector("#"+id),$$=s=>[...root.querySelectorAll(s)],dec=(n,d=2)=>new Intl.NumberFormat("es-AR",{maximumFractionDigits:d}).format(n),num=id=>Number($(id)?.value||0),ohm=n=>n>=1e6?dec(n/1e6,3)+" MΩ":n>=1e3?dec(n/1e3,3)+" kΩ":dec(n,2)+" Ω";let current="colors";
const colors=[["negro","Negro · 0"],["marron","Marrón · 1"],["rojo","Rojo · 2"],["naranja","Naranja · 3"],["amarillo","Amarillo · 4"],["verde","Verde · 5"],["azul","Azul · 6"],["violeta","Violeta · 7"],["gris","Gris · 8"],["blanco","Blanco · 9"]],mult=[...colors,["dorado","Dorado · ×0,1"],["plateado","Plateado · ×0,01"]],tol=[["marron","Marrón · ±1%"],["rojo","Rojo · ±2%"],["verde","Verde · ±0,5%"],["azul","Azul · ±0,25%"],["violeta","Violeta · ±0,1%"],["dorado","Dorado · ±5%"],["plateado","Plateado · ±10%"]];
const cfg={colors:{note:"Las cifras forman el número, el multiplicador agrega ceros y la última banda define el margen real.",pill:"CÓDIGO IEC 60062",fields:[["bands","Cantidad de bandas","4","","select",[["4","4 bandas"],["5","5 bandas"],["6","6 bandas"]]],["d1","Primera cifra","marron","","select",colors],["d2","Segunda cifra","negro","","select",colors],["d3","Tercera cifra","rojo","","select",colors],["mult","Multiplicador","rojo","","select",mult],["tol","Tolerancia","dorado","","select",tol],["temp","Coeficiente térmico","marron","","select",[["marron","Marrón · 100 ppm/K"],["rojo","Rojo · 50 ppm/K"],["naranja","Naranja · 15 ppm/K"],["amarillo","Amarillo · 25 ppm/K"],["verde","Verde · 20 ppm/K"],["azul","Azul · 10 ppm/K"],["violeta","Violeta · 5 ppm/K"],["gris","Gris · 1 ppm/K"]]]]},led:{note:"Restamos la caída total de los LED a la fuente y dividimos por la corriente. Redondeamos a un valor comercial superior.",pill:"RESISTENCIA PARA LED",fields:[["vin","Tensión de fuente",5,"V","number"],["vf","Caída de cada LED",2,"V","number"],["current","Corriente",20,"mA","number"],["count","Cantidad de LED",1,"LED","number"],["connection","Conexión","series","","select",[["series","Serie"],["parallel","Paralelo"]]]]},equivalent:{note:"En serie se suman. En paralelo se suman inversas; el resultado debe ser menor que la resistencia más chica.",pill:"EQUIVALENTE",fields:[["mode","Conexión","series","","select",[["series","Serie"],["parallel","Paralelo"]]],["r1","R1",1000,"Ω","number"],["r2","R2",2200,"Ω","number"],["r3","R3 opcional",0,"Ω","number"],["r4","R4 opcional",0,"Ω","number"]]},divider:{note:"La salida se toma sobre R2. El divisor consume corriente todo el tiempo y no reemplaza un regulador.",pill:"DIVISOR DE TENSIÓN",fields:[["vin","Tensión de entrada",12,"V","number"],["r1","R1 · arriba",10000,"Ω","number"],["r2","R2 · abajo",10000,"Ω","number"]]}};
function field([id,label,value,unit,type,options]){let c=type==="select"?`<select id="${id}">${options.map(o=>`<option value="${o[0]}"${o[0]===value?" selected":""}>${o[1]}</option>`).join("")}</select>`:`<input id="${id}" type="number" step="any" value="${value}"><span>${unit}</span>`;return `<div class="field" id="field-${id}"><label for="${id}">${label}</label><div class="control">${c}</div></div>`}function row(k,v){return `<div class="row"><span>${k}</span><strong>${v}</strong></div>`}function fail(m){$("error").textContent=m;$("error").style.display="block";return false}
const digit={negro:0,marron:1,rojo:2,naranja:3,amarillo:4,verde:5,azul:6,violeta:7,gris:8,blanco:9},factor={negro:1,marron:10,rojo:100,naranja:1e3,amarillo:1e4,verde:1e5,azul:1e6,violeta:1e7,gris:1e8,blanco:1e9,dorado:.1,plateado:.01},tolerance={marron:1,rojo:2,verde:.5,azul:.25,violeta:.1,dorado:5,plateado:10},e12=[10,12,15,18,22,27,33,39,47,56,68,82];
function commercial(n){if(n<=0)return 0;const p=Math.pow(10,Math.floor(Math.log10(n))-1),scaled=n/p;return (e12.find(v=>v>=scaled)||100)*p}function paint(a,l,f,rows,insight){$("answer").textContent=a;$("answerLabel").textContent=l;$("formula").textContent=f;$("rows").innerHTML=rows;$("insight").innerHTML=insight}
function updateBands(){if(current!=="colors")return;const n=Number($("bands").value),d3=$("field-d3"),multF=$("field-mult"),temp=$("field-temp");d3.classList.toggle("hidden",n===4);temp.classList.toggle("hidden",n!==6);d3.querySelector("label").textContent="Tercera cifra";multF.querySelector("label").textContent=n===4?"Multiplicador · banda 3":"Multiplicador · banda 4"}
function calculate(){const inputs=[...$("fields").querySelectorAll("input")].map(i=>Number(i.value));if(inputs.some(v=>!Number.isFinite(v)||v<0))return fail("Revisá los valores: deben ser números válidos y no negativos.");$("error").style.display="none";
if(current==="colors"){const n=Number($("bands").value),base=n===4?digit[$("d1").value]*10+digit[$("d2").value]:digit[$("d1").value]*100+digit[$("d2").value]*10+digit[$("d3").value],value=base*factor[$("mult").value],t=tolerance[$("tol").value],min=value*(1-t/100),max=value*(1+t/100),tempMap={marron:100,rojo:50,naranja:15,amarillo:25,verde:20,azul:10,violeta:5,gris:1};paint(ohm(value),"valor nominal · ±"+dec(t,2)+"%",base+" × "+factor[$("mult").value]+" = "+value+" Ω",row("Valor nominal",ohm(value))+row("Tolerancia","±"+dec(t,2)+"%")+row("Valor mínimo",ohm(min))+row("Valor máximo",ohm(max))+(n===6?row("Coeficiente térmico",tempMap[$("temp").value]+" ppm/K"):"")+row("Cantidad de bandas",n),`<strong>El valor real puede estar entre ${ohm(min)} y ${ohm(max)}.</strong>Confirmalo con el multímetro antes de soldar.`)}
else if(current==="led"){const vin=num("vin"),vf=num("vf"),ma=num("current"),count=Math.round(num("count")),series=$("connection").value==="series",drop=series?vf*count:vf;if(count<1||ma<=0)return fail("La cantidad y la corriente deben ser mayores que cero.");if(vin<=drop)return fail("La fuente no supera la caída total de los LED.");const ideal=(vin-drop)/(ma/1000),chosen=commercial(ideal),actual=(vin-drop)/chosen*1000,power=(vin-drop)*(actual/1000),branches=series?1:count;paint(ohm(chosen),series?"una resistencia para la cadena":"una resistencia por cada rama","R = ("+vin+" − "+drop+") ÷ "+(ma/1000)+" = "+dec(ideal,1)+" Ω",row("Valor ideal",ohm(ideal))+row("Valor comercial E12",ohm(chosen))+row("Corriente real",dec(actual,1)+" mA")+row("Potencia por resistencia",dec(power*1000,0)+" mW")+row("Cantidad de resistencias",branches),`<strong>Usá ${ohm(chosen)} de ${power<=.125?"1/8 W":power<=.25?"1/4 W":power<=.5?"1/2 W":"1 W o más"}.</strong>El valor superior reduce la corriente y protege el LED.`)}
else if(current==="equivalent"){const rs=[num("r1"),num("r2"),num("r3"),num("r4")].filter(v=>v>0);if(rs.length<2)return fail("Ingresá al menos dos resistencias mayores que cero.");const series=$("mode").value==="series",req=series?rs.reduce((a,b)=>a+b,0):1/rs.reduce((a,b)=>a+1/b,0);paint(ohm(req),"resistencia equivalente en "+(series?"serie":"paralelo"),series?rs.map(ohm).join(" + "):"1 / ("+rs.map(r=>"1/"+r).join(" + ")+")",rs.map((r,i)=>row("R"+(i+1),ohm(r))).join("")+row("Equivalente",ohm(req)),`<strong>${series?"En serie, la equivalente es la suma.":"En paralelo, queda por debajo de "+ohm(Math.min(...rs))+"."}</strong>${series?"La corriente es la misma en todas.":"La resistencia menor conduce más corriente."}`)}
else{const vin=num("vin"),r1=num("r1"),r2=num("r2");if(r1<=0||r2<=0)return fail("R1 y R2 deben ser mayores que cero.");const vout=vin*r2/(r1+r2),amps=vin/(r1+r2),p1=amps*amps*r1,p2=amps*amps*r2;paint(dec(vout,3)+" V","tensión de salida sin carga","Vout = "+vin+" × "+r2+" ÷ ("+r1+" + "+r2+")",row("Vin",dec(vin,2)+" V")+row("R1",ohm(r1))+row("R2",ohm(r2))+row("Vout",dec(vout,3)+" V")+row("Corriente del divisor",dec(amps*1000,3)+" mA")+row("Potencia total",dec((p1+p2)*1000,2)+" mW"),`<strong>La salida es ${dec(vout/vin*100,1)}% de la entrada.</strong>No uses este divisor para alimentar una carga de consumo significativo.`)}}
function setCase(id){current=id;$$(".case").forEach(b=>b.classList.toggle("active",b.dataset.case===id));$("caseNote").textContent=cfg[id].note;$("pill").textContent=cfg[id].pill;$("fields").innerHTML=cfg[id].fields.map(field).join("");if(id==="colors"){$("bands").onchange=()=>{updateBands();calculate()};updateBands()}$$("#fields input").forEach(i=>i.onkeydown=e=>{if(e.key==="Enter")calculate()});calculate()}$$(".case").forEach(b=>b.onclick=()=>setCase(b.dataset.case));$("calculate").onclick=()=>{calculate();$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1100)};$("reset").onclick=()=>setCase("colors");$$(".faqQ").forEach(q=>q.onclick=()=>{const item=q.parentElement;item.classList.toggle("open");q.lastElementChild.textContent=item.classList.contains("open")?"−":"+"});setCase("colors");

})();
