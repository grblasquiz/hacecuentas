<div class="mockup-colombia-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Hacé Cuentas / Colombia</div><div class="heroGrid"><div><span class="eyebrow">Cuentas claras para Colombia</span><h1>Entendé tu plata. Decidí con números.</h1><p class="lead">Salario, prestaciones, impuestos, negocio y gastos del hogar con reglas colombianas, fuentes oficiales y explicaciones sin letra pequeña.</p><div class="trust"><span>✓ Normativa colombiana</span><span>✓ Datos DIAN y MinTrabajo</span><span>✓ Cálculos privados</span></div><div class="quick"><div><small>Salario mínimo 2026</small><b>$1.750.905</b></div><div><small>Auxilio transporte</small><b>$249.095</b></div><div><small>Total con auxilio</small><b>$2.000.000</b></div></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Cuánto recibís en mano?</h2><p>Estimación rápida para un empleado.</p></div><span class="tag">CÁLCULO EN VIVO</span></div><div class="fields"><div class="field wide"><label>Salario mensual</label><div class="input"><b>$</b><input id="salary" value="2500000"></div></div><div class="field"><label>Tipo de contrato</label><select id="contract"><option value="employee">Empleado dependiente</option><option value="independent">Independiente</option></select></div><div class="field"><label>Otros descuentos</label><div class="input"><b>$</b><input id="other" value="0"></div></div></div><div class="switchline"><span>Sumar auxilio de transporte si corresponde</span><button class="switch" id="transport"></button></div><button class="primary" id="calculate">Actualizar mi salario</button><div class="result"><small>NETO MENSUAL ESTIMADO</small><div class="amount" id="net">$2.300.000</div><div class="bars"><i id="netBar"></i><i id="contribBar"></i><i id="transportBar"></i></div><div class="resultGrid"><div class="metric"><span>SALUD + PENSIÓN</span><b id="contrib">− $200.000</b></div><div class="metric"><span>AUXILIO</span><b id="aid">+$0</b></div><div class="metric"><span>TE QUEDA</span><b id="ratio">92% del salario</b></div></div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por tu situación</span><h2>¿Qué necesitás resolver hoy?</h2><p>Elegí el problema y te mostramos primero las herramientas adecuadas.</p></div><div class="needs"><button class="need active" data-filter="trabajo"><span class="icon">$</span><h3>Mi salario y prestaciones</h3><p>Neto, extras, liquidación, cesantías y contratación.</p><em>→</em></button><button class="need" data-filter="impuestos"><span class="icon">%</span><h3>Mis impuestos</h3><p>Renta, retención en la fuente, NIT y obligaciones.</p><em>→</em></button><button class="need" data-filter="negocio"><span class="icon">▤</span><h3>Mi negocio</h3><p>Impuestos, contratación y costos de operación.</p><em>→</em></button><button class="need" data-filter="vida"><span class="icon">⌂</span><h3>Mi casa y mis cuentas</h3><p>Servicios, vivienda y presupuesto mensual.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas colombianas</span><h2>Todo lo importante, ordenado.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="trabajo">Trabajo</button><button class="filter" data-filter="impuestos">Impuestos</button><button class="filter" data-filter="negocio">Negocio</button><button class="filter" data-filter="vida">Vida diaria</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="trabajo" data-text="sueldo neto salud pensión auxilio salario"><span class="tagline">La más usada</span><h3>Calculadora de sueldo neto</h3><p>Descontá salud y pensión, aplicá auxilio y entendé cada componente del pago.</p><button>Calcular mi sueldo →</button></article><article class="card" data-cat="trabajo" data-text="liquidación laboral cesantías prima vacaciones indemnización"><span class="tagline">Derechos laborales</span><h3>Liquidación laboral</h3><p>Cesantías, intereses, prima, vacaciones e indemnización.</p><button>Calcular →</button></article><article class="card" data-cat="trabajo" data-text="horas extras recargos nocturno domingo festivo"><span class="tagline">Tiempo trabajado</span><h3>Horas extras y recargos</h3><p>Diurnas, nocturnas, dominicales y festivas con reglas vigentes.</p><button>Calcular →</button></article><article class="card" data-cat="impuestos" data-text="renta personas naturales dian tabla impuesto"><span class="tagline">DIAN</span><h3>Renta de personas naturales</h3><p>Ingresos, cédulas, deducciones y tabla progresiva en UVT.</p><button>Estimar renta →</button></article><article class="card" data-cat="impuestos negocio" data-text="retención fuente honorarios servicios compras"><span class="tagline">Retenciones</span><h3>Retención en la fuente</h3><p>Base, concepto, tarifa y monto a retener.</p><button>Calcular →</button></article><article class="card" data-cat="negocio" data-text="costo contratar empleado aportes prestaciones empleador"><span class="tagline">Empleadores</span><h3>Costo de contratar</h3><p>Salario más seguridad social, parafiscales y prestaciones.</p><button>Ver costo total →</button></article><article class="card" data-cat="impuestos negocio" data-text="validar nit dígito verificación dian"><span class="tagline">Empresas</span><h3>Validar NIT</h3><p>Calculá el dígito de verificación y revisá el formato.</p><button>Validar →</button></article><article class="card" data-cat="vida" data-text="recibos servicios luz agua gas hogar"><span class="tagline">Hogar</span><h3>Recibos de servicios</h3><p>Ordená consumos, cargos y variaciones mensuales.</p><button>Revisar recibos →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap"><div class="dataGrid"><article class="panel"><h3>Datos laborales 2026</h3><p>Referencias rápidas para entender los cálculos.</p><div class="line"><span>Salario mínimo legal mensual</span><b>$1.750.905</b></div><div class="line"><span>Auxilio de transporte</span><b>$249.095</b></div><div class="line"><span>Aporte empleado · salud</span><b>4%</b></div><div class="line"><span>Aporte empleado · pensión</span><b>4%</b></div></article><article class="panel dark"><h3>Fuentes colombianas</h3><p>Los datos y reglas se documentan con normas y organismos locales.</p><div class="line"><span>Impuestos y UVT</span><b>DIAN</b></div><div class="line"><span>Salario y trabajo</span><b>MinTrabajo</b></div><div class="line"><span>Inflación y estadísticas</span><b>DANE</b></div><div class="line"><span>Tasas y moneda</span><b>Banco de la República</b></div></article></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-colombia-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-colombia-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],num=id=>Math.max(0,Number($(id).value.replaceAll(".","").replaceAll(",",""))||0),money=n=>"$"+Math.round(n).toLocaleString("es-CO");let aidOn=true;
function calc(){const s=num("#salary"),other=num("#other"),employee=$("#contract").value==="employee",rate=employee?.08:.285,contrib=s*rate,eligible=employee&&s<=3501810&&aidOn,aid=eligible?249095:0,net=Math.max(0,s-contrib-other+aid),base=s+aid;$("#net").textContent=money(net);$("#contrib").textContent="− "+money(contrib);$("#aid").textContent="+"+money(aid);$("#ratio").textContent=Math.round(net/(base||1)*100)+"% del ingreso";$("#netBar").style.width=(net/(base||1)*100)+"%";$("#contribBar").style.width=(contrib/(base||1)*100)+"%";$("#transportBar").style.width=(aid/(base||1)*100)+"%"}
$$(".calc input,.calc select").forEach(x=>x.oninput=calc);$("#transport").onclick=e=>{aidOn=!aidOn;e.currentTarget.classList.toggle("off",!aidOn);calc()};$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Salario actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent="Abriendo: "+t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1600)}$$(".card button").forEach(b=>b.onclick=()=>toast(b.closest(".card").querySelector("h3").textContent));calc();

})();
</script>
<style is:global>

