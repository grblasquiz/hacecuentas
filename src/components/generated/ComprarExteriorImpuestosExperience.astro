{padding:76px 0;background:#fff}.mockup-comprar-exterior-impuestos .head{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:27px}.mockup-comprar-exterior-impuestos .head h2{font-size:38px;letter-spacing:-.04em;margin:8px 0 0}.mockup-comprar-exterior-impuestos .head p{max-width:490px;color:var(--muted);line-height:1.55;margin:0}.mockup-comprar-exterior-impuestos .cases{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-bottom:20px}.mockup-comprar-exterior-impuestos .case{min-height:105px;border:1px solid #d6dee6;border-radius:14px;background:#fafbfa;padding:13px;text-align:left;cursor:pointer;color:var(--ink)}.mockup-comprar-exterior-impuestos .case.active{border:2px solid var(--orange);padding:12px;background:#fff3ed}.mockup-comprar-exterior-impuestos .case-code{width:33px;height:29px;border-radius:8px;background:#e8eef0;display:grid!important;place-items:center;font-size:9px!important;font-weight:950}.mockup-comprar-exterior-impuestos .case.active .case-code{background:var(--orange);color:#fff}.mockup-comprar-exterior-impuestos .case b{display:block;font-size:11px;margin:8px 0 4px}.mockup-comprar-exterior-impuestos .case span{display:block;font-size:9px;color:#69768a;line-height:1.35}.mockup-comprar-exterior-impuestos .work{display:grid;grid-template-columns:1fr 1fr;gap:20px}.mockup-comprar-exterior-impuestos .panel{border:1px solid var(--line);border-radius:23px;padding:28px;background:#fff}.mockup-comprar-exterior-impuestos .case-note{background:#fff1ea;color:#754d3d;border-radius:13px;padding:14px 16px;font-size:13px;line-height:1.5;margin-bottom:20px}.mockup-comprar-exterior-impuestos .fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.mockup-comprar-exterior-impuestos .field label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:#59677b;font-weight:950;margin-bottom:8px}.mockup-comprar-exterior-impuestos .control{height:52px;border:1px solid #cad4dd;border-radius:12px;display: