---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-cuanto-vive-mascota" set:html={`<section class="hero"><div class="shell"><div class="crumb">Mascotas / Etapas de vida</div><h1>No es una cuenta regresiva. Es un mapa para cuidarlo mejor.</h1><p>Ubicá a tu perro o gato en su etapa de vida y anticipá los controles que ganan importancia con los años.</p><div class="setup"><label>Mascota<select id="species"><option value="dog">Perro</option><option value="cat">Gato</option></select></label><label id="sizeLabel">Tamaño esperado<select id="size"><option value="16">Pequeño</option><option value="13" selected>Mediano</option><option value="10">Grande</option><option value="8">Gigante</option></select></label><label>Edad actual<input id="age" type="number" min="0" max="30" step=".5" value="7"> años</label></div></div></section>
<section class="roadmap"><div class="shell"><div class="stagehead"><div><div style="color:var(--orange);font-weight:900;letter-spacing:.1em">SU MOMENTO ACTUAL</div><h2 id="stageTitle">Adulto maduro</h2></div><div class="agecard"><b id="range">10–14 años</b><span>rango poblacional orientativo</span></div></div><div class="track"><i class="pin" id="pin"></i></div><div class="labels" id="labels"></div>
<div class="care"><aside class="portrait"><div class="face"><i class="nose"></i></div><h3 id="equiv">Mitad aproximada del recorrido</h3><p>El tamaño, la genética, el ambiente y la atención veterinaria cambian mucho el resultado individual.</p></aside><section class="checkpoints"><h3>Próximos checkpoints de cuidado</h3><div id="checks"></div></section></div></div></section>
<section class="ethics"><div class="shell"><p><b>Una expectativa no predice una fecha.</b>Usamos rangos generales sólo para planificar prevención. Si notás pérdida de peso, sed excesiva, dolor, cambios de conducta o movilidad, no esperes al próximo hito: consultá.</p></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-cuanto-vive-mascota')?document.currentScript.previousElementSibling:document.querySelector('.mockup-cuanto-vive-mascota');

const $=id=>root.querySelector("#"+id);
const plans={young:[['Cada año','Chequeo clínico y vacunas según riesgo'],['Cada mes','Peso, dientes, piel y cambios de conducta'],['Siempre','Juego, movimiento y alimentación completa']],mature:[['Ahora','Análisis de base según criterio veterinario'],['Cada 6–12 meses','Chequeo, boca, corazón y condición corporal'],['En casa','Registrar apetito, sueño y movilidad']],senior:[['Cada 6 meses','Control geriátrico individualizado'],['Cada semana','Observar dolor, saltos, escaleras y aseo'],['Hoy','Adaptar superficies, accesos y descanso']]};
function render(){
 const cat=$('species').value==='cat', age=Math.max(0,+$('age').value||0), life=cat?16:+$('size').value;
 $('sizeLabel').style.display=cat?'none':'block'; $('range').textContent=cat?'12–18 años':`${Math.max(6,life-2)}–${life+2} años`;
 let stages,idx,key;
 if(cat){stages=[['Gatito','0–1 año'],['Adulto joven','1–6 años'],['Maduro','7–10 años'],['Senior','más de 10']];idx=age<1?0:age<7?1:age<11?2:3}
 else{const s=life*.25,m=life*.55,sen=life*.75;stages=[['Cachorro','crecimiento'],['Adulto joven','plenitud'],['Adulto maduro','transición'],['Senior','último 25% estimado']];idx=age<s?0:age<m?1:age<sen?2:3}
 key=idx<2?'young':idx===2?'mature':'senior'; $('stageTitle').textContent=stages[idx][0]; $('pin').style.left=Math.min(98,age/life*100)+'%';
 $('labels').innerHTML=stages.map((s,i)=>`<div class="${i===idx?'now':''}"><b>${s[0]}</b><span>${s[1]}</span></div>`).join('');
 $('equiv').textContent=idx===0?'Está formando sus hábitos':idx===1?'Etapa de mantenimiento':idx===2?'La prevención gana peso':'Confort y seguimiento cercano';
 $('checks').innerHTML=plans[key].map(x=>`<div class="check"><b>✓</b><div><strong>${x[0]}</strong><span>${x[1]}</span></div></div>`).join('');
}
root.querySelectorAll('input,select').forEach(x=>x.addEventListener('input',render));render();

})();
</script>
<style is:global>

.mockup-cuanto-vive-mascota{--blue:#174b7a;--ink:#1c2930;--muted:#617078;--line:#d8e2df;--green:#3a9a76;--orange:#e6854a;--cream:#fff5dc;--paper:#f5f8f6}.mockup-cuanto-vive-mascota *{box-sizing:border-box}.mockup-cuanto-vive-mascota{margin:0;font:15px/1.45 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-cuanto-vive-mascota button,.mockup-cuanto-vive-mascota input,.mockup-cuanto-vive-mascota select{font:inherit}.mockup-cuanto-vive-mascota .shell{max-width:1160px;margin:auto;padding:0 22px}.mockup-cuanto-vive-mascota .hero{background:#fff;border-bottom:1px solid var(--line);padding:36px 0}.mockup-cuanto-vive-mascota .crumb{color:var(--blue);font-weight:800}.mockup-cuanto-vive-mascota .hero h1{font-size:clamp(42px,6vw,70px);line-height:1;letter-spacing:-.05em;max-width:800px;margin:34px 0 16px}.mockup-cuanto-vive-mascota .hero p{font-size:19px;color:var(--muted);max-width:740px}.mockup-cuanto-vive-mascota .setup{margin-top:30px;display:flex;gap:12px;flex-wrap:wrap}.mockup-cuanto-vive-mascota .setup label{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:10px 14px;font-size:12px;font-weight:800}.mockup-cuanto-vive-mascota .setup select,.mockup-cuanto-vive-mascota .setup input{display:block;border:0;background:transparent;color:var(--ink);font-weight:900;padding-top:5px;min-width:150px}.mockup-cuanto-vive-mascota .roadmap{padding:48px 0}.mockup-cuanto-vive-mascota .stagehead{display:flex;justify-content:space-between;gap:20px;align-items:end}.mockup-cuanto-vive-mascota .stagehead h2{font-size:34px;margin:0}.mockup-cuanto-vive-mascota .agecard{background:var(--blue);color:#fff;border-radius:18px;padding:15px 20px;text-align:right}.mockup-cuanto-vive-mascota .agecard b{font-size:28px;display:block}.mockup-cuanto-vive-mascota .track{margin:48px 10px 20px;height:12px;border-radius:99px;background:linear-gradient(90deg,#7fd2b1 0 25%,#3a9a76 25% 55%,#efad58 55% 78%,#d36b58 78%);position:relative}.mockup-cuanto-vive-mascota .pin{position:absolute;left:0;top:50%;width:34px;height:34px;border-radius:50%;border:7px solid #fff;background:var(--blue);box-shadow:0 3px 12px #0003;transform:translate(-50%,-50%);transition:.3s}.mockup-cuanto-vive-mascota .labels{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.mockup-cuanto-vive-mascota .labels div{padding:15px;border-radius:14px;background:#fff;border:1px solid var(--line)}.mockup-cuanto-vive-mascota .labels b{display:block}.mockup-cuanto-vive-mascota .labels span{font-size:12px;color:var(--muted)}.mockup-cuanto-vive-mascota .now{outline:3px solid var(--orange)}.mockup-cuanto-vive-mascota .care{display:grid;grid-template-columns:.75fr 1.25fr;gap:25px;margin:35px 0 55px}.mockup-cuanto-vive-mascota .portrait{background:var(--cream);border-radius:28px;padding:30px;display:grid;place-items:center;text-align:center}.mockup-cuanto-vive-mascota .portrait .face{width:150px;height:150px;border-radius:50%;background:var(--orange);position:relative}.mockup-cuanto-vive-mascota .face:before,.mockup-cuanto-vive-mascota .face:after{content:"";position:absolute;top:55px;width:14px;height:14px;background:var(--ink);border-radius:50%}.mockup-cuanto-vive-mascota .face:before{left:42px}.mockup-cuanto-vive-mascota .face:after{right:42px}.mockup-cuanto-vive-mascota .nose{position:absolute;left:64px;top:82px;width:23px;height:17px;border-radius:50%;background:var(--ink)}.mockup-cuanto-vive-mascota .portrait h3{font-size:25px;margin:20px 0 5px}.mockup-cuanto-vive-mascota .portrait p{color:var(--muted);margin:0}.mockup-cuanto-vive-mascota .checkpoints{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px}.mockup-cuanto-vive-mascota .checkpoints h3{font-size:25px;margin:0 0 20px}.mockup-cuanto-vive-mascota .check{display:grid;grid-template-columns:54px 1fr;gap:15px;padding:16px 0;border-top:1px solid var(--line)}.mockup-cuanto-vive-mascota .check:first-of-type{border:0}.mockup-cuanto-vive-mascota .check b:first-child{width:45px;height:45px;border-radius:50%;background:#e2f1eb;color:#1c684f;display:grid;place-items:center}.mockup-cuanto-vive-mascota .check strong{display:block}.mockup-cuanto-vive-mascota .check span{color:var(--muted)}.mockup-cuanto-vive-mascota .ethics{background:var(--blue);color:#fff;padding:35px 0}.mockup-cuanto-vive-mascota .ethics p{max-width:850px;font-size:17px;margin:0}.mockup-cuanto-vive-mascota .ethics b{display:block;font-size:22px;margin-bottom:7px}@media(max-width:750px){.mockup-cuanto-vive-mascota .care{grid-template-columns:1fr}.mockup-cuanto-vive-mascota .stagehead{align-items:start;flex-direction:column}.mockup-cuanto-vive-mascota .labels{grid-template-columns:1fr 1fr}.mockup-cuanto-vive-mascota .setup label{flex:1}.mockup-cuanto-vive-mascota .hero h1{font-size:46px}}
.mockup-cuanto-vive-mascota { width:100%; overflow:hidden; }
.mockup-cuanto-vive-mascota .top, .mockup-cuanto-vive-mascota header.top { display:none !important; }
.mockup-cuanto-vive-mascota .foot { display:none !important; }
.mockup-cuanto-vive-mascota .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-cuanto-vive-mascota .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-cuanto-vive-mascota .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-cuanto-vive-mascota .support-real summary { cursor:pointer; font-weight:750; }
.mockup-cuanto-vive-mascota .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-cuanto-vive-mascota :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-cuanto-vive-mascota input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-cuanto-vive-mascota input[type="number"]::-webkit-inner-spin-button, .mockup-cuanto-vive-mascota input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-cuanto-vive-mascota .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <section class="mockup-cuanto-vive-mascota support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>}
