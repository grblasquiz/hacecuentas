.mockup-porciones-cocina *{box-sizing:border-box}.mockup-porciones-cocina{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fcfdfb}.mockup-porciones-cocina button,.mockup-porciones-cocina input,.mockup-porciones-cocina select{font:inherit}.mockup-porciones-cocina .head{height:74px;padding:0 max(24px,calc((100% - 1180px)/2));display:flex;align-items:center;justify-content:space-between;background:white;border-bottom:1px solid var(--line)}.mockup-porciones-cocina .brand{font-size:19px;font-weight:900}.mockup-porciones-cocina .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:10px;background:var(--blue);color:white}.mockup-porciones-cocina .nav{display:flex;gap:28px;color:#505c69;font-weight:750;font-size:14px}.mockup-porciones-cocina .search{border:1px solid var(--line);background:white;border-radius:11px;padding:10px 15px}
.mockup-porciones-cocina .hero{padding:54px 24px 62px;background:linear-gradient(115deg,#f8fbf8 0 65%,#fce9df 65%)}.mockup-porciones-cocina .heroin{max-width:1180px;margin:auto;display:grid;grid-template-columns:1.05fr .95fr;gap:55px;align-items:center}.mockup-porciones-cocina .crumb{color:var(--blue);font-size:14px;font-weight:850}.mockup-porciones-cocina .eyebrow{margin-top:27px;text-transform:uppercase;letter-spacing:.14em;color:var(--tomato);font-size:12px;font-weight:900}.mockup-porciones-cocina .hero h1{font-size:clamp(43px,5vw,68px);line-height:.98;letter-spacing:-.05em;margin:10px 0 20px;max-width:690px}.mockup-porciones-cocina .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-porciones-cocina .pills{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-porciones-cocina .pills span{padding:8px 12px;border-radius:999px;border:1px solid var(--line);background:white;font-size:13px;font-weight:800}
.mockup-porciones-cocina .scene{min-height:335px;position:relative}.mockup-porciones-cocina .table{position:absolute;left:5%;right:5%;bottom:8px;height:105px;border-radius:20px;background:#d39b68;transform:skewX(-4deg);box-shadow:0 24px 45px #7c4e2729}.mockup-porciones-cocina .pot{position:absolute;width:290px;height:180px;left:50%;bottom:65px;transform:translateX(-50%);background:linear-gradient(90deg,#174b7a,#4a8ba7 50%,#174b7a);border-radius:18px 18px 105px 105px;box-shadow:0 25px 32px #293b4835}.mockup-porciones-cocina .pot:before,.mockup-porciones-cocina .pot:after{content:"";position:absolute;top:33px;width:83px;height:25px;background:var(--blue);border-radius:20px}.mockup-porciones-cocina .pot:before{left:-67px}.mockup-porciones-cocina .pot:after{right:-67px}.mockup-porciones-cocina .rim{position:absolute;left:13px;right:13px;top:-27px;height:60px;border-radius:50%;background:#eef6f6;border:10px solid var(--blue)}.mockup-porciones-cocina .food{position:absolute;left:28px;right:28px;top:-12px;height:40px;border-radius:50%;background:repeating-radial-gradient(ellipse at 55% 80%,#f6db7e 0 5px,#d9a73b 6px 9px)}.mockup-porciones-cocina .steam{position:absolute;width:18px;height:85px;border-left:5px solid #ffffffaa;border-radius:50%;top:-105px}.mockup-porciones-cocina .s1{left:93px;transform:rotate(-10deg)}.mockup-porciones-cocina .s2{left:145px;height:105px}.mockup-porciones-cocina .s3{left:195px;transform:rotate(12deg)}.mockup-porciones-cocina .pack{position:absolute;right:1%;top:23px;width:126px;height:165px;background:var(--tomato);border-radius:11px 11px 16px 16px;transform:rotate(6deg);box-shadow:0 17px 30px #6a302328;color:white;text-align:center;padding-top:22px}.mockup-porciones-cocina .pack:before{content:"";position:absolute;inset:12px;border:2px solid #ffffff77;border-radius:8px}.mockup-porciones-cocina .pack strong{position:relative;display:block;font-size:31px}.mockup-porciones-cocina .pack small{position:relative;font-weight:800}.mockup-porciones-cocina .bubble{position:absolute;left:1%;top:28px;background:white;border:1px solid var(--line);border-radius:14px;padding:12px 15px;box-shadow:0 12px 26px #26435416}.mockup-porciones-cocina .bubble small{display:block;color:var(--muted)}.mockup-porciones-cocina .bubble strong{font-size:20px;color:var(--tomato)}
.mockup-porciones-cocina .tool{padding:64px 24px}.mockup-porciones-cocina .wrap{max-width:1180px;margin:auto}.mockup-porciones-cocina .sectionhead{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:23px}.mockup-porciones-cocina .kicker{text-transform:uppercase;letter-spacing:.14em;color:var(--tomato);font-size:12px;font-weight:900}.mockup-porciones-cocina .sectionhead h2,.mockup-porciones-cocina .guide h2,.mockup-porciones-cocina .faq h2{font-size:37px;letter-spacing:-.04em;margin:8px 0}.mockup-porciones-cocina .sectionhead p{max-width:510px;color:var(--muted);margin:0}.mockup-porciones-cocina .choice-groups{display:grid;grid-template-columns:3fr 4fr;gap:14px;margin-bottom:23px}.mockup-porciones-cocina .choice-group{padding:13px;border:1px solid var(--line);border-radius:20px;background:#f9fbfa}.mockup-porciones-cocina .group-title{font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;margin:2px 5px 10px;color:var(--muted)}.mockup-porciones-cocina .choices{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mockup-porciones-cocina .choice-group:last-child .choices{grid-template-columns:repeat(4,1fr)}.mockup-porciones-cocina .case{min-height:92px;padding:13px;text-align:left;border:1px solid var(--line);border-radius:13px;background:white;color:var(--ink);cursor:pointer}.mockup-porciones-cocina .case strong{display:block;font-size:14px;margin-bottom:3px}.mockup-porciones-cocina .case small{font-size:12px;color:var(--muted)}.mockup-porciones-cocina .case.active{background:var(--cream);border:2px solid var(--tomato);padding:12px;box-shadow:0 8px 18px #a3473513}
.mockup-porciones-cocina .workspace{display:grid;grid-template-columns:.83fr 1.17fr;gap:20px}.mockup-porciones-cocina .panel{padding:28px;border-radius:24px}.mockup-porciones-cocina .form{background:white;border:1px solid var(--line);box-shadow:0 16px 40px #233b350c}.mockup-porciones-cocina .panel h3{font-size:21px;margin:0 0 5px}.mockup-porciones-cocina .sub{color:var(--muted);font-size:14px;margin:0 0 22px}.mockup-porciones-cocina .people{display:grid;grid-template-columns:1fr 1fr;gap:14px}.mockup-porciones-cocina .field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-porciones-cocina .field small{display:block;color:var(--muted);font-size:12px;margin-top:6px}.mockup-porciones-cocina input,.mockup-porciones-cocina select{width:100%;min-height:50px;border:1px solid #d3dbd8;border-radius:12px;background:white;padding:12px 14px;color:var(--ink)}.mockup-porciones-cocina .stepper{display:grid;grid-template-columns:48px 1fr 48px}.mockup-porciones-cocina .stepper input{border-radius:0;text-align:center;font-weight:900}.mockup-porciones-cocina .stepper button{border:1px solid #d3dbd8;background:#f7faf8;color:var(--blue);font-size:22px;font-weight:900;cursor:pointer}.mockup-porciones-cocina .stepper button:first-child{border-radius:12px 0 0 12px}.mockup-porciones-cocina .stepper button:last-child{border-radius:0 12px 12px 0}.mockup-porciones-cocina .detail{margin-top:17px}.mockup-porciones-cocina .actions{display:flex;gap:10px;margin-top:22px}.mockup-porciones-cocina .primary{flex:1;border:0;border-radius:12px;padding:14px;background:var(--blue);color:white;font-weight:900;cursor:pointer}.mockup-porciones-cocina .reset{border:1px solid var(--tomato);border-radius:12px;background:white;color:#7d392d;padding:13px 17px;font-weight:850;cursor:pointer}
.mockup-porciones-cocina .result{background:linear-gradient(140deg,var(--blue),var(--blue2));color:white;position:relative;overflow:hidden}.mockup-porciones-cocina .result:after{content:"";position:absolute;width:250px;height:250px;border:45px solid #ffffff0b;border-radius:50%;right:-130px;bottom:-120px}.mockup-porciones-cocina .result-top{display:flex;justify-content:space-between;align-items:start}.mockup-porciones-cocina .badge{background:var(--mint);color:#174f40;border-radius:999px;padding:7px 10px;font-size:12px;font-weight:900}.mockup-porciones-cocina .big{font-size:53px;font-weight:950;letter-spacing:-.05em;line-height:1;margin:14px 0 3px}.mockup-porciones-cocina .biglabel{color:#d9ebf2;font-size:14px}.mockup-porciones-cocina .shopping{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:23px 0}.mockup-porciones-cocina .item{padding:14px 11px;border-radius:14px;border:1px solid #ffffff2c;background:#ffffff0e;position:relative;z-index:1}.mockup-porciones-cocina .item small{display:block;color:#dcebf1;font-size:11px}.mockup-porciones-cocina .item strong{font-size:17px}.mockup-porciones-cocina .package{position:relative;z-index:1;border-radius:15px;background:#ffffff0f;border:1px solid #ffffff26;padding:16px;display:flex;gap:15px;align-items:center}.mockup-porciones-cocina .package-icon{display:grid;place-items:center;min-width:48px;height:60px;border-radius:8px;background:var(--tomato);font-weight:950}.mockup-porciones-cocina .package strong{display:block}.mockup-porciones-cocina .package p{margin:2px 0 0;color:#dcebf1;font-size:13px}.mockup-porciones-cocina .tip{position:relative;z-index:1;margin-top:16px;padding:13px 15px;background:var(--cream);color:#594a2f;border-radius:12px;font-size:13px;font-weight:750}
.mockup-porciones-cocina .guide{padding:70px 24px;background:#f2f7f4}.mockup-porciones-cocina .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:44px}.mockup-porciones-cocina .guide p{color:var(--muted)}.mockup-porciones-cocina .rules{display:grid;grid-template-columns:1fr 1fr;gap:12px}.mockup-porciones-cocina .rule{background:white;border:1px solid var(--line);border-radius:16px;padding:18px}.mockup-porciones-cocina .rule b{display:block;color:var(--green);margin-bottom:5px}.mockup-porciones-cocina .rule span{font-size:14px;color:var(--muted)}.mockup-porciones-cocina .faq{padding:70px 24px}.mockup-porciones-cocina .faq-item{border-top:1px solid var(--line)}.mockup-porciones-cocina .faq-q{width:100%;display:flex;justify-content:space-between;padding:18px 0;border:0;background:none;text-align:left;color:var(--ink);font-weight:850;cursor:pointer}.mockup-porciones-cocina .faq-a{display:none;max-width:820px;padding:0 0 20px;color:var(--muted)}.mockup-porciones-cocina .faq-item.open .faq-a{display:block}.mockup-porciones-cocina .foot{padding:30px;text-align:center;border-top:1px solid var(--line);background:white;color:var(--muted)}
@media(max-width:900px){.mockup-porciones-cocina .nav{display:none}.mockup-porciones-cocina .heroin,.mockup-porciones-cocina .workspace,.mockup-porciones-cocina .guide-grid,.mockup-porciones-cocina .choice-groups{grid-template-columns:1fr}.mockup-porciones-cocina .scene{min-height:320px}.mockup-porciones-cocina .sectionhead{flex-direction:column;align-items:start}}@media(max-width:600px){.mockup-porciones-cocina .choices,.mockup-porciones-cocina .choice-group:last-child .choices,.mockup-porciones-cocina .people,.mockup-porciones-cocina .rules,.mockup-porciones-cocina .shopping{grid-template-columns:1fr 1fr}.mockup-porciones-cocina .hero h1{font-size:44px}.mockup-porciones-cocina .pot{width:250px}.mockup-porciones-cocina .pack{right:-8%}.mockup-porciones-cocina .actions{flex-direction:column}}@media(max-width:400px){.mockup-porciones-cocina .choices,.mockup-porciones-cocina .choice-group:last-child .choices,.mockup-porciones-cocina .people,.mockup-porciones-cocina .rules{grid-template-columns:1fr}}

