---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-ph-equilibrio" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Ciencia / pH y equilibrio químico</div><div class="eyebrow">Laboratorio ácido–base</div><h1>No adivines el pH. Mirá el equilibrio.</h1><p class="lead">Calculá pH, pOH y concentración, y observá dónde cae la solución en una escala que se entiende.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art ph"><div class="tube"><i></i></div><div class="phscale"><span>0</span><span>2</span><span>4</span><span>6</span><span>8</span><span>10</span><span>12</span><span>14</span></div></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">laboratorio interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="kind">Qué querés calcular</label><select id="kind"><option value="acid">Ácido fuerte</option><option value="base">Base fuerte</option><option value="ph">Partir de un pH</option></select></div><div class="field"><label for="concentration">Concentración (mol/L)</label><input id="concentration" type="number" value="0.01" min="0.0000001" max="10" step="0.0001"></div><div class="field"><label for="volume">Volumen de solución (ml)</label><input id="volume" type="number" value="500" min="1" max="10000" step="1"></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-ph-equilibrio')?document.currentScript.previousElementSibling:document.querySelector('.mockup-ph-equilibrio');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const kind=v("kind"),c=Math.max(1e-14,vn("concentration"));let ph=kind==="acid"?-Math.log10(c):kind==="base"?14+Math.log10(c):Math.min(14,Math.max(0,c));let poh=14-ph,h=Math.pow(10,-ph);return {big:ph.toFixed(2).replace(".",","),label:"pH estimado",badge:ph<6.5?"Solución ácida":ph>7.5?"Solución básica":"Zona neutra",metrics:[["pOH",poh.toFixed(2)],["[H⁺]",h.toExponential(2)+" M"],["Volumen",vn("volume")+" ml"]],position:ph/14*100,note:ph<3?"Es una acidez alta. Para diluciones reales, agregá siempre ácido sobre agua y usá protección.":ph>11?"Es una basicidad alta. La concentración cambia diez veces por cada unidad de pH.":"La escala es logarítmica: una unidad de pH implica un factor diez."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"kind":"acid","concentration":"0.01","volume":"500"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
<style is:global>

