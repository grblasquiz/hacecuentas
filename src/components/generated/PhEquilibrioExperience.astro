o .art{height:330px;border:1px solid color-mix(in srgb,var(--accent),#fff 62%);background:#fff;border-radius:50% 50% 24px 24px;box-shadow:0 24px 50px #17374a18;position:relative;overflow:hidden;display:grid;place-items:center}.mockup-ph-equilibrio .phscale{position:absolute;left:12%;right:12%;bottom:38px;height:24px;border-radius:99px;background:linear-gradient(90deg,#d4424d,#ea943a,#eadf55,#58ad67,#3c83b8,#7251a2);display:flex;justify-content:space-between;padding:30px 0 0;font-size:10px;font-weight:850}.mockup-ph-equilibrio .tube{width:65px;height:170px;border:6px solid var(--blue);border-top:0;border-radius:0 0 35px 35px;position:absolute;top:40px}.mockup-ph-equilibrio .tube i{position:absolute;left:0;right:0;bottom:0;height:62%;background:var(--accent);border-radius:0 0 27px 27px}.mockup-ph-equilibrio .orbit:before,.mockup-ph-equilibrio .orbit:after{content:"";position:absolute;border:1px solid #6684ad66;border-radius:50%}.mockup-ph-equilibrio .orbit:before{width:210px;height:210px}.mockup-ph-equilibrio .orbit:after{width:300px;height:300px}.mockup-ph-equilibrio .sun{width:65px;height:65px;background:#f1bd48;border-radius:50%;box-shadow:0 0 35px #e9a52a99}.mockup-ph-equilibrio .planet{position:absolute;border-radius:50%;background:var(--accent)}.mockup-ph-equilibrio .p1{width:20px;height:20px;left:28%;top:29%}.mockup-ph-equilibrio .p2{width:30px;height:30px;right:18%;top:45%}.mockup-ph-equilibrio .p3{width:25px;height:25px;left:32%;bottom:13%}.mockup-ph-equilibrio .ship{position:absolute;right:26%;top:25%;font-size:38px;color:var(--blue);transform:rotate(-25deg)}.mockup-ph-equilibrio .moon .earth{width:130px;height:130px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#7ec9a4 0 20%,#3987af 22% 100%)}.mockup-ph-equilibrio .moon .luna{position:absolute;width:62px;height:62px;border-radius:50%;right:16%;top:20%;background:#eee6cf;box-shadow:inset -18px 3px #aaa49a}.mockup-ph-equilibrio .tide{position:absolute;left:12%;right:12%;bottom:34px;height:35px;background:repeating-radial-gradient(ellipse at 20px 30px,#3994b9 0 12px,transparent 13px 25px)}.mockup-ph-equilibrio .coffee .cup{font-size:110px}.mockup-ph-equilibrio .steam{position:absolute;top:50px;width:18px;height:80px;border-left:5px solid var(--accent);border-radius:50%}.mockup-ph-equilibrio .s1{left:43%}.mockup-ph-equilibrio .s2{left:55%;top:65px}.mockup-ph-equilibrio .beer .glass{width:130px;height:205px;border:7px solid var(--blue);border-top-width:12px;border-radius:12px 12px 35px 35px;position:relative;overflow:hidden}.mockup-ph-equilibrio .beer .glass i{position:absolute;inset:35px 0 0;background:#e5a63f}.mockup-ph-equilibrio .beer .glass b{position:absolute;left:0;right:0;top:18px;height:38px;background:#fff4d5;border-radius:50%;z-index:2}.mockup-ph-equilibrio .beer>span{position:absolute;bottom:20px;font-weight:950;color:var(--blue)}.mockup-ph-equilibrio .cup{grid-template-columns:1fr auto 1fr;gap:18px}.mockup-ph-equilibrio .measurecup{width:125px;height:155px;border:6px solid var(--blue);border-radius:10px 10px 35px 35px;position:relative}.mockup-ph-equilibrio .measurecup i{position:absolute;inset:45% 0 0;background:var(--accent)}.mockup-ph-equilibrio .measurecup b{position:absolute;top:18px;left:0;right:0;text-align:center;font-size:12px}.mockup-ph-equilibrio .cup>span{font-size:45px;color:var(--accent)}.mockup-ph-equilibrio .weight{padding:25px 18px;background:var(--soft);border-radius:18px;font-size:25px;font-weight:950}.mockup-ph-equilibrio .wall{display:flex;width:240px;height:210px;border:8px solid var(--blue)}.mockup-ph-equilibrio .wall i{flex:1;border-right:2px solid #fff;background:repeating-linear-gradient(45deg,var(--accent) 0 8px,var(--soft) 9px 17px)}.mockup-ph-equilibrio .cold,.mockup-ph-equilibrio .warm{position:absolute;font-size:25px;font-weight:950}.mockup-ph-equilibrio .cold{left:18px;color:#3182a0}.mockup-ph-equilibrio .warm{right:18px;color:#c26734}.mockup-ph-equilibrio .dial{width:215px;height:215px;border-radius:50%;border:18px solid var(--blue);display:grid;place-items:center;position:relative}.mockup-ph-equilibrio .dial i{position:absolute;width:7px;height:75px;background:var(--accent);bottom:50%;transform-origin:bottom;transform:rotate(35deg)}.mockup-ph-equilibrio .dial b{font-size:52px;margin-top:30px}.mockup-ph-equilibrio .dial small{position:absolute;bottom:38px}.mockup-ph-equilibrio .clockface{width:210px;height:210px;border:12px solid var(--blue);border-radius:50%;position:relative}.mockup-ph-equilibrio .clockface i,.mockup-ph-equilibrio .clockface b{position:absolute;left:50%;bottom:50%;width:7px;background:var(--accent);transform-origin:bottom}.mockup-ph-equilibrio .clockface i{height:72px;transform:rotate(90deg)}.mockup-ph-equilibrio .clockface b{height:55px;transform:rotate(10deg)}.mockup-ph-equilibrio .clock>span{position:absolute;bottom:24px;font-size:23px;font-weight:950}.mockup-ph-equilibrio .drop i{width:150px;height:190px;background:var(--accent);border-radius:70% 30% 70% 30%;transform:rotate(45deg)}.mockup-ph-equilibrio .drop span{position:absolute;color:#fff;font-size:32px;font-weight:950}.mockup-ph-equilibrio .bubble{position:absolute;padding:18px 24px;border-radius:24px;background:var(--soft);border:2px solid var(--accent);font-weight:950;font-size:23px}.mockup-ph-equilibrio .bubble.a{left:9%;top:20%}.mockup-ph-equilibrio .bubble.b{right:9%;top:34%}.mockup-ph-equilibrio .bubble.c{left:28%;bottom:16%}.mockup-ph-equilibrio .pages{width:240px;height:175px;display:flex;perspective:500px}.mockup-ph-equilibrio .pages i{width:50%;background:#fff;border:6px solid var(--blue)}.mockup-ph-equilibrio .pages i:first-child{transform:rotateY(14deg)}.mockup-ph-equilibrio .pages i:last-child{transform:rotateY(-14deg)}.mockup-ph-equilibrio .book>span{position:absolute;bottom:27px;font-weight:950;color:var(--accent)}.mockup-ph-equilibrio .sheet{width:180px;height:230px;border:5px solid var(--blue);background:#fff;border-radius:12px;padding:25px}.mockup-ph-equilibrio .sheet b{font-size:55px;color:var(--accent)}.mockup-ph-equilibrio .sheet i{display:block;border-top:6px solid #cbd7db;margin-top:17px}.mockup-ph-equilibrio .timer{position:absolute;right:22px;bottom:24px;padding:12px;background:var(--blue);color:#fff;border-radius:10px;font-weight:950}.mockup-ph-equilibrio .target{width:220px;height:220px;border:24px solid var(--accent);border-radius:50%;box-shadow:inset 0 0 0 26px #fff,inset 0 0 0 48px var(--blue);display:grid;place-items:center}.mockup-ph-equilibrio .target b{font-size:44px;background:#fff;border-radius:50%;padding:18px}.mockup-ph-equilibrio .parrilla{width:245px;height:160px;border:10px solid var(--blue);border-radius:18px;display:flex;gap:12px;padding:28px}.mockup-ph-equilibrio .parrilla i{flex:1;border-radius:30px;background:var(--accent)}.mockup-ph-equilibrio .fire{position:absolute;bottom:12px;font-size:60px;color:#e78a35}.mockup-ph-equilibrio .timeline .line{position:absolute;left:12%;right:12%;top:50%;height:8px;background:var(--blue);display:flex;justify-content:space-between}.mockup-ph-equilibrio .timeline .line i{width:29px;height:29px;border:7px solid var(--blue);background:#fff;border-radius:50%;transform:translateY(-11px)}.mockup-ph-equilibrio .truck{position:absolute;left:30%;top:38%;font-size:50px;color:var(--accent)}.mockup-ph-equilibrio .donut{width:220px;height:220px;border-radius:50%;background:conic-gradient(var(--accent) 0 40%,#e7af53 40% 65%,#4d98a1 65% 80%,#dce4e4 80%);position:relative}.mockup-ph-equilibrio .donut:after{content:"";position:absolute;inset:55px;background:#fff;border-radius:50%}.mockup-ph-equilibrio .budget>span{position:absolute;font-size:50px;font-weight:950;color:var(--blue)}
.mockup-ph-equilibrio .tool{padding:62px 22px}.mockup-ph-equilibrio .tool-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.mockup-ph-equilibrio .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-ph-equilibrio .tool h2,.mockup-ph-equilibrio .guide h2{font-size:37px;letter-spacing:-.04em;margin:7px 0}.mockup-ph-equilibrio .tool-head p{max-width:510px;color:var(--muted);margin:0}.mockup-ph-equilibrio .workspace{display:grid;grid-template-columns:.88fr 1.12fr;gap:20px}.mockup-ph-equilibrio .panel{border-radius:24px;padding:27px}.mockup-ph-equilibrio .form{border:1px solid var(--line);box-shadow:0 16px 40px #18374a0c}.mockup-ph-equilibrio .panel h3{font-size:21px;margin:0 0 5px}.mockup-ph-equilibrio .hint{color:var(--muted);font-size:14px;margin:0 0 20px}.mockup-ph-equilibrio .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-ph-equilibrio .field{margin-bottom:2px}.mockup-ph-equilibrio .field label{display:flex;justify-content:space-between;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-ph-equilibrio .field output{color:var(--accent)}.mockup-ph-equilibrio input,.mockup-ph-equilibrio select{width:100%;min-height:49px;border:1px solid #ccd7da;border-radius:12px;background:#fff;padding:12px 14px;color:var(--ink)}.mockup-ph-equilibrio input[type=range]{padding:0;accent-color:var(--accent)}.mockup-ph-equilibrio .actions{display:flex;gap:9px;margin-top:21px}.mockup-ph-equilibrio .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:14px;font-weight:900;cursor:pointer}.mockup-ph-equilibrio .reset{border:1px solid #d7aa58;border-radius:12px;background:#fff;color:#654a1f;padding:13px 16px;font-weight:850;cursor:pointer}.mockup-ph-equilibrio .result{background:linear-gradient(145deg,var(--blue),color-mix(in srgb,var(--blue),var(--accent) 35%));color:#fff;position:relative;overflow:hidden}.mockup-ph-equilibrio .badge{display:inline-block;padding:7px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:950}.mockup-ph-equilibrio .big{font-size:48px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:14px 0 5px}.mockup-ph-equilibrio .caption{color:#dceaf0;font-size:14px}.mockup-ph-equilibrio .meter{height:13px;border-radius:99px;background:#ffffff2d;margin:24px 0;position:relative}.mockup-ph-equilibrio .meter i{position:absolute;left:var(--position);top:50%;width:24px;height:24px;border:5px solid #fff;background:var(--accent);border-radius:50%;transform:translate(-50%,-50%);transition:.25s}.mockup-ph-equilibrio .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.mockup-ph-equilibrio .metric{padding:13px;border:1px solid #ffffff2b;background:#ffffff0e;border-radius:13px}.mockup-ph-equilibrio .metric small{display:block;color:#dceaf0;font-size:10px}.mockup-ph-equilibrio .metric b{font-size:16px}.mockup-ph-equilibrio .note{margin-top:17px;padding:14px 15px;border-radius:12px;background:var(--cream);color:#58461f;font-size:13px}.mockup-ph-equilibrio .guide{padding:65px 22px;background:var(--paper)}.mockup-ph-equilibrio .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px}.mockup-ph-equilibrio .guide p{color:var(--muted)}.mockup-ph-equilibrio .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.mockup-ph-equilibrio .step{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff}.mockup-ph-equilibrio .step b{display:block;color:var(--accent);margin-bottom:5px}.mockup-ph-equilibrio .step span{font-size:14px;color:var(--muted)}.mockup-ph-equilibrio .foot{padding:30px;text-align:center;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-ph-equilibrio .nav{display:none}.mockup-ph-equilibrio .hero-grid,.mockup-ph-equilibrio .workspace,.mockup-ph-equilibrio .guide-grid{grid-template-columns:1fr}.mockup-ph-equilibrio .tool-head{flex-direction:column;align-items:start}}@media(max-width:550px){.mockup-ph-equilibrio .fields,.mockup-ph-equilibrio .metrics,.mockup-ph-equilibrio .steps{grid-template-columns:1fr}.mockup-ph-equilibrio .hero h1{font-size:43px}.mockup-ph-equilibrio .actions{flex-direction:column}.mockup-ph-equilibrio .art{height:290px}}

.mockup-ph-equilibrio { width:100%; overflow:hidden; }
.mockup-ph-equilibrio .top, .mockup-ph-equilibrio header.top { display:none !important; }
.mockup-ph-equilibrio .foot { display:none !important; }
.mockup-ph-equilibrio .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-ph-equilibrio .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-ph-equilibrio .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-ph-equilibrio .support-real summary { cursor:pointer; font-weight:750; }
.mockup-ph-equilibrio .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-ph-equilibrio :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-ph-equilibrio input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-ph-equilibrio input[type="number"]::-webkit-inner-spin-button, .mockup-ph-equilibrio input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-ph-equilibrio .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-ph-equilibrio support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
