---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-tabla-renta-colombia" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><b>Colombia</b> / Impuestos / Tabla de renta 2026</div><div class="hero-grid"><div><div class="eyebrow">Art. 241 ET · UVT 2026</div><h1>Tu renta no se grava toda a la misma tarifa.</h1><p class="lead">Convertí tu renta líquida anual a UVT, ubicá el tramo correcto y entendé cuánto pagarías realmente.</p><div class="chips"><span>✓ Tabla marginal completa</span><span>✓ UVT 2026: $52.374</span><span>✓ Tarifa efectiva</span></div></div>
<section class="calc"><div class="calc-head"><div><h2>Calculá el impuesto</h2><p>Ingresá la renta líquida gravable anual.</p></div><span class="tag">Año gravable 2026</span></div><div class="label">Tu base gravable</div><div class="field"><label>Renta líquida anual (COP)</label><div class="money"><b>$</b><input id="base" inputmode="decimal" value="100000000"></div></div><div class="presets"><button class="preset" data-value="50000000">$50 millones</button><button class="preset active" data-value="100000000">$100 millones</button><button class="preset" data-value="250000000">$250 millones</button><button class="preset" data-value="500000000">$500 millones</button></div><div class="scale-wrap"><div class="scale-labels"><span>0%</span><span>19%</span><span>28%</span><span>33%</span><span>35–39%</span></div><div class="scale"><i class="marker" id="marker"></i></div></div>
<div class="result"><div class="result-top"><div><small>IMPUESTO DE RENTA ESTIMADO</small><div class="value" id="tax">$8.010.000</div></div><div class="verdict"><small>Tu tramo</small><b id="bracket">28% marginal</b></div></div><div class="stats"><span>RENTA EN UVT<b id="uvt">1.909,1 UVT</b></span><span>TARIFA EFECTIVA<b id="effective">8,01%</b></span><span>RENTA DESPUÉS DEL IMPUESTO<b id="net">$91.990.000</b></span></div><button class="go" id="update">Actualizar cálculo</button></div></section></div></div></section>
<section class="section"><div class="wrap"><header class="section-head"><span>La clave de la tabla</span><h2>La tarifa marginal no se aplica a todo</h2><p>Cada porcentaje grava solamente la parte de renta que cae dentro de ese tramo.</p></header><div class="steps"><article class="step"><i>1</i><h3>Pasamos pesos a UVT</h3><p>Dividimos la renta líquida por $52.374, el valor oficial de la UVT para 2026.</p></article><article class="step"><i>2</i><h3>Ubicamos el tramo</h3><p>Hasta 1.090 UVT no hay impuesto. Desde ahí se aplican tasas progresivas del 19% al 39%.</p></article><article class="step"><i>3</i><h3>Calculamos solo el excedente</h3><p>La tarifa mayor se aplica a la porción que supera el límite inferior, más el componente fijo acumulado.</p></article></div></div></section>
<section class="section tint"><div class="wrap"><header class="section-head"><span>Tabla oficial explicada</span><h2>Tramos del artículo 241</h2></header><article class="table-card"><div class="table-head"><h3>Impuesto sobre la renta líquida</h3><span>Valores anuales · UVT 2026</span></div><table><thead><tr><th>Rango en UVT</th><th>Rango aproximado en pesos</th><th>Tarifa</th><th>Cálculo en UVT</th></tr></thead><tbody id="rows"></tbody></table><div class="table-note">La fila verde indica dónde cae tu renta. Los valores en pesos son referencias calculadas con UVT 2026 de $52.374.</div></article></div></section>
<section class="section"><div class="wrap breakdown"><article class="card"><h3>Tu cálculo, línea por línea</h3><div class="line"><span>Renta líquida gravable</span><b id="d-base">$100.000.000</b></div><div class="line"><span>Equivalencia en UVT</span><b id="d-uvt">1.909,1 UVT</b></div><div class="line"><span>Menos límite inferior del tramo</span><b id="d-floor">1.700 UVT</b></div><div class="line"><span>Excedente gravado</span><b id="d-excess">209,1 UVT × 28%</b></div><div class="line"><span>Componente fijo acumulado</span><b id="d-fixed">116 UVT</b></div><div class="line total"><strong>Impuesto estimado</strong><b id="d-tax">$8.010.000</b></div></article><article class="card"><h3>Antes de usar el resultado</h3><div class="rule"><i>1</i><div><b>Partí de la renta líquida</b><span>No es el ingreso bruto: primero deben depurarse costos, ingresos no constitutivos, deducciones y exentas.</span></div></div><div class="rule"><i>2</i><div><b>Separá impuesto de saldo</b><span>Las retenciones y anticipos pueden bajar el valor final a pagar o generar saldo a favor.</span></div></div><div class="rule"><i>3</i><div><b>Revisá otras cédulas</b><span>Dividendos y ganancias ocasionales tienen tratamientos propios.</span></div></div><div class="warning">Estimación orientativa con la tabla del Art. 241 ET. No reemplaza la preparación del formulario ni la revisión de un contador.</div></article></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-tabla-renta-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-tabla-renta-colombia');

const UVT=52374,R=[{a:0,b:1090,t:0,f:0},{a:1090,b:1700,t:.19,f:0},{a:1700,b:4100,t:.28,f:116},{a:4100,b:8670,t:.33,f:788},{a:8670,b:18970,t:.35,f:2296},{a:18970,b:31000,t:.37,f:5901},{a:31000,b:Infinity,t:.39,f:10352}],$=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],cop=n=>"$"+Math.round(n).toLocaleString("es-CO"),fmt=n=>n.toLocaleString("es-CO",{maximumFractionDigits:1});
function get(){return Math.max(0,Number($("#base").value.replaceAll(".","").replace(",","."))||0)}function bracket(u){return R.find(x=>u>x.a&&u<=x.b)||R[0]}
function calc(){const base=get(),u=base/UVT,r=bracket(u),pct=Math.round(r.t*100),tax=((u-r.a)*r.t+r.f)*UVT,eff=base?tax/base*100:0,ex=Math.max(0,u-r.a);$("#tax").textContent=cop(tax);$("#bracket").textContent=`${pct}% marginal`;$("#uvt").textContent=fmt(u)+" UVT";$("#effective").textContent=eff.toLocaleString("es-CO",{maximumFractionDigits:2})+"%";$("#net").textContent=cop(base-tax);$("#marker").style.left=Math.min(97,u/31000*100)+"%";$("#d-base").textContent=cop(base);$("#d-uvt").textContent=fmt(u)+" UVT";$("#d-floor").textContent=fmt(r.a)+" UVT";$("#d-excess").textContent=fmt(ex)+" UVT × "+pct+"%";$("#d-fixed").textContent=fmt(r.f)+" UVT";$("#d-tax").textContent=cop(tax);renderRows(r)}
function renderRows(current){$("#rows").innerHTML=R.map(r=>{const pct=Math.round(r.t*100);return `<tr class="${r===current?"current":""}"><td>${fmt(r.a)} ${r.b===Infinity?"en adelante":"– "+fmt(r.b)}</td><td>${cop(r.a*UVT)} ${r.b===Infinity?"en adelante":"– "+cop(r.b*UVT)}</td><td>${pct}% ${r===current?'<span class="pill">Tu tramo</span>':""}</td><td>${r.t?`(UVT − ${fmt(r.a)}) × ${pct}% + ${fmt(r.f)}`:"$0"}</td></tr>`}).join("")}
$$(".preset").forEach(b=>b.onclick=()=>{$("#base").value=b.dataset.value;$$(".preset").forEach(x=>x.classList.toggle("active",x===b));calc()});$("#base").oninput=()=>{$$(".preset").forEach(x=>x.classList.remove("active"));calc()};$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Cálculo actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar cálculo",1200)};calc();

})();
</script>
<style is:global>

.mockup-tabla-renta-colombia{--ink:#14243b;--muted:#66778b;--line:#dce5e8;--navy:#1d3d5a;--green:#197a61;--mint:#e6f5ef;--yellow:#f3d26c;--orange:#ec8d47;--wash:#f4f8f7}.mockup-tabla-renta-colombia *{box-sizing:border-box}.mockup-tabla-renta-colombia{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:var(--ink)}.mockup-tabla-renta-colombia button,.mockup-tabla-renta-colombia input{font:inherit}.mockup-tabla-renta-colombia .wrap{width:min(1180px,calc(100% - 40px));margin:auto}.mockup-tabla-renta-colombia .top{height:80px;border-bottom:1px solid var(--line)}.mockup-tabla-renta-colombia .nav,.mockup-tabla-renta-colombia .brand,.mockup-tabla-renta-colombia .links,.mockup-tabla-renta-colombia .tools{display:flex;align-items:center}.mockup-tabla-renta-colombia .nav{height:100%;justify-content:space-between}.mockup-tabla-renta-colombia .brand{gap:10px;font-size:18px;font-weight:900}.mockup-tabla-renta-colombia .logo{width:32px;height:32px;border-radius:8px;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:11px}.mockup-tabla-renta-colombia .links{gap:27px;color:#536378;font-size:12px;font-weight:750}.mockup-tabla-renta-colombia .tools{gap:10px}.mockup-tabla-renta-colombia .tool{border:1px solid var(--line);border-radius:11px;padding:10px 14px;font-size:11px;font-weight:700}.mockup-tabla-renta-colombia .dark{background:var(--navy);color:#fff}
.mockup-tabla-renta-colombia .hero{padding:31px 0 72px;background:radial-gradient(circle at 10% 20%,#e3f6ee 0,transparent 30%),linear-gradient(180deg,#fcfefd,#f4f8f7)}.mockup-tabla-renta-colombia .crumb{font-size:12px;color:#758396;margin-bottom:34px}.mockup-tabla-renta-colombia .crumb b{color:var(--green)}.mockup-tabla-renta-colombia .hero-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:56px}.mockup-tabla-renta-colombia .eyebrow{display:flex;align-items:center;gap:10px;color:var(--green);letter-spacing:.16em;text-transform:uppercase;font-size:11px;font-weight:900;margin:8px 0 18px}.mockup-tabla-renta-colombia .eyebrow:before{content:"";width:28px;height:2px;background:var(--green)}.mockup-tabla-renta-colombia h1{font-size:54px;line-height:.99;letter-spacing:-.055em;margin:0 0 21px}.mockup-tabla-renta-colombia .lead{font-size:18px;line-height:1.55;color:var(--muted)}.mockup-tabla-renta-colombia .chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:25px}.mockup-tabla-renta-colombia .chips span{border:1px solid var(--line);background:#fff;border-radius:99px;padding:8px 11px;font-size:10px;color:#5e7181}
.mockup-tabla-renta-colombia .calc{background:#fff;border:1px solid #d9e4e1;border-radius:23px;padding:27px;box-shadow:0 24px 60px #1a443616}.mockup-tabla-renta-colombia .calc-head{display:flex;justify-content:space-between}.mockup-tabla-renta-colombia .calc h2{font-size:26px;letter-spacing:-.04em;margin:0}.mockup-tabla-renta-colombia .calc-head p{margin:5px 0;color:var(--muted);font-size:12px}.mockup-tabla-renta-colombia .tag{background:var(--mint);color:var(--green);border-radius:99px;padding:7px 10px;height:max-content;font-size:10px;font-weight:850}.mockup-tabla-renta-colombia .label{font-size:10px;font-weight:900;margin:20px 0 8px}.mockup-tabla-renta-colombia .field{border:1px solid var(--line);border-radius:13px;padding:10px 13px}.mockup-tabla-renta-colombia .field label{font-size:9px;color:#6c7d8c;display:block}.mockup-tabla-renta-colombia .money{display:flex;align-items:center;gap:7px}.mockup-tabla-renta-colombia .money b{font-size:16px}.mockup-tabla-renta-colombia .money input{width:100%;border:0;outline:0;font-size:21px;font-weight:900;color:var(--ink)}.mockup-tabla-renta-colombia .presets{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px}.mockup-tabla-renta-colombia .preset{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 5px;font-size:9px;font-weight:800;color:#5d6d7f;cursor:pointer}.mockup-tabla-renta-colombia .preset.active{border-color:var(--green);background:#edf8f4;color:var(--green)}
.mockup-tabla-renta-colombia .result{margin-top:14px;background:var(--navy);color:#fff;border-radius:17px;padding:20px}.mockup-tabla-renta-colombia .result-top{display:flex;justify-content:space-between;align-items:start}.mockup-tabla-renta-colombia .result small{font-size:9px;color:#bdd0da;letter-spacing:.09em}.mockup-tabla-renta-colombia .value{font-size:36px;font-weight:900;letter-spacing:-.045em;margin-top:5px}.mockup-tabla-renta-colombia .verdict{background:#edf8e7;color:#34634f;border-radius:11px;padding:10px 12px;text-align:right}.mockup-tabla-renta-colombia .verdict small{color:#5d7b6e;display:block}.mockup-tabla-renta-colombia .verdict b{font-size:14px}.mockup-tabla-renta-colombia .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;border-top:1px solid #ffffff24;margin-top:16px;padding-top:14px}.mockup-tabla-renta-colombia .stats span{font-size:8px;color:#bdced8}.mockup-tabla-renta-colombia .stats b{display:block;color:#fff;font-size:13px;margin-top:4px}.mockup-tabla-renta-colombia .go{width:100%;border:0;border-radius:11px;background:#d9ed9b;color:#264a3f;padding:13px;margin-top:15px;font-weight:900;cursor:pointer}
.mockup-tabla-renta-colombia .scale-wrap{margin-top:19px}.mockup-tabla-renta-colombia .scale-labels{display:flex;justify-content:space-between;font-size:8px;color:#80909c;margin-bottom:6px}.mockup-tabla-renta-colombia .scale{height:16px;border-radius:99px;background:linear-gradient(90deg,#54b77b 0 3.5%,#9ccb58 3.5% 5.5%,#e1c448 5.5% 13.2%,#eda64c 13.2% 28%,#eb8350 28% 61%,#d95f4e 61%);position:relative}.mockup-tabla-renta-colombia .marker{position:absolute;top:-7px;width:4px;height:30px;background:var(--navy);border-radius:4px;left:4%;transition:.3s}.mockup-tabla-renta-colombia .marker:after{content:"";width:10px;height:10px;background:var(--navy);border-radius:50%;position:absolute;left:-3px;top:-3px}
.mockup-tabla-renta-colombia .section{padding:75px 0}.mockup-tabla-renta-colombia .section.tint{background:var(--wash)}.mockup-tabla-renta-colombia .section-head{text-align:center;max-width:720px;margin:0 auto 37px}.mockup-tabla-renta-colombia .section-head span{color:var(--green);font-size:10px;letter-spacing:.15em;text-transform:uppercase;font-weight:900}.mockup-tabla-renta-colombia .section-head h2{font-size:39px;letter-spacing:-.045em;margin:10px 0}.mockup-tabla-renta-colombia .section-head p{color:var(--muted);line-height:1.55}.mockup-tabla-renta-colombia .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.mockup-tabla-renta-colombia .step{border:1px solid var(--line);border-radius:18px;padding:22px}.mockup-tabla-renta-colombia .step i{font-style:normal;width:36px;height:36px;border-radius:11px;background:var(--mint);color:var(--green);display:grid;place-items:center;font-weight:900}.mockup-tabla-renta-colombia .step h3{font-size:16px;margin:15px 0 6px}.mockup-tabla-renta-colombia .step p{font-size:11px;line-height:1.55;color:var(--muted);margin:0}
.mockup-tabla-renta-colombia .table-card{border:1px solid var(--line);background:#fff;border-radius:20px;overflow:hidden}.mockup-tabla-renta-colombia .table-head{padding:23px 25px;display:flex;justify-content:space-between;align-items:center}.mockup-tabla-renta-colombia .table-head h3{font-size:21px;margin:0}.mockup-tabla-renta-colombia .table-head span{font-size:10px;color:var(--muted)}.mockup-tabla-renta-colombia table{width:100%;border-collapse:collapse;font-size:11px}.mockup-tabla-renta-colombia th{text-align:left;background:#eef3f2;color:#607182;font-size:9px;letter-spacing:.06em}.mockup-tabla-renta-colombia th,.mockup-tabla-renta-colombia td{padding:14px 18px;border-top:1px solid #e6ecec}.mockup-tabla-renta-colombia td:nth-child(n+3),.mockup-tabla-renta-colombia th:nth-child(n+3){text-align:right}.mockup-tabla-renta-colombia tr.current{background:#edf8f4;color:#176c58;font-weight:850}.mockup-tabla-renta-colombia .pill{background:#d9efe7;border-radius:99px;padding:5px 7px;font-size:8px}.mockup-tabla-renta-colombia .table-note{font-size:10px;color:var(--muted);padding:15px 18px;background:#fafcfc;line-height:1.5}
.mockup-tabla-renta-colombia .breakdown{display:grid;grid-template-columns:1.08fr .92fr;gap:20px}.mockup-tabla-renta-colombia .card{border:1px solid var(--line);border-radius:19px;background:#fff;padding:25px}.mockup-tabla-renta-colombia .card h3{font-size:21px;margin:0 0 17px}.mockup-tabla-renta-colombia .line{display:flex;justify-content:space-between;border-bottom:1px solid #edf1f1;padding:12px 0;font-size:12px}.mockup-tabla-renta-colombia .line span{color:#617285}.mockup-tabla-renta-colombia .line.total{background:var(--mint);border:0;border-radius:11px;margin:10px -9px -5px;padding:14px 9px;color:#176a56}.mockup-tabla-renta-colombia .rule{display:flex;gap:11px;margin:17px 0}.mockup-tabla-renta-colombia .rule i{width:31px;height:31px;flex:0 0 31px;border-radius:9px;background:var(--mint);color:var(--green);display:grid;place-items:center;font-style:normal;font-weight:900}.mockup-tabla-renta-colombia .rule b{font-size:12px}.mockup-tabla-renta-colombia .rule span{display:block;color:var(--muted);font-size:10px;line-height:1.5;margin-top:3px}.mockup-tabla-renta-colombia .warning{background:#fff7e5;border:1px solid #efd69c;border-radius:11px;padding:12px;color:#76571e;font-size:10px;line-height:1.5}
@media(max-width:850px){.mockup-tabla-renta-colombia .links{display:none}.mockup-tabla-renta-colombia .hero-grid,.mockup-tabla-renta-colombia .breakdown{grid-template-columns:1fr}.mockup-tabla-renta-colombia h1{font-size:44px}.mockup-tabla-renta-colombia .steps{grid-template-columns:1fr}.mockup-tabla-renta-colombia .table-card{overflow-x:auto}.mockup-tabla-renta-colombia table{min-width:700px}}@media(max-width:560px){.mockup-tabla-renta-colombia .wrap{width:calc(100% - 24px)}.mockup-tabla-renta-colombia .tools .tool:first-child{display:none}.mockup-tabla-renta-colombia h1{font-size:38px}.mockup-tabla-renta-colombia .presets{grid-template-columns:1fr 1fr}.mockup-tabla-renta-colombia .stats{grid-template-columns:1fr}.mockup-tabla-renta-colombia .value{font-size:30px}.mockup-tabla-renta-colombia .result-top{align-items:start}.mockup-tabla-renta-colombia .section{padding:55px 0}}

.mockup-tabla-renta-colombia { width:100%; overflow:hidden; }
.mockup-tabla-renta-colombia .top, .mockup-tabla-renta-colombia header.top { display:none !important; }
.mockup-tabla-renta-colombia .foot { display:none !important; }
.mockup-tabla-renta-colombia .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-tabla-renta-colombia .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-tabla-renta-colombia .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-tabla-renta-colombia .support-real summary { cursor:pointer; font-weight:750; }
.mockup-tabla-renta-colombia .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-tabla-renta-colombia :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-tabla-renta-colombia input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-tabla-renta-colombia input[type="number"]::-webkit-inner-spin-button, .mockup-tabla-renta-colombia input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-tabla-renta-colombia .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-tabla-renta-colombia support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
