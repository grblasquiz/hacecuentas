<div class="mockup-alquiler-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Alquiler</div><div class="heroGrid"><div><span class="eyebrow">Alquilar con números claros</span><h1>Antes de firmar, hacé todas las cuentas.</h1><p class="lead">Calculá cuánto necesitás para entrar, cómo cambia el alquiler y qué gastos vas a sostener cada mes. Sin sorpresas después de recibir la llave.</p><div class="trust"><span>✓ Índices actualizados</span><span>✓ Todos los costos</span><span>✓ Comparación de escenarios</span></div><div class="house"><div class="door"></div><div class="houseCopy"><strong>La llave es el último paso.</strong><span>Primero entendé el costo completo.</span></div></div></div>
<div class="calc"><h2>¿Cuánto alquiler podés sostener?</h2><p>Compará el costo mensual con tu ingreso.</p><div class="mode"><button class="active" data-mode="monthly">Costo mensual</button><button data-mode="entry">Dinero para entrar</button></div><div class="fields"><div class="field wide"><label>Alquiler publicado</label><div class="input"><b>$</b><input id="rent" value="650000" inputmode="numeric"></div></div><div class="field"><label>Expensas</label><div class="input"><b>$</b><input id="expenses" value="120000" inputmode="numeric"></div></div><div class="field"><label>Ingreso mensual neto</label><div class="input"><b>$</b><input id="income" value="2500000" inputmode="numeric"></div></div><div class="field entryOnly" style="display:none"><label>Depósito · meses</label><div class="input"><input id="deposit" value="1" type="number" min="0" max="3"></div></div><div class="field entryOnly" style="display:none"><label>Comisión · %</label><div class="input"><input id="commission" value="4.15" type="number" min="0" max="20" step=".01"><b>%</b></div></div></div><button class="primary" id="calculate">Actualizar presupuesto</button><div class="result"><small id="resultLabel">COSTO FIJO MENSUAL</small><div class="amount" id="total">$770.000</div><div class="resultGrid"><div class="metric"><span>ALQUILER</span><b id="rentResult">$650.000</b></div><div class="metric"><span>EXPENSAS / OTROS</span><b id="expenseResult">$120.000</b></div><div class="metric"><span>DEL INGRESO</span><b id="ratio">31%</b></div></div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Tu recorrido</span><h2>¿En qué momento del alquiler estás?</h2><p>Elegí tu situación y te mostramos primero las herramientas que necesitás ahora.</p></div><div class="journey"><button class="stage active" data-filter="entrar"><span class="num">1</span><h3>Estoy por entrar</h3><p>Depósito, adelanto, comisión, garantía y mudanza.</p><em>→</em></button><button class="stage" data-filter="aumento"><span class="num">2</span><h3>Me aumentan</h3><p>Calculá el nuevo valor según el índice del contrato.</p><em>→</em></button><button class="stage" data-filter="renovar"><span class="num">3</span><h3>Voy a renovar</h3><p>Compará el nuevo contrato con otras alternativas.</p><em>→</em></button><button class="stage" data-filter="salir"><span class="num">4</span><h3>Quiero salir</h3><p>Preaviso, rescisión y gastos de una nueva mudanza.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas de alquiler</span><h2>Todo lo que necesitás, ordenado.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="entrar">Entrar</button><button class="filter" data-filter="aumento">Aumentos</button><button class="filter" data-filter="renovar">Renovar</button><button class="filter" data-filter="salir">Salir</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="entrar" data-text="entrar alquiler depósito comisión garantía mudanza"><span class="tag">La cuenta completa</span><h3>¿Cuánto cuesta entrar a un alquiler?</h3><p>Sumá depósito, mes adelantado, comisión, garantía, informes y mudanza en un único presupuesto.</p><a class="hc-tool-link" href="/alquiler/entrar-a-un-alquiler">Calcular el ingreso →</a></article><article class="card" data-cat="aumento renovar" data-text="aumento alquiler ipc icl índice contrato"><span class="tag">Actualización</span><h3>Aumento de alquiler</h3><p>Aplicá IPC, ICL o un porcentaje pactado y compará todos los casos.</p><a class="hc-tool-link" href="/alquiler/aumento-de-alquiler">Actualizar alquiler →</a></article><article class="card" data-cat="renovar" data-text="renovación alquiler comparar ingreso precio"><span class="tag">Decisión</span><h3>¿Renovar o mudarme?</h3><p>Compará el costo de aceptar el nuevo valor contra volver a entrar en otro inmueble.</p><a class="hc-tool-link" href="/alquiler/entrar-a-un-alquiler">Comparar opciones →</a></article><article class="card" data-cat="salir" data-text="rescisión contrato multa preaviso salir"><span class="tag">Contrato</span><h3>Rescindir el alquiler</h3><p>Estimá preaviso, posibles penalidades y el costo total de salida.</p><a class="hc-tool-link" href="/alquiler/entrar-a-un-alquiler">Calcular salida →</a></article><article class="card" data-cat="entrar renovar" data-text="garantía propietaria seguro caución comparar"><span class="tag">Garantía</span><h3>Garantía vs. seguro de caución</h3><p>Compará costo, renovación y requisitos de cada alternativa.</p><a class="hc-tool-link" href="/alquiler/entrar-a-un-alquiler">Comparar garantías →</a></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap"><div class="split"><article class="panel"><h3>Checklist antes de firmar</h3><p>Una buena cuenta también necesita revisar lo que no entra en la calculadora.</p><div class="check"><i>✓</i>Índice, frecuencia y fecha del próximo aumento</div><div class="check"><i>✓</i>Quién paga expensas extraordinarias y arreglos</div><div class="check"><i>✓</i>Inventario, estado y servicios sin deuda</div><div class="check"><i>✓</i>Condiciones de rescisión y devolución del depósito</div></article><article class="panel dark"><h3>Regla rápida de presupuesto</h3><p>Como referencia, alquiler más expensas suele ser más manejable cuando no supera aproximadamente un tercio del ingreso neto del hogar. No es una regla legal: adaptala a tus otros gastos y estabilidad laboral.</p><div class="check"><i>●</i>Hasta 30% · margen más cómodo</div><div class="check"><i>●</i>30–40% · presupuesto ajustado</div><div class="check"><i>●</i>Más de 40% · poca capacidad de absorber cambios</div></article></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-alquiler-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-alquiler-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR"),num=id=>Math.max(0,Number($(id).value.replaceAll(".","").replaceAll(",",""))||0);let mode="monthly";
function calc(){const rent=num("#rent"),expenses=num("#expenses"),income=num("#income");let total=rent+expenses,extra=expenses;if(mode==="entry"){const dep=Number($("#deposit").value)||0,comm=Number($("#commission").value)||0;extra=rent*dep+rent*comm/100+expenses;total=rent+extra}$("#resultLabel").textContent=mode==="monthly"?"COSTO FIJO MENSUAL":"DINERO ESTIMADO PARA ENTRAR";$("#total").textContent=money(total);$("#rentResult").textContent=money(rent);$("#expenseResult").textContent=money(extra);$("#ratio").textContent=Math.round(total/(income||1)*100)+"%"}
$$("[data-mode]").forEach(b=>b.onclick=()=>{mode=b.dataset.mode;$$("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));$$(".entryOnly").forEach(x=>x.style.display=mode==="entry"?"":"none");calc()});$$(".calc input").forEach(x=>x.oninput=calc);$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Presupuesto actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".stage").forEach(b=>b.onclick=()=>{$$(".stage").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,$target=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===$target));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent="Abriendo: "+t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1600)}$$(".card button").forEach(b=>b.onclick=()=>toast(b.closest(".card").querySelector("h3").textContent));calc();

})();
</script>
