---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-calorias-alimentos" set:html={`
    <div class="wrap">
      <div class="hero"><div><div class="crumb">Salud / Calorías de los alimentos</div><div class="eyebrow">La porción importa más que el dato por 100 g</div><h1>¿Qué tiene realmente lo que comés?</h1><p class="lead">Calculá calorías, macros, impacto glucémico y grado de procesamiento para la cantidad que está en tu plato.</p><div class="chips"><span class="chip">✓ Porciones reales</span><span class="chip">✓ Macros y glucemia</span><span class="chip">✓ Catálogo unificado</span></div></div><div class="visual"><div class="plate"><div class="food f1"></div><div class="food f2"></div><div class="food f3"></div></div><div class="fork"></div><div class="donut"></div><div class="note n1">4 · 4 · 9 kcal/g</div><div class="note n2">Calorías, saciedad y NOVA</div></div></div>
      <form class="calc" id="calculator"><div class="case-label">¿QUÉ QUERÉS CALCULAR?</div><div class="cases"><button type="button" class="case active" data-mode="catalog">Alimento y porción</button><button type="button" class="case" data-mode="glycemic">Impacto glucémico</button><button type="button" class="case" data-mode="dish">Plato o unidad</button><button type="button" class="case" data-mode="drink">Bebida alcohólica</button><button type="button" class="case" data-mode="label">Etiqueta</button><button type="button" class="case" data-mode="recipe">Receta entera</button></div>
        <div class="grid"><div class="panel"><h2 id="formTitle">Elegí un alimento</h2><p class="hint" id="formHint">Los datos de tabla se ajustan a los gramos que realmente comés.</p>
          <div class="fields active" data-fields="food"><div class="field full"><label for="food">Alimento</label><select class="control" id="food"><option value="bread">Pan blanco</option><option value="wholebread">Pan integral</option><option value="rice">Arroz blanco cocido</option><option value="lentils">Lentejas cocidas</option><option value="potato">Papa hervida</option><option value="avocado">Palta</option><option value="banana">Banana</option><option value="fish">Merluza</option><option value="peanuts">Maní tostado</option><option value="chocolate">Chocolate 70%</option></select></div><div class="field full"><label for="grams">Porción (g)</label><input class="control" id="grams" type="number" value="100" min="1"></div></div>
          <div class="fields" data-fields="dish"><div class="field full"><label for="dish">Plato o unidad</label><select class="control" id="dish"><option value="empanada">Empanada de carne</option><option value="pizza">Porción de pizza</option><option value="milanesa">Milanesa napolitana</option><option value="choripan">Choripán</option><option value="asado">Asado completo</option><option value="egg">Huevo duro</option><option value="friedegg">Huevo frito</option><option value="bigmac">Big Mac</option></select></div><div class="field full"><label for="units">Unidades o porciones</label><input class="control" id="units" type="number" value="2" min="1"></div></div>
          <div class="fields" data-fields="drink"><div class="field"><label for="drink">Bebida</label><select class="control" id="drink"><option value="wine">Vino tinto</option><option value="beer">Cerveza</option><option value="champagne">Espumante</option><option value="whisky">Whisky</option><option value="fernet">Fernet con cola</option></select></div><div class="field"><label for="milliliters">Porción (ml)</label><input class="control" id="milliliters" type="number" value="150" min="1"></div></div>
          <div class="fields" data-fields="macros"><div class="field"><label for="protein">Proteínas (g)</label><input class="control" id="protein" type="number" value="9" min="0" step=".1"></div><div class="field"><label for="carbs">Carbohidratos (g)</label><input class="control" id="carbs" type="number" value="49" min="0" step=".1"></div><div class="field"><label for="fat">Grasas (g)</label><input class="control" id="fat" type="number" value="3.2" min="0" step=".1"></div><div class="field"><label for="fiber">Fibra (g)</label><input class="control" id="fiber" type="number" value="2.7" min="0" step=".1"></div><div class="field full recipe-only"><label for="servings">Porciones que rinde la receta</label><input class="control" id="servings" type="number" value="4" min="1"></div></div>
          <button class="update" id="updateButton" type="submit">Actualizar cálculo</button>
        </div>
        <div class="panel result"><div class="kicker" id="kicker">CALORÍAS DE TU PORCIÓN</div><div class="big" id="resultValue">265 kcal</div><div class="sub" id="resultSub">100 g de pan blanco</div><div class="badge" id="resultBadge">NOVA 3 · procesado</div><div class="tiles"><div class="tile"><small id="t1l">Proteínas</small><strong id="t1v">9 g</strong></div><div class="tile"><small id="t2l">Carbohidratos</small><strong id="t2v">49 g</strong></div><div class="tile"><small id="t3l">Grasas</small><strong id="t3v">3,2 g</strong></div></div></div></div>
      </form>
    </div>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">De dónde sale el número</div><h2>Calorías aportadas por cada macro</h2><p>La barra muestra calorías, no gramos: un gramo de grasa aporta más del doble que uno de proteína o carbohidrato.</p></div><div class="macro"><div class="macro-top"><div><h3 id="macroTitle">Pan blanco · 100 g</h3><p id="macroCopy">Factores de Atwater: proteína 4, carbohidrato 4, grasa 9.</p></div><div class="macro-total" id="macroTotal">265 kcal</div></div><div class="macro-bar"><div class="segment prot" id="segProtein">14%</div><div class="segment carb" id="segCarbs">74%</div><div class="segment fat" id="segFat">11%</div><div class="segment alcohol" id="segAlcohol"></div></div><div class="legend"><div class="leg"><span class="dot prot"></span>Proteínas<strong id="legProtein">36 kcal</strong></div><div class="leg"><span class="dot carb"></span>Carbohidratos<strong id="legCarbs">196 kcal</strong></div><div class="leg"><span class="dot fat"></span>Grasas<strong id="legFat">29 kcal</strong></div><div class="leg"><span class="dot alcohol"></span>Alcohol<strong id="legAlcohol">0 kcal</strong></div></div></div></div></section>
    <section><div class="wrap two"><div class="info"><div class="eyebrow">Tu porción, explicada</div><h3 id="breakTitle">Qué tiene adentro</h3><div class="rows" id="breakRows"></div></div><div class="info notice"><div class="notice-icon">◉</div><h3>Calorías no es lo mismo que calidad</h3><p>Dos alimentos con la misma energía pueden diferir mucho en proteína, fibra, saciedad y procesamiento. Por eso el catálogo muestra todos esos datos juntos.</p><div class="rows"><div class="row"><span>Dato más confiable</span><strong>Etiqueta del envase</strong></div><div class="row"><span>Tolerancia habitual</span><strong>Valores aproximados</strong></div></div></div></div></section>
    <section><div class="wrap"><div class="section-head"><div class="eyebrow">Cuatro lecturas complementarias</div><h2 id="refsTitle">El mismo alimento, más allá de las calorías</h2></div><div class="refs"><div class="ref"><div class="ref-icon">⚡</div><b id="refKcal">265 kcal</b><span>Energía de la porción</span></div><div class="ref"><div class="ref-icon">📈</div><b id="refGI">IG 75</b><span>Velocidad glucémica</span></div><div class="ref"><div class="ref-icon">🍽️</div><b id="refSatiety">Saciedad 100</b><span>Pan blanco = referencia</span></div><div class="ref"><div class="ref-icon">🏭</div><b id="refNova">NOVA 3</b><span>Grado de procesamiento</span></div></div></div></section>
    <div class="dark"><div class="wrap dark-grid"><div class="formula">Proteína × 4 + carbohidrato × 4<span>+ grasa × 9 + alcohol × 7</span>= calorías totales<small>Es la regla de Atwater que también usan las etiquetas nutricionales.</small></div><div><div class="eyebrow" style="color:#70d5c5">Una estimación, no un diagnóstico</div><h2>Usá los números para comparar, no para perseguir precisión imposible.</h2><p>Variedad, cocción, maduración y receta cambian la composición. Si existe una etiqueta específica, tiene prioridad sobre el catálogo.</p><div class="checks"><div class="check"><span class="tick">✓</span><span>Pesá la porción que realmente comés.</span></div><div class="check"><span class="tick">✓</span><span>En recetas, no olvides el aceite de cocción.</span></div><div class="check"><span class="tick">✓</span><span>Ante una condición médica, consultá a un profesional matriculado.</span></div></div></div></div></div>
  `} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-calorias-alimentos')?document.currentScript.previousElementSibling:document.querySelector('.mockup-calorias-alimentos');

    const $=id=>root.querySelector("#"+id),fmt=(n,d=1)=>Number(n).toLocaleString("es-AR",{maximumFractionDigits:d,minimumFractionDigits:d});let mode="catalog";
    const foods={bread:["Pan blanco",265,9,49,3.2,2.7,75,100,3],wholebread:["Pan integral",247,13,41,3.4,6.8,51,154,3],rice:["Arroz blanco cocido",130,2.7,28.2,.3,.4,73,138,1],lentils:["Lentejas cocidas",116,9,20.1,.4,7.9,32,133,1],potato:["Papa hervida",87,1.9,20.1,.1,1.8,78,323,1],avocado:["Palta",160,2,8.5,14.7,6.7,0,0,1],banana:["Banana",89,1.1,22.8,.3,2.6,51,118,1],fish:["Merluza",90,18.5,0,1.3,0,0,225,1],peanuts:["Maní tostado",587,24.4,21.5,49.7,8,14,84,3],chocolate:["Chocolate 70%",598,7.8,45.9,42.6,10.9,40,0,3]};
    const dishes={empanada:["Empanada de carne",300,12,22,18],pizza:["Porción de pizza",280,12,30,12],milanesa:["Milanesa napolitana",800,45,40,50],choripan:["Choripán",500,22,30,32],asado:["Asado completo",1050,70,15,75],egg:["Huevo duro",75,6.3,.6,5.3],friedegg:["Huevo frito",95,6.3,.6,7.5],bigmac:["Big Mac",540,25,46,29]};
    const drinks={wine:["Vino tinto",85,13],beer:["Cerveza",43,5],champagne:["Espumante",76,12],whisky:["Whisky",231,40],fernet:["Fernet con cola",105,7]};
    const cfg={catalog:["Elegí un alimento","Los datos de tabla se ajustan a los gramos que realmente comés."],glycemic:["Impacto en la glucemia","Índice glucémico es del alimento; carga glucémica depende de tu porción."],dish:["Contá unidades completas","Platos, hamburguesas y huevos se calculan por unidad servida."],drink:["Medí el vaso o la copa","El alcohol aporta 7 kcal por gramo y no aporta nutrientes."],label:["Copiá los macros de la etiqueta","Usá los valores de la porción que realmente comiste."],recipe:["Sumá la receta entera","Cargá los macros totales de la olla y dividilos por porciones reales."]};
    function set(id,v){$(id).textContent=v}function rows(a){$("breakRows").innerHTML=a.map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
    function macro(name,total,p,c,f,a=0){const vals=[p*4,c*4,f*9,a*7],sum=vals.reduce((x,y)=>x+y,0)||1,ids=["segProtein","segCarbs","segFat","segAlcohol"],legs=["legProtein","legCarbs","legFat","legAlcohol"];vals.forEach((v,i)=>{$(ids[i]).style.width=v/sum*100+"%";set(ids[i],v?Math.round(v/sum*100)+"%":"");set(legs[i],Math.round(v)+" kcal")});set("macroTitle",name);set("macroTotal",Math.round(total)+" kcal")}
    function refs(title,a,b,c,d){set("refsTitle",title);set("refKcal",a);set("refGI",b);set("refSatiety",c);set("refNova",d)}
    function foodCalc(){const F=foods[$("food").value],factor=Math.max(0,Number($("grams").value)||0)/100,name=F[0],kcal=F[1]*factor,p=F[2]*factor,c=F[3]*factor,g=F[4]*factor,fiber=F[5]*factor,gi=F[6],sat=F[7],nova=F[8],load=gi*Math.max(0,c-fiber)/100;set("kicker",mode==="glycemic"?"CARGA GLUCÉMICA":"CALORÍAS DE TU PORCIÓN");set("resultValue",mode==="glycemic"?fmt(load,1):Math.round(kcal)+" kcal");set("resultSub",`${fmt(factor*100,0)} g de ${name.toLowerCase()}`);set("resultBadge",mode==="glycemic"?(load<=10?"Carga baja":load<20?"Carga media":"Carga alta"):`NOVA ${nova} · ${nova===1?"mínimamente procesado":"procesado"}`);set("t1l",mode==="glycemic"?"Índice glucémico":"Proteínas");set("t1v",mode==="glycemic"?gi:fmt(p)+" g");set("t2l",mode==="glycemic"?"Carbohidratos disponibles":"Carbohidratos");set("t2v",mode==="glycemic"?fmt(Math.max(0,c-fiber))+" g":fmt(c)+" g");set("t3l",mode==="glycemic"?"Fibra":"Grasas");set("t3v",mode==="glycemic"?fmt(fiber)+" g":fmt(g)+" g");macro(`${name} · ${fmt(factor*100,0)} g`,kcal,p,c,g);refs("El mismo alimento, más allá de las calorías",Math.round(kcal)+" kcal",gi?"IG "+gi:"Sin IG",sat?"Saciedad "+sat:"Sin dato","NOVA "+nova);rows([["Energía",Math.round(kcal)+" kcal"],["Proteínas",fmt(p)+" g"],["Carbohidratos",fmt(c)+" g"],["Fibra",fmt(fiber)+" g"],["Grasas",fmt(g)+" g"],["Índice glucémico",gi||"No aplica"],["Carga glucémica",fmt(load,1)],["Grupo NOVA",nova]])}
    function calculate(){if(mode==="catalog"||mode==="glycemic"){foodCalc();return}
      if(mode==="dish"){const D=dishes[$("dish").value],units=Math.max(1,Number($("units").value)||1),k=D[1]*units,p=D[2]*units,c=D[3]*units,g=D[4]*units;set("kicker","CALORÍAS DEL PLATO");set("resultValue",Math.round(k)+" kcal");set("resultSub",`${units} ${units===1?"unidad":"unidades"} de ${D[0].toLowerCase()}`);set("resultBadge",fmt(k/2000*100,0)+"% de una referencia de 2.000 kcal");set("t1l","Por unidad");set("t1v",D[1]+" kcal");set("t2l","Proteínas");set("t2v",fmt(p)+" g");set("t3l","Grasas");set("t3v",fmt(g)+" g");macro(D[0],k,p,c,g);refs("El plato, en cuatro lecturas",Math.round(k)+" kcal",units+" unid.",fmt(k/2000*100,0)+"% diario","Porción real");rows([["Calorías por unidad",D[1]+" kcal"],["Unidades",units],["Total",k+" kcal"],["Proteínas",fmt(p)+" g"],["Carbohidratos",fmt(c)+" g"],["Grasas",fmt(g)+" g"]])}
      if(mode==="drink"){const D=drinks[$("drink").value],ml=Math.max(1,Number($("milliliters").value)||1),factor=ml/100,k=D[1]*factor,alcohol=ml*(D[2]/100)*.789,alcK=alcohol*7,carbK=Math.max(0,k-alcK);set("kicker","CALORÍAS DE LA BEBIDA");set("resultValue",Math.round(k)+" kcal");set("resultSub",`${fmt(ml,0)} ml de ${D[0].toLowerCase()}`);set("resultBadge",fmt(alcohol,1)+" g de alcohol puro");set("t1l","Del alcohol");set("t1v",Math.round(alcK)+" kcal");set("t2l","Graduación");set("t2v",D[2]+"%");set("t3l","Caminata equivalente");set("t3v",Math.round(k/5)+" min");macro(`${D[0]} · ${ml} ml`,k,0,carbK/4,0,alcohol);refs("Qué aporta esa bebida",Math.round(k)+" kcal",D[2]+"% vol.",fmt(alcohol,1)+" g alcohol",Math.round(k/5)+" min");rows([["Porción",ml+" ml"],["Graduación",D[2]+"%"],["Alcohol puro",fmt(alcohol,1)+" g"],["Calorías del alcohol",Math.round(alcK)+" kcal"],["Calorías totales",Math.round(k)+" kcal"],["Caminata equivalente",Math.round(k/5)+" min"]])}
      if(mode==="label"||mode==="recipe"){const p=Math.max(0,Number($("protein").value)||0),c=Math.max(0,Number($("carbs").value)||0),g=Math.max(0,Number($("fat").value)||0),fiber=Math.max(0,Number($("fiber").value)||0),total=p*4+c*4+g*9,serv=mode==="recipe"?Math.max(1,Number($("servings").value)||1):1,k=total/serv;set("kicker",mode==="recipe"?"CALORÍAS POR PORCIÓN":"CALORÍAS SEGÚN ETIQUETA");set("resultValue",Math.round(k)+" kcal");set("resultSub",mode==="recipe"?`${Math.round(total)} kcal totales ÷ ${serv} porciones`:"calculadas con la regla 4 · 4 · 9");set("resultBadge",mode==="recipe"?"No olvides sumar el aceite":"Carbohidratos disponibles: "+fmt(Math.max(0,c-fiber))+" g");set("t1l","Proteínas");set("t1v",fmt(p/serv)+" g");set("t2l","Carbohidratos");set("t2v",fmt(c/serv)+" g");set("t3l","Grasas");set("t3v",fmt(g/serv)+" g");macro(mode==="recipe"?"Una porción de la receta":"Porción de la etiqueta",k,p/serv,c/serv,g/serv);refs(mode==="recipe"?"Una porción de tu receta":"La etiqueta, traducida",Math.round(k)+" kcal",fmt(p/serv)+" g proteína",fmt(fiber/serv)+" g fibra","Regla 4 · 4 · 9");rows([["Calorías de proteínas",Math.round(p*4)+" kcal"],["Calorías de carbohidratos",Math.round(c*4)+" kcal"],["Calorías de grasas",Math.round(g*9)+" kcal"],["Calorías totales",Math.round(total)+" kcal"],...(mode==="recipe"?[["Porciones",serv],["Calorías por porción",Math.round(k)+" kcal"]]:[["Fibra",fmt(fiber)+" g"],["Carbohidratos disponibles",fmt(Math.max(0,c-fiber))+" g"]])])}}
    root.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;root.querySelectorAll(".case").forEach(x=>x.classList.toggle("active",x===b));const group=mode==="catalog"||mode==="glycemic"?"food":mode==="label"||mode==="recipe"?"macros":mode;root.querySelectorAll(".fields").forEach(x=>x.classList.toggle("active",x.dataset.fields===group));root.querySelector(".recipe-only").style.display=mode==="recipe"?"block":"none";set("formTitle",cfg[mode][0]);set("formHint",cfg[mode][1]);calculate()}));root.querySelectorAll("input,select").forEach(x=>x.addEventListener("input",calculate));function confirm(){calculate();$("updateButton").textContent="✓ Cálculo actualizado";clearTimeout(window.calTimer);window.calTimer=setTimeout(()=>$("updateButton").textContent="Actualizar cálculo",1200)}$("calculator").addEventListener("submit",e=>{e.preventDefault();confirm()});$("updateButton").addEventListener("click",e=>{e.preventDefault();confirm()});root.querySelector(".recipe-only").style.display="none";calculate();
  
})();
</script>
<style is:global>

    .mockup-calorias-alimentos{--ink:#111a32;--muted:#667187;--blue:#2168e8;--green:#27ad84;--orange:#ed9e45;--purple:#745ce2;--paper:#f7f7f2;--line:#dfe4ea;--navy:#174B7A}
    .mockup-calorias-alimentos *{box-sizing:border-box}.mockup-calorias-alimentos{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.mockup-calorias-alimentos button,.mockup-calorias-alimentos input,.mockup-calorias-alimentos select{font:inherit}.mockup-calorias-alimentos .wrap{width:min(1180px,calc(100% - 40px));margin:auto}
    .mockup-calorias-alimentos header{height:86px;border-bottom:1px solid #e0e4e7;display:flex;align-items:center}.mockup-calorias-alimentos .nav{display:flex;align-items:center;gap:28px}.mockup-calorias-alimentos .brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:900}.mockup-calorias-alimentos .logo{width:29px;height:38px;border-radius:6px;background:linear-gradient(145deg,#18355c,#527a99);display:grid;place-items:center;color:white}.mockup-calorias-alimentos .links{display:flex;gap:25px;color:#505b6d;font-size:14px;font-weight:750}.mockup-calorias-alimentos .tools{margin-left:auto;display:flex;gap:9px}.mockup-calorias-alimentos .tool{height:42px;padding:0 14px;border:1px solid #dce1e7;background:#fff;border-radius:11px;color:#526075;font-weight:750}
