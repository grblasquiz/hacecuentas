---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-renta-personas-colombia" set:html={`<section class="hero"><div class="wrap crumb"><b>Colombia</b> &nbsp;/&nbsp; Impuestos &nbsp;/&nbsp; Renta personas</div><div class="wrap grid"><div class="copy"><div class="eyebrow">Tu declaración, explicada</div><h1>Primero, si declarás. Después, cuánto pagarías.</h1><p>Revisá topes, depurá la renta y descontá retenciones para estimar el saldo del formulario 210.</p><div class="chips"><span>✓ Topes para declarar</span><span>▤ Tabla Art. 241</span><span>− Deducciones y retenciones</span></div><div class="art"><div class="folder"></div><div class="form"><b>Formulario 210</b><i></i><i></i><i></i><i></i></div><div class="resultcard"><small>SALDO ESTIMADO</small><strong id="art-result">$2.918.000</strong><span id="art-status">Estás obligado a declarar</span></div></div></div><form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Calculá tu renta</h2><p class="muted">Ingresá los totales del año.</p></div><span class="tag">Año gravable 2025</span></div><div class="label">Tipo de ingreso principal</div><div class="cases"><button type="button" class="case active" data-mode="employee"><i>▣</i>Asalariado</button><button type="button" class="case" data-mode="independent"><i></i>Independiente</button><button type="button" class="case" data-mode="pension"><i>◷</i>Pensionado</button></div><div class="label">Tus cifras del año</div><div class="fields"><div class="field wide"><label>Ingresos brutos anuales</label><div class="money"><b>$</b><input id="income" value="120000000" inputmode="decimal"></div></div><div class="field"><label>Patrimonio bruto</label><div class="money"><b>$</b><input id="assets" value="250000000" inputmode="decimal"></div></div><div class="field"><label>Aportes obligatorios</label><div class="money"><b>$</b><input id="contributions" value="9600000" inputmode="decimal"></div></div><div class="field"><label>Otras deducciones y exentas</label><div class="money"><b>$</b><input id="deductions" value="8000000" inputmode="decimal"></div></div><div class="field"><label>Retenciones practicadas</label><div class="money"><b>$</b><input id="withholding" value="2500000" inputmode="decimal"></div></div><div class="field"><label>Dependientes</label><select id="deps"><option>0</option><option selected>1</option><option>2</option><option>3</option><option>4</option></select></div><div class="field"><label>Últimos 2 dígitos del NIT</label><input id="digits" value="37" inputmode="numeric"></div></div><section class="result"><div class="result-top"><div><small id="result-label">SALDO ESTIMADO A PAGAR</small><div class="value" id="result">$2.918.000</div></div><div class="verdict"><small>Tu situación</small><b id="verdict">Debés declarar</b></div></div><div class="stats"><span>RENTA GRAVABLE<b id="stat-base">$70.240.000</b></span><span>IMPUESTO LIQUIDADO<b id="stat-tax">$5.418.000</b></span><span>VENCIMIENTO<b id="stat-due">Agosto 2026</b></span></div><button class="go" id="update" type="button">Actualizar declaración</button></section></form></div></section>
<section class="section"><div class="wrap"><div class="center"><div class="eyebrow">La primera pregunta</div><h2>¿Superás alguno de los topes?</h2><p>Declarar no significa necesariamente pagar. Basta superar una condición para tener que presentar.</p></div><div class="thresholds"><div class="threshold"><small>INGRESOS BRUTOS</small><b id="t-income">$120.000.000</b><span>Se compara con el límite anual vigente.</span><div class="status" id="s-income">Supera el tope</div></div><div class="threshold"><small>PATRIMONIO BRUTO</small><b id="t-assets">$250.000.000</b><span>Bienes y derechos antes de deudas.</span><div class="status" id="s-assets">Dentro del tope</div></div><div class="threshold"><small>RESULTADO GENERAL</small><b id="t-overall">Debés declarar</b><span>Revisá también consumos y consignaciones.</span><div class="status" id="s-overall">Obligado</div></div></div></div></section><section class="break"><div class="wrap breakgrid"><article class="card"><h3>De tus ingresos al saldo</h3><div class="line"><span>Ingresos brutos</span><b id="d-income">$120.000.000</b></div><div class="line"><span>Aportes obligatorios</span><b id="d-contrib">− $9.600.000</b></div><div class="line"><span>Exentas y deducciones aceptadas</span><b id="d-benefit">− $40.160.000</b></div><div class="line"><span>Renta líquida gravable</span><b id="d-base">$70.240.000</b></div><div class="line"><span>Impuesto según Art. 241</span><b id="d-tax">$5.418.000</b></div><div class="line"><span>Retenciones acreditadas</span><b id="d-withhold">− $2.500.000</b></div><div class="line total"><strong>Saldo estimado</strong><b id="d-result">$2.918.000</b></div></article><article class="card"><h3>Cómo lo calculamos</h3><div class="step"><i>1</i><div><b>Restamos aportes obligatorios</b><span>Salud y pensión no constitutivos de renta.</span></div></div><div class="step"><i>2</i><div><b>Aplicamos beneficios y límites</b><span>Renta exenta del 25%, dependientes y tope global del 40%.</span></div></div><div class="step"><i>3</i><div><b>Calculamos impuesto y retenciones</b><span>Tabla progresiva en UVT menos anticipos ya pagados.</span></div></div><div class="warning">⚠️ Es una estimación orientativa. Ganancias ocasionales y otras cédulas pueden cambiar el formulario final.</div></article></div></section><section class="darksection"><div class="wrap darkgrid"><div><div class="eyebrow" style="color:#80d3b8">Tres ideas clave</div><h2>Declarar, pagar y tener saldo son cosas distintas.</h2><p>Podés estar obligado a presentar y no pagar, o incluso quedar con saldo a favor si te retuvieron de más.</p></div><div class="refs"><div class="ref"><small>UNIDAD BASE</small><b>UVT</b><span>Actualiza topes y tramos</span></div><div class="ref"><small>LÍMITE GLOBAL</small><b>40%</b><span>Deducciones + exentas</span></div><div class="ref"><small>FORMULARIO</small><b>210</b><span>Persona natural residente</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-renta-personas-colombia')?document.currentScript.previousElementSibling:document.querySelector('.mockup-renta-personas-colombia');

const $=s=>root.querySelector(s),$$=s=>root.querySelectorAll(s),n=id=>Math.max(0,Number($(id).value.replaceAll(".","").replace(",","."))||0),cop=x=>"$"+Math.round(x).toLocaleString("es-CO");let mode="employee";const UVT=52374,TOP_INC=1400*49799,TOP_ASSET=4500*49799;
function tax241(base){let u=base/UVT,t=0;if(u>1090&&u<=1700)t=(u-1090)*.19;else if(u<=4100&&u>1700)t=(u-1700)*.28+116;else if(u>4100)t=(u-4100)*.33+788;return t*UVT}function calc(){let inc=n("#income"),assets=n("#assets"),cont=Math.min(inc,n("#contributions")),ded=n("#deductions"),ret=n("#withholding"),deps=Number($("#deps").value),liquid=Math.max(0,inc-cont),benefit;if(mode==="pension")benefit=Math.min(liquid,1000*UVT*12);else{let exempt=liquid*.25,dependent=deps*72*UVT,gross=exempt+dependent+ded,limit=Math.min(liquid*.4,1340*UVT);benefit=Math.min(gross,limit)}let base=Math.max(0,liquid-benefit),tax=tax241(base),balance=Math.max(0,tax-ret),favor=Math.max(0,ret-tax),must=inc>=TOP_INC||assets>TOP_ASSET,digits=Math.min(99,n("#digits")),month=digits<=26?"Agosto 2026":digits<=66?"Septiembre 2026":"Octubre 2026";$("#result-label").textContent=favor>0?"SALDO ESTIMADO A FAVOR":"SALDO ESTIMADO A PAGAR";$("#result").textContent=cop(favor||balance);$("#verdict").textContent=must?"Debés declarar":"No superás estos topes";$("#art-result").textContent=cop(favor||balance);$("#art-status").textContent=must?"Estás obligado a declarar":"No superás ingresos ni patrimonio";$("#stat-base").textContent=cop(base);$("#stat-tax").textContent=cop(tax);$("#stat-due").textContent=month;$("#t-income").textContent=cop(inc);$("#t-assets").textContent=cop(assets);$("#s-income").textContent=inc>=TOP_INC?"Supera el tope":"Dentro del tope";$("#s-assets").textContent=assets>TOP_ASSET?"Supera el tope":"Dentro del tope";$("#t-overall").textContent=must?"Debés declarar":"No obligado por estos topes";$("#s-overall").textContent=must?"Obligado":"No obligado";$("#d-income").textContent=cop(inc);$("#d-contrib").textContent="− "+cop(cont);$("#d-benefit").textContent="− "+cop(benefit);$("#d-base").textContent=cop(base);$("#d-tax").textContent=cop(tax);$("#d-withhold").textContent="− "+cop(ret);$("#d-result").textContent=cop(favor||balance)}
function setMode(m){mode=m;$$(".case").forEach(x=>x.classList.toggle("active",x.dataset.mode===m));calc()}$$(".case").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$$("input,select").forEach(i=>i.oninput=calc);$("#update").onclick=e=>{calc();e.currentTarget.textContent="✓ Declaración actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar declaración",1200)};calc();

})();
</script>
