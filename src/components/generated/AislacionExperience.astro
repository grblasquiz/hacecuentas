---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-aislacion" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Construcción / Aislación</div><div class="eyebrow">Confort y energía</div><h1>¿Qué aislación necesita realmente tu casa?</h1><p class="lead">Compará material, espesor, superficie y clima para estimar resistencia térmica y ahorro.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art insulation"><div class="wall"><i></i><i></i><i></i><i></i></div><span class="cold">−5°</span><span class="warm">21°</span></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">envolvente interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="material">Material</label><select id="material"><option value="glass">Lana de vidrio</option><option value="rock">Lana de roca</option><option value="eps">EPS</option><option value="xps">XPS</option><option value="cellulose">Celulosa</option></select></div><div class="field"><label for="thickness">Espesor (cm)</label><input id="thickness" type="number" value="8" min="2" max="30" step="1"></div><div class="field"><label for="area">Superficie (m²)</label><input id="area" type="number" value="80" min="1" max="1000" step="1"></div><div class="field"><label for="zone">Clima</label><select id="zone"><option value="mild">Templado</option><option value="cold">Frío</option><option value="hot">Caluroso</option></select></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-aislacion')?document.currentScript.previousElementSibling:document.querySelector('.mockup-aislacion');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const m={glass:[.04,"Lana de vidrio"],rock:[.038,"Lana de roca"],eps:[.036,"EPS"],xps:[.031,"XPS"],cellulose:[.041,"Celulosa"]}[v("material")],t=vn("thickness")/100,r=t/m[0],area=vn("area"),target={mild:2,cold:3.5,hot:2.5}[v("zone")],coverage=Math.min(100,r/target*100);return {big:"R "+r.toFixed(2),label:"Resistencia térmica estimada",badge:coverage>=100?"Objetivo alcanzado":"Conviene más espesor",metrics:[["Material",m[1]],["Superficie",area+" m²"],["Volumen",Math.round(area*t*100)/100+" m³"]],position:coverage,note:coverage>=100?"El espesor alcanza la referencia del clima elegido. Revisá puentes térmicos, vapor y continuidad.":"El material ayuda, pero el espesor queda debajo de la referencia. Compará costo por R, no sólo precio por m²."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"material":"glass","thickness":"8","area":"80","zone":"mild"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
<style is:global>

.mockup-aislacion{--blue:#174b7a;--accent:#398174;--soft:#eaf6f2;--ink:#172331;--muted:#5e6977;--line:#d9e2e5;--paper:#f5f7f6;--cream:#fff8e2;--mint:#d9eee6}.mockup-aislacion *{box-sizing:border-box}.mockup-aislacion{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fff}.mockup-aislacion button,.mockup-aislacion input,.mockup-aislacion select{font:inherit}.mockup-aislacion .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:27px;border-bottom:1px solid var(--line)}.mockup-aislacion .brand{font-weight:950;font-size:19px}.mockup-aislacion .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-aislacion .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-aislacion .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-aislacion .hero{padding:50px 22px 45px;background:linear-gradient(126deg,#fbfcfa 0 57%,var(--soft) 57%)}.mockup-aislacion .hero-grid,.mockup-aislacion .wrap{max-width:1180px;margin:auto}.mockup-aislacion .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:57px;align-items:center}.mockup-aislacion .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-aislacion .eyebrow{margin-top:27px;color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-aislacion .hero h1{font-size:clamp(43px,5vw,67px);line-height:.98;letter-spacing:-.05em;margin:10px 0 19px}.mockup-aislacion .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-aislacion .pills{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-aislacion .pills span{padding:8px 12px;border:1px solid var(--line);border-radius:99px;background:#fff;font-size:13px;font-weight:800}.mockup-aislacion .art{height:330px;border:1px solid color-mix(in srgb,var(--accent),#fff 62%);background:#fff;border-radius:50% 50% 24px 24px;box-shadow:0 24px 50px #17374a18;position:relative;overflow:hidden;display:grid;place-items:center}.mockup-aislacion .phscale{position:absolute;left:12%;right:12%;bottom:38px;height:24px;border-radius:99px;background:linear-gradient(90deg,#d4424d,#ea943a,#eadf55,#58ad67,#3c83b8,#7251a2);display:flex;justify-content:space-between;padding:30px 0 0;font-size:10px;font-weight:850}.mockup-aislacion .tube{width:65px;height:170px;border:6px solid var(--blue);border-top:0;border-radius:0 0 35px 35px;position:absolute;top:40px}.mockup-aislacion .tube i{position:absolute;left:0;right:0;bottom:0;height:62%;background:var(--accent);border-radius:0 0 27px 27px}.mockup-aislacion .orbit:before,.mockup-aislacion .orbit:after{content:"";position:absolute;border:1px solid #6684ad66;border-radius:50%}.mockup-aislacion .orbit:before{width:210px;height:210px}.mockup-aislacion .orbit:after{width:300px;height:300px}.mockup-aislacion .sun{width:65px;height:65px;background:#f1bd48;border-radius:50%;box-shadow:0 0 35px #e9a52a99}.mockup-aislacion .planet{position:absolute;border-radius:50%;background:var(--accent)}.mockup-aislacion .p1{width:20px;height:20px;left:28%;top:29%}.mockup-aislacion .p2{width:30px;height:30px;right:18%;top:45%}.mockup-aislacion .p3{width:25px;height:25px;left:32%;bottom:13%}.mockup-aislacion .ship{position:absolute;right:26%;top:25%;font-size:38px;color:var(--blue);transform:rotate(-25deg)}.mockup-aislacion .moon .earth{width:130px;height:130px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#7ec9a4 0 20%,#3987af 22% 100%)}.mockup-aislacion .moon .luna{position:absolute;width:62px;height:62px;border-radius:50%;right:16%;top:20%;background:#eee6cf;box-shadow:inset -18px 3px #aaa49a}.mockup-aislacion .tide{position:absolute;left:12%;right:12%;bottom:34px;height:35px;background:repeating-radial-gradient(ellipse at 20px 30px,#3994b9 0 12px,transparent 13px 25px)}.mockup-aislacion .coffee .cup{font-size:110px}.mockup-aislacion .steam{position:absolute;top:50px;width:18px;height:80px;border-left:5px solid var(--accent);border-radius:50%}.mockup-aislacion .s1{left:43%}.mockup-aislacion .s2{left:55%;top:65px}.mockup-aislacion .beer .glass{width:130px;height:205px;border:7px solid var(--blue);border-top-width:12px;border-radius:12px 12px 35px 35px;position:relative;overflow:hidden}.mockup-aislacion .beer .glass i{position:absolute;inset:35px 0 0;background:#e5a63f}.mockup-aislacion .beer .glass b{position:absolute;left:0;right:0;top:18px;height:38px;background:#fff4d5;border-radius:50%;z-index:2}.mockup-aislacion .beer>span{position:absolute;bottom:20px;font-weight:950;color:var(--blue)}.mockup-aislacion .cup{grid-template-columns:1fr auto 1fr;gap:18px}.mockup-aislacion .measurecup{width:125px;height:155px;border:6px solid var(--blue);border-radius:10px 10px 35px 35px;position:relative}.mockup-aislacion .measurecup i{position:absolute;inset:45% 0 0;background:var(--accent)}.mockup-aislacion .measurecup b{position:absolute;top:18px;left:0;right:0;text-align:center;font-size:12px}.mockup-aislacion .cup>span{font-size:45px;color:var(--accent)}.mockup-aislacion .weight{padding:25px 18px;background:var(--soft);border-radius:18px;font-size:25px;font-weight:950}.mockup-aislacion .wall{display:flex;width:240px;height:210px;border:8px solid var(--blue)}.mockup-aislacion .wall i{flex:1;border-right:2px solid #fff;background:repeating-linear-gradient(45deg,var(--accent) 0 8px,var(--soft) 9px 17px)}.mockup-aislacion .cold,.mockup-aislacion .warm{position:absolute;font-size:25px;font-weight:950}.mockup-aislacion .cold{left:18px;color:#3182a0}.mockup-aislacion .warm{right:18px;color:#c26734}.mockup-aislacion .dial{width:215px;height:215px;border-radius:50%;border:18px solid var(--blue);display:grid;place-items:center;position:relative}.mockup-aislacion .dial i{position:absolute;width:7px;height:75px;background:var(--accent);bottom:50%;transform-origin:bottom;transform:rotate(35deg)}.mockup-aislacion .dial b{font-size:52px;margin-top:30px}.mockup-aislacion .dial small{position:absolute;bottom:38px}.mockup-aislacion .clockface{width:210px;height:210px;border:12px solid var(--blue);border-radius:50%;position:relative}.mockup-aislacion .clockface i,.mockup-aislacion .clockface b{position:absolute;left:50%;bottom:50%;width:7px;background:var(--accent);transform-origin:bottom}.mockup-aislacion .clockface i{height:72px;transform:rotate(90deg)}.mockup-aislacion .clockface b{height:55px;transform:rotate(10deg)}.mockup-aislacion .clock>span{position:absolute;bottom:24px;font-size:23px;font-weight:950}.mockup-aislacion .drop i{width:150px;height:190px;background:var(--accent);border-radius:70% 30% 70% 30%;transform:rotate(45deg)}.mockup-aislacion .drop span{position:absolute;color:#fff;font-size:32px;font-weight:950}.mockup-aislacion .bubble{position:absolute;padding:18px 24px;border-radius:24px;background:var(--soft);border:2px solid var(--accent);font-weight:950;font-size:23px}.mockup-aislacion .bubble.a{left:9%;top:20%}.mockup-aislacion .bubble.b{right:9%;top:34%}.mockup-aislacion .bubble.c{left:28%;bottom:16%}.mockup-aislacion .pages{width:240px;height:175px;display:flex;perspective:500px}.mockup-aislacion .pages i{width:50%;background:#fff;border:6px solid var(--blue)}.mockup-aislacion .pages i:first-child{transform:rotateY(14deg)}.mockup-aislacion .pages i:last-child{transform:rotateY(-14deg)}.mockup-aislacion .book>span{position:absolute;bottom:27px;font-weight:950;color:var(--accent)}.mockup-aislacion .sheet{width:180px;height:230px;border:5px solid var(--blue);background:#fff;border-radius:12px;padding:25px}.mockup-aislacion .sheet b{font-size:55px;color:var(--accent)}.mockup-aislacion .sheet i{display:block;border-top:6px solid #cbd7db;margin-top:17px}.mockup-aislacion .timer{position:absolute;right:22px;bottom:24px;padding:12px;background:var(--blue);color:#fff;border-radius:10px;font-weight:950}.mockup-aislacion .target{width:220px;height:220px;border:24px solid var(--accent);border-radius:50%;box-shadow:inset 0 0 0 26px #fff,inset 0 0 0 48px var(--blue);display:grid;place-items:center}.mockup-aislacion .target b{font-size:44px;background:#fff;border-radius:50%;padding:18px}.mockup-aislacion .parrilla{width:245px;height:160px;border:10px solid var(--blue);border-radius:18px;display:flex;gap:12px;padding:28px}.mockup-aislacion .parrilla i{flex:1;border-radius:30px;background:var(--accent)}.mockup-aislacion .fire{position:absolute;bottom:12px;font-size:60px;color:#e78a35}.mockup-aislacion .timeline .line{position:absolute;left:12%;right:12%;top:50%;height:8px;background:var(--blue);display:flex;justify-content:space-between}.mockup-aislacion .timeline .line i{width:29px;height:29px;border:7px solid var(--blue);background:#fff;border-radius:50%;transform:translateY(-11px)}.mockup-aislacion .truck{position:absolute;left:30%;top:38%;font-size:50px;color:var(--accent)}.mockup-aislacion .donut{width:220px;height:220px;border-radius:50%;background:conic-gradient(var(--accent) 0 40%,#e7af53 40% 65%,#4d98a1 65% 80%,#dce4e4 80%);position:relative}.mockup-aislacion .donut:after{content:"";position:absolute;inset:55px;background:#fff;border-radius:50%}.mockup-aislacion .budget>span{position:absolute;font-size:50px;font-weight:950;color:var(--blue)}
.mockup-aislacion .tool{padding:62px 22px}.mockup-aislacion .tool-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.mockup-aislacion .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-aislacion .tool h2,.mockup-aislacion .guide h2{font-size:37px;letter-spacing:-.04em;margin:7px 0}.mockup-aislacion .tool-head p{max-width:510px;color:var(--muted);margin:0}.mockup-aislacion .workspace{display:grid;grid-template-columns:.88fr 1.12fr;gap:20px}.mockup-aislacion .panel{border-radius:24px;padding:27px}.mockup-aislacion .form{border:1px solid var(--line);box-shadow:0 16px 40px #18374a0c}.mockup-aislacion .panel h3{font-size:21px;margin:0 0 5px}.mockup-aislacion .hint{color:var(--muted);font-size:14px;margin:0 0 20px}.mockup-aislacion .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-aislacion .field{margin-bottom:2px}.mockup-aislacion .field label{display:flex;justify-content:space-between;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-aislacion .field output{color:var(--accent)}.mockup-aislacion input,.mockup-aislacion select{width:100%;min-height:49px;border:1px solid #ccd7da;border-radius:12px;background:#fff;padding:12px 14px;color:var(--ink)}.mockup-aislacion input[type=range]{padding:0;accent-color:var(--accent)}.mockup-aislacion .actions{display:flex;gap:9px;margin-top:21px}.mockup-aislacion .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:14px;font-weight:900;cursor:pointer}.mockup-aislacion .reset{border:1px solid #d7aa58;border-radius:12px;background:#fff;color:#654a1f;padding:13px 16px;font-weight:850;cursor:pointer}.mockup-aislacion .result{background:linear-gradient(145deg,var(--blue),color-mix(in srgb,var(--blue),var(--accent) 35%));color:#fff;position:relative;overflow:hidden}.mockup-aislacion .badge{display:inline-block;padding:7px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:950}.mockup-aislacion .big{font-size:48px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:14px 0 5px}.mockup-aislacion .caption{color:#dceaf0;font-size:14px}.mockup-aislacion .meter{height:13px;border-radius:99px;background:#ffffff2d;margin:24px 0;position:relative}.mockup-aislacion .meter i{position:absolute;left:var(--position);top:50%;width:24px;height:24px;border:5px solid #fff;background:var(--accent);border-radius:50%;transform:translate(-50%,-50%);transition:.25s}.mockup-aislacion .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.mockup-aislacion .metric{padding:13px;border:1px solid #ffffff2b;background:#ffffff0e;border-radius:13px}.mockup-aislacion .metric small{display:block;color:#dceaf0;font-size:10px}.mockup-aislacion .metric b{font-size:16px}.mockup-aislacion .note{margin-top:17px;padding:14px 15px;border-radius:12px;background:var(--cream);color:#58461f;font-size:13px}.mockup-aislacion .guide{padding:65px 22px;background:var(--paper)}.mockup-aislacion .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px}.mockup-aislacion .guide p{color:var(--muted)}.mockup-aislacion .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.mockup-aislacion .step{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff}.mockup-aislacion .step b{display:block;color:var(--accent);margin-bottom:5px}.mockup-aislacion .step span{font-size:14px;color:var(--muted)}.mockup-aislacion .foot{padding:30px;text-align:center;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-aislacion .nav{display:none}.mockup-aislacion .hero-grid,.mockup-aislacion .workspace,.mockup-aislacion .guide-grid{grid-template-columns:1fr}.mockup-aislacion .tool-head{flex-direction:column;align-items:start}}@media(max-width:550px){.mockup-aislacion .fields,.mockup-aislacion .metrics,.mockup-aislacion .steps{grid-template-columns:1fr}.mockup-aislacion .hero h1{font-size:43px}.mockup-aislacion .actions{flex-direction:column}.mockup-aislacion .art{height:290px}}

.mockup-aislacion { width:100%; overflow:hidden; }
.mockup-aislacion .top, .mockup-aislacion header.top { display:none !important; }
.mockup-aislacion .foot { display:none !important; }
.mockup-aislacion .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-aislacion .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-aislacion .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-aislacion .support-real summary { cursor:pointer; font-weight:750; }
.mockup-aislacion .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-aislacion :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-aislacion input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-aislacion input[type="number"]::-webkit-inner-spin-button, .mockup-aislacion input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-aislacion .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-aislacion support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
