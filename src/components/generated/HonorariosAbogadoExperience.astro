.mockup-honorarios-abogado { width:100%; overflow:hidden; }
.mockup-honorarios-abogado .top, .mockup-honorarios-abogado header.top { display:none !important; }
.mockup-honorarios-abogado .foot { display:none !important; }
.mockup-honorarios-abogado .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-honorarios-abogado .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
