<div class="mockup-feriados-peru" set:html={`<section class="hero"><div class="wrap"><div class="crumb"><span>Perú</span> / Feriados 2026</div><div class="heroGrid"><div><div class="eyebrow">Calendario oficial actualizado</div><h1>Todos los feriados de Perú. Y cómo aprovecharlos mejor.</h1><p class="lead">Fechas nacionales, días no laborables y puentes posibles en un calendario claro para organizar trabajo, descanso y viajes.</p><div class="heroStats"><div class="stat"><strong>16</strong><span>feriados nacionales</span></div><div class="stat"><strong>4</strong><span>fines de semana largos</span></div><div class="stat"><strong>7</strong><span>puentes posibles</span></div></div></div><aside class="nextCard"><div class="nextTop"><span>Próximo feriado</span><span>2026</span></div><div class="nextDate">6 de agosto</div><div class="nextName">Batalla de Junín</div><div class="countdown"><span>Jueves · feriado nacional</span><b>en 6 días</b></div></aside></div></div></section>
<section class="planner"><div class="wrap"><div class="shell"><div class="toolbar"><h2>Calendario 2026</h2><button class="filter active" data-filter="all">Todos</button><button class="filter" data-filter="national">Nacionales</button><button class="filter" data-filter="public">Sector público</button><button class="viewBtn active" data-view="calendar">▦</button><button class="viewBtn" data-view="list">☷</button></div><div class="calendarView" id="calendarView"><div class="months" id="months"></div></div><div class="listView" id="listView"></div><div class="legend"><span><i></i> Feriado nacional</span><span><i class="pub"></i> Día no laborable compensable</span></div></div></div></section>
<section class="opportunities"><div class="wrap"><div class="center"><div class="eyebrow">Planificá tus días</div><h2>Los mejores fines de semana largos</h2><p>Cuatro descansos de tres días sin pedir licencia.</p></div><div class="tripGrid"><article class="trip"><span class="monthTag">Abril</span><h3>Semana Santa</h3><p>Del jueves 2 al domingo 5 de abril, combinando Jueves y Viernes Santo.</p><div class="daysOff">4 días seguidos</div></article><article class="trip"><span class="monthTag">Mayo</span><h3>Día del Trabajo</h3><p>Viernes 1 de mayo pegado al sábado y domingo.</p><div class="daysOff">3 días seguidos</div></article><article class="trip"><span class="monthTag">Junio</span><h3>San Pedro y San Pablo</h3><p>Lunes 29 de junio para un descanso desde el sábado.</p><div class="daysOff">3 días seguidos</div></article><article class="trip"><span class="monthTag">Diciembre</span><h3>Navidad</h3><p>Viernes 25 de diciembre unido al último fin de semana del año.</p><div class="daysOff">3 días seguidos</div></article></div></div></section>
<section class="labor"><div class="wrap laborGrid"><div><div class="eyebrow">No son lo mismo</div><h2>Feriado vs. día no laborable</h2><p>La diferencia cambia si descansás obligatoriamente, si recuperás horas y si aplica automáticamente al sector privado.</p></div><div class="compare"><div class="compareRow head"><span></span><strong>Feriado nacional</strong><strong>Día no laborable</strong></div><div class="compareRow"><span>Descanso remunerado</span><strong class="yes">Sí</strong><strong>Compensable</strong></div><div class="compareRow"><span>Sector privado</span><strong class="yes">Aplica</strong><strong>Previo acuerdo</strong></div><div class="compareRow"><span>Si trabajás</span><strong>Pago con sobretasa</strong><strong>Según acuerdo</strong></div><div class="compareRow"><span>Horas a recuperar</span><strong>No</strong><strong class="yes">Sí</strong></div></div></div></section>
<section class="faq"><div class="wrap"><div class="center"><div class="eyebrow">Preguntas frecuentes</div><h2>Antes de hacer planes</h2></div><div class="faqWrap"><div class="faqItem open"><button class="faqQ">¿Cuántos feriados nacionales tiene Perú en 2026?<span>−</span></button><div class="faqA">El calendario incluye 16 feriados nacionales con descanso obligatorio remunerado para los sectores público y privado.</div></div><div class="faqItem"><button class="faqQ">¿Qué pasa si trabajo un feriado?<span>+</span></button><div class="faqA">Si trabajás sin descanso sustitutorio, corresponde la remuneración del feriado más el pago por el trabajo realizado con la sobretasa prevista por la legislación laboral.</div></div><div class="faqItem"><button class="faqQ">¿El 27 de julio es feriado nacional?<span>+</span></button><div class="faqA">No. En 2026 fue declarado día no laborable compensable para el sector público. En el sector privado puede aplicarse mediante acuerdo con el empleador.</div></div></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="search" hidden aria-hidden="true"></button><button type="button" id="contrast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-feriados-peru')?document.currentScript.previousElementSibling:document.querySelector('.mockup-feriados-peru');if(!root)return;

const $=id=>root.querySelector("#"+id),names=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const holidays=[['2026-01-01','Año Nuevo','national'],['2026-04-02','Jueves Santo','national'],['2026-04-03','Viernes Santo','national'],['2026-05-01','Día del Trabajo','national'],['2026-06-07','Batalla de Arica y Día de la Bandera','national'],['2026-06-29','San Pedro y San Pablo','national'],['2026-07-23','Día de la Fuerza Aérea del Perú','national'],['2026-07-27','Día no laborable compensable','public'],['2026-07-28','Fiestas Patrias','national'],['2026-07-29','Fiestas Patrias','national'],['2026-08-06','Batalla de Junín','national'],['2026-08-30','Santa Rosa de Lima','national'],['2026-10-08','Combate de Angamos','national'],['2026-11-01','Día de Todos los Santos','national'],['2026-12-08','Inmaculada Concepción','national'],['2026-12-09','Batalla de Ayacucho','national'],['2026-12-25','Navidad','national']];let filter='all';
const key=(m,d)=>`2026-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`,visible=h=>filter==='all'||h[2]===filter;
function render(){const box=$('months');box.innerHTML='';for(let m=0;m<12;m++){const el=document.createElement('section');el.className='month';const relevant=holidays.filter(h=>Number(h[0].slice(5,7))===m+1&&visible(h));el.innerHTML=`<div class="monthHead"><b>${names[m]}</b><span>${relevant.length?relevant.length+' fecha'+(relevant.length>1?'s':''):''}</span></div><div class="week">${['L','M','M','J','V','S','D'].map(x=>'<span>'+x+'</span>').join('')}</div><div class="days"></div>`;const days=el.querySelector('.days'),first=(new Date(2026,m,1).getDay()+6)%7,total=new Date(2026,m+1,0).getDate();for(let i=0;i<first;i++)days.innerHTML+='<span class="day blank">0</span>';for(let d=1;d<=total;d++){const h=holidays.find(x=>x[0]===key(m,d)&&visible(x)),dow=new Date(2026,m,d).getDay(),today=key(m,d)==='2026-07-29';days.innerHTML+=`<button class="day ${dow===0||dow===6?'weekend ':''}${h?'holiday '+h[2]:''}${today?' today':''}" ${h?`data-name="${h[1]}" data-date="${d} de ${names[m]}"`:''}>${d}</button>`}box.appendChild(el)}box.querySelectorAll('[data-name]').forEach(b=>b.onclick=()=>{ $('toast').textContent=b.dataset.date+' · '+b.dataset.name;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1800)});renderList()}
function renderList(){const rows=holidays.filter(visible);$('listView').innerHTML=rows.length?rows.map(h=>{const d=new Date(h[0]+'T12:00:00'),weekday=d.toLocaleDateString('es-PE',{weekday:'long'}),bridge=[2,4].includes(d.getDay())?'Puente posible':'',parts=h[0].split('-');return `<div class="holidayRow"><div class="dateBox">${parts[2]}/${parts[1]}</div><div><b>${h[1]}</b><small>${weekday[0].toUpperCase()+weekday.slice(1)}</small></div><span class="type">${h[2]==='national'?'Feriado nacional':'Sector público'}</span><span class="bridge">${bridge}</span></div>`}).join(''):'<div class="emptyState">No hay fechas para este filtro.</div>'}
root.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;root.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render()});root.querySelectorAll('.viewBtn').forEach(b=>b.onclick=()=>{root.querySelectorAll('.viewBtn').forEach(x=>x.classList.toggle('active',x===b));const cal=b.dataset.view==='calendar';$('calendarView').style.display=cal?'block':'none';$('listView').style.display=cal?'none':'block'});
root.querySelectorAll('.faqQ').forEach(q=>q.onclick=()=>{q.parentElement.classList.toggle('open');q.lastElementChild.textContent=q.parentElement.classList.contains('open')?'−':'+'});$('search').onclick=()=>{const q=prompt('¿Qué querés calcular?');if(q){$('toast').textContent='Buscando “'+q+'”…';$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1500)}};$('contrast').onclick=()=>{document.body.style.filter=document.body.style.filter?'':'contrast(1.05)';$('toast').textContent='Contraste ajustado';$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1400)};render();

})();
</script>
