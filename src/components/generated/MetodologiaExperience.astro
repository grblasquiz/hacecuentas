.mockup-metodologia :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,:is(button, a.hc-tool-link),summary,li,th,td){color:inherit}
.mockup-metodologia input[type="number"]{-moz-appearance:textfield;appearance:textfield}
.mockup-metodologia input[type="number"]::-webkit-inner-spin-button,.mockup-metodologia input[type="number"]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
