<div class="mockup-jubilacion-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Jubilación</div><div class="heroGrid"><div><span class="eyebrow">Tu futuro, con números de hoy</span><h1>No esperes al último año para hacer la cuenta.</h1><p class="lead">Revisá edad, aportes, fecha posible y haber estimado. Si hay una brecha, compará caminos antes de elegir.</p><div class="trust"><span>✓ Edad y aportes separados</span><span>✓ Escenarios comparables</span><span>✓ Datos privados</span></div><div class="pathArt"><i class="milestone one"></i><i class="milestone two"></i><i class="milestone three"></i><span class="pathLabel a">HOY</span><span class="pathLabel b">APORTES</span><span class="pathLabel c">RETIRO</span></div></div>
<div class="calc"><div class="calcHead"><div><h2>Tu punto de partida</h2><p>Una primera foto previsional.</p></div><span class="live">ESTIMACIÓN EN VIVO</span></div><div class="fields"><div class="field"><label>Edad actual</label><div class="input"><input id="age" type="number" min="18" max="90" value="58"><span>años</span></div></div><div class="field"><label>Sexo registral</label><select id="sex"><option value="female">Mujer</option><option value="male">Varón</option></select></div><div class="field"><label>Años de aportes reconocidos</label><div class="input"><input id="years" type="number" min="0" max="50" value="24"><span>años</span></div></div><div class="field"><label>Ingreso bruto promedio</label><div class="input"><span>$</span><input id="salary" value="1500000"></div></div><div class="field wide"><label>Situación laboral actual</label><select id="status"><option value="employee">En relación de dependencia</option><option value="mono">Monotributista</option><option value="none">Sin aportes actuales</option></select></div></div><button class="primary" id="calculate">Actualizar mi escenario</button><div class="result"><div class="resultTop"><div><small>PRIMERA FECHA POSIBLE ESTIMADA</small><div class="amount" id="date">Julio de 2032</div></div><span class="badge" id="verdict">Faltan edad y aportes</span></div><div class="conditions"><div class="condition"><span>CONDICIÓN DE EDAD</span><b id="ageCondition">58 de 60 años</b><div class="progress"><i id="ageBar"></i></div></div><div class="condition"><span>CONDICIÓN DE APORTES</span><b id="yearCondition">24 de 30 años</b><div class="progress"><i id="yearBar"></i></div></div></div><div class="resultGrid"><div class="metric"><span>APORTES FALTANTES</span><b id="missing">6 años</b></div><div class="metric"><span>HABER ORIENTATIVO</span><b id="benefit">$825.000</b></div><div class="metric"><span>TIEMPO ESTIMADO</span><b id="wait">6 años</b></div></div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por tu pregunta</span><h2>¿Qué necesitás entender?</h2><p>Elegí tu situación y te mostramos primero las herramientas adecuadas.</p></div><div class="needs"><button class="need active" data-filter="date"><span class="icon">▦</span><h3>¿Cuándo puedo jubilarme?</h3><p>Edad, aportes y primera fecha posible.</p><em>→</em></button><button class="need" data-filter="amount"><span class="icon">$</span><h3>¿Cuánto voy a cobrar?</h3><p>Haber estimado y componentes del cálculo.</p><em>→</em></button><button class="need" data-filter="gap"><span class="icon">＋</span><h3>Me faltan aportes</h3><p>Brecha, reconocimiento y alternativas.</p><em>→</em></button><button class="need" data-filter="plan"><span class="icon">↗</span><h3>Quiero complementar</h3><p>Ahorro, retiro y objetivo mensual.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas previsionales</span><h2>Todo el recorrido, ordenado.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="date">Fecha</button><button class="filter" data-filter="amount">Haber</button><button class="filter" data-filter="gap">Aportes</button><button class="filter" data-filter="plan">Complemento</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="amount" data-text="cuánto voy cobrar jubilación haber anses"><span class="tag">La cuenta completa</span><h3>¿Cuánto voy a cobrar?</h3><p>Prestación básica, compensatoria y adicional con un desglose comprensible.</p><button>Estimar mi haber →</button></article><article class="card" data-cat="date gap" data-text="edad aportes fecha jubilación"><span class="tag">Requisitos</span><h3>Edad y aportes necesarios</h3><p>Qué condición cumplís y cuál determina la fecha.</p><button>Calcular fecha →</button></article><article class="card" data-cat="gap" data-text="aportes faltantes moratoria reconocimiento tareas cuidado"><span class="tag">Brecha previsional</span><h3>¿Qué hago si me faltan aportes?</h3><p>Ordená historia laboral y compará alternativas disponibles.</p><button>Revisar opciones →</button></article><article class="card" data-cat="gap date" data-text="historia laboral años meses aportados"><span class="tag">Mi ANSES</span><h3>Contador de aportes</h3><p>Sumá períodos, detectá huecos y evitá doble conteo.</p><button>Contar aportes →</button></article><article class="card" data-cat="plan" data-text="retiro ahorro complemento jubilación meta"><span class="tag">Planificación</span><h3>Complemento para el retiro</h3><p>Capital y aporte mensual para alcanzar un ingreso objetivo.</p><button>Armar plan →</button></article><article class="card" data-cat="amount plan" data-text="jubilación inflación poder compra haber futuro"><span class="tag">Poder de compra</span><h3>Haber futuro e inflación</h3><p>Compará montos nominales y reales en distintos escenarios.</p><button>Comparar →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Compará caminos</span><h2>La misma brecha puede tener varias respuestas.</h2></div><div class="scenarioGrid"><article class="scenario"><small>ESCENARIO 01</small><h3>Seguir aportando</h3><p>Proyectá cuándo completarías los 30 años manteniendo tu situación actual.</p><button data-scenario="Seguir aportando">Ver escenario →</button></article><article class="scenario recommended"><small>ESCENARIO 02 · REVISAR PRIMERO</small><h3>Reconstruir la historia laboral</h3><p>Antes de pagar o esperar, verificá períodos faltantes, empleadores y tareas de cuidado.</p><button data-scenario="Historia laboral">Armar checklist →</button></article><article class="scenario"><small>ESCENARIO 03</small><h3>Complementar el ingreso</h3><p>Separá el haber previsional de la meta total y calculá el capital faltante.</p><button data-scenario="Complemento">Calcular complemento →</button></article></div><div class="guide"><article class="panel"><h3>Documentos para empezar</h3><p>Una buena estimación depende de que la historia laboral esté completa.</p><div class="line"><span>Historia laboral</span><b>Mi ANSES</b></div><div class="line"><span>Recibos y certificaciones</span><b>Guardar</b></div><div class="line"><span>Períodos autónomos</span><b>Verificar pagos</b></div></article><article class="panel"><h3>Importante</h3><p>Esta herramienta es orientativa. Regímenes especiales, moratorias, tareas de cuidado, invalidez, pensiones y cambios normativos pueden modificar los requisitos y el haber.</p><div class="line"><span>Fuente principal</span><b>ANSES · normativa vigente</b></div><div class="line"><span>Decisión definitiva</span><b>Consulta previsional</b></div></article></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-jubilacion-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-jubilacion-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],num=id=>Math.max(0,Number($(id).value.replaceAll(".","").replaceAll(",",""))||0),money=n=>"$"+Math.round(n).toLocaleString("es-AR");
function calc(){const age=num("#age"),years=num("#years"),target=$("#sex").value==="male"?65:60,missingAge=Math.max(0,target-age),missingYears=Math.max(0,30-years),active=$("#status").value!=="none",wait=active?Math.max(missingAge,missingYears):missingAge,year=new Date().getFullYear()+Math.ceil(wait),benefit=num("#salary")*.55;$("#date").textContent=wait?`Julio de ${year}`:"Podrías iniciar el trámite";$("#verdict").textContent=missingAge&&missingYears?"Faltan edad y aportes":missingAge?"Falta edad":missingYears?"Faltan aportes":"Requisitos generales cumplidos";$("#ageCondition").textContent=`${age} de ${target} años`;$("#yearCondition").textContent=`${years} de 30 años`;$("#ageBar").style.width=Math.min(100,age/target*100)+"%";$("#yearBar").style.width=Math.min(100,years/30*100)+"%";$("#missing").textContent=missingYears?missingYears+" años":"Completo";$("#benefit").textContent=money(benefit);$("#wait").textContent=active?(wait?Math.ceil(wait)+" años":"Ahora"):"Depende de regularización"}
$$(".calc input,.calc select").forEach(x=>x.oninput=calc);$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Escenario actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$("[data-scenario]").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.dataset.scenario));calc();

})();
</script>
