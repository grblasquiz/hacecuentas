<div class="mockup-familia-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Familia</div><div class="heroGrid"><div><span class="eyebrow">Cuentas para la vida en común</span><h1>Organizar la familia también es cuidar.</h1><p class="lead">Presupuesto, asignaciones, fechas y decisiones cotidianas. Todo claro para que la plata acompañe los planes de la casa.</p><div class="trust"><span>✓ Una foto mensual</span><span>✓ Gastos por categoría</span><span>✓ Todos los casos visibles</span></div><div class="scene"><i class="house"><i class="door"></i><i class="window"></i></i><i class="heart">♥</i></div></div>
<div class="planner"><div class="plannerHead"><div><h2>La foto de tu hogar</h2><p>Ingresos, esenciales y margen del mes.</p></div><span class="live">PRESUPUESTO EN VIVO</span></div><div class="familyTypes"><button class="familyType active" data-type="pareja">Pareja</button><button class="familyType" data-type="hijos">Con hijos</button><button class="familyType" data-type="monoparental">Un adulto</button></div><div class="fields"><div class="field"><label>Ingresos mensuales del hogar</label><div class="input"><span>$</span><input id="income" type="number" min="0" value="2400000"></div></div><div class="field"><label>Vivienda + servicios</label><div class="input"><span>$</span><input id="home" type="number" min="0" value="780000"></div></div><div class="field"><label>Comida + transporte</label><div class="input"><span>$</span><input id="daily" type="number" min="0" value="620000"></div></div><div class="field"><label>Educación + cuidados</label><div class="input"><span>$</span><input id="care" type="number" min="0" value="310000"></div></div><div class="field"><label>Otros gastos</label><div class="input"><span>$</span><input id="other" type="number" min="0" value="210000"></div></div><div class="field"><label>Personas en el hogar</label><div class="input"><input id="people" type="number" min="1" value="4"><span>personas</span></div></div></div><button class="primary" id="calculate">Actualizar presupuesto</button><div class="result"><div class="resultTop"><div><small>DISPONIBLE DESPUÉS DE GASTOS</small><div class="amount" id="available">$480.000</div></div><span class="signal" id="signal">Margen saludable</span></div><div class="resultGrid"><div class="metric"><span>GASTOS TOTALES</span><b id="expenses">$1.920.000</b></div><div class="metric"><span>POR PERSONA</span><b id="perPerson">$480.000</b></div><div class="metric"><span>COLCHÓN SUGERIDO</span><b id="cushion">$192.000</b></div></div><div class="bar"><i id="budgetBar"></i></div><p class="note" id="note">El 80% de los ingresos está comprometido; queda un 20% para ahorro y objetivos.</p></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Empezá por lo que necesitás resolver</span><h2>Una herramienta para cada momento familiar.</h2><p>Elegí una necesidad y te mostramos primero las cuentas relacionadas.</p></div><div class="needs"><button class="need active" data-filter="budget"><span class="icon">$</span><h3>Ordenar el mes</h3><p>Ingresos, gastos y ahorro posible.</p><em>→</em></button><button class="need" data-filter="benefits"><span class="icon">✓</span><h3>Conocer beneficios</h3><p>Asignaciones y fechas de pago.</p><em>→</em></button><button class="need" data-filter="children"><span class="icon">↗</span><h3>Acompañar a los chicos</h3><p>Crecimiento, edades y etapas.</p><em>→</em></button><button class="need" data-filter="dates"><span class="icon">□</span><h3>Ordenar fechas</h3><p>Embarazo, cumpleaños y calendarios.</p><em>→</em></button><button class="need" data-filter="home"><span class="icon">⌂</span><h3>Gestionar la casa</h3><p>Servicios y cuentas compartidas.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas para la familia</span><h2>Decisiones cotidianas con números claros.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="budget">Presupuesto</button><button class="filter" data-filter="benefits">Beneficios</button><button class="filter" data-filter="children">Hijos</button><button class="filter" data-filter="dates">Fechas</button><button class="filter" data-filter="home">Hogar</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="budget home" data-text="presupuesto familiar gastos mes hogar ahorro"><span class="tag">Plan completo</span><h3>Presupuesto familiar</h3><p>Ordená ingresos, gastos esenciales, variables y objetivos compartidos.</p><button>Armar presupuesto →</button></article><article class="card" data-cat="benefits children" data-text="asignaciones anses auh suaf hijos cobro"><span class="tag">Beneficios</span><h3>Asignaciones ANSES</h3><p>Identificá qué asignación puede corresponder y cómo se calcula.</p><button>Consultar →</button></article><article class="card" data-cat="benefits dates" data-text="calendario pagos anses fechas cobro"><span class="tag">Calendario</span><h3>Calendario de pagos</h3><p>Fechas organizadas por prestación y terminación.</p><button>Ver fechas →</button></article><article class="card" data-cat="children" data-text="crecimiento infantil peso altura percentil chicos"><span class="tag">Crecimiento</span><h3>Crecimiento infantil</h3><p>Referencias de peso y altura por edad.</p><button>Ver herramienta →</button></article><article class="card" data-cat="dates children" data-text="edad exacta cumpleaños dias meses años"><span class="tag">Fechas</span><h3>Edad exacta</h3><p>Años, meses y días desde una fecha de nacimiento.</p><button>Calcular edad →</button></article><article class="card" data-cat="dates" data-text="embarazo semanas fecha parto trimestre"><span class="tag">Embarazo</span><h3>Semanas de embarazo</h3><p>Semana actual, trimestre y fecha probable de parto.</p><button>Calcular semanas →</button></article><article class="card" data-cat="home budget" data-text="cuentas casa servicios reparto gastos"><span class="tag">Casa</span><h3>Cuentas de la casa</h3><p>Repartí servicios y gastos compartidos.</p><button>Ordenar cuentas →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap decisions"><div><span class="eyebrow">Tres conversaciones importantes</span><h2>Primero claridad. Después acuerdos.</h2><p class="lead">No todo se resuelve recortando. Separá lo esencial, definí objetivos compartidos y acordá cómo absorber los meses más caros.</p></div><div class="rooms"><button class="room active" data-room="Gastos esenciales"><span><b>1. ¿Qué gastos son realmente esenciales?</b><small>Separalos de los flexibles antes de ajustar.</small></span><b>→</b></button><button class="room" data-room="Objetivos"><span><b>2. ¿Qué objetivo comparte la familia?</b><small>Convertí el ahorro en una meta visible.</small></span><b>→</b></button><button class="room" data-room="Imprevistos"><span><b>3. ¿Cómo cubrimos un imprevisto?</b><small>Definí un colchón antes de necesitarlo.</small></span><b>→</b></button></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button><button type="button" id="navSearch" hidden aria-hidden="true"></button><button type="button" id="country" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-familia-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-familia-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],money=n=>"$"+Math.round(n).toLocaleString("es-AR");function calc(){const inc=Math.max(0,+$("#income").value||0),home=Math.max(0,+$("#home").value||0),daily=Math.max(0,+$("#daily").value||0),care=Math.max(0,+$("#care").value||0),other=Math.max(0,+$("#other").value||0),people=Math.max(1,+$("#people").value||1),expenses=home+daily+care+other,available=inc-expenses,ratio=inc?expenses/inc:1,pct=Math.round(ratio*100);$("#available").textContent=(available<0?"−":"")+money(Math.abs(available));$("#expenses").textContent=money(expenses);$("#perPerson").textContent=money(expenses/people);$("#cushion").textContent=money(expenses*.1);$("#budgetBar").style.width=Math.min(100,pct)+"%";let signal=available<0?"Hay que ajustar":ratio>.85?"Margen muy justo":ratio>.7?"Margen cuidado":"Margen saludable";$("#signal").textContent=signal;$("#signal").style.background=available<0?"#a94f42":ratio>.85?"#9a6a32":"#28725e";$("#note").textContent=`El ${pct}% de los ingresos está comprometido; ${available>=0?"queda un "+Math.max(0,100-pct)+"% para ahorro y objetivos.":"los gastos superan el ingreso mensual."}`}
$$(".planner input").forEach(x=>x.oninput=calc);const presets={pareja:[2400000,650000,500000,0,220000,2],hijos:[2400000,780000,620000,310000,210000,4],monoparental:[1400000,520000,390000,180000,130000,2]};$$(".familyType").forEach(b=>b.onclick=()=>{$$(".familyType").forEach(x=>x.classList.toggle("active",x===b));const v=presets[b.dataset.type],ids=["income","home","daily","care","other","people"];ids.forEach((id,i)=>$("#"+id).value=v[i]);calc()});$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Presupuesto actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".need").forEach(b=>b.onclick=()=>{$$(".need").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1500)}$$(".card button").forEach(b=>b.onclick=()=>toast("Abriendo: "+b.closest(".card").querySelector("h3").textContent));$$(".room").forEach(b=>b.onclick=()=>{$$(".room").forEach(x=>x.classList.toggle("active",x===b));toast("Conversación seleccionada: "+b.dataset.room)});$("#navSearch").onclick=()=>{$("#tools").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("#search").focus(),450)};$("#country").onclick=()=>toast("Selector de país disponible");calc();

})();
</script>
