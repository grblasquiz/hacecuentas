---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-almacenamiento" set:html={`<div class="crumb">Tecnología / Almacenamiento</div><h1>Antes de comprar espacio, mirá qué está ocupando el armario.</h1><p class="lead">Distribuí fotos, video, aplicaciones y sistema para estimar capacidad útil y margen de crecimiento.</p><section class="closet"><aside class="inputs"><h2>Uso actual (GB)</h2><label>Fotos<input id="photos" type="number" value="140"></label><label>Video<input id="video" type="number" value="320"></label><label>Aplicaciones<input id="apps" type="number" value="110"></label><label>Sistema y otros<input id="system" type="number" value="90"></label><label>Capacidad del disco<input id="capacity" type="number" value="1000"></label></aside><section class="drive"><div class="shelves" id="shelves"></div><div class="summary"><span>Usado<br><b id="used"></b></span><span>Libre<br><b id="free"></b></span></div><div class="warning" id="warning"></div></section></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-almacenamiento')?document.currentScript.previousElementSibling:document.querySelector('.mockup-almacenamiento');
const $=x=>root.querySelector("#"+x);function render(){let keys=['photos','video','apps','system'],vals=keys.map(k=>+$((k)).value),cap=+$('capacity').value,used=vals.reduce((a,b)=>a+b,0);$('shelves').innerHTML=keys.map((k,i)=>`<div class=\"shelf\"><div class=\"box ${k}\" style=\"width:${Math.min(100,vals[i]/cap*100)}%\">${vals[i]} GB</div></div>`).join('');$('used').textContent=used+' GB';$('free').textContent=Math.max(0,cap-used)+' GB';$('warning').textContent=used/cap>.85?'Menos de 15% libre: revisá video, duplicados y copias antes de ampliar.':`Tenés ${Math.round((cap-used)/Math.max(1,used)*12)} meses aproximados si el uso crece al ritmo actual.`}root.querySelectorAll('input').forEach(x=>x.oninput=render);render();
})();
</script>
<style is:global>
.mockup-almacenamiento{--blue:#174b7a;--ink:#182a32;--muted:#65747c;--line:#d7e1df;--green:#3d9d77;--orange:#e47a45;--purple:#775ba5;--paper:#f5f7f5}.mockup-almacenamiento *{box-sizing:border-box}.mockup-almacenamiento{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-almacenamiento input{font:inherit}.mockup-almacenamiento .shell{max-width:1160px;margin:auto;padding:34px 22px}.mockup-almacenamiento .crumb{color:var(--blue);font-weight:850}.mockup-almacenamiento h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-almacenamiento .lead{font-size:18px;color:var(--muted)}.mockup-almacenamiento .closet{display:grid;grid-template-columns:310px 1fr;gap:20px;margin-top:26px}.mockup-almacenamiento .inputs,.mockup-almacenamiento .drive{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-almacenamiento .inputs label{display:block;font-size:12px;font-weight:850;margin:14px 0}.mockup-almacenamiento .inputs input{display:block;width:100%;border:0;border-bottom:2px solid var(--line);padding:8px 0;color:var(--ink);font-weight:900}.mockup-almacenamiento .shelves{height:330px;border:14px solid var(--blue);padding:14px;display:grid;grid-template-rows:repeat(4,1fr);gap:8px}.mockup-almacenamiento .shelf{display:flex;border-bottom:7px solid var(--blue)}.mockup-almacenamiento .box{height:100%;display:grid;place-items:center;color:#fff;font-weight:900;min-width:3px}.mockup-almacenamiento .photos{background:var(--orange)}.mockup-almacenamiento .video{background:var(--purple)}.mockup-almacenamiento .apps{background:var(--green)}.mockup-almacenamiento .system{background:#8098a4}.mockup-almacenamiento .summary{display:flex;justify-content:space-between;margin-top:16px}.mockup-almacenamiento .summary b{font-size:28px;color:var(--blue)}.mockup-almacenamiento .warning{margin-top:14px;padding:13px;background:#fff2dd;border-left:5px solid var(--orange)}@media(max-width:760px){.mockup-almacenamiento .closet{grid-template-columns:1fr}}
.mockup-almacenamiento { width:100%; overflow:hidden; }
.mockup-almacenamiento .top, .mockup-almacenamiento header.top { display:none !important; }
.mockup-almacenamiento .foot { display:none !important; }
.mockup-almacenamiento .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-almacenamiento .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-almacenamiento .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-almacenamiento .support-real summary { cursor:pointer; font-weight:750; }
.mockup-almacenamiento .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-almacenamiento :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-almacenamiento input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-almacenamiento input[type="number"]::-webkit-inner-spin-button, .mockup-almacenamiento input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-almacenamiento .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-almacenamiento support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
