---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-capital-trabajo" set:html={`<div class="crumb">Negocios / Capital de trabajo</div><h1>La ganancia no paga una factura que vence hoy.</h1><p class="lead">Ordená cobros y pagos por semana para detectar el pozo de caja antes de que ocurra.</p><section class="inputs"><label>Caja inicial<input id="cash" type="number" value="800000"></label><label>Ventas mensuales<input id="sales" type="number" value="2400000"></label><label>Días hasta cobrar<input id="collect" type="number" value="30"></label><label>Costos mensuales<input id="cost" type="number" value="1900000"></label></section><section class="cashflow"><h2>Próximas ocho semanas</h2><div class="weeks" id="weeks"><i class="zero"></i></div></section><section class="summary"><div class="card"><span>Capital de trabajo mínimo</span><b id="need"></b></div><div class="card"><span>Semana más exigida</span><b id="worst"></b></div><div class="card risk"><span>Colchón recomendado</span><b id="buffer"></b></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-capital-trabajo')?document.currentScript.previousElementSibling:document.querySelector('.mockup-capital-trabajo');

const $=x=>root.querySelector("#"+x),money=n=>'$ '+Math.round(n).toLocaleString('es-AR');function render(){let cash=+$('cash').value,sales=+$('sales').value,delay=+$('collect').value,cost=+$('cost').value,weeklyCost=cost/4,balances=[],min=cash;for(let w=1;w<=8;w++){let income=w>Math.ceil(delay/7)?sales/4:0;cash+=income-weeklyCost;balances.push(cash);min=Math.min(min,cash)}let max=Math.max(...balances.map(Math.abs),1);$('weeks').innerHTML='<i class=\"zero\"></i>'+balances.map((v,i)=>`<div class=\"week\"><div class=\"bar ${v<0?'negative':''}\" style=\"height:${20+Math.abs(v)/max*210}px\"></div><b>S${i+1}<br>${money(v)}</b></div>`).join('');let need=Math.max(0,-min);$('need').textContent=money(need);$('worst').textContent='Semana '+(balances.indexOf(Math.min(...balances))+1);$('buffer').textContent=money(need+weeklyCost*.5)}
root.querySelectorAll('input').forEach(x=>x.oninput=render);render();

})();
</script>
<style is:global>

.mockup-capital-trabajo{--blue:#174b7a;--ink:#182a32;--muted:#65737b;--line:#d6e0de;--green:#3b9d76;--red:#d65d54;--yellow:#ffd36b;--paper:#f4f7f5}.mockup-capital-trabajo *{box-sizing:border-box}.mockup-capital-trabajo{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-capital-trabajo input,.mockup-capital-trabajo button{font:inherit}.mockup-capital-trabajo .shell{max-width:1180px;margin:auto;padding:34px 22px}.mockup-capital-trabajo .crumb{color:var(--blue);font-weight:850}.mockup-capital-trabajo h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-capital-trabajo .lead{font-size:18px;color:var(--muted)}.mockup-capital-trabajo .inputs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:25px 0}.mockup-capital-trabajo .inputs label{background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px;font-size:12px;font-weight:800}.mockup-capital-trabajo .inputs input{display:block;width:100%;border:0;border-bottom:2px solid var(--line);padding:8px 0;font-weight:900;color:var(--ink)}.mockup-capital-trabajo .cashflow{background:#fff;border:1px solid var(--line);border-radius:26px;padding:24px}.mockup-capital-trabajo .cashflow h2{margin:0}.mockup-capital-trabajo .weeks{display:grid;grid-template-columns:repeat(8,1fr);gap:7px;margin-top:24px;height:280px;align-items:end}.mockup-capital-trabajo .week{position:relative;display:flex;flex-direction:column;justify-content:flex-end;height:100%}.mockup-capital-trabajo .bar{border-radius:8px 8px 0 0;background:var(--green);min-height:8px}.mockup-capital-trabajo .bar.negative{background:var(--red)}.mockup-capital-trabajo .week b{text-align:center;font-size:11px;margin-top:6px}.mockup-capital-trabajo .zero{position:absolute;left:0;right:0;top:50%;border-top:2px dashed #95a5a0}.mockup-capital-trabajo .summary{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:16px}.mockup-capital-trabajo .card{border-radius:16px;padding:17px;background:#fff;border:1px solid var(--line)}.mockup-capital-trabajo .card b{display:block;font-size:27px;color:var(--blue)}.mockup-capital-trabajo .risk{background:var(--yellow)}@media(max-width:760px){.mockup-capital-trabajo .inputs,.mockup-capital-trabajo .summary{grid-template-columns:1fr 1fr}.mockup-capital-trabajo .weeks{overflow-x:auto}.mockup-capital-trabajo .week{min-width:55px}}
.mockup-capital-trabajo { width:100%; overflow:hidden; }
.mockup-capital-trabajo .top, .mockup-capital-trabajo header.top { display:none !important; }
.mockup-capital-trabajo .foot { display:none !important; }
.mockup-capital-trabajo .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-capital-trabajo .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-capital-trabajo .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-capital-trabajo .support-real summary { cursor:pointer; font-weight:750; }
.mockup-capital-trabajo .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-capital-trabajo :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-capital-trabajo input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-capital-trabajo input[type="number"]::-webkit-inner-spin-button, .mockup-capital-trabajo input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-capital-trabajo .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-capital-trabajo support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
