---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-estadistica-inferencial" set:html={`<div class="crumb">Matemática / Estadística inferencial</div><h1>Una muestra puede acertar. O puede engañarte.</h1><p class="lead">Tomá muestras repetidas de la misma población y observá qué intervalos alcanzan el valor real.</p><section class="controls"><div class="control"><label>Tamaño de muestra <output id="nOut">25</output></label><input id="n" type="range" min="5" max="80" value="25"></div><div class="control"><label>Nivel de confianza <output id="confOut">95%</output></label><input id="conf" type="range" min="80" max="99" value="95"></div><button id="sample">Tomar 12 muestras</button></section><section class="lab"><aside class="population"><h2>Población escondida</h2><div class="dots" id="dots"></div><div class="truth"><span>Media real del universo</span><b>50,0</b><small>En un caso real casi nunca la conocemos.</small></div><div class="lesson" id="lesson"></div></aside><section class="intervals"><h2>Intervalos obtenidos</h2><div class="rows" id="rows"><i class="target"></i></div><div class="coverage"><span>Cubren el valor real</span><b id="coverage"></b></div></section></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-estadistica-inferencial')?document.currentScript.previousElementSibling:document.querySelector('.mockup-estadistica-inferencial');

const $=x=>root.querySelector("#"+x);$('rows').style.position='relative';$('rows').style.overflow='hidden';let seed=9;function rand(){seed=(seed*9301+49297)%233280;return seed/233280}function normal(){return (rand()+rand()+rand()+rand()+rand()+rand()-3)*10+50}
function run(){seed+=17;let n=+$('n').value,conf=+$('conf').value,z=conf>=99?2.576:conf>=95?1.96:conf>=90?1.645:1.282,hit=0,rows=[];for(let k=0;k<12;k++){let a=Array.from({length:n},normal),mean=a.reduce((s,x)=>s+x,0)/n,sd=Math.sqrt(a.reduce((s,x)=>s+(x-mean)**2,0)/(n-1)),e=z*sd/Math.sqrt(n),lo=mean-e,hi=mean+e,ok=lo<=50&&hi>=50;if(ok)hit++;let L=Math.max(2,(lo-35)/30*96),W=Math.min(98-L,(hi-lo)/30*96);rows.push(`<div class="interval ${ok?'':'miss'}"><i style="left:${L}%;width:${W}%"></i><b style="left:${(mean-35)/30*96+2}%"></b></div>`)}$('rows').innerHTML='<i class="target"></i>'+rows.join('');$('coverage').textContent=hit+'/12';$('lesson').textContent=n<20?'Muestras chicas producen intervalos más inestables. Aumentá n y compará.':hit<9?'Esta ronda tuvo baja cobertura: repetir el estudio muestra la variabilidad que una sola muestra oculta.':'La mayoría alcanzó la media real, pero no todos: confianza no significa certeza.';$('dots').innerHTML=Array.from({length:100},(_,i)=>`<i class="dot ${i<n?'picked':''}"></i>`).join('')}
$('n').oninput=()=>{$('nOut').textContent=$('n').value};$('conf').oninput=()=>{$('confOut').textContent=$('conf').value+'%'};$('sample').onclick=run;$('n').onchange=run;$('conf').onchange=run;run();

})();
</script>
<style is:global>

.mockup-estadistica-inferencial{--blue:#174b7a;--ink:#17282f;--muted:#617178;--line:#d7e1df;--orange:#e57946;--green:#3fa279;--red:#d45954;--paper:#f4f7f5}.mockup-estadistica-inferencial *{box-sizing:border-box}.mockup-estadistica-inferencial{margin:0;font:15px/1.4 Inter,system-ui;color:var(--ink);background:var(--paper)}.mockup-estadistica-inferencial button,.mockup-estadistica-inferencial input{font:inherit}.mockup-estadistica-inferencial .shell{max-width:1180px;margin:auto;padding:36px 22px}.mockup-estadistica-inferencial .crumb{color:var(--blue);font-weight:800}.mockup-estadistica-inferencial h1{font-size:clamp(42px,6vw,68px);line-height:1;letter-spacing:-.055em;margin:30px 0 12px}.mockup-estadistica-inferencial .lead{font-size:18px;color:var(--muted);max-width:760px}.mockup-estadistica-inferencial .controls{display:flex;gap:20px;align-items:end;background:#fff;border:1px solid var(--line);border-radius:20px;padding:18px;margin:26px 0}.mockup-estadistica-inferencial .control{flex:1}.mockup-estadistica-inferencial .control label{display:flex;justify-content:space-between;font-weight:800}.mockup-estadistica-inferencial .control input{width:100%;accent-color:var(--orange)}.mockup-estadistica-inferencial .controls button{border:0;border-radius:13px;background:var(--blue);color:#fff;padding:14px 22px;font-weight:900}.mockup-estadistica-inferencial .lab{display:grid;grid-template-columns:.8fr 1.2fr;gap:20px}.mockup-estadistica-inferencial .population,.mockup-estadistica-inferencial .intervals{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px}.mockup-estadistica-inferencial .population h2,.mockup-estadistica-inferencial .intervals h2{margin:0;font-size:22px}.mockup-estadistica-inferencial .dots{display:grid;grid-template-columns:repeat(10,1fr);gap:7px;margin:25px 0}.mockup-estadistica-inferencial .dot{aspect-ratio:1;border-radius:50%;background:#cbd9d5}.mockup-estadistica-inferencial .dot.picked{background:var(--orange);transform:scale(1.15)}.mockup-estadistica-inferencial .truth{padding:16px;border-radius:15px;background:#e3f1eb}.mockup-estadistica-inferencial .truth b{font-size:30px;color:var(--green);display:block}.mockup-estadistica-inferencial .rows{margin-top:20px}.mockup-estadistica-inferencial .interval{height:27px;position:relative}.mockup-estadistica-inferencial .interval i{position:absolute;top:12px;border-top:4px solid var(--green)}.mockup-estadistica-inferencial .interval.miss i{border-color:var(--red)}.mockup-estadistica-inferencial .interval b{position:absolute;width:10px;height:10px;border-radius:50%;background:currentColor;top:8px}.mockup-estadistica-inferencial .target{position:absolute;top:0;bottom:0;border-left:2px dashed var(--blue);left:50%}.mockup-estadistica-inferencial .coverage{display:flex;justify-content:space-between;align-items:center;margin-top:15px;padding-top:15px;border-top:1px solid var(--line)}.mockup-estadistica-inferencial .coverage b{font-size:34px;color:var(--blue)}.mockup-estadistica-inferencial .lesson{margin-top:20px;padding:17px;border-left:5px solid var(--orange);background:#fff7e4}@media(max-width:800px){.mockup-estadistica-inferencial .lab{grid-template-columns:1fr}.mockup-estadistica-inferencial .controls{align-items:stretch;flex-direction:column}}
.mockup-estadistica-inferencial { width:100%; overflow:hidden; }
.mockup-estadistica-inferencial .top, .mockup-estadistica-inferencial header.top { display:none !important; }
.mockup-estadistica-inferencial .foot { display:none !important; }
.mockup-estadistica-inferencial .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-estadistica-inferencial .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-estadistica-inferencial .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-estadistica-inferencial .support-real summary { cursor:pointer; font-weight:750; }
.mockup-estadistica-inferencial .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-estadistica-inferencial :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-estadistica-inferencial input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-estadistica-inferencial input[type="number"]::-webkit-inner-spin-button, .mockup-estadistica-inferencial input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-estadistica-inferencial .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-estadistica-inferencial support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
