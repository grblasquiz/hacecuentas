---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-estadisticas-futbol" set:html={`
    <section class="hero"><div class="wrap"><div class="crumb">Fútbol / Estadísticas deportivas</div><div class="hero-grid"><div><div class="eyebrow">Tu número necesita contexto</div><h1>Medí tu nivel. Comparalo con los que juegan en serio.</h1><p class="lead">Distancia, velocidad, precisión, ELO, handicap o potencia: cargá tu marca y mirá exactamente dónde caés frente a rangos profesionales.</p><div class="chips"><span class="chip">✓ 10 métricas</span><span class="chip">✓ 4 deportes</span><span class="chip">✓ Comparación instantánea</span></div></div><div class="pitch"><span class="half"></span><span class="goal"></span><span class="ball">⚽</span><div class="hero-stat"><small>REFERENCIA MEDIOCAMPISTA</small><strong>11–13 km</strong></div></div></div></div></section>
    <section class="wrap"><div class="tool">
      <div class="sport-tabs" id="sports"><button class="sport active" data-sport="futbol">Fútbol</button><button class="sport" data-sport="golf">Golf</button><button class="sport" data-sport="ajedrez">Ajedrez</button><button class="sport" data-sport="ciclismo">Ciclismo</button></div>
      <div class="metric-area"><div class="labelcaps">¿Qué querés medir?</div><div class="metrics" id="metrics"></div></div>
      <div class="calc-grid"><div class="form"><h2 id="formTitle">Tu sprint de 30 metros</h2><p class="hint" id="formHint">Cargá tu tiempo y lo ubicamos en la escala profesional.</p><div class="fields" id="fields"></div><button class="primary" id="calculate">Actualizar comparación</button></div>
      <div class="result"><div class="labelcaps">TU NIVEL COMPARADO</div><div class="big" id="mainValue">4,20 s</div><div class="result-sub" id="resultSub">Estás a 0,30 s de la referencia profesional.</div><div class="level" id="level">Semiprofesional</div><div class="scale-labels"><span>Inicial</span><span>Avanzado</span><span>Semi-pro</span><span>Profesional</span><span>Élite</span></div><div class="scale"><span class="marker" id="marker"></span></div><div class="rows" id="rows"></div></div></div>
    </div></section>
    <section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">Una escala que se entiende</div><h2>Tu marca no es buena ni mala sola.</h2><p>La comparamos con cortes específicos de cada deporte y posición.</p></div><div class="bench"><div class="band"><i></i><b>Amateur inicial</b><span>Primeros entrenamientos</span></div><div class="band"><i></i><b>Amateur avanzado</b><span>Base consistente</span></div><div class="band"><i></i><b>Semiprofesional</b><span>Nivel competitivo</span></div><div class="band"><i></i><b>Profesional</b><span>Rango de liga</span></div><div class="band"><i></i><b>Élite mundial</b><span>Entre los mejores</span></div></div></div></section>
    <section class="explain"><div class="wrap explain-grid"><div><div class="eyebrow">Antes de sacar conclusiones</div><h2>Compará lo comparable.</h2><p>La posición, la edad, el sexo, la superficie y cómo se midió cambian el resultado. Esta herramienta ordena la referencia; no reemplaza una evaluación deportiva.</p></div><div class="rules"><div class="rule"><span class="num">1</span><b>Misma posición</b><p>Un central y un extremo tienen demandas distintas.</p></div><div class="rule"><span class="num">2</span><b>Mismo protocolo</b><p>GPS, cronómetro y radar no miden con igual precisión.</p></div><div class="rule"><span class="num">3</span><b>Más de una marca</b><p>Un día aislado no define tu rendimiento real.</p></div><div class="rule"><span class="num">4</span><b>Entrená con criterio</b><p>Subí cargas de forma gradual y sin dolor.</p></div></div></div></section>
  `} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-estadisticas-futbol')?document.currentScript.previousElementSibling:document.querySelector('.mockup-estadisticas-futbol');

    const configs={
      futbol:[
        {id:"sprint",title:"Sprint 30 m",desc:"Tiempo y nivel",form:"Tu sprint de 30 metros",hint:"Cargá tu tiempo desde salida parada.",fields:[["seg","Tiempo cronometrado","number",4.2,"s"],["pos","Posición","select","mediocampista",["Delantero","Mediocampista","Defensor","Arquero"]]],calc:v=>{let x=+v.seg,p=Math.max(0,Math.min(100,(5.4-x)/1.85*100));return out(x.toLocaleString("es-AR",{minimumFractionDigits:2})+" s",p,`Estás a ${Math.abs(x-3.9).toLocaleString("es-AR",{minimumFractionDigits:2})} s de la referencia profesional.`,[["Referencia profesional","3,75–4,00 s"],["Élite","menos de 3,75 s"],["Tu posición",v.pos]])}},
        {id:"distancia",title:"Distancia",desc:"Km por partido",form:"Distancia por partido",hint:"Ajustamos la referencia por minutos y posición.",fields:[["min","Minutos jugados","number",90,"min"],["pos","Posición","select","Mediocampista",["Arquero","Defensor central","Lateral","Mediocampista","Extremo","Delantero"]],["km","Distancia recorrida","number",10.4,"km"]],calc:v=>{let refs={Arquero:4,"Defensor central":9.5,Lateral:10.8,Mediocampista:12,Extremo:11.2,Delantero:9.8},r=refs[v.pos]*(+v.min/90),x=+v.km,p=Math.min(100,x/r*78);return out(`${x.toLocaleString("es-AR")} km`,p,`${x>=r?"Superás":"Te faltan"} ${Math.abs(x-r).toFixed(1).replace(".",",")} km frente a la referencia.`,[["Referencia ajustada",r.toFixed(1).replace(".",",")+" km"],["Minutos",v.min],["Posición",v.pos]])}},
        {id:"disparo",title:"Disparo",desc:"Velocidad en km/h",form:"Velocidad de tu remate",hint:"Usá la distancia al arco y el tiempo de vuelo.",fields:[["metros","Distancia","number",20,"m"],["tiempo","Tiempo de vuelo","number",0.65,"s"]],calc:v=>{let k=(+v.metros/+v.tiempo)*3.6,p=Math.min(100,k/135*100);return out(k.toFixed(1).replace(".",",")+" km/h",p,k>=120?"Tu remate entra en rango élite.":`Te faltan ${(120-k).toFixed(1).replace(".",",")} km/h para el rango élite.`,[["Tiempo de reacción",(+v.tiempo).toFixed(2).replace(".",",")+" s"],["Profesional","100–120 km/h"],["Élite","+120 km/h"]])}},
        {id:"pases",title:"Pases",desc:"Precisión",form:"Precisión de pases",hint:"Compará aciertos sobre intentos.",fields:[["intentos","Pases intentados","number",60],["aciertos","Pases completados","number",50],["pos","Posición","select","Mediocampista",["Defensor central","Mediocampista","Lateral","Extremo","Delantero"]]],calc:v=>{let x=Math.min(+v.aciertos,+v.intentos)/+v.intentos*100,ref={"Defensor central":92,Mediocampista:90,Lateral:88,Extremo:82,Delantero:80}[v.pos],p=Math.min(100,x/ref*82);return out(x.toFixed(1).replace(".",",")+"%",p,`${x>=ref?"Superás":"Estás por debajo de"} la referencia de tu posición.`,[["Completados",v.aciertos+" de "+v.intentos],["Referencia",ref+"%"],["Posición",v.pos]])}},
        {id:"conversion",title:"Conversión",desc:"Goles por tiro",form:"Conversión de tiros al arco",hint:"Medí cuántos tiros al arco terminan en gol.",fields:[["tiros","Tiros al arco","number",12],["goles","Goles","number",2]],calc:v=>{let x=Math.min(+v.goles,+v.tiros)/+v.tiros*100,p=Math.min(100,x/30*100);return out(x.toFixed(1).replace(".",",")+"%",p,x>=30?"Conversión de goleador top mundial.":x>=12?"Estás en el promedio profesional.":"Todavía por debajo del promedio profesional.",[["Goles",v.goles+" de "+v.tiros],["Profesional","12–17%"],["Top mundial","+30%"]])}}
      ],
      golf:[
        {id:"diferencial",title:"Diferencial",desc:"Una tarjeta WHS",form:"Diferencial de tu vuelta",hint:"Usamos la fórmula oficial del World Handicap System.",fields:[["score","Golpes totales","number",92],["rating","Course Rating","number",72.4],["slope","Slope Rating","number",128]],calc:v=>{let x=((+v.score-+v.rating)*113/+v.slope),p=Math.max(3,100-x*3);return out(x.toFixed(1).replace(".",","),p,"Cuanto más bajo el diferencial, mejor fue tu vuelta.",[["Score",v.score],["Course Rating",v.rating],["Fórmula","(score − rating) × 113 ÷ slope"]])}},
        {id:"handicap",title:"Handicap",desc:"Índice estimado",form:"Estimá tu handicap",hint:"Ingresá el promedio de tus mejores diferenciales.",fields:[["prom","Promedio de mejores 8","number",14.6],["vueltas","Tarjetas cargadas","number",20]],calc:v=>{let x=+v.prom,p=Math.max(3,100-x*3);return out(x.toFixed(1).replace(".",","),p,+v.vueltas>=20?"Ya tenés una base comparable con el índice oficial.":"Es una estimación: faltan tarjetas para un índice estable.",[["Tarjetas",v.vueltas],["Scratch","0,0"],["Referencia","Mejores 8 de 20"]])}}
      ],
      ajedrez:[
        {id:"elo",title:"Variación ELO",desc:"Puntos por partida",form:"Calculá tus puntos ELO",hint:"La diferencia de rating cambia cuánto ganás o perdés.",fields:[["propio","Tu ELO","number",1500],["rival","ELO rival","number",1600],["res","Resultado","select","Gané",["Gané","Empaté","Perdí"]],["k","Factor K","select","20",["10","20","40"]]],calc:v=>{let e=1/(1+Math.pow(10,(+v.rival-+v.propio)/400)),r=v.res==="Gané"?1:v.res==="Empaté"?.5:0,d=+v.k*(r-e),nuevo=+v.propio+d,p=Math.min(100,nuevo/2800*100);return out((d>=0?"+":"")+d.toFixed(1).replace(".",",")+" pts",p,`Tu nuevo rating estimado sería ${nuevo.toFixed(0)}.`,[["Resultado esperado",(e*100).toFixed(1).replace(".",",")+"%"],["ELO rival",v.rival],["Factor K",v.k]])}}
      ],
      ciclismo:[
        {id:"wkg",title:"Watts por kilo",desc:"FTP relativo",form:"Tu potencia relativa",hint:"Dividimos tu FTP por tu peso y lo comparamos por tabla.",fields:[["ftp","FTP","number",250,"W"],["peso","Peso","number",75,"kg"],["tabla","Tabla","select","Masculina",["Masculina","Femenina"]]],calc:v=>{let x=+v.ftp/+v.peso,elite=v.tabla==="Masculina"?5.05:4.3,p=Math.min(100,x/elite*92);return out(x.toFixed(2).replace(".",",")+" W/kg",p,x>=elite?"Entrás en el corte de élite de la tabla elegida.":`Te faltan ${(elite-x).toFixed(2).replace(".",",")} W/kg para el corte de élite.`,[["FTP",v.ftp+" W"],["Peso",v.peso+" kg"],["Élite",elite.toFixed(2).replace(".",",")+" W/kg"]])}}
      ]
    };
    let sport="futbol",metric="sprint";
    const $=id=>root.querySelector("#"+id);
    function out(value,pos,sub,rows){return{value,pos:Math.max(2,Math.min(98,pos)),sub,rows}}
    function level(p){return p<20?"Amateur inicial":p<40?"Amateur avanzado":p<60?"Semiprofesional":p<80?"Profesional":"Élite mundial"}
    function drawMetrics(){let list=configs[sport];$("metrics").innerHTML=list.map(m=>`<button class="metric ${m.id===metric?"active":""}" data-id="${m.id}"><b>${m.title}</b><span>${m.desc}</span></button>`).join("");root.querySelectorAll(".metric").forEach(b=>b.onclick=()=>{metric=b.dataset.id;render()})}
    function current(){return configs[sport].find(x=>x.id===metric)||configs[sport][0]}
    function drawFields(m){$("fields").innerHTML=m.fields.map(f=>{let [id,label,type,val,extra]=f;if(type==="select")return `<div class="field"><label for="${id}">${label}</label><select id="${id}">${extra.map(o=>`<option ${o==val?"selected":""}>${o}</option>`).join("")}</select></div>`;return `<div class="field"><label for="${id}">${label}</label><input id="${id}" type="number" value="${val}" step="any">${extra?`<small>${extra}</small>`:""}</div>`}).join("");$("fields").querySelectorAll("input,select").forEach(x=>x.addEventListener("input",compute))}
    function values(m){return Object.fromEntries(m.fields.map(f=>[f[0],$(f[0]).value]))}
    function compute(){let m=current(),r=m.calc(values(m));$("mainValue").textContent=r.value;$("resultSub").textContent=r.sub;$("level").textContent=level(r.pos);$("marker").style.left=`calc(${r.pos}% - 2px)`;$("rows").innerHTML=r.rows.map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("")}
    function render(){drawMetrics();let m=current();$("formTitle").textContent=m.form;$("formHint").textContent=m.hint;drawFields(m);compute()}
    root.querySelectorAll(".sport").forEach(b=>b.onclick=()=>{sport=b.dataset.sport;metric=configs[sport][0].id;root.querySelectorAll(".sport").forEach(x=>x.classList.toggle("active",x===b));render()});
    $("calculate").onclick=()=>{compute();let b=$("calculate"),old=b.textContent;b.textContent="✓ Comparación actualizada";setTimeout(()=>b.textContent=old,1200)};
    render();
  
})();
</script>
<style is:global>

    .mockup-estadisticas-futbol{--ink:#10182d;--muted:#667085;--line:#dfe4e8;--paper:#f7f8f4;--card:#fff;--green:#168a63;--green2:#dff3e9;--navy:#142b4b;--lime:#cce85b;--amber:#e8ae43}
    .mockup-estadisticas-futbol *{box-sizing:border-box}.mockup-estadisticas-futbol{margin:0;background:var(--paper);color:var(--ink);font:16px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.mockup-estadisticas-futbol button,.mockup-estadisticas-futbol input,.mockup-estadisticas-futbol select{font:inherit}.mockup-estadisticas-futbol .wrap{max-width:1180px;margin:auto;padding:0 28px}
    .mockup-estadisticas-futbol header{height:84px;background:#fff;border-bottom:1px solid var(--line)}.mockup-estadisticas-futbol header .wrap{height:100%;display:flex;align-items:center;gap:34px}.mockup-estadisticas-futbol .brand{display:flex;align-items:center;gap:12px;font-weight:850;font-size:20px}.mockup-estadisticas-futbol .logo{width:35px;height:35px;border-radius:8px;background:var(--navy);display:grid;place-items:center;color:#fff;font-size:14px}.mockup-estadisticas-futbol .nav{display:flex;gap:26px;color:#465064;font-weight:700;font-size:14px}.mockup-estadisticas-futbol .actions{margin-left:auto;display:flex;gap:10px}.mockup-estadisticas-futbol .ghost{border:1px solid var(--line);background:#fff;padding:11px 15px;border-radius:12px;font-weight:750;color:var(--ink)}
    .mockup-estadisticas-futbol .hero{padding:62px 0 50px}.mockup-estadisticas-futbol .crumb{color:#3979cb;font-size:14px;margin-bottom:20px}.mockup-estadisticas-futbol .hero-grid{display:grid;grid-template-columns:1.16fr .84fr;gap:70px;align-items:center}.mockup-estadisticas-futbol .eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:900;color:var(--green)}.mockup-estadisticas-futbol h1{font-size:56px;line-height:1.02;letter-spacing:-.045em;margin:14px 0 20px;max-width:720px}.mockup-estadisticas-futbol .lead{font-size:19px;color:var(--muted);max-width:680px}.mockup-estadisticas-futbol .chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.mockup-estadisticas-futbol .chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 13px;font-size:13px;font-weight:750}
    .mockup-estadisticas-futbol .pitch{height:330px;border-radius:28px;background:linear-gradient(145deg,#126c50,#21946c);position:relative;overflow:hidden;box-shadow:0 25px 55px #173b2b26}.mockup-estadisticas-futbol .pitch:before{content:"";position:absolute;inset:18px;border:2px solid #ffffff8a;border-radius:18px}.mockup-estadisticas-futbol .pitch:after{content:"";position:absolute;width:105px;height:105px;border:2px solid #ffffff8a;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%)}.mockup-estadisticas-futbol .half{position:absolute;left:50%;top:18px;bottom:18px;border-left:2px solid #ffffff8a}.mockup-estadisticas-futbol .goal{position:absolute;width:67px;height:145px;left:18px;top:92px;border:2px solid #ffffff8a;border-left:0}.mockup-estadisticas-futbol .ball{position:absolute;left:58%;top:31%;width:58px;height:58px;border-radius:50%;background:#fff;box-shadow:0 12px 24px #0003;display:grid;place-items:center;font-size:27px}.mockup-estadisticas-futbol .hero-stat{position:absolute;right:20px;bottom:20px;background:#fff;padding:16px 19px;border-radius:16px;box-shadow:0 10px 30px #0002}.mockup-estadisticas-futbol .hero-stat small{display:block;color:var(--muted);font-weight:800;font-size:10px;letter-spacing:.1em}.mockup-estadisticas-futbol .hero-stat strong{font-size:24px}
    .mockup-estadisticas-futbol .tool{background:#fff;border:1px solid var(--line);border-radius:26px;box-shadow:0 22px 55px #1d2d4310;overflow:hidden;margin-bottom:70px}.mockup-estadisticas-futbol .sport-tabs{padding:22px 24px;border-bottom:1px solid var(--line);display:flex;gap:10px}.mockup-estadisticas-futbol .sport{border:1px solid var(--line);background:#fff;border-radius:13px;padding:11px 18px;font-weight:800;color:#586174;cursor:pointer}.mockup-estadisticas-futbol .sport.active{background:var(--navy);border-color:var(--navy);color:#fff}.mockup-estadisticas-futbol .metric-area{padding:26px 28px 0}.mockup-estadisticas-futbol .labelcaps{font-size:11px;letter-spacing:.12em;font-weight:900;color:var(--muted);text-transform:uppercase;margin-bottom:13px}.mockup-estadisticas-futbol .metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.mockup-estadisticas-futbol .metric{min-height:92px;text-align:left;border:1px solid var(--line);background:#fafbfa;border-radius:15px;padding:15px;cursor:pointer;color:var(--ink)}.mockup-estadisticas-futbol .metric b{display:block;margin-bottom:5px}.mockup-estadisticas-futbol .metric span{font-size:12px;color:var(--muted)}.mockup-estadisticas-futbol .metric.active{border:2px solid var(--green);background:#eff9f5;padding:14px}.mockup-estadisticas-futbol .calc-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:0;margin-top:26px;border-top:1px solid var(--line)}.mockup-estadisticas-futbol .form{padding:32px 30px}.mockup-estadisticas-futbol .form h2,.mockup-estadisticas-futbol .result h2{margin:0 0 8px;font-size:25px;letter-spacing:-.025em}.mockup-estadisticas-futbol .hint{color:var(--muted);margin:0 0 25px}.mockup-estadisticas-futbol .fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.mockup-estadisticas-futbol .field{display:flex;flex-direction:column;gap:7px}.mockup-estadisticas-futbol .field.full{grid-column:1/-1}.mockup-estadisticas-futbol .field label{font-weight:780;font-size:13px}.mockup-estadisticas-futbol .field input,.mockup-estadisticas-futbol .field select{width:100%;border:1px solid #ccd3da;border-radius:12px;background:#fff;padding:14px 13px;color:var(--ink);outline:none}.mockup-estadisticas-futbol .field input:focus,.mockup-estadisticas-futbol .field select:focus{border-color:var(--green);box-shadow:0 0 0 3px #168a6320}.mockup-estadisticas-futbol .primary{border:0;background:var(--green);color:#fff;font-weight:850;padding:15px 20px;border-radius:13px;margin-top:20px;width:100%;cursor:pointer}.mockup-estadisticas-futbol .primary:active{transform:translateY(1px)}
    .mockup-estadisticas-futbol .result{background:var(--navy);color:#fff;padding:32px 30px;position:relative;overflow:hidden}.mockup-estadisticas-futbol .result:after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;right:-120px;bottom:-130px;border:42px solid #ffffff0b}.mockup-estadisticas-futbol .result .labelcaps{color:#a9d8cb}.mockup-estadisticas-futbol .big{font-size:46px;line-height:1;font-weight:900;letter-spacing:-.045em;margin:16px 0 8px}.mockup-estadisticas-futbol .result-sub{color:#d3dde9;min-height:46px}.mockup-estadisticas-futbol .level{display:inline-flex;padding:8px 12px;border-radius:999px;background:#dff3e9;color:#0c6248;font-weight:850;font-size:13px;margin:12px 0 24px}.mockup-estadisticas-futbol .scale-labels{display:flex;justify-content:space-between;color:#d4dcea;font-size:10px;font-weight:800}.mockup-estadisticas-futbol .scale{height:13px;background:linear-gradient(90deg,#e16b64 0 20%,#e8ae43 20% 40%,#ccd769 40% 60%,#58b889 60% 80%,#49a9ca 80%);border-radius:99px;position:relative;margin:8px 0 25px}.mockup-estadisticas-futbol .marker{position:absolute;top:-7px;width:5px;height:27px;background:#fff;border-radius:5px;box-shadow:0 0 0 3px #142b4b;left:46%}.mockup-estadisticas-futbol .rows{border-top:1px solid #ffffff24}.mockup-estadisticas-futbol .row{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid #ffffff1b;color:#d8e0eb}.mockup-estadisticas-futbol .row strong{color:#fff}
    .mockup-estadisticas-futbol .section{padding:20px 0 70px}.mockup-estadisticas-futbol .section-head{text-align:center;max-width:700px;margin:0 auto 32px}.mockup-estadisticas-futbol .section h2{font-size:38px;letter-spacing:-.035em;margin:9px 0}.mockup-estadisticas-futbol .section p{color:var(--muted)}.mockup-estadisticas-futbol .bench{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.mockup-estadisticas-futbol .band{background:#fff;border:1px solid var(--line);border-radius:17px;padding:20px}.mockup-estadisticas-futbol .band i{display:block;width:9px;height:9px;border-radius:50%;margin-bottom:17px}.mockup-estadisticas-futbol .band:nth-child(1) i{background:#e16b64}.mockup-estadisticas-futbol .band:nth-child(2) i{background:#e8ae43}.mockup-estadisticas-futbol .band:nth-child(3) i{background:#ccd769}.mockup-estadisticas-futbol .band:nth-child(4) i{background:#58b889}.mockup-estadisticas-futbol .band:nth-child(5) i{background:#49a9ca}.mockup-estadisticas-futbol .band b{display:block}.mockup-estadisticas-futbol .band span{font-size:13px;color:var(--muted)}
