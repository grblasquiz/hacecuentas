---
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-millas" set:html={`
<section class="hero"><div class="wrap crumb"><b>Viajes</b> &nbsp;/&nbsp; Millas por destino</div><div class="wrap grid">
<div class="copy"><span class="eyebrow">Planificador de canjes</span><h1>¿Cuántas millas<br>necesitás para<br>ese viaje?</h1><p>Elegí programa, destino y cabina. Te mostramos cuántas millas pide el canje, cuánto te falta y si conviene usarlas.</p><div class="chips"><span>✈ 17 destinos</span><span>◎ 5 programas</span><span>✓ Tablas revisadas</span></div><div class="visual"><div class="world"></div><span class="plane">✈</span><div class="boarding"><small>TU PRÓXIMO CANJE</small><strong id="ticket-route">EZE → MIA</strong><span id="ticket-miles">40.000 millas</span></div></div></div>
<form class="calc" onsubmit="return false"><div class="calc-head"><div><h2>Armá tu canje</h2><p>Comparamos tu saldo con el viaje que querés hacer.</p></div><span class="tag">Resultado inmediato</span></div>
<div class="fields"><div class="field wide"><label>Programa de millas</label><select id="program"><option value="lifemiles">LifeMiles (Avianca)</option><option value="latam">LATAM Pass</option><option value="aadvantage">AAdvantage (American)</option><option value="mileageplus">MileagePlus (United)</option><option value="skymiles">SkyMiles (Delta)</option></select></div><div class="field"><label>Destino</label><select id="destination"></select></div><div class="field"><label>Cabina</label><div class="switches"><button type="button" class="switch active" data-cabin="economy">Económica</button><button type="button" class="switch" data-cabin="business">Business</button></div></div><div class="field"><label>Tipo de viaje</label><div class="switches"><button type="button" class="switch active" data-trip="round">Ida y vuelta</button><button type="button" class="switch" data-trip="oneway">Solo ida</button></div></div><div class="field"><label>Millas que tenés hoy</label><input id="balance" inputmode="numeric" value="25.000"></div><div class="field"><label>Pasaje en efectivo (USD)</label><input id="cash" type="number" min="0" value="900"></div><div class="field"><label>Tasas del canje (USD)</label><input id="fees" type="number" min="0" value="220"></div></div>
<section class="result"><div class="result-top"><div><small>Millas que necesitás</small><div class="value" id="needed">40.000</div></div><div class="status"><small>Tu situación</small><strong id="status">Te faltan 15.000</strong></div></div><div class="stats"><span>Tenés cubierto<b id="covered">63%</b></span><span>Valor por milla<b id="cpp">1,70 ¢</b></span><span>Decisión sugerida<b id="verdict">Buen canje</b></span></div><button class="go" id="update" type="button">Actualizar canje</button></section></form>
</div></section>
<section class="progress-section"><div class="wrap"><header class="center"><span>Tu saldo frente al viaje</span><h2>Ves enseguida cuánto te falta</h2><p>No alcanza con conocer la tabla: la barra convierte el objetivo en una meta concreta.</p></header><div class="progress-card"><div class="route"><div class="airport"><b>EZE</b><span>Tu punto de partida</span></div><div class="route-line"></div><div class="airport" style="text-align:right"><b id="airport-code">MIA</b><span id="destination-name">Miami</span></div></div><div class="bar"><div class="fill" id="fill"></div></div><div class="bar-labels"><span id="balance-label">25.000 millas disponibles</span><b id="goal-label">Meta: 40.000</b></div><div class="insight"><span id="progress-copy">Ya cubriste más de la mitad del canje.</span><b id="remaining-copy">Te faltan 15.000 millas</b></div></div></div></section>
<section class="compare"><div class="wrap compare-grid"><article class="card"><h3>La cuenta completa</h3><div class="line"><span>Millas que pide el programa</span><b id="d-needed">40.000 millas</b></div><div class="line"><span>Saldo disponible</span><b id="d-balance">25.000 millas</b></div><div class="line"><span>Tasas que pagás en efectivo</span><b id="d-fees">USD 220</b></div><div class="line"><span>Ahorro real frente al pasaje</span><b id="d-saving">USD 680</b></div><div class="line total"><strong>Valor obtenido por milla</strong><b id="d-cpp">1,70 ¢</b></div></article><article class="card"><h3>¿Canjear o pagar?</h3><div class="decision"><div class="choice best" id="miles-choice"><small>CON MILLAS</small><b id="miles-cost">40.000 + USD 220</b><span>Conservás el efectivo, pero consumís saldo.</span></div><div class="choice" id="cash-choice"><small>EN EFECTIVO</small><b id="cash-cost">USD 900</b><span>Sumás millas nuevas y guardás las actuales.</span></div></div><div class="notice" id="program-note">⚠️ Las tablas son orientativas. La disponibilidad y el precio final pueden cambiar por fecha.</div></article></div></section>
<section class="programs"><div class="wrap"><div class="program-head"><div><span>Todo el panorama</span><h2>Cada programa juega con reglas distintas</h2></div></div><div class="program-grid"><article class="program active" data-program-card="lifemiles"><i>🟠</i><h3>LifeMiles</h3><p>Sin recargo de combustible; suele rendir en premium.</p><strong>1,60 ¢</strong><span>valor de referencia</span></article><article class="program" data-program-card="latam"><i>🔴</i><h3>LATAM Pass</h3><p>Precio dinámico y buena red regional.</p><strong>1,20 ¢</strong><span>valor de referencia</span></article><article class="program" data-program-card="aadvantage"><i>🔵</i><h3>AAdvantage</h3><p>Niveles saver, disponibilidad variable.</p><strong>1,40 ¢</strong><span>valor de referencia</span></article><article class="program" data-program-card="mileageplus"><i>🟣</i><h3>MileagePlus</h3><p>Gran red Star Alliance y valores dinámicos.</p><strong>1,30 ¢</strong><span>valor de referencia</span></article><article class="program" data-program-card="skymiles"><i>🔷</i><h3>SkyMiles</h3><p>Tabla dinámica y frecuentes promociones.</p><strong>1,10 ¢</strong><span>valor de referencia</span></article></div></div></section>
<section class="tips"><div class="wrap tips-grid"><div><span class="eyebrow" style="color:#8fcdf0">Antes de confirmar</span><h2>El número abre la puerta. La disponibilidad decide.</h2><p>Revisá el precio real de tu fecha, las condiciones de cambio y el vencimiento del saldo antes de emitir.</p></div><div class="tips-card"><div><small>FECHAS</small><b>Probá días cercanos</b><span>Mover 24 horas puede bajar mucho el canje.</span></div><div><small>TASAS</small><b>Sumá todo</b><span>Impuestos y cargos se pagan aunque uses millas.</span></div><div><small>VALOR</small><b>Compará igual con igual</b><span>Misma cabina, equipaje y flexibilidad.</span></div></div></div></section><div class="foot"></div>
`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-millas')?document.currentScript.previousElementSibling:document.querySelector('.mockup-millas');

const data={
lifemiles:{ref:1.6,fees:220,note:"LifeMiles no cobra fuel surcharge: en cabina premium suele rendir especialmente bien.",dest:{bogota:["Bogotá","BOG",7500,15000,30000,30000],buenos:["Buenos Aires","EZE",20000,40000,70000,70000],lima:["Lima","LIM",10000,20000,40000,40000],saopaulo:["São Paulo","GRU",17500,35000,60000,60000],miami:["Miami","MIA",15000,30000,55000,55000],madrid:["Madrid","MAD",30000,60000,100000,100000]}},
latam:{ref:1.2,fees:190,note:"LATAM Pass usa precio dinámico: esta referencia puede subir en fechas de alta demanda.",dest:{buenos:["Buenos Aires","EZE",7000,14000,30000,30000],santiago:["Santiago de Chile","SCL",7000,14000,30000,30000],miami:["Miami","MIA",25000,50000,85000,85000],madrid:["Madrid","MAD",45000,90000,150000,150000],londres:["Londres","LHR",55000,110000,170000,170000],sydney:["Sídney","SYD",60000,120000,180000,180000]}},
aadvantage:{ref:1.4,fees:225,note:"AAdvantage ya no publica una tabla fija: se muestran niveles saver de referencia.",dest:{miami:["Miami","MIA",7500,15000,30000,30000],nyc:["Nueva York","NYC",12500,25000,50000,50000],la:["Los Ángeles","LAX",12500,25000,50000,50000],madrid:["Madrid","MAD",30000,60000,100000,100000],londres:["Londres","LHR",30000,60000,100000,100000],tokio:["Tokio","TYO",35000,70000,120000,120000]}},
mileageplus:{ref:1.3,fees:220,note:"MileagePlus muestra niveles saver; business sí cambia entre solo ida e ida y vuelta.",dest:{nyc:["Nueva York","NYC",10000,20000,35000,70000],la:["Los Ángeles","LAX",10000,20000,35000,70000],londres:["Londres","LHR",30000,60000,60000,120000],paris:["París","CDG",30000,60000,60000,120000],tokio:["Tokio","TYO",35000,70000,80000,160000],sydney:["Sídney","SYD",40000,80000,85000,170000]}},
skymiles:{ref:1.1,fees:200,note:"SkyMiles es dinámico y no tiene tabla oficial: son promedios observados.",dest:{nyc:["Nueva York","NYC",10000,20000,35000,35000],atlanta:["Atlanta","ATL",9000,18000,35000,35000],mexico:["Ciudad de México","MEX",11000,22000,40000,40000],cartagena:["Cartagena","CTG",12000,25000,45000,45000],amsterdam:["Ámsterdam","AMS",30000,60000,100000,100000],tokio:["Tokio","TYO",35000,70000,125000,125000]}}
};
const $=s=>root.querySelector(s),fmt=n=>new Intl.NumberFormat("es-AR").format(Math.round(n)),num=v=>Number(String(v).replace(/\./g,"").replace(",","."))||0;let cabin="economy",trip="round";
function loadDestinations(keep){const p=data[$("#program").value],sel=$("#destination"),wanted=keep||"miami";sel.innerHTML=Object.entries(p.dest).map(([k,v])=>`<option value="${k}">${v[0]}</option>`).join("");sel.value=p.dest[wanted]?wanted:Object.keys(p.dest)[0];$("#fees").value=p.fees}
function calc(){const pid=$("#program").value,p=data[pid],d=p.dest[$("#destination").value],idx=cabin==="economy"?(trip==="oneway"?2:3):(trip==="oneway"?4:5),needed=d[idx],balance=num($("#balance").value),cash=num($("#cash").value),fees=num($("#fees").value),saving=Math.max(0,cash-fees),cpp=needed?saving/needed*100:0,covered=Math.min(100,balance/needed*100),remaining=Math.max(0,needed-balance),enough=balance>=needed,good=cpp>=p.ref;$("#needed").textContent=fmt(needed);$("#status").textContent=enough?`Te sobran ${fmt(balance-needed)}`:`Te faltan ${fmt(remaining)}`;$("#covered").textContent=`${Math.round(covered)}%`;$("#cpp").textContent=`${cpp.toFixed(2).replace(".",",")} ¢`;$("#verdict").textContent=good?"Buen canje":"Mejor pagar cash";$("#ticket-route").textContent=`EZE → ${d[1]}`;$("#ticket-miles").textContent=`${fmt(needed)} millas`;$("#airport-code").textContent=d[1];$("#destination-name").textContent=d[0];$("#fill").style.width=`${covered}%`;$("#balance-label").textContent=`${fmt(balance)} millas disponibles`;$("#goal-label").textContent=`Meta: ${fmt(needed)}`;$("#progress-copy").textContent=enough?"Tu saldo ya alcanza para emitir este canje.":covered>=50?"Ya cubriste más de la mitad del canje.":"Todavía estás en la primera mitad del objetivo.";$("#remaining-copy").textContent=enough?`Te sobran ${fmt(balance-needed)} millas`:`Te faltan ${fmt(remaining)} millas`;$("#d-needed").textContent=`${fmt(needed)} millas`;$("#d-balance").textContent=`${fmt(balance)} millas`;$("#d-fees").textContent=`USD ${fmt(fees)}`;$("#d-saving").textContent=`USD ${fmt(saving)}`;$("#d-cpp").textContent=`${cpp.toFixed(2).replace(".",",")} ¢`;$("#miles-cost").textContent=`${fmt(needed)} + USD ${fmt(fees)}`;$("#cash-cost").textContent=`USD ${fmt(cash)}`;$("#program-note").textContent=`⚠️ ${p.note}`;$("#miles-choice").classList.toggle("best",good);$("#cash-choice").classList.toggle("best",!good);root.querySelectorAll("[data-program-card]").forEach(x=>x.classList.toggle("active",x.dataset.programCard===pid))}
$("#program").addEventListener("change",()=>{loadDestinations();calc()});$("#destination").addEventListener("change",calc);root.querySelectorAll("[data-cabin]").forEach(b=>b.addEventListener("click",()=>{root.querySelectorAll("[data-cabin]").forEach(x=>x.classList.remove("active"));b.classList.add("active");cabin=b.dataset.cabin;calc()}));root.querySelectorAll("[data-trip]").forEach(b=>b.addEventListener("click",()=>{root.querySelectorAll("[data-trip]").forEach(x=>x.classList.remove("active"));b.classList.add("active");trip=b.dataset.trip;calc()}));root.querySelectorAll("input").forEach(i=>i.addEventListener("input",calc));root.querySelectorAll("[data-program-card]").forEach(c=>c.addEventListener("click",()=>{$("#program").value=c.dataset.programCard;loadDestinations();calc();scrollTo({top:390,behavior:"smooth"})}));$("#update").addEventListener("click",e=>{calc();e.currentTarget.textContent="✓ Canje actualizado";setTimeout(()=>e.currentTarget.textContent="Actualizar canje",1200)});loadDestinations("miami");calc();

})();
</script>
