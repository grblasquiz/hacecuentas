.mockup-millas .calc{background:#fff;border:1px solid #d8e4eb;border-radius:20px;padding:27px 29px;box-shadow:0 25px 60px #173b6418}.mockup-millas .calc-head{display:flex;justify-content:space-between;gap:15px}.mockup-millas .calc h2{font-size:23px;margin:0 0 4px}.mockup-millas .calc-head p{font-size:10px;color:#60758c;margin:0}.mockup-millas .tag{font-size:9px;color:#14775b;background:#e6f6ef;border-radius:99px;padding:7px 10px;font-weight:800;height:max-content}.mockup-millas .fields{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:18px}.mockup-millas .field{border:1px solid #dbe4eb;border-radius:10px;padding:9px 11px;min-height:58px}.mockup-millas .field label{display:block;color:#63788e;font-size:8px;margin-bottom:5px}.mockup-millas .field input,.mockup-millas .field select{border:0;outline:0;background:none;width:100%;color:#142641;font-weight:750;font-size:13px}.mockup-millas .field.wide{grid-column:span 2}.mockup-millas .switches{display:flex;gap:7px}.mockup-millas .switch{flex:1;border:1px solid #dce5ec;background:#fff;border-radius:8px;padding:8px;color:#52677f;font-size:9px;font-weight:750}.mockup-millas .switch.active{border:2px solid #247fc1;background:#eff7fd;color:#166aa4}.mockup-millas .result{background:#17324f;color:#fff;border-radius:15px;padding:18px 20px;margin-top:13px}.mockup-millas .result-top{display:flex;justify-content:space-between;gap:12px}.mockup-millas .result small{font-size:9px;color:#c5d3df}.mockup-millas .value{font-size:34px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.mockup-millas .status{background:#e6f6ef;color:#126d51;border-radius:9px;padding:8px 11px;text-align:right}.mockup-millas .status small{color:inherit}.mockup-millas .status strong{display:block;font-size:13px}.mockup-millas .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #375675;padding-top:12px;margin-top:13px}.mockup-millas .stats span{font-size:8px;color:#b9cad8}.mockup-millas .stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.mockup-millas .go{width:100%;border:0;border-radius:9px;background:linear-gradient(90deg,#247fc1,#26a584);color:#fff;font-weight:800;padding:12px;margin-top:14px}
