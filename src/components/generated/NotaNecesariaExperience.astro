---
import HubCitableStats from '../hub/HubCitableStats.astro';
interface Props { data?: any }
const { data } = Astro.props;
---
<div class="mockup-nota-necesaria" set:html={`<section class="hero"><div class="hero-grid"><div><div class="crumb">Estudio / Nota necesaria para aprobar</div><div class="eyebrow">Calculadora de escenario</div><h1>La nota que necesitás, antes de rendir.</h1><p class="lead">Cargá evaluaciones, pesos y condición de aprobación. Ves el mínimo y qué pasa con distintas notas.</p><div class="pills"><span>Resultado explicado</span><span>Datos editables</span><span>Todos los casos visibles</span></div></div><div class="art grade"><div class="target"><i></i><b>6,0</b></div></div></div></section>
<section class="tool"><div class="wrap"><div class="tool-head"><div><div class="kicker">escenario interactivo</div><h2>Armá tu caso</h2></div><p>Modificá los datos y mirá cómo cambia el resultado. Cada cifra incluye contexto para poder decidir o aprender.</p></div><div class="workspace"><section class="panel form"><h3>Datos necesarios</h3><p class="hint">Empezamos con un ejemplo completo para que puedas probar la herramienta.</p><div class="fields"><div class="field"><label for="current">Promedio actual</label><input id="current" type="number" value="6.5" min="0" max="10" step="0.1"></div><div class="field"><label for="completed">Porcentaje ya evaluado</label><input id="completed" type="number" value="60" min="0" max="99" step="1"></div><div class="field"><label for="pass">Nota final para aprobar</label><input id="pass" type="number" value="6" min="0" max="10" step="0.1"></div><div class="field"><label for="expected">Nota que esperás sacar</label><input id="expected" type="number" value="7" min="0" max="10" step="0.1"></div></div><div class="actions"><button class="primary" id="calculate">Actualizar resultado</button><button class="reset" id="reset">Reiniciar</button></div></section><aside class="panel result" aria-live="polite"><span class="badge" id="badge">Resultado</span><div class="big" id="big">—</div><div class="caption" id="caption">Resultado principal</div><div class="meter"><i id="marker"></i></div><div class="metrics" id="metrics"></div><div class="note" id="note"></div></aside></div></div></section><section class="guide"><div class="wrap guide-grid"><div><div class="kicker">Cómo usarlo bien</div><h2>Del número a una decisión</h2><p>El resultado es una referencia: revisá unidades, supuestos y condiciones antes de aplicarlo.</p></div><div class="steps"><div class="step"><b>1. Completá</b><span>Usá datos del caso real y mantené las unidades indicadas.</span></div><div class="step"><b>2. Compará</b><span>Probá al menos dos escenarios para entender qué variable pesa más.</span></div><div class="step"><b>3. Verificá</b><span>Revisá la explicación y confirmá cualquier dato crítico con una fuente específica.</span></div></div></div></section>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-nota-necesaria')?document.currentScript.previousElementSibling:document.querySelector('.mockup-nota-necesaria');

(()=>{const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],v=id=>$("#"+id).value,vn=id=>+v(id)||0;function compute(){const cur=vn("current"),done=vn("completed")/100,pass=vn("pass"),left=1-done,needed=(pass-cur*done)/left,expected=vn("expected"),final=cur*done+expected*left;return {big:needed<=0?"Ya aprobás":needed>10?"No alcanza":needed.toFixed(2).replace(".",","),label:needed>0&&needed<=10?"Nota mínima en lo pendiente":"Situación actual",badge:final>=pass?"Tu escenario aprueba":"Tu escenario no llega",metrics:[["Final esperado",final.toFixed(2)],["Peso pendiente",Math.round(left*100)+"%"],["Margen",(final-pass).toFixed(2)]],position:Math.max(0,Math.min(100,final/10*100)),note:needed>10?"Aun con 10 no llegás al promedio requerido. Revisá recuperatorios o condiciones especiales.":"Probá varias notas esperadas para ver el margen; no apuntes exactamente al mínimo si hay redondeos."}}function draw(){const r=compute();$("#big").textContent=r.big;$("#caption").textContent=r.label;$("#badge").textContent=r.badge;$("#marker").style.setProperty("--position",Math.max(2,Math.min(98,r.position))+"%");$("#metrics").innerHTML=r.metrics.map(x=>'<div class="metric"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join("");$("#note").textContent=r.note;$$('input[type="range"]').forEach(x=>{const o=$("#"+x.id+"Out");if(o)o.textContent=x.value})}$$("input,select").forEach(x=>x.addEventListener("input",draw));$("#calculate").addEventListener("click",draw);const defaults={"current":"6.5","completed":"60","pass":"6","expected":"7"};$("#reset").addEventListener("click",()=>{Object.entries(defaults).forEach(([id,val])=>$("#"+id).value=val);draw()});draw()})();
})();
</script>
<style is:global>

.mockup-nota-necesaria{--blue:#174b7a;--accent:#3e8474;--soft:#eaf6f2;--ink:#172331;--muted:#5e6977;--line:#d9e2e5;--paper:#f5f7f6;--cream:#fff8e2;--mint:#d9eee6}.mockup-nota-necesaria *{box-sizing:border-box}.mockup-nota-necesaria{margin:0;font:16px/1.45 Inter,system-ui,sans-serif;color:var(--ink);background:#fff}.mockup-nota-necesaria button,.mockup-nota-necesaria input,.mockup-nota-necesaria select{font:inherit}.mockup-nota-necesaria .head{height:74px;padding:0 max(22px,calc((100% - 1180px)/2));display:flex;align-items:center;gap:27px;border-bottom:1px solid var(--line)}.mockup-nota-necesaria .brand{font-weight:950;font-size:19px}.mockup-nota-necesaria .brand b{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:9px;background:var(--blue);color:#fff}.mockup-nota-necesaria .nav{display:flex;gap:25px;color:#505b68;font-size:14px;font-weight:750}.mockup-nota-necesaria .search{margin-left:auto;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 15px}.mockup-nota-necesaria .hero{padding:50px 22px 45px;background:linear-gradient(118deg,#fbfcfa 0 61%,var(--soft) 61%)}.mockup-nota-necesaria .hero-grid,.mockup-nota-necesaria .wrap{max-width:1180px;margin:auto}.mockup-nota-necesaria .hero-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:57px;align-items:center}.mockup-nota-necesaria .crumb{font-size:14px;color:var(--blue);font-weight:850}.mockup-nota-necesaria .eyebrow{margin-top:27px;color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-nota-necesaria .hero h1{font-size:clamp(43px,5vw,67px);line-height:.98;letter-spacing:-.05em;margin:10px 0 19px}.mockup-nota-necesaria .lead{font-size:19px;color:var(--muted);max-width:650px}.mockup-nota-necesaria .pills{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.mockup-nota-necesaria .pills span{padding:8px 12px;border:1px solid var(--line);border-radius:99px;background:#fff;font-size:13px;font-weight:800}.mockup-nota-necesaria .art{height:330px;border:1px solid color-mix(in srgb,var(--accent),#fff 62%);background:#fff;border-radius:24px;box-shadow:0 24px 50px #17374a18;position:relative;overflow:hidden;display:grid;place-items:center}.mockup-nota-necesaria .phscale{position:absolute;left:12%;right:12%;bottom:38px;height:24px;border-radius:99px;background:linear-gradient(90deg,#d4424d,#ea943a,#eadf55,#58ad67,#3c83b8,#7251a2);display:flex;justify-content:space-between;padding:30px 0 0;font-size:10px;font-weight:850}.mockup-nota-necesaria .tube{width:65px;height:170px;border:6px solid var(--blue);border-top:0;border-radius:0 0 35px 35px;position:absolute;top:40px}.mockup-nota-necesaria .tube i{position:absolute;left:0;right:0;bottom:0;height:62%;background:var(--accent);border-radius:0 0 27px 27px}.mockup-nota-necesaria .orbit:before,.mockup-nota-necesaria .orbit:after{content:"";position:absolute;border:1px solid #6684ad66;border-radius:50%}.mockup-nota-necesaria .orbit:before{width:210px;height:210px}.mockup-nota-necesaria .orbit:after{width:300px;height:300px}.mockup-nota-necesaria .sun{width:65px;height:65px;background:#f1bd48;border-radius:50%;box-shadow:0 0 35px #e9a52a99}.mockup-nota-necesaria .planet{position:absolute;border-radius:50%;background:var(--accent)}.mockup-nota-necesaria .p1{width:20px;height:20px;left:28%;top:29%}.mockup-nota-necesaria .p2{width:30px;height:30px;right:18%;top:45%}.mockup-nota-necesaria .p3{width:25px;height:25px;left:32%;bottom:13%}.mockup-nota-necesaria .ship{position:absolute;right:26%;top:25%;font-size:38px;color:var(--blue);transform:rotate(-25deg)}.mockup-nota-necesaria .moon .earth{width:130px;height:130px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#7ec9a4 0 20%,#3987af 22% 100%)}.mockup-nota-necesaria .moon .luna{position:absolute;width:62px;height:62px;border-radius:50%;right:16%;top:20%;background:#eee6cf;box-shadow:inset -18px 3px #aaa49a}.mockup-nota-necesaria .tide{position:absolute;left:12%;right:12%;bottom:34px;height:35px;background:repeating-radial-gradient(ellipse at 20px 30px,#3994b9 0 12px,transparent 13px 25px)}.mockup-nota-necesaria .coffee .cup{font-size:110px}.mockup-nota-necesaria .steam{position:absolute;top:50px;width:18px;height:80px;border-left:5px solid var(--accent);border-radius:50%}.mockup-nota-necesaria .s1{left:43%}.mockup-nota-necesaria .s2{left:55%;top:65px}.mockup-nota-necesaria .beer .glass{width:130px;height:205px;border:7px solid var(--blue);border-top-width:12px;border-radius:12px 12px 35px 35px;position:relative;overflow:hidden}.mockup-nota-necesaria .beer .glass i{position:absolute;inset:35px 0 0;background:#e5a63f}.mockup-nota-necesaria .beer .glass b{position:absolute;left:0;right:0;top:18px;height:38px;background:#fff4d5;border-radius:50%;z-index:2}.mockup-nota-necesaria .beer>span{position:absolute;bottom:20px;font-weight:950;color:var(--blue)}.mockup-nota-necesaria .cup{grid-template-columns:1fr auto 1fr;gap:18px}.mockup-nota-necesaria .measurecup{width:125px;height:155px;border:6px solid var(--blue);border-radius:10px 10px 35px 35px;position:relative}.mockup-nota-necesaria .measurecup i{position:absolute;inset:45% 0 0;background:var(--accent)}.mockup-nota-necesaria .measurecup b{position:absolute;top:18px;left:0;right:0;text-align:center;font-size:12px}.mockup-nota-necesaria .cup>span{font-size:45px;color:var(--accent)}.mockup-nota-necesaria .weight{padding:25px 18px;background:var(--soft);border-radius:18px;font-size:25px;font-weight:950}.mockup-nota-necesaria .wall{display:flex;width:240px;height:210px;border:8px solid var(--blue)}.mockup-nota-necesaria .wall i{flex:1;border-right:2px solid #fff;background:repeating-linear-gradient(45deg,var(--accent) 0 8px,var(--soft) 9px 17px)}.mockup-nota-necesaria .cold,.mockup-nota-necesaria .warm{position:absolute;font-size:25px;font-weight:950}.mockup-nota-necesaria .cold{left:18px;color:#3182a0}.mockup-nota-necesaria .warm{right:18px;color:#c26734}.mockup-nota-necesaria .dial{width:215px;height:215px;border-radius:50%;border:18px solid var(--blue);display:grid;place-items:center;position:relative}.mockup-nota-necesaria .dial i{position:absolute;width:7px;height:75px;background:var(--accent);bottom:50%;transform-origin:bottom;transform:rotate(35deg)}.mockup-nota-necesaria .dial b{font-size:52px;margin-top:30px}.mockup-nota-necesaria .dial small{position:absolute;bottom:38px}.mockup-nota-necesaria .clockface{width:210px;height:210px;border:12px solid var(--blue);border-radius:50%;position:relative}.mockup-nota-necesaria .clockface i,.mockup-nota-necesaria .clockface b{position:absolute;left:50%;bottom:50%;width:7px;background:var(--accent);transform-origin:bottom}.mockup-nota-necesaria .clockface i{height:72px;transform:rotate(90deg)}.mockup-nota-necesaria .clockface b{height:55px;transform:rotate(10deg)}.mockup-nota-necesaria .clock>span{position:absolute;bottom:24px;font-size:23px;font-weight:950}.mockup-nota-necesaria .drop i{width:150px;height:190px;background:var(--accent);border-radius:70% 30% 70% 30%;transform:rotate(45deg)}.mockup-nota-necesaria .drop span{position:absolute;color:#fff;font-size:32px;font-weight:950}.mockup-nota-necesaria .bubble{position:absolute;padding:18px 24px;border-radius:24px;background:var(--soft);border:2px solid var(--accent);font-weight:950;font-size:23px}.mockup-nota-necesaria .bubble.a{left:9%;top:20%}.mockup-nota-necesaria .bubble.b{right:9%;top:34%}.mockup-nota-necesaria .bubble.c{left:28%;bottom:16%}.mockup-nota-necesaria .pages{width:240px;height:175px;display:flex;perspective:500px}.mockup-nota-necesaria .pages i{width:50%;background:#fff;border:6px solid var(--blue)}.mockup-nota-necesaria .pages i:first-child{transform:rotateY(14deg)}.mockup-nota-necesaria .pages i:last-child{transform:rotateY(-14deg)}.mockup-nota-necesaria .book>span{position:absolute;bottom:27px;font-weight:950;color:var(--accent)}.mockup-nota-necesaria .sheet{width:180px;height:230px;border:5px solid var(--blue);background:#fff;border-radius:12px;padding:25px}.mockup-nota-necesaria .sheet b{font-size:55px;color:var(--accent)}.mockup-nota-necesaria .sheet i{display:block;border-top:6px solid #cbd7db;margin-top:17px}.mockup-nota-necesaria .timer{position:absolute;right:22px;bottom:24px;padding:12px;background:var(--blue);color:#fff;border-radius:10px;font-weight:950}.mockup-nota-necesaria .target{width:220px;height:220px;border:24px solid var(--accent);border-radius:50%;box-shadow:inset 0 0 0 26px #fff,inset 0 0 0 48px var(--blue);display:grid;place-items:center}.mockup-nota-necesaria .target b{font-size:44px;background:#fff;border-radius:50%;padding:18px}.mockup-nota-necesaria .parrilla{width:245px;height:160px;border:10px solid var(--blue);border-radius:18px;display:flex;gap:12px;padding:28px}.mockup-nota-necesaria .parrilla i{flex:1;border-radius:30px;background:var(--accent)}.mockup-nota-necesaria .fire{position:absolute;bottom:12px;font-size:60px;color:#e78a35}.mockup-nota-necesaria .timeline .line{position:absolute;left:12%;right:12%;top:50%;height:8px;background:var(--blue);display:flex;justify-content:space-between}.mockup-nota-necesaria .timeline .line i{width:29px;height:29px;border:7px solid var(--blue);background:#fff;border-radius:50%;transform:translateY(-11px)}.mockup-nota-necesaria .truck{position:absolute;left:30%;top:38%;font-size:50px;color:var(--accent)}.mockup-nota-necesaria .donut{width:220px;height:220px;border-radius:50%;background:conic-gradient(var(--accent) 0 40%,#e7af53 40% 65%,#4d98a1 65% 80%,#dce4e4 80%);position:relative}.mockup-nota-necesaria .donut:after{content:"";position:absolute;inset:55px;background:#fff;border-radius:50%}.mockup-nota-necesaria .budget>span{position:absolute;font-size:50px;font-weight:950;color:var(--blue)}
.mockup-nota-necesaria .tool{padding:62px 22px}.mockup-nota-necesaria .tool-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.mockup-nota-necesaria .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:950}.mockup-nota-necesaria .tool h2,.mockup-nota-necesaria .guide h2{font-size:37px;letter-spacing:-.04em;margin:7px 0}.mockup-nota-necesaria .tool-head p{max-width:510px;color:var(--muted);margin:0}.mockup-nota-necesaria .workspace{display:grid;grid-template-columns:1.05fr .95fr;gap:20px}.mockup-nota-necesaria .panel{border-radius:24px;padding:27px}.mockup-nota-necesaria .form{border:1px solid var(--line);box-shadow:0 16px 40px #18374a0c}.mockup-nota-necesaria .panel h3{font-size:21px;margin:0 0 5px}.mockup-nota-necesaria .hint{color:var(--muted);font-size:14px;margin:0 0 20px}.mockup-nota-necesaria .fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.mockup-nota-necesaria .field{margin-bottom:2px}.mockup-nota-necesaria .field label{display:flex;justify-content:space-between;font-size:13px;font-weight:850;margin-bottom:7px}.mockup-nota-necesaria .field output{color:var(--accent)}.mockup-nota-necesaria input,.mockup-nota-necesaria select{width:100%;min-height:49px;border:1px solid #ccd7da;border-radius:12px;background:#fff;padding:12px 14px;color:var(--ink)}.mockup-nota-necesaria input[type=range]{padding:0;accent-color:var(--accent)}.mockup-nota-necesaria .actions{display:flex;gap:9px;margin-top:21px}.mockup-nota-necesaria .primary{flex:1;border:0;border-radius:12px;background:var(--blue);color:#fff;padding:14px;font-weight:900;cursor:pointer}.mockup-nota-necesaria .reset{border:1px solid #d7aa58;border-radius:12px;background:#fff;color:#654a1f;padding:13px 16px;font-weight:850;cursor:pointer}.mockup-nota-necesaria .result{background:linear-gradient(145deg,var(--blue),color-mix(in srgb,var(--blue),var(--accent) 35%));color:#fff;position:relative;overflow:hidden}.mockup-nota-necesaria .badge{display:inline-block;padding:7px 10px;border-radius:99px;background:var(--mint);color:#174f40;font-size:12px;font-weight:950}.mockup-nota-necesaria .big{font-size:48px;line-height:1;font-weight:950;letter-spacing:-.05em;margin:14px 0 5px}.mockup-nota-necesaria .caption{color:#dceaf0;font-size:14px}.mockup-nota-necesaria .meter{height:13px;border-radius:99px;background:#ffffff2d;margin:24px 0;position:relative}.mockup-nota-necesaria .meter i{position:absolute;left:var(--position);top:50%;width:24px;height:24px;border:5px solid #fff;background:var(--accent);border-radius:50%;transform:translate(-50%,-50%);transition:.25s}.mockup-nota-necesaria .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.mockup-nota-necesaria .metric{padding:13px;border:1px solid #ffffff2b;background:#ffffff0e;border-radius:13px}.mockup-nota-necesaria .metric small{display:block;color:#dceaf0;font-size:10px}.mockup-nota-necesaria .metric b{font-size:16px}.mockup-nota-necesaria .note{margin-top:17px;padding:14px 15px;border-radius:12px;background:var(--cream);color:#58461f;font-size:13px}.mockup-nota-necesaria .guide{padding:65px 22px;background:var(--paper)}.mockup-nota-necesaria .guide-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px}.mockup-nota-necesaria .guide p{color:var(--muted)}.mockup-nota-necesaria .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.mockup-nota-necesaria .step{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff}.mockup-nota-necesaria .step b{display:block;color:var(--accent);margin-bottom:5px}.mockup-nota-necesaria .step span{font-size:14px;color:var(--muted)}.mockup-nota-necesaria .foot{padding:30px;text-align:center;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.mockup-nota-necesaria .nav{display:none}.mockup-nota-necesaria .hero-grid,.mockup-nota-necesaria .workspace,.mockup-nota-necesaria .guide-grid{grid-template-columns:1fr}.mockup-nota-necesaria .tool-head{flex-direction:column;align-items:start}}@media(max-width:550px){.mockup-nota-necesaria .fields,.mockup-nota-necesaria .metrics,.mockup-nota-necesaria .steps{grid-template-columns:1fr}.mockup-nota-necesaria .hero h1{font-size:43px}.mockup-nota-necesaria .actions{flex-direction:column}.mockup-nota-necesaria .art{height:290px}}

.mockup-nota-necesaria { width:100%; overflow:hidden; }
.mockup-nota-necesaria .top, .mockup-nota-necesaria header.top { display:none !important; }
.mockup-nota-necesaria .foot { display:none !important; }
.mockup-nota-necesaria .support-real { width:min(1160px,calc(100% - 40px)); margin:auto; padding:64px 0; }
.mockup-nota-necesaria .support-real-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:30px; }
.mockup-nota-necesaria .support-real details { border-bottom:1px solid #dfe6ed; padding:14px 0; }
.mockup-nota-necesaria .support-real summary { cursor:pointer; font-weight:750; }
.mockup-nota-necesaria .support-real p { color:#52657b; line-height:1.65; }
/* Prevent the legacy site's global typography palette from overriding text
   designed to inherit a light color inside dark mockup surfaces. */
.mockup-nota-necesaria :where(h1,h2,h3,h4,h5,h6,p,span,strong,b,small,em,i,a,label,button,summary,li,th,td) { color:inherit; }
.mockup-nota-necesaria input[type="number"] { -moz-appearance:textfield; appearance:textfield; }
.mockup-nota-necesaria input[type="number"]::-webkit-inner-spin-button, .mockup-nota-necesaria input[type="number"]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
@media(max-width:800px){.mockup-nota-necesaria .support-real-grid{grid-template-columns:1fr}}
</style>
{data && <><HubCitableStats data={data} /><section class="mockup-nota-necesaria support-real"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq?.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes</h2>{data.sources?.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section></>}
