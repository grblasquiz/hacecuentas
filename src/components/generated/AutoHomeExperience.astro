<div class="mockup-auto-home" set:html={`<div class="hero"><div class="wrap"><div class="crumb">Inicio / Auto</div><div class="heroGrid"><div><span class="eyebrow">El costo real de moverte</span><h1>Tu auto cuesta más que la nafta.</h1><p class="lead">Consumo, patente, seguro, service, cochera y pérdida de valor: juntá todos los gastos para decidir con el número completo.</p><div class="trust"><span>✓ Comparación real</span><span>✓ Costos visibles y ocultos</span><span>✓ Todos los trámites</span></div><div class="carArt"><div class="carBody"></div><div class="window"></div><i class="wheel one"></i><i class="wheel two"></i></div></div>
<div class="calc"><div class="calcHead"><div><h2>¿Cuánto te cuesta usarlo?</h2><p>Estimación mensual y por kilómetro.</p></div><span class="live">EN VIVO</span></div><div class="scenario" id="carA"><h3>AUTO PRINCIPAL</h3><div class="fields"><div class="field"><label>Kilómetros por mes</label><div class="input"><input id="kmA" value="1200"><span>km</span></div></div><div class="field"><label>Consumo</label><div class="input"><input id="consA" value="8.5"><span>L/100</span></div></div><div class="field"><label>Nafta por litro</label><div class="input"><span>$</span><input id="fuel" value="1450"></div></div></div></div><button class="compare" id="compare">＋ Comparar con otro auto</button><div class="scenario two" id="carB"><h3>SEGUNDO AUTO</h3><div class="fields"><div class="field"><label>Kilómetros por mes</label><div class="input"><input id="kmB" value="1200"><span>km</span></div></div><div class="field"><label>Consumo</label><div class="input"><input id="consB" value="6.2"><span>L/100</span></div></div><div class="field"><label>Costos fijos mensuales</label><div class="input"><span>$</span><input id="fixedB" value="310000"></div></div></div></div><div class="fields" style="margin-top:10px"><div class="field"><label>Seguro + patente mensual</label><div class="input"><span>$</span><input id="fixedA" value="260000"></div></div><div class="field"><label>Service mensualizado</label><div class="input"><span>$</span><input id="serviceA" value="70000"></div></div><div class="field"><label>Cochera y peajes</label><div class="input"><span>$</span><input id="otherA" value="110000"></div></div></div><button class="primary" id="calculate">Actualizar costo</button><div class="result"><small>COSTO TOTAL ESTIMADO · AUTO PRINCIPAL</small><div class="amount" id="totalA">$587.900 / mes</div><div class="resultGrid"><div class="metric"><span>COMBUSTIBLE</span><b id="fuelA">$147.900</b></div><div class="metric"><span>POR KILÓMETRO</span><b id="perKm">$490</b></div><div class="metric"><span>POR AÑO</span><b id="yearA">$7.054.800</b></div></div><div class="comparison" id="comparison"></div></div></div></div></div></div>
<section><div class="wrap"><div class="sectionHead"><span class="eyebrow">Tu momento</span><h2>¿Qué necesitás resolver con tu auto?</h2><p>Elegí la situación y te mostramos primero las cuentas adecuadas.</p></div><div class="journey"><button class="stage active" data-filter="comprar"><span class="icon">＋</span><h3>Quiero comprar</h3><p>Precio, financiación, transferencia y costo inicial.</p><em>→</em></button><button class="stage" data-filter="usar"><span class="icon">↗</span><h3>Quiero usarlo</h3><p>Consumo, nafta, peajes y comparación.</p><em>→</em></button><button class="stage" data-filter="mantener"><span class="icon">⚙</span><h3>Tengo que mantenerlo</h3><p>Service, cubiertas, seguro y patente.</p><em>→</em></button><button class="stage" data-filter="tramites"><span class="icon">▤</span><h3>Tengo un trámite</h3><p>Transferencia, licencia, VTV y papeles.</p><em>→</em></button><button class="stage" data-filter="decidir"><span class="icon">⇄</span><h3>Estoy comparando</h3><p>Auto, transporte, Uber o segundo vehículo.</p><em>→</em></button></div></div></section>
<section class="tint" id="tools"><div class="wrap"><div class="sectionHead"><span class="eyebrow">Herramientas para tu auto</span><h2>Todos los costos, en un solo lugar.</h2></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="all">Todas</button><button class="filter" data-filter="comprar">Comprar</button><button class="filter" data-filter="usar">Uso</button><button class="filter" data-filter="mantener">Mantenimiento</button><button class="filter" data-filter="tramites">Trámites</button><button class="filter" data-filter="decidir">Comparar</button></div><input class="search" id="search" placeholder="Buscar una herramienta…"></div><div class="cards"><article class="card featured" data-cat="usar decidir" data-text="costo anual auto nafta seguro patente service"><span class="tag">La cuenta completa</span><h3>Costo anual de tu auto</h3><p>Convertí cada gasto mensual, trimestral y anual en un único costo por mes y por kilómetro.</p><button>Calcular costo total →</button></article><article class="card" data-cat="usar decidir" data-text="consumo combustible comparar autos nafta"><span class="tag">Comparador</span><h3>Consumo de combustible</h3><p>Compará dos autos con kilómetros, consumo y precio de nafta propios.</p><button>Comparar consumos →</button></article><article class="card" data-cat="mantener" data-text="mantenimiento service cubiertas bateria correa"><span class="tag">Planificación</span><h3>Mantenimiento del auto</h3><p>Armá el calendario y mensualizá service, cubiertas y reparaciones.</p><button>Planificar →</button></article><article class="card" data-cat="mantener tramites" data-text="patente provincia comparar alicuota valuacion"><span class="tag">Impuestos</span><h3>Patente por provincia</h3><p>Estimá y compará el impuesto automotor según valuación y jurisdicción.</p><button>Comparar provincias →</button></article><article class="card" data-cat="tramites comprar" data-text="tramites transferencia vtv licencia documentos"><span class="tag">Papeles</span><h3>Trámites del auto</h3><p>Transferencia, VTV, licencia y costos documentales ordenados.</p><button>Ver trámites →</button></article><article class="card" data-cat="decidir comprar" data-text="auto o uber comparar transporte kilometros"><span class="tag">Decisión</span><h3>¿Auto o Uber?</h3><p>Compará costo total, frecuencia de uso y valor del tiempo.</p><button>Comparar →</button></article><div class="empty" id="empty">No encontramos una herramienta con esa búsqueda.</div></div></div></section>
<section><div class="wrap"><div class="split"><article class="panel"><h3>Costos que suelen olvidarse</h3><p>El gasto diario es solo una parte.</p><div class="line"><span>Depreciación del vehículo</span><b>20–30% del total</b></div><div class="line"><span>Service y reparaciones</span><b>Mensualizar</b></div><div class="line"><span>Patente, VTV y trámites</span><b>Prorratear</b></div><div class="line"><span>Cochera y costo financiero</span><b>Sumar siempre</b></div></article><article class="panel dark"><h3>Una comparación justa</h3><p>Para comparar dos autos, mantené iguales los kilómetros y el precio de combustible, pero usá el consumo y los costos fijos propios de cada vehículo. El comparador de arriba ya trabaja así.</p><div class="line"><span>Resultado principal</span><b>Costo por km</b></div><div class="line"><span>Horizonte recomendado</span><b>12 meses</b></div><div class="line"><span>Revisión</span><b>Cada service</b></div></article></div></div></section><button type="button" id="toast" hidden aria-hidden="true"></button>`} />
<script is:inline>
(()=>{const root=document.currentScript.previousElementSibling?.matches('.mockup-auto-home')?document.currentScript.previousElementSibling:document.querySelector('.mockup-auto-home');if(!root)return;

const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)],num=id=>Math.max(0,Number($(id).value.replaceAll(".","").replaceAll(",",""))||0),money=n=>"$"+Math.round(n).toLocaleString("es-AR");let comparing=false;
function calc(){const km=num("#kmA"),fuel=num("#fuel"),fuelCost=km*num("#consA")/100*fuel,total=fuelCost+num("#fixedA")+num("#serviceA")+num("#otherA");$("#fuelA").textContent=money(fuelCost);$("#totalA").textContent=money(total)+" / mes";$("#perKm").textContent=money(total/(km||1));$("#yearA").textContent=money(total*12);if(comparing){const bFuel=num("#kmB")*num("#consB")/100*fuel,bTotal=bFuel+num("#fixedB"),diff=bTotal-total;$("#comparison").textContent=(diff<0?"El segundo auto ahorra ":"El segundo auto cuesta ")+money(Math.abs(diff))+" "+(diff<0?"por mes.":"más por mes.");$("#comparison").classList.add("show")}}
$$(".calc input").forEach(x=>x.oninput=calc);$("#compare").onclick=e=>{comparing=!comparing;$("#carB").classList.toggle("show",comparing);$("#comparison").classList.toggle("show",comparing);e.currentTarget.textContent=comparing?"× Quitar comparación":"＋ Comparar con otro auto";calc()};$("#calculate").onclick=e=>{calc();const t=e.currentTarget.textContent;e.currentTarget.textContent="✓ Costo actualizado";setTimeout(()=>e.currentTarget.textContent=t,1100)};
function filter(cat="all"){const q=$("#search").value.toLowerCase().trim();let n=0;$$(".card").forEach(c=>{const ok=(cat==="all"||c.dataset.cat.includes(cat))&&(!q||c.dataset.text.includes(q));c.style.display=ok?"":"none";if(ok)n++});$("#empty").style.display=n?"none":"block"}$$(".filter").forEach(b=>b.onclick=()=>{$$(".filter").forEach(x=>x.classList.toggle("active",x===b));filter(b.dataset.filter)});$("#search").oninput=()=>filter($(".filter.active").dataset.filter);$$(".stage").forEach(b=>b.onclick=()=>{$$(".stage").forEach(x=>x.classList.toggle("active",x===b));const f=b.dataset.filter,t=$$(".filter").find(x=>x.dataset.filter===f);$$(".filter").forEach(x=>x.classList.toggle("active",x===t));filter(f);$("#tools").scrollIntoView({behavior:"smooth"})});function toast(t){$("#toast").textContent="Abriendo: "+t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1600)}$$(".card button").forEach(b=>b.onclick=()=>toast(b.closest(".card").querySelector("h3").textContent));calc();

})();
</script>
<style is:global>

