.mockup-auto-home .calc{background:#fff;border:1px solid #dbe3ea;border-radius:25px;padding:27px;box-shadow:var(--shadow)}.mockup-auto-home .calcHead{display:flex;justify-content:space-between;align-items:start}.mockup-auto-home .calc h2{margin:0;font-size:25px;letter-spacing:-.035em}.mockup-auto-home .calcHead p{margin:5px 0 0;color:var(--muted);font-size:13px}.mockup-auto-home .live{background:#e5f8f2;color:#13745b;border-radius:99px;padding:7px 9px;font-size:9px;font-weight:900}.mockup-auto-home .scenario{border:1px solid var(--line);border-radius:15px;padding:14px;margin-top:17px}.mockup-auto-home .scenario h3{font-size:12px;margin:0 0 11px}.mockup-auto-home .scenario.two{display:none;background:#f7faff;border-color:#b8caec}.mockup-auto-home .scenario.two.show{display:block}.mockup-auto-home .fields{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mockup-auto-home .field label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.07em;color:#788598;font-weight:850;margin-bottom:6px}.mockup-auto-home .input{height:43px;border:1px solid #d8dfe5;border-radius:10px;display:flex;align-items:center;gap:5px;padding:0 10px}.mockup-auto-home .input input{border:0;outline:0;width:100%;font-weight:850;color:var(--ink)}.mockup-auto-home .input span{font-size:10px;color:var(--muted)}.mockup-auto-home .compare{border:1px dashed #91a8d7;background:#f5f8ff;color:var(--blue);border-radius:11px;padding:10px;width:100%;margin-top:11px;font-size:11px;font-weight:850;cursor:pointer}.mockup-auto-home .primary{width:100%;height:50px;border:0;border-radius:12px;background:var(--blue);color:#fff;font-weight:900;margin-top:13px;cursor:pointer}.mockup-auto-home .result{background:var(--navy);color:#fff;border-radius:17px;padding:19px;margin-top:14px}.mockup-auto-home .result small{font-size:8px;letter-spacing:.09em;color:#adc1d8}.mockup-auto-home .amount{font-size:37px;font-weight:950;letter-spacing:-.05em;margin:3px 0}.mockup-auto-home .resultGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:13px}.mockup-auto-home .metric{padding:9px;background:#ffffff0c;border:1px solid #ffffff15;border-radius:9px}.mockup-auto-home .metric span{display:block;font-size:7px;color:#aebfd2}.mockup-auto-home .metric b{font-size:11px}.mockup-auto-home .comparison{display:none;margin-top:10px;background:#dff18d;color:#294839;border-radius:10px;padding:10px;font-size:11px;font-weight:850}.mockup-auto-home .comparison.show{display:block}
.mockup-auto-home section{padding:75px 0}.mockup-auto-home .sectionHead{text-align:center;max-width:710px;margin:0 auto 38px}.mockup-auto-home .sectionHead h2{font-size:39px;letter-spacing:-.045em;margin:10px 0}.mockup-auto-home .sectionHead p{color:var(--muted);line-height:1.55}.mockup-auto-home .journey{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.mockup-auto-home .stage{text-align:left;border:1px solid var(--line);background:#fff;border-radius:18px;padding:19px;color:var(--ink);cursor:pointer;min-height:177px;position:relative}.mockup-auto-home .stage:hover,.mockup-auto-home .stage.active{transform:translateY(-3px);border-color:var(--blue);box-shadow:0 14px 33px rgba(32,72,140,.11)}.mockup-auto-home .stage.active{background:var(--navy);color:#fff}.mockup-auto-home .stage.active p{color:#b9c8da}.mockup-auto-home .icon{width:36px;height:36px;background:var(--sky);color:var(--blue);border-radius:11px;display:grid;place-items:center;font-size:17px}.mockup-auto-home .stage h3{font-size:16px;margin:15px 0 7px}.mockup-auto-home .stage p{font-size:11px;color:var(--muted);line-height:1.45;margin:0}.mockup-auto-home .stage em{position:absolute;right:16px;bottom:14px;color:var(--blue);font-style:normal;font-weight:900}
.mockup-auto-home .tint{background:#edf3f8}.mockup-auto-home .toolbar{display:flex;justify-content:space-between;gap:14px;margin-bottom:18px}.mockup-auto-home .filters{display:flex;gap:7px;flex-wrap:wrap}.mockup-auto-home .filter{border:1px solid var(--line);background:#fff;border-radius:99px;padding:9px 12px;font-size:9px;font-weight:850;color:var(--muted);cursor:pointer}.mockup-auto-home .filter.active{background:var(--navy);color:#fff;border-color:var(--navy)}.mockup-auto-home .search{min-width:230px;border:1px solid var(--line);border-radius:11px;padding:10px 12px}.mockup-auto-home .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.mockup-auto-home .card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;min-height:195px;display:flex;flex-direction:column}.mockup-auto-home .card.featured{grid-column:span 2;background:linear-gradient(135deg,var(--navy),#24537b);color:#fff;border:0}.mockup-auto-home .tag{font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);font-weight:900}.mockup-auto-home .featured .tag{color:#81dcd5}.mockup-auto-home .card h3{font-size:19px;margin:11px 0 7px;letter-spacing:-.025em}.mockup-auto-home .card p{font-size:11px;line-height:1.5;color:var(--muted);margin:0}.mockup-auto-home .featured p{color:#bdccdc}.mockup-auto-home .card button{align-self:start;margin-top:auto;border:0;background:transparent;padding:18px 0 0;color:var(--blue);font-weight:900;cursor:pointer}.mockup-auto-home .featured button{color:var(--lime)}.mockup-auto-home .empty{display:none;grid-column:1/-1;text-align:center;color:var(--muted);padding:30px}.mockup-auto-home .split{display:grid;grid-template-columns:1fr 1fr;gap:16px}.mockup-auto-home .panel{background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px}.mockup-auto-home .panel.dark{background:var(--navy);color:#fff;border:0}.mockup-auto-home .panel h3{font-size:23px;margin:0 0 8px}.mockup-auto-home .panel p{font-size:13px;line-height:1.55;color:var(--muted)}.mockup-auto-home .dark p{color:#b9cad8}.mockup-auto-home .line{display:flex;justify-content:space-between;padding:12px 0;border-top:1px solid var(--line);font-size:12px}.mockup-auto-home .dark .line{border-color:#ffffff17}.mockup-auto-home .line b{color:var(--blue)}.mockup-auto-home .dark .line b{color:var(--lime)}.mockup-auto-home .toast{position:fixed;right:22px;bottom:22px;background:var(--navy);color:white;padding:13px 16px;border-radius:12px;font-size:11px;font-weight:850;transform:translateY(80px);opacity:0;transition:.25s;z-index:30}.mockup-auto-home .toast.show{transform:none;opacity:1}.mockup-auto-home footer{background:var(--navy);color:#fff;padding:45px 0}.mockup-auto-home .foot{display:flex;justify-content:space-between;color:#b9c8d5}.mockup-auto-home .foot strong{color:#fff}
