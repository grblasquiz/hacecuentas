<script is:inline>
  (() => {
    const container = document.querySelector('.calc-container[data-slug="calculadora-gasto-tarjeta-sube-mensual"]');
    if (!container || container.dataset.subeUxReady === 'true') return;
    container.dataset.subeUxReady = 'true';

    const form = container.querySelector('.calc-form');
    if (!form) return;

    const groups = form.querySelectorAll('.input-group');
    groups.forEach((group, index) => {
      group.classList.add(`sube-step-${index + 1}`);
    });

    const overview = document.createElement('section');
    overview.className = 'sube-route-overview';
    overview.setAttribute('aria-live', 'polite');
    overview.innerHTML = `
      <div class="sube-route-head">
        <span><strong>Tu viaje en un vistazo</strong><small>Un recorrido; la calculadora lo repite por día y por mes.</small></span>
        <span class="sube-live-dot">En vivo</span>
      </div>
      <div class="sube-route-line" data-sube-route></div>
      <div class="sube-route-meta">
        <span data-sube-frequency></span>
        <span data-sube-benefit></span>
      </div>
    `;
    form.prepend(overview);

    const compactLabel = (select) => {
      if (!select || select.value === 'ninguno') return null;
      const raw = select.options[select.selectedIndex]?.textContent || '';
      return raw
        .replace(/\s*\([^)]*\)\s*$/, '')
        .replace('Colectivo nacional · ', 'Nacional · ')
        .replace('Colectivo CABA · ', 'CABA · ')
        .replace('Colectivo PBA · ', 'PBA · ')
        .replace('Tren AMBA · ', 'Tren · ')
        .replace('tarifa progresiva por cantidad de viajes', 'tarifa progresiva')
        .trim();
    };
    const transportIcon = (value) => {
      if (value.startsWith('tren')) return '🚆';
      if (value === 'subte' || value === 'premetro') return '🚇';
      return '🚌';
    };

    const update = () => {
      const route = overview.querySelector('[data-sube-route]');
      const frequency = overview.querySelector('[data-sube-frequency]');
      const benefit = overview.querySelector('[data-sube-benefit]');
      const selects = ['tramo1', 'tramo2', 'tramo3']
        .map((id) => form.querySelector(`#${id}`))
        .filter(Boolean);
      const active = selects
        .map((select) => ({ select, label: compactLabel(select) }))
        .filter((item) => item.label);

      route.innerHTML = active.map((item, index) => `
        ${index ? '<span class="sube-route-arrow" aria-hidden="true">→</span>' : ''}
        <span class="sube-route-stop">
          <i aria-hidden="true">${transportIcon(item.select.value)}</i>
          <b>${item.label}</b>
        </span>
      `).join('');

      const days = form.querySelector('#diasViajeMes')?.value || '—';
      const routes = form.querySelector('#recorridosPorDia')?.value || '—';
      frequency.textContent = `📅 ${routes} recorridos por día · ${days} días`;

      const profile = form.querySelector('#perfilTarifario');
      const red = form.querySelector('#usarRedSube');
      const profileText = profile?.options[profile.selectedIndex]?.textContent || 'SUBE registrada';
      const redText = red && !red.closest('.field')?.hidden && red.value === 'si' && active.length > 1
        ? ' · RED SUBE activa'
        : '';
      benefit.textContent = `💳 ${profileText}${redText}`;
    };

    form.addEventListener('input', update);
    form.addEventListener('change', update);
    container.querySelectorAll('.preset-btn').forEach((button) => {
      button.addEventListener('click', () => requestAnimationFrame(update));
    });
    update();

    const submitText = form.querySelector('.btn-primary .btn-content');
    if (submitText) {
      const textNode = Array.from(submitText.childNodes).find((node) => node.nodeType === Node.TEXT_NODE);
      if (textNode) textNode.textContent = ' Actualizar cálculo';
    }
  })();
</script>

