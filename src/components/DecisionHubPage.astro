---
/**
 * Template de página de hub de decisiones (/decidir/<hub>). Lo instancian las
 * rutas explícitas src/pages/decidir/{laborales,vivienda,deudas,negocio}.astro
 * (rutas explícitas pisan a [slug].astro, así que no colisionan con las salas).
 *
 * Producto SEO completo: CollectionPage + ItemList + FAQPage + BreadcrumbList,
 * copy editorial propio por hub (lede + pitch), FAQ ≥7 y cards a cada sala
 * miembro. Cierra con enlaces a los otros hubs para tejer la malla interna.
 */
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { DECISION_HUBS, type DecisionHub } from '../lib/decisions/hubs';
import { DECISION_MANIFEST } from '../lib/decisions/manifest';

interface Props {
  hub: DecisionHub;
}

const { hub } = Astro.props;

const site = 'https://hacecuentas.com';
const url = `${site}/decidir/${hub.slug}`;
const title = `${hub.title} | Hacé Cuentas`;

const bySlug = new Map(DECISION_MANIFEST.map((r) => [r.slug, r]));
const rooms = hub.roomSlugs.map((s) => bySlug.get(s)).filter(Boolean) as typeof DECISION_MANIFEST;

const otherHubs = DECISION_HUBS.filter((h) => h.slug !== hub.slug);

const dateModified = new Date(hub.lastReviewed + 'T00:00:00Z').toISOString();

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Decisiones', item: `${site}/decidir` },
        { '@type': 'ListItem', position: 3, name: hub.h1 },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: hub.h1,
      description: hub.description,
      url,
      inLanguage: 'es-AR',
      dateModified,
      isPartOf: { '@id': `${site}/#website` },
      publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: site },
    },
    {
      '@type': 'ItemList',
      itemListElement: rooms.map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${site}/decidir/${r.slug}`,
        name: r.h1,
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      url,
      inLanguage: 'es-AR',
      mainEntity: hub.faq.map((f, i) => ({
        '@type': 'Question',
        '@id': `${url}#faq-${i + 1}`,
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a, inLanguage: 'es-AR' },
      })),
    },
  ],
};
---

<Layout title={title} description={hub.description} schema={schema} audience="AR" domain="money">
  <Header slot="header" />

  <main class="dhub">
    <nav class="dhub-breadcrumb" aria-label="Migas de pan">
      <a href="/">Inicio</a> <span aria-hidden="true">›</span>
      <a href="/decidir">Decisiones</a> <span aria-hidden="true">›</span>
      <span aria-current="page">{hub.h1}</span>
    </nav>

    <header class="dhub-head">
      <span class="dhub-eyebrow">🧭 Salas de decisión</span>
      <h1>{hub.icon} {hub.h1}</h1>
      <p class="dhub-lede">{hub.lede}</p>
    </header>

    <ul class="dhub-grid">
      {rooms.map((r) => (
        <li>
          <a href={`/decidir/${r.slug}`} class="dhub-card">
            <span class="dhub-icon" aria-hidden="true">{r.icon}</span>
            <span class="dhub-card-title">{r.h1}</span>
            <span class="dhub-card-desc">{r.description}</span>
            <span class="dhub-card-cta">Abrir la sala →</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="dhub-pitch">
      <h2>Por qué decidir con una sala y no a ojo</h2>
      <p>{hub.pitch}</p>
      <p class="dhub-pitch-how">
        Cada sala funciona igual: cargás tus datos una vez, combinamos varias fórmulas por
        dentro y te devolvemos una conclusión directa, el número que decide, tres escenarios
        y los próximos pasos. Sin registro y con el desglose del cálculo a la vista.
      </p>
    </section>

    <section class="dhub-faq-section" id="faq">
      <h2>Preguntas frecuentes</h2>
      <div class="dhub-faq">
        {hub.faq.map((f, i) => (
          <details id={`faq-${i + 1}`}>
            <summary>{f.q}</summary>
            <div>
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="dhub-others">
      <h2>Otras decisiones</h2>
      <ul class="dhub-other-links">
        {otherHubs.map((h) => (
          <li>
            <a href={`/decidir/${h.slug}`}>{h.icon} {h.h1}</a>
          </li>
        ))}
        <li>
          <a href="/decidir">🧭 Todas las salas de decisión</a>
        </li>
      </ul>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .dhub {
    max-width: 880px;
    margin: 0 auto;
    padding: 1.25rem 1rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .dhub-breadcrumb {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .dhub-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .dhub-breadcrumb a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .dhub-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dhub-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dhub-head h1 {
    margin: 0;
    font-size: clamp(1.625rem, 5vw, 2.375rem);
    line-height: 1.15;
    color: var(--text);
  }
  .dhub-lede {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 62ch;
  }
  .dhub-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .dhub-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 0.75rem);
    background: var(--bg);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.1s, box-shadow 0.15s;
  }
  .dhub-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.08));
  }
  .dhub-icon {
    font-size: 1.75rem;
  }
  .dhub-card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
  }
  .dhub-card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
  }
  .dhub-card-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
  }
  .dhub-pitch h2,
  .dhub-faq-section h2,
  .dhub-others h2 {
    font-size: 1.375rem;
    margin: 0 0 0.75rem;
    color: var(--text);
  }
  .dhub-pitch p {
    margin: 0 0 0.75rem;
    line-height: 1.65;
    color: var(--text);
    max-width: 68ch;
  }
  .dhub-pitch p:last-child {
    margin-bottom: 0;
  }
  .dhub-pitch-how {
    color: var(--text-muted);
  }
  .dhub-faq details {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
  }
  .dhub-faq summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }
  .dhub-faq details > div {
    padding-top: 0.5rem;
  }
  .dhub-faq p {
    margin: 0;
    line-height: 1.6;
    color: var(--text);
  }
  .dhub-other-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .dhub-other-links a {
    display: inline-block;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--bg);
    color: var(--accent-strong, #0369a1);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .dhub-other-links a:hover {
    border-color: var(--accent);
    background: var(--accent-soft, #e0f2fe);
  }
</style>
