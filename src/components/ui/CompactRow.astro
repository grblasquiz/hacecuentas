---
/**
 * CompactRow — fila densa: ícono · label · valor. Para listas apretadas
 * (rankings, "también te puede interesar" en formato lista, tablas ligeras).
 * Con `href` se vuelve un link con hover.
 */
interface Props {
  label: string;
  value?: string | number;
  href?: string;
  icon?: string;      // inner SVG (paths)
  class?: string;
}
const { label, value, href, icon, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
const hasIcon = !!icon || Astro.slots.has('icon');
---
<Tag class={`ui-row ${className}`} href={href}>
  {hasIcon && (
    <span class="ui-row__icon">
      {icon
        ? <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
        : <slot name="icon" />}
    </span>
  )}
  <span class="ui-row__label">{label}</span>
  {value != null && <span class="ui-row__value">{value}</span>}
</Tag>
