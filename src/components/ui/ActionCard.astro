---
/**
 * ActionCard — ícono + título + descripción + flecha. La card de navegación
 * canónica (grillas de "seguí calculando", hubs, atajos). Clickable.
 * Ícono: pasá SVG inner por la prop `icon` (paths, como CategoryIcon) o usá el
 * slot "icon" para un componente. `arrow={false}` para ocultar la flecha.
 */
interface Props {
  href: string;
  title: string;
  desc?: string;
  icon?: string;      // inner SVG (paths); se dibuja en viewBox 0 0 24 24
  arrow?: boolean;
  class?: string;
}
const { href, title, desc, icon, arrow = true, class: className = '' } = Astro.props;
const hasIcon = !!icon || Astro.slots.has('icon');
---
<a class={`ui-card ui-card--interactive ui-action ${className}`} href={href}>
  {hasIcon && (
    <span class="ui-action__icon">
      {icon
        ? <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
        : <slot name="icon" />}
    </span>
  )}
  <span class="ui-action__body">
    <span class="ui-action__title">{title}</span>
    {desc && <span class="ui-action__desc">{desc}</span>}
    <slot />
  </span>
  {arrow && (
    <svg class="ui-action__arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
  )}
</a>
