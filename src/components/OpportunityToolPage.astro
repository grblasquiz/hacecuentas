---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { opportunityTools, type OpportunityTool } from '../lib/opportunity-tools';
const { tool } = Astro.props as { tool: OpportunityTool };
const canonical = `https://hacecuentas.com/${tool.slug}`;
const schema = { '@context':'https://schema.org', '@graph': [
  { '@type':'WebApplication', name:tool.title, url:canonical, applicationCategory:'FinanceApplication', operatingSystem:'Web', offers:{'@type':'Offer',price:'0',priceCurrency:'ARS'} },
  { '@type':'FAQPage', mainEntity:tool.faq.map(({q,a})=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})) },
  { '@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:'https://hacecuentas.com/'},{'@type':'ListItem',position:2,name:tool.eyebrow,item:canonical}] }
]};
const field = (name:string,label:string,value:string,extra='') => ({name,label,value,extra});
const fields: Record<string, ReturnType<typeof field>[]> = {
  judicial:[field('capital','Capital original','1000000'),field('dias','Días del período','365'),field('inflacion','Inflación acumulada','35','%'),field('tasa','Tasa judicial anual','40','%')],
  ecommerce:[field('precio','Precio de venta','100000'),field('producto','Costo del producto','45000'),field('comision','Comisión de plataforma','14','%'),field('cobro','Costo de cobro','4','%'),field('publicidad','Publicidad y devoluciones','6','%'),field('envio','Envío absorbido','5000'),field('iibb','Ingresos Brutos','3.5','%'),field('cuotaVenta','Monotributo asignado por venta','2500')],
  unitario:[field('limite','Límite unitario vigente','716841'),field('p1','Producto 1 · precio unitario','300000'),field('q1','Cantidad','2'),field('p2','Producto 2 · precio unitario','400000'),field('q2','Cantidad','1'),field('p3','Producto 3 · precio unitario','0'),field('q3','Cantidad','0')],
  cuota:[field('impuesto','Componente impositivo','18247'),field('sipa','Aporte jubilatorio','22079'),field('salud','Obra social por persona','25695'),field('adherentes','Familiares adherentes','0')],
  'saldo-iibb':[field('saldo','Saldo a favor inicial','300000'),field('facturacion','Facturación mensual gravada','3000000'),field('alicuota','Alícuota IIBB','3','%'),field('retenciones','Retenciones mensuales','150000'),field('meses','Meses proyectados','12'),field('inflacion','Inflación mensual estimada','2','%')],
  'salario-gremio':[field('anterior','Básico anterior','1000000'),field('actual','Básico actual','1300000'),field('ipc','IPC acumulado del período','33.6','%'),field('meses','Meses del período','12')],
};
---
<Layout title={tool.title} description={tool.description} canonical={canonical} schema={schema} lang="es" ogType="article">
  <Header />
  <main class="ot-wrap" data-kind={tool.kind}>
    <header class="ot-hero"><p class="ot-eye">{tool.eyebrow}</p><h1>{tool.h1}</h1><p>{tool.intro}</p><div class="ot-badges"><span>✓ Gratis</span><span>✓ Sin registro</span><span>✓ Resultado inmediato</span></div></header>
    <section class="ot-card" aria-labelledby="calc-title"><div><p class="ot-step">01 · Tus datos</p><h2 id="calc-title">Completá el escenario</h2></div>
      {tool.kind === 'alta' && <div class="ot-checks">
        {[['venta','Ya hice mi primera venta'],['habitual','La actividad continuará'],['local','Necesito habilitar un local'],['digital','Cobro por billetera, banco o marketplace'],['factura','Un cliente me pide factura'],['empleado','También trabajo en relación de dependencia'],['exterior','Cobro servicios del exterior']].map(([n,l])=><label><input type="checkbox" name={n}/><span>{l}</span></label>)}
      </div>}
      {tool.kind === 'convenio' && <div class="ot-checks">
        {[['otras','Vendo o presto servicios a otras provincias'],['gastos','Tengo gastos o proveedores fuera de mi provincia'],['deposito','Tengo local, depósito o personal en otra jurisdicción'],['entregas','Realizo entregas o trabajo presencial fuera de mi provincia'],['retenciones','Sufro retenciones de otras provincias'],['marketplace','Vendo mediante marketplace o plataforma'],['doble','Pago IIBB local y además acumulo retenciones externas']].map(([n,l])=><label><input type="checkbox" name={n}/><span>{l}</span></label>)}
      </div>}
      {tool.kind === 'cuota' && <label class="ot-select">Condición<select name="condicion"><option value="general">Independiente — cuota completa</option><option value="empleado">Empleado en relación de dependencia</option><option value="jubilado">Jubilado</option><option value="profesional">Aporta a caja profesional</option></select></label>}
      {fields[tool.kind] && <div class="ot-grid">{fields[tool.kind].map(f=><label>{f.label}<div class="ot-input"><span>{f.extra === '%' ? '%' : '$'}</span><input name={f.name} type="number" min="0" step="any" value={f.value}/></div></label>)}</div>}
      <button class="ot-button" type="button">Calcular resultado</button>
    </section>
    <section class="ot-result" aria-live="polite"><p class="ot-step">02 · Resultado</p><h2 data-result-title>Completá los datos para comparar</h2><div class="ot-number" data-result-main>—</div><p data-result-copy>La explicación aparecerá acá.</p><div class="ot-breakdown" data-result-rows></div></section>
    <section class="ot-content"><h2>Cómo leer esta estimación</h2><p>El resultado transforma una situación compleja en variables visibles. Revisá especialmente los supuestos, la vigencia de los valores y los conceptos que el cálculo no incluye. Para presentar declaraciones, liquidaciones judiciales o cambios registrales, confirmá el criterio con el organismo o profesional correspondiente.</p></section>
    <nav class="ot-related" aria-label="Herramientas relacionadas"><p class="ot-step">Herramientas relacionadas</p><h2>Seguí la cuenta desde otro ángulo</h2><div>{opportunityTools.filter(item=>item.slug!==tool.slug).map(item=><a href={`/${item.slug}`}>{item.title}<span>→</span></a>)}</div></nav>
    <section class="ot-faq"><p class="ot-step">Preguntas frecuentes</p><h2>Lo importante antes de decidir</h2>{tool.faq.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>
    <section class="ot-sources"><h2>Fuentes para verificar</h2><ul>{tool.sources.map(s=><li><a href={s.href} rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul><p>Última revisión: 19 de agosto de 2026. Contenido educativo; no constituye asesoramiento legal, contable ni fiscal.</p></section>
  </main>
  <Footer />
</Layout>
<script is:inline>
(()=>{const root=document.querySelector('.ot-wrap');if(!root)return;const kind=root.dataset.kind;const $=n=>root.querySelector(`[name="${n}"]`);const num=n=>Math.max(0,Number($(n)?.value)||0);const money=n=>new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS',maximumFractionDigits:0}).format(n);const pct=n=>`${n.toLocaleString('es-AR',{maximumFractionDigits:1})}%`;const title=root.querySelector('[data-result-title]');const main=root.querySelector('[data-result-main]');const copy=root.querySelector('[data-result-copy]');const rows=root.querySelector('[data-result-rows]');function out(t,m,c,r=[]){title.textContent=t;main.textContent=m;copy.textContent=c;rows.innerHTML=r.map(x=>`<div><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join('')}
function compute(){if(kind==='judicial'){const c=num('capital'),d=num('dias'),inf=num('inflacion')/100,t=num('tasa')/100;const judicial=c*Math.pow(1+t,d/365),ipc=c*(1+inf),low=ipc*Math.pow(.97,d/365),high=ipc*Math.pow(1.03,d/365);out('Comparación de criterios',money(judicial),`La tasa judicial lleva el capital a ${money(judicial)}. No sustituye el método ordenado en el expediente.`,[['Sólo IPC',money(ipc)],['Banda IPC −3%',money(low)],['Banda IPC +3%',money(high)],['Interés generado',money(judicial-c)]])}
else if(kind==='ecommerce'){const p=num('precio'),fixed=num('producto')+num('envio')+num('cuotaVenta'),rates=(num('comision')+num('cobro')+num('publicidad')+num('iibb'))/100,cost=fixed+p*rates,profit=p-cost,margin=p?profit/p*100:0;out(profit>=0?'La venta deja margen':'La venta pierde dinero',money(profit),`Tu margen neto estimado es ${pct(margin)} sobre el precio publicado.`,[['Costos totales',money(cost)],['Comisiones e impuestos',money(p*rates)],['Precio de equilibrio',money(fixed/(1-rates||1))],['Margen neto',pct(margin)]])}
else if(kind==='unitario'){const lim=num('limite'),ps=[num('p1'),num('p2'),num('p3')],qs=[num('q1'),num('q2'),num('q3')],max=Math.max(...ps),total=ps.reduce((s,p,i)=>s+p*qs[i],0),ok=max<=lim;out(ok?'Sin exceso unitario':'Riesgo de exclusión',money(max),ok?'Ningún precio unitario supera el parámetro cargado. El total de factura puede ser mayor.':'Al menos un bien supera el precio unitario máximo cargado.',[['Total de factura',money(total)],['Límite vigente',money(lim)],['Margen unitario',money(lim-max)],['Estado',ok?'Dentro del límite':'Superado']])}
else if(kind==='cuota'){const cond=$('condicion').value,imp=num('impuesto'),sipa=num('sipa'),salud=num('salud'),adh=num('adherentes');let total=imp+sipa+salud*(1+adh),detalle='Cuota completa';if(cond==='empleado'){total=imp;detalle='Sólo componente impositivo estimado'}if(cond==='jubilado'){total=imp+salud*(1+adh);detalle='Sin SIPA estimado'}if(cond==='profesional'){total=imp+salud*(1+adh);detalle='Caja profesional: sin SIPA estimado'}out(detalle,money(total),'Compará este desglose con la credencial emitida por ARCA. La condición debe estar correctamente registrada.',[['Impuesto',money(imp)],['SIPA incluido',cond==='general'?money(sipa):money(0)],['Obra social incluida',(cond==='empleado')?money(0):money(salud*(1+adh))],['Ahorro vs. completa',money(imp+sipa+salud*(1+adh)-total)]])}
else if(kind==='saldo-iibb'){let saldo=num('saldo'),real=saldo;const tax=num('facturacion')*num('alicuota')/100,ret=num('retenciones'),months=Math.max(1,num('meses')),infl=num('inflacion')/100;for(let i=0;i<months;i++){saldo=Math.max(0,saldo+ret-tax);real=saldo/Math.pow(1+infl,i+1)}const erosion=saldo-real;out(saldo>tax*3?'Saldo crónico para revisar':'Saldo manejable',money(saldo),`Al final del período equivaldría a ${money(real)} en pesos de hoy.`,[['Impuesto mensual',money(tax)],['Retenciones mensuales',money(ret)],['Meses de impuesto inmovilizados',tax?(saldo/tax).toFixed(1):'—'],['Erosión real estimada',money(erosion)]])}
else if(kind==='salario-gremio'){const a=num('anterior'),b=num('actual'),ipc=num('ipc')/100,needed=a*(1+ipc),real=needed?b/needed-1:0,diff=b-needed;out(real>=0?'La paritaria le ganó al IPC':'La paritaria quedó debajo del IPC',pct(real*100),diff>=0?`El básico quedó ${money(diff)} por encima del necesario para empatar.`:`Faltan ${money(-diff)} por mes para recuperar el poder de compra.`,[['Aumento nominal',pct(a?((b/a)-1)*100:0)],['Sueldo para empatar',money(needed)],['Diferencia mensual',money(diff)],['Diferencia anual',money(diff*12)]])}
else {const checks=[...root.querySelectorAll('input[type=checkbox]')],score=checks.filter(x=>x.checked).length;if(kind==='alta'){const critical=['venta','habitual','local','factura'].filter(n=>$(n)?.checked).length;out(critical>=2?'Conviene ordenar el alta ahora':critical===1?'Prepará el alta y definí la fecha':'Todavía estás en etapa preparatoria',`${critical} señales principales`,critical>=2?'Hay actividad o requisitos operativos que justifican revisar el alta y la facturación desde ahora.':'La decisión depende de cuándo empiece la actividad habitual y de los trámites previos.',[['Señales totales',String(score)],['Empleado en relación de dependencia',$('empleado').checked?'Sí':'No'],['Operación internacional',$('exterior').checked?'Sí':'No'],['Próximo paso',critical>=2?'Revisar alta en ARCA':'Preparar documentación']])}else{out(score>=5?'Alta probabilidad de revisión interjurisdiccional':score>=2?'Hay señales para analizar':'Pocas señales interjurisdiccionales',`${score} de 7 señales`,score>=2?'Conciliá retenciones por provincia y verificá sustento territorial antes de modificar inscripciones.':'Con los datos marcados, el régimen local parece más plausible, sujeto a la actividad real.',[['Retenciones externas',$('retenciones').checked?'Sí':'No'],['Presencia física externa',$('deposito').checked||$('entregas').checked?'Sí':'No'],['Marketplace',$('marketplace').checked?'Sí':'No'],['Próximo paso',score>=2?'Mapa por jurisdicción':'Control periódico']])}}
}root.querySelector('.ot-button').addEventListener('click',compute);root.addEventListener('change',compute);compute()})();
</script>
<style>
.ot-wrap{max-width:1040px;margin:auto;padding:46px 20px 80px;color:#13231d}.ot-hero{max-width:850px;margin-bottom:28px}.ot-eye,.ot-step{font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#08765a}.ot-hero h1{font-size:clamp(2.2rem,6vw,4.8rem);line-height:.98;letter-spacing:-.055em;margin:.35rem 0 1rem}.ot-hero>p:not(.ot-eye){font-size:1.15rem;line-height:1.65;max-width:760px;color:#50605a}.ot-badges{display:flex;gap:10px;flex-wrap:wrap}.ot-badges span{background:#e9f7f1;border-radius:999px;padding:8px 12px;font-weight:700;font-size:.85rem}.ot-card,.ot-result,.ot-content,.ot-faq,.ot-sources{border:1px solid #dce6e1;border-radius:24px;padding:clamp(22px,4vw,38px);margin-top:20px;background:#fff;box-shadow:0 16px 50px rgba(18,52,41,.05)}.ot-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:24px 0}.ot-grid label,.ot-select{font-weight:700;font-size:.9rem}.ot-input{display:flex;border:1px solid #bdcbc5;border-radius:12px;margin-top:7px;overflow:hidden}.ot-input span{padding:12px;background:#f2f6f4;color:#64726d}.ot-input input,.ot-select select{width:100%;border:0;padding:12px;font:inherit;background:#fff}.ot-select{display:block;margin:24px 0}.ot-select select{border:1px solid #bdcbc5;border-radius:12px;margin-top:7px}.ot-checks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:22px 0}.ot-checks label{display:flex;gap:10px;align-items:center;background:#f5f8f6;padding:14px;border-radius:12px;font-weight:650}.ot-button{border:0;background:#08765a;color:white;padding:14px 22px;border-radius:12px;font-weight:800;font-size:1rem;cursor:pointer}.ot-result{background:#102d24;color:#fff}.ot-result .ot-step{color:#7ee0bd}.ot-result h2{font-size:1.35rem}.ot-number{font-size:clamp(2.4rem,7vw,5rem);font-weight:850;letter-spacing:-.055em;margin:12px 0}.ot-result>p:not(.ot-step){color:#c8d9d2;max-width:760px}.ot-breakdown{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:#385148;border-radius:14px;overflow:hidden;margin-top:24px}.ot-breakdown div{background:#17382e;padding:15px;display:flex;justify-content:space-between;gap:12px}.ot-content p,.ot-faq p,.ot-sources p{line-height:1.7;color:#52615c}.ot-faq details{border-top:1px solid #dce6e1;padding:18px 0}.ot-faq summary{font-weight:800;cursor:pointer}.ot-sources ul{padding-left:20px}.ot-sources a{color:#08765a;font-weight:700}@media(max-width:650px){.ot-grid,.ot-checks,.ot-breakdown{grid-template-columns:1fr}.ot-hero h1{font-size:2.7rem}}
.ot-related{border:1px solid #dce6e1;border-radius:24px;padding:clamp(22px,4vw,38px);margin-top:20px;background:#fff;box-shadow:0 16px 50px rgba(18,52,41,.05)}.ot-related>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ot-related a{display:flex;justify-content:space-between;gap:14px;padding:15px;border-radius:12px;background:#f3f7f5;color:#15372d;text-decoration:none;font-weight:750}.ot-related a:hover{background:#e5f3ed}.ot-related span{color:#08765a}@media(max-width:650px){.ot-related>div{grid-template-columns:1fr}}
</style>
