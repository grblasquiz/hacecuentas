---
// Renderer compartido del catálogo de calculadoras por país (/<x>/calculadoras).
// Cada página de país globea sus calcs (la ruta del glob debe ser literal por
// locale) y pasa acá la lista ya con su URL resuelta + el config del país.
// Objetivo SEO: superficie de crawl dedicada + enlace de autoridad al cluster.
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { isDistributablePublicPath } from '../lib/content-policy';

interface CalcItem { h1: string; slug: string; icon?: string; category: string; url: string; }
interface Props {
  calcs: CalcItem[];
  prefix: string;       // 'co'
  audience: string;     // 'CO'
  country: string;      // 'Colombia'
  lang: string;         // 'es-CO'
  topics: string;       // 'salario mínimo, prestaciones, retención, UVT…'
  dataLink?: string;    // '/co/datos-...'
  dataLabel?: string;   // '📊 …'
}
const { calcs: suppliedCalcs, prefix, audience, country, lang, topics, dataLink, dataLabel } = Astro.props as Props;
const calcs = suppliedCalcs.filter((calc) => isDistributablePublicPath(calc.url));

const CAT: Record<string, { label: string; color: string; icon: string }> = {
  finanzas:         { label: 'Finanzas',       color: '#2563eb', icon: '💰' },
  'finanzas-personales': { label: 'Finanzas personales', color: '#2563eb', icon: '💰' },
  impuestos:        { label: 'Impuestos',      color: '#7c3aed', icon: '🧾' },
  trabajo:          { label: 'Trabajo',        color: '#0f766e', icon: '💼' },
  hogar:            { label: 'Hogar',          color: '#d97706', icon: '🏠' },
  vivienda:         { label: 'Vivienda',       color: '#b45309', icon: '🏡' },
  auto:             { label: 'Auto',           color: '#6366f1', icon: '🚗' },
  estudio:          { label: 'Estudio',        color: '#8b5cf6', icon: '🎓' },
  tramites:         { label: 'Trámites',       color: '#475569', icon: '📄' },
  vida:             { label: 'Vida cotidiana', color: '#d97706', icon: '🏠' },
  familia:          { label: 'Familia',        color: '#db2777', icon: '👨‍👩‍👧' },
  salud:            { label: 'Salud',          color: '#16a34a', icon: '❤️' },
  automotor:        { label: 'Automotor',      color: '#6366f1', icon: '🚗' },
  educacion:        { label: 'Educación',      color: '#8b5cf6', icon: '🎓' },
  negocios:         { label: 'Negocios',       color: '#0891b2', icon: '📊' },
  marketing:        { label: 'Marketing',      color: '#e11d48', icon: '📈' },
  deportes:         { label: 'Deportes',       color: '#65a30d', icon: '🏃' },
  viajes:           { label: 'Viajes',         color: '#0891b2', icon: '✈️' },
  cocina:           { label: 'Cocina',         color: '#ea580c', icon: '🍳' },
  mascotas:         { label: 'Mascotas',       color: '#db2777', icon: '🐕' },
  matematica:       { label: 'Matemática',     color: '#0d9488', icon: '🧮' },
  tecnologia:       { label: 'Tecnología',     color: '#06b6d4', icon: '💻' },
  'medio-ambiente': { label: 'Medio Ambiente', color: '#22c55e', icon: '🌱' },
  electronica:      { label: 'Electrónica',    color: '#f59e0b', icon: '⚡' },
  ciencia:          { label: 'Ciencia',        color: '#6366f1', icon: '🔬' },
  jardineria:       { label: 'Jardinería',     color: '#15803d', icon: '🌿' },
  construccion:     { label: 'Construcción',   color: '#b45309', icon: '🧱' },
};
const ORDER = ['trabajo','finanzas','finanzas-personales','impuestos','hogar','vivienda','auto','automotor','vida','familia','salud','estudio','educacion','tramites','negocios','marketing','deportes','viajes','cocina','mascotas','matematica','tecnologia','medio-ambiente','electronica','ciencia','jardineria','construccion'];

const byCat: Record<string, CalcItem[]> = {};
calcs.forEach((c) => { if (c && c.slug && c.h1) (byCat[c.category] ||= []).push(c); });
const categories = [...ORDER, ...Object.keys(byCat).filter((cat) => !ORDER.includes(cat))];
const groups = categories
  .filter((cat) => byCat[cat]?.length)
  .map((cat) => ({
    cat,
    label: CAT[cat]?.label || cat,
    icon: CAT[cat]?.icon || '🧮',
    color: CAT[cat]?.color || '#2563eb',
    items: byCat[cat].slice().sort((a, b) => (a.h1 || '').localeCompare(b.h1 || '', 'es')),
  }));

const total = calcs.length;
const siteUrl = 'https://hacecuentas.com';
const title = `Todas las calculadoras de ${country} — ${total} gratis | Hacé Cuentas`;
const description = `Catálogo completo de ${total} calculadoras online gratis para ${country}: ${topics}. Filtrá y entrá a cualquiera.`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage', name: `Calculadoras de ${country}`, description,
      url: `${siteUrl}/${prefix}/calculadoras`, inLanguage: lang,
      mainEntity: {
        '@type': 'ItemList', numberOfItems: total,
        itemListElement: groups.flatMap((g) => g.items).slice(0, 50).map((c, i) => ({
          '@type': 'ListItem', position: i + 1, name: c.h1, url: `${siteUrl}${c.url}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: country, item: `${siteUrl}/${prefix}` },
        { '@type': 'ListItem', position: 2, name: 'Todas las calculadoras', item: `${siteUrl}/${prefix}/calculadoras` },
      ],
    },
  ],
};
---

<Layout title={title} description={description} canonical={`/${prefix}/calculadoras`} audience={audience} schema={schema}>
  <Header slot="header" />

  <nav class="breadcrumbs" aria-label="Ruta de navegación">
    <a href={`/${prefix}`}>{country}</a>
    <span class="sep" aria-hidden="true">/</span>
    <span class="current">Todas las calculadoras</span>
  </nav>

  <header class="page-header">
    <h1>Calculadoras de {country}</h1>
    <p>El catálogo completo: <strong>{total}</strong> calculadoras gratis adaptadas a {country} ({topics}), ordenadas por categoría. Filtrá por nombre o navegá la lista.</p>
    {dataLink && dataLabel && (
      <p style="margin-top:0.6rem;font-size:0.9rem"><a href={dataLink} style="color:var(--accent);font-weight:600">{dataLabel}</a> — datos de referencia, uso libre con atribución.</p>
    )}
  </header>

  <div class="search-wrap">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <input id="filter-input" type="search" placeholder="Filtrar calculadoras por nombre…" autocomplete="off" aria-label="Filtrar calculadoras por nombre" />
    <button id="filter-clear" type="button" aria-label="Limpiar filtro" hidden>✕</button>
  </div>
  <div class="results-count" id="results-count" aria-live="polite"></div>

  <nav class="cat-jump" aria-label="Saltar a categoría">
    {groups.map((g) => (
      <a class="cat-jump-chip" href={`#cat-${g.cat}`} style={`--cat: ${g.color}`}>
        <span aria-hidden="true">{g.icon}</span> {g.label} <span class="cat-jump-n">{g.items.length}</span>
      </a>
    ))}
  </nav>

  <div id="cat-list">
    {groups.map((g) => (
      <section class="cat-block" id={`cat-${g.cat}`} style={`--cat: ${g.color}`}>
        <h2 class="cat-title"><span aria-hidden="true">{g.icon}</span> {g.label} <span class="cat-title-n">{g.items.length}</span></h2>
        <ul class="calc-list">
          {g.items.map((c) => (
            <li class="calc-item" data-name={`${c.h1} ${c.slug}`.toLowerCase()}>
              <a href={c.url}>
                <span class="calc-item-icon" aria-hidden="true">{c.icon || '🧮'}</span>
                <span class="calc-item-name">{c.h1}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="empty" id="empty" hidden>
    <div class="empty-icon">🔍</div>
    <h3>Sin resultados</h3>
    <p>No encontramos calculadoras que coincidan con tu filtro.</p>
  </div>

  <section class="catalog-guide" aria-labelledby="catalog-guide-title">
    <h2 id="catalog-guide-title">{lang.startsWith('pt') ? 'Como usar este catálogo' : 'Cómo usar este catálogo'}</h2>
    {lang.startsWith('pt') ? (
      <>
        <p>Escolha primeiro o tema que melhor descreve a sua dúvida e abra a ferramenta correspondente. Antes de usar o resultado, confira a moeda, o período, os dados introduzidos e a data de atualização. As contas fiscais, laborais e financeiras podem variar segundo a legislação e a situação pessoal.</p>
        <p>As calculadoras explicam os pressupostos aplicados e indicam as fontes disponíveis. O resultado é uma estimativa orientativa e não substitui aconselhamento profissional. Se não encontrar a ferramenta desejada, consulte também o <a href="/calculadoras">catálogo geral</a>.</p>
        <p>Para comparar dois cenários, altere apenas uma variável de cada vez e anote o valor obtido. Assim poderá perceber o impacto real do prazo, da taxa ou do montante. Volte a fazer a conta quando houver uma atualização oficial ou quando mudar algum dado da sua situação.</p>
      </>
    ) : (
      <>
        <p>Primero elegí el tema que mejor describa tu consulta y abrí la herramienta correspondiente. Antes de usar el resultado, revisá la moneda, el período, los datos ingresados y la fecha de actualización. Las cuentas fiscales, laborales y financieras pueden variar según la normativa y la situación personal.</p>
        <p>Cada calculadora explica los supuestos aplicados y muestra las fuentes disponibles. El resultado es una estimación orientativa y no reemplaza asesoramiento profesional. Si no encontrás la herramienta que buscás, consultá también el <a href="/calculadoras">catálogo general</a>.</p>
        <p>Para comparar dos escenarios, cambiá una sola variable por vez y anotá el resultado. Así vas a poder reconocer el efecto real del plazo, la tasa o el monto. Repetí la cuenta cuando exista una actualización oficial o cambie algún dato de tu situación.</p>
      </>
    )}
  </section>

  <Footer slot="footer" />
</Layout>

<script is:inline>
  (function () {
    const input = document.getElementById('filter-input');
    const clear = document.getElementById('filter-clear');
    const count = document.getElementById('results-count');
    const empty = document.getElementById('empty');
    const items = Array.from(document.querySelectorAll('.calc-item'));
    const blocks = Array.from(document.querySelectorAll('.cat-block'));
    if (!input) return;
    function apply() {
      const q = input.value.trim().toLowerCase();
      clear.hidden = !q;
      let shown = 0;
      items.forEach((li) => {
        const ok = !q || li.getAttribute('data-name').includes(q);
        li.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      blocks.forEach((b) => {
        const any = b.querySelector('.calc-item:not([style*="display: none"])');
        b.style.display = any ? '' : 'none';
      });
      empty.hidden = shown > 0;
      count.textContent = q ? `${shown} resultado${shown === 1 ? '' : 's'}` : '';
    }
    input.addEventListener('input', apply);
    clear.addEventListener('click', () => { input.value = ''; apply(); input.focus(); });
  })();
</script>

<style>
  .breadcrumbs { display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--text-subtle); margin-bottom: 1.25rem; }
  .catalog-guide { margin: 2.5rem 0 0; padding: 1.5rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface, #fff); }
  .catalog-guide h2 { margin: 0 0 0.75rem; font-size: 1.35rem; }
  .catalog-guide p { max-width: 76ch; margin: 0.65rem 0 0; color: var(--text-muted); line-height: 1.65; }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }
  .breadcrumbs .current { color: var(--text); font-weight: 500; }
  .page-header { margin-bottom: 1.5rem; }
  .page-header h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); margin-bottom: 0.5rem; }
  .page-header p { color: var(--text-muted); margin: 0; max-width: 640px; }
  .page-header strong { color: var(--text); }
  .search-wrap { display: flex; align-items: center; gap: 0.625rem; padding: 0.875rem 1.125rem; background: var(--bg); border: 1.5px solid var(--border); border-radius: var(--radius); margin-bottom: 1rem; color: var(--text-subtle); position: sticky; top: 0.5rem; z-index: 5; }
  .search-wrap:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .search-wrap input { flex: 1; border: none; outline: none; background: transparent; font-size: 1rem; color: var(--text); }
  #filter-clear { background: transparent; border: none; color: var(--text-subtle); cursor: pointer; font-size: 1rem; padding: 0.25rem 0.5rem; }
  .results-count { font-size: 0.8125rem; color: var(--text-subtle); min-height: 1.25rem; margin-bottom: 1rem; }
  .cat-jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
  .cat-jump-chip { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.75rem; font-size: 0.8125rem; font-weight: 500; border: 1px solid var(--border); border-radius: 999px; text-decoration: none; color: var(--text-muted); border-left: 3px solid var(--cat); }
  .cat-jump-chip:hover { color: var(--text); background: var(--bg-muted); }
  .cat-jump-n { color: var(--text-subtle); font-size: 0.75rem; }
  .cat-block { margin-bottom: 2.5rem; scroll-margin-top: 4rem; }
  .cat-title { display: flex; align-items: center; gap: 0.5rem; font-size: 1.25rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--cat); margin-bottom: 1rem; }
  .cat-title-n { color: var(--text-subtle); font-size: 0.875rem; font-weight: 400; }
  .calc-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.25rem; }
  .calc-item a { display: flex; align-items: center; gap: 0.625rem; padding: 0.625rem 0.75rem; border-radius: var(--radius-sm); text-decoration: none; color: var(--text); }
  .calc-item a:hover { background: var(--bg-muted); }
  .calc-item-icon { flex-shrink: 0; }
  .calc-item-name { font-size: 0.9375rem; line-height: 1.3; }
  .empty { text-align: center; padding: 3rem 1rem; color: var(--text-muted); }
  .empty-icon { font-size: 2rem; margin-bottom: 0.5rem; }
</style>
