---
/**
 * PreferredSourceCta — botón "Agregar Hacé Cuentas como fuente preferida en Google".
 *
 * Google Preferred Sources se volvió señal global en 2026: cuando un usuario nos
 * marca como fuente preferida, nuestro contenido aparece más seguido en Top
 * Stories y en AI Overviews / AI Mode con un badge "preferida". Google reporta
 * que un lector es ~2× más propenso a clickear una fuente que él mismo eligió.
 *
 * El deeplink oficial abre el selector de fuentes con el dominio precargado, así
 * que el usuario nos agrega con un toque. La fuente preferida es SIEMPRE el
 * dominio (hacecuentas.com) — no importa en qué página esté el botón, por eso el
 * mismo `q=` sirve en blog, páginas-dato, etc.
 *
 * Solo se muestra en superficies news-ish (blog, datos vivos): en un calc suelto
 * no tiene sentido y sería ruido. data-nosnippet: es chrome, no contenido.
 *
 * Docs: https://developers.google.com/search/docs/appearance/preferred-sources
 */
interface Props {
  /** Idioma del copy. Default 'es'. */
  lang?: 'es' | 'pt' | 'en';
}
const { lang = 'es' } = Astro.props as Props;

// Deeplink oficial: abre el tool de fuentes preferidas con hacecuentas.com cargado.
const HREF = 'https://google.com/preferences/source?q=hacecuentas.com';

const COPY = {
  es: {
    title: '¿Te sirve Hacé Cuentas?',
    lead: 'Marcanos como <strong>fuente preferida en Google</strong> y vas a vernos más seguido cuando busques dólar, sueldos, impuestos y cálculos del día.',
    btn: 'Agregar como fuente preferida',
    note: 'Se abre Google · Un toque · Lo cambiás cuando quieras',
  },
  pt: {
    title: 'O Hacé Cuentas te ajuda?',
    lead: 'Marque-nos como <strong>fonte preferida no Google</strong> e nos verá com mais frequência ao buscar câmbio, salários e cálculos do dia.',
    btn: 'Adicionar como fonte preferida',
    note: 'Abre o Google · Um toque · Você muda quando quiser',
  },
  en: {
    title: 'Find Hacé Cuentas useful?',
    lead: 'Add us as a <strong>preferred source on Google</strong> to see us more often when you search.',
    btn: 'Add as a preferred source',
    note: 'Opens Google · One tap · Change anytime',
  },
} as const;
const t = COPY[lang] || COPY.es;
---

<section class="psc" data-nosnippet aria-labelledby="psc-h">
  <div class="psc-txt">
    <p class="psc-h" id="psc-h"><strong>{t.title}</strong></p>
    <p class="psc-lead" set:html={t.lead} />
  </div>
  <a class="psc-btn" href={HREF} target="_blank" rel="noopener nofollow" data-psc-btn>
    <svg class="psc-g" viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
      <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
      <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
      <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
      <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
    </svg>
    <span>{t.btn}</span>
  </a>
  <p class="psc-note">{t.note}</p>
</section>

<style>
  .psc {
    margin: 1.5rem auto 0;
    max-width: 780px;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 14px;
    padding: 16px 18px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent, #2563eb) 6%, var(--surface, #fff)), var(--surface, #fff));
  }
  .psc-h { margin: 0 0 2px; font-size: 1.02rem; line-height: 1.35; }
  .psc-lead { margin: 0 0 12px; font-size: .9rem; line-height: 1.5; color: var(--text-2, #475569); }
  .psc-lead :global(strong) { color: var(--text, #0f172a); }
  .psc-btn {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--surface, #fff); color: var(--text, #1f2328);
    font-weight: 700; font-size: .95rem; text-decoration: none;
    border: 1px solid var(--border, #cbd5e1); border-radius: 10px;
    padding: 10px 16px; cursor: pointer; transition: box-shadow .15s, border-color .15s;
  }
  .psc-btn:hover { border-color: var(--accent, #2563eb); box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,.08)); }
  .psc-btn:focus-visible { outline: 2px solid var(--accent, #2563eb); outline-offset: 2px; }
  .psc-g { flex-shrink: 0; }
  .psc-note { margin: 8px 0 0; font-size: .78rem; color: var(--text-muted, #64748b); }
</style>

<script is:inline>
  (window.requestIdleCallback || function (fn) { return setTimeout(fn, 1); })(function () {
    document.querySelectorAll('[data-psc-btn]').forEach(function (btn) {
      if (btn.dataset.pscReady === '1') return;
      btn.dataset.pscReady = '1';
      // hcTrack = shim global whitelisteado (Layout). Mide cuántos clickean el
      // botón de fuente preferida; la conversión real (que la marquen) ocurre en
      // Google y no la vemos, pero el click es el proxy accionable.
      btn.addEventListener('click', function () {
        if (typeof window.hcTrack === 'function') window.hcTrack('preferred_source_click', {});
      });
    });
  });
</script>
