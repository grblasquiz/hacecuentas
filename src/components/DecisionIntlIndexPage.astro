---
/**
 * DecisionIntlIndexPage — índice de salas de decisión de un país
 * (/co|mx|cl|pe/decidir). Espejo compacto de /decidir/index.astro: con ~10
 * salas por país no hay hubs — una sola grilla + cross-links a los índices
 * hermanos (AR raíz y demás países), que además refuerzan el cluster hreflang.
 */
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { DecisionCountry } from '../lib/decisions/locales';
import { DECISION_COUNTRY_LIST } from '../lib/decisions/locales';
import { roomsOfCountry } from '../lib/decisions/locales-registry';
import { buildHreflangCluster } from '../lib/hreflang';

interface Props {
  country: DecisionCountry;
}
const { country } = Astro.props;

const site = 'https://hacecuentas.com';
const rooms = roomsOfCountry(country.cc);
const otherCountries = DECISION_COUNTRY_LIST.filter((c) => c.cc !== country.cc);

// Cluster hreflang de los índices: AR raíz + los 4 países.
const hreflang = buildHreflangCluster({
  es: 'decidir',
  co: 'decidir',
  mx: 'decidir',
  cl: 'decidir',
  pe: 'decidir',
});

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `Salas de decisión — ${country.name}`,
      description: country.indexDescription,
      url: `${site}/${country.cc}/decidir`,
      inLanguage: country.locale,
      isPartOf: { '@id': `${site}/#website` },
    },
    {
      '@type': 'ItemList',
      itemListElement: rooms.map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${site}/${country.cc}/decidir/${r.slug}`,
        name: r.h1,
      })),
    },
  ],
};
---

<Layout
  title={country.indexTitle}
  description={country.indexDescription}
  schema={schema}
  audience={country.audience}
  hreflang={hreflang}
>
  <Header slot="header" />

  <main class="dh">
    <header class="dh-head">
      <span class="dh-eyebrow">🧭 Salas de decisión · {country.flag} {country.name}</span>
      <h1>Decisiones de dinero en {country.name}, con números reales</h1>
      <p class="dh-lede">{country.indexLede}</p>
    </header>

    <section class="dh-group">
      <ul class="dh-grid">
        {rooms.map((r) => (
          <li>
            <a href={`/${country.cc}/decidir/${r.slug}`} class="dh-card">
              <span class="dh-icon" aria-hidden="true">{r.icon}</span>
              <span class="dh-card-title">{r.h1}</span>
              <span class="dh-card-desc">{r.description}</span>
              <span class="dh-card-cta">Abrir la sala →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="dh-group dh-countries">
      <h2>Salas de decisión en otros países</h2>
      <nav class="dh-country-nav" aria-label="Salas de decisión por país">
        <a href="/decidir">🇦🇷 Argentina</a>
        {otherCountries.map((c) => (
          <a href={`/${c.cc}/decidir`}>{c.flag} {c.name}</a>
        ))}
      </nav>
    </section>

    <p class="dh-foot">
      ¿Te falta una decisión? <a href="/sugerir">Sugiere una sala</a> y la sumamos.
    </p>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .dh {
    max-width: 880px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .dh-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dh-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dh-head h1 {
    margin: 0;
    font-size: clamp(1.625rem, 5vw, 2.375rem);
    line-height: 1.15;
    color: var(--text);
  }
  .dh-lede {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 60ch;
  }
  .dh-group {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .dh-group h2 {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.25;
    color: var(--text);
  }
  .dh-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .dh-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 0.75rem);
    background: var(--bg);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.1s, box-shadow 0.15s;
  }
  .dh-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.08));
  }
  .dh-icon {
    font-size: 1.75rem;
  }
  .dh-card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
  }
  .dh-card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
  }
  .dh-card-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
  }
  .dh-country-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .dh-country-nav a {
    display: inline-block;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--accent-strong, #0369a1);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .dh-country-nav a:hover {
    border-color: var(--accent);
    background: var(--accent-soft, #e0f2fe);
  }
  .dh-foot {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .dh-foot a {
    color: var(--accent-strong, #0369a1);
  }
</style>
