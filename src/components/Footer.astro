---
/**
 * Footer.astro — footer unificado "v7" (mismo look que la home aprobada).
 *
 * Rediseño 2026-07-12: se adopta el diseño del footer de la home v7 (grid
 * compacto: marca + columnas cortas + fila social) en TODAS las páginas, para que
 * el footer sea idéntico en todo el sitio (decisión de Martin: "el mismo que la
 * home"). Es más minimalista que el footer SEO anterior (menos links internos).
 *
 * Se mantiene: i18n (es/en/pt), el disclaimer legal YMYL (Ley 26.831 — obligatorio
 * en un sitio de finanzas/salud), la barra inferior (copyright + legales + sitemap
 * + badge verde) y el botón de configuración de cookies (hcOpenCookieSettings).
 *
 * Theme-aware: usa las variables del sitio (--bg-soft/--border/--text*) en vez de
 * los colores fijos claros del mockup, así respeta el modo oscuro (el toggle de
 * tema sigue vivo en el Header).
 */
export interface Props { lang?: 'es' | 'en' | 'pt'; }
import HubDisclaimer from './hub/HubDisclaimer.astro';
import PriorityPages31To100 from './PriorityPages31To100.astro';
import { ALL_HUBS } from '../lib/hubs/registry';
const { lang = 'es' } = Astro.props;
const year = new Date().getFullYear();
const isEn = lang === 'en';
const isPt = lang === 'pt';
const localeSegment = Astro.url.pathname.split('/').filter(Boolean)[0] || '';
const neutralSpanishLocales = new Set(['mx', 'es', 'cl', 'co', 'pe', 'ec', 've', 'py', 'uy', 'do']);
const isNeutralSpanish = lang === 'es' && neutralSpanishLocales.has(localeSegment);
const localePrefix = isNeutralSpanish ? `/${localeSegment}` : '';
// Salas de decisión: sólo AR + los 4 locales con ruta /<cc>/decidir. El resto
// (es, ec, ve, py, uy, do) NO tiene la ruta → linkearla mandaba 430 links
// internos a un 404 duro (uno por página de esos locales).
const decisionRoomLocales = new Set(['mx', 'co', 'cl', 'pe']);
const hasDecisionRooms = decisionRoomLocales.has(localeSegment);
const P = lang === 'es' ? '' : `/${lang}`; // prefijo de locale para links internos
const currentHubSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '').replace(/\.html$/, '');
const currentHub = ALL_HUBS.find((hub) => hub.slug === currentHubSlug);

// Logos de marca oficiales (simple-icons, single-path, fill: currentColor).
const SOCIAL_ICONS: Record<string, string> = {
  x: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  instagram: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
  linkedin: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  facebook: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  youtube: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  tiktok: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`,
};

// i18n de las etiquetas de columnas + tagline + dots.
const T_BASE = {
  es: {
    tagline: 'Calculadoras online gratuitas y precisas, explicadas en español para todo el mundo.',
    dots: ['Sin registro', '100% gratuito', 'Datos privados'],
    start: 'Empezá por acá', countries: 'Países', explore: 'Explorar', community: 'Comunidad', legal: 'Legal', friends: 'Sitios amigos', follow: 'Seguinos', cookies: 'Configurar cookies',
    copy: `© ${year} Hacé Cuentas. Para todo el mundo hispanohablante`, terms: 'Términos', privacy: 'Privacidad', contact: 'Contacto',
    green: 'Hosting verde (Cloudflare — 100% energía renovable)',
  },
  en: {
    tagline: 'Free, accurate online calculators, explained clearly for everyone.',
    dots: ['No signup', '100% free', 'Private data'],
    start: 'Start here', countries: 'Countries', explore: 'Explore', community: 'Community', legal: 'Legal', friends: 'Friends', follow: 'Follow us', cookies: 'Cookie settings',
    copy: `© ${year} Hacé Cuentas. Free calculators for the world`, terms: 'Terms', privacy: 'Privacy', contact: 'Contact',
    green: 'Hosted on green servers (Cloudflare — 100% renewable energy)',
  },
  pt: {
    tagline: 'Calculadoras online gratuitas e precisas, explicadas de forma clara.',
    dots: ['Sem cadastro', '100% grátis', 'Dados privados'],
    start: 'Comece por aqui', countries: 'Países', explore: 'Explorar', community: 'Comunidade', legal: 'Legal', friends: 'Sites amigos', follow: 'Siga-nos', cookies: 'Configurar cookies',
    copy: `© ${year} Hacé Cuentas. Calculadoras grátis para o mundo`, terms: 'Termos', privacy: 'Privacidade', contact: 'Contato',
    green: 'Hospedagem verde (Cloudflare — 100% energia renovável)',
  },
}[lang];
const T = isNeutralSpanish ? {
  ...T_BASE,
  start: 'Empieza por aquí',
  follow: 'Síguenos',
} : T_BASE;

// Columna "Empezá por acá": pilares + superficies de flujo (ES). EN/PT usan su índice.
const startLinks = isEn ? [
  ['/en', 'All calculators'], ['/en/bmi-calculator', 'BMI'], ['/en/compound-interest-calculator', 'Compound interest'], ['/en/percentage-calculator', 'Percentages'], ['/guias', 'Guides'],
] : isPt ? [
  ['/pt', 'Todas as calculadoras'], ['/pt/calculadora-imc-tabela-oms-classificacao', 'IMC'], ['/pt/salario-liquido-clt-inss-irrf-2026', 'Salário líquido'], ['/pt/calculadora-juros-compostos-investimento-mensal', 'Juros compostos'], ['/guias', 'Guias'],
] : isNeutralSpanish ? [
  [localePrefix, 'Todas las calculadoras'], [`${localePrefix}/calculadoras`, 'Catálogo completo'],
  ['/guias', 'Guías prácticas'],
  ['/guias', 'Guías'],
] : [
  ['/sueldos-y-trabajo', 'Sueldos y trabajo'], ['/impuestos-argentina', 'Impuestos'], ['/finanzas-personales', 'Finanzas'], ['/negocios-e-independientes', 'Negocios'], ];
// Explorar
// Las 4 últimas (sólo AR root) rescatan páginas que estaban 100% huérfanas:
// /calculadora (head term "calculadora online"), /fin-de-semana y /calendarios.
// No se muestran en locales de país porque son
// superficies del root AR/ES.
const isArRoot = !isEn && !isPt && !isNeutralSpanish;
const exploreLinks = [
  ...(!isArRoot ? [[isEn ? '/en' : isPt ? '/pt' : `${localePrefix}/calculadoras`, isEn ? 'Calculators' : 'Calculadoras']] : []),
  ['/guias', isEn ? 'Guides' : isPt ? 'Guias' : 'Guías'],
  ['/blog', 'Blog'],
  ...(!isEn && !isPt ? [['/glosario', 'Glosario']] : []),
  ...(isArRoot ? [
    ['/calculadora', 'Calculadora online'],
    ['/fin-de-semana', 'Calculadoras de fin de semana'],
    ['/calendarios', 'Calendarios 2026'],
  ] : []),
];
// Comunidad
const communityLinks = [
  ['/enlazanos', isEn ? 'Link to us' : isPt ? 'Divulgue-nos' : isNeutralSpanish ? 'Enlázanos' : 'Enlazanos'],
  ['/simulador-jubilacion-anses', isEn ? 'Retirement simulator' : isPt ? 'Simulador de aposentadoria' : 'Simulador de jubilación'],
  ['/sugerir', isEn ? 'Suggest a calc' : isPt ? 'Sugerir uma calc' : 'Sugerir una calc'],
  // /desarrolladores y /wordpress estaban huérfanas (0 links entrantes) pese a
  // estar en el sitemap: son las superficies de embed/API, público dev.
  ['/desarrolladores', isEn ? 'For developers' : isPt ? 'Para desenvolvedores' : 'Para desarrolladores'],
  ['/wordpress', isEn ? 'WordPress plugin' : isPt ? 'Plugin WordPress' : 'Plugin de WordPress'],
];
// Legal (Contacto vive acá también)
const legalLinks = [
  ['/aviso-legal', isEn ? 'Legal notice' : isPt ? 'Aviso legal' : 'Aviso legal'],
  ['/terminos', T.terms], ['/privacidad', T.privacy], ['/cookies', 'Cookies'], ['/contacto', T.contact],
];
// Países
const countryLinks = [
  ['/', '🇦🇷 Argentina'], ['/mx', '🇲🇽 México'], ['/co', '🇨🇴 Colombia'], ['/cl', '🇨🇱 Chile'], ['/es', '🇪🇸 España'],
];
const socialLinks = [
  ['https://x.com/Hacecuentas', 'X (Twitter)', SOCIAL_ICONS.x],
  ['https://www.instagram.com/hacecuentas', 'Instagram', SOCIAL_ICONS.instagram],
  ['https://www.linkedin.com/company/122324467/', 'LinkedIn', SOCIAL_ICONS.linkedin],
  ['https://www.facebook.com/profile.php?id=61590473465354', 'Facebook', SOCIAL_ICONS.facebook],
  ['https://www.youtube.com/@HaceCuentas', 'YouTube', SOCIAL_ICONS.youtube],
  ['https://www.tiktok.com/@hace.cuentas', 'TikTok', SOCIAL_ICONS.tiktok],
];
---

{currentHub && <HubDisclaimer data={currentHub} />}
<PriorityPages31To100 />
<footer class="site-footer" data-lang={lang}>
  <div class="foot-wrap">
    <div class="footGrid" data-nosnippet>
      <div class="footCol footCol-brand">
        <div class="foot-brand">
          <img class="brand-mark" src="/logo-64.png" srcset="/logo-64.png 1x, /logo-128.png 2x" alt="Hacé Cuentas" width="34" height="34" decoding="async" loading="lazy" />
          <span>Hacé Cuentas</span>
        </div>
        <p class="foot-tagline">{T.tagline}</p>
        <p class="foot-dots">{T.dots.map((d, i) => (<>{i > 0 && ' · '}<span class="fd"><span class="dot" aria-hidden="true"></span>{d}</span></>))}</p>
      </div>

      <div class="footCol">
        <b>{T.start}</b>
        {startLinks.map(([href, label]) => <a href={href}>{label}</a>)}
      </div>

      <div class="footCol">
        <b>{T.countries}</b>
        {countryLinks.map(([href, label]) => <a href={href}>{label}</a>)}
      </div>

      <div class="footCol">
        <b>{T.explore}</b>
        {exploreLinks.map(([href, label]) => <a href={href}>{label}</a>)}
      </div>

      <div class="footCol">
        <b>{T.community}</b>
        {communityLinks.map(([href, label]) => <a href={href}>{label}</a>)}
      </div>

      <div class="footCol">
        <b>{T.legal}</b>
        {legalLinks.map(([href, label]) => <a href={href}>{label}</a>)}
        <button type="button" class="cookie-config-btn" id="footer-cookie-config">⚙️ {T.cookies}</button>
      </div>

      <div class="footCol">
        <b>{T.friends}</b>
        <a href="https://nomaviajes.com" target="_blank" rel="noopener" title="Vuelos baratos desde Argentina — Noma Viajes">✈️ Noma Viajes</a>
        <a href="https://genfy.net" target="_blank" rel="noopener">✨ Genfy.net</a>
        <b class="foot-follow-h">{T.follow}</b>
        <div class="footSocial" aria-label="Redes sociales de Hacé Cuentas">
          {socialLinks.map(([href, title, svg]) => (
            <a href={href} target="_blank" rel="noopener me" title={title} aria-label={title}><span class="social-ico" set:html={svg} /></a>
          ))}
        </div>
      </div>
    </div>

    <div class="foot-legal" data-nosnippet>
      {isEn ? (
        <p><strong>Disclaimer:</strong> Hacé Cuentas provides mathematical tools and educational content. <strong>We are not financial advisors, accountants, doctors, or lawyers.</strong> For important decisions, consult a licensed professional. Read the <a href="/aviso-legal">full disclaimer</a>.</p>
      ) : isPt ? (
        <p><strong>Aviso legal:</strong> Hacé Cuentas oferece ferramentas matemáticas e conteúdo educativo. <strong>Não somos consultores financeiros, contadores, médicos ou advogados.</strong> Para decisões importantes, consulte um profissional habilitado. Leia o <a href="/aviso-legal">aviso legal completo</a>.</p>
      ) : isNeutralSpanish ? (
        <p><strong>Aviso legal:</strong> Hacé Cuentas provee herramientas matemáticas y contenido educativo. Los resultados son orientativos y no reemplazan asesoramiento profesional cuando corresponda. Lee el <a href="/aviso-legal">aviso legal completo</a>.</p>
      ) : (
        <p><strong>Aviso legal:</strong> Hacé Cuentas provee herramientas matemáticas y contenido educativo. Los resultados son orientativos y no reemplazan asesoramiento profesional cuando corresponda. Leé el <a href="/aviso-legal">aviso legal completo</a>.</p>
      )}
    </div>

    <div class="foot-bottom" data-nosnippet>
      <p>{T.copy} <span aria-hidden="true">🌎</span></p>
      <p class="foot-bottom-links">
        <a href="/terminos">{T.terms}</a><span aria-hidden="true">·</span>
        <a href="/privacidad">{T.privacy}</a><span aria-hidden="true">·</span>
        <a href="/contacto">{T.contact}</a><span aria-hidden="true">·</span>
        <a href={isEn ? '/sitemap-en.xml' : isPt ? '/sitemap-pt.xml' : '/sitemap.xml'}>Sitemap</a><span aria-hidden="true">·</span>
        <a href="https://genfy.net" target="_blank" rel="noopener">Genfy</a>
      </p>
      <p class="foot-green" title="Cloudflare — 100% renewable energy"><span aria-hidden="true">🌱</span> {T.green}</p>
    </div>
  </div>

  <script is:inline>
    document.getElementById('footer-cookie-config')?.addEventListener('click', function () {
      if (typeof window.hcOpenCookieSettings === 'function') window.hcOpenCookieSettings();
    });
  </script>
</footer>

<style>
  /* ── Footer v7: grid compacto, theme-aware (usa las vars del sitio) ──
     Fondo = --bg (mismo crema/paper que la página y el header) para que TODOS
     los fondos coincidan; el border-top lo separa. Las cards internas quedan
     blancas por --bg-card. */
  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
    margin-top: 5rem;
    padding: 3.25rem 1.25rem 2.25rem;
  }
  .foot-wrap { max-width: 1120px; margin: 0 auto; }

  .footGrid {
    display: grid;
    grid-template-columns: 1.5fr repeat(6, 1fr);
    gap: 2rem 1.75rem;
  }
  .footCol-brand { max-width: 340px; }

  .foot-brand {
    display: inline-flex; align-items: center; gap: 0.55rem;
    font-weight: 800; font-size: 1.0625rem; color: var(--text); letter-spacing: -0.015em;
    margin-bottom: 0.75rem;
  }
  .brand-mark { width: 34px; height: 34px; object-fit: contain; }
  .foot-tagline { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 0.75rem; }
  .foot-dots { font-size: 0.75rem; color: var(--text-subtle); margin: 0; }
  .foot-dots .fd { white-space: nowrap; }
  .foot-dots .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--success); margin-right: 4px; vertical-align: 1px; }

  .footCol b {
    display: block;
    font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text); margin-bottom: 0.7rem;
  }
  .footCol b.foot-follow-h { margin-top: 1.1rem; }
  .footCol a {
    display: block; font-size: 0.8125rem; color: var(--text-muted);
    line-height: 2; text-decoration: none; transition: color 0.15s;
  }
  .footCol a:hover { color: var(--accent); }

  .cookie-config-btn {
    display: block; background: none; border: none; padding: 0; margin-top: 0.4rem;
    font-family: inherit; font-size: 0.8125rem; color: var(--accent); cursor: pointer; text-align: left; line-height: 2;
  }
  .cookie-config-btn:hover { text-decoration: underline; }

  .footSocial { display: flex; gap: 0.45rem; flex-wrap: wrap; margin-top: 0.6rem; }
  .footSocial a {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px;
    background: var(--bg); border: 1px solid var(--border); color: var(--text-muted);
    transition: border-color 0.15s, color 0.15s, background 0.15s, transform 0.15s;
  }
  .footSocial a:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }
  .social-ico { display: inline-flex; line-height: 0; }
  .social-ico :global(svg) { width: 16px; height: 16px; display: block; }

  /* Disclaimer legal (YMYL) — compacto */
  .foot-legal {
    max-width: 1120px; margin: 2.5rem auto 0; padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .foot-legal p { font-size: 0.78rem; color: var(--text-subtle); line-height: 1.6; margin: 0; }
  .foot-legal strong { color: var(--text-muted); font-weight: 600; }
  .foot-legal a { color: var(--text-muted); text-decoration: underline; text-underline-offset: 2px; }

  .foot-bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem;
    margin-top: 1.4rem; padding-top: 1.4rem; border-top: 1px solid var(--border);
  }
  .foot-bottom p { font-size: 0.78rem; color: var(--text-subtle); margin: 0; }
  .foot-bottom-links a { color: var(--text-subtle); margin: 0 0.25rem; text-decoration: none; }
  .foot-bottom-links a:hover { color: var(--accent); }
  .foot-green { width: 100%; text-align: center; margin-top: 0.4rem !important; font-size: 0.72rem !important; color: var(--text-muted); }

  @media (max-width: 1020px) {
    .footGrid { grid-template-columns: 1fr 1fr 1fr; gap: 2rem 1.5rem; }
    .footCol-brand { grid-column: 1 / -1; max-width: none; }
  }
  @media (max-width: 620px) {
    .footGrid { grid-template-columns: 1fr 1fr; }
    .foot-bottom { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 400px) {
    .footGrid { grid-template-columns: 1fr; }
  }
</style>
