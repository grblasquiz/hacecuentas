    .calc{background:#fff;border:1px solid #d9e0e9;border-radius:20px;padding:26px 29px;box-shadow:0 25px 60px #17254818;position:relative;z-index:2}.calc-title{display:flex;justify-content:space-between;gap:20px}.calc h2{font-size:23px;margin:0 0 4px}.calc-title p{font-size:10px;color:#6b7d91;margin:0}.tag{font-size:9px;color:#6746d7;background:#eeeafd;border-radius:99px;padding:7px 10px;font-weight:800;height:max-content;white-space:nowrap}.section-label{font-size:10px;font-weight:850;color:#293b53;margin:17px 0 8px}.cases{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.case{border:1px solid #dce2eb;background:#fff;border-radius:10px;padding:9px 4px;color:#5d7188;font-size:8px;font-weight:750;min-height:65px;cursor:pointer}.case i{display:block;font-style:normal;font-size:17px;margin-bottom:3px}.case.active{border:2px solid #6c4bd8;background:#f4f1ff;color:#5b3fc1}.fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.field{border:1px solid #dbe2ea;border-radius:10px;padding:9px 11px;min-height:57px}.field.wide{grid-column:span 2}.field label{display:block;color:#77879a;font-size:8px;margin-bottom:5px}.field input,.field select{border:0;outline:0;background:none;width:100%;color:#142641;font-weight:750;font-size:13px}.inline{display:flex;align-items:center;gap:5px}.inline b{font-size:11px}.advanced{display:flex;justify-content:space-between;margin:11px 0;color:#65788d;font-size:9px}.advanced b{color:#6746d7}.result{background:#182a49;color:#fff;border-radius:15px;padding:18px 20px}.result-top{display:flex;align-items:start;justify-content:space-between}.result small{font-size:9px;color:#b9cbdd}.price{font-size:34px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.margin{background:#e9fbfd;color:#087887;border-radius:9px;padding:8px 11px;text-align:right}.margin strong{display:block;font-size:15px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #3b4f6e;padding-top:12px;margin-top:13px}.stats span{font-size:8px;color:#afc0d1}.stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.go{width:100%;border:0;border-radius:9px;background:linear-gradient(90deg,#6746d7,#1aaebf);color:#fff;font-weight:800;padding:12px;margin-top:14px;cursor:pointer}
    .breakdown{padding:74px 0 67px}.center{text-align:center;max-width:720px;margin:0 auto 36px}.center span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#6746d7;font-weight:850}.center h2{font-size:36px;letter-spacing:-.04em;margin:10px 0}.center p{color:#687a8f;line-height:1.6}.break-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:20px}.card{border:1px solid #dce3eb;border-radius:16px;padding:25px;box-shadow:0 10px 27px #1738580b}.card h3{font-size:18px;margin:0 0 19px}.row{display:grid;grid-template-columns:165px 1fr 105px;align-items:center;gap:14px;margin:15px 0}.row span{font-size:10px;font-weight:750}.bar{height:8px;background:#edf1f5;border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;border-radius:99px;background:#19aebb}.row:nth-child(3) .bar i{background:#e4a54a}.row:nth-child(4) .bar i{background:#6746d7}.row:nth-child(5) .bar i{background:#e46e68}.row b{text-align:right;font-size:12px}.total{display:flex;justify-content:space-between;border-top:1px solid #e1e7ed;margin-top:20px;padding-top:17px}.total strong:last-child{color:#6746d7;font-size:19px}.donut-card{background:#f8f9fc}.donut{width:144px;height:144px;margin:6px auto 17px;border-radius:50%;background:conic-gradient(#19aebb 0 8%,#e4a54a 8% 10%,#6746d7 10% 56%,#e46e68 56% 100%);position:relative}.donut:after{content:"$4.910";position:absolute;inset:29px;border-radius:50%;background:#fff;display:grid;place-items:center;font-size:17px;font-weight:850}.legend{display:grid;grid-template-columns:1fr 1fr;gap:8px}.legend div{font-size:9px;color:#6f8195}.legend i{display:inline-block;width:8px;height:8px;border-radius:3px;margin-right:5px}.tip{background:#eeeafd;border:1px solid #ddd3fa;border-radius:11px;padding:13px;margin-top:15px;font-size:9px;line-height:1.55;color:#5d4d8c}
    .workflow{background:#f4f6fa;padding:69px 0}.flow-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:27px}.flow-head h2{font-size:34px;letter-spacing:-.04em;margin:8px 0 0}.flow-head>div>span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#6746d7;font-weight:850}.flow-note{font-size:9px;color:#64778d}.flow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.flow{background:#fff;border:1px solid #dce3eb;border-radius:14px;padding:18px;min-height:180px;position:relative}.flow em{position:absolute;right:14px;top:13px;font-size:9px;font-style:normal;color:#a2afbd}.flow i{font-style:normal;font-size:24px}.flow h3{font-size:13px;margin:11px 0 6px}.flow p{font-size:9px;color:#77899c;line-height:1.55;margin:0}.flow b{display:block;color:#6746d7;font-size:11px;margin-top:16px}
