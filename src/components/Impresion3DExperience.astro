    @media(max-width:800px){.wrap{width:min(100% - 28px,1160px)}.links{display:none}.hero-grid,.break-grid,.business-grid{grid-template-columns:1fr}.copy{text-align:center}.copy h1{font-size:39px}.eyebrow,.chips{justify-content:center}.printer-art{max-width:390px;margin-inline:auto}.calc{padding:20px 16px}.cases{grid-template-columns:1fr 1fr}.flow-grid{grid-template-columns:1fr 1fr}.mat-grid{grid-template-columns:repeat(3,1fr)}.flow-head{display:block}.flow-note{margin-top:10px}.tools span:not(:last-child){display:none}}@media(max-width:480px){.copy h1{font-size:36px}.machine{left:30px}.spool{right:7px}.fields{grid-template-columns:1fr}.field.wide{grid-column:auto}.stats{grid-template-columns:1fr 1fr}.row{grid-template-columns:1fr 78px}.row .bar{display:none}.flow-grid{grid-template-columns:1fr}.mat-grid{grid-template-columns:1fr 1fr}.price-row{grid-template-columns:95px 1fr 80px}}
.support{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;padding:70px 0}.support h2{font-size:24px}.support details{border-bottom:1px solid #dfe6ed;padding:14px 0}.support summary{font-size:12px;font-weight:750;cursor:pointer}.support p{font-size:11px;line-height:1.65;color:#687a8f}.support a{display:block;border:1px solid #dce5ee;border-radius:10px;padding:12px;margin:8px 0;color:#397dd0;text-decoration:none;font-size:10px;font-weight:700}.support small{display:block;color:#78899c;margin-top:4px}
