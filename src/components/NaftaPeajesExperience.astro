---
interface Props { data:any; pricesProvince:Record<string,Record<string,number>>; pricesNational:Record<string,number> }
const { data, pricesProvince, pricesNational } = Astro.props;
---
<div class="road-trip">
    <section class="hero">
      <div class="wrap crumb"><b>Auto</b> &nbsp;/&nbsp; Nafta y peajes</div>
      <div class="wrap hero-grid">
        <div class="copy">
          <span class="eyebrow">Calculadora de viaje</span>
          <h1>Antes de salir,<br>sabé cuánto vas<br>a gastar.</h1>
          <p>Calculá nafta, peajes, tiempo y costo por persona. Con precios de combustible actualizados para tu provincia.</p>
          <div class="chips"><span>⛽ Precio oficial</span><span>◉ Telepase</span><span>👥 Dividí el gasto</span></div>
          <div class="route-art">
            <svg viewBox="0 0 520 240" fill="none">
              <path d="M36 194C92 178 105 109 167 125s69 68 128 36 49-104 112-105 58 45 83 50" stroke="#bfd8f0" stroke-width="17" stroke-linecap="round"/>
              <path d="M36 194C92 178 105 109 167 125s69 68 128 36 49-104 112-105 58 45 83 50" stroke="#2d7be8" stroke-width="4" stroke-dasharray="10 10" stroke-linecap="round"/>
              <circle cx="38" cy="193" r="15" fill="#fff" stroke="#1b70df" stroke-width="4"/><circle cx="487" cy="106" r="15" fill="#fff" stroke="#1b9a68" stroke-width="4"/>
              <g transform="translate(208 117)"><rect x="0" y="0" width="79" height="42" rx="13" fill="#173858"/><path d="M14 13h45l9 13H8l6-13Z" fill="#fff"/><circle cx="21" cy="31" r="6" fill="#173858" stroke="#fff" stroke-width="3"/><circle cx="57" cy="31" r="6" fill="#173858" stroke="#fff" stroke-width="3"/></g>
            </svg>
            <span class="route-label start">📍 Buenos Aires</span><span class="route-label end">🏁 Mar del Plata</span>
          </div>
        </div>
        <form class="calc">
          <div class="calc-title"><h2>Calculá tu viaje</h2><span class="tag">Precios actualizados</span></div>
          <div class="seg"><button type="button" class="on" data-mode="single">Viaje puntual</button><button type="button" data-mode="monthly">Gasto mensual</button></div>
          <div class="section-label">¿Cómo es el viaje?</div>
          <div class="triptype"><button type="button" data-way="one">Solo ida</button><button type="button" class="active" data-way="round">Ida y vuelta</button><button type="button" data-way="multiple">Varias veces</button></div>
          <div class="section-label">Datos principales</div>
          <div class="fields">
            <div class="field wide"><label>Distancia, sólo ida</label><div class="inline"><input id="distance" type="number" min="1" value="400"><b>km</b></div></div>
            <div class="field"><label>Consumo de tu auto</label><div class="inline"><input id="consumption" inputmode="decimal" value="8,5"><b>L/100 km</b></div></div>
            <div class="field"><label>Combustible</label><select id="fuel"><option value="Nafta Súper">Nafta súper</option><option value="Nafta Premium">Nafta premium</option><option value="Gasoil">Gasoil común</option><option value="Gasoil Premium">Gasoil premium</option></select></div>
            <div class="field"><label>Provincia donde cargás</label><select id="province">{Object.keys(pricesProvince).map((province) => <option value={province} selected={province === "Buenos Aires"}>{province}</option>)}</select></div>
            <div class="field"><label>Personas en el auto</label><select id="passengers"><option value="1">1 persona</option><option value="2" selected>2 personas</option><option value="3">3 personas</option><option value="4">4 personas</option><option value="5">5 personas</option></select></div>
          </div>
          <details class="advanced-box"><summary><span>Peajes, Telepase y otros gastos</span><b id="booth-summary">3 cabinas cargadas</b></summary><div class="extra-fields"><label>Cabinas sólo ida<input id="booths" type="number" min="0" value="3"></label><label>Precio por cabina<input id="booth-price" inputmode="numeric" value="6.100"></label><label>Telepase<select id="telepass"><option value="yes">Sí, 10% menos</option><option value="no">No</option></select></label><label>Desgaste por km<input id="wear" inputmode="decimal" value="55,995"></label><label>Velocidad promedio<input id="speed" type="number" value="95"></label><label>Otros gastos<input id="extras" inputmode="numeric" value="0"></label></div></details>
          <section class="result">
            <div class="result-top"><div><small>Costo total estimado</small><div class="price" id="trip-total">$179.940</div></div><div class="per"><small>Por persona</small><b id="per-person">$89.970</b></div></div>
            <div class="stats"><span>Combustible<b id="liters">68 litros</b></span><span>Peajes<b id="tolls">$32.940</b></span><span>Tiempo al volante<b id="drive-time">8 h 25 min</b></span></div>
            <button class="go" id="calculate-trip" type="button">Actualizar viaje</button>
          </section>
        </form>
      </div>
    </section>
    <section class="summary wrap">
      <header class="center"><span>El viaje, número por número</span><h2>Entendé en qué se va la plata</h2><p>Separá el gasto que pagás hoy del costo real de usar el auto.</p></header>
      <div class="summary-grid">
        <article class="card"><h3>Desglose estimado</h3>
          <div class="cost-row"><span>⛽ Combustible</span><div class="bar"><i style="width:100%"></i></div><b>$102.204</b></div>
          <div class="cost-row"><span>◉ Peajes</span><div class="bar"><i style="width:32%"></i></div><b>$32.940</b></div>
          <div class="cost-row"><span>🔧 Desgaste</span><div class="bar"><i style="width:44%"></i></div><b>$44.796</b></div>
          <div class="totalrow"><strong>Total ida y vuelta</strong><strong>$179.940</strong></div>
        </article>
        <article class="card route-card"><h3>Resumen de ruta</h3><div class="map"><svg viewBox="0 0 400 140" fill="none"><path d="M22 92c80 0 72-58 153-39s94 46 197-14" stroke="#bcd7ef" stroke-width="13" stroke-linecap="round"/><path d="M22 92c80 0 72-58 153-39s94 46 197-14" stroke="#2d7be8" stroke-width="3" stroke-dasharray="9 8"/><circle cx="22" cy="92" r="10" fill="#fff" stroke="#2274df" stroke-width="4"/><circle cx="372" cy="39" r="10" fill="#fff" stroke="#1a9967" stroke-width="4"/></svg></div>
          <div class="route-info"><div><span>Distancia total</span><b>800 km</b></div><div><span>Cabinas</span><b>6 pasos</b></div><div><span>Telepase ahorra</span><b>$3.660</b></div></div>
          <div class="tip"><i>💡</i><span>Si viajás con otras personas, lo más justo es dividir nafta y peajes. El desgaste suele quedar a cargo del dueño del auto.</span></div>
        </article>
      </div>
    </section>
    <section class="plans"><div class="wrap"><header class="center"><span>Planeá mejor</span><h2>Tres decisiones antes de arrancar</h2></header><div class="plan-grid">
      <article class="plan"><div class="icon">⛽</div><h3>Elegí dónde cargar</h3><p>El precio cambia por provincia y tipo de combustible. Compará súper y premium antes de salir.</p><b>Ver precios usados →</b></article>
      <article class="plan"><div class="icon">◉</div><h3>Revisá los peajes</h3><p>Cargá las cabinas de ida. La calculadora duplica automáticamente si volvés por el mismo camino.</p><b>Cómo estimarlos →</b></article>
      <article class="plan"><div class="icon">👥</div><h3>Acordá cómo dividir</h3><p>Compartí el total y el costo por persona para evitar cuentas incómodas después del viaje.</p><b>Compartir resultado →</b></article>
    </div></div></section>
    <div class="foot"></div>

<section class="support-real wrap"><div class="support-real-grid"><div><h2>Preguntas frecuentes</h2>{data.faq.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><div><h2>Fuentes oficiales</h2>{data.sources.map((s:any)=><a class="source-link" href={s.url} target="_blank" rel="nofollow noopener">{s.name}</a>)}</div></div></section>
</div>
<script is:inline define:vars={{ PROV: pricesProvince, NAC: pricesNational }}>
(()=>{const $=id=>document.getElementById(id),money=n=>'$'+Math.round(n||0).toLocaleString('es-AR'),num=v=>Number(String(v||'').replace(/\./g,'').replace(',','.').replace(/[^\d.-]/g,''))||0;let way='round',mode='single';const calc=()=>{const km=Math.max(0,num($('distance').value)),mult=way==='one'?1:2,repeats=mode==='monthly'?22:way==='multiple'?8:1,cons=Math.max(0,num($('consumption').value)),fuel=$('fuel').value,province=$('province').value,price=Number(PROV[province]?.[fuel]??NAC[fuel]??0),liters=km*mult*repeats/100*cons,booths=Math.max(0,num($('booths').value)),boothPrice=Math.max(0,num($('booth-price').value)),discount=$('telepass').value==='yes'?.9:1,tolls=booths*boothPrice*mult*repeats*discount,wear=km*mult*repeats*Math.max(0,num($('wear').value)),extras=Math.max(0,num($('extras').value)),total=liters*price+tolls+wear+extras,passengers=Math.max(1,num($('passengers').value)),hours=km*mult/Math.max(1,num($('speed').value));$('trip-total').textContent=money(total);$('per-person').textContent=money(total/passengers);$('liters').textContent=liters.toLocaleString('es-AR',{maximumFractionDigits:1})+' litros';$('tolls').textContent=money(tolls);$('drive-time').textContent=Math.floor(hours)+' h '+Math.round(hours%1*60)+' min';$('booth-summary').textContent=booths+' cabinas cargadas';document.querySelectorAll('.cost-row b')[0].textContent=money(liters*price);document.querySelectorAll('.cost-row b')[1].textContent=money(tolls);document.querySelectorAll('.cost-row b')[2].textContent=money(wear);document.querySelector('.totalrow strong:last-child').textContent=money(total)};document.querySelectorAll('[data-mode]').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('on',x===b));calc()}));document.querySelectorAll('[data-way]').forEach(b=>b.addEventListener('click',()=>{way=b.dataset.way;document.querySelectorAll('[data-way]').forEach(x=>x.classList.toggle('active',x===b));calc()}));$('calculate-trip').addEventListener('click',()=>{calc();$('calculate-trip').textContent='Viaje actualizado ✓';setTimeout(()=>$('calculate-trip').textContent='Actualizar viaje',1800)});document.querySelectorAll('.calc input,.calc select').forEach(el=>el.addEventListener('change',calc));calc()})();
</script>
<style>
    *{box-sizing:border-box}.road-trip{width:100%;overflow:hidden;color:#10223d;background:#fff;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.road-trip button,.road-trip input,.road-trip select{font:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.hero-grid>*{min-width:0}
    .top{height:88px;border-bottom:1px solid #dfe7ef;display:flex;align-items:center;background:#fff}.nav{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;font-size:18px;font-weight:850}.logo{width:31px;height:31px;border-radius:7px;background:#173452;display:grid;place-items:center;color:#fff;font-size:15px}.links,.tools{display:flex;align-items:center;gap:27px}.links a{font-size:13px;font-weight:700;color:#43526a;text-decoration:none}.tools span{border:1px solid #d9e2eb;border-radius:10px;padding:11px 14px;font-size:12px;font-weight:700}.tools .profile{background:#132844;color:#fff;border-color:#132844}
    .hero{background:linear-gradient(120deg,#f4f9ff 0%,#f4f9ff 65%,#eef8f3 100%);padding:25px 0 64px;overflow:hidden;position:relative}.crumb{font-size:12px;color:#718299;margin-bottom:34px}.crumb b{color:#1769db}.hero-grid{display:grid;grid-template-columns:.87fr 1.13fr;gap:55px;align-items:start}.eyebrow{font-size:11px;font-weight:850;letter-spacing:.14em;text-transform:uppercase;color:#1770e6;display:flex;align-items:center;gap:9px}.eyebrow:before{content:"";width:28px;height:2px;background:#1770e6}.copy h1{font-size:53px;line-height:1.03;letter-spacing:-.052em;margin:18px 0;color:#0e1d36}.copy>p{font-size:17px;line-height:1.65;color:#5f7187;max-width:500px}.chips{display:flex;gap:8px;margin-top:25px}.chips span{background:#fff;border:1px solid #dbe5ef;border-radius:9px;padding:9px 11px;color:#53677e;font-size:10px}.route-art{margin-top:34px;width:96%;height:235px;position:relative}.route-art svg{width:100%;height:100%}.route-label{position:absolute;background:#fff;border:1px solid #dce6ef;border-radius:10px;padding:8px 10px;box-shadow:0 8px 22px #15345116;font-size:10px;font-weight:800}.route-label.start{left:4%;top:72%}.route-label.end{right:5%;top:8%}
    .calc{background:#fff;border:1px solid #d9e4ed;border-radius:20px;padding:27px 30px;box-shadow:0 25px 60px #173b6418;position:relative;z-index:2}.calc-title{display:flex;justify-content:space-between;align-items:flex-start}.calc h2{font-size:23px;margin:0}.tag{font-size:9px;color:#13794c;background:#e8f8f1;border-radius:99px;padding:7px 10px;font-weight:800}.seg{display:grid;grid-template-columns:1fr 1fr;background:#f1f5f9;border-radius:10px;padding:4px;margin:19px 0 17px}.seg button{border:0;border-radius:8px;padding:9px;background:transparent;color:#617289;font-weight:750;font-size:11px}.seg .on{background:#fff;color:#1769db;box-shadow:0 2px 8px #233a5415}.section-label{font-size:10px;font-weight:850;color:#293b53;margin:16px 0 8px}.triptype{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.triptype div{border:1px solid #dae4ee;border-radius:9px;padding:9px;font-size:10px;font-weight:750;text-align:center}.triptype .active{border:2px solid #2877ea;color:#1769db;background:#f3f7ff}.fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.field{border:1px solid #dbe4ed;border-radius:10px;padding:9px 11px;min-height:57px}.field.wide{grid-column:span 2}.field label{display:block;color:#77879a;font-size:8px;margin-bottom:5px}.field input,.field select{border:0;outline:0;background:none;width:100%;color:#142641;font-weight:750;font-size:13px}.inline{display:flex;align-items:center;gap:5px}.inline b{font-size:12px}.advanced{display:flex;justify-content:space-between;align-items:center;margin:11px 0;color:#65788d;font-size:9px}.advanced b{color:#1769db}.result{background:#173858;color:#fff;border-radius:15px;margin-top:14px;padding:18px 20px}.result-top{display:flex;justify-content:space-between}.result small{font-size:9px;color:#b9cbdd}.price{font-size:34px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.per{background:#e8f8f1;color:#14734b;border-radius:9px;padding:8px 10px;height:max-content;text-align:right}.per b{display:block;font-size:13px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #375675;padding-top:12px;margin-top:13px}.stats span{font-size:8px;color:#afc0d1}.stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.go{width:100%;border:0;border-radius:9px;background:#337ff0;color:#fff;font-weight:800;padding:12px;margin-top:14px}
    .summary{padding:75px 0 67px}.center{text-align:center;max-width:720px;margin:0 auto 36px}.center span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#1770e6;font-weight:850}.center h2{font-size:36px;letter-spacing:-.04em;margin:10px 0}.center p{color:#687a8f;line-height:1.6}.summary-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:20px}.card{border:1px solid #dce5ee;border-radius:16px;padding:25px;box-shadow:0 10px 27px #1738580b}.card h3{font-size:18px;margin:0 0 20px}.cost-row{display:grid;grid-template-columns:135px 1fr 105px;align-items:center;gap:14px;margin:15px 0}.cost-row span{font-size:10px;font-weight:750}.bar{height:8px;background:#edf2f6;border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;border-radius:99px;background:#2f7dea}.cost-row:nth-child(3) .bar i{background:#f0a235}.cost-row:nth-child(4) .bar i{background:#20a06b}.cost-row b{text-align:right;font-size:12px}.totalrow{display:flex;justify-content:space-between;border-top:1px solid #e1e7ee;margin-top:20px;padding-top:17px}.totalrow strong:last-child{color:#168158;font-size:19px}.route-card{background:#f8fbfe}.route-card .map{height:140px;background:#edf5fb;border-radius:12px;position:relative;overflow:hidden}.map svg{width:100%;height:100%}.route-info{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:15px}.route-info div{background:#fff;border:1px solid #dfe7ef;border-radius:10px;padding:11px}.route-info span{display:block;font-size:8px;color:#77889b}.route-info b{font-size:12px}.tip{display:flex;gap:10px;margin-top:14px;background:#fff8eb;border:1px solid #efdaad;border-radius:10px;padding:12px;color:#805817;font-size:9px;line-height:1.5}.tip i{font-style:normal;font-size:16px}
    .plans{background:#f5f8fc;padding:70px 0}.plan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.plan{background:#fff;border:1px solid #dce5ee;border-radius:15px;padding:22px}.icon{width:39px;height:39px;border-radius:11px;display:grid;place-items:center;background:#eaf3ff;color:#1769db;font-size:19px}.plan:nth-child(2) .icon{background:#eaf8f2;color:#168158}.plan:nth-child(3) .icon{background:#fff2dc;color:#b87808}.plan h3{font-size:15px;margin:14px 0 8px}.plan p{font-size:10px;color:#687a90;line-height:1.6}.plan b{font-size:11px;color:#1769db}.foot{height:130px;background:#fff}
    @media(max-width:800px){.links{display:none}.hero-grid,.summary-grid{grid-template-columns:minmax(0,1fr)}.copy{text-align:center}.copy h1{font-size:40px}.eyebrow,.chips{justify-content:center}.route-art{max-width:500px;margin-inline:auto}.plan-grid{grid-template-columns:1fr}.tools span:not(:last-child){display:none}.field select{min-width:0;text-overflow:ellipsis}.center h2{font-size:32px}}


    .triptype button{border:1px solid #dae4ee;border-radius:9px;padding:9px;background:#fff;font-size:10px;font-weight:750;text-align:center;color:#10223d;cursor:pointer}.triptype button.active{border:2px solid #2877ea;color:#1769db;background:#f3f7ff}
    .advanced-box{margin:11px 0;color:#65788d;font-size:9px}.advanced-box summary{display:flex;justify-content:space-between;cursor:pointer;list-style:none}.advanced-box summary b{color:#1769db}.extra-fields{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:10px}.extra-fields label{background:#f6f9fc;border:1px solid #dce5ee;border-radius:8px;padding:7px;font-size:8px}.extra-fields input,.extra-fields select{display:block;width:100%;border:0;background:transparent;outline:0;font-weight:750;margin-top:4px}.support-real{padding:70px 0}.support-real-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:30px}.support-real h2{font-size:24px}.support-real details{border-bottom:1px solid #dfe6ed;padding:14px 0}.support-real summary{font-size:12px;font-weight:750;cursor:pointer}.support-real p{font-size:11px;line-height:1.65;color:#687a8f}.source-link{display:block;border:1px solid #dce5ee;border-radius:10px;padding:12px;margin:8px 0;color:#1769db;text-decoration:none;font-size:10px;font-weight:700}@media(max-width:800px){.extra-fields,.support-real-grid{grid-template-columns:1fr}}

</style>
