---
/**
 * CalcRail — Rail lateral "sticky" con calculadoras sugeridas. Desktop only.
 *
 * Se monta como 3ra columna del .calc-layout (ver [...slug].astro). En desktop
 * >=1280px el grid le reserva su columna y queda sticky (como el TOC), así que
 * NO flota ni tapa el contenido. <1280px / tablet / mobile se oculta.
 *
 * Contenido: por defecto auto-derivado (relatedSlugs > related-auto). Se puede
 * pasar `items` curados (ej. IMC) para override.
 *
 * IMPORTANTE: el glob de calcs es el MISMO que usa RelatedCalcs.astro, a
 * propósito — así Vite comparte los módulos en un solo chunk en vez de
 * duplicar ~25MB de contenido en el worker (límite CF 64MiB). No mover esto a
 * un módulo de lib/: crea un chunk circular que rompe la deduplicación.
 *
 * Tracking: cada click dispara gtag('event','rail_click', ...) — aditivo, no
 * toca ningún tag existente (guard typeof gtag).
 */
import relatedAutoEs from '../lib/related-auto.json';
import relatedAutoEn from '../lib/related-auto-en.json';
import relatedAutoPt from '../lib/related-auto-pt.json';

export interface RailItem {
  icon?: string;
  label: string;
  href: string;
  slug?: string;
}
export interface Props {
  currentSlug: string;
  category?: string;
  lang?: 'es' | 'en' | 'pt';
  title?: string;
  headerIcon?: string;
  items?: RailItem[];
  /** Items fijados arriba del rail auto-derivado (dedup). Ej: hub de categoría. */
  pinned?: RailItem[];
  limit?: number;
}

const {
  currentSlug,
  category = '',
  lang = 'es',
  title,
  headerIcon = '🧮',
  items,
  pinned,
  limit = 7,
} = Astro.props;

const headerTitle =
  title || (lang === 'en' ? 'Related calculators' : 'Calculadoras relacionadas');

// Mismo glob que RelatedCalcs.astro (ver nota arriba sobre dedup de bundle).
const esModules = import.meta.glob<any>('../content/calcs/*.json', { eager: true });
const enModules = import.meta.glob<any>('../content/calcs-en/*.json', { eager: true });
const ptModules = import.meta.glob<any>('../content/calcs-pt/*.json', { eager: true });

// Acorta el label para el rail angosto: saca el prefijo "Calculadora de…".
function shortenLabel(s: string): string {
  const stripped = s
    .replace(/^Calculadora\s+(de\s+(la\s+|el\s+|los\s+|las\s+)?|del\s+)?/i, '')
    .trim();
  const out = stripped || s;
  return out.charAt(0).toUpperCase() + out.slice(1);
}

let rail: RailItem[];
if (items && items.length) {
  rail = items.slice(0, limit).map((it) => ({
    ...it,
    slug: it.slug || it.href.replace(/^\//, ''),
  }));
} else {
  // relatedSlugs (curado) > related-auto (TF-IDF). Sin relleno por categoría:
  // mejor un rail más corto pero 100% relevante.
  const modules = lang === 'en' ? enModules : lang === 'pt' ? ptModules : esModules;
  const allCalcs = Object.values(modules)
    .map((m: any) => m.default || m)
    .filter((c: any) => c && c.slug && !c.noindex);
  const bySlug = new Map<string, any>(allCalcs.map((c: any) => [c.slug, c]));
  const relatedAuto = lang === 'en' ? relatedAutoEn : lang === 'pt' ? relatedAutoPt : relatedAutoEs;
  const prefix = lang === 'en' ? '/en/' : lang === 'pt' ? '/pt/' : '/';

  const manual: string[] = bySlug.get(currentSlug)?.relatedSlugs || [];
  const auto: string[] = (relatedAuto as Record<string, string[]>)[currentSlug] || [];
  const seen = new Set<string>([currentSlug]);
  const picked: any[] = [];
  for (const s of [...manual, ...auto]) {
    const c = bySlug.get(s);
    if (c && !seen.has(c.slug)) {
      seen.add(c.slug);
      picked.push(c);
      if (picked.length >= limit) break;
    }
  }
  rail = picked.map((c: any) => ({
    icon: c.icon,
    label: shortenLabel(c.h1 || c.title || c.slug),
    href: `${prefix}${c.slug}`,
    slug: c.slug,
  }));
}

// Items fijados arriba (hub de categoría), dedup contra lo ya elegido y la
// propia página. Se aplica a ambas ramas (items curados o auto-derivados).
if (pinned && pinned.length) {
  const have = new Set(rail.map((r) => r.href));
  const pins = pinned
    .filter((p) => p.href.replace(/^\//, '') !== currentSlug && !have.has(p.href))
    .map((p) => ({ ...p, slug: p.slug || p.href.replace(/^\//, '') }));
  rail = [...pins, ...rail].slice(0, limit);
}

void category;
---

{rail.length > 0 && (
  <aside class="hcs" aria-label={headerTitle}>
    <header class="hcs-head">
      <span class="hcs-icon" aria-hidden="true">{headerIcon}</span>
      <span class="hcs-title">{headerTitle}</span>
    </header>
    <ul class="hcs-list">
      {rail.map((c, i) => (
        <li>
          <a
            href={c.href}
            class="hcs-item"
            data-rail-slug={c.slug}
            data-rail-pos={i + 1}
            data-rail-source={currentSlug}
          >
            <span class="hcs-item-icon" aria-hidden="true">{c.icon}</span>
            <span class="hcs-item-label">{c.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .hcs {
    display: none;
  }

  /* Desktop >=1280px: 3ra columna sticky del .calc-layout (como el TOC).
     Vive en su columna, no flota sobre el contenido. */
  @media (min-width: 1280px) {
    .hcs {
      display: block;
      position: sticky;
      top: 90px;
      align-self: flex-start;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
      padding: 0.875rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
      font-size: 0.8125rem;
    }
  }

  .hcs-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.625rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .hcs-icon {
    font-size: 1rem;
    line-height: 1;
  }
  .hcs-title {
    font-weight: 700;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .hcs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .hcs-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .hcs-item:hover {
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-card));
    color: var(--accent-strong);
  }
  .hcs-item-icon {
    font-size: 0.9375rem;
    flex-shrink: 0;
    line-height: 1;
  }
  .hcs-item-label {
    flex: 1;
    line-height: 1.3;
    /* títulos auto pueden ser largos: cap a 2 líneas */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script is:inline>
  (function () {
    var links = document.querySelectorAll('.hcs-item[data-rail-slug]');
    if (!links.length) return;
    links.forEach(function (a) {
      a.addEventListener(
        'click',
        function () {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'rail_click', {
              link_slug: a.getAttribute('data-rail-slug'),
              source_slug: a.getAttribute('data-rail-source'),
              rail_position: Number(a.getAttribute('data-rail-pos')),
            });
          }
        },
        { passive: true }
      );
    });
  })();
</script>
