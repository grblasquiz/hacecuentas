---
interface Props { data:any; convenios:Record<string,any>; orden:string[] }
const { data, convenios, orden } = Astro.props;
const icons:Record<string,string>={uocra:'🏗️',uthgra:'🍽️',comercio:'🛍️',camioneros:'🚛',uta:'🚌',smata:'🔩',uom:'⚙️',panaderos:'🥖','docente-nacional':'📚','docente-caba':'🏫','residente-medico':'🩺',enfermeria:'🏥',aeronautico:'✈️',policia:'🚓','dt-afa':'⚽',programador:'💻'};
function pctCaba(a:number){if(a>=24)return .7;if(a>=22)return .6;if(a>=18)return .5;if(a>=15)return .4;if(a>=12)return .3;if(a>=10)return .25;if(a>=7)return .2;if(a>=5)return .15;if(a>=2)return .1;return 0}
function liquidar(k:string,n=1,a=5){const c=convenios[k],basico=c.niveles[n],anios=c.antig.tope?Math.min(a,c.antig.tope):a,pct=c.antig.tipo==='tabla-caba'?pctCaba(a):c.antig.v*anios,plus=basico*pct,extras=c.extraDoceavo?(basico+plus)/12:basico*c.extraPctBasico+c.extraFijo,bruto=basico+plus+extras,aportes=bruto*c.aportes;return{...c,basico,pct,plus,extras,bruto,aportes,neto:bruto-aportes}}
const initialKey='comercio',initial=liquidar(initialKey),noRem=150000,ranking=orden.map(k=>({key:k,...liquidar(k)})).sort((a,b)=>b.bruto-a.bruto),initialRank=ranking.findIndex(x=>x.key===initialKey)+1;
const money=(n:number)=>'$'+Math.round(n).toLocaleString('es-AR');
---
<div class="salary-experience">
  <section class="hero">
    <div class="wrap crumb"><b>Trabajo</b> &nbsp;/&nbsp; Sueldos por convenio</div>
    <div class="wrap hero-grid">
      <div class="copy">
        <span class="eyebrow">Escalas salariales 2026</span>
        <h1>Tu convenio dice<br>cuánto deberías<br>estar cobrando.</h1>
        <p>Elegí gremio, categoría y antigüedad. Te mostramos el básico, los adicionales y cuánto queda de bolsillo.</p>
        <div class="chips"><span>📄 16 convenios</span><span>📈 Última paritaria</span><span>✓ Neto explicado</span></div>
        <div class="salary-art" aria-hidden="true"><div class="slip"><div class="slip-head"><b id="sc-art-cct">Comercio · CCT 130/75</b><span id="sc-art-date">julio 2026</span></div><div class="salary" data-net>{money(initial.neto+noRem)}</div><div class="salary-sub">Neto estimado con suma no remunerativa</div><div class="slip-lines"><i></i><i></i><i></i><i></i></div></div><div class="rank"><span><strong data-rank>{initialRank}°</strong>de 16</span></div><span class="scale-tag" id="sc-art-level">Administrativo C · 5 años</span></div>
      </div>
      <form class="calc" onsubmit="return false">
        <div class="calc-title"><div><h2>Calculá tu sueldo</h2><p>Seleccioná tu gremio o escalafón.</p></div><span class="tag">Escalas vigentes</span></div>
        <div class="section-label">Accesos rápidos</div>
        <div class="quick"><button class="active" type="button" data-quick="comercio"><i>🛍️</i>Comercio</button><button type="button" data-quick="uocra"><i>🏗️</i>UOCRA</button><button type="button" data-quick="uta"><i>🚌</i>UTA</button><button type="button" data-quick="uom"><i>⚙️</i>UOM</button></div>
        <div class="section-label">Tu situación</div>
        <div class="fields">
          <div class="field wide"><label for="sc-convenio">Convenio o escalafón</label><select id="sc-convenio">{orden.map(k=><option value={k} selected={k===initialKey}>{convenios[k].label}</option>)}</select></div>
          <div class="field"><label for="sc-nivel">Categoría</label><select id="sc-nivel">{initial.nombres.map((n:string,i:number)=><option value={i} selected={i===1}>{n}</option>)}</select></div>
          <div class="field"><label for="sc-antig">Años de antigüedad</label><div class="inline"><input id="sc-antig" type="number" min="0" max="45" value="5"><b>años</b></div></div>
          <div class="field wide"><label for="sc-norem">Sumas no remunerativas del mes</label><div class="inline"><b>$</b><input id="sc-norem" inputmode="numeric" value="150.000"></div></div>
        </div>
        <section class="result"><div class="result-top"><div><small>Neto estimado de bolsillo</small><div class="price" data-net>{money(initial.neto+noRem)}</div></div><div class="position"><small>Ranking</small><strong><span data-rank>{initialRank}°</span> / 16</strong></div></div><div class="stats"><span>Básico de convenio<b id="sc-basic">{money(initial.basico)}</b></span><span>Bruto remunerativo<b id="sc-gross">{money(initial.bruto)}</b></span><span>Aportes estimados<b id="sc-deductions">−{money(initial.aportes)}</b></span></div><button class="go" id="sc-update" type="button">Actualizar sueldo</button></section>
      </form>
    </div>
  </section>
  <section class="detail wrap"><header class="center"><span>Tu recibo, capa por capa</span><h2>Entendé cómo se forma el sueldo</h2><p>El básico es sólo el comienzo: antigüedad, adicionales y descuentos cambian lo que llega al bolsillo.</p></header><div class="detail-grid">
    <article class="card"><h3>Desglose estimado</h3><div class="row"><span>📄 Básico de categoría</span><div class="bar"><i id="sc-bar-basic"></i></div><b id="sc-row-basic">{money(initial.basico)}</b></div><div class="row"><span id="sc-plus-label">📅 Antigüedad (5%)</span><div class="bar"><i id="sc-bar-plus"></i></div><b id="sc-row-plus">+{money(initial.plus)}</b></div><div class="row"><span id="sc-extra-label">✓ Presentismo</span><div class="bar"><i id="sc-bar-extra"></i></div><b id="sc-row-extra">+{money(initial.extras)}</b></div><div class="row"><span id="sc-ded-label">− Aportes (17%)</span><div class="bar"><i id="sc-bar-ded"></i></div><b id="sc-row-ded">−{money(initial.aportes)}</b></div><div class="total"><strong>Neto + no remunerativo</strong><strong data-net>{money(initial.neto+noRem)}</strong></div></article>
    <article class="card receipt"><div class="receipt-top"><h3>Cómo leer este resultado</h3><span id="sc-cct">CCT 130/75</span></div><div class="receipt-info"><div><small>Categoría</small><b id="sc-category">Administrativo C / Cajero B</b></div><div><small>Escala usada</small><b id="sc-date">julio 2026</b></div><div><small>Adicional propio</small><b id="sc-extra-name">Presentismo (art. 40)</b></div><div><small>Posición</small><b id="sc-position">{initialRank}° de 16</b></div></div><div class="notice"><i>💡</i><span id="sc-note">{initial.nota}</span></div></article>
  </div></section>
  <section class="catalog"><div class="wrap"><div class="catalog-head"><div><span>Comparador completo</span><h2>Los 16 convenios, en el mismo escalón</h2></div><div class="legend">Bruto estimado · misma categoría relativa · misma antigüedad</div></div><div class="convenios" id="sc-catalog">
    {ranking.map((c,i)=><button type="button" class:list={['convenio',{selected:c.key===initialKey}]} data-card={c.key} style={`order:${i+1}`}><div class="c-head"><i>{icons[c.key]}</i><span>{c.cct}</span></div><h3>{c.label}</h3><p>{c.nombres[1]}</p><div class="c-price"><b>{money(c.bruto)}</b><em>{c.key===initialKey?'Tu convenio · ':''}{i+1}°</em></div></button>)}
  </div></div></section>
  <section class="support wrap"><div><h2>Preguntas frecuentes</h2>{data.faq.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><aside><h2>Fuentes oficiales</h2>{data.sources.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}<small>{s.publisher}</small></a>)}</aside></section>
</div>
<script is:inline define:vars={{ CONV:convenios, ORDEN:orden, ICONS:icons }}>
(()=>{const $=id=>document.getElementById(id),money=n=>'$'+Math.round(n||0).toLocaleString('es-AR'),num=v=>Number(String(v||'').replace(/\./g,'').replace(',','.').replace(/[^\d.-]/g,''))||0;const pctCaba=a=>a>=24?.7:a>=22?.6:a>=18?.5:a>=15?.4:a>=12?.3:a>=10?.25:a>=7?.2:a>=5?.15:a>=2?.1:0;const liquidar=(k,n,a)=>{const c=CONV[k],basico=c.niveles[n]??c.niveles[0],anios=c.antig.tope?Math.min(a,c.antig.tope):a,pct=c.antig.tipo==='tabla-caba'?pctCaba(a):c.antig.v*anios,plus=basico*pct,extras=c.extraDoceavo?(basico+plus)/12:basico*c.extraPctBasico+c.extraFijo,bruto=basico+plus+extras,aportes=bruto*c.aportes;return{c,basico,pct,plus,extras,bruto,aportes,neto:bruto-aportes}};let key='comercio';
const fillLevels=()=>{const c=CONV[key],old=Number($('sc-nivel').value)||1;$('sc-nivel').innerHTML=c.nombres.map((n,i)=>'<option value=\"'+i+'\">'+n+'</option>').join('');$('sc-nivel').value=String(Math.min(2,old))};
const calc=()=>{const nivel=Math.min(2,Math.max(0,Number($('sc-nivel').value)||0)),antig=Math.min(45,Math.max(0,num($('sc-antig').value))),noRem=Math.max(0,num($('sc-norem').value)),yo=liquidar(key,nivel,antig),ranking=ORDEN.map(k=>({k,label:CONV[k].label,...liquidar(k,nivel,antig)})).sort((a,b)=>b.bruto-a.bruto),puesto=ranking.findIndex(x=>x.k===key)+1,net=yo.neto+noRem,max=Math.max(yo.basico,yo.plus,yo.extras,yo.aportes,1);document.querySelectorAll('[data-net]').forEach(x=>x.textContent=money(net));document.querySelectorAll('[data-rank]').forEach(x=>x.textContent=puesto+'°');$('sc-basic').textContent=money(yo.basico);$('sc-gross').textContent=money(yo.bruto);$('sc-deductions').textContent='−'+money(yo.aportes);$('sc-row-basic').textContent=money(yo.basico);$('sc-row-plus').textContent='+'+money(yo.plus);$('sc-row-extra').textContent='+'+money(yo.extras);$('sc-row-ded').textContent='−'+money(yo.aportes);$('sc-plus-label').textContent='📅 Antigüedad ('+Math.round(yo.pct*100)+'%)';$('sc-extra-label').textContent='✓ '+yo.c.extraLabel;$('sc-ded-label').textContent='− Aportes ('+Math.round(yo.c.aportes*100)+'%)';$('sc-bar-basic').style.width=yo.basico/max*100+'%';$('sc-bar-plus').style.width=Math.max(2,yo.plus/max*100)+'%';$('sc-bar-extra').style.width=Math.max(2,yo.extras/max*100)+'%';$('sc-bar-ded').style.width=yo.aportes/max*100+'%';$('sc-cct').textContent=yo.c.cct;$('sc-category').textContent=yo.c.nombres[nivel];$('sc-date').textContent=yo.c.vigencia;$('sc-extra-name').textContent=yo.c.extraLabel;$('sc-position').textContent=puesto+'° de '+ranking.length;$('sc-note').textContent=yo.c.nota;$('sc-art-cct').textContent=yo.c.label+' · '+yo.c.cct;$('sc-art-date').textContent=yo.c.vigencia;$('sc-art-level').textContent=yo.c.nombres[nivel]+' · '+antig+' años';document.querySelectorAll('[data-quick]').forEach(b=>b.classList.toggle('active',b.dataset.quick===key));ranking.forEach((r,i)=>{const card=document.querySelector('[data-card=\"'+r.k+'\"]');card.style.order=i+1;card.classList.toggle('selected',r.k===key);card.querySelector('.c-price b').textContent=money(r.bruto);card.querySelector('.c-price em').textContent=(r.k===key?'Tu convenio · ':'')+(i+1)+'°';card.querySelector('p').textContent=CONV[r.k].nombres[nivel]})};
const choose=k=>{if(!CONV[k])return;key=k;$('sc-convenio').value=k;fillLevels();calc()};document.querySelectorAll('[data-quick]').forEach(b=>b.addEventListener('click',()=>choose(b.dataset.quick)));document.querySelectorAll('[data-card]').forEach(b=>b.addEventListener('click',()=>{choose(b.dataset.card);document.querySelector('.calc').scrollIntoView({behavior:'smooth',block:'center'})}));$('sc-convenio').addEventListener('change',()=>{key=$('sc-convenio').value;fillLevels();calc()});['sc-nivel','sc-antig','sc-norem'].forEach(id=>$(id).addEventListener('change',calc));$('sc-update').addEventListener('click',()=>{calc();$('sc-update').textContent='Sueldo actualizado ✓';setTimeout(()=>$('sc-update').textContent='Actualizar sueldo',1800)});calc()})();
</script>
<style>
  .salary-experience{width:100%;overflow:hidden;color:#12223b;background:#fff;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.salary-experience *{box-sizing:border-box}.salary-experience button,.salary-experience input,.salary-experience select{font:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}
  .hero{background:linear-gradient(128deg,#f6f9ff 0%,#f6f9ff 62%,#eef8f4 100%);padding:25px 0 62px}.crumb{font-size:12px;color:#718299;margin-bottom:33px}.crumb b{color:#1769db}.hero-grid{display:grid;grid-template-columns:.87fr 1.13fr;gap:54px;align-items:start}.hero-grid>*{min-width:0}.copy{padding-top:5px}.eyebrow{font-size:11px;font-weight:850;letter-spacing:.14em;text-transform:uppercase;color:#1770e6;display:flex;align-items:center;gap:9px}.eyebrow:before{content:"";width:28px;height:2px;background:#1770e6}.copy h1{font-size:52px;line-height:1.04;letter-spacing:-.052em;margin:18px 0;color:#0e1d36}.copy>p{font-size:17px;line-height:1.65;color:#5f7187;max-width:490px}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:23px}.chips span{background:#fff;border:1px solid #dbe5ef;border-radius:9px;padding:9px 11px;color:#53677e;font-size:10px}
  .salary-art{height:230px;margin-top:20px;position:relative}.slip{position:absolute;left:62px;top:32px;width:235px;height:158px;background:#fff;border:1px solid #d8e4ee;border-radius:17px;box-shadow:0 24px 48px #17385815;padding:23px 25px}.slip-head{display:flex;justify-content:space-between;align-items:center}.slip-head b{font-size:11px;max-width:145px}.slip-head span{font-size:8px;color:#168158;background:#e9f8f1;border-radius:99px;padding:5px 8px}.salary{font-size:27px;font-weight:900;color:#173858;margin:17px 0 4px}.salary-sub{font-size:9px;color:#75879b}.slip-lines{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:16px}.slip-lines i{height:7px;background:#dce8f1;border-radius:99px}.rank{position:absolute;left:245px;bottom:12px;background:#173858;color:#fff;border:7px solid #f5f9fc;border-radius:50%;width:76px;height:76px;display:grid;place-items:center;text-align:center;font-size:9px;font-weight:750;line-height:1.2}.rank strong{display:block;font-size:22px}.scale-tag{position:absolute;left:18px;bottom:26px;background:#fff5df;color:#9b6a0a;border:1px solid #f0d7a5;border-radius:9px;padding:9px 11px;font-size:10px;font-weight:800}
  .calc{background:#fff;border:1px solid #d9e4ed;border-radius:20px;padding:26px 29px;box-shadow:0 25px 60px #173b6418;position:relative;z-index:2}.calc-title{display:flex;justify-content:space-between;gap:20px}.calc h2{font-size:23px;margin:0 0 4px}.calc-title p{font-size:10px;color:#6b7d91;margin:0}.tag{font-size:9px;color:#13794c;background:#e8f8f1;border-radius:99px;padding:7px 10px;font-weight:800;height:max-content;white-space:nowrap}.section-label{font-size:10px;font-weight:850;color:#293b53;margin:17px 0 8px}.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.quick button{border:1px solid #dce5ee;background:#fff;border-radius:10px;padding:9px 5px;color:#5d7188;font-size:9px!important;font-weight:750}.quick button i{display:block;font-style:normal;font-size:17px;margin-bottom:3px}.quick .active{border:2px solid #2779ed;background:#f2f7ff;color:#1769db}.fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.field{border:1px solid #dbe4ed;border-radius:10px;padding:9px 11px;min-height:57px}.field.wide{grid-column:span 2}.field label{display:block;color:#77879a;font-size:8px;margin-bottom:5px}.field input,.field select{border:0;outline:0;background:none;width:100%;color:#142641;font-weight:750;font-size:13px}.inline{display:flex;align-items:center;gap:5px}.inline b{font-size:12px}.result{background:#173858;color:#fff;border-radius:15px;margin-top:14px;padding:18px 20px}.result-top{display:flex;align-items:start;justify-content:space-between}.result small{font-size:9px;color:#b9cbdd}.price{font-size:34px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.position{background:#e8f8f1;color:#14734b;border-radius:9px;padding:8px 11px;text-align:center}.position strong{display:block;font-size:17px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #375675;padding-top:12px;margin-top:13px}.stats span{font-size:8px;color:#afc0d1}.stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.go{width:100%;border:0;border-radius:9px;background:#337ff0;color:#fff;font-size:12px;font-weight:800;padding:12px;margin-top:14px}
  .detail{padding:74px 0 67px}.center{text-align:center;max-width:720px;margin:0 auto 36px}.center span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#1770e6;font-weight:850}.center h2{font-size:36px;letter-spacing:-.04em;margin:10px 0}.center p{color:#687a8f;line-height:1.6}.detail-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:20px}.card{border:1px solid #dce5ee;border-radius:16px;padding:25px;box-shadow:0 10px 27px #1738580b}.card h3{font-size:18px;margin:0 0 19px}.row{display:grid;grid-template-columns:155px 1fr 96px;align-items:center;gap:14px;margin:16px 0}.row span{font-size:10px;font-weight:750}.bar{height:8px;background:#edf2f6;border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;border-radius:99px;background:#2f7dea}.row:nth-child(2) .bar i{background:#1fa16b}.row:nth-child(3) .bar i{background:#f0a235}.row:nth-child(4) .bar i{background:#d85c4c}.row b{text-align:right;font-size:12px}.total{display:flex;justify-content:space-between;border-top:1px solid #e1e7ee;margin-top:20px;padding-top:17px}.total strong:last-child{color:#168158;font-size:19px}.receipt{background:#f8fbfe}.receipt-top{display:flex;justify-content:space-between;align-items:start}.receipt-top span{font-size:9px;color:#168158;background:#e9f8f1;padding:6px 8px;border-radius:99px;font-weight:800}.receipt-info{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:17px}.receipt-info div{background:#fff;border:1px solid #dfe7ef;border-radius:10px;padding:12px}.receipt-info small{display:block;font-size:8px;color:#7b8b9d;margin-bottom:4px}.receipt-info b{font-size:11px}.notice{background:#fff7e8;border:1px solid #efd7a5;border-radius:12px;padding:14px;margin-top:14px;display:flex;gap:10px;color:#76541d;font-size:10px;line-height:1.55}.notice i{font-style:normal;font-size:18px}
  .catalog{background:#f5f8fc;padding:69px 0}.catalog-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:27px}.catalog-head h2{font-size:34px;letter-spacing:-.04em;margin:8px 0 0}.catalog-head>div>span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#1770e6;font-weight:850}.legend{font-size:9px;color:#64778d}.convenios{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.convenio{appearance:none;text-align:left;background:#fff;border:1px solid #dce5ee;border-radius:13px;padding:16px;min-height:121px;color:#12223b}.convenio.selected{border:2px solid #2779ed;box-shadow:0 10px 26px #226dcc14}.c-head{display:flex;justify-content:space-between;gap:8px}.c-head i{font-style:normal;font-size:19px}.c-head span{font-size:8px;color:#718298}.convenio h3{font-size:11px;margin:9px 0 4px}.convenio p{font-size:8px;color:#77899c;margin:0}.c-price{display:flex;justify-content:space-between;align-items:end;margin-top:12px}.c-price b{font-size:14px}.c-price em{font-style:normal;font-size:8px;color:#168158;background:#e9f8f1;padding:4px 6px;border-radius:99px}.selected .c-price em{color:#1769db;background:#edf4ff}.support{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;padding:70px 0}.support h2{font-size:24px}.support details{border-bottom:1px solid #dfe6ed;padding:14px 0}.support summary{font-size:12px;font-weight:750;cursor:pointer}.support p{font-size:11px;line-height:1.65;color:#687a8f}.support a{display:block;border:1px solid #dce5ee;border-radius:10px;padding:12px;margin:8px 0;color:#1769db;text-decoration:none;font-size:10px;font-weight:700}.support small{display:block;color:#78899c;margin-top:4px}
  @media(max-width:800px){.hero-grid,.detail-grid,.support{grid-template-columns:minmax(0,1fr)}.copy{text-align:center}.copy h1{font-size:40px}.eyebrow,.chips{justify-content:center}.salary-art{max-width:400px;margin-inline:auto}.convenios{grid-template-columns:1fr 1fr}.catalog-head{display:block}.legend{margin-top:10px}.field select{min-width:0}.center h2{font-size:32px}}@media(max-width:480px){.wrap{width:min(100% - 28px,1160px)}.calc{padding:21px 16px}.price{font-size:30px}.row{grid-template-columns:122px 1fr 82px;gap:8px}.slip{left:50%;transform:translateX(-50%)}.rank{left:auto;right:24px}.scale-tag{left:5px}.convenios{grid-template-columns:1fr 1fr}.convenio{padding:12px}}
