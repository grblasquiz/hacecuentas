---
// Flagship redesign de la calc "aportes patronales y cargas sociales" — Argentina (mockup Martin).
// Los números salen del motor real (src/lib/formulas/aportes-patronales-cargas-sociales.ts):
//   costo = bruto + (SIPA + INSSJP + FNE + AAFF del Dec. 814) + ART + obra social 6%.
// Las alícuotas NO están exportadas por la fórmula: se DERIVAN del propio motor
// (bruto 1.000.000 → cada componente / 1e6 = alícuota), para que no haya una tabla
// duplicada que se desincronice si el fetcher cambia las constantes.
// OJO: la suma de componentes del inciso a da 20,8% (no el 20,4% nominal del régimen);
// el referenceTable del JSON ya documenta esa diferencia (redondeo de cada concepto).
// Domain "data" (esmeralda) por el mockup, no por la categoría (finanzas→money).
import '../styles/calc-flagship.css';
import { md } from '../lib/markdown';
import { aportesPatronalesCargasSociales } from '../lib/formulas/aportes-patronales-cargas-sociales';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

const fmt = (n: number) => '$' + Math.round(n).toLocaleString('es-AR');
const pct1 = (n: number) => n.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
const pct2 = (n: number) => n.toLocaleString('es-AR', { maximumFractionDigits: 2 }) + '%';

const BASE = 1_000_000; // base de derivación: cada componente / 1e6 = alícuota
const derivar = (actividad: any, riesgo: any, os: boolean) => {
  const r = aportesPatronalesCargasSociales({ sueldoBruto: BASE, actividadEmpleadora: actividad, riesgoART: riesgo, obraSocialEmpleador: os });
  return {
    sipa: (r.aporteSIPA / BASE) * 100,
    inssjp: (r.aporteINSSJP / BASE) * 100,
    fne: (r.aporteFNE / BASE) * 100,
    aaff: (r.aporteAAFF / BASE) * 100,
    art: (r.art / BASE) * 100,
    os: (r.obraSocial / BASE) * 100,
    empleado: (r.aportesEmpleado / BASE) * 100,
  };
};
const A = derivar('comercio', 'medio', true);   // inciso a
const B = derivar('industria', 'medio', true);  // inciso b
const ART = {
  bajo: derivar('comercio', 'bajo', true).art,
  medio: A.art,
  alto: derivar('comercio', 'alto', true).art,
};
const UNIF_A = A.sipa + A.inssjp + A.fne + A.aaff; // 20,8%
const UNIF_B = B.sipa + B.inssjp + B.fne + B.aaff; // 17,6%

const INIT = { sueldoBruto: 1_500_000, actividadEmpleadora: 'comercio' as const, riesgoART: 'medio' as const, obraSocialEmpleador: true };
const init = aportesPatronalesCargasSociales(INIT);
const initPctCargas = (init.totalCargasPatronales / INIT.sueldoBruto) * 100;

const fields = calc.fields || [];
const fieldOpts = (id: string) => {
  const f = fields.find((x: any) => x.id === id);
  return (f?.options || []) as { value: string; label: string }[];
};
const actOpts = fieldOpts('actividadEmpleadora');
const artOpts = fieldOpts('riesgoART');

const refRows = [800_000, 1_200_000, 1_500_000, 2_000_000, 3_000_000, 5_000_000].map((s) => {
  const r = aportesPatronalesCargasSociales({ ...INIT, sueldoBruto: s });
  return { bruto: s, cargas: r.totalCargasPatronales, costo: r.costoTotalEmpresa, neto: r.sueldoNetoEmpleado };
});

// Barras sobre el costo total de la empresa
const barBruto = (INIT.sueldoBruto / init.costoTotalEmpresa) * 100;
const barCargas = (init.totalCargasPatronales / init.costoTotalEmpresa) * 100;
const barEmpleado = (init.aportesEmpleado / init.costoTotalEmpresa) * 100;

const tasasAttr = JSON.stringify({ a: A, b: B, art: ART, empleado: A.empleado, os: A.os });
const faq = calc.faq || [];
const sources = calc.sources || [];
---

<div class="cf-page apc" data-domain="data" data-tasas={tasasAttr}>
  <nav class="cf-crumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Inicio</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li><a href="/categoria/finanzas">Finanzas</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li aria-current="page">Aportes patronales</li>
    </ol>
  </nav>

  <header class="cf-hero">
    <div class="cf-hero__main">
      <p class="cf-kicker"><span aria-hidden="true">🏢</span> Argentina · Cargas sociales · 2026</p>
      <h1 class="cf-h1">Costo de un <span class="cf-yr">empleado registrado</span></h1>
      <p class="cf-sub">Cuánto desembolsa realmente la empresa por cada sueldo bruto del recibo: contribuciones del Decreto 814, obra social y ART.</p>
      <ul class="cf-pills">
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Datos verificados 2026</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Cálculo privado</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Resultado explicado</li>
      </ul>
    </div>
    <div class="cf-hero__deco" aria-hidden="true">
      <span class="cf-deco-float"><span aria-hidden="true">💼</span> Empleo en blanco</span>
      <div class="apc-deco-wrap">
        <div class="cf-deco-card">
          <div class="cf-deco-card__label">Dato principal</div>
          <div class="cf-deco-card__value" id="apc-deco-val">{fmt(init.costoTotalEmpresa)}</div>
          <div class="cf-deco-card__note">Costo real · bruto {fmt(INIT.sueldoBruto)}</div>
        </div>
        <span class="cf-deco-badge apc-badge">ART</span>
      </div>
      <div class="cf-deco-sub"><strong>Cargas sobre el bruto</strong> <span class="cf-deco-chip" id="apc-deco-pct">{pct1(initPctCargas)}</span></div>
    </div>
  </header>

  <section class="cf-card" id="calc">
    <div class="cf-panel">
      <div class="cf-panel__head">
        <div>
          <p class="cf-panel__eyebrow">Calculadora</p>
          <h2 class="cf-panel__title">El sueldo y el encuadre</h2>
        </div>
        <span class="cf-panel__priv"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> No guardamos tus datos</span>
      </div>

      <div class="cf-field">
        <div class="cf-field__row"><label class="cf-label" for="apc-bruto">Sueldo bruto mensual</label><span class="cf-hint">Del recibo</span></div>
        <div class="apc-money"><span class="apc-money__sign">$</span><input class="cf-input cf-input--money" type="text" inputmode="numeric" id="apc-bruto" value="1.500.000" /></div>
        <p class="cf-help">Remuneración bruta sujeta a aportes (básico + adicionales remunerativos). No incluye viáticos no remunerativos.</p>
      </div>

      <div class="cf-grid2">
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="apc-act">Actividad del empleador</label></div>
          <select class="cf-input" id="apc-act">
            {actOpts.map((o) => <option value={o.value} selected={o.value === 'comercio'}>{o.label}</option>)}
          </select>
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="apc-art">Nivel de riesgo ART</label></div>
          <select class="cf-input" id="apc-art">
            {artOpts.map((o) => <option value={o.value} selected={o.value === 'medio'}>{o.label}</option>)}
          </select>
        </div>
      </div>

      <div class="cf-field">
        <label class="cf-toggle">
          <span class="cf-toggle__txt">Pago obra social como contribución<small>El 6% del empleador (Ley 23.660). Desactivalo sólo si tu caso no lo incluye.</small></span>
          <input type="checkbox" id="apc-os" checked />
          <span class="cf-switch"></span>
        </label>
      </div>

      <button class="cf-primary" id="apc-btn" type="button">Calcular resultado <span aria-hidden="true">→</span></button>

      <div class="cf-shortcuts">
        <span class="cf-shortcuts__lbl">Ejemplos:</span>
        <button class="cf-sc" type="button" data-ej="800000">$800.000</button>
        <button class="cf-sc" type="button" data-ej="1200000">$1,2 M</button>
        <button class="cf-sc" type="button" data-ej="2000000">$2 M</button>
        <button class="cf-sc" type="button" data-ej="3000000">$3 M</button>
      </div>
    </div>

    <div class="cf-result" id="apc-result">
      <p class="cf-result__eyebrow">Resultado estimado</p>
      <div class="cf-result__big" id="apc-big">{fmt(init.costoTotalEmpresa)}</div>
      <p class="cf-result__biglabel" id="apc-biglabel">de costo real por mes</p>
      <p class="cf-result__sub" id="apc-sub">Las cargas patronales suman {pct1(initPctCargas)} sobre el bruto del recibo</p>
      <div class="cf-tiles cf-tiles--2">
        <div class="cf-tile"><div class="cf-tile__value" id="apc-t-cargas">{fmt(init.totalCargasPatronales)}</div><div class="cf-tile__label">Cargas patronales</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="apc-t-pct">{pct1(initPctCargas)}</div><div class="cf-tile__label">Sobre el bruto</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="apc-t-neto">{fmt(init.sueldoNetoEmpleado)}</div><div class="cf-tile__label">Neto del empleado</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="apc-t-emp">{fmt(init.aportesEmpleado)}</div><div class="cf-tile__label">Aportes del empleado</div></div>
      </div>
      <div class="cf-rows">
        <div class="cf-rrow"><span class="cf-rrow__lbl">SIPA · jubilación <small id="apc-r-sipa-a">{pct2(A.sipa)} · Dec. 814 inc. a</small></span><span class="cf-rrow__val" id="apc-r-sipa">{fmt(init.aporteSIPA)}</span></div>
        <div class="cf-rrow"><span class="cf-rrow__lbl">INSSJP · PAMI <small id="apc-r-pami-a">{pct2(A.inssjp)}</small></span><span class="cf-rrow__val" id="apc-r-pami">{fmt(init.aporteINSSJP)}</span></div>
        <div class="cf-rrow"><span class="cf-rrow__lbl">Fondo Nacional de Empleo <small id="apc-r-fne-a">{pct2(A.fne)}</small></span><span class="cf-rrow__val" id="apc-r-fne">{fmt(init.aporteFNE)}</span></div>
        <div class="cf-rrow"><span class="cf-rrow__lbl">Asignaciones familiares <small id="apc-r-aaff-a">{pct2(A.aaff)}</small></span><span class="cf-rrow__val" id="apc-r-aaff">{fmt(init.aporteAAFF)}</span></div>
        <div class="cf-rrow"><span class="cf-rrow__lbl">ART <small id="apc-r-art-a">{pct2(A.art)} · riesgo medio (estimación)</small></span><span class="cf-rrow__val" id="apc-r-art">{fmt(init.art)}</span></div>
        <div class="cf-rrow"><span class="cf-rrow__lbl">Obra social empleador <small id="apc-r-os-a">{pct2(A.os)} · Ley 23.660</small></span><span class="cf-rrow__val" id="apc-r-os">{fmt(init.obraSocial)}</span></div>
      </div>
      <div class="cf-result__formula" id="apc-formula">{fmt(INIT.sueldoBruto)} + {fmt(init.totalCargasPatronales)} = {fmt(init.costoTotalEmpresa)}</div>
      <div class="cf-result__actions cf-result__actions--2">
        <button class="cf-rbtn" type="button" id="apc-copy"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copiar resultado</button>
        <button class="cf-rbtn" type="button" id="apc-detail"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg> Ver desglose</button>
      </div>
    </div>
  </section>

  <div class="cf-quick">
    <span class="cf-quick__ico" aria-hidden="true">⚡</span>
    <p class="cf-quick__txt" id="apc-quick"><strong>Respuesta rápida.</strong> Por un sueldo bruto de {fmt(INIT.sueldoBruto)} en comercio con ART de riesgo medio, la empresa desembolsa <strong>{fmt(init.costoTotalEmpresa)}</strong> por mes y el empleado se lleva {fmt(init.sueldoNetoEmpleado)} de bolsillo.</p>
    <span class="cf-formula">bruto + {pct1(initPctCargas)}</span>
  </div>

  <!-- DATOS CLAVE -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Datos clave</p>
        <h2 class="cf-section__title">Todo lo importante, de un vistazo</h2>
      </div>
      <p class="cf-section__lead">Valores de referencia del caso cargado y reglas principales para interpretar el resultado.</p>
    </div>
    <div class="cf-cards cf-cards--4">
      <div class="cf-minicard cf-minicard--dark">
        <span class="cf-minicard__ico" aria-hidden="true">🏛️</span>
        <p class="cf-minicard__sub apc-mc-lbl">Unificado Dec. 814 · inc. a</p>
        <div class="cf-minicard__big">{pct2(UNIF_A)}</div>
        <p class="cf-minicard__desc apc-mc-desc">Comercio y servicios grandes: SIPA {pct2(A.sipa)} + PAMI {pct2(A.inssjp)} + FNE {pct2(A.fne)} + AAFF {pct2(A.aaff)}. La alícuota nominal del régimen es 20,4%; la diferencia es el redondeo de cada concepto.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">🏭</span>
        <p class="cf-minicard__sub apc-mc-lbl">Unificado Dec. 814 · inc. b</p>
        <div class="cf-minicard__big">{pct2(UNIF_B)}</div>
        <p class="cf-minicard__desc apc-mc-desc">PyME, industria y agro. Requiere certificado MiPyME vigente de SEPyME para encuadrar acá.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">🏥</span>
        <p class="cf-minicard__sub apc-mc-lbl">Obra social empleador</p>
        <div class="cf-minicard__big">{pct2(A.os)}</div>
        <p class="cf-minicard__desc apc-mc-desc">Contribución del empleador de la Ley 23.660, por fuera del Decreto 814.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">⛑️</span>
        <p class="cf-minicard__sub apc-mc-lbl">ART según riesgo</p>
        <div class="cf-minicard__big">{pct2(ART.bajo)} – {pct2(ART.alto)}</div>
        <p class="cf-minicard__desc apc-mc-desc">Estimación por nivel de riesgo (Ley 24.557). La alícuota real la fija tu ART según el CIIU y la siniestralidad.</p>
      </div>
    </div>
  </section>

  <!-- CÓMO LEER EL RESULTADO -->
  <section class="cf-section">
    <p class="cf-eyebrow">Cómo leer el resultado</p>
    <h2 class="cf-section__title apc-t2">El bruto del recibo no es lo que sale la empresa</h2>
    <div class="apc-2col">
      <div class="cf-side-card cf-side-card--dark apc-hl">
        <p class="cf-side-eyebrow">Cómo leer el resultado</p>
        <p class="apc-hl__title">Hay dos descuentos distintos y se confunden</p>
        <p class="cf-side-desc">Las contribuciones patronales las paga la empresa <em>por encima</em> del bruto. Los aportes del empleado salen <em>de adentro</em> del bruto: bajan lo que cobra, pero no le cuestan nada extra a la empresa.</p>
        <div class="apc-hl__big" id="apc-hl-big">{pct1(initPctCargas)}</div>
        <p class="cf-side-desc">Es lo que la empresa suma sobre el sueldo bruto</p>
      </div>
      <div class="cf-breakdown">
        <div class="cf-breakdown__big" id="apc-bd-big">{fmt(init.costoTotalEmpresa)}</div>
        <p class="apc-note apc-note--top">Costo total de la empresa, por mes</p>
        <div class="cf-brow">
          <span class="cf-brow__lbl">Sueldo bruto del recibo</span>
          <span class="cf-brow__val" id="apc-bd-bruto">{fmt(INIT.sueldoBruto)}</span>
          <span class="cf-brow__bar"><span id="apc-bd-bruto-bar" style={`width:${barBruto.toFixed(1)}%`}></span></span>
        </div>
        <div class="cf-brow apc-brow--sp">
          <span class="cf-brow__lbl">Cargas patronales (las paga la empresa)</span>
          <span class="cf-brow__val" id="apc-bd-cargas">+ {fmt(init.totalCargasPatronales)}</span>
          <span class="cf-brow__bar"><span class="apc-bar--alt" id="apc-bd-cargas-bar" style={`width:${barCargas.toFixed(1)}%`}></span></span>
        </div>
        <div class="cf-brow apc-brow--sp">
          <span class="cf-brow__lbl">Aportes del empleado (salen del bruto)</span>
          <span class="cf-brow__val" id="apc-bd-emp">− {fmt(init.aportesEmpleado)}</span>
          <span class="cf-brow__bar"><span class="apc-bar--emp" id="apc-bd-emp-bar" style={`width:${barEmpleado.toFixed(1)}%`}></span></span>
        </div>
        <div class="cf-breakdown__total">
          <span>Neto que cobra el trabajador</span>
          <strong id="apc-bd-neto">{fmt(init.sueldoNetoEmpleado)}</strong>
        </div>
        <div class="cf-callout cf-callout--warn apc-cal">
          <span class="cf-callout__ico" aria-hidden="true">⚠️</span>
          <p>El neto es <strong>antes de Ganancias</strong>. Si el sueldo supera el mínimo no imponible, el empleador también retiene el impuesto de 4ta categoría.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PASO A PASO -->
  <section class="cf-section">
    <p class="cf-eyebrow">Paso a paso</p>
    <h2 class="cf-section__title apc-t2">De tus datos al resultado</h2>
    <div class="cf-steps">
      <div class="cf-step">
        <div class="cf-step__num">1</div>
        <p class="cf-step__title">Ingresá tus datos</p>
        <p class="cf-step__desc">El bruto del recibo, la actividad del empleador (define el inciso del Decreto 814) y el nivel de riesgo de la ART.</p>
        <span class="apc-chip" id="apc-s1">{fmt(INIT.sueldoBruto)} · comercio · ART medio</span>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">2</div>
        <p class="cf-step__title">Aplicamos la fórmula</p>
        <p class="cf-step__desc">Sumamos los cuatro subsistemas del Decreto 814, la ART según el riesgo y el 6% de obra social del empleador.</p>
        <span class="apc-chip" id="apc-s2">{pct2(UNIF_A)} + {pct2(A.art)} + {pct2(A.os)} = {pct1(initPctCargas)}</span>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">3</div>
        <p class="cf-step__title">Revisá el resultado</p>
        <p class="cf-step__desc">Ese porcentaje aplicado al bruto son las cargas; sumadas al sueldo dan el costo real del puesto para la empresa.</p>
        <span class="apc-chip" id="apc-s3">{fmt(init.costoTotalEmpresa)} · +{fmt(init.totalCargasPatronales)}</span>
      </div>
    </div>
  </section>

  <!-- REFERENCIAS -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Referencias</p>
        <h2 class="cf-section__title">Ejemplos para comparar</h2>
      </div>
      <p class="cf-section__lead">Usalos como orientación y ajustá los datos de la calculadora a tu situación.</p>
    </div>
    <div class="cf-tablewrap">
      <table class="cf-table">
        <thead><tr><th>Sueldo bruto</th><th>Cargas patronales</th><th>Costo total empresa</th><th>Neto del empleado</th></tr></thead>
        <tbody>
          {refRows.map((r) => (
            <tr>
              <td>{fmt(r.bruto)}</td>
              <td>{fmt(r.cargas)}</td>
              <td class="cf-td-em">{fmt(r.costo)}</td>
              <td>{fmt(r.neto)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="apc-tnote">Escenarios calculados con la misma fórmula para comercio (Dec. 814 inc. a), ART de riesgo medio y obra social del empleador incluida.</p>
  </section>
</div>

<!-- Banda: atención + referencia principal -->
<div class="cf-band cf-band--warm" data-domain="data">
  <div class="cf-band__inner">
    <div class="apc-2col">
      <div class="apc-card">
        <p class="cf-eyebrow">Atención</p>
        <h2 class="apc-card__title">El costo anual es mayor que doce de estos</h2>
        <p class="cf-side-desc">Esta cuenta es la del mes. Al año se le suman el aguinaldo (con sus propias cargas), las vacaciones pagas, la provisión por indemnización y los adicionales del convenio. Tampoco descuenta el mínimo no imponible por trabajador de la Ley 27.430, que reduce levemente la base, ni los regímenes de promoción del empleo.</p>
        <div class="cf-callout cf-callout--warn apc-cal">
          <span class="cf-callout__ico" aria-hidden="true">📋</span>
          <p>La alícuota de <strong>ART</strong> es una estimación por nivel de riesgo: la real la fija tu aseguradora según el CIIU y la siniestralidad de la empresa.</p>
        </div>
      </div>
      <div class="cf-side-card cf-side-card--dark">
        <p class="cf-side-eyebrow">Referencia principal</p>
