<div class="cf-page apc" data-domain="data">
  {related.length > 0 && (
    <section class="cf-section">
      <p class="cf-eyebrow">Seguí calculando</p>
      <h2 class="cf-section__title apc-t2">Herramientas relacionadas</h2>
      <div class="cf-related__grid">
        {related.slice(0, 3).map((c: any) => (
          <a class="cf-relcard" href={`/${c.slug}`}>
            <span class="cf-relcard__ico" aria-hidden="true">{c.icon || '🧮'}</span>
            <span class="cf-relcard__title">{String(c.h1 || c.title || '').split('|')[0].split('—')[0].trim()}</span>
            {c.description && <span class="cf-relcard__desc">{String(c.description).split('|')[0].trim().slice(0, 80)}</span>}
            <span class="cf-relcard__link">Calcular <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="cf-ctabar">
    <div>
      <p class="cf-ctabar__title">Guardá este resultado.</p>
      <p class="cf-ctabar__sub">Volvé a calcular cuando cambien tus datos.</p>
    </div>
    <div class="cf-ctabar__actions">
      <button class="cf-ctabar__btn cf-ctabar__btn--solid" type="button" id="apc-share2">Guardar resultado</button>
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector('.apc');
    if (!root) return;
    const T = JSON.parse(root.getAttribute('data-tasas'));
    const $ = function (id) { return document.getElementById(id); };
    const fmt = function (n) { return '$' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(Math.round(n)); };
    const pct1 = function (n) { return n.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%'; };
    const pct2 = function (n) { return n.toLocaleString('es-AR', { maximumFractionDigits: 2 }) + '%'; };

    const brutoEl = $('apc-bruto'), actEl = $('apc-act'), artEl = $('apc-art'), osEl = $('apc-os');
    function digits(v) { return Number(String(v || '').replace(/\D/g, '')) || 0; }
    function fmtThousands(v) { const n = String(v).replace(/\D/g, ''); return n ? Number(n).toLocaleString('es-AR') : ''; }

    // Réplica de aportesPatronalesCargasSociales(): sólo 'comercio' va por el inciso a.
    function calcular(bruto, actividad, riesgo, pagaOs) {
      const al = actividad === 'comercio' ? T.a : T.b;
      const sipa = bruto * (al.sipa / 100);
      const inssjp = bruto * (al.inssjp / 100);
      const fne = bruto * (al.fne / 100);
      const aaff = bruto * (al.aaff / 100);
      const art = bruto * (T.art[riesgo] / 100);
      const os = pagaOs ? bruto * (T.os / 100) : 0;
      const cargas = sipa + inssjp + fne + aaff + art + os;
      const empleado = bruto * (T.empleado / 100);
      return {
        sipa: sipa, inssjp: inssjp, fne: fne, aaff: aaff, art: art, os: os,
        cargas: cargas, costo: bruto + cargas, empleado: empleado, neto: bruto - empleado,
        pct: bruto > 0 ? (cargas / bruto) * 100 : 0,
        unif: al.sipa + al.inssjp + al.fne + al.aaff,
      };
    }

    function render() {
      const bruto = digits(brutoEl.value);
      const actividad = actEl.value, riesgo = artEl.value, pagaOs = osEl.checked;
      const r = calcular(bruto, actividad, riesgo, pagaOs);
      const incLbl = actividad === 'comercio' ? 'Dec. 814 inc. a' : 'Dec. 814 inc. b';
      const al = actividad === 'comercio' ? T.a : T.b;

      $('apc-big').textContent = fmt(r.costo);
      $('apc-sub').textContent = 'Las cargas patronales suman ' + pct1(r.pct) + ' sobre el bruto del recibo';
      $('apc-t-cargas').textContent = fmt(r.cargas);
      $('apc-t-pct').textContent = pct1(r.pct);
      $('apc-t-neto').textContent = fmt(r.neto);
      $('apc-t-emp').textContent = fmt(r.empleado);

      $('apc-r-sipa').textContent = fmt(r.sipa);
      $('apc-r-pami').textContent = fmt(r.inssjp);
      $('apc-r-fne').textContent = fmt(r.fne);
      $('apc-r-aaff').textContent = fmt(r.aaff);
      $('apc-r-art').textContent = fmt(r.art);
      $('apc-r-os').textContent = fmt(r.os);
      $('apc-r-sipa-a').textContent = pct2(al.sipa) + ' · ' + incLbl;
      $('apc-r-pami-a').textContent = pct2(al.inssjp);
      $('apc-r-fne-a').textContent = pct2(al.fne);
      $('apc-r-aaff-a').textContent = pct2(al.aaff);
      $('apc-r-art-a').textContent = pct2(T.art[riesgo]) + ' · riesgo ' + riesgo + ' (estimación)';
      $('apc-r-os-a').textContent = pagaOs ? pct2(T.os) + ' · Ley 23.660' : 'no incluida';
      $('apc-formula').textContent = fmt(bruto) + ' + ' + fmt(r.cargas) + ' = ' + fmt(r.costo);

      const dv = $('apc-deco-val'); if (dv) dv.textContent = fmt(r.costo);
      const dn = document.querySelector('.apc .cf-deco-card__note');
      if (dn) dn.textContent = 'Costo real · bruto ' + fmt(bruto);
      const dp = $('apc-deco-pct'); if (dp) dp.textContent = pct1(r.pct);

      $('apc-hl-big').textContent = pct1(r.pct);
      $('apc-bd-big').textContent = fmt(r.costo);
      $('apc-bd-bruto').textContent = fmt(bruto);
      $('apc-bd-cargas').textContent = '+ ' + fmt(r.cargas);
      $('apc-bd-emp').textContent = '− ' + fmt(r.empleado);
      $('apc-bd-neto').textContent = fmt(r.neto);
      const ct = r.costo > 0 ? r.costo : 1;
      $('apc-bd-bruto-bar').style.width = ((bruto / ct) * 100).toFixed(1) + '%';
      $('apc-bd-cargas-bar').style.width = ((r.cargas / ct) * 100).toFixed(1) + '%';
      $('apc-bd-emp-bar').style.width = ((r.empleado / ct) * 100).toFixed(1) + '%';

      const actTxt = actEl.options[actEl.selectedIndex].text.split('(')[0].trim();
      $('apc-s1').textContent = fmt(bruto) + ' · ' + actTxt + ' · ART ' + riesgo;
      $('apc-s2').textContent = pct2(r.unif) + ' + ' + pct2(T.art[riesgo]) + (pagaOs ? ' + ' + pct2(T.os) : '') + ' = ' + pct1(r.pct);
      $('apc-s3').textContent = fmt(r.costo) + ' · +' + fmt(r.cargas);
    }

    brutoEl.addEventListener('input', function () { brutoEl.value = fmtThousands(brutoEl.value); render(); });
    actEl.addEventListener('change', render);
    artEl.addEventListener('change', render);
    osEl.addEventListener('change', render);
    $('apc-btn').addEventListener('click', render);
    document.querySelectorAll('[data-ej]').forEach(function (b) {
      b.addEventListener('click', function () { brutoEl.value = fmtThousands(b.getAttribute('data-ej')); render(); });
    });

    function summary() {
      const bruto = digits(brutoEl.value);
      const r = calcular(bruto, actEl.value, artEl.value, osEl.checked);
      return 'Costo de un empleado registrado: por un sueldo bruto de ' + fmt(bruto) + ', la empresa desembolsa ' + fmt(r.costo) + ' por mes (' + pct1(r.pct) + ' de cargas patronales) y el empleado cobra ' + fmt(r.neto) + ' de neto. — hacecuentas.com';
    }
    function shareUrl() {
      return location.origin + location.pathname + '?bruto=' + digits(brutoEl.value) + '&actividad=' + actEl.value + '&art=' + artEl.value + '&os=' + (osEl.checked ? '1' : '0');
    }
    function copy(t, btn) {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(t).then(function () {
        const o = btn.innerHTML; btn.innerHTML = '✓ Copiado'; setTimeout(function () { btn.innerHTML = o; }, 1500);
      });
    }
    $('apc-copy').addEventListener('click', function (e) { copy(summary(), e.currentTarget); });
    $('apc-detail').addEventListener('click', function () {
      const t = document.getElementById('como-funciona'); if (t) t.scrollIntoView({ behavior: 'smooth' });
    });
    const s2 = $('apc-share2'); if (s2) s2.addEventListener('click', function (e) { copy(shareUrl(), e.currentTarget); });

    const q = new URLSearchParams(location.search);
    if (q.get('bruto')) brutoEl.value = fmtThousands(q.get('bruto'));
    if (q.get('actividad')) actEl.value = q.get('actividad');
    if (q.get('art')) artEl.value = q.get('art');
    if (q.get('os')) osEl.checked = q.get('os') !== '0';
    render();
  })();
</script>

