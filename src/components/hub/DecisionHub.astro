---
/**
 * Componente único de los hubs de decisión.
 *
 * Renderiza TODO el chrome a partir de un objeto `HubData`: hero con panel de
 * resultado, selector de caso, panel de inputs, gráfico, desglose, respuesta
 * rápida, FAQ y fuentes. Las páginas de hub sólo aportan datos + su compute().
 *
 * Contrato con la página:
 *   window.HC_HUB.onCompute(fn)   → fn(valores) debe devolver un HubResult
 *   window.HC_HUB.values()        → { [idCampo]: valor }  (números ya parseados)
 *   window.HC_HUB.currentCase()   → id del caso activo (o null si el hub no ramifica)
 *   window.HC_HUB.ars(n)          → formatea a pesos
 *
 * Decisiones de producto que NO son bugs (vienen del mockup aprobado):
 *   - El panel de resultado arranca en $0 hasta que el usuario aprieta el botón.
 *   - El desplegable "Mi caso es otro" arranca ABIERTO.
 * No las "arregles".
 *
 * El CSS vive en src/styles/hub.css, con todos los selectores prefijados por
 * `.hc-hub` para no chocar con Header/Footer ni con el resto del sitio.
 */
import '../../styles/hub.css';
import type { HubData } from '../../lib/hubs/types';
import { hubsOfSilo } from '../../lib/hubs/registry';
import HubRelatedPosts from './HubRelatedPosts.astro';

export interface Props {
  data: HubData;
}
const { data } = Astro.props;
const siblingHubs = hubsOfSilo(data.siloHref)
  .filter((hub) => hub.slug !== data.slug)
  .slice(0, 4);
const RESOURCES_BY_SILO: Record<string, Array<{ href: string; label: string }>> = {
  '/finanzas-personales': [
    { href: '/alertas', label: 'Alertas de dólar, inflación y vencimientos' },
    { href: '/cooperativa-de-datos', label: 'Datos abiertos que usa Hacé Cuentas' },
    { href: '/tabla/tabla-amortizacion-prestamo', label: 'Tabla de amortización de préstamos' },
  ],
  '/trabajo': [
    { href: '/que-sueldo-necesito', label: 'Calcular qué sueldo necesitás' },
    { href: '/alertas', label: 'Alertas de sueldo y novedades laborales' },
  ],
  '/eventos': [
    { href: '/calculadoras-evento', label: 'Todas las calculadoras para organizar un evento' },
  ],
  '/mx/impuestos': [
    { href: '/mx/datos-uma-imss-2026', label: 'Valor UMA e indicadores IMSS 2026' },
  ],
  '/mx/trabajo': [
    { href: '/mx/datos-uma-imss-2026', label: 'Valor UMA e indicadores IMSS 2026' },
  ],
  '/pe/auto': [
    { href: '/pe/datos-soat-uit-peru-2026', label: 'Valores SOAT y UIT de Perú 2026' },
  ],
  '/pe/tramites': [
    { href: '/pe/datos-soat-uit-peru-2026', label: 'Valores SOAT y UIT de Perú 2026' },
  ],
  '/pe/hogar': [
    { href: '/pe/datos-soat-uit-peru-2026', label: 'Valores SOAT y UIT de Perú 2026' },
  ],
  '/pt/dinheiro': [
    { href: '/pt/dados-ipca-brasil-historico', label: 'Série histórica do IPCA no Brasil' },
  ],
  '/salud': [
    { href: '/tabla/tabla-calorias-alimentos', label: 'Tabla de calorías de alimentos' },
  ],
  '/conversores': [
    { href: '/tabla/tabla-conversion-medidas', label: 'Tabla de conversión de medidas' },
  ],
};
const resourceLinks = RESOURCES_BY_SILO[data.siloHref] ?? [];

/*
 * Placeholder del panel antes del primer cálculo. Estaba hardcodeado en "$0",
 * que en los mercados no argentinos muestra la moneda equivocada (Portugal en
 * euros arrancaba diciendo "$0"). Se deriva del locale del hub; los hubs de AR
 * y los globales siguen viendo "$0" exactamente como antes.
 */
const CERO_POR_LOCALE: Record<string, string> = {
  'pt-pt': '€0', es: '€0',
  en: '$0', pt: 'R$0',
  cl: '$0', co: '$0', mx: '$0', uy: '$0', py: 'Gs 0', ve: 'Bs 0',
  pe: 'S/ 0', ec: '$0', do: 'RD$0',
};
const CERO = (data.locale && CERO_POR_LOCALE[data.locale]) || '$0';

/*
 * Cómo escribe números el usuario de este mercado. El parser asumía es-AR
 * ("1.500,50"), así que en los mercados de punto decimal un "450,000" tecleado
 * como cuatrocientos cincuenta mil se leía como 450. Afecta a todo campo con
 * `thousands: true`.
 */
// Ojo: tiene que coincidir con lo que imprime LOCALE_NUMERICO más abajo, o el
// usuario teclea con una convención y lee el resultado con la otra.
//
// Ecuador es el caso raro: la RAE marca coma decimal para el español, pero el
// país está dolarizado y la banca, el SRI y cualquier estado de cuenta usan el
// formato del dólar ($1,234.56). Como acá se calcula plata en dólares, mandan
// la práctica contable y lo que el usuario ve en su recibo — por eso 'ec' va
// en esta lista Y su LOCALE_NUMERICO es en-US, para que leer y escribir
// coincidan (es-EC imprimiría 1.234,56 y quedarían invertidos).
const LOCALES_PUNTO_DECIMAL = new Set(['en', 'mx', 'pe', 'ec', 'do']);
const PUNTO_DECIMAL = !!data.locale && LOCALES_PUNTO_DECIMAL.has(data.locale);

/*
 * Cómo IMPRIME números este hub. Es el espejo del parser de arriba y estaba
 * hardcodeado en 'es-AR' para todos los mercados: un 10 con 3 decimales salía
 * "10,000", que un lector inglés lee como diez mil. Afectaba a los 61 hubs en
 * inglés y a los de Brasil.
 */
const LOCALE_NUMERICO: Record<string, string> = {
  'pt-pt': 'pt-PT', es: 'es-ES', en: 'en-US', pt: 'pt-BR',
  cl: 'es-CL', co: 'es-CO', mx: 'es-MX', uy: 'es-UY', py: 'es-PY',
  ve: 'es-VE', pe: 'es-PE', ec: 'en-US', do: 'es-DO',
};
const NUM_LOCALE = (data.locale && LOCALE_NUMERICO[data.locale]) || 'es-AR';

/* Símbolo de moneda del mercado, derivado del mismo mapa que el placeholder. */
const MONEDA = CERO.replace(/0$/, '');

/*
 * Chrome del componente. Estaba todo hardcodeado en español rioplatense, así que
 * los 61 hubs en inglés y los de Brasil/Portugal mostraban "Inicio", "Tu caso" y
 * "Actualizar estimación" a lectores que no leen español. El voseo ("completás")
 * además sólo tiene sentido en AR: los demás mercados hispanos van con tuteo.
 *
 * El breadcrumb también apuntaba siempre a "/" (el home argentino); ahora un hub
 * de mercado enlaza el home de SU mercado, que es lo que el rastreador espera.
 */
type ChromeStrings = {
  home: string; migas: string; tuCaso: string; otroCaso: string; afina: string;
  actualiza: string; boton: string; comoSeForma: string; total: string;
  composicion: string; sinDatos: string; respuesta: string; queCorresponde: string;
  entra: string; ojo: string; plazo: string; faq: string; fuentes: string;
};
const CHROME: Record<string, ChromeStrings> = {
  /* Argentina: el default cuando el hub no declara `locale`. Único con voseo. */
  ar: {
    home: 'Inicio', migas: 'Migas', tuCaso: 'Tu caso', otroCaso: 'Mi caso es otro',
    afina: 'Afiná la estimación', actualiza: 'Se actualiza mientras completás tus datos',
    boton: 'Actualizar estimación', comoSeForma: 'Cómo se forma el total', total: 'Total',
    composicion: 'Composición del resultado', sinDatos: 'Sin datos calculados',
    respuesta: 'Respuesta rápida', queCorresponde: 'Qué te corresponde',
    entra: 'Entra en el cálculo', ojo: 'Ojo con esto', plazo: 'Plazo:',
    faq: 'Preguntas frecuentes', fuentes: 'Fuentes',
  },
  'es-neutro': {
    home: 'Inicio', migas: 'Migas', tuCaso: 'Tu caso', otroCaso: 'Mi caso es otro',
    afina: 'Ajusta la estimación', actualiza: 'Se actualiza mientras completas tus datos',
    boton: 'Actualizar estimación', comoSeForma: 'Cómo se forma el total', total: 'Total',
    composicion: 'Composición del resultado', sinDatos: 'Sin datos calculados',
    respuesta: 'Respuesta rápida', queCorresponde: 'Qué te corresponde',
    entra: 'Entra en el cálculo', ojo: 'Ojo con esto', plazo: 'Plazo:',
    faq: 'Preguntas frecuentes', fuentes: 'Fuentes',
  },
  en: {
    home: 'Home', migas: 'Breadcrumb', tuCaso: 'Your situation', otroCaso: "That's not my case",
    afina: 'Fine-tune the estimate', actualiza: 'Updates as you fill in your details',
    boton: 'Update estimate', comoSeForma: 'How the total adds up', total: 'Total',
    composicion: 'Result breakdown', sinDatos: 'Nothing calculated yet',
    respuesta: 'Quick answer', queCorresponde: 'What applies to you',
    entra: "What's included", ojo: 'Watch out for this', plazo: 'Deadline:',
    faq: 'Frequently asked questions', fuentes: 'Sources',
  },
  pt: {
    home: 'Início', migas: 'Navegação', tuCaso: 'O seu caso', otroCaso: 'Meu caso é outro',
    afina: 'Ajuste a estimativa', actualiza: 'Atualiza conforme você preenche seus dados',
    boton: 'Atualizar estimativa', comoSeForma: 'Como se forma o total', total: 'Total',
    composicion: 'Composição do resultado', sinDatos: 'Nada calculado ainda',
    respuesta: 'Resposta rápida', queCorresponde: 'O que se aplica a você',
    entra: 'Entra no cálculo', ojo: 'Atenção a isto', plazo: 'Prazo:',
    faq: 'Perguntas frequentes', fuentes: 'Fontes',
  },
};
CHROME['pt-pt'] = { ...CHROME.pt, actualiza: 'Atualiza à medida que preenche os seus dados', queCorresponde: 'O que lhe corresponde' };
for (const l of ['cl', 'co', 'mx', 'uy', 'py', 've', 'pe', 'ec', 'do', 'es']) CHROME[l] = CHROME['es-neutro'];

const T = (data.locale && CHROME[data.locale]) || CHROME.ar;
/* Home del mercado: los hubs de AR/globales siguen apuntando a "/". */
const HOME = data.locale ? `/${data.locale}` : '/';

const cases = data.cases?.items ?? [];
const defaultCase = cases[0];
const otherCases = cases.slice(1);
---

<div class="hc-hub">
  <div class="wrap">
    <nav class="crumbs" aria-label={T.migas}>
      <a href={HOME}>{T.home}</a><span aria-hidden="true">›</span>
      <a href={data.siloHref}>{data.silo}</a><span aria-hidden="true">›</span>
      <span aria-current="page">{data.h1}</span>
    </nav>

    <header class="decision-hero">
      <div class="hero-copy">
        <p class="eyebrow">{data.eyebrow}</p>
        <h1>{data.h1}</h1>
        <p class="lede">{data.lede}</p>
        <p class="stamp">
          {data.stamps.map((s, i) => (
            <>
              {i > 0 && <span class="dot"></span>}
              <span>{s}</span>
            </>
          ))}
        </p>
      </div>
      <aside class="live-result" aria-live="polite">
        <figure class="money-illustration" aria-hidden="true">
          <svg viewBox="0 0 96 96" role="img">
            <path class="paper" stroke-width="3" d="M23 10h43l12 13v58c0 4-3 7-7 7H23c-4 0-7-3-7-7V17c0-4 3-7 7-7Z"/>
            <path class="paper" stroke-width="3" d="M66 10v14h12"/>
            <path class="line" stroke-width="4" d="M29 34h31M29 46h22M29 58h17"/>
            <circle class="coin" cx="68" cy="68" r="16" stroke-width="3"/>
            <path class="line" stroke="#7d5208" stroke-width="3" d="M68 59v18M73 62c-2-3-11-3-11 2 0 6 12 2 12 8 0 5-9 6-13 2"/>
            <path class="line" stroke-width="3" d="M9 30h-5M12 20l-4-4M84 39h7M83 30l5-5"/>
          </svg>
        </figure>
        <p class="res-lbl">{data.resultLabel}</p>
        <p class="res-val" id="total">{CERO}</p>
        <p class="res-sub" id="sub"></p>
        <div class="result-status"><span class="pulse"></span>{T.actualiza}</div>
      </aside>
    </header>

    <main class="journey">
      {data.cases && (
        <section class="panel case-panel">
          <div class="panel-head">
            <p class="panel-kicker">{T.tuCaso}</p>
            <h2 id="case-title">{data.cases.title}</h2>
            <p class="panel-intro">{data.cases.intro}</p>
          </div>
          <button class="case-default" id="default-case" type="button" aria-selected="true">
            <span><b>{defaultCase.label}</b><span>{defaultCase.hint}</span></span>
            <span class="case-radio" aria-hidden="true"></span>
          </button>
          {/* open a propósito: expone las ramas al usuario y a los buscadores */}
          <details class="other-cases" open>
            <summary>{T.otroCaso}</summary>
            <div class="picker" role="tablist" aria-label={data.cases.title} id="picker">
              {otherCases.map((c) => (
                <button class="opt" type="button" role="tab" data-case={c.id} aria-selected="false">
                  <b>{c.label}</b><span>{c.hint}</span>
                </button>
              ))}
            </div>
          </details>
        </section>
      )}

      <section class="panel input-panel">
        <div class="panel-head">
          <p class="panel-kicker">{T.afina}</p>
          <h2>{data.inputsTitle}</h2>
          <p class="panel-intro">{data.inputsIntro}</p>
        </div>
        <span id="calc-name" hidden>{defaultCase?.label ?? data.h1}</span>
        <div class="fields">
          {data.fields.map((f) => (
            <div class="f">
              <label for={f.id}>{f.label}</label>
              <div class="f-in">
                {f.prefix && <span class="pre">{f.prefix}</span>}
                {f.type === 'select' ? (
                  <select id={f.id} data-field data-thousands={f.thousands ? '1' : null}>
                    {f.options?.map((o) => (
                      <option value={o.value} selected={String(f.value) === o.value}>{o.label}</option>
                    ))}
                  </select>
                ) : (
                  <input
                    id={f.id}
                    data-field
                    data-thousands={f.thousands ? '1' : null}
                    type={f.type === 'number' ? 'number' : f.type === 'date' ? 'date' : 'text'}
                    inputmode={f.thousands ? 'numeric' : undefined}
                    min={f.min}
                    max={f.max}
                    step={f.step}
                    value={String(f.value)}
                  />
                )}
                {f.suffix && <span class="pre">{f.suffix}</span>}
              </div>
              {/* El contrato declara `help` desde el día 1 pero no se imprimía:
                  todos los hubs venían escribiendo ayuda invisible. */}
              {f.help && <p class="f-help">{f.help}</p>}
            </div>
          ))}
        </div>
        <div class="calc-go"><button class="btn" id="go" type="button">{T.boton}</button></div>
        <p class="fineprint">{data.fineprint}</p>
      </section>

      <section class="panel result-panel">
        <div class="panel-head">
          <p class="panel-kicker">{T.comoSeForma}</p>
          <h2>{data.breakdownTitle}</h2>
          <p class="panel-intro">{data.breakdownIntro}</p>
        </div>
        <p class="breakdown-note">{data.chart.caption}</p>
        <div class="result-viz" data-chart={data.chart.type} aria-label={data.chart.title ?? T.composicion}>
          <div class="donut" id="result-donut" role="img" aria-label={T.sinDatos}>
            <div class="donut-center"><b id="donut-center">{CERO}</b><span>{T.total}</span></div>
          </div>
          <ul class="viz-legend" id="viz-legend"></ul>
        </div>
        <div class="breakdown" id="breakdown"></div>
      </section>

      <section class="panel context-panel">
        <div class="panel-head">
          <p class="panel-kicker">{T.respuesta}</p>
          <h2>{T.queCorresponde}</h2>
        </div>
        <div class="answer-strip">
          <b id="answer-title">{defaultCase?.answer ?? data.answer?.title}</b>
          <span id="answer-copy">{defaultCase?.yes[0] ?? data.answer?.copy}</span>
        </div>
        <div class="legal">
          <div class="lcard yes"><h3>{T.entra}</h3><ul id="yes-list"></ul></div>
          <div class="lcard warn"><h3>{T.ojo}</h3><ul id="warn-list"></ul></div>
        </div>
        <p class="plazo"><b>{T.plazo}</b> <span id="plazo"></span></p>
      </section>
    </main>

    <section class="support">
      <div class="support-grid">
        <div>
          <h2>{T.faq}</h2>
          <div class="faq">
            {data.faq.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p set:html={f.a} />
              </details>
            ))}
          </div>
        </div>
        <div>
          <h2>{T.fuentes}</h2>
          <div class="src">
            {data.sources.map((s) => (
              <a href={s.url} rel="nofollow noopener" target="_blank">
                {s.name}
                {(s.publisher || s.date) && (
                  <small>{[s.publisher, s.date].filter(Boolean).join(' · ')}</small>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <HubRelatedPosts posts={data.relatedPosts} />

    {siblingHubs.length > 0 && (
      <nav class="cluster-links" aria-label={`Más herramientas de ${data.silo}`}>
        <p>Seguí resolviendo en {data.silo}</p>
        <div>
          {siblingHubs.map((hub) => (
            <a href={`/${hub.slug}`}>{hub.h1}<span aria-hidden="true"> →</span></a>
          ))}
        </div>
      </nav>
    )}
    {resourceLinks.length > 0 && (
      <nav class="cluster-links" aria-label={`Datos y recursos de ${data.silo}`}>
        <p>Datos y recursos para esta cuenta</p>
        <div>
          {resourceLinks.map((resource) => (
            <a href={resource.href}>{resource.label}<span aria-hidden="true"> →</span></a>
          ))}
        </div>
      </nav>
    )}
  </div>
</div>

<style>
  .hc-hub .cluster-links{margin:28px 0 0;padding:24px;border:1px solid var(--hc-rule);border-radius:18px;background:var(--hc-paper)}
  .hc-hub .cluster-links p{margin:0 0 14px;font-weight:800}
  .hc-hub .cluster-links div{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
  .hc-hub .cluster-links a{color:var(--hc-ink);font-weight:700;text-decoration:none;line-height:1.35}
  .hc-hub .cluster-links a:hover{text-decoration:underline}
</style>

<script is:inline define:vars={{ PUNTO_DECIMAL, NUM_LOCALE, MONEDA, CASES: cases, HAS_CASES: !!data.cases }}>
  (function () {
    const $ = (id) => document.getElementById(id);
    const ars = (n) => MONEDA + Math.round(n || 0).toLocaleString(NUM_LOCALE);
    /**
     * Parseo numérico consciente del formato es-AR.
     *
     * Bug que esto arregla: la versión anterior borraba TODOS los puntos para
     * leer el separador de miles, así que un decimal escrito con punto —que es
     * lo que devuelve SIEMPRE un <input type="number">, sin importar el
     * locale— se multiplicaba por diez. En el hub de nafta, "8.5 L/100 km"
     * entraba como 85 y daba 680 litros para 800 km en vez de 68.
     *
     * Regla: si hay coma, la coma manda como decimal y los puntos son miles.
     * Si sólo hay puntos, el último es decimal cuando le siguen 1 o 2 dígitos
     * y no hay más de uno; con 3 dígitos detrás o varios puntos, son miles.
     */
    function num(v) {
      if (typeof v === 'number') return isFinite(v) ? v : 0;
      let t = String(v ?? '').trim().replace(/\s/g, '');
      if (!t) return 0;
      const neg = /^-/.test(t);
      t = t.replace(/[^\d.,]/g, '');
      if (PUNTO_DECIMAL) {
        // en-US y afines: la coma es separador de miles y el punto es decimal.
        t = t.replace(/,/g, '');
        const puntos = (t.match(/\./g) || []).length;
        if (puntos > 1) t = t.replace(/\./g, '');
      } else if (t.includes(',')) {
        t = t.replace(/\./g, '').replace(',', '.');
      } else {
        const puntos = (t.match(/\./g) || []).length;
        if (puntos > 1) t = t.replace(/\./g, '');
        else if (puntos === 1) {
          const dec = t.split('.')[1] || '';
          if (dec.length === 3) t = t.replace('.', ''); // 1.500 = mil quinientos
        }
      }
      const n = Number(t);
      return isFinite(n) ? (neg ? -n : n) : 0;
    }

    let current = HAS_CASES ? CASES[0] : null;
    let computeFn = null;

    /** Valores de los campos, ya parseados. */
    function values() {
      const out = {};
      document.querySelectorAll('[data-field]').forEach((el) => {
        if (el.type === 'number') {
          // El navegador ya normaliza a punto decimal y sin miles.
          const n = Number(el.value);
          out[el.id] = el.value === '' ? 0 : (isFinite(n) ? n : 0);
        } else {
          out[el.id] = el.dataset.thousands ? num(el.value) : el.value;
        }
      });
      return out;
    }

    const TONES = {
      main: 'var(--hc-blue)', exit: 'var(--hc-good)', prop: '#f4b942',
      good: 'var(--hc-good)', warn: 'var(--hc-attn)', bad: '#c0392b',
    };

    /**
     * Formatea un número según el hub. La mayoría son plata, pero los de
     * fechas, salud o conversores devuelven cantidades: si les ponés "$"
     * adelante la página miente.
     */
    function fmt(n, o) {
      const dec = (o && o.decimals) || 0;
      const val = Number(n || 0).toLocaleString(NUM_LOCALE, {
        minimumFractionDigits: dec, maximumFractionDigits: dec,
      });
      const f = (o && o.format) || 'ars';
      if (f === 'ars') return MONEDA + val;
      if (f === 'unit' && o && o.unit) return val + ' ' + o.unit;
      return val;
    }

    function paint(res) {
      if (!res) return;
      // Formato por defecto del resultado; cada fila puede pisarlo.
      const base = { format: res.format, unit: res.unit, decimals: res.decimals };
      const f = (v, over) => fmt(v, Object.assign({}, base, over || {}));
      const totalEl = $('total');
      totalEl.textContent = res.total;
      totalEl.style.setProperty('--amount-len', Math.max(7, res.total.length));
      $('sub').textContent = res.sub || '';

      // --- gráfico ---
      // El tipo lo declara el hub en chart.type y viaja en data-chart. Un donut
      // sirve para composición; para "dónde caigo yo" (IMC, semana de embarazo,
      // tramo de Ganancias) hace falta una barra con posición marcada.
      const viz = document.querySelector('.result-viz');
      const kind = viz.dataset.chart || 'donut';
      const segs = res.chart || [];
      const sum = segs.reduce((a, s) => a + (s.value || 0), 0);
      const color = (s, i) => TONES[s.tone || ['main', 'exit', 'prop'][i % 3]];
      const donut = $('result-donut');
      const POSITIONAL = kind === 'scale' || kind === 'timeline' || kind === 'progress' || kind === 'steps';

      viz.classList.toggle('is-positional', POSITIONAL);

      if (POSITIONAL) {
        // Barra horizontal con las franjas y un marcador en `position`.
        const total = segs.reduce((a, s) => a + ((s.to ?? 0) - (s.from ?? 0)), 0);
        const useRange = total > 0;
        let acc = 0;
        const parts = segs.map((s, i) => {
          const w = useRange ? ((s.to - s.from) / total) * 100 : (sum ? (s.value / sum) * 100 : 100 / segs.length);
          const from = acc; acc += w;
          return `${color(s, i)} ${from}% ${acc}%`;
        });
        donut.style.background = parts.length ? `linear-gradient(90deg, ${parts.join(',')})` : 'var(--hc-rule)';
        donut.style.setProperty('--pos', Math.min(100, Math.max(0, res.position ?? 0)) + '%');
        donut.dataset.poslabel = res.positionLabel || '';
      } else {
        let acc = 0;
        const stops = segs.map((s, i) => {
          const from = acc;
          acc += sum ? (s.value / sum) * 100 : 0;
          return `${color(s, i)} ${from}% ${acc}%`;
        });
        donut.style.background = stops.length ? `conic-gradient(${stops.join(',')})` : 'conic-gradient(var(--hc-rule) 0 100%)';
      }

      donut.setAttribute('aria-label',
        res.positionLabel || segs.map((s) => `${s.label} ${sum ? Math.round(s.value / sum * 100) : 0}%`).join(', ') || 'Sin datos');
      $('donut-center').textContent = res.total;

      const legend = $('viz-legend');
      legend.replaceChildren();
      segs.forEach((s, i) => {
        const li = document.createElement('li');
        const dot = document.createElement('span');
        dot.className = 'viz-dot';
        dot.style.background = color(s, i);
        const name = document.createElement('span');
        name.className = 'viz-name';
        name.textContent = s.label;
        const val = document.createElement('span');
        val.className = 'viz-value';
        val.textContent = POSITIONAL && s.from != null ? `${s.from}–${s.to}` : f(s.value);
        li.append(dot, name, val);
        legend.appendChild(li);
      });

      // --- desglose ---
      const bd = $('breakdown');
      bd.replaceChildren();
      const rows = res.rows || [];
      const max = Math.max(...rows.map((r) => r.v), 1);
      rows.forEach((r) => {
        const w = r.v / max;
        const d = document.createElement('div');
        d.className = 'row' + (r.extra ? ' extra' : '') + (w >= 0.75 ? ' major' : w < 0.12 ? ' minor' : '');
        d.style.setProperty('--share', Math.max(3, w * 100) + '%');
        const k = document.createElement('span'); k.className = 'k'; k.textContent = r.k;
        const v = document.createElement('span'); v.className = 'v';
        v.textContent = f(r.v, { format: r.format, unit: r.unit, decimals: r.decimals });
        if (r.ref) {
          const a = document.createElement('span'); a.className = 'art'; a.textContent = r.ref;
          d.append(k, a, v);
        } else {
          d.append(k, v);
        }
        bd.appendChild(d);
      });
    }

    function run() {
      if (computeFn) paint(computeFn(values(), current));
    }

    function fill(el, arr) {
      el.replaceChildren();
      (arr || []).forEach((t) => {
        const li = document.createElement('li');
        li.textContent = t;
        el.appendChild(li);
      });
    }

    function select(c) {
      current = c;
      $('default-case')?.setAttribute('aria-selected', c.id === CASES[0].id ? 'true' : 'false');
      document.querySelectorAll('.opt').forEach((b) =>
        b.setAttribute('aria-selected', b.dataset.case === c.id ? 'true' : 'false'));
      fill($('yes-list'), c.yes);
      fill($('warn-list'), c.warn);
      $('plazo').textContent = c.plazo;
      $('calc-name').textContent = c.label;
      $('answer-title').textContent = c.answer;
      $('answer-copy').textContent = c.yes[0] || '';
      document.querySelector('.other-cases')?.classList.toggle('has-alt', c.id !== CASES[0].id);
      run();
    }

    if (HAS_CASES) {
      $('default-case')?.addEventListener('click', () => select(CASES[0]));
      document.querySelectorAll('.opt').forEach((b) =>
        b.addEventListener('click', () => select(CASES.find((c) => c.id === b.dataset.case))));
      select(CASES[0]);
    }

    $('go').addEventListener('click', () => {
      run();
      document.querySelector('.result-panel').scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start',
      });
    });

    document.querySelectorAll('[data-field]').forEach((el) => el.addEventListener('input', run));
    document.querySelectorAll('[data-thousands]').forEach((el) =>
      el.addEventListener('input', (e) => {
        const v = num(e.target.value);
        e.target.value = v ? v.toLocaleString(NUM_LOCALE) : '';
      }));

    window.HC_HUB = {
      onCompute(fn) { computeFn = fn; },
      values, ars, num,
      currentCase: () => current,
    };

    // Estado inicial deliberado: $0 hasta que el usuario aprieta el botón.
    // Ver types.ts — es una decisión de producto, no un bug.
    $('total').style.setProperty('--amount-len', 7);
    $('sub').textContent = 'Actualizá la estimación para ver el resultado.';
  })();
</script>
