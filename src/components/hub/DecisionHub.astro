---
/**
 * Router visual de los hubs.
 *
 * Los hubs EN con mockup aprobado conservan su página, metadata, schema,
 * header y footer originales, pero renderizan literalmente la experiencia
 * aprobada. El resto continúa usando el hub clásico.
 */
import type { HubData } from '../../lib/hubs/types';
import ApprovedMockupPage from '../ApprovedMockupPage.astro';
import DecisionHubClassic from './DecisionHubClassic.astro';
import HubEditorialSupport from './HubEditorialSupport.astro';
import enCoreStyles from '../../mockups/approved/en-mockup-core.css?raw';
import ptCoreStyles from '../../mockups/approved/pt-mockup-core.css?raw';
import ptPtCoreStyles from '../../mockups/approved/pt-pt-mockup-core.css?raw';
import clCoreStyles from '../../mockups/approved/cl-mockup-core.css?raw';
import esMxCoreStyles from '../../mockups/approved/es-mx-individual-core.css?raw';
import latamCoreStyles from '../../mockups/approved/latam-58-core.css?raw';
import latamCountryStyles from '../../mockups/approved/latam-country-canvas.css?raw';
import latamCountryScript from '../../mockups/approved/latam-country-canvas.js?raw';

export interface Props {
  data: HubData;
}

const { data } = Astro.props;
const fullCalculation = ["en/math/algebra", "en/math/geometry-trigonometry"].includes(data.slug);
const approved = import.meta.glob('../../mockups/approved/en/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const approvedPt = import.meta.glob('../../mockups/approved/pt/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const approvedPtPt = import.meta.glob('../../mockups/approved/pt-pt/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const approvedCl = import.meta.glob('../../mockups/approved/cl/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const approvedEs = import.meta.glob('../../mockups/approved/es/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const approvedMx = import.meta.glob('../../mockups/approved/mx/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const approvedPe = import.meta.glob('../../mockups/approved/pe/*.html', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const approvedCo = import.meta.glob('../../mockups/approved/co/*.html', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const approvedPy = import.meta.glob('../../mockups/approved/py/*.html', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const approvedUy = import.meta.glob('../../mockups/approved/uy/*.html', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const approvedEc = import.meta.glob('../../mockups/approved/ec/*.html', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const approvedDo = import.meta.glob('../../mockups/approved/do/*.html', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const approvedVe = import.meta.glob('../../mockups/approved/ve/*.html', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const leaf = data.slug.split('/').filter(Boolean).at(-1);
const source = !leaf
  ? undefined
  : data.locale === 'en'
    ? approved[`../../mockups/approved/en/${leaf}.html`]
    : data.locale === 'pt'
      ? approvedPt[`../../mockups/approved/pt/${leaf}.html`]
      : data.locale === 'pt-pt'
        ? approvedPtPt[`../../mockups/approved/pt-pt/${leaf}.html`]
        : data.locale === 'cl'
          ? approvedCl[`../../mockups/approved/cl/${leaf}.html`]
          : data.locale === 'es'
            ? approvedEs[`../../mockups/approved/es/${leaf}.html`]
            : data.locale === 'mx'
              ? approvedMx[`../../mockups/approved/mx/${leaf}.html`]
              : data.locale === 'pe'
                ? approvedPe[`../../mockups/approved/pe/${leaf}.html`]
                : data.locale === 'co'
                  ? approvedCo[`../../mockups/approved/co/${leaf}.html`]
                  : data.locale === 'py'
                    ? approvedPy[`../../mockups/approved/py/${leaf}.html`]
                    : data.locale === 'uy'
                      ? approvedUy[`../../mockups/approved/uy/${leaf}.html`]
                      : data.locale === 'ec'
                        ? approvedEc[`../../mockups/approved/ec/${leaf}.html`]
                        : data.locale === 'do'
                          ? approvedDo[`../../mockups/approved/do/${leaf}.html`]
                          : data.locale === 've'
                            ? approvedVe[`../../mockups/approved/ve/${leaf}.html`]
              : undefined;
const baseStyles = data.locale === 'pt'
  ? ptCoreStyles
  : data.locale === 'pt-pt'
    ? ptPtCoreStyles
    : data.locale === 'cl'
      ? clCoreStyles
      : data.locale === 'es' || data.locale === 'mx'
        ? esMxCoreStyles
        : ['pe', 'co', 'py', 'uy', 'ec', 'do', 've'].includes(data.locale)
          ? latamCoreStyles + (['uy', 'ec', 'do', 've'].includes(data.locale) ? '\n' + latamCountryStyles : '')
        : enCoreStyles;
const sharedScript = ['uy', 'ec', 'do', 've'].includes(data.locale) ? latamCountryScript : '';
const ssrTitle = ['uy', 'ec', 'do', 've'].includes(data.locale ?? '') ? data.h1 : '';
// El canvas compartido toma el H1 SSR como placeholder y lo reutiliza al
// hidratar. Así el HTML inicial es indexable sin duplicar títulos en vivo.
const sourceHasH1 = !!source && (
  /<h1\b/i.test(source) ||
  Boolean(ssrTitle)
);
---

{source
  ? (
    <>
      <ApprovedMockupPage source={source} baseStyles={baseStyles} sharedScript={sharedScript} seoTitle={ssrTitle} />
      {fullCalculation ? <DecisionHubClassic data={data} supplemental /> : <HubEditorialSupport data={data} renderH1={!sourceHasH1} />}
    </>
  )
  : <DecisionHubClassic data={data} />
}
