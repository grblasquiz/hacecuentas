---
/**
 * Página de silo: lista los hubs de decisión de una vertical.
 *
 * Existe por dos motivos concretos:
 *  1. Los breadcrumbs de los hubs apuntan acá. Sin esta página son un 404 y el
 *     BreadcrumbList del JSON-LD queda roto en todas las páginas del silo.
 *  2. Es el nodo que reparte link equity entre los hubs hermanos. Con ~250 URLs
 *     en todo el sitio, home → silo → hub deja todo a dos clics.
 *
 * No lleva calculadora: es navegación y contexto. El contenido sale del
 * registry, así que un hub nuevo aparece solo.
 */
import '../../styles/hub.css';
import type { HubData } from '../../lib/hubs/types';

export interface Props {
  silo: string;
  href: string;
  /** Qué resuelve esta vertical, en una frase. */
  lede: string;
  hubs: HubData[];
}
const { silo, href, lede, hubs } = Astro.props;

const totalCalcs = hubs.reduce((a, h) => a + (h.replaces?.length ?? 0), 0);
const locale = href.split('/').filter(Boolean)[0] || 'ar';
const isPortuguese = locale === 'pt' || locale === 'pt-pt';
const isEnglish = locale === 'en';
const topic = silo.toLocaleLowerCase();
const topicAdvice = /impuest|tribut|tax/.test(topic)
  ? 'Revisá el período fiscal, la jurisdicción y la fuente normativa: una misma cuenta puede cambiar por topes, deducciones o actualizaciones oficiales.'
  : /trabaj|emple|salari|labor/.test(topic)
    ? 'Tené a mano el período trabajado, la remuneración y los conceptos variables. Distinguí siempre importes brutos, descuentos y resultado neto.'
    : /finan|crédit|prest|ahorr/.test(topic)
      ? 'Compará tasa, plazo, moneda y costo total. Una cuota más baja no siempre implica una alternativa más económica durante toda la operación.'
      : /auto|veh|motor/.test(topic)
        ? 'Comprobá modelo, antigüedad, jurisdicción y fecha de referencia. Patentes, gastos y valuaciones pueden variar según dónde esté radicado el vehículo.'
        : /hogar|viviend|casa/.test(topic)
          ? 'Separá precio, gastos iniciales y costos periódicos. Para comparar alternativas, usá siempre la misma moneda y el mismo horizonte de tiempo.'
          : 'Definí primero qué dato querés obtener, reuní las variables del caso y compará alternativas con el mismo período y la misma unidad.';

// El índice no debe ser una plantilla genérica repetida en decenas de mercados.
// Estas síntesis salen del contenido editorial propio de cada hub: pregunta,
// variables y fuentes. Así cada silo funciona como un mapa de decisión real.
const decisionMap = hubs.slice(0, 4).map((hub) => ({
  question: hub.h1,
  inputs: hub.fields.slice(0, 3).map((field) => field.label),
  source: hub.sources[0]?.publisher || hub.sources[0]?.name,
  takeaway: hub.answer?.copy || hub.cases?.intro || hub.lede,
}));
---

<div class="hc-hub">
  <div class="wrap">
    <nav class="crumbs" aria-label="Migas">
      <a href="/">Inicio</a><span aria-hidden="true">›</span>
      <span aria-current="page">{silo}</span>
    </nav>

    <header class="decision-hero">
      <div class="hero-copy">
        <p class="eyebrow">{silo}</p>
        <h1>{silo}</h1>
        <p class="lede">{lede}</p>
        <p class="stamp">
          <span>{hubs.length} {hubs.length === 1 ? 'herramienta' : 'herramientas'}</span>
          <span class="dot"></span>
          <span>{totalCalcs} calculadoras adentro</span>
        </p>
      </div>
    </header>

    <main class="journey">
      <section class="panel case-panel" style="grid-column: 1 / -1;">
        <div class="panel-head">
          <p class="panel-kicker">Elegí tu pregunta</p>
          <h2>¿Qué necesitás resolver?</h2>
        </div>
        <div class="picker">
          {hubs.map((h) => (
            <a class="opt" href={`/${h.slug}`}>
              <b>{h.h1}</b>
              <p>{h.description}</p>
              <span>{h.replaces?.length ?? 0} calculadoras</span>
            </a>
          ))}
        </div>
        {hubs.length === 0 && (
          <p class="fineprint">Todavía no hay herramientas publicadas en esta sección.</p>
        )}
      </section>

      <section class="panel silo-guide" style="grid-column: 1 / -1;">
        {isPortuguese ? (
          <>
            <div class="panel-head">
              <p class="panel-kicker">Guia da secção</p>
              <h2>Como escolher e interpretar uma ferramenta</h2>
            </div>
            <p>{lede}</p>
          </>
        ) : isEnglish ? (
          <>
            <div class="panel-head">
              <p class="panel-kicker">Section guide</p>
              <h2>How to choose and interpret a tool</h2>
            </div>
            <p>{lede}</p>
          </>
        ) : (
          <>
            <div class="panel-head">
              <p class="panel-kicker">Guía de la sección</p>
              <h2>Cómo elegir y usar estas herramientas</h2>
            </div>
            <p>{lede}</p>
            <p>{topicAdvice}</p>
          </>
        )}

        <div class="decision-map">
          {decisionMap.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.takeaway}</p>
              {item.inputs.length > 0 && <p><strong>Datos para la cuenta:</strong> {item.inputs.join(', ')}.</p>}
              {item.source && <p><strong>Referencia:</strong> {item.source}.</p>}
            </article>
          ))}
        </div>
      </section>
    </main>
  </div>
</div>

<style>
  /* El selector de casos es un <button>; acá son links. Igual apariencia. */
  .hc-hub .picker a.opt { text-decoration: none; align-items: flex-start; }
  .hc-hub .picker a.opt p {
    margin: 6px 0;
    color: var(--hc-muted);
    font-size: 0.92rem;
    line-height: 1.45;
    font-weight: 400;
  }
  .hc-hub .silo-guide p {
    max-width: 78ch;
    color: var(--hc-muted);
    line-height: 1.7;
  }
  .hc-hub .decision-map {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin-top: 22px;
  }
  .hc-hub .decision-map article {
    border: 1px solid var(--hc-border);
    border-radius: 14px;
    padding: 16px;
    background: var(--hc-surface);
  }
  .hc-hub .decision-map h3 { margin: 0 0 8px; font-size: 1rem; }
  .hc-hub .decision-map p { margin: 7px 0 0; font-size: .9rem; }
</style>
