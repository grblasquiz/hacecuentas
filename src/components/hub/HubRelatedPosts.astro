---
/** Guías del tema: combina la selección del hub con su relación editorial
 * primaria. Footer lo integra también en las páginas con diseño propio. */
import backlinks from '../../lib/blog-backlinks.json';
import { ALL_HUBS } from '../../lib/hubs/registry';
interface Props { path: string }
const { path } = Astro.props;

const key = path.replace(/^\//, '').replace(/\.html$/, '').replace(/\/$/, '');
const declared = ALL_HUBS.find(h => h.slug === key)?.relatedPosts ?? [];
const related = (backlinks as Record<string, Array<{slug:string; title:string}>>)[key] ?? [];
const items = [...declared, ...related.map(p => ({href:`/blog/${p.slug}`,title:p.title,note:''}))]
  .filter((p,i,all) => p.href && !p.href.includes('undefined') && all.findIndex(x=>x.href===p.href)===i).slice(0,8);
---

{items.length > 0 && (
  <nav class="hub-posts" data-hc-blog-guides aria-label="Notas relacionadas">
    <p>Para entrar en detalle</p>
    <div>
      {items.map((p) => (
        <a href={p.href}>
          <strong>{p.title}</strong>
          {p.note && <small>{p.note}</small>}
        </a>
      ))}
    </div>
  </nav>
)}

<style>
  /* Mismo chasis que .cluster-links de DecisionHub, con nota al pie para que se
     lea como "profundizar" y no como otra herramienta más. */
  .hub-posts {
    margin: 28px auto;
    max-width: 1100px;
    padding: 24px;
    border: 1px solid var(--hc-rule, #dbe3ed);
    border-radius: 18px;
    background: var(--hc-paper, #fff);
  }
  .hub-posts p { margin: 0 0 14px; font-weight: 800; }
  .hub-posts div {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 10px;
  }
  .hub-posts a { display: block; color: var(--hc-text, #14233a); text-decoration: none; line-height: 1.35; }
  .hub-posts a:hover strong { text-decoration: underline; }
  .hub-posts strong { display: block; font-weight: 700; }
  .hub-posts small { display: block; margin-top: 3px; color: var(--hc-muted, #738196); font-size: .85rem; }
</style>
