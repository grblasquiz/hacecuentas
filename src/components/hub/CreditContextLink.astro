---
interface Props { debt?: boolean }
const { debt = false } = Astro.props;
---
<aside class="credit-context"><strong>{debt ? 'Antes de refinanciar o pedir otro crédito' : 'Antes de solicitar el préstamo'}</strong><p><a href="/finanzas-personales/perfil-crediticio#pasos-perfil-crediticio">Revisá tu perfil crediticio y la Central de Deudores del BCRA</a>. Contrastá la información publicada con tus cuotas y tu presupuesto antes de asumir un compromiso nuevo.</p></aside>
<style>.credit-context{max-width:1120px;margin:24px auto;padding:24px;background:#f5f7f5;border:1px solid #d7e1df;border-radius:20px;color:#182a32;line-height:1.6}.credit-context a{color:#174b7a;font-weight:750;text-underline-offset:3px}.credit-context p{margin:8px 0 0}@media(max-width:1160px){.credit-context{margin:24px 20px}}</style>
