---
import type { HubData, HubCitableStat } from '../../lib/hubs/types';


export interface Props { data: HubData }
const { data } = Astro.props;

type Copy = {
  eyebrow: string; title: string; intro: string; scenarios: string; variables: string;
  sources: string; tools: string; quote: string; reviewed: string; method: string;
  research: string; percentile: string; publishers: string; dataset: string; cohort: string; report: string;
};
const COPY: Record<string, Copy> = {
  ar: {
    eyebrow: 'Datos citables', title: 'Datos de referencia',
    intro: 'Estas cifras salen del alcance editorial y las fuentes declaradas en este hub. Se pueden auditar y citar con atribución a Hacé Cuentas.',
    scenarios: 'escenarios de decisión', variables: 'variables editables', sources: 'fuentes verificables', tools: 'rutas consolidadas',
    quote: 'Cita sugerida', reviewed: 'Datos revisados', method: 'Cómo se construyeron estos datos',
    research: 'Investigación propia', percentile: 'percentil de profundidad temática', publishers: 'organismos o editores distintos', dataset: 'Descargar dataset (CSV)', cohort: 'comparado con hubs de esta temática', report: 'Estadísticas de calculadoras online 2026',
  },
  es: {
    eyebrow: 'Datos citables', title: 'Datos de referencia',
    intro: 'Estas cifras proceden del alcance editorial y las fuentes declaradas en este hub. Se pueden auditar y citar con atribución a Hacé Cuentas.',
    scenarios: 'escenarios de decisión', variables: 'variables editables', sources: 'fuentes verificables', tools: 'rutas consolidadas',
    quote: 'Cita sugerida', reviewed: 'Datos revisados', method: 'Cómo se construyeron estos datos',
    research: 'Investigación propia', percentile: 'percentil de profundidad temática', publishers: 'organismos o editores distintos', dataset: 'Descargar dataset (CSV)', cohort: 'comparado con hubs de esta temática', report: 'Estadísticas de calculadoras online 2026',
  },
  en: {
    eyebrow: 'Citable data', title: 'Reference data',
    intro: 'These figures come from the editorial scope and sources declared for this hub. They are auditable and may be cited with attribution to Hacé Cuentas.',
    scenarios: 'decision scenarios', variables: 'editable variables', sources: 'verifiable sources', tools: 'consolidated routes',
    quote: 'Suggested citation', reviewed: 'Data reviewed', method: 'How these figures were produced',
    research: 'Original research', percentile: 'topic depth percentile', publishers: 'distinct publishers or agencies', dataset: 'Download dataset (CSV)', cohort: 'compared with hubs in this topic', report: 'Online calculator statistics 2026',
  },
  pt: {
    eyebrow: 'Dados citáveis', title: 'Dados de referência',
    intro: 'Estes números vêm do escopo editorial e das fontes declaradas neste hub. Podem ser auditados e citados com atribuição ao Hacé Cuentas.',
    scenarios: 'cenários de decisão', variables: 'variáveis editáveis', sources: 'fontes verificáveis', tools: 'rotas consolidadas',
    quote: 'Citação sugerida', reviewed: 'Dados revisados', method: 'Como estes dados foram construídos',
    research: 'Pesquisa própria', percentile: 'percentil de profundidade temática', publishers: 'organismos ou editores distintos', dataset: 'Baixar dataset (CSV)', cohort: 'comparado com hubs deste tema', report: 'Estatísticas de calculadoras online 2026',
  },
};
COPY['pt-pt'] = COPY.pt;
const lang = data.locale === 'en' ? 'en' : data.locale === 'pt' || data.locale === 'pt-pt' ? data.locale : data.locale ? 'es' : 'ar';
const T = COPY[lang];
// Only publish substantive figures explicitly supplied with traceable sources.
// Counts in the editorial model do not prove which controls are usable.
const stats = (data.citableStats ?? []).filter(stat => stat.source);
const sectionId = `datos-citables-${data.slug.replaceAll('/', '-')}`;
---

{stats.length > 0 && <section class="hub-citable-stats" aria-labelledby={sectionId}>
  <div class="hub-citable-stats__head">
    <p>{T.eyebrow}</p>
    <h2 id={sectionId}>{T.title}</h2>
    <p>{T.intro}</p>
  </div>
  <dl>
    {stats.map((stat) => (
      <div>
        <dt>{stat.label}</dt>
        <dd>{stat.value}</dd>
        {stat.detail && <p>{stat.detail}</p>}
        {stat.source && <a href={stat.source} rel="noopener noreferrer">{T.sources}</a>}
      </div>
    ))}
  </dl>
  <p class="hub-citable-stats__meta">
    <span>{T.reviewed}: <time datetime={data.lastReviewed}>{data.lastReviewed}</time></span>
    <a href="/metodologia">{T.method}</a>
    <a href="/estadisticas-calculadoras-online-2026">{T.report}</a>
    <a href="/datasets/hub-citable-research.csv" download>{T.dataset}</a>
  </p>
</section>}

<style>
  .hub-citable-stats{margin:clamp(2rem,5vw,4rem) auto;padding:clamp(1.35rem,3vw,2rem);max-width:1160px;border:1px solid #dce3e9;border-radius:18px;background:#fff;color:#18283a;box-shadow:0 12px 30px rgba(20,43,67,.06)}
  .hub-citable-stats__head{max-width:760px}.hub-citable-stats__head>p:first-child{margin:0 0 .45rem;color:#23648d;font-size:.75rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}
  .hub-citable-stats h2{margin:0;color:#18283a;font-size:clamp(1.45rem,3vw,2rem);line-height:1.15}.hub-citable-stats__head>p:last-child{color:#526477;line-height:1.65}
  .hub-citable-stats dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.75rem;margin:1.5rem 0}
  .hub-citable-stats dl>div{display:flex;flex-direction:column;padding:1rem;border:1px solid #e1e7ec;border-radius:13px;background:#f7fafc}
  .hub-citable-stats dt{order:2;color:#526477;font-size:.78rem;font-weight:750;line-height:1.3}.hub-citable-stats dd{order:1;margin:0 0 .25rem;color:#173c5d;font-size:clamp(1.55rem,3vw,2.25rem);font-weight:900;line-height:1}
  .hub-citable-stats dl p,.hub-citable-stats dl a{order:3;margin:.45rem 0 0;color:#5c6b7a;font-size:.75rem;line-height:1.4}.hub-citable-stats dl a{color:#23648d;font-weight:750}
  .hub-citable-stats figure{margin:0;padding:1rem 1.1rem;border-left:4px solid #2e7ca7;background:#eef6fa}.hub-citable-stats figcaption{margin-bottom:.4rem;color:#23648d;font-size:.7rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.hub-citable-stats blockquote{margin:0;color:#25384a;font-size:.95rem;font-weight:650;line-height:1.6}
  .hub-citable-stats__meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.75rem;margin:1rem 0 0;color:#667687;font-size:.78rem}.hub-citable-stats__meta a{color:#23648d;font-weight:750}
</style>
