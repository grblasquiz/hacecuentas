---
interface Props { variant: 'ipc'|'pregnancy'|'liquidation'|'sizes'|'nit'|'taxes'|'iibb'|'accident'|'construction'|'account' }
const { variant } = Astro.props;
const content = {
  ipc: { kicker:'Atajos de cálculo', title:'Llegá al período correcto en un toque', copy:'Usá el último IPC oficial publicado. El mes en curso todavía no tiene un dato definitivo.' },
  pregnancy: { kicker:'Resultado útil', title:'Guardá tus próximas fechas', copy:'La fecha probable de parto es orientativa; la datación documentada por tu equipo de salud es la referencia clínica.' },
  liquidation: { kicker:'Control del pago', title:'Compará la cuenta con lo que te ofrecen', copy:'Cargá el importe bruto informado por tu empleador y detectá la diferencia contra la estimación.' },
  sizes: { kicker:'Antes de comprar', title:'Elegí cómo querés que te quede', copy:'Las tablas orientan; cada marca puede variar. Si quedás entre dos talles, el calce ayuda a decidir.' },
  nit: { kicker:'Verificación oficial', title:'Formato válido no significa empresa activa', copy:'El algoritmo confirma el dígito. Para verificar existencia, actividad y estado necesitás consultar el RUT en DIAN.' },
  taxes: { kicker:'Ruta personalizada', title:'¿Qué impuesto necesitás resolver?', copy:'Elegí tu situación y andá directo a las herramientas y datos vigentes que te corresponden.' },
  iibb: { kicker:'Antes de presentar', title:'Separá impuesto, retenciones y saldo', copy:'La alícuota depende de jurisdicción, actividad y régimen. Confirmala siempre en el organismo provincial.' },
  accident: { kicker:'Acción inmediata', title:'Qué guardar desde el primer día', copy:'La atención médica va primero. Después dejá constancia de la denuncia y conservá cada documento.' },
  construction: { kicker:'Rango realista', title:'Probá cuánto cambia tu presupuesto', copy:'Una obra no es una cifra exacta. Compará el escenario base con desvíos de materiales y contingencias.' },
  account: { kicker:'Empezá liviano', title:'No hace falta completar todo el perfil', copy:'Guardá primero los datos que más repetís. Después podés sumar el resto cuando una herramienta lo necesite.' },
}[variant];
---
<section class="ntb" data-ntb={variant} aria-labelledby={`ntb-${variant}`}>
  <div class="ntb-in">
    <header><span>{content.kicker}</span><h2 id={`ntb-${variant}`}>{content.title}</h2><p>{content.copy}</p></header>
    {variant === 'ipc' && <div class="ntb-tools"><button data-months="3">Últimos 3 meses</button><button data-months="6">Últimos 6 meses</button><button data-months="12">Último año</button><a href="/alquiler/aumento-de-alquiler">Comparar IPC, ICL y ajuste fijo →</a></div>}
    {variant === 'pregnancy' && <div class="ntb-grid"><article><b>📅 Próxima semana</b><p>El resultado principal muestra semanas, días, trimestre y fecha probable de parto.</p></article><article><b>🩺 Confirmación clínica</b><p>Con ciclos irregulares, la ecografía temprana suele dar una mejor datación.</p></article><article><b>⚠️ Consulta inmediata</b><p>Ante dolor intenso, sangrado, fiebre o pérdida de líquido, acudí a una guardia.</p></article></div>}
    {variant === 'liquidation' && <div class="ntb-compare"><label>Estimación de la calculadora <span>$</span><input inputmode="numeric" data-est value="850000" /></label><label>Oferta o recibo del empleador <span>$</span><input inputmode="numeric" data-offer value="750000" /></label><output data-diff>Faltan $100.000</output><a href="/trabajo/indemnizacion-por-despido">Si te despidieron, usá la calculadora de despido →</a></div>}
    {variant === 'sizes' && <div class="ntb-tools"><button data-fit="-1">Calce ajustado</button><button class="active" data-fit="0">Calce normal</button><button data-fit="1">Calce holgado</button><p data-fit-copy>Usá el talle que devuelve la tabla y verificá la guía de la marca.</p></div>}
    {variant === 'nit' && <div class="ntb-actions"><a href="https://muisca.dian.gov.co/WebRutMuisca/DefConsultaEstadoRUT.faces" target="_blank" rel="nofollow noopener">Consultar estado del RUT en DIAN ↗</a><p>El NIT base figura en la casilla 5 del RUT y el DV separado en la casilla 6.</p></div>}
    {variant === 'taxes' && <div class="ntb-picker"><label>Mi situación<select data-tax-route><option value="/impuestos/monotributo">Soy monotributista</option><option value="/impuestos/ganancias-cuarta-categoria">Trabajo en relación de dependencia</option><option value="/impuestos/iva">Soy responsable inscripto</option><option value="/impuestos/bienes-personales">Tengo bienes o inversiones</option><option value="/impuestos/ingresos-brutos">Facturo en una provincia</option></select></label><a data-tax-go href="/impuestos/monotributo">Ver herramientas para mi caso →</a></div>}
    {variant === 'iibb' && <div class="ntb-grid"><article><b>1. Impuesto determinado</b><p>Base imponible × alícuota de tu actividad.</p></article><article><b>2. Pagos a cuenta</b><p>Restá retenciones, percepciones y saldos anteriores.</p></article><article><b>3. Saldo final</b><p>Compará contra el mínimo mensual de la jurisdicción.</p></article></div>}
    {variant === 'accident' && <div class="ntb-check"><label><input type="checkbox"/> Número de siniestro</label><label><input type="checkbox"/> Denuncia y carta de rechazo, si existe</label><label><input type="checkbox"/> Estudios, recetas y certificados</label><label><input type="checkbox"/> Recibos y constancias de traslados</label><a href="https://www.argentina.gob.ar/srt/trabajador" target="_blank" rel="noopener">Encontrar mi ART y trámites SRT ↗</a></div>}
    {variant === 'construction' && <div class="ntb-compare"><label>Presupuesto base <span>$</span><input inputmode="numeric" data-base value="120000000" /></label><label>Desvío posible <input type="range" min="0" max="30" value="10" data-risk/><b data-risk-label>10%</b></label><output data-total>Reservá hasta $132.000.000</output><p>Incluye una contingencia para variaciones de materiales, logística y tiempos.</p></div>}
    {variant === 'account' && <div class="ntb-grid"><article><b>1. Guardá lo frecuente</b><p>País, provincia, sueldo y moneda.</p></article><article><b>2. Calculá sin repetir</b><p>Las herramientas compatibles arrancan precargadas.</p></article><article><b>3. Seguí después</b><p>Historial y alertas quedan sincronizados.</p></article></div>}
  </div>
</section>
<script is:inline>
(()=>{document.querySelectorAll('[data-ntb]').forEach(root=>{const money=n=>Math.round(n).toLocaleString('es-AR');const num=v=>Number(String(v||'').replace(/\D/g,''))||0;
root.querySelectorAll('[data-months]').forEach(b=>b.addEventListener('click',()=>{const selects=[...document.querySelectorAll('select')].filter(s=>/mes/i.test(s.getAttribute('aria-label')||s.previousElementSibling?.textContent||''));if(selects.length<2)return;const end=selects[1],opts=[...end.options],idx=Math.max(0,end.selectedIndex+Number(b.dataset.months)-1);selects[0].selectedIndex=Math.min(idx,opts.length-1);selects[0].dispatchEvent(new Event('change',{bubbles:true}))}));
const est=root.querySelector('[data-est]'),offer=root.querySelector('[data-offer]'),diff=root.querySelector('[data-diff]');const compare=()=>{if(!diff)return;const d=num(est.value)-num(offer.value);diff.textContent=d>0?'Faltan $'+money(d):d<0?'La oferta supera por $'+money(-d):'Los importes coinciden'};[est,offer].forEach(x=>x?.addEventListener('input',compare));compare();
root.querySelectorAll('[data-fit]').forEach(b=>b.addEventListener('click',()=>{root.querySelectorAll('[data-fit]').forEach(x=>x.classList.remove('active'));b.classList.add('active');root.querySelector('[data-fit-copy]').textContent=Number(b.dataset.fit)<0?'Si estás entre dos, probá el menor sólo si la tela cede.':Number(b.dataset.fit)>0?'Si estás entre dos, elegí el mayor para ganar holgura.':'Usá el talle que devuelve la tabla y verificá la guía de la marca.'}));
const route=root.querySelector('[data-tax-route]'),go=root.querySelector('[data-tax-go]');route?.addEventListener('change',()=>go.href=route.value);
const base=root.querySelector('[data-base]'),risk=root.querySelector('[data-risk]'),total=root.querySelector('[data-total]'),rl=root.querySelector('[data-risk-label]');const budget=()=>{if(!total)return;rl.textContent=risk.value+'%';total.textContent='Reservá hasta $'+money(num(base.value)*(1+Number(risk.value)/100))};[base,risk].forEach(x=>x?.addEventListener('input',budget));budget();})})();
</script>
<style>
.ntb{padding:54px 20px;background:#f4f8fb}.ntb-in{max-width:1120px;margin:auto;background:#fff;border:1px solid #dbe5ec;border-radius:24px;padding:32px;box-shadow:0 14px 44px #174b7a0d}.ntb header{max-width:760px}.ntb header span{color:#176f8f;text-transform:uppercase;letter-spacing:.13em;font-size:.72rem;font-weight:850}.ntb h2{margin:8px 0;font-size:clamp(1.65rem,3vw,2.35rem);letter-spacing:-.035em;color:#17324a}.ntb p{color:#586b7c;line-height:1.55}.ntb-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px}.ntb-grid article{padding:18px;border:1px solid #dbe5ec;border-radius:15px}.ntb-grid b{color:#17324a}.ntb-grid p{font-size:.9rem;margin:7px 0 0}.ntb-tools,.ntb-actions,.ntb-picker,.ntb-check,.ntb-compare{display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin-top:24px}.ntb button,.ntb a,.ntb select,.ntb input{font:inherit}.ntb button,.ntb a{border:1px solid #bcd0dd;border-radius:11px;padding:11px 15px;background:#fff;color:#174b7a;font-weight:750;text-decoration:none;cursor:pointer}.ntb button.active,.ntb a{background:#174b7a;color:#fff}.ntb label{display:grid;gap:7px;color:#344d61;font-weight:700}.ntb label span{position:absolute;margin:37px 0 0 12px}.ntb input,.ntb select{border:1px solid #bacbd6;border-radius:10px;padding:11px 12px;min-width:210px}.ntb label span+input{padding-left:28px}.ntb output{display:block;background:#e6f4ef;color:#12624f;padding:13px 17px;border-radius:11px;font-weight:850}.ntb-check{align-items:center}.ntb-check label{display:flex;align-items:center;padding:10px;border:1px solid #dbe5ec;border-radius:10px}.ntb-check input{min-width:auto}.ntb-compare p,.ntb-actions p{width:100%;margin:0}@media(max-width:720px){.ntb{padding:34px 12px}.ntb-in{padding:22px 16px}.ntb-grid{grid-template-columns:1fr}.ntb-tools,.ntb-actions,.ntb-picker,.ntb-check,.ntb-compare{align-items:stretch;flex-direction:column}.ntb button,.ntb a,.ntb input,.ntb select,.ntb output{width:100%;min-width:0}}
</style>
