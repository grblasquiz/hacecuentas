---
interface Props { data:any }
const { data } = Astro.props;
import { MNI_MENSUAL_BASE, INCREMENTO_CONYUGE_MENSUAL, INCREMENTO_HIJO_MENSUAL, ESCALA, aplicarEscalaMensual, GNI_ANUAL, DEDUCCION_ESPECIAL_AUTONOMOS_ANUAL } from '../lib/formulas/_ganancias-escala';
---
<div class="gains-experience">
    <section class="hero">
      <div class="wrap crumb"><b>Impuestos</b> &nbsp;/&nbsp; Ganancias cuarta categoría</div>
      <div class="wrap hero-grid">
        <div class="copy">
          <span class="eyebrow">Ganancias 2026</span>
          <h1>¿Cuánto te sacan<br>del sueldo por<br>Ganancias?</h1>
          <p>Calculá la retención mensual, entendé en qué tramo caés y descubrí qué deducciones pueden bajarla.</p>
          <div class="chips"><span>🏛️ Escala ARCA</span><span>📄 Art. 94 LIG</span><span>✓ SiRADIG incluido</span></div>
          <div class="tax-art"><div class="receipt"><div class="receipt-head"><b>Recibo de sueldo</b><span>julio 2026</span></div><div class="retention">−$33.129</div><div class="retention-sub">Retención mensual estimada</div><div class="rline"><span>Neto después de aportes</span><strong>$2.871.871</strong></div></div><div class="arca">ARCA<br>2026</div><span class="base-tag">Base imponible: $414.962</span></div>
        </div>
        <form class="calc">
          <div class="calc-title"><div><h2>Calculá tu retención</h2><p>Empezamos con el descuento mensual.</p></div><span class="tag">Escala vigente</span></div>
          <div class="section-label">¿Qué querés calcular?</div>
          <div class="cases"><button type="button" class="case active" data-tax-case="mensual"><i>💼</i>Sueldo mensual</button><button type="button" class="case" data-tax-case="aguinaldo"><i>🎁</i>Aguinaldo</button><button type="button" class="case" data-tax-case="monotributo"><i>🧾</i>Régimen general</button><button type="button" class="case" data-tax-case="saldo"><i>↩️</i>Saldo a favor</button></div>
          <div class="section-label">Datos principales</div>
          <div class="fields">
            <div class="field wide"><label for="tax-gross">Sueldo bruto o facturación mensual</label><div class="inline"><b>$</b><input id="tax-gross" inputmode="numeric" value="3.500.000"></div></div>
            <div class="field"><label for="tax-spouse">Cónyuge a cargo</label><select id="tax-spouse"><option value="no">No</option><option value="si">Sí</option></select></div>
            <div class="field"><label for="tax-children">Hijos a cargo</label><div class="inline"><input id="tax-children" type="number" min="0" max="10" value="0"><b>hijos</b></div></div>
            <div class="field wide"><label for="tax-deductions">Otras deducciones mensuales en SiRADIG</label><div class="inline"><b>$</b><input id="tax-deductions" inputmode="numeric" value="0"></div></div>
            <div class="field wide tax-extra" hidden><label for="tax-withheld">Retenciones acumuladas del año</label><div class="inline"><b>$</b><input id="tax-withheld" inputmode="numeric" value="0"></div></div>
          </div>
          <div class="advanced"><span>✓ Retenciones anuales y régimen general incluidos</span><b id="tax-case-label">Sueldo mensual</b></div>
          <section class="result">
            <div class="result-top"><div><small id="tax-result-label">Retención mensual estimada</small><div class="price" id="tax-result">$33.129</div></div><div class="rate"><small>Alícuota marginal</small><strong id="tax-rate">12%</strong></div></div>
            <div class="stats"><span>Base imponible<b id="tax-base">$414.962</b></span><span>Alícuota efectiva<b id="tax-effective">0,95%</b></span><span id="tax-net-label">Neto tras aportes e impuesto<b id="tax-net">$2.871.871</b></span></div>
            <button class="go" id="tax-update" type="button">Actualizar retención</button>
          </section>
        </form>
      </div>
    </section>
    <section class="detail wrap">
      <header class="center"><span>Tu sueldo, paso por paso</span><h2>Entendé cómo se arma la base</h2><p>Ganancias no se calcula sobre todo el bruto: primero se restan aportes y deducciones.</p></header>
      <div class="detail-grid">
        <article class="card"><h3>Del bruto a la retención</h3>
          <div class="row"><span>💼 Sueldo bruto</span><div class="bar"><i style="width:100%"></i></div><b id="tax-row-gross">$3.500.000</b></div>
          <div class="row"><span>− Aportes personales</span><div class="bar"><i style="width:17%"></i></div><b id="tax-row-contrib">−$595.000</b></div>
          <div class="row"><span>− Deducciones art. 30</span><div class="bar"><i style="width:71%"></i></div><b id="tax-row-ded">−$2.490.038</b></div>
          <div class="row"><span>= Base imponible</span><div class="bar"><i style="width:12%"></i></div><b id="tax-row-base">$414.962</b></div>
          <div class="total"><strong id="tax-total-label">Retención del mes</strong><strong id="tax-detail-result">$33.129</strong></div>
        </article>
        <article class="card steps"><h3>Escala progresiva del art. 94</h3><div class="stair"><div class="step"><span>Tramo 1</span><b>5%</b></div><div class="step"><span>Tramo 2</span><b>9%</b></div><div class="step active"><span>Tu tramo</span><b>12%</b></div><div class="step"><span>Tramo 4</span><b>15%</b></div><div class="step"><span>Hasta</span><b>35%</b></div></div><div class="tramo-note"><i>💡</i><span>El 12% se aplica sólo al último excedente. Tu tasa efectiva sobre el sueldo completo es mucho menor: 0,95%.</span></div></article>
      </div>
    </section>
    <section class="deductions"><div class="wrap"><div class="ded-head"><div><span>SiRADIG</span><h2>Deducciones que pueden bajar la retención</h2></div><div class="legend">Cargalas durante el año para que impacten en tu recibo</div></div><div class="ded-grid">
      <article class="ded"><i>💍</i><h3>Cónyuge a cargo</h3><p>Siempre que no tenga ingresos superiores al mínimo permitido.</p><b>Hasta $404.330/mes →</b></article>
      <article class="ded"><i>👧</i><h3>Hijos a cargo</h3><p>Menores de 18 años o incapacitados para el trabajo.</p><b>$203.905 por hijo/mes →</b></article>
      <article class="ded"><i>🏠</i><h3>Alquiler de vivienda</h3><p>Hasta el 40% pagado, con el tope anual de la GNI.</p><b>Cargar contrato y facturas →</b></article>
      <article class="ded"><i>🩺</i><h3>Medicina prepaga</h3><p>Cuotas médico-asistenciales tuyas y de tus cargas de familia.</p><b>Con límite del 5% →</b></article>
      <article class="ded"><i>🧹</i><h3>Personal doméstico</h3><p>Remuneraciones y contribuciones del personal registrado.</p><b>Hasta la GNI anual →</b></article>
      <article class="ded"><i>🏦</i><h3>Crédito hipotecario</h3><p>Intereses de créditos destinados a la compra de vivienda.</p><b>Tope anual ARCA →</b></article>
      <article class="ded"><i>🛡️</i><h3>Seguros de vida</h3><p>Primas de vida, retiro privado y fondos de jubilación.</p><b>Con tope específico →</b></article>
      <article class="ded"><i>🤝</i><h3>Donaciones y otros</h3><p>Donaciones admitidas, gastos médicos y aportes a SGR.</p><b>Ver lista completa →</b></article>
    </div></div></section>
    <section class="support wrap"><div><h2>Preguntas frecuentes</h2>{data.faq.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><aside><h2>Fuentes oficiales</h2>{data.sources.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}<small>{s.publisher}</small></a>)}</aside></section>
  </div>

<script is:inline define:vars={{ MNI:MNI_MENSUAL_BASE, SPOUSE:INCREMENTO_CONYUGE_MENSUAL, CHILD:INCREMENTO_HIJO_MENSUAL, SCALE:ESCALA, GNI:GNI_ANUAL, AUTO:DEDUCCION_ESPECIAL_AUTONOMOS_ANUAL }}>
(()=>{const $=id=>document.getElementById(id),num=id=>Number(String($(id).value||'').replace(/\./g,'').replace(',','.').replace(/[^\d.-]/g,''))||0,money=n=>(n<0?'−':'')+'$'+Math.round(Math.abs(n)).toLocaleString('es-AR'),pct=n=>(n*100).toLocaleString('es-AR',{maximumFractionDigits:2})+'%';let kase='mensual';
const tax=base=>{if(base<=0)return{value:0,rate:0};let prev=0;for(const t of SCALE){if(base<=t.hasta)return{value:t.acumulado+(base-prev)*t.tasa,rate:t.tasa};prev=t.hasta}return{value:0,rate:0}};
const calc=()=>{const gross=Math.max(0,num('tax-gross')),spouse=$('tax-spouse').value==='si'?SPOUSE:0,children=Math.max(0,num('tax-children'))*CHILD,other=Math.max(0,num('tax-deductions')),contrib=Math.min(gross,4414652.38)*.17,ded=MNI+spouse+children+other;let base=Math.max(0,gross-contrib-ded),r=tax(base),value=r.value,label='Retención mensual estimada',net=gross-contrib-value,netLabel='Neto tras aportes e impuesto',totalLabel='Retención del mes';
if(kase==='aguinaldo'){const baseSac=Math.max(0,gross*13/12-Math.min(gross*13/12,4414652.38)*.17-ded),withSac=tax(baseSac);value=Math.max(0,withSac.value-r.value);r=withSac;base=baseSac;label='Retención mensual extra por SAC';net=gross*.5-value;netLabel='Aguinaldo neto estimado';totalLabel='Impacto mensual del SAC'}
if(kase==='monotributo'){const annualGross=gross*12,annualBase=Math.max(0,annualGross-GNI-AUTO-other*12),monthlyBase=annualBase/12;r=tax(monthlyBase);value=r.value*12;base=annualBase;label='Ganancias anual estimada';net=annualGross-value;netLabel='Ingreso anual tras Ganancias';totalLabel='Impuesto anual'}
if(kase==='saldo'){const annual=r.value*12,withheld=Math.max(0,num('tax-withheld'));value=withheld-annual;label=value>=0?'Saldo estimado a favor':'Saldo estimado a pagar';net=annual;netLabel='Impuesto anual determinado';totalLabel=label}
$('tax-result-label').textContent=label;$('tax-result').textContent=money(value);$('tax-rate').textContent=pct(r.rate);$('tax-base').textContent=money(base);$('tax-effective').textContent=pct(gross?Math.abs(value)/(kase==='monotributo'?gross*12:gross):0);$('tax-net').textContent=money(net);$('tax-net-label').firstChild.textContent=netLabel;$('tax-row-gross').textContent=money(gross);$('tax-row-contrib').textContent=money(-contrib);$('tax-row-ded').textContent=money(-ded);$('tax-row-base').textContent=money(base);$('tax-total-label').textContent=totalLabel;$('tax-detail-result').textContent=money(value);document.querySelector('.retention').textContent=money(-value);document.querySelector('.base-tag').textContent='Base imponible: '+money(base);document.querySelectorAll('[data-tax-case]').forEach(b=>b.classList.toggle('active',b.dataset.taxCase===kase));document.querySelector('.tax-extra').hidden=kase!=='saldo';$('tax-case-label').textContent={mensual:'Sueldo mensual',aguinaldo:'Aguinaldo',monotributo:'Régimen general',saldo:'Saldo a favor'}[kase]};
document.querySelectorAll('[data-tax-case]').forEach(b=>b.addEventListener('click',()=>{kase=b.dataset.taxCase;calc()}));document.querySelectorAll('.calc input,.calc select').forEach(el=>el.addEventListener('input',calc));$('tax-update').addEventListener('click',()=>{calc();$('tax-update').textContent='Retención actualizada ✓';setTimeout(()=>$('tax-update').textContent='Actualizar retención',1500)});calc()})();
</script>

<style>
    *{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:#12223b;background:#fff}button,input,select{font:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}
    .top{height:88px;border-bottom:1px solid #dfe7ef;display:flex;align-items:center;background:#fff}.nav{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;font-size:18px;font-weight:850}.logo{width:31px;height:31px;border-radius:7px;background:#173452;display:grid;place-items:center;color:#fff;font-size:14px}.links,.tools{display:flex;align-items:center;gap:27px}.links a{font-size:13px;font-weight:700;color:#43526a;text-decoration:none}.tools span{border:1px solid #d9e2eb;border-radius:10px;padding:11px 14px;font-size:12px;font-weight:700}.tools .profile{background:#132844;color:#fff;border-color:#132844}
    .hero{background:linear-gradient(128deg,#f7faff 0%,#f7faff 61%,#f5f3fc 100%);padding:25px 0 62px;overflow:hidden}.crumb{font-size:12px;color:#718299;margin-bottom:33px}.crumb b{color:#1769db}.hero-grid{display:grid;grid-template-columns:.87fr 1.13fr;gap:54px;align-items:start}.copy{padding-top:5px}.eyebrow{font-size:11px;font-weight:850;letter-spacing:.14em;text-transform:uppercase;color:#1770e6;display:flex;align-items:center;gap:9px}.eyebrow:before{content:"";width:28px;height:2px;background:#1770e6}.copy h1{font-size:52px;line-height:1.04;letter-spacing:-.052em;margin:18px 0;color:#0e1d36}.copy>p{font-size:17px;line-height:1.65;color:#5f7187;max-width:490px}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:23px}.chips span{background:#fff;border:1px solid #dbe5ef;border-radius:9px;padding:9px 11px;color:#53677e;font-size:10px}
    .tax-art{height:230px;margin-top:18px;position:relative}.receipt{position:absolute;left:69px;top:22px;width:220px;height:176px;background:#fff;border:1px solid #d8e4ee;border-radius:17px;box-shadow:0 24px 48px #17385815;padding:24px}.receipt-head{display:flex;justify-content:space-between;align-items:center}.receipt-head b{font-size:11px}.receipt-head span{font-size:8px;color:#7352b8;background:#f1ecfc;padding:5px 8px;border-radius:99px}.retention{font-size:27px;font-weight:900;color:#173858;margin:18px 0 4px}.retention-sub{font-size:9px;color:#75879b}.rline{display:flex;justify-content:space-between;border-top:1px solid #e2e9ef;margin-top:15px;padding-top:11px;font-size:9px}.rline strong{color:#d05648}.arca{position:absolute;right:46px;bottom:7px;width:74px;height:74px;border-radius:50%;background:#7352b8;color:#fff;border:7px solid #f4f0fb;display:grid;place-items:center;text-align:center;font-size:9px;font-weight:850}.base-tag{position:absolute;left:17px;bottom:20px;background:#e9f8f1;color:#14734b;border:1px solid #c9eadc;border-radius:9px;padding:9px 11px;font-size:10px;font-weight:800}
    .calc{background:#fff;border:1px solid #d9e4ed;border-radius:20px;padding:26px 29px;box-shadow:0 25px 60px #173b6418;position:relative;z-index:2}.calc-title{display:flex;justify-content:space-between;gap:20px}.calc h2{font-size:23px;margin:0 0 4px}.calc-title p{font-size:10px;color:#6b7d91;margin:0}.tag{font-size:9px;color:#7352b8;background:#f1ecfc;border-radius:99px;padding:7px 10px;font-weight:800;height:max-content;white-space:nowrap}.section-label{font-size:10px;font-weight:850;color:#293b53;margin:17px 0 8px}.cases{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.case{border:1px solid #dce5ee;background:#fff;border-radius:10px;padding:9px 6px;color:#5d7188;font-size:9px;font-weight:750;min-height:63px}.case i{display:block;font-style:normal;font-size:17px;margin-bottom:3px}.case.active{border:2px solid #7352d6;background:#f5f2ff;color:#6242bb}.fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.field{border:1px solid #dbe4ed;border-radius:10px;padding:9px 11px;min-height:57px}.field.wide{grid-column:span 2}.field label{display:block;color:#77879a;font-size:8px;margin-bottom:5px}.field input,.field select{border:0;outline:0;background:none;width:100%;color:#142641;font-weight:750;font-size:13px}.inline{display:flex;align-items:center;gap:5px}.inline b{font-size:12px}.advanced{display:flex;justify-content:space-between;margin:11px 0;color:#65788d;font-size:9px}.advanced b{color:#7352b8}.result{background:#172f4f;color:#fff;border-radius:15px;padding:18px 20px}.result-top{display:flex;align-items:start;justify-content:space-between}.result small{font-size:9px;color:#b9cbdd}.price{font-size:34px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.rate{background:#f1ecfc;color:#6849b5;border-radius:9px;padding:8px 11px;text-align:right}.rate strong{display:block;font-size:15px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #375675;padding-top:12px;margin-top:13px}.stats span{font-size:8px;color:#afc0d1}.stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.go{width:100%;border:0;border-radius:9px;background:#7352d6;color:#fff;font-weight:800;padding:12px;margin-top:14px}
    .detail{padding:74px 0 67px}.center{text-align:center;max-width:720px;margin:0 auto 36px}.center span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#7352d6;font-weight:850}.center h2{font-size:36px;letter-spacing:-.04em;margin:10px 0}.center p{color:#687a8f;line-height:1.6}.detail-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:20px}.card{border:1px solid #dce5ee;border-radius:16px;padding:25px;box-shadow:0 10px 27px #1738580b}.card h3{font-size:18px;margin:0 0 19px}.row{display:grid;grid-template-columns:165px 1fr 105px;align-items:center;gap:14px;margin:16px 0}.row span{font-size:10px;font-weight:750}.bar{height:8px;background:#edf2f6;border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;border-radius:99px;background:#2878e8}.row:nth-child(2) .bar i{background:#20a06b}.row:nth-child(3) .bar i{background:#7352d6}.row:nth-child(4) .bar i{background:#d45b4e}.row b{text-align:right;font-size:12px}.total{display:flex;justify-content:space-between;border-top:1px solid #e1e7ee;margin-top:20px;padding-top:17px}.total strong:last-child{color:#7352b8;font-size:19px}
    .steps{background:#f8fbfe}.stair{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;align-items:end;height:145px;padding:12px 5px 0}.step{border-radius:9px 9px 3px 3px;background:#e7eff8;position:relative}.step:nth-child(1){height:38px}.step:nth-child(2){height:58px}.step:nth-child(3){height:78px;background:#cfc3f3}.step:nth-child(4){height:102px}.step:nth-child(5){height:128px}.step b{position:absolute;bottom:8px;left:0;right:0;text-align:center;font-size:10px}.step span{position:absolute;top:-17px;left:0;right:0;text-align:center;font-size:8px;color:#6d7e91}.step.active{background:#7352d6;color:#fff;box-shadow:0 8px 18px #7352d633}.tramo-note{background:#fff7e8;border:1px solid #efd7a5;border-radius:12px;padding:14px;margin-top:16px;display:flex;gap:10px;color:#76541d;font-size:10px;line-height:1.55}.tramo-note i{font-style:normal;font-size:18px}
    .deductions{background:#f6f4fb;padding:69px 0}.ded-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:27px}.ded-head h2{font-size:34px;letter-spacing:-.04em;margin:8px 0 0}.ded-head>div>span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#7352d6;font-weight:850}.legend{font-size:9px;color:#64778d}.ded-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.ded{background:#fff;border:1px solid #dce5ee;border-radius:13px;padding:17px;min-height:132px}.ded i{font-style:normal;font-size:21px}.ded h3{font-size:12px;margin:10px 0 4px}.ded p{font-size:8px;color:#77899c;line-height:1.5;margin:0}.ded b{display:block;color:#7352b8;font-size:10px;margin-top:12px}.support{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;padding:70px 0}.support h2{font-size:24px}.support details{border-bottom:1px solid #dfe6ed;padding:14px 0}.support summary{font-size:12px;font-weight:750;cursor:pointer}.support p{font-size:11px;line-height:1.65;color:#687a8f}.support a{display:block;border:1px solid #dce5ee;border-radius:10px;padding:12px;margin:8px 0;color:#7352d6;text-decoration:none;font-size:10px;font-weight:700}.support small{display:block;color:#78899c;margin-top:4px}
    @media(max-width:800px){.links{display:none}.hero-grid,.detail-grid,.support{grid-template-columns:1fr}.copy{text-align:center}.copy h1{font-size:40px}.eyebrow,.chips{justify-content:center}.tax-art{max-width:390px;margin-inline:auto}.ded-grid{grid-template-columns:1fr 1fr}.ded-head{display:block}.legend{margin-top:10px}.tools span:not(:last-child){display:none}}
  </style>
