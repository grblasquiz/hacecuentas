---
/**
 * DecisionIntlRoomPage — página completa de una sala de decisión localizada
 * (/co|mx|cl|pe/decidir/<slug>). Espejo de /decidir/[slug].astro con las
 * diferencias país: audience/inLanguage/moneda del país, hreflang clusterizado
 * con la versión AR y las hermanas de otros países (via DECISION_EQUIVALENTS),
 * breadcrumb hacia el vertical país y salas hermanas del MISMO país (no hay
 * hubs país: con ~10 salas el índice alcanza).
 *
 * Las 4 páginas /<cc>/decidir/[slug].astro son wrappers finos de este
 * componente — el copy vive en los módulos de sala, no acá.
 */
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import DecisionRoomIntl from './DecisionRoomIntl.astro';
import { freeOfferSchema } from '../lib/offer-schema';
import { md } from '../lib/markdown';
import type { DecisionRoom } from '../lib/decisions/types';
import type { DecisionCountry } from '../lib/decisions/locales';
import { equivalentsByCountrySlug } from '../lib/decisions/locales';
import { roomsOfCountry } from '../lib/decisions/locales-registry';
import { buildHreflangCluster } from '../lib/hreflang';

interface Props {
  country: DecisionCountry;
  room: DecisionRoom;
}
const { country, room } = Astro.props;

const site = 'https://hacecuentas.com';
const base = `${site}/${country.cc}/decidir`;
const url = `${base}/${room.slug}`;
const dateModified = new Date(room.lastReviewed + 'T00:00:00Z').toISOString();
const datePublished = dateModified;
const lastReviewedLabel = new Date(dateModified).toLocaleDateString(country.locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC', // sin esto, medianoche UTC renderiza el día anterior en América
});

// Baseline SSR: el bot ve un resultado de ejemplo sin ejecutar JS.
const initialResult = room.compute(room.example);

// Salas hermanas del mismo país (el índice país oficia de hub).
const siblings = roomsOfCountry(country.cc)
  .filter((r) => r.slug !== room.slug)
  .slice(0, 6);

// hreflang: cluster simétrico con la sala AR raíz y las hermanas de otros
// países. Si la sala no está en el mapa de equivalencias (no debería pasar),
// cae en el fallback del Layout (self + x-default).
const eq = equivalentsByCountrySlug(country.cc, room.slug);
const hreflang = eq
  ? buildHreflangCluster({
      es: `decidir/${eq.es}`,
      co: eq.co ? `decidir/${eq.co}` : undefined,
      mx: eq.mx ? `decidir/${eq.mx}` : undefined,
      cl: eq.cl ? `decidir/${eq.cl}` : undefined,
      pe: eq.pe ? `decidir/${eq.pe}` : undefined,
    })
  : undefined;

// HowTo steps desde el howItWorks numerado ("1. **Título.** texto").
const howToSteps = [...room.howItWorks.matchAll(/^\d+\.\s+\*\*(.+?)\*\*\s*(.*)$/gm)].map((m) => ({
  name: m[1].replace(/\.$/, ''),
  text: (m[2] || m[1]).replace(/\*\*/g, '').trim(),
}));

const authorRef = { '@id': `${site}/autores/martin-rodriguez#person` };

const schemaGraph: any[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: `Hacé Cuentas ${country.name}`, item: `${site}/${country.cc}` },
      { '@type': 'ListItem', position: 2, name: 'Decisiones', item: base },
      { '@type': 'ListItem', position: 3, name: room.h1 },
    ],
  },
  {
    '@type': ['WebApplication', 'SoftwareApplication'],
    name: room.h1,
    description: room.description,
    url,
    mainEntityOfPage: url,
    applicationCategory: 'FinanceApplication',
    applicationSubCategory: 'Decision tool',
    operatingSystem: 'Web',
    browserRequirements: 'Requires JavaScript. Requires HTML5.',
    inLanguage: country.locale,
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    datePublished,
    dateModified,
    offers: freeOfferSchema({ priceCurrency: country.currency, validFrom: datePublished }),
    publisher: { '@type': 'Organization', name: 'Hacé Cuentas', url: site },
    author: { '@type': 'Person', ...authorRef, name: 'Martín Rodríguez', url: `${site}/autores/martin-rodriguez` },
    // Citation + speakable: mismo enrichment AEO que la sala AR (ver
    // src/pages/decidir/[slug].astro) — LLMs ponderan fuentes verificables.
    ...(room.sources?.length
      ? {
          citation: room.sources.map((s: any) => ({
            '@type': 'CreativeWork',
            name: s.name,
            ...(s.url ? { url: s.url } : {}),
          })),
        }
      : {}),
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.dr-intro', '.dr-decisive-value', '.dr-decisive-label'],
    },
  },
];

// HowTo deprecado por Google (2023, sin rich results) → dejó de emitirse.

if (room.faq.length > 0) {
  schemaGraph.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    url,
    inLanguage: country.locale,
    datePublished,
    dateModified,
    author: authorRef,
    publisher: { '@id': `${site}/#organization` },
    mainEntity: room.faq.map((f, i) => ({
      '@type': 'Question',
      '@id': `${url}#faq-${i + 1}`,
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a, inLanguage: country.locale },
    })),
  });
}

const schema = { '@context': 'https://schema.org', '@graph': schemaGraph };
const howItWorksHtml = md(room.howItWorks);
---

<Layout
  title={room.title}
  description={room.description}
  schema={schema}
  audience={country.audience}
  hreflang={hreflang}
  ogType="article"
  articleSection="Decisiones"
  articleModifiedTime={dateModified}
  domain="money"
  pageType="room"
>
  <Header slot="header" />

  <main class="dr-page">
    <nav class="dr-breadcrumb" aria-label="Migas de pan">
      <a href={`/${country.cc}`}>{country.flag} {country.name}</a> <span aria-hidden="true">›</span>
      <a href={`/${country.cc}/decidir`}>Decisiones</a> <span aria-hidden="true">›</span>
      <span aria-current="page">{room.h1}</span>
    </nav>

    <header class="dr-head">
      <span class="dr-eyebrow">🧭 Sala de decisión · {country.name}</span>
      <h1>{room.icon} {room.h1}</h1>
      <p class="dr-updated">Revisado: {lastReviewedLabel}</p>
    </header>

    <DecisionRoomIntl room={room} country={country} initialResult={initialResult} />

    <section class="dr-section" id="como-funciona">
      <h2>Cómo lo calculamos</h2>
      <div class="dr-prose" set:html={howItWorksHtml} />
    </section>

    {room.componentCalcs.length > 0 && (
      <section class="dr-section dr-component-calcs">
        <h2>Las calculadoras que usa esta sala</h2>
        <p>Esta decisión combina estas herramientas. Si quieres ver cada cálculo por separado:</p>
        <ul class="dr-calc-links">
          {room.componentCalcs.map((c) => (
            <li>
              <a href={`/${c.slug}`}>{c.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {siblings.length > 0 && (
      <section class="dr-section dr-siblings">
        <h2>Más decisiones con números de {country.name}</h2>
        <ul class="dr-calc-links">
          {siblings.map((s) => (
            <li>
              <a href={`/${country.cc}/decidir/${s.slug}`}>{s.icon} {s.h1}</a>
            </li>
          ))}
          <li>
            <a href={`/${country.cc}/decidir`}><strong>🧭 Ver todas →</strong></a>
          </li>
        </ul>
      </section>
    )}

    <section class="dr-section" id="faq">
      <h2>Preguntas frecuentes</h2>
      <div class="dr-faq">
        {room.faq.map((f, i) => (
          <details id={`faq-${i + 1}`}>
            <summary>{f.q}</summary>
            <div>
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    {room.sources && room.sources.length > 0 && (
      <section class="dr-section dr-sources" id="fuentes">
        <h2>Fuentes</h2>
        <ul>
          {room.sources.map((s) => (
            <li>{s.url ? <a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a> : s.name}</li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .dr-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.25rem 1rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .dr-breadcrumb {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .dr-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .dr-breadcrumb a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .dr-head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .dr-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-strong, #0369a1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dr-head h1 {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2.125rem);
    line-height: 1.2;
    color: var(--text);
  }
  .dr-updated {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .dr-section h2 {
    font-size: 1.375rem;
    margin: 0 0 0.75rem;
    color: var(--text);
  }
  .dr-prose {
    line-height: 1.65;
    color: var(--text);
  }
  .dr-prose :global(ol),
  .dr-prose :global(ul) {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dr-calc-links {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .dr-calc-links a {
    display: inline-block;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--bg);
    color: var(--accent-strong, #0369a1);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .dr-calc-links a:hover {
    border-color: var(--accent);
    background: var(--accent-soft, #e0f2fe);
  }
  .dr-faq details {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
  }
  .dr-faq summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }
  .dr-faq details > div {
    padding-top: 0.5rem;
  }
  .dr-faq p {
    margin: 0;
    line-height: 1.6;
    color: var(--text);
  }
  .dr-sources ul {
    padding-left: 1.1rem;
    line-height: 1.6;
  }
  .dr-sources a {
    color: var(--accent-strong, #0369a1);
  }
</style>
