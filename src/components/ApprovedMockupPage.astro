---
import postcss from 'postcss';

interface Props {
  source: string;
  baseStyles?: string;
  sharedScript?: string;
  seoTitle?: string;
}

const { source, baseStyles = '', sharedScript = '', seoTitle = '' } = Astro.props;
const styles = [...source.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/gi)]
  .map((match) => match[1])
  .join('\n');
const scripts = [...source.matchAll(/<script[^>]*>([\s\S]*?)<\/script>/gi)]
  .map((match) => match[1])
  .join('\n') + '\n' + sharedScript;
const dataPage = source.match(/<body[^>]*\bdata-page=["']([^"']+)["'][^>]*>/i)?.[1];
const body = source.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? source;
const headerControls = body.match(/<header\b[^>]*>([\s\S]*?)<\/header>/i)?.[1] ?? '';
const content = body
  .replace(/<header\b[\s\S]*?<\/header>/i, '')
  .replace(/<footer\b[\s\S]*?<\/footer>/i, '')
  .replace(/<script\b[\s\S]*?<\/script>/gi, '');

const escapeHtml = (value: string) => value
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/'/g, '&#39;');

// Algunos mockups LATAM nacen con un #app vacío y montan todo su hero desde
// JS. Dejamos un H1 real dentro de ese contenedor para que el HTML inicial
// tenga una señal inequívoca; el script lo toma y lo reutiliza en el hero
// hidratado, por lo que no quedan dos títulos después de cargar.
const ssrContent = seoTitle.trim()
  ? content.replace(
      /(<div\s+id=["']app["'])\s*>(\s*)<\/div>/i,
      `$1><h1 data-hub-seo-title>${escapeHtml(seoTitle.trim())}</h1>$2</div>`,
    )
  : content;

// Los mockups son documentos completos y usan selectores cortos como `.card`,
// `.hero` y `body`. Se prefijan al contenedor para que nunca alteren el header,
// footer ni otros componentes globales del sitio.
const scopeCss = (css: string) => {
  const root = postcss.parse(css);
  root.walkRules((rule) => {
    if (rule.parent?.type === 'atrule' && rule.parent.name === 'keyframes') return;
    rule.selectors = rule.selectors.map((selector) => {
      const clean = selector.trim();
      if (clean === ':root' || clean === 'html' || clean === 'body') {
        return '.approved-mockup-page';
      }
      if (clean.startsWith('body ')) {
        return `.approved-mockup-page ${clean.slice(5)}`;
      }
      if (clean.startsWith('html ')) {
        return `.approved-mockup-page ${clean.slice(5)}`;
      }
      return `.approved-mockup-page ${clean}`;
    });
  });
  return root.toString();
};
const scopedStyles = scopeCss(`${baseStyles}\n${styles}`);

// Igual que el CSS, las búsquedas y listeners del prototipo quedan encerrados
// dentro de su experiencia: no pisan el buscador ni los controles del header.
const scopedScripts = scripts
  .replace(/\bdocument\.body\.dataset\.page\b/g, 'root.dataset.page')
  .replace(/\bdocument\.getElementById\((["'])([^"']+)\1\)/g, "root.querySelector('#$2')")
  .replace(/\bdocument\.querySelectorAll\b/g, 'root.querySelectorAll')
  .replace(/\bdocument\.querySelector\b/g, 'root.querySelector')
  .replace(/\bdocument\.addEventListener\b/g, 'root.addEventListener');
---

<div class="approved-mockup-page" data-page={dataPage}>
  <div hidden set:html={headerControls}></div>
  <Fragment set:html={ssrContent} />
</div>
<style is:global set:html={scopedStyles}></style>
<style is:global>
  /*
   * El CSS global del sitio define colores propios para headings y para `.faq`.
   * Los mockups usan esas clases dentro de paneles oscuros; sin este límite,
   * el selector global podía convertir títulos blancos en tinta oscura.
   */
  .approved-mockup-page :is(h1, h2, h3, h4, h5, h6) {
    color: inherit;
  }
  .approved-mockup-page .faq {
    background: #fff;
    color: var(--ink);
  }
  .approved-mockup-page .faqQ {
    color: var(--ink);
  }
  .approved-mockup-page .faqA {
    color: var(--muted);
  }
  /* Los prototipos tienen grillas con columnas de contenido largo. En móvil
     cada celda debe poder encogerse dentro del viewport, especialmente cuando
     un input o un texto largo fija el ancho mínimo de la tarjeta. */
  .approved-mockup-page * { min-width: 0; }
  .approved-mockup-page [data-hub-seo-title] {
    margin: 2rem 1rem;
    max-width: 850px;
    font-size: clamp(2.6rem, 5vw, 5rem);
    line-height: .96;
    letter-spacing: -.055em;
  }
  /* Los hubs de categoría comparten un hero de dos columnas. Sus escenas
     decorativas tienen anchos intencionales en desktop, pero no deben fijar el
     ancho de la columna de texto en pantallas chicas. */
  @media (max-width: 600px) {
    .approved-mockup-page [class^="mockup-"][class$="-home"] .heroGrid {
      grid-template-columns: minmax(0, 1fr);
    }
    .approved-mockup-page [class^="mockup-"][class$="-home"] .heroGrid > * {
      min-width: 0;
    }
    .approved-mockup-page [class^="mockup-"][class$="-home"] :is(.scene, .chart, .visual, .illustration) {
      width: 100%; max-width: 100%;
    }
  }
</style>
<script is:inline set:html={`(()=>{const root=document.querySelector('.approved-mockup-page');if(!root)return;if(!window.HC_HUB)window.HC_HUB={onCompute:function(){}};\n${scopedScripts}\nroot.querySelector('.site-header')?.remove();root.querySelector('.site-footer')?.remove();})();`}></script>
