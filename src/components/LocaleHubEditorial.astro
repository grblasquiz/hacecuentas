---
type LocaleKey = 'mx' | 'es' | 'cl' | 'co' | 'pt' | 'en' | 'global';

interface Props {
  locale: LocaleKey;
}

const { locale } = Astro.props;

const hubs = {
  mx: {
    title: 'Cómo elegir una calculadora para México',
    body: 'Empezá por la necesidad concreta: trabajo y sueldo para finiquito, aguinaldo o IMSS; impuestos para ISR, IVA y SAT; finanzas para AFORE, crédito e inversiones; y vida cotidiana para vivienda, auto y trámites. Cada herramienta mexicana usa supuestos locales y explica la fórmula antes del resultado.',
    clusters: [
      ['Sueldos y finanzas', '#cat-finanzas'],
      ['Impuestos y SAT', '#cat-impuestos'],
      ['Auto y transporte', '#cat-automotor'],
      ['Familia', '#cat-familia'],
      ['Negocios', '#cat-negocios'],
      ['Vida cotidiana', '#cat-vida'],
    ],
    guides: [
      ['Valor de la UMA 2026', '/mx/datos-uma-imss-2026'],
      ['SAT', 'https://www.sat.gob.mx/'],
      ['IMSS', 'https://www.imss.gob.mx/'],
      ['CONDUSEF', 'https://www.condusef.gob.mx/'],
    ],
  },
  es: {
    title: 'Cómo elegir una calculadora para España',
    body: 'Usá los subclusters para separar nómina y trabajo, impuestos, vivienda y decisiones financieras. Las calculadoras para España contemplan euros, IRPF, Seguridad Social y reglas locales; cada página detalla sus supuestos y la fecha de actualización.',
    clusters: [
      ['Nómina y finanzas', '#cat-finanzas'],
      ['Impuestos e IRPF', '#cat-impuestos'],
      ['Vivienda y vida cotidiana', '#cat-vida'],
      ['Auto y movilidad', '#cat-automotor'],
      ['Educación', '#cat-educacion'],
      ['Tecnología', '#cat-tecnologia'],
    ],
    guides: [
      ['Agencia Tributaria', 'https://sede.agenciatributaria.gob.es/'],
      ['Seguridad Social', 'https://www.seg-social.es/'],
      ['Banco de España', 'https://www.bde.es/'],
      ['Instituto Nacional de Estadística', 'https://www.ine.es/'],
    ],
  },
  cl: {
    title: 'Cómo elegir una calculadora para Chile',
    body: 'Elegí primero el área: remuneraciones y finiquito, impuestos, previsión, créditos o costo de vida. Las herramientas chilenas trabajan con pesos, UF, UTM y parámetros locales, con los supuestos visibles para que puedas revisar el cálculo.',
    clusters: [
      ['Trabajo, previsión y finanzas', '#cat-finanzas'],
      ['Impuestos', '#cat-impuestos'],
      ['Vivienda y vida cotidiana', '#cat-vida'],
      ['Auto', '#cat-automotor'],
      ['Educación', '#cat-educacion'],
      ['Tecnología', '#cat-tecnologia'],
    ],
    guides: [
      ['Servicio de Impuestos Internos', 'https://www.sii.cl/'],
      ['ChileAtiende', 'https://www.chileatiende.gob.cl/'],
      ['Superintendencia de Pensiones', 'https://www.spensiones.cl/'],
      ['Banco Central de Chile', 'https://www.bcentral.cl/'],
    ],
  },
  co: {
    title: 'Cómo elegir una calculadora para Colombia',
    body: 'Agrupamos las herramientas por la decisión que necesitás tomar: liquidar salario y prestaciones, estimar impuestos, comparar créditos o calcular gastos de vivienda y transporte. Los parámetros se adaptan a pesos colombianos, UVT y normativa local.',
    clusters: [
      ['Trabajo y finanzas', '#cat-finanzas'],
      ['Impuestos y DIAN', '#cat-impuestos'],
      ['Vivienda y vida cotidiana', '#cat-vida'],
      ['Auto y transporte', '#cat-automotor'],
      ['Negocios', '#cat-negocios'],
      ['Viajes', '#cat-viajes'],
    ],
    guides: [
      ['DIAN', 'https://www.dian.gov.co/'],
      ['Ministerio del Trabajo', 'https://www.mintrabajo.gov.co/'],
      ['Banco de la República', 'https://www.banrep.gov.co/'],
      ['Superfinanciera', 'https://www.superfinanciera.gov.co/'],
    ],
  },
  pt: {
    title: 'Como escolher uma calculadora para o Brasil',
    body: 'Comece pela necessidade: salário e trabalho, impostos, finanças, moradia ou transporte. As ferramentas brasileiras usam reais e parâmetros locais, com fórmulas, hipóteses e data de atualização visíveis.',
    clusters: [
      ['Trabalho e finanças', '#cat-finanzas'],
      ['Saúde', '#cat-salud'],
      ['Negócios', '#cat-negocios'],
      ['Vida cotidiana', '#cat-vida'],
      ['Viagens', '#cat-viajes'],
      ['Dados de IPCA', '/pt/dados-ipca-brasil-historico'],
    ],
    guides: [
      ['Receita Federal', 'https://www.gov.br/receitafederal/'],
      ['Banco Central do Brasil', 'https://www.bcb.gov.br/'],
      ['IBGE', 'https://www.ibge.gov.br/'],
      ['Portal Gov.br', 'https://www.gov.br/'],
    ],
  },
  en: {
    title: 'How to choose the right calculator',
    body: 'Start with the decision you need to make: income and taxes, borrowing and investing, health, home, travel, or everyday math. Each tool states its assumptions, formula, worked example, and update date so you can check the result.',
    clusters: [
      ['Money', '/en/money'],
      ['Health', '/en/health'],
      ['Home', '/en/home'],
      ['Life', '/en/life'],
      ['Math', '/en/math'],
      ['Family', '/en/family'],
      ['Fitness', '/en/fitness'],
      ['Pets', '/en/pets'],
      ['Cooking', '/en/cooking'],
      ['Cars', '/en/cars'],
      ['Garden', '/en/garden'],
      ['School', '/en/school'],
      ['Science', '/en/science'],
      ['Technology', '/en/tech'],
    ],
    guides: [
      ['World Health Organization', 'https://www.who.int/'],
      ['World Bank Data', 'https://data.worldbank.org/'],
      ['OECD Data', 'https://data.oecd.org/'],
      ['NIST', 'https://www.nist.gov/'],
    ],
  },
  global: {
    title: 'Cómo elegir una calculadora global',
    body: 'Esta biblioteca reúne cálculos que no dependen de una legislación nacional. Podés navegar por finanzas, salud, matemática, viajes y vida cotidiana; cuando un resultado sí cambia por país, te derivamos a la versión geográfica correspondiente.',
    clusters: [
      ['Finanzas', '/categoria/finanzas'],
      ['Salud', '/categoria/salud'],
      ['Matemática', '/categoria/matematica'],
      ['Viajes', '/categoria/viajes'],
      ['Vida cotidiana', '/categoria/vida'],
      ['Elegir país', '/#paises'],
    ],
    guides: [
      ['Guías explicativas', '/guias'],
      ['Glosario', '/glosario'],
      ['World Bank Data', 'https://data.worldbank.org/'],
      ['Organización Mundial de la Salud', 'https://www.who.int/es'],
    ],
  },
} satisfies Record<LocaleKey, {
  title: string;
  body: string;
  clusters: string[][];
  guides: string[][];
}>;

const hub = hubs[locale];
const isExternal = (href: string) => href.startsWith('http');
---

<section class="locale-editorial" aria-labelledby={`locale-editorial-${locale}`}>
  <div class="editorial-copy">
    <h2 id={`locale-editorial-${locale}`}>{hub.title}</h2>
    <p>{hub.body}</p>
  </div>

  <div class="editorial-columns">
    <div>
      <h3>Subclusters</h3>
      <nav class="link-list" aria-label="Subclusters temáticos">
        {hub.clusters.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
    </div>
    <div>
      <h3>{locale === 'en' ? 'Guides and official sources' : locale === 'pt' ? 'Guias e fontes oficiais' : 'Guías y fuentes oficiales'}</h3>
      <nav class="link-list" aria-label="Guías y fuentes oficiales">
        {hub.guides.map(([label, href]) => (
          <a href={href} rel={isExternal(href) ? 'external noopener' : undefined}>{label}</a>
        ))}
      </nav>
    </div>
  </div>
</section>

<style>
  .locale-editorial {
    margin: 0 1rem 2.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
  }
  .editorial-copy { max-width: 780px; }
  .editorial-copy h2 { margin: 0 0 .75rem; font-size: clamp(1.35rem, 3vw, 1.75rem); }
  .editorial-copy p { margin: 0; color: var(--text-muted); line-height: 1.7; }
  .editorial-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .editorial-columns h3 { margin: 0 0 .65rem; font-size: 1rem; }
  .link-list { display: flex; flex-wrap: wrap; gap: .55rem; }
  .link-list a {
    display: inline-flex;
    padding: .5rem .75rem;
    border: 1px solid var(--border);
    border-radius: .65rem;
    color: var(--accent);
    background: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }
  .link-list a:hover { border-color: var(--accent); text-decoration: underline; }
  @media (max-width: 640px) { .editorial-columns { grid-template-columns: 1fr; } }
</style>
