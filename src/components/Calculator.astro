  function translateOutputStr(s: string): string {
    if (CALC_LANG === 'es' || !s) return s;
    // 1. Lookup exacto en dict por-fórmula (traducciones Haiku-generadas, calidad nativa)
    if (CALC_TRANSLATIONS[s]) return CALC_TRANSLATIONS[s];
    // 2. Fallback regex solo para EN (el dict PT debería cubrir ~95%, sin regex EN-centric)
    if (CALC_LANG === 'en') {
      let out = s;
      for (const [re, repl] of I18N_REGEX_RULES) out = out.replace(re, repl);
      return out;
    }
    return s;
  }

  function formatValue(value: number | string, format: string, suffix = ''): string {
    if (value === null || value === undefined || value === '') return '—';
    let formatted: string;
    // Normalizar aliases legacy de format (974 calcs los usan):
    //   thousands/integer → number sin decimales
    //   decimal → number con decimales
    //   money → currency
    //   percent → percentage
    // Sin esta normalizacion, caian al else (raw) y mostraban "1000" en
    // vez de "1.000" (formato AR thousands separator).
    let fmt = format;
    if (fmt === 'money') fmt = 'currency';
    else if (fmt === 'percent') fmt = 'percentage';
    else if (fmt === 'decimal') fmt = 'number';
    else if (fmt === 'thousands' || fmt === 'integer') fmt = 'integer-internal';

    if (fmt === 'currency') {
      formatted = new Intl.NumberFormat(NUM_LOCALE, {
        style: 'currency',
        currency: NUM_CURRENCY,
        maximumFractionDigits: 0,
      }).format(Number(value));
    } else if (fmt === 'number') {
      formatted = new Intl.NumberFormat(NUM_LOCALE, { maximumFractionDigits: 2 }).format(Number(value));
    } else if (fmt === 'integer-internal') {
      // thousands/integer: separadores de miles AR, sin decimales
      formatted = new Intl.NumberFormat(NUM_LOCALE, { maximumFractionDigits: 0 }).format(Number(value));
    } else if (fmt === 'percentage') {
      // Fix bug: aplicar Intl.NumberFormat para thousands separator (1.234,50%)
      // antes de toFixed devolvia "1234.50%" sin formato AR.
      const num = Number(value);
      if (Number.isFinite(num)) {
        formatted = new Intl.NumberFormat(NUM_LOCALE, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        }).format(num) + '%';
      } else {
        formatted = `${value}%`;
      }
    } else if (fmt === 'date') {
      // Parse manual de 'YYYY-MM-DD' para evitar el bug UTC clásico:
      // new Date('2027-01-10') se parsea como UTC medianoche; en zonas al
      // oeste de UTC (AR=-3) retrocede y muestra "9 de enero". Construyendo
      // con (y, m-1, d) se crea en local time y la fecha se mantiene.
      const strVal = String(value);
      const ymd = strVal.match(/^(\d{4})-(\d{2})-(\d{2})/);
      const d = ymd
        ? new Date(Number(ymd[1]), Number(ymd[2]) - 1, Number(ymd[3]))
        : new Date(value);
      formatted = d.toLocaleDateString(NUM_LOCALE, { day: '2-digit', month: 'long', year: 'numeric' });
    } else {
      // format === 'text', undefined, null, '' u otro no reconocido.
      // Fix 2026-05-20: 1914 outputs en 668 calcs tienen `format: null` o
      // no setean format. Si el valor es numerico, default a formato AR
      // con thousands separator (antes mostraba "1000" raw → ahora "1.000").
      // String non-numeric pasa por translateOutputStr (i18n).
      //
      // Fix 2026-05-21: regex original `/^-?\d+([.,]\d+)?$/` matcheaba "318.720"
      // (string ya formateado en es-AR con punto como separador de miles) y lo
      // reinterpretaba como decimal → output corrupto "318,72". Bug visible en
      // calc edad-exacta donde horasTotal = (dias*24).toLocaleString('es-AR').
      // Nuevo regex acepta solo enteros raw o decimales con MAX 2 dígitos
      // después del punto. "1.000" o "318.720" (3 dígitos = AR thousands) ya
      // vienen formateados desde la fórmula → no re-formatear.
      const strVal = String(value);
      const num = Number(strVal);
      if (Number.isFinite(num) && strVal.trim() !== '' && /^-?\d+(\.\d{1,2})?$/.test(strVal.trim())) {
        formatted = new Intl.NumberFormat(NUM_LOCALE, { maximumFractionDigits: 2 }).format(num);
      } else {
        formatted = translateOutputStr(strVal);
      }
    }
    return suffix ? `${formatted} ${suffix}` : formatted;
  }

  // Parse input "thousand" formatted → number
  function parseThousands(v: string): number {
    return Number(v.replace(/\./g, '').replace(/,/g, '.'));
  }

  function formatThousands(v: string): string {
    // Preservar el signo menos inicial: hay ~8 calcs con min<0 (GMT offset,
    // semitonos, déficit) donde tragarse el '-' daba un resultado al revés.
    const neg = /^\s*-/.test(v);
    const clean = v.replace(/[^\d]/g, '');
    if (!clean) return neg ? '-' : '';
    return (neg ? '-' : '') + new Intl.NumberFormat('es-AR').format(Number(clean));
  }

  // Copia robusta reutilizable: Clipboard API → fallback textarea+execCommand
  // (webviews in-app / doc sin foco donde navigator.clipboard falla en
  // silencio). Devuelve si pudo copiar; el caller decide el último recurso.
  async function copyTextRobust(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch { /* cae al fallback */ }
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.top = '0';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    } catch { return false; }
  }

  // Fix 2026-05-20: el init de la calc se ejecutaba solo en module load.
  // Con Astro View Transitions, navegar entre calcs reemplaza el DOM SIN
  // re-ejecutar el script → el nuevo form queda SIN submit listener →
  // browser hace default GET y recarga la URL. Solucion: envolver el init
  // en una funcion, llamarla en initial + astro:page-load, e idempotent
  // via dataset.calcInited.
  function initCalculator(container: HTMLElement) {
    if (container.dataset.calcInited === '1') return;
    container.dataset.calcInited = '1';

    const slug = container.dataset.slug!;
    const formulaId = container.dataset.formula!;
    const form = container.querySelector<HTMLFormElement>('.calc-form')!;
    const results = container.querySelector<HTMLElement>('.calc-results')!;
    const srAnnounce = container.querySelector<HTMLElement>('[data-sr-announce]');
    const errorBox = container.querySelector<HTMLElement>('.calc-error')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('.btn-primary')!;
    // Pre-cargar fórmula en background (chunk separado, no bloquea render)
    let formulaRef: Function | null = null;
    const formulaReady = loadFormula(formulaId).then((f) => {
      formulaRef = f;
      if (!f) console.error(`Fórmula no encontrada: ${formulaId}`);
      return f;
    });
    const chartWrap = container.querySelector<HTMLElement>('[data-chart-wrap]');
    const chartCanvas = container.querySelector<HTMLCanvasElement>('[data-chart-canvas]');
    const chartDownloadBtn = container.querySelector<HTMLButtonElement>('[data-chart-download]');
    let chartInstance: any = null;
    let lastChartSpec: any = null;
    let _compareAnimated = false;

    // Referencias a elementos de las features UX nuevas.
    const skeletonEl = container.querySelector<HTMLElement>('[data-result-skeleton]');
    const emptyPreviewEl = container.querySelector<HTMLElement>('[data-empty-preview]');
    const stepsEl = container.querySelector<HTMLDetailsElement>('[data-steps]');
    const stepsListEl = container.querySelector<HTMLElement>('[data-steps-list]');
    const comparePrevEl = container.querySelector<HTMLElement>('[data-compare-prev]');
    const tapHintEl = container.querySelector<HTMLElement>('[data-tap-hint]');
    const socialProofEl = container.querySelector<HTMLElement>('[data-social-proof]');
    // Guarda los últimos inputs computados con éxito (para #21 Reintentar y para
    // detectar cambios entre cálculos). Persiste durante la sesión del init.
    let _lastInputs: Record<string, string | number> | null = null;
    let _tapPulseDone = false;
    // #12 Para comparar con el cálculo anterior: guardamos el valor numérico
    // primary previo (junto con su format/suffix para re-formatear el "Antes").
    let _prevPrimary: { num: number; format: string; suffix: string } | null = null;

    // ── Tabla de resultado dinámica (output._table) ──────────────
    // La fórmula devuelve { headers, rows, align?, collapseAfter?, emphasisEvery?, footer?, title?, note? }.
    // Las celdas vienen pre-formateadas (la fórmula decide moneda/decimales).
    const tableWrap = container.querySelector<HTMLElement>('[data-table-wrap]');
    function escapeCell(v: any): string {
      return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function renderResultTable(spec: any) {
      if (!tableWrap) return;
      if (!spec || !Array.isArray(spec.rows) || spec.rows.length === 0 || !Array.isArray(spec.headers)) {
        tableWrap.hidden = true;
        tableWrap.innerHTML = '';
        return;
      }
      const headers: string[] = spec.headers;
      const align: string[] = Array.isArray(spec.align) ? spec.align : [];
      const rows: any[][] = spec.rows;
      const collapseAfter: number = typeof spec.collapseAfter === 'number' && spec.collapseAfter > 0 ? spec.collapseAfter : 0;
      const emphasisEvery: number = typeof spec.emphasisEvery === 'number' && spec.emphasisEvery > 0 ? spec.emphasisEvery : 0;
      const needsCollapse = collapseAfter > 0 && rows.length > collapseAfter;
      const alignStyle = (i: number) => {
        const a = align[i];
        return a === 'right' ? ' style="text-align:right"' : a === 'center' ? ' style="text-align:center"' : '';
      };
      let html = '';
      if (spec.title) html += '<div class="result-table-title">' + escapeCell(spec.title) + '</div>';
      html += '<div class="result-table-scroll"><table class="result-table"><thead><tr>';
      headers.forEach((h, i) => { html += '<th' + alignStyle(i) + '>' + escapeCell(h) + '</th>'; });
      html += '</tr></thead><tbody>';
      rows.forEach((r, ri) => {
        const cls: string[] = [];
        if (needsCollapse && ri >= collapseAfter) cls.push('result-table-row-hidden');
        if (emphasisEvery && (ri + 1) % emphasisEvery === 0) cls.push('result-table-row-emph');
        const attrs = (cls.length ? ' class="' + cls.join(' ') + '"' : '') + (needsCollapse && ri >= collapseAfter ? ' hidden' : '');
        html += '<tr' + attrs + '>';
        r.forEach((c, i) => { html += '<td' + alignStyle(i) + '>' + escapeCell(c) + '</td>'; });
        html += '</tr>';
      });
      html += '</tbody>';
      if (Array.isArray(spec.footer) && spec.footer.length) {
        html += '<tfoot><tr>';
        spec.footer.forEach((c: any, i: number) => { html += '<th' + alignStyle(i) + '>' + escapeCell(c) + '</th>'; });
        html += '</tr></tfoot>';
      }
      html += '</table></div>';
      if (spec.note) html += '<p class="result-table-note">' + escapeCell(spec.note) + '</p>';
      if (needsCollapse) {
        html += '<button type="button" class="result-table-toggle" data-table-toggle data-expanded="false">Ver tabla completa (' + rows.length + ' filas)</button>';
      }
      tableWrap.innerHTML = html;
      tableWrap.hidden = false;
      const toggle = tableWrap.querySelector<HTMLButtonElement>('[data-table-toggle]');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const expanded = toggle.dataset.expanded === 'true';
          tableWrap.querySelectorAll<HTMLElement>('.result-table-row-hidden').forEach((tr) => {
            if (expanded) tr.setAttribute('hidden', ''); else tr.removeAttribute('hidden');
          });
          toggle.dataset.expanded = expanded ? 'false' : 'true';
          toggle.textContent = expanded ? 'Ver tabla completa (' + rows.length + ' filas)' : 'Ver menos';
        });
      }
    }

    // ── Insight narrativo (output._insight) ─────────────────────
    // Caja que explica el resultado en lenguaje claro. spec puede ser un string
    // o un objeto {title, text, tone, icon}. tone ∈ neutral|good|warn.
    const insightEl = container.querySelector<HTMLElement>('[data-insight]');
    function insightInline(text: string): string {
      // Escapa HTML y luego convierte **negrita** simple (markdown liviano).
      return escapeCell(text).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    }
    function renderInsight(spec: any) {
      if (!insightEl) return;
      let title = '', text = '', tone = 'neutral', icon = '💡';
      if (typeof spec === 'string') { text = spec; }
      else if (spec && typeof spec === 'object') {
        title = spec.title || ''; text = spec.text || '';
        tone = spec.tone || 'neutral'; icon = spec.icon || '💡';
      }
      if (!text && !title) { insightEl.hidden = true; insightEl.innerHTML = ''; return; }
      insightEl.className = 'result-insight result-insight--' + tone;
      insightEl.innerHTML =
        '<span class="result-insight-icon" aria-hidden="true">' + escapeCell(icon) + '</span>' +
        '<div class="result-insight-body">' +
        (title ? '<strong class="result-insight-title">' + insightInline(translateOutputStr(title)) + '</strong>' : '') +
        '<span class="result-insight-text">' + insightInline(translateOutputStr(text)) + '</span>' +
        '</div>';
      insightEl.hidden = false;
    }

    // ── #22 Cálculo paso a paso (output._steps) ─────────────────
    // _steps es un array de {label, value} o {label, expr, value}. Renderiza
    // un <details> colapsable. Si no hay pasos válidos, queda oculto.
    function renderSteps(spec: any) {
      if (!stepsEl || !stepsListEl) return;
      const steps = Array.isArray(spec) ? spec.filter((s) => s && typeof s === 'object') : [];
      if (steps.length === 0) {
        stepsEl.hidden = true;
        stepsEl.open = false;
        stepsListEl.innerHTML = '';
        return;
      }
      let html = '';
      for (const s of steps) {
        const label = s.label != null ? translateOutputStr(String(s.label)) : '';
        const expr = s.expr != null ? String(s.expr) : '';
        const value = s.value != null ? translateOutputStr(String(s.value)) : '';
        html += '<li>';
        if (label) html += '<span class="result-step-label">' + escapeCell(label) + '</span>';
        if (expr) html += '<span class="result-step-expr">' + escapeCell(expr) + '</span>';
        if (value) html += (label || expr ? ' ' : '') + '<span class="result-step-value">' + escapeCell(value) + '</span>';
        html += '</li>';
      }
      stepsListEl.innerHTML = html;
      stepsEl.hidden = false;
    }

    // ── Multi-chart con tabs (output._charts) ───────────────────
    // Si la fórmula devuelve output._charts (array de specs, cada uno con
    // tabLabel/label), mostramos tabs para alternar entre vistas (ej. Evolución
    // vs Desglose). renderChart NO cambia: cada tab es un spec normal.
    let chartVariants: any[] = [];
    let activeChartIdx = 0;
    const chartTabsEl = container.querySelector<HTMLElement>('[data-chart-tabs]');
    function paintActiveChart() {
      const spec = chartVariants[activeChartIdx];
      if (!spec || !(window as any).Chart || !chartCanvas) return;
      lastChartSpec = spec; // mantiene coherente el re-render por cambio de tema
      if (spec.ariaLabel) chartCanvas.setAttribute('aria-label', spec.ariaLabel);
      chartInstance = renderChart((window as any).Chart, chartCanvas, spec, chartInstance);
    }
    function renderChartTabs() {
      if (!chartTabsEl) return;
      if (chartVariants.length <= 1) { chartTabsEl.hidden = true; chartTabsEl.innerHTML = ''; return; }
      chartTabsEl.innerHTML = '';
      const _tablistLabel = CALC_LANG === 'en' ? 'Chart views' : CALC_LANG === 'pt' ? 'Visões do gráfico' : 'Vistas del gráfico';
      chartTabsEl.setAttribute('aria-label', _tablistLabel);
      // El canvas es el único panel (se repinta al cambiar de tab): lo marcamos
      // como tabpanel y lo enlazamos vía aria-controls desde cada tab.
      const _canvas = container.querySelector<HTMLElement>('[data-chart-canvas]');
      let _canvasId = '';
      if (_canvas) {
        _canvasId = _canvas.id || ('chart-panel-' + slug);
        _canvas.id = _canvasId;
        _canvas.setAttribute('role', 'tabpanel');
      }
      function selectTab(i: number, focus: boolean) {
        activeChartIdx = i;
        chartTabsEl!.querySelectorAll<HTMLElement>('.chart-tab').forEach((b, bi) => {
          const on = bi === i;
          b.classList.toggle('active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.tabIndex = on ? 0 : -1; // roving tabindex
          if (on && focus) b.focus();
        });
        paintActiveChart();
      }
      chartVariants.forEach((v, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chart-tab' + (i === activeChartIdx ? ' active' : '');
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', i === activeChartIdx ? 'true' : 'false');
        btn.tabIndex = i === activeChartIdx ? 0 : -1;
        btn.id = 'chart-tab-' + slug + '-' + i;
        if (_canvasId) btn.setAttribute('aria-controls', _canvasId);
        btn.textContent = translateOutputStr(v.tabLabel || v.label || ('Vista ' + (i + 1)));
        btn.addEventListener('click', () => { if (activeChartIdx !== i) selectTab(i, false); });
        btn.addEventListener('keydown', (e: KeyboardEvent) => {
          let next = -1;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % chartVariants.length;
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + chartVariants.length) % chartVariants.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = chartVariants.length - 1;
          if (next >= 0) { e.preventDefault(); selectTab(next, true); }
        });
        chartTabsEl.appendChild(btn);
      });
      chartTabsEl.hidden = false;
    }
    // Decide variantes (de _charts o _chart) y pinta. resetActive=true vuelve a la 1ª tab.
    function setChartsFromOutput(output: any, resetActive: boolean): boolean {
      const variants = (Array.isArray(output._charts) && output._charts.length)
        ? output._charts
        : (output._chart ? [output._chart] : []);
      if (!variants.length) return false;
      chartVariants = variants;
      if (resetActive || activeChartIdx >= variants.length) activeChartIdx = 0;
      renderChartTabs();
      paintActiveChart();
      return true;
    }
    function clearCharts() {
      chartVariants = [];
      activeChartIdx = 0;
      lastChartSpec = null;
      if (chartInstance) { try { chartInstance.destroy(); } catch {} chartInstance = null; }
      if (chartTabsEl) { chartTabsEl.hidden = true; chartTabsEl.innerHTML = ''; }
    }

    let whatIfInitialized = false;
    const whatIfEl = container.querySelector<HTMLElement>('[data-what-if]');

    // Chart download → PNG standalone.
    // Genera imagen 2x con fondo blanco (para WhatsApp/Twitter que NO soportan transparencia bien).
    if (chartDownloadBtn) {
      chartDownloadBtn.addEventListener('click', () => {
        if (!chartInstance || !chartCanvas) return;
        try {
          // Canvas temporal con fondo blanco
          const w = chartCanvas.width;
          const h = chartCanvas.height;
          const tmp = document.createElement('canvas');
          tmp.width = w; tmp.height = h;
          const ctx = tmp.getContext('2d')!;
          ctx.fillStyle = document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f172a' : '#ffffff';
          ctx.fillRect(0, 0, w, h);
          ctx.drawImage(chartCanvas, 0, 0);
          // Watermark sutil
          ctx.fillStyle = document.documentElement.getAttribute('data-theme') === 'dark' ? '#64748b' : '#94a3b8';
          ctx.font = '12px system-ui, sans-serif';
          ctx.fillText('hacecuentas.com', w - 130, h - 10);
          // Download
          const a = document.createElement('a');
          a.download = `${slug}-grafico.png`;
          a.href = tmp.toDataURL('image/png');
          a.click();
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'chart_download', { calc_slug: slug });
          }
        } catch (e) {
          console.warn('[Calculator] chart download failed:', e);
        }
      });
    }

    // Formatear valor de slider según format/prefix/suffix
    function formatSliderValue(n: number, fmt: string, prefix: string, suffix: string): string {
      if (fmt === 'currency') {
        return prefix + Math.round(n).toLocaleString('es-AR') + suffix;
      }
      if (fmt === 'percentage') {
        return prefix + (n % 1 === 0 ? n.toString() : n.toFixed(2)) + (suffix || '%');
      }
      return prefix + (n % 1 === 0 ? n.toString() : n.toFixed(2)) + suffix;
    }

    // Lee el valor actual de un input del form (respetando thousands)
    function getFormFieldValue(fieldId: string): number {
      const el = form.querySelector<HTMLInputElement>(`[name="${fieldId}"]`);
      if (!el) return NaN;
      const raw = el.value || (el as HTMLInputElement).placeholder || '';
      if (el.dataset.format === 'thousands' && raw) return parseThousands(raw);
      const n = Number(raw);
      return isNaN(n) ? NaN : n;
    }

    // Corre la fórmula con overrides desde sliders y actualiza outputs + chart (sin side effects)
    let whatIfTimer: any = null;
    function runWhatIfNow(overrides: Record<string, number>) {
      if (!formulaRef) return;
      const inputs: Record<string, string | number> = {};
      const data = new FormData(form);
      data.forEach((v, k) => {
        const el = form.querySelector<HTMLInputElement>(`[name="${k}"]`);
        let raw = v as string;
        if (el?.dataset.format === 'thousands' && raw) {
          inputs[k] = parseThousands(raw);
        } else {
          const num = Number(raw);
          inputs[k] = !isNaN(num) && raw !== '' ? num : raw;
        }
      });
      Object.assign(inputs, overrides);
      // Inyectar lang como input especial: las fórmulas pueden leerlo como i.__lang
      // para devolver strings en EN cuando aplique. Fórmulas que no lo usan lo ignoran.
      (inputs as any).__lang = CALC_LANG;
      let output: any;
      try { output = formulaRef(inputs); } catch { return; }
      // Actualizar outputs (sin animar — cambios son rápidos)
      container.querySelectorAll<HTMLElement>('[data-output]').forEach((el) => {
        const outId = el.dataset.output!;
        const fmt = el.dataset.format!;
        const suf = el.dataset.suffix || '';
        const val = output[outId];
        const valueEl = el.querySelector<HTMLElement>('[data-value]')!;
        valueEl.textContent = formatValue(val, fmt, suf);
      });
      // Actualizar chart(s) — mantiene la tab activa mientras movés sliders
      if (((output._charts && output._charts.length) || output._chart) && chartWrap && chartCanvas && (window as any).Chart) {
        chartWrap.hidden = false;
        setChartsFromOutput(output, false);
      }
      // Actualizar tabla (si corresponde)
      renderResultTable(output._table);
      // Actualizar insight (si corresponde)
      renderInsight(output._insight);
    }

    function scheduleWhatIf(overrides: Record<string, number>) {
      if (whatIfTimer) clearTimeout(whatIfTimer);
      whatIfTimer = setTimeout(() => runWhatIfNow(overrides), 40);
    }

    // Inicializa sliders con los valores actuales del form tras el primer cálculo
    function initWhatIf() {
      if (whatIfInitialized || !whatIfEl) return;
      whatIfInitialized = true;
      const sliders = whatIfEl.querySelectorAll<HTMLElement>('[data-what-if-slider]');
      sliders.forEach((sliderEl) => {
        const fieldId = sliderEl.dataset.field!;
        const fmt = sliderEl.dataset.format || 'number';
        const prefix = sliderEl.dataset.prefix || '';
        const suffix = sliderEl.dataset.suffix || '';
        const input = sliderEl.querySelector<HTMLInputElement>('[data-slider-input]')!;
        const valueEl = sliderEl.querySelector<HTMLElement>('[data-slider-value]')!;
        const curVal = getFormFieldValue(fieldId);
        const clamp = (v: number) => Math.max(Number(input.min), Math.min(Number(input.max), v));
        if (!isNaN(curVal)) input.value = String(clamp(curVal));
        valueEl.textContent = formatSliderValue(Number(input.value), fmt, prefix, suffix);
        input.addEventListener('input', () => {
          const v = Number(input.value);
          valueEl.textContent = formatSliderValue(v, fmt, prefix, suffix);
          // Recolectar TODOS los sliders para aplicar como overrides coherentes
          const overrides: Record<string, number> = {};
          whatIfEl.querySelectorAll<HTMLElement>('[data-what-if-slider]').forEach((s) => {
            const fid = s.dataset.field!;
            const i = s.querySelector<HTMLInputElement>('[data-slider-input]')!;
            overrides[fid] = Number(i.value);
          });
          scheduleWhatIf(overrides);
          // Sync con el input original del form (para que al guardar link sea coherente)
          const formEl = form.querySelector<HTMLInputElement>(`[name="${fieldId}"]`);
          if (formEl) {
            if (formEl.dataset.format === 'thousands') formEl.value = formatThousands(String(v));
            else formEl.value = String(v);
          }
        });
      });
    }

    // Live thousand-formatting on inputs marked data-format="thousands"
    form.querySelectorAll<HTMLInputElement>('input[data-format="thousands"]').forEach((inp) => {
      inp.addEventListener('input', () => {
        const cursor = inp.selectionStart || 0;
        const prevLen = inp.value.length;
        inp.value = formatThousands(inp.value);
        const newLen = inp.value.length;
        const diff = newLen - prevLen;
        inp.setSelectionRange(cursor + diff, cursor + diff);
      });
    });

    // Precargar fields desde querystring (viralización: link con datos precargados)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.size > 0) {
      let filled = 0;
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => {
        const val = urlParams.get(el.name);
        if (val === null) return;
        if ((el as HTMLInputElement).dataset?.format === 'thousands') {
          el.value = formatThousands(val);
        } else {
          el.value = val;
        }
        filled++;
      });
      // Auto-calcular si precargamos y todos los campos required están llenos
      // (no usamos checkValidity porque step=0.1 puede rechazar valores enteros)
      const requiredEls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]'));
      const allRequiredFilled = requiredEls.every((el) => el.value.trim() !== '');
      if (filled > 0 && allRequiredFilled) {
        setTimeout(() => form.requestSubmit(), 120);
      }
    }

    // Auto-calcular al cargar si el JSON tiene autoCalculate: true y todos los
    // required tienen default o placeholder válido. Útil para calcs-dashboard
    // como "Feriados 2026" donde queremos mostrar resultado inmediato.
    if (container.dataset.autoCalculate === 'true') {
      const reqs = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]'));
      const allOk = reqs.every((el) => el.value.trim() !== '');
      if (allOk && urlParams.size === 0) {
        // Esperar a que la fórmula cargue
        setTimeout(() => form.requestSubmit(), 150);
      }
    }

    // ── Validación inline por campo ───────────────────────────────────
    // El form es novalidate (los bubbles nativos chocan con step=0.1 y con el
    // formato de miles), así que validamos a mano y marcamos el campo culpable
    // en lugar de mostrar sólo el banner genérico. Mensajes por idioma.
    const _vmsgAll: Record<string, any> = {
      es: { req: 'Completá este campo', num: 'Ingresá un número válido', numDecimal: 'Ingresá un número válido (usá punto para decimales)', min: (m: string) => `El mínimo es ${m}`, max: (m: string) => `El máximo es ${m}` },
      en: { req: 'Please fill in this field', num: 'Enter a valid number', numDecimal: 'Enter a valid number (use a dot for decimals)', min: (m: string) => `Minimum is ${m}`, max: (m: string) => `Maximum is ${m}` },
      pt: { req: 'Preencha este campo', num: 'Digite um número válido', numDecimal: 'Digite um número válido (use ponto para decimais)', min: (m: string) => `O mínimo é ${m}`, max: (m: string) => `O máximo é ${m}` },
    };
    const VMSG = _vmsgAll[CALC_LANG] || _vmsgAll.es;
    // Formatea el límite min/max con separador de miles para que el mensaje
    // diga "El mínimo es 1.000.000" en vez de "1000000".
    const _vmsgLocale = CALC_LANG === 'en' ? 'en-US' : CALC_LANG === 'pt' ? 'pt-BR' : 'es-AR';
    function fmtLimit(el: any, m: string): string {
      const n = Number(m);
      if (!isFinite(n)) return m;
      if (el.dataset.format === 'thousands' || Math.abs(n) >= 1000) {
        try { return new Intl.NumberFormat(_vmsgLocale).format(n); } catch { return m; }
      }
      return m;
    }
    // Devuelve el error num/min/max de un input con valor (o '' si OK).
    function numericError(el: any, raw: string): string {
      const num = el.dataset.format === 'thousands' ? parseThousands(raw) : Number(raw);
      if (!isFinite(num)) return VMSG.num;
      const min = el.getAttribute('min');
      const max = el.getAttribute('max');
      if (min !== null && min !== '' && num < Number(min)) return VMSG.min(fmtLimit(el, min));
      if (max !== null && max !== '' && num > Number(max)) return VMSG.max(fmtLimit(el, max));
      return '';
    }
    function clearFieldError(el: any) {
      const wrap = el.closest('.input-wrap');
      if (wrap) wrap.classList.remove('is-invalid');
      el.removeAttribute('aria-invalid');
      const field = el.closest('.field');
      const msg = field ? field.querySelector('.field-error') : null;
      if (msg) { (msg as HTMLElement).hidden = true; msg.textContent = ''; }
    }
    function setFieldError(el: any, text: string) {
      const wrap = el.closest('.input-wrap');
      if (wrap) wrap.classList.add('is-invalid');
      el.setAttribute('aria-invalid', 'true');
      const field = el.closest('.field');
      const msg = field ? field.querySelector('.field-error') : null;
      if (msg) { msg.textContent = text; (msg as HTMLElement).hidden = false; }
    }
    function validateForm(): boolean {
      let firstInvalid: any = null;
      const els = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]'));
      els.forEach((el: any) => {
        clearFieldError(el);
        const raw = (el.value || '').trim();
        let err = '';
        if (raw === '') {
          // raw==='' con badInput = el control number rechazó lo tipeado (ej.
          // "30,5" con coma) → se ve lleno pero value queda ''. No es "vacío".
          err = (el.validity && el.validity.badInput) ? VMSG.numDecimal : VMSG.req;
        } else if (el.dataset.type === 'number' || el.type === 'number') {
          err = numericError(el, raw);
        }
        if (err) {
          setFieldError(el, err);
          if (!firstInvalid) firstInvalid = el;
        }
      });
      // Campos OPCIONALES numéricos con valor: validar num/min/max igual (vacío
      // se omite). Antes pasaban basura/out-of-range directo a la fórmula.
      const optEls = Array.from(form.querySelectorAll<HTMLInputElement>('input:not([required])'));
      optEls.forEach((el: any) => {
        if (!(el.dataset.type === 'number' || el.type === 'number')) return;
        clearFieldError(el);
        const raw = (el.value || '').trim();
        let err = '';
        if (raw === '') {
          if (el.validity && el.validity.badInput) err = VMSG.numDecimal;
        } else {
          err = numericError(el, raw);
        }
        if (err) {
          setFieldError(el, err);
          if (!firstInvalid) firstInvalid = el;
        }
      });
      if (firstInvalid) {
        // Si el campo inválido vive dentro de "Opciones avanzadas", abrirlas.
        const adv = firstInvalid.closest('.advanced-toggle');
        if (adv && !adv.open) adv.open = true;
        try { firstInvalid.focus(); } catch {}
        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
      }
      return true;
    }
    // Limpiar el error apenas el usuario corrige el campo.
    form.addEventListener('input', (e) => {
      const el = e.target as any;
      if (el && typeof el.matches === 'function' && el.matches('input, select, textarea')) {
        clearFieldError(el);
      }
    });

    // ── #20 Skeleton: mostrar placeholder mientras carga la fórmula ──
    function showSkeleton() {
      if (!skeletonEl) return;
      // Solo si los resultados aún no están a la vista (primer cálculo / chunk no resuelto)
      if (!results.hidden) return;
      if (emptyPreviewEl) emptyPreviewEl.hidden = true;
      skeletonEl.hidden = false;
    }
    function hideSkeleton() {
      if (skeletonEl) skeletonEl.hidden = true;
    }

    // ── #21 Error diferenciado + Reintentar ─────────────────────────
    function showError(opts: { message: string; retry: boolean }) {
      errorBox.textContent = opts.message;
      if (opts.retry) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'calc-retry-btn';
        btn.textContent = CALC_LANG === 'en' ? '↻ Retry' : CALC_LANG === 'pt' ? '↻ Tentar de novo' : '↻ Reintentar';
        btn.addEventListener('click', () => {
          if (_lastInputs) executeFormula({ ..._lastInputs });
        });
        errorBox.appendChild(document.createElement('br'));
        errorBox.appendChild(btn);
      }
      errorBox.hidden = false;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errorBox.hidden = true;
      errorBox.textContent = '';

      // Validación inline: si algo falla, marcamos el campo y NO seguimos
      // (no mostramos spinner ni corremos la fórmula).
      if (!validateForm()) return;

      const data = new FormData(form);
      const inputs: Record<string, string | number> = {};
      data.forEach((v, k) => {
        const el = form.querySelector<HTMLInputElement>(`[name="${k}"]`);
        let raw = v as string;
        if (el?.dataset.format === 'thousands' && raw) {
          inputs[k] = parseThousands(raw);
        } else {
          const num = Number(raw);
          inputs[k] = !isNaN(num) && raw !== '' ? num : raw;
        }
      });
      executeFormula(inputs);
    });

    // Núcleo del cálculo. Reutilizable por submit, presets, historial y el
    // botón Reintentar (#21). Recibe los inputs ya parseados.
    function executeFormula(rawInputs: Record<string, string | number>) {
      errorBox.hidden = true;
      errorBox.textContent = '';

      // Render del resultado, extraído a función para correrlo SINCRÓNICO
      // (fórmula tibia) o diferido tras spinner (fórmula fría, primer submit).
      const _render = async () => {
        let _formulaLoaded = false;
        try {
          const inputs: Record<string, string | number> = { ...rawInputs };
          // Guardar los inputs limpios (sin __lang) para Reintentar (#21).
          _lastInputs = { ...rawInputs };

          // Asegurar que la fórmula esté cargada (primer submit puede esperar el chunk)
          const formula = formulaRef ?? (await formulaReady);
          if (!formula) {
            const _msg = CALC_LANG === 'en' ? 'We could not load the calculator. Check your connection and retry.'
              : CALC_LANG === 'pt' ? 'Não foi possível carregar a calculadora. Verifique sua conexão e tente de novo.'
              : 'No pudimos cargar la calculadora. Revisá tu conexión y reintentá.';
            hideSkeleton();
            showError({ message: _msg, retry: true });
            return;
          }
          _formulaLoaded = true;
          (inputs as any).__lang = CALC_LANG;
          // #20 Quitar skeleton justo antes de pintar el resultado real
          hideSkeleton();
          const output = formula(inputs);
          let _newPrimary: { num: number; format: string; suffix: string } | null = null;
          let _primaryText = '';
          container.querySelectorAll<HTMLElement>('[data-output]').forEach((el) => {
            const outId = el.dataset.output!;
            const format = el.dataset.format!;
            const suffix = el.dataset.suffix || '';
            const val = output[outId];
            const valueEl = el.querySelector<HTMLElement>('[data-value]')!;
            const isPrimary = el.dataset.primary === 'true';
            if (isPrimary) {
              // Texto FINAL del primary (post-formato): es lo que termina mostrando
              // animateValue al concluir, sin esperar la animación de ~600ms.
              _primaryText = formatValue(val, format, suffix);
            }
            if (isPrimary && typeof val === 'number' && isFinite(val)) {
              _newPrimary = { num: val, format, suffix };
            }
            if (isPrimary && (format === 'currency' || format === 'number' || format === 'percentage') && typeof val === 'number' && isFinite(val)) {
              (valueEl as any)._formatter = (n: number) => formatValue(n, format, suffix);
              animateValue(valueEl, val, 600);
            } else {
              valueEl.textContent = formatValue(val, format, suffix);
            }
          });

          // ── #12 Comparar con el cálculo anterior (mismo output primary) ──
          if (comparePrevEl) {
            if (_prevPrimary && _newPrimary && (_prevPrimary as any).num !== (_newPrimary as any).num) {
              const prev = _prevPrimary as { num: number; format: string; suffix: string };
              const now = _newPrimary as { num: number; format: string; suffix: string };
              const prevStr = formatValue(prev.num, now.format, now.suffix);
              const nowStr = formatValue(now.num, now.format, now.suffix);
              let pctStr = '';
              let dirClass = '';
              let arrow = '';
              if (prev.num !== 0) {
                const pct = ((now.num - prev.num) / Math.abs(prev.num)) * 100;
                const up = now.num > prev.num;
                arrow = up ? '↑' : '↓';
                dirClass = up ? 'cmp-up' : 'cmp-down';
                pctStr = ' (' + arrow + ' ' + Math.abs(pct).toFixed(1) + '%)';
              }
              const beforeLbl = CALC_LANG === 'en' ? 'Before' : CALC_LANG === 'pt' ? 'Antes' : 'Antes';
              const nowLbl = CALC_LANG === 'en' ? 'Now' : CALC_LANG === 'pt' ? 'Agora' : 'Ahora';
              comparePrevEl.innerHTML =
                escapeHtml(beforeLbl) + ': ' + escapeHtml(prevStr) +
                ' → ' + escapeHtml(nowLbl) + ': <span class="cmp-now">' + escapeHtml(nowStr) + '</span>' +
                (pctStr ? '<span class="cmp-arrow ' + dirClass + '">' + escapeHtml(pctStr) + '</span>' : '');
              comparePrevEl.hidden = false;
            } else {
              comparePrevEl.hidden = true;
            }
          }
          if (_newPrimary) _prevPrimary = _newPrimary;

          results.hidden = false;
          // Anunciar el resultado a lectores de pantalla UNA sola vez (texto
          // final, ya formateado — no los pasos intermedios de animateValue).
          if (srAnnounce && _primaryText) {
            const _resLbl = CALC_LANG === 'en' ? 'Result' : 'Resultado';
            srAnnounce.textContent = '';
            const _msg = _resLbl + ': ' + _primaryText;
            requestAnimationFrame(() => { srAnnounce.textContent = _msg; });
          }
          // Animar las barras de comparación al revelar: venían con su width
          // final desde SSR, así que el `transition` CSS nunca disparaba. Las
          // mandamos a 0 y, en el frame siguiente, a su valor → "crecen" al
          // aparecer el resultado. Solo la primera vez y si no hay reduced-motion.
          if (!_compareAnimated) {
            _compareAnimated = true;
            const _reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!_reduce) {
              container.querySelectorAll<HTMLElement>('.result-compare-fill').forEach((fill) => {
                const target = fill.style.width;
                if (!target) return;
                fill.style.width = '0%';
                requestAnimationFrame(() => requestAnimationFrame(() => { fill.style.width = target; }));
              });
            }
          }
          results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

          // Evento para listeners externos (ResultContext, ScenarioComparator dinámico, etc).
          // Se dispara despues de pintar los outputs. `primary` trae el texto FINAL
          // formateado del output primario → los listeners no necesitan scrapear el
          // DOM con timeout para esperar la animacion (animateValue dura ~600ms).
          try {
            container.dispatchEvent(new CustomEvent('hc-calc-result', {
              detail: { slug, output, inputs, primary: _primaryText },
              bubbles: false,
            }));
          } catch {}

          // Dynamic Scenarios — re-correr formula con overrides y renderizar lado-a-lado
          const dynScenariosEl = container.querySelector<HTMLElement>('[data-dynamic-scenarios]');
          if (dynScenariosEl) {
            try {
              const scenariosRaw = dynScenariosEl.getAttribute('data-scenarios') || '[]';
              const scenarios = JSON.parse(scenariosRaw) as Array<{label: string; overrides: Record<string, any>; detail?: string}>;
              const gridEl = dynScenariosEl.querySelector<HTMLElement>('[data-dynamic-scenarios-grid]');
              if (gridEl && scenarios.length > 0 && formula) {
                gridEl.innerHTML = '';
                // Card actual (current)
                const primaryOut = container.querySelector<HTMLElement>('.result.primary');
                const primaryLabel = primaryOut?.querySelector<HTMLElement>('.result-label')?.textContent?.trim() || 'Tu resultado';
                const primaryValueText = primaryOut?.querySelector<HTMLElement>('[data-value]')?.textContent?.trim() || '';
                const currentCard = document.createElement('article');
                currentCard.className = 'dynamic-scenario-card dynamic-scenario-card--current';
                currentCard.innerHTML =
                  '<span class="dynamic-scenario-tag">Tu caso</span>' +
                  '<div class="dynamic-scenario-value">' + primaryValueText + '</div>' +
                  '<div class="dynamic-scenario-label">' + primaryLabel + '</div>';
                gridEl.appendChild(currentCard);
                // Cards alternativos
                for (const s of scenarios) {
                  try {
                    const altInputs = { ...inputs, ...s.overrides };
                    (altInputs as any).__lang = CALC_LANG;
                    const altOut = formula(altInputs);
                    // Encontrar primary output id
                    let primaryId: string | null = null;
                    container.querySelectorAll<HTMLElement>('[data-output][data-primary="true"]').forEach((el) => {
                      primaryId = el.dataset.output || primaryId;
                    });
                    if (!primaryId) continue;
                    const primaryFormat = (container.querySelector<HTMLElement>('.result.primary')?.dataset.format) || 'currency';
                    const primarySuffix = (container.querySelector<HTMLElement>('.result.primary')?.dataset.suffix) || '';
                    const altVal = (altOut as any)[primaryId];
                    const altValStr = formatValue(altVal, primaryFormat, primarySuffix);
                    // Diff
                    let diffHtml = '';
                    const currVal = (output as any)[primaryId];
                    if (typeof currVal === 'number' && typeof altVal === 'number' && isFinite(currVal) && isFinite(altVal) && currVal !== 0) {
                      const diff = altVal - currVal;
                      const pct = (diff / currVal) * 100;
                      const sign = diff > 0 ? '+' : '';
                      const arrow = diff > 0 ? '↑' : (diff < 0 ? '↓' : '=');
                      const cls = diff > 0 ? 'dynamic-scenario-diff--up' : (diff < 0 ? 'dynamic-scenario-diff--down' : '');
                      diffHtml = '<div class="dynamic-scenario-diff ' + cls + '">' + arrow + ' ' + sign + formatValue(diff, primaryFormat, primarySuffix) + ' (' + sign + pct.toFixed(1) + '%)</div>';
                    }
                    const card = document.createElement('article');
                    card.className = 'dynamic-scenario-card dynamic-scenario-card--alt';
                    card.innerHTML =
                      '<span class="dynamic-scenario-tag">' + s.label + '</span>' +
                      '<div class="dynamic-scenario-value">' + altValStr + '</div>' +
                      '<div class="dynamic-scenario-label">' + primaryLabel + '</div>' +
                      (s.detail ? '<div class="dynamic-scenario-detail">' + s.detail + '</div>' : '') +
                      diffHtml;
                    gridEl.appendChild(card);
                  } catch {}
                }
                dynScenariosEl.hidden = false;
              }
            } catch (e) {
              dynScenariosEl.hidden = true;
            }
          }

          // Gráfico(s) opcional(es) — soporta output._charts (tabs) y output._chart (single)
          const hasChart = (Array.isArray(output._charts) && output._charts.length) || output._chart;
          if (hasChart && chartWrap && chartCanvas) {
            chartWrap.hidden = false;
            loadChartJs().then(() => {
              setChartsFromOutput(output, true);
            }).catch((err) => {
              console.warn('[Calculator] Chart.js load failed:', err);
              chartWrap.hidden = true;
            });
          } else if (chartWrap) {
            chartWrap.hidden = true;
            clearCharts();
          }

          // Tabla de resultado opcional — solo si la fórmula devolvió _table
          renderResultTable(output._table);

          // Insight narrativo opcional — solo si la fórmula devolvió _insight
          renderInsight(output._insight);

          // #22 Cálculo paso a paso opcional — solo si la fórmula devolvió _steps
          renderSteps(output._steps);

          // #27 Pulse en el resultado primary la PRIMERA vez (hint de tap-to-copy)
          if (!_tapPulseDone) {
            _tapPulseDone = true;
            const primaryResultEl = container.querySelector<HTMLElement>('.result.primary');
            const coarse = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (primaryResultEl && coarse && !reduce) {
              setTimeout(() => {
                primaryResultEl.classList.add('tap-pulse');
                setTimeout(() => primaryResultEl.classList.remove('tap-pulse'), 3200);
              }, 700);
            }
          }

          // Sliders "¿qué pasa si...?" — mostrar + inicializar tras primer cálculo
          if (whatIfEl) {
            whatIfEl.hidden = false;
            initWhatIf();
          }

          // GA4 event + Google Ads conversion (un solo evento consolidado).
          //
          // Antes disparábamos 2 eventos (calculator_used + conversion_event_default)
          // pero el nombre con prefijo "conversion_*" recibe tratamiento especial
          // por el tag de Google Ads y no se veía en la lista de eventos GA4,
          // lo que bloqueaba la importación como conversión en Ads.
          //
          // Ahora es un solo evento `calculator_used` con value + currency,
          // que sí aparece en GA4 → se puede marcar como "evento clave" allá
          // → se importa como conversión en Google Ads (Tools → Conversions →
          // Import → Google Analytics 4 → seleccionar calculator_used → Primary).
          const sid = hcSessionId();
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'calculator_used', {
              calc_slug: slug,
              formula_id: formulaId,
              session_id: sid,
              value: 1.0,
              currency: 'ARS',
            });
          } else {
            // Fallback: si gtag no cargó aún, encolar en dataLayer directo.
            // gtag.js lo procesará al cargar.
            (window as any).dataLayer = (window as any).dataLayer || [];
            (window as any).dataLayer.push({
              event: 'calculator_used',
              calc_slug: slug,
              formula_id: formulaId,
              session_id: sid,
              value: 1.0,
              currency: 'ARS',
            });
          }

          // Guardar en historial (localStorage) — solo si la primary existe
          try {
            const primaryEl = container.querySelector<HTMLElement>('.result.primary');
            const primaryValue = primaryEl?.querySelector<HTMLElement>('[data-value]')?.textContent || '';
            const primaryLabel = primaryEl?.querySelector<HTMLElement>('.result-label')?.textContent || '';
            if (primaryValue && primaryValue !== '—') {
              saveToHistory(slug, { inputs, primary: primaryValue, label: primaryLabel, ts: Date.now() });
              renderHistory(container, slug, form);
              // Clarity custom event: calc_submit (Bing usa Clarity signals para
              // ranking — high engagement = better signal). Zero overhead: ya
              // está cargado, solo push al queue. Idle-fire para no bloquear UI.
              const cl = (window as any).clarity;
              if (typeof cl === 'function') {
                (window as any).requestIdleCallback?.(() => {
                  try { cl('event', 'calc_submit'); cl('set', 'calc_slug', slug); } catch {}
                }) || setTimeout(() => {
                  try { cl('event', 'calc_submit'); cl('set', 'calc_slug', slug); } catch {}
                }, 0);
              }
            }
          } catch {}

          // Mostrar email capture CTA
          const emailCapture = container.querySelector<HTMLElement>('[data-email-capture]');
          if (emailCapture) {
            emailCapture.style.display = 'block';
          }

          // Incrementar y mostrar contador de cálculos
          try {
            const countKey = 'hc_calc_count';
            const counts: Record<string, number> = JSON.parse(localStorage.getItem(countKey) || '{}');
            counts[slug] = (counts[slug] || 0) + 1;
            localStorage.setItem(countKey, JSON.stringify(counts));
            const counterEl = container.querySelector<HTMLElement>('[data-calc-counter]');
            if (counterEl) {
              const total = Object.values(counts).reduce((a, b) => a + b, 0);
              if (total >= 3) {
                counterEl.textContent = `\u{1F525} Llevás ${total.toLocaleString('es-AR')} cálculos en este dispositivo`;
                counterEl.style.display = 'block';
              }
            }
          } catch {}
        } catch (err: any) {
          // #21 Error diferenciado. Si la fórmula no llegó a cargar, ya se
          // manejó arriba (mensaje de carga + Reintentar). Acá distinguimos:
          //  (a) error de validación/input → mensaje accionable, sin reintento.
          //  (b) excepción de la fórmula → mensaje genérico + botón Reintentar.
          hideSkeleton();
          const isInputErr = err && (err.name === 'InputError' || err.code === 'INPUT' || /\b(input|inválid|invalid|dato|valor)\b/i.test(String(err.message || '')));
          if (isInputErr) {
            const _msg = err.message || (CALC_LANG === 'en' ? 'Check the entered data and try again.'
              : CALC_LANG === 'pt' ? 'Revise os dados informados e tente de novo.'
              : 'Revisá los datos ingresados e intentá de nuevo.');
            showError({ message: _msg, retry: false });
          } else {
            const _msg = CALC_LANG === 'en' ? 'Something went wrong while calculating.'
              : CALC_LANG === 'pt' ? 'Houve um problema ao calcular.'
              : 'Hubo un problema al calcular.';
            showError({ message: _msg, retry: _formulaLoaded });
          }
        } finally {
          submitBtn.classList.remove('loading');
          submitBtn.disabled = false;
        }
      };

      if (formulaRef) {
        // Fórmula ya prefetcheada en init (caso normal): corremos el render en el
        // MISMO task del click → todo layout-shift queda input-atribuido
        // (hadRecentInput=true) → NO cuenta para CLS, en cualquier device. Además
        // elimina los ~180ms muertos del spinner → baja el INP. El resultado
        // aparece al instante, sin skeleton.
        submitBtn.disabled = true;
        _render();
      } else {
        // Fórmula fría (primer submit, el chunk aún carga): spinner + skeleton y
        // diferimos 180ms para que el spinner pinte antes de esperar el chunk.
        submitBtn.classList.add('loading');
        submitBtn.disabled = true;
        showSkeleton();
        setTimeout(_render, 180);
      }
    }

    // Preset buttons: click precarga y calcula
    container.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          const values = JSON.parse(btn.dataset.preset || '{}') as Record<string, string | number>;
          Object.entries(values).forEach(([name, val]) => {
            const el = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
            if (!el) return;
            if ((el as HTMLInputElement).dataset?.format === 'thousands') {
              el.value = formatThousands(String(val));
            } else {
              el.value = String(val);
            }
          });
          container.querySelectorAll('.preset-btn').forEach((b) => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'preset_click', { calc_slug: slug, preset: btn.textContent?.trim() });
          }
          form.requestSubmit();
        } catch {}
      });
    });

    // ── #15 Botón "Borrar datos": resetea el form actual (no el historial) ──
    container.querySelector<HTMLButtonElement>('[data-clear-form]')?.addEventListener('click', () => {
      form.reset();
      // Limpiar estados de validación y de "completo" en todos los campos.
      form.querySelectorAll<HTMLElement>('.input-wrap').forEach((w) => {
        w.classList.remove('is-invalid', 'is-complete');
      });
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      form.querySelectorAll<HTMLElement>('.field-error').forEach((m) => { m.hidden = true; m.textContent = ''; });
      // Quitar selección de presets.
      container.querySelectorAll('.preset-btn').forEach((b) => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      // Volver al empty-preview: ocultar resultados, errores, skeleton.
      results.hidden = true;
      errorBox.hidden = true;
      errorBox.textContent = '';
      hideSkeleton();
      if (emptyPreviewEl) emptyPreviewEl.hidden = false;
      if (comparePrevEl) comparePrevEl.hidden = true;
      _prevPrimary = null;
      _lastInputs = null;
      // Foco al primer campo para seguir cargando.
      const first = form.querySelector<HTMLInputElement | HTMLSelectElement>('input:not([type=hidden]), select');
      try { first?.focus(); } catch {}
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'clear_form', { calc_slug: slug });
      }
    });

    // ── #9 Alerta por dato (alertableFields): suscripción a /api/newsletter ──
    const dataAlertEl = container.querySelector<HTMLElement>('[data-data-alert]');
    if (dataAlertEl) {
      const alertForm = dataAlertEl.querySelector<HTMLFormElement>('[data-data-alert-form]');
      const alertSource = dataAlertEl.getAttribute('data-alert-source') || 'alert';
      alertForm?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const input = alertForm.querySelector<HTMLInputElement>('[data-data-alert-input]');
        const email = (input?.value || '').trim();
        if (!email) return;
        fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: alertSource }),
          keepalive: true,
        }).catch(() => { /* silencioso */ });
        // Feedback inmediato (optimista).
        alertForm.style.display = 'none';
        const note = dataAlertEl.querySelector<HTMLElement>('.data-alert-note');
        if (note) note.style.display = 'none';
        const ok = dataAlertEl.querySelector<HTMLElement>('[data-data-alert-success]');
        if (ok) ok.hidden = false;
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'data_alert_subscribe', { calc_slug: slug, alert_source: alertSource });
        }
      });
    }

    // ── #7 Prueba social real: badge de votos 👍 si up ≥ 30 ──
    if (socialProofEl) {
      try {
        fetch('/api/vote?slug=' + encodeURIComponent('/' + slug))
          .then((r) => (r.ok ? r.json() : null))
          .then((d: any) => {
            const up = d && typeof d.up === 'number' ? d.up : 0;
            if (up >= 30) {
              const n = up.toLocaleString(NUM_LOCALE);
              socialProofEl.textContent =
                CALC_LANG === 'en' ? `👍 ${n} people found this useful`
                : CALC_LANG === 'pt' ? `👍 ${n} pessoas acharam útil`
                : `👍 ${n} personas la encontraron útil`;
              socialProofEl.hidden = false;
            }
          })
          .catch(() => { /* sin números inventados: si falla, no se muestra */ });
      } catch { /* idem */ }
    }

    // Action buttons
    container.querySelectorAll<HTMLButtonElement>('.btn-share').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = btn.dataset.action;
        const url = window.location.href;
        const text = `Mirá esta calculadora en Hacé Cuentas: ${document.title}`;

        if (action === 'whatsapp') {
          // Mensaje rico: titulo + inputs + resultado destacado + URL
          const calcTitle = (document.querySelector('h1')?.textContent || document.title).trim();
          const primary = container.querySelector<HTMLElement>('.result.primary [data-value]');
          const primaryLabel = container.querySelector<HTMLElement>('.result.primary .result-label');

          // Recolectar inputs ingresados con sus labels
          const inputLines: string[] = [];
          form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((el) => {
            if (!el.name || el.type === 'hidden' || el.type === 'submit') return;
            let val = '';
            if (el.tagName === 'SELECT') {
              const sel = el as HTMLSelectElement;
              val = sel.options[sel.selectedIndex]?.text || '';
            } else {
              val = (el as HTMLInputElement).value;
            }
            if (!val || val.trim() === '') return;
            const labelEl = form.querySelector<HTMLElement>(`label[for="${el.id}"] .label-text`);
            const labelText = (labelEl?.textContent || el.name).trim();
            const wrap = el.closest('.input-wrap');
            const prefix = wrap?.querySelector('.prefix')?.textContent?.trim() || '';
            const suffix = wrap?.querySelector('.suffix')?.textContent?.trim() || '';
            const formatted = [prefix, val, suffix].filter(Boolean).join(' ');
            inputLines.push(`• ${labelText}: ${formatted}`);
          });

          const parts: string[] = [];
          parts.push(`🧮 *${calcTitle}*`);
          parts.push('');
          if (inputLines.length > 0) {
            parts.push('📋 Datos:');
            parts.push(...inputLines);
            parts.push('');
          }
          if (primary && primaryLabel) {
            parts.push(`✅ *${primaryLabel.textContent?.trim()}:* ${primary.textContent?.trim()}`);
            parts.push('');
          }
          parts.push(`🔗 Recalculá tu caso: ${url}`);
          parts.push('');
          parts.push('— vía Hacé Cuentas');

          const msg = parts.join('\n');
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'share_whatsapp', { calc_slug: slug });
          }
          window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
        } else if (action === 'copy-result') {
          const primary = container.querySelector<HTMLElement>('.result.primary [data-value]');
          const fallback = container.querySelector<HTMLElement>('[data-value]');
          const value = (primary || fallback)?.textContent || '';
          const ok = await copyTextRobust(value);
          const label = btn.querySelector<HTMLElement>('[data-copy-result-label]')!;
          const original = label.textContent;
          if (ok) {
            label.textContent = CALC_LANG === 'en' ? 'Copied!' : CALC_LANG === 'pt' ? 'Copiado!' : '¡Copiado!';
            btn.classList.add('copied');
            setTimeout(() => {
              label.textContent = original;
              btn.classList.remove('copied');
            }, 1500);
          } else if (value) {
            // Último recurso (webview que bloquea todo): mostrar el valor para copiar a mano.
            try { window.prompt(CALC_LANG === 'en' ? 'Copy:' : 'Copiá:', value); } catch {}
          }
        } else if (action === 'copy-link') {
          // Armar link con fields actuales como querystring (viralización)
          const data = new FormData(form);
          const params = new URLSearchParams();
          data.forEach((v, k) => {
            if (!v) return;
            const el = form.querySelector<HTMLInputElement>(`[name="${k}"]`);
            if (el?.dataset.format === 'thousands') {
              params.set(k, String(parseThousands(v as string)));
            } else {
              params.set(k, String(v));
            }
          });
          const shareUrl = `${window.location.origin}${window.location.pathname}${params.size > 0 ? '?' + params.toString() : ''}`;
          const ok = await copyTextRobust(shareUrl);
          const label = btn.querySelector<HTMLElement>('[data-copy-link-label]')!;
          const original = label.textContent;
          if (ok) {
            label.textContent = CALC_LANG === 'en' ? 'Copied!' : CALC_LANG === 'pt' ? 'Copiado!' : '¡Copiado!';
            btn.classList.add('copied');
            if (typeof (window as any).gtag === 'function') {
              (window as any).gtag('event', 'share_link', { calc_slug: slug });
            }
            setTimeout(() => {
              label.textContent = original;
              btn.classList.remove('copied');
            }, 1500);
          } else {
            // Último recurso: mostrar el link para copiar a mano.
            try { window.prompt(CALC_LANG === 'en' ? 'Copy:' : 'Copiá:', shareUrl); } catch {}
          }
        } else if (action === 'print') {
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'print_pdf', { calc_slug: slug });
          }
          window.print();
        } else if (action === 'share-image') {
          // #31 Compartir resultado como imagen: dibuja una tarjeta de marca en
          // un <canvas> (marca + nombre calc + valor primary) y la descarga PNG,
          // o usa navigator.share con el archivo si está disponible.
          try {
            const calcName = (document.querySelector('h1')?.textContent || container.dataset.name || document.title).trim();
            const primaryVal = (container.querySelector<HTMLElement>('.result.primary [data-value]')?.textContent
              || container.querySelector<HTMLElement>('[data-value]')?.textContent || '').trim();
            const primaryLbl = (container.querySelector<HTMLElement>('.result.primary .result-label')?.textContent || '').trim();
            const W = 1200, H = 630, R = Math.max(1, Math.floor((window.devicePixelRatio || 1)));
            const canvas = document.createElement('canvas');
            canvas.width = W * R; canvas.height = H * R;
            const ctx = canvas.getContext('2d')!;
            ctx.scale(R, R);
            // Fondo gradiente de marca (teal/azul → violeta, igual que el hero).
            const grad = ctx.createLinearGradient(0, 0, W, H);
            grad.addColorStop(0, '#2563eb');
            grad.addColorStop(1, '#7c3aed');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, W, H);
            // Tarjeta blanca interior.
            const pad = 60, cardR = 28;
            const cx0 = pad, cy0 = pad, cw = W - pad * 2, ch = H - pad * 2;
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.moveTo(cx0 + cardR, cy0);
            ctx.arcTo(cx0 + cw, cy0, cx0 + cw, cy0 + ch, cardR);
            ctx.arcTo(cx0 + cw, cy0 + ch, cx0, cy0 + ch, cardR);
            ctx.arcTo(cx0, cy0 + ch, cx0, cy0, cardR);
            ctx.arcTo(cx0, cy0, cx0 + cw, cy0, cardR);
            ctx.closePath();
            ctx.fill();
            const fam = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
            const innerX = cx0 + 56;
            // Marca.
            ctx.fillStyle = '#2563eb';
            ctx.font = '700 34px ' + fam;
            ctx.textBaseline = 'top';
            ctx.fillText('hacecuentas.com', innerX, cy0 + 50);
            // Nombre de la calc (wrap a máx 2 líneas).
            ctx.fillStyle = '#475569';
            ctx.font = '600 30px ' + fam;
            const maxW = cw - 112;
            const words = calcName.split(/\s+/);
            const lines: string[] = [];
            let cur = '';
            for (const w of words) {
              const test = cur ? cur + ' ' + w : w;
              if (ctx.measureText(test).width > maxW && cur) { lines.push(cur); cur = w; }
              else cur = test;
              if (lines.length >= 2) break;
            }
            if (cur && lines.length < 2) lines.push(cur);
            let ny = cy0 + 120;
            lines.slice(0, 2).forEach((ln) => { ctx.fillText(ln, innerX, ny); ny += 40; });
            // Valor primary (grande, color de marca).
            ctx.fillStyle = '#1d4ed8';
            let vSize = 110;
            ctx.font = '800 ' + vSize + 'px ' + fam;
            while (ctx.measureText(primaryVal).width > maxW && vSize > 40) {
              vSize -= 6; ctx.font = '800 ' + vSize + 'px ' + fam;
            }
            ctx.fillText(primaryVal || '—', innerX, cy0 + ch - 200);
            // Label del resultado.
            if (primaryLbl) {
              ctx.fillStyle = '#64748b';
              ctx.font = '500 28px ' + fam;
              ctx.fillText(primaryLbl, innerX, cy0 + ch - 70);
            }
            const fileName = `${slug || 'hacecuentas'}.png`;
            canvas.toBlob(async (blob) => {
              if (!blob) return;
              const file = new File([blob], fileName, { type: 'image/png' });
              const nav = navigator as any;
              if (nav.canShare && nav.canShare({ files: [file] }) && typeof nav.share === 'function') {
                try {
                  await nav.share({ files: [file], title: calcName, text: `${primaryLbl}: ${primaryVal} — hacecuentas.com` });
                } catch { /* usuario canceló */ }
              } else {
                const u = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = u; a.download = fileName;
                document.body.appendChild(a); a.click();
                setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(u); }, 100);
              }
            }, 'image/png');
            if (typeof (window as any).gtag === 'function') {
              (window as any).gtag('event', 'share_image', { calc_slug: slug });
            }
          } catch { /* canvas no soportado → no-op */ }
        } else if (action === 'calendar') {
          // Descarga .ics con el recordatorio de la fecha clave del calc
          // (ej. vencimiento aguinaldo 30/6). Funciona offline, sin backend.
          const date = btn.dataset.calendarDate || '';
          const title = btn.dataset.calendarTitle || document.title;
          const desc = btn.dataset.calendarDescription || '';
          const reminderDays = parseInt(btn.dataset.calendarReminderDays || '3', 10);
          if (!date) return;
          // YYYY-MM-DD → YYYYMMDD (formato ics all-day)
          const dateClean = date.replace(/-/g, '');
          // DTEND es exclusivo para all-day → siguiente día
          const dEnd = new Date(date + 'T00:00:00Z');
          dEnd.setUTCDate(dEnd.getUTCDate() + 1);
          const dEndStr = dEnd.toISOString().slice(0, 10).replace(/-/g, '');
          const now = new Date().toISOString().replace(/[-:]/g, '').slice(0, 15) + 'Z';
          const uid = `${slug}-${dateClean}@hacecuentas.com`;
          const fold = (s: string) => s.replace(/[\r\n]+/g, ' ').replace(/[,;\\]/g, m => '\\' + m);
          const fullDesc = [fold(desc), '', `Generado por Hacé Cuentas — ${window.location.href}`].filter(Boolean).join('\\n');
          const ics = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//Hace Cuentas//calc-reminder//ES',
            'CALSCALE:GREGORIAN',
            'METHOD:PUBLISH',
            'BEGIN:VEVENT',
            `UID:${uid}`,
            `DTSTAMP:${now}`,
            `DTSTART;VALUE=DATE:${dateClean}`,
            `DTEND;VALUE=DATE:${dEndStr}`,
            `SUMMARY:${fold(title)}`,
            `DESCRIPTION:${fullDesc}`,
            `URL:${window.location.href}`,
            'BEGIN:VALARM',
            `TRIGGER:-P${reminderDays}D`,
            'ACTION:DISPLAY',
            `DESCRIPTION:${fold(title)}`,
            'END:VALARM',
            'END:VEVENT',
            'END:VCALENDAR',
          ].join('\r\n');
          const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
          const blobUrl = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = blobUrl;
          a.download = `${slug}-${dateClean}.ics`;
          document.body.appendChild(a);
          a.click();
          setTimeout(() => {
            document.body.removeChild(a);
            URL.revokeObjectURL(blobUrl);
          }, 100);
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'add_to_calendar', { calc_slug: slug, calendar_date: date });
          }
        } else if (action === 'reset') {
          form.reset();
          results.hidden = true;
          errorBox.hidden = true;
          errorBox.textContent = '';
          if (chartWrap) chartWrap.hidden = true;
          clearCharts();
          renderInsight(null);
          renderSteps(null);
          hideSkeleton();
          if (emptyPreviewEl) emptyPreviewEl.hidden = false;
          if (comparePrevEl) comparePrevEl.hidden = true;
          _prevPrimary = null;
          _lastInputs = null;
          // Reset email capture state
          const emailCap = container.querySelector<HTMLElement>('[data-email-capture]');
          if (emailCap) {
            emailCap.style.display = 'none';
            const ef = emailCap.querySelector<HTMLFormElement>('[data-email-form]');
            if (ef) { ef.reset(); ef.style.display = 'flex'; }
            const en = emailCap.querySelector<HTMLElement>('.email-note');
            if (en) en.style.display = 'block';
            const est = emailCap.querySelector<HTMLElement>('[data-email-status]');
            if (est) { est.style.display = 'none'; est.classList.remove('is-error'); }
          }
          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // ── #27 Tap-to-copy: tocar el valor primary lo copia (mobile-friendly) ──
    (function setupTapToCopy() {
      const primaryValEl = container.querySelector<HTMLElement>('.result.primary [data-value]');
      if (!primaryValEl) return;
      async function copyPrimary() {
        const value = (primaryValEl!.textContent || '').trim();
        if (!value || value === '—') return;
        const okCopy = await copyTextRobust(value);
        if (!okCopy) return;
        // Reusar el feedback "¡Copiado!" del hint (o crear uno efímero).
        const okText = CALC_LANG === 'en' ? 'Copied!' : CALC_LANG === 'pt' ? 'Copiado!' : '¡Copiado!';
        if (tapHintEl) {
          const original = tapHintEl.textContent;
          tapHintEl.textContent = okText;
          tapHintEl.classList.add('copied');
          setTimeout(() => {
            tapHintEl.textContent = original;
            tapHintEl.classList.remove('copied');
          }, 1500);
        }
        // También refrescar el label del botón copy-result si existe (coherencia).
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'copy_result', { calc_slug: slug, via: 'tap' });
        }
      }
      primaryValEl.addEventListener('click', copyPrimary);
    })();

    // ── Re-render del chart al cambiar tema o al resize ────────
    if (chartWrap && chartCanvas) {
      const themeObserver = new MutationObserver(() => {
        if (!lastChartSpec || !(window as any).Chart) return;
        chartInstance = renderChart((window as any).Chart, chartCanvas, lastChartSpec, chartInstance);
      });
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      let resizeTimer: any = null;
      window.addEventListener('resize', () => {
        if (!chartInstance) return;
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => { try { chartInstance.resize(); } catch {} }, 120);
      });
    }

    // ── Historial ──────────────────────────────────────────────
    renderHistory(container, slug, form);

    container.querySelector<HTMLButtonElement>('[data-history-clear]')?.addEventListener('click', () => {
      try {
        localStorage.removeItem(`hc-history-${slug}`);
        renderHistory(container, slug, form);
      } catch {}
    });

    // ── Feedback ──────────────────────────────────────────────
    const fbEl = container.querySelector<HTMLElement>('[data-feedback]');
    if (fbEl) {
      // Ocultar si ya votó recientemente (hace menos de 30 días)
      try {
        const last = localStorage.getItem(`hc-feedback-${slug}`);
        if (last) {
          const lastTs = Number(last);
          if (!isNaN(lastTs) && Date.now() - lastTs < 30 * 24 * 60 * 60 * 1000) {
            fbEl.hidden = true;
          }
        }
      } catch {}

      let currentVote: 'up' | 'down' | null = null;
      const promptEl = fbEl.querySelector<HTMLElement>('[data-feedback-prompt]')!;
      const followupEl = fbEl.querySelector<HTMLElement>('[data-feedback-followup]')!;
      const labelEl = fbEl.querySelector<HTMLElement>('[data-feedback-label]')!;
      const textEl = fbEl.querySelector<HTMLTextAreaElement>('[data-feedback-text]')!;
      const thanksEl = fbEl.querySelector<HTMLElement>('[data-feedback-thanks]')!;

      fbEl.querySelectorAll<HTMLButtonElement>('[data-feedback-vote]').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentVote = btn.dataset.feedbackVote as 'up' | 'down';
          fbEl.querySelectorAll('[data-feedback-vote]').forEach((b) => b.classList.remove('selected'));
          btn.classList.add('selected');
          labelEl.textContent = currentVote === 'up' ? '¿Qué fue lo mejor? (opcional)' : '¿Qué te faltó o estuvo mal? (opcional)';
          followupEl.hidden = false;
          textEl.focus();
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'feedback_vote', { calc_slug: slug, vote: currentVote });
          }
        });
      });

      fbEl.querySelector<HTMLButtonElement>('[data-feedback-send]')?.addEventListener('click', () => {
        const text = textEl.value.trim().slice(0, 500);

        // 1) GA4 event (tracking analytics)
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'feedback_submit', {
            calc_slug: slug,
            vote: currentVote,
            feedback_text: text || '(sin comentario)',
          });
        }

        // 2) POST al backend para que llegue al equipo editorial via D1 + email
        // (no esperamos respuesta — fire-and-forget, no bloqueamos UI)
        if (text && currentVote) {
          fetch('/api/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              slug: '/' + slug,
              vote: currentVote,
              feedback_text: text,
            }),
            keepalive: true,
          }).catch(() => { /* silencioso, el GA4 event ya fue */ });
        }

        try { localStorage.setItem(`hc-feedback-${slug}`, String(Date.now())); } catch {}
        promptEl.hidden = true;
        followupEl.hidden = true;
        thanksEl.hidden = false;
      });
    }

    // ── Email capture: POST real a /api/email-result ──────────
    const emailForm = container.querySelector<HTMLFormElement>('[data-email-form]');
    if (emailForm) {
      emailForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const emailInput = emailForm.querySelector<HTMLInputElement>('[data-email-input]');
        const email = emailInput?.value.trim();
        if (!email) return;

        const emailSubmitBtn = emailForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (emailSubmitBtn?.disabled) return; // ya hay un POST en vuelo
        const statusEl = container.querySelector<HTMLElement>('[data-email-status]');
        const noteEl = container.querySelector<HTMLElement>('.email-note');
        const showStatus = (kind: 'sent' | 'saved' | 'error') => {
          if (!statusEl) return;
          statusEl.textContent = (kind === 'sent' ? statusEl.dataset.msgSent
            : kind === 'saved' ? statusEl.dataset.msgSaved
            : statusEl.dataset.msgError) || '';
          statusEl.classList.toggle('is-error', kind === 'error');
          statusEl.style.display = 'block';
        };

        // GA4 event — sincrónico ANTES del fetch para no perderlo si la página
        // se cierra durante el await. Mismo shape histórico (sólo calc_slug).
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'email_capture', { calc_slug: slug });
        }

        // Obtener resultado primary
        const primaryVal = container.querySelector<HTMLElement>('.result.primary [data-value]')?.textContent || '';

        // Deshabilitar el botón durante el await (evita doble submit / filas duplicadas)
        const idleLabel = emailSubmitBtn?.textContent || '';
        if (emailSubmitBtn) {
          emailSubmitBtn.disabled = true;
          emailSubmitBtn.textContent = emailSubmitBtn.dataset.labelSending || idleLabel;
        }

        // Guardar en D1 (y enviar por email si el backend tiene RESEND_API_KEY).
        // slug = pathname completo para que el link del email respete /en/, /pt/, /ec/, etc.
        let respOk = false;
        let emailSent = false;
        try {
          const resp = await fetch('/api/email-result', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, slug: window.location.pathname, result: primaryVal }),
            keepalive: true,
          });
          if (resp.ok) {
            respOk = true;
            const data: any = await resp.json().catch(() => null);
            emailSent = !!(data && data.sent);
          }
        } catch { /* respOk queda false → mostramos error real */ }

        // Restaurar el botón (en éxito el form se oculta igual; en error queda usable)
        if (emailSubmitBtn) {
          emailSubmitBtn.disabled = false;
          emailSubmitBtn.textContent = idleLabel;
        }

        if (respOk) {
          emailForm.style.display = 'none';
          if (noteEl) noteEl.style.display = 'none';
          showStatus(emailSent ? 'sent' : 'saved');
        } else {
          // Error real (400/500/red): NO ocultamos el form para que pueda reintentar.
          showStatus('error');
        }
      });
    }

    // ── Mostrar contador existente al cargar ──────────────────
    // Threshold: recién desde el 3er cálculo. Con 1-2 cálculos se lee como
    // social proof flojo ("sólo 1 cálculo realizado") cuando en realidad es
    // un contador per-device (localStorage). A partir de 3 tiene sentido.
    try {
      const counts: Record<string, number> = JSON.parse(localStorage.getItem('hc_calc_count') || '{}');
      const total = Object.values(counts).reduce((a, b) => a + b, 0);
      if (total >= 3) {
        const counterEl = container.querySelector<HTMLElement>('[data-calc-counter]');
        if (counterEl) {
          counterEl.textContent = `\u{1F525} Llevás ${total.toLocaleString('es-AR')} cálculos en este dispositivo`;
          counterEl.style.display = 'block';
        }
      }
    } catch {}

    // ── Hidratación lista: destrabar el guard pre-JS ─────────────────
    // El <script is:inline> previo al form encola el click en Calcular
    // (data-hc-queued) si el usuario lo tocó antes de que este init atara
    // los handlers. Marcamos ready, limpiamos el loading visual y, si había
    // un click encolado, disparamos el cálculo con los datos que el usuario
    // ya cargó en el form (requestSubmit → validación + executeFormula).
    container.dataset.hcReady = '1';
    submitBtn.classList.remove('loading');
    if (container.dataset.hcQueued === '1') {
      delete container.dataset.hcQueued;
      form.requestSubmit();
    }
  }  // end initCalculator

  // Trigger en initial load + en cada astro:page-load (view transitions).
  // Idempotent via dataset.calcInited en cada container.
  document.querySelectorAll<HTMLElement>('.calc-container').forEach(initCalculator);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.calc-container').forEach(initCalculator);
  });

  // ── Helpers de historial ─────────────────────────────────────
  const HISTORY_MAX = 5;

  function saveToHistory(
    slug: string,
    entry: { inputs: Record<string, string | number>; primary: string; label: string; ts: number }
  ) {
    try {
      const key = `hc-history-${slug}`;
      const existing: any[] = JSON.parse(localStorage.getItem(key) || '[]');
      // Deduplicar: si ya existe un entry con los mismos inputs, lo movemos al frente (no duplicamos)
      const inputsKey = JSON.stringify(entry.inputs);
      const filtered = existing.filter((e) => JSON.stringify(e.inputs) !== inputsKey);
      const next = [entry, ...filtered].slice(0, HISTORY_MAX);
      localStorage.setItem(key, JSON.stringify(next));
    } catch {}
  }

  function renderHistory(container: HTMLElement, slug: string, form: HTMLFormElement) {
    const widget = container.querySelector<HTMLElement>('[data-history-widget]');
    const list = container.querySelector<HTMLElement>('[data-history-list]');
    if (!widget || !list) return;

    let history: any[] = [];
    try { history = JSON.parse(localStorage.getItem(`hc-history-${slug}`) || '[]'); } catch {}

    if (history.length === 0) {
      widget.hidden = true;
      return;
    }
    widget.hidden = false;
    list.innerHTML = '';
    const icon = widget.getAttribute('data-history-icon') || '📊';

    history.forEach((entry) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'history-item';
      const timeAgo = relativeTime(entry.ts);
      btn.innerHTML =
        `<span class="history-item-icon" aria-hidden="true">${escapeHtml(icon)}</span>` +
        `<span class="history-item-content"><span class="history-item-label">${escapeHtml(entry.label || 'Resultado')}</span><time class="history-item-time">${timeAgo}</time></span>` +
        `<span class="history-item-value">${escapeHtml(entry.primary)}</span>`;
      btn.addEventListener('click', () => {
        // Precargar form con los inputs del entry y resubmit
        Object.entries(entry.inputs).forEach(([name, val]) => {
          const el = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
          if (!el) return;
          if ((el as HTMLInputElement).dataset?.format === 'thousands') {
            el.value = new Intl.NumberFormat('es-AR').format(Number(val));
          } else {
            el.value = String(val);
          }
        });
        form.requestSubmit();
      });
      list.appendChild(btn);
    });
  }

  function relativeTime(ts: number): string {
    const diff = Date.now() - ts;
    const min = Math.floor(diff / 60000);
    if (min < 1) return 'ahora';
    if (min < 60) return `hace ${min} min`;
    const hr = Math.floor(min / 60);
    if (hr < 24) return `hace ${hr} h`;
    const day = Math.floor(hr / 24);
    if (day < 30) return `hace ${day} d`;
    return new Date(ts).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' });
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }
</script>
