---
import FieldRow from "./FieldRow.astro";
import StickyResultPill from "./StickyResultPill.astro";
import ShareBottomSheet from "./ShareBottomSheet.astro";
import Visualization from "./Visualization.astro";
import type { VizData } from "./Visualization.astro";
import WhatChanged from "./WhatChanged.astro";
import type { WhatChangedDiff } from "./WhatChanged.astro";
import ScenarioComparator from "./ScenarioComparator.astro";
import type { Scenario } from "./ScenarioComparator.astro";
import ResultContext from "./ResultContext.astro";
import type { EquivalenciaId } from "./ResultContext.astro";
export interface Field {
  id: string;
  label: string;
  type: 'number' | 'text' | 'select' | 'date' | 'time';
  placeholder?: string;
  suffix?: string;
  prefix?: string;
  min?: number;
  max?: number;
  step?: number;
  default?: string | number;
  options?: { value: string; label: string }[];
  required?: boolean;
  help?: string;
  /** 'thousands' = separador de miles. 'plain' = opt-out del auto-miles (campo crudo). */
  format?: 'thousands' | 'plain';
  advanced?: boolean;
  /** Smart Input Groups: agrupador opcional. Fields con el mismo `group` se renderizan juntos en un panel con header. */
  group?: string;
  /** Icono opcional para el header del grupo (emoji o caracter). Solo se usa en el primer field del grupo. */
  groupIcon?: string;
}

export interface Preset {
  label: string;
  values: Record<string, string | number>;
  note?: string;
}

export interface PresetsGroup {
  title?: string;
  items: Preset[];
}

export type UpdateFrequency = 'never' | 'daily' | 'weekly' | 'monthly' | 'biannual' | 'yearly';
export type UpdateType = 'manual' | 'auto-api' | 'auto-scrape' | 'auto-llm';

export interface DataUpdate {
  frequency: UpdateFrequency;
  lastUpdated: string; // YYYY-MM-DD — cuándo refrescamos/revisamos nuestra copia
  dataAsOf?: string;   // YYYY-MM-DD — fecha a la que corresponde el dato real (mes IPC, fecha UF, vigencia ley). Fallback a lastUpdated.
  source?: string | null;
  sourceUrl?: string | null;
  updateType: UpdateType;
  notes?: string;
}

export interface Reviewer {
  name: string;
  role?: string;          // ej. "Contador Público (CPCECABA T.123 F.45)"
  url?: string;           // perfil público (LinkedIn, sitio profesional)
}

export interface ChangelogEntry {
  date: string;           // YYYY-MM-DD
  change: string;         // qué cambió (1 línea)
}

export interface CalcConfig {
  slug: string;
  title: string;
  h1: string;
  description: string;
  category: string;
  icon: string;
  fields: Field[];
  formulaId: string;
  presets?: PresetsGroup;
  dataUpdate?: DataUpdate;
  lastReviewed?: string;        // YYYY-MM-DD — fecha visible al usuario
  reviewer?: Reviewer;          // si ausente: mostramos "Equipo Hacé Cuentas"
  changelog?: ChangelogEntry[]; // historial de cambios (opcional)
  outputs: {
    id: string;
    label: string;
    format: 'currency' | 'number' | 'percentage' | 'date' | 'text' | 'duration';
    primary?: boolean;
    suffix?: string;
    /** Result Hero opcional: chip de contexto que aparece arriba del label en el output primary. */
    contextChip?: string;
    /** Result Hero opcional: barra comparativa visual debajo del valor (vs. mínimo/promedio/meta). */
    compareBar?: {
      percent: number;        // 0..100 — porcentaje de fill de la barra
      minLabel?: string;      // ej. "Mínimo: $1.200.000"
      label?: string;         // ej. "↑ 53% más"
    };
    /** Result Hero opcional: CTAs contextuales debajo del valor (ej. "Ver desglose", "¿Es justo?"). */
    ctas?: Array<{
      label: string;
      icon?: string;          // emoji o caracter pequeño
      href?: string;          // si tiene, es <a>
      action?: string;        // si tiene, es <button data-action>
    }>;
  }[];
  interactive?: {
    sliders: Array<{
      fieldId: string;
      min: number;
      max: number;
      step: number;
      label: string;
      format?: 'currency' | 'number' | 'percentage';
      prefix?: string;
      suffix?: string;
    }>;
  };
  // Caso de ejemplo prerenderizado al SSG-time (sin markdown). Se inyecta
  // como contenido inicial del result-value primary para que el bot de Google
  // vea un baseline numerico above-the-fold antes de ejecutar JS. El
  // cliente lo sobreescribe en compute() al primer input valido.
  example?: {
    title?: string;
    result?: string;
    steps?: string[];
  };
  /** Visualization opcional debajo del result primary (bar/gauge/curve/donut/timeline). */
  visualization?: { title?: string; data: VizData };
  /** What Changed opcional (diff vs períodos anteriores) — para calcs con datos históricos. */
  whatChanged?: {
    title: string;
    value: string;
    updatedLabel?: string;
    diffs?: WhatChangedDiff[];
    history?: number[];
    historyLabels?: { first?: string; last?: string };
  };
  /** Scenario Comparator opcional (escenarios pre-calculados). */
  scenarios?: {
    title?: string;
    current: Scenario;
    alternative: Scenario;
    summary?: string;
    summaryIcon?: string;
  };
  /** ResultContext opcional: chips de equivalencia bajo el primary output
   *  (USD MEP, % inflación, SMVM). El cliente calcula con datos vivos. */
  resultContext?: {
    equivalencias: EquivalenciaId[];
    minValue?: number;
  };
  /** CalendarReminder opcional: cuando el calc tiene una fecha clave
   *  (vencimiento aguinaldo, monotributo, ABL, etc), exponer botón
   *  "Agendar en calendario" que descarga un .ics. */
  calendarReminder?: {
    /** Fecha del evento en formato YYYY-MM-DD. */
    date: string;
    /** Título del evento en el calendario (ej. "Cobrar aguinaldo (SAC junio 2026)"). */
    title: string;
    /** Descripción opcional del evento. */
    description?: string;
    /** Días antes para el recordatorio. Default 3. */
    reminderDaysBefore?: number;
  };
  /** Dynamic Scenarios: alternativas computadas client-side aplicando overrides
   *  a los inputs del usuario y corriendo la misma fórmula. Aparece lado-a-lado
   *  bajo el primary result. Útil para "qué pasaría si...". */
  dynamicScenarios?: Array<{
    /** Tag corto del escenario (ej. "Semestre completo"). */
    label: string;
    /** Overrides a aplicar sobre los inputs antes de recomputar. */
    overrides: Record<string, string | number>;
    /** Texto descriptivo opcional bajo el resultado del escenario. */
    detail?: string;
  }>;
}

export interface Props {
  config: CalcConfig;
  lang?: 'es' | 'en' | 'pt';
  /** Fecha de dato UNIFICADA que calcula la página ([...slug].astro): la más
   *  fresca entre tabla maestra / dataAsOf / lastUpdated. Si llega, el
   *  trust-strip la usa en vez de dataUpdate.lastUpdated para no contradecir
   *  al badge del header (YYYY-MM-DD). */
  dataAsOf?: string;
}

const { config, lang = 'es', dataAsOf: dataAsOfProp } = Astro.props;

// SSG baseline: texto plano del example.result para el output primary.
// El bot lo ve above-the-fold antes de ejecutar JS; el cliente lo
// sobreescribe en compute() al primer input valido.
const exampleBaseline: string = (() => {
  const raw = config.example?.result;
  if (!raw) return '';
  return raw.replace(/[*`_]/g, '').replace(/\s+/g, ' ').trim().slice(0, 120);
})();

// Cargar traducciones de strings de output por formulaId (solo para lang=en).
// El JSON se genera con scripts/translate-formula-strings.py (Haiku 4.5).
import formulaStringsI18n from '../lib/formula-strings-i18n.json';
// Para PT usamos otro dict separado cuando exista
let formulaStringsI18nPt: any = {};
try { formulaStringsI18nPt = (await import('../lib/formula-strings-i18n-pt.json')).default; } catch {}

const outputTranslations =
  lang === 'en' ? ((formulaStringsI18n as any)[config.formulaId] || {}) :
  lang === 'pt' ? ((formulaStringsI18nPt as any)[config.formulaId] || {}) :
  {};

