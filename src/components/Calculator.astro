const t = translations[lang as keyof typeof translations] || translations.es;

// Disclaimers inline por calculadora sensible (override específico).
// El fallback por categoría aplica a CUALQUIER calc de finanzas/salud/etc.
const disclaimers: Record<string, string> = {
  'sueldo-en-mano-argentina': 'Cálculo aproximado según escala del impuesto a las ganancias 2026. Consultá con tu empleador o contador para tu caso específico.',
  'calculadora-aguinaldo-sac': 'El aguinaldo se calcula sobre la mejor remuneración del semestre (Ley 27.073). Para liquidación final, consultá a tu contador.',
  'calculadora-monotributo-2026': 'Los montos son de ARCA (ex-AFIP) 2026. Pueden actualizarse semestralmente. Consultá arca.gob.ar para confirmar o hablá con tu contador.',
  'calculadora-cuota-prestamo': 'Cálculo ilustrativo de cuota francesa. La CFT real puede diferir por seguros, gastos e impuestos. Consultá al banco antes de firmar.',
  'calculadora-imc': 'El IMC es orientativo. No reemplaza una consulta médica. Factores como masa muscular afectan el resultado.',
  'calculadora-calorias-diarias-tdee': 'Estimación basada en fórmula Mifflin-St Jeor. Consultá a un nutricionista matriculado para planes específicos.',
  'calculadora-embarazo': 'Cálculo por regla de Naegele. La fecha real puede variar ±2 semanas. Consultá a tu obstetra.',
  'calculadora-ovulacion-dias-fertiles': 'Estimación estadística. Consultá a un ginecólogo si buscás o evitás un embarazo.',
  'calculadora-interes-compuesto': 'Cálculo ilustrativo. No constituye asesoramiento en inversión (Ley 26.831 / RG CNV 840/2020). Las inversiones reales varían según mercado, comisiones e impuestos.',
};

// Fallback por categoría — cubre YMYL (finanzas, salud, negocios) aunque la
// calc específica no tenga disclaimer individual definido.
const categoryDisclaimers: Record<string, string> = {
  finanzas: 'Herramienta educativa. No constituye asesoramiento en inversión (Ley 26.831 / RG CNV 840/2020). Consultá a un contador o asesor financiero matriculado antes de tomar decisiones.',
  negocios: 'Cálculo ilustrativo. No constituye asesoramiento contable ni financiero. Consultá a un contador público para tu caso específico.',
  salud: 'Resultado orientativo. No reemplaza el diagnóstico ni el tratamiento médico. Consultá con un profesional de la salud matriculado.',
  deportes: 'Estimación genérica. Consultá con un profesional del deporte o médico deportólogo para planes personalizados.',
  familia: 'Información general. Para decisiones de salud, fertilidad o crianza consultá con profesionales matriculados.',
  mascotas: 'Orientativo. Consultá con veterinario matriculado para el estado de salud de tu mascota.',
  construccion: 'Estimación. Los proyectos constructivos requieren cálculo estructural profesional y dirección técnica.',
};

// Fallback "laboral/sueldos": las calcs de sueldo/aguinaldo/indemnización son
// category=finanzas y caían en el disclaimer de INVERSIÓN (Ley 26.831/CNV), que
// no tiene nada que ver con una liquidación de sueldo. Detectamos por slug.
const LABORAL_RE = /sueldo|aguinaldo|indemniz|vacacion|liquidacion|paritaria|antiguedad|horas-extra|preaviso|finiquito|despido/;
const laboralDisclaimer = 'Cálculo orientativo según la LCT y las escalas vigentes. Para tu liquidación exacta consultá a tu empleador o a un contador.';

// Disclaimers por categoría para audiencia global (EN/PT): MISMA cobertura YMYL
// que ES pero SIN referencias a leyes argentinas (que no aplican afuera).
const categoryDisclaimersEN: Record<string, string> = {
  finanzas: 'Educational tool, not investment advice. Consult a licensed financial advisor before making decisions.',
  negocios: 'Illustrative estimate, not accounting or financial advice. Consult a licensed accountant for your case.',
  salud: 'For guidance only — not medical advice. Consult a licensed healthcare professional.',
  deportes: 'Generic estimate. Consult a sports professional or physician for a personalized plan.',
  familia: 'General information. For health, fertility or parenting decisions consult licensed professionals.',
  mascotas: 'For guidance only. Consult a licensed veterinarian about your pet’s health.',
  construccion: 'Estimate only. Construction projects require professional structural calculation and supervision.',
};
const categoryDisclaimersPT: Record<string, string> = {
  finanzas: 'Ferramenta educativa, não é recomendação de investimento. Consulte um contador ou assessor financeiro.',
  negocios: 'Estimativa ilustrativa, não substitui orientação contábil. Consulte um contador para o seu caso.',
  salud: 'Resultado orientativo — não substitui avaliação médica. Consulte um profissional de saúde.',
  deportes: 'Estimativa genérica. Consulte um profissional de educação física ou médico do esporte.',
  familia: 'Informação geral. Para decisões de saúde, fertilidade ou maternidade consulte profissionais.',
  mascotas: 'Apenas orientativo. Consulte um veterinário sobre a saúde do seu animal.',
  construccion: 'Apenas estimativa. Obras exigem cálculo estrutural profissional e acompanhamento técnico.',
};

// Disclaimer inline junto al resultado, por idioma. ES mantiene los overrides
// por slug + el fallback laboral; EN/PT usan los mapas globales sin leyes AR.
const disclaimer = (() => {
  if (lang === 'en') return categoryDisclaimersEN[config.category] || '';
  if (lang === 'pt') return categoryDisclaimersPT[config.category] || '';
  if (disclaimers[config.slug]) return disclaimers[config.slug];
  if (config.category === 'finanzas' && LABORAL_RE.test(config.slug)) return laboralDisclaimer;
  return categoryDisclaimers[config.category] || '';
})();

const basicFields = config.fields.filter((f) => !f.advanced);
const advancedFields = config.fields.filter((f) => f.advanced);

// Alerta por dato (opcional): si el calc declara config.alertableFields
// (array de strings), ofrecemos suscripción a "avisame cuando cambie X".
// Si no existe, no se renderiza nada.
const alertableFields: string[] = Array.isArray((config as any).alertableFields)
  ? ((config as any).alertableFields as any[]).map((s) => String(s).trim()).filter(Boolean)
  : [];
// Tema legible para el copy del bloque de alerta (junta los campos con coma).
const alertTopic = alertableFields.join(', ');
// Source para /api/newsletter (sanitizado a 40 chars en el backend).
const alertSource = ('alert:' + alertableFields.join(',')).slice(0, 40);

// Smart Input Groups: agrupa fields con la misma key `group` para reducir
// carga cognitiva en calcs con muchos campos. Backwards-compatible:
// si ningún field tiene `group`, renderiza el grid plano como siempre.
type FieldGroup = { name?: string; icon?: string; fields: Field[] };
function groupFields(fields: Field[]): FieldGroup[] {
  const result: FieldGroup[] = [];
  const map = new Map<string, FieldGroup>();
  for (const f of fields) {
    const key = f.group || '__default__';
    let entry = map.get(key);
    if (!entry) {
      entry = { name: f.group, icon: f.groupIcon, fields: [] };
      map.set(key, entry);
      result.push(entry);
    }
    entry.fields.push(f);
  }
  return result;
}
const basicGroups = groupFields(basicFields);
const advancedGroups = groupFields(advancedFields);
const useGroupsBasic = basicGroups.some((g) => Boolean(g.name));
const useGroupsAdvanced = advancedGroups.some((g) => Boolean(g.name));

// Data freshness: formatear última actualización para calcs con datos externos
const dataUpdate = config.dataUpdate;
const showFreshness = dataUpdate && dataUpdate.frequency !== 'never';
// Fecha de dato UNIFICADA con la del badge del header: si la página nos pasó
// dataAsOfProp y es >= lastUpdated, la usamos (evita "Datos: 11 jun" en el header
// y "Datos actualizados: 22 abr" en el strip a 500px de distancia). ISO compara
// lexicográficamente bien.
const _lastUpd = dataUpdate?.lastUpdated || '';
const effectiveDataAsOf = (dataAsOfProp && /^\d{4}-\d{2}-\d{2}$/.test(dataAsOfProp) && dataAsOfProp >= _lastUpd)
  ? dataAsOfProp
  : (dataUpdate?.dataAsOf || dataUpdate?.lastUpdated || '');

// E-E-A-T: revisor + última revisión visible al usuario.
// `lastReviewed` aparece si está definido; `reviewer` muestra a la persona si la
// hay, sino cae al equipo editorial. Solo mostramos el bloque si tenemos al
// menos una de las dos señales — calcs sin metadata editorial no quedan con
// "Revisado por undefined".
const showReviewerBlock = Boolean(config.lastReviewed) || Boolean(config.reviewer);
const reviewerName = config.reviewer?.name || t.teamFallback;
const reviewerUrl = config.reviewer?.url;

// Embed inline: snippet server-rendered (no necesita JS para construirse) con
// crédito = backlink followable en la página anfitriona (marca→home, nombre→calc).
const embedOrigin = 'https://hacecuentas.com';
const embedSrc = `${embedOrigin}/embed/${config.slug}`;
const embedCalcUrl = `${embedOrigin}/${config.slug}`;
const embedCredit = `\n<p style="font-size:13px;text-align:center;margin:8px 0">Powered by <a href="${embedOrigin}" target="_blank" rel="noopener">Hacé Cuentas</a> — <a href="${embedCalcUrl}" target="_blank" rel="noopener">${config.h1}</a></p>`;
const embedSnippet = `<iframe src="${embedSrc}" width="100%" height="560" style="border:1px solid #e2e8f0;border-radius:12px;max-width:720px" loading="lazy" title="${config.h1}"></iframe>${embedCredit}`;
const reviewerRole = config.reviewer?.role;
const changelog = (config.changelog || []).filter((e) => e && e.date && e.change).slice(0, 8);
const freshnessMonthsByLang: Record<string, Record<string, string>> = {
  es: { '01': 'ene', '02': 'feb', '03': 'mar', '04': 'abr', '05': 'may', '06': 'jun',
        '07': 'jul', '08': 'ago', '09': 'sep', '10': 'oct', '11': 'nov', '12': 'dic' },
  en: { '01': 'Jan', '02': 'Feb', '03': 'Mar', '04': 'Apr', '05': 'May', '06': 'Jun',
        '07': 'Jul', '08': 'Aug', '09': 'Sep', '10': 'Oct', '11': 'Nov', '12': 'Dec' },
  pt: { '01': 'jan', '02': 'fev', '03': 'mar', '04': 'abr', '05': 'mai', '06': 'jun',
        '07': 'jul', '08': 'ago', '09': 'set', '10': 'out', '11': 'nov', '12': 'dez' },
};
const freshnessMonths = freshnessMonthsByLang[lang] || freshnessMonthsByLang.es;
const formatFreshnessDate = (iso: string): string => {
  const [y, m, d] = iso.split('-');
  // EN usa orden "Mon D, YYYY"; ES/PT usan "D mon YYYY".
  if (lang === 'en') return `${freshnessMonths[m] || m} ${parseInt(d, 10)}, ${y}`;
  return `${parseInt(d, 10)} ${freshnessMonths[m] || m} ${y}`;
};
---

<div class="calc-container" data-slug={config.slug} data-name={config.h1} data-formula={config.formulaId} data-auto-calculate={(config as any).autoCalculate ? 'true' : 'false'} data-lang={lang} data-translations={JSON.stringify(outputTranslations)}>
  <div class="calc-card-header">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="4" y="2" width="16" height="20" rx="2"/>
      <line x1="8" y1="6" x2="16" y2="6"/>
      <line x1="16" y1="14" x2="16" y2="18"/>
      <line x1="8" y1="10" x2="8" y2="10.01"/>
      <line x1="12" y1="10" x2="12" y2="10.01"/>
      <line x1="16" y1="10" x2="16" y2="10.01"/>
      <line x1="8" y1="14" x2="8" y2="14.01"/>
      <line x1="12" y1="14" x2="12" y2="14.01"/>
      <line x1="8" y1="18" x2="8" y2="18.01"/>
      <line x1="12" y1="18" x2="12" y2="18.01"/>
    </svg>
    <span>{t.calculator}</span>
    <span class="calc-card-badge">{t.badge}</span>
  </div>
  <!-- Historial: últimos cálculos del usuario (localStorage) — solo se muestra si hay entries -->
  <div class="calc-history" data-history-widget data-history-icon={config.icon || '📊'} hidden>
    <div class="history-head">
      <span class="history-title">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
        {t.recentCalcs}
      </span>
      <button type="button" class="history-clear" data-history-clear aria-label={t.clearHistory}>{t.clear}</button>
    </div>
    <div class="history-list" data-history-list></div>
  </div>

  {((showFreshness && dataUpdate) || showReviewerBlock) && (
  <div class="trust-strip">
  {showFreshness && dataUpdate && (
    <div class="data-freshness" title={dataUpdate.notes}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>
        <>{t.dataUpdated}: <time datetime={effectiveDataAsOf}>{formatFreshnessDate(effectiveDataAsOf)}</time></>
        {dataUpdate.source && (
          <>
            {` · ${t.sourceLabel}: `}
            {dataUpdate.sourceUrl ? (
              <a href={dataUpdate.sourceUrl} target="_blank" rel="noopener noreferrer">{dataUpdate.source}</a>
            ) : (
              <span>{dataUpdate.source}</span>
            )}
          </>
        )}
      </span>
    </div>
  )}

  {showReviewerBlock && (
    <div class="reviewer-block">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span>
        {t.reviewedBy}:{' '}
        {reviewerUrl ? (
          <a href={reviewerUrl} target="_blank" rel="noopener noreferrer">{reviewerName}</a>
        ) : !config.reviewer ? (
          <a href="/autores/martin-rodriguez" rel="author"><strong>{reviewerName}</strong></a>
        ) : (
          <strong>{reviewerName}</strong>
        )}
        {reviewerRole && <span class="reviewer-role"> — {reviewerRole}</span>}
        {!config.reviewer && (
          <>
            {' ('}
            <a href="/politica-editorial">{t.editorialPolicy}</a>
            {')'}
          </>
        )}
        {config.lastReviewed && (
          <>
            {' · '}{t.reviewedOn}:{' '}
            <time datetime={config.lastReviewed}>{formatFreshnessDate(config.lastReviewed)}</time>
          </>
        )}
      </span>
    </div>
  )}
  </div>
  )}

  {changelog.length > 0 && (
    <details class="calc-changelog">
      <summary>{t.changelogShow}</summary>
      <ul>
        {changelog.map((e) => (
          <li>
            <time datetime={e.date}>{formatFreshnessDate(e.date)}</time> — {e.change}
          </li>
        ))}
      </ul>
    </details>
  )}

  {config.presets && config.presets.items.length > 0 && (
    <div class="presets">
      {config.presets.title && <span class="presets-title">{config.presets.title}</span>}
      <div class="presets-list">
        {config.presets.items.map((p) => (
          <button
            type="button"
            class="preset-btn"
            data-preset={JSON.stringify(p.values)}
            title={p.note}
            aria-pressed="false"
          >
            {p.label}
          </button>
        ))}
      </div>
    </div>
  )}

  {/* Guard pre-hidratación: si el usuario toca Calcular antes de que el script
      principal ate handlers, prevenimos el GET default, encolamos el click
      (data-hc-queued) y prendemos el spinner del botón (.loading ya trae el
      texto t.calculating server-rendered). initCalculator lo destraba al final
      seteando data-hc-ready y dispara el cálculo encolado. */}
  <script is:inline data-astro-rerun>
(function(){var c=document.currentScript.parentElement;c.addEventListener('submit',function(e){var f=e.target;if(c.dataset.hcReady||!f.classList||!f.classList.contains('calc-form'))return;e.preventDefault();c.dataset.hcQueued='1';var b=f.querySelector('.btn-primary');if(b)b.classList.add('loading')},true)})();
  </script>
  <form id={`form-${config.slug}`} class="calc-form" data-calc-input novalidate>
    {useGroupsBasic ? (
      basicGroups.map((g) => (
        g.name ? (
          <fieldset class="input-group">
            <legend class="input-group-header">
              {g.icon && <span class="input-group-icon" aria-hidden="true">{g.icon}</span>}
              <span>{g.name}</span>
            </legend>
            <div class="fields-grid">
              {g.fields.map((field) => <FieldRow field={field} lang={lang} />)}
            </div>
          </fieldset>
        ) : (
          <div class="fields-grid">
            {g.fields.map((field) => <FieldRow field={field} lang={lang} />)}
          </div>
        )
      ))
    ) : (
      <div class="fields-grid">
        {basicFields.map((field) => <FieldRow field={field} lang={lang} />)}
      </div>
    )}

    {advancedFields.length > 0 && (
      <details class="advanced-toggle">
        <summary>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          {t.advancedOptions}
          <span class="adv-count">({advancedFields.length})</span>
        </summary>
        {useGroupsAdvanced ? (
          advancedGroups.map((g) => (
            g.name ? (
              <fieldset class="input-group">
                <legend class="input-group-header">
                  {g.icon && <span class="input-group-icon" aria-hidden="true">{g.icon}</span>}
                  <span>{g.name}</span>
                </legend>
                <div class="fields-grid advanced-grid">
                  {g.fields.map((field) => <FieldRow field={field} lang={lang} />)}
                </div>
              </fieldset>
            ) : (
              <div class="fields-grid advanced-grid">
                {g.fields.map((field) => <FieldRow field={field} lang={lang} />)}
              </div>
            )
          ))
        ) : (
          <div class="fields-grid advanced-grid">
            {advancedFields.map((field) => <FieldRow field={field} lang={lang} />)}
          </div>
        )}
      </details>
    )}

    <button type="submit" class="btn-primary">
      <span class="btn-content">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
          <line x1="5" y1="9" x2="19" y2="9"/>
          <line x1="5" y1="15" x2="19" y2="15"/>
        </svg>
        {t.calculate}
      </span>
      <span class="btn-spinner" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
        </svg>
        {t.calculating}
      </span>
    </button>
    <button type="button" class="btn-clear-form" data-clear-form>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      {lang === 'en' ? 'Clear data' : lang === 'pt' ? 'Limpar dados' : 'Borrar datos'}
    </button>
  </form>

  <div class="empty-preview" data-empty-preview aria-hidden="true">
    {config.presets && config.presets.items.length > 0 ? (
      <div class="empty-onboarding">
        <div class="empty-onboarding-head">
          <div class="empty-onboarding-icon" aria-hidden="true">{config.icon || '👇'}</div>
          <div class="empty-onboarding-meta">
            <div class="empty-onboarding-title">{t.tryExample}</div>
            <div class="empty-onboarding-sub">{t.orFillBelow}</div>
          </div>
        </div>
        <div class="empty-onboarding-presets">
          {config.presets.items.slice(0, 3).map((p) => (
            <button
              type="button"
              class="empty-preset-card preset-btn"
              data-preset={JSON.stringify(p.values)}
              title={p.note}
              aria-pressed="false"
            >
              <div class="empty-preset-card-text">
                <strong>{p.label}</strong>
                {p.note && <span>{p.note}</span>}
              </div>
              <span class="empty-preset-card-arrow" aria-hidden="true">→</span>
            </button>
          ))}
        </div>
      </div>
    ) : (
      <>
        <div class="empty-icon" aria-hidden="true">{config.icon}</div>
        <div class="empty-text">{t.emptyText}</div>
        <div class="empty-sub">{t.emptySub} <strong>{t.calculate}</strong></div>
        <div class="empty-microcopy">{lang === 'en' ? 'Private · no sign-up · instant.' : lang === 'pt' ? 'Privado · sem cadastro · na hora.' : 'Privado · sin registro · al instante.'}</div>
      </>
    )}
  </div>

  <div class="result-skeleton" data-result-skeleton hidden aria-hidden="true">
    <div class="skeleton-line skeleton-badge"></div>
    <div class="skeleton-line skeleton-label"></div>
    <div class="skeleton-line skeleton-hero"></div>
    <div class="skeleton-line skeleton-bar"></div>
  </div>

  <!-- Anuncio para lectores de pantalla: SIEMPRE en el DOM (fuera del bloque
       hidden) para que el cambio de texto se anuncie. El bloque .calc-results
       ya NO lleva aria-live: poblarlo mientras está hidden no se anuncia y
       animateValue mutaba el valor ~36 veces = spam. -->
  <div class="sr-only" role="status" aria-live="polite" data-sr-announce></div>

  <div class="calc-results" id={`results-${config.slug}`} hidden>
    <div class="results-header">
      <span class="results-badge">{t.resultBadge}</span>
    </div>
    <div class="results-grid">
      {config.outputs.map((out) => (
        <div class={`result ${out.primary ? 'primary' : ''}`} data-output={out.id} data-format={out.format} data-suffix={out.suffix || ''} data-primary={out.primary ? 'true' : 'false'}>
          {out.primary && out.contextChip && (
            <span class="result-context-chip">{out.contextChip}</span>
          )}
          <div class="result-label">{out.label}</div>
          <div class="result-value" data-value>{out.primary ? exampleBaseline : ''}</div>
          {out.primary && (
            <div class="result-tap-hint" data-tap-hint aria-hidden="true">{lang === 'en' ? 'Tap to copy' : lang === 'pt' ? 'Toque para copiar' : 'Tocá para copiar'}</div>
          )}
          {out.primary && out.compareBar && (
            <div class="result-compare">
              <div class="result-compare-bar" role="presentation">
                <div class="result-compare-fill" style={`width: ${Math.max(0, Math.min(100, out.compareBar.percent))}%`}></div>
              </div>
              <div class="result-compare-row">
                {out.compareBar.minLabel && <span class="result-compare-min">{out.compareBar.minLabel}</span>}
                {out.compareBar.label && <strong class="result-compare-label">{out.compareBar.label}</strong>}
              </div>
            </div>
          )}
          {out.primary && out.ctas && out.ctas.length > 0 && (
            <div class="result-ctas">
              {out.ctas.map((cta) => (
                cta.href ? (
                  <a class="result-cta" href={cta.href}>
                    {cta.icon && <span class="result-cta-icon" aria-hidden="true">{cta.icon}</span>}
                    <span>{cta.label}</span>
                  </a>
                ) : (
                  <button type="button" class="result-cta" data-action={cta.action || undefined}>
                    {cta.icon && <span class="result-cta-icon" aria-hidden="true">{cta.icon}</span>}
                    <span>{cta.label}</span>
                  </button>
                )
              ))}
            </div>
          )}
          {out.primary && config.resultContext && config.resultContext.equivalencias.length > 0 && (
            <ResultContext
              equivalencias={config.resultContext.equivalencias}
              minValue={config.resultContext.minValue}
              lang={lang}
            />
          )}
        </div>
      ))}
    </div>

    {/* Comparación con el cálculo anterior de ESTA calc (mismo output primary).
        El cliente la rellena tras recalcular si hay un resultado previo. */}
    <div class="result-compare-prev" data-compare-prev hidden></div>

    {/* Caja de insight narrativa. La fórmula devuelve output._insight (string
        o {title,text,tone,icon}) y el cliente la renderiza acá: explica qué
        significa el resultado en lenguaje claro. Retrocompatible: si la fórmula
        no lo devuelve, queda oculta. */}
    <div class="result-insight" data-insight hidden></div>

    {/* Cálculo paso a paso. La fórmula devuelve output._steps (array de
        {label, value} o {label, expr, value}) y el cliente renderiza un
        <details> colapsable. Si no hay _steps, queda oculto. */}
    <details class="result-steps" data-steps hidden>
      <summary class="result-steps-summary">{lang === 'en' ? 'See step-by-step calculation' : lang === 'pt' ? 'Ver cálculo passo a passo' : 'Ver cálculo paso a paso'}</summary>
      <ol class="result-steps-list" data-steps-list></ol>
    </details>

    {config.visualization && (
      <Visualization title={config.visualization.title} data={config.visualization.data} />
    )}

    {config.whatChanged && (
      <WhatChanged
        title={config.whatChanged.title}
        value={config.whatChanged.value}
        updatedLabel={config.whatChanged.updatedLabel}
        diffs={config.whatChanged.diffs}
        history={config.whatChanged.history}
        historyLabels={config.whatChanged.historyLabels}
      />
    )}

    {config.scenarios && (
      <ScenarioComparator
        title={config.scenarios.title}
        current={config.scenarios.current}
        alternative={config.scenarios.alternative}
        summary={config.scenarios.summary}
        summaryIcon={config.scenarios.summaryIcon}
      />
    )}

    {config.dynamicScenarios && config.dynamicScenarios.length > 0 && (
      <section
        class="dynamic-scenarios"
        data-dynamic-scenarios
        data-scenarios={JSON.stringify(config.dynamicScenarios)}
        hidden
      >
        <div class="dynamic-scenarios-head">
          <span class="dynamic-scenarios-title">¿Y si...?</span>
          <span class="dynamic-scenarios-sub">Comparativa con tus datos</span>
        </div>
        <div class="dynamic-scenarios-grid" data-dynamic-scenarios-grid></div>
      </section>
    )}

    <button
      type="button"
      class="back-to-input"
      data-back-to-input
      aria-label={lang === 'en' ? 'Back to form' : lang === 'pt' ? 'Voltar ao formulário' : 'Volver al formulario'}
      onclick={`document.querySelector('[data-calc-input]').scrollIntoView({behavior:'smooth',block:'start'})`}
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
      <span>Modificar datos</span>
    </button>

    <div class="chart-wrap" data-chart-wrap hidden>
      {/* Tabs de gráfico. Se llenan client-side cuando la fórmula devuelve
          output._charts (array de specs con label). Con un solo gráfico
          (output._chart) quedan ocultas y el comportamiento es el de siempre. */}
      <div class="chart-tabs" data-chart-tabs role="tablist" hidden></div>
      <canvas data-chart-canvas role="img" aria-label={t.chartAriaLabel}></canvas>
      <button type="button" class="chart-download-btn" data-chart-download aria-label={t.downloadPng} title={t.downloadPng}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>PNG</span>
      </button>
    </div>

    {/* Tabla de resultado dinámica (ej. cronograma de amortización). La fórmula
        devuelve output._table y el cliente la renderiza acá. Colapsable si es larga. */}
    <div class="result-table-wrap" data-table-wrap hidden></div>

    {config.interactive && config.interactive.sliders && config.interactive.sliders.length > 0 && (
      <div class="what-if" data-what-if hidden>
        <div class="what-if-head">
          <span class="what-if-badge">{t.whatIfBadge}</span>
          <span class="what-if-hint">{t.whatIfHint}</span>
        </div>
        <div class="what-if-sliders">
          {config.interactive.sliders.map((s) => (
            <div class="what-if-slider" data-what-if-slider data-field={s.fieldId} data-format={s.format || 'number'} data-prefix={s.prefix || ''} data-suffix={s.suffix || ''}>
              <div class="what-if-row">
                <label>{s.label}</label>
                <span class="what-if-value" data-slider-value>—</span>
              </div>
              <input type="range" min={s.min} max={s.max} step={s.step} data-slider-input aria-label={s.label} />
              <div class="what-if-range">
                <span>{s.prefix || ''}{s.min.toLocaleString('es-AR')}{s.suffix || ''}</span>
                <span>{s.prefix || ''}{s.max.toLocaleString('es-AR')}{s.suffix || ''}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {disclaimer && (
      <div class="inline-disclaimer" role="note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>{disclaimer}</span>
      </div>
    )}

    <div class="share">
      <span class="share-label">{t.share}</span>
      <button type="button" class="btn-share" data-action="copy-result">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <span data-copy-result-label>{t.copyResult}</span>
      </button>
      <button type="button" class="btn-share btn-share-whatsapp-cta" data-action="whatsapp" aria-label={t.shareWhatsApp} title={t.shareWhatsApp}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        {lang === 'pt' ? '📲 Receba no WhatsApp' : lang === 'en' ? '📲 Send to my WhatsApp' : '📲 Mandate el resultado'}
      </button>
      <button type="button" class="btn-share" data-action="copy-link" title={t.copyLinkTitle}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        <span data-copy-link-label>{t.copyLink}</span>
      </button>
      <button type="button" class="btn-share" data-action="print" title={t.sharePrint}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        PDF
      </button>
      <button type="button" class="btn-share" data-action="share-image" title={lang === 'en' ? 'Share the result as an image' : lang === 'pt' ? 'Compartilhar o resultado como imagem' : 'Compartir el resultado como imagen'}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        {lang === 'en' ? 'Image' : lang === 'pt' ? 'Imagem' : 'Imagen'}
      </button>
      {config.calendarReminder && (
        <button
          type="button"
          class="btn-share btn-share-calendar"
          data-action="calendar"
          data-calendar-date={config.calendarReminder.date}
          data-calendar-title={config.calendarReminder.title}
          data-calendar-description={config.calendarReminder.description || ""}
          data-calendar-reminder-days={String(config.calendarReminder.reminderDaysBefore ?? 3)}
          title="Descargar recordatorio (.ics) — funciona con Google Calendar, Apple, Outlook"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Agendar
        </button>
      )}
      <button type="button" class="btn-share" data-action="reset">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        {t.newCalc}
      </button>
      <ShareBottomSheet lang={lang} showCalendar={!!config.calendarReminder} />
    </div>

    <!-- Email capture CTA -->
    <div class="email-capture" data-email-capture style="display:none">
      <p class="email-heading"><strong>{t.emailHeading}</strong></p>
      <form class="email-form" data-email-form>
        <input type="email" placeholder={t.emailPlaceholder} required data-email-input>
        <button type="submit" data-label-sending={t.sending}>{t.send}</button>
      </form>
      <p class="email-note">{t.emailNote}</p>
      <p class="email-success" data-email-status style="display:none" data-msg-sent={t.emailSuccess} data-msg-saved={t.emailSaved} data-msg-error={t.emailError}></p>
    </div>

    <!-- Calc usage counter -->
    <div class="calc-counter" data-calc-counter style="display:none"></div>

    {alertableFields.length > 0 && (
      <div class="data-alert" data-data-alert data-alert-source={alertSource}>
        <p class="data-alert-heading">
          <span class="data-alert-bell" aria-hidden="true">🔔</span>
          <strong>{lang === 'en' ? `Notify me when ${alertTopic} changes` : lang === 'pt' ? `Avise-me quando ${alertTopic} mudar` : `Avisame cuando cambie ${alertTopic}`}</strong>
        </p>
        <form class="data-alert-form" data-data-alert-form>
          <input type="email" placeholder={t.emailPlaceholder} required data-data-alert-input aria-label={t.emailPlaceholder}>
          <button type="submit">{lang === 'en' ? 'Notify me' : lang === 'pt' ? 'Avisar' : 'Avisarme'}</button>
        </form>
        <p class="data-alert-note">{t.emailNote}</p>
        <p class="data-alert-success" data-data-alert-success hidden>{lang === 'en' ? 'Done. We will email you when it changes.' : lang === 'pt' ? 'Pronto. Avisaremos por e-mail quando mudar.' : 'Listo. Te avisamos por email cuando cambie.'}</p>
      </div>
    )}

    <!-- Feedback inline: thumbs + comentario opcional -->
    <div class="feedback" data-feedback>
      <!-- Prueba social real: se rellena client-side solo si up ≥ 30 -->
      <div class="social-proof" data-social-proof hidden></div>
      <div class="feedback-prompt" data-feedback-prompt>
        <span>{t.helpful}</span>
        <button type="button" class="fb-btn" data-feedback-vote="up" aria-label={t.yesAria}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H7V10l4-8a1 1 0 0 1 1 .52z" fill="none"/></svg>
          {t.yes}
        </button>
        <button type="button" class="fb-btn" data-feedback-vote="down" aria-label={t.noAria}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H17v12l-4 8a1 1 0 0 1-1-.52z" fill="none"/></svg>
          {t.no}
        </button>
      </div>
      <div class="feedback-followup" data-feedback-followup hidden>
        <label for={`fb-msg-${config.slug}`} class="fb-label" data-feedback-label></label>
        <textarea id={`fb-msg-${config.slug}`} rows="2" maxlength="500" placeholder={t.feedback} data-feedback-text></textarea>
        <button type="button" class="fb-send" data-feedback-send>{t.send}</button>
      </div>
      <div class="feedback-thanks" data-feedback-thanks hidden>{lang === 'en' ? 'Thanks! Your feedback helps us improve.' : '¡Gracias! Tu feedback nos ayuda a mejorar.'}</div>
    </div>
  </div>

  <div class="calc-error" id={`error-${config.slug}`} hidden role="alert"></div>

  <!-- Embed: banner desplegable, SIEMPRE visible (no sólo tras calcular). Es el
       motor de backlinks. <details> = se despliega el código SIN depender del JS
       de la calc (que en dev no corre); el copiar lo maneja el <script is:inline>
       de abajo (corre en dev y prod, con fallback execCommand para webviews). -->
  <details class="embed-cta" data-embed data-slug={config.slug}>
    <summary class="embed-cta-summary">
      <span class="embed-cta-copy">
        <strong class="embed-cta-title">{lang === 'en' ? 'Have a website? Embed this calculator for free' : lang === 'pt' ? 'Tem um site? Incorpore esta calculadora grátis' : '¿Tenés una web? Incrustá esta calculadora gratis'}</strong>
        <span class="embed-hint">{t.embedHint}</span>
      </span>
      <span class="btn-embed">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <span class="btn-embed-label">{t.embed}</span>
        <svg class="embed-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </span>
    </summary>
    <div class="embed-panel">
      <pre class="embed-code"><code>{embedSnippet}</code></pre>
      <div class="embed-panel-actions">
        <button type="button" class="btn-primary embed-copy-btn" data-embed-copy
          data-label={lang === 'en' ? 'Copy code' : 'Copiar código'}
          data-copied={lang === 'en' ? 'Copied!' : lang === 'pt' ? 'Copiado!' : '¡Copiado!'}
          data-manual={lang === 'en' ? 'Select & press Ctrl+C' : lang === 'pt' ? 'Selecione e Ctrl+C' : 'Seleccioná y Ctrl+C'}>{lang === 'en' ? 'Copy code' : 'Copiar código'}</button>
        <a href={embedSrc} target="_blank" rel="noopener" class="embed-preview-link">{lang === 'en' ? 'Preview →' : lang === 'pt' ? 'Pré-visualizar →' : 'Ver preview →'}</a>
      </div>
      <p class="embed-panel-note">{lang === 'en' ? 'Paste it on your site. Keep the credit link — thanks for sharing.' : lang === 'pt' ? 'Cole no seu site. Mantenha o link de crédito — obrigado por compartilhar.' : 'Pegalo en tu sitio. Dejá el link de crédito — gracias por compartir.'} <a href={`${embedOrigin}/embeber`} target="_blank" rel="noopener">{lang === 'en' ? 'More widgets →' : lang === 'pt' ? 'Mais widgets →' : 'Más widgets →'}</a></p>
    </div>
  </details>
  <script is:inline>
    (function () {
      var s = document.currentScript;
      var root = s && s.previousElementSibling;
      while (root && !(root.matches && root.matches('details.embed-cta[data-embed]'))) root = root.previousElementSibling;
      if (!root || root.dataset.embedWired) return;
      root.dataset.embedWired = '1';
      var btn = root.querySelector('[data-embed-copy]');
      var codeEl = root.querySelector('.embed-code code');
      if (btn && codeEl) {
        var resetT;
        var finish = function (ok) {
          clearTimeout(resetT);
          if (ok) {
            btn.textContent = btn.getAttribute('data-copied');
            btn.classList.add('copied');
            if (typeof window.gtag === 'function') window.gtag('event', 'embed_copy', { calc_slug: root.getAttribute('data-slug') || '' });
          } else {
            try { var rg = document.createRange(); rg.selectNodeContents(codeEl); var sl = window.getSelection(); sl.removeAllRanges(); sl.addRange(rg); } catch (e) {}
            btn.textContent = btn.getAttribute('data-manual');
          }
          resetT = setTimeout(function () { btn.textContent = btn.getAttribute('data-label'); btn.classList.remove('copied'); }, 1900);
        };
        var fallbackCopy = function () {
          var ok = false;
          try {
            var ta = document.createElement('textarea');
            ta.value = codeEl.textContent || '';
            ta.style.position = 'fixed'; ta.style.top = '0'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.focus(); ta.select();
            ok = document.execCommand('copy');
            document.body.removeChild(ta);
          } catch (e) {}
          finish(ok);
        };
        btn.addEventListener('click', function () {
          var code = codeEl.textContent || '';
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(code).then(function () { finish(true); }, fallbackCopy);
              return;
            }
          } catch (e) {}
          fallbackCopy();
        });
      }
      root.addEventListener('toggle', function () {
        if (root.open && typeof window.gtag === 'function') window.gtag('event', 'embed_open', { calc_slug: root.getAttribute('data-slug') || '' });
      });
    })();
  </script>
</div>

<StickyResultPill lang={lang} />

<style>
  /* Botón "Modificar datos": solo visible en mobile dentro de la sección
     de results. Permite al usuario volver al formulario sin scroll manual
     después de ver el resultado y la explicación. */
  .back-to-input {
    display: none;
    align-items: center;
    gap: 6px;
    margin: 12px 0 4px;
    padding: 8px 14px;
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .back-to-input:hover { background: var(--accent); color: var(--bg-card); }
  @media (max-width: 720px) {
    .back-to-input { display: inline-flex; }
  }

  .calc-container {
    background: var(--bg-card);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: 0;
    margin-bottom: 2rem;
    /* Caja protagonista pero sin "glow" ruidoso: la jerarquía la dan el borde
       accent + la barra de gradiente superior (::before), no una sombra azul
       de 3 capas. Dejamos un anillo accent tenue + una elevación suave. */
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent),
      0 4px 16px -6px rgba(15, 23, 42, 0.12);
    position: relative;
    overflow: hidden;
  }

  .calc-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 60%, #a78bfa));
    z-index: 1;
  }

  .calc-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-card));
    border-bottom: 1px solid var(--border);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.01em;
  }
  .calc-card-header svg {
    opacity: 0.85;
  }
  .calc-card-badge {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-soft);
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    letter-spacing: 0.02em;
  }

  .calc-container > :not(.calc-card-header):not(.calc-results):not(.embed-cta) {
    padding-left: 1.75rem;
    padding-right: 1.75rem;
  }
  .calc-container > .calc-history { padding-top: 1rem; }
  .calc-container > .trust-strip { margin-top: 1.25rem; }
  .calc-container > .calc-changelog { margin-left: 1.75rem; margin-right: 1.75rem; margin-top: 0.5rem; }
  .calc-container > .presets { padding-top: 1.25rem; margin-left: 1.75rem; margin-right: 1.75rem; padding-left: 0; padding-right: 0; }
  .calc-container > .calc-form { padding: 1.5rem 1.75rem; }
  .calc-container > .calc-error { margin: 0 1.75rem 1rem; }
  /* embed-cta ahora es hijo directo del container (siempre visible, no sólo
     tras calcular). Lo insetamos como el form (1.75rem) + aire arriba/abajo. */
  .calc-container > .embed-cta { margin: 1.5rem 1.75rem; }

  .calc-form { display: block; }

  /* Presets (valores sugeridos tipo botones de bancos) */
  .data-freshness {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    margin-bottom: 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.3;
  }
  .data-freshness svg {
    flex-shrink: 0;
    color: var(--accent);
  }
  .data-freshness time { font-weight: 600; color: var(--text); }
  .data-freshness a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .data-freshness a:hover { text-decoration: underline; }

  .reviewer-block {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    margin-bottom: 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.3;
  }
  .reviewer-block svg { flex-shrink: 0; color: var(--accent); }
  .reviewer-block strong { color: var(--text); font-weight: 600; }
  .reviewer-block time { font-weight: 600; color: var(--text); }
  .reviewer-block a { color: var(--accent); text-decoration: none; font-weight: 500; }
  .reviewer-block a:hover { text-decoration: underline; }
  .reviewer-block .reviewer-role { color: var(--text-subtle); font-style: italic; }

  /* Trust strip — agrupa frescura de datos + revisor en UNA banda coherente
     (antes: 2 chips grises sueltos apilados). Desktop: lado a lado; mobile:
     apilan. Refuerza E-E-A-T concentrando las señales de confianza. */
  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem;
  }
  .trust-strip .data-freshness,
  .trust-strip .reviewer-block {
    margin: 0;
    flex: 1 1 240px;
  }

  .calc-changelog {
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .calc-changelog summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--accent);
    user-select: none;
  }
  .calc-changelog summary:hover { text-decoration: underline; }
  .calc-changelog ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .calc-changelog li { margin-bottom: 0.25rem; line-height: 1.5; }
  .calc-changelog time { font-weight: 600; color: var(--text); }

  .presets {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--border);
  }
  .presets-title {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    font-weight: 500;
  }
  .presets-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .preset-btn {
    padding: 0.4375rem 0.875rem;
    background: var(--bg-soft);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .preset-btn:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-strong);
  }
  .preset-btn.active {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  /* Hit-target táctil: en pantallas touch los pills suben al mínimo de 44px
     de alto recomendado para área tappable cómoda con el dedo. */
  @media (pointer: coarse) {
    .preset-btn { min-height: 44px; }
  }

  .fields-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }
  /* Calcs de un solo campo: el auto-fit estiraría el único input a todo el
     ancho del card (se ve un campo gigante y solitario). Lo acotamos para que
     respire y mantenga proporción de formulario real. */
  .fields-grid:has(> .field:only-child):not(.advanced-grid) {
    max-width: 460px;
  }

  /* Smart Input Groups — fieldset con header visual cuando los fields tienen `group` */
  .input-group {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.125rem 0.5rem;
    margin: 0 0 0.875rem;
    transition: border-color 0.15s ease;
  }
  .input-group:hover {
    border-color: var(--border-strong);
  }
  .input-group + .input-group {
    margin-top: -0.25rem;
  }
  .input-group-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.875rem;
    padding: 0;
    line-height: 1;
  }
  .input-group-header::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 14px;
    background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 60%, #7c3aed));
    border-radius: 99px;
  }
  .input-group-icon {
    font-size: 1rem;
    line-height: 1;
  }
  .input-group .fields-grid {
    margin-bottom: 0.75rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
  }

  .field-wide { grid-column: 1 / -1; }

  label {
    font-weight: 500;
    font-size: 0.875rem;
