    line-height: 1.5;
  }
  :global(.result-insight[hidden]) { display: none; }
  :global(.result-insight--good) { border-left-color: #10b981; }
  :global(.result-insight--warn) { border-left-color: #f59e0b; }
  :global(.result-insight-icon) { font-size: 1.15rem; line-height: 1.3; flex-shrink: 0; }
  :global(.result-insight-body) { display: flex; flex-direction: column; gap: 0.15rem; }
  :global(.result-insight-title) { font-size: 0.95rem; color: var(--text); }
  :global(.result-insight-text) { color: var(--text-muted); }
  :global(.result-insight-text strong) { color: var(--text); font-weight: 700; }

  /* ── Tabla de resultado dinámica (amortización, cronogramas) ──
     Render client-side (renderResultTable → innerHTML) → SIN scope de Astro.
     Los selectores van en :global() o no aplicarían (era el bug del "sin formato"). */
  :global(.result-table-wrap) {
    margin: 1.25rem 0 0.5rem;
  }
  :global(.result-table-wrap[hidden]) { display: none; }
  :global(.result-table-title) {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    margin-bottom: 0.625rem;
  }
  :global(.result-table-scroll) {
    max-height: 440px;
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    -webkit-overflow-scrolling: touch;
  }
  :global(table.result-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  :global(table.result-table thead th) {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--bg-muted);
    color: var(--text);
    font-weight: 700;
    text-align: left;
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    border-bottom: 1px solid var(--border);
  }
  :global(table.result-table tbody td) {
    padding: 0.4375rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle, var(--border));
    color: var(--text);
    white-space: nowrap;
  }
  :global(table.result-table tbody tr:nth-child(even) td) {
    background: color-mix(in srgb, var(--bg-muted) 35%, transparent);
  }
  :global(table.result-table tbody tr.result-table-row-emph td) {
    border-bottom: 2px solid var(--accent);
    font-weight: 600;
  }
  :global(table.result-table tfoot th) {
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-weight: 800;
    color: var(--text);
    background: var(--bg-muted);
    border-top: 2px solid var(--border);
    position: sticky;
    bottom: 0;
    white-space: nowrap;
  }
  :global(.result-table-note) {
    font-size: 0.6875rem;
    color: var(--text-subtle);
    margin: 0.5rem 0.125rem 0;
  }
  :global(.result-table-toggle) {
    margin-top: 0.625rem;
    width: 100%;
    padding: 0.5rem 0.875rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  :global(.result-table-toggle:hover) { background: var(--bg-muted); }
  .chart-download-btn {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.55rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
    z-index: 2;
  }
  .chart-download-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--bg);
  }
  .chart-wrap canvas {
    display: block;
    width: 100% !important;
    max-width: 100%;
    height: 280px !important;
  }
  @media (max-width: 640px) {
    .chart-wrap canvas { height: 240px !important; }
    .chart-wrap { padding: 0.625rem; }
  }

  /* What-if interactive sliders */
  .what-if {
    margin-top: 1rem;
    padding: 1rem 1.125rem 1.125rem;
    background: linear-gradient(135deg, rgba(37,99,235,0.06), rgba(37,99,235,0.02));
    border: 1px solid rgba(37,99,235,0.22);
    border-radius: var(--radius-sm);
  }
  :root[data-theme="dark"] .what-if {
    background: linear-gradient(135deg, rgba(96,165,250,0.08), rgba(96,165,250,0.03));
    border-color: rgba(96,165,250,0.25);
  }
  .what-if[hidden] { display: none; }
  .what-if-head {
    display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap;
    margin-bottom: 0.875rem;
  }
  .what-if-badge {
    font-weight: 700; font-size: 0.9375rem; color: var(--accent-strong);
  }
  .what-if-hint {
    font-size: 0.8125rem; color: var(--muted);
  }
  .what-if-sliders {
    display: grid; gap: 0.875rem;
  }
  .what-if-slider {
    display: grid; gap: 0.375rem;
  }
  .what-if-row {
    display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem;
  }
  .what-if-row label {
    font-size: 0.8125rem; font-weight: 600; color: var(--text);
  }
  .what-if-value {
    font-variant-numeric: tabular-nums; font-weight: 700;
    color: var(--accent-strong); font-size: 0.9375rem;
  }
  .what-if-slider input[type=range] {
    width: 100%; margin: 0;
    accent-color: var(--accent);
    height: 6px;
  }
  .what-if-range {
    display: flex; justify-content: space-between;
    font-size: 0.6875rem; color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* Dynamic Scenarios — ¿Y si...? lado a lado */
  .dynamic-scenarios {
    margin-top: 1.25rem;
    padding: 1rem 1.125rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .dynamic-scenarios[hidden] { display: none; }
  .dynamic-scenarios-head {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
    flex-wrap: wrap;
  }
  .dynamic-scenarios-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
  }
  .dynamic-scenarios-sub {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }
  .dynamic-scenarios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.625rem;
  }
  .dynamic-scenario-card {
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 0.875rem 0.875rem 0.75rem;
    position: relative;
  }
  .dynamic-scenario-card--current {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .dynamic-scenario-tag {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-subtle);
    margin-bottom: 0.5rem;
  }
  .dynamic-scenario-card--current .dynamic-scenario-tag {
    color: var(--accent-strong);
  }
  .dynamic-scenario-value {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.25rem;
    overflow-wrap: anywhere;
  }
  .dynamic-scenario-card--current .dynamic-scenario-value {
    background: linear-gradient(135deg, var(--accent-strong), color-mix(in srgb, var(--accent-strong) 60%, #7c3aed));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--accent-strong);
  }
  .dynamic-scenario-label {
    font-size: 0.6875rem;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }
  .dynamic-scenario-detail {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.375rem;
    line-height: 1.3;
  }
  .dynamic-scenario-diff {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .dynamic-scenario-diff--up { color: var(--success); }
  .dynamic-scenario-diff--down { color: var(--danger); }
  @media (max-width: 480px) {
    .dynamic-scenarios { padding: 0.875rem; }
    .dynamic-scenario-card { padding: 0.75rem; }
    .dynamic-scenario-value { font-size: 1.125rem; }
  }

  /* Disclaimer inline */
  .inline-disclaimer {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background: var(--warning-soft);
    border: 1px solid color-mix(in srgb, var(--warning) 35%, transparent);
    border-left: 3px solid var(--warning);
    border-radius: var(--radius-sm);
    color: var(--warning-text);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .inline-disclaimer svg {
    flex-shrink: 0;
    color: var(--warning);
    margin-top: 1px;
  }

  /* Share */
  .share {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .share-label {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    font-weight: 500;
    margin-right: 0.25rem;
  }

  .btn-share {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: var(--bg);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
    cursor: pointer;
  }

  .btn-share:hover {
    background: var(--bg-muted);
    color: var(--text);
    border-color: var(--border-strong);
  }

  .btn-share[data-action="whatsapp"]:hover {
    color: #25d366;
    border-color: #25d366;
    background: #25d36610;
  }

  .btn-share.copied {
    background: var(--success-soft);
    color: var(--success);
    border-color: var(--success);
  }

  /* En mobile, ocultamos los share buttons individuales y mostramos solo
     el trigger del ShareBottomSheet (que aparece como single button "Compartir"). */
  @media (max-width: 767px) {
    .share {
      flex-direction: column;
      align-items: stretch;
    }
    .share .share-label,
    .share .btn-share {
      display: none;
    }
  }

  /* Embed CTA — banner desplegable (details/summary): se despliega el código
     inline sin depender de JS, y el botón copia con fallback. */
  .embed-cta {
    margin-top: 1.5rem;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .embed-cta-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    flex-wrap: wrap;
    -webkit-tap-highlight-color: transparent;
  }
  .embed-cta-summary::-webkit-details-marker { display: none; }
  .embed-cta-copy {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .embed-cta-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
  }
  .embed-hint {
    font-size: 0.8rem;
    color: var(--text-subtle);
  }
  .btn-embed {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.35rem;
    background: var(--accent);
    color: #fff;
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
    transition: transform 0.15s, box-shadow 0.15s, background-color 0.15s;
  }
  .embed-cta-summary:hover .btn-embed {
    background: color-mix(in srgb, var(--accent) 88%, black);
    box-shadow: 0 2px 10px color-mix(in srgb, var(--accent) 35%, transparent);
    transform: translateY(-1px);
  }
  .embed-chevron { transition: transform 0.2s ease; opacity: 0.9; }
  .embed-cta[open] .embed-chevron { transform: rotate(180deg); }
  .embed-panel {
    padding: 0 1.25rem 1.25rem;
    animation: embed-reveal 0.18s ease-out;
  }
  @keyframes embed-reveal {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }
  .embed-code {
    margin: 0 0 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--text);
  }
  .embed-code code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .embed-panel-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .embed-copy-btn { cursor: pointer; white-space: nowrap; }
  .embed-copy-btn.copied {
    background: #16a34a;
    border-color: #16a34a;
    color: #fff;
  }
  .embed-preview-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .embed-preview-link:hover { text-decoration: underline; }
  .embed-panel-note {
    font-size: 0.78rem;
    color: var(--text-subtle);
    margin: 0.75rem 0 0;
    line-height: 1.45;
  }
  .embed-panel-note a { color: var(--accent); }

  /* Error */
  .calc-error {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    background: var(--danger-soft);
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
    border-left: 3px solid var(--danger);
    border-radius: var(--radius-sm);
    color: var(--danger);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .calc-error[hidden] { display: none; }

  .calc-error::before {
    content: '';
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23dc2626' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3ccircle cx='12' cy='12' r='10'/%3e%3cline x1='12' y1='8' x2='12' y2='12'/%3e%3cline x1='12' y1='16' x2='12.01' y2='16'/%3e%3c/svg%3e");
    background-size: contain;
  }

  /* Historial de cálculos (localStorage) */
  .calc-history[hidden] { display: none; }
  .calc-history {
    margin: -0.5rem 0 1.25rem;
    padding: 0.75rem 0.875rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    min-height: 0;
    transition: min-height 0.2s;
    will-change: min-height;
  }
  .history-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .history-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .history-clear {
    background: none;
    border: none;
    color: var(--text-subtle);
    font-size: 0.75rem;
    cursor: pointer;
    padding: 0 0.25rem;
  }
  .history-clear:hover { color: var(--danger); }
  .history-list {
    display: grid;
    gap: 0.375rem;
  }
  .history-item {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.625rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--text);
    cursor: pointer;
    display: flex;
    gap: 0.625rem;
    align-items: center;
    text-align: left;
    font-family: inherit;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
    width: 100%;
  }
  .history-item:hover,
  .history-item:focus-visible {
    background: var(--bg-card);
    border-color: var(--accent);
    transform: translateX(2px);
    outline: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .history-item { transition: none; }
    .history-item:hover { transform: none; }
  }
  .history-item-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .history-item-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    line-height: 1.2;
  }
  .history-item-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .history-item-time {
    font-size: 0.6875rem;
    color: var(--text-subtle);
    margin-top: 0.125rem;
  }
  .history-item-value {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    margin-left: auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 45%;
  }
  html[data-theme="dark"] .history-item-value {
    color: var(--accent-strong);
  }

  /* Feedback inline */
  .feedback {
    margin-top: 1rem;
    padding-top: 0.875rem;
    border-top: 1px dashed var(--border);
    font-size: 0.8125rem;
  }
  .feedback-prompt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }
  .fb-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.625rem;
    background: var(--bg);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .fb-btn:hover {
    background: var(--bg-muted);
    color: var(--text);
    border-color: var(--border-strong);
  }
  /* Tap target ≥44px en touch (Apple HIG / WCAG 2.5.5) */
  @media (pointer: coarse) {
    .fb-btn { min-height: 44px; }
  }
  .fb-btn[data-feedback-vote="up"].selected {
    background: var(--success-soft);
    color: var(--success-text);
    border-color: var(--success);
  }
  .fb-btn[data-feedback-vote="down"].selected {
    background: var(--danger-soft);
    color: var(--danger);
    border-color: var(--danger);
  }
  .feedback-followup {
    margin-top: 0.625rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .fb-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .feedback-followup textarea {
    width: 100%;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    line-height: 1.4;
    resize: vertical;
    font-family: inherit;
  }
  .feedback-followup textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .fb-send {
    align-self: flex-start;
    padding: 0.4rem 0.875rem;
    background: var(--accent);
    color: var(--on-accent);
    border: none;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .fb-send:hover { background: var(--accent-hover); }
  .feedback-thanks {
    color: var(--success);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  /* Email capture CTA */
  .email-capture {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
    border-radius: var(--radius-sm);
  }
  .email-heading {
    font-size: 0.875rem;
    color: var(--text);
    margin: 0 0 0.625rem;
