</style>

<script>
  // Lazy loading por fórmula — Vite genera 1 chunk por archivo (.ts), cargado on-demand.
  // El MAPA de loaders (~3.400 dynamic imports) vive en su propio chunk
  // (src/lib/formula-loader-map.ts): tenerlo inline acá inflaba ESTE bundle de
  // ~48KB a 664KB raw. Fire-eager: el chunk del mapa baja en paralelo mientras
  // el usuario completa el form; loadFormula() recién lo espera al usarlo.
  const _loaderMapPromise = import('../lib/formula-loader-map');
  const formulaCache = new Map<string, Function>();

  // Session ID para correlacionar funnel en GA4 (calculator_used → share → …).
  // GA4 ya tiene su session_id interno, pero no es accesible desde el cliente
  // para joins custom en BigQuery/Looker. Generamos uno propio persistido en
  // sessionStorage (misma pestaña/sesión, se limpia al cerrar).
  function hcSessionId(): string {
    try {
      const KEY = 'hc_sid';
      let sid = sessionStorage.getItem(KEY);
      if (!sid) {
        sid = (crypto?.randomUUID?.() ?? `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`);
        sessionStorage.setItem(KEY, sid);
      }
      return sid;
    } catch {
      // sessionStorage bloqueado (Safari private mode, etc.) — devolver id volátil
      return `v-${Date.now().toString(36)}`;
    }
  }

  async function loadFormula(formulaId: string): Promise<Function | null> {
    if (formulaCache.has(formulaId)) return formulaCache.get(formulaId)!;
    let formulaLoaders: Record<string, () => Promise<any>>;
    try {
      ({ formulaLoaders } = await _loaderMapPromise);
    } catch {
      // El chunk del mapa no bajó (red caída) → mismo flujo que "fórmula no
      // encontrada": executeFormula muestra el error con Reintentar.
      return null;
    }
    // Keys relativas a formula-loader-map.ts, NO a este archivo.
    const loader = formulaLoaders[`./formulas/${formulaId}.ts`];
    if (!loader) return null;
    const mod: any = await loader();
    // Encontrar la función exportada (cualquier export de tipo function)
    const fnKey = Object.keys(mod).find((k) => typeof mod[k] === 'function');
    if (!fnKey) return null;
    formulaCache.set(formulaId, mod[fnKey]);
    return mod[fnKey];
  }

  // ── Chart.js lazy loader (singleton) ─────────────────────────
  const CHART_CDN = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js';
  let chartJsPromise: Promise<any> | null = null;
  function loadChartJs(): Promise<any> {
    if ((window as any).Chart) return Promise.resolve((window as any).Chart);
    if (chartJsPromise) return chartJsPromise;
    chartJsPromise = new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = CHART_CDN;
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.onload = () => resolve((window as any).Chart);
      s.onerror = () => {
        chartJsPromise = null;
        reject(new Error('No se pudo cargar Chart.js'));
      };
      document.head.appendChild(s);
    });
    return chartJsPromise;
  }

  function themeColors() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    return {
      isDark,
      text: isDark ? '#cbd5e1' : '#475569',
      grid: isDark ? 'rgba(203, 213, 225, 0.12)' : 'rgba(71, 85, 105, 0.12)',
      accent: isDark ? '#60a5fa' : '#2563eb',
      accentSoft: isDark ? 'rgba(96, 165, 250, 0.25)' : 'rgba(37, 99, 235, 0.14)',
      accentStrong: isDark ? '#93c5fd' : '#1d4ed8',
      muted: isDark ? '#94a3b8' : '#64748b',
      mutedSoft: isDark ? 'rgba(148, 163, 184, 0.35)' : 'rgba(100, 116, 139, 0.22)',
    };
  }

  // Formato compacto (1.2k, 3.4M) para ejes numéricos
  function compactFmt(n: number): string {
    if (!isFinite(n)) return String(n);
    const abs = Math.abs(n);
    if (abs >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1).replace(/\.0$/, '') + 'B';
    if (abs >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
    if (abs >= 1_000) return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'k';
    return String(Math.round(n * 100) / 100);
  }

  // Render: devuelve la instancia Chart o null
  function renderChart(Chart: any, canvas: HTMLCanvasElement, spec: any, existing: any | null): any {
    if (existing) { try { existing.destroy(); } catch {} }
    const col = themeColors();
    const type = spec.type;

    // Tipo "scale": lo renderizamos como un bar horizontal con un único segmento coloreado por categoría,
    // y un marker vertical con annotations (sin plugins: hacemos overlay simple).
    if (type === 'scale') {
      const segments = spec.segments as Array<{ nombre: string; max: number }>;
      const minVal = spec.min ?? 0;
      const marker = spec.marker as number;
      const markerLabel = translateOutputStr(spec.markerLabel as string);
      const unit = spec.unit || '';
      // Construimos segmentos: cada uno es una barra apilada horizontal
      const defaultPalette = col.isDark
        ? ['#7f1d1d', '#9a3412', '#b45309', '#166534', '#1e40af', '#6d28d9']
        : ['#fecaca', '#fed7aa', '#fde68a', '#bbf7d0', '#bfdbfe', '#ddd6fe'];
      const palText = col.isDark ? '#f1f5f9' : '#334155';
      let cursor = minVal;
      const datasets = segments.map((seg: any, idx: number) => {
        const width = Math.max(0, seg.max - cursor);
        const segColor = seg.color
          ? (col.isDark ? (seg.colorDark || seg.color) : seg.color)
          : defaultPalette[idx % defaultPalette.length];
        const ds = {
          label: translateOutputStr(seg.nombre),
          data: [width],
          backgroundColor: segColor,
          borderWidth: 0,
          barPercentage: 0.75,
          categoryPercentage: 0.75,
          stack: 's',
        };
        cursor = seg.max;
        return ds;
      });
      const finalMax = segments[segments.length - 1].max;
      // The stacked bar widths accumulate from 0, so the bar coordinate
      // system goes from 0 to (finalMax - minVal).  We must use that same
      // coordinate system for the x-axis and the marker, and offset the
      // tick labels so they show the real absolute values.
      const totalWidth = finalMax - minVal;

      return new Chart(canvas, {
        type: 'bar',
        data: { labels: [spec.markerLabel ? '' : translateOutputStr('Rango')], datasets },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          layout: { padding: { top: 28, bottom: 4, left: 8, right: 16 } },
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: col.text, boxWidth: 10, padding: 8, font: { size: 11 } },
            },
            tooltip: {
              callbacks: {
                label: (ctx: any) => `${ctx.dataset.label}`,
              },
            },
            markerAnnotation: {
              value: marker - minVal,
              label: markerLabel,
              min: 0,
              max: totalWidth,
              color: col.accent,
              textColor: col.text,
              bg: col.isDark ? '#0f172a' : '#ffffff',
              unit,
            },
          },
          scales: {
            x: {
              stacked: true,
              min: 0,
              max: totalWidth,
              ticks: {
                color: col.text,
                callback: (v: any) => compactFmt(Number(v) + minVal) + (unit ? ' ' + unit.split(' ')[0] : ''),
              },
              grid: { color: col.grid, drawBorder: false },
            },
            y: {
              stacked: true,
              ticks: { color: col.text, display: false },
              grid: { display: false, drawBorder: false },
            },
          },
        },
        plugins: [markerAnnotationPlugin],
      });
    }

    // Donut / pie: desglose de composición (ej. capital vs intereses, gastos).
    // spec: { type:'doughnut'|'pie', slices:[{label,value,color?}], prefix?, suffix?, centerValue?, centerLabel? }
    if (type === 'doughnut' || type === 'pie') {
      const rawSlices = (spec.slices || []) as Array<{ label: string; value: number; color?: string; colorDark?: string }>;
      const slices = rawSlices.filter((s) => Number(s.value) > 0);
      const palLight = ['#2563eb', '#f59e0b', '#10b981', '#ef4444', '#8b5cf6', '#06b6d4'];
      const palDark = ['#60a5fa', '#fbbf24', '#34d399', '#f87171', '#a78bfa', '#22d3ee'];
      const pal = col.isDark ? palDark : palLight;
      const labels = slices.map((s) => translateOutputStr(s.label));
      const values = slices.map((s) => Math.max(0, Number(s.value) || 0));
      const colors = slices.map((s, idx) => (col.isDark ? (s.colorDark || s.color) : s.color) || pal[idx % pal.length]);
      const total = values.reduce((a, b) => a + b, 0) || 1;
      const pfx = spec.prefix || '';
      const sfx = spec.suffix || '';
      const fmtN = (n: number) => pfx + new Intl.NumberFormat('es-AR').format(Math.round(n)) + sfx;
      const centerPlugin = {
        id: 'doughnutCenter',
        afterDraw(chart: any) {
          if (!spec.centerValue && !spec.centerLabel) return;
          const { ctx, chartArea } = chart;
          const cx = (chartArea.left + chartArea.right) / 2;
          const cy = (chartArea.top + chartArea.bottom) / 2;
          ctx.save();
          ctx.textAlign = 'center';
          if (spec.centerValue) {
            ctx.font = '700 16px system-ui, -apple-system, sans-serif';
            ctx.fillStyle = col.isDark ? '#f1f5f9' : '#0f172a';
            ctx.fillText(translateOutputStr(String(spec.centerValue)), cx, cy - (spec.centerLabel ? 6 : 0));
          }
          if (spec.centerLabel) {
            ctx.font = '500 10px system-ui, -apple-system, sans-serif';
            ctx.fillStyle = col.muted;
            ctx.fillText(translateOutputStr(String(spec.centerLabel)), cx, cy + 12);
          }
          ctx.restore();
        },
      };
      return new Chart(canvas, {
        type: type === 'pie' ? 'pie' : 'doughnut',
        data: { labels, datasets: [{ data: values, backgroundColor: colors, borderWidth: 0, hoverOffset: 6 }] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: type === 'pie' ? 0 : '62%',
          plugins: {
            legend: { position: 'bottom', labels: { color: col.text, boxWidth: 12, padding: 10, font: { size: 11 } } },
            tooltip: {
              callbacks: {
                label: (ctx: any) => {
                  const v = Number(ctx.parsed) || 0;
                  const pct = ((v / total) * 100).toFixed(1);
                  return ` ${ctx.label}: ${fmtN(v)} (${pct}%)`;
                },
              },
            },
          },
        },
        plugins: [centerPlugin],
      });
    }

    // Line / bar genéricos
    const isBar = type === 'bar';
    const isStacked = !!spec.stacked;
    const indexAxis = spec.indexAxis || 'x';

    const palette = [col.accent, col.muted];
    const paletteSoft = [col.accentSoft, col.mutedSoft];

    const datasets = (spec.data.datasets || []).map((ds: any, idx: number) => {
      const useMuted = ds.color === 'muted' || idx > 0;
      const border = useMuted ? palette[1] : palette[0];
      const fill = useMuted ? paletteSoft[1] : paletteSoft[0];
      const base: any = {
        label: translateOutputStr(ds.label),
        data: ds.data,
      };
      if (isBar) {
        base.backgroundColor = useMuted ? paletteSoft[1] : col.accent;
        base.borderColor = border;
        base.borderWidth = 0;
        base.borderRadius = 4;
        base.maxBarThickness = 48;
        if (isStacked) base.stack = 's';
      } else {
        base.borderColor = border;
        base.backgroundColor = fill;
        base.fill = ds.fill !== false;
        base.tension = typeof ds.tension === 'number' ? ds.tension : 0.25;
        base.pointRadius = ds.data.length > 40 ? 0 : 2;
        base.pointHoverRadius = 4;
        base.borderWidth = 2;
        if (ds.dashed) base.borderDash = [6, 4];
      }
      return base;
    });

    // suffix para tooltip y ticks
    const suffix = (spec.data.datasets && spec.data.datasets[0] && spec.data.datasets[0].suffix) || '';

    const options: any = {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          display: datasets.length > 1,
          position: 'bottom',
          labels: { color: col.text, boxWidth: 12, padding: 10, font: { size: 11 } },
        },
        tooltip: {
          callbacks: {
            label: (ctx: any) => {
              const v = ctx.parsed.y ?? ctx.parsed.x ?? ctx.parsed;
              const num = typeof v === 'number' ? v : Number(v);
              const s = suffix || '';
              if (s === '%') return `${ctx.dataset.label}: ${num.toFixed(2)}%`;
              if (s) return `${ctx.dataset.label}: ${new Intl.NumberFormat('es-AR').format(num)}${s}`;
              return `${ctx.dataset.label}: ${new Intl.NumberFormat('es-AR').format(num)}`;
            },
          },
        },
      },
      scales: {
        x: (() => {
          const xs: any = {
            stacked: isStacked,
            ticks: {
              color: col.text,
              maxRotation: 0,
              autoSkip: true,
              maxTicksLimit: indexAxis === 'y' ? 8 : 10,
            },
            grid: { color: col.grid, drawBorder: false },
          };
          if (indexAxis === 'y') {
            // Para barras horizontales con rangos, permitimos override de xRange
            if (Array.isArray(spec.xRange) && spec.xRange.length === 2) {
              xs.min = spec.xRange[0];
              xs.max = spec.xRange[1];
            } else {
              xs.beginAtZero = true;
            }
            xs.ticks.callback = (v: any) => compactFmt(Number(v)) + (suffix === '%' ? '%' : '');
          }
          return xs;
        })(),
        y: (() => {
          const ys: any = {
            stacked: isStacked,
            ticks: { color: col.text },
            grid: { color: col.grid, drawBorder: false },
          };
          if (indexAxis === 'x') {
            ys.beginAtZero = true;
            ys.ticks.callback = (v: any) => compactFmt(Number(v)) + (suffix === '%' ? '%' : '');
          }
          return ys;
        })(),
      },
    };

    // Auto-annotations: para line charts con dataset principal, marca el punto
    // donde el valor se duplica respecto al valor inicial (hito "duplicación").
    const autoAnnotations: Array<{ x: number; label: string }> = [];
    if (!isBar && datasets.length >= 1) {
      const mainData = datasets[0].data as number[];
      if (mainData && mainData.length > 2 && typeof mainData[0] === 'number' && mainData[0] > 0) {
        const initial = mainData[0];
        // Punto donde se duplica
        const doubleIdx = mainData.findIndex((v) => v >= initial * 2);
        if (doubleIdx > 0) {
          autoAnnotations.push({
            x: doubleIdx,
            label: `×2 en ${spec.data.labels[doubleIdx] || doubleIdx}`,
          });
        }
        // Punto donde se multiplica por 5 (para plazos largos)
        const fiveIdx = mainData.findIndex((v) => v >= initial * 5);
        if (fiveIdx > 0 && fiveIdx !== doubleIdx) {
          autoAnnotations.push({
            x: fiveIdx,
            label: `×5 en ${spec.data.labels[fiveIdx] || fiveIdx}`,
          });
        }
      }
    }
    // Permitir annotations custom desde la fórmula (spec.annotations)
    const customAnns: Array<{ x: number; label: string }> = Array.isArray(spec.annotations) ? spec.annotations : [];
    (options.plugins as any).chartAnnotations = {
      annotations: [...customAnns, ...autoAnnotations],
      color: col.accent,
      textColor: col.text,
      bg: col.isDark ? '#0f172a' : '#ffffff',
    };

    return new Chart(canvas, {
      type: isBar ? 'bar' : 'line',
      data: { labels: spec.data.labels, datasets },
      options,
      plugins: [chartAnnotationsPlugin],
    });
  }

  // Plugin: dibuja annotations (marker vertical + label) en puntos específicos del chart
  const chartAnnotationsPlugin = {
    id: 'chartAnnotations',
    afterDatasetsDraw(chart: any, _args: any, opts: any) {
      if (!opts || !Array.isArray(opts.annotations) || opts.annotations.length === 0) return;
      const { ctx, chartArea, scales } = chart;
      const xScale = scales.x;
      const yScale = scales.y;
      if (!xScale || !yScale) return;
      ctx.save();
      for (const ann of opts.annotations) {
        const xPx = xScale.getPixelForValue(ann.x);
        if (xPx < chartArea.left || xPx > chartArea.right) continue;
        // Línea vertical punteada
        ctx.strokeStyle = opts.color;
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(xPx, chartArea.top);
        ctx.lineTo(xPx, chartArea.bottom);
        ctx.stroke();
        ctx.setLineDash([]);
        // Label box
        const label = String(ann.label || '');
        ctx.font = '600 10px system-ui, sans-serif';
        const tw = ctx.measureText(label).width;
        const padX = 6, padY = 3;
        const boxW = tw + padX * 2;
        const boxH = 16 + padY * 2;
        const boxX = Math.max(chartArea.left, Math.min(chartArea.right - boxW, xPx - boxW / 2));
        const boxY = chartArea.top + 4;
        ctx.fillStyle = opts.bg;
        ctx.strokeStyle = opts.color;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.roundRect(boxX, boxY, boxW, boxH, 4);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = opts.textColor;
        ctx.textBaseline = 'middle';
        ctx.fillText(label, boxX + padX, boxY + boxH / 2);
      }
      ctx.restore();
    },
  };

  // Plugin: dibuja un marker vertical sobre un gráfico "scale"
  const markerAnnotationPlugin = {
    id: 'markerAnnotation',
    afterDatasetsDraw(chart: any, _args: any, opts: any) {
      if (!opts || typeof opts.value !== 'number') return;
      const { ctx, chartArea, scales } = chart;
      const xScale = scales.x;
      if (!xScale) return;
      const clamped = Math.max(opts.min ?? xScale.min, Math.min(opts.max ?? xScale.max, opts.value));
      const x = xScale.getPixelForValue(clamped);
      const top = chartArea.top - 24;
      const bottom = chartArea.bottom;
      ctx.save();
      // línea vertical
      ctx.strokeStyle = opts.color || '#2563eb';
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      ctx.moveTo(x, top + 18);
      ctx.lineTo(x, bottom);
      ctx.stroke();
      ctx.setLineDash([]);
      // pill con label
      const label = opts.label || String(opts.value);
      ctx.font = '600 11px system-ui, -apple-system, sans-serif';
      const padX = 8;
      const padY = 4;
      const metrics = ctx.measureText(label);
      const w = metrics.width + padX * 2;
      const h = 20;
      let pillX = x - w / 2;
      if (pillX < chartArea.left) pillX = chartArea.left;
      if (pillX + w > chartArea.right) pillX = chartArea.right - w;
      const pillY = top;
      // fondo
      ctx.fillStyle = opts.color || '#2563eb';
      const r = 10;
      ctx.beginPath();
      ctx.moveTo(pillX + r, pillY);
      ctx.lineTo(pillX + w - r, pillY);
      ctx.quadraticCurveTo(pillX + w, pillY, pillX + w, pillY + r);
      ctx.lineTo(pillX + w, pillY + h - r);
      ctx.quadraticCurveTo(pillX + w, pillY + h, pillX + w - r, pillY + h);
      ctx.lineTo(pillX + r, pillY + h);
      ctx.quadraticCurveTo(pillX, pillY + h, pillX, pillY + h - r);
      ctx.lineTo(pillX, pillY + r);
      ctx.quadraticCurveTo(pillX, pillY, pillX + r, pillY);
      ctx.closePath();
      ctx.fill();
      // texto
      ctx.fillStyle = '#ffffff';
      ctx.textBaseline = 'middle';
      ctx.fillText(label, pillX + padX, pillY + h / 2 + 0.5);
      ctx.restore();
    },
  };

  function animateValue(el: HTMLElement, end: any, duration: number) {
    if (typeof end !== 'number' || isNaN(end) || !isFinite(end)) { el.textContent = end; return; }
    // Respetar prefers-reduced-motion: pintar el valor final sin contar.
    if (typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = (el as any)._formatter ? (el as any)._formatter(end) : end.toLocaleString('es-AR', {maximumFractionDigits: 2});
      return;
    }
    var start = 0;
    var startTime: number | null = null;
    function step(ts: number) {
      if (!startTime) startTime = ts;
      var progress = Math.min((ts - startTime) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
      var current = start + (end - start) * eased;
      el.textContent = (el as any)._formatter ? (el as any)._formatter(current) : current.toLocaleString('es-AR', {maximumFractionDigits: 2});
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  // Lang del calc (inyectado vía data-lang="en" | "es" en .calc-container).
  // Leído una sola vez para evitar múltiples querys al DOM.
  const _rawLang = (document.querySelector('.calc-container') as HTMLElement | null)?.dataset?.lang;
  const CALC_LANG: 'es' | 'en' | 'pt' = _rawLang === 'en' ? 'en' : _rawLang === 'pt' ? 'pt' : 'es';
  // Locale + currency derivados del path para distinguir es-ES (€), es-MX ($MXN), etc.
  const _path = (typeof location !== 'undefined' ? location.pathname : '') as string;
  const NUM_LOCALE: string =
    CALC_LANG === 'en' ? 'en-US' :
    CALC_LANG === 'pt' ? 'pt-BR' :
    _path.startsWith('/es/') || _path === '/es' ? 'es-ES' :
    _path.startsWith('/mx/') || _path === '/mx' ? 'es-MX' :
    _path.startsWith('/co/') || _path === '/co' ? 'es-CO' :
    _path.startsWith('/cl/') || _path === '/cl' ? 'es-CL' :
    _path.startsWith('/global') ? 'es' :
    'es-AR';
  const NUM_CURRENCY: string =
    CALC_LANG === 'en' ? 'USD' :
    CALC_LANG === 'pt' ? 'BRL' :
    _path.startsWith('/es/') || _path === '/es' ? 'EUR' :
    _path.startsWith('/mx/') || _path === '/mx' ? 'MXN' :
    _path.startsWith('/co/') || _path === '/co' ? 'COP' :
    _path.startsWith('/cl/') || _path === '/cl' ? 'CLP' :
    'ARS';

  // Dict de traducciones ES→EN por-fórmula, generado build-time con Haiku (scripts/translate-formula-strings.py).
  // Lookup exacto: si el output string existe en el dict, se usa su traducción (calidad nativa).
  // Sino, fallback al regex layer de más abajo.
  const CALC_TRANSLATIONS: Record<string, string> = (() => {
    if (CALC_LANG === 'es') return {};
    try {
      const raw = (document.querySelector('.calc-container') as HTMLElement | null)?.dataset?.translations;
      return raw ? JSON.parse(raw) : {};
    } catch { return {}; }
  })();

