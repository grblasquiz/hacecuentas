---
// InstallPrompt — chip discreto "Instalar app" para la PWA.
// La PWA ya es instalable (manifest + service worker en Layout.astro); este
// componente es SOLO la UI de descubrimiento: sin esto el usuario no se entera
// de que puede instalarla.
//
// Estrategia (dos niveles):
//  - Páginas comunes: SOLO Android — captura `beforeinstallprompt`, muestra el
//    chip y al click dispara el prompt nativo. Desktop e iOS no ven nada.
//  - PÁGINAS CON HÁBITO (HABIT_PATHS: las calcs que la gente re-visita + el
//    dashboard de valores): a partir de la 2ª visita a esa página ofrecemos
//    también en desktop (mismo beforeinstallprompt) y en iOS/Safari
//    (instrucciones Compartir → Agregar a inicio, no hay prompt nativo).
//    Es la palanca de tráfico directo: instalada = sesión Direct.
//  - Nunca aparece si ya está instalada (display-mode: standalone) ni si el
//    usuario lo descartó (política anti-molestia de abajo).
//  - z-index 190 (debajo del banner de cookies, 200) y se corre hacia arriba
//    cuando el banner está visible para no colisionar.
---

<div id="hc-install" class="hc-install" data-nosnippet hidden>
  {/* Nombre accesible descriptivo (a11y): el aria-label gana sobre el texto
      visible "Instalar app" y describe qué se instala y como qué. */}
  <button
    type="button"
    id="hc-install-btn"
    class="hc-install-btn"
    aria-label="Instalar Hacé Cuentas como aplicación"
  >
    <svg class="hc-install-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 3v11m0 0 4-4m-4 4-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <span class="hc-install-label">Instalar app</span>
  </button>
  <button
    type="button"
    id="hc-install-close"
    class="hc-install-close"
    aria-label="No mostrar más"
  >&times;</button>
</div>

<!-- Instrucciones iOS: Safari no tiene prompt nativo de instalación -->
<div id="hc-install-ios" class="hc-install-ios" data-nosnippet hidden>
  <p class="hc-install-ios-title">Instalá Hacé Cuentas en tu iPhone</p>
  <ol class="hc-install-ios-steps">
    <li>Tocá <strong>Compartir</strong> <span aria-hidden="true">⎋</span> en la barra de Safari</li>
    <li>Elegí <strong>“Agregar a inicio”</strong></li>
  </ol>
  <button type="button" id="hc-install-ios-close" class="hc-install-ios-btn">Listo</button>
</div>

<style>
  .hc-install {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 190;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: var(--bg-card, #fff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 999px;
    box-shadow: 0 6px 24px rgba(2, 6, 23, 0.18);
    padding: 0.25rem 0.25rem 0.25rem 0.75rem;
    animation: hc-install-in 0.28s ease both;
  }
  .hc-install[hidden] { display: none; }

  /* Subir el chip cuando el banner de cookies está visible (no colisionar) */
  :global(body:has(#hc-cookie-banner:not([hidden]))) .hc-install {
    bottom: 6.25rem;
  }

  .hc-install-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--accent, #2563eb);
    color: var(--on-accent, #fff);
    border: none;
    border-radius: 999px;
    padding: 0.5rem 0.95rem;
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .hc-install-btn:hover { background: var(--accent-hover, #1d4ed8); }
  .hc-install-ico { flex: 0 0 auto; }

  .hc-install-close {
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    background: transparent;
    color: var(--text-muted, #64748b);
    font-size: 1.4rem;
    line-height: 1;
    border-radius: 999px;
    cursor: pointer;
  }
  .hc-install-close:hover {
    background: var(--accent-soft, #eff6ff);
    color: var(--text, #0f172a);
  }

  .hc-install-ios {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    left: auto;
    max-width: 300px;
    z-index: 191;
    background: var(--bg-card, #fff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 14px;
    box-shadow: 0 6px 24px rgba(2, 6, 23, 0.18);
    padding: 1rem 1.1rem;
    animation: hc-install-in 0.28s ease both;
  }
  .hc-install-ios[hidden] { display: none; }
  .hc-install-ios-title { margin: 0 0 0.5rem; font-weight: 700; font-size: 0.95rem; }
  .hc-install-ios-steps { margin: 0 0 0.75rem; padding-left: 1.2rem; font-size: 0.88rem; color: var(--text-muted, #64748b); }
  .hc-install-ios-steps li { margin: 0.2rem 0; }
  .hc-install-ios-btn {
    background: var(--accent, #2563eb);
    color: var(--on-accent, #fff);
    border: none;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }
  @media (max-width: 480px) {
    .hc-install-ios { left: 0.75rem; right: 0.75rem; max-width: none; }
  }

  @keyframes hc-install-in {
    from { opacity: 0; transform: translateY(0.5rem); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hc-install { animation: none; }
  }
  @media (max-width: 480px) {
    .hc-install { right: 0.75rem; }
    .hc-install-label { font-size: 0.86rem; }
  }
</style>

<script is:inline>
  (function () {
    // Política anti-molestia:
    //  - Máx 1 aparición por sesión (no reaparece al navegar entre páginas).
    //  - Si lo vio MAX_VIEWS_IF_DISMISSED veces Y descartó (×/declinó) → nunca más.
    //  - Tope duro HARD_CAP: aunque lo ignore siempre, no aparece más de N veces.
    var LS = 'hc-install';   // estado persistente {v: vistas, d: descartó 0/1}
    var SS = 'hc-install-s'; // guard de sesión
    var VISITS = 'hc-visits'; // {path: visitas} — gate de 2ª visita en páginas hábito
    var MAX_VIEWS_IF_DISMISSED = 2;
    var HARD_CAP = 3;

    // Páginas que la gente re-visita (recurrentes reales en GA4): acá la
    // instalación tiene sentido y la ofrecemos también en desktop e iOS.
    var HABIT_PATHS = {
      '/calculadora-imc': 1,
      '/calculadora-actualizacion-alquiler-icl': 1,
      '/dias-entre-dos-fechas': 1,
      '/calculadora-indemnizacion-despido': 1,
      '/valores-bcra': 1,
      '/dolar-hoy': 1,
    };

    var root = document.getElementById('hc-install');
    if (!root) return;

    function isStandalone() {
      return (
        window.matchMedia('(display-mode: standalone)').matches ||
        window.navigator.standalone === true
      );
    }
    function readState() {
      try { return JSON.parse(localStorage.getItem(LS) || '{}') || {}; }
      catch (e) { return {}; }
    }
    function writeState(s) {
      try { localStorage.setItem(LS, JSON.stringify(s)); } catch (e) {}
    }
    function shownThisSession() {
      try { return sessionStorage.getItem(SS) === '1'; } catch (e) { return false; }
    }
    // Contador global de visitas al sitio (localStorage 'hc_visits', {c: días
    // distintos, d: última fecha} — dedupe por día). Idempotente y compartido
    // con PushOptIn: el primero que corre en el día incrementa, el resto lee.
    function dailyVisits() {
      try {
        var today = new Date().toISOString().slice(0, 10);
        var v = JSON.parse(localStorage.getItem('hc_visits') || '{}') || {};
        if (v.d !== today) { v.d = today; v.c = (v.c || 0) + 1; localStorage.setItem('hc_visits', JSON.stringify(v)); }
        return v.c || 0;
      } catch (e) { return 0; }
    }
    function setDismissed() {
      var s = readState(); s.d = 1; writeState(s);
    }
    function stopForever() {
      var s = readState(); s.d = 1; s.v = HARD_CAP; writeState(s);
      root.hidden = true;
    }

    // Contador de visitas por página hábito (1 por sesión: los reloads no cuentan).
    var path = location.pathname.replace(/\/+$/, '') || '/';
    var isHabit = HABIT_PATHS[path] === 1;
    var habitVisits = 0;
    if (isHabit) {
      try {
        var v = JSON.parse(localStorage.getItem(VISITS) || '{}') || {};
        var sessKey = 'hc-visit-s:' + path;
        if (sessionStorage.getItem(sessKey) !== '1') {
          v[path] = Math.min((v[path] || 0) + 1, 99);
          sessionStorage.setItem(sessKey, '1');
          localStorage.setItem(VISITS, JSON.stringify(v));
        }
        habitVisits = v[path] || 0;
      } catch (e) { habitVisits = 0; }
    }

    // Gate global de recurrencia (2026-07-11): el chip recién se ofrece en la
    // 2ª-3ª visita al sitio (días distintos). Se computa ANTES de los returns
    // para que el contador acumule en cada página vista.
    var returning = dailyVisits() >= 2;

    var state = readState();
    var views = state.v || 0;
    var dismissed = state.d === 1;

    if (isStandalone()) return;
    if (views >= HARD_CAP) return;                          // tope duro
    if (dismissed && views >= MAX_VIEWS_IF_DISMISSED) return; // vio 2 y dijo que no
    if (shownThisSession()) return;                         // 1 vez por sesión

    var deferred = null;
    var btn = document.getElementById('hc-install-btn');
    var closeBtn = document.getElementById('hc-install-close');
    var iosPanel = document.getElementById('hc-install-ios');
    var iosClose = document.getElementById('hc-install-ios-close');

    var ua = navigator.userAgent || '';
    var isAndroid = /android/i.test(ua);
    var isIOS = /iphone|ipad|ipod/i.test(ua);
    // En páginas hábito, recién a partir de la 2ª visita (ya demostró que vuelve).
    var habitReady = isHabit && habitVisits >= 2;

    // Revela el chip y cuenta la aparición (1 sola vez por sesión)
    function reveal() {
      if (!root.hidden) return;
      root.hidden = false;
      try { sessionStorage.setItem(SS, '1'); } catch (e) {}
      var s = readState(); s.v = (s.v || 0) + 1; writeState(s);
      if (window.gtag) gtag('event', 'install_prompt_shown');
    }

    closeBtn.addEventListener('click', function () {
      setDismissed();      // dijo que no → al llegar a 2 vistas no vuelve
      root.hidden = true;
    });

    // beforeinstallprompt: Android a partir de la 2ª visita al sitio (gate
    // 'hc_visits', días distintos — antes era en la 1ª); desktop sólo en
    // páginas hábito con 2+ visitas (resto: ícono nativo del browser intacto).
    window.addEventListener('beforeinstallprompt', function (e) {
      if (!((isAndroid && returning) || habitReady)) return;
      e.preventDefault();
      deferred = e;
      reveal();
    });

    btn.addEventListener('click', function () {
      // iOS: no hay prompt nativo → instrucciones Compartir → Agregar a inicio.
      if (!deferred && isIOS) {
        root.hidden = true;
        if (iosPanel) iosPanel.hidden = false;
        if (window.gtag) gtag('event', 'pwa_install_prompt', { outcome: 'ios_hint' });
        return;
      }
      if (!deferred) return;
      deferred.prompt();
      deferred.userChoice.then(function (choice) {
        if (window.gtag) {
          gtag('event', 'pwa_install_prompt', { outcome: choice.outcome });
          if (choice.outcome === 'accepted') gtag('event', 'install_prompt_accepted');
        }
        if (choice.outcome === 'accepted') stopForever();
        else { setDismissed(); root.hidden = true; }
        deferred = null;
      });
    });

    if (iosClose) {
      iosClose.addEventListener('click', function () {
        if (iosPanel) iosPanel.hidden = true;
        setDismissed();
      });
    }

    // iOS + página hábito + 2ª visita: no hay beforeinstallprompt que esperar,
    // revelamos el chip directamente (Safari/iOS solamente).
    if (isIOS && habitReady && /safari/i.test(ua) && !/crios|fxios|edgios/i.test(ua)) {
      reveal();
    }

    // Instalada → no molestar nunca más
    window.addEventListener('appinstalled', function () {
      if (window.gtag) gtag('event', 'pwa_installed');
      stopForever();
    });
  })();
</script>
