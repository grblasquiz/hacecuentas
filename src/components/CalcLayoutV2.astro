// Todas las calcs reciben el rediseño v3 (chrome del mockup: headers de columna,
// sección "Cómo usar / Respuesta rápida", tarjetas info, bandas) EXCEPTO las
// flagship-top que se harán bespoke a mano (ver redesign-exclude.ts). El widget
// y el CSS se activan con la clase `.calc-v3` en el <article> + el prop redesign.
const redesign = !isBespokeTop(calc.slug);
const focusRedesign = new Set([
  'calculadora-edad-exacta',
  'calculadora-interes-compuesto',
  'calculadora-conversor-fahrenheit-a-celsius-horno',
  'calculadora-resistencia-codigo-colores-4-5-bandas',
  'calculadora-edad-perro-anos-humanos',
  'calculadora-edad-gato-humano-formula-anos',
  'calculadora-fecha-probable-parto',
  'calculadora-pintura-paredes-habitacion-litros',
  'calculadora-contador-de-palabras-y-caracteres',
  'calculadora-talla-sosten-corpino',
  'calculadora-ladrillos-por-m2-construccion',
  'calculadora-aportes-arl-colombia-empleador-empleado-riesgo',
  'calculadora-salario-diario-integrado-sdi-mexico',
  'conversor-numero-a-letras-cantidad',
  'calculadora-interes-judicial-tasa',
  'salario-minimo-paraguay-2026',
]).has(calc.slug);
const hasFinancialClusterUX = [
  'calculadora-tiempo-para-ahorrar-meta',
  'calculadora-cancelacion-anticipada-prestamo',
  'calculadora-refinanciacion-prestamo',
].includes(calc.slug);
// Prefijo para TODOS los links internos (AR='' → '/', locales → '/es', '/pt', ...).
const linkPrefix = lang ? `/${lang}` : '';
const P = (slug: string) => `${linkPrefix}/${slug}`;
// Idioma de UI: los verticales hispanos usan 'es'; solo en/pt traducen.
const uiLang: 'es' | 'en' | 'pt' = lang === 'en' ? 'en' : (lang === 'pt' || lang === 'pt-pt') ? 'pt' : 'es';
const isNeutralSpanish = uiLang === 'es' && Boolean(lang);
const dateLocale = uiLang === 'en' ? 'en-US' : uiLang === 'pt' ? 'pt-BR' : ({ mx: 'es-MX', es: 'es-ES', co: 'es-CO', cl: 'es-CL', pe: 'es-PE', ec: 'es-EC', ve: 'es-VE', py: 'es-PY', uy: 'es-UY', do: 'es-DO' } as Record<string, string>)[lang] || 'es-AR';
// Idioma del widget Calculator (solo es/en/pt; los verticales hispanos usan 'es').
const calcWidgetLang = lang === 'en' ? 'en' : (lang === 'pt' || lang === 'pt-pt') ? 'pt' : 'es';
// Locale para RelatedCalcs (bucket correcto): AR→'es' (=calcs/), España→'es-ES'
// (=calcs-es), resto = código de locale (en/pt/pt-pt/mx/co/...).
const relatedLang = !lang ? 'es' : (lang === 'es' ? 'es-ES' : lang);
