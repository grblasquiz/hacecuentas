<script is:inline>
// Tabs v2 — patrón ARIA tabs: aria-selected + roving tabindex + flechas.
// Soporta hidden="until-found" (Ctrl+F encuentra contenido de tabs ocultas) y
// deep-links por hash (#faq, #como-funciona, #fuentes, #historial, …).
(() => {
  // ¿El browser soporta hidden="until-found"? Si no, seguimos con el
  // comportamiento viejo (solo display:none vía .active de calc-redesign.css).
  const untilFound = 'onbeforematch' in document.body;

  const activateTab = (btn, focus) => {
    const wrap = btn.closest('.v2-tabs'); if (!wrap) return;
    wrap.querySelectorAll('.v2-tab').forEach((t) => {
      const sel = t === btn;
      t.setAttribute('aria-selected', sel ? 'true' : 'false');
      t.setAttribute('tabindex', sel ? '0' : '-1');
    });
    wrap.querySelectorAll('.v2-panel').forEach((p) => {
      const active = p.id === btn.dataset.panel;
      p.classList.toggle('active', active);
      if (untilFound) {
        if (active) p.removeAttribute('hidden');
        else p.setAttribute('hidden', 'until-found');
      }
    });
    if (focus) btn.focus();
  };

  document.querySelectorAll('.calc-v2 .v2-tabnav').forEach((nav) => {
    nav.addEventListener('click', (e) => {
      const btn = e.target.closest('.v2-tab'); if (!btn) return;
      activateTab(btn, false);
    });
    // Navegación con flechas ←/→ (+ Home/End) en el tablist.
    nav.addEventListener('keydown', (e) => {
      const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
      if (!keys.includes(e.key)) return;
      const tabs = Array.from(nav.querySelectorAll('.v2-tab'));
      const cur = tabs.indexOf(document.activeElement);
      if (cur === -1) return;
      e.preventDefault();
      let next = cur;
      if (e.key === 'ArrowLeft') next = (cur - 1 + tabs.length) % tabs.length;
      else if (e.key === 'ArrowRight') next = (cur + 1) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else next = tabs.length - 1;
      activateTab(tabs[next], true);
    });
  });

  // Panels inactivos → hidden="until-found": Ctrl+F revela el contenido; el
  // evento beforematch activa la pestaña correspondiente. La CSS del layout
  // (abajo) hace display:block SOLO cuando el attr está presente (que solo
  // ocurre en browsers con soporte), y la UA aplica content-visibility:hidden.
  if (untilFound) {
    document.querySelectorAll('.calc-v2 .v2-panel:not(.active)').forEach((p) => {
      p.setAttribute('hidden', 'until-found');
      p.addEventListener('beforematch', () => {
        const tabBtn = document.querySelector('.v2-tab[data-panel="' + p.id + '"]');
        if (tabBtn) activateTab(tabBtn, false);
      });
    });
  }

  // Deep-links: si el hash apunta a un id que vive dentro de un panel oculto,
  // activamos esa pestaña y scrolleamos al elemento.
  const openFromHash = () => {
    const id = decodeURIComponent((location.hash || '').slice(1));
    if (!id) return;
    let el = null;
    try { el = document.getElementById(id); } catch (e) { return; }
    if (!el) return;
    const panel = el.closest('.v2-panel');
    if (!panel) return;
    if (!panel.classList.contains('active')) {
      const tabBtn = document.querySelector('.v2-tab[data-panel="' + panel.id + '"]');
      if (tabBtn) activateTab(tabBtn, false);
    }
    requestAnimationFrame(() => el.scrollIntoView({ block: 'start' }));
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
})();

// "Ver fuentes y metodología" (Trust Strip) → activa esa pestaña y scrollea a ella.
document.querySelectorAll('.calc-v2 [data-goto-tab]').forEach((link) => {
  link.addEventListener('click', () => {
    const target = link.getAttribute('data-goto-tab');
    const root = link.closest('.calc-v2') || document;
    const tabBtn = root.querySelector('.v2-tab[data-panel="' + target + '"]');
    if (tabBtn) {
      tabBtn.click();
      const tabs = root.querySelector('.v2-tabs');
      (tabs || tabBtn).scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
});

// "Citar esta calculadora" (B5): copiar cita APA / BibTeX al portapapeles.
document.querySelectorAll('.calc-v2 .v2-cite-copy').forEach((btn) => {
  btn.addEventListener('click', () => {
    const sel = btn.getAttribute('data-cite-copy');
    const target = sel ? document.querySelector(sel) : null;
    const text = target ? (target.textContent || '').trim() : '';
    if (!text) return;
    const done = () => {
      const orig = btn.getAttribute('data-copy-orig') || btn.textContent;
      if (!btn.getAttribute('data-copy-orig')) btn.setAttribute('data-copy-orig', btn.textContent);
      btn.textContent = btn.getAttribute('data-copied-label') || btn.textContent;
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = btn.getAttribute('data-copy-orig') || orig;
        btn.classList.remove('copied');
      }, 1600);
      if (typeof gtag === 'function') {
        try { gtag('event', 'cite_copy', { cite_format: btn.getAttribute('data-cite-format') || '' }); } catch (e) {}
      }
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(() => {});
    } else {
      try {
        const ta = document.createElement('textarea');
        ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'absolute'; ta.style.left = '-9999px';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
        done();
      } catch (e) {}
    }
  });
});
</script>

