  calc: any;
  dataAsOf?: string;
  /** Código de locale: '' (AR), 'es', 'en', 'pt', 'pt-pt', 'mx', 'co', 'cl', 'pe', 'ec', 've', 'py', 'uy', 'do'. */
  lang?: string;
}
const { calc, dataAsOf, lang = '' } = Astro.props as Props;
// Prefijo para TODOS los links internos (AR='' → '/', locales → '/es', '/pt', ...).
const linkPrefix = lang ? `/${lang}` : '';
const P = (slug: string) => `${linkPrefix}/${slug}`;
// Idioma de UI: los verticales hispanos usan 'es'; solo en/pt traducen.
const uiLang: 'es' | 'en' | 'pt' = lang === 'en' ? 'en' : (lang === 'pt' || lang === 'pt-pt') ? 'pt' : 'es';
const dateLocale = uiLang === 'en' ? 'en-US' : uiLang === 'pt' ? 'pt-BR' : 'es-AR';
// Idioma del widget Calculator (solo es/en/pt; los verticales hispanos usan 'es').
const calcWidgetLang = lang === 'en' ? 'en' : (lang === 'pt' || lang === 'pt-pt') ? 'pt' : 'es';
// Locale para RelatedCalcs (bucket correcto): AR→'es' (=calcs/), España→'es-ES'
// (=calcs-es), resto = código de locale (en/pt/pt-pt/mx/co/...).
const relatedLang = !lang ? 'es' : (lang === 'es' ? 'es-ES' : lang);
// Salas de decisión que usan esta calc como componente (AR y verticales con
// salas propias; el resto devuelve []). Máx 2 para no diluir.
const decisionRooms = getRoomsForCalc(calc.slug, lang).slice(0, 2);

// ---- Autoría / revisión (política YMYL, ver src/lib/content-policy.ts) ----
// Martín Rodríguez es autor/editor en TODA la web, NO revisor clínico. Ninguna
// calc muestra "Fórmula revisada por Martín Rodríguez". Si hay un revisor
// profesional real y válido, se muestra su bloque separado (enlace + fecha).
// Restringida (dosis/tratamiento/retorno deportivo de riesgo alto sin revisor
// profesional): se reemplaza el widget por un aviso y se suprimen los bloques
// con números/dosis (tablas, ejemplos, explicación, FAQ, respuesta rápida).
const calcIsRestricted = isRestrictedCalc(calc);
const proReviewer = hasValidProfessionalReviewer(calc) ? calc.professionalReviewer : null;
const proReviewerCred = proReviewer
  ? [proReviewer.profession, proReviewer.credential].filter(Boolean).join(', ')
  : '';
const proReviewedAtLabel = proReviewer?.reviewedAt
  ? new Date(proReviewer.reviewedAt + 'T00:00:00Z').toLocaleDateString(dateLocale, { year: 'numeric', month: 'long' })
  : '';

