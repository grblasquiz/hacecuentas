  }

  /* ── Panels con hidden="until-found" (solo browsers con soporte; el attr lo
       agrega el JS tras detectar onbeforematch). display:block le gana al
       display:none de calc-redesign.css para que la UA aplique
       content-visibility:hidden → Ctrl+F encuentra el contenido. ── */
  .calc-v2 .v2-panel[hidden='until-found'] { display: block; }
