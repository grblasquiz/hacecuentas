<script is:inline>
  (function () {
    const root = document.querySelector('.ip');
    if (!root) return;
    const LMS_M = JSON.parse(root.getAttribute('data-lms-m'));
    const LMS_F = JSON.parse(root.getAttribute('data-lms-f'));

    /* @pure-start — espejo EXACTO de src/lib/formulas/indice-masa-corporal-pediatrico.ts */
    function normalCdf(z) {
      if (z > 8) return 1;
      if (z < -8) return 0;
      const b1 = 0.319381530, b2 = -0.356563782, b3 = 1.781477937, b4 = -1.821255978, b5 = 1.330274429;
      const p = 0.2316419, c = 0.39894228;
      const absZ = Math.abs(z);
      const t = 1.0 / (1.0 + p * absZ);
      const phi = c * Math.exp(-absZ * absZ / 2.0) * (t * (b1 + t * (b2 + t * (b3 + t * (b4 + t * b5)))));
      return z >= 0 ? 1 - phi : phi;
    }
    function lookupLMS(table, edadMeses) {
      const clamped = Math.max(table[0][0], Math.min(table[table.length - 1][0], edadMeses));
      let lo = 0, hi = table.length - 1;
      while (lo < hi) { const mid = (lo + hi) >> 1; if (table[mid][0] < clamped) lo = mid + 1; else hi = mid; }
      if (table[lo][0] === clamped || lo === 0) { const r = table[lo]; return { L: r[1], M: r[2], S: r[3] }; }
      const a = table[lo - 1], b = table[lo];
      const f = (clamped - a[0]) / (b[0] - a[0]);
      return { L: a[1] + f * (b[1] - a[1]), M: a[2] + f * (b[2] - a[2]), S: a[3] + f * (b[3] - a[3]) };
    }
    function compute(peso, altura, edadAnios, sexo, TM, TF) {
      const alturaM = altura / 100;
      const imc = peso / (alturaM * alturaM);
      const edadMeses = edadAnios * 12;
      const p = lookupLMS(sexo === 'f' ? TF : TM, edadMeses);
      const z = Math.abs(p.L) < 1e-9 ? Math.log(imc / p.M) / p.S : (Math.pow(imc / p.M, p.L) - 1) / (p.L * p.S);
      const pct = normalCdf(z) * 100;
      const pRound = Math.round(pct * 10) / 10;
      let clasificacion;
      if (pct < 5) clasificacion = 'Bajo peso';
      else if (pct < 85) clasificacion = pct < 25 ? 'Peso normal (rango bajo)' : pct < 75 ? 'Peso normal' : 'Peso normal (rango alto)';
      else if (pct < 95) clasificacion = 'Sobrepeso';
      else clasificacion = 'Obesidad';
      return { imc: Number(imc.toFixed(1)), imcExact: imc, z: z, pct: pct, pRound: pRound, clasificacion: clasificacion, L: p.L, M: p.M, S: p.S, edadMeses: edadMeses };
    }
    function bmiAtZ(L, M, S, z) { return Math.abs(L) < 1e-9 ? M * Math.exp(S * z) : M * Math.pow(1 + L * S * z, 1 / L); }
    /* @pure-end */

    const Z_P5 = -1.6448536269514729, Z_P85 = 1.0364333894937898, Z_P95 = 1.6448536269514729;
    const $ = (id) => document.getElementById(id);
    const n1 = (n) => n.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const n2 = (n) => n.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    let sexo = 'm';

    function umbrales(edadAnios, sx) {
      const p = lookupLMS(sx === 'f' ? LMS_F : LMS_M, edadAnios * 12);
      return { p5: bmiAtZ(p.L, p.M, p.S, Z_P5), p50: bmiAtZ(p.L, p.M, p.S, 0), p85: bmiAtZ(p.L, p.M, p.S, Z_P85), p95: bmiAtZ(p.L, p.M, p.S, Z_P95) };
    }
    function edadAnios() {
      const a = Number($('ip-anios').value) || 0;
      const m = Number($('ip-meses').value) || 0;
      return Math.max(2, Math.min(18, a + m / 12));
    }
    function state() {
      return { peso: Number($('ip-peso').value) || 0, altura: Number($('ip-altura').value) || 0, edad: edadAnios(), sexo: sexo };
    }

    function render() {
      const s = state();
      if (!s.peso || !s.altura) return;
      const r = compute(s.peso, s.altura, s.edad, s.sexo, LMS_M, LMS_F);
      const u = umbrales(s.edad, s.sexo);
      const meses = Math.round(r.edadMeses);
      const sexoTxt = s.sexo === 'f' ? 'mujer' : 'varón';

      $('ip-big').textContent = 'Percentil ' + n1(r.pRound);
      $('ip-sub').textContent = r.clasificacion + ' · IMC ' + n1(r.imc) + ' kg/m² a los ' + meses + ' meses';
      $('ip-t-imc').textContent = n1(r.imc);
      $('ip-t-z').textContent = n2(r.z);
      $('ip-t-meses').textContent = String(meses);
      $('ip-t-p85').textContent = n1(u.p85);
      $('ip-formula').textContent = 'Z = ((IMC/M)^L − 1) / (L·S) · L=' + n2(r.L) + ' M=' + n1(r.M) + ' S=' + r.S.toFixed(4).replace('.', ',') + ' → Z=' + n2(r.z) + ' → P' + n1(r.pRound);

      $('ip-deco-val').textContent = 'Percentil ' + n1(r.pRound);
      $('ip-deco-note').textContent = r.clasificacion;
      $('ip-deco-z').textContent = n2(r.z);

      $('ip-quick').innerHTML = 'Un chico de ' + n1(s.edad).replace(',0', '') + ' años con ' + n1(s.peso) + ' kg y ' + n1(s.altura) + ' cm tiene un IMC de <strong>' + n1(r.imc) + ' kg/m²</strong>, que cae en el <strong>percentil ' + n1(r.pRound) + '</strong>: ' + r.clasificacion.toLowerCase() + '.';

      $('ip-k-p5').textContent = n1(u.p5);
      $('ip-k-p50').textContent = n1(u.p50);
      $('ip-k-p85').textContent = n1(u.p85);
      $('ip-k-p95').textContent = n1(u.p95);
      document.querySelectorAll('.ip-k-ctx').forEach((e) => { e.textContent = n1(s.edad).replace(',0', '') + ' años, ' + sexoTxt; });

      $('ip-hl-big').textContent = 'Percentil ' + n1(r.pRound);
      $('ip-hl-note').textContent = r.clasificacion + ' · caso cargado';

      const scale = u.p95 * 1.15;
      $('ip-b-imc').textContent = n1(r.imc) + ' kg/m²';
      $('ip-b-imc-bar').style.width = Math.min(100, (r.imc / scale) * 100).toFixed(1) + '%';
      $('ip-b-p85').textContent = n1(u.p85) + ' kg/m²';
      $('ip-b-p85-bar').style.width = Math.min(100, (u.p85 / scale) * 100).toFixed(1) + '%';
      $('ip-b-p95').textContent = n1(u.p95) + ' kg/m²';
      $('ip-b-p95-bar').style.width = Math.min(100, (u.p95 / scale) * 100).toFixed(1) + '%';

      $('ip-s1').textContent = n1(s.peso) + ' kg · ' + n1(s.altura) + ' cm · ' + meses + ' meses · ' + sexoTxt;
      $('ip-s2').textContent = 'IMC ' + n1(r.imc) + ' · Z ' + n2(r.z);
      $('ip-s3').textContent = 'Percentil ' + n1(r.pRound) + ' · ' + r.clasificacion;

      const tb = $('ip-tbody');
      tb.innerHTML = [4, 6, 8, 10, 12, 14].map(function (a) {
        const t = umbrales(a, s.sexo);
        return '<tr><td>' + a + ' años <small class="ip-td-sub">(' + (a * 12) + ' meses)</small></td><td>' + n1(t.p5) + ' kg/m²</td><td>' + n1(t.p85) + ' kg/m²</td><td class="cf-td-em">' + n1(t.p95) + ' kg/m²</td></tr>';
      }).join('');
      $('ip-tbl-cap').textContent = 'Umbrales de IMC por edad según las tablas CDC 2000, sexo ' + (s.sexo === 'f' ? 'femenino' : 'masculino');
    }

    ['ip-peso', 'ip-altura', 'ip-anios', 'ip-meses'].forEach((id) => $(id).addEventListener('input', render));
    $('ip-calc-btn').addEventListener('click', render);
    document.querySelectorAll('[data-sexo]').forEach((b) => b.addEventListener('click', () => {
      sexo = b.getAttribute('data-sexo');
      document.querySelectorAll('[data-sexo]').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
      render();
    }));
    document.querySelectorAll('[data-ej]').forEach((b) => b.addEventListener('click', () => {
      const v = b.getAttribute('data-ej').split('|');
      $('ip-peso').value = v[0]; $('ip-altura').value = v[1]; $('ip-anios').value = v[2]; $('ip-meses').value = v[3];
      const sb = document.querySelector('[data-sexo="' + v[4] + '"]');
      if (sb) { sexo = v[4]; document.querySelectorAll('[data-sexo]').forEach((x) => x.setAttribute('aria-pressed', x === sb ? 'true' : 'false')); }
      render();
    }));

    function summary() {
      const s = state();
      const r = compute(s.peso, s.altura, s.edad, s.sexo, LMS_M, LMS_F);
      return 'IMC pediátrico: ' + n1(r.imc) + ' kg/m² a los ' + Math.round(r.edadMeses) + ' meses (' + (s.sexo === 'f' ? 'mujer' : 'varón') + ') → percentil ' + n1(r.pRound) + ', ' + r.clasificacion + ' (tablas CDC 2000). Orientativo: no reemplaza la consulta médica. — hacecuentas.com';
    }
    function shareUrl() {
      const s = state();
      return location.origin + location.pathname + '?peso=' + s.peso + '&altura=' + s.altura + '&anios=' + $('ip-anios').value + '&meses=' + $('ip-meses').value + '&sexo=' + s.sexo;
    }
    function copy(t, btn) { navigator.clipboard?.writeText(t).then(() => { const o = btn.innerHTML; btn.innerHTML = '✓ Copiado'; setTimeout(() => btn.innerHTML = o, 1500); }); }
    $('ip-copy').addEventListener('click', (e) => copy(summary(), e.currentTarget));
    $('ip-detail').addEventListener('click', () => { document.getElementById('como-funciona')?.scrollIntoView({ behavior: 'smooth' }); });
    const s2 = $('ip-share2'); if (s2) s2.addEventListener('click', (e) => copy(shareUrl(), e.currentTarget));

    const q = new URLSearchParams(location.search);
    if (q.get('peso')) $('ip-peso').value = q.get('peso');
    if (q.get('altura')) $('ip-altura').value = q.get('altura');
    if (q.get('anios')) $('ip-anios').value = q.get('anios');
    if (q.get('meses')) $('ip-meses').value = q.get('meses');
    if (q.get('sexo')) { const b = document.querySelector('[data-sexo="' + q.get('sexo') + '"]'); if (b) b.click(); }
    render();
  })();
</script>

