---
/**
 * CategoryIcon — set de íconos SVG consistente por categoría (D).
 *
 * Reemplaza los emojis (que se ven distinto en cada OS y dan informal) por un
 * lenguaje de íconos de línea uniforme (estilo Lucide, stroke currentColor).
 * Hereda color → se puede teñir con --cat / --accent.
 *
 * SEO-safe: NO toca los JSON de las calcs. Mapea por `cat` (categoría), no por
 * el `calc.icon` guardado. Si la categoría no está en el set, cae al emoji
 * pasado en `fallback` (o un ícono genérico).
 */
interface Props {
  cat?: string | null;
  size?: number;
  fallback?: string;
  class?: string;
}
const { cat, size = 24, fallback, class: className } = Astro.props;

const ICONS: Record<string, string> = {
