---
// Navigation is rendered as real anchors in the source components.
// Never intercept calculator buttons: their local handlers own the action.
---
<style is:global>
  a.hc-tool-link { display: inline-block; text-decoration: none; text-align: center; cursor: pointer; }
  a.hc-tool-link:focus-visible { outline: 3px solid currentColor; outline-offset: 4px; }
</style>
