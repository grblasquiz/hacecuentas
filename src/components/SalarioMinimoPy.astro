---
// Flagship redesign de la calc "salario mínimo Paraguay 2026" (mockup Martin).
// Los números salen del motor real (src/lib/formulas/salario-minimo-paraguay-2026.ts)
// y de sus constantes (src/lib/data/paraguay-2026.ts): SMVM Gs. 3.044.000
// (Decreto N° 6225, vigente 1-jul-2026), jornal = mensual ÷ 30, hora = mensual ÷ 240,
// jornal mínimo legal Gs. 117.077, recargo nocturno +30%, IPS obrero 9%.
// Domain "money" (índice) = el de la categoría finanzas. Header/footer = los globales.
import '../styles/calc-flagship.css';
import { md } from '../lib/markdown';
import { salarioMinimoParaguay2026 } from '../lib/formulas/salario-minimo-paraguay-2026';
import { PARAGUAY_2026, fmtPYG } from '../lib/data/paraguay-2026';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

const P = PARAGUAY_2026;
const RECARGO = P.laboral.recargoNocturno; // 0,30
const IPS = P.ips.obrero;                  // 0,09

const INIT = { jornada: 'diurna' as const, dias: P.diasMes };
const init = salarioMinimoParaguay2026({ jornada: INIT.jornada, dias: INIT.dias });

// Derivados con las constantes reales (no hay nada inventado acá).
const ipsDescuento = P.salarioMinimo * IPS;
const netoEnMano = P.salarioMinimo - ipsDescuento;
const jornalNocturno = (P.salarioMinimo / P.diasMes) * (1 + RECARGO);
const horaNocturna = (P.salarioMinimo / P.horasMesEstandar) * (1 + RECARGO);
const aumentoPct = (P.salarioMinimo / P.salarioMinimoAnterior - 1) * 100;

// Tabla de referencia — cada fila computada con el MOTOR REAL.
const refRows = [5, 10, 15, 20, 26, 30].map((d) => {
  const diurna = salarioMinimoParaguay2026({ jornada: 'diurna', dias: d });
  const nocturna = salarioMinimoParaguay2026({ jornada: 'nocturna', dias: d });
  return { dias: d, diurna: diurna.proporcional, nocturna: nocturna.proporcional };
});

const pct = (n: number) => n.toLocaleString('es-PY', { minimumFractionDigits: 0, maximumFractionDigits: 1 }) + '%';

const faq = calc.faq || [];
const sources = (calc.sources || []) as { name: string; url?: string }[];
const explanationHtml = calc.explanation ? md(calc.explanation) : '';
---

<div
  class="cf-page sp"
  data-domain="money"
  data-smvm={P.salarioMinimo}
  data-jornalmin={P.jornalMinimo}
  data-diasmes={P.diasMes}
  data-horasmes={P.horasMesEstandar}
  data-recargo={RECARGO}
  data-ips={IPS}
>
  <nav class="cf-crumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/py/">Inicio</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li><a href="/py/">Paraguay</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li aria-current="page">Salario mínimo 2026</li>
    </ol>
  </nav>

  <header class="cf-hero">
    <div class="cf-hero__main">
      <p class="cf-kicker"><span aria-hidden="true">🇵🇾</span> Paraguay · Vigente desde julio 2026</p>
      <h1 class="cf-h1">Salario mínimo en Paraguay <span class="cf-yr">2026</span></h1>
      <p class="cf-sub">Cuánto es el mínimo por mes, por día y por hora, con el recargo nocturno y el proporcional por los días que trabajaste.</p>
      <ul class="cf-pills">
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Datos verificados 2026</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Cálculo privado</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Resultado explicado</li>
      </ul>
    </div>
    <div class="cf-hero__deco" aria-hidden="true">
      <span class="cf-deco-float"><span aria-hidden="true">📈</span> Decreto N° 6225 · +{pct(aumentoPct)}</span>
      <div class="sp-deco-wrap">
        <div class="cf-deco-card">
          <div class="cf-deco-card__label">Dato principal</div>
          <div class="cf-deco-card__value" id="sp-deco-val">{fmtPYG(P.salarioMinimo)}</div>
          <div class="cf-deco-card__note" id="sp-deco-note">Salario mínimo mensual</div>
        </div>
        <span class="cf-deco-badge sp-badge">Gs</span>
      </div>
      <div class="cf-deco-sub"><strong>Por hora</strong> <span class="cf-deco-chip" id="sp-deco-chip">{fmtPYG(init.hora)}</span></div>
    </div>
  </header>

  <section class="cf-card" id="calc">
    <div class="cf-panel">
      <div class="cf-panel__head">
        <div>
          <p class="cf-panel__eyebrow">Calculadora</p>
          <h2 class="cf-panel__title">Calculá tu proporcional</h2>
        </div>
        <span class="cf-panel__priv"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> No guardamos tus datos</span>
      </div>

      <div class="cf-grid2">
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="sp-jornada">Tipo de jornada</label></div>
          <select class="cf-input" id="sp-jornada">
            <option value="diurna" selected>Diurna (06:00–20:00)</option>
            <option value="nocturna">Nocturna (20:00–06:00)</option>
          </select>
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="sp-dias">Días trabajados</label><span class="cf-hint">en el mes</span></div>
          <input class="cf-input cf-input--money" type="number" inputmode="numeric" id="sp-dias" value={INIT.dias} min="0" max="31" step="1" />
        </div>
      </div>
      <p class="cf-help" id="sp-help">La jornada nocturna lleva un recargo del {pct(RECARGO * 100)} sobre el salario ordinario (Código del Trabajo, art. 198).</p>

      <button class="cf-primary" id="sp-calc-btn" type="button">Calcular resultado <span aria-hidden="true">→</span></button>

      <div class="cf-shortcuts">
        <span class="cf-shortcuts__lbl">Ejemplos:</span>
        <button class="cf-sc" type="button" data-ej="diurna|30">Mes completo</button>
        <button class="cf-sc" type="button" data-ej="diurna|15">Medio mes</button>
        <button class="cf-sc" type="button" data-ej="nocturna|30">Nocturno completo</button>
        <button class="cf-sc" type="button" data-ej="diurna|26">26 días</button>
      </div>
    </div>

    <div class="cf-result" id="sp-result">
      <p class="cf-result__eyebrow">Resultado estimado</p>
      <div class="cf-result__big" id="sp-big">{fmtPYG(init.proporcional)}</div>
      <p class="cf-result__sub" id="sp-sub">Por {INIT.dias} días de jornada diurna</p>
      <div class="cf-tiles cf-tiles--2">
        <div class="cf-tile"><div class="cf-tile__value" id="sp-t-jornal">{fmtPYG(init.jornal)}</div><div class="cf-tile__label">Jornal · por día</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="sp-t-hora">{fmtPYG(init.hora)}</div><div class="cf-tile__label">Por hora</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="sp-t-quincena">{fmtPYG(init.quincena)}</div><div class="cf-tile__label">Quincena</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="sp-t-mes">{fmtPYG(P.salarioMinimo)}</div><div class="cf-tile__label">Mes completo</div></div>
      </div>
      <div class="cf-result__formula" id="sp-formula">{init.proporcionalDetalle}</div>
      <div class="cf-result__actions cf-result__actions--2">
        <button class="cf-rbtn" type="button" id="sp-copy"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copiar resultado</button>
        <button class="cf-rbtn" type="button" id="sp-detail"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg> Ver desglose</button>
      </div>
    </div>
  </section>

  <div class="cf-quick">
    <span class="cf-quick__ico" aria-hidden="true">⚡</span>
    <p class="cf-quick__txt"><strong>Respuesta rápida.</strong> El salario mínimo en Paraguay 2026 es <strong>{fmtPYG(P.salarioMinimo)}</strong> por mes: {fmtPYG(init.jornal)} por día y {fmtPYG(init.hora)} por hora.</p>
    <span class="cf-formula">mensual ÷ {P.horasMesEstandar} = hora</span>
  </div>

  <!-- Datos clave -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Datos clave</p>
        <h2 class="cf-section__title">Todo lo importante, de un vistazo</h2>
      </div>
      <p class="cf-section__lead">Valores de referencia del caso cargado y reglas principales para interpretar el resultado.</p>
    </div>
    <div class="cf-cards cf-cards--4">
      <div class="cf-minicard cf-minicard--dark">
        <span class="cf-minicard__ico" aria-hidden="true">💵</span>
        <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Salario mínimo</p>
        <div class="cf-minicard__big">{fmtPYG(P.salarioMinimo)}</div>
        <p class="cf-minicard__desc" style="margin-top:0.3rem">Mensual. Decreto N° 6225, vigente desde el 1-jul-2026.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">📅</span>
        <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Jornal mínimo legal</p>
        <div class="cf-minicard__big">{fmtPYG(P.jornalMinimo)}</div>
        <p class="cf-minicard__desc" style="margin-top:0.3rem">Piso diario para el trabajo a jornal, fijado aparte del mensual.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">🌙</span>
        <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Recargo nocturno</p>
        <div class="cf-minicard__big">+{pct(RECARGO * 100)}</div>
        <p class="cf-minicard__desc" style="margin-top:0.3rem">Sobre el salario ordinario, de 20:00 a 06:00 (art. 198).</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">🏥</span>
        <p class="cf-minicard__sub" style="font-weight:800;text-transform:uppercase;letter-spacing:0.05em">Aporte IPS</p>
        <div class="cf-minicard__big">{pct(IPS * 100)}</div>
        <p class="cf-minicard__desc" style="margin-top:0.3rem">Se descuenta del recibo. El empleador aporta {pct(P.ips.patronal * 100)} aparte.</p>
      </div>
    </div>
  </section>

  <!-- Cómo leer el resultado -->
  <section class="cf-section">
    <p class="cf-eyebrow">Cómo leer el resultado</p>
    <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">El mínimo es bruto, no lo que cobrás en mano</h2>
    <div class="sp-2col">
      <div class="sp-hl">
        <p class="cf-side-eyebrow">Del bruto al bolsillo</p>
        <p class="sp-hl__title">Al mínimo se le descuenta el IPS</p>
        <p class="sp-hl__desc">El salario mínimo legal es el <strong>bruto</strong>. Del recibo se descuenta el aporte obrero al IPS ({pct(IPS * 100)}); el aporte patronal ({pct(P.ips.patronal * 100)}) lo paga el empleador y no sale de tu sueldo.</p>
        <div class="sp-hl__big">{fmtPYG(netoEnMano)}</div>
        <p class="sp-hl__desc">Aproximado en mano, sin otros descuentos</p>
      </div>
      <div class="cf-breakdown">
        <div class="cf-brow">
          <span class="cf-brow__lbl">Salario mínimo bruto</span>
          <span class="cf-brow__val">{fmtPYG(P.salarioMinimo)}</span>
          <span class="cf-brow__bar"><span style="width:100%"></span></span>
        </div>
        <p class="sp-note">Lo que figura en el contrato y en el Decreto 6225.</p>
        <div class="cf-brow" style="margin-top:1rem">
          <span class="cf-brow__lbl">Aporte IPS ({pct(IPS * 100)})</span>
          <span class="cf-brow__val">− {fmtPYG(ipsDescuento)}</span>
          <span class="cf-brow__bar"><span class="sp-bar--alt" style={`width:${Math.round(IPS * 100)}%`}></span></span>
        </div>
        <p class="sp-note">Jubilación y seguro médico del trabajador.</p>
        <div class="cf-brow" style="margin-top:1rem">
          <span class="cf-brow__lbl">Aproximado en mano</span>
          <span class="cf-brow__val">{fmtPYG(netoEnMano)}</span>
          <span class="cf-brow__bar"><span class="sp-bar--ok" style={`width:${Math.round((1 - IPS) * 100)}%`}></span></span>
        </div>
        <p class="sp-note">Antes de anticipos, préstamos u otros descuentos pactados.</p>
        <div class="cf-callout cf-callout--warn" style="margin-top:1.25rem">
          <span class="cf-callout__ico" aria-hidden="true">⚠️</span>
          <p>La calculadora de arriba trabaja sobre el <strong>bruto</strong>. Este desglose es orientativo: tu recibo puede tener otros conceptos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Paso a paso -->
  <section class="cf-section">
    <p class="cf-eyebrow">Paso a paso</p>
    <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">De tus datos al resultado</h2>
    <div class="cf-steps">
      <div class="cf-step">
        <div class="cf-step__num">1</div>
        <p class="cf-step__title">Ingresá tus datos</p>
        <p class="cf-step__desc">Elegís el tipo de jornada y cuántos días trabajaste en el mes.</p>
        <span class="sp-chip" id="sp-step1">Diurna · {INIT.dias} días</span>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">2</div>
        <p class="cf-step__title">Aplicamos la fórmula</p>
        <p class="cf-step__desc">Sacamos el jornal (mensual ÷ {P.diasMes}), le sumamos el recargo si es nocturna y lo multiplicamos por los días.</p>
        <span class="sp-chip" id="sp-step2">{fmtPYG(init.jornal)} × {INIT.dias}</span>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">3</div>
        <p class="cf-step__title">Revisá el resultado</p>
        <p class="cf-step__desc">Te mostramos el proporcional, más el jornal, la hora y la quincena de referencia.</p>
        <span class="sp-chip" id="sp-step3">{fmtPYG(init.proporcional)}</span>
      </div>
    </div>
  </section>

  <!-- Referencias -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Referencias</p>
        <h2 class="cf-section__title">Ejemplos para comparar</h2>
      </div>
      <p class="cf-section__lead">Usalos como orientación y ajustá los datos de la calculadora a tu situación.</p>
    </div>
    <div class="cf-tablewrap">
      <table class="cf-table">
        <thead><tr><th>Días trabajados</th><th>Jornada diurna</th><th>Jornada nocturna (+{pct(RECARGO * 100)})</th><th>Diferencia</th></tr></thead>
        <tbody>
          {refRows.map((r) => (
            <tr>
              <td>{r.dias} {r.dias === 1 ? 'día' : 'días'}</td>
              <td>{fmtPYG(r.diurna)}</td>
              <td class="cf-td-em">{fmtPYG(r.nocturna)}</td>
              <td>+ {fmtPYG(r.nocturna - r.diurna)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="sp-note" style="margin-top:0.6rem">Montos brutos, calculados sobre el jornal del mensualizado ({fmtPYG(P.salarioMinimo)} ÷ {P.diasMes}).</p>
  </section>
</div>

<!-- Banda: bruto vs jornal mínimo -->
<div class="cf-band cf-band--warm" data-domain="money">
  <div class="cf-band__inner">
    <div class="sp-2col">
      <div class="sp-card">
        <p class="cf-eyebrow">Atención</p>
        <h2 class="sp-card__title">Hay dos mínimos distintos, y no son lo mismo</h2>
        <p class="cf-side-desc">El <strong>salario mínimo mensual</strong> ({fmtPYG(P.salarioMinimo)}) rige para el trabajador mensualizado. El <strong>jornal mínimo legal</strong> ({fmtPYG(P.jornalMinimo)}) es el piso del trabajo a jornal y es más alto que dividir el mensual por {P.diasMes} ({fmtPYG(P.salarioMinimo / P.diasMes)}).</p>
        <div class="cf-callout cf-callout--warn" style="margin-top:1rem">
          <span class="cf-callout__ico" aria-hidden="true">💡</span>
          <p>Si te contratan a jornal, el piso es {fmtPYG(P.jornalMinimo)} por día: verificá cuál de los dos regímenes figura en tu contrato.</p>
        </div>
      </div>
      <div class="cf-side-card cf-side-card--dark">
        <p class="cf-side-eyebrow">Referencia principal</p>
        <p class="sp-src__title">Salario mínimo 2026</p>
        <div class="sp-hl__big" style="margin-top:0.2rem">{fmtPYG(P.salarioMinimo)}</div>
        <p class="cf-side-desc">Mensual · Decreto N° 6225, vigente desde el 1 de julio de 2026</p>
        <div class="sp-chips">
          <span class="sp-chip sp-chip--dark">Antes {fmtPYG(P.salarioMinimoAnterior)}</span>
          <span class="sp-chip sp-chip--dark">Aumento +{pct(aumentoPct)}</span>
          <span class="sp-chip sp-chip--dark">Jornal legal {fmtPYG(P.jornalMinimo)}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="cf-page sp" data-domain="money">
  {faq.length > 0 && (
    <section class="cf-section" id="como-funciona">
      <p class="cf-eyebrow">Preguntas frecuentes</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Lo que más se consulta</h2>
      <div class="cf-faq">
        {faq.map((f: any, i: number) => (
          <details class="cf-faq__item" open={i === 0}>
            <summary class="cf-faq__q"><span>{f.q}</span><svg class="cf-faq__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="cf-faq__a" set:html={md(f.a)} />
          </details>
        ))}
      </div>
    </section>
  )}

  {explanationHtml && (
    <section class="cf-section">
      <p class="cf-eyebrow">En detalle</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Cómo funciona el salario mínimo en Paraguay</h2>
      <div class="cf-prose" set:html={explanationHtml} />
    </section>
  )}
</div>

<!-- Banda: fuentes y metodología -->
<div class="cf-band" data-domain="money">
  <div class="cf-band__inner">
    <div class="sp-2col">
      <div class="sp-card">
        <p class="cf-eyebrow">Fuentes y metodología</p>
        <h2 class="sp-card__title">Números que podés defender</h2>
        <p class="cf-side-desc">La fórmula y los parámetros se contrastan con fuentes oficiales y se revisan durante 2026.</p>
        <p class="sp-formula-note">jornal = mensual ÷ {P.diasMes} · hora = mensual ÷ {P.horasMesEstandar} · nocturno = ordinario × {(1 + RECARGO).toLocaleString('es-PY')}</p>
      </div>
      <div class="cf-side-card cf-side-card--dark">
        <p class="cf-side-eyebrow">Fuentes</p>
        <p class="sp-src__title">Datos contrastados</p>
        <div class="sp-src">
          {sources.slice(0, 3).map((s) => (
            <div class="sp-src__item"><strong>{String(s.name).split('—')[0].trim()}</strong><span>{String(s.name).includes('—') ? String(s.name).split('—').slice(1).join('—').trim() : 'Fuente oficial'}</span></div>
          ))}
          <div class="sp-src__item"><strong>Código del Trabajo (Ley 213/93)</strong><span>Art. 198 · recargo por trabajo nocturno</span></div>
        </div>
        <p class="sp-src__foot">● Información revisada en julio de 2026</p>
      </div>
    </div>
  </div>
</div>

<div class="cf-page sp" data-domain="money">
  {related.length > 0 && (
    <section class="cf-section">
      <p class="cf-eyebrow">Seguí calculando</p>
      <h2 class="cf-section__title" style="margin:0.35rem 0 1.25rem">Herramientas relacionadas</h2>
      <div class="cf-related__grid">
        {related.slice(0, 3).map((c: any) => (
          <a class="cf-relcard" href={`/py/${c.slug}`}>
            <span class="cf-relcard__ico" aria-hidden="true">{c.icon || '🧮'}</span>
            <span class="cf-relcard__title">{String(c.h1 || c.title || '').split('|')[0].split('—')[0].trim()}</span>
            {c.description && <span class="cf-relcard__desc">{String(c.description).split('|')[0].trim().slice(0, 80)}</span>}
            <span class="cf-relcard__link">Calcular <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="cf-ctabar">
    <div>
      <p class="cf-ctabar__title">Guardá este resultado.</p>
      <p class="cf-ctabar__sub">Volvé a calcular cuando cambien tus datos.</p>
    </div>
    <div class="cf-ctabar__actions">
      <button class="cf-ctabar__btn cf-ctabar__btn--solid" type="button" id="sp-share2">Guardar cálculo</button>
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector('.sp');
    if (!root) return;
    const SMVM = Number(root.getAttribute('data-smvm'));
    const DIAS_MES = Number(root.getAttribute('data-diasmes'));
    const HORAS_MES = Number(root.getAttribute('data-horasmes'));
    const RECARGO = Number(root.getAttribute('data-recargo'));
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => 'Gs. ' + new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 }).format(Math.round(n));

    const jornadaEl = $('sp-jornada'), diasEl = $('sp-dias');

    // Misma lógica que el motor: dias clamp 0..31, default 30 si viene vacío.
    function calc() {
      const jornada = jornadaEl.value === 'nocturna' ? 'nocturna' : 'diurna';
      const raw = diasEl.value.trim() === '' ? DIAS_MES : Number(diasEl.value);
      const dias = Math.min(31, Math.max(0, Number.isFinite(raw) ? raw : DIAS_MES));
      const factor = jornada === 'nocturna' ? 1 + RECARGO : 1;
      const jornalMin = SMVM / DIAS_MES;
      const horaMin = SMVM / HORAS_MES;
      const jornalAplicado = jornalMin * factor;
      const horaAplicada = horaMin * factor;
      return {
        jornada, dias, factor,
        jornal: Math.round(jornalMin),
        hora: Math.round(horaMin),
        jornalAplicado, horaAplicada,
        quincena: Math.round((SMVM / 2) * factor),
        mes: Math.round(SMVM * factor),
        proporcional: Math.round(jornalAplicado * dias),
      };
    }

    function render() {
      const r = calc();
      const noct = r.jornada === 'nocturna';
      $('sp-big').textContent = fmt(r.proporcional);
      $('sp-sub').textContent = `Por ${r.dias} ${r.dias === 1 ? 'día' : 'días'} de jornada ${r.jornada}`;
      $('sp-t-jornal').textContent = fmt(r.jornalAplicado);
      $('sp-t-hora').textContent = fmt(r.horaAplicada);
      $('sp-t-quincena').textContent = fmt(r.quincena);
      $('sp-t-mes').textContent = fmt(r.mes);
      $('sp-formula').textContent = `${fmt(r.jornalAplicado)} × ${r.dias} día(s) = ${fmt(r.proporcional)}`;
      $('sp-deco-val').textContent = fmt(r.mes);
      $('sp-deco-note').textContent = noct ? 'Mensual con recargo nocturno' : 'Salario mínimo mensual';
      $('sp-deco-chip').textContent = fmt(r.horaAplicada);
      $('sp-step1').textContent = (noct ? 'Nocturna' : 'Diurna') + ' · ' + r.dias + ' días';
      $('sp-step2').textContent = fmt(r.jornalAplicado) + ' × ' + r.dias;
      $('sp-step3').textContent = fmt(r.proporcional);
    }

    jornadaEl.addEventListener('change', render);
    diasEl.addEventListener('input', render);
    $('sp-calc-btn').addEventListener('click', render);
    document.querySelectorAll('[data-ej]').forEach((b) => b.addEventListener('click', () => {
      const p = b.getAttribute('data-ej').split('|');
      jornadaEl.value = p[0]; diasEl.value = p[1]; render();
    }));

    function summary() {
      const r = calc();
      return `Salario mínimo Paraguay 2026: ${fmt(SMVM)} al mes. Por ${r.dias} día(s) de jornada ${r.jornada}: ${fmt(r.proporcional)} (jornal ${fmt(r.jornalAplicado)}, hora ${fmt(r.horaAplicada)}). — hacecuentas.com`;
    }
    function shareUrl() { return `${location.origin}${location.pathname}?jornada=${jornadaEl.value}&dias=${calc().dias}`; }
    function copy(t, btn) { navigator.clipboard?.writeText(t).then(() => { const o = btn.innerHTML; btn.innerHTML = '✓ Copiado'; setTimeout(() => btn.innerHTML = o, 1500); }); }
    $('sp-copy').addEventListener('click', (e) => copy(summary(), e.currentTarget));
    $('sp-detail').addEventListener('click', () => { document.getElementById('como-funciona')?.scrollIntoView({ behavior: 'smooth' }); });
    const s2 = $('sp-share2'); if (s2) s2.addEventListener('click', (e) => copy(shareUrl(), e.currentTarget));

    const q = new URLSearchParams(location.search);
    if (q.get('jornada') === 'nocturna' || q.get('jornada') === 'diurna') jornadaEl.value = q.get('jornada');
    if (q.get('dias') !== null && q.get('dias') !== '') diasEl.value = q.get('dias');
    render();
  })();
</script>

