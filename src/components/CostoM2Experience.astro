---
interface Props { data:any }
const { data } = Astro.props;
import { M2, SHARES, MURO_ARS_M2 } from '../lib/hubs/costo-por-m2';
const cats = ['economica','estandar','media','alta','premium','ampliacion','reforma'];
const zones = [
  ['caba','CABA'],['gba_norte','GBA norte'],['gba_sur','GBA sur / oeste'],['cordoba','Córdoba'],
  ['rosario','Rosario / Santa Fe'],['mendoza','Mendoza'],['interior','Interior del país'],
  ['patagonia_norte','Patagonia norte'],['patagonia_austral','Patagonia austral'],['tierra-del-fuego','Tierra del Fuego']
];
---
<div class="cost-m2-experience">
    <section class="hero">
      <div class="wrap crumb"><b>Construcción</b> &nbsp;/&nbsp; Costo por m²</div>
      <div class="wrap hero-grid">
        <div class="copy">
          <span class="eyebrow">Estimador de obra 2026</span>
          <h1>Calculadora de costo<br>por m² de construcción<br>2026.</h1>
          <p>Armá un rango orientativo según metros, terminaciones y zona. Podés reemplazar nuestra referencia por un precio local por m².</p>
          <div class="chips"><span>🏗️ Rango, no precio cerrado</span><span>💵 Conversión MEP</span><span>✓ Supuestos visibles</span></div>
          <div class="house-art"><div class="blueprint"><div class="gridlines"></div><div class="house"><div class="roof"></div><div class="door"></div><div class="window"></div></div><span class="measure">130 m² computables</span></div><span class="budget-tag">Casa estándar · GBA sur/oeste</span></div>
        </div>
        <form class="calc">
          <div class="calc-title"><div><h2>Calculá tu obra</h2><p>Empezamos con una casa estándar.</p></div><span class="tag">Valores actualizados</span></div>
          <div class="section-label">¿Qué tipo de obra es?</div>
          <div class="types"><button type="button" class="type" data-cat="economica"><i>🏠</i>Económica</button><button type="button" class="type active" data-cat="estandar"><i>🏡</i>Estándar</button><button type="button" class="type" data-cat="media"><i>🏘️</i>Media alta</button><button type="button" class="type" data-cat="alta"><i>🏰</i>Alta</button><button type="button" class="type" data-cat="premium"><i>✨</i>Premium</button><button type="button" class="type" data-cat="ampliacion"><i>➕</i>Ampliación</button><button type="button" class="type" data-cat="reforma"><i>🔨</i>Reforma integral</button></div>
          <div class="section-label">Datos principales</div>
          <div class="fields">
            <div class="field"><label for="m2-covered">m² cubiertos</label><div class="inline"><input id="m2-covered" type="number" min="0" value="120"><b>m²</b></div></div>
            <div class="field"><label for="m2-semi">m² semicubiertos</label><div class="inline"><input id="m2-semi" type="number" min="0" value="20"><b>m²</b></div></div>
            <div class="field"><label for="m2-semi-factor">Cómputo semicubierto</label><div class="inline"><input id="m2-semi-factor" type="number" min="0" max="100" value="50"><b>%</b></div></div>
            <div class="field wide"><label for="m2-zone">Zona de la obra</label><select id="m2-zone">{zones.map(([v,l])=><option value={v} selected={v==='gba_sur'}>{l}</option>)}</select></div>
            <div class="field"><label for="m2-custom">Cotización local por m² (opcional)</label><div class="inline"><input id="m2-custom" type="number" min="0" placeholder="Usar referencia"><b>$</b></div></div>
            <div class="field"><label for="m2-contingency">Contingencia</label><div class="inline"><input id="m2-contingency" type="number" min="0" max="50" value="10"><b>%</b></div></div>
            <div class="field"><label for="m2-extra">Otros costos presupuestados</label><div class="inline"><input id="m2-extra" type="number" min="0" value="0"><b>$</b></div></div>
          </div>
          <div class="advanced"><span>El rango editorial tiene ±15% de incertidumbre antes de adicionales.</span><b id="m2-plan-label">Valores de hoy</b></div>
          <section class="result">
            <div class="result-top"><div><small>Costo total estimado</small><div class="price" id="m2-total">$199.420.000</div></div><div class="sqm"><small>Costo por m²</small><strong id="m2-unit">$1.534.000</strong></div></div>
            <div class="stats"><span>Superficie computable<b id="m2-area">130 m²</b></span><span>Referencia en dólares<b id="m2-usd">US$130.000</b></span><span>Rango probable<b id="m2-monthly">—</b></span></div>
            <div class="verdict" id="m2-verdict"></div>
            <button class="go" id="m2-update" type="button">Actualizar presupuesto</button>
          </section>
        </form>
      </div>
    </section>
    <section class="detail wrap">
      <header class="center"><span>La obra, rubro por rubro</span><h2>Entendé en qué se va el presupuesto</h2><p>Una estimación llave en mano separada como la armaría un director de obra.</p></header>
      <div class="detail-grid">
        <article class="card"><h3>Desglose estimado</h3>
          {SHARES.map((share,i)=><div class="row"><span>{['🧱','👷','📐','📋'][i]} {share.label}</span><div class="bar"><i style={`width:${share.share/Math.max(...SHARES.map(x=>x.share))*100}%`}></i></div><b data-m2-share={share.share}>—</b></div>)}
          <div class="total"><strong>Total de obra</strong><strong id="m2-detail-total">$199.420.000</strong></div>
        </article>
        <article class="card plan"><h3>Cómo ordenar los pagos</h3><div class="timeline">
          <div class="phase"><i>1</i><span>Proyecto y permisos<small>Planos, visados y derechos</small></span><b>10%</b></div>
          <div class="phase"><i>2</i><span>Obra gruesa<small>Cimientos, estructura y muros</small></span><b>40%</b></div>
          <div class="phase"><i>3</i><span>Instalaciones<small>Electricidad, agua y gas</small></span><b>20%</b></div>
          <div class="phase"><i>4</i><span>Terminaciones<small>Pisos, aberturas y pintura</small></span><b>30%</b></div>
        </div><div class="notice"><i>💡</i><span>El flujo es orientativo y no son cuotas fijas. Presupuestos y certificados suelen actualizarse; definí índice, anticipos y acopios por contrato.</span></div></article>
      </div>
    </section>
    <section class="catalog"><div class="wrap"><div class="catalog-head"><div><span>Comparador de terminaciones</span><h2>Los 7 tipos de obra, lado a lado</h2></div><div class="legend">GBA sur/oeste · precio estimado por m²</div></div><div class="categories">
      {cats.map((cat,i)=><button type="button" class:list={['category',{selected:cat==='estandar'}]} data-cat-card={cat}><i>{['🏠','🏡','🏘️','🏰','✨','➕','🔨'][i]}</i><h3>{['Económica','Estándar','Media alta','Alta categoría','Premium','Ampliación','Reforma integral'][i]}</h3><p>{['Materiales simples, aberturas básicas y equipamiento mínimo.','Casa urbana con buenas terminaciones y DVH parcial.','Porcelanato, aberturas DVH y climatización completa.','Country o barrio cerrado, carpintería y equipamiento superior.','Alta gama, domótica, climatización central e importados.','Obra nueva conectada a estructura e instalaciones existentes.','Demolición, refuerzos, instalaciones y terminaciones nuevas.'][i]}</p><div class="cat-price"><b>{'$'+M2[cat].gba_sur.ars.toLocaleString('es-AR')}/m²</b><em>{cat==='estandar'?'Seleccionada':'US$'+M2[cat].gba_sur.usd.toLocaleString('es-AR')}</em></div></button>)}
    </div></div></section>
    <section class="support wrap"><div><h2>Preguntas frecuentes</h2>{data.faq.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><aside><h2>Fuentes y alcance</h2><p>INDEC y CAMARCO sirven para seguir variaciones; no publican nuestros valores absolutos por m². Esos valores son escenarios editoriales fechados y por eso se muestran como rango editable.</p>{data.sources.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}<small>{s.publisher}</small></a>)}</aside></section>
  </div>

<script is:inline define:vars={{ COSTS:M2, PARTS:SHARES }}>
(()=>{const $=id=>document.getElementById(id),money=n=>'$'+Math.round(n||0).toLocaleString('es-AR'),num=id=>Math.max(0,Number($(id).value)||0);let cat='estandar';
const calc=()=>{const covered=num('m2-covered'),semi=num('m2-semi'),semiFactor=Math.min(100,num('m2-semi-factor'))/100,area=covered+semi*semiFactor,zone=$('m2-zone').value,reference=COSTS[cat][zone],custom=num('m2-custom'),unitArs=custom||reference.ars,contingency=Math.min(50,num('m2-contingency'))/100,extras=num('m2-extra'),work=unitArs*area,subtotal=work+extras,total=subtotal*(1+contingency),low=(custom?total:work*.85+extras)*(1+contingency),high=(custom?total:work*1.15+extras)*(1+contingency);$('m2-total').textContent=money(total);$('m2-unit').textContent=money(unitArs);$('m2-area').textContent=area.toLocaleString('es-AR')+' m²';$('m2-usd').textContent=custom?'Cotización propia':'US$'+Math.round(reference.usd*area).toLocaleString('es-AR');$('m2-monthly').textContent=custom?'Total configurado':money(low)+' – '+money(high);$('m2-plan-label').textContent='Contingencia '+Math.round(contingency*100)+'%';
const v=$('m2-verdict');if(v){v.innerHTML='<b>'+money(subtotal)+' antes de contingencia; '+money(total)+' con reserva.</b><br><i>⚠️ '+(custom?'Usamos tu cotización local.':'La referencia editorial se muestra como rango ±15%.')+' No incluye terreno ni lo que no cargues en otros costos.</i>'}$('m2-detail-total').textContent=money(total);document.querySelectorAll('[data-m2-share]').forEach(el=>el.textContent=money(work*Number(el.dataset.m2Share)));document.querySelector('.measure').textContent=area.toLocaleString('es-AR')+' m² computables';document.querySelectorAll('[data-cat]').forEach(b=>b.classList.toggle('active',b.dataset.cat===cat));document.querySelectorAll('[data-cat-card]').forEach(b=>{const on=b.dataset.catCard===cat;b.classList.toggle('selected',on);b.querySelector('em').textContent=on?'Seleccionada':'US$'+COSTS[b.dataset.catCard].gba_sur.usd.toLocaleString('es-AR')})};
document.querySelectorAll('[data-cat]').forEach(b=>b.addEventListener('click',()=>{cat=b.dataset.cat;calc()}));document.querySelectorAll('[data-cat-card]').forEach(b=>b.addEventListener('click',()=>{cat=b.dataset.catCard;calc();document.querySelector('.calc').scrollIntoView({behavior:'smooth',block:'center'})}));document.querySelectorAll('.calc input,.calc select').forEach(el=>el.addEventListener('input',calc));$('m2-update').addEventListener('click',()=>{calc();window.dataLayer?.push({event:'calculator_submit',calculator:'costo_m2_construccion',category:cat,uses_custom_price:num('m2-custom')>0});$('m2-update').textContent='Presupuesto actualizado ✓';setTimeout(()=>$('m2-update').textContent='Actualizar presupuesto',1500)});calc()})();
</script>

<style>
    *{box-sizing:border-box}.cost-m2-experience{width:100%;overflow:hidden;color:#12223b;background:#fff;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}.cost-m2-experience button,.cost-m2-experience input,.cost-m2-experience select{font:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.hero-grid>*{min-width:0}
    .top{height:88px;border-bottom:1px solid #dfe7ef;display:flex;align-items:center;background:#fff}.nav{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;font-size:18px;font-weight:850}.logo{width:31px;height:31px;border-radius:7px;background:#173452;display:grid;place-items:center;color:#fff;font-size:14px}.links,.tools{display:flex;align-items:center;gap:27px}.links a{font-size:13px;font-weight:700;color:#43526a;text-decoration:none}.tools span{border:1px solid #d9e2eb;border-radius:10px;padding:11px 14px;font-size:12px;font-weight:700}.tools .profile{background:#132844;color:#fff;border-color:#132844}
    .hero{background:linear-gradient(128deg,#f7faff 0%,#f7faff 61%,#f4f8ef 100%);padding:25px 0 62px;overflow:hidden}.crumb{font-size:12px;color:#718299;margin-bottom:33px}.crumb b{color:#1769db}.hero-grid{display:grid;grid-template-columns:.87fr 1.13fr;gap:54px;align-items:start}.copy{padding-top:5px}.eyebrow{font-size:11px;font-weight:850;letter-spacing:.14em;text-transform:uppercase;color:#1770e6;display:flex;align-items:center;gap:9px}.eyebrow:before{content:"";width:28px;height:2px;background:#1770e6}.copy h1{font-size:52px;line-height:1.04;letter-spacing:-.052em;margin:18px 0;color:#0e1d36}.copy>p{font-size:17px;line-height:1.65;color:#5f7187;max-width:490px}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:23px}.chips span{background:#fff;border:1px solid #dbe5ef;border-radius:9px;padding:9px 11px;color:#53677e;font-size:10px}
    .house-art{height:230px;margin-top:15px;position:relative}.blueprint{position:absolute;left:45px;top:21px;width:280px;height:182px;background:#edf5ff;border:1px solid #cfe0f0;border-radius:18px;box-shadow:0 24px 48px #17385812;overflow:hidden}.gridlines{position:absolute;inset:0;background-image:linear-gradient(#d9e8f5 1px,transparent 1px),linear-gradient(90deg,#d9e8f5 1px,transparent 1px);background-size:20px 20px}.house{position:absolute;left:56px;top:47px;width:165px;height:97px;border:4px solid #2878e8;border-top:0}.roof{position:absolute;left:42px;top:12px;width:126px;height:126px;border-left:4px solid #2878e8;border-top:4px solid #2878e8;transform:rotate(45deg)}.door{position:absolute;left:69px;bottom:0;width:34px;height:52px;border:4px solid #2878e8;border-bottom:0;background:#fff}.window{position:absolute;right:24px;top:30px;width:37px;height:32px;border:4px solid #20a06b;background:#fff}.window:before{content:"";position:absolute;left:50%;top:0;height:100%;border-left:3px solid #20a06b}.window:after{content:"";position:absolute;top:50%;left:0;width:100%;border-top:3px solid #20a06b}.measure{position:absolute;right:16px;bottom:13px;background:#fff;border:1px solid #d9e4ed;border-radius:9px;padding:8px 10px;color:#1769db;font-size:10px;font-weight:850}.budget-tag{position:absolute;left:18px;bottom:6px;background:#fff5df;color:#9b6a0a;border:1px solid #f0d7a5;border-radius:9px;padding:9px 11px;font-size:10px;font-weight:800}
    .calc{background:#fff;border:1px solid #d9e4ed;border-radius:20px;padding:26px 29px;box-shadow:0 25px 60px #173b6418;position:relative;z-index:2}.calc-title{display:flex;justify-content:space-between;gap:20px}.calc h2{font-size:23px;margin:0 0 4px}.calc-title p{font-size:10px;color:#6b7d91;margin:0}.tag{font-size:9px;color:#13794c;background:#e8f8f1;border-radius:99px;padding:7px 10px;font-weight:800;height:max-content;white-space:nowrap}.section-label{font-size:10px;font-weight:850;color:#293b53;margin:17px 0 8px}.types{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.type{border:1px solid #dce5ee;background:#fff;border-radius:10px;padding:9px 5px;color:#5d7188;font-size:9px;font-weight:750}.type i{display:block;font-style:normal;font-size:17px;margin-bottom:3px}.type.active{border:2px solid #2779ed;background:#f2f7ff;color:#1769db}.type:last-child{grid-column:span 2}.fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.field{border:1px solid #dbe4ed;border-radius:10px;padding:9px 11px;min-height:57px}.field.wide{grid-column:span 2}.field label{display:block;color:#77879a;font-size:8px;margin-bottom:5px}.field input,.field select{border:0;outline:0;background:none;width:100%;color:#142641;font-weight:750;font-size:13px}.inline{display:flex;align-items:center;gap:5px}.inline b{font-size:12px}.advanced{display:flex;justify-content:space-between;margin:11px 0;color:#65788d;font-size:9px}.advanced b{color:#1769db}.result{background:#173858;color:#fff;border-radius:15px;padding:18px 20px}.result-top{display:flex;align-items:start;justify-content:space-between}.result small{font-size:9px;color:#b9cbdd}.price{font-size:34px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.sqm{background:#e8f8f1;color:#14734b;border-radius:9px;padding:8px 11px;text-align:right}.sqm strong{display:block;font-size:15px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #375675;padding-top:12px;margin-top:13px}.stats span{font-size:8px;color:#afc0d1}.stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.go{width:100%;border:0;border-radius:9px;background:#337ff0;color:#fff;font-weight:800;padding:12px;margin-top:14px}.verdict{border-top:1px solid #375675;margin-top:13px;padding-top:12px;font-size:10px;line-height:1.7;color:#c8d6e4}.verdict b{color:#fff}.verdict i{font-style:normal;color:#f2cd88}
    .detail{padding:74px 0 67px}.center{text-align:center;max-width:720px;margin:0 auto 36px}.center span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#1770e6;font-weight:850}.center h2{font-size:36px;letter-spacing:-.04em;margin:10px 0}.center p{color:#687a8f;line-height:1.6}.detail-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:20px}.card{border:1px solid #dce5ee;border-radius:16px;padding:25px;box-shadow:0 10px 27px #1738580b}.card h3{font-size:18px;margin:0 0 19px}.row{display:grid;grid-template-columns:145px 1fr 110px;align-items:center;gap:14px;margin:16px 0}.row span{font-size:10px;font-weight:750}.bar{height:8px;background:#edf2f6;border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;border-radius:99px;background:#2f7dea}.row:nth-child(2) .bar i{background:#f0a235}.row:nth-child(3) .bar i{background:#20a06b}.row:nth-child(4) .bar i{background:#906dd4}.row b{text-align:right;font-size:12px}.total{display:flex;justify-content:space-between;border-top:1px solid #e1e7ee;margin-top:20px;padding-top:17px}.total strong:last-child{color:#168158;font-size:19px}
    .plan{background:#f8fbfe}.timeline{display:grid;gap:13px}.phase{display:grid;grid-template-columns:33px 1fr auto;gap:11px;align-items:center}.phase i{font-style:normal;width:33px;height:33px;border-radius:10px;background:#eaf3ff;display:grid;place-items:center}.phase:nth-child(2) i{background:#fff2dc}.phase:nth-child(3) i{background:#eaf8f2}.phase:nth-child(4) i{background:#f2ecff}.phase span{font-size:10px;font-weight:800}.phase small{display:block;color:#74869a;font-size:8px;margin-top:3px}.phase b{font-size:11px}.notice{background:#fff7e8;border:1px solid #efd7a5;border-radius:12px;padding:14px;margin-top:16px;display:flex;gap:10px;color:#76541d;font-size:10px;line-height:1.55}.notice i{font-style:normal;font-size:18px}
    .catalog{background:#f5f8fc;padding:69px 0}.catalog-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:27px}.catalog-head h2{font-size:34px;letter-spacing:-.04em;margin:8px 0 0}.catalog-head>div>span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#1770e6;font-weight:850}.legend{font-size:9px;color:#64778d}.categories{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.category{appearance:none;text-align:left;color:#12223b;background:#fff;border:1px solid #dce5ee;border-radius:13px;padding:17px;min-height:132px;cursor:pointer}.category.selected{border:2px solid #2779ed;box-shadow:0 10px 26px #226dcc14}.category i{font-style:normal;font-size:21px}.category h3{font-size:12px;margin:10px 0 4px}.category p{font-size:8px;color:#77899c;line-height:1.5;margin:0}.cat-price{display:flex;justify-content:space-between;align-items:end;margin-top:13px}.cat-price b{font-size:14px}.cat-price em{font-style:normal;font-size:8px;color:#168158;background:#e9f8f1;padding:4px 6px;border-radius:99px}.selected .cat-price em{color:#1769db;background:#edf4ff}.support{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;padding:70px 0}.support h2{font-size:24px}.support details{border-bottom:1px solid #dfe6ed;padding:14px 0}.support summary{font-size:12px;font-weight:750;cursor:pointer}.support p{font-size:11px;line-height:1.65;color:#687a8f}.support a{display:block;border:1px solid #dce5ee;border-radius:10px;padding:12px;margin:8px 0;color:#1769db;text-decoration:none;font-size:10px;font-weight:700}.support small{display:block;color:#78899c;margin-top:4px}
    @media(max-width:800px){.links{display:none}.hero-grid,.detail-grid,.support{grid-template-columns:1fr}.copy{text-align:center}.copy h1{font-size:40px}.eyebrow,.chips{justify-content:center}.house-art{max-width:390px;margin-inline:auto}.categories{grid-template-columns:1fr 1fr}.catalog-head{display:block}.legend{margin-top:10px}.tools span:not(:last-child){display:none}}
  </style>
