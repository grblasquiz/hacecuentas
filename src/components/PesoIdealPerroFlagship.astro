---
/**
 * Flagship redesign de "Peso ideal de <raza>" (mockup Martin, calcado).
 * Un solo componente para las 3 razas: pitbull, rottweiler y yorkshire terrier.
 * Lo único que cambia entre ellas es la ficha de raza (rangos, copy) y la foto.
 *
 * Los números salen del motor real (src/lib/formulas/peso-ideal-<raza>.ts) para
 * el SSR; el <script is:inline> replica la misma cuenta (no puede importar).
 * Paleta propia del mockup (verde oscuro + lima), no usa calc-flagship.css.
 */
import { md } from '../lib/markdown';
import { pesoIdealPitbull } from '../lib/formulas/peso-ideal-pitbull';
import { pesoIdealRottweiler } from '../lib/formulas/peso-ideal-rottweiler';
import { pesoIdealYorkshireTerrier } from '../lib/formulas/peso-ideal-yorkshire-terrier';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

type BreedKey = 'pitbull' | 'rottweiler' | 'yorkshire-terrier';

const BREEDS: Record<BreedKey, any> = {
  pitbull: {
    nombre: 'Pitbull',
    engine: pesoIdealPitbull,
    macho: { min: 16, max: 30 },
    hembra: { min: 14, max: 27 },
    crumb: 'Peso ideal del Pitbull',
    h1a: '¿Cuánto debería pesar tu ',
    sub: 'Estimá su rango saludable según sexo, edad y contextura. Después confirmalo con su condición corporal: en esta raza, el músculo puede engañar a la balanza.',
    fotoTitulo: 'La forma importa más que un número',
    fotoTexto: 'Costillas palpables, cintura visible y abdomen recogido.',
    // Foto real de la raza. Dejala en /public/img/perros/ y actualizá la ruta.
    foto: '/img/perros/pitbull.svg',
    fuente: 'Estándar UKC del American Pit Bull Terrier + sistema Body Condition Score 1–9.',
    vet: 'Si cambia de peso rápido, pierde apetito, se fatiga, no podés palpar sus costillas o es cachorro y se aleja de su curva de crecimiento.',
    senales: [
      'Las costillas se sienten con una capa fina de grasa.',
      'La cintura se nota detrás de las costillas.',
      'El abdomen sube al mirarlo de costado.',
      'Se mueve y respira con facilidad.',
    ],
  },
  rottweiler: {
    nombre: 'Rottweiler',
    engine: pesoIdealRottweiler,
    macho: { min: 50, max: 60 },
    hembra: { min: 35, max: 48 },
    crumb: 'Peso ideal del Rottweiler',
    h1a: '¿Cuánto debería pesar tu ',
    sub: 'Estimá su rango saludable según sexo, edad y contextura. Después confirmalo con su condición corporal: en un perro tan macizo, unos kilos de más pasan desapercibidos y le cargan las caderas.',
    fotoTitulo: 'La forma importa más que un número',
    fotoTexto: 'Costillas palpables, cintura visible y abdomen recogido.',
    foto: '/img/perros/rottweiler.svg',
    fuente: 'Estándar FCI nº 147 del Rottweiler + sistema Body Condition Score 1–9.',
    vet: 'Si cambia de peso rápido, cojea o se cansa al caminar, pierde apetito, no podés palpar sus costillas o es cachorro y se aleja de su curva de crecimiento.',
    senales: [
      'Las costillas se sienten con una capa fina de grasa.',
      'La cintura se nota detrás de las costillas.',
      'El abdomen sube al mirarlo de costado.',
      'Se mueve y respira con facilidad.',
    ],
  },
  'yorkshire-terrier': {
    nombre: 'Yorkshire Terrier',
    engine: pesoIdealYorkshireTerrier,
    macho: { min: 2, max: 3.2 },
    hembra: { min: 2, max: 3.2 },
    crumb: 'Peso ideal del Yorkshire',
    h1a: '¿Cuánto debería pesar tu ',
    sub: 'Estimá su rango saludable según sexo, edad y contextura. Después confirmalo con su condición corporal: en un perro tan chico, 300 gramos de más ya son sobrepeso y el pelo largo los esconde.',
    fotoTitulo: 'La forma importa más que un número',
    fotoTexto: 'Costillas palpables bajo el pelo, cintura visible y abdomen recogido.',
    foto: '/img/perros/yorkshire-terrier.svg',
    fuente: 'Estándar FCI nº 86 del Yorkshire Terrier + sistema Body Condition Score 1–9.',
    vet: 'Si cambia de peso rápido, pierde apetito, tiembla o se fatiga, no podés palpar sus costillas o es cachorro y se aleja de su curva de crecimiento.',
    senales: [
      'Las costillas se sienten bajo el pelo con una capa fina de grasa.',
      'La cintura se nota detrás de las costillas.',
      'El abdomen sube al mirarlo de costado.',
      'Se mueve y respira con facilidad.',
    ],
  },
};

const breedKey = (calc.slug.replace('calculadora-peso-ideal-', '') as BreedKey);
const B = BREEDS[breedKey] || BREEDS.pitbull;
const engine = B.engine;

// Caso por defecto = el que muestra el mockup (macho adulto, contextura estándar)
const init = engine({ sexo: 'macho', contextura: 'mediana', edad: 'adulto' });

const nf = (x: number) =>
  new Intl.NumberFormat('es-AR', { maximumFractionDigits: x < 10 ? 1 : 0 }).format(x);
const rango = (a: number, b: number) => `${nf(a)}–${nf(b)}`;

// Hitos de crecimiento del mockup (3, 6, 12 meses y adulto), del motor real
const HITOS = ['m3', 'm6', 'm12'].map((edad) => {
  const r = engine({ sexo: 'macho', contextura: 'mediana', edad });
  return {
    edad: edad === 'm3' ? '3 meses' : edad === 'm6' ? '6 meses' : '12 meses',
    valor: `${rango(r.pesoIdealMin, r.pesoIdealMax)} kg`,
    nota: `≈ ${r.porcentajeCrecimiento}% adulto`,
  };
});

// Posición del marcador en la barra (misma escala que el gráfico del motor)
const escalaMax = init.pesoIdealMax * 1.3;
const markerPct = Math.min(97, Math.max(3, (init.pesoPromedio / escalaMax) * 100));

const edadField = (calc.fields || []).find((f: any) => f.id === 'edad');
const edadOptions = edadField?.options || [];

const BCS = [
  { l: 'Muy delgado', s: '' },
  { l: 'Delgado', s: '' },
  { l: 'Ideal', s: 'BCS 4–5' },
  { l: 'Sobrepeso', s: '' },
  { l: 'Obesidad', s: '' },
];

const faq = calc.faq || [];
const sources = calc.sources || [];
const tablas = calc.referenceTables || [];

const cfg = JSON.stringify({
  breed: breedKey,
  nombre: B.nombre,
  macho: B.macho,
  hembra: B.hembra,
});
---

<div class="pw" data-cfg={cfg}>
  <div class="pw__inner">
    <nav class="pw-crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/categoria/mascotas">Mascotas</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{B.crumb}</li>
      </ol>
    </nav>

    <header class="pw-hero">
      <div class="pw-hero__main">
        <p class="pw-badge"><span aria-hidden="true">🐾</span> Guía + calculadora</p>
        <h1 class="pw-h1">{B.h1a}{B.nombre}?</h1>
        <p class="pw-hero__sub">{B.sub}</p>
        <ul class="pw-hero__pills">
          <li>Macho adulto <strong>{rango(B.macho.min, B.macho.max)} kg</strong></li>
          <li>Hembra adulta <strong>{rango(B.hembra.min, B.hembra.max)} kg</strong></li>
        </ul>
      </div>
      <figure class="pw-hero__photo">
        <img src={B.foto} alt={`${B.nombre} adulto de perfil`} width="640" height="480" loading="eager" decoding="async" />
        <figcaption>
          <strong>{B.fotoTitulo}</strong>
          <span>{B.fotoTexto}</span>
        </figcaption>
      </figure>
    </header>

    <section class="pw-calc" id="calc">
      <div class="pw-card pw-form">
        <h2 class="pw-card__title">Conocé su rango</h2>
        <p class="pw-card__lead">Tres datos. Resultado instantáneo.</p>

        <fieldset class="pw-field">
          <legend class="pw-label">Sexo</legend>
          <div class="pw-seg pw-seg--2" role="group">
            <button type="button" class="pw-opt is-on" data-k="sexo" data-v="macho">Macho</button>
            <button type="button" class="pw-opt" data-k="sexo" data-v="hembra">Hembra</button>
          </div>
        </fieldset>

        <div class="pw-field">
          <label class="pw-label" for="pw-edad">Etapa de vida</label>
          <select class="pw-select" id="pw-edad">
            {edadOptions.map((o: any) => (
              <option value={o.value} selected={o.value === 'adulto'}>{o.label}</option>
            ))}
          </select>
        </div>

        <fieldset class="pw-field">
          <legend class="pw-label">Contextura</legend>
          <div class="pw-seg pw-seg--3" role="group">
            <button type="button" class="pw-opt" data-k="contextura" data-v="pequena">Fina</button>
            <button type="button" class="pw-opt is-on" data-k="contextura" data-v="mediana">Estándar</button>
            <button type="button" class="pw-opt" data-k="contextura" data-v="grande">Robusta</button>
          </div>
        </fieldset>

        <button type="button" class="pw-cta" id="pw-go">Ver rango saludable <span aria-hidden="true">→</span></button>
      </div>

      <div class="pw-card pw-result" id="pw-result">
        <p class="pw-result__eyebrow">Rango estimado</p>
        <p class="pw-result__big"><span id="pw-big">{rango(init.pesoIdealMin, init.pesoIdealMax)}</span> <span class="pw-result__unit">kg</span></p>
        <p class="pw-result__sub" id="pw-sub">Para un {B.nombre} macho adulto de contextura estándar. No es una meta exacta: usá el BCS de abajo para validar.</p>

        <div class="pw-bar">
          <div class="pw-bar__track" role="img" aria-label="Escala de peso: bajo, saludable y alto">
            <span class="pw-bar__marker" id="pw-marker" style={`left:${markerPct}%`}></span>
          </div>
          <div class="pw-bar__legend"><span>Bajo</span><span>Saludable</span><span>Alto</span></div>
        </div>

        <div class="pw-note">
          <strong>Chequeo rápido</strong> Si ves cintura desde arriba y sentís las costillas sin presionar fuerte, suele estar cerca de su condición ideal.
        </div>
      </div>
    </section>

    <section class="pw-two">
      <div class="pw-card">
        <h2 class="pw-card__title">La prueba que completa la balanza</h2>
        <p class="pw-card__lead">Elegí la silueta que más se parece a tu perro visto desde arriba.</p>
        <div class="pw-bcs">
          {BCS.map((b, i) => (
            <button type="button" class={`pw-bcs__item${i === 2 ? ' is-on' : ''}`} data-bcs={i}>
              <span class="pw-bcs__fig" aria-hidden="true">
                <svg viewBox="0 0 40 56" width="40" height="56">
                  <ellipse cx="20" cy="28" rx={11 + i * 2.6} ry="24" />
                </svg>
              </span>
              <span class="pw-bcs__lbl">{b.l}</span>
              {b.s && <span class="pw-bcs__sub">{b.s}</span>}
            </button>
          ))}
        </div>
      </div>

      <div class="pw-card">
        <h2 class="pw-card__title">Señales de condición ideal</h2>
        <ul class="pw-checks">
          {B.senales.map((s: string) => (
            <li><span class="pw-check" aria-hidden="true">✓</span>{s}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="pw-growth">
      <div class="pw-growth__head">
        <h2 class="pw-h2">Cómo crece un {B.nombre}</h2>
        <p class="pw-growth__lead">Referencias orientativas, no objetivos rígidos.</p>
      </div>
      <div class="pw-growth__grid">
        {HITOS.map((h) => (
          <div class="pw-gcard">
            <p class="pw-gcard__age">{h.edad}</p>
            <p class="pw-gcard__val">{h.valor}</p>
            <p class="pw-gcard__note">{h.nota}</p>
          </div>
        ))}
        <div class="pw-gcard">
          <p class="pw-gcard__age">18–24 meses</p>
          <p class="pw-gcard__val">Peso adulto</p>
          <p class="pw-gcard__note">Completa musculatura</p>
        </div>
      </div>
    </section>

    <aside class="pw-vet">
      <span class="pw-vet__ico" aria-hidden="true">🩺</span>
      <div>
        <p class="pw-vet__title">Cuándo consultar al veterinario</p>
        <p class="pw-vet__txt">{B.vet}</p>
      </div>
    </aside>

    {tablas.length > 0 && (
      <section class="pw-section">
        {tablas.map((t: any) => (
          <div class="pw-tblblock">
            <h2 class="pw-h2">{t.title}</h2>
            {t.caption && <p class="pw-growth__lead pw-tblblock__cap">{t.caption}</p>}
            <div class="pw-tablewrap">
              <table class="pw-table">
                <thead><tr>{t.headers.map((h: string) => <th>{h}</th>)}</tr></thead>
                <tbody>
                  {t.rows.map((r: string[]) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}
                </tbody>
              </table>
            </div>
            {t.note && <p class="pw-tblnote">{t.note}</p>}
          </div>
        ))}
      </section>
    )}

    {calc.explanation && (
      <section class="pw-section pw-prose" set:html={md(calc.explanation)} />
    )}

    {faq.length > 0 && (
      <section class="pw-section" id="preguntas">
        <h2 class="pw-h2">Preguntas frecuentes</h2>
        <div class="pw-faq">
          {faq.map((f: any, i: number) => (
            <details class="pw-faq__item" open={i === 0}>
              <summary class="pw-faq__q"><span>{f.q}</span><span class="pw-faq__chev" aria-hidden="true">⌄</span></summary>
              <div class="pw-faq__a" set:html={md(f.a)} />
            </details>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="pw-section">
        <h2 class="pw-h2">Seguí calculando</h2>
        <div class="pw-rel">
          {related.slice(0, 3).map((c: any) => (
            <a class="pw-relcard" href={`/${c.slug}`}>
              <span class="pw-relcard__ico" aria-hidden="true">{c.icon || '🐕'}</span>
              <span class="pw-relcard__title">{String(c.h1 || c.title || '').split('|')[0].split('(')[0].trim()}</span>
              <span class="pw-relcard__link">Calcular →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="pw-foot">
      <div>
        <p class="pw-foot__title">Fuentes y metodología</p>
        <p class="pw-foot__txt">{B.fuente}</p>
        {sources.length > 0 && (
          <p class="pw-foot__src">
            {sources.map((s: any, i: number) => (
              <>{i > 0 && ' · '}<a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a></>
            ))}
          </p>
        )}
      </div>
      <p class="pw-foot__meta">Revisado: julio de 2026 · Resultado orientativo</p>
    </footer>
  </div>
</div>

<style is:global>
  /* ── Mockup Martin: peso ideal por raza. Paleta propia, light-only. ────── */
  .pw {
    --ink: #14281f;
    --ink-soft: #5b6b62;
    --cream: #f7f5ef;
    --green: #14432e;
    --green-2: #1b5a3d;
    --lime: #dff265;
    --lime-ink: #eaff8a;
    --line: #e5e2d8;
    color-scheme: light;
    background: var(--cream);
    color: var(--ink);
    font-synthesis-weight: none;
  }
  .pw__inner { max-width: 1120px; margin: 0 auto; padding: 1rem 1.15rem 3.5rem; }

  .pw-crumb ol {
    display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; margin: 0 0 1rem; padding: 0;
    font-size: 0.8125rem; color: var(--ink-soft);
  }
  .pw-crumb a { color: var(--ink-soft); text-decoration: none; }
  .pw-crumb a:hover { text-decoration: underline; }
  .pw-crumb [aria-current="page"] { color: var(--green); font-weight: 700; }

  /* ── Hero ───────────────────────────────────────────────────────────── */
  .pw-hero {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: center;
    padding: 1.75rem 1.5rem; border-radius: 22px;
    background: var(--green); color: #fff;
  }
  .pw-hero::after {
    content: ''; position: absolute; top: -60px; right: -40px; width: 220px; height: 220px;
    border-radius: 0 0 0 100%; background: rgba(255,255,255,0.05); pointer-events: none;
  }
  @media (min-width: 900px) {
    .pw-hero { grid-template-columns: 1.05fr 0.95fr; gap: 2.5rem; padding: 2.5rem 3rem; }
  }
  .pw-hero__main { position: relative; z-index: 1; min-width: 0; }
  .pw-badge {
    display: inline-flex; align-items: center; gap: 0.4rem; margin: 0 0 1.1rem;
    padding: 0.4rem 0.85rem; border-radius: 999px; background: var(--lime); color: #16321f;
    font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .pw-h1 {
    margin: 0 0 0.9rem; font-size: clamp(1.9rem, 4.6vw, 2.9rem); line-height: 1.05;
    letter-spacing: -0.03em; font-weight: 800; color: #fff;
  }
  .pw-hero__sub { margin: 0 0 1.2rem; font-size: 0.98rem; line-height: 1.6; color: rgba(255,255,255,0.82); max-width: 46ch; }
  .pw-hero__pills { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 0; padding: 0; list-style: none; }
  .pw-hero__pills li {
    padding: 0.5rem 0.9rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.22);
    font-size: 0.8125rem; color: rgba(255,255,255,0.85);
  }
  .pw-hero__pills strong { color: var(--lime-ink); font-weight: 700; }

  .pw-hero__photo { position: relative; z-index: 1; margin: 0; border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--green-2); }
  .pw-hero__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pw-hero__photo figcaption {
    position: absolute; left: 0.8rem; right: 0.8rem; bottom: 0.8rem; padding: 0.7rem 0.85rem;
    border-radius: 10px; background: rgba(10, 28, 19, 0.72); backdrop-filter: blur(6px);
    display: grid; gap: 0.15rem;
  }
  .pw-hero__photo figcaption strong { color: var(--lime-ink); font-size: 0.9rem; font-weight: 700; }
  .pw-hero__photo figcaption span { font-size: 0.78rem; color: rgba(255,255,255,0.82); line-height: 1.4; }

  /* ── Cards ──────────────────────────────────────────────────────────── */
  .pw-card { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 1.5rem; }
  .pw-card__title { margin: 0 0 0.35rem; font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); }
  .pw-card__lead { margin: 0 0 1.25rem; font-size: 0.88rem; color: var(--ink-soft); }

  .pw-calc, .pw-two { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 1rem; }
  @media (min-width: 900px) {
    .pw-calc { grid-template-columns: 1fr 1fr; align-items: stretch; }
    .pw-two { grid-template-columns: 0.9fr 1.1fr; }
  }

  /* ── Form ───────────────────────────────────────────────────────────── */
  .pw-field { border: 0; padding: 0; margin: 0 0 1.1rem; }
  .pw-label { display: block; margin: 0 0 0.5rem; padding: 0; font-size: 0.82rem; font-weight: 700; color: var(--ink); }
  .pw-seg { display: grid; gap: 0.6rem; }
  .pw-seg--2 { grid-template-columns: 1fr 1fr; }
  .pw-seg--3 { grid-template-columns: 1fr 1fr; }
  .pw-opt {
    padding: 0.8rem 0.6rem; border-radius: 12px; border: 1px solid var(--line); background: #fbfaf6;
    font: inherit; font-size: max(16px, 0.9rem); font-weight: 600; color: var(--ink); cursor: pointer;
    transition: border-color .15s, background .15s;
  }
  .pw-opt:hover { border-color: #b9c9be; }
  .pw-opt.is-on { background: #e7f3ea; border-color: #2f7a55; color: #14432e; font-weight: 700; }
  .pw-select {
    width: 100%; padding: 0.8rem 0.9rem; border-radius: 12px; border: 1px solid var(--line);
    background: #fbfaf6; font: inherit; font-size: max(16px, 0.95rem); color: var(--ink);
  }
  .pw-cta {
    width: 100%; margin-top: 0.35rem; padding: 0.95rem 1rem; border: 0; border-radius: 12px;
    background: var(--lime); color: #16321f; font: inherit; font-size: max(16px, 0.95rem);
    font-weight: 800; cursor: pointer; transition: filter .15s;
  }
  .pw-cta:hover { filter: brightness(0.96); }

  /* ── Resultado ──────────────────────────────────────────────────────── */
  .pw-result { background: var(--green); border-color: var(--green); color: #fff; display: flex; flex-direction: column; }
  .pw-result__eyebrow { margin: 0 0 0.75rem; font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; color: rgba(255,255,255,0.62); }
  .pw-result__big { margin: 0 0 0.75rem; font-size: clamp(2.6rem, 7vw, 3.6rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: var(--lime); }
  .pw-result__unit { font-size: 0.4em; font-weight: 700; }
  .pw-result__sub { margin: 0 0 auto; font-size: 0.9rem; line-height: 1.55; color: rgba(255,255,255,0.8); max-width: 42ch; }

  .pw-bar { margin: 2rem 0 1rem; }
  .pw-bar__track {
    position: relative; height: 9px; border-radius: 999px;
    background: linear-gradient(90deg, #e8845c 0%, #d9f26b 22%, #d9f26b 72%, #e05a4a 100%);
  }
  .pw-bar__marker {
    position: absolute; top: -5px; width: 3px; height: 19px; border-radius: 2px; background: #fff;
    transform: translateX(-50%); transition: left .25s ease;
  }
  .pw-bar__legend { display: flex; justify-content: space-between; margin-top: 0.5rem; font-size: 0.72rem; color: rgba(255,255,255,0.6); }

  .pw-note {
    padding: 0.85rem 1rem; border-radius: 12px; background: rgba(255,255,255,0.07);
    font-size: 0.85rem; line-height: 1.5; color: rgba(255,255,255,0.85);
  }
  .pw-note strong { color: #fff; font-weight: 700; }

  /* ── BCS ────────────────────────────────────────────────────────────── */
  .pw-bcs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.5rem; }
  .pw-bcs__item {
    display: grid; justify-items: center; gap: 0.3rem; padding: 0.7rem 0.25rem;
    border: 1px solid var(--line); border-radius: 12px; background: #fff; cursor: pointer;
    font: inherit; color: var(--ink-soft);
  }
  .pw-bcs__item svg { fill: #d9dcd6; }
  .pw-bcs__item.is-on { border-color: #14432e; border-width: 2px; padding: calc(0.7rem - 1px) calc(0.25rem - 1px); }
  .pw-bcs__item.is-on svg { fill: #14432e; }
  .pw-bcs__item.is-on .pw-bcs__lbl { color: #14432e; font-weight: 700; }
  .pw-bcs__lbl { font-size: 0.68rem; line-height: 1.2; text-align: center; }
  .pw-bcs__sub { font-size: 0.65rem; font-weight: 700; color: #14432e; }

  .pw-checks { list-style: none; margin: 0; padding: 0; }
  .pw-checks li {
    display: flex; gap: 0.6rem; align-items: flex-start; padding: 0.75rem 0;
    border-bottom: 1px solid var(--line); font-size: 0.9rem; line-height: 1.5;
  }
  .pw-checks li:last-child { border-bottom: 0; }
  .pw-check { color: #2f7a55; font-weight: 800; }

  /* ── Crecimiento ────────────────────────────────────────────────────── */
  .pw-growth { margin-top: 2.5rem; }
  .pw-growth__head { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; }
  .pw-h2 { margin: 0; font-size: clamp(1.5rem, 3.4vw, 2rem); font-weight: 800; letter-spacing: -0.025em; color: var(--ink); }
  .pw-growth__lead { margin: 0; font-size: 0.85rem; color: var(--ink-soft); }
  .pw-growth__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem; }
  @media (min-width: 900px) { .pw-growth__grid { grid-template-columns: repeat(4, 1fr); } }
  .pw-gcard { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 1.1rem 1.2rem; }
  .pw-gcard__age { margin: 0 0 0.5rem; font-size: 0.75rem; color: var(--ink-soft); }
  .pw-gcard__val { margin: 0 0 0.6rem; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); }
  .pw-gcard__note { margin: 0; font-size: 0.75rem; font-weight: 700; color: #2f7a55; }

  /* ── Vet callout ────────────────────────────────────────────────────── */
  .pw-vet {
    display: flex; gap: 0.85rem; margin-top: 1.5rem; padding: 1.1rem 1.25rem;
    border-radius: 16px; background: #fdeee4; border: 1px solid #f6ddcd;
  }
  .pw-vet__ico { font-size: 1.05rem; line-height: 1.4; }
  .pw-vet__title { margin: 0 0 0.3rem; font-weight: 800; color: #8a4a1e; font-size: 0.92rem; }
  .pw-vet__txt { margin: 0; font-size: 0.88rem; line-height: 1.55; color: #6d4626; }

  /* ── Secciones SEO ──────────────────────────────────────────────────── */
  .pw-section { margin-top: 2.75rem; }
  .pw-tblblock + .pw-tblblock { margin-top: 2rem; }
  .pw-tblblock__cap { margin: 0.5rem 0 0.9rem; max-width: 75ch; line-height: 1.55; }
  .pw-tablewrap { overflow-x: auto; background: #fff; border: 1px solid var(--line); border-radius: 16px; }
  .pw-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .pw-table th, .pw-table td { padding: 0.7rem 0.9rem; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .pw-table th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); background: #fbfaf6; }
  .pw-table tr:last-child td { border-bottom: 0; }
  .pw-tblnote { margin: 0.6rem 0 0; font-size: 0.78rem; color: var(--ink-soft); line-height: 1.5; }

  .pw-prose { font-size: 0.95rem; line-height: 1.7; color: #2c3b33; }
  .pw-prose h2 { margin: 2rem 0 0.7rem; font-size: clamp(1.35rem, 3vw, 1.75rem); font-weight: 800; letter-spacing: -0.02em; color: var(--ink); }
  .pw-prose h3 { margin: 1.5rem 0 0.5rem; font-size: 1.1rem; font-weight: 800; color: var(--ink); }
  .pw-prose p { margin: 0 0 1rem; max-width: 72ch; }
  .pw-prose ul, .pw-prose ol { margin: 0 0 1rem; padding-left: 1.15rem; max-width: 72ch; }
  .pw-prose li { margin-bottom: 0.35rem; }
  /* md() no envuelve las listas en <ul>: los <li> quedan sueltos + <br> */
  .pw-prose > li { display: list-item; margin-left: 1.35rem; max-width: 70ch; }
  .pw-prose > li + br { display: none; }
  .pw-prose p:empty { display: none; }
  .pw-prose a { color: #1b5a3d; }
  .pw-prose table { width: 100%; border-collapse: collapse; font-size: 0.88rem; background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; margin: 0 0 1.25rem; }
  .pw-prose th, .pw-prose td { padding: 0.6rem 0.85rem; text-align: left; border-bottom: 1px solid var(--line); }
  .pw-prose th { background: #fbfaf6; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); }

  /* ── FAQ ────────────────────────────────────────────────────────────── */
  .pw-faq { display: grid; gap: 0.6rem; margin-top: 1rem; }
  .pw-faq__item { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 0 1.1rem; }
  .pw-faq__q {
    display: flex; justify-content: space-between; gap: 1rem; align-items: center;
    padding: 1rem 0; font-weight: 700; font-size: 0.95rem; cursor: pointer; list-style: none; color: var(--ink);
  }
  .pw-faq__q::-webkit-details-marker { display: none; }
  .pw-faq__chev { color: var(--ink-soft); transition: transform .2s; }
  .pw-faq__item[open] .pw-faq__chev { transform: rotate(180deg); }
  .pw-faq__a { padding: 0 0 1.1rem; font-size: 0.9rem; line-height: 1.6; color: #3a4a41; }
  .pw-faq__a p { margin: 0 0 0.6rem; }
  .pw-faq__a a { color: #1b5a3d; }

  /* ── Related ────────────────────────────────────────────────────────── */
  .pw-rel { display: grid; grid-template-columns: 1fr; gap: 0.8rem; margin-top: 1rem; }
  @media (min-width: 760px) { .pw-rel { grid-template-columns: repeat(3, 1fr); } }
  .pw-relcard {
    display: grid; gap: 0.4rem; padding: 1.1rem 1.2rem; background: #fff; border: 1px solid var(--line);
    border-radius: 16px; text-decoration: none; color: var(--ink); transition: border-color .15s;
  }
  .pw-relcard:hover { border-color: #2f7a55; }
  .pw-relcard__ico { font-size: 1.2rem; }
  .pw-relcard__title { font-weight: 700; font-size: 0.95rem; line-height: 1.35; }
  .pw-relcard__link { font-size: 0.8rem; font-weight: 700; color: #1b5a3d; }

  /* ── Footer ─────────────────────────────────────────────────────────── */
  .pw-foot {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; justify-content: space-between; align-items: flex-end;
    margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line);
  }
  .pw-foot__title { margin: 0 0 0.25rem; font-size: 0.8rem; font-weight: 800; color: var(--ink); }
  .pw-foot__txt, .pw-foot__meta, .pw-foot__src { margin: 0; font-size: 0.78rem; color: var(--ink-soft); line-height: 1.5; }
  .pw-foot__src { margin-top: 0.3rem; }
  .pw-foot__src a { color: #1b5a3d; }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.pw');
    if (!root) return;
    var CFG = JSON.parse(root.getAttribute('data-cfg') || '{}');

    // Réplica de src/lib/formulas/peso-ideal-<raza>.ts + _puppy-growth.ts
    var CURVAS = {
      toy: [[2,0.28],[3,0.42],[4,0.56],[5,0.68],[6,0.80],[8,0.92],[10,0.98],[12,1.00]],
      pequena: [[2,0.24],[3,0.37],[4,0.50],[5,0.62],[6,0.74],[8,0.88],[10,0.96],[12,1.00]],
      mediana: [[2,0.22],[3,0.33],[4,0.45],[5,0.57],[6,0.68],[8,0.80],[10,0.90],[12,0.96],[15,1.00]],
      grande: [[2,0.17],[3,0.27],[4,0.37],[5,0.46],[6,0.55],[8,0.70],[10,0.80],[12,0.88],[15,0.95],[18,1.00]],
      gigante: [[2,0.15],[3,0.24],[4,0.32],[5,0.40],[6,0.48],[8,0.62],[10,0.72],[12,0.80],[15,0.90],[18,0.96],[24,1.00]]
    };
    function tamanoPorPeso(p) {
      if (p < 5) return 'toy';
      if (p < 11) return 'pequena';
      if (p < 26) return 'mediana';
      if (p < 45) return 'grande';
      return 'gigante';
    }
    function fraccion(meses, tam) {
      var c = CURVAS[tam];
      if (meses <= c[0][0]) return Math.max(0.02, (meses / c[0][0]) * c[0][1]);
      for (var i = 1; i < c.length; i++) {
        if (meses <= c[i][0]) {
          var m0 = c[i-1][0], f0 = c[i-1][1];
          return f0 + ((meses - m0) / (c[i][0] - m0)) * (c[i][1] - f0);
        }
      }
      return 1;
    }
    var TAM = tamanoPorPeso((CFG.macho.min + CFG.macho.max + CFG.hembra.min + CFG.hembra.max) / 4);

    function calcular(sexo, contextura, edad) {
      var base = sexo === 'macho' ? CFG.macho : CFG.hembra;
      var min = base.min, max = base.max, range = max - min;
      if (contextura === 'pequena') max = min + range * 0.45;
      else if (contextura === 'grande') min = max - range * 0.45;
      else { min = min + range * 0.25; max = max - range * 0.1; }
      var adultoMin = min, adultoMax = max;
      var pct = 100, meses = null;
      var m = /^m(\d+)$/.exec(edad);
      if (m) meses = Number(m[1]);
      if (meses !== null) {
        var f = fraccion(meses, TAM);
        min = adultoMin * f; max = adultoMax * f; pct = Math.round(f * 100);
      } else if (edad === 'senior') {
        min = adultoMin * 0.9; max = adultoMax;
      }
      return {
        min: Number(min.toFixed(1)),
        max: Number(max.toFixed(1)),
        prom: Number(((min + max) / 2).toFixed(1)),
        pct: pct, meses: meses
      };
    }

    var nf = function (x) {
      return new Intl.NumberFormat('es-AR', { maximumFractionDigits: x < 10 ? 1 : 0 }).format(x);
    };

    var state = { sexo: 'macho', contextura: 'mediana', edad: 'adulto' };
    var elBig = document.getElementById('pw-big');
    var elSub = document.getElementById('pw-sub');
    var elMark = document.getElementById('pw-marker');
    var elEdad = document.getElementById('pw-edad');

    function edadTxt() {
      var o = elEdad && elEdad.options[elEdad.selectedIndex];
      return o ? o.text.toLowerCase() : 'adulto';
    }

    function render() {
      var r = calcular(state.sexo, state.contextura, state.edad);
      if (elBig) elBig.textContent = nf(r.min) + '–' + nf(r.max);
      var ctx = state.contextura === 'pequena' ? 'fina' : state.contextura === 'grande' ? 'robusta' : 'estándar';
      var sexoTxt = state.sexo === 'macho' ? 'macho' : 'hembra';
      if (elSub) {
        if (r.meses !== null) {
          elSub.textContent = 'A los ' + r.meses + ' meses, un ' + CFG.nombre + ' ' + sexoTxt +
            ' de contextura ' + ctx + ' ronda el ' + r.pct + '% de su peso adulto. Validá con el BCS de abajo.';
        } else {
          elSub.textContent = 'Para un ' + CFG.nombre + ' ' + sexoTxt + ' ' + edadTxt().split('(')[0].trim() +
            ' de contextura ' + ctx + '. No es una meta exacta: usá el BCS de abajo para validar.';
        }
      }
      if (elMark) {
        var escala = r.max * 1.3;
        var pos = escala > 0 ? (r.prom / escala) * 100 : 50;
        elMark.style.left = Math.min(97, Math.max(3, pos)) + '%';
      }
    }

    root.querySelectorAll('.pw-opt').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var k = btn.getAttribute('data-k');
        state[k] = btn.getAttribute('data-v');
        root.querySelectorAll('.pw-opt[data-k="' + k + '"]').forEach(function (b) { b.classList.remove('is-on'); });
        btn.classList.add('is-on');
        render();
      });
    });
    if (elEdad) elEdad.addEventListener('change', function () { state.edad = elEdad.value; render(); });
    var go = document.getElementById('pw-go');
    if (go) go.addEventListener('click', function () {
      render();
      var res = document.getElementById('pw-result');
      if (res && window.innerWidth < 900) res.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    root.querySelectorAll('.pw-bcs__item').forEach(function (b) {
      b.addEventListener('click', function () {
        root.querySelectorAll('.pw-bcs__item').forEach(function (x) { x.classList.remove('is-on'); });
        b.classList.add('is-on');
      });
    });
  })();
</script>
