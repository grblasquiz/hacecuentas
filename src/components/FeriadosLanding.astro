---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CalendarGrid from './CalendarGrid.astro';
import type { FeriadosPais } from '../lib/data/feriados-latam-2026';
import { sourceRel } from '../lib/source-rel';

// Landing de feriados por país (mismo rol que la calc de feriados AR de la home,
// replicada para LATAM). Tabla-calendario crawleable + próximo feriado (client) +
// fines de semana largos + FAQ + schema (WebPage/BreadcrumbList/FAQPage/Dataset).

interface Props {
  data: FeriadosPais;
  related?: { href: string; label: string }[];
  title?: string;
  description?: string;
}
const { data, related = [], title: titleOverride, description: descriptionOverride } = Astro.props as Props;
const { pais, gentilicio, audience, slug, totalLabel, dataAsOf, marco, notaTipo, fuentes, feriados } = data;

const SITE = 'https://hacecuentas.com';
const URL = `${SITE}/${slug}`;
const total = feriados.length;
// Fin de semana largo = feriado en lunes o viernes (pega con el finde).
const findesLargos = feriados.filter((f) => f.dia === 'Lunes' || f.dia === 'Viernes');

// Próximo feriado — SSR (computado al build; el <script> lo refina client-side).
// La build corre a diario (data-refresh cron), así que el SSR se mantiene fresco
// para los crawlers, que es lo que permite rankear "cuándo es el próximo feriado".
const buildHoy = new Date().toISOString().slice(0, 10);
const pendientes = feriados.filter((f) => f.fecha >= buildHoy);
const proximo = pendientes[0] ?? null;
const diasHasta = proximo
  ? Math.max(0, Math.round((Date.parse(proximo.fecha + 'T00:00:00') - Date.parse(buildHoy + 'T00:00:00')) / 86400000))
  : null;
const quedanEnAnio = pendientes.length;
const diasHastaTxt = diasHasta === 0 ? 'es hoy' : diasHasta === 1 ? 'es mañana' : `faltan ${diasHasta} días`;

// Cross-linking entre países (cluster temático de feriados LATAM).
const OTROS_FERIADOS = [
  { slug: 'calculadora-feriados-argentina-2026-calendario', pais: 'Argentina', flag: '🇦🇷' },
  { slug: 'feriados-chile-2026', pais: 'Chile', flag: '🇨🇱' },
  { slug: 'feriados-colombia-2026', pais: 'Colombia', flag: '🇨🇴' },
  { slug: 'feriados-peru-2026', pais: 'Perú', flag: '🇵🇪' },
  { slug: 'feriados-mexico-2026', pais: 'México', flag: '🇲🇽' },
  { slug: 'feriados-ecuador-2026', pais: 'Ecuador', flag: '🇪🇨' },
].filter((p) => p.slug !== slug);

const fmtFecha = (iso: string) => {
  const [, m, d] = iso.split('-');
  const meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
  return `${d}/${meses[Number(m) - 1]}`;
};
const mesesLargos = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const fmtLarga = (iso: string) => { const [, m, d] = iso.split('-'); return `${Number(d)} de ${mesesLargos[Number(m) - 1]}`; };

const title = titleOverride ?? `Calendario ${pais} 2026: feriados y días festivos con fechas | Hacé Cuentas`;
const description = descriptionOverride ?? `Calendario ${pais} 2026: los ${total} feriados y días festivos con la fecha exacta, el día de la semana y todos los fines de semana largos y puentes. Mirá cuál es el próximo. Datos oficiales verificados.`;

const faq = [
  { q: `¿Cuántos feriados hay en ${pais} en 2026?`, a: `En 2026 hay ${totalLabel} en ${pais}. El detalle con la fecha exacta y el día de la semana de cada uno está en la tabla de arriba.` },
  { q: `¿Cuándo es el próximo feriado en ${pais}?`, a: proximo ? `El próximo feriado en ${pais} es el ${fmtLarga(proximo.fecha)} (${proximo.dia}): ${proximo.nombre}${diasHasta !== null && diasHasta > 1 ? `, faltan ${diasHasta} días` : ''}. Quedan ${quedanEnAnio} feriado${quedanEnAnio === 1 ? '' : 's'} en lo que resta de 2026. La tabla marca el próximo automáticamente según la fecha de hoy.` : `Ya pasaron todos los feriados nacionales de 2026 en ${pais}. Usá el calendario para planificar tus días libres del próximo año.` },
  { q: `¿Cuántos fines de semana largos hay en 2026?`, a: `En 2026 hay ${findesLargos.length} feriados que caen lunes o viernes en ${pais}, así que arman un fin de semana largo. Sumando puentes y feriados pegados, conviene mirar el calendario completo.` },
  { q: `¿Estos feriados son nacionales o también hay locales?`, a: `La tabla lista los feriados nacionales de ${pais} (válidos en todo el país). Además puede haber feriados locales o provinciales según la ciudad o región, que no están incluidos acá.` },
  { q: `¿Se trabaja en los feriados? ¿Cómo se paga?`, a: `${notaTipo || 'Los feriados son días de descanso; si trabajás, suele corresponder un pago con recargo según la legislación laboral vigente.'}` },
  { q: `¿De dónde salen estas fechas?`, a: `De las normas oficiales de ${pais} (${marco}). Verificamos cada fecha y su día de la semana contra el calendario real 2026. Última revisión: ${dataAsOf}.` },
  { q: `¿Puedo usar este calendario en mi web o trabajo?`, a: `Sí, bajo licencia CC-BY 4.0: reproducí los datos citando la fuente con un enlace a hacecuentas.com. Más abajo está el bloque "Cómo citar".` },
];

const datasetSchema = {
  '@type': 'Dataset', '@id': `${URL}#dataset`,
  name: `Feriados ${pais} 2026 — calendario oficial`,
  description: `Calendario de feriados nacionales de ${pais} en 2026: fecha observada, día de la semana y tipo de cada feriado. ${marco}.`,
  url: URL, license: 'https://creativecommons.org/licenses/by/4.0/', isAccessibleForFree: true,
  inLanguage: 'es', dateModified: dataAsOf, temporalCoverage: '2026',
  spatialCoverage: { '@type': 'Place', name: pais },
  creator: { '@type': 'Organization', name: 'Hacé Cuentas', url: SITE },
  keywords: [`feriados ${pais}`, `feriados ${pais} 2026`, `festivos ${pais} 2026`, 'calendario', 'fines de semana largos'],
  variableMeasured: ['Fecha del feriado', 'Día de la semana', 'Nombre del feriado', 'Tipo'],
};
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', '@id': `${URL}#webpage`, name: title, description, url: URL, inLanguage: 'es', dateModified: dataAsOf, mainEntity: { '@id': `${URL}#dataset` } },
  datasetSchema,
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: `Feriados ${pais} 2026`, item: URL } ] },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
] };
---

<Layout title={title} description={description} canonical={`/${slug}`} audience={audience} schema={schema}>
  <Header slot="header" />
  <main class="article-main">
    <article class="feriados-page">
      <header>
        <nav class="crumbs"><a href="/">Inicio</a> <span>›</span> <span>Calendario {pais} 2026</span></nav>
        <h1>Calendario {pais} 2026: feriados y días festivos</h1>
        <p class="lede">Todos los <strong>feriados y días festivos de {pais}</strong> en 2026, con la fecha exacta, el día de la semana y los <strong>fines de semana largos</strong>. Para que {gentilicio} planifiquen sus días libres.</p>
        <p class="updated">Última revisión: <time datetime={dataAsOf}>{dataAsOf}</time> · Licencia <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC-BY 4.0</a></p>
        {proximo && (
          <div class="proximo-hero" data-proximo>
            <span class="proximo-hero-label">⏳ Próximo feriado en {pais}</span>
            <span class="proximo-hero-main"><strong>{proximo.dia} {fmtLarga(proximo.fecha)}</strong> — {proximo.nombre}</span>
            <span class="proximo-hero-days" data-proximo-days>{diasHastaTxt}</span>
          </div>
        )}
      </header>

      <section class="stats-callout">
        <div class="stat"><span class="stat-num">{total}</span><span class="stat-label">feriados en 2026</span></div>
        <div class="stat" id="proximo-stat"><span class="stat-num" id="proximo-fecha">{proximo ? fmtFecha(proximo.fecha) : '2027'}</span><span class="stat-label" id="proximo-label">{proximo ? `${proximo.dia} · próximo feriado` : 'sin feriados pendientes'}</span></div>
        <div class="stat"><span class="stat-num">{findesLargos.length}</span><span class="stat-label">fines de semana largos</span></div>
      </section>

      <section class="cal-visual">
        <h2>Calendario {pais} 2026 mes a mes</h2>
        <p>El año completo en un vistazo: los <strong>{total} feriados</strong> están marcados en <span style="background:var(--accent,#2c5cdc);color:#fff;padding:0 .4rem;border-radius:5px;font-weight:600;">color</span>. Más abajo tenés la tabla con la fecha exacta, el día y el tipo de cada uno.</p>
        <CalendarGrid feriados={feriados.map((f) => ({ fecha: f.fecha, nombre: f.nombre }))} pais={pais} />
      </section>

      <section>
        <h2>Tabla de feriados y días festivos de {pais} 2026</h2>
        <div class="table-wrap">
          <table id="feriados-table">
            <thead><tr><th class="l">Fecha</th><th class="l">Día</th><th class="l">Feriado</th><th class="l">Tipo</th></tr></thead>
            <tbody>
              {feriados.map((f) => (
                <tr data-fecha={f.fecha}>
                  <td class="l nowrap">{fmtFecha(f.fecha)}</td>
                  <td class="l">{f.dia}</td>
                  <td class="l">{f.nombre}{f.nota && <span class="feriado-nota"> · {f.nota}</span>}</td>
                  <td class="l">{f.tipo}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {notaTipo && <p class="note">{notaTipo}</p>}
      </section>

      <section>
        <h2>Fines de semana largos 2026 en {pais}</h2>
        <p>Estos feriados caen lunes o viernes, así que pegan con el fin de semana:</p>
        <ul class="findes">
          {findesLargos.map((f) => (
            <li><strong>{f.dia} {fmtFecha(f.fecha)}</strong> — {f.nombre}</li>
          ))}
        </ul>
        <p class="note">Un <strong>puente</strong> es cuando tomás el día hábil que queda entre un feriado y el fin de semana (por ejemplo, un martes feriado + el lunes libre) para armarte una escapada más larga.</p>
      </section>

      {OTROS_FERIADOS.length > 0 && (
        <section class="otros-paises">
          <h2>Feriados de otros países en 2026</h2>
          <p>Calendarios de feriados de otros países de la región, con fechas, días de la semana y fines de semana largos:</p>
          <ul class="paises-links">
            {OTROS_FERIADOS.map((p) => (<li><a href={`/${p.slug}`}>{p.flag} Feriados {p.pais} 2026</a></li>))}
          </ul>
        </section>
      )}

      {related.length > 0 && (
        <section>
          <h2>Calculá con el calendario</h2>
          <ul class="calc-links">
            {related.map((r) => (<li><a href={r.href}>{r.label}</a></li>))}
          </ul>
        </section>
      )}

      <section class="cite-instructions">
        <h2>Cómo citar este calendario</h2>
        <p>¿Usás estas fechas en una nota, app o web? La atribución pedida es:</p>
        <pre><code>Fuente: Hacé Cuentas — {URL}
Feriados {pais} 2026 · Licencia CC-BY 4.0</code></pre>
      </section>

      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </section>

      <section class="fuentes">
        <h2>Fuentes</h2>
        <ul>{fuentes.map((s) => (<li><a href={s.url} rel={sourceRel(s.url)} target="_blank">{s.nombre}</a></li>))}</ul>
      </section>
    </article>
  </main>
  <Footer slot="footer" />
</Layout>

<script is:inline>
  // Marca el próximo feriado según la fecha de hoy (client-side → siempre fresco).
  (function () {
    const hoy = new Date();
    const hoyISO = hoy.getFullYear() + '-' + String(hoy.getMonth() + 1).padStart(2, '0') + '-' + String(hoy.getDate()).padStart(2, '0');
    const rows = Array.prototype.slice.call(document.querySelectorAll('#feriados-table tbody tr'));
    let prox = null;
    for (const tr of rows) {
      const f = tr.getAttribute('data-fecha');
      if (f && f >= hoyISO) { prox = { fecha: f, row: tr }; break; }
    }
    const numEl = document.getElementById('proximo-fecha');
    const labelEl = document.getElementById('proximo-label');
    if (prox && numEl && labelEl) {
      const nombre = prox.row.children[2].textContent.split('·')[0].trim();
      const dia = prox.row.children[1].textContent.trim();
      const [, m, d] = prox.fecha.split('-');
      const meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
      numEl.textContent = d + '/' + meses[Number(m) - 1];
      labelEl.textContent = dia + ' · ' + nombre;
      prox.row.classList.add('proximo-row');
      const td = prox.row.children[2];
      const badge = document.createElement('span');
      badge.className = 'proximo-badge';
      badge.textContent = 'Próximo';
      td.appendChild(badge);
      // Refrescar el hero del próximo feriado (el SSR es del build; esto lo deja exacto).
      const dd = Math.max(0, Math.round((Date.parse(prox.fecha + 'T00:00:00') - Date.parse(hoyISO + 'T00:00:00')) / 86400000));
      const heroDays = document.querySelector('[data-proximo-days]');
      if (heroDays) heroDays.textContent = dd === 0 ? 'es hoy' : dd === 1 ? 'es mañana' : 'faltan ' + dd + ' días';
      const heroMain = document.querySelector('.proximo-hero-main');
      const mesesL = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
      if (heroMain) heroMain.innerHTML = '<strong>' + dia + ' ' + Number(d) + ' de ' + mesesL[Number(m) - 1] + '</strong> — ' + nombre;
    } else if (numEl && labelEl) {
      numEl.textContent = '2027';
      labelEl.textContent = 'sin feriados pendientes en 2026';
      const hero = document.querySelector('[data-proximo]');
      if (hero) hero.style.display = 'none';
    }
  })();
</script>

<style>
  .feriados-page { max-width: 900px; margin: 0 auto; padding: 1rem 1rem 4rem; }
  .crumbs { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .feriados-page h1 { font-size: 2rem; line-height: 1.2; margin-bottom: 1rem; }
  .lede { font-size: 1.1rem; line-height: 1.6; color: var(--text); }
  .updated { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem; }
  .updated a { color: var(--accent); }
  .feriados-page h2 { font-size: 1.4rem; margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .stats-callout { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin: 1.75rem 0; }
  .stat { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 0.6rem; padding: 0.9rem 1rem; text-align: center; }
  .stat-num { display: block; font-size: 1.35rem; font-weight: 700; color: var(--accent); line-height: 1.2; }
  .stat-label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }
  .table-wrap { overflow-x: auto; margin: 1.25rem 0; }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th, td { padding: 0.6rem 0.7rem; text-align: left; border-bottom: 1px solid var(--border); }
  th { background: var(--bg-soft); font-weight: 600; }
  .nowrap { white-space: nowrap; }
  .feriado-nota { color: var(--text-muted); font-size: 0.82rem; }
  tr.proximo-row { background: color-mix(in srgb, var(--accent) 9%, transparent); }
  .proximo-badge { display: inline-block; margin-left: 0.5rem; padding: 0.05rem 0.45rem; font-size: 0.7rem; font-weight: 700; color: #fff; background: var(--accent); border-radius: 0.4rem; vertical-align: middle; }
  .note { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem; }
  .findes li, .calc-links li, .fuentes li { line-height: 1.7; margin-bottom: 0.4rem; }
  .findes, .calc-links, .fuentes ul { margin-left: 1.25rem; }
  .calc-links a, .fuentes a { color: var(--accent); }
  .cite-instructions { margin-top: 2.5rem; padding: 1.1rem; background: var(--bg-soft); border-radius: 0.6rem; }
  .cite-instructions pre { background: var(--code-bg, #eaeef3); padding: 0.75rem; border-radius: 0.4rem; overflow-x: auto; font-size: 0.85rem; white-space: pre-wrap; }
  .faq details { border-bottom: 1px solid var(--border); padding: 0.75rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq details p { margin-top: 0.5rem; color: var(--text-muted); line-height: 1.6; }
  .proximo-hero { display: flex; flex-direction: column; gap: 0.15rem; margin-top: 1rem; padding: 0.85rem 1.1rem; border-radius: 0.7rem; background: color-mix(in srgb, var(--accent) 10%, var(--bg-card, var(--bg))); border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border)); }
  .proximo-hero-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent-strong, var(--accent)); }
  .proximo-hero-main { font-size: 1.05rem; color: var(--text); line-height: 1.35; }
  .proximo-hero-days { font-size: 0.85rem; color: var(--text-muted); }
  .otros-paises .paises-links { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 1rem; }
  .otros-paises .paises-links a { color: var(--accent); text-decoration: none; font-weight: 600; }
  @media (max-width: 520px) { .otros-paises .paises-links { grid-template-columns: 1fr; } }
</style>
