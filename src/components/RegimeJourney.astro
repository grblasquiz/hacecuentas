---
interface JourneyLink { href: string; label: string; note: string }
interface Props {
  country: string;
  regime: string;
  headline: string;
  intro: string;
  steps: [string, string, string];
  links: JourneyLink[];
  locale?: 'es' | 'pt' | 'en';
  tone?: 'ocean' | 'emerald' | 'amber' | 'violet';
}

const {
  country, regime, headline, intro, steps, links,
  locale = 'es', tone = 'ocean',
} = Astro.props;
const labels = {
  es: { eyebrow: 'Ruta rápida', step: 'Paso', open: 'Abrir herramienta' },
  pt: { eyebrow: 'Percurso rápido', step: 'Passo', open: 'Abrir ferramenta' },
  en: { eyebrow: 'Quick path', step: 'Step', open: 'Open tool' },
}[locale];
---

<section class={`regime-journey ${tone}`} aria-labelledby={`regime-${regime.replace(/\s+/g, '-').toLowerCase()}`}>
  <div class="rj-shell">
    <header class="rj-head">
      <div>
        <span class="rj-kicker">{labels.eyebrow} · {country}</span>
        <h2 id={`regime-${regime.replace(/\s+/g, '-').toLowerCase()}`}>{headline}</h2>
      </div>
      <p>{intro}</p>
    </header>

    <ol class="rj-steps" aria-label={`${regime}: ${labels.eyebrow}`}>
      {steps.map((step, index) => (
        <li><span>{index + 1}</span><div><small>{labels.step} {index + 1}</small><b>{step}</b></div></li>
      ))}
    </ol>

    <nav class="rj-actions" aria-label={`${regime}: herramientas`}>
      {links.map((link, index) => (
        <a href={link.href} class:list={{ primary: index === 0 }}>
          <span><b>{link.label}</b><small>{link.note}</small></span>
          <i aria-hidden="true">{index === 0 ? '→' : '↗'}</i>
          <em>{labels.open}</em>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .regime-journey{--rj:#174b7a;--rj-soft:#eaf4fb;--rj-ink:#102c43;padding:clamp(3rem,6vw,5.5rem) 1rem;background:linear-gradient(180deg,#f8fbfd,#fff)}
  .regime-journey.emerald{--rj:#087f5b;--rj-soft:#e7f8f1;--rj-ink:#123f34}.regime-journey.amber{--rj:#a24b06;--rj-soft:#fff3df;--rj-ink:#4b2c12}.regime-journey.violet{--rj:#6750a4;--rj-soft:#f1edff;--rj-ink:#33275c}
  .rj-shell{max-width:1120px;margin:auto}.rj-head{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(1.5rem,4vw,4rem);align-items:end;margin-bottom:2rem}.rj-kicker{display:block;color:var(--rj);font-size:.78rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;margin-bottom:.7rem}.rj-head h2{margin:0;color:var(--rj-ink);font-size:clamp(2rem,4vw,3.5rem);line-height:1.02;letter-spacing:-.045em}.rj-head p{margin:0;color:#4b6172;font-size:1.05rem;line-height:1.65}
  .rj-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:0 0 1rem;padding:0;list-style:none;background:#cbd9e2;border:1px solid #cbd9e2;border-radius:20px;overflow:hidden}.rj-steps li{display:flex;gap:.9rem;align-items:center;padding:1.15rem;background:#fff}.rj-steps li>span{display:grid;place-items:center;width:2.3rem;height:2.3rem;flex:none;border-radius:50%;background:var(--rj-soft);color:var(--rj);font-weight:900}.rj-steps small{display:block;color:#718291;font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.rj-steps b{display:block;color:var(--rj-ink);font-size:.95rem;line-height:1.25;margin-top:.2rem}
  .rj-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}.rj-actions a{position:relative;display:flex;min-height:105px;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 1.2rem;border:1px solid #d7e1e8;border-radius:16px;background:#fff;color:var(--rj-ink);text-decoration:none;transition:transform .18s,border-color .18s,box-shadow .18s}.rj-actions a:hover{transform:translateY(-2px);border-color:var(--rj);box-shadow:0 12px 28px #173d5a15}.rj-actions a.primary{background:var(--rj);border-color:var(--rj);color:#fff}.rj-actions b,.rj-actions small{display:block}.rj-actions b{font-size:1rem}.rj-actions small{margin-top:.3rem;line-height:1.35;opacity:.75}.rj-actions i{font-style:normal;font-size:1.4rem}.rj-actions em{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .rj-actions a:focus-visible{outline:3px solid #f5b942;outline-offset:3px}
  @media(max-width:760px){.regime-journey{padding-inline:.85rem}.rj-head{grid-template-columns:1fr;gap:1rem}.rj-steps{grid-template-columns:1fr}.rj-actions{grid-template-columns:1fr}.rj-actions a{min-height:88px}.rj-head h2{font-size:2.15rem}}
</style>
