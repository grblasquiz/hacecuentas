    position: absolute;
    top: 0;
    left: 0;
    padding: 0.75rem 1rem;
    background: var(--accent);
    color: #fff;
    z-index: 1000;
    transform: translateY(-200%);
    transition: transform 0.15s ease;
  }
  .skip-link:focus {
    transform: translateY(0);
    position: fixed;
    top: 1rem;
    left: 1rem;
    padding: 0.75rem 1rem;
    background: var(--accent);
