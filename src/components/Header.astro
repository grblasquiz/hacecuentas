---
export interface Props { lang?: 'es' | 'en' | 'pt'; }
const { lang = 'es' } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath.startsWith(path);
// NOTA: el array de calcs ya NO se inlinea en cada página.
// Se sirve como /search-index.json (ver src/pages/search-index.json.ts)
// y se fetchea lazy al abrir el modal de search. -90% HTML weight.

const translations = {
  en: {
    skip: 'Skip to content', logoAria: 'Hacé Cuentas — Home',
    navAria: 'Main navigation', allCalcs: 'All calculators',
    searchAria: 'Search calculator', searchTitle: 'Search (⌘K)', searchLabel: 'Search',
    themeAria: 'Toggle theme', themeTitle: 'Toggle light/dark theme', menuAria: 'Open menu',
  },
  pt: {
    skip: 'Pular para o conteúdo', logoAria: 'Hacé Cuentas — Início',
    navAria: 'Navegação principal', allCalcs: 'Todas as calculadoras',
    searchAria: 'Buscar calculadora', searchTitle: 'Buscar (⌘K)', searchLabel: 'Buscar',
    themeAria: 'Alternar tema', themeTitle: 'Alternar tema claro/escuro', menuAria: 'Abrir menu',
  },
  es: {
    skip: 'Saltar al contenido', logoAria: 'Hacé Cuentas — Inicio',
    navAria: 'Navegación principal', allCalcs: 'Cambio de monedas',
    searchAria: 'Buscar calculadora', searchTitle: 'Buscar (⌘K)', searchLabel: 'Buscar',
    themeAria: 'Cambiar tema', themeTitle: 'Cambiar tema claro/oscuro', menuAria: 'Abrir menú',
  },
};
const t = translations[lang as keyof typeof translations] || translations.es;
const isIntl = lang === 'en' || lang === 'pt';
const intlHome = lang === 'en' ? '/en' : '/pt';

// Detección de país por path para nav country-aware
type Country = 'AR' | 'ES' | 'MX' | 'CO' | 'CL' | 'PE' | 'EC' | 'GLOBAL';
// Primer segmento del path (evita falsos positivos como /peso-ideal → 'pe', /como-... → 'co').
const _seg = currentPath.split('/')[1] || '';
let pageCountry: Country = 'AR';
if (_seg === 'es') pageCountry = 'ES';
else if (_seg === 'mx') pageCountry = 'MX';
else if (_seg === 'co') pageCountry = 'CO';
else if (_seg === 'cl') pageCountry = 'CL';
else if (_seg === 'pe') pageCountry = 'PE';
else if (_seg === 'ec') pageCountry = 'EC';
else if (_seg === 'global') pageCountry = 'GLOBAL';

// Nav items por país
const COUNTRY_NAVS: Record<Country, Array<{href: string; label: string; activePath?: string}>> = {
  AR: [
    { href: '/cambio-de-monedas', label: 'Cambio de monedas' },
    { href: '/cotizacion-cripto', label: 'Cripto' },
    { href: '/inflacion-argentina', label: 'Inflación', activePath: '/inflacion' },
    { href: '/guias', label: 'Guías', activePath: '/guia' },
    { href: '/categoria/finanzas', label: 'Finanzas' },
    { href: '/categoria/marketing', label: 'Marketing' },
    { href: '/categoria/salud', label: 'Salud' },
    { href: '/categoria/viajes', label: 'Viajes' },
    { href: '/categoria/vida', label: 'Vida' },
  ],
  ES: [
    { href: '/es/calculadora-irpf-2026-tramos-espana-nomina', label: 'IRPF', activePath: '/es/calculadora-irpf' },
    { href: '/es/calculadora-hipoteca-fija-vs-variable-euribor-espana-2026', label: 'Hipoteca', activePath: '/es/calculadora-hipoteca' },
    { href: '/es/calculadora-autonomo-cuota-2026-espana-rendimiento-neto', label: 'Autónomos', activePath: '/es/calculadora-autonomo' },
    { href: '/es/calculadora-finiquito-despido-improcedente-espana-2026', label: 'Finiquito', activePath: '/es/calculadora-finiquito' },
    { href: '/es/calculadora-jubilacion-espana-2026-pension-anos-cotizados', label: 'Jubilación', activePath: '/es/calculadora-jubilacion' },
    { href: '/es', label: 'Todas' },
  ],
  MX: [
    { href: '/mx/calculadora-isr-mexico-2026-tarifa-mensual-empleado', label: 'ISR', activePath: '/mx/calculadora-isr' },
    { href: '/mx/calculadora-finiquito-mexico-completo-rescision-relacion', label: 'Finiquito', activePath: '/mx/calculadora-finiquito' },
    { href: '/mx/calculadora-aguinaldo-mexico-2026-15-dias-tope-30', label: 'Aguinaldo', activePath: '/mx/calculadora-aguinaldo' },
    { href: '/mx/calculadora-imss-cuotas-empleado-patron-mexico-2026', label: 'IMSS', activePath: '/mx/calculadora-imss' },
    { href: '/mx/calculadora-rfc-homoclave-persona-fisica-mexico', label: 'RFC', activePath: '/mx/calculadora-rfc' },
    { href: '/mx', label: 'Todas' },
  ],
  CO: [
    { href: '/co/calculadora-retefuente-colombia-2026-empleado-tabla', label: 'Retefuente', activePath: '/co/calculadora-retefuente' },
    { href: '/co/calculadora-prima-legal-colombia-30-dias-junio-diciembre', label: 'Prima', activePath: '/co/calculadora-prima' },
    { href: '/co/calculadora-cesantias-colombia-12-porciento-anual', label: 'Cesantías', activePath: '/co/calculadora-cesantias' },
    { href: '/co/calculadora-liquidacion-laboral-colombia-completa-cesantias', label: 'Liquidación', activePath: '/co/calculadora-liquidacion' },
    { href: '/co/calculadora-salario-minimo-colombia-2026-auxilio-transporte', label: 'Salario mín.', activePath: '/co/calculadora-salario' },
    { href: '/co', label: 'Todas' },
  ],
  CL: [
    { href: '/cl/calculadora-sueldo-liquido-chile-2026-impuesto-segunda-categoria', label: 'Sueldo líquido', activePath: '/cl/calculadora-sueldo' },
    { href: '/cl/calculadora-finiquito-chile-completo-causal-despido', label: 'Finiquito', activePath: '/cl/calculadora-finiquito' },
    { href: '/cl/calculadora-afp-pension-chile-2026-tabla-comisiones', label: 'AFP', activePath: '/cl/calculadora-afp' },
    { href: '/cl/calculadora-isapre-cotizacion-chile-7-porcentaje-plan', label: 'Isapre', activePath: '/cl/calculadora-isapre' },
    { href: '/cl/calculadora-credito-hipotecario-chile-uf-cmf-2026', label: 'Hipoteca', activePath: '/cl/calculadora-credito-hipotecario' },
    { href: '/cl', label: 'Todas' },
  ],
  PE: [
    { href: '/pe/calculadora-sueldo-neto-peru', label: 'Sueldo neto', activePath: '/pe/calculadora-sueldo-neto' },
    { href: '/pe/calculadora-cts-peru-deposito-semestral', label: 'CTS', activePath: '/pe/calculadora-cts' },
    { href: '/pe/calculadora-gratificacion-peru-julio-diciembre', label: 'Gratificación', activePath: '/pe/calculadora-gratificacion' },
    { href: '/pe/calculadora-impuesto-renta-quinta-categoria-peru', label: 'Renta 5ta', activePath: '/pe/calculadora-impuesto-renta' },
    { href: '/pe', label: 'Todas' },
  ],
  EC: [
    { href: '/ec/calculadora-sueldo-neto-ecuador', label: 'Sueldo neto', activePath: '/ec/calculadora-sueldo-neto' },
    { href: '/ec/calculadora-decimo-tercer-sueldo-ecuador', label: 'Décimo 13°', activePath: '/ec/calculadora-decimo-tercer' },
    { href: '/ec/calculadora-liquidacion-finiquito-ecuador', label: 'Finiquito', activePath: '/ec/calculadora-liquidacion' },
    { href: '/ec/calculadora-iva-ecuador', label: 'IVA', activePath: '/ec/calculadora-iva' },
    { href: '/ec', label: 'Todas' },
  ],
  GLOBAL: [
    { href: '/global', label: 'Todas' },
    { href: '/categoria/salud', label: 'Salud' },
    { href: '/categoria/finanzas', label: 'Finanzas' },
    { href: '/categoria/cocina', label: 'Cocina' },
    { href: '/categoria/mascotas', label: 'Mascotas' },
    { href: '/categoria/matematica', label: 'Matemática' },
  ],
};
const navItems = COUNTRY_NAVS[pageCountry];
---

<a href="#main" class="skip-link">{t.skip}</a>

<header class="site-header" data-lang={lang}>
  <div class="header-container">
    <a href={isIntl ? intlHome : '/'} class="logo" aria-label={t.logoAria}>
      <picture>
        <source type="image/webp" srcset="/logo-64.webp 1x, /logo-128.webp 2x" />
        <img class="logo-mark" src="/logo-64.png" srcset="/logo-64.png 1x, /logo-128.png 2x" alt="Hacé Cuentas — Calculadoras online" width="32" height="32" loading="eager" decoding="async" aria-hidden="true" />
      </picture>
      <span class="logo-text">Hacé Cuentas</span>
    </a>

    {isIntl ? (
      <nav aria-label={t.navAria}>
        <a href={intlHome} class={currentPath === intlHome || currentPath === `${intlHome}/` ? 'active' : ''}>{t.allCalcs}</a>
      </nav>
    ) : (
      <nav aria-label={t.navAria}>
        {navItems.map(item => (
          <a href={item.href} class={isActive(item.activePath || item.href) ? 'active' : ''}>{item.label}</a>
        ))}
      </nav>
    )}

    <div class="header-actions">
      <button class="header-search-btn" id="open-search" aria-label={t.searchAria} title={t.searchTitle}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="search-label">{t.searchLabel}</span>
        <kbd class="kbd">⌘K</kbd>
      </button>

      <div class="country-selector" id="country-selector">
        <button class="icon-btn country-btn" id="country-btn" aria-label={lang === 'en' ? `Country / language: ${pageCountry || 'AR'}` : lang === 'pt' ? `País / idioma: ${pageCountry || 'AR'}` : `País / idioma: ${pageCountry || 'AR'}`} aria-expanded="false" aria-haspopup="listbox" title={lang === 'en' ? 'Country / language' : 'País / idioma'}>
          <span class="country-flag" id="country-flag">🌎</span>
          <span class="country-code" id="country-code">AR</span>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="country-dropdown" id="country-dropdown" hidden role="listbox">
          <a href="/" data-country="AR" role="option"><span>🇦🇷</span> Argentina</a>
          <a href="/global" data-country="global" role="option"><span>🌎</span> Global (español)</a>
          <a href="/es" data-country="ES" role="option"><span>🇪🇸</span> España</a>
          <a href="/mx" data-country="MX" role="option"><span>🇲🇽</span> México</a>
          <a href="/co" data-country="CO" role="option"><span>🇨🇴</span> Colombia</a>
          <a href="/cl" data-country="CL" role="option"><span>🇨🇱</span> Chile</a>
          <a href="/pe" data-country="PE" role="option"><span>🇵🇪</span> Perú</a>
          <a href="/ec" data-country="EC" role="option"><span>🇪🇨</span> Ecuador</a>
          <a href="/pt" data-country="BR" role="option"><span>🇧🇷</span> Brasil</a>
          <a href="/en" data-country="EN" role="option"><span>🇺🇸</span> English</a>
        </div>
      </div>

      <button class="icon-btn" id="theme-toggle" aria-label={t.themeAria} title={t.themeTitle}>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button class="menu-toggle icon-btn" aria-label={t.menuAria} aria-expanded="false" id="menu-toggle">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="17" x2="20" y2="17"/>
        </svg>
      </button>
    </div>
  </div>

  {isIntl ? (
    <div class="mobile-nav" id="mobile-nav" hidden>
      <a href={intlHome}>🔍 {t.allCalcs}</a>
      <a href={`${intlHome}#popular`}>⭐ {lang === 'pt' ? 'Populares' : 'Popular'}</a>
    </div>
  ) : (
    <div class="mobile-nav" id="mobile-nav" hidden>
      {navItems.map(item => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href="/buscar">🔍 Buscar</a>
    </div>
  )}
</header>

<!-- Search Modal -->
<div class="search-modal" id="search-modal" hidden role="dialog" aria-modal="true" aria-label={lang === 'en' ? 'Calculator search' : lang === 'pt' ? 'Busca de calculadoras' : 'Buscador de calculadoras'} data-lang={lang}>
  <div class="search-backdrop" data-close></div>
  <div class="search-panel">
    <div class="search-input-wrap">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input id="search-input" type="search" placeholder={lang === 'en' ? 'Search calculator...' : lang === 'pt' ? 'Buscar calculadora...' : 'Buscar calculadora...'} autocomplete="off" />
      <kbd class="kbd">ESC</kbd>
    </div>
    <div class="search-results" id="search-results"></div>
    <div class="search-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> {lang === 'en' ? 'navigate' : lang === 'pt' ? 'navegar' : 'navegar'}</span>
      <span><kbd>↵</kbd> {lang === 'en' ? 'open' : lang === 'pt' ? 'abrir' : 'abrir'}</span>
      <a href={lang === 'en' ? '/en' : lang === 'pt' ? '/pt' : '/buscar'}>{lang === 'en' ? 'See all →' : lang === 'pt' ? 'Ver todas →' : 'Ver todas →'}</a>
    </div>
  </div>
</div>

<script>
  // CRÍTICO: Astro ClientRouter swappea el <body> en cada navegación SPA → los
  // nodos del header (#country-btn, #theme-toggle, #menu-toggle) se reemplazan por
  // nodos nuevos sin listeners. Si attachábamos una sola vez al cargar el módulo,
  // tras navegar el dropdown de países dejaba de abrir ("clickeo el 🌎 y no pasa
  // nada"). Fix: init idempotente (guard data-init) re-corrido en cada
  // astro:page-load. Mismo patrón que initSearch. Los listeners a nivel document
  // se attachan UNA vez (sobreviven al swap y resuelven por id al disparar).

  function applyTheme(theme) {
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('hc-theme', theme); } catch {}
  }
  function initTheme() {
    const saved = (() => { try { return localStorage.getItem('hc-theme'); } catch { return null; } })();
    const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    applyTheme(saved || system);
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle && !themeToggle.dataset.init) {
      themeToggle.dataset.init = '1';
      themeToggle.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme || 'light';
        applyTheme(current === 'dark' ? 'light' : 'dark');
      });
    }
  }

  const COUNTRY_FLAGS = { AR: '🇦🇷', global: '🌎', ES: '🇪🇸', MX: '🇲🇽', CO: '🇨🇴', CL: '🇨🇱', PE: '🇵🇪', EC: '🇪🇨', BR: '🇧🇷', EN: '🇺🇸' };
  const COUNTRY_LABELS = { AR: 'AR', global: 'GLO', ES: 'ES', MX: 'MX', CO: 'CO', CL: 'CL', PE: 'PE', EC: 'EC', BR: 'BR', EN: 'EN' };
  function currentCountry() {
    // Por SEGMENTO (no startsWith): evita que /peso-ideal→PE o /como-…→CO.
    const seg = (location.pathname.split('/')[1] || '').toLowerCase();
    const bySeg = { en: 'EN', pt: 'BR', es: 'ES', mx: 'MX', co: 'CO', cl: 'CL', pe: 'PE', ec: 'EC', global: 'global' };
    return bySeg[seg] || 'AR';
  }
  function initCountry() {
    const btn = document.getElementById('country-btn');
    const dropdown = document.getElementById('country-dropdown');
    const flagEl = document.getElementById('country-flag');
    const codeEl = document.getElementById('country-code');
    if (!btn || !dropdown || !flagEl || !codeEl) return;

    // Flag/label/opción-actual: re-aplicar SIEMPRE (el nodo puede ser nuevo tras swap)
    const current = currentCountry();
    flagEl.textContent = COUNTRY_FLAGS[current] || '🌎';
    codeEl.textContent = COUNTRY_LABELS[current] || 'AR';
    dropdown.querySelectorAll('a').forEach((a) => {
      a.classList.toggle('current', a.getAttribute('data-country') === current);
    });

    if (btn.dataset.init) return; // handlers ya attachados a ESTE nodo
    btn.dataset.init = '1';
    dropdown.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        try { localStorage.setItem('hc-country', a.getAttribute('data-country')); } catch {}
      });
    });
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (dropdown.hasAttribute('hidden')) { dropdown.removeAttribute('hidden'); btn.setAttribute('aria-expanded', 'true'); }
      else { dropdown.setAttribute('hidden', ''); btn.setAttribute('aria-expanded', 'false'); }
    });
  }

  function initMobileMenu() {
    const mToggle = document.getElementById('menu-toggle');
    const mobile = document.getElementById('mobile-nav');
    if (!mToggle || !mobile || mToggle.dataset.init) return;
    mToggle.dataset.init = '1';
    mToggle.addEventListener('click', () => {
      const open = !mobile.hasAttribute('hidden');
      if (open) { mobile.setAttribute('hidden', ''); mToggle.setAttribute('aria-expanded', 'false'); }
      else { mobile.removeAttribute('hidden'); mToggle.setAttribute('aria-expanded', 'true'); }
    });
  }

  // Listeners a nivel document: UNA sola vez (sobreviven al swap, resuelven por id).
  document.addEventListener('click', (e) => {
    const dd = document.getElementById('country-dropdown');
    const b = document.getElementById('country-btn');
    if (dd && b && !dd.hasAttribute('hidden') && !dd.contains(e.target) && !b.contains(e.target)) {
      dd.setAttribute('hidden', ''); b.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const dd = document.getElementById('country-dropdown');
    if (dd && !dd.hasAttribute('hidden')) {
      dd.setAttribute('hidden', '');
      document.getElementById('country-btn')?.setAttribute('aria-expanded', 'false');
    }
  });

  function initHeader() { initTheme(); initCountry(); initMobileMenu(); }
  initHeader();
  document.addEventListener('astro:page-load', initHeader);

  // Search modal — calcs se carga lazy al primer open (no inlinea en HTML).
  //
  // CRÍTICO: Astro ClientRouter swappea el body en cada navegación SPA, lo que
  // reemplaza #search-modal, #open-search, #search-input, #search-results con
  // nodos nuevos. Si capturamos las refs una sola vez al cargar el módulo, los
  // listeners quedan attached a elementos detached y la 2da apertura del modal
  // no abre nada (bug 28-may-2026: "anda bien la primera vez, después no").
  //
  // Fix: initSearch() re-querea el DOM y re-attacha listeners en cada
  // astro:page-load. Cada elemento lleva data-search-init como guard de
  // idempotencia para no duplicar handlers si el nodo sobrevive al swap.
  let calcs = null;                 // module-scoped: caché compartido entre swaps
  let calcsPromise = null;
  async function ensureCalcs() {
    if (calcs) return calcs;
    if (!calcsPromise) {
      calcsPromise = fetch('/search-index.json', { cache: 'force-cache' })
        .then((r) => r.ok ? r.json() : [])
        .catch(() => []);
    }
    calcs = await calcsPromise;
    return calcs;
  }

  const categoryLabels = { finanzas: 'Finanzas', negocios: 'Negocios', negocio: 'Negocios', salud: 'Salud', marketing: 'Marketing', deportes: 'Deportes', viajes: 'Viajes', vida: 'Vida', mascotas: 'Mascotas', matematica: 'Matemática', construccion: 'Construcción', cocina: 'Cocina' };
  const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  // XSS protection: escapar cualquier string antes de pegarlo en innerHTML
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }

  // Top picks curados para mostrar cuando no hay query (en vez de alfabético).
  // Mix de finanzas + salud + matemática para variedad temática.
  const DEFAULT_TOP_SLUGS = [
    'sueldo-en-mano-argentina',
    'calculadora-aguinaldo-sac',
    'calculadora-imc',
    'calculadora-interes-compuesto',
    'calculadora-porcentajes',
    'calculadora-plazo-fijo',
  ];
  function pickDefault(allCalcs) {
    // NOTA: el endpoint /search-index.json sirve claves abreviadas {s,h,d,c,i,a}
    // para reducir el JSON ~40%. NO usar c.slug/c.h1/c.description — quedan undefined.
    const bySlug = new Map(allCalcs.map(function (c) { return [c.s, c]; }));
    const picks = [];
    DEFAULT_TOP_SLUGS.forEach(function (s) {
      const c = bySlug.get(s);
      if (c) picks.push(c);
    });
    // Padding si alguno no existe
    if (picks.length < 6) {
      for (const c of allCalcs) {
        if (picks.length >= 6) break;
        if (!DEFAULT_TOP_SLUGS.includes(c.s)) picks.push(c);
      }
    }
    return picks.slice(0, 6);
  }

  // initSearch corre en DOMContentLoaded y en cada astro:page-load. Re-querea el
  // DOM (porque ClientRouter puede haber swapeado los nodos), arma openModal/
  // closeModal/renderResults sobre las refs FRESCAS y attacha listeners idempotente
  // (cada nodo lleva data-search-init para no duplicar handlers).
  function initSearch() {
    const modal = document.getElementById('search-modal');
    const openBtn = document.getElementById('open-search');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    if (!modal || !openBtn || !input || !results) return;

    const searchLang = modal.dataset.lang;
    const i18n = searchLang === 'en'
      ? { loading: 'Loading...', noResults: 'No results for' }
      : searchLang === 'pt'
      ? { loading: 'Carregando...', noResults: 'Sem resultados para' }
      : { loading: 'Cargando...', noResults: 'Sin resultados para' };
    let currentIndex = -1;

    function renderResults(q) {
      if (!calcs) {
        results.innerHTML = `<div class="no-results">${i18n.loading}</div>`;
        return;
      }
      const query = norm(q);
      let matches;
      if (query) {
        const _path = location.pathname;
        const preferredAudience =
          _path.startsWith('/es/') || _path === '/es' ? 'ES' :
          _path.startsWith('/mx/') || _path === '/mx' ? 'MX' :
          _path.startsWith('/co/') || _path === '/co' ? 'CO' :
          _path.startsWith('/cl/') || _path === '/cl' ? 'CL' :
          _path.startsWith('/en') ? 'EN' :
          _path.startsWith('/pt') ? 'BR' :
          _path.startsWith('/global') ? 'global' :
          'AR';
        // Score: +100 título empieza con query, +50 contiene, +10 slug/desc contiene,
        // +30 audience matches path, -20 audience de otro país.
        const scored = [];
        const isOtherCountry = function(a) {
          return ['AR','ES','MX','CO','CL','BO','PE','UY','BR'].indexOf(a) >= 0 && a !== preferredAudience;
        };
        for (const c of calcs) {
          const title = norm(c.h || '');
          const slug = norm(c.s || '');
          const desc = norm(c.d || '');
          let score = 0;
          if (title.startsWith(query)) score += 100;
          else if (title.includes(query)) score += 50;
          if (slug.includes(query) || desc.includes(query)) score += 10;
          if (score === 0) continue;
          if (c.a === preferredAudience) score += 30;
          else if (preferredAudience !== 'global' && isOtherCountry(c.a)) score -= 20;
          scored.push({ c: c, score: score });
        }
        scored.sort(function (a, b) { return b.score - a.score; });
        matches = scored.slice(0, 8).map(function (x) { return x.c; });
      } else {
        matches = pickDefault(calcs);
      }
      if (matches.length === 0) {
        results.innerHTML = `<div class="no-results">${i18n.noResults} "<strong>${escapeHtml(q)}</strong>"</div>`;
        return;
      }
      // Concatenación en vez de template literals: evita que Googlebot vea
      // `href="/${...}"` literal y lo trate como URL real (bug previo: aparecía
      // `http://hacecuentas.com/${c.slug}` como 404 en Search Console).
      const arrow = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>';
      results.innerHTML = matches.map(function (c, i) {
        var slug = escapeHtml(c.s);
        var icon = escapeHtml(c.i || '');
        var title = escapeHtml(c.h);
        var cat = escapeHtml(categoryLabels[c.c] || c.c || '');
        return '<a href="' + '/' + slug + '" class="result-item" data-index="' + i + '">'
          + '<span class="result-icon">' + icon + '</span>'
          + '<span class="result-body">'
          + '<span class="result-title">' + title + '</span>'
          + '<span class="result-cat">' + cat + '</span>'
          + '</span>'
          + arrow
          + '</a>';
      }).join('');
      currentIndex = -1;
    }

    const openModal = async () => {
      modal.hidden = false;
      setTimeout(() => input.focus(), 30);
      if (!calcs) {
        results.innerHTML = `<div class="no-results">${i18n.loading}</div>`;
        await ensureCalcs();
      }
      renderResults('');
    };
    const closeModal = () => {
      modal.hidden = true;
      input.value = '';
      currentIndex = -1;
    };

    // Guards de idempotencia: si el nodo sobrevive al swap de ClientRouter
    // (ej. el modal está fuera del fragmento swapeado), no duplicamos listeners.
    if (!openBtn.dataset.searchInit) {
      openBtn.dataset.searchInit = '1';
      openBtn.addEventListener('click', openModal);
      openBtn.addEventListener('mouseenter', ensureCalcs, { once: true });
      openBtn.addEventListener('focus', ensureCalcs, { once: true });
    }
    if (!modal.dataset.searchInit) {
      modal.dataset.searchInit = '1';
      modal.addEventListener('click', (e) => { if (e.target.dataset.close !== undefined) closeModal(); });
    }
    if (!input.dataset.searchInit) {
      input.dataset.searchInit = '1';
      input.addEventListener('input', (e) => renderResults(e.target.value));
    }

    // Expose para el handler global de teclado (se attacha una sola vez al document).
    window.__hcSearch = {
      modal, results, openModal, closeModal,
      getIndex: () => currentIndex,
      setIndex: (n) => { currentIndex = n; },
    };
  }

  // Document keydown listener: se attacha UNA sola vez en toda la sesión.
  // Lee siempre el estado fresco desde window.__hcSearch (que initSearch refresca
  // en cada page-load). De otra forma duplicaríamos handlers en cada swap.
  if (!window.__hcSearchKeydown) {
    window.__hcSearchKeydown = true;
    document.addEventListener('keydown', (e) => {
      const ctx = window.__hcSearch;
      if (!ctx) return;
      const { modal, results, openModal, closeModal, getIndex, setIndex } = ctx;
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openModal(); return; }
      if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target?.tagName || '')) {
        e.preventDefault(); openModal(); return;
      }
      if (modal.hidden) return;
      const items = results.querySelectorAll('.result-item');
      let idx = getIndex();
      if (e.key === 'Escape') { closeModal(); }
      else if (e.key === 'ArrowDown') {
        e.preventDefault();
        idx = Math.min(idx + 1, items.length - 1);
        setIndex(idx);
        items.forEach((it, i) => it.classList.toggle('active', i === idx));
        items[idx]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        idx = Math.max(idx - 1, 0);
        setIndex(idx);
        items.forEach((it, i) => it.classList.toggle('active', i === idx));
        items[idx]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter' && idx >= 0) {
        e.preventDefault();
        items[idx]?.click();
      }
    });
  }

  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>

<style>
  /* Skip-link pattern accesible: usa transform en vez de clip:rect(0,0,0,0)
