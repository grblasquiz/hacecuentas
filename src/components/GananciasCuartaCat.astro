---
// Flagship redesign de la calc "Ganancias 4ta categoría 2026" — Argentina (mockup Martin).
// Los números salen del motor real (src/lib/formulas/ganancias-cuarta-categoria-2026.ts)
// + sus constantes en src/lib/formulas/_ganancias-escala.ts (que el fetcher de ARCA
// auto-actualiza por semestre) y BASE_IMPONIBLE_MAXIMA_APORTES de sueldo-ar.ts.
// Domain "knowledge" (violeta) por el mockup, no por la categoría (impuestos→money).
// Header/footer = los globales del sitio.
import '../styles/calc-flagship.css';
import { md } from '../lib/markdown';
import { gananciasCuartaCategoria2026 } from '../lib/formulas/ganancias-cuarta-categoria-2026';
import {
  MNI_MENSUAL_BASE,
  INCREMENTO_CONYUGE_MENSUAL,
  INCREMENTO_HIJO_MENSUAL,
  ESCALA,
  aplicarEscalaMensual,
} from '../lib/formulas/_ganancias-escala';
import { BASE_IMPONIBLE_MAXIMA_APORTES } from '../lib/formulas/sueldo-ar';

interface Props { calc: any; related?: any[]; }
const { calc, related = [] } = Astro.props;

const fmt = (n: number) => '$' + Math.round(n).toLocaleString('es-AR');
const pct = (n: number, dec = 2) =>
  n.toLocaleString('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + '%';

const INIT = { sueldoBrutoMensual: 3_500_000, cargasFamiliares: 0, conyuge: 'no', hijos: 0, deduccionesEspeciales: 0 };
const init = gananciasCuartaCategoria2026(INIT);
const initAportes = Math.min(INIT.sueldoBrutoMensual, BASE_IMPONIBLE_MAXIMA_APORTES) * 0.17;
const initMarginal = aplicarEscalaMensual(init.gananciaNetaSujetaImpuesto / 12).marginal;

// Piso a partir del cual el motor empieza a liquidar impuesto (bisección sobre la
// fórmula real, no un valor hardcodeado): deducciones anuales / (0,83 × 13).
function pisoBruto(conyuge: string, hijos: number) {
  let lo = 500_000, hi = 12_000_000;
  for (let k = 0; k < 60; k++) {
    const m = (lo + hi) / 2;
    const r = gananciasCuartaCategoria2026({ ...INIT, sueldoBrutoMensual: m, conyuge, hijos });
    if (r.impuestoAnual > 0) hi = m; else lo = m;
  }
  return hi;
}
const PISO_SOLTERO = pisoBruto('no', 0);

const refRows = [2_000_000, 2_500_000, 3_000_000, 3_500_000, 4_500_000, 6_000_000].map((s) => {
  const r = gananciasCuartaCategoria2026({ ...INIT, sueldoBrutoMensual: s });
  return { bruto: s, mensual: r.impuestoMensual, anual: r.impuestoAnual, efectiva: r.tasaEfectiva };
});

// Porcentajes de las barras del desglose (sobre la ganancia anual del caso cargado)
const barDed = (init.deduccionesTotal / init.gananciaAnual) * 100;
const barGnsi = (init.gananciaNetaSujetaImpuesto / init.gananciaAnual) * 100;
const barImp = (init.impuestoAnual / init.gananciaAnual) * 100;

const escalaAttr = JSON.stringify(ESCALA.map((t) => ({ h: t.hasta === Infinity ? null : t.hasta, t: t.tasa, a: t.acumulado })));
const faq = calc.faq || [];
const sources = calc.sources || [];
---

<div
  class="cf-page gcc"
  data-domain="knowledge"
  data-mni={MNI_MENSUAL_BASE}
  data-conyuge={INCREMENTO_CONYUGE_MENSUAL}
  data-hijo={INCREMENTO_HIJO_MENSUAL}
  data-tope={BASE_IMPONIBLE_MAXIMA_APORTES}
  data-escala={escalaAttr}
>
  <nav class="cf-crumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Inicio</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li><a href="/categoria/impuestos">Impuestos</a></li>
      <li aria-hidden="true" class="cf-crumb__sep">›</li>
      <li aria-current="page">Ganancias 4ta categoría</li>
    </ol>
  </nav>

  <header class="cf-hero">
    <div class="cf-hero__main">
      <p class="cf-kicker"><span aria-hidden="true">🏛️</span> Argentina · Retención 4ta categoría · 2026</p>
      <h1 class="cf-h1">¿Cuánto te retienen de <span class="cf-yr">Ganancias</span>?</h1>
      <p class="cf-sub">Calculá la retención mensual del impuesto sobre tu sueldo con las deducciones de ARCA y la escala progresiva del Art. 94 vigente en 2026.</p>
      <ul class="cf-pills">
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Datos verificados 2026</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Cálculo privado</li>
        <li class="cf-pill"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Resultado explicado</li>
      </ul>
    </div>
    <div class="cf-hero__deco" aria-hidden="true">
      <span class="cf-deco-float"><span aria-hidden="true">🧾</span> Relación de dependencia</span>
      <div class="gcc-deco-wrap">
        <div class="cf-deco-card">
          <div class="cf-deco-card__label">Dato principal</div>
          <div class="cf-deco-card__value" id="gcc-deco-val">{fmt(init.impuestoMensual)}</div>
          <div class="cf-deco-card__note">Retención mensual · bruto {fmt(INIT.sueldoBrutoMensual)}</div>
        </div>
        <span class="cf-deco-badge gcc-badge">4ta</span>
      </div>
      <div class="cf-deco-sub"><strong>Tasa efectiva</strong> <span class="cf-deco-chip" id="gcc-deco-pct">{pct(init.tasaEfectiva)}</span></div>
    </div>
  </header>

  <section class="cf-card" id="calc">
    <div class="cf-panel">
      <div class="cf-panel__head">
        <div>
          <p class="cf-panel__eyebrow">Calculadora</p>
          <h2 class="cf-panel__title">Tu sueldo y tus deducciones</h2>
        </div>
        <span class="cf-panel__priv"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> No guardamos tus datos</span>
      </div>

      <div class="cf-field">
        <div class="cf-field__row"><label class="cf-label" for="gcc-bruto">Sueldo bruto mensual</label><span class="cf-hint">Del recibo</span></div>
        <div class="gcc-money"><span class="gcc-money__sign">$</span><input class="cf-input cf-input--money" type="text" inputmode="numeric" id="gcc-bruto" value="3.500.000" /></div>
        <p class="cf-help">Remuneración bruta sujeta a aportes, antes de descuentos. La calculadora anualiza 13 sueldos (incluye el SAC).</p>
      </div>

      <div class="cf-grid2">
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="gcc-conyuge">¿Cónyuge a cargo?</label></div>
          <select class="cf-input" id="gcc-conyuge">
            <option value="no" selected>No</option>
            <option value="si">Sí</option>
          </select>
        </div>
        <div class="cf-field">
          <div class="cf-field__row"><label class="cf-label" for="gcc-hijos">Hijos a cargo</label></div>
          <input class="cf-input" type="number" id="gcc-hijos" value="0" min="0" max="10" step="1" />
        </div>
      </div>

      <div class="cf-field">
        <div class="cf-field__row"><label class="cf-label" for="gcc-otras">Otras deducciones anuales</label><span class="cf-hint">SiRADIG</span></div>
        <div class="gcc-money"><span class="gcc-money__sign">$</span><input class="cf-input cf-input--money" type="text" inputmode="numeric" id="gcc-otras" value="0" /></div>
        <p class="cf-help">Alquiler, cuota médica, intereses hipotecarios, donaciones y demás conceptos que cargás en el SiRADIG (F.572 web), en total anual.</p>
      </div>

      <button class="cf-primary" id="gcc-btn" type="button">Calcular resultado <span aria-hidden="true">→</span></button>

      <div class="cf-shortcuts">
        <span class="cf-shortcuts__lbl">Ejemplos:</span>
        <button class="cf-sc" type="button" data-ej="2500000">$2,5 M</button>
        <button class="cf-sc" type="button" data-ej="3000000">$3 M</button>
        <button class="cf-sc" type="button" data-ej="4500000">$4,5 M</button>
        <button class="cf-sc" type="button" data-ej="6000000">$6 M</button>
      </div>
    </div>

    <div class="cf-result" id="gcc-result">
      <p class="cf-result__eyebrow">Resultado estimado</p>
      <div class="cf-result__big" id="gcc-big">{fmt(init.impuestoMensual)}</div>
      <p class="cf-result__biglabel" id="gcc-biglabel">de retención por mes</p>
      <p class="cf-result__sub" id="gcc-sub">Tasa efectiva {pct(init.tasaEfectiva)} sobre tu ganancia anual · alícuota marginal {pct(initMarginal * 100, 0)}</p>
      <p class="cf-stale-hint">Apretá <strong>Calcular</strong> para actualizar el resultado.</p>
      <div class="cf-tiles cf-tiles--2">
        <div class="cf-tile"><div class="cf-tile__value" id="gcc-t-anual">{fmt(init.impuestoAnual)}</div><div class="cf-tile__label">Impuesto anual</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="gcc-t-efec">{pct(init.tasaEfectiva)}</div><div class="cf-tile__label">Tasa efectiva</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="gcc-t-gnsi">{fmt(init.gananciaNetaSujetaImpuesto)}</div><div class="cf-tile__label">Ganancia sujeta a impuesto</div></div>
        <div class="cf-tile"><div class="cf-tile__value" id="gcc-t-ded">{fmt(init.deduccionesTotal)}</div><div class="cf-tile__label">Deducciones anuales</div></div>
      </div>
      <div class="cf-result__formula" id="gcc-formula">escala({fmt(init.gananciaAnual)} − {fmt(init.deduccionesTotal)}) = {fmt(init.impuestoAnual)}/año</div>
      <div class="cf-result__actions cf-result__actions--2">
        <button class="cf-rbtn" type="button" id="gcc-copy"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copiar resultado</button>
        <button class="cf-rbtn" type="button" id="gcc-detail"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg> Ver desglose</button>
      </div>
    </div>
  </section>

  <div class="cf-quick">
    <span class="cf-quick__ico" aria-hidden="true">⚡</span>
    <p class="cf-quick__txt" id="gcc-quick"><strong>Respuesta rápida.</strong> Con un bruto de {fmt(INIT.sueldoBrutoMensual)} por mes, soltero y sin hijos, te retienen unos <strong>{fmt(init.impuestoMensual)} por mes</strong> ({fmt(init.impuestoAnual)} al año). Un empleado sin cargas de familia recién empieza a tributar arriba de {fmt(PISO_SOLTERO)} de bruto.</p>
    <span class="cf-formula">escala 5% – 35%</span>
  </div>

  <!-- DATOS CLAVE -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Datos clave</p>
        <h2 class="cf-section__title">Todo lo importante, de un vistazo</h2>
      </div>
      <p class="cf-section__lead">Valores de referencia del caso cargado y reglas principales para interpretar el resultado.</p>
    </div>
    <div class="cf-cards cf-cards--4">
      <div class="cf-minicard cf-minicard--dark">
        <span class="cf-minicard__ico" aria-hidden="true">🛡️</span>
        <p class="cf-minicard__sub gcc-mc-lbl">MNI + deducción especial</p>
        <div class="cf-minicard__big">{fmt(MNI_MENSUAL_BASE)}</div>
        <p class="cf-minicard__desc gcc-mc-desc">Por mes, para un empleado soltero. Combina la ganancia no imponible y la deducción especial del art. 30 inc. c) ap. 2.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">📏</span>
        <p class="cf-minicard__sub gcc-mc-lbl">Piso: soltero sin hijos</p>
        <div class="cf-minicard__big">{fmt(PISO_SOLTERO)}</div>
        <p class="cf-minicard__desc gcc-mc-desc">Bruto mensual a partir del cual empieza a tributar. Por debajo, el impuesto da $0.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">💍</span>
        <p class="cf-minicard__sub gcc-mc-lbl">Cónyuge a cargo</p>
        <div class="cf-minicard__big">{fmt(INCREMENTO_CONYUGE_MENSUAL)}</div>
        <p class="cf-minicard__desc gcc-mc-desc">Deducción mensual adicional. Hay que declararlo en el SiRADIG para que el empleador lo aplique.</p>
      </div>
      <div class="cf-minicard">
        <span class="cf-minicard__ico" aria-hidden="true">👶</span>
        <p class="cf-minicard__sub gcc-mc-lbl">Hijo a cargo</p>
        <div class="cf-minicard__big">{fmt(INCREMENTO_HIJO_MENSUAL)}</div>
        <p class="cf-minicard__desc gcc-mc-desc">Por hijo menor de 18 años (o incapacitado sin límite de edad), mientras no supere el tope de ingresos.</p>
      </div>
    </div>
  </section>

  <!-- CÓMO LEER EL RESULTADO -->
  <section class="cf-section">
    <p class="cf-eyebrow">Cómo leer el resultado</p>
    <h2 class="cf-section__title gcc-t2">De tu ganancia anual, esto se va en impuesto</h2>
    <div class="gcc-2col">
      <div class="cf-side-card cf-side-card--dark gcc-hl">
        <p class="cf-side-eyebrow">Cómo leer el resultado</p>
        <p class="gcc-hl__title">La tasa efectiva no es la de la escala</p>
        <p class="cf-side-desc">La escala del Art. 94 es progresiva: la alícuota más alta que te toca se aplica sólo al excedente de ese tramo, no a todo tu sueldo. Por eso lo que realmente pagás sobre el total es mucho menor.</p>
        <div class="gcc-hl__big" id="gcc-hl-big">{fmt(init.impuestoMensual)}</div>
        <p class="cf-side-desc">Retención mensual del caso cargado</p>
      </div>
      <div class="cf-breakdown">
        <div class="cf-breakdown__big" id="gcc-bd-big">{fmt(init.gananciaAnual)}</div>
        <p class="gcc-note gcc-note--top">Ganancia anual (13 sueldos, neta de aportes)</p>
        <div class="cf-brow">
          <span class="cf-brow__lbl">Deducciones anuales</span>
          <span class="cf-brow__val" id="gcc-bd-ded">− {fmt(init.deduccionesTotal)}</span>
          <span class="cf-brow__bar"><span id="gcc-bd-ded-bar" style={`width:${Math.min(100, barDed).toFixed(1)}%`}></span></span>
        </div>
        <div class="cf-brow gcc-brow--sp">
          <span class="cf-brow__lbl">Ganancia sujeta a impuesto</span>
          <span class="cf-brow__val" id="gcc-bd-gnsi">{fmt(init.gananciaNetaSujetaImpuesto)}</span>
          <span class="cf-brow__bar"><span class="gcc-bar--alt" id="gcc-bd-gnsi-bar" style={`width:${Math.min(100, barGnsi).toFixed(1)}%`}></span></span>
        </div>
        <div class="cf-brow gcc-brow--sp">
          <span class="cf-brow__lbl">Impuesto anual</span>
          <span class="cf-brow__val" id="gcc-bd-imp">{fmt(init.impuestoAnual)}</span>
          <span class="cf-brow__bar"><span class="gcc-bar--imp" id="gcc-bd-imp-bar" style={`width:${Math.min(100, barImp).toFixed(1)}%`}></span></span>
        </div>
        <div class="cf-breakdown__total">
          <span>Te queda en mano (antes de otros descuentos)</span>
          <strong id="gcc-bd-mano">{fmt(init.gananciaAnual - init.impuestoAnual)}</strong>
        </div>
        <div class="cf-callout cf-callout--warn gcc-cal">
          <span class="cf-callout__ico" aria-hidden="true">⚠️</span>
          <p>Si no cargás tus deducciones en el <strong>SiRADIG</strong>, el empleador retiene sin ellas y pagás de más. El F.572 web se puede completar y modificar durante todo el año.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PASO A PASO -->
  <section class="cf-section">
    <p class="cf-eyebrow">Paso a paso</p>
    <h2 class="cf-section__title gcc-t2">De tus datos al resultado</h2>
    <div class="cf-steps">
      <div class="cf-step">
        <div class="cf-step__num">1</div>
        <p class="cf-step__title">Ingresá tus datos</p>
        <p class="cf-step__desc">Tu sueldo bruto mensual y las cargas de familia que declarás. Restamos el 17% de aportes y anualizamos 13 sueldos.</p>
        <span class="gcc-chip" id="gcc-s1">bruto {fmt(INIT.sueldoBrutoMensual)} → anual {fmt(init.gananciaAnual)}</span>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">2</div>
        <p class="cf-step__title">Aplicamos la fórmula</p>
        <p class="cf-step__desc">Restamos las deducciones de ARCA y pasamos el excedente por la escala progresiva del Art. 94 (9 tramos, del 5% al 35%).</p>
        <span class="gcc-chip" id="gcc-s2">{fmt(init.gananciaNetaSujetaImpuesto)} → marginal {pct(initMarginal * 100, 0)}</span>
      </div>
      <div class="cf-step">
        <div class="cf-step__num">3</div>
        <p class="cf-step__title">Revisá el resultado</p>
        <p class="cf-step__desc">El impuesto anual dividido 12 es lo que te descuenta el empleador cada mes como retención de 4ta categoría.</p>
        <span class="gcc-chip" id="gcc-s3">{fmt(init.impuestoMensual)}/mes · {pct(init.tasaEfectiva)} efectivo</span>
      </div>
    </div>
  </section>

  <!-- REFERENCIAS -->
  <section class="cf-section">
    <div class="cf-section__head">
      <div>
        <p class="cf-eyebrow">Referencias</p>
        <h2 class="cf-section__title">Ejemplos para comparar</h2>
      </div>
      <p class="cf-section__lead">Usalos como orientación y ajustá los datos de la calculadora a tu situación.</p>
    </div>
    <div class="cf-tablewrap">
      <table class="cf-table">
        <thead><tr><th>Sueldo bruto mensual</th><th>Retención por mes</th><th>Impuesto anual</th><th>Tasa efectiva</th></tr></thead>
        <tbody>
          {refRows.map((r) => (
            <tr>
              <td>{fmt(r.bruto)}</td>
              <td>{r.mensual > 0 ? fmt(r.mensual) : '$0'}</td>
              <td>{r.anual > 0 ? fmt(r.anual) : '$0'}</td>
              <td class="cf-td-em">{r.anual > 0 ? pct(r.efectiva) : 'No tributa'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gcc-tnote">Escenarios calculados con la misma fórmula, para un empleado soltero sin hijos ni otras deducciones.</p>
  </section>
</div>

<!-- Banda: atención + referencia principal -->
<div class="cf-band cf-band--warm" data-domain="knowledge">
  <div class="cf-band__inner">
    <div class="gcc-2col">
      <div class="gcc-card">
        <p class="cf-eyebrow">Atención</p>
        <h2 class="gcc-card__title">Es una estimación, no tu liquidación final</h2>
        <p class="cf-side-desc">El empleador liquida mes a mes de forma acumulada: la retención real varía si cobrás aguinaldo, bonos, horas extra o si cambian tus deducciones a mitad de año. Esta calculadora prorratea el impuesto anual en 12 cuotas iguales.</p>
        <div class="cf-callout cf-callout--warn gcc-cal">
          <span class="cf-callout__ico" aria-hidden="true">📋</span>
          <p>Los montos de deducciones y la escala los actualiza <strong>ARCA por semestre</strong> según el IPC del INDEC. Los de esta página son los del primer semestre de 2026.</p>
        </div>
      </div>
      <div class="cf-side-card cf-side-card--dark">
        <p class="cf-side-eyebrow">Referencia principal</p>
        <p class="gcc-src__title">Piso para empezar a tributar</p>
        <div class="gcc-ref__big">{fmt(PISO_SOLTERO)}</div>
        <p class="cf-side-desc">Bruto mensual · empleado soltero sin hijos ni otras deducciones</p>
        <div class="gcc-chips">
          <span class="gcc-chip2">MNI + especial {fmt(MNI_MENSUAL_BASE)}/mes</span>
          <span class="gcc-chip2">Cónyuge +{fmt(INCREMENTO_CONYUGE_MENSUAL)}</span>
          <span class="gcc-chip2">Hijo +{fmt(INCREMENTO_HIJO_MENSUAL)}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="cf-page gcc" data-domain="knowledge">
  {faq.length > 0 && (
    <section class="cf-section" id="como-funciona">
      <p class="cf-eyebrow">Preguntas frecuentes</p>
      <h2 class="cf-section__title gcc-t2">Lo que más se consulta</h2>
      <div class="cf-faq">
        {faq.map((f: any, i: number) => (
          <details class="cf-faq__item" open={i === 0}>
            <summary class="cf-faq__q"><span>{f.q}</span><svg class="cf-faq__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="cf-faq__a" set:html={md(f.a)} />
          </details>
        ))}
      </div>
    </section>
  )}
</div>

<!-- Banda: fuentes y metodología -->
<div class="cf-band" data-domain="knowledge">
  <div class="cf-band__inner">
    <div class="gcc-2col">
      <div class="gcc-card">
        <p class="cf-eyebrow">Fuentes y metodología</p>
        <h2 class="gcc-card__title">Números que podés defender</h2>
        <p class="cf-side-desc">La fórmula y los parámetros se contrastan con fuentes oficiales y se revisan durante 2026. El mínimo no imponible, las cargas de familia y los nueve tramos de la escala salen de las tablas que publica ARCA y se actualizan cada semestre por IPC del INDEC.</p>
      </div>
      <div class="cf-side-card cf-side-card--dark">
        <p class="cf-side-eyebrow">Fuentes oficiales</p>
