              {typeof s !== 'string' && String(s.name || '').includes('—') && <span>{String(s.name).split('—').slice(1).join('—').trim()}</span>}
            </div>
          ))}
        </div>
        <p class="gcc-src__foot">● Información revisada en julio de 2026</p>
      </div>
    </div>
  </div>
</div>

