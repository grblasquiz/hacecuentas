<script is:inline>
  (function () {
    const root = document.querySelector('.gcc');
    if (!root) return;
    const MNI = Number(root.getAttribute('data-mni'));
    const D_CONY = Number(root.getAttribute('data-conyuge'));
    const D_HIJO = Number(root.getAttribute('data-hijo'));
    const TOPE = Number(root.getAttribute('data-tope'));
    const ESCALA = JSON.parse(root.getAttribute('data-escala')).map(function (t) {
      return { hasta: t.h === null ? Infinity : t.h, tasa: t.t, acumulado: t.a };
    });
    const $ = function (id) { return document.getElementById(id); };
    const fmt = function (n) { return '$' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(Math.round(n)); };
    const pct = function (n, dec) {
      if (dec === undefined) dec = 2;
      return n.toLocaleString('es-AR', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + '%';
    };

    // Réplica exacta de aplicarEscalaMensual() de _ganancias-escala.ts
    function escalaMensual(base) {
      if (base <= 0) return { impuesto: 0, marginal: 0 };
      let anterior = 0;
      for (let i = 0; i < ESCALA.length; i++) {
        const tr = ESCALA[i];
        if (base <= tr.hasta) return { impuesto: tr.acumulado + (base - anterior) * tr.tasa, marginal: tr.tasa };
        anterior = tr.hasta;
      }
      const u = ESCALA[ESCALA.length - 1];
      return { impuesto: u.acumulado + (base - anterior) * u.tasa, marginal: u.tasa };
    }

    // Réplica exacta de gananciasCuartaCategoria2026()
    function calcular(bruto, conyuge, hijos, otras) {
      const aportes = Math.min(bruto, TOPE) * 0.17;
      const netoSS = bruto - aportes;
      const gananciaAnual = netoSS * 13;
      const dedFam = (conyuge ? D_CONY : 0) + hijos * D_HIJO;
      const deduccionesTotal = (MNI + dedFam) * 12 + otras;
      const gnsi = Math.max(0, gananciaAnual - deduccionesTotal);
      const esc = escalaMensual(gnsi / 12);
      const impuestoAnual = esc.impuesto * 12;
      const impuestoMensual = impuestoAnual / 12;
      const tasaEfectiva = gananciaAnual > 0 ? (impuestoAnual / gananciaAnual) * 100 : 0;
      return {
        aportes: aportes, netoSS: netoSS, gananciaAnual: gananciaAnual, deduccionesTotal: deduccionesTotal,
        gnsi: gnsi, impuestoAnual: impuestoAnual, impuestoMensual: impuestoMensual,
        tasaEfectiva: Number(tasaEfectiva.toFixed(2)), marginal: esc.marginal,
      };
    }

    const brutoEl = $('gcc-bruto'), conyEl = $('gcc-conyuge'), hijosEl = $('gcc-hijos'), otrasEl = $('gcc-otras');
    function digits(v) { return Number(String(v || '').replace(/\D/g, '')) || 0; }
    function fmtThousands(v) { const n = String(v).replace(/\D/g, ''); return n ? Number(n).toLocaleString('es-AR') : ''; }
    function inputs() {
      return { bruto: digits(brutoEl.value), conyuge: conyEl.value === 'si', hijos: Math.max(0, Number(hijosEl.value) || 0), otras: digits(otrasEl.value) };
    }

    function render() {
      const i = inputs();
      const r = calcular(i.bruto, i.conyuge, i.hijos, i.otras);
      const paga = r.impuestoAnual > 0;
      $('gcc-big').textContent = fmt(r.impuestoMensual);
      $('gcc-biglabel').textContent = paga ? 'de retención por mes' : 'no tributás Ganancias';
      $('gcc-sub').textContent = paga
        ? 'Tasa efectiva ' + pct(r.tasaEfectiva) + ' sobre tu ganancia anual · alícuota marginal ' + pct(r.marginal * 100, 0)
        : 'Tus deducciones (' + fmt(r.deduccionesTotal) + ') superan tu ganancia anual (' + fmt(r.gananciaAnual) + ').';
      $('gcc-t-anual').textContent = fmt(r.impuestoAnual);
      $('gcc-t-efec').textContent = pct(r.tasaEfectiva);
      $('gcc-t-gnsi').textContent = fmt(r.gnsi);
      $('gcc-t-ded').textContent = fmt(r.deduccionesTotal);
      $('gcc-formula').textContent = 'escala(' + fmt(r.gananciaAnual) + ' − ' + fmt(r.deduccionesTotal) + ') = ' + fmt(r.impuestoAnual) + '/año';

      const dv = $('gcc-deco-val'); if (dv) dv.textContent = fmt(r.impuestoMensual);
      const dp = $('gcc-deco-pct'); if (dp) dp.textContent = pct(r.tasaEfectiva);

      $('gcc-hl-big').textContent = fmt(r.impuestoMensual);
      $('gcc-bd-big').textContent = fmt(r.gananciaAnual);
      $('gcc-bd-ded').textContent = '− ' + fmt(r.deduccionesTotal);
      $('gcc-bd-gnsi').textContent = fmt(r.gnsi);
      $('gcc-bd-imp').textContent = fmt(r.impuestoAnual);
      $('gcc-bd-mano').textContent = fmt(Math.max(0, r.gananciaAnual - r.impuestoAnual));
      const ga = r.gananciaAnual > 0 ? r.gananciaAnual : 1;
      $('gcc-bd-ded-bar').style.width = Math.min(100, (r.deduccionesTotal / ga) * 100).toFixed(1) + '%';
      $('gcc-bd-gnsi-bar').style.width = Math.min(100, (r.gnsi / ga) * 100).toFixed(1) + '%';
      $('gcc-bd-imp-bar').style.width = Math.min(100, (r.impuestoAnual / ga) * 100).toFixed(1) + '%';

      $('gcc-s1').textContent = 'bruto ' + fmt(i.bruto) + ' → anual ' + fmt(r.gananciaAnual);
      $('gcc-s2').textContent = fmt(r.gnsi) + ' → marginal ' + pct(r.marginal * 100, 0);
      $('gcc-s3').textContent = fmt(r.impuestoMensual) + '/mes · ' + pct(r.tasaEfectiva) + ' efectivo';
      if (resultEl) resultEl.removeAttribute('data-stale');
    }

    const resultEl = $('gcc-result');
    function stale() { if (resultEl) resultEl.setAttribute('data-stale', '1'); }
    function onEnter(e) { if (e.key === 'Enter') { e.preventDefault(); render(); } }

    brutoEl.addEventListener('input', function () { brutoEl.value = fmtThousands(brutoEl.value); stale(); });
    otrasEl.addEventListener('input', function () { otrasEl.value = fmtThousands(otrasEl.value); stale(); });
    conyEl.addEventListener('change', stale);
    hijosEl.addEventListener('input', stale);
    [brutoEl, otrasEl, hijosEl].forEach(function (el) { el.addEventListener('keydown', onEnter); });
    $('gcc-btn').addEventListener('click', render);
    document.querySelectorAll('[data-ej]').forEach(function (b) {
      b.addEventListener('click', function () { brutoEl.value = fmtThousands(b.getAttribute('data-ej')); stale(); });
    });

    function summary() {
      const i = inputs();
      const r = calcular(i.bruto, i.conyuge, i.hijos, i.otras);
      if (r.impuestoAnual <= 0) return 'Con un sueldo bruto de ' + fmt(i.bruto) + '/mes no tributás Ganancias: tus deducciones (' + fmt(r.deduccionesTotal) + ') superan tu ganancia anual (' + fmt(r.gananciaAnual) + '). — hacecuentas.com';
      return 'Ganancias 4ta categoría 2026: con un bruto de ' + fmt(i.bruto) + '/mes te retienen ' + fmt(r.impuestoMensual) + ' por mes (' + fmt(r.impuestoAnual) + ' al año), una tasa efectiva del ' + pct(r.tasaEfectiva) + '. — hacecuentas.com';
    }
    function shareUrl() {
      const i = inputs();
      return location.origin + location.pathname + '?bruto=' + i.bruto + '&conyuge=' + (i.conyuge ? 'si' : 'no') + '&hijos=' + i.hijos + '&otras=' + i.otras;
    }
    function copy(t, btn) {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(t).then(function () {
        const o = btn.innerHTML; btn.innerHTML = '✓ Copiado'; setTimeout(function () { btn.innerHTML = o; }, 1500);
      });
    }
    $('gcc-copy').addEventListener('click', function (e) { copy(summary(), e.currentTarget); });
    $('gcc-detail').addEventListener('click', function () {
      const t = document.getElementById('como-funciona'); if (t) t.scrollIntoView({ behavior: 'smooth' });
    });
    const s2 = $('gcc-share2'); if (s2) s2.addEventListener('click', function (e) { copy(shareUrl(), e.currentTarget); });

    const q = new URLSearchParams(location.search);
    if (q.get('bruto')) brutoEl.value = fmtThousands(q.get('bruto'));
    if (q.get('conyuge')) conyEl.value = q.get('conyuge') === 'si' ? 'si' : 'no';
    if (q.get('hijos')) hijosEl.value = String(Math.max(0, Number(q.get('hijos')) || 0));
    if (q.get('otras')) otrasEl.value = fmtThousands(q.get('otras'));
    render();
  })();
</script>

