---
/**
 * IclCompositionBar — capa de fidelidad al mockup para la calc de actualización
 * de alquiler por ICL (BCRA). Script-only, sin UI propia (patrón ImcUnitsHook /
 * IpcCompositionBar). Único en esta calc (gateado por slug en CalcLayoutV2). NO
 * toca el widget compartido ni la fórmula: sólo reordena/reestiliza nodos YA
 * renderizados por Calculator.astro.
 *
 * Hace cuatro cosas, todas manteniendo los nodos DENTRO de `.calc-container` para
 * que los listeners que el motor bindea con `container.querySelectorAll('.btn-share')`
 * sigan válidos sin importar el orden de init:
 *
 *  1) COMPOSICIÓN: reemplaza el donut (`_chart` doughnut → `.v2-donut`) por la
 *     BARRA APILADA horizontal del mockup ("Alquiler actual · 75% / Aumento ICL ·
 *     25%"), leyendo los valores finales de la leyenda del donut. El donut queda
 *     oculto por CSS.
 *  2) ACCIONES: mueve la barra `.share` a un pie full-width bajo el form/resultado
 *     y la aplana a los 5 botones del mockup (Guardar resultado · Guardar cálculo ·
 *     Compartir · PNG · Descargar CSV); el resto queda oculto. Se revela sólo con
 *     resultado.
 *  3) HISTORIAL: agrega el trigger "Tus últimos cálculos" en el header y abre el
 *     panel de historial (`.calc-history`) como dropdown.
 *  4) ORDEN: mueve el botón "Modificar datos" (`.back-to-input`) para que quede
 *     DEBAJO de la barra de composición (en el mockup es lo último del resultado).
 */
---

<script is:inline>
  (function () {
    var SLUG = "calculadora-actualizacion-alquiler-icl";

    function cont() {
      return document.querySelector('.calc-container[data-slug="' + SLUG + '"]');
    }

    // ── 1) Barra de composición (reemplaza el donut) ──────────────────────────
    function readNum(s) {
      var n = Number(String(s || "").replace(/[^\d]/g, ""));
      return isFinite(n) ? n : 0;
    }
    function buildComp(wrap, mo) {
      var rows = wrap.querySelectorAll(".v2-donut-legend .v2-donut-lg");
      if (rows.length < 2) return;
      var data = Array.prototype.map.call(rows, function (r) {
        var nmEl = r.querySelector(".nm"),
          vlEl = r.querySelector(".vl"),
          swEl = r.querySelector(".sw");
        var vl = vlEl ? vlEl.textContent : "";
        var valTxt = (vl.split("·")[0] || "").trim();
        return {
          nm: nmEl ? nmEl.textContent : "",
          valTxt: valTxt,
          num: readNum(valTxt),
          color: swEl ? swEl.style.background : "",
        };
      });
      var total = data.reduce(function (a, d) {
        return a + d.num;
      }, 0);
      if (total <= 0) return;
      var segs = data
        .map(function (d) {
          return (
            '<span class="icl-comp-seg" style="width:' +
            ((d.num / total) * 100).toFixed(3) +
            "%;background:" +
            d.color +
            '"></span>'
          );
        })
        .join("");
      var items = data
        .map(function (d, i) {
          var p = Math.round((d.num / total) * 100);
          return (
            '<div class="icl-comp-item' +
            (i === data.length - 1 ? " icl-comp-item--right" : "") +
            '"><span class="icl-comp-nm"><span class="icl-comp-dot" style="background:' +
            d.color +
            '"></span>' +
            d.nm +
            '</span><span class="icl-comp-vl">' +
            d.valTxt +
            " · " +
            p +
            "%</span></div>"
          );
        })
        .join("");
      var host = wrap.querySelector(".icl-comp");
      if (!host) {
        host = document.createElement("div");
        host.className = "icl-comp";
        host.setAttribute("role", "img");
        wrap.appendChild(host);
      }
      host.setAttribute(
        "aria-label",
        "Composición del nuevo alquiler: " +
          data
            .map(function (d) {
              return d.nm + " " + Math.round((d.num / total) * 100) + "%";
            })
            .join(", ")
      );
      if (mo) mo.disconnect();
      host.innerHTML =
        '<div class="icl-comp-bar">' +
        segs +
        '</div><div class="icl-comp-legend">' +
        items +
        "</div>";
      if (mo) mo.observe(wrap, { childList: true, subtree: true });
    }
    function initComp(c) {
      var wrap = c.querySelector("[data-chart-wrap]");
      if (!wrap) return;
      var mo = new MutationObserver(function () {
        buildComp(wrap, mo);
      });
      mo.observe(wrap, { childList: true, subtree: true });
      buildComp(wrap, mo);
    }

    // ── 2) Fila de acciones: mover `.share` abajo + aplanar a 5 botones ────────
    function initActions(c) {
      var share = c.querySelector(".share");
      if (!share || share.classList.contains("icl-actions")) return;
      var shareWrap = share.querySelector(".share-compartir");
      var imgBtn = share.querySelector('[data-action="share-image"]');
      var csvBtn = share.querySelector('[data-action="download-csv"]');
      // Re-etiquetar para que coincida con el mockup: "Imagen" → "PNG", "CSV" →
      // "Descargar CSV". Sólo tocamos el nodo de texto (conservamos el ícono SVG).
      function relabel(btn, txt) {
        if (!btn) return;
        Array.prototype.slice.call(btn.childNodes).forEach(function (n) {
          if (n.nodeType === 3) n.parentNode.removeChild(n);
        });
        btn.appendChild(document.createTextNode(txt));
      }
      relabel(imgBtn, "PNG");
      relabel(csvBtn, "Descargar CSV");
      // Subir PNG y CSV del dropdown a la fila principal, después de "Compartir".
      if (shareWrap && imgBtn) shareWrap.insertAdjacentElement("afterend", imgBtn);
      if (imgBtn && csvBtn) imgBtn.insertAdjacentElement("afterend", csvBtn);
      else if (shareWrap && csvBtn) shareWrap.insertAdjacentElement("afterend", csvBtn);
      // Mover la barra a pie full-width (hijo directo del container → grid 1/-1),
      // manteniéndola DENTRO del container (listeners siguen válidos).
      c.appendChild(share);
      share.classList.add("icl-actions");
      // Revelar sólo cuando hay resultado (antes se ocultaba por vivir dentro de
      // .calc-results[hidden]; ahora la sincronizamos a mano).
      var results = c.querySelector(".calc-results");
      if (results) {
        var sync = function () {
          share.hidden = results.hasAttribute("hidden");
        };
        new MutationObserver(sync).observe(results, {
          attributes: true,
          attributeFilter: ["hidden"],
        });
        sync();
      }
    }

    // ── 3) "Tus últimos cálculos" en el header (dropdown del historial) ────────
    function initHistory(c) {
      var header = c.querySelector(".calc-card-header");
      var hist = c.querySelector("[data-history-widget]");
      if (!header || !hist || header.querySelector(".icl-history-trigger")) return;
      var trg = document.createElement("button");
      trg.type = "button";
      trg.className = "icl-history-trigger";
      trg.setAttribute("aria-expanded", "false");
      trg.innerHTML =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg><span>Tus últimos cálculos</span>';
      header.appendChild(trg);
      // Placeholder para cuando todavía no hay cálculos guardados.
      var list = hist.querySelector("[data-history-list]");
      if (list && !hist.querySelector(".icl-history-empty")) {
        var empty = document.createElement("div");
        empty.className = "icl-history-empty";
        empty.textContent =
          "Todavía no guardaste cálculos. Tocá “Guardar cálculo” en un resultado para verlos acá.";
        list.insertAdjacentElement("afterend", empty);
      }
      hist.classList.add("icl-history-panel");
      var open = false;
      function set(o) {
        open = o;
        hist.classList.toggle("icl-open", open);
        trg.setAttribute("aria-expanded", open ? "true" : "false");
      }
      trg.addEventListener("click", function (e) {
        e.stopPropagation();
        set(!open);
      });
      document.addEventListener("click", function (e) {
        if (open && !hist.contains(e.target) && e.target !== trg && !trg.contains(e.target))
          set(false);
      });
    }

    // ── 4) Orden: "Modificar datos" debajo de la composición ───────────────────
    function initOrder(c) {
      var back = c.querySelector(".back-to-input");
      var wrap = c.querySelector("[data-chart-wrap]");
      if (back && wrap && wrap.compareDocumentPosition(back) & Node.DOCUMENT_POSITION_PRECEDING) {
        wrap.insertAdjacentElement("afterend", back);
      }
    }

    function boot() {
      var c = cont();
      if (!c) return;
      initComp(c);
      initActions(c);
      initHistory(c);
      initOrder(c);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot, { once: true });
    } else {
      boot();
    }
  })();
</script>
