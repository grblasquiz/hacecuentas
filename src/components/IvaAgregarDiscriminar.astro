  .cf-band .ivd-src { display: grid; gap: 0.5rem; }
  .cf-band .ivd-src__item { padding: 0.7rem 0.85rem; border-radius: var(--radius); background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); }
  .cf-band .ivd-src__item strong { display: block; font-size: 0.82rem; font-weight: 700; color: #fff; }
