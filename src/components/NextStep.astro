---
/**
 * NextStep — "Tu próximo paso" (propuesta #1).
 *
 * Muestra 2-3 calcs que son el siguiente paso lógico del recorrido (no calcs
 * "parecidas": el journey real, vía src/lib/journeys.ts). Se revela DESPUÉS de
 * que el usuario aprieta Calcular (evento `hc-calc-result`), en el momento
 * caliente, para subir páginas/sesión.
 *
 * Excluido en categorías YMYL (salud, finanzas) — ver NEXT_STEP_EXCLUDED.
 * El wiring (qué calcs, exclusión por categoría) vive en [...slug].astro.
 */
export interface NextStepItem {
  slug: string;
  h1: string;
  icon?: string;
  description?: string;
}
interface Props {
  steps: NextStepItem[];
  title?: string;
}
const { steps, title = 'Tu próximo paso' } = Astro.props;
---

{steps.length > 0 && (
  <section class="next-step" data-next-step hidden aria-labelledby="next-step-h">
    <header class="next-step-head">
      <span class="next-step-ico" aria-hidden="true">🧭</span>
      <div>
        <strong id="next-step-h">{title}</strong>
        <p>Ya tenés tu resultado. Estos cálculos suelen ser el siguiente paso:</p>
      </div>
    </header>
    <div class="next-step-grid">
      {steps.map((s) => (
        <a href={`/${s.slug}`} class="next-step-card">
          <span class="next-step-card-ico" aria-hidden="true">{s.icon || '🧮'}</span>
          <span class="next-step-card-title">{s.h1}</span>
          {s.description && <span class="next-step-card-desc">{s.description.slice(0, 70)}</span>}
          <span class="next-step-card-cta">Calcular →</span>
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var host = document.querySelector('[data-next-step]');
      if (!host) return;
      var containers = document.querySelectorAll('.calc-container');
      if (containers.length === 0) return;
      function reveal() { host.hidden = false; }
      containers.forEach(function (container) {
        container.addEventListener('hc-calc-result', function (ev) {
          var detail = ev && ev.detail ? ev.detail : null;
          if (!detail || !detail.output) return;
          reveal();
        });
      });
    })();
  </script>
)}

<style>
  .next-step {
    margin: 1rem 0 0;
    padding: 1rem 1.125rem 1.125rem;
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
  }
  .next-step[hidden] { display: none; }
  .next-step-head {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 0.875rem;
  }
  .next-step-ico { font-size: 1.5rem; line-height: 1; }
  .next-step-head strong { display: block; font-size: 1.05rem; }
  .next-step-head p { margin: 0.15rem 0 0; font-size: 0.875rem; color: var(--text-2, #555); }
  .next-step-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.625rem;
  }
  .next-step-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    background: var(--bg-card, #fff);
    border: 1px solid var(--border, #e5e5e5);
    border-radius: var(--radius-sm, 8px);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .next-step-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .next-step-card-ico { font-size: 1.25rem; line-height: 1; }
  .next-step-card-title { font-weight: 600; font-size: 0.9rem; line-height: 1.25; }
  .next-step-card-desc { font-size: 0.8rem; color: var(--text-2, #666); line-height: 1.3; }
  .next-step-card-cta { margin-top: auto; font-size: 0.8rem; font-weight: 600; color: var(--accent); }
</style>
