---
interface Props { data:any }
const { data } = Astro.props;
---
<div class="age-experience">
<section class="hero"><div class="wrap crumb"><b>Fechas</b> &nbsp;/&nbsp; Edad exacta</div><div class="wrap hero-grid"><div class="copy"><span class="eyebrow">Calculadora de edad exacta</span><h1>Tu edad es más<br>que los años que<br>cumpliste.</h1><p>Descubrí cuántos años, meses y días viviste, cuándo es tu próximo cumpleaños y todo tu tiempo en números.</p><div class="chips"><span>📅 Años bisiestos</span><span>🔒 Cálculo privado</span><span>✓ Fecha de hoy</span></div><div class="age-art"><div class="birthday"><div class="birthday-head"><b>Naciste un domingo</b><span>15 mar. 1992</span></div><small>TU EDAD EXACTA HOY</small><strong>34 años · 4 meses</strong><p>y 13 días desde tu último mes cumplido</p></div><div class="cake"></div><span class="days-tag">12.553 días vividos</span></div></div>
    <form class="calc"><div class="calc-title"><div><h2>Calculá tu edad</h2><p>Empezamos con tu edad al día de hoy.</p></div><span class="tag">Calendario exacto</span></div><div class="section-label">¿Qué querés calcular?</div><div class="cases"><button type="button" class="case active" data-case="today"><i>🎂</i>Mi edad hoy</button><button type="button" class="case" data-case="date"><i>📅</i>Edad en una fecha</button><button type="button" class="case" data-case="people"><i>👥</i>Entre dos personas</button><button type="button" class="case" data-case="birthday"><i>🎉</i>Próximo cumpleaños</button></div><div class="section-label">Tus fechas</div><div class="fields"><div class="field wide"><label>Fecha de nacimiento</label><input id="birth-date" type="date" value="1992-03-15"></div><div class="field"><label id="until-label">Calcular hasta</label><input id="until-date" type="date" value="2026-07-28"></div><div class="field optional"><label>Hora de nacimiento · opcional</label><input type="time" value="08:00"></div></div><div class="advanced"><span>✓ Nada se guarda ni se envía</span><b id="use-today">Usar la fecha de hoy</b></div><section class="result"><div class="result-top"><div><small id="result-label">Tu edad exacta</small><div class="age" id="result-age">34 años · 4 meses · 13 días</div></div><div class="countdown"><small>Próximo cumpleaños</small><strong id="result-countdown">en 230 días</strong></div></div><div class="stats"><span>Días vividos<b id="total-days">12.553</b></span><span>Semanas completas<b id="total-weeks">1.793</b></span><span>Día en que naciste<b id="birth-weekday">Domingo</b></span></div><button class="go" type="button">Actualizar edad</button></section></form>
  </div></section>
  <section class="units wrap"><header class="center"><span>La misma vida, otras unidades</span><h2>Tu tiempo en números</h2><p>Cada cifra expresa el mismo período de una manera distinta, sin aproximar los años de calendario.</p></header><div class="unit-grid"><article class="unit"><i>🗓️</i><b>34</b><span>años</span></article><article class="unit"><i>📆</i><b>412</b><span>meses</span></article><article class="unit"><i>▦</i><b>1.793</b><span>semanas</span></article><article class="unit"><i>☀️</i><b>12.553</b><span>días</span></article><article class="unit"><i>🕐</i><b>301.272</b><span>horas</span></article><article class="unit"><i>⏱️</i><b>18,1 M</b><span>minutos</span></article></div><div class="progress-card"><div><h3>Tu año número 35</h3><p>Desde tu último cumpleaños hasta el próximo.</p></div><div class="track"><i></i></div><strong>37% recorrido</strong></div></section>
  <section class="timeline-section"><div class="wrap"><div class="timeline-head"><div><span>Tu línea de tiempo</span><h2>Fechas que marcaron tu edad</h2></div><div class="legend">Calculadas desde tu nacimiento</div></div><div class="timeline"><div class="event"><div class="dot">👶</div><h3>Nacimiento</h3><p>15 mar. 1992</p></div><div class="event"><div class="dot">🎒</div><h3>6 años</h3><p>15 mar. 1998</p></div><div class="event"><div class="dot">🪪</div><h3>18 años</h3><p>15 mar. 2010</p></div><div class="event active"><div class="dot">34</div><h3>Edad actual</h3><p>28 jul. 2026</p></div><div class="event"><div class="dot">🎂</div><h3>35 años</h3><p>15 mar. 2027</p><b>Próximo hito</b></div></div></div></section>
  <section class="birthday-section"><div class="wrap birthday-grid"><div class="birthday-copy"><span>La cuenta regresiva</span><h2>Tu próximo cumpleaños ya tiene fecha.</h2><p>Además de los días que faltan, podés ver cuántos meses y semanas completas quedan hasta volver a cumplir.</p></div><div class="count-card"><div class="count-top"><div><b>230</b><span>días</span></div><div><b>32</b><span>semanas</span></div><div><b>7</b><span>meses y 15 días</span></div></div><div class="birthday-date"><span>Tu cumpleaños número 35</span><b>Lunes 15 de marzo de 2027</b></div></div></div></section>
  <section class="cases-section"><div class="wrap"><header class="center"><span style="color:#9bc9ff">Más formas de medir el tiempo</span><h2 style="color:#fff">Cuatro cálculos con las mismas fechas</h2><p style="color:#bdccda">Cambiá de caso sin volver a cargar tu fecha de nacimiento.</p></header><div class="case-grid"><article class="use"><i>🎂</i><h3>Edad al día de hoy</h3><p>Años, meses y días exactos desde tu nacimiento.</p><b>34 años · 4 meses · 13 días</b></article><article class="use"><i>📅</i><h3>Edad en otra fecha</h3><p>Para trámites, viajes o saber cuántos años tenías en un evento.</p><b>Elegí cualquier día</b></article><article class="use"><i>👥</i><h3>Diferencia entre personas</h3><p>Compará dos fechas de nacimiento sin hacer cuentas manuales.</p><b>Años, meses y días</b></article><article class="use"><i>🎉</i><h3>Próximo cumpleaños</h3><p>Cuenta regresiva y día de la semana en que cae.</p><b>Faltan 230 días</b></article></div></div></section><div class="foot"></div>
  <section class="support wrap"><div><h2>Preguntas frecuentes</h2>{data.faq.map((f:any,i:number)=><details open={i===0}><summary>{f.q}</summary><p set:html={f.a}/></details>)}</div><aside><h2>Fuentes</h2>{data.sources.map((s:any)=><a href={s.url} target="_blank" rel="nofollow noopener">{s.name}<small>{s.publisher}</small></a>)}</aside></section>
</div>
<script is:inline>
const birthInput=document.querySelector("#birth-date"),untilInput=document.querySelector("#until-date"),daysEl=document.querySelector("#total-days"),weeksEl=document.querySelector("#total-weeks"),weekdayEl=document.querySelector("#birth-weekday");let activeCase="today";
    const dayNames=["Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"],fmt=n=>n.toLocaleString("es-AR");
    function readDate(value){const [y,m,d]=value.split("-").map(Number);return new Date(y,m-1,d)}
    function validDates(){const birth=readDate(birthInput.value),until=readDate(untilInput.value);return birth<=until?{birth,until}:null}
    function calendarAge(birth,until){let years=until.getFullYear()-birth.getFullYear(),months=until.getMonth()-birth.getMonth(),days=until.getDate()-birth.getDate();if(days<0){const previousMonthDays=new Date(until.getFullYear(),until.getMonth(),0).getDate();days+=previousMonthDays;months--}if(months<0){months+=12;years--}return{years,months,days}}
    function nextBirthday(birth,until){let year=until.getFullYear(),day=Math.min(birth.getDate(),new Date(year,birth.getMonth()+1,0).getDate()),next=new Date(year,birth.getMonth(),day);if(next<until){year++;day=Math.min(birth.getDate(),new Date(year,birth.getMonth()+1,0).getDate());next=new Date(year,birth.getMonth(),day)}return next}
    function calculate(){const dates=validDates();if(!dates){document.querySelector("#result-label").textContent="Revisá las fechas";document.querySelector("#result-age").textContent="La fecha final debe ser posterior";return}const{birth,until}=dates,age=calendarAge(birth,until),totalDays=Math.floor((until-birth)/86400000),next=nextBirthday(birth,until),daysToNext=Math.ceil((next-until)/86400000);document.querySelector("#result-label").textContent=activeCase==="people"?"Diferencia exacta":activeCase==="date"?"Tu edad en esa fecha":activeCase==="birthday"?"Edad en tu próximo cumpleaños":"Tu edad exacta";document.querySelector("#result-age").textContent=activeCase==="birthday"?`${age.years+1} años`:`${age.years} años · ${age.months} meses · ${age.days} días`;document.querySelector("#result-countdown").textContent=daysToNext===0?"es hoy":`en ${fmt(daysToNext)} días`;daysEl.textContent=fmt(totalDays);weeksEl.textContent=fmt(Math.floor(totalDays/7));weekdayEl.textContent=dayNames[birth.getDay()]}
    document.querySelectorAll(".case").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll(".case").forEach(x=>x.classList.remove("active"));b.classList.add("active");activeCase=b.dataset.case;document.querySelector("#until-label").textContent=activeCase==="people"?"Fecha de la otra persona":"Calcular hasta";calculate()}));
    document.querySelector("#use-today").addEventListener("click",()=>{const today=new Date(),pad=n=>String(n).padStart(2,"0");untilInput.value=`${today.getFullYear()}-${pad(today.getMonth()+1)}-${pad(today.getDate())}`;calculate()});
    document.querySelector(".go").addEventListener("click",e=>{calculate();e.currentTarget.textContent="✓ Edad actualizada";setTimeout(()=>e.currentTarget.textContent="Actualizar edad",1200)});
</script>
<style>
