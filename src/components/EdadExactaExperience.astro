    .age-art{height:240px;margin-top:15px;position:relative}.birthday{position:absolute;left:54px;top:18px;width:240px;height:181px;background:#fff;border:1px solid #d7e3eb;border-radius:17px;box-shadow:0 24px 48px #17385816;padding:21px 23px;transform:rotate(-2deg)}.birthday-head{display:flex;justify-content:space-between;align-items:center}.birthday-head b{font-size:11px}.birthday-head span{font-size:8px;color:#397dd0;background:#e9f3ff;padding:5px 8px;border-radius:99px}.birthday small{display:block;color:#76879a;font-size:8px;margin-top:18px}.birthday strong{display:block;font-size:28px;margin-top:3px}.birthday p{font-size:9px;color:#6f8195;margin:12px 0 0;border-top:1px solid #e2e9ef;padding-top:10px}.cake{position:absolute;right:21px;bottom:10px;width:93px;height:67px;background:#ef8d78;border:6px solid #fff;border-radius:10px 10px 16px 16px;box-shadow:0 10px 24px #7f3d2b22}.cake:before{content:"";position:absolute;left:10px;right:10px;top:-17px;height:21px;background:#ffd166;border-radius:8px 8px 3px 3px}.cake:after{content:"🎂";position:absolute;inset:-33px 0 0;display:grid;place-items:center;font-size:34px}.days-tag{position:absolute;left:3px;bottom:14px;background:#eaf4ff;color:#326da9;border:1px solid #cee0f2;border-radius:9px;padding:9px 11px;font-size:10px;font-weight:800}
    .calc{background:#fff;border:1px solid #d8e3eb;border-radius:20px;padding:26px 29px;box-shadow:0 25px 60px #173b6418;position:relative;z-index:2}.calc-title{display:flex;justify-content:space-between;gap:20px}.calc h2{font-size:23px;margin:0 0 4px}.calc-title p{font-size:10px;color:#6b7d91;margin:0}.tag{font-size:9px;color:#397dd0;background:#eaf4ff;border-radius:99px;padding:7px 10px;font-weight:800;height:max-content;white-space:nowrap}.section-label{font-size:10px;font-weight:850;color:#293b53;margin:17px 0 8px}.cases{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.case{border:1px solid #dce5ed;background:#fff;border-radius:10px;padding:9px 4px;color:#5d7188;font-size:8px;font-weight:750;min-height:65px;cursor:pointer}.case i{display:block;font-style:normal;font-size:17px;margin-bottom:3px}.case.active{border:2px solid #397dd0;background:#eff6ff;color:#286cbf}.fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.field{border:1px solid #dbe4eb;border-radius:10px;padding:9px 11px;min-height:57px}.field.wide{grid-column:span 2}.field.optional{background:#fafbfc}.field label{display:block;color:#77879a;font-size:8px;margin-bottom:5px}.field input,.field select{border:0;outline:0;background:none;width:100%;color:#142641;font-weight:750;font-size:13px}.advanced{display:flex;justify-content:space-between;margin:11px 0;color:#65788d;font-size:9px}.advanced b{color:#397dd0}.result{background:#19314f;color:#fff;border-radius:15px;padding:18px 20px}.result-top{display:flex;align-items:start;justify-content:space-between}.result small{font-size:9px;color:#b9cbdd}.age{font-size:31px;letter-spacing:-.04em;font-weight:850;margin-top:4px}.countdown{background:#fff0eb;color:#a15140;border-radius:9px;padding:8px 11px;text-align:right}.countdown strong{display:block;font-size:15px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid #3b5470;padding-top:12px;margin-top:13px}.stats span{font-size:8px;color:#afc0d1}.stats b{display:block;color:#fff;font-size:11px;margin-top:3px}.go{width:100%;border:0;border-radius:9px;background:linear-gradient(90deg,#397dd0,#ec8673);color:#fff;font-weight:800;padding:12px;margin-top:14px;cursor:pointer}
    .units{padding:74px 0 67px}.center{text-align:center;max-width:720px;margin:0 auto 36px}.center span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#397dd0;font-weight:850}.center h2{font-size:36px;letter-spacing:-.04em;margin:10px 0}.center p{color:#687a8f;line-height:1.6}.unit-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.unit{border:1px solid #dce5ed;border-radius:14px;padding:19px 12px;text-align:center}.unit i{font-style:normal;font-size:21px}.unit b{display:block;font-size:20px;margin:9px 0 3px;color:#19314f}.unit span{font-size:8px;color:#728499;text-transform:uppercase;letter-spacing:.08em}.unit:nth-child(2n){background:#f8faff}.progress-card{margin-top:22px;border:1px solid #dce5ed;border-radius:16px;padding:23px;display:grid;grid-template-columns:190px 1fr 120px;gap:20px;align-items:center}.progress-card h3{font-size:14px;margin:0}.progress-card p{font-size:9px;color:#74879b;margin:5px 0 0}.track{height:13px;background:#edf2f6;border-radius:99px;overflow:hidden}.track i{display:block;width:37%;height:100%;background:linear-gradient(90deg,#397dd0,#ec8673);border-radius:99px}.progress-card strong{text-align:right;color:#397dd0;font-size:15px}
    .timeline-section{background:#f4f8fc;padding:69px 0}.timeline-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px}.timeline-head h2{font-size:34px;letter-spacing:-.04em;margin:8px 0 0}.timeline-head>div>span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#397dd0;font-weight:850}.legend{font-size:9px;color:#64778d}.timeline{display:grid;grid-template-columns:repeat(5,1fr);position:relative}.timeline:before{content:"";position:absolute;left:9%;right:9%;top:31px;height:3px;background:#d5e2ed}.event{text-align:center;position:relative}.dot{width:64px;height:64px;border-radius:50%;background:#fff;border:6px solid #e8f1f8;display:grid;place-items:center;margin:auto;position:relative;z-index:1;font-size:18px}.event.active .dot{background:#397dd0;color:#fff;border-color:#dbeaff;box-shadow:0 8px 20px #397dd033}.event h3{font-size:11px;margin:12px 0 4px}.event p{font-size:8px;color:#74879a;margin:0}.event b{font-size:9px;color:#397dd0}
