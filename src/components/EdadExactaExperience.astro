    .top{height:88px;border-bottom:1px solid #e0e6ee;display:flex;align-items:center;background:#fff}.nav{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;font-size:18px;font-weight:850}.logo{width:31px;height:31px;border-radius:7px;background:#19304d;display:grid;place-items:center;color:#fff;font-size:14px}.links,.tools{display:flex;align-items:center;gap:27px}.links a{font-size:13px;font-weight:700;color:#43526a}.tools span{border:1px solid #d9e2eb;border-radius:10px;padding:11px 14px;font-size:12px;font-weight:700}.tools .profile{background:#19304d;color:#fff;border-color:#19304d}
