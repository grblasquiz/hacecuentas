<script is:inline>
  (function () {
    const root = document.querySelector('.uo');
    if (!root) return;
    const JORNALES = JSON.parse(root.getAttribute('data-jornales'));
    const SERENO = JSON.parse(root.getAttribute('data-sereno'));
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => '$' + Math.round(n).toLocaleString('es-AR');

    const HORAS_JORNADA = 8, DIAS_MES_BASE = 22;
    const CAT_LABEL = {
      ayudante: 'Ayudante', medio_oficial: 'Medio Oficial', oficial: 'Oficial',
      oficial_especializado: 'Oficial Especializado', sereno: 'Sereno (mensualizado)',
    };
    const ZONA_CORTA = { a: 'Zona A', b: 'Zona B', c: 'Zona C', c_austral: 'Zona C Austral' };
    const CATS = ['ayudante', 'medio_oficial', 'oficial', 'oficial_especializado', 'sereno'];

    const catEl = $('uo-cat'), zonaEl = $('uo-zona'), diasEl = $('uo-dias'),
      antigEl = $('uo-antig'), presEl = $('uo-pres'), he50El = $('uo-he50'), he100El = $('uo-he100');

    // Réplica exacta del motor (paritaria-uocra-construccion-2026-categoria.ts),
    // incluidos los clamps de días (0-31), antigüedad (≥0) y horas extra (≥0).
    function liq(categoria, zona, diasRaw, antigRaw, pres, he50Raw, he100Raw) {
      const dias = Math.min(Math.max(Number(diasRaw) || 0, 0), 31);
      const antig = Math.max(Number(antigRaw) || 0, 0);
      const he50 = Math.max(Number(he50Raw) || 0, 0);
      const he100 = Math.max(Number(he100Raw) || 0, 0);
      const esSereno = categoria === 'sereno';
      const mensual = SERENO[zona] !== undefined ? SERENO[zona] : SERENO.a;
      const jornal = esSereno
        ? mensual / (DIAS_MES_BASE * HORAS_JORNADA)
        : ((JORNALES[categoria] && JORNALES[categoria][zona]) !== undefined ? JORNALES[categoria][zona] : JORNALES.oficial.a);
      const basico = esSereno ? mensual * (dias / DIAS_MES_BASE) : jornal * HORAS_JORNADA * dias;
      const presentismo = pres ? basico * 0.20 : 0;
      const he = he50 * jornal * 1.5 + he100 * jornal * 2.0;
      const bruto = basico + presentismo + he;
      const pCese = antig < 1 ? 0.12 : 0.08;
      const cese = bruto * pCese;
      const desc = bruto * 0.17;
      const neto = bruto - desc;
      const costo = bruto + bruto * 0.23 + cese;
      return { dias, antig, jornal, basico, presentismo, he, bruto, cese, pCese, desc, neto, costo, esSereno };
    }

    function pct(part, total) { return total > 0 ? Math.round((part / total) * 100) : 0; }

    function render() {
      const cat = catEl.value, zona = zonaEl.value;
      const r = liq(cat, zona, diasEl.value, antigEl.value, presEl.checked, he50El.value, he100El.value);

      $('uo-big').textContent = fmt(r.neto);
      $('uo-sub').textContent = CAT_LABEL[cat] + ' · ' + ZONA_CORTA[zona] + ' · ' + r.dias + ' jornadas de 8 hs';
      $('uo-t-jornal').textContent = fmt(r.jornal);
      $('uo-t-bruto').textContent = fmt(r.bruto);
      $('uo-t-cese').textContent = fmt(r.cese);
      $('uo-t-cese-pct').textContent = Math.round(r.pCese * 100) + '%';
      $('uo-t-costo').textContent = fmt(r.costo);
      $('uo-r-basico').textContent = fmt(r.basico);
      $('uo-r-pres').textContent = fmt(r.presentismo);
      $('uo-r-desc').textContent = '−' + fmt(r.desc);
      $('uo-formula').textContent = r.esSereno
        ? fmt(SERENO[zona]) + ' mensual × ' + r.dias + '/22 + 20% − 17% = ' + fmt(r.neto)
        : fmt(r.jornal) + '/h × 8 hs × ' + r.dias + ' días + 20% − 17% = ' + fmt(r.neto);

      $('uo-deco-val').textContent = fmt(r.neto);
      $('uo-deco-jornal').textContent = fmt(r.jornal) + '/h';

      $('uo-quick').innerHTML = '<strong>Respuesta rápida.</strong> Un ' + CAT_LABEL[cat] + ' de ' + ZONA_CORTA[zona] +
        ' cobra ' + fmt(r.jornal) + ' por hora: en ' + r.dias + ' jornadas son <strong>' + fmt(r.bruto) +
        ' brutos</strong> y <strong>' + fmt(r.neto) + ' netos</strong>, más ' + fmt(r.cese) + ' de fondo de cese.';

      $('uo-hl-big').textContent = fmt(r.jornal);
      $('uo-b-basico').textContent = fmt(r.basico);
      $('uo-b-pres').textContent = fmt(r.presentismo);
      $('uo-b-he').textContent = fmt(r.he);
      $('uo-b-total').textContent = fmt(r.bruto);
      $('uo-b-cese').textContent = fmt(r.cese);
      $('uo-b-basico-bar').style.width = pct(r.basico, r.bruto) + '%';
      $('uo-b-pres-bar').style.width = pct(r.presentismo, r.bruto) + '%';
      $('uo-b-he-bar').style.width = pct(r.he, r.bruto) + '%';

      $('uo-s1').textContent = CAT_LABEL[cat] + ' · ' + ZONA_CORTA[zona] + ' · ' + fmt(r.jornal) + '/h';
      $('uo-s2').textContent = r.esSereno
        ? fmt(SERENO[zona]) + ' × ' + r.dias + '/22 = ' + fmt(r.basico)
        : fmt(r.jornal) + ' × 8 × ' + r.dias + ' = ' + fmt(r.basico);
      $('uo-s3').textContent = fmt(r.bruto) + ' − 17% = ' + fmt(r.neto);

      $('uo-tbody').innerHTML = CATS.map(function (c) {
        const x = liq(c, zona, diasEl.value, antigEl.value, presEl.checked, he50El.value, he100El.value);
        return '<tr><td>' + CAT_LABEL[c] + '</td><td>' + (c === 'sereno' ? '— mensual' : fmt(x.jornal) + '/h') +
          '</td><td>' + fmt(x.bruto) + '</td><td class="cf-td-em">' + fmt(x.neto) + '</td></tr>';
      }).join('');
      $('uo-tbl-note').textContent = 'Calculado en ' + ZONA_CORTA[zona] + ' con ' + r.dias + ' jornadas y ' +
        (presEl.checked ? 'asistencia perfecta' : 'sin presentismo') +
        ', según los datos que cargaste arriba. Sin horas extra ni adicionales por especialidad.';
    }

    [catEl, zonaEl].forEach((el) => el.addEventListener('change', render));
    [diasEl, antigEl, he50El, he100El].forEach((el) => el.addEventListener('input', render));
    presEl.addEventListener('change', render);
    $('uo-calc-btn').addEventListener('click', render);
    document.querySelectorAll('[data-cat]').forEach((b) => b.addEventListener('click', () => {
      catEl.value = b.getAttribute('data-cat'); render();
    }));

    function summary() {
      const cat = catEl.value, zona = zonaEl.value;
      const r = liq(cat, zona, diasEl.value, antigEl.value, presEl.checked, he50El.value, he100El.value);
      return 'Sueldo UOCRA (CCT 76/75, escala julio 2026) — ' + CAT_LABEL[cat] + ', ' + ZONA_CORTA[zona] +
        ', ' + r.dias + ' jornadas: jornal ' + fmt(r.jornal) + '/h, bruto ' + fmt(r.bruto) + ', neto ' +
        fmt(r.neto) + '. Fondo de cese ' + fmt(r.cese) + ' (' + Math.round(r.pCese * 100) + '%). — hacecuentas.com';
    }
    function shareUrl() {
      return location.origin + location.pathname + '?cat=' + catEl.value + '&zona=' + zonaEl.value +
        '&dias=' + diasEl.value + '&antig=' + antigEl.value + '&pres=' + (presEl.checked ? 'si' : 'no');
    }
    function copy(t, btn) { navigator.clipboard?.writeText(t).then(() => { const o = btn.innerHTML; btn.innerHTML = '✓ Copiado'; setTimeout(() => btn.innerHTML = o, 1500); }); }
    $('uo-copy').addEventListener('click', (e) => copy(summary(), e.currentTarget));
    $('uo-detail').addEventListener('click', () => { document.getElementById('como-funciona')?.scrollIntoView({ behavior: 'smooth' }); });
    const s2 = $('uo-share2'); if (s2) s2.addEventListener('click', (e) => copy(shareUrl(), e.currentTarget));

    const q = new URLSearchParams(location.search);
    if (q.get('cat')) catEl.value = q.get('cat');
    if (q.get('zona')) zonaEl.value = q.get('zona');
    if (q.get('dias')) diasEl.value = q.get('dias');
    if (q.get('antig')) antigEl.value = q.get('antig');
    if (q.get('pres')) presEl.checked = q.get('pres') === 'si';
    render();
  })();
</script>

