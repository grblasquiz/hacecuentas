---
import type { HubData } from '../lib/hubs/types';
import AuthorByline from './AuthorByline.astro';

interface Props {
  data: HubData;
}

const { data } = Astro.props;

const heightRows = Array.from({ length: 12 }, (_, index) => {
  const heightCm = 145 + index * 5;
  const heightM = heightCm / 100;
  return {
    heightCm,
    min: (18.5 * heightM * heightM).toFixed(1).replace('.', ','),
    max: (24.9 * heightM * heightM).toFixed(1).replace('.', ','),
  };
});
---

<main class="imc-page" id="main">
  <section class="imc-hero">
    <div class="imc-shell imc-hero__grid">
      <div class="imc-intro">
        <nav class="imc-crumbs" aria-label="Migas de pan">
          <a href="/salud">Salud</a><span>/</span><span>Peso ideal e IMC</span>
        </nav>
        <h1>Calculadora de IMC <br />y rango saludable según <br />tu altura</h1>
        <p class="imc-lede">
          Calculá tu índice de masa corporal, consultá la tabla de la OMS y conocé
          el rango de peso saludable orientativo para tu estatura.
        </p>
        <div class="imc-trust" aria-label="Beneficios">
          <span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.6 13.1 13.1 20.6a2 2 0 0 1-2.8 0l-6.9-6.9a2 2 0 0 1-.6-1.4V5a2 2 0 0 1 2-2h7.3a2 2 0 0 1 1.4.6l7.1 6.7a2 2 0 0 1 0 2.8Z"/><circle cx="8" cy="8" r="1.4"/></svg></i> Gratis</span>
          <span><i aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg></i> Privado</span>
          <span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.3 8.5-8 10-4.7-1.5-8-5-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></i> Basado en OMS</span>
        </div>
        <p class="imc-editorial"><AuthorByline lastReviewed={data.lastReviewed} showRole={true} /></p>
        <div class="imc-illustration" aria-hidden="true">
          <svg viewBox="0 0 310 210" role="img">
            <circle class="imc-illustration__halo" cx="145" cy="113" r="89"/>
            <path class="imc-illustration__ground" d="M20 190h270" />
            <path class="imc-illustration__plant" d="M44 187v-59m0 25-20-17m20 1 22-23m-22 56-22-9m22-28-18-30" />
            <rect class="imc-illustration__scale" x="76" y="38" width="126" height="148" rx="22" />
            <path class="imc-illustration__dial" d="M101 82c8-33 67-33 76 0" />
            <path class="imc-illustration__needle" d="m139 76 13-22" />
            <circle class="imc-illustration__needle-dot" cx="139" cy="76" r="4"/>
            <path class="imc-illustration__heart" d="M211 103c-19-29-64-6-50 29 10 25 50 46 50 46s40-21 50-46c14-35-31-58-50-29Z" />
            <path class="imc-illustration__pulse" d="m174 140 20-1 9-20 12 36 11-17h22" />
            <circle class="imc-illustration__dot" cx="277" cy="157" r="3"/><circle class="imc-illustration__dot" cx="291" cy="157" r="3" />
            <circle class="imc-illustration__dot" cx="277" cy="171" r="3"/><circle class="imc-illustration__dot" cx="291" cy="171" r="3" />
          </svg>
        </div>
      </div>

      <form class="imc-calculator" id="imc-form" novalidate>
        <div class="imc-card-title">
          <h2>Tus datos</h2>
          <div class="imc-units" role="group" aria-label="Sistema de unidades">
            <button type="button" class="is-active" data-unit="metric" aria-pressed="true">Métrico</button>
            <button type="button" data-unit="imperial" aria-pressed="false">Imperial</button>
          </div>
        </div>

        <div class="imc-primary-fields">
          <label>
            <span>Peso</span>
            <span class="imc-input">
              <input id="imc-weight" name="peso" type="number" value="70" min="20" max="300" step="0.1" inputmode="decimal" required aria-describedby="imc-weight-example" />
              <b id="imc-weight-unit">kg</b>
            </span>
            <small id="imc-weight-example">Ej.: 70</small>
          </label>
          <label>
            <span>Altura</span>
            <span class="imc-input">
              <input id="imc-height" name="altura" type="number" value="170" min="100" max="250" step="1" inputmode="decimal" required aria-describedby="imc-height-example" />
              <b id="imc-height-unit">cm</b>
            </span>
            <small id="imc-height-example">Ej.: 170</small>
          </label>
        </div>

        <button class="imc-advanced-toggle" type="button" aria-expanded="false" aria-controls="imc-advanced">
          <span class="imc-person-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4.5 21v-2.5a7.5 7.5 0 0 1 15 0V21"/></svg></span>
          <span>Agregar edad, sexo y cintura <em>(opcional)</em></span>
          <span class="imc-chevron" aria-hidden="true">⌄</span>
        </button>

        <div class="imc-advanced" id="imc-advanced" hidden>
          <label><span>Edad (opcional)</span><span class="imc-input imc-input--small"><input id="imc-age" type="number" placeholder="Ej.: 35" min="18" max="110" /><b>años</b></span></label>
          <label><span>Sexo usado por las fórmulas históricas</span><select id="imc-sex" aria-describedby="imc-sex-help"><option value="">No indicar</option><option value="m">Masculino</option><option value="f">Femenino</option></select><small id="imc-sex-help">Opcional. Sólo modifica Devine, Robinson, Lorentz y CUN-BAE; no cambia el IMC.</small></label>
          <label><span>Cintura (opcional)</span><span class="imc-input imc-input--small"><input id="imc-waist" type="number" placeholder="Ej.: 85" min="40" max="200" step="0.1" /><b id="imc-waist-unit">cm</b></span></label>
          <p class="imc-measure-help">Medila a mitad de camino entre la última costilla y la parte superior de la cadera, después de exhalar normalmente.</p>
        </div>

        <button class="imc-submit" type="submit">
          <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M8 6h8M8 10h2m2 0h2m2 0h0M8 14h2m2 0h2m2 0h0M8 18h2m2 0h2m2 0h0"/></svg>
          Calcular mi IMC
        </button>
        <p class="imc-form-error" id="imc-form-error" role="alert" hidden></p>
        <p class="imc-privacy"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg><span>Tus datos son privados y se usan solo para este cálculo.<br />No se guardan ni se comparten.</span></p>
      </form>
    </div>
  </section>

  <section class="imc-results-wrap" aria-live="polite">
    <div class="imc-shell">
      <div class="imc-results">
        <div class="imc-score">
          <span>Tu IMC</span>
          <strong id="imc-score">24,2</strong>
          <b id="imc-category">Peso saludable</b>
          <p>Para tu altura, el rango orientativo<br />es <span id="imc-range-copy">53,5–72,0 kg</span>.</p>
        </div>
        <div class="imc-scale">
          <h2>Clasificación del IMC <span>(OMS)</span></h2>
          <div class="imc-scale__graphic">
            <output id="imc-marker-label">24,2</output>
            <i id="imc-marker"></i>
            <div class="imc-scale__bar"><span></span><span></span><span></span><span></span></div>
            <div class="imc-scale__ticks"><span>18,5</span><span>25</span><span>30</span></div>
          </div>
          <div class="imc-scale__labels">
            <span><b>Bajo peso</b><small>&lt; 18,5</small></span>
            <span><b>Saludable</b><small>18,5 – 24,9</small></span>
            <span><b>Sobrepeso</b><small>25 – 29,9</small></span>
            <span><b>Obesidad</b><small>≥ 30</small></span>
          </div>
        </div>
        <div class="imc-insights">
          <article>
            <span class="imc-insight-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="4"/><path d="M7.5 10a4.5 4.5 0 0 1 9 0M12 10l2.5-2.5M7 17h10"/></svg></span>
            <div><b>Tu rango saludable</b><strong id="imc-range">53,5 – 72 kg</strong><small>Peso orientativo para tu altura.</small></div>
          </article>
          <article>
            <span class="imc-insight-icon imc-insight-icon--blue"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/><path d="m14.5 9.5 5-5M16.5 4.5h3v3"/></svg></span>
            <div><b>Referencias históricas</b><strong id="imc-ideal">—</strong><small id="imc-ideal-copy">Indicá sexo si querés comparar tres fórmulas opcionales.</small></div>
          </article>
          <article>
            <span class="imc-insight-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 7.5h18v9H3z"/><path d="M6 7.5v3m3-3v2m3-2v3m3-3v2m3-2v3"/></svg></span>
            <div><b>Relación cintura/altura</b><strong id="imc-whtr">—</strong><small id="imc-whtr-copy">Agregá tu cintura para estimarla.</small></div>
          </article>
        </div>
        <div class="imc-action" id="imc-action" data-tone="healthy">
          <span class="imc-action__icon" aria-hidden="true">✓</span>
          <div>
            <b id="imc-action-title">Estás dentro del rango orientativo</b>
            <p id="imc-action-copy">Tu peso está dentro del intervalo de referencia de la OMS para tu altura.</p>
          </div>
        </div>
        <div class="imc-formulas" id="imc-formulas" hidden>
          <div class="imc-formulas__intro">
            <b>Tres fórmulas, tres referencias</b>
            <p>No existe un único “peso perfecto”. Estas fórmulas históricas estiman valores diferentes y no reemplazan el rango saludable de la OMS.</p>
          </div>
          <div class="imc-formulas__grid">
            <span><b>Devine</b><strong id="imc-devine">—</strong><small>Referencia farmacológica</small></span>
            <span><b>Robinson</b><strong id="imc-robinson">—</strong><small>Referencia antropométrica</small></span>
            <span><b>Lorentz</b><strong id="imc-lorentz">—</strong><small>Fórmula histórica europea</small></span>
            <span><b>CUN-BAE</b><strong id="imc-cunbae">—</strong><small>Grasa corporal estimada</small></span>
          </div>
          <p class="imc-formulas__note" id="imc-cunbae-note">Completá edad y sexo para estimar el porcentaje de grasa corporal con CUN-BAE.</p>
        </div>
        <p class="imc-disclaimer"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5h.01"/></svg> Orientativo, no reemplaza una consulta médica.</p>
        <p class="imc-age-note" id="imc-age-note" hidden>En mayores de 65 años, interpretá el IMC junto con cambios recientes de peso, fuerza, alimentación y masa muscular.</p>
        <div class="imc-result-tools">
          <button type="button" id="imc-save">Guardar medición en este dispositivo</button>
          <button type="button" id="imc-print">Imprimir resultado</button>
        </div>
        <div class="imc-history" id="imc-history" hidden>
          <div><b>Tu evolución reciente</b><button type="button" id="imc-history-clear">Borrar historial</button></div>
          <p>Se guarda únicamente en este navegador. Hacé Cuentas no recibe estos datos.</p>
          <div class="imc-history__rows" id="imc-history-rows"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="imc-understand imc-shell">
    <h2>Entendé tu resultado</h2>
    <div class="imc-education">
      <article>
        <span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v18H7.5A3.5 3.5 0 0 0 4 23V5.5ZM20 5.5A3.5 3.5 0 0 0 16.5 2H13v18h3.5A3.5 3.5 0 0 1 20 23V5.5Z"/></svg></span>
        <div><h3>Qué significa</h3><p>El IMC relaciona tu peso con tu altura. Es una guía útil para evaluar el peso a nivel poblacional.</p><a href="#imc-explanation">Leer más →</a></div>
      </article>
      <article>
        <span class="is-green"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10" cy="9" r="5"/><path d="m14 13 6 6M8 15c-2 1.5-3.5 3.5-4 6M16 15c2 1.5 3.5 3.5 4 6"/></svg></span>
        <div><h3>Qué mirar además<br />del IMC</h3><p>La composición corporal, la distribución de grasa, la masa muscular y los hábitos también importan.</p><a href="#imc-explanation">Saber más →</a></div>
      </article>
      <article>
        <span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 17c2.5-1 4.5-3 5.5-6l2 1.5c2.5 2 4.5 2.5 7.5 2.5v4H8c-2 0-3.3-.7-4-2Z"/><path d="M9.5 11 12 5l3 5M5 19v2h14v-2"/></svg></span>
        <div><h3>Cómo mejorar de<br />forma saludable</h3><p>Pequeños cambios sostenibles en alimentación, actividad física y descanso generan grandes resultados.</p><a href="#imc-explanation">Ver recomendaciones →</a></div>
      </article>
    </div>
  </section>

  <section class="imc-detail imc-shell" id="imc-explanation">
    <div class="imc-detail__copy">
      <span class="imc-kicker">Tu resultado, en contexto</span>
      <h2>El IMC es un punto de partida, no un diagnóstico</h2>
      <p>{data.answer?.copy}</p>
      <div class="imc-detail__columns">
        <div><h3>Qué entra en el cálculo</h3><ul>{data.answer?.yes.slice(0, 4).map((item) => <li>{item}</li>)}</ul></div>
        <div><h3>Qué conviene mirar además</h3><ul>{data.answer?.warn.slice(0, 4).map((item) => <li>{item}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section class="imc-reference imc-shell" aria-labelledby="imc-reference-title">
    <div class="imc-reference__intro">
      <span class="imc-kicker">Cálculo y referencia</span>
      <h2 id="imc-reference-title">Cómo se calcula el IMC</h2>
      <p><strong>IMC = peso (kg) ÷ altura² (m).</strong> Por ejemplo, con 70 kg y 1,70 m: 70 ÷ (1,70 × 1,70) = <strong>24,2</strong>. La tabla sirve para adultos; no se usa igual durante el embarazo ni en menores de 18 años.</p>
    </div>
    <div class="imc-table-wrap" tabindex="0" aria-label="Tabla de clasificación del IMC, desplazable horizontalmente">
      <table>
        <caption>Clasificación del IMC en adultos según la OMS</caption>
        <thead><tr><th scope="col">IMC</th><th scope="col">Categoría</th><th scope="col">Lectura orientativa</th></tr></thead>
        <tbody>
          <tr><td>&lt; 18,5</td><td>Bajo peso</td><td>Puede requerir evaluación nutricional</td></tr>
          <tr><td>18,5–24,9</td><td>Peso normal</td><td>Rango de referencia poblacional</td></tr>
          <tr><td>25,0–29,9</td><td>Sobrepeso</td><td>Riesgo que aumenta de forma gradual</td></tr>
          <tr><td>30,0–34,9</td><td>Obesidad grado I</td><td>Conviene una evaluación integral</td></tr>
          <tr><td>35,0–39,9</td><td>Obesidad grado II</td><td>Riesgo elevado</td></tr>
          <tr><td>≥ 40,0</td><td>Obesidad grado III</td><td>Riesgo muy elevado</td></tr>
        </tbody>
      </table>
    </div>
    <div class="imc-height-table">
      <div class="imc-reference__intro">
        <span class="imc-kicker">Consulta rápida por estatura</span>
        <h2>Peso saludable según la altura</h2>
        <p>La tabla traduce el rango de IMC 18,5–24,9 a kilos. Es una referencia para adultos: composición corporal, cintura, edad y antecedentes de salud también importan.</p>
      </div>
      <div class="imc-table-wrap" tabindex="0" aria-label="Tabla de peso saludable según altura, desplazable horizontalmente">
        <table>
          <caption>Rango orientativo de peso para alturas de 1,45 a 2 metros</caption>
          <thead><tr><th scope="col">Altura</th><th scope="col">Peso mínimo</th><th scope="col">Peso máximo</th><th scope="col">Cálculo</th></tr></thead>
          <tbody>
            {heightRows.map((row) => (
              <tr>
                <td>{(row.heightCm / 100).toFixed(2).replace('.', ',')} m</td>
                <td>{row.min} kg</td>
                <td>{row.max} kg</td>
                <td><a href="#imc-form" data-height-preset={row.heightCm}>Calcular para {row.heightCm} cm</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="imc-methodology">
      <span class="imc-kicker">Metodología transparente</span>
      <h2>Qué calculamos y con qué límites</h2>
      <div class="imc-methodology__grid">
        <article><b>IMC y rango OMS</b><p>Usamos peso ÷ altura². El intervalo 18,5–24,9 se convierte a kilos para tu altura; es un tamiz poblacional, no un diagnóstico.</p></article>
        <article><b>Fórmulas históricas</b><p>Comparamos Devine, Robinson y Lorentz únicamente como referencias. No definen una meta clínica ni un único “peso ideal”.</p></article>
        <article><b>Cintura/altura</b><p>Dividimos cintura por altura. La lectura se muestra como complemento cuando el IMC es menor de 35, siguiendo la guía NICE.</p></article>
        <article><b>Grasa estimada CUN-BAE</b><p>Si indicás edad y sexo, estimamos adiposidad con una ecuación validada en adultos. Su error individual puede ser amplio y no reemplaza una medición clínica.</p></article>
      </div>
    </div>
    <div class="imc-next">
      <h3>Completá la foto, no te quedes con un solo número</h3>
      <p>El IMC no distingue grasa de músculo ni muestra dónde se distribuye la grasa corporal.</p>
      <div>
        <a href="/salud/grasa-corporal">Calcular grasa corporal <span aria-hidden="true">→</span></a>
        <a href="/salud/calorias-de-los-alimentos">Entender calorías y porciones <span aria-hidden="true">→</span></a>
        <a href="/salud/peso-en-el-embarazo">Peso durante el embarazo <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="imc-faq imc-shell">
    <h2>Preguntas frecuentes</h2>
    <div class="imc-faq__list">
      {data.faq.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.q}<span>+</span></summary>
          <p set:html={item.a} />
        </details>
      ))}
    </div>
  </section>

  <section class="imc-sources imc-shell">
    <h2>Fuentes</h2>
    <div>{data.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer"><b>{source.name}</b><span>{source.publisher}{source.date ? ` · ${source.date}` : ''}</span></a>)}</div>
  </section>
</main>

<script>
  const decimal = (value: number, digits = 1) => value.toFixed(digits).replace('.', ',');
  const form = document.querySelector<HTMLFormElement>('#imc-form');
  const advancedButton = document.querySelector<HTMLButtonElement>('.imc-advanced-toggle');
  const advanced = document.querySelector<HTMLElement>('#imc-advanced');
  const errorMessage = document.querySelector<HTMLElement>('#imc-form-error');
  let unit: 'metric' | 'imperial' = 'metric';

  advancedButton?.addEventListener('click', () => {
    const open = advancedButton.getAttribute('aria-expanded') === 'true';
    advancedButton.setAttribute('aria-expanded', String(!open));
    if (advanced) advanced.hidden = open;
  });

  document.querySelectorAll<HTMLButtonElement>('[data-unit]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = button.dataset.unit as 'metric' | 'imperial';
      if (next === unit) return;
      const weight = document.querySelector<HTMLInputElement>('#imc-weight')!;
      const height = document.querySelector<HTMLInputElement>('#imc-height')!;
      const waist = document.querySelector<HTMLInputElement>('#imc-waist')!;
      if (next === 'imperial') {
        weight.value = String(Math.round(Number(weight.value) * 2.20462));
        height.value = String(Math.round(Number(height.value) / 2.54));
        if (waist.value) waist.value = String(Math.round(Number(waist.value) / 2.54 * 10) / 10);
        weight.min = '44'; weight.max = '660'; height.min = '39'; height.max = '98';
        waist.min = '16'; waist.max = '79';
        document.querySelector('#imc-weight-unit')!.textContent = 'lb';
        document.querySelector('#imc-height-unit')!.textContent = 'in';
        document.querySelector('#imc-waist-unit')!.textContent = 'in';
        document.querySelector('#imc-weight-example')!.textContent = 'Ej.: 154';
        document.querySelector('#imc-height-example')!.textContent = 'Ej.: 67';
      } else {
        weight.value = String(Math.round(Number(weight.value) / 2.20462));
        height.value = String(Math.round(Number(height.value) * 2.54));
        if (waist.value) waist.value = String(Math.round(Number(waist.value) * 2.54 * 10) / 10);
        weight.min = '20'; weight.max = '300'; height.min = '100'; height.max = '250';
        waist.min = '40'; waist.max = '200';
        document.querySelector('#imc-weight-unit')!.textContent = 'kg';
        document.querySelector('#imc-height-unit')!.textContent = 'cm';
        document.querySelector('#imc-waist-unit')!.textContent = 'cm';
        document.querySelector('#imc-weight-example')!.textContent = 'Ej.: 70';
        document.querySelector('#imc-height-example')!.textContent = 'Ej.: 170';
      }
      unit = next;
      document.querySelectorAll<HTMLButtonElement>('[data-unit]').forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      calculate();
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-height-preset]').forEach((link) => {
    link.addEventListener('click', () => {
      const height = Number(link.dataset.heightPreset);
      const heightInput = document.querySelector<HTMLInputElement>('#imc-height');
      const metricButton = document.querySelector<HTMLButtonElement>('[data-unit="metric"]');
      if (!heightInput || !metricButton || !height) return;
      if (unit !== 'metric') metricButton.click();
      heightInput.value = String(height);
      calculate();
      window.setTimeout(() => heightInput.focus(), 0);
    });
  });

  function showError(message: string) {
    if (!errorMessage) return;
    errorMessage.textContent = message;
    errorMessage.hidden = !message;
  }

  function calculate(showValidation = false) {
    const rawWeight = Number(document.querySelector<HTMLInputElement>('#imc-weight')?.value);
    const rawHeight = Number(document.querySelector<HTMLInputElement>('#imc-height')?.value);
    const weight = unit === 'imperial' ? rawWeight / 2.20462 : rawWeight;
    const heightCm = unit === 'imperial' ? rawHeight * 2.54 : rawHeight;
    const validWeight = weight >= 20 && weight <= 300;
    const validHeight = heightCm >= 100 && heightCm <= 250;
    if (!validWeight || !validHeight) {
      if (showValidation) showError(unit === 'metric'
        ? 'Ingresá un peso entre 20 y 300 kg y una altura entre 100 y 250 cm.'
        : 'Ingresá un peso entre 44 y 660 lb y una altura entre 39 y 98 in.');
      return false;
    }
    showError('');
    const age = Number(document.querySelector<HTMLInputElement>('#imc-age')?.value) || 0;
    const rawWaist = Number(document.querySelector<HTMLInputElement>('#imc-waist')?.value) || 0;
    const waist = unit === 'imperial' ? rawWaist * 2.54 : rawWaist;
    if ((age && (age < 18 || age > 110)) || (waist && (waist < 40 || waist > 200))) {
      if (showValidation) showError('Revisá los datos opcionales: edad entre 18 y 110 años y cintura entre 40 y 200 cm.');
      return false;
    }
    const sex = document.querySelector<HTMLSelectElement>('#imc-sex')?.value || '';
    const heightM = heightCm / 100;
    const bmi = weight / (heightM * heightM);
    const healthyMin = 18.5;
    const healthyMax = 24.9;
    const minWeight = healthyMin * heightM * heightM;
    const maxWeight = healthyMax * heightM * heightM;
    const inchesOverFive = Math.max(0, heightCm / 2.54 - 60);
    const devine = sex ? (sex === 'f' ? 45.5 + 2.3 * inchesOverFive : 50 + 2.3 * inchesOverFive) : 0;
    const robinson = sex ? (sex === 'f' ? 49 + 1.7 * inchesOverFive : 52 + 1.9 * inchesOverFive) : 0;
    const lorentz = sex ? (heightCm - 100) - ((heightCm - 150) / (sex === 'f' ? 2.5 : 4)) : 0;
    const ideals = [devine, robinson, lorentz].filter((value) => value > 0);
    const idealLow = ideals.length ? Math.min(...ideals) : 0;
    const idealHigh = ideals.length ? Math.max(...ideals) : 0;
    const category = bmi < 18.5 ? 'Bajo peso' : bmi < 25 ? 'Peso saludable' : bmi < 30 ? 'Sobrepeso' : bmi < 35 ? 'Obesidad grado I' : bmi < 40 ? 'Obesidad grado II' : 'Obesidad grado III';
    const tone = bmi < 18.5 ? 'low' : bmi < 25 ? 'healthy' : bmi < 30 ? 'high' : 'obesity';
    const position = Math.max(0, Math.min(100, ((bmi - 15) / 25) * 100));
    const range = `${decimal(minWeight)}–${decimal(maxWeight)} kg`;
    const action = document.querySelector<HTMLElement>('#imc-action');
    const actionTitle = document.querySelector<HTMLElement>('#imc-action-title');
    const actionCopy = document.querySelector<HTMLElement>('#imc-action-copy');
    if (action && actionTitle && actionCopy) {
      if (weight < minWeight) {
        const difference = minWeight - weight;
        action.dataset.tone = 'low';
        actionTitle.textContent = `Te separan ${decimal(difference)} kg del rango orientativo`;
        actionCopy.textContent = `Ese es el aumento hasta ${decimal(minWeight)} kg, el límite inferior de referencia para tu altura. No lo tomes como una meta sin evaluar tu contexto.`;
      } else if (weight > maxWeight) {
        const difference = weight - maxWeight;
        action.dataset.tone = 'high';
        actionTitle.textContent = `Te separan ${decimal(difference)} kg del rango orientativo`;
        const weeksMin = Math.ceil(difference / 1);
        const weeksMax = Math.ceil(difference / 0.5);
        actionCopy.textContent = `Esa es la diferencia hasta ${decimal(maxWeight)} kg, el límite superior de referencia para tu altura. A un ritmo sostenible de 0,5 a 1 kg por semana (más rápido se pierde músculo), son entre ${weeksMin} y ${weeksMax} semanas. Una reducción gradual del 5–10% ya puede ser clínicamente relevante.`;
      } else {
        action.dataset.tone = 'healthy';
        actionTitle.textContent = 'Estás dentro del rango orientativo';
        actionCopy.textContent = `Tu peso está entre ${decimal(minWeight)} y ${decimal(maxWeight)} kg, el intervalo de referencia de la OMS para tu altura.`;
      }
    }
    document.querySelector('#imc-score')!.textContent = decimal(bmi);
    document.querySelector('#imc-category')!.textContent = category;
    document.querySelector('#imc-category')!.setAttribute('data-tone', tone);
    document.querySelector('#imc-range-copy')!.textContent = range;
    document.querySelector('#imc-range')!.textContent = `${decimal(minWeight)} – ${decimal(maxWeight, 0)} kg`;
    document.querySelector('#imc-ideal')!.textContent = ideals.length ? `${decimal(idealLow, 0)} – ${decimal(idealHigh, 0)} kg` : '—';
    document.querySelector('#imc-ideal-copy')!.textContent = ideals.length
      ? 'Rango entre Devine, Robinson y Lorentz; no es una meta clínica.'
      : 'Indicá sexo sólo si querés comparar tres fórmulas históricas.';
    const formulas = document.querySelector<HTMLElement>('#imc-formulas');
    if (formulas) formulas.hidden = !(sex || (sex && age));
    document.querySelector('#imc-devine')!.textContent = devine ? `${decimal(devine)} kg` : '—';
    document.querySelector('#imc-robinson')!.textContent = robinson ? `${decimal(robinson)} kg` : '—';
    document.querySelector('#imc-lorentz')!.textContent = lorentz ? `${decimal(lorentz)} kg` : '—';
    let cunBae = 0;
    if (sex && age >= 18 && age <= 80) {
      const female = sex === 'f' ? 1 : 0;
      const bmiSquared = bmi * bmi;
      cunBae = -44.988 + .503 * age + 10.689 * female + 3.172 * bmi - .026 * bmiSquared
        + .181 * bmi * female - .02 * bmi * age - .005 * bmiSquared * female + .00021 * bmiSquared * age;
    }
    document.querySelector('#imc-cunbae')!.textContent = cunBae ? `${decimal(cunBae)}%` : '—';
    document.querySelector('#imc-cunbae-note')!.textContent = cunBae
      ? 'CUN-BAE es una estimación indirecta para adultos de 18 a 80 años; el error individual del estudio fue cercano a 4,7 puntos porcentuales.'
      : 'Completá edad y sexo para estimar el porcentaje de grasa corporal con CUN-BAE.';
    document.querySelector('#imc-marker-label')!.textContent = decimal(bmi);
    (document.querySelector('#imc-marker-label') as HTMLElement).style.left = `${position}%`;
    (document.querySelector('#imc-marker') as HTMLElement).style.left = `${position}%`;
    const whtr = waist / heightCm;
    document.querySelector('#imc-whtr')!.textContent = waist ? decimal(whtr, 2) : '—';
    document.querySelector('#imc-whtr-copy')!.textContent = waist
      ? (bmi >= 35 ? 'Con IMC ≥ 35 esta relación aporta poca información adicional.' : whtr < .4 ? 'Valor bajo: revisá que la medición sea correcta.' : whtr < .5 ? 'Sin aumento de riesgo por adiposidad central.' : (bmi >= 18.5 && bmi < 25) ? 'IMC normal pero cintura sobre la mitad de la altura: igual indica grasa abdominal de riesgo. Consultalo.' : whtr < .6 ? 'Adiposidad central aumentada.' : 'Adiposidad central alta.')
      : 'Agregá tu cintura para estimarla.';
    const ageNote = document.querySelector<HTMLElement>('#imc-age-note');
    if (ageNote) ageNote.hidden = age < 65;
    return true;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (calculate(true)) {
      window.dataLayer?.push({ event: 'calculator_submit', calculator: 'imc_rango_saludable', units: unitMode });
      document.querySelector('.imc-results')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
  form?.querySelectorAll('input, select').forEach((field) => field.addEventListener('input', () => calculate(false)));

  const HISTORY_KEY = 'hc-imc-history-v1';
  type HistoryEntry = { date: string; weight: number; height: number; bmi: number; waist?: number };
  const readHistory = (): HistoryEntry[] => {
    try { return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]'); } catch { return []; }
  };
  const renderHistory = () => {
    const history = readHistory();
    const panel = document.querySelector<HTMLElement>('#imc-history');
    const rows = document.querySelector<HTMLElement>('#imc-history-rows');
    if (!panel || !rows) return;
    panel.hidden = history.length === 0;
    rows.replaceChildren(...history.slice(0, 6).map((entry) => {
      const row = document.createElement('span');
      const date = document.createElement('small');
      const weight = document.createElement('b');
      const bmi = document.createElement('strong');
      const waist = document.createElement('em');
      date.textContent = entry.date;
      weight.textContent = `${decimal(entry.weight)} kg`;
      bmi.textContent = `IMC ${decimal(entry.bmi)}`;
      waist.textContent = entry.waist ? `Cintura ${decimal(entry.waist)} cm` : 'Sin cintura';
      row.append(date, weight, bmi, waist);
      return row;
    }));
  };
  document.querySelector<HTMLButtonElement>('#imc-save')?.addEventListener('click', () => {
    if (!calculate(true)) return;
    const rawWeight = Number(document.querySelector<HTMLInputElement>('#imc-weight')?.value);
    const rawHeight = Number(document.querySelector<HTMLInputElement>('#imc-height')?.value);
    const rawWaist = Number(document.querySelector<HTMLInputElement>('#imc-waist')?.value) || 0;
    const weight = unit === 'imperial' ? rawWeight / 2.20462 : rawWeight;
    const height = unit === 'imperial' ? rawHeight * 2.54 : rawHeight;
    const waist = rawWaist ? (unit === 'imperial' ? rawWaist * 2.54 : rawWaist) : 0;
    const history = readHistory();
    history.unshift({ date: new Intl.DateTimeFormat('es-AR').format(new Date()), weight, height, bmi: weight / ((height / 100) ** 2), ...(waist ? { waist } : {}) });
    localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(0, 12)));
    renderHistory();
  });
  document.querySelector<HTMLButtonElement>('#imc-history-clear')?.addEventListener('click', () => {
    localStorage.removeItem(HISTORY_KEY);
    renderHistory();
  });
  document.querySelector<HTMLButtonElement>('#imc-print')?.addEventListener('click', () => window.print());
  renderHistory();
  calculate();
</script>

