    @media(max-width:800px){.wrap{width:min(100% - 28px,1160px)}.links{display:none}.hero-grid,.detail-grid,.employer-grid{grid-template-columns:1fr}.copy{text-align:center}.copy h1{font-size:39px}.eyebrow,.chips{justify-content:center}.salary-art{max-width:390px;margin-inline:auto}.calc{padding:20px 16px}.cases{grid-template-columns:1fr 1fr}.case-grid{grid-template-columns:1fr 1fr}.cases-head{display:block}.legend{margin-top:10px}.row{grid-template-columns:125px 1fr 86px}.tools span:not(:last-child){display:none}.employer-copy{text-align:center}}@media(max-width:480px){.copy h1{font-size:36px}.payslip{left:25px;width:235px}.stamp{right:5px}.fields{grid-template-columns:1fr}.field.wide{grid-column:auto}.stats{grid-template-columns:1fr 1fr}.case-grid{grid-template-columns:1fr}.row{grid-template-columns:1fr 70px}.row .bar{display:none}.cost-row label{width:105px}.cost-row b{width:85px}}
