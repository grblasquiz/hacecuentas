---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FootballMatch from './FootballMatch.astro';
import { footballMarkets, footballHreflang } from '../lib/football-markets';
import { footballEventAllowed, footballNameAllowed } from '../lib/football-policy';
import { footballSportsEvent } from '../lib/football-seo';
const { market, data }=Astro.props;
const pt=market.pt,en=market.en;
const copy=en?{today:'Matches today',recent:'Recent results',next:'What comes next',tables:'League tables',games:'matches today',live:'live',upcoming:'upcoming',updated:'Updated after each match finishes',empty:'No matches are scheduled today.',agenda:'Next 14 days',home:'Home',sport:'Sport'}:pt?{today:'Jogos de hoje',recent:'Resultados recentes',next:'Próximos jogos',tables:'Classificação',games:'jogos hoje',live:'ao vivo',upcoming:'próximos',updated:'Atualizado após o fim de cada partida',empty:'Não há jogos programados hoje.',agenda:'Próximos 14 dias',home:'Início',sport:'Esportes'}:{today:'Partidos de hoy',recent:'Resultados recientes',next:'Lo que viene',tables:'Tablas de posiciones',games:'partidos hoy',live:'en vivo',upcoming:'próximos',updated:'Se actualiza al finalizar cada partido',empty:'No hay partidos programados hoy.',agenda:'Próximos 14 días',home:'Inicio',sport:'Deportes'};
const dateKey=(v:any)=>new Intl.DateTimeFormat('en-CA',{timeZone:market.tz,year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(v));
const todayKey=dateKey(new Date());
const events=(data.leagues||[]).flatMap((l:any,i:number)=>(l.events||[]).filter(footballEventAllowed).map((e:any)=>({...e,league:market.leagues[i]}))).sort((a:any,b:any)=>+new Date(a.date)-+new Date(b.date));
const todays=events.filter((e:any)=>dateKey(e.date)===todayKey);
const recent=events.filter((e:any)=>dateKey(e.date)<todayKey&&(e.competitions?.[0]?.status?.type?.completed||e.competitions?.[0]?.status?.type?.state==='post')).sort((a:any,b:any)=>+new Date(b.date)-+new Date(a.date)).slice(0,12);
const upcoming=events.filter((e:any)=>dateKey(e.date)>todayKey).slice(0,12);
const liveCount=todays.filter((e:any)=>e.competitions?.[0]?.status?.type?.state==='in').length;
const longDate=new Intl.DateTimeFormat(market.locale,{timeZone:market.tz,weekday:'long',day:'numeric',month:'long'}).format(new Date());
const hour=(v:string)=>new Intl.DateTimeFormat(market.locale,{timeZone:market.tz,hour:'2-digit',minute:'2-digit'}).format(new Date(v));
const day=(v:string)=>new Intl.DateTimeFormat(market.locale,{timeZone:market.tz,weekday:'short',day:'2-digit',month:'short'}).format(new Date(v));
const sides=(e:any)=>e.competitions?.[0]?.competitors||[];
const stat=(e:any,n:string)=>e.stats?.find((s:any)=>s.name===n)?.displayValue||'0';
const title=en?`English football today: matches, results and tables | Hacé Cuentas`:pt?`Futebol ${market.adjective} hoje: jogos, resultados e tabela | Hacé Cuentas`:`Fútbol ${market.adjective} hoy: partidos, resultados y tablas | Hacé Cuentas`;
const description=en?'Today’s English football fixtures, results, upcoming matches and current Premier League and Championship tables, with local times, recent scores and the next 14 days of the season.':pt?`Jogos de hoje, resultados, próximos jogos, horários locais e classificação do futebol ${market.adjective}, com resultados recentes e agenda dos próximos 14 dias.`:`Partidos de hoy, resultados, próximos encuentros, horarios locales y tablas actualizadas del fútbol ${market.adjective}, con resultados recientes y agenda de los próximos 14 días.`;
const schema={'@context':'https://schema.org','@graph':[
 {'@type':'CollectionPage',name:title,url:`https://hacecuentas.com${market.path}`,inLanguage:market.locale,dateModified:data.fetchedAt,about:market.leagues.map((name:string)=>({'@type':'SportsOrganization',name}))},
 {'@type':'FAQPage',mainEntity:[
  {'@type':'Question',name:en?`What ${market.adjective} football matches are on today?`:pt?`Quais jogos do futebol ${market.adjective} acontecem hoje?`:`¿Qué partidos del fútbol ${market.adjective} se juegan hoy?`,acceptedAnswer:{'@type':'Answer',text:en?`This page lists today's matches in ${market.leagues.join(' and ')} using ${market.country}'s local time.`:pt?`Esta página reúne os jogos de hoje de ${market.leagues.join(' e ')}, no horário local de ${market.country}.`:`Esta página reúne los partidos de hoy de ${market.leagues.join(' y ')}, en el horario local de ${market.country}.`}},
  {'@type':'Question',name:en?'When are results updated?':pt?'Quando os resultados são atualizados?':'¿Cuándo se actualizan los resultados?',acceptedAnswer:{'@type':'Answer',text:copy.updated+'.'}},
 ]},
 {'@type':'ItemList',name:en?'Today and upcoming football matches':pt?'Jogos de hoje e próximos':'Partidos de hoy y próximos',itemListElement:[...recent,...todays,...upcoming].map((event:any,index:number)=>({'@type':'ListItem',position:index+1,item:footballSportsEvent(event,market.country,`https://hacecuentas.com${market.path}`)}))}
]};
---
<Layout title={title} description={description} canonical={market.path} lang={market.locale.split('-')[0]} audience={market.key.toUpperCase()} domain="life" pageType="data" noAds={true} noindex={market.codes.length===0} hreflang={footballHreflang} schema={schema}>
 <Header slot="header" lang={en?'en':pt?'pt':'es'} />
 <main class="footballHub">
  <section class="hero"><div class="wrap"><div class="crumb"><a href={`/${market.key==='mx'?market.key:market.key}`}>{copy.home}</a><span>›</span><a href="/futbol-hoy">{copy.sport}</a><span>›</span><strong>{market.country}</strong></div><div class="heroGrid"><div><div class="kicker">{longDate}</div><h1>{en?'English football':pt?`Futebol ${market.adjective}`:`Fútbol ${market.adjective}`}, <span>{en?'today':pt?'hoje':'hoy'}</span></h1><p>{en?'Fixtures, results and league tables in one place.':pt?`Resultados, horários, próximos jogos e classificação de ${market.leagues.join(' e ')}.`:`Resultados, horarios, próximos partidos y posiciones de ${market.leagues.join(' y ')} en un solo lugar.`}</p></div><div class="summary"><div><b>{todays.length}</b><small>{copy.games}</small></div><div><b>{liveCount}</b><small>{copy.live}</small></div><div><b>{upcoming.length}</b><small>{copy.upcoming}</small></div></div></div><nav class="quick"><a href="#hoy">{copy.today}</a>{recent.length>0&&<a href="#resultados">{copy.recent}</a>}<a href="#proximos">{copy.agenda}</a><a href="#tablas">{copy.tables}</a></nav></div></section>
  <div class="wrap content">
   <section class="card" id="hoy"><header><div><h2>⚽ {copy.today}</h2><p>{longDate}</p></div><small>{copy.updated}</small></header><div class="matches">{todays.length?todays.map((e:any)=><FootballMatch event={e} locale={market.locale} timeZone={market.tz} liveLabel={copy.live}/>):<div class="empty">{copy.empty}</div>}</div></section>
   {recent.length>0&&<section class="card" id="resultados"><header><div><h2>✓ {copy.recent}</h2><p>{en?'Last 72 hours':pt?'Últimas 72 horas':'Últimas 72 horas'}</p></div></header><div class="matches">{recent.map((e:any)=><FootballMatch event={e} locale={market.locale} timeZone={market.tz} liveLabel={copy.live} showDay/>)}</div></section>}
   <section class="card" id="proximos"><header><div><h2>▦ {copy.next}</h2><p>{copy.agenda}</p></div></header><div class="matches next">{upcoming.length?upcoming.map((e:any)=><FootballMatch event={e} locale={market.locale} timeZone={market.tz} liveLabel={copy.live} showDay/>):<div class="empty">{copy.empty}</div>}</div></section>
   <section class="tables card" id="tablas"><header><div><h2>{copy.tables}</h2><p>{market.leagues.join(' · ')}</p></div></header><div class="groups">{(data.leagues||[]).map((league:any,i:number)=>(league.groups||[]).map((g:any,j:number)=><article class="table"><h3>{market.leagues[i]} · {g.name||`Grupo ${j+1}`}</h3><div class="scroll"><table><thead><tr><th>#</th><th>{en?'Team':pt?'Time':'Equipo'}</th><th>PJ</th><th>DG</th><th>PTS</th></tr></thead><tbody>{(g.standings?.entries||[]).filter((x:any)=>footballNameAllowed(x.team?.displayName)).map((x:any,k:number)=><tr><td><i>{k+1}</i></td><td><span class="club"><span class="crest small" aria-hidden="true"><span>⚽</span>{x.team?.logos?.[0]?.href&&<img src={x.team.logos[0].href} alt="" width="23" height="23" loading="lazy" onerror="this.remove()"/>}</span>{x.team?.shortDisplayName||x.team?.displayName}</span></td><td>{stat(x,'gamesPlayed')}</td><td>{stat(x,'pointDifferential')}</td><td><b>{stat(x,'points')}</b></td></tr>)}</tbody></table></div></article>))}</div></section>
   <p class="source">{en?'Results and league tables source:':pt?'Fonte dos resultados e classificações:':'Fuente de resultados y posiciones:'} <a href="https://www.espn.com/soccer/" target="_blank" rel="noopener noreferrer external">ESPN</a>. {en?'Times use the local time zone and updates may be briefly delayed.':pt?'Os horários usam o fuso local e a atualização pode ter uma breve demora.':'Los horarios usan la zona local y la actualización puede tener una breve demora.'}</p>
   <nav class="countries" aria-label="Football by country"><strong>{en?'Football in other countries':pt?'Futebol em outros países':'Fútbol en otros países'}</strong><a href="/futbol-argentino-hoy">Argentina</a>{footballMarkets.filter(m=>m.key!==market.key).map(m=><a href={m.path}>{m.country}</a>)}</nav>
  </div>
 </main><Footer slot="footer" />
</Layout>
{/** Local component keeps Astro-rendered content scoped and safe. */}
{(()=>null)()}
<script is:inline>document.querySelectorAll('.footballHub a[href^="#"]').forEach(a=>a.addEventListener('click',()=>{}));</script>
<style is:global>
:root{--blue:#1769e0;--ink:#142033;--muted:#66758a;--line:#e4eaf2;--paper:#f6f8fb;--green:#0b9b64}*{box-sizing:border-box}.footballHub{background:var(--paper);color:var(--ink);min-height:100vh;overflow:hidden}.wrap{width:min(1240px,calc(100% - 40px));margin:auto}.hero{padding:48px 0 26px;background:linear-gradient(#fff,var(--paper))}.crumb{display:flex;gap:8px;color:#7b8899;font-size:12px;margin-bottom:22px}.heroGrid{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:end}.heroGrid>div{min-width:0}.kicker{color:var(--blue);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}.kicker:before{content:"";display:inline-block;width:20px;height:3px;background:var(--blue);margin:0 8px 3px 0}h1{font-size:clamp(38px,5vw,66px);line-height:.98;letter-spacing:-.055em;margin:0;white-space:normal;overflow-wrap:anywhere}h1 span{color:var(--blue)}.hero p{color:var(--muted);font-size:16px;max-width:680px;line-height:1.55}.summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));width:min(336px,100%);background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:0 12px 36px #142f5214}.summary div{padding:19px 8px;text-align:center}.summary div+div{border-left:1px solid var(--line)}.summary b{font-size:25px;display:block}.summary small{font-size:9px;text-transform:uppercase;color:var(--muted)}.quick{display:flex;gap:8px;margin-top:30px;overflow:auto}.quick a,.countries a{padding:9px 13px;border:1px solid var(--line);background:#fff;border-radius:99px;font-size:12px;font-weight:700}.quick a:first-child{background:var(--ink);color:#fff}.content{padding:24px 0 80px}.card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:26px;margin-top:28px;box-shadow:0 5px 24px #18365a0d;scroll-margin-top:88px}.card>header{display:flex;justify-content:space-between;gap:20px;margin-bottom:20px}.card h2{font-size:23px;margin:0}.card header p{font-size:12px;color:var(--muted);margin:5px 0}.card header>small{color:var(--muted);font-weight:700}.matches{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.next{grid-template-columns:repeat(4,1fr)}.match{border:1px solid var(--line);border-radius:15px;padding:15px}.matchTop{display:flex;justify-content:space-between;margin-bottom:10px;font-size:10px;font-weight:800;color:var(--muted)}.state.final{color:var(--green)}.team{display:grid;grid-template-columns:32px 1fr 28px;align-items:center;gap:8px;padding:8px 0}.team+.team{border-top:1px solid #eef2f6}.crest{position:relative;width:29px;height:29px;display:grid;place-items:center;border-radius:50%;background:#eef3f8;color:#8391a3;font-size:14px;overflow:hidden}.crest>img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#fff}.crest.small{width:23px;height:23px;font-size:11px;flex:0 0 auto}.team strong{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.team b{text-align:right;font-size:19px}.groups{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.table{border:1px solid var(--line);border-radius:15px;overflow:hidden}.table h3{margin:0;padding:13px 16px;background:#f8fafc;font-size:10px;text-transform:uppercase;color:var(--muted)}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:9px 8px;border-bottom:1px solid #edf1f5;text-align:center}th:nth-child(2){text-align:left}.club{display:flex;align-items:center;gap:8px;text-align:left;font-weight:700}.empty{grid-column:1/-1;padding:30px;text-align:center;border:1px dashed #cbd5e1;border-radius:14px;color:var(--muted)}.countries{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:28px}.countries strong{margin-right:8px}.countries a:hover{border-color:var(--blue);color:var(--blue)}
@media(max-width:900px){.heroGrid{grid-template-columns:1fr}.summary{grid-template-columns:repeat(3,1fr)}.matches,.next,.groups{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.footballHub .wrap{width:calc(100vw - 28px);margin-inline:14px}.hero{padding:28px 0 16px}.footballHub h1{font-size:40px;white-space:normal;overflow-wrap:anywhere}.matches,.next,.groups{grid-template-columns:1fr}.card{padding:18px 14px;border-radius:17px}.card>header>small{display:none}.scroll{overflow:auto}.countries strong{width:100%}}
</style>
<style is:global>
.footballHub .match{scroll-margin-top:88px}.footballHub .matchName{font-size:13px;line-height:1.35;margin:0 0 10px;color:var(--ink);letter-spacing:-.01em}.footballHub .matchName+.matchTop{padding-top:9px;border-top:1px solid #eef2f6}
.footballHub .source{color:var(--muted);font-size:11px;line-height:1.6;margin:18px 4px 0}.footballHub .source a{color:var(--blue);text-decoration:underline;text-underline-offset:3px}
</style>
