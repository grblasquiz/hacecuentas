{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "hacecuentas/calculadora",
	"version": "1.0.0",
	"title": "Calculadora Hacé Cuentas",
	"category": "embed",
	"icon": "calculator",
	"description": "Insertá una calculadora interactiva de Hacé Cuentas (sueldo, monotributo, aguinaldo, IMC, préstamos y más).",
	"keywords": [ "calculadora", "calculator", "finanzas", "sueldo", "monotributo", "aguinaldo", "imc" ],
	"textdomain": "hacecuentas-calculadoras",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"slug": {
			"type": "string",
			"default": ""
		},
		"height": {
			"type": "number",
			"default": 640
		}
	},
	"editorScript": "hacecuentas-block"
}
